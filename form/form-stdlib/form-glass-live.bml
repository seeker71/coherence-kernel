            append(fgov2-current-structure-observations(provenance), append(fgov2-current-jit-observations(provenance), append(fgov2-current-metal-observations(provenance), fgl-owner-observations(samples, samples))));
        }
        def fgl-v2-find(rows, id) = if eq(len(rows), 0) then list() else if str_eq(fgov2-observation-id(head(rows)), id) then head(rows) else fgl-v2-find(tail(rows), id);
        def fgl-v2-number-present(row) {
            let truth = fgov2-observation-measurement(row);
            // A flow point is a current resource slice. Last-observed owner
            // counters remain visible with their age in the observation view,
            // but must not be renewed as a current idle/drained zero here.
            if eq(fgov2-measured?(truth), 1) then fgov2-truth-value(truth) else -1;
        }
        def fgl-v2-number(rows, id) {
            let row = fgl-v2-find(rows, id);
            if eq(len(row), 0) then -1 else fgl-v2-number-present(row);
        }
        def fgl-v2-evidence(rows, id) {
            let row = fgl-v2-find(rows, id);
            if eq(len(row), 0) then "unavailable" else if lt(fgl-v2-number-present(row), 0) then "unavailable" else fgov2-provenance-evidence(fgov2-observation-provenance(row));
        }
        def fgl-v2-source(rows, id, door) {
            let row = fgl-v2-find(rows, id);
            if eq(len(row), 0) then door else if lt(fgl-v2-number-present(row), 0) then door else fgov2-provenance-source(fgov2-observation-provenance(row));
        }
        def fgl-prefer-evidence(primaryValue, primaryEvidence, fallbackEvidence) = if ge(primaryValue, 0) then primaryEvidence else fallbackEvidence;
        def fgl-prefer-number(primary, fallback) = if ge(primary, 0) then primary else fallback;
        def fgl-flow-point-current(epoch, metrics, observations) = fgl-flow-point(epoch, metrics);

        // Census only records visible to this Glass process. Aggregate count
        // movement is shown per phase; it is never promoted to per-node cause.
        // one home for the phase sets: a state is gas (0), water (1), ice (2) or none (3); the sets are disjoint, and the
        // most common state tonight (live) is read first
        def fgl-phase-index(state) = if str_eq(state, "live") then 1 else if str_eq(state, "source") then 0 else if str_eq(state, "eligible") then 0 else if str_eq(state, "released") then 0 else if str_eq(state, "active") then 1 else if str_eq(state, "loading") then 1 else if str_eq(state, "prefilling") then 1 else if str_eq(state, "compiling") then 1 else if str_eq(state, "cooling") then 1 else if str_eq(state, "meltable") then 1 else if str_eq(state, "stored") then 2 else if str_eq(state, "ready") then 2 else if str_eq(state, "resident") then 2 else if str_eq(state, "pinned") then 2 else if str_eq(state, "mapped") then 2 else if str_eq(state, "crystallized") then 2 else 3;
        def fgl-phase-number(phase) = if str_eq(phase, "gas") then 0 else if str_eq(phase, "water") then 1 else if str_eq(phase, "ice") then 2 else -1;
        def fgl-phase?(state, phase) = if eq(fgl-phase-index(state), fgl-phase-number(phase)) then 1 else 0;
        def fgl-phase-metric-count(rows, phase) = if eq(len(rows), 0) then 0 else add(if and(eq(fgo-present?(head(rows)), 1), eq(fgl-phase?(fgo-lifecycle(head(rows)), phase), 1)) then 1 else 0, fgl-phase-metric-count(tail(rows), phase));
        def fgl-phase-sample-count(rows, phase) = if eq(len(rows), 0) then 0 else add(if eq(fgl-phase?(fgtm-sample-lifecycle(head(rows)), phase), 1) then 1 else 0, fgl-phase-sample-count(tail(rows), phase));
        def fgl-observation-state-text(row) {
            let state = fgov2-observation-state(row);
            if eq(fgov2-measured?(state), 1) then fgov2-truth-value(state) else if eq(fgov2-stale?(state), 1) then fgov2-truth-value(state) else "unknown";
        }
        def fgl-phase-observation-count(rows, phase) = if eq(len(rows), 0) then 0 else add(if eq(fgl-phase?(fgl-observation-state-text(head(rows)), phase), 1) then 1 else 0, fgl-phase-observation-count(tail(rows), phase));
        def fgl-phase-count(metrics, samples, observations, phase) = add(fgl-phase-metric-count(metrics, phase), add(fgl-phase-sample-count(samples, phase), fgl-phase-observation-count(observations, phase)));
        // the three phase counts in one walk: each row is classified once (fgl-phase-index) and bumps one of three
        // counters; the triple is (gas, water, ice)
        def fgl-phase-bump(triple, state) {
            let phase = fgl-phase-index(state);
            if eq(phase, 0) then list(add(nth(triple, 0), 1), nth(triple, 1), nth(triple, 2)) else if eq(phase, 1) then list(nth(triple, 0), add(nth(triple, 1), 1), nth(triple, 2)) else if eq(phase, 2) then list(nth(triple, 0), nth(triple, 1), add(nth(triple, 2), 1)) else triple;
        }
        def fgl-phase-metric-triple(rows, triple) = if eq(len(rows), 0) then triple else fgl-phase-metric-triple(tail(rows), if eq(fgo-present?(head(rows)), 1) then fgl-phase-bump(triple, fgo-lifecycle(head(rows))) else triple);
        def fgl-phase-sample-triple(rows, triple) = if eq(len(rows), 0) then triple else fgl-phase-sample-triple(tail(rows), fgl-phase-bump(triple, fgtm-sample-lifecycle(head(rows))));
        def fgl-phase-observation-triple(rows, triple) = if eq(len(rows), 0) then triple else fgl-phase-observation-triple(tail(rows), fgl-phase-bump(triple, fgl-observation-state-text(head(rows))));
        def fgl-phase-triple(metrics, samples, observations) = fgl-phase-observation-triple(observations, fgl-phase-sample-triple(samples, fgl-phase-metric-triple(metrics, list(0, 0, 0))));
        def fgl-sample-kind-capacity(rows, kind, found, total) = if eq(len(rows), 0) then if eq(found, 1) then total else -1 else if and(str_eq(fgtm-sample-kind(head(rows)), kind), eq(fgtm-field-present?(fgtm-sample-capacity(head(rows))), 1)) then fgl-sample-kind-capacity(tail(rows), kind, 1, add(total, fgtm-field-value(fgtm-sample-capacity(head(rows))))) else fgl-sample-kind-capacity(tail(rows), kind, found, total);
        def fgl-sample-channel-tag-memberships(rows) = if eq(len(rows), 0) then 0 else add(len(fgtm-sample-channels(head(rows))), fgl-sample-channel-tag-memberships(tail(rows)));
        // A fault key is an opaque, bounded Form NodeID projection. Select the
        // typed producer contract rather than coupling Glass control to one
        // textual packing, so a representation improvement cannot hide P1000.
        def fgl-jit-fault-candidate?(sample) = if not(str_eq(fgtm-sample-kind(sample), "diagnostic-control")) then 0 else if not(str_eq(fgtm-sample-owner(sample), FGLJitPublisher())) then 0 else if not(str_eq(fgtm-sample-source(sample), "bml-demand-jit")) then 0 else if not(str_eq(fgtm-sample-evidence(sample), "physical-live")) then 0 else if not(str_eq(fgtm-sample-lifecycle(sample), "failed")) then 0 else if not(eq(fgtm-field-present?(fgtm-sample-capacity(sample)), 1)) then 0 else if not(eq(fgtm-field-present?(fgtm-sample-read-epoch(sample)), 1)) then 0 else if not(eq(fgtm-field-present?(fgtm-sample-write-epoch(sample)), 1)) then 0 else fgd-has-channel(fgtm-sample-channels(sample), "jit");
        def fgl-jit-fault-newer(a, b) = if eq(len(a), 0) then b else if gt(fgd-sample-latest(b), fgd-sample-latest(a)) then b else a;
        def fgl-jit-fault-sample(rows, held) = if eq(len(rows), 0) then held else if eq(fgl-jit-fault-candidate?(head(rows)), 1) then fgl-jit-fault-sample(tail(rows), fgl-jit-fault-newer(held, head(rows))) else fgl-jit-fault-sample(tail(rows), held);
        def fgl-jit-fault(rows) {
            let sample = fgl-jit-fault-sample(rows, list());
            if eq(len(sample), 0) then list() else list(fgtm-sample-id(sample), fgtm-sample-kind(sample), fgtm-sample-purpose(sample), fgd-sample-latest(sample), fgtm-sample-evidence(sample), fgtm-sample-evictability(sample), fgtm-sample-source(sample), fgtm-field-value(fgtm-sample-capacity(sample)));
        }
        def fgl-jit-healed-candidate?(sample) = if not(str_eq(fgtm-sample-id(sample), FGLJitHealedId())) then 0 else if not(str_eq(fgtm-sample-kind(sample), "jit-healed")) then 0 else if not(str_eq(fgtm-sample-owner(sample), FGLJitPublisher())) then 0 else if not(str_eq(fgtm-sample-evidence(sample), "physical-live")) then 0 else if not(str_eq(fgtm-sample-lifecycle(sample), "ready")) then 0 else if not(eq(fgtm-field-present?(fgtm-sample-parent(sample)), 1)) then 0 else if not(eq(fgtm-field-present?(fgtm-sample-capacity(sample)), 1)) then 0 else if not(eq(fgtm-field-present?(fgtm-sample-read-epoch(sample)), 1)) then 0 else eq(fgtm-field-present?(fgtm-sample-write-epoch(sample)), 1);
        def fgl-jit-healed-matches?(fault, healed) = if not(eq(fgl-jit-fault-candidate?(fault), 1)) then 0 else if not(eq(fgl-jit-healed-candidate?(healed), 1)) then 0 else if not(str_eq(fgtm-field-value(fgtm-sample-parent(healed)), fgtm-sample-id(fault))) then 0 else if not(str_eq(fgtm-sample-purpose(healed), fgtm-sample-purpose(fault))) then 0 else if not(eq(fgtm-field-value(fgtm-sample-capacity(healed)), fgtm-field-value(fgtm-sample-capacity(fault)))) then 0 else if not(eq(fgtm-field-value(fgtm-sample-read-epoch(healed)), fgtm-field-value(fgtm-sample-read-epoch(fault)))) then 0 else gt(fgtm-field-value(fgtm-sample-write-epoch(healed)), fgtm-field-value(fgtm-sample-write-epoch(fault)));
        def fgl-jit-healed-for(rows, fault) = if eq(len(rows), 0) then list() else if eq(fgl-jit-healed-matches?(fault, head(rows)), 1) then head(rows) else fgl-jit-healed-for(tail(rows), fault);
        def fgl-jit-hold-assess(rows, fault) = if gt(len(fgl-jit-healed-for(rows, fault)), 0) then "healed-cause-bound" else "held-awaiting-successful-rechallenge";
        def fgl-jit-fault-wake(fault) = fgel-wake("jit-refusal", fgtm-field-value(fgtm-sample-read-epoch(fault)), FGLJitPublisher(), fgtm-sample-id(fault));
        def fgl-jit-healed-wake(healed) = fgel-wake("jit-healed", fgtm-field-value(fgtm-sample-write-epoch(healed)), FGLJitPublisher(), fgtm-field-value(fgtm-sample-parent(healed)));
        def fgl-flow-point-current-full(epoch, metrics, observations, samples) = fgl-flow-point-current-full-in(epoch, metrics, observations, samples, fgd-metric-index(metrics));
        // the flow point over one keyed index: every lane, evidence and source lookup is a record probe; the phase census still walks the rows once per phase
        def fgl-flow-point-current-full-in(epoch, metrics, observations, samples, index) {
            let base = fgl-flow-point-in(epoch, index);
            let tensorObservation = fgl-v2-number(observations, "tensor.owner.allocated");
            let accepted = fgl-prefer-number(fgl-number-for-in(index, list("accepted")), fgl-number-for-in(index, list("events")));
            let evidences = list(
                fgl-evidence-for-in(index, list("gpu-busy-us")),
                fgl-evidence-for-in(index, list("cpu-busy-us")),
                fgl-evidence-for-in(index, list("kernels-dispatches")),
                fgl-evidence-for-in(index, list("queue-depth", "queue-task-frames")),
                fgl-evidence-for-in(index, list("kernels-heat-calls")),
                fgl-evidence-for-in(index, list("cells")),
                fgl-evidence-for-in(index, list("memory-free")),
                fgl-evidence-for-in(index, list("inflight")),
                "derived-window", "derived-window", "derived-window", "derived-window",
                fgl-v2-evidence(observations, "tensor.owner.allocated"),
                "derived-window", fgl-prefer-evidence(accepted, fgl-evidence-for-in(index, list("accepted")), fgl-evidence-for-in(index, list("events"))));
            let sources = list(
                fgl-gift-source-in(index, "machine"),
                fgl-gift-source-in(index, "machine"),
                fgl-source-for-in(index, list("kernels-dispatches"), "shm:/fg-kernels"),
                fgl-gift-source-in(index, "queue"),
                fgl-source-for-in(index, list("kernels-heat-calls"), "shm:/fg-kernels"),
                fgl-gift-source-in(index, "glass"),
                fgl-gift-source-in(index, "host"),
                fgl-gift-source-in(index, "glass"),
                "glass.visible.phase-census", "glass.visible.phase-census", "glass.visible.phase-census", "telemetry.token-position.capacity", "model.owner.tensor.allocated", "telemetry.channel-memberships", if ge(accepted, 0) then fgl-source-for-in(index, list("accepted"), "framebuffer-events") else fgl-source-for-in(index, list("events"), "framebuffer-events"));
            let phases = fgl-phase-triple(metrics, samples, observations);
            let point = fgd-flow-point-v4(epoch, fgd-flow-value(base, 2), fgd-flow-value(base, 3), fgd-flow-value(base, 4), fgd-flow-value(base, 5), fgd-flow-value(base, 6), fgd-flow-value(base, 7), fgd-flow-value(base, 8), fgd-flow-value(base, 9), nth(phases, 0), nth(phases, 1), nth(phases, 2), fgl-sample-kind-capacity(samples, "token-position", 0, 0), tensorObservation, fgl-sample-channel-tag-memberships(samples), accepted, evidences, sources);
            let states = list(
                fgl-lane-state-in(index, list("gpu-busy-us")),
                fgl-lane-state-in(index, list("cpu-busy-us")),
                fgl-lane-state-in(index, list("kernels-dispatches")),
                fgl-lane-state-in(index, list("queue-depth", "queue-task-frames")),
                fgl-lane-state-in(index, list("kernels-heat-calls")),
                fgl-lane-state-in(index, list("cells")),
                fgl-lane-state-in(index, list("memory-free")),
                fgl-lane-state-in(index, list("inflight")));
            append(take(18, point), list(fgl-number-for-in(index, list("strings")), sources, fgl-jit-fault(samples), states));
        }

        def fgl-monitor-sample(epoch) = fgtm-sample("process.form-glass" , fgtm-absent(), "organ", "form", "glass.monitor", "observation", "render-and-control", fgtm-absent(), fgtm-absent(), "active", fgtm-present(epoch), fgtm-present(epoch), fgtm-present(1000), fgtm-absent(), "unknown", "physical-live", "glass.monitor", list("all", "health", "primitive", "membrane"));
        def fgl-find-sample(samples, id) = if eq(len(samples), 0) then list() else if str_eq(fgtm-sample-id(head(samples)), id) then head(samples) else fgl-find-sample(tail(samples), id);
        def fgl-route-ready?(fact) = if not(eq(nmrr-fact-valid?(fact), 1)) then 0 else if not(eq(nmrr-fact-present?(fact), 1)) then 0 else eq(nmrr-fact-value(fact), 1);
        def fgl-ledger-sample(id, parent, owner, kind, plane, purpose, bytes, handles, lifecycle, epoch, evidence, source, channels) = fgtm-sample(id, fgtm-present(parent), kind, plane, owner, "memory", purpose, if ge(bytes, 0) then fgtm-present(bytes) else fgtm-absent(), if ge(handles, 0) then fgtm-present(handles) else fgtm-absent(), lifecycle, fgtm-present(epoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "pressure-only", evidence, source, append(channels, list("node-id-unbound")));
        def fgl-sample-bytes-number(sample) = if eq(len(sample), 0) then -1 else if eq(fgtm-field-present?(fgtm-sample-bytes(sample)), 1) then fgtm-field-value(fgtm-sample-bytes(sample)) else -1;
        def fgl-sample-capacity-number(sample) = if eq(len(sample), 0) then -1 else if eq(fgtm-field-present?(fgtm-sample-capacity(sample)), 1) then fgtm-field-value(fgtm-sample-capacity(sample)) else -1;
        def fgl-owner-counter-number(samples, id) = fgl-sample-capacity-number(fgl-find-sample(samples, id));
        def fgl-sample-handle-number(sample) = if eq(len(sample), 0) then -1 else if eq(fgtm-field-present?(fgtm-sample-handle(sample)), 1) then fgtm-field-value(fgtm-sample-handle(sample)) else -1;
        def fgl-find-owner-kind-sample(samples, owner, kind) = if eq(len(samples), 0) then list() else if and(str_eq(fgtm-sample-owner(head(samples)), owner), str_eq(fgtm-sample-kind(head(samples)), kind)) then head(samples) else fgl-find-owner-kind-sample(tail(samples), owner, kind);
        def fgl-owner-observed-epoch(samples, owner, fallback) {
            let heartbeat = fgl-find-owner-kind-sample(samples, owner, "owner-heartbeat");
            if eq(len(heartbeat), 0) then fallback else if eq(fgtm-field-present?(fgtm-sample-read-epoch(heartbeat)), 1) then fgtm-field-value(fgtm-sample-read-epoch(heartbeat)) else fallback;
        }
        def fgl-artifact-identities-present?(samples, identities) = if eq(len(identities), 0) then 1 else if eq(len(fgl-find-sample(samples, nmtl-artifact-identity-id(head(identities)))), 0) then 0 else fgl-artifact-identities-present?(samples, tail(identities));
        def fgl-artifact-sample-matches?(sample, identity, parent, owner, handle) = if eq(len(sample), 0) then 0 else if not(eq(fgtm-sample-valid?(sample), 1)) then 0 else if not(str_eq(fgtm-sample-id(sample), nmtl-artifact-identity-id(identity))) then 0 else if not(eq(fgtm-field-present?(fgtm-sample-parent(sample)), 1)) then 0 else if not(str_eq(fgtm-field-value(fgtm-sample-parent(sample)), parent)) then 0 else if not(str_eq(fgtm-sample-owner(sample), owner)) then 0 else if not(str_eq(fgtm-sample-kind(sample), "artifact-open-stat")) then 0 else if not(str_eq(fgtm-sample-plane(sample), "disk")) then 0 else if not(str_eq(fgtm-sample-purpose(sample), "open-time-file-stat")) then 0 else if not(str_eq(fgtm-sample-lifecycle(sample), "mapped")) then 0 else if not(str_eq(fgtm-sample-evidence(sample), "physical-live")) then 0 else if not(eq(fgl-sample-bytes-number(sample), nmtl-artifact-identity-bytes(identity))) then 0 else if not(eq(fgl-sample-capacity-number(sample), nmtl-artifact-identity-modified(identity))) then 0 else eq(fgl-sample-handle-number(sample), handle);
        def fgl-artifact-identities-match?(samples, identities, parent, owner, handle) = if eq(len(identities), 0) then 1 else if not(eq(fgl-artifact-sample-matches?(fgl-find-sample(samples, nmtl-artifact-identity-id(head(identities))), head(identities), parent, owner, handle), 1)) then 0 else fgl-artifact-identities-match?(samples, tail(identities), parent, owner, handle);
        def fgl-profile-open-artifacts-match?(samples, profile, owner, handle) = if le(handle, 0) then 0 else fgl-artifact-identities-match?(samples, nmtl-layout-profile-artifact(profile), nmtl-layout-profile-id(profile), owner, handle);
        def fgl-artifact-strong-identities-present?(samples, identities) = if eq(len(identities), 0) then 1 else if eq(len(fgl-find-sample(samples, nmdt-open-artifact-identity-id(nmtl-artifact-identity-id(head(identities))))), 0) then 0 else fgl-artifact-strong-identities-present?(samples, tail(identities));
        def fgl-artifact-strong-sample-matches?(statSample, identitySample, identity, owner, handle) = if eq(len(identitySample), 0) then 0 else if not(eq(fgtm-sample-valid?(identitySample), 1)) then 0 else if not(eq(fgtm-sample-valid?(statSample), 1)) then 0 else if not(str_eq(fgtm-sample-id(identitySample), nmdt-open-artifact-identity-id(nmtl-artifact-identity-id(identity)))) then 0 else if not(eq(fgtm-field-present?(fgtm-sample-parent(identitySample)), 1)) then 0 else if not(str_eq(fgtm-field-value(fgtm-sample-parent(identitySample)), nmtl-artifact-identity-id(identity))) then 0 else if not(str_eq(fgtm-sample-owner(identitySample), owner)) then 0 else if not(str_eq(nmdt-open-artifact-identity-strength(identitySample), nmtl-artifact-identity-strength(identity))) then 0 else if not(str_eq(nmdt-open-artifact-identity-value(identitySample), nmtl-artifact-identity-locator(identity))) then 0 else if not(str_eq(fgtm-sample-plane(identitySample), "disk")) then 0 else if not(str_eq(fgtm-sample-lifecycle(identitySample), "mapped")) then 0 else if not(str_eq(fgtm-sample-evidence(identitySample), "physical-live")) then 0 else if not(eq(fgl-sample-handle-number(identitySample), handle)) then 0 else if not(eq(fgtm-field-present?(fgtm-sample-read-epoch(identitySample)), 1)) then 0 else if not(eq(fgtm-field-present?(fgtm-sample-read-epoch(statSample)), 1)) then 0 else eq(fgtm-field-value(fgtm-sample-read-epoch(identitySample)), fgtm-field-value(fgtm-sample-read-epoch(statSample)));
        def fgl-artifact-strong-identities-match?(samples, identities, owner, handle) = if eq(len(identities), 0) then 1 else if not(eq(fgl-artifact-strong-sample-matches?(fgl-find-sample(samples, nmtl-artifact-identity-id(head(identities))), fgl-find-sample(samples, nmdt-open-artifact-identity-id(nmtl-artifact-identity-id(head(identities)))), head(identities), owner, handle), 1)) then 0 else fgl-artifact-strong-identities-match?(samples, tail(identities), owner, handle);
        def fgl-profile-open-artifacts-strong-match?(samples, profile, owner, handle) = if le(handle, 0) then 0 else fgl-artifact-strong-identities-match?(samples, nmtl-layout-profile-artifact(profile), owner, handle);
        def fgl-ledger-gap-sample(id, parent, owner, purpose, epoch, door, channels) = fgtm-sample(id, fgtm-present(parent), "tensor-reconciliation", "unified", owner, "memory", purpose, fgtm-absent(), fgtm-absent(), "failed", fgtm-present(epoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "never", "declared", door, append(channels, list("node-id-unbound")));
        def fgl-ledger-reconciliation-sample(id, parent, owner, plane, expected, observed, epoch, source, channels) = if lt(observed, 0) then fgl-ledger-gap-sample(id, parent, owner, "carrier-count-not-published", epoch, source, channels) else fgtm-sample(id, fgtm-present(parent), "tensor-reconciliation", plane, owner, "memory", if eq(expected, observed) then "reconciled" else "count-mismatch", fgtm-absent(), fgtm-present(observed), if eq(expected, observed) then "ready" else "failed", fgtm-present(epoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "never", "derived-window", source, append(channels, list("node-id-unbound")));
        def fgl-owner-mlx-model-path-sample(owner, epoch) = fgtm-sample("mlx.owner.model-path", fgtm-absent(), "execution-path", "mlx", owner, "reasoning", "not-on-owner-model-path", fgtm-absent(), fgtm-absent(), "idle", fgtm-present(epoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "never", "derived-window", "native-model-owner-metal-path", list("process", "model", "mlx", "metal", "gpu", "health", "node-id-unbound"));
        // This observer does not reopen either model.  It joins the exact live
        // owner PID/start/handles with the one allocation-size authority used
        // by the model constructors.  The result is a current derived extent,
        // not a claim about physically faulted VM pages.
        def fgl-owner-derived-ledger-samples(externalSamples, epoch) {
            let qfact = nmrr-model-route-from-current-samples(externalSamples, epoch, FGLQwenRouteId());
            let tfact = nmrr-model-route-from-current-samples(externalSamples, epoch, FGLThreeBRouteId());
            let qmodel = fgl-find-sample(externalSamples, FGLQwenRouteId());
            let owner = if eq(len(qmodel), 0) then "models" else fgtm-sample-owner(qmodel);
            let physicalLedger = fgl-find-sample(externalSamples, "tensor.owner.ledger");
            if not(and(eq(fgl-route-ready?(qfact), 1), eq(fgl-route-ready?(tfact), 1))) then list() else if eq(len(qmodel), 0) then list() else if gt(len(physicalLedger), 0) then list(fgl-owner-mlx-model-path-sample(owner, fgl-owner-observed-epoch(externalSamples, owner, epoch))) else fgl-owner-derived-ledger-present(externalSamples, owner, epoch);
        }
        def fgl-owner-derived-ledger-present(externalSamples, owner, epoch) {
            let qprofile = nmtl-qwen-layout-profile();
            let tprofile = nmtl-llama-layout-profile();
            fgl-owner-derived-ledger-profiles(externalSamples, owner, epoch, qprofile, tprofile);
        }
        def fgl-owner-derived-ledger-profiles(externalSamples, owner, epoch, qprofile, tprofile) {
            let qmodel = fgl-find-sample(externalSamples, FGLQwenRouteId());
            let tmodel = fgl-find-sample(externalSamples, FGLThreeBRouteId());
            let qcatalog = fgl-sample-bytes-number(fgl-find-sample(externalSamples, FGLQwenWeightId()));
            let tcatalog = fgl-sample-bytes-number(fgl-find-sample(externalSamples, FGLThreeBWeightId()));
            let ownerEpoch = fgl-owner-observed-epoch(externalSamples, owner, epoch);
            let qidentities = nmtl-layout-profile-artifact(qprofile);
            let tidentities = nmtl-layout-profile-artifact(tprofile);
            let identitiesPresent = and(fgl-artifact-identities-present?(externalSamples, qidentities), fgl-artifact-identities-present?(externalSamples, tidentities));
            let identitiesMatch = and(fgl-profile-open-artifacts-match?(externalSamples, qprofile, owner, fgl-sample-handle-number(qmodel)), fgl-profile-open-artifacts-match?(externalSamples, tprofile, owner, fgl-sample-handle-number(tmodel)));
            let strongProfiles = and(eq(nmtl-artifact-identities-content-bound?(qidentities), 1), eq(nmtl-artifact-identities-content-bound?(tidentities), 1));
            let strongIdentitiesPresent = and(fgl-artifact-strong-identities-present?(externalSamples, qidentities), fgl-artifact-strong-identities-present?(externalSamples, tidentities));
            let strongIdentitiesMatch = and(fgl-profile-open-artifacts-strong-match?(externalSamples, qprofile, owner, fgl-sample-handle-number(qmodel)), fgl-profile-open-artifacts-strong-match?(externalSamples, tprofile, owner, fgl-sample-handle-number(tmodel)));
            if not(and(eq(nmtl-layout-profile-matches-catalog?(qprofile, qcatalog), 1), eq(nmtl-layout-profile-matches-catalog?(tprofile, tcatalog), 1))) then list(
                fgl-ledger-gap-sample("tensor.owner.profile-refresh", "models", owner, "artifact-catalog-profile-mismatch", ownerEpoch, "model.tensor-layout-profile-refresh", list("process", "model", "memory", "tensor", "health")),
                fgl-owner-mlx-model-path-sample(owner, ownerEpoch)) else if not(eq(identitiesPresent, 1)) then list(
                    fgl-ledger-gap-sample("tensor.owner.artifact-join", "models", owner, "open-time-artifact-identity-not-published", ownerEpoch, "model.owner.open-artifact-identity", list("process", "model", "memory", "tensor", "health")),
                    fgl-owner-mlx-model-path-sample(owner, ownerEpoch)) else if not(eq(identitiesMatch, 1)) then list(
                        fgl-ledger-gap-sample("tensor.owner.artifact-join", "models", owner, "open-time-artifact-identity-mismatch", ownerEpoch, "model.owner.open-artifact-identity-match", list("process", "model", "memory", "tensor", "health")),
                        fgl-owner-mlx-model-path-sample(owner, ownerEpoch)) else if not(eq(strongProfiles, 1)) then list(
                            fgl-ledger-gap-sample("tensor.owner.artifact-join", "models", owner, "open-time-content-identity-not-published", ownerEpoch, "model.owner.open-artifact-content-identity", list("process", "model", "memory", "tensor", "health")),
                            fgl-owner-mlx-model-path-sample(owner, ownerEpoch)) else if not(eq(strongIdentitiesPresent, 1)) then list(
                                fgl-ledger-gap-sample("tensor.owner.artifact-join", "models", owner, "open-time-content-identity-not-published", ownerEpoch, "model.owner.open-artifact-content-identity", list("process", "model", "memory", "tensor", "health")),
                                fgl-owner-mlx-model-path-sample(owner, ownerEpoch)) else if not(eq(strongIdentitiesMatch, 1)) then list(
                                    fgl-ledger-gap-sample("tensor.owner.artifact-join", "models", owner, "open-time-content-identity-mismatch", ownerEpoch, "model.owner.open-artifact-content-identity-match", list("process", "model", "memory", "tensor", "health")),
                                    fgl-owner-mlx-model-path-sample(owner, ownerEpoch)) else fgl-owner-derived-ledger-profile(externalSamples, owner, ownerEpoch, qprofile, tprofile);
        }
        def fgl-owner-derived-ledger-profile(externalSamples, owner, epoch, qprofile, tprofile) {
            let qscratch = nmtl-sum(nmtl-qwen-scratch-sizes(128));
            let qstateSizes = nmtl-qwen-all-state-sizes(0, 48, 4, 128);
            let qstate = nmtl-sum(qstateSizes);
            let tscratch = nmtl-sum(nmtl-llama-scratch-sizes(3072, 8192, 128256, 24, 128));
            let tcache = mul(nmtl-llama-cache-bytes(1024, 128), 56);
            let profiles = list(qprofile, tprofile);
            let qm = nmtl-layout-profile-mapped-bytes(qprofile);
            let qmh = nmtl-layout-profile-mapped-handles(qprofile);
            let qa = nmtl-layout-profile-allocated-bytes(qprofile);
            let qah = nmtl-layout-profile-allocated-handles(qprofile);
            let tm = nmtl-layout-profile-mapped-bytes(tprofile);
            let tmh = nmtl-layout-profile-mapped-handles(tprofile);
            let ta = nmtl-layout-profile-allocated-bytes(tprofile);
            let tah = nmtl-layout-profile-allocated-handles(tprofile);
            let mappedHandles = nmtl-profiles-mapped-handles(profiles);
            let allocatedHandles = nmtl-profiles-allocated-handles(profiles);
            let observedMapped = fgl-owner-counter-number(externalSamples, "mapping.owner.mmap-buffer-handles");
            let observedBuffers = fgl-owner-counter-number(externalSamples, "metal.owner.buffers");
            let mappedEpoch = if le(nmtl-layout-profile-witnessed(qprofile), nmtl-layout-profile-witnessed(tprofile)) then nmtl-layout-profile-witnessed(qprofile) else nmtl-layout-profile-witnessed(tprofile);
            list(
                fgl-ledger-sample("tensor.qwen38.mapped", FGLQwenRouteId(), owner, "mapped-tensors", "disk", "gguf-record-mapped-extents", qm, qmh, "mapped", nmtl-layout-profile-witnessed(qprofile), "derived-window", "native-model-mapped-layout-run", list("model", "memory", "tensor", "metal", "gpu", "layer")),
                fgl-ledger-sample("tensor.qwen38.scratch", FGLQwenRouteId(), owner, "allocated-tensors", "unified", "reusable-scratch-buffer-extents", qscratch, 49, "resident", epoch, "derived-window", "native-model-tensor-ledger", list("model", "memory", "tensor", "metal", "gpu", "scratch")),
                fgl-ledger-sample("tensor.qwen38.state", FGLQwenRouteId(), owner, "allocated-state", "unified", "recurrent-and-kv-buffer-extents", qstate, len(qstateSizes), "resident", epoch, "derived-window", "native-model-tensor-ledger", list("model", "memory", "tensor", "metal", "gpu", "substate", "layer")),
                fgl-ledger-sample("tensor.qwen38.allocated", FGLQwenRouteId(), owner, "model-allocation", "unified", "reusable-scratch-and-state", qa, qah, "resident", epoch, "derived-window", "native-model-tensor-ledger", list("model", "memory", "tensor", "metal", "gpu", "health")),
                fgl-ledger-sample("tensor.llama32-3b.mapped", FGLThreeBRouteId(), owner, "mapped-tensors", "disk", "gguf-record-mapped-extents", tm, tmh, "mapped", nmtl-layout-profile-witnessed(tprofile), "derived-window", "native-model-mapped-layout-run", list("model", "memory", "tensor", "metal", "gpu", "layer")),
                fgl-ledger-sample("tensor.llama32-3b.scratch", FGLThreeBRouteId(), owner, "allocated-tensors", "unified", "reusable-scratch-buffer-extents", tscratch, 17, "resident", epoch, "derived-window", "native-model-tensor-ledger", list("model", "memory", "tensor", "metal", "gpu", "scratch")),
                fgl-ledger-sample("tensor.llama32-3b.kv", FGLThreeBRouteId(), owner, "allocated-state", "unified", "kv-cache-buffer-extents", tcache, 56, "resident", epoch, "derived-window", "native-model-tensor-ledger", list("model", "memory", "tensor", "metal", "gpu", "substate", "layer")),
                fgl-ledger-sample("tensor.llama32-3b.allocated", FGLThreeBRouteId(), owner, "model-allocation", "unified", "reusable-scratch-and-kv", ta, tah, "resident", epoch, "derived-window", "native-model-tensor-ledger", list("model", "memory", "tensor", "metal", "gpu", "health")),
                fgl-ledger-sample("tensor.owner.mapped", "models", owner, "tensor-ledger", "disk", "gguf-record-mapped-extents", nmtl-profiles-mapped-bytes(profiles), mappedHandles, "mapped", mappedEpoch, "derived-window", "native-model-mapped-layout-run", list("process", "model", "memory", "tensor", "metal", "gpu", "health")),
                fgl-ledger-sample("tensor.owner.allocated", "models", owner, "tensor-ledger", "unified", "reusable-scratch-state-kv-extents", nmtl-profiles-allocated-bytes(profiles), allocatedHandles, "resident", epoch, "derived-window", "native-model-tensor-ledger", list("process", "model", "memory", "tensor", "metal", "gpu", "health")),
                fgl-ledger-sample("tensor.owner.ledger", "models", owner, "tensor-ledger", "unified", "all-buffer-handle-count", -1, add(mappedHandles, allocatedHandles), "resident", epoch, "derived-window", "native-model-tensor-ledger", list("process", "model", "memory", "tensor", "metal", "gpu", "health")),
                fgl-ledger-reconciliation-sample("tensor.owner.mapped-reconciliation", "tensor.owner.mapped", owner, "disk", mappedHandles, observedMapped, epoch, "metal_status.mmap_nocopy_buffers", list("process", "model", "memory", "tensor", "metal", "gpu", "health")),
                fgl-ledger-reconciliation-sample("tensor.owner.buffer-reconciliation", "tensor.owner.ledger", owner, "unified", add(mappedHandles, allocatedHandles), observedBuffers, epoch, "owner.snapshot.metal_status.buffers", list("process", "model", "memory", "tensor", "metal", "gpu", "health")),
                fgl-owner-mlx-model-path-sample(owner, epoch));
        }
        def fgl-projection-sample?(sample) = if str_eq(fgtm-sample-source(sample), "glass.projection") then 1 else if str_eq(fgtm-sample-source(sample), "glass.projection-stale") then 1 else 0;
        def fgl-external-sample?(sample) = if str_eq(fgtm-sample-id(sample), "process.form-glass") then 0 else if str_eq(fgtm-sample-owner(sample), FGLPublisher()) then 0 else if eq(fgl-projection-sample?(sample), 1) then 0 else 1;
        def fgl-external-samples(samples) = if eq(len(samples), 0) then list() else if eq(fgl-external-sample?(head(samples)), 1) then cons(head(samples), fgl-external-samples(tail(samples))) else fgl-external-samples(tail(samples));
        def fgl-external-publishers(publishers) = if eq(len(publishers), 0) then list() else if str_eq(head(publishers), FGLPublisher()) then fgl-external-publishers(tail(publishers)) else cons(head(publishers), fgl-external-publishers(tail(publishers)));
        def fgl-local-samples(externalSamples, epoch) = cons(fgl-monitor-sample(epoch), append(fgl-owner-derived-ledger-samples(externalSamples, epoch), externalSamples));
        def fgl-route-metric-id(fact) = str_concat("route.", nmrr-fact-id(fact));
        // A route with no owner behind it is not a door nobody can open: the
        // two model contexts these routes name stand together in one resident
        // process, and the sensor rows already teach that an absent frame says
        // which cell to run.  The reason carries that cell, so the seam line
        // points at work rather than at a wall.
        def fgl-route-absent-reason(fact) = str_concat(nmrr-fact-reason(fact), str_concat("; no model owner process is standing -- run ", FGLDualResidentDoor()));
        def fgl-route-row(fact, label) = if eq(nmrr-fact-present?(fact), 1) then fgo-sized("model", fgl-route-metric-id(fact), label, nmrr-fact-value(fact), "ready", 1, mul(nmrr-fact-value(fact), 1000), "metal", nmrr-fact-evidence(fact), "native-model.route-readiness", if eq(nmrr-fact-value(fact), 1) then "ready" else "idle", "query-lane", nmrr-fact-reason(fact)) else fgo-unavailable("model", fgl-route-metric-id(fact), label, "ready", "metal", nmrr-fact-missing-door(fact), "query-lane", fgl-route-absent-reason(fact));
        def fgl-route-row-at(fact, label, sequence) = if eq(nmrr-fact-present?(fact), 1) then fgo-observe-row(fgl-route-row(fact, label), nmrr-fact-observed(fact), sequence) else fgo-observe-row(fgl-route-row(fact, label), -1, sequence);
        def fgl-model-route-rows(samples, epoch, sequence) {
            let qwen = nmrr-model-route-from-current-samples(samples, epoch, FGLQwenRouteId());
            let threeb = nmrr-model-route-from-current-samples(samples, epoch, FGLThreeBRouteId());
            let parallel = nmrr-parallel-route(qwen, threeb, epoch);
            list(fgl-route-row-at(qwen, "Qwen3.8-Flash-Next UD-Q2_K_XL (Unsloth) route", sequence), fgl-route-row-at(threeb, "Llama-3.2-3B-Instruct route", sequence), fgl-route-row-at(parallel, "Qwen + 3B parallel availability", sequence));
        }
        def fgl-retire-self-publisher() = 0;

        def fgl-control-state-full(focus, lastOffer, quit, status, view, filter, selected, evidenceOpen) = list("glass-live-control-state-v2", focus, lastOffer, quit, status, view, filter, selected, evidenceOpen);
        def fgl-control-state(focus, lastOffer, quit, status) = fgl-control-state-full(focus, lastOffer, quit, status, "atlas", "all", "none", 0);
        def fgl-control-focus(state) = nth(state, 1);
        def fgl-control-last-offer(state) = nth(state, 2);
        def fgl-control-quit?(state) = nth(state, 3);
        def fgl-control-status(state) = nth(state, 4);
        def fgl-control-view(state) = nth(state, 5);
        def fgl-control-filter(state) = nth(state, 6);
        def fgl-control-selected(state) = nth(state, 7);
        def fgl-control-evidence-open?(state) = nth(state, 8);
        def fgl-choice-walk?(action) = if str_eq(action, "step") then 1 else if str_eq(action, "take") then 1 else if str_eq(action, "hold") then 1 else 0;
        def fgl-choice-outcome?(action) = or(str_eq(action, "take"), str_eq(action, "hold"));
        def fgl-choice-command(previous, offer, samples, epoch) = fgch-slot-command(fgch-samples-points(samples), fgl-control-selected(previous), if str_eq(fgtm-offer-action(offer), "take") then "taken" else "held", fgd-max(0, sub(epoch, fgtm-offer-epoch(offer))));
        def fgl-choice-record-to(previous, offer, samples, epoch, publisher) {
            let command = fgl-choice-command(previous, offer, samples, epoch);
            if eq(str_len(command), 0) then list("owner-command-offer-v2", "refused", "no-slot-under-cursor") else fgtm-command-offer(publisher, command);
        }
        def fgl-choice-effect(previous, proposed, offer, samples, epoch) = fgl-choice-effect-to(previous, proposed, offer, samples, epoch, FGCHPublisher());
        def fgl-choice-effect-to(previous, proposed, offer, samples, epoch, publisher) {
            let action = fgtm-offer-action(offer);
            if or(eq(fgl-choice-outcome?(action), 0), str_eq(fgl-control-status(proposed), "refused")) then proposed
            else if str_eq(fgtm-command-status(fgl-choice-record-to(previous, offer, samples, epoch, publisher)), "offered") then proposed
            else fgl-control-state-full(fgl-control-focus(previous), fgtm-offer-id(offer), 0, "refused", fgl-control-view(previous), fgl-control-filter(previous), fgl-control-selected(previous), fgl-control-evidence-open?(previous));
        }
        def fgl-control-supported?(action) = if str_eq(action, "focus") then 1 else if str_eq(action, "inspect") then 1 else if str_eq(action, "continue") then 1 else if str_eq(action, "request-evidence") then 1 else if str_eq(action, "abstain") then 1 else fgl-choice-walk?(action);
        def fgl-control-selector-valid?(samples, argument) = if not(eq(fgtm-field-present?(argument), 1)) then 0 else if str_eq(fgtm-field-value(argument), "none") then 1 else if eq(fgd-view?(fgtm-field-value(argument)), 1) then 1 else if eq(fglm-lang-key?(fgtm-field-value(argument)), 1) then 1 else if eq(fgl-ear-selector?(fgtm-field-value(argument)), 1) then 1 else if gt(fgd-count-visible(samples, fgtm-field-value(argument)), 0) then 1 else 0;
        // The ear's stream is metric rows, not telemetry samples, so counting visible samples answers
        // zero for it and would refuse a focus that has rows to show. Its own domain and channel are
        // named here instead: the selector is valid because the sensor publishes under them.
        def fgl-ear-selector?(argument) = if str_eq(argument, FGLEarDomain()) then 1 else if str_eq(argument, FGLEarChannel()) then 1 else 0;
        def fgl-control-offer-applicable?(samples, offer) {
            let action = fgtm-offer-action(offer);
            if not(eq(fgl-control-supported?(action), 1)) then 0 else if eq(fgl-choice-outcome?(action), 1) then gt(len(fgch-slots(fgch-samples-points(samples))), 0) else if str_eq(action, "focus") then fgl-control-selector-valid?(samples, fgtm-offer-argument(offer)) else if str_eq(action, "inspect") then fgtm-field-present?(fgtm-offer-argument(offer)) else 1;
        }
        def fgl-control-applied-state(focus, offer, samples) {
            let action = fgtm-offer-action(offer);
            let argument = fgtm-offer-argument(offer);
            let applicable = fgl-control-offer-applicable?(samples, offer);
            let nextFocus = if not(eq(applicable, 1)) then focus else if str_eq(action, "continue") then "all" else if str_eq(action, "focus") then fgtm-field-value(argument) else if str_eq(action, "request-evidence") then "health" else focus;
            let quit = if and(eq(applicable, 1), str_eq(action, "abstain")) then 1 else 0;
            fgl-control-state(nextFocus, fgtm-offer-id(offer), quit, if eq(applicable, 1) then action else "refused");
        }
        def fgl-control-write-acknowledged?(writeResult) = if lt(len(writeResult), 2) then 0 else if str_eq(nth(writeResult, 1), "acknowledged") then 1 else 0;
        def fgl-control-ack-epoch(offeredEpoch, observedEpoch) = fgd-max(offeredEpoch, observedEpoch);
        def fgl-control-commit(previous, proposed, writeResult) = if eq(fgl-control-write-acknowledged?(writeResult), 1) then proposed else fgl-control-state(fgl-control-focus(previous), fgl-control-last-offer(previous), 0, "ack-failed");

        def fgl-control-proposed(previous, offer, samples) {
            let action = fgtm-offer-action(offer);
            let argument = fgtm-offer-argument(offer);
            let applicable = fgl-control-offer-applicable?(samples, offer);
            let argumentText = if eq(fgtm-field-present?(argument), 1) then fgtm-field-value(argument) else "none";
            let isView = if eq(fgtm-field-present?(argument), 1) then fgd-view?(argumentText) else 0;
            let nextView = if not(eq(applicable, 1)) then fgl-control-view(previous) else if eq(fgl-choice-walk?(action), 1) then "choice" else if and(str_eq(action, "focus"), eq(isView, 1)) then argumentText else if str_eq(action, "continue") then "overview" else fgl-control-view(previous);
            let isLang = if eq(fgtm-field-present?(argument), 1) then or(str_eq(argumentText, "none"), fglm-lang-key?(argumentText)) else 0;
            let nextFocus = if not(eq(applicable, 1)) then fgl-control-focus(previous) else if str_eq(action, "continue") then "all" else if and(str_eq(action, "focus"), and(eq(isView, 0), eq(isLang, 0))) then argumentText else fgl-control-focus(previous);
            let nextFilter = if not(eq(applicable, 1)) then fgl-control-filter(previous) else if str_eq(action, "continue") then "all" else if and(str_eq(action, "focus"), str_eq(argumentText, "none")) then "none" else if and(str_eq(action, "focus"), eq(isLang, 1)) then fglm-toggle(fgl-control-filter(previous), argumentText) else if and(str_eq(action, "focus"), eq(isView, 0)) then argumentText else fgl-control-filter(previous);
            let nextSelected = if and(eq(applicable, 1), str_eq(action, "continue")) then "none" else if and(eq(applicable, 1), str_eq(action, "step")) then fgch-cursor-step(fgl-control-selected(previous)) else if and(eq(applicable, 1), eq(fgl-choice-outcome?(action), 1)) then fgch-cursor-text(fgch-cursor-number(fgl-control-selected(previous))) else if and(eq(applicable, 1), str_eq(action, "inspect")) then argumentText else if and(eq(applicable, 1), str_eq(action, "request-evidence")) then if eq(fgtm-field-present?(argument), 1) then argumentText else fgl-control-selected(previous) else fgl-control-selected(previous);
            let evidenceOpen = if and(eq(applicable, 1), str_eq(action, "continue")) then 0 else if and(eq(applicable, 1), str_eq(action, "request-evidence")) then 1 else if and(eq(applicable, 1), str_eq(action, "inspect")) then 0 else fgl-control-evidence-open?(previous);
            let quit = if and(eq(applicable, 1), str_eq(action, "abstain")) then 1 else 0;
            fgl-control-state-full(nextFocus, fgtm-offer-id(offer), quit, if eq(applicable, 1) then action else "refused", nextView, nextFilter, nextSelected, evidenceOpen);
        }
        def fgl-control-commit-full(previous, proposed, writeResult) = if eq(fgl-control-write-acknowledged?(writeResult), 1) then proposed else fgl-control-state-full(fgl-control-focus(previous), fgl-control-last-offer(previous), 0, "ack-failed", fgl-control-view(previous), fgl-control-filter(previous), fgl-control-selected(previous), fgl-control-evidence-open?(previous));
        def fgl-control-apply-full(previous, offer, samples, epoch) {
            let proposed = fgl-choice-effect(previous, fgl-control-proposed(previous, offer, samples), offer, samples, epoch);
            let disposition = if str_eq(fgl-control-status(proposed), "refused") then "refused" else "applied";
            let ackEpoch = fgl-control-ack-epoch(fgtm-offer-epoch(offer), now_unix_ms());
            let ack = fgtm-control-ack(fgtm-offer-channel(offer), fgtm-offer-id(offer), ackEpoch, disposition, "physical-live", "glass.monitor");
            fgl-control-commit-full(previous, proposed, fgtm-acknowledge-control(FGLRoot(), ack));
        }
        def fgl-control-stale-full(previous, offer, epoch) {
            let proposed = fgl-control-state-full(fgl-control-focus(previous), fgtm-offer-id(offer), 0, "stale", fgl-control-view(previous), fgl-control-filter(previous), fgl-control-selected(previous), fgl-control-evidence-open?(previous));
            let ackEpoch = fgl-control-ack-epoch(fgtm-offer-epoch(offer), now_unix_ms());
            let ack = fgtm-control-ack(fgtm-offer-channel(offer), fgtm-offer-id(offer), ackEpoch, "stale", "physical-live", "glass.monitor");
            fgl-control-commit-full(previous, proposed, fgtm-acknowledge-control(FGLRoot(), ack));
        }
        def fgl-control-from-offer(previous, offer, samples, epoch) = if str_eq(fgtm-offer-id(offer), fgl-control-last-offer(previous)) then fgl-control-state-full(fgl-control-focus(previous), fgl-control-last-offer(previous), 0, "held", fgl-control-view(previous), fgl-control-filter(previous), fgl-control-selected(previous), fgl-control-evidence-open?(previous)) else if eq(fgl-control-offer-fresh?(offer, epoch), 1) then fgl-control-apply-full(previous, offer, samples, epoch) else fgl-control-stale-full(previous, offer, epoch);
        def fgl-control-polled-full(previous, poll, samples, epoch) {
            let field = nth(poll, 3);
            if not(str_eq(nth(poll, 2), "offer")) then fgl-control-state-full(fgl-control-focus(previous), fgl-control-last-offer(previous), 0, nth(poll, 2), fgl-control-view(previous), fgl-control-filter(previous), fgl-control-selected(previous), fgl-control-evidence-open?(previous)) else if not(eq(fgtm-field-present?(field), 1)) then fgl-control-state-full(fgl-control-focus(previous), fgl-control-last-offer(previous), 0, "absent", fgl-control-view(previous), fgl-control-filter(previous), fgl-control-selected(previous), fgl-control-evidence-open?(previous)) else fgl-control-from-offer(previous, fgtm-field-value(field), samples, epoch);
        }
        def fgl-poll-control-full(previous, samples, epoch) = fgl-control-polled-full(previous, fgtm-poll-control(FGLRoot(), FGLControlChannel()), samples, epoch);
        def fgl-poll-control-full-held(previous, samples, epoch, handle) = fgl-control-polled-full(previous, fgtm-poll-control-held(FGLRoot(), FGLControlChannel(), handle), samples, epoch);
        def fgl-control-applied(focus, lastOffer, offer, samples) {
            let previous = fgl-control-state(focus, lastOffer, 0, "held");
            let proposed = fgl-control-applied-state(focus, offer, samples);
            let disposition = if str_eq(fgl-control-status(proposed), "refused") then "refused" else "applied";
            let ack = fgtm-control-ack(fgtm-offer-channel(offer), fgtm-offer-id(offer), now_unix_ms(), disposition, "physical-live", "glass.monitor");
            let wrote = fgtm-acknowledge-control(FGLRoot(), ack);
