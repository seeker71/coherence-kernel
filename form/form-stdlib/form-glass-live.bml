//////////////////////////////////////////////////////////////////////
//
// form-glass-live.bml — self-updating Form glass and control adapter.
// Its dependency identity is sampled in-process; source movement returns
// `selfmolt` to the foreground carrier instead of leaving an old display alive.
//
// Authority: form-stdlib/bml/form-glass-live.bml
// preludes: control/offer-ack-core.fk observe/say.fk form/form-stdlib/form-terminal-canvas.bml form/form-stdlib/form-glass-observer.bml form/form-stdlib/form-fs.fk form/form-stdlib/line-grammar.fk form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/form-glass-event-loop.bml form/form-stdlib/native-model-route-readiness.bml form/form-stdlib/native-model-tensor-ledger.bml form/form-stdlib/native-model-dual-telemetry.bml form/form-stdlib/form-glass-dashboard.bml form/form-stdlib/form-glass-live-ui.bml form/form-stdlib/hearth.bml form/form-stdlib/form-glass-launch.bml form/form-stdlib/form-glass-sensor-rows.bml form/form-stdlib/bml/form-glass-input.bml form/form-stdlib/perception-symbols.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassLiveAuthority {
        field FGLAuthorityPath = "form/form-stdlib/bml/form-glass-live.bml";
        field FGLAuthorityKind = "high-bml-interface-class-const";
    }

    class FormGlassLive {
        field FGLSchema = "form-glass-live-v2";
        def FGLRoot() = hearth-telemetry-root();
        field FGLPublisher = "glass.monitor";
        field FGLControlChannel = "glass-monitor";
        field FGLFreshLeaseMs = 5000;
        field FGLOwnerRefreshMs = 15000;
        field FGLFlowLastName = "glass.monitor.flow-last";
        field FGLControlFreshMs = 30000;
        // the ear's sensor names its rows under these; the glass reads them to focus the room
        field FGLEarDomain = "ear";
        field FGLEarChannel = "voice";
        field FGLHistoryCapacity = 128;
        field FGLActiveHz = 25;
        field FGLQuietHz = 20;
        field FGLStringMoltGrowth = 262144;
        field FGLNodeMoltGrowth = 262144;
        field FGLQwenRouteId = "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth";
        field FGLThreeBRouteId = "model.llama-3.2-3b-instruct";
        field FGLDualResidentDoor = "observe/native-model-dual-resident-live-run.fk";
        field FGLQwenWeightId = "weights.qwen3.8-flash-next.ud-q2_k_xl.unsloth";
        field FGLThreeBWeightId = "weights.llama-3.2-3b-instruct";
        field FGLJitPublisher = "jit.bml-demand";
        field FGLJitHealedId = "jit.bml-demand.healed";
        ref fgl-authority = FormGlassLiveAuthority;
        thought fgl-law = list("owner-publishes", "one-persistent-process", "poll-dimensions", "observed-frame-ring", "four-transient-attention-two-quiet", "front-back-frame-buffer", "event-wait-door-named", "row-diff", "cursor-visible", "correlate-controls", "input-seam-visible", "observer-tax-visible");

        def fgl-dependency-changed?(held, frame) = !((Comparable) fgl-cycle?(frame, 4) == 1) ? 0 : (String) held == fglu-dependency-manifest() ? 0 : 1;

        def fgl-current-reading-samples(reading) {
            let field = fgtm-read-state-value(reading);
            !((String) fgtm-read-state-status(reading) == "current") ? list() : !((Comparable) fgtm-field-present?(field) == 1) ? list() : fgtm-snapshot-samples(fgtm-field-value(field));
        }
        def fgl-jit-current-samples-at(root) = fgl-current-reading-samples(fgtm-read-current(root, FGLJitPublisher()));
        def fgl-jit-current-samples() = fgl-jit-current-samples-at(FGLRoot());
        def fgl-jit-current-samples-held(handle) = fgl-current-reading-samples(fgtm-read-current-held(FGLRoot(), FGLJitPublisher(), handle));
        def fgl-sample-stale?(sample) = (String) fgtm-sample-source(sample) == "glass.stale-snapshot" ? 1 : (String) fgtm-sample-source(sample) == "glass.projection-stale" ? 1 : fgd-has-channel(fgtm-sample-channels(sample), "snapshot-stale");
        def fgl-honest-sample(sample) = sample;
        def fgl-honest-samples(samples) = (Comparable) len(samples) == 0 ? list() : cons(fgl-honest-sample(head(samples)), fgl-honest-samples(tail(samples)));
        def fgl-stale-sample(sample) = fgtm-carry-cell(sample, fgl-stale-sample-fields(sample));
        def fgl-stale-sample-fields(sample) = fgtm-sample(fgtm-sample-id(sample), fgtm-sample-parent(sample), fgtm-sample-kind(sample), fgtm-sample-plane(sample), fgtm-sample-owner(sample), fgtm-sample-lane(sample), fgtm-sample-purpose(sample), fgtm-sample-bytes(sample), fgtm-sample-capacity(sample), fgtm-sample-lifecycle(sample), fgtm-sample-read-epoch(sample), fgtm-sample-write-epoch(sample), fgtm-sample-heat(sample), fgtm-sample-handle(sample), fgtm-sample-evictability(sample), (String) fgtm-sample-evidence(sample) == "physical-live" ? "derived-window" : fgtm-sample-evidence(sample), fgtm-sample-source(sample), (Comparable) fgd-has-channel(fgtm-sample-channels(sample), "snapshot-stale") == 1 ? fgtm-sample-channels(sample) : append(fgtm-sample-channels(sample), list("snapshot-stale")));
        def fgl-stale-samples(samples) = (Comparable) len(samples) == 0 ? list() : cons(fgl-stale-sample(head(samples)), fgl-stale-samples(tail(samples)));
        // one door for "how old is this reading" -- fgtm-snapshot-age, beside the
        // read that made it -- so the glass and every other reader ask the same
        // question rather than each doing the subtraction its own way
        def fgl-snapshot-fresh?(snapshot, epoch) {
            let age = fgtm-snapshot-age(snapshot, epoch);
            age < 0 ? 0 : age <= FGLFreshLeaseMs() ? 1 : 0;
        }
        def fgl-current-reading-samples-at(reading, epoch) {
            let field = fgtm-read-state-value(reading);
            !((String) fgtm-read-state-status(reading) == "current") ? list() : !((Comparable) fgtm-field-present?(field) == 1) ? list() : (Comparable) fgl-snapshot-fresh?(fgtm-field-value(field), epoch) == 1 ? fgl-honest-samples(fgtm-snapshot-samples(fgtm-field-value(field))) : fgl-stale-samples(fgl-honest-samples(fgtm-snapshot-samples(fgtm-field-value(field))));
        }
        def fgl-reading-samples-at(readings, epoch) = (Comparable) len(readings) == 0 ? list() : append(fgl-current-reading-samples-at(head(readings), epoch), fgl-reading-samples-at(tail(readings), epoch));
        def fgl-sample-id-held?(held, id) = (Comparable) len(held) == 0 ? 0 : (String) fgtm-sample-id(head(held)) == id ? 1 : fgl-sample-id-held?(tail(held), id);
        def fgl-dedupe-samples-go(samples, held) = (Comparable) len(samples) == 0 ? held : (Comparable) fgl-sample-id-held?(held, fgtm-sample-id(head(samples))) == 1 ? fgl-dedupe-samples-go(tail(samples), held) : fgl-dedupe-samples-go(tail(samples), append(held, list(head(samples))));
        def fgl-identity-map(count) = km-for(count / FGDIndexBucketLoad());
        def fgl-dedupe-samples(samples) = fgl-dedupe-indexed(samples, fgl-identity-map(len(samples)), list());
        def fgl-dedupe-indexed(samples, seen, held) = nil?(samples) ? reverse(held) : fgl-dedupe-keyed(head(samples), tail(samples), seen, held, fgd-key-bytes(fgtm-sample-id(head(samples))));
        def fgl-dedupe-keyed(sample, rest, seen, held, key) {
            let hash = fgd-key-hash(key);
            km-get-h(seen, hash, key, 0) ? fgl-dedupe-indexed(rest, seen, held) : fgl-dedupe-indexed(rest, fgd-key-put(seen, hash, key, 1), cons(sample, held));
        }
        def fgl-same-sample-ids(a, b) = !((Comparable) len(a) == len(b)) ? 0 : fgl-same-sample-ids-go(a, b);
        def fgl-same-sample-ids-go(a, b) = nil?(a) ? 1 : !((String) fgtm-sample-id(head(a)) == fgtm-sample-id(head(b))) ? 0 : fgl-same-sample-ids-go(tail(a), tail(b));
        def fgl-dedupe-cache(samples, prior) = list(samples, ((Comparable) len(prior) == 2) && fgl-same-sample-ids(samples, head(prior)) ? prior[1] : fgl-unique-positions(samples, 0, fgl-identity-map(len(samples)), list()));
        def fgl-unique-positions(samples, position, seen, held) = nil?(samples) ? reverse(held) : fgl-unique-position(samples, position, seen, held, fgd-key-bytes(fgtm-sample-id(head(samples))));
        def fgl-unique-position(samples, position, seen, held, key) {
            let hash = fgd-key-hash(key);
            km-get-h(seen, hash, key, 0) ? fgl-unique-positions(tail(samples), position + 1, seen, held) : fgl-unique-positions(tail(samples), position + 1, fgd-key-put(seen, hash, key, 1), cons(position, held));
        }
        def fgl-dedupe-cache-values(cache) = fgl-position-values(head(cache), cache[1]);
        def fgl-position-values(samples, positions) = positions |> map(position => samples[position]);
        def fgl-sample-entry(snapshotEpoch, publisher, sample) = list("glass-sample-entry-v2", snapshotEpoch, publisher, sample);
        def fgl-entry-epoch(entry) = entry[1];
        def fgl-entry-publisher(entry) = entry[2];
        def fgl-entry-sample(entry) = entry[3];
        def fgl-wrap-sample-entries(snapshotEpoch, publisher, samples) = (Comparable) len(samples) == 0 ? list() : cons(fgl-sample-entry(snapshotEpoch, publisher, head(samples)), fgl-wrap-sample-entries(snapshotEpoch, publisher, tail(samples)));
        def fgl-reading-sample-entries-at(readings, epoch) = (Comparable) len(readings) == 0 ? list() : append(fgl-current-reading-entries-at(head(readings), epoch), fgl-reading-sample-entries-at(tail(readings), epoch));
        def fgl-current-reading-entries-at(reading, epoch) {
            let field = fgtm-read-state-value(reading);
            !((String) fgtm-read-state-status(reading) == "current") ? list() : !((Comparable) fgtm-field-present?(field) == 1) ? list() : fgl-wrap-sample-entries(fgtm-snapshot-epoch(fgtm-field-value(field)), reading[1], fgl-current-reading-samples-at(reading, epoch));
        }
        def fgl-same-physical-model?(left, right) = !((String) fgtm-sample-kind(left) == "model") ? 0 : !((String) fgtm-sample-kind(right) == "model") ? 0 : !((Comparable) fgtm-field-present?(fgtm-sample-handle(left)) == 1) ? 0 : !((Comparable) fgtm-field-present?(fgtm-sample-handle(right)) == 1) ? 0 : ((Comparable) fgtm-field-value(fgtm-sample-handle(left)) == fgtm-field-value(fgtm-sample-handle(right)));
        // The entry being placed is FIXED for the whole walk of held, so its
        // publisher and its sample id are read once at the door rather than
        // again at every comparison. This is the glass's hottest loop -- the
        // live page names fgtm-sample-id its most-called recipe of all -- and
        // the identity test is where those calls were being made.
        def fgl-same-entry-identity?(left, right) = fgl-same-keyed-identity?(left, fgl-entry-publisher(left), fgtm-sample-id(fgl-entry-sample(left)), right);
        def fgl-same-keyed-identity?(left, pub, id, right) = !((String) pub == fgl-entry-publisher(right)) ? 0 : (String) id == fgtm-sample-id(fgl-entry-sample(right)) ? 1 : fgl-same-physical-model?(fgl-entry-sample(left), fgl-entry-sample(right));
        def fgl-insert-newest-entry(entry, held) = fgl-insert-newest-keyed(entry, fgl-entry-publisher(entry), fgtm-sample-id(fgl-entry-sample(entry)), held);
        def fgl-insert-newest-keyed(entry, pub, id, held) = (Comparable) len(held) == 0 ? list(entry) : (Comparable) fgl-same-keyed-identity?(entry, pub, id, head(held)) == 1 ? (fgl-entry-epoch(entry) > fgl-entry-epoch(head(held)) ? cons(entry, tail(held)) : held) : cons(head(held), fgl-insert-newest-keyed(entry, pub, id, tail(held)));
        def fgl-newest-entries(entries, held) = (Comparable) len(entries) == 0 ? held : fgl-newest-entries(tail(entries), fgl-insert-newest-entry(head(entries), held));
        def fgl-entry-samples(entries) = (Comparable) len(entries) == 0 ? list() : cons(fgl-entry-sample(head(entries)), fgl-entry-samples(tail(entries)));
        // Most snapshots already carry distinct identities. Prove that with
        // exact keys once; retain the established newest/physical-alias fold
        // when any duplicate exists (its identity relation is not transitive).
        def fgl-newest-samples-by-snapshot(entries) = fgl-entry-samples(fgl-entries-distinct(entries, fgl-identity-map(len(entries) * 2)) ? entries : fgl-newest-entries(entries, list()));
        def fgl-entries-distinct(entries, seen) = fgl-entries-distinct-in(entries, seen, "", list(), km-seed());
        def fgl-entries-distinct-in(entries, seen, prior, prefix, prefixHash) = nil?(entries) ? 1 : (String) fgl-entry-publisher(head(entries)) == prior ? fgl-entry-distinct(head(entries), tail(entries), seen, prefix, prefixHash) : fgl-entry-distinct-prefix(entries, seen, fgd-key-bytes(fgl-entry-publisher(head(entries))));
        def fgl-entry-distinct-prefix(entries, seen, prefix) = fgl-entry-distinct(head(entries), tail(entries), seen, prefix, fgd-key-hash(prefix));
        def fgl-entry-distinct(entry, rest, seen, publisher, prefixHash) {
            let sample = fgl-entry-sample(entry);
            let suffix = cons(-1, fgd-key-bytes(fgtm-sample-id(sample)));
            let key = append(publisher, suffix);
            let hash = fgd-key-fold(suffix, prefixHash);
            km-get-h(seen, hash, key, 0) ? 0 : fgl-entry-distinct-model(sample, rest, fgd-key-put(seen, hash, key, 1), fgl-entry-publisher(entry), publisher, prefixHash);
        }
        def fgl-entry-distinct-model(sample, rest, seen, name, publisher, prefixHash) = ((String) fgtm-sample-kind(sample) == "model") && ((Comparable) fgtm-field-present?(fgtm-sample-handle(sample)) == 1) ? fgl-entry-distinct-handle(rest, seen, name, publisher, prefixHash, list(-2, fgtm-field-value(fgtm-sample-handle(sample)))) : fgl-entries-distinct-in(rest, seen, name, publisher, prefixHash);
        def fgl-entry-distinct-handle(rest, seen, name, publisher, prefixHash, suffix) {
            let key = append(publisher, suffix);
            let hash = fgd-key-fold(suffix, prefixHash);
            km-get-h(seen, hash, key, 0) ? 0 : fgl-entries-distinct-in(rest, fgd-key-put(seen, hash, key, 1), name, publisher, prefixHash);
        }
        def fgl-same-entry-keys(a, b) = !((Comparable) len(a) == len(b)) ? 0 : fgl-same-entry-keys-go(a, b);
        def fgl-same-entry-keys-go(a, b) = nil?(a) ? 1 : !(((String) fgl-entry-publisher(head(a)) == fgl-entry-publisher(head(b))) && fgl-same-sample-key(fgl-entry-sample(head(a)), fgl-entry-sample(head(b)))) ? 0 : fgl-same-entry-keys-go(tail(a), tail(b));
        def fgl-same-sample-key(a, b) = ((String) fgtm-sample-id(a) == fgtm-sample-id(b)) && (((String) fgtm-sample-kind(a) == fgtm-sample-kind(b)) && ((Value) fgtm-sample-handle(a) == fgtm-sample-handle(b)));
        def fgl-entry-cache(entries, prior) {
            let reusable = !((Comparable) len(prior) == 2) ? 0 : !((Comparable) prior[1] == 1) ? 0 : fgl-same-entry-keys(entries, head(prior));
            list(entries, reusable ? 1 : fgl-entries-distinct(entries, fgl-identity-map(len(entries) * 2)));
        }
        def fgl-entry-cache-values(cache) = fgl-entry-samples((Comparable) cache[1] == 1 ? head(cache) : fgl-newest-entries(head(cache), list()));
        def fgl-incarnated-dual-publisher?(publisher) = (Comparable) str_find(publisher, "models.dual-resident.i", 0) == 0;
        def fgl-has-incarnated-dual-publisher?(publishers) = (Comparable) len(publishers) == 0 ? 0 : (Comparable) fgl-incarnated-dual-publisher?(head(publishers)) == 1 ? 1 : fgl-has-incarnated-dual-publisher?(tail(publishers));
        def fgl-current-readings(readings, suppressLegacyDual) = (Comparable) len(readings) == 0 ? list() : ((Comparable) suppressLegacyDual == 1) && ((String) head(readings)[1] == "models.dual-resident") ? fgl-current-readings(tail(readings), suppressLegacyDual) : cons(head(readings), fgl-current-readings(tail(readings), suppressLegacyDual));
        def fgl-inventory-samples-at(inventory, epoch) = !((String) inventory[2] == "current") ? list() : fgl-newest-samples-by-snapshot(fgl-reading-sample-entries-at(fgl-current-readings(inventory[4], fgl-has-incarnated-dual-publisher?(inventory[3])), epoch));
        def fgl-inventory-entries-at(inventory, epoch) = !((String) inventory[2] == "current") ? list() : fgl-reading-sample-entries-at(fgl-current-readings(inventory[4], fgl-has-incarnated-dual-publisher?(inventory[3])), epoch);
        def fgl-inventory-publishers(inventory) = !((String) inventory[2] == "current") ? list() : inventory[3];

        def fgl-owner-liveness-row?(sample) = ((String) fgtm-sample-kind(sample) == "owner-liveness") && (((String) fgtm-sample-lifecycle(sample) == "active") && (((String) fgtm-sample-purpose(sample) == "os-process-lifetime-current") && ((String) fgtm-sample-evidence(sample) == "physical-live"))) ? 1 : ((String) fgtm-sample-kind(sample) == "owner-heartbeat") && ((Comparable) fgtm-field-present?(fgtm-sample-handle(sample)) == 1) ? 1 : 0;
        def fgl-owner-liveness(samples) = (Comparable) len(samples) == 0 ? list() : (Comparable) fgl-owner-liveness-row?(head(samples)) == 1 ? head(samples) : fgl-owner-liveness(tail(samples));
        def fgl-owner-process(samples) {
            let owner = fgl-owner-liveness(samples);
            (Comparable) len(owner) == 0 ? list() : !((Comparable) fgtm-field-present?(fgtm-sample-handle(owner)) == 1) ? list() : fgl-owner-process-read(fgtm-field-value(fgtm-sample-handle(owner)));
        }
        def fgl-owner-process-read(pid) = fgo-process-read(pid);
        def fgl-owner-process-rows(samples) {
            let process = fgl-owner-process(samples);
            (Comparable) len(process) == 0 ? fgl-owner-absent-rows(samples) : fgl-owner-process-rows-present(process, fgo-ps-nice(process));
        }
        def fgl-owner-absent-rows(samples) {
            let owner = fgl-owner-liveness(samples);
            (Comparable) len(owner) == 0 ? list(fgo-int("process", "model-owner-present", "Model owner present", 0, "ready", 0, "process-time", "physical-live", "owner-liveness sample", "empty", "model", "semantic-zero=empty; no owner-liveness publication in the current inventory")) : !((Comparable) fgtm-field-present?(fgtm-sample-handle(owner)) == 1) ? list(fgo-int("process", "model-owner-present", "Model owner present", 0, "ready", 0, "process-time", "physical-live", "owner-liveness handle", "empty", "model", "semantic-zero=empty; owner-liveness row has no pid handle")) : list(fgo-int("process", "model-owner-present", "Model owner present", 0, "ready", 0, "process-time", "physical-live", "owner-liveness + libproc.proc_pidinfo", "released", "model", "owner pid=" ++ int_to_str(fgtm-field-value(fgtm-sample-handle(owner))) ++ " is not a live process; last snapshot remains inspectable with age"));
        }
        def fgl-owner-process-rows-present(process, nice) {
            let pid = fgo-ps-pid(process);
            list(
                fgo-int("process", "model-owner-present", "Model owner present", 1, "ready", 1, "process-time", "physical-live", "owner-liveness + libproc.proc_pidinfo", "live", "model", "owner pid=" ++ int_to_str(pid)),
                fgo-int-or-unavailable("process", "model-owner-rss", "Model owner RSS", fgo-ps-rss-bytes(process), "bytes", fgo-ps-rss-bytes(process), "os-memory", "physical-live", "owner-liveness + libproc.proc_pidinfo", "live", "model", "Qwen3.8-Flash-Next + Llama-3.2-3B owner pid=" ++ int_to_str(pid), "the host withheld the task info of owner pid=" ++ int_to_str(pid)),
                fgo-int-or-unavailable("process", "model-owner-cpu", "Model owner CPU total", fgo-ps-cpu(process), "microseconds", fgo-ps-cpu(process), "cpu-scheduler", "physical-live", "owner-liveness + libproc.proc_pidinfo", (Comparable) fgo-ps-cpu(process) == 0 ? "quiet" : "live", "cpu", "user + system microseconds since start; owner pid=" ++ int_to_str(pid), "the host withheld the task info of owner pid=" ++ int_to_str(pid)),
                fgo-int-or-unavailable("process", "model-owner-elapsed", "Model owner elapsed", fgo-ps-elapsed(process), "seconds", fgo-ps-elapsed(process), "process-time", "physical-live", "owner-liveness + libproc.proc_pidinfo", "live", "model", "owner pid=" ++ int_to_str(pid), "the host withheld the start of owner pid=" ++ int_to_str(pid)),
                !nothing?(nice) ? fgo-int("process", "model-owner-nice", "Model owner nice", nice, "nice", nice, "cpu-scheduler", "physical-live", "owner-liveness + libproc.proc_pidinfo.bsd.nice", "live", "cpu", "cooperative scheduling priority; owner pid=" ++ int_to_str(pid)) : fgo-unavailable("process", "model-owner-nice", "Model owner nice", "nice", "cpu-scheduler", "libproc.proc_pidinfo.bsd.nice", "cpu", "exact owner pid=" ++ int_to_str(pid)));
        }
        def fgl-owner-metric?(row) = (String) fgo-id(row) == "model-owner-present" ? 1 : (String) fgo-id(row) == "model-owner-rss" ? 1 : (String) fgo-id(row) == "model-owner-cpu" ? 1 : (String) fgo-id(row) == "model-owner-elapsed" ? 1 : ((String) fgo-id(row) == "model-owner-nice");
        def fgl-held-owner-rows(rows) = (Comparable) len(rows) == 0 ? list() : (Comparable) fgl-owner-metric?(head(rows)) == 1 ? cons(head(rows), fgl-held-owner-rows(tail(rows))) : fgl-held-owner-rows(tail(rows));
        // Exact owner process observation is useful at least once per second;
        // spawning two ps children at every 250 ms frame displaced the model
        // work Glass exists to reveal. A two-frame cadence is 500 ms at 4 Hz
        // and one second at 2 Hz. Retained rows keep their original observation
        // epoch so their visible age grows between observations.
        def fgl-owner-rows-at(frame, heldFast, samples, epoch) {
            let held = fgl-held-owner-rows(heldFast);
            ((Comparable) len(held) == 0) || ((Comparable) fgl-cycle?(frame, 2) == 1) ? fgo-observe-rows(fgl-owner-process-rows(samples), epoch, frame) : held;
        }

        def fgl-terminal-width() = fgl-terminal-native(terminal_cols(), 100, 1, 1000);
        def fgl-terminal-height() = fgl-terminal-native(terminal_lines(), 30, 1, 300);
        def fgl-terminal-native(value, fallback, low, high) = nothing?(value) ? fallback : (value < low) || (value > high) ? fallback : value;
        def fgl-surface(epoch) = list(fgl-terminal-width(), fgl-terminal-height(), epoch);
        // Resize awareness is a one-second observation, independent of frame
        // rate. The terminal probes never sit on the 250 ms render path.
        def fgl-surface-at(surface, epoch) = (len(surface) < 3) || ((epoch - surface[2]) >= 1000) ? fgl-surface(epoch) : surface;

        def fgl-cycle?(frame, cadence) = (Comparable) ((frame / cadence) * cadence) == frame;
        def fgl-observe-fast-rows(heatRows) {
            let events = framebuffer-events();
            append(fgo-kernel-rows(), append(fgo-framebuffer-rows(events), append(fgo-metal-rows(metal_live(), metal_status()), append(heatRows, fgo-event-rows(events)))));
        }
        def fgl-fast-rows(frame, held, heatRows) = fgl-observe-fast-rows(heatRows);
        def fgl-observe-host-rows() {
            let memoryRows = fgo-host-rows(host_vm_stat());
            let processRows = fgo-live-process-rows();
            append(memoryRows, processRows);
        }
        // ---- the glass's own carried-over cells (last flow point, last cadence, last pageins): tiny frames, no file ----
        // a give answers the frame's seq, or nothing when it did not land (no frame, or a value that cannot cross)
        def fgl-last-give(name, cell) {
            let handle = ggf-offer(fgl-last-name(name), 65536);
            let seq = nothing?(handle) ? nothing() : node_gift_write(handle, cell);
            let released = ggf-release(handle);
