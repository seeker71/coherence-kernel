        def fgl-ear-mark-row(row, wanted) = (Comparable) len(row) == 0 ? "ear ? unread" : (Comparable) fgo-present?(row) == 0 ? "ear ? unread" : ((String) fgo-evidence(row) == "silent") || ((String) fgo-lifecycle(row) == "stale") ? "ear ? stale" : fgl-ear-mark-at(ps-state-of(fgd-metric-value(row)), wanted);
