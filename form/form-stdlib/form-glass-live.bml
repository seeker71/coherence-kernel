            if and(str_eq(if lt(len(ackRead), 3) then "malformed" else nth(ackRead, 2), "ack"), eq(fgtm-field-present?(field), 1)) then fgtm-ack-offer-id(fgtm-field-value(field)) else "none";
        }
        def fgl-control-start-state(ackRead) = fgl-control-state("all", fgl-control-start-last-offer(ackRead), 0, "absent");

        // Keyboard state travels with the retained controller, including across
        // remote offers. Pure feed/transition functions are also the PTY witness.
        def fgl-input-state(control) = if ge(len(control), 10) then nth(control, 9) else fgki-empty();
        def fgl-input-with(control, input) = append(fgd-take(control, 9), list(input));
        def fgl-input-apply(control, samples, action, argument, epoch) {
            let input = fgl-input-state(control);
            let id = fgtm-cat(list("key.", int_to_str(epoch), ".", int_to_str(fgki-serial(input))));
            let offer = fgtm-control-offer(FGLControlChannel(), id, epoch, action, fgl-control-argument(argument), "physical-live", "terminal.keyboard");
