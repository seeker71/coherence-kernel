        def fgl-frame-same-size?(previous, nextFrame) = ((Comparable) len(previous) == 0) || ((Comparable) len(nextFrame) == 0) ? 0 : !((Comparable) fgd-segment-frame-width(previous) == fgd-segment-frame-width(nextFrame)) ? 0 : !((Comparable) fgd-segment-frame-height(previous) == fgd-segment-frame-height(nextFrame)) ? 0 : 1;
