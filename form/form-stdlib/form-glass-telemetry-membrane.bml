section [form.bml] {
    class FormGlassTelemetryMembraneAuthority {
        field FGTMAuthPath = "form/form-stdlib/bml/form-glass-telemetry-membrane.bml";
        field FGTMAuthKind = "high-bml-interface-class-const";
    }

    class FormGlassTelemetryMembrane {
        field FGTMSchema = "glass-sample-v1";
        field FGTMSnapshotSchema = "glass-snapshot-v1";
        field FGTMControlSchema = "glass-control-v1";
        field FGTMSnapshotSuffix = ".glass-snapshot";
        field FGTMInboxSuffix = ".glass-control-inbox";
        field FGTMAckSuffix = ".glass-control-ack";
        field FGTMMaxSamples = 512;
        field FGTMMaxChannels = 16;
        field FGTMMaxIdBytes = 64;
        field FGTMSpaceBound = 119;
        field FGTMMaxSelectorBytes = 256;
        field FGTMMaxSnapshotWireBytes = 1048576;
        field FGTMMaxControlWireBytes = 4096;
        field FGTMMaxPublishers = 128;
        field FGTMOwnerCommandRoot = "native-model-owner-control";
        field FGTMOwnerCommandSuffix = ".owner-command";
        field FGTMOwnerCommandSchema = "native-model-owner-command-v2";
        field FGTMOwnerCommandLeaseMs = 2000;
        ref fgtm-authority = FormGlassTelemetryMembraneAuthority;
        thought fgtm-law = list("absent-is-not-zero", "caller-root-only", "token-metadata-only", "atomic-current-snapshot", "bounded-control-enums");

        // Presence is data.  The placeholder in an absent field is never read.
        def fgtm-absent() = list("glass-field-v1", 0, 0);
        def fgtm-present(value) = list("glass-field-v1", 1, value);
        def fgtm-field-present?(field) = field[1];
        def fgtm-field-value(field) = field[2];
        def fgtm-field-shape?(field) = !((Comparable) len(field) == 3) ? 0 : !((String) head(field) == "glass-field-v1") ? 0 : ((Comparable) fgtm-field-present?(field) == 0) || ((Comparable) fgtm-field-present?(field) == 1) ? 1 : 0;

        def fgtm-lower-or-digit?(byte) = (byte >= 97) && (byte <= 122) ? 1 : (byte >= 48) && (byte <= 57) ? 1 : 0;
        def fgtm-id-byte?(byte) = (Comparable) fgtm-lower-or-digit?(byte) == 1 ? 1 : (Comparable) byte == 45 ? 1 : (Comparable) byte == 46 ? 1 : (Comparable) byte == 95 ? 1 : 0;
        def fgtm-id-bytes?(text, index, count) = index >= count ? 1 : (Comparable) fgtm-id-byte?(str_byte_at(text, index)) == 1 ? fgtm-id-bytes?(text, index + 1, count) : 0;
        def fgtm-channel-id?(text) {
            let count = str_len(text);
            count < 1 ? 0 : count > FGTMMaxIdBytes() ? 0 : !((Comparable) fgtm-lower-or-digit?(str_byte_at(text, 0)) == 1) ? 0 : !((Comparable) fgtm-lower-or-digit?(str_byte_at(text, count - 1)) == 1) ? 0 : str_find(text, "..", 0) >= 0 ? 0 : fgtm-id-bytes?(text, 0, count);
        }
        def fgtm-label?(text) = fgtm-channel-id?(text);
        def fgtm-selector?(text) {
            let count = str_len(text);
            count < 1 ? 0 : count > FGTMMaxSelectorBytes() ? 0 : !((Comparable) fgtm-lower-or-digit?(str_byte_at(text, 0)) == 1) ? 0 : !((Comparable) fgtm-lower-or-digit?(str_byte_at(text, count - 1)) == 1) ? 0 : fgtm-id-bytes?(text, 0, count);
        }
        def fgtm-root-byte-safe?(root, index, count) = index >= count ? 1 : ((Comparable) str_byte_at(root, index) == 0) || (((Comparable) str_byte_at(root, index) == 10) || ((Comparable) str_byte_at(root, index) == 13)) ? 0 : fgtm-root-byte-safe?(root, index + 1, count);
        def fgtm-root-valid?(root) = str_len(root) < 1 ? 0 : str_len(root) > 512 ? 0 : fgtm-root-byte-safe?(root, 0, str_len(root));

        def fgtm-uint-text-bytes?(text, index, count) = index >= count ? 1 : (str_byte_at(text, index) >= 48) && (str_byte_at(text, index) <= 57) ? fgtm-uint-text-bytes?(text, index + 1, count) : 0;
        def fgtm-uint-text?(text) = str_len(text) < 1 ? 0 : str_len(text) > 19 ? 0 : !((Comparable) fgtm-uint-text-bytes?(text, 0, str_len(text)) == 1) ? 0 : (str_len(text) > 1) && ((Comparable) str_byte_at(text, 0) == 48) ? 0 : ((String) int_to_str(str_to_int(text)) == text);
        def fgtm-numeric-field-valid?(field) = !((Comparable) fgtm-field-shape?(field) == 1) ? 0 : (Comparable) fgtm-field-present?(field) == 0 ? 1 : fgtm-field-value(field) >= 0 ? 1 : 0;
        def fgtm-label-field-valid?(field) = !((Comparable) fgtm-field-shape?(field) == 1) ? 0 : (Comparable) fgtm-field-present?(field) == 0 ? 1 : fgtm-label?(fgtm-field-value(field));
        def fgtm-selector-field-valid?(field) = !((Comparable) fgtm-field-shape?(field) == 1) ? 0 : (Comparable) fgtm-field-present?(field) == 0 ? 1 : fgtm-selector?(fgtm-field-value(field));
        def fgtm-language-field-valid?(field) = !((Comparable) fgtm-field-shape?(field) == 1) ? 0 : !((Comparable) fgtm-field-present?(field) == 1) ? 0 : str_len(fgtm-field-value(field)) > FGTMMaxSelectorBytes() ? 0 : tln-valid-selection?(fgtm-field-value(field));
        def fgtm-control-argument-valid?(action, field) = (String) action == "languages" ? fgtm-language-field-valid?(field) : ((String) action == "inspect") || ((String) action == "request-evidence") ? fgtm-selector-field-valid?(field) : fgtm-label-field-valid?(field);

        def fgtm-plane?(plane) = (String) plane == "form" ? 1 : (String) plane == "cpu" ? 1 : (String) plane == "gpu" ? 1 : (String) plane == "metal" ? 1 : (String) plane == "mlx" ? 1 : (String) plane == "unified" ? 1 : (String) plane == "disk" ? 1 : (String) plane == "network" ? 1 : (String) plane == "membrane" ? 1 : (String) plane == "unknown" ? 1 : 0;
        def fgtm-lifecycle?(state) = (String) state == "allocated" ? 1 : (String) state == "mapped" ? 1 : (String) state == "resident" ? 1 : (String) state == "prefilling" ? 1 : (String) state == "ready" ? 1 : (String) state == "active" ? 1 : (String) state == "completed" ? 1 : (String) state == "idle" ? 1 : (String) state == "cooling" ? 1 : (String) state == "evictable" ? 1 : (String) state == "pinned" ? 1 : (String) state == "released" ? 1 : (String) state == "failed" ? 1 : (String) state == "stored" ? 1 : (String) state == "crystallized" ? 1 : (String) state == "loading" ? 1 : (String) state == "unknown" ? 1 : 0;
        def fgtm-evictability?(state) = (String) state == "never" ? 1 : (String) state == "pinned" ? 1 : (String) state == "pressure-only" ? 1 : (String) state == "policy-ranked" ? 1 : (String) state == "inactive-only" ? 1 : (String) state == "eligible" ? 1 : (String) state == "released" ? 1 : (String) state == "unknown" ? 1 : 0;
        def fgtm-evidence?(kind) = (String) kind == "physical-live" ? 1 : (String) kind == "derived-window" ? 1 : (String) kind == "catalog" ? 1 : (String) kind == "declared" ? 1 : 0;
        def fgtm-control-action?(action) = (String) action == "languages" ? 1 : (String) action == "continue" ? 1 : (String) action == "branch" ? 1 : (String) action == "revise" ? 1 : (String) action == "abstain" ? 1 : (String) action == "request-evidence" ? 1 : (String) action == "rehearse-ground" ? 1 : (String) action == "alternative-node" ? 1 : (String) action == "focus" ? 1 : (String) action == "inspect" ? 1 : (String) action == "step" ? 1 : (String) action == "take" ? 1 : (String) action == "hold" ? 1 : 0;
        def fgtm-control-disposition?(state) = (String) state == "applied" ? 1 : (String) state == "refused" ? 1 : (String) state == "stale" ? 1 : (String) state == "superseded" ? 1 : (String) state == "nothing" ? 1 : 0;

        def fgtm-channels-valid?(channels) = len(channels) > FGTMMaxChannels() ? 0 : (Comparable) len(channels) == 0 ? 1 : !((Comparable) fgtm-channel-id?(head(channels)) == 1) ? 0 : fgtm-channels-valid?(tail(channels));

        // GlassSample order is stable and deliberately contains no payload cell.
        def fgtm-sample(id, parent, kind, memoryPlane, owner, lane, purpose, bytes, capacity, lifecycle, readEpoch, writeEpoch, heat, physicalHandle, evictability, evidence, source, channels) = list(FGTMSchema(), id, parent, kind, memoryPlane, owner, lane, purpose, bytes, capacity, lifecycle, readEpoch, writeEpoch, heat, physicalHandle, evictability, evidence, source, channels);
        def fgtm-sample-id(sample) = sample[1];
        def fgtm-sample-parent(sample) = sample[2];
        def fgtm-sample-kind(sample) = sample[3];
        def fgtm-sample-plane(sample) = sample[4];
        def fgtm-sample-owner(sample) = sample[5];
        def fgtm-sample-lane(sample) = sample[6];
        def fgtm-sample-purpose(sample) = sample[7];
        def fgtm-sample-bytes(sample) = sample[8];
        def fgtm-sample-capacity(sample) = sample[9];
        def fgtm-sample-lifecycle(sample) = sample[10];
        def fgtm-sample-read-epoch(sample) = sample[11];
        def fgtm-sample-write-epoch(sample) = sample[12];
        def fgtm-sample-heat(sample) = sample[13];
        def fgtm-sample-handle(sample) = sample[14];
        def fgtm-sample-evictability(sample) = sample[15];
        def fgtm-sample-evidence(sample) = sample[16];
        def fgtm-sample-source(sample) = sample[17];
        def fgtm-sample-channels(sample) = sample[18];
        def fgtm-sample-valid-tail?(sample) = !((Comparable) fgtm-numeric-field-valid?(fgtm-sample-bytes(sample)) == 1) ? 0 : !((Comparable) fgtm-numeric-field-valid?(fgtm-sample-capacity(sample)) == 1) ? 0 : !((Comparable) fgtm-lifecycle?(fgtm-sample-lifecycle(sample)) == 1) ? 0 : !((Comparable) fgtm-numeric-field-valid?(fgtm-sample-read-epoch(sample)) == 1) ? 0 : !((Comparable) fgtm-numeric-field-valid?(fgtm-sample-write-epoch(sample)) == 1) ? 0 : !((Comparable) fgtm-numeric-field-valid?(fgtm-sample-heat(sample)) == 1) ? 0 : ((Comparable) fgtm-field-present?(fgtm-sample-heat(sample)) == 1) && (fgtm-field-value(fgtm-sample-heat(sample)) > 1000) ? 0 : !((Comparable) fgtm-numeric-field-valid?(fgtm-sample-handle(sample)) == 1) ? 0 : !((Comparable) fgtm-evictability?(fgtm-sample-evictability(sample)) == 1) ? 0 : !((Comparable) fgtm-evidence?(fgtm-sample-evidence(sample)) == 1) ? 0 : !((Comparable) fgtm-label?(fgtm-sample-source(sample)) == 1) ? 0 : fgtm-channels-valid?(fgtm-sample-channels(sample));
        def fgtm-sample-valid?(sample) = (!((Comparable) len(sample) == 19)) && (!((Comparable) len(sample) == 20)) ? 0 : !((String) head(sample) == FGTMSchema()) ? 0 : !((Comparable) fgtm-label?(fgtm-sample-id(sample)) == 1) ? 0 : !((Comparable) fgtm-label-field-valid?(fgtm-sample-parent(sample)) == 1) ? 0 : !((Comparable) fgtm-label?(fgtm-sample-kind(sample)) == 1) ? 0 : !((Comparable) fgtm-plane?(fgtm-sample-plane(sample)) == 1) ? 0 : !((Comparable) fgtm-label?(fgtm-sample-owner(sample)) == 1) ? 0 : !((Comparable) fgtm-label?(fgtm-sample-lane(sample)) == 1) ? 0 : !((Comparable) fgtm-label?(fgtm-sample-purpose(sample)) == 1) ? 0 : fgtm-sample-valid-tail?(sample);
        def fgtm-samples-valid?(samples) = len(samples) > FGTMMaxSamples() ? 0 : (Comparable) len(samples) == 0 ? 1 : !((Comparable) fgtm-sample-valid?(head(samples)) == 1) ? 0 : fgtm-samples-valid?(tail(samples));

        // ---- a sample may carry a CELL --------------------------------------
        // The snapshot crosses as a cell (R111), so anything a cell can hold can
        // cross: a ledger, a list of options, a sentence. The nineteen fields
        // stay exactly as they are and stay label-shaped -- they are the shared
        // vocabulary every view renders and every reader indexes by. This is the
        // twentieth: the publisher's own structure, in the publisher's own shape,
        // for readers that know it and invisible to those that do not.
        //
        // It exists because the alternative kept coming back. A channel is a
        // LABEL because a text wire once used "," and "|" to separate them; that
        // wire stopped crossing at R111 and was removed 2026-09-08, and its rule
        // outlived it -- which is why a choice point's ledger went out as
        // "led.5.3.1.1.1500" and came back through a split. Encoding into a
        // label and parsing it back is what a carrier that takes cells never
        // needed.
        def fgtm-sample-carries-cell?(sample) = len(sample) < 20 ? 0 : 1;
        def fgtm-sample-cell(sample) = (Comparable) fgtm-sample-carries-cell?(sample) == 0 ? list() : sample[19];
        def fgtm-with-cell(sample, cell) = append(fgtm-without-cell(sample), list(cell));
        def fgtm-without-cell(sample) = (Comparable) fgtm-sample-carries-cell?(sample) == 0 ? sample : fgtm-sample(fgtm-sample-id(sample), fgtm-sample-parent(sample), fgtm-sample-kind(sample), fgtm-sample-plane(sample), fgtm-sample-owner(sample), fgtm-sample-lane(sample), fgtm-sample-purpose(sample), fgtm-sample-bytes(sample), fgtm-sample-capacity(sample), fgtm-sample-lifecycle(sample), fgtm-sample-read-epoch(sample), fgtm-sample-write-epoch(sample), fgtm-sample-heat(sample), fgtm-sample-handle(sample), fgtm-sample-evictability(sample), fgtm-sample-evidence(sample), fgtm-sample-source(sample), fgtm-sample-channels(sample));
        // a rebuilt sample keeps whatever cell the original carried
        def fgtm-carry-cell(from, rebuilt) = (Comparable) fgtm-sample-carries-cell?(from) == 0 ? rebuilt : fgtm-with-cell(rebuilt, fgtm-sample-cell(from));

        def fgtm-field-wire(field) = (Comparable) fgtm-field-present?(field) == 0 ? "a" : "p:" ++ int_to_str(fgtm-field-value(field));
        def fgtm-label-field-wire(field) = (Comparable) fgtm-field-present?(field) == 0 ? "a" : "p:" ++ fgtm-field-value(field);
        def fgtm-cat(parts) = (Comparable) len(parts) == 0 ? "" : head(parts) ++ fgtm-cat(tail(parts));
        def fgtm-sample-selection-id(sample) = fgtm-cat(list("sample.", int_to_str(str_len(fgtm-sample-source(sample))), ".", fgtm-sample-source(sample), ".", int_to_str(str_len(fgtm-sample-lane(sample))), ".", fgtm-sample-lane(sample), ".", int_to_str(str_len(fgtm-sample-id(sample))), ".", fgtm-sample-id(sample)));

        def fgtm-snapshot(publisher, epoch, samples) = list(FGTMSnapshotSchema(), publisher, epoch, samples);
        def fgtm-snapshot-publisher(snapshot) = snapshot[1];
        def fgtm-snapshot-epoch(snapshot) = snapshot[2];
        def fgtm-snapshot-samples(snapshot) = snapshot[3];
        def fgtm-snapshot-valid?(snapshot) = !((Comparable) len(snapshot) == 4) ? 0 : !((String) head(snapshot) == FGTMSnapshotSchema()) ? 0 : !((Comparable) fgtm-channel-id?(fgtm-snapshot-publisher(snapshot)) == 1) ? 0 : fgtm-snapshot-epoch(snapshot) < 0 ? 0 : fgtm-samples-valid?(fgtm-snapshot-samples(snapshot));

        def fgtm-invalid-field() = list("glass-field-v1", -1, 0);
        def fgtm-parse-number-field(text) = (String) text == "a" ? fgtm-absent() : (str_len(text) >= 3) && ((String) substring(text, 0, 2) == "p:") ? ((Comparable) fgtm-uint-text?(substring(text, 2, str_len(text))) == 1 ? fgtm-present(str_to_int(substring(text, 2, str_len(text)))) : fgtm-invalid-field()) : fgtm-invalid-field();
        def fgtm-parse-label-field(text) = (String) text == "a" ? fgtm-absent() : (str_len(text) >= 3) && ((String) substring(text, 0, 2) == "p:") ? ((Comparable) fgtm-label?(substring(text, 2, str_len(text))) == 1 ? fgtm-present(substring(text, 2, str_len(text))) : fgtm-invalid-field()) : fgtm-invalid-field();
        def fgtm-parse-selector-field(text) = (String) text == "a" ? fgtm-absent() : (str_len(text) >= 3) && ((String) substring(text, 0, 2) == "p:") ? ((Comparable) fgtm-selector?(substring(text, 2, str_len(text))) == 1 ? fgtm-present(substring(text, 2, str_len(text))) : fgtm-invalid-field()) : fgtm-invalid-field();
        def fgtm-parse-language-field(text) = !((str_len(text) >= 3) && ((String) substring(text, 0, 2) == "p:")) ? fgtm-invalid-field() : (Comparable) fgtm-language-field-valid?(fgtm-present(substring(text, 2, str_len(text)))) == 1 ? fgtm-present(substring(text, 2, str_len(text))) : fgtm-invalid-field();
        def fgtm-parse-control-argument(action, text) = (String) action == "languages" ? fgtm-parse-language-field(text) : ((String) action == "inspect") || ((String) action == "request-evidence") ? fgtm-parse-selector-field(text) : fgtm-parse-label-field(text);

        def fgtm-publish-refused(reason) = list("glass-publish-v1", "refused", reason, fgtm-absent());
        // ---- the shared-memory lane: a snapshot is a cell given into the publisher's frame; the roster page names every publisher; no file, no wire, no parser ----
        // the root names the space: a frame and its roster entry are keyed root|publisher, so a band's /tmp/test never meets the live telemetry
        // the roster keeps a name of at most FGTMSpaceBound bytes: a root that would push its name past that stands as its 12-byte gift name, so a long checkout path folds and a short root reads byte for byte
        def fgtm-space-root(root, publisher) = str_len(root) + 1 + str_len(publisher) <= FGTMSpaceBound() ? root : ggf-name(root);
        def fgtm-space(root, publisher) = fgtm-space-root(root, publisher) ++ "|" ++ publisher;
        def fgtm-space-lead-of(name, stem) = str_len(name) <= str_len(stem) + 1 ? 0 : (String) substring(name, 0, str_len(stem) + 1) == (stem ++ "|") ? str_len(stem) + 1 : 0;
        def fgtm-space-lead(name, root) {
            let direct = fgtm-space-lead-of(name, root);
            direct > 0 ? direct : str_len(name) < 14 ? 0 : (String) substring(name, 0, 4) == GGFNamePrefix() ? fgtm-space-lead-of(name, ggf-name(root)) : 0;
        }
        def fgtm-space-prefix?(name, root) = fgtm-space-lead(name, root) > 0 ? 1 : 0;
        def fgtm-space-publisher(name, root) = substring(name, fgtm-space-lead(name, root), str_len(name));
        // A roster row is (name lastSpokeMs): the roster keeps the moment each
        // name last registered, which a live publisher does on every publish,
        // and it hands that back with the name. This is the ONLY time a
        // non-snapshot frame has -- a control inbox carries no epoch of its own
        // -- and it costs no frame open, so a reader can tell a giver from a
        // frame merely standing across the whole roster in one call.
        def fgtm-roster-row-name(r) = head(r);
        def fgtm-roster-row-spoke(r) = r[1];
        def fgtm-roster-row-age(r, now) = fgtm-roster-row-spoke(r) > now ? 0 : (now - fgtm-roster-row-spoke(r));
        def fgtm-roster-names(rows) = (Comparable) len(rows) == 0 ? list() : cons(fgtm-roster-row-name(head(rows)), fgtm-roster-names(tail(rows)));
        def fgtm-frames-in-space(rows, root) = (Comparable) len(rows) == 0 ? list() : (Comparable) fgtm-space-prefix?(fgtm-roster-row-name(head(rows)), root) == 1 ? cons(fgtm-space-publisher(fgtm-roster-row-name(head(rows)), root), fgtm-frames-in-space(tail(rows), root)) : fgtm-frames-in-space(tail(rows), root);
        // the same walk, keeping the stamp: (publisher lastSpokeMs)
        def fgtm-spoken-in-space(rows, root) = (Comparable) len(rows) == 0 ? list() : (Comparable) fgtm-space-prefix?(fgtm-roster-row-name(head(rows)), root) == 1 ? cons(list(fgtm-space-publisher(fgtm-roster-row-name(head(rows)), root), fgtm-roster-row-spoke(head(rows))), fgtm-spoken-in-space(tail(rows), root)) : fgtm-spoken-in-space(tail(rows), root);
        def fgtm-spoke-of(spoken, publisher) = (Comparable) len(spoken) == 0 ? -1 : (String) head(head(spoken)) == publisher ? head(spoken)[1] : fgtm-spoke-of(tail(spoken), publisher);
        // A control inbox and its ack stand in this space too, and they are NOT
        // publishers: they carry the control grammar on purpose, so reading one
        // with the snapshot parser answers "malformed" for a channel that is
        // working exactly as built. The membrane already names them by suffix.
        def fgtm-suffix?(name, suffix) = str_len(name) < str_len(suffix) ? 0 : (String) substring(name, str_len(name) - str_len(suffix), str_len(name)) == suffix ? 1 : 0;
        def fgtm-control-frame-name?(name) = (Comparable) fgtm-suffix?(name, FGTMInboxSuffix()) == 1 ? 1 : fgtm-suffix?(name, FGTMAckSuffix());
        def fgtm-publishers-only(names) = (Comparable) len(names) == 0 ? list() : (Comparable) fgtm-control-frame-name?(head(names)) == 1 ? fgtm-publishers-only(tail(names)) : cons(head(names), fgtm-publishers-only(tail(names)));
        def fgtm-roster-in-space(names, root) = fgtm-publishers-only(fgtm-frames-in-space(names, root));
        def fgtm-gift-take(root, publisher) {
            let handle = ggf-receive(fgtm-space(root, publisher));
            let frame = nothing?(handle) ? nothing() : node_gift_read(handle);
            let released = ggf-release(handle);
            nothing?(handle) ? list("absent") : nothing?(frame) ? list("unreadable") : list("read", frame);
        }
        def fgtm-gift-give(root, publisher, bytes, cell) {
            let slot = gift_roster_register(fgtm-space(root, publisher));
            let handle = ggf-offer(fgtm-space(root, publisher), bytes);
            let seq = nothing?(handle) ? nothing() : node_gift_write(handle, cell);
            let released = ggf-release(handle);
            seq ?? -1;
        }
        def fgtm-publish-valid-snapshot(root, publisher, snapshot) {
            let seq = fgtm-gift-give(root, publisher, FGTMMaxSnapshotWireBytes(), snapshot);
            seq < 0 ? list("glass-publish-v1", "failed", publisher, fgtm-present(ggf-name(fgtm-space(root, publisher))), -1, -1, snapshot) : list("glass-publish-v1", "published", publisher, fgtm-present(ggf-name(fgtm-space(root, publisher))), seq, 0, snapshot);
        }
        def fgtm-publish-snapshot(root, publisher, epoch, samples) {
            let snapshot = fgtm-snapshot(publisher, epoch, samples);
            !((Comparable) fgtm-root-valid?(root) == 1) ? fgtm-publish-refused("root") : !((Comparable) fgtm-snapshot-valid?(snapshot) == 1) ? fgtm-publish-refused("snapshot") : fgtm-publish-valid-snapshot(root, publisher, snapshot);
        }

        def fgtm-read-state(channel, state, value) = list("glass-read-v1", channel, state, value);
        def fgtm-read-current-parsed(publisher, parsed) = ((Comparable) len(parsed) == 4) && ((String) head(parsed) == FGTMSnapshotSchema()) ? ((String) fgtm-snapshot-publisher(parsed) == publisher ? fgtm-read-state(publisher, "current", fgtm-present(parsed)) : fgtm-read-state(publisher, "malformed", fgtm-present("publisher-mismatch"))) : fgtm-read-state(publisher, "malformed", fgtm-present(parsed[1]));
        def fgtm-read-current(root, publisher) {
            let taken = ((Comparable) fgtm-root-valid?(root) == 1) && ((Comparable) fgtm-channel-id?(publisher) == 1) ? fgtm-gift-take(root, publisher) : list("refused");
            fgtm-read-current-taken(root, publisher, taken);
        }
        def fgtm-read-current-taken(root, publisher, taken) = !((Comparable) fgtm-root-valid?(root) == 1) ? fgtm-read-state(publisher, "refused", fgtm-present("root")) : !((Comparable) fgtm-channel-id?(publisher) == 1) ? fgtm-read-state(publisher, "refused", fgtm-present("publisher")) : (String) head(taken) == "absent" ? fgtm-read-state(publisher, "absent", fgtm-absent()) : (String) head(taken) == "unreadable" ? fgtm-read-state(publisher, "malformed", fgtm-present("frame-unreadable")) : fgtm-read-current-parsed(publisher, taken[1]);
        // ---- how long ago the reading was MADE ------------------------------
        // "current" says a frame parsed and named its own publisher. It does not
        // say the giver is still giving: shared memory outlives the process, so
        // a publisher that stopped two hours ago still reads current, with all
        // its rows, forever. Witnessed 2026-09-07 on this host -- four
        // publishers current, two of them silent for 100 and 118 minutes, and
        // every reader taking their rows as now.
        //
        // Age is the fact and it lives here beside the read; the BOUND is the
        // reader's, because only the reader knows the cadence it expects. A
        // reading with no snapshot answers -1: no reading is not an age of zero.
        // (The sensor lane already refines this per declared cadence,
        // fgsr-silent? over FGSRSilentFactor; the awareness lane holds a
        // horizon for publishers that declare none.)
        def fgtm-read-snapshot(reading) = !((String) fgtm-read-state-status(reading) == "current") ? list() : fgtm-field-value(fgtm-read-state-value(reading));
        def fgtm-snapshot-age(snapshot, now) {
            (Comparable) len(snapshot) == 0 ? -1 : fgtm-snapshot-epoch(snapshot) > now ? 0 : (now - fgtm-snapshot-epoch(snapshot));
        }
        def fgtm-read-age(reading, now) = fgtm-snapshot-age(fgtm-read-snapshot(reading), now);
        // 1 given inside the bound, 0 standing but silent, -1 no reading at all
        def fgtm-read-given-within?(reading, now, withinMs) {
            let age = fgtm-read-age(reading, now);
            age < 0 ? -1 : age > withinMs ? 0 : 1;
        }
        // The rows, but only from a frame that was actually GIVEN inside the
        // bound. A reader that will label what it finds "physical-live", or
        // count it into a ledger, asks through here; a viewer that means to
        // show the last thing known and mark it stale takes the raw samples and
        // marks them itself.
        def fgtm-read-samples-within(reading, now, withinMs) = !((Comparable) fgtm-read-given-within?(reading, now, withinMs) == 1) ? list() : fgtm-snapshot-samples(fgtm-read-snapshot(reading));

        // ---- the kept lane: the same take over a handle the reader keeps open for its life (ggf-kept-*): no name, no open, no release per read ----
        def fgtm-gift-take-held(handle) {
            let frame = nothing?(handle) ? nothing() : node_gift_read(handle);
            nothing?(handle) ? list("absent") : nothing?(frame) ? list("unreadable") : list("read", frame);
        }
        def fgtm-read-current-held(root, publisher, handle) = fgtm-read-current-taken(root, publisher, ((Comparable) fgtm-root-valid?(root) == 1) && ((Comparable) fgtm-channel-id?(publisher) == 1) ? fgtm-gift-take-held(handle) : list("refused"));
        def fgtm-control-inbox-space(root, channel) = fgtm-space(root, fgtm-control-frame(channel, FGTMInboxSuffix()));
        def fgtm-read-state-status(reading) = reading[2];
        // which carrier answered: "gift" when the shared-memory frame stood and read current, "absent" otherwise -- there is no other carrier
        def fgtm-read-current-carrier(root, publisher) = (String) fgtm-read-state-status(fgtm-read-current(root, publisher)) == "current" ? "gift" : "absent";
        // which carrier answered: "gift" when the shared-memory frame stood and read current, "absent" otherwise -- there is no other carrier
        def fgtm-read-state-value(reading) = reading[3];

        def fgtm-roster-publishers(names, remaining) = ((Comparable) len(names) == 0) || (remaining <= 0) ? list() : (Comparable) fgtm-channel-id?(head(names)) == 1 ? cons(head(names), fgtm-roster-publishers(tail(names), remaining - 1)) : fgtm-roster-publishers(tail(names), remaining);
        def fgtm-inventory-publishers(root, names) = fgtm-roster-publishers(names, FGTMMaxPublishers());
        def fgtm-read-publishers(root, publishers) = (Comparable) len(publishers) == 0 ? list() : cons(fgtm-read-current(root, head(publishers)), fgtm-read-publishers(root, tail(publishers)));
        def fgtm-inventory-current(root) {
            let publishers = fgtm-inventory-publishers(root, fgtm-roster-in-space(gift_roster_names(), root));
            list("glass-inventory-v1", root, "current", publishers, fgtm-read-publishers(root, publishers));
        }
        // ---- the cached inventory: parse a publisher only when its frame moved ----
        // A publisher's key is its gift sequence when the frame stands (offset so
        // the frame sequence is the key; -1 when no frame stands
        // cache = list of (publisher key reading); an unmoved key answers the held
        // reading with no read and no parse, so a steady field costs the glass
        // one stat or one shm_seq per publisher per frame.
        def fgtm-read-key(root, publisher) {
            let handle = ggf-receive(fgtm-space(root, publisher));
            let seq = ggf-seq(handle);
            let released = ggf-release(handle);
            nothing?(handle) ? -1 : seq;
        }
        def fgtm-cache-find(cache, publisher) = (Comparable) len(cache) == 0 ? list() : (String) head(cache)[0] == publisher ? head(cache) : fgtm-cache-find(tail(cache), publisher);
        def fgtm-cache-entry(publisher, key, reading) = list(publisher, key, reading);
        def fgtm-read-cached-one(root, publisher, cache) {
            let key = fgtm-read-key(root, publisher);
            let held = fgtm-cache-find(cache, publisher);
            (len(held) > 0) && ((Comparable) held[1] == key) ? held : fgtm-cache-entry(publisher, key, fgtm-read-current(root, publisher));
        }
        def fgtm-read-publishers-cached(root, publishers, cache, readings, nextCache) {
            (Comparable) len(publishers) == 0 ? list(reverse(readings), reverse(nextCache)) : fgtm-read-publishers-cached-next(root, publishers, cache, readings, nextCache, fgtm-read-cached-one(root, head(publishers), cache));
        }
        def fgtm-read-publishers-cached-next(root, publishers, cache, readings, nextCache, entry) = fgtm-read-publishers-cached(root, tail(publishers), cache, cons(entry[2], readings), cons(entry, nextCache));
        // how many entries of the new cache are not the very entries of the old one (re-read this frame)
        def fgtm-cache-moved(newCache, oldCache, n) = (Comparable) len(newCache) == 0 ? n : fgtm-cache-moved(tail(newCache), oldCache, (Comparable) fgtm-cache-same?(head(newCache), fgtm-cache-find(oldCache, head(newCache)[0])) == 1 ? n : (n + 1));
        def fgtm-cache-same?(entry, held) = (Comparable) len(held) == 0 ? 0 : (Comparable) entry[1] == held[1] ? 1 : 0;
        def fgtm-inventory-moved(pair, oldCache) = fgtm-cache-moved(pair[1], oldCache, 0);
        // the same, over a roster the caller already holds (no directory listing)
        def fgtm-inventory-cached-with(root, publishers, cache) {
            let pair = fgtm-read-publishers-cached(root, publishers, cache, list(), list());
            !((Comparable) fgtm-root-valid?(root) == 1) ? list(list("glass-inventory-v1", root, "refused", list(), list()), cache) : list(list("glass-inventory-v1", root, "current", publishers, pair[0]), pair[1]);
        }
        def fgtm-inventory-roster(root) = !((Comparable) fgtm-root-valid?(root) == 1) ? list() : fgtm-inventory-publishers(root, fgtm-roster-in-space(gift_roster_names(), root));
        def fgtm-inventory-cached(root, cache) = fgtm-inventory-cached-with(root, fgtm-inventory-roster(root), cache);
        // the same cached inventory over kept handles: the key is the kept handle's seq (-1 when no frame stands), the read the kept take
        def fgtm-read-cached-one-held(root, publisher, cache, handle) {
            let key = ggf-seq(handle);
            let held = fgtm-cache-find(cache, publisher);
            (len(held) > 0) && ((Comparable) held[1] == key) ? held : fgtm-cache-entry(publisher, key, fgtm-read-current-held(root, publisher, handle));
        }
        def fgtm-read-publishers-cached-held(root, publishers, cache, readings, nextCache, kept) {
            (Comparable) len(publishers) == 0 ? list(reverse(readings), reverse(nextCache)) : fgtm-read-publishers-cached-held-next(root, publishers, cache, readings, nextCache, kept, fgtm-read-cached-one-held(root, head(publishers), cache, ggf-kept-handle(kept, fgtm-space(root, head(publishers)), "take")));
        }
        def fgtm-read-publishers-cached-held-next(root, publishers, cache, readings, nextCache, kept, entry) = fgtm-read-publishers-cached-held(root, tail(publishers), cache, cons(entry[2], readings), cons(entry, nextCache), kept);
        def fgtm-inventory-cached-held(root, publishers, cache, kept) {
            let pair = fgtm-read-publishers-cached-held(root, publishers, cache, list(), list(), kept);
            !((Comparable) fgtm-root-valid?(root) == 1) ? list(list("glass-inventory-v1", root, "refused", list(), list()), cache) : list(list("glass-inventory-v1", root, "current", publishers, pair[0]), pair[1]);
        }
        // the frames a roster names, as kept wants: list(space, "take", 0) per publisher
        def fgtm-roster-wants(root, publishers) = (Comparable) len(publishers) == 0 ? list() : cons(list(fgtm-space(root, head(publishers)), "take", 0), fgtm-roster-wants(root, tail(publishers)));
        def fgtm-inventory(root) = !((Comparable) fgtm-root-valid?(root) == 1) ? list("glass-inventory-v1", root, "refused", list(), list()) : fgtm-inventory-current(root);
        // answers list(inventory, cache)

        // Control offers contain an enum action and an optional bounded label.
        def fgtm-control-offer(channel, offerId, epoch, action, argument, evidence, source) = list("glass-control-offer-v1", channel, offerId, epoch, action, argument, evidence, source);
        def fgtm-offer-channel(offer) = offer[1];
        def fgtm-offer-id(offer) = offer[2];
        def fgtm-offer-epoch(offer) = offer[3];
        def fgtm-offer-action(offer) = offer[4];
        def fgtm-offer-argument(offer) = offer[5];
        def fgtm-offer-evidence(offer) = offer[6];
        def fgtm-offer-source(offer) = offer[7];
        def fgtm-offer-valid?(offer) = !((Comparable) len(offer) == 8) ? 0 : !((String) head(offer) == "glass-control-offer-v1") ? 0 : !((Comparable) fgtm-channel-id?(fgtm-offer-channel(offer)) == 1) ? 0 : !((Comparable) fgtm-label?(fgtm-offer-id(offer)) == 1) ? 0 : fgtm-offer-epoch(offer) < 0 ? 0 : !((Comparable) fgtm-control-action?(fgtm-offer-action(offer)) == 1) ? 0 : !((Comparable) fgtm-control-argument-valid?(fgtm-offer-action(offer), fgtm-offer-argument(offer)) == 1) ? 0 : !((Comparable) fgtm-evidence?(fgtm-offer-evidence(offer)) == 1) ? 0 : fgtm-label?(fgtm-offer-source(offer));
        def fgtm-offer-wire(offer) = fgtm-cat(list("glass-control-offer-v1|", fgtm-offer-channel(offer), "|", fgtm-offer-id(offer), "|", int_to_str(fgtm-offer-epoch(offer)), "|", fgtm-offer-action(offer), "|", fgtm-label-field-wire(fgtm-offer-argument(offer)), "|", fgtm-offer-evidence(offer), "|", fgtm-offer-source(offer)));
        def fgtm-parse-offer-fields(fields) {
            let offer = fgtm-control-offer(fields[1], fields[2], str_to_int(fields[3]), fields[4], fgtm-parse-control-argument(fields[4], fields[5]), fields[6], fields[7]);
            ((String) head(fields) == "glass-control-offer-v1") && ((Comparable) fgtm-offer-valid?(offer) == 1) ? offer : list("glass-control-offer-invalid-v1");
        }
        def fgtm-parse-offer-wire(text) {
            let fields = split-on(text, "|");
            !((Comparable) len(fields) == 8) ? list("glass-control-offer-invalid-v1") : !((Comparable) fgtm-uint-text?(fields[3]) == 1) ? list("glass-control-offer-invalid-v1") : fgtm-parse-offer-fields(fields);
        }
        // ---- control offers and acks: cells in two small frames per channel, <channel>.inbox and <channel>.ack ----
        def fgtm-control-frame(channel, suffix) = channel ++ suffix;
        def fgtm-offer-control-valid(root, offer) {
            let seq = fgtm-gift-give(root, fgtm-control-frame(fgtm-offer-channel(offer), FGTMInboxSuffix()), FGTMMaxControlWireBytes(), offer);
            seq >= 0 ? list("glass-control-write-v1", "offered", ggf-name(fgtm-space(root, fgtm-control-frame(fgtm-offer-channel(offer), FGTMInboxSuffix()))), seq, 0, offer) : list("glass-control-write-v1", "failed", fgtm-offer-channel(offer), -1, -1, offer);
        }
        def fgtm-offer-control(root, offer) = !((Comparable) fgtm-root-valid?(root) == 1) ? list("glass-control-write-v1", "refused", "root") : !((Comparable) fgtm-offer-valid?(offer) == 1) ? list("glass-control-write-v1", "refused", "offer") : fgtm-offer-control-valid(root, offer);
        def fgtm-poll-parsed(channel, offer) = ((Comparable) len(offer) == 8) && ((String) head(offer) == "glass-control-offer-v1") ? ((String) fgtm-offer-channel(offer) == channel ? list("glass-control-poll-v1", channel, "offer", fgtm-present(offer)) : list("glass-control-poll-v1", channel, "malformed", fgtm-present("channel-mismatch"))) : list("glass-control-poll-v1", channel, "malformed", fgtm-present("offer-shape"));
        def fgtm-poll-taken(channel, taken) = (String) head(taken) == "absent" ? list("glass-control-poll-v1", channel, "absent", fgtm-absent()) : (String) head(taken) == "unreadable" ? list("glass-control-poll-v1", channel, "malformed", fgtm-present("frame-unreadable")) : fgtm-poll-parsed(channel, taken[1]);
        def fgtm-poll-control(root, channel) = !((Comparable) fgtm-root-valid?(root) == 1) ? list("glass-control-poll-v1", channel, "refused", fgtm-present("root")) : !((Comparable) fgtm-channel-id?(channel) == 1) ? list("glass-control-poll-v1", channel, "refused", fgtm-present("channel")) : fgtm-poll-taken(channel, fgtm-gift-take(root, fgtm-control-frame(channel, FGTMInboxSuffix())));
        // the same poll over the inbox handle the reader keeps open (ggf-kept-*)
        def fgtm-poll-control-held(root, channel, handle) = !((Comparable) fgtm-root-valid?(root) == 1) ? list("glass-control-poll-v1", channel, "refused", fgtm-present("root")) : !((Comparable) fgtm-channel-id?(channel) == 1) ? list("glass-control-poll-v1", channel, "refused", fgtm-present("channel")) : fgtm-poll-taken(channel, fgtm-gift-take-held(handle));

        def fgtm-control-ack(channel, offerId, epoch, disposition, evidence, source) = list("glass-control-ack-v1", channel, offerId, epoch, disposition, evidence, source);
        def fgtm-ack-channel(ack) = ack[1];
        def fgtm-ack-offer-id(ack) = ack[2];
        def fgtm-ack-epoch(ack) = ack[3];
        def fgtm-ack-disposition(ack) = ack[4];
        def fgtm-ack-evidence(ack) = ack[5];
        def fgtm-ack-source(ack) = ack[6];
        def fgtm-ack-valid?(ack) = !((Comparable) len(ack) == 7) ? 0 : !((String) head(ack) == "glass-control-ack-v1") ? 0 : !((Comparable) fgtm-channel-id?(fgtm-ack-channel(ack)) == 1) ? 0 : !((Comparable) fgtm-label?(fgtm-ack-offer-id(ack)) == 1) ? 0 : fgtm-ack-epoch(ack) < 0 ? 0 : !((Comparable) fgtm-control-disposition?(fgtm-ack-disposition(ack)) == 1) ? 0 : !((Comparable) fgtm-evidence?(fgtm-ack-evidence(ack)) == 1) ? 0 : fgtm-label?(fgtm-ack-source(ack));
        def fgtm-ack-wire(ack) = fgtm-cat(list("glass-control-ack-v1|", fgtm-ack-channel(ack), "|", fgtm-ack-offer-id(ack), "|", int_to_str(fgtm-ack-epoch(ack)), "|", fgtm-ack-disposition(ack), "|", fgtm-ack-evidence(ack), "|", fgtm-ack-source(ack)));
        def fgtm-parse-ack-fields(fields) {
            let ack = fgtm-control-ack(fields[1], fields[2], str_to_int(fields[3]), fields[4], fields[5], fields[6]);
            ((String) head(fields) == "glass-control-ack-v1") && ((Comparable) fgtm-ack-valid?(ack) == 1) ? ack : list("glass-control-ack-invalid-v1");
        }
        def fgtm-parse-ack-wire(text) {
            let fields = split-on(text, "|");
            !((Comparable) len(fields) == 7) ? list("glass-control-ack-invalid-v1") : !((Comparable) fgtm-uint-text?(fields[3]) == 1) ? list("glass-control-ack-invalid-v1") : fgtm-parse-ack-fields(fields);
        }
        def fgtm-acknowledge-valid(root, ack) {
            let seq = fgtm-gift-give(root, fgtm-control-frame(fgtm-ack-channel(ack), FGTMAckSuffix()), FGTMMaxControlWireBytes(), ack);
            seq >= 0 ? list("glass-control-write-v1", "acknowledged", ggf-name(fgtm-space(root, fgtm-control-frame(fgtm-ack-channel(ack), FGTMAckSuffix()))), seq, 0, ack) : list("glass-control-write-v1", "failed", fgtm-ack-channel(ack), -1, -1, ack);
        }
        def fgtm-acknowledge-control(root, ack) = !((Comparable) fgtm-root-valid?(root) == 1) ? list("glass-control-write-v1", "refused", "root") : !((Comparable) fgtm-ack-valid?(ack) == 1) ? list("glass-control-write-v1", "refused", "ack") : fgtm-acknowledge-valid(root, ack);
        def fgtm-read-ack-parsed(channel, ack) = ((Comparable) len(ack) == 7) && ((String) head(ack) == "glass-control-ack-v1") ? ((String) fgtm-ack-channel(ack) == channel ? list("glass-control-ack-read-v1", channel, "ack", fgtm-present(ack)) : list("glass-control-ack-read-v1", channel, "malformed", fgtm-present("channel-mismatch"))) : list("glass-control-ack-read-v1", channel, "malformed", fgtm-present("ack-shape"));
        def fgtm-read-ack-taken(channel, taken) = (String) head(taken) == "absent" ? list("glass-control-ack-read-v1", channel, "absent", fgtm-absent()) : (String) head(taken) == "unreadable" ? list("glass-control-ack-read-v1", channel, "malformed", fgtm-present("frame-unreadable")) : fgtm-read-ack-parsed(channel, taken[1]);
        def fgtm-read-control-ack(root, channel) = !((Comparable) fgtm-root-valid?(root) == 1) ? list("glass-control-ack-read-v1", channel, "refused", fgtm-present("root")) : !((Comparable) fgtm-channel-id?(channel) == 1) ? list("glass-control-ack-read-v1", channel, "refused", fgtm-present("channel")) : fgtm-read-ack-taken(channel, fgtm-gift-take(root, fgtm-control-frame(channel, FGTMAckSuffix())));

        // ---- the model owner's command lease: one cell in one frame per owner publisher, <publisher>.owner-command ----
        // A pending command is the lease: while one stands and is younger than the lease, a second offer is refused;
        // the owner consumes it by giving the empty cell back into the frame. No lock directory, no lease file.
        def fgtm-command-frame(publisher) = publisher ++ FGTMOwnerCommandSuffix();
        def fgtm-command-cell(publisher, command, epochMs) = list(FGTMOwnerCommandSchema(), publisher, command, epochMs);
        def fgtm-command-cell?(cell) = nothing?(cell) ? 0 : !((Comparable) len(cell) == 4) ? 0 : !((String) head(cell) == FGTMOwnerCommandSchema()) ? 0 : 1;
        def fgtm-command-cell-command(cell) = cell[2];
        def fgtm-command-cell-epoch(cell) = cell[3];
        def fgtm-command-pending(publisher) {
            let taken = fgtm-gift-take(FGTMOwnerCommandRoot(), fgtm-command-frame(publisher));
            !((String) head(taken) == "read") ? list() : (Comparable) fgtm-command-cell?(taken[1]) == 1 ? taken[1] : list();
        }
        def fgtm-command-lease-live?(pending, epochMs) = (Comparable) len(pending) == 0 ? 0 : (epochMs - fgtm-command-cell-epoch(pending)) < FGTMOwnerCommandLeaseMs() ? 1 : 0;
        def fgtm-command-offer-at(publisher, command, epochMs) {
            let pending = fgtm-command-pending(publisher);
            let seq = (Comparable) fgtm-command-lease-live?(pending, epochMs) == 1 ? -2 : fgtm-gift-give(FGTMOwnerCommandRoot(), fgtm-command-frame(publisher), FGTMMaxControlWireBytes(), fgtm-command-cell(publisher, command, epochMs));
            (Comparable) seq == -2 ? list("owner-command-offer-v2", "leased", fgtm-command-cell-command(pending)) : seq >= 0 ? list("owner-command-offer-v2", "offered", command) : list("owner-command-offer-v2", "failed", command);
        }
        def fgtm-command-offer(publisher, command) = fgtm-command-offer-at(publisher, command, now_unix_ms());
        def fgtm-command-consume(publisher) {
            let pending = fgtm-command-pending(publisher);
            let cleared = (Comparable) len(pending) == 0 ? -1 : fgtm-gift-give(FGTMOwnerCommandRoot(), fgtm-command-frame(publisher), FGTMMaxControlWireBytes(), list());
            (Comparable) len(pending) == 0 ? list("owner-command-consume-v2", "waiting", "") : cleared < 0 ? list("owner-command-consume-v2", "failed", fgtm-command-cell-command(pending)) : list("owner-command-consume-v2", "ready", fgtm-command-cell-command(pending));
        }
        def fgtm-command-status(result) = result[1];
        def fgtm-command-value(result) = result[2];
    }
    0;
}
