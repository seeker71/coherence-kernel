section [form.bml] {
    class FormGlassTelemetryMembraneAuthority {
        field FGTMAuthPath = "form/form-stdlib/bml/form-glass-telemetry-membrane.bml";
        field FGTMAuthKind = "high-bml-interface-class-const";
    }

    class FormGlassTelemetryMembrane {
        field FGTMSchema = "glass-sample-v1";
        field FGTMSnapshotSchema = "glass-snapshot-v1";
        field FGTMControlSchema = "glass-control-v1";
        field FGTMSnapshotSuffix = ".glass-snapshot";
        field FGTMInboxSuffix = ".glass-control-inbox";
        field FGTMAckSuffix = ".glass-control-ack";
        field FGTMMaxSamples = 512;
        field FGTMMaxChannels = 16;
        field FGTMMaxIdBytes = 64;
        field FGTMMaxSelectorBytes = 256;
        field FGTMMaxSnapshotWireBytes = 1048576;
        field FGTMMaxControlWireBytes = 4096;
        field FGTMMaxPublishers = 128;
        field FGTMOwnerCommandRoot = "native-model-owner-control";
        field FGTMOwnerCommandSuffix = ".owner-command";
        field FGTMOwnerCommandSchema = "native-model-owner-command-v2";
        field FGTMOwnerCommandLeaseMs = 2000;
        ref fgtm-authority = FormGlassTelemetryMembraneAuthority;
        thought fgtm-law = ["absent-is-not-zero", "caller-root-only", "token-metadata-only", "atomic-current-snapshot", "bounded-control-enums"];

        // Presence is data.  The placeholder in an absent field is never read.
        def fgtm-absent() = ["glass-field-v1", 0, 0];
        def fgtm-present(value) = ["glass-field-v1", 1, value];
        def fgtm-field-present?(field) = field[1];
        def fgtm-field-value(field) = field[2];
        def fgtm-field-shape?(field) = if (!((Comparable) len(field) == 3)) then 0 else if (!((String) head(field) == "glass-field-v1")) then 0 else if (((Comparable) fgtm-field-present?(field) == 0) || ((Comparable) fgtm-field-present?(field) == 1)) then 1 else 0;

        def fgtm-lower-or-digit?(byte) = if ((byte >= 97) && (byte <= 122)) then 1 else if ((byte >= 48) && (byte <= 57)) then 1 else 0;
        def fgtm-id-byte?(byte) = if ((Comparable) fgtm-lower-or-digit?(byte) == 1) then 1 else if ((Comparable) byte == 45) then 1 else if ((Comparable) byte == 46) then 1 else if ((Comparable) byte == 95) then 1 else 0;
        def fgtm-id-bytes?(text, index, count) = if (index >= count) then 1 else if ((Comparable) fgtm-id-byte?(str_byte_at(text, index)) == 1) then fgtm-id-bytes?(text, (index + 1), count) else 0;
        def fgtm-channel-id?(text) {
            let count = str_len(text);
            if (count < 1) then 0 else if (count > FGTMMaxIdBytes()) then 0 else if (!((Comparable) fgtm-lower-or-digit?(str_byte_at(text, 0)) == 1)) then 0 else if (!((Comparable) fgtm-lower-or-digit?(str_byte_at(text, (count - 1))) == 1)) then 0 else if (str_find(text, "..", 0) >= 0) then 0 else fgtm-id-bytes?(text, 0, count);
        }
        def fgtm-label?(text) = fgtm-channel-id?(text);
        def fgtm-selector?(text) {
            let count = str_len(text);
            if (count < 1) then 0 else if (count > FGTMMaxSelectorBytes()) then 0 else if (!((Comparable) fgtm-lower-or-digit?(str_byte_at(text, 0)) == 1)) then 0 else if (!((Comparable) fgtm-lower-or-digit?(str_byte_at(text, (count - 1))) == 1)) then 0 else fgtm-id-bytes?(text, 0, count);
        }
        def fgtm-root-byte-safe?(root, index, count) = if (index >= count) then 1 else if (((Comparable) str_byte_at(root, index) == 0) || (((Comparable) str_byte_at(root, index) == 10) || ((Comparable) str_byte_at(root, index) == 13))) then 0 else fgtm-root-byte-safe?(root, (index + 1), count);
        def fgtm-root-valid?(root) = if (str_len(root) < 1) then 0 else if (str_len(root) > 512) then 0 else fgtm-root-byte-safe?(root, 0, str_len(root));

        def fgtm-uint-text-bytes?(text, index, count) = if (index >= count) then 1 else if ((str_byte_at(text, index) >= 48) && (str_byte_at(text, index) <= 57)) then fgtm-uint-text-bytes?(text, (index + 1), count) else 0;
        def fgtm-uint-text?(text) = if (str_len(text) < 1) then 0 else if (str_len(text) > 19) then 0 else if (!((Comparable) fgtm-uint-text-bytes?(text, 0, str_len(text)) == 1)) then 0 else if ((str_len(text) > 1) && ((Comparable) str_byte_at(text, 0) == 48)) then 0 else ((String) int_to_str(str_to_int(text)) == text);
        def fgtm-numeric-field-valid?(field) = if (!((Comparable) fgtm-field-shape?(field) == 1)) then 0 else if ((Comparable) fgtm-field-present?(field) == 0) then 1 else if (fgtm-field-value(field) >= 0) then 1 else 0;
        def fgtm-label-field-valid?(field) = if (!((Comparable) fgtm-field-shape?(field) == 1)) then 0 else if ((Comparable) fgtm-field-present?(field) == 0) then 1 else fgtm-label?(fgtm-field-value(field));
        def fgtm-selector-field-valid?(field) = if (!((Comparable) fgtm-field-shape?(field) == 1)) then 0 else if ((Comparable) fgtm-field-present?(field) == 0) then 1 else fgtm-selector?(fgtm-field-value(field));
        def fgtm-language-field-valid?(field) = if (!((Comparable) fgtm-field-shape?(field) == 1)) then 0 else if (!((Comparable) fgtm-field-present?(field) == 1)) then 0 else if (str_len(fgtm-field-value(field)) > FGTMMaxSelectorBytes()) then 0 else tln-valid-selection?(fgtm-field-value(field));
        def fgtm-control-argument-valid?(action, field) = if ((String) action == "languages") then fgtm-language-field-valid?(field) else if (((String) action == "inspect") || ((String) action == "request-evidence")) then fgtm-selector-field-valid?(field) else fgtm-label-field-valid?(field);

        def fgtm-plane?(plane) = if ((String) plane == "form") then 1 else if ((String) plane == "cpu") then 1 else if ((String) plane == "gpu") then 1 else if ((String) plane == "metal") then 1 else if ((String) plane == "mlx") then 1 else if ((String) plane == "unified") then 1 else if ((String) plane == "disk") then 1 else if ((String) plane == "network") then 1 else if ((String) plane == "membrane") then 1 else if ((String) plane == "unknown") then 1 else 0;
        def fgtm-lifecycle?(state) = if ((String) state == "allocated") then 1 else if ((String) state == "mapped") then 1 else if ((String) state == "resident") then 1 else if ((String) state == "prefilling") then 1 else if ((String) state == "ready") then 1 else if ((String) state == "active") then 1 else if ((String) state == "completed") then 1 else if ((String) state == "idle") then 1 else if ((String) state == "cooling") then 1 else if ((String) state == "evictable") then 1 else if ((String) state == "pinned") then 1 else if ((String) state == "released") then 1 else if ((String) state == "failed") then 1 else if ((String) state == "stored") then 1 else if ((String) state == "crystallized") then 1 else if ((String) state == "loading") then 1 else if ((String) state == "unknown") then 1 else 0;
        def fgtm-evictability?(state) = if ((String) state == "never") then 1 else if ((String) state == "pinned") then 1 else if ((String) state == "pressure-only") then 1 else if ((String) state == "policy-ranked") then 1 else if ((String) state == "inactive-only") then 1 else if ((String) state == "eligible") then 1 else if ((String) state == "released") then 1 else if ((String) state == "unknown") then 1 else 0;
        def fgtm-evidence?(kind) = if ((String) kind == "physical-live") then 1 else if ((String) kind == "derived-window") then 1 else if ((String) kind == "catalog") then 1 else if ((String) kind == "declared") then 1 else 0;
        def fgtm-control-action?(action) = if ((String) action == "languages") then 1 else if ((String) action == "continue") then 1 else if ((String) action == "branch") then 1 else if ((String) action == "revise") then 1 else if ((String) action == "abstain") then 1 else if ((String) action == "request-evidence") then 1 else if ((String) action == "rehearse-ground") then 1 else if ((String) action == "alternative-node") then 1 else if ((String) action == "focus") then 1 else if ((String) action == "inspect") then 1 else if ((String) action == "step") then 1 else if ((String) action == "take") then 1 else if ((String) action == "hold") then 1 else 0;
        def fgtm-control-disposition?(state) = if ((String) state == "applied") then 1 else if ((String) state == "refused") then 1 else if ((String) state == "stale") then 1 else if ((String) state == "superseded") then 1 else if ((String) state == "nothing") then 1 else 0;

        def fgtm-channels-valid?(channels) = if (len(channels) > FGTMMaxChannels()) then 0 else if ((Comparable) len(channels) == 0) then 1 else if (!((Comparable) fgtm-channel-id?(head(channels)) == 1)) then 0 else fgtm-channels-valid?(tail(channels));

        // GlassSample order is stable and deliberately contains no payload cell.
        def fgtm-sample(id, parent, kind, memoryPlane, owner, lane, purpose, bytes, capacity, lifecycle, readEpoch, writeEpoch, heat, physicalHandle, evictability, evidence, source, channels) = [FGTMSchema(), id, parent, kind, memoryPlane, owner, lane, purpose, bytes, capacity, lifecycle, readEpoch, writeEpoch, heat, physicalHandle, evictability, evidence, source, channels];
        def fgtm-sample-id(sample) = sample[1];
        def fgtm-sample-parent(sample) = sample[2];
        def fgtm-sample-kind(sample) = sample[3];
        def fgtm-sample-plane(sample) = sample[4];
        def fgtm-sample-owner(sample) = sample[5];
        def fgtm-sample-lane(sample) = sample[6];
        def fgtm-sample-purpose(sample) = sample[7];
        def fgtm-sample-bytes(sample) = sample[8];
        def fgtm-sample-capacity(sample) = sample[9];
        def fgtm-sample-lifecycle(sample) = sample[10];
        def fgtm-sample-read-epoch(sample) = sample[11];
        def fgtm-sample-write-epoch(sample) = sample[12];
        def fgtm-sample-heat(sample) = sample[13];
        def fgtm-sample-handle(sample) = sample[14];
        def fgtm-sample-evictability(sample) = sample[15];
        def fgtm-sample-evidence(sample) = sample[16];
        def fgtm-sample-source(sample) = sample[17];
        def fgtm-sample-channels(sample) = sample[18];
        def fgtm-sample-valid-tail?(sample) = if (!((Comparable) fgtm-numeric-field-valid?(fgtm-sample-bytes(sample)) == 1)) then 0 else if (!((Comparable) fgtm-numeric-field-valid?(fgtm-sample-capacity(sample)) == 1)) then 0 else if (!((Comparable) fgtm-lifecycle?(fgtm-sample-lifecycle(sample)) == 1)) then 0 else if (!((Comparable) fgtm-numeric-field-valid?(fgtm-sample-read-epoch(sample)) == 1)) then 0 else if (!((Comparable) fgtm-numeric-field-valid?(fgtm-sample-write-epoch(sample)) == 1)) then 0 else if (!((Comparable) fgtm-numeric-field-valid?(fgtm-sample-heat(sample)) == 1)) then 0 else if (((Comparable) fgtm-field-present?(fgtm-sample-heat(sample)) == 1) && (fgtm-field-value(fgtm-sample-heat(sample)) > 1000)) then 0 else if (!((Comparable) fgtm-numeric-field-valid?(fgtm-sample-handle(sample)) == 1)) then 0 else if (!((Comparable) fgtm-evictability?(fgtm-sample-evictability(sample)) == 1)) then 0 else if (!((Comparable) fgtm-evidence?(fgtm-sample-evidence(sample)) == 1)) then 0 else if (!((Comparable) fgtm-label?(fgtm-sample-source(sample)) == 1)) then 0 else fgtm-channels-valid?(fgtm-sample-channels(sample));
        def fgtm-sample-valid?(sample) = if ((!((Comparable) len(sample) == 19)) && (!((Comparable) len(sample) == 20))) then 0 else if (!((String) head(sample) == FGTMSchema())) then 0 else if (!((Comparable) fgtm-label?(fgtm-sample-id(sample)) == 1)) then 0 else if (!((Comparable) fgtm-label-field-valid?(fgtm-sample-parent(sample)) == 1)) then 0 else if (!((Comparable) fgtm-label?(fgtm-sample-kind(sample)) == 1)) then 0 else if (!((Comparable) fgtm-plane?(fgtm-sample-plane(sample)) == 1)) then 0 else if (!((Comparable) fgtm-label?(fgtm-sample-owner(sample)) == 1)) then 0 else if (!((Comparable) fgtm-label?(fgtm-sample-lane(sample)) == 1)) then 0 else if (!((Comparable) fgtm-label?(fgtm-sample-purpose(sample)) == 1)) then 0 else fgtm-sample-valid-tail?(sample);
        def fgtm-samples-valid?(samples) = if (len(samples) > FGTMMaxSamples()) then 0 else if ((Comparable) len(samples) == 0) then 1 else if (!((Comparable) fgtm-sample-valid?(head(samples)) == 1)) then 0 else fgtm-samples-valid?(tail(samples));

        // ---- a sample may carry a CELL --------------------------------------
        // The snapshot crosses as a cell (R111), so anything a cell can hold can
        // cross: a ledger, a list of options, a sentence. The nineteen fields
        // stay exactly as they are and stay label-shaped -- they are the shared
        // vocabulary every view renders and every reader indexes by. This is the
        // twentieth: the publisher's own structure, in the publisher's own shape,
        // for readers that know it and invisible to those that do not.
        //
        // It exists because the alternative kept coming back. A channel is a
        // LABEL because a text wire once used "," and "|" to separate them; that
        // wire stopped crossing at R111 and was removed 2026-09-08, and its rule
        // outlived it -- which is why a choice point's ledger went out as
        // "led.5.3.1.1.1500" and came back through a split. Encoding into a
        // label and parsing it back is what a carrier that takes cells never
        // needed.
        def fgtm-sample-carries-cell?(sample) = if (len(sample) < 20) then 0 else 1;
        def fgtm-sample-cell(sample) = if ((Comparable) fgtm-sample-carries-cell?(sample) == 0) then [] else sample[19];
        def fgtm-with-cell(sample, cell) = append(fgtm-without-cell(sample), [cell]);
        def fgtm-without-cell(sample) = if ((Comparable) fgtm-sample-carries-cell?(sample) == 0) then sample else fgtm-sample(fgtm-sample-id(sample), fgtm-sample-parent(sample), fgtm-sample-kind(sample), fgtm-sample-plane(sample), fgtm-sample-owner(sample), fgtm-sample-lane(sample), fgtm-sample-purpose(sample), fgtm-sample-bytes(sample), fgtm-sample-capacity(sample), fgtm-sample-lifecycle(sample), fgtm-sample-read-epoch(sample), fgtm-sample-write-epoch(sample), fgtm-sample-heat(sample), fgtm-sample-handle(sample), fgtm-sample-evictability(sample), fgtm-sample-evidence(sample), fgtm-sample-source(sample), fgtm-sample-channels(sample));
        // a rebuilt sample keeps whatever cell the original carried
        def fgtm-carry-cell(from, rebuilt) = if ((Comparable) fgtm-sample-carries-cell?(from) == 0) then rebuilt else fgtm-with-cell(rebuilt, fgtm-sample-cell(from));

        def fgtm-field-wire(field) = if ((Comparable) fgtm-field-present?(field) == 0) then "a" else str_concat("p:", int_to_str(fgtm-field-value(field)));
        def fgtm-label-field-wire(field) = if ((Comparable) fgtm-field-present?(field) == 0) then "a" else str_concat("p:", fgtm-field-value(field));
        def fgtm-cat(parts) = if ((Comparable) len(parts) == 0) then "" else str_concat(head(parts), fgtm-cat(tail(parts)));
        def fgtm-sample-selection-id(sample) = fgtm-cat(["sample.", int_to_str(str_len(fgtm-sample-source(sample))), ".", fgtm-sample-source(sample), ".", int_to_str(str_len(fgtm-sample-lane(sample))), ".", fgtm-sample-lane(sample), ".", int_to_str(str_len(fgtm-sample-id(sample))), ".", fgtm-sample-id(sample)]);

        def fgtm-snapshot(publisher, epoch, samples) = [FGTMSnapshotSchema(), publisher, epoch, samples];
        def fgtm-snapshot-publisher(snapshot) = snapshot[1];
        def fgtm-snapshot-epoch(snapshot) = snapshot[2];
        def fgtm-snapshot-samples(snapshot) = snapshot[3];
        def fgtm-snapshot-valid?(snapshot) = if (!((Comparable) len(snapshot) == 4)) then 0 else if (!((String) head(snapshot) == FGTMSnapshotSchema())) then 0 else if (!((Comparable) fgtm-channel-id?(fgtm-snapshot-publisher(snapshot)) == 1)) then 0 else if (fgtm-snapshot-epoch(snapshot) < 0) then 0 else fgtm-samples-valid?(fgtm-snapshot-samples(snapshot));

        def fgtm-invalid-field() = ["glass-field-v1", -1, 0];
        def fgtm-parse-number-field(text) = if ((String) text == "a") then fgtm-absent() else if ((str_len(text) >= 3) && ((String) substring(text, 0, 2) == "p:")) then if ((Comparable) fgtm-uint-text?(substring(text, 2, str_len(text))) == 1) then fgtm-present(str_to_int(substring(text, 2, str_len(text)))) else fgtm-invalid-field() else fgtm-invalid-field();
        def fgtm-parse-label-field(text) = if ((String) text == "a") then fgtm-absent() else if ((str_len(text) >= 3) && ((String) substring(text, 0, 2) == "p:")) then if ((Comparable) fgtm-label?(substring(text, 2, str_len(text))) == 1) then fgtm-present(substring(text, 2, str_len(text))) else fgtm-invalid-field() else fgtm-invalid-field();
        def fgtm-parse-selector-field(text) = if ((String) text == "a") then fgtm-absent() else if ((str_len(text) >= 3) && ((String) substring(text, 0, 2) == "p:")) then if ((Comparable) fgtm-selector?(substring(text, 2, str_len(text))) == 1) then fgtm-present(substring(text, 2, str_len(text))) else fgtm-invalid-field() else fgtm-invalid-field();
        def fgtm-parse-language-field(text) = if (!((str_len(text) >= 3) && ((String) substring(text, 0, 2) == "p:"))) then fgtm-invalid-field() else if ((Comparable) fgtm-language-field-valid?(fgtm-present(substring(text, 2, str_len(text)))) == 1) then fgtm-present(substring(text, 2, str_len(text))) else fgtm-invalid-field();
        def fgtm-parse-control-argument(action, text) = if ((String) action == "languages") then fgtm-parse-language-field(text) else if (((String) action == "inspect") || ((String) action == "request-evidence")) then fgtm-parse-selector-field(text) else fgtm-parse-label-field(text);

        def fgtm-publish-refused(reason) = ["glass-publish-v1", "refused", reason, fgtm-absent()];
        // ---- the shared-memory lane: a snapshot is a cell given into the publisher's frame; the roster page names every publisher; no file, no wire, no parser ----
        // the root names the space: a frame and its roster entry are keyed root|publisher, so a band's /tmp/test never meets the live telemetry
        def fgtm-space(root, publisher) = str_concat(root, str_concat("|", publisher));
        def fgtm-space-prefix?(name, root) = if (str_len(name) < (str_len(root) + 2)) then 0 else if (!((String) substring(name, 0, (str_len(root) + 1)) == str_concat(root, "|"))) then 0 else 1;
        def fgtm-space-publisher(name, root) = substring(name, (str_len(root) + 1), str_len(name));
        // A roster row is (name lastSpokeMs): the roster keeps the moment each
        // name last registered, which a live publisher does on every publish,
        // and it hands that back with the name. This is the ONLY time a
        // non-snapshot frame has -- a control inbox carries no epoch of its own
        // -- and it costs no frame open, so a reader can tell a giver from a
        // frame merely standing across the whole roster in one call.
        def fgtm-roster-row-name(r) = head(r);
        def fgtm-roster-row-spoke(r) = r[1];
        def fgtm-roster-row-age(r, now) = if (fgtm-roster-row-spoke(r) > now) then 0 else (now - fgtm-roster-row-spoke(r));
        def fgtm-roster-names(rows) = if ((Comparable) len(rows) == 0) then [] else cons(fgtm-roster-row-name(head(rows)), fgtm-roster-names(tail(rows)));
        def fgtm-frames-in-space(rows, root) = if ((Comparable) len(rows) == 0) then [] else if ((Comparable) fgtm-space-prefix?(fgtm-roster-row-name(head(rows)), root) == 1) then cons(fgtm-space-publisher(fgtm-roster-row-name(head(rows)), root), fgtm-frames-in-space(tail(rows), root)) else fgtm-frames-in-space(tail(rows), root);
        // the same walk, keeping the stamp: (publisher lastSpokeMs)
        def fgtm-spoken-in-space(rows, root) = if ((Comparable) len(rows) == 0) then [] else if ((Comparable) fgtm-space-prefix?(fgtm-roster-row-name(head(rows)), root) == 1) then cons([fgtm-space-publisher(fgtm-roster-row-name(head(rows)), root), fgtm-roster-row-spoke(head(rows))], fgtm-spoken-in-space(tail(rows), root)) else fgtm-spoken-in-space(tail(rows), root);
        def fgtm-spoke-of(spoken, publisher) = if ((Comparable) len(spoken) == 0) then -1 else if ((String) head(head(spoken)) == publisher) then head(spoken)[1] else fgtm-spoke-of(tail(spoken), publisher);
        // A control inbox and its ack stand in this space too, and they are NOT
        // publishers: they carry the control grammar on purpose, so reading one
        // with the snapshot parser answers "malformed" for a channel that is
        // working exactly as built. The membrane already names them by suffix.
        def fgtm-suffix?(name, suffix) = if (str_len(name) < str_len(suffix)) then 0 else if ((String) substring(name, (str_len(name) - str_len(suffix)), str_len(name)) == suffix) then 1 else 0;
        def fgtm-control-frame-name?(name) = if ((Comparable) fgtm-suffix?(name, FGTMInboxSuffix()) == 1) then 1 else fgtm-suffix?(name, FGTMAckSuffix());
        def fgtm-publishers-only(names) = if ((Comparable) len(names) == 0) then [] else if ((Comparable) fgtm-control-frame-name?(head(names)) == 1) then fgtm-publishers-only(tail(names)) else cons(head(names), fgtm-publishers-only(tail(names)));
        def fgtm-roster-in-space(names, root) = fgtm-publishers-only(fgtm-frames-in-space(names, root));
        def fgtm-gift-take(root, publisher) {
            let handle = ggf-receive(fgtm-space(root, publisher));
            let frame = if nothing?(handle) then nothing() else node_gift_read(handle);
            let released = ggf-release(handle);
            if nothing?(handle) then ["absent"] else if nothing?(frame) then ["unreadable"] else ["read", frame];
        }
        def fgtm-gift-give(root, publisher, bytes, cell) {
            let slot = gift_roster_register(fgtm-space(root, publisher));
            let handle = ggf-offer(fgtm-space(root, publisher), bytes);
            let seq = if nothing?(handle) then nothing() else node_gift_write(handle, cell);
            let released = ggf-release(handle);
            if nothing?(seq) then -1 else seq;
        }
        def fgtm-publish-valid-snapshot(root, publisher, snapshot) {
            let seq = fgtm-gift-give(root, publisher, FGTMMaxSnapshotWireBytes(), snapshot);
            if (seq < 0) then ["glass-publish-v1", "failed", publisher, fgtm-present(ggf-name(fgtm-space(root, publisher))), -1, -1, snapshot] else ["glass-publish-v1", "published", publisher, fgtm-present(ggf-name(fgtm-space(root, publisher))), seq, 0, snapshot];
        }
        def fgtm-publish-snapshot(root, publisher, epoch, samples) {
            let snapshot = fgtm-snapshot(publisher, epoch, samples);
            if (!((Comparable) fgtm-root-valid?(root) == 1)) then fgtm-publish-refused("root") else if (!((Comparable) fgtm-snapshot-valid?(snapshot) == 1)) then fgtm-publish-refused("snapshot") else fgtm-publish-valid-snapshot(root, publisher, snapshot);
        }

        def fgtm-read-state(channel, state, value) = ["glass-read-v1", channel, state, value];
        def fgtm-read-current-parsed(publisher, parsed) = if (((Comparable) len(parsed) == 4) && ((String) head(parsed) == FGTMSnapshotSchema())) then if ((String) fgtm-snapshot-publisher(parsed) == publisher) then fgtm-read-state(publisher, "current", fgtm-present(parsed)) else fgtm-read-state(publisher, "malformed", fgtm-present("publisher-mismatch")) else fgtm-read-state(publisher, "malformed", fgtm-present(parsed[1]));
        def fgtm-read-current(root, publisher) {
            let taken = if (((Comparable) fgtm-root-valid?(root) == 1) && ((Comparable) fgtm-channel-id?(publisher) == 1)) then fgtm-gift-take(root, publisher) else ["refused"];
            fgtm-read-current-taken(root, publisher, taken);
        }
        def fgtm-read-current-taken(root, publisher, taken) = if (!((Comparable) fgtm-root-valid?(root) == 1)) then fgtm-read-state(publisher, "refused", fgtm-present("root")) else if (!((Comparable) fgtm-channel-id?(publisher) == 1)) then fgtm-read-state(publisher, "refused", fgtm-present("publisher")) else if ((String) head(taken) == "absent") then fgtm-read-state(publisher, "absent", fgtm-absent()) else if ((String) head(taken) == "unreadable") then fgtm-read-state(publisher, "malformed", fgtm-present("frame-unreadable")) else fgtm-read-current-parsed(publisher, taken[1]);
        // ---- how long ago the reading was MADE ------------------------------
        // "current" says a frame parsed and named its own publisher. It does not
        // say the giver is still giving: shared memory outlives the process, so
        // a publisher that stopped two hours ago still reads current, with all
        // its rows, forever. Witnessed 2026-09-07 on this host -- four
        // publishers current, two of them silent for 100 and 118 minutes, and
        // every reader taking their rows as now.
        //
        // Age is the fact and it lives here beside the read; the BOUND is the
        // reader's, because only the reader knows the cadence it expects. A
        // reading with no snapshot answers -1: no reading is not an age of zero.
        // (The sensor lane already refines this per declared cadence,
        // fgsr-silent? over FGSRSilentFactor; the awareness lane holds a
        // horizon for publishers that declare none.)
        def fgtm-read-snapshot(reading) = if (!((String) fgtm-read-state-status(reading) == "current")) then [] else fgtm-field-value(fgtm-read-state-value(reading));
        def fgtm-snapshot-age(snapshot, now) {
            if ((Comparable) len(snapshot) == 0) then -1 else if (fgtm-snapshot-epoch(snapshot) > now) then 0 else (now - fgtm-snapshot-epoch(snapshot));
        }
        def fgtm-read-age(reading, now) = fgtm-snapshot-age(fgtm-read-snapshot(reading), now);
        // 1 given inside the bound, 0 standing but silent, -1 no reading at all
        def fgtm-read-given-within?(reading, now, withinMs) {
            let age = fgtm-read-age(reading, now);
            if (age < 0) then -1 else if (age > withinMs) then 0 else 1;
        }
        // The rows, but only from a frame that was actually GIVEN inside the
        // bound. A reader that will label what it finds "physical-live", or
        // count it into a ledger, asks through here; a viewer that means to
        // show the last thing known and mark it stale takes the raw samples and
        // marks them itself.
        def fgtm-read-samples-within(reading, now, withinMs) = if (!((Comparable) fgtm-read-given-within?(reading, now, withinMs) == 1)) then [] else fgtm-snapshot-samples(fgtm-read-snapshot(reading));

        // ---- the kept lane: the same take over a handle the reader keeps open for its life (ggf-kept-*): no name, no open, no release per read ----
        def fgtm-gift-take-held(handle) {
            let frame = if nothing?(handle) then nothing() else node_gift_read(handle);
            if nothing?(handle) then ["absent"] else if nothing?(frame) then ["unreadable"] else ["read", frame];
        }
        def fgtm-read-current-held(root, publisher, handle) = fgtm-read-current-taken(root, publisher, if (((Comparable) fgtm-root-valid?(root) == 1) && ((Comparable) fgtm-channel-id?(publisher) == 1)) then fgtm-gift-take-held(handle) else ["refused"]);
        def fgtm-control-inbox-space(root, channel) = fgtm-space(root, fgtm-control-frame(channel, FGTMInboxSuffix()));
        def fgtm-read-state-status(reading) = reading[2];
        // which carrier answered: "gift" when the shared-memory frame stood and read current, "absent" otherwise -- there is no other carrier
        def fgtm-read-current-carrier(root, publisher) = if ((String) fgtm-read-state-status(fgtm-read-current(root, publisher)) == "current") then "gift" else "absent";
        // which carrier answered: "gift" when the shared-memory frame stood and read current, "absent" otherwise -- there is no other carrier
        def fgtm-read-state-value(reading) = reading[3];

        def fgtm-roster-publishers(names, remaining) = if (((Comparable) len(names) == 0) || (remaining <= 0)) then [] else if ((Comparable) fgtm-channel-id?(head(names)) == 1) then cons(head(names), fgtm-roster-publishers(tail(names), (remaining - 1))) else fgtm-roster-publishers(tail(names), remaining);
        def fgtm-inventory-publishers(root, names) = fgtm-roster-publishers(names, FGTMMaxPublishers());
        def fgtm-read-publishers(root, publishers) = if ((Comparable) len(publishers) == 0) then [] else cons(fgtm-read-current(root, head(publishers)), fgtm-read-publishers(root, tail(publishers)));
        def fgtm-inventory-current(root) {
            let publishers = fgtm-inventory-publishers(root, fgtm-roster-in-space(gift_roster_names(), root));
            ["glass-inventory-v1", root, "current", publishers, fgtm-read-publishers(root, publishers)];
        }
        // ---- the cached inventory: parse a publisher only when its frame moved ----
        // A publisher's key is its gift sequence when the frame stands (offset so
        // the frame sequence is the key; -1 when no frame stands
        // cache = list of (publisher key reading); an unmoved key answers the held
        // reading with no read and no parse, so a steady field costs the glass
        // one stat or one shm_seq per publisher per frame.
        def fgtm-read-key(root, publisher) {
            let handle = ggf-receive(fgtm-space(root, publisher));
            let seq = ggf-seq(handle);
            let released = ggf-release(handle);
            if nothing?(handle) then -1 else seq;
        }
        def fgtm-cache-find(cache, publisher) = if ((Comparable) len(cache) == 0) then [] else if ((String) head(cache)[0] == publisher) then head(cache) else fgtm-cache-find(tail(cache), publisher);
        def fgtm-cache-entry(publisher, key, reading) = [publisher, key, reading];
        def fgtm-read-cached-one(root, publisher, cache) {
            let key = fgtm-read-key(root, publisher);
            let held = fgtm-cache-find(cache, publisher);
            if ((len(held) > 0) && ((Comparable) held[1] == key)) then held else fgtm-cache-entry(publisher, key, fgtm-read-current(root, publisher));
        }
        def fgtm-read-publishers-cached(root, publishers, cache, readings, nextCache) {
            if ((Comparable) len(publishers) == 0) then [reverse(readings), reverse(nextCache)] else fgtm-read-publishers-cached-next(root, publishers, cache, readings, nextCache, fgtm-read-cached-one(root, head(publishers), cache));
        }
        def fgtm-read-publishers-cached-next(root, publishers, cache, readings, nextCache, entry) = fgtm-read-publishers-cached(root, tail(publishers), cache, cons(entry[2], readings), cons(entry, nextCache));
        // how many entries of the new cache are not the very entries of the old one (re-read this frame)
        def fgtm-cache-moved(newCache, oldCache, n) = if ((Comparable) len(newCache) == 0) then n else fgtm-cache-moved(tail(newCache), oldCache, if ((Comparable) fgtm-cache-same?(head(newCache), fgtm-cache-find(oldCache, head(newCache)[0])) == 1) then n else (n + 1));
        def fgtm-cache-same?(entry, held) = if ((Comparable) len(held) == 0) then 0 else if ((Comparable) entry[1] == held[1]) then 1 else 0;
        def fgtm-inventory-moved(pair, oldCache) = fgtm-cache-moved(pair[1], oldCache, 0);
        // the same, over a roster the caller already holds (no directory listing)
        def fgtm-inventory-cached-with(root, publishers, cache) {
            let pair = fgtm-read-publishers-cached(root, publishers, cache, [], []);
            if (!((Comparable) fgtm-root-valid?(root) == 1)) then [["glass-inventory-v1", root, "refused", [], []], cache] else [["glass-inventory-v1", root, "current", publishers, pair[0]], pair[1]];
        }
        def fgtm-inventory-roster(root) = if (!((Comparable) fgtm-root-valid?(root) == 1)) then [] else fgtm-inventory-publishers(root, fgtm-roster-in-space(gift_roster_names(), root));
        def fgtm-inventory-cached(root, cache) = fgtm-inventory-cached-with(root, fgtm-inventory-roster(root), cache);
        // the same cached inventory over kept handles: the key is the kept handle's seq (-1 when no frame stands), the read the kept take
        def fgtm-read-cached-one-held(root, publisher, cache, handle) {
            let key = ggf-seq(handle);
            let held = fgtm-cache-find(cache, publisher);
            if ((len(held) > 0) && ((Comparable) held[1] == key)) then held else fgtm-cache-entry(publisher, key, fgtm-read-current-held(root, publisher, handle));
        }
        def fgtm-read-publishers-cached-held(root, publishers, cache, readings, nextCache, kept) {
            if ((Comparable) len(publishers) == 0) then [reverse(readings), reverse(nextCache)] else fgtm-read-publishers-cached-held-next(root, publishers, cache, readings, nextCache, kept, fgtm-read-cached-one-held(root, head(publishers), cache, ggf-kept-handle(kept, fgtm-space(root, head(publishers)), "take")));
        }
        def fgtm-read-publishers-cached-held-next(root, publishers, cache, readings, nextCache, kept, entry) = fgtm-read-publishers-cached-held(root, tail(publishers), cache, cons(entry[2], readings), cons(entry, nextCache), kept);
        def fgtm-inventory-cached-held(root, publishers, cache, kept) {
            let pair = fgtm-read-publishers-cached-held(root, publishers, cache, [], [], kept);
            if (!((Comparable) fgtm-root-valid?(root) == 1)) then [["glass-inventory-v1", root, "refused", [], []], cache] else [["glass-inventory-v1", root, "current", publishers, pair[0]], pair[1]];
        }
        // the frames a roster names, as kept wants: list(space, "take", 0) per publisher
        def fgtm-roster-wants(root, publishers) = if ((Comparable) len(publishers) == 0) then [] else cons([fgtm-space(root, head(publishers)), "take", 0], fgtm-roster-wants(root, tail(publishers)));
        def fgtm-inventory(root) = if (!((Comparable) fgtm-root-valid?(root) == 1)) then ["glass-inventory-v1", root, "refused", [], []] else fgtm-inventory-current(root);
        // answers list(inventory, cache)

        // Control offers contain an enum action and an optional bounded label.
        def fgtm-control-offer(channel, offerId, epoch, action, argument, evidence, source) = ["glass-control-offer-v1", channel, offerId, epoch, action, argument, evidence, source];
        def fgtm-offer-channel(offer) = offer[1];
        def fgtm-offer-id(offer) = offer[2];
        def fgtm-offer-epoch(offer) = offer[3];
        def fgtm-offer-action(offer) = offer[4];
        def fgtm-offer-argument(offer) = offer[5];
        def fgtm-offer-evidence(offer) = offer[6];
        def fgtm-offer-source(offer) = offer[7];
        def fgtm-offer-valid?(offer) = if (!((Comparable) len(offer) == 8)) then 0 else if (!((String) head(offer) == "glass-control-offer-v1")) then 0 else if (!((Comparable) fgtm-channel-id?(fgtm-offer-channel(offer)) == 1)) then 0 else if (!((Comparable) fgtm-label?(fgtm-offer-id(offer)) == 1)) then 0 else if (fgtm-offer-epoch(offer) < 0) then 0 else if (!((Comparable) fgtm-control-action?(fgtm-offer-action(offer)) == 1)) then 0 else if (!((Comparable) fgtm-control-argument-valid?(fgtm-offer-action(offer), fgtm-offer-argument(offer)) == 1)) then 0 else if (!((Comparable) fgtm-evidence?(fgtm-offer-evidence(offer)) == 1)) then 0 else fgtm-label?(fgtm-offer-source(offer));
        def fgtm-offer-wire(offer) = fgtm-cat(["glass-control-offer-v1|", fgtm-offer-channel(offer), "|", fgtm-offer-id(offer), "|", int_to_str(fgtm-offer-epoch(offer)), "|", fgtm-offer-action(offer), "|", fgtm-label-field-wire(fgtm-offer-argument(offer)), "|", fgtm-offer-evidence(offer), "|", fgtm-offer-source(offer)]);
        def fgtm-parse-offer-fields(fields) {
            let offer = fgtm-control-offer(fields[1], fields[2], str_to_int(fields[3]), fields[4], fgtm-parse-control-argument(fields[4], fields[5]), fields[6], fields[7]);
            if (((String) head(fields) == "glass-control-offer-v1") && ((Comparable) fgtm-offer-valid?(offer) == 1)) then offer else ["glass-control-offer-invalid-v1"];
        }
        def fgtm-parse-offer-wire(text) {
            let fields = split-on(text, "|");
            if (!((Comparable) len(fields) == 8)) then ["glass-control-offer-invalid-v1"] else if (!((Comparable) fgtm-uint-text?(fields[3]) == 1)) then ["glass-control-offer-invalid-v1"] else fgtm-parse-offer-fields(fields);
        }
        // ---- control offers and acks: cells in two small frames per channel, <channel>.inbox and <channel>.ack ----
        def fgtm-control-frame(channel, suffix) = str_concat(channel, suffix);
        def fgtm-offer-control-valid(root, offer) {
            let seq = fgtm-gift-give(root, fgtm-control-frame(fgtm-offer-channel(offer), FGTMInboxSuffix()), FGTMMaxControlWireBytes(), offer);
            if (seq >= 0) then ["glass-control-write-v1", "offered", ggf-name(fgtm-space(root, fgtm-control-frame(fgtm-offer-channel(offer), FGTMInboxSuffix()))), seq, 0, offer] else ["glass-control-write-v1", "failed", fgtm-offer-channel(offer), -1, -1, offer];
        }
        def fgtm-offer-control(root, offer) = if (!((Comparable) fgtm-root-valid?(root) == 1)) then ["glass-control-write-v1", "refused", "root"] else if (!((Comparable) fgtm-offer-valid?(offer) == 1)) then ["glass-control-write-v1", "refused", "offer"] else fgtm-offer-control-valid(root, offer);
        def fgtm-poll-parsed(channel, offer) = if (((Comparable) len(offer) == 8) && ((String) head(offer) == "glass-control-offer-v1")) then if ((String) fgtm-offer-channel(offer) == channel) then ["glass-control-poll-v1", channel, "offer", fgtm-present(offer)] else ["glass-control-poll-v1", channel, "malformed", fgtm-present("channel-mismatch")] else ["glass-control-poll-v1", channel, "malformed", fgtm-present("offer-shape")];
        def fgtm-poll-taken(channel, taken) = if ((String) head(taken) == "absent") then ["glass-control-poll-v1", channel, "absent", fgtm-absent()] else if ((String) head(taken) == "unreadable") then ["glass-control-poll-v1", channel, "malformed", fgtm-present("frame-unreadable")] else fgtm-poll-parsed(channel, taken[1]);
        def fgtm-poll-control(root, channel) = if (!((Comparable) fgtm-root-valid?(root) == 1)) then ["glass-control-poll-v1", channel, "refused", fgtm-present("root")] else if (!((Comparable) fgtm-channel-id?(channel) == 1)) then ["glass-control-poll-v1", channel, "refused", fgtm-present("channel")] else fgtm-poll-taken(channel, fgtm-gift-take(root, fgtm-control-frame(channel, FGTMInboxSuffix())));
        // the same poll over the inbox handle the reader keeps open (ggf-kept-*)
        def fgtm-poll-control-held(root, channel, handle) = if (!((Comparable) fgtm-root-valid?(root) == 1)) then ["glass-control-poll-v1", channel, "refused", fgtm-present("root")] else if (!((Comparable) fgtm-channel-id?(channel) == 1)) then ["glass-control-poll-v1", channel, "refused", fgtm-present("channel")] else fgtm-poll-taken(channel, fgtm-gift-take-held(handle));

        def fgtm-control-ack(channel, offerId, epoch, disposition, evidence, source) = ["glass-control-ack-v1", channel, offerId, epoch, disposition, evidence, source];
        def fgtm-ack-channel(ack) = ack[1];
        def fgtm-ack-offer-id(ack) = ack[2];
        def fgtm-ack-epoch(ack) = ack[3];
        def fgtm-ack-disposition(ack) = ack[4];
        def fgtm-ack-evidence(ack) = ack[5];
        def fgtm-ack-source(ack) = ack[6];
        def fgtm-ack-valid?(ack) = if (!((Comparable) len(ack) == 7)) then 0 else if (!((String) head(ack) == "glass-control-ack-v1")) then 0 else if (!((Comparable) fgtm-channel-id?(fgtm-ack-channel(ack)) == 1)) then 0 else if (!((Comparable) fgtm-label?(fgtm-ack-offer-id(ack)) == 1)) then 0 else if (fgtm-ack-epoch(ack) < 0) then 0 else if (!((Comparable) fgtm-control-disposition?(fgtm-ack-disposition(ack)) == 1)) then 0 else if (!((Comparable) fgtm-evidence?(fgtm-ack-evidence(ack)) == 1)) then 0 else fgtm-label?(fgtm-ack-source(ack));
        def fgtm-ack-wire(ack) = fgtm-cat(["glass-control-ack-v1|", fgtm-ack-channel(ack), "|", fgtm-ack-offer-id(ack), "|", int_to_str(fgtm-ack-epoch(ack)), "|", fgtm-ack-disposition(ack), "|", fgtm-ack-evidence(ack), "|", fgtm-ack-source(ack)]);
        def fgtm-parse-ack-fields(fields) {
            let ack = fgtm-control-ack(fields[1], fields[2], str_to_int(fields[3]), fields[4], fields[5], fields[6]);
            if (((String) head(fields) == "glass-control-ack-v1") && ((Comparable) fgtm-ack-valid?(ack) == 1)) then ack else ["glass-control-ack-invalid-v1"];
        }
        def fgtm-parse-ack-wire(text) {
            let fields = split-on(text, "|");
            if (!((Comparable) len(fields) == 7)) then ["glass-control-ack-invalid-v1"] else if (!((Comparable) fgtm-uint-text?(fields[3]) == 1)) then ["glass-control-ack-invalid-v1"] else fgtm-parse-ack-fields(fields);
        }
        def fgtm-acknowledge-valid(root, ack) {
            let seq = fgtm-gift-give(root, fgtm-control-frame(fgtm-ack-channel(ack), FGTMAckSuffix()), FGTMMaxControlWireBytes(), ack);
            if (seq >= 0) then ["glass-control-write-v1", "acknowledged", ggf-name(fgtm-space(root, fgtm-control-frame(fgtm-ack-channel(ack), FGTMAckSuffix()))), seq, 0, ack] else ["glass-control-write-v1", "failed", fgtm-ack-channel(ack), -1, -1, ack];
        }
        def fgtm-acknowledge-control(root, ack) = if (!((Comparable) fgtm-root-valid?(root) == 1)) then ["glass-control-write-v1", "refused", "root"] else if (!((Comparable) fgtm-ack-valid?(ack) == 1)) then ["glass-control-write-v1", "refused", "ack"] else fgtm-acknowledge-valid(root, ack);
        def fgtm-read-ack-parsed(channel, ack) = if (((Comparable) len(ack) == 7) && ((String) head(ack) == "glass-control-ack-v1")) then if ((String) fgtm-ack-channel(ack) == channel) then ["glass-control-ack-read-v1", channel, "ack", fgtm-present(ack)] else ["glass-control-ack-read-v1", channel, "malformed", fgtm-present("channel-mismatch")] else ["glass-control-ack-read-v1", channel, "malformed", fgtm-present("ack-shape")];
        def fgtm-read-ack-taken(channel, taken) = if ((String) head(taken) == "absent") then ["glass-control-ack-read-v1", channel, "absent", fgtm-absent()] else if ((String) head(taken) == "unreadable") then ["glass-control-ack-read-v1", channel, "malformed", fgtm-present("frame-unreadable")] else fgtm-read-ack-parsed(channel, taken[1]);
        def fgtm-read-control-ack(root, channel) = if (!((Comparable) fgtm-root-valid?(root) == 1)) then ["glass-control-ack-read-v1", channel, "refused", fgtm-present("root")] else if (!((Comparable) fgtm-channel-id?(channel) == 1)) then ["glass-control-ack-read-v1", channel, "refused", fgtm-present("channel")] else fgtm-read-ack-taken(channel, fgtm-gift-take(root, fgtm-control-frame(channel, FGTMAckSuffix())));

        // ---- the model owner's command lease: one cell in one frame per owner publisher, <publisher>.owner-command ----
        // A pending command is the lease: while one stands and is younger than the lease, a second offer is refused;
        // the owner consumes it by giving the empty cell back into the frame. No lock directory, no lease file.
        def fgtm-command-frame(publisher) = str_concat(publisher, FGTMOwnerCommandSuffix());
        def fgtm-command-cell(publisher, command, epochMs) = [FGTMOwnerCommandSchema(), publisher, command, epochMs];
        def fgtm-command-cell?(cell) = if nothing?(cell) then 0 else if (!((Comparable) len(cell) == 4)) then 0 else if (!((String) head(cell) == FGTMOwnerCommandSchema())) then 0 else 1;
        def fgtm-command-cell-command(cell) = cell[2];
        def fgtm-command-cell-epoch(cell) = cell[3];
        def fgtm-command-pending(publisher) {
            let taken = fgtm-gift-take(FGTMOwnerCommandRoot(), fgtm-command-frame(publisher));
            if (!((String) head(taken) == "read")) then [] else if ((Comparable) fgtm-command-cell?(taken[1]) == 1) then taken[1] else [];
        }
        def fgtm-command-lease-live?(pending, epochMs) = if ((Comparable) len(pending) == 0) then 0 else if ((epochMs - fgtm-command-cell-epoch(pending)) < FGTMOwnerCommandLeaseMs()) then 1 else 0;
        def fgtm-command-offer-at(publisher, command, epochMs) {
            let pending = fgtm-command-pending(publisher);
            let seq = if ((Comparable) fgtm-command-lease-live?(pending, epochMs) == 1) then -2 else fgtm-gift-give(FGTMOwnerCommandRoot(), fgtm-command-frame(publisher), FGTMMaxControlWireBytes(), fgtm-command-cell(publisher, command, epochMs));
            if ((Comparable) seq == -2) then ["owner-command-offer-v2", "leased", fgtm-command-cell-command(pending)] else if (seq >= 0) then ["owner-command-offer-v2", "offered", command] else ["owner-command-offer-v2", "failed", command];
        }
        def fgtm-command-offer(publisher, command) = fgtm-command-offer-at(publisher, command, now_unix_ms());
        def fgtm-command-consume(publisher) {
            let pending = fgtm-command-pending(publisher);
            let cleared = if ((Comparable) len(pending) == 0) then -1 else fgtm-gift-give(FGTMOwnerCommandRoot(), fgtm-command-frame(publisher), FGTMMaxControlWireBytes(), []);
            if ((Comparable) len(pending) == 0) then ["owner-command-consume-v2", "waiting", ""] else if (cleared < 0) then ["owner-command-consume-v2", "failed", fgtm-command-cell-command(pending)] else ["owner-command-consume-v2", "ready", fgtm-command-cell-command(pending)];
        }
        def fgtm-command-status(result) = result[1];
        def fgtm-command-value(result) = result[2];
    }
    0;
}
