; the arity of one call head, or nothing when fkwu does not answer it itself
(defn fkwu-op-arity-in (rows name)
    (if (nil? rows) (nothing)
        (if (str_eq (head (head rows)) name) (nth (head rows) 1)
            (fkwu-op-arity-in (tail rows) name))))
(defn fkwu-op-arity (name) (fkwu-op-arity-in (fkwu-op-arities) name))
