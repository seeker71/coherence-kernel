; form-cli-local-docs-run.fk — anyone door: folder + question -> Form pack.
;
; Write the folder path to /tmp/form-local-docs-root
; and the question to /tmp/form-local-docs-query, then:
;   ./fkwu form/form-stdlib/form-cli-local-docs-run.fk
; Paste the pack into a free ChatGPT chat. ChatGPT cannot see the disk.
;
; If those files are empty, the fixture folder answers instead.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-local-docs.fk

(do
    (defn fld-strip-nl (s)
        (let n (str_len s)
            (if (eq n 0) s
                (if (eq (str_byte_at s (sub n 1)) 10)
                    (substring s 0 (sub n 1)) s))))
    (defn fld-from-file (path)
        (let body (read_file path)
            (fld-doc path
                (fld-tokenize (str_concat path (str_concat " " body)))
                (fld-cap body 160))))
    (defn fld-join (root name)
        (str_concat root (str_concat "/" name)))
    (defn fld-take-files (root names n acc)
        (if (if (eq n 0) 1 (eq (len names) 0)) acc
            (let name (head names)
                (if (if (eq (fld-ext-ok? name) 1) (eq (fld-dotdot? name) 0) 0)
                    (fld-take-files root (tail names) (sub n 1)
                        (cons (fld-from-file (fld-join root name)) acc))
                    (fld-take-files root (tail names) n acc)))))
    (defn fld-docs-from-root (root)
        (if (if (eq (str_len root) 0) 1 (eq (fld-dotdot? root) 1)) (empty)
            (fld-take-files root (fs_list root) 32 (empty))))
    (let asked (fld-strip-nl (read_file "/tmp/form-local-docs-query")))
    (let root (fld-strip-nl (read_file "/tmp/form-local-docs-root")))
    (let question (if (gt (str_len asked) 0) asked
        "how do I water tomatoes in the garden"))
    (let docs (if (gt (str_len root) 0) (fld-docs-from-root root)
        (list
            (fld-from-file "form/form-stdlib/tests/local-docs-fixture/garden-notes.txt")
            (fld-from-file "form/form-stdlib/tests/local-docs-fixture/travel.txt"))))
    (let ans (fld-ask question docs))
    (print_str
        (str_concat "form-cli executed local-docs\n"
        (str_concat "form-cli folder="
        (str_concat (if (gt (str_len root) 0) root "fixture")
        (str_concat " files="
        (str_concat (int_to_str (len docs))
        (str_concat " grounded_status="
        (str_concat (fld-status ans)
        (str_concat "\n\n" (fld-pack ans))))))))))
    0)
