// form-cli-local-docs-run.fk — anyone door: folder + question -> Form pack.
//
// Write the folder path to /tmp/form-local-docs-root
// and the question to /tmp/form-local-docs-query, then:
//   ./fkwu form/form-stdlib/form-cli-local-docs-run.fk
// Paste the pack into a free ChatGPT chat. ChatGPT cannot see the disk.
//
// If those files are empty, the fixture folder answers instead.
//
import form-stdlib/core.fk;
import form-stdlib/form-cli-local-docs.fk;
section [form.bml] {
    def fld-strip-nl(s) = let(n, len(s), (Comparable) n == 0 ? s : (Comparable) str_byte_at(s, n - 1) == 10 ? substring(s, 0, n - 1) : s);
    def fld-from-file(path) = let(body, read_file(path), fld-doc(path, fld-tokenize((path + (" " + body))), fld-cap(body, 160)));
    def fld-join(root, name) = (root + ("/" + name));
    def fld-take-files(root, names, n, acc) = ((Comparable) n == 0 ? 1 : (Comparable) len(names) == 0) ? acc : let(name, names[0], ((Comparable) fld-ext-ok?(name) == 1 ? (Comparable) fld-dotdot?(name) == 0 : 0) ? fld-take-files(root, names[1:], n - 1, cons(fld-from-file(fld-join(root, name)), acc)) : fld-take-files(root, names[1:], n, acc));
    def fld-docs-from-root(root) = ((Comparable) len(root) == 0 ? 1 : (Comparable) fld-dotdot?(root) == 1) ? empty() : fld-take-files(root, fs_list(root), 32, empty());
    let asked0 = read_file("/tmp/form-local-docs-query");
    let asked = fld-strip-nl(nothing?(asked0) ? "" : asked0);
    let root0 = read_file("/tmp/form-local-docs-root");
    let root = fld-strip-nl(nothing?(root0) ? "" : root0);
    let question = len(asked) > 0 ? asked : "how do I water tomatoes in the garden";
    let docs = len(root) > 0 ? fld-docs-from-root(root) : [fld-from-file("form/form-stdlib/tests/local-docs-fixture/garden-notes.txt"), fld-from-file("form/form-stdlib/tests/local-docs-fixture/travel.txt")];
    let ans = fld-ask(question, docs);
    print_str(("form-cli executed local-docs\n" + ("form-cli folder=" + ((len(root) > 0 ? root : "fixture") + (" files=" + (len(docs).str() + (" grounded_status=" + (fld-status(ans) + ("\n\n" + fld-pack(ans))))))))));
    0;
}
