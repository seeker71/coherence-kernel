//////////////////////////////////////////////////////////////////////
//
// form-glass-flow-ui.bml — bounded observed-frame flow shard.
//
// Authority: form-stdlib/form-glass-live-ui.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/term-graphics.bml form/form-stdlib/form-terminal-canvas.bml form/form-stdlib/form-glass-dashboard.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassFlowUI {
        field FGLFlowShardSchema = "form-glass-flow-ui-v1";
        field FGLUIQwenOwnerParent = "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth";
        field FGLUIThreeBOwnerParent = "model.llama-3.2-3b-instruct";
        field FGLUIDiagnosticFlowPublisher = "model-flow-fixture";
        field FGLUIDiagnosticFlowOwner = "bounded-probe";
        field FGLUIQwenOwnerGapNode = "seam.owner-token-downstream.qwen38";
        field FGLUIThreeBOwnerGapNode = "seam.owner-token-downstream.llama32-3b";

        // Cumulative counters occupy indexes 2, 3, 4, and 6. Gauges occupy
        // 5, 7, 8, and 9. V2 appends the visible-node phase census, token
        // positions, tensor bytes, channel-tag memberships, and framebuffer accepts at
        // 10..16. A negative value is unavailable; zero is measured.
        def fgd-flow-point(epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight) = list("glass-flow-point-v1", epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight);
        def fgd-flow-point-v2(epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight, gas, water, ice, tokens, tensorBytes, channelEdges, framebufferAccepted) = list("glass-flow-point-v2", epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight, gas, water, ice, tokens, tensorBytes, channelEdges, framebufferAccepted);
        // V3 retains one evidence class for every value at indexes 2..16.
        // Older points remain readable but can only be called derived windows:
        // their integer payload did not retain the source truth class.
        def fgd-flow-point-v3(epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight, gas, water, ice, tokens, tensorBytes, channelEdges, framebufferAccepted, evidences) = append(fgd-flow-point-v2(epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight, gas, water, ice, tokens, tensorBytes, channelEdges, framebufferAccepted), list(evidences));
        // V4 carries the exact physical source, or the exact missing
        // publication door, beside every value at indexes 2..16.
        def fgd-flow-point-v4(epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight, gas, water, ice, tokens, tensorBytes, channelEdges, framebufferAccepted, evidences, sources) = append(cons("glass-flow-point-v4", tail(fgd-flow-point-v3(epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight, gas, water, ice, tokens, tensorBytes, channelEdges, framebufferAccepted, evidences))), list(-1, sources));
        def fgd-flow-value(point, index) = (index < 0) || (index >= len(point)) ? -1 : point[index];
        def fgd-flow-evidences(point) = len(point) >= 18 ? point[17] : list();
        def fgd-flow-sources(point) = (len(point) >= 20) && ((String) head(point) == "glass-flow-point-v4") ? point[19] : list();
        def fgd-flow-source(point, index) {
            let sources = fgd-flow-sources(point);
            let offset = index - 2;
            (offset < 0) || (offset >= len(sources)) ? "flow-point.source-not-retained" : sources[offset];
        }
        def fgd-flow-jit-fault(point) = ((String) head(point) == "glass-flow-point-v4") && (len(point) >= 21) ? point[20] : list();
        // A lane whose counter reads zero is either idle, empty, drained or
        // quiet -- four different sentences the metric row already says in its
        // lifecycle.  The point carries that word beside the number for the
        // lanes at indexes 2..9, so a zero on the atlas can name what it means
        // instead of standing there as a bare digit a reader must guess at.
        def fgd-flow-states(point) = ((String) head(point) == "glass-flow-point-v4") && (len(point) >= 22) ? point[21] : list();
        def fgd-flow-state(point, index) {
            let states = fgd-flow-states(point);
            let offset = index - 2;
            (offset < 0) || (offset >= len(states)) ? "" : states[offset];
        }
        def fgd-flow-evidence(point, index) {
            let value = fgd-flow-value(point, index);
            let evidences = fgd-flow-evidences(point);
            let offset = index - 2;
            value < 0 ? "unavailable" : (offset < 0) || (offset >= len(evidences)) ? "derived-window" : evidences[offset];
        }
        def fglui-good(value) = value < 0 ? 0 : value;
        def fglui-values(history, index) = (Comparable) len(history) == 0 ? list() : cons(fgd-flow-value(head(history), index), fglui-values(tail(history), index));
        def fglui-good-values(values) = (Comparable) len(values) == 0 ? list() : cons(fglui-good(head(values)), fglui-good-values(tail(values)));
        def fglui-deltas-next(history, index, prior) {
            let value = fgd-flow-value(head(history), index);
            let delta = (value < 0) || (prior < 0) ? -1 : value >= prior ? (value - prior) : 0;
            cons(delta, fglui-deltas-go(tail(history), index, value));
        }
        def fglui-deltas-go(history, index, prior) = (Comparable) len(history) == 0 ? list() : fglui-deltas-next(history, index, prior);
        def fglui-deltas(history, index) = (Comparable) len(history) == 0 ? list() : cons(fgd-flow-value(head(history), index) < 0 ? -1 : 0, fglui-deltas-go(tail(history), index, fgd-flow-value(head(history), index)));
        def fglui-missing(history, index) = (Comparable) len(history) == 0 ? 0 : ((fgd-flow-value(head(history), index) < 0 ? 1 : 0) + fglui-missing(tail(history), index));
        def fglui-last(history, index) = (Comparable) len(history) == 0 ? -1 : fgd-flow-value(history[len(history) - 1], index);
        def fglui-last-n(values, width) = len(values) <= width ? values : fgd-drop(values, len(values) - width);
        def fglui-glyphs(values, levels) = (Comparable) len(levels) == 0 ? "" : (head(values) < 0 ? "?" : ftc-spark-glyph(head(levels))) ++ fglui-glyphs(tail(values), tail(levels));
        def fglui-spark(values, width) {
            let visible = fglui-last-n(values, fgd-max(1, width));
            fglui-glyphs(visible, ftc-series-normalize(fglui-good-values(visible)));
        }
        def fglui-value(value) = value < 0 ? "unavailable(no-carrier)" : fgd-format-count(value);
        def fglui-value-short(value) = value < 0 ? "?" : fgd-format-count(value);
        def fglui-pad2(value) = value < 10 ? "0" ++ int_to_str(value) : int_to_str(value);
        def fglui-pad3(value) = value < 10 ? "00" ++ int_to_str(value) : value < 100 ? "0" ++ int_to_str(value) : int_to_str(value);
        def fglui-utc-clock(epoch) {
            let day = epoch % 86400000;
            let hour = day / 3600000;
            let minute = (day % 3600000) / 60000;
            let second = (day % 60000) / 1000;
            fgd-cat(list(fglui-pad2(hour), ":", fglui-pad2(minute), ":", fglui-pad2(second), ".", fglui-pad3(day % 1000), "Z"));
        }
        def fglui-frame-delta(history) = len(history) < 2 ? 0 : fgd-flow-value(history[len(history) - 1], 1) >= fgd-flow-value(history[len(history) - 2], 1) ? (fgd-flow-value(history[len(history) - 1], 1) - fgd-flow-value(history[len(history) - 2], 1)) : 0;
        def fglui-metric-count(metrics, id) {
            let metric = fgd-find-metric(metrics, id);
            ((Comparable) len(metric) == 0) || ((Comparable) fgo-present?(metric) == 0) ? -1 : fgo-int-value(metric);
        }
        // These four lanes retain owner/Hearth request-window truth. Counter
        // deltas are anchored to adjacent owner publications; queue is a
        // physical Hearth gauge. Missing publishers stay named doors.
        def fglui-flow-zero-state(label) = (String) label == "QUEUE" ? "drained" : "idle";
        def fglui-flow-unit(label) = match (String) label { "GPU" | "CPU-JIT" => "us", "DISPATCH" => "dsp", "QUEUE" => "req", _ => "" };
        def fglui-flow-value-text(label, value) = value < 0 ? "unavailable(no-carrier)" : fgd-cat(list(fgd-format-count(value), fglui-flow-unit(label), (Comparable) value == 0 ? fgd-cat(list("(", fglui-flow-zero-state(label), ")")) : ""));
        // the newest delta of a lane, read from the last two points alone: what the last of fglui-deltas would be
        def fglui-last-delta(history, index) = (Comparable) len(history) == 0 ? -1 : len(history) < 2 ? (fgd-flow-value(head(history), index) < 0 ? -1 : 0) : head(fglui-deltas-next(fgd-drop(history, len(history) - 1), index, fgd-flow-value(history[len(history) - 2], index)));
        def fglui-pulse-line(epoch, hz, frame, history, metrics, width) {
            let dispatch = fglui-last-delta(history, 4);
            let events = fglui-metric-count(metrics, "events");
            let nodes = fglui-metric-count(metrics, "cells");
            let cons = fglui-metric-count(metrics, "cons");
            fgd-segment-line(fgd-cat(list("TICK ", fglui-utc-clock(epoch), " #", int_to_str(frame), " dt=", int_to_str(fglui-frame-delta(history)), "/", int_to_str(1000 / hz), "ms d+", fglui-value-short(dispatch), " ev=", fglui-value-short(events), " nodes=", fglui-value-short(nodes), " cons=", fglui-value-short(cons), " [glass]")), width, fgd-style-for-plane("form", 220, 0), "flow.tick", list("flow", "form", "framebuffer", "cell"), "physical-live");
        }
        def fglui-counter-window-go(history, index, prior, held) = (Comparable) len(history) == 0 ? held : fglui-counter-window-next(history, index, prior, held);
        def fglui-counter-window-next(history, index, prior, held) {
            let point = head(history);
            let value = fgd-flow-value(point, index);
            let next = ((prior >= 0) && (value >= prior)) && (value > prior) ? list(value - prior, point) : held;
            fglui-counter-window-go(tail(history), index, value, next);
        }
        def fglui-counter-window(history, index) = len(history) < 2 ? list() : fglui-counter-window-go(tail(history), index, fgd-flow-value(head(history), index), list());
        def fglui-gauge-window(history, index, held) = (Comparable) len(history) == 0 ? held : fgd-flow-value(head(history), index) > 0 ? fglui-gauge-window(tail(history), index, list(fgd-flow-value(head(history), index), head(history))) : fglui-gauge-window(tail(history), index, held);
        def fglui-flow-window(history, index, delta) = (Comparable) delta == 1 ? fglui-counter-window(history, index) : fglui-gauge-window(history, index, list());
        // A window that found no busy moment is not the same as a window with
        // nothing in it, and this row said the same words for both: an all-zero
        // history read "window-missing=glass.history.owner-event-after-baseline",
        // which claims the glass kept no record while the record was right there
        // and said quiet. Measured 2026-09-10 on five consecutive reads of
        // the current flow page: the QUEUE row alternated
        // between that sentence and "now=1req window=1req age=0ms" as the depth
        // moved 0, 1, 0 -- one lane, two grammars, flipping. A reader cannot tell
        // a quiet queue from a blind one, and a row whose SHAPE changes with its
        // value is read as breakage rather than as calm.
        //
        // The membrane already carries the law this broke: absent and measured
        // zero never share a representation. So the window now answers in three
        // states instead of two, and the row keeps one shape whatever the number.
        def fglui-window-absent() = 0;
        def fglui-window-quiet() = 1;
        def fglui-window-held() = 2;
        // how many points of the history carried a measurement at all
        def fglui-measured-count(history, index) = (Comparable) len(history) == 0 ? 0 : ((fgd-flow-value(head(history), index) >= 0 ? 1 : 0) + fglui-measured-count(tail(history), index));
        def fglui-window-state(history, index, window) = len(window) > 0 ? fglui-window-held() : fglui-measured-count(history, index) > 0 ? fglui-window-quiet() : fglui-window-absent();
        def fglui-window-span(history, index) {
            let measured = fglui-measured-count(history, index);
            let first = fgd-flow-value(head(history), 1);
            let last = fgd-flow-value(history[len(history) - 1], 1);
            ((Comparable) measured == 0) || (first >= last) ? 0 : (last - first);
        }
        def fglui-flow-window-text-in(label, state, history, index, window, epoch) =
            (Comparable) state == fglui-window-absent() ? "window-missing=glass.history.owner-event-after-baseline"
            : (Comparable) state == fglui-window-quiet() ? fgd-cat(list("window=", fglui-flow-value-text(label, 0), " quiet-for=", fgd-format-age-ms(fglui-window-span(history, index))))
            : fgd-cat(list("window=", fglui-flow-value-text(label, window[0]), " age=", fgd-format-age-ms(epoch >= fgd-flow-value(window[1], 1) ? (epoch - fgd-flow-value(window[1], 1)) : 0)));
        def fglui-flow-window-text(label, window, epoch) = fglui-flow-window-text-in(label, len(window) > 0 ? fglui-window-held() : fglui-window-absent(), list(), 0, window, epoch);
        def fglui-flow-line(label, history, index, delta, width, plane) {
            let values = (Comparable) delta == 1 ? fglui-deltas(history, index) : fglui-values(history, index);
            let missing = fglui-missing(history, index);
            let latest = (Comparable) delta == 1 ? ((Comparable) len(values) == 0 ? -1 : values[len(values) - 1]) : fglui-last(history, index);
            let current = (Comparable) len(history) == 0 ? list() : history[len(history) - 1];
            let window = fglui-flow-window(history, index, delta);
            let sourcePoint = len(window) > 0 ? window[1] : current;
            let source = (Comparable) len(sourcePoint) == 0 ? "glass.flow-point.publisher" : fgd-flow-source(sourcePoint, index);
            let epoch = (Comparable) len(current) == 0 ? 0 : fgd-flow-value(current, 1);
            let sparkWidth = fgd-clamp(width - (str_len(label) + 76), 4, 48);
            let known = ((len(history) > 0) && (missing < len(history))) && (!((String) source == "flow-point.source-not-retained")) ? 1 : 0;
            let total = ((Comparable) delta == 1) && ((Comparable) known == 1) ? fgd-cat(list(" total=", fglui-flow-value-text(label, fglui-last(history, index)))) : "";
            let text = (Comparable) known == 0 ? fgd-cat(list(label, " ", fglui-spark(values, sparkWidth), " missing=", source)) : fgd-cat(list(label, " ", fglui-spark(values, sparkWidth), " scope=", (String) label == "QUEUE" ? "hearth.queue" : "model.owner", " now=", fglui-flow-value-text(label, latest), total, " ", fglui-flow-window-text-in(label, fglui-window-state(history, index, window), history, index, window, epoch), " src=", source));
            fgd-segment-line(text, width, fgd-style-for-plane(plane, (Comparable) known == 1 ? 220 : 72, 0), "flow.request-window." ++ label, list("flow", plane, "scope.request-window"), (Comparable) known == 1 ? fgd-flow-evidence(current, index) : "unavailable");
        }
        def fglui-jit-fault-line(fault, epoch, width) = fgd-segment-line(fgd-cat(list("! JIT HEALING P", int_to_str(len(fault) >= 8 ? fault[7] : 0), " stage=", fault[1], " last-failure=", fault[2], " age=", fgd-format-age-ms(epoch >= fault[3] ? (epoch - fault[3]) : 0), " evidence=", fault[4], " preemption=", fault[5], " src=", fault[6])), width, fgd-style-for-plane("cpu", 255, 1), fault[0], list("flow", "jit", "fault", "healing", "priority"), fault[4]);
        def fglui-flow-lines(history, width) {
            let current = (Comparable) len(history) == 0 ? list() : history[len(history) - 1];
            let fault = (Comparable) len(current) == 0 ? list() : fgd-flow-jit-fault(current);
            let rows = list(fglui-flow-line("GPU", history, 2, 1, width, "metal"), fglui-flow-line("CPU-JIT", history, 3, 1, width, "cpu"), fglui-flow-line("DISPATCH", history, 4, 1, width, "form"), fglui-flow-line("QUEUE", history, 5, 0, width, "membrane"));
            (Comparable) len(fault) == 0 ? rows : cons(fglui-jit-fault-line(fault, fgd-flow-value(current, 1), width), rows);
        }

        // Exact token-flow publications are separate from aggregate counters.
        // A projected sample retains producer publisher in owner and flow id in
        // lane. Select that pair before looking up any stage so two concurrent
        // flows can never be spliced into one visual pipeline.
        def fglui-token-flow-channel?(sample) = fgd-has-channel(fgtm-sample-channels(sample), "token-flow");
        def fglui-token-flow-diagnostic?(sample) = !((Comparable) fglui-token-flow-channel?(sample) == 1) ? 0 : (String) fgtm-sample-source(sample) == FGLUIDiagnosticFlowPublisher() ? 1 : (String) fgtm-sample-owner(sample) == FGLUIDiagnosticFlowOwner() ? 1 : 0;
        def fglui-token-flow-primary?(sample) = !((Comparable) fglui-token-flow-channel?(sample) == 1) ? 0 : (Comparable) fglui-token-flow-diagnostic?(sample) == 1 ? 0 : 1;
        def fglui-token-flow-all(rows) = (Comparable) len(rows) == 0 ? list() : (Comparable) fglui-token-flow-primary?(head(rows)) == 1 ? cons(head(rows), fglui-token-flow-all(tail(rows))) : fglui-token-flow-all(tail(rows));
        def fglui-token-flow-diagnostics(rows) = (Comparable) len(rows) == 0 ? list() : (Comparable) fglui-token-flow-diagnostic?(head(rows)) == 1 ? cons(head(rows), fglui-token-flow-diagnostics(tail(rows))) : fglui-token-flow-diagnostics(tail(rows));
        def fglui-token-flow-epoch(sample) = (Comparable) fgtm-field-present?(fgtm-sample-write-epoch(sample)) == 1 ? fgtm-field-value(fgtm-sample-write-epoch(sample)) : -1;
        def fglui-token-flow-newer(a, b) = (Comparable) len(a) == 0 ? b : fglui-token-flow-epoch(b) > fglui-token-flow-epoch(a) ? b : a;
        def fglui-token-flow-latest(rows, held) = (Comparable) len(rows) == 0 ? held : fglui-token-flow-latest(tail(rows), fglui-token-flow-newer(held, head(rows)));
        def fglui-token-flow-key-matches?(sample, publisher, flowId) = !((String) fgtm-sample-source(sample) == publisher) ? 0 : ((String) fgtm-sample-lane(sample) == flowId);
        def fglui-token-flow-select(rows, publisher, flowId) = (Comparable) len(rows) == 0 ? list() : (Comparable) fglui-token-flow-key-matches?(head(rows), publisher, flowId) == 1 ? cons(head(rows), fglui-token-flow-select(tail(rows), publisher, flowId)) : fglui-token-flow-select(tail(rows), publisher, flowId);
        def fglui-token-flow-samples(rows) {
            let all = fglui-token-flow-all(rows);
            let latest = fglui-token-flow-latest(all, list());
            (Comparable) len(latest) == 0 ? list() : fglui-token-flow-select(all, fgtm-sample-source(latest), fgtm-sample-lane(latest));
        }
        def fglui-token-flow-present?(rows) {
            let selected = fglui-token-flow-samples(rows);
            (Comparable) len(selected) == 0 ? 0 : (Comparable) len(fglui-flow-stage-sample-selected(selected, "token")) == 0 ? 0 : 1;
        }
        def fglui-token-flow-all-physical?(rows) = (Comparable) len(rows) == 0 ? 0 : !((String) fgtm-sample-evidence(head(rows)) == "physical-live") ? 0 : (Comparable) len(tail(rows)) == 0 ? 1 : fglui-token-flow-all-physical?(tail(rows));
        def fglui-flow-stage-kind(stage) = (String) stage == "request" ? "request" : (String) stage == "token" ? "token-position" : (String) stage == "layer" ? "layer" : (String) stage == "tensor" ? "tensor" : (String) stage == "expert" ? "expert-route" : (String) stage == "metal" ? "metal" : (String) stage == "framebuffer" ? "framebuffer" : "glass-flow";
        def fglui-flow-stage-sample-selected(rows, stage) = (Comparable) len(rows) == 0 ? list() : (String) fgtm-sample-kind(head(rows)) == fglui-flow-stage-kind(stage) ? head(rows) : fglui-flow-stage-sample-selected(tail(rows), stage);
        def fglui-flow-stage-sample(rows, stage) = fglui-flow-stage-sample-selected(fglui-token-flow-samples(rows), stage);
        def fglui-token-flow-letter(kind) = (String) kind == "request" ? "Q" : (String) kind == "token-position" ? "T" : (String) kind == "layer" ? "L" : (String) kind == "tensor" ? "X" : (String) kind == "expert-route" ? "E" : (String) kind == "metal" ? "M" : (String) kind == "framebuffer" ? "F" : "G";
        def fglui-channel-with-prefix(channels, prefix) = (Comparable) len(channels) == 0 ? "absent" : (Comparable) str_find(head(channels), prefix, 0) == 0 ? substring(head(channels), str_len(prefix), str_len(head(channels))) : fglui-channel-with-prefix(tail(channels), prefix);
        def fglui-token-flow-model(sample) = fglui-channel-with-prefix(fgtm-sample-channels(sample), "model.");
        def fglui-token-flow-category(sample) = fglui-channel-with-prefix(fgtm-sample-channels(sample), "category.");
        def fglui-token-flow-family(sample) = fglui-channel-with-prefix(fgtm-sample-channels(sample), "family.");
        def fglui-token-flow-role(sample) = fglui-channel-with-prefix(fgtm-sample-channels(sample), "role.");
        def fglui-token-flow-type(sample) = fglui-channel-with-prefix(fgtm-sample-channels(sample), "type.");
        def fglui-token-flow-category-text(sample) = fgd-cat(list("CELL=", fgtm-sample-id(sample), " CAT=", fglui-token-flow-category(sample), " FAM=", fglui-token-flow-family(sample), " ROLE=", fglui-token-flow-role(sample), " TYPE=", fglui-token-flow-type(sample)));
        def fglui-token-flow-display-model(sample) {
            let modelId = "model." ++ fglui-token-flow-model(sample);
            (String) modelId == FGLUIQwenOwnerParent() ? fglui-owner-token-model-name(FGLUIQwenOwnerParent()) : (String) modelId == FGLUIThreeBOwnerParent() ? fglui-owner-token-model-name(FGLUIThreeBOwnerParent()) : fglui-token-flow-model(sample);
        }
        def fglui-token-flow-us(value) = tg-dur-us(value);
        def fglui-token-flow-present-number(field, prefix) = (Comparable) fgtm-field-present?(field) == 1 ? prefix ++ int_to_str(fgtm-field-value(field)) : "abs";
