        def fglui-token-flow-compact-bytes(sample) = (String) fgtm-sample-kind(sample) == "request" ? fglui-token-flow-number-bytes(fgtm-sample-capacity(sample), "s") : (String) fgtm-sample-kind(sample) == "token-position" ? fglui-token-flow-number-bytes(fgtm-sample-capacity(sample), "p") : (String) fgtm-sample-kind(sample) == "layer" ? fglui-token-flow-number-bytes(fgtm-sample-capacity(sample), "l") : (String) fgtm-sample-kind(sample) == "tensor" ? ((Comparable) fgtm-field-present?(fgtm-sample-bytes(sample)) == 1 ? fgdb-format-bytes(fgtm-field-value(fgtm-sample-bytes(sample))) : fgdb-text("tensor")) : (String) fgtm-sample-kind(sample) == "expert-route" ? ((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1 ? fglui-token-flow-number-bytes(fgtm-sample-capacity(sample), "e") : fgdb-text("top10")) : (String) fgtm-sample-kind(sample) == "metal" ? ((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1 ? fglui-token-flow-duration-bytes(fgtm-field-value(fgtm-sample-capacity(sample))) : fgdb-text("pipe")) : (String) fgtm-sample-kind(sample) == "framebuffer" ? fgdb-text("snap") : fglui-token-flow-number-bytes(fgtm-sample-capacity(sample), "s");
        def fglui-token-flow-atom-bytes(sample) = fgdb-cat(list(fgdb-text(fglui-token-flow-letter(fgtm-sample-kind(sample))), fgdb-text(fgd-truth-symbol(fgtm-sample-evidence(sample))), fglui-token-flow-compact-bytes(sample)));
        def fglui-token-flow-chain-bytes(rows) = (Comparable) len(rows) == 0 ? list() : (Comparable) len(tail(rows)) == 0 ? fglui-token-flow-atom-bytes(head(rows)) : fgdb-cat(list(fglui-token-flow-atom-bytes(head(rows)), fgdb-text(" > "), fglui-token-flow-chain-bytes(tail(rows))));
