//////////////////////////////////////////////////////////////////////
//
// form-glass-flow-ui.bml — bounded observed-frame flow shard.
//
// Authority: form-stdlib/form-glass-live-ui.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/term-graphics.bml form/form-stdlib/form-terminal-canvas.bml form/form-stdlib/form-glass-dashboard.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassFlowUI {
        field FGLFlowShardSchema = "form-glass-flow-ui-v1";
        field FGLUIQwenOwnerParent = "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth";
        field FGLUIThreeBOwnerParent = "model.llama-3.2-3b-instruct";
        field FGLUIDiagnosticFlowPublisher = "model-flow-fixture";
        field FGLUIDiagnosticFlowOwner = "bounded-probe";
        field FGLUIQwenOwnerGapNode = "seam.owner-token-downstream.qwen38";
        field FGLUIThreeBOwnerGapNode = "seam.owner-token-downstream.llama32-3b";

        // Cumulative counters occupy indexes 2, 3, 4, and 6. Gauges occupy
        // 5, 7, 8, and 9. V2 appends the visible-node phase census, token
        // positions, tensor bytes, channel-tag memberships, and framebuffer accepts at
        // 10..16. A negative value is unavailable; zero is measured.
        def fgd-flow-point(epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight) = list("glass-flow-point-v1", epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight);
        def fgd-flow-point-v2(epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight, gas, water, ice, tokens, tensorBytes, channelEdges, framebufferAccepted) = list("glass-flow-point-v2", epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight, gas, water, ice, tokens, tensorBytes, channelEdges, framebufferAccepted);
        // V3 retains one evidence class for every value at indexes 2..16.
        // Older points remain readable but can only be called derived windows:
        // their integer payload did not retain the source truth class.
        def fgd-flow-point-v3(epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight, gas, water, ice, tokens, tensorBytes, channelEdges, framebufferAccepted, evidences) = append(fgd-flow-point-v2(epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight, gas, water, ice, tokens, tensorBytes, channelEdges, framebufferAccepted), list(evidences));
        // V4 carries the exact physical source, or the exact missing
        // publication door, beside every value at indexes 2..16.
        def fgd-flow-point-v4(epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight, gas, water, ice, tokens, tensorBytes, channelEdges, framebufferAccepted, evidences, sources) = append(cons("glass-flow-point-v4", tail(fgd-flow-point-v3(epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight, gas, water, ice, tokens, tensorBytes, channelEdges, framebufferAccepted, evidences))), list(-1, sources));
        def fgd-flow-value(point, index) = if ((index < 0) || (index >= len(point))) then -1 else nth(point, index);
        def fgd-flow-evidences(point) = if (len(point) >= 18) then nth(point, 17) else list();
        def fgd-flow-sources(point) = if ((len(point) >= 20) && ((String) head(point) == "glass-flow-point-v4")) then nth(point, 19) else list();
        def fgd-flow-source(point, index) {
            let sources = fgd-flow-sources(point);
            let offset = (index - 2);
            if ((offset < 0) || (offset >= len(sources))) then "flow-point.source-not-retained" else nth(sources, offset);
        }
        def fgd-flow-jit-fault(point) = if (((String) head(point) == "glass-flow-point-v4") && (len(point) >= 21)) then nth(point, 20) else list();
        // A lane whose counter reads zero is either idle, empty, drained or
        // quiet -- four different sentences the metric row already says in its
        // lifecycle.  The point carries that word beside the number for the
        // lanes at indexes 2..9, so a zero on the atlas can name what it means
        // instead of standing there as a bare digit a reader must guess at.
        def fgd-flow-states(point) = if (((String) head(point) == "glass-flow-point-v4") && (len(point) >= 22)) then nth(point, 21) else list();
        def fgd-flow-state(point, index) {
            let states = fgd-flow-states(point);
            let offset = (index - 2);
            if ((offset < 0) || (offset >= len(states))) then "" else nth(states, offset);
        }
        def fgd-flow-evidence(point, index) {
            let value = fgd-flow-value(point, index);
            let evidences = fgd-flow-evidences(point);
            let offset = (index - 2);
            if (value < 0) then "unavailable" else if ((offset < 0) || (offset >= len(evidences))) then "derived-window" else nth(evidences, offset);
        }
        def fglui-good(value) = if (value < 0) then 0 else value;
        def fglui-values(history, index) = if ((Comparable) len(history) == 0) then list() else cons(fgd-flow-value(head(history), index), fglui-values(tail(history), index));
        def fglui-good-values(values) = if ((Comparable) len(values) == 0) then list() else cons(fglui-good(head(values)), fglui-good-values(tail(values)));
        def fglui-deltas-next(history, index, prior) {
            let value = fgd-flow-value(head(history), index);
            let delta = if ((value < 0) || (prior < 0)) then -1 else if (value >= prior) then (value - prior) else 0;
            cons(delta, fglui-deltas-go(tail(history), index, value));
        }
        def fglui-deltas-go(history, index, prior) = if ((Comparable) len(history) == 0) then list() else fglui-deltas-next(history, index, prior);
        def fglui-deltas(history, index) = if ((Comparable) len(history) == 0) then list() else cons(if (fgd-flow-value(head(history), index) < 0) then -1 else 0, fglui-deltas-go(tail(history), index, fgd-flow-value(head(history), index)));
        def fglui-missing(history, index) = if ((Comparable) len(history) == 0) then 0 else ((if (fgd-flow-value(head(history), index) < 0) then 1 else 0) + fglui-missing(tail(history), index));
        def fglui-last(history, index) = if ((Comparable) len(history) == 0) then -1 else fgd-flow-value(nth(history, (len(history) - 1)), index);
        def fglui-last-n(values, width) = if (len(values) <= width) then values else fgd-drop(values, (len(values) - width));
        def fglui-glyphs(values, levels) = if ((Comparable) len(levels) == 0) then "" else str_concat(if (head(values) < 0) then "?" else ftc-spark-glyph(head(levels)), fglui-glyphs(tail(values), tail(levels)));
        def fglui-spark(values, width) {
            let visible = fglui-last-n(values, fgd-max(1, width));
            fglui-glyphs(visible, ftc-series-normalize(fglui-good-values(visible)));
        }
        def fglui-value(value) = if (value < 0) then "unavailable(no-carrier)" else fgd-format-count(value);
        def fglui-value-short(value) = if (value < 0) then "?" else fgd-format-count(value);
        def fglui-pad2(value) = if (value < 10) then str_concat("0", int_to_str(value)) else int_to_str(value);
        def fglui-pad3(value) = if (value < 10) then str_concat("00", int_to_str(value)) else if (value < 100) then str_concat("0", int_to_str(value)) else int_to_str(value);
        def fglui-utc-clock(epoch) {
            let day = (epoch % 86400000);
            let hour = (day / 3600000);
            let minute = ((day % 3600000) / 60000);
            let second = ((day % 60000) / 1000);
            fgd-cat(list(fglui-pad2(hour), ":", fglui-pad2(minute), ":", fglui-pad2(second), ".", fglui-pad3((day % 1000)), "Z"));
        }
        def fglui-frame-delta(history) = if (len(history) < 2) then 0 else if (fgd-flow-value(nth(history, (len(history) - 1)), 1) >= fgd-flow-value(nth(history, (len(history) - 2)), 1)) then (fgd-flow-value(nth(history, (len(history) - 1)), 1) - fgd-flow-value(nth(history, (len(history) - 2)), 1)) else 0;
        def fglui-metric-count(metrics, id) {
            let metric = fgd-find-metric(metrics, id);
            if (((Comparable) len(metric) == 0) || ((Comparable) fgo-present?(metric) == 0)) then -1 else fgo-int-value(metric);
        }
        // These four lanes retain owner/Hearth request-window truth. Counter
        // deltas are anchored to adjacent owner publications; queue is a
        // physical Hearth gauge. Missing publishers stay named doors.
        def fglui-flow-zero-state(label) = if ((String) label == "QUEUE") then "drained" else "idle";
        def fglui-flow-unit(label) = if ((String) label == "GPU") then "us" else if ((String) label == "CPU-JIT") then "us" else if ((String) label == "DISPATCH") then "dsp" else if ((String) label == "QUEUE") then "req" else "";
        def fglui-flow-value-text(label, value) = if (value < 0) then "unavailable(no-carrier)" else fgd-cat(list(fgd-format-count(value), fglui-flow-unit(label), if ((Comparable) value == 0) then fgd-cat(list("(", fglui-flow-zero-state(label), ")")) else ""));
        // the newest delta of a lane, read from the last two points alone: what the last of fglui-deltas would be
        def fglui-last-delta(history, index) = if ((Comparable) len(history) == 0) then -1 else if (len(history) < 2) then if (fgd-flow-value(head(history), index) < 0) then -1 else 0 else head(fglui-deltas-next(fgd-drop(history, (len(history) - 1)), index, fgd-flow-value(nth(history, (len(history) - 2)), index)));
        def fglui-pulse-line(epoch, hz, frame, history, metrics, width) {
            let dispatch = fglui-last-delta(history, 4);
            let events = fglui-metric-count(metrics, "events");
            let nodes = fglui-metric-count(metrics, "cells");
            let cons = fglui-metric-count(metrics, "cons");
            fgd-segment-line(fgd-cat(list("TICK ", fglui-utc-clock(epoch), " #", int_to_str(frame), " dt=", int_to_str(fglui-frame-delta(history)), "/", int_to_str((1000 / hz)), "ms d+", fglui-value-short(dispatch), " ev=", fglui-value-short(events), " nodes=", fglui-value-short(nodes), " cons=", fglui-value-short(cons), " [glass]")), width, fgd-style-for-plane("form", 220, 0), "flow.tick", list("flow", "form", "framebuffer", "cell"), "physical-live");
        }
        def fglui-counter-window-go(history, index, prior, held) = if ((Comparable) len(history) == 0) then held else fglui-counter-window-next(history, index, prior, held);
        def fglui-counter-window-next(history, index, prior, held) {
            let point = head(history);
            let value = fgd-flow-value(point, index);
            let next = if (((prior >= 0) && (value >= prior)) && (value > prior)) then list((value - prior), point) else held;
            fglui-counter-window-go(tail(history), index, value, next);
        }
        def fglui-counter-window(history, index) = if (len(history) < 2) then list() else fglui-counter-window-go(tail(history), index, fgd-flow-value(head(history), index), list());
        def fglui-gauge-window(history, index, held) = if ((Comparable) len(history) == 0) then held else if (fgd-flow-value(head(history), index) > 0) then fglui-gauge-window(tail(history), index, list(fgd-flow-value(head(history), index), head(history))) else fglui-gauge-window(tail(history), index, held);
        def fglui-flow-window(history, index, delta) = if ((Comparable) delta == 1) then fglui-counter-window(history, index) else fglui-gauge-window(history, index, list());
        // A window that found no busy moment is not the same as a window with
        // nothing in it, and this row said the same words for both: an all-zero
        // history read "window-missing=glass.history.owner-event-after-baseline",
        // which claims the glass kept no record while the record was right there
        // and said quiet. Measured 2026-09-10 on five consecutive reads of
        // the current flow page: the QUEUE row alternated
        // between that sentence and "now=1req window=1req age=0ms" as the depth
        // moved 0, 1, 0 -- one lane, two grammars, flipping. A reader cannot tell
        // a quiet queue from a blind one, and a row whose SHAPE changes with its
        // value is read as breakage rather than as calm.
        //
        // The membrane already carries the law this broke: absent and measured
        // zero never share a representation. So the window now answers in three
        // states instead of two, and the row keeps one shape whatever the number.
        def fglui-window-absent() = 0;
        def fglui-window-quiet() = 1;
        def fglui-window-held() = 2;
        // how many points of the history carried a measurement at all
        def fglui-measured-count(history, index) = if ((Comparable) len(history) == 0) then 0 else ((if (fgd-flow-value(head(history), index) >= 0) then 1 else 0) + fglui-measured-count(tail(history), index));
        def fglui-window-state(history, index, window) = if (len(window) > 0) then fglui-window-held() else if (fglui-measured-count(history, index) > 0) then fglui-window-quiet() else fglui-window-absent();
        def fglui-window-span(history, index) {
            let measured = fglui-measured-count(history, index);
            let first = fgd-flow-value(head(history), 1);
            let last = fgd-flow-value(nth(history, (len(history) - 1)), 1);
            if (((Comparable) measured == 0) || (first >= last)) then 0 else (last - first);
        }
        def fglui-flow-window-text-in(label, state, history, index, window, epoch) =
            if ((Comparable) state == fglui-window-absent()) then "window-missing=glass.history.owner-event-after-baseline"
            else if ((Comparable) state == fglui-window-quiet()) then fgd-cat(list("window=", fglui-flow-value-text(label, 0), " quiet-for=", fgd-format-age-ms(fglui-window-span(history, index))))
            else fgd-cat(list("window=", fglui-flow-value-text(label, nth(window, 0)), " age=", fgd-format-age-ms(if (epoch >= fgd-flow-value(nth(window, 1), 1)) then (epoch - fgd-flow-value(nth(window, 1), 1)) else 0)));
        def fglui-flow-window-text(label, window, epoch) = fglui-flow-window-text-in(label, if (len(window) > 0) then fglui-window-held() else fglui-window-absent(), list(), 0, window, epoch);
        def fglui-flow-line(label, history, index, delta, width, plane) {
            let values = if ((Comparable) delta == 1) then fglui-deltas(history, index) else fglui-values(history, index);
            let missing = fglui-missing(history, index);
            let latest = if ((Comparable) delta == 1) then if ((Comparable) len(values) == 0) then -1 else nth(values, (len(values) - 1)) else fglui-last(history, index);
            let current = if ((Comparable) len(history) == 0) then list() else nth(history, (len(history) - 1));
            let window = fglui-flow-window(history, index, delta);
            let sourcePoint = if (len(window) > 0) then nth(window, 1) else current;
            let source = if ((Comparable) len(sourcePoint) == 0) then "glass.flow-point.publisher" else fgd-flow-source(sourcePoint, index);
            let epoch = if ((Comparable) len(current) == 0) then 0 else fgd-flow-value(current, 1);
            let sparkWidth = fgd-clamp((width - (str_len(label) + 76)), 4, 48);
            let known = if (((len(history) > 0) && (missing < len(history))) && (!((String) source == "flow-point.source-not-retained"))) then 1 else 0;
            let total = if (((Comparable) delta == 1) && ((Comparable) known == 1)) then fgd-cat(list(" total=", fglui-flow-value-text(label, fglui-last(history, index)))) else "";
            let text = if ((Comparable) known == 0) then fgd-cat(list(label, " ", fglui-spark(values, sparkWidth), " missing=", source)) else fgd-cat(list(label, " ", fglui-spark(values, sparkWidth), " scope=", if ((String) label == "QUEUE") then "hearth.queue" else "model.owner", " now=", fglui-flow-value-text(label, latest), total, " ", fglui-flow-window-text-in(label, fglui-window-state(history, index, window), history, index, window, epoch), " src=", source));
            fgd-segment-line(text, width, fgd-style-for-plane(plane, if ((Comparable) known == 1) then 220 else 72, 0), str_concat("flow.request-window.", label), list("flow", plane, "scope.request-window"), if ((Comparable) known == 1) then fgd-flow-evidence(current, index) else "unavailable");
        }
        def fglui-jit-fault-line(fault, epoch, width) = fgd-segment-line(fgd-cat(list("! JIT HEALING P", int_to_str(if (len(fault) >= 8) then nth(fault, 7) else 0), " stage=", nth(fault, 1), " last-failure=", nth(fault, 2), " age=", fgd-format-age-ms(if (epoch >= nth(fault, 3)) then (epoch - nth(fault, 3)) else 0), " evidence=", nth(fault, 4), " preemption=", nth(fault, 5), " src=", nth(fault, 6))), width, fgd-style-for-plane("cpu", 255, 1), nth(fault, 0), list("flow", "jit", "fault", "healing", "priority"), nth(fault, 4));
        def fglui-flow-lines(history, width) {
            let current = if ((Comparable) len(history) == 0) then list() else nth(history, (len(history) - 1));
            let fault = if ((Comparable) len(current) == 0) then list() else fgd-flow-jit-fault(current);
            let rows = list(fglui-flow-line("GPU", history, 2, 1, width, "metal"), fglui-flow-line("CPU-JIT", history, 3, 1, width, "cpu"), fglui-flow-line("DISPATCH", history, 4, 1, width, "form"), fglui-flow-line("QUEUE", history, 5, 0, width, "membrane"));
            if ((Comparable) len(fault) == 0) then rows else cons(fglui-jit-fault-line(fault, fgd-flow-value(current, 1), width), rows);
        }

        // Exact token-flow publications are separate from aggregate counters.
        // A projected sample retains producer publisher in owner and flow id in
        // lane. Select that pair before looking up any stage so two concurrent
        // flows can never be spliced into one visual pipeline.
        def fglui-token-flow-channel?(sample) = fgd-has-channel(fgtm-sample-channels(sample), "token-flow");
        def fglui-token-flow-diagnostic?(sample) = if (!((Comparable) fglui-token-flow-channel?(sample) == 1)) then 0 else if ((String) fgtm-sample-source(sample) == FGLUIDiagnosticFlowPublisher()) then 1 else if ((String) fgtm-sample-owner(sample) == FGLUIDiagnosticFlowOwner()) then 1 else 0;
        def fglui-token-flow-primary?(sample) = if (!((Comparable) fglui-token-flow-channel?(sample) == 1)) then 0 else if ((Comparable) fglui-token-flow-diagnostic?(sample) == 1) then 0 else 1;
        def fglui-token-flow-all(rows) = if ((Comparable) len(rows) == 0) then list() else if ((Comparable) fglui-token-flow-primary?(head(rows)) == 1) then cons(head(rows), fglui-token-flow-all(tail(rows))) else fglui-token-flow-all(tail(rows));
        def fglui-token-flow-diagnostics(rows) = if ((Comparable) len(rows) == 0) then list() else if ((Comparable) fglui-token-flow-diagnostic?(head(rows)) == 1) then cons(head(rows), fglui-token-flow-diagnostics(tail(rows))) else fglui-token-flow-diagnostics(tail(rows));
        def fglui-token-flow-epoch(sample) = if ((Comparable) fgtm-field-present?(fgtm-sample-write-epoch(sample)) == 1) then fgtm-field-value(fgtm-sample-write-epoch(sample)) else -1;
        def fglui-token-flow-newer(a, b) = if ((Comparable) len(a) == 0) then b else if (fglui-token-flow-epoch(b) > fglui-token-flow-epoch(a)) then b else a;
        def fglui-token-flow-latest(rows, held) = if ((Comparable) len(rows) == 0) then held else fglui-token-flow-latest(tail(rows), fglui-token-flow-newer(held, head(rows)));
        def fglui-token-flow-key-matches?(sample, publisher, flowId) = if (!((String) fgtm-sample-source(sample) == publisher)) then 0 else ((String) fgtm-sample-lane(sample) == flowId);
        def fglui-token-flow-select(rows, publisher, flowId) = if ((Comparable) len(rows) == 0) then list() else if ((Comparable) fglui-token-flow-key-matches?(head(rows), publisher, flowId) == 1) then cons(head(rows), fglui-token-flow-select(tail(rows), publisher, flowId)) else fglui-token-flow-select(tail(rows), publisher, flowId);
        def fglui-token-flow-samples(rows) {
            let all = fglui-token-flow-all(rows);
            let latest = fglui-token-flow-latest(all, list());
            if ((Comparable) len(latest) == 0) then list() else fglui-token-flow-select(all, fgtm-sample-source(latest), fgtm-sample-lane(latest));
        }
        def fglui-token-flow-present?(rows) {
            let selected = fglui-token-flow-samples(rows);
            if ((Comparable) len(selected) == 0) then 0 else if ((Comparable) len(fglui-flow-stage-sample-selected(selected, "token")) == 0) then 0 else 1;
        }
        def fglui-token-flow-all-physical?(rows) = if ((Comparable) len(rows) == 0) then 0 else if (!((String) fgtm-sample-evidence(head(rows)) == "physical-live")) then 0 else if ((Comparable) len(tail(rows)) == 0) then 1 else fglui-token-flow-all-physical?(tail(rows));
        def fglui-flow-stage-kind(stage) = if ((String) stage == "request") then "request" else if ((String) stage == "token") then "token-position" else if ((String) stage == "layer") then "layer" else if ((String) stage == "tensor") then "tensor" else if ((String) stage == "expert") then "expert-route" else if ((String) stage == "metal") then "metal" else if ((String) stage == "framebuffer") then "framebuffer" else "glass-flow";
        def fglui-flow-stage-sample-selected(rows, stage) = if ((Comparable) len(rows) == 0) then list() else if ((String) fgtm-sample-kind(head(rows)) == fglui-flow-stage-kind(stage)) then head(rows) else fglui-flow-stage-sample-selected(tail(rows), stage);
        def fglui-flow-stage-sample(rows, stage) = fglui-flow-stage-sample-selected(fglui-token-flow-samples(rows), stage);
        def fglui-token-flow-letter(kind) = if ((String) kind == "request") then "Q" else if ((String) kind == "token-position") then "T" else if ((String) kind == "layer") then "L" else if ((String) kind == "tensor") then "X" else if ((String) kind == "expert-route") then "E" else if ((String) kind == "metal") then "M" else if ((String) kind == "framebuffer") then "F" else "G";
        def fglui-channel-with-prefix(channels, prefix) = if ((Comparable) len(channels) == 0) then "absent" else if ((Comparable) str_find(head(channels), prefix, 0) == 0) then substring(head(channels), str_len(prefix), str_len(head(channels))) else fglui-channel-with-prefix(tail(channels), prefix);
        def fglui-token-flow-model(sample) = fglui-channel-with-prefix(fgtm-sample-channels(sample), "model.");
        def fglui-token-flow-category(sample) = fglui-channel-with-prefix(fgtm-sample-channels(sample), "category.");
        def fglui-token-flow-family(sample) = fglui-channel-with-prefix(fgtm-sample-channels(sample), "family.");
        def fglui-token-flow-role(sample) = fglui-channel-with-prefix(fgtm-sample-channels(sample), "role.");
        def fglui-token-flow-type(sample) = fglui-channel-with-prefix(fgtm-sample-channels(sample), "type.");
        def fglui-token-flow-category-text(sample) = fgd-cat(list("CELL=", fgtm-sample-id(sample), " CAT=", fglui-token-flow-category(sample), " FAM=", fglui-token-flow-family(sample), " ROLE=", fglui-token-flow-role(sample), " TYPE=", fglui-token-flow-type(sample)));
        def fglui-token-flow-display-model(sample) {
            let modelId = str_concat("model.", fglui-token-flow-model(sample));
            if ((String) modelId == FGLUIQwenOwnerParent()) then fglui-owner-token-model-name(FGLUIQwenOwnerParent()) else if ((String) modelId == FGLUIThreeBOwnerParent()) then fglui-owner-token-model-name(FGLUIThreeBOwnerParent()) else fglui-token-flow-model(sample);
        }
        def fglui-token-flow-us(value) = tg-dur-us(value);
        def fglui-token-flow-present-number(field, prefix) = if ((Comparable) fgtm-field-present?(field) == 1) then str_concat(prefix, int_to_str(fgtm-field-value(field))) else "abs";
        def fglui-token-flow-value(sample) = if ((String) fgtm-sample-kind(sample) == "request") then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "seq=") else if ((String) fgtm-sample-kind(sample) == "token-position") then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "pos=") else if ((String) fgtm-sample-kind(sample) == "layer") then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "layer=") else if ((String) fgtm-sample-kind(sample) == "tensor") then if ((Comparable) fgtm-field-present?(fgtm-sample-bytes(sample)) == 1) then fgd-format-bytes(fgtm-field-value(fgtm-sample-bytes(sample))) else fgtm-sample-purpose(sample) else if ((String) fgtm-sample-kind(sample) == "expert-route") then if ((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1) then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "expert=") else str_concat("route=", fgtm-sample-purpose(sample)) else if ((String) fgtm-sample-kind(sample) == "metal") then if ((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1) then str_concat("dur=", fglui-token-flow-us(fgtm-field-value(fgtm-sample-capacity(sample)))) else fgtm-sample-purpose(sample) else if ((String) fgtm-sample-kind(sample) == "framebuffer") then if ((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1) then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "fb=") else str_concat("sink=", fgtm-sample-purpose(sample)) else fglui-token-flow-present-number(fgtm-sample-capacity(sample), "seq=");
        def fglui-token-flow-compact-value(sample) = if ((String) fgtm-sample-kind(sample) == "request") then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "s") else if ((String) fgtm-sample-kind(sample) == "token-position") then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "p") else if ((String) fgtm-sample-kind(sample) == "layer") then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "l") else if ((String) fgtm-sample-kind(sample) == "tensor") then if ((Comparable) fgtm-field-present?(fgtm-sample-bytes(sample)) == 1) then fgd-format-bytes(fgtm-field-value(fgtm-sample-bytes(sample))) else fgtm-sample-purpose(sample) else if ((String) fgtm-sample-kind(sample) == "expert-route") then if ((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1) then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "e") else "top10" else if ((String) fgtm-sample-kind(sample) == "metal") then if ((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1) then fglui-token-flow-us(fgtm-field-value(fgtm-sample-capacity(sample))) else "pipe" else if ((String) fgtm-sample-kind(sample) == "framebuffer") then if ((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1) then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "f") else "snap" else fglui-token-flow-present-number(fgtm-sample-capacity(sample), "s");
        def fglui-token-flow-duration-bytes(value) = fgdb-text(fglui-token-flow-us(value));
        def fglui-token-flow-number-bytes(field, prefix) = if ((Comparable) fgtm-field-present?(field) == 1) then fgdb-cat(list(fgdb-text(prefix), fgdb-int(fgtm-field-value(field)))) else fgdb-text("?");
        def fglui-token-flow-compact-bytes(sample) = if ((String) fgtm-sample-kind(sample) == "request") then fglui-token-flow-number-bytes(fgtm-sample-capacity(sample), "s") else if ((String) fgtm-sample-kind(sample) == "token-position") then fglui-token-flow-number-bytes(fgtm-sample-capacity(sample), "p") else if ((String) fgtm-sample-kind(sample) == "layer") then fglui-token-flow-number-bytes(fgtm-sample-capacity(sample), "l") else if ((String) fgtm-sample-kind(sample) == "tensor") then if ((Comparable) fgtm-field-present?(fgtm-sample-bytes(sample)) == 1) then fgdb-format-bytes(fgtm-field-value(fgtm-sample-bytes(sample))) else fgdb-text("tensor") else if ((String) fgtm-sample-kind(sample) == "expert-route") then if ((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1) then fglui-token-flow-number-bytes(fgtm-sample-capacity(sample), "e") else fgdb-text("top10") else if ((String) fgtm-sample-kind(sample) == "metal") then if ((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1) then fglui-token-flow-duration-bytes(fgtm-field-value(fgtm-sample-capacity(sample))) else fgdb-text("pipe") else if ((String) fgtm-sample-kind(sample) == "framebuffer") then fgdb-text("snap") else fglui-token-flow-number-bytes(fgtm-sample-capacity(sample), "s");
        def fglui-token-flow-atom-bytes(sample) = fgdb-cat(list(fgdb-text(fglui-token-flow-letter(fgtm-sample-kind(sample))), fgdb-text(fgd-truth-symbol(fgtm-sample-evidence(sample))), fglui-token-flow-compact-bytes(sample)));
        def fglui-token-flow-chain-bytes(rows) = if ((Comparable) len(rows) == 0) then list() else if ((Comparable) len(tail(rows)) == 0) then fglui-token-flow-atom-bytes(head(rows)) else fgdb-cat(list(fglui-token-flow-atom-bytes(head(rows)), fgdb-text(" > "), fglui-token-flow-chain-bytes(tail(rows))));
        def fglui-token-flow-identity-line(rows, epoch, width) {
            let first = head(rows);
            fgd-byte-segment-line(fgdb-cat(list(fgdb-text("MODEL "), fgdb-text(fglui-token-flow-display-model(first)), fgdb-text("  owner="), fgdb-text(fgtm-sample-owner(first)))), width, fgd-sample-style(first, epoch), fgtm-sample-id(first), fgtm-sample-channels(first), fgtm-sample-evidence(first));
        }
        def fglui-token-flow-pipeline-line(rows, epoch, width) {
            let first = head(rows);
            fgd-byte-segment-line(fglui-token-flow-chain-bytes(rows), width, fgd-sample-style(first, epoch), fgtm-sample-id(first), fgtm-sample-channels(first), fgtm-sample-evidence(first));
        }
        def fglui-token-flow-value-bytes(sample) = if ((String) fgtm-sample-kind(sample) == "request") then fglui-token-flow-number-bytes(fgtm-sample-capacity(sample), "seq=") else if ((String) fgtm-sample-kind(sample) == "token-position") then fglui-token-flow-number-bytes(fgtm-sample-capacity(sample), "pos=") else if ((String) fgtm-sample-kind(sample) == "layer") then fglui-token-flow-number-bytes(fgtm-sample-capacity(sample), "layer=") else if ((String) fgtm-sample-kind(sample) == "tensor") then if ((Comparable) fgtm-field-present?(fgtm-sample-bytes(sample)) == 1) then fgdb-format-bytes(fgtm-field-value(fgtm-sample-bytes(sample))) else fgdb-text("tensor") else if ((String) fgtm-sample-kind(sample) == "expert-route") then if ((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1) then fglui-token-flow-number-bytes(fgtm-sample-capacity(sample), "expert=") else fgdb-text("top10") else if ((String) fgtm-sample-kind(sample) == "metal") then if ((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1) then fgdb-cat(list(fgdb-text("dur="), fglui-token-flow-duration-bytes(fgtm-field-value(fgtm-sample-capacity(sample))))) else fgdb-text("pipeline") else if ((String) fgtm-sample-kind(sample) == "framebuffer") then fgdb-text("snapshot") else fglui-token-flow-number-bytes(fgtm-sample-capacity(sample), "seq=");
        def fglui-token-flow-age-bytes(sample, epoch) {
            let latest = fgd-sample-latest(sample);
            if (latest < 0) then fgdb-text("?") else if (epoch >= latest) then fgdb-format-age-ms((epoch - latest)) else fgdb-text("skew");
        }
        def fglui-token-flow-header-line(width) {
            let purposeWidth = fgd-max(8, (width - 66));
            let bytes = fgdb-cat(list(fgdb-pad-right(fgdb-text("KT"), 3), fgdb-text(" "), fgdb-pad-right(fgdb-text("CELL"), 12), fgdb-text(" "), fgdb-pad-right(fgdb-text("PLANE"), 8), fgdb-text(" "), fgdb-pad-right(fgdb-text("VALUE"), 16), fgdb-text(" "), fgdb-pad-right(fgdb-text("PURPOSE"), purposeWidth), fgdb-text(" "), fgdb-pad-left(fgdb-text("AGE"), 7), fgdb-text(" "), fgdb-text("EVIDENCE")));
            fgd-byte-segment-line(bytes, width, fgd-neutral(176), "flow.columns", list("flow", "token-flow"), "declared");
        }
        def fglui-token-flow-line(sample, epoch, width) {
            let purposeWidth = fgd-max(8, (width - 66));
            let kt = fgdb-cat(list(fgdb-text(fglui-token-flow-letter(fgtm-sample-kind(sample))), fgdb-text(fgd-truth-symbol(fgtm-sample-evidence(sample)))));
            let bytes = fgdb-cat(list(fgdb-pad-right(kt, 3), fgdb-text(" "), fgdb-pad-right(fgdb-text(fgtm-sample-id(sample)), 12), fgdb-text(" "), fgdb-pad-right(fgdb-text(fgtm-sample-plane(sample)), 8), fgdb-text(" "), fgdb-pad-right(fglui-token-flow-value-bytes(sample), 16), fgdb-text(" "), fgdb-pad-right(fgdb-text(fgtm-sample-purpose(sample)), purposeWidth), fgdb-text(" "), fgdb-pad-left(fglui-token-flow-age-bytes(sample, epoch), 7), fgdb-text(" "), fgdb-text(fgtm-sample-evidence(sample))));
            fgd-byte-segment-line(bytes, width, fgd-sample-style(sample, epoch), fgtm-sample-selection-id(sample), fgtm-sample-channels(sample), fgtm-sample-evidence(sample));
        }
        def fglui-token-flow-category-line(sample, epoch, width) = fgd-segment-line(fglui-token-flow-category-text(sample), width, fgd-sample-style(sample, epoch), fgtm-sample-selection-id(sample), fgtm-sample-channels(sample), fgtm-sample-evidence(sample));
        def fglui-token-flow-lines-go(rows, epoch, width, remaining) = if ((remaining <= 0) || ((Comparable) len(rows) == 0)) then list() else cons(fglui-token-flow-line(head(rows), epoch, width), fglui-token-flow-lines-go(tail(rows), epoch, width, (remaining - 1)));
        def fglui-owner-token-parent(sample) = if ((Comparable) fgtm-field-present?(fgtm-sample-parent(sample)) == 1) then fgtm-field-value(fgtm-sample-parent(sample)) else "absent";
        def fglui-owner-token-parent?(parent) = if ((String) parent == FGLUIQwenOwnerParent()) then 1 else if ((String) parent == FGLUIThreeBOwnerParent()) then 1 else 0;
        def fglui-owner-token-candidate?(sample, parent) = if (!((String) fgtm-sample-kind(sample) == "token-position")) then 0 else if (!((String) fglui-owner-token-parent(sample) == parent)) then 0 else if (!((Comparable) fglui-owner-token-parent?(parent) == 1)) then 0 else if (!((String) fgtm-sample-owner(sample) == parent)) then 0 else if (!((String) fgtm-sample-purpose(sample) == "context-position")) then 0 else if (!((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1)) then 0 else if (!((Comparable) fgtm-field-present?(fgtm-sample-handle(sample)) == 1)) then 0 else (fgtm-field-value(fgtm-sample-handle(sample)) > 0);
        def fglui-owner-token-newer(a, b) = if ((Comparable) len(a) == 0) then b else if (fglui-token-flow-epoch(b) > fglui-token-flow-epoch(a)) then b else a;
        def fglui-owner-token-for-parent(rows, parent, held) = if ((Comparable) len(rows) == 0) then held else if ((Comparable) fglui-owner-token-candidate?(head(rows), parent) == 1) then fglui-owner-token-for-parent(tail(rows), parent, fglui-owner-token-newer(held, head(rows))) else fglui-owner-token-for-parent(tail(rows), parent, held);
        def fglui-owner-token-fallback-samples(rows) {
            let qwen = fglui-owner-token-for-parent(rows, FGLUIQwenOwnerParent(), list());
            let threeb = fglui-owner-token-for-parent(rows, FGLUIThreeBOwnerParent(), list());
            append(if ((Comparable) len(qwen) == 0) then list() else list(qwen), if ((Comparable) len(threeb) == 0) then list() else list(threeb));
        }
        def fglui-owner-token-model-name(parent) = if ((String) parent == FGLUIQwenOwnerParent()) then "Qwen3.8-Flash-Next UD-Q2_K_XL (Unsloth)" else if ((String) parent == FGLUIThreeBOwnerParent()) then "Llama-3.2-3B-Instruct" else "unrecognized-model-parent";
        def fglui-owner-token-position(sample) = if ((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1) then int_to_str(fgtm-field-value(fgtm-sample-capacity(sample))) else "unavailable";
        // The sample id is already a stable producer id. Reuse it as the
        // interactive node id rather than interning a new per-frame selector.
        // Only position and age vary; model identity and the hollow seam ids do not.
        def fglui-owner-token-node-id(sample) = fgtm-sample-id(sample);
        def fglui-owner-token-gap-node(sample) = if ((String) fglui-owner-token-parent(sample) == FGLUIQwenOwnerParent()) then FGLUIQwenOwnerGapNode() else FGLUIThreeBOwnerGapNode();
        def fglui-owner-token-channels(sample) = append(list("flow", "owner-token-fallback"), fgtm-sample-channels(sample));
        def fglui-owner-token-identity-line(sample, epoch, width) = fgd-segment-line(fgd-cat(list("T model=", fglui-owner-token-model-name(fglui-owner-token-parent(sample)), " pos=", fglui-owner-token-position(sample))), width, fgd-sample-style(sample, epoch), fglui-owner-token-node-id(sample), fglui-owner-token-channels(sample), fgtm-sample-evidence(sample));
        def fglui-owner-token-id-line(sample, epoch, width) = fgd-segment-line(str_concat("id=", fgtm-sample-id(sample)), width, fgd-sample-style(sample, epoch), fglui-owner-token-node-id(sample), fglui-owner-token-channels(sample), fgtm-sample-evidence(sample));
        def fglui-owner-token-parent-line(sample, epoch, width) = fgd-segment-line(str_concat("parent=", fglui-owner-token-parent(sample)), width, fgd-sample-style(sample, epoch), fglui-owner-token-node-id(sample), fglui-owner-token-channels(sample), fgtm-sample-evidence(sample));
        def fglui-owner-token-scope-line(sample, epoch, width) = fgd-segment-line(fgd-cat(list("scope=", fgtm-sample-lane(sample), "/", fgtm-sample-purpose(sample), " impact=context-position-only")), width, fgd-sample-style(sample, epoch), fglui-owner-token-node-id(sample), fglui-owner-token-channels(sample), fgtm-sample-evidence(sample));
        def fglui-owner-token-evidence-line(sample, epoch, width) = fgd-segment-line(fgd-cat(list(fgd-sample-age-text(sample, epoch), " evidence=", fgtm-sample-evidence(sample))), width, fgd-sample-style(sample, epoch), fglui-owner-token-node-id(sample), fglui-owner-token-channels(sample), fgtm-sample-evidence(sample));
        def fglui-owner-token-gap-line(sample, width) = fgd-segment-line("downstream L?-- > X?-- > E?-- > M?-- > F?-- (no explicit token-flow)", width, fgd-neutral(72), fglui-owner-token-gap-node(sample), list("flow", "owner-token-fallback", "layer", "tensor", "expert", "metal", "framebuffer"), "unavailable");
        def fglui-owner-token-fallback-lines-go(rows, epoch, width) = if ((Comparable) len(rows) == 0) then list() else append(list(fglui-owner-token-identity-line(head(rows), epoch, width), fglui-owner-token-id-line(head(rows), epoch, width), fglui-owner-token-parent-line(head(rows), epoch, width), fglui-owner-token-scope-line(head(rows), epoch, width), fglui-owner-token-evidence-line(head(rows), epoch, width), fglui-owner-token-gap-line(head(rows), width)), fglui-owner-token-fallback-lines-go(tail(rows), epoch, width));
        def fglui-owner-token-fallback-lines(rows, epoch, width) {
            let positions = fglui-owner-token-fallback-samples(rows);
            if ((Comparable) len(positions) == 0) then list() else cons(fgd-title-segment-line("OWNER TOKEN POSITIONS (explicit runtime token-flow absent)", width, "flow.owner-token-fallback"), fglui-owner-token-fallback-lines-go(positions, epoch, width));
        }
        def fglui-token-flow-lines(rows, epoch, width) {
            let explicit = fglui-token-flow-samples(rows);
            if (len(explicit) > 0) then append(list(fglui-token-flow-identity-line(explicit, epoch, width), fglui-token-flow-pipeline-line(explicit, epoch, width), fglui-token-flow-category-line(head(explicit), epoch, width), fglui-token-flow-header-line(width)), fglui-token-flow-lines-go(explicit, epoch, width, 8)) else fglui-owner-token-fallback-lines(rows, epoch, width);
        }
    }
    0;
}
