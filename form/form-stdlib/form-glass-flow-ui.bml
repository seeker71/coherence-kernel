//////////////////////////////////////////////////////////////////////
//
// form-glass-flow-ui.bml — bounded observed-frame flow shard.
//
// Authority: form-stdlib/bml/form-glass-live-ui.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-terminal-canvas.bml form/form-stdlib/form-glass-dashboard.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassFlowUI {
        field FGLFlowShardSchema = "form-glass-flow-ui-v1";
        field FGLUIQwenOwnerParent = "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth";
        field FGLUIThreeBOwnerParent = "model.llama-3.2-3b-instruct";
        field FGLUIDiagnosticFlowPublisher = "model-flow-fixture";
        field FGLUIDiagnosticFlowOwner = "bounded-probe";
        field FGLUIQwenOwnerGapNode = "seam.owner-token-downstream.qwen38";
        field FGLUIThreeBOwnerGapNode = "seam.owner-token-downstream.llama32-3b";

        // Cumulative counters occupy indexes 2, 3, 4, and 6. Gauges occupy
        // 5, 7, 8, and 9. V2 appends the visible-node phase census, token
        // positions, tensor bytes, channel-tag memberships, and framebuffer accepts at
        // 10..16. A negative value is unavailable; zero is measured.
        def fgd-flow-point(epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight) = list("glass-flow-point-v1", epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight);
        def fgd-flow-point-v2(epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight, gas, water, ice, tokens, tensorBytes, channelEdges, framebufferAccepted) = list("glass-flow-point-v2", epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight, gas, water, ice, tokens, tensorBytes, channelEdges, framebufferAccepted);
        // V3 retains one evidence class for every value at indexes 2..16.
        // Older points remain readable but can only be called derived windows:
        // their integer payload did not retain the source truth class.
        def fgd-flow-point-v3(epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight, gas, water, ice, tokens, tensorBytes, channelEdges, framebufferAccepted, evidences) = append(fgd-flow-point-v2(epoch, gpuBusy, cpuJit, dispatches, queueDepth, jitCalls, cells, memoryFree, inflight, gas, water, ice, tokens, tensorBytes, channelEdges, framebufferAccepted), list(evidences));
        def fgd-flow-value(point, index) = if or(lt(index, 0), ge(index, len(point))) then -1 else nth(point, index);
        def fgd-flow-evidences(point) = if ge(len(point), 18) then nth(point, 17) else list();
        def fgd-flow-evidence(point, index) {
            let value = fgd-flow-value(point, index);
            let evidences = fgd-flow-evidences(point);
            let offset = sub(index, 2);
            if lt(value, 0) then "unavailable" else if or(lt(offset, 0), ge(offset, len(evidences))) then "derived-window" else nth(evidences, offset);
        }
        def fglui-good(value) = if lt(value, 0) then 0 else value;
        def fglui-values(history, index) = if eq(len(history), 0) then list() else cons(fgd-flow-value(head(history), index), fglui-values(tail(history), index));
        def fglui-good-values(values) = if eq(len(values), 0) then list() else cons(fglui-good(head(values)), fglui-good-values(tail(values)));
        def fglui-deltas-next(history, index, prior) {
            let value = fgd-flow-value(head(history), index);
            let delta = if or(lt(value, 0), lt(prior, 0)) then -1 else if ge(value, prior) then sub(value, prior) else 0;
            cons(delta, fglui-deltas-go(tail(history), index, value));
        }
        def fglui-deltas-go(history, index, prior) = if eq(len(history), 0) then list() else fglui-deltas-next(history, index, prior);
        def fglui-deltas(history, index) = if eq(len(history), 0) then list() else cons(if lt(fgd-flow-value(head(history), index), 0) then -1 else 0, fglui-deltas-go(tail(history), index, fgd-flow-value(head(history), index)));
        def fglui-missing(history, index) = if eq(len(history), 0) then 0 else add(if lt(fgd-flow-value(head(history), index), 0) then 1 else 0, fglui-missing(tail(history), index));
        def fglui-last(history, index) = if eq(len(history), 0) then -1 else fgd-flow-value(nth(history, sub(len(history), 1)), index);
        def fglui-last-n(values, width) = if le(len(values), width) then values else fgd-drop(values, sub(len(values), width));
        def fglui-glyphs(values, levels) = if eq(len(levels), 0) then "" else str_concat(if lt(head(values), 0) then "?" else ftc-spark-glyph(head(levels)), fglui-glyphs(tail(values), tail(levels)));
        def fglui-spark(values, width) {
            let visible = fglui-last-n(values, fgd-max(1, width));
            fglui-glyphs(visible, ftc-series-normalize(fglui-good-values(visible)));
        }
        def fglui-value(value) = if lt(value, 0) then "unavailable(no-carrier)" else fgd-format-count(value);
        def fglui-pad2(value) = if lt(value, 10) then str_concat("0", int_to_str(value)) else int_to_str(value);
        def fglui-pad3(value) = if lt(value, 10) then str_concat("00", int_to_str(value)) else if lt(value, 100) then str_concat("0", int_to_str(value)) else int_to_str(value);
        def fglui-utc-clock(epoch) {
            let day = mod(epoch, 86400000);
            let hour = div(day, 3600000);
            let minute = div(mod(day, 3600000), 60000);
            let second = div(mod(day, 60000), 1000);
            fgd-cat(list(fglui-pad2(hour), ":", fglui-pad2(minute), ":", fglui-pad2(second), ".", fglui-pad3(mod(day, 1000)), "Z"));
        }
        def fglui-frame-delta(history) = if lt(len(history), 2) then 0 else if ge(fgd-flow-value(nth(history, sub(len(history), 1)), 1), fgd-flow-value(nth(history, sub(len(history), 2)), 1)) then sub(fgd-flow-value(nth(history, sub(len(history), 1)), 1), fgd-flow-value(nth(history, sub(len(history), 2)), 1)) else 0;
        def fglui-metric-count(metrics, id) {
            let metric = fgd-find-metric(metrics, id);
            if or(eq(len(metric), 0), eq(fgo-present?(metric), 0)) then -1 else fgo-int-value(metric);
        }
        def fglui-pulse-line(epoch, hz, frame, history, metrics, width) {
            let dispatchValues = fglui-deltas(history, 4);
            let dispatch = if eq(len(dispatchValues), 0) then -1 else nth(dispatchValues, sub(len(dispatchValues), 1));
            let events = fglui-metric-count(metrics, "events");
            let nodes = fglui-metric-count(metrics, "cells");
            let cons = fglui-metric-count(metrics, "cons");
            fgd-segment-line(fgd-cat(list("TICK ", fglui-utc-clock(epoch), " #", int_to_str(frame), " dt=", int_to_str(fglui-frame-delta(history)), "/", int_to_str(div(1000, hz)), "ms d+", fglui-value(dispatch), " ev=", fglui-value(events), " nodes=", fglui-value(nodes), " cons=", fglui-value(cons), " [glass]")), width, fgd-style-for-plane("form", 220, 0), "flow.tick", list("flow", "form", "framebuffer", "cell"), "physical-live");
        }
        def fglui-flow-line(label, history, index, delta, width, plane) {
            let values = if eq(delta, 1) then fglui-deltas(history, index) else fglui-values(history, index);
            let missing = fglui-missing(history, index);
            let latest = if eq(delta, 1) then if eq(len(values), 0) then -1 else nth(values, sub(len(values), 1)) else fglui-last(history, index);
            let sparkWidth = fgd-clamp(sub(width, add(str_len(label), 29)), 4, 64);
            fgd-segment-line(fgd-cat(list(label, " ", fglui-spark(values, sparkWidth), " now=", if and(gt(len(history), 0), lt(missing, len(history))) then fglui-value(latest) else "unavailable(no-carrier)", if gt(missing, 0) then str_concat(" miss=", int_to_str(missing)) else "")), width, fgd-style-for-plane(plane, if and(gt(len(history), 0), lt(missing, len(history))) then 176 else 72, 0), str_concat("flow.", label), list("flow", plane), if and(gt(len(history), 0), lt(missing, len(history))) then "derived-window" else "unavailable");
        }
        def fglui-flow-lines(history, width) = list(fglui-flow-line("GPU", history, 2, 1, width, "metal"), fglui-flow-line("CPU-JIT", history, 3, 1, width, "cpu"), fglui-flow-line("DISPATCH", history, 4, 1, width, "form"), fglui-flow-line("QUEUE", history, 5, 0, width, "membrane"));

        // Exact token-flow publications are separate from aggregate counters.
        // A projected sample retains producer publisher in owner and flow id in
        // lane. Select that pair before looking up any stage so two concurrent
        // flows can never be spliced into one visual pipeline.
        def fglui-token-flow-channel?(sample) = fgd-has-channel(fgtm-sample-channels(sample), "token-flow");
        def fglui-token-flow-diagnostic?(sample) = if not(eq(fglui-token-flow-channel?(sample), 1)) then 0 else if str_eq(fgtm-sample-source(sample), FGLUIDiagnosticFlowPublisher()) then 1 else if str_eq(fgtm-sample-owner(sample), FGLUIDiagnosticFlowOwner()) then 1 else 0;
        def fglui-token-flow-primary?(sample) = if not(eq(fglui-token-flow-channel?(sample), 1)) then 0 else if eq(fglui-token-flow-diagnostic?(sample), 1) then 0 else 1;
        def fglui-token-flow-all(rows) = if eq(len(rows), 0) then list() else if eq(fglui-token-flow-primary?(head(rows)), 1) then cons(head(rows), fglui-token-flow-all(tail(rows))) else fglui-token-flow-all(tail(rows));
        def fglui-token-flow-diagnostics(rows) = if eq(len(rows), 0) then list() else if eq(fglui-token-flow-diagnostic?(head(rows)), 1) then cons(head(rows), fglui-token-flow-diagnostics(tail(rows))) else fglui-token-flow-diagnostics(tail(rows));
        def fglui-token-flow-epoch(sample) = if eq(fgtm-field-present?(fgtm-sample-write-epoch(sample)), 1) then fgtm-field-value(fgtm-sample-write-epoch(sample)) else -1;
        def fglui-token-flow-newer(a, b) = if eq(len(a), 0) then b else if gt(fglui-token-flow-epoch(b), fglui-token-flow-epoch(a)) then b else a;
        def fglui-token-flow-latest(rows, held) = if eq(len(rows), 0) then held else fglui-token-flow-latest(tail(rows), fglui-token-flow-newer(held, head(rows)));
        def fglui-token-flow-key-matches?(sample, publisher, flowId) = if not(str_eq(fgtm-sample-source(sample), publisher)) then 0 else str_eq(fgtm-sample-lane(sample), flowId);
        def fglui-token-flow-select(rows, publisher, flowId) = if eq(len(rows), 0) then list() else if eq(fglui-token-flow-key-matches?(head(rows), publisher, flowId), 1) then cons(head(rows), fglui-token-flow-select(tail(rows), publisher, flowId)) else fglui-token-flow-select(tail(rows), publisher, flowId);
        def fglui-token-flow-samples(rows) {
            let all = fglui-token-flow-all(rows);
            let latest = fglui-token-flow-latest(all, list());
            if eq(len(latest), 0) then list() else fglui-token-flow-select(all, fgtm-sample-source(latest), fgtm-sample-lane(latest));
        }
        def fglui-token-flow-present?(rows) = if gt(len(fglui-token-flow-samples(rows)), 0) then 1 else 0;
        def fglui-token-flow-all-physical?(rows) = if eq(len(rows), 0) then 0 else if not(str_eq(fgtm-sample-evidence(head(rows)), "physical-live")) then 0 else if eq(len(tail(rows)), 0) then 1 else fglui-token-flow-all-physical?(tail(rows));
        def fglui-flow-stage-kind(stage) = if str_eq(stage, "request") then "request" else if str_eq(stage, "token") then "token-position" else if str_eq(stage, "layer") then "layer" else if str_eq(stage, "tensor") then "tensor" else if str_eq(stage, "expert") then "expert-route" else if str_eq(stage, "metal") then "metal" else if str_eq(stage, "framebuffer") then "framebuffer" else "glass-flow";
        def fglui-flow-stage-sample-selected(rows, stage) = if eq(len(rows), 0) then list() else if str_eq(fgtm-sample-kind(head(rows)), fglui-flow-stage-kind(stage)) then head(rows) else fglui-flow-stage-sample-selected(tail(rows), stage);
        def fglui-flow-stage-sample(rows, stage) = fglui-flow-stage-sample-selected(fglui-token-flow-samples(rows), stage);
        def fglui-token-flow-letter(kind) = if str_eq(kind, "request") then "Q" else if str_eq(kind, "token-position") then "T" else if str_eq(kind, "layer") then "L" else if str_eq(kind, "tensor") then "X" else if str_eq(kind, "expert-route") then "E" else if str_eq(kind, "metal") then "M" else if str_eq(kind, "framebuffer") then "F" else "G";
        def fglui-channel-with-prefix(channels, prefix) = if eq(len(channels), 0) then "absent" else if eq(str_find(head(channels), prefix, 0), 0) then substring(head(channels), str_len(prefix), str_len(head(channels))) else fglui-channel-with-prefix(tail(channels), prefix);
        def fglui-token-flow-model(sample) = fglui-channel-with-prefix(fgtm-sample-channels(sample), "model.");
        def fglui-token-flow-us(value) = if lt(value, 1000) then str_concat(int_to_str(value), "us") else if lt(value, 1000000) then str_concat(int_to_str(div(value, 1000)), "ms") else str_concat(int_to_str(div(value, 1000000)), "s");
        def fglui-token-flow-present-number(field, prefix) = if eq(fgtm-field-present?(field), 1) then str_concat(prefix, int_to_str(fgtm-field-value(field))) else "abs";
        def fglui-token-flow-value(sample) = if str_eq(fgtm-sample-kind(sample), "request") then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "seq=") else if str_eq(fgtm-sample-kind(sample), "token-position") then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "pos=") else if str_eq(fgtm-sample-kind(sample), "layer") then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "layer=") else if str_eq(fgtm-sample-kind(sample), "tensor") then if eq(fgtm-field-present?(fgtm-sample-bytes(sample)), 1) then fgd-format-bytes(fgtm-field-value(fgtm-sample-bytes(sample))) else "abs" else if str_eq(fgtm-sample-kind(sample), "expert-route") then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "expert=") else if str_eq(fgtm-sample-kind(sample), "metal") then if eq(fgtm-field-present?(fgtm-sample-capacity(sample)), 1) then str_concat("dur=", fglui-token-flow-us(fgtm-field-value(fgtm-sample-capacity(sample)))) else "abs" else if str_eq(fgtm-sample-kind(sample), "framebuffer") then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "fb=") else fglui-token-flow-present-number(fgtm-sample-capacity(sample), "seq=");
        def fglui-token-flow-compact-value(sample) = if str_eq(fgtm-sample-kind(sample), "request") then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "s") else if str_eq(fgtm-sample-kind(sample), "token-position") then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "p") else if str_eq(fgtm-sample-kind(sample), "layer") then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "l") else if str_eq(fgtm-sample-kind(sample), "tensor") then if eq(fgtm-field-present?(fgtm-sample-bytes(sample)), 1) then fgd-format-bytes(fgtm-field-value(fgtm-sample-bytes(sample))) else "abs" else if str_eq(fgtm-sample-kind(sample), "expert-route") then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "e") else if str_eq(fgtm-sample-kind(sample), "metal") then if eq(fgtm-field-present?(fgtm-sample-capacity(sample)), 1) then fglui-token-flow-us(fgtm-field-value(fgtm-sample-capacity(sample))) else "abs" else if str_eq(fgtm-sample-kind(sample), "framebuffer") then fglui-token-flow-present-number(fgtm-sample-capacity(sample), "f") else fglui-token-flow-present-number(fgtm-sample-capacity(sample), "s");
        def fglui-token-flow-line(sample, epoch, width) = fgd-segment-line(fgd-cat(list(fglui-token-flow-letter(fgtm-sample-kind(sample)), " model=", fglui-token-flow-model(sample), " owner=", fgtm-sample-owner(sample), " publisher=", fgtm-sample-source(sample), " flow=", fgtm-sample-lane(sample), " node=", fgtm-sample-id(sample), " ", fglui-token-flow-value(sample), " detail=", fgtm-sample-purpose(sample), " ", fgd-sample-age-text(sample, epoch), " ev=", fgtm-sample-evidence(sample))), width, fgd-sample-style(sample, epoch), fgtm-sample-selection-id(sample), fgtm-sample-channels(sample), fgtm-sample-evidence(sample));
        def fglui-token-flow-lines-go(rows, epoch, width, remaining) = if or(le(remaining, 0), eq(len(rows), 0)) then list() else cons(fglui-token-flow-line(head(rows), epoch, width), fglui-token-flow-lines-go(tail(rows), epoch, width, sub(remaining, 1)));
        def fglui-owner-token-parent(sample) = if eq(fgtm-field-present?(fgtm-sample-parent(sample)), 1) then fgtm-field-value(fgtm-sample-parent(sample)) else "absent";
        def fglui-owner-token-parent?(parent) = if str_eq(parent, FGLUIQwenOwnerParent()) then 1 else if str_eq(parent, FGLUIThreeBOwnerParent()) then 1 else 0;
        def fglui-owner-token-candidate?(sample, parent) = if not(str_eq(fgtm-sample-kind(sample), "token-position")) then 0 else if not(str_eq(fglui-owner-token-parent(sample), parent)) then 0 else if not(eq(fglui-owner-token-parent?(parent), 1)) then 0 else if not(str_eq(fgtm-sample-owner(sample), parent)) then 0 else if not(str_eq(fgtm-sample-purpose(sample), "context-position")) then 0 else if not(eq(fgtm-field-present?(fgtm-sample-capacity(sample)), 1)) then 0 else if not(eq(fgtm-field-present?(fgtm-sample-handle(sample)), 1)) then 0 else gt(fgtm-field-value(fgtm-sample-handle(sample)), 0);
        def fglui-owner-token-newer(a, b) = if eq(len(a), 0) then b else if gt(fglui-token-flow-epoch(b), fglui-token-flow-epoch(a)) then b else a;
        def fglui-owner-token-for-parent(rows, parent, held) = if eq(len(rows), 0) then held else if eq(fglui-owner-token-candidate?(head(rows), parent), 1) then fglui-owner-token-for-parent(tail(rows), parent, fglui-owner-token-newer(held, head(rows))) else fglui-owner-token-for-parent(tail(rows), parent, held);
        def fglui-owner-token-fallback-samples(rows) {
            let qwen = fglui-owner-token-for-parent(rows, FGLUIQwenOwnerParent(), list());
            let threeb = fglui-owner-token-for-parent(rows, FGLUIThreeBOwnerParent(), list());
            append(if eq(len(qwen), 0) then list() else list(qwen), if eq(len(threeb), 0) then list() else list(threeb));
        }
        def fglui-owner-token-model-name(parent) = if str_eq(parent, FGLUIQwenOwnerParent()) then "Qwen3.8-Flash-Next UD-Q2_K_XL (Unsloth)" else if str_eq(parent, FGLUIThreeBOwnerParent()) then "Llama-3.2-3B-Instruct" else "unrecognized-model-parent";
        def fglui-owner-token-position(sample) = if eq(fgtm-field-present?(fgtm-sample-capacity(sample)), 1) then int_to_str(fgtm-field-value(fgtm-sample-capacity(sample))) else "unavailable";
        // The sample id is already a stable producer id. Reuse it as the
        // interactive node id rather than interning a new per-frame selector.
        // Only position and age vary; model identity and the hollow seam ids do not.
        def fglui-owner-token-node-id(sample) = fgtm-sample-id(sample);
        def fglui-owner-token-gap-node(sample) = if str_eq(fglui-owner-token-parent(sample), FGLUIQwenOwnerParent()) then FGLUIQwenOwnerGapNode() else FGLUIThreeBOwnerGapNode();
        def fglui-owner-token-channels(sample) = append(list("flow", "owner-token-fallback"), fgtm-sample-channels(sample));
        def fglui-owner-token-identity-line(sample, epoch, width) = fgd-segment-line(fgd-cat(list("T model=", fglui-owner-token-model-name(fglui-owner-token-parent(sample)), " pos=", fglui-owner-token-position(sample))), width, fgd-sample-style(sample, epoch), fglui-owner-token-node-id(sample), fglui-owner-token-channels(sample), fgtm-sample-evidence(sample));
        def fglui-owner-token-id-line(sample, epoch, width) = fgd-segment-line(str_concat("id=", fgtm-sample-id(sample)), width, fgd-sample-style(sample, epoch), fglui-owner-token-node-id(sample), fglui-owner-token-channels(sample), fgtm-sample-evidence(sample));
        def fglui-owner-token-parent-line(sample, epoch, width) = fgd-segment-line(str_concat("parent=", fglui-owner-token-parent(sample)), width, fgd-sample-style(sample, epoch), fglui-owner-token-node-id(sample), fglui-owner-token-channels(sample), fgtm-sample-evidence(sample));
        def fglui-owner-token-scope-line(sample, epoch, width) = fgd-segment-line(fgd-cat(list("scope=", fgtm-sample-lane(sample), "/", fgtm-sample-purpose(sample), " impact=context-position-only")), width, fgd-sample-style(sample, epoch), fglui-owner-token-node-id(sample), fglui-owner-token-channels(sample), fgtm-sample-evidence(sample));
        def fglui-owner-token-evidence-line(sample, epoch, width) = fgd-segment-line(fgd-cat(list(fgd-sample-age-text(sample, epoch), " evidence=", fgtm-sample-evidence(sample))), width, fgd-sample-style(sample, epoch), fglui-owner-token-node-id(sample), fglui-owner-token-channels(sample), fgtm-sample-evidence(sample));
        def fglui-owner-token-gap-line(sample, width) = fgd-segment-line("downstream L?-- > X?-- > E?-- > M?-- > F?-- (no explicit token-flow)", width, fgd-neutral(72), fglui-owner-token-gap-node(sample), list("flow", "owner-token-fallback", "layer", "tensor", "expert", "metal", "framebuffer"), "unavailable");
        def fglui-owner-token-fallback-lines-go(rows, epoch, width) = if eq(len(rows), 0) then list() else append(list(fglui-owner-token-identity-line(head(rows), epoch, width), fglui-owner-token-id-line(head(rows), epoch, width), fglui-owner-token-parent-line(head(rows), epoch, width), fglui-owner-token-scope-line(head(rows), epoch, width), fglui-owner-token-evidence-line(head(rows), epoch, width), fglui-owner-token-gap-line(head(rows), width)), fglui-owner-token-fallback-lines-go(tail(rows), epoch, width));
        def fglui-owner-token-fallback-lines(rows, epoch, width) {
            let positions = fglui-owner-token-fallback-samples(rows);
            if eq(len(positions), 0) then list() else cons(fgd-title-segment-line("OWNER TOKEN POSITIONS (explicit runtime token-flow absent)", width, "flow.owner-token-fallback"), fglui-owner-token-fallback-lines-go(positions, epoch, width));
        }
        def fglui-token-flow-lines(rows, epoch, width) {
            let explicit = fglui-token-flow-samples(rows);
            if gt(len(explicit), 0) then fglui-token-flow-lines-go(explicit, epoch, width, 8) else fglui-owner-token-fallback-lines(rows, epoch, width);
        }
    }
    0;
}
