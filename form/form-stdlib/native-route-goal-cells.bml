; native-route-goal-cells.bml - Form-native route attention for the front-door loop.
;
; preludes: form-stdlib/core.fk
;
; Runtime sensors can feed these cells with observed request counts, latency,
; errors, native state, and handler grammar. The next route is then a Form
; choice over traffic-weighted pressure, not prose or static route-count.

section [form.bml] {
    let nrg_tag_route_observation = bp("NATIVE-ROUTE-OBS");
    let nrg_tag_route_attention = bp("NATIVE-ROUTE-ATTENTION");
    let nrg_tag_route_goal = bp("NATIVE-ROUTE-GOAL");

    def nrg-bool-score(ok, score) = ok ? score : 0;
    def nrg-tagged?(value, tag, arity) = (Comparable) len(value) == arity ? node_eq(value[0], tag) : false;
    def nrg-nonempty-string?(value) = str_len(value) > 0;
    def nrg-path-valid?(path) = str_len(path) > 0 ? ((String) char_at(path, 0) == "/") : false;

    def nrg-state-python() = "python";
    def nrg-state-kernel-served() = "kernel-served";
    def nrg-state-kernel-first-capable() = "kernel-first-capable";
    def nrg-state-kernel-first-served() = "kernel-first-served";

    def nrg-grammar-none() = "none";
    def nrg-grammar-python() = "python";
    def nrg-grammar-form() = "form";
    def nrg-grammar-bml() = "bml";
    def nrg-grammar-domain() = "domain-grammar";

    def nrg-status-form-needs-source-lift() = "kernel-native-form-needs-source-lift";
    def nrg-status-header-gated() = "kernel-native-header-gated";
    def nrg-status-python-fanout() = "python-fanout";

    def nrg-kh-route-tag() = 43004;
    def nrg-kh-route?(route) = (Comparable) len(route) == 8 ? ((Comparable) route[0] == nrg-kh-route-tag()) : false;
    def nrg-kh-route-name(route) = route[1];
    def nrg-kh-route-method(route) = route[2];
    def nrg-kh-route-pattern(route) = route[3];
    def nrg-kh-route-handler(route) = route[5];
    def nrg-kh-route-required-header(route) = route[6];
    def nrg-manifest-route-native-executable?(route) = nrg-kh-route?(route) ? ((String) nrg-kh-route-required-header(route) == "") : false;
    def nrg-manifest-route-high-grammar?(route) = false;
    def nrg-manifest-route-status(route) {
        nrg-kh-route?(route) ? (nrg-manifest-route-native-executable?(route) ? nrg-status-form-needs-source-lift() : nrg-status-header-gated()) : nrg-status-python-fanout();
    }
    def nrg-observation-from-manifest-route(route, calls, p50_ms, p95_ms, status_errors, bytes_out, flow, goal_fit_bp) {
        nrg-route-observation(nrg-kh-route-pattern(route), nrg-kh-route-method(route), calls, p50_ms, p95_ms, status_errors, bytes_out, nrg-state-kernel-first-capable(), nrg-grammar-form(), nrg-kh-route-handler(route), flow, goal_fit_bp);
    }

    def nrg-action-author-high-grammar-handler() = "author-high-grammar-handler";
    def nrg-action-promote-native-handler() = "promote-native-handler";
    def nrg-action-move-front-door() = "move-front-door";
    def nrg-action-prove-byte-identity() = "prove-byte-identity";
    def nrg-action-observe() = "observe";

    def nrg-route-observation(path, method, calls, p50_ms, p95_ms, status_errors, bytes_out, native_state, grammar, handler, flow, goal_fit_bp) = list(nrg_tag_route_observation, path, method, calls, p50_ms, p95_ms, status_errors, bytes_out, native_state, grammar, handler, flow, goal_fit_bp);
    def nrg-route-observation?(obs) = nrg-tagged?(obs, nrg_tag_route_observation, 13);
    def nrg-route-path(obs) = obs[1];
    def nrg-route-method(obs) = obs[2];
    def nrg-route-calls(obs) = obs[3];
    def nrg-route-p50-ms(obs) = obs[4];
    def nrg-route-p95-ms(obs) = obs[5];
    def nrg-route-status-errors(obs) = obs[6];
    def nrg-route-bytes-out(obs) = obs[7];
    def nrg-route-native-state(obs) = obs[8];
    def nrg-route-grammar(obs) = obs[9];
    def nrg-route-handler(obs) = obs[10];
    def nrg-route-flow(obs) = obs[11];
    def nrg-route-goal-fit-bp(obs) = obs[12];
    def nrg-route-observation-valid?(obs) {
        nrg-route-observation?(obs) ? (nrg-path-valid?(nrg-route-path(obs)) && (nrg-nonempty-string?(nrg-route-method(obs)) && ((nrg-route-calls(obs) >= 0) && ((nrg-route-p50-ms(obs) >= 0) && ((nrg-route-p95-ms(obs) >= 0) && ((nrg-route-status-errors(obs) >= 0) && ((nrg-route-bytes-out(obs) >= 0) && (nrg-nonempty-string?(nrg-route-native-state(obs)) && (nrg-nonempty-string?(nrg-route-grammar(obs)) && (nrg-nonempty-string?(nrg-route-flow(obs)) && ((nrg-route-goal-fit-bp(obs) >= 0) && (nrg-route-goal-fit-bp(obs) <= 10000)))))))))))) : false;
    }

    def nrg-observations-valid?(observations) = nil?(observations) ? true : nrg-route-observation-valid?(head(observations)) ? nrg-observations-valid?(tail(observations)) : false;
    def nrg-total-calls(observations) = nil?(observations) ? 0 : (nrg-route-calls(head(observations)) + nrg-total-calls(tail(observations)));
    def nrg-basis-points(part, total) = (Comparable) total == 0 ? 0 : ((part * 10000) / total);

    def nrg-native-pressure(state) {
        (String) state == nrg-state-kernel-first-served() ? 0 : (String) state == nrg-state-kernel-first-capable() ? 10 : (String) state == nrg-state-kernel-served() ? 45 : 100;
    }
    def nrg-grammar-pressure(grammar) {
        (String) grammar == nrg-grammar-domain() ? 0 : (String) grammar == nrg-grammar-bml() ? 5 : (String) grammar == nrg-grammar-form() ? 20 : (String) grammar == nrg-grammar-python() ? 80 : 100;
    }
    def nrg-latency-pressure(p95_ms) = p95_ms > 2000 ? 80 : p95_ms > 1000 ? 40 : p95_ms > 500 ? 20 : 0;
    def nrg-error-pressure(status_errors, calls) = nrg-basis-points(status_errors, calls);
    def nrg-apply-goal-fit(base_pressure, goal_fit_bp) = ((base_pressure / 10) * goal_fit_bp) / 1000;

    def nrg-next-action(obs) {
        let state = nrg-route-native-state(obs);
        let grammar = nrg-route-grammar(obs);
        (String) state == nrg-state-kernel-first-served() ? nrg-action-observe() : (String) state == nrg-state-kernel-first-capable() ? nrg-action-prove-byte-identity() : (String) state == nrg-state-kernel-served() ? nrg-action-move-front-door() : ((String) grammar == nrg-grammar-none()) || ((String) grammar == nrg-grammar-python()) ? nrg-action-author-high-grammar-handler() : nrg-action-promote-native-handler();
    }

    def nrg-route-attention(obs, traffic_bp, native_pressure, grammar_pressure, latency_pressure, error_pressure, total_pressure, next_action) = list(nrg_tag_route_attention, obs, traffic_bp, native_pressure, grammar_pressure, latency_pressure, error_pressure, total_pressure, next_action);
    def nrg-route-attention?(attention) = nrg-tagged?(attention, nrg_tag_route_attention, 9);
    def nrg-attention-observation(attention) = attention[1];
    def nrg-attention-traffic-bp(attention) = attention[2];
    def nrg-attention-native-pressure(attention) = attention[3];
    def nrg-attention-grammar-pressure(attention) = attention[4];
    def nrg-attention-latency-pressure(attention) = attention[5];
    def nrg-attention-error-pressure(attention) = attention[6];
    def nrg-attention-total-pressure(attention) = attention[7];
    def nrg-attention-next-action(attention) = attention[8];
    def nrg-route-attention-valid?(attention) = nrg-route-attention?(attention) ? (nrg-route-observation-valid?(nrg-attention-observation(attention)) && (nrg-attention-total-pressure(attention) >= 0)) : false;

    def nrg-attention-for(obs, total_calls) {
        let traffic_bp = nrg-basis-points(nrg-route-calls(obs), total_calls);
        let native_pressure = nrg-native-pressure(nrg-route-native-state(obs));
        let grammar_pressure = nrg-grammar-pressure(nrg-route-grammar(obs));
        let latency_pressure = nrg-latency-pressure(nrg-route-p95-ms(obs));
        let error_pressure = nrg-error-pressure(nrg-route-status-errors(obs), nrg-route-calls(obs));
        let traffic_weighted_native_pressure = traffic_bp * native_pressure;
        let base_pressure = traffic_weighted_native_pressure + ((grammar_pressure * 100) + (latency_pressure + error_pressure));
        let total_pressure = nrg-apply-goal-fit(base_pressure, nrg-route-goal-fit-bp(obs));
        nrg-route-attention(obs, traffic_bp, native_pressure, grammar_pressure, latency_pressure, error_pressure, total_pressure, nrg-next-action(obs));
    }
    def nrg-attentions-for(observations, total_calls) = nil?(observations) ? empty : cons(nrg-attention-for(head(observations), total_calls), nrg-attentions-for(tail(observations), total_calls));
    def nrg-attentions-valid?(attentions) = nil?(attentions) ? true : nrg-route-attention-valid?(head(attentions)) ? nrg-attentions-valid?(tail(attentions)) : false;

    def nrg-best-attention-from(attentions, best) {
        nil?(attentions) ? best : nil?(best) ? nrg-best-attention-from(tail(attentions), head(attentions)) : nrg-attention-total-pressure(head(attentions)) > nrg-attention-total-pressure(best) ? nrg-best-attention-from(tail(attentions), head(attentions)) : nrg-best-attention-from(tail(attentions), best);
    }
    def nrg-best-attention(attentions) = nrg-best-attention-from(attentions, empty);

    def nrg-route-goal(name, north_star, target_native_bp, total_routes, observations, attentions, next_attention) = list(nrg_tag_route_goal, name, north_star, target_native_bp, total_routes, observations, attentions, next_attention);
    def nrg-route-goal?(goal) = nrg-tagged?(goal, nrg_tag_route_goal, 8);
    def nrg-goal-name(goal) = goal[1];
    def nrg-goal-north-star(goal) = goal[2];
    def nrg-goal-target-native-bp(goal) = goal[3];
    def nrg-goal-total-routes(goal) = goal[4];
    def nrg-goal-observations(goal) = goal[5];
    def nrg-goal-attentions(goal) = goal[6];
    def nrg-goal-next-attention(goal) = goal[7];
    def nrg-route-goal-valid?(goal) = nrg-route-goal?(goal) ? (nrg-nonempty-string?(nrg-goal-name(goal)) && ((nrg-goal-target-native-bp(goal) > 0) && ((nrg-goal-total-routes(goal) >= 0) && (nrg-observations-valid?(nrg-goal-observations(goal)) && nrg-attentions-valid?(nrg-goal-attentions(goal)))))) : false;

    def nrg-goal-from-observations(name, north_star, target_native_bp, total_routes, observations) {
        let total_calls = nrg-total-calls(observations);
        let attentions = nrg-attentions-for(observations, total_calls);
        nrg-route-goal(name, north_star, target_native_bp, total_routes, observations, attentions, nrg-best-attention(attentions));
    }

    0;
}
