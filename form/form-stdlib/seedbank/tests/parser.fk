; parser.fk — exercise the Form-side parser end-to-end.
;
; preludes: form-stdlib/core.fk form-stdlib/seedbank/blueprint-symbol-sections.fk form-stdlib/seedbank/parser.fk
;
; Grammar (2c/2d): full arithmetic, parens, identifiers, fncalls,
; comparisons, if/then/else, defn, let, ; for statement sep. A parse is a
; content-addressed recipe, so the parser's grammar is read by comparing
; parses: two sources that mean the same tree intern to the same NodeID, and
; a source that means another tree does not. Nothing evaluates a parse.
;
; Verdict 12, one point per reading:
;   mul binds tighter than add                         1 + 2 * 3 == 1 + (2 * 3)
;   parens change the tree                             1 + 2 * 3 != (1 + 2) * 3
;   subtraction folds left                             10 - 3 - 2 == (10 - 3) - 2
;   and not right                                      10 - 3 - 2 != 10 - (3 - 2)
;   division folds left                                100 / 5 / 2 == (100 / 5) / 2
;   mixed precedence                                   2 + 3 * 4 - 1 == (2 + (3 * 4)) - 1
;   whitespace is not structure                        1+2*3 == 1 + 2 * 3
;   an int literal is its trivial node                 42 == (intern_trivial_int 42)
;   a condition may carry parens                       if 1 < 2 ... == if (1 < 2) ...
;   two statements are one sequence of two             defn ...; double(5)
;   let statements read alike under spacing           let x = 5; x + 10
;   a different call is a different program            ... fact(6) != ... fact(7)

(do
    (defn pb (ok) (if ok 1 0))
    (add (pb (node_eq (parse "1 + 2 * 3") (parse "1 + (2 * 3)")))
    (add (pb (not (node_eq (parse "1 + 2 * 3") (parse "(1 + 2) * 3"))))
    (add (pb (node_eq (parse "10 - 3 - 2") (parse "(10 - 3) - 2")))
    (add (pb (not (node_eq (parse "10 - 3 - 2") (parse "10 - (3 - 2)"))))
    (add (pb (node_eq (parse "100 / 5 / 2") (parse "(100 / 5) / 2")))
    (add (pb (node_eq (parse "2 + 3 * 4 - 1") (parse "(2 + (3 * 4)) - 1")))
    (add (pb (node_eq (parse "1+2*3") (parse "1 + 2 * 3")))
    (add (pb (node_eq (parse "42") (intern_trivial_int 42)))
    (add (pb (node_eq (parse "if 1 < 2 then 10 else 20") (parse "if (1 < 2) then 10 else 20")))
    (add (pb (eq (len (node_children (parse "defn double(x) = x * 2; double(5)"))) 2))
    (add (pb (node_eq (parse "let x = 5; x + 10") (parse "let x = 5 ; x+10")))
         (pb (not (node_eq (parse "defn fact(n) = if n <= 1 then 1 else n * fact(n - 1); fact(6)")
                           (parse "defn fact(n) = if n <= 1 then 1 else n * fact(n - 1); fact(7)"))))))))))))))))
