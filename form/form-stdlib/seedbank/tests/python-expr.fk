; tests/python-expr.fk — exercise Python expression parsing
;
; preludes: form-stdlib/engine.fk form-stdlib/seedbank/grammar-bnf.fk form-stdlib/seedbank/blueprint-symbol-sections.fk form-stdlib/seedbank/grammars/python.bnf.fk form-stdlib/seedbank/grammars/python-exec.fk
;
; Probes 1-6 parse Python assignments whose rhs is an expression and
; observe the value recipe against the recipe built by hand from the
; same parts: the universal MATH / COMPARE Blueprints python.bnf.fk
; emits over trivial-int leaves. node_eq is the proof that precedence
; and parens shaped the tree the source means.
;
; Probe 7 runs a two-statement module through py-execute: x binds from
; its int literal's leaf, y reads x back from the env.
;
; Verdict: 8 — six identities and two bindings.

(do
    (defn pe-first-stmt (root) (head (node_children root)))
    (defn pe-value (root) (head (tail (node_children (pe-first-stmt root)))))
    (defn pe-int (v) (intern_trivial_int v))
    (defn pe-bin (cat lhs rhs) (intern_node cat (list lhs rhs)))
    (defn pe-holds (parsed hand) (if (node_eq parsed hand) 1 0))

    ;; Probe 1: x = 1 + 2
    (let probe-1
        (pe-holds (pe-value (parse-python-bnf "t.py" "x = 1 + 2"))
                  (pe-bin PY-UNIV-MATH-PLUS (pe-int 1) (pe-int 2))))

    ;; Probe 2: y = 1 + 2 * 3 — mul binds tighter than add
    (let probe-2
        (pe-holds (pe-value (parse-python-bnf "t.py" "y = 1 + 2 * 3"))
                  (pe-bin PY-UNIV-MATH-PLUS (pe-int 1)
                          (pe-bin PY-UNIV-MATH-MUL (pe-int 2) (pe-int 3)))))

    ;; Probe 3: z = (1 + 2) * 3 — parens pass the inner recipe through
    (let probe-3
        (pe-holds (pe-value (parse-python-bnf "t.py" "z = (1 + 2) * 3"))
                  (pe-bin PY-UNIV-MATH-MUL
                          (pe-bin PY-UNIV-MATH-PLUS (pe-int 1) (pe-int 2))
                          (pe-int 3))))

    ;; Probe 4: q = 5 == 5
    (let probe-4
        (pe-holds (pe-value (parse-python-bnf "t.py" "q = 5 == 5"))
                  (pe-bin PY-UNIV-CMP-EQ (pe-int 5) (pe-int 5))))

    ;; Probe 5: r = 3 < 7
    (let probe-5
        (pe-holds (pe-value (parse-python-bnf "t.py" "r = 3 < 7"))
                  (pe-bin PY-UNIV-CMP-LT (pe-int 3) (pe-int 7))))

    ;; Probe 6: s = 5 != 5
    (let probe-6
        (pe-holds (pe-value (parse-python-bnf "t.py" "s = 5 != 5"))
                  (pe-bin PY-UNIV-CMP-NEQ (pe-int 5) (pe-int 5))))

    ;; Probe 7: py-execute — prints x = 42 and y = 42, binds two names
    (let probe-7 (py-execute (parse-python-bnf "t.py" "x = 42
y = x")))

    ;; Verdict: 1 + 1 + 1 + 1 + 1 + 1 + 2 = 8
    (add probe-1
         (add probe-2
              (add probe-3
                   (add probe-4
                        (add probe-5
                             (add probe-6 probe-7)))))))
