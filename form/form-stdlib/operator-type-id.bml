//////////////////////////////////////////////////////////////////////
//
// operator-type-id.bml — one open operator/type coordinate.
//
// NUMS.Go supplied the useful shape: package.level.type.instance, with
// narrow package/level/type coordinates and a wide instance coordinate.
// Form keeps that shape without importing NUMS's registry or assigning an
// identifier to every tensor.  A type is level 1, an operator is level 2,
// and a composed recipe is level 3.  Type is the reusable family; instance
// is the operation/variant inside that family.  Higher levels stay open.
//
// preludes: form-stdlib/core.fk
//
// Proven by: form-stdlib/tests/operator-type-id-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class OperatorTypeIdentity {
        field Coordinate = "package.level.type.instance";
        field Width = "u16.u16.u16.u32";
        field Rule = "type is a family; instance is its operation; composition owns children";
        field ValueLevel = 1;
        field OperatorLevel = 2;
        field CompositeLevel = 3;
        field U16Max = 65535;
        field FamilyCapacity = 65536;

        thought oti-pattern = list("coordinate", "family", "operation", "composition");

        def oti-u16?(n) = if ge(n, 0) then if le(n, U16Max()) then 1 else 0 else 0;
        // BML's source-number reader is presently signed-u32.  Derive the
        // wider unsigned edge inside Form so the coordinate does not turn
        // a valid u32 instance into `nothing` during lowering.
        def oti-operation-capacity() = mul(FamilyCapacity(), FamilyCapacity());
        def oti-u32-max() = sub(oti-operation-capacity(), 1);
        def oti-u32?(n) = if ge(n, 0) then if le(n, oti-u32-max()) then 1 else 0 else 0;

        def oti-valid-coordinate?(pkg, lvl, family, operation) = if eq(oti-u16?(pkg), 1) then if eq(oti-u16?(lvl), 1) then if eq(oti-u16?(family), 1) then oti-u32?(operation) else 0 else 0 else 0;

        def oti-coordinate(pkg, lvl, family, operation) = if eq(oti-valid-coordinate?(pkg, lvl, family, operation), 1) then make_nodeid(pkg, lvl, family, operation) else nothing();

        def oti-value(pkg, family, operation) = oti-coordinate(pkg, ValueLevel(), family, operation);
        def oti-operator(pkg, family, operation) = oti-coordinate(pkg, OperatorLevel(), family, operation);

        // The coordinate names the recipe family/operation; its ordered
        // children carry the concrete operator assemblage.  Repeating the
        // same coordinate and children returns the same content identity.
        def oti-composite(pkg, family, operation, children) = if eq(oti-valid-coordinate?(pkg, CompositeLevel(), family, operation), 1) then intern_node(make_nodeid(pkg, CompositeLevel(), family, operation), children) else nothing();

        // A plain coordinate is its own category.  A composite is an interned
        // occurrence whose category retains the requested family/operation.
        // Reading through node_category therefore serves both without
        // confusing occurrence identity for operator identity.
        def oti-operator-family(node) = node_type(node_category(node));
        def oti-operation(node) = node_inst(node_category(node));
        def oti-family-capacity() = FamilyCapacity();
        def oti-package-capacity() = FamilyCapacity();
        def oti-level-capacity() = FamilyCapacity();
        def oti-type-coordinate-capacity() = mul(mul(FamilyCapacity(), FamilyCapacity()), FamilyCapacity());
        def oti-total-coordinate-bits() = 80;
        // 2^80 exceeds the current signed machine integer, so the exact open
        // coordinate count crosses as decimal text instead of overflowing.
        def oti-total-coordinate-capacity-decimal() = "1208925819614629174706176";
    }
    0;
}
