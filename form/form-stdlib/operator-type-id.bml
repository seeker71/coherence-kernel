//////////////////////////////////////////////////////////////////////
//
// operator-type-id.bml — one open operator/type coordinate.
//
// NUMS.Go supplied the useful shape: package.level.type.instance, with
// narrow package/level/type coordinates and a wide instance coordinate.
// Form keeps that shape without importing NUMS's registry or assigning an
// identifier to every tensor.  Package.level.type selects a family; instance
// selects a member.  Blueprint space reads that member as a concrete type;
// recipe space reads it as an operator.  Those roles are not encoded in the
// bits: NUMS's BlueprintNodeID_t and RecipeNodeID_t deliberately wrap the same
// coordinate.  Applying a recipe operator to ordered operands gives the
// content-addressed recipe.  No level receives a universal meaning here.
//
// preludes: form-stdlib/core.fk
//
// Proven by: form-stdlib/tests/operator-type-id-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class OperatorTypeIdentity {
        field Coordinate = "package.level.type.instance";
        field Width = "u16.u16.u16.u32";
        field Rule = "family is package.level.type; blueprint member is a type; recipe member is an operator; apply owns ordered operands";
        field U16Max = 65535;
        field FamilyCapacity = 65536;

        thought oti-pattern = list("coordinate", "family", "operation", "composition");

        def oti-u16?(n) = if ge(n, 0) then if le(n, U16Max()) then 1 else 0 else 0;
        // BML's source-number reader is presently signed-u32.  Derive the
        // wider unsigned edge inside Form so the coordinate does not turn
        // a valid u32 instance into `nothing` during lowering.
        def oti-operation-capacity() = mul(FamilyCapacity(), FamilyCapacity());
        def oti-u32-max() = sub(oti-operation-capacity(), 1);
        def oti-u32?(n) = if ge(n, 0) then if le(n, oti-u32-max()) then 1 else 0 else 0;

        def oti-valid-coordinate?(pkg, lvl, family, operation) = if eq(oti-u16?(pkg), 1) then if eq(oti-u16?(lvl), 1) then if eq(oti-u16?(family), 1) then oti-u32?(operation) else 0 else 0 else 0;

        def oti-coordinate(pkg, lvl, family, operation) = if eq(oti-valid-coordinate?(pkg, lvl, family, operation), 1) then make_nodeid(pkg, lvl, family, operation) else nothing();

        // A family reference is the package.level.type projection.  The
        // projection uses zero in its otherwise-ignored instance field, but
        // zero is NOT reserved: NUMS has real zero members (for example false
        // and void).  Role lives in the caller, not in a marker bit.
        def oti-family(pkg, lvl, family) = oti-coordinate(pkg, lvl, family, 0);
        def oti-family-ref?(node) = oti-valid-coordinate?(node_pkg(node_category(node)), node_level(node_category(node)), node_type(node_category(node)), node_inst(node_category(node)));
        def oti-family?(node) = oti-family-ref?(node);

        // Type and operator are roles owned by blueprint/recipe space.  Their
        // coordinate construction is intentionally identical: identity stays
        // structural instead of pretending the bits carry an absent role tag.
        def oti-member(familyNode, instance) = if eq(oti-family-ref?(familyNode), 1) then oti-coordinate(node_pkg(node_category(familyNode)), node_level(node_category(familyNode)), node_type(node_category(familyNode)), instance) else nothing();
        def oti-type(familyNode, instance) = oti-member(familyNode, instance);
        def oti-operator(familyNode, operation) = oti-member(familyNode, operation);

        // Applying the same operator to the same ordered operands returns the
        // same NodeID.  The occurrence is separate from its operator category.
        def oti-apply(operator, operands) = if eq(oti-valid-coordinate?(node_pkg(node_category(operator)), node_level(node_category(operator)), node_type(node_category(operator)), node_inst(node_category(operator))), 1) then intern_node(node_category(operator), operands) else nothing();
        def oti-compose(familyNode, operation, operands) = oti-apply(oti-operator(familyNode, operation), operands);

        def oti-family-of(node) = oti-family(node_pkg(node_category(node)), node_level(node_category(node)), node_type(node_category(node)));
        def oti-same-family?(left, right) = node_eq(oti-family-of(left), oti-family-of(right));
        def oti-in-family?(node, familyNode) = if eq(oti-family-ref?(familyNode), 1) then oti-same-family?(node, familyNode) else 0;
        def oti-operator-family(node) = oti-family-of(node);
        def oti-family-index(node) = node_type(oti-family-of(node));
        def oti-operation(node) = node_inst(node_category(node));
        def oti-family-capacity() = FamilyCapacity();
        def oti-package-capacity() = FamilyCapacity();
        def oti-level-capacity() = FamilyCapacity();
        def oti-families-per-package-level() = FamilyCapacity();
        def oti-members-per-family() = oti-operation-capacity();
        def oti-type-coordinate-capacity() = mul(mul(FamilyCapacity(), FamilyCapacity()), FamilyCapacity());
        def oti-total-coordinate-bits() = 80;
        // 2^80 exceeds the current signed machine integer, so the exact open
        // coordinate count crosses as decimal text instead of overflowing.
        def oti-total-coordinate-capacity-decimal() = "1208925819614629174706176";
    }
    0;
}
