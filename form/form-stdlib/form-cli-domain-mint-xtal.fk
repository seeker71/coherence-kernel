
(let SampleRow (language-template-with-members "SampleRow" (list "TClass") (list (language-template-member "split" "String") (language-template-member "className" "TClass") (language-template-member "situation" "String"))))
(defn MintAuthorityPath () "form/form-stdlib/bml/form-cli-domain-mint.bml")
(defn MintAuthorityKind () "high-bml-class-template-field")
(defn FormDomainMintAuthority () (list "abstraction" "FormDomainMintAuthority" (list) (list) (list "MintAuthorityPath" "MintAuthorityKind") (list) (list)))
(defn MixA () 7)
(defn MixB () 13)
(defn NSkills () 12)
(defn LoraWriter () 0)
(defn SplitTrain () "train")
(defn SplitHeldout () "heldout")
(defn fdm-authority () FormDomainMintAuthority)
(defn fdm-pattern () (list "mint" "heldout" "overlay-fit" "lora-waits"))
(defn fdm-skills () (list "assemblage" "human-design" "gene-keys" "astrology" "physics" "chemistry" "biology" "quantum" "math" "logic" "shape-match" "time-direction"))
(defn fdm-contexts () (list "core lexicon" "guidance channel" "ephemeris stack" "rave mandala" "assemblage switch" "nearest-shape" "cross-domain lane" "offer-ack core"))
(defn fdm-sources () (list "form/form-stdlib/assemblage-point.fk" "form/form-stdlib/hd-mandala-wheel.fk" "form/form-stdlib/genekey-profile.fk" "form/form-stdlib/zodiac-channel.fk" "form/form-stdlib/core-lexicon-domains.fk" "form/form-stdlib/field-model-form.fk" "form/form-stdlib/backward-chaining.fk" "form/form-stdlib/nearest-shape.fk" "form/form-stdlib/celestial-pole-channel.fk" "form/form-stdlib/cross-domain-cornerstone.fk" "control/pattern-match.fk" "form/form-stdlib/guidance-channel.fk"))
(defn fdm-mix (i n) (mod (add (mul i (MixA)) (MixB)) n))
(defn fdm-assemblage-stems () (list "the assemblage point is the frame where perception locks reality into one shape" "the highest-success move and the most-alive move are not always the same" "learning which branch happens inside a point learning to move the point finds a move the current frame cannot see" "switch the frame by aliveness not by optimizing the branch by success"))
(defn fdm-hd-stems () (list "the rave mandala places 64 gates around the zodiac a date becomes a gate" "type is a kind of self authority is the way a self knows what to do" "gate 41 at 302 degrees is the Human Design New Year the canonical anchor" "Human Design gate and Gene Key and I Ching hexagram that share an address are one cell"))
(defn fdm-gk-stems () (list "shadow is when a self is less than it is gift is when a self gives what it is" "siddhi is when a self is same as all" "the hologenetic profile casts eleven spheres from a birth-moment" "the design moment is the sky about 88 days before birth"))
(defn fdm-astro-stems () (list "one sky two astrologies tropical and sidereal differ by the ayanamsa" "Aries and Mesha are one sign wearing two tongues they share an address" "sign house aspect transit are sayable from the 64 not imported jargon" "computable recipes are empirical names are documented tradition never cosmology"))
(defn fdm-physics-stems () (list "force is what make a thing do energy is what a thing have to do" "wave is when a thing do same again and again" "field is where a force is at all here and there" "resonance within empirical lanes is empirical-grade cross-lane is structural only"))
(defn fdm-chem-stems () (list "element is a kind of thing that is not many kind" "reaction is when many thing do and after are other" "bond is when many thing hold as one whole" "bond sits at depth 3 because holding needed giving first"))
(defn fdm-bio-stems () (list "life is when a thing do and make other like it" "grow is when a thing be more than it was before" "sense is when a self know what is out of it" "Levin bioelectric lens tissue state is voltage-pattern memory"))
(defn fdm-quantum-stems () (list "field-model-form models an LHY-stabilized self-bound droplet as domain data" "quantum vocabulary used as authority without a mechanism offered is a borrow not a proof" "the observer-effect borrow is named as borrow measurement disturbs the record" "computable astronomy stays empirical quantum names stay in their lane"))
(defn fdm-math-stems () (list "number is how many thing are set is many thing we know as one whole" "function is a way from one thing to other thing" "proof is a way to know whether a thing is 1" "angle sits deepest because it needs line which needs point"))
(defn fdm-logic-stems () (list "backward-chaining pulls from a goal forward-chaining pushes from axioms" "two engines one truth over the same facts and rules" "cyclic rules cannot loop forever because fuel decrements" "pattern-match is structural match by shape ctor and arity no-match is nothing"))
(defn fdm-shape-stems () (list "nearest-shape counts agreeing bins no subtraction no distance no float" "a prototype is a substrate cell its Blueprint NodeID is its vector shape" "learning is adding a prototype no weights no training loop" "pattern-match offers a cell to data clauses the first matching shape acknowledges"))
(defn fdm-time-stems () (list "when is computable a clock answers it exactly with zero learning" "Julian Day Number is the spine of every ephemeris" "the north star moves Thuban held it Polaris holds it Vega will" "timeout is nothing counted time-direction is the sky not the budget"))
(defn fdm-stems (class) (if (str_eq class "assemblage") (fdm-assemblage-stems) (if (str_eq class "human-design") (fdm-hd-stems) (if (str_eq class "gene-keys") (fdm-gk-stems) (if (str_eq class "astrology") (fdm-astro-stems) (if (str_eq class "physics") (fdm-physics-stems) (if (str_eq class "chemistry") (fdm-chem-stems) (if (str_eq class "biology") (fdm-bio-stems) (if (str_eq class "quantum") (fdm-quantum-stems) (if (str_eq class "math") (fdm-math-stems) (if (str_eq class "logic") (fdm-logic-stems) (if (str_eq class "shape-match") (fdm-shape-stems) (fdm-time-stems)))))))))))))
(defn fdm-prefix (split) (if (str_eq split (SplitTrain)) "Observed " "Boundary: observed "))
(defn fdm-situation (class i split) (do (let ctxs (fdm-contexts)) (let stems (fdm-stems class)) (let ctx (nth ctxs (fdm-mix i (len ctxs)))) (let stem (nth stems (fdm-mix i (len stems)))) (str_concat (fdm-prefix split) (str_concat ctx (str_concat " " (str_concat stem (str_concat " case " (int_to_str i))))))))
(defn fdm-row (class i split) (list split class (fdm-situation class i split)))
(defn fdm-class-rows (class i n split acc) (if (eq i n) acc (fdm-class-rows class (add i 1) n split (cons (fdm-row class i split) acc))))
(defn fdm-all-classes (names tn hn acc) (if (eq (len names) 0) acc (fdm-all-classes (tail names) tn hn (fdm-class-rows (head names) 0 hn (SplitHeldout) (fdm-class-rows (head names) 0 tn (SplitTrain) acc)))))
(defn fdm-corpus (tn hn) (fdm-all-classes (fdm-skills) tn hn (tail (list "x"))))
(defn fdm-n (tn hn) (mul (NSkills) (add tn hn)))
(defn fdm-has-situation (rows s) (if (eq (len rows) 0) 0 (if (str_eq (nth (head rows) 2) s) 1 (fdm-has-situation (tail rows) s))))
(defn fdm-train-only (rows acc) (if (eq (len rows) 0) acc (if (str_eq (nth (head rows) 0) (SplitTrain)) (fdm-train-only (tail rows) (cons (head rows) acc)) (fdm-train-only (tail rows) acc))))
(defn fdm-leakage-loop (all rows) (if (eq (len rows) 0) 0 (add (if (str_eq (nth (head rows) 0) (SplitHeldout)) (fdm-has-situation (fdm-train-only all (tail (list "x"))) (nth (head rows) 2)) 0) (fdm-leakage-loop all (tail rows)))))
(defn fdm-leakage (rows) (fdm-leakage-loop rows rows))
(defn fdm-unique-loop (rows seen) (if (eq (len rows) 0) (len seen) (if (eq (fdm-has-situation seen (nth (head rows) 2)) 1) (fdm-unique-loop (tail rows) seen) (fdm-unique-loop (tail rows) (cons (head rows) seen)))))
(defn fdm-unique (rows) (fdm-unique-loop rows (tail (list "x"))))
(defn fdm-count-split (rows split) (if (eq (len rows) 0) 0 (add (if (str_eq (nth (head rows) 0) split) 1 0) (fdm-count-split (tail rows) split))))
(defn fdm-lora-writer () (LoraWriter))
(defn fdm-mix-diverse () (if (eq (fdm-mix 0 8) (fdm-mix 1 8)) 0 1))
(defn fdm-predict (models names s) (nth names (fqt-predict-index models s)))
(defn fdm-heldout-hit (models names row) (if (str_eq (nth row 0) (SplitHeldout)) (if (str_eq (fdm-predict models names (nth row 2)) (nth row 1)) 1 0) 0))
(defn fdm-heldout-correct-loop (models names rows) (if (eq (len rows) 0) 0 (add (fdm-heldout-hit models names (head rows)) (fdm-heldout-correct-loop models names (tail rows)))))
(defn fdm-heldout-correct (rows) (do (let names (fdm-skills)) (let models (fqt-fit rows names)) (fdm-heldout-correct-loop models names rows)))
(defn fdm-bit (ok bit) (if ok bit 0))
(defn fdm-check () (do (let rows (fdm-corpus 3 1)) (let n (fdm-n 3 1)) (let correct (fdm-heldout-correct rows)) (let c0 (fdm-bit (eq n 48) 1)) (let c1 (fdm-bit (eq (fdm-mix-diverse) 1) 2)) (let c2 (fdm-bit (eq (fdm-leakage rows) 0) 4)) (let c3 (fdm-bit (eq (fdm-unique rows) n) 8)) (let c4 (fdm-bit (and (eq (fdm-count-split rows (SplitTrain)) 36) (eq (fdm-count-split rows (SplitHeldout)) 12)) 16)) (let c5 (fdm-bit (ge correct 9) 32)) (let c6 (fdm-bit (eq (fdm-lora-writer) 0) 64)) (let c7 (fdm-bit (eq (fdm-n 5 2) 84) 128)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
(defn FormDomainMint () (list "abstraction" "FormDomainMint" (list "T") (list "fdm-mix" "fdm-assemblage-stems" "fdm-hd-stems" "fdm-gk-stems" "fdm-astro-stems" "fdm-physics-stems" "fdm-chem-stems" "fdm-bio-stems" "fdm-quantum-stems" "fdm-math-stems" "fdm-logic-stems" "fdm-shape-stems" "fdm-time-stems" "fdm-stems" "fdm-prefix" "fdm-situation" "fdm-row" "fdm-class-rows" "fdm-all-classes" "fdm-corpus" "fdm-n" "fdm-has-situation" "fdm-train-only" "fdm-leakage-loop" "fdm-leakage" "fdm-unique-loop" "fdm-unique" "fdm-count-split" "fdm-lora-writer" "fdm-mix-diverse" "fdm-predict" "fdm-heldout-hit" "fdm-heldout-correct-loop" "fdm-heldout-correct" "fdm-bit" "fdm-check") (list "MixA" "MixB" "NSkills" "LoraWriter" "SplitTrain" "SplitHeldout") (list "fdm-authority") (list "fdm-pattern" "fdm-skills" "fdm-contexts" "fdm-sources")))
