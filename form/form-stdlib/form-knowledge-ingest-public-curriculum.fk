; form-knowledge-ingest-public-curriculum.fk — public restatement of ingest
; laws from the cells' own words. Heldout v3 cites
; ingest/equivalence-collapse.fk and ingest/knowledge-ingest.fk; those
; files stay disjoint from this teaching source, the way axioms lessons
; ride the public curriculum instead of core-axioms.form.
;
; preludes: form-stdlib/core.fk

(do
    (defn fkipc-collapse-path () "ingest/equivalence-collapse.fk")
    (defn fkipc-depth-path () "ingest/knowledge-ingest.fk")
    (defn fkipc-nbo-path () "ingest/name-build-observe.fk")
    (defn fkipc-equivalent-storage ()
        "equivalence-collapse stores each Blueprint once and links restatements; two sources with the same shape share one cell")
    (defn fkipc-depth-threshold ()
        "knowledge-ingest treats a unit as deep when ki-deep? sees depth ge 3, so shallow units compost")
    0)
