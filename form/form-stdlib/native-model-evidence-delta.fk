; Form-owned identity comparison for the daily native-model witness.
;
; The host transports salted/current and prior content identities.  Form owns
; the interpretation: a score delta is admissible only when candidate, dataset,
; and evaluation-contract identities all align.  A changed corpus is evidence
; arrival, not a model-quality trend.
;
; preludes: form-stdlib/core.fk

(do
    (defn nmed-sha256? (s)
        (if (eq (str_len s) 64) 1 0))
    (defn nmed-prior-known? (candidate dataset contract)
        (if (and (eq (nmed-sha256? candidate) 1)
                 (and (eq (nmed-sha256? dataset) 1)
                      (eq (nmed-sha256? contract) 1))) 1 0))
    (defn nmed-candidate-changed? (current prior)
        (if (str_eq current prior) 0 1))
    (defn nmed-dataset-changed? (current prior)
        (if (str_eq current prior) 0 1))
    (defn nmed-contract-changed? (current prior)
        (if (str_eq current prior) 0 1))
    (defn nmed-comparison-admissible?
        (candidate dataset contract prior-candidate prior-dataset prior-contract)
        (if (eq (nmed-prior-known? prior-candidate prior-dataset prior-contract) 1)
            (if (and (eq (nmed-candidate-changed? candidate prior-candidate) 0)
                     (and (eq (nmed-dataset-changed? dataset prior-dataset) 0)
                          (eq (nmed-contract-changed? contract prior-contract) 0))) 1 0)
            0))
    (defn nmed-evidence-state
        (candidate dataset contract prior-candidate prior-dataset prior-contract)
        (if (eq (nmed-prior-known? prior-candidate prior-dataset prior-contract) 0)
            "baseline-unavailable"
            (if (eq (nmed-contract-changed? contract prior-contract) 1)
                "contract-changed-not-comparable"
                (if (or (eq (nmed-candidate-changed? candidate prior-candidate) 1)
                        (eq (nmed-dataset-changed? dataset prior-dataset) 1))
                    "evidence-changed-not-comparable"
                    "unchanged-evidence-comparable"))))
    ; Identity alignment permits a quality comparison only when a replay
    ; actually arrived.  An empty, consentful observation is evidence stasis,
    ; not a zero-quality sample and never a regression claim.
    (defn nmed-quality-comparison-admissible?
        (metric-observed candidate dataset contract prior-candidate prior-dataset prior-contract)
        (if (eq metric-observed 1)
            (nmed-comparison-admissible? candidate dataset contract
                prior-candidate prior-dataset prior-contract)
            0))
    (defn nmed-quality-evidence-state
        (metric-observed candidate dataset contract prior-candidate prior-dataset prior-contract)
        (if (eq metric-observed 1)
            (nmed-evidence-state candidate dataset contract
                prior-candidate prior-dataset prior-contract)
            "no-replayed-query"))
    0)
