; failure-taxonomy.fk — the observe-step vocabulary for propose->error->
; observe->revise trajectories: the body's OWN diagnostic classes, detected
; from runner transcripts and candidate bytes, so a trajectory's error step
; speaks the kernel's voice verbatim rather than a paraphrase of it.
;
; WHY THIS EXISTS, from the mesh's two critiques meeting: keeping only clean
; small programs risks teaching syntax without error semantics (the resident
; peer's critique of the green-only curriculum — echogate at the curriculum
; scale), and condition E exposed failure modes no short instrument could
; see. A trajectory curriculum needs TYPED failures, and the types already
; exist — every one below was witnessed in these sittings as a real kernel
; diagnostic or a real candidate pathology. None is invented.
;
; TWO DETECTOR FAMILIES:
;   transcript classes — substrings of the kernel's own diagnostic lines
;     (input-ended-mid-form, stray-rparen, unbalanced-source, unresolved-
;     call, unbound-name, shadowed-primitive, refused-cache);
;   candidate classes — pathologies of the emitted bytes themselves:
;     DEGENERATION (one byte-pair dominating the tail: condition E's `1,`
;     loop is the live fixture, not a synthetic), and PROMPT-ECHO (a long
;     window of the prompt reproduced verbatim as if it were code).
;
; A clean transcript classifies to the EMPTY list — present-0, a real
; reading of "no failure", never nothing. An unrecognized diagnostic line
; is COUNTED as "unclassified", never dropped: a taxonomy that discards
; what it cannot name teaches the reviser that unknown failures are
; success.
;
; preludes: form-stdlib/core.fk
;
; Proven by: form-stdlib/tests/failure-taxonomy-band.fk

(do
    ; ── transcript classes: (name needle) rows, the kernel's own words ─────
    (defn ftx-classes ()
        (list
            (list "mid-form" "input-ended-mid-form")
            (list "stray-rparen" "stray ')'")
            (list "unbalanced" "unbalanced-source")
            (list "unresolved-call" "unresolved-call")
            (list "unbound-name" "unbound-name")
            (list "shadowed-primitive" "shadowed-primitive")
            (list "refused-cache" "REFUSED at compile")))

    (defn ftx-count (s needle from n)
        (do (let at (str_find s needle from))
            (if (lt at 0) n
                (ftx-count s needle (add at (str_len needle)) (add n 1)))))

    (defn ftx-scan-go (s classes out)
        (if (eq (len classes) 0) out
            (do (let c (head classes))
                (let n (ftx-count s (nth c 1) 0 0))
                (ftx-scan-go s (tail classes)
                    (if (gt n 0) (append out (list (list (nth c 0) n))) out)))))

    ; error-looking lines no class claims are counted, never dropped
    (defn ftx-error-lines (s from n)
        (do (let at (str_find s "error:" from))
            (if (lt at 0) n (ftx-error-lines s (add at 6) (add n 1)))))
    (defn ftx-classified-total (rows n)
        (if (eq (len rows) 0) n
            (ftx-classified-total (tail rows) (add n (nth (head rows) 1)))))
    (defn ftx-scan (transcript)
        (do (let rows (ftx-scan-go transcript (ftx-classes) (list)))
            (let errs (ftx-error-lines transcript 0 0))
            (let known (ftx-classified-total rows 0))
            (if (gt errs known)
                (append rows (list (list "unclassified" (sub errs known))))
                rows)))

    ; ── candidate class: degeneration — one byte-pair owns the tail ────────
    ; permille of all adjacent pairs held by the single most frequent pair,
    ; measured over the LAST half of the candidate (loops live at the tail).
    (defn ftx-pair-key (a b) (add (mul a 256) b))
    (defn ftx-bump-pair (ps k)
        (if (eq (len ps) 0) (list (list k 1))
            (if (eq (nth (head ps) 0) k)
                (cons (list k (add (nth (head ps) 1) 1)) (tail ps))
                (cons (head ps) (ftx-bump-pair (tail ps) k)))))
    (defn ftx-pairs (s i n ps)
        (if (ge (add i 1) n) ps
            (ftx-pairs s (add i 1) n
                (ftx-bump-pair ps (ftx-pair-key (str_byte_at s i)
                                                (str_byte_at s (add i 1)))))))
    (defn ftx-max-count (ps m)
        (if (eq (len ps) 0) m
            (ftx-max-count (tail ps)
                (if (gt (nth (head ps) 1) m) (nth (head ps) 1) m))))
    (defn ftx-degeneration-pm (candidate)
        (do (let n (str_len candidate))
            (if (lt n 64) 0
                (do (let half (div n 2))
                    (let ps (ftx-pairs candidate half n (list)))
                    (let total (sub (sub n half) 1))
                    (if (le total 0) 0
                        (div (mul (ftx-max-count ps 0) 1000) total))))))
    (defn ftx-degenerate? (candidate)
        (if (ge (ftx-degeneration-pm candidate) 250) 1 0))

    ; ── value class: wrong-value — clean compile, wrong result ─────────────
    ; The kernel cannot emit this one: the transcript of a wrong-value run
    ; shows only the wrong number, no diagnostic. Witnessed live in the first
    ; trajectory collection: a candidate answering (add n n) for "n squared
    ; plus one" repeated IDENTICALLY for three revise rounds when the observe
    ; step carried only the transcript — and revised correctly in ONE round
    ; when it carried the contrast. Same model, same candidate, one variable:
    ; the observe line below is that variable, typed.
    (defn ftx-wrong-value? (got want)
        (if (nothing? got) 0 (if (eq got want) 0 1)))
    (defn ftx-value-contrast (got want task)
        (str_concat "For this input it printed "
        (str_concat (int_to_str got)
        (str_concat ", but the required result is "
        (str_concat (int_to_str want)
        (str_concat ": " task))))))

    ; ── candidate class: prompt-echo — a prompt window reproduced verbatim ─
    ; forty-byte windows of the prompt, stepped by twenty; one hit is echo.
    (defn ftx-echo-go (prompt candidate i n)
        (if (gt (add i 40) n) 0
            (if (ge (str_find candidate (substring prompt i (add i 40)) 0) 0) 1
                (ftx-echo-go prompt candidate (add i 20) n))))
    (defn ftx-prompt-echo? (prompt candidate)
        (if (lt (str_len prompt) 40) 0
            (ftx-echo-go prompt candidate 0 (str_len prompt))))
    0)
