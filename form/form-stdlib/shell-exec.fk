// shell-exec.fk — the form-native shell executor (v2: exit codes + && / || + builtins).
//
// Walks the fncall AST from shell-grammar.fk and RUNS it. Two tiers:
//   - NATIVE form builtins compute output IN FORM — no host tool. Each is a native
//     form version of the unix tool, the thing that replaces passthrough.
//   - PASSTHROUGH for every other command: an explicit non-executing label.  It
//     never invokes a host shell, popen, or another process.
//
// Every evaluation returns (list stdout env exit): exit is the command's status,
// stored back in env as $? so `&&`/`||`/test compose. Pure, so a band asserts the
// exact stdout/exit and crosses to the 4th kernel.
//
// preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/grammar-loader.fk form-stdlib/shell-grammar.fk form-stdlib/voice-traits.fk form-stdlib/feature-vector.fk form-stdlib/nearest-shape.fk form-stdlib/voice-diarize.fk
section [form.bml] {
    //; ── node helpers (the AST is all fncall(TAG, kids...); leaves are literals) ──
    def sh-leaf?(n) = nil?(node_children(n));
    def sh-tag(n) = sh-leaf?(n) ? "" : node_value(head(node_children(n)));
    def sh-rest(n) = tail(node_children(n));
    def sh-redir-tag?(t) = (String) t == "__redir__" || ((String) t == "__append__" || (String) t == "__from__");
    //; ── result tuple (stdout env exit) ──────────────────────────────────
    def r-out(r) = nth(r, 0);
    def r-env(r) = nth(r, 1);
    def r-exit(r) = nth(r, 2);
    //; ── string helpers ──────────────────────────────────────────────────
    def sh-contains?(s, sub) = find-from(s, sub, 0) >= 0;
    def sh-join(xs, sep) = nil?(xs) ? "" : nil?(tail(xs)) ? head(xs) : str_concat(head(xs), str_concat(sep, sh-join(tail(xs), sep)));
    def sh-drop-trailing-empty(ls) = nil?(ls) ? ls : nil?(tail(ls)) ? (String) head(ls) == "" ? empty() : ls : cons(head(ls), sh-drop-trailing-empty(tail(ls)));
    def sh-lines(s) = sh-drop-trailing-empty(split-on(s, "\n"));
    def sh-join-nl(xs) = nil?(xs) ? "" : str_concat(sh-join(xs, "\n"), "\n");
    def sh-take(xs, n) = nil?(xs) ? empty() : n <= 0 ? empty() : cons(head(xs), sh-take(tail(xs), n - 1));
    def sh-take-last(xs, n) = reverse-acc(sh-take(reverse-acc(xs), n));
    // Reversing [i, j) is the reversed RIGHT half followed by the reversed left
    // half — so the same bytes come out in the same order without ever cutting a
    // tail. The first form peeled one byte and re-sliced everything after it, so
    // reversing n bytes made n slices of average length n/2: quadratic in the
    // slicing alone, and each slice was itself quadratic before core.fk's
    // substring was rebalanced on 2026-08-25. Measured then, on the peeling
    // form with the balanced substring already under it: 256 bytes 0.08 s,
    // 1,024 bytes 0.18 s, 2,048 bytes 0.50 s — still superlinear, because a
    // cheaper slice does not fix a loop that takes n of them.
    //
    // Index-based and halved, nothing is sliced at all: one byte is read at each
    // of the n leaves and the joins form a balanced tree.
    def sh-rev-range(s, i, j) = {
        let n = j - i;
        n <= 0 ? "" : (Comparable) n == 1 ? byte_to_str(str_byte_at(s, i)) : {
            let mid = i + n / 2;
            str_concat(sh-rev-range(s, mid, j), sh-rev-range(s, i, mid));
        };
    };
    def sh-rev-str(s) = sh-rev-range(s, 0, str_len(s));
    def sh-seq-build(i, n) = i > n ? empty() : cons(int_to_str(i), sh-seq-build(i + 1, n));
    def sh-seq-range(a, b) = a > b ? empty() : cons(int_to_str(a), sh-seq-range(a + 1, b));
    def sh-str-lt(a, b) = (Comparable) str_len(a) == 0 ? str_len(b) > 0 : (Comparable) str_len(b) == 0 ? false : {
        let ca = ord(char_at(a, 0));
        let cb = ord(char_at(b, 0));
        ca < cb ? true : ca > cb ? false : sh-str-lt(substring(a, 1, str_len(a)), substring(b, 1, str_len(b)));
    };
    def sh-insert(x, sorted) = nil?(sorted) ? list(x) : sh-str-lt(x, head(sorted)) ? cons(x, sorted) : cons(head(sorted), sh-insert(x, tail(sorted)));
    def sh-sort(xs) = nil?(xs) ? empty() : sh-insert(head(xs), sh-sort(tail(xs)));
    def sh-uniq(xs) = nil?(xs) ? empty() : nil?(tail(xs)) ? xs : (String) head(xs) == head(tail(xs)) ? sh-uniq(tail(xs)) : cons(head(xs), sh-uniq(tail(xs)));
    def sh-lc-char(c) = {
        let o = ord(c);
        o >= 65 && o <= 90 ? byte_to_str(o + 32) : c;
    };
    def sh-lc(s) = (Comparable) str_len(s) == 0 ? "" : str_concat(sh-lc-char(substring(s, 0, 1)), sh-lc(substring(s, 1, str_len(s))));
    def sh-tr-char(c, s1, s2) = {
        let i = find-from(s1, c, 0);
        i < 0 ? c : i < str_len(s2) ? substring(s2, i, i + 1) : c;
    };
    def sh-tr-str(s, s1, s2) = (Comparable) str_len(s) == 0 ? "" : str_concat(sh-tr-char(substring(s, 0, 1), s1, s2), sh-tr-str(substring(s, 1, str_len(s)), s1, s2));
    def sh-words(s, i, cur, acc) = i >= str_len(s) ? (Comparable) str_len(cur) == 0 ? reverse-acc(acc) : reverse-acc(cons(cur, acc)) : is-ws-cp(ord(char_at(s, i))) ? (Comparable) str_len(cur) == 0 ? sh-words(s, i + 1, "", acc) : sh-words(s, i + 1, "", cons(cur, acc)) : sh-words(s, i + 1, str_concat(cur, substring(s, i, i + 1)), acc);
    def sh-count-words(s) = len(sh-words(s, 0, "", empty()));
    def sh-nl-lines(lines, n) = nil?(lines) ? empty() : (Comparable) str_len(head(lines)) == 0 ? cons("", sh-nl-lines(tail(lines), n)) : cons(str_concat(int_to_str(n), str_concat("\t", head(lines))), sh-nl-lines(tail(lines), n + 1));
    //; ── flag / operand parsing (a dash-arg is a flag; -X carries char flags) ──
    def sh-flag?(args, ch) = nil?(args) ? false : {
        let a = head(args);
        starts-with?(a, "-") && str_len(a) > 1 ? find-from(a, ch, 1) >= 1 ? true : sh-flag?(tail(args), ch) : sh-flag?(tail(args), ch);
    };
    def sh-operands(args) = nil?(args) ? empty() : starts-with?(head(args), "-") ? sh-operands(tail(args)) : cons(head(args), sh-operands(tail(args)));
    def sh-first-nonflag(args) = nil?(args) ? "" : starts-with?(head(args), "-") ? sh-first-nonflag(tail(args)) : head(args);
    def sh-first-num(args) = nil?(args) ? 0 : is-digit-cp(ord(char_at(head(args), 0))) ? str_to_int(head(args)) : sh-first-num(tail(args));
    def sh-cat-files(args) = nil?(args) ? "" : str_concat(read_file(head(args)), sh-cat-files(tail(args)));
    def sh-map-rev(lines) = nil?(lines) ? empty() : cons(sh-rev-str(head(lines)), sh-map-rev(tail(lines)));
    //; ── native builtins: (args stdin) -> (list stdout exit) ─────────────
    def sh-bi-echo(args, stdin) = (nil?(args) ? false : (String) head(args) == "-n") ? list(sh-join(tail(args), " "), 0) : list(str_concat(sh-join(args, " "), "\n"), 0);
    def sh-bi-cat(args, stdin) = {
        let ops = sh-operands(args);
        list(nil?(ops) ? stdin : sh-cat-files(ops), 0);
    };
    def sh-grep-match?(line, pat, ic) = ic ? sh-contains?(sh-lc(line), sh-lc(pat)) : sh-contains?(line, pat);
    def sh-grep-filter(lines, pat, inv, ic) = nil?(lines) ? empty() : {
        let m = sh-grep-match?(head(lines), pat, ic);
        (inv ? !m : m) ? cons(head(lines), sh-grep-filter(tail(lines), pat, inv, ic)) : sh-grep-filter(tail(lines), pat, inv, ic);
    };
    def sh-bi-grep(args, stdin) = {
        let matched = sh-grep-filter(sh-lines(stdin), sh-first-nonflag(args), sh-flag?(args, "v"), sh-flag?(args, "i"));
        let e = len(matched) > 0 ? 0 : 1;
        sh-flag?(args, "c") ? list(str_concat(int_to_str(len(matched)), "\n"), e) : list(sh-join-nl(matched), e);
    };
    def sh-bi-wc(args, stdin) = list(str_concat(int_to_str(sh-flag?(args, "w") ? sh-count-words(stdin) : sh-flag?(args, "c") ? str_len(stdin) : len(sh-lines(stdin))), "\n"), 0);
    def sh-bi-head(args, stdin) = {
        let n = sh-first-num(args);
        list(sh-join-nl(sh-take(sh-lines(stdin), n <= 0 ? 10 : n)), 0);
    };
    def sh-bi-tail(args, stdin) = {
        let n = sh-first-num(args);
        list(sh-join-nl(sh-take-last(sh-lines(stdin), n <= 0 ? 10 : n)), 0);
    };
    def sh-bi-seq(args, stdin) = {
        let ops = sh-operands(args);
        len(ops) >= 2 ? list(sh-join-nl(sh-seq-range(str_to_int(nth(ops, 0)), str_to_int(nth(ops, 1)))), 0) : list(sh-join-nl(sh-seq-build(1, sh-first-num(args))), 0);
    };
    def sh-bi-rev(args, stdin) = list(sh-join-nl(sh-map-rev(sh-lines(stdin))), 0);
    def sh-bi-sort(args, stdin) = {
        let s = sh-sort(sh-lines(stdin));
        list(sh-join-nl(sh-flag?(args, "r") ? reverse-acc(s) : s), 0);
    };
    def sh-bi-uniq(args, stdin) = list(sh-join-nl(sh-uniq(sh-lines(stdin))), 0);
    def sh-bi-tr(args, stdin) = {
        let ops = sh-operands(args);
        list(sh-tr-str(stdin, len(ops) >= 1 ? nth(ops, 0) : "", len(ops) >= 2 ? nth(ops, 1) : ""), 0);
    };
    def sh-bi-nl(args, stdin) = list(sh-join-nl(sh-nl-lines(sh-lines(stdin), 1)), 0);
    //; Form-native speaker route for live-room carriers. Args:
    //;   vd-route F0 W1 W2 W3 W4 FLOOR NEWLABEL
    //; The roster fixture carries the shipped speaker decision floor.
    def sh-int-arg(args, idx, fallback) = len(args) >= idx + 1 ? str_to_int(nth(args, idx)) : fallback;
    def sh-str-arg(args, idx, fallback) = len(args) >= idx + 1 ? nth(args, idx) : fallback;
    def sh-vd-default-roster() = list(list("Voz1", vd-features(120, list(2, 2, 3, 2))), list("Voz2", vd-features(220, list(1, 5, 2, 7))));
    def sh-bi-vd-route(args, stdin) = {
        let f0 = sh-int-arg(args, 0, 150);
        let windows = list(sh-int-arg(args, 1, 2), sh-int-arg(args, 2, 2), sh-int-arg(args, 3, 2), sh-int-arg(args, 4, 2));
        let floor = sh-int-arg(args, 5, 3);
        let newlabel = sh-str-arg(args, 6, "Voz3");
        let route = vd-route(sh-vd-default-roster(), f0, windows, floor, newlabel);
        list(str_concat(vd-spoke-of(route), "\n"), 0);
    };
    //; test / [ : structural comparisons -> exit code
    def sh-test-strip(args) = nil?(args) ? args : nil?(tail(args)) ? (String) head(args) == "]" ? empty() : args : cons(head(args), sh-test-strip(tail(args)));
    def sh-test(raw) = {
        let a = sh-test-strip(raw);
        (Comparable) len(a) == 1 ? str_len(nth(a, 0)) > 0 ? 0 : 1 : (Comparable) len(a) == 2 ? (String) nth(a, 0) == "-z" ? (Comparable) str_len(nth(a, 1)) == 0 ? 0 : 1 : (String) nth(a, 0) == "-n" ? str_len(nth(a, 1)) > 0 ? 0 : 1 : 1 : (Comparable) len(a) == 3 ? {
            let l = nth(a, 0);
            let op = nth(a, 1);
            let r = nth(a, 2);
            (String) op == "=" ? (String) l == r ? 0 : 1 : (String) op == "!=" ? (String) l == r ? 1 : 0 : (String) op == "-eq" ? (Comparable) str_to_int(l) == str_to_int(r) ? 0 : 1 : (String) op == "-ne" ? (Comparable) str_to_int(l) == str_to_int(r) ? 1 : 0 : (String) op == "-lt" ? str_to_int(l) < str_to_int(r) ? 0 : 1 : (String) op == "-le" ? str_to_int(l) <= str_to_int(r) ? 0 : 1 : (String) op == "-gt" ? str_to_int(l) > str_to_int(r) ? 0 : 1 : (String) op == "-ge" ? str_to_int(l) >= str_to_int(r) ? 0 : 1 : 1;
        } : 1;
    };
    def sh-bi-test(args, stdin) = list("", sh-test(args));
    //; ── awk (first breath): the unix tool as a Form recipe, not passthrough ──
    //; Covers the field idioms shell scripts lean on most (FS = whitespace):
    //;   {print $N}          print field N of each line ($0 = whole line)
    //;   $N==RHS             print lines whose field N equals RHS ("str" or bareword)
    //;   $N==RHS{print $M}   filter on field N, then print field M
    //; Single-digit field refs, one pattern + one print action, literal RHS. NOT
    //; full awk (no -F, BEGIN/END, arithmetic, field-to-field compare, multi-rule)
    //; — the named floor, grown by need exactly like the other native builtins.
    def sh-awk-field(line, n) =     // $0 = whole line; $n = nth whitespace field
n <= 0 ? line : {
        let fs = sh-words(line, 0, "", empty());
        n <= len(fs) ? nth(fs, n - 1) : "";
    };
    def sh-awk-trim-l(s) = (Comparable) str_len(s) == 0 ? s : is-ws-cp(ord(char_at(s, 0))) ? sh-awk-trim-l(substring(s, 1, str_len(s))) : s;
    def sh-awk-trim-r(s) = (Comparable) str_len(s) == 0 ? s : is-ws-cp(ord(char_at(s, str_len(s) - 1))) ? sh-awk-trim-r(substring(s, 0, str_len(s) - 1)) : s;
    def sh-awk-trim(s) = sh-awk-trim-r(sh-awk-trim-l(s));
    def sh-awk-unq(s) =     // strip a surrounding pair of double-quotes
str_len(s) >= 2 && ((String) substring(s, 0, 1) == "\"" && (String) substring(s, str_len(s) - 1, str_len(s)) == "\"") ? substring(s, 1, str_len(s) - 1) : s;
    def sh-awk-field-ref(seg) =     // digit in the first "$N" of seg, else 0
{
        let i = find-from(seg, "$", 0);
        i < 0 ? 0 : {
            let c = ord(char_at(seg, i + 1));
            c >= 48 && c <= 57 ? c - 48 : 0;
        };
    };
    def sh-awk-before-brace(p) = {
        let i = find-from(p, "{", 0);
        i < 0 ? p : substring(p, 0, i);
    };
    def sh-awk-brace-body(p) = {
        let i = find-from(p, "{", 0);
        i < 0 ? "" : {
            let j = find-from(p, "}", i);
            substring(p, i + 1, j < 0 ? str_len(p) : j);
        };
    };
    def sh-awk-rhs(pat) =     // literal after "==", trimmed + unquoted
{
        let i = find-from(pat, "==", 0);
        i < 0 ? "" : sh-awk-unq(sh-awk-trim(substring(pat, i + 2, str_len(pat))));
    };
    def sh-awk-emit(lines, hp, pf, prhs, af) =     // one output line per matching input line
nil?(lines) ? empty() : {
        let ln = head(lines);
        (hp ? (String) sh-awk-field(ln, pf) == prhs : true) ? cons(sh-awk-field(ln, af), sh-awk-emit(tail(lines), hp, pf, prhs, af)) : sh-awk-emit(tail(lines), hp, pf, prhs, af);
    };
    def sh-bi-awk(args, stdin) = {
        let p = sh-first-nonflag(args);
        // the awk program (a single-quoted arg)
        let pat = sh-awk-before-brace(p);
        list(sh-join-nl(sh-awk-emit(sh-lines(stdin), find-from(pat, "==", 0) >= 0, sh-awk-field-ref(pat), sh-awk-rhs(pat), sh-awk-field-ref(sh-awk-brace-body(p)))), 0);
    };
    def sh-builtin?(name) = (String) name == "echo" || ((String) name == "cat" || ((String) name == "grep" || ((String) name == "wc" || ((String) name == "head" || ((String) name == "tail" || ((String) name == "seq" || ((String) name == "rev" || ((String) name == "sort" || ((String) name == "uniq" || ((String) name == "tr" || ((String) name == "nl" || ((String) name == "awk" || ((String) name == "test" || ((String) name == "[" || ((String) name == "vd-route" || ((String) name == "true" || (String) name == "false"))))))))))))))));
    def sh-run-builtin(name, args, stdin) = (String) name == "echo" ? sh-bi-echo(args, stdin) : (String) name == "cat" ? sh-bi-cat(args, stdin) : (String) name == "grep" ? sh-bi-grep(args, stdin) : (String) name == "wc" ? sh-bi-wc(args, stdin) : (String) name == "head" ? sh-bi-head(args, stdin) : (String) name == "tail" ? sh-bi-tail(args, stdin) : (String) name == "seq" ? sh-bi-seq(args, stdin) : (String) name == "rev" ? sh-bi-rev(args, stdin) : (String) name == "sort" ? sh-bi-sort(args, stdin) : (String) name == "uniq" ? sh-bi-uniq(args, stdin) : (String) name == "tr" ? sh-bi-tr(args, stdin) : (String) name == "nl" ? sh-bi-nl(args, stdin) : (String) name == "awk" ? sh-bi-awk(args, stdin) : (String) name == "test" ? sh-bi-test(args, stdin) : (String) name == "[" ? sh-bi-test(args, stdin) : (String) name == "vd-route" ? sh-bi-vd-route(args, stdin) : (String) name == "true" ? list("", 0) : (String) name == "false" ? list("", 1) : list("", 0);
    //; ── assignment NAME=value (a lone word whose head is alpha/_) ────────
    def sh-assign?(name) = {
        let i = find-from(name, "=", 0);
        i > 0 ? is-alpha-cp(ord(char_at(name, 0))) : false;
    };
    def sh-assign-name(name) = substring(name, 0, find-from(name, "=", 0));
    def sh-assign-val(name) = substring(name, find-from(name, "=", 0) + 1, str_len(name));
    //; ── variable environment (alist name -> value); $? rides as "?" ──────
    def sh-env-empty() = list(list("?", "0"));
    def sh-env-set(env, name, val) = cons(list(name, val), env);
    def sh-env-get(env, name) = nil?(env) ? "" : (String) head(head(env)) == name ? head(tail(head(env))) : sh-env-get(tail(env), name);
    //; ── resolve a command's args (leaves literal, $var resolved, redirs out) ──
    def sh-arg-val(part, env) = sh-leaf?(part) ? node_value(part) : (String) sh-tag(part) == "__var__" ? sh-env-get(env, node_value(nth(node_children(part), 1))) : "";
    def sh-collect-args(parts, env) = nil?(parts) ? empty() : {
        let p = head(parts);
        (sh-leaf?(p) ? false : sh-redir-tag?(sh-tag(p))) ? sh-collect-args(tail(parts), env) : cons(sh-arg-val(p, env), sh-collect-args(tail(parts), env));
    };
    def sh-collect-redirs(parts) = nil?(parts) ? empty() : {
        let p = head(parts);
        (sh-leaf?(p) ? false : sh-redir-tag?(sh-tag(p))) ? cons(list(sh-tag(p), node_value(nth(node_children(p), 1))), sh-collect-redirs(tail(parts))) : sh-collect-redirs(tail(parts));
    };
    def sh-quote-arg(a) = find-from(a, " ", 0) >= 0 ? str_concat("\"", str_concat(a, "\"")) : a;
    def sh-quote-args(args) = nil?(args) ? empty() : cons(sh-quote-arg(head(args)), sh-quote-args(tail(args)));
    def sh-cmdline(name, args) = nil?(args) ? name : str_concat(name, str_concat(" ", sh-join(sh-quote-args(args), " ")));
    def sh-last(xs) = nil?(tail(xs)) ? head(xs) : sh-last(tail(xs));
    def sh-butlast(xs) = nil?(xs) ? empty() : nil?(tail(xs)) ? empty() : cons(head(xs), sh-butlast(tail(xs)));
    //; ── evaluate: (node env) -> (list stdout env exit) ──────────────────
    def sh-eval(node, env) = sh-eval-in(node, env, "");
    def sh-eval-in(node, env, stdin) = {
        let t = sh-tag(node);
        (String) t == "__seq__" ? sh-eval-seq(sh-rest(node), env, "", 0) : (String) t == "__while__" ? sh-eval-while(sh-rest(node), env) : (String) t == "__for__" ? sh-eval-for(sh-rest(node), env) : (String) t == "__andor__" ? sh-eval-andor(sh-rest(node), env, stdin) : (String) t == "__pipe__" ? sh-eval-pipe(sh-rest(node), env, stdin) : sh-eval-command(node, env, stdin);
    };
    def sh-eval-seq(stmts, env, acc, lastexit) = nil?(stmts) ? list(acc, env, lastexit) : {
        let r = sh-eval-in(head(stmts), env, "");
        sh-eval-seq(tail(stmts), r-env(r), str_concat(acc, r-out(r)), r-exit(r));
    };
    def sh-eval-andor(parts, env, stdin) = {
        let r = sh-eval-in(head(parts), env, stdin);
        sh-eval-andor-loop(tail(parts), r-env(r), r-out(r), r-exit(r));
    };
    def sh-eval-andor-loop(ops, env, outacc, lastexit) = nil?(ops) ? list(outacc, env, lastexit) : {
        let op = head(ops);
        let run? = (String) sh-tag(op) == "__&&__" ? (Comparable) lastexit == 0 : !((Comparable) lastexit == 0);
        run? ? {
            let r = sh-eval-in(head(sh-rest(op)), env, "");
            sh-eval-andor-loop(tail(ops), r-env(r), str_concat(outacc, r-out(r)), r-exit(r));
        } : sh-eval-andor-loop(tail(ops), env, outacc, lastexit);
    };
    def sh-eval-pipe(cmds, env, stdin) = nil?(cmds) ? list(stdin, env, 0) : {
        let r = sh-eval-in(head(cmds), env, stdin);
        nil?(tail(cmds)) ? r : sh-eval-pipe(tail(cmds), r-env(r), r-out(r));
    };
    def sh-loop-limit() = 100000;
    def sh-eval-while(rest, env) = sh-eval-while-loop(nth(rest, 0), nth(rest, 1), env, "", 0);
    def sh-eval-while-loop(cond, body, env, acc, iter) = iter >= sh-loop-limit() ? list(acc, sh-env-set(env, "?", "124"), 124) : {
        let cr = sh-eval-in(cond, env, "");
        let acc2 = str_concat(acc, r-out(cr));
        (Comparable) r-exit(cr) == 0 ? {
            let br = sh-eval-in(body, r-env(cr), "");
            sh-eval-while-loop(cond, body, r-env(br), str_concat(acc2, r-out(br)), iter + 1);
        } : list(acc2, r-env(cr), r-exit(cr));
    };
    def sh-eval-for(rest, env) = {
        let var = node_value(head(rest));
        let tailrest = tail(rest);
        sh-eval-for-items(var, sh-butlast(tailrest), sh-last(tailrest), env, "");
    };
    def sh-eval-for-items(var, items, body, env, acc) = nil?(items) ? list(acc, sh-env-set(env, "?", "0"), 0) : {
        let item = sh-arg-val(head(items), env);
        let env2 = sh-env-set(env, var, item);
        let r = sh-eval-in(body, env2, "");
        sh-eval-for-items(var, tail(items), body, r-env(r), str_concat(acc, r-out(r)));
    };
    // The default command evaluator is a named seam.  A closed Form extension
    // may late-bind `sh-eval-command` and delegate every other command here;
    // this base shell owns no process-execution route.
    def sh-eval-command-default(node, env, stdin) = {
        let name = sh-tag(node);
        sh-assign?(name) ? list("", sh-env-set(env, sh-assign-name(name), sh-assign-val(name)), 0) : {
            let args = sh-collect-args(sh-rest(node), env);
            sh-builtin?(name) ? {
                let br = sh-run-builtin(name, args, stdin);
                let e = nth(br, 1);
                list(nth(br, 0), sh-env-set(env, "?", int_to_str(e)), e);
            } : list(str_concat("[passthrough] ", sh-cmdline(name, args)), sh-env-set(env, "?", "0"), 0);
        };
    };
    def sh-eval-command(node, env, stdin) = sh-eval-command-default(node, env, stdin);
    //; convenience
    def sh-out(src) = r-out(sh-eval(sh-parse(src), sh-env-empty()));
    def sh-exit(src) = r-exit(sh-eval(sh-parse(src), sh-env-empty()));
    //; ── plan: flat native/passthrough step list for a live runner ────────
    def sh-plan(node) = sh-plan-node(node);
    def sh-plan-node(node) = {
        let t = sh-tag(node);
        (String) t == "__while__" ? append(sh-plan-node(nth(sh-rest(node), 0)), sh-plan-node(nth(sh-rest(node), 1))) : (String) t == "__for__" ? sh-plan-node(sh-last(sh-rest(node))) : (String) t == "__seq__" || ((String) t == "__pipe__" || ((String) t == "__andor__" || ((String) t == "__&&__" || (String) t == "__||__"))) ? sh-plan-list(sh-rest(node)) : sh-plan-command(node);
    };
    def sh-plan-list(xs) = nil?(xs) ? empty() : append(sh-plan-node(head(xs)), sh-plan-list(tail(xs)));
    // As with evaluation, planners extend through a named default rather than
    // by teaching the base shell a host-facing command.
    def sh-plan-kind-default(name) = sh-builtin?(name) ? "native" : "passthrough";
    // Keep the former public helper available while extensions delegate through
    // the default seam above.
    def sh-plan-kind(name) = sh-plan-kind-default(name);
    def sh-plan-command-default(node) = {
        let name = sh-tag(node);
        sh-assign?(name) ? list(list("assign", sh-assign-name(name), list(sh-assign-val(name)), empty())) : {
            let parts = sh-rest(node);
            let args = sh-collect-args(parts, sh-env-empty());
            let redirs = sh-collect-redirs(parts);
            list(list(sh-plan-kind-default(name), name, args, redirs));
        };
    };
    def sh-plan-command(node) = sh-plan-command-default(node);
    def sh-step-kind(s) = nth(s, 0);
    def sh-step-name(s) = nth(s, 1);
    def sh-step-args(s) = nth(s, 2);
    def sh-step-redirs(s) = nth(s, 3);
}
