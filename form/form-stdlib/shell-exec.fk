// shell-exec.fk — the form-native shell executor (v2: exit codes + && / || + builtins).
//
// Walks the fncall AST from shell-grammar.fk and RUNS it. Two tiers:
//   - NATIVE form builtins compute output IN FORM — no host tool. Each is a native
//     form version of the unix tool, the thing that replaces passthrough.
//   - PASSTHROUGH for every other command: an explicit non-executing label.  It
//     never invokes a host shell, popen, or another process.
//
// Every evaluation returns (list stdout env exit): exit is the command's status,
// stored back in env as $? so `&&`/`||`/test compose. Pure, so a band asserts the
// exact stdout/exit and crosses to the 4th kernel.
//
import form-stdlib/core.fk;
import form-stdlib/form-ontology-bp.fk;
import form-stdlib/line-grammar.fk;
import form-stdlib/bmf-core.fk;
import form-stdlib/bmf-grammar.fk;
import form-stdlib/grammar-loader.fk;
import form-stdlib/shell-grammar.fk;
import form-stdlib/voice-traits.fk;
import form-stdlib/feature-vector.fk;
import form-stdlib/nearest-shape.fk;
import form-stdlib/voice-diarize.fk;
section [form.bml] {
    //; ── node helpers (the AST is all fncall(TAG, kids...); leaves are literals) ──
    def sh-leaf?(n) = nil?(node_children(n));
    def sh-tag(n) = sh-leaf?(n) ? "" : node_value(node_children(n)[0]);
    def sh-rest(n) = node_children(n)[1:];
    def sh-redir-tag?(t) = (String) t == "__redir__" || ((String) t == "__append__" || (String) t == "__from__");
    //; ── result tuple (stdout env exit) ──────────────────────────────────
    def r-out(r) = r[0];
    def r-env(r) = r[1];
    def r-exit(r) = r[2];
    //; ── string helpers ──────────────────────────────────────────────────
    def sh-contains?(s, sub) = find-from(s, sub, 0) >= 0;
    def sh-join(xs, sep) = nil?(xs) ? "" : nil?(xs[1:]) ? xs[0] : (xs[0] + ((String) sep + sh-join(xs[1:], sep)));
    def sh-drop-trailing-empty(ls) = nil?(ls) ? ls : nil?(ls[1:]) ? (String) ls[0] == "" ? empty() : ls : cons(ls[0], sh-drop-trailing-empty(ls[1:]));
    def sh-lines(s) = sh-drop-trailing-empty(split-on(s, "\n"));
    def sh-join-nl(xs) = nil?(xs) ? "" : (sh-join(xs, "\n") + "\n");
    def sh-take(xs, n) = nil?(xs) ? empty() : n <= 0 ? empty() : cons(xs[0], sh-take(xs[1:], n - 1));
    def sh-take-last(xs, n) = reverse-acc(sh-take(reverse-acc(xs), n));
    // Reversing [i, j) is the reversed RIGHT half followed by the reversed left
    // half — so the same bytes come out in the same order without ever cutting a
    // tail. The first form peeled one byte and re-sliced everything after it, so
    // reversing n bytes made n slices of average length n/2: quadratic in the
    // slicing alone, and each slice was itself quadratic before core.fk's
    // substring was rebalanced on 2026-08-25. Measured then, on the peeling
    // form with the balanced substring already under it: 256 bytes 0.08 s,
    // 1,024 bytes 0.18 s, 2,048 bytes 0.50 s — still superlinear, because a
    // cheaper slice does not fix a loop that takes n of them.
    //
    // Index-based and halved, nothing is sliced at all: one byte is read at each
    // of the n leaves and the joins form a balanced tree.
    def sh-rev-range(s, i, j) = {
        let n = j - i;
        n <= 0 ? "" : (Comparable) n == 1 ? byte_to_str(str_byte_at(s, i)) : {
            let mid = i + n / 2;
            ((String) sh-rev-range(s, mid, j) + sh-rev-range(s, i, mid));
        };
    };
    def sh-rev-str(s) = sh-rev-range(s, 0, len(s));
    def sh-seq-build(i, n) = i > n ? empty() : cons(i.str(), sh-seq-build(i + 1, n));
    def sh-seq-range(a, b) = a > b ? empty() : cons(a.str(), sh-seq-range(a + 1, b));
    def sh-str-lt(a, b) = (Comparable) len(a) == 0 ? len(b) > 0 : (Comparable) len(b) == 0 ? false : {
        let ca = ord(char_at(a, 0));
        let cb = ord(char_at(b, 0));
        ca < cb ? true : ca > cb ? false : sh-str-lt(substring(a, 1, len(a)), substring(b, 1, len(b)));
    };
    def sh-insert(x, sorted) = nil?(sorted) ? [x] : sh-str-lt(x, sorted[0]) ? cons(x, sorted) : cons(sorted[0], sh-insert(x, sorted[1:]));
    def sh-sort(xs) = nil?(xs) ? empty() : sh-insert(xs[0], sh-sort(xs[1:]));
    def sh-uniq(xs) = nil?(xs) ? empty() : nil?(xs[1:]) ? xs : (String) xs[0] == xs[1:][0] ? sh-uniq(xs[1:]) : cons(xs[0], sh-uniq(xs[1:]));
    def sh-lc-char(c) = {
        let o = ord(c);
        o >= 65 && o <= 90 ? byte_to_str(o + 32) : c;
    };
    def sh-lc(s) = (Comparable) len(s) == 0 ? "" : ((String) sh-lc-char(substring(s, 0, 1)) + sh-lc(substring(s, 1, len(s))));
    def sh-tr-char(c, s1, s2) = {
        let i = find-from(s1, c, 0);
        i < 0 ? c : i < len(s2) ? substring(s2, i, i + 1) : c;
    };
    def sh-tr-str(s, s1, s2) = (Comparable) len(s) == 0 ? "" : ((String) sh-tr-char(substring(s, 0, 1), s1, s2) + sh-tr-str(substring(s, 1, len(s)), s1, s2));
    def sh-words(s, i, cur, acc) = i >= len(s) ? (Comparable) len(cur) == 0 ? reverse-acc(acc) : reverse-acc(cons(cur, acc)) : is-ws-cp(ord(char_at(s, i))) ? (Comparable) len(cur) == 0 ? sh-words(s, i + 1, "", acc) : sh-words(s, i + 1, "", cons(cur, acc)) : sh-words(s, i + 1, ((String) cur + substring(s, i, i + 1)), acc);
    def sh-count-words(s) = len(sh-words(s, 0, "", empty()));
    def sh-nl-lines(lines, n) = nil?(lines) ? empty() : (Comparable) len(lines[0]) == 0 ? cons("", sh-nl-lines(lines[1:], n)) : cons((n.str() + ("\t" + lines[0])), sh-nl-lines(lines[1:], n + 1));
    //; ── flag / operand parsing (a dash-arg is a flag; -X carries char flags) ──
    def sh-flag?(args, ch) = nil?(args) ? false : {
        let a = args[0];
        starts-with?(a, "-") && len(a) > 1 ? find-from(a, ch, 1) >= 1 ? true : sh-flag?(args[1:], ch) : sh-flag?(args[1:], ch);
    };
    def sh-operands(args) = nil?(args) ? empty() : starts-with?(args[0], "-") ? sh-operands(args[1:]) : cons(args[0], sh-operands(args[1:]));
    def sh-first-nonflag(args) = nil?(args) ? "" : starts-with?(args[0], "-") ? sh-first-nonflag(args[1:]) : args[0];
    def sh-first-num(args) = nil?(args) ? 0 : is-digit-cp(ord(char_at(args[0], 0))) ? str_to_int(args[0]) : sh-first-num(args[1:]);
    def sh-cat-files(args) = nil?(args) ? "" : ((String) read_file(args[0]) + sh-cat-files(args[1:]));
    def sh-map-rev(lines) = nil?(lines) ? empty() : cons(sh-rev-str(lines[0]), sh-map-rev(lines[1:]));
    //; ── native builtins: (args stdin) -> (list stdout exit) ─────────────
    def sh-bi-echo(args, stdin) = (nil?(args) ? false : (String) args[0] == "-n") ? [sh-join(args[1:], " "), 0] : [(sh-join(args, " ") + "\n"), 0];
    def sh-bi-cat(args, stdin) = {
        let ops = sh-operands(args);
        [nil?(ops) ? stdin : sh-cat-files(ops), 0];
    };
    def sh-grep-match?(line, pat, ic) = ic ? sh-contains?(sh-lc(line), sh-lc(pat)) : sh-contains?(line, pat);
    def sh-grep-filter(lines, pat, inv, ic) = nil?(lines) ? empty() : {
        let m = sh-grep-match?(lines[0], pat, ic);
        (inv ? !m : m) ? cons(lines[0], sh-grep-filter(lines[1:], pat, inv, ic)) : sh-grep-filter(lines[1:], pat, inv, ic);
    };
    def sh-bi-grep(args, stdin) = {
        let matched = sh-grep-filter(sh-lines(stdin), sh-first-nonflag(args), sh-flag?(args, "v"), sh-flag?(args, "i"));
        let e = len(matched) > 0 ? 0 : 1;
        sh-flag?(args, "c") ? [(len(matched).str() + "\n"), e] : [sh-join-nl(matched), e];
    };
    def sh-bi-wc(args, stdin) = [((sh-flag?(args, "w") ? sh-count-words(stdin) : sh-flag?(args, "c") ? len(stdin) : len(sh-lines(stdin))).str() + "\n"), 0];
    def sh-bi-head(args, stdin) = {
        let n = sh-first-num(args);
        [sh-join-nl(sh-take(sh-lines(stdin), n <= 0 ? 10 : n)), 0];
    };
    def sh-bi-tail(args, stdin) = {
        let n = sh-first-num(args);
        [sh-join-nl(sh-take-last(sh-lines(stdin), n <= 0 ? 10 : n)), 0];
    };
    def sh-bi-seq(args, stdin) = {
        let ops = sh-operands(args);
        len(ops) >= 2 ? [sh-join-nl(sh-seq-range(str_to_int(ops[0]), str_to_int(ops[1]))), 0] : [sh-join-nl(sh-seq-build(1, sh-first-num(args))), 0];
    };
    def sh-bi-rev(args, stdin) = [sh-join-nl(sh-map-rev(sh-lines(stdin))), 0];
    def sh-bi-sort(args, stdin) = {
        let s = sh-sort(sh-lines(stdin));
        [sh-join-nl(sh-flag?(args, "r") ? reverse-acc(s) : s), 0];
    };
    def sh-bi-uniq(args, stdin) = [sh-join-nl(sh-uniq(sh-lines(stdin))), 0];
    def sh-bi-tr(args, stdin) = {
        let ops = sh-operands(args);
        [sh-tr-str(stdin, len(ops) >= 1 ? ops[0] : "", len(ops) >= 2 ? ops[1] : ""), 0];
    };
    def sh-bi-nl(args, stdin) = [sh-join-nl(sh-nl-lines(sh-lines(stdin), 1)), 0];
    //; Form-native speaker route for live-room carriers. Args:
    //;   vd-route F0 W1 W2 W3 W4 FLOOR NEWLABEL
    //; The roster fixture carries the shipped speaker decision floor.
    def sh-int-arg(args, idx, fallback) = len(args) >= idx + 1 ? str_to_int(args[idx]) : fallback;
    def sh-str-arg(args, idx, fallback) = len(args) >= idx + 1 ? args[idx] : fallback;
    def sh-vd-default-roster() = [["Voz1", vd-features(120, [2, 2, 3, 2])], ["Voz2", vd-features(220, [1, 5, 2, 7])]];
    def sh-bi-vd-route(args, stdin) = {
        let f0 = sh-int-arg(args, 0, 150);
        let windows = [sh-int-arg(args, 1, 2), sh-int-arg(args, 2, 2), sh-int-arg(args, 3, 2), sh-int-arg(args, 4, 2)];
        let floor = sh-int-arg(args, 5, 3);
        let newlabel = sh-str-arg(args, 6, "Voz3");
        let route = vd-route(sh-vd-default-roster(), f0, windows, floor, newlabel);
        [(vd-spoke-of(route) + "\n"), 0];
    };
    //; test / [ : structural comparisons -> exit code
    def sh-test-strip(args) = nil?(args) ? args : nil?(args[1:]) ? (String) args[0] == "]" ? empty() : args : cons(args[0], sh-test-strip(args[1:]));
    def sh-test(raw) = {
        let a = sh-test-strip(raw);
        (Comparable) len(a) == 1 ? len(a[0]) > 0 ? 0 : 1 : (Comparable) len(a) == 2 ? (String) a[0] == "-z" ? (Comparable) len(a[1]) == 0 ? 0 : 1 : (String) a[0] == "-n" ? len(a[1]) > 0 ? 0 : 1 : 1 : (Comparable) len(a) == 3 ? {
            let l = a[0];
            let op = a[1];
            let r = a[2];
            (String) op == "=" ? (String) l == r ? 0 : 1 : (String) op == "!=" ? (String) l == r ? 1 : 0 : (String) op == "-eq" ? (Comparable) str_to_int(l) == str_to_int(r) ? 0 : 1 : (String) op == "-ne" ? (Comparable) str_to_int(l) == str_to_int(r) ? 1 : 0 : (String) op == "-lt" ? str_to_int(l) < str_to_int(r) ? 0 : 1 : (String) op == "-le" ? str_to_int(l) <= str_to_int(r) ? 0 : 1 : (String) op == "-gt" ? str_to_int(l) > str_to_int(r) ? 0 : 1 : (String) op == "-ge" ? str_to_int(l) >= str_to_int(r) ? 0 : 1 : 1;
        } : 1;
    };
    def sh-bi-test(args, stdin) = ["", sh-test(args)];
    //; ── awk (first breath): the unix tool as a Form recipe, not passthrough ──
    //; Covers the field idioms shell scripts lean on most (FS = whitespace):
    //;   {print $N}          print field N of each line ($0 = whole line)
    //;   $N==RHS             print lines whose field N equals RHS ("str" or bareword)
    //;   $N==RHS{print $M}   filter on field N, then print field M
    //; Single-digit field refs, one pattern + one print action, literal RHS. NOT
    //; full awk (no -F, BEGIN/END, arithmetic, field-to-field compare, multi-rule)
    //; — the named floor, grown by need exactly like the other native builtins.
    def sh-awk-field(line, n) =     // $0 = whole line; $n = nth whitespace field
n <= 0 ? line : {
        let fs = sh-words(line, 0, "", empty());
        n <= len(fs) ? fs[n - 1] : "";
    };
    def sh-awk-trim-l(s) = (Comparable) len(s) == 0 ? s : is-ws-cp(ord(char_at(s, 0))) ? sh-awk-trim-l(substring(s, 1, len(s))) : s;
    def sh-awk-trim-r(s) = (Comparable) len(s) == 0 ? s : is-ws-cp(ord(char_at(s, len(s) - 1))) ? sh-awk-trim-r(substring(s, 0, len(s) - 1)) : s;
    def sh-awk-trim(s) = sh-awk-trim-r(sh-awk-trim-l(s));
    def sh-awk-unq(s) =     // strip a surrounding pair of double-quotes
len(s) >= 2 && ((String) substring(s, 0, 1) == "\"" && (String) substring(s, len(s) - 1, len(s)) == "\"") ? substring(s, 1, len(s) - 1) : s;
    def sh-awk-field-ref(seg) =     // digit in the first "$N" of seg, else 0
{
        let i = find-from(seg, "$", 0);
        i < 0 ? 0 : {
            let c = ord(char_at(seg, i + 1));
            c >= 48 && c <= 57 ? c - 48 : 0;
        };
    };
    def sh-awk-before-brace(p) = {
        let i = find-from(p, "{", 0);
        i < 0 ? p : substring(p, 0, i);
    };
    def sh-awk-brace-body(p) = {
        let i = find-from(p, "{", 0);
        i < 0 ? "" : {
            let j = find-from(p, "}", i);
            substring(p, i + 1, j < 0 ? len(p) : j);
        };
    };
    def sh-awk-rhs(pat) =     // literal after "==", trimmed + unquoted
{
        let i = find-from(pat, "==", 0);
        i < 0 ? "" : sh-awk-unq(sh-awk-trim(substring(pat, i + 2, len(pat))));
    };
    def sh-awk-emit(lines, hp, pf, prhs, af) =     // one output line per matching input line
nil?(lines) ? empty() : {
        let ln = lines[0];
        (hp ? (String) sh-awk-field(ln, pf) == prhs : true) ? cons(sh-awk-field(ln, af), sh-awk-emit(lines[1:], hp, pf, prhs, af)) : sh-awk-emit(lines[1:], hp, pf, prhs, af);
    };
    def sh-bi-awk(args, stdin) = {
        let p = sh-first-nonflag(args);
        // the awk program (a single-quoted arg)
        let pat = sh-awk-before-brace(p);
        [sh-join-nl(sh-awk-emit(sh-lines(stdin), find-from(pat, "==", 0) >= 0, sh-awk-field-ref(pat), sh-awk-rhs(pat), sh-awk-field-ref(sh-awk-brace-body(p)))), 0];
    };
    def sh-builtin?(name) = (String) name == "echo" || ((String) name == "cat" || ((String) name == "grep" || ((String) name == "wc" || ((String) name == "head" || ((String) name == "tail" || ((String) name == "seq" || ((String) name == "rev" || ((String) name == "sort" || ((String) name == "uniq" || ((String) name == "tr" || ((String) name == "nl" || ((String) name == "awk" || ((String) name == "test" || ((String) name == "[" || ((String) name == "vd-route" || ((String) name == "true" || (String) name == "false"))))))))))))))));
    def sh-run-builtin(name, args, stdin) = (String) name == "echo" ? sh-bi-echo(args, stdin) : (String) name == "cat" ? sh-bi-cat(args, stdin) : (String) name == "grep" ? sh-bi-grep(args, stdin) : (String) name == "wc" ? sh-bi-wc(args, stdin) : (String) name == "head" ? sh-bi-head(args, stdin) : (String) name == "tail" ? sh-bi-tail(args, stdin) : (String) name == "seq" ? sh-bi-seq(args, stdin) : (String) name == "rev" ? sh-bi-rev(args, stdin) : (String) name == "sort" ? sh-bi-sort(args, stdin) : (String) name == "uniq" ? sh-bi-uniq(args, stdin) : (String) name == "tr" ? sh-bi-tr(args, stdin) : (String) name == "nl" ? sh-bi-nl(args, stdin) : (String) name == "awk" ? sh-bi-awk(args, stdin) : (String) name == "test" ? sh-bi-test(args, stdin) : (String) name == "[" ? sh-bi-test(args, stdin) : (String) name == "vd-route" ? sh-bi-vd-route(args, stdin) : (String) name == "true" ? ["", 0] : (String) name == "false" ? ["", 1] : ["", 0];
    //; ── assignment NAME=value (a lone word whose head is alpha/_) ────────
    def sh-assign?(name) = {
        let i = find-from(name, "=", 0);
        i > 0 ? is-alpha-cp(ord(char_at(name, 0))) : false;
    };
    def sh-assign-name(name) = substring(name, 0, find-from(name, "=", 0));
    def sh-assign-val(name) = substring(name, find-from(name, "=", 0) + 1, len(name));
    //; ── variable environment (alist name -> value); $? rides as "?" ──────
    def sh-env-empty() = [["?", "0"]];
    def sh-env-set(env, name, val) = cons([name, val], env);
    def sh-env-get(env, name) = nil?(env) ? "" : (String) env[0][0] == name ? env[0][1:][0] : sh-env-get(env[1:], name);
    //; ── resolve a command's args (leaves literal, $var resolved, redirs out) ──
    def sh-arg-val(part, env) = sh-leaf?(part) ? node_value(part) : (String) sh-tag(part) == "__var__" ? sh-env-get(env, node_value(node_children(part)[1])) : "";
    def sh-collect-args(parts, env) = nil?(parts) ? empty() : {
        let p = parts[0];
        (sh-leaf?(p) ? false : sh-redir-tag?(sh-tag(p))) ? sh-collect-args(parts[1:], env) : cons(sh-arg-val(p, env), sh-collect-args(parts[1:], env));
    };
    def sh-collect-redirs(parts) = nil?(parts) ? empty() : {
        let p = parts[0];
        (sh-leaf?(p) ? false : sh-redir-tag?(sh-tag(p))) ? cons([sh-tag(p), node_value(node_children(p)[1])], sh-collect-redirs(parts[1:])) : sh-collect-redirs(parts[1:]);
    };
    def sh-quote-arg(a) = find-from(a, " ", 0) >= 0 ? ("\"" + (a + "\"")) : a;
    def sh-quote-args(args) = nil?(args) ? empty() : cons(sh-quote-arg(args[0]), sh-quote-args(args[1:]));
    def sh-cmdline(name, args) = nil?(args) ? name : (name + (" " + sh-join(sh-quote-args(args), " ")));
    def sh-last(xs) = nil?(xs[1:]) ? xs[0] : sh-last(xs[1:]);
    def sh-butlast(xs) = nil?(xs) ? empty() : nil?(xs[1:]) ? empty() : cons(xs[0], sh-butlast(xs[1:]));
    //; ── evaluate: (node env) -> (list stdout env exit) ──────────────────
    def sh-eval(node, env) = sh-eval-in(node, env, "");
    def sh-eval-in(node, env, stdin) = {
        let t = sh-tag(node);
        (String) t == "__seq__" ? sh-eval-seq(sh-rest(node), env, "", 0) : (String) t == "__while__" ? sh-eval-while(sh-rest(node), env) : (String) t == "__for__" ? sh-eval-for(sh-rest(node), env) : (String) t == "__andor__" ? sh-eval-andor(sh-rest(node), env, stdin) : (String) t == "__pipe__" ? sh-eval-pipe(sh-rest(node), env, stdin) : sh-eval-command(node, env, stdin);
    };
    def sh-eval-seq(stmts, env, acc, lastexit) = nil?(stmts) ? [acc, env, lastexit] : {
        let r = sh-eval-in(stmts[0], env, "");
        sh-eval-seq(stmts[1:], r-env(r), ((String) acc + r-out(r)), r-exit(r));
    };
    def sh-eval-andor(parts, env, stdin) = {
        let r = sh-eval-in(parts[0], env, stdin);
        sh-eval-andor-loop(parts[1:], r-env(r), r-out(r), r-exit(r));
    };
    def sh-eval-andor-loop(ops, env, outacc, lastexit) = nil?(ops) ? [outacc, env, lastexit] : {
        let op = ops[0];
        let run? = (String) sh-tag(op) == "__&&__" ? (Comparable) lastexit == 0 : !((Comparable) lastexit == 0);
        run? ? {
            let r = sh-eval-in(sh-rest(op)[0], env, "");
            sh-eval-andor-loop(ops[1:], r-env(r), ((String) outacc + r-out(r)), r-exit(r));
        } : sh-eval-andor-loop(ops[1:], env, outacc, lastexit);
    };
    def sh-eval-pipe(cmds, env, stdin) = nil?(cmds) ? [stdin, env, 0] : {
        let r = sh-eval-in(cmds[0], env, stdin);
        nil?(cmds[1:]) ? r : sh-eval-pipe(cmds[1:], r-env(r), r-out(r));
    };
    def sh-loop-limit() = 100000;
    def sh-eval-while(rest, env) = sh-eval-while-loop(rest[0], rest[1], env, "", 0);
    def sh-eval-while-loop(cond, body, env, acc, iter) = iter >= sh-loop-limit() ? [acc, sh-env-set(env, "?", "124"), 124] : {
        let cr = sh-eval-in(cond, env, "");
        let acc2 = ((String) acc + r-out(cr));
        (Comparable) r-exit(cr) == 0 ? {
            let br = sh-eval-in(body, r-env(cr), "");
            sh-eval-while-loop(cond, body, r-env(br), ((String) acc2 + r-out(br)), iter + 1);
        } : [acc2, r-env(cr), r-exit(cr)];
    };
    def sh-eval-for(rest, env) = {
        let var = node_value(rest[0]);
        let tailrest = rest[1:];
        sh-eval-for-items(var, sh-butlast(tailrest), sh-last(tailrest), env, "");
    };
    def sh-eval-for-items(var, items, body, env, acc) = nil?(items) ? [acc, sh-env-set(env, "?", "0"), 0] : {
        let item = sh-arg-val(items[0], env);
        let env2 = sh-env-set(env, var, item);
        let r = sh-eval-in(body, env2, "");
        sh-eval-for-items(var, items[1:], body, r-env(r), ((String) acc + r-out(r)));
    };
    // The default command evaluator is a named seam.  A closed Form extension
    // may late-bind `sh-eval-command` and delegate every other command here;
    // this base shell owns no process-execution route.
    def sh-eval-command-default(node, env, stdin) = {
        let name = sh-tag(node);
        sh-assign?(name) ? ["", sh-env-set(env, sh-assign-name(name), sh-assign-val(name)), 0] : {
            let args = sh-collect-args(sh-rest(node), env);
            sh-builtin?(name) ? {
                let br = sh-run-builtin(name, args, stdin);
                let e = br[1];
                [br[0], sh-env-set(env, "?", e.str()), e];
            } : [("[passthrough] " + sh-cmdline(name, args)), sh-env-set(env, "?", "0"), 0];
        };
    };
    def sh-eval-command(node, env, stdin) = sh-eval-command-default(node, env, stdin);
    //; convenience
    def sh-out(src) = r-out(sh-eval(sh-parse(src), sh-env-empty()));
    def sh-exit(src) = r-exit(sh-eval(sh-parse(src), sh-env-empty()));
    //; ── plan: flat native/passthrough step list for a live runner ────────
    def sh-plan(node) = sh-plan-node(node);
    def sh-plan-node(node) = {
        let t = sh-tag(node);
        (String) t == "__while__" ? append(sh-plan-node(sh-rest(node)[0]), sh-plan-node(sh-rest(node)[1])) : (String) t == "__for__" ? sh-plan-node(sh-last(sh-rest(node))) : (String) t == "__seq__" || ((String) t == "__pipe__" || ((String) t == "__andor__" || ((String) t == "__&&__" || (String) t == "__||__"))) ? sh-plan-list(sh-rest(node)) : sh-plan-command(node);
    };
    def sh-plan-list(xs) = nil?(xs) ? empty() : append(sh-plan-node(xs[0]), sh-plan-list(xs[1:]));
    // As with evaluation, planners extend through a named default rather than
    // by teaching the base shell a host-facing command.
    def sh-plan-kind-default(name) = sh-builtin?(name) ? "native" : "passthrough";
    // Keep the former public helper available while extensions delegate through
    // the default seam above.
    def sh-plan-kind(name) = sh-plan-kind-default(name);
    def sh-plan-command-default(node) = {
        let name = sh-tag(node);
        sh-assign?(name) ? [["assign", sh-assign-name(name), [sh-assign-val(name)], empty()]] : {
            let parts = sh-rest(node);
            let args = sh-collect-args(parts, sh-env-empty());
            let redirs = sh-collect-redirs(parts);
            [[sh-plan-kind-default(name), name, args, redirs]];
        };
    };
    def sh-plan-command(node) = sh-plan-command-default(node);
    def sh-step-kind(s) = s[0];
    def sh-step-name(s) = s[1];
    def sh-step-args(s) = s[2];
    def sh-step-redirs(s) = s[3];
}
