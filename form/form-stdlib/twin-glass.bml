//////////////////////////////////////////////////////////////////////
//
// twin-glass.bml — the twin census, spoken as a panel and given to the glass.
//
// Authority: form-stdlib/bml/twin-glass.bml
// preludes: form/form-stdlib/twin-census.bml form/form-stdlib/bearing-glass.bml
// Proven by: form-stdlib/tests/twin-census-band.fk (the arithmetic)
//            observe/twin-census-take.fk (the frame arrives)
//
// `twin-census.bml` reads only the files it is handed and is proven by hand-built
// rows. This cell is where it meets the world: it reads the op table for the
// natives, reads the units, snapshots the heat the caller took, prints the panel
// and gives the rows under its own publisher.
//
// The publisher declares its cadence INSIDE the frame (fgsr-give-at), the way the
// bearing sensor does, so the roster needs no edit to carry this sensor: a taker
// reads the cadence the giver stated and calls the frame silent past three of them.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class TwinGlassAuthority {
        field TWGAuthorityPath = "form/form-stdlib/bml/twin-glass.bml";
        field TWGAuthorityKind = "high-bml-interface-class-const";
    }

    class TwinGlass {
        field TWGShown = 8;
        field TWGDomain = "kernel";
        field TWGChannel = "jit";
        field TWGSource = "source-bodies + kernel_hot_rows";
        ref twg-authority = TwinGlassAuthority;

        // --- reading the body around the census ---------------------------------
        // the op table and the live page are read through bearing-glass's own doors
        // (bgl-natives, bgl-walked), not through copies of them here. This cell carried
        // four such copies until it was run through its own census beside bearing-glass:
        // twg-optable-path and bgl-optable-path came back `looks-identical`, and so did
        // twg-walked-of against bgl-walked-of. The lens's own verdict was taken.

        // --- the panel ------------------------------------------------------------
        def twg-lines(cs, n) = if or(le(n, 0), eq(len(cs), 0)) then 0 else twg-lines-next(print(str_concat("  ", twc-c-text(head(cs)))), cs, n);
        def twg-lines-next(said, cs, n) = twg-lines(tail(cs), sub(n, 1));
        def twg-panel(pairs, doors, seen, walked, ms, label, natives) {
            let a = print("");
            let b = print(bcs-cat(list("twin census — ", label, ", ", int_to_str(ms), " ms, ", int_to_str(len(doors)), " doors read, ", int_to_str(len(pairs)), " pairs")));
            let c = print(bcs-cat(list("  ", int_to_str(twc-count-kind(pairs, "looks-identical", 0)), " look identical, ", int_to_str(twc-count-kind(pairs, "differs-at", 0)), " part on an edge, ", int_to_str(twc-count-kind(pairs, "unproven", 0)), " unproven against a native; ", int_to_str(twc-count-heat(pairs, "cold-and-warm", 0)), " carry a cold side against a crystallized one")));
            let d = print(bcs-cat(list("  ", int_to_str(len(natives)), " natives in the op table, ", int_to_str(seen), " walker steps in the snapshot of ", int_to_str(walked), " walked (", bcs-pct(bcs-coverage-bp(seen, walked)), ")")));
            let e = print("");
            let f = print(bcs-cat(list("  the coldest twin: ", twc-standing-name(pairs), " — ", twc-standing-why(pairs))));
            let g = print(str_concat("  remedy: ", twc-remedy(twc-standing(pairs))));
            let h = print("");
            let i = twg-lines(pairs, TWGShown());
            1;
        }

        // --- the rows -------------------------------------------------------------
        def twg-note(c) = bcs-cat(list("cold ", twc-c-cold(c), " in ", twc-c-cold-unit(c), " against ", twc-c-warm(c), " in ", twc-c-warm-unit(c), "; sameness ", twc-c-kind(c), "; heat ", twc-c-heat(c), "; ", twc-warmth(c), "; ", int_to_str(twc-c-sites(c)), " doors would have to reroute; ", twc-remedy(c)));
        def twg-row(c) = fgo-int(TWGDomain(), str_concat("twin.", twc-c-cold(c)), twc-c-text(c), twc-c-chill(c), "chill", twc-c-sites(c), "cpu-arena", "physical-live", TWGSource(), "live", TWGChannel(), twg-note(c));
        def twg-rows-of(cs, n) = if or(le(n, 0), eq(len(cs), 0)) then list() else cons(twg-row(head(cs)), twg-rows-of(tail(cs), sub(n, 1)));
        def twg-int-row(id, label, value, unit, note) = fgo-int(TWGDomain(), id, label, value, unit, 0, "cpu-arena", "physical-live", TWGSource(), "live", TWGChannel(), note);
        def twg-head-rows(pairs, doors, seen, walked, ms, label) = list(
            fgo-text(TWGDomain(), "twin.coldest", "the coldest twin", twc-standing-name(pairs), "cpu-arena", "physical-live", TWGSource(), "live", TWGChannel(), str_concat("the door whose body another door already carries, where the other one crystallized and this one cannot: a private copy stands outside the pool of calls that buys crystallization. This one stands because ", twc-standing-why(pairs))),
            fgo-text(TWGDomain(), "twin.standing-why", "why that pair stands first", twc-standing-why(pairs), "cpu-arena", "physical-live", TWGSource(), "live", TWGChannel(), "a measured cold-against-warm pair leads; then a body standing under two doors, which is a duplicate whether or not anything drove it; and last, said as such, a pair that merely PARTS somewhere and is therefore not a twin at all"),
            fgo-text(TWGDomain(), "twin.remedy", "what that pair asks for", twc-remedy(twc-standing(pairs)), "cpu-arena", "physical-live", TWGSource(), "live", TWGChannel(), "a shadow asks for a deletion, an identical body for a reroute, a parting body for a reroute plus the adapter its window names, and a native twin for a band before anything is moved"),
            fgo-text(TWGDomain(), "twin.workload", "the workload this census read", label, "cpu-arena", "physical-live", TWGSource(), "live", TWGChannel(), "the heat overlay comes from this process's own walking; the PAIRS come from the source and would stand with no workload at all"),
            twg-int-row("twin.pairs", "pairs the source carries", len(pairs), "pairs", "every pair of doors whose normalized bodies match or part in one window; found from the source, so a door nothing has driven yet is named all the same"),
            twg-int-row("twin.identical", "pairs whose bodies are one", twc-count-kind(pairs, "looks-identical", 0), "pairs", "the same bytes after comments are cut, whitespace squeezed, the door's own name rewritten @s and each parameter rewritten to its position"),
            twg-int-row("twin.differing", "pairs that part on an edge", twc-count-kind(pairs, "differs-at", 0), "pairs", "a long shared prefix AND suffix with one window between them; NOT twins, and the window is the adapter a reroute would have to write"),
            twg-int-row("twin.unproven", "pairs unproven against a native", twc-count-kind(pairs, "unproven", 0), "pairs", "the twin named is a native and has no body anywhere, so no body comparison exists; a lead for a band, never a proof"),
            twg-int-row("twin.coldtwins", "pairs with a cold side and a warm one", twc-count-heat(pairs, "cold-and-warm", 0), "pairs", "one side carries crystal >= 1 and the other does not; the warm door is never offered as the cold one"),
            twg-int-row("twin.doors", "doors read from the units", len(doors), "doors", "every def and defn in the files handed in whose body is at least TWCMinBody bytes; shorter bodies are one-field accessors that share bytes without sharing a meaning"),
            twg-int-row("twin.seen", "walker steps in the heat snapshot", seen, "calls", "the heat is an overlay that colours a pair cold or warm; it never finds one"),
            twg-int-row("twin.walked", "walker steps, whole process", walked, "calls", "the kernel's own live page, word 5, read straight after the snapshot"),
            twg-int-row("twin.workload-ms", "the workload's own time", ms, "milliseconds", "wall time of the workload alone, measured before this census read a single body"));
        def twg-give(pairs, doors, seen, walked, ms, label) = twg-give-at(pairs, doors, seen, walked, ms, label, now_unix_ms());
        def twg-give-at(pairs, doors, seen, walked, ms, label, now) = fgsr-give-at(TWCSensor(), now, fgo-observe-rows(append(twg-head-rows(pairs, doors, seen, walked, ms, label), twg-rows-of(pairs, TWGShown())), now, 0), TWCCadenceMs());

        // --- work, snapshot, ask, give: the whole movement in one door -------------
        // the caller does the work and hands in the snapshot it took immediately after, so
        // nothing this cell walks can reach the reading it is about to report
        def twg-witness(rows, walked, ms, label, paths) = twg-witness-doors(rows, walked, ms, label, twc-doors(paths), bgl-natives());
        def twg-witness-doors(rows, walked, ms, label, doors, natives) = twg-witness-pairs(rows, walked, ms, label, doors, natives, twc-census(rows, doors, natives), bcs-total-heat(rows, 0));
        def twg-witness-pairs(rows, walked, ms, label, doors, natives, pairs, seen) = twg-witness-said(pairs, doors, seen, walked, ms, label, twg-panel(pairs, doors, seen, walked, ms, label, natives));
        def twg-witness-said(pairs, doors, seen, walked, ms, label, said) = twg-witness-given(pairs, twg-give(pairs, doors, seen, walked, ms, label));
        def twg-witness-given(pairs, given) = twg-witness-told(pairs, print(bcs-cat(list("  given to the glass: ", nth(given, 1), " ", nth(given, 2), " seq ", int_to_str(nth(given, 4))))));
        def twg-witness-told(pairs, told) = twc-standing-name(pairs);
    }
    0;
}
