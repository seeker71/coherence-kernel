; living-world-relational-voice.fk -- an admitted relation plan orders surfaces.
;
; This emitter owns no vocabulary, numeric positions, grammar taxonomy, answer
; table, or remote route. It receives a minimized capability context, an exact
; offered relation, and an offered field of current learned-symbol candidates.
; The relation organ must derive a READY plan. AMBIGUOUS and CYCLE plans remain
; inspectable but do not condense to a primary utterance.
;
; Alternatives, unknowable remainder, and choice are independently optional.
; Their absence is retained as absence. When present, they remain exact cells
; in the utterance rather than hidden defaults. Admission is separately
; unanimous across every active execution, symbol, relation, and capability
; holder. Full-world re-observation prevents a minimized context from hiding
; later evidence.
;
; This is relational native surface composition, not a general generative mind.
;
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk

(let LWRV-UTTERANCE (bp "LWRV-UTTERANCE"))
(let LWRV-ORIGIN    (bp "LWRV-ORIGIN"))

(defn lwrv-optional-unknown-valid? (unknown)
    (if (or (node_eq unknown (lwo-none))
            (eq (lwlc-unknown? unknown) 1)) 1 0))
(defn lwrv-optional-choice-valid? (choice)
    (if (or (node_eq choice (lwo-none))
            (eq (lwlc-choice-valid? choice) 1)) 1 0))

(defn lwrv-node-referents-match? (items referent)
    (if (eq (len items) 0) 1
        (do
            (let candidate (head items))
            (if (and (eq (lwsl-symbol-candidate? candidate) 1)
                     (node_eq
                        (lwnv-symbol-referent
                          (lwo-emergent-shape candidate)) referent))
                (lwrv-node-referents-match? (tail items) referent) 0))))

(defn lwrv-render-candidates (items text)
    (if (eq (len items) 0) text
        (lwrv-render-candidates (tail items)
            (str_concat text
                (lwnv-symbol-surface
                    (lwo-emergent-shape (head items)))))))

(defn lwrv-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwrv-field-union-items (tail items)
            (lwo-field-add field (head items)))))
(defn lwrv-attribution-witnesses (world items witnesses)
    (if (eq (len items) 0) witnesses
        (lwrv-attribution-witnesses world (tail items)
            (lwrv-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world (head items)))
                witnesses))))

(defn lwrv-witnesses (context basis plan)
    (do
        (let world (lwcp-context-world context))
        (let with-basis
            (lwrv-attribution-witnesses world (list basis)
                (lwo-empty-field)))
        (let group (lwrp-plan-group plan))
        (let with-nodes
            (lwrv-attribution-witnesses world
                (lwo-field-items (lwrp-group-nodes group)) with-basis))
        (let with-edges
            (lwrv-attribution-witnesses world
                (lwo-field-items (lwrp-group-edges group)) with-nodes))
        (lwrv-field-union-items
            (lwo-field-items
                (lwcp-context-capability-attributions context)) with-edges)))

; children: execution basis, referent, offered relation, offered node field,
;           derived plan, rendered surface, minimized context, optional
;           alternatives, optional unknown, optional choice, witnesses,
;           evidence, local path
(defn lwrv-utterance
    (basis referent relation nodes plan surface context alternatives unknown
     choice witnesses evidence)
    (intern_node LWRV-UTTERANCE
        (list basis referent relation nodes plan
              (intern_trivial_string surface) context alternatives unknown
              choice witnesses evidence (lwo-local-path))))
(defn lwrv-utterance? (cell) (lwo-category? cell LWRV-UTTERANCE))
(defn lwrv-utterance-basis (utterance) (nth (node_children utterance) 0))
(defn lwrv-utterance-referent (utterance) (nth (node_children utterance) 1))
(defn lwrv-utterance-relation (utterance) (nth (node_children utterance) 2))
(defn lwrv-utterance-nodes (utterance) (nth (node_children utterance) 3))
(defn lwrv-utterance-plan (utterance) (nth (node_children utterance) 4))
(defn lwrv-utterance-surface-cell (utterance)
    (nth (node_children utterance) 5))
(defn lwrv-utterance-surface (utterance)
    (node_value (lwrv-utterance-surface-cell utterance)))
(defn lwrv-utterance-context (utterance) (nth (node_children utterance) 6))
(defn lwrv-utterance-alternatives (utterance)
    (nth (node_children utterance) 7))
(defn lwrv-utterance-unknown (utterance) (nth (node_children utterance) 8))
(defn lwrv-utterance-choice (utterance) (nth (node_children utterance) 9))
(defn lwrv-utterance-witnesses (utterance) (nth (node_children utterance) 10))
(defn lwrv-utterance-evidence (utterance) (nth (node_children utterance) 11))
(defn lwrv-utterance-path (utterance) (nth (node_children utterance) 12))

(defn lwrv-plan-for (context relation nodes)
    (if (or (eq (lwcp-context? context) 0)
            (eq (lwo-category? nodes LWO-FIELD) 0))
        (lwo-none)
        (lwrp-plan-for (lwcp-context-world context) relation nodes)))

(defn lwrv-emit
    (context basis referent relation nodes alternatives unknown choice evidence)
    (if (or (eq (lwcp-context? context) 0)
            (or (eq (lwo-category? nodes LWO-FIELD) 0)
                (or (eq (lwo-category? alternatives LWO-FIELD) 0)
                    (or (eq (lwrv-optional-unknown-valid? unknown) 0)
                        (eq (lwrv-optional-choice-valid? choice) 0)))))
        (lwo-none)
        (do
            (let world (lwcp-context-world context))
            (if (or (eq (lwnv-execution-basis?
                          world basis referent) 0)
                    (eq (lwrv-node-referents-match?
                          (lwo-field-items nodes) referent) 0))
                (lwo-none)
                (do
                    (let plan (lwrp-plan-for world relation nodes))
                    (if (or (node_eq plan (lwo-none))
                            (eq (lwrp-ready?
                                  (lwrp-plan-status plan)) 0))
                        (lwo-none)
                        (do
                            (let ordered
                                (lwrp-sequence-items
                                    (lwrp-plan-sequence plan)))
                            (lwrv-utterance basis referent relation nodes plan
                                (lwrv-render-candidates ordered "") context
                                alternatives unknown choice
                                (lwrv-witnesses context basis plan)
                                evidence))))))))

(defn lwrv-utterance-current? (world utterance)
    (if (eq (lwrv-utterance? utterance) 0) 0
        (do
            (let context (lwrv-utterance-context utterance))
            (let plan (lwrv-utterance-plan utterance))
            (if (and (eq (lwcp-context-current? world context) 1)
                     (and (eq (lwrp-plan-current? world plan) 1)
                          (node_eq utterance
                            (lwrv-emit context
                                (lwrv-utterance-basis utterance)
                                (lwrv-utterance-referent utterance)
                                (lwrv-utterance-relation utterance)
                                (lwrv-utterance-nodes utterance)
                                (lwrv-utterance-alternatives utterance)
                                (lwrv-utterance-unknown utterance)
                                (lwrv-utterance-choice utterance)
                                (lwrv-utterance-evidence utterance))))) 1 0))))

(defn lwrv-origin (utterance)
    (intern_node LWRV-ORIGIN (list utterance (lwo-local-path))))

(defn lwrv-proposal
    (context basis referent relation nodes alternatives unknown choice evidence)
    (do
        (let utterance
            (lwrv-emit context basis referent relation nodes alternatives
                unknown choice evidence))
        (if (node_eq utterance (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwrv-utterance-witnesses utterance))
                (let count (lwo-field-size witnesses))
                (let origin (lwrv-origin utterance))
                (let candidate
                    (lwo-emergent utterance witnesses
                        (intern_trivial_int count)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))

(defn lwrv-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (do
            (let candidate (lwt-proposal-candidate proposal))
            (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
                     (eq (lwrv-utterance-current? world
                            (lwo-emergent-shape candidate)) 1)) 1 0))))

(defn lwrv-integrate (round proposal action)
    (if (eq (lwrv-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

0
