; living-world-symbol-sequence.fk -- a role-free ordered surface carrier.
;
; A sequence contains only learned symbol candidates in an offered order.
; It names no grammatical role and performs no selection.  Rendering is the
; local concatenation of the exact admitted surfaces.  Currentness and the
; authority to emit remain responsibilities of the organ using the carrier.
;
; The historical LWTV category/function names are retained so already-observed
; trace-voice cells keep exact content identity while the generic tissue no
; longer imports execution, relation, or trace ancestry.
;
; preludes: form-stdlib/core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-symbol.fk

(let LWTV-SEQUENCE (bp "LWTV-SEQUENCE"))

(defn lwtv-sequence (items) (intern_node LWTV-SEQUENCE items))
(defn lwtv-sequence? (cell) (lwo-category? cell LWTV-SEQUENCE))
(defn lwtv-sequence-items (sequence) (node_children sequence))

(defn lwtv-render-items (items text)
    (if (eq (len items) 0) text
        (lwtv-render-items (tail items)
            (str_concat text
                (lwnv-symbol-surface
                    (lwo-emergent-shape (head items)))))))
