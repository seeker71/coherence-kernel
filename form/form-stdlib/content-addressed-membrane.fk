; content-addressed-membrane.fk — a crossing that can be found, questioned,
; replayed, and retired.
;
; The identity covers the complete observation except the identity itself.
; Every basic inquiry plane is carried as data and selected by one generic
; lane function.  `root` names the closest grounded dependency; `freedom`
; names the next recipe that may collapse the crossing into the source body.
;
; preludes: form-stdlib/core.fk form-stdlib/sha256.fk form-stdlib/native-model-evidence.fk

(do
    (defn cam-tag () "content-addressed-membrane-v1")

    ; Observation without its derived identity.
    (defn cam-body
        (payload-id what where when who how which why root freedom
         needed elapsed-us native-candidate freshness outcome)
        (list (cam-tag) payload-id what where when who how which why root freedom
              needed elapsed-us native-candidate freshness outcome))

    (defn cam-identity (body)
        (nmfe-sha256 (nmfe-fields body)))

    (defn cam-crossing
        (payload-id what where when who how which why root freedom
         needed elapsed-us native-candidate freshness outcome)
        (do
            (let body
                (cam-body payload-id what where when who how which why root freedom
                          needed elapsed-us native-candidate freshness outcome))
            (cons (cam-identity body) body)))

    (defn cam-id (x) (nth x 0))
    (defn cam-body-of (x) (tail x))
    (defn cam-payload-id (x) (nth x 2))
    (defn cam-what (x) (nth x 3))
    (defn cam-where (x) (nth x 4))
    (defn cam-when (x) (nth x 5))
    (defn cam-who (x) (nth x 6))
    (defn cam-how (x) (nth x 7))
    (defn cam-which (x) (nth x 8))
    (defn cam-why (x) (nth x 9))
    (defn cam-root (x) (nth x 10))
    (defn cam-freedom (x) (nth x 11))
    (defn cam-needed (x) (nth x 12))
    (defn cam-elapsed-us (x) (nth x 13))
    (defn cam-native-candidate (x) (nth x 14))
    (defn cam-freshness (x) (nth x 15))
    (defn cam-outcome (x) (nth x 16))

    (defn cam-present? (s) (if (gt (str_len s) 0) 1 0))

    ; 1 means this composition has been witnessed through the offered
    ; interface. 0 means candidate composition. Neither value authorizes or
    ; compels no movement; it informs the next offer.
    (defn cam-witnessed? (x)
        (if (not (eq (len x) 17)) 0
            (if (not (str_eq (nth x 1) (cam-tag))) 0
            (if (not (nmfe-sha256? (cam-id x))) 0
            (if (not (str_eq (cam-id x) (cam-identity (cam-body-of x)))) 0
            (if (not (nmfe-sha256? (cam-payload-id x))) 0
            (if (not (eq (cam-present? (cam-what x)) 1)) 0
            (if (not (eq (cam-present? (cam-where x)) 1)) 0
            (if (not (eq (cam-present? (cam-when x)) 1)) 0
            (if (not (eq (cam-present? (cam-who x)) 1)) 0
            (if (not (eq (cam-present? (cam-how x)) 1)) 0
            (if (not (eq (cam-present? (cam-which x)) 1)) 0
            (if (not (eq (cam-present? (cam-why x)) 1)) 0
            (if (not (eq (cam-present? (cam-root x)) 1)) 0
            (if (not (eq (cam-present? (cam-freedom x)) 1)) 0
            (if (not (or (eq (cam-needed x) 0) (eq (cam-needed x) 1))) 0
            (if (lt (cam-elapsed-us x) 0) 0
            (if (not (eq (cam-present? (cam-native-candidate x)) 1)) 0
            (if (not (eq (cam-present? (cam-freshness x)) 1)) 0
                (cam-present? (cam-outcome x)))))))))))))))))))))

    ; The inquiry plane is open data: these seven names are the initial shared
    ; interface, not a closed enumeration. Unknown lanes return nothing.
    (defn cam-inquire (x lane)
        (if (str_eq lane "what") (cam-what x)
        (if (str_eq lane "where") (cam-where x)
        (if (str_eq lane "when") (cam-when x)
        (if (str_eq lane "who") (cam-who x)
        (if (str_eq lane "how") (cam-how x)
        (if (str_eq lane "which") (cam-which x)
        (if (str_eq lane "why") (cam-why x)
        (if (str_eq lane "root") (cam-root x)
        (if (str_eq lane "freedom") (cam-freedom x)
            (nothing)))))))))))

    (defn cam-reidentify (x) (cam-identity (cam-body-of x)))
    0)
