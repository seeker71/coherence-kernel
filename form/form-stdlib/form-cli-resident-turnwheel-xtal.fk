
; preludes: form-stdlib/language-template.fk

(let ResidentTurnStage (language-template-with-members "ResidentTurnStage" (list "TId") (list (language-template-member "id" "TId") (language-template-member "phase" "String") (language-template-member "signal" "String") (language-template-member "gas" "int") (language-template-member "tokens" "int"))))
(defn PhaseProgram () "program")
(defn PhasePrefill () "prefill")
(defn PhaseModel () "model")
(defn PhaseReturned () "program-returned")
(defn PhasePrefillError () "prefill-error")
(defn SignalLive () "live")
(defn SignalReturned () "returned")
(defn SignalDone () "done")
(defn SignalNothing () "nothing")
(defn SignalChoice () "choice")
(defn SignalCut () "cut")
(defn SignalUndo () "undo")
(defn SignalTimeout () "timeout")
(defn SignalFailure () "failure")
(defn SignalRefused () "refused")
(defn SignalRelease () "release")
(defn CursorRoute () "scannerless-byte-fold-no-tokenizer")
(defn FrameRule () "id-phase-signal-gas-tokens-no-prompt-or-answer-bytes")
(defn PresenceRule () "nothing-is-not-zero-or-one")
(defn fcrtbml-pattern () (list "resident-row" "scannerless-stage" "nodeid-jit-route" "choice-cut-undo-timeout" "stop-carried"))
(defn fcrtbml-terminal (signal) (if (str_eq signal (SignalReturned)) 1 (if (str_eq signal (SignalDone)) 1 (if (str_eq signal (SignalNothing)) 1 (if (str_eq signal (SignalChoice)) 1 (if (str_eq signal (SignalCut)) 1 (if (str_eq signal (SignalTimeout)) 1 (if (str_eq signal (SignalFailure)) 1 (if (str_eq signal (SignalRefused)) 1 (if (str_eq signal (SignalRelease)) 1 0))))))))))
(defn fcrtbml-runnable (signal gas) (if (eq (fcrtbml-terminal signal) 1) 0 (if (eq gas 0) 0 1)))
(defn fcrtbml-runnable-phase (phase) (if (str_eq phase (PhaseProgram)) 1 (if (str_eq phase (PhasePrefill)) 1 (if (str_eq phase (PhaseModel)) 1 0))))
(defn fcrtbml-stop-carries (stopped) (if (eq stopped 1) 1 0))
(defn fcrtbml-check () (do (let c0 (if (str_eq (PhaseModel) "model") 1 0)) (let c1 (if (eq (fcrtbml-terminal (SignalReturned)) 1) 2 0)) (let c2 (if (eq (fcrtbml-terminal (SignalDone)) 1) 4 0)) (let c3 (if (eq (fcrtbml-terminal (SignalLive)) 0) 8 0)) (let c4 (if (eq (fcrtbml-runnable (SignalLive) 1) 1) 16 0)) (let c5 (if (eq (fcrtbml-runnable (SignalLive) 0) 0) 32 0)) (let c6 (if (eq (fcrtbml-terminal (SignalCut)) 1) 64 0)) (let c7 (if (eq (fcrtbml-terminal (SignalRelease)) 1) 128 0)) (let c8 (if (eq (fcrtbml-stop-carries 1) 1) 256 0)) (let c9 (if (eq (fcrtbml-stop-carries 0) 0) 512 0)) (let c10 (if (eq (fcrtbml-runnable-phase (PhaseProgram)) 1) (if (eq (fcrtbml-runnable-phase (PhasePrefillError)) 0) 1024 0) 0)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9 c10))))))))))))
(defn FormCliResidentTurnwheel () (list "abstraction" "FormCliResidentTurnwheel" (list "T") (list "fcrtbml-terminal" "fcrtbml-runnable" "fcrtbml-runnable-phase" "fcrtbml-stop-carries" "fcrtbml-check") (list "PhaseProgram" "PhasePrefill" "PhaseModel" "PhaseReturned" "PhasePrefillError" "SignalLive" "SignalReturned" "SignalDone" "SignalNothing" "SignalChoice" "SignalCut" "SignalUndo" "SignalTimeout" "SignalFailure" "SignalRefused" "SignalRelease" "CursorRoute" "FrameRule" "PresenceRule") (list) (list "fcrtbml-pattern")))
0
