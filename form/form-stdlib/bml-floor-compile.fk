; bml-floor-compile.fk — the floor's lowering door: the runner spawns this
; cell (as itself) whenever a .bml source or prelude is stale, feeding two
; stdin lines: the .bml path and the derived .fk path to write. The whole
; compiler stays Form-owned; the C seed only opens this door and checks
; freshness. Never invoked by hand in the ordinary walk — running a .bml
; through ./fkwu IS the interface.
;
; stdin lines: source .bml path, derived .fk output path.
;
; preludes: form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml.fk form-stdlib/bml-source.fk form-stdlib/source-compiler.fk form-stdlib/grammars/form-bml.fk form-stdlib/grammars/form-lift.fk form-stdlib/form-bml-lower.fk form-stdlib/source-compiler-text-lens.fk

(do
    ; every "// preludes:" line in the .bml travels through the lowering as
    ; a real "; preludes:" directive — the seed reads every such line of a
    ; .fk, so the lowering carries every one too — and the derived source
    ; resolves its own chain: a standalone run is whole, never a fold over
    ; nothing. (form-stdlib/tests/bml-two-preludes-witness.bml)
    (defn bfc-preludes-from (text from)
        (do
            (let at (str_find text "// preludes:" from))
            (if (lt at 0) ""
                (do
                    (let start (add at (str_len "// preludes:")))
                    (let end (str_find text "\n" start))
                    (let stop (if (lt end 0) (str_len text) end))
                    (str_concat "; preludes:"
                        (str_concat (substring text start stop)
                            (str_concat "\n" (bfc-preludes-from text stop))))))))
    (defn bfc-preludes-line (text) (bfc-preludes-from text 0))
    (let src (read_line))
    (let out (read_line))
    (if (or (nothing? src) (str_eq src ""))
        1
        (if (or (nothing? out) (str_eq out ""))
            1
            (if (str_eq out "-")
                ; the fileless mode: the lowered text (preludes carried)
                ; rides stdout to the parent runner, closed by a sentinel
                ; so the trailing value print never enters the source.
                (do
                    (let text (read_file src))
                    (let put1 (print_str (bfc-preludes-line text)))
                    (let put2 (print_str (form-source-compile-text text src)))
                    (let put3 (print_str "\n@bml-floor-lowered\n"))
                    0)
                (do
                    (form-source-compile-file src out)
                    (let carried (bfc-preludes-line (read_file src)))
                    (if (str_eq carried "") 0
                        (do
                            (let lowered (read_file out))
                            (let put (write_file_text out
                                (str_concat carried lowered)))
                            0)))))))
