; The runner invokes this Form compiler when BML source or a dependency is
; stale. Stdin carries the source path and output mode. Mode "-" emits through
; the runner pipe; "@memo" also reads the parent's selected home registry path
; and emits the source manifest. An explicit output path writes requested Form.
; The shared source reader carries dependency directives into the emitted unit.
;
; preludes: form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml.fk form-stdlib/bml-source.fk form-stdlib/source-compiler.fk form-stdlib/grammars/form-bml.fk form-stdlib/grammars/form-lift.fk form-stdlib/form-bml-lower.fk form-stdlib/source-compiler-text-lens.fk

(do
    (let src (read_line))
    (let out (read_line))
    (if (or (nothing? src) (str_eq src ""))
        1
        (if (or (nothing? out) (str_eq out ""))
            1
            (if (or (str_eq out "-") (str_eq out "@memo"))
                ; the fileless mode: the lowered text (preludes carried)
                ; rides stdout to the parent runner, closed by a sentinel
                ; so the trailing value print never enters the source.
                (do
                    (let text (fsc-bml-read-source src))
                    (let compiled (if (str_eq out "@memo") (form-source-compile-packet text src (bml-source-prelude-prefix text) (read_line)) (form-source-compile-text text src)))
                    (let put1 (if (str_eq out "@memo") 0 (print_str (bml-source-prelude-prefix text))))
                    (let put2 (print_str compiled))
                    (let put3 (print_str "\n@bml-floor-lowered\n"))
                    0)
                (do
                    (form-source-compile-file src out)
                    (let carried (bml-source-prelude-prefix (read_file src)))
                    (if (str_eq carried "") 0
                        (do
                            (let lowered (read_file out))
                            (let put (write_file_text out
                                (str_concat carried lowered)))
                            0)))))))
