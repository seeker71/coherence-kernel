; The runner's lowering child. Stdin carries requests: a source path, then an
; output mode. Mode "-" emits through the runner pipe; "@memo" also reads the
; parent's selected home registry path and emits the source manifest. Each
; answer closes with the @bml-floor-lowered sentinel and the child waits for
; the next request until stdin ends, so one child lowers every unit a runner
; needs and reads each file of their closures once. The compiler that serves
; is pinned at the first request: a later request that finds any of its source
; bytes changed answers @bml-floor-stale and the child ends, so a packet never
; names a compiler other than the one that compiled it. An explicit output
; path writes requested Form and ends. The shared source reader carries
; dependency directives into the emitted unit.
;
; preludes: form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml.fk form-stdlib/bml-source.fk form-stdlib/source-compiler.fk form-stdlib/grammars/form-bml.fk form-stdlib/grammars/form-lift.fk form-stdlib/form-bml-lower.fk form-stdlib/source-compiler-text-lens.fk

(do
    (defn bfc-held-files (rows)
        (if (nil? rows) (empty)
            (if (str_eq (head (head rows)) "F")
                (cons (list (nth (head rows) 1) (read_file (nth (head rows) 1))) (bfc-held-files (tail rows)))
                (bfc-held-files (tail rows)))))
    (defn bfc-pin ()
        (do
            (let path (head (bml-source-resolution
                (list "form/form-stdlib/bml-floor-compile.fk" "form-stdlib/bml-floor-compile.fk") (empty))))
            (let homes (fsc-bml-home-context path))
            (let read (fsc-bml-file-signatures path (fsc-bml-read-source path) (list path) (empty) (nth homes 1) (head homes)))
            (bfc-held-files (nth read 2))))
    (defn bfc-same? (held)
        (if (nil? held) true
            (do (let now (read_file (head (head held))))
                (if (and (not (nothing? now)) (str_eq now (nth (head held) 1)))
                    (bfc-same? (tail held))
                    false))))
    (defn bfc-served-line (served)
        (do (let counts (fsc-bml-reading-counts))
            (str_concat "@bml-floor-served " (str_concat (int_to_str served)
                (str_concat " read " (str_concat (int_to_str (head counts))
                    (str_concat " reused " (int_to_str (nth counts 1)))))))))
    (defn bfc-serve (held served)
        (do
            (let src (read_line))
            (if (or (nothing? src) (str_eq src ""))
                (if (eq served 0) 1 (do (print_str (bfc-served-line served)) 0))
                (do
                    (let out (read_line))
                    (if (or (nothing? out) (str_eq out "")) 1
                        (if (or (str_eq out "-") (str_eq out "@memo"))
                            (do
                                (let pin (if (eq served 0) (bfc-pin) held))
                                (if (not (bfc-same? pin))
                                    (do (print_str "@bml-floor-stale\n") 0)
                                    (do
                                        (let text (fsc-bml-read-source src))
                                        (let compiled (if (str_eq out "@memo")
                                            (form-source-compile-packet text src (bml-source-prelude-prefix text) (read_line))
                                            (form-source-compile-text text src)))
                                        (let put1 (if (str_eq out "@memo") 0 (print_str (bml-source-prelude-prefix text))))
                                        (let put2 (print_str compiled))
                                        (let put3 (print_str "\n@bml-floor-lowered\n"))
                                        (bfc-serve pin (add served 1)))))
                            (do
                                (form-source-compile-file src out)
                                (let carried (bml-source-prelude-prefix (read_file src)))
                                (if (str_eq carried "") 0
                                    (do
                                        (let lowered (read_file out))
                                        (let put (write_file_text out (str_concat carried lowered)))
                                        0)))))))))
    (bfc-serve (empty) 0))
