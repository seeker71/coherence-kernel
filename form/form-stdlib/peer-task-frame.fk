// peer-task-frame.fk — the task-frame grammar alone: open/close marks,
// fields, the per-kind response contract, and the whole frame. This is
// transport vocabulary — every sender and every monitor speaks it — so
// it lives apart from the knowledge/exec stack: a cell that only SENDS
// loads only this, and a panel that preludes the frame does not pay the
// model chain's compile (the 45s glass cold witness, 2026-08-31).
// Moved verbatim from form-cli-peer-agent.fk, which preludes this cell
// so every existing consumer keeps its names.
import form-stdlib/core.fk;
section [form.bml] {
    def fcpa-task-open() = "<|form:agent-task|>";
    def fcpa-task-close() = "<|/form:agent-task|>";
    def fcpa-task-field(name, value) = ("\n" + (name + ("=" + value)));
    def fcpa-task-response-contract(kind) = (String) kind == "direct-answer" ? ((String) fcpa-task-field("response", "plain-prose-only") + fcpa-task-field("control", "not-an-answer")) : "";
    def fcpa-task-frame(turn, kind, task) = (fcpa-task-open() + (fcpa-task-field("turn", turn.str()) + (fcpa-task-field("kind", kind) + (fcpa-task-field("task", task) + (fcpa-task-response-contract(kind) + ("\n" + fcpa-task-close()))))));
    0;
}
