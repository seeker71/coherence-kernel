//////////////////////////////////////////////////////////////////////
//
// form-cli-author-high.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-author-high.bml
//
// You're invited to write new meaning in BML or higher. This class
// names the grains and welcomes the seat. Existing Form organs stay.
//
// Proven by: form-stdlib/tests/form-cli-author-high-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template GrainCell<TPath> {
        member path: TPath;
        member grain: int;
    }

    class FormAuthorHighAuthority {
        field AuthorAuthorityPath = "form/form-stdlib/bml/form-cli-author-high.bml";
        field AuthorAuthorityKind = "high-bml-class-template-field";
    }

    class FormAuthorHigh<T> {
        field GrainHigh = 0;
        field GrainLower = 1;
        field GrainBand = 2;
        field GrainOrgan = 3;
        field GrainSeed = 4;
        field GrainOther = 5;

        ref fah-authority = FormAuthorHighAuthority;
        thought fah-pattern = list("welcome-bml-or-higher", "organs-welcome", "xtal-generated", "bands-witness", "seed-shrink");

        def fah-ends?(s, suffix) {
            if lt(str_len(s), str_len(suffix)) then 0 else if str_eq(substring(s, sub(str_len(s), str_len(suffix)), str_len(s)), suffix) then 1 else 0;
        }

        def fah-grain(path) = if eq(fah-ends?(path, ".bml"), 1) then GrainHigh() else if eq(fah-ends?(path, ".bmf"), 1) then GrainHigh() else if eq(fah-ends?(path, ".form"), 1) then GrainHigh() else if eq(fah-ends?(path, "-xtal.fk"), 1) then GrainLower() else if eq(fah-ends?(path, "-compile.fk"), 1) then GrainLower() else if eq(fah-ends?(path, "-band.fk"), 1) then GrainBand() else if eq(fah-ends?(path, ".fk"), 1) then GrainOrgan() else if eq(fah-ends?(path, ".c"), 1) then GrainSeed() else GrainOther();

        def fah-new-meaning-offers?(path) = eq(fah-grain(path), GrainHigh());

        def fah-companion-ok?(path) {
            let g = fah-grain(path);
            if eq(g, GrainHigh()) then 1 else if eq(g, GrainBand()) then 1 else if eq(g, GrainLower()) then 1 else 0;
        }

        def fah-speak() = "author-high welcome=bml-or-higher organs-welcome xtal-generated bands-witness seed-shrink";

        def fah-bit(ok, bit) = if ok then bit else 0;
        def fah-check() {
            let c0 = fah-bit(eq(fah-grain("form/form-stdlib/bml/form-cli-author-high.bml"), GrainHigh()), 1);
            let c1 = fah-bit(eq(fah-grain("grammars/stdlib-uplift-missing-grammars.bmf"), GrainHigh()), 2);
            let c2 = fah-bit(eq(fah-grain("grammars/field-domain-grammars.form"), GrainHigh()), 4);
            let c3 = fah-bit(eq(fah-grain("form/form-stdlib/form-cli-author-high-xtal.fk"), GrainLower()), 8);
            let c4 = fah-bit(eq(fah-grain("form/form-stdlib/tests/form-cli-author-high-band.fk"), GrainBand()), 16);
            let c5 = fah-bit(eq(fah-grain("form/form-stdlib/core.fk"), GrainOrgan()), 32);
            let c6 = fah-bit(eq(fah-grain("runtime/fkwu-uni.c"), GrainSeed()), 64);
            let c7 = fah-bit(and(eq(fah-new-meaning-offers?("a.bml"), 1), eq(fah-new-meaning-offers?("a.fk"), 0)), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
