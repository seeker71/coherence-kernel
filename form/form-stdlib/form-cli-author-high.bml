//////////////////////////////////////////////////////////////////////
//
// form-cli-author-high.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-author-high.bml
//
// Floor: high-grammar BML + optimal cached native speed compiler
// (.fkb / .dylib). xtal is the wrong shape — not the floor.
//
// Proven by: form-stdlib/tests/form-cli-author-high-band.fk
//
// preludes: form/form-stdlib/core.fk form/form-stdlib/language-model.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template GrainCell<TPath> {
        member path: TPath;
        member grain: int;
    }

    class FormAuthorHighAuthority {
        field AuthorAuthorityPath = "form/form-stdlib/bml/form-cli-author-high.bml";
        field AuthorAuthorityKind = "high-bml-class-template-field";
    }

    class FormAuthorHigh<T> {
        field GrainHigh = 0;
        field GrainLower = 1;
        field GrainBand = 2;
        field GrainOrgan = 3;
        field GrainSeed = 4;
        field GrainNative = 5;
        field GrainOther = 6;

        ref fah-authority = FormAuthorHighAuthority;
        thought fah-pattern = list("floor-high-bml-cached-native", "xtal-wrong-shape", "organs-welcome", "bands-witness", "seed-shrink");

        def fah-ends?(s, suffix) {
            str_len(s) < str_len(suffix) ? 0 : (String) substring(s, str_len(s) - str_len(suffix), str_len(s)) == suffix ? 1 : 0;
        }

        def fah-grain(path) = (Comparable) fah-ends?(path, ".bml") == 1 ? GrainHigh() : (Comparable) fah-ends?(path, ".bmf") == 1 ? GrainHigh() : (Comparable) fah-ends?(path, ".form") == 1 ? GrainHigh() : (Comparable) fah-ends?(path, ".fkb") == 1 ? GrainNative() : (Comparable) fah-ends?(path, ".dylib") == 1 ? GrainNative() : (Comparable) fah-ends?(path, "-xtal.fk") == 1 ? GrainLower() : (Comparable) fah-ends?(path, "-compile.fk") == 1 ? GrainLower() : (Comparable) fah-ends?(path, "-band.fk") == 1 ? GrainBand() : (Comparable) fah-ends?(path, ".fk") == 1 ? GrainOrgan() : (Comparable) fah-ends?(path, ".c") == 1 ? GrainSeed() : GrainOther();

        def fah-new-meaning-offers?(path) = (Comparable) fah-grain(path) == GrainHigh();

        def fah-wrong-shape?(path) = (Comparable) fah-grain(path) == GrainLower();

        def fah-floor-piece?(path) {
            let g = fah-grain(path);
            (Comparable) g == GrainHigh() ? 1 : (Comparable) g == GrainNative() ? 1 : 0;
        }

        def fah-companion-ok?(path) {
            let g = fah-grain(path);
            (Comparable) g == GrainHigh() ? 1 : (Comparable) g == GrainNative() ? 1 : (Comparable) g == GrainBand() ? 1 : 0;
        }

        def fah-speak() = "author-high floor=high-bml-cached-native xtal=wrong-shape organs-welcome bands-witness seed-shrink";

        def fah-bit(ok, bit) = ok ? bit : 0;
        def fah-check() {
            let c0 = fah-bit((Comparable) fah-grain("form/form-stdlib/bml/form-cli-author-high.bml") == GrainHigh(), 1);
            let c1 = fah-bit((Comparable) fah-grain("grammars/host-effect-vocabulary.bmf") == GrainHigh(), 2);
            let c2 = fah-bit((Comparable) fah-grain("grammars/bml-native-north-star.form") == GrainHigh(), 4);
            let c3 = fah-bit(((Comparable) fah-grain("form/form-stdlib/form-cli-author-high-xtal.fk") == GrainLower()) && ((Comparable) fah-wrong-shape?("form/form-stdlib/form-cli-author-high-xtal.fk") == 1), 8);
            let c4 = fah-bit((Comparable) fah-grain("form/form-stdlib/tests/form-cli-author-high-band.fk") == GrainBand(), 16);
            let c5 = fah-bit((Comparable) fah-grain("form/form-stdlib/core.fk") == GrainOrgan(), 32);
            let c6 = fah-bit((Comparable) fah-grain("runtime/fkwu-uni.c") == GrainSeed(), 64);
            let c7 = fah-bit(((Comparable) fah-new-meaning-offers?("a.bml") == 1) && ((Comparable) fah-new-meaning-offers?("a.fk") == 0), 128);
            let c8 = fah-bit(((Comparable) fah-grain("a.fkb") == GrainNative()) && ((Comparable) fah-floor-piece?("a.fkb") == 1), 256);
            let c9 = fah-bit(((Comparable) fah-companion-ok?("a-xtal.fk") == 0) && ((Comparable) fah-companion-ok?("a.dylib") == 1), 512);
            c0 + (c1 + (c2 + (c3 + (c4 + (c5 + (c6 + (c7 + (c8 + c9))))))));
        }
    }
    0;
}
