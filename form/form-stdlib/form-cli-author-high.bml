//////////////////////////////////////////////////////////////////////
//
// form-cli-author-high.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-author-high.bml
//
// Floor: high-grammar BML + optimal cached native speed compiler
// (.fkb / .dylib). xtal is the wrong shape — not the floor.
//
// Proven by: form-stdlib/tests/form-cli-author-high-band.fk
//
// preludes: form/form-stdlib/core.fk form/form-stdlib/language-model.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template GrainCell<TPath> {
        member path: TPath;
        member grain: int;
    }

    class FormAuthorHighAuthority {
        field AuthorAuthorityPath = "form/form-stdlib/bml/form-cli-author-high.bml";
        field AuthorAuthorityKind = "high-bml-class-template-field";
    }

    class FormAuthorHigh<T> {
        field GrainHigh = 0;
        field GrainLower = 1;
        field GrainBand = 2;
        field GrainOrgan = 3;
        field GrainSeed = 4;
        field GrainNative = 5;
        field GrainOther = 6;

        ref fah-authority = FormAuthorHighAuthority;
        thought fah-pattern = list("floor-high-bml-cached-native", "xtal-wrong-shape", "organs-welcome", "bands-witness", "seed-shrink");

        def fah-ends?(s, suffix) {
            if lt(str_len(s), str_len(suffix)) then 0 else if str_eq(substring(s, sub(str_len(s), str_len(suffix)), str_len(s)), suffix) then 1 else 0;
        }

        def fah-grain(path) = if eq(fah-ends?(path, ".bml"), 1) then GrainHigh() else if eq(fah-ends?(path, ".bmf"), 1) then GrainHigh() else if eq(fah-ends?(path, ".form"), 1) then GrainHigh() else if eq(fah-ends?(path, ".fkb"), 1) then GrainNative() else if eq(fah-ends?(path, ".dylib"), 1) then GrainNative() else if eq(fah-ends?(path, "-xtal.fk"), 1) then GrainLower() else if eq(fah-ends?(path, "-compile.fk"), 1) then GrainLower() else if eq(fah-ends?(path, "-band.fk"), 1) then GrainBand() else if eq(fah-ends?(path, ".fk"), 1) then GrainOrgan() else if eq(fah-ends?(path, ".c"), 1) then GrainSeed() else GrainOther();

        def fah-new-meaning-offers?(path) = eq(fah-grain(path), GrainHigh());

        def fah-wrong-shape?(path) = eq(fah-grain(path), GrainLower());

        def fah-floor-piece?(path) {
            let g = fah-grain(path);
            if eq(g, GrainHigh()) then 1 else if eq(g, GrainNative()) then 1 else 0;
        }

        def fah-companion-ok?(path) {
            let g = fah-grain(path);
            if eq(g, GrainHigh()) then 1 else if eq(g, GrainNative()) then 1 else if eq(g, GrainBand()) then 1 else 0;
        }

        def fah-speak() = "author-high floor=high-bml-cached-native xtal=wrong-shape organs-welcome bands-witness seed-shrink";

        def fah-bit(ok, bit) = if ok then bit else 0;
        def fah-check() {
            let c0 = fah-bit(eq(fah-grain("form/form-stdlib/bml/form-cli-author-high.bml"), GrainHigh()), 1);
            let c1 = fah-bit(eq(fah-grain("grammars/stdlib-uplift-missing-grammars.bmf"), GrainHigh()), 2);
            let c2 = fah-bit(eq(fah-grain("grammars/field-domain-grammars.form"), GrainHigh()), 4);
            let c3 = fah-bit(and(eq(fah-grain("form/form-stdlib/form-cli-author-high-xtal.fk"), GrainLower()), eq(fah-wrong-shape?("form/form-stdlib/form-cli-author-high-xtal.fk"), 1)), 8);
            let c4 = fah-bit(eq(fah-grain("form/form-stdlib/tests/form-cli-author-high-band.fk"), GrainBand()), 16);
            let c5 = fah-bit(eq(fah-grain("form/form-stdlib/core.fk"), GrainOrgan()), 32);
            let c6 = fah-bit(eq(fah-grain("runtime/fkwu-uni.c"), GrainSeed()), 64);
            let c7 = fah-bit(and(eq(fah-new-meaning-offers?("a.bml"), 1), eq(fah-new-meaning-offers?("a.fk"), 0)), 128);
            let c8 = fah-bit(and(eq(fah-grain("a.fkb"), GrainNative()), eq(fah-floor-piece?("a.fkb"), 1)), 256);
            let c9 = fah-bit(and(eq(fah-companion-ok?("a-xtal.fk"), 0), eq(fah-companion-ok?("a.dylib"), 1)), 512);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, add(c7, add(c8, c9)))))))));
        }
    }
    0;
}
