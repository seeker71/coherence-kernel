; form-cli-nodeid-knowledge-on-demand-run.fk — one scannerless NodeID/current
; source request in its own Form source unit.
;
; The parent form-cli stages `query:<key>` or `stage:<stage>:<key>` in argv.
; This runner reads those bytes directly with input_byte; it opens no model and
; owns no Metal state.  Its imported door performs the persisted one-bucket
; lookup and current-source read.
;
; PROOF LEVEL: FOURTH-ARM ONLY (staged argv + persisted registry/source bytes)
; preludes: form-stdlib/form-cli-nodeid-knowledge-door.fk

(do
    (defn fcnkod-read-loop (i acc)
        (do
            (let b (input_byte i))
            (if (eq b 0) acc
                (fcnkod-read-loop (add i 1)
                    (str_concat acc (byte_to_str b))))))

    (defn fcnkod-input () (fcnkod-read-loop 0 ""))

    (defn fcnkod-after (s marker from)
        (do
            (let at (str_find s marker from))
            (if (lt at 0) ""
                (substring s (add at (str_len marker)) (str_len s)))))

    (defn fcnkod-stage-name (s)
        (do
            (let start (str_len "stage:"))
            (let stop (str_find s ":" start))
            (if (lt stop 0) "" (substring s start stop))))

    (defn fcnkod-stage-input (s)
        (do
            (let start (str_len "stage:"))
            (let stop (str_find s ":" start))
            (if (lt stop 0) "" (substring s (add stop 1) (str_len s)))))

    (let offered (fcnkod-input))
    (if (eq (str_find offered "query:" 0) 0)
        (fcnkd-query (fcnkod-after offered "query:" 0))
        (if (eq (str_find offered "stage:" 0) 0)
            (fcnkd-stage (fcnkod-stage-name offered)
                (fcnkod-stage-input offered))
            "nodeid-knowledge\nstatus=nothing\nreason=on-demand-surface-invalid")))
