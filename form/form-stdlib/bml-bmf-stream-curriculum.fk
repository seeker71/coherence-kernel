// bml-bmf-stream-curriculum.fk -- source-grounded BML/BMF live-cursor curriculum.
//
// This cell teaches and evaluates one honest route:
//
//   BML authoring -> BMF grammar-as-data -> bounded streaming transducer
//
// The transducer consumes raw bytes directly.  There is no tokenizer or token
// list before the grammar step.  Each chunk is folded through the same byte
// transition, so chunk boundaries do not enter the semantics.  A carrier may
// supply indefinitely many bounded chunks and consume emitted events as they
// arrive.
//
// Bounded contract (not an empirical claim of infinity): one compiled grammar,
// one fixed-width state row, at most `2 * capture-bound` variable payload bytes
// (current capture plus the last unconsumed event), and no retained source
// history.  The downstream consumer owns event retention.  The Form evaluator's
// call stack, global NodeID store, carrier buffers, and downstream storage are
// explicitly outside this cursor-state bound.
//
// The streaming compiler intentionally admits a deterministic BMF subset:
//
//   stream := record*
//   record := literal capture:class suffix
//   emit   := op(constant, capture)
//
// The suffix's first byte must be outside the capture class.  Unsupported or
// malformed grammars return `empty` (Form nothing); they are never guessed into
// a different grammar.
//
// Ground:
//   form/form-stdlib/bmf-core.fk
//   form/form-stdlib/bmf-grammar.fk
//   form/form-stdlib/bmf-byte-cursor.fk
//   form/form-stdlib/file-byte-window.fk
//   form/form-stdlib/bml.fk
//
// witnessed: 2026-08-24 -> direct fkwu held-out band
// preludes: form-stdlib/core.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk
section [form.bml] {
    // ------------------------------------------------------------------
    // Curriculum manifest and source-attributed train/held-out rows.
    // ------------------------------------------------------------------
    def bbsc-feature(name, status, evidence) = list("bml-bmf-stream-feature", name, status, evidence);
    def bbsc-feature-name(row) = nth(row, 1);
    def bbsc-feature-status(row) = nth(row, 2);
    def bbsc-feature-evidence(row) = nth(row, 3);
    def bbsc-manifest() = list(bbsc-feature("executable-bml", 1, "form/form-stdlib/bml-bmf-stream-curriculum.bml"), bbsc-feature("custom-bmf-grammar", 1, "form/form-stdlib/bmf-grammar.fk"), bbsc-feature("grammar-to-stream-lowering", 1, "bbsc-compile-grammar"), bbsc-feature("scannerless-byte-fold", 1, "bbsc-feed-chunk"), bbsc-feature("no-tokenizer-prestep", 1, "form/form-stdlib/bmf-core.fk"), bbsc-feature("chunk-boundary-invariant", 1, "bbsc-feed-all-splits?"), bbsc-feature("continuation-and-incomplete", 1, "bbsc-finish"), bbsc-feature("bounded-retained-state", 1, "bbsc-retained-bound"), bbsc-feature("malformed-is-nothing", 1, "bbsc-compile-grammar"), bbsc-feature("finite-contract-not-infinity-claim", 1, "2*capture-bound variable payload bytes"));
    def bbsc-manifest-has?(name, rows) = nil?(rows) ? 0 : (String) bbsc-feature-name(head(rows)) == name && (Comparable) bbsc-feature-status(head(rows)) == 1 ? 1 : bbsc-manifest-has?(name, tail(rows));
    // row = tag, split, skill, family, prompt, target, source paths
    def bbsc-lesson(split, skill, family, prompt, target, sources) = list("bml-bmf-stream-lesson", split, skill, family, prompt, target, sources);
    def bbsc-lesson-split(row) = nth(row, 1);
    def bbsc-lesson-skill(row) = nth(row, 2);
    def bbsc-lesson-family(row) = nth(row, 3);
    def bbsc-lesson-prompt(row) = nth(row, 4);
    def bbsc-lesson-target(row) = nth(row, 5);
    def bbsc-lesson-sources(row) = nth(row, 6);
    def bbsc-ground-sources() = list("form/form-stdlib/bmf-core.fk", "form/form-stdlib/bmf-grammar.fk", "form/form-stdlib/bmf-byte-cursor.fk", "form/form-stdlib/file-byte-window.fk", "form/form-stdlib/bml.fk");
    def bbsc-training-rows() = list(bbsc-lesson("train", "write-bml", "metric", "Write a BML metric class with a bounded capture field.", "package Learn.metric; class MetricCursor { section [public] { const int Bound = 8; } }", bbsc-ground-sources()), bbsc-lesson("train", "author-bmf", "alarm", "Construct BMF data for alarm=digits; and emit an alarm node.", "grammar/rule3/p-lit/p-cap/p-run/t-emit", bbsc-ground-sources()), bbsc-lesson("train", "stream-cursor", "route", "Fold route=7; as bytes across three chunks without tokens.", "scannerless byte transition; ready only after suffix", bbsc-ground-sources()));
    def bbsc-heldout-rows() = list(bbsc-lesson("heldout", "write-bml", "cursor-authority", "Write an executable BML curriculum authority with a generic lesson.", "form/form-stdlib/bml/bml-bmf-stream-curriculum.bml", bbsc-ground-sources()), bbsc-lesson("heldout", "author-bmf", "signal", "Author and lower a custom signal=digits; BMF grammar.", "bbsc-heldout-grammar -> bbsc-compile-grammar", bbsc-ground-sources()), bbsc-lesson("heldout", "stream-cursor", "signal", "Transmute two signal records across every byte boundary.", "bbsc-feed-all-splits?", bbsc-ground-sources()));
    def bbsc-row-exact?(a, b) = (String) bbsc-lesson-skill(a) == bbsc-lesson-skill(b) && ((String) bbsc-lesson-family(a) == bbsc-lesson-family(b) && ((String) bbsc-lesson-prompt(a) == bbsc-lesson-prompt(b) && (String) bbsc-lesson-target(a) == bbsc-lesson-target(b)));
    def bbsc-row-in?(row, rows) = nil?(rows) ? 0 : bbsc-row-exact?(row, head(rows)) ? 1 : bbsc-row-in?(row, tail(rows));
    def bbsc-leakage-loop(held, train) = nil?(held) ? 0 : bbsc-row-in?(head(held), train) + bbsc-leakage-loop(tail(held), train);
    def bbsc-exact-leakage() = bbsc-leakage-loop(bbsc-heldout-rows(), bbsc-training-rows());
    // ------------------------------------------------------------------
    // Held-out custom BMF grammar.  It is grammar/pattern/template DATA.
    // ------------------------------------------------------------------
    def bbsc-heldout-grammar() = grammar("stream", list(rule3("stream", p-cap("records", p-rep(p-ref("record"))), t-emit("do", list(t-splices("records")))), rule3("record", list("seq", p-lit("signal="), p-cap("value", p-run("digit")), p-lit(";")), t-emit("fncall", list(t-const("__signal__"), t-splice("value"))))));
    // ------------------------------------------------------------------
    // Deterministic BMF-subset compiler.
    // program = tag prefix suffix cap-name class emit-op emit-const cap-bound
    // ------------------------------------------------------------------
    def bbsc-tag?(value, tag) = nil?(value) ? 0 : len(value) < 1 ? 0 : (String) head(value) == tag ? 1 : 0;
    def bbsc-known-class?(name) = (String) name == "digit" ? 1 : (String) name == "alpha" ? 1 : (String) name == "alnum" ? 1 : 0;
    def bbsc-stream-rule-shape?(rule) = nil?(rule) ? 0 : !((Comparable) len(rule) == 3) ? 0 : {
        let pat = r3-pat(rule);
        let tpl = r3-tpl(rule);
        !(bbsc-tag?(pat, "cap") && (Comparable) len(pat) == 3) ? 0 : !(bbsc-tag?(nth(pat, 2), "rep") && (Comparable) len(nth(pat, 2)) == 2) ? 0 : !(bbsc-tag?(nth(nth(pat, 2), 1), "ref") && (Comparable) len(nth(nth(pat, 2), 1)) == 2) ? 0 : !((String) nth(nth(nth(pat, 2), 1), 1) == "record") ? 0 : !(bbsc-tag?(tpl, "emit") && (Comparable) len(tpl) == 3) ? 0 : !((String) nth(tpl, 1) == "do") ? 0 : !((Comparable) len(nth(tpl, 2)) == 1) ? 0 : bbsc-tag?(head(nth(tpl, 2)), "splice*") ? 1 : 0;
    };
    def bbsc-record-rule-shape?(rule) = nil?(rule) ? 0 : !((Comparable) len(rule) == 3) ? 0 : {
        let pat = r3-pat(rule);
        let tpl = r3-tpl(rule);
        !(bbsc-tag?(pat, "seq") && (Comparable) len(pat) == 4) ? 0 : {
            let prefix = nth(pat, 1);
            let capture = nth(pat, 2);
            let suffix = nth(pat, 3);
            !(bbsc-tag?(prefix, "lit") && (Comparable) len(prefix) == 2) ? 0 : !(bbsc-tag?(capture, "cap") && (Comparable) len(capture) == 3) ? 0 : !(bbsc-tag?(nth(capture, 2), "run") && (Comparable) len(nth(capture, 2)) == 2) ? 0 : !(bbsc-tag?(suffix, "lit") && (Comparable) len(suffix) == 2) ? 0 : !(bbsc-tag?(tpl, "emit") && (Comparable) len(tpl) == 3) ? 0 : !((Comparable) len(nth(tpl, 2)) == 2) ? 0 : {
                let first-kid = head(nth(tpl, 2));
                let second-kid = nth(nth(tpl, 2), 1);
                !(bbsc-tag?(first-kid, "const") && (Comparable) len(first-kid) == 2) ? 0 : !(bbsc-tag?(second-kid, "splice") && (Comparable) len(second-kid) == 2) ? 0 : (String) nth(capture, 1) == nth(second-kid, 1) ? 1 : 0;
            };
        };
    };
    def bbsc-program(prefix, suffix, cap-name, class-name, emit-op, emit-const, cap-bound) = list("bbsc-program", prefix, suffix, cap-name, class-name, emit-op, emit-const, cap-bound);
    def bbsc-program?(program) = bbsc-tag?(program, "bbsc-program");
    def bbsc-prefix(program) = nth(program, 1);
    def bbsc-suffix(program) = nth(program, 2);
    def bbsc-cap-name(program) = nth(program, 3);
    def bbsc-class-name(program) = nth(program, 4);
    def bbsc-emit-op(program) = nth(program, 5);
    def bbsc-emit-const(program) = nth(program, 6);
    def bbsc-cap-bound(program) = nth(program, 7);
    def bbsc-compile-grammar(g, cap-bound) = nil?(g) || cap-bound <= 0 ? empty() : !bbsc-tag?(g, "G") ? empty() : {
        let stream-rule = g-rule(g, g-start(g));
        let record-rule = g-rule(g, "record");
        !bbsc-stream-rule-shape?(stream-rule) ? empty() : !bbsc-record-rule-shape?(record-rule) ? empty() : {
            let pat = r3-pat(record-rule);
            let tpl = r3-tpl(record-rule);
            let prefix = nth(nth(pat, 1), 1);
            let capture = nth(pat, 2);
            let suffix = nth(nth(pat, 3), 1);
            let class-name = nth(nth(capture, 2), 1);
            let emit-kids = nth(tpl, 2);
            (Comparable) str_len(prefix) == 0 || (Comparable) str_len(suffix) == 0 ? empty() : !bbsc-known-class?(class-name) ? empty() : cp-in-class?(str_byte_at(suffix, 0), class-name) ? empty() : bbsc-program(prefix, suffix, nth(capture, 1), class-name, nth(tpl, 1), nth(head(emit-kids), 1), cap-bound);
        };
    };
    // ------------------------------------------------------------------
    // Live byte state.  Only current capture + last event vary with input.
    // ------------------------------------------------------------------
    // state fields:
    // tag program phase index capture count digest total peak status last-event
    def bbsc-state-row(program, phase, index, capture, count, digest, total, peak, status, last-event) = list("bbsc-state", program, phase, index, capture, count, digest, total, peak, status, last-event);
    def bbsc-state?(state) = bbsc-tag?(state, "bbsc-state");
    def bbsc-state-program(state) = nth(state, 1);
    def bbsc-state-phase(state) = nth(state, 2);
    def bbsc-state-index(state) = nth(state, 3);
    def bbsc-state-capture(state) = nth(state, 4);
    def bbsc-state-count(state) = nth(state, 5);
    def bbsc-state-digest(state) = nth(state, 6);
    def bbsc-state-total(state) = nth(state, 7);
    def bbsc-state-peak(state) = nth(state, 8);
    def bbsc-state-status(state) = nth(state, 9);
    def bbsc-state-last-event(state) = nth(state, 10);
    def bbsc-event(name, value) = list("bbsc-event", name, value);
    def bbsc-event?(event) = bbsc-tag?(event, "bbsc-event");
    def bbsc-event-name(event) = nth(event, 1);
    def bbsc-event-value(event) = nth(event, 2);
    def bbsc-event-bytes(event) = bbsc-event?(event) ? str_len(bbsc-event-value(event)) : 0;
    def bbsc-retained-payload(state) = bbsc-state?(state) ? str_len(bbsc-state-capture(state)) + bbsc-event-bytes(bbsc-state-last-event(state)) : 0;
    def bbsc-retained-bound(program) = bbsc-program?(program) ? 2 * bbsc-cap-bound(program) : 0;
    def bbsc-state-with(state, phase, index, capture, count, digest, total, peak, status, last-event) = bbsc-state-row(bbsc-state-program(state), phase, index, capture, count, digest, total, peak, status, last-event);
    def bbsc-state-with-status(state, status) = bbsc-state-with(state, bbsc-state-phase(state), bbsc-state-index(state), bbsc-state-capture(state), bbsc-state-count(state), bbsc-state-digest(state), bbsc-state-total(state), bbsc-state-peak(state), status, bbsc-state-last-event(state));
    def bbsc-peak-next(state, capture, event) = max2(bbsc-state-peak(state), str_len(capture) + bbsc-event-bytes(event));
    def bbsc-open-program(program) = bbsc-program?(program) ? bbsc-state-row(program, "prefix", 0, "", 0, 0, 0, 0, "ready", empty()) : empty();
    def bbsc-open(g, cap-bound) = bbsc-open-program(bbsc-compile-grammar(g, cap-bound));
    def bbsc-class-byte?(program, byte) = cp-in-class?(byte, bbsc-class-name(program)) ? 1 : 0;
    def bbsc-reject(state, status) = bbsc-state-with(state, "reject", 0, bbsc-state-capture(state), bbsc-state-count(state), bbsc-state-digest(state), bbsc-state-total(state) + 1, bbsc-state-peak(state), status, bbsc-state-last-event(state));
    def bbsc-digest-next(digest, capture) = (digest * 131 + str_to_int(capture)) % 2147483647;
    def bbsc-emit-reset(state) = {
        let program = bbsc-state-program(state);
        let capture = bbsc-state-capture(state);
        let event = bbsc-event(bbsc-emit-const(program), capture);
        let peak = bbsc-peak-next(state, capture, event);
        bbsc-state-with(state, "prefix", 0, "", (bbsc-state-count(state) + 1) % 2147483647, bbsc-digest-next(bbsc-state-digest(state), capture), bbsc-state-total(state) + 1, peak, "ready", event);
    };
    def bbsc-step-prefix(state, byte) = {
        let program = bbsc-state-program(state);
        let index = bbsc-state-index(state);
        let prefix = bbsc-prefix(program);
        !((Comparable) byte == str_byte_at(prefix, index)) ? bbsc-reject(state, "malformed") : (Comparable) (index + 1) == str_len(prefix) ? bbsc-state-with(state, "capture", 0, "", bbsc-state-count(state), bbsc-state-digest(state), bbsc-state-total(state) + 1, bbsc-state-peak(state), "continue", bbsc-state-last-event(state)) : bbsc-state-with(state, "prefix", index + 1, "", bbsc-state-count(state), bbsc-state-digest(state), bbsc-state-total(state) + 1, bbsc-state-peak(state), "continue", bbsc-state-last-event(state));
    };
    def bbsc-step-capture(state, byte) = {
        let program = bbsc-state-program(state);
        let capture = bbsc-state-capture(state);
        let suffix = bbsc-suffix(program);
        (Comparable) bbsc-class-byte?(program, byte) == 1 ? str_len(capture) >= bbsc-cap-bound(program) ? bbsc-reject(state, "overflow") : {
            let capture2 = str_concat(capture, byte_to_str(byte));
            bbsc-state-with(state, "capture", 0, capture2, bbsc-state-count(state), bbsc-state-digest(state), bbsc-state-total(state) + 1, bbsc-peak-next(state, capture2, bbsc-state-last-event(state)), "continue", bbsc-state-last-event(state));
        } : str_len(capture) > 0 && (Comparable) byte == str_byte_at(suffix, 0) ? (Comparable) str_len(suffix) == 1 ? bbsc-emit-reset(state) : bbsc-state-with(state, "suffix", 1, capture, bbsc-state-count(state), bbsc-state-digest(state), bbsc-state-total(state) + 1, bbsc-state-peak(state), "continue", bbsc-state-last-event(state)) : bbsc-reject(state, "malformed");
    };
    def bbsc-step-suffix(state, byte) = {
        let suffix = bbsc-suffix(bbsc-state-program(state));
        let index = bbsc-state-index(state);
        !((Comparable) byte == str_byte_at(suffix, index)) ? bbsc-reject(state, "malformed") : (Comparable) (index + 1) == str_len(suffix) ? bbsc-emit-reset(state) : bbsc-state-with(state, "suffix", index + 1, bbsc-state-capture(state), bbsc-state-count(state), bbsc-state-digest(state), bbsc-state-total(state) + 1, bbsc-state-peak(state), "continue", bbsc-state-last-event(state));
    };
    def bbsc-step-byte(state, byte) = !bbsc-state?(state) ? empty() : (String) bbsc-state-phase(state) == "reject" ? state : (String) bbsc-state-phase(state) == "prefix" ? bbsc-step-prefix(state, byte) : (String) bbsc-state-phase(state) == "capture" ? bbsc-step-capture(state, byte) : (String) bbsc-state-phase(state) == "suffix" ? bbsc-step-suffix(state, byte) : bbsc-reject(state, "malformed");
    def bbsc-feed-chunk-loop(state, chunk, i) = !bbsc-state?(state) || i >= str_len(chunk) ? state : bbsc-feed-chunk-loop(bbsc-step-byte(state, str_byte_at(chunk, i)), chunk, i + 1);
    def bbsc-feed-chunk(state, chunk) = !bbsc-state?(state) ? empty() : bbsc-feed-chunk-loop(state, chunk, 0);
    def bbsc-feed-chunks(state, chunks) = !bbsc-state?(state) ? empty() : nil?(chunks) ? state : bbsc-feed-chunks(bbsc-feed-chunk(state, head(chunks)), tail(chunks));
    def bbsc-finish(state) = !bbsc-state?(state) ? empty() : (String) bbsc-state-phase(state) == "reject" ? state : (String) bbsc-state-phase(state) == "prefix" && (Comparable) bbsc-state-index(state) == 0 ? bbsc-state-with-status(state, "complete") : bbsc-state-with-status(state, "incomplete");
    // ------------------------------------------------------------------
    // Held-out observations and chunk equivalence helpers.
    // ------------------------------------------------------------------
    def bbsc-source() = "signal=12;signal=345;";
    def bbsc-state-equivalent?(a, b) = !bbsc-state?(a) || !bbsc-state?(b) ? 0 : (String) bbsc-state-phase(a) == bbsc-state-phase(b) && ((Comparable) bbsc-state-index(a) == bbsc-state-index(b) && ((String) bbsc-state-capture(a) == bbsc-state-capture(b) && ((Comparable) bbsc-state-count(a) == bbsc-state-count(b) && ((Comparable) bbsc-state-digest(a) == bbsc-state-digest(b) && ((Comparable) bbsc-state-total(a) == bbsc-state-total(b) && ((String) bbsc-state-status(a) == bbsc-state-status(b) && (bbsc-event?(bbsc-state-last-event(a)) && bbsc-event?(bbsc-state-last-event(b)) ? (String) bbsc-event-name(bbsc-state-last-event(a)) == bbsc-event-name(bbsc-state-last-event(b)) && (String) bbsc-event-value(bbsc-state-last-event(a)) == bbsc-event-value(bbsc-state-last-event(b)) : nil?(bbsc-state-last-event(a)) && nil?(bbsc-state-last-event(b)))))))));
    def bbsc-whole-state() = bbsc-finish(bbsc-feed-chunk(bbsc-open(bbsc-heldout-grammar(), 8), bbsc-source()));
    def bbsc-split-state(at) = {
        let source = bbsc-source();
        bbsc-finish(bbsc-feed-chunks(bbsc-open(bbsc-heldout-grammar(), 8), list(substring(source, 0, at), substring(source, at, str_len(source)))));
    };
    def bbsc-feed-all-splits-loop(at, n, whole) = at > n ? 1 : bbsc-state-equivalent?(whole, bbsc-split-state(at)) ? bbsc-feed-all-splits-loop(at + 1, n, whole) : 0;
    def bbsc-feed-all-splits?() = {
        let whole = bbsc-whole-state();
        bbsc-feed-all-splits-loop(0, str_len(bbsc-source()), whole);
    };
    def bbsc-byte-chunks-loop(source, i, acc) = i >= str_len(source) ? reverse(acc) : bbsc-byte-chunks-loop(source, i + 1, cons(substring(source, i, i + 1), acc));
    def bbsc-byte-chunks(source) = bbsc-byte-chunks-loop(source, 0, empty());
    def bbsc-one-byte-state() = bbsc-finish(bbsc-feed-chunks(bbsc-open(bbsc-heldout-grammar(), 8), bbsc-byte-chunks(bbsc-source())));
    def bbsc-repeated-source(n) = n <= 0 ? "" : str_concat("signal=1;", bbsc-repeated-source(n - 1));
    def bbsc-repeated-state(n) = bbsc-finish(bbsc-feed-chunk(bbsc-open(bbsc-heldout-grammar(), 8), bbsc-repeated-source(n)));
    def bbsc-bmf-heldout-node() = g-parse-full(bbsc-heldout-grammar(), bbsc-source());
    def bbsc-bmf-captures(node) = node_eq(node, intern_trivial_string("PARSE-FAIL")) ? empty() : {
        let records = node_children(node);
        (Comparable) len(records) == 2 ? list(node_value(nth(node_children(nth(records, 0)), 1)), node_value(nth(node_children(nth(records, 1)), 1))) : empty();
    };
    def bbsc-bmf-stream-equivalent?() = {
        let captures = bbsc-bmf-captures(bbsc-bmf-heldout-node());
        let state = bbsc-whole-state();
        !((Comparable) len(captures) == 2) ? 0 : (String) nth(captures, 0) == "12" && ((String) nth(captures, 1) == "345" && ((Comparable) bbsc-state-count(state) == 2 && (Comparable) bbsc-state-digest(state) == bbsc-digest-next(bbsc-digest-next(0, "12"), "345")));
    };
    0;
}
