; bml-bmf-stream-curriculum.fk -- source-grounded BML/BMF live-cursor curriculum.
;
; This cell teaches and evaluates one honest route:
;
;   BML authoring -> BMF grammar-as-data -> bounded streaming transducer
;
; The transducer consumes raw bytes directly.  There is no tokenizer or token
; list before the grammar step.  Each chunk is folded through the same byte
; transition, so chunk boundaries do not enter the semantics.  A carrier may
; supply indefinitely many bounded chunks and consume emitted events as they
; arrive.
;
; Bounded contract (not an empirical claim of infinity): one compiled grammar,
; one fixed-width state row, at most `2 * capture-bound` variable payload bytes
; (current capture plus the last unconsumed event), and no retained source
; history.  The downstream consumer owns event retention.  The Form evaluator's
; call stack, global NodeID store, carrier buffers, and downstream storage are
; explicitly outside this cursor-state bound.
;
; The streaming compiler intentionally admits a deterministic BMF subset:
;
;   stream := record*
;   record := literal capture:class suffix
;   emit   := op(constant, capture)
;
; The suffix's first byte must be outside the capture class.  Unsupported or
; malformed grammars return `empty` (Form nothing); they are never guessed into
; a different grammar.
;
; Ground:
;   form/form-stdlib/bmf-core.fk
;   form/form-stdlib/bmf-grammar.fk
;   form/form-stdlib/bmf-byte-cursor.fk
;   form/form-stdlib/file-byte-window.fk
;   form/form-stdlib/bml.fk
;   receipts/2026-07-03-bmf-cursor-language-review.md
;   docs/coherence-substrate/current-language-artifact-path.md
;
; witnessed: 2026-08-24 -> direct fkwu held-out band
; preludes: form-stdlib/core.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk

(do
    ; ------------------------------------------------------------------
    ; Curriculum manifest and source-attributed train/held-out rows.
    ; ------------------------------------------------------------------

    (defn bbsc-feature (name status evidence)
        (list "bml-bmf-stream-feature" name status evidence))
    (defn bbsc-feature-name (row) (nth row 1))
    (defn bbsc-feature-status (row) (nth row 2))
    (defn bbsc-feature-evidence (row) (nth row 3))
    (defn bbsc-manifest ()
        (list
            (bbsc-feature "executable-bml" 1
                "form/form-stdlib/bml-bmf-stream-curriculum.bml")
            (bbsc-feature "custom-bmf-grammar" 1
                "form/form-stdlib/bmf-grammar.fk")
            (bbsc-feature "grammar-to-stream-lowering" 1
                "bbsc-compile-grammar")
            (bbsc-feature "scannerless-byte-fold" 1
                "bbsc-feed-chunk")
            (bbsc-feature "no-tokenizer-prestep" 1
                "form/form-stdlib/bmf-core.fk")
            (bbsc-feature "chunk-boundary-invariant" 1
                "bbsc-feed-all-splits?")
            (bbsc-feature "continuation-and-incomplete" 1
                "bbsc-finish")
            (bbsc-feature "bounded-retained-state" 1
                "bbsc-retained-bound")
            (bbsc-feature "malformed-is-nothing" 1
                "bbsc-compile-grammar")
            (bbsc-feature "finite-contract-not-infinity-claim" 1
                "2*capture-bound variable payload bytes")))
    (defn bbsc-manifest-has? (name rows)
        (if (nil? rows) 0
            (if (and (str_eq (bbsc-feature-name (head rows)) name)
                     (eq (bbsc-feature-status (head rows)) 1))
                1
                (bbsc-manifest-has? name (tail rows)))))

    ; row = tag, split, skill, family, prompt, target, source paths
    (defn bbsc-lesson (split skill family prompt target sources)
        (list "bml-bmf-stream-lesson" split skill family prompt target sources))
    (defn bbsc-lesson-split (row) (nth row 1))
    (defn bbsc-lesson-skill (row) (nth row 2))
    (defn bbsc-lesson-family (row) (nth row 3))
    (defn bbsc-lesson-prompt (row) (nth row 4))
    (defn bbsc-lesson-target (row) (nth row 5))
    (defn bbsc-lesson-sources (row) (nth row 6))
    (defn bbsc-ground-sources ()
        (list
            "form/form-stdlib/bmf-core.fk"
            "form/form-stdlib/bmf-grammar.fk"
            "form/form-stdlib/bmf-byte-cursor.fk"
            "form/form-stdlib/file-byte-window.fk"
            "form/form-stdlib/bml.fk"
            "receipts/2026-07-03-bmf-cursor-language-review.md"
            "docs/coherence-substrate/current-language-artifact-path.md"))
    (defn bbsc-training-rows ()
        (list
            (bbsc-lesson "train" "write-bml" "metric"
                "Write a BML metric class with a bounded capture field."
                "package Learn.metric; class MetricCursor { section [public] { const int Bound = 8; } }"
                (bbsc-ground-sources))
            (bbsc-lesson "train" "author-bmf" "alarm"
                "Construct BMF data for alarm=digits; and emit an alarm node."
                "grammar/rule3/p-lit/p-cap/p-run/t-emit"
                (bbsc-ground-sources))
            (bbsc-lesson "train" "stream-cursor" "route"
                "Fold route=7; as bytes across three chunks without tokens."
                "scannerless byte transition; ready only after suffix"
                (bbsc-ground-sources))))
    (defn bbsc-heldout-rows ()
        (list
            (bbsc-lesson "heldout" "write-bml" "cursor-authority"
                "Write an executable BML curriculum authority with a generic lesson."
                "form/form-stdlib/bml/bml-bmf-stream-curriculum.bml"
                (bbsc-ground-sources))
            (bbsc-lesson "heldout" "author-bmf" "signal"
                "Author and lower a custom signal=digits; BMF grammar."
                "bbsc-heldout-grammar -> bbsc-compile-grammar"
                (bbsc-ground-sources))
            (bbsc-lesson "heldout" "stream-cursor" "signal"
                "Transmute two signal records across every byte boundary."
                "bbsc-feed-all-splits?"
                (bbsc-ground-sources))))
    (defn bbsc-row-exact? (a b)
        (and (str_eq (bbsc-lesson-skill a) (bbsc-lesson-skill b))
             (and (str_eq (bbsc-lesson-family a) (bbsc-lesson-family b))
                  (and (str_eq (bbsc-lesson-prompt a) (bbsc-lesson-prompt b))
                       (str_eq (bbsc-lesson-target a) (bbsc-lesson-target b))))))
    (defn bbsc-row-in? (row rows)
        (if (nil? rows) 0
            (if (bbsc-row-exact? row (head rows)) 1
                (bbsc-row-in? row (tail rows)))))
    (defn bbsc-leakage-loop (held train)
        (if (nil? held) 0
            (add (bbsc-row-in? (head held) train)
                 (bbsc-leakage-loop (tail held) train))))
    (defn bbsc-exact-leakage ()
        (bbsc-leakage-loop (bbsc-heldout-rows) (bbsc-training-rows)))

    ; ------------------------------------------------------------------
    ; Held-out custom BMF grammar.  It is grammar/pattern/template DATA.
    ; ------------------------------------------------------------------

    (defn bbsc-heldout-grammar ()
        (grammar "stream" (list
            (rule3 "stream"
                (p-cap "records" (p-rep (p-ref "record")))
                (t-emit "do" (list (t-splices "records"))))
            (rule3 "record"
                (list "seq"
                    (p-lit "signal=")
                    (p-cap "value" (p-run "digit"))
                    (p-lit ";"))
                (t-emit "fncall"
                    (list (t-const "__signal__") (t-splice "value")))))))

    ; ------------------------------------------------------------------
    ; Deterministic BMF-subset compiler.
    ; program = tag prefix suffix cap-name class emit-op emit-const cap-bound
    ; ------------------------------------------------------------------

    (defn bbsc-tag? (value tag)
        (if (nil? value) 0
            (if (lt (len value) 1) 0
                (if (str_eq (head value) tag) 1 0))))
    (defn bbsc-known-class? (name)
        (if (str_eq name "digit") 1
            (if (str_eq name "alpha") 1
                (if (str_eq name "alnum") 1 0))))
    (defn bbsc-stream-rule-shape? (rule)
        (if (nil? rule) 0
            (if (not (eq (len rule) 3)) 0
                (do
                    (let pat (r3-pat rule))
                    (let tpl (r3-tpl rule))
                    (if (not (and (bbsc-tag? pat "cap") (eq (len pat) 3))) 0
                        (if (not (and (bbsc-tag? (nth pat 2) "rep")
                                     (eq (len (nth pat 2)) 2))) 0
                            (if (not (and (bbsc-tag? (nth (nth pat 2) 1) "ref")
                                         (eq (len (nth (nth pat 2) 1)) 2))) 0
                                (if (not (str_eq (nth (nth (nth pat 2) 1) 1) "record")) 0
                                    (if (not (and (bbsc-tag? tpl "emit")
                                                 (eq (len tpl) 3))) 0
                                        (if (not (str_eq (nth tpl 1) "do")) 0
                                            (if (not (eq (len (nth tpl 2)) 1)) 0
                                                (if (bbsc-tag? (head (nth tpl 2)) "splice*") 1 0))))))))))))
    (defn bbsc-record-rule-shape? (rule)
        (if (nil? rule) 0
            (if (not (eq (len rule) 3)) 0
                (do
                    (let pat (r3-pat rule))
                    (let tpl (r3-tpl rule))
                    (if (not (and (bbsc-tag? pat "seq") (eq (len pat) 4))) 0
                        (do
                            (let prefix (nth pat 1))
                            (let capture (nth pat 2))
                            (let suffix (nth pat 3))
                            (if (not (and (bbsc-tag? prefix "lit") (eq (len prefix) 2))) 0
                                (if (not (and (bbsc-tag? capture "cap") (eq (len capture) 3))) 0
                                    (if (not (and (bbsc-tag? (nth capture 2) "run")
                                                 (eq (len (nth capture 2)) 2))) 0
                                        (if (not (and (bbsc-tag? suffix "lit") (eq (len suffix) 2))) 0
                                            (if (not (and (bbsc-tag? tpl "emit") (eq (len tpl) 3))) 0
                                                (if (not (eq (len (nth tpl 2)) 2)) 0
                                                    (do
                                                        (let first-kid (head (nth tpl 2)))
                                                        (let second-kid (nth (nth tpl 2) 1))
                                                        (if (not (and (bbsc-tag? first-kid "const")
                                                                     (eq (len first-kid) 2))) 0
                                                            (if (not (and (bbsc-tag? second-kid "splice")
                                                                         (eq (len second-kid) 2))) 0
                                                                (if (str_eq (nth capture 1) (nth second-kid 1)) 1 0))))))))))))))))
    (defn bbsc-program (prefix suffix cap-name class-name emit-op emit-const cap-bound)
        (list "bbsc-program" prefix suffix cap-name class-name emit-op emit-const cap-bound))
    (defn bbsc-program? (program) (bbsc-tag? program "bbsc-program"))
    (defn bbsc-prefix (program) (nth program 1))
    (defn bbsc-suffix (program) (nth program 2))
    (defn bbsc-cap-name (program) (nth program 3))
    (defn bbsc-class-name (program) (nth program 4))
    (defn bbsc-emit-op (program) (nth program 5))
    (defn bbsc-emit-const (program) (nth program 6))
    (defn bbsc-cap-bound (program) (nth program 7))
    (defn bbsc-compile-grammar (g cap-bound)
        (if (or (nil? g) (le cap-bound 0)) (empty)
            (if (not (bbsc-tag? g "G")) (empty)
                (do
                    (let stream-rule (g-rule g (g-start g)))
                    (let record-rule (g-rule g "record"))
                    (if (not (bbsc-stream-rule-shape? stream-rule)) (empty)
                        (if (not (bbsc-record-rule-shape? record-rule)) (empty)
                            (do
                                (let pat (r3-pat record-rule))
                                (let tpl (r3-tpl record-rule))
                                (let prefix (nth (nth pat 1) 1))
                                (let capture (nth pat 2))
                                (let suffix (nth (nth pat 3) 1))
                                (let class-name (nth (nth capture 2) 1))
                                (let emit-kids (nth tpl 2))
                                (if (or (eq (str_len prefix) 0)
                                        (eq (str_len suffix) 0))
                                    (empty)
                                    (if (not (bbsc-known-class? class-name)) (empty)
                                        (if (cp-in-class? (str_byte_at suffix 0) class-name)
                                            (empty)
                                            (bbsc-program
                                                prefix suffix (nth capture 1) class-name
                                                (nth tpl 1) (nth (head emit-kids) 1)
                                                cap-bound)))))))))))

    ; ------------------------------------------------------------------
    ; Live byte state.  Only current capture + last event vary with input.
    ; ------------------------------------------------------------------

    ; state fields:
    ; tag program phase index capture count digest total peak status last-event
    (defn bbsc-state-row
        (program phase index capture count digest total peak status last-event)
        (list "bbsc-state" program phase index capture count digest total peak status last-event))
    (defn bbsc-state? (state) (bbsc-tag? state "bbsc-state"))
    (defn bbsc-state-program (state) (nth state 1))
    (defn bbsc-state-phase (state) (nth state 2))
    (defn bbsc-state-index (state) (nth state 3))
    (defn bbsc-state-capture (state) (nth state 4))
    (defn bbsc-state-count (state) (nth state 5))
    (defn bbsc-state-digest (state) (nth state 6))
    (defn bbsc-state-total (state) (nth state 7))
    (defn bbsc-state-peak (state) (nth state 8))
    (defn bbsc-state-status (state) (nth state 9))
    (defn bbsc-state-last-event (state) (nth state 10))
    (defn bbsc-event (name value) (list "bbsc-event" name value))
    (defn bbsc-event? (event) (bbsc-tag? event "bbsc-event"))
    (defn bbsc-event-name (event) (nth event 1))
    (defn bbsc-event-value (event) (nth event 2))
    (defn bbsc-event-bytes (event)
        (if (bbsc-event? event) (str_len (bbsc-event-value event)) 0))
    (defn bbsc-retained-payload (state)
        (if (bbsc-state? state)
            (add (str_len (bbsc-state-capture state))
                 (bbsc-event-bytes (bbsc-state-last-event state)))
            0))
    (defn bbsc-retained-bound (program)
        (if (bbsc-program? program) (mul 2 (bbsc-cap-bound program)) 0))
    (defn bbsc-state-with
        (state phase index capture count digest total peak status last-event)
        (bbsc-state-row (bbsc-state-program state) phase index capture
            count digest total peak status last-event))
    (defn bbsc-state-with-status (state status)
        (bbsc-state-with state
            (bbsc-state-phase state) (bbsc-state-index state)
            (bbsc-state-capture state) (bbsc-state-count state)
            (bbsc-state-digest state) (bbsc-state-total state)
            (bbsc-state-peak state) status (bbsc-state-last-event state)))
    (defn bbsc-peak-next (state capture event)
        (max2 (bbsc-state-peak state)
              (add (str_len capture) (bbsc-event-bytes event))))
    (defn bbsc-open-program (program)
        (if (bbsc-program? program)
            (bbsc-state-row program "prefix" 0 "" 0 0 0 0 "ready" (empty))
            (empty)))
    (defn bbsc-open (g cap-bound)
        (bbsc-open-program (bbsc-compile-grammar g cap-bound)))
    (defn bbsc-class-byte? (program byte)
        (if (cp-in-class? byte (bbsc-class-name program)) 1 0))
    (defn bbsc-reject (state status)
        (bbsc-state-with state "reject" 0 (bbsc-state-capture state)
            (bbsc-state-count state) (bbsc-state-digest state)
            (add (bbsc-state-total state) 1)
            (bbsc-state-peak state) status (bbsc-state-last-event state)))
    (defn bbsc-digest-next (digest capture)
        (mod (add (mul digest 131) (str_to_int capture)) 2147483647))
    (defn bbsc-emit-reset (state)
        (do
            (let program (bbsc-state-program state))
            (let capture (bbsc-state-capture state))
            (let event (bbsc-event (bbsc-emit-const program) capture))
            (let peak (bbsc-peak-next state capture event))
            (bbsc-state-with state "prefix" 0 ""
                (mod (add (bbsc-state-count state) 1) 2147483647)
                (bbsc-digest-next (bbsc-state-digest state) capture)
                (add (bbsc-state-total state) 1)
                peak "ready" event)))
    (defn bbsc-step-prefix (state byte)
        (do
            (let program (bbsc-state-program state))
            (let index (bbsc-state-index state))
            (let prefix (bbsc-prefix program))
            (if (not (eq byte (str_byte_at prefix index)))
                (bbsc-reject state "malformed")
                (if (eq (add index 1) (str_len prefix))
                    (bbsc-state-with state "capture" 0 ""
                        (bbsc-state-count state) (bbsc-state-digest state)
                        (add (bbsc-state-total state) 1)
                        (bbsc-state-peak state) "continue"
                        (bbsc-state-last-event state))
                    (bbsc-state-with state "prefix" (add index 1) ""
                        (bbsc-state-count state) (bbsc-state-digest state)
                        (add (bbsc-state-total state) 1)
                        (bbsc-state-peak state) "continue"
                        (bbsc-state-last-event state))))))
    (defn bbsc-step-capture (state byte)
        (do
            (let program (bbsc-state-program state))
            (let capture (bbsc-state-capture state))
            (let suffix (bbsc-suffix program))
            (if (eq (bbsc-class-byte? program byte) 1)
                (if (ge (str_len capture) (bbsc-cap-bound program))
                    (bbsc-reject state "overflow")
                    (do
                        (let capture2 (str_concat capture (byte_to_str byte)))
                        (bbsc-state-with state "capture" 0 capture2
                            (bbsc-state-count state) (bbsc-state-digest state)
                            (add (bbsc-state-total state) 1)
                            (bbsc-peak-next state capture2 (bbsc-state-last-event state))
                            "continue" (bbsc-state-last-event state))))
                (if (and (gt (str_len capture) 0)
                         (eq byte (str_byte_at suffix 0)))
                    (if (eq (str_len suffix) 1)
                        (bbsc-emit-reset state)
                        (bbsc-state-with state "suffix" 1 capture
                            (bbsc-state-count state) (bbsc-state-digest state)
                            (add (bbsc-state-total state) 1)
                            (bbsc-state-peak state) "continue"
                            (bbsc-state-last-event state)))
                    (bbsc-reject state "malformed")))))
    (defn bbsc-step-suffix (state byte)
        (do
            (let suffix (bbsc-suffix (bbsc-state-program state)))
            (let index (bbsc-state-index state))
            (if (not (eq byte (str_byte_at suffix index)))
                (bbsc-reject state "malformed")
                (if (eq (add index 1) (str_len suffix))
                    (bbsc-emit-reset state)
                    (bbsc-state-with state "suffix" (add index 1)
                        (bbsc-state-capture state)
                        (bbsc-state-count state) (bbsc-state-digest state)
                        (add (bbsc-state-total state) 1)
                        (bbsc-state-peak state) "continue"
                        (bbsc-state-last-event state))))))
    (defn bbsc-step-byte (state byte)
        (if (not (bbsc-state? state)) (empty)
            (if (str_eq (bbsc-state-phase state) "reject") state
                (if (str_eq (bbsc-state-phase state) "prefix")
                    (bbsc-step-prefix state byte)
                    (if (str_eq (bbsc-state-phase state) "capture")
                        (bbsc-step-capture state byte)
                        (if (str_eq (bbsc-state-phase state) "suffix")
                            (bbsc-step-suffix state byte)
                            (bbsc-reject state "malformed")))))))
    (defn bbsc-feed-chunk-loop (state chunk i)
        (if (or (not (bbsc-state? state)) (ge i (str_len chunk))) state
            (bbsc-feed-chunk-loop
                (bbsc-step-byte state (str_byte_at chunk i))
                chunk (add i 1))))
    (defn bbsc-feed-chunk (state chunk)
        (if (not (bbsc-state? state)) (empty)
            (bbsc-feed-chunk-loop state chunk 0)))
    (defn bbsc-feed-chunks (state chunks)
        (if (not (bbsc-state? state)) (empty)
            (if (nil? chunks) state
                (bbsc-feed-chunks
                    (bbsc-feed-chunk state (head chunks))
                    (tail chunks)))))
    (defn bbsc-finish (state)
        (if (not (bbsc-state? state)) (empty)
            (if (str_eq (bbsc-state-phase state) "reject") state
                (if (and (str_eq (bbsc-state-phase state) "prefix")
                         (eq (bbsc-state-index state) 0))
                    (bbsc-state-with-status state "complete")
                    (bbsc-state-with-status state "incomplete")))))

    ; ------------------------------------------------------------------
    ; Held-out observations and chunk equivalence helpers.
    ; ------------------------------------------------------------------

    (defn bbsc-source () "signal=12;signal=345;")
    (defn bbsc-state-equivalent? (a b)
        (if (or (not (bbsc-state? a)) (not (bbsc-state? b))) 0
            (and (str_eq (bbsc-state-phase a) (bbsc-state-phase b))
                 (and (eq (bbsc-state-index a) (bbsc-state-index b))
                 (and (str_eq (bbsc-state-capture a) (bbsc-state-capture b))
                 (and (eq (bbsc-state-count a) (bbsc-state-count b))
                 (and (eq (bbsc-state-digest a) (bbsc-state-digest b))
                 (and (eq (bbsc-state-total a) (bbsc-state-total b))
                 (and (str_eq (bbsc-state-status a) (bbsc-state-status b))
                      (if (and (bbsc-event? (bbsc-state-last-event a))
                               (bbsc-event? (bbsc-state-last-event b)))
                          (and (str_eq (bbsc-event-name (bbsc-state-last-event a))
                                       (bbsc-event-name (bbsc-state-last-event b)))
                               (str_eq (bbsc-event-value (bbsc-state-last-event a))
                                       (bbsc-event-value (bbsc-state-last-event b))))
                          (and (nil? (bbsc-state-last-event a))
                               (nil? (bbsc-state-last-event b)))))))))))))
    (defn bbsc-whole-state ()
        (bbsc-finish (bbsc-feed-chunk (bbsc-open (bbsc-heldout-grammar) 8) (bbsc-source))))
    (defn bbsc-split-state (at)
        (do
            (let source (bbsc-source))
            (bbsc-finish
                (bbsc-feed-chunks (bbsc-open (bbsc-heldout-grammar) 8)
                    (list (substring source 0 at)
                          (substring source at (str_len source)))))))
    (defn bbsc-feed-all-splits-loop (at n whole)
        (if (gt at n) 1
            (if (bbsc-state-equivalent? whole (bbsc-split-state at))
                (bbsc-feed-all-splits-loop (add at 1) n whole)
                0)))
    (defn bbsc-feed-all-splits? ()
        (do
            (let whole (bbsc-whole-state))
            (bbsc-feed-all-splits-loop 0 (str_len (bbsc-source)) whole)))
    (defn bbsc-byte-chunks-loop (source i acc)
        (if (ge i (str_len source)) (reverse acc)
            (bbsc-byte-chunks-loop source (add i 1)
                (cons (substring source i (add i 1)) acc))))
    (defn bbsc-byte-chunks (source)
        (bbsc-byte-chunks-loop source 0 (empty)))
    (defn bbsc-one-byte-state ()
        (bbsc-finish
            (bbsc-feed-chunks (bbsc-open (bbsc-heldout-grammar) 8)
                (bbsc-byte-chunks (bbsc-source)))))
    (defn bbsc-repeated-source (n)
        (if (le n 0) ""
            (str_concat "signal=1;" (bbsc-repeated-source (sub n 1)))))
    (defn bbsc-repeated-state (n)
        (bbsc-finish
            (bbsc-feed-chunk (bbsc-open (bbsc-heldout-grammar) 8)
                (bbsc-repeated-source n))))
    (defn bbsc-bmf-heldout-node ()
        (g-parse-full (bbsc-heldout-grammar) (bbsc-source)))
    (defn bbsc-bmf-captures (node)
        (if (str_eq (node_value node) "PARSE-FAIL") (empty)
            (do
                (let records (node_children node))
                (if (eq (len records) 2)
                    (list
                        (node_value (nth (node_children (nth records 0)) 1))
                        (node_value (nth (node_children (nth records 1)) 1)))
                    (empty)))))
    (defn bbsc-bmf-stream-equivalent? ()
        (do
            (let captures (bbsc-bmf-captures (bbsc-bmf-heldout-node)))
            (let state (bbsc-whole-state))
            (if (not (eq (len captures) 2)) 0
                (and (str_eq (nth captures 0) "12")
                     (and (str_eq (nth captures 1) "345")
                     (and (eq (bbsc-state-count state) 2)
                          (eq (bbsc-state-digest state)
                              (bbsc-digest-next
                                  (bbsc-digest-next 0 "12") "345"))))))))

    0)
