// vk-carrier.bml — the Vulkan carrier the vk-*-live bands run through (.hearth/vk/run_vk). The carrier
// is a compiled program staged on the host; this tree carries no C source to build it from, so this
// door recognizes a carrier already standing at that path and otherwise names the missing piece, with
// where it looked, voiced as organ health. Door: ./fkwu observe/vk-carrier-build.bml
// preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/organ-health.bml
section [form.bml] {
 class VulkanCarrier {
  def vcb-carrier() = ".hearth/vk/run_vk";

  // ---- the answer: 1 with the carrier standing, 0 with the missing piece named ----
  def vcb-state() = file_size(vcb-carrier()) <= 0 ? "absent" : "standing";
  def vcb-missing(piece, looked) {
   let row = oh-reading("vk-carrier", "stage", piece, json-node-string("found"), json-node-string("absent"), json-node-int(0), [oh-need(piece, json-node-string(looked))], ["request-evidence", "defer"], json-node-object([oh-s("carrier", vcb-carrier()), oh-s("looked", looked)]));
   let said = oh-voice(row);
   let told = print_str("vk-carrier missing " ++ piece ++ ": looked in " ++ looked);
   0;
  }
  def vcb-run() = (String) vcb-state() == "standing" ? vcb-told("standing") : vcb-missing("carrier", vcb-carrier() ++ " (a compiled program staged on the host; no source for it is carried here)");
  def vcb-told(state) {
   let told = print_str("vk-carrier " ++ state ++ " " ++ vcb-carrier());
   1;
  }
 }
 0;
}
