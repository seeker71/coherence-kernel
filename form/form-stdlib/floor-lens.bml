//////////////////////////////////////////////////////////////////////
// floor-lens.bml — every lane against the floor the hardware gives it.
// The floor is measured here, not quoted: a kernel reads a real model
// blob through the handle door and the bytes it moved over the seconds
// it took is this Mac's bandwidth. A lane's floor is the bytes one pass
// MUST touch (its weights, once) over that bandwidth; its distance is
// the measured time over the floor. A lane at 1.0 has nothing left to
// give without touching fewer bytes.
// preludes: form/form-stdlib/metal-door.fk form/form-stdlib/model-registry.bml form/form-stdlib/format-arith.fk form/form-stdlib/term-graphics.bml form/form-stdlib/bml/number.bml
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormFloorLens {
        def fl-nl() = byte_to_str(10);
        def fl-cat(xs) = if ((Comparable) len(xs) == 0) then "" else str_concat(head(xs), fl-cat(tail(xs)));
        def fl-lines(xs) = if ((Comparable) len(xs) == 0) then "" else str_concat(head(xs), str_concat(fl-nl(), fl-lines(tail(xs))));
        // one thread per span of 64 sixteen-byte words; the sum is thrown away, the reads are the point
        def fl-bw-msl() = fl-lines([
            "#include <metal_stdlib>",
            "using namespace metal;",
            "kernel void fl_bw(device const uint4* w [[buffer(0)]], device uint* out [[buffer(1)]], constant uint& n16 [[buffer(2)]], constant uint& per [[buffer(3)]], uint gid [[thread_position_in_grid]]) {",
            "  uint acc = 0; uint base = gid * per; for (uint i = 0; i < per; i++) { uint k = base + i; if (k < n16) { uint4 v = w[k]; acc += v.x ^ v.y ^ v.z ^ v.w; } } if (acc == 0xFFFFFFFFu) out[0] = acc; }"]);
        def fl-pass(p, bufs, n16, per, threads, k) = if (k <= 0) then 0 else fl-pass-go(p, bufs, n16, per, threads, k);
        def fl-pass-go(p, bufs, n16, per, threads, k) {
            let e = metal_enqueue(p, md-bind(bufs, [n16, per]), threads);
            fl-pass(p, bufs, n16, per, threads, (k - 1));
        }
        // to-float lives in number.bml now, said once for the whole body. This line was the
        // first of ten copies of a decimal round-trip standing in for a promotion that was
        // never missing: add(n, 0.0) has always been a float (corpus row 1419 ninenames).
        def fl-float(n) = to-float(n);
        // (bytes-per-pass ms-for-five-passes gigabytes-per-second)
        def fl-measure-bw(path) {
            let size = file_size(path);
            let whole = metal_buf_from_file(path, 0, size);
            let out = metal_buf_alloc(64);
            let p = metal_pipeline(fl-bw-msl(), "fl_bw");
            let n16 = (size / 16);
            let per = 64;
            let threads = ((n16 / per) + 1);
            let warm = fl-pass(p, [whole, out], n16, per, threads, 1);
            let s0 = metal_sync();
            let t0 = now_unix_ms();
            let five = fl-pass(p, [whole, out], n16, per, threads, 5);
            let s1 = metal_sync();
            let t1 = now_unix_ms();
            let ms = (t1 - t0);
            [size, ms, ((5.0 * (fl-float((size / 1000000)) / 1000.0)) / (fl-float(ms) / 1000.0))];
        }
        def fl-gbs(bw) = bw[2];
        // the machine's arithmetic rate, measured the same way the bandwidth is: many fused multiply-adds
        // held in registers, so nothing but the lanes themselves is being timed.
        def fl-flops-msl() = fl-lines([
            "#include <metal_stdlib>",
            "using namespace metal;",
            "kernel void fl_fma(device float* out [[buffer(0)]], constant uint& iters [[buffer(1)]], uint gid [[thread_position_in_grid]]) {",
            "  float4 a0 = float4(float(gid), 1.0f, 2.0f, 3.0f); float4 a1 = a0 + 1.0f; float4 a2 = a0 + 2.0f; float4 a3 = a0 + 3.0f;",
            "  float4 a4 = a0 + 4.0f; float4 a5 = a0 + 5.0f; float4 b = float4(0.999f); float4 c = float4(0.001f);",
            "  for (uint i = 0; i < iters; i++) { a0 = fma(a0, b, c); a1 = fma(a1, b, c); a2 = fma(a2, b, c); a3 = fma(a3, b, c); a4 = fma(a4, b, c); a5 = fma(a5, b, c); }",
            "  if (a0.x + a1.y + a2.z + a3.w + a4.x + a5.y == 12345.678f) out[0] = a0.x; }"]);
        // (threads iters ms teraflops-per-second): three fmas of four lanes each pass, two flops a fma
        def fl-measure-flops() {
            let p = metal_pipeline(fl-flops-msl(), "fl_fma");
            let out = metal_buf_alloc(64);
            let threads = 262144;
            let iters = 2048;
            let warm = metal_enqueue(p, md-bind([out], [iters]), threads);
            let s0 = metal_sync();
            let t0 = now_unix_ms();
            let run = metal_enqueue(p, md-bind([out], [iters]), threads);
            let s1 = metal_sync();
            let t1 = now_unix_ms();
            let ms = (t1 - t0);
            let flops = ((fl-float(threads) * fl-float(iters)) * 48.0);   // six independent chains, four lanes, two flops a fma
            [threads, iters, ms, ((flops / (fl-float(ms) / 1000.0)) / 1000000000000.0)];
        }
        def fl-tflops(f) = f[3];
        // the floor of a pass that must touch `bytes`, in milliseconds, at the measured bandwidth
        def fl-floor-ms(bytes, gbs) = ((fl-float((bytes / 1000)) / 1000000.0) / (gbs / 1000.0));
        def fl-2dp(x) = (fl-float(float_to_int((x * 100.0))) / 100.0);
        // the floor of a pass that must compute `flops`, in milliseconds, at the measured arithmetic rate
        def fl-compute-ms(flops, tflops) = if (tflops <= 0.0) then 0.0 else ((fl-float((flops / 1000000)) / 1000000.0) / (tflops / 1000.0));
        // a lane is held by whichever floor is higher: the bytes it must move or the arithmetic it must do
        def fl-row2(name, bytes, flops, total-ms, count, gbs, tflops) {
            let mem = fl-floor-ms(bytes, gbs);
            let cmp = fl-compute-ms(flops, tflops);
            let f = if (cmp > mem) then cmp else mem;
            let m = (fl-float(total-ms) / fl-float(count));
            [name, bytes, fl-2dp(m), fl-2dp(f), fl-2dp((m / f)), if (cmp > mem) then "arithmetic" else "memory"];
        }
        def fl-held-by(r) = if (len(r) >= 6) then r[5] else "memory";
        // a lane row: (name bytes measured-ms floor-ms distance). The measured time is a TOTAL over a
        // count, divided as floats: a lane faster than a millisecond a pass is not a lane measured as zero.
        def fl-row(name, bytes, total-ms, count, gbs) {
            let f = fl-floor-ms(bytes, gbs);
            let m = (fl-float(total-ms) / fl-float(count));
            [name, bytes, fl-2dp(m), fl-2dp(f), fl-2dp((m / f))];
        }
        def fl-name(r) = head(r);
        def fl-bytes(r) = r[1];
        def fl-measured(r) = r[2];
        def fl-floor(r) = r[3];
        def fl-distance(r) = r[4];
        def fl-mb(bytes) = (fl-float((bytes / 1000)) / 1000.0);
        def fl-lane-text(r) = fl-cat([float_to_str(fl-measured(r)), " ms measured, floor ", float_to_str(fl-floor(r)), " ms held by its ", fl-held-by(r), " over ", float_to_str(fl-mb(fl-bytes(r))), " MB, ", float_to_str(fl-distance(r)), "x the floor"]);
        def fl-tone(r) = if (fl-distance(r) < 2.0) then "good" else if (fl-distance(r) < 8.0) then "warn" else "bad";
        def fl-pad(s) = if (str_len(s) >= 8) then s else fl-pad(str_concat(s, " "));
        def fl-lanes(rows) = if ((Comparable) len(rows) == 0) then [] else cons(tg-lane(fl-pad(fl-name(head(rows))), fl-lane-text(head(rows)), fl-tone(head(rows)), (0 - 1)), fl-lanes(tail(rows)));
        // the weather: this door's best reading is what the machine gives when nothing else asks. A reading
        // far under it was taken on a busy machine and every lane below it is taxed — the frame says so.
        def fl-best-path() = ".hearth/floor-lens-best.rows";
        def fl-best-text() = if nothing?(read_file(fl-best-path())) then "" else read_file(fl-best-path());
        def fl-best-seen() {
            let t = trim(fl-best-text());
            if ((Comparable) str_len(t) == 0) then 0.0 else str_to_float(t);
        }
        def fl-best-keep(gbs) {
            let prev = fl-best-seen();
            let best = if (gbs > prev) then gbs else prev;
            let w = if (gbs > prev) then write_file_text(fl-best-path(), float_to_str(gbs)) else 0;
            best;
        }
        // ---- three reads, not one -------------------------------------------------
        // Taken from ivanfioravanti/ds4-metal#5 (BERARD David, merged 2026-09-08), whose
        // harness interleaves every A/B and reports BOTH repeats — "-0.01% / -0.82%" —
        // so a reader can see when a result did not hold still. This lens reported one
        // sample and a best-seen, which cannot tell a dip from a step change: on
        // 2026-09-08 it read 6x low across every lane and the fall was written down as
        // machine-wide with the cause unknown, and on 2026-09-09 it read a new best.
        // Neither reading could say whether the machine had changed or the sample had.
        // Three reads and their spread can (corpus row 1421 onesample).
        def fl-bw-runs(path, r, acc) = if (r <= 0) then acc else fl-bw-runs(path, (r - 1), cons(fl-gbs(fl-measure-bw(path)), acc));
        def fl-lo(xs, m) = if ((Comparable) len(xs) == 0) then m else fl-lo(tail(xs), if (head(xs) < m) then head(xs) else m);
        def fl-hi(xs, m) = if ((Comparable) len(xs) == 0) then m else fl-hi(tail(xs), if (head(xs) > m) then head(xs) else m);
        // the honest reading is the BEST of the reads: the machine's floor is what it can
        // give, and a slower read is something else asking at the same time
        def fl-reads(path, r) {
            let xs = fl-bw-runs(path, r, []);
            [fl-hi(xs, 0.0), fl-lo(xs, 1000000.0), fl-hi(xs, 0.0), len(xs)];
        }
        def fl-read-gbs(rd) = rd[0];
        def fl-read-lo(rd) = rd[1];
        def fl-read-hi(rd) = rd[2];
        def fl-read-n(rd) = rd[3];
        // a spread wider than a tenth means no single number from this run is worth quoting
        def fl-held-still?(rd) = if (fl-read-lo(rd) <= 0.0) then 0 else if ((fl-read-hi(rd) / fl-read-lo(rd)) < 1.10) then 1 else 0;
        def fl-spread-text(rd) {
            if ((Comparable) fl-read-n(rd) == 1) then "one read"
            else str_concat(int_to_str(fl-read-n(rd)), str_concat(" reads ", str_concat(float_to_str(fl-2dp(fl-read-lo(rd))), str_concat("-", str_concat(float_to_str(fl-2dp(fl-read-hi(rd))), if ((Comparable) fl-held-still?(rd) == 1) then "" else ", WIDE — no single number from this run is worth quoting")))));
        }

        def fl-share(gbs, best) = if (best <= 0.0) then 100.0 else fl-2dp(((gbs / best) * 100.0));
        def fl-weather(gbs, best) = if (fl-share(gbs, best) >= 90.0) then "a quiet machine" else str_concat("a busy machine: ", str_concat(float_to_str(fl-share(gbs, best)), "% of the best this door has seen, so every lane below is taxed"));
        def fl-frame(gbs, rows) = fl-frame-rd([gbs, gbs, gbs, 1], rows);
        def fl-frame-rd(rd, rows) {
            let gbs = fl-read-gbs(rd);
            let best = fl-best-keep(gbs);
            tg-frame(cons(tg-lane("FLOOR   ", fl-cat(["this Mac gives ", float_to_str(fl-2dp(gbs)), " GB/s through the handle door against a best of ", float_to_str(fl-2dp(best)), " (", fl-spread-text(rd), "); ", fl-weather(gbs, best)]), if (fl-share(gbs, best) >= 90.0) then "dim" else "warn", (0 - 1)), fl-lanes(rows)));
        }
    }
    0;
}
