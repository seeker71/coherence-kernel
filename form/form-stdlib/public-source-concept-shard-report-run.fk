; public-source-concept-shard-report-run.fk -- read-only live registry witness.
;
; Reads the persisted family cursors and per-source artifacts without rebuilding
; them.  Directory observations are one directory at a time, so neither the
; repository path inventory nor the artifact inventory is retained as one heap.
;
; PROOF LEVEL: FOURTH-ARM ONLY (host filesystem + bounded source SHA-256)
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-fs.fk form-stdlib/file-byte-window.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/form-knowledge-source-search.fk form-stdlib/public-source-concept-index.fk form-stdlib/public-source-concept-shards.fk

(do
    (defn pscishrr-artifact ()
        (fs-path-join (fs-temp-dir) "public-source-concept-registry-v1"))
    (defn pscishrr-max (a b) (if (gt a b) a b))
    (defn pscishrr-name-bytes (names)
        (if (nil? names) 0
            (add (str_len (head names)) (pscishrr-name-bytes (tail names)))))
    ; directory observation = (maximum entries, maximum name bytes, dirs seen)
    (defn pscishrr-observe-children (path names state)
        (if (nil? names) state
            (do
                (let child (fs-path-join path (head names)))
                (let next (if (eq (fs-is-dir? child) 1)
                    (pscishrr-observe-dir child state) state))
                (pscishrr-observe-children path (tail names) next))))
    (defn pscishrr-observe-dir (path state)
        (do
            (let names (fs-list path))
            (let here (list
                (pscishrr-max (nth state 0) (len names))
                (pscishrr-max (nth state 1) (pscishrr-name-bytes names))
                (add (nth state 2) 1)))
            (pscishrr-observe-children path names here)))
    (defn pscishrr-observe-families (root artifact families state)
        (if (nil? families) state
            (do
                (let family (head families))
                (let source-root (fs-path-join root (psci-family-root family)))
                (let source-state (if (eq (fs-is-dir? source-root) 1)
                    (pscishrr-observe-dir source-root state) state))
                (let shard-root (pscish-family-shard-root artifact
                    (psci-family-id family)))
                (let shard-state (if (eq (fs-is-dir? shard-root) 1)
                    (pscishrr-observe-dir shard-root source-state) source-state))
                (pscishrr-observe-families root artifact (tail families)
                    shard-state))))
    (defn pscishrr-print-family-rows (rows)
        (if (nil? rows) 0
            (do
                (let row (head rows))
                (print_str (str_concat "family=" (str_concat (nth row 1)
                (str_concat " denominator=" (str_concat (int_to_str (nth row 2))
                (str_concat " indexed=" (str_concat (int_to_str (nth row 4))
                (str_concat " current=" (str_concat (int_to_str (nth row 5))
                (str_concat " over-budget=" (str_concat (int_to_str (nth row 6))
                (str_concat " stale=" (str_concat (int_to_str (nth row 9))
                (str_concat " missing=" (str_concat (int_to_str (nth row 10))
                (str_concat " invalid=" (str_concat (int_to_str (nth row 11))
                (str_concat " percent=" (str_concat (int_to_str (nth row 12))
                (str_concat " plan-current=" (str_concat (int_to_str (nth row 13))
                    "\n")))))))))))))))))))))
                (pscishrr-print-family-rows (tail rows)))))
    (let root ".")
    (let artifact (pscishrr-artifact))
    (let report (pscish-report-at root artifact))
    (let bounds (pscishrr-observe-families root artifact
        (psci-families) (list 0 0 0)))
    ; A public defn coordinate crosses lookup without a caller path.  The path
    ; below is output telemetry only.
    (let lookup (pscish-lookup-at root artifact "defn-psci-schema"))
    (print_str (str_concat "schema=" (str_concat (nth report 0) "\n")))
    (print_str (str_concat "artifact=" (str_concat artifact "\n")))
    (print_str (str_concat "source-size-budget=" (str_concat
        (int_to_str (pscish-max-source-bytes)) "\n")))
    (print_str (str_concat "directory-entry-bound=" "16384\n"))
    (print_str (str_concat "directory-name-byte-bound=" "1048576\n"))
    (print_str (str_concat "observed-max-directory-entries=" (str_concat
        (int_to_str (nth bounds 0)) "\n")))
    (print_str (str_concat "observed-max-directory-name-bytes=" (str_concat
        (int_to_str (nth bounds 1)) "\n")))
    (print_str (str_concat "observed-directories=" (str_concat
        (int_to_str (nth bounds 2)) "\n")))
    (print_str (str_concat "directory-bounds-held=" (str_concat
        (int_to_str (if (and (lt (nth bounds 0) 16384)
            (lt (nth bounds 1) 1048576)) 1 0)) "\n")))
    (print_str (str_concat "denominator=" (str_concat
        (int_to_str (pscish-report-denominator report)) "\n")))
    (print_str (str_concat "planned=" (str_concat
        (int_to_str (pscish-report-planned report)) "\n")))
    (print_str (str_concat "indexed=" (str_concat
        (int_to_str (pscish-report-indexed report)) "\n")))
    (print_str (str_concat "current=" (str_concat
        (int_to_str (pscish-report-current report)) "\n")))
    (print_str (str_concat "over-budget=" (str_concat
        (int_to_str (pscish-report-over-budget report)) "\n")))
    (print_str (str_concat "failures=" (str_concat
        (int_to_str (pscish-report-failures report)) "\n")))
    (print_str (str_concat "unique-coordinate-ambiguities=" (str_concat
        (int_to_str (pscish-report-ambiguities report)) "\n")))
    (print_str (str_concat "stale=" (str_concat
        (int_to_str (pscish-report-stale report)) "\n")))
    (print_str (str_concat "missing=" (str_concat
        (int_to_str (pscish-report-missing report)) "\n")))
    (print_str (str_concat "invalid=" (str_concat
        (int_to_str (pscish-report-invalid report)) "\n")))
    (print_str (str_concat "source-retrieval-percent=" (str_concat
        (int_to_str (pscish-report-retrieval-percent report)) "\n")))
    (print_str (str_concat "source-retrieval-ready95=" (str_concat
        (int_to_str (pscish-report-threshold95? report)) "\n")))
    (print_str (str_concat "plan-current=" (str_concat
        (int_to_str (pscish-report-plan-current? report)) "\n")))
    (print_str (str_concat "rebuild-needed=" (str_concat
        (int_to_str (pscish-report-rebuild-needed? report)) "\n")))
    (print_str (str_concat "model-executed=" (str_concat
        (int_to_str (pscish-report-model-executed? report)) "\n")))
    (print_str (str_concat "lookup-status=" (str_concat
        (pscish-lookup-status lookup) "\n")))
    (print_str (str_concat "lookup-family=" (str_concat
        (pscish-lookup-family lookup) "\n")))
    (print_str (str_concat "lookup-path=" (str_concat
        (pscish-lookup-path lookup) "\n")))
    (print_str (str_concat "lookup-fresh=" (str_concat
        (int_to_str (pscish-lookup-fresh? lookup)) "\n")))
    (pscishrr-print-family-rows (pscish-report-family-rows report))
    0)
