; living-world-expression-blueprint.fk -- recurrent local form may order a
; participant-offered inventory without receiving grammatical roles.
;
; A material is only an ordered collection of current learned symbol
; candidates.  It contains no subject, predicate, object, task, intent, or
; answer labels.  Generic resonance correspondences may teach how such a
; material becomes an LWTV sequence.  Recurrent alternatives remain separate
; mappings; no score or insertion order chooses between them.
;
; An admitted resonance application is still only a possible expression.
; Zero current applications yields an explicit incomplete plan, one yields a
; locally renderable plan, and many yield explicit ambiguity.  Optional lens
; declaration, alternatives, unknowable remainder, choice, and sender-authored
; timeout remain independent.  Immediate output and timeout condensation are
; separate observations.
;
; Every application, material, learned surface, and optional live declaration
; contributes its active holders to a final offer/ack membrane.  Revocation of
; any upstream evidence stales the plan and utterance.  Rendering is local Form
; string composition and has no host, network, or remote-oracle route.
;
; Honest floor: participants still offer the material and demonstrations.  The
; organ learns structural order, not general grammar, semantics, morphology,
; autonomous enquiry, or an unrestricted generative voice.
;
; witnessed: 2026-08-08 -> 32767 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk

(let LWX-BLUEPRINT-MATERIAL   (bp "LWX-BLUEPRINT-MATERIAL"))
(let LWX-BLUEPRINT-PLAN       (bp "LWX-BLUEPRINT-PLAN"))
(let LWX-BLUEPRINT-READY      (bp "LWX-BLUEPRINT-READY"))
(let LWX-BLUEPRINT-AMBIGUOUS  (bp "LWX-BLUEPRINT-AMBIGUOUS"))
(let LWX-BLUEPRINT-INCOMPLETE (bp "LWX-BLUEPRINT-INCOMPLETE"))
(let LWX-BLUEPRINT-UTTERANCE  (bp "LWX-BLUEPRINT-UTTERANCE"))
(let LWX-BLUEPRINT-ORIGIN     (bp "LWX-BLUEPRINT-ORIGIN"))

; --- role-free participant material -----------------------------------

(defn lwxb-material (items)
    (intern_node LWX-BLUEPRINT-MATERIAL items))
(defn lwxb-material? (cell)
    (lwo-category? cell LWX-BLUEPRINT-MATERIAL))
(defn lwxb-material-items (material) (node_children material))

(defn lwxb-symbol-items-current? (world items)
    (if (eq (len items) 0) 1
        (if (eq (lwsl-integrated-current? world (head items)) 1)
            (lwxb-symbol-items-current? world (tail items)) 0)))

(defn lwxb-material-current? (world material)
    (if (and (eq (lwxb-material? material) 1)
             (and (gt (len (lwxb-material-items material)) 0)
                  (and (eq (lwo-active? world material) 1)
                       (eq (lwxb-symbol-items-current? world
                              (lwxb-material-items material)) 1)))) 1 0))

(defn lwxb-sequence-current? (world sequence)
    (if (and (eq (lwtv-sequence? sequence) 1)
             (and (gt (len (lwtv-sequence-items sequence)) 0)
                  (eq (lwxb-symbol-items-current? world
                        (lwtv-sequence-items sequence)) 1))) 1 0))

; --- admitted resonance applications ----------------------------------

(defn lwxb-application-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwr-application?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwxb-application-compatible? (application)
    (if (and (eq (lwxb-material?
                    (lwr-application-input application)) 1)
             (eq (lwtv-sequence?
                    (lwr-application-output application)) 1)) 1 0))

(defn lwxb-mapping-current? (world mapping-candidate)
    (if (eq (lwr-mapping-candidate? mapping-candidate) 0) 0
        (if (eq (lwo-active? world mapping-candidate) 0) 0
            (if (eq (lwo-emergent-ready? world mapping-candidate) 0) 0
                ; New correspondence or attribution evidence reopens a learned
                ; ordering.  The retained evidence snapshot must remain exact,
                ; and no unseen active correspondence may enter its domain.
                (lwr-mapping-snapshot-current? world
                    (lwo-emergent-shape mapping-candidate))))))

(defn lwxb-application-derivation-current? (world application)
    (if (eq (lwxb-application-compatible? application) 0) 0
        (do
            (let mapping-candidate
                (lwr-application-mapping-candidate application))
            (let input (lwr-application-input application))
            (let output (lwr-application-output application))
            (if (eq (lwxb-mapping-current?
                        world mapping-candidate) 0) 0
                (if (eq (lwxb-material-current? world input) 0) 0
                    (if (eq (lwxb-sequence-current? world output) 0) 0
                        (node_eq output
                            (lwr-apply-mapping
                                (lwr-application-mapping application)
                                input))))))))

(defn lwxb-application-current? (world candidate)
    (if (eq (lwxb-application-candidate? candidate) 0) 0
        (do
            (let application (lwo-emergent-shape candidate))
            (if (eq (lwo-active? world candidate) 0) 0
                (if (eq (lwo-emergent-ready? world candidate) 0) 0
                    (lwxb-application-derivation-current?
                        world application))))))

(defn lwxb-applications-for-material?
    (world items material)
    (if (eq (len items) 0) 1
        (do
            (let candidate (head items))
            (if (and (eq (lwxb-application-current?
                            world candidate) 1)
                     (node_eq
                        (lwr-application-input
                            (lwo-emergent-shape candidate)) material))
                (lwxb-applications-for-material?
                    world (tail items) material) 0))))

; --- zero, one, and many stay distinct --------------------------------

(defn lwxb-ready ()
    (intern_node LWX-BLUEPRINT-READY (empty)))
(defn lwxb-ambiguous ()
    (intern_node LWX-BLUEPRINT-AMBIGUOUS (empty)))
(defn lwxb-incomplete ()
    (intern_node LWX-BLUEPRINT-INCOMPLETE (empty)))
(defn lwxb-ready? (cell) (lwo-category? cell LWX-BLUEPRINT-READY))
(defn lwxb-ambiguous? (cell)
    (lwo-category? cell LWX-BLUEPRINT-AMBIGUOUS))
(defn lwxb-incomplete? (cell)
    (lwo-category? cell LWX-BLUEPRINT-INCOMPLETE))

; children: exact material, offered admitted applications, derived sequence,
; status, exact structural options, optional live declaration, alternatives,
; optional unknown, optional choice, optional timeout, evidence, local path
(defn lwxb-plan-cell
    (material applications sequence status options declaration alternatives
     unknown choice timeout evidence)
    (intern_node LWX-BLUEPRINT-PLAN
        (list material applications sequence status options declaration
              alternatives unknown choice timeout evidence (lwo-local-path))))
(defn lwxb-plan? (cell) (lwo-category? cell LWX-BLUEPRINT-PLAN))
(defn lwxb-plan-material (plan) (nth (node_children plan) 0))
(defn lwxb-plan-applications (plan) (nth (node_children plan) 1))
(defn lwxb-plan-sequence (plan) (nth (node_children plan) 2))
(defn lwxb-plan-status (plan) (nth (node_children plan) 3))
(defn lwxb-plan-options (plan) (nth (node_children plan) 4))
(defn lwxb-plan-declaration (plan) (nth (node_children plan) 5))
(defn lwxb-plan-alternatives (plan) (nth (node_children plan) 6))
(defn lwxb-plan-unknown (plan) (nth (node_children plan) 7))
(defn lwxb-plan-choice (plan) (nth (node_children plan) 8))
(defn lwxb-plan-timeout (plan) (nth (node_children plan) 9))
(defn lwxb-plan-evidence (plan) (nth (node_children plan) 10))
(defn lwxb-plan-path (plan) (nth (node_children plan) 11))

(defn lwxb-optional-declaration-current? (world declaration)
    (if (node_eq declaration (lwo-none)) 1
        (lwlc-declaration-current? world declaration)))
(defn lwxb-optional-unknown-valid? (unknown)
    (if (or (node_eq unknown (lwo-none))
            (eq (lwlc-unknown? unknown) 1)) 1 0))
(defn lwxb-optional-timeout-valid? (timeout)
    (if (or (node_eq timeout (lwo-none))
            (eq (oac-timeout-valid? timeout) 1)) 1 0))

(defn lwxb-plan-options-valid?
    (world material applications declaration alternatives unknown choice timeout)
    (if (and (eq (lwo-category? applications LWO-FIELD) 1)
             (and (eq (lwo-category? alternatives LWO-FIELD) 1)
                  (and (eq (lwxb-optional-declaration-current?
                              world declaration) 1)
                       (and (eq (lwxb-optional-unknown-valid? unknown) 1)
                            (and (eq (lwlc-choice-valid? choice) 1)
                                 (eq (lwxb-optional-timeout-valid?
                                       timeout) 1))))))
        (lwxb-applications-for-material? world
            (lwo-field-items applications) material) 0))

(defn lwxb-plan-for
    (world material applications declaration alternatives unknown choice
     timeout evidence)
    (if (or (eq (lwxb-material-current? world material) 0)
            (eq (lwxb-plan-options-valid? world material applications
                    declaration alternatives unknown choice timeout) 0))
        (lwo-none)
        (do
            (let count (lwo-field-size applications))
            (if (eq count 0)
                (lwxb-plan-cell material applications
                    (lwtv-sequence (empty)) (lwxb-incomplete) applications
                    declaration alternatives unknown choice timeout evidence)
                (if (eq count 1)
                    (do
                        (let application
                            (lwo-emergent-shape
                                (head (lwo-field-items applications))))
                        (lwxb-plan-cell material applications
                            (lwr-application-output application) (lwxb-ready)
                            applications declaration alternatives unknown
                            choice timeout evidence))
                    (lwxb-plan-cell material applications
                        (lwtv-sequence (empty)) (lwxb-ambiguous) applications
                        declaration alternatives unknown choice timeout
                        evidence))))))

(defn lwxb-plan-current? (world plan)
    (if (eq (lwxb-plan? plan) 0) 0
        (node_eq plan
            (lwxb-plan-for world (lwxb-plan-material plan)
                (lwxb-plan-applications plan)
                (lwxb-plan-declaration plan)
                (lwxb-plan-alternatives plan)
                (lwxb-plan-unknown plan) (lwxb-plan-choice plan)
                (lwxb-plan-timeout plan) (lwxb-plan-evidence plan)))))

(defn lwxb-time-observation (plan observed-time)
    (if (or (node_eq (lwxb-plan-timeout plan) (lwo-none))
            (node_eq observed-time (lwo-none))) (lwo-none)
        (oac-timeout-condense (lwxb-plan-timeout plan) observed-time)))

; --- local rendering and a final consent membrane ----------------------

(defn lwxb-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwxb-field-union-items (tail items)
            (lwo-field-add field (head items)))))

(defn lwxb-add-attributions (world cell field)
    (lwxb-field-union-items
        (lwo-field-items (lwo-active-attributions-for world cell)) field))

(defn lwxb-witness-cells (world items field)
    (if (eq (len items) 0) field
        (lwxb-witness-cells world (tail items)
            (lwxb-add-attributions world (head items) field))))

(defn lwxb-plan-witnesses (world plan)
    (do
        (let with-material
            (lwxb-add-attributions world (lwxb-plan-material plan)
                (lwo-empty-field)))
        (let with-applications
            (lwxb-witness-cells world
                (lwo-field-items (lwxb-plan-applications plan))
                with-material))
        (let with-symbols
            (lwxb-witness-cells world
                (lwtv-sequence-items (lwxb-plan-sequence plan))
                with-applications))
        (if (node_eq (lwxb-plan-declaration plan) (lwo-none)) with-symbols
            (lwxb-add-attributions world
                (lwxb-plan-declaration plan) with-symbols))))

; children: exact plan, locally rendered surface, immediate ONE, retained
; alternatives, optional unknown/choice/timeout, witnesses, evidence, path
(defn lwxb-utterance-cell (plan surface witnesses)
    (intern_node LWX-BLUEPRINT-UTTERANCE
        (list plan (intern_trivial_string surface)
              (oac-one (lwxb-plan-sequence plan))
              (lwxb-plan-alternatives plan) (lwxb-plan-unknown plan)
              (lwxb-plan-choice plan) (lwxb-plan-timeout plan) witnesses
              (lwxb-plan-evidence plan) (lwo-local-path))))
(defn lwxb-utterance? (cell)
    (lwo-category? cell LWX-BLUEPRINT-UTTERANCE))
(defn lwxb-utterance-plan (utterance) (nth (node_children utterance) 0))
(defn lwxb-utterance-surface-cell (utterance)
    (nth (node_children utterance) 1))
(defn lwxb-utterance-surface (utterance)
    (node_value (lwxb-utterance-surface-cell utterance)))
(defn lwxb-utterance-immediate (utterance)
    (nth (node_children utterance) 2))
(defn lwxb-utterance-alternatives (utterance)
    (nth (node_children utterance) 3))
(defn lwxb-utterance-unknown (utterance)
    (nth (node_children utterance) 4))
(defn lwxb-utterance-choice (utterance)
    (nth (node_children utterance) 5))
(defn lwxb-utterance-timeout (utterance)
    (nth (node_children utterance) 6))
(defn lwxb-utterance-witnesses (utterance)
    (nth (node_children utterance) 7))
(defn lwxb-utterance-evidence (utterance)
    (nth (node_children utterance) 8))
(defn lwxb-utterance-path (utterance)
    (nth (node_children utterance) 9))

(defn lwxb-emit-from-plan (world plan)
    (if (or (eq (lwxb-plan-current? world plan) 0)
            (eq (lwxb-ready? (lwxb-plan-status plan)) 0)) (lwo-none)
        (lwxb-utterance-cell plan
            (lwtv-render-items
                (lwtv-sequence-items (lwxb-plan-sequence plan)) "")
            (lwxb-plan-witnesses world plan))))

(defn lwxb-utterance-current? (world utterance)
    (if (eq (lwxb-utterance? utterance) 0) 0
        (node_eq utterance
            (lwxb-emit-from-plan world
                (lwxb-utterance-plan utterance)))))

(defn lwxb-origin (utterance)
    (intern_node LWX-BLUEPRINT-ORIGIN
        (list utterance (lwo-local-path))))

(defn lwxb-proposal-from-plan (world plan)
    (do
        (let utterance (lwxb-emit-from-plan world plan))
        (if (node_eq utterance (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwxb-utterance-witnesses utterance))
                (let count (lwo-field-size witnesses))
                (let origin (lwxb-origin utterance))
                (let candidate
                    (lwo-emergent utterance witnesses
                        (intern_trivial_int count)
                        (intern_trivial_int
                            (len (lwtv-sequence-items
                                (lwxb-plan-sequence plan))))
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))

(defn lwxb-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (do
            (let candidate (lwt-proposal-candidate proposal))
            (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
                     (eq (lwxb-utterance-current? world
                            (lwo-emergent-shape candidate)) 1)) 1 0))))

(defn lwxb-integrate (round proposal action)
    (if (eq (lwxb-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))
