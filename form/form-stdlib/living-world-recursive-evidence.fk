; living-world-recursive-evidence.fk -- nested support keeps every exception.
;
; Recursive correspondences share a domain only when source and target
; skeletons agree.  Equal recursive templates are support; alternate templates
; are counterexamples.  Uncertainty keeps counterexample, ambiguity, constant,
; and reference counts separate.  Active, structurally coherent experiences
; addressed to the signature join the same field: confirmations become support,
; corrections become support or counterexample by their observed composition,
; and silence changes uncertainty without inventing a correspondence.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk

(let LWRR-EVIDENCE     (bp "LWRR-EVIDENCE"))
(let LWRR-EVIDENCE-SET (bp "LWRR-EVIDENCE-SET"))
(let LWRR-UNCERTAINTY  (bp "LWRR-UNCERTAINTY"))
(let LWRR-MAPPING      (bp "LWRR-MAPPING"))

(defn lwrr-evidence (correspondence signature attributions observation)
    (intern_node LWRR-EVIDENCE
        (list correspondence signature attributions observation)))
(defn lwrr-evidence-correspondence (evidence)
    (nth (node_children evidence) 0))
(defn lwrr-evidence-attributions (evidence)
    (nth (node_children evidence) 2))
(defn lwrr-evidence-observation (evidence)
    (nth (node_children evidence) 3))

(defn lwrr-evidence-set (supports counterexamples observations)
    (intern_node LWRR-EVIDENCE-SET
        (list supports counterexamples observations)))

(defn lwrr-collect-evidence-items
    (world items seed-signature supports counterexamples observations)
    (if (eq (len items) 0)
        (lwrr-evidence-set supports counterexamples observations)
        (do
            (let cell (head items))
            (if (and (eq (lwr-correspondence? cell) 1)
                     (eq (lwo-active? world cell) 1))
                (lwrr-collect-active-correspondence world (tail items) cell
                    seed-signature supports counterexamples observations)
                (if (and (eq (lwx-experience? cell) 1)
                         (and (eq (lwo-active? world cell) 1)
                              (eq (lwx-experience-valid? cell) 1)))
                    (lwrr-collect-active-experience world (tail items) cell
                        seed-signature supports counterexamples observations)
                    (lwrr-collect-evidence-items world (tail items)
                        seed-signature supports counterexamples observations))))))

(defn lwrr-collect-active-correspondence
    (world rest cell seed-signature supports counterexamples observations)
    (do
        (let signature (lwrr-signature-for cell))
        (if (eq (lwrr-signature-domain-eq? signature seed-signature) 0)
            (lwrr-collect-evidence-items world rest seed-signature
                supports counterexamples observations)
            (do
                (let evidence
                    (lwrr-evidence cell signature
                        (lwo-active-attributions-for world cell) (lwo-none)))
                (if (node_eq signature seed-signature)
                    (lwrr-collect-evidence-items world rest seed-signature
                        (lwo-field-add supports evidence) counterexamples
                        observations)
                    (lwrr-collect-evidence-items world rest seed-signature
                        supports (lwo-field-add counterexamples evidence)
                        observations))))))

(defn lwrr-collect-active-experience
    (world rest experience seed-signature supports counterexamples observations)
    (if (not (node_eq (lwx-experience-signature experience)
                      seed-signature))
        (lwrr-collect-evidence-items world rest seed-signature
            supports counterexamples observations)
        (do
            (let correspondence
                (lwx-experience-correspondence experience))
            (let signature
                (if (node_eq correspondence (lwo-none)) seed-signature
                    (lwrr-signature-for correspondence)))
            (let evidence
                (lwrr-evidence correspondence signature
                    (lwo-active-attributions-for world experience) experience))
            (let next-observations
                (lwo-field-add observations evidence))
            (if (node_eq correspondence (lwo-none))
                (lwrr-collect-evidence-items world rest seed-signature
                    supports counterexamples next-observations)
                (if (node_eq signature seed-signature)
                    (lwrr-collect-evidence-items world rest seed-signature
                        (lwo-field-add supports evidence) counterexamples
                        next-observations)
                    (lwrr-collect-evidence-items world rest seed-signature
                        supports (lwo-field-add counterexamples evidence)
                        next-observations))))))

(defn lwrr-evidence-set-for (world signature)
    (lwrr-collect-evidence-items world
        (lwo-field-items (lwo-world-cells world)) signature
        (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)))
(defn lwrr-evidence-supports (evidence-set)
    (nth (node_children evidence-set) 0))
(defn lwrr-evidence-counterexamples (evidence-set)
    (nth (node_children evidence-set) 1))
(defn lwrr-evidence-observations (evidence-set)
    (nth (node_children evidence-set) 2))

(defn lwrr-attributions-from-evidence-items (items acc)
    (if (eq (len items) 0) acc
        (lwrr-attributions-from-evidence-items (tail items)
            (lwr-field-union-items
                (lwo-field-items
                    (lwrr-evidence-attributions (head items))) acc))))

(defn lwrr-evidence-witnesses (evidence-set)
    (do
        (let support-witnesses
            (lwrr-attributions-from-evidence-items
                (lwo-field-items (lwrr-evidence-supports evidence-set))
                (lwo-empty-field)))
        (let counter-witnesses
            (lwrr-attributions-from-evidence-items
            (lwo-field-items (lwrr-evidence-counterexamples evidence-set))
            support-witnesses))
        (lwrr-attributions-from-evidence-items
            (lwo-field-items (lwrr-evidence-observations evidence-set))
            counter-witnesses)))

; children: counterexamples, ambiguous terms, constants, path references,
;           confirmations, dissents, silences
(defn lwrr-uncertainty
    (counterexamples ambiguous constants references confirmations dissents silences)
    (intern_node LWRR-UNCERTAINTY
        (list (intern_trivial_int counterexamples)
              (intern_trivial_int ambiguous)
              (intern_trivial_int constants)
              (intern_trivial_int references)
              (intern_trivial_int confirmations)
              (intern_trivial_int dissents)
              (intern_trivial_int silences))))
(defn lwrr-uncertainty-counterexamples (uncertainty)
    (node_value (nth (node_children uncertainty) 0)))
(defn lwrr-uncertainty-ambiguous (uncertainty)
    (node_value (nth (node_children uncertainty) 1)))
(defn lwrr-uncertainty-constants (uncertainty)
    (node_value (nth (node_children uncertainty) 2)))
(defn lwrr-uncertainty-references (uncertainty)
    (node_value (nth (node_children uncertainty) 3)))
(defn lwrr-uncertainty-confirmations (uncertainty)
    (node_value (nth (node_children uncertainty) 4)))
(defn lwrr-uncertainty-dissents (uncertainty)
    (node_value (nth (node_children uncertainty) 5)))
(defn lwrr-uncertainty-silences (uncertainty)
    (node_value (nth (node_children uncertainty) 6)))

(defn lwrr-observation-counts (items confirmations dissents silences)
    (if (eq (len items) 0)
        (list confirmations dissents silences)
        (do
            (let ack
                (lwx-experience-ack
                    (lwrr-evidence-observation (head items))))
            (lwrr-observation-counts (tail items)
                (if (eq (oac-one? ack) 1)
                    (add confirmations 1) confirmations)
                (if (eq (oac-zero? ack) 1)
                    (add dissents 1) dissents)
                (if (eq (oac-nothing? ack) 1)
                    (add silences 1) silences)))))

(defn lwrr-uncertainty-for (signature evidence-set)
    (do
        (let template (lwrr-signature-template signature))
        (let counts
            (lwrr-observation-counts
                (lwo-field-items (lwrr-evidence-observations evidence-set))
                0 0 0))
        (lwrr-uncertainty
            (lwo-field-size (lwrr-evidence-counterexamples evidence-set))
            (lwrr-ambiguous-count template)
            (lwrr-constant-count template)
            (lwrr-ref-count template)
            (nth counts 0) (nth counts 1) (nth counts 2))))

(defn lwrr-mapping (signature supports counterexamples uncertainty)
    (intern_node LWRR-MAPPING
        (list signature supports counterexamples uncertainty)))
(defn lwrr-mapping? (cell) (lwo-category? cell LWRR-MAPPING))
(defn lwrr-mapping-signature (mapping) (nth (node_children mapping) 0))
(defn lwrr-mapping-supports (mapping) (nth (node_children mapping) 1))
(defn lwrr-mapping-counterexamples (mapping) (nth (node_children mapping) 2))
(defn lwrr-mapping-uncertainty (mapping) (nth (node_children mapping) 3))

(defn lwrr-mapping-for (signature evidence-set)
    (lwrr-mapping signature
        (lwrr-evidence-supports evidence-set)
        (lwrr-evidence-counterexamples evidence-set)
        (lwrr-uncertainty-for signature evidence-set)))
