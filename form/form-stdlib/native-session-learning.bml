   "refused";
  }
  def nsl-request(home,dir,before) {
   let cfg = nsm-json(nsm-at(nsm-str(before,"parent"),"adapter_config.json"));
   let request = ntr-request(nsm-model(),nsm-str(before,"parent"),dir,nsm-at(dir,"adapter"),1,(1 + nsm-num(before,"replay_rows")),nsm-num(before,"learning_rate"),1,nsm-num(cfg,"num_layers"));
   json-node-object(append(json-object-pairs(request),list(nsm-s("assessment",nsm-at(dir,"assessment.json")))));
  }
  def nsl-one(home,dir) = nsl-one-scoped(home,dir,"");
  def nsl-one-scoped(home,dir,scope) {
   let begin = nsm-event(home,"round-begin",list(nsm-s("id",fs-path-basename(dir)),nsm-s("selected","resume-Adam;one-update-per-observation;rehearse-prior;heldout-excluded")));
   let prepared = if nsm-withdrawn(dir) then "withdrawn" else if (file_size(nsm-at(dir,"before.json")) > 0) then "prepared" else nsl-prepare-scoped(home,dir,scope);
