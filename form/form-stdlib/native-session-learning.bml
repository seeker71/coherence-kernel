// Full next-token LoRA learning from session evidence, with Adam continuation.
// Candidate and serving pointers are distinct. Every assessment compares the
// same examples before/after; held-out rows never enter the gradient.
// preludes: form-stdlib/native-session-evidence.bml form-stdlib/native-lora-worker.bml form-stdlib/native-content-seal.bml form-stdlib/native-vs-rented.fk
section [form.bml] {
 class NativeSessionLearning {
  def nsl-adapter-seal(dir) = json-emit(json-node-array(list(json-node-string(ncs-file(nsm-at(dir,"adapters.safetensors"))),json-node-string(ncs-file(nsm-at(dir,"adapter_config.json"))),json-node-string(file_size(nsm-at(dir,"optimizer.safetensors")) > 0 ? ncs-file(nsm-at(dir,"optimizer.safetensors")) : "historical-no-optimizer"))));
