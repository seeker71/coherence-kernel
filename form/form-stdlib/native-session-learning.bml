  def nsl-without-scores(pairs) = nil?(pairs) ? list() : ((String) json-pair-key(head(pairs)) == "scores") || ((String) json-pair-key(head(pairs)) == "serving_scores") ? nsl-without-scores(tail(pairs)) : cons(head(pairs),nsl-without-scores(tail(pairs)));
