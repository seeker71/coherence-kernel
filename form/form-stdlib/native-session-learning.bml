  }
  def nsl-prepare-ready(home,dir,state,example,valid,replay) = nsl-prepare-ready-scoped(home,dir,state,example,valid,replay,"");
  def nsl-prepare-ready-scoped(home,dir,state,example,valid,replay,scope) {
   let start = host_monotonic_ms();
   let beginning = nsm-event(home,"prepare-begin",list(nsm-s("id",fs-path-basename(dir))));
   let base = nsm-model(); let parent = nsl-candidate(home,base);
   let supplied = append(nse-for-example(home,dir,example,valid),nse-replay(home,valid,nsm-skill(nsm-str(nsm-json(nsm-at(dir,"record.json")),"route"))));
