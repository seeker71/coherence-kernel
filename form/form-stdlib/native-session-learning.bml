  }
  def nsl-health-rows(home,dir,before,after,heldout,basis) = if nil?(before) then list() else nsl-health-row(home,dir,head(before),head(after),heldout,basis,tail(before),tail(after));
  def nsl-health-row(home,dir,before,after,heldout,basis,restBefore,restAfter) {
   let healthy = nsl-row-health(before,after);
