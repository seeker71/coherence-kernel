   let health = nsm-event(home,"organ-health",list(json-node-pair("health",oh-reading("session-learning",dir,"admission",json-node-string("bound training evidence"),json-node-string(why),json-node-int(0),list(oh-need("bound-source-evidence",oh-reference(nsm-at(dir,"result.json")))),list("request-evidence","defer"),oh-reference(nsm-at(dir,"result.json"))))));
