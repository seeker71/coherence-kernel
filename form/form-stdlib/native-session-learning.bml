   nsm-event(home,"inference-completed",list(nsm-s("route","native-lora"),nsm-n("generated_tokens",nth(answer,2)),nsm-s("reason",if ((String) nth(answer,1) == "") then "eos" else nth(answer,1)),nsm-n("wall_ms",(host_monotonic_ms() - start)),nsm-n("retained_buffers",nth(metal_live(),2)),nsm-s("events",nsm-str(request,"events"))));
  }
