  }
  // The newest retained reading whose prompt is this question rides beside it,
  // the way a draft carries the turn before. A question with no reading stays bare.
  def nsl-ask-memory(home,prompt) = nsl-ask-memory-rows(nsm-at(home,"rows"),nsm-dirs(home),prompt,0,"");
  def nsl-ask-memory-rows(root,names,prompt,at,text) = if nil?(names) then text else nsl-ask-memory-one(root,head(names),tail(names),prompt,at,text);
  def nsl-ask-memory-one(root,name,rest,prompt,at,text) {
   let dir = nsm-at(root,name);
   let record = if nsm-withdrawn(dir) then json-node-object(list()) else nsm-json(nsm-at(dir,"record.json"));
   let present = json-object-has?(record,"example");
   let example = if present then oh-get(record,"example") else json-node-object(list());
   let completion = if present then nsm-str(example,"completion") else "";
   let when = if present then nsm-num(record,"observed_at_ms") else 0;
   let match = if present then ((((String) nsm-str(example,"prompt") == prompt) && (str_len(completion) > 0)) && (when >= at)) else 0;
   nsl-ask-memory-rows(root,rest,prompt,if match then when else at,if match then completion else text);
  }
  def nsl-ask-prompt(prompt,reading) = if ((String) reading == "") then prompt else str_concat("The turn before verified this reading:\n",str_concat(reading,str_concat("\n\nThe person asks now:\n",prompt)));
  def nsl-where-question() = "Where are we, and where does the native share want to go?";
  def nsl-where-asked?(prompt) = ((String) prompt == nsl-where-question());
  def nsl-first-line(text) {
   let at = str_find(text,"\n",0);
   if (at < 0) then text else substring(text,0,at);
  }
  def nsl-where-text(home) {
   let stem = str_concat("where-",nsm-id());
   let out = nsm-at(home,str_concat(stem,".where"));
   let err = nsm-at(home,str_concat(stem,".where.err"));
   let pid = host_spawn_at(list("./fkwu","observe/where-we-are-run.bml"),list("/dev/null",out,err));
   let rc = if (pid > 0) then host_wait(pid) else -1;
   if ((Comparable) rc == 0) then nsl-first-line(nsm-text(out)) else "";
  }
  def nsl-ask-organs(home,request,start,text) {
   let result = json-node-object(list(nsm-s("text",text),nsm-s("reason",if ((String) text == "") then "organ-reading-missing" else "organ-reading"),nsm-n("generated_tokens",0),nsm-n("model_admitted",0),nsm-s("model",""),nsm-s("adapter",""),nsm-n("session_learned",0),nsm-s("verification","organ-reading"),nsm-n("wall_ms",(host_monotonic_ms() - start)),nsm-s("events",nsm-str(request,"events")),nsm-s("stream",nsm-str(request,"stream"))));
