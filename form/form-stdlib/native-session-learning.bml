   let released = nlg-close(session);
   values;
  }
  def nsl-grade-rows(model,tk,rows,index) = ntr-grade-rows(model,tk,rows,index);
  // A drain owns a fresh cache directory. It never imports scores from another
  // process or code image; seals bind the unchanged weights and tokenizer.
  def nsl-cache-open(home) {
   let parent = nsm-at(home,"assessment-cache"); let made = host_dir_mkdir(parent);
   let path = nsm-at(parent,nsm-id());
   if ((Comparable) host_dir_mkdir(path) == 1) then path else "";
  }
  def nsl-cache-key(binding,row) = nsm-hash(json-emit-precise(json-node-array(list(json-node-string(binding),row))));
  def nsl-cache-score(record,key,row,index) {
   let score = json-object-get(record,"score");
   let indexed = oh-set(score,"index",json-node-int(index));
   if (((String) nsm-str(record,"key") == key) && (((String) nsm-str(record,"score_sha256") == nsm-hash(json-emit-precise(score))) && nsl-scores-match(list(row),list(indexed),index))) then indexed else json-node-null();
  }
  def nsl-cache-plan(scope,binding,rows,index) = if nil?(rows) then list() else {
   let key = nsl-cache-key(binding,head(rows)); let path = nsm-at(scope,str_concat(key,".json"));
