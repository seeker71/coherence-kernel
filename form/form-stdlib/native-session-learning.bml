// Full next-token LoRA learning from session evidence, with Adam continuation.
// Candidate and serving pointers are distinct. Every assessment compares the
// same examples before/after; held-out rows never enter the gradient.
// preludes: form-stdlib/native-session-evidence.bml form-stdlib/native-lora-worker.bml form-stdlib/native-content-seal.bml form-stdlib/native-vs-rented.fk
section [form.bml] {
 class NativeSessionLearning {
  def nsl-adapter-seal(dir) = json-emit(json-node-array(list(json-node-string(ncs-file(nsm-at(dir,"adapters.safetensors"))),json-node-string(ncs-file(nsm-at(dir,"adapter_config.json"))),json-node-string(if (file_size(nsm-at(dir,"optimizer.safetensors")) > 0) then ncs-file(nsm-at(dir,"optimizer.safetensors")) else "historical-no-optimizer"))));
  def nsl-base-seal(base) = json-emit(json-node-array(list(json-node-string(ncs-file(nsm-at(base,"model.safetensors"))),json-node-string(ncs-file(nsm-at(base,"config.json"))),json-node-string(ncs-file(nsm-at(base,"tokenizer.json"))))));
  def nsl-candidate(home,base) {
   let state = nsm-state(home); let path = nsm-str(state,"candidate");
   if nsm-withdrawn(nsm-str(state,"last_row")) then form_error("session candidate withdrawal awaits completion; continuation withheld") else if ((String) path == "") then nsm-seed() else if (((String) nsm-str(state,"base_seal") == nsl-base-seal(base)) && ((String) nsm-str(state,"candidate_seal") == nsl-adapter-seal(path))) then path else form_error("session candidate bytes or base changed; continuation withheld");
  }
  def nsl-serving(home) {
