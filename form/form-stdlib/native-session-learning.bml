  def nsl-cache-store(plan,scores) = if nil?(plan) then 1 else {
   let saved = if (!nsl-cache-miss(head(plan))) then 1 else { nsm-atomic(nth(head(plan),2),json-node-object(list(nsm-s("key",nth(head(plan),3)),nsm-s("score_sha256",nsm-hash(json-emit-precise(head(scores)))),json-node-pair("score",head(scores))))); 1; };
