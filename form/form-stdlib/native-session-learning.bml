  }
  def nsl-train-new(home,dir,before) {
   let started = nsm-event(home,"training-begin",list(nsm-s("id",fs-path-basename(dir)),nsm-s("events",nsm-at(nsm-at(dir,"adapter"),"training-events.jsonl"))));
   if (!(((String) nsm-str(before,"input_sha256") == nsl-inputs(dir)) && (((String) nsm-str(before,"base_seal") == nsl-base-seal(nsm-model())) && ((String) nsm-str(before,"parent_seal") == nsl-adapter-seal(nsm-str(before,"parent")))))) then nsl-refused(home,dir,"input-parent-or-base-changed-before-training") else nsl-trained(home,dir,before,nlw-run(nsl-request(home,dir,before),dir));
  }
  def nsl-trained(home,dir,before,result) {
   if (!((Comparable) nth(result,1) == 0)) then nsl-refused(home,dir,str_concat("training-",head(result))) else if (file_size(nsm-at(nsm-at(dir,"adapter"),"native-current")) <= 0) then nsl-refused(home,dir,"training-returned-without-generation") else nsl-evaluate(home,dir,before,nag-resolve(nsm-at(dir,"adapter")));
  }
  def nsl-evaluate(home,dir,before,candidate) {
   let start = host_monotonic_ms();
   let beginning = nsm-event(home,"assessment-binding-begin",list(nsm-s("id",fs-path-basename(dir))));
   let assessment = json-array-elements(nsm-json(nsm-at(dir,"assessment.json")));
   let afterPath = nsm-at(nsm-at(dir,"adapter"),"assessment-after.json");
   let beforePath = nsm-at(nsm-at(dir,"adapter"),"assessment-before.json");
   let scores = if (file_size(afterPath) > 0) then json-array-elements(nsm-json(afterPath)) else nsl-grade(nsm-model(),candidate,assessment);
   let baseline = if (file_size(beforePath) > 0) then json-array-elements(nsm-json(beforePath)) else nsl-grade(nsm-model(),nsm-str(before,"parent"),assessment);
   let servingSaved = json-array-elements(json-object-get(before,"serving_scores"));
