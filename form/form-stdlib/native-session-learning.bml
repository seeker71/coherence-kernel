  };
  def nsl-cache-miss(row) = node_eq(head(row),json-node-null());
  def nsl-cache-misses(plan) = if nil?(plan) then 0 else (nsl-cache-miss(head(plan)) + nsl-cache-misses(tail(plan)));
  def nsl-cache-values(plan) = if nil?(plan) then list() else cons(head(head(plan)),nsl-cache-values(tail(plan)));
  def nsl-cache-observations(plan,index) = if nil?(plan) then list() else cons(json-node-object(list(nsm-n("index",index),nsm-s("row_sha256",nsm-hash(json-emit-precise(nth(head(plan),1)))),nsm-s("source",if nsl-cache-miss(head(plan)) then "measured" else "reused"))),nsl-cache-observations(tail(plan),(index + 1)));
