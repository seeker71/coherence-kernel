  def nsl-progress-health(home,dir,before,scores) {
   let baseline = json-array-elements(oh-get(before,"scores"));
   let lossImproved = ((len(scores) >= 2) && (((Comparable) len(baseline) == len(scores)) && (nsm-num(head(scores),"loss") < nsm-num(head(baseline),"loss"))));
   let comparable = ((len(scores) >= 1) && (json-object-has?(head(scores),"native_score") && json-object-has?(head(scores),"rented_score")));
