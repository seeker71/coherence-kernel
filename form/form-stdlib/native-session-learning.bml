  }
  def nsl-train(home,dir,before) {
   let out = nsm-at(dir,"adapter");
   if nlw-running(dir) then "child-still-running" else if (file_size(nsm-at(out,"native-current")) > 0) then nsl-evaluate(home,dir,before,nag-resolve(out)) else if ((String) nlw-status(dir) == "interrupted-without-exit-status") then nsl-resume(home,dir,before) else nsl-train-new(home,dir,before);
  }
  def nsl-resume(home,dir,before) {
