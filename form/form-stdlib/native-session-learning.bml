   nsm-withdrawn(path) || (((String) path == "") || nse-record-overlap(record,valid)) ? list() : list(json-object-get(record,"example"));
  }
  def nsl-prepare(home,dir) = nsl-prepare-scoped(home,dir,"");
  def nsl-prepare-scoped(home,dir,scope) {
   let state = nsm-state(home); let record = nsm-json(nsm-at(dir,"record.json"));
   let example = json-object-get(record,"example"); let validPath = nsm-valid-path(home);
   let valid = nsl-examples(nld-file(validPath)); let replay = nsl-replay(state,valid);
