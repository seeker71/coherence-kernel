  def nsl-cache-fill(model,tk,plan,index) = nil?(plan) ? list() : cons(nsl-cache-miss(head(plan)) ? ntr-grade-row(model,tk,head(plan)[1],index) : head(head(plan)),nsl-cache-fill(model,tk,tail(plan),index + 1));
