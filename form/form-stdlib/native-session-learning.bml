  }
  def nsl-without-scores(pairs) = if nil?(pairs) then list() else if (((String) json-pair-key(head(pairs)) == "scores") || ((String) json-pair-key(head(pairs)) == "serving_scores")) then nsl-without-scores(tail(pairs)) else cons(head(pairs),nsl-without-scores(tail(pairs)));
  def nsl-publish(home,dir,before,candidate,scores,step) {
