  def nsl-loss-evidence(before,after,tolerance) = json-node-object(list(nsm-real("before",before),nsm-real("after",after),nsm-real("tolerance",tolerance),nsm-real("allowed_after",before + tolerance),json-node-pair("strictly_improved",json-node-bool(after < before)),json-node-pair("within_tolerance",json-node-bool(nsl-loss-within(before,after,tolerance)))));
  def nsl-row-health(before,after) = ((String) nsm-str(before,"row_sha256") == nsm-str(after,"row_sha256")) && nsl-loss-within(nsm-num(before,"loss"),nsm-num(after,"loss"),0.000001);
  def nsl-health-ready(rows) = nil?(rows) ? 1 : (node_eq(oh-get(head(rows),"health"),json-node-int(1)) && nsl-health-ready(tail(rows)));
  def nsl-scores-match(rows,scores,index) = nil?(rows) ? nil?(scores) : nil?(scores) ? 0 : (((Comparable) nsm-num(head(scores),"index") == index) && ((nsm-num(head(scores),"supervised_tokens") > 0) && (((String) nsm-str(head(scores),"row_sha256") == nsm-hash(json-emit-precise(head(rows)))) && nsl-scores-match(tail(rows),tail(scores),index + 1))));
  def nsl-inputs(dir) = nsm-hash(nsm-text(nsm-at(dir,"train.jsonl")) ++ nsm-text(nsm-at(dir,"valid.jsonl")) ++ nsm-text(nsm-at(dir,"assessment.json")));
  def nsl-replay(state,valid) {
