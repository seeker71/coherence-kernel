    let saved = nsl-cache-store(plan,scores);
    nsm-event(home,"assessment-reuse",list(nsm-s("scope",scope),nsm-s("binding_sha256",nsm-hash(binding)),nsm-n("rows",len(rows)),nsm-n("reused_rows",(len(rows) - missing)),nsm-n("measured_rows",missing),nsm-n("model_admissions",if (missing > 0) then 1 else 0),nsm-n("cache_retained",saved),json-node-pair("row_observations",json-node-array(nsl-cache-observations(plan,0))),nsm-n("wall_ms",(host_monotonic_ms() - started))));
    scores;
   };
  };
  def nsl-cache-measure(base,adapter,plan) {
   let session = nlg-open(base,adapter);
   let scores = nsl-cache-fill(head(session),nth(session,1),plan,0);
   if (!nlg-close(session)) then form_error("native assessment cache model release incomplete") else scores;
  }
  def nsl-loss-within(before,after,tolerance) = (after <= (before + tolerance));
  // Arithmetic evidence only. The caller supplies bound numeric observations
  // and owns its decision rule, source identity and broader quality assessment.
  def nsl-loss-evidence(before,after,tolerance) = json-node-object(list(nsm-real("before",before),nsm-real("after",after),nsm-real("tolerance",tolerance),nsm-real("allowed_after",(before + tolerance)),json-node-pair("strictly_improved",json-node-bool((after < before))),json-node-pair("within_tolerance",json-node-bool(nsl-loss-within(before,after,tolerance)))));
  def nsl-row-health(before,after) = (((String) nsm-str(before,"row_sha256") == nsm-str(after,"row_sha256")) && nsl-loss-within(nsm-num(before,"loss"),nsm-num(after,"loss"),0.000001));
  def nsl-health-ready(rows) = if nil?(rows) then 1 else (node_eq(oh-get(head(rows),"health"),json-node-int(1)) && nsl-health-ready(tail(rows)));
  def nsl-scores-match(rows,scores,index) = if nil?(rows) then nil?(scores) else if nil?(scores) then 0 else (((Comparable) nsm-num(head(scores),"index") == index) && ((nsm-num(head(scores),"supervised_tokens") > 0) && (((String) nsm-str(head(scores),"row_sha256") == nsm-hash(json-emit-precise(head(rows)))) && nsl-scores-match(tail(rows),tail(scores),(index + 1)))));
  def nsl-inputs(dir) = nsm-hash(str_concat(nsm-text(nsm-at(dir,"train.jsonl")),str_concat(nsm-text(nsm-at(dir,"valid.jsonl")),nsm-text(nsm-at(dir,"assessment.json")))));
  def nsl-replay(state,valid) {
   let path = nsm-str(state,"replay");
   let record = nsm-json(nsm-at(path,"record.json"));
   if (nsm-withdrawn(path) || (((String) path == "") || nse-record-overlap(record,valid))) then list() else list(json-object-get(record,"example"));
  }
  def nsl-prepare(home,dir) = nsl-prepare-scoped(home,dir,"");
  def nsl-prepare-scoped(home,dir,scope) {
   let state = nsm-state(home); let record = nsm-json(nsm-at(dir,"record.json"));
   let example = json-object-get(record,"example"); let validPath = nsm-valid-path(home);
   let valid = nsl-examples(nld-file(validPath)); let replay = nsl-replay(state,valid);
   if (nil?(valid) || nse-record-overlap(record,valid)) then nsl-refused(home,dir,"validation-absent-or-training-overlap") else nsl-prepare-ready-scoped(home,dir,state,example,valid,replay,scope);
  }
  def nsl-prepare-ready(home,dir,state,example,valid,replay) = nsl-prepare-ready-scoped(home,dir,state,example,valid,replay,"");
  def nsl-prepare-ready-scoped(home,dir,state,example,valid,replay,scope) {
   let start = host_monotonic_ms();
   let beginning = nsm-event(home,"prepare-begin",list(nsm-s("id",fs-path-basename(dir))));
   let base = nsm-model(); let parent = nsl-candidate(home,base);
   let supplied = append(nse-for-example(home,dir,example,valid),nse-replay(home,valid,nsm-skill(nsm-str(nsm-json(nsm-at(dir,"record.json")),"route"))));
   let prior = nsl-distinct(append(replay,supplied),cons(example,valid),list());
   let delivered = nsm-event(home,"training-evidence-consumed",list(nsm-s("id",fs-path-basename(dir)),nsm-n("supplied_rows",len(supplied)),nsm-n("replay_rows",len(prior)),nsm-s("source",nsm-at(dir,"training-evidence.json")),nsm-s("open_needs",nsm-at(home,"evidence-current.json")),nsm-s("selected","revalidate-references;exclude-assessment;train")));
   let train = nag-write(nsm-at(dir,"train.jsonl"),nsl-lines(cons(example,prior)));
   let held = nag-write(nsm-at(dir,"valid.jsonl"),nsl-lines(valid));
   let assessment = cons(example,append(valid,prior));
   let rows = nsm-write(nsm-at(dir,"assessment.json"),json-node-array(assessment));
   let baseline = list();
   let serving = nsm-str(state,"serving");
   let servingBaseline = if (((String) serving == "") || ((String) serving == parent)) then baseline else nsl-grade-cached(home,base,serving,assessment,scope);
   let before = json-node-object(list(nsm-s("parent",parent),nsm-s("parent_seal",nsl-adapter-seal(parent)),nsm-s("base_seal",nsl-base-seal(base)),nsm-s("validation_sha256",nsm-hash(nsl-lines(valid))),nsm-s("input_sha256",nsl-inputs(dir)),nsm-n("heldout_rows",len(valid)),nsm-n("replay_rows",len(prior)),nsm-real("learning_rate",nsm-rate(home)),json-node-pair("state",state),json-node-pair("scores",json-node-array(baseline)),json-node-pair("serving_scores",json-node-array(servingBaseline))));
   let saved = nsm-atomic(nsm-at(dir,"before.json"),before);
   let measured = nsm-event(home,"prepare-complete",list(nsm-s("id",fs-path-basename(dir)),nsm-n("wall_ms",(host_monotonic_ms() - start)),nsm-n("rows",len(assessment))));
   "prepared";
  }
  def nsl-distinct(rows,exclude,held) = if nil?(rows) then held else if nse-overlap(head(rows),append(exclude,held)) then nsl-distinct(tail(rows),exclude,held) else nsl-distinct(tail(rows),exclude,append(held,list(head(rows))));
  def nsl-refused(home,dir,why) {
   let out = nsm-at(dir,"adapter");
   let generation = if (file_size(nsm-at(out,"native-current")) > 0) then nag-resolve(out) else "";
   let started = fs-exists?(nsm-at(dir,"train-supervisor.log"));
   let result = json-node-object(list(nsm-s("status","refused"),nsm-s("reason",why),json-node-pair("lora_rounds",if (!((String) generation == "")) then json-node-int(1) else if started then json-node-null() else json-node-int(0)),nsm-s("generation",generation),nsm-s("training_events",nsm-at(out,"training-events.jsonl")),nsm-s("round_count_basis",if (!((String) generation == "")) then "completed-generation;assessment-refused" else if started then "interrupted-or-failed;inspect-trainer-evidence" else "training-not-started")));
   let saved = nsm-atomic(nsm-at(dir,"result.json"),result);
