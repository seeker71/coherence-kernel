   let indexed = oh-set(score,"index",json-node-int(index));
   ((String) nsm-str(record,"key") == key) && (((String) nsm-str(record,"score_sha256") == nsm-hash(json-emit-precise(score))) && nsl-scores-match(list(row),list(indexed),index)) ? indexed : json-node-null();
  }
  def nsl-cache-plan(scope,binding,rows,index) = nil?(rows) ? list() : {
