   let reading = oh-reading("session-learning",dir,"execution-continuity",json-node-string("completed-worker-exit"),json-node-string(nlw-status(dir)),json-node-int(0),list(need),list("resume-bound-inputs","defer"),oh-reference(nsm-at(nsm-at(dir,"adapter"),"training-events.jsonl")));
