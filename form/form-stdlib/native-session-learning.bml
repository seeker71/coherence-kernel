  def nsl-examples(lines) = nil?(lines) ? list() : cons(parse-json("session-example",head(head(lines))),nsl-examples(tail(lines)));
  def nsl-line(row) = json-emit-precise(row) ++ "\n";
  def nsl-lines(rows) = nil?(rows) ? "" : nsl-line(head(rows)) ++ nsl-lines(tail(rows));
