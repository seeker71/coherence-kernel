    nsm-event(home,"assessment-reuse",list(nsm-s("scope",scope),nsm-s("binding_sha256",nsm-hash(binding)),nsm-n("rows",len(rows)),nsm-n("reused_rows",len(rows) - missing),nsm-n("measured_rows",missing),nsm-n("model_admissions",missing > 0 ? 1 : 0),nsm-n("cache_retained",saved),json-node-pair("row_observations",json-node-array(nsl-cache-observations(plan,0))),nsm-n("wall_ms",host_monotonic_ms() - started)));
    scores;
   };
  };
  def nsl-cache-measure(base,adapter,plan) {
   let session = nlg-open(base,adapter);
   let scores = nsl-cache-fill(head(session),session[1],plan,0);
