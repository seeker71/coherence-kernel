  };
  def nsl-grade-cached(home,base,adapter,rows,scope) = if ((String) scope == "") then nsl-grade(base,adapter,rows) else {
   let started = host_monotonic_ms();
   let binding = json-emit(json-node-array(list(json-node-string(nsl-base-seal(base)),json-node-string(nsl-adapter-seal(adapter)))));
   let plan = nsl-cache-plan(scope,binding,rows,0); let missing = nsl-cache-misses(plan);
