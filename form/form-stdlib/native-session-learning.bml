   let measured = nsm-event(home,"assessment-binding-complete",list(nsm-s("id",fs-path-basename(dir)),nsm-n("wall_ms",(host_monotonic_ms() - start)),nsm-n("rows",len(scores))));
   let measured = (nsl-scores-match(assessment,baseline,0) && (nsl-scores-match(assessment,scores,0) && nsl-scores-match(assessment,servingScores,0)));
