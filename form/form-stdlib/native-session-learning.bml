  }
  def nsl-health-rows(home,dir,before,after,heldout,basis) = nil?(before) ? list() : nsl-health-row(home,dir,head(before),head(after),heldout,basis,tail(before),tail(after));
  def nsl-health-row(home,dir,before,after,heldout,basis,restBefore,restAfter) {
