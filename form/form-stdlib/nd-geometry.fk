; nd-geometry.fk — n-D Euclidean maps in native Form.
;
; Fold, project, transform, and bridge-strings. Also: 2D perpendicular,
; 3D cross, composed maps, 2D⊗2D→4D, and projective homog. Integers stay
; exact. Not string theory. Not a catalogue of every known manifold.
;
; witnessed: 2026-09-10 -> nd-geometry-band 8191
; preludes: form-stdlib/core.fk

(do
    (defn nd-dim (v) (len v))
    (defn nd-same? (a b)
        (if (and (not (nothing? a)) (not (nothing? b))) (eq (len a) (len b)) 0))
    (defn nd-add (a b)
        (if (eq (nd-same? a b) 0) (nothing)
            (if (eq (len a) 0) (list)
                (cons (add (head a) (head b)) (nd-add (tail a) (tail b))))))
    (defn nd-sub (a b)
        (if (eq (nd-same? a b) 0) (nothing)
            (if (eq (len a) 0) (list)
                (cons (sub (head a) (head b)) (nd-sub (tail a) (tail b))))))
    (defn nd-scale (v s)
        (if (nothing? v) (nothing)
            (if (eq (len v) 0) (list)
                (cons (mul (head v) s) (nd-scale (tail v) s)))))
    (defn nd-div (v k)
        (if (or (nothing? v) (eq k 0)) (nothing)
            (if (eq (len v) 0) (list)
                (if (eq (mod (head v) k) 0)
                    (cons (div (head v) k) (nd-div (tail v) k))
                    (nothing)))))
    (defn nd-dot (a b)
        (if (eq (nd-same? a b) 0) (nothing)
            (if (eq (len a) 0) 0
                (add (mul (head a) (head b)) (nd-dot (tail a) (tail b))))))
    (defn nd-len2 (v) (nd-dot v v))

    ; Project u onto v: ((u·v) / (v·v)) v, only when (v·v) divides (u·v).
    (defn nd-project (u v)
        (do
            (let num (nd-dot u v))
            (let den (nd-len2 v))
            (if (or (nothing? num) (or (nothing? den) (eq den 0))) (nothing)
                (if (eq (mod num den) 0) (nd-scale v (div num den)) (nothing)))))

    ; Orthographic drop of the last axis: n-D -> (n-1)-D.
    (defn nd-project-axis (v)
        (if (or (nothing? v) (lt (len v) 2)) (nothing)
            (nd-project-axis-acc v (list))))
    (defn nd-project-axis-acc (v acc)
        (if (eq (len v) 1) acc
            (nd-project-axis-acc (tail v) (append acc (list (head v))))))

    ; Fold last two coordinates into one sum: n-D -> (n-1)-D.
    (defn nd-fold-last (v)
        (if (or (nothing? v) (lt (len v) 2)) (nothing)
            (nd-fold-last-acc v (list))))
    (defn nd-fold-last-acc (v acc)
        (if (eq (len v) 2) (append acc (list (add (head v) (nth v 1))))
            (nd-fold-last-acc (tail v) (append acc (list (head v))))))

    (defn nd-row-dot (row v)
        (if (eq (nd-same? row v) 0) (nothing) (nd-dot row v)))
    (defn nd-transform (m v)
        (if (or (nothing? m) (nothing? v)) (nothing)
            (if (eq (len m) 0) (list)
                (do
                    (let x (nd-row-dot (head m) v))
                    (let rest (nd-transform (tail m) v))
                    (if (or (nothing? x) (nothing? rest)) (nothing)
                        (cons x rest))))))

    ; Bridge-string: k equal steps from a to b when (b-a) divides by k.
    (defn nd-bridge-walk (p d i k acc)
        (if (gt i k) acc
            (nd-bridge-walk (nd-add p d) d (add i 1) k (append acc (list p)))))
    (defn nd-bridge (a b k)
        (if (or (lt k 1) (eq (nd-same? a b) 0)) (nothing)
            (do
                (let d (nd-div (nd-sub b a) k))
                (if (nothing? d) (nothing)
                    (nd-bridge-walk a d 0 k (list))))))

    (defn nd-perp2 (v)
        (if (or (nothing? v) (not (eq (len v) 2))) (nothing)
            (list (sub 0 (nth v 1)) (nth v 0))))
    (defn nd-cross3 (a b)
        (if (or (eq (nd-same? a b) 0) (not (eq (len a) 3))) (nothing)
            (list (sub (mul (nth a 1) (nth b 2)) (mul (nth a 2) (nth b 1)))
                  (sub (mul (nth a 2) (nth b 0)) (mul (nth a 0) (nth b 2)))
                  (sub (mul (nth a 0) (nth b 1)) (mul (nth a 1) (nth b 0))))))
    (defn nd-col (m j)
        (if (eq (len m) 0) (list)
            (cons (nth (head m) j) (nd-col (tail m) j))))
    (defn nd-ncols (m) (if (eq (len m) 0) 0 (len (head m))))
    (defn nd-compose-row (row b j acc)
        (if (eq j (nd-ncols b)) acc
            (nd-compose-row row b (add j 1) (append acc (list (nd-dot row (nd-col b j)))))))
    (defn nd-compose (a b)
        (if (or (nothing? a) (nothing? b)) (nothing)
            (if (eq (len a) 0) (list)
                (cons (nd-compose-row (head a) b 0 (list)) (nd-compose (tail a) b)))))
    (defn nd-tensor2 (a b)
        (if (or (not (eq (len a) 2)) (not (eq (len b) 2))) (nothing)
            (list (mul (nth a 0) (nth b 0)) (mul (nth a 0) (nth b 1))
                  (mul (nth a 1) (nth b 0)) (mul (nth a 1) (nth b 1)))))
    (defn nd-homog (v) (if (nothing? v) (nothing) (append v (list 1))))
    (defn nd-from-homog (v)
        (if (or (nothing? v) (lt (len v) 2)) (nothing)
            (do
                (let w (nth v (sub (len v) 1)))
                (if (eq w 0) (nothing)
                    (nd-div (nd-project-axis v) w)))))
    (defn nd-affine (m v t) (nd-add (nd-transform m v) t))
    (defn nd-reflect-last (v)
        (if (or (nothing? v) (eq (len v) 0)) (nothing)
            (if (eq (len v) 1) (list (sub 0 (head v)))
                (cons (head v) (nd-reflect-last (tail v))))))
    0)
