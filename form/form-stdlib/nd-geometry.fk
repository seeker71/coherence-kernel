; nd-geometry.fk — n-D Euclidean maps in native Form.
;
; Fold, project, transform, and bridge-strings. Integer coordinates so
; 4D→3D, axis projection, and a 90° turn stay exact. A bridge is a
; piecewise-linear string of points that divides (b-a) evenly, or nothing.
; Not string theory. Not a catalogue of every known manifold.
;
; witnessed: 2026-09-10 -> nd-geometry-band 255
; preludes: form-stdlib/core.fk

(do
    (defn nd-dim (v) (len v))
    (defn nd-same? (a b)
        (if (and (not (nothing? a)) (not (nothing? b))) (eq (len a) (len b)) 0))
    (defn nd-add (a b)
        (if (eq (nd-same? a b) 0) (nothing)
            (if (eq (len a) 0) (list)
                (cons (add (head a) (head b)) (nd-add (tail a) (tail b))))))
    (defn nd-sub (a b)
        (if (eq (nd-same? a b) 0) (nothing)
            (if (eq (len a) 0) (list)
                (cons (sub (head a) (head b)) (nd-sub (tail a) (tail b))))))
    (defn nd-scale (v s)
        (if (nothing? v) (nothing)
            (if (eq (len v) 0) (list)
                (cons (mul (head v) s) (nd-scale (tail v) s)))))
    (defn nd-div (v k)
        (if (or (nothing? v) (eq k 0)) (nothing)
            (if (eq (len v) 0) (list)
                (if (eq (mod (head v) k) 0)
                    (cons (div (head v) k) (nd-div (tail v) k))
                    (nothing)))))
    (defn nd-dot (a b)
        (if (eq (nd-same? a b) 0) (nothing)
            (if (eq (len a) 0) 0
                (add (mul (head a) (head b)) (nd-dot (tail a) (tail b))))))
    (defn nd-len2 (v) (nd-dot v v))

    ; Project u onto v: ((u·v) / (v·v)) v, only when (v·v) divides (u·v).
    (defn nd-project (u v)
        (do
            (let num (nd-dot u v))
            (let den (nd-len2 v))
            (if (or (nothing? num) (or (nothing? den) (eq den 0))) (nothing)
                (if (eq (mod num den) 0) (nd-scale v (div num den)) (nothing)))))

    ; Orthographic drop of the last axis: n-D -> (n-1)-D.
    (defn nd-project-axis (v)
        (if (or (nothing? v) (lt (len v) 2)) (nothing)
            (nd-project-axis-acc v (list))))
    (defn nd-project-axis-acc (v acc)
        (if (eq (len v) 1) acc
            (nd-project-axis-acc (tail v) (append acc (list (head v))))))

    ; Fold last two coordinates into one sum: n-D -> (n-1)-D.
    (defn nd-fold-last (v)
        (if (or (nothing? v) (lt (len v) 2)) (nothing)
            (nd-fold-last-acc v (list))))
    (defn nd-fold-last-acc (v acc)
        (if (eq (len v) 2) (append acc (list (add (head v) (nth v 1))))
            (nd-fold-last-acc (tail v) (append acc (list (head v))))))

    (defn nd-row-dot (row v)
        (if (eq (nd-same? row v) 0) (nothing) (nd-dot row v)))
    (defn nd-transform (m v)
        (if (or (nothing? m) (nothing? v)) (nothing)
            (if (eq (len m) 0) (list)
                (do
                    (let x (nd-row-dot (head m) v))
                    (let rest (nd-transform (tail m) v))
                    (if (or (nothing? x) (nothing? rest)) (nothing)
                        (cons x rest))))))

    ; Bridge-string: k equal steps from a to b when (b-a) divides by k.
    (defn nd-bridge-walk (p d i k acc)
        (if (gt i k) acc
            (nd-bridge-walk (nd-add p d) d (add i 1) k (append acc (list p)))))
    (defn nd-bridge (a b k)
        (if (or (lt k 1) (eq (nd-same? a b) 0)) (nothing)
            (do
                (let d (nd-div (nd-sub b a) k))
                (if (nothing? d) (nothing)
                    (nd-bridge-walk a d 0 k (list))))))
    0)
