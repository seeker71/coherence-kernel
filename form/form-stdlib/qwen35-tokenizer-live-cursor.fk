// qwen35-tokenizer-live-cursor.fk -- bounded exact BPE as a live token cursor.
//
// The ordinary Qwen tokenizer first materializes every candidate merge and then
// every prompt id.  This organ reads the seal-keyed qtf2 row artifacts through
// their BMF file cursors, reuses touched rows and exact pieces within the
// admitted immutable model epoch, and offers one token at a time. A consumer
// can therefore advance model state while the
// prompt is still being transmuted instead of waiting for a tokenizer pre-step.
//
// Token ids 0 and 1 are ordinary present values.  End-of-stream and refusal
// carry present=0 and value=nothing, so neither can be confused with a token.
// Missing/stale qtf2 artifacts are explicit outcomes; they never become an
// empty prompt and never authorize an implicit artifact build.
//
// preludes: form-stdlib/bml/qwen35-live-piece.bml native/metal/qwen35-crystal.fk
// Proven by: form-stdlib/tests/qwen35-tokenizer-live-cursor-band.fk
section [form.bml] {
    // A segment is either already-known ids or text still to transmute.
    def qtlc-id-segment(ids) = list("ids", ids);
    def qtlc-text-segment(text) = list("text", text);
    def qtlc-segment-kind(s) = nth(s, 0);
    def qtlc-segment-value(s) = nth(s, 1);
    // cursor = status index segments text text-pos pending token-count
    //          pieces merges probes reason released.
    def qtlc-cursor(status, index, segments, text, text-pos, pending, token-count, pieces, merges, probes, reason, released) = list("qtlc-cursor", status, index, segments, text, text-pos, pending, token-count, pieces, merges, probes, reason, released);
    def qtlc-status(c) = nth(c, 1);
    def qtlc-index(c) = nth(c, 2);
    def qtlc-segments(c) = nth(c, 3);
    def qtlc-text(c) = nth(c, 4);
    def qtlc-text-pos(c) = nth(c, 5);
    def qtlc-pending(c) = nth(c, 6);
    def qtlc-token-count(c) = nth(c, 7);
    def qtlc-pieces(c) = nth(c, 8);
    def qtlc-merges(c) = nth(c, 9);
    def qtlc-probes(c) = nth(c, 10);
    def qtlc-reason(c) = nth(c, 11);
    def qtlc-released?(c) = nth(c, 12);
    def qtlc-with(c, status, segments, text, text-pos, pending, token-count, pieces, merges, probes, reason, released) = qtlc-cursor(status, qtlc-index(c), segments, text, text-pos, pending, token-count, pieces, merges, probes, reason, released);
    def qtlc-open-index(index, segments) = qtlc-open-owned-index(qtlc-piece-index(index), segments);
    def qtlc-open-owned-index(index, segments) = (String) nth(index, 0) == "current" ? qtlc-cursor("open", index, segments, "", 0, empty(), 0, 0, 0, 0, "streaming", 0) : qtlc-cursor(nth(index, 0), index, empty(), "", 0, empty(), 0, 0, 0, 0, nth(index, 1), 1);
    def qtlc-open(path, live-seal, segments) = qtlc-open-index(qtf2r-open(path, live-seal), segments);
    // result = status value present next-cursor.  Presence, not numeric truth,
    // distinguishes token 0/1 from completion.
    def qtlc-next-result(status, value, present, cursor) = list("qtlc-next", status, value, present, cursor);
    def qtlc-next-status(r) = nth(r, 1);
    def qtlc-next-value(r) = nth(r, 2);
    def qtlc-next-present?(r) = nth(r, 3);
    def qtlc-next-cursor(r) = nth(r, 4);
    def qtlc-token-result(c, token, pending) = {
        let next = qtlc-with(c, "open", qtlc-segments(c), qtlc-text(c), qtlc-text-pos(c), pending, qtlc-token-count(c) + 1, qtlc-pieces(c), qtlc-merges(c), qtlc-probes(c), "streaming", 0);
        qtlc-next-result("token", token, 1, next);
    };
    def qtlc-refuse-result(c, status, reason, probes, merges, pieces) = {
        let stopped = qtlc-with(c, status, empty(), "", 0, empty(), qtlc-token-count(c), pieces, merges, probes, reason, 1);
        qtlc-next-result(status, nothing(), 0, stopped);
    };
    def qtlc-next(c) = !((String) qtlc-status(c) == "open") ? qtlc-next-result(qtlc-status(c), nothing(), 0, c) : !nil?(qtlc-pending(c)) ? qtlc-token-result(c, head(qtlc-pending(c)), tail(qtlc-pending(c))) : qtlc-text-pos(c) < str_len(qtlc-text(c)) ? {
        let end = q35-next-piece(qtlc-text(c), str_len(qtlc-text(c)), qtlc-text-pos(c));
        let piece = qtlc-piece(qtlc-index(c), substring(qtlc-text(c), qtlc-text-pos(c), end));
        let merges = qtlc-merges(c) + nth(piece, 2);
        let probes = qtlc-probes(c) + nth(piece, 3);
        let pieces = qtlc-pieces(c) + 1;
        !((String) head(piece) == "ok") ? qtlc-refuse-result(c, head(piece), nth(piece, 4), probes, merges, pieces) : qtlc-next(qtlc-with(c, "open", qtlc-segments(c), qtlc-text(c), end, nth(piece, 1), qtlc-token-count(c), pieces, merges, probes, "streaming", 0));
    } : nil?(qtlc-segments(c)) ? {
        let done = qtlc-with(c, "done", empty(), "", 0, empty(), qtlc-token-count(c), qtlc-pieces(c), qtlc-merges(c), qtlc-probes(c), "complete", 1);
        qtlc-next-result("done", nothing(), 0, done);
    } : {
        let seg = head(qtlc-segments(c));
        let rest = tail(qtlc-segments(c));
        (String) qtlc-segment-kind(seg) == "ids" ? qtlc-next(qtlc-with(c, "open", rest, "", 0, qtlc-segment-value(seg), qtlc-token-count(c), qtlc-pieces(c), qtlc-merges(c), qtlc-probes(c), "streaming", 0)) : (String) qtlc-segment-kind(seg) == "text" ? qtlc-next(qtlc-with(c, "open", rest, qtlc-segment-value(seg), 0, empty(), qtlc-token-count(c), qtlc-pieces(c), qtlc-merges(c), qtlc-probes(c), "streaming", 0)) : qtlc-refuse-result(c, "failure", "unknown-segment", qtlc-probes(c), qtlc-merges(c), qtlc-pieces(c));
    };
    def qtlc-drain-loop(c, acc) = {
        let one = qtlc-next(c);
        (Comparable) qtlc-next-present?(one) == 1 ? qtlc-drain-loop(qtlc-next-cursor(one), cons(qtlc-next-value(one), acc)) : list(qtlc-next-status(one), reverse(acc), qtlc-next-cursor(one));
    };
    def qtlc-drain(c) = qtlc-drain-loop(c, empty());
    // Count/release without retaining an ID list. Session admission can prove
    // an exact context bound, reopen the same immutable cursor, and then stream
    // directly into prefill. Result = status final-cursor.
    def qtlc-count(c) = {
        let one = qtlc-next(c);
        (Comparable) qtlc-next-present?(one) == 1 ? qtlc-count(qtlc-next-cursor(one)) : list(qtlc-next-status(one), qtlc-next-cursor(one));
    };
    // Exact crystal-backed ChatML segments.  The prompt alone remains live;
    // already-proven constant scaffold ids are offered directly.
    def qtlc-chat-segments(prompt, x) = list(qtlc-id-segment(list(nth(x, 1))), qtlc-id-segment(nth(x, 5)), qtlc-text-segment(prompt), qtlc-id-segment(list(nth(x, 2))), qtlc-id-segment(nth(x, 6)), qtlc-id-segment(list(nth(x, 1))), qtlc-id-segment(nth(x, 7)), qtlc-id-segment(list(nth(x, 3))), qtlc-id-segment(nth(x, 8)), qtlc-id-segment(list(nth(x, 4))), qtlc-id-segment(nth(x, 8)));
    def qtlc-full-chat-segments(prompt, system-text, x) = tkz-cat(list(qtlc-id-segment(list(nth(x, 1))), qtlc-text-segment("system\n"), qtlc-text-segment(system-text), qtlc-id-segment(list(nth(x, 2))), qtlc-id-segment(nth(x, 6))), qtlc-chat-segments(prompt, x));
    // Conservative context admission without tokenizing first: GPT-2 byte BPE
    // emits no more ids than input bytes, while known-id segments are exact.
    def qtlc-segments-upper-bound(segments, acc) = nil?(segments) ? acc : {
        let seg = head(segments);
        qtlc-segments-upper-bound(tail(segments), acc + ((String) qtlc-segment-kind(seg) == "ids" ? len(qtlc-segment-value(seg)) : str_len(qtlc-segment-value(seg))));
    };
    0;
}
