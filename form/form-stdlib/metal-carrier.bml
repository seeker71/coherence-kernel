// fkwu admits the dynamic Metal carrier from beside itself on the first Metal
// call. A fresh worktree holds the carrier's committed Objective-C source and no
// artifact, so every handle reads 0 there. Form owns that admission: it reads the
// artifact against its source, builds it through the host door when absent or
// older, and places it on a fresh inode so a process holding the old one keeps
// its own mapping.
// preludes: form-stdlib/core.fk form-stdlib/form-fs.fk
section [form.bml] {
 class MetalCarrier {
  def mca-source() = "form/native/metal/fk-metal-carrier.m";
  def mca-artifact() = "form/native/metal/fk-metal-carrier.dylib";
  def mca-state() = if le(file_size(mca-artifact()),0) then "absent" else if lt(file_mtime(mca-artifact()),file_mtime(mca-source())) then "older-than-source" else "standing";
  def mca-host?() = fs-is-dir?("/System/Library/Frameworks/Metal.framework");
  // Answers list(state, exit, stderr path): standing | admitted | refused | no-metal-host.
  def mca-admit(log,err) = if str_eq(mca-state(),"standing") then list("standing",0,"") else if not(mca-host?()) then list("no-metal-host",-1,"") else mca-build(log,err);
  def mca-build(log,err) {
   let stage = str_concat(mca-artifact(),str_concat(".building-",int_to_str(host_pid())));
   let pid = host_spawn_at(list("/usr/bin/cc","-O2","-dynamiclib","-o",stage,mca-source(),"-framework","Metal","-framework","Foundation","-fobjc-arc"),list("/dev/null",log,err));
   let rc = if gt(pid,0) then host_wait(pid) else -1;
   let placed = if eq(rc,0) then fs-rename(stage,mca-artifact()) else -1;
   if and(eq(rc,0),eq(placed,0)) then list("admitted",0,err) else list("refused",if eq(rc,0) then placed else rc,err);
  }
  // The carrier's own words: metal_status carries last_error on one line.
  def mca-reason(status) = mca-reason-at(status,str_find(status,"last_error=",0));
  def mca-reason-at(status,at) = if lt(at,0) then "carrier status names no last_error" else mca-line(status,add(at,11),str_find(status,"\n",add(at,11)));
  def mca-line(status,from,end) = substring(status,from,if lt(end,0) then str_len(status) else end);
 }
 0;
}
