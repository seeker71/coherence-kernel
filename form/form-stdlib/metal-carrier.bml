// fkwu admits the dynamic Metal carrier from beside itself on the first Metal
// call. A fresh worktree holds the carrier's committed Objective-C source and no
// artifact, so every handle reads 0 there. Form owns that admission: it reads the
// artifact against its source, builds it through the host door when absent or
// older, and places it on a fresh inode so a process holding the old one keeps
// its own mapping.
import form-stdlib/core.fk;
import form-stdlib/form-fs.fk;
section [form.bml] {
 class MetalCarrier {
  def mca-source() = "form/native/metal/fk-metal-carrier.m";
  def mca-artifact() = "form/native/metal/fk-metal-carrier.dylib";
  def mca-state() = if (file_size(mca-artifact()) <= 0) then "absent" else if (file_mtime(mca-artifact()) < file_mtime(mca-source())) then "older-than-source" else "standing";
  def mca-host?() = fs-is-dir?("/System/Library/Frameworks/Metal.framework");
  // Answers list(state, exit, stderr path): standing | admitted | refused | no-metal-host.
  def mca-admit(log,err) = if ((String) mca-state() == "standing") then ["standing",0,""] else if (!mca-host?()) then ["no-metal-host",-1,""] else mca-build(log,err);
  def mca-build(log,err) {
   let stage = (mca-artifact() + (".building-" + host_pid().str()));
   let pid = host_spawn_at(["/usr/bin/cc","-O2","-dynamiclib","-o",stage,mca-source(),"-framework","Metal","-framework","Foundation","-fobjc-arc"],["/dev/null",log,err]);
   let rc = if (pid > 0) then host_wait(pid) else -1;
   let placed = if ((Comparable) rc == 0) then fs-rename(stage,mca-artifact()) else -1;
   if (((Comparable) rc == 0) && ((Comparable) placed == 0)) then ["admitted",0,err] else ["refused",if ((Comparable) rc == 0) then placed else rc,err];
  }
  // The carrier's own words: metal_status carries last_error on one line.
  def mca-reason(status) = mca-reason-at(status,str_find(status,"last_error=",0));
  def mca-reason-at(status,at) = if (at < 0) then "carrier status names no last_error" else mca-line(status,(at + 11),str_find(status,"\n",(at + 11)));
  def mca-line(status,from,end) = substring(status,from,if (end < 0) then len(status) else end);
  // Allocation and release publish to the same mutable owner at the carrier
  // boundary. A parent keeps each child before that child's first allocation.
  def mca-owner(parent,label) {
   let owner=record_new(0,"metal-owner",1,"label",label,"release-handles",[],"children",[],"parent",parent);
   if record?(parent) then record_set(parent,"children",append(record_get(parent,"children") ?? [],[owner])) else 0;
   owner;
  }
  def mca-owner?(owner) = record?(owner) && record_get(owner,"metal-owner")==1;
  def mca-tail-owner(value) = value_kind(value)=="list" && len(value)>0 && mca-owner?(value[len(value) - 1]) ? value[len(value) - 1] : nothing();
  def mca-alloc(owner,bytes) = metal_buf_alloc([bytes,owner,"release-handles"]);
  def mca-map(owner,path,offset,bytes) = metal_buf_from_file([path,owner,"release-handles"],offset,bytes);
  def mca-free(owner,handle) = metal_buf_free([handle,owner,"release-handles"]);
  def mca-handles(owner) = !record?(owner) ? [] : record_has(owner,"release-sources") ? filter(h=>!nothing?(mca-source-owner(owner,h)),record_get(owner,"release-selection")) : record_get(owner,"release-handles") ?? [];
  def mca-source-owner(owner,handle) = !record_has(owner,"release-sources") ? owner : foldl((found,source)=>!nothing?(found) ? found : any?(h=>h==handle,mca-handles(source)) ? mca-source-owner(source,handle) : nothing(),nothing(),record_get(owner,"release-sources"));
  def mca-close-owned-by(owner,settle,free) {
   let handles=mca-handles(owner);
   nil?(handles) ? 0 : {
    record_set(owner,"release-handles",handles);record_set(owner,"on",0);record_set(owner,"reason","release-pending");
    settle();mca-release-next(owner,handles,[],0,free);
   };
  }
  def mca-release-next(owner,handles,kept,released,free) = nil?(handles) ? {
   record_set(owner,"release-handles",reverse(kept));record_set(owner,"reason",nil?(kept) ? "closed" : "release-incomplete");released;
  } : {
   let source=mca-source-owner(owner,handles[0]);
   let done=!nothing?(source) && free(source,handles[0])==1;let retained=done ? kept : cons(handles[0],kept);
   if done then record_set(source,"release-handles",filter(h=>h != handles[0],mca-handles(source))) else 0;
   record_set(owner,"release-handles",append(reverse(retained),handles[1:]));
   mca-release-next(owner,handles[1:],retained,released+(done ? 1 : 0),free);
  };
  def mca-owned(owner) = !record?(owner) ? 0 : len(mca-handles(owner))+sum(map(mca-owned,record_get(owner,"children") ?? []));
  def mca-release(owner) = !record?(owner) ? 1 : {
   let children=record_get(owner,"children") ?? [];
   let outcomes=map(mca-release,children);
   record_set(owner,"children",filter(child=>mca-owned(child)>0,children));
   let closed=mca-close-owned-by(owner,()=>metal_sync(),mca-free);
   mca-owned(owner)==0 && all?(ok=>ok,outcomes);
  };
  def mca-free-selected(owner,handles) {
   let outcomes=map(h=>!any?(held=>held==h,mca-handles(owner)) ? 1 : mca-free(owner,h)==1,handles);
   all?(ok=>ok,outcomes);
  }
 }
 0;
}
