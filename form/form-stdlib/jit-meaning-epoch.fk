; jit-meaning-epoch.fk — the freshness membrane: one integer naming the
; meaning that compiles programs, recomputed only where freshness is decided,
; never on a hot call.
;
; WHAT THE EPOCH COVERS, and each inclusion is a paid-for lesson:
;
;   THE TRANSITIVE PRELUDE CLOSURE, not a file list. "; preludes:" lines are
;   live recursive load directives in this body, so form-lower's meaning
;   includes every cell it reaches. The membrane walks that closure itself —
;   edit a helper three preludes deep and the epoch moves.
;
;   ITS OWN BYTES, and the registry cell's. An epoch fold that exempts itself
;   lets a fixed fold-collision validate entries cached under the collision.
;   The roots below include this file and jit-once-born.fk by name.
;
;   A KERNEL STAMP, declared partial. Emitted images speak the kernel's ABI,
;   and this repo's witnessed hazard is primitives living twice (native +
;   jitabi mirror) healing separately. The stamp folds ./fkwu's size and its
;   first 4096 bytes — a rebuild that changes neither escapes it. That seam
;   is named here rather than papered: the full answer is a kernel-exported
;   abi-version, which is kernel work, not this cell's.
;
; THE FOLD is a rolling multiply-add with a prime modulus under 2^30, exact
; on every arm (the 2^53 decimal-weight rounding is a witnessed body defect;
; power-of-two-safe moduli are the repair). Order-sensitive: swapping two
; whole definitions moves the epoch.
;
; WHAT IT DOES NOT COVER, said plainly: a .fkb cache can serve a stale
; compile while the membrane folds fresh bytes (whole-second mtime keying,
; witnessed). The membrane cannot see what the loader chose. Force fresh
; compiles at membranes; the band does.
;
; preludes: form-stdlib/core.fk
;
; Proven by: form-stdlib/tests/jit-meaning-epoch-band.fk

(do
    (defn jme-mod () 1073741789)

    (defn jme-fold-str (s i n acc)
        (if (ge i n) acc
            (jme-fold-str s (add i 1) n
                (mod (add (mul acc 33) (str_byte_at s i)) (jme-mod)))))
    (defn jme-fold-file (path acc)
        (if (lt (file_size path) 0) acc
            (do (let s (read_file path))
                (jme-fold-str s 0 (str_len s) acc))))

    ; ── the prelude closure: "; preludes:" lines, walked recursively ───────
    (defn jme-member? (x xs)
        (if (eq (len xs) 0) 0
            (if (str_eq x (head xs)) 1 (jme-member? x (tail xs)))))

    (defn jme-next-word (s i n)
        (if (ge i n) (list "" i)
            (if (eq (str_byte_at s i) 32) (jme-next-word s (add i 1) n)
                (do (let e (jme-word-end s i n))
                    (list (substring s i e) e)))))
    (defn jme-word-end (s i n)
        (if (ge i n) i
            (do (let b (str_byte_at s i))
                (if (or (eq b 32) (eq b 10)) i (jme-word-end s (add i 1) n)))))

    ; a preludes line names paths like form-stdlib/x.fk, resolved under form/
    ; an absolute path passes through; a repo-relative one roots under form/
    (defn jme-resolve (name)
        (if (eq (str_byte_at name 0) 47) name (str_concat "form/" name)))

    (defn jme-scan-line (s pos stop found)
        (if (ge pos stop) found
            (do (let w (jme-next-word s pos stop))
                (if (eq (str_len (nth w 0)) 0) found
                    (jme-scan-line s (nth w 1) stop
                        (append found (list (jme-resolve (nth w 0)))))))))

    (defn jme-scan (s pos found)
        (do (let at (str_find s "; preludes:" pos))
            (if (lt at 0) found
                (do (let eol (str_find s "\n" at))
                    (let stop (if (lt eol 0) (str_len s) eol))
                    (jme-scan s stop
                        (jme-scan-line s (add at 11) stop found))))))

    (defn jme-closure-go (queue seen)
        (if (eq (len queue) 0) seen
            (do (let p (head queue))
                (if (eq (jme-member? p seen) 1)
                    (jme-closure-go (tail queue) seen)
                    (if (lt (file_size p) 0)
                        (jme-closure-go (tail queue) seen)
                        (do (let s (read_file p))
                            (jme-closure-go
                                (append (tail queue) (jme-scan s 0 (list)))
                                (append seen (list p)))))))))
    (defn jme-closure (roots) (jme-closure-go roots (list)))

    ; ── the kernel stamp: size plus the header page ────────────────────────
    (defn jme-kernel-stamp (path)
        (do (let sz (file_size path))
            (if (lt sz 0) 0
                (do (let s (read_file path))
                    (let cap (if (lt (str_len s) 4096) (str_len s) 4096))
                    (mod (add (mul (jme-fold-str s 0 cap 7) 33) sz) (jme-mod))))))

    ; ── the epoch: closure fold, then kernel stamp, one integer ────────────
    (defn jme-roots ()
        (list "form/form-stdlib/form-lower.fk"
              "form/form-stdlib/form-asm.fk"
              "form/form-stdlib/jit-once-born.fk"
              "form/form-stdlib/jit-meaning-epoch.fk"))

    (defn jme-fold-files (ps acc)
        (if (eq (len ps) 0) acc
            (jme-fold-files (tail ps) (jme-fold-file (head ps) acc))))

    (defn jme-epoch-of (roots kernel-path)
        (mod (add (jme-fold-files (jme-closure roots) 5381)
                  (jme-kernel-stamp kernel-path)) (jme-mod)))
    (defn jme-epoch () (jme-epoch-of (jme-roots) "fkwu"))

    0)
