; living-world-enquiry-profile.fk -- exact offered trials reveal local sameness.
;
; A profile records one current hypothesis's output at every exact trial in one
; current enquiry.  A profile class retains every provenance-distinct
; hypothesis that produced the same binding/output point field.  It says only
; "indistinguishable in this offered space"; it never claims universal
; equivalence, chooses a representative, erases a hypothesis, or promotes a
; model.  The enquiry itself is retained as the uncertainty boundary.
;
; Zero, one, and many classes remain distinct.  New bindings, evidence arrival,
; or revocation reconstruct the enquiry and therefore change profile identity.
;
; preludes: form-stdlib/core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk

(let LWEP-POINT   (bp "LWEP-POINT"))
(let LWEP-PROFILE (bp "LWEP-PROFILE"))
(let LWEP-CLASS   (bp "LWEP-CLASS"))

; A point intentionally excludes hypothesis identity so equal behavior can
; recur while retaining the exact offered bindings and output cell.
(defn lwep-point (bindings output)
    (intern_node LWEP-POINT
        (list bindings output (lwo-local-path))))
(defn lwep-point? (cell) (lwo-category? cell LWEP-POINT))
(defn lwep-point-bindings (point) (nth (node_children point) 0))
(defn lwep-point-output (point) (nth (node_children point) 1))

(defn lwep-evaluation-for (items hypothesis)
    (if (eq (len items) 0) (lwo-none)
        (if (node_eq
                (lwph-probe-eval-hypothesis (head items)) hypothesis)
            (head items)
            (lwep-evaluation-for (tail items) hypothesis))))

(defn lwep-points-for-trials (trials hypothesis points)
    (if (eq (len trials) 0) points
        (do
            (let trial (head trials))
            (let evaluation
                (lwep-evaluation-for
                    (lwo-field-items (lwhe-trial-evaluations trial))
                    hypothesis))
            (lwep-points-for-trials (tail trials) hypothesis
                (if (node_eq evaluation (lwo-none)) points
                    (lwo-field-add points
                        (lwep-point (lwhe-trial-bindings trial)
                            (lwph-probe-eval-output evaluation))))))))

; children: exact enquiry, exact hypothesis, binding/output point field,
; local path
(defn lwep-profile (enquiry hypothesis points)
    (intern_node LWEP-PROFILE
        (list enquiry hypothesis points (lwo-local-path))))
(defn lwep-profile? (cell) (lwo-category? cell LWEP-PROFILE))
(defn lwep-profile-enquiry (profile) (nth (node_children profile) 0))
(defn lwep-profile-hypothesis (profile) (nth (node_children profile) 1))
(defn lwep-profile-points (profile) (nth (node_children profile) 2))

(defn lwep-profile-for (enquiry hypothesis)
    (lwep-profile enquiry hypothesis
        (lwep-points-for-trials
            (lwo-field-items (lwhe-enquiry-trials enquiry)) hypothesis
            (lwo-empty-field))))

(defn lwep-profiles-items (items enquiry profiles)
    (if (eq (len items) 0) profiles
        (lwep-profiles-items (tail items) enquiry
            (lwo-field-add profiles
                (lwep-profile-for enquiry (head items))))))

(defn lwep-profiles-for (enquiry)
    (if (eq (lwhe-enquiry? enquiry) 0) (lwo-empty-field)
        (lwep-profiles-items
            (lwo-field-items
                (lwhe-candidate-hypotheses
                    (lwhe-space-candidate
                        (lwhe-enquiry-space enquiry))))
            enquiry (lwo-empty-field))))

(defn lwep-class-hypotheses (items points hypotheses)
    (if (eq (len items) 0) hypotheses
        (do
            (let profile (head items))
            (lwep-class-hypotheses (tail items) points
                (if (node_eq (lwep-profile-points profile) points)
                    (lwo-field-add hypotheses
                        (lwep-profile-hypothesis profile)) hypotheses)))))

; children: exact enquiry, exact point signature, all matching hypotheses,
; finite-space uncertainty, exact enquiry witnesses, local path
(defn lwep-class (enquiry points hypotheses)
    (intern_node LWEP-CLASS
        (list enquiry points hypotheses (lwlc-unknown enquiry)
              (lwhe-enquiry-witness-field enquiry) (lwo-local-path))))
(defn lwep-class? (cell) (lwo-category? cell LWEP-CLASS))
(defn lwep-class-enquiry (class) (nth (node_children class) 0))
(defn lwep-class-points (class) (nth (node_children class) 1))
(defn lwep-class-hypothesis-field (class) (nth (node_children class) 2))
(defn lwep-class-unknown (class) (nth (node_children class) 3))
(defn lwep-class-witnesses (class) (nth (node_children class) 4))

(defn lwep-classes-items (items enquiry profiles classes)
    (if (eq (len items) 0) classes
        (do
            (let profile (head items))
            (let points (lwep-profile-points profile))
            (let class
                (lwep-class enquiry points
                    (lwep-class-hypotheses
                        (lwo-field-items profiles) points (lwo-empty-field))))
            (lwep-classes-items (tail items) enquiry profiles
                (lwo-field-add classes class)))))

(defn lwep-classes-for (enquiry)
    (do
        (let profiles (lwep-profiles-for enquiry))
        (lwep-classes-items (lwo-field-items profiles) enquiry profiles
            (lwo-empty-field))))

(defn lwep-class-current? (world class)
    (if (eq (lwep-class? class) 0) 0
        (do
            (let enquiry (lwep-class-enquiry class))
            (if (eq (lwhe-enquiry-current? world enquiry) 0) 0
                (lwo-field-has? (lwep-classes-for enquiry) class)))))

; witnessed: 2026-08-09 -> 33554431 recursive enquiry profile on fkwu
