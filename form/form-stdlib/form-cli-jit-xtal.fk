
(do (defn Mul () 3) (defn Add () 7) (defn Sample () 5) (defn Expect () 22) (defn CpuDoor () "jit_leaf_inram") (defn MetalDoor () "metal_pipeline") (defn MlxDoor () "mlx_run") (defn fjit-pattern () (list "cpu" "metal" "mlx")) (defn fjit-spc () " ") (defn fjit-nl () (byte_to_str 10)) (defn fjit-mlx (n) (str_concat (int_to_str n) (str_concat (fjit-spc) (str_concat (int_to_str (Mul)) (str_concat " mul " (str_concat (int_to_str (Add)) " add")))))) (defn fjit-msl () (do (let n (fjit-nl)) (str_concat "#include <metal_stdlib>" (str_concat n (str_concat "using namespace metal;" (str_concat n (str_concat "kernel void form_jit_f(device uint *a [[buffer(0)]], uint gid [[thread_position_in_grid]]) { if (gid == 0) a[0] = a[0] * " (str_concat (int_to_str (Mul)) (str_concat " + " (str_concat (int_to_str (Add)) "; }")))))))))) (defn fjit-check () (do (let b0 (if (eq (Mul) 3) (if (eq (Add) 7) 1 0) 0)) (let b1 (if (eq (Sample) 5) (if (eq (Expect) 22) 2 0) 0)) (let b2 (if (str_eq (fjit-mlx (Sample)) "5 3 mul 7 add") 4 0)) (let b3 (if (str_eq (CpuDoor) "jit_leaf_inram") 8 0)) (let b4 (if (str_eq (MetalDoor) "metal_pipeline") 16 0)) (let b5 (if (str_eq (MlxDoor) "mlx_run") 32 0)) (add b0 (add b1 (add b2 (add b3 (add b4 b5))))))) (defn FormJit () (list "abstraction" "FormJit" (list "T") (list "fjit-spc" "fjit-nl" "fjit-mlx" "fjit-msl" "fjit-check") (list "Mul" "Add" "Sample" "Expect" "CpuDoor" "MetalDoor" "MlxDoor") (list) (list "fjit-pattern"))) 0)
