
(do (let BackendCell (language-template-with-members "BackendCell" (list "TImage") (list (language-template-member "image" "TImage")))) (defn Mul () 3) (defn Add () 7) (defn Sample () 5) (defn Expect () 22) (defn Mlx () 0) (defn Metal () 1) (defn Cpu () 2) (defn fjit-pattern () (list "mlx" "metal" "cpu")) (defn fjit-spc () " ") (defn fjit-nl () (byte_to_str 10)) (defn fjit-mlx (n) (str_concat (int_to_str n) (str_concat (fjit-spc) (str_concat (int_to_str (Mul)) (str_concat " mul " (str_concat (int_to_str (Add)) " add")))))) (defn fjit-msl () (do (let n (fjit-nl)) (str_concat "#include <metal_stdlib>" (str_concat n (str_concat "using namespace metal;" (str_concat n (str_concat "kernel void form_jit_f(device uint *a [[buffer(0)]], uint gid [[thread_position_in_grid]]) { if (gid == 0) a[0] = a[0] * " (str_concat (int_to_str (Mul)) (str_concat " + " (str_concat (int_to_str (Add)) "; }")))))))))) (defn fjit-ssa () (list (list 1 (Add)) (list 2) (list 1 (Mul)) (list 5 1 2) (list 3 3 0))) (defn fjit-apply-mlx (n) (mlx_run (fjit-mlx n))) (defn fjit-apply-cpu (n) (jit_leaf_inram (lo-compile-fn (fjit-ssa) 4) n)) (defn fjit-apply-metal (n) (do (let buf (metal_buf_alloc 4)) (let wrote (metal_buf_write buf 0 (md-le32 n))) (let pipe (metal_pipeline (fjit-msl) "form_jit_f")) (let enq (metal_enqueue pipe (md-bind (list buf) (empty)) 1)) (let sync (metal_sync)) (let res (metal_buf_read buf 0 4)) (let v (str_byte_at res 0)) (let shut (metal_buf_free buf)) v)) (defn fjit-apply (backend n) (if (eq backend (Mlx)) (fjit-apply-mlx n) (if (eq backend (Metal)) (fjit-apply-metal n) (fjit-apply-cpu n)))) (defn fjit-check () (do (let b0 (if (eq (Mul) 3) (if (eq (Add) 7) 1 0) 0)) (let b1 (if (eq (Sample) 5) (if (eq (Expect) 22) 2 0) 0)) (let b2 (if (str_eq (fjit-mlx (Sample)) "5 3 mul 7 add") 4 0)) (let b3 (if (eq (Mlx) 0) (if (eq (Metal) 1) (if (eq (Cpu) 2) 8 0) 0) 0)) (add b0 (add b1 (add b2 b3))))) (defn FormJit () (list "abstraction" "FormJit" (list "T") (list "fjit-spc" "fjit-nl" "fjit-mlx" "fjit-msl" "fjit-ssa" "fjit-apply-mlx" "fjit-apply-cpu" "fjit-apply-metal" "fjit-apply" "fjit-check") (list "Mul" "Add" "Sample" "Expect" "Mlx" "Metal" "Cpu") (list) (list "fjit-pattern"))) 0)
