; mlx-derived.fk — the ops that are NOT carrier rows, and the proof they need none.
;
; STANDING PREFERENCE, 2026-09-09: native Metal is preferred over the MLX lane wherever it
; can do the work (Urs). These recipes exist because the carrier header claimed them for two
; weeks and this file did not have them — an honest organ beats a quietly broken one. They are
; not an invitation to grow the lane. New GPU work goes to form/native/metal/, where the body
; writes its own kernels and can read them back, rather than to a borrowed library's.
;
; The MLX carrier holds eighteen forms and no more (fk-mlx-carrier.c states the
; law and the reason for each). Everything below is a Form-emitted graph over
; those eighteen. Not one of them costs a line of C, and `sub` — which used to
; be a carrier row — is here now to show the law cuts both ways.
;
; Each emitter returns POSTFIX TEXT that acts on whatever the stack already
; holds, so they compose by concatenation. mld-land is the ending every float
; pipeline says: scale by a thousand, round half up, and land an int32, because
; the carrier owns no float return path and needs no float parser.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/mlx-derived-band.fk

(do
    (defn mld-j (a b) (str_concat a (str_concat " " b)))

    ; -- the ending: x -> round(x * 1000) as int32 -------------------------
    (defn mld-land () "1000 mul 1 f32 2 div add i32")
    (defn mld-close (body) (mld-j body (mld-land)))

    ; -- arithmetic that add/mul/div already contain -----------------------
    ; neg is a multiply by minus one; sub is neg then add. The carrier row
    ; for sub was retired on 2026-08-24 and this line replaced it.
    (defn mld-neg () "-1 mul")
    (defn mld-sub () (mld-j (mld-neg) "add"))
    (defn mld-square () "dup mul")
    ; div computes a/b with b on top, so a reciprocal needs the shuffle:
    ; that is the whole reason `swap` is one of the eighteen.
    (defn mld-recip () "1 swap div")

    ; -- activations, all from exp and the four arithmetic rows ------------
    (defn mld-sigmoid () (mld-j (mld-neg) (mld-j "exp 1 add" (mld-recip))))
    (defn mld-silu () (mld-j "dup" (mld-j (mld-sigmoid) "mul")))
    ; swiglu(gate, up) with up beneath gate: silu the gate, multiply through.
    (defn mld-swiglu () (mld-j (mld-silu) "mul"))
    ; tanh(x) = (e-1)/(e+1) with e = exp(2x)
    (defn mld-tanh () (mld-j "2 mul exp dup 1" (mld-j (mld-sub) "swap 1 add div")))

    ; -- the seven the carrier header claimed and this file did not have -----
    ; The header of fk-mlx-carrier.c has listed `gelu layernorm scale axpy shift select clamp` as
    ; Form-emitted graphs since 2026-08-25, beside `rope-pair` and `attn`. NINE names, and not one of
    ; them was here. The claim is what made them invisible: a reader checking whether the carrier is
    ; minimal reads the header, sees the op accounted for, and stops. An overclaim in a comment is not
    ; a lie that fails — it is a lie that CLOSES THE QUESTION, which is worse, because a gap nobody
    ; is looking for outlives one that is red. Written and pinned 2026-09-09.
    ;
    ; `shift` and `select` are NOT written, and deliberately: select IS `where` under another name,
    ; and a shift by k IS scale by 2^k. Adding them would be two rows that compute nothing new, which
    ; is the same minimum law read from the Form side — so the header now names them as the aliases
    ; they are rather than as recipes that ought to exist.
    (defn mld-scale (s) (mld-j s "mul"))
    ; a*x + y with y beneath: the multiply and the add the carrier already has.
    (defn mld-axpy () "mul add")
    ; min is not a row — max is the only comparison — so min(a,b) = -max(-a,-b).
    (defn mld-min (h) (mld-j (mld-neg) (mld-j h (mld-j "-1 mul max" (mld-neg)))))
    (defn mld-clamp (lo hi) (mld-j lo (mld-j "max" (mld-min hi))))
    ; gelu(x) = 0.5x(1 + tanh(0.7978845608(x + 0.044715x^3))) — the tanh lineage, over mld-tanh.
    ; Every constant is an integer RATIO because the carrier's only literal is int32: there is no
    ; decimal point in a program, so 0.044715 is 44715/1000000 and the rest follows.
    (defn mld-gelu-z ()
        "dup dup dup mul 44715 f32 1000000 div mul 1 f32 add mul 797884561 f32 1000000000 div mul")
    (defn mld-gelu ()
        (mld-j (mld-gelu-z) (mld-j (mld-tanh) "1 f32 add mul 1 f32 2 div mul")))

    ; -- reductions and norms, all from sum, rmax, rsqrt -------------------
    (defn mld-mean (n) (mld-j "sum" (mld-j (int_to_str n) "div")))
    ; rmsnorm(x) = x * rsqrt(mean(x^2)); the two dups keep x alive twice.
    (defn mld-rmsnorm (n) (mld-j "dup dup mul" (mld-j (mld-mean n) "rsqrt mul")))
    (defn mld-l2norm () "dup dup mul sum rsqrt mul")
    ; layernorm(x) = rmsnorm(x - mean x): centre first, then the rms rescale already written above.
    ; The centring is where the first draft went wrong — it prepended a `dup` that mld-rmsnorm already
    ; does, and the program died on "did not leave one value" rather than on anything numeric.
    (defn mld-centre (n) (mld-j "dup" (mld-j (mld-mean n) (mld-j (mld-neg) "add"))))
    (defn mld-layernorm (n) (mld-j (mld-centre n) (mld-rmsnorm n)))
    ; softmax(x) = exp(x - rmax x) / sum(exp(x - rmax x))
    (defn mld-softmax () (mld-j "dup rmax" (mld-j (mld-neg) "add exp dup sum div")))

    ; -- attention, composed. The carrier used to carry `attn` as a row calling MLX's FUSED
    ; scaled_dot_product_attention, and the 2026-08-25 consolidation retired it. That retirement was
    ; law-consistent — attention IS derivable, softmax(Q·Kᵀ·s)·V over three matmuls and the softmax
    ; above — but the Form graph it was retired IN FAVOUR OF was never written, so from that day the
    ; carrier had no `attn` and this file had no replacement, and mlx-home-band scored 137 of 255 with
    ; nothing anywhere saying a row had gone. The header of fk-mlx-carrier.c even listed `rope-pair`
    ; among the graphs living here, which was not true either. Both are written now.
    ;
    ; What is LOST and what is not: the meaning is identical, the fast path is not. MLX's fused kernel
    ; does this in one dispatch; this is four. That is the trade the minimum law makes every time, and
    ; it is worth saying out loud rather than letting "derivable" quietly mean "as fast".
    ;
    ; Stack contract: q already on the stack shaped (1,dk) — scores, softmax, then v as (1,dv).
    (defn mld-attn-scores (kfrag) (mld-j kfrag "matmul"))
    (defn mld-attn (kfrag vfrag)
        (mld-j (mld-attn-scores kfrag) (mld-j (mld-softmax) (mld-j vfrag "matmul"))))

    ; -- the RoPE pair rotation, composed from sin/cos and `take`. (x0,x1) by angle a becomes
    ; (x0·cos a − x1·sin a, x1·cos a + x0·sin a).
    ;
    ; The rotation MATRIX cannot be built here — there is no concat, so [[cos,-sin],[sin,cos]] has no
    ; expression — and the first draft of this recipe tried anyway and died on a reshape. `take` is
    ; what makes it composable: take(x,[1,0]) is (x1,x0), and multiplied by (-1,1) that is (-x1,x0),
    ; which is exactly the sin term. So the pair rotation is a gather, two scalar multiplies and an
    ; add, and it needed no carrier row after all.
    ;
    ; PINNED AT A REAL ANGLE, deliberately: at a = 0 this is the identity, so a check at position 0
    ; proves only that the op exists and would pass over a rotation that does nothing. At a = 1 rad
    ; with x = (3,4) the sum is 7·cos 1 − sin 1 = 2.9408, and mlx-home-band pins 2940.
    (defn mld-rope-pair (afrag)
        (mld-j "dup v2 1 0 take v2 -1 1 f32 mul"
        (mld-j afrag (mld-j "sin mul swap" (mld-j afrag "cos mul add")))))

    ; -- the sixteen witnesses --------------------------------------------
    (defn mld-p-sub () (mld-j "7 3" (mld-j (mld-sub) "i32")))
    (defn mld-p-neg () (mld-j "5" (mld-j (mld-neg) "i32")))
    (defn mld-p-square () (mld-j "6" (mld-j (mld-square) "i32")))
    (defn mld-p-recip () (mld-close (mld-j "4 f32" (mld-recip))))
    (defn mld-p-sigmoid () (mld-close (mld-j "0 f32" (mld-sigmoid))))
    (defn mld-p-silu () (mld-close (mld-j "0 f32" (mld-silu))))
    (defn mld-p-tanh () (mld-close (mld-j "0 f32" (mld-tanh))))
    ; swiglu's zero is load-bearing: silu(0) is exactly 0, so a derivation
    ; that lost the gate would answer 3000 here, not 0.
    (defn mld-p-swiglu () (mld-close (mld-j "6 f32 0 f32" (mld-swiglu))))
    ; the same gate without silu — sigmoid(0) * 6 = 3
    (defn mld-p-gated () (mld-close (mld-j "6 f32 0 f32" (mld-j (mld-sigmoid) "mul"))))
    (defn mld-p-mean () (mld-close (mld-j "v4 1 2 3 4 f32" (mld-mean 4))))
    (defn mld-p-l2norm () (mld-close (mld-j "v2 3 4 f32" (mld-j (mld-l2norm) "sum"))))
    (defn mld-p-rmsnorm () (mld-close (mld-j "v2 3 3 f32" (mld-j (mld-rmsnorm 2) "sum"))))
    (defn mld-p-softmax () (mld-close (mld-j "v2 1 1 f32" (mld-j (mld-softmax) "sum"))))
    ; matmul is the one row MLX refuses on integers, so the f32 comes first.
    (defn mld-p-matmul () (mld-close "v4 1 2 3 4 f32 r2 2 2 dup matmul sum"))
    (defn mld-p-take () "v4 10 20 30 40 v1 2 take sum i32")
    (defn mld-p-argmax () "v4 1 9 3 4 argmax i32")

    ; -- the five rows added 2026-08-24, and what they let Form derive --------
    ; The op census that day read every kernel the qwen35 Metal path emits and
    ; found four needing sin/cos (rope, partial_rope, rope_pair, q6k_matvec)
    ; that this carrier could not say at all. log came with them because it
    ; retires `pow` — the miss named in the 2026-08-20 receipt — as a Form line.
    (defn mld-pow () "swap log mul exp")           ; a^b : stack [b, a]
    (defn mld-where () "dup 7 mul swap 1 swap -1 mul add 9 mul add")
    ; MLX `div` on two int32 is TRUE division, not floor — witnessed
    ; 2026-08-24, 17/5 came back 3.4 and the mod derived from it read 0.
    ; The `i32` is the floor, and it is why dtype had to be a row.
    (defn mld-mod (n) (mld-j "dup" (mld-j (int_to_str n) (mld-j "div i32" (mld-j (int_to_str n) (mld-j "mul" (mld-sub)))))))

    (defn mld-p-sin () (mld-close "0 f32 sin"))
    (defn mld-p-cos () (mld-close "0 f32 cos"))
    (defn mld-p-log () (mld-close "1 f32 log"))
    ; a^b wants the BASE pushed first: swap lifts it under log.
    (defn mld-p-pow () (mld-close (mld-j "2 f32 3" (mld-pow))))
    (defn mld-p-gt () "5 3 gt i32")
    (defn mld-p-iota () "5 iota sum i32")
    ; where(1>0, 7, 9) with no select row: c*7 + (1-c)*9
    (defn mld-p-where () (mld-j "1 0 gt i32" (mld-j (mld-where) "i32")))
    ; 17 mod 5 = 2, with no remainder row: a - (a/n)*n
    (defn mld-p-mod () (mld-j "17" (mld-j (mld-mod 5) "i32")))

    ; -- run them ----------------------------------------------------------
    ; -- witnesses for the seven the header claimed --------------------------
    (defn mld-p-scale () (mld-close (mld-j "7 f32" (mld-scale "3"))))
    (defn mld-p-axpy () (mld-close (mld-j "7 f32 3 4" (mld-axpy))))
    (defn mld-p-clamp () (mld-j "5" (mld-j (mld-clamp "0" "3") "i32")))
    (defn mld-p-clamp-lo () (mld-j "-2" (mld-j (mld-clamp "0" "3") "i32")))
    ; gelu(1) = 0.841192...; layernorm([1,2,3,4]) has sum 0 and sum-of-squares 4 (3999 in f32)
    (defn mld-p-gelu () (mld-j "1 f32" (mld-j (mld-gelu) "1000 mul i32")))
    (defn mld-p-layernorm () (mld-j "v4 1 2 3 4 f32" (mld-j (mld-layernorm 4) "dup mul sum 1000 mul i32")))

    (defn mld-run (p) (mlx_run p))

    (defn mld-check ()
        (add (if (eq (mld-run (mld-p-sub)) 4) 1 0)
        (add (if (eq (mld-run (mld-p-neg)) (sub 0 5)) 2 0)
        (add (if (eq (mld-run (mld-p-square)) 36) 4 0)
        (add (if (eq (mld-run (mld-p-recip)) 250) 8 0)
        (add (if (eq (mld-run (mld-p-sigmoid)) 500) 16 0)
        (add (if (eq (mld-run (mld-p-silu)) 0) 32 0)
        (add (if (eq (mld-run (mld-p-tanh)) 0) 64 0)
        (add (if (eq (mld-run (mld-p-swiglu)) 0) 128 0)
        (add (if (eq (mld-run (mld-p-mean)) 2500) 256 0)
        (add (if (eq (mld-run (mld-p-l2norm)) 1400) 512 0)
        (add (if (eq (mld-run (mld-p-rmsnorm)) 2000) 1024 0)
        (add (if (eq (mld-run (mld-p-softmax)) 1000) 2048 0)
        (add (if (eq (mld-run (mld-p-matmul)) 54000) 4096 0)
        (add (if (eq (mld-run (mld-p-take)) 30) 8192 0)
        (add (if (eq (mld-run (mld-p-argmax)) 1) 16384 0)
        (add (if (eq (mld-run (mld-p-gated)) 3000) 32768 0)
        (add (if (eq (mld-run (mld-p-sin)) 0) 65536 0)
        (add (if (eq (mld-run (mld-p-cos)) 1000) 131072 0)
        (add (if (eq (mld-run (mld-p-log)) 0) 262144 0)
        (add (if (eq (mld-run (mld-p-pow)) 8000) 524288 0)
        (add (if (eq (mld-run (mld-p-gt)) 1) 1048576 0)
        (add (if (eq (mld-run (mld-p-iota)) 10) 2097152 0)
        (add (if (eq (mld-run (mld-p-where)) 7) 4194304 0)
        (add (if (eq (mld-run (mld-p-mod)) 2) 8388608 0)
        (add (if (eq (mld-run (mld-p-scale)) 21000) 16777216 0)
        (add (if (eq (mld-run (mld-p-axpy)) 19000) 33554432 0)
        (add (if (eq (mld-run (mld-p-clamp)) 3) 67108864 0)
        (add (if (eq (mld-run (mld-p-clamp-lo)) 0) 134217728 0)
        (add (if (eq (mld-run (mld-p-gelu)) 841) 268435456 0)
             (if (eq (mld-run (mld-p-layernorm)) 3999) 536870912 0)))))))))))))))))))))))))))))))
    0)
