; form-cli-organ-mint-run.fk — mint remaining-organ samples, fit overlay, print lift.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-mint-split-lineage.fk
; preludes: form-stdlib/form-cli-organ-mint-xtal.fk

(do
    (let rows (fom-corpus 3 1))
    (let n (fom-n 3 1))
    (let correct (fom-heldout-correct rows))
    (print_str (str_concat "fom n=" (str_concat (int_to_str n) "\n")))
    (print_str (str_concat "fom unique=" (str_concat (int_to_str (fom-unique rows)) "\n")))
    (print_str (str_concat "fom exact-leakage=" (str_concat (int_to_str (fom-leakage rows)) "\n")))
    (print_str (str_concat "fom source-overlap-ids=" (str_concat (int_to_str (len (fmls-source-intersection rows (SplitTrain) (SplitHeldout)))) "\n")))
    (print_str (str_concat "fom lesson-overlap-ids=" (str_concat (int_to_str (fom-lesson-leakage rows)) "\n")))
    (print_str (str_concat "fom transform-only-ids=" (str_concat (int_to_str (len (fmls-transform-only rows (SplitTrain) (SplitHeldout)))) "\n")))
    (print_str (str_concat "fom lineage-signal=" (str_concat (int_to_str (fom-lineage-signal rows)) "\n")))
    (print_str (str_concat "fom heldout-correct=" (str_concat (int_to_str correct) "\n")))
    (print_str (str_concat "fom heldout-n=" (str_concat (int_to_str (fom-count-split rows (SplitHeldout))) "\n")))
    (print_str (str_concat "fom lora-writer=" (str_concat (int_to_str (fom-lora-writer)) "\n")))
    (print_str (str_concat "fom check=" (str_concat (int_to_str (fom-check)) "\n")))
    (print_str (str_concat "fom scale-5-2=" (str_concat (int_to_str (fom-n 5 2)) "\n")))
    (print_str (str_concat "fom scale-12-4=" (str_concat (int_to_str (fom-n 12 4)) "\n")))
    (print_str (str_concat "fom scale-5-2-lesson-overlap-ids=" (str_concat (int_to_str (len (fmls-lesson-intersection (fom-corpus 5 2) (SplitTrain) (SplitHeldout)))) "\n")))
    (print_str "fom behavior-observation=nothing\n")
    (print_str (str_concat "fom sample-phase=" (str_concat (nth (fom-row "phase" 0 (SplitTrain)) 2) "\n")))
    (print_str (str_concat "fom sample-consent=" (str_concat (nth (fom-row "consent" 0 (SplitTrain)) 2) "\n")))
    (print_str (str_concat "fom sample-jit=" (str_concat (nth (fom-row "jit" 0 (SplitTrain)) 2) "\n")))
    0)
