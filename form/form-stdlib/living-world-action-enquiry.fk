; living-world-action-enquiry.fk -- unresolved action plurality may ask, never choose.
; witnessed: 2026-08-08 -> optional action enquiry 32767 on fkwu
;
; When two or more current action intentions independently reach the offered
; recurrence threshold, the action field is OPEN: there is no primary and no
; selection proposal.  This organ makes that exact unresolved field available
; as a governed, content-addressed question.  The question retains every
; candidate, eligible intention, alternative, offered unknown, derived unknown,
; witness, threshold, declaration, lens, choice, and timeout already present in
; the field.  It introduces no domain words and chooses none of them.
;
; A current question holder may optionally offer a stance.  A stance can carry
; any valid four-arm acknowledgment, including a NODE/ALTERNATIVE; optional
; pending or expired timeout evidence; an optional live lens declaration;
; further alternatives; an optional unknowable remainder; and evidence.  No
; stance is required.  Absence, immediate NOTHING, TIME-PENDING, and an expired
; TIME-OUTCOME remain different histories.  Stances are retained as a plural
; evidence field and never become an action selection in this organ.
;
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk

(let LWAE-QUESTION        (bp "LWAE-QUESTION"))
(let LWAE-QUESTION-ORIGIN (bp "LWAE-QUESTION-ORIGIN"))
(let LWAE-STANCE          (bp "LWAE-STANCE"))
(let LWAE-STANCE-EVIDENCE (bp "LWAE-STANCE-EVIDENCE"))

(defn lwae-eligible-for-field (world field)
    (lwac-eligible-items world
        (lwo-field-items (lwac-field-candidates field))
        (lwac-field-threshold field) (lwo-empty-field)))

(defn lwae-field-current? (world field)
    (if (eq (lwac-field? field) 0) 0
        (node_eq field
            (lwac-field-for world (lwac-field-focus field)
                (lwac-field-threshold field)))))

(defn lwae-plural-open-field? (world field)
    (if (and (eq (lwae-field-current? world field) 1)
             (and (eq (lwac-open? (lwac-field-status field)) 1)
                  (and (node_eq (lwac-field-primary field) (lwo-none))
                       (ge (lwo-field-size
                               (lwae-eligible-for-field world field)) 2)))) 1 0))

; children: exact OPEN action field, exact eligible intention evidence, local path
(defn lwae-question (field eligible)
    (intern_node LWAE-QUESTION
        (list field eligible (lwo-local-path))))
(defn lwae-question? (cell) (lwo-category? cell LWAE-QUESTION))
(defn lwae-question-field (question) (nth (node_children question) 0))
(defn lwae-question-eligible (question) (nth (node_children question) 1))
(defn lwae-question-path (question) (nth (node_children question) 2))
(defn lwae-question-focus (question)
    (lwac-field-focus (lwae-question-field question)))
(defn lwae-question-candidates (question)
    (lwac-field-candidates (lwae-question-field question)))
(defn lwae-question-alternatives (question)
    (lwac-field-alternatives (lwae-question-field question)))
(defn lwae-question-unknowns (question)
    (lwac-field-unknowns (lwae-question-field question)))
(defn lwae-question-derived-unknown (question)
    (lwac-field-derived-unknown (lwae-question-field question)))
(defn lwae-question-witnesses (question)
    (lwac-field-witnesses (lwae-question-field question)))
(defn lwae-question-threshold (question)
    (lwac-field-threshold (lwae-question-field question)))

(defn lwae-question-shape (world focus threshold)
    (do
        (let field (lwac-field-for world focus threshold))
        (if (eq (lwae-plural-open-field? world field) 0) (lwo-none)
            (lwae-question field
                (lwae-eligible-for-field world field)))))

(defn lwae-question-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwae-question?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwae-question-origin (question)
    (intern_node LWAE-QUESTION-ORIGIN (list question)))

(defn lwae-candidate-for-question (question)
    (do
        (let witnesses (lwae-question-witnesses question))
        (let eligible-count
            (lwo-field-size (lwae-question-eligible question)))
        (let origin (lwae-question-origin question))
        (lwo-emergent question witnesses
            (intern_trivial_int eligible-count)
            (intern_trivial_int eligible-count)
            (intern_trivial_int (lwo-field-size witnesses)) origin)))

(defn lwae-question-current? (world candidate)
    (if (eq (lwae-question-candidate? candidate) 0) 0
        (do
            (let question (lwo-emergent-shape candidate))
            (let fresh
                (lwae-question-shape world
                    (lwae-question-focus question)
                    (lwae-question-threshold question)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate
                    (lwae-candidate-for-question fresh))))))

(defn lwae-question-steady? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwae-question-current? world candidate) 1)) 1 0))

(defn lwae-active-question-items? (world items focus threshold)
    (if (eq (len items) 0) 0
        (do
            (let candidate (head items))
            (if (and (eq (lwae-question-steady? world candidate) 1)
                     (do
                        (let question (lwo-emergent-shape candidate))
                        (and (node_eq (lwae-question-focus question) focus)
                             (eq (lwae-question-threshold question)
                                 threshold))))
                1
                (lwae-active-question-items? world (tail items)
                    focus threshold)))))

(defn lwae-active-question? (world focus threshold)
    (lwae-active-question-items? world
        (lwo-field-items (lwo-world-cells world)) focus threshold))

(defn lwae-question-proposal (world focus threshold)
    (if (eq (lwae-active-question? world focus threshold) 1) (lwo-none)
        (do
            (let question (lwae-question-shape world focus threshold))
            (if (node_eq question (lwo-none)) (lwo-none)
                (do
                    (let witnesses (lwae-question-witnesses question))
                    (let origin (lwae-question-origin question))
                    (let candidate (lwae-candidate-for-question question))
                    (lwt-proposal candidate
                        (lwt-sources-from-attributions
                            (lwo-field-items witnesses) (lwo-empty-field))
                        origin))))))

(defn lwae-question-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwae-question-current? world
            (lwt-proposal-candidate proposal))))

(defn lwae-integrate-question (round proposal action)
    (if (eq (lwae-question-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; children: question candidate, four-arm acknowledgment, optional
; time observation, optional live lens declaration, further alternatives,
; optional unknowable remainder, evidence, local path. Source is intentionally
; absent and is recovered from active attribution.
(defn lwae-stance
    (question ack time-observation declaration alternatives unknown evidence)
    (intern_node LWAE-STANCE
        (list question ack time-observation declaration alternatives unknown
              evidence (lwo-local-path))))
(defn lwae-stance? (cell) (lwo-category? cell LWAE-STANCE))
(defn lwae-stance-question (stance) (nth (node_children stance) 0))
(defn lwae-stance-ack (stance) (nth (node_children stance) 1))
(defn lwae-stance-time (stance) (nth (node_children stance) 2))
(defn lwae-stance-declaration (stance) (nth (node_children stance) 3))
(defn lwae-stance-alternatives (stance) (nth (node_children stance) 4))
(defn lwae-stance-unknown (stance) (nth (node_children stance) 5))
(defn lwae-stance-evidence (stance) (nth (node_children stance) 6))
(defn lwae-stance-path (stance) (nth (node_children stance) 7))

(defn lwae-optional-declaration-valid? (declaration)
    (if (or (node_eq declaration (lwo-none))
            (eq (lwlc-declaration-valid? declaration) 1)) 1 0))

(defn lwae-time-pending-valid? (pending)
    (if (and (eq (oac-time-pending? pending) 1)
             (and (eq (oac-timeout-valid?
                           (oac-time-pending-timeout pending)) 1)
                  (node_eq pending
                    (oac-timeout-condense
                        (oac-time-pending-timeout pending)
                        (oac-time-pending-observed pending))))) 1 0))

(defn lwae-time-outcome-valid? (outcome)
    (if (and (eq (oac-time-outcome? outcome) 1)
             (and (eq (oac-timeout-valid?
                           (oac-time-outcome-timeout outcome)) 1)
                  (node_eq outcome
                    (oac-timeout-condense
                        (oac-time-outcome-timeout outcome)
                        (oac-time-outcome-observed outcome))))) 1 0))

(defn lwae-time-observation-valid? (observation)
    (if (or (node_eq observation (lwo-none))
            (or (eq (lwae-time-pending-valid? observation) 1)
                (eq (lwae-time-outcome-valid? observation) 1))) 1 0))

(defn lwae-stance-time-coherent? (stance)
    (do
        (let observation (lwae-stance-time stance))
        (if (eq (oac-time-outcome? observation) 1)
            (node_eq (lwae-stance-ack stance)
                (oac-time-outcome-ack observation))
            1)))

(defn lwae-stance-reference-coherent? (stance)
    (if (eq (oac-alternative-ack? (lwae-stance-ack stance)) 0) 1
        (node_eq
            (oac-alternative-reference
                (oac-payload (lwae-stance-ack stance)))
            (lwae-stance-question stance))))

(defn lwae-stance-valid? (world stance)
    (if (eq (lwae-stance? stance) 0) 0
        (do
            (let question (lwae-stance-question stance))
            (if (and (eq (lwae-question-steady? world question) 1)
                     (and (eq (oac-valid-ack?
                                  (lwae-stance-ack stance)) 1)
                          (and (eq (lwae-time-observation-valid?
                                       (lwae-stance-time stance)) 1)
                               (and (eq (lwae-stance-time-coherent?
                                            stance) 1)
                                    (and (eq (lwae-stance-reference-coherent?
                                                 stance) 1)
                                         (and (eq
                                                (lwae-optional-declaration-valid?
                                                  (lwae-stance-declaration
                                                    stance)) 1)
                                              (and (eq (lwo-category?
                                                        (lwae-stance-alternatives
                                                          stance) LWO-FIELD) 1)
                                                   (lwac-optional-unknown-valid?
                                                    (lwae-stance-unknown
                                                      stance))))))))) 1 0))))

(defn lwae-stance-immediate-nothing? (stance)
    (if (and (eq (oac-nothing? (lwae-stance-ack stance)) 1)
             (node_eq (lwae-stance-time stance) (lwo-none))) 1 0))
(defn lwae-stance-time-pending? (stance)
    (oac-time-pending? (lwae-stance-time stance)))
(defn lwae-stance-timed? (stance)
    (oac-time-outcome? (lwae-stance-time stance)))
(defn lwae-stance-expired-to-nothing? (stance)
    (if (and (eq (lwae-stance-timed? stance) 1)
             (eq (oac-nothing? (lwae-stance-ack stance)) 1)) 1 0))
(defn lwae-stance-alternative? (stance)
    (oac-alternative-ack? (lwae-stance-ack stance)))

(defn lwae-valid-attributions-items
    (world items question acc)
    (if (eq (len items) 0) acc
        (do
            (let attribution (head items))
            (let source (lwo-attribution-source attribution))
            (lwae-valid-attributions-items world (tail items) question
                (if (eq (lwo-active-by? world question source) 1)
                    (lwo-field-add acc attribution) acc)))))

(defn lwae-valid-attributions (world stance)
    (lwae-valid-attributions-items world
        (lwo-field-items (lwo-active-attributions-for world stance))
        (lwae-stance-question stance) (lwo-empty-field)))

; Evidence preserves every active participant-owned stance. It does not rank,
; merge, resolve, or apply any of them.
(defn lwae-stance-evidence-cell (stance attributions)
    (intern_node LWAE-STANCE-EVIDENCE (list stance attributions)))
(defn lwae-stance-evidence-stance (evidence)
    (nth (node_children evidence) 0))
(defn lwae-stance-evidence-attributions (evidence)
    (nth (node_children evidence) 1))

(defn lwae-stance-evidence-items (world items question acc)
    (if (eq (len items) 0) acc
        (do
            (let stance (head items))
            (if (and (eq (lwae-stance-valid? world stance) 1)
                     (and (node_eq (lwae-stance-question stance) question)
                          (eq (lwo-active? world stance) 1)))
                (do
                    (let attributions
                        (lwae-valid-attributions world stance))
                    (lwae-stance-evidence-items world (tail items)
                        question
                        (if (eq (lwo-field-size attributions) 0) acc
                            (lwo-field-add acc
                                (lwae-stance-evidence-cell
                                    stance attributions)))))
                (lwae-stance-evidence-items world (tail items)
                    question acc)))))

(defn lwae-stance-evidence-for (world question)
    (if (eq (lwae-question-steady? world question) 0) (lwo-empty-field)
        (lwae-stance-evidence-items world
            (lwo-field-items (lwo-world-cells world)) question
            (lwo-empty-field))))

0
