; form-cli-embody-census-run.fk — print the one picture of what is embodied.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-embody-census-xtal.fk

(do
    (print_str (str_concat "fem mills=" (str_concat (int_to_str (len (fem-mills))) "\n")))
    (print_str (str_concat "fem knowledge-n=" (str_concat (int_to_str (KnowledgeN)) "\n")))
    (print_str (str_concat "fem universe-n=" (str_concat (int_to_str (UniverseN)) "\n")))
    (print_str (str_concat "fem unique-n=" (str_concat (int_to_str (UniqueN)) "\n")))
    (print_str (str_concat "fem domain-n=" (str_concat (int_to_str (DomainN)) "\n")))
    (print_str (str_concat "fem organ-n=" (str_concat (int_to_str (OrganN)) "\n")))
    (print_str (str_concat "fem lane-n=" (str_concat (int_to_str (LaneN)) "\n")))
    (print_str (str_concat "fem lens-n=" (str_concat (int_to_str (LensN)) "\n")))
    (print_str (str_concat "fem planner-n=" (str_concat (int_to_str (PlannerN)) "\n")))
    (print_str (str_concat "fem proof-n=" (str_concat (int_to_str (fem-proof-n)) "\n")))
    (print_str (str_concat "fem organs=" (str_concat (int_to_str (fem-organs)) "\n")))
    (print_str (str_concat "fem lane-kinds=" (str_concat (int_to_str (fem-lane-kinds)) "\n")))
    (print_str (str_concat "fem body-n=" (str_concat (int_to_str (fem-body-n)) "\n")))
    (print_str (str_concat "fem corpus-n=" (str_concat (int_to_str (CorpusN)) "\n")))
    (print_str (str_concat "fem overlay-pairs=" (str_concat (int_to_str (OverlayPairs)) "\n")))
    (print_str (str_concat "fem session-ppm=" (str_concat (int_to_str (SessionPpm)) "\n")))
    (print_str (str_concat "fem need-events=" (str_concat (int_to_str (NeedEvents)) "\n")))
    (print_str (str_concat "fem fqt-lora=" (str_concat (int_to_str (fqt-lora?)) "\n")))
    (print_str (str_concat "fem fqt-n=" (str_concat (int_to_str (fqt-n)) "\n")))
    (print_str (str_concat "fem check=" (str_concat (int_to_str (fem-check)) "\n")))
    0)
