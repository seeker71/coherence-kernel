  }
  def nsm-prediction(home,skill,prompt,adapter,verified,tokens) {
   let record = json-node-object(list(nsm-s("skill",skill),nsm-s("adapter",adapter),nsm-n("verified",verified),nsm-n("generated_tokens",tokens),nsm-n("observed_at_ms",now_unix_ms())));
