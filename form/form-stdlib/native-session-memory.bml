  }
  def nsm-session-close(home,id,turns,started) {
   // Session timing is continuity evidence. Actual learn/code/heal outcomes
   // supply their own task and observed result to the training queue.
   turns <= 0 ? "no-experience" : nsm-experience(home,id,"session-close","form-cli-session","","","session-completed",json-emit(json-node-object(list(nsm-n("commands_completed",turns),nsm-n("elapsed_ms",host_monotonic_ms() - started)))),0);
  }
 }
 0;
}
