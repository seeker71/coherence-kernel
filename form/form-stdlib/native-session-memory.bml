  def nsm-row(prompt,completion) = json-node-object(list(nsm-s("prompt",prompt),nsm-s("completion",completion)));
  def nsm-state(home) = nsm-json(nsm-at(home,"state.json"));
  def nsm-has(xs,item) = nil?(xs) ? 0 : (((String) head(xs) == item) || nsm-has(tail(xs),item));
  def nsm-strings(nodes) = nil?(nodes) ? list() : cons(node_value(head(nodes)),nsm-strings(tail(nodes)));
  def nsm-string-nodes(xs) = nil?(xs) ? list() : cons(json-node-string(head(xs)),nsm-string-nodes(tail(xs)));
