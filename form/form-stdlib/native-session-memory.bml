  def nsm-session-close(home,id,turns,started) {
   if le(turns,0) then "no-experience" else nsm-offer(home,id,"session-close","form-cli-session","","","session-completed",json-emit(json-node-object(list(nsm-n("commands_completed",turns),nsm-n("elapsed_ms",sub(host_monotonic_ms(),started))))),0);
  }
 }
 0;
}
