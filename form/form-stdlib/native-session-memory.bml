  def nsm-wait-current(home,pid,rc) = (rc > 0) && ((pid > 0) && (((String) int_to_str(pid) == trim(nsm-text(nsm-at(home,"worker.pid")))) && ((!nsm-running(home)) && (file_size(nsm-at(home,"worker.rc")) <= 0))));
  def nsm-wait-record(home) = nsm-json(nsm-at(home,"worker.wait.json"));
  def nsm-wait-admitted(home) = file_size(nsm-at(home,"worker.rc")) > 0 ? json-node-null() : nsm-wait-admitted-record(home,nsm-wait-record(home));
  def nsm-wait-admitted-record(home,record) = nsm-wait-record-known(home,record) ? record : json-node-null();
  def nsm-wait-worker-state(record) = nsm-num(record,"wait_exit") > 0 ? "failed-supervisor-exit-" ++ int_to_str(nsm-num(record,"wait_exit")) : "idle-or-interrupted;inspect-events";
  def nsm-wait-record-known(home,record) = ((String) nsm-str(record,"schema") == "native-session-supervisor-wait-v1") && (((Comparable) node_type(json-object-get(record,"worker_pid")) == node_type(json-node-int(0))) && (((Comparable) node_type(json-object-get(record,"wait_exit")) == node_type(json-node-int(0))) && ((nsm-num(record,"worker_pid") > 0) && ((nsm-num(record,"wait_exit") > 0) && ((String) int_to_str(nsm-num(record,"worker_pid")) == trim(nsm-text(nsm-at(home,"worker.pid"))))))));
  def nsm-wait-status(home,status) = nsm-running(home) ? status : nsm-wait-status-record(status,nsm-wait-admitted(home));
  def nsm-wait-status-record(status,record) = nsm-num(record,"wait_exit") > 0 ? nsm-wait-status-failed(status,record) : status;
  def nsm-wait-status-failed(status,record) = oh-set(oh-set(oh-set(status,"worker_stderr",json-node-string(nsm-str(record,"stderr"))),"worker_stderr_state",json-node-string(nsm-str(record,"stderr_state"))),"supervisor_wait_exit",json-node-int(nsm-num(record,"wait_exit")));
  def nsm-wait-capture(home,pid) {
   let source = nsm-at(home,"worker.err"); let size = file_size(source);
   size < 0 ? json-node-object(list(nsm-s("stderr",source),nsm-s("stderr_state","absent"),nsm-n("stderr_bytes",size))) : nsm-wait-capture-read(home,pid,source,size,read_file(source));
  }
  def nsm-wait-capture-read(home,pid,source,size,text) {
   nothing?(text) || (((Comparable) str_len(text) != size) || ((Comparable) file_size(source) != size)) ? json-node-object(list(nsm-s("stderr",source),nsm-s("stderr_state","unreadable-or-changed"),nsm-n("stderr_bytes",size))) : nsm-wait-capture-write(home,pid,source,text);
  }
  def nsm-wait-capture-write(home,pid,source,text) {
   let path = nsm-at(home,"worker-failure-" ++ int_to_str(pid) ++ "-" ++ nsm-id() ++ ".err");
   let written = write_file(path,text);
   let exact = ((Comparable) written == str_len(text)) && (((Comparable) file_size(path) == str_len(text)) && ((String) nsm-text(path) == text));
   json-node-object(list(nsm-s("stderr",exact ? path : source),nsm-s("stderr_state",exact ? "retained" : "retention-refused"),nsm-n("stderr_bytes",str_len(text)),nsm-s("retention_path",path)));
  }
  def nsm-wait-retain(home,pid,rc) = !nsm-wait-current(home,pid,rc) ? 0 : nsm-wait-publish(home,pid,rc,nsm-wait-capture(home,pid));
  def nsm-wait-publish(home,pid,rc,captured) {
   !nsm-wait-current(home,pid,rc) ? 0 : nsm-wait-publish-current(home,pid,rc,captured);
  }
  def nsm-wait-publish-current(home,pid,rc,captured) {
   let record = json-node-object(append(list(nsm-s("schema","native-session-supervisor-wait-v1"),nsm-n("worker_pid",pid),nsm-n("observer_pid",host_pid()),nsm-n("wait_exit",rc),nsm-n("observed_at_ms",now_unix_ms())),json-object-pairs(captured)));
   let path = nsm-at(home,"worker.wait.json");
   let reading = oh-reading("session-learning",home,"supervisor-exit-publication",json-node-int(0),json-node-int(rc),json-node-int(0),list(oh-need("supervisor-completion",oh-reference(nsm-str(record,"stderr")))),list("retain-pending","defer"),record);
   let observed = nsm-event(home,"organ-health",list(json-node-pair("health",reading)));
