   current;
  }
  def nsm-settle-exit(status) = ((Comparable) str_find(nsm-str(status,"worker_status"),"failed-",0) == 0) && (nsm-num(status,"pending") > 0) ? form_error("session learner failed; retained examples stay pending; worker_stderr names the cause") : 0;
  def nsm-teach(home,raw) {
   let doc = parse-json("session-teaching",raw); let session = nsm-str(doc,"session");
   let key = nsm-str(doc,"event");
