  def nsm-id() = int_to_str(now_unix_ms()) ++ "-" ++ int_to_str(host_pid()) ++ "-" ++ int_to_str(host_monotonic_ms());
  def nsm-enabled(home) = !((String) trim(nsm-text(nsm-at(home,"paused"))) == "1");
  def nsm-event(home,stage,fields) {
