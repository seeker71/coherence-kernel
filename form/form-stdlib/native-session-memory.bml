  }
  def nsm-command(arg) = nsm-command-at(hearth-session-learning(),arg);
  def nsm-command-at(home,arg) {
   (String) arg == "status" ? json-emit-precise(nsm-status(home))
   : (String) arg == "pause" ? nsm-pause(home,1)
   : (String) arg == "resume" ? nsm-pause(home,0)
   : (String) arg == "drain" ? json-emit-precise(nsm-settle(home))
