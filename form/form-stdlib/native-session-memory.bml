   if lt(size,0) then json-node-object(list(nsm-s("stderr",source),nsm-s("stderr_state","absent"),nsm-n("stderr_bytes",size))) else nsm-wait-capture-read(home,pid,source,size,read_file(source));
  }
  def nsm-wait-capture-read(home,pid,source,size,text) {
   if or(nothing?(text),or(ne(str_len(text),size),ne(file_size(source),size))) then json-node-object(list(nsm-s("stderr",source),nsm-s("stderr_state","unreadable-or-changed"),nsm-n("stderr_bytes",size))) else nsm-wait-capture-write(home,pid,source,text);
  }
  def nsm-wait-capture-write(home,pid,source,text) {
   let path = nsm-at(home,str_concat("worker-failure-",str_concat(int_to_str(pid),str_concat("-",str_concat(nsm-id(),".err")))));
   let written = write_file(path,text);
