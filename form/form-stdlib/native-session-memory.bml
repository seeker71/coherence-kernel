   !((Comparable) fs-rename(stage,path) == 0) ? form_error("session learning atomic publication failed") : obj;
  }
  def nsm-init(home) {
   let parent = fs-mkdir(fs-path-dirname(home)); let root = fs-mkdir(home);
   let chmod = host_spawn_at(list("/bin/chmod","700",home),list("/dev/null","/dev/null","/dev/null"));
   let protected = chmod > 0 ? host_wait(chmod) : -1;
   let rows = fs-mkdir(nsm-at(home,"rows"));
   let declaration = (Comparable) protected == 0 ? ohd-register(host_cwd(),nsm-at(home,"events.jsonl"),list("organ-health-v1","retained-session-experience","local-learning-status",ohd-shared-append-capability())) : nothing();
   let notice = ((Comparable) protected == 0) && ((Comparable) ohd-num(declaration,"ok") == 0) ? nsm-event(home,"health-discovery-refused",list(json-node-pair("health",oh-reading("session-learning",home,"health-discovery",json-node-string("advertised event-source reference"),declaration,json-node-int(0),list(oh-need("health-source-discovery",declaration)),list("request-evidence","defer"),oh-reference(nsm-at(home,"events.jsonl")))))) : 0;
   (Comparable) protected == 0 ? home : form_error("private session directory unavailable");
