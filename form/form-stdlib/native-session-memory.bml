// Session experience stays private in the hearth. Immutable examples and one
// serialized learner retain evidence, candidate generations and serving choices.
// This client has no model admission: recording and kicking a worker are cheap.
// preludes: form-stdlib/hearth.bml form-stdlib/native-adapter-generation.bml form-stdlib/json-precise.bml form-stdlib/sha256.fk form-stdlib/model-registry.bml form-stdlib/organ-health.bml form-stdlib/metal-carrier.bml form-stdlib/bml/organ-health-discovery.bml
section [form.bml] {
 class NativeSessionMemory {
  // Session data belongs to this home. Absolute paths keep a missing local
  // worker/state file from being resolved through an ancestor's source tree.
  def nsm-at(root,leaf) = ((Comparable) str_find(root,"/",0) == 0 ? root : host_cwd() ++ "/" ++ root) ++ "/" ++ leaf;
  def nsm-text(path) = file_size(path) <= 0 ? "" : read_file(path);
  def nsm-json(path) = file_size(path) <= 0 ? json-node-object(list()) : parse-json("session-learning",read_file(path));
  def nsm-get(obj,key) = node_value(json-object-get(obj,key));
  def nsm-str(obj,key) = (Comparable) node_type(json-object-get(obj,key)) == 2 ? nsm-get(obj,key) : "";
  def nsm-num(obj,key) = json-object-has?(obj,key) ? nsm-get(obj,key) : 0;
  def nsm-s(key,value) = json-node-pair(key,json-node-string(value));
  def nsm-n(key,value) = json-node-pair(key,json-node-int(value));
  def nsm-real(key,value) = json-node-pair(key,json-precise-float(value));
  def nsm-hex(bytes) = nil?(bytes) ? "" : (json-hex-digit(head(bytes) / 16) ++ json-hex-digit(head(bytes) % 16)) ++ nsm-hex(tail(bytes));
  def nsm-hash(text) = nsm-hex(sha256-stream-string(text));
  def nsm-write(path,obj) = nag-write(path,json-emit-precise(obj) ++ "\n");
  def nsm-atomic(path,obj) {
