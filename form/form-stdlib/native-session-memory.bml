  }
  def nsm-running(home) = ((Comparable) host_alive(str_to_int(trim(nsm-text(nsm-at(home,"maintenance.pid"))))) == 1) || (((Comparable) host_alive(str_to_int(trim(nsm-text(nsm-at(home,"worker.pid"))))) == 1) || ((Comparable) host_alive(str_to_int(trim(nsm-text(nsm-at(home,"learner.pid"))))) == 1));
  def nsm-lock(home) {
   let lock = nsm-at(home,"worker.lock");
