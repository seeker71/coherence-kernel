   : (Comparable) str_find(arg,"ask|",0) == 0 ? json-emit-precise(nsm-model-proposal(home,substring(arg,4,str_len(arg)),0))
   : "session status|pause|resume|drain; session learn|{prompt,completion,session?,event?} retains an explicit local correction and starts native LoRA learning. session ask|question uses the evaluated session adapter, or the seed when no adapter has been promoted. Progress, choices and actual tokens remain under the private hearth. Every attempt is retained as experience; assessment targets stay outside their gradient.";
  }
  def nsm-teach-report(result) = json-emit(json-node-object(list(nsm-s("example",head(result)),nsm-s("worker",result[1]),nsm-s("training_state","retained;inspect-session-status-for-observed-update"))));
  def nsm-pause(home,paused) {
