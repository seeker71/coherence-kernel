  def nsm-settle-exit(status) = if and(eq(str_find(nsm-str(status,"worker_status"),"failed-",0),0),gt(nsm-num(status,"pending"),0)) then form_error("session learner failed; retained examples stay pending; worker_stderr names the cause") else 0;
  def nsm-teach(home,raw) {
   let doc = parse-json("session-teaching",raw); let session = nsm-str(doc,"session");
