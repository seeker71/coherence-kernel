   json-node-object(list(nsm-s("stderr",if exact then path else source),nsm-s("stderr_state",if exact then "retained" else "retention-refused"),nsm-n("stderr_bytes",str_len(text)),nsm-s("retention_path",path)));
  }
  def nsm-wait-retain(home,pid,rc) = if not(nsm-wait-current(home,pid,rc)) then 0 else nsm-wait-publish(home,pid,rc,nsm-wait-capture(home,pid));
  def nsm-wait-publish(home,pid,rc,captured) {
   if not(nsm-wait-current(home,pid,rc)) then 0 else nsm-wait-publish-current(home,pid,rc,captured);
  }
  def nsm-wait-publish-current(home,pid,rc,captured) {
   let record = json-node-object(append(list(nsm-s("schema","native-session-supervisor-wait-v1"),nsm-n("worker_pid",pid),nsm-n("observer_pid",host_pid()),nsm-n("wait_exit",rc),nsm-n("observed_at_ms",now_unix_ms())),json-object-pairs(captured)));
   let path = nsm-at(home,"worker.wait.json");
   let reading = oh-reading("session-learning",home,"supervisor-exit-publication",json-node-int(0),json-node-int(rc),json-node-int(0),list(oh-need("supervisor-completion",oh-reference(nsm-str(record,"stderr")))),list("retain-pending","defer"),record);
   let observed = nsm-event(home,"organ-health",list(json-node-pair("health",reading)));
   let response = oh-response(reading,"retain-pending");
   let responded = nsm-event(home,"organ-response",list(json-node-pair("health",response)));
   let selected = oh-select(reading,response,"defer");
   let current = nsm-wait-current(home,pid,rc);
   let saved = if current then nsm-atomic(path,record) else json-node-null();
   let applied = nsm-event(home,"organ-action-observed",list(json-node-pair("health",oh-applied(reading,selected,json-node-object(list(nsm-s("terminal_record",path),nsm-n("published",current),nsm-n("wait_exit",rc),nsm-n("pending",len(nsm-pending(home,nsm-dirs(home)))),nsm-s("pending_action","preserved"),nsm-s("stderr_state",nsm-str(captured,"stderr_state"))))))));
