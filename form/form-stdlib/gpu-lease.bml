//////////////////////////////////////////////////////////////////////
// gpu-lease.bml — one Metal client at a time, and a lock that knows who holds it.
//
// Two Metal clients at once wedge the GPU wait (the process sits in an uninterruptible state at 0% CPU until
// kill -9). The first guard was a bare directory, `mkdir` to take and `rmdir` to give back. It had no owner: any
// client could remove another's lock, a run that died left it standing, and a waiter could not tell a live
// holder from a dead one. A lease has an owner and can be judged.
//
//   THE LEASE      the directory `/tmp/form-gpu.lock` -- one path for the whole machine, because the GPU is shared by
//                  every checkout and session -- holding one file, `owner`: pid, the process's start time, when it
//                  took the lease, the last heartbeat, a label, and a token no other lease shares. mkdir is
//                  still the atomic act; the record is staged and renamed in, so a reader sees all of it or none.
//   JUDGING        a held lease is LIVE while its pid answers and is the same process (host_process's start time
//                  matches the record's: a reused pid is another process). It is DEAD when the pid is gone or reused.
//                  A directory with no readable record is UNOWNED (a shell client, or a client between mkdir and
//                  its record). Unowned is waited on for a bound, and only then judged stale -- and only if no
//                  Metal-using fkwu of any checkout is alive (see gpl-markers).
//   TAKING OVER    a dead lease is renamed to a tombstone named by its own token (`<lock>.gone/<token>`); a
//                  rename onto a standing, non-empty tombstone fails, so of any number of clients that judged the
//                  same lease dead exactly one wins. The winner reads the tombstone back to be sure it moved the
//                  lease it judged (an unowned directory is named by its mtime), puts a wrong one back, then
//                  makes the lock afresh and records itself. The answer says so.
//   GIVING BACK    only the holder: the record's token and pid must be mine, else nothing is removed.
//
// Answers are data, never a bare number:
//   take     ["held" token]   ["waited" ms token]   ["took-over-stale" prev token]   ["refused" reason ...]
//   release  ["released" token]   ["refused" "not-yours" holder-token]   ["refused" "no-lease"]
//   renew    ["renewed" token]    (or the same refusals)
// A refusal is the lease meeting a state it will not step past: it ends the take with its finding, and the
// caller (a door) ends aloud with "not run". A take that cannot record its owner undoes its mkdir first.
//////////////////////////////////////////////////////////////////////
import form/form-stdlib/core.fk;
import form/form-stdlib/bml/native-posix.bml;
import form/form-stdlib/bml/native-owner-clock.bml;
section [form.bml] {
  // Synchronous intent follows this call and restores on every exit. The
  // queue remains shared; an interactive ticket receives a bounded head start.
  let GPL-INTENT = record_new(0,"interactive",0);
   let GPL-CLAIMS = record_new(0,"owners",record_new(0));
   // the tickets this image opened and has not closed: a ticket of this pid that is not here is a cell's, left by a deadline that bypassed defer
   let GPL-TICKETS = record_new(0);
  def gpu-lease-interactive?() = record_get(GPL-INTENT,"interactive") == 1;
  def gpu-lease-with-interactive(run) {
   let saved=record_get(GPL-INTENT,"interactive");
   let held=record_set(GPL-INTENT,"interactive",1);
   defer record_set(GPL-INTENT,"interactive",saved);
   run();
  }
  def gpl-order-stamp(stamp) = max2(0,stamp - (gpu-lease-interactive?() ? 500 : 0));
  // ONE path for the whole machine: the GPU is shared by every checkout and every session, so the lease is too
  // (a relative path gave each checkout its own lock, and two checkouts never excluded each other)
  def gpu-lease-path() = "/tmp/form-gpu.lock";
  def gpl-magic() = "gpu-lease-v1";
  def gpl-nl() = byte_to_str(10);
  def gpl-wait-ms() = nothing();
  def gpl-poll-ms() = 1000;
  def gpl-unowned-ms() = 60000;
  def gpl-keep-ms() = 3600000;
  def gpl-owner-file(lock) = lock ++ "/owner";
  def gpl-lent-file(lock) = lock ++ "/lent";
  def gpl-stage-file(lock) = lock ++ "/owner.new";
  def gpl-gone-dir(lock) = lock ++ ".gone";
  def gpl-wait-dir(lock) = lock ++ ".wait";
  def gpl-int(x) = (String) value_kind(x) == "int" ? x : 0;

  // ---- who I am: the pid and the start time that tells one process from the next holder of that pid ----
  def gpl-start-of(pid) {
   let row = host_process(pid);
   (String) value_kind(row) == "list" ? row[5] : nothing();
  }
  def gpl-me-start() = gpl-int(gpl-start-of(host_pid()));
   def gpl-token() = noc-open();

  // ---- the owner record: staged, then renamed over, so it is whole or absent ----
  def gpl-record(token, label, acquired, beat) = gpl-magic() ++ gpl-nl() ++ token ++ gpl-nl() ++ host_pid().str() ++ gpl-nl() ++ gpl-me-start().str() ++ gpl-nl() ++ acquired.str() ++ gpl-nl() ++ beat.str() ++ gpl-nl() ++ label;
  def gpl-publish(lock, token, label, acquired) {
   let w = write_file(gpl-stage-file(lock), gpl-record(token, label, acquired, now_unix_ms()));
   (w < 0) ? w : host_path_rename(gpl-stage-file(lock), gpl-owner-file(lock));
  }
  def gpl-lines(s) = (Comparable) len(s) == 0 ? [] : gpl-lines-at(s, 0);
  def gpl-lines-at(s, from) {
   let i = str_find(s, gpl-nl(), from);
   (i < 0) ? [substring(s, from, len(s))] : cons(substring(s, from, i), gpl-lines-at(s, i + 1));
  }
  def gpl-num(s) {
   let n = str_to_int(s);
   (String) n.str() == s ? n : nothing();
  }
  // ["rec" token pid start acquired beat label lent] | ["none"] no record | ["garbage"] a record that does not read; lent is the
  // token the holder lent to the cell it runs as its child (gpu-lease-lend), "" when it lent none
  def gpl-read(lock) {
   let t = read_file(gpl-owner-file(lock));
   nothing?(t) ? ["none"] : gpl-lent-of(gpl-parse(gpl-lines(t)), read_file(gpl-lent-file(lock)));
  }
  def gpl-lent-of(r, lent) = (String) r[0] != "rec" ? r : append(r, [nothing?(lent) ? "" : lent]);
  def gpl-parse(ls) = len(ls) < 7 ? ["garbage"] : ((String) ls[0] != gpl-magic() ? ["garbage"] : gpl-parse-nums(ls, gpl-num(ls[2]), gpl-num(ls[3]), gpl-num(ls[4]), gpl-num(ls[5])));
  def gpl-parse-nums(ls, pid, start, acq, beat) = (nothing?(pid) || (nothing?(start) || (nothing?(acq) || nothing?(beat)))) ? ["garbage"] : ["rec", ls[1], pid, start, acq, beat, ls[6]];

  // ---- judging a held lease ----
  // the pid answers and is the process that took the lease (a start time of 0 is a host that would not say)
  def gpl-same-process?(pid, start) = gpl-same-start?(gpl-start-of(pid), start);
  def gpl-same-start?(now, start) = nothing?(now) || start<=0 || now<=0 ? nothing() : now==start;
  // a lease lent to this process: its holder is this process's parent, the same process by its start time, and the lend names
  // the lease's own token (gpu-lease-lend)
  def gpl-parent() = gpl-parent-of(host_process(host_pid()));
  def gpl-parent-of(row) = (String) value_kind(row) == "list" ? row[1] : 0;
  def gpl-lent-here?(r) = len(r) > 7 && (String) r[7] == r[1] && r[2] == gpl-parent() && (Comparable) gpl-same-process?(r[2], r[3]) == 1;
  // ["absent"] | ["live" rec] | ["dead" rec why] | ["unknown" rec why] | ["unowned" why]
  def gpl-judge(lock) = (Comparable) host_path_exists(lock) == 1 ? gpl-judge-rec(gpl-read(lock)) : ["absent"];
  def gpl-judge-rec(r) = (String) r[0] == "rec" ? gpl-judge-owner(r) : ["unowned", r[0]];
  def gpl-judge-owner(r) {
   let alive=host_alive(r[2]); let same=gpl-same-process?(r[2],r[3]);
   alive==0 ? ["dead",r,"pid-gone"] : same==0 ? ["dead",r,"pid-reused"] : nothing?(alive) || nothing?(same) ? ["unknown",r,"process-observation-unavailable"] : ["live",r];
  }

  // ---- an unowned directory: is a Metal client of this checkout alive? ----
  // The host cannot say who has the device open, so this is read from the process table: an fkwu of ANY
  // checkout (the lease is machine-wide), other than me and my parents, not itself waiting on this lease, whose command line names
  // one of this lane's Metal doors. Conservative on purpose: a false peer only delays a takeover to the deadline.
  def gpl-markers() = ["voice-", "g2p", "torch-bin", "safetensors", "native-t5", "metal", "lora", "gpu"];
  def gpl-argv-text(argv) = nil?(argv) ? "" : argv[0] ++ " " ++ gpl-argv-text(argv[1:]);
  def gpl-marked?(text, ms) = nil?(ms) ? 0 : (str_find(text, ms[0], 0) >= 0 ? 1 : gpl-marked?(text, ms[1:]));
  def gpl-in?(x, xs) = nil?(xs) ? 0 : ((Comparable) xs[0] == x ? 1 : gpl-in?(x, xs[1:]));
  def gpl-ancestors(pid, depth) = gpl-ancestors-of(host_process(pid), depth);
  def gpl-ancestors-of(row, depth) = ((depth <= 0) || ((String) value_kind(row) != "list")) ? [] : cons(row[1], gpl-ancestors(row[1], depth - 1));
  def gpl-waiting?(lock, pid, start) = gpl-waiting-text?(read_file(gpl-wait-dir(lock) ++ "/" ++ pid.str()), start);
  def gpl-waiting-text?(t, start) = nothing?(t) || len(t) == 0 ? 0 : ((Comparable) gpl-int(str_to_int(gpl-lines(t)[0])) == start ? 1 : 0);
  def gpl-peer?(lock, ms, pid, cwd, kin) = gpl-peer-row?(lock, ms, pid, cwd, kin, host_process(pid));
  def gpl-peer-row?(lock, ms, pid, cwd, kin, row) = (String) value_kind(row) != "list" ? nothing() : ((Comparable) gpl-in?(pid, kin) == 1 ? 0 : ((Comparable) gpl-marked?(gpl-argv-text(row[4]), ms) == 0 ? 0 : ((Comparable) gpl-waiting?(lock, pid, row[5]) == 1 ? 0 : 1)));
  def gpl-peers(lock, ms) = gpl-peers-of(lock, ms, host_processes("fkwu"), host_cwd(), cons(host_pid(), gpl-ancestors(host_pid(), 16)));
  def gpl-peers-of(lock, ms, rows, cwd, kin) {
   if nothing?(rows) then nothing() else if nil?(rows) then [] else {
    let peer=gpl-peer?(lock,ms,rows[0][0],cwd,kin); let rest=gpl-peers-of(lock,ms,rows[1:],cwd,kin);
    nothing?(peer) || nothing?(rest) ? nothing() : peer==1 ? cons(rows[0][0],rest) : rest;
   };
  }

  // ---- taking ----
  // c is the take in flight: [lock label opts t0]; opts is [wait-ms poll-ms unowned-ms markers].
  // An absent wait follows the owned queue; zero permits one immediate attempt.
  def gpl-wait-valid(wait) = nothing?(wait) || (value_kind(wait)=="int" && wait>=0);
  def gpu-lease-take(lock, label, wait-ms) = gpu-lease-take-with(lock, label, [wait-ms, gpl-poll-ms(), gpl-unowned-ms(), gpl-markers()]);
   def gpu-lease-take-with(lock,label,opts) = gpu-lease-take-retaining(lock,label,opts,nothing());
   def gpu-lease-take-retaining(lock, label, opts,retain) = !gpl-wait-valid(opts[0]) ? ["refused","invalid-wait-allowance",opts[0]] : {
   let t0 = host_monotonic_ms();
   let ticket=gpl-ticket-open(lock);
   if nothing?(ticket) then ["refused","cannot-make-lock",lock] else {
    defer gpl-ticket-close(lock,ticket);
    let queued = gpl-enqueue(lock, gpl-order-stamp(t0));
    let owner = gpl-read(lock);
     (String) owner[0] == "rec" && owner[2] == host_pid() && gpl-inheritable?(owner) ? ["refused","already-held-by-this-process",owner[1]] : queued < 0 ? ["refused", "cannot-make-lock",lock] : gpl-go([lock, label, opts, t0,retain], 0);
   };
  };
  def gpl-ticket-path(lock) = gpl-wait-dir(lock) ++ "/" ++ host_pid().str();
   def gpl-ticket-lock(fd) = nps-file-try-exclusive(fd);
  // The managed descriptor closes even when a cell deadline bypasses Form
  // defer. Its leftover ticket is then inert while the process remains alive.
  def gpl-ticket-open(lock) {
   let made=host_dir_mkdir(gpl-wait-dir(lock)); let ticket=nps-file-open(gpl-ticket-path(lock),1);
   if value_kind(ticket)!="list" then nothing() else if gpl-ticket-lock(ticket[1])==0 then { record_set(GPL-TICKETS,gpl-ticket-path(lock),1); ticket; } else { nps-file-settle(ticket); nothing(); };
  }
  def gpl-ticket-close(lock,ticket) {
   let unregistered=record_set(GPL-TICKETS,gpl-ticket-path(lock),0);
   let removed=host_path_remove(gpl-ticket-path(lock));
   nps-file-settle(ticket);
  }
  def gpl-ticket-live(path,lines) = len(lines)<3 || lines[2]!="scoped-v1" ? 1 : {
   let probe=nps-file-open(path,0);
   if value_kind(probe)!="list" then nothing() else {
    defer nps-file-settle(probe);
    let locked=gpl-ticket-lock(probe[1]);
    locked==0 ? 0 : locked==-11 ? 1 : nothing();
   };
  };
  // Line two is the queue-order clock. Ordinary turns remain FIFO; interactive
  // intent moves that clock back by at most 500 ms. A waiting ordinary ticket
  // therefore ages ahead of newly arriving interactive tickets. The unchanged
  // two-line format and comparison also work with existing FIFO clients.
  def gpl-enqueue(lock, stamp) {
   let made = host_dir_mkdir(gpl-wait-dir(lock));
   write_file(gpl-ticket-path(lock), gpl-me-start().str() ++ gpl-nl() ++ stamp.str() ++ gpl-nl() ++ "scoped-v1");
  }
  def gpl-wait-row(lock, name) {
   let pid = gpl-int(str_to_int(name));
   let text = read_file(gpl-wait-dir(lock) ++ "/" ++ name);
   let lines = nothing?(text) ? [] : gpl-lines(text);
   let start = nil?(lines) ? 0 : gpl-int(str_to_int(lines[0]));
   // a ticket of this very pid that this image never opened (or closed) is a cell's, left behind by a deadline that bypassed defer: its descriptor
   // belongs to a run that is over, so the lock it holds says nothing about a waiter; the file goes, and no other client queues behind it
   let own = pid == host_pid();
   let path = gpl-wait-dir(lock) ++ "/" ++ name;
   let leftover = own && start > 0 && (Comparable) record_get(GPL-TICKETS, path) != 1;
   let swept = leftover ? host_path_remove(path) : 0;
   let retained = !leftover && pid > 0 && start > 0 && host_alive(pid) != 0 && gpl-same-process?(pid,start) != 0 && gpl-ticket-live(path,lines) != 0;
   !retained ? [] : [pid,start,len(lines) > 1 ? gpl-int(str_to_int(lines[1])) : 0];
  }
  def gpl-before?(a,b) = a[2] < b[2] || (a[2] == b[2] && a[0] < b[0]);
  def gpl-first?(lock) {
   let mine = gpl-wait-row(lock,host_pid().str());
   let rows = map(name => gpl-wait-row(lock,name), host_dir_list(gpl-wait-dir(lock)) ?? []);
   !nil?(mine) && !any?(row => !nil?(row) && gpl-before?(row,mine),rows);
  }
   def gpl-go(c, slept) = !gpl-first?(c[0]) ? gpl-wait(c,slept,["queued"]) : host_path_exists(c[0])==0 ? gpl-claim(c,slept,nothing()) : gpl-meet(c,slept,gpl-judge(c[0]));
   def gpl-claim(c,slept,prev) = gpl-claim-observed(c,slept,prev,(phase,claim)=>0);
   def gpl-claim-observed(c, slept, prev, observe) {
    let token=gpl-token();let stage=c[0] ++ ".claim-" ++ token;
    let claim=record_new(0,"token",token,"lock",c[0],"stage",stage,"phase","preparing");
    record_set(record_get(GPL-CLAIMS,"owners"),token,claim);
    if len(c)>4 && value_kind(c[4])=="closure" then (c[4])(["preparing",token,claim]) else 0;
    host_dir_mkdir(stage) != 1 ? {gpl-claim-abandon(claim);["refused","cannot-make-lock",c[0]];} : gpl-publish(stage,token,c[1],now_unix_ms()) != 0 || !gpl-mine?(gpl-read(stage),token) ? {gpl-claim-abandon(claim);["refused","owner-record-not-written",stage];} : {
     record_set(claim,"phase","prepared");
     observe("prepared",claim);
     let published=nps-rename-exclusive(stage,c[0]);
     published==0 && gpl-mine?(gpl-read(c[0]),token) ? {observe("published",claim);record_set(claim,"phase","held");gpl-granted(c,slept,prev,token);} : {
      let released=gpl-claim-abandon(claim);
      released[0] != "released" ? released : host_path_exists(c[0])==0 ? ["refused","cannot-publish-lock",published] : gpl-meet(c,slept,gpl-judge(c[0]));
     };
    };
  }
   def gpl-claim-of(token) {
    record_get(record_get(GPL-CLAIMS,"owners"),token);
   }
   def gpl-claim-retire(claim) {
    record_set(claim,"phase","released");let token=record_get(claim,"token");
    record_set(record_get(GPL-CLAIMS,"owners"),token,record_new(0,"token",token,"lock",record_get(claim,"lock"),"phase","released"));1;
   }
   def gpl-claim-abandon(claim) {
    let stage=record_get(claim,"stage");let token=record_get(claim,"token");let lock=record_get(claim,"lock");
    let phase=record_get(claim,"phase");
    phase=="detached" || phase=="releasing" || phase=="released" || gpl-mine?(gpl-read(lock),token) ? gpu-lease-release(lock,token) : host_path_exists(stage)==0 || host_dir_rmdir(stage)==0 ? {gpl-claim-retire(claim);["released",token];} : ["refused","claim-cleanup-incomplete",token];
  }
  def gpl-granted(c, slept, prev, token) = nothing?(prev) ? ((Comparable) slept == 0 ? ["held", token] : ["waited", host_monotonic_ms() - c[3], token]) : ["took-over-stale", prev, token];

  def gpl-meet(c, slept, j) = (String) j[0] == "absent" ? gpl-absent(c, slept)
   : (String) j[0] == "unknown" ? gpl-wait(c,slept,j)
   : ((String) j[0] == "live" ? gpl-live(c, slept, j[1])
   : ((String) j[0] == "dead" ? gpl-stale(c, slept, j[1][1], j[1][1], ["dead", j[1][1], j[1][2], j[1][6], j[2]])
   : gpl-unowned(c, slept, j[1])));
  // the directory went between my mkdir and my look: once more; if it still cannot be made, it is not a held lease
   def gpl-absent(c, slept) = gpl-claim(c,slept,nothing());
  def gpl-live(c, slept, r) = (Comparable) r[2] == host_pid() ? ["refused", "already-held-by-this-process", r[1]] : gpl-wait(c, slept, ["live", r[1], r[2], r[6]]);
  def gpl-wait-left(c,now) = nothing?(c[2][0]) ? nothing() : max2(0,c[2][0] - (now - c[3]));
  def gpl-wait-ended(c) = !nothing?(c[2][0]) && gpl-wait-left(c,host_monotonic_ms())==0;
  def gpl-wait-refused(owner) = ["refused", owner[0]=="live" || owner[0]=="unowned-with-metal-peers" ? "held-by-live-owner" : owner[0]=="unknown" ? "owner-observation-unavailable" : "lease-wait-ended", owner];
  def gpl-wait(c, slept, owner) = gpl-wait-ended(c) ? gpl-wait-refused(owner) : gpl-wait-again(c, owner);
  def gpl-wait-again(c, owner) {
   let left=gpl-wait-left(c,host_monotonic_ms());
   let s = host_sleep_ms(nothing?(left) ? c[2][1] : min2(c[2][1],left));
   gpl-wait-ended(c) ? gpl-wait-refused(owner) : gpl-go(c, 1);
  }
  // no readable record: wait for the bound (by the directory's own mtime), then take over only with no Metal peer alive
  def gpl-unowned(c, slept, why) = gpl-unowned-aged(c, slept, why, host_file_mtime(c[0]));
  def gpl-unowned-aged(c, slept, why, mtime) = mtime < 0 ? gpl-go(c, slept) : gpl-unowned-judge(c, slept, why, mtime, now_unix_ms() - (mtime * 1000));
  def gpl-unowned-judge(c, slept, why, mtime, age) = age < c[2][2] ? gpl-wait(c, slept, ["unowned", why, age]) : gpl-unowned-peers(c, slept, why, mtime, age, gpl-peers(c[0], c[2][3]));
  def gpl-unowned-peers(c, slept, why, mtime, age, peers) = nothing?(peers) ? gpl-wait(c,slept,["unknown","peer-inspection-unavailable"]) : nil?(peers) ? gpl-stale(c, slept, "unowned-" ++ mtime.str(), nothing(), ["unowned", why, age]) : gpl-wait(c, slept, ["unowned-with-metal-peers", peers]);

  // ---- taking over ----
  // rename the lease to its tombstone; of every client that judged it stale, one rename lands
  def gpl-stale(c, slept, key, expect, prev) {
   let g = host_dir_mkdir(gpl-gone-dir(c[0]));
   let tomb = gpl-gone-dir(c[0]) ++ "/" ++ key;
   (Comparable) host_path_rename(c[0], tomb) == 0 ? gpl-won(c, slept, tomb, expect, prev, gpl-read(tomb)) : gpl-wait(c, slept, ["takeover-lost", key]);
  }
  // expect is the token judged stale, or nothing for an unowned directory (which must still hold no record)
  def gpl-expected?(seen, expect) = nothing?(expect) ? ((String) seen[0] != "rec" ? 1 : 0) : ((String) seen[0] != "rec" ? 0 : ((String) seen[1] == expect ? 1 : 0));
  def gpl-won(c, slept, tomb, expect, prev, seen) = (Comparable) gpl-expected?(seen, expect) == 1 ? gpl-won-ok(c, slept, tomb, prev) : gpl-put-back(c, slept, tomb, seen);
  def gpl-won-ok(c, slept, tomb, prev) {
   let note = write_file(tomb ++ "/gone-at", now_unix_ms().str());
    gpl-swept(c[0],tomb,gpl-claim(c,slept,prev));
  }
  def gpl-swept(lock, keep, ans) {
   let n = gpl-sweep-names(gpl-gone-dir(lock), keep, host_dir_list(gpl-gone-dir(lock)));
   ans;
  }
  // I moved a lease that was not the one I judged (it changed hands in between): give it back where it was
  def gpl-put-back(c, slept, tomb, seen) = (Comparable) host_path_rename(tomb, c[0]) == 0 ? gpl-wait(c, slept, ["put-back", gpl-seen-name(seen)]) : ["refused", "displaced-a-live-lease", tomb];

  def gpl-seen-name(seen) = (String) seen[0] == "rec" ? seen[1] : seen[0];

  // tombstones older than an hour go; a tombstone with no stamp is stamped now and goes on a later sweep
  def gpl-sweep-names(dir, keep, names) = (String) value_kind(names) != "list" ? 0 : (nil?(names) ? 0 : gpl-sweep-more(gpl-sweep-one(dir ++ "/" ++ names[0], keep), dir, keep, names[1:]));
  def gpl-sweep-more(done, dir, keep, rest) = done + gpl-sweep-names(dir, keep, rest);
  def gpl-sweep-one(path, keep) = (String) path == keep ? 0 : gpl-sweep-stamp(path, read_file(path ++ "/gone-at"));
  def gpl-sweep-stamp(path, t) = nothing?(t) ? gpl-sweep-stamp-now(path) : ((now_unix_ms() - gpl-int(str_to_int(t))) > gpl-keep-ms() ? ((Comparable) host_dir_rmdir(path) == 0 ? 1 : 0) : 0);
  def gpl-sweep-stamp-now(path) {
   let w = write_file(path ++ "/gone-at", now_unix_ms().str());
   0;
  }

  // ---- giving back, and the heartbeat: only the holder ----
  def gpu-lease-token(ans) = (String) ans[0] == "held" ? ans[1] : ((String) ans[0] == "waited" ? ans[2] : ((String) ans[0] == "took-over-stale" ? ans[2] : nothing()));
  def gpu-lease-held?(ans) = nothing?(gpu-lease-token(ans)) ? 0 : 1;
  def gpl-mine?(r, token) = (String) r[0] != "rec" ? 0 : ((String) r[1] != token ? 0 : ((Comparable) r[2] == host_pid() ? 1 : 0));
  def gpl-not-mine(r) = (String) r[0] == "rec" ? ["refused", "not-yours", r[1]] : ["refused", "no-lease"];
   def gpu-lease-release(lock, token) {
    let claim=gpl-claim-of(token);let phase=record?(claim) ? record_get(claim,"phase") : "";
    phase=="released" ? ["released",token] : phase=="detached" ? gpl-release-finish(claim,token,record_get(claim,"gone"),path=>host_dir_rmdir(path)) : phase=="releasing" && gpl-mine?(gpl-read(record_get(claim,"gone")),token) ? {record_set(claim,"phase","detached");gpl-release-finish(claim,token,record_get(claim,"gone"),path=>host_dir_rmdir(path));} : gpl-release-of(lock,token,gpl-read(lock));
   }
  def gpl-release-of(lock, token, r) = (Comparable) gpl-mine?(r, token) == 1 ? gpl-release-now(lock, token) : gpl-not-mine(r);
  // Detach the owned directory atomically before recursive cleanup. Another
  // waiter may recreate the public path immediately; its lease is independent
  // of both this cleanup and the host remover's final existence check.
  def gpl-release-now(lock, token) = gpl-release-remove(lock,token,path => host_dir_rmdir(path));
  def gpl-release-remove(lock,token,remove) {
   let made = host_dir_mkdir(gpl-gone-dir(lock));
   let gone = gpl-gone-dir(lock) ++ "/released-" ++ token;
    let claim=gpl-claim-of(token);
    if record?(claim) then {record_set(claim,"gone",gone);record_set(claim,"phase","releasing");} else 0;
    nps-rename-exclusive(lock,gone) == 0 && gpl-mine?(gpl-read(gone),token) ? {
     if record?(claim) then record_set(claim,"phase","detached") else 0;gpl-release-finish(claim,token,gone,remove);
    } : ["refused","release-rename-failed",token];
  }
   def gpl-release-finish(claim,token,gone,remove) {
    let removed=host_path_exists(gone)==0 ? 0 : remove(gone);
    let result=gpl-release-cleaned(token,gone,removed);
    if record?(claim) && removed==0 then gpl-claim-retire(claim) else 0;result;
   }
  def gpl-release-cleaned(token,gone,removed) = removed == 0 ? ["released",token] : {
   let result=["released",token,"cleanup-retained",gone];
   let noted=print_str("gpu-lease cleanup retained " ++ value_str([token,gone,removed]) ++ gpl-nl());
   result;
  };
  // give back what a take answered; a refused take holds nothing and gives back nothing
   def gpu-lease-give(lock, ans) = ans[0]=="preparing" && len(ans)>2 && record?(ans[2]) ? gpl-claim-abandon(ans[2]) : (Comparable) gpu-lease-held?(ans) == 1 ? gpu-lease-release(lock, gpu-lease-token(ans)) : ["refused", "no-lease"];
  // ---- for a door: take on the one real lock, say so on the door's own stdout in its `name  value` line shape ----
  def gpu-lease-line(ans) = "lease  " ++ value_str(ans);
  def gpu-lease-door(label) {
   let ans = gpu-lease-take(gpu-lease-path(), label, gpl-wait-ms());
   let said = print_str(gpu-lease-line(ans));
   ans;
  }
  // for a door whose body is one straight run of lets: a refused take stops the door aloud, before it touches the device
  def gpu-lease-door-held(label) = gpl-held-or-stop(gpu-lease-door(label));
  def gpl-held-or-stop(ans) = (Comparable) gpu-lease-held?(ans) == 1 ? ans : form_error("gpu-lease: the lease was refused " ++ value_str(ans));
  def gpu-lease-door-end(lease) {
   let ans = gpu-lease-give(gpu-lease-path(), lease);
   let said = print_str(gpu-lease-line(ans));
   ans;
  }
  // ---- lending: a door that holds the lease and runs its Metal client as its child (observe/gpu-lease-run.fk) ----
  // The child's own holds and turns (the Qwen lane takes one a turn: the open, a prefill, each token) found the lease held by
  // their parent and waited on it for the whole take while the parent waited on them: 20 minutes, then a refusal, a turn at a
  // time. The holder lends before it spawns, and its child's holds and turns inherit the lease (gpl-inheritable?) and give
  // nothing back. Only the holder lends and only its own child inherits; every other process still waits. The lend leaves with
  // the lease: a give or a takeover moves the whole directory.
  def gpu-lease-lend-at(lock, ans) = (Comparable) gpu-lease-held?(ans) == 1 && (Comparable) gpl-mine?(gpl-read(lock), gpu-lease-token(ans)) == 1 ? write_file(gpl-lent-file(lock), gpu-lease-token(ans)) : -1;
  def gpu-lease-lend(ans) = gpu-lease-lend-at(gpu-lease-path(), ans);
  // ---- for a door whose lane takes the lease a turn at a time ----
  // One hold over the door's whole reading: taken, or inherited where this process holds the lease or the door that runs it lent
  // it. Every turn inside inherits it, the door's own dispatches between turns run under it, and a reading takes the lease once,
  // not once a token. The door's `lease  ...` lines say how it came and how it went; a refused hold stops the door aloud before
  // it touches the device. A lease the door took goes back once its device work has settled, as a turn's does, on every exit
  // (BML defer): a reading that stops gives it back and stops again, and one whose device did not settle keeps it and stops aloud.
  // A reading holds the device for its runs: where a run begins the door
  // asks gpu-lease-door-yield, which hands a lease the door took to the client whose ticket waits, once the device has settled,
  // and takes it again behind that ticket. An inherited hold does not yield: the span is its holder's (the lease door's lend).
  // the door hold this process is inside, [lock label wait-ms settle lease] ([] outside every one), and what the last one gave back
  let GPL-DOOR = record_new(0, "hold", [], "gave", []);
  def gpu-lease-door-hold-at(lock, label, wait-ms, settle, run) {
   let lease = gpu-lease-hold-at(lock, label, wait-ms);
   let said = print_str(gpu-lease-line(lease));
   let out = gpl-door-reading([lock, label, wait-ms, settle, lease], run);
   (String) record_get(GPL-DOOR, "gave")[0] == "retained" ? form_error("gpu-lease: the reading did not settle; ownership retained") : out;
  }
  def gpu-lease-door-hold(label, run) = gpu-lease-door-hold-at(gpu-lease-path(), label, gpl-wait-ms(), gpl-metal-settle, run);
  // the reading under its hold; on every exit, a stop among them, the lease goes back and the hold outside it is restored
  def gpl-door-reading(h, run) {
   let outer = record_get(GPL-DOOR, "hold");
   let entered = record_set(GPL-DOOR, "hold", h);
   defer gpl-door-end(outer);
   run();
  }
  // the lease the hold holds now (a yield took it again) goes back once settled; an inherited or handed-on one gives nothing
  def gpl-door-end(outer) {
   let h = record_get(GPL-DOOR, "hold");
   let settle = h[3];
   let gave = (Comparable) gpu-lease-held?(h[4]) == 1 ? (settle() ? gpu-lease-give(h[0], h[4]) : ["retained", gpu-lease-token(h[4])]) : h[4];
   let kept = record_set(GPL-DOOR, "gave", gave);
   let back = record_set(GPL-DOOR, "hold", outer);
   print_str(gpu-lease-line(gave));
  }
  // where a run of a door's reading begins (never inside a turn: the turn's lease is the door's): ["yielded" gave again] when
  // another client's ticket waits and the device has settled, ["kept" token] when none waits, ["unsettled" token], the hold itself
  // when it is inherited, ["outside"] outside every door hold
  def gpu-lease-door-yield() = gpl-door-yield-of(record_get(GPL-DOOR, "hold"));
  def gpl-door-yield-of(h) = nil?(h) ? ["outside"] : ((Comparable) gpu-lease-held?(h[4]) != 1 ? h[4] : (gpl-others-wait?(h[0]) ? gpl-door-hand-on(h) : ["kept", gpu-lease-token(h[4])]));
  def gpl-others-wait?(lock) = any?(row => !nil?(row) && row[0] != host_pid(), map(name => gpl-wait-row(lock, name), host_dir_list(gpl-wait-dir(lock)) ?? []));
  def gpl-door-hand-on(h) {
   let settle = h[3];
   settle() ? gpl-door-handed(h, gpu-lease-give(h[0], h[4])) : ["unsettled", gpu-lease-token(h[4])];
  }
  // the door takes the lease again looking as a turn does, every 10 ms: at a take's own second between looks it came back a whole
  // second after the waiter had given the lease back, and the device stood idle that second
  def gpl-door-handed(h, gave) {
   let said = print_str(gpu-lease-line(gave));
   let given = record_set(GPL-DOOR, "hold", [h[0], h[1], h[2], h[3], gave]);
   (String) gave[0] != "released" ? form_error("gpu-lease: the reading could not hand its lease on " ++ value_str(gave)) : gpl-door-again(h, gave, gpl-held-or-stop(gpu-lease-take-with(h[0], h[1], [h[2], 10, gpl-unowned-ms(), gpl-markers()])));
  }
  def gpl-door-again(h, gave, again) {
   let held = record_set(GPL-DOOR, "hold", [h[0], h[1], h[2], h[3], again]);
   let said = print_str(gpu-lease-line(again));
   ["yielded", gave, again];
  }
  // ---- for a model open that may sit inside a door which holds the lease already ----
  // The cycle takes the lease once for its train, evaluation and usage stages, run as cells in one process; each stage opens the
  // voice, and a second take by the same process is refused ("already-held-by-this-process"). A hold is the lease taken, or, when
  // this process owns it or its parent lent it (gpu-lease-lend), inherited: the answer ["inherited" token] gives nothing back at
  // the end, so the holder that took it does.
  // Waits as long as a take does (gpl-wait-ms); a refusal stops the open aloud, before the device is touched. No line is printed:
  // the open is inside a stage whose output is the stage's.
  def gpu-lease-hold-at(lock, label, wait-ms) = gpl-hold-judged(lock, label, wait-ms, gpl-read(lock));
  def gpl-inheritable?(r) = (String) r[0] == "rec" && r[3] > 0 && ((r[2] == host_pid() && r[3] == gpl-me-start()) || gpl-lent-here?(r));
  def gpl-hold-judged(lock, label, wait-ms, r) = gpl-inheritable?(r) ? ["inherited", r[1]] : gpl-held-or-stop(gpu-lease-take(lock, label, wait-ms));
  def gpu-lease-hold(label) = gpu-lease-hold-at(gpu-lease-path(), label, gpl-wait-ms());
   def gpu-lease-hold-retaining(label,retain) {
    let lock=gpu-lease-path();let current=gpl-read(lock);
    let held=gpl-inheritable?(current) ? ["inherited",current[1]] : gpl-held-or-stop(gpu-lease-take-retaining(lock,label,[gpl-wait-ms(),gpl-poll-ms(),gpl-unowned-ms(),gpl-markers()],retain));
    retain(held);held;
   }
  def gpu-lease-unhold-at(lock, ans) = (String) ans[0] == "inherited" ? ans : gpu-lease-give(lock, ans);
  def gpu-lease-unhold(ans) = gpu-lease-unhold-at(gpu-lease-path(), ans);
  // Work keeps its model/KV owner between turns. Only settled device work
  // hands the shared lease onward; an incomplete drain retains ownership.
  // The injected settle function lets the existing lease band observe unwind
  // without opening a model or changing the machine's real lease.
  def gpu-lease-turn-at(lock,label,wait-ms,settle,run) {
   let current = gpl-read(lock);
   let lease = gpl-inheritable?(current) ? ["inherited",current[1]] : gpl-held-or-stop(gpu-lease-take-with(lock,label,[wait-ms,10,gpl-unowned-ms(),gpl-markers()]));
   let outcome = try [1,run()] catch [0];
   let drained = settle();
   !drained ? form_error("gpu-lease: operation did not settle; ownership retained") : {
    let released = gpu-lease-unhold-at(lock,lease);
    !((String) released[0] == "released" || (String) released[0] == "inherited") ? form_error("gpu-lease: release refused " ++ value_str(released)) :
    outcome[0] == 1 ? outcome[1] : form_error("gpu-lease: operation raised after ownership was released");
   };
  }
  // A process that has not brought Metal up answers no counters, and it has no device work to settle: a first turn that
  // only maps the weights hands the lease on.
  def gpl-metal-settle() {
   let sync = metal_sync();
   let live = metal_live();
   nil?(live) || (len(live) == 20 && live[5] == 0 && live[6] == 0 && live[14] == 0);
  }
  def gpu-lease-turn(label,run) = gpu-lease-turn-at(gpu-lease-path(),label,gpl-wait-ms(),gpl-metal-settle,run);
  def gpu-lease-renew(lock, token) = gpl-renew-of(lock, token, gpl-read(lock));
  def gpl-renew-of(lock, token, r) = (Comparable) gpl-mine?(r, token) == 1 ? gpl-renew-now(lock, token, r) : gpl-not-mine(r);
  def gpl-renew-now(lock, token, r) = (Comparable) gpl-publish(lock, token, r[6], r[4]) == 0 ? ["renewed", token] : ["refused", "renew-not-written", token];
  0;
}
