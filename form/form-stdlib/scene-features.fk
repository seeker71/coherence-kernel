// Row-major luminance: forward gradient, mean absolute deviation and four
// raster-ordered quadrants. Floors and tolerance arrive from the caller.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class SceneFeatures {
  def sf-cell(grid,n,x,y) = nth(grid,y * n + x);
  def sf-edge(grid,n,x,y) =
   (if x + 1 < n then abs(sf-cell(grid,n,x,y) - sf-cell(grid,n,x + 1,y)) else 0) +
   (if y + 1 < n then abs(sf-cell(grid,n,x,y) - sf-cell(grid,n,x,y + 1)) else 0);
  def sf-region-sum(sample,x0,y0,w,h) {
   let columns = range(x0,x0 + w);
   def row(total,y) {
    def cell(acc,x) = acc + sample(x,y);
    foldl(cell,total,columns);
   }
   foldl(row,0,range(y0,y0 + h));
  }
  def sf-detail(grid,n,x0,y0,w,h) = if w * h == 0 then 0 else {
   def row(y) = take(w,drop(y * n + x0,grid));
   let samples = foldr(append,empty,map(row,range(y0,y0 + h)));
   let mean = sum(samples) / (w * h);
   def deviation(total,pixel) = total + abs(pixel - mean);
   foldl(deviation,0,samples) / (w * h);
  };
  def sf-half(n) = n / 2;
  def sf-bx0(n,bx) = bx * sf-half(n);
  def sf-by0(n,by) = by * sf-half(n);
  def sf-block-detail(grid,n,bx,by) = sf-detail(grid,n,sf-bx0(n,bx),sf-by0(n,by),sf-half(n),sf-half(n));
  def sf-block-edge(grid,n,bx,by) {
   def edge(x,y) = sf-edge(grid,n,x,y);
   sf-region-sum(edge,sf-bx0(n,bx),sf-by0(n,by),sf-half(n),sf-half(n));
  }
  def sf-shape-block?(grid,n,bx,by,floor) = sf-block-edge(grid,n,bx,by) >= floor;
  def sf-shape(grid,n,floor) {
   def shape(id) = sf-shape-block?(grid,n,id % 2,id / 2,floor);
   map(shape,range(0,4));
  }
  def sf-object-id(bx,by) = by * 2 + bx;
  def sf-objects(grid,n,floor) {
   def object?(id) = sf-block-detail(grid,n,id % 2,id / 2) >= floor;
   filter(object?,range(0,4));
  }
  def sf-region-residual(grid,baseline,n,bx,by) = abs(sf-block-detail(grid,n,bx,by) - sf-block-detail(baseline,n,bx,by));
  def sf-common?(grid,baseline,n,bx,by,tolerance) = sf-region-residual(grid,baseline,n,bx,by) < tolerance;
  def sf-unique?(grid,baseline,n,bx,by,tolerance) = sf-region-residual(grid,baseline,n,bx,by) >= tolerance;
 }
}
