; form-cli-mlx-nodeid-fallback-live.fk — dormant effectful wrapper for the
; Form-owned MLX refusal -> NodeID request -> generated Metal movement.
;
; The immediate mlx_status read is load-bearing: mlx_run may legitimately
; return integer 0. No MLX call, framebuffer action, or other carrier movement
; occurs between the run and the status capture.
;
; This source defines effects but performs none at top level. Do not preflight
; or run its live driver while another session owns the shared GPU/model lane.
;
; preludes: form-stdlib/form-cli-mlx-nodeid-fallback.fk
; preludes: form-stdlib/form-recipe-exec-token-live.fk

(do
    (defn fmnfl-result (attempt live settled)
        (list attempt live settled))
    (defn fmnfl-result-attempt (r) (nth r 0))
    (defn fmnfl-result-live (r) (nth r 1))
    (defn fmnfl-result-settled (r) (nth r 2))

    (defn fmnfl-attempt (program recipe input)
        (do
            (let value (mlx_run program))
            ; Read-only status captures fk_mlx_err before any later MLX call can
            ; replace it. Its raw text remains local to the attempt.
            (let status (mlx_status))
            (fmnf-classify recipe input value status (str_len program))))

    (defn fmnfl-execute (attempt)
        (if (not (eq (fmnf-attempt-request? attempt) 1))
            (fmnfl-result attempt (nothing) (nothing))
            (do
                (let request (fmnf-attempt-request attempt))
                ; This request was born internally, not from model bytes.
                (let live (frexl-execute-request request 0))
                (let settled (fmnf-settle-with-flags attempt
                    (frexl-result-carrier live)
                    (frexl-result-status live)
                    (frexl-result-reason live)
                    (frexl-result-value live)
                    (frexl-result-value-present? live)
                    (frexl-result-executed? live)
                    (frexl-result-model-executed? live)
                    (frexl-result-native-code-generated? live)))
                (fmnfl-result attempt live settled))))

    (defn fmnfl-run (program recipe input)
        (fmnfl-execute (fmnfl-attempt program recipe input)))
    0)
