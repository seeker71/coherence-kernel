; jit-crystallize.fk — the JIT MECHANISM: crystallize-on-heat, as a Form composite.
;
; host-kernel.form: "heat crystallizes a hot composite into a callable, cached by
; NodeID… JIT IS one running composite." This is that loop, in Form — no host-
; specific JIT code in the kernel. It is BYTE-SOURCE-AGNOSTIC: the only seam that
; names how a recipe becomes native bytes is `jc-crystallize`; swap form-lower for
; clang/Go bytes there and the loop is untouched. The reference jit.go crystallized
; via a Go plugin; form-lower is the SOVEREIGN plugin (drops clang), but the
; mechanism does not require it — that separation is the whole point.
;
; jit-decision.fk supplies the policy (jd-crystallize? / jd-melt?, hysteresis so a
; recipe near the boundary never thrashes). This supplies the STATE and DISPATCH the
; policy drives: a heat counter and a native cache, both keyed by a content key, and
; champion-challenger dispatch — walk (the tree-walker champion) until a recipe is
; hot AND pure, then crystallize once and dispatch the native challenger, melting
; back to the walker when it cools. Native replacement is a CHOICE the heat earns,
; never a MUST (host-kernel.form: native-replace CAN-not-MUST).
;
; State is threaded (Form is functional): st = (heat-assoc cache-assoc). A call
; returns (result state' tag), tag 0=walk 1=crystallize 2=native-dispatch.
;
; The cache key here is a rolling content-fold of the recipe (jc-key). The body's
; canonical content address is make_nodeid (tag 91); this fold stands in for it so
; the mechanism proof does not ride make_nodeid's flatten-only construction path.
;
; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk

(do
    ; ── policy: hot AND ELIGIBLE-to-lower crystallizes. NOT "hot and pure" — that was
    ; the imported error. Crystallizing caches the CODE, not the result; an effectful
    ; recipe's native runs its syscall every call, so purity is irrelevant. The real
    ; second condition is lowerability (coverage), fed below. ──
    (defn jd-crystallize? (heat eligible) (if (eq eligible 1) (if (ge heat 5) 1 0) 0))
    (defn jd-melt? (heat) (if (lt heat 2) 1 0))

    ; ── assoc store: (list v) when present, (empty) when absent ──
    (defn jc-aget (al k) (if (nil? al) (empty) (if (eq (head (head al)) k) (list (head (tail (head al)))) (jc-aget (tail al) k))))
    (defn jc-aput (al k v) (if (nil? al) (list (list k v)) (if (eq (head (head al)) k) (cons (list k v) (tail al)) (cons (head al) (jc-aput (tail al) k v)))))
    (defn jc-adel (al k) (if (nil? al) (empty) (if (eq (head (head al)) k) (tail al) (cons (head al) (jc-adel (tail al) k)))))
    (defn jc-getn (al k) (do (let r (jc-aget al k)) (if (nil? r) 0 (head r))))

    ; ── content key over the recipe rows (stands in for make_nodeid) ──
    (defn jc-foldrow (row acc) (if (nil? row) acc (jc-foldrow (tail row) (add (mul acc 31) (add (head row) 1)))))
    (defn jc-key (prog acc) (if (nil? prog) acc (jc-key (tail prog) (jc-foldrow (head prog) (add (mul acc 131) 7)))))

    ; ── LOWERABILITY: which STRATEGY, never a go/no-go gate ──
    ; NOT purity (crystallizing caches the CODE, not the result — the native runs its
    ; effect every call). And no recipe is truly un-JIT-able: the JIT is TOTAL by strategy —
    ;   · covered op        -> direct-lower (form-lower emits the instructions)
    ;   · uncovered host op -> inject a `bl` into a host address
    ;   · const / pure      -> store-as-cell (cell-log-store.fk, content-addressed via
    ;                          make_nodeid): compute once, native = load the cached value
    ; so jc-lowerable? below asks only "is DIRECT-LOWERING available TODAY" — one strategy,
    ; a shrinking coverage frontier — NOT "can we JIT this" (always yes). Direct coverage:
    ; 1 LIT 2 ARG 3 ADD 4 SUB 5 MUL 6 COND 8 DIV 9 STREQ 10 READ_FILE 11 WRITE_FILE.
    ; Health is EXTENSIONAL, not byte-identity: byte-identity to clang is a ceiling that
    ; form-lower-sim already lifts. Per-INSTRUCTION the encoding is the one true ISA form
    ; (form-asm); per-FUNCTION correctness is judged by RESULT — fsim, and now nat_run on
    ; hardware, run the native and match the walker — so ANY working asm is admissible and
    ; clang is a benchmark oracle (length/speed/parallel) to learn from, not a template.
    ; (The inject-call + store-as-cell strategies and measured health are still to build.)
    (defn jc-tag-lowerable? (t)
        (if (eq t 1) 1 (if (eq t 2) 1 (if (eq t 3) 1 (if (eq t 4) 1 (if (eq t 5) 1
        (if (eq t 6) 1 (if (eq t 8) 1 (if (eq t 9) 1 (if (eq t 10) 1 (if (eq t 11) 1 0)))))))))))
    (defn jc-lowerable? (prog)
        (if (nil? prog) 1
            (if (eq (jc-tag-lowerable? (head (head prog))) 1) (jc-lowerable? (tail prog)) 0)))

    ; ── STRATEGY: every recipe crystallizes by SOME route — the JIT is total ──
    ; store-as-cell memoizes a value, so it needs purity AND const-ness: an effectful const
    ; must still direct-lower so its effect fires each call. This is purity's CORRECT role —
    ; the precondition for the cell strategy, never a JIT eligibility gate.
    (defn jc-tag-pure? (t) (if (eq t 1) 1 (if (eq t 2) 1 (if (eq t 3) 1 (if (eq t 4) 1 (if (eq t 5) 1 (if (eq t 6) 1 (if (eq t 8) 1 (if (eq t 9) 1 0)))))))))
    (defn jc-pure? (prog) (if (nil? prog) 1 (if (eq (jc-tag-pure? (head (head prog))) 1) (jc-pure? (tail prog)) 0)))
    (defn jc-has-arg? (prog) (if (nil? prog) 0 (if (eq (head (head prog)) 2) 1 (jc-has-arg? (tail prog)))))
    (defn jc-const? (prog) (if (eq (jc-has-arg? prog) 1) 0 1))
    ; 1 = store-as-cell (pure const: native = load the cached value; shortest) · 0 = direct-lower
    ; (covered; preserves effects and args) · 2 = inject-bl (uncovered + arg-dep/effectful) — the
    ; one strategy still to build; today it declines to crystallize and the recipe stays walked.
    (defn jc-strategy (prog)
        (if (and (eq (jc-const? prog) 1) (eq (jc-pure? prog) 1)) 1
            (if (eq (jc-lowerable? prog) 1) 0 2)))
    ; emit native bytes for the chosen strategy (form-lower is the byte-source at every route;
    ; the cell route lowers a single LIT of the champion's value — const-folded, extensionally
    ; equal to the full lowering and strictly shorter).
    (defn jc-emit (prog walkres strat)
        (if (eq strat 1) (lo-compile-fn (list (list 1 walkres)) 0)
            (lo-compile-fn prog (sub (len prog) 1))))

    ; ── the loop: (result state' tag) — purity is DERIVED from the recipe here ──
    (defn jc-call (prog arg walkres st)
        (do (let heat (nth st 0)) (let cache (nth st 1)) (let k (jc-key prog 1))
            (let c (jc-aget cache k))
            (if (not (nil? c))
                (list (nat_run (head c) arg) (list (jc-aput heat k (add (jc-getn heat k) 1)) cache) 2)
                (do (let h1 (add (jc-getn heat k) 1)) (let strat (jc-strategy prog))
                    (if (eq (jd-crystallize? h1 (if (lt strat 2) 1 0)) 1)
                        (do (let b (jc-emit prog walkres strat))
                            (list (nat_run b arg) (list (jc-aput heat k h1) (jc-aput cache k b)) 1))
                        (list walkres (list (jc-aput heat k h1) cache) 0))))))

    ; ── cool one recipe by `d`; melt (evict native) when it drops below threshold ──
    (defn jc-cool (prog st d)
        (do (let heat (nth st 0)) (let cache (nth st 1)) (let k (jc-key prog 1))
            (let h1 (sub (jc-getn heat k) d))
            (if (eq (jd-melt? h1) 1) (list (jc-aput heat k h1) (jc-adel cache k)) (list (jc-aput heat k h1) cache))))

    ; ── warm a recipe n times, returning the final state (for tests/drivers) ──
    (defn jc-warm (prog arg walkres st n) (if (le n 0) st (jc-warm prog arg walkres (nth (jc-call prog arg walkres st) 1) (sub n 1))))

    (defn jc-empty () (list (empty) (empty)))

    ; self-check: f(n)=n*3+7 routes to direct-lower (strat 0), walks 4x then crystallizes
    (do (let prog (list (list 1 7) (list 2) (list 1 3) (list 5 1 2) (list 3 3 0)))
        (let st4 (jc-warm prog 10 37 (jc-empty) 4))
        (let r5 (jc-call prog 10 37 st4))
        (if (eq (jc-strategy prog) 0) (if (eq (nth r5 2) 1) (if (eq (nth r5 0) 37) 1 0) 0) 0)))
