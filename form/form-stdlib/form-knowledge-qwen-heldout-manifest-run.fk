; form-knowledge-qwen-heldout-manifest-run.fk -- no-model dataset witness.
;
; preludes: form-stdlib/form-knowledge-qwen-heldout-eval.fk

(do
    (defn fkhem-print-rows (rows)
        (if (eq (len rows) 0) 0
            (do
                (let row (head rows))
                (print_str
                    (str_concat (fkhe-id row)
                    (str_concat " source="
                    (str_concat (nmfe-sha256 (read_file (fkhe-source row)))
                    (str_concat " answer="
                    (str_concat (nmfe-sha256 (fkhe-expected row)) "\n"))))))
                (fkhem-print-rows (tail rows)))))
    (fkhem-print-rows (fkhe-rows))
    (print_str (str_concat "dataset-current="
        (str_concat (fkhe-dataset-sha256 (fkhe-rows)) "\n")))
    (print_str (str_concat "dataset-sealed="
        (str_concat (fkhe-dataset-seal) "\n")))
    (print_str (str_concat "dataset-valid="
        (str_concat (int_to_str (fkhe-dataset-valid?)) "\n")))
    0)
