; stdin: revision, byte-size, sha256, runtime revision
; preludes: form-stdlib/core.fk form-stdlib/nanbeige-gguf-admission.fk

(do
    (let revision (read_line))
    (let size (str_to_int (read_line)))
    (let sha (read_line))
    (let runtime-revision (read_line))
    (print_str
        (str_concat "package_admitted="
        (str_concat (int_to_str (nbga-admit? revision size sha))
        (str_concat "\nruntime_admitted="
        (str_concat (int_to_str (nbga-runtime-admit? runtime-revision))
        (str_concat "\nexecution_admitted="
        (str_concat (int_to_str
            (nbga-execution-admit? revision size sha runtime-revision))
                    "\n"))))))))
