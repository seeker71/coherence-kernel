; nanbeige-reply-witness.fk — bind one observed reply to admitted bytes/runtime.
; preludes: form-stdlib/core.fk form-stdlib/nanbeige-gguf-admission.fk

(do
    (defn nbrw-verify?
        (revision size sha runtime-revision prompt-id response)
        (if (eq (nbga-execution-admit?
                    revision size sha runtime-revision) 1)
            (if (str_eq prompt-id "exact-42-v1")
                (if (str_eq response "42") 1 0)
                0)
            0))
    0)
