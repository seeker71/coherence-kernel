// Corpus traversal and Adam age are different identities. This state publishes
// in the same generation as the update it describes; no separate cursor file.
// preludes: form-stdlib/organ-health.bml form-stdlib/sha256.fk form-stdlib/json-precise.bml
section [form.bml] {
 class NativeLoraProgress {
  def nlp-get(o,k) = node_value(json-object-get(o,k));
  def nlp-natural(v) = if str_eq(value_kind(v),"int") then ge(v,0) else 0;
  def nlp-hex(bytes) = if nil?(bytes) then "" else str_concat(str_concat(json-hex-digit(div(head(bytes),16)),json-hex-digit(mod(head(bytes),16))),nlp-hex(tail(bytes)));
  def nlp-digest?(s,i) = if eq(i,str_len(s)) then eq(i,64) else if lt(str_find("0123456789abcdef",substring(s,i,add(i,1)),0),0) then 0 else nlp-digest?(s,add(i,1));
  def nlp-valid(p) {
   let hash = nlp-get(p,"dataset_sha256"); let rows = nlp-get(p,"dataset_rows"); let seen = nlp-get(p,"examples_seen"); let masked = nlp-get(p,"mask_prompt");
   if not(str_eq(nlp-get(p,"schema"),"native-training-progress-v1")) then 0
   else if not(str_eq(value_kind(hash),"string")) then 0
   else if ne(str_len(hash),64) then 0
   else if not(and(nlp-natural(rows),and(nlp-natural(seen),nlp-natural(masked)))) then 0
   else and(nlp-digest?(hash,0),and(gt(rows,0),or(eq(masked,0),eq(masked,1))));
  }
  def nlp-bind(text,rows,masked) {
   let progress = json-node-object(list(oh-s("schema","native-training-progress-v1"),oh-s("dataset_sha256",nlp-hex(sha256-stream-string(text))),oh-n("dataset_rows",rows),oh-n("mask_prompt",masked),oh-n("examples_seen",0)));
   if nlp-valid(progress) then progress else form_error("native dataset progress binding refused");
  }
  def nlp-seen(progress) = nlp-get(progress,"examples_seen");
  def nlp-cursor(progress) = mod(nlp-seen(progress),nlp-get(progress,"dataset_rows"));
  def nlp-restore(config,binding) {
   if not(nlp-valid(binding)) then form_error("native dataset progress binding invalid")
   else if not(json-object-has?(config,"training_progress")) then list(binding,"coverage-unmeasured; restart at first row")
   else nlp-restore-saved(json-object-get(config,"training_progress"),binding);
  }
  def nlp-restore-saved(saved,binding) {
   if not(nlp-valid(saved)) then form_error("native checkpoint dataset progress invalid")
   else if not(str_eq(nlp-get(saved,"dataset_sha256"),nlp-get(binding,"dataset_sha256"))) then list(binding,"new dataset; start at first row")
   else if ne(nlp-get(saved,"dataset_rows"),nlp-get(binding,"dataset_rows")) then form_error("native checkpoint dataset row count disagrees")
   else if ne(nlp-get(saved,"mask_prompt"),nlp-get(binding,"mask_prompt")) then list(binding,"new supervision policy; start at first row")
   else list(saved,"same dataset; continue checkpointed examples");
  }
  def nlp-same(a,b) = if not(and(nlp-valid(a),nlp-valid(b))) then 0 else and(str_eq(nlp-get(a,"dataset_sha256"),nlp-get(b,"dataset_sha256")),and(eq(nlp-get(a,"dataset_rows"),nlp-get(b,"dataset_rows")),and(eq(nlp-get(a,"mask_prompt"),nlp-get(b,"mask_prompt")),eq(nlp-seen(a),nlp-seen(b)))));
  def nlp-checkpoint(config,marker) {
   let configHas = json-object-has?(config,"training_progress"); let markerHas = json-object-has?(marker,"training_progress");
   if not(or(configHas,markerHas)) then 1 else if not(and(configHas,markerHas)) then 0 else nlp-same(json-object-get(config,"training_progress"),json-object-get(marker,"training_progress"));
  }
  def nlp-advance(progress,count) {
   if not(and(nlp-valid(progress),nlp-natural(count))) then form_error("native dataset progress advance invalid")
   else if or(le(count,0),gt(count,nlp-get(progress,"dataset_rows"))) then form_error("native dataset progress batch refused")
   else if le(add(nlp-seen(progress),count),nlp-seen(progress)) then form_error("native dataset progress overflow")
   else oh-set(progress,"examples_seen",json-node-int(add(nlp-seen(progress),count)));
  }
  def nlp-request(r,progress) = oh-set(r,"training_progress",progress);
 }
 0;
}
