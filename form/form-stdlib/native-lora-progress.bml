// Corpus traversal and Adam age are different identities. This state publishes
// in the same generation as the update it describes; no separate cursor file.
// preludes: form-stdlib/organ-health.bml form-stdlib/sha256.fk form-stdlib/json-precise.bml
section [form.bml] {
 class NativeLoraProgress {
  def nlp-get(o,k) = node_value(json-object-get(o,k));
  def nlp-natural(v) = (String) value_kind(v) == "int" ? (v >= 0) : 0;
  def nlp-hex(bytes) = nil?(bytes) ? "" : (json-hex-digit(head(bytes) / 16) ++ json-hex-digit(head(bytes) % 16)) ++ nlp-hex(tail(bytes));
  def nlp-digest?(s,i) = (Comparable) i == str_len(s) ? ((Comparable) i == 64) : str_find("0123456789abcdef",substring(s,i,i + 1),0) < 0 ? 0 : nlp-digest?(s,i + 1);
  def nlp-valid(p) {
   let hash = nlp-get(p,"dataset_sha256"); let rows = nlp-get(p,"dataset_rows"); let seen = nlp-get(p,"examples_seen"); let masked = nlp-get(p,"mask_prompt");
   !((String) nlp-get(p,"schema") == "native-training-progress-v1") ? 0
   : !((String) value_kind(hash) == "string") ? 0
   : (Comparable) str_len(hash) != 64 ? 0
   : !(nlp-natural(rows) && (nlp-natural(seen) && nlp-natural(masked))) ? 0
   : (nlp-digest?(hash,0) && ((rows > 0) && (((Comparable) masked == 0) || ((Comparable) masked == 1))));
  }
  def nlp-bind(text,rows,masked) {
   let progress = json-node-object(list(oh-s("schema","native-training-progress-v1"),oh-s("dataset_sha256",nlp-hex(sha256-stream-string(text))),oh-n("dataset_rows",rows),oh-n("mask_prompt",masked),oh-n("examples_seen",0)));
   nlp-valid(progress) ? progress : form_error("native dataset progress binding refused");
  }
  def nlp-seen(progress) = nlp-get(progress,"examples_seen");
  def nlp-cursor(progress) = nlp-seen(progress) % nlp-get(progress,"dataset_rows");
  def nlp-restore(config,binding) {
   !nlp-valid(binding) ? form_error("native dataset progress binding invalid")
   : !json-object-has?(config,"training_progress") ? list(binding,"coverage-unmeasured; restart at first row")
   : nlp-restore-saved(json-object-get(config,"training_progress"),binding);
  }
  def nlp-restore-saved(saved,binding) {
   !nlp-valid(saved) ? form_error("native checkpoint dataset progress invalid")
   : !((String) nlp-get(saved,"dataset_sha256") == nlp-get(binding,"dataset_sha256")) ? list(binding,"new dataset; start at first row")
   : (Comparable) nlp-get(saved,"dataset_rows") != nlp-get(binding,"dataset_rows") ? form_error("native checkpoint dataset row count disagrees")
   : (Comparable) nlp-get(saved,"mask_prompt") != nlp-get(binding,"mask_prompt") ? list(binding,"new supervision policy; start at first row")
   : list(saved,"same dataset; continue checkpointed examples");
  }
  def nlp-same(a,b) = !(nlp-valid(a) && nlp-valid(b)) ? 0 : (((String) nlp-get(a,"dataset_sha256") == nlp-get(b,"dataset_sha256")) && (((Comparable) nlp-get(a,"dataset_rows") == nlp-get(b,"dataset_rows")) && (((Comparable) nlp-get(a,"mask_prompt") == nlp-get(b,"mask_prompt")) && ((Comparable) nlp-seen(a) == nlp-seen(b)))));
  def nlp-checkpoint(config,marker) {
   let configHas = json-object-has?(config,"training_progress"); let markerHas = json-object-has?(marker,"training_progress");
   !(configHas || markerHas) ? 1 : !(configHas && markerHas) ? 0 : nlp-same(json-object-get(config,"training_progress"),json-object-get(marker,"training_progress"));
  }
  def nlp-advance(progress,count) {
   !(nlp-valid(progress) && nlp-natural(count)) ? form_error("native dataset progress advance invalid")
   : (count <= 0) || (count > nlp-get(progress,"dataset_rows")) ? form_error("native dataset progress batch refused")
   : (nlp-seen(progress) + count) <= nlp-seen(progress) ? form_error("native dataset progress overflow")
   : oh-set(progress,"examples_seen",json-node-int(nlp-seen(progress) + count));
  }
  def nlp-request(r,progress) = oh-set(r,"training_progress",progress);
 }
 0;
}
