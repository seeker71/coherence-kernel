; living-world-continuity-branch.fk -- consent restores only the granted branch.
; witnessed: 2026-08-08 -> 65535 on direct-source fkwu
;
; Whole-image continuity is deliberately conservative: every active holder in
; a snapshot participates and successful restoration begins from the entire
; stored world.  That protects historical consent, but it also lets abstention
; in one part of the image hold unrelated parts inert.
;
; A branch is not an arbitrary caller-selected subset.  It is the exact current
; authority-minimized capability context already derived by
; living-world-capability-context: a payload enters only when every active
; holder has granted that payload to the offered capability.  The branch keeps
; the source image, context, optional declaration and lens, alternatives,
; unknowable remainder, and local path as content-addressed children.
;
; Restoration participants are only the historical payload holders inside the
; projection plus the historical capability holders.  A fresh offer of the
; exact branch is still required in the admission world.  Unanimous responses
; merge only the projected cells, relations, and active attributions into the
; admission successor.  Revocations and events are not imported from storage;
; the new admission outcome and boundary events carry the fresh authorization.
;
; Separate branches may therefore wait, dissent, acknowledge, or remain
; unknowable independently.  This does not infer a canonical partition, force
; restoration, authenticate source identity, or grant a capability holder
; authority over payloads it does not hold.  Overlapping branches remain
; explicit alternatives whose interactions must be observed rather than
; silently resolved.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-capability-context.fk

(let LWCB-BRANCH  (bp "LWCB-BRANCH"))
(let LWCB-RESTORE (bp "LWCB-RESTORE"))
(let LWCB-ORIGIN  (bp "LWCB-ORIGIN"))

; children: source image, capability, exact context, optional declaration,
;           optional lens, alternatives, unknowable remainder, local path
(defn lwcb-branch
    (image capability declaration lens alternatives unknowable)
    (do
        (let snapshot (lwcn-image-world image))
        (intern_node LWCB-BRANCH
            (list image capability (lwcp-context snapshot capability)
                  declaration lens alternatives unknowable
                  (lwo-local-path)))))

(defn lwcb-branch? (cell) (lwo-category? cell LWCB-BRANCH))
(defn lwcb-branch-image (branch) (nth (node_children branch) 0))
(defn lwcb-branch-capability (branch) (nth (node_children branch) 1))
(defn lwcb-branch-context (branch) (nth (node_children branch) 2))
(defn lwcb-branch-declaration (branch) (nth (node_children branch) 3))
(defn lwcb-branch-lens (branch) (nth (node_children branch) 4))
(defn lwcb-branch-alternatives (branch) (nth (node_children branch) 5))
(defn lwcb-branch-unknowable (branch) (nth (node_children branch) 6))
(defn lwcb-branch-path (branch) (nth (node_children branch) 7))

(defn lwcb-branch-world (branch)
    (lwcp-context-world (lwcb-branch-context branch)))

(defn lwcb-branch-valid? (branch)
    (if (eq (lwcb-branch? branch) 0) 0
        (do
            (let image (lwcb-branch-image branch))
            (if (eq (lwcn-image-valid? image) 0) 0
                (do
                    (let snapshot (lwcn-image-world image))
                    (let context (lwcb-branch-context branch))
                    (let projected (lwcp-context-world context))
                    (if (and
                            (node_eq context
                                (lwcp-context snapshot
                                    (lwcb-branch-capability branch)))
                            (and
                                (node_eq (lwcb-branch-path branch)
                                    (lwo-local-path))
                                (and
                                    (gt (lwo-field-size
                                        (lwo-world-cells projected)) 0)
                                    (gt (lwo-field-size
                                        (lwcn-active-sources projected)) 0))))
                        1 0))))))

(defn lwcb-sources-from-attributions (items acc)
    (if (eq (len items) 0) acc
        (lwcb-sources-from-attributions (tail items)
            (lwo-field-add acc
                (lwo-attribution-source (head items))))))

; Payload holders come from the authority-minimized projected world.  Exact
; capability attributions add capability holders without duplicating sources.
(defn lwcb-branch-participants (branch)
    (do
        (let context (lwcb-branch-context branch))
        (lwcb-sources-from-attributions
            (lwo-field-items
                (lwcp-context-capability-attributions context))
            (lwcn-active-sources (lwcp-context-world context)))))

; children: exact branch, projected world, participants, active branch-offer
;           attributions, grant evidence, alternatives, unknowable, local path
(defn lwcb-restore (admission-world branch)
    (do
        (let context (lwcb-branch-context branch))
        (intern_node LWCB-RESTORE
            (list branch (lwcp-context-world context)
                  (lwcb-branch-participants branch)
                  (lwo-active-attributions-for admission-world branch)
                  (lwcp-context-grant-evidence context)
                  (lwcb-branch-alternatives branch)
                  (lwcb-branch-unknowable branch)
                  (lwo-local-path)))))

(defn lwcb-restore? (cell) (lwo-category? cell LWCB-RESTORE))
(defn lwcb-restore-branch (restore) (nth (node_children restore) 0))
(defn lwcb-restore-world (restore) (nth (node_children restore) 1))
(defn lwcb-restore-participants (restore) (nth (node_children restore) 2))
(defn lwcb-restore-branch-attributions (restore)
    (nth (node_children restore) 3))
(defn lwcb-restore-grant-evidence (restore) (nth (node_children restore) 4))
(defn lwcb-restore-alternatives (restore) (nth (node_children restore) 5))
(defn lwcb-restore-unknowable (restore) (nth (node_children restore) 6))
(defn lwcb-restore-path (restore) (nth (node_children restore) 7))

(defn lwcb-origin (restore witnesses)
    (intern_node LWCB-ORIGIN (list restore witnesses)))

(defn lwcb-restore-proposal (admission-world branch)
    (if (or (eq (lwcb-branch-valid? branch) 0)
            (eq (lwo-active? admission-world branch) 0)) (lwo-none)
        (do
            (let restore (lwcb-restore admission-world branch))
            (let participants (lwcb-restore-participants restore))
            (let witnesses (lwcb-restore-branch-attributions restore))
            (if (or (eq (lwo-field-size participants) 0)
                    (eq (lwo-field-size witnesses) 0)) (lwo-none)
                (do
                    (let origin (lwcb-origin restore witnesses))
                    (let candidate
                        (lwo-emergent restore witnesses
                            (intern_trivial_int
                                (lwo-field-size participants))
                            (intern_trivial_int
                                (lwo-field-size
                                    (lwo-world-cells
                                        (lwcb-restore-world restore))))
                            (intern_trivial_int
                                (lwo-field-size witnesses)) origin))
                    (lwt-proposal candidate participants origin))))))

(defn lwcb-restore-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwcb-restore?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwcb-restore-current? (admission-world candidate)
    (if (eq (lwcb-restore-candidate? candidate) 0) 0
        (do
            (let restore (lwo-emergent-shape candidate))
            (let fresh
                (lwcb-restore-proposal admission-world
                    (lwcb-restore-branch restore)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))

(defn lwcb-field-union-items (items acc)
    (if (eq (len items) 0) acc
        (lwcb-field-union-items (tail items)
            (lwo-field-add acc (head items)))))

; A branch successor extends the admission history.  It does not replace the
; whole world with the stored snapshot and it imports no stored revocation or
; boundary-event authority.
(defn lwcb-merge-world (admission-world projected-world)
    (lwo-world
        (lwcb-field-union-items
            (lwo-field-items (lwo-world-cells projected-world))
            (lwo-world-cells admission-world))
        (lwcb-field-union-items
            (lwo-field-items (lwo-world-relations projected-world))
            (lwo-world-relations admission-world))
        (lwcb-field-union-items
            (lwo-field-items (lwo-world-attributions projected-world))
            (lwo-world-attributions admission-world))
        (lwo-world-revocations admission-world)
        (lwo-world-events admission-world)))

(defn lwcb-integrate-restore (round proposal action)
    (do
        (let admission-world (lwt-round-world round))
        (let candidate (lwt-proposal-candidate proposal))
        (let outcome (lwt-evaluate-proposal admission-world proposal))
        (if (and (eq (lwcb-restore-current?
                          admission-world candidate) 1)
                 (and (node_eq (lwt-outcome-status outcome)
                               (lwt-status-acknowledged))
                      (eq (lwo-emergent-ready?
                            admission-world candidate) 1)))
            (do
                (let restore (lwo-emergent-shape candidate))
                (let merged
                    (lwcb-merge-world admission-world
                        (lwcb-restore-world restore)))
                (let restored
                    (lwt-integrate-sources merged
                        (lwo-field-items
                            (lwt-proposal-participants proposal))
                        candidate action outcome))
                (lwt-round restored (lwt-round-proposals round)
                    (lwo-field-add (lwo-empty-field) outcome) round))
            (lwt-round admission-world (lwt-round-proposals round)
                (lwo-field-add (lwo-empty-field) outcome) round))))

(defn lwcb-restored? (world candidate)
    (if (and (eq (lwcb-restore-candidate? candidate) 1)
             (eq (lwo-active? world candidate) 1)) 1 0))

0
