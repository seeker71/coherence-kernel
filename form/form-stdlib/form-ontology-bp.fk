; form-ontology-bp.fk — the reviewed bootstrap `bp` registry, and nothing that
; needs an op some kernel lacks.
;
; SPLIT OUT of form-ontology-loader.fk on 2026-07-30, and the reason is a
; documented seam meeting an undocumented consequence.
;
; The loader ends with a top-level `(walk_recipe_here ...)` that installs the
; engine constant family. `walk_recipe_here` is a Go/Rust/TypeScript native with
; no fkwu counterpart, and the loader says so plainly and on purpose: "Recorded,
; not shimmed: a numb walk would silently skip the generation it claims." That
; decision is right and is untouched here.
;
; What nobody carried: 255 cells prelude that loader, and fkwu resolves EVERY
; call site in a prelude chain, not only the reached ones. So every one of them
; inherits the seam — one `[unresolved-call]` and exit 1 — whether or not it
; wanted an engine constant. A band then prints its verdict and exits 1, and its
; exit code can no longer distinguish "my band failed" from "the loader's
; recorded seam". Witnessed on cognition/tests/nl-extract-band.fk: verdict 255,
; exit 1, one error, and the error belonged to hex.fk's prelude of the loader —
; hex.fk uses exactly ONE name from it, `fol-bp`, for a sentinel lookup.
;
; So the registry lives here, arm-neutral, and the loader preludes it. Consumers
; that want the engine constants keep preluding the loader and keep meeting the
; seam, loudly, exactly as before. Consumers that only need a blueprint
; coordinate now stop paying for a walk they never asked for.
;
; preludes: form-stdlib/core.fk

; form-ontology-loader.fk — bootstrap ontology bindings without runtime JSON parsing.
;
; The Form-owned `bp` floor below carries the reviewed bootstrap rows needed by
; the current source runner, source compiler, and grammar capsules. It keeps
; direct source from relying on the old fkwu identity stub, where `(bp "add")`
; returned the string "add" instead of a NodeID. The full blueprint registry
; still needs to move into Form data; until then this loader admits the rows
; that are actually exercised by the Form stdlib and fails loudly for the rest.
;
; Prelude requirement: make_nodeid, node_type, node_inst, intern_node,
; intern_trivial_string, intern_trivial_int, walk_recipe_here, list/cons/head/
; tail/len/empty, str_concat, form_error, and str_eq are available from the
; kernel/core prelude.
;
; source-door surface seam (2026-07-17): on fkwu, every requirement above resolves
; EXCEPT walk_recipe_here — the top-level engine-defn walk (the one call at
; the foot of this file, which would install the bmf-context-key-* /
; bmf-locale-* constant family for engine.fk) is a sibling-kernel native
; with no fkwu counterpart or bp coordinate. Under fresh `fkwu` that
; one call stays loud (unresolved, axiom-5 recovery) and the generated
; constants stay ungenerated; engine.fk records the same seam from the
; consumer side. Recorded, not shimmed: a numb walk would silently skip the
; generation it claims.

;; --- source-compiler tables ----------------------------------------
;; FORM-CATEGORY-TABLE and FORM-PRIMITIVE-TABLE keep the source compiler's
;; historic (name type inst) shape. Their coordinates come from the bootstrap
;; bp table below, not from a host-generated runtime table.

(defn fol-bp-row (name pkg level ty inst)
    (list name pkg level ty inst))

(defn fol-rows-path () "form/form-stdlib/form-ontology-bootstrap.rows")

;; The reviewed bootstrap rows are DATA, not code: one row per line,
;; "name pkg level ty inst", in form-ontology-bootstrap.rows. The file
;; was emitted from the former in-code table by observe/bp-rows-emit
;; (671 rows, byte-parity witnessed 2026-09-02) and is parsed here ONCE
;; per process — FOL-BP-ROWS below is a once-hold. The registry
;; (blueprint-registry.json) stays the authority for coords; the rows
;; file is the reviewed admission list, regenerable and diffable
;; instead of hand-edited in code (its row provenance lives in git
;; history and the receipts that healed each drift). A missing or
;; unreadable file is a LOUD form_error, never an empty table — an
;; empty table would answer every lookup with "unreviewed" and read
;; like review instead of like absence.
(defn fol-rows-int (t i end acc)
    (if (ge i end) acc
        (fol-rows-int t (add i 1) end (add (mul acc 10) (sub (str_byte_at t i) 48)))))
(defn fol-rows-seek (t i b)
    (if (ge i (str_len t)) i
        (if (eq (str_byte_at t i) b) i (fol-rows-seek t (add i 1) b))))
(defn fol-rows-parse-row (t i nl)
    (do (let s1 (fol-rows-seek t i 32))
        (let s2 (fol-rows-seek t (add s1 1) 32))
        (let s3 (fol-rows-seek t (add s2 1) 32))
        (let s4 (fol-rows-seek t (add s3 1) 32))
        (fol-bp-row (substring t i s1)
                    (fol-rows-int t (add s1 1) s2 0)
                    (fol-rows-int t (add s2 1) s3 0)
                    (fol-rows-int t (add s3 1) s4 0)
                    (fol-rows-int t (add s4 1) nl 0))))
(defn fol-rows-parse (t i acc)
    (if (ge i (str_len t)) acc
        (do (let nl (fol-rows-seek t i 10))
            (fol-rows-parse t (add nl 1) (cons (fol-rows-parse-row t i nl) acc)))))
(defn fol-rows-reverse (xs acc)
    (if (eq (len xs) 0) acc (fol-rows-reverse (tail xs) (cons (head xs) acc))))
(defn FOL-BP-BOOTSTRAP-TABLE ()
    (do (let t (read_file (fol-rows-path)))
        (if (nothing? t)
            (form_error "fol-bp: bootstrap rows file unreadable (run from the repo root): form/form-stdlib/form-ontology-bootstrap.rows")
            (fol-rows-reverse (fol-rows-parse t 0 (empty)) (empty)))))

(defn fol-bp-lookup (rows name)
    (if (eq (len rows) 0) (empty)
        (if (str_eq (head (head rows)) name)
            (head rows)
            (fol-bp-lookup (tail rows) name))))

;; The table, built ONCE at unit load and held — the same top-level-let
;; hold form-ontology-source-categories.fk and source-compiler.fk already
;; use for their derived tables. Before this let, every bp/fol-bp lookup
;; re-called (FOL-BP-BOOTSTRAP-TABLE) and re-built all rows: the heat
;; door witnessed 31.6M fol-bp-row dispatches in ONE cold .bml compile
;; (2026-09-02), all echo. A pure table is built once and held by name.
(let FOL-BP-ROWS (FOL-BP-BOOTSTRAP-TABLE))

(defn fol-bp-pkg (row)   (head (tail row)))
(defn fol-bp-level (row) (head (tail (tail row))))
(defn fol-bp-type (row)  (head (tail (tail (tail row)))))
(defn fol-bp-inst (row)  (head (tail (tail (tail (tail row))))))

(defn bp (name)
    (do
        (let row (fol-bp-lookup FOL-BP-ROWS name))
        (if (eq (len row) 0)
            (form_error (str_concat "bp: unreviewed bootstrap name: " name))
            (make_nodeid (fol-bp-pkg row) (fol-bp-level row)
                         (fol-bp-type row) (fol-bp-inst row)))))

(defn fol-bp-known? (name)
    (if (eq (len (fol-bp-lookup FOL-BP-ROWS name)) 0) 0 1))

;; fol-bp — the same resolution as `bp` above, under a name the KERNEL DOES NOT OWN.
;;
;; `bp` is a native in fkwu's optable (flt-ops row, tag 45) and in call position the
;; primitive wins, so the Form `bp` defined above never runs on this kernel. Worse, the
;; native is a pass-through: tag 45 evaluates to its argument unchanged, so `(bp "NAME")`
;; hands back the interned STRING, and `(bp "ZZZ-NOT-A-REVIEWED-NAME")` answers 902 where
;; the Form version would raise form_error. A caller comparing that against a real NodeID
;; gets a silent mismatch — measured on hex.fk, whose sentinel could never equal the
;; NodeID its own band constructs.
;;
;; The native is not removed: many cells call `bp` without preluding this loader, and
;; deleting the flt-ops row would turn a wrong-but-answering call into a hard
;; unresolved-call across them. Nor is the stub taught to resolve in C — that is runtime
;; meaning, and it belongs here. So the resolution keeps ONE home (this registry) and
;; gains a second door whose name no primitive shadows. Cells that need a blueprint
;; NodeID that is actually a NodeID call `fol-bp`; `bp` keeps its callers and its floor.
(defn fol-bp (name)
    (do
        (let row (fol-bp-lookup FOL-BP-ROWS name))
        (if (eq (len row) 0)
            (form_error (str_concat "fol-bp: unreviewed bootstrap name: " name))
            (make_nodeid (fol-bp-pkg row) (fol-bp-level row)
                         (fol-bp-type row) (fol-bp-inst row)))))

