        ;; UUID and UUID-PARSE-ERROR, 2026-08-17. uuid.fk asks for both through
        ;; `bp` and this mirror did not carry either, so uuid-band answered 15 on
        ;; fkwu and TypeScript and CRASHED Go and Rust with "unreviewed bootstrap
        ;; name: UUID" — on fkwu `bp` is a native (tag 45) that passes its argument
        ;; through, so the reviewing Form `bp` below only ever runs on the two arms
        ;; that lack the native. Two kernels RAN a review the other two could never
        ;; reach, and the registered 15 was the number the unreviewing arms gave.
        ;; Coords TAKEN from blueprint-registry.json, not minted: UUID is 1/2/99/1870
        ;; there (aliased ARRIVAL, "the arrival event/context", reuse 2) and
        ;; UUID-PARSE-ERROR is 1/2/99/1871 (aliased under ARRIVAL-QUALITY). The
        ;; registry is the authority; this table is its hand-held mirror and had drifted.
        ;; VALUE-NONE, 2026-08-19: fourth-shim's _dict_get answers this node on a
        ;; miss where host kernels answer null -- json's null-check needs the name
        ;; resolvable on every arm. Coords from blueprint-registry.json (1/2/99/1399).
        (fol-bp-row "VALUE-NONE" 1 2 99 1399)
        (fol-bp-row "UUID" 1 2 99 1870)
        (fol-bp-row "UUID-PARSE-ERROR" 1 2 99 1871)
        ;; CONTROL-INVITE, R27 (2026-09-03). grammars/control-invite-grammar.fk
        ;; mints ONE blueprint, CONTROL-INVITE, and its band's node_category claim
        ;; compared it via `bp` — fkwu's native pass-through — against the SAME
        ;; native call on both sides, so a green 1023 was two identical STRINGS
        ;; matching, never a NodeID. bmf-core.fk's own bmf-bp later started
        ;; answering an unregistered name with a real (make_nodeid 0 0 0 0)
        ;; instead of the raw string (the 2026-08-14 natural-language-pivot fix,
        ;; same file), and that honest zero no longer coincided with the string,
        ;; dropping the band to 959. CONTROL-INVITE had NO entry anywhere --
        ;; not blueprint-registry.json, not this mirror, not bmf-core.fk's own
        ;; bmf-bp-table -- confirmed by grep before adding it here. Coord TAKEN
        ;; from blueprint-registry.json (1/2/99/1950, added there first), placed
        ;; beside the OAC-* family (1946-1949) it sits downstream of. See
        ;; receipts/2026-09-03-r27-control-invite-bp-coordinate.md.
        (fol-bp-row "CONTROL-INVITE" 1 2 99 1950)
        ;; CHANNEL family, R73 (2026-09-04). channel.fk binds its four blueprints
        ;; with (bp "CHANNEL-..."), and json.fk preludes this file, so every cell
        ;; carrying json.fk + channel.fk (channel-band, channel-breath-band) runs
        ;; the Form `bp` above on Go and Rust -- which refused CHANNEL-V0 as
        ;; unreviewed. The name was never unregistered: blueprint-registry.json
        ;; has carried it at 1/2/99/1700 since the phase-1 import, and all three
        ;; bp_table projections agree. It was never ADMITTED here, the runtime
        ;; authority. TS answered 500 (its native bp won over this defn), fkwu
        ;; 200 (native pass-through; its missing 300 are write_form_binary/
        ;; read_form_binary, a lane seam, not a coordinate). Coords TAKEN from
        ;; blueprint-registry.json -- the whole registered family, so this mirror
        ;; stops holding half of one. See
        ;; receipts/2026-09-04-r73-channel-family-bootstrap-admission.md.
        (fol-bp-row "CHANNEL-BREATH-GIFT"       1 2 99 6)
        (fol-bp-row "CHANNEL-RESONANCE-RECEIPT" 1 2 99 7)
        (fol-bp-row "CHANNEL-V0"                1 2 99 1700)
        (fol-bp-row "CHANNEL-MSG"               1 2 99 1701)
        (fol-bp-row "CHANNEL-OSI-LAYER"         1 2 99 1702)
        (fol-bp-row "CHANNEL-FLOW"              1 2 99 1703)))


;; fol-bp-coords -- the mirror as a DECISION CHAIN, generated from the rows
;; above (2026-09-02). The first NAMED heat reading caught the bootstrap
;; compiler constructing the whole 671-row table per resolution: 22.6M
;; fol-bp-row dispatches in ONE .bml compile, ~135M cons mints of churn.
;; Top-level let is call-by-name on this arm (once-hold not yet home), so
;; build-once cannot hold the table; this chain constructs NOTHING until
;; the row is found -- pure Form, four-way portable, same refusal shape
;; (an unknown name answers empty). fol-bp-lookup and the table stay for
;; enumeration callers; resolution rides the chain.
(defn fol-bp-coords (name)
    (if (str_eq name "do") (list "do" 1 2 9 1)
    (if (str_eq name "sequence") (list "sequence" 1 2 9 2)
    (if (str_eq name "let") (list "let" 1 2 9 3)
    (if (str_eq name "if-then") (list "if-then" 1 2 11 1)
    (if (str_eq name "if") (list "if" 1 2 11 2)
    (if (str_eq name "match") (list "match" 1 2 19 1)
    (if (str_eq name "fndef") (list "fndef" 1 2 31 1)
    (if (str_eq name "fncall") (list "fncall" 1 2 32 1)
    (if (str_eq name "ident") (list "ident" 1 2 33 1)
    (if (str_eq name "add") (list "add" 1 2 12 1)
