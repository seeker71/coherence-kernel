; form-cli-model-generate.fk — selected GGUF to Form-native Qwen3.5/Qwen3.8 generation.
;
; The selected path is admitted by a whole-file Form/M4 SHA-256 seal before any
; tensor is mapped.  Architecture, context, tensor geometry, tokenizer, stop ids,
; and required byte extent are read from that GGUF.  Form emits the MSL at runtime;
; the linked Metal carrier JIT-compiles it for the device that answered metal_status.
;
; The compatibility qfl wrappers add no behavior here; this generator and the
; REPL call the canonical form-teach-layer API directly.
;
; preludes: form-stdlib/qwen35-tokfast-v2.fk form-stdlib/qwen35-encode-indexed.fk form-stdlib/qwen35-tokenizer.fk form-stdlib/qwen35-tokenizer-live-cursor.fk form-stdlib/form-teach-layer.fk form-stdlib/local-model-choice.fk form-stdlib/local-generate-organ.fk form-stdlib/qwen35-artifact-seal-reader.fk native/metal/qwen35-dense-token-handle.fk native/metal/qwen35-crystal.fk native/metal/model-bandwidth.fk form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/knowledge-rest-answer.fk form-stdlib/language-template.fk form-stdlib/form-cli-heedmark.bml form-stdlib/form-cli-heed-cursor.fk form-stdlib/form-cli-heed-telemetry.fk
; preludes: form-stdlib/form-cli-heed-current-source.fk form-stdlib/form-cli-heed-grounded.fk

(do
    (defn fcmg-src (path) (eqr-of-file path 0 40000000))
    (defn fcmg-arch (src) (gmt-str src "general.architecture"))
    (defn fcmg-q35-stops (src)
        (list (gmt-u32 src "tokenizer.ggml.eos_token_id")
              (q35-special-id src "<|im_end|>")))
    (defn fcmg-field (name value)
        (str_concat name (str_concat "=" value)))
    (defn fcmg-line (name value)
        (str_concat (fcmg-field name value) "\n"))
    ; A local generation has long carrier calls. Speak the bounded stage before
    ; entering one, and retain the same opaque stage in this process's
    ; framebuffer. These are progress coordinates, never prompt, answer, path,
    ; or model bytes. `print_str` is the kernel's flushed event door, so a
    ; form-run reader can see the admitted next wait while the call is still
    ; executing; `fb_record` leaves the attributed post-turn trace available to
    ; Form itself. A synchronous Metal primitive cannot be inspected from this
    ; evaluator thread while it is inside the primitive — that future/poll seam
    ; remains named rather than being dressed up as an asynchronous event.
    (defn fcmg-live-stage (stage source-coordinate)
        (do
            (fb_record (intern_trivial_string stage)
                "form-cli-model-generate.fk" source-coordinate)
            (print_str (str_concat "<|form:stage|>"
                (str_concat stage "<|/form:stage|>\n")))
            0))
    (defn fcmg-name (src)
        (do (let n (gmt-str src "general.name"))
            (if (str_eq n "") "(header names no model)" n)))
    (defn fcmg-status-count (statuses wanted)
        (if (nil? statuses) 0
            (add (if (str_eq (head statuses) wanted) 1 0)
                 (fcmg-status-count (tail statuses) wanted))))
    (defn fcmg-source-search-record? (record)
        (if (or (str_eq (fhc-record-status record) "hit")
                (str_eq (fhc-record-status record) "miss")) 1
            (if (str_eq (fhc-record-reason record)
                    "observation-budget-exceeded-after-source-search") 1 0)))
    (defn fcmg-source-searches (records)
        (if (nil? records) 0
            (add (fcmg-source-search-record? (head records))
                 (fcmg-source-searches (tail records)))))
    (defn fcmg-empty-heed-record () (fhc-record "" "" "" ""))
    (defn fcmg-first-record (records)
        (if (nil? records) (fcmg-empty-heed-record) (head records)))
    (defn fcmg-source-record (records)
        (if (nil? records) (fcmg-empty-heed-record)
            (if (eq (fcmg-source-search-record? (head records)) 1) (head records)
                (fcmg-source-record (tail records)))))
    (defn fcmg-evidence-record (records)
        (do
            (let source (fcmg-source-record records))
            (if (str_eq (fhc-record-status source) "")
                (fcmg-first-record records) source)))
    (defn fcmg-span-field (span name)
        (do
            (let marker (str_concat "\n" (str_concat name "=")))
            (let at (str_find span marker 0))
            (if (lt at 0) ""
                (do
                    (let start (add at (str_len marker)))
                    (let end (str_find span "\n" start))
                    (substring span start (if (lt end 0) (str_len span) end))))))
    (defn fcmg-record-bound-source? (record source-path source-artifact)
        (if (eq (fcmg-source-search-record? record) 0) 0
            (if (and (str_eq (fcmg-span-field (fhc-record-span record)
                                  "source-path") source-path)
                     (str_eq (fcmg-span-field (fhc-record-span record)
                                  "source-artifact") source-artifact)) 1 0)))
    (defn fcmg-bound-source-matches (records source-path source-artifact)
        (if (nil? records) 0
            (add (fcmg-record-bound-source? (head records)
                     source-path source-artifact)
                 (fcmg-bound-source-matches (tail records)
                     source-path source-artifact))))
    (defn fcmg-heed-budget () (fhcs-lookup-limit))
    ; q35 byte fallback cannot produce more ids than input bytes. Reserve the
    ; bounded rendered observation once, plus the small ChatML role crossing
    ; that closes the querying assistant turn, carries the Form observation as
    ; a tool turn, and opens a fresh assistant answer.
    (defn fcmg-heed-context-reserve ()
        (mul (fcmg-heed-budget) (add (fkqt-max-render-bytes) 96)))
    (defn fcmg-current-source-query-budget () (fhm-query-budget))
    (defn fcmg-current-source-answer-reserve () (fhm-answer-reserve))
    ; `n` is the old fungible tail. query and answer are the explicit two-ledger
    ; tail. A recursive query consumes the current answer reserve, then a typed
    ; observation opens a fresh reserve, so every allowed heed is bounded here.
    (defn fcmg-context-tail-reserve (n query answer)
        (add n (add query
            (add (mul (fcmg-heed-budget) answer)
                 (fcmg-heed-context-reserve)))))
    (defn fcmg-tail-budget-ok? (n query answer)
        (if (and (gt n 0) (and (eq query 0) (eq answer 0))) 1
            (if (and (eq n 0) (and (gt query 0) (gt answer 0))) 1 0)))
    (defn fcmg-context-need (prompt-n thought-n gap-total n query answer)
        (add (add (add prompt-n thought-n) gap-total)
             (fcmg-context-tail-reserve n query answer)))
    (defn fcmg-heed-ledger-report (c)
        (str_concat (fcmg-line "heed_phase" (int_to_str (fhc-phase c)))
        (str_concat (fcmg-line "heed_query_budget"
            (int_to_str (add (fhc-query-tokens c)
                (add (fhc-query-left c) (fhc-cut c)))))
        (str_concat (fcmg-line "heed_answer_reserve"
            (int_to_str (fhc-answer-cap c)))
        (str_concat (fcmg-line "heed_query_tokens" (int_to_str (fhc-query-tokens c)))
        (str_concat (fcmg-line "heed_answer_tokens" (int_to_str (fhc-answer-tokens c)))
        (str_concat (fcmg-line "heed_query_left" (int_to_str (fhc-query-left c)))
        (str_concat (fcmg-line "heed_answer_left" (int_to_str (fhc-answer-left c)))
        (str_concat (fcmg-line "heed_query_fuel_cut" (int_to_str (fhc-cut c)))
        (str_concat (fcmg-line "heed_answer_fuel_cut" (int_to_str (fhc-answer-cut c)))
        (str_concat (fcmg-line "heed_stream_bytes" (int_to_str (fhc-bytes c)))
        (str_concat (fcmg-line "heed_decode_timeout" (int_to_str (fhc-timeout? c)))
        (str_concat (fcmg-line "heed_stopped" (int_to_str (fhc-stopped? c)))
                    (fcmg-line "heed_frame_refusals"
                        (int_to_str (fhc-frame-refusals c))))))))))))))))
    (defn fcmg-heed-report-at (c root root-status)
        (do
        (let records (fhc-records c))
        (let evidence (fcmg-evidence-record records))
        (let searches (fcmg-source-searches records))
        (let evidence-path (fcmg-span-field (fhc-record-span evidence) "source-path"))
        (let evidence-artifact (fcmg-span-field (fhc-record-span evidence)
                                  "source-artifact"))
        (let bound-matches (fcmg-bound-source-matches records
                               evidence-path evidence-artifact))
        (str_concat (fcmg-line "heed_cursor" "bounded-current-source-v1")
        (str_concat (fcmg-line "heed_lookup_budget" (int_to_str (fcmg-heed-budget)))
        (str_concat (fcmg-line "heed_lookup_budget_remaining" (int_to_str (fhc-budget c)))
        (str_concat (fcmg-line "heed_honor_attempts" (int_to_str (fhc-attempts c)))
        (str_concat (fcmg-line "heed_lookups" (int_to_str searches))
        (str_concat (fcmg-line "heed_source_searches" (int_to_str searches))
        (str_concat (fcmg-line "heed_bound_source_matches" (int_to_str bound-matches))
        (str_concat (fcmg-line "heed_bound_source_mismatches"
            (int_to_str (sub searches bound-matches)))
        (str_concat (fcmg-line "heed_honored" (int_to_str (len (fhc-honored c))))
        (str_concat (fcmg-line "heed_hits"
            (int_to_str (fcmg-status-count (fhc-honored c) "hit")))
        (str_concat (fcmg-line "heed_misses"
            (int_to_str (fcmg-status-count (fhc-honored c) "miss")))
        (str_concat (fcmg-line "heed_nothings"
            (int_to_str (fcmg-status-count (fhc-honored c) "nothing")))
        (str_concat (fcmg-line "heed_spent"
            (int_to_str (fcmg-status-count (fhc-honored c) "spent")))
        (str_concat (fcmg-line "heed_injected_tokens" (int_to_str (fhc-injected c)))
        (str_concat (fcmg-line "heed_close_commits" (int_to_str (fhc-close-commits c)))
        (str_concat (fcmg-line "heed_terminal_forwards" (int_to_str (fhc-terminal-forwards c)))
        (str_concat (fcmg-line "heed_injection_refusals" (int_to_str (fhc-injection-refusals c)))
        (str_concat (fcmg-line "heed_window_bytes" (int_to_str (str_len (fhc-window c))))
        (str_concat (fcmg-line "heed_evidence_status" (fhc-record-status evidence))
        (str_concat (fcmg-line "heed_evidence_reason" (fhc-record-reason evidence))
        (str_concat (fcmg-line "heed_source_path"
            (fkqt-clip evidence-path (fkqt-max-source-bytes)))
        (str_concat (fcmg-line "heed_source_artifact"
            (fkqt-clip evidence-artifact 96))
        (str_concat (fcmg-line "heed_answer_key"
            (fkqt-clip (fcmg-span-field (fhc-record-span evidence) "answer-key") 80))
        (str_concat (fcmg-line "heed_source_root_status" root-status)
        (str_concat (fcmg-line "heed_source_root" (fkqt-clip root 192))
        (str_concat (fcmg-heed-ledger-report c)
                    (fcmg-line "heed_model_executed" (int_to_str (fhc-model-executed)))))))))))))))))))))))))))))))
    (defn fcmg-heed-report (c)
        (fcmg-heed-report-at c (fhcs-default-root) (fhcs-root-status)))
    (defn fcmg-report-count (model arch prompt-n out text thought-eval thought-offers thought-n forwards busy-us prefill-us decode-us weight-bytes heed)
        (do
            (let effective-gbps-x10
                (if (gt busy-us 0)
                    (div (mul (mul weight-bytes forwards) 10) (mul busy-us 1000)) 0))
            (let decode-forwards
                (add (add (if (gt (len out) thought-n) (sub (sub (len out) thought-n) 1) 0)
                          (fhc-injected heed))
                     (add (fhc-close-commits heed) (fhc-terminal-forwards heed))))
            (let prefill-tokps-x1000
                (if (gt prefill-us 0) (div (mul (add prompt-n thought-n) 1000000000) prefill-us) 0))
            (let decode-tokps-x1000
                (if (and (gt decode-us 0) (gt decode-forwards 0))
                    (div (mul decode-forwards 1000000000) decode-us) 0))
            (let end-to-end-tokps-x1000
                (if (gt busy-us 0) (div (mul (len out) 1000000000) busy-us) 0))
            ; the walker's own heat total, printed so the two walkers'
            ; visit counts can be compared for the same work (kernel_stat 3
            ; is the hottest arm's count — identical metric on both arms).
            (str_concat (fcmg-line "hottest_arm_count" (int_to_str (kernel_stat 3)))
            (str_concat (fcmg-line "backend" "form-native-metal-jit")
            (str_concat (fcmg-line "form-layer" (if (eq (ftl-armed?) 1) "on" "off"))
            (str_concat (fcmg-line "model" model)
            (str_concat (fcmg-line "architecture" arch)
            (str_concat (fcmg-line "mode" (lmc-mode arch))
            (str_concat (fcmg-line "thought-kernel" "source-resonance-stream")
            (str_concat (fcmg-line "thought-eval" thought-eval)
            (str_concat (fcmg-line "thought-offers" (int_to_str thought-offers))
            (str_concat (fcmg-line "thought-tokens" (int_to_str thought-n))
            (str_concat (fcmg-line "prompt_tokens" (int_to_str prompt-n))
            (str_concat (fcmg-line "generated_tokens" (int_to_str (len out)))
            (str_concat (fcmg-line "forward_passes" (int_to_str forwards))
            (str_concat (fcmg-line "weight_bytes_per_forward" (int_to_str weight-bytes))
            (str_concat (fcmg-line "gpu_busy_us" (int_to_str busy-us))
            (str_concat (fcmg-line "prefill_gpu_busy_us" (int_to_str prefill-us))
            (str_concat (fcmg-line "decode_gpu_busy_us" (int_to_str decode-us))
            (str_concat (fcmg-line "decode_forward_passes" (int_to_str decode-forwards))
            (str_concat (fcmg-line "prefill_tokps_x1000" (int_to_str prefill-tokps-x1000))
            (str_concat (fcmg-line "decode_tokps_x1000" (int_to_str decode-tokps-x1000))
            (str_concat (fcmg-line "effective_weight_gbps_x10"
                (int_to_str effective-gbps-x10))
            (str_concat (fcmg-line "end_to_end_tokps_x1000"
                (int_to_str end-to-end-tokps-x1000))
            (str_concat (fcmg-heed-report heed)
                        (str_concat "text:\n" text))))))))))))))))))))))))))
    (defn fcmg-report (model arch ids out text thought-eval thought-offers thought-n forwards busy-us prefill-us decode-us weight-bytes heed)
        (fcmg-report-count model arch (len ids) out text thought-eval
            thought-offers thought-n forwards busy-us prefill-us decode-us
            weight-bytes heed))

    ; ── residence ─────────────────────────────────────────────────────────────
    ; A model admitted once should not be admitted again to answer a second
    ; sentence.  Measured on this M4 Max against Qwen3.8-27B-Q8_0 (2026-08-19,
    ; observe/qwen38-generate-phase-run.fk, and receipts/2026-08-19-omlx-in-the-standard-path.md):
    ; re-verifying the whole-file SHA-256 seal is 13.4 s, opening the tensor views
    ; and compiling the kernels is 15.6 s, and the GPU work of a 54-token prompt
    ; with ten generated tokens is 7.1 s.  Setup was four times the inference, and
    ; it was paid again on every single call.
    ;
    ; A residence is that admission, held: the sealed path, the position ceiling it
    ; was opened for, the opened context, and the header window and architecture
    ; read from it.  Nothing here is a mode or a switch — a caller that has no
    ; residence hands `fcmr-none` and gets the old open-run-close exactly, and a
    ; caller that keeps what it is handed back reuses it whenever the same file can
    ; still hold the next prompt.  The stream state is NOT part of it: state is what
    ; one conversation writes, so it is made and released per generation.
    (defn fcmr-mark () "fcmg-resident1")
    (defn fcmr (path maxpos ctx src arch) (list (fcmr-mark) path maxpos ctx src arch))
    (defn fcmr-none () (empty))
    (defn fcmr-live? (r)
        (if (eq (len r) 6) (if (str_eq (nth r 0) (fcmr-mark)) 1 0) 0))
    (defn fcmr-path (r) (nth r 1))
    (defn fcmr-maxpos (r) (nth r 2))
    (defn fcmr-ctx (r) (nth r 3))
    (defn fcmr-src (r) (nth r 4))
    (defn fcmr-arch (r) (nth r 5))
    ; The same file, and a ceiling this residence can still reach.  A longer prompt
    ; than the one it was opened for is not refused — it reopens, because the KV
    ; extent was derived from that first need and there is no knob to raise.
    (defn fcmr-fits? (r path need)
        (if (eq (fcmr-live? r) 1)
            (if (str_eq (fcmr-path r) path)
                (if (le need (fcmr-maxpos r)) 1 0) 0) 0))
    (defn fcmr-release-ok? (r)
        (if (eq (fcmr-live? r) 1)
            (if (eq (q38-close (fcmr-ctx r) (empty))
                    (q38-close-expected (fcmr-ctx r) (empty))) 1 0)
            1))

    ; Closing is part of the result.  A run that generated text but did not
    ; release every model/state handle is reported as refused, never hidden.
    (defn fcmg-close-result (ctx sts report)
        (do
            (let expected (q38-close-expected ctx sts))
            (let closed (q38-close ctx sts))
            (if (eq closed expected) report
                (str_concat "generation refused: model handle close mismatch; closed="
                    (str_concat (int_to_str closed)
                        (str_concat ";expected=" (int_to_str expected)))))))

    (defn fcmg-open-refusal (ctx detail)
        (fcmg-close-result ctx (empty)
            (str_concat "generation refused: "
                (str_concat detail (str_concat "; " (metal_status))))))

    ; The state half of the same honesty: a generation that ran but did not release
    ; every state handle is reported as refused.  The model handles are not touched
    ; here — they belong to the residence, which outlives this sentence.
    (defn fcmg-state-close-result (sts report)
        (do
            (let expected (q38-state-handle-count sts))
            (let closed (q38-free-state sts))
            (let release-report (str_concat "\nstate_released="
                (str_concat (if (eq closed expected) "1" "0")
                (str_concat "\nstate_handles_closed="
                (str_concat (int_to_str closed)
                (str_concat "\nstate_handles_expected="
                (str_concat (int_to_str expected) "\n")))))))
            (if (eq closed expected) (str_concat release-report report)
                (str_concat release-report
                    (str_concat
                        "generation refused: state handle close mismatch; closed="
                        (str_concat (int_to_str closed)
                            (str_concat ";expected="
                                (int_to_str expected))))))))

    ; Encode every evaluated thought into tokenizer ids (left-to-right).
    (defn fcmg-encode-thoughts (src thoughts acc)
        (if (eq (len thoughts) 0) (lg-rev acc (empty))
            (fcmg-encode-thoughts src (tail thoughts)
                (cons (q35-encode src (lg-thought-text (head thoughts))) acc))))

    (defn fcmg-id-count (lists n)
        (if (eq (len lists) 0) n
            (fcmg-id-count (tail lists) (add n (len (head lists))))))

    (defn fcmg-flat-ids (lists acc)
        (if (eq (len lists) 0) acc
            (fcmg-flat-ids (tail lists) (tkz-cat acc (head lists)))))

    ; ── resident live heed tail ───────────────────────────────────────────
    ; The thought offers above remain the prefill/gap source. This tail is
    ; only the model's final resident decode: decoded ids stream through one
    ; bounded cursor, a complete query may spend one current-source lookup, and
    ; the typed observation re-enters through incremental prefill.
    ; The resident current-source cursor and the experimental prefill carrier
    ; share one context. Source identity and carrier chunk are separate fields:
    ; neither is smuggled through model prose or collapsed into the other.
    (defn fcmg-heed-ctx-full
        (ps bs geo lays sts embTv onormTv projTv src source-hint chunk tfx)
        (list ps bs geo lays sts embTv onormTv projTv src source-hint chunk tfx))
    (defn fcmg-heed-ctx (ps bs geo lays sts embTv onormTv projTv src tfx)
        (fcmg-heed-ctx-full ps bs geo lays sts embTv onormTv projTv src "" 1 tfx))
    (defn fcmg-heed-ctx-hinted
        (ps bs geo lays sts embTv onormTv projTv src source-hint tfx)
        (fcmg-heed-ctx-full ps bs geo lays sts embTv onormTv projTv
            ; The live three-way witness kept output SHA, hit, 26/32 answer
            ; shape and 385 injected ids identical at chunk 0 while reducing
            ; carrier settlements 506 -> 61. Current-source observations use
            ; that measured span node; explicit probes can still choose 1/-1.
            src source-hint 0 tfx))
    ; The tokenizer index rides the handle; a handle built before the index
    ; existed answers an absent one and every encode falls back to the
    ; reference lane — ice is a speed, never a gate.
    (defn fcmg-heed-index (ctx)
        (if (gt (len ctx) 11) (nth ctx 11)
            (qtf2-index-empty "absent" "unthreaded" "")))
    (defn fcmg-heed-source-hint (ctx)
        (if (gt (len ctx) 9) (nth ctx 9) ""))
    (defn fcmg-heed-chunk (ctx)
        (if (gt (len ctx) 10) (nth ctx 10) 1))
    (defn fcmg-heed-step (ctx id pos)
        (q38-forward (nth ctx 0) (nth ctx 1) (nth ctx 2) (nth ctx 3)
            (nth ctx 4) (nth ctx 5) (nth ctx 6) (nth ctx 7) id pos))
    (defn fcmg-heed-prefill (ctx ids pos)
        (q38-prefill-chunked (nth ctx 0) (nth ctx 1) (nth ctx 2) (nth ctx 3)
            (nth ctx 4) (nth ctx 5) (nth ctx 6) (nth ctx 7) ids pos
            (fcmg-heed-chunk ctx)))
    (defn fcmg-heed-decode (ctx ids) (tkz-decode-text (nth ctx 8) ids))
    ; The cursor stays model-neutral; this encoder owns Qwen's role grammar.
    ; Raw observation bytes appended inside the assistant turn made the live
    ; model emit its end token immediately after a successful source hit. Close
    ; that turn, offer the typed Form observation as a tool message, then open a
    ; fresh assistant turn with the same no-think prefix used by q35-chat-ids.
    (defn fcmg-heed-encode (ctx text)
        (do
            (let src (nth ctx 8))
            (let tfx (fcmg-heed-index ctx))
            (let ims (qei-special-id src tfx "<|im_start|>"))
            (let ime (qei-special-id src tfx "<|im_end|>"))
            (let ths (qei-special-id src tfx "<think>"))
            (let the (qei-special-id src tfx "</think>"))
            (tkz-cat (q35-one ime)
            (tkz-cat (qei-encode src tfx "\n")
            (tkz-cat (q35-one ims)
            (tkz-cat (qei-encode src tfx "tool\n")
            (tkz-cat (qei-encode src tfx text)
            (tkz-cat (q35-one ime)
            (tkz-cat (qei-encode src tfx "\n")
            (tkz-cat (q35-one ims)
            (tkz-cat (qei-encode src tfx "assistant\n")
            (tkz-cat (q35-one ths)
            (tkz-cat (qei-encode src tfx "\n\n")
            (tkz-cat (q35-one the)
                     (qei-encode src tfx "\n\n")))))))))))))))
    (defn fcmg-heed-bound-honor (h)
        (if (gt (str_len (nth h 1)) (fkqt-max-render-bytes))
            ; The span remains only as bounded report evidence. `nothing` makes
            ; fhc-span-of inject no bytes, while the reason retains that one
            ; real source search already occurred.
            (list "nothing" (nth h 1)
                  "observation-budget-exceeded-after-source-search") h))
    ; A query surface the body already holds as a resting answer is honored
    ; from the registry BEFORE any source search: the observation injected is
    ; the recipe and its forced value ("(add 40 2)=42") — compact, exact, and
    ; costing no source IO. The force here is the pure tree-walk; the heat
    ; gate's home is the resident's durable state, where repeated demand can
    ; actually accumulate (rest-force-jit carries that door). An unknown
    ; surface falls through to the existing source lookup unchanged.
    ; The lookup receives the FULL marked frame; the rest registries match
    ; BARE inner text. Without this strip the rest lanes were a numb-green:
    ; wired, banded, and unable to fire on the live door (caught 2026-08-30
    ; by reading fhc-honor's frame contract, not by any band).
    (defn fcmg-heed-frame-inner (surface)
        (do
            (let o (str_find surface (HeedOpen) 0))
            (if (lt o 0) surface
                (do
                    (let start (add o (str_len (HeedOpen))))
                    (let c (str_find surface (HeedClose) start))
                    (if (lt c 0) (substring surface start (str_len surface))
                        (substring surface start c))))))
    (defn fcmg-heed-rest-honor (surface-frame)
        (do
            (let surface (fcmg-heed-frame-inner surface-frame))
            (let p (kra-answer surface))
            (if (eq (nothing? p) 0)
                (list "hit"
                    (str_concat (lg-defer-text p)
                        (str_concat "=" (int_to_str (lg-force p))))
                    "rest-answer")
                (do
                    (let w (kra-corpus-word surface))
                    (if (nothing? w) (nothing)
                        (list "hit" w "corpus-rest-answer"))))))
    (defn fcmg-heed-lookup (ctx surface local-ready)
        (do
            (let rest (fcmg-heed-rest-honor surface))
            (if (eq (nothing? rest) 0) rest
                (do
                    (let source (fcmg-heed-source-hint ctx))
                    (fcmg-heed-bound-honor
                        (if (eq (fhcs-relative-source-path? source) 1)
                            (fhcs-lookup-bound ctx surface local-ready source)
                            (fhcs-lookup ctx surface local-ready)))))))
    (defn fcmg-heed-tail
        (src ps bs geo lays sts embTv onormTv projTv first pos n stops tfx)
        (do
            (let ctx (fcmg-heed-ctx ps bs geo lays sts embTv onormTv projTv src tfx))
            (fhc-run-decoded-first ctx
                fcmg-heed-step fcmg-heed-prefill fcmg-heed-decode
                fcmg-heed-encode fcmg-heed-lookup 1
                first pos n stops (fhc-fresh (fcmg-heed-budget)) (empty))))
    (defn fcmg-heed-tail-2p
        (src ps bs geo lays sts embTv onormTv projTv first pos stops query reserve
             source-hint tfx)
        (do
            (let ctx (fcmg-heed-ctx-hinted ps bs geo lays sts embTv onormTv projTv
                src source-hint tfx))
            (fhc-run-seeded-2p ctx
                fcmg-heed-step fcmg-heed-prefill fcmg-heed-decode
                fcmg-heed-encode fcmg-heed-lookup 1 first pos stops
                (fcmg-heed-budget) query reserve)))

    ; Offer → commit → optional gap decode → next offer.
    ; Returns (first pos stream-ids thought-n offers).
    ; stream-ids is chronological: thought, gap, thought, ...
    (defn fcmg-offer-stream (ps bs geo lays sts embTv onormTv projTv
                             thought-lists pos gap-n stops stream thought-n offers)
        (if (eq (len thought-lists) 0)
            (list (sub 0 1) pos stream thought-n offers)
            (do
                (let ids (head thought-lists))
                (let pf
                    (if (eq (len ids) 0)
                        (list (sub 0 1) pos)
                        (q38-prefill ps bs geo lays sts embTv onormTv projTv ids pos)))
                (let first (nth pf 0))
                (let next-pos (nth pf 1))
                (let rest (tail thought-lists))
                (let more (gt (len rest) 0))
                (let after-thought (tkz-cat stream ids))
                (let thought-n2 (add thought-n (len ids)))
                (if (and more (gt gap-n 0))
                    (do
                        (let gap-out
                            (if (or (lt first 0) (q38-stop? first stops)) (empty)
                                (cons first
                                    (q38-generate ps bs geo lays sts embTv onormTv projTv
                                        first next-pos (sub gap-n 1) stops (empty)))))
                        (let gap-pos (add next-pos (len gap-out)))
                        (fcmg-offer-stream ps bs geo lays sts embTv onormTv projTv
                            rest gap-pos gap-n stops
                            (tkz-cat after-thought gap-out)
                            thought-n2
                            (add offers 1)))
                    (if (eq (len rest) 0)
                        (list first next-pos after-thought thought-n2 (add offers 1))
                        (fcmg-offer-stream ps bs geo lays sts embTv onormTv projTv
                            rest next-pos gap-n stops after-thought thought-n2
                            (add offers 1)))))))

    ; ── the heedmark lane: knowledge lookup from the model's own stream ───────
    ; fcmg-offer-stream above injects spans, but its thought-lists are computed
    ; BEFORE generation begins — nothing the model emits can choose them. This
    ; lane closes that gap. form-cli-heed-cursor.fk drives one forward pass at a
    ; time, transmutes each emitted id to bytes in a bounded window, and when a
    ; complete <|form:knowledge-query|> envelope closes it offers the surface to
    ; a lookup and prefills the typed observation at the current position.
    ;
    ; NO LOGIT EXECUTED THE LOOKUP. q38-forward returns an argmax over a
    ; distribution and nothing else. The cursor recognized bytes; Form looked up;
    ; the answer re-entered as prefill. fhc-model-executed is 0 by construction.
    ;
    ; The five function values need the pipelines, buffers, geometry, layers,
    ; decode state and tensor views, and this dialect has no lambda — so they
    ; travel as one opaque ctx the cursor never opens.
    ; slot 9 is `chunk`: how many prefill positions may be in flight before the
    ; carrier is asked to settle. 1 is the barrier-per-position the lane has
    ; always had; larger is the question this body can answer about itself.
    ; This adapter receives the already-open model ctx. Its names stay distinct
    ; from the resident current-source ctx above: redefining the same functions
    ; silently changed their arities after a rebase and left each lane compiling
    ; only when the other one was absent.
    (defn fcmg-heed-bound-ctx (ctx sts src chunk)
        (list (nth ctx 0) (nth ctx 1) (nth ctx 2) (nth ctx 3) sts
              (nth ctx 4) (nth ctx 5) (nth ctx 6) src chunk (q38-ctx-span ctx)))
    (defn fcmg-heed-bound-step (h id pos)
        (q38-forward (nth h 0) (nth h 1) (nth h 2) (nth h 3) (nth h 4)
                     (nth h 5) (nth h 6) (nth h 7) id pos))
    (defn fcmg-heed-bound-prefill (h ids pos)
        (q38-prefill-chunked-span (nth h 0) (nth h 1) (nth h 2) (nth h 3) (nth h 4)
                             (nth h 5) (nth h 6) (nth h 7) ids pos (nth h 9) (nth h 10)))
    (defn fcmg-heed-bound-decode (h ids) (tkz-decode-text (nth h 8) ids))
    (defn fcmg-heed-bound-encode (h text) (q35-encode (nth h 8) text))

    ; The default substrate answers `nothing` for every envelope — axiom-1, and
    ; it is what an unconfigured host honestly holds. It performs no IO, so this
    ; file names no index and no ABI and preflights clean. A carrier that has a
    ; knowledge substrate passes its own lookupf instead; the fkqt adapter in
    ; form-cli-heed-fkqt.fk is that function value for the typed
    ; form-knowledge-query-token ABI.
    (defn fcmg-heed-lookup-nothing (h surface local-ready)
        (list "nothing" "" "no-knowledge-substrate"))

    ; Prefill the prompt ONCE and carry both of its answers: the first token and
    ; the position after the prompt. An earlier draft took the first token from
    ; the prefill and the position from a parameter — the cursor then walked
    ; from a position the KV rows had never been written at.
    ; Two ledgers, not one. `query` is what the model may spend composing a
    ; knowledge query; `reserve` opens only after a typed observation has
    ; actually been injected, and query verbosity can never reach it. A valid
    ; query that closes on its last query slot still gets a full reserve to
    ; answer from — which one fungible budget could not give it.
    (defn fcmg-heed-generate-2p (src ctx sts ids stops lookupf local-ready
                                 heeds query reserve chunk)
        (do
            (let pf (q38-prefill-chunked-span (nth ctx 0) (nth ctx 1) (nth ctx 2) (nth ctx 3) sts
                                 (nth ctx 4) (nth ctx 5) (nth ctx 6) ids 0 chunk
                                 (q38-ctx-span ctx)))
            (fhc-run-seeded-2p (fcmg-heed-bound-ctx ctx sts src chunk)
                fcmg-heed-bound-step fcmg-heed-bound-prefill
                fcmg-heed-bound-decode fcmg-heed-bound-encode
                lookupf local-ready
                (nth pf 0) (nth pf 1) stops heeds query reserve)))

    ; Compatibility delegate: the old fungible signature, unchanged in meaning.
    (defn fcmg-heed-generate (src ctx sts ids n stops lookupf local-ready budget)
        (do
            (let pf (q38-prefill (nth ctx 0) (nth ctx 1) (nth ctx 2) (nth ctx 3) sts
                                 (nth ctx 4) (nth ctx 5) (nth ctx 6) ids 0))
            (fhc-run-seeded (fcmg-heed-bound-ctx ctx sts src 1)
                fcmg-heed-bound-step fcmg-heed-bound-prefill
                fcmg-heed-bound-decode fcmg-heed-bound-encode
                lookupf local-ready
                (nth pf 0) (nth pf 1) n stops budget)))

    ; ── the live witness ──────────────────────────────────────────────────────
    ; Real weights, real forward passes, real tokenizer bytes through the cursor.
    ; Effectful: opens a sealed GGUF and drives the GPU. Do not preflight.
    (defn fcmg-heed-line (name value)
        (print_str (str_concat "heed " (str_concat name (str_concat "=" (str_concat value "\n"))))))
    (defn fcmg-heed-int (name value) (fcmg-heed-line name (int_to_str value)))
    (defn fcmg-heed-names (xs acc)
        (if (eq (len xs) 0) acc
            (fcmg-heed-names (tail xs)
                (str_concat acc (str_concat (if (str_eq acc "") "" ",") (head xs))))))

    ; Standalone live-witness printer. Kept distinct from fcmg-heed-report(c),
    ; which returns the structured current-source fields embedded in the normal
    ; generation report. Sharing the name made the two-argument printer shadow
    ; the one-argument reporter and collapsed an otherwise valid run to -1. It
    ; remains bounded and non-content: the held-out reply crosses only as the
    ; SHA-256 and byte count emitted by form-cli-heed-telemetry.fk.
    (defn fcmg-heed-witness-report (src r)
        (do
            (let c (fhc-cursor-of r))
            (fcmg-heed-int "model-tokens" (len (fhc-out r)))
            (fcmg-heed-int "end-pos" (fhc-pos r))
            (fcmg-heed-line "honored" (fcmg-heed-names (fhc-honored c) ""))
            (fht-report c (tkz-decode-text src (fhc-out r)))
            0))

    (defn fcmg-heed-report-with-content (src r)
        (do
            (fcmg-heed-witness-report src r)
            (fcmg-heed-line "output-content-NOT-HELD-OUT"
                (tkz-decode-text src (fhc-out r)))
            0))

    (defn fcmg-heed-witness-with (path prompt query reserve lookupf chunk)
        (do
            (let t-enter (now_unix_ms))
            (let gpu-enter (mbw-status-int (metal_status) "gpu_busy_us_total"))
            (let verdict (qaf-seal-verdict path))
            (let t-sealed (now_unix_ms))
            (if (not (eq verdict 1))
                (fcmg-heed-line "refused" (fcmg-seal-refusal verdict))
                (do
                    (let src (fcmg-src path))
                    (let arch (fcmg-arch src))
                    (let ids (fcmg-chat-ids src prompt))
                    (if (not (str_eq arch "qwen35"))
                        (fcmg-heed-line "refused" (str_concat "architecture=" arch))
                    (if (eq (len ids) 0)
                        (fcmg-heed-line "refused" "tokenizer produced no prompt tokens")
                        (do
                            (let model-max (gmt-u32 src (q38-key arch "context_length")))
                            ; both ledgers plus room for what gets injected
                            (let need (add (len ids) (add (add query reserve) 512)))
                            (let maxpos (if (lt need model-max) need model-max))
                            (let t-pre-open (now_unix_ms))
                            ; a layer-major walk holds every position of the span
                            (let span (if (lt chunk (sub 0 1)) 512 1))
                            (let ctx (q38-open-span path maxpos span))
                            (let t-opened (now_unix_ms))
                            (if (lt (len ctx) 10)
                                (fcmg-heed-line "refused"
                                    (str_concat "model context did not open; " (metal_status)))
                                (do
                                    (let sts (q38-new-state (nth ctx 2)))
                                    (if (not (eq (q38-state-ok? sts) 1))
                                        (fcmg-heed-line "refused"
                                            (str_concat "state allocation failed; " (metal_status)))
                                        (do
                                            (fcmg-heed-int "prompt-tokens" (len ids))
                                            (fcmg-heed-int "query-budget" query)
                                            (fcmg-heed-int "answer-reserve" reserve)
                                            (fcmg-heed-int "prefill-chunk" chunk)
                                            (fcmg-heed-int "scratch-span" span)
                                            (let t-pre-run (now_unix_ms))
                                            (let gpu-pre-run
                                                (mbw-status-int (metal_status) "gpu_busy_us_total"))
                                            (let syncs-pre-run
                                                (mbw-status-int (metal_status) "total_sync"))
                                            (let disp-pre-run
                                                (mbw-status-int (metal_status) "total_dispatch"))
                                            (let r (fcmg-heed-generate-2p src ctx sts ids
                                                        (fcmg-q35-stops src)
                                                        lookupf 1
                                                        (MaxHeeds) query reserve chunk))
                                            (metal_sync)
                                            (let t-done (now_unix_ms))
                                            (let gpu-done
                                                (mbw-status-int (metal_status) "gpu_busy_us_total"))
                                            (fcmg-heed-witness-report src r)
                                            (fcmg-heed-int "ms-seal" (sub t-sealed t-enter))
                                            (fcmg-heed-int "ms-header-read" (sub t-pre-open t-sealed))
                                            (fcmg-heed-int "ms-open" (sub t-opened t-pre-open))
                                            (fcmg-heed-int "ms-state" (sub t-pre-run t-opened))
                                            (fcmg-heed-int "ms-decode" (sub t-done t-pre-run))
                                            (fcmg-heed-int "ms-total" (sub t-done t-enter))
                                            (fcmg-heed-int "gpu-busy-us-decode" (sub gpu-done gpu-pre-run))
                                            (fcmg-heed-int "gpu-busy-us-setup" (sub gpu-pre-run gpu-enter))
                                            ; the stall, counted directly: how many
                                            ; times the carrier was asked to settle,
                                            ; and how many dispatches it carried.
                                            (fcmg-heed-int "carrier-syncs"
                                                (sub (mbw-status-int (metal_status) "total_sync") syncs-pre-run))
                                            (fcmg-heed-int "carrier-dispatches"
                                                (sub (mbw-status-int (metal_status) "total_dispatch") disp-pre-run))
                                            (fcmg-heed-int "positions-walked" (fhc-pos r))
                                            (q38-free-state sts)
                                            0)))))))))))

    ; ── live prompt cursor -> bounded Metal prefill ───────────────────────
    ; The cursor keeps at most one pre-tokenized piece.  Prefill keeps one token
    ; of lookahead so only the true final prompt position asks the LM head.
    ; Every `chunk` advanced positions settle and reopen the command buffer;
    ; neither prompt ids nor an unbounded command stream must exist first.
    (defn fcmg-live-pf (status first pos cursor reason)
        (list "fcmg-live-prefill" status first pos cursor reason))
    (defn fcmg-live-prefill-go (ctx sts cursor held pos in-batch chunk)
        (do
            (let one (qtlc-next cursor))
            (if (eq (qtlc-next-present? one) 1)
                (do
                    (q38-forward-state-after
                        (nth ctx 0) (nth ctx 1) (nth ctx 2) (nth ctx 3) sts
                        (nth ctx 4) held pos 1)
                    (let filled (add in-batch 1))
                    (if (ge filled chunk)
                        (do (metal_sync) (metal_batch_concurrent)) 0)
                    (fcmg-live-prefill-go ctx sts (qtlc-next-cursor one)
                        (qtlc-next-value one) (add pos 1)
                        (if (ge filled chunk) 0 filled) chunk))
                (if (str_eq (qtlc-next-status one) "done")
                    (do
                        (q38-forward-state-after
                            (nth ctx 0) (nth ctx 1) (nth ctx 2) (nth ctx 3) sts
                            (nth ctx 4) held pos 1)
                        (let first (q38-head-only
                            (nth ctx 0) (nth ctx 1) (nth ctx 2)
                            (nth ctx 5) (nth ctx 6)))
                        (fcmg-live-pf "ok" first (add pos 1)
                            (qtlc-next-cursor one) "complete"))
                    (do
                        ; Any already-enqueued prefix is made observable before
                        ; state release; a refusal never leaves an open batch.
                        (metal_sync)
                        (fcmg-live-pf (qtlc-next-status one) (sub 0 1) pos
                            (qtlc-next-cursor one)
                            (qtlc-reason (qtlc-next-cursor one))))))))
    (defn fcmg-live-prefill (ctx sts cursor chunk)
        (do
            (let first (qtlc-next cursor))
            (if (not (eq (qtlc-next-present? first) 1))
                (fcmg-live-pf (qtlc-next-status first) (sub 0 1) 0
                    (qtlc-next-cursor first)
                    (qtlc-reason (qtlc-next-cursor first)))
                (do
                    (metal_batch_concurrent)
                    (fcmg-live-prefill-go ctx sts (qtlc-next-cursor first)
                        (qtlc-next-value first) 0 0 chunk)))))

    (defn fcmg-run-context-cursor-budgeted
        (src arch model cursor thought-lists thought-eval ctx n query reserve gap-n
             source-hint tfx)
        (do
            (let geo (nth ctx 2))
            (let _state-begin (fcmg-live-stage "model-state-begin" 4456449))
            (let sts (q38-new-state geo))
            (if (not (eq (q38-state-ok? sts) 1))
                (fcmg-state-close-result sts
                    (str_concat "generation refused: state allocation failed; " (metal_status)))
                (do
                    (let before-status (metal_status))
                    (let _prefill-begin (fcmg-live-stage "model-prefill-begin" 4587521))
                    (let live-pf (fcmg-live-prefill ctx sts cursor 64))
                    (let _prefill-complete (fcmg-live-stage "model-prefill-complete" 4653057))
                    (if (not (str_eq (nth live-pf 1) "ok"))
                        (fcmg-state-close-result sts
                            (str_concat "generation refused: live prompt cursor="
                                (str_concat (nth live-pf 1)
                                    (str_concat ";reason="
                                        (nth live-pf 5)))))
                        (do
                            (let final-cursor (nth live-pf 4))
                            (let prompt-n (qtlc-token-count final-cursor))
                            (let stops (fcmg-q35-stops src))
                            (let offered
                                (if (eq (len thought-lists) 0)
                                    (list (nth live-pf 2)
                                        (nth live-pf 3) (empty) 0 0)
                                    (fcmg-offer-stream
                                        (nth ctx 0) (nth ctx 1) geo (nth ctx 3) sts
                                        (nth ctx 4) (nth ctx 5) (nth ctx 6)
                                        thought-lists (nth live-pf 3) gap-n
                                        stops (empty) 0 0)))
                            (let prefill-status (metal_status))
                            (let first (nth offered 0))
                            (let pos (nth offered 1))
                            (let stream-ids (nth offered 2))
                            (let thought-n (nth offered 3))
                            (let offers (nth offered 4))
                            (let model-extra (sub (len stream-ids) thought-n))
                            (let remain (sub n model-extra))
                            (let _decode-begin (fcmg-live-stage "model-decode-begin" 4849665))
                            (let heed-run
                                (if (and (gt query 0) (gt reserve 0))
                                    (fcmg-heed-tail-2p src
                                        (nth ctx 0) (nth ctx 1) geo (nth ctx 3) sts
                                        (nth ctx 4) (nth ctx 5) (nth ctx 6)
                                        first pos stops query reserve source-hint tfx)
                                    (fcmg-heed-tail src
                                        (nth ctx 0) (nth ctx 1) geo (nth ctx 3) sts
                                        (nth ctx 4) (nth ctx 5) (nth ctx 6)
                                        first pos remain stops tfx)))
                            (let _decode-complete (fcmg-live-stage "model-decode-complete" 4980737))
                            (let model-tail (fhc-out heed-run))
                            (let heed (fhc-cursor-of heed-run))
                            (let out (tkz-cat stream-ids model-tail))
                            (metal_sync)
                            (let after-status (metal_status))
                            (let busy-us (sub
                                (mbw-status-int after-status "gpu_busy_us_total")
                                (mbw-status-int before-status "gpu_busy_us_total")))
                            (let prefill-us (sub
                                (mbw-status-int prefill-status "gpu_busy_us_total")
                                (mbw-status-int before-status "gpu_busy_us_total")))
                            (let decode-us (sub
                                (mbw-status-int after-status "gpu_busy_us_total")
                                (mbw-status-int prefill-status "gpu_busy_us_total")))
                            (let forwards (add
                                (add (add prompt-n thought-n)
                                    (if (gt (add model-extra (len model-tail)) 0)
                                        (sub (add model-extra (len model-tail)) 1) 0))
                                (add (fhc-injected heed)
                                    (add (fhc-close-commits heed)
                                         (fhc-terminal-forwards heed)))))
                            (let weight-bytes (q38-forward-weight-bytes ctx))
                            (fcmg-state-close-result sts
                                (str_concat (fcmg-line "prompt_cursor"
                                                "bmf-qtf2-live-v1")
                                    (fcmg-report-count model arch prompt-n out
                                        (tkz-decode-text src out) thought-eval
                                        offers thought-n forwards busy-us prefill-us
                                        decode-us weight-bytes heed)))))))))

    (defn fcmg-run-context-budgeted
        (src arch model ids thought-lists thought-eval ctx n query reserve gap-n
             source-hint tfx)
        (do
            (let geo (nth ctx 2))
            (let sts (q38-new-state geo))
            (if (not (eq (q38-state-ok? sts) 1))
                (fcmg-state-close-result sts
                    (str_concat "generation refused: state allocation failed; " (metal_status)))
                (do
                    (let before-status (metal_status))
                    (let pf (q38-prefill
                        (nth ctx 0) (nth ctx 1) geo (nth ctx 3) sts
                        (nth ctx 4) (nth ctx 5) (nth ctx 6) ids 0))
                    (let stops (fcmg-q35-stops src))
                    (let offered
                        (if (eq (len thought-lists) 0)
                            (list (nth pf 0) (nth pf 1) (empty) 0 0)
                            (fcmg-offer-stream
                                (nth ctx 0) (nth ctx 1) geo (nth ctx 3) sts
                                (nth ctx 4) (nth ctx 5) (nth ctx 6)
                                thought-lists (nth pf 1) gap-n stops
                                (empty) 0 0)))
                    (let prefill-status (metal_status))
                    (let first (nth offered 0))
                    (let pos (nth offered 1))
                    (let stream-ids (nth offered 2))
                    (let thought-n (nth offered 3))
                    (let offers (nth offered 4))
                    (let model-extra (sub (len stream-ids) thought-n))
                    (let remain (sub n model-extra))
                    (let heed-run
                        (if (and (gt query 0) (gt reserve 0))
                            (fcmg-heed-tail-2p src
                                (nth ctx 0) (nth ctx 1) geo (nth ctx 3) sts
                                (nth ctx 4) (nth ctx 5) (nth ctx 6)
                                first pos stops query reserve source-hint tfx)
                            (fcmg-heed-tail src
                                (nth ctx 0) (nth ctx 1) geo (nth ctx 3) sts
                                (nth ctx 4) (nth ctx 5) (nth ctx 6)
                                first pos remain stops tfx)))
                    (let model-tail (fhc-out heed-run))
                    (let heed (fhc-cursor-of heed-run))
                    (let out (tkz-cat stream-ids model-tail))
                    (metal_sync)
                    (let after-status (metal_status))
                    (let busy-us (sub
                        (mbw-status-int after-status "gpu_busy_us_total")
                        (mbw-status-int before-status "gpu_busy_us_total")))
                    (let prefill-us (sub
                        (mbw-status-int prefill-status "gpu_busy_us_total")
                        (mbw-status-int before-status "gpu_busy_us_total")))
                    (let decode-us (sub
                        (mbw-status-int after-status "gpu_busy_us_total")
                        (mbw-status-int prefill-status "gpu_busy_us_total")))
                    (let forwards (add
                        (add (add (len ids) thought-n)
                            (if (gt (add model-extra (len model-tail)) 0)
                                (sub (add model-extra (len model-tail)) 1) 0))
                        (add (fhc-injected heed)
                            (add (fhc-close-commits heed)
                                 (fhc-terminal-forwards heed)))))
                    (let weight-bytes (q38-forward-weight-bytes ctx))
                    (fcmg-state-close-result sts
                        (fcmg-report model arch ids out (tkz-decode-text src out)
                            thought-eval offers thought-n
                            forwards busy-us prefill-us decode-us weight-bytes heed))))))

    ; Compatibility: every existing caller remains on the fungible tail.
    (defn fcmg-run-context (src arch model ids thought-lists thought-eval ctx n gap-n)
        (fcmg-run-context-budgeted src arch model ids thought-lists thought-eval
            ctx n 0 0 gap-n "" (qtf2-index-empty "absent" "unthreaded" "")))
    (defn fcmg-run-context-2p
        (src arch model ids thought-lists thought-eval ctx query reserve gap-n)
        (fcmg-run-context-budgeted src arch model ids thought-lists thought-eval
            ctx 0 query reserve gap-n ""
            (qtf2-index-empty "absent" "unthreaded" "")))

    (defn fcmg-chat-ids (src prompt)
        (if (eq (ftl-armed?) 1)
            (do (let ims (q35-special-id src "<|im_start|>"))
                (let ime (q35-special-id src "<|im_end|>"))
                (tkz-cat (q35-one ims)
                (tkz-cat (q35-encode src "system\n")
                (tkz-cat (q35-encode src (ftl-system-text))
                (tkz-cat (q35-one ime)
                (tkz-cat (q35-encode src "\n")
                         (q35-chat-ids src prompt)))))))
            (q35-chat-ids src prompt)))

    ; Knowledge-query profile: the compact fqt prompt already carries the exact
    ; execution grammar, so do not replay the large general system glossary.
    ; The ordinary form-cli generation door remains byte-identical on `full`.
    (defn fcmg-chat-ids-profile (src prompt profile)
        (if (str_eq profile "knowledge-query")
            (q35-chat-ids src prompt)
            (fcmg-chat-ids src prompt)))

    (defn fcmg-chat-segments-profile (prompt profile x)
        (if (str_eq profile "knowledge-query")
            (qtlc-chat-segments prompt x)
            (if (eq (ftl-armed?) 1)
                (qtlc-full-chat-segments prompt (ftl-system-text) x)
                (qtlc-chat-segments prompt x))))
    (defn fcmg-chat-cursor-profile (path prompt profile x)
        (qtlc-open path (qsx-seal-line path)
            (fcmg-chat-segments-profile prompt profile x)))

    ; A first admission: the seal is verified before a single byte of the file is
    ; read for meaning, exactly as before.  What changed is only what is answered —
    ; the text AND the residence the admission earned, so a caller that keeps it
    ; does not pay this again.
    ; A refusal must name what actually refused.  Verdict 2 is the digest engine
    ; declining to run, which is a fact about this binary, not about the file —
    ; and it carries metal_status so the reason is in the sentence rather than in
    ; a later investigation.
    (defn fcmg-seal-refusal (verdict)
        (if (eq verdict 2)
            (str_concat "generation refused: the Form-native SHA-256 digest engine did not answer — this says nothing about the artifact; "
                (metal_status))
            "generation refused: selected artifact has no current Form-native SHA-256 seal"))

    (defn fcmg-noted (prompt arch model msg)
        (str_concat (lmc-say prompt arch model) (str_concat "\n" msg)))

    (defn fcmg-arch-door (arch model)
        (if (str_eq arch "deepseek4")
            (str_concat "generate on "
            (str_concat (if (str_eq model "") "this deepseek4 file" model)
                " uses the DS4 control stack (route / ds4-query). This door is Form-native generate for qwen35."))
            (str_concat "generate for architecture="
            (str_concat arch
            (str_concat " model="
            (str_concat (if (str_eq model "") "unnamed" model)
                " is unfinished on this door; choose and route still name the file."))))))

    (defn fcmg-fresh-at-budgeted-hinted
        (path prompt n query reserve profile source-hint)
        (do
            (let _seal-begin (fcmg-live-stage "model-seal-begin" 5963777))
            (let verdict (qaf-seal-verdict path))
        (let _seal-complete (fcmg-live-stage "model-seal-complete" 6029313))
        (if (not (eq verdict 1))
            (list (fcmg-noted prompt "" "" (fcmg-seal-refusal verdict)) (fcmr-none))
            (do
                (let src (fcmg-src path))
                ; The crystal, both doors (2026-08-24): load the seal-keyed
                ; recording if present; otherwise this first ask IS the heat —
                ; freeze, then load. If even that fails, the scan path answers:
                ; ice is a speed, never a gate. Measured: open 16.3 s -> 0.45 s.
                (let x0 (qsx-load path))
                (let x (if (eq (nth x0 0) 1) x0
                           (do (let heat (qsx-freeze path)) (qsx-load path))))
                (let iced (nth x 0))
                (let thoughts (lg-think-all prompt))
                (let thought-lists (fcmg-encode-thoughts src thoughts (empty)))
                (let thought-eval (lg-values-line thoughts))
                (let thought-n (fcmg-id-count thought-lists 0))
                (let gap-n (if (gt (len thoughts) 1) (lg-gap-default) 0))
                (let segments (if (eq iced 1)
                    (fcmg-chat-segments-profile prompt profile x) (empty)))
                (let cursor (if (eq iced 1)
                    (fcmg-chat-cursor-profile path prompt profile x)
                    (qtlc-open-index
                        (list "absent" "crystal-absent" "" 0 0 0 0 0 0 0)
                        (empty))))
                (let live-cursor (if (str_eq (qtlc-status cursor) "open") 1 0))
                ; When the live cursor is absent the sorted-row index encodes
                ; (10x the scanner, byte-identical); the reference scanner
                ; remains the last lane inside qei itself. A current cursor
                ; never creates a whole prompt-id list.
                (let tfx (qtf2-load (qtf2-root-for path) (qsx-seal-line path)))
                (let ids (if (eq live-cursor 1) (empty)
                    (qei-chat-ids-profile src tfx prompt profile)))
                (let prompt-bound (if (eq live-cursor 1)
                    (qtlc-segments-upper-bound segments 0) (len ids)))
                (let arch (fcmg-arch src))
                (let model (fcmg-name src))
                (let model-max (gmt-u32 src (q38-key arch "context_length")))
                (let need (fcmg-context-need prompt-bound thought-n
                    (mul gap-n (if (gt (len thoughts) 1)
                        (sub (len thoughts) 1) 0)) n query reserve))
                (let maxpos (if (lt need model-max) need model-max))
                (let required (if (eq iced 1) (qsx-required x)
                                  (q38-required-size src (egg-data-base src 32))))
                (let actual (file_size path))
                (if (not (str_eq arch "qwen35"))
                    (list (fcmg-noted prompt arch model (fcmg-arch-door arch model))
                          (fcmr-none))
                (if (le prompt-bound 0)
                    (list (fcmg-noted prompt arch model "generation refused: tokenizer produced no prompt tokens")
                          (fcmr-none))
                (if (or (eq (fcmg-tail-budget-ok? n query reserve) 0)
                        (gt need model-max))
                    (list (fcmg-noted prompt arch model
                              (str_concat "generation refused: requested context exceeds model limit="
                                  (int_to_str model-max)))
                          (fcmr-none))
                (if (or (le required 0) (lt actual required))
                    (list (fcmg-noted prompt arch model
                              (str_concat "generation refused: incomplete tensor extent; required="
                                  (str_concat (int_to_str required)
                                      (str_concat ";actual=" (int_to_str actual)))))
                          (fcmr-none))
                    (do
                        (let _open-begin (fcmg-live-stage "model-open-begin" 6356993))
                        (let ctx (if (eq iced 1) (qsx-open path maxpos x) (q38-open path maxpos)))
                        (let _open-complete (fcmg-live-stage "model-open-complete" 6422529))
                        (if (lt (len ctx) 10)
                            (list (fcmg-noted prompt arch model
                                      (str_concat "generation refused: model context did not open; "
                                          (metal_status)))
                                  (fcmr-none))
                            (if (not (eq (q38-context-ok? ctx) 1))
                                (list (fcmg-noted prompt arch model
                                          (fcmg-open-refusal ctx "model context contains an invalid handle"))
                                      (fcmr-none))
                                (list (fcmg-noted prompt arch model
                                          (if (eq live-cursor 1)
                                              (fcmg-run-context-cursor-budgeted
                                                  src arch model cursor thought-lists
                                                  thought-eval ctx n query reserve gap-n
                                                  source-hint tfx)
                                              (fcmg-run-context-budgeted src arch model ids
                                                  thought-lists thought-eval ctx n query reserve
                                                  gap-n source-hint tfx)))
                                      (fcmr path maxpos ctx src arch)))))))))))))
    ; Ordinary callers may carry an exact path in prose. Dataset-backed callers
    ; already hold a sealed source path separately and use the explicit hinted
    ; door below, so evidence identity need not be smuggled into prompt text.
    (defn fcmg-fresh-at-budgeted (path prompt n query reserve profile)
        (fcmg-fresh-at-budgeted-hinted path prompt n query reserve profile
            (fhcs-query-source-path prompt)))
    ; Existing doors are fungible delegates; two-phase callers name both
    ; ledgers explicitly.
    (defn fcmg-fresh-at (path prompt n profile)
        (fcmg-fresh-at-budgeted path prompt n 0 0 profile))
    (defn fcmg-fresh-at-2p (path prompt query reserve profile)
        (fcmg-fresh-at-budgeted path prompt 0 query reserve profile))
    (defn fcmg-fresh (path prompt n)
        (fcmg-fresh-at path prompt n "full"))

    (defn fcmg-stale-close ()
        (list "generation refused: previous model handle close mismatch" (fcmr-none)))

    ; Generation against whatever the caller is already holding.  An empty
    ; residence, a residence for a different file, or a prompt that outgrows the
    ; ceiling this one was opened for all end in the same place — release, then
    ; admit — so there is one path and no mode to be in.
    (defn fcmg-generate-with-at-budgeted-hinted
        (r path prompt n query reserve profile source-hint)
        (if (eq (fcmr-live? r) 0)
            (fcmg-fresh-at-budgeted-hinted path prompt n query reserve profile
                source-hint)
            (if (not (str_eq (fcmr-path r) path))
                (if (eq (fcmr-release-ok? r) 1)
                    (fcmg-fresh-at-budgeted-hinted path prompt n query reserve profile
                        source-hint)
                    (fcmg-stale-close))
                (do
                    (let src (fcmr-src r))
                    (let arch (fcmr-arch r))
                    (let model (fcmg-name src))
                    (let thoughts (lg-think-all prompt))
                    (let thought-lists (fcmg-encode-thoughts src thoughts (empty)))
                    (let thought-eval (lg-values-line thoughts))
                    (let thought-n (fcmg-id-count thought-lists 0))
                    (let gap-n (if (gt (len thoughts) 1) (lg-gap-default) 0))
                    (let x (qsx-load path))
                    (let iced (if (eq (nth x 0) 1) 1 0))
                    (let segments (if (eq iced 1)
                        (fcmg-chat-segments-profile prompt profile x) (empty)))
                    (let cursor (if (eq iced 1)
                        (fcmg-chat-cursor-profile path prompt profile x)
                        (qtlc-open-index
                            (list "absent" "crystal-absent" "" 0 0 0 0 0 0 0)
                            (empty))))
                    (let live-cursor (if (str_eq (qtlc-status cursor) "open") 1 0))
                    (let tfx (qtf2-load (qtf2-root-for path) (qsx-seal-line path)))
                    (let ids (if (eq live-cursor 1) (empty)
                        (qei-chat-ids-profile src tfx prompt profile)))
                    (let prompt-bound (if (eq live-cursor 1)
                        (qtlc-segments-upper-bound segments 0) (len ids)))
                    (let model-max (gmt-u32 src (q38-key arch "context_length")))
                    (let need (fcmg-context-need prompt-bound thought-n
                        (mul gap-n (if (gt (len thoughts) 1)
                            (sub (len thoughts) 1) 0)) n query reserve))
                    (if (le prompt-bound 0)
                        (list (fcmg-noted prompt arch model "generation refused: tokenizer produced no prompt tokens") r)
                    (if (or (eq (fcmg-tail-budget-ok? n query reserve) 0)
                            (gt need model-max))
                        (list (fcmg-noted prompt arch model
                                  (str_concat "generation refused: requested context exceeds model limit="
                                      (int_to_str model-max)))
                              r)
                    (if (le need (fcmr-maxpos r))
                        (list (fcmg-noted prompt arch model
                                  (if (eq live-cursor 1)
                                      (fcmg-run-context-cursor-budgeted
                                          src arch model cursor thought-lists
                                          thought-eval (fcmr-ctx r) n query reserve
                                          gap-n source-hint tfx)
                                      (fcmg-run-context-budgeted src arch model ids
                                          thought-lists thought-eval (fcmr-ctx r)
                                          n query reserve gap-n source-hint tfx)))
                              r)
                        (if (eq (fcmr-release-ok? r) 1)
                            (fcmg-fresh-at-budgeted-hinted path prompt n query reserve
                                profile source-hint)
                            (fcmg-stale-close)))))))))
    (defn fcmg-generate-with-at-budgeted
        (r path prompt n query reserve profile)
        (fcmg-generate-with-at-budgeted-hinted r path prompt n query reserve
            profile (fhcs-query-source-path prompt)))
    (defn fcmg-generate-with-at (r path prompt n profile)
        (fcmg-generate-with-at-budgeted r path prompt n 0 0 profile))
    (defn fcmg-generate-with-at-2p (r path prompt query reserve profile)
        (fcmg-generate-with-at-budgeted r path prompt 0 query reserve profile))
    (defn fcmg-generate-with (r path prompt n)
        (fcmg-generate-with-at r path prompt n "full"))

    ; The one-shot door, byte-identical in what it answers: admit, generate,
    ; release.  A caller with nothing to hold on to loses nothing and keeps the
    ; close check that was always here.
    (defn fcmg-q35-run (path prompt n)
        (do
            (let out (fcmg-generate-with (fcmr-none) path prompt n))
            (if (eq (fcmr-release-ok? (nth out 1)) 1) (nth out 0)
                "generation refused: model handle close mismatch")))

    ; The generate door carries the Form teach overlay. Raw fcmg-q35-run
    ; stays for probes that need an exact prompt.
    (defn fcmg-teach (prompt) (fqt-prompt prompt))

    ; The ordinary local door may answer directly or may first emit a bounded
    ; knowledge-query.  Its old fungible tail made the latter shape consume the
    ; last output slot, so a valid typed observation arrived with no room for
    ; the local answer.  This ledger gives the pre-observation turn exactly the
    ; caller's requested budget and holds a separate answer reserve.  Direct
    ; prose never opens or spends that reserve; a hit or miss opens it through
    ; the existing cursor at the precise observation boundary.
    ;
    ; This is data at the Form call boundary, not a new model session, server,
    ; tokenizer pre-pass, or static operation table.
    (defn fcmg-plain-ledger-mark () "form-cli-plain-answer-ledger-v1")
    (defn fcmg-plain-ledger (query)
        (list (fcmg-plain-ledger-mark) query
            (fcmg-current-source-answer-reserve)))
    (defn fcmg-plain-ledger-query (ledger) (nth ledger 1))
    (defn fcmg-plain-ledger-reserve (ledger) (nth ledger 2))
    (defn fcmg-plain-ledger-valid? (ledger)
        (if (not (and (eq (len ledger) 3)
                      (str_eq (nth ledger 0) (fcmg-plain-ledger-mark)))) 0
            (fcmg-tail-budget-ok? 0
                (fcmg-plain-ledger-query ledger)
                (fcmg-plain-ledger-reserve ledger))))
    (defn fcmg-generate-plain-resident (r path prompt n)
        (do
            (let ledger (fcmg-plain-ledger n))
            (fcmg-generate-with-at-budgeted r path prompt 0
                (fcmg-plain-ledger-query ledger)
                (fcmg-plain-ledger-reserve ledger) "full")))

    ; The recurring rented cost in the 2026-08-26 session census was not tool
    ; execution; it was the speaker choosing the next tool. This is that turn
    ; inside the resident local Qwen lane. Its grammar is deliberately small:
    ; one move, one line, no transcript replay, no frontier option. Frontier
    ; admission remains the separate exact membrane in form-cli-sufficiency.
    (defn fcmg-local-plan-budget () 24)
    (defn fcmg-local-plan-prompt (task)
        (str_concat
            "Form next-step. Reply with exactly one line: NEXT:<move>. Moves: ground-first, knowledge-query, source-read, preflight, execute, observe, revise, land, stop. Rules: changed or uncompiled source -> preflight; preflight clean -> execute; complete focused band -> land; error -> observe. Keep nothing, 0, and 1 distinct. Task: "
            task))
    (defn fcmg-local-plan-text (report)
        (do
            (let mark "text:\n")
            (let at (str_find report mark 0))
            (if (lt at 0) ""
                (do
                    (let generated-text (substring report (add at (str_len mark))
                                (str_len report)))
                    (if (gt (str_len generated-text) 512)
                        (substring generated-text 0 512) generated-text)))))
    (defn fcmg-local-plan-trim-last (s byte)
        (do
            (let n (str_len s))
            (if (and (gt n 0) (eq (str_byte_at s (sub n 1)) byte))
                (substring s 0 (sub n 1)) s)))
    (defn fcmg-local-plan-trim (s)
        (fcmg-local-plan-trim-last (fcmg-local-plan-trim-last s 10) 13))
    (defn fcmg-local-plan-moves ()
        (list "ground-first" "knowledge-query" "source-read" "preflight"
              "execute" "observe" "revise" "land" "stop"))
    (defn fcmg-local-plan-known? (move moves)
        (if (eq (len moves) 0) 0
            (if (str_eq move (head moves)) 1
                (fcmg-local-plan-known? move (tail moves)))))
    ; A typed offer, not an operations table: ready carries the exact Form move
    ; symbol; malformed or unoffered speech becomes nothing. A later recipe
    ; execution door may bind that symbol to an addressed recipe without
    ; changing this local-model grammar.
    (defn fcmg-local-plan-offer (text)
        (do
            (let clean (fcmg-local-plan-trim text))
            (let prefix "NEXT:")
            (if (not (eq (str_find clean prefix 0) 0)) (list "nothing" "")
                (do
                    (let move (substring clean (str_len prefix) (str_len clean)))
                    (if (eq (fcmg-local-plan-known? move
                                (fcmg-local-plan-moves)) 1)
                        (list "ready" move) (list "nothing" ""))))))

    ; The session result retains what was offered instead of making a later
    ; parser reconstruct it from prose.  Indices 0 and 1 remain speech and
    ; residence, so every existing REPL caller stays byte-compatible; index 2
    ; is the typed ready/nothing offer for an addressed action binder.
    (defn fcmg-local-plan-result (speech residence offer)
        (list speech residence offer))
    (defn fcmg-local-plan-result-speech (result) (nth result 0))
    (defn fcmg-local-plan-result-residence (result) (nth result 1))
    (defn fcmg-local-plan-result-offer (result) (nth result 2))
    (defn fcmg-local-plan-from-generated (residence report)
        (do
            (let generated-text (fcmg-local-plan-text report))
            (let offer (fcmg-local-plan-offer generated-text))
            (fcmg-local-plan-result
                (if (str_eq (nth offer 0) "ready")
                    (str_concat "local-plan-status=ready\nlocal-plan-move="
                        (str_concat (nth offer 1)
                            "\nlocal-plan-source=form-native-qwen"))
                    "local-plan-status=nothing\nreason=malformed-or-refused-local-move")
                residence offer)))
    (defn fcmg-local-plan-resident (r path task)
        (if (str_eq path "")
            (fcmg-local-plan-result
                "local-plan=nothing\nreason=no-local-model-selected\nnext=models-use"
                r (list "nothing" ""))
            (if (str_eq task "")
                (fcmg-local-plan-result
                    "usage: local-plan <task>" r (list "nothing" ""))
                (do
                    (let generated (fcmg-generate-with r path
                        (fcmg-local-plan-prompt task) (fcmg-local-plan-budget)))
                    (fcmg-local-plan-from-generated
                        (nth generated 1) (nth generated 0))))))

    ; The door a session speaks through: it is handed what the session holds and
    ; answers the text together with what it should keep holding.
    (defn fcmg-generate-resident (r path prompt n)
        (if (str_eq path "")
            (list "no model is picked — run `models <dir>`, then `use <n>`, then `generate <prompt>`" r)
            (if (str_eq prompt "") (list "usage: generate <prompt>" r)
                (fcmg-generate-plain-resident r path (fcmg-teach prompt) n))))
    ; The same door for a caller that holds nothing: admit, generate, release.
    (defn fcmg-generate (path prompt n)
        (do
            (let out (fcmg-generate-resident (fcmr-none) path prompt n))
            (let _turn-returned (fcmg-live-stage "model-turn-returned" 7864321))
            (if (eq (fcmr-release-ok? (nth out 1)) 1) (nth out 0)
                "generation refused: model handle close mismatch")))

    ; Compact current-source door for held-out evaluation and direct knowledge
    ; questions. Same resident model, cursor, lookup budget and KV injection;
    ; only the repeated prompt profile is smaller.
    (defn fcmg-generate-knowledge-resident (r path prompt n)
        (if (str_eq path "")
            (list "no model is picked — current-source generation needs a selected model" r)
            (if (str_eq prompt "") (list "usage: knowledge-generate <prompt>" r)
                (fcmg-generate-with-at r path (fqt-knowledge-prompt prompt) n
                    "knowledge-query"))))
    (defn fcmg-generate-knowledge-resident-2p (r path prompt query reserve)
        (if (str_eq path "")
            (list "no model is picked — current-source generation needs a selected model" r)
            (if (str_eq prompt "") (list "usage: knowledge-generate <prompt>" r)
                (fcmg-generate-with-at-2p r path (fqt-knowledge-prompt prompt)
                    query reserve "knowledge-query"))))
    (defn fcmg-generate-knowledge-resident-2p-hinted
        (r path prompt query reserve source-hint)
        (if (str_eq path "")
            (list "no model is picked — current-source generation needs a selected model" r)
            (if (str_eq prompt "") (list "usage: knowledge-generate <prompt>" r)
                (fcmg-generate-with-at-budgeted-hinted r path
                    (fqt-bound-source-knowledge-prompt prompt) 0 query reserve
                    "knowledge-query" source-hint))))
    ; The current configured production current-source door. 48/32 is a
    ; hypothesis until a live hit observes the reserve-opening path; nothing here
    ; legislates. The older n-argument entry remains a fungible delegate.
    (defn fcmg-generate-current-source-resident (r path prompt)
        (fcmg-generate-knowledge-resident-2p r path prompt
            (fcmg-current-source-query-budget)
            (fcmg-current-source-answer-reserve)))
    (defn fcmg-generate-current-source-resident-at
        (r path prompt source-hint)
        (fcmg-generate-knowledge-resident-2p-hinted r path prompt
            (fcmg-current-source-query-budget)
            (fcmg-current-source-answer-reserve)
            source-hint))
    (defn fcmg-generate-knowledge (path prompt n)
        (do
            (let out (fcmg-generate-knowledge-resident
                (fcmr-none) path prompt n))
            (if (eq (fcmr-release-ok? (nth out 1)) 1) (nth out 0)
                "generation refused: model handle close mismatch")))

    ; Soft mouth: Metal proposes text; kernel parses Form cells and admits only
    ; when held-out structure is equivalent. Empty held-out does not authorize.
    ; Invite spells the shape without paren cells so structure-think cannot
    ; contaminate the propose pass. On commit, inject re-runs generate with the
    ; admitted cells so those tokens enter the Metal offer stream.
    (defn fcmg-soft-invite (prompt)
        (str_concat
            "Emit one Form call. Operator word mul. Both operands the digit seven. Use call parentheses around operator and operands. One cell only. No prose. No bare result.\n"
            prompt))
    (defn fcmg-soft-tail (soft injected)
        (str_concat (fcmg-line "soft-status" (lg-soft-status soft))
        (str_concat (fcmg-line "soft-equivalent"
            (int_to_str (lg-soft-equivalent soft)))
        (str_concat (fcmg-line "soft-eval"
            (lg-values-line (lg-soft-thoughts soft)))
        (str_concat (fcmg-line "soft-commit"
            (int_to_str (lg-soft-commit? soft)))
        (str_concat (fcmg-line "soft-wins"
            (int_to_str (ll-wins (lg-soft-events soft) (lg-cand-soft))))
                    (fcmg-line "soft-injected" (int_to_str injected))))))))
    (defn fcmg-soft-inject (path soft n)
        (if (eq (lg-soft-commit? soft) 0)
            (fcmg-soft-tail soft 0)
            (do
                (let cells (lg-cells-prompt (lg-soft-thoughts soft)))
                (let inject-report (fcmg-q35-run path cells n))
                (str_concat inject-report
                    (str_concat "\n" (fcmg-soft-tail soft 1))))))
    (defn fcmg-soft-mouth (path prompt heldout n)
        (do
            (let propose-report
                (fcmg-q35-run path (fcmg-soft-invite prompt) n))
            (let proposal (fcmg-local-plan-text propose-report))
            (let soft (lg-soft proposal heldout))
            (if (eq (lg-soft-commit? soft) 0)
                (str_concat propose-report
                    (str_concat "\n" (fcmg-soft-tail soft 0)))
                (fcmg-soft-inject path soft n))))

    (defn fcmg-bandwidth (path)
        (if (str_eq path "")
            "no model is picked — run `models <dir>`, then `use <n>`, then `model-bandwidth`"
            (if (eq (qaf-verify-sealed-file path) 1)
                (mbw-run path)
                "bandwidth refused: selected artifact has no current Form-native SHA-256 seal")))

    ; The default witness answers `nothing` for every envelope — an unconfigured
    ; host honestly holds no knowledge. The grounded witness names the substrate
    ; this checkout DOES hold, so a hit can open the answer reserve for real.
    ; chunk 0 — one batch for the span — is the default because the body said so:
    ; the same prompt through chunk 1 and chunk 0 produced output-sha256
    ; 88bd9b9a...7fe1487f both times, with carrier syncs falling 506 -> 61.
    (defn fcmg-heed-witness (path prompt query reserve)
        (fcmg-heed-witness-with path prompt query reserve fcmg-heed-lookup-nothing 0))
    (defn fcmg-heed-witness-grounded (path prompt query reserve)
        (fcmg-heed-witness-with path prompt query reserve fhg-lookup 0))
    (defn fcmg-heed-witness-grounded-chunk (path prompt query reserve chunk)
        (fcmg-heed-witness-with path prompt query reserve fhg-lookup chunk))
    0)
