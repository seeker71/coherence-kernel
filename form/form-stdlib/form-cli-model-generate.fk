; form-cli-model-generate.fk — selected GGUF to Form-native Qwen3.5/Qwen3.8 generation.
;
; The selected path is admitted by a whole-file Form/M4 SHA-256 seal before any
; tensor is mapped.  Architecture, context, tensor geometry, tokenizer, stop ids,
; and required byte extent are read from that GGUF.  Form emits the MSL at runtime;
; the linked Metal carrier JIT-compiles it for the device that answered metal_status.
;
; preludes: form-stdlib/qwen35-tokenizer.fk form-stdlib/qwen35-form-layer.fk form-stdlib/local-model-choice.fk form-stdlib/local-generate-organ.fk form-stdlib/qwen35-artifact-fetch.fk native/metal/qwen35-dense-token-handle.fk native/metal/model-bandwidth.fk form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/language-model.fk form-stdlib/form-cli-heedmark-xtal.fk form-stdlib/form-cli-heed-cursor.fk form-stdlib/form-cli-heed-telemetry.fk form-stdlib/form-cli-heed-grounded.fk

(do
    (defn fcmg-src (path) (eqr-of-file path 0 40000000))
    (defn fcmg-arch (src) (gmt-str src "general.architecture"))
    (defn fcmg-q35-stops (src)
        (list (gmt-u32 src "tokenizer.ggml.eos_token_id")
              (q35-special-id src "<|im_end|>")))
    (defn fcmg-field (name value)
        (str_concat name (str_concat "=" value)))
    (defn fcmg-line (name value)
        (str_concat (fcmg-field name value) "\n"))
    (defn fcmg-name (src)
        (do (let n (gmt-str src "general.name"))
            (if (str_eq n "") "(header names no model)" n)))
    (defn fcmg-report (model arch ids out text thought-eval thought-offers thought-n forwards busy-us prefill-us decode-us weight-bytes)
        (do
            (let effective-gbps-x10
                (if (gt busy-us 0)
                    (div (mul (mul weight-bytes forwards) 10) (mul busy-us 1000)) 0))
            (let decode-forwards (if (gt (len out) thought-n) (sub (sub (len out) thought-n) 1) 0))
            (let prefill-tokps-x1000
                (if (gt prefill-us 0) (div (mul (add (len ids) thought-n) 1000000000) prefill-us) 0))
            (let decode-tokps-x1000
                (if (and (gt decode-us 0) (gt decode-forwards 0))
                    (div (mul decode-forwards 1000000000) decode-us) 0))
            (let end-to-end-tokps-x1000
                (if (gt busy-us 0) (div (mul (len out) 1000000000) busy-us) 0))
            (str_concat (fcmg-line "backend" "form-native-metal-jit")
            (str_concat (fcmg-line "form-layer" (if (eq (ftl-armed?) 1) "on" "off"))
            (str_concat (fcmg-line "model" model)
            (str_concat (fcmg-line "architecture" arch)
            (str_concat (fcmg-line "mode" (lmc-mode arch))
            (str_concat (fcmg-line "thought-kernel" "source-resonance-stream")
            (str_concat (fcmg-line "thought-eval" thought-eval)
            (str_concat (fcmg-line "thought-offers" (int_to_str thought-offers))
            (str_concat (fcmg-line "thought-tokens" (int_to_str thought-n))
            (str_concat (fcmg-line "prompt_tokens" (int_to_str (len ids)))
            (str_concat (fcmg-line "generated_tokens" (int_to_str (len out)))
            (str_concat (fcmg-line "forward_passes" (int_to_str forwards))
            (str_concat (fcmg-line "weight_bytes_per_forward" (int_to_str weight-bytes))
            (str_concat (fcmg-line "gpu_busy_us" (int_to_str busy-us))
            (str_concat (fcmg-line "prefill_gpu_busy_us" (int_to_str prefill-us))
            (str_concat (fcmg-line "decode_gpu_busy_us" (int_to_str decode-us))
            (str_concat (fcmg-line "decode_forward_passes" (int_to_str decode-forwards))
            (str_concat (fcmg-line "prefill_tokps_x1000" (int_to_str prefill-tokps-x1000))
            (str_concat (fcmg-line "decode_tokps_x1000" (int_to_str decode-tokps-x1000))
            (str_concat (fcmg-line "effective_weight_gbps_x10"
                (int_to_str effective-gbps-x10))
            (str_concat (fcmg-line "end_to_end_tokps_x1000"
                (int_to_str end-to-end-tokps-x1000))
                            (str_concat "text:\n" text))))))))))))))))))))))))

    ; ── residence ─────────────────────────────────────────────────────────────
    ; A model admitted once should not be admitted again to answer a second
    ; sentence.  Measured on this M4 Max against Qwen3.8-27B-Q8_0 (2026-08-19,
    ; observe/qwen38-generate-phase-run.fk, and receipts/2026-08-19-omlx-in-the-standard-path.md):
    ; re-verifying the whole-file SHA-256 seal is 13.4 s, opening the tensor views
    ; and compiling the kernels is 15.6 s, and the GPU work of a 54-token prompt
    ; with ten generated tokens is 7.1 s.  Setup was four times the inference, and
    ; it was paid again on every single call.
    ;
    ; A residence is that admission, held: the sealed path, the position ceiling it
    ; was opened for, the opened context, and the header window and architecture
    ; read from it.  Nothing here is a mode or a switch — a caller that has no
    ; residence hands `fcmr-none` and gets the old open-run-close exactly, and a
    ; caller that keeps what it is handed back reuses it whenever the same file can
    ; still hold the next prompt.  The stream state is NOT part of it: state is what
    ; one conversation writes, so it is made and released per generation.
    (defn fcmr-mark () "fcmg-resident1")
    (defn fcmr (path maxpos ctx src arch) (list (fcmr-mark) path maxpos ctx src arch))
    (defn fcmr-none () (empty))
    (defn fcmr-live? (r)
        (if (eq (len r) 6) (if (str_eq (nth r 0) (fcmr-mark)) 1 0) 0))
    (defn fcmr-path (r) (nth r 1))
    (defn fcmr-maxpos (r) (nth r 2))
    (defn fcmr-ctx (r) (nth r 3))
    (defn fcmr-src (r) (nth r 4))
    (defn fcmr-arch (r) (nth r 5))
    ; The same file, and a ceiling this residence can still reach.  A longer prompt
    ; than the one it was opened for is not refused — it reopens, because the KV
    ; extent was derived from that first need and there is no knob to raise.
    (defn fcmr-fits? (r path need)
        (if (eq (fcmr-live? r) 1)
            (if (str_eq (fcmr-path r) path)
                (if (le need (fcmr-maxpos r)) 1 0) 0) 0))
    (defn fcmr-release-ok? (r)
        (if (eq (fcmr-live? r) 1)
            (if (eq (q38-close (fcmr-ctx r) (empty))
                    (q38-close-expected (fcmr-ctx r) (empty))) 1 0)
            1))

    ; Closing is part of the result.  A run that generated text but did not
    ; release every model/state handle is reported as refused, never hidden.
    (defn fcmg-close-result (ctx sts report)
        (do
            (let expected (q38-close-expected ctx sts))
            (let closed (q38-close ctx sts))
            (if (eq closed expected) report
                (str_concat "generation refused: model handle close mismatch; closed="
                    (str_concat (int_to_str closed)
                        (str_concat ";expected=" (int_to_str expected)))))))

    (defn fcmg-open-refusal (ctx detail)
        (fcmg-close-result ctx (empty)
            (str_concat "generation refused: "
                (str_concat detail (str_concat "; " (metal_status))))))

    ; The state half of the same honesty: a generation that ran but did not release
    ; every state handle is reported as refused.  The model handles are not touched
    ; here — they belong to the residence, which outlives this sentence.
    (defn fcmg-state-close-result (sts report)
        (do
            (let expected (q38-state-handle-count sts))
            (let closed (q38-free-state sts))
            (if (eq closed expected) report
                (str_concat "generation refused: state handle close mismatch; closed="
                    (str_concat (int_to_str closed)
                        (str_concat ";expected=" (int_to_str expected)))))))

    ; Encode every evaluated thought into tokenizer ids (left-to-right).
    (defn fcmg-encode-thoughts (src thoughts acc)
        (if (eq (len thoughts) 0) (lg-rev acc (empty))
            (fcmg-encode-thoughts src (tail thoughts)
                (cons (q35-encode src (lg-thought-text (head thoughts))) acc))))

    (defn fcmg-id-count (lists n)
        (if (eq (len lists) 0) n
            (fcmg-id-count (tail lists) (add n (len (head lists))))))

    (defn fcmg-flat-ids (lists acc)
        (if (eq (len lists) 0) acc
            (fcmg-flat-ids (tail lists) (tkz-cat acc (head lists)))))

    ; Offer → commit → optional gap decode → next offer.
    ; Returns (first pos stream-ids thought-n offers).
    ; stream-ids is chronological: thought, gap, thought, ...
    (defn fcmg-offer-stream (ps bs geo lays sts embTv onormTv projTv
                             thought-lists pos gap-n stops stream thought-n offers)
        (if (eq (len thought-lists) 0)
            (list (sub 0 1) pos stream thought-n offers)
            (do
                (let ids (head thought-lists))
                (let pf
                    (if (eq (len ids) 0)
                        (list (sub 0 1) pos)
                        (q38-prefill ps bs geo lays sts embTv onormTv projTv ids pos)))
                (let first (nth pf 0))
                (let next-pos (nth pf 1))
                (let rest (tail thought-lists))
                (let more (gt (len rest) 0))
                (let after-thought (tkz-cat stream ids))
                (let thought-n2 (add thought-n (len ids)))
                (if (and more (gt gap-n 0))
                    (do
                        (let gap-out
                            (if (or (lt first 0) (q38-stop? first stops)) (empty)
                                (cons first
                                    (q38-generate ps bs geo lays sts embTv onormTv projTv
                                        first next-pos (sub gap-n 1) stops (empty)))))
                        (let gap-pos (add next-pos (len gap-out)))
                        (fcmg-offer-stream ps bs geo lays sts embTv onormTv projTv
                            rest gap-pos gap-n stops
                            (tkz-cat after-thought gap-out)
                            thought-n2
                            (add offers 1)))
                    (if (eq (len rest) 0)
                        (list first next-pos after-thought thought-n2 (add offers 1))
                        (fcmg-offer-stream ps bs geo lays sts embTv onormTv projTv
                            rest next-pos gap-n stops after-thought thought-n2
                            (add offers 1)))))))

    ; ── the heedmark lane: knowledge lookup from the model's own stream ───────
    ; fcmg-offer-stream above injects spans, but its thought-lists are computed
    ; BEFORE generation begins — nothing the model emits can choose them. This
    ; lane closes that gap. form-cli-heed-cursor.fk drives one forward pass at a
    ; time, transmutes each emitted id to bytes in a bounded window, and when a
    ; complete <|form:knowledge-query|> envelope closes it offers the surface to
    ; a lookup and prefills the typed observation at the current position.
    ;
    ; NO LOGIT EXECUTED THE LOOKUP. q38-forward returns an argmax over a
    ; distribution and nothing else. The cursor recognized bytes; Form looked up;
    ; the answer re-entered as prefill. fhc-model-executed is 0 by construction.
    ;
    ; The five function values need the pipelines, buffers, geometry, layers,
    ; decode state and tensor views, and this dialect has no lambda — so they
    ; travel as one opaque ctx the cursor never opens.
    ; slot 9 is `chunk`: how many prefill positions may be in flight before the
    ; carrier is asked to settle. 1 is the barrier-per-position the lane has
    ; always had; larger is the question this body can answer about itself.
    (defn fcmg-heed-ctx (ctx sts src chunk)
        (list (nth ctx 0) (nth ctx 1) (nth ctx 2) (nth ctx 3) sts
              (nth ctx 4) (nth ctx 5) (nth ctx 6) src chunk))
    (defn fcmg-heed-step (h id pos)
        (q38-forward (nth h 0) (nth h 1) (nth h 2) (nth h 3) (nth h 4)
                     (nth h 5) (nth h 6) (nth h 7) id pos))
    (defn fcmg-heed-prefill (h ids pos)
        (q38-prefill-chunked (nth h 0) (nth h 1) (nth h 2) (nth h 3) (nth h 4)
                             (nth h 5) (nth h 6) (nth h 7) ids pos (nth h 9)))
    (defn fcmg-heed-decode (h ids) (tkz-decode-text (nth h 8) ids))
    (defn fcmg-heed-encode (h text) (q35-encode (nth h 8) text))

    ; The default substrate answers `nothing` for every envelope — axiom-1, and
    ; it is what an unconfigured host honestly holds. It performs no IO, so this
    ; file names no index and no ABI and preflights clean. A carrier that has a
    ; knowledge substrate passes its own lookupf instead; the fkqt adapter in
    ; form-cli-heed-fkqt.fk is that function value for the typed
    ; form-knowledge-query-token ABI.
    (defn fcmg-heed-lookup-nothing (h surface local-ready)
        (list "nothing" "" "no-knowledge-substrate"))

    ; Prefill the prompt ONCE and carry both of its answers: the first token and
    ; the position after the prompt. An earlier draft took the first token from
    ; the prefill and the position from a parameter — the cursor then walked
    ; from a position the KV rows had never been written at.
    ; Two ledgers, not one. `query` is what the model may spend composing a
    ; knowledge query; `reserve` opens only after a typed observation has
    ; actually been injected, and query verbosity can never reach it. A valid
    ; query that closes on its last query slot still gets a full reserve to
    ; answer from — which one fungible budget could not give it.
    (defn fcmg-heed-generate-2p (src ctx sts ids stops lookupf local-ready
                                 heeds query reserve chunk)
        (do
            (let pf (q38-prefill-chunked (nth ctx 0) (nth ctx 1) (nth ctx 2) (nth ctx 3) sts
                                 (nth ctx 4) (nth ctx 5) (nth ctx 6) ids 0 chunk))
            (fhc-run-seeded-2p (fcmg-heed-ctx ctx sts src chunk)
                fcmg-heed-step fcmg-heed-prefill fcmg-heed-decode fcmg-heed-encode
                lookupf local-ready
                (nth pf 0) (nth pf 1) stops heeds query reserve)))

    ; Compatibility delegate: the old fungible signature, unchanged in meaning.
    (defn fcmg-heed-generate (src ctx sts ids n stops lookupf local-ready budget)
        (do
            (let pf (q38-prefill (nth ctx 0) (nth ctx 1) (nth ctx 2) (nth ctx 3) sts
                                 (nth ctx 4) (nth ctx 5) (nth ctx 6) ids 0))
            (fhc-run-seeded (fcmg-heed-ctx ctx sts src 1)
                fcmg-heed-step fcmg-heed-prefill fcmg-heed-decode fcmg-heed-encode
                lookupf local-ready
                (nth pf 0) (nth pf 1) n stops budget)))

    ; ── the live witness ──────────────────────────────────────────────────────
    ; Real weights, real forward passes, real tokenizer bytes through the cursor.
    ; Effectful: opens a sealed GGUF and drives the GPU. Do not preflight.
    (defn fcmg-heed-line (name value)
        (print_str (str_concat "heed " (str_concat name (str_concat "=" (str_concat value "\n"))))))
    (defn fcmg-heed-int (name value) (fcmg-heed-line name (int_to_str value)))
    (defn fcmg-heed-names (xs acc)
        (if (eq (len xs) 0) acc
            (fcmg-heed-names (tail xs)
                (str_concat acc (str_concat (if (str_eq acc "") "" ",") (head xs))))))

    ; BOUNDED, NON-CONTENT. A held-out run that prints the model's reply has
    ; stopped being held out, so the reply crosses as a SHA-256 and a byte count
    ; (form-cli-heed-telemetry.fk). Reading the text is a separate, named act.
    (defn fcmg-heed-report (src r)
        (do
            (let c (fhc-cursor-of r))
            (fcmg-heed-int "model-tokens" (len (fhc-out r)))
            (fcmg-heed-int "end-pos" (fhc-pos r))
            (fcmg-heed-line "honored" (fcmg-heed-names (fhc-honored c) ""))
            (fht-report c (tkz-decode-text src (fhc-out r)))
            0))

    (defn fcmg-heed-report-with-content (src r)
        (do
            (fcmg-heed-report src r)
            (fcmg-heed-line "output-content-NOT-HELD-OUT"
                (tkz-decode-text src (fhc-out r)))
            0))

    ; ── where the time goes ───────────────────────────────────────────────
    ; Wall clock at each stage boundary plus the Metal counter, so the turn can
    ; be read as seal / open / decode rather than argued about from a total.
    (defn fcmg-heed-witness-with (path prompt query reserve lookupf chunk)
        (do
            (let t-enter (now_unix_ms))
            (let gpu-enter (mbw-status-int (metal_status) "gpu_busy_us_total"))
            (let verdict (qaf-seal-verdict path))
            (let t-sealed (now_unix_ms))
            (if (not (eq verdict 1))
                (fcmg-heed-line "refused" (fcmg-seal-refusal verdict))
                (do
                    (let src (fcmg-src path))
                    (let arch (fcmg-arch src))
                    (let ids (fcmg-chat-ids src prompt))
                    (if (not (str_eq arch "qwen35"))
                        (fcmg-heed-line "refused" (str_concat "architecture=" arch))
                    (if (eq (len ids) 0)
                        (fcmg-heed-line "refused" "tokenizer produced no prompt tokens")
                        (do
                            (let model-max (gmt-u32 src (q38-key arch "context_length")))
                            ; both ledgers plus room for what gets injected
                            (let need (add (len ids) (add (add query reserve) 512)))
                            (let maxpos (if (lt need model-max) need model-max))
                            (let t-pre-open (now_unix_ms))
                            (let ctx (q38-open path maxpos))
                            (let t-opened (now_unix_ms))
                            (if (lt (len ctx) 10)
                                (fcmg-heed-line "refused"
                                    (str_concat "model context did not open; " (metal_status)))
                                (do
                                    (let sts (q38-new-state (nth ctx 2)))
                                    (if (not (eq (q38-state-ok? sts) 1))
                                        (fcmg-heed-line "refused"
                                            (str_concat "state allocation failed; " (metal_status)))
                                        (do
                                            (fcmg-heed-int "prompt-tokens" (len ids))
                                            (fcmg-heed-int "query-budget" query)
                                            (fcmg-heed-int "answer-reserve" reserve)
                                            (fcmg-heed-int "prefill-chunk" chunk)
                                            (let t-pre-run (now_unix_ms))
                                            (let gpu-pre-run
                                                (mbw-status-int (metal_status) "gpu_busy_us_total"))
                                            (let syncs-pre-run
                                                (mbw-status-int (metal_status) "total_sync"))
                                            (let disp-pre-run
                                                (mbw-status-int (metal_status) "total_dispatch"))
                                            (let r (fcmg-heed-generate-2p src ctx sts ids
                                                        (fcmg-q35-stops src)
                                                        lookupf 1
                                                        (MaxHeeds) query reserve chunk))
                                            (metal_sync)
                                            (let t-done (now_unix_ms))
                                            (let gpu-done
                                                (mbw-status-int (metal_status) "gpu_busy_us_total"))
                                            (fcmg-heed-report src r)
                                            (fcmg-heed-int "ms-seal" (sub t-sealed t-enter))
                                            (fcmg-heed-int "ms-header-read" (sub t-pre-open t-sealed))
                                            (fcmg-heed-int "ms-open" (sub t-opened t-pre-open))
                                            (fcmg-heed-int "ms-state" (sub t-pre-run t-opened))
                                            (fcmg-heed-int "ms-decode" (sub t-done t-pre-run))
                                            (fcmg-heed-int "ms-total" (sub t-done t-enter))
                                            (fcmg-heed-int "gpu-busy-us-decode" (sub gpu-done gpu-pre-run))
                                            (fcmg-heed-int "gpu-busy-us-setup" (sub gpu-pre-run gpu-enter))
                                            ; the stall, counted directly: how many
                                            ; times the carrier was asked to settle,
                                            ; and how many dispatches it carried.
                                            (fcmg-heed-int "carrier-syncs"
                                                (sub (mbw-status-int (metal_status) "total_sync") syncs-pre-run))
                                            (fcmg-heed-int "carrier-dispatches"
                                                (sub (mbw-status-int (metal_status) "total_dispatch") disp-pre-run))
                                            (fcmg-heed-int "positions-walked" (fhc-pos r))
                                            (q38-free-state sts)
                                            0)))))))))))

    (defn fcmg-run-context (src arch model ids thought-lists thought-eval ctx n gap-n)
        (do
            (let geo (nth ctx 2))
            (let sts (q38-new-state geo))
            (if (not (eq (q38-state-ok? sts) 1))
                (fcmg-state-close-result sts
                    (str_concat "generation refused: state allocation failed; " (metal_status)))
                (do
                    (let before-status (metal_status))
                    (let pf (q38-prefill
                        (nth ctx 0) (nth ctx 1) geo (nth ctx 3) sts
                        (nth ctx 4) (nth ctx 5) (nth ctx 6) ids 0))
                    (let stops (fcmg-q35-stops src))
                    (let offered
                        (if (eq (len thought-lists) 0)
                            (list (nth pf 0) (nth pf 1) (empty) 0 0)
                            (fcmg-offer-stream
                                (nth ctx 0) (nth ctx 1) geo (nth ctx 3) sts
                                (nth ctx 4) (nth ctx 5) (nth ctx 6)
                                thought-lists (nth pf 1) gap-n stops
                                (empty) 0 0)))
                    (let prefill-status (metal_status))
                    (let first (nth offered 0))
                    (let pos (nth offered 1))
                    (let stream-ids (nth offered 2))
                    (let thought-n (nth offered 3))
                    (let offers (nth offered 4))
                    (let model-extra (sub (len stream-ids) thought-n))
                    (let remain (sub n model-extra))
                    (let model-tail
                        (if (le remain 0) (empty)
                            (if (or (lt first 0) (q38-stop? first stops)) (empty)
                                (cons first
                                    (q38-generate
                                        (nth ctx 0) (nth ctx 1) geo (nth ctx 3) sts
                                        (nth ctx 4) (nth ctx 5) (nth ctx 6)
                                        first pos (sub remain 1) stops (empty))))))
                    (let out (tkz-cat stream-ids model-tail))
                    (metal_sync)
                    (let after-status (metal_status))
                    (let busy-us (sub
                        (mbw-status-int after-status "gpu_busy_us_total")
                        (mbw-status-int before-status "gpu_busy_us_total")))
                    (let prefill-us (sub
                        (mbw-status-int prefill-status "gpu_busy_us_total")
                        (mbw-status-int before-status "gpu_busy_us_total")))
                    (let decode-us (sub
                        (mbw-status-int after-status "gpu_busy_us_total")
                        (mbw-status-int prefill-status "gpu_busy_us_total")))
                    (let forwards (add (add (len ids) thought-n)
                        (if (gt (add model-extra (len model-tail)) 0)
                            (sub (add model-extra (len model-tail)) 1) 0)))
                    (let weight-bytes (q38-forward-weight-bytes ctx))
                    (fcmg-state-close-result sts
                        (fcmg-report model arch ids out (tkz-decode-text src out)
                            thought-eval offers thought-n
                            forwards busy-us prefill-us decode-us weight-bytes))))))

    (defn fcmg-chat-ids (src prompt)
        (if (eq (ftl-armed?) 1)
            (do (let ims (q35-special-id src "<|im_start|>"))
                (let ime (q35-special-id src "<|im_end|>"))
                (tkz-cat (q35-one ims)
                (tkz-cat (q35-encode src "system\n")
                (tkz-cat (q35-encode src (ftl-system-text))
                (tkz-cat (q35-one ime)
                (tkz-cat (q35-encode src "\n")
                         (q35-chat-ids src prompt)))))))
            (q35-chat-ids src prompt)))

    ; A first admission: the seal is verified before a single byte of the file is
    ; read for meaning, exactly as before.  What changed is only what is answered —
    ; the text AND the residence the admission earned, so a caller that keeps it
    ; does not pay this again.
    ; A refusal must name what actually refused.  Verdict 2 is the digest engine
    ; declining to run, which is a fact about this binary, not about the file —
    ; and it carries metal_status so the reason is in the sentence rather than in
    ; a later investigation.
    (defn fcmg-seal-refusal (verdict)
        (if (eq verdict 2)
            (str_concat "generation refused: the Form-native SHA-256 digest engine did not answer — this says nothing about the artifact; "
                (metal_status))
            "generation refused: selected artifact has no current Form-native SHA-256 seal"))

    (defn fcmg-noted (prompt arch model msg)
        (str_concat (lmc-say prompt arch model) (str_concat "\n" msg)))

    (defn fcmg-arch-door (arch model)
        (if (str_eq arch "deepseek4")
            (str_concat "generate on "
            (str_concat (if (str_eq model "") "this deepseek4 file" model)
                " uses the DS4 control stack (route / ds4-query). This door is Form-native generate for qwen35."))
            (str_concat "generate for architecture="
            (str_concat arch
            (str_concat " model="
            (str_concat (if (str_eq model "") "unnamed" model)
                " is unfinished on this door; choose and route still name the file."))))))

    (defn fcmg-fresh (path prompt n)
        (do
            (let verdict (qaf-seal-verdict path))
        (if (not (eq verdict 1))
            (list (fcmg-noted prompt "" "" (fcmg-seal-refusal verdict)) (fcmr-none))
            (do
                (let src (fcmg-src path))
                (let thoughts (lg-think-all prompt))
                (let thought-lists (fcmg-encode-thoughts src thoughts (empty)))
                (let thought-eval (lg-values-line thoughts))
                (let thought-n (fcmg-id-count thought-lists 0))
                (let gap-n (if (gt (len thoughts) 1) (lg-gap-default) 0))
                (let ids (fcmg-chat-ids src prompt))
                (let arch (fcmg-arch src))
                (let model (fcmg-name src))
                (let model-max (gmt-u32 src (q38-key arch "context_length")))
                (let need (add (add (len ids) thought-n)
                    (add (mul gap-n (if (gt (len thoughts) 1) (sub (len thoughts) 1) 0)) n)))
                (let maxpos (if (lt need model-max) need model-max))
                (let required (q38-required-size src (egg-data-base src 32)))
                (let actual (file_size path))
                (if (not (str_eq arch "qwen35"))
                    (list (fcmg-noted prompt arch model (fcmg-arch-door arch model))
                          (fcmr-none))
                (if (eq (len ids) 0)
                    (list (fcmg-noted prompt arch model "generation refused: tokenizer produced no prompt tokens")
                          (fcmr-none))
                (if (or (le n 0) (gt need model-max))
                    (list (fcmg-noted prompt arch model
                              (str_concat "generation refused: requested context exceeds model limit="
                                  (int_to_str model-max)))
                          (fcmr-none))
                (if (or (le required 0) (lt actual required))
                    (list (fcmg-noted prompt arch model
                              (str_concat "generation refused: incomplete tensor extent; required="
                                  (str_concat (int_to_str required)
                                      (str_concat ";actual=" (int_to_str actual)))))
                          (fcmr-none))
                    (do
                        (let ctx (q38-open path maxpos))
                        (if (lt (len ctx) 10)
                            (list (fcmg-noted prompt arch model
                                      (str_concat "generation refused: model context did not open; "
                                          (metal_status)))
                                  (fcmr-none))
                            (if (not (eq (q38-context-ok? ctx) 1))
                                (list (fcmg-noted prompt arch model
                                          (fcmg-open-refusal ctx "model context contains an invalid handle"))
                                      (fcmr-none))
                                (list (fcmg-noted prompt arch model
                                          (fcmg-run-context src arch model ids thought-lists thought-eval
                                              ctx n gap-n))
                                      (fcmr path maxpos ctx src arch)))))))))))))

    (defn fcmg-stale-close ()
        (list "generation refused: previous model handle close mismatch" (fcmr-none)))

    ; Generation against whatever the caller is already holding.  An empty
    ; residence, a residence for a different file, or a prompt that outgrows the
    ; ceiling this one was opened for all end in the same place — release, then
    ; admit — so there is one path and no mode to be in.
    (defn fcmg-generate-with (r path prompt n)
        (if (eq (fcmr-live? r) 0) (fcmg-fresh path prompt n)
            (if (not (str_eq (fcmr-path r) path))
                (if (eq (fcmr-release-ok? r) 1) (fcmg-fresh path prompt n) (fcmg-stale-close))
                (do
                    (let src (fcmr-src r))
                    (let arch (fcmr-arch r))
                    (let model (fcmg-name src))
                    (let thoughts (lg-think-all prompt))
                    (let thought-lists (fcmg-encode-thoughts src thoughts (empty)))
                    (let thought-eval (lg-values-line thoughts))
                    (let thought-n (fcmg-id-count thought-lists 0))
                    (let gap-n (if (gt (len thoughts) 1) (lg-gap-default) 0))
                    (let ids (fcmg-chat-ids src prompt))
                    (let model-max (gmt-u32 src (q38-key arch "context_length")))
                    (let need (add (add (len ids) thought-n)
                        (add (mul gap-n (if (gt (len thoughts) 1) (sub (len thoughts) 1) 0)) n)))
                    (if (eq (len ids) 0)
                        (list (fcmg-noted prompt arch model "generation refused: tokenizer produced no prompt tokens") r)
                    (if (or (le n 0) (gt need model-max))
                        (list (fcmg-noted prompt arch model
                                  (str_concat "generation refused: requested context exceeds model limit="
                                      (int_to_str model-max)))
                              r)
                    (if (le need (fcmr-maxpos r))
                        (list (fcmg-noted prompt arch model
                                  (fcmg-run-context src arch model ids thought-lists thought-eval
                                      (fcmr-ctx r) n gap-n))
                              r)
                        (if (eq (fcmr-release-ok? r) 1)
                            (fcmg-fresh path prompt n)
                            (fcmg-stale-close)))))))))

    ; The one-shot door, byte-identical in what it answers: admit, generate,
    ; release.  A caller with nothing to hold on to loses nothing and keeps the
    ; close check that was always here.
    (defn fcmg-q35-run (path prompt n)
        (do
            (let out (fcmg-generate-with (fcmr-none) path prompt n))
            (if (eq (fcmr-release-ok? (nth out 1)) 1) (nth out 0)
                "generation refused: model handle close mismatch")))

    ; The generate door carries the Form teach overlay. Raw fcmg-q35-run
    ; stays for probes that need an exact prompt.
    (defn fcmg-teach (prompt) (fqt-prompt prompt))
    ; The door a session speaks through: it is handed what the session holds and
    ; answers the text together with what it should keep holding.
    (defn fcmg-generate-resident (r path prompt n)
        (if (str_eq path "")
            (list "no model is picked — run `models <dir>`, then `use <n>`, then `generate <prompt>`" r)
            (if (str_eq prompt "") (list "usage: generate <prompt>" r)
                (fcmg-generate-with r path (fcmg-teach prompt) n))))
    ; The same door for a caller that holds nothing: admit, generate, release.
    (defn fcmg-generate (path prompt n)
        (do
            (let out (fcmg-generate-resident (fcmr-none) path prompt n))
            (if (eq (fcmr-release-ok? (nth out 1)) 1) (nth out 0)
                "generation refused: model handle close mismatch")))

    (defn fcmg-bandwidth (path)
        (if (str_eq path "")
            "no model is picked — run `models <dir>`, then `use <n>`, then `model-bandwidth`"
            (if (eq (qaf-verify-sealed-file path) 1)
                (mbw-run path)
                "bandwidth refused: selected artifact has no current Form-native SHA-256 seal")))

    ; The default witness answers `nothing` for every envelope — an unconfigured
    ; host honestly holds no knowledge. The grounded witness names the substrate
    ; this checkout DOES hold, so a hit can open the answer reserve for real.
    ; chunk 0 — one batch for the span — is the default because the body said so:
    ; the same prompt through chunk 1 and chunk 0 produced output-sha256
    ; 88bd9b9a...7fe1487f both times, with carrier syncs falling 506 -> 61.
    (defn fcmg-heed-witness (path prompt query reserve)
        (fcmg-heed-witness-with path prompt query reserve fcmg-heed-lookup-nothing 0))
    (defn fcmg-heed-witness-grounded (path prompt query reserve)
        (fcmg-heed-witness-with path prompt query reserve fhg-lookup 0))
    (defn fcmg-heed-witness-grounded-chunk (path prompt query reserve chunk)
        (fcmg-heed-witness-with path prompt query reserve fhg-lookup chunk))

    0)
