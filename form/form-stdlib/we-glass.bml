//////////////////////////////////////////////////////////////////////
//
// we-glass.bml
//
// Executable BML. WE ON GLASS: one shared panel that reads how much
// DO, BE and SEE each of us spends, at five altitudes, from durable
// sources the body already keeps — and offers the PRIMITIVES and the
// CHOICES that can be observed, each row naming its source and its
// evidence.
//
//   you   the body on this host: its primitive dispatches (DO), its
//         residents standing on a bell (BE), its glass renderers (SEE)
//   me    Urs: prompts this sitting (DO), the age since the sitting
//         last moved (BE); what Urs sees is not observable natively —
//         that row is absent and says so
//   us    this sitting: edits landed (DO), probes and reads (SEE);
//         its rest is not yet observable — absent, said so
//   US    the sittings of today: landings on main (DO), receipts (SEE),
//         fkwu processes standing now (BE)
//   WE    the collective ledger: released rows (DO), open rows held
//         (BE), corpus rows observed (SEE)
//
// "How much we spend" needs one unit. Two lanes have one: the host's
// fkwu processes (cpu shares by mode: renderers see, blocked residents
// are, everything else does) and the sitting's tool events (edits do,
// probes see). Every other number is a count in its own unit, shown
// with that unit, never folded into a percentage.
//
// Primitives: the owner's dispatch total, distinct surface and hottest
// tag from the bus, and this process's own (kernel_stat 0..3), the tag
// named through the native op manifest. Choices: every vocabulary the
// body already answers with — the glass control actions, the framebuffer
// control actions, the offer ack values, the channel admissions, the
// choice-receipt outcomes — as rows; where a count is observable today
// (the cell channels' admit/refuse/folded/witness) it is counted, where
// only the vocabulary stands the row is `declared`. An observed choice
// is a row anyone can read; a declared one is an offer to be observed.
//
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-fs.fk form/form-stdlib/line-grammar.fk form/form-stdlib/hearth.bml form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/term-graphics.bml form/form-stdlib/native-op-manifest.fk form/form-stdlib/cell-channel.bml
//
// Proven by: form-stdlib/tests/we-glass-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormWeGlass {
        thought wg-pattern = list("one-unit-or-no-percent", "absent-says-so", "source-on-every-row", "declared-is-an-offer");

        field WGPublisher = "we.glass";
        field WGLane = "we";
        field WGSource = "we.glass.census";
        field WGReceiptsDir = "receipts";
        field WGCorpusPath = "learn/homecoming-distillation-corpus.fk";
        field WGOwnerPrefix = "models.dual-resident.";

        // ── rows: (level mode value unit source evidence); value -1 is absent ──
        def wg-row(level, mode, value, unit, source, evidence) = list("we-row-v1", level, mode, value, unit, source, evidence);
        def wg-level(r) = nth(r, 1);
        def wg-mode(r) = nth(r, 2);
        def wg-value(r) = nth(r, 3);
        def wg-unit(r) = nth(r, 4);
        def wg-source(r) = nth(r, 5);
        def wg-evidence(r) = nth(r, 6);
        def wg-present?(r) = if ge(wg-value(r), 0) then 1 else 0;
        def wg-levels() = list("you", "me", "us", "us-all", "we");
        def wg-level-word(level) = if str_eq(level, "us-all") then "US" else if str_eq(level, "we") then "WE" else level;
        def wg-modes() = list("do", "be", "see");
        def wg-find(rows, level, mode) = if eq(len(rows), 0) then list() else if and(str_eq(wg-level(head(rows)), level), str_eq(wg-mode(head(rows)), mode)) then head(rows) else wg-find(tail(rows), level, mode);
        def wg-value-of(rows, level, mode) {
            let r = wg-find(rows, level, mode);
            if eq(len(r), 0) then sub(0, 1) else wg-value(r);
        }

        // ── small text tools ──
        def wg-cat(parts) = cc-cat(parts);
        def wg-text(t) = if nothing?(t) then "" else t;
        def wg-int(text, key) = fmv-field(text, key);
        def wg-lines(text) = if eq(str_len(text), 0) then list() else split-on(text, "\n");
        def wg-nonblank(lines) = if eq(len(lines), 0) then list() else if eq(str_len(trim(head(lines))), 0) then wg-nonblank(tail(lines)) else cons(head(lines), wg-nonblank(tail(lines)));
        def wg-pct(part, whole) = if le(whole, 0) then 0 else div(mul(part, 100), whole);

        // ── the host's fkwu processes: "cpu recipe" lines; mode by recipe ──
        def wg-ps-cmd() = "ps -axo pcpu=,command= | awk '$2 ~ /(^|\\/)fkwu$/ {printf \"%d %s\\n\", $1, $NF}'";
        def wg-ps-text() = wg-text(host-exec(wg-ps-cmd(), ""));
        def wg-process-mode(recipe) = if ge(str_find(recipe, "glass-live", 0), 0) then "see" else if ge(str_find(recipe, "glass-current", 0), 0) then "see" else if ge(str_find(recipe, "contribution-live", 0), 0) then "be" else if ge(str_find(recipe, "-live.fk", 0), 0) then "be" else "do";
        def wg-process-row(line) {
            let parts = split-on(trim(line), " ");
            if lt(len(parts), 2) then list() else list(str_to_int(head(parts)), nth(parts, 1), wg-process-mode(nth(parts, 1)));
        }
        def wg-process-rows(text) = wg-process-rows-go(wg-nonblank(wg-lines(text)));
        def wg-process-rows-go(lines) = if eq(len(lines), 0) then list() else if eq(len(wg-process-row(head(lines))), 0) then wg-process-rows-go(tail(lines)) else cons(wg-process-row(head(lines)), wg-process-rows-go(tail(lines)));
        def wg-cpu-of-mode(rows, mode) = if eq(len(rows), 0) then 0 else add(if str_eq(nth(head(rows), 2), mode) then head(head(rows)) else 0, wg-cpu-of-mode(tail(rows), mode));
        def wg-count-of-mode(rows, mode) = if eq(len(rows), 0) then 0 else add(if str_eq(nth(head(rows), 2), mode) then 1 else 0, wg-count-of-mode(tail(rows), mode));
        // the one-unit spend of the host: cpu shares by mode (do be see), summing to 100 when any cpu burns
        def wg-cpu-shares(rows) {
            let doCpu = wg-cpu-of-mode(rows, "do");
            let beCpu = wg-cpu-of-mode(rows, "be");
            let seeCpu = wg-cpu-of-mode(rows, "see");
            let whole = add(doCpu, add(beCpu, seeCpu));
            list(wg-pct(doCpu, whole), wg-pct(beCpu, whole), wg-pct(seeCpu, whole), whole);
        }

        // ── the sitting's transcript: one host read, parsed as name=value ──
        def wg-transcript-cmd(path) = wg-cat(list("T='", path, "'; printf 'prompts=%s edits=%s probes=%s tokens=%s\\n' \"$(grep '\"type\":\"user\"' \"$T\" | grep -vc tool_result)\" \"$(grep -o '\"name\":\"Edit\"\\|\"name\":\"Write\"' \"$T\" | wc -l | tr -d ' ')\" \"$(grep -o '\"name\":\"Bash\"\\|\"name\":\"Read\"\\|\"name\":\"Grep\"' \"$T\" | wc -l | tr -d ' ')\" \"$(grep -o '\"output_tokens\":[0-9]*' \"$T\" | cut -d: -f2 | awk '{s+=$1} END {print s+0}')\""));
        def wg-transcript-text(path) = if eq(str_len(path), 0) then "" else if eq(fs-exists?(path), 0) then "" else wg-text(host-exec(wg-transcript-cmd(path), ""));
        def wg-transcript-default-cmd() = "ls -t \"$HOME/.claude/projects/$(pwd | sed 's#/#-#g')\"/*.jsonl 2>/dev/null | head -1";
        def wg-transcript-default() = trim(wg-text(host-exec(wg-transcript-default-cmd(), "")));
        def wg-tool-shares(edits, probes) {
            let whole = add(edits, probes);
            list(wg-pct(edits, whole), 0, wg-pct(probes, whole), whole);
        }

        // ── the sittings of today: landings on main, receipts by witness, processes ──
        def wg-today() = trim(wg-text(host-exec("date +%Y-%m-%d", "")));
        def wg-landings-today() = str_to_int(trim(wg-text(host-exec("git log --since=midnight --format=%h origin/main 2>/dev/null | wc -l | tr -d ' '", ""))));
        def wg-receipts-today(names, today) = if eq(len(names), 0) then list() else if eq(str_find(head(names), today, 0), 0) then cons(head(names), wg-receipts-today(tail(names), today)) else wg-receipts-today(tail(names), today);
        def wg-witness-word(text) {
            let at = str_find(text, "Witness: ", 0);
            let at2 = str_find(text, "Signed, ", 0);
            if ge(at, 0) then cc-sym-at(text, add(at, 9)) else if ge(at2, 0) then cc-sym-at(text, add(at2, 8)) else "unsigned";
        }
        def wg-witness-clean(w) = if eq(str_len(w), 0) then "unsigned" else if or(eq(str_byte_at(w, sub(str_len(w), 1)), 44), eq(str_byte_at(w, sub(str_len(w), 1)), 46)) then substring(w, 0, sub(str_len(w), 1)) else w;
        def wg-receipt-witnesses(dir, names) = if eq(len(names), 0) then list() else cons(wg-witness-clean(wg-witness-word(wg-text(read_file(fs-path-join(dir, head(names)))))), wg-receipt-witnesses(dir, tail(names)));
        def wg-count-word(words, w) = if eq(len(words), 0) then 0 else add(if str_eq(head(words), w) then 1 else 0, wg-count-word(tail(words), w));
        def wg-distinct(words, acc) = if eq(len(words), 0) then reverse(acc) else if eq(cc-member?(acc, head(words)), 1) then wg-distinct(tail(words), acc) else wg-distinct(tail(words), cons(head(words), acc));
        def wg-witness-line(words, names) = if eq(len(names), 0) then "" else wg-cat(list(head(names), "=", int_to_str(wg-count-word(words, head(names))), " ", wg-witness-line(words, tail(names))));

        // ── the collective: ledger and corpus (the ledger speaks its one summary line through its own door) ──
        def wg-ledger-text() = wg-text(host-exec("./fkwu form/form-stdlib/release-ledger.bml 2>/dev/null | grep '^open=' | tail -1", ""));
        def wg-ledger(key) = wg-int(wg-ledger-text(), key);
        def wg-corpus-rows() = str_to_int(trim(wg-text(host-exec(wg-cat(list("grep -c '(hdc-row ' ", WGCorpusPath())), ""))));

        // ── primitives: this process and the owner on the bus, the tag named ──
        def wg-op-name-go(rows, tag) = if eq(len(rows), 0) then str_concat("tag-", int_to_str(tag)) else if eq(nth(head(rows), 2), tag) then head(head(rows)) else wg-op-name-go(tail(rows), tag);
        def wg-op-name(tag) = wg-op-name-go(nom-ops(), tag);
        def wg-prim(name, count, source, evidence) = list("we-primitive-v1", name, count, source, evidence);
        def wg-prim-name(p) = nth(p, 1);
        def wg-prim-count(p) = nth(p, 2);
        def wg-self-primitives() = list(wg-prim("self.dispatch-total", kernel_stat(0), "kernel-stat-0", "physical-live"), wg-prim("self.dispatch-distinct", kernel_stat(1), "kernel-stat-1", "physical-live"), wg-prim(str_concat("self.hottest.", wg-op-name(kernel_stat(2))), kernel_stat(3), "kernel-stat-2-3", "physical-live"));
        def wg-owner-publisher-go(names) = if eq(len(names), 0) then "" else if eq(str_find(head(names), WGOwnerPrefix(), 0), 0) then head(names) else wg-owner-publisher-go(tail(names));
        def wg-owner-publisher(troot) {
            let inv = fgtm-inventory(troot);
            if not(str_eq(nth(inv, 2), "current")) then "" else wg-owner-publisher-go(nth(inv, 3));
        }
        def wg-sample-by-id(samples, id) = if eq(len(samples), 0) then list() else if str_eq(fgtm-sample-id(head(samples)), id) then head(samples) else wg-sample-by-id(tail(samples), id);
        def wg-sample-capacity(samples, id) {
            let s = wg-sample-by-id(samples, id);
            if eq(len(s), 0) then sub(0, 1) else if eq(fgtm-field-present?(fgtm-sample-capacity(s)), 1) then fgtm-field-value(fgtm-sample-capacity(s)) else sub(0, 1);
        }
        def wg-owner-samples(troot, publisher) {
            let reading = fgtm-read-current(troot, publisher);
            if not(str_eq(fgtm-read-state-status(reading), "current")) then list() else fgtm-snapshot-samples(fgtm-field-value(fgtm-read-state-value(reading)));
        }
        def wg-owner-primitives-of(samples, publisher) = if eq(len(samples), 0) then list() else list(wg-prim("owner.dispatch-total", wg-sample-capacity(samples, "primitive.owner.dispatch-total"), publisher, "physical-live"), wg-prim("owner.dispatch-distinct", wg-sample-capacity(samples, "primitive.owner.dispatch-distinct"), publisher, "physical-live"), wg-prim(str_concat("owner.hottest.", wg-op-name(wg-sample-capacity(samples, "primitive.owner.hottest-tag"))), wg-sample-capacity(samples, "primitive.owner.hottest-count"), publisher, "physical-live"));
        def wg-owner-primitives(troot) {
            let publisher = wg-owner-publisher(troot);
            if eq(str_len(publisher), 0) then list() else wg-owner-primitives-of(wg-owner-samples(troot, publisher), publisher);
        }
        def wg-primitives(troot) = append(wg-owner-primitives(troot), wg-self-primitives());

        // ── choices: every vocabulary the body answers with, counted where it can be ──
        def wg-choice(family, name, count, evidence) = list("we-choice-v1", family, name, count, evidence);
        def wg-choice-family(c) = nth(c, 1);
        def wg-choice-name(c) = nth(c, 2);
        def wg-choice-count(c) = nth(c, 3);
        def wg-choice-evidence(c) = nth(c, 4);
        def wg-declared(family, names) = if eq(len(names), 0) then list() else cons(wg-choice(family, head(names), sub(0, 1), "declared"), wg-declared(family, tail(names)));
        def wg-glass-actions() = list("continue", "branch", "revise", "abstain", "request-evidence", "rehearse-ground", "alternative-node", "focus", "inspect");
        def wg-framebuffer-actions() = list("admit-candidate", "defer-candidate", "reject-candidate");
        def wg-ack-values() = list("nothing", "0", "1", "node");
        def wg-receipt-outcomes() = list("success", "fail", "silence");
        def wg-channel-kinds() = list("admit", "refuse", "folded", "witness");
        def wg-kind-count-go(stats, root, kind) = if eq(len(stats), 0) then 0 else add(wg-kind-count-one(root, cc-stat-name(head(stats)), kind), wg-kind-count-go(tail(stats), root, kind));
        def wg-kind-count-one(root, name, kind) = add(len(cc-frames-of-kind(cc-spool-frames(root, name, cc-a(root, name)), kind)), add(len(cc-frames-of-kind(cc-spool-frames(root, name, cc-b(root, name)), kind)), len(cc-frames-of-kind(cc-spool-frames(root, name, cc-field-name()), kind))));
        def wg-channel-choices-go(stats, root, kinds) = if eq(len(kinds), 0) then list() else cons(wg-choice("channel", head(kinds), wg-kind-count-go(stats, root, head(kinds)), if gt(len(stats), 0) then "physical-live" else "declared"), wg-channel-choices-go(stats, root, tail(kinds)));
        def wg-channel-choices(root) = wg-channel-choices-go(cc-mesh(root), root, wg-channel-kinds());
        def wg-choices(root) = append(wg-channel-choices(root), append(wg-declared("glass-control", wg-glass-actions()), append(wg-declared("framebuffer-control", wg-framebuffer-actions()), append(wg-declared("offer-ack", wg-ack-values()), wg-declared("choice-receipt", wg-receipt-outcomes())))));
        def wg-choices-observed(choices) = if eq(len(choices), 0) then 0 else add(if ge(wg-choice-count(head(choices)), 0) then 1 else 0, wg-choices-observed(tail(choices)));

        // ── the census: every row from its source (the fold is pure; the reads are the door's) ──
        def wg-census-of(procRows, ownerTotal, prompts, edits, probes, sittingAgeMs, landings, receipts, residents, ledgerReleased, ledgerOpen, corpusRows) = list(
            wg-row("you", "do", ownerTotal, "dispatches", "bus.primitive.owner.dispatch-total", if ge(ownerTotal, 0) then "physical-live" else "declared"),
            wg-row("you", "be", residents, "residents", "ps.fkwu.blocked-on-a-bell", "physical-live"),
            wg-row("you", "see", wg-count-of-mode(procRows, "see"), "renderers", "ps.fkwu.glass-live", "physical-live"),
            wg-row("me", "do", prompts, "prompts", "transcript.user-lines", if ge(prompts, 0) then "physical-live" else "declared"),
            wg-row("me", "be", sittingAgeMs, "ms-since-last-move", "transcript.mtime", if ge(sittingAgeMs, 0) then "derived-window" else "declared"),
            wg-row("me", "see", sub(0, 1), "not-observable-natively", "none", "declared"),
            wg-row("us", "do", edits, "edits", "transcript.edit-write", if ge(edits, 0) then "physical-live" else "declared"),
            wg-row("us", "be", sub(0, 1), "not-observable-yet", "none", "declared"),
            wg-row("us", "see", probes, "probes", "transcript.bash-read-grep", if ge(probes, 0) then "derived-window" else "declared"),
            wg-row("us-all", "do", landings, "landings", "git.origin-main.today", "physical-live"),
            wg-row("us-all", "be", len(procRows), "fkwu-processes", "ps.fkwu", "physical-live"),
            wg-row("us-all", "see", receipts, "receipts", "receipts.today", "physical-live"),
            wg-row("we", "do", ledgerReleased, "released", "release-ledger", "physical-live"),
            wg-row("we", "be", ledgerOpen, "open", "release-ledger", "physical-live"),
            wg-row("we", "see", corpusRows, "corpus-rows", "corpus.hdc-row", "physical-live")
        );
        def wg-rows-valid?(rows) = if eq(len(rows), 0) then 1 else if not(eq(len(head(rows)), 7)) then 0 else if not(eq(cc-member?(wg-levels(), wg-level(head(rows))), 1)) then 0 else if not(eq(cc-member?(wg-modes(), wg-mode(head(rows))), 1)) then 0 else wg-rows-valid?(tail(rows));

        // ── samples for the bus ──
        def wg-tags() = list("all", "we", "mesh");
        def wg-row-sample(r, epoch) = fgtm-sample(wg-cat(list("we.", wg-level(r), ".", wg-mode(r))), fgtm-absent(), "we-census", "form", WGPublisher(), WGLane(), if eq(wg-present?(r), 1) then wg-unit(r) else "absent-said-so", fgtm-absent(), if eq(wg-present?(r), 1) then fgtm-present(wg-value(r)) else fgtm-absent(), if eq(wg-present?(r), 1) then "active" else "unknown", fgtm-absent(), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "never", wg-evidence(r), WGSource(), wg-tags());
        def wg-row-samples(rows, epoch) = if eq(len(rows), 0) then list() else cons(wg-row-sample(head(rows), epoch), wg-row-samples(tail(rows), epoch));
        def wg-share-sample(id, shares, epoch, source) = fgtm-sample(id, fgtm-absent(), "we-share", "form", WGPublisher(), WGLane(), wg-cat(list("do-", int_to_str(nth(shares, 0)), "-be-", int_to_str(nth(shares, 1)), "-see-", int_to_str(nth(shares, 2)))), fgtm-absent(), fgtm-present(nth(shares, 3)), if gt(nth(shares, 3), 0) then "active" else "idle", fgtm-absent(), fgtm-present(epoch), fgtm-present(nth(shares, 2)), fgtm-absent(), "never", "derived-window", source, wg-tags());
        def wg-prim-sample(p, epoch) = fgtm-sample(str_concat("primitive.", wg-prim-name(p)), fgtm-absent(), "primitive", "form", WGPublisher(), WGLane(), "offered-to-be-observed", fgtm-absent(), if ge(wg-prim-count(p), 0) then fgtm-present(wg-prim-count(p)) else fgtm-absent(), "active", fgtm-absent(), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "never", nth(p, 4), nth(p, 3), wg-tags());
        def wg-prim-samples(ps, epoch) = if eq(len(ps), 0) then list() else cons(wg-prim-sample(head(ps), epoch), wg-prim-samples(tail(ps), epoch));
        def wg-choice-sample(c, epoch) = fgtm-sample(wg-cat(list("choice.", wg-choice-family(c), ".", wg-choice-name(c))), fgtm-absent(), "choice", "form", WGPublisher(), WGLane(), if ge(wg-choice-count(c), 0) then "observed" else "offered-to-be-observed", fgtm-absent(), if ge(wg-choice-count(c), 0) then fgtm-present(wg-choice-count(c)) else fgtm-absent(), if ge(wg-choice-count(c), 0) then "active" else "idle", fgtm-absent(), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "never", wg-choice-evidence(c), WGSource(), wg-tags());
        def wg-choice-samples(cs, epoch) = if eq(len(cs), 0) then list() else cons(wg-choice-sample(head(cs), epoch), wg-choice-samples(tail(cs), epoch));
        def wg-samples(rows, cpuShares, toolShares, prims, choices, epoch) = append(wg-row-samples(rows, epoch), append(list(wg-share-sample("we.spend.host-cpu", cpuShares, epoch, "ps.fkwu.pcpu"), wg-share-sample("we.spend.sitting-tools", toolShares, epoch, "transcript.tool-events")), append(wg-prim-samples(prims, epoch), wg-choice-samples(choices, epoch))));
        def wg-publish-to(troot, samples, epoch) = fgtm-publish-snapshot(troot, WGPublisher(), epoch, samples);

        // ── lanes for the terminal panel ──
        def wg-cell(rows, level, mode) {
            let r = wg-find(rows, level, mode);
            if eq(len(r), 0) then "?" else if eq(wg-present?(r), 0) then "absent" else str_concat(tg-count(wg-value(r)), str_concat(" ", wg-unit(r)));
        }
        def wg-level-lane(rows, level) = tg-lane(wg-cat(list(if lt(str_len(wg-level-word(level)), 3) then str_concat(wg-level-word(level), "     ") else if lt(str_len(wg-level-word(level)), 6) then str_concat(wg-level-word(level), "   ") else wg-level-word(level))), wg-cat(list("DO ", wg-cell(rows, level, "do"), " | BE ", wg-cell(rows, level, "be"), " | SEE ", wg-cell(rows, level, "see"))), "plain", sub(0, 1));
        def wg-level-lanes(rows, levels) = if eq(len(levels), 0) then list() else cons(wg-level-lane(rows, head(levels)), wg-level-lanes(rows, tail(levels)));
        def wg-share-lane(label, shares) = tg-lane(label, wg-cat(list("DO ", int_to_str(nth(shares, 0)), "% ", tg-bar(div(nth(shares, 0), 10), 10), "  BE ", int_to_str(nth(shares, 1)), "% ", tg-bar(div(nth(shares, 1), 10), 10), "  SEE ", int_to_str(nth(shares, 2)), "% ", tg-bar(div(nth(shares, 2), 10), 10), "  of ", int_to_str(nth(shares, 3)))), if gt(nth(shares, 3), 0) then "good" else "dim", sub(0, 1));
        def wg-prim-line(ps) = if eq(len(ps), 0) then "" else wg-cat(list(wg-prim-name(head(ps)), "=", if ge(wg-prim-count(head(ps)), 0) then tg-count(wg-prim-count(head(ps))) else "absent", " ", wg-prim-line(tail(ps))));
        def wg-choice-line(cs) = if eq(len(cs), 0) then "" else wg-cat(list(wg-choice-name(head(cs)), if ge(wg-choice-count(head(cs)), 0) then str_concat("=", int_to_str(wg-choice-count(head(cs)))) else "?", " ", wg-choice-line(tail(cs))));
        def wg-choices-of-family(cs, family) = if eq(len(cs), 0) then list() else if str_eq(wg-choice-family(head(cs)), family) then cons(head(cs), wg-choices-of-family(tail(cs), family)) else wg-choices-of-family(tail(cs), family);
        def wg-families() = list("channel", "glass-control", "framebuffer-control", "offer-ack", "choice-receipt");
        def wg-choice-lanes(cs, families) = if eq(len(families), 0) then list() else cons(tg-lane(wg-cat(list("choice ", head(families), " ")), wg-choice-line(wg-choices-of-family(cs, head(families))), if gt(wg-choices-observed(wg-choices-of-family(cs, head(families))), 0) then "plain" else "dim", sub(0, 1)), wg-choice-lanes(cs, tail(families)));
        def wg-lanes(rows, cpuShares, toolShares, prims, choices, witnessLine) = append(cons(tg-lane("WE      ", "you . me . us . US . WE   (DO | BE | SEE, each row from its source; absent says so)", "plain", sub(0, 1)), wg-level-lanes(rows, wg-levels())), append(list(wg-share-lane("spend host ", cpuShares), wg-share-lane("spend sitting ", toolShares), tg-lane("witness ", witnessLine, "plain", sub(0, 1)), tg-lane("primitives ", wg-prim-line(prims), "plain", sub(0, 1))), wg-choice-lanes(choices, wg-families())));
        def wg-frame(rows, cpuShares, toolShares, prims, choices, witnessLine) = tg-frame(wg-lanes(rows, cpuShares, toolShares, prims, choices, witnessLine));
    }
    0;
}
