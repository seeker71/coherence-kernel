; form-cli-mlx-run.fk — watch MLX birth 2+3 on this fkwu, not a second binary.
;
; BML names the operands (allowance-birth). mlx_add is the organ.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-allowance-birth.bml observe/bidirectional-framebuffer-channel.fk

(do
    (print "form-cli executed mlx\n")
    (print "form-cli bml lhs=")
    (print (int_to_str (alb-lhs)))
    (print " rhs=")
    (print (int_to_str (alb-rhs)))
    (print " bml=")
    (print (int_to_str (alb-bml)))
    (print "\nform-cli mlx-add=")
    (print (int_to_str (mlx_add (alb-lhs) (alb-rhs))))
    (print "\n")
    (framebuffer-clear)
    (print "form-cli fb-action=")
    (print (int_to_str (bfc-payload (nth (bfc-round 1 (list 4 2) (list 4 2) (list 0 4) 0) 1))))
    (print " fb-events=")
    (print (int_to_str (len (framebuffer-events))))
    (print "\nform-cli mlx=\n")
    (print (mlx_status))
    (print "\n")
    0)
