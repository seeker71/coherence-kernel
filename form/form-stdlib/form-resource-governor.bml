//////////////////////////////////////////////////////////////////////
//
// form-resource-governor.bml — executable cooperative governor.
//
// This cell computes bounded grants and release plans from typed carrier
// observations.  It applies no host nice/QoS setting and submits no Metal
// work itself: those are explicit offers whose carrier acknowledgement is
// separate evidence.
//
// Authority: form-stdlib/bml/form-resource-governor.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/bml/form-glass-observation-v2.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormResourceGovernor {
        field FRGSchema = "form-resource-governor-v2";

        // All thresholds live in this row.  Callers may provide another row;
        // the state machine contains no hidden policy quantities.
        // tag, active-ms, quiet-ms, scale, target, additive step,
        // recovery clean frames, fresh age frames, latency half/stop,
        // memory warning/critical, thermal half/stop, CPU nice, CPU QoS,
        // max background Metal in flight.
        def frg-policy(activeMs, quietMs, scale, target, additiveStep, cleanFrames, freshFrames, latencyHalfMs, latencyStopMs, memoryWarning, memoryCritical, thermalHalf, thermalStop, cpuNice, cpuQos, maxMetalInFlight) = list("form-resource-policy-v1", activeMs, quietMs, scale, target, additiveStep, cleanFrames, freshFrames, latencyHalfMs, latencyStopMs, memoryWarning, memoryCritical, thermalHalf, thermalStop, cpuNice, cpuQos, maxMetalInFlight);
        def frg-active-ms(policy) = policy[1];
        def frg-quiet-ms(policy) = policy[2];
        def frg-scale(policy) = policy[3];
        def frg-target-ratio(policy) = policy[4];
        def frg-recovery-step(policy) = policy[5];
        def frg-clean-needed(policy) = policy[6];
        def frg-fresh-frames(policy) = policy[7];
        def frg-latency-half(policy) = policy[8];
        def frg-latency-stop(policy) = policy[9];
        def frg-memory-warning(policy) = policy[10];
        def frg-memory-critical(policy) = policy[11];
        def frg-thermal-half(policy) = policy[12];
        def frg-thermal-stop(policy) = policy[13];
        def frg-cpu-nice(policy) = policy[14];
        def frg-cpu-qos(policy) = policy[15];
        def frg-max-metal-inflight(policy) = policy[16];
        def frg-default-policy() = frg-policy(250, 500, 1000, 900, 50, 2, 1, 250, 500, 1, 2, 1, 2, 10, "utility", 1);
        def frg-policy-valid?(policy) = !((Comparable) len(policy) == 17) ? 0 : !((String) head(policy) == "form-resource-policy-v1") ? 0 : frg-active-ms(policy) <= 0 ? 0 : frg-quiet-ms(policy) < frg-active-ms(policy) ? 0 : frg-scale(policy) <= 0 ? 0 : frg-target-ratio(policy) < 0 ? 0 : frg-target-ratio(policy) > frg-scale(policy) ? 0 : frg-recovery-step(policy) <= 0 ? 0 : frg-recovery-step(policy) > frg-scale(policy) ? 0 : frg-clean-needed(policy) < 1 ? 0 : frg-fresh-frames(policy) < 0 ? 0 : frg-latency-half(policy) < 0 ? 0 : frg-latency-stop(policy) < frg-latency-half(policy) ? 0 : frg-memory-warning(policy) < 1 ? 0 : frg-memory-critical(policy) <= frg-memory-warning(policy) ? 0 : frg-thermal-half(policy) < 0 ? 0 : frg-thermal-stop(policy) <= frg-thermal-half(policy) ? 0 : frg-cpu-nice(policy) < 0 ? 0 : frg-cpu-nice(policy) > 19 ? 0 : (Comparable) str_len(frg-cpu-qos(policy)) == 0 ? 0 : !((Comparable) frg-max-metal-inflight(policy) == 1) ? 0 : 1;

        // The Glass v2 truth spine owns truth variants and process provenance.
        // This envelope adds governor-frame age; it does not invent a second
        // absent/stale/error vocabulary.
        def frg-declared-provenance(publisher) = fgov2-provenance("declared", publisher, fgov2-unavailable("process-not-observed", "process.lifetime"), fgov2-measured(0), fgov2-measured(0), "form.resource-governor");
        def frg-signal(truth, ageFrames, provenance) = list("form-resource-signal-v1", truth, ageFrames, provenance);
        def frg-measured(value, ageFrames, provenance) = frg-signal(fgov2-measured(value), ageFrames, provenance);
        def frg-absent(reason) = frg-signal(fgov2-absent(reason), 0, frg-declared-provenance("resource.absent"));
        def frg-unavailable(reason, missingDoor) = frg-signal(fgov2-unavailable(reason, missingDoor), 0, frg-declared-provenance("resource.unavailable"));
        def frg-stale(lastValue, lastObservedEpoch, ageFrames, publisher) = frg-signal(fgov2-stale(lastValue, lastObservedEpoch, "publisher-lease-expired"), ageFrames, frg-declared-provenance(publisher));
        def frg-error(stage, code, retryable) = frg-signal(fgov2-error(stage, code, retryable), 0, frg-declared-provenance("resource.error"));
        def frg-signal-truth(signal) = signal[1];
        def frg-signal-kind(signal) = fgov2-truth-kind(frg-signal-truth(signal));
        def frg-signal-value(signal) = fgov2-truth-value(frg-signal-truth(signal));
        def frg-signal-age(signal) = signal[2];
        def frg-signal-provenance(signal) = signal[3];
        def frg-provenance-current?(provenance) = !((Comparable) fgov2-provenance?(provenance) == 1) ? 0 : !((String) fgov2-provenance-evidence(provenance) == "physical-live") ? 0 : !((Comparable) fgov2-measured?(fgov2-provenance-lifetime(provenance)) == 1) ? 0 : !((Comparable) fgov2-measured?(fgov2-provenance-sequence(provenance)) == 1) ? 0 : !((Comparable) fgov2-measured?(fgov2-provenance-observed(provenance)) == 1) ? 0 : 1;
        def frg-signal-shape?(signal) = nothing?(signal) ? 0 : !((Comparable) len(signal) == 4) ? 0 : !((String) head(signal) == "form-resource-signal-v1") ? 0 : 1;
        def frg-signal-fresh?(policy, signal) = !((Comparable) frg-signal-shape?(signal) == 1) ? 0 : !((Comparable) fgov2-truth?(frg-signal-truth(signal)) == 1) ? 0 : !((Comparable) fgov2-measured?(frg-signal-truth(signal)) == 1) ? 0 : !((Comparable) frg-provenance-current?(frg-signal-provenance(signal)) == 1) ? 0 : frg-signal-age(signal) < 0 ? 0 : frg-signal-age(signal) <= frg-fresh-frames(policy) ? 1 : 0;
        def frg-signal-nonnegative?(policy, signal) = !((Comparable) frg-signal-fresh?(policy, signal) == 1) ? 0 : frg-signal-value(signal) >= 0 ? 1 : 0;

        // Resource observations: capacity, current foreground demand, and
        // hard reserve are all carrier measurements, independently typed.
        def frg-resource(name, capacity, foreground, reserve) = list("form-resource-observation-v1", name, capacity, foreground, reserve);
        def frg-resource-name(resource) = resource[1];
        def frg-resource-capacity(resource) = resource[2];
        def frg-resource-foreground(resource) = resource[3];
        def frg-resource-reserve(resource) = resource[4];
        def frg-resource-shape?(resource) = nothing?(resource) ? 0 : !((Comparable) len(resource) == 5) ? 0 : !((String) head(resource) == "form-resource-observation-v1") ? 0 : 1;
        def frg-resource-fresh?(policy, resource) = !((Comparable) frg-resource-shape?(resource) == 1) ? 0 : ((Comparable) frg-signal-nonnegative?(policy, frg-resource-capacity(resource)) == 1) && (((Comparable) frg-signal-nonnegative?(policy, frg-resource-foreground(resource)) == 1) && ((Comparable) frg-signal-nonnegative?(policy, frg-resource-reserve(resource)) == 1)) ? 1 : 0;
        def frg-max-zero(value) = value > 0 ? value : 0;
        def frg-min(a, b) = a <= b ? a : b;
        def frg-resource-available(resource) = frg-max-zero((frg-signal-value(frg-resource-capacity(resource)) - frg-signal-value(frg-resource-foreground(resource))) - frg-signal-value(frg-resource-reserve(resource)));
        def frg-resource-target(policy, resource) = (frg-resource-available(resource) * frg-target-ratio(policy)) / frg-scale(policy);
        def frg-resource-step-size(policy, resource) = frg-max-zero((frg-signal-value(frg-resource-capacity(resource)) * frg-recovery-step(policy)) / frg-scale(policy));

        // Sample: active request count, CPU/GPU/memory resource observations,
        // foreground-presence, latency, memory pressure, thermal level,
        // low-power state, background Metal in-flight count.
        def frg-sample(activeRequests, cpu, gpu, memory, foreground, latencyMs, memoryPressure, thermal, lowPower, metalInFlight) = list("form-resource-sample-v1", activeRequests, cpu, gpu, memory, foreground, latencyMs, memoryPressure, thermal, lowPower, metalInFlight);
        def frg-active-requests(sample) = sample[1];
        def frg-cpu(sample) = sample[2];
        def frg-gpu(sample) = sample[3];
        def frg-memory(sample) = sample[4];
        def frg-foreground(sample) = sample[5];
        def frg-latency(sample) = sample[6];
        def frg-pressure(sample) = sample[7];
        def frg-thermal(sample) = sample[8];
        def frg-low-power(sample) = sample[9];
        def frg-metal-inflight(sample) = sample[10];
        def frg-sample-shape?(sample) = nothing?(sample) ? 0 : !((Comparable) len(sample) == 11) ? 0 : !((String) head(sample) == "form-resource-sample-v1") ? 0 : 1;
        def frg-sample-fresh?(policy, sample) = !((Comparable) frg-sample-shape?(sample) == 1) ? 0 : ((Comparable) frg-signal-nonnegative?(policy, frg-active-requests(sample)) == 1) && (((Comparable) frg-resource-fresh?(policy, frg-cpu(sample)) == 1) && (((Comparable) frg-resource-fresh?(policy, frg-gpu(sample)) == 1) && (((Comparable) frg-resource-fresh?(policy, frg-memory(sample)) == 1) && (((Comparable) frg-signal-nonnegative?(policy, frg-foreground(sample)) == 1) && (((Comparable) frg-signal-nonnegative?(policy, frg-latency(sample)) == 1) && (((Comparable) frg-signal-nonnegative?(policy, frg-pressure(sample)) == 1) && (((Comparable) frg-signal-nonnegative?(policy, frg-thermal(sample)) == 1) && (((Comparable) frg-signal-nonnegative?(policy, frg-low-power(sample)) == 1) && ((Comparable) frg-signal-nonnegative?(policy, frg-metal-inflight(sample)) == 1))))))))) ? 1 : 0;
        def frg-sample-active?(policy, sample) = !((Comparable) frg-sample-fresh?(policy, sample) == 1) ? 1 : (Comparable) frg-critical?(policy, sample) == 1 ? 1 : (Comparable) frg-half?(policy, sample) == 1 ? 1 : frg-signal-value(frg-active-requests(sample)) > 0 ? 1 : frg-signal-value(frg-foreground(sample)) > 0 ? 1 : frg-signal-value(frg-metal-inflight(sample)) > 0 ? 1 : 0;
        def frg-frame-ms(policy, sample) = (Comparable) frg-sample-active?(policy, sample) == 1 ? frg-active-ms(policy) : frg-quiet-ms(policy);

        // One resident governor owns this state.  Workers receive a permit,
        // never a copy of the state; the owner serializes permit consumption.
        def frg-state(cpuGrant, gpuGrant, memoryGrant, cleanFrames, tick) = frg-state-with-permit(cpuGrant, gpuGrant, memoryGrant, cleanFrames, tick, list());
        def frg-state-with-permit(cpuGrant, gpuGrant, memoryGrant, cleanFrames, tick, permit) = list("form-resource-governor-state-v1", cpuGrant, gpuGrant, memoryGrant, cleanFrames, tick, permit);
        def frg-state-cpu(state) = state[1];
        def frg-state-gpu(state) = state[2];
        def frg-state-memory(state) = state[3];
        def frg-state-clean(state) = state[4];
        def frg-state-tick(state) = state[5];
        def frg-state-permit(state) = state[6];
        def frg-initial-state() = frg-state(0, 0, 0, 0, 0);
        def frg-state-shape?(state) = nothing?(state) ? 0 : !((Comparable) len(state) == 7) ? 0 : !((String) head(state) == "form-resource-governor-state-v1") ? 0 : 1;
        def frg-state-valid?(state) = !((Comparable) frg-state-shape?(state) == 1) ? 0 : frg-state-cpu(state) < 0 ? 0 : frg-state-gpu(state) < 0 ? 0 : frg-state-memory(state) < 0 ? 0 : frg-state-clean(state) < 0 ? 0 : frg-state-tick(state) < 0 ? 0 : (Comparable) len(frg-state-permit(state)) == 0 ? 1 : frg-permit-valid?(frg-state-permit(state));
        def frg-safe-state(state) = (Comparable) frg-state-valid?(state) == 1 ? state : frg-initial-state();

        // Permit identity is bound to the Metal publisher's complete process
        // lifetime plus its exact sequence and observation epoch.
        def frg-provenance-lifetime-value(provenance) = fgov2-truth-value(fgov2-provenance-lifetime(provenance));
        def frg-provenance-sequence-value(provenance) = fgov2-truth-value(fgov2-provenance-sequence(provenance));
        def frg-provenance-observed-value(provenance) = fgov2-truth-value(fgov2-provenance-observed(provenance));
        def frg-provenance-pid(provenance) = fgov2-lifetime-pid(frg-provenance-lifetime-value(provenance));
        def frg-provenance-started(provenance) = fgov2-lifetime-started(frg-provenance-lifetime-value(provenance));
        def frg-provenance-incarnation(provenance) = fgov2-lifetime-incarnation(frg-provenance-lifetime-value(provenance));
        def frg-provenance-same-lifetime?(a, b) = !(((Comparable) frg-provenance-current?(a) == 1) && ((Comparable) frg-provenance-current?(b) == 1)) ? 0 : !((String) fgov2-provenance-publisher(a) == fgov2-provenance-publisher(b)) ? 0 : !((Comparable) frg-provenance-pid(a) == frg-provenance-pid(b)) ? 0 : !((Comparable) frg-provenance-started(a) == frg-provenance-started(b)) ? 0 : !((String) frg-provenance-incarnation(a) == frg-provenance-incarnation(b)) ? 0 : 1;
        def frg-provenance-exact?(a, b) = !((Comparable) frg-provenance-same-lifetime?(a, b) == 1) ? 0 : !((Comparable) frg-provenance-sequence-value(a) == frg-provenance-sequence-value(b)) ? 0 : !((Comparable) frg-provenance-observed-value(a) == frg-provenance-observed-value(b)) ? 0 : !((String) fgov2-provenance-source(a) == fgov2-provenance-source(b)) ? 0 : 1;
        def frg-provenance-advances?(prior, next) = !((Comparable) frg-provenance-same-lifetime?(prior, next) == 1) ? 0 : frg-provenance-sequence-value(next) <= frg-provenance-sequence-value(prior) ? 0 : frg-provenance-observed-value(next) <= frg-provenance-observed-value(prior) ? 0 : 1;
        def frg-permit-id-for(provenance, tick) = fgov2-provenance-publisher(provenance) ++ ":" ++ frg-provenance-incarnation(provenance) ++ ":" ++ int_to_str(frg-provenance-sequence-value(provenance)) ++ ":" ++ int_to_str(tick);

        // Open is a policy offer. Reserved is possible only after the fixed
        // filesystem slot has been created and its exact owner bytes written.
        // Submitted additionally retains the exact command-buffer handle and
        // the exact submit observation that produced it.
        def frg-metal-permit(id, tick, status, provenance, commandHandle, submitProvenance, slotPath, ownerText) = list("form-resource-metal-permit-v2", id, tick, status, provenance, commandHandle, submitProvenance, slotPath, ownerText);
        def frg-permit-id(permit) = permit[1];
        def frg-permit-tick(permit) = permit[2];
        def frg-permit-status(permit) = permit[3];
        def frg-permit-provenance(permit) = permit[4];
        def frg-permit-command-handle(permit) = permit[5];
        def frg-permit-submit-provenance(permit) = permit[6];
        def frg-permit-slot-path(permit) = permit[7];
        def frg-permit-owner-text(permit) = permit[8];
        def frg-permit-publisher(permit) = fgov2-provenance-publisher(frg-permit-provenance(permit));
        def frg-permit-incarnation(permit) = frg-provenance-incarnation(frg-permit-provenance(permit));
        def frg-permit-sequence(permit) = frg-provenance-sequence-value(frg-permit-provenance(permit));
        def frg-permit-observed(permit) = frg-provenance-observed-value(frg-permit-provenance(permit));
        def frg-permit-shape?(permit) = nothing?(permit) ? 0 : !((Comparable) len(permit) == 9) ? 0 : !((String) head(permit) == "form-resource-metal-permit-v2") ? 0 : 1;
        def frg-permit-open?(permit) = !((Comparable) frg-permit-shape?(permit) == 1) ? 0 : ((String) frg-permit-status(permit) == "open");
        def frg-permit-reserved?(permit) = !((Comparable) frg-permit-shape?(permit) == 1) ? 0 : ((String) frg-permit-status(permit) == "reserved");
        def frg-permit-submitted?(permit) = !((Comparable) frg-permit-shape?(permit) == 1) ? 0 : ((String) frg-permit-status(permit) == "submitted");
        def frg-permit-active?(permit) = (Comparable) frg-permit-reserved?(permit) == 1 ? 1 : frg-permit-submitted?(permit);
        def frg-permit-slot-bound?(permit) = !((String) frg-permit-slot-path(permit) == frg-metal-slot-path()) ? 0 : ((String) frg-permit-owner-text(permit) == frg-metal-owner-text(permit));
        def frg-permit-valid?(permit) = !((Comparable) frg-permit-shape?(permit) == 1) ? 0 : !((Comparable) frg-provenance-current?(frg-permit-provenance(permit)) == 1) ? 0 : (Comparable) frg-permit-open?(permit) == 1 ? (((Comparable) frg-permit-command-handle(permit) == 0) && (((Comparable) str_len(frg-permit-slot-path(permit)) == 0) && ((Comparable) str_len(frg-permit-owner-text(permit)) == 0)) ? 1 : 0) : (Comparable) frg-permit-reserved?(permit) == 1 ? (((Comparable) frg-permit-command-handle(permit) == 0) && ((Comparable) frg-permit-slot-bound?(permit) == 1) ? 1 : 0) : (Comparable) frg-permit-submitted?(permit) == 1 ? ((frg-permit-command-handle(permit) > 0) && (((Comparable) frg-permit-slot-bound?(permit) == 1) && ((Comparable) frg-provenance-advances?(frg-permit-provenance(permit), frg-permit-submit-provenance(permit)) == 1)) ? 1 : 0) : 0;
        def frg-permit-same?(a, b) = !(((Comparable) frg-permit-valid?(a) == 1) && ((Comparable) frg-permit-valid?(b) == 1)) ? 0 : !((String) frg-permit-id(a) == frg-permit-id(b)) ? 0 : frg-provenance-exact?(frg-permit-provenance(a), frg-permit-provenance(b));
        def frg-open-permit(sample, tick) {
            let provenance = frg-signal-provenance(frg-metal-inflight(sample));
            frg-metal-permit(frg-permit-id-for(provenance, tick), tick, "open", provenance, 0, list(), "", "");
        }
        def frg-state-clear-permit(state) = frg-state-with-permit(frg-state-cpu(state), frg-state-gpu(state), frg-state-memory(state), frg-state-clean(state), frg-state-tick(state), list());

        def frg-critical?(policy, sample) = frg-signal-value(frg-low-power(sample)) >= 1 ? 1 : frg-signal-value(frg-latency(sample)) >= frg-latency-stop(policy) ? 1 : frg-signal-value(frg-pressure(sample)) >= frg-memory-critical(policy) ? 1 : frg-signal-value(frg-thermal(sample)) >= frg-thermal-stop(policy) ? 1 : 0;
        def frg-half?(policy, sample) = frg-signal-value(frg-foreground(sample)) >= 1 ? 1 : frg-signal-value(frg-latency(sample)) >= frg-latency-half(policy) ? 1 : frg-signal-value(frg-pressure(sample)) >= frg-memory-warning(policy) ? 1 : frg-signal-value(frg-thermal(sample)) >= frg-thermal-half(policy) ? 1 : 0;
        def frg-next-clean(policy, state, sample) = !((Comparable) frg-sample-fresh?(policy, sample) == 1) ? 0 : (Comparable) frg-critical?(policy, sample) == 1 ? 0 : (Comparable) frg-half?(policy, sample) == 1 ? 0 : (frg-state-clean(state) + 1);
        def frg-additive-grant(policy, current, target, stepSize, nextClean) = current > target ? target : nextClean < frg-clean-needed(policy) ? current : frg-min(target, current + frg-max-zero(stepSize));
        def frg-next-grant(policy, current, target, stepSize, nextClean, sample) = !((Comparable) frg-sample-fresh?(policy, sample) == 1) ? 0 : (Comparable) frg-critical?(policy, sample) == 1 ? 0 : (Comparable) frg-half?(policy, sample) == 1 ? frg-min(target, current / 2) : frg-additive-grant(policy, current, target, stepSize, nextClean);
        def frg-reason(policy, sample) = !((Comparable) frg-sample-fresh?(policy, sample) == 1) ? "typed-signal-not-current" : (Comparable) frg-critical?(policy, sample) == 1 ? "stop-backoff" : (Comparable) frg-half?(policy, sample) == 1 ? "half-backoff" : "additive-recovery";
        def frg-memory-pressure?(policy, sample) = !((Comparable) frg-signal-fresh?(policy, frg-pressure(sample)) == 1) ? 0 : frg-signal-value(frg-pressure(sample)) > 0 ? 1 : 0;

        // Decision: reason, frame, resource targets, current grants, new Metal
        // submission permission, measured memory pressure, permit, next state.
        def frg-decision(reason, frameMs, cpuTarget, gpuTarget, memoryTarget, cpuGrant, gpuGrant, memoryGrant, metalSubmit, memoryPressure, permit, nextState) = list("form-resource-decision-v1", reason, frameMs, cpuTarget, gpuTarget, memoryTarget, cpuGrant, gpuGrant, memoryGrant, metalSubmit, memoryPressure, permit, nextState);
        def frg-decision-reason(decision) = decision[1];
        def frg-decision-frame(decision) = decision[2];
        def frg-decision-cpu-target(decision) = decision[3];
        def frg-decision-gpu-target(decision) = decision[4];
        def frg-decision-memory-target(decision) = decision[5];
        def frg-decision-cpu(decision) = decision[6];
        def frg-decision-gpu(decision) = decision[7];
        def frg-decision-memory(decision) = decision[8];
        def frg-decision-metal-submit?(decision) = decision[9];
        def frg-decision-pressure?(decision) = decision[10];
        def frg-decision-permit(decision) = decision[11];
        def frg-decision-next-state(decision) = decision[12];
        def frg-decision-shape?(decision) = nothing?(decision) ? 0 : !((Comparable) len(decision) == 13) ? 0 : !((String) head(decision) == "form-resource-decision-v1") ? 0 : 1;
        def frg-decision-valid?(decision) = !((Comparable) frg-decision-shape?(decision) == 1) ? 0 : frg-decision-frame(decision) <= 0 ? 0 : frg-decision-cpu-target(decision) < 0 ? 0 : frg-decision-gpu-target(decision) < 0 ? 0 : frg-decision-memory-target(decision) < 0 ? 0 : frg-decision-cpu(decision) < 0 ? 0 : frg-decision-gpu(decision) < 0 ? 0 : frg-decision-memory(decision) < 0 ? 0 : !((Comparable) frg-state-valid?(frg-decision-next-state(decision)) == 1) ? 0 : 1;
        def frg-metal-submit-allowed?(policy, state, sample, gpuGrant) = !((Comparable) frg-sample-fresh?(policy, sample) == 1) ? 0 : gpuGrant <= 0 ? 0 : (Comparable) frg-critical?(policy, sample) == 1 ? 0 : (Comparable) frg-permit-active?(frg-state-permit(state)) == 1 ? 0 : frg-signal-value(frg-metal-inflight(sample)) >= frg-max-metal-inflight(policy) ? 0 : 1;
        // Critical pressure closes every NEW admission.  An already atomic-
        // reserved slot remains visible so its owner may either publish one
        // exactly-correlated submit receipt or release it; submitted work also
        // remains visible because the governor cannot cancel Metal work.
        def frg-next-permit(policy, state, sample, gpuGrant, nextTick) = (Comparable) frg-permit-active?(frg-state-permit(state)) == 1 ? frg-state-permit(state) : (Comparable) frg-metal-submit-allowed?(policy, state, sample, gpuGrant) == 1 ? frg-open-permit(sample, nextTick) : list();

        def frg-tick-current(policy, state, sample) {
            let cpuTarget = frg-resource-target(policy, frg-cpu(sample));
            let gpuTarget = frg-resource-target(policy, frg-gpu(sample));
            let memoryTarget = frg-resource-target(policy, frg-memory(sample));
            let nextClean = frg-next-clean(policy, state, sample);
            let cpuGrant = frg-next-grant(policy, frg-state-cpu(state), cpuTarget, frg-resource-step-size(policy, frg-cpu(sample)), nextClean, sample);
