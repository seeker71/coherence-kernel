        def frg-worker-status(outcome) = outcome[1];
        def frg-worker-reason(outcome) = outcome[2];
        def frg-worker-source(outcome) = outcome[3];
        def frg-worker-provenance(outcome) = outcome[4];
        def frg-worker-handle(outcome) = outcome[5];
        def frg-worker-quantum-id(outcome) = outcome[6];
        def frg-worker-permit-id(outcome) = outcome[7];
        def frg-worker-submit-sequence(outcome) = outcome[8];
        def frg-worker-submit-observed(outcome) = outcome[9];
        def frg-worker-completion-sequence(outcome) = outcome[10];
