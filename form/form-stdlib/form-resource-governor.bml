        def frg-worker-outcome?(outcome) = if nothing?(outcome) then 0 else if (!((Comparable) len(outcome) == 11)) then 0 else if (!((String) head(outcome) == "form-resource-worker-outcome-v2")) then 0 else if (!((Comparable) frg-worker-status-known?(outcome) == 1)) then 0 else if ((Comparable) str_len(frg-worker-reason(outcome)) == 0) then 0 else if ((Comparable) str_len(frg-worker-source(outcome)) == 0) then 0 else if (!((Comparable) frg-provenance-current?(frg-worker-provenance(outcome)) == 1)) then 0 else if (frg-worker-submit-sequence(outcome) < 0) then 0 else if (frg-worker-submit-observed(outcome) < 0) then 0 else if (frg-worker-completion-sequence(outcome) < 0) then 0 else if ((String) frg-worker-status(outcome) == "done") then if (frg-worker-handle(outcome) > 0) then 1 else 0 else if (frg-worker-handle(outcome) >= 0) then 1 else 0;
