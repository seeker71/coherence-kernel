        def frg-submit-permit-id(receipt) = receipt[4];
        def frg-submit-provenance(receipt) = receipt[5];
        def frg-submit-receipt?(receipt) = if nothing?(receipt) then 0 else if (!((Comparable) len(receipt) == 6)) then 0 else if (!((String) head(receipt) == "form-resource-metal-submit-receipt-v2")) then 0 else if (!((String) frg-submit-status(receipt) == "submitted")) then 0 else if (frg-submit-handle(receipt) <= 0) then 0 else if ((Comparable) str_len(frg-submit-quantum-id(receipt)) == 0) then 0 else if ((Comparable) str_len(frg-submit-permit-id(receipt)) == 0) then 0 else frg-provenance-current?(frg-submit-provenance(receipt));
        def frg-submit-correlated?(reserved, quantum, receipt) = if (!((Comparable) frg-permit-reserved?(reserved) == 1)) then 0 else if (!((Comparable) frg-submit-receipt?(receipt) == 1)) then 0 else if (!((String) frg-submit-quantum-id(receipt) == frg-quantum-id(quantum))) then 0 else if (!((String) frg-submit-permit-id(receipt) == frg-permit-id(reserved))) then 0 else frg-provenance-advances?(frg-permit-provenance(reserved), frg-submit-provenance(receipt));
        def frg-submitted-permit(reserved, receipt) = frg-metal-permit(frg-permit-id(reserved), frg-permit-tick(reserved), "submitted", frg-permit-provenance(reserved), frg-submit-handle(receipt), frg-submit-provenance(receipt), frg-permit-slot-path(reserved), frg-permit-owner-text(reserved));
        def frg-submit-bind-result(status, reason, permit, nextState, receipt) = ["form-resource-metal-submit-bind-v2", status, reason, permit, nextState, receipt];
