        def frg-step-current(policy, decision, submitBind, quantum, usage, workerOutcome) = (String) frg-decision-reason(decision) == "typed-signal-not-current" ? frg-step-result("yield", frg-quantum-id(quantum), "typed-signal-not-current", frg-decision-frame(decision), frg-decision-next-state(decision)) : (Comparable) frg-quantum-exceeds-target?(decision, quantum) == 1 ? frg-step-result("refuse", frg-quantum-id(quantum), "quantum-exceeds-bounded-target", frg-decision-frame(decision), frg-decision-next-state(decision)) : !((Comparable) frg-quantum-fits-grant?(decision, quantum, usage) == 1) ? frg-step-result("yield", frg-quantum-id(quantum), "current-grant-insufficient", frg-decision-frame(decision), frg-decision-next-state(decision)) : (frg-signal-value(frg-quantum-metal(quantum)) > 0) && (!((Comparable) frg-submit-bind-admitted?(submitBind) == 1)) ? frg-step-result("refuse", frg-quantum-id(quantum), "metal-submit-not-correlated", frg-decision-frame(decision), frg-decision-next-state(decision)) : !((Comparable) frg-worker-correlated?(submitBind, quantum, workerOutcome) == 1) ? frg-step-result("refuse", frg-quantum-id(quantum), "worker-outcome-uncorrelated", frg-decision-frame(decision), frg-decision-next-state(decision)) : frg-step-result(frg-worker-status(workerOutcome), frg-quantum-id(quantum), (String) frg-worker-status(workerOutcome) == "done" ? "observed-worker-completion" : "worker-bounded-outcome", frg-decision-frame(decision), frg-step-transition-state(decision, submitBind, quantum, workerOutcome));
        def frg-safe-quantum-id(quantum) = (Comparable) frg-quantum-shape?(quantum) == 1 ? frg-quantum-id(quantum) : "unidentified";
        def frg-step-invalid-decision() = frg-step-result("refuse", "unidentified", "decision-invalid", frg-active-ms(frg-default-policy()), frg-initial-state());
        def frg-step(policy, decision, submitBind, quantum, usage, workerOutcome) = !((Comparable) frg-policy-valid?(policy) == 1) ? frg-step-invalid-decision() : !((Comparable) frg-decision-valid?(decision) == 1) ? frg-step-invalid-decision() : !((Comparable) frg-quantum-current?(policy, quantum) == 1) ? frg-step-result("refuse", frg-safe-quantum-id(quantum), "predicted-cost-not-current", frg-decision-frame(decision), frg-decision-next-state(decision)) : !((Comparable) frg-usage-current?(policy, usage) == 1) ? frg-step-result("refuse", frg-safe-quantum-id(quantum), "usage-not-current", frg-decision-frame(decision), frg-decision-next-state(decision)) : frg-step-current(policy, decision, submitBind, quantum, usage, workerOutcome);

        // Every physical release quantity is a current typed observation.
        // Grain support is derived below and cannot be granted by a caller.
        def frg-release-unit(id, grain, bytes, uses, lastUse, active, handle, note) = list("form-resource-release-unit-v1", id, grain, bytes, uses, lastUse, active, handle, note);
        def frg-release-id(unit) = unit[1];
        def frg-release-grain(unit) = unit[2];
        def frg-release-bytes(unit) = unit[3];
        def frg-release-uses(unit) = unit[4];
        def frg-release-last(unit) = unit[5];
        def frg-release-active?(unit) = unit[6];
        def frg-release-handle(unit) = unit[7];
        def frg-release-note(unit) = unit[8];
        def frg-release-byte-value(unit) = frg-signal-value(frg-release-bytes(unit));
        def frg-release-uses-value(unit) = frg-signal-value(frg-release-uses(unit));
        def frg-release-last-value(unit) = frg-signal-value(frg-release-last(unit));
        def frg-release-active-value(unit) = frg-signal-value(frg-release-active?(unit));
        def frg-release-handle-value(unit) = frg-signal-value(frg-release-handle(unit));
        def frg-release-rank(grain) = (String) grain == "jit-native-page" ? 0 : (String) grain == "whole-kv-substate" ? 1 : (String) grain == "inactive-whole-model" ? 2 : 3;
        def frg-release-grain-supported?(grain) = frg-release-rank(grain) < 3 ? 1 : 0;
        def frg-release-shape?(unit) = nothing?(unit) ? 0 : !((Comparable) len(unit) == 9) ? 0 : !((String) head(unit) == "form-resource-release-unit-v1") ? 0 : 1;
        def frg-release-current?(policy, unit) = !((Comparable) frg-release-shape?(unit) == 1) ? 0 : !((Comparable) frg-signal-nonnegative?(policy, frg-release-bytes(unit)) == 1) ? 0 : !((Comparable) frg-signal-nonnegative?(policy, frg-release-uses(unit)) == 1) ? 0 : !((Comparable) frg-signal-nonnegative?(policy, frg-release-last(unit)) == 1) ? 0 : !((Comparable) frg-signal-nonnegative?(policy, frg-release-active?(unit)) == 1) ? 0 : !((Comparable) frg-signal-nonnegative?(policy, frg-release-handle(unit)) == 1) ? 0 : 1;
        def frg-release-valid?(policy, unit) = !((Comparable) frg-release-current?(policy, unit) == 1) ? 0 : !((Comparable) frg-release-grain-supported?(frg-release-grain(unit)) == 1) ? 0 : !((Comparable) frg-release-active-value(unit) == 0) ? 0 : frg-release-byte-value(unit) <= 0 ? 0 : frg-release-handle-value(unit) <= 0 ? 0 : 1;
        def frg-release-earlier?(a, b) = frg-release-rank(frg-release-grain(a)) < frg-release-rank(frg-release-grain(b)) ? 1 : frg-release-rank(frg-release-grain(a)) > frg-release-rank(frg-release-grain(b)) ? 0 : frg-release-uses-value(a) < frg-release-uses-value(b) ? 1 : frg-release-uses-value(a) > frg-release-uses-value(b) ? 0 : frg-release-last-value(a) <= frg-release-last-value(b) ? 1 : 0;
        def frg-release-pick(policy, candidate, best) = !((Comparable) frg-release-valid?(policy, candidate) == 1) ? best : (Comparable) len(best) == 0 ? candidate : (Comparable) frg-release-earlier?(candidate, best) == 1 ? candidate : best;
        def frg-release-next-go(policy, units, best) = (Comparable) len(units) == 0 ? best : frg-release-next-go(policy, tail(units), frg-release-pick(policy, head(units), best));
        def frg-release-next(policy, units) = frg-release-next-go(policy, units, list());
        def frg-release-exact?(a, b) = ((String) frg-release-id(a) == frg-release-id(b)) && ((Comparable) frg-release-handle-value(a) == frg-release-handle-value(b)) ? 1 : 0;
        def frg-release-remove(target, units) = (Comparable) len(units) == 0 ? list() : (Comparable) frg-release-exact?(target, head(units)) == 1 ? tail(units) : cons(head(units), frg-release-remove(target, tail(units)));
        def frg-release-identity-row?(policy, unit) = !((Comparable) frg-release-current?(policy, unit) == 1) ? 0 : frg-release-handle-value(unit) <= 0 ? 0 : 1;
        def frg-release-identity-collides?(policy, candidate, units) = (Comparable) len(units) == 0 ? 0 : !((Comparable) frg-release-identity-row?(policy, head(units)) == 1) ? frg-release-identity-collides?(policy, candidate, tail(units)) : (String) frg-release-id(candidate) == frg-release-id(head(units)) ? 1 : (Comparable) frg-release-handle-value(candidate) == frg-release-handle-value(head(units)) ? 1 : frg-release-identity-collides?(policy, candidate, tail(units));
        def frg-release-unique?(policy, units) = (Comparable) len(units) == 0 ? 1 : !((Comparable) frg-release-identity-row?(policy, head(units)) == 1) ? frg-release-unique?(policy, tail(units)) : (Comparable) frg-release-identity-collides?(policy, head(units), tail(units)) == 1 ? 0 : frg-release-unique?(policy, tail(units));
        def frg-release-plan-next(policy, units, required, reclaimed, selected) {
            let next = frg-release-next(policy, units);
            (Comparable) len(next) == 0 ? list("form-resource-release-plan-v1", "blocked", required, reclaimed, selected, "supported-grain-capacity-exhausted") : frg-release-plan-go(policy, frg-release-remove(next, units), required, reclaimed + frg-release-byte-value(next), append(selected, list(next)));
        }
        def frg-release-plan-go(policy, units, required, reclaimed, selected) = reclaimed >= required ? list("form-resource-release-plan-v1", "planned", required, reclaimed, selected, "measured-pressure") : frg-release-plan-next(policy, units, required, reclaimed, selected);
        // A current measured absence of pressure is sufficient evidence to do
        // nothing.  It must not depend on a reclaim request: no bytes are
        // required when no reclaim is authorized.  Once pressure is nonzero,
        // the request and every selected physical handle remain fail-closed.
        def frg-pressure-release-plan(policy, pressure, required, units) = !((Comparable) frg-signal-nonnegative?(policy, pressure) == 1) ? list("form-resource-release-plan-v1", "refused", 0, 0, list(), "pressure-not-current") : frg-signal-value(pressure) <= 0 ? list("form-resource-release-plan-v1", "none", 0, 0, list(), "measured-no-pressure") : !((Comparable) frg-signal-nonnegative?(policy, required) == 1) ? list("form-resource-release-plan-v1", "refused", 0, 0, list(), "required-bytes-not-current") : frg-signal-value(required) <= 0 ? list("form-resource-release-plan-v1", "none", frg-signal-value(required), 0, list(), "no-reclaim-requested") : !((Comparable) frg-release-unique?(policy, units) == 1) ? list("form-resource-release-plan-v1", "refused", frg-signal-value(required), 0, list(), "duplicate-id-or-handle") : frg-release-plan-go(policy, units, frg-signal-value(required), 0, list());
        def frg-release-plan-status(plan) = plan[1];
        def frg-release-plan-selected(plan) = plan[4];
        def frg-release-plan-reason(plan) = plan[5];
        // Capability rows describe support; they are not physical candidates
        // and carry no invented byte count or carrier handle.
        def frg-release-capability(grain, rank, supported, requirement) = list("form-resource-release-capability-v1", grain, rank, supported, requirement);
        def frg-release-capability-grain(capability) = capability[1];
        def frg-release-capability-rank(capability) = capability[2];
        def frg-release-capability-supported?(capability) = capability[3];
        def frg-release-capability-requirement(capability) = capability[4];
        def frg-release-capabilities() = list(frg-release-capability("jit-native-page", 0, 1, "whole specialization page handle"), frg-release-capability("whole-kv-substate", 1, 1, "inactive whole-state handle"), frg-release-capability("inactive-whole-model", 2, 1, "inactive model handle"), frg-release-capability("packed-expert", 3, 0, "independently mapped expert handle not present"), frg-release-capability("transformer-layer", 3, 0, "token-required layer release unsupported"), frg-release-capability("partial-kv", 3, 0, "partial-state handle and coherence proof not present"));
    }
    0;
}
