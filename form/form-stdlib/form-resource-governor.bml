        def frg-consume-metal-permit(policy, state, decision, quantum, slotResult) = if (!((Comparable) frg-quantum-current?(policy, quantum) == 1)) then frg-permit-consume-result("refused", "quantum-not-current", [], state, slotResult) else if (frg-signal-value(frg-quantum-metal(quantum)) <= 0) then frg-permit-consume-result("refused", "quantum-does-not-need-metal", [], state, slotResult) else if (!((Comparable) frg-permit-open?(frg-decision-permit(decision)) == 1)) then frg-permit-consume-result("refused", "no-open-permit", [], state, slotResult) else if (!((Comparable) frg-permit-open?(frg-state-permit(state)) == 1)) then frg-permit-consume-result("refused", "permit-replayed-or-already-reserved", frg-decision-permit(decision), state, slotResult) else if (!((Comparable) frg-permit-same?(frg-state-permit(state), frg-decision-permit(decision)) == 1)) then frg-permit-consume-result("refused", "permit-state-mismatch", frg-decision-permit(decision), state, slotResult) else if (!((Comparable) frg-metal-slot-result-acquired?(slotResult) == 1)) then frg-permit-consume-result("refused", "atomic-slot-not-acquired", frg-decision-permit(decision), state, slotResult) else if (!((Comparable) frg-permit-same?(frg-metal-slot-result-permit(slotResult), frg-decision-permit(decision)) == 1)) then frg-permit-consume-result("refused", "slot-owner-permit-mismatch", frg-decision-permit(decision), state, slotResult) else frg-consume-metal-permit-admit(state, frg-metal-slot-result-permit(slotResult), slotResult);
