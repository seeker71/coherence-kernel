//////////////////////////////////////////////////////////////////////
//
// form-resource-governor.bml — executable cooperative governor.
//
// This cell computes bounded grants and release plans from typed carrier
// observations.  It applies no host nice/QoS setting and submits no Metal
// work itself: those are explicit offers whose carrier acknowledgement is
// separate evidence.
//
// Authority: form-stdlib/bml/form-resource-governor.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/bml/form-glass-observation-v2.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormResourceGovernor {
        field FRGSchema = "form-resource-governor-v2";

        // All thresholds live in this row.  Callers may provide another row;
        // the state machine contains no hidden policy quantities.
        // tag, active-ms, quiet-ms, scale, target, additive step,
        // recovery clean frames, fresh age frames, latency half/stop,
        // memory warning/critical, thermal half/stop, CPU nice, CPU QoS,
        // max background Metal in flight.
        def frg-policy(activeMs, quietMs, scale, target, additiveStep, cleanFrames, freshFrames, latencyHalfMs, latencyStopMs, memoryWarning, memoryCritical, thermalHalf, thermalStop, cpuNice, cpuQos, maxMetalInFlight) = ["form-resource-policy-v1", activeMs, quietMs, scale, target, additiveStep, cleanFrames, freshFrames, latencyHalfMs, latencyStopMs, memoryWarning, memoryCritical, thermalHalf, thermalStop, cpuNice, cpuQos, maxMetalInFlight];
        def frg-active-ms(policy) = policy[1];
        def frg-quiet-ms(policy) = policy[2];
        def frg-scale(policy) = policy[3];
        def frg-target-ratio(policy) = policy[4];
        def frg-recovery-step(policy) = policy[5];
        def frg-clean-needed(policy) = policy[6];
        def frg-fresh-frames(policy) = policy[7];
        def frg-latency-half(policy) = policy[8];
        def frg-latency-stop(policy) = policy[9];
        def frg-memory-warning(policy) = policy[10];
        def frg-memory-critical(policy) = policy[11];
        def frg-thermal-half(policy) = policy[12];
        def frg-thermal-stop(policy) = policy[13];
        def frg-cpu-nice(policy) = policy[14];
        def frg-cpu-qos(policy) = policy[15];
        def frg-max-metal-inflight(policy) = policy[16];
        def frg-default-policy() = frg-policy(250, 500, 1000, 900, 50, 2, 1, 250, 500, 1, 2, 1, 2, 10, "utility", 1);
        def frg-policy-valid?(policy) = if (!((Comparable) len(policy) == 17)) then 0 else if (!((String) head(policy) == "form-resource-policy-v1")) then 0 else if (frg-active-ms(policy) <= 0) then 0 else if (frg-quiet-ms(policy) < frg-active-ms(policy)) then 0 else if (frg-scale(policy) <= 0) then 0 else if (frg-target-ratio(policy) < 0) then 0 else if (frg-target-ratio(policy) > frg-scale(policy)) then 0 else if (frg-recovery-step(policy) <= 0) then 0 else if (frg-recovery-step(policy) > frg-scale(policy)) then 0 else if (frg-clean-needed(policy) < 1) then 0 else if (frg-fresh-frames(policy) < 0) then 0 else if (frg-latency-half(policy) < 0) then 0 else if (frg-latency-stop(policy) < frg-latency-half(policy)) then 0 else if (frg-memory-warning(policy) < 1) then 0 else if (frg-memory-critical(policy) <= frg-memory-warning(policy)) then 0 else if (frg-thermal-half(policy) < 0) then 0 else if (frg-thermal-stop(policy) <= frg-thermal-half(policy)) then 0 else if (frg-cpu-nice(policy) < 0) then 0 else if (frg-cpu-nice(policy) > 19) then 0 else if ((Comparable) str_len(frg-cpu-qos(policy)) == 0) then 0 else if (!((Comparable) frg-max-metal-inflight(policy) == 1)) then 0 else 1;

        // The Glass v2 truth spine owns truth variants and process provenance.
        // This envelope adds governor-frame age; it does not invent a second
        // absent/stale/error vocabulary.
        def frg-declared-provenance(publisher) = fgov2-provenance("declared", publisher, fgov2-unavailable("process-not-observed", "process.lifetime"), fgov2-measured(0), fgov2-measured(0), "form.resource-governor");
        def frg-signal(truth, ageFrames, provenance) = ["form-resource-signal-v1", truth, ageFrames, provenance];
        def frg-measured(value, ageFrames, provenance) = frg-signal(fgov2-measured(value), ageFrames, provenance);
        def frg-absent(reason) = frg-signal(fgov2-absent(reason), 0, frg-declared-provenance("resource.absent"));
        def frg-unavailable(reason, missingDoor) = frg-signal(fgov2-unavailable(reason, missingDoor), 0, frg-declared-provenance("resource.unavailable"));
        def frg-stale(lastValue, lastObservedEpoch, ageFrames, publisher) = frg-signal(fgov2-stale(lastValue, lastObservedEpoch, "publisher-lease-expired"), ageFrames, frg-declared-provenance(publisher));
        def frg-error(stage, code, retryable) = frg-signal(fgov2-error(stage, code, retryable), 0, frg-declared-provenance("resource.error"));
        def frg-signal-truth(signal) = signal[1];
        def frg-signal-kind(signal) = fgov2-truth-kind(frg-signal-truth(signal));
        def frg-signal-value(signal) = fgov2-truth-value(frg-signal-truth(signal));
        def frg-signal-age(signal) = signal[2];
        def frg-signal-provenance(signal) = signal[3];
        def frg-provenance-current?(provenance) = if (!((Comparable) fgov2-provenance?(provenance) == 1)) then 0 else if (!((String) fgov2-provenance-evidence(provenance) == "physical-live")) then 0 else if (!((Comparable) fgov2-measured?(fgov2-provenance-lifetime(provenance)) == 1)) then 0 else if (!((Comparable) fgov2-measured?(fgov2-provenance-sequence(provenance)) == 1)) then 0 else if (!((Comparable) fgov2-measured?(fgov2-provenance-observed(provenance)) == 1)) then 0 else 1;
        def frg-signal-shape?(signal) = if nothing?(signal) then 0 else if (!((Comparable) len(signal) == 4)) then 0 else if (!((String) head(signal) == "form-resource-signal-v1")) then 0 else 1;
        def frg-signal-fresh?(policy, signal) = if (!((Comparable) frg-signal-shape?(signal) == 1)) then 0 else if (!((Comparable) fgov2-truth?(frg-signal-truth(signal)) == 1)) then 0 else if (!((Comparable) fgov2-measured?(frg-signal-truth(signal)) == 1)) then 0 else if (!((Comparable) frg-provenance-current?(frg-signal-provenance(signal)) == 1)) then 0 else if (frg-signal-age(signal) < 0) then 0 else if (frg-signal-age(signal) <= frg-fresh-frames(policy)) then 1 else 0;
        def frg-signal-nonnegative?(policy, signal) = if (!((Comparable) frg-signal-fresh?(policy, signal) == 1)) then 0 else if (frg-signal-value(signal) >= 0) then 1 else 0;

        // Resource observations: capacity, current foreground demand, and
        // hard reserve are all carrier measurements, independently typed.
        def frg-resource(name, capacity, foreground, reserve) = ["form-resource-observation-v1", name, capacity, foreground, reserve];
        def frg-resource-name(resource) = resource[1];
        def frg-resource-capacity(resource) = resource[2];
        def frg-resource-foreground(resource) = resource[3];
        def frg-resource-reserve(resource) = resource[4];
        def frg-resource-shape?(resource) = if nothing?(resource) then 0 else if (!((Comparable) len(resource) == 5)) then 0 else if (!((String) head(resource) == "form-resource-observation-v1")) then 0 else 1;
        def frg-resource-fresh?(policy, resource) = if (!((Comparable) frg-resource-shape?(resource) == 1)) then 0 else if (((Comparable) frg-signal-nonnegative?(policy, frg-resource-capacity(resource)) == 1) && (((Comparable) frg-signal-nonnegative?(policy, frg-resource-foreground(resource)) == 1) && ((Comparable) frg-signal-nonnegative?(policy, frg-resource-reserve(resource)) == 1))) then 1 else 0;
        def frg-max-zero(value) = if (value > 0) then value else 0;
        def frg-min(a, b) = if (a <= b) then a else b;
        def frg-resource-available(resource) = frg-max-zero(((frg-signal-value(frg-resource-capacity(resource)) - frg-signal-value(frg-resource-foreground(resource))) - frg-signal-value(frg-resource-reserve(resource))));
        def frg-resource-target(policy, resource) = ((frg-resource-available(resource) * frg-target-ratio(policy)) / frg-scale(policy));
        def frg-resource-step-size(policy, resource) = frg-max-zero(((frg-signal-value(frg-resource-capacity(resource)) * frg-recovery-step(policy)) / frg-scale(policy)));

        // Sample: active request count, CPU/GPU/memory resource observations,
        // foreground-presence, latency, memory pressure, thermal level,
        // low-power state, background Metal in-flight count.
        def frg-sample(activeRequests, cpu, gpu, memory, foreground, latencyMs, memoryPressure, thermal, lowPower, metalInFlight) = ["form-resource-sample-v1", activeRequests, cpu, gpu, memory, foreground, latencyMs, memoryPressure, thermal, lowPower, metalInFlight];
        def frg-active-requests(sample) = sample[1];
        def frg-cpu(sample) = sample[2];
        def frg-gpu(sample) = sample[3];
        def frg-memory(sample) = sample[4];
        def frg-foreground(sample) = sample[5];
        def frg-latency(sample) = sample[6];
        def frg-pressure(sample) = sample[7];
        def frg-thermal(sample) = sample[8];
        def frg-low-power(sample) = sample[9];
        def frg-metal-inflight(sample) = sample[10];
        def frg-sample-shape?(sample) = if nothing?(sample) then 0 else if (!((Comparable) len(sample) == 11)) then 0 else if (!((String) head(sample) == "form-resource-sample-v1")) then 0 else 1;
        def frg-sample-fresh?(policy, sample) = if (!((Comparable) frg-sample-shape?(sample) == 1)) then 0 else if (((Comparable) frg-signal-nonnegative?(policy, frg-active-requests(sample)) == 1) && (((Comparable) frg-resource-fresh?(policy, frg-cpu(sample)) == 1) && (((Comparable) frg-resource-fresh?(policy, frg-gpu(sample)) == 1) && (((Comparable) frg-resource-fresh?(policy, frg-memory(sample)) == 1) && (((Comparable) frg-signal-nonnegative?(policy, frg-foreground(sample)) == 1) && (((Comparable) frg-signal-nonnegative?(policy, frg-latency(sample)) == 1) && (((Comparable) frg-signal-nonnegative?(policy, frg-pressure(sample)) == 1) && (((Comparable) frg-signal-nonnegative?(policy, frg-thermal(sample)) == 1) && (((Comparable) frg-signal-nonnegative?(policy, frg-low-power(sample)) == 1) && ((Comparable) frg-signal-nonnegative?(policy, frg-metal-inflight(sample)) == 1)))))))))) then 1 else 0;
        def frg-sample-active?(policy, sample) = if (!((Comparable) frg-sample-fresh?(policy, sample) == 1)) then 1 else if ((Comparable) frg-critical?(policy, sample) == 1) then 1 else if ((Comparable) frg-half?(policy, sample) == 1) then 1 else if (frg-signal-value(frg-active-requests(sample)) > 0) then 1 else if (frg-signal-value(frg-foreground(sample)) > 0) then 1 else if (frg-signal-value(frg-metal-inflight(sample)) > 0) then 1 else 0;
        def frg-frame-ms(policy, sample) = if ((Comparable) frg-sample-active?(policy, sample) == 1) then frg-active-ms(policy) else frg-quiet-ms(policy);

        // One resident governor owns this state.  Workers receive a permit,
        // never a copy of the state; the owner serializes permit consumption.
        def frg-state(cpuGrant, gpuGrant, memoryGrant, cleanFrames, tick) = frg-state-with-permit(cpuGrant, gpuGrant, memoryGrant, cleanFrames, tick, []);
        def frg-state-with-permit(cpuGrant, gpuGrant, memoryGrant, cleanFrames, tick, permit) = ["form-resource-governor-state-v1", cpuGrant, gpuGrant, memoryGrant, cleanFrames, tick, permit];
        def frg-state-cpu(state) = state[1];
        def frg-state-gpu(state) = state[2];
        def frg-state-memory(state) = state[3];
        def frg-state-clean(state) = state[4];
        def frg-state-tick(state) = state[5];
        def frg-state-permit(state) = state[6];
        def frg-initial-state() = frg-state(0, 0, 0, 0, 0);
        def frg-state-shape?(state) = if nothing?(state) then 0 else if (!((Comparable) len(state) == 7)) then 0 else if (!((String) head(state) == "form-resource-governor-state-v1")) then 0 else 1;
        def frg-state-valid?(state) = if (!((Comparable) frg-state-shape?(state) == 1)) then 0 else if (frg-state-cpu(state) < 0) then 0 else if (frg-state-gpu(state) < 0) then 0 else if (frg-state-memory(state) < 0) then 0 else if (frg-state-clean(state) < 0) then 0 else if (frg-state-tick(state) < 0) then 0 else if ((Comparable) len(frg-state-permit(state)) == 0) then 1 else frg-permit-valid?(frg-state-permit(state));
        def frg-safe-state(state) = if ((Comparable) frg-state-valid?(state) == 1) then state else frg-initial-state();

        // Permit identity is bound to the Metal publisher's complete process
        // lifetime plus its exact sequence and observation epoch.
        def frg-provenance-lifetime-value(provenance) = fgov2-truth-value(fgov2-provenance-lifetime(provenance));
        def frg-provenance-sequence-value(provenance) = fgov2-truth-value(fgov2-provenance-sequence(provenance));
        def frg-provenance-observed-value(provenance) = fgov2-truth-value(fgov2-provenance-observed(provenance));
        def frg-provenance-pid(provenance) = fgov2-lifetime-pid(frg-provenance-lifetime-value(provenance));
        def frg-provenance-started(provenance) = fgov2-lifetime-started(frg-provenance-lifetime-value(provenance));
        def frg-provenance-incarnation(provenance) = fgov2-lifetime-incarnation(frg-provenance-lifetime-value(provenance));
        def frg-provenance-same-lifetime?(a, b) = if (!(((Comparable) frg-provenance-current?(a) == 1) && ((Comparable) frg-provenance-current?(b) == 1))) then 0 else if (!((String) fgov2-provenance-publisher(a) == fgov2-provenance-publisher(b))) then 0 else if (!((Comparable) frg-provenance-pid(a) == frg-provenance-pid(b))) then 0 else if (!((Comparable) frg-provenance-started(a) == frg-provenance-started(b))) then 0 else if (!((String) frg-provenance-incarnation(a) == frg-provenance-incarnation(b))) then 0 else 1;
        def frg-provenance-exact?(a, b) = if (!((Comparable) frg-provenance-same-lifetime?(a, b) == 1)) then 0 else if (!((Comparable) frg-provenance-sequence-value(a) == frg-provenance-sequence-value(b))) then 0 else if (!((Comparable) frg-provenance-observed-value(a) == frg-provenance-observed-value(b))) then 0 else if (!((String) fgov2-provenance-source(a) == fgov2-provenance-source(b))) then 0 else 1;
        def frg-provenance-advances?(prior, next) = if (!((Comparable) frg-provenance-same-lifetime?(prior, next) == 1)) then 0 else if (frg-provenance-sequence-value(next) <= frg-provenance-sequence-value(prior)) then 0 else if (frg-provenance-observed-value(next) <= frg-provenance-observed-value(prior)) then 0 else 1;
        def frg-permit-id-for(provenance, tick) = str_concat(fgov2-provenance-publisher(provenance), str_concat(":", str_concat(frg-provenance-incarnation(provenance), str_concat(":", str_concat(int_to_str(frg-provenance-sequence-value(provenance)), str_concat(":", int_to_str(tick)))))));

        // Open is a policy offer. Reserved is possible only after the fixed
        // filesystem slot has been created and its exact owner bytes written.
        // Submitted additionally retains the exact command-buffer handle and
        // the exact submit observation that produced it.
        def frg-metal-permit(id, tick, status, provenance, commandHandle, submitProvenance, slotPath, ownerText) = ["form-resource-metal-permit-v2", id, tick, status, provenance, commandHandle, submitProvenance, slotPath, ownerText];
        def frg-permit-id(permit) = permit[1];
        def frg-permit-tick(permit) = permit[2];
        def frg-permit-status(permit) = permit[3];
        def frg-permit-provenance(permit) = permit[4];
        def frg-permit-command-handle(permit) = permit[5];
        def frg-permit-submit-provenance(permit) = permit[6];
        def frg-permit-slot-path(permit) = permit[7];
        def frg-permit-owner-text(permit) = permit[8];
        def frg-permit-publisher(permit) = fgov2-provenance-publisher(frg-permit-provenance(permit));
        def frg-permit-incarnation(permit) = frg-provenance-incarnation(frg-permit-provenance(permit));
        def frg-permit-sequence(permit) = frg-provenance-sequence-value(frg-permit-provenance(permit));
        def frg-permit-observed(permit) = frg-provenance-observed-value(frg-permit-provenance(permit));
        def frg-permit-shape?(permit) = if nothing?(permit) then 0 else if (!((Comparable) len(permit) == 9)) then 0 else if (!((String) head(permit) == "form-resource-metal-permit-v2")) then 0 else 1;
        def frg-permit-open?(permit) = if (!((Comparable) frg-permit-shape?(permit) == 1)) then 0 else ((String) frg-permit-status(permit) == "open");
        def frg-permit-reserved?(permit) = if (!((Comparable) frg-permit-shape?(permit) == 1)) then 0 else ((String) frg-permit-status(permit) == "reserved");
        def frg-permit-submitted?(permit) = if (!((Comparable) frg-permit-shape?(permit) == 1)) then 0 else ((String) frg-permit-status(permit) == "submitted");
        def frg-permit-active?(permit) = if ((Comparable) frg-permit-reserved?(permit) == 1) then 1 else frg-permit-submitted?(permit);
        def frg-permit-slot-bound?(permit) = if (!((String) frg-permit-slot-path(permit) == frg-metal-slot-path())) then 0 else ((String) frg-permit-owner-text(permit) == frg-metal-owner-text(permit));
        def frg-permit-valid?(permit) = if (!((Comparable) frg-permit-shape?(permit) == 1)) then 0 else if (!((Comparable) frg-provenance-current?(frg-permit-provenance(permit)) == 1)) then 0 else if ((Comparable) frg-permit-open?(permit) == 1) then if (((Comparable) frg-permit-command-handle(permit) == 0) && (((Comparable) str_len(frg-permit-slot-path(permit)) == 0) && ((Comparable) str_len(frg-permit-owner-text(permit)) == 0))) then 1 else 0 else if ((Comparable) frg-permit-reserved?(permit) == 1) then if (((Comparable) frg-permit-command-handle(permit) == 0) && ((Comparable) frg-permit-slot-bound?(permit) == 1)) then 1 else 0 else if ((Comparable) frg-permit-submitted?(permit) == 1) then if ((frg-permit-command-handle(permit) > 0) && (((Comparable) frg-permit-slot-bound?(permit) == 1) && ((Comparable) frg-provenance-advances?(frg-permit-provenance(permit), frg-permit-submit-provenance(permit)) == 1))) then 1 else 0 else 0;
        def frg-permit-same?(a, b) = if (!(((Comparable) frg-permit-valid?(a) == 1) && ((Comparable) frg-permit-valid?(b) == 1))) then 0 else if (!((String) frg-permit-id(a) == frg-permit-id(b))) then 0 else frg-provenance-exact?(frg-permit-provenance(a), frg-permit-provenance(b));
        def frg-open-permit(sample, tick) {
            let provenance = frg-signal-provenance(frg-metal-inflight(sample));
            frg-metal-permit(frg-permit-id-for(provenance, tick), tick, "open", provenance, 0, [], "", "");
        }
        def frg-state-clear-permit(state) = frg-state-with-permit(frg-state-cpu(state), frg-state-gpu(state), frg-state-memory(state), frg-state-clean(state), frg-state-tick(state), []);

        def frg-critical?(policy, sample) = if (frg-signal-value(frg-low-power(sample)) >= 1) then 1 else if (frg-signal-value(frg-latency(sample)) >= frg-latency-stop(policy)) then 1 else if (frg-signal-value(frg-pressure(sample)) >= frg-memory-critical(policy)) then 1 else if (frg-signal-value(frg-thermal(sample)) >= frg-thermal-stop(policy)) then 1 else 0;
        def frg-half?(policy, sample) = if (frg-signal-value(frg-foreground(sample)) >= 1) then 1 else if (frg-signal-value(frg-latency(sample)) >= frg-latency-half(policy)) then 1 else if (frg-signal-value(frg-pressure(sample)) >= frg-memory-warning(policy)) then 1 else if (frg-signal-value(frg-thermal(sample)) >= frg-thermal-half(policy)) then 1 else 0;
        def frg-next-clean(policy, state, sample) = if (!((Comparable) frg-sample-fresh?(policy, sample) == 1)) then 0 else if ((Comparable) frg-critical?(policy, sample) == 1) then 0 else if ((Comparable) frg-half?(policy, sample) == 1) then 0 else (frg-state-clean(state) + 1);
        def frg-additive-grant(policy, current, target, stepSize, nextClean) = if (current > target) then target else if (nextClean < frg-clean-needed(policy)) then current else frg-min(target, (current + frg-max-zero(stepSize)));
        def frg-next-grant(policy, current, target, stepSize, nextClean, sample) = if (!((Comparable) frg-sample-fresh?(policy, sample) == 1)) then 0 else if ((Comparable) frg-critical?(policy, sample) == 1) then 0 else if ((Comparable) frg-half?(policy, sample) == 1) then frg-min(target, (current / 2)) else frg-additive-grant(policy, current, target, stepSize, nextClean);
        def frg-reason(policy, sample) = if (!((Comparable) frg-sample-fresh?(policy, sample) == 1)) then "typed-signal-not-current" else if ((Comparable) frg-critical?(policy, sample) == 1) then "stop-backoff" else if ((Comparable) frg-half?(policy, sample) == 1) then "half-backoff" else "additive-recovery";
        def frg-memory-pressure?(policy, sample) = if (!((Comparable) frg-signal-fresh?(policy, frg-pressure(sample)) == 1)) then 0 else if (frg-signal-value(frg-pressure(sample)) > 0) then 1 else 0;

        // Decision: reason, frame, resource targets, current grants, new Metal
        // submission permission, measured memory pressure, permit, next state.
        def frg-decision(reason, frameMs, cpuTarget, gpuTarget, memoryTarget, cpuGrant, gpuGrant, memoryGrant, metalSubmit, memoryPressure, permit, nextState) = ["form-resource-decision-v1", reason, frameMs, cpuTarget, gpuTarget, memoryTarget, cpuGrant, gpuGrant, memoryGrant, metalSubmit, memoryPressure, permit, nextState];
        def frg-decision-reason(decision) = decision[1];
        def frg-decision-frame(decision) = decision[2];
        def frg-decision-cpu-target(decision) = decision[3];
        def frg-decision-gpu-target(decision) = decision[4];
        def frg-decision-memory-target(decision) = decision[5];
        def frg-decision-cpu(decision) = decision[6];
        def frg-decision-gpu(decision) = decision[7];
        def frg-decision-memory(decision) = decision[8];
        def frg-decision-metal-submit?(decision) = decision[9];
        def frg-decision-pressure?(decision) = decision[10];
        def frg-decision-permit(decision) = decision[11];
        def frg-decision-next-state(decision) = decision[12];
        def frg-decision-shape?(decision) = if nothing?(decision) then 0 else if (!((Comparable) len(decision) == 13)) then 0 else if (!((String) head(decision) == "form-resource-decision-v1")) then 0 else 1;
        def frg-decision-valid?(decision) = if (!((Comparable) frg-decision-shape?(decision) == 1)) then 0 else if (frg-decision-frame(decision) <= 0) then 0 else if (frg-decision-cpu-target(decision) < 0) then 0 else if (frg-decision-gpu-target(decision) < 0) then 0 else if (frg-decision-memory-target(decision) < 0) then 0 else if (frg-decision-cpu(decision) < 0) then 0 else if (frg-decision-gpu(decision) < 0) then 0 else if (frg-decision-memory(decision) < 0) then 0 else if (!((Comparable) frg-state-valid?(frg-decision-next-state(decision)) == 1)) then 0 else 1;
        def frg-metal-submit-allowed?(policy, state, sample, gpuGrant) = if (!((Comparable) frg-sample-fresh?(policy, sample) == 1)) then 0 else if (gpuGrant <= 0) then 0 else if ((Comparable) frg-critical?(policy, sample) == 1) then 0 else if ((Comparable) frg-permit-active?(frg-state-permit(state)) == 1) then 0 else if (frg-signal-value(frg-metal-inflight(sample)) >= frg-max-metal-inflight(policy)) then 0 else 1;
        // Critical pressure closes every NEW admission.  An already atomic-
        // reserved slot remains visible so its owner may either publish one
        // exactly-correlated submit receipt or release it; submitted work also
        // remains visible because the governor cannot cancel Metal work.
        def frg-next-permit(policy, state, sample, gpuGrant, nextTick) = if ((Comparable) frg-permit-active?(frg-state-permit(state)) == 1) then frg-state-permit(state) else if ((Comparable) frg-metal-submit-allowed?(policy, state, sample, gpuGrant) == 1) then frg-open-permit(sample, nextTick) else [];

        def frg-tick-current(policy, state, sample) {
            let cpuTarget = frg-resource-target(policy, frg-cpu(sample));
            let gpuTarget = frg-resource-target(policy, frg-gpu(sample));
