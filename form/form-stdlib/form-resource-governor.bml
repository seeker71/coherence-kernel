        def frg-tick(policy, state, sample) = if (!((Comparable) frg-policy-valid?(policy) == 1)) then frg-tick-invalid(policy, state, sample) else if (!((Comparable) frg-state-valid?(state) == 1)) then frg-tick-state-invalid(policy, state, sample) else if ((Comparable) frg-sample-fresh?(policy, sample) == 1) then frg-tick-current(policy, state, sample) else frg-tick-missing(policy, state, sample);

        // A CPU scheduling offer is honest about its scope and carries no
        // claim that the host accepted it or that Metal priority changed.
        def frg-cpu-schedule-offer(policy) = ["cpu-schedule-offer-v1", frg-cpu-nice(policy), frg-cpu-qos(policy), "cpu-workers-only", "host-ack-required", "metal-priority-unsupported"];

        // Predicted-cost work quantum and measured current background use.
        def frg-quantum(id, cpuCost, gpuCost, memoryCost, needsMetal) = ["form-resource-quantum-v1", id, cpuCost, gpuCost, memoryCost, needsMetal];
        def frg-quantum-id(quantum) = quantum[1];
        def frg-quantum-cpu(quantum) = quantum[2];
        def frg-quantum-gpu(quantum) = quantum[3];
        def frg-quantum-memory(quantum) = quantum[4];
        def frg-quantum-metal(quantum) = quantum[5];
        def frg-usage(cpu, gpu, memory) = ["form-resource-usage-v1", cpu, gpu, memory];
        def frg-usage-cpu(usage) = usage[1];
        def frg-usage-gpu(usage) = usage[2];
        def frg-usage-memory(usage) = usage[3];
        def frg-quantum-shape?(quantum) = if nothing?(quantum) then 0 else if (!((Comparable) len(quantum) == 6)) then 0 else if (!((String) head(quantum) == "form-resource-quantum-v1")) then 0 else 1;
        def frg-usage-shape?(usage) = if nothing?(usage) then 0 else if (!((Comparable) len(usage) == 4)) then 0 else if (!((String) head(usage) == "form-resource-usage-v1")) then 0 else 1;
        def frg-quantum-current?(policy, quantum) = if (!((Comparable) frg-quantum-shape?(quantum) == 1)) then 0 else if (((Comparable) frg-signal-nonnegative?(policy, frg-quantum-cpu(quantum)) == 1) && (((Comparable) frg-signal-nonnegative?(policy, frg-quantum-gpu(quantum)) == 1) && (((Comparable) frg-signal-nonnegative?(policy, frg-quantum-memory(quantum)) == 1) && ((Comparable) frg-signal-nonnegative?(policy, frg-quantum-metal(quantum)) == 1)))) then 1 else 0;
        def frg-usage-current?(policy, usage) = if (!((Comparable) frg-usage-shape?(usage) == 1)) then 0 else if (((Comparable) frg-signal-nonnegative?(policy, frg-usage-cpu(usage)) == 1) && (((Comparable) frg-signal-nonnegative?(policy, frg-usage-gpu(usage)) == 1) && ((Comparable) frg-signal-nonnegative?(policy, frg-usage-memory(usage)) == 1))) then 1 else 0;
        def frg-quantum-exceeds-target?(decision, quantum) = if (frg-signal-value(frg-quantum-cpu(quantum)) > frg-decision-cpu-target(decision)) then 1 else if (frg-signal-value(frg-quantum-gpu(quantum)) > frg-decision-gpu-target(decision)) then 1 else if (frg-signal-value(frg-quantum-memory(quantum)) > frg-decision-memory-target(decision)) then 1 else 0;
        def frg-quantum-fits-grant?(decision, quantum, usage) = if ((frg-signal-value(frg-usage-cpu(usage)) + frg-signal-value(frg-quantum-cpu(quantum))) <= frg-decision-cpu(decision)) then if ((frg-signal-value(frg-usage-gpu(usage)) + frg-signal-value(frg-quantum-gpu(quantum))) <= frg-decision-gpu(decision)) then if ((frg-signal-value(frg-usage-memory(usage)) + frg-signal-value(frg-quantum-memory(quantum))) <= frg-decision-memory(decision)) then 1 else 0 else 0 else 0;
        // One fixed path is the cross-process Metal singleton.  The
