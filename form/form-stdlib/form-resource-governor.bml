        def frg-metal-slot-path() = "/tmp/form-resource-governor-metal-slot.v2";
        def frg-metal-slot-owner-path() = str_concat(frg-metal-slot-path(), "/owner");
        def frg-metal-owner-text(permit) = str_concat("schema=form-resource-metal-owner-v2\npermit=", str_concat(frg-permit-id(permit), str_concat("\npublisher=", str_concat(frg-permit-publisher(permit), str_concat("\npid=", str_concat(int_to_str(frg-provenance-pid(frg-permit-provenance(permit))), str_concat("\nstarted=", str_concat(int_to_str(frg-provenance-started(frg-permit-provenance(permit))), str_concat("\nincarnation=", str_concat(frg-permit-incarnation(permit), str_concat("\nsequence=", str_concat(int_to_str(frg-permit-sequence(permit)), str_concat("\nobserved=", str_concat(int_to_str(frg-permit-observed(permit)), str_concat("\nsource=", str_concat(fgov2-provenance-source(frg-permit-provenance(permit)), "\n"))))))))))))))));
        def frg-metal-slot-observation(status, reason, path, ownerText) = ["form-resource-metal-slot-observation-v2", status, reason, path, ownerText];
        def frg-metal-slot-observation-status(observation) = observation[1];
        def frg-metal-slot-observation-reason(observation) = observation[2];
        def frg-metal-slot-observe-live(permit, nowEpoch, maxAge) = if (!((Comparable) frg-permit-open?(permit) == 1)) then frg-metal-slot-observation("refused", "permit-not-open", frg-metal-slot-path(), "") else if ((Comparable) host_path_exists(frg-metal-slot-path()) == 0) then frg-metal-slot-observation("absent", "slot-unclaimed", frg-metal-slot-path(), "") else frg-metal-slot-observe-owner-live(permit, nowEpoch, maxAge, read_file(frg-metal-slot-owner-path()));
        def frg-metal-slot-observe-owner-live(permit, nowEpoch, maxAge, ownerText) = if ((Comparable) str_len(ownerText) == 0) then frg-metal-slot-observation("occupied-unknown", "owner-record-absent-or-unreadable", frg-metal-slot-path(), ownerText) else if (!((String) ownerText == frg-metal-owner-text(permit))) then frg-metal-slot-observation("occupied-unknown", "owner-record-does-not-match-requester", frg-metal-slot-path(), ownerText) else if ((nowEpoch - frg-permit-observed(permit)) > maxAge) then frg-metal-slot-observation("occupied-stale", "matching-owner-observation-expired", frg-metal-slot-path(), ownerText) else frg-metal-slot-observation("occupied-current", "matching-owner-current", frg-metal-slot-path(), ownerText);

        def frg-metal-slot-result(status, reason, permit, made, wrote) = ["form-resource-metal-slot-result-v2", status, reason, permit, made, wrote];
        def frg-metal-slot-result-status(result) = result[1];
        def frg-metal-slot-result-reason(result) = result[2];
        def frg-metal-slot-result-permit(result) = result[3];
        def frg-metal-slot-result-made(result) = result[4];
        def frg-metal-slot-result-wrote(result) = result[5];
        def frg-metal-reserved-permit(openPermit, ownerText) = frg-metal-permit(frg-permit-id(openPermit), frg-permit-tick(openPermit), "reserved", frg-permit-provenance(openPermit), 0, [], frg-metal-slot-path(), ownerText);
        def frg-metal-slot-result-acquired?(result) = if nothing?(result) then 0 else if (!((Comparable) len(result) == 6)) then 0 else if (!((String) head(result) == "form-resource-metal-slot-result-v2")) then 0 else if (!((String) frg-metal-slot-result-status(result) == "acquired")) then 0 else if (!((Comparable) frg-metal-slot-result-made(result) == 1)) then 0 else if (!((Comparable) frg-permit-valid?(frg-metal-slot-result-permit(result)) == 1)) then 0 else if (!((Comparable) frg-permit-reserved?(frg-metal-slot-result-permit(result)) == 1)) then 0 else ((Comparable) frg-metal-slot-result-wrote(result) == str_len(frg-permit-owner-text(frg-metal-slot-result-permit(result))));
        def frg-metal-slot-acquire-live(openPermit) = if (!((Comparable) frg-permit-valid?(openPermit) == 1)) then frg-metal-slot-result("refused", "permit-invalid", [], 0, 0) else if (!((Comparable) frg-permit-open?(openPermit) == 1)) then frg-metal-slot-result("refused", "permit-not-open", openPermit, 0, 0) else frg-metal-slot-acquire-created-live(openPermit, frg-metal-owner-text(openPermit), host_dir_mkdir(frg-metal-slot-path()));
