//////////////////////////////////////////////////////////////////////
//
// native-model-nl-form-latch.bml — executable 3B completion latch.
//
// Authority: form-stdlib/bml/native-model-nl-form-latch.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/line-grammar.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeNLFormLatchAuthority {
        field NMNFAuthorityPath = "form/form-stdlib/bml/native-model-nl-form-latch.bml";
        field NMNFAuthorityKind = "high-bml-interface-class-const";
    }

    class NativeNLFormLatch {
        field NMNFSchema = "native-nl-form-latch-v1";
        field NMNFModel = "base.llama32-3b-metal";
        field NMNFMaxNL = 512;
        field NMNFMaxProposal = 256;

        ref nmnf-authority = NativeNLFormLatchAuthority;
        thought nmnf-law = list("proposal-not-authority", "native-validation", "deterministic-repair", "qwen-only-after-native-inability");

        def nmnf-safe-nl?(nl) {
            if le(str_len(nl), 0) then 0
            else if gt(str_len(nl), NMNFMaxNL()) then 0
            else if ge(str_find(nl, "\n", 0), 0) then 0
            else if ge(str_find(nl, "\r", 0), 0) then 0
            else 1;
        }
        def nmnf-prompt(nl) {
            str_concat("Natural language: the square of 5\nForm: (mul 5 5)\nNatural language: ", str_concat(nl, "\nForm:"));
        }
        def nmnf-starts?(text, prefix) = if eq(str_find(text, prefix, 0), 0) then 1 else 0;
        def nmnf-allowed-head?(text) {
            if eq(nmnf-starts?(text, "(mul "), 1) then 1
            else if eq(nmnf-starts?(text, "(add "), 1) then 1
            else if eq(nmnf-starts?(text, "(sub "), 1) then 1
            else if eq(nmnf-starts?(text, "(list "), 1) then 1
            else if eq(nmnf-starts?(text, "(lookup "), 1) then 1
            else 0;
        }
        def nmnf-forbidden?(text) {
            if ge(str_find(text, "host-exec", 0), 0) then 1
            else if ge(str_find(text, "write_file", 0), 0) then 1
            else if ge(str_find(text, "sock_", 0), 0) then 1
            else if ge(str_find(text, "metal_", 0), 0) then 1
            else 0;
        }
        def nmnf-args-start(text) {
            if eq(nmnf-starts?(text, "(mul "), 1) then 5
            else if eq(nmnf-starts?(text, "(add "), 1) then 5
            else if eq(nmnf-starts?(text, "(sub "), 1) then 5
            else if eq(nmnf-starts?(text, "(list "), 1) then 6
            else if eq(nmnf-starts?(text, "(lookup "), 1) then 8
            else 0;
        }
        def nmnf-digit-byte?(byte) = if and(ge(byte, 48), le(byte, 57)) then 1 else 0;
        def nmnf-string-byte?(byte) {
            if eq(nmnf-digit-byte?(byte), 1) then 1
            else if and(ge(byte, 65), le(byte, 90)) then 1
            else if and(ge(byte, 97), le(byte, 122)) then 1
            else if eq(byte, 32) then 1
            else if eq(byte, 45) then 1
            else if eq(byte, 46) then 1
            else if eq(byte, 47) then 1
            else if eq(byte, 95) then 1
            else 0;
        }
        def nmnf-safe-args-next(text, at, stop, quoted, seen, byte) {
            if eq(byte, 34) then nmnf-safe-args-loop(text, add(at, 1), stop, sub(1, quoted), 1)
            else if eq(quoted, 1) then if eq(nmnf-string-byte?(byte), 1) then nmnf-safe-args-loop(text, add(at, 1), stop, quoted, 1) else 0
            else if eq(byte, 32) then nmnf-safe-args-loop(text, add(at, 1), stop, quoted, seen)
            else if eq(nmnf-digit-byte?(byte), 1) then nmnf-safe-args-loop(text, add(at, 1), stop, quoted, 1)
            else if or(eq(byte, 45), eq(byte, 46)) then nmnf-safe-args-loop(text, add(at, 1), stop, quoted, 1)
            else 0;
        }
        def nmnf-safe-args-loop(text, at, stop, quoted, seen) {
            if ge(at, stop) then if and(eq(quoted, 0), eq(seen, 1)) then 1 else 0
            else nmnf-safe-args-next(text, at, stop, quoted, seen, ord(char_at(text, at)));
        }
        def nmnf-safe-args?(text) {
            let start = nmnf-args-start(text);
            if le(start, 0) then 0 else nmnf-safe-args-loop(text, start, sub(str_len(text), 1), 0, 0);
        }
        def nmnf-proposal-valid?(proposal) {
            let text = trim(proposal);
            if le(str_len(text), 2) then 0
            else if gt(str_len(text), NMNFMaxProposal()) then 0
            else if ge(str_find(text, "\n", 0), 0) then 0
            else if not(str_eq(substring(text, 0, 1), "(")) then 0
            else if not(str_eq(substring(text, sub(str_len(text), 1), str_len(text)), ")")) then 0
            else if eq(nmnf-allowed-head?(text), 0) then 0
            else if eq(nmnf-forbidden?(text), 1) then 0
            else if eq(nmnf-safe-args?(text), 0) then 0
            else 1;
        }
        // Greedy completion models often begin the next exemplar after a good
        // expression. The continuation has no authority: discard it, then
        // validate exactly one bounded first line. This does not widen the
        // primitive allowlist or make any model output executable.
        def nmnf-first-line(output) {
            let clean = trim(output);
            let at = str_find(clean, "\n", 0);
            if lt(at, 0) then clean else trim(substring(clean, 0, at));
        }
        def nmnf-normalize(proposal) {
            let candidate = nmnf-first-line(proposal);
            if eq(nmnf-proposal-valid?(candidate), 1) then candidate else "";
        }
        def nmnf-intent-head(nl) {
            if ge(str_find(nl, "square", 0), 0) then "(mul "
            else if ge(str_find(nl, "multiply", 0), 0) then "(mul "
            else if ge(str_find(nl, "add", 0), 0) then "(add "
            else if ge(str_find(nl, "sum", 0), 0) then "(add "
            else if ge(str_find(nl, "plus", 0), 0) then "(add "
            else if ge(str_find(nl, "subtract", 0), 0) then "(sub "
            else if ge(str_find(nl, "minus", 0), 0) then "(sub "
            else if ge(str_find(nl, "list", 0), 0) then "(list "
            else if ge(str_find(nl, "lookup", 0), 0) then "(lookup "
            else "";
        }
        def nmnf-semantic-valid?(nl, proposal) {
            let expected = nmnf-intent-head(nl);
            let candidate = nmnf-normalize(proposal);
            if eq(nmnf-safe-nl?(nl), 0) then 0
            else if eq(str_len(expected), 0) then 0
            else if eq(str_len(candidate), 0) then 0
            else nmnf-starts?(candidate, expected);
        }
        def nmnf-normalize-for(nl, proposal) = if eq(nmnf-semantic-valid?(nl, proposal), 1) then nmnf-normalize(proposal) else "";
    }
    0;
}
