//////////////////////////////////////////////////////////////////////
//
// bml-bmf-control-curriculum.bml -- executable BML control teaching.
//
// This BML executes choice, cut, undo, timeout, thought-kernel routing,
// and automatic JIT admission.  JIT is explicitly a plan until a carrier
// receipt proves native installation and execution.
//
// preludes: form-stdlib/core.fk form-stdlib/language-template.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk control/offer-ack-core.fk control/choice-lane-core.fk form-stdlib/jit-decision.fk observe/inquiry-planes.fk form-stdlib/bml-bmf-control-curriculum.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template ControlLesson<TAck> {
        member split: String;
        member ack: TAck;
        member evidence: String;
    }

    class BmlBmfControlCurriculum<T> {
        field AckVocabulary = "nothing|0|1|node";
        field TimeoutLaw = "budget-exhaustion-with-untried-alternatives-is-nothing";
        field JitLaw = "hot-and-pure-earns-plan-live-carrier-proof-still-required";

        def bbcc-bml-choice(leftScore, rightScore) = bbcc-evidence-choice(
            leftScore,
            bbcc-cell-twelve,
            rightScore,
            bbcc-cell-thirty-four,
            list()
        );

        def bbcc-bml-thought(word) = bbcc-thought-route(word, 6000, 300);

        def bbcc-bml-jit(heat, pure) = bbcc-auto-jit-plan(
            heat,
            pure,
            8000,
            2000,
            20
        );

        def bbcc-bml-check() {
            let tie = bbcc-bml-choice(7, 7);
            let winner = bbcc-bml-choice(9, 7);
            let thought = bbcc-bml-thought("why");
            let plan = bbcc-bml-jit(6, 1);
            let c0 = if nothing?(tie) then 1 else 0;
            let c1 = if eq(bbcc-ack-int(winner), 12) then 2 else 0;
            let c2 = if eq(nth(thought, 3), 20) then 4 else 0;
            let c3 = if str_eq(bbcc-jit-plan-route(plan), "crystallize-plan") then 8 else 0;
            add(c0, add(c1, add(c2, c3)));
        }
    }

    0;
}
