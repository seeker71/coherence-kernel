// fk-opt.fk — the optimizer ON the content-addressed cells. Convergence: it folds an fk-*
// cell tree to an equivalent, cheaper fk-* cell tree, in place on the canonical lattice —
// no parallel rewrite-AST. The flywheel PROPOSES (fk-opt) and VERIFIES (fk-run, hati-os's
// own walker) on ONE representation.
//
// preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/hati-os-kernel.fk
//
// tags (hati-os): 1 LIT · 2 ARG · 3 ADD · 4 SUB · 5 LE · 6 IF · 10 DIV · 42 MUL.
section [form.bml] {
    def fk-lit?(n) = (Comparable) fk-tag(n) == 1;
    def fk-litv(n) = ms-value(fk-body(n));
    def fk-lchild(n) = ms-child(fk-body(n), 0);
    def fk-rchild(n) = ms-child(fk-body(n), 1);
    def fk-zero?(n) = fk-lit?(n) ? (Comparable) fk-litv(n) == 0 : 0;
    def fk-one?(n) = fk-lit?(n) ? (Comparable) fk-litv(n) == 1 : 0;
    // fold two constants under op t
    def fk-binop(t, x, y) = (Comparable) t == 3 ? x + y : (Comparable) t == 4 ? x - y : (Comparable) t == 42 ? x * y : (Comparable) t == 10 ? x / y : x <= y ? 1 : 0;
    // rebuild a binary node with optimized children
    def fk-rebuild(t, a, b) = (Comparable) t == 3 ? fk-add(a, b) : (Comparable) t == 4 ? fk-sub(a, b) : (Comparable) t == 42 ? fk-mul(a, b) : (Comparable) t == 10 ? fk-div(a, b) : fk-le(a, b);
    // identity elimination on a binary node (children already optimized, not both LIT)
    def fk-ident(t, a, b) = (Comparable) t == 3 ? fk-zero?(b) ? a : fk-zero?(a) ? b : fk-rebuild(t, a, b) : (Comparable) t == 4 ? fk-zero?(b) ? a : fk-rebuild(t, a, b) : (Comparable) t == 42 ? (fk-zero?(a) ? 1 : fk-zero?(b)) ? fk-lit(0) : fk-one?(b) ? a : fk-one?(a) ? b : fk-rebuild(t, a, b) : (Comparable) t == 10 ? fk-one?(b) ? a : fk-rebuild(t, a, b) : fk-rebuild(t, a, b);
    // fk-opt: leaves pass; IF rewrites each branch; a binary op folds children then collapses
    // two constants to one LIT, else applies identity. The result is a fresh fk-* cell tree.
    def fk-opt(n) = {
        let t = fk-tag(n);
        (Comparable) t == 1 ? n : (Comparable) t == 2 ? n : (Comparable) t == 6 ? fk-if(fk-opt(fk-lchild(n)), fk-opt(ms-child(fk-rchild(n), 0)), fk-opt(ms-child(fk-rchild(n), 1))) : {
            let a = fk-opt(fk-lchild(n));
            let b = fk-opt(fk-rchild(n));
            (fk-lit?(a) ? fk-lit?(b) : 0) ? fk-lit(fk-binop(t, fk-litv(a), fk-litv(b))) : fk-ident(t, a, b);
        };
    };
}
