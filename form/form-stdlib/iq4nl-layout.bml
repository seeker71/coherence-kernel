//////////////////////////////////////////////////////////////////////
// IQ4_NL executable byte geometry. Authority: bml/iq4nl-layout.bml.
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class IQ4NLLayoutAuthority {
        field IQ4NLAuthorityPath = "form/form-stdlib/bml/iq4nl-layout.bml";
        field IQ4NLAuthorityKind = "high-bml-interface-class-const";
    }

    class IQ4NLLayout {
        field IQ4NLGGMLType = 20;
        field IQ4NLBlockElements = 32;
        field IQ4NLBlockBytes = 18;
        field IQ4NLQuantOffset = 2;
        field IQ4NLCodebookEntries = 16;
        field IQ4NLSIMDWidth = 32;

        ref iq4nl-authority = IQ4NLLayoutAuthority;
        thought iq4nl-pattern = list("type20", "32-elements", "18-bytes", "one-f16-scale", "nonlinear-nibble-codebook");

        def iq4nl-mod(x, n) = sub(x, mul(div(x, n), n));
        def iq4nl-u16(bytes, off) = add(nth(bytes, off), mul(256, nth(bytes, add(off, 1))));
        def iq4nl-block-of(i) = div(i, IQ4NLBlockElements());
        def iq4nl-within(i) = iq4nl-mod(i, IQ4NLBlockElements());
        def iq4nl-quant-byte-offset(base, i) = add(add(base, IQ4NLQuantOffset()), iq4nl-mod(iq4nl-within(i), 16));
        def iq4nl-quant-code(bytes, base, i) = if lt(iq4nl-within(i), 16) then iq4nl-mod(nth(bytes, iq4nl-quant-byte-offset(base, i)), 16) else div(nth(bytes, iq4nl-quant-byte-offset(base, i)), 16);
        def iq4nl-slot-threads(rows) = mul(rows, IQ4NLSIMDWidth());
        def iq4nl-slot-admissible(rows, cols) = if lt(rows, 1) then 0 else if eq(iq4nl-mod(cols, IQ4NLBlockElements()), 0) then 1 else 0;
        def iq4nl-within-block(i) = if lt(i, 0) then 0 else if lt(i, IQ4NLBlockElements()) then 1 else 0;
    }
    0;
}
