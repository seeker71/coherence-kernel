//////////////////////////////////////////////////////////////////////
// IQ4_NL executable byte geometry. Authority: this file.
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class IQ4NLLayoutAuthority {
        field IQ4NLAuthorityPath = "form/form-stdlib/iq4nl-layout.bml";
        field IQ4NLAuthorityKind = "high-bml-interface-class-const";
    }

    class IQ4NLLayout {
        field IQ4NLGGMLType = 20;
        field IQ4NLBlockElements = 32;
        field IQ4NLBlockBytes = 18;
        field IQ4NLQuantOffset = 2;
        field IQ4NLCodebookEntries = 16;
        field IQ4NLSIMDWidth = 32;

        ref iq4nl-authority = IQ4NLLayoutAuthority;
        thought iq4nl-pattern = ["type20", "32-elements", "18-bytes", "one-f16-scale", "nonlinear-nibble-codebook"];

        def iq4nl-mod(x, n) = (x - ((x / n) * n));
        def iq4nl-u16(bytes, off) = (bytes[off] + (256 * bytes[(off + 1)]));
        def iq4nl-block-of(i) = (i / IQ4NLBlockElements());
        def iq4nl-within(i) = iq4nl-mod(i, IQ4NLBlockElements());
        def iq4nl-quant-byte-offset(base, i) = ((base + IQ4NLQuantOffset()) + iq4nl-mod(iq4nl-within(i), 16));
        def iq4nl-quant-code(bytes, base, i) = if (iq4nl-within(i) < 16) then iq4nl-mod(bytes[iq4nl-quant-byte-offset(base, i)], 16) else (bytes[iq4nl-quant-byte-offset(base, i)] / 16);
        def iq4nl-slot-threads(rows) = (rows * IQ4NLSIMDWidth());
        def iq4nl-slot-admissible(rows, cols) = if (rows < 1) then 0 else if ((Comparable) iq4nl-mod(cols, IQ4NLBlockElements()) == 0) then 1 else 0;
        def iq4nl-within-block(i) = if (i < 0) then 0 else if (i < IQ4NLBlockElements()) then 1 else 0;
    }
    0;
}
