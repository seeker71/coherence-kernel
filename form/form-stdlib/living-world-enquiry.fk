; living-world-enquiry.fk -- visible gaps become governed questions.
;
; One current route over a consented enquiry focus forms a GAP question.  Two distinct
; current routes with identical source and target skeletons but different local
; outputs form a CONTENTION question.  The protocol categories name only these
; observable shapes; no domain, task, predicate, language, or answer class is
; installed.  Questions are proposals governed by every route/input holder.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/living-world-enquiry-route.fk

(let LWEN-QUESTION   (bp "LWEN-QUESTION"))
(let LWEN-GAP        (bp "LWEN-GAP"))
(let LWEN-CONTENTION (bp "LWEN-CONTENTION"))
(let LWEN-ORIGIN     (bp "LWEN-ORIGIN"))

(defn lwen-gap () (intern_node LWEN-GAP (empty)))
(defn lwen-contention () (intern_node LWEN-CONTENTION (empty)))

(defn lwen-witnesses-from-routes (items acc)
    (if (eq (len items) 0) acc
        (lwen-witnesses-from-routes (tail items)
            (lwr-field-union-items
                (lwo-field-items
                    (lwen-route-witness-field (head items))) acc))))

(defn lwen-routes-valid? (routes)
    (do
        (let items (lwo-field-items routes))
        (if (eq (len items) 1) 1
            (if (eq (len items) 2)
                (do
                    (let first (nth items 0))
                    (let second (nth items 1))
                    (if (and (not (node_eq
                                      (lwen-route-candidate first)
                                      (lwen-route-candidate second)))
                             (and (node_eq (lwen-route-input first)
                                           (lwen-route-input second))
                                  (and (node_eq
                                          (lwen-route-source-skeleton first)
                                          (lwen-route-source-skeleton second))
                                       (and (node_eq
                                              (lwen-route-target-skeleton first)
                                              (lwen-route-target-skeleton second))
                                            (not (node_eq
                                              (lwen-route-output first)
                                              (lwen-route-output second))))))) 1 0))
                0))))

(defn lwen-kind-for-routes (routes)
    (if (eq (lwo-field-size routes) 1)
        (lwen-gap) (lwen-contention)))

; children: route field, input, observable kind, witness field, local path
(defn lwen-question (routes witnesses)
    (intern_node LWEN-QUESTION
        (list routes (lwen-route-input
                        (head (lwo-field-items routes)))
              (lwen-kind-for-routes routes) witnesses (lwo-local-path))))
(defn lwen-question? (cell) (lwo-category? cell LWEN-QUESTION))
(defn lwen-question-routes (question) (nth (node_children question) 0))
(defn lwen-question-input (question) (nth (node_children question) 1))
(defn lwen-question-kind (question) (nth (node_children question) 2))
(defn lwen-question-witnesses (question) (nth (node_children question) 3))
(defn lwen-question-path (question) (nth (node_children question) 4))

(defn lwen-question-origin (question)
    (intern_node LWEN-ORIGIN (list question)))

(defn lwen-question-proposal-from-routes (routes)
    (if (eq (lwen-routes-valid? routes) 0) (lwo-none)
        (do
            (let witnesses
                (lwen-witnesses-from-routes
                    (lwo-field-items routes) (lwo-empty-field)))
            (let question (lwen-question routes witnesses))
            (let origin (lwen-question-origin question))
            (let candidate
                (lwo-emergent question witnesses
                    (intern_trivial_int (lwo-field-size routes))
                    (intern_trivial_int (lwo-field-size routes))
                    (intern_trivial_int (lwo-field-size witnesses))
                    origin))
            (lwt-proposal candidate
                (lwt-sources-from-attributions
                    (lwo-field-items witnesses) (lwo-empty-field))
                origin))))

(defn lwen-question-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwen-question?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwen-routes-current? (world items)
    (if (eq (len items) 0) 1
        (if (eq (lwen-route-current? world (head items)) 1)
            (lwen-routes-current? world (tail items)) 0)))

(defn lwen-question-current? (world candidate)
    (if (eq (lwen-question-candidate? candidate) 0) 0
        (do
            (let question (lwo-emergent-shape candidate))
            (let routes (lwen-question-routes question))
            (let current-witnesses
                (lwen-witnesses-from-routes
                    (lwo-field-items routes) (lwo-empty-field)))
            (if (and (eq (lwen-routes-valid? routes) 1)
                     (and (eq (lwen-routes-current?
                                  world (lwo-field-items routes)) 1)
                          (node_eq current-witnesses
                                   (lwen-question-witnesses question)))) 1 0))))

(defn lwen-question-has-path? (question candidate input)
    (lwen-question-has-path-items?
        (lwo-field-items (lwen-question-routes question)) candidate input))

(defn lwen-question-has-path-items? (items candidate input)
    (if (eq (len items) 0) 0
        (if (and (node_eq (lwen-route-candidate (head items)) candidate)
                 (node_eq (lwen-route-input (head items)) input)) 1
            (lwen-question-has-path-items?
                (tail items) candidate input))))

(defn lwen-active-question-for-items? (world items candidate input)
    (if (eq (len items) 0) 0
        (do
            (let cell (head items))
            (if (and (eq (lwen-question-candidate? cell) 1)
                     (and (eq (lwo-active? world cell) 1)
                          (and (eq (lwen-question-current? world cell) 1)
                               (eq (lwen-question-has-path?
                                    (lwo-emergent-shape cell)
                                    candidate input) 1))))
                1
                (lwen-active-question-for-items?
                    world (tail items) candidate input)))))

(defn lwen-active-question-for? (world candidate input)
    (lwen-active-question-for-items? world
        (lwo-field-items (lwo-world-cells world)) candidate input))

(defn lwen-gap-proposal (world candidate input)
    (do
        (let route (lwen-route-for world candidate input))
        (if (node_eq route (lwo-none)) (lwo-none)
            (if (eq (lwen-active-question-for?
                        world candidate input) 1)
                (lwo-none)
                (lwen-question-proposal-from-routes
                    (lwo-field-add (lwo-empty-field) route))))))

(defn lwen-gap-proposal-for-focus (world candidate focus)
    (if (eq (lwen-focus? focus) 0) (lwo-none)
        (do
            (let input (lwen-focus-input focus))
            (let route (lwen-route-for-focus world candidate focus))
            (if (node_eq route (lwo-none)) (lwo-none)
                (if (eq (lwen-active-question-for?
                            world candidate input) 1)
                    (lwo-none)
                    (lwen-question-proposal-from-routes
                        (lwo-field-add (lwo-empty-field) route)))))))

(defn lwen-gap-proposals-for-path (world candidate inputs acc)
    (if (eq (len inputs) 0) acc
        (do
            (let proposal
                (lwen-gap-proposal-for-focus
                    world candidate (head inputs)))
            (lwen-gap-proposals-for-path world candidate (tail inputs)
                (if (node_eq proposal (lwo-none)) acc
                    (lwo-field-add acc proposal))))))

(defn lwen-gap-proposals-items (world paths inputs acc)
    (if (eq (len paths) 0) acc
        (lwen-gap-proposals-items world (tail paths) inputs
            (if (eq (lwen-path-candidate? (head paths)) 0) acc
                (lwen-gap-proposals-for-path
                    world (head paths) inputs acc)))))

(defn lwen-gap-proposals (world)
    (do
        (let items (lwo-field-items (lwo-world-cells world)))
        (lwen-gap-proposals-items
            world items items (lwo-empty-field))))

(defn lwen-question-has-both?
    (question first-candidate second-candidate input)
    (if (and (eq (lwen-question-has-path?
                      question first-candidate input) 1)
             (eq (lwen-question-has-path?
                      question second-candidate input) 1)) 1 0))

(defn lwen-active-contention-items?
    (world items first-candidate second-candidate input)
    (if (eq (len items) 0) 0
        (do
            (let cell (head items))
            (if (and (eq (lwen-question-candidate? cell) 1)
                     (and (eq (lwo-active? world cell) 1)
                          (and (eq (lwen-question-current? world cell) 1)
                               (eq (lwen-question-has-both?
                                    (lwo-emergent-shape cell)
                                    first-candidate second-candidate input) 1))))
                1
                (lwen-active-contention-items? world (tail items)
                    first-candidate second-candidate input)))))

(defn lwen-active-contention?
    (world first-candidate second-candidate input)
    (lwen-active-contention-items? world
        (lwo-field-items (lwo-world-cells world))
        first-candidate second-candidate input))

(defn lwen-contention-from-routes (first-route second-route)
    (if (or (node_eq first-route (lwo-none))
            (node_eq second-route (lwo-none)))
        (lwo-none)
        (lwen-question-proposal-from-routes
            (lwo-field-add
                (lwo-field-add (lwo-empty-field) first-route)
                second-route))))

(defn lwen-contention-proposal (world first-candidate second-candidate input)
    (if (eq (lwen-active-contention?
                world first-candidate second-candidate input) 1)
        (lwo-none)
        (lwen-contention-from-routes
            (lwen-route-for world first-candidate input)
            (lwen-route-for world second-candidate input))))

(defn lwen-contention-proposal-for-focus
    (world first-candidate second-candidate focus)
    (if (eq (lwen-focus? focus) 0) (lwo-none)
        (do
            (let input (lwen-focus-input focus))
            (if (eq (lwen-active-contention?
                        world first-candidate second-candidate input) 1)
                (lwo-none)
                (lwen-contention-from-routes
                    (lwen-route-for-focus world first-candidate focus)
                    (lwen-route-for-focus world second-candidate focus))))))

(defn lwen-contentions-for-inputs
    (world first second inputs acc)
    (if (eq (len inputs) 0) acc
        (do
            (let proposal
                (lwen-contention-proposal-for-focus
                    world first second (head inputs)))
            (lwen-contentions-for-inputs
                world first second (tail inputs)
                (if (node_eq proposal (lwo-none)) acc
                    (lwo-field-add acc proposal))))))

(defn lwen-contentions-with-first
    (world first seconds inputs acc)
    (if (eq (len seconds) 0) acc
        (lwen-contentions-with-first world first (tail seconds) inputs
            (if (or (eq (lwen-path-candidate? first) 0)
                    (eq (lwen-path-candidate? (head seconds)) 0)) acc
                (lwen-contentions-for-inputs
                    world first (head seconds) inputs acc)))))

(defn lwen-contention-proposals-items (world paths inputs acc)
    (if (eq (len paths) 0) acc
        (lwen-contention-proposals-items world (tail paths) inputs
            (lwen-contentions-with-first
                world (head paths) (tail paths) inputs acc))))

(defn lwen-contention-proposals (world)
    (do
        (let items (lwo-field-items (lwo-world-cells world)))
        (lwen-contention-proposals-items
            world items items (lwo-empty-field))))

(defn lwen-question-proposals (world)
    (lwr-field-union-items
        (lwo-field-items (lwen-contention-proposals world))
        (lwen-gap-proposals world)))

(defn lwen-integrate-question (round proposal action)
    (do
        (let candidate (lwt-proposal-candidate proposal))
        (if (eq (lwen-question-current?
                    (lwt-round-world round) candidate) 0)
            (lwt-round (lwt-round-world round) (lwt-round-proposals round)
                (lwo-field-add (lwo-empty-field)
                    (lwt-evaluate-proposal
                        (lwt-round-world round) proposal)) round)
            (lwt-integrate round proposal action))))
