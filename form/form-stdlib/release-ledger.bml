//////////////////////////////////////////////////////////////////////
//
// release-ledger.bml
//
// Executable BML. The RELEASE LEDGER: the body's cleanup as rows of
// DATA — what is being released, transmuted or re-grounded, and its
// pending state (open / moving). Completed work lives in Git; retained
// items carry their observations and next work, not a fresh execution claim.
//
//   ./fkwu form/form-stdlib/release-ledger.bml
//
// prints pending rows and answers open*1000000 + moving*1000.
//
// preludes: form-stdlib/core.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormReleaseLedger {
        thought release-ledger-pattern = list("items-are-rows", "now-and-where", "history-in-git", "released-is-witnessed");

        def rl-row(id, organ, kind, what, state, witness) = list(id, organ, kind, what, state, witness);
        def rl-id(r) = r[0];
        def rl-organ(r) = r[1];
        def rl-kind(r) = r[2];
        def rl-what(r) = r[3];
        def rl-state(r) = r[4];
        def rl-witness(r) = r[5];

        def rl-rows() = list(
            rl-row("R13", "seed", "lower", "the C seed lowers into its Form organs and shrinks to zero -- the family head; R51-R56 are its stones, in order", "open", "measure: wc -l runtime/fkwu-uni.c, down each landing; correctness growth (healgrowth, row 1263) is owed first and welcome"),
            rl-row("R46", "switches", "decide", "FORM_DS4_Q80_METAL_ORDER: a live, numerically-measured proposal to re-pin the reference kernel sits unapplied by deliberate policy (a decision to be made in the open) -- needs an actual decision, not a default", "open", ""),
            rl-row("R47", "switches", "measure", "FORM_DS4_SUBMIT_EVERY (default 2): the one DS4 switch with no cited evidence; an A/B at 1/2/4 on the real blob settles it", "open", "a first measurement run was in flight when its process ended 2026-09-03; worktree gone, nothing recovered; owed as a bounded run after the doc wave"),
            rl-row("R51", "seed", "lower", "fk_walk_cold (~1,770 lines, 11% of the seed, pure tag dispatch) lowers into grammars/form-eval.fk's fef-optable rows -- the reducer IS Form (stone S3b, in flight since 2026-06-29); C keeps a thin trampoline until form-eval runs the body at speed", "open", "proof: form-eval-band, form-eval-full-band, native-vs-rented 11111 bit-identical through the Form reducer; measure: seed lines"),
            rl-row("R52", "seed", "lower", "the source runner (fk_src_*, ~2,100 lines) lowers into source-compiler.fk's lane; C keeps only mmap and exec of the .fkb/.dylib image", "open", "proof: every band in form/fourth-arm-bands.txt runs through the Form runner; freshness band 31"),
            rl-row("R53", "seed", "lower", "the .fkb loader/writer (~640 lines) lowers into fkc-table-serialize.fk / runtime-program-image-fkb-micro-walker.fk, which already describe the format", "open", "proof: program-image-fkb bands; a .fkb written by Form loads in C and vice versa, byte-identical"),
            rl-row("R54", "seed", "lower", "the --src parser and fk_sparse (~1,330 lines) lower into form-parse.fk / the BMF cursor (stone S3b seed-drop): source enters through the cursor, the C parser becomes the one-time bootstrap it already calls itself", "open", "proof: ground quartet through the cursor; 4+-arg ops lowered natively (closes R19's named gap)"),
            rl-row("R55", "seed", "membrane", "the carrier floor that stays (net, media, host-io, Metal/MLX/CUDA doors, ~3,800 lines) becomes offered cells: each host effect crosses a named membrane with a receipt and can be refused (stone S4); the door table is Form data, not C if-chains", "open", "proof: host-os-membrane-band, drift-gates; measure: zero host op without a membrane row"),
            rl-row("R56", "seed", "fold", "the six near-identical grow idioms (fk_bd_push, fk_sock_grow, fk_bd_save, pv_list reserve, conf reserve, conf pool) fold into one shared grow helper (~-50 lines, S1 named it); FK_OPCODE_ARM_CAP 256 becomes data when the optable is Form (R51)", "open", ""),
            rl-row("R57", "shell", "transmute", "form/native/metal/*.sh (32 files, 17,422 lines -- more than the seed): the per-layer routing/regime decisions become Form rows (dsv4-decode-form, moe-router, dsv4-router-msl exist), the MSL heredocs become Form-emitted MSL as the Qwen lane already does, each stone's proof becomes a band on the emitted kernel; the six dead Stone files delete", "open", "measure: metal shell lines to 0; proof: dsv4 bands on real hardware"),
            rl-row("R59", "shell", "transmute", "fourth-arm.sh (1,170 lines: FOURTH_CHAIN as a shell array, cache policy) and validate.sh (983) and build-form-cli.sh (416) become Form doors: the chain is BML rows, the cache policy is hearth rows, four-way proof is proof/four-way-run, the build is form-cli-bml-cache-run + the emit door", "open", "proof: the same bands prove on the same arms through the Form doors; the scripts become thin callers, then leave"),
            rl-row("R60", "shell", "transmute", "cognition/ and model/ shell (semantic-surface build 317 lines, corpus fetch, fixture fetch.sh with pinned URLs), tools/*.sh, python_bmf, the python3 codegen in steiner-* and gen-source-walker: fetches become http-client + a fixtures registry row, builds become ingest cells, codegen becomes Form emitters", "open", "measure: structural gate tooling/fixture counts to 0; proof: each organ's band unchanged"),
            rl-row("R61", "membrane", "name", "host-exec in 130 calling cells (the carrier-mass lens; 184 files mention the word): the shell-glue verbs (printf, mkdir, date, sleep, seq, echo, ~40 sites) become natives the body already has; the borrowed binaries (ffmpeg, ollama, swiftc, whisper-cli, say, python3) stay only as oracle-catalog rows with receipts -- the membrane, named, never debt", "open", "measure: carrier-mass cells down; every remaining site names its catalog row"),
            rl-row("R62", "altitude", "lift", "the compiler chain compiles itself from data: grammars/bml.fk (6,440 lines), source-compiler.fk (2,927), engine.fk (2,596), python-bmf.fk (3,030) -- the grammar rules become rows the engine reads, and the .fk bodies shrink to the engine", "open", "measure: authoring-altitude cells down; proof: bml-band, bml-generics-band, form-cli-author-high-band unchanged"),
            rl-row("R63", "altitude", "lift", "organ cells with logic (dsv4-decode-form 1,456, form-ontology-bp 1,478, fkc-table-serialize 1,042, model-vitality 1,032, field-model-form 1,017, text-summary-learning 1,120, ...) each become a .bml class; the .fk is a lowering only until the .bml runs directly, then it goes -- a kept twin is the wrong shape", "open", "measure: 5,231 .fk / 232 .bml today (4.2%) -> pictures rise, cells fall"),
            rl-row("R64", "altitude", "prelude", "bands stay .fk (they prove logic) but prelude the .bml organ, not its .fk lowering; the 1,872 bands are walked once", "open", "measure: bands whose preludes name a .fk that has a .bml twin -> 0"),
            rl-row("R65", "altitude", "one-file", "the bml/ authority pictures (114) and the executable .bml (99) share names and diverge; once an executable stands, its abstract picture is a keloid -- one file per name, the executable IS the authority", "open", "measure: duplicate .bml basenames -> 0; preludes resolve one way"),
            rl-row("R66", "witness", "thin", "Go/Rust/TS are witnesses: the full kernels (18.9k/24.6k/36.1k lines) shed everything the minimal walkers (4.5k) do not need to witness a recipe -- JIT mirrors, HTTP servers, DB carriers -- toward the walker surface plus what #575 added (preludes, .bml lowering); a witness is realigned only when it falls out of step with fkwu", "open", "measure: kernel lines down, pf-arm-mask coverage of stdlib natives up"),
            rl-row("R68", "walker", "decide", "the emitted walker (form-cli's Go-made seed, MANIFEST roadmap item 4, the 19x visits and the zero-token seam): form-cli runs on fkwu today -- decide whether the emitted lane is retired or healed (T_flat frame slots); a lane nobody runs is a keloid", "open", ""),
            rl-row("R72", "seed", "one-home", "tag allocation has no single home: an internal walker arm picks a number by comment and the optable picks by row, and they collided twice in one week (245, then 148). Until the optable is Form data (R51), a band bit asserts every t==N arm in fk_walk names a tag with a matching optable row or a registered internal tag; the same bit refuses a new arm that shadows an op", "open", ""),
            rl-row("R78", "bml", "lower", "BML import Num; is not lowered to a binding on fkwu: bml-import-ref-resolution-band answers 2111 with Num unresolved", "open", ""),
            rl-row("R80", "kernel", "one-answer", "a defn of a name a native carries: Go and Rust let the defn win, TS and fkwu let the native win -- (do (defn bp (n) 7) (bp \"add\")) answers 7 / 7 / @1.2.12.1 / add; one answer decided in the open, fkwu first, the witnesses realigned", "open", ""),
            rl-row("R88", "bands", "witness", "domain/organ/unique/universe-mint bands answer 2015 of 2047: bit 32 claims heldout >= 9 on a lesson-disjoint split, which waits on a LoRA writer (LoraWriter = 0); the grammar-transport band it named reads 32767 since its pins follow today's grammar sources", "open", ""),
            rl-row("R94", "gate", "see", "three of the seven Python gates were partly blind and green anyway (dynamic_unary_tags never matched a nested (or ...), the Rust pattern had no MULTILINE flag, the registry spec regex stops at the first quote): the Form lenses read the intent instead, and the byte-agreement proofs closed only because every blind spot happens to be covered by another check on today tree -- plant each blind spot and witness that the lens sees what the twin missed", "open", ""),
            rl-row("R96", "bml", "time", "depth is bounded since R91 but time is not: one form of 500 args lowers in 0.2s, 1000 in 0.6s, 2000 in 2.8s (measured 2026-09-04) -- append in line-grammar.fk is non-tail over its left list and gm-args-loop/gm-rep-loop in bmf-grammar.fk call it per item, and fsc-quote-loop and fsc-source-emit-join in source-compiler.fk concatenate right to left; each owes an accumulator", "open", ""),
            rl-row("R44", "switches", "bisect", "no receipt has run the emitted-C walker's heavy workload (opening a 27B model recipe) through the TS worker, or the TS flattener workload through the emitted walker, to learn whether 2048 survives the former or 4096 is overkill for the latter -- the missing cross-workload evidence R38 could not manufacture", "open", ""));

        def rl-one(r, state) = (String) rl-state(r) == state ? 1 : 0;
        def rl-count-go(rows, state, n) = (Comparable) len(rows) == 0 ? n : rl-count-go(tail(rows), state, n + rl-one(head(rows), state));
        def rl-count(state) = rl-count-go(rl-rows(), state, 0);
        def rl-line(r) = rl-id(r) ++ "  " ++ rl-state(r) ++ "  " ++ rl-organ(r) ++ "/" ++ rl-kind(r) ++ ": " ++ rl-what(r);
        def rl-print-go(rows) = (Comparable) len(rows) == 0 ? 0 : rl-print-one(head(rows), tail(rows));
        def rl-print-one(r, rest) {
            print(rl-line(r));
            rl-print-go(rest);
        }
        def rl-summary() = "open=" ++ int_to_str(rl-count("open")) ++ " moving=" ++ int_to_str(rl-count("moving"));
        def rl-field-code() = (rl-count("open") * 1000000) + (rl-count("moving") * 1000);
        def rl-report() {
            rl-print-go(rl-rows());
            print(rl-summary());
            rl-field-code();
        }
    }
    rl-report();
}
