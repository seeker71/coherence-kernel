//////////////////////////////////////////////////////////////////////
//
// release-ledger.bml
//
// Executable BML. The RELEASE LEDGER: the body's cleanup as rows of
// DATA — what is being released, transmuted or re-grounded, and its
// pending state (open / moving). Completed work lives in Git; retained
// items carry their observations and next work, not a fresh execution claim.
// A measure is written as the command that reads it, never as a frozen
// count. Each row names the paths its work stands on (rl-paths, read from
// the repository root): a row whose path is gone describes a subject that
// left, and the ledger refuses (form_error, exit nonzero) until that row is
// released or re-grounded, so its drift row (exit only) cannot read green.
//
//   ./fkwu form/form-stdlib/release-ledger.bml
//
// prints pending rows and answers open*1000000 + moving*1000.
//
import form-stdlib/core.fk;
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormReleaseLedger {
        thought release-ledger-pattern = ["items-are-rows", "now-and-where", "history-in-git", "released-is-witnessed"];

        def rl-row(id, organ, kind, what, state, witness, paths) = [id, organ, kind, what, state, witness, paths];
        def rl-id(r) = r[0];
        def rl-organ(r) = r[1];
        def rl-kind(r) = r[2];
        def rl-what(r) = r[3];
        def rl-state(r) = r[4];
        def rl-witness(r) = r[5];
        def rl-paths(r) = r[6];

        def rl-rows() = [
            rl-row("R13", "seed", "lower", "the C seed lowers into its Form organs and shrinks to zero -- the family head; R51-R56 are its stones, in order", "open", "measure: wc -l runtime/fkwu-uni.c, down each landing; correctness growth (healgrowth, row 1263) is owed first and welcome", ["runtime/fkwu-uni.c"]),
            rl-row("R51", "seed", "lower", "fk_walk_cold (pure tag dispatch in the seed) lowers into grammars/form-eval.fk's fef-optable rows -- the reducer IS Form (stone S3b, in flight since 2026-06-29); C keeps a thin trampoline until form-eval runs the body at speed", "open", "proof: form-eval-band, form-eval-full-band, native-vs-rented 11111 bit-identical through the Form reducer; measure: seed lines", ["runtime/fkwu-uni.c", "grammars/form-eval.fk", "form/form-stdlib/tests/form-eval-band.fk", "form/form-stdlib/tests/form-eval-full-band.fk", "form/form-stdlib/tests/native-vs-rented-band.fk"]),
            rl-row("R52", "seed", "lower", "the source runner (fk_src_*) lowers into source-compiler.fk's lane; C keeps only mmap and exec of the .fkb/.dylib image", "open", "proof: every band in form/band-verdicts.txt runs through the Form runner; freshness band 31", ["runtime/fkwu-uni.c", "form/form-stdlib/source-compiler.fk", "form/band-verdicts.txt"]),
            rl-row("R53", "seed", "lower", "the .fkb loader/writer lowers into fkc-table-serialize.fk / runtime-program-image-fkb-micro-walker.fk, which already describe the format", "open", "proof: program-image-fkb bands; a .fkb written by Form loads in C and vice versa, byte-identical", ["form/form-stdlib/fkc-table-serialize.fk", "form/form-stdlib/runtime-program-image-fkb-micro-walker.fk"]),
            rl-row("R54", "seed", "lower", "the --src parser and fk_sparse lower into form-parse.fk / the BMF cursor (stone S3b seed-drop): source enters through the cursor, the C parser becomes the one-time bootstrap it already calls itself", "open", "proof: ground quartet through the cursor; 4+-arg ops lowered natively (closes R19's named gap)", ["runtime/fkwu-uni.c", "form/form-stdlib/form-parse.fk"]),
            rl-row("R55", "seed", "membrane", "the carrier floor that stays (net, media, host-io, Metal/MLX/CUDA doors) becomes offered cells: each host effect crosses a named membrane with a receipt and can be refused (stone S4); the door table is Form data, not C if-chains", "open", "proof: host-os-membrane-band, drift-gates; measure: zero host op without a membrane row", ["form/form-stdlib/tests/host-os-membrane-band.fk", "gate/drift-gates.bml"]),
            rl-row("R56", "seed", "fold", "the six near-identical grow idioms (fk_bd_push, fk_sock_grow, fk_bd_save, pv_list reserve, conf reserve, conf pool) fold into one shared grow helper (~-50 lines, S1 named it); FK_OPCODE_ARM_CAP 256 becomes data when the optable is Form (R51)", "open", "", ["runtime/fkwu-uni.c"]),
            rl-row("R59", "shell", "transmute", "the shell carriers form/validate.sh and form/build-form-cli.sh become Form doors: the sweep's enumeration and judgment become BML rows, the build's ordering joins form-cli-source-closure.bml", "open", "measure: wc -l form/scripts/*.sh form/validate.sh form/build-form-cli.sh, down; proof: the same bands prove through the Form doors; the scripts become thin callers, then leave", ["form/validate.sh", "form/build-form-cli.sh", "form/form-stdlib/bml/form-cli-source-closure.bml"]),
            rl-row("R60", "shell", "transmute", "the shell and generated tables outside form/ (cognition/concept-human-corpus-13-fetch.sh with pinned URLs, tools/review-panel.sh, flatten/gen-source-walker-table.fk's generator): fetches become http-client + a fixtures registry row, the panel a Form door, codegen a Form emitter", "open", "measure: git ls-files '*.sh' | grep -v '^form/' | wc -l, to 0; proof: each organ's band unchanged", ["cognition/concept-human-corpus-13-fetch.sh", "tools/review-panel.sh", "flatten/gen-source-walker-table.fk"]),
            rl-row("R61", "membrane", "name", "host-exec in its calling cells (the carrier-mass lens): the shell-glue verbs (printf, mkdir, date, sleep, seq, echo) become natives the body already has; the borrowed binaries (ffmpeg, ollama, swiftc, whisper-cli, say, python3) stay only as oracle-catalog rows with receipts -- the membrane, named, never debt", "open", "measure: git grep -l -a host-exec -- '*.fk' '*.bml' | wc -l and the carrier-mass cells, down; every remaining site names its catalog row", ["observe/carrier-mass.bml", "observe/tests/carrier-mass-band.fk"]),
            rl-row("R62", "altitude", "lift", "the compiler chain compiles itself from data: grammars/bml.fk, source-compiler.fk, engine.fk, python-bmf.fk -- the grammar rules become rows the engine reads, and the .fk bodies shrink to the engine", "open", "measure: wc -l form/form-stdlib/grammars/bml.fk form/form-stdlib/source-compiler.fk form/form-stdlib/engine.fk form/form-stdlib/grammars/python-bmf.fk, and authoring-altitude cells (./fkwu observe/authoring-altitude-run.fk), down; proof: bml-band, bml-generics-band, form-cli-author-high-band unchanged", ["form/form-stdlib/grammars/bml.fk", "form/form-stdlib/source-compiler.fk", "form/form-stdlib/engine.fk", "form/form-stdlib/grammars/python-bmf.fk", "form/form-stdlib/tests/bml-band.fk", "form/form-stdlib/tests/bml-generics-band.fk", "form/form-stdlib/tests/form-cli-author-high-band.fk"]),
            rl-row("R63", "altitude", "lift", "organ cells with logic (form-ontology-bp, fkc-table-serialize, text-summary-learning, ...) each become a .bml class; the .fk is a lowering only until the .bml runs directly, then it goes -- a kept twin is the wrong shape", "open", "measure: git ls-files '*.fk' | wc -l against git ls-files '*.bml' | wc -l -> pictures rise, cells fall", ["form/form-stdlib/form-ontology-bp.fk", "form/form-stdlib/fkc-table-serialize.fk", "form/form-stdlib/text-summary-learning.fk"]),
            rl-row("R64", "altitude", "prelude", "bands stay .fk (they prove logic) but prelude the .bml organ, not its .fk lowering; every band (cd form && ./validate.sh --list) is walked once", "open", "measure: bands whose preludes name a .fk that has a .bml twin -> 0", ["form/validate.sh"]),
            rl-row("R65", "altitude", "one-file", "the bml/ authority pictures and the executable .bml share names and diverge; once an executable stands, its abstract picture is a keloid -- one file per name, the executable IS the authority", "open", "measure: duplicate .bml basenames -> 0; preludes resolve one way", ["form/form-stdlib/bml"]),
            rl-row("R68", "walker", "decide", "the emitted walker (form-cli's emitted-C seed, MANIFEST roadmap item 4, the 19x visits and the zero-token seam): form-cli runs on fkwu today -- decide whether the emitted lane is retired or healed (T_flat frame slots); a lane nobody runs is a keloid", "open", "", ["form/form-stdlib/fkc-table-serialize.fk"]),
            rl-row("R72", "seed", "one-home", "tag allocation has no single home: an internal walker arm picks a number by comment and the optable picks by row, and they collided twice in one week (245, then 148). Until the optable is Form data (R51), a band bit asserts every t==N arm in fk_walk names a tag with a matching optable row or a registered internal tag; the same bit refuses a new arm that shadows an op", "open", "", ["runtime/fkwu-uni.c", "runtime/fkwu-optable.h"]),
            rl-row("R78", "bml", "lower", "BML import Num; is not lowered to a binding on fkwu: bml-import-ref-resolution-band answers 2111 with Num unresolved", "open", "", ["form/form-stdlib/tests/bml-import-ref-resolution-band.bml"]),
            rl-row("R94", "gate", "see", "three of the seven Python gates were partly blind and green anyway (dynamic_unary_tags never matched a nested (or ...), the Rust pattern had no MULTILINE flag, the registry spec regex stops at the first quote): the Form lenses read the intent instead, and the byte-agreement proofs closed only because every blind spot happens to be covered by another check on today tree -- plant each blind spot and witness that the lens sees what the twin missed", "open", "", ["gate/drift-gates.bml"]),
            rl-row("R96", "bml", "time", "depth is bounded since R91 but time is not: append in line-grammar.fk is non-tail over its left list, and fsc-quote-loop and fsc-source-emit-join in source-compiler.fk concatenate right to left; each owes an accumulator (the grammar's gm-args-loop/gm-rep-loop/gm-sep-loop already cons and reverse)", "open", "", ["form/form-stdlib/line-grammar.fk", "form/form-stdlib/source-compiler.fk"])];

        def rl-one(r, state) = (String) rl-state(r) == state ? 1 : 0;
        def rl-count-go(rows, state, n) = (Comparable) len(rows) == 0 ? n : rl-count-go(rows[1:], state, n + rl-one(rows[0], state));
        def rl-count(state) = rl-count-go(rl-rows(), state, 0);
        def rl-line(r) = rl-id(r) + ("  " + (rl-state(r) + ("  " + (rl-organ(r) + ("/" + (rl-kind(r) + (": " + rl-what(r))))))));
        def rl-print-go(rows) = (Comparable) len(rows) == 0 ? 0 : rl-print-one(rows[0], rows[1:]);
        def rl-print-one(r, rest) {
            print(rl-line(r));
            rl-print-go(rest);
        }
        def rl-summary() = "open=" + (rl-count("open").str() + (" moving=" + rl-count("moving").str()));
        def rl-field-code() = (rl-count("open") * 1000000) + (rl-count("moving") * 1000);
        // the paths a row stands on that are gone: "R57 form/native/metal/x.sh", in row order
        def rl-absent-in(id, paths) = nil?(paths) ? [] : (Comparable) fs_exists(paths[0]) == 1 ? rl-absent-in(id, paths[1:]) : cons(id + " " + paths[0], rl-absent-in(id, paths[1:]));
        def rl-absent(rows) = nil?(rows) ? [] : append(rl-absent-in(rl-id(rows[0]), rl-paths(rows[0])), rl-absent(rows[1:]));
        def rl-join(xs) = nil?(xs) ? "" : nil?(xs[1:]) ? xs[0] : xs[0] + ", " + rl-join(xs[1:]);
        def rl-refuse(absent) = form_error("release-ledger: a row stands on a path that is gone (its subject left; release or re-ground the row): " + rl-join(absent));
        def rl-report() {
            rl-print-go(rl-rows());
            print(rl-summary());
            let absent = rl-absent(rl-rows());
            nil?(absent) ? rl-field-code() : rl-refuse(absent);
        }
    }
    rl-report();
}
