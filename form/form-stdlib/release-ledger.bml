//////////////////////////////////////////////////////////////////////
//
// release-ledger.bml
//
// Executable BML. The RELEASE LEDGER: the body's cleanup as rows of
// DATA — what is being released, transmuted or re-grounded, and its
// present state (open / moving / released). Only what is now and
// where it goes lives here; how it got here lives in git.
//
//   ./fkwu form/form-stdlib/release-ledger.bml
//
// prints every row that is not yet released and answers the field
// code open*1000000 + moving*1000 + released.
//
// preludes: form-stdlib/core.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormReleaseLedger {
        thought release-ledger-pattern = list("items-are-rows", "now-and-where", "history-in-git", "released-is-witnessed");

        def rl-row(id, organ, kind, what, state, witness) = list(id, organ, kind, what, state, witness);
        def rl-id(r) = nth(r, 0);
        def rl-organ(r) = nth(r, 1);
        def rl-kind(r) = nth(r, 2);
        def rl-what(r) = nth(r, 3);
        def rl-state(r) = nth(r, 4);
        def rl-witness(r) = nth(r, 5);

        def rl-rows() = list(
            rl-row("R1", "twins", "release", "byte-identical tracked .fk copies: 163 released into form-stdlib (acbe83df); 33 grammars/ groups wait on their bands' mirror bit becoming a one-home bit; 4 groups are baked into the bootstrap binary by path", "moving", "158 of 195 groups released; 191 references repointed; ground 42, freshness 31, gate 1"),
            rl-row("R2", "twins", "reunite", "diverged same-name .fk pairs: one live home per name, two renamed where a shared basename hid two different organs", "released", "77eba942: 47 pairs resolved; ground 42, freshness 31, gate 1"),
            rl-row("R27", "grammars", "fix", "control-invite-grammar-band 1023->959: node_category compares fkwu's native bp (a pass-through with no NodeID coordinate for CONTROL-INVITE) string-to-string, never a real NodeID; register the op and compare through fol-bp", "open", ""),
            rl-row("R3", "doors", "reground", "living docs carry only what is and where we go; chronology and correction banners left for git", "released", "86877a92: 42 doors re-observed, 7 history files released, door ring 12063000 (0 broken), quartet 42/55/31/list"),
            rl-row("R4", "cells", "afterwall", "prose citing fallen caps, dead FK_JIT switches, tracked -xtal twins, hidden metal fork, stale op-manifest rows", "released", "3b005b28 ping 5, lane-fact-mint 255, recipe-data-walk 2047, gate 1"),
            rl-row("R5", "data", "rehome", "every model path, telemetry root and ppm scale reroutes through its one home", "released", "140a8849: 176 files repointed on top of fdcc55ca's homes; ground 42, gate 1, drift-gates door-links and release-ledger both pass"),
            rl-row("R6", "gates", "wire", "eleven drift gates as rows (gate/drift-gates.bml); the land cadence runs them and a red gate lands nothing", "released", "fb75d110 band 2047, land-cadence 65535; today op-manifest, kernel-conformance (TS deps absent) and door-links red"),
            rl-row("R7", "shell", "transmute", "metal_dsv4_stack routing, fourth-arm chain, native_model_route into Form rows", "open", ""),
            rl-row("R26", "witness", "audit", "walkers/ + the full go/rust/ts kernels checked against fkwu's current native surface; drift gates were already green (kernel-conformance red only on missing npm ci); the walker boundary confirmed by its own refusal on AST-introspection natives; Go's JIT emitter refuses unknown categories by construction, so node_at/method_define need no jitabi mirror", "released", "audit only, no code changed"),
            rl-row("R23", "twins", "mirror-bit", "33 grammar bands' mirror bits re-declared as one-home witnesses, grammars/ copies released", "released", "0d2d2183: 33 stems, ground 42, freshness 31, gate 1, door-links 0 broken; a few of R2's twin resolutions (form-eval, thought-framebuffer, program-image-symbol-entry, runtime-program-image-fkb-symbol-walk) landed in the same commit, sharing the tests/ directory"),
            rl-row("R8", "proof", "reprobe", "every PROOF LEVEL declaration re-probed with pf-arm-mask; the arm the body answers on is the arm declared", "released", "4a372629: 95 declarations, 11 widened, 11 dropped, 11 relaned, 1 narrowed, 61 stamped; two live regressions named (form-cli-heed-twophase, q8-0-msl-band); validate.sh has no two-arm runner lane"),
            rl-row("R9", "field", "tend", "relative form-stdlib/.cache writers anchored to form/; the phantom root directory removed; stale .fkb ice confirmed self-healing; the ghost hearth board (dead pid 4961) left honest rather than stamped with a foreign worktree's live pid", "released", "31019d77: ground 42, audit-evidence-cells-band 544, gate 1"),
            rl-row("R29", "bml", "lower", "json-codec.fk's inline section [form.bml] fails to lower on plain ./fkwu (166 errors, reproduced on a forced-fresh compile) -- blocks i18n-load end-to-end and ~10 test bands", "open", ""),
            rl-row("R30", "preludes", "repoint", "three stale prelude references found by R9", "released", "2deb8470: concept-corpus-band 230->530 (real score, not just compile error), audit-evidence-index-cache-band 336->833 (header already true), the queries/ header now names the current door"),
            rl-row("R33", "preludes", "repoint", "concept-i18n-band.fk preludes cache.fk though it calls read_with_cache through concept-corpus.fk/i18n.fk -- a fourth instance of R30's stale-prelude class", "open", ""),
            rl-row("R10", "jit", "lower", "form-lower crystallizes str_find over embedded compile-time strings (fa-sxtw added, byte-verified against clang); crystallize-on-heat still pointed at graph construction (7 receipts since 08-24, unmoved)", "released", "6f5dc5f0: form-lower-string-band 63 on real jit_leaf_inram execution; form-lower-band 31, callconv 15, cond 31 unchanged"),
            rl-row("R28", "jit", "thread", "the 398k-hot fstr family scans runtime strings (GGUF/HTTP parsing), not compile-time constants -- fk_inram_args needs a pointer+length runtime-string argument before form-lower's new coverage reaches it", "open", ""),
            rl-row("R11", "receipts", "texture", "receipt-texture.bml: provenance, unit, energy, share, knowing, lane fold a choice receipt into a value-ledger entry; sacred planes sensed, never billed", "released", "band 16383; port 111111, choice-receipt 4294967295, value-planes 11111 unchanged"),
            rl-row("R25", "receipts", "mint", "the turnwheel births its token receipt but no choice receipt; the turn's own choice receipt is the missing half before texture flows live", "open", ""),
            rl-row("R12", "tongue", "pivot", "pivot coverage is a lens (pivot-coverage.bml); the five words minted today carry en and id rows and intern to one node from both doors", "released", "band 65535; nl-many 67108863 four-way; words=653 pivoted=5 missing=648"),
            rl-row("R24", "tongue", "mint", "pivot-mint: a corpus row and its pivot row are one offering, so the corpus cannot grow English-only again (648 rows still English-only)", "open", ""),
            rl-row("R13", "seed", "lower", "fk_walk_cold, source runner, fkb loader, parser: each lowered into its Form organ", "open", ""),
            rl-row("R14", "beliefs", "rewitness", "witnessed stamps older than the last seed commit fold into owed re-witness rows (observe/belief-stamps.bml)", "released", "band 65535; 485 stamped, 1 law, 459 owed at epoch 20260903"),
            rl-row("R15", "switches", "decide", "environment switches become defaults or rows; the default is the decision", "open", ""),
            rl-row("R16", "carrier", "unfix", "fixed watchdog and sleep polls become caller-visible deadlines or kernel-read blocks", "released", "a308ba94: metal_deadline (tag 148), hearth.bml carries every former literal, metal-deadline-band 127 on real hardware, hearth-band 32767"),
            rl-row("R17", "bands", "reheal", "standing red bands healed or named as honest lane seams over dead code (four bands correctly declare their full verdict and exit 1 only on a go/rust-only native the run never reaches)", "released", "eb0e1619: hati-os-kernel-emit 15, cadence 262143, nl-neutral-trace/five jit-* bands 0-exit clean, ingest-exec/homecoming-turn repointed; ground 42, gate 1"),
            rl-row("R31", "bands", "lower", "native-route-goal-cells.fk sits as raw BML grammar in a .fk-extension file, never lowered like its siblings (881 compile errors); needs a rename to .bml or a manual s-expr lowering", "open", ""),
            rl-row("R32", "bands", "fix", "jit-policy-front-sweep-band.fk bit 16 hard-codes form-static-analyzer-check == 1023 but that check's real max is 16383 since it grew more bits; the bit can never set, capping the band's verdict", "released", "2deb8470: verdict 15->31, matched against the sub-band's own current header"),
            rl-row("R22", "bml", "loud", "the BML floor carries every // preludes: line of a unit, as the seed reads every ; preludes: line of a .fk", "released", "tests/bml-two-preludes-witness.bml 1000007 rc 0"),
            rl-row("R18", "cli", "quiet", "form-cli prints a Glass readiness line and a 0 to stdout before its answer; the answer channel carries only the answer", "released", "2deb8470: stdout answers exactly pong; no-fixed-tables-band 63 unchanged"),
            rl-row("R20", "beliefs", "renew", "the re-witness door: an owed cell runs its band, a green exit with the declared verdict renews its stamp to today, red lets it lapse", "open", ""),
            rl-row("R19", "seed", "afterwall", "fkwu-uni.c:10909 still tells a reader to flatten to a .tbl the seed refuses at :15274; the diagnostic names what is (4+-arg ops have no source lowering yet)", "released", "23d30ec7"),
            rl-row("R21", "seed", "grow", "the last fixed arrays, each becoming a birth size that doubles, or a caller-visible refusal where growth is genuinely wrong", "released", "cf2017c3: sockets, parse-save (heals a second nested-defn clobber wound), print nesting, conf, FK_PATH_CAP over 95 sites; seed 15365->15525 (+160), one shared grow helper named as the shrink (~-50)"));

        def rl-one(r, state) = if str_eq(rl-state(r), state) then 1 else 0;
        def rl-count-go(rows, state, n) = if eq(len(rows), 0) then n else rl-count-go(tail(rows), state, add(n, rl-one(head(rows), state)));
        def rl-count(state) = rl-count-go(rl-rows(), state, 0);
        def rl-line(r) = str_concat(rl-id(r), str_concat("  ", str_concat(rl-state(r), str_concat("  ", str_concat(rl-organ(r), str_concat("/", str_concat(rl-kind(r), str_concat(": ", rl-what(r)))))))));
        def rl-print-go(rows) = if eq(len(rows), 0) then 0 else rl-print-one(head(rows), tail(rows));
        def rl-print-one(r, rest) {
            if str_eq(rl-state(r), "released") then 0 else print(rl-line(r));
            rl-print-go(rest);
        }
        def rl-summary() = str_concat("open=", str_concat(int_to_str(rl-count("open")), str_concat(" moving=", str_concat(int_to_str(rl-count("moving")), str_concat(" released=", int_to_str(rl-count("released")))))));
        def rl-field-code() = add(mul(rl-count("open"), 1000000), add(mul(rl-count("moving"), 1000), rl-count("released")));
        def rl-report() {
            rl-print-go(rl-rows());
            print(rl-summary());
            rl-field-code();
        }
    }
    rl-report();
}
