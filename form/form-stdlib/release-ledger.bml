            rl-row("R14", "beliefs", "rewitness", "witnessed stamps older than the last seed commit fold into owed re-witness rows (observe/belief-stamps.bml)", "released", "band 65535; 485 stamped, 1 law, 459 owed at epoch 20260903"),
            rl-row("R15", "switches", "decide", "environment switches become defaults or rows; the default is the decision", "released", "audited, zero edits needed: FORM_ALLOW_THREE_ARM is already a probed default (fourth_available(), no env input) with a loud explicit override; the five FK_JIT* switches were already fully removed pre-session; FORM_METAL_TG already hardcodes its evidenced 256 on the live door; the ~35-switch count itself was stale both ways -- FORM_DS4_* alone is 60+, not eleven"),
            rl-row("R16", "carrier", "unfix", "fixed watchdog and sleep polls become caller-visible deadlines or kernel-read blocks", "released", "a308ba94: metal_deadline (tag 148), hearth.bml carries every former literal, metal-deadline-band 127 on real hardware, hearth-band 32767"),
            rl-row("R17", "bands", "reheal", "standing red bands healed or named as honest lane seams over dead code (four bands correctly declare their full verdict and exit 1 only on a go/rust-only native the run never reaches)", "released", "eb0e1619: hati-os-kernel-emit 15, cadence 262143, nl-neutral-trace/five jit-* bands 0-exit clean, ingest-exec/homecoming-turn repointed; ground 42, gate 1"),
            rl-row("R37", "switches", "comment", "metal_first_token.sh's FORM_METAL_TG default (256) matches the live door's evidenced value but carries no citing comment, unlike llama-token-handle.fk:219; a one-line addition, zero behavior change", "released", "same-day commit, comment-only"),
            rl-row("R38", "switches", "reconcile", "FORM_KERNEL_STACK_MB defaults diverge across kernel arms", "released", "audited, zero edits: the two numbers were never coupled -- TS's 2048 (6e4fd615, 2026-07-17) predates the emitted walker's stack launcher entirely (2026-08-23); main.ts's own comment claims only mechanism parity (same env door, matched V8 limit, loud failure), never numeric equality, so nothing false to fix. Four arms, four different numbers (256 seed/Rust, 2048 TS, 4096 emitted-C, unbounded Go), each answering a different frame-cost question under a different stress workload"),
            rl-row("R49", "bml", "register", "if-then carries the same registry gap that \"if\" had until R40 -- both its mirrors already agree so nothing is broken, but the registry entry is still missing, same additive fix as R40", "released", "e3bce9f9: registered 1/2/11/1; bml-band, bml-generics-band, bmf-bp-r40-family-band all byte-identical to R40"),
            rl-row("R50", "bml", "audit", "several blueprint-registry.json rows carry a stale empty defined_in field though bml.fk now confirmed-emits them; and bml.fk's own header claims -e lowers to UE-MATH-NEGATE where the actual rule emits sub(0, e) -- a doc/impl mismatch", "released", "e3bce9f9: 10 defined_in fields filled (two more than R40's own receipt named, found by re-deriving the cross-reference from source); header comment corrected to sub(0, e)"),
            rl-row("R45", "switches", "wire", "FORM_DS4_BLOB: runtime discovery through the DS4 engine directory, header-verified", "released", "f1935f68: ds4-blob-select.bml + CLI membrane, band 31/31, live end-to-end on this host against the real 86 GB file; six dead earlier-Stone files left named"),
