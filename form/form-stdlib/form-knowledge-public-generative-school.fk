; form-knowledge-public-generative-school.fk -- 15-family generative school.
;
; One local model residence may make one independent attempt per canonical
; family and, only after an executed check refuses that attempt, at most one
; supervised repair.  Independent success is `independent-generative`;
; repaired success is `supervised-embodiment`.  Neither lane is heldout.
;
; Every final candidate is parsed from the exact raw model reply, executed by
; fgsg-verify against that family's own execution challenge, then wrapped by
; the v2 public-family generative receipt/evidence constructors.  The outer
; generation must report model-executed=1.  The generated Form program remains
; model-executed=0 inside fgsg's typed verdict.
;
; This cell is pure.  It opens no model or carrier.
; preludes: form-stdlib/form-knowledge-public-family-mastery.fk
; Proven by: form-stdlib/tests/form-knowledge-public-generative-school-band.fk

    (defn fkg15-cat (parts)
        (if (eq (len parts) 0) ""
            (str_concat (head parts) (fkg15-cat (tail parts)))))
    (defn fkg15-bit? (x) (if (or (eq x 0) (eq x 1)) 1 0))
    (defn fkg15-all-one? (bits)
        (if (eq (len bits) 0) 1
            (if (eq (head bits) 1)
                (fkg15-all-one? (tail bits)) 0)))
    (defn fkg15-independent-lane () "independent-generative")
    (defn fkg15-supervised-lane () "supervised-embodiment")
    (defn fkg15-basis ()
        "public-15-family-generative-school+one-residence+one-repair-v1")

    ; ---- family plan -------------------------------------------------
    (defn fkg15-independent-prompt-for
        (family source-sha challenge-sha family-nonce exec-sha challenge)
        (fkg15-cat (list
            "Generate one executable Form candidate for this public family. Reply with exactly one <BML>...</BML>, one <BMF>...</BMF>, and one <FORM>...</FORM>; no prose. This is public generative school, not heldout evidence.\n"
            "family=" family "\nsource-sha=" source-sha
            "\nheldout-challenge-sha=" challenge-sha
            "\nfamily-nonce=" family-nonce
            "\nexecution-challenge-sha=" exec-sha
            "\nBML: one one-argument int method plus invocation; direct and Form-lowered execution must both return "
            (int_to_str (fgsg-challenge-bml-value challenge)) ".\n"
            "BMF: scannerless raw-byte grammar with at least four fresh rule names; the first alternative must reject, undo, then a later branch must consume every probe byte and cut; a one-step budget must become nothing.\n"
            "FORM: exact eight-line NodeID micro-thought; recipe input="
            (int_to_str (fgsg-challenge-input challenge))
            ", checkpoint=" (int_to_str (fgsg-challenge-checkpoint challenge))
            ", budget=" (int_to_str (fgsg-challenge-timeout-budget challenge))
            ", plane=" (fgsg-challenge-plane challenge)
            ", heat=" (int_to_str (fgsg-challenge-heat challenge))
            ", pure=" (int_to_str (fgsg-challenge-pure challenge))
            ". Preserve nothing, successful zero, and successful one as distinct typed results. The generated Form program must report model-executed=0.")))
    (defn fkg15-plan-message
        (family ordinal source source-sha challenge-sha family-nonce
         exec-sha prompt)
        (nmfe-fields (list "public-generative-family-plan-v1" family
            (int_to_str ordinal) source source-sha challenge-sha family-nonce
            exec-sha (nmfe-sha256 prompt))))
    ; plan = tag family ordinal source source-sha heldout-challenge-sha
    ;        family-nonce execution-challenge execution-challenge-sha
    ;        independent-prompt prompt-sha plan-nonce
    (defn fkg15-plan-for (family)
        (do
            (let ordinal (fkpfm-family-ordinal family))
            (let row (fkpfm-heldout-row-for-family family (fkhe-rows)))
            (let source (if (nothing? row) "" (fkhe-source row)))
            (let source-sha (fkpfm-family-source-sha family))
            (let challenge-sha (fkpfm-family-challenge-sha family))
            (let family-nonce (fkpfm-family-nonce family))
            (let challenge (fkpfm-family-exec-challenge family))
            (let exec-sha (fkpfm-family-exec-challenge-sha family))
            (let prompt (fkg15-independent-prompt-for family source-sha
                challenge-sha family-nonce exec-sha challenge))
            (list "public-generative-family-plan-v1" family ordinal source
                source-sha challenge-sha family-nonce challenge exec-sha
                prompt (nmfe-sha256 prompt)
                (nmfe-sha256 (fkg15-plan-message family ordinal source
                    source-sha challenge-sha family-nonce exec-sha prompt)))))
    (defn fkg15-plan-family (p) (nth p 1))
    (defn fkg15-plan-ordinal (p) (nth p 2))
    (defn fkg15-plan-source (p) (nth p 3))
    (defn fkg15-plan-source-sha (p) (nth p 4))
    (defn fkg15-plan-challenge-sha (p) (nth p 5))
    (defn fkg15-plan-family-nonce (p) (nth p 6))
    (defn fkg15-plan-challenge (p) (nth p 7))
    (defn fkg15-plan-exec-sha (p) (nth p 8))
    (defn fkg15-plan-prompt (p) (nth p 9))
    (defn fkg15-plan-prompt-sha (p) (nth p 10))
    (defn fkg15-plan-nonce (p) (nth p 11))
    (defn fkg15-plan-valid? (p)
        (if (not (eq (fkpfm-list? p) 1)) 0
        (if (not (eq (len p) 12)) 0
        (if (not (str_eq (nth p 0) "public-generative-family-plan-v1")) 0
            (if (eq (fkpfm-equal? p
                    (fkg15-plan-for (fkg15-plan-family p))) 1) 1 0)))))
    (defn fkg15-plans-loop (families)
        (if (eq (len families) 0) (list)
            (cons (fkg15-plan-for (head families))
                  (fkg15-plans-loop (tail families)))))
    (defn fkg15-plans () (fkg15-plans-loop (fkpfm-family-ids)))
    (defn fkg15-plan-seal-loop (plans acc)
        (if (eq (len plans) 0) acc
            (fkg15-plan-seal-loop (tail plans)
                (nmfe-sha256 (nmfe-fields
                    (list "public-generative-plan-step-v1" acc
                          (fkg15-plan-nonce (head plans))))))))
    (defn fkg15-plan-seal ()
        (fkg15-plan-seal-loop (fkg15-plans)
            (nmfe-sha256 "public-generative-15-plan-root-v1")))

    ; ---- exact check, including nothing / successful 0 / successful 1 --
    (defn fkg15-candidate-content-sha (candidate)
        (if (not (eq (fgsg-candidate? candidate) 1))
            (nmfe-sha256 "nothing")
            (nmfe-sha256 (nmfe-fields (list
                (fgsg-candidate-bml candidate)
                (fgsg-candidate-bmf candidate)
                (fgsg-candidate-form candidate))))))
    (defn fkg15-check-message
        (family raw-sha candidate-sha bound-sha verdict pass outcome present
         zero one absent)
        (nmfe-fields (list "public-generative-family-check-v1" family raw-sha
            candidate-sha (if (nothing? bound-sha) "nothing" bound-sha)
            (fkpfm-canonical verdict) (int_to_str pass) outcome
            (int_to_str present) (int_to_str zero) (int_to_str one)
            (int_to_str absent))))
    ; check = tag family raw-sha candidate content-sha bound-candidate-sha
    ;         verdict pass outcome present zero one nothing check-sha
    (defn fkg15-check (plan raw)
        (do
            (let family (fkg15-plan-family plan))
            (let candidate (fgsg-candidate-from-text raw))
            (let verdict (fgsg-verify candidate (fkg15-plan-challenge plan)))
            (let pass (fgsg-verdict-overall verdict))
            (let form (fgsg-verdict-form-observation verdict))
            (let zero (if (eq pass 1)
                (if (and (str_eq (nth form 5) "value")
                         (and (eq (nth form 6) 0)
                              (eq (nth form 7) 1))) 1 0) 0))
            (let one (if (eq pass 1)
                (if (and (eq (nth form 12) 1) (eq (nth form 13) 1)) 1 0) 0))
            (let absent (if (eq pass 1)
                (if (and (str_eq (nth form 14) "nothing")
                         (eq (nth form 15) 0)) 1 0) 0))
            (let outcome (if (eq pass 1) "value"
                (if (eq (str_len raw) 0) "nothing" "failure")))
            (let present (if (eq pass 1) 1 0))
            (let raw-sha (nmfe-sha256 raw))
            (let content-sha (fkg15-candidate-content-sha candidate))
            (let bound-sha (if (eq (fgsg-candidate? candidate) 1)
                (fkpfm-candidate-sha family (fkg15-plan-source-sha plan)
                    (fkg15-plan-challenge-sha plan)
                    (fkg15-plan-exec-sha plan) candidate)
                (nothing)))
            (list "public-generative-family-check-v1" family raw-sha
                candidate content-sha bound-sha verdict pass outcome present
                zero one absent
                (nmfe-sha256 (fkg15-check-message family raw-sha content-sha
                    bound-sha verdict pass outcome present zero one absent)))))
    (defn fkg15-check-family (c) (nth c 1))
    (defn fkg15-check-raw-sha (c) (nth c 2))
    (defn fkg15-check-candidate (c) (nth c 3))
    (defn fkg15-check-content-sha (c) (nth c 4))
    (defn fkg15-check-bound-sha (c) (nth c 5))
    (defn fkg15-check-verdict (c) (nth c 6))
    (defn fkg15-check-pass? (c) (nth c 7))
    (defn fkg15-check-outcome (c) (nth c 8))
    (defn fkg15-check-present? (c) (nth c 9))
    (defn fkg15-check-zero? (c) (nth c 10))
    (defn fkg15-check-one? (c) (nth c 11))
    (defn fkg15-check-nothing? (c) (nth c 12))
    (defn fkg15-check-sha (c) (nth c 13))
    (defn fkg15-check-valid? (plan raw check)
        (if (and (eq (fkg15-plan-valid? plan) 1)
                 (eq (fkpfm-equal? check (fkg15-check plan raw)) 1)) 1 0))

    ; Public executable supervision after an independent miss. This is a
    ; challenge-derived lesson, never heldout evidence and never a claim that
    ; the model invented the candidate. The verifier still reparses and runs
    ; every returned byte.
    (defn fkg15-supervised-exemplar (plan)
        (do
            (let challenge (fkg15-plan-challenge plan))
            (let bml-value (fgsg-challenge-bml-value challenge))
            (let bml (fkg15-cat (list
                "int Lift(int n) { return n + 1; }\nreturn Lift("
                (int_to_str (sub bml-value 1)) ");\n")))
            (let bmf
                "grammar {\n  rule atmark { lit @ }\n  rule vowel { class ae }\n  rule markedvowel { seq atmark vowel }\n  rule entrance { alt vowel markedvowel }\n  top entrance\n  probe @a\n}\n")
            (let form (fgsg-control-canonical
                (fkg15-cat (list "<|form:recipe-exec|>"
                    (frex-node-coordinate (frex-recipe)) ";input="
                    (int_to_str (fgsg-challenge-input challenge))
                    ";carrier=auto<|/form:recipe-exec|>"))
                "nothing,timeout,zero" "one"
                (int_to_str (fgsg-challenge-checkpoint challenge))
                (int_to_str (fgsg-challenge-timeout-budget challenge))
                (fgsg-challenge-plane challenge)
                (int_to_str (fgsg-challenge-heat challenge))
                (int_to_str (fgsg-challenge-pure challenge))))
            (fkg15-cat (list "<BML>\n" bml "</BML>\n<BMF>\n" bmf
                "</BMF>\n<FORM>\n" form "</FORM>"))))

    ; Supervision carries the executed refusal, never an answer labeled heldout.
    (defn fkg15-repair-prompt (plan first-check)
        (fkg15-cat (list
            "Supervised embodiment repair for public family="
            (fkg15-plan-family plan) ". This is not heldout evidence.\n"
            "first-output-sha=" (fkg15-check-raw-sha first-check)
            "\nfirst-check-sha=" (fkg15-check-sha first-check)
            "\nBML-pass=" (int_to_str
                (fgsg-verdict-bml (fkg15-check-verdict first-check)))
            "\nBMF-pass=" (int_to_str
                (fgsg-verdict-bmf (fkg15-check-verdict first-check)))
            "\nFORM-pass=" (int_to_str
                (fgsg-verdict-form (fkg15-check-verdict first-check)))
            "\nReturn one corrected candidate only: exactly one <BML>, <BMF>, and <FORM> frame. BML must return "
            (int_to_str (fgsg-challenge-bml-value
                (fkg15-plan-challenge plan)))
            "; Form recipe input=" (int_to_str (fgsg-challenge-input
                (fkg15-plan-challenge plan)))
            ", checkpoint=" (int_to_str (fgsg-challenge-checkpoint
                (fkg15-plan-challenge plan)))
            ". Preserve scannerless choice/undo/cut/timeout and distinct nothing/zero/one. No prose.\n"
            "Observed public executable exemplar follows. Return it byte-for-byte, with no extra frame or prose:\n"
            (fkg15-supervised-exemplar plan))))

    ; ---- model attempt ------------------------------------------------
    (defn fkg15-session-id-for (run-id model-id)
        (nmfe-sha256 (nmfe-fields (list
            "public-generative-local-residence-v1" (fkg15-plan-seal)
            run-id model-id))))
    (defn fkg15-attempt-nonce-for
        (plan index lane parent prompt-sha raw-sha report-sha
         model-id run-id session-id)
        (nmfe-sha256 (nmfe-fields (list "public-generative-attempt-v1"
            (fkg15-plan-nonce plan) (int_to_str index) lane parent prompt-sha
            raw-sha report-sha model-id run-id session-id))))
    (defn fkg15-report-state-released (report)
        (if (ge (str_find report "\nstate_released=1\n" 0) 0) 1 0))
    ; attempt = tag plan index role lane parent prompt prompt-sha raw raw-sha
    ;           check model run session attempt-nonce local remote
    ;           model-executed state-released same-residence latency
    ;           generation-report report-sha generated-tokens forward-passes
    (defn fkg15-attempt
        (plan index role lane parent prompt raw model-id run-id session-id
         local remote model-executed state-released same-residence latency
         report generated-tokens forward-passes)
        (do
            (let prompt-sha (nmfe-sha256 prompt))
            (let raw-sha (nmfe-sha256 raw))
            (let report-sha (nmfe-sha256 report))
            (list "public-generative-model-attempt-v1" plan index role lane
                parent prompt prompt-sha raw raw-sha (fkg15-check plan raw)
                model-id run-id session-id
                (fkg15-attempt-nonce-for plan index lane parent prompt-sha
                    raw-sha report-sha model-id run-id session-id)
                local remote model-executed state-released same-residence
                latency report report-sha generated-tokens forward-passes)))
    (defn fkg15-attempt-plan (a) (nth a 1))
    (defn fkg15-attempt-index (a) (nth a 2))
    (defn fkg15-attempt-role (a) (nth a 3))
    (defn fkg15-attempt-lane (a) (nth a 4))
    (defn fkg15-attempt-parent (a) (nth a 5))
    (defn fkg15-attempt-prompt (a) (nth a 6))
    (defn fkg15-attempt-prompt-sha (a) (nth a 7))
    (defn fkg15-attempt-raw (a) (nth a 8))
    (defn fkg15-attempt-raw-sha (a) (nth a 9))
    (defn fkg15-attempt-check (a) (nth a 10))
    (defn fkg15-attempt-model-id (a) (nth a 11))
    (defn fkg15-attempt-run-id (a) (nth a 12))
    (defn fkg15-attempt-session-id (a) (nth a 13))
    (defn fkg15-attempt-nonce (a) (nth a 14))
    (defn fkg15-attempt-local (a) (nth a 15))
    (defn fkg15-attempt-remote (a) (nth a 16))
    (defn fkg15-attempt-model-executed (a) (nth a 17))
    (defn fkg15-attempt-state-released (a) (nth a 18))
    (defn fkg15-attempt-same-residence (a) (nth a 19))
    (defn fkg15-attempt-latency (a) (nth a 20))
    (defn fkg15-attempt-report (a) (nth a 21))
    (defn fkg15-attempt-report-sha (a) (nth a 22))
    (defn fkg15-attempt-generated-tokens (a) (nth a 23))
    (defn fkg15-attempt-forward-passes (a) (nth a 24))
    (defn fkg15-attempt-valid? (a)
        (if (not (eq (fkpfm-list? a) 1)) 0
        (if (not (eq (len a) 25)) 0
        (if (not (str_eq (nth a 0)
                         "public-generative-model-attempt-v1")) 0
            (do
                (let p (fkg15-attempt-plan a))
                (if (and (eq (fkg15-plan-valid? p) 1)
                     (and (str_eq (fkg15-attempt-prompt-sha a)
                                  (nmfe-sha256 (fkg15-attempt-prompt a)))
                     (and (str_eq (fkg15-attempt-raw-sha a)
                                  (nmfe-sha256 (fkg15-attempt-raw a)))
                     (and (str_eq (fkg15-attempt-report-sha a)
                                  (nmfe-sha256 (fkg15-attempt-report a)))
                     (and (eq (fkg15-check-valid? p (fkg15-attempt-raw a)
                                  (fkg15-attempt-check a)) 1)
                     (and (str_eq (fkg15-attempt-session-id a)
                                  (fkg15-session-id-for
                                      (fkg15-attempt-run-id a)
                                      (fkg15-attempt-model-id a)))
                     (and (str_eq (fkg15-attempt-nonce a)
                                  (fkg15-attempt-nonce-for p
                                      (fkg15-attempt-index a)
                                      (fkg15-attempt-lane a)
                                      (fkg15-attempt-parent a)
                                      (fkg15-attempt-prompt-sha a)
                                      (fkg15-attempt-raw-sha a)
                                      (fkg15-attempt-report-sha a)
                                      (fkg15-attempt-model-id a)
                                      (fkg15-attempt-run-id a)
                                      (fkg15-attempt-session-id a)))
                     (and (gt (str_len (fkg15-attempt-model-id a)) 0)
                     (and (eq (nmfe-sha256? (fkg15-attempt-run-id a)) 1)
                     (and (eq (fkg15-attempt-local a) 1)
                     (and (eq (fkg15-attempt-remote a) 0)
                     (and (eq (fkg15-attempt-model-executed a)
                              (if (and (gt (fkg15-attempt-generated-tokens a) 0)
                                       (gt (fkg15-attempt-forward-passes a) 0))
                                  1 0))
                     (and (eq (fkg15-attempt-model-executed a) 1)
                     (and (eq (fkg15-attempt-state-released a)
                              (fkg15-report-state-released
                                  (fkg15-attempt-report a)))
                     (and (eq (fkg15-attempt-state-released a) 1)
                     (and (eq (fkg15-attempt-same-residence a) 1)
                          (ge (fkg15-attempt-latency a) 0))))))))))))))))) 1 0))))))

    ; ---- retained family row ----------------------------------------
    (defn fkg15-row-nonce-for (plan first repair lane final-index)
        (nmfe-sha256 (nmfe-fields (list "public-generative-family-row-v1"
            (fkg15-plan-nonce plan) (fkg15-attempt-nonce first)
            (if (nothing? repair) "nothing" (fkg15-attempt-nonce repair))
            lane (int_to_str final-index)))))
    (defn fkg15-row (plan first repair lane final-index)
        (list "public-generative-family-row-v1" plan first repair lane
            final-index (fkg15-row-nonce-for plan first repair lane final-index)))
    (defn fkg15-row-plan (r) (nth r 1))
    (defn fkg15-row-first (r) (nth r 2))
    (defn fkg15-row-repair (r) (nth r 3))
    (defn fkg15-row-lane (r) (nth r 4))
    (defn fkg15-row-final-index (r) (nth r 5))
    (defn fkg15-row-nonce (r) (nth r 6))
    (defn fkg15-row-final-attempt (r)
        (if (eq (fkg15-row-final-index r) 1)
            (fkg15-row-first r) (fkg15-row-repair r)))
    (defn fkg15-same-attempt-residence? (a b)
        (if (and (str_eq (fkg15-attempt-model-id a)
                          (fkg15-attempt-model-id b))
             (and (str_eq (fkg15-attempt-run-id a)
                          (fkg15-attempt-run-id b))
                  (str_eq (fkg15-attempt-session-id a)
                          (fkg15-attempt-session-id b)))) 1 0))
    (defn fkg15-row-valid? (r)
        (if (not (eq (fkpfm-list? r) 1)) 0
        (if (not (eq (len r) 7)) 0
        (if (not (str_eq (nth r 0) "public-generative-family-row-v1")) 0
            (do
                (let p (fkg15-row-plan r))
                (let first (fkg15-row-first r))
                (let repair (fkg15-row-repair r))
                (let first-check (fkg15-attempt-check first))
                (let first-pass (fkg15-check-pass? first-check))
                (let shape
                    (if (eq first-pass 1)
                        (if (and (nothing? repair)
                             (and (str_eq (fkg15-row-lane r)
                                          (fkg15-independent-lane))
                                  (eq (fkg15-row-final-index r) 1))) 1 0)
                        (if (and (not (nothing? repair))
                             (and (eq (fkg15-attempt-valid? repair) 1)
                             (and (eq (fkg15-same-attempt-residence?
                                          first repair) 1)
                             (and (eq (fkg15-attempt-index repair) 2)
                             (and (str_eq (fkg15-attempt-role repair) "repair")
                             (and (str_eq (fkg15-attempt-lane repair)
                                          (fkg15-supervised-lane))
                             (and (str_eq (fkg15-attempt-parent repair)
                                          (fkg15-check-sha first-check))
                             (and (str_eq (fkg15-attempt-prompt repair)
                                          (fkg15-repair-prompt p first-check))
                             (and (eq (fkg15-check-pass?
                                          (fkg15-attempt-check repair)) 1)
                             (and (str_eq (fkg15-row-lane r)
                                          (fkg15-supervised-lane))
                                  (eq (fkg15-row-final-index r) 2))))))))))) 1 0)))
                (if (and (eq (fkg15-plan-valid? p) 1)
                     (and (eq (fkg15-attempt-valid? first) 1)
                     (and (eq (fkpfm-equal? p
                                  (fkg15-attempt-plan first)) 1)
                     (and (eq (fkg15-attempt-index first) 1)
                     (and (str_eq (fkg15-attempt-role first) "candidate")
                     (and (str_eq (fkg15-attempt-lane first)
                                  (fkg15-independent-lane))
                     (and (str_eq (fkg15-attempt-parent first)
                                  (fkg15-plan-nonce p))
                     (and (str_eq (fkg15-attempt-prompt first)
                                  (fkg15-plan-prompt p))
                     (and (eq shape 1)
                          (str_eq (fkg15-row-nonce r)
                              (fkg15-row-nonce-for p first repair
                                  (fkg15-row-lane r)
                                  (fkg15-row-final-index r)))))))))))) 1 0))))))

    ; ---- 15-row replay boundaries -----------------------------------
    (defn fkg15-count-family (rows family)
        (if (eq (len rows) 0) 0
            (add (if (str_eq (fkg15-plan-family
                                (fkg15-row-plan (head rows))) family) 1 0)
                 (fkg15-count-family (tail rows) family))))
    (defn fkg15-every-family-once? (families rows)
        (if (eq (len families) 0) 1
            (if (eq (fkg15-count-family rows (head families)) 1)
                (fkg15-every-family-once? (tail families) rows) 0)))
    (defn fkg15-all-rows-valid? (rows)
        (if (eq (len rows) 0) 1
            (if (eq (fkg15-row-valid? (head rows)) 1)
                (fkg15-all-rows-valid? (tail rows)) 0)))
    (defn fkg15-row-attempts (row)
        (if (nothing? (fkg15-row-repair row))
            (list (fkg15-row-first row))
            (list (fkg15-row-first row) (fkg15-row-repair row))))
    (defn fkg15-all-attempts (rows)
        (if (eq (len rows) 0) (list)
            (append (fkg15-row-attempts (head rows))
                    (fkg15-all-attempts (tail rows)))))
    (defn fkg15-strings-unique-one? (value rest accessor)
        (if (eq (len rest) 0) 1
            (if (str_eq value (accessor (head rest))) 0
                (fkg15-strings-unique-one? value (tail rest) accessor))))
    (defn fkg15-strings-unique? (rows accessor)
        (if (eq (len rows) 0) 1
            (if (eq (fkg15-strings-unique-one?
                          (accessor (head rows)) (tail rows) accessor) 1)
                (fkg15-strings-unique? (tail rows) accessor) 0)))
    (defn fkg15-row-final-content-sha (row)
        (fkg15-check-content-sha
            (fkg15-attempt-check (fkg15-row-final-attempt row))))
    (defn fkg15-row-source-sha (row)
        (fkg15-plan-source-sha (fkg15-row-plan row)))
    (defn fkg15-same-global? (rows model-id run-id session-id)
        (if (eq (len rows) 0) 1
            (do
                (let first (fkg15-row-first (head rows)))
                (if (and (str_eq (fkg15-attempt-model-id first) model-id)
                     (and (str_eq (fkg15-attempt-run-id first) run-id)
                          (str_eq (fkg15-attempt-session-id first) session-id)))
                    (fkg15-same-global? (tail rows) model-id run-id session-id)
                    0))))
    (defn fkg15-row-set-valid? (rows)
        (if (not (eq (len rows) (fkpfm-family-total))) 0
            (do
                (let first (fkg15-row-first (head rows)))
                (let attempts (fkg15-all-attempts rows))
                (if (and (eq (fkg15-all-rows-valid? rows) 1)
                     (and (eq (fkg15-every-family-once?
                                  (fkpfm-family-ids) rows) 1)
                     (and (eq (fkg15-same-global? rows
                                  (fkg15-attempt-model-id first)
                                  (fkg15-attempt-run-id first)
                                  (fkg15-attempt-session-id first)) 1)
                     (and (eq (fkg15-strings-unique? attempts
                                  fkg15-attempt-raw-sha) 1)
                     (and (eq (fkg15-strings-unique? rows
                                  fkg15-row-final-content-sha) 1)
                     (and (eq (fkg15-strings-unique? rows
                                  fkg15-row-source-sha) 1)
                          (eq (fkg15-strings-unique? rows
                                  fkg15-row-nonce) 1))))))) 1 0))))

    ; ---- v2 evidence and export -------------------------------------
    (defn fkg15-evidence-for-row (row release-ok)
        (if (not (and (eq (fkg15-row-valid? row) 1)
                      (eq release-ok 1))) (nothing)
            (do
                (let attempt (fkg15-row-final-attempt row))
                (let family (fkg15-plan-family (fkg15-row-plan row)))
                (let raw (fkg15-attempt-raw attempt))
                (let candidate
                    (fkg15-check-candidate (fkg15-attempt-check attempt)))
                (let receipt (fkpfm-generative-receipt family
                    (fkg15-attempt-model-id attempt)
                    (fkg15-attempt-run-id attempt) raw candidate))
                (fkpfm-generative-evidence family
                    (fkg15-attempt-model-id attempt) receipt raw candidate
                    (fkg15-attempt-model-executed attempt)
                    (fkg15-attempt-remote attempt) release-ok))))
    (defn fkg15-evidences-loop (rows release-ok)
        (if (eq (len rows) 0) (list)
            (cons (fkg15-evidence-for-row (head rows) release-ok)
                  (fkg15-evidences-loop (tail rows) release-ok))))
    (defn fkg15-all-evidences-valid? (evidences)
        (if (eq (len evidences) 0) 1
            (if (eq (fkpfm-generative-valid? (head evidences)) 1)
                (fkg15-all-evidences-valid? (tail evidences)) 0)))
    (defn fkg15-count-attempt-field (attempts index)
        (if (eq (len attempts) 0) 0
            (add (nth (head attempts) index)
                 (fkg15-count-attempt-field (tail attempts) index))))
    (defn fkg15-count-lane (rows lane)
        (if (eq (len rows) 0) 0
            (add (if (str_eq (fkg15-row-lane (head rows)) lane) 1 0)
                 (fkg15-count-lane (tail rows) lane))))
    ; result = tag plan-seal model run session rows evidence opens reopens
    ;          attempts local remote model-executed states same release
    ;          independent supervised complete ready15 label basis
    (defn fkg15-result (rows opens reopens release-ok)
        (do
            (let set-ok (fkg15-row-set-valid? rows))
            (let attempts (if (eq set-ok 1) (fkg15-all-attempts rows) (list)))
            (let first (if (eq set-ok 1)
                (fkg15-row-first (head rows)) (nothing)))
            (let model-id (if (eq set-ok 1)
                (fkg15-attempt-model-id first) ""))
            (let run-id (if (eq set-ok 1)
                (fkg15-attempt-run-id first) (nothing)))
            (let session-id (if (eq set-ok 1)
                (fkg15-attempt-session-id first) (nothing)))
            (let evidence (if (eq set-ok 1)
                (fkg15-evidences-loop rows release-ok) (list)))
            (let attempt-count (len attempts))
            (let local (fkg15-count-attempt-field attempts 15))
            (let remote (fkg15-count-attempt-field attempts 16))
            (let executed (fkg15-count-attempt-field attempts 17))
            (let states (fkg15-count-attempt-field attempts 18))
            (let same (fkg15-count-attempt-field attempts 19))
            (let independent (fkg15-count-lane rows
                                (fkg15-independent-lane)))
            (let supervised (fkg15-count-lane rows
                                (fkg15-supervised-lane)))
            (let complete (fkg15-all-one? (list
                set-ok
                (if (eq opens 1) 1 0)
                (if (eq reopens 0) 1 0)
                (if (ge attempt-count (fkpfm-family-total)) 1 0)
                (if (le attempt-count (mul 2 (fkpfm-family-total))) 1 0)
                (if (eq local attempt-count) 1 0)
                (if (eq remote 0) 1 0)
                (if (eq executed attempt-count) 1 0)
                (if (eq states attempt-count) 1 0)
                (if (eq same attempt-count) 1 0)
                release-ok
                (if (eq (len evidence) (fkpfm-family-total)) 1 0)
                (fkg15-all-evidences-valid? evidence))))
            (list "public-generative-15-result-v1" (fkg15-plan-seal)
                model-id run-id session-id rows evidence opens reopens
                attempt-count local remote executed states same release-ok
                independent supervised complete complete
                "public-generative-or-supervised-embodiment;never-heldout"
                (fkg15-basis))))
    (defn fkg15-result-rows (r) (nth r 5))
    (defn fkg15-result-evidences (r) (nth r 6))
    (defn fkg15-result-complete? (r) (nth r 18))
    (defn fkg15-result-ready15? (r) (nth r 19))
    (defn fkg15-result-valid? (r)
        (if (and (eq (fkpfm-list? r) 1)
                 (and (eq (len r) 22)
                      (str_eq (nth r 0) "public-generative-15-result-v1")))
            (if (eq (fkpfm-equal? r
                    (fkg15-result (nth r 5) (nth r 7)
                                  (nth r 8) (nth r 15))) 1) 1 0)
            0))
    (defn fkg15-export (result)
        (if (not (eq (fkg15-result-valid? result) 1)) (nothing)
            (list "public-generative-15-export-v1"
                (nth result 1) (nth result 2) (nth result 3) (nth result 4)
                (nth result 5) (nth result 6) (nth result 7) (nth result 8)
                (nth result 9) (nth result 10) (nth result 11) (nth result 12)
                (nth result 13) (nth result 14) (nth result 15)
                (nth result 16) (nth result 17) (nth result 18)
                (nth result 19) (nth result 20) (nth result 21))))
    (defn fkg15-export-valid? (e)
        (if (not (and (eq (fkpfm-list? e) 1)
                      (and (eq (len e) 22)
                           (str_eq (nth e 0)
                                   "public-generative-15-export-v1")))) 0
            (do
                (let rebuilt (fkg15-result (nth e 5) (nth e 7)
                                         (nth e 8) (nth e 15)))
                (if (eq (fkpfm-equal? e
                        (list "public-generative-15-export-v1"
                            (nth rebuilt 1) (nth rebuilt 2) (nth rebuilt 3)
                            (nth rebuilt 4) (nth rebuilt 5) (nth rebuilt 6)
                            (nth rebuilt 7) (nth rebuilt 8) (nth rebuilt 9)
                            (nth rebuilt 10) (nth rebuilt 11) (nth rebuilt 12)
                            (nth rebuilt 13) (nth rebuilt 14) (nth rebuilt 15)
                            (nth rebuilt 16) (nth rebuilt 17) (nth rebuilt 18)
                            (nth rebuilt 19) (nth rebuilt 20)
                            (nth rebuilt 21))) 1) 1 0))))

    0
