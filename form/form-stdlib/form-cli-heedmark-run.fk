; form-cli-heedmark-run.fk — print the heedmark law: what the carrier heeds,
; what enters the stream, what it costs, and what it refuses.
;
; preludes: form-stdlib/core.fk form-stdlib/language-template.fk
; preludes: form-stdlib/form-cli-heedmark-xtal.fk

(do
    (defn fhmr-line (name value)
        (print_str (str_concat "fhm " (str_concat name (str_concat "=" (str_concat value "\n"))))))
    (defn fhmr-int (name value) (fhmr-line name (int_to_str value)))
    (defn fhmr-name (o)
        (if (eq o (OutHit)) "hit"
            (if (eq o (OutMiss)) "miss"
                (if (eq o (OutNothing)) "nothing"
                    (if (eq o (OutSpent)) "spent" "?")))))

    (fhmr-int "check" (fhm-check))
    (fhmr-line "open" (HeedOpen))
    (fhmr-line "close" (HeedClose))
    (fhmr-int "max-heeds" (MaxHeeds))
    (fhmr-int "logits-executed" (fhm-logits-executed))

    ; the carrier's decision, one row per situation it can meet
    (fhmr-line "outcome grounded-row" (fhmr-name (fhm-outcome 2 1 0 3)))
    (fhmr-line "outcome no-row" (fhmr-name (fhm-outcome 2 1 0 0)))
    (fhmr-line "outcome window-closed" (fhmr-name (fhm-outcome 2 1 1 3)))
    (fhmr-line "outcome no-index" (fhmr-name (fhm-outcome 2 0 0 3)))
    (fhmr-line "outcome budget-gone" (fhmr-name (fhm-outcome 0 1 0 3)))

    ; what actually enters the stream
    (fhmr-int "span-enters hit" (fhm-injects-span (OutHit)))
    (fhmr-int "span-enters miss" (fhm-injects-span (OutMiss)))
    (fhmr-int "span-enters nothing" (fhm-injects-span (OutNothing)))
    (fhmr-int "span-enters spent" (fhm-injects-span (OutSpent)))
    (fhmr-int "knowledge-enters hit" (fhm-injects-knowledge (OutHit)))
    (fhmr-int "knowledge-enters miss" (fhm-injects-knowledge (OutMiss)))
    (fhmr-line "miss-text" (fhm-miss-text))
    (fhmr-line "hit-span" (fhm-span-text (OutHit) "axiom-1 quiet answers as nothing" "form-stdlib/core.fk"))

    ; a hit with no source is refused
    (fhmr-int "admits-hit no-source" (fhm-admits-hit (OutHit) ""))
    (fhmr-int "admits-hit with-source" (fhm-admits-hit (OutHit) "form-stdlib/core.fk"))

    ; the bound
    (fhmr-int "bounded 0-marks" (fhm-bounded 0))
    (fhmr-int "bounded 1-mark" (fhm-bounded 1))
    (fhmr-int "bounded 5-marks" (fhm-bounded 5))

    ; the prefix seam — a 1000-token context, a 12-token answer
    (fhmr-int "prefill-cost" (fhm-prefill-cost 1000 12))
    (fhmr-int "naive-cost" (fhm-naive-cost 1000 12))
    (fhmr-int "forwards-saved" (fhm-forwards-saved 1000 12))
    (fhmr-int "prefix-preserved" (fhm-prefix-preserved))
    0)
