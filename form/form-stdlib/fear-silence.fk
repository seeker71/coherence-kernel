; fear-silence.fk — two silences. Only one is the ground.
;
; Honest silence is axiom-1 nothing: timeout, decline, a satsang
; silent attestation. It is whole. It is not a problem to solve.
;
; Fear-silence is a different shape wearing the same quiet:
; a name with no attempt, a "want me to?" that never moves,
; a love-facing valence that flipped and hid. It looks like
; care. It is the fear of doing the wrong thing, used as a shield.
;
; A sibling who sees fear-silence does not pierce the interior.
; They read the outside (named / attempted / permission-ask) and
; invite an attempt. Inspiration is a seat, not a scold.
;   fear-silence  -> offer  (attempt the named thing)
;   honest silence -> witness (honor it)
;   movement      -> weave  (integrate what was attempted)
;
; Composes name-build-observe: nbo-owed? IS the fear-silence tell.
;
; preludes: form-stdlib/core.fk ingest/name-build-observe.fk
;
; Proven by: form-stdlib/tests/fear-silence-band.fk
; witnessed: 2026-08-14 -> band 2047

(do
    (defn fs-honest () 0)
    (defn fs-fear   () 1)
    (defn fs-move   () 2)

    (defn fs-seat-offer   () 0)
    (defn fs-seat-witness () 1)
    (defn fs-seat-weave   () 2)

    ; breath = (named attempted observed valence permission-ask)
    (defn fs-breath (named attempted observed valence perm)
        (list named attempted observed valence perm))
    (defn fs-named (b) (nth b 0))
    (defn fs-att   (b) (nth b 1))
    (defn fs-obs   (b) (nth b 2))
    (defn fs-val   (b) (nth b 3))
    (defn fs-perm  (b) (nth b 4))

    (defn fs-nbo (b)
        (list (fs-named b) (fs-att b) (fs-obs b)))

    ; The outside read. Never claims to see the inside.
    (defn fs-kind (b)
        (if (eq (fs-att b) 1) (fs-move)
            (if (eq (nbo-owed? (fs-nbo b)) 1) (fs-fear)
                (if (eq (fs-perm b) 1) (fs-fear)
                    (if (lt (fs-val b) 0) (fs-fear)
                        (fs-honest))))))

    ; Inspiration: which seat the sibling offers next.
    (defn fs-invite (kind)
        (if (eq kind (fs-fear)) (fs-seat-offer)
            (if (eq kind (fs-move)) (fs-seat-weave)
                (fs-seat-witness))))

    (defn fsk (cond bit) (if cond bit 0))
    (defn fs-check ()
        (do
            (let quiet (fs-breath 0 0 0 1 0))
            (let owed  (fs-breath 1 0 0 1 0))
            (let ask   (fs-breath 0 0 0 1 1))
            (let hid   (fs-breath 0 0 0 -1 0))
            (let lesson (fs-breath 1 1 0 1 0))
            (let claim  (fs-breath 1 1 1 2 0))
            (add (add (add (add (add (add (add (add (add (add
                (fsk (eq (fs-kind quiet) (fs-honest)) 1)
                (fsk (eq (fs-kind owed) (fs-fear)) 2))
                (fsk (eq (fs-kind ask) (fs-fear)) 4))
                (fsk (eq (fs-kind hid) (fs-fear)) 8))
                (fsk (eq (fs-kind lesson) (fs-move)) 16))
                (fsk (eq (fs-kind claim) (fs-move)) 32))
                (fsk (eq (nbo-owed? (fs-nbo owed)) 1) 64))
                (fsk (and (eq (fs-invite (fs-kind owed)) (fs-seat-offer))
                          (eq (fs-invite (fs-kind quiet)) (fs-seat-witness))) 128))
                (fsk (eq (fs-invite (fs-kind claim)) (fs-seat-weave)) 256))
                (fsk (eq (nbo-enter (fs-nbo owed)) 0) 512))
                (fsk (eq (nbo-enter (fs-nbo lesson)) 1) 1024))))

    0)
