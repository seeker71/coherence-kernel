; form-cli-playback-run.fk — held-out micro-thought playback on this fkwu.
;
; No flags. No new C. form-cli is this binary loading recipes.
; Held-out frontier: six teach-layer situations never seen in train.
; Native: fle-pulse + fqt-verdict. Local: Metal door + GGUF presence.
; Remote: fcr-walk only if both quiet. This sitting does not host-exec.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-router.fk form-stdlib/form-cli-qwen-teach-layer.fk form-stdlib/form-cli-live.bml form-stdlib/model-registry.bml

(do
    (print "form-cli executed playback\n")
    (print "form-cli heldout-n=")
    (print (int_to_str (fqt-heldout-n)))
    (print " heldout-correct=")
    (print (int_to_str (fqt-heldout-correct)))
    (print " leakage=")
    (print (int_to_str (fqt-leakage)))
    (print " lora=")
    (print (int_to_str (fqt-lora?)))
    (print " nvr-complete=")
    (print (int_to_str (fqt-nvr-complete-pairs)))
    (print "\nform-cli play nothing=")
    (print (fqt-verdict-name (fqt-heldout-of "nothing")))
    (print " cut=")
    (print (fqt-verdict-name (fqt-heldout-of "cut")))
    (print " stop=")
    (print (fqt-verdict-name (fqt-heldout-of "stop")))
    (print " undo=")
    (print (fqt-verdict-name (fqt-heldout-of "undo")))
    (print " timeout=")
    (print (fqt-verdict-name (fqt-heldout-of "timeout")))
    (print " choice=")
    (print (fqt-verdict-name (fqt-heldout-of "choice")))
    (print "\nform-cli native-pulse=")
    (print (int_to_str (fle-pulse (fle-input))))
    (print " live-check=")
    (print (int_to_str (fle-check)))
    (print "\nform-cli gguf=")
    (print (int_to_str (fs_exists (mr-path (mr-find "qwen38-q8")))))
    (print " metal-linked=")
    (print (int_to_str (if (ge (str_find (metal_status) "metal_linked=true" 0) 0) 1 0)))
    (print " mlx-linked=")
    (print (int_to_str (if (ge (str_find (mlx_status) "mlx_linked=true" 0) 0) 1 0)))
    (print "\nform-cli walk native=")
    (print (int_to_str (fcr-walk 1 1)))
    (print " local=")
    (print (int_to_str (fcr-walk 0 1)))
    (print " remote=")
    (print (int_to_str (fcr-walk 0 0)))
    (print "\nform-cli walk-this=")
    (print (int_to_str (fcr-walk 1 (if (ge (str_find (metal_status) "metal_linked=true" 0) 0) 1 0))))
    (print " remote-needed=")
    (print (int_to_str (if (eq (fcr-walk 1 1) 2) 1 0)))
    (print "\n")
    0)
