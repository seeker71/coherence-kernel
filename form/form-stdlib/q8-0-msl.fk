; q8-0-msl.fk — the Q8_0 carver the body did not have, as a Metal kernel the BODY emits.
;
; WHY THIS EXISTS. GPU_GAPS.md:29 named Q8_0 as missing, and Stone 11's gap map
; (receipts/2026-07-21-ds4-metal-gap-map.md, row 5 of the capability table) measured exactly what that
; costs: dolphin-2.9-mixtral-8x22b carries 112 Q8_0 tensors — every `attn_k` and `attn_v` in its 56
; layers. Not exotic, and not large (0.70 GiB of a 107.59 GiB file), but a decode that cannot read them
; cannot take one step. Every other quantization the body owns (Q4_K, Q6_K) has a 256-weight
; superblock; Q8_0's block is 32. That difference — and NOT the arithmetic — is the whole of the work,
; which is why the gap map called this "structurally the easiest quant we could add".
;
; THE FORMAT, and it is the simplest one ggml has:
;
;   block_q8_0 = { half d; int8_t qs[32]; }        34 bytes per 32 weights, w_i = d * q_i
;
; No sub-scales, no nibbles, no high-bit plane, no mins. One f16 super-scale and 32 signed bytes.
;
; BIT-EXACTNESS IS CLAIMABLE HERE, and more strongly than for Q6_K. w = d * q with d an f16 value
; (11-bit significand) and q a signed int8 (<= 8 bits). The product needs <= 19 significand bits, so it
; is EXACT in f32 — it does not even round once. Form computes the same product in fp64 (53 bits,
; exact) and the carrier rounds that exact value once to f32, which is the same f32. So the audit gate
; is EQUALITY, not an epsilon. (Q6_K's argument needed 25 bits and one rounding; this one needs none.)
;
; NO HEADER, ON PURPOSE — the same discipline q6k-msl.fk states and for the same reason: the f16
; super-scale is decoded by ARITHMETIC (q80_f16 is fd-value at eb=5, mb=10, transcribed line for line),
; not by `as_type<half>`, which lives in <metal_stdlib>. A carrier that emits this next to q6k-msl.fk's
; unit must emit ONE spine, so the shared helpers are factored: `q80-msl-helpers` emits the f16 decode
; and the int helpers, and `q80-msl-appendix` emits ONLY the Q8_0-specific pieces, for a unit that
; already has q6k_mod / q6k_s8 / q6k_f16 in it.
;
; THE RADIUS THIS CELL SPEAKS FOR. GGML type 8 (Q8_0) only, little-endian f16 super-scale, and a flat
; weight index whose block boundary is idx/32 — that is, a caller whose tensor base is itself a block
; boundary. It does NOT speak for Q8_1 (which carries a second f16 sum and a 36-byte block), and it
; does NOT speak for the MSL compiler or the GPU: the transcription is proven by
; form-stdlib/tests/q8-0-msl-band.fk and the GPU by form/native/metal/metal_moe_token.sh, which gates a
; Q8_0 fused matvec at the REAL width (6144) of a real blk.0.attn_k row of dolphin-mixtral-8x22b
; against Form's fp64 dot.
;
; Kin: q6k-msl.fk (the pattern this follows exactly — transcription read back into Form, then the same
; text emitted as C; and the owner of q6k_mod/q6k_s8/q6k_f16, which this cell reuses rather than
; re-mints), f16-decode.fk (fd-value at (5,10) — the recipe q80_f16 transcribes), q6k-dequant.fk
; (q6k-mod / q6k-s8 — the one integer spine), equireach-gguf.fk (eqr-at — the byte reach).
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/q6k-dequant.fk form-stdlib/q6k-msl.fk
;
; Proven by: form-stdlib/tests/q8-0-msl-band.fk (the transcription, against an independently written
;            reference) and form/native/metal/metal_moe_token.sh (the GPU, Mac-only).

(do
    ; ================= the transcription, read back into Form =================
    ; This is what the emitted C computes, written in Form with the same flat index, the same block
    ; stride and the same literal byte offsets. It exists so a band can falsify the transcription.

    (defn q80-stride () 34)                          ; bytes per Q8_0 block
    (defn q80-block-n () 32)                         ; weights per block
    (defn q80-blk (idx) (div idx (q80-block-n)))     ; which block a flat weight index falls in
    (defn q80-i   (idx) (q6k-mod idx (q80-block-n))) ; and where inside it

    ; the block's f16 super-scale, at bytes 0..1 of the block, little-endian
    (defn q80-d (src b) (fd-f16 (add (eqr-at src b) (mul 256 (eqr-at src (add b 1))))))

    ; the signed byte, at byte 2 + i of the block. q6k-s8 is the body's one two's-complement reach.
    (defn q80-q (src b i) (q6k-s8 (eqr-at src (add b (add 2 i)))))

    ; the weight at a flat index, relative to a base that is itself a block boundary
    (defn q80-flat-at (src base idx)
        (do
            (let b (add base (mul (q80-blk idx) (q80-stride))))
            (mul (q80-d src b) (q80-q src b (q80-i idx)))))

    ; byte length of a Q8_0 tensor of n weights — n must be a whole multiple of 32, which every
    ; ggml Q8_0 tensor is by construction (that is what the quantizer emits).
    (defn q80-bytes (n) (mul (div n (q80-block-n)) (q80-stride)))

    ; ================= the emitted MSL =================
    ; str_concat over named fragments, one fragment per meaning, so a diff of the emitted text points
    ; at a recipe and not at a blob.

    ; The shared integer + f16 spine, IDENTICAL to q6k-msl.fk's (q6m-msl-int / q6m-msl-f16) because it
    ; is the same meaning: one definition of q6k_mod, q6k_s8 and q6k_f16 in the body, reached a fourth
    ; time. A unit that already emits q6k-msl.fk's helpers must NOT emit these again — Metal rejects a
    ; repeated definition, loudly — so `q80-msl-appendix` below exists for exactly that case.
    (defn q80-msl-spine ()
        (str_concat (q6m-msl-int) (q6m-msl-f16)))

    ; the weight itself, at a flat index into the quantized tensor — q80-flat-at, in C. The whole
    ; format is these four lines.
    (defn q80-msl-weight ()
        "static inline float q80_w(device const uchar* qb, uint idx) { uint blk = idx / 32u; uint i = idx - blk * 32u; uint b = blk * 34u; ushort hb = (ushort)qb[b] | ((ushort)qb[b + 1u] << 8); float d = float(as_type<half>(hb)); int q = q6k_s8(int(qb[b + 2u + i])); return d * float(q); } ")

    ; --- kernel 1: dequant a range of the resident quantized tensor into f32. One thread per weight.
    ; `off` is a flat WEIGHT offset, the same contract q6m-dequant-body keeps. ---
    (defn q80-dequant-body (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device const uchar* qb [[buffer(0)]], device float* w [[buffer(1)]], constant uint& off [[buffer(2)]], constant uint& n [[buffer(3)]], uint i [[thread_position_in_grid]]) { if (i >= n) return; w[i] = q80_w(qb, off + i); }")))

    ; --- kernel 2: the FUSED matvec, THE ATTESTANT. One thread per row, j counting DOWN and the
    ; accumulate `p + acc` — tb-dot's right fold, the same op order q6m-matvec-body emits, so a Q8_0
    ; row and a Q6_K row are comparable and the carrier's epsilon argument is one argument, not two. ---
    (defn q80-matvec-body (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], uint i [[thread_position_in_grid]]) { if (i >= rows) return; float acc = 0.0f; uint j = cols; while (j > 0) { j -= 1; float p = q80_w(qb, uint(i) * cols + j) * float(x[j]); acc = p + acc; } y[i] = acc; }")))

    ; --- kernel 3: the LANE matvec. One SIMD group per row, reduced by simd_sum. This REASSOCIATES the
    ; row sum and so answers to an epsilon, not to equality — the same standing qk-matvec-lane.fk's
    ; lane kernel has, for the same reason and with the same shape (32 lanes, stride 32, simd_sum).
    ; It needs <metal_stdlib> for simd_sum, so the emitting unit must lead with that header; the call
    ; is fully qualified (metal::simd_sum) so no unqualified name in the unit is disturbed. ---
    (defn q80-matvec-lane-body (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], uint tid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) { uint r = tid / 32u; if (r >= rows) return; float acc = 0.0f; uint j = lane; while (j < cols) { float p = q80_w(qb, r * cols + j) * float(x[j]); acc = acc + p; j += 32u; } float s = metal::simd_sum(acc); if (lane == 0u) { y[r] = s; } }")))

    ; --- kernel 4: the wide Metal matvec.  One 256-thread group owns two rows.  A thread consumes
    ; eight adjacent signed weights and
    ; packed_float4 activation pairs per block; the group reduction is staged through 64 floats.
    ; This is the Q8_0 shape already carried and stream-gated by ds4-order-match.fk, generalized only
    ; over the emitted function name so dense Qwen can select it without disturbing the generic lane.
    (defn q80-matvec-wide-body (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort3 ntg [[threads_per_threadgroup]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) { threadgroup float sh[64]; uint nb = cols / 32u; uint r0 = tgpig.x * 2u; uint nsg = (uint)ntg.x / 32u; uint stride = nsg * 8u; ushort ix = tiisg / 4u; ushort il = tiisg - ix * 4u; uint ib0 = (uint)sgitg * 8u + (uint)ix; float sumf0 = 0.0f; float sumf1 = 0.0f; float yl[8]; device const float* yb = x + ib0 * 32u + (uint)il * 8u; for (uint ib = ib0; ib < nb; ib += stride) { packed_float4 ya = *(device const packed_float4*)(yb); packed_float4 yc = *(device const packed_float4*)(yb + 4); yl[0] = ya.x; yl[1] = ya.y; yl[2] = ya.z; yl[3] = ya.w; yl[4] = yc.x; yl[5] = yc.y; yl[6] = yc.z; yl[7] = yc.w; for (ushort row = 0u; row < 2u; ++row) { uint r = r0 + (uint)row; if (r >= rows) continue; ulong bo = ((ulong)r * (ulong)nb + (ulong)ib) * 34ul; ushort h = (ushort)qb[bo] | ((ushort)qb[bo + 1ul] << 8); device const uchar* qs = qb + bo + 2ul + (ulong)((uint)il * 8u); char4 wa = char4(*(device const packed_char4*)(qs)); char4 wc = char4(*(device const packed_char4*)(qs + 4)); float sumq = 0.0f; sumq = metal::fma(float(wa.x), yl[0], sumq); sumq = metal::fma(float(wa.y), yl[1], sumq); sumq = metal::fma(float(wa.z), yl[2], sumq); sumq = metal::fma(float(wa.w), yl[3], sumq); sumq = metal::fma(float(wc.x), yl[4], sumq); sumq = metal::fma(float(wc.y), yl[5], sumq); sumq = metal::fma(float(wc.z), yl[6], sumq); sumq = metal::fma(float(wc.w), yl[7], sumq); float d = float(as_type<half>(h)); if (row == 0u) sumf0 = metal::fma(sumq, d, sumf0); else sumf1 = metal::fma(sumq, d, sumf1); } yb += stride * 32u; } if (sgitg == 0u) { sh[tiisg] = 0.0f; sh[32u + tiisg] = 0.0f; } sumf0 = metal::simd_sum(sumf0); sumf1 = metal::simd_sum(sumf1); metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); if (tiisg == 0u) { sh[sgitg] = sumf0; sh[32u + sgitg] = sumf1; } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); float t0 = metal::simd_sum(sh[tiisg]); float t1 = metal::simd_sum(sh[32u + tiisg]); if (tiisg == 0u && sgitg == 0u) { if (r0 < rows) y[r0] = t0; if (r0 + 1u < rows) y[r0 + 1u] = t1; } }")))

    ; --- kernel 5: THE COOPERATIVE TWIN of the attestant matvec (stone 16's shape). One threadgroup of 32 threads per
    ; row: the threads load and dequantize the row's products in parallel into threadgroup memory, 1024 at a
    ; time from the top of the row down, and thread 0 folds each chunk in the attestant's own order —
    ; j counting DOWN, `p + acc` — so the sum is the same association, the same rounding: bit for bit the
    ; attestant, not an epsilon-bearing twin (unlike the lane kernel). Dispatch: mode 1, groups = rows,
    ; 32 threads per group, no dynamic threadgroup memory. ---
    (defn q80-matvec-tg-body (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], uint i [[threadgroup_position_in_grid]], uint t [[thread_position_in_threadgroup]]) { threadgroup float pv[1024]; if (i >= rows) return; float acc = 0.0f; uint c = cols; while (c > 0) { uint base = c >= 1024u ? c - 1024u : 0u; uint n = c - base; for (uint k = t; k < n; k += 32u) { uint j = base + k; pv[k] = q80_w(qb, uint(i) * cols + j) * float(x[j]); } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); if (t == 0u) { uint k = n; while (k > 0) { k -= 1; acc = pv[k] + acc; } } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); c = base; } if (t == 0u) y[i] = acc; }")))

    ; --- kernel 6: the cooperative twin with each block read ONCE (the f16 scale, then the 32 weights as sixteen
    ; 16-bit loads) — the same products, the same fold, three times fewer loads. One thread per block of the
    ; 1024-weight chunk; thread 0 still folds j counting down, `p + acc`. ---
    (defn q80-matvec-tg2-body (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], uint i [[threadgroup_position_in_grid]], uint t [[thread_position_in_threadgroup]]) { threadgroup float pv[1024]; if (i >= rows) return; float acc = 0.0f; uint c = cols; uint rowblk = uint(i) * (cols / 32u); while (c > 0) { uint base = c >= 1024u ? c - 1024u : 0u; uint n = c - base; if (t * 32u < n) { uint b = (rowblk + base / 32u + t) * 34u; device const ushort* hp = (device const ushort*)(qb + b); float d = float(as_type<half>(hp[0])); for (uint e = 0u; e < 32u; e += 2u) { ushort two = hp[1u + e / 2u]; int q0 = q6k_s8(int(two & 0xFFu)); int q1 = q6k_s8(int(two >> 8)); uint j = base + t * 32u + e; pv[t * 32u + e] = (d * float(q0)) * float(x[j]); pv[t * 32u + e + 1u] = (d * float(q1)) * float(x[j + 1u]); } } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); if (t == 0u) { uint k = n; while (k > 0) { k -= 1; acc = pv[k] + acc; } } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); c = base; } if (t == 0u) y[i] = acc; }")))

    ; --- kernel 7: the double-buffered twin. Two simdgroups per row: threads 32..47 load the NEXT 512-weight chunk
    ; (one block each, read once) while thread 0 folds the CURRENT chunk, so the exact serial fold — the floor of
    ; this exactness, ~2048 dependent adds a row — overlaps the loads instead of waiting for them. Same products,
    ; same order, `p + acc`, j counting down. cols must be a multiple of 512. ---
    (defn q80-matvec-tg3-body (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], uint i [[threadgroup_position_in_grid]], uint t [[thread_position_in_threadgroup]]) { threadgroup float pv[2][512]; if (i >= rows) return; uint rowblk = uint(i) * (cols / 32u); uint nch = cols / 512u; if (t >= 32u && t < 48u) { uint ci = nch - 1u; uint tb = t - 32u; uint b = (rowblk + ci * 16u + tb) * 34u; device const ushort* hp = (device const ushort*)(qb + b); float d = float(as_type<half>(hp[0])); for (uint e = 0u; e < 32u; e += 2u) { ushort two = hp[1u + e / 2u]; uint j = ci * 512u + tb * 32u + e; pv[ci & 1u][tb * 32u + e] = (d * float(q6k_s8(int(two & 0xFFu)))) * float(x[j]); pv[ci & 1u][tb * 32u + e + 1u] = (d * float(q6k_s8(int(two >> 8)))) * float(x[j + 1u]); } } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); float acc = 0.0f; uint ci = nch; while (ci > 0u) { ci -= 1u; if (t >= 32u && t < 48u && ci > 0u) { uint cn = ci - 1u; uint tb = t - 32u; uint b = (rowblk + cn * 16u + tb) * 34u; device const ushort* hp = (device const ushort*)(qb + b); float d = float(as_type<half>(hp[0])); for (uint e = 0u; e < 32u; e += 2u) { ushort two = hp[1u + e / 2u]; uint j = cn * 512u + tb * 32u + e; pv[cn & 1u][tb * 32u + e] = (d * float(q6k_s8(int(two & 0xFFu)))) * float(x[j]); pv[cn & 1u][tb * 32u + e + 1u] = (d * float(q6k_s8(int(two >> 8)))) * float(x[j + 1u]); } } if (t == 0u) { uint k = 512u; while (k > 0u) { k -= 1u; acc = pv[ci & 1u][k] + acc; } } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); } if (t == 0u) y[i] = acc; }")))

    ; --- kernel 8: the twin that folds SIXTEEN rows a group. The serial fold is the floor of this exactness
    ; (cols dependent adds a row), so the way to bandwidth is more rows folding at once, not a faster fold:
    ; the sixteen lanes of simdgroup 0 each fold their own row from threadgroup memory (row stride 129 floats,
    ; so the sixteen lanes read sixteen banks), while the 64 threads of simdgroups 1..2 load and dequantize
    ; the NEXT 128-column step — four blocks a row, one block a thread — and hold the step after that in
    ; registers, so a load is issued a whole step before its products are needed. Same products, same order,
    ; `p + acc`, j counting down. Dispatch: mode 1, groups = ceil(rows / 16), 96 threads a group; rows any
    ; (a lane past the last row folds nothing), cols a multiple of 128. ---
    (defn q80-tg4-fold (k acc)
        (if (lt k 0) acc
            (q80-tg4-fold (sub k 1) (str_concat acc (str_concat "acc = pv[ci & 1u][lane][" (str_concat (int_to_str k) "u] + acc; "))))))
    (defn q80-tg4-stage ()
        "float d = float(as_type<half>(hb[0])); for (uint e = 0u; e < 32u; e += 2u) { ushort two = hb[1u + e / 2u]; uint j = cb * 32u + e; pv[cs & 1u][lane][sub * 32u + e] = (d * float(q6k_s8(int(two & 0xFFu)))) * float(x[j]); pv[cs & 1u][lane][sub * 32u + e + 1u] = (d * float(q6k_s8(int(two >> 8)))) * float(x[j + 1u]); } ")
    ; the kernel, generic over its signature, the prefix that names `qb`, `rows`, `row` and the output, and the
    ; epilogue that stores the row's fold. Every variant below is THIS text with a different prefix/epilogue —
    ; the fold is one fold.
    (defn q80-tg4-kernel (fname sig prefix epilogue)
        (str_concat "kernel void "
        (str_concat fname
        (str_concat sig
        (str_concat " { threadgroup float pv[2][16][129]; uint nb = cols / 32u; uint ns = cols / 128u; uint u = (t >= 32u) ? (t - 32u) : 0u; uint lane = (t < 32u) ? t : (u & 15u); uint sub = u / 16u; "
        (str_concat prefix
        (str_concat " bool fold = (t < 32u) && (lane < 16u) && (row < rows); bool load = (t >= 32u) && (row < rows); ushort hb[17]; if (load) { uint cb = (ns - 1u) * 4u + sub; device const ushort* hp = (device const ushort*)(qb + (row * nb + cb) * 34u); for (uint q = 0u; q < 17u; q += 1u) hb[q] = hp[q]; } if (load) { uint cs = ns - 1u; uint cb = cs * 4u + sub; "
        (str_concat (q80-tg4-stage)
        (str_concat "if (ns > 1u) { uint cb2 = (ns - 2u) * 4u + sub; device const ushort* hp2 = (device const ushort*)(qb + (row * nb + cb2) * 34u); for (uint q = 0u; q < 17u; q += 1u) hb[q] = hp2[q]; } } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); float acc = 0.0f; uint ci = ns; while (ci > 0u) { ci -= 1u; if (load && ci > 0u) { uint cs = ci - 1u; uint cb = cs * 4u + sub; "
        (str_concat (q80-tg4-stage)
        (str_concat "if (cs > 0u) { uint cb2 = (cs - 1u) * 4u + sub; device const ushort* hp2 = (device const ushort*)(qb + (row * nb + cb2) * 34u); for (uint q = 0u; q < 17u; q += 1u) hb[q] = hp2[q]; } } if (fold) { "
        (str_concat (q80-tg4-fold 127 "")
        (str_concat "} metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); } if (fold) { "
        (str_concat epilogue " } }"))))))))))))))
    (defn q80-matvec-tg4-body (fname)
        (q80-tg4-kernel fname
            " (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], uint gi [[threadgroup_position_in_grid]], uint t [[thread_position_in_threadgroup]])"
            "uint row = gi * 16u + lane;"
            "y[row] = acc;"))

    ; --- kernel 9: the same fold with the residual add in its epilogue. form_add_f32 computes y = a + b with a
    ; the residual stream and b the projection; here `y[row] = r[row] + acc` is that add, the same two operands
    ; in the same order, and the projection never lands in a buffer of its own. In place on r (each row is read
    ; and written by its own lane alone). ---
    (defn q80-matvec-tg4-add-body (fname)
        (q80-tg4-kernel fname
            " (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], device const float* r [[buffer(3)]], constant uint& rows [[buffer(4)]], constant uint& cols [[buffer(5)]], uint gi [[threadgroup_position_in_grid]], uint t [[thread_position_in_threadgroup]])"
            "uint row = gi * 16u + lane;"
            "y[row] = r[row] + acc;"))

    ; --- kernel 10: three tensors over one input in ONE dispatch (q, k, v), the group index choosing the tensor,
    ; each output at a row offset — so k and v land straight in their caches at the position's row and the
    ; cache copies vanish. Groups: ceil(rows0/16) + ceil(rows1/16) + ceil(rows2/16). ---
    (defn q80-matvec-tg4x3-body (fname)
        (q80-tg4-kernel fname
            " (device const uchar* qb0 [[buffer(0)]], device const uchar* qb1 [[buffer(1)]], device const uchar* qb2 [[buffer(2)]], device const float* x [[buffer(3)]], device float* y0 [[buffer(4)]], device float* y1 [[buffer(5)]], device float* y2 [[buffer(6)]], constant uint& rows0 [[buffer(7)]], constant uint& rows1 [[buffer(8)]], constant uint& rows2 [[buffer(9)]], constant uint& cols [[buffer(10)]], constant uint& yoff1 [[buffer(11)]], constant uint& yoff2 [[buffer(12)]], uint gi [[threadgroup_position_in_grid]], uint t [[thread_position_in_threadgroup]])"
            "uint g0 = (rows0 + 15u) / 16u; uint g1 = (rows1 + 15u) / 16u; uint sel = (gi < g0) ? 0u : ((gi < g0 + g1) ? 1u : 2u); uint gl = (sel == 0u) ? gi : ((sel == 1u) ? (gi - g0) : (gi - g0 - g1)); uint rows = (sel == 0u) ? rows0 : ((sel == 1u) ? rows1 : rows2); device const uchar* qb = (sel == 0u) ? qb0 : ((sel == 1u) ? qb1 : qb2); device float* y = (sel == 0u) ? y0 : ((sel == 1u) ? y1 : y2); uint yoff = (sel == 0u) ? 0u : ((sel == 1u) ? yoff1 : yoff2); uint row = gl * 16u + lane;"
            "y[yoff + row] = acc;"))

    ; --- kernel 11: gate and up over one input, and the SwiGLU, in ONE dispatch. Sixteen rows a group as
    ; before, but the folder simdgroup uses all 32 lanes: lane i folds gate row i, lane 16+i folds up row i;
    ; 64 loaders stage two blocks a row a step (pv[2][32][65]), holding the next step in registers. The
    ; epilogue is form_swiglu_f32's own line — `sig = 1/(1 + fexp(-1*gv)); sl = gv*sig; y = sl*u` — on lane
    ; i with the up fold handed across threadgroup memory. Neither gate nor up lands in a buffer. Needs
    ; fexp, so a unit emits it AFTER the transcendental spine. cols a multiple of 64. ---
    (defn q80-glu-fold (k acc)
        (if (lt k 0) acc
            (q80-glu-fold (sub k 1) (str_concat acc (str_concat "acc = pv[ci & 1u][lane][" (str_concat (int_to_str k) "u] + acc; "))))))
    (defn q80-glu-stage ()
        "float d = float(as_type<half>(hb[0])); for (uint e = 0u; e < 32u; e += 2u) { ushort two = hb[1u + e / 2u]; uint j = cb * 32u + e; pv[cs & 1u][lane][sub * 32u + e] = (d * float(q6k_s8(int(two & 0xFFu)))) * float(x[j]); pv[cs & 1u][lane][sub * 32u + e + 1u] = (d * float(q6k_s8(int(two >> 8)))) * float(x[j + 1u]); } ")
    (defn q80-matvec-glu-body (fname)
        (str_concat "kernel void "
        (str_concat fname
        (str_concat " (device const uchar* qg [[buffer(0)]], device const uchar* qu [[buffer(1)]], device const float* x [[buffer(2)]], device float* y [[buffer(3)]], constant uint& rows [[buffer(4)]], constant uint& cols [[buffer(5)]], uint gi [[threadgroup_position_in_grid]], uint t [[thread_position_in_threadgroup]]) { threadgroup float pv[2][32][65]; threadgroup float upv[16]; uint nb = cols / 32u; uint ns = cols / 64u; uint u = (t >= 32u) ? (t - 32u) : 0u; uint lane = (t < 32u) ? t : (u & 31u); uint sub = u / 32u; uint row = gi * 16u + (lane & 15u); device const uchar* qb = (lane < 16u) ? qg : qu; bool fold = (t < 32u) && (row < rows); bool load = (t >= 32u) && (row < rows); ushort hb[17]; if (load) { uint cb = (ns - 1u) * 2u + sub; device const ushort* hp = (device const ushort*)(qb + (row * nb + cb) * 34u); for (uint q = 0u; q < 17u; q += 1u) hb[q] = hp[q]; } if (load) { uint cs = ns - 1u; uint cb = cs * 2u + sub; "
        (str_concat (q80-glu-stage)
        (str_concat "if (ns > 1u) { uint cb2 = (ns - 2u) * 2u + sub; device const ushort* hp2 = (device const ushort*)(qb + (row * nb + cb2) * 34u); for (uint q = 0u; q < 17u; q += 1u) hb[q] = hp2[q]; } } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); float acc = 0.0f; uint ci = ns; while (ci > 0u) { ci -= 1u; if (load && ci > 0u) { uint cs = ci - 1u; uint cb = cs * 2u + sub; "
        (str_concat (q80-glu-stage)
        (str_concat "if (cs > 0u) { uint cb2 = (cs - 1u) * 2u + sub; device const ushort* hp2 = (device const ushort*)(qb + (row * nb + cb2) * 34u); for (uint q = 0u; q < 17u; q += 1u) hb[q] = hp2[q]; } } if (fold) { "
        (str_concat (q80-glu-fold 63 "")
                    "} metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); } if (fold && lane >= 16u) { upv[lane - 16u] = acc; } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); if (fold && lane < 16u) { float gv = acc; float sig = 1.0f / (1.0f + fexp(-1.0f * gv)); float sl = gv * sig; y[row] = sl * upv[lane]; } }")))))))))

    ; --- the emitted forms. `q80-msl-appendix` is what a carrier that ALREADY emitted q6k-msl.fk's
    ; spine appends; `q80-msl-unit` is the self-contained form, for a caller that wants Q8_0 alone. ---
    (defn q80-msl-appendix (dname mname lname)
        (str_concat (q80-msl-weight)
        (str_concat (q80-dequant-body dname)
        (str_concat (q80-matvec-body mname)
                    (q80-matvec-lane-body lname)))))
    (defn q80-msl-unit (dname mname lname)
        (str_concat (q80-msl-spine) (q80-msl-appendix dname mname lname)))

    0)
