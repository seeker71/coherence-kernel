; form-cli-peer-grounded-symbol-answer.fk -- one explicit symbol and question
; cross a caller-born snapshot into an attributed current-source observation,
; then, and only then, into the existing direct local-model user turn.
;
; Input body grammar: <symbol> :: <question>
; The symbol is a coordinate, never a path. Its one/choice/nothing result is
; retained before the current-source door runs. The direct model sees only a
; successful typed source observation and cannot select a filesystem target.
;
; preludes: form-stdlib/form-cli-peer-direct-answer-action.fk form-stdlib/form-cli-peer-local-source-answer.fk form-stdlib/form-cli-heed-current-source.fk
; Proven by: form-stdlib/tests/form-cli-peer-grounded-symbol-answer-band.fk

(do
    ; result = session symbol-result source-observation direct-result elapsed
    ;          signal reason. `nothing` in either evidence seat remains whole.
    (defn fcpagsa-version () "form-cli-peer-grounded-symbol-answer-v1")
    (defn fcpagsa-result
        (session symbol-result source-observation direct-result elapsed-ms signal reason)
        (list (fcpagsa-version) session symbol-result source-observation
              direct-result elapsed-ms signal reason))
    (defn fcpagsa-session (r) (nth r 1))
    (defn fcpagsa-symbol-result (r) (nth r 2))
    (defn fcpagsa-source-observation (r) (nth r 3))
    (defn fcpagsa-direct-result (r) (nth r 4))
    (defn fcpagsa-elapsed-ms (r) (nth r 5))
    (defn fcpagsa-signal (r) (nth r 6))
    (defn fcpagsa-reason (r) (nth r 7))
    (defn fcpagsa-result? (r)
        (if (nothing? r) 0
            (if (not (eq (len r) 8)) 0
                (str_eq (nth r 0) (fcpagsa-version)))))

    (defn fcpagsa-delimiter () " :: ")
    ; task = status symbol question reason. No implied question shape is
    ; manufactured from a missing delimiter or empty side.
    (defn fcpagsa-task (text)
        (do
            (let at (str_find text (fcpagsa-delimiter) 0))
            (if (or (nothing? text) (lt at 1))
                (list "choice" "" "" "ground-requires-symbol-delimiter-question")
                (do
                    (let question-at (add at (str_len (fcpagsa-delimiter))))
                    (let symbol (substring text 0 at))
                    (let question (substring text question-at (str_len text)))
                    (if (or (eq (str_len symbol) 0) (eq (str_len question) 0))
                        (list "choice" symbol question
                            "ground-requires-nonempty-symbol-and-question")
                        (list "value" symbol question "ground-task-ready"))))))
    (defn fcpagsa-task-status (task) (nth task 0))
    (defn fcpagsa-task-symbol (task) (nth task 1))
    (defn fcpagsa-task-question (task) (nth task 2))
    (defn fcpagsa-task-reason (task) (nth task 3))
    (defn fcpagsa-query-frame (question)
        (str_concat (fkqt-open) (str_concat question (fkqt-close))))
    (defn fcpagsa-symbol-name (symbol-result)
        (sof-query-name (fcpssa-query symbol-result)))
    (defn fcpagsa-source-path (symbol-result)
        (do
            (let paths (fcpssa-paths (fcpssa-query symbol-result)))
            (if (eq (len paths) 1) (head paths) "")))
    (defn fcpagsa-observation-status (observation)
        (if (nothing? observation) "nothing" (nth observation 0)))
    (defn fcpagsa-observation-span (observation)
        (if (nothing? observation) "" (nth observation 1)))
    (defn fcpagsa-observation-reason (observation)
        (if (nothing? observation) "source-observation-absent" (nth observation 2)))

    ; A compact streaming cursor for a single Form definition. It tracks
    ; strings, escapes and line comments; parentheses inside either cannot
    ; close the definition. It has no byte ceiling: the resident model's own
    ; declared context is the later, observable capacity boundary.
    (defn fcpagsa-defn-end-loop (text at depth quoted escaped commented)
        (if (ge at (str_len text)) -1
            (do
                (let byte (str_byte_at text at))
                (if (eq commented 1)
                    (fcpagsa-defn-end-loop text (add at 1) depth 0 0
                        (if (eq byte 10) 0 1))
                    (if (eq quoted 1)
                        (if (eq escaped 1)
                            (fcpagsa-defn-end-loop text (add at 1) depth 1 0 0)
                            (if (eq byte 92)
                                (fcpagsa-defn-end-loop text (add at 1) depth 1 1 0)
                                (fcpagsa-defn-end-loop text (add at 1) depth
                                    (if (eq byte 34) 0 1) 0 0)))
                        (if (eq byte 59)
                            (fcpagsa-defn-end-loop text (add at 1) depth 0 0 1)
                            (if (eq byte 34)
                                (fcpagsa-defn-end-loop text (add at 1) depth 1 0 0)
                                (if (eq byte 40)
                                    (fcpagsa-defn-end-loop text (add at 1)
                                        (add depth 1) 0 0 0)
                                    (if (eq byte 41)
                                        (if (eq depth 1) (add at 1)
                                            (fcpagsa-defn-end-loop text (add at 1)
                                                (sub depth 1) 0 0 0))
                                        (fcpagsa-defn-end-loop text (add at 1)
                                            depth 0 0 0))))))))))
    (defn fcpagsa-definition-slice (source symbol)
        (do
            (let marker (str_concat "(defn " (str_concat symbol " ")))
            (let start (str_find source marker 0))
            (if (lt start 0) ""
                (do
                    (let end (fcpagsa-defn-end-loop source start 0 0 0 0))
                    (if (le end start) "" (substring source start end))))))
    (defn fcpagsa-observation-line (acc key value)
        (str_concat acc (str_concat "\n" (str_concat key (str_concat "=" value)))))
    (defn fcpagsa-render-definition (symbol current definition)
        (do
            (let escaped (fkqt-observation-escape definition))
            (let r0 "<|form:grounded-symbol-observation|>")
            (let r1 (fcpagsa-observation-line r0 "schema"
                (fcpagsa-version)))
            (let r2 (fcpagsa-observation-line r1 "status" "hit"))
            (let r3 (fcpagsa-observation-line r2 "reason"
                "current-symbol-definition-hit"))
            (let r4 (fcpagsa-observation-line r3 "symbol" symbol))
            (let r5 (fcpagsa-observation-line r4 "source-path"
                (fkss-source-path current)))
            (let r6 (fcpagsa-observation-line r5 "source-artifact"
                (fkss-source-id-of current)))
            (let r7 (fcpagsa-observation-line r6 "source-size"
                (int_to_str (fkss-source-size current))))
            (let r8 (fcpagsa-observation-line r7 "definition-byte-length"
                (int_to_str (str_len definition))))
            (let r9 (fcpagsa-observation-line r8 "model-executed" "0"))
            (str_concat r9 (str_concat "\ndefinition:\n"
                (str_concat escaped
                    "\n<|/form:grounded-symbol-observation|>")))))
    ; The source path arrives only from a one-valued caller snapshot. The
    ; existing current-source organ verifies its source identity; an immediate
    ; post-read identity check refuses a mid-read mutation. Global scan fuel
    ; remains zero: a symbol miss never becomes a search fallback.
    (defn fcpagsa-observe-current (source-ctx symbol-result question)
        (do
            (let root (if (nothing? source-ctx) "" (nth source-ctx 0)))
            (let path (fcpagsa-source-path symbol-result))
            (let symbol (fcpagsa-symbol-name symbol-result))
            (if (or (str_eq root "") (str_eq path ""))
                (list "nothing" "" "grounded-source-path-absent")
                (do
                    (let atoms (fhcs-atoms question))
                    (if (nil? atoms)
                        (list "nothing" "" "grounded-source-no-query-atoms")
                        (do
                            (let current (fhcs-path-result-with-reason root path atoms
                                "current-symbol-snapshot-path-hit"))
                            (if (not (str_eq (fkss-status current) "hit"))
                                (list (fkss-status current) "" (fkss-reason current))
                                (do
                                    (let full (fs-path-join root path))
                                    (let source (read_file full))
                                    (if (nothing? source)
                                        (list "nothing" "" "grounded-source-read-absent")
                                        (do
                                            (let current-id (fkss-source-id full))
                                            (let current-size (fs-stat-size full))
                                            (let definition (fcpagsa-definition-slice source symbol))
                                            (if (or (not (str_eq current-id
                                                                    (fkss-source-id-of current)))
                                                    (not (eq current-size
                                                             (fkss-source-size current))))
                                                (list "stale" ""
                                                    "grounded-source-changed-during-read")
                                                (if (str_eq definition "")
                                                    (list "nothing" ""
                                                        "grounded-symbol-definition-absent")
                                                    (list "hit" (fcpagsa-render-definition
                                                        symbol current definition)
                                                        "current-symbol-definition-hit")))))))))))))
    (defn fcpagsa-model-task (question observation)
        (str_concat
            "Use only the following validated Form current-source observation. If it does not establish the requested fact, say: source observation insufficient. Do not invent a path or fact.\n"
            (str_concat (fcpagsa-observation-span observation)
                (str_concat "\nQuestion: " question))))
    (defn fcpagsa-refused (session reason)
        (fcpagsa-result session (nothing) (nothing) (nothing) 0 "choice" reason))
    (defn fcpagsa-from-symbol (session symbol-result source-ctx question turn started)
        (if (not (str_eq (fcpssa-signal symbol-result) "value"))
            (fcpagsa-result session symbol-result (nothing) (nothing)
                (sub (now_unix_ms) started) (fcpssa-signal symbol-result)
                (fcpssa-reason symbol-result))
            (do
                (let observation (fcpagsa-observe-current source-ctx symbol-result question))
                (if (not (str_eq (fcpagsa-observation-status observation) "hit"))
                    (fcpagsa-result session symbol-result observation (nothing)
                        (sub (now_unix_ms) started)
                        (fcpagsa-observation-status observation)
                        (fcpagsa-observation-reason observation))
                    (do
                        (let direct (fcpdaa-run session "direct-answer"
                            (fcpagsa-model-task question observation)
                            (fcpdaa-remaining-capacity session)))
                        (fcpagsa-result (fcpdaa-session direct) symbol-result
                            observation direct (sub (now_unix_ms) started)
                            (fcpdaa-signal direct) (fcpdaa-reason direct)))))))
    (defn fcpagsa-run (session task-text source-ctx turn)
        (do
            (let task (fcpagsa-task task-text))
            (if (not (str_eq (fcpagsa-task-status task) "value"))
                (fcpagsa-refused session (fcpagsa-task-reason task))
                (do
                    (let started (now_unix_ms))
                    (let symbol-result (fcpssa-run session "source-symbol"
                        (fcpagsa-task-symbol task) source-ctx
                        (fcpalsa-source-epoch source-ctx)))
                    (fcpagsa-from-symbol session symbol-result source-ctx
                        (fcpagsa-task-question task) turn started)))))
    (defn fcpagsa-lookup-count (result)
        (if (nothing? (fcpagsa-symbol-result result)) 0
            (if (str_eq (fcpssa-signal (fcpagsa-symbol-result result)) "value")
                (if (nothing? (fcpagsa-source-observation result)) 1 2) 1)))
    (defn fcpagsa-tool-status (result)
        (do
            (let symbol (if (nothing? (fcpagsa-symbol-result result)) "nothing"
                (fcpssa-signal (fcpagsa-symbol-result result))))
            (let source (fcpagsa-observation-status
                (fcpagsa-source-observation result)))
            (let model (if (nothing? (fcpagsa-direct-result result)) "not-entered"
                (fcpdaa-signal (fcpagsa-direct-result result))))
            (str_concat "symbol=" (str_concat symbol
                (str_concat ";current-source=" (str_concat source
                (str_concat ";model=" (str_concat model
                (str_concat ";lookups="
                    (int_to_str (fcpagsa-lookup-count result)))))))))))
    (defn fcpagsa-response (result)
        (if (nothing? (fcpagsa-direct-result result))
            (if (nothing? (fcpagsa-symbol-result result)) ""
                (fcpssa-response (fcpagsa-symbol-result result)))
            (fcpdaa-response (fcpagsa-direct-result result))))
    (defn fcpagsa-lifecycle (result)
        (if (nothing? (fcpagsa-direct-result result))
            "source-symbol,current-source,release"
            (str_concat "source-symbol,current-source,"
                (fcpdaa-lifecycle (fcpagsa-direct-result result)))))
    (defn fcpagsa-peer (result)
        (fcpa-result-full (fcpagsa-session result) result
            (fcpagsa-response result) (fcpagsa-elapsed-ms result) 0
            "grounded-answer" 0 (fcpagsa-tool-status result)
            "form-native-current-source-metal-jit" 0 (nothing) 0 0
            (fcpagsa-lifecycle result) (fcpagsa-lookup-count result)))
    0)
