//////////////////////////////////////////////////////////////////////
//
// form-glass-choice-ui.bml — the choice view: what stands to be chosen,
// what each option is worth, how much of what was offered got through,
// and what the sequence asks for next.
//
// A reader does not only read this view.  `g` steps the cursor to the next
// option, `y` takes the one under it, `w` holds it — the body's third
// outcome, silence, the offer left standing.  A take or a hold leaves the
// glass as one command in the choice publisher's inbox; the choice organ
// consumes it and republishes the point with the outcome appended, so the
// ledger moves in the frame rather than in the view, and the next frame
// shows it moved.  The view itself stays pure: it folds only what the
// samples carry.
//
// Authority: form-stdlib/bml/form-glass-live-ui.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-dashboard.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassChoiceUI {
        field FGCHShardSchema = "form-glass-choice-ui-v1";
        field FGCHPointSchema = "form-choice-point-v1";
        field FGCHOptionSchema = "form-choice-option-v1";
        field FGCHOutcomeSchema = "form-choice-outcome-v1";
        field FGCHFindingSchema = "form-choice-finding-v1";
        field FGCHPlaySchema = "form-choice-play-v1";
        field FGCHPublisher = "choice";
        field FGCHFrameDoor = "gift:choice";
        // A share is a percentage of what was offered.  Never offered is -1 and
        // never 0: a point nobody has ever asked is dark, not refused.
        field FGCHNeverOffered = -1;
        // Flow that exists and is narrow is a corridor; it asks to be widened.
        field FGCHCorridorPct = 34;
        // Offers reaching a point and being turned away this often is a wound.
        field FGCHRestrictingPct = 40;
        // An offer held this often, or waited on this long, has stalled.
        field FGCHStalledPct = 50;
        field FGCHStalledMs = 600;
        field FGCHBarWidth = 12;

        // ---- the cells ----
        def fgch-option(id, offer, cost, reward) = list(FGCHOptionSchema(), id, offer, cost, reward);
        def fgch-option?(o) = if nothing?(o) then 0 else if not(eq(len(o), 5)) then 0 else if str_eq(head(o), FGCHOptionSchema()) then 1 else 0;
        def fgch-option-id(o) = nth(o, 1);
        def fgch-option-offer(o) = nth(o, 2);
        def fgch-option-cost(o) = nth(o, 3);
        def fgch-option-reward(o) = nth(o, 4);
        def fgch-option-worth(o) = sub(fgch-option-reward(o), fgch-option-cost(o));

        def fgch-outcome(optionId, kind, waitMs) = list(FGCHOutcomeSchema(), optionId, kind, waitMs);
        def fgch-outcome?(x) = if nothing?(x) then 0 else if not(eq(len(x), 4)) then 0 else if str_eq(head(x), FGCHOutcomeSchema()) then 1 else 0;
        def fgch-outcome-option(x) = nth(x, 1);
        def fgch-outcome-kind(x) = nth(x, 2);
        def fgch-outcome-wait(x) = nth(x, 3);

        def fgch-point(id, question, options, ledger) = list(FGCHPointSchema(), id, question, options, ledger);
        def fgch-point?(p) = if nothing?(p) then 0 else if not(eq(len(p), 5)) then 0 else if str_eq(head(p), FGCHPointSchema()) then 1 else 0;
        def fgch-point-id(p) = nth(p, 1);
        def fgch-point-question(p) = nth(p, 2);
        def fgch-point-options(p) = nth(p, 3);
        def fgch-point-ledger(p) = nth(p, 4);

        // ---- the shares a point's ledger carries ----
        def fgch-count-kind(ledger, kind) = if eq(len(ledger), 0) then 0 else add(if str_eq(fgch-outcome-kind(head(ledger)), kind) then 1 else 0, fgch-count-kind(tail(ledger), kind));
        def fgch-sum-wait(ledger) = if eq(len(ledger), 0) then 0 else add(fgch-outcome-wait(head(ledger)), fgch-sum-wait(tail(ledger)));
        def fgch-offers(point) = len(fgch-point-ledger(point));
        def fgch-share(part, whole) = if le(whole, 0) then FGCHNeverOffered() else div(mul(part, 100), whole);
        def fgch-flow(point) = fgch-share(fgch-count-kind(fgch-point-ledger(point), "taken"), fgch-offers(point));
        def fgch-restriction(point) = fgch-share(fgch-count-kind(fgch-point-ledger(point), "restricted"), fgch-offers(point));
        def fgch-holding(point) = fgch-share(fgch-count-kind(fgch-point-ledger(point), "held"), fgch-offers(point));
        def fgch-mean-wait(point) = if eq(fgch-offers(point), 0) then FGCHNeverOffered() else div(fgch-sum-wait(fgch-point-ledger(point)), fgch-offers(point));
        // Ripening: offered, never taken, mostly held — the offer is standing, not refused.
        def fgch-ripening?(point) = if eq(fgch-offers(point), 0) then 0 else if gt(fgch-count-kind(fgch-point-ledger(point), "taken"), 0) then 0 else if ge(fgch-holding(point), FGCHStalledPct()) then 1 else 0;

        // ---- worth: a point is worth its best option; a sequence is worth its points ----
        def fgch-best-worth-go(options, best) = if eq(len(options), 0) then best else if gt(fgch-option-worth(head(options)), best) then fgch-best-worth-go(tail(options), fgch-option-worth(head(options))) else fgch-best-worth-go(tail(options), best);
        def fgch-point-worth(point) = if eq(len(fgch-point-options(point)), 0) then 0 else fgch-best-worth-go(tail(fgch-point-options(point)), fgch-option-worth(head(fgch-point-options(point))));
        def fgch-total-worth(points) = if eq(len(points), 0) then 0 else add(fgch-point-worth(head(points)), fgch-total-worth(tail(points)));

        // ---- the sequence's flow is its narrowest gate ----
        // A step nobody has ever offered is tighter than any measured percentage:
        // it wins the gate, and the sequence reads never-offered rather than a number.
        def fgch-tighter?(a, b) = if eq(fgch-flow(a), fgch-flow(b)) then 0 else if eq(fgch-flow(a), FGCHNeverOffered()) then 1 else if eq(fgch-flow(b), FGCHNeverOffered()) then 0 else if lt(fgch-flow(a), fgch-flow(b)) then 1 else 0;
        def fgch-narrowest-go(points, held) = if eq(len(points), 0) then held else if eq(fgch-tighter?(head(points), held), 1) then fgch-narrowest-go(tail(points), head(points)) else fgch-narrowest-go(tail(points), held);
        def fgch-narrowest(points) = if eq(len(points), 0) then list() else fgch-narrowest-go(tail(points), head(points));
        def fgch-most-restricting-go(points, held) = if eq(len(points), 0) then held else if gt(fgch-restriction(head(points)), fgch-restriction(held)) then fgch-most-restricting-go(tail(points), head(points)) else fgch-most-restricting-go(tail(points), held);
        def fgch-most-restricting(points) = if eq(len(points), 0) then list() else fgch-most-restricting-go(tail(points), head(points));

        // ---- findings: a gap asks to be nourished, a wound asks to be healed ----
        def fgch-finding(kind, pointId, measure, asks) = list(FGCHFindingSchema(), kind, pointId, measure, asks);
        def fgch-finding?(f) = if nothing?(f) then 0 else if not(eq(len(f), 5)) then 0 else if str_eq(head(f), FGCHFindingSchema()) then 1 else 0;
        def fgch-finding-kind(f) = nth(f, 1);
        def fgch-finding-point(f) = nth(f, 2);
        def fgch-finding-measure(f) = nth(f, 3);
        def fgch-finding-asks(f) = nth(f, 4);
        def fgch-gap?(f) = if str_eq(fgch-finding-kind(f), "gap-corridor") then 1 else if str_eq(fgch-finding-kind(f), "gap-dark") then 1 else 0;
        def fgch-wound?(f) = if eq(fgch-gap?(f), 1) then 0 else 1;
        def fgch-gaps(findings) = if eq(len(findings), 0) then list() else if eq(fgch-gap?(head(findings)), 1) then cons(head(findings), fgch-gaps(tail(findings))) else fgch-gaps(tail(findings));
        def fgch-wounds(findings) = if eq(len(findings), 0) then list() else if eq(fgch-wound?(head(findings)), 1) then cons(head(findings), fgch-wounds(tail(findings))) else fgch-wounds(tail(findings));

        def fgch-dark-finding(point) = fgch-finding("gap-dark", fgch-point-id(point), "never offered", str_concat("offer it once: ", fgch-point-question(point)));
        def fgch-corridor-finding(point) = fgch-finding("gap-corridor", fgch-point-id(point), fgd-cat(list("flow ", int_to_str(fgch-flow(point)), "%")), "widen it: little of what is offered here gets through");
        def fgch-restricting-finding(point) = fgch-finding("wound-restricting", fgch-point-id(point), fgd-cat(list("restricted ", int_to_str(fgch-restriction(point)), "%")), "heal the restrictor: offers arrive and are turned away");
        def fgch-stalled-finding(point) = fgch-finding("wound-stalled", fgch-point-id(point), fgd-cat(list("held ", int_to_str(fgch-holding(point)), "% wait ", int_to_str(fgch-mean-wait(point)), "ms")), "answer it: the offer stands and nothing decides");
        def fgch-point-findings(point) {
            let dark = if eq(fgch-flow(point), FGCHNeverOffered()) then list(fgch-dark-finding(point)) else list();
            let corridor = if and(gt(fgch-flow(point), 0), lt(fgch-flow(point), FGCHCorridorPct())) then list(fgch-corridor-finding(point)) else list();
            let restricting = if ge(fgch-restriction(point), FGCHRestrictingPct()) then list(fgch-restricting-finding(point)) else list();
            let stalled = if or(ge(fgch-holding(point), FGCHStalledPct()), ge(fgch-mean-wait(point), FGCHStalledMs())) then list(fgch-stalled-finding(point)) else list();
            append(dark, append(corridor, append(restricting, stalled)));
        }
        def fgch-findings(points) = if eq(len(points), 0) then list() else append(fgch-point-findings(head(points)), fgch-findings(tail(points)));

        // ---- the play: the sequence, its gate, its most restricting step, its worth ----
        def fgch-play(points) {
            let gate = fgch-narrowest(points);
            let restricting = fgch-most-restricting(points);
            list(FGCHPlaySchema(), points, if eq(len(gate), 0) then FGCHNeverOffered() else fgch-flow(gate), if eq(len(gate), 0) then "none" else fgch-point-id(gate), if eq(len(restricting), 0) then "none" else fgch-point-id(restricting), fgch-total-worth(points), fgch-findings(points));
        }
        def fgch-play-steps(p) = nth(p, 1);
        def fgch-play-flow(p) = nth(p, 2);
        def fgch-play-gate(p) = nth(p, 3);
        def fgch-play-restricting(p) = nth(p, 4);
        def fgch-play-worth(p) = nth(p, 5);
        def fgch-play-findings(p) = nth(p, 6);

        // The choice most worth putting in front of a reader: the first step that
        // asks for something, and where nothing asks, the richest step.
        def fgch-first-asking(points) = if eq(len(points), 0) then list() else if gt(len(fgch-point-findings(head(points))), 0) then head(points) else fgch-first-asking(tail(points));
        def fgch-richest-go(points, held) = if eq(len(points), 0) then held else if gt(fgch-point-worth(head(points)), fgch-point-worth(held)) then fgch-richest-go(tail(points), head(points)) else fgch-richest-go(tail(points), held);
        def fgch-next-choice(points) {
            let asking = fgch-first-asking(points);
            if gt(len(asking), 0) then asking else if eq(len(points), 0) then list() else fgch-richest-go(tail(points), head(points));
        }

        // ---- the cursor: one slot per (point, option) in reading order ----
        // The slot number rides the control state's selection as "choice.<n>", so
        // walking the sequence owes no new state field.
        def fgch-point-slots(point, options) = if eq(len(options), 0) then list() else cons(list(point, head(options)), fgch-point-slots(point, tail(options)));
        def fgch-slots(points) = if eq(len(points), 0) then list() else append(fgch-point-slots(head(points), fgch-point-options(head(points))), fgch-slots(tail(points)));
        def fgch-cursor-text(n) = str_concat("choice.", int_to_str(n));
        def fgch-cursor?(text) = if lt(str_len(text), 8) then 0 else if str_eq(substring(text, 0, 7), "choice.") then 1 else 0;
        def fgch-cursor-number(text) = if eq(fgch-cursor?(text), 1) then str_to_int(substring(text, 7, str_len(text))) else 0;
        // The first step from a selection that is not yet a cursor lands on the first slot.
        def fgch-cursor-step(text) = if eq(fgch-cursor?(text), 1) then fgch-cursor-text(add(fgch-cursor-number(text), 1)) else fgch-cursor-text(0);
        def fgch-wrap(n, count) = if le(count, 0) then 0 else sub(n, mul(div(n, count), count));
        def fgch-cursor-at(points, text) = fgch-wrap(fgch-cursor-number(text), len(fgch-slots(points)));
        def fgch-cursor-slot(points, text) {
            let slots = fgch-slots(points);
            if eq(len(slots), 0) then list() else nth(slots, fgch-wrap(fgch-cursor-number(text), len(slots)));
        }

        // ---- the outcome the reader writes, and the ledger it moves ----
        def fgch-outcome-command(pointId, optionId, kind, waitMs) = fgd-cat(list("outcome|", pointId, "|", optionId, "|", kind, "|", int_to_str(waitMs)));
        def fgch-command-fields(command) = split-on(command, "|");
        def fgch-command-outcome(command) {
            let f = fgch-command-fields(command);
            if not(eq(len(f), 5)) then list() else if not(str_eq(head(f), "outcome")) then list() else fgch-outcome(nth(f, 2), nth(f, 3), str_to_int(nth(f, 4)));
        }
        def fgch-command-point(command) {
            let f = fgch-command-fields(command);
            if eq(len(f), 5) then nth(f, 1) else "";
        }
        def fgch-point-with(point, outcome) = fgch-point(fgch-point-id(point), fgch-point-question(point), fgch-point-options(point), append(fgch-point-ledger(point), list(outcome)));
        def fgch-apply-go(points, id, outcome) = if eq(len(points), 0) then list() else if str_eq(fgch-point-id(head(points)), id) then cons(fgch-point-with(head(points), outcome), fgch-apply-go(tail(points), id, outcome)) else cons(head(points), fgch-apply-go(tail(points), id, outcome));
        def fgch-apply-outcome(points, command) {
            let outcome = fgch-command-outcome(command);
            if eq(len(outcome), 0) then points else fgch-apply-go(points, fgch-command-point(command), outcome);
        }
        // The reader's own deliberation is not ours to guess; the wait recorded is
        // the one this body witnessed — offer written to outcome applied.
        def fgch-slot-command(points, cursorText, kind, waitMs) {
            let slot = fgch-cursor-slot(points, cursorText);
            if eq(len(slot), 0) then "" else fgch-outcome-command(fgch-point-id(head(slot)), fgch-option-id(nth(slot, 1)), kind, waitMs);
        }

        // ---- the wire: one sample per point, its channels carrying the point ----
        //   "choice"                              the channel tag
        //   "point|<id>|<question>"
        //   "opt|<id>|<offer>|<cost>|<reward>"    one per option, in reading order
        //   "out|<optionId>|<kind>|<waitMs>"      one per outcome already recorded
        def fgch-entry-kind(entry) = head(split-on(entry, "|"));
        def fgch-wire-option(entry) {
            let f = split-on(entry, "|");
            if not(eq(len(f), 5)) then list() else fgch-option(nth(f, 1), nth(f, 2), str_to_int(nth(f, 3)), str_to_int(nth(f, 4)));
        }
        def fgch-wire-outcome(entry) {
            let f = split-on(entry, "|");
            if not(eq(len(f), 4)) then list() else fgch-outcome(nth(f, 1), nth(f, 2), str_to_int(nth(f, 3)));
        }
        def fgch-wire-options(entries) = if eq(len(entries), 0) then list() else if str_eq(fgch-entry-kind(head(entries)), "opt") then cons(fgch-wire-option(head(entries)), fgch-wire-options(tail(entries))) else fgch-wire-options(tail(entries));
        def fgch-wire-ledger(entries) = if eq(len(entries), 0) then list() else if str_eq(fgch-entry-kind(head(entries)), "out") then cons(fgch-wire-outcome(head(entries)), fgch-wire-ledger(tail(entries))) else fgch-wire-ledger(tail(entries));
        def fgch-wire-head(entries) = if eq(len(entries), 0) then list() else if str_eq(fgch-entry-kind(head(entries)), "point") then split-on(head(entries), "|") else fgch-wire-head(tail(entries));
        def fgch-wire-point(entries) {
            let h = fgch-wire-head(entries);
            if lt(len(h), 3) then list() else fgch-point(nth(h, 1), nth(h, 2), fgch-wire-options(entries), fgch-wire-ledger(entries));
        }
        def fgch-sample-point(sample) = if not(str_eq(fgtm-sample-kind(sample), "choice")) then list() else fgch-wire-point(fgtm-sample-channels(sample));
        def fgch-samples-points(samples) = if eq(len(samples), 0) then list() else if eq(len(fgch-sample-point(head(samples))), 0) then fgch-samples-points(tail(samples)) else cons(fgch-sample-point(head(samples)), fgch-samples-points(tail(samples)));

        // ---- the rendering ----
        def fgch-share-text(v) = if eq(v, FGCHNeverOffered()) then "--" else str_concat(int_to_str(v), "%");
        def fgch-ms-text(v) = if eq(v, FGCHNeverOffered()) then "--" else str_concat(int_to_str(v), "ms");
        def fgch-worth-text(v) = if lt(v, 0) then int_to_str(v) else str_concat("+", int_to_str(v));
        def fgch-share-cells(part, whole, width) = if le(whole, 0) then 0 else fgd-clamp(div(mul(width, part), whole), 0, width);
        // taken # | restricted : | the rest, held and unanswered, . ; never offered is a dash run
        def fgch-bar(point, width) {
            let ledger = fgch-point-ledger(point);
            let taken = fgch-share-cells(fgch-count-kind(ledger, "taken"), len(ledger), width);
            let restricted = fgch-share-cells(fgch-count-kind(ledger, "restricted"), len(ledger), width);
            let rest = fgd-max(0, sub(width, add(taken, restricted)));
            if eq(len(ledger), 0) then fgd-repeat("-", width) else fgd-cat(list(fgd-repeat("#", taken), fgd-repeat(":", restricted), fgd-repeat(".", rest)));
        }
        def fgch-point-style(point) = if eq(fgch-flow(point), FGCHNeverOffered()) then fgd-neutral(96) else if gt(len(fgch-point-findings(point)), 0) then fgd-health() else fgd-ready();
        def fgch-point-text(point, marker, width) = fgd-fit(fgd-cat(list(marker, " ", fgd-pad-right(fgch-point-id(point), 14), " [", fgch-bar(point, FGCHBarWidth()), "] f ", fgd-pad-left(fgch-share-text(fgch-flow(point)), 4), " r ", fgd-pad-left(fgch-share-text(fgch-restriction(point)), 4), " h ", fgd-pad-left(fgch-share-text(fgch-holding(point)), 4), " w ", fgd-pad-left(fgch-ms-text(fgch-mean-wait(point)), 7), "  ", fgch-point-question(point))), width);
        def fgch-option-text(option, marker, width) = fgd-fit(fgd-cat(list(marker, " ", fgd-pad-right(fgch-option-id(option), 14), " worth ", fgd-pad-left(fgch-worth-text(fgch-option-worth(option)), 4), " cost ", fgd-pad-left(int_to_str(fgch-option-cost(option)), 3), " reward ", fgd-pad-left(int_to_str(fgch-option-reward(option)), 3), "  ", fgch-option-offer(option))), width);
        def fgch-finding-text(finding, width) = fgd-fit(fgd-cat(list("  ", fgd-pad-right(fgch-finding-kind(finding), 18), fgd-pad-right(fgch-finding-point(finding), 14), fgd-pad-right(fgch-finding-measure(finding), 22), "asks: ", fgch-finding-asks(finding))), width);
        def fgch-play-text(play, gaps, wounds) = fgd-cat(list("PLAY steps=", int_to_str(len(fgch-play-steps(play))), " flow=", fgch-share-text(fgch-play-flow(play)), " gate=", fgch-play-gate(play), " restricting=", fgch-play-restricting(play), " worth=", fgch-worth-text(fgch-play-worth(play)), " gaps=", int_to_str(len(gaps)), " wounds=", int_to_str(len(wounds))));

        def fgch-option-line(point, option, marker, width) = fgd-segment-line(fgch-option-text(option, marker, width), width, if str_eq(marker, ">") then fgd-title() else fgd-neutral(200), fgd-cat(list("choice.", fgch-point-id(point), ".", fgch-option-id(option))), list("choice", "option"), "declared");
        def fgch-option-lines(point, options, cursor, index, width) = if eq(len(options), 0) then list() else cons(fgch-option-line(point, head(options), if eq(index, cursor) then ">" else " ", width), fgch-option-lines(point, tail(options), cursor, add(index, 1), width));
        def fgch-point-line(point, marker, width) = fgd-segment-line(fgch-point-text(point, marker, width), width, fgch-point-style(point), str_concat("choice.", fgch-point-id(point)), list("choice", "point"), "declared");
        def fgch-point-here?(point, cursor, index) = if lt(cursor, index) then 0 else if ge(cursor, add(index, len(fgch-point-options(point)))) then 0 else 1;
        def fgch-point-block(point, cursor, index, width) = cons(fgch-point-line(point, if eq(fgch-point-here?(point, cursor, index), 1) then "*" else " ", width), fgch-option-lines(point, fgch-point-options(point), cursor, index, width));
        def fgch-point-blocks(points, cursor, index, width) = if eq(len(points), 0) then list() else append(fgch-point-block(head(points), cursor, index, width), fgch-point-blocks(tail(points), cursor, add(index, len(fgch-point-options(head(points)))), width));
        def fgch-finding-line(finding, width) = fgd-segment-line(fgch-finding-text(finding, width), width, if eq(fgch-gap?(finding), 1) then fgd-catalog() else fgd-health(), str_concat("choice.finding.", fgch-finding-point(finding)), list("choice", "finding", fgch-finding-kind(finding)), "declared");
        def fgch-finding-lines(findings, width) = if eq(len(findings), 0) then list() else cons(fgch-finding-line(head(findings), width), fgch-finding-lines(tail(findings), width));
        // No frame stands yet: the view names the door that owes it, never a bare ?
        def fgch-absent-line(width) = fgd-segment-line(fgd-cat(list("? no choice points stand: door=", FGCHFrameDoor(), " publisher=", FGCHPublisher(), " (form-choice-flow gives one sample per point)")), width, fgd-neutral(96), "choice.absent", list("choice", "absent"), "unavailable");

        def fgch-lines(points, cursorText, width, count) {
            let cursor = fgch-cursor-at(points, cursorText);
            let play = fgch-play(points);
            let gaps = fgch-gaps(fgch-play-findings(play));
            let wounds = fgch-wounds(fgch-play-findings(play));
            let title = fgd-title-segment-line(fgd-cat(list("CHOICE POINTS  g step  y take  w hold  cursor=", fgch-cursor-text(cursor))), width, "section.choice");
            let body = if eq(len(points), 0) then list(fgch-absent-line(width)) else fgch-point-blocks(points, cursor, 0, width);
            let playLine = fgd-segment-line(fgd-fit(fgch-play-text(play, gaps, wounds), width), width, fgd-title(), "choice.play", list("choice", "play"), "declared");
            let gapLines = if eq(len(gaps), 0) then list() else cons(fgd-title-segment-line(str_concat("GAPS to nourish: ", int_to_str(len(gaps))), width, "section.choice.gaps"), fgch-finding-lines(gaps, width));
            let woundLines = if eq(len(wounds), 0) then list() else cons(fgd-title-segment-line(str_concat("WOUNDS to heal: ", int_to_str(len(wounds))), width, "section.choice.wounds"), fgch-finding-lines(wounds, width));
            fgd-take(append(list(title), append(body, append(list(playLine), append(gapLines, woundLines)))), count);
        }
        def fgch-view-lines(samples, cursorText, width, count) = fgch-lines(fgch-samples-points(samples), cursorText, width, count);
    }
    0;
}
