//////////////////////////////////////////////////////////////////////
//
// form-glass-choice-ui.bml — the choice view: what stands to be chosen,
// what each option is worth, how much of what was offered got through,
// and what the sequence asks for next.
//
// A reader does not only read this view.  `g` steps the cursor to the next
// option, `y` takes the one under it, `w` holds it — the body's third
// outcome, silence, the offer left standing.  A take or a hold leaves the
// glass as one command in the choice publisher's inbox; the choice organ
// consumes it and republishes the point with the outcome noted, so the
// ledger moves in the frame rather than in the view, and the next frame
// shows it moved.  The view itself stays pure: it folds only what the
// samples carry, and it INVENTS nothing — the findings are the choice
// lane's own, read from the frame's finding rows, so the glass can never
// name a gap the frame did not name or mean something else by the word.
//
// Authority: form-stdlib/form-glass-live-ui.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-dashboard.bml form/form-stdlib/form-choice-flow.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassChoiceUI {
        field FGCHShardSchema = "form-glass-choice-ui-v1";
        field FGCHPointSchema = "form-choice-point-v1";
        field FGCHOptionSchema = "form-choice-option-v1";
        field FGCHOutcomeSchema = "form-choice-outcome-v1";
        field FGCHFindingSchema = "form-choice-finding-v1";
        field FGCHPlaySchema = "form-choice-play-v1";
        field FGCHPublisher = "choices";
        field FGCHFrameDoor = "gift:choices";
        // A share is a percentage of what was offered.  Never offered is -1 and
        // never 0: a point nobody has ever asked is dark, not refused.
        field FGCHNeverOffered = -1;
        field FGCHBarWidth = 12;

        // ---- the cells: the choice lane's own ----
        // The frame carries cells, so the point that arrives here IS the point
        // the lane published -- fcf-point, fcf-option, fcf-ledger -- and this
        // view renders those and keeps no second set beside them: one model,
        // both sides, nothing encoded and nothing decoded. A question and an
        // option's offer are prose, and a cell carries prose, so the view
        // says them.
        def fgch-point(id, question, options, ledger) = fcf-point(id, question, options, ledger);
        def fgch-point?(p) = fcf-point?(p);
        def fgch-point-id(p) = fcf-point-id(p);
        def fgch-point-question(p) = fcf-point-question(p);
        def fgch-point-options(p) = fcf-point-options(p);
        def fgch-point-ledger(p) = fcf-point-ledger(p);
        def fgch-option-id(o) = fcf-option-id(o);
        def fgch-option-offer(o) = fcf-option-offer(o);
        def fgch-option-cost(o) = fcf-option-cost(o);
        def fgch-option-reward(o) = fcf-option-reward(o);
        def fgch-option-worth(o) = (fcf-option-reward(o) - fcf-option-cost(o));

        // ---- the shares a point's ledger carries ----
        def fgch-offers(point) = fcf-ledger-offered(fcf-point-ledger(point));
        def fgch-share(part, whole) = if (whole <= 0) then FGCHNeverOffered() else ((part * 100) / whole);
        def fgch-flow(point) = fcf-flow(point);
        def fgch-restriction(point) = fcf-restriction(point);
        def fgch-holding(point) = fcf-holding(point);
        def fgch-mean-wait(point) = if (fgch-offers(point) <= 0) then FGCHNeverOffered() else (fcf-ledger-wait(fcf-point-ledger(point)) / fgch-offers(point));

        // ---- worth: a point is worth its best option; a sequence is worth its points ----
        def fgch-best-worth-go(options, best) = if ((Comparable) len(options) == 0) then best else if (fgch-option-worth(head(options)) > best) then fgch-best-worth-go(tail(options), fgch-option-worth(head(options))) else fgch-best-worth-go(tail(options), best);
        def fgch-point-worth(point) = if ((Comparable) len(fgch-point-options(point)) == 0) then 0 else fgch-best-worth-go(tail(fgch-point-options(point)), fgch-option-worth(head(fgch-point-options(point))));
        def fgch-total-worth(points) = if ((Comparable) len(points) == 0) then 0 else (fgch-point-worth(head(points)) + fgch-total-worth(tail(points)));

        // ---- the sequence's flow is its narrowest gate ----
        // A step nobody has ever offered is tighter than any measured percentage:
        // it wins the gate, and the sequence reads never-offered rather than a number.
        def fgch-tighter?(a, b) = if ((Comparable) fgch-flow(a) == fgch-flow(b)) then 0 else if ((Comparable) fgch-flow(a) == FGCHNeverOffered()) then 1 else if ((Comparable) fgch-flow(b) == FGCHNeverOffered()) then 0 else if (fgch-flow(a) < fgch-flow(b)) then 1 else 0;
        def fgch-narrowest-go(points, held) = if ((Comparable) len(points) == 0) then held else if ((Comparable) fgch-tighter?(head(points), held) == 1) then fgch-narrowest-go(tail(points), head(points)) else fgch-narrowest-go(tail(points), held);
        def fgch-narrowest(points) = if ((Comparable) len(points) == 0) then [] else fgch-narrowest-go(tail(points), head(points));
        def fgch-most-restricting-go(points, held) = if ((Comparable) len(points) == 0) then held else if (fgch-restriction(head(points)) > fgch-restriction(held)) then fgch-most-restricting-go(tail(points), head(points)) else fgch-most-restricting-go(tail(points), held);
        def fgch-most-restricting(points) = if ((Comparable) len(points) == 0) then [] else fgch-most-restricting-go(tail(points), head(points));

        // ---- findings: a gap asks to be nourished, a wound asks to be healed ----
        def fgch-finding(kind, pointId, measure, asks) = [FGCHFindingSchema(), kind, pointId, measure, asks];
        def fgch-finding?(f) = if nothing?(f) then 0 else if (!((Comparable) len(f) == 5)) then 0 else if ((String) head(f) == FGCHFindingSchema()) then 1 else 0;
        def fgch-finding-kind(f) = f[1];
        def fgch-finding-point(f) = f[2];
        def fgch-finding-measure(f) = f[3];
        def fgch-finding-asks(f) = f[4];
        // A gap wears a "gap-" name and a wound a "wound-" one, whatever kinds
        // the lane grows: the view sorts them by what they are, never by a list
        // it has to be told about.
        def fgch-prefix?(text, prefix) = if (str_len(text) < str_len(prefix)) then 0 else if ((String) substring(text, 0, str_len(prefix)) == prefix) then 1 else 0;
        def fgch-gap?(f) = fgch-prefix?(fgch-finding-kind(f), "gap-");
        def fgch-wound?(f) = if ((Comparable) fgch-gap?(f) == 1) then 0 else 1;
        def fgch-gaps(findings) = if ((Comparable) len(findings) == 0) then [] else if ((Comparable) fgch-gap?(head(findings)) == 1) then cons(head(findings), fgch-gaps(tail(findings))) else fgch-gaps(tail(findings));
        def fgch-wounds(findings) = if ((Comparable) len(findings) == 0) then [] else if ((Comparable) fgch-wound?(head(findings)) == 1) then cons(head(findings), fgch-wounds(tail(findings))) else fgch-wounds(tail(findings));

        // ---- the play: the sequence, its gate, its most restricting step, its worth ----
        // The findings are the lane's own, read from the frame's finding rows.
        // The view computes none of its own: a corridor on the glass means what
        // the frame says a corridor is, never something the frame never said.
        def fgch-play(points, findings) {
            let gate = fgch-narrowest(points);
            let restricting = fgch-most-restricting(points);
            [FGCHPlaySchema(), points, if ((Comparable) len(gate) == 0) then FGCHNeverOffered() else fgch-flow(gate), if ((Comparable) len(gate) == 0) then "none" else fgch-point-id(gate), if ((Comparable) len(restricting) == 0) then "none" else fgch-point-id(restricting), fgch-total-worth(points), findings];
        }
        def fgch-play-steps(p) = p[1];
        def fgch-play-flow(p) = p[2];
        def fgch-play-gate(p) = p[3];
        def fgch-play-restricting(p) = p[4];
        def fgch-play-worth(p) = p[5];
        def fgch-play-findings(p) = p[6];

        // The choice most worth putting in front of a reader: the first step that
        // asks for something, and where nothing asks, the richest step.
        def fgch-asked-about?(findings, id) = if ((Comparable) len(findings) == 0) then 0 else if ((String) fgch-finding-point(head(findings)) == id) then 1 else fgch-asked-about?(tail(findings), id);
        def fgch-point-findings(point, findings) = if ((Comparable) len(findings) == 0) then [] else if ((String) fgch-finding-point(head(findings)) == fgch-point-id(point)) then cons(head(findings), fgch-point-findings(point, tail(findings))) else fgch-point-findings(point, tail(findings));
        def fgch-first-asking(points, findings) = if ((Comparable) len(points) == 0) then [] else if ((Comparable) fgch-asked-about?(findings, fgch-point-id(head(points))) == 1) then head(points) else fgch-first-asking(tail(points), findings);
        def fgch-richest-go(points, held) = if ((Comparable) len(points) == 0) then held else if (fgch-point-worth(head(points)) > fgch-point-worth(held)) then fgch-richest-go(tail(points), head(points)) else fgch-richest-go(tail(points), held);
        def fgch-next-choice(points, findings) {
            let asking = fgch-first-asking(points, findings);
            if (len(asking) > 0) then asking else if ((Comparable) len(points) == 0) then [] else fgch-richest-go(tail(points), head(points));
        }

        // ---- the cursor: one slot per (point, option) in reading order ----
        // The slot number rides the control state's selection as "choice.<n>", so
        // walking the sequence owes no new state field.
        def fgch-point-slots(point, options) = if ((Comparable) len(options) == 0) then [] else cons([point, head(options)], fgch-point-slots(point, tail(options)));
        def fgch-slots(points) = if ((Comparable) len(points) == 0) then [] else append(fgch-point-slots(head(points), fgch-point-options(head(points))), fgch-slots(tail(points)));
        def fgch-cursor-text(n) = str_concat("choice.", int_to_str(n));
        def fgch-cursor?(text) = if (str_len(text) < 8) then 0 else if ((String) substring(text, 0, 7) == "choice.") then 1 else 0;
        def fgch-cursor-number(text) = if ((Comparable) fgch-cursor?(text) == 1) then str_to_int(substring(text, 7, str_len(text))) else 0;
        // The first step from a selection that is not yet a cursor lands on the first slot.
        def fgch-cursor-step(text) = if ((Comparable) fgch-cursor?(text) == 1) then fgch-cursor-text((fgch-cursor-number(text) + 1)) else fgch-cursor-text(0);
        def fgch-wrap(n, count) = if (count <= 0) then 0 else (n - ((n / count) * count));
        def fgch-cursor-at(points, text) = fgch-wrap(fgch-cursor-number(text), len(fgch-slots(points)));
        def fgch-cursor-slot(points, text) {
            let slots = fgch-slots(points);
            if ((Comparable) len(slots) == 0) then [] else slots[fgch-wrap(fgch-cursor-number(text), len(slots))];
        }

        // ---- the outcome the reader writes, and the ledger it moves ----
        def fgch-outcome-command(pointId, optionId, kind, waitMs) = fgd-cat(["outcome|", pointId, "|", optionId, "|", kind, "|", int_to_str(waitMs)]);
        def fgch-command-fields(command) = split-on(command, "|");
        def fgch-command-kind(command) {
            let f = fgch-command-fields(command);
            if (!((Comparable) len(f) == 5)) then "" else if (!((String) head(f) == "outcome")) then "" else f[3];
        }
        def fgch-command-wait(command) {
            let f = fgch-command-fields(command);
            if ((Comparable) len(f) == 5) then str_to_int(f[4]) else 0;
        }
        def fgch-command-point(command) {
            let f = fgch-command-fields(command);
            if ((Comparable) len(f) == 5) then f[1] else "";
        }
        // One outcome lands on the counts, the same three the lane keeps.
        // the reader's three keys name the body's three outcomes, so an applied
        // outcome goes through the lane's own fcf-ledger-note
        def fgch-outcome-of(kind) = if ((String) kind == "taken") then cr-outcome-success() else if ((String) kind == "restricted") then cr-outcome-fail() else if ((String) kind == "held") then cr-outcome-silence() else fcf-outcome-none();
        def fgch-point-with(point, kind, waitMs) = fcf-point-note(point, fgch-outcome-of(kind), waitMs);
        def fgch-apply-go(points, id, kind, waitMs) = if ((Comparable) len(points) == 0) then [] else if ((String) fgch-point-id(head(points)) == id) then cons(fgch-point-with(head(points), kind, waitMs), fgch-apply-go(tail(points), id, kind, waitMs)) else cons(head(points), fgch-apply-go(tail(points), id, kind, waitMs));
        def fgch-apply-outcome(points, command) {
            let kind = fgch-command-kind(command);
            if ((Comparable) str_len(kind) == 0) then points else fgch-apply-go(points, fgch-command-point(command), kind, fgch-command-wait(command));
        }
        // The reader's own deliberation is not ours to guess; the wait recorded is
        // the one this body witnessed — offer written to outcome applied.
        def fgch-slot-command(points, cursorText, kind, waitMs) {
            let slot = fgch-cursor-slot(points, cursorText);
            if ((Comparable) len(slot) == 0) then "" else fgch-outcome-command(fgch-point-id(head(slot)), fgch-option-id(slot[1]), kind, waitMs);
        }

        // ---- the wire: one sample per point, its channels carrying the point ----
        // A channel is a LABEL -- lowercase, digits, - . _ , at most 64 bytes,
        // at most 16 per sample. So the wire is label-shaped and bounded:
        //   "choice"                                the channel tag
        //   "led.<offered>.<taken>.<held>.<declined>.<waitMs>"   the counts
        //   "opt.<id>.<cost>.<reward>"              one per option, in reading order
        // The earlier wire spelled entries "point|<id>|<question>" with pipes,
        // spaces and capitals; the membrane admits none of those, so no frame
        // could ever carry it and the live view decoded nothing while the choice
        // publisher gave eighteen rows a second. The id and question came from
        // the wire then; the id is the sample's own now, and the question is
        // prose that this membrane cannot carry at all.
        // the sample's own id names the point: "choice.<id>"
        def fgch-sample-point-id(sample) = if ((Comparable) fgch-prefix?(fgtm-sample-id(sample), "choice.") == 1) then substring(fgtm-sample-id(sample), 7, str_len(fgtm-sample-id(sample))) else "";
        def fgch-sample-point(sample) {
            let id = fgch-sample-point-id(sample);
            let cell = fgtm-sample-cell(sample);
            if (!((String) fgtm-sample-kind(sample) == "choice")) then [] else if ((Comparable) str_len(id) == 0) then [] else if ((Comparable) fcf-point-cell?(cell) == 0) then [] else fgch-point(id, fcf-cell-question(cell), fcf-cell-options(cell), fcf-cell-ledger(cell));
        }
        def fgch-samples-points(samples) = if ((Comparable) len(samples) == 0) then [] else if ((Comparable) len(fgch-sample-point(head(samples))) == 0) then fgch-samples-points(tail(samples)) else cons(fgch-sample-point(head(samples)), fgch-samples-points(tail(samples)));

        // ---- the findings the lane published, read back as they were given ----
        //   id       "finding.<kind>.<pointId>"
        //   purpose  what it asks for, as a label
        //   channels "choice" "finding" "<kind>"
        // A finding rides in the cell exactly as the lane made it -- kind, point,
        // note, ask -- so the ask arrives as the SENTENCE it is. The view used to
        // rebuild one from the row's channels and slice its point id out of the
        // sample id by counting bytes; there is nothing to slice now.
        def fgch-sample-finding(sample) {
            let cell = fgtm-sample-cell(sample);
            if (!((String) fgtm-sample-kind(sample) == "finding")) then [] else if ((Comparable) fgch-finding?(cell) == 0) then [] else cell;
        }
        def fgch-samples-findings(samples) = if ((Comparable) len(samples) == 0) then [] else if ((Comparable) len(fgch-sample-finding(head(samples))) == 0) then fgch-samples-findings(tail(samples)) else cons(fgch-sample-finding(head(samples)), fgch-samples-findings(tail(samples)));

        // ---- the rendering ----
        def fgch-share-text(v) = if ((Comparable) v == FGCHNeverOffered()) then "--" else str_concat(int_to_str(v), "%");
        def fgch-ms-text(v) = if ((Comparable) v == FGCHNeverOffered()) then "--" else str_concat(int_to_str(v), "ms");
        def fgch-worth-text(v) = if (v < 0) then int_to_str(v) else str_concat("+", int_to_str(v));
        def fgch-share-cells(part, whole, width) = if (whole <= 0) then 0 else fgd-clamp(((width * part) / whole), 0, width);
        // taken # | restricted : | the rest, held and unanswered, . ; never offered is a dash run
        def fgch-bar(point, width) {
            let ledger = fgch-point-ledger(point);
            let offers = fcf-ledger-offered(ledger);
            let taken = fgch-share-cells(fcf-ledger-taken(ledger), offers, width);
            let restricted = fgch-share-cells(fcf-ledger-declined(ledger), offers, width);
            let rest = fgd-max(0, (width - (taken + restricted)));
            if (offers <= 0) then fgd-repeat("-", width) else fgd-cat([fgd-repeat("#", taken), fgd-repeat(":", restricted), fgd-repeat(".", rest)]);
        }
        def fgch-point-style(point, findings) = if ((Comparable) fgch-flow(point) == FGCHNeverOffered()) then fgd-neutral(96) else if ((Comparable) fgch-asked-about?(findings, fgch-point-id(point)) == 1) then fgd-health() else fgd-ready();
        def fgch-point-text(point, marker, width) = fgd-fit(fgd-cat([marker, " ", fgd-pad-right(fgch-point-id(point), 26), " [", fgch-bar(point, FGCHBarWidth()), "] f ", fgd-pad-left(fgch-share-text(fgch-flow(point)), 4), " r ", fgd-pad-left(fgch-share-text(fgch-restriction(point)), 4), " h ", fgd-pad-left(fgch-share-text(fgch-holding(point)), 4), " w ", fgd-pad-left(fgch-ms-text(fgch-mean-wait(point)), 7), "  ", fgch-point-question(point)]), width);
        def fgch-option-text(option, marker, width) = fgd-fit(fgd-cat([marker, " ", fgd-pad-right(fgch-option-id(option), 26), " worth ", fgd-pad-left(fgch-worth-text(fgch-option-worth(option)), 4), " cost ", fgd-pad-left(int_to_str(fgch-option-cost(option)), 3), " reward ", fgd-pad-left(int_to_str(fgch-option-reward(option)), 3), "  ", fgch-option-offer(option)]), width);
        def fgch-finding-text(finding, width) = fgd-fit(fgd-cat(["  ", fgd-pad-right(fgch-finding-kind(finding), 18), fgd-pad-right(fgch-finding-point(finding), 26), fgd-pad-right(fgch-finding-measure(finding), 9), "asks: ", fgch-finding-asks(finding)]), width);
        def fgch-play-text(play, gaps, wounds) = fgd-cat(["PLAY steps=", int_to_str(len(fgch-play-steps(play))), " flow=", fgch-share-text(fgch-play-flow(play)), " gate=", fgch-play-gate(play), " restricting=", fgch-play-restricting(play), " worth=", fgch-worth-text(fgch-play-worth(play)), " gaps=", int_to_str(len(gaps)), " wounds=", int_to_str(len(wounds))]);

        def fgch-option-line(point, option, marker, width) = fgd-segment-line(fgch-option-text(option, marker, width), width, if ((String) marker == ">") then fgd-title() else fgd-neutral(200), fgd-cat(["choice.", fgch-point-id(point), ".", fgch-option-id(option)]), ["choice", "option"], "declared");
        def fgch-option-lines(point, options, cursor, index, width) = if ((Comparable) len(options) == 0) then [] else cons(fgch-option-line(point, head(options), if ((Comparable) index == cursor) then ">" else " ", width), fgch-option-lines(point, tail(options), cursor, (index + 1), width));
        def fgch-point-line(point, findings, marker, width) = fgd-segment-line(fgch-point-text(point, marker, width), width, fgch-point-style(point, findings), str_concat("choice.", fgch-point-id(point)), ["choice", "point"], "declared");
        def fgch-point-here?(point, cursor, index) = if (cursor < index) then 0 else if (cursor >= (index + len(fgch-point-options(point)))) then 0 else 1;
        def fgch-point-block(point, findings, cursor, index, width) = cons(fgch-point-line(point, findings, if ((Comparable) fgch-point-here?(point, cursor, index) == 1) then "*" else " ", width), fgch-option-lines(point, fgch-point-options(point), cursor, index, width));
        def fgch-point-blocks(points, findings, cursor, index, width) = if ((Comparable) len(points) == 0) then [] else append(fgch-point-block(head(points), findings, cursor, index, width), fgch-point-blocks(tail(points), findings, cursor, (index + len(fgch-point-options(head(points)))), width));
        def fgch-finding-line(finding, width) = fgd-segment-line(fgch-finding-text(finding, width), width, if ((Comparable) fgch-gap?(finding) == 1) then fgd-catalog() else fgd-health(), str_concat("choice.finding.", fgch-finding-point(finding)), ["choice", "finding", fgch-finding-kind(finding)], "declared");
        def fgch-finding-lines(findings, width) = if ((Comparable) len(findings) == 0) then [] else cons(fgch-finding-line(head(findings), width), fgch-finding-lines(tail(findings), width));
        // No frame stands yet: the view names the door that owes it, never a bare ?
        def fgch-absent-line(width) = fgd-segment-line(fgd-cat(["? no choice points stand: door=", FGCHFrameDoor(), " publisher=", FGCHPublisher(), " (form-choice-flow gives one sample per point)"]), width, fgd-neutral(96), "choice.absent", ["choice", "absent"], "unavailable");

        def fgch-lines(points, findings, cursorText, width, count) {
            let cursor = fgch-cursor-at(points, cursorText);
            let play = fgch-play(points, findings);
            let gaps = fgch-gaps(fgch-play-findings(play));
            let wounds = fgch-wounds(fgch-play-findings(play));
            let title = fgd-title-segment-line(fgd-cat(["CHOICE POINTS  g step  y take  w hold  cursor=", fgch-cursor-text(cursor)]), width, "section.choice");
            let body = if ((Comparable) len(points) == 0) then [fgch-absent-line(width)] else fgch-point-blocks(points, findings, cursor, 0, width);
            let playLine = fgd-segment-line(fgd-fit(fgch-play-text(play, gaps, wounds), width), width, fgd-title(), "choice.play", ["choice", "play"], "declared");
            let gapLines = if ((Comparable) len(gaps) == 0) then [] else cons(fgd-title-segment-line(str_concat("GAPS to nourish: ", int_to_str(len(gaps))), width, "section.choice.gaps"), fgch-finding-lines(gaps, width));
            let woundLines = if ((Comparable) len(wounds) == 0) then [] else cons(fgd-title-segment-line(str_concat("WOUNDS to heal: ", int_to_str(len(wounds))), width, "section.choice.wounds"), fgch-finding-lines(wounds, width));
            fgd-take(append([title], append(body, append([playLine], append(gapLines, woundLines)))), count);
        }
        def fgch-view-lines(samples, cursorText, width, count) = fgch-lines(fgch-samples-points(samples), fgch-samples-findings(samples), cursorText, width, count);
    }
    0;
}
