; form-cli-free-remote-run.fk — form-cli names the free-remote floor.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-free-remote.fk

(do
    (print_str
        (str_concat "form-cli executed free-remote\n"
        (str_concat "form-cli faces="
        (str_concat (int_to_str (ffr-n))
        (str_concat " free="
        (str_concat (int_to_str (ffr-n-free))
        (str_concat " ready="
        (str_concat (int_to_str (ffr-n-ready))
        (str_concat "\nform-cli chatgpt-inbound="
        (str_concat (ffr-state (ffr-chatgpt-inbound))
        (str_concat " chatgpt-outbound="
        (str_concat (ffr-state (ffr-chatgpt-outbound))
        (str_concat "\nform-cli walk native-hit=1 -> speak="
        (str_concat (int_to_str (ffr-may-speak? 1 1 1 1))
        (str_concat "\nform-cli walk local-ready=1 -> speak="
        (str_concat (int_to_str (ffr-may-speak? 0 1 1 1))
        (str_concat "\nform-cli walk remote+water+face -> speak="
        (str_concat (int_to_str (ffr-may-speak? 0 0 1 1))
        (str_concat "\nform-cli walk remote no-water -> speak="
        (str_concat (int_to_str (ffr-may-speak? 0 0 0 1))
        (str_concat "\nform-cli review-retired="
        (str_concat (int_to_str (ffr-review-retired?))
        (str_concat "\nform-cli check="
        (str_concat (int_to_str (ffr-check))
        (str_concat "\n" (str_concat (ffr-spoken) "\n"))))))))))))))))))))))))))
    0)
