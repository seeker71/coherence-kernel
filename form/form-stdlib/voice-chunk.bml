//////////////////////////////////////////////////////////////////////
// voice-chunk.bml — a text, cut for a mouth that breathes.
//
// The VITS the body speaks with was trained on sentences. A line of forty words in one rendering loops or trails
// off (found 2026-10-02 on the sleep track, where two quoted forty-word lines came back as seven), so a long
// line is rendered as clause-sized pieces and rested between. This is that cut, in Form: it replaces the shell
// script that did it the first time.
//
//   a line of 22 words or fewer stays whole;
//   a longer line breaks after punctuation once a piece holds 10 words, and is forced to break at 22;
//   hyphens are spoken as spaces ("bridge-connected" is two words to the voice);
//   the rest after a piece is 0 inside a line, 1 at a sentence's end, 2 at a paragraph's end.
//
// A transcript that carries two tongues line by line (an English line, its indented translation, a blank line
// between paragraphs) is read by `vc-source`: English lines, translated lines, and one paragraph flag per line.
//////////////////////////////////////////////////////////////////////
import form/form-stdlib/voice-g2p.bml;
section [form.bml] {
    class FormVoiceChunk {
        field VCSoft = 10;
        field VCHard = 22;
        def vc-nl() = byte_to_str(10);
        def vc-words(s) = vg-drop-empty(split-on(vc-join(split-on(s, "-"), " "), " "));
        def vc-join(xs, sep) = if ((Comparable) len(xs) == 0) then "" else if ((Comparable) len(xs) == 1) then xs[0] else vg-cat([xs[0], sep, vc-join(xs[1:], sep)]);
        def vc-space?(c) = if ((Comparable) c == 32) then 1 else if ((Comparable) c == 9) then 1 else if ((Comparable) c == 13) then 1 else 0;
        def vc-trim-lead(s, i) = if (i >= len(s)) then "" else if ((Comparable) vc-space?(str_byte_at(s, i)) == 1) then vc-trim-lead(s, (i + 1)) else substring(s, i, len(s));
        def vc-indented?(s) = if ((Comparable) len(s) == 0) then 0 else vc-space?(str_byte_at(s, 0));
        // ---- the source: English lines, their translation, one paragraph flag per line ----
        // state: (english, translated, flags, pending) — pending is 1 while an English line waits for its flag
        def vc-src-go(lines, en, tr, flags, pending) {
            if ((Comparable) len(lines) == 0) then [reverse(en), reverse(tr), reverse(if ((Comparable) pending == 1) then cons(0, flags) else flags)]
                else vc-src-step(lines, en, tr, flags, pending, lines[0]);
        }
        def vc-src-step(lines, en, tr, flags, pending, l) {
            if ((Comparable) len(vc-trim-lead(l, 0)) == 0) then vc-src-go(lines[1:], en, tr, if ((Comparable) pending == 1) then cons(1, flags) else flags, 0)
                else if ((Comparable) vc-indented?(l) == 1) then vc-src-go(lines[1:], en, cons(vc-trim-lead(l, 0), tr), flags, pending)
                else vc-src-go(lines[1:], cons(l, en), tr, if ((Comparable) pending == 1) then cons(0, flags) else flags, 1);
        }
        def vc-source(text) = vc-src-go(split-on(text, vc-nl()), [], [], [], 0);
        // ---- the cut: a line -> rows of (text rest) ----
        def vc-end-rest(flag) = if ((Comparable) flag == 1) then 2 else 1;
        def vc-break?(w, n) = if (n >= VCHard()) then 1 else if (n < VCSoft()) then 0 else if ((Comparable) vg-mark-before(vg-punct(), w, len(w)) > 0) then 1 else 0;
        def vc-words-text(ws) = vc-join(ws, " ");
        def vc-cut-go(ws, cur, acc) {
            if ((Comparable) len(ws) == 0) then [cur, acc]
                else vc-cut-take(ws, append(cur, [ws[0]]), acc);
        }
        def vc-cut-take(ws, cur, acc) {
            if ((Comparable) vc-break?(ws[0], len(cur)) == 1) then vc-cut-go(ws[1:], [], append(acc, [[vc-words-text(cur), 0]]))
                else vc-cut-go(ws[1:], cur, acc);
        }
        // the last piece of a line carries the line's own rest; when the line ended exactly on a break, the last cut piece does
        def vc-line(text, flag) {
            let ws = vc-words(text);
            if ((Comparable) len(ws) <= VCHard()) then [[vc-words-text(ws), vc-end-rest(flag)]] else vc-line-close(vc-cut-go(ws, [], []), flag);
        }
        def vc-line-close(res, flag) {
            let cur = res[0];
            let acc = res[1];
            if ((Comparable) len(cur) > 0) then append(acc, [[vc-words-text(cur), vc-end-rest(flag)]])
                else append(acc[0:(len(acc) - 1)], [[acc[(len(acc) - 1)][0], vc-end-rest(flag)]]);
        }
        def vc-all(lines, flags) = if ((Comparable) len(lines) == 0) then [] else append(vc-line(lines[0], flags[0]), vc-all(lines[1:], flags[1:]));
        // ---- the two files a mouth reads: pieces, and the rest after each ----
        def vc-texts(rows) = if ((Comparable) len(rows) == 0) then [] else cons(rows[0][0], vc-texts(rows[1:]));
        def vc-rests(rows) = if ((Comparable) len(rows) == 0) then [] else cons(rows[0][1].str(), vc-rests(rows[1:]));
        def vc-lines-text(xs) = vg-cat([vc-join(xs, vc-nl()), vc-nl()]);
    }
    0;
}
