; form-ontology-loader.fk — the engine/dialect constant generation.
;
; The reviewed `bp` bootstrap registry moved to form-ontology-bp.fk on
; 2026-07-30 (see that file for why); this cell preludes it, so every name it
; used to export is still exported from here and no consumer changes.
;
; What is left here is the part that genuinely needs a sibling-kernel native.
;
; source-door surface seam (2026-07-17, unchanged): on fkwu every requirement resolves
; EXCEPT walk_recipe_here — the top-level engine-defn walk at the foot of this
; file, which would install the bmf-context-key-* / bmf-locale-* constant family
; for engine.fk. It is a sibling-kernel native with no fkwu counterpart or bp
; coordinate. Under fresh `fkwu` that one call stays loud (unresolved,
; axiom-5 recovery) and the generated constants stay ungenerated; engine.fk
; records the same seam from the consumer side. Recorded, not shimmed: a numb
; walk would silently skip the generation it claims.
;
; preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine-constants.fk

(defn fol-core-row (name)
    (do
        ; fol-bp, NOT bp: on fkwu `bp` is a native pass-through (optable tag 45)
        ; that hands the STRING back, so (node_type (bp "do")) read 0 and every
        ; category row collapsed to (name 0 0) — all cats value_eq-equal, every
        ; cat dispatch taking its first branch. corpus row 1020 (ownergap) named
        ; this owner-differs-by-arm seam the day before it was found here.
        (let nid (fol-bp name))
        (list name (node_type nid) (node_inst nid))))

(defn fol-core-rows-loop (names acc)
    (if (eq (len names) 0) acc
        (fol-core-rows-loop (tail names) (cons (fol-core-row (head names)) acc))))

(defn fol-reverse-loop (xs acc)
    (if (eq (len xs) 0) acc
        (fol-reverse-loop (tail xs) (cons (head xs) acc))))

(defn fol-reverse (xs) (fol-reverse-loop xs (empty)))
(defn fol-core-rows (names) (fol-reverse (fol-core-rows-loop names (empty))))

(let FORM-CATEGORY-TABLE
    (fol-core-rows (list "do" "sequence" "let" "if-then" "if" "fndef" "fncall" "ident" "match")))

(let FORM-PRIMITIVE-TABLE
    (fol-core-rows (list "add" "sub" "mul" "div" "mod" "eq" "ne" "lt" "le" "gt" "ge" "and" "or" "not")))

;; --- table lookup ---------------------------------------------------

(defn fol-table-lookup (table name)
    (if (eq (len table) 0) (empty)
        (if (str_eq (head (head table)) name)
            (head table)
            (fol-table-lookup (tail table) name))))

(defn fol-cat (name)
    (do
        (let row (fol-table-lookup FORM-CATEGORY-TABLE name))
        (make_nodeid 1 2 (head (tail row)) (head (tail (tail row))))))

(let FOL-LET-CAT    (fol-cat "let"))
(let FOL-DO-CAT     (fol-cat "do"))
(let FOL-SEQ-CAT    (fol-cat "sequence"))
(let FOL-FNDEF-CAT  (fol-cat "fndef"))
(let FOL-FNCALL-CAT (fol-cat "fncall"))

;; --- recipe constructors --------------------------------------------

(defn fol-rec-call (fn-name arg-list)
    (intern_node FOL-FNCALL-CAT (cons (intern_trivial_string fn-name) arg-list)))

(defn fol-rec-let (name value-recipe)
    (intern_node FOL-LET-CAT
        (list (intern_trivial_string name) value-recipe)))

(defn fol-rec-fndef-0 (name body-recipe)
    (intern_node FOL-FNDEF-CAT
        (list (intern_trivial_string name)
              (intern_node FOL-SEQ-CAT (empty))
              body-recipe)))

(defn fol-rec-bp (name)
    (fol-rec-call "bp" (list (intern_trivial_string name))))

;; --- dialect-category bindings -------------------------------------
;; These names become `(let NAME (bp "NAME"))` through the recipe walker below.
;; They are not host-table authority: each row above is reviewed and carried by
;; this Form file so grammar capsules can serialize to .fkb without fake string
;; NodeIDs or unbound dialect constants.

(let FOL-DIALECT-BINDING-NAMES
    (list "PY-BMF-IMPORT" "PY-BMF-FROM-IMPORT" "PY-BMF-DEF" "PY-BMF-CLASS" "PY-BMF-ASSIGN" "PY-BMF-RETURN" "PY-BMF-RAISE" "PY-BMF-PASS" "PY-BMF-IF" "PY-BMF-WHILE" "PY-BMF-FOR" "PY-BMF-CALL" "PY-BMF-INT" "PY-BMF-STRING" "PY-BMF-IDENT" "PY-BMF-ATTR" "PY-BMF-METHOD-CALL" "PY-BMF-LIST" "PY-BMF-DICT" "PY-BMF-ANNOTATED" "PY-BMF-AUG-ASSIGN" "PY-BMF-BINOP" "PY-BMF-MODULE" "PY-BMF-BOOL" "PY-BMF-NONE" "PY-BMF-UNARY" "PY-BMF-COMPARE" "PY-BMF-BOOL-OP" "PY-BMF-SUBSCRIPT" "PY-BMF-SLICE" "PY-BMF-TUPLE" "PY-BMF-SET" "PY-BMF-LAMBDA" "PY-BMF-AWAIT" "PY-BMF-YIELD" "PY-BMF-BREAK" "PY-BMF-CONTINUE" "PY-BMF-GLOBAL" "PY-BMF-NONLOCAL" "PY-BMF-DEL" "PY-BMF-ASSERT" "PY-BMF-WITH" "PY-BMF-TRY" "PY-BMF-ASYNC-DEF" "PY-BMF-DECORATOR" "PY-BMF-ASYNC-FOR" "PY-BMF-ASYNC-WITH" "PY-BMF-IF-ELSE" "PY-BMF-ELIF" "PY-BMF-RAISE-FROM" "PY-BMF-IMPORT-STAR" "PY-BMF-IMPORT-MANY" "PY-BMF-EXCEPT-AS" "PY-BMF-MATCH" "PY-BMF-CASE" "PY-BMF-COMP" "PY-BMF-GENEXP" "PY-BMF-KWARG" "PY-BMF-STARARG" "PY-BMF-DEFAULT" "PY-BMF-TYPED-PARAM" "PY-BMF-RET-ANN" "PY-BMF-WALRUS" "PY-BMF-FLOAT" "PY-BMF-BYTES" "PY-BMF-ELLIPSIS" "PY-BMF-ATTR-ASSIGN" "PY-BMF-SUB-ASSIGN" "PY-BMF-UNPACK" "PY-BMF-FSTRING" "PY-BMF-IFEXP" "PY-BMF-SETCOMP" "PY-BMF-YIELD-FROM" "PY-BMF-MATCH-AS" "PY-BMF-IF-STMT" "BML-AST-PACKAGE" "BML-AST-IMPORT" "BML-AST-CLASS" "BML-AST-INTERFACE" "BML-AST-TEMPLATE" "BML-AST-SECTION" "BML-AST-FIELD" "BML-AST-CONST" "BML-AST-METHOD" "BML-AST-RETURN" "BML-AST-INT" "BML-AST-STRING" "BML-AST-NAME" "BML-AST-ADD" "BML-AST-CHOOSE" "BML-AST-FAIL" "BML-AST-CUT" "BML-AST-SAVE" "BML-AST-RESTORE" "BML-AST-DISCARD" "BML-AST-THROW" "BML-AST-IF" "BML-AST-WHILE" "BML-AST-FOR" "BML-AST-WITH" "BML-AST-TRY" "BML-AST-BLOCK" "BML-AST-BREAK" "BML-AST-CONTINUE" "BML-AST-CHAR" "BML-AST-ARRAY" "BML-AST-FLOAT" "BML-AST-CALL" "GO-BMF-PACKAGE" "GO-BMF-IMPORT" "GO-BMF-FUNC" "GO-BMF-METHOD" "GO-BMF-STRUCT" "GO-BMF-INTERFACE" "GO-BMF-VAR" "GO-BMF-CONST" "GO-BMF-RETURN" "GO-BMF-ASSIGN" "GO-BMF-CALL" "GO-BMF-SELECTOR" "GO-BMF-INDEX" "GO-BMF-IF" "GO-BMF-FOR" "GO-BMF-GO" "GO-BMF-DEFER" "GO-BMF-TYPE" "GO-BMF-SWITCH" "GO-BMF-SELECT" "GO-BMF-CHAN" "GO-BMF-COMPOSITE" "GO-BMF-PTR-TYPE" "TS-BMF-IMPORT" "TS-BMF-EXPORT-CONST" "TS-BMF-FUNCTION" "TS-BMF-CLASS" "TS-BMF-INTERFACE" "TS-BMF-TYPE" "TS-BMF-CALL" "TS-BMF-AWAIT" "TS-BMF-JSX" "TS-BMF-RETURN" "TS-BMF-ASSIGN" "TS-BMF-MEMBER" "TS-BMF-INDEX" "TS-BMF-IF" "TS-BMF-FOR" "TS-BMF-ARROW" "TS-BMF-ARRAY" "TS-BMF-OBJECT" "TS-BMF-ENUM" "TS-BMF-OPTIONAL" "TS-BMF-TEMPLATE" "TS-BMF-TERNARY" "TS-BMF-IF-ELSE" "TS-BMF-EVAL-INT" "TS-BMF-EVAL-IDENT" "TS-BMF-EVAL-BINOP" "TS-BMF-EVAL-COMPARE" "TS-BMF-EVAL-MODULE" "TS-BMF-EVAL-FN" "TS-BMF-EVAL-CALL" "TS-BMF-EVAL-LAMBDA" "TS-BMF-EVAL-IF" "TS-BMF-EVAL-RETURN" "TS-BMF-EVAL-ASSIGN" "TS-BMF-EVAL-PASS" "TS-BMF-EVAL-STR" "TS-BMF-EVAL-CONCAT" "CAST-TYPE-BOOL" "CAST-TYPE-INT" "CAST-TYPE-FLOAT" "CAST-TYPE-STRING" "CAST-TYPE-NOTHING" "CAST-BOOL-INT" "CAST-INT-BOOL" "CAST-INT-FLOAT" "CAST-FLOAT-INT" "CAST-INT-STRING" "CAST-STRING-INT" "CAST-FLOAT-STRING" "CAST-STRING-FLOAT" "CAST-BOOL-STRING" "CAST-STRING-BOOL" "CAST-STRING-BOOL-TRUTHY" "RS-BMF-USE" "RS-BMF-MOD" "RS-BMF-FN" "RS-BMF-STRUCT" "RS-BMF-ENUM" "RS-BMF-IMPL" "RS-BMF-TRAIT" "RS-BMF-MACRO" "RS-BMF-LET" "RS-BMF-RETURN" "RS-BMF-MATCH" "RS-BMF-IF" "RS-BMF-LOOP" "RS-BMF-ASYNC" "RS-BMF-RESULT" "PL-BMF-FACT" "PL-BMF-RULE" "PL-BMF-DIRECTIVE" "PL-BMF-QUERY" "PL-BMF-IS" "PL-BMF-LIST" "PL-BMF-CUT" "PL-BMF-UNIFY" "PL-BMF-DCG" "NATURAL-BMF-FACT" "NATURAL-BMF-RELATION" "NATURAL-BMF-QUESTION" "NATURAL-BMF-MEANING"))

(defn fol-dialect-binding-let (name)
    (fol-rec-let name (fol-rec-bp name)))

(defn fol-dialect-binding-lets-loop (names acc)
    (if (eq (len names) 0) acc
        (fol-dialect-binding-lets-loop (tail names)
            (cons (fol-dialect-binding-let (head names)) acc))))

(defn fol-all-dialect-lets ()
    (fol-dialect-binding-lets-loop FOL-DIALECT-BINDING-NAMES (empty)))

;; --- engine-constants getters ---------------------------------------
;; Factory rows: (function-name factory-name int-value), producing
;; `(defn function-name () (factory-name int-value))`.
;; String rows: (function-name string-value), producing a string literal getter.

(defn fol-engine-factory-defn (row)
    (fol-rec-fndef-0
        (head row)
        (fol-rec-call (head (tail row))
            (list (intern_trivial_int (head (tail (tail row))))))))

(defn fol-engine-string-defn (row)
    (fol-rec-fndef-0 (head row) (intern_trivial_string (head (tail row)))))

(defn fol-engine-factory-defns-loop (rows acc)
    (if (eq (len rows) 0) acc
        (fol-engine-factory-defns-loop (tail rows)
            (cons (fol-engine-factory-defn (head rows)) acc))))

(defn fol-engine-string-defns-loop (rows acc)
    (if (eq (len rows) 0) acc
        (fol-engine-string-defns-loop (tail rows)
            (cons (fol-engine-string-defn (head rows)) acc))))

(defn fol-all-engine-defns ()
    (fol-engine-factory-defns-loop FOL-ENGINE-FACTORY-ROWS
        (fol-engine-string-defns-loop FOL-ENGINE-STRING-ROWS (empty))))



;; --- materialise: walk the combined do-recipe in caller env ---------

(defn fol-concat-acc (xs acc)
    (if (eq (len xs) 0) acc
        (fol-concat-acc (tail xs) (cons (head xs) acc))))

(let FOL-ALL-RECIPES
    (fol-concat-acc (fol-all-dialect-lets) (fol-all-engine-defns)))

(walk_recipe_here (intern_node FOL-DO-CAT FOL-ALL-RECIPES))

0

