// form-flatten.fk — m4e3's real-recipe flattener (path-b, the cursor lane):
// reads a REAL stdlib band's Form SOURCE (module file + band file, unmodified)
// and flattens it into a Hati-OS kernel program. defn becomes a function-table
// row (CALL by index, fn 0 = the band's verdict expression), module lets inline
// pure value cells, effecting nested do-lets and band top-level lets snapshot
// once through RAM slots, and the curated band vocabulary lowers onto
// the walker's op set: gt/ge/eq/and become IF/LE shapes; head/tail/len/nth/
// cons/list/empty map 1:1 to the arena tags 18..23. The output is program-as-
// cells — fkc-table-file serializes it and the universal fkw binary runs the
// band through the fs port: the Hati-OS arm's band ratchet.
//
// Builds on form-parse.fk (the expression stone: a cursor over the source
// string, no tokenizer — the BMF discipline). Multi-param defns ride PACKED
// ARGS (m4e4): an N-arg call right-folds its arguments into a CONS chain on
// the arena, the callee's params bind as NTH(ARG, i) by position — a pure
// flattening rule over the existing op set, no new walker tags. Single-param
// calls stay direct ARG (no allocation); zero-param packs EMPTY. Nested
// (do ...) is an EXPRESSION (m4e5): effecting lets bind once for the rest of the do,
// the last expression is the value — let-in-defn and do-in-do flatten by
// the same structural recursion as the top level. Integer literals may be
// negative; true/false flatten as 1/0; div/mod and the figure-ops family
// (band/bor/bxor/shl_u32/shr_u32/rotr_u32/add_u32/bnot_u32/mul, tags 34..42)
// are vocabulary rows — the checksum bands' unlock. Scope held honestly:
// PURE bands — defn bodies that see only their params + do-lets, top-level
// lets, one verdict expression. eq/and lowering and let-inlining re-evaluate
// pure operands. Non-recursive direct-call do-lets snapshot once through
// per-function RAM windows, so list-returning calls can be read more than once
// without re-walking. Packed args ride the emitted walker's VALUE STACK
// (hati-os-kernel-emit.fk: ARG reads fk_vs[fp], the melt roots and
// relocates every stack slot), so band-scale allocation melts safely
// mid-call — feature-vector's crossing is the witness (audit section 24).
// The str_* family rides the walker string-pool lane (tags 24..28): a
// pre-pass (flt-scan) interns every distinct "literal" into the program's
// pool — same bytes, same slot — and a literal lowers to SLIT carrying its
// pool index; the string family now carries str_eq/str_len/str_concat plus
// substring/str_find/str_to_int/int_to_str/byte_to_str. The explicit NodeID
// door carries make_nodeid/category/pkg/level/type/inst. Literal bp calls for
// the current fourth-floor registry names fold onto make_nodeid packets; the
// full generated bp table remains a follow-on lift.
//
// Native carrier floor: socket_listen/connect/accept/send/recv/close lower to
// tags 120..126 as the host-OS socket boundary. http_get/sock_request remain
// compatibility carriers above that floor; HTTP verbs belong in Form recipes
// over socket bytes, not as the primitive substrate. _get lowers to tag 106 so
// source recipes can read returned dict/list receipts inside fkwu.
//
import form-stdlib/host-effect-grammar.fk;
import form-stdlib/fk-opt.fk;
import form-stdlib/bml/native-rewrite-rules.bml;
import form-stdlib/form-parse.fk;
// ── walker-carried ops as DATA rows (name arity tag) — one generic engine ──
// These are form-cli's rows, generated from native-op-manifest.fk; the table fkwu
// runs is flatten/form-flatten.fk, and gate/op-manifest.bml holds the two to one
// meaning on every name both carry.
// (div/mod ride the m4d tags 10/11; the figure-ops family rides 34..42 —
//  the bitwise-u32 + mul vocabulary the checksum bands need)
section [form.bml] {
    def flt-ops() =     // GENERATED from native-op-manifest.fk by native-op-emitter.bml
[["add", 2, 3], ["sub", 2, 4], ["le", 2, 5], ["cons", 2, 19], ["nth", 2, 23], ["head", 1, 20], ["tail", 1, 21], ["len", 1, 22], ["str_len", 1, 25], ["str_eq", 2, 26], ["str_concat", 2, 27], ["str_byte_at", 2, 28], ["byte_to_str", 1, 33], ["str_find", 3, 30], ["input_byte", 1, 17], ["read_line", 0, 114], ["print_str", 1, 115], ["host-exec", 2, 136], ["isatty", 0, 116], ["self_source", 0, 117], ["kernel_stat", 1, 127], ["fb_record", 3, 128], ["framebuffer-events", 0, 129], ["node_source", 1, 130], ["node_at", 1, 147], ["framebuffer-clear", 0, 131], ["nothing", 0, 137], ["nothing?", 1, 138], ["intern_trivial_int", 1, 43], ["intern_trivial_bool", 1, 112], ["intern_trivial_float", 1, 113], ["make_nodeid", 4, 91], ["bp", 1, 45], ["intern_trivial_string", 1, 46], ["intern_node", 2, 47], ["node_children", 1, 48], ["node_value", 1, 49], ["node_category", 1, 92], ["node_type", 1, 93], ["node_inst", 1, 94], ["node_pkg", 1, 95], ["node_level", 1, 96], ["node_eq", 2, 80], ["value_eq", 2, 80], ["round_ndigits", 2, 52], ["str_to_float", 1, 53], ["float_to_int", 1, 54], ["math_sqrt", 1, 81], ["math_exp", 1, 89], ["math_log", 1, 90], ["math_pow", 2, 195], ["float_leaf", 2, 201], ["host_dir_rmdir", 1, 55], ["fs_rmdir", 1, 55], ["host_dir_mkdir", 1, 56], ["fs_mkdir", 1, 56], ["host_path_exists", 1, 57], ["fs_exists", 1, 57], ["host_path_remove", 1, 58], ["fs_remove", 1, 58], ["host_path_rename", 2, 59], ["fs_rename", 2, 59], ["host_file_size", 1, 60], ["file_size", 1, 60], ["host_file_append_bytes", 2, 61], ["file_append_bytes", 2, 61], ["host_file_read_slice", 3, 62], ["read_file_slice", 3, 62], ["shm_offer", 2, 184], ["shm_receive", 1, 185], ["shm_write", 2, 186], ["shm_read", 1, 187], ["shm_seq", 1, 188], ["shm_release", 1, 189], ["terminal_cols", 0, 180], ["terminal_lines", 0, 181], ["host_monotonic_ms", 0, 182], ["host_cpu_us", 0, 176], ["host_gpu_utilization", 0, 174], ["host_gpu_busy_us", 0, 175], ["host_cpu_busy_us", 0, 173], ["host_vm_stat", 0, 151], ["host_load_avg", 0, 152], ["host_disk_stat", 0, 153], ["host_processes", 1, 154], ["host_spawn", 1, 155], ["host_wait", 1, 156], ["host_kill", 1, 157], ["host_nice", 1, 158], ["host_capture", 1, 159], ["host_pid", 0, 160], ["host_cwd", 0, 29], ["fs_truncate", 2, 143], ["host_spawn_quiet", 1, 161], ["kernel_live_pids", 0, 162], ["kernel_live", 1, 163], ["kernel_hot_rows", 1, 164], ["metal_live", 0, 165], ["gift_roster_register", 1, 166], ["gift_roster_names", 0, 167], ["cell_map", 1, 168], ["cell_field", 3, 169], ["cell_value", 2, 170], ["cell_ref", 1, 171], ["cell_unmap", 1, 172], ["field_reset", 0, 196], ["kernel_box_rows", 1, 191], ["kernel_page_hot", 2, 192], ["kernel_page_box", 2, 193], ["host_sleep_ms", 1, 183], ["kernel_hot", 1, 179], ["node_gift_read", 1, 177], ["node_gift_write", 2, 178], ["kernel_ast", 2, 32], ["host_file_read_text", 1, 63], ["read_file", 1, 63], ["host_temp_dir", 0, 101], ["temp_dir", 0, 101], ["host_file_write_text", 2, 104], ["write_file", 2, 104], ["write_file_text", 2, 104], ["host_dir_list", 1, 132], ["fs_list", 1, 132], ["host_path_is_dir", 1, 200], ["fs_is_dir", 1, 200], ["host_source_inventory", 3, 202], ["source_inventory", 3, 202], ["metal_matvec_fixture", 0, 203], ["metal_matvec_f32", 3, 204], ["metal_pipeline", 2, 245], ["metal_buf_alloc", 1, 246], ["metal_buf_from_file", 3, 247], ["metal_buf_write", 3, 248], ["metal_enqueue", 3, 249], ["metal_sync", 0, 250], ["metal_buf_read", 3, 251], ["metal_status", 0, 252], ["metal_batch_concurrent", 0, 253], ["metal_buf_free", 1, 254], ["metal_submit", 0, 255], ["metal_fence_wait", 1, 142], ["metal_deadline", 1, 148], ["file_open", 1, 133], ["file_read", 2, 134], ["file_close", 1, 135], ["http_get", 3, 105], ["sock_request", 3, 118], ["tls_request", 3, 119], ["socket_listen", 1, 120], ["socket_port", 1, 121], ["socket_accept", 1, 122], ["socket_connect", 2, 123], ["socket_send", 2, 124], ["socket_recv", 2, 125], ["socket_close", 1, 126], ["_get", 2, 106], ["host_file_mtime", 1, 107], ["file_mtime", 1, 107], ["scan_run", 3, 108], ["record_get", 2, 65], ["record_set", 3, 66], ["record_has", 2, 67], ["record?", 1, 68], ["record_keys", 1, 99], ["record_blueprint", 1, 100], ["method_define", 3, 197], ["method_has", 2, 198], ["now_unix_ms", 0, 15], ["string_bytes", 1, 205], ["string_byte_fold", 3, 206], ["form_table_text", 2, 207], ["form_error", 1, 238], ["div", 2, 10], ["mod", 2, 11], ["band", 2, 34], ["bor", 2, 35], ["bxor", 2, 36], ["shl_u32", 2, 37], ["shr_u32", 2, 38], ["rotr_u32", 2, 39], ["add_u32", 2, 40], ["bnot_u32", 1, 41], ["mul", 2, 42], ["jit_arm64_u32_leaf", 3, 215], ["jit_leaf_inram", 2, 146]];
    def flt-assoc(name, rows) = (Comparable) len(rows) == 0 ? [] : (String) rows[0][0] == name ? rows[0] : flt-assoc(name, rows[1:]);
    def flt-recq() = "(defn-recursive)";
    def flt-fidxq() = "(defn-index)";
    def flt-env-row-value(row, dflt) = (Comparable) len(row) == 0 ? dflt : row[1];
    def flt-current-recursive(env) = flt-env-row-value(flt-assoc(flt-recq(), env), 0);
    def flt-current-fidx(env) = flt-env-row-value(flt-assoc(flt-fidxq(), env), 0);
    def flt-slot(env) = fk-lit((Number) 128 + (Number) ((Number) (flt-current-fidx(env) * 32) + (Number) len(env)));
    // ── recursion-safe let binding on a RESERVED per-call frame block ──
    // A stored let lives at fk_vs[fp+offset] in a block the function reserves at
    // entry (RESERVE), so argument-packing scratch lands ABOVE the block and can
    // never shift a frame let's slot. Each call gets its own fp, so a recursive
    // re-entry reserves its own block — the deepest frame cannot clobber an outer
    // binding. ARG is offset 0; the k-th frame let is offset k = letdepth+1.
    def flt-letdepth-q() = "(defn-letdepth)";
    def flt-current-letdepth(env) = flt-env-row-value(flt-assoc(flt-letdepth-q(), env), 0);
    def fk-farg(off) = fk-node(110, fk-lit(off));
    def fk-letf(off, value, body) = fk-node(109, ms-intern(fk-lit(off), ms-intern(value, body)));
    def fk-reserve(k, body) = fk-node(111, ms-intern(fk-lit(k), body));
    // K = how many frame slots a function reserves. We count "(let " occurrences in
    // the function's SOURCE span — a linear, robust upper bound on the max frame-let
    // offset (sequential do-lets take incrementing offsets, so the deepest chain's
    // let count bounds it; inline/branch lets only over-reserve, never under). This
    // replaces a recipe-tree walk that crashed (as_nid: null) on source-compiled
    // module recipes. Over-reserving is safe: the slots cost value-stack space only.
    def flt-count-lets(s, pos, end) = flt-count-lets-go(s, str_find(s, "(let ", pos), end, 0);
    def flt-count-lets-go(s, found, end, acc) = found < 0 ? acc : found >= end ? acc : flt-count-lets-go(s, str_find(s, "(let ", (Number) found + (Number) 5), end, (Number) acc + (Number) 1);
    def flt-reserve-wrap-k(k, body) = (Comparable) k == 0 ? body : fk-reserve(k, body);
    def flt-mkop(row, a, b) = (Comparable) row[1] == 0 ? fk-node(row[2], fk-lit(0)) : (Comparable) row[1] == 1 ? fk-node(row[2], a) : fk-node(row[2], ms-intern(a, b));
    // ── the curated comparisons, lowered onto LE/IF (the compiler's vocabulary;
    //    the band file itself stays unmodified) ────────────────────────────────
    def flt-gt(a, b) = fk-if(fk-le(a, b), fk-lit(0), fk-lit(1));
    def flt-ge(a, b) = fk-le(b, a);
    // eq/lt are native single-walk walker arms (tags 102/103): each operand is
    // evaluated exactly once, matching le (tag 5) and the reference kernels. The
    // old (le a b)&&(le b a) lowering walked each operand twice — re-firing side
    // effects and doubling the operand sub-tree in the table.
    def flt-lt(a, b) = fk-node(103, ms-intern(a, b));
    def flt-eq(a, b) = fk-node(102, ms-intern(a, b));
    def flt-ne(a, b) = flt-not(flt-eq(a, b));
    def flt-and(a, b) = fk-if(a, fk-if(b, fk-lit(1), fk-lit(0)), fk-lit(0));
    def flt-or(a, b) = fk-if(a, fk-lit(1), fk-if(b, fk-lit(1), fk-lit(0)));
    // unary lowerings: ord rides SCHAR at byte 0; not is the IF flip
    def flt-ord(a) = fk-schar(a, fk-lit(0));
    def flt-not(a) = fk-if(a, fk-lit(0), fk-lit(1));
    def flt-sequence(a, b) = fk-node(69, ms-intern(a, b));
    // ── words off the cursor ───────────────────────────────────────────────────
    def flt-word(s, pos) = substring(s, pos, fp-sym-end(s, pos));
    // head word of a parenthesized form at pos ("" when the item is an atom)
    def flt-peek(s, pos) = pos >= fp-len(s) ? "" : (Comparable) fp-at(s, pos) == 40 ? flt-word(s, fp-skip(s, (Number) pos + (Number) 1)) : "";
    // ── expressions (env-aware; (cell end-pos) pairs, the fp-* discipline) ─────
    def flt-expr(s, pos, fns, env) = flt-expr2(s, fp-skip(s, pos), fns, env);
    def flt-expr2(s, pos, fns, env) = (Comparable) fp-at(s, pos) == 40 ? flt-form(s, fp-skip(s, (Number) pos + (Number) 1), fns, env) : (Comparable) fp-at(s, pos) == 34 ? flt-str(s, (Number) pos + (Number) 1, env) : fp-isdigit(fp-at(s, pos)) ? flt-num(s, pos, env) : (Comparable) fp-at(s, pos) == 45 && fp-isdigit(fp-at(s, (Number) pos + (Number) 1)) ? flt-neg-num(s, pos, env) : flt-var(s, pos, env, fns);
    // a '-' immediately before digits is a negative integer literal
    def flt-neg(ve) = [fk-lit(0 - ve[0]), ve[1]];
    def flt-num(s, pos, env) = flt-num2(s, pos, fp-digits(s, pos, 0), env);
    // a bare integer mantissa followed by a valid exponent (1e-05, no decimal point —
    // Python repr's shape) is still a float; flt-fe-exp returns >ie only for a valid exponent.
    def flt-has-exp(s, ie) = ie < fp-len(s) && ((Comparable) fp-at(s, ie) == 101 || (Comparable) fp-at(s, ie) == 69) ? flt-fe-exp(s, (Number) ie + (Number) 1, ie) > ie : 0;
    def flt-exp-lit(s, ie, whole, start, env) = {
        let end = flt-fe-exp(s, (Number) ie + (Number) 1, ie);
        let lit = substring(s, start, end);
        [fk-f64(flt-sidx(flt-poolv(env), lit, 0), lit), end];
    };
    def flt-num2(s, pos, ve, env) = ve[1] < fp-len(s) && ((Comparable) fp-at(s, ve[1]) == 46 && fp-isdigit(fp-at(s, (Number) ve[1] + (Number) 1))) ? flt-float-lit(s, ve[1], ve[0], pos, env) : (Comparable) flt-has-exp(s, ve[1]) == 1 ? flt-exp-lit(s, ve[1], ve[0], pos, env) : fp-num(ve);
    def flt-neg-num(s, pos, env) = {
        let ve = fp-digits(s, (Number) pos + (Number) 1, 0);
        ve[1] < fp-len(s) && ((Comparable) fp-at(s, ve[1]) == 46 && fp-isdigit(fp-at(s, (Number) ve[1] + (Number) 1))) ? flt-float-lit(s, ve[1], 0 - ve[0], pos, env) : (Comparable) flt-has-exp(s, ve[1]) == 1 ? flt-exp-lit(s, ve[1], 0 - ve[0], pos, env) : flt-neg(ve);
    };
    // consume a run of digits
    def flt-fe-digits(s, pos) = pos < fp-len(s) && fp-isdigit(fp-at(s, pos)) ? flt-fe-digits(s, (Number) pos + (Number) 1) : pos;
    // after the mantissa, consume a scientific-notation exponent (e/E [+/-] digits) if VALID;
    // otherwise stop before the 'e' (ep) so a bare 'e' stays a separate token. strtod parses the
    // captured literal, so the full "1.5e-05" must land in the lit substring (the fkwu float path).
    def flt-fe-exp(s, p, ep) = {
        let q = p < fp-len(s) && ((Comparable) fp-at(s, p) == 43 || (Comparable) fp-at(s, p) == 45) ? (Number) p + (Number) 1 : p;
        q < fp-len(s) && fp-isdigit(fp-at(s, q)) ? flt-fe-digits(s, q) : ep;
    };
    def flt-float-end(s, pos) = {
        let e1 = flt-fe-digits(s, pos);
        e1 < fp-len(s) && ((Comparable) fp-at(s, e1) == 101 || (Comparable) fp-at(s, e1) == 69) ? flt-fe-exp(s, (Number) e1 + (Number) 1, e1) : e1;
    };
    def flt-float-lit(s, dot, whole, start, env) = {
        let end = flt-float-end(s, (Number) dot + (Number) 1);
        let lit = substring(s, start, end);
        [fk-f64(flt-sidx(flt-poolv(env), lit, 0), lit), end];
    };
    // ── string literals ride the pool: the pre-pass (flt-scan) interned every
    //    distinct literal, so a "..." at the cursor lowers to SLIT carrying its
    //    pool index; the pool itself travels in env under the quote-name (a name
    //    no symbol can collide with — '"' is the literal door, never a var) ─────
    def flt-strend(s, pos) = pos >= fp-len(s) ? pos : (Comparable) fp-at(s, pos) == 92 ? flt-strend(s, (Number) pos + (Number) 2) : (Comparable) fp-at(s, pos) == 34 ? pos : flt-strend(s, (Number) pos + (Number) 1);
    def flt-str(s, pos, env) = flt-str2(substring(s, pos, flt-strend(s, pos)), (Number) flt-strend(s, pos) + (Number) 1, env);
    def flt-str2(lit, end, env) = {
        let text = flt-unescape(lit);
        [fk-slit(flt-sidx(flt-poolv(env), text, 0), text), end];
    };
    def flt-unescape(s) = flt-unescape-loop(s, 0, len(s));
    // Split only between escape tokens. Byte slices preserve UTF-8 exactly and
    // logarithmic joins keep a large generated-source literal off the host stack.
    def flt-unescape-slashes(s, i, start, count) = i < start ? count : (Comparable) str_byte_at(s, i) == 92 ? flt-unescape-slashes(s, i - 1, start, (Number) count + (Number) 1) : count;
    def flt-unescape-cut(s, start, mid) = (Number) mid + (Number) (flt-unescape-slashes(s, mid - 1, start, 0) % 2);
    def flt-unescape-halves(s, i, mid, n) = ((String) flt-unescape-loop(s, i, mid) + flt-unescape-loop(s, mid, n));
    def flt-unescape-loop(s, i, n) = n - i <= 1 ? substring(s, i, n) : (Comparable) (n - i) == 2 && (Comparable) str_byte_at(s, i) == 92 ? flt-unescape-char(substring(s, (Number) i + (Number) 1, n)) : flt-unescape-halves(s, i, flt-unescape-cut(s, i, ((Number) i + (Number) n) / 2), n);
    def flt-unescape-char(ch) = (String) ch == "n" ? byte_to_str(10) : (String) ch == "r" ? byte_to_str(13) : (String) ch == "t" ? byte_to_str(9) : (String) ch == "\"" ? byte_to_str(34) : (String) ch == "\\" ? byte_to_str(92) : ch;
    def flt-poolq() = byte_to_str(34);
    def flt-pool-row(env) = flt-assoc(flt-poolq(), env);
    def flt-poolv(env) = flt-pool-row(env)[1];
    def flt-sidx(pool, lit, i) = (Comparable) len(pool) == 0 ? 0 - 1 : (String) pool[0] == lit ? i : flt-sidx(pool[1:], lit, (Number) i + (Number) 1);
    def flt-var(s, pos, env, fns) = flt-var2(flt-word(s, pos), fp-sym-end(s, pos), env, fns);
    def flt-var2(name, end, env, fns) = (String) name == "true" ? [fk-lit(1), end] : (String) name == "false" ? [fk-lit(0), end] : [flt-var3(flt-assoc(name, env), name, fns), end];
    def flt-var3(row, name, fns) = (Comparable) len(row) == 0 ? flt-fref3(flt-assoc(name, fns), fk-lit(0)) : row[1];
    def flt-fref(row) = fk-cons(fk-lit(row[1]), fk-cons(fk-lit(row[2]), fk-empty()));
    def flt-fref3(row, dflt) = (Comparable) len(row) == 0 ? dflt : flt-fref(row);
    def flt-form(s, pos, fns, env) = flt-form2(flt-word(s, pos), s, fp-sym-end(s, pos), fns, env);
    def flt-form2(op, s, pos, fns, env) = (String) op == "if" ? flt-if(s, pos, fns, env) : (String) op == "list" ? flt-list(s, pos, fns, env) : (String) op == "empty" ? [fk-empty(), fp-close(s, pos)] : (String) op == "do" ? flt-do(s, pos, fns, env, fk-lit(0)) : (String) op == "gt" ? flt-low(1, s, pos, fns, env) : (String) op == "ge" ? flt-low(2, s, pos, fns, env) : (String) op == "lt" ? flt-low(3, s, pos, fns, env) : (String) op == "eq" ? flt-low(4, s, pos, fns, env) : (String) op == "ne" ? flt-low(7, s, pos, fns, env) : (String) op == "and" ? flt-low(5, s, pos, fns, env) : (String) op == "or" ? flt-low(6, s, pos, fns, env) : (String) op == "char_at" ? flt-char-at(s, pos, fns, env) : (String) op == "ord" ? flt-low1(1, s, pos, fns, env) : (String) op == "not" ? flt-low1(2, s, pos, fns, env) : (String) op == "record_new" ? flt-record-new(s, pos, fns, env) : (String) op == "bp" ? flt-bp(s, pos, fns, env) : flt-op(op, s, pos, fns, env);
    // one operand, then the unary lowering picked by selector k
    def flt-low1(k, s, pos, fns, env) = flt-low1-a(k, s, flt-expr(s, pos, fns, env));
    def flt-low1-a(k, s, ae) = [flt-low1-mk(k, ae[0]), fp-close(s, ae[1])];
    def flt-low1-mk(k, a) = (Comparable) k == 1 ? flt-ord(a) : flt-not(a);
    // ── nested (do ...) as an EXPRESSION (let-in-defn, do-in-do) ──────────────
    // The same structural recursion as the top-level do-walker, scoped to a
    // value position: an effecting (let name v), and a non-recursive direct-call
    // pure let, walks v once, stores it in a per-function RAM slot, and binds a
    // load cell into env for the REST of the do. Other pure values keep the old
    // inline lowering so recursive/local compute does not contend on global slots. The
    // last expression is the do's value. Nesting falls out of flt-expr — a
    // child that is itself (do ...) re-enters here with its own env tail.
