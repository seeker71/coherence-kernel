    //    literal's pool index is stable between flatten and serialization ──────
    def flt-scan(s, pos, acc) = flt-scan-at(s, fp-skip(s, pos), acc);
    def flt-scan-at(s, pos, acc) = pos >= fp-len(s) ? acc : (Comparable) fp-at(s, pos) == 34 ? flt-scan-lit(s, (Number) pos + (Number) 1, acc) : fp-isdigit(fp-at(s, pos)) ? flt-scan-num(s, pos, acc) : (Comparable) fp-at(s, pos) == 45 && fp-isdigit(fp-at(s, (Number) pos + (Number) 1)) ? flt-scan-neg-num(s, pos, acc) : flt-scan(s, flt-scan-adv(s, pos), acc);
    def flt-scan-adv(s, pos) = fp-sym-end(s, pos) > pos ? fp-sym-end(s, pos) : (Number) pos + (Number) 1;
    def flt-scan-lit(s, pos, acc) = flt-scan-lit2(s, flt-strend(s, pos), substring(s, pos, flt-strend(s, pos)), acc);
    def flt-scan-lit2(s, end, lit, acc) = flt-scan(s, (Number) end + (Number) 1, flt-pool-add(acc, flt-unescape(lit)));
    def flt-scan-num(s, pos, acc) = flt-scan-num2(s, pos, fp-digits(s, pos, 0), acc);
    def flt-scan-neg-num(s, pos, acc) = flt-scan-num2(s, pos, fp-digits(s, (Number) pos + (Number) 1, 0), acc);
    def flt-scan-num2(s, pos, ve, acc) = ve[1] < fp-len(s) && ((Comparable) fp-at(s, ve[1]) == 46 && fp-isdigit(fp-at(s, (Number) ve[1] + (Number) 1))) ? flt-scan-float(s, pos, flt-float-end(s, (Number) ve[1] + (Number) 1), acc) : (Comparable) flt-has-exp(s, ve[1]) == 1 ? flt-scan-float(s, pos, flt-fe-exp(s, (Number) ve[1] + (Number) 1, ve[1]), acc) : flt-scan(s, ve[1], acc);
    def flt-scan-float(s, pos, end, acc) = flt-scan(s, end, flt-pool-add(acc, substring(s, pos, end)));
    def flt-pool-add(pool, lit) = flt-sidx(pool, lit, 0) >= 0 ? pool : flt-append(pool, lit);
    def flt-append(xs, x) = (Comparable) len(xs) == 0 ? cons(x, []) : cons(xs[0], flt-append(xs[1:], x));
    // ── entry doors ────────────────────────────────────────────────────────────
    // module source + band source -> the walker's function list (fn 0 = the
    // band's verdict expression; module/band defns at their CALL indices)
    // (local reverse keeps this lane core.fk-free — the audit's emit drivers
    // load plain-Form preludes only)
    def flt-rev(xs, acc) = (Comparable) len(xs) == 0 ? acc : flt-rev(xs[1:], cons(xs[0], acc));
    // the pool doors mirror the fns doors: the SAME scan order feeds both, so a
    // SLIT row's index always names the right string-section entry
    def flt-band-pool(modsrc, bandsrc) = flt-scan(bandsrc, 0, flt-scan(modsrc, 0, []));
    def flt-src-pool(src) = flt-scan(src, 0, []);
    def flt-srcs-pool(srcs, acc) = (Comparable) len(srcs) == 0 ? acc : flt-srcs-pool(srcs[1:], flt-scan(srcs[0], 0, acc));
    def flt-band-sources-pool(modsrcs, bandsrc) = flt-scan(bandsrc, 0, flt-srcs-pool(modsrcs, []));
    def flt-band-fns(modsrc, bandsrc) = flt-band-fns2(modsrc, bandsrc, flt-band-pool(modsrc, bandsrc));
    def flt-band-fns2(modsrc, bandsrc, pool) = flt-band2(flt-top(modsrc, [], [], pool), bandsrc, pool);
    def flt-band2(mr, bandsrc, pool) = flt-band-join(mr, bandsrc, flt-top-env-snap(bandsrc, mr[0], mr[1], pool, mr[4]));
    def flt-band-join(mr, bandsrc, br) = flt-band3(bandsrc, [br[0], br[1], flt-sequence(mr[2], br[2]), br[3], br[4]]);
    def flt-band3(bandsrc, br) = cons(flt-reserve-wrap-k(flt-count-lets(bandsrc, 0, len(bandsrc)), br[2]), flt-rev(br[1], []));
    def flt-modsrcs-top(modsrcs, fns, rbodies, pool) = flt-modsrcs-top-env(modsrcs, fns, rbodies, pool, []);
    def flt-modsrcs-top-env(modsrcs, fns, rbodies, pool, env) = (Comparable) len(modsrcs) == 0 ? [fns, rbodies, fk-lit(0), 0, env] : flt-modsrcs-top2(flt-top-env(modsrcs[0], fns, rbodies, pool, env), modsrcs[1:], pool);
    def flt-modsrcs-top2(mr, rest, pool) = flt-modsrcs-join(mr, flt-modsrcs-top-env(rest, mr[0], mr[1], pool, mr[4]));
    def flt-modsrcs-join(mr, next) = [next[0], next[1], flt-sequence(mr[2], next[2]), next[3], next[4]];
    def flt-band-sources-fns(modsrcs, bandsrc) = flt-band-sources-fns2(modsrcs, bandsrc, flt-band-sources-pool(modsrcs, bandsrc));
    def flt-source-signatures(srcs, fns) = (Comparable) len(srcs) == 0 ? fns : flt-source-signatures(srcs[1:], flt-sig-scan(srcs[0], 0, fns));
    // Future functions contribute declarations only. Bodies, lexical bindings and
    // module initializers keep their original order; an existing binding wins.
    // The first future definition supplies the exact eventual function-table slot.
    def flt-band-sources-fns2(modsrcs, bandsrc, pool) = flt-band2(flt-modsrcs-top-env(modsrcs, [], [], pool, [[flt-forwardq(), flt-rev(flt-sig-scan(bandsrc, 0, flt-source-signatures(modsrcs, [])), [])]]), bandsrc, pool);
    // Compatibility door: older bands pass one list whose last source is the
    // band and whose earlier sources are modules. Keep it as a stable recipe
    // while new callers use the explicit band-sources door.
    def flt-srcs-mods(srcs, acc) = (Comparable) len(srcs) == 0 ? acc : (Comparable) len(srcs[1:]) == 0 ? acc : flt-srcs-mods(srcs[1:], flt-append(acc, srcs[0]));
    def flt-srcs-last(srcs) = (Comparable) len(srcs[1:]) == 0 ? srcs[0] : flt-srcs-last(srcs[1:]);
    def flt-srcs-fns(srcs) = (Comparable) len(srcs) == 0 ? [] : flt-band-sources-fns(flt-srcs-mods(srcs, []), flt-srcs-last(srcs));
    // single-source door (prelude-free bands, mini programs)
    def flt-src-fns(src) = flt-band3(src, flt-top(src, [], [], flt-src-pool(src)));
}
