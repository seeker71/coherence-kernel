; living-world-session-observation.fk -- privacy-minimized real-session
; evidence may reach the living world only through explicit scoped consent.
;
; The membrane has no field for prompt text, answer text, session text, path
; labels, or model output.  Its report codec accepts only three canonical
; digest identities and bounded aggregate integers.  Candidate and contract
; identity form the offered context; the exact aggregate placement is the
; offered next cell; dataset identity remains in provenance.  Identical reruns
; over one dataset therefore collapse to one attribution, while a distinct
; dataset can add evidence without adding another vote for the same owner.
;
; Consent is an explicit content-addressed cell scoped to owner, dataset,
; purpose, interface action, optional lens, and optional expiry.  Missing,
; malformed, mismatched, or non-revocable consent crosses no source or payload.
; Immediate refusal is ZERO.  Expiry is distinct and condenses to the sender's
; optional declared acknowledgement, or NOTHING when none was declared.
;
; This is observation-only evidence.  It grants no promotion, training,
; publication, relationship-memory, or answer authority.
;
; witnessed: 2026-08-08 -> 1048575 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/native-model-evidence.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-transition-field.fk

(let LWRS-DIGEST  (bp "LWRS-DIGEST"))
(let LWRS-METRICS (bp "LWRS-METRICS"))
(let LWRS-REPORT  (bp "LWRS-REPORT"))
(let LWRS-CONSENT (bp "LWRS-CONSENT"))
(let LWRS-OUTCOME (bp "LWRS-OUTCOME"))

(defn lwrs-digest (value)
    (intern_node LWRS-DIGEST (list (intern_trivial_string value))))
(defn lwrs-digest? (cell)
    (if (and (eq (lwo-category? cell LWRS-DIGEST) 1)
             (eq (len (node_children cell)) 1))
        (nmfe-sha256? (node_value (nth (node_children cell) 0))) 0))
(defn lwrs-digest-value (cell)
    (node_value (nth (node_children cell) 0)))

(defn lwrs-int-cell? (cell)
    (if (and (eq (node_level cell) 1)
             (eq (node_type cell) 1)) 1 0))
(defn lwrs-int-items? (items)
    (if (eq (len items) 0) 1
        (if (eq (lwrs-int-cell? (head items)) 1)
            (lwrs-int-items? (tail items)) 0)))
(defn lwrs-flag? (value)
    (if (or (eq value 0) (eq value 1)) 1 0))

; Aggregate fields, in order: source sessions, root sessions, completed pairs,
; labeled pairs, source-index candidates, admitted candidates, replayed
; queries, top-1/top-3/top-5 hits, MRR5 ppm, replay-valid, timeout.
(defn lwrs-metrics
    (source root completed labeled source-index admitted replayed
     hit1 hit3 hit5 mrr5 valid timeout)
    (intern_node LWRS-METRICS
        (list (intern_trivial_int source)
              (intern_trivial_int root)
              (intern_trivial_int completed)
              (intern_trivial_int labeled)
              (intern_trivial_int source-index)
              (intern_trivial_int admitted)
              (intern_trivial_int replayed)
              (intern_trivial_int hit1)
              (intern_trivial_int hit3)
              (intern_trivial_int hit5)
              (intern_trivial_int mrr5)
              (intern_trivial_int valid)
              (intern_trivial_int timeout))))
(defn lwrs-metrics-value (metrics index)
    (node_value (nth (node_children metrics) index)))
(defn lwrs-metrics-source (metrics) (lwrs-metrics-value metrics 0))
(defn lwrs-metrics-root (metrics) (lwrs-metrics-value metrics 1))
(defn lwrs-metrics-completed (metrics) (lwrs-metrics-value metrics 2))
(defn lwrs-metrics-labeled (metrics) (lwrs-metrics-value metrics 3))
(defn lwrs-metrics-source-index (metrics) (lwrs-metrics-value metrics 4))
(defn lwrs-metrics-admitted (metrics) (lwrs-metrics-value metrics 5))
(defn lwrs-metrics-replayed (metrics) (lwrs-metrics-value metrics 6))
(defn lwrs-metrics-hit1 (metrics) (lwrs-metrics-value metrics 7))
(defn lwrs-metrics-hit3 (metrics) (lwrs-metrics-value metrics 8))
(defn lwrs-metrics-hit5 (metrics) (lwrs-metrics-value metrics 9))
(defn lwrs-metrics-mrr5 (metrics) (lwrs-metrics-value metrics 10))
(defn lwrs-metrics-valid (metrics) (lwrs-metrics-value metrics 11))
(defn lwrs-metrics-timeout (metrics) (lwrs-metrics-value metrics 12))

(defn lwrs-metrics-shape-valid? (metrics)
    (if (and (eq (lwo-category? metrics LWRS-METRICS) 1)
             (eq (len (node_children metrics)) 13))
        (lwrs-int-items? (node_children metrics)) 0))

(defn lwrs-metrics-valid? (metrics)
    (if (eq (lwrs-metrics-shape-valid? metrics) 0) 0
        (if (and (ge (lwrs-metrics-source metrics) 0)
                 (and (ge (lwrs-metrics-root metrics) 0)
                 (and (le (lwrs-metrics-root metrics)
                          (lwrs-metrics-source metrics))
                 (and (ge (lwrs-metrics-completed metrics) 0)
                 (and (ge (lwrs-metrics-labeled metrics) 0)
                 (and (le (lwrs-metrics-labeled metrics)
                          (lwrs-metrics-completed metrics))
                 (and (ge (lwrs-metrics-source-index metrics) 0)
                 (and (ge (lwrs-metrics-admitted metrics) 0)
                 (and (le (lwrs-metrics-admitted metrics)
                          (lwrs-metrics-source-index metrics))
                 (and (ge (lwrs-metrics-replayed metrics) 0)
                 (and (ge (lwrs-metrics-hit1 metrics) 0)
                 (and (le (lwrs-metrics-hit1 metrics)
                          (lwrs-metrics-hit3 metrics))
                 (and (le (lwrs-metrics-hit3 metrics)
                          (lwrs-metrics-hit5 metrics))
                 (and (le (lwrs-metrics-hit5 metrics)
                          (lwrs-metrics-replayed metrics))
                 (and (ge (lwrs-metrics-mrr5 metrics) 0)
                 (and (le (lwrs-metrics-mrr5 metrics) 1000000)
                 (and (eq (lwrs-flag?
                            (lwrs-metrics-valid metrics)) 1)
                 (and (eq (lwrs-flag?
                            (lwrs-metrics-timeout metrics)) 1)
                      (if (eq (lwrs-metrics-valid metrics) 1)
                          (if (and (gt (lwrs-metrics-replayed metrics) 0)
                                   (eq (lwrs-metrics-timeout metrics) 0)) 1 0)
                          1))))))))))))))))))) 1 0)))

; children: dataset, candidate set, evaluation contract, aggregate metrics,
; local path.  Exact report-instance identity is deliberately absent.
(defn lwrs-report (dataset candidate contract metrics)
    (intern_node LWRS-REPORT
        (list dataset candidate contract metrics (lwo-local-path))))
(defn lwrs-report? (cell) (lwo-category? cell LWRS-REPORT))
(defn lwrs-report-dataset (report) (nth (node_children report) 0))
(defn lwrs-report-candidate (report) (nth (node_children report) 1))
(defn lwrs-report-contract (report) (nth (node_children report) 2))
(defn lwrs-report-metrics (report) (nth (node_children report) 3))
(defn lwrs-report-valid? (report)
    (if (and (eq (lwrs-report? report) 1)
             (eq (len (node_children report)) 5))
        (if (and (eq (lwrs-digest? (lwrs-report-dataset report)) 1)
                 (and (eq (lwrs-digest?
                            (lwrs-report-candidate report)) 1)
                      (and (eq (lwrs-digest?
                                (lwrs-report-contract report)) 1)
                           (eq (lwrs-metrics-valid?
                                (lwrs-report-metrics report)) 1)))) 1 0)
        0))

; The outcome is an aggregate placement, not an answer or promotion decision.
(defn lwrs-outcome (metrics)
    (intern_node LWRS-OUTCOME
        (list (intern_trivial_int (lwrs-metrics-replayed metrics))
              (intern_trivial_int (lwrs-metrics-hit1 metrics))
              (intern_trivial_int (lwrs-metrics-hit3 metrics))
              (intern_trivial_int (lwrs-metrics-hit5 metrics))
              (intern_trivial_int (lwrs-metrics-mrr5 metrics))
              (lwo-local-path))))
(defn lwrs-outcome? (cell) (lwo-category? cell LWRS-OUTCOME))

(defn lwrs-context (report)
    (lwtf-context
        (list (lwrs-report-candidate report)
              (lwrs-report-contract report))))
(defn lwrs-observation (report lens)
    (lwtf-observation (lwrs-context report)
        (lwrs-outcome (lwrs-report-metrics report)) lens))

; children: owner, dataset, purpose, offered interface, optional lens, optional
; expiry integer, optional expiry acknowledgement, revocable, receipt, path
(defn lwrs-consent
    (owner dataset purpose interface lens expiry expiry-default
     revocable receipt)
    (intern_node LWRS-CONSENT
        (list owner dataset purpose interface lens expiry expiry-default
              (intern_trivial_int revocable)
              (intern_trivial_int receipt)
              (lwo-local-path))))
(defn lwrs-consent? (cell) (lwo-category? cell LWRS-CONSENT))
(defn lwrs-consent-owner (consent) (nth (node_children consent) 0))
(defn lwrs-consent-dataset (consent) (nth (node_children consent) 1))
(defn lwrs-consent-purpose (consent) (nth (node_children consent) 2))
(defn lwrs-consent-interface (consent) (nth (node_children consent) 3))
(defn lwrs-consent-lens (consent) (nth (node_children consent) 4))
(defn lwrs-consent-expiry (consent) (nth (node_children consent) 5))
(defn lwrs-consent-expiry-default (consent)
    (nth (node_children consent) 6))
(defn lwrs-consent-revocable (consent)
    (node_value (nth (node_children consent) 7)))
(defn lwrs-consent-receipt (consent)
    (node_value (nth (node_children consent) 8)))

(defn lwrs-expiry-shape-valid? (expiry)
    (if (node_eq expiry (lwo-none)) 1 (lwrs-int-cell? expiry)))
(defn lwrs-expiry-default-valid? (ack)
    (if (node_eq ack (lwo-none)) 1 (oac-valid-ack? ack)))
(defn lwrs-consent-shape-valid? (consent)
    (if (and (eq (lwrs-consent? consent) 1)
             (eq (len (node_children consent)) 10))
        (if (and (not (node_eq (lwrs-consent-owner consent) (lwo-none)))
                 (and (eq (lwrs-digest?
                            (lwrs-consent-dataset consent)) 1)
                 (and (eq (lwo-category?
                            (lwrs-consent-interface consent) LWO-FIELD) 1)
                 (and (eq (lwrs-expiry-shape-valid?
                            (lwrs-consent-expiry consent)) 1)
                 (and (eq (lwrs-expiry-default-valid?
                            (lwrs-consent-expiry-default consent)) 1)
                 (and (eq (lwrs-flag?
                            (lwrs-consent-revocable consent)) 1)
                      (eq (lwrs-flag?
                            (lwrs-consent-receipt consent)) 1))))))) 1 0)
        0))

(defn lwrs-consent-scopes? (consent report action)
    (if (and (node_eq (lwrs-consent-dataset consent)
                      (lwrs-report-dataset report))
             (eq (lwo-field-has?
                    (lwrs-consent-interface consent) action) 1)) 1 0))
(defn lwrs-consent-expired? (consent now)
    (if (node_eq (lwrs-consent-expiry consent) (lwo-none)) 0
        (if (le (node_value (lwrs-consent-expiry consent)) now) 1 0)))
(defn lwrs-expiry-ack (consent)
    (if (node_eq (lwrs-consent-expiry-default consent) (lwo-none))
        (oac-nothing) (lwrs-consent-expiry-default consent)))

(defn lwrs-content-blind-refusal (world action ack)
    (do
        (let refused
            (lwo-receive world
                (lwo-offer (lwo-none) (lwo-empty-field) 0
                    (lwo-none) (lwo-none) 0)
                action))
        (lwo-transition (lwo-transition-world refused) ack)))

(defn lwrs-receive (world report consent action now)
    (if (or (eq (lwrs-report-valid? report) 0)
            (eq (lwrs-consent-shape-valid? consent) 0))
        (lwrs-content-blind-refusal world action (oac-zero))
        (if (or (eq (lwrs-consent-scopes? consent report action) 0)
                (or (eq (lwrs-consent-revocable consent) 0)
                    (eq (lwrs-consent-receipt consent) 0)))
            (lwrs-content-blind-refusal world action (oac-zero))
            (if (eq (lwrs-consent-expired? consent now) 1)
                (lwrs-content-blind-refusal world action
                    (lwrs-expiry-ack consent))
                (lwo-receive world
                    (lwo-offer
                        (lwrs-consent-owner consent)
                        (lwrs-consent-interface consent) 1
                        (lwrs-observation report
                            (lwrs-consent-lens consent))
                        report 1)
                    action)))))

0
