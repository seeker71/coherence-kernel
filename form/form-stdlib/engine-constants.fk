// Form-owned rows and source emission for engine constant getters.
// engine.fk carries their rendered source.
// Factory helpers still calling the seed bp operation receive string categories;
// fol-bp supplies canonical NodeIDs to the native category loader and Python lifter.
// preludes: form-stdlib/core.fk
section [form.bml] {
    let FOL-ENGINE-FACTORY-ROWS = [["bmf-domain-python", "bmf-domain-ref", 1], ["bmf-domain-typescript", "bmf-domain-ref", 2], ["bmf-domain-go", "bmf-domain-ref", 3], ["bmf-domain-rust", "bmf-domain-ref", 4], ["bmf-domain-bml", "bmf-domain-ref", 5], ["bmf-domain-natural", "bmf-domain-ref", 6], ["bmf-domain-image", "bmf-domain-ref", 7], ["bmf-domain-audio", "bmf-domain-ref", 8], ["bmf-domain-video", "bmf-domain-ref", 9], ["bmf-domain-prolog", "bmf-domain-ref", 10], ["bmf-domain-kind-language", "bmf-domain-kind-ref", 1], ["bmf-domain-kind-media", "bmf-domain-kind-ref", 2], ["bmf-domain-kind-runtime", "bmf-domain-kind-ref", 3], ["bmf-lens-assertion", "bmf-lens-ref", 1], ["bmf-lens-metadata", "bmf-lens-ref", 2], ["bmf-lens-assign", "bmf-lens-ref", 3], ["bmf-lens-var", "bmf-lens-ref", 4], ["bmf-lens-quote", "bmf-lens-ref", 5], ["bmf-lens-display", "bmf-lens-ref", 6]];
    let FOL-ENGINE-STRING-ROWS = [["bmf-semantic-natural-language", "natural-language"], ["bmf-semantic-image", "image"], ["bmf-semantic-audio", "audio"], ["bmf-semantic-video", "video"], ["bmf-semantic-general", "general"], ["bmf-semantic-knowledge", "knowledge"], ["bmf-context-key-language-tag", "language-tag"], ["bmf-context-key-locale", "locale"], ["bmf-context-key-script", "script"], ["bmf-context-key-region", "region"], ["bmf-context-key-direction", "direction"], ["bmf-context-key-calendar", "calendar"], ["bmf-context-key-numbering-system", "numbering-system"], ["bmf-context-key-time-zone", "time-zone"], ["bmf-context-key-semantic-domain", "semantic-domain"], ["bmf-context-key-culture", "culture"], ["bmf-context-key-register", "register"], ["bmf-context-key-environment", "environment"], ["bmf-context-key-audience", "audience"], ["bmf-context-key-purpose", "purpose"], ["bmf-context-key-viewpoint", "viewpoint"], ["bmf-context-key-media-type", "media-type"], ["bmf-context-key-charset", "charset"], ["bmf-context-key-encoding", "encoding"], ["bmf-context-key-container", "container"], ["bmf-context-key-codec", "codec"], ["bmf-context-key-unit", "unit"], ["bmf-context-key-color-space", "color-space"], ["bmf-context-key-source", "source"], ["bmf-context-key-creator", "creator"], ["bmf-context-key-license", "license"], ["bmf-context-key-created", "created"], ["bmf-context-key-derived-from", "derived-from"], ["bmf-locale-und", "und"], ["bmf-locale-en-us", "en-US"], ["bmf-locale-id-id", "id-ID"], ["bmf-script-latn", "Latn"], ["bmf-direction-auto", "auto"], ["bmf-direction-ltr", "ltr"], ["bmf-direction-rtl", "rtl"], ["bmf-register-plain", "plain"], ["bmf-register-math", "math"], ["bmf-register-formal", "formal"], ["bmf-environment-general", "general"], ["bmf-environment-file", "file"], ["bmf-environment-repo", "repo"], ["bmf-environment-web", "web"], ["bmf-purpose-representation", "representation"], ["bmf-purpose-roundtrip", "roundtrip"], ["bmf-calendar-gregory", "gregory"], ["bmf-numbering-latn", "latn"], ["bmf-media-text-plain", "text/plain"], ["bmf-media-octet-stream", "application/octet-stream"], ["bmf-media-image-svg", "image/svg+xml"], ["bmf-media-image-gif", "image/gif"], ["bmf-charset-utf8", "utf-8"], ["bmf-encoding-xml", "xml"], ["bmf-encoding-binary", "binary"], ["bmf-container-text", "text"], ["bmf-unit-px", "px"], ["bmf-unit-samples", "samples"], ["bmf-unit-px-ms", "px/ms"], ["bmf-color-srgb", "sRGB"]];
    //; --- materialised engine constants: the rows as SOURCE TEXT ----------
    //; fkwu compiles positionally: every call site resolves at compile, dead or
    //; live, so constants installed by a runtime walk exist too late for it —
    //; engine.fk's own bmf-context-key-* mentions stayed loud errors on the fkwu
    //; source lane even in bands that never call them. The rows above stay the one
    //; authority; these emitters render them as plain zero-arg defns, engine.fk
    //; carries that render inline between exact markers, and a band folds
    //; render == carried so the copy cannot drift silently. Nothing host-special:
    //; the same text compiles identically on every arm.
    def fol-emit-factory-defn(row) = str_concat("    (defn ", str_concat(head(row), str_concat(" () (", str_concat(head(tail(row)), str_concat(" ", str_concat(int_to_str(head(tail(tail(row)))), "))
"))))));
    def fol-emit-string-defn(row) = str_concat("    (defn ", str_concat(head(row), str_concat(" () \"", str_concat(head(tail(row)), "\")
"))));
    def fol-emit-rows(rows, emit, acc) = (Comparable) len(rows) == 0 ? acc : fol-emit-rows(tail(rows), emit, str_concat(acc, emit(head(rows))));
    def fol-engine-constants-open() = ";; === GENERATED engine constants — authority: form-ontology-loader.fk rows ===
";
    def fol-engine-constants-close() = "    ;; === END GENERATED engine constants ===
";
    def fol-engine-constants-text() = str_concat(fol-engine-constants-open(), str_concat(fol-emit-rows(FOL-ENGINE-FACTORY-ROWS, fol-emit-factory-defn, ""), str_concat(fol-emit-rows(FOL-ENGINE-STRING-ROWS, fol-emit-string-defn, ""), fol-engine-constants-close())));
}
