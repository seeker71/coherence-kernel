// Exercise real seed, statistics, Adam, refusal and judge-zero operations.
// Eight two-float buffers; no model, training rows or adapter export.
// Requires Metal. Verdict 511; a failure returns an error after freeing buffers.
import form-stdlib/bml/qwen-last-block-judge.bml;
import form-stdlib/metal-carrier.bml;
section [form.bml] {
 class QwenTrainingGpuTurnBand {
  def qtg-free-turn?() = !gpl-inheritable?(gpl-read(gpu-lease-path()));
  def qtg-bytes(h) = metal_buf_read(h,0,8);
  def qtg-pair(h) = qlt-f32s(qtg-bytes(h),2);
  def qtg-zero?(h) = qtg-bytes(h) == nam-f32s([0.0,0.0]);
  def qtg-bit(ok,bit) = ok ? bit : 0;
  def qtg-run() {
   let home=host_dir_mkdir(".hearth");
   let carrier=mca-admit(".hearth/qtg-carrier.log",".hearth/qtg-carrier.err");
   let hs=range(0,8) |> map(i => metal_buf_alloc(8));
   let rec=[4,0,0,hs[0],hs[1],0,2,1,2,md-f32-bits(1.0),1];
   let o=record_new(0,"rec",rec,"fill",metal_pipeline(qlbw-msl(),"form_hash_fill_f32"),"dA",hs[2],"dB",hs[3],"mA",hs[4],"vA",hs[5],"mB",hs[6],"vB",hs[7]);
   let allocated=all?(h => h > 0,hs) && record_get(o,"fill") > 0;
   let seed=qlbt-seed(o,0.01);
   let a0=qtg-pair(hs[0]);
   let seeded=all?(v => v == v,a0) && all?(qtg-zero?,[hs[1],hs[4],hs[5],hs[6],hs[7]]);
   let seed-free=qtg-free-turn?();
   let ga=metal_buf_write(hs[2],0,nam-f32s([1.0,0.0-1.0]));
   let gb=metal_buf_write(hs[3],0,nam-f32s([2.0,0.0-2.0]));
   let health=qlbt-grad-health(o);
   let health-free=qtg-free-turn?();
   let norm=qlbt-step(o,0.01,1);
   let a1=qtg-pair(hs[0]); let b1=qtg-pair(hs[1]);
   let step-free=qtg-free-turn?();
   let params=[hs[0],hs[1],hs[4],hs[5],hs[6],hs[7]];
   let before=map(qtg-bytes,params);
   let bad=metal_buf_write(hs[2],0,md-le32-list([2143289344,0],""));
   let rejected=try { qlbt-step(o,0.01,2); 0; } catch 1;
   let unchanged=before == map(qtg-bytes,params);
   let failed-free=qtg-free-turn?();
   let cleared=qlbj-zero(o);
   let zeroed=qtg-zero?(hs[0]) && qtg-zero?(hs[1]) && qtg-free-turn?();
   let freed=q38-free-handles(hs);
   let score=qtg-bit(allocated,1)
    + qtg-bit(seeded,2)
    + qtg-bit(health[0] == 0 && health[1] > 9.999 && health[1] < 10.001,4)
    + qtg-bit(norm > 3.16 && norm < 3.17 && a1[0] < a0[0] && a1[1] > a0[1] && b1[0] < 0.0 && b1[1] > 0.0,8)
    + qtg-bit(rejected && unchanged,16)
    + qtg-bit(seed-free && health-free && step-free,32)
    + qtg-bit(failed-free,64)
    + qtg-bit(zeroed,128)
    + qtg-bit(freed == 8,256);
   print(["qwen-training-gpu-turn-band",score,"freed",freed]);
   score == 511 ? score : form_error("qwen training GPU turn contract failed");
  }
 }
 qtg-run();
}
