; living-world-relational-voice-band.fk -- learned relation, not position, speaks.
; Verdict 32767 proves fifteen relational-native voice and optionality claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk form-stdlib/tests/living-world-relational-voice-witness.fk

(do
    (let world (lwrvw-world))
    (let context (lwrvw-context-for world))
    (let context-world (lwcp-context-world context))
    (let proposal (lwrvw-proposal-for world))
    (let candidate (lwt-proposal-candidate proposal))
    (let utterance (lwo-emergent-shape candidate))
    (let plan (lwrv-utterance-plan utterance))
    (let plan-items
        (lwrp-sequence-items (lwrp-plan-sequence plan)))
    (let waiting (lwrv-integrate (lwrvw-round) proposal (lwrew-action)))
    (let integrated (lwrvw-integrated-round))
    (let integrated-world (lwt-round-world integrated))
    (let ambiguous
        (lwrv-plan-for context (lwrvw-other-relation) (lwrvw-nodes)))
    (let late (lwrvw-late-world))

    (let c1 (if (and (eq (lwnv-symbol-positioned?
                              (lwo-emergent-shape (lwrvw-left))) 0)
                         (eq (lwnv-symbol-positioned?
                              (lwo-emergent-shape (lwrvw-right))) 0)) 1 0))
    (let c2 (if (and (node_eq
                          (lwnv-symbol-coordinate
                            (lwo-emergent-shape (lwrvw-left)))
                          (lwrvw-slot-left))
                         (node_eq
                          (lwnv-symbol-coordinate
                            (lwo-emergent-shape (lwrvw-right)))
                          (lwrvw-slot-right))) 2 0))
    (let c3 (if (and (eq (lwsl-integrated-current?
                              context-world (lwrvw-left)) 1)
                         (and (eq (lwsl-integrated-current?
                                   context-world (lwrvw-right)) 1)
                              (eq (lwrl-integrated-current?
                                   context-world (lwrvw-edge)) 1))) 4 0))
    (let c4 (if (and (eq (lwrp-ready?
                              (lwrp-plan-status plan)) 1)
                         (and (eq (len plan-items) 2)
                              (and (node_eq (nth plan-items 0)
                                      (lwrvw-left))
                                   (node_eq (nth plan-items 1)
                                      (lwrvw-right))))) 8 0))
    (let c5 (if (str_eq (lwrv-utterance-surface utterance)
                         "forty-nine") 16 0))
    (let c6 (if (and (eq (lwo-field-size
                              (lwrv-utterance-alternatives utterance)) 0)
                         (and (node_eq (lwrv-utterance-unknown utterance)
                                      (lwo-none))
                              (node_eq (lwrv-utterance-choice utterance)
                                       (lwo-none)))) 32 0))
    (let c7 (if (and (eq (lwo-field-size
                              (lwrp-group-edges
                                (lwrp-plan-group plan))) 1)
                         (eq (lwo-field-size
                              (lwrv-utterance-witnesses utterance)) 10)) 64 0))
    (let c8 (if (eq (lwo-field-size
                         (lwt-proposal-participants proposal)) 6) 128 0))
    (let c9 (if (and (eq (lwcp-context-current? world context) 1)
                         (eq (lwrv-utterance-current?
                              world utterance) 1)) 256 0))
    (let c10 (if (eq (lwo-world-has?
                          (lwt-round-world waiting) candidate) 0) 512 0))
    (let c11 (if (and (eq (lwo-active?
                               integrated-world candidate) 1)
                          (eq (lwo-field-size
                               (lwo-active-attributions-for
                                 integrated-world candidate)) 6)) 1024 0))
    (let c12 (if (eq (lwrv-proposal-current?
                          integrated-world proposal) 1) 2048 0))
    (let c13 (if (and (eq (lwrp-ambiguous?
                               (lwrp-plan-status ambiguous)) 1)
                          (and (eq (lwo-field-size
                                    (lwrp-plan-alternatives ambiguous)) 2)
                               (node_eq
                                (lwrv-emit context (lwrvw-basis)
                                  (lwrvw-referent)
                                  (lwrvw-other-relation) (lwrvw-nodes)
                                  (lwo-empty-field) (lwo-none) (lwo-none)
                                  (lwrvw-evidence))
                                (lwo-none)))) 4096 0))
    ; The late inverse is outside the old capability context. Context identity
    ; remains current, but full-world relation evidence reopens the utterance.
    (let c14 (if (and (eq (lwcp-context-current? late context) 1)
                          (and (eq (lwrv-utterance-current?
                                    late utterance) 0)
                               (eq (lwrv-proposal-current?
                                    late proposal) 0))) 8192 0))
    (let c15 (if (and (node_eq
                           (lwnv-sequence-for context-world
                             (lwrvw-referent)) (lwo-none))
                          (and (eq (lwo-active? context-world
                                   (lwo-emergent-shape (lwrvw-left))) 0)
                               (eq (lwo-active? context-world
                                   (lwo-emergent-shape (lwrvw-right))) 0)))
                      16384 0))
    (lwrvw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
