; form-resource-governor-glass-band.fk — conflict-free Glass projection proof.
;
; Verdict 2097151: twenty-one independently named adapter invariants. Publication
; is validated as a snapshot value here; the physical runner owns live writes.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/form-glass-observation-v2.bml form-stdlib/form-glass-telemetry-membrane.bml form-stdlib/form-resource-governor.bml form-stdlib/form-resource-governor-glass.bml

(do
    (defn frggb-bit (held weight) (if (eq held 1) weight 0))
    (defn frggb-provenance-at (publisher pid started incarnation sequence observed source)
        (fgov2-provenance "physical-live" publisher
            (fgov2-measured (fgov2-process-lifetime pid started incarnation))
            (fgov2-measured sequence) (fgov2-measured observed) source))
    (defn frggb-provenance ()
        (frggb-provenance-at "governor.band" 4242 1700000000 "governor-band-4242" 73 1700000250 "governor.band"))
    (defn frggb-submit-provenance ()
        (frggb-provenance-at "governor.band" 4242 1700000000 "governor-band-4242" 74 1700000500 "governor.submit"))
    (defn frggb-m (value) (frg-measured value 0 (frggb-provenance)))
    (defn frggb-resource (name capacity foreground reserve)
        (frg-resource name (frggb-m capacity) (frggb-m foreground) (frggb-m reserve)))
    (defn frggb-sample (pressure)
        (frg-sample (frggb-m 1)
            (frggb-resource "cpu" 1000 100 100)
            (frggb-resource "gpu" 2000 200 200)
            (frggb-resource "memory" 10000 1000 1000)
            (frggb-m 0) (frggb-m 0) pressure
            (frggb-m 0) (frggb-m 0) (frggb-m 0)))
    (defn frggb-row (frame index) (nth (frgg-frame-samples frame) index))
    (defn frggb-field-eq (field value)
        (if (and (eq (fgtm-field-present? field) 1)
                 (eq (fgtm-field-value field) value)) 1 0))
    (defn frggb-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))

    (let policy (frg-default-policy))
    (let sample (frggb-sample (frggb-m 0)))
    (let state (frg-state 720 1440 7200 8 20))
    (let decision (frg-tick policy state sample))
    (let no-release (frg-pressure-release-plan policy (frg-pressure sample) (frggb-m 25) (list)))
    (let slot-absent (frg-metal-slot-observation "absent" "slot-unclaimed" "/tmp/form-resource-governor-metal-slot.v2" ""))
    (let frame (frgg-project policy sample decision (list) (list) (list) no-release slot-absent 1700000250))
    (let rows (frgg-frame-samples frame))

    (let c0 (frggb-bit (and (eq (frgg-frame-valid? frame) 1)
                              (and (eq (len rows) 10)
                                   (eq (fgtm-samples-valid? rows) 1))) 1))
    (let cpu (frggb-row frame 0))
    (let gpu (frggb-row frame 1))
    (let memory (frggb-row frame 2))
    (let c1 (frggb-bit (and (eq (frggb-field-eq (fgtm-sample-bytes cpu) 720) 1)
        (and (eq (frggb-field-eq (fgtm-sample-capacity cpu) 720) 1)
             (and (eq (frggb-field-eq (fgtm-sample-heat cpu) 1000) 1)
                  (eq (frggb-field-eq (fgtm-sample-heat gpu) 1000) 1)))) 2))
    (let c2 (frggb-bit (and (eq (frggb-field-eq (fgtm-sample-bytes memory) 7200) 1)
        (and (eq (frggb-field-eq (fgtm-sample-capacity memory) 7200) 1)
             (str_eq (fgtm-sample-plane memory) "unified"))) 4))

    (let pressure-row (frggb-row frame 3))
    (let c3 (frggb-bit (and (str_eq (fgtm-sample-evidence pressure-row) "physical-live")
        (and (eq (frggb-field-eq (fgtm-sample-bytes pressure-row) 0) 1)
             (and (eq (frggb-field-eq (fgtm-sample-capacity pressure-row) 2) 1)
                  (str_eq (fgtm-sample-purpose pressure-row) "pressure-zero")))) 8))
    (let admission (frggb-row frame 4))
    (let c4 (frggb-bit (and (str_eq (fgtm-sample-lifecycle admission) "ready")
        (and (str_eq (fgtm-sample-purpose admission) "admission-offered")
             (eq (frggb-field-eq (fgtm-sample-bytes admission) 1) 1))) 16))
    (let permit-row (frggb-row frame 5))
    (let c5 (frggb-bit (and (str_eq (frgg-frame-permit-status frame) "open")
        (and (str_eq (frgg-frame-correlation frame) "open-offer")
             (and (eq (frgg-frame-permit-pid frame) 4242)
                  (and (eq (frgg-frame-permit-sequence frame) 73)
                       (str_eq (fgtm-sample-id permit-row) "governor.permit.open"))))) 32))
    (let reason-row (frggb-row frame 6))
    (let c6 (frggb-bit (and (str_eq (frgg-frame-reason frame) "additive-recovery")
        (and (str_eq (fgtm-sample-id reason-row) "governor.reason.additive-recovery")
             (str_eq (fgtm-sample-lifecycle reason-row) "idle"))) 64))
    (let release-row (frggb-row frame 7))
    (let release-count-row (frggb-row frame 8))
    (let slot-row (frggb-row frame 9))
    (let c7 (frggb-bit (and (str_eq (frgg-frame-release-status frame) "none")
        (and (str_eq (fgtm-sample-lifecycle release-row) "idle")
             (and (eq (frggb-field-eq (fgtm-sample-bytes release-count-row) 0) 1)
                  (and (str_eq (frgg-frame-slot-status frame) "absent")
                       (str_eq (fgtm-sample-lifecycle slot-row) "idle"))))) 128))

    ; Critical pressure closes a new Metal admission and remains visible.
    (let critical-sample (frggb-sample (frggb-m 2)))
    (let critical-decision (frg-tick policy state critical-sample))
    (let critical-frame (frgg-project policy critical-sample critical-decision
        (list) (list) (list) (frg-pressure-release-plan policy (frg-pressure critical-sample) (frggb-m 0) (list)) slot-absent 1700000500))
    (let c8 (frggb-bit (and (str_eq (frgg-frame-reason critical-frame) "stop-backoff")
        (and (str_eq (fgtm-sample-lifecycle (frggb-row critical-frame 4)) "failed")
             (and (str_eq (fgtm-sample-purpose (frggb-row critical-frame 4)) "admission-refused")
                  (str_eq (fgtm-sample-id (frggb-row critical-frame 6)) "governor.reason.stop-backoff")))) 256))

    ; Unknown physical pressure can only accompany the governor's zero-grant
    ; typed refusal.  A mismatched optimistic decision is invalidated again by
    ; the adapter and its grant fields become absent.
    (let unknown-pressure (frg-unavailable "pressure-door-lost" "host.memory-pressure"))
    (let unknown-sample (frggb-sample unknown-pressure))
    (let unknown-decision (frg-tick policy state unknown-sample))
    (let unknown-release (frg-pressure-release-plan policy (frg-pressure unknown-sample) (frggb-m 25) (list)))
    (let unknown-frame (frgg-project policy unknown-sample unknown-decision (list) (list) (list) unknown-release (list) 1700000750))
    (let forged-frame (frgg-project policy unknown-sample decision (list) (list) (list) unknown-release (list) 1700000750))
    (let c9 (frggb-bit (and (eq (frgg-frame-safe? unknown-frame) 1)
        (and (str_eq (frgg-frame-reason unknown-frame) "typed-signal-not-current")
             (and (str_eq (fgtm-sample-lifecycle (frggb-row unknown-frame 3)) "unknown")
                  (and (str_eq (fgtm-sample-source (frggb-row unknown-frame 3)) "governor.fail-closed")
                       (and (eq (fgtm-field-present? (fgtm-sample-heat (frggb-row unknown-frame 0))) 0)
                            (and (eq (fgtm-field-present? (fgtm-sample-capacity (frggb-row unknown-frame 0))) 0)
                                 (str_eq (fgtm-sample-purpose (frggb-row unknown-frame 0)) "target-unavailable"))))))) 512))
    (let c10 (frggb-bit (and (eq (frgg-frame-safe? forged-frame) 0)
        (and (eq (fgtm-field-present? (fgtm-sample-bytes (frggb-row forged-frame 0))) 0)
             (and (str_eq (fgtm-sample-lifecycle (frggb-row forged-frame 4)) "failed")
                  (str_eq (frgg-frame-reason forged-frame) "adapter-input-invalid")))) 1024))

    ; Atomic reservation can cross critical and an exact submit retains the
    ; full identity plus command-buffer handle in the sidecar.
    (let open-permit (frg-decision-permit decision))
    (let owner-text (frg-metal-owner-text open-permit))
    (let reserved-permit (frg-metal-reserved-permit open-permit owner-text))
    (let slot-result (frg-metal-slot-result "acquired" "exact" reserved-permit 1 (str_len owner-text)))
    (let quantum (frg-quantum "q.metal" (frggb-m 1) (frggb-m 1) (frggb-m 1) (frggb-m 1)))
    (let consume (frg-consume-metal-permit policy (frg-decision-next-state decision) decision quantum slot-result))
    (let reserved-state (frg-permit-consume-next-state consume))
    (let reserved-critical (frg-tick policy reserved-state critical-sample))
    (let receipt (frg-submit-receipt "submitted" 808 "q.metal" (frg-permit-id reserved-permit) (frggb-submit-provenance)))
    (let submit-bind (frg-bind-metal-submit reserved-critical (frg-decision-next-state reserved-critical) consume quantum receipt))
    (let submitted-frame (frgg-project policy critical-sample reserved-critical consume submit-bind quantum unknown-release slot-absent 1700000500))
    (let c11 (frggb-bit (and (str_eq (frgg-frame-permit-id submitted-frame) (frg-permit-id reserved-permit))
        (and (str_eq (frgg-frame-permit-incarnation submitted-frame) "governor-band-4242")
             (and (eq (frgg-frame-submit-sequence submitted-frame) 74)
                  (and (eq (frgg-frame-submit-observed submitted-frame) 1700000500)
                       (and (eq (frgg-frame-command-handle submitted-frame) 808)
                            (str_eq (frgg-frame-correlation submitted-frame) "exact-submit-correlated")))))) 2048))
    (let c12 (frggb-bit (and (str_eq (fgtm-sample-lifecycle (frggb-row submitted-frame 4)) "active")
        (and (eq (frggb-field-eq (fgtm-sample-handle (frggb-row submitted-frame 4)) 808) 1)
             (str_eq (fgtm-sample-id (frggb-row submitted-frame 5)) "governor.permit.submitted"))) 4096))

    ; A correlated submit attack is a visible refusal, not the old reservation
    ; projected as a successful admission.
    (let wrong-receipt (frg-submit-receipt "submitted" 809 "q.metal" (frg-permit-id reserved-permit)
        (frggb-provenance-at "other.publisher" 4242 1700000000 "governor-band-4242" 74 1700000500 "governor.submit")))
    (let bad-bind (frg-bind-metal-submit reserved-critical (frg-decision-next-state reserved-critical) consume quantum wrong-receipt))
    (let bad-frame (frgg-project policy critical-sample reserved-critical consume bad-bind quantum unknown-release slot-absent 1700000500))
    (let c13 (frggb-bit (and (str_eq (frgg-frame-correlation bad-frame) "submit-refused")
        (and (str_eq (fgtm-sample-lifecycle (frggb-row bad-frame 4)) "failed")
             (str_eq (fgtm-sample-purpose (frggb-row bad-frame 4)) "admission-submit-refused"))) 8192))

    ; Release and physical unknown-slot state retain their distinct reasons.
    (let units (list
        (frg-release-unit "jit.1" "jit-native-page" (frggb-m 10) (frggb-m 4) (frggb-m 9) (frggb-m 0) (frggb-m 101) "page")
        (frg-release-unit "kv.1" "whole-kv-substate" (frggb-m 20) (frggb-m 1) (frggb-m 5) (frggb-m 0) (frggb-m 202) "whole")))
    (let release-plan (frg-pressure-release-plan policy (frggb-m 1) (frggb-m 25) units))
    (let slot-unknown (frg-metal-slot-observation "occupied-unknown" "owner-mismatch" "/tmp/form-resource-governor-metal-slot.v2" "foreign"))
    (let release-frame (frgg-project policy (frggb-sample (frggb-m 1))
        (frg-tick policy state (frggb-sample (frggb-m 1))) (list) (list) (list) release-plan slot-unknown 1700001000))
    (let c14 (frggb-bit (and (str_eq (frgg-frame-release-status release-frame) "planned")
        (and (eq (frggb-field-eq (fgtm-sample-bytes (frggb-row release-frame 7)) 30) 1)
             (and (eq (frgg-frame-release-selection-count release-frame) 2)
                  (and (eq (frggb-field-eq (fgtm-sample-bytes (frggb-row release-frame 8)) 2) 1)
                       (and (str_eq (frgg-frame-slot-status release-frame) "occupied-unknown")
                            (str_eq (fgtm-sample-lifecycle (frggb-row release-frame 9)) "failed")))))) 16384))

    ; The frame is immediately consumable by the existing membrane.  The
    ; authority names exact root/preludes without modifying the dashboard.
    (let snapshot (fgtm-snapshot "resource.governor" 1700000250 rows))
    (let authority (read_file "form/form-stdlib/bml/form-resource-governor-glass.bml"))
    (let c15 (frggb-bit (and (eq (fgtm-snapshot-valid? snapshot) 1)
        (and (eq (frggb-has authority "form/form-stdlib/form-resource-governor-glass.bml") 1)
             (and (eq (frggb-has authority "form/form-stdlib/form-glass-telemetry-membrane.bml") 1)
                  (eq (frggb-has authority "optimistic mismatch becomes adapter-input-invalid") 1)))) 32768))

    ; Claimed physical provenance with an empty publisher/source and a
    ; malformed measured truth with an occupied reason both fail closed.
    (let malformed-provenance (list "glass-provenance-v2" "physical-live" ""
        (fgov2-measured (fgov2-process-lifetime 4242 1700000000 "governor-band-4242"))
        (fgov2-measured 73) (fgov2-measured 1700000250) ""))
    (let malformed-provenance-pressure (frg-signal (fgov2-measured 1) 0 malformed-provenance))
    (let malformed-provenance-sample (frggb-sample malformed-provenance-pressure))
    (let malformed-provenance-frame (frgg-project policy malformed-provenance-sample
        (frg-tick policy state malformed-provenance-sample) (list) (list) (list) (list) (list) 1700001250))
    (let c16 (frggb-bit (and (str_eq (fgtm-sample-lifecycle (frggb-row malformed-provenance-frame 3)) "unknown")
        (and (eq (fgtm-field-present? (fgtm-sample-bytes (frggb-row malformed-provenance-frame 3))) 0)
             (str_eq (fgtm-sample-source (frggb-row malformed-provenance-frame 3)) "governor.fail-closed"))) 65536))
    (let malformed-truth (list "glass-truth-v2" "measured" 1 "forged-reason"
        (nothing) (nothing) (nothing) (nothing) (nothing)))
    (let malformed-truth-pressure (frg-signal malformed-truth 0 (frggb-provenance)))
    (let malformed-truth-sample (frggb-sample malformed-truth-pressure))
    (let malformed-truth-frame (frgg-project policy malformed-truth-sample
        (frg-tick policy state malformed-truth-sample) (list) (list) (list) (list) (list) 1700001250))
    (let c17 (frggb-bit (and (str_eq (fgtm-sample-lifecycle (frggb-row malformed-truth-frame 3)) "unknown")
        (eq (fgtm-field-present? (fgtm-sample-bytes (frggb-row malformed-truth-frame 3))) 0)) 131072))

    ; An admitted tag cannot mint correlation: the submitted permit, consume
    ; reservation, quantum, receipt, next state and full provenance must join.
    (let forged-admitted-bind (list "form-resource-metal-submit-bind-v2" "admitted"
        "forged-tag" reserved-permit reserved-state receipt))
    (let forged-admitted-frame (frgg-project policy critical-sample reserved-critical
        consume forged-admitted-bind quantum unknown-release slot-absent 1700000500))
    (let c18 (frggb-bit (and (str_eq (frgg-frame-correlation forged-admitted-frame) "submit-refused")
        (and (str_eq (fgtm-sample-lifecycle (frggb-row forged-admitted-frame 4)) "failed")
             (and (eq (fgtm-field-present? (fgtm-sample-handle (frggb-row forged-admitted-frame 4))) 0)
                  (str_eq (frgg-frame-permit-status forged-admitted-frame) "reserved")))) 262144))

    ; Self-consistent consume rows for another permit, and reserved permits
    ; whose owner bytes do not derive exactly from identity, cannot reserve.
    (let other-provenance (frggb-provenance-at "other.governor" 4343 1700000001
        "other-governor-4343" 1 1700000250 "governor.band"))
    (let other-open (frg-metal-permit (frg-permit-id-for other-provenance 21) 21
        "open" other-provenance 0 (list) "" ""))
    (let other-owner (frg-metal-owner-text other-open))
    (let other-reserved (frg-metal-reserved-permit other-open other-owner))
    (let other-slot (frg-metal-slot-result "acquired" "forged-other" other-reserved 1 (str_len other-owner)))
    (let other-state (frg-state-with-permit (frg-decision-cpu decision) (frg-decision-gpu decision)
        (frg-decision-memory decision) 9 21 other-reserved))
    (let other-consume (frg-permit-consume-result "admitted" "forged-other"
        other-reserved other-state other-slot))
    (let other-frame (frgg-project policy sample decision other-consume (list) quantum
        no-release slot-absent 1700000250))
    (let c19 (frggb-bit (and (str_eq (frgg-frame-correlation other-frame) "reservation-refused")
        (and (str_eq (frgg-frame-permit-id other-frame) (frg-permit-id open-permit))
             (str_eq (fgtm-sample-purpose (frggb-row other-frame 4)) "admission-reserve-refused"))) 524288))

    (let wrong-owner-permit (frg-metal-permit (frg-permit-id reserved-permit)
        (frg-permit-tick reserved-permit) "reserved" (frg-permit-provenance reserved-permit)
        0 (list) (frg-metal-slot-path) "forged-owner-bytes"))
    (let wrong-owner-slot (frg-metal-slot-result "acquired" "forged-owner"
        wrong-owner-permit 1 (str_len "forged-owner-bytes")))
    (let wrong-owner-state (frg-state-with-permit (frg-decision-cpu decision)
        (frg-decision-gpu decision) (frg-decision-memory decision) 9 21 wrong-owner-permit))
    (let wrong-owner-consume (frg-permit-consume-result "admitted" "forged-owner"
        wrong-owner-permit wrong-owner-state wrong-owner-slot))
    (let wrong-owner-frame (frgg-project policy sample decision wrong-owner-consume (list)
        quantum no-release slot-absent 1700000250))
    (let c20 (frggb-bit (and (str_eq (frgg-frame-correlation wrong-owner-frame) "reservation-refused")
        (and (str_eq (frgg-frame-permit-status wrong-owner-frame) "open")
             (str_eq (fgtm-sample-purpose (frggb-row wrong-owner-frame 4)) "admission-reserve-refused"))) 1048576))

    (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17 c18 c19 c20)))
