; living-world-transformation-nursery-witness.fk -- offered Recipes may grow.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/tests/living-world-intention-graph-witness.fk

(let LWTNW-TARGET-FIXTURE (bp "LWTNW-TARGET-FIXTURE"))
(let LWTNW-SELECTION      (bp "LWTNW-SELECTION"))
(let LWTNW-TRIAL          (bp "LWTNW-TRIAL"))
(let LWTNW-GROWTH         (bp "LWTNW-GROWTH"))
(let LWTNW-SOURCE-V       (bp "LWTNW-SOURCE-V"))
(let LWTNW-SOURCE-W       (bp "LWTNW-SOURCE-W"))
(let LWTNW-SOURCE-X       (bp "LWTNW-SOURCE-X"))
(let LWTNW-SOURCE-Y       (bp "LWTNW-SOURCE-Y"))
(let LWTNW-SOURCE-Z       (bp "LWTNW-SOURCE-Z"))
(let LWTNW-SOURCE-N       (bp "LWTNW-SOURCE-N"))
(let LWTNW-PROV-V         (bp "LWTNW-PROV-V"))
(let LWTNW-PROV-W         (bp "LWTNW-PROV-W"))
(let LWTNW-PROV-X         (bp "LWTNW-PROV-X"))
(let LWTNW-PROV-Y         (bp "LWTNW-PROV-Y"))
(let LWTNW-PROV-Z         (bp "LWTNW-PROV-Z"))
(let LWTNW-PROV-N         (bp "LWTNW-PROV-N"))
(let LWTNW-DIRECTION-E    (bp "LWTNW-DIRECTION-E"))
(let LWTNW-DIRECTION-F    (bp "LWTNW-DIRECTION-F"))
(let LWTNW-OPTION-E       (bp "LWTNW-OPTION-E"))
(let LWTNW-OPTION-F       (bp "LWTNW-OPTION-F"))
(let LWTNW-EVIDENCE       (bp "LWTNW-EVIDENCE"))
(let LWTNW-REASON         (bp "LWTNW-REASON"))

(defn lwtnw-cell (kind) (intern_node kind (empty)))
(defn lwtnw-source-v () (lwtnw-cell LWTNW-SOURCE-V))
(defn lwtnw-source-w () (lwtnw-cell LWTNW-SOURCE-W))
(defn lwtnw-source-x () (lwtnw-cell LWTNW-SOURCE-X))
(defn lwtnw-source-y () (lwtnw-cell LWTNW-SOURCE-Y))
(defn lwtnw-source-z () (lwtnw-cell LWTNW-SOURCE-Z))
(defn lwtnw-source-n () (lwtnw-cell LWTNW-SOURCE-N))
(defn lwtnw-prov-v () (lwtnw-cell LWTNW-PROV-V))
(defn lwtnw-prov-w () (lwtnw-cell LWTNW-PROV-W))
(defn lwtnw-prov-x () (lwtnw-cell LWTNW-PROV-X))
(defn lwtnw-prov-y () (lwtnw-cell LWTNW-PROV-Y))
(defn lwtnw-prov-z () (lwtnw-cell LWTNW-PROV-Z))
(defn lwtnw-prov-n () (lwtnw-cell LWTNW-PROV-N))
(defn lwtnw-direction-e () (lwtnw-cell LWTNW-DIRECTION-E))
(defn lwtnw-direction-f () (lwtnw-cell LWTNW-DIRECTION-F))
(defn lwtnw-option-e () (lwtnw-cell LWTNW-OPTION-E))
(defn lwtnw-option-f () (lwtnw-cell LWTNW-OPTION-F))
(defn lwtnw-evidence () (lwtnw-cell LWTNW-EVIDENCE))
(defn lwtnw-reason () (lwtnw-cell LWTNW-REASON))

(defn lwtnw-entry (source provenance payload)
    (lwigw-entry source provenance payload))
(defn lwtnw-entry-v (payload)
    (lwtnw-entry (lwtnw-source-v) (lwtnw-prov-v) payload))
(defn lwtnw-entry-w (payload)
    (lwtnw-entry (lwtnw-source-w) (lwtnw-prov-w) payload))
(defn lwtnw-entry-x (payload)
    (lwtnw-entry (lwtnw-source-x) (lwtnw-prov-x) payload))
(defn lwtnw-entry-y (payload)
    (lwtnw-entry (lwtnw-source-y) (lwtnw-prov-y) payload))
(defn lwtnw-entry-z (payload)
    (lwtnw-entry (lwtnw-source-z) (lwtnw-prov-z) payload))
(defn lwtnw-entry-n (payload)
    (lwtnw-entry (lwtnw-source-n) (lwtnw-prov-n) payload))

(defn lwtnw-pqrstu ()
    (append (lwigw-pqrst)
        (list (list (lwigw-source-u) (lwigw-prov-u)))))
(defn lwtnw-vwx ()
    (list
        (list (lwtnw-source-v) (lwtnw-prov-v))
        (list (lwtnw-source-w) (lwtnw-prov-w))
        (list (lwtnw-source-x) (lwtnw-prov-x))))
(defn lwtnw-vxy ()
    (list
        (list (lwtnw-source-v) (lwtnw-prov-v))
        (list (lwtnw-source-x) (lwtnw-prov-x))
        (list (lwtnw-source-y) (lwtnw-prov-y))))
(defn lwtnw-yzn ()
    (list
        (list (lwtnw-source-y) (lwtnw-prov-y))
        (list (lwtnw-source-z) (lwtnw-prov-z))
        (list (lwtnw-source-n) (lwtnw-prov-n))))
(defn lwtnw-exact-participants ()
    (append (lwtnw-pqrstu) (lwtnw-vwx)))
(defn lwtnw-mismatch-participants ()
    (append (lwtnw-pqrstu) (lwtnw-vxy)))
(defn lwtnw-growth-participants ()
    (append (lwtnw-exact-participants) (lwtnw-yzn)))
(defn lwtnw-successor-participants ()
    (append (lwtnw-pqrstu)
        (list
            (list (lwtnw-source-v) (lwtnw-prov-v))
            (list (lwtnw-source-y) (lwtnw-prov-y))
            (list (lwtnw-source-z) (lwtnw-prov-z)))))

(defn lwtnw-response-entries (proposal sources)
    (lwigw-edge-response-entries proposal sources))

; children: world, integrated transformation candidate, last round, graph fixture
(defn lwtnw-target-fixture (world target round graph-fixture)
    (intern_node LWTNW-TARGET-FIXTURE
        (list world target round graph-fixture)))
(defn lwtnw-target-world (fixture) (nth (node_children fixture) 0))
(defn lwtnw-target (fixture) (nth (node_children fixture) 1))
(defn lwtnw-target-round (fixture) (nth (node_children fixture) 2))
(defn lwtnw-graph-fixture (fixture) (nth (node_children fixture) 3))

(defn lwtnw-build-target ()
    (do
        (let graph-fixture (lwigw-build-fixture))
        (let linear (lwigw-linear-worlds graph-fixture))
        (let world (nth linear 1))
        (let prior (nth linear 4))
        (let plan
            (lwig-plan-for world (lwigw-a graph-fixture)
                (lwigw-nodes-abc graph-fixture)))
        (let proposal (lwrx-proposal world plan))
        (let target (lwt-proposal-candidate proposal))
        (let round
            (lwt-round world (lwo-field (list proposal))
                (lwo-empty-field) prior))
        (let yes-round
            (lwt-round-receive round
                (lwtnw-response-entries proposal (lwtnw-pqrstu))))
        (let integrated
            (lwrx-integrate yes-round proposal (lwigw-action)))
        (lwtnw-target-fixture
            (lwt-round-world integrated) target integrated graph-fixture)))

(defn lwtnw-contract () (lwre-form-contract 128 (lwtnw-evidence)))
(defn lwtnw-recipe-e ()
    (lwre-recipe "(add (add (add 1 1) 1) 1)"
        (lwtnw-contract) (lwtnw-evidence)))
(defn lwtnw-recipe-f ()
    (lwre-recipe "(add 1 2)" (lwtnw-contract) (lwtnw-evidence)))
(defn lwtnw-invalid-recipe ()
    (lwre-recipe "(add 1 2)"
        (lwre-form-contract 4 (lwtnw-evidence)) (lwtnw-evidence)))
(defn lwtnw-lens-for (recipe)
    (lwlc-lens (lwlc-recipe-shape) recipe (lwtnw-evidence)))
(defn lwtnw-lens-e () (lwtnw-lens-for (lwtnw-recipe-e)))
(defn lwtnw-lens-f () (lwtnw-lens-for (lwtnw-recipe-f)))
(defn lwtnw-declaration-for (direction lens)
    (lwlc-declaration direction
        (lwlc-stack lens (lwlc-layers (list))
            (lwo-empty-field) (lwo-none) (lwtnw-evidence))
        (lwtnw-evidence)))
(defn lwtnw-declaration-e ()
    (lwtnw-declaration-for (lwtnw-direction-e) (lwtnw-lens-e)))
(defn lwtnw-declaration-f ()
    (lwtnw-declaration-for (lwtnw-direction-f) (lwtnw-lens-f)))
(defn lwtnw-timeout ()
    (oac-timeout (intern_trivial_int 10)
        (oac-alternative-ack
            (lwtnw-recipe-e) (lwtnw-recipe-f) (lwtnw-evidence))
        (lwtnw-evidence)))

(defn lwtnw-offer-e (target)
    (lwtn-offer target (lwtnw-recipe-e) (lwtnw-declaration-e)
        (lwtnw-lens-e) (intern_trivial_int 1)
        (lwo-field (list (lwtnw-option-e)))
        (lwlc-unknown (lwtnw-evidence))
        (lwo-none) (lwtnw-timeout) (lwtnw-evidence)))
(defn lwtnw-offer-f (target)
    (lwtn-offer target (lwtnw-recipe-f) (lwtnw-declaration-f)
        (lwtnw-lens-f) (intern_trivial_int 1)
        (lwo-field (list (lwtnw-option-f)))
        (lwo-none) (lwo-none) (lwo-none) (lwtnw-evidence)))
(defn lwtnw-open-offer (target)
    (lwtn-offer target (lwo-none) (lwo-none) (lwo-none) (lwo-none)
        (lwo-empty-field) (lwlc-unknown (lwtnw-evidence))
        (lwo-none) (lwo-none) (lwtnw-evidence)))

(defn lwtnw-exact-world (fixture)
    (lwt-receive-stream (lwtnw-target-world fixture)
        (list
            (lwtnw-entry-v (lwtnw-recipe-e))
            (lwtnw-entry-v (lwtnw-declaration-e))
            (lwtnw-entry-x (lwtnw-recipe-f))
            (lwtnw-entry-x (lwtnw-declaration-f))
            (lwtnw-entry-v (lwtnw-offer-e (lwtnw-target fixture)))
            (lwtnw-entry-w (lwtnw-offer-e (lwtnw-target fixture)))
            (lwtnw-entry-x (lwtnw-offer-f (lwtnw-target fixture))))))
(defn lwtnw-ambiguous-world (fixture exact-world)
    (lwt-receive-stream exact-world
        (list (lwtnw-entry-y
                (lwtnw-offer-f (lwtnw-target fixture))))))
(defn lwtnw-mismatch-world (fixture)
    (lwt-receive-stream (lwtnw-target-world fixture)
        (list
            (lwtnw-entry-v (lwtnw-recipe-e))
            (lwtnw-entry-v (lwtnw-declaration-e))
            (lwtnw-entry-x (lwtnw-recipe-f))
            (lwtnw-entry-x (lwtnw-declaration-f))
            (lwtnw-entry-v (lwtnw-offer-e (lwtnw-target fixture)))
            (lwtnw-entry-x (lwtnw-offer-f (lwtnw-target fixture)))
            (lwtnw-entry-y (lwtnw-offer-f (lwtnw-target fixture))))))

; children: integrated round, candidate, proposal, pre-integration field
(defn lwtnw-selection-cell (round candidate proposal field)
    (intern_node LWTNW-SELECTION (list round candidate proposal field)))
(defn lwtnw-selection-round (selection) (nth (node_children selection) 0))
(defn lwtnw-selection-candidate (selection) (nth (node_children selection) 1))
(defn lwtnw-selection-proposal (selection) (nth (node_children selection) 2))
(defn lwtnw-selection-field (selection) (nth (node_children selection) 3))
(defn lwtnw-integrate-selection (world target prior sources)
    (do
        (let field (lwtn-field-for world target 2))
        (let proposal (lwtn-selection-proposal world target 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let round
            (lwt-round world (lwo-field (list proposal))
                (lwo-empty-field) prior))
        (let yes-round
            (lwt-round-receive round
                (lwtnw-response-entries proposal sources)))
        (let integrated
            (lwtn-selection-integrate yes-round proposal (lwigw-action)))
        (lwtnw-selection-cell integrated candidate proposal field)))
(defn lwtnw-exact-selection (fixture)
    (lwtnw-integrate-selection (lwtnw-exact-world fixture)
        (lwtnw-target fixture) (lwtnw-target-round fixture)
        (lwtnw-exact-participants)))
(defn lwtnw-mismatch-selection (fixture)
    (lwtnw-integrate-selection (lwtnw-mismatch-world fixture)
        (lwtnw-target fixture) (lwtnw-target-round fixture)
        (lwtnw-mismatch-participants)))

; children: integrated round, trial candidate, proposal, exact trial
(defn lwtnw-trial-cell (round candidate proposal trial)
    (intern_node LWTNW-TRIAL (list round candidate proposal trial)))
(defn lwtnw-trial-round (fixture) (nth (node_children fixture) 0))
(defn lwtnw-trial-candidate (fixture) (nth (node_children fixture) 1))
(defn lwtnw-trial-proposal (fixture) (nth (node_children fixture) 2))
(defn lwtnw-trial-shape (fixture) (nth (node_children fixture) 3))
(defn lwtnw-integrate-trial (selection sources)
    (do
        (let world (lwt-round-world (lwtnw-selection-round selection)))
        (let selected (lwtnw-selection-candidate selection))
        (let proposal
            (lwtn-trial-proposal world selected
                (intern_trivial_int 5) (lwtnw-evidence)))
        (let candidate (lwt-proposal-candidate proposal))
        (let trial (lwo-emergent-shape candidate))
        (let round
            (lwt-round world (lwo-field (list proposal))
                (lwo-empty-field) (lwtnw-selection-round selection)))
        (let yes-round
            (lwt-round-receive round
                (lwtnw-response-entries proposal sources)))
        (let integrated
            (lwtn-trial-integrate yes-round proposal (lwigw-action)))
        (lwtnw-trial-cell integrated candidate proposal trial)))
(defn lwtnw-exact-trial (fixture)
    (lwtnw-integrate-trial (lwtnw-exact-selection fixture)
        (lwtnw-exact-participants)))
(defn lwtnw-mismatch-trial (fixture)
    (lwtnw-integrate-trial (lwtnw-mismatch-selection fixture)
        (lwtnw-mismatch-participants)))

(defn lwtnw-confirmation (trial)
    (do
        (let actual
            (lwtn-trial-actual (lwo-emergent-shape trial)))
        (lwtn-observation trial actual (oac-one actual)
            (lwo-field (list (lwtnw-option-f)))
            (lwlc-unknown (lwtnw-evidence)) (lwtnw-evidence))))
(defn lwtnw-silence (trial)
    (lwtn-observation trial (lwo-none) (oac-nothing)
        (lwo-empty-field) (lwo-none) (lwtnw-evidence)))
(defn lwtnw-other-boundary ()
    (lwrx-overall (intern_trivial_int 1) (intern_trivial_int 3)
        (lwrx-lens-sequence (list (lwtnw-lens-f)))))
(defn lwtnw-correction (trial)
    (lwtn-observation trial (lwtnw-other-boundary) (oac-zero)
        (lwo-field (list (lwtnw-option-e)))
        (lwlc-unknown (lwtnw-evidence)) (lwtnw-evidence)))

(defn lwtnw-observed-world (trial-fixture)
    (do
        (let world (lwt-round-world (lwtnw-trial-round trial-fixture)))
        (let trial (lwtnw-trial-candidate trial-fixture))
        (let confirmation (lwtnw-confirmation trial))
        (lwt-receive-stream world
            (list
                (lwtnw-entry-v confirmation)
                (lwtnw-entry-y confirmation)
                (lwtnw-entry-z confirmation)
                (lwtnw-entry-n (lwtnw-silence trial))))))

; children: integrated round, growth candidate, proposal, growth, observation
(defn lwtnw-growth-cell (round candidate proposal growth observation)
    (intern_node LWTNW-GROWTH
        (list round candidate proposal growth observation)))
(defn lwtnw-growth-round (fixture) (nth (node_children fixture) 0))
(defn lwtnw-growth-candidate (fixture) (nth (node_children fixture) 1))
(defn lwtnw-growth-proposal (fixture) (nth (node_children fixture) 2))
(defn lwtnw-growth-shape (fixture) (nth (node_children fixture) 3))
(defn lwtnw-growth-observation (fixture) (nth (node_children fixture) 4))
(defn lwtnw-integrated-growth (target-fixture)
    (do
        (let trial-fixture (lwtnw-exact-trial target-fixture))
        (let trial (lwtnw-trial-candidate trial-fixture))
        (let observation (lwtnw-confirmation trial))
        (let world (lwtnw-observed-world trial-fixture))
        (let growth (lwtn-growth-for world trial 2))
        (let proposal (lwtn-growth-proposal world trial 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let round
            (lwt-round world (lwo-field (list proposal))
                (lwo-empty-field) (lwtnw-trial-round trial-fixture)))
        (let yes-round
            (lwt-round-receive round
                (lwtnw-response-entries
                    proposal (lwtnw-growth-participants))))
        (let integrated
            (lwtn-growth-integrate yes-round proposal (lwigw-action)))
        (lwtnw-growth-cell integrated candidate proposal growth observation)))

(defn lwtnw-corrected-world (growth-fixture)
    (do
        (let world (lwt-round-world (lwtnw-growth-round growth-fixture)))
        (let trial
            (lwtn-growth-trial (lwtnw-growth-shape growth-fixture)))
        (lwt-receive-stream world
            (list (lwtnw-entry-n (lwtnw-correction trial))))))

(defn lwtnw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwtnw-sum (tail items)))))

0
