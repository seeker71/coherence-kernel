; cell-channel-band.fk — two cells, one shared field, one grammar: the
; frame is length-safe, the gate stands before the evaluator, the field
; is the only grammar door, the append is the whole durable act.
; Effects are confined to a scratch root under the host temp dir; the
; living .hearth and the glass bus are never touched (bandstain, row 1193).
; Expected: 4095
;   1     frame text round-trips: every field, a multi-line body with parens and quotes
;   2     whole frames only: a partial tail advances nothing; two frames parse as two
;   4     content address: 64 hex bytes, same body same id, a tampered id is not whole
;   8     the symbol gate: known/let-bound pass; unknown, unbalanced, empty, inner-unknown refuse by name
;   16    hearing: say -> heard value=42; tell -> heard value=hello b; unknown -> refuse unknown-symbol=twice
;   32    the field's observation: a good defn admits; a redefinition, a bare expression,
;         an unknown inner symbol refuse by reason; ack values 1/0/nothing
;   64    grammar fold: only whole admits fold; the id moves; the new word then evaluates
;   128   open on a scratch root: board, seed, three fifos stand; bad labels refuse; open? answers 1
;   256   append + drain: turn 1 then 2, ids are digests, a re-drain hands nothing,
;         a half frame holds the mark, the completing half yields the frame;
;         unknown kind / frame mark in body / non-member refuse
;   512   peers and bells: a->(b field), b->(a field), field->(a b); a fifo stands, a file does not;
;         a deferred ring answers without blocking (a reader is spawned first, so nothing lingers)
;   1024  census: stat counts said/heard/admitted from the spools; the mesh lists the channel and
;         ignores a directory without a board
;   2048  vocabulary: release wake, kinds, value text for say/tell/nothing
; preludes: form/form-stdlib/cell-channel.bml
(do
    (defn ccb-bit (ok bit) (if ok bit 0))
    (defn ccb-has (text needle) (ge (str_find text needle 0) 0))
    (defn ccb-root () (fs-path-join (fs-temp-dir) "cell-channel-band"))
    (defn ccb-q () (byte_to_str 34))
    (defn ccb-lp () (byte_to_str 40))
    (defn ccb-body () (str_concat "(do (defn f (x)\n  (str_concat " (str_concat (ccb-q) (str_concat "a b" (str_concat (ccb-q) " x)))\n  (f 3))")))))

    ; --- 1: frame round trip -------------------------------------------
    (defn ccb-k1 ()
        (do (let text (cc-frame-text 7 "a" "say" 1700000000123 "deadbeef" (ccb-body)))
            (let f (cc-frame-of text))
            (and (eq (cc-frame-turn f) 7)
            (and (str_eq (cc-frame-from f) "a")
            (and (str_eq (cc-frame-kind f) "say")
            (and (eq (cc-frame-ms f) 1700000000123)
            (and (str_eq (cc-frame-id f) "deadbeef")
                 (str_eq (cc-frame-body f) (ccb-body)))))))))

    ; --- 2: whole frames only --------------------------------------------
    (defn ccb-k2 ()
        (do (let one (cc-frame-text 1 "a" "say" 5 "00000000" "(add 1 2)"))
            (let two (cc-frame-text 2 "a" "say" 6 "00000000" "(add 3 4)"))
            (let partial (substring two 0 20))
            (and (eq (cc-complete-through (str_concat one partial)) (str_len one))
            (and (eq (len (cc-parse-frames (str_concat one partial))) 1)
            (and (eq (len (cc-parse-frames (str_concat one two))) 2)
            (and (eq (cc-complete-through partial) 0)
                 (eq (cc-frame-turn (nth (cc-parse-frames (str_concat one two)) 1)) 2)))))))

    ; --- 4: content address ----------------------------------------------
    (defn ccb-k4 ()
        (do (let d (cc-digest "(add 1 2)"))
            (let whole (cc-frame 1 "a" "say" 0 d "(add 1 2)"))
            (let tampered (cc-frame 1 "a" "say" 0 "00000000" "(add 1 2)"))
            (and (eq (str_len d) 64)
            (and (eq (hex-valid? d) 1)
            (and (str_eq d (cc-digest "(add 1 2)"))
            (and (not (str_eq d (cc-digest "(add 1 3)")))
            (and (eq (cc-frame-whole? whole) 1)
                 (eq (cc-frame-whole? tampered) 0))))))))

    ; --- 8: the symbol gate ----------------------------------------------
    (defn ccb-k8 ()
        (do (let g (cc-seed-grammar))
            (and (str_eq (cc-gate g "(cc-ack 41)") "")
            (and (str_eq (cc-gate g "(let x 40 (add x 2))") "")
            (and (str_eq (cc-gate g "(twice 21)") "unknown-symbol=twice")
            (and (str_eq (cc-gate g (str_concat (ccb-lp) "add 1 2")) "unbalanced")
            (and (str_eq (cc-gate g "") "empty-body")
            (and (str_eq (cc-gate g "(do (defn f (x) (g x)) (f 1))") "unknown-symbol=g")
                 (str_eq (cc-gate g (str_concat (ccb-lp) (str_concat "cc-greet " (str_concat (ccb-q) (str_concat "twice (unknown)" (str_concat (ccb-q) ")")))))) "")))))))))

    ; --- 16: hearing through the evaluator -------------------------------
    (defn ccb-k16 ()
        (do (let g (cc-seed-grammar))
            (let gid (cc-grammar-id g))
            (let say (cc-frame 3 "a" "say" 0 (cc-digest "(cc-ack 41)") "(cc-ack 41)"))
            (let tellb (str_concat (ccb-lp) (str_concat "cc-greet " (str_concat (ccb-q) (str_concat "b" (str_concat (ccb-q) ")"))))))
            (let tell (cc-frame 4 "a" "tell" 0 (cc-digest tellb) tellb))
            (let bad (cc-frame 5 "a" "say" 0 (cc-digest "(twice 21)") "(twice 21)"))
            (let h1 (cc-hear g gid say))
            (let h2 (cc-hear g gid tell))
            (let h3 (cc-hear g gid bad))
            (and (str_eq (cc-answer-kind h1) "heard")
            (and (ccb-has (cc-answer-body h1) "to=3 value=42 grammar=")
            (and (str_eq (cc-answer-kind h2) "heard")
            (and (ccb-has (cc-answer-body h2) "value=hello b ")
            (and (str_eq (cc-answer-kind h3) "refuse")
            (and (ccb-has (cc-answer-body h3) "reason=unknown-symbol=twice")
                 (eq (cc-hearable? bad) 1)))))))))

    ; --- 32: the field observes an offer ---------------------------------
    (defn ccb-k32 ()
        (do (let g (cc-seed-grammar))
            (let good (cc-observe g "(defn twice (n) (mul n 2))"))
            (let redef (cc-observe g "(defn cc-ack (n) n)"))
            (let bare (cc-observe g "(add 1 2)"))
            (let inner (cc-observe g "(defn bad (n) (nope n))"))
            (and (str_eq (cc-answer-kind good) "admit")
            (and (str_eq (cc-answer-body good) "(defn twice (n) (mul n 2))")
            (and (str_eq (cc-answer-kind redef) "refuse")
            (and (str_eq (cc-answer-body redef) "redefines=cc-ack")
            (and (str_eq (cc-answer-body bare) "no-defn")
            (and (str_eq (cc-answer-body inner) "unknown-symbol=nope")
            (and (eq (cc-ack-of "admit") 1)
            (and (eq (cc-ack-of "refuse") 0)
                 (nothing? (cc-ack-of "say"))))))))))))

    ; --- 64: the grammar fold ---------------------------------------------
    (defn ccb-k64 ()
        (do (let g (cc-seed-grammar))
            (let body "(defn twice (n) (mul n 2))")
            (let whole (cc-frame 1 "field" "admit" 0 (cc-digest body) body))
            (let torn (cc-frame 2 "field" "admit" 0 "00000000" "(defn thrice (n) (mul n 3))"))
            (let no (cc-frame 3 "field" "refuse" 0 (cc-digest "x") "reason=no"))
            (let bodies (cc-admitted-bodies (list whole torn no)))
            (let g2 (cc-grammar-fold g bodies))
            (and (eq (len bodies) 1)
            (and (not (str_eq (cc-grammar-id g2) (cc-grammar-id g)))
            (and (str_eq (cc-gate g2 "(twice 21)") "")
            (and (eq (cc-eval g2 "(twice 21)") 42)
                 (str_eq (cc-gate g2 "(thrice 1)") "unknown-symbol=thrice")))))))

    ; --- 128: open on a scratch root ---------------------------------------
    (defn ccb-k128 ()
        (do (let root (ccb-root))
            (let clr (cc-clear root "band"))
            (let o (cc-open root "band" "a" "b"))
            (let seed (cc-seed-read root "band"))
            (and (eq (cc-open-ok o) 1)
            (and (str_eq (cc-open-seed-id o) (cc-board-value root "band" "seed"))
            (and (str_eq (cc-a root "band") "a")
            (and (str_eq (cc-b root "band") "b")
            (and (str_eq (cc-digest seed) (cc-board-value root "band" "seed"))
            (and (eq (cc-open? root "band") 1)
            (and (eq (cc-open-ok (cc-open root "Bad Name" "a" "b")) 0)
            (and (eq (cc-open-ok (cc-open root "same" "a" "a")) 0)
            (and (eq (cc-open-ok (cc-open root "fieldy" "field" "b")) 0)
                 (eq (cc-open? root "never-opened") 0))))))))))))

    ; --- 256: append and drain ---------------------------------------------
    (defn ccb-k256 ()
        (do (let root (ccb-root))
            (let s1 (cc-append root "band" "a" "say" "(cc-ack 41)"))
            (let r0 (cc-reader root "band" "a"))
            (let d1 (cc-drain r0))
            (let r1 (cc-drained-reader d1))
            (let d1b (cc-drain r1))
            (let s2 (cc-append root "band" "a" "tell" "(cc-greet x)"))
            (let d2 (cc-drain r1))
            (let r2 (cc-drained-reader d2))
            (let half (cc-frame-text 9 "a" "say" 1 "00000000" "(add 1 1)"))
            (let h1 (sbt-append (cc-spool root "band" "a") (substring half 0 25)))
            (let d3 (cc-drain r2))
            (let r3 (cc-drained-reader d3))
            (let h2 (sbt-append (cc-spool root "band" "a") (substring half 25 (str_len half))))
            (let d4 (cc-drain r3))
            (and (eq (cc-sent-turn s1) 1)
            (and (str_eq (cc-sent-id s1) (cc-digest "(cc-ack 41)"))
            (and (eq (len (cc-drained-frames d1)) 1)
            (and (str_eq (cc-frame-body (head (cc-drained-frames d1))) "(cc-ack 41)")
            (and (eq (len (cc-drained-frames d1b)) 0)
            (and (eq (cc-sent-turn s2) 2)
            (and (eq (len (cc-drained-frames d2)) 1)
            (and (str_eq (cc-frame-kind (head (cc-drained-frames d2))) "tell")
            (and (eq (len (cc-drained-frames d3)) 0)
            (and (eq (sbt-mark r3) (sbt-mark r2))
            (and (eq (len (cc-drained-frames d4)) 1)
            (and (eq (cc-frame-turn (head (cc-drained-frames d4))) 9)
            (and (eq (cc-sent-ok? (cc-append root "band" "a" "shout" "x")) 0)
            (and (eq (cc-sent-ok? (cc-append root "band" "a" "say" (str_concat "x" (cc-close-mark)))) 0)
                 (eq (cc-sent-ok? (cc-append root "band" "zed" "say" "x")) 0)))))))))))))))))

    ; --- 512: peers, bells, a deferred ring --------------------------------
    (defn ccb-k512 ()
        (do (let root (ccb-root))
            (let bell (cc-bell root "band" "b"))
            ; a reader stands first, so the deferred writer leaves nothing behind
            (let reader (host-exec (str_concat "( cat " (str_concat bell " ) >/dev/null 2>&1 &")) ""))
            (let rung (cc-ring bell))
            (and (str_eq (head (cc-peers root "band" "a")) "b")
            (and (str_eq (nth (cc-peers root "band" "a") 1) "field")
            (and (str_eq (head (cc-peers root "band" "b")) "a")
            (and (str_eq (head (cc-peers root "band" "field")) "a")
            (and (str_eq (nth (cc-peers root "band" "field") 1) "b")
            (and (str_eq (cc-peer-cell root "band" "a") "b")
            (and (eq (cc-bell-stands? bell) 1)
            (and (eq (cc-bell-stands? (cc-board root "band")) 0)
                 (eq rung 1)))))))))))

    ; --- 1024: census ----------------------------------------------------------
    (defn ccb-k1024 ()
        (do (let root (ccb-root))
            (let mk (fs-mkdir (fs-path-join root "not-a-channel")))
            (let fa (cc-append root "band" "field" "admit" "(defn twice (n) (mul n 2))"))
            (let hb (cc-append root "band" "b" "heard" "to=1 value=42"))
            (let s (cc-stat root "band"))
            (and (eq (cc-stat-a-frames s) 3)
            (and (eq (cc-stat-b-frames s) 1)
            (and (eq (cc-stat-field-frames s) 1)
            (and (eq (cc-stat-admitted s) 1)
            (and (eq (cc-stat-heard s) 1)
            (and (eq (cc-stat-said s) 3)
            (and (eq (cc-stat-amendments s) 1)
            (and (str_eq (cc-stat-grammar-id s) (cc-grammar-id (cc-grammar-current root "band")))
            (and (eq (len (cc-mesh-names root)) 1)
            (and (str_eq (head (cc-mesh-names root)) "band")
                 (eq (len (cc-mesh root)) 1)))))))))))))

    ; --- 2048: vocabulary ------------------------------------------------------
    (defn ccb-k2048 ()
        (and (eq (cc-released? "release") 1)
        (and (eq (cc-released? "x") 0)
        (and (eq (cc-released? (nothing)) 1)
        (and (eq (cc-kind? "offer") 1)
        (and (eq (cc-kind? "shout") 0)
        (and (str_eq (cc-value-text "say" 42) "42")
        (and (str_eq (cc-value-text "tell" "hi") "hi")
             (str_eq (cc-value-text "say" (nothing)) "nothing")))))))))

    (sum (list
        (ccb-bit (ccb-k1) 1)
        (ccb-bit (ccb-k2) 2)
        (ccb-bit (ccb-k4) 4)
        (ccb-bit (ccb-k8) 8)
        (ccb-bit (ccb-k16) 16)
        (ccb-bit (ccb-k32) 32)
        (ccb-bit (ccb-k64) 64)
        (ccb-bit (ccb-k128) 128)
        (ccb-bit (ccb-k256) 256)
        (ccb-bit (ccb-k512) 512)
        (ccb-bit (ccb-k1024) 1024)
        (ccb-bit (ccb-k2048) 2048))))
