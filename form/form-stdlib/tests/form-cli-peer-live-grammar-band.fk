; preludes: form-stdlib/form-cli-peer-live-grammar.fk

(do
    (sum (list
        (if (str_eq (frc-default-task-route) "direct-answer") 1 0)
        (if (str_eq (frc-explicit-recipe-prefix) "recipe ") 2 0)
        (if (str_eq (frc-explicit-source-prefix) "source ") 8192 0)
        (if (str_eq (frc-explicit-symbol-prefix) "symbol ") 131072 0)
        (if (str_eq (frc-explicit-ground-prefix) "ground ") 4194304 0)
        (if (str_eq (frc-explicit-weave-prefix) "weave ") 67108864 0)
        (if (and (str_eq (frc-source-route-rule)
                         "source-prefix-runs-one-caller-born-strict-source-action-without-model-forward")
                 (str_eq (frc-source-context-rule)
                         "source-root-and-artifact-are-born-once-at-peer-admission-not-reacquired-from-task-bytes")) 16384 0)
        (if (str_eq (frc-source-symbol-route-rule)
                    "symbol-prefix-queries-one-admission-born-source-snapshot-without-model-forward") 262144 0)
        (if (str_eq (frc-source-snapshot-reuse-rule)
                    "one-admission-source-snapshot-serves-many-hot-keyed-symbol-lookups-in-the-same-residence") 2097152 0)
        (if (and (str_eq (frc-grounded-answer-rule)
                         "ground-symbol-question-binds-one-current-source-observation-before-one-direct-local-model-turn")
                 (str_eq (frc-grounded-refusal-rule)
                         "grounded-symbol-absence-plurality-staleness-or-observation-miss-never-enters-model")) 8388608 0)
        (if (str_eq (frc-grounded-definition-rule)
                    "grounded-symbol-observation-streams-one-current-verified-balanced-definition-slice-to-the-direct-user-turn") 33554432 0)
        (if (and (str_eq (frc-grounded-weave-rule)
                         "weave-symbols-question-binds-each-current-source-observation-before-one-direct-local-model-turn")
                 (str_eq (frc-grounded-weave-refusal-rule)
                         "weave-missing-plural-stale-or-unborn-symbol-never-enters-model-and-retains-partial-observation")) 134217728 0)
        (if (str_eq (frc-retry-rule)
                    "direct-answer-failure-or-nothing-reframes-once-locally-only-while-stream-open") 4 0)
        (if (str_eq (frc-direct-response-rule)
                    "direct-answer-frame-asks-for-plain-prose-not-control") 128 0)
        (if (str_eq (frc-answer-capacity-rule)
                    "direct-answer-decoding-uses-resident-remaining-context-not-fixed-token-cap") 256 0)
        (if (str_eq (frc-observed-session-rule)
                    "task-observation-returns-the-live-session-directly-to-the-selected-action") 512 0)
        (if (str_eq (frc-direct-user-turn-rule)
                    "direct-answer-enters-as-user-turn-then-opens-plain-assistant-turn") 1024 0)
        (if (str_eq (frc-decode-pulse-rule)
                    "local-decode-publishes-exponentially-spaced-opaque-native-checkpoints") 2048 0)
        (if (str_eq (frc-bootstrap-teaching-rule)
                    "resident-bootstrap-carries-current-form-teaching-overlay-before-local-answering") 4096 0)
        (if (and (str_eq (fcpalg-kind "answer this") "direct-answer")
                 (str_eq (fcpalg-body "answer this") "answer this")) 8 0)
        (if (and (str_eq (fcpalg-kind "recipe (ground)") "recipe")
                 (str_eq (fcpalg-body "recipe (ground)") "(ground)")) 16 0)
        (if (and (str_eq (fcpalg-kind "source defn-psci-schema")
                         "source-concept")
                 (str_eq (fcpalg-body "source defn-psci-schema")
                         "defn-psci-schema")) 32768 0)
        (if (and (str_eq (fcpalg-kind "source @0.2.0.48") "source-nodeid")
                 (str_eq (fcpalg-body "source @0.2.0.48") "@0.2.0.48")) 65536 0)
        (if (and (str_eq (fcpalg-kind "symbol psci-schema") "source-symbol")
                 (str_eq (fcpalg-body "symbol psci-schema") "psci-schema")) 524288 0)
        (if (and (str_eq (fcpalg-kind "ground psci-schema :: What is it?")
                         "grounded-answer")
                 (str_eq (fcpalg-body "ground psci-schema :: What is it?")
                         "psci-schema :: What is it?")) 16777216 0)
        (if (and (str_eq (fcpalg-kind "weave psci-schema + psci-version :: What are they?")
                         "grounded-weave")
                 (str_eq (fcpalg-body "weave psci-schema + psci-version :: What are they?")
                         "psci-schema + psci-version :: What are they?")) 268435456 0)
        (if (and (eq (fcpalg-retry? "failure") 1)
                 (and (eq (fcpalg-retry? "nothing") 1)
                      (eq (fcpalg-retry? "value") 0))) 32 0)
        (if (and (ge (str_find (fcpalg-retry-task "heal the cell")
                               "heal the cell" 0) 0)
                 (lt (str_find (fcpalg-retry-task "heal the cell")
                               "remote" 0) 0)) 64 0))))
