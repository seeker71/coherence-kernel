; Repeated native outcomes select repair/replan, never success or blind retry.
; No files, models or telemetry. Expected 255.
; preludes: form-stdlib/bml/form-cli-code-repair-fixture.bml
(do
 (defn fcpb-bit (ok bit) (if ok bit 0))
 (let s (fcrf-implementation))
 (let call "{\"tool\":\"read\",\"arguments\":[\"calc.form\"]}")
 (let a (fcap-step s call (fcrf-checker)))
 (let b (fcap-step a call (fcrf-checker)))
 (let c (fcap-step b call (fcrf-checker)))
 (let blind (fcap-step c "{\"diagnosis\":\"need change\",\"change\":\"read again\",\"next\":\"implement\"}" (fcrf-checker)))
 (let plan (fcap-step c "{\"diagnosis\":\"Repeated reads provide no new evidence\",\"change\":\"Derive the expression from cases before editing\",\"next\":\"plan\"}" (fcrf-checker)))
 (let changed (fcap-step b "{\"tool\":\"edit\",\"arguments\":[\"calc.form\",\"add(x,1)\",\"add(x,2)\"]}" (fcrf-checker)))
 (let read (fcap-step changed call (fcrf-checker)))
 (let absent1 (fcap-step s "{\"tool\":\"rg\",\"arguments\":[\"missing\",\"calc.form\"]}" (fcrf-checker)))
 (sum (list
  (fcpb-bit (str_eq (fcap-stage b) "implement") 1)
  (fcpb-bit (str_eq (fcap-stage c) "repair") 2)
  (fcpb-bit (and (eq (fcap-repeat c) 1) (eq (fcap-calls c) 3)) 4)
  (fcpb-bit (str_eq (fcap-stage blind) "repair") 8)
  (fcpb-bit (str_eq (fcap-stage plan) "plan") 16)
  (fcpb-bit (and (str_eq (fcap-stage read) "implement") (eq (nth (fcap-tool-history read) 1) 1)) 32)
  (fcpb-bit (eq (fcap-failures absent1) 0) 64)
  (fcpb-bit (value_eq (fcap-docs c) (fcap-docs s)) 128))))
