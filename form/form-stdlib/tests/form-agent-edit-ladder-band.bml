; form-agent-edit-ladder-band.bml — the edit tool lands a drifted old text where exactly one place matches, names
; the rung, and refuses two places; a miss carries the nearest resident line window. No model runs.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/form-agent-tools.bml
;
; The fixtures are option 1's retained turn-2 reply (closure-unit-line, walk .hearth/code-memory/replies/
; 21393-1790835541222.txt, sha256 99a98cec..., byte-identical to replies 3 and 5) and the pre-turn
; form/form-stdlib/closure-lines.fk (366 bytes, sha256 e5cbb7b3..., the reply's own guard). Each is
; written through the carrier and read back before it is used. The reply's old text is "(do\n     0)",
; five spaces; the resident holds "(do\n    0)", four.
;
; Verdict 8191 when every claim lands:
;   1    both fixtures read back with their recorded sha256
;   2    the turn-2 reply's guarded edit lands at the whitespace-run rung, exit 0, stdout
;        "edited\nrung=whitespace-run\n", the header kept byte for byte and the four definitions in
;   4    the landed candidate keeps the caller's balance stdout ("0 0\n", the source's own)
;   8    an exact old text lands at the exact rung as today: stdout "edited\n", the text ne-replace-first gives
;   16   an old text that matches two places at the whitespace-run rung refuses edit-ambiguous with
;        matches 2, and no document changes
;   32   a miss at every rung is edit-not-found, and its evidence carries nearest_span: the resident line
;        window "beta\ngamma" at bytes 6..16, line 2, one equal line, its text the resident's own bytes
;   64   a failed guarded-batch step carries expected_sha256 and nearest_span
;   128  line-trimmed lands over trailing blanks; typographic lands curly quotes and an em dash as ASCII
;   256  indentation-relative lands unindented lines on an indented block and re-indents the new text
;   512  a two-step batch names each approximate step's rung; a batch whose second step is ambiguous rolls
;        back and its failure names the rung and the matches
;   1024 a block whose base indent drifted keeps its structure where whitespace-run lands: Python
;        "if x:\n    return 1" over an 8-space body lands its new body at 8 spaces, and YAML "b:\n  c: 1" under
;        "a:" lands "c: 9" and "e: 3" under b at 4 spaces, not under a
;   2048 an old whose lines carry more indent than the resident's dedents by the difference, and an old that
;        begins at a line's content with the resident's own leads below lands exactly as typed (no second shift)
;   4096 an old typed in a 2-space unit over a 4-space body: the witnessed lead maps to its own, and a deeper
;        new lead no line witnessed scales by the unit the witnesses agree on, so a nested block stays nested
section [form.bml] {
 class FormAgentEditLadderBand {
  def faelb-bit(ok, bit) = ok ? bit : 0;
  def faelb-path() = "form/form-stdlib/closure-lines.fk";
  // U+2014, U+201C and U+201D as their UTF-8 bytes
  def faelb-u(last) = byte_to_str(226) ++ byte_to_str(128) ++ byte_to_str(last);
  def faelb-resident() = str-join-with(["; closure-lines.fk " ++ faelb-u(148) ++ " read a line of an fkwu closure back to the unit that wrote it.", ";",
   "; `./fkwu --closure <unit> <out>` joins every unit of a closure into one plain-Form",
   "; file and heads each unit's text with a line \"; unit: <path>\". A sibling kernel",
   "; reports a stop at a line of that file; this unit names the authored unit and", "; the line within it.", "", "(do", "    0)", ""], "\n");
  def faelb-new() = str-join-with(["(do",
   "  (defn cl-marker? (s at) (eq (str_find s \"; unit: \" at) at))",
   "  (defn cl-line-end (s at)", "    (do", "      (let e (str_find s (byte_to_str 10) at))", "      (if (lt e 0) (str_len s) e)))",
   "  (defn cl-walk (s at line want unit start)", "    (do", "      (if (ge at (str_len s))", "          (nothing)", "          (do",
   "            (let end (cl-line-end s at))", "            (let mark (cl-marker? s at))", "            (if (eq line want)",
   "                (if (or mark (eq unit (nothing)))", "                    (nothing)", "                    (list unit (sub line start)))",
   "                (do", "                  (let next-unit (if mark (substring s (add at 8) end) unit))", "                  (let next-start (if mark line start))",
   "                  (cl-walk s (add end 1) (add line 1) want next-unit next-start)))))))",
   "  (defn cl-unit-at (text line) (cl-walk text 0 1 line (nothing) 0))", "  0)"], "\n");
  def faelb-reply() = json-emit(json-node-object([json-node-pair("tool", json-node-string("edit")), json-node-pair("arguments", json-node-array([json-node-string(faelb-path()), json-node-string("e5cbb7b3ed16cba2730c41b7137c048bee6ca527637c06eff2adbc2f4934c6dd"), json-node-string("(do\n     0)"), json-node-string(faelb-new())]))]));
  def faelb-sha(text) = hex-encode(sha256-stream-string(text));
  // written through the carrier and read back: the bytes a later reader would see
  def faelb-carried(name, text) {
   let path = temp_dir() ++ "/form-agent-edit-ladder-band-" ++ host_pid().str() ++ "-" ++ name;
   let wrote = write_file(path, text);
   let back = read_file(path);
   let gone = fs_remove(path);
   back ?? "";
  }
  def faelb-args(reply) = node_children(json-object-get(faj-json("turn-2-reply", reply), "arguments")) |> map(node => node_value(node));
  def faelb-docs(text) = [[faelb-path(), faelb-path(), text]];
  def faelb-doc-text(result) = fat-documents(result)[0][2];
  def faelb-obj(text) = faj-valid(text) ? faj-json("band-result", text) : json-node-object([]);
  def faelb-field(obj, key) = json-object-has?(obj, key) ? node_value(json-object-get(obj, key)) : nothing();
  def faelb-evidence(docs, args, result) = fat-guard-evidence(docs, "edit", args, result);

  def faelb-fixtures(reply, resident) = faelb-sha(reply) == "99a98cec6aeb5dc26fc8958a3800dcb21707d45d16a68cdd95a3b77e4dff29ec" && faelb-sha(resident) == "e5cbb7b3ed16cba2730c41b7137c048bee6ca527637c06eff2adbc2f4934c6dd" && len(resident) == 366;
  def faelb-turn2(result, resident) {
   let text = faelb-doc-text(result);
   let header = substring(resident, 0, str_find(resident, "(do", 0));
   fat-exit(result) == 0 && fat-out(result) == "edited\nrung=whitespace-run\n" && fat-error(result) == ""
   && substring(text, 0, len(header)) == header && str_find(text, "(defn cl-unit-at (text line)", 0) > 0 && str_find(text, "(defn cl-marker? (s at)", 0) > 0
   && substring(text, len(text) - 5, len(text)) == "  0)\n";
  }
  def faelb-balance(result, resident) {
   let before = fat-call(faelb-docs(resident), "balance", [faelb-path()], "");
   let after = fat-call(fat-documents(result), "balance", [faelb-path()], "");
   fat-out(before) == "0 0\n" && fat-out(after) == fat-out(before);
  }
  def faelb-exact(resident) {
   let r = fat-call(faelb-docs(resident), "edit", [faelb-path(), "(do\n    0)", "(do\n    1)"], "");
   fat-exit(r) == 0 && fat-out(r) == "edited\n" && faelb-doc-text(r) == ne-replace-first(resident, "(do\n    0)", "(do\n    1)");
  }
  def faelb-ambiguous() {
   let docs = [["a.fk", "a.fk", "(f  x)\n(g)\n(f\tx)\n"]];
   let r = fat-call(docs, "edit", ["a.fk", "(f x)", "(h)"], "");
   let obj = faelb-obj(fat-out(r));
   fat-exit(r) == 2 && fat-error(r) == "edit-ambiguous" && faelb-field(obj, "rung") == "whitespace-run" && faelb-field(obj, "matches") == 2 && fat-documents(r) == docs;
  }
  def faelb-near-docs() = [["n.txt", "n.txt", "alpha\nbeta\ngamma\ndelta\n"]];
  def faelb-missed() {
   let docs = faelb-near-docs();
   let args = ["n.txt", "beta\ngamma-x", "z"];
   let r = fat-call(docs, "edit", args, "");
   let ev = faelb-evidence(docs, args, r);
   let near = nothing?(ev) || !json-object-has?(ev, "nearest_span") ? json-node-object([]) : json-object-get(ev, "nearest_span");
   fat-exit(r) == 2 && fat-error(r) == "edit-not-found" && faelb-field(near, "text") == "beta\ngamma" && faelb-field(near, "start_byte") == 6
   && faelb-field(near, "end_byte") == 16 && faelb-field(near, "first_line") == 2 && faelb-field(near, "equal_lines") == 1
   && substring(docs[0][2], 6, 16) == "beta\ngamma";
  }
  def faelb-guarded-miss() {
   let docs = faelb-near-docs();
   let args = ["n.txt", faelb-sha(docs[0][2]), "gamma", "GAMMA", "delta-x\nomega", "z"];
   let r = fat-call(docs, "edit", args, "");
   let ev = faelb-evidence(docs, args, r);
   let near = nothing?(ev) || !json-object-has?(ev, "nearest_span") ? json-node-object([]) : json-object-get(ev, "nearest_span");
   fat-exit(r) == 2 && fat-error(r) == "edit-not-found" && faelb-field(faelb-obj(fat-out(r)), "failed_edit") == 2 && fat-documents(r) == docs
   && !nothing?(ev) && json-object-has?(ev, "expected_sha256") && faelb-field(near, "first_line") == 4;
  }
  def faelb-trimmed-typo() {
   let trimmed = fat-call([["t.txt", "t.txt", "keep  \nnext\nrest\n"]], "edit", ["t.txt", "keep\nnext", "K\nN"], "");
   let curly = fat-call([["q.txt", "q.txt", "say " ++ faelb-u(156) ++ "hi" ++ faelb-u(157) ++ " " ++ faelb-u(148) ++ " ok\n"]], "edit", ["q.txt", "say \"hi\" - ok", "said"], "");
   fat-out(trimmed) == "edited\nrung=line-trimmed\n" && faelb-doc-text(trimmed) == "K\nN\nrest\n"
   && fat-out(curly) == "edited\nrung=typographic\n" && faelb-doc-text(curly) == "said\n";
  }
  def faelb-indented() {
   let r = fat-call([["i.fk", "i.fk", "(do\n    (a)\n    (b))\n"]], "edit", ["i.fk", "(a)\n(b))", "(a)\n  (c)\n(b))"], "");
   fat-out(r) == "edited\nrung=indentation-relative\n" && faelb-doc-text(r) == "(do\n    (a)\n      (c)\n    (b))\n";
  }
  def faelb-batch() {
   let docs = [["b.fk", "b.fk", "(one  1)\n(two)\n(three\t3)\n(x  y)\n(x y)\n"]];
   let landed = fat-call(docs, "edit", ["b.fk", "(one 1)", "(one 11)", "(two)", "(two 2)", "(three 3)", "(three 33)"], "");
   let refused = fat-call(docs, "edit", ["b.fk", "(two)", "(two 2)", "(x   y)", "(z)"], "");
   let obj = faelb-obj(fat-out(refused));
   fat-out(landed) == "edited\nrung=whitespace-run step=1\nrung=whitespace-run step=3\n" && faelb-doc-text(landed) == "(one 11)\n(two 2)\n(three 33)\n(x  y)\n(x y)\n"
   && fat-error(refused) == "edit-ambiguous" && fat-documents(refused) == docs && faelb-field(obj, "failed_edit") == 2 && faelb-field(obj, "rung") == "whitespace-run"
   && faelb-field(obj, "matches") == 2;
  }
  def faelb-py() = "def f(x):\n    if x:\n        return 1\n    return 0\n";
  def faelb-drifted() {
   let py = fat-call([["f.py", "f.py", faelb-py()]], "edit", ["f.py", "if x:\n    return 1", "if x:\n    return 2"], "");
   let ym = fat-call([["c.yml", "c.yml", "a:\n  b:\n    c: 1\n  d: 2\n"]], "edit", ["c.yml", "b:\n  c: 1", "b:\n  c: 9\n  e: 3"], "");
   fat-exit(py) == 0 && fat-out(py) == "edited\nrung=whitespace-run\n" && faelb-doc-text(py) == "def f(x):\n    if x:\n        return 2\n    return 0\n"
   && fat-exit(ym) == 0 && fat-out(ym) == "edited\nrung=whitespace-run\n" && faelb-doc-text(ym) == "a:\n  b:\n    c: 9\n    e: 3\n  d: 2\n";
  }
  def faelb-framed() {
   let deeper = fat-call([["f.py", "f.py", faelb-py()]], "edit", ["f.py", "      if x:\n          return 1", "      if x:\n          return 2"], "");
   let spaced = "def f(x):\n    if x:\n        return  1\n";
   let absolute = fat-call([["g.py", "g.py", spaced]], "edit", ["g.py", "if x:\n        return 1", "if x:\n        return 2"], "");
   fat-out(deeper) == "edited\nrung=whitespace-run\n" && faelb-doc-text(deeper) == "def f(x):\n    if x:\n        return 2\n    return 0\n"
   && fat-out(absolute) == "edited\nrung=whitespace-run\n" && faelb-doc-text(absolute) == "def f(x):\n    if x:\n        return 2\n";
  }
  def faelb-unit() {
   let r = fat-call([["u.py", "u.py", "if x:\n    a = 1\n    b = 2\n"]], "edit", ["u.py", "if x:\n  a = 1", "if x:\n  a = 3\n  if a:\n    c = 4"], "");
   fat-out(r) == "edited\nrung=whitespace-run\n" && faelb-doc-text(r) == "if x:\n    a = 3\n    if a:\n        c = 4\n    b = 2\n";
  }
 }
 let reply = faelb-carried("turn-2-reply.json", faelb-reply());
 let resident = faelb-carried("closure-lines.fk", faelb-resident());
 let args = faelb-args(reply);
 let landed = fat-call(faelb-docs(resident), "edit", args, "");
 let verdict = faelb-bit(faelb-fixtures(reply, resident), 1) + faelb-bit(faelb-turn2(landed, resident), 2) + faelb-bit(faelb-balance(landed, resident), 4)
  + faelb-bit(faelb-exact(resident), 8) + faelb-bit(faelb-ambiguous(), 16) + faelb-bit(faelb-missed(), 32) + faelb-bit(faelb-guarded-miss(), 64)
  + faelb-bit(faelb-trimmed-typo(), 128) + faelb-bit(faelb-indented(), 256) + faelb-bit(faelb-batch(), 512)
  + faelb-bit(faelb-drifted(), 1024) + faelb-bit(faelb-framed(), 2048) + faelb-bit(faelb-unit(), 4096);
 print_str("form-agent-edit-ladder-band " ++ verdict.str());
 verdict;
}
