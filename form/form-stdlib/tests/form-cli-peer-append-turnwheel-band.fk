; form-cli-peer-append-turnwheel-band.fk — the append-only reader row and one
; selected resident act share a bounded macro-turn.
; Expected: 32767
;
; This band proves only the current scaffold: real bounded file reads, exact
; scanner watermarks, one completed task dispatched per turn, atomic egress
; admission before in-memory acknowledgement, explicit recovery-seeded dedup,
; and typed control results. It does not claim crash-safe recovery, client-ack
; compaction, a kernel scheduler, or a physical model/Metal crossing.
;
; preludes: form-stdlib/form-cli-peer-append-turnwheel.fk

(do
    (defn fcpatb-bit (held weight) (if held weight 0))
    (defn fcpatb-shared ()
        (fcrt-shared "" "" (empty) (empty) 256 8 (jonb-registry 1)))
    ; The harness builds the lease shape directly. It does not publish or
    ; invoke a JIT route: those are adjacent fourth-arm witnesses, not needed
    ; to prove this reader/selected-row composition.
    (defn fcpatb-host ()
        (do
            (let eid (list 0 1))
            (fcrt-host
                (list (wt-wheel (list) (fcpatb-shared))
                    (list (list eid (fcrt-unbound-route) 0)) eid (list))
                (list))))
    (defn fcpatb-selected-host ()
        (do
            (let eid (list 1 1))
            (let first (append
                (wt-row 51 (fcrt-program-flow 5) 0 "release/51")
                (list eid)))
            (let second (append
                (wt-row 52 (fcrt-program-flow 6) 4 "release/52")
                (list eid)))
            (fcrt-host
                (list (wt-wheel (list first second) (fcpatb-shared))
                    (list (list eid (fcrt-unbound-route) 2)) eid (list))
                (list))))
    (defn fcpatb-control-host ()
        (do
            (let eid (list 1 1))
            (let row (append
                (wt-row 71 (fcrt-program-flow 5) 4 "release/71")
                (list eid)))
            (fcrt-host
                (list (wt-wheel (list row) (fcpatb-shared))
                    (list (list eid (fcrt-unbound-route) 1)) eid (list))
                (list))))
    (defn fcpatb-organ (channel)
        (rai-organ (list (rai-channel channel 32 32 0)) 8))
    (defn fcpatb-join (channel exchange)
        (nth (ritj-ready
            (ritj-new (fcpatb-host) (fcpatb-organ channel) channel 8)
            exchange) 0))
    (defn fcpatb-state
        (join channel ingress-path egress-path max-bytes deadline capacity)
        (fcpat-new join (fcpsi-new (fcpatb-organ channel) 8)
            (fcpat-reader "band-reader" channel ingress-path
                (ritj-ready-exchange join) "wait" deadline max-bytes 0)
            egress-path capacity 4))
    (defn fcpatb-task
        (channel sequence exchange turn kind text complete-through)
        (fcpsi-frame-parse channel sequence exchange
            (fcpa-task-frame turn kind text) complete-through))
    (defn fcpatb-row (host id)
        (wt-find (wt-rows (le-w (fcrt-lw host))) id))

    (defn form-cli-peer-append-turnwheel-band ()
        (do
            (let channel "@0.2.0.980")
            (let exchange 971)
            (let ingress-path
                (str_concat (temp_dir) "/form-fcpat-band-ingress.log"))
            (let egress-path
                (str_concat (temp_dir) "/form-fcpat-band-egress.log"))
            (let failure-path
                (str_concat (temp_dir)
                    "/form-fcpat-band-absent-parent/egress.log"))
            (fs_remove ingress-path)
            (fs_remove egress-path)

            ; Empty physical water is absence, while the reader row still
            ; receives exactly one cooperative quantum.
            (let empty-write (write_file_text ingress-path ""))
            (let idle-state (fcpatb-state
                (fcpatb-join channel exchange) channel ingress-path
                egress-path 8 -1 8))
            (let idle (fcpat-reader-step idle-state 1))
            (let c0 (fcpatb-bit (and (eq empty-write 0)
                (and (str_eq (fcpat-result-signal idle) "nothing")
                (and (eq (fcpat-result-present? idle) 0)
                     (eq (fcpat-reader-turns (fcpat-reader-row
                        (fcpat-result-state idle))) 1)))) 1))

            ; max-bytes is a live reader quantum. Five opener bytes advance
            ; physical cursor water but cannot become a complete task.
            (let frame-a (fcpa-task-frame 41 "research" "observe heat"))
            (let frame-b (fcpa-task-frame 42 "test" "hold out"))
            (let both (str_concat frame-a frame-b))
            (let both-write (write_file_text ingress-path both))
            (let partial-state (fcpatb-state
                (fcpatb-join channel exchange) channel ingress-path
                egress-path 5 -1 8))
            (let partial (fcpat-reader-step partial-state 2))
            (let partial-peer (fcpat-peer (fcpat-result-state partial)))
            (let c1 (fcpatb-bit (and (eq both-write (str_len both))
                (and (eq (rai-channel-cursor
                    (rai-find-channel (rai-channels (fcpsi-ingress partial-peer))
                        channel)) 5)
                (and (eq (fcpsi-cursor-complete-through
                    (fcpsi-cursor-of partial-peer channel)) 0)
                     (eq (len (fcpat-pending
                        (fcpat-result-state partial))) 0)))) 2))

            ; One large byte quantum may finish two frames. One macro-turn
            ; still dispatches and durably acknowledges only the first.
            (let reset-egress (write_file_text egress-path ""))
            (let turn-state (fcpatb-state
                (fcpatb-join channel exchange) channel ingress-path
                egress-path (str_len both) -1 8))
            (let turned (fcpat-turn turn-state 3))
            (let after-turn (fcpat-result-state turned))
            (let first-ack (head (fcpat-acks after-turn)))
            (let waiting (head (fcpat-pending after-turn)))
            (let c2 (fcpatb-bit (and (eq reset-egress 0)
                (and (eq (fcpat-reader-turns
                    (fcpat-reader-row after-turn)) 1)
                (and (eq (len (fcpat-acks after-turn)) 1)
                (and (eq (len (fcpat-pending after-turn)) 1)
                (and (eq (fcpat-ack-turn first-ack) 41)
                     (eq (fcpsi-task-turn waiting) 42)))))) 4))

            ; Each completed task owns its exact end watermark. Task identity
            ; is stable across chunk sequence changes, not across content.
            (let parsed-a (fcpatb-task channel 9 exchange 41 "research"
                "observe heat" (str_len frame-a)))
            (let parsed-a2 (fcpatb-task channel 999 exchange 41 "research"
                "observe heat" (str_len frame-a)))
            (let parsed-b (fcpatb-task channel 9 exchange 42 "test"
                "hold out" (str_len both)))
            (let c3 (fcpatb-bit (and
                (node_eq (fcpsi-task-node parsed-a)
                    (fcpsi-task-node parsed-a2))
                (and (not (node_eq (fcpsi-task-node parsed-a)
                    (fcpsi-task-node parsed-b)))
                (and (eq (fcpat-ack-complete-through first-ack)
                        (str_len frame-a))
                (and (eq (fcpsi-task-complete-through waiting)
                        (str_len both))
                     (lt (fcpat-ack-complete-through first-ack)
                         (fcpsi-task-complete-through waiting)))))) 8))

            ; Successful append precedes both volatile acknowledgement and
            ; seen-set admission: all three agree on the same task NodeID.
            (let durable-text (read_file egress-path))
            (let c4 (fcpatb-bit (and
                (ge (str_find durable-text
                    (fcpat-field "task-node"
                        (fcpat-node-text (fcpat-ack-task-node first-ack))) 0)
                    0)
                (and (eq (len (fcpat-seen after-turn)) 1)
                     (node_eq (head (fcpat-seen after-turn))
                        (fcpat-ack-task-node first-ack)))) 16))

            ; A rejected physical append is failure and changes neither the
            ; acknowledgement list nor the seen set.
            (let failed-state (fcpatb-state
                (fcpatb-join channel exchange) channel ingress-path
                failure-path 8 -1 8))
            (let failed (fcpat-store-ack failed-state
                (fcpat-task-ack failed-state parsed-a "research" "choice" 1
                    "research" "choice" "research")))
            (let c5 (fcpatb-bit (and
                (str_eq (fcpat-result-signal failed) "failure")
                (and (eq (fcpat-result-present? failed) 0)
                (and (eq (len (fcpat-acks
                    (fcpat-result-state failed))) 0)
                     (eq (len (fcpat-seen
                        (fcpat-result-state failed))) 0)))) 32))

            ; Recovery is explicit and seeds only NodeIDs already known
            ; durable. Dispatch sees the seed without scanning egress again.
            (let recovered (fcpat-recover failed-state
                (list (fcpsi-task-node parsed-a))))
            (let duplicate (fcpat-dispatch-task recovered parsed-a 4))
            (let c6 (fcpatb-bit (and
                (str_eq (fcpat-result-signal duplicate) "deduplicated")
                (and (eq (fcpat-result-present? duplicate) 1)
                (and (nothing? (fcpat-result-ack duplicate))
                     (eq (len (fcpat-acks
                        (fcpat-result-state duplicate))) 0)))) 64))

            ; The selected-row helper advances one selected terminal quantum.
            ; Its sibling retains empty output and its original gas. This is
            ; deliberately arm-neutral: dynamic JIT execution is not claimed
            ; by this band and remains in the existing fourth-arm witness.
            (let host-before (fcpatb-selected-host))
            (let host-after (fcpat-step-host-row host-before 51))
            (let row-a (fcpatb-row host-after 51))
            (let row-b-before (fcpatb-row host-before 52))
            (let row-b-after (fcpatb-row host-after 52))
            (let c7 (fcpatb-bit (and (str_eq (wt-status row-a) "timeout")
                (and (eq (len (wt-toks row-b-after)) 0)
                (and (eq (wt-budget row-b-before) (wt-budget row-b-after))
                (and (eq (le-retain-of (le-tbl (fcrt-lw host-after))
                            (list 1 1)) 1)
                     (eq (len (fcrt-events host-after))
                        (add (len (fcrt-events host-before)) 1)))))) 128))

            ; Presence is independent from value. Absence, exact integer 0,
            ; and exact integer 1 remain three different typed records.
            (let n-ack (fcpat-ack exchange 1 "observe" "nothing" 0
                (nothing) "nothing" "" 0 (fcpsi-task-node parsed-a)))
            (let z-ack (fcpat-ack exchange 2 "observe" "value" 1
                0 "integer" "0" 0 (fcpsi-task-node parsed-a)))
            (let o-ack (fcpat-ack exchange 3 "observe" "value" 1
                1 "integer" "1" 0 (fcpsi-task-node parsed-a)))
            (let c8 (fcpatb-bit (and
                (and (eq (fcpat-ack-present? n-ack) 0)
                     (nothing? (fcpat-ack-value n-ack)))
                (and (and (eq (fcpat-ack-present? z-ack) 1)
                          (eq (fcpat-ack-value z-ack) 0))
                     (and (eq (fcpat-ack-present? o-ack) 1)
                          (eq (fcpat-ack-value o-ack) 1)))) 256))

            ; Unknown application movement is a present choice, not failure
            ; and not integer zero.
            (let choice-path
                (str_concat (temp_dir) "/form-fcpat-band-choice.log"))
            (fs_remove choice-path)
            (let choice-state (fcpatb-state
                (fcpatb-join channel exchange) channel ingress-path
                choice-path 8 -1 8))
            (let choice-task (fcpatb-task channel 10 exchange 61
                "invent" "listen" 17))
            (let chosen (fcpat-dispatch-task choice-state choice-task 5))
            (let c9 (fcpatb-bit (and
                (str_eq (fcpat-result-signal chosen) "choice")
                (and (eq (fcpat-result-present? chosen) 1)
                     (str_eq (fcpat-result-value chosen) "invent"))) 512))

            ; Deadline expiry is a typed timeout with absent value; task bytes
            ; do not enter scanner completion or pending task water.
            (let timeout-state (fcpatb-state
                (fcpatb-join channel exchange) channel ingress-path
                egress-path (str_len both) 6 8))
            (let timed (fcpat-reader-step timeout-state 7))
            (let c10 (fcpatb-bit (and
                (str_eq (fcpat-result-signal timed) "timeout")
                (and (eq (fcpat-result-present? timed) 0)
                (and (nothing? (fcpat-result-value timed))
                     (eq (len (fcpat-pending
                        (fcpat-result-state timed))) 0)))) 1024))

            ; Build one resident lease row for cut and undo. No program image
            ; executes here; this witnesses the control distinctions only.
            (let control-join0 (fcpatb-join channel exchange))
            (let control-join (ritj-with control-join0
                (fcpatb-control-host) (ritj-ingress control-join0)
                exchange (nothing)
                (ritj-events control-join0)))
            (let control-path
                (str_concat (temp_dir) "/form-fcpat-band-control.log"))
            (fs_remove control-path)
            (let control-state (fcpatb-state control-join channel ingress-path
                control-path 8 -1 8))
            (let cut-task (fcpatb-task channel 20 exchange 72
                "cut" "71" 21))
            (let cut (fcpat-dispatch-task control-state cut-task 8))
            (let c11 (fcpatb-bit (and
                (str_eq (fcpat-result-signal cut) "cut")
                (and (eq (fcpat-result-present? cut) 1)
                     (str_eq (fcpat-ack-movement
                        (fcpat-result-ack cut)) "cut-flow"))) 2048))

            ; Undo is represented by its movement while retaining the join's
            ; present replay value signal; it is not conflated with cut.
            (let undo-task (fcpatb-task channel 21 exchange 73
                "undo" "71" 22))
            (let undone (fcpat-dispatch-task
                (fcpat-result-state cut) undo-task 9))
            (let c12 (fcpatb-bit (and
                (str_eq (fcpat-ack-movement
                    (fcpat-result-ack undone)) "undo")
                (and (str_eq (fcpat-result-signal undone) "value")
                     (eq (fcpat-result-present? undone) 1))) 4096))

            ; Release closes this peer channel, marks the residence released,
            ; and carries no invented value.
            (let release-task (fcpatb-task channel 22 exchange 74
                "release" "channel" 23))
            (let released (fcpat-dispatch-task
                (fcpat-result-state undone) release-task 10))
            (let released-state (fcpat-result-state released))
            (let c13 (fcpatb-bit (and
                (str_eq (fcpat-result-signal released) "release")
                (and (eq (fcpat-result-present? released) 1)
                (and (eq (fcpat-released? released-state) 1)
                (and (eq (fcpat-ack-present?
                    (fcpat-result-ack released)) 0)
                     (str_eq (rai-channel-state
                        (rai-find-channel
                            (rai-channels (fcpsi-ingress
                                (fcpat-peer released-state))) channel))
                        "released"))))) 8192))

            ; Framebuffer evidence is bounded even as later observations
            ; arrive; the newest causal movement remains visible.
            (let bounded0 (fcpatb-state
                (fcpatb-join channel exchange) channel ingress-path
                egress-path 8 -1 2))
            (let bounded1 (fcpat-observe bounded0 exchange "one" "value" 1))
            (let bounded2 (fcpat-observe bounded1 exchange "two" "value" 2))
            (let bounded3 (fcpat-observe bounded2 exchange "three" "value" 3))
            (let c14 (fcpatb-bit (and (eq (len (fcpat-events bounded3)) 2)
                (and (str_eq (nth (nth (fcpat-events bounded3) 0) 1) "two")
                     (str_eq (nth (nth (fcpat-events bounded3) 1) 1) "three")))
                16384))

            (fs_remove ingress-path)
            (fs_remove egress-path)
            (fs_remove choice-path)
            (fs_remove control-path)
            (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14))))

    (form-cli-peer-append-turnwheel-band))
