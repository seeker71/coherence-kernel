; check-witness-pattern-band.bml — an rg check whose pattern does not compile is unmeetable at rung 0 (form-cli-check-witness.bml, fccw-rg-witness).
;
; A pattern that does not compile fails the same way whatever the documents hold, so no candidate can make that check
; pass: rung 0 names it fixed and the model is never handed it. The same text searched as a literal (-F) compiles, and a
; pattern that compiles over a writable path stays the model's to meet.
;
; Expected: 15
; Verdict 15 when every claim lands:
;   1   an rg check whose pattern does not compile reads fixed
;   2   the same text as a literal (-F) over a writable path does not read fixed
;   4   a pattern that compiles over a writable path does not read fixed
;   8   the premise: the pattern "(" does not compile
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/form-cli-check-witness.bml
section [form.bml] {
 class CheckWitnessPatternBand {
  def cwp-docs() = [["a.txt", "a.txt", "alpha\n"]];
  def cwp-row(args) = parse-json("check", "{\"tool\":\"rg\",\"arguments\":" ++ args ++ ",\"stdout\":\"1\\n\"}");
  def cwp-kind(args) = fccw-witness(cwp-row(args), cwp-docs(), ["a.txt"])[0];
  def cwp-c-uncompiled(ctx) = (String) cwp-kind("[\"-c\",\"(\",\"a.txt\"]") == "fixed";
  def cwp-c-literal(ctx) = (String) cwp-kind("[\"-c\",\"-F\",\"(\",\"a.txt\"]") != "fixed";
  def cwp-c-compiled(ctx) = (String) cwp-kind("[\"-c\",\"alpha\",\"a.txt\"]") != "fixed";
  def cwp-c-premise(ctx) = (String) far-patterns(["("], false, [])[1] != "";
 }
 live-claims("check-witness-pattern-band", 0, [["uncompiled", 1, 1, cwp-c-uncompiled], ["literal", 2, 1, cwp-c-literal], ["compiled", 4, 1, cwp-c-compiled], ["premise", 8, 1, cwp-c-premise]]);
}
