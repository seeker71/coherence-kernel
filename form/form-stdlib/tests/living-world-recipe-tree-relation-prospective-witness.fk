; living-world-recipe-tree-relation-prospective-witness.fk -- fresh M/N
; identity-aligned placement of the revised successor and its admitted recurrent
; relation composition.  Offered values are fixture data, never production
; vocabulary.  Diagnostic only; no Recipe, voice, or promotion authority moves.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/living-world-recipe-tree-revision-trial.fk form-stdlib/living-world-recipe-tree-revision-hypothesis.fk form-stdlib/living-world-recipe-tree-revision-prospective.fk form-stdlib/living-world-recipe-tree-relation-nursery.fk form-stdlib/living-world-recipe-tree-relation-offer.fk form-stdlib/living-world-recipe-tree-relation-prospective.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk

(let LWRRPW-SOURCE-M    (bp "LWRRPW-SOURCE-M"))
(let LWRRPW-SOURCE-N    (bp "LWRRPW-SOURCE-N"))
(let LWRRPW-EVIDENCE    (bp "LWRRPW-EVIDENCE"))
(let LWRRPW-ALTERNATIVE (bp "LWRRPW-ALTERNATIVE"))
(let LWRRPW-CASE-KEY    (bp "LWRRPW-CASE-KEY"))
(let LWRRPW-SCOPE       (bp "LWRRPW-SCOPE"))
(let LWRRPW-ROLE        (bp "LWRRPW-ROLE"))
(let LWRRPW-LENS        (bp "LWRRPW-LENS"))
(let LWRRPW-RESULT      (bp "LWRRPW-RESULT"))

(defn lwrrpw-cell (kind) (intern_node kind (empty)))
(defn lwrrpw-source-m () (lwrrpw-cell LWRRPW-SOURCE-M))
(defn lwrrpw-source-n () (lwrrpw-cell LWRRPW-SOURCE-N))
(defn lwrrpw-evidence () (lwrrpw-cell LWRRPW-EVIDENCE))
(defn lwrrpw-alternative () (lwrrpw-cell LWRRPW-ALTERNATIVE))
(defn lwrrpw-alternatives ()
    (lwo-field (list (lwrrpw-alternative))))
(defn lwrrpw-unknown () (lwlc-unknown (lwrrpw-evidence)))
(defn lwrrpw-entry (source payload)
    (lwphw-entry source (lwrrpw-evidence) payload))

(defn lwrrpw-case-key (index)
    (intern_node LWRRPW-CASE-KEY (list (intern_trivial_int index))))
(defn lwrrpw-role (index name)
    (intern_node LWRRPW-ROLE
        (list (lwrrpw-case-key index) (intern_trivial_string name))))
(defn lwrrpw-scope (index)
    (intern_node LWRRPW-SCOPE (list (lwrrpw-case-key index))))
(defn lwrrpw-projection (index name value)
    (lwre-projection (lwrrpw-scope index) (lwrrpw-role index name)
        (intern_trivial_int value) (lwrrpw-alternatives)
        (lwrrpw-unknown) (lwrrpw-evidence)))
(defn lwrrpw-binding (index name value)
    (lwre-projected-binding name (lwrrpw-projection index name value)
        (lwrrpw-evidence)))
(defn lwrrpw-bindings (index left right)
    (lwre-bindings
        (list (lwrrpw-binding index "left" left)
              (lwrrpw-binding index "right" right))))
(defn lwrrpw-lens (index)
    (lwlc-lens (lwlc-cell-shape)
        (intern_node LWRRPW-LENS (list (lwrrpw-case-key index)))
        (lwrrpw-evidence)))

(defn lwrrpw-case-one (index left right expected lens)
    (lwps-case (lwrrpw-bindings index left right)
        (oac-one (intern_trivial_int expected))
        (lwo-none) (lwo-none) (lwrrpw-alternatives)
        (lwrrpw-unknown) lens (lwrrpw-evidence)))
(defn lwrrpw-case-pending ()
    (lwps-case (lwrrpw-bindings 3 9 14) (oac-nothing)
        (oac-timeout (intern_trivial_int 12) (oac-no-default)
            (lwrrpw-evidence))
        (intern_trivial_int 5) (lwrrpw-alternatives)
        (lwrrpw-unknown) (lwo-none) (lwrrpw-evidence)))
(defn lwrrpw-case-condensed ()
    (do
        (let alternative
            (oac-alternative-ack (lwrrpw-case-key 4)
                (lwrrpw-alternative) (lwrrpw-evidence)))
        (lwps-case (lwrrpw-bindings 4 10 4) (oac-nothing)
            (oac-timeout (intern_trivial_int 12) alternative
                (lwrrpw-evidence))
            (intern_trivial_int 12) (lwrrpw-alternatives)
            (lwrrpw-unknown) (lwrrpw-lens 4) (lwrrpw-evidence))))

(defn lwrrpw-cases ()
    (lwo-field
        (list
            (lwrrpw-case-one 0 23 6 29 (lwo-none))
            (lwrrpw-case-one 1 13 8 21 (lwrrpw-lens 1))
            (lwrrpw-case-one 2 17 5 12 (lwo-none))
            (lwrrpw-case-pending)
            (lwrrpw-case-condensed))))
(defn lwrrpw-dataset ()
    (lwps-dataset (lwrrpw-cases) (lwrrpw-evidence)))
(defn lwrrpw-split (candidate relations)
    (lwps-split (lwrrp-history-bindings candidate relations)
        (lwo-empty-field) (lwps-dataset-bindings (lwrrpw-dataset))
        (lwrrpw-evidence)))
(defn lwrrpw-contract ()
    (lwps-contract (lwps-exact-identity) (lwo-none)
        (lwrrpw-alternatives) (lwrrpw-unknown) (lwrrpw-evidence)))
(defn lwrrpw-suite (candidate relations)
    (lwps-suite (lwrrpw-dataset) (lwrrpw-split candidate relations)
        (lwrrpw-contract) (lwrrpw-evidence)))

(defn lwrrpw-binding-entries (source items entries)
    (if (eq (len items) 0) entries
        (do
            (let binding (head items))
            (let projection (lwre-binding-projection binding))
            (lwrrpw-binding-entries source (tail items)
                (cons (lwrrpw-entry source binding)
                    (cons (lwrrpw-entry source (lwre-binding-source binding))
                        (cons (lwrrpw-entry source projection)
                            (cons (lwrrpw-entry source
                                    (lwre-projection-scope projection))
                                entries))))))))
(defn lwrrpw-case-entries (source items entries)
    (if (eq (len items) 0) entries
        (do
            (let case (head items))
            (lwrrpw-case-entries source (tail items)
                (lwrrpw-binding-entries source
                    (lwre-binding-items (lwps-case-bindings case))
                    (cons (lwrrpw-entry source (lwps-case-bindings case))
                        (cons (lwrrpw-entry source case) entries)))))))
(defn lwrrpw-suite-entries (source candidate relations)
    (lwrrpw-case-entries source (lwo-field-items (lwrrpw-cases))
        (list
            (lwrrpw-entry source (lwrrpw-evidence))
            (lwrrpw-entry source (lwrrpw-alternative))
            (lwrrpw-entry source (lwrrpw-unknown))
            (lwrrpw-entry source (lwrrpw-dataset))
            (lwrrpw-entry source (lwrrpw-split candidate relations))
            (lwrrpw-entry source (lwrrpw-contract))
            (lwrrpw-entry source (lwrrpw-suite candidate relations)))))
(defn lwrrpw-one-source-world (world candidate relations)
    (lwt-receive-stream world
        (lwrrpw-suite-entries (lwrrpw-source-m) candidate relations)))
(defn lwrrpw-two-source-world (world candidate relations)
    (lwt-receive-stream
        (lwrrpw-one-source-world world candidate relations)
        (lwrrpw-suite-entries (lwrrpw-source-n) candidate relations)))

(defn lwrrpw-metrics-progress (metrics)
    (lcfb-cat (list
        "exact:" (int_to_str (lwps-metrics-value metrics 2))
        ":plural:" (int_to_str (lwps-metrics-value metrics 3))
        ":contradicted:" (int_to_str (lwps-metrics-value metrics 4)))))

; children: upstream, parent/relation/relations/suite, recurrence views,
; baseline and relation-aware evaluations/comparison, revocation views,
; cached membrane/authority bits, events.
(defn lwrrpw-result
    (upstream parent relation relations suite one-world one-evaluation two-world
     suite-sources ready identity-clean source-clean baseline related comparison
     revoked-world revoked-evaluation revoked-suite-current revoked-parent-ready
     recipe-active events)
    (intern_node LWRRPW-RESULT
        (list upstream parent relation relations suite one-world one-evaluation
              two-world suite-sources (intern_trivial_int ready)
              (intern_trivial_int identity-clean)
              (intern_trivial_int source-clean) baseline related comparison
              revoked-world revoked-evaluation
              (intern_trivial_int revoked-suite-current)
              (intern_trivial_int revoked-parent-ready)
              (intern_trivial_int recipe-active) events)))

(defn lwrrpw-run ()
    (do
        (let upstream (lwrrow-run))
        (let offer-children (node_children upstream))
        (let prior (nth offer-children 0))
        (let parent (nth (node_children prior) 1))
        (let relation (nth offer-children 4))
        (let relations (lwo-field (list relation)))
        (let admitted-world
            (lwt-round-world (nth offer-children 11)))
        (let suite (lwrrpw-suite parent relations))
        (let started
            (lcfb-open-stream "living-world-recipe-tree-relation-prospective"
                "form-native" "lwrrpw-run"
                "fresh-M/N-relation-aware-prospective-placement"
                "form/form-stdlib/tests/living-world-recipe-tree-relation-prospective-witness.fk"
                247 10))

        (let one-world
            (lwrrpw-one-source-world admitted-world parent relations))
        (let one-evaluation
            (lwrrp-evaluate one-world parent relations suite 2))
        (let one-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-prospective"
                "first-suite-offer" "leave" "form-native"
                "lwrrp-evaluate"
                "sources:1:evaluation:nothing" 1 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-prospective-witness.fk"
                263 10))

        (let two-world
            (lwrrpw-two-source-world admitted-world parent relations))
        (let suite-sources (lwrtep-suite-sources two-world suite))
        (let identity-clean
            (lwrrp-identity-clean? parent relations suite))
        (let source-clean
            (lwrrp-source-clean? two-world parent relations suite 2))
        (let membrane-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-prospective"
                "prospective-membrane" "leave" "form-native"
                "lwrrp-identity-clean?/lwrrp-source-clean?"
                (lcfb-cat (list
                    "history-bindings:"
                    (int_to_str (lwo-field-size
                        (lwrrp-history-bindings parent relations)))
                    ":prospective-bindings:"
                    (int_to_str (lwo-field-size
                        (lwps-split-prospective (lwps-suite-split suite))))
                    ":sources:" (int_to_str (lwo-field-size suite-sources))
                    ":identity-clean:" (int_to_str identity-clean)
                    ":source-clean:" (int_to_str source-clean)))
                2 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-prospective-witness.fk"
                279 10))

        (let ready-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-prospective"
                "currentness" "enter" "form-native" "lwrrp-ready?"
                "suite-parent-relation-graph" 3 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-prospective-witness.fk"
                296 10))
        (let ready (lwrrp-ready? two-world parent relations suite 2))
        (let ready-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-prospective"
                "currentness" "leave" "form-native" "lwrrp-ready?"
                (lcfb-cat (list "ready:" (int_to_str ready))) 4 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-prospective-witness.fk"
                302 10))

        (let baseline (lwrtrp-evaluate-new-ready parent suite))
        (let related (lwrrp-evaluate-ready parent relations suite))
        (let comparison (lwps-compare baseline related))
        (let placement-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-prospective"
                "paired-placement" "leave" "form-native"
                "same-dataset/split/contract"
                (lcfb-cat (list
                    "baseline:"
                    (lwrrpw-metrics-progress
                        (lwps-evaluation-metrics baseline))
                    ":related:"
                    (lwrrpw-metrics-progress
                        (lwps-evaluation-metrics related))))
                5 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-prospective-witness.fk"
                313 10))
        (let comparison-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-prospective"
                "baseline-to-related" "leave" "form-native" "lwps-compare"
                (lwrrp-progress-target comparison) 6 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-prospective-witness.fk"
                327 10))

        (let recipe
            (lwrrn-trial-recipe
                (lwrro-choice-trial (lwo-emergent-shape relation))))
        (let recipe-active (lwo-active? two-world recipe))
        (let authority-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-prospective"
                "authority" "leave" "form-native" "lwo-active?"
                (lcfb-cat (list
                    "relation-active:"
                    (int_to_str (lwo-active? two-world relation))
                    ":recipe-active:" (int_to_str recipe-active)
                    ":diagnostic-only:1"))
                7 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-prospective-witness.fk"
                336 10))

        (let revoke-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-prospective"
                "relation-revocation" "enter" "form-native"
                "lwrrow-release-candidate"
                "exact-active-relation-attributions" 8 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-prospective-witness.fk"
                350 10))
        (let revoked-world
            (lwrrow-release-candidate two-world relation))
        (let revoked-evaluation
            (lwrrp-evaluate revoked-world parent relations suite 2))
        (let revoked-suite-current
            (lwps-suite-current? revoked-world suite 2))
        (let revoked-parent-ready
            (lwrtrp-ready? revoked-world parent suite 2))
        (let revoked-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-prospective"
                "relation-revocation" "leave" "form-native"
                "lwrrp-evaluate/lwrtrp-ready?"
                (lcfb-cat (list
                    "related-evaluation-nothing:"
                    (int_to_str
                        (node_eq revoked-evaluation (lwo-none)))
                    ":suite-current:"
                    (int_to_str revoked-suite-current)
                    ":parent-ready:"
                    (int_to_str revoked-parent-ready)))
                9 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-prospective-witness.fk"
                359 10))

        (lwrrpw-result upstream parent relation relations suite one-world
            one-evaluation two-world suite-sources ready identity-clean
            source-clean baseline related comparison revoked-world
            revoked-evaluation revoked-suite-current revoked-parent-ready
            recipe-active (framebuffer-events))))

; Privacy-safe aggregate projection: no binding values, expected outputs,
; per-case answers, or offered payloads leave the witness.
(defn lwrrpw-observe ()
    (do
        (let result (lwrrpw-run))
        (let children (node_children result))
        (let baseline (nth children 12))
        (let related (nth children 13))
        (let comparison (nth children 14))
        (let baseline-metrics (lwps-evaluation-metrics baseline))
        (let related-metrics (lwps-evaluation-metrics related))
        (let delta (lwps-delta-values (lwps-comparison-delta comparison)))
        (list
            (lwo-field-size (nth children 8))
            (lwo-field-size
                (lwrrp-history-bindings (nth children 1) (nth children 3)))
            (lwo-field-size
                (lwps-split-prospective
                    (lwps-suite-split (nth children 4))))
            (node_value (nth children 9))
            (node_value (nth children 10))
            (node_value (nth children 11))
            (lwps-metrics-value baseline-metrics 0)
            (lwps-metrics-value baseline-metrics 1)
            (lwps-metrics-value baseline-metrics 2)
            (lwps-metrics-value baseline-metrics 3)
            (lwps-metrics-value baseline-metrics 4)
            (lwps-metrics-value related-metrics 0)
            (lwps-metrics-value related-metrics 1)
            (lwps-metrics-value related-metrics 2)
            (lwps-metrics-value related-metrics 3)
            (lwps-metrics-value related-metrics 4)
            (lwps-comparison-admissible comparison)
            (lwps-comparison-repeated comparison)
            (nth delta 2) (nth delta 3) (nth delta 4)
            (node_eq (nth children 6) (lwo-none))
            (node_eq (nth children 16) (lwo-none))
            (node_value (nth children 17))
            (node_value (nth children 18))
            (node_value (nth children 19))
            (len (nth children 20)))))

; witnessed: 2026-08-09 -> fresh M/N paired placement and revocation observed on fkwu
0
