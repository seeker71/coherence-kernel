; form-cli-nodeid-knowledge-on-demand-live-band.fk — the actual local source
; unit crossing.  No model or Metal lane is opened.
;
; PROOF LEVEL: FOURTH-ARM ONLY (host-exec + staged child + persisted registry; go answers 4096 of 8191, rust/ts do not bind host-exec — witnessed 2026-09-03)
; Verdict 8191 when query and staged-current both return typed current evidence.
; preludes: form-stdlib/form-cli-nodeid-knowledge-on-demand-carrier.fk

(do
    (let query (fcnkc-query "defn-psci-schema"))
    (let staged (fcnkc-stage "current" "defn-psci-schema"))
    (sum (list
        (if (eq (str_find query "nodeid-knowledge\nstatus=observed" 0) 0) 1 0)
        (if (ge (str_find query "source-unit-returned-typed-result" 0) 0) 2 0)
        (if (ge (str_find query "\nnodeid-knowledge\nstatus=hit" 0) 0) 4 0)
        (if (ge (str_find query "route-mode=strict-one-bucket" 0) 0) 8 0)
        (if (ge (str_find query "lookup-count=1" 0) 0) 16 0)
        (if (ge (str_find query "scannerless=1" 0) 0) 32 0)
        (if (ge (str_find query "model-executed=0" 0) 0) 64 0)
        (if (ge (str_find query "path=form/form-stdlib/public-source-concept-index.fk" 0) 0) 128 0)
        (if (eq (str_find staged "nodeid-stage\nstatus=observed" 0) 0) 256 0)
        (if (ge (str_find staged "\nnodeid-stage\nstage=current" 0) 0) 512 0)
        (if (ge (str_find staged "status=hit" 0) 0) 1024 0)
        (if (ge (str_find staged "answer-bytes=" 0) 0) 2048 0)
        (if (and (ge (str_find query "child-exit=unobserved" 0) 0)
                 (ge (str_find staged "child-exit=unobserved" 0) 0)) 4096 0))))
