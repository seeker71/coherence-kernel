; direct-source-jit-discovery-band.fk -- recursive direct-source heat becomes
; a structural candidate offered to the existing gate without seed counters.
;
; Verdict 32767 (15 bits):
;   1      sum-down(6) is observed recursively as 21
;   2      seven recursive arrivals correlate to one structural function ID
;   4      discovery has not touched the gate: candidate fires remain zero
;   8      the measured candidate is hot and appears as one explicit choice
;   16     cut selects that exact structural function identity
;   32     first real offer is Form route, born zero, cold challenger agrees
;   64     fifth real offer births native once
;   128    sixth offer reuses native, born zero, challenger still agrees
;   256    function identity and gate candidate identity remain distinct and
;          correlated in the offer receipt
;   512    undo of the fifth receipt restores the four-fire, unbirthed gate
;   1024   replay after undo births once again (immutable reversible state)
;   2048   legitimate recursive results 0 and 1 remain present 0 and 1
;   4096   insufficient fuel is timeout with exact nothing and partial heat 2
;   8192   unknown cut is exact nothing, not index zero or the first choice
;   16384  tied hottest direct-source identities remain a two-row choice
;
; preludes: form-stdlib/direct-source-jit-discovery.fk

(do
    (defn dsjdb-bit (ok bit) (if ok bit 0))

    (defn dsjdb-offer-n (gate row argument remaining last births)
        (if (eq remaining 0) (list gate last births)
            (do
                (let receipt (dsjd-offer gate row argument))
                (dsjdb-offer-n (dsjd-offer-after receipt) row argument
                    (sub remaining 1) receipt
                    (add births (dsjd-offer-born receipt))))))

    (defn dsjdb-touch-n (discovery spec remaining)
        (if (eq remaining 0) discovery
            (dsjdb-touch-n (dsjd-touch discovery spec)
                           spec (sub remaining 1))))

    (defn direct-source-jit-discovery-band ()
        (do
            (let epoch 270827)
            (let gate0 (hg-gate epoch))
            (let discovery0 (dsjd-discovery epoch))
            (let recursive (dsjd-observe-sum-down discovery0 6 7))
            (let discovery (dsjd-result-discovery recursive))
            (let spec (dsjd-sum-spec epoch))
            (let function-id (dsjd-spec-function-id spec))
            (let candidate-id (dsjd-spec-candidate-id spec))
            (let choice (dsjd-hot-choice discovery))
            (let selected (dsjd-cut choice function-id))

            ; Four offers stay Form; the retained fifth receipt is the birth.
            (let offered4 (dsjdb-offer-n gate0 selected 6 4 (nothing) 0))
            (let gate4 (nth offered4 0))
            (let first (dsjd-offer gate0 selected 6))
            (let fifth (dsjd-offer gate4 selected 6))
            (let sixth (dsjd-offer (dsjd-offer-after fifth) selected 6))
            (let replay (dsjd-offer (dsjd-undo fifth) selected 6))

            (let zero (dsjd-observe-sum-down (dsjd-discovery epoch) 0 1))
            (let one (dsjd-observe-sum-down (dsjd-discovery epoch) 1 2))
            (let timed (dsjd-observe-sum-down (dsjd-discovery epoch) 4 2))

            ; A second direct-source call site can share the same candidate
            ; program while retaining a distinct structural function identity.
            (let shadow (dsjd-spec epoch
                "sum-down-shadow:n+sum-down-shadow(n-1);base=0"
                (dsjd-sum-program) (dsjd-sum-root)))
            (let tied-discovery (dsjdb-touch-n discovery shadow 7))
            (let tied-choice (dsjd-hot-choice tied-discovery))

            (sum (list
                (dsjdb-bit (and (str_eq (dsjd-result-status recursive) "done")
                                (eq (dsjd-result-value recursive) 21)) 1)
                (dsjdb-bit (eq (dsjd-hits discovery function-id) 7) 2)
                (dsjdb-bit (and (eq (hg-fires gate0 candidate-id) 0)
                                (nothing? (jonb-find
                                    (jonb-entries (hg-reg gate0)) candidate-id))) 4)
                (dsjdb-bit (and (eq (len choice) 1)
                                (node_eq (dsjd-row-function-id (head choice))
                                         function-id)) 8)
                (dsjdb-bit (and (not (nothing? selected))
                                (node_eq (dsjd-row-function-id selected)
                                         function-id)) 16)
                (dsjdb-bit (and (str_eq (nth first 1) "form")
                                (and (eq (dsjd-offer-born first) 0)
                                     (dsjd-offer-agrees? first))) 32)
                (dsjdb-bit (and (str_eq (nth fifth 1) "native")
                                (and (eq (dsjd-offer-born fifth) 1)
                                     (dsjd-offer-agrees? fifth))) 64)
                (dsjdb-bit (and (str_eq (nth sixth 1) "native")
                                (and (eq (dsjd-offer-born sixth) 0)
                                     (dsjd-offer-agrees? sixth))) 128)
                (dsjdb-bit (and (node_eq (nth fifth 5) function-id)
                                (and (node_eq (nth fifth 6) candidate-id)
                                     (not (node_eq function-id candidate-id)))) 256)
                (dsjdb-bit (and (eq (hg-fires (dsjd-undo fifth) candidate-id) 4)
                                (nothing? (jonb-find
                                    (jonb-entries (hg-reg (dsjd-undo fifth)))
                                    candidate-id))) 512)
                (dsjdb-bit (and (eq (dsjd-offer-born replay) 1)
                                (dsjd-offer-agrees? replay)) 1024)
                (dsjdb-bit (and (eq (dsjd-result-value zero) 0)
                                (eq (dsjd-result-value one) 1)) 2048)
                (dsjdb-bit (and (str_eq (dsjd-result-status timed) "timeout")
                                (and (nothing? (dsjd-result-value timed))
                                     (eq (dsjd-hits
                                         (dsjd-result-discovery timed)
                                         function-id) 2))) 4096)
                (dsjdb-bit (nothing? (dsjd-cut choice (make_nodeid 31 2 0 999))) 8192)
                (dsjdb-bit (and (eq (len tied-choice) 2)
                                (and (not (nothing? (dsjd-cut tied-choice function-id)))
                                     (not (nothing? (dsjd-cut tied-choice
                                         (dsjd-spec-function-id shadow)))))) 16384)))))

    (direct-source-jit-discovery-band))
