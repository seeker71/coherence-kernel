; form-eval-full-selected-if-band.fk — selected/lazy IF on the scannerless full evaluator.
;
; Each bit witnesses meaning that eager arm evaluation cannot preserve:
;   1    true selects then and scans past an unbound call without resolving it
;   2    0 selects else and scans past an unbound call without resolving it
;   4    nothing remains distinct from 0 and follows the evaluator's existing truthy path
;   8    a recursive base case terminates
;   16   the selected true arm alone contributes its environment
;   32   the selected false arm alone contributes its environment
;   64   a recipe defined in one source fragment remains recursive when invoked from the next
;
; Verdict 127 on fkwu, Go, Rust, and TypeScript means the cursor advanced over dead nested source,
; selected values and environments survived, nothing/0/1 stayed distinct, and resident recursion
; terminated without adding a callable seat for the newly arrived recipe.
;
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk
(do
    (defn fefsib-bit (yes bit) (if yes bit 0))
    (defn fefsib-resident-recursion ()
        (do
            (let defined
                (fef-eval-state
                    "(defn descend (n) (if (eq n 0) 42 (descend (sub n 1))))"
                    (fef-empty-env)))
            (fef-v (fef-eval-state "(descend 7)" (fef-e defined)))))
    (add
        (fefsib-bit
            (eq (fef-eval "(if 1 42 (unbound (nested 1)))") 42)
            1)
        (add
            (fefsib-bit
                (eq (fef-eval "(if 0 (unbound (nested 1)) 42)") 42)
                2)
            (add
                (fefsib-bit
                    (eq (fef-eval "(if nothing 42 0)") 42)
                    4)
                (add
                    (fefsib-bit
                        (eq
                            (fef-eval
                                "(do (defn down (n) (if (eq n 0) 42 (down (sub n 1)))) (down 5))")
                            42)
                        8)
                    (add
                        (fefsib-bit
                            (eq
                                (fef-eval
                                    "(do (defn pick (x) 0) (if 1 (defn pick (x) (add x 1)) (defn pick (x) (add x 2))) (pick 40))")
                                41)
                            16)
                        (add
                            (fefsib-bit
                                (eq
                                    (fef-eval
                                        "(do (defn pick (x) 0) (if 0 (defn pick (x) (add x 1)) (defn pick (x) (add x 2))) (pick 40))")
                                    42)
                                32)
                            (fefsib-bit (eq (fefsib-resident-recursion) 42) 64))))))))
