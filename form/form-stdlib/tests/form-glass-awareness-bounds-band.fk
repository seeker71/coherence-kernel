; Attention bounds and freshness at the width that exercises the shared limit.
; Expected: 511. Pure fixture frames, no living state is published.
; preludes: form/form-stdlib/bml/form-glass-awareness.bml
(do
  (defn gabd-bit (ok bit) (if ok bit 0))
  (defn gabd-rows (n) (if (le n 0) (list) (cons (fgo-int "kernel" (str_concat "count." (int_to_str n)) "fixture" n "count" 0 "unified" "physical-live" "fixture" "live" "kernel" "") (gabd-rows (sub n 1)))))
  (defn gabd-frames (n rows) (if (le n 0) (list) (cons (fga-frame (str_concat "fixture." (int_to_str n)) "metric" (FGSRSchema) 2 10000 500 "read" rows) (gabd-frames (sub n 1) rows))))
  (let frames (gabd-frames 23 (gabd-rows 80)))
  (let first (fga-step frames 16 10001 (fga-state-empty)))
  (let second (fga-step frames 16 10002 first))
  (let b1 (gabd-bit (and (le (len (fga-get first "rows")) 512) (eq (fga-get first "after") 483)) 1))
  (let b2 (gabd-bit (and (eq (fga-get first "cursor") 21) (eq (fga-get second "cursor") 42)) 2))
  (let b3 (gabd-bit (and (eq (fga-get second "gifts") 1) (eq (fga-get second "unread-rows") 1357)) 4))
  (let frame (head frames))
  (let raw (head (fga-get frame "rows")))
  (let old (fgo-row-at raw 9999 1 2))
  (let b4 (gabd-bit (str_eq (fga-classify (fga-metric frame old 10001)) "stale-source") 8))
  (let catalog (fgo-row-with-truth raw "catalog" "stored"))
  (let b5 (gabd-bit (and (str_eq (fga-classify (fga-metric frame catalog 10001)) "catalog") (eq (fga-attention? "catalog") 0)) 16))
  (let b6 (gabd-bit (eq (fga-entry-fresh frame 10002 10001) -1) 32))
  (let b7 (gabd-bit (eq (len (fga-records frames 10001 0 64)) 506) 64))
  (let stages (fga-window-stages frames 16 32))
  (let b8 (gabd-bit (and (eq (fga-get (head stages) "before") 16) (eq (fga-get (head stages) "after") 21)) 128))
  (let privateNode (intern_trivial_string "PRIVATE-SOURCE-CHILD"))
  (let public (fga-public-event (list (fga-pair "source-node" privateNode) (fga-pair "id" "fixture"))))
  (let b9 (gabd-bit (and (nothing? (fga-get public "source-node")) (str_eq (fga-get public "source-node-id") (fgo-node-id privateNode))) 256))
  (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 b9)))))))))
