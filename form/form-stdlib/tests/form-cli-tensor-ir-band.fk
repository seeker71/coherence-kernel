    (add (mlg-check)
        (add (if (eq (nt-eval (mlg-emit (mlg-add2))) 5) 64 0)
        (add (if (eq (nt-eval (mlg-emit (mlg-mul2))) 6) 128 0)
        (add (if (eq (nt-eval (mlg-emit (mlg-max2))) 9) 256 0)
             (if (eq (nt-eval (mlg-emit (mlg-vadd-sum))) 33) 512 0))))))
