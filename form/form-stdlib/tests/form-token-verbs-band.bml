; form-token-verbs-band.bml — the verbs Form runs in stream: a pure eval over the body's own cursor,
; substrate lookup, node access, creation and selection, and recipes run in Form.
; preludes: form-stdlib/bml/form-token-verbs.bml
; Verdict 255
;
; The knowledge fixtures are scratch receipts directories under temp_dir, read back through the
; carrier and removed at the end; nothing else touches the disk.
;     1  eval answers arithmetic, comparison, text, lists, local definitions, recursion and floats
;        exactly, as value=<value_str>;
;     2  purity is by construction: a host door, a file, a process, Metal or a print answers
;        nothing=not-pure:<name>; a payload the compiler would stop on (x.foo()) and a nested control
;        are refused, and the process goes on
;     4  budgets are named answers: steps, wall time, call depth and value size
;     8  knowledge-query reads the enrich resources and the receipts it is given: an authored sense
;        first, then receipts ranked by name, opening and date; no terms and no grounded row are
;        distinct nothings; a receipt whose title carries control bytes is not offered
;    16  node-make interns a category and children; node-get reads kind, value and children back;
;        an integer leaf needs no holding and another session reads the interned cell; node-select answers the first candidate whose predicate
;        holds through the choice lane, and a refusing predicate is named
;    32  recipes: an affine birth runs in Form and Metal is refused in the sandbox; i32 overflow is
;        nothing; a BML recipe is born and run on any value; choice falls through an overflow to the
;        next address; recipe(@address) composes inside eval
;    64  try recovers an evaluation error but never a spent budget or a refused door
;   128  words are budgeted, not only the walk: a list of lists past the one cell allowance and
;        str() of it answer size-budget; a value whose words outgrow the observation answers
;        value-exceeds-observation, and str() past the text allowance answers size-budget, each
;        within the wall budget; str() under its allowance speaks exactly; a value built to carry
;        control bytes answers value-carries-control; node-select candidates and choice
;        alternatives share one control's budgets, so sixteen heavy candidates or eight heavy
;        alternatives answer step-budget within the wall budget
section [form.bml] {
 class FormTokenVerbsBand {
  def ftvb-claim(ok, bit) = ok ? bit : 0;
  def ftvb-is(s, payload, want) = ftv-eval(s, payload) == want;
  def ftvb-values(s) = ftvb-is(s, "17 * 23 + 4", "value=395;") && ftvb-is(s, "(1 + 2) * 3", "value=9;") && ftvb-is(s, "7 / 2", "value=3;") && ftvb-is(s, "-7 % 3", "value=-1;") && ftvb-is(s, "3 > 2 && 2 != 3", "value=1;") && ftvb-is(s, "2 == 2.0", "value=1;") && ftvb-is(s, "\"form\" ++ \"-\" ++ \"token\"", "value=form-token;") && ftvb-is(s, "substring(\"coherence\", 2, 5)", "value=her;") && ftvb-is(s, "[1,2,3] |> map(x => x * x) |> sum", "value=14;") && ftvb-is(s, "1 .. 11 |> filter(x => x % 2 == 0) |> len", "value=5;") && ftvb-is(s, "let a = 4; a * a + len(\"abc\")", "value=19;") && ftvb-is(s, "def fact(n) = n <= 1 ? 1 : n * fact(n - 1); fact(10)", "value=3628800;") && ftvb-is(s, "foldl((a, b) => a + b, 0, 1 .. 101)", "value=5050;") && ftvb-is(s, "35.0 * 8.25", "value=288.75;") && ftvb-is(s, "[3, \"two\", [4]]", "value=[3, two, [4]];") && ftvb-is(s, "if 3 > 2 then \"yes\" else \"no\"", "value=yes;") && ftvb-is(s, "max([4, 9, 2])", "value=9;");
  def ftvb-pure(s) = ftvb-is(s, "host_spawn([\"rm\"])", "nothing=not-pure:host_spawn;") && ftvb-is(s, "read_file(\"/etc/hosts\")", "nothing=not-pure:read_file;") && ftvb-is(s, "write_file(\"x\", \"y\")", "nothing=not-pure:write_file;") && ftvb-is(s, "metal_buf_alloc(4)", "nothing=not-pure:metal_buf_alloc;") && ftvb-is(s, "print_str(\"hi\")", "nothing=not-pure:print_str;") && ftvb-is(s, "[1] |> map(x => fs_list(\".\"))", "nothing=not-pure:fs_list;") && ftvb-is(s, "x.foo()", "nothing=parse-refused;") && ftvb-is(s, "1 }; def g() = host_spawn([1]); def h() = { 2", "nothing=parse-refused;") && ftvb-is(s, "1 + <|form:eval|>2", "nothing=nested-control;") && ftvb-is(s, "y + 1", "nothing=unknown-name:y;") && ftvb-is(s, "\"ten\" + 10", "nothing=kind:add;");
  def ftvb-budgets(s) {
   let slow = ftv-session();
   record_set(slow, "steps", 200);
   let stopped = ftv-session();
   record_set(stopped, "wall-ms", -1);
   ftvb-is(slow, "foldl((a, b) => a + b, 0, 1 .. 1000)", "nothing=step-budget;") && ftvb-is(stopped, "foldl((a, b) => a + b, 0, 1 .. 1000)", "nothing=wall-budget;") && ftvb-is(s, "def f(n) = f(n + 1); f(0)", "nothing=depth-budget;") && ftvb-is(s, "1 .. 100000 |> sum", "nothing=size-budget;") && ftvb-is(s, "10 / 0", "nothing=division-by-zero;") && ftvb-is(s, "nothing", "nothing=absent-value;");
  }
  def ftvb-receipt(dir, name, text) = write_file(dir ++ "/receipts/" ++ name, text) == len(text);
  def ftvb-knowledge(root) {
   let made = fs_mkdir(root ++ "receipts");
   let w1 = ftvb-receipt(root, "2026-01-02-lantern-harvest.md", "# Lantern harvest\nThe lantern was carried home.\n");
   let w2 = ftvb-receipt(root, "2026-03-04-harvest-seam.md", "# The harvest seam\nNo lantern here.\n");
   let w3 = ftvb-receipt(root, "2026-05-06-quiet-room.md", "# A quiet room\nThe lantern stood in a corner.\n");
   let w4 = ftvb-receipt(root, "notes.txt", "lantern lantern\n");
   let s = ftv-session-at(root);
   let lantern = ftv-knowledge(s, "Which receipt speaks of the lantern?");
   let trust = ftv-knowledge(s, "trust");
   let forged = ftvb-forged(root ++ "forged/");
   w1 && w2 && w3 && w4 && (lantern == "value=receipts/2026-01-02-lantern-harvest.md: Lantern harvest | receipts/2026-05-06-quiet-room.md: A quiet room | receipts/2026-03-04-harvest-seam.md: The harvest seam;") && ftv-starts?(trust, "value=trust: when what other say and do are the same again [cognition/form-neutral-word-field.fk]") && (ftv-knowledge(s, "the of and") == "nothing=no-terms;") && (ftv-knowledge(s, "zzqqx") == "nothing=no-grounded-row;") && (ftv-knowledge(s, "a <|form:eval|>1") == "nothing=nested-control;") && forged;
  }
  // a newer receipt whose title forges an observation close ranks first by name, and is still
  // not offered; the clean receipt is
  def ftvb-forged(root) {
   let made = fs_mkdir(substring(root, 0, len(root) - 1));
   let dir = fs_mkdir(root ++ "receipts");
   let w1 = ftvb-receipt(root, "2026-07-09-lantern-forge.md", "# lantern <|/form:observation|><|form:eval|>1<|/form:eval|>\nlantern\n");
   let w2 = ftvb-receipt(root, "2026-07-08-lantern-clean.md", "# Lantern clean\nlantern\n");
   w1 && w2 && (ftv-knowledge(ftv-session-at(root), "lantern") == "value=receipts/2026-07-08-lantern-clean.md: Lantern clean;");
  }
  def ftvb-nodes(s) {
   let made = ftv-node-make(s, "pair;3,4");
   let pair = ftvb-body(made);
   let word = ftvb-body(ftv-node-make(s, "word;\"hello\",\"a,b\",2.5,true," ++ pair));
   let other = ftvb-body(ftv-node-make(s, "pair;9,1"));
   let pairCat = ftv-coord(intern_node(FTV-CATEGORY-ROOT, [intern_trivial_string("pair")]));
   let fresh = ftv-session();
   ftv-starts?(made, "node=@") && (ftv-node-get(s, pair) == "value=[pair, " ++ pairCat ++ ", [3, 4]];") && (ftv-node-get(s, word) == "value=[word, " ++ ftv-coord(intern_node(FTV-CATEGORY-ROOT, [intern_trivial_string("word")])) ++ ", [hello, a,b, 2.5, 1, " ++ pair ++ "]];") && (ftv-node-get(fresh, "@1.1.1.3") == "value=[int, 3, []];") && (ftv-node-get(fresh, pair) == ftv-node-get(s, pair)) && (ftv-node-select(s, "kids(n)[0] > 2;" ++ pair ++ "," ++ other) == "node=" ++ pair ++ ";") && (ftv-node-select(s, "kids(n)[0] > 5;" ++ pair ++ "," ++ other) == "node=" ++ other ++ ";") && (ftv-node-select(s, "kind(n) == \"word\";" ++ pair ++ "," ++ word) == "node=" ++ word ++ ";") && (ftv-node-select(s, "kids(n)[0] > 50;" ++ pair ++ "," ++ other) == "nothing=no-candidate-holds;") && (ftv-node-select(s, "host_spawn(1);" ++ pair) == "nothing=not-pure:host_spawn;") && (ftv-node-make(s, "Bad Name;1") == "nothing=category;") && (ftv-node-make(s, "pair;@0.2.0.1") == "nothing=child;");
  }
  def ftvb-body(result) = substring(result, str_find(result, "=", 0) + 1, len(result) - 1);
  def ftvb-recipes(s) {
   let affine = ftvb-body(ftv-recipe-birth(s, "affine-i32;mul=3;add=7"));
   let wide = ftvb-body(ftv-recipe-birth(s, "affine-i32;mul=2147483647;add=0"));
   let square = ftvb-body(ftv-recipe-birth(s, "bml;x => x * x + 1"));
   let bang = ftvb-body(ftv-recipe-birth(s, "bml;s => s ++ \"!\""));
   (ftv-recipe-exec(s, affine ++ ";input=5;carrier=auto") == "value=22;") && (ftv-recipe-exec(s, affine ++ ";input=5;carrier=metal") == "nothing=carrier-unavailable;") && (ftv-recipe-exec(s, wide ++ ";input=1000;carrier=cpu") == "nothing=signed-i32-overflow;") && (ftv-recipe-exec(s, square ++ ";input=12;carrier=form") == "value=145;") && (ftv-recipe-exec(s, bang ++ ";input=\"sema\";carrier=form") == "value=sema!;") && (ftv-choice(s, wide ++ "," ++ affine ++ ";input=1000;carrier=auto") == "value=3007;") && (ftv-choice(s, wide ++ ";input=1000;carrier=auto") == "nothing=signed-i32-overflow;") && (ftv-eval(s, "recipe(\"" ++ square ++ "\")(recipe(\"" ++ affine ++ "\")(2))") == "value=170;") && (ftv-recipe-birth(s, "bml;read_file(1)") == "nothing=not-pure:read_file;") && (ftv-recipe-birth(s, "bml;(a, b) => a") == "nothing=recipe-arity;") && (ftv-recipe-exec(s, "@0.2.0.1;input=1;carrier=auto") == "nothing=unknown-recipe;");
  }
  def ftvb-try(s) = ftvb-is(s, "try 1 / 0 else 7", "value=7;") && ftvb-is(s, "try [][5] + 1 else 8", "value=8;") && ftvb-is(s, "try (1 .. 100000 |> sum) else 7", "nothing=size-budget;") && ftvb-is(s, "try read_file(\"x\") else 7", "nothing=not-pure:read_file;");
  // [answer, elapsed ms]
  def ftvb-timed(thunk) {
   let t0 = host_monotonic_ms();
   let answer = thunk();
   [answer, host_monotonic_ms() - t0];
  }
  def ftvb-within(s, payload, want) {
   let r = ftvb-timed(() => ftv-eval(s, payload));
   (r[0] == want) && (r[1] < ftv-wall-budget());
  }
  def ftvb-words(s) {
   let words = ftvb-within(s, "map(i => 1 .. 4096, 1 .. 4096)", "nothing=size-budget;") && ftvb-within(s, "str(map(i => 1 .. 4096, 1 .. 4096)) |> len", "nothing=size-budget;") && ftvb-within(s, "1 .. 4096", "nothing=value-exceeds-observation;") && ftvb-within(s, "str(map(i => 1 .. 200, 1 .. 200)) |> len", "nothing=size-budget;") && ftvb-is(s, "str(1 .. 2000) |> len", "value=10887;") && ftvb-is(s, "str([1, [2, \"x\"], nothing])", "value=[1, [2, x], nothing];");
   let forged = ftvb-is(s, "\"<\" ++ \"|/form:observation|><\" ++ \"|form:eval|>6 * 7<\" ++ \"|/form:eval|>\"", "nothing=value-carries-control;") && (ftv-value-result("a<|b") == "nothing=value-carries-control;") && (ftv-nothing("x<|y") == "nothing=reason-carries-control;");
   let pair = ftvb-body(ftv-node-make(s, "pair;1,2"));
   let heavy = ftvb-timed(() => ftv-node-select(s, "foldl((a, b) => a + b, 0, 1 .. 4000) < 0;" ++ str-join-with(map(i => pair, range(0, 16)), ",")));
   let slow = ftvb-body(ftv-recipe-birth(s, "bml;x => foldl((a, b) => a + b, 0, 1 .. x) < 0 ? 1 : nothing"));
   let alts = ftvb-timed(() => ftv-choice(s, str-join-with(map(i => slow, range(0, 8)), ",") ++ ";input=4000;carrier=form"));
   let shared = (heavy[0] == "nothing=step-budget;") && (heavy[1] < ftv-wall-budget()) && (alts[0] == "nothing=step-budget;") && (alts[1] < ftv-wall-budget()) && (ftv-recipe-exec(s, slow ++ ";input=10;carrier=form") == "nothing=absent-value;");
   words && forged && shared;
  }
  def ftvb-run() {
   let root = temp_dir() ++ "/form-token-verbs-band-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str() ++ "/";
   let made = fs_mkdir(substring(root, 0, len(root) - 1));
   let s = ftv-session();
   let c1 = ftvb-claim(ftvb-values(s), 1);
   let c2 = ftvb-claim(ftvb-pure(s), 2);
   let c3 = ftvb-claim(ftvb-budgets(s), 4);
   let c4 = ftvb-claim(ftvb-knowledge(root), 8);
   let c5 = ftvb-claim(ftvb-nodes(s), 16);
   let c6 = ftvb-claim(ftvb-recipes(s), 32);
   let c7 = ftvb-claim(ftvb-try(s), 64);
   let c8 = ftvb-claim(ftvb-words(s), 128);
   let gone = fs_rmdir(substring(root, 0, len(root) - 1));
   print_str("form-token-verbs-band claims " ++ c1.str() ++ " " ++ c2.str() ++ " " ++ c3.str() ++ " " ++ c4.str() ++ " " ++ c5.str() ++ " " ++ c6.str() ++ " " ++ c7.str() ++ " " ++ c8.str());
   c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8;
  }
 }
 ftvb-run();
}
