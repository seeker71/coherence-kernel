; form-token-verbs-band.bml — the verbs Form runs in stream, in the body's whole environment: eval over the body's
; own cursor, substrate lookup, node access, creation and selection, and recipes run in Form.
; preludes: form-stdlib/bml/form-token-verbs.bml
; Verdict 1023
; PROOF LEVEL: FOURTH-ARM ONLY — eval reaches every door the runtime carries, and a body function runs in a child fkwu
; born by host_spawn_at; the siblings carry neither
;
; Every fixture lives in a scratch directory under temp_dir, read back through the carrier and removed at the end. A
; body function runs in a child ./fkwu from the repository root; its door unit stays compiled under the checkout's
; .hearth/form-tokens/doors.
;     1  eval answers arithmetic, comparison, text, lists, local definitions, recursion and floats exactly, as
;        value=<value_str>;, and a name a control made is there for the next control (a let, a def)
;     2  access: a host read answers the file's bytes, a door answers with its own arity, a function the body defines
;        runs on the unit that defines it (str-join-with), a walker function crosses into one (filter-onto), and a node
;        built two controls earlier is read by its address in eval and by another reply's session
;     4  failures are observations, never stops: an unknown name, a door asked with the wrong arity, a door that stops,
;        division by zero, a kind that does not fit, a payload the cursor cannot read, a nested control, and a recursion
;        that never returns (the runtime's own depth guard) each answer nothing=<reason>, and the process goes on
;     8  knowledge-query reads the enrich resources and the receipts it is given: an authored sense first, then receipts
;        ranked by name, opening and date; no terms and no grounded row are distinct nothings; a receipt whose title
;        carries control bytes is not offered
;    16  node-make interns a category and children, named or not, and a child may be a name; node-get reads kind,
;        value and children back by address or name; an integer leaf needs no holding; node-select answers the first
;        candidate whose predicate holds through the choice lane, and a failing predicate is named
;    32  recipes: an affine birth runs in Form and Metal stays with the microthought owner; i32 overflow is nothing; a
;        BML recipe is born, named and run by name, in eval and through recipe-exec on an input that reads the
;        workspace; a def answers its recipe address and recipe-exec runs it; choice falls through an overflow to the
;        next recipe; recipe(@address) composes inside eval
;    64  try recovers every evaluation failure: a division, an index, an unknown name, a kind
;   128  one rendering rule: a value too large to speak answers node=@address and a summary that carries neither ; nor
;        <|; eval reaches the value at that address, node-get reads a window of it and names the next window; str()
;        speaks a large value whole; a long text answers its address and length; a value whose words carry control
;        bytes answers value-carries-control
;   256  time is a backtrack point: with a patience of 1.5 s, a recursion that branches instead of deepening, a fold
;        over a long list and a sleep past the deadline each answer eval-stopped:deadline within it (try does not
;        clear a deadline); a body function that loops answers body-call-timeout:<name> by its patience (after one
;        warm call that answers), its child is gone, and no ticket, answer or printed file of the call is left
;   512  what a control prints is its observation's first words, never the lane's stdout (a forged protocol line comes
;        back as a value); a name only a unit that runs on import defines answers runs-on-import at once; match,
;        a record's field, ?? over a failure and a record keyed by a number are walked
section [form.bml] {
 class FormTokenVerbsBand {
  def ftvb-claim(ok, bit) = ok ? bit : 0;
  def ftvb-is(s, payload, want) = ftv-eval(s, payload) == want;
  def ftvb-body(result) = substring(result, str_find(result, "=", 0) + 1, len(result) - 1);
  def ftvb-values(s) = ftvb-is(s, "17 * 23 + 4", "value=395;") && ftvb-is(s, "(1 + 2) * 3", "value=9;") && ftvb-is(s, "7 / 2", "value=3;") && ftvb-is(s, "-7 % 3", "value=-1;") && ftvb-is(s, "3 > 2 && 2 != 3", "value=1;") && ftvb-is(s, "2 == 2.0", "value=1;") && ftvb-is(s, "\"form\" ++ \"-\" ++ \"token\"", "value=form-token;") && ftvb-is(s, "substring(\"coherence\", 2, 5)", "value=her;") && ftvb-is(s, "[1,2,3] |> map(x => x * x) |> sum", "value=14;") && ftvb-is(s, "1 .. 11 |> filter(x => x % 2 == 0) |> len", "value=5;") && ftvb-is(s, "let a = 4; a * a + len(\"abc\")", "value=19;") && ftvb-is(s, "a + 1", "value=5;") && ftvb-is(s, "def fact(n) = n <= 1 ? 1 : n * fact(n - 1); fact(10)", "value=3628800;") && ftvb-is(s, "fact(5)", "value=120;") && ftvb-is(s, "foldl((a, b) => a + b, 0, 1 .. 101)", "value=5050;") && ftvb-is(s, "35.0 * 8.25", "value=288.75;") && ftvb-is(s, "[3, \"two\", [4]]", "value=[3, two, [4]];") && ftvb-is(s, "if 3 > 2 then \"yes\" else \"no\"", "value=yes;") && ftvb-is(s, "max([4, 9, 2])", "value=9;") && ftvb-is(s, "range(1, 1000001) |> sum", "value=500000500000;");
  def ftvb-access(s, root) {
   let note = root ++ "note.txt";
   let wrote = write_file(note, "lantern") == 7;
   let pair = ftvb-body(ftv-node-make(s, "pair;3,4"));
   let between = ftv-eval(s, "6 * 7");
   let host = ftvb-is(s, "read_file(\"" ++ note ++ "\")", "value=lantern;") && ftvb-is(s, "file_size(\"" ++ note ++ "\") == len(\"lantern\")", "value=1;") && ftvb-is(s, "len(fs_list(\"" ++ substring(root, 0, len(root) - 1) ++ "\")) >= 1", "value=1;");
   let body = ftvb-is(s, "str-join-with([\"a\", \"b\"], \"-\")", "value=a-b;") && ftvb-is(s, "filter-onto(x => x > 2, [1, 2, 3, 4], [])", "value=[4, 3];");
   let earlier = ftvb-is(s, "kids(" ++ pair ++ ")", "value=[3, 4];") && (ftv-node-get(ftv-session(), pair) == "value=[pair, " ++ ftv-coord(intern_node(FTV-CATEGORY-ROOT, [intern_trivial_string("pair")])) ++ ", [3, 4]];");
   wrote && host && body && earlier && (between == "value=42;");
  }
  def ftvb-failures(s) = ftvb-is(s, "y + 1", "nothing=unknown-name:y;") && ftvb-is(s, "frobnicate(3)", "nothing=unknown-name:frobnicate;") && ftvb-is(s, "file_size()", "nothing=arity:file_size;") && ftvb-is(s, "form_error(\"stop\")", "nothing=door-stopped:form_error;") && ftvb-is(s, "10 / 0", "nothing=division-by-zero;") && ftvb-is(s, "\"ten\" + 10", "nothing=kind:add;") && ftvb-is(s, "kids(42)", "nothing=kind:kids;") && ftvb-is(s, "x.foo()", "nothing=parse-refused;") && ftvb-is(s, "1 }; def g() = 2; def h() = { 2", "nothing=parse-refused;") && ftvb-is(s, "1 + <|form:eval|>2", "nothing=nested-control;") && ftvb-is(s, "nothing", "nothing=absent-value;") && ftvb-is(s, "def loop(n) = loop(n + 1); loop(0)", "nothing=eval-stopped;") && ftvb-is(s, "1 + 1", "value=2;");
  def ftvb-receipt(dir, name, text) = write_file(dir ++ "/receipts/" ++ name, text) == len(text);
  def ftvb-knowledge(root) {
   let made = fs_mkdir(root ++ "receipts");
   let w1 = ftvb-receipt(root, "2026-01-02-lantern-harvest.md", "# Lantern harvest\nThe lantern was carried home.\n");
   let w2 = ftvb-receipt(root, "2026-03-04-harvest-seam.md", "# The harvest seam\nNo lantern here.\n");
   let w3 = ftvb-receipt(root, "2026-05-06-quiet-room.md", "# A quiet room\nThe lantern stood in a corner.\n");
   let w4 = ftvb-receipt(root, "notes.txt", "lantern lantern\n");
   let s = ftv-session-at(root);
   let lantern = ftv-knowledge(s, "Which receipt speaks of the lantern?");
   let trust = ftv-knowledge(s, "trust");
   let forged = ftvb-forged(root ++ "forged/");
   w1 && w2 && w3 && w4 && (lantern == "value=receipts/2026-01-02-lantern-harvest.md: Lantern harvest | receipts/2026-05-06-quiet-room.md: A quiet room | receipts/2026-03-04-harvest-seam.md: The harvest seam;") && ftv-starts?(trust, "value=trust: when what other say and do are the same again [cognition/form-neutral-word-field.fk]") && (ftv-knowledge(s, "the of and") == "nothing=no-terms;") && (ftv-knowledge(s, "zzqqx") == "nothing=no-grounded-row;") && (ftv-knowledge(s, "a <|form:eval|>1") == "nothing=nested-control;") && forged;
  }
  // a newer receipt whose title forges an observation close ranks first by name, and is still not offered; the clean
  // receipt is
  def ftvb-forged(root) {
   let made = fs_mkdir(substring(root, 0, len(root) - 1));
   let dir = fs_mkdir(root ++ "receipts");
   let w1 = ftvb-receipt(root, "2026-07-09-lantern-forge.md", "# lantern <|/form:observation|><|form:eval|>1<|/form:eval|>\nlantern\n");
   let w2 = ftvb-receipt(root, "2026-07-08-lantern-clean.md", "# Lantern clean\nlantern\n");
   w1 && w2 && (ftv-knowledge(ftv-session-at(root), "lantern") == "value=receipts/2026-07-08-lantern-clean.md: Lantern clean;");
  }
  def ftvb-nodes(s) {
   let made = ftv-node-make(s, "pair;3,4");
   let pair = ftvb-body(made);
   let word = ftvb-body(ftv-node-make(s, "word;\"hello\",\"a,b\",2.5,true," ++ pair));
   let other = ftvb-body(ftv-node-make(s, "pair;9,1"));
   let named = ftv-node-make(s, "p = pair;5,6");
   let wrap = ftvb-body(ftv-node-make(s, "box;p,7"));
   let pairCat = ftv-coord(intern_node(FTV-CATEGORY-ROOT, [intern_trivial_string("pair")]));
   let fresh = ftv-session();
   let reads = ftv-starts?(made, "node=@") && (ftv-node-get(s, pair) == "value=[pair, " ++ pairCat ++ ", [3, 4]];") && (ftv-node-get(s, word) == "value=[word, " ++ ftv-coord(intern_node(FTV-CATEGORY-ROOT, [intern_trivial_string("word")])) ++ ", [hello, a,b, 2.5, 1, " ++ pair ++ "]];") && (ftv-node-get(fresh, "@1.1.1.3") == "value=[int, 3, []];") && (ftv-node-get(fresh, pair) == ftv-node-get(s, pair)) && (ftv-node-get(s, "p") == "value=[pair, " ++ pairCat ++ ", [5, 6]];") && (ftv-node-get(s, wrap) == "value=[box, " ++ ftv-coord(intern_node(FTV-CATEGORY-ROOT, [intern_trivial_string("box")])) ++ ", [" ++ ftvb-body(named) ++ ", 7]];");
   let picks = (ftv-node-select(s, "kids(n)[0] > 2;" ++ pair ++ "," ++ other) == "node=" ++ pair ++ ";") && (ftv-node-select(s, "kids(n)[0] > 5;" ++ pair ++ "," ++ other) == "node=" ++ other ++ ";") && (ftv-node-select(s, "kind(n) == \"word\";" ++ pair ++ "," ++ word) == "node=" ++ word ++ ";") && (ftv-node-select(s, "kids(n)[1] == 6;" ++ pair ++ ",p") == named) && (ftv-node-select(s, "kids(n)[0] > 50;" ++ pair ++ "," ++ other) == "nothing=no-candidate-holds;") && (ftv-node-select(s, "frobnicate(n);" ++ pair) == "nothing=unknown-name:frobnicate;");
   reads && picks && (ftv-node-make(s, "Bad Name;1") == "nothing=category;") && (ftv-node-make(s, "pair;@0.2.0.0") == "nothing=child;") && (ftv-node-get(s, "@0.2.0.0") == "nothing=unknown-node;");
  }
  def ftvb-recipes(s) {
   let affine = ftvb-body(ftv-recipe-birth(s, "affine-i32;mul=3;add=7"));
   let wide = ftvb-body(ftv-recipe-birth(s, "affine-i32;mul=2147483647;add=0"));
   let square = ftvb-body(ftv-recipe-birth(s, "bml;x => x * x + 1"));
   let bang = ftvb-body(ftv-recipe-birth(s, "bml;s => s ++ \"!\""));
   let named = ftv-recipe-birth(s, "sq = bml;x => x * x");
   let born = (ftv-recipe-exec(s, affine ++ ";input=5;carrier=auto") == "value=22;") && (ftv-recipe-exec(s, affine ++ ";input=5;carrier=metal") == "nothing=carrier-unavailable;") && (ftv-recipe-exec(s, wide ++ ";input=1000;carrier=cpu") == "nothing=signed-i32-overflow;") && (ftv-recipe-exec(s, square ++ ";input=12;carrier=form") == "value=145;") && (ftv-recipe-exec(s, bang ++ ";input=\"sema\";carrier=form") == "value=sema!;");
   let byName = ftv-starts?(named, "recipe=@") && ftvb-is(s, "let side = 12; sq(side)", "value=144;") && (ftv-recipe-exec(s, "sq;input=side + 1;carrier=auto") == "value=169;") && (ftv-recipe-exec(s, ftvb-body(named) ++ ";input=3") == "value=9;");
   let def = ftv-eval(s, "def cube(x) = x * x * x");
   let defs = ftv-starts?(def, "recipe=@") && (ftv-recipe-exec(s, ftvb-body(def) ++ ";input=4;carrier=form") == "value=64;") && ftvb-is(s, "cube(2) + sq(2)", "value=12;");
   let chosen = (ftv-choice(s, wide ++ "," ++ affine ++ ";input=1000;carrier=auto") == "value=3007;") && (ftv-choice(s, wide ++ ";input=1000;carrier=auto") == "nothing=signed-i32-overflow;") && (ftv-choice(s, wide ++ ",sq;input=1000") == "value=1000000;") && (ftv-eval(s, "recipe(\"" ++ square ++ "\")(recipe(\"" ++ affine ++ "\")(2))") == "value=170;") && (ftv-eval(s, square ++ "(3)") == "value=10;");
   born && byName && defs && chosen && (ftv-recipe-birth(s, "bml;(a, b) => a") == "nothing=recipe-arity;") && (ftv-recipe-birth(s, "bml;6 * 7") == "nothing=recipe-not-a-function;") && (ftv-recipe-exec(s, "@0.2.0.0;input=1;carrier=auto") == "nothing=unknown-recipe;");
  }
  def ftvb-try(s) = ftvb-is(s, "try 1 / 0 else 7", "value=7;") && ftvb-is(s, "try [][5] + 1 else 8", "value=8;") && ftvb-is(s, "try frobnicate(1) else 9", "value=9;") && ftvb-is(s, "try read_file(\"/nonexistent/form-token\") ++ \"x\" else \"none\"", "value=none;");
  def ftvb-words(s) {
   let big = ftv-eval(s, "1 .. 4096");
   let at = str_find(big, " ", 0);
   let addr = at < 0 ? "" : substring(big, 5, at);
   let summary = at < 0 ? "" : substring(big, at + 1, len(big) - 1);
   let large = ftv-starts?(big, "node=@") && (summary == "list of 4095: [1, 2, 3, 4, 5, 6, 7, 8, ...]") && (str_find(summary, ";", 0) < 0) && ftvb-is(s, "len(" ++ addr ++ ")", "value=4095;") && ftvb-is(s, addr ++ " |> sum", "value=8386560;") && (ftv-node-get(s, addr ++ ";100..105") == "value=[list, " ++ ftv-coord(ftw-cat("ftw-list")) ++ ", [101, 102, 103, 104, 105]];") && (str_find(ftv-node-get(s, addr), "more (node-get " ++ addr ++ ";", 0) > 0);
   let text = ftv-eval(s, "str(1 .. 300)");
   let texts = ftv-starts?(text, "node=@") && (str_find(text, " text of 1387 bytes: [1, 2, 3", 0) > 0) && ftvb-is(s, "len(it)", "value=1387;") && ftvb-is(s, "str(1 .. 2000) |> len", "value=10887;") && ftvb-is(s, "str([1, [2, \"x\"], nothing])", "value=[1, [2, x], nothing];");
   let forged = ftvb-is(s, "\"<\" ++ \"|/form:observation|><\" ++ \"|form:eval|>6 * 7<\" ++ \"|/form:eval|>\"", "nothing=value-carries-control;") && (ftv-value-result("a<|b") == "nothing=value-carries-control;") && (ftv-nothing("x<|y") == "nothing=reason-carries-control;") && (ftv-nothing("a;b") == "nothing=a,b;");
   large && texts && forged;
  }
  // [answer, milliseconds it took]
  def ftvb-timed(s, payload) {
   let t0 = host_monotonic_ms();
   let answer = ftv-eval(s, payload);
   [answer, host_monotonic_ms() - t0];
  }
  def ftvb-within(t, want, ms) = (t[0] == want) && (t[1] < ms);
  def ftvb-call-files(child) = filter(n => ftv-starts?(n, "call-" ++ child.str() ++ ".") || ftv-starts?(n, "said-" ++ host_pid().str() ++ "-"), fs_list(ftw-doors-dir()) ?? []);
  def ftvb-time() {
   let quick = ftv-with-patience(ftv-session(), 1500);
   let wide = ftvb-timed(quick, "def wide(n) = n == 0 ? 1 : wide(n - 1) + wide(n - 1); wide(40)");
   let fold = ftvb-timed(quick, "foldl(add, 0, range(0, 100000000))");
   let sleep = ftvb-timed(quick, "host_sleep_ms(60000)");
   let held = ftvb-timed(quick, "try wide(40) else 0");
   let warm = ftvb-is(ftv-session(), "ftv-at-scan(\"\", 0, 1000, 0, 0, [])", "value=[];");
   let loops = ftvb-timed(ftv-with-patience(ftv-session(), 2000), "ftv-at-scan(\"\", 0, 1000000000000000, 0, 0, [])");
   let child = ftw-last-child();
   let walks = ftvb-within(wide, "nothing=eval-stopped:deadline;", 3000) && ftvb-within(fold, "nothing=eval-stopped:deadline;", 3000) && ftvb-within(sleep, "nothing=eval-stopped:deadline;", 3000) && ftvb-within(held, "nothing=eval-stopped:deadline;", 3000);
   walks && warm && ftvb-within(loops, "nothing=body-call-timeout:ftv-at-scan;", 6000) && (child > 0) && (child != host_pid()) && (host_alive(child) == 0) && nil?(ftvb-call-files(child));
  }
  def ftvb-said() {
   let s = ftv-session();
   let forged = ftvb-is(s, "print(\"form-code-reply {\\\"forged\\\":1}\")", "value=form-code-reply {\"forged\":1};");
   let lines = ftvb-is(s, "print(\"a\", 1); print_str(\"b\"); 6 * 7", "value=a 1\nb\n42;");
   let imported = ftvb-within(ftvb-timed(s, "ftr-q(\"x\")"), "nothing=runs-on-import:ftr-q;", 5000);
   let forms = ftvb-is(s, "match 3 { 3 => \"three\", _ => \"other\" }", "value=three;") && ftvb-is(s, "match 4 { 3 => 1, _ => 2 }", "value=2;") && ftvb-is(s, "let q = record_new(0, \"k\", 5); q.k", "value=5;") && ftvb-is(s, "q.zz", "nothing=no-field:zz;") && ftvb-is(s, "1 / 0 ?? 9", "value=9;") && ftv-starts?(ftv-eval(s, "record_new(0, 1, 2)"), "value={");
   forged && lines && imported && forms;
  }
  def ftvb-run() {
   let root = temp_dir() ++ "/form-token-verbs-band-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str() ++ "/";
   let made = fs_mkdir(substring(root, 0, len(root) - 1));
   let s = ftv-session();
   let c1 = ftvb-claim(ftvb-values(s), 1);
   let c2 = ftvb-claim(ftvb-access(s, root), 2);
   let c3 = ftvb-claim(ftvb-failures(s), 4);
   let c4 = ftvb-claim(ftvb-knowledge(root), 8);
   let c5 = ftvb-claim(ftvb-nodes(s), 16);
   let c6 = ftvb-claim(ftvb-recipes(s), 32);
   let c7 = ftvb-claim(ftvb-try(s), 64);
   let c8 = ftvb-claim(ftvb-words(s), 128);
   let c9 = ftvb-claim(ftvb-time(), 256);
   let c10 = ftvb-claim(ftvb-said(), 512);
   let gone = fs_rmdir(substring(root, 0, len(root) - 1));
   print_str("form-token-verbs-band claims " ++ c1.str() ++ " " ++ c2.str() ++ " " ++ c3.str() ++ " " ++ c4.str() ++ " " ++ c5.str() ++ " " ++ c6.str() ++ " " ++ c7.str() ++ " " ++ c8.str() ++ " " ++ c9.str() ++ " " ++ c10.str());
   c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10;
  }
 }
 ftvb-run();
}
