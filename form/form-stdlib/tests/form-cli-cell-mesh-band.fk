; form-cli-cell-mesh-band.fk — two cells, a shared observer field, Glass.
;
; preludes: form-stdlib/form-cli-cell-mesh.fk
; Verdict 4095:
;   1    open writes peer and observer mesh logs
;   2    A streams an interned int; B receives the same NodeID
;   4    the observer inbound log holds the same witness
;   8    a protocol node not on the observer field is not adopted
;   16   observer-published protocol is adopted and the version moves
;   32   join adds a third cell
;   64   Glass snapshot is published with live cell and channel rows
;   128  a mode outside the offered interface is invasion, not a send
;   256  the same payload interned twice is one NodeID
;   512  adopted protocol node is on the observer field
;   1024 eval door intern-node is the v0 protocol symbol
;   2048 observer is the shared field, not a peer cell in the mesh list
;
; witnessed: 2026-09-04 -> 4095

(do
    (defn fccmb-bit (held weight) (if (eq held 1) weight 0))
    (defn fccmb-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))
    (let root (fs-path-join (fs-temp-dir) "form-cli-cell-mesh-band"))
    (let glassRoot (fs-path-join root "glass"))
    (let _mk (fs-mkdir root))
    (let _mkg (fs-mkdir glassRoot))
    (let opened (fccm-open root "cell-a" "cell-b" "observer"))
    (let symbol (fccm-int-symbol 71))
    (let sent (fccm-send-int opened "cell-a" "cell-b" 71 (m-offer)))
    (let received (fccm-recv sent "cell-a" "cell-b" 0))
    (let witness (fccm-recv sent "cell-a" "observer" 0))
    (let rogue (fccm-adopt-protocol sent "cell-a" 9 "rogue-grammar" "eval"))
    (let published (fccm-publish-protocol sent "observer" 2 "form-symbols-v2" "intern-node"))
    (let adopted (fccm-adopt-protocol published "cell-a" 2 "form-symbols-v2" "intern-node"))
    (let adoptedB (fccm-adopt-protocol adopted "cell-b" 2 "form-symbols-v2" "intern-node"))
    (let forged (fccm-adopt-protocol adoptedB "cell-a" 3 "peer-minted" "eval"))
    (let joined (fccm-join forged "cell-c"))
    (let invaded (fccm-send-int joined "cell-a" "cell-b" 71 (m-reflect)))
    (let epoch (now_unix_ms))
    (let glass (fccm-publish-glass invaded glassRoot epoch))
    (let snapPath (fs-path-join glassRoot "form-cli.cell-mesh.glass-snapshot"))
    (let snapText (if (eq (fs-exists? snapPath) 1) (fs-read-text snapPath) ""))
    (let authority (read_file "form/form-stdlib/bml/form-cli-cell-mesh.bml"))
    (let executable (read_file "form/form-stdlib/form-cli-cell-mesh.fk"))
    (sum (list
        (fccmb-bit (and (eq (fccm-mesh? opened) 1)
                        (and (eq (fs-exists? (fccm-edge-path root "cell-a" "cell-b")) 1)
                             (eq (fs-exists? (fccm-field-path root)) 1))) 1)
        (fccmb-bit (and (eq (len received) 1)
                        (node_eq (fccm-msg-payload (head received)) symbol)) 2)
        (fccmb-bit (and (eq (len witness) 1)
                        (node_eq (fccm-msg-payload (head witness)) symbol)) 4)
        (fccmb-bit (eq (fccm-protocol-version rogue) 1) 8)
        (fccmb-bit (and (eq (fccm-protocol-version published) 2)
                        (eq (fccm-protocol-version adoptedB) 2)) 16)
        (fccmb-bit (and (eq (len (fccm-cells joined)) 3)
                        (eq (fccm-member? "cell-c" (fccm-cells joined)) 1)) 32)
        (fccmb-bit (and (str_eq (nth glass 1) "published")
                        (and (eq (fccmb-has snapText "sample|cell-a") 1)
                             (eq (fccmb-has snapText "|channel|") 1))) 64)
        (fccmb-bit (and (eq (fccm-invasions invaded) 1)
                        (eq (fccm-honors invaded) (fccm-honors joined))) 128)
        (fccmb-bit (node_eq (intern_trivial_int 71) symbol) 256)
        (fccmb-bit (eq (fccm-payload-held? (fccm-field-messages adoptedB)
                                          (fccm-protocol-node 2 "form-symbols-v2" "intern-node")) 1) 512)
        (fccmb-bit (and (eq (fccmb-has authority "intern-node") 1)
                        (eq (fccmb-has executable "FCCMEvalDoorV1") 1)) 1024)
        (fccmb-bit (and (eq (fccm-member? "observer" (fccm-cells joined)) 0)
                        (str_eq (fccm-observer joined) "observer")) 2048))))
