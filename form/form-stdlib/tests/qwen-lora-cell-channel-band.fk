; qwen-lora-cell-channel-band.fk — frames and Glass state stay in Form.
;
; Verdict 63: decode, preserve body, fallback, reply, one-line, Glass state.
; preludes: form-stdlib/qwen-lora-cell-channel.fk

(do
    (let f (qch-decode "we|7|symbols|stay|inside"))
    (sum (list
        (if (eq (nth f 0) 1) 1 0)
        (if (str_eq (nth f 1) "we") 2 0)
        (if (eq (nth f 2) 7) 4 0)
        (if (str_eq (nth f 3) "symbols|stay|inside") 8 0)
        (if (str_eq (nth (qch-inbound "plain" 9) 1) "stdin") 16 0)
        (if (str_eq (qch-reply "we" 7 "a|b\nc") "reply|we|7|a b c") 32 0))))
