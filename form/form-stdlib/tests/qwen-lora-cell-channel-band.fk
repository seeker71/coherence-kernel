; qwen-lora-cell-channel-band.fk — frames and Glass state stay in Form.
;
; Verdict 2047: decode, preserve body, fallback, reply, one-line, tokens,
; node, and dynamic Form event lookup by symbol.
; preludes: form-stdlib/qwen-lora-cell-channel.fk

(do
    (let f (qch-decode "we|7|symbols|stay|inside"))
    (let event (qch-event "speaking" "we" 7 9 (list 2 3) (list 5) 1 "hello"))
    (sum (list
        (if (eq (nth f 0) 1) 1 0)
        (if (str_eq (nth f 1) "we") 2 0)
        (if (eq (nth f 2) 7) 4 0)
        (if (str_eq (nth f 3) "symbols|stay|inside") 8 0)
        (if (str_eq (nth (qch-inbound "plain" 9) 1) "stdin") 16 0)
        (if (str_eq (qch-reply "we" 7 "a|b\nc") "reply|we|7|a b c") 32 0)
        (if (str_eq (qch-token-text (list 2 3 5)) "2,3,5") 64 0)
        (if (gt (str_len (qch-node-text "we" 7 "in:2;out:3")) 0) 128 0)
        (if (str_eq (qch-field-value (qch-event-get event "phase")) "speaking") 256 0)
        (if (eq (len (qch-field-value (qch-event-get event "tokens.in"))) 2) 512 0)
        (if (eq (node_eq (qch-field-value (qch-event-get event "node-id"))
                         (qch-node "we" 7 "in:2,3;out:5")) 1) 1024 0))))
