; remote-lane-learn-band.fk — remote lane is interned status, not a transcript.
; Verdict 15:
;   1   32 turns fold to 5
;   2   offer identity is remote-share-lane
;   4   offer has no how field (len 3)
;   8   living triple 240 397 32 folds with remote 5
; preludes: form-stdlib/core.fk form-stdlib/nine-fold.fk
; preludes: form-stdlib/walk-home.fk form-stdlib/remote-lane-learn.fk
; witnessed: 2026-09-10 -> 15

(do
    (defn rllb-bit (ok bit) (if ok bit 0))
    (let offer (rll-offer 32))
    (add (rllb-bit (eq (rll-fold 32) 5) 1)
    (add (rllb-bit (str_eq (wh-contrib-identity offer) "remote-share-lane") 2)
    (add (rllb-bit (eq (rll-transcript? offer) 0) 4)
         (rllb-bit (value_eq (nf-read 240 397 32) (list 6 1 5 3)) 8)))))
