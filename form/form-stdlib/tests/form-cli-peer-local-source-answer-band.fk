; form-cli-peer-local-source-answer-band.fk -- source grammar chooses the
; fixed native action; malformed or context-absent work remains local refusal.
;
; preludes: form-stdlib/form-cli-peer-local-source-answer.fk

(do
    (defn fcplsab-bit (held weight) (if held weight 0))
    (defn fcplsab-session () (list "held-local-session" 7))
    (defn form-cli-peer-local-source-answer-band ()
        (do
            (let session (fcplsab-session))
            (let snapshot (sof-snapshot 17 (list "form")
                (list (list "unique-defn" "form/unique.fk"))))
            (let absent (fcpalsa-source-context "" "artifact" snapshot 17))
            (let held (fcpalsa-source-context "/caller-root" "artifact" snapshot 17))
            (let wrong-kind (fcpalsa-run session "direct-answer" "question"
                held 3))
            (let malformed (fcpalsa-run session "source-concept" ""
                held 4))
            (let missing-context (fcpalsa-run session "source-concept"
                "defn-psci-schema" absent 5))
            (let symbol (fcpalsa-run session "source-symbol" "unique-defn"
                held 6))
            (let peer (fcpalsa-peer wrong-kind))
            (let symbol-peer (fcpalsa-peer symbol))
            (sum (list
                (fcplsab-bit (and (str_eq (fcpalsa-version)
                                         "form-cli-peer-local-source-answer-v1")
                                  (and (str_eq (fcpalsa-provenance)
                                               "form-cli-peer-live-source-prefix")
                                       (str_eq (fcpalsa-call-id 7)
                                               "peer-local-source-7"))) 1)
                (fcplsab-bit (and (nothing? absent)
                                  (and (not (nothing? held))
                                       (and (eq (len held) 6)
                                            (and (eq (fcpalsa-source-epoch held) 17)
                                                 (value_eq (fcpalsa-source-index held)
                                                     snapshot))))) 2)
                (fcplsab-bit (and (eq (fcpalsa-source-task? "source-concept") 1)
                                  (and (eq (fcpalsa-source-task? "source-nodeid") 1)
                                       (eq (fcpalsa-source-task? "direct-answer") 0))) 4)
                (fcplsab-bit (and (str_eq (fcpdsa-signal wrong-kind) "choice")
                                  (and (str_eq (fcpdsa-reason wrong-kind)
                                               "source-direct-requires-source-task")
                                       (value_eq (fcpdsa-session wrong-kind) session))) 8)
                (fcplsab-bit (and (str_eq (fcpdsa-signal malformed) "choice")
                                  (and (str_eq (fcpdsa-reason malformed)
                                               "source-task-shape-refused")
                                       (value_eq (fcpdsa-session malformed) session))) 16)
                (fcplsab-bit (and (str_eq (fcpdsa-signal missing-context) "choice")
                                  (and (str_eq (fcpdsa-reason missing-context)
                                               "source-context-absent")
                                       (value_eq (fcpdsa-session missing-context) session))) 32)
                (fcplsab-bit (and (str_eq (fcpa-route peer) "source-knowledge")
                                  (and (eq (fcpa-callback-calls peer) 0)
                                  (and (eq (fcpa-contribution peer) 0)
                                  (and (eq (fcpa-lookup-count peer) 0)
                                       (value_eq (fcpa-session peer) session))))) 64)
                (fcplsab-bit (and (str_eq (fcpalsa-signal symbol) "value")
                                  (and (str_eq (fcpalsa-reason symbol) "symbol-one")
                                  (and (eq (fcpalsa-knowledge-contribution symbol) 1)
                                  (and (eq (fcpalsa-mutation-contribution symbol) 0)
                                  (and (str_eq (fcpa-route symbol-peer) "source-symbol")
                                  (and (eq (fcpa-callback-calls symbol-peer) 0)
                                       (value_eq (fcpa-session symbol-peer) session))))))) 128)))))
    (form-cli-peer-local-source-answer-band))
