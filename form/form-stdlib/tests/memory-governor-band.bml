// Actual capacity and explicit allocation ownership. No age acknowledges memory.
// Existing governor witness: 29 claims, 536870911 when all hold.
// preludes: form-stdlib/bml/memory-governor.bml
section [form.bml] {
 class MemoryGovernorBand {
  def mgb-vm(available,wired,compressed) = [1,1000,available,0,0,wired,0,0,compressed,0,0,0,0,0,0,0,0];
  def mgb-claim(log,name,ok) {
   record_set(log,"claims",append(record_get(log,"claims"),[[name,ok]]));
   if !ok then print(["memory-governor-failed",name]) else 0;ok;
  }
  def mgb-ask(dir,key,shared,own) = mg-lease-at(dir,host_pid(),"allocation-owner-band",key,shared,own,()=>mgb-vm(1000,0,0),()=>now_unix_ms());
  def mgb-pending(dir) = mg-reservation-pending(record_get(mg-reservation-snapshot(dir),"rows"));
   def mgb-retained-grant(root) {
    let seen=record_new(0,"tokens",[],"before",1);
    let retain=token=>{record_set(seen,"tokens",append(record_get(seen,"tokens"),[token]));record_set(seen,"before",record_get(seen,"before") && record_get(token,"owns")==0 && host_path_exists(record_get(token,"path"))==0);};
    let grant=mg-lease-locked-retaining(1000,root,host_pid(),"retained-grant","",0,1,()=>mgb-vm(1000,0,0),()=>now_unix_ms(),nothing(),retain);
    let tokens=record_get(seen,"tokens");
    let good=mg-granted?(grant) && len(tokens)==2 && tokens[1]==mg-reservation-of(grant) && record_get(seen,"before");
    let released=all?(ok=>ok,map(mg-reservation-release,tokens));
    let stopped=record_new(0,"token",nothing(),"seen",0);
    let refused=mg-lease-locked-retaining(1000,root,host_pid(),"retained-interruption","",0,1,()=>mgb-vm(1000,0,0),()=>now_unix_ms(),nothing(),token=>{record_set(stopped,"token",token);record_set(stopped,"seen",record_get(stopped,"seen")+1);if record_get(stopped,"seen")==2 then form_error("planted grant publication interruption") else 0;});
    good && released && !mg-granted?(refused) && mg-reservation-of(refused)==record_get(stopped,"token") && mg-reservation-release(record_get(stopped,"token"));
   }
  def mgb-wait(until,ready) {
   let state=record_new(0,"reads",0,"clock",0,"naps",[]);
   let sense=()=>{let n=record_get(state,"reads")+1;record_set(state,"reads",n);mgb-vm(n>=ready ? 100 : 0,0,0);};
   let sleep=ms=>{record_set(state,"clock",record_get(state,"clock")+ms);record_set(state,"naps",append(record_get(state,"naps"),[ms]));};
   let result=mg-wait-with("capacity-band",10,until,sense,sleep,()=>record_get(state,"clock"),mg-nap-first());
   [result,state];
  }
  def mgb-run() {
   let log=record_new(0,"claims",[]);
   let root=temp_dir()+"/memory-reservations-"+host_pid().str()+"-"+now_unix_ms().str();host_dir_mkdir(root);
   mgb-claim(log,"available capacity includes the exact boundary",mg-granted?(mg-verdict(mgb-vm(100,0,0),100)));
   mgb-claim(log,"wired occupancy is not a percentage veto",mg-granted?(mg-verdict(mgb-vm(100,990,0),100)));
   mgb-claim(log,"compression alone is not a veto",mg-granted?(mg-verdict(mgb-vm(100,0,900),100)));
   mgb-claim(log,"missing memory stays unavailable",mg-verdict(nothing(),1)[1]=="memory-unreadable");
   mgb-claim(log,"capacity refuses one byte beyond observation",mg-verdict(mgb-vm(100,0,0),101)[1]=="capacity");
    mgb-claim(log,"typed bytes have no guessed ceiling",!mg-lease-bytes?(-1) && !mg-lease-bytes?(1.0) && mg-lease-bytes?(1125899906842625) && all?(value=>mg-verdict(mgb-vm(100,0,0),value)[1]=="invalid-request",[nothing(),-1,1.0,"1"]));
   mgb-claim(log,"low means no available memory",mg-low?(mgb-vm(0,0,0)) && !mg-low?(mgb-vm(1,999,999)));
   let wait=mgb-wait(100000,3);
   mgb-claim(log,"changed capacity resumes",mg-granted?(wait[0]) && record_get(wait[1],"naps")==[10000,20000]);
    let bounded=mgb-wait(1,2);let expired=mgb-wait(0,1);
    let admission=record_new(0,"scope",record_new(0));
    let late=dl-with-lock(mg-lease-lock(root),1000,lock=>mg-reservation-judge(root,lock,host_pid(),"expired-admission","",0,1,()=>{record_set(admission,"until",0);mgb-vm(1000,0,0);},()=>now_unix_ms(),admission));
    let noLatePublication=late[1]=="caller-deadline" && record_get(late[7],"owns")==0 && host_path_exists(record_get(late[7],"path"))==0 && mg-reservation-release(late[7]);
    mgb-claim(log,"caller deadline prevents late admission",!mg-granted?(bounded[0]) && record_get(bounded[1],"reads")==1 && record_get(bounded[1],"naps")==[1] && record_get(bounded[1],"clock")==1 && !mg-granted?(expired[0]) && record_get(expired[1],"reads")==0 && noLatePublication);
   let unbounded=mgb-wait(nothing(),4);
   mgb-claim(log,"omitted deadline admits observed progress",mg-granted?(unbounded[0]) && record_get(unbounded[1],"reads")==4);
   let a=mgb-ask(root,"weights",20,8);let ta=mg-reservation-of(a);
   let raw=record?(ta) ? read_file(record_get(ta,"path")) : nothing();
   let row=mg-reservation-read-text(raw);
     mgb-claim(log,"grant publication is readable and owned",mg-granted?(a) && record?(ta) && record_get(ta,"owns")==1 && !nothing?(row) && row[8]==record_get(ta,"id") && a[5]==28 && record_get(record_get(ta,"lock-operation"),"released")==1 && mgb-retained-grant(root));
   let b=mgb-ask(root,"weights",20,8);let tb=mg-reservation-of(b);
   mgb-claim(log,"same-process siblings share weights once",mg-granted?(b) && b[5]==36 && record_get(ta,"id")!=record_get(tb,"id") && mgb-pending(root)==36);
   let aged=append(take(5,row),cons(0,drop(6,row)));
   mgb-claim(log,"time does not settle an allocation",mg-reservation-pending([aged])==28 && mg-lease-state(aged,999999999)=="pending");
   let unknown=root+"/unknown.lease";write_file(unknown,"not a lease\n");
   let denied=mgb-ask(root,"",0,1);
   mgb-claim(log,"unreadable claims are retained and hold admission",!mg-granted?(denied) && denied[1]=="lease-observation-unavailable" && read_file(unknown)=="not a lease\n");host_path_remove(unknown);
   write_file(unknown,"{\"schema\":\"unknown-owner\",\"pid\":1}\n");
   let alien=mgb-ask(root,"",0,1);
   mgb-claim(log,"unknown schemas do not become legacy claims",!mg-granted?(alien) && alien[1]=="lease-observation-unavailable" && host_path_exists(unknown)==1);host_path_remove(unknown);
   let pid=host_spawn_at(["/usr/bin/true"],["/dev/null","/dev/null","/dev/null"]);let exit=pid>0 ? host_wait(pid) : -1;
   let dead=root+"/dead.lease";write_file(dead,mg-reservation-text(mg-reservation-new(pid,"dead","",0,3,now_unix_ms(),"dead")));
   let snapshot=mg-reservation-snapshot(root);
   mgb-claim(log,"observed dead owners are reclaimed",exit==0 && host_alive(pid)==0 && host_path_exists(dead)==0 && mg-reservation-pending(record_get(snapshot,"rows"))==36);
   let blocked=root+"/not-a-directory";write_file(blocked,"held");
   let bad=mgb-ask(blocked,"",0,1);
   mgb-claim(log,"missing reservation storage cannot grant",!mg-granted?(bad) && bad[1]=="lease-dir-unavailable");
   let partitioned=mg-reservation-partition(ta,[["scratch",3],["stream",5]]);
   let scratch=mg-reservation-part(ta,"scratch");let stream=mg-reservation-part(ta,"stream");
   mgb-claim(log,"parts preserve total ownership",partitioned && mgb-pending(root)==36 && !mg-reservation-partition(ta,[["duplicate",4],["duplicate",4]]));
   let observed=mg-reservation-ack(scratch,3) && mg-reservation-ack(stream,2);
   mgb-claim(log,"allocation acknowledgements are absolute and monotonic",observed && mgb-pending(root)==31 && mg-reservation-ack(stream,1) && mgb-pending(root)==31 && mg-reservation-ack(stream,2));
   mgb-claim(log,"overack and changed partition refuse",!mg-reservation-ack(stream,6) && !mg-reservation-partition(ta,[["other",8]]) && !mg-reservation-retire(mg-reservation-part(ta,"unknown")) && mgb-pending(root)==31);
   let retired=mg-reservation-retire(stream) && mg-reservation-retire(stream);
   mgb-claim(log,"retiring one part keeps siblings and shared ownership",retired && mgb-pending(root)==28 && mg-reservation-retire(scratch) && mgb-pending(root)==28 && !mg-reservation-retire(mg-reservation-part(tb,"scratch")));
   let keyless=mgb-ask(root,"",7,2);let tk=mg-reservation-of(keyless);
    let legacyA=mg-reservation-read-text("{\"pid\":1,\"who\":\"legacy-a\",\"key\":\"\",\"shared\":7,\"own\":2,\"granted_unix_ms\":0}");
    let legacyB=mg-reservation-read-text("{\"pid\":1,\"who\":\"legacy-b\",\"key\":\"\",\"shared\":11,\"own\":3,\"granted_unix_ms\":0}");
    mgb-claim(log,"keyless promises stay independent across schema versions",mg-granted?(keyless) && keyless[5]==37 && mg-reservation-read-text(read_file(record_get(tk,"path")))[3]==0 && mg-reservation-pending([legacyA,legacyB])==23);
   mgb-claim(log,"explicit shared observation is retained independently",mg-reservation-ack-shared(ta) && mgb-pending(root)==17);
   let released=mg-reservation-release(ta) && mg-reservation-release(ta);
   mgb-claim(log,"release is exact and idempotent",released && mgb-pending(root)==37 && host_path_exists(record_get(tb,"path"))==1 && mg-release-at(root,host_pid())!=0 && mgb-pending(root)==37);
   let pending=mg-reservation-token(root,mg-reservation-new(host_pid(),"pending","",0,0,now_unix_ms(),"unpublished"));
   let temporary=record_get(pending,"path")+".part";write_file(temporary,"candidate");
   let descriptor=nps-file-open(temporary,0);
    let lockDescriptor=nps-file-open(temporary,0);
    record_set(pending,"lock-operation",record_new(0,"lease",lockDescriptor,"released",0));
   let guard=record_new(0,"published",0,"released",0,"release_leases",[descriptor[0]]);
   record_set(pending,"publication",record_new(0,"phase","commit-observed","guard",guard,"temporary",temporary));
   let settled=mg-reservation-release(pending);
    mgb-claim(log,"unpublished cleanup settles its exact file owners",settled && nps-file-held(descriptor)==0 && nps-file-held(lockDescriptor)==0 && host_path_exists(temporary)==0 && mg-reservation-release(pending));
   write_file(dead,mg-reservation-text(mg-reservation-new(pid,"dead","",0,3,now_unix_ms(),"dead")));
   write_file(unknown,"unknown\n");let view=mg-lease-view(root);
   mgb-claim(log,"read-only view never reclaims or erases",len(view)==2 && host_path_exists(dead)==1 && read_file(unknown)=="unknown\n");
   host_path_remove(unknown);host_path_remove(dead);host_path_remove(blocked);
   let doorDir=root+"/door";let doorHeld=mgb-ask(doorDir,"k",600,10);
   let dOver=mg-door-ask-at(doorDir,"door-band","other",100,50,900,mgb-vm(1000,0,0));
   let dSame=mg-door-ask-at(doorDir,"door-band","k",600,20,100,mgb-vm(1000,0,0));
   let dFar=mg-door-ask-at(doorDir,"door-band","other",600,20,100,mgb-vm(1000,0,0));
   mgb-claim(log,"the door's first ask refuses a run that would leave less than its reserve free, with the reading, and takes no lease",mg-granted?(doorHeld) && !mg-granted?(dOver) && dOver[1]=="reserve 0.0 GiB must stay free" && mgb-pending(doorDir)==dOver[6] && host_path_exists(doorDir+"/door-ask.lease")==0);
   mgb-claim(log,"a key a live lease already holds is charged once: the second run adds its own bytes, not the weights again",mg-granted?(dSame) && dSame[5]-dSame[6]==20 && !mg-granted?(dFar) && dFar[1]=="capacity" && dFar[5]-dFar[6]==620);
   mgb-claim(log,"the door's line names the shared mapping and the reserve",str_find(mg-door-line("door-band","k",600,20,100,dSame),"shared, not copied",0)>=0 && str_find(mg-door-line("door-band","other",600,20,100,dFar),"shared, not copied",0)<0 && str_find(mg-door-line("door-band","other",600,20,100,dFar),"[memory] held door-band",0)==0);
   let doorReleased=mg-reservation-release(mg-reservation-of(doorHeld));
   let closed=doorReleased && mg-reservation-release(tb) && mg-reservation-release(tk);
   let claims=record_get(log,"claims");
   let verdict=foldl((state,row)=>[state[0]+(row[1] ? state[1] : 0),state[1]*2],[0,1],claims)[0];
   print(["memory-governor",len(claims),"claims","release",closed,"evidence",root]);
   if verdict==536870911 && closed then host_dir_rmdir(root) else 0;
   verdict;
  }
 }
 mgb-run();
}
