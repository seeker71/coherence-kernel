; value-str-band.bml — a value as text, four-way.
;
; preludes: form-stdlib/core.fk
;
; value_str writes a value the way the Go kernel's formValueString writes it, and every kernel carries
; it: Go, Rust and TS as natives, fkwu as mode 25 of its leaf door. int_to_str answers the same text for
; an integer, a float or a string.
;
; Verdict 1023 when every claim lands:
;   1     a float with a short fraction reads as written: 1.5, 0.1, -2.25
;   2     from 1e6 up and below 1e-4 a float takes an exponent: 1.23456789e+08, 2.5e+06, 1e+21, 1e-05
;   4     an integer reads in decimal, a negative one with its sign, and 2^53 + 1 with every digit
;   8     a string reads as itself
;   16    a list reads as print writes it, its items likewise, and the empty list as []
;   32    int_to_str answers value_str's text for a float and for an integer
;   64    a float4 widened to a double reads as Go writes it: 1.1 as 1.100000023841858
;   128   int_to_str passes a string through as itself, the empty one too, as every sibling's native does
;   256   an exact tie between two 17-digit decimals breaks to even: 147142857142857.125 reads
;         1.4714285714285712e+14, and its negation likewise with its sign
;   512   at a power of two, where the gap below is half the gap above, the shortest digits that read back
;         are written even when the correctly rounded ones of that length do not: 2^-1017 reads
;         7.120236347223045e-307, 2^-1007 reads 7.291122019556398e-304
section [form.bml] {
    // Public value syntax shares the primitive rendering and sequence meaning.
    def vstb-plus(a,b) = a + b;
    def vstb-index(xs,i) = xs[i];
    def vstb-surface() {
        let xs = [2,4,6,8];
        let values = [len("four"),len(xs),vstb-plus("a","b"),vstb-plus(20,22),vstb-plus([1],[2]),
            xs[0],xs[-1],xs[1:],xs[:2],xs[1:3],xs[-2:],xs[:-1],xs[3:1],xs[-99:99],xs[:],
            "ab"[0],vstb-index("ab",0),"ab"[-1],"abcd"[1:3],"abcd"[1:],
            (42).str(),[1,2].str(),try fail catch 7,choice { fail; 0; 9 }];
        let expected = [4,4,"ab",42,[1,2],2,8,[4,6,8],[2,4],[4,6],[6,8],[2,4,6],[],xs,xs,
            "a","a","b","bc","bcd","42","[1, 2]",7,0];
        if values != expected || !nothing?(xs[-9]) || !nothing?(""[0]) then form_error("BML value surface changed") else 0;
        let order = record_new(0,"calls",[]);
        def offered(mark,value) { record_set(order,"calls",append(record_get(order,"calls"),[mark])); value; }
        let selected = offered("receiver",xs)[offered("start",1):offered("end",3)];
        if selected != [4,6] || record_get(order,"calls") != ["receiver","start","end"] then form_error("slice evaluation order changed") else 0;
    }
    class ValueStrBand {
        def vstb-bit(ok, bit) = if ok then bit else 0;
        def vstb-is(v, text) = ((String) value_str(v) == text);
        def vstb-score() = (vstb-bit((vstb-is(1.5, "1.5") && (vstb-is(0.1, "0.1") && vstb-is((0.0 - 2.25), "-2.25"))), 1) + (vstb-bit(((vstb-is(123456789.0, "1.23456789e+08") && vstb-is(2500000.0, "2.5e+06")) && (vstb-is((1000000000.0 * 1000000000000.0), "1e+21") && vstb-is((1.0 / 100000.0), "1e-05"))), 2) + (vstb-bit((vstb-is(42, "42") && (vstb-is((0 - 7), "-7") && vstb-is((9007199254740992 + 1), "9007199254740993"))), 4) + (vstb-bit(vstb-is("s b", "s b"), 8) + (vstb-bit((vstb-is(list(1, 2.5, "x"), "[1, 2.5, x]") && (vstb-is(list(), "[]") && vstb-is(list(list(1), "a b"), "[[1], a b]"))), 16) + (vstb-bit((((String) int_to_str(2500000.0) == "2.5e+06") && (((String) int_to_str(1.5) == "1.5") && ((String) int_to_str((0 - 42)) == "-42"))), 32) + (vstb-bit(vstb-is(float_value(make_float32(1.1)), "1.100000023841858"), 64) + (vstb-bit((((String) int_to_str("s b") == "s b") && ((String) int_to_str("") == "")), 128) + (vstb-bit((vstb-is(147142857142857.12, "1.4714285714285712e+14") && vstb-is((0.0 - 147142857142857.12), "-1.4714285714285712e+14")), 256) + vstb-bit((vstb-is(7.120236347223045e-307, "7.120236347223045e-307") && vstb-is(7.291122019556398e-304, "7.291122019556398e-304")), 512))))))))));
    }
    vstb-surface();
    vstb-score();
}
