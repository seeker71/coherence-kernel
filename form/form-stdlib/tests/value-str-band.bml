; value-str-band.bml — a value as text, four-way.
;
; preludes: form-stdlib/core.fk
;
; value_str writes a value the way the Go kernel's formValueString writes it, and every kernel carries
; it: Go, Rust and TS as natives, fkwu as mode 25 of its leaf door. int_to_str answers the same text for
; an integer, a float or a string.
;
; Verdict 1023 when every claim lands:
;   1     a float with a short fraction reads as written: 1.5, 0.1, -2.25
;   2     from 1e6 up and below 1e-4 a float takes an exponent: 1.23456789e+08, 2.5e+06, 1e+21, 1e-05
;   4     an integer reads in decimal, a negative one with its sign, and 2^53 + 1 with every digit
;   8     a string reads as itself
;   16    a list reads as print writes it, its items likewise, and the empty list as []
;   32    int_to_str answers value_str's text for a float and for an integer
;   64    a float4 widened to a double reads as Go writes it: 1.1 as 1.100000023841858
;   128   int_to_str passes a string through as itself, the empty one too, as every sibling's native does
;   256   an exact tie between two 17-digit decimals breaks to even: 147142857142857.125 reads
;         1.4714285714285712e+14, and its negation likewise with its sign
;   512   at a power of two, where the gap below is half the gap above, the shortest digits that read back
;         are written even when the correctly rounded ones of that length do not: 2^-1017 reads
;         7.120236347223045e-307, 2^-1007 reads 7.291122019556398e-304
section [form.bml] {
    class ValueStrBand {
        def vstb-bit(ok, bit) = if ok then bit else 0;
        def vstb-is(v, text) = str_eq(value_str(v), text);
        def vstb-score() = add(
            vstb-bit(and(vstb-is(1.5, "1.5"), and(vstb-is(0.1, "0.1"), vstb-is(sub(0.0, 2.25), "-2.25"))), 1),
            add(vstb-bit(and(and(vstb-is(123456789.0, "1.23456789e+08"), vstb-is(2500000.0, "2.5e+06")), and(vstb-is(mul(1000000000.0, 1000000000000.0), "1e+21"), vstb-is(div(1.0, 100000.0), "1e-05"))), 2),
            add(vstb-bit(and(vstb-is(42, "42"), and(vstb-is(sub(0, 7), "-7"), vstb-is(add(9007199254740992, 1), "9007199254740993"))), 4),
            add(vstb-bit(vstb-is("s b", "s b"), 8),
            add(vstb-bit(and(vstb-is(list(1, 2.5, "x"), "[1, 2.5, x]"), and(vstb-is(list(), "[]"), vstb-is(list(list(1), "a b"), "[[1], a b]"))), 16),
            add(vstb-bit(and(str_eq(int_to_str(2500000.0), "2.5e+06"), and(str_eq(int_to_str(1.5), "1.5"), str_eq(int_to_str(sub(0, 42)), "-42"))), 32),
                add(vstb-bit(vstb-is(float_value(make_float32(1.1)), "1.100000023841858"), 64),
                    add(vstb-bit(and(str_eq(int_to_str("s b"), "s b"), str_eq(int_to_str(""), "")), 128),
                        add(vstb-bit(and(vstb-is(147142857142857.12, "1.4714285714285712e+14"), vstb-is(sub(0.0, 147142857142857.12), "-1.4714285714285712e+14")), 256),
                            vstb-bit(and(vstb-is(7.120236347223045e-307, "7.120236347223045e-307"), vstb-is(7.291122019556398e-304, "7.291122019556398e-304")), 512))))))))));
    }
    vstb-score();
}
