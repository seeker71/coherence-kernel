; living-world-operation-query-band.fk -- every compatible profile answers;
; plurality, consensus, optional channels, and timeout remain distinct.
; Verdict 32767 proves fifteen held-out answer and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk form-stdlib/living-world-operation-field.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-structural-recipe-witness.fk form-stdlib/tests/living-world-operation-field-witness.fk

(defn lwoeqb-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwoeqb-sum (tail items)))))

(defn lwoeqb-evaluated-carrier? (items carrier)
    (if (eq (len items) 0) 0
        (if (node_eq
                (lwoe-profile-carrier
                    (lwoe-query-eval-profile (head items))) carrier) 1
            (lwoeqb-evaluated-carrier? (tail items) carrier))))

(do
    (let evolved (lwoew-build-evolved))
    (let base (lwoew-evolved-base evolved))
    (let schema (lwoew-base-schema base))
    (let base-world (lwoew-base-world-cell base))
    (let base-candidate (lwoew-base-candidate base))
    (let base-query (lwoew-base-query base))
    (let base-answer (lwoew-base-answer base))
    (let base-evaluations (lwoe-answer-evaluations base-answer))
    (let base-outputs (lwoe-answer-outputs base-answer))
    (let expired-answer
        (lwoe-answer-for base-world base-query 2 (intern_trivial_int 10)))
    (let evolved-world (lwoew-evolved-world evolved))
    (let evolved-candidate (lwoew-evolved-candidate evolved))
    (let evolved-query (lwoew-evolved-query evolved))
    (let evolved-answer (lwoew-evolved-answer evolved))
    (let evolved-evaluations (lwoe-answer-evaluations evolved-answer))
    (let evolved-outputs (lwoe-answer-outputs evolved-answer))
    (let revoked (lwoew-revoked-example-world evolved))

    (let c1
        (if (and (eq (lwoe-query-valid? base-query) 1)
                 (and (eq (lwoe-query-current?
                              base-world base-query 2) 1)
                      (eq (lwoe-query-current?
                              base-world base-query 3) 0))) 1 0))
    (let c2
        (if (and (eq (lwo-field-size base-evaluations) 4)
                 (eq (lwo-field-size base-outputs) 2)) 2 0))
    (let c3
        (if (and (eq (lwo-field-has?
                         base-outputs (intern_trivial_int 13)) 1)
                 (and (eq (lwo-field-has?
                              base-outputs (intern_trivial_int 40)) 1)
                      (eq (oac-node?
                              (lwoe-answer-immediate-ack base-answer)) 1)))
            4 0))
    (let c4
        (if (and (node_eq
                     (oac-payload
                         (lwoe-answer-immediate-ack base-answer))
                     base-outputs)
                 (and (eq (oac-time-pending?
                              (lwoe-answer-time-observation base-answer)) 1)
                      (not (node_eq
                              (lwoe-answer-immediate-ack base-answer)
                              (lwoe-answer-time-observation base-answer)))))
            8 0))
    (let c5
        (if (and (eq (lwo-field-size
                         (lwoe-query-alternatives base-query)) 1)
                 (and (eq (lwlc-unknown?
                              (lwoe-query-unknown base-query)) 1)
                      (and (eq (lwlc-choice-valid?
                                  (lwoe-query-choice base-query)) 1)
                           (eq (oac-timeout-valid?
                                  (lwoe-query-timeout base-query)) 1))))
            16 0))
    (let c6
        (if (and (gt (lwo-field-size
                         (lwoe-answer-alternatives base-answer)) 0)
                 (gt (lwo-field-size
                         (lwoe-answer-unknowns base-answer)) 0)) 32 0))
    (let c7
        (if (and (eq (lwoe-answer-current?
                         base-world base-answer) 1)
                 (and (gt (lwo-field-size
                              (lwoe-answer-witnesses-field base-answer)) 0)
                      (gt (lwo-field-size
                              (lwt-sources-from-attributions
                                (lwo-field-items
                                  (lwoe-answer-witnesses-field base-answer))
                                (lwo-empty-field))) 0))) 64 0))
    (let c8
        (if (and (eq (lwo-field-size evolved-evaluations) 2)
                 (eq (lwo-field-size evolved-outputs) 1)) 128 0))
    (let c9
        (if (and (eq (oac-one?
                         (lwoe-answer-immediate-ack evolved-answer)) 1)
                 (node_eq
                     (oac-payload
                         (lwoe-answer-immediate-ack evolved-answer))
                     (intern_trivial_int 13))) 256 0))
    (let c10
        (if (and (eq (lwo-field-size
                         (lwoe-query-alternatives evolved-query)) 0)
                 (and (node_eq
                          (lwoe-query-unknown evolved-query) (lwo-none))
                      (and (node_eq
                              (lwoe-query-choice evolved-query) (lwo-none))
                           (and (node_eq
                                  (lwoe-query-timeout evolved-query)
                                  (lwo-none))
                                (node_eq
                                  (lwoe-answer-time-observation evolved-answer)
                                  (lwo-none)))))) 512 0))
    (let c11
        (if (and (eq (lwoeqb-evaluated-carrier?
                         (lwo-field-items evolved-evaluations)
                         (lwoew-add-forward schema)) 1)
                 (eq (lwoeqb-evaluated-carrier?
                         (lwo-field-items evolved-evaluations)
                         (lwoew-add-reverse schema)) 1)) 1024 0))
    (let c12
        (if (and (eq (lwoe-query-current?
                         evolved-world evolved-query 2) 1)
                 (and (eq (lwoe-answer-current?
                              evolved-world evolved-answer) 1)
                      (eq (lwoe-candidate-current?
                              evolved-world evolved-candidate) 1))) 2048 0))
    (let c13
        (if (and (eq (lwoe-candidate-current?
                         evolved-world base-candidate) 0)
                 (and (eq (lwoe-answer-current?
                              evolved-world base-answer) 0)
                      (not (node_eq base-answer evolved-answer)))) 4096 0))
    (let c14
        (if (and (eq (lwoe-candidate-current?
                         revoked evolved-candidate) 0)
                 (and (eq (lwoe-answer-current?
                              revoked evolved-answer) 0)
                      (and (eq (lwoe-candidate-current?
                                  revoked base-candidate) 1)
                           (eq (lwoe-answer-current?
                                  revoked base-answer) 1)))) 8192 0))
    (let c15
        (if (and (eq (oac-time-outcome?
                         (lwoe-answer-time-observation expired-answer)) 1)
                 (and (eq (oac-alternative-ack?
                              (oac-time-outcome-ack
                                (lwoe-answer-time-observation
                                  expired-answer))) 1)
                      (and (eq (oac-node?
                                  (lwoe-answer-immediate-ack
                                    expired-answer)) 1)
                           (and (not (node_eq
                                      (lwoe-answer-time-observation
                                        base-answer)
                                      (lwoe-answer-time-observation
                                        expired-answer)))
                                (eq (lwoe-answer-current?
                                      base-world expired-answer) 1)))))
            16384 0))
    (lwoeqb-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
