; living-world-action-execution-band.fk -- native result observes its own delta.
; Verdict 32767 proves fifteen execution, comparison, timeout, and consent claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk

(do
    (let selection-round (lwacw-selection-integrated-round))
    (let world (lwt-round-world selection-round))
    (let selection (lwacw-selection-candidate))
    (let proposal
        (lwacw-execution-proposal-for world selection
            (intern_trivial_int 5)))
    (let candidate (lwt-proposal-candidate proposal))
    (let execution (lwo-emergent-shape candidate))
    (let trace (lwac-execution-trace execution))
    (let comparison (lwac-execution-comparison execution))
    (let comparison-alternative (oac-payload comparison))
    (let pending (lwac-execution-time-observation execution))
    (let expired
        (lwac-execution-for world selection
            (intern_trivial_int 10) (lwacw-evidence)))
    (let expired-time (lwac-execution-time-observation expired))
    (let expired-ack (oac-time-outcome-ack expired-time))
    (let round
        (lwacw-execution-round-for world selection
            (intern_trivial_int 5) selection-round))
    (let waiting
        (lwac-execution-integrate round proposal (lwrew-action)))
    (let integrated (lwacw-execution-integrated-round))
    (let integrated-world (lwt-round-world integrated))
    (let revoked-world (lwacw-revoked-old-world world))
    (let no-prediction
        (lwac-comparison (lwo-none) (lwacw-actual-delta)
            (lwacw-evidence)))
    (let no-default
        (oac-timeout (intern_trivial_int 10)
            (oac-no-default) (lwacw-evidence)))
    (let no-default-expired
        (oac-timeout-condense no-default (intern_trivial_int 10)))

    (let c1 (if (and (not (node_eq proposal (lwo-none)))
                         (eq (lwac-execution? execution) 1)) 1 0))
    (let c2 (if (eq (node_value
                         (lwre-result-primary
                           (lwre-trace-result trace))) 49) 2 0))
    (let c3 (if (and (node_eq (lwre-trace-changes trace)
                               (lwacw-actual-delta))
                         (and (node_eq (lwac-execution-actual execution)
                                      (lwacw-actual-delta))
                              (eq (lwac-flow?
                                   (lwre-trace-flow trace)) 1))) 4 0))
    (let c4 (if (and (node_eq (lwac-execution-prediction execution)
                               (lwacw-wrong-delta))
                         (eq (oac-alternative-ack? comparison) 1)) 8 0))
    (let c5 (if (and (node_eq
                           (oac-alternative-reference comparison-alternative)
                           (lwacw-wrong-delta))
                         (node_eq
                           (oac-alternative-offered comparison-alternative)
                           (lwacw-actual-delta))) 16 0))
    (let c6 (if (and (eq (oac-time-pending? pending) 1)
                         (eq (oac-alternative-ack? comparison) 1)) 32 0))
    (let c7 (if (and (eq (oac-time-outcome? expired-time) 1)
                         (and (eq (oac-alternative-ack? expired-ack) 1)
                              (not (node_eq expired-ack
                                    comparison)))) 64 0))
    (let c8 (if (and (eq (lwo-field-size
                              (lwac-execution-alternatives execution)) 3)
                         (eq (lwo-field-size
                              (lwac-execution-unknowns execution)) 1)) 128 0))
    (let c9 (if (and (eq (lwo-field-size
                              (lwo-emergent-witnesses candidate)) 8)
                         (eq (lwo-field-size
                              (lwt-proposal-participants proposal)) 5)) 256 0))
    (let c10 (if (eq (lwo-active?
                          (lwt-round-world waiting) candidate) 0) 512 0))
    (let c11 (if (and (eq (lwo-active?
                               integrated-world candidate) 1)
                          (eq (lwo-field-size
                               (lwo-active-attributions-for
                                 integrated-world candidate)) 5)) 1024 0))
    (let c12 (if (and (eq (lwac-execution-current?
                               world execution) 1)
                          (eq (lwac-execution-integrated-current?
                               integrated-world candidate) 1)) 2048 0))
    (let c13 (if (and (node_eq
                           (lwac-execution-for (lwacw-world) selection
                              (intern_trivial_int 5) (lwacw-evidence))
                           (lwo-none))
                          (eq (lwac-execution-candidate-current?
                               revoked-world candidate) 0)) 4096 0))
    (let c14 (if (and (eq (oac-node? no-prediction) 1)
                          (and (node_eq (oac-payload no-prediction)
                                   (lwacw-actual-delta))
                               (and (eq (oac-time-outcome?
                                         no-default-expired) 1)
                                    (eq (oac-nothing?
                                         (oac-time-outcome-ack
                                           no-default-expired)) 1)))) 8192 0))
    (let c15 (if (and (node_eq (lwac-execution-path execution)
                               (lwo-local-path))
                          (eq (lwac-execution-proposal-current?
                               world proposal) 1)) 16384 0))
    (lwacw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
