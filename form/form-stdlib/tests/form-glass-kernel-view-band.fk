; form-glass-kernel-view-band.fk — the kernel, live and in-process, on the glass.
;
; PURE apart from one gift frame this band offers to make kernel_stat 41 move.
; Expected: 511
; preludes: form-stdlib/form-glass-live.bml

(do
    (defn kb-bit (ok bit) (if ok bit 0))
    (defn kb-find (rows id) (if (eq (len rows) 0) (list) (if (str_eq (fgo-id (head rows)) id) (head rows) (kb-find (tail rows) id))))
    (defn kb-hot-row (rows) (if (eq (len rows) 0) (list) (if (eq (str_find (fgo-id (head rows)) "hot." 0) 0) (head rows) (kb-hot-row (tail rows)))))
    (defn warm (n) (if (le n 0) 0 (add 1 (warm (sub n 1)))))
    (let w (warm 400))

    ; the kernel rows carry gift frames, gift bytes, and the function count
    (let rows (fgl-kernel-rows))
    (let b1 (kb-bit (and (gt (len (kb-find rows "gift-frames")) 0) (and (gt (len (kb-find rows "gift-bytes")) 0) (gt (len (kb-find rows "fns")) 0))) 1))
    (let b2 (kb-bit (gt (fgo-int-value (kb-find rows "fns")) 100) 2))

    ; an offered frame is counted, in frames and in bytes
    (let before (fgo-int-value (kb-find rows "gift-frames")))
    (let h (shm_offer "/fk-kernel-band" 4096))
    (let after (fgl-kernel-rows))
    (let b3 (kb-bit (and (eq (fgo-int-value (kb-find after "gift-frames")) (add before 1)) (ge (fgo-int-value (kb-find after "gift-bytes")) 4096)) 4))
    (let rel (shm_release h))

    ; the hottest defns arrive as rows with a source pointer -- unit, line, column -- and warm is among them
    (let hot (kb-hot-row rows))
    (let b4 (kb-bit (and (gt (len hot) 0) (gt (fgo-int-value hot) 0)) 8))
    (let b5 (kb-bit (and (ge (str_find (fgo-note hot) ".fk:" 0) 0) (str_eq (fgo-domain hot) "kernel")) 16))
    (let b6 (kb-bit (gt (len (kb-find rows "hot.warm")) 0) 32))

    ; the view is registered on every door the glass keys a view through
    (let b7 (kb-bit (and (eq (fgd-view? "kernel") 1) (and (eq (fgls-full-view? "kernel") 1) (str_eq (fgl-control-key-view "k") "kernel"))) 64))

    ; the frame cache: empty shape, and a cached inventory that does not re-read what did not move
    (let c0 (fgl-cache-empty))
    (let pair1 (fgtm-inventory-cached (FGLRoot) (fgl-cache-snapshots c0)))
    (let pair2 (fgtm-inventory-cached (FGLRoot) (nth pair1 1)))
    (let b8 (kb-bit (and (eq (len c0) 4) (and (eq (len (nth pair1 1)) (len (nth pair2 1))) (le (fgtm-inventory-moved pair2 (nth pair1 1)) (len (nth pair1 1))))) 128))

    ; the pacer is a native rest, not a fork: a 20 ms rest measured on the monotonic clock is at least 20 ms
    (let m0 (host_monotonic_ms))
    (let rested (host_sleep_ms 20))
    (let m1 (host_monotonic_ms))
    (let b9 (kb-bit (and (ge rested 20) (ge (sub m1 m0) 20)) 256))

    (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 b9)))))))))
