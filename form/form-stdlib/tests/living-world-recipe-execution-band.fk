; living-world-recipe-execution-band.fk -- dynamic Recipe evaluation asks first.
; Verdict 32767 proves fifteen execution, trace, consent, and revocation claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/tests/living-world-recipe-execution-witness.fk

(do
    (let world (lwrew-world))
    (let proposal (lwrew-proposal-for-world world))
    (let candidate (lwt-proposal-candidate proposal))
    (let trace (lwo-emergent-shape candidate))
    (let result (lwre-trace-result trace))
    (let waiting
        (lwre-integrate (lwrew-round) proposal (lwrew-action)))
    (let integrated (lwrew-integrated-round))
    (let integrated-world (lwt-round-world integrated))
    (let revoked (lwrew-revoked-world))
    (let revoked-round
        (lwt-round revoked
            (lwo-field-add (lwo-empty-field) proposal)
            (lwo-empty-field) (lwo-none)))
    (let revoked-attempt
        (lwre-integrate revoked-round proposal (lwrew-action)))
    (let forged
        (lwre-execute (lwo-empty-world)
            (lwrew-declaration) (lwrew-recipe-lens) (lwrew-before)
            (lwo-empty-field) (lwo-none) (lwo-none)
            (lwrew-flow) (lwrew-changes) (lwrew-evidence)))
    (let collapsed-nothing
        (lwre-recipe "(if (eq nothing 0) 42 0)"
            (lwrew-contract) (lwrew-evidence)))

    (let c1 (if (and (eq (lwre-contract-valid?
                              (lwrew-contract)) 1)
                         (eq (lwre-recipe-valid?
                              (lwrew-recipe)) 1)) 1 0))
    (let c2 (if (eq (node_value
                         (lwre-result-primary result)) 49) 2 0))
    (let c3 (if (and (node_eq (lwre-trace-recipe trace)
                               (lwrew-recipe))
                         (and (node_eq (lwre-trace-before trace)
                                      (lwrew-before))
                              (node_eq (lwre-trace-declaration trace)
                                       (lwrew-declaration)))) 4 0))
    (let c4 (if (and (node_eq (lwre-trace-flow trace)
                               (lwrew-flow))
                         (node_eq (lwre-trace-changes trace)
                                  (lwrew-changes))) 8 0))
    (let c5 (if (and (eq (lwo-field-size
                              (lwre-result-alternatives result)) 1)
                         (eq (lwlc-unknown?
                              (lwre-result-unknown result)) 1)) 16 0))
    (let c6 (if (and (eq (lwlc-choice-valid?
                              (lwre-trace-choice trace)) 1)
                         (eq (lwo-field-size
                              (lwlc-choice-alternatives
                                (lwre-trace-choice trace))) 1)) 32 0))
    (let c7 (if (and (eq (lwo-field-size
                              (lwre-trace-witnesses trace)) 3)
                         (eq (lwo-field-size
                              (lwt-proposal-participants proposal)) 2)) 64 0))
    (let c8 (if (and (eq (lwre-trace-current? world trace) 1)
                         (eq (lwre-proposal-current? world proposal) 1)) 128 0))
    (let c9 (if (eq (lwo-world-has?
                         (lwt-round-world waiting) candidate) 0) 256 0))
    (let c10 (if (and (eq (lwo-active?
                               integrated-world candidate) 1)
                          (eq (lwo-field-size
                               (lwo-active-attributions-for
                                integrated-world candidate)) 2)) 512 0))
    (let c11 (if (and (node_eq
                           (lwt-outcome-status
                            (head (lwo-field-items
                              (lwt-round-outcomes integrated))))
                           (lwt-status-acknowledged))
                          (eq (lwre-proposal-current?
                               integrated-world proposal) 1)) 1024 0))
    (let c12 (if (and (eq (lwre-trace-current?
                               revoked trace) 0)
                          (eq (lwre-proposal-current?
                               revoked proposal) 0)) 2048 0))
    (let c13 (if (eq (lwo-world-has?
                          (lwt-round-world revoked-attempt)
                          candidate) 0) 4096 0))
    (let c14 (if (node_eq forged (lwo-none)) 8192 0))
    (let c15 (if (and (eq (lwre-recipe-valid?
                               collapsed-nothing) 0)
                          (and (node_eq
                           (lwre-contract-effect
                            (lwre-recipe-contract
                              (lwre-trace-recipe trace)))
                           (lwre-pure-effect))
                          (not (node_eq
                                (lwre-result-unknown result)
                                (lwo-none))))) 16384 0))
    (lwrew-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
