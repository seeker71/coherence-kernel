; dsv4-decode-hook-door-live.fk — the resident crossing itself, watched live: this
; cell spawns ONE fkwu holding the control-recipe door, stages three requests with
; REAL clock deadlines, and reads the law's answers back through the same keyed
; protocol a decode carrier uses. Form orchestrates its own witness — no bash.
;
; Run from the checkout root:  ./fkwu form/form-stdlib/tests/dsv4-decode-hook-door-live.fk
;
; PROOF LEVEL: FOURTH-ARM ONLY — print_str confines it (pf-arm-mask 8; host-exec is 9, go + fkwu; probed 2026-09-03). host-exec (optag 136) is this cell's organ, the
; same VIA-HOST port four-way-run.fk stands on. The door and recipe cells it
; drives are proven four-way by dsv4-decode-hook-door-band.fk; this cell proves
; the CROSSING: one spawn, many requests, millisecond answers inside the 34 ms
; budget, and the default retained the moment the deadline has already passed.
;
; Verdict 63:
;   1   one spawn served every request (exactly one ready=1 line)
;   2   the declared situation's reply: chosen=128003, recipe-more-vital
;   4   the undeclared reply: the default stands, ack-nothing
;   8   the passed-deadline reply: timeout-nothing, recipe never run
;   16  the answered request's door time fits the 34 ms token budget
;   32  prepare (fit + held-out eval) happened once, before the first request
;
; preludes: form-stdlib/core.fk

(do
    (defn dhdl-nl () (byte_to_str 10))
    (defn dhdl-sentence () "backup restore ran out of its window before anything settled")
    (defn dhdl-req (step default deadline situation)
        (str_concat "offer step="
        (str_concat (int_to_str step)
        (str_concat " default="
        (str_concat (int_to_str default)
        (str_concat " deadline_ms="
        (str_concat (int_to_str deadline)
        (str_concat " context=3,17 situation="
        (str_concat situation (dhdl-nl))))))))))

    (defn dhdl-field (block key)
        (do (let at (str_find block key 0))
            (if (lt at 0) ""
                (do (let from (add at (str_len key)))
                    (let stop (str_find block (dhdl-nl) from))
                    (substring block from (if (lt stop 0) (str_len block) stop))))))
    (defn dhdl-field-int (block key)
        (do (let v (dhdl-field block key))
            (if (eq (str_len v) 0) -1 (str_to_int v))))
    (defn dhdl-cut (out)
        (do (let at (str_find out "end=1" 0))
            (if (lt at 0) "" (substring out (add at 5) (str_len out)))))
    (defn dhdl-head (out)
        (do (let at (str_find out "end=1" 0))
            (if (lt at 0) out (substring out 0 at))))
    (defn dhdl-count (out key from acc)
        (do (let at (str_find out key from))
            (if (lt at 0) acc (dhdl-count out key (add at (str_len key)) (add acc 1)))))

    (let now (now_unix_ms))
    (let future (add now 600000))
    (let past (sub now 1000))
    (let req-path (str_concat (temp_dir) "/dhd-door-live-requests.txt"))
    (let _w (write_file_text req-path
        (str_concat (dhdl-req 0 201 future (dhdl-sentence))
        (str_concat (dhdl-req 0 201 future "")
                    (dhdl-req 0 201 past (dhdl-sentence))))))
    (let t0 (now_unix_ms))
    (let out (host-exec
        (str_concat "./fkwu form/form-stdlib/dsv4-hook-door-control.fk < " req-path)
        ""))
    (let wall (sub (now_unix_ms) t0))

    (let b1 (dhdl-head out))
    (let rest1 (dhdl-cut out))
    (let b2 (dhdl-head rest1))
    (let b3 (dhdl-head (dhdl-cut rest1)))
    (let door-ms (sub (dhdl-field-int b1 "finished_ms=") (dhdl-field-int b1 "started_ms=")))

    (print_str (str_concat "dhd-live spawn_wall_ms=" (int_to_str wall)))
    (print_str (str_concat "dhd-live prepare_ms=" (dhdl-field out "prepare_ms=")))
    (print_str (str_concat "dhd-live declared: chosen=" (dhdl-field b1 "chosen=")))
    (print_str (str_concat "dhd-live declared: reason=" (dhdl-field b1 "reason=")))
    (print_str (str_concat "dhd-live declared: vitality=" (dhdl-field b1 "vitality_chosen=")))
    (print_str (str_concat "dhd-live declared: door_ms=" (int_to_str door-ms)))
    (print_str (str_concat "dhd-live undeclared: chosen=" (dhdl-field b2 "chosen=")))
    (print_str (str_concat "dhd-live undeclared: reason=" (dhdl-field b2 "reason=")))
    (print_str (str_concat "dhd-live late: state=" (dhdl-field b3 "state=")))

    (defn dhdl-score (ok bit) (if ok bit 0))
    (sum (list
        (dhdl-score (eq (dhdl-count out "ready=1" 0 0) 1) 1)
        (dhdl-score (and (eq (dhdl-field-int b1 "chosen=") 128003)
                         (str_eq (dhdl-field b1 "reason=") "recipe-more-vital")) 2)
        (dhdl-score (and (eq (dhdl-field-int b2 "chosen=") 201)
                         (str_eq (dhdl-field b2 "reason=") "ack-nothing")) 4)
        (dhdl-score (str_eq (dhdl-field b3 "state=") "timeout-nothing") 8)
        (dhdl-score (and (ge door-ms 0) (le door-ms 34)) 16)
        (dhdl-score (gt (dhdl-field-int out "prepare_ms=") 0) 32))))
