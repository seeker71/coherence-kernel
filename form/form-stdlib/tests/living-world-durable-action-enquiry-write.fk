; First process: persist one current unresolved question and four plural stances.
; Verdict 32767 proves fifteen question, optionality, no-action, and carrier bits.
; witnessed: 2026-08-08 -> 32767 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-action-enquiry.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk form-stdlib/tests/living-world-action-enquiry-witness.fk form-stdlib/tests/living-world-durable-action-enquiry-witness.fk

(do
    (lwdaeq-clean)
    (let world (lwaew-outsider-world))
    (let questions (lwdaeq-questions world))
    (let question (lwdaeq-only questions))
    (let shape (lwo-emergent-shape question))
    (let field (lwae-question-field shape))
    (let eligible (lwae-question-eligible shape))
    (let evidence (lwae-stance-evidence-for world question))
    (let evidence-items (lwo-field-items evidence))
    (let immediate-evidence (lwdaeq-evidence-immediate evidence-items))
    (let immediate
        (lwae-stance-evidence-stance immediate-evidence))
    (let pending
        (lwae-stance-evidence-stance
            (lwdaeq-evidence-pending evidence-items)))
    (let timed-alternative
        (lwae-stance-evidence-stance
            (lwdaeq-evidence-timed-alternative evidence-items)))
    (let expired-nothing
        (lwae-stance-evidence-stance
            (lwdaeq-evidence-expired-nothing evidence-items)))
    (let stack
        (lwlc-declaration-stack (lwae-stance-declaration pending)))
    (let image (lwcn-image world))
    (let saved (lwdaeq-save-world world))
    (lwdaeq-sum
        (list
            (if (and (eq (lwo-field-size
                              (lwac-field-candidates field)) 2)
                     (and (eq (lwo-field-size eligible) 2)
                          (and (eq (lwac-open?
                                       (lwac-field-status field)) 1)
                               (node_eq (lwac-field-primary field)
                                   (lwo-none))))) 1 0)
            (if (and (eq (lwo-field-size questions) 1)
                     (eq (lwae-question-steady? world question) 1)) 2 0)
            (if (eq (lwo-field-size evidence) 4) 4 0)
            (if (and (not (node_eq immediate-evidence (lwo-none)))
                     (and (not (node_eq pending (lwo-none)))
                          (and (not (node_eq timed-alternative (lwo-none)))
                               (not (node_eq expired-nothing
                                         (lwo-none)))))) 8 0)
            (if (and (eq (lwo-field-size
                              (lwo-active-attributions-for
                                  world immediate)) 2)
                     (eq (lwo-field-size
                              (lwae-stance-evidence-attributions
                                  immediate-evidence)) 1)) 16 0)
            (if (eq (lwlc-declaration-valid?
                        (lwae-stance-declaration pending)) 1) 32 0)
            (if (and (eq (lwlc-lens?
                              (lwlc-stack-default stack)) 1)
                     (and (eq (len (lwlc-layer-items
                                       (lwlc-stack-layers stack))) 2)
                          (and (eq (lwo-field-size
                                      (lwlc-stack-alternatives stack)) 1)
                               (eq (lwlc-unknown?
                                      (lwlc-stack-unknown stack)) 1)))) 64 0)
            (if (and (eq (lwae-stance-timed? timed-alternative) 1)
                     (eq (lwae-stance-alternative?
                              timed-alternative) 1)) 128 0)
            (if (and (eq (lwae-stance-expired-to-nothing?
                              expired-nothing) 1)
                     (not (node_eq immediate expired-nothing))) 256 0)
            (if (node_eq field
                    (lwac-field-for world (lwacw-focus) 2)) 512 0)
            (if (eq (lwo-field-size
                        (lwdaeq-current-selections world)) 0) 1024 0)
            (if (eq (lwo-field-size
                        (lwdaeq-current-executions world)) 0) 2048 0)
            (if (eq (lwcn-image-valid? image) 1) 4096 0)
            (if (and (eq (lwcd-saved? saved) 1)
                     (node_eq (lwcd-result-image saved) image)) 8192 0)
            (if (and (eq (fs-exists? (lwdaeq-path)) 1)
                     (eq (fs-exists?
                            (lwcd-pending-path (lwdaeq-path))) 0)) 16384 0))))
