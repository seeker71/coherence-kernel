; living-world-recipe-tree-hypothesis-witness.fk -- independently reoffered
; Recipe trials may enter successor hypothesis tissue without answer authority.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk

(let LWRTHW-SOURCE-C (bp "LWRTHW-SOURCE-C"))
(let LWRTHW-SOURCE-D (bp "LWRTHW-SOURCE-D"))
(let LWRTHW-EVIDENCE (bp "LWRTHW-EVIDENCE"))
(let LWRTHW-REASON   (bp "LWRTHW-REASON"))
(let LWRTHW-RESULT   (bp "LWRTHW-RESULT"))

(defn lwrthw-cell (kind) (intern_node kind (empty)))
(defn lwrthw-source-c () (lwrthw-cell LWRTHW-SOURCE-C))
(defn lwrthw-source-d () (lwrthw-cell LWRTHW-SOURCE-D))
(defn lwrthw-evidence () (lwrthw-cell LWRTHW-EVIDENCE))
(defn lwrthw-reason () (lwrthw-cell LWRTHW-REASON))
(defn lwrthw-entry (source payload)
    (lwphw-entry source (lwrthw-evidence) payload))
(defn lwrthw-offer (target recipe)
    (lwhrn-offer target recipe (lwo-none) (lwo-none)
        (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none)
        (lwrthw-evidence)))
(defn lwrthw-one-world (world offer)
    (lwt-receive-stream world
        (list (lwrthw-entry (lwrthw-source-c) offer))))
(defn lwrthw-two-world (world offer)
    (lwt-receive-stream (lwrthw-one-world world offer)
        (list (lwrthw-entry (lwrthw-source-d) offer))))
(defn lwrthw-revoke-first (world offer)
    (lwt-receive-stream world
        (list
            (lwrthw-entry (lwrthw-source-c)
                (lwo-revocation offer (lwrthw-source-c)
                    (lwrthw-reason) (lwrthw-evidence))))))

; children: tree result and current parent cells; revision offer/fields/round;
; successor field/proposal/round; revoked world/field; framebuffer events
(defn lwrthw-result
    (tree-result target tree-candidate recipe base-world offer one-world
     one-field two-world revision-field revision-proposal revision-waiting
     revision-admitted revision-candidate successor-field successor-proposal
     successor-waiting successor-admitted successor-candidate revoked-world
     revoked-successor events)
    (intern_node LWRTHW-RESULT
        (list tree-result target tree-candidate recipe base-world offer one-world
              one-field two-world revision-field revision-proposal
              revision-waiting revision-admitted revision-candidate
              successor-field successor-proposal successor-waiting
              successor-admitted successor-candidate revoked-world
              revoked-successor events)))

(defn lwrthw-run ()
    (do
        (let tree-result (lwrtw-run))
        (let target (nth (node_children tree-result) 1))
        (let tree-candidate (nth (node_children tree-result) 10))
        (let recipe (nth (node_children tree-result) 14))
        (let base-world
            (lwt-round-world (nth (node_children tree-result) 12)))
        (let offer (lwrthw-offer target recipe))
        (let started
            (lcfb-open-stream "living-world-recipe-tree-hypothesis"
                "form-native" "lwrthw-run"
                "independent-trial-to-successor-hypothesis-field"
                "form/form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk"
                79 14))

        (let one-world (lwrthw-one-world base-world offer))
        (let one-field (lwhrn-field-for one-world target 2))
        (let one-frame
            (lcfb-call-stream "living-world-recipe-tree-hypothesis"
                "first-trial-offer" "leave" "form-native" "lwhrn-field-for"
                "sources:1:attempts:0:no-recurrence" 1 started
                "form/form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk"
                89 14))
        (let two-world (lwrthw-two-world base-world offer))
        (let revision-field (lwhrn-field-for two-world target 2))
        (let trial-frame
            (lcfb-call-stream "living-world-recipe-tree-hypothesis"
                "independent-trials" "leave" "form-native" "lwhrn-field-for"
                (lwhrn-progress-target revision-field) 2 started
                "form/form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk"
                98 14))
        (let revision-proposal (lwhrn-proposal-for two-world target 2))
        (let revision-candidate
            (lwt-proposal-candidate revision-proposal))
        (let revision-enter
            (lcfb-call-stream "living-world-recipe-tree-hypothesis"
                "trial-field" "enter" "form-native" "lwhrn-integrate"
                "independent-trial-currentness-and-unanimous-boundary"
                3 started
                "form/form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk"
                108 14))
        (let revision-waiting
            (lwhrn-integrate
                (lwpow-round-for two-world revision-proposal (lwo-none))
                revision-proposal (lwphw-action)))
        (let revision-responded
            (lwpow-respond-all two-world revision-proposal))
        (let revision-admitted
            (lwhrn-integrate
                (lwpow-round-for revision-responded revision-proposal
                    revision-waiting)
                revision-proposal (lwphw-action)))
        (let revision-world (lwt-round-world revision-admitted))
        (let revision-frame
            (lcfb-call-stream "living-world-recipe-tree-hypothesis"
                "trial-field" "leave" "form-native" "lwhrn-integrate"
                (lcfb-cat (list
                    "current:"
                    (int_to_str
                        (lwhrn-integrated-current?
                            revision-world revision-candidate))))
                4 started
                "form/form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk"
                130 14))

        (let successor-enter
            (lcfb-call-stream "living-world-recipe-tree-hypothesis"
                "successor" "enter" "form-native" "lwrth-field-for"
                "source-disjoint-exact-recipe-matching" 5 started
                "form/form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk"
                138 14))
        (let successor-field
            (lwrth-field-for revision-world tree-candidate revision-candidate))
        (let successor-frame
            (lcfb-call-stream "living-world-recipe-tree-hypothesis"
                "successor" "leave" "form-native" "lwrth-field-for"
                (lwrth-progress-target successor-field) 6 started
                "form/form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk"
                147 14))
        (let successor-proposal
            (lwrth-proposal-for revision-world tree-candidate
                revision-candidate))
        (let successor-candidate
            (lwt-proposal-candidate successor-proposal))
        (let proposal-frame
            (lcfb-call-stream "living-world-recipe-tree-hypothesis"
                "successor-proposal" "leave" "form-native"
                "lwrth-proposal-for"
                (lcfb-cat (list
                    "proposal-present:"
                    (int_to_str
                        (not (node_eq successor-proposal (lwo-none))))))
                7 started
                "form/form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk"
                158 14))
        (let waiting-enter
            (lcfb-call-stream "living-world-recipe-tree-hypothesis"
                "pre-response-check" "enter" "form-native"
                "lwrth-integrate" "candidate-currentness" 8 started
                "form/form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk"
                165 14))
        (let successor-waiting
            (lwrth-integrate
                (lwpow-round-for revision-world successor-proposal
                    revision-admitted)
                successor-proposal (lwphw-action)))
        (let waiting-frame
            (lcfb-call-stream "living-world-recipe-tree-hypothesis"
                "pre-response-check" "leave" "form-native"
                "lwrth-integrate"
                (lcfb-cat (list
                    "candidate-active:"
                    (int_to_str
                        (lwo-active?
                            (lwt-round-world successor-waiting)
                            successor-candidate))))
                9 started
                "form/form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk"
                175 14))
        (let successor-responded
            (lwpow-respond-all revision-world successor-proposal))
        (let response-frame
            (lcfb-call-stream "living-world-recipe-tree-hypothesis"
                "responses" "leave" "form-native" "lwpow-respond-all"
                (lcfb-cat (list
                    "proposal-participants:"
                    (int_to_str
                        (lwo-field-size
                            (lwt-proposal-participants
                                successor-proposal)))))
                10 started
                "form/form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk"
                182 14))
        (let admission-enter
            (lcfb-call-stream "living-world-recipe-tree-hypothesis"
                "admission-check" "enter" "form-native" "lwrth-integrate"
                "freshness-and-unanimous-boundary" 11 started
                "form/form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk"
                189 14))
        (let successor-admitted
            (lwrth-integrate
                (lwpow-round-for successor-responded successor-proposal
                    successor-waiting)
                successor-proposal (lwphw-action)))
        (let successor-world (lwt-round-world successor-admitted))
        (let successor-integrated-frame
            (lcfb-call-stream "living-world-recipe-tree-hypothesis"
                "hypothesis-field" "leave" "form-native" "lwrth-integrate"
                (lcfb-cat (list
                    "current:"
                    (int_to_str
                        (lwrth-integrated-current?
                            successor-world successor-candidate))
                    ":recipe-active:"
                    (int_to_str (lwo-active? successor-world recipe))))
                12 started
                "form/form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk"
                180 14))

        (let revoked-world (lwrthw-revoke-first successor-world offer))
        (let revoked-successor
            (lwrth-field-for revoked-world tree-candidate revision-candidate))
        (let revoked-frame
            (lcfb-call-stream "living-world-recipe-tree-hypothesis"
                "revocation" "leave" "form-native" "lwrth-field-for"
                (lcfb-cat (list
                    "revision-current:"
                    (int_to_str
                        (lwhrn-integrated-current?
                            revoked-world revision-candidate))
                    ":successor-current:"
                    (int_to_str
                        (lwrth-candidate-current?
                            revoked-world successor-candidate))
                    ":tree-current:"
                    (int_to_str
                        (lwrt-integrated-current?
                            revoked-world tree-candidate))))
                13 started
                "form/form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk"
                202 14))
        (lwrthw-result tree-result target tree-candidate recipe base-world offer
            one-world one-field two-world revision-field revision-proposal
            revision-waiting revision-admitted revision-candidate successor-field
            successor-proposal successor-waiting successor-admitted
            successor-candidate revoked-world revoked-successor
            (framebuffer-events))))

0
