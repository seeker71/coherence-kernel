; form-rows-bridge-band.bml — a JSON node crosses into Form's rows and back unchanged.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/form-rows-bridge.bml form-stdlib/organ-health.bml
;
; The organ-health readings and the session-learning documents are still JSON nodes. They reach the ledgers as Form rows through
; frb-of-node, and come back through frb-to-node. This band takes nodes of every shape through the whole route (node, Form value,
; row text, Form value, node) and compares the node's own text before and after.
;
; Verdict 7 when every claim lands:
;   1   an object of strings, ints, a precise float, null, nested objects and arrays comes back the same (its text equal)
;   2   keys keep their order, an empty object and an empty array survive, a float stays a float (1.0), a string with quotes,
;       newlines and UTF-8 survives
;   4   a real organ-health reading (oh-reading, with a need, offers and evidence) is the same after the route
section [form.bml] {
 class FormRowsBridgeBand {
  def fbb-bit(ok, bit) = ok ? bit : 0;
  def fbb-through(node) {
   let value = frb-of-node(node);
   let text = frw-emit(value);
   let back = frw-parse(text);
   (String) back[0] == "ok" ? frb-to-node(back[1]) : nothing();
  }
  def fbb-same?(node) {
   let again = fbb-through(node);
   !nothing?(again) && (String) json-emit-precise(again) == (String) json-emit-precise(node);
  }
  def fbb-sample() = json-node-object([json-node-pair("schema", json-node-string("organ-health-v1")), json-node-pair("n", json-node-int(42)), json-node-pair("neg", json-node-int(-7)), json-node-pair("loss", json-precise-float(0.1)), json-node-pair("one", json-precise-float(1.0)), json-node-pair("none", json-node-null()), json-node-pair("list", json-node-array([json-node-int(1), json-node-string("x"), json-node-array([]), json-node-object([])])), json-node-pair("nested", json-node-object([json-node-pair("z", json-node-int(1)), json-node-pair("a", json-node-string("q"))]))]);
  def fbb-awkward() = json-node-object([json-node-pair("text", json-node-string("a \"quote\"\nline two\ttab \\ slash caf" ++ byte_to_str(195) ++ byte_to_str(169))), json-node-pair("empty-object", json-node-object([])), json-node-pair("empty-array", json-node-array([])), json-node-pair("float", json-precise-float(1.0)), json-node-pair("tiny", json-precise-float(0.000001)), json-node-pair("big", json-precise-float(1e21))]);
  def fbb-reading() = oh-reading("native-lora", "flow", "head-projection", json-precise-float(0.0), json-precise-float(0.000003337860107421875), json-node-int(1), [oh-need("faithful-output-projection", json-node-object([oh-n("line", 4)]))], ["continue-gradient", "abstain"], json-node-object([oh-s("scope", "final row")]));
  def fbb-keys-in-order?() {
   let v = frb-of-node(fbb-sample());
   (String) value_str(record_keys(v)) == (String) value_str(["schema", "n", "neg", "loss", "one", "none", "list", "nested"]);
  }
  def fbb-float-kept?() {
   let v = frb-of-node(fbb-awkward());
   (String) value_kind(record_get(v, "float")) == "float" && (String) value_kind(frb-of-node(json-node-int(1))) == "int";
  }
  def fbb-score() {
   fbb-bit(fbb-same?(fbb-sample()), 1)
   + fbb-bit(fbb-same?(fbb-awkward()) && fbb-keys-in-order?() && fbb-float-kept?(), 2)
   + fbb-bit(fbb-same?(fbb-reading()), 4);
  }
 }
 fbb-score();
}
