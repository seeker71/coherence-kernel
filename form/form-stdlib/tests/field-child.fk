; field-child.fk — the other process of field-band: interns one composite -- category
; "field-band" over 40, "two" and 2.5 -- and hands over only its pid and the raw word.
;
; preludes: form/form-stdlib/form-glass-gift-frame.bml

(do
    (let cell (intern_node (intern_trivial_string "field-band") (list (intern_trivial_int 40) (intern_trivial_string "two") 2.5)))
    (let handle (ggf-offer "field-band.child" 4096))
    (let given (node_gift_write handle (list (host_pid) (cell_ref cell) (kernel_stat 4))))
    (let released (ggf-release handle)))
