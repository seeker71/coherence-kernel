; record-hash-band.bml — a record with many keys finds one by a hash of its bytes, and answers as the walk of its rows did.
;
; preludes: form-stdlib/core.fk
;
; fkwu keeps each record's keys in rows; a record that reaches 24 keys builds an open-addressing table over them
; (runtime/fkwu-uni.c, fk_rfind and fk_rappend) so a get, a has and a set cost the key's length, not the record's size. The
; Llama tokenizer holds 128 thousand vocabulary and 280 thousand merge keys: built in the Form-level ordered index they took 41
; seconds at every door start. This band proves the table answers the rows' own answers across the size where it appears, and
; that a record of a hundred thousand keys is built and read in seconds.
;
; Verdict 31 when every claim lands:
;   1   a record of 10, of 24 and of 5000 keys: every key reads its value
;   2   an absent key is absent (record_has) in a record below the threshold, at it, and well above it
;   4   set on an existing key replaces its value and adds no row (the key count is unchanged), below and above the threshold
;   8   keys that share long prefixes and keys of every length from 0 to 40 bytes read apart
;   16  100 thousand keys are set and read back, every one, in under 20 seconds
section [form.bml] {
 class RecordHashBand {
  def rhb-bit(ok, bit) = ok ? bit : 0;
  def rhb-key(i) = "key-" ++ i.str();
  def rhb-fill(r, i, n) = i >= n ? r : rhb-fill(record_set(r, rhb-key(i), i * 3 + 1), i + 1, n);
  def rhb-all?(r, i, n) = i >= n ? 1 : (record_has(r, rhb-key(i)) && record_get(r, rhb-key(i)) == i * 3 + 1) ? rhb-all?(r, i + 1, n) : 0;
  def rhb-built(n) = rhb-fill(record_new(0), 0, n);
  def rhb-absent?(n) = record_has(rhb-built(n), "key-absent") == 0 && record_has(rhb-built(n), rhb-key(n)) == 0 && record_has(rhb-built(n), "") == 0;
  def rhb-count(r) = len(record_keys(r));
  def rhb-replace?(n) {
   let r = rhb-built(n);
   let before = rhb-count(r);
   let again = record_set(r, rhb-key(n / 2), 777);
   record_get(again, rhb-key(n / 2)) == 777 && rhb-count(again) == before && record_get(again, rhb-key(n - 1)) == (n - 1) * 3 + 1;
  }
  def rhb-pad(n) = n <= 0 ? "" : "a" ++ rhb-pad(n - 1);
  def rhb-shape(i) = i < 41 ? rhb-pad(i) : "prefix-" ++ rhb-pad(40) ++ "-" ++ (i - 41).str();
  def rhb-fill-shapes(r, i, n) = i >= n ? r : rhb-fill-shapes(record_set(r, rhb-shape(i), i + 100), i + 1, n);
  def rhb-shapes-read?(r, i, n) = i >= n ? 1 : (record_has(r, rhb-shape(i)) && record_get(r, rhb-shape(i)) == i + 100) ? rhb-shapes-read?(r, i + 1, n) : 0;
  def rhb-big() {
   let t0 = host_monotonic_ms();
   let r = rhb-built(100000);
   let ok = rhb-all?(r, 0, 100000);
   ok == 1 && (host_monotonic_ms() - t0) < 20000;
  }
  def rhb-score() {
   rhb-bit(rhb-all?(rhb-built(10), 0, 10) == 1 && rhb-all?(rhb-built(24), 0, 24) == 1 && rhb-all?(rhb-built(5000), 0, 5000) == 1, 1)
   + rhb-bit(rhb-absent?(10) && rhb-absent?(24) && rhb-absent?(3000), 2)
   + rhb-bit(rhb-replace?(10) && rhb-replace?(200) && rhb-replace?(3000), 4)
   + rhb-bit(rhb-shapes-read?(rhb-fill-shapes(record_new(0), 0, 300), 0, 300) == 1, 8)
   + rhb-bit(rhb-big(), 16);
  }
 }
 rhb-score();
}
