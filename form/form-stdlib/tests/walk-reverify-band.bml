; walk-reverify-band.bml — a closed gap read again does not end the walk's window (host-walk-turns.bml, hw-spent-none-why).
;
; A turn whose band already reads its full (lane_reason already-full) re-read a closed gap: it is no attempt, so the
; window goes on to the next open gap. A turn that tried and spent nothing is still idle, and its window ends.
;
; Expected: 7
; Verdict 7 when every claim lands:
;   1   a re-read closed gap (already-full, band unmoved, 0 local IDs) is not idle
;   2   an option that generated 0 local IDs and moved no band is still idle
;   4   an option that moved its band is not idle
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/host-walk.bml
section [form.bml] {
 class WalkReverifyBand {
  def wrb-why(row) = hw-idle-why-of(parse-json("turn-row", row));
  def wrb-c-reread(ctx) = (String) wrb-why("{\"gap\":\"sort-home\",\"band_before\":31,\"band_after\":31,\"lane\":\"band\",\"lane_reason\":\"already-full\",\"local_generated_ids\":0,\"local_injected_ids\":0,\"wall_ms\":900}") == "";
  def wrb-c-idle(ctx) = (String) wrb-why("{\"gap\":\"g\",\"band_before\":6,\"band_after\":6,\"lane\":\"lane-exit=0\",\"lane_reason\":\"check-budget-exhausted\",\"local_generated_ids\":0,\"local_injected_ids\":0,\"wall_ms\":900}") != "";
  def wrb-c-moved(ctx) = (String) wrb-why("{\"gap\":\"g\",\"band_before\":6,\"band_after\":7,\"lane\":\"lane-exit=0\",\"lane_reason\":\"complete\",\"local_generated_ids\":300,\"local_injected_ids\":200,\"wall_ms\":90000}") == "";
 }
 live-claims("walk-reverify-band", 0, [["reread", 1, 1, wrb-c-reread], ["idle", 2, 1, wrb-c-idle], ["moved", 4, 1, wrb-c-moved]]);
}
