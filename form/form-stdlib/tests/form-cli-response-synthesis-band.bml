// Pure admission and answer counterexamples; no provider or living writes.
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 class FormResponseSynthesisBand {
  def frsyb-assert(name,value) = if value then 1 else form_error(name);
  def frsyb-request() = parse-json("request","{\"mode\":\"review\",\"evaluation\":1,\"goal\":\"Return value from value.json in a JSON report.\",\"documents\":[{\"id\":\"value\",\"path\":\"value.json\",\"text\":\"{\\\"value\\\":7}\"}],\"writable\":[],\"checks\":[{\"tool\":\"jq\",\"arguments\":[\".value\",\"value.json\"],\"stdout\":\"7\\n\"}],\"report_checks\":[{\"tool\":\"jq\",\"arguments\":[\".value\"],\"stdout\":\"7\\n\"}]}");
  def frsyb-manifest(request) = json-node-object(list(nsm-s("session","synthesis-test"),json-node-pair("cases",json-node-array(list(json-node-object(list(nsm-s("id","one"),json-node-pair("request",request)))))),json-node-pair("provider",parse-json("provider","{\"allowed\":true,\"interface\":\"codex-exec\",\"max_processes\":1,\"seconds\":60}"))));
  def frsyb-passed(manifest,answer) = eq(nsm-num(frsy-check(manifest,answer),"assertions_passed"),1);
 }
 let request = frsyb-request();
 let manifest = frsyb-manifest(request);
 let good = "{\"results\":[{\"id\":\"one\",\"report\":{\"value\":7}}]}";
 frsyb-assert("help has no execution",str_eq(frsy-command("help"),frsy-help()));
 frsyb-assert("empty argument is help",str_eq(frsy-command("  "),frsy-help()));
 frsyb-assert("empty file argument refuses before execution",str_eq(fcap-string(parse-json("empty-file",frsy-command("@")),"status"),"synthesis-manifest-file-unavailable-or-oversized"));
 frsyb-assert("malformed inline manifest refuses before execution",str_eq(fcap-string(parse-json("bad-json",frsy-command("{")),"status"),"invalid-or-oversized-synthesis-manifest"));
 frsyb-assert("inline manifest preserves provider permission",str_eq(fcap-string(parse-json("no-provider",frsy-command(json-emit(oh-set(manifest,"provider",json-node-null())))),"status"),"requires-readonly-evaluations-and-one-explicit-provider-process"));
 frsyb-assert("valid explicit read-only synthesis",frsy-valid(manifest));
 frsyb-assert("permission absent",not(frsy-valid(oh-set(manifest,"provider",json-node-null()))));
 frsyb-assert("explicit progress-aware supervision",frsy-valid(oh-set(manifest,"provider",oh-set(json-object-get(manifest,"provider"),"seconds",json-node-int(0)))));
 frsyb-assert("permission numeric is not true",not(frsy-valid(oh-set(manifest,"provider",oh-set(json-object-get(manifest,"provider"),"allowed",json-node-int(1))))));
 frsyb-assert("one process only",not(frsy-valid(oh-set(manifest,"provider",oh-set(json-object-get(manifest,"provider"),"max_processes",json-node-int(2))))));
 frsyb-assert("no training",not(frsy-valid(frsyb-manifest(oh-set(request,"evaluation",json-node-int(0))))));
 frsyb-assert("no code execution",not(frsy-valid(frsyb-manifest(oh-set(request,"mode",json-node-string("code"))))));
 frsyb-assert("no writable source",not(frsy-valid(frsyb-manifest(oh-set(request,"writable",json-node-array(list(json-node-string("value.json"))))))));
 frsyb-assert("duplicate task ids",not(frsy-valid(oh-set(manifest,"cases",json-node-array(append(node_children(json-object-get(manifest,"cases")),node_children(json-object-get(manifest,"cases"))))))));
 frsyb-assert("complete result passes",frsyb-passed(manifest,good));
 frsyb-assert("wrong result fails",not(frsyb-passed(manifest,"{\"results\":[{\"id\":\"one\",\"report\":{\"value\":8}}]}")));
 frsyb-assert("missing result fails",not(frsyb-passed(manifest,"{\"results\":[]}")));
 frsyb-assert("renamed result fails",not(frsyb-passed(manifest,"{\"results\":[{\"id\":\"two\",\"report\":{\"value\":7}}]}")));
 frsyb-assert("extra result fails",not(frsyb-passed(manifest,"{\"results\":[{\"id\":\"one\",\"report\":{\"value\":7}},{\"id\":\"two\",\"report\":{\"value\":7}}]}")));
 frsyb-assert("nonobject report fails",not(frsyb-passed(manifest,"{\"results\":[{\"id\":\"one\",\"report\":\"value is seven\"}]}")));
 frsyb-assert("malformed JSON fails",not(frsyb-passed(manifest,"unfinished")));
 let changed = oh-set(request,"documents",parse-json("changed","[{\"id\":\"value\",\"path\":\"value.json\",\"text\":\"{\\\"value\\\":8}\"}]"));
 frsyb-assert("source failure blocks admission",str_eq(fcap-string(frsy-run(frsyb-manifest(changed)),"status"),"source-check-failed"));
 frsyb-assert("sources are rechecked",not(frsyb-passed(frsyb-manifest(changed),good)));
 let sentinel = oh-set(request,"report_checks",parse-json("sentinel","[{\"tool\":\"jq\",\"arguments\":[\".value\"],\"stdout\":\"expected-only-sentinel\\n\"}]"));
 frsyb-assert("expected assertions excluded from prompt",lt(str_find(frsy-prompt(frsyb-manifest(sentinel)),"expected-only-sentinel",0),0));
 frsyb-assert("message-only execution accepted",frsy-no-tools(list("{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\"}}")));
 frsyb-assert("tool event detected",not(frsy-no-tools(list("{\"type\":\"item.completed\",\"item\":{\"type\":\"command_execution\"}}"))));
 frsyb-assert("semantic quality remains unknown",node_eq(json-object-get(head(node_children(json-object-get(frsy-check(manifest,good),"cases"))),"semantic_quality"),json-node-null()));
 print(list("synthesis-boundaries",26));
 1;
}
