; Form tensor recipes on native Metal. Behavior and refusals travel together.
; preludes: form-stdlib/native-tensor.bml
; Verdict 63.
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk

(do
    (defn mkb-score (ok bit) (if ok bit 0))
    (defn mkb-has (hay needle) (if (lt (str_find hay needle 0) 0) 0 1))
    (defn mkb-live? () (mkb-has (nt-status) "metal_linked=true"))
    (defn mkb-rep (b n acc) (if (le n 0) acc (mkb-rep b (sub n 1) (str_concat acc (byte_to_str b)))))
    (defn mkb-q6path () "/tmp/fk-native-tensor-q6k-band-fixture.bin")
    (defn mkb-q4path () "/tmp/fk-native-tensor-q4k-band-fixture.bin")
    (defn mkb-q6 ()
        (str_concat (mkb-rep 0 192 "")
        (str_concat (mkb-rep 1 16 "")
        (str_concat (byte_to_str 0) (byte_to_str 60)))))
    (defn mkb-q4-zero ()
        (str_concat (byte_to_str 0) (str_concat (byte_to_str 60)
        (str_concat (byte_to_str 0) (str_concat (byte_to_str 60)
        (str_concat (mkb-rep 0 12 "") (mkb-rep 0 128 ""))))))
    )
    (defn mkb-q4-min1 ()
        (str_concat (byte_to_str 0) (str_concat (byte_to_str 60)
        (str_concat (byte_to_str 0) (str_concat (byte_to_str 60)
        (str_concat (mkb-rep 0 4 "")
        (str_concat (mkb-rep 1 4 "")
        (str_concat (mkb-rep 17 4 "")
                    (mkb-rep 0 128 ""))))))))
    )
    (defn mkb-prog (tag path off r c tail)
        (str_concat tag (str_concat " " (str_concat path
        (str_concat " " (str_concat (int_to_str off)
        (str_concat " " (str_concat (int_to_str r)
        (str_concat " " (str_concat (int_to_str c) (str_concat " " (str_concat tail " i32"))))))))))))
    (defn native-tensor-kquant-band ()
        (do
    (let w6 (fs-write-text (mkb-q6path) (mkb-q6)))
    (let w4 (fs-write-text (mkb-q4path) (str_concat (mkb-q4-zero) (mkb-q4-min1))))
    (let c0 (mkb-score (and (eq w6 210) (and (eq w4 288) (eq (mkb-live?) 1))) 1))
    (let c1 (mkb-score (if (eq (mkb-live?) 1)
                           (eq (nt-eval (mkb-prog "q6k" (mkb-q6path) 0 1 256 "sum")) (sub 0 8192)) 0) 2))
    (let c2 (mkb-score (if (eq (mkb-live?) 1)
                           (eq (nt-eval (mkb-prog "q4k" (mkb-q4path) 0 1 256 "sum")) 0) 0) 4))
    (let c3 (mkb-score (if (eq (mkb-live?) 1)
                           (eq (nt-eval (mkb-prog "q4k" (mkb-q4path) 144 1 256 "sum")) (sub 0 256)) 0) 8))
    (let c4 (mkb-score (if (eq (mkb-live?) 1)
                           (nt-refused (mkb-prog "q6k" (mkb-q6path) 0 1 128 "sum") "q6k shape needs whole quant blocks") 0) 16))
    (let c5 (mkb-score (if (eq (mkb-live?) 1)
                           (nt-refused (mkb-prog "q6k" (mkb-q6path) 0 1 2560 "sum") "q6k file is shorter than the shape asked for") 0) 32))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
    )
    (native-tensor-kquant-band))
