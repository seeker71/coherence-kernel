; living-world-recipe-tree-prospective-band.fk -- 31 independent checks for
; identity-clean, source-disjoint successor re-enquiry and local revocation.
; target: 2147483647
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk

(defn lwrteb-bit (ok bit) (if ok bit 0))

(defn lwrteb-run ()
    (do
        (let result (lwrtew-run))
        (let target (nth (node_children result) 1))
        (let successor (nth (node_children result) 2))
        (let suite (nth (node_children result) 3))
        (let one-world (nth (node_children result) 4))
        (let one-comparison (nth (node_children result) 5))
        (let two-world (nth (node_children result) 6))
        (let incumbent (nth (node_children result) 7))
        (let successor-evaluation (nth (node_children result) 8))
        (let comparison (nth (node_children result) 9))
        (let revoked-world (nth (node_children result) 10))
        (let revoked-comparison (nth (node_children result) 11))
        (let suite-sources (nth (node_children result) 12))
        (let events (nth (node_children result) 13))
        (let incumbent-metrics (lwps-evaluation-metrics incumbent))
        (let successor-metrics
            (lwps-evaluation-metrics successor-evaluation))
        (let delta
            (lwps-delta-values (lwps-comparison-delta comparison)))
        (let successor-field (lwo-emergent-shape successor))
        (let match
            (head (lwo-field-items
                    (lwrth-field-matches successor-field))))
        (let recipe (lwrth-match-recipe match))
        (let first-case (head (lwo-field-items (lwrtew-cases))))
        (sum (list
            (lwrteb-bit
                (eq (lwrth-integrated-current? two-world successor) 1) 1)
            (lwrteb-bit (eq (lwo-active? two-world recipe) 0) 2)
            (lwrteb-bit (eq (lwps-suite-shape-valid? suite) 1) 4)
            (lwrteb-bit
                (eq (lwps-split-shape-valid?
                        (lwps-suite-split suite)) 1) 8)
            (lwrteb-bit
                (eq (lwps-suite-current? one-world suite 2) 0) 16)
            (lwrteb-bit
                (node_eq one-comparison (lwo-none)) 32)
            (lwrteb-bit
                (eq (lwps-suite-current? two-world suite 2) 1) 64)
            (lwrteb-bit (eq (lwo-field-size suite-sources) 2) 128)
            (lwrteb-bit
                (eq (lwrtep-source-clean? two-world successor suite 2) 1)
                256)
            (lwrteb-bit
                (eq (lwrtep-identity-clean? successor suite) 1) 512)
            (lwrteb-bit
                (eq (lwo-field-size (lwrtep-retained-bindings target)) 3)
                1024)
            (lwrteb-bit
                (eq (lwo-field-size
                        (lwps-split-prospective
                            (lwps-suite-split suite))) 5) 2048)
            (lwrteb-bit (eq (lwps-evaluation? incumbent) 1) 4096)
            (lwrteb-bit
                (eq (lwps-evaluation? successor-evaluation) 1) 8192)
            (lwrteb-bit
                (node_eq (lwps-evaluation-dataset incumbent)
                    (lwps-evaluation-dataset successor-evaluation)) 16384)
            (lwrteb-bit
                (node_eq (lwps-evaluation-split incumbent)
                    (lwps-evaluation-split successor-evaluation)) 32768)
            (lwrteb-bit
                (node_eq (lwps-evaluation-contract incumbent)
                    (lwps-evaluation-contract successor-evaluation)) 65536)
            (lwrteb-bit
                (eq (lwps-comparison-admissible comparison) 1) 131072)
            (lwrteb-bit
                (eq (lwps-comparison-repeated comparison) 0) 262144)
            (lwrteb-bit
                (eq (lwps-metrics-value incumbent-metrics 0) 5) 524288)
            (lwrteb-bit
                (eq (lwps-metrics-value incumbent-metrics 1) 3) 1048576)
            (lwrteb-bit
                (eq (lwps-metrics-value incumbent-metrics 2) 0) 2097152)
            (lwrteb-bit
                (and (eq (lwps-metrics-value incumbent-metrics 3) 2)
                     (eq (lwps-metrics-value incumbent-metrics 4) 1))
                4194304)
            (lwrteb-bit
                (eq (lwps-metrics-value successor-metrics 0) 5) 8388608)
            (lwrteb-bit
                (eq (lwps-metrics-value successor-metrics 1) 3) 16777216)
            (lwrteb-bit
                (eq (lwps-metrics-value successor-metrics 2) 2) 33554432)
            (lwrteb-bit
                (eq (lwps-metrics-value successor-metrics 3) 0) 67108864)
            (lwrteb-bit
                (eq (lwps-metrics-value successor-metrics 4) 1) 134217728)
            (lwrteb-bit
                (and (eq (nth delta 2) 2)
                     (and (eq (nth delta 3) (sub 0 2))
                          (eq (nth delta 4) 0))) 268435456)
            (lwrteb-bit
                (and (eq (lwps-metrics-value successor-metrics 6) 2)
                     (and (eq (lwps-metrics-value successor-metrics 7) 1)
                          (eq (lwps-metrics-value successor-metrics 8) 1)))
                536870912)
            (lwrteb-bit
                (and (eq (lwps-suite-current? revoked-world suite 2) 0)
                     (and (node_eq revoked-comparison (lwo-none))
                          (and (eq (lwrth-integrated-current?
                                    revoked-world successor) 1)
                               (and (eq (lwo-member?
                                        (lwo-field-items
                                            (lwo-world-cells revoked-world))
                                        first-case) 1)
                                    (eq (len events) 9)))))
                1073741824)))))

(lwrteb-run)
