; counted-axis-band.fk — zero is present; a missing field is absent.
; Verdict 1
; preludes: form/form-stdlib/counted-axis.bml
(do
    (let zero (car-read 1 0))
    (let missing (car-read 0 5))
    (let held (car-read 1 5))
    (if (and (eq (nth zero 0) 1)
          (and (eq (nth zero 1) 0)
            (and (eq (nth missing 0) 0)
              (and (eq (nth held 0) 1) (eq (nth held 1) 5))))) 1 0))
