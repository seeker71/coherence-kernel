; str-eq-field-child.fk -- the other process of loop-lane-str-eq-field-band: interns one trivial string and
; hands its pid and cell ref into a gift frame, then stays alive so the band can map this store and read the
; string where it lives (a FIELD string), to test the loop lane's str_eq field-string guard across the carrier.
;
; preludes: form/form-stdlib/form-glass-gift-frame.bml
(do
    (let s (intern_trivial_string "loop-lane-str-eq-field"))
    (let handle (ggf-offer "loop-lane-str-eq-field.child" 4096))
    (let given (node_gift_write handle (list (host_pid) (cell_ref s))))
    (let released (ggf-release handle))
    (host_sleep_ms 6000))
