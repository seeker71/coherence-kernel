; hw-conflict-band.fk — hw-conflicted? requires a named conflict, and hw-held-turns names what was found. 5 bits -> 31.
; A gap in learn/native-turn-queue.jsonl: the native code lane is asked to turn it green.
; Every claim asks for a value no stub gives: a stub answering (nothing) or its first argument reads 0.
; Verdict 31
; preludes: form-stdlib/core.fk form-stdlib/bml/host-walk.bml
(do
    (defn hcb-bit (ok n) (if ok n 0))
    (defn hcb-nl () (byte_to_str 10))
    (defn hcb-true? (x) (or (eq x true) (eq x 1)))
    (defn hcb-false? (x) (or (eq x false) (eq x 0)))
    (defn hcb-str? (x) (str_eq (value_kind x) "string"))
    (defn hcb-contains? (s pat) (ge (str_find s pat 0) 0))
    (let named (hcb-true? (hw-conflicted? (str_concat "conflict: a.fk b.fk" (str_concat (hcb-nl) "sync=1")))))
    (let empty (hcb-false? (hw-conflicted? (str_concat "conflict:" (str_concat (hcb-nl) "sync=1")))))
    (let ws (hcb-false? (hw-conflicted? (str_concat "conflict:   " (str_concat (hcb-nl) "sync=1")))))
    (let refused (hcb-false? (hw-conflicted? (str_concat "fatal: no rebase in progress" (str_concat (hcb-nl) "sync=1")))))
    (let held (do
        (let r (hw-held-turns (str_concat "conflict: a.fk" (str_concat (hcb-nl) "sync=1"))))
        (let k (value_kind r))
        (if (str_eq k "int")
            (if (eq r 0)
                (hcb-contains? (str_concat "[walk] no turn starts: rebase conflict (" (str_concat (str_concat "conflict: a.fk" (hcb-nl)) "sync=1)")) "rebase conflict")
                false)
            false)))
    (add (hcb-bit named 1) (add (hcb-bit empty 2) (add (hcb-bit ws 4) (add (hcb-bit refused 8) (hcb-bit held 16))))))
