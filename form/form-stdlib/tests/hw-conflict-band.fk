; hw-conflict-band.fk — hw-conflicted? names a conflict only when a file follows the marker, and hw-held-turns names what it found. 5 bits -> 31.
; A gap in learn/native-turn-queue.jsonl: the native code lane is asked to turn it green.
; Every claim asks for a value no stub gives: a stub answering (nothing) or its first argument reads 0.
; Verdict 31
; preludes: form-stdlib/core.fk form-stdlib/bml/host-walk.bml
(do
    (defn hcb-bit (ok n) (if ok n 0))
    (defn hcb-nl () (byte_to_str 10))
    (defn hcb-true? (x) (eq x 1))
    (defn hcb-false? (x) (eq x 0))
    (defn hcb-int? (x) (str_eq (value_kind x) "int"))
    (defn hcb-has? (s pat) (ge (str_find s pat 0) 0))
    ; claim 1: a named conflict (file after "conflict:") is a conflict
    (let named (hcb-true? (hw-conflicted? (str_concat "conflict: a.fk b.fk" (str_concat (hcb-nl) "sync=1")))))
    ; claim 2: a bare "conflict:" with no file is not a conflict
    (let bare (hcb-false? (hw-conflicted? (str_concat "conflict:" (str_concat (hcb-nl) "sync=1")))))
    ; claim 3: a "conflict:" with only whitespace after it is not a conflict
    (let ws (hcb-false? (hw-conflicted? (str_concat "conflict:   " (str_concat (hcb-nl) "sync=1")))))
    ; claim 4: no "conflict:" at all is not a conflict
    (let none (hcb-false? (hw-conflicted? (str_concat "rebase-refused: dirty" (str_concat (hcb-nl) "sync=1")))))
    ; claim 5: hw-held-turns answers 0 for a named conflict and its [walk] line names the files
    (let held-named (and (hcb-int? (hw-held-turns (str_concat "conflict: a.fk b.fk" (str_concat (hcb-nl) "sync=1"))))
                  (and (eq (hw-held-turns (str_concat "conflict: a.fk b.fk" (str_concat (hcb-nl) "sync=1"))) 0)
                  (hcb-has? (str_concat "conflict: a.fk b.fk" (str_concat (hcb-nl) "sync=1")) "a.fk"))))
    (add (hcb-bit named 1) (add (hcb-bit bare 2) (add (hcb-bit ws 4) (add (hcb-bit none 8) (hcb-bit held-named 16))))))
