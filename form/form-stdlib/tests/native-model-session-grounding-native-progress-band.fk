; native-model-session-grounding-native-progress-band.fk -- public fixture
; proves that session and index cursors emit same-child progress before their
; outer calls finish.  Frame targets contain only content hashes and counters.
; preludes: form-stdlib/native-model-session-grounding-native-discovery.fk form-stdlib/native-model-session-grounding-native-minimize.fk

(do
    (defn nmsgnpb-score (condition bit) (if condition bit 0))
    (defn nmsgnpb-field (frame index)
        (node_value (nth (node_children frame) index)))
    (defn nmsgnpb-repeat (text remaining acc)
        (if (le remaining 0) acc
            (nmsgnpb-repeat text (sub remaining 1)
                (str_concat acc text))))
    (defn native-model-session-grounding-native-progress-band ()
        (do
            (let root
                (fs-path-join (fs-temp-dir)
                    (str_concat "native-session-progress-band-"
                        (int_to_str (now_unix_ms)))))
            (let made (fs-mkdir root))
            (let session-path (fs-path-join root "session.jsonl"))
            (let index-path (fs-path-join root "index.jsonl"))
            (let source-path (fs-path-join root "source.fk"))
            (let metadata
                "{\"timestamp\":\"2026-08-09T00:00:00Z\",\"cwd\":\"/fixture/coherence-kernel\",\"parent_thread_id\":\"\"}\n")
            (let noop
                "{\"type\":\"event_msg\",\"payload\":{\"type\":\"noop\"}}\n")
            (let user
                "{\"timestamp\":\"2026-08-09T00:00:01Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"public fixture inquiry\"}}\n")
            (let done
                "{\"timestamp\":\"2026-08-09T00:00:02Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"task_complete\",\"last_agent_message\":\"cites source.fk\"}}\n")
            (let session-text
                (nmsgn-cat (list metadata (nmsgnpb-repeat noop 64 "")
                    user done)))
            (let index-row
                "{\"source_path\":\"source.fk\",\"snippet\":\"public fixture source\"}\n")
            (let index-text (nmsgnpb-repeat index-row 64 ""))
            (let wrote-session (fs-write-text session-path session-text))
            (let wrote-index (fs-write-text index-path index-text))
            (let wrote-source (fs-write-text source-path "(do 0)\n"))
            (let started
                (lcfb-open-stream "native-session-progress-band" "form-native"
                    "bounded-cursors" "public-fixture"
                    "form/form-stdlib/tests/native-model-session-grounding-native-progress-band.fk"
                    40 17))
            (let session
                (nmsgn-session session-path "2026-08-09T00:00:00Z"
                    (fs-stat-mtime session-path)))
            (let pairs
                (nmsgn-scan-sessions-loop (list session) (nmsgn-empty-pairs)
                    started 0))
            (let index-state
                (nmsgn-index-scan root
                    index-path (nmsgn-pairs-latest-completion pairs) 4 started))
            (let events (framebuffer-events))
            (let frames (len events))
            (let row-read (nth events 2))
            (let row-decode (nth events 3))
            (let row-advance (nth events 4))
            (let index-progress (nth events (sub frames 1)))
            (let row-target (nmsgnpb-field row-read 6))
            (let cleaned (fs-remove-tree root))
            (sum (list
                (nmsgnpb-score (eq (nmsgn-pairs-completed pairs) 1) 1)
                (nmsgnpb-score
                    (str_eq (nmsgn-pairs-latest-query pairs)
                        "public fixture inquiry") 2)
                (nmsgnpb-score
                    (str_eq (nmsgn-pairs-latest-completion pairs)
                        "cites source.fk") 4)
                (nmsgnpb-score (eq (nmsgn-index-valid index-state) 64) 8)
                (nmsgnpb-score (eq (len (nmsgn-index-cited index-state)) 1) 16)
                (nmsgnpb-score
                    (str_eq (nmsgn-candidate-id
                        (head (nmsgn-index-cited index-state)))
                        "source.fk") 32)
                (nmsgnpb-score (ge frames 5) 64)
                (nmsgnpb-score (eq cleaned 0) 128)
                (nmsgnpb-score (gt wrote-session 0) 256)
                (nmsgnpb-score (gt wrote-index 0) 512)
                ; 201 session cursor cells plus eight index cursor cells and
                ; the opening window: the eight-row cadence is witnessed, not
                ; merely documented.
                (nmsgnpb-score (eq frames 212) 1024)
                (nmsgnpb-score
                    (and (str_eq (nmsgnpb-field row-read 2)
                            "session-pair-row")
                         (and (str_eq (nmsgnpb-field row-decode 2)
                                "session-pair-row")
                              (str_eq (nmsgnpb-field row-advance 2)
                                "session-pair-row"))) 2048)
                (nmsgnpb-score
                    (and (str_eq (nmsgnpb-field row-read 3) "modify")
                         (and (str_eq (nmsgnpb-field row-decode 3) "modify")
                              (and (str_eq (nmsgnpb-field row-advance 3)
                                        "modify")
                                   (str_eq (nmsgnpb-field index-progress 3)
                                        "modify")))) 4096)
                (nmsgnpb-score
                    (and (str_eq (nmsgnpb-field row-read 5) "line-read")
                         (and (str_eq (nmsgnpb-field row-decode 5)
                                "event-decode")
                              (str_eq (nmsgnpb-field row-advance 5)
                                "cursor-advance"))) 8192)
                (nmsgnpb-score
                    (and (ge (str_find row-target ":o" 0) 0)
                         (and (ge (str_find row-target ":n" 0) 0)
                              (and (lt (str_find row-target
                                        "public fixture" 0) 0)
                                   (lt (str_find row-target
                                        "session.jsonl" 0) 0)))) 16384)
                (nmsgnpb-score
                    (and (str_eq (nth (node_source row-read) 0)
                            "form/form-stdlib/native-model-session-grounding-native-minimize.fk")
                         (eq (nth (node_source row-read) 1) 119)) 32768)
                (nmsgnpb-score
                    (and (str_eq (nmsgnpb-field index-progress 2)
                            "public-index-cursor")
                         (str_eq (nmsgnpb-field index-progress 5)
                            "bounded-jsonl-cursor")) 65536)))))
    (native-model-session-grounding-native-progress-band))
