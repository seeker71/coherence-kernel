; living-world-resonance-governance-band.fk -- affected evidence can dissent.
; Verdict 255 proves eight mapping-governance properties.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/tests/living-world-resonance-witness.fk

(do
    (let base (lwrw-base-round 2))
    (let proposal (lwrw-first-proposal base))
    (let candidate (lwrw-candidate proposal))
    (let support-round (lwrw-support-yes-round base proposal))
    (let support-outcome
        (lwt-evaluate-proposal (lwt-round-world support-round) proposal))
    (let dissent-round (lwrw-dissent-round support-round proposal))
    (let dissent-outcome
        (lwt-evaluate-proposal (lwt-round-world dissent-round) proposal))
    (let refused (lwt-integrate dissent-round proposal (lwrw-action)))
    (let unanimous-round
        (lwrw-unanimous-mapping-round dissent-round proposal))
    (let unanimous-outcome
        (lwt-evaluate-proposal (lwt-round-world unanimous-round) proposal))
    (let integrated (lwt-integrate unanimous-round proposal (lwrw-action)))
    (let integrated-world (lwt-round-world integrated))

    (let c1 (if (and (node_eq (lwt-outcome-status support-outcome)
                               (lwt-status-waiting))
                         (and (eq (lwt-outcome-yes support-outcome) 2)
                              (eq (lwt-outcome-missing support-outcome) 1))) 1 0))
    (let c2 (if (and (node_eq (lwt-outcome-status dissent-outcome)
                               (lwt-status-dissented))
                         (eq (lwt-outcome-no dissent-outcome) 1)) 2 0))
    (let c3 (if (eq (lwo-field-size
                         (lwt-outcome-derivations dissent-outcome)) 2) 4 0))
    (let c4 (if (eq (lwo-world-has?
                         (lwt-round-world refused) candidate) 0) 8 0))
    (let old-outcome
        (lwt-evaluate-proposal (lwt-round-world dissent-round) proposal))
    (let c5 (if (node_eq (lwt-outcome-status old-outcome)
                          (lwt-status-dissented)) 16 0))
    (let c6 (if (and (node_eq (lwt-outcome-status unanimous-outcome)
                               (lwt-status-acknowledged))
                         (eq (lwt-outcome-yes unanimous-outcome) 3)) 32 0))
    (let c7 (if (and (eq (lwo-active? integrated-world candidate) 1)
                         (eq (lwo-field-size
                              (lwo-active-attributions-for
                                  integrated-world candidate)) 3)) 64 0))
    (let c8 (if (eq (lwo-field-size
                         (lwr-mapping-counterexamples
                             (lwo-emergent-shape candidate))) 1) 128 0))
    (lwrw-sum (list c1 c2 c3 c4 c5 c6 c7 c8)))
