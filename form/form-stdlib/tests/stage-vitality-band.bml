; stage-vitality-band.bml — the vitality fold over synthetic bus rows, four-way: no door is called.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/stage-vitality.bml
;
; Verdict 16383 when every claim lands:
;   1     overstay appears one microsecond past the key's own p95 and not one before it, nor at it
;   2     stall appears one microsecond past StvStall bounds; at exactly StvStall bounds it is overstay
;   4     two pids running one stage and key in one body for about 0.2 s, closed, read as one lockstep
;         whose stake is their overlap; the children nested inside them stay quiet, one of them through
;         a parent at idx 0, the bus's first record
;   8     the same four stages still open read as one lockstep, the children quiet
;   16    a third pid in another body makes contention, dim, ranked after the lockstep
;   32    three identical closes are a retread with stake (r - 1) x mean dur; a digest changed between
;         them is none
;   64    A B A B with distinct keys and unheld outcomes is a loop of period 2 with its cycle as stake;
;         A A B is none, and A B A B all held is none
;   128   a phase-4 row is died, its stake the open's age
;   256   an open whose pid is no longer alive is died at the clock
;   512   an unlearned key that names an amount takes the kinbound, the stage's p95 per unit times it,
;         above the stage's own p95
;   1024  an open in a stage never closed claims nothing at any age
;   2048  organs order by wane against a hand-computed table (ear 100.0, mouth 20.0, eye 0 ms/s), and
;         the need names the top organ, its wane, its top finding, the stage's name and the key
;   4096  coverage counts the alive pids that spoke in the window
;   8192  a state taken again stays what it was: a later take leaves the earlier state's findings
section [form.bml] {
 class StageVitalityBand {
  def stvb-bit(ok, bit) = ok ? bit : 0;
  def stvb-open(idx, pid, t, stage, key, depth, link, amount, body) = [idx, pid, t, stage, key, 1, depth, link, 0, 0, amount, body, 0];
  def stvb-top(idx, pid, t, stage, key, amount, body) = stvb-open(idx, pid, t, stage, key, 0, 0 - 1, amount, body);
  def stvb-close(idx, pid, t, stage, key, depth, dur, outcome, body, digest) = [idx, pid, t, stage, key, 2, depth, 0, dur, outcome, 0, body, digest];
  def stvb-take(rows, alive) = stv-take(stv-empty(), rows, alive);
  def stvb-kinds(fs, kind) = filter(f => f[0] == kind, fs);
  def stvb-only(fs, kind, stage) = len(stvb-kinds(fs, kind)) == 1 && stvb-kinds(fs, kind)[0][3] == stage;
  // twenty held closes of stage 1 key 1, durations 1000..1019 us, each digest its own
  def stvb-learned() = 0 .. 20 |> map(i => stvb-close(i + 1, 7, 1000000 + i * 10000, 1, 1, 0, 1000 + i, 1, 1, i));

  def stvb-overstay() {
   let s = stvb-take(append(stvb-learned(), [stvb-top(100, 8, 2000000, 1, 1, 0, 1)]), [7, 8]);
   let b = stv-bound(s, 1, 1, 0);
   let past = stv-findings(s, 2000000 + b[0] + 1);
   b[1] == "key" && b[0] == 1019 && len(past) == 1 && past[0][0] == "overstay" && past[0][2] == 1 && past[0][6] == 8
   && nil?(stv-findings(s, 2000000 + b[0] - 1)) && nil?(stv-findings(s, 2000000 + b[0]));
  }
  def stvb-stall() {
   let s = stvb-take(append(stvb-learned(), [stvb-top(100, 8, 2000000, 1, 1, 0, 1)]), [7, 8]);
   let b = stv-bound(s, 1, 1, 0)[0];
   stv-findings(s, 2000000 + 3 * b + 1)[0][0] == "stall" && stv-findings(s, 2000000 + 3 * b)[0][0] == "overstay";
  }
  // pid 11 and pid 12 each run stage 50 key 5 for 0.2 s with stage 51 key 6 nested inside; pid 11's
  // parent is the bus's first record, idx 0
  def stvb-pair-opens() = [stvb-top(0, 11, 1000000, 50, 5, 0, 1), stvb-open(202, 11, 1010000, 51, 6, 1, 0, 0, 1), stvb-top(203, 12, 1050000, 50, 5, 0, 1), stvb-open(204, 12, 1060000, 51, 6, 1, 203, 0, 1)];
  // pid 11 closes last, so its child's parent is read through idx 0
  def stvb-pair-closes() = [stvb-close(205, 12, 1200000, 51, 6, 1, 140000, 1, 1, 1), stvb-close(206, 11, 1210000, 51, 6, 1, 200000, 1, 1, 2), stvb-close(207, 12, 1240000, 50, 5, 0, 190000, 1, 1, 3), stvb-close(208, 11, 1250000, 50, 5, 0, 250000, 1, 1, 4)];
  def stvb-lockstep-closed() {
   let fs = stv-findings(stvb-take(append(stvb-pair-opens(), stvb-pair-closes()), [11, 12]), 1300000);
   stvb-only(fs, "lockstep", 50) && stvb-kinds(fs, "lockstep")[0][2] == 190000 && stvb-kinds(fs, "lockstep")[0][10] == 2 && stvb-kinds(fs, "lockstep")[0][6] == 11;
  }
  def stvb-lockstep-open() {
   let fs = stv-findings(stvb-take(stvb-pair-opens(), [11, 12]), 1300000);
   stvb-only(fs, "lockstep", 50) && stvb-kinds(fs, "lockstep")[0][2] == 250000;
  }
  def stvb-contention() {
   let fs = stv-findings(stvb-take(append(stvb-pair-opens(), [stvb-top(209, 13, 1020000, 50, 5, 0, 2)]), [11, 12, 13]), 1300000);
   let ranked = filter(f => f[0] == "lockstep" || f[0] == "contention", fs);
   stvb-only(fs, "lockstep", 50) && stvb-only(fs, "contention", 50) && len(ranked) == 2 && ranked[0][0] == "lockstep" && ranked[1][1] == 1;
  }
  def stvb-retread() {
   let same = stvb-take([stvb-close(1, 20, 2000000, 60, 7, 0, 1000, 1, 1, 99), stvb-close(2, 20, 2100000, 60, 7, 0, 1200, 1, 1, 99), stvb-close(3, 20, 2200000, 60, 7, 0, 800, 1, 1, 99)], [20]);
   let moved = stvb-take([stvb-close(1, 20, 2000000, 60, 7, 0, 1000, 1, 1, 99), stvb-close(2, 20, 2100000, 60, 7, 0, 1200, 1, 1, 98), stvb-close(3, 20, 2200000, 60, 7, 0, 800, 1, 1, 99)], [20]);
   let fs = stvb-kinds(stv-findings(same, 2300000), "retread");
   len(fs) == 1 && fs[0][2] == 2000 && fs[0][10] == 3 && nil?(stvb-kinds(stv-findings(moved, 2300000), "retread"));
  }
  def stvb-seq(stages, outcome) = 0 .. len(stages) |> map(i => stvb-close(i + 1, 30, 3000000 + i * 50000, stages[i], stages[i] - 60, 0, 1000, outcome, 1, i));
  def stvb-loop() {
   let looped = stvb-kinds(stv-findings(stvb-take(stvb-seq([70, 71, 70, 71], 0), [30]), 3200000), "loop");
   len(looped) == 1 && looped[0][10] == 2 && looped[0][2] == 100000
   && nil?(stvb-kinds(stv-findings(stvb-take(stvb-seq([70, 70, 71], 0), [30]), 3200000), "loop"))
   && nil?(stvb-kinds(stv-findings(stvb-take(stvb-seq([70, 71, 70, 71], 1), [30]), 3200000), "loop"));
  }
  def stvb-died() {
   let fs = stvb-kinds(stv-findings(stvb-take([stvb-top(1, 40, 3000000, 80, 1, 0, 1), [2, 40, 3500000, 80, 1, 4, 0, 1, 0, 0, 0, 1, 0]], [40]), 3600000), "died");
   len(fs) == 1 && fs[0][2] == 500000 && fs[0][6] == 40;
  }
  def stvb-gone() {
   let s = stvb-take([stvb-top(1, 41, 3000000, 81, 1, 0, 1), stvb-close(2, 40, 3400000, 82, 1, 0, 10, 1, 1, 0)], [40]);
   let fs = stvb-kinds(stv-findings(s, 3500000), "died");
   len(fs) == 1 && fs[0][2] == 400000 && fs[0][6] == 41 && nil?(stv-opens(s));
  }
  def stvb-kin() {
   let rows = 0 .. 20 |> map(i => [i + 1, 50, 4000000 + i * 10000, 90, 1000 + i, 2, 0, 0, 1000, 1, 100, 1, i]);
   let s = stvb-take(append(rows, [stvb-top(30, 50, 5000000, 90, 5000, 50, 1)]), [50]);
   let kin = stv-bound(s, 90, 5000, 50);
   kin[1] == "kin" && kin[0] == 500 && stv-bound(s, 90, 5000, 0)[1] == "stage" && stv-bound(s, 90, 5000, 0)[0] == 1000
   && stv-findings(s, 5000000 + 501)[0][0] == "overstay";
  }
  def stvb-unlearned() {
   let s = stvb-take([stvb-top(1, 60, 1000, 95, 1, 0, 1)], [60]);
   stv-bound(s, 95, 1, 0)[1] == "unlearned" && nil?(stv-findings(s, 900000000));
  }
  def stvb-body() {
   let named = stv-named(stv-empty(), [[300, "ear.listen"], [301, "mouth.speak"], [302, "eye.see"]]);
   let rows = [stvb-top(1, 50, 10000000, 300, 7, 0, 1), stvb-top(2, 51, 14800000, 301, 8, 0, 1), stvb-close(3, 52, 15000000, 302, 9, 0, 100, 1, 1, 0),
    [4, 50, 16000000, 300, 7, 4, 0, 1, 0, 0, 0, 1, 0], [5, 51, 16000000, 301, 8, 4, 0, 2, 0, 0, 0, 1, 0]];
   stv-take(named, rows, [50, 51, 52, 53]);
  }
  def stvb-wane() {
   let organs = stv-organs(stvb-body(), 16000000);
   map(o => o[0], organs) == ["ear", "mouth", "eye"] && map(o => o[1], organs) == [100000, 20000, 0]
   && stv-need(stvb-body(), 16000000) == "need=ear 100.0ms/s died ear.listen 7";
  }
  def stvb-coverage() = stv-coverage(stvb-body(), 16000000) == [3, 4];
  def stvb-persistent() {
   let first = stvb-take(stvb-pair-opens(), [11, 12]);
   let before = stv-findings(first, 1300000);
   let later = stv-take(first, stvb-pair-closes(), [11, 12]);
   len(stv-findings(later, 1300000)) == 1 && stv-findings(first, 1300000) == before && len(stv-opens(first)) == 4 && nil?(stv-opens(later));
  }
 }
 stvb-bit(stvb-overstay(), 1) + stvb-bit(stvb-stall(), 2) + stvb-bit(stvb-lockstep-closed(), 4) + stvb-bit(stvb-lockstep-open(), 8)
 + stvb-bit(stvb-contention(), 16) + stvb-bit(stvb-retread(), 32) + stvb-bit(stvb-loop(), 64) + stvb-bit(stvb-died(), 128)
 + stvb-bit(stvb-gone(), 256) + stvb-bit(stvb-kin(), 512) + stvb-bit(stvb-unlearned(), 1024) + stvb-bit(stvb-wane(), 2048)
 + stvb-bit(stvb-coverage(), 4096) + stvb-bit(stvb-persistent(), 8192);
}
