; living-world-relation-recurrence-band.fk -- recurrence may propose, not promote.
; Verdict 32767 proves fifteen ordinary relation-proposal boundary claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/living-world-multilens-plan.fk form-stdlib/living-world-composition-outcome.fk form-stdlib/living-world-composition-voice.fk form-stdlib/living-world-relation-hypothesis.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk form-stdlib/tests/living-world-relational-voice-witness.fk form-stdlib/tests/living-world-multilens-witness.fk form-stdlib/tests/living-world-composition-outcome-witness.fk form-stdlib/tests/living-world-relation-hypothesis-witness.fk form-stdlib/tests/living-world-relation-attestation-witness.fk form-stdlib/tests/living-world-relation-recurrence-witness.fk

(do
    (let first-candidate LWRHR-FIRST-CANDIDATE)
    (let second-candidate LWRHR-SECOND-CANDIDATE)
    (let first-edge (lwo-emergent-shape first-candidate))
    (let second-edge (lwo-emergent-shape second-candidate))
    (let first-evidence (lwrl-edge-evidence first-edge))
    (let second-evidence (lwrl-edge-evidence second-edge))
    (let first-support
        (head (lwo-field-items (lwrl-evidence-supports first-evidence))))
    (let first-participants
        (lwt-proposal-participants LWRHR-FIRST-PROPOSAL))
    (let second-participants
        (lwt-proposal-participants LWRHR-SECOND-PROPOSAL))
    (let targeted-first
        (lwrl-proposal-for
            LWRHA-WORLD LWRHA-OBSERVATION-FIRST 2))
    (let targeted-second
        (lwrl-proposal-for
            LWRHA-WORLD LWRHA-OBSERVATION-SECOND 2))

    (let c1 (if (and (not (node_eq LWRHR-FIRST-PROPOSAL (lwo-none)))
                         (not (node_eq LWRHR-SECOND-PROPOSAL (lwo-none)))) 1 0))
    (let c2 (if (and (eq (lwrl-candidate? first-candidate) 1)
                         (eq (lwrl-candidate? second-candidate) 1)) 2 0))
    (let c3 (if (and (node_eq (lwrl-edge-relation first-edge)
                              (lwrhw-relation-zeta))
                         (node_eq (lwrl-edge-relation second-edge)
                              (lwrhw-relation-zeta))) 4 0))
    (let c4 (if (and (node_eq (lwrl-edge-left first-edge) (lwrvw-left))
                         (node_eq (lwrl-edge-right first-edge)
                              (lwmpw-third))) 8 0))
    (let c5 (if (and (node_eq (lwrl-edge-left second-edge) (lwmpw-third))
                         (node_eq (lwrl-edge-right second-edge)
                              (lwrvw-right))) 16 0))
    (let c6 (if (and (eq (lwrl-support-count first-evidence) 2)
                         (eq (lwrl-support-count second-evidence) 2)) 32 0))
    (let c7 (if (and (eq (lwo-field-size
                              (lwrl-evidence-supports first-evidence)) 1)
                         (eq (lwo-field-size
                              (lwrl-evidence-supports second-evidence)) 1)) 64 0))
    (let c8 (if (and (eq (lwo-field-size first-participants) 2)
                         (eq (lwo-field-size second-participants) 2)) 128 0))
    (let c9 (if (and (eq (lwo-field-has? first-participants
                              (lwcow-source-g)) 0)
                         (eq (lwo-field-has? second-participants
                              (lwcow-source-g)) 0)) 256 0))
    (let c10 (if (and (eq (lwo-field-has? first-participants
                               (lwrhw-source-h)) 1)
                          (eq (lwo-field-has? first-participants
                               (lwrhw-source-i)) 1)) 512 0))
    (let c11 (if (and (node_eq targeted-first LWRHR-FIRST-PROPOSAL)
                          (node_eq targeted-second LWRHR-SECOND-PROPOSAL))
                       1024 0))
    (let c12 (if (and (eq (lwo-emergent-threshold first-candidate) 2)
                          (eq (lwo-emergent-threshold second-candidate) 2))
                       2048 0))
    (let c13 (if (and (node_eq (lwrl-evidence-observation first-support)
                               LWRHA-OBSERVATION-FIRST)
                          (node_eq (lwrl-observation-evidence
                                      LWRHA-OBSERVATION-FIRST)
                                   LWRHA-ATTESTATION-FIRST)) 4096 0))
    (let c14 (if (and (eq (lwo-active? LWRHA-WORLD first-candidate) 0)
                          (eq (lwo-active? LWRHA-WORLD second-candidate) 0))
                       8192 0))
    (let c15 (if (and (eq (lwo-field-size
                               (lwt-round-outcomes LWRHR-ROUND)) 0)
                          (eq (lwrh-integrated-current?
                               LWRHA-WORLD (lwrhw-candidate)) 1)) 16384 0))
    (lwrhw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
