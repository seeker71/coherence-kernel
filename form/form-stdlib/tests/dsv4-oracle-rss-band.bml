; dsv4-oracle-rss-band.bml — the mapped oracle's memory line names this process's resident set from the host's own process table.
; The line (ORACLE_MEMORY ... rss-kib) ran `/bin/ps -o rss= -p PID` through an argv child; it is the resident bytes of the host_processes row now,
; in KiB. Nothing is opened or mapped: the band reads the table and the scripted rows only.
;
;   1     scripted rows: dqm-rss-of takes the resident bytes of the row whose pid matches, in KiB (a row with nothing() for its bytes, a pid not
;         held and an empty table answer nothing())
;   2     this process: dqm-rss-kib is a whole number of KiB between 1 MiB and 1 TiB (the band is an fkwu image the host lists by name)
;
; Expected: 3
; Verdict 3
; REQUIRES: the host door host_processes (a seed door; the sibling kernels carry no host doors)
; preflight-exec: forbidden
; preludes: form/form-stdlib/bml/dsv4-oracle-mapped.bml
section [form.bml] {
 class Dsv4OracleRssBand {
  def drb-c-scripted() {
   let rows = [[11, 10485760, 5, 1, 0, 1], [12, nothing(), nothing(), 2, 0, 1], [13, 2048, 5, 1, 0, 1]];
   let a = dqm-rss-of(rows, 11);
   let b = dqm-rss-of(rows, 12);
   let c = dqm-rss-of(rows, 14);
   let d = dqm-rss-of([], 11);
   let e = dqm-rss-of(rows, 13);
   (Comparable) a == 10240 && nothing?(b) && nothing?(c) && nothing?(d) && (Comparable) e == 2;
  }
  def drb-c-live() {
   let kib = dqm-rss-kib();
   let said = print(["rss-kib", kib]);
   (String) value_kind(kib) == "int" && kib >= 1024 && kib <= 1073741824;
  }
  def drb-run() {
   let b1 = drb-c-scripted() ? 1 : 0;
   let b2 = drb-c-live() ? 2 : 0;
   let verdict = b1 + b2;
   let shown = print(["dsv4-oracle-rss-band", "verdict", verdict]);
   verdict;
  }
 }
 drb-run();
}
