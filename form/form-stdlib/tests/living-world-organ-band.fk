; living-world-organ-band.fk -- first native witness of the ontology-open organ.
;
; Verdict 65535 proves sixteen properties:
;   1     same offered composition is the same content-addressed cell
;   2     a consented offer through its interface is acknowledged and admitted
;   4     repeating the same offer leaves the world at the same NodeID
;   8     a non-offered action is withheld and its payload is not admitted
;   16    a relation is retained as a hypothesis
;   32    a conflicting relation is retained beside it
;   64    contradiction is observable as its own event
;   128   an answer returns both active relations rather than choosing a truth
;   256   the answer carries the original question and a local-only path
;   512   a second source can independently hold the same relation
;   1024  one source revokes only its own attribution; shared relation stays active
;   2048  after both sources revoke, the current answer is first-class nothing
;   4096  the old world still answers: change is reversible by retaining its NodeID
;   8192  a cell cannot revoke another source's attribution
;   16384 silence is an observable event and acknowledges NOTHING
;   32768 emergence depends on offered witnesses/readings/threshold, not a taxonomy
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk

(do
    ; These are test-offered vocabulary cells.  The organ itself knows none of
    ; their names and would behave identically for any supplied blueprint.
    (let observation-kind (bp "TEST-OBSERVATION-KIND"))
    (let action-observe (bp "TEST-ACTION-OBSERVE"))
    (let action-withheld (bp "TEST-ACTION-WITHHELD"))
    (let source-a (intern_trivial_string "source-a"))
    (let source-b (intern_trivial_string "source-b"))
    (let provenance-a (intern_trivial_string "provenance-a"))
    (let provenance-b (intern_trivial_string "provenance-b"))
    (let interface (lwo-interface (list action-observe)))

    ; Recurrence: independently composing the same present shape yields one node.
    (let seed-a (lwo-compose observation-kind
                    (list (intern_trivial_string "shape") (intern_trivial_int 1))))
    (let seed-again (lwo-compose observation-kind
                    (list (intern_trivial_string "shape") (intern_trivial_int 1))))
    (let c1 (if (node_eq seed-a seed-again) 1 0))

    (let accepted-offer
        (lwo-offer source-a interface 1 seed-a provenance-a 1))
    (let t1 (lwo-receive (lwo-empty-world) accepted-offer action-observe))
    (let w1 (lwo-transition-world t1))
    (let c2 (if (and (eq (oac-one? (lwo-transition-ack t1)) 1)
                         (eq (lwo-world-has? w1 seed-a) 1)) 2 0))

    (let t-repeat (lwo-receive w1 accepted-offer action-observe))
    (let w-repeat (lwo-transition-world t-repeat))
    (let c3 (if (node_eq w1 w-repeat) 4 0))

    (let hidden (lwo-compose observation-kind (list (intern_trivial_string "hidden"))))
    (let denied-offer (lwo-offer source-a interface 1 hidden provenance-a 1))
    (let denied (lwo-receive w1 denied-offer action-withheld))
    (let denied-world (lwo-transition-world denied))
    (let c4 (if (and (eq (oac-zero? (lwo-transition-ack denied)) 1)
                         (eq (lwo-world-has? denied-world hidden) 0)) 8 0))

    ; Relations use offered cells for subject, predicate, and object.
    (let subject (lwo-compose (bp "TEST-SUBJECT") (list seed-a)))
    (let predicate (lwo-compose (bp "TEST-PREDICATE") (empty)))
    (let object-one (lwo-compose (bp "TEST-OBJECT") (list (intern_trivial_int 1))))
    (let object-zero (lwo-compose (bp "TEST-OBJECT") (list (intern_trivial_int 0))))
    (let evidence-one (lwo-field (list seed-a)))
    (let evidence-zero (lwo-field (list hidden)))
    (let relation-one
        (lwo-relation subject predicate object-one evidence-one
            (intern_trivial_int 80) (intern_trivial_int 70)
            (intern_trivial_int 20) provenance-a))
    (let relation-zero
        (lwo-relation subject predicate object-zero evidence-zero
            (intern_trivial_int 60) (intern_trivial_int 65)
            (intern_trivial_int 40) provenance-a))

    (let rel-one-offer
        (lwo-offer source-a interface 1 relation-one provenance-a 1))
    (let rel-one-transition (lwo-receive w1 rel-one-offer action-observe))
    (let w2 (lwo-transition-world rel-one-transition))
    (let c5 (if (and (eq (lwo-world-has? w2 relation-one) 1)
                         (eq (lwo-active? w2 relation-one) 1)) 16 0))

    (let rel-zero-offer
        (lwo-offer source-a interface 1 relation-zero provenance-a 1))
    (let rel-zero-transition (lwo-receive w2 rel-zero-offer action-observe))
    (let w3 (lwo-transition-world rel-zero-transition))
    (let c6 (if (and (eq (lwo-active? w3 relation-one) 1)
                         (eq (lwo-active? w3 relation-zero) 1)) 32 0))
    (let conflict (lwo-contradiction relation-one relation-zero))
    (let c7 (if (eq (lwo-field-has? (lwo-world-events w3) conflict) 1) 64 0))

    (let question (lwo-question subject))
    (let answer-before (lwo-answer w3 question))
    (let c8 (if (and (eq (lwo-field-size (lwo-answer-derivations answer-before)) 2)
                         (eq (oac-node? (lwo-answer-ack answer-before)) 1)) 128 0))
    (let c9 (if (and (node_eq (lwo-answer-question answer-before) question)
                         (node_eq (lwo-answer-path answer-before) (lwo-local-path))) 256 0))

    ; Shared field: B offers the identical relation, minting a distinct
    ; attribution while the relation itself remains one content-addressed cell.
    (let rel-b-offer
        (lwo-offer source-b interface 1 relation-one provenance-b 1))
    (let rel-b-transition (lwo-receive w3 rel-b-offer action-observe))
    (let w4 (lwo-transition-world rel-b-transition))
    (let c10 (if (and (eq (lwo-owned-by? w4 relation-one source-a) 1)
                          (eq (lwo-owned-by? w4 relation-one source-b) 1)) 512 0))

    ; A revokes A's attribution.  B's consent keeps the shared relation active.
    (let reason-a (intern_trivial_string "source-a-revokes"))
    (let revoke-a (lwo-revocation relation-one source-a reason-a provenance-a))
    (let revoke-a-offer (lwo-offer source-a interface 1 revoke-a provenance-a 1))
    (let revoke-a-transition (lwo-receive w4 revoke-a-offer action-observe))
    (let w5 (lwo-transition-world revoke-a-transition))
    (let c11 (if (and (eq (oac-one? (lwo-transition-ack revoke-a-transition)) 1)
                          (and (eq (lwo-attribution-revoked? w5 relation-one source-a) 1)
                               (eq (lwo-active? w5 relation-one) 1))) 1024 0))

    ; B revokes B's attribution.  No authority remains for relation-one.
    (let reason-b (intern_trivial_string "source-b-revokes"))
    (let revoke-b (lwo-revocation relation-one source-b reason-b provenance-b))
    (let revoke-b-offer (lwo-offer source-b interface 1 revoke-b provenance-b 1))
    (let revoke-b-transition (lwo-receive w5 revoke-b-offer action-observe))
    (let w6 (lwo-transition-world revoke-b-transition))
    ; relation-zero is still active, so first revoke it through its owner too.
    (let revoke-zero (lwo-revocation relation-zero source-a reason-a provenance-a))
    (let revoke-zero-offer (lwo-offer source-a interface 1 revoke-zero provenance-a 1))
    (let w7 (lwo-transition-world (lwo-receive w6 revoke-zero-offer action-observe)))
    (let answer-after (lwo-answer w7 question))
    (let c12 (if (and (eq (lwo-active? w7 relation-one) 0)
                          (and (eq (lwo-field-size (lwo-answer-derivations answer-after)) 0)
                               (eq (oac-nothing? (lwo-answer-ack answer-after)) 1))) 2048 0))

    ; The prior composition remains a complete reversible state.
    (let c13 (if (eq (lwo-field-size
                          (lwo-answer-derivations (lwo-answer w4 question))) 2) 4096 0))

    ; A cannot revoke B's attribution.
    (let forged (lwo-revocation relation-one source-b reason-a provenance-a))
    (let forged-offer (lwo-offer source-a interface 1 forged provenance-a 1))
    (let forged-transition (lwo-receive w4 forged-offer action-observe))
    (let c14 (if (and (eq (oac-zero? (lwo-transition-ack forged-transition)) 1)
                          (eq (lwo-attribution-revoked?
                                (lwo-transition-world forged-transition)
                                relation-one source-b) 0)) 8192 0))

    (let silent-transition (lwo-silence w7))
    (let silent-world (lwo-transition-world silent-transition))
    (let c15 (if (and (eq (oac-nothing? (lwo-transition-ack silent-transition)) 1)
                          (eq (lwo-field-size (lwo-world-events silent-world))
                              (add (lwo-field-size (lwo-world-events w7)) 1))) 16384 0))

    ; Readiness follows offered evidence and an offered threshold; the organ
    ; neither names the shape nor promotes it by itself.
    (let witnesses-one (lwo-field (list seed-a)))
    (let witnesses-two (lwo-field (list seed-a relation-one)))
    (let candidate-one
        (lwo-emergent subject witnesses-one (intern_trivial_int 90)
            (intern_trivial_int 80) (intern_trivial_int 2) provenance-a))
    (let candidate-two
        (lwo-emergent subject witnesses-two (intern_trivial_int 90)
            (intern_trivial_int 80) (intern_trivial_int 2) provenance-a))
    (let c16 (if (and (eq (lwo-emergent-ready? w4 candidate-one) 0)
                          (eq (lwo-emergent-ready? w4 candidate-two) 1)) 32768 0))

    (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8
        (add c9 (add c10 (add c11 (add c12 (add c13 (add c14 (add c15 c16))))))))))))))))
