; ask-ds4-band.fk — the body-owned ask contract, without loading a model fixture.
;
; Verdict 255:
;   1    the default walk is 40 steps
;   2    the cache margin is 8 and the default cap is 48
;   4    the cap must strictly outrun the walk
;   8    all six honest radius statements remain present
;   16   the sequence and match-order fidelity requirements stay armed
;   32   lane, tokenizer, and prompt membrane names remain explicit
;   64   the ask contract points at the Form-native token-swap cell
;   128  the measured DS4 timeout, bus bandwidth, and default bytes cross from that cell
;
; The swap cell is explicit rather than inherited transitively from ask-ds4.fk:
; the direct source runner resolves transitive preludes, while the fourth-arm
; table builder deliberately reads only this canonical band's own closure.
;
; preludes: form-stdlib/dsv4-token-recipe-swap.fk native/metal/ask-ds4.fk

(do
    (defn adb-score (ok bit) (if ok bit 0))
    (sum (list
        (adb-score (eq (ad-default-steps) 40) 1)
        (adb-score (and (eq (ad-cap-margin) 8) (eq (ad-cap-for 40) 48)) 2)
        (adb-score (and (eq (ad-cap-ok? 40 41) 1) (eq (ad-cap-ok? 40 40) 0)) 4)
        (adb-score (eq (len (ad-radius)) 6) 8)
        (adb-score (and (eq (ad-needs-sequence?) 1) (eq (ad-needs-match-order?) 1)) 16)
        (adb-score (and (str_eq (ad-lane) "native/metal/metal_dsv4_stack.sh")
                    (and (str_eq (ad-tokenizer) "form-stdlib/dsv4-tokenizer-cli.fk")
                         (str_eq (ad-env-prompt) "FORM_DS4_PROMPT"))) 32)
        (adb-score (str_eq (ad-token-swap-cell) "form-stdlib/dsv4-token-recipe-swap.fk") 64)
        (adb-score (and (eq (ad-token-timeout-ms) 34)
                    (and (eq (ad-token-bandwidth-bytes-per-ms) 471000000)
                         (eq (ad-default-token-bytes) 9103000000))) 128))))
