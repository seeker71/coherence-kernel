; living-world-recipe-tree-hypothesis-band.fk -- source-disjoint independent
; trials admit one successor hypothesis field without activating its Recipe.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk

(defn lwrthb-bit (ok bit) (if ok bit 0))

(defn lwrthb-run ()
    (do
        (let result (lwrthw-run))
        (let target (nth (node_children result) 1))
        (let tree-candidate (nth (node_children result) 2))
        (let recipe (nth (node_children result) 3))
        (let base-world (nth (node_children result) 4))
        (let offer (nth (node_children result) 5))
        (let one-field (nth (node_children result) 7))
        (let two-world (nth (node_children result) 8))
        (let revision-field (nth (node_children result) 9))
        (let revision-proposal (nth (node_children result) 10))
        (let revision-waiting (nth (node_children result) 11))
        (let revision-admitted (nth (node_children result) 12))
        (let revision-candidate (nth (node_children result) 13))
        (let successor-field (nth (node_children result) 14))
        (let successor-proposal (nth (node_children result) 15))
        (let successor-waiting (nth (node_children result) 16))
        (let successor-admitted (nth (node_children result) 17))
        (let successor-candidate (nth (node_children result) 18))
        (let revoked-world (nth (node_children result) 19))
        (let revoked-successor (nth (node_children result) 20))
        (let events (nth (node_children result) 21))
        (let revision-world (lwt-round-world revision-admitted))
        (let successor-world (lwt-round-world successor-admitted))
        (let trial
            (head (lwo-field-items (lwhrn-field-viable revision-field))))
        (let match
            (head (lwo-field-items (lwrth-field-matches successor-field))))
        (let tree-sources (lwrth-match-tree-sources match))
        (let revision-sources (lwrth-match-revision-sources match))
        (add
            (lwrthb-bit (eq (lwht-integrated-current?
                                base-world target) 1) 1)
            (add
            (lwrthb-bit (eq (lwrt-integrated-current?
                                base-world tree-candidate) 1) 2)
            (add
            (lwrthb-bit (eq (lwo-field-size
                                (lwhrn-field-candidates one-field)) 0) 4)
            (add
            (lwrthb-bit (eq (lwo-field-size
                                (lwhrn-field-candidates revision-field)) 1) 8)
            (add
            (lwrthb-bit (eq (lwo-field-size
                                (lwhrn-field-viable revision-field)) 1) 16)
            (add
            (lwrthb-bit (eq (lwo-field-size
                                (lwhrn-field-divergent revision-field)) 0) 32)
            (add
            (lwrthb-bit (eq (lwhrn-ready?
                                (lwhrn-field-status revision-field)) 1) 64)
            (add
            (lwrthb-bit (node_eq recipe (lwrth-trial-recipe trial)) 128)
            (add
            (lwrthb-bit (eq (lwo-field-size tree-sources) 2) 256)
            (add
            (lwrthb-bit (eq (lwo-field-size revision-sources) 2) 512)
            (add
            (lwrthb-bit (eq (lwrth-fields-disjoint?
                                tree-sources revision-sources) 1) 1024)
            (add
            (lwrthb-bit (not (node_eq revision-proposal (lwo-none))) 2048)
            (add
            (lwrthb-bit (eq (lwo-active?
                                (lwt-round-world revision-waiting)
                                revision-candidate) 0) 4096)
            (add
            (lwrthb-bit (eq (lwhrn-integrated-current?
                                revision-world revision-candidate) 1) 8192)
            (add
            (lwrthb-bit (eq (lwrth-field? successor-field) 1) 16384)
            (add
            (lwrthb-bit (eq (lwo-field-size
                                (lwrth-field-matches successor-field)) 1) 32768)
            (add
            (lwrthb-bit (eq (lwhrn-ready?
                                (lwrth-field-status successor-field)) 1) 65536)
            (add
            (lwrthb-bit (node_eq recipe (lwrth-match-recipe match)) 131072)
            (add
            (lwrthb-bit (eq (lwo-field-size
                                (lwrth-match-evaluations match))
                                (lwo-field-size
                                    (lwht-tissue-placements
                                        (lwo-emergent-shape target)))) 262144)
            (add
            (lwrthb-bit (not (node_eq successor-proposal (lwo-none))) 524288)
            (add
            (lwrthb-bit (eq (lwo-active?
                                (lwt-round-world successor-waiting)
                                successor-candidate) 0) 1048576)
            (add
            (lwrthb-bit (eq (lwrth-integrated-current?
                                successor-world successor-candidate) 1) 2097152)
            (add
            (lwrthb-bit (eq (lwo-active? successor-world recipe) 0) 4194304)
            (add
            (lwrthb-bit (eq (lwrth-match? match) 1) 8388608)
            (add
            (lwrthb-bit (eq (len events) 14) 16777216)
            (add
            (lwrthb-bit (eq (lwhrn-candidate-current?
                                revoked-world revision-candidate) 0) 33554432)
            (add
            (lwrthb-bit (eq (lwrth-candidate-current?
                                revoked-world successor-candidate) 0) 67108864)
            (add
            (lwrthb-bit (eq (lwrt-integrated-current?
                                revoked-world tree-candidate) 1) 134217728)
            (add
            (lwrthb-bit (node_eq revoked-successor (lwo-none)) 268435456)
            (add
            (lwrthb-bit (eq (lwo-member?
                                (lwo-field-items
                                    (lwo-world-cells revoked-world)) offer) 1)
                                536870912)
            (lwrthb-bit (eq (lwht-integrated-current?
                                revoked-world target) 1) 1073741824)
            ))))))))))))))))))))))))))))))))

(lwrthb-run)
