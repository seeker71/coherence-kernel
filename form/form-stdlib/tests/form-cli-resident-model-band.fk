; form-cli-resident-model-band.fk — the residence law of the standard generate door.
;
; WHAT THIS GATES, and what it deliberately does not.  It gates the LAW a session
; holds a model by: what counts as a residence, when one may answer the next
; sentence, and that every arm hands back what it was given.  It does NOT gate the
; generation itself — that needs the 29 GB sealed artifact and a GPU, and lives in
; a receipt with its measured numbers, not in a band that must run anywhere.
;
; Nothing here releases a handle: the residences below carry stand-in contexts, and
; a release is an effect on a real device.  fcmr-release-ok? is exercised only on
; the empty residence, where the honest answer is "nothing to release, and nothing
; to lie about".
;
; preludes: form-stdlib/form-cli-model-generate.fk
;
; Verdict 255 when the law holds.

(do
    (defn fcrb-score (ok bit) (if ok bit 0))
    (defn fcrb-stub () (list 1 2 3))
    (defn fcrb-res (path maxpos) (fcmr path maxpos (fcrb-stub) (fcrb-stub) "qwen35"))
    (defn form-cli-resident-model-band ()
        (do
    ; an empty residence is not live — a session that holds nothing says so
    (let c0 (fcrb-score (eq (fcmr-live? (fcmr-none)) 0) 1))
    ; a built residence is live, and answers with what it was built from
    (let c1 (fcrb-score (and (eq (fcmr-live? (fcrb-res "/m/a.gguf" 128)) 1)
                             (and (str_eq (fcmr-path (fcrb-res "/m/a.gguf" 128)) "/m/a.gguf")
                                  (eq (fcmr-maxpos (fcrb-res "/m/a.gguf" 128)) 128))) 2))
    ; the same file, within the ceiling it was opened for, may answer the next sentence
    (let c2 (fcrb-score (eq (fcmr-fits? (fcrb-res "/m/a.gguf" 128) "/m/a.gguf" 128) 1) 4))
    ; a different file never fits — a residence is not a general permission
    (let c3 (fcrb-score (eq (fcmr-fits? (fcrb-res "/m/a.gguf" 128) "/m/b.gguf" 8) 0) 8))
    ; a prompt that outgrows the ceiling does not fit: the extent was derived, not chosen
    (let c4 (fcrb-score (eq (fcmr-fits? (fcrb-res "/m/a.gguf" 128) "/m/a.gguf" 129) 0) 16))
    ; nothing held is nothing to release, and that is a clean release, not a refusal
    (let c5 (fcrb-score (eq (fcmr-release-ok? (fcmr-none)) 1) 32))
    ; the door answers a PAIR, and a turn that cannot generate still hands the
    ; session back exactly what it was holding
    (let c6 (fcrb-score
                (and (eq (len (fcmg-generate-resident (fcrb-res "/m/a.gguf" 128) "" "hello" 8)) 2)
                     (str_eq (fcmr-path
                                (nth (fcmg-generate-resident (fcrb-res "/m/a.gguf" 128) "" "hello" 8) 1))
                             "/m/a.gguf")) 64))
    ; an empty prompt is a usage answer, not an admission — and still hands the pair back
    (let c7 (fcrb-score
                (and (str_eq (nth (fcmg-generate-resident (fcmr-none) "/m/a.gguf" "" 8) 0)
                             "usage: generate <prompt>")
                     (eq (fcmr-live? (nth (fcmg-generate-resident (fcmr-none) "/m/a.gguf" "" 8) 1)) 0))
                128))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
    )
    (form-cli-resident-model-band))
