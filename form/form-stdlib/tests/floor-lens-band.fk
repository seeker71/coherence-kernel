; floor-lens-band.fk — the lens's arithmetic, proven without a GPU: a floor is bytes over
; bandwidth, a distance is measured over floor, and a lane faster than a millisecond a pass is
; not measured as zero (the wound that made a 0.64 ms whisper token read as 0 ms).
; Expected: 31
; preludes: form/form-stdlib/floor-lens.bml
(do
    (defn flb-near? (a b) (if (lt (if (gt (sub a b) 0.0) (sub a b) (sub b a)) 0.005) 1 0))
    ; a gigabyte at a thousand gigabytes a second is one millisecond
    (let c1 (if (eq (flb-near? (fl-floor-ms 1000000000 1000.0) 1.0) 1) 1 0))
    ; a tenth of that blob is a tenth of that floor
    (let c2 (if (eq (flb-near? (fl-floor-ms 100000000 1000.0) 0.1) 1) 2 0))
    ; twenty passes in five milliseconds is a quarter of a millisecond each, against a tenth: 2.5x
    (let r (fl-row "probe" 100000000 5 20 1000.0))
    (let c3 (if (eq (flb-near? (fl-measured r) 0.25) 1) 4 0))
    (let c4 (if (eq (flb-near? (fl-distance r) 2.5) 1) 8 0))
    ; the name and the bytes travel unchanged
    (let c5 (if (and (str_eq (fl-name r) "probe") (eq (fl-bytes r) 100000000)) 16 0))
    (print (add c1 (add c2 (add c3 (add c4 c5))))))
