; living-world-grown-voice-band.fk -- recurring experience reaches native text.
; Verdict 32767 proves fifteen learned-symbol voice and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-grown-voice-witness.fk

(do
    (let world (lwgvw-world))
    (let context (lwgvw-context-for world))
    (let context-world (lwcp-context-world context))
    (let proposal (lwgvw-proposal-for world))
    (let candidate (lwt-proposal-candidate proposal))
    (let utterance (lwo-emergent-shape candidate))
    (let sequence (lwnv-utterance-sequence utterance))
    (let symbols (lwnv-sequence-items sequence))
    (let forty (lwgvw-forty-candidate))
    (let forty-symbol (lwo-emergent-shape forty))
    (let evidence (lwnv-symbol-evidence forty-symbol))
    (let waiting
        (lwnv-integrate (lwgvw-round) proposal (lwrew-action)))
    (let integrated (lwgvw-integrated-round))
    (let integrated-world (lwt-round-world integrated))
    (let late (lwgvw-late-world))

    (let c1 (if (and (eq (lwsl-integrated-current?
                              context-world forty) 1)
                         (eq (lwo-active?
                              context-world forty-symbol) 0)) 1 0))
    (let c2 (if (and (eq (lwsl-support-count evidence) 2)
                         (and (eq (lwsl-alternative-count evidence) 1)
                              (and (eq (lwsl-dissent-count evidence) 1)
                                   (eq (lwsl-silence-count evidence) 1)))) 2 0))
    (let c3 (if (and (eq (len symbols) 2)
                         (and (str_eq (lwnv-symbol-surface
                                       (nth symbols 0)) "forty")
                              (str_eq (lwnv-symbol-surface
                                       (nth symbols 1)) "-nine"))) 4 0))
    (let c4 (if (str_eq (lwnv-utterance-surface utterance)
                         "forty-nine") 8 0))
    (let c5 (if (and (node_eq (lwnv-utterance-basis utterance)
                               (lwgvw-basis))
                         (node_eq (lwnv-utterance-referent utterance)
                                  (lwgvw-referent))) 16 0))
    (let c6 (if (and (eq (lwo-field-size
                              (lwnv-utterance-witnesses utterance)) 10)
                         (eq (lwo-field-size
                              (lwt-proposal-participants proposal)) 8)) 32 0))
    (let c7 (if (and (eq (lwcp-context-current?
                              world context) 1)
                         (eq (lwnv-utterance-current?
                              world utterance) 1)) 64 0))
    (let c8 (if (eq (lwo-world-has?
                         (lwt-round-world waiting) candidate) 0) 128 0))
    (let c9 (if (and (eq (lwo-active?
                              integrated-world candidate) 1)
                         (eq (lwo-field-size
                              (lwo-active-attributions-for
                                integrated-world candidate)) 8)) 256 0))
    (let c10 (if (and (eq (lwnv-proposal-current?
                               integrated-world proposal) 1)
                          (str_eq (lwnv-utterance-surface
                                    (lwo-emergent-shape candidate))
                                  "forty-nine")) 512 0))
    ; The late observation is not granted to the old context. Context identity
    ; stays clean, but full-world lifecycle truth still reopens the utterance.
    (let c11 (if (eq (lwcp-context-current? late context) 1) 1024 0))
    (let c12 (if (and (eq (lwsl-candidate-current?
                               late forty) 0)
                          (eq (lwnv-utterance-current?
                               late utterance) 0)) 2048 0))
    (let c13 (if (eq (lwnv-proposal-current?
                          late proposal) 0) 4096 0))
    (let c14 (if (and (eq (lwo-active?
                               context-world
                               (lwslw-forty-support)) 1)
                          (eq (lwo-active?
                               context-world
                               (lwslw-forty-alternative)) 1)) 8192 0))
    (let c15 (if (and (eq (lwo-field-size
                               (lwnv-utterance-alternatives utterance)) 1)
                          (and (eq (lwlc-unknown?
                                    (lwnv-utterance-unknown utterance)) 1)
                               (eq (lwlc-choice-valid?
                                    (lwnv-utterance-choice utterance)) 1)))
                      16384 0))
    (lwgvw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
