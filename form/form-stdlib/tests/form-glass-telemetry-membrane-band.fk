; form-glass-telemetry-membrane-band.fk — effectful filesystem proof.
; Every verdict bit is tied to a named membrane invariant below.
; The filesystem effects are confined to the explicit temporary root.
; Publisher and control paths are derived only after identifier validation.
; Verdict 2097151 includes failed-write refusal and newest-before-bound inventory.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/line-grammar.fk form-stdlib/form-glass-telemetry-membrane.bml

(defn fgtmb-bit (held weight) (if (eq held 1) weight 0))
(defn fgtmb-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))
(defn fgtmb-member (values wanted)
    (if (eq (len values) 0) 0
        (if (str_eq (head values) wanted) 1
            (fgtmb-member (tail values) wanted))))
(defn fgtmb-active-count (samples)
    (if (eq (len samples) 0) 0
        (add (if (str_eq (fgtm-sample-lifecycle (head samples)) "active") 1 0)
             (fgtmb-active-count (tail samples)))))
(defn fgtmb-root () (fs-path-join (fs-temp-dir) "form-glass-telemetry-membrane-band"))
(defn fgtmb-blueprint ()
    (fgtm-sample
        "blueprint.rag-root" (fgtm-absent) "blueprint" "form" "sema"
        "query.knowledge" "retrieve" (fgtm-present 0) (fgtm-absent) "ready"
        (fgtm-present 41) (fgtm-present 40) (fgtm-present 811)
        (fgtm-absent) "pressure-only" "derived-window" "form.cell"
        (list "memory" "query-lane")))
(defn fgtmb-tensor ()
    (fgtm-sample
        "tensor.expert.17" (fgtm-present "model.qwen") "expert-shard"
        "metal" "model.qwen" "reasoning" "moe.route"
        (fgtm-present 4096) (fgtm-present 8192) "active"
        (fgtm-present 9) (fgtm-present 3) (fgtm-present 120)
        (fgtm-present 1262) "policy-ranked" "catalog" "metal.carrier"
        (list "memory" "gpu" "metal")))
(defn fgtmb-model-small ()
    (fgtm-sample
        "model.small" (fgtm-absent) "model" "unified" "model.small"
        "nl.form" "translate" (fgtm-present 2019377376) (fgtm-absent)
        "active" (fgtm-present 8) (fgtm-present 7) (fgtm-present 600)
        (fgtm-absent) "pressure-only" "declared" "model.catalog"
        (list "memory" "model")))

(defn fgtmb-main ()
  (do
    (let snapshot (fgtm-snapshot "organ.alpha" 42 (list (fgtmb-blueprint) (fgtmb-tensor) (fgtmb-model-small))))
    (let wire (fgtm-snapshot-wire snapshot))
    (let parsed (fgtm-parse-snapshot-wire wire))
    (let published (fgtm-publish-snapshot (fgtmb-root) "organ.alpha" 42 (list (fgtmb-blueprint) (fgtmb-tensor) (fgtmb-model-small))))
    (let reading (fgtm-read-current (fgtmb-root) "organ.alpha"))
    (let inventory (fgtm-inventory (fgtmb-root)))
    (let missing (fgtm-read-current (fgtmb-root) "organ.missing"))
    (let offer (fgtm-control-offer "memory" "offer.7" 43 "inspect" (fgtm-present "tensor.expert.17") "derived-window" "glass.monitor"))
    (let offered (fgtm-offer-control (fgtmb-root) offer))
    (let poll (fgtm-poll-control (fgtmb-root) "memory"))
    (let ack (fgtm-control-ack "memory" "offer.7" 44 "applied" "physical-live" "form.cell"))
    (let acked (fgtm-acknowledge-control (fgtmb-root) ack))
    (let ackread (fgtm-read-control-ack (fgtmb-root) "memory"))
    (let invalid-offer (fgtm-control-offer "../memory" "offer.8" 45 "inspect" (fgtm-absent) "declared" "glass.monitor"))
    (let refused (fgtm-offer-control (fgtmb-root) invalid-offer))
    (let failed-write (fgtm-publish-valid-snapshot "/dev/null" "organ.alpha" snapshot))
    (let newest-rows (fgtm-insert-publisher-row (fgtm-publisher-row "new" 99)
        (list (fgtm-publisher-row "old-a" 10) (fgtm-publisher-row "old-b" 9)) 2))
    (let authority (fs-read-text "form/form-stdlib/bml/form-glass-telemetry-membrane.bml"))
    (sum (list
        (fgtmb-bit (and (eq (fgtm-field-present? (fgtm-sample-bytes (fgtmb-blueprint))) 1)
                         (eq (fgtm-field-value (fgtm-sample-bytes (fgtmb-blueprint))) 0)) 1)
        (fgtmb-bit (and (eq (fgtm-field-present? (fgtm-sample-capacity (fgtmb-blueprint))) 0)
                         (not (eq (fgtm-sample-bytes (fgtmb-blueprint)) (fgtm-sample-capacity (fgtmb-blueprint))))) 2)
        (fgtmb-bit (and (eq (fgtm-sample-valid? (fgtmb-blueprint)) 1)
                         (and (eq (fgtm-sample-valid? (fgtmb-tensor)) 1)
                              (and (eq (fgtm-evictability? "policy-ranked") 1)
                                   (eq (fgtm-evictability? "cold-first") 0)))) 4)
        (fgtmb-bit (and (eq (fgtm-channel-id? "memory") 1)
                         (and (eq (fgtm-channel-id? "query-lane.7") 1)
                              (eq (fgtm-channel-id? "../memory") 0))) 8)
        (fgtmb-bit (and (eq (fgtm-channel-id? "Memory") 0)
                         (and (eq (fgtm-channel-id? "memory/") 0)
                              (and (eq (fgtm-channel-id? "memory..gpu") 0)
                                   (and (eq (fgtm-evidence? "physical-live") 1)
                                        (eq (fgtm-evidence? "derived-window") 1))))) 16)
        (fgtmb-bit (and (eq (fgtm-snapshot-valid? parsed) 1)
                         (and (eq (len (fgtm-snapshot-samples parsed)) 3)
                              (eq (fgtm-field-present? (fgtm-sample-capacity (head (fgtm-snapshot-samples parsed)))) 0))) 32)
        (fgtmb-bit (and (str_eq (nth published 1) "published")
                         (eq (fs-exists? (fgtm-snapshot-path (fgtmb-root) "organ.alpha")) 1)) 64)
        (fgtmb-bit (and (str_eq (fgtm-read-state-status reading) "current")
                         (eq (fgtm-field-present? (fgtm-read-state-value reading)) 1)) 128)
        (fgtmb-bit (and (str_eq (nth inventory 2) "current")
                         (eq (fgtmb-member (nth inventory 3) "organ.alpha") 1)) 256)
        (fgtmb-bit (and (str_eq (fgtm-read-state-status missing) "absent")
                         (eq (fgtm-field-present? (fgtm-read-state-value missing)) 0)) 512)
        (fgtmb-bit (and (str_eq (nth offered 1) "offered")
                         (eq (fs-exists? (fgtm-control-inbox-path (fgtmb-root) "memory")) 1)) 1024)
        (fgtmb-bit (and (str_eq (nth poll 2) "offer")
                         (str_eq (fgtm-offer-id (fgtm-field-value (nth poll 3))) "offer.7")) 2048)
        (fgtmb-bit (and (str_eq (nth acked 1) "acknowledged")
                         (str_eq (nth ackread 2) "ack")) 4096)
        (fgtmb-bit (and (str_eq (fgtm-ack-disposition (fgtm-field-value (nth ackread 3))) "applied")
                         (str_eq (fgtm-ack-offer-id (fgtm-field-value (nth ackread 3))) "offer.7")) 8192)
        (fgtmb-bit (and (str_eq (nth refused 1) "refused")
                         (str_eq (nth refused 2) "offer")) 16384)
        (fgtmb-bit (and (eq (len (fgtmb-blueprint)) 19)
                         (and (eq (fgtmb-active-count (fgtm-snapshot-samples parsed)) 2)
                              (and (eq (fgtmb-has wire "Return only") 0)
                                   (eq (fgtmb-has wire "answer=") 0)))) 32768)
        (fgtmb-bit (and (eq (fgtmb-has authority "const String PresenceRule") 1)
                         (and (eq (fgtmb-has authority "const String PrivacyRule") 1)
                              (eq (fgtmb-has authority "explicit caller-provided root") 1))) 65536)
        (fgtmb-bit (and (eq (fgtmb-has authority "MaxSamplesPerPublisher = 512") 1)
                         (and (eq (fgtmb-has authority "MaxChannelsPerSample = 16") 1)
                              (and (eq (fgtmb-has authority "one atomic replacement snapshot") 1)
                                   (eq (fgtmb-has authority "multiple model samples may be active") 1)))) 131072)
        (fgtmb-bit (and (eq (fgtmb-has authority "MaxSnapshotWireBytes = 1048576") 1)
                         (and (eq (fgtmb-has authority "MaxControlWireBytes = 4096") 1)
                              (and (eq (fgtmb-has authority "MaxPublishers = 128") 1)
                                   (eq (fgtmb-has authority "bounded reads precede parsing") 1)))) 262144)
        (fgtmb-bit (and (str_eq (nth failed-write 1) "failed")
                         (eq (fs-exists? "/dev/null/organ.alpha.glass-snapshot") 0)) 524288)
        (fgtmb-bit (and (str_eq (fgtm-publisher-row-name (head newest-rows)) "new")
                         (and (eq (len newest-rows) 2)
                              (eq (fgtmb-has authority "ranked newest-first") 1))) 1048576)))))

(print (fgtmb-main))
