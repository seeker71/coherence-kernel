; living-world-action-selection-band.fk -- recurrence chooses no arbitrary action.
; Verdict 32767 proves fifteen optionality, uniqueness, consent, and staleness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk

(do
    (let world (lwacw-world))
    (let field (lwacw-field-for world))
    (let primary (lwac-field-primary field))
    (let intention (lwac-intention-evidence-intention primary))
    (let proposal (lwacw-selection-proposal-for world))
    (let candidate (lwt-proposal-candidate proposal))
    (let round (lwacw-selection-round-for world (lwo-none)))
    (let waiting
        (lwac-selection-integrate round proposal (lwrew-action)))
    (let integrated (lwacw-selection-integrated-round))
    (let integrated-world (lwt-round-world integrated))
    (let ambiguous-world (lwacw-ambiguous-world))
    (let ambiguous (lwacw-field-for ambiguous-world))
    (let revoked-world (lwacw-revoked-old-world world))
    (let revoked (lwacw-field-for revoked-world))
    (let empty-action-offer
        (lwac-offer (lwacw-focus) (lwo-none)
            (lwrew-declaration) (lwrew-recipe-lens) (lwrew-before)
            (lwo-none) (lwo-empty-field) (lwo-none) (lwo-none)
            (lwo-none) (lwacw-evidence)))

    (let c1 (if (and (eq (lwac-offer-valid? (lwacw-offer-a)) 1)
                         (and (eq (lwac-offer-valid? (lwacw-offer-b)) 1)
                              (eq (lwac-offer-valid?
                                   empty-action-offer) 1))) 1 0))
    (let c2 (if (eq (lwo-field-size
                         (lwac-field-candidates field)) 2) 2 0))
    (let c3 (if (eq (lwac-ready?
                         (lwac-field-status field)) 1) 4 0))
    (let c4 (if (and (node_eq (lwac-intention-action intention)
                               (lwacw-action-a))
                         (node_eq (lwac-intention-prediction intention)
                              (lwacw-wrong-delta))) 8 0))
    (let c5 (if (eq (lwo-field-size
                         (lwac-field-alternatives field)) 3) 16 0))
    (let c6 (if (and (eq (lwo-field-size
                              (lwac-field-unknowns field)) 1)
                         (node_eq (lwac-field-derived-unknown field)
                              (lwo-none))) 32 0))
    (let c7 (if (eq (lwo-field-size
                         (lwac-intention-evidence-witnesses primary)) 2)
                    64 0))
    (let c8 (if (and (eq (lwo-field-size
                              (lwac-field-witnesses field)) 12)
                         (eq (lwo-field-size
                              (lwt-proposal-participants proposal)) 5)) 128 0))
    (let c9 (if (and (not (node_eq proposal (lwo-none)))
                         (eq (lwac-selection-proposal-current?
                              world proposal) 1)) 256 0))
    (let c10 (if (eq (lwo-active?
                          (lwt-round-world waiting) candidate) 0) 512 0))
    (let c11 (if (and (eq (lwo-active?
                               integrated-world candidate) 1)
                          (eq (lwo-field-size
                               (lwo-active-attributions-for
                                 integrated-world candidate)) 5)) 1024 0))
    (let c12 (if (and (eq (lwac-open?
                               (lwac-field-status ambiguous)) 1)
                          (node_eq
                            (lwacw-selection-proposal-for ambiguous-world)
                            (lwo-none))) 2048 0))
    (let c13 (if (and (node_eq (lwac-field-primary ambiguous)
                               (lwo-none))
                          (eq (lwac-selection-candidate-current?
                               ambiguous-world candidate) 0)) 4096 0))
    (let c14 (if (and (eq (lwac-open?
                               (lwac-field-status revoked)) 1)
                          (eq (lwlc-unknown?
                               (lwac-field-derived-unknown revoked)) 1))
                     8192 0))
    (let c15 (if (and (node_eq (lwac-field-path field)
                               (lwo-local-path))
                          (eq (lwac-selection-integrated-current?
                               integrated-world candidate) 1)) 16384 0))
    (lwacw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
