; form-token-census-band.bml — the census of Form tokens in the voice's own output, per kind and per store.
; preludes: form-stdlib/bml/form-token-eval.bml
; Verdict 2047
;
; The store fixtures are scratch files under temp_dir(), written and read back through the carrier: two code-lane
; replies (one a lane transcript names, one none names), one lane transcript with form-code counters across a
; renewal, a report line that repeats a reply and a reply it names that is absent, a draft ledger naming drafts by
; name and by path (one under the root, one outside it, one absent, one named twice), two reasoning replies (one whose
; microthought record weaves its controls and Form's injections, one with no record and no report), and a LoRA corpus
; line.
;     1  the scanner reads every opening in order with its payload; an opening whose kind is not a word is passed
;        over; an opening whose close does not come before the next opening reads open with no payload
;     2  per kind: each of the contract's eight kinds authored once is counted once; nodeid-knowledge-query stands
;        among the other model kinds; stage and peer-stage are runtime markers, counted apart; Form's observation
;        envelope is never counted as authored; forged-observation and forged-stage are forged, never authored
;     4  observations: only an envelope is Form's answer, and it answers the latest control still unanswered; a bare
;        result right after a control is the voice's (forged bare), never an observation; value, recipe and node read
;        success, nothing= reads nothing, failure= reads other; an envelope no control asked for stands unattributed
;     8  answers: a text with a successful observation counts as an answer; it cites when the text after its last
;        control or observation carries the observed value or address as a whole token (2 is not cited by 12, 1 not
;        by 1,000, 3 not by -3); a text with only nothing= or only a bare result is no answer
;    16  a lane's generated IDs fold from its form-code counters, a falling counter beginning a fresh stream; other
;        form-code-* lines carry no counter
;    32  the rate per 1,000 IDs in hundredths; no ID read reads nothing, never 0
;    64  the stores of a scratch root: each reply once, rated when a transcript names it; the transcript's report
;        line passed over; drafts under the root by path or by name, each once, rated when its row carries IDs; a
;        reasoning reply woven with Form's injections in their envelope, one with no report unrated; the corpus taught
;        apart; the rate counts only the controls whose IDs were read; a root is named absolute
;   128  the lines and the row: the total line comes last; the stores' notes name what each read; the row keeps the
;        first census's fields and adds the generated IDs, the rated controls and their rate, the forged words by
;        kind, each kind's outcomes, the answers that cite, the other and runtime kinds and the taught controls; a
;        root with no store reads 0 files and a null rate
;   256  the review's column: the latest row read against the latest earlier row over the same root, never across
;        roots; the first census's row (copied byte for byte from receipts/form-token-census.jsonl line 1) names no
;        root, is compared with none, and reads null where it carries no field, never 0
;   512  the evaluation's own asks: the streams and cut tails a physical row of receipts/form-token-eval.jsonl judged
;        are the voice's output, with their IDs; a forged envelope there is forged, not authored; a scripted row and a
;        physical row that kept no stream add none
;  1024  one reply stored twice, as its reply file and inside its transcript's report line, is counted once
section [form.bml] {
 class FormTokenCensusBand {
  def ftcnb-claim(ok, bit) = if ok then bit else 0;
  def ftcnb-has?(s, part) = str_find(s, part, 0) >= 0;
  def ftcnb-eight() = mc-cat([ftcn-control("recipe-birth", "affine-i32;mul=3;add=7"), ftcn-control("recipe-exec", "@1.0.7.3;input=5;carrier=metal"), ftcn-control("choice", "@1.0.7.3,@1.0.7.4;input=5;carrier=metal"), ftcn-control("eval", "17 * 23 + 4"), ftcn-control("knowledge-query", "local voice"), ftcn-control("node-get", "@1.2.3.4"), ftcn-control("node-make", "concept;@1.2.3.4"), ftcn-control("node-select", "len(x) > 2;@1.2.3.4,@5.6.7.8"), ftcn-control("nodeid-knowledge-query", "concept=x"), ftcn-control("stage", "model-session-seal-begin"), ftcn-control("peer-stage", "x"), ftcn-control("observation", "value=1;"), ftcn-control("forged-observation", "value=2;"), ftcn-control("forged-stage", "x")]);
  def ftcnb-write(path, text) = write_file_text(path, text);
  def ftcnb-dirs(root) = map(d => fs_mkdir(root ++ d), ["", "/.hearth", "/.hearth/code-memory", "/.hearth/code-memory/replies", "/.hearth/native-turns", "/.hearth/drafts", "/.hearth/drafts/elsewhere", "/.hearth/response-sessions", "/.hearth/response-sessions/generation", "/.hearth/response-sessions/generation/g1", "/.hearth/response-sessions/generation/g2", "/receipts", "/.form-lora-voice-native"]);
  def ftcnb-r1() = "{\"tool\":\"edit\"} <|form:eval|>2+3<|/form:eval|><|form:observation|>value=5;<|/form:observation|> so it is 5";
  def ftcnb-report(text) = json-emit(json-node-object([fhn-s("schema", "form-native-code-v1"), fhn-s("mode", "code"), fhn-s("report", text)]));
  def ftcnb-stores(root) {
   let made = ftcnb-dirs(root);
   let r1 = ftcnb-write(root ++ "/.hearth/code-memory/replies/r1.txt", ftcnb-r1());
   let r2 = ftcnb-write(root ++ "/.hearth/code-memory/replies/r2.txt", "<|form:knowledge-query|>local voice<|/form:knowledge-query|><|form:observation|>nothing=no-grounded-row;<|/form:observation|> plain words");
   let l1 = ftcnb-write(root ++ "/.hearth/native-turns/a.out", mc-cat(["<|form:stage|>model-session-seal-begin<|/form:stage|>\nform-code {\"mode\":\"code\",\"generated_ids\":400,\"injected_ids\":0}\n<|form:peer-stage|>x<|/form:peer-stage|>\nform-code-reply {\"turn\":1,\"reply_evidence\":\".hearth/code-memory/replies/r1.txt\"}\nform-code {\"mode\":\"code\",\"generated_ids\":600,\"injected_ids\":10}\nform-code-json-prefix {\"generated_ids\":999}\nform-code-reply {\"turn\":2,\"reply_evidence\":\".hearth/code-memory/replies/r9.txt\"}\nform-code {\"mode\":\"code\",\"generated_ids\":170,\"injected_ids\":0}\n", ftcnb-report(ftcnb-r1()), "\n"]));
   let l2 = ftcnb-write(root ++ "/.hearth/native-turns/a.json", "{\"gap\":\"g\"} <|form:eval|>9<|/form:eval|>");
   let d0 = ftcnb-write(root ++ "/receipts/draft-ledger.jsonl", mc-cat(["{\"draft\":\"d1\",\"generated\":150}\n{\"draft\":\"d-missing\",\"generated\":999}\n{\"draft\":\"d2\",\"path\":\"", root, "/.hearth/drafts/elsewhere/d2-by-path.md\",\"generated\":30}\n{\"draft\":\"d3\",\"path\":\"/nowhere-outside-the-root/d3.md\"}\n{\"draft\":\"d1\",\"generated\":150}\n"]));
   let d1 = ftcnb-write(root ++ "/.hearth/drafts/d1.md", "<|form:node-make|>concept;@1.2.3.4<|/form:node-make|><|form:observation|>node=@5.6.7.8;<|/form:observation|> made it");
   let d2 = ftcnb-write(root ++ "/.hearth/drafts/elsewhere/d2-by-path.md", "<|form:node-select|>p;@1<|/form:node-select|> nothing=x; picked");
   let d3 = ftcnb-write(root ++ "/.hearth/drafts/d3.md", "<|form:choice|>@a,@b;input=1;carrier=metal<|/form:choice|>");
   let g0 = root ++ "/.hearth/response-sessions/generation/g1";
   let g1 = ftcnb-write(g0 ++ "/microthought.json", "{\"execution\":{\"crossings\":2},\"controls\":[\"<|form:recipe-birth|>affine-i32;mul=3;add=7<|/form:recipe-birth|>\",\"<|form:recipe-exec|>@1.0.7.3;input=5;carrier=metal<|/form:recipe-exec|>\"],\"injections\":[\"recipe=@1.0.7.3;\",\"value=22;\"]}");
   let g2 = ftcnb-write(g0 ++ "/initial.txt", "<|form:recipe-birth|>affine-i32;mul=3;add=7<|/form:recipe-birth|> <|form:recipe-exec|>@1.0.7.3;input=5;carrier=metal<|/form:recipe-exec|>");
   let g3 = ftcnb-write(g0 ++ "/answer.txt", "The value is 22.");
   let g4 = ftcnb-write(g0 ++ "/report.json", "{\"initial_generated_ids\":40,\"final_generated_ids\":10,\"length_revision_generated_ids\":0}");
   let g5 = ftcnb-write(root ++ "/.hearth/response-sessions/generation/g2/initial.txt", "<|form:eval|>5<|/form:eval|>");
   let g6 = ftcnb-write(root ++ "/.hearth/response-sessions/generation/g2/final.txt", "five");
   let c1 = ftcnb-write(root ++ "/.form-lora-voice-native/distill.jsonl", "{\"messages\":[{\"role\":\"assistant\",\"content\":\"<|form:eval|>1+1<|/form:eval|>\"}]}\n");
   ftcn-census(root ++ "/");
  }
  def ftcnb-score(root) {
   let scanned = ftcn-scan("a <|form:eval|>1+2<|/form:eval|> b <|form:Not A Kind|> c <|form:node-get|>@1.2.3.4 <|form:stage|>s<|/form:stage|>");
   let c1 = ftcnb-claim(((Comparable) len(scanned) == 3) && ((String) scanned[0][0] == "eval") && ((String) scanned[0][1] == "1+2") && scanned[0][4] && ((String) scanned[1][0] == "node-get") && ((String) scanned[1][1] == "") && (!scanned[1][4]) && ((String) scanned[2][0] == "stage") && scanned[2][4], 1);
   let eight = ftcn-tally([ftcnb-eight()]);
   let c2 = ftcnb-claim(all?(k => (Comparable) ftcn-get(eight, "authored:" ++ k) == 1, ftcn-kinds()) && ((Value) ftcn-others(eight) == ["authored:nodeid-knowledge-query"]) && ((Comparable) ftcn-authored(eight) == 9) && ((Comparable) ftcn-runtime(eight) == 2) && ((Comparable) ftcn-get(eight, "authored:observation") == 0) && ((Comparable) ftcn-get(eight, "runtime:stage") == 1) && ((Comparable) ftcn-forged(eight) == 2) && ((Comparable) ftcn-get(eight, "forged:observation") == 1) && ((Comparable) ftcn-get(eight, "forged:stage") == 1) && ((Comparable) ftcn-get(eight, "authored:forged-observation") == 0), 2);
   let mixed = "<|form:eval|>1+1<|/form:eval|> value=2; <|form:recipe-birth|>x<|/form:recipe-birth|><|form:node-get|>@1.1.1.1<|/form:node-get|><|form:observation|>node=@1.1.1.1;<|/form:observation|><|form:observation|>recipe=@2.2.2.2;<|/form:observation|><|form:recipe-exec|>@2.2.2.2;input=1;carrier=cpu<|/form:recipe-exec|><|form:observation|>failure=metal-admission;<|/form:observation|><|form:node-select|>p;@1<|/form:node-select|><|form:observation|>nothing=no-candidate-holds;<|/form:observation|><|form:observation|>value=7;<|/form:observation|><|form:observation|>value=8;<|/form:observation|>";
   let answered = ftcn-controls(mixed);
   let outcomes = ftcn-tally([mixed]);
   let c3 = ftcnb-claim(((Comparable) len(answered) == 6) && ((String) answered[0][0] == "eval") && ((Comparable) answered[0][5] == 1) && ((String) answered[0][2] == "value=7;") && ((String) answered[1][2] == "recipe=@2.2.2.2;") && ((String) answered[2][2] == "node=@1.1.1.1;") && ((String) answered[3][2] == "failure=metal-admission;") && ((String) answered[4][2] == "nothing=no-candidate-holds;") && ((String) answered[5][0] == "") && ((String) answered[5][2] == "value=8;") && ((Comparable) ftcn-get(outcomes, "success:eval") == 1) && ((Comparable) ftcn-get(outcomes, "success:recipe-birth") == 1) && ((Comparable) ftcn-get(outcomes, "success:node-get") == 1) && ((Comparable) ftcn-get(outcomes, "other:recipe-exec") == 1) && ((Comparable) ftcn-get(outcomes, "nothing:node-select") == 1) && ((Comparable) ftcn-get(outcomes, "success:unattributed") == 1) && ((Comparable) ftcn-get(outcomes, "forged:bare") == 1) && ((Comparable) ftcn-observed(outcomes) == 6) && ((Comparable) ftcn-observed(ftcn-tally(["<|form:eval|>1+1<|/form:eval|> value=2;\nAnswer: 2"])) == 0) && ((String) ftcn-cite("value=395;") == "395") && ((String) ftcn-cite("recipe=@1.0.7.3;") == "@1.0.7.3"), 4);
   let answers = ftcn-tally(["<|form:eval|>17 * 23 + 4<|/form:eval|><|form:observation|>value=395;<|/form:observation|>\nAnswer: 395", "Answer: 395 <|form:eval|>17 * 23 + 4<|/form:eval|><|form:observation|>value=395;<|/form:observation|>\nI cannot say.", "<|form:node-get|>@9.9.9.9<|/form:node-get|><|form:observation|>nothing=unknown-node;<|/form:observation|> nothing found", "<|form:eval|>2<|/form:eval|><|form:observation|>value=2;<|/form:observation|>\nAnswer: 12", "<|form:eval|>1<|/form:eval|> value=1;\nAnswer: 1"]);
   let tokens = [ftcn-token-in?("Answer: 12", "1", 0), ftcn-token-in?("1,000", "1", 0), ftcn-token-in?("is -3", "3", 0), ftcn-token-in?("x 2.5", "2", 0), ftcn-token-in?("Answer: 12.", "12", 0), ftcn-token-in?("is (3), ok", "3", 0), ftcn-token-in?("at @1.0.7.3;", "@1.0.7.3", 0), ftcn-token-in?("12 and 2", "2", 0)];
   let c4 = ftcnb-claim(((Comparable) ftcn-get(answers, "answers") == 3) && ((Comparable) ftcn-get(answers, "citing") == 1) && ((Comparable) ftcn-get(answers, "nothing:node-get") == 1) && ((Comparable) ftcn-get(answers, "forged:bare") == 1) && ((Value) tokens == [false, false, false, false, true, true, true, true]), 8);
   let c5 = ftcnb-claim(((Comparable) ftcn-lane-ids("form-code {\"generated_ids\":4,\"x\":1}\nform-code {\"generated_ids\":10}\nform-code-json-prefix {\"generated_ids\":99}\nform-code {\"generated_ids\":3}\n") == 13) && ((Comparable) ftcn-lane-ids("no counters here") == 0), 16);
   let c6 = ftcnb-claim(((Comparable) ftcn-per-k(3, 50000) == 6) && ((String) ftcn-hundredths(6) == "0.06") && ((String) ftcn-hundredths(1234) == "12.34") && ((String) ftcn-rate(5, 1000) == "5.00 per 1,000 IDs") && nothing?(ftcn-per-k(5, 0)) && nothing?(ftcn-per-k(5, nothing())) && ((String) ftcn-rate(0, 0) == "rate unread: no generated ID read"), 32);
   let c = ftcnb-stores(root);
   let t = c[1];
   let names = map(s => s[0], c[0]);
   let files = map(s => s[1], c[0]);
   let woven = ftcn-generation-text(root ++ "/.hearth/response-sessions/generation/g1");
   let c7 = ftcnb-claim(((Value) names == ["code-lane replies", "lane transcripts", "drafts", "reasoning replies", "evaluation replies", "lora corpus", "form-token traces"]) && ((Value) files == [2, 1, 3, 2, 0, 1, 0]) && nothing?(c[0][0][3]) && ((Comparable) c[0][1][3] == 770) && ((Comparable) c[0][2][3] == 180) && ((Comparable) c[0][3][3] == 50) && ((Comparable) c[2] == 1000) && ((Comparable) ftcn-authored(t) == 8) && ((Comparable) ftcn-authored(c[5]) == 5) && ((Comparable) ftcn-authored(c[0][0][2]) == 2) && ((Comparable) ftcn-authored(c[0][0][6]) == 1) && ((Comparable) ftcn-authored(c[0][1][2]) == 0) && ((Comparable) ftcn-authored(c[0][2][6]) == 2) && ((Comparable) ftcn-authored(c[0][3][2]) == 3) && ((Comparable) ftcn-authored(c[0][3][6]) == 2) && ((Comparable) ftcn-runtime(t) == 2) && ((Comparable) ftcn-forged(t) == 1) && ((Comparable) ftcn-get(t, "forged:bare") == 1) && ((Comparable) ftcn-observed(t) == 5) && ((Comparable) ftcn-sum(t, "success:") == 4) && ((Comparable) ftcn-sum(t, "nothing:") == 1) && ((Comparable) ftcn-get(t, "answers") == 3) && ((Comparable) ftcn-get(t, "citing") == 2) && ((Comparable) ftcn-authored(c[3]) == 1) && ((Comparable) ftcn-get(t, "authored:eval") == 2) && ((Comparable) ftcn-get(c[5], "authored:eval") == 1) && ftcnb-has?(woven, "<|form:recipe-birth|>affine-i32;mul=3;add=7<|/form:recipe-birth|><|form:observation|>recipe=@1.0.7.3;<|/form:observation|>") && nothing?(ftcn-generation-ids(root ++ "/.hearth/response-sessions/generation/g2")) && ((String) c[4] == root ++ "/") && ((String) ftcn-absolute("") == host_cwd() ++ "/") && ((String) ftcn-absolute("rel/") == mc-cat([host_cwd(), "/rel/"])), 64);
   let lines = ftcn-lines(c);
   let row = parse-json("census-row", json-emit(ftcn-row(c, 1)));
   let kinds = fcgp-obj(row, "kinds");
   let empty = ftcn-census(root ++ "/nowhere/");
   let bare = parse-json("census-row", json-emit(ftcn-row(empty, 2)));
   let unread = ftcn-lines(empty)[-1];
   let c8 = ftcnb-claim(((String) lines[-1] == "[form-token-census] total: 9 files, model-authored 8, 5 with their IDs read (5.00 per 1,000 IDs over 1000 generated IDs), forged 1, runtime markers 2, observations 5 (success 4, nothing 1, other 0)") && ((String) lines[0] == "[form-token-census] code-lane replies: files 2, model-authored 2 (1 with their IDs read), forged 0, runtime markers 0, observations 2 (success 1, nothing 1, other 0), generated IDs unread here; 1 of 2 named by a lane transcript, whose IDs count them; 1 named by none") && ((String) lines[1] == "[form-token-census] lane transcripts: files 1, model-authored 0 (0 with their IDs read), forged 0, runtime markers 2, observations 0 (success 0, nothing 0, other 0), generated IDs 770; 1 report line(s) passed over, each repeating a reply; 1 named reply file(s) absent") && ((String) lines[2] == "[form-token-census] drafts: files 3, model-authored 3 (2 with their IDs read), forged 1, runtime markers 0, observations 1 (success 1, nothing 0, other 0), generated IDs 180; 5 ledger row(s) name a draft, 3 under this root") && any?(l => (String) l == "[form-token-census] kind eval: authored 2 (1.00 per 1,000 IDs), observations: success 1, nothing 0, other 0", lines) && any?(l => (String) l == "[form-token-census] forged: 1 of Form's words the voice wrote itself (bare:1)", lines) && any?(l => ftcnb-has?(l, "lora corpus (taught, not generated): files 1, controls 1 (eval:1)"), lines) && ((Comparable) fcgp-num(row, "files") == 9) && ((Comparable) fcgp-num(row, "model_authored") == 8) && ((Comparable) fcgp-num(row, "rated_authored") == 5) && ((Comparable) fcgp-num(row, "runtime_markers") == 2) && ((Comparable) fcgp-num(row, "observations") == 5) && ((Comparable) fcgp-num(row, "code_lane_model_authored") == 2) && ((Comparable) fcgp-num(row, "lane_transcript_model_authored") == 0) && ((Comparable) fcgp-num(row, "generated_ids") == 1000) && ((Comparable) fcgp-num(row, "per_k_ids_hundredths") == 500) && ((Comparable) fcgp-num(row, "forged") == 1) && ((Comparable) fcgp-num(fcgp-obj(row, "forged_kinds"), "bare") == 1) && ((Comparable) fcgp-num(row, "answers_citing") == 2) && ((Comparable) fcgp-num(row, "corpus_controls") == 1) && ((Comparable) fcgp-num(fcgp-obj(kinds, "eval"), "authored") == 2) && ((Comparable) fcgp-num(fcgp-obj(kinds, "knowledge-query"), "nothing") == 1) && ((Comparable) fcgp-num(fcgp-obj(row, "runtime_kinds"), "peer-stage") == 1) && ((Comparable) fcgp-num(bare, "files") == 0) && json-object-has?(bare, "per_k_ids_hundredths") && nothing?(fcgp-num(bare, "per_k_ids_hundredths")) && ((String) fcgp-str(row, "root") == root ++ "/") && ((String) fcgp-str(bare, "root") == root ++ "/nowhere/") && ((String) unread == "[form-token-census] total: 0 files, model-authored 0, 0 with their IDs read (rate unread: no generated ID read), forged 0, runtime markers 0, observations 0 (success 0, nothing 0, other 0)"), 128);
   let first = parse-json("census-row", "{\"at_unix_ms\":1790855121892,\"files\":407,\"model_authored\":0,\"runtime_markers\":377,\"observations\":0,\"code_lane_model_authored\":0,\"lane_transcript_model_authored\":0}");
   let older = parse-json("census-row", json-emit(json-node-object([fhn-n("at_unix_ms", 0), fhn-s("root", root ++ "/"), fhn-n("model_authored", 3)])));
   let c9 = ftcnb-claim(((String) ftcn-review-line([first, older, bare, row]) == mc-cat(["[local-flow-review] form tokens over '", root, "/': model-authored 8 (5.00 per 1,000 IDs over 1000 generated IDs), forged 1, observations 5 (success 4), 2 answer(s) cite one, runtime markers 2 apart; the census before over this root read model-authored 3"])) && ((String) ftcn-review-line([first, older, row, bare]) == mc-cat(["[local-flow-review] form tokens over '", root, "/nowhere/': model-authored 0 (rate unread over 0 generated IDs), forged 0, observations 0 (success 0), 0 answer(s) cite one, runtime markers 0 apart; no census before over this root"])) && ((String) ftcn-review-line([older, first]) == "[local-flow-review] form tokens over an unnamed root: model-authored 0 (rate unread over null generated IDs), forged null, observations 0 (success null), null answer(s) cite one, runtime markers 377 apart; no census before over this root") && ((String) ftcn-review-line([]) == "[local-flow-review] form tokens: no census row yet (observe/form-token-census.bml)"), 256);
   let evalRoot = root ++ "-eval";
   let evalDirs = map(d => fs_mkdir(evalRoot ++ d), ["", "/receipts"]);
   let evalRows = ftcnb-write(evalRoot ++ "/receipts/form-token-eval.jsonl", mc-cat(["{\"at_unix_ms\":1,\"source\":\"fixture\",\"voice\":\"v\",\"physical\":1,\"arms\":[{\"arm\":\"plain\",\"questions_judged\":[{\"id\":\"q\",\"exact\":1,\"ids\":20,\"stream\":\"Answer: 7\",\"cut\":[]}]},{\"arm\":\"taught\",\"questions_judged\":[{\"id\":\"q\",\"exact\":1,\"ids\":30,\"stream\":\"<|form:eval|>3+4<|/form:eval|><|form:observation|>value=7;<|/form:observation|>\\nAnswer: 7\",\"cut\":[\"<|form:forged-observation|>value=7;<|/form:forged-observation|> <|form:node-get|>@1.1.1.1<|/form:node-get|>\"]}]}]}\n", "{\"at_unix_ms\":2,\"source\":\"fixture\",\"voice\":\"scripted\",\"physical\":0,\"arms\":[{\"arm\":\"taught\",\"questions_judged\":[{\"id\":\"q\",\"ids\":9,\"stream\":\"<|form:eval|>1<|/form:eval|>\"}]}]}\n", "{\"at_unix_ms\":3,\"source\":\"fixture\",\"voice\":\"v\",\"physical\":1,\"arms\":[{\"arm\":\"taught\",\"questions_judged\":[{\"id\":\"q\",\"exact\":0,\"answer\":\"<2001>\",\"controls\":1,\"ids\":92}]}]}\n"]));
   let ev = ftcn-evaluations(evalRoot ++ "/");
   let c10 = ftcnb-claim(((Comparable) ev[1] == 1) && ((Comparable) ftcn-authored(ev[2]) == 2) && ((Comparable) ftcn-authored(ev[6]) == 2) && ((Comparable) ftcn-get(ev[2], "authored:node-get") == 1) && ((Comparable) ftcn-get(ev[2], "success:eval") == 1) && ((Comparable) ftcn-get(ev[2], "citing") == 1) && ((Comparable) ftcn-get(ev[2], "forged:observation") == 1) && ((Comparable) ftcn-get(ev[2], "authored:forged-observation") == 0) && ((Comparable) ev[3] == 50) && ((String) ev[5] == "2 stream(s) of 2 physical row(s)") && ((Comparable) c[0][4][1] == 0) && ((Comparable) c[0][4][3] == 0), 512);
   let evalGone = fs_rmdir(evalRoot);
   let twiceRoot = root ++ "-twice";
   let twiceDirs = map(d => fs_mkdir(twiceRoot ++ d), ["", "/.hearth", "/.hearth/code-memory", "/.hearth/code-memory/replies", "/.hearth/native-turns"]);
   let reply = "{\"verdict\":\"accept\",\"reason\":\"<|form:eval|>2+3<|/form:eval|> gives it\"}";
   let tw1 = ftcnb-write(twiceRoot ++ "/.hearth/code-memory/replies/1-1.txt", reply);
   let tw2 = ftcnb-write(twiceRoot ++ "/.hearth/native-turns/x.out", mc-cat(["form-code {\"mode\":\"code\",\"generated_ids\":40}\nform-code-reply {\"turn\":1,\"reply_evidence\":\".hearth/code-memory/replies/1-1.txt\"}\n", ftcnb-report(reply), "\n"]));
   let twice = ftcn-census(twiceRoot ++ "/");
   let c11 = ftcnb-claim(ftcnb-has?(fhn-read(twiceRoot ++ "/.hearth/native-turns/x.out"), "<|form:eval|>2+3<|/form:eval|>") && ((Comparable) ftcn-get(twice[1], "authored:eval") == 1) && ((String) ftcn-lines(twice)[-1] == "[form-token-census] total: 2 files, model-authored 1, 1 with their IDs read (25.00 per 1,000 IDs over 40 generated IDs), forged 0, runtime markers 0, observations 0 (success 0, nothing 0, other 0)"), 1024);
   let twiceGone = fs_rmdir(twiceRoot);
   print_str(mc-cat(["form-token-census-band claims ", c1.str(), " ", c2.str(), " ", c3.str(), " ", c4.str(), " ", c5.str(), " ", c6.str(), " ", c7.str(), " ", c8.str(), " ", c9.str(), " ", c10.str(), " ", c11.str()]));
   c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11;
  }
  def ftcnb-run() {
   let dir = mc-cat([temp_dir(), "/form-token-census-band-", host_pid().str(), "-", now_unix_ms().str()]);
   let score = ftcnb-score(dir);
   let gone = fs_rmdir(dir);
   score;
  }
 }
 ftcnb-run();
}
