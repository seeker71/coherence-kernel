; form-token-census-band.bml — the census of Form tokens in the voice's own output, per kind and per store.
; preludes: form-stdlib/bml/form-token-eval.bml
; Verdict 511
;
; The store fixtures are scratch files under temp_dir(), written and read back through the carrier: two code-lane
; replies, one lane transcript with form-code counters across a renewal, a draft ledger naming one draft that is
; present and one that is not, one reasoning reply whose microthought record weaves its controls and Form's
; injections, and a LoRA corpus line.
;     1  the scanner reads every opening in order with its payload; an opening whose kind is not a word is passed
;        over; an opening whose close does not come before the next opening reads open with no payload
;     2  per kind: each of the contract's eight kinds authored once is counted once; nodeid-knowledge-query stands
;        among the other model kinds; stage and peer-stage are runtime markers, counted apart; Form's observation
;        envelope is never counted as authored
;     4  observations: an envelope or a bare result answers the latest control still unanswered; value, recipe and
;        node read success, nothing= reads nothing, failure= reads other; an envelope no control asked for stands
;        unattributed
;     8  answers: a text with a successful observation counts as an answer; it cites when the text after its last
;        control or observation carries the observed value or address; a text with only nothing= is no answer
;    16  a lane's generated IDs fold from its form-code counters, a falling counter beginning a fresh stream; other
;        form-code-* lines carry no counter
;    32  the rate per 1,000 IDs in hundredths; no ID read reads nothing, never 0
;    64  the stores of a scratch root: replies, transcripts, drafts present on disk, a reasoning reply woven from
;        its record (its initial text is not counted twice), the corpus taught apart from the voice's own
;   128  the lines and the row: the total line comes last; the drafts line names the ledger rows and how many of
;        their drafts lie under the root; the row keeps the first census's fields and adds the
;        generated IDs, the rate, each kind's outcomes, the answers that cite, the other and runtime kinds and the
;        taught controls; a root with no store reads 0 files and a null rate
;   256  the review's column: the latest row read against the one before; the first census's row (copied byte for
;        byte from receipts/form-token-census.jsonl line 1) reads null where it carries no field, never 0
section [form.bml] {
 class FormTokenCensusBand {
  def ftcnb-claim(ok, bit) = if ok then bit else 0;
  def ftcnb-has?(s, part) = str_find(s, part, 0) >= 0;
  def ftcnb-eight() = mc-cat([ftcn-control("recipe-birth", "affine-i32;mul=3;add=7"), ftcn-control("recipe-exec", "@1.0.7.3;input=5;carrier=metal"), ftcn-control("choice", "@1.0.7.3,@1.0.7.4;input=5;carrier=metal"), ftcn-control("eval", "17 * 23 + 4"), ftcn-control("knowledge-query", "local voice"), ftcn-control("node-get", "@1.2.3.4"), ftcn-control("node-make", "concept;@1.2.3.4"), ftcn-control("node-select", "len(x) > 2;@1.2.3.4,@5.6.7.8"), ftcn-control("nodeid-knowledge-query", "concept=x"), ftcn-control("stage", "model-session-seal-begin"), ftcn-control("peer-stage", "x"), ftcn-control("observation", "value=1;")]);
  def ftcnb-write(path, text) = write_file_text(path, text);
  def ftcnb-dirs(root) = map(d => fs_mkdir(root ++ d), ["", "/.hearth", "/.hearth/code-memory", "/.hearth/code-memory/replies", "/.hearth/native-turns", "/.hearth/drafts", "/.hearth/response-sessions", "/.hearth/response-sessions/generation", "/.hearth/response-sessions/generation/g1", "/receipts", "/.form-lora-voice-native"]);
  def ftcnb-stores(root) {
   let made = ftcnb-dirs(root);
   let r1 = ftcnb-write(root ++ "/.hearth/code-memory/replies/r1.txt", "{\"tool\":\"edit\"} <|form:eval|>2+3<|/form:eval|><|form:observation|>value=5;<|/form:observation|> so it is 5");
   let r2 = ftcnb-write(root ++ "/.hearth/code-memory/replies/r2.txt", "<|form:knowledge-query|>local voice<|/form:knowledge-query|><|form:observation|>nothing=no-grounded-row;<|/form:observation|> plain words");
   let l1 = ftcnb-write(root ++ "/.hearth/native-turns/a.out", "<|form:stage|>model-session-seal-begin<|/form:stage|>\nform-code {\"mode\":\"code\",\"generated_ids\":400,\"injected_ids\":0}\n<|form:peer-stage|>x<|/form:peer-stage|>\nform-code {\"mode\":\"code\",\"generated_ids\":600,\"injected_ids\":10}\nform-code-json-prefix {\"generated_ids\":999}\nform-code {\"mode\":\"code\",\"generated_ids\":200,\"injected_ids\":0}\n");
   let l2 = ftcnb-write(root ++ "/.hearth/native-turns/a.json", "{\"gap\":\"g\"} <|form:eval|>9<|/form:eval|>");
   let d0 = ftcnb-write(root ++ "/receipts/draft-ledger.jsonl", "{\"draft\":\"d1\",\"generated\":150}\n{\"draft\":\"d-missing\",\"generated\":999}\n");
   let d1 = ftcnb-write(root ++ "/.hearth/drafts/d1.md", "<|form:node-make|>concept;@1.2.3.4<|/form:node-make|><|form:observation|>node=@5.6.7.8;<|/form:observation|> made it");
   let g0 = root ++ "/.hearth/response-sessions/generation/g1";
   let g1 = ftcnb-write(g0 ++ "/microthought.json", "{\"execution\":{\"crossings\":2},\"controls\":[\"<|form:recipe-birth|>affine-i32;mul=3;add=7<|/form:recipe-birth|>\",\"<|form:recipe-exec|>@1.0.7.3;input=5;carrier=metal<|/form:recipe-exec|>\"],\"injections\":[\"recipe=@1.0.7.3;\",\"value=22;\"]}");
   let g2 = ftcnb-write(g0 ++ "/initial.txt", "<|form:recipe-birth|>affine-i32;mul=3;add=7<|/form:recipe-birth|> <|form:recipe-exec|>@1.0.7.3;input=5;carrier=metal<|/form:recipe-exec|>");
   let g3 = ftcnb-write(g0 ++ "/answer.txt", "The value is 22.");
   let g4 = ftcnb-write(g0 ++ "/report.json", "{\"initial_generated_ids\":40,\"final_generated_ids\":10,\"length_revision_generated_ids\":0}");
   let c1 = ftcnb-write(root ++ "/.form-lora-voice-native/distill.jsonl", "{\"messages\":[{\"role\":\"assistant\",\"content\":\"<|form:eval|>1+1<|/form:eval|>\"}]}\n");
   ftcn-census(root ++ "/");
  }
  def ftcnb-score(root) {
   let scanned = ftcn-scan("a <|form:eval|>1+2<|/form:eval|> b <|form:Not A Kind|> c <|form:node-get|>@1.2.3.4 <|form:stage|>s<|/form:stage|>");
   let c1 = ftcnb-claim(((Comparable) len(scanned) == 3) && ((String) scanned[0][0] == "eval") && ((String) scanned[0][1] == "1+2") && scanned[0][4] && ((String) scanned[1][0] == "node-get") && ((String) scanned[1][1] == "") && (!scanned[1][4]) && ((String) scanned[2][0] == "stage") && scanned[2][4], 1);
   let eight = ftcn-tally([ftcnb-eight()]);
   let c2 = ftcnb-claim(all?(k => (Comparable) ftcn-get(eight, "authored:" ++ k) == 1, ftcn-kinds()) && ((Value) ftcn-others(eight) == ["authored:nodeid-knowledge-query"]) && ((Comparable) ftcn-authored(eight) == 9) && ((Comparable) ftcn-runtime(eight) == 2) && ((Comparable) ftcn-get(eight, "authored:observation") == 0) && ((Comparable) ftcn-get(eight, "runtime:stage") == 1), 2);
   let answered = ftcn-controls("<|form:eval|>1+1<|/form:eval|> value=2; <|form:recipe-birth|>x<|/form:recipe-birth|><|form:node-get|>@1.1.1.1<|/form:node-get|><|form:observation|>node=@1.1.1.1;<|/form:observation|><|form:observation|>recipe=@2.2.2.2;<|/form:observation|><|form:recipe-exec|>@2.2.2.2;input=1;carrier=cpu<|/form:recipe-exec|>failure=metal-admission;<|form:node-select|>p;@1<|/form:node-select|><|form:observation|>nothing=no-candidate-holds;<|/form:observation|><|form:observation|>value=7;<|/form:observation|>");
   let outcomes = ftcn-tally(["<|form:eval|>1+1<|/form:eval|> value=2; <|form:recipe-birth|>x<|/form:recipe-birth|><|form:node-get|>@1.1.1.1<|/form:node-get|><|form:observation|>node=@1.1.1.1;<|/form:observation|><|form:observation|>recipe=@2.2.2.2;<|/form:observation|><|form:recipe-exec|>@2.2.2.2;input=1;carrier=cpu<|/form:recipe-exec|>failure=metal-admission;<|form:node-select|>p;@1<|/form:node-select|><|form:observation|>nothing=no-candidate-holds;<|/form:observation|><|form:observation|>value=7;<|/form:observation|>"]);
   let c3 = ftcnb-claim(((Comparable) len(answered) == 6) && ((String) answered[0][2] == "value=2;") && ((String) answered[1][2] == "recipe=@2.2.2.2;") && ((String) answered[2][2] == "node=@1.1.1.1;") && ((String) answered[3][2] == "failure=metal-admission;") && ((String) answered[4][2] == "nothing=no-candidate-holds;") && ((String) answered[5][0] == "") && ((String) answered[5][2] == "value=7;") && ((Comparable) ftcn-get(outcomes, "success:eval") == 1) && ((Comparable) ftcn-get(outcomes, "success:recipe-birth") == 1) && ((Comparable) ftcn-get(outcomes, "success:node-get") == 1) && ((Comparable) ftcn-get(outcomes, "other:recipe-exec") == 1) && ((Comparable) ftcn-get(outcomes, "nothing:node-select") == 1) && ((Comparable) ftcn-get(outcomes, "success:unattributed") == 1) && ((String) ftcn-cite("value=395;") == "395") && ((String) ftcn-cite("recipe=@1.0.7.3;") == "@1.0.7.3"), 4);
   let answers = ftcn-tally(["<|form:eval|>17 * 23 + 4<|/form:eval|><|form:observation|>value=395;<|/form:observation|>\nAnswer: 395", "Answer: 395 <|form:eval|>17 * 23 + 4<|/form:eval|><|form:observation|>value=395;<|/form:observation|>\nI cannot say.", "<|form:node-get|>@9.9.9.9<|/form:node-get|><|form:observation|>nothing=unknown-node;<|/form:observation|> nothing found"]);
   let c4 = ftcnb-claim(((Comparable) ftcn-get(answers, "answers") == 2) && ((Comparable) ftcn-get(answers, "citing") == 1) && ((Comparable) ftcn-get(answers, "nothing:node-get") == 1), 8);
   let c5 = ftcnb-claim(((Comparable) ftcn-lane-ids("form-code {\"generated_ids\":4,\"x\":1}\nform-code {\"generated_ids\":10}\nform-code-json-prefix {\"generated_ids\":99}\nform-code {\"generated_ids\":3}\n") == 13) && ((Comparable) ftcn-lane-ids("no counters here") == 0), 16);
   let c6 = ftcnb-claim(((Comparable) ftcn-per-k(3, 50000) == 6) && ((String) ftcn-hundredths(6) == "0.06") && ((String) ftcn-hundredths(1234) == "12.34") && ((String) ftcn-rate(5, 1000) == "5.00 per 1,000 IDs") && nothing?(ftcn-per-k(5, 0)) && nothing?(ftcn-per-k(5, nothing())) && ((String) ftcn-rate(0, 0) == "rate unread: no generated ID read"), 32);
   let c = ftcnb-stores(root);
   let t = c[1];
   let names = map(s => s[0], c[0]);
   let files = map(s => s[1], c[0]);
   let c7 = ftcnb-claim(((Value) names == ["code-lane replies", "lane transcripts", "drafts", "reasoning replies", "lora corpus", "form-token traces"]) && ((Value) files == [2, 1, 1, 1, 1, 0]) && nothing?(c[0][0][3]) && ((Comparable) c[0][1][3] == 800) && ((Comparable) c[0][2][3] == 150) && ((Comparable) c[0][3][3] == 50) && ((Comparable) c[2] == 1000) && ((Comparable) ftcn-authored(t) == 5) && ((Comparable) ftcn-authored(c[0][3][2]) == 2) && ((Comparable) ftcn-runtime(t) == 2) && ((Comparable) ftcn-observed(t) == 5) && ((Comparable) ftcn-sum(t, "success:") == 4) && ((Comparable) ftcn-sum(t, "nothing:") == 1) && ((Comparable) ftcn-get(t, "answers") == 3) && ((Comparable) ftcn-get(t, "citing") == 2) && ((Comparable) ftcn-authored(c[3]) == 1) && ((Comparable) ftcn-get(t, "authored:eval") == 1), 64);
   let lines = ftcn-lines(c);
   let row = parse-json("census-row", json-emit(ftcn-row(c, 1)));
   let kinds = fcgp-obj(row, "kinds");
   let empty = ftcn-census(root ++ "/nowhere/");
   let bare = parse-json("census-row", json-emit(ftcn-row(empty, 2)));
   let c8 = ftcnb-claim(((String) lines[-1] == "[form-token-census] total: 6 files, model-authored 5 (5.00 per 1,000 IDs over 1000 generated IDs), runtime markers 2, observations 5 (success 4, nothing 1, other 0)") && ftcnb-has?(lines[0], "code-lane replies: files 2, model-authored 2, runtime markers 0, observations 2 (success 1, nothing 1, other 0), generated IDs counted by the lane transcripts") && any?(l => (String) l == "[form-token-census] drafts: files 1, model-authored 1, runtime markers 0, observations 1 (success 1, nothing 0, other 0), generated IDs 150; 2 ledger row(s) name a draft, 1 under this root", lines) && any?(l => (String) l == "[form-token-census] kind eval: authored 1 (1.00 per 1,000 IDs), observations: success 1, nothing 0, other 0", lines) && any?(l => ftcnb-has?(l, "lora corpus (taught, not generated): files 1, controls 1 (eval:1)"), lines) && ((Comparable) fcgp-num(row, "files") == 6) && ((Comparable) fcgp-num(row, "model_authored") == 5) && ((Comparable) fcgp-num(row, "runtime_markers") == 2) && ((Comparable) fcgp-num(row, "observations") == 5) && ((Comparable) fcgp-num(row, "code_lane_model_authored") == 2) && ((Comparable) fcgp-num(row, "lane_transcript_model_authored") == 0) && ((Comparable) fcgp-num(row, "generated_ids") == 1000) && ((Comparable) fcgp-num(row, "per_k_ids_hundredths") == 500) && ((Comparable) fcgp-num(row, "answers_citing") == 2) && ((Comparable) fcgp-num(row, "corpus_controls") == 1) && ((Comparable) fcgp-num(fcgp-obj(kinds, "eval"), "success") == 1) && ((Comparable) fcgp-num(fcgp-obj(kinds, "knowledge-query"), "nothing") == 1) && ((Comparable) fcgp-num(fcgp-obj(row, "runtime_kinds"), "peer-stage") == 1) && ((Comparable) fcgp-num(bare, "files") == 0) && json-object-has?(bare, "per_k_ids_hundredths") && nothing?(fcgp-num(bare, "per_k_ids_hundredths")), 128);
   let first = parse-json("census-row", "{\"at_unix_ms\":1790855121892,\"files\":407,\"model_authored\":0,\"runtime_markers\":377,\"observations\":0,\"code_lane_model_authored\":0,\"lane_transcript_model_authored\":0}");
   let c9 = ftcnb-claim(((String) ftcn-review-line([first, row]) == "[local-flow-review] form tokens: model-authored 5 (5.00 per 1,000 IDs over 1000 generated IDs), observations 5 (success 4), 2 answer(s) cite one, runtime markers 2 apart; the census before read model-authored 0") && ((String) ftcn-review-line([first]) == "[local-flow-review] form tokens: model-authored 0 (rate unread over null generated IDs), observations 0 (success null), null answer(s) cite one, runtime markers 377 apart; the census before read nothing") && ((String) ftcn-review-line([]) == "[local-flow-review] form tokens: no census row yet (observe/form-token-census.bml)"), 256);
   print_str(mc-cat(["form-token-census-band claims ", c1.str(), " ", c2.str(), " ", c3.str(), " ", c4.str(), " ", c5.str(), " ", c6.str(), " ", c7.str(), " ", c8.str(), " ", c9.str()]));
   c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9;
  }
  def ftcnb-run() {
   let dir = mc-cat([temp_dir(), "/form-token-census-band-", host_pid().str(), "-", now_unix_ms().str()]);
   let score = ftcnb-score(dir);
   let gone = fs_rmdir(dir);
   score;
  }
 }
 ftcnb-run();
}
