; serve-sched-band.bml — the scheduler of the resident serving loop (form-stdlib/bml/serve-sched.bml), against a scripted fake step function. No model, no GPU.
;
; The fake model: a sequence's next id is its fed id + 1 (so a prompt ending in id L generates L+1, L+2 ... and the end of turn is any id >= 20); a chunk
; of the prefill lane costs 400 ms of a fake clock, a decode step 100 ms, a fork 10 ms. The band reads the order of the events the scheduler asked for.
;
; Expected: 65535
; Verdict 8191 when every claim lands:
;   1     the spool reading: a well-formed request reads (chat 1 and priority 0 by default, the file's id, never the document's); a typo'd key, malformed JSON, an
;         empty request, no prompt and a negative count are refused by name; an envelope and a grammar are refused as envelope-unsupported
;   2     admission: with two slots and three requests, two run together, the third waits and is admitted into the slot the first finishing one frees
;   4     priority: of two waiting requests the higher priority is admitted first whatever the arrival; equal priorities keep arrival order
;   8     chunked prefill: a 641-id prompt (640 ids read, ten chunks of 64) beside a decoding stream: the stream decodes at least four steps between two chunks
;         (share 100: 400 ms of chunk to 100 ms of step) and its decode is never stalled for more than one chunk
;   16    a prompt read alone (nothing decoding) goes through its chunks back to back at full speed
;   32    eviction: a finished sequence's slot is free again at once; its reply holds every id before the end of turn and none of it; the stop, length,
;         stop-string statuses each arrive by name; a sequence of 15 positions in a pool of one block of 16 ends at the model's end of turn (no context-full status exists)
;   64    the rows of a pass: slots 0 and 2 live and 1 free make three rows, the free one fed id 0 at position 0 and ignored (its table the sink's: []); a live row names its blocks
;   128   the standing limit and the pool's budget: svs-limit answers the rows or a person's lower limit; svs-budget answers the blocks the machine lets the pool have in use (negative
;         when unreadable, never below what is in use); with the limit at 1 a second request waits though a row is free, and it is admitted when the limit rises; sequences already
;         running are never cut by a falling limit
;   256   an empty prompt ends by name (empty-prompt) and takes no row; a prompt larger than the whole pool with nothing else to give ends by name (pool-too-small) and takes no block
;   512   the ledger row: id, who, status, prompt_ids, generated_ids, queue_ms, prefill_ms, decode_tok_s and rent_tokens 0 read back from the JSON; the reply carries the text
;   1024  the stop strings: the text ends at the earliest stop string, and the stop string is no part of it
;   2048  the prefix cache's seams: the prefill lane's chunks end on the snapshot positions and ask for the state to be kept there; a begin that answers a count of prompt ids the
;         cache holds starts the lane from it (no snapshot already passed, cached_ids in the ledger row), a count past the prompt clamps to what the lane reads, anything else is no hit
;   4096  sampling's seams: temperature_milli and seed read from the spool (a negative temperature refused by name), carried by the sequence into the pass's rows [slot, id, position,
;         temperature, seed, tokens said] and into the ledger row
;   8192  PAGED KV: a prompt of 500 ids (far past the old slot) takes 32 blocks of 16, one more as its decode crosses position 512, and gives all back; with a pool of 11 usable blocks
;         a second prompt of 6 blocks WAITS (queued, not refused) beside a free row until the first ends; a row names its sequence's blocks in table order
;   16384 PRESSURE YIELDS, NEVER CUTS: two sequences that need 6 blocks in a pool of 3 both run, the later gives its block back when the pool is empty and ends with the same reply as
;         alone (a yield counted); a sequence that alone holds the pool ends by name (pool-full); a cache entry that holds blocks is let go for a prompt (reclaim); the machine's
;         budget holds a second prompt back while the first runs though blocks are free, never the first
;
; REQUIRES: the built ./fkwu and the body root as the working directory.
// preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/bml/live.bml form-stdlib/bml/serve-sched.bml
section [form.bml] {
 let SB = record_new(0, "ev", [], "t", 0, "limit", 8, "last", [], "hit", 0, "pool", [], "budget", -1, "entry", []);
 class ServeSchedBand {
  // a pool of n blocks of 16 positions (the fake cache's entry, the machine's budget and the pool go back to their defaults)
  def sb-pool(n) {
   let a = record_set(SB, "budget", -1);
   let b = record_set(SB, "entry", []);
   record_set(SB, "pool", svb-new(n, 16));
  }
  def sb-reset(limit) {
   let p = sb-pool(4096);
   let h = record_set(SB, "hit", 0);
   let a = record_set(SB, "ev", []);
   let b = record_set(SB, "t", 0);
   let c = record_set(SB, "limit", limit);
   record_set(SB, "last", []);
  }
  def sb-log(x) = record_set(SB, "ev", append(record_get(SB, "ev"), [[record_get(SB, "t"), x]]));
  def sb-tick(dt) = record_set(SB, "t", record_get(SB, "t") + dt);
  // the fake model's functions
  def sb-decode(rows) {
   let a = sb-log(["d", map(r => r[0], rows)]);
   let b = sb-tick(100);
   map(r => [r[1] + 1, 5], rows);
  }
  def sb-chunk(s, ids, pos) {
   let a = sb-log(["c", s[0], pos, len(ids)]);
   sb-tick(400);
  }
  // begin answers the prompt ids the fake prefix cache holds (SB "hit"): the lane reads on from there
  def sb-begin(s) {
   let a = sb-log(["b", s[0], s[7]]);
   record_get(SB, "hit");
  }
  def sb-snap(s, count) = sb-log(["s", s[0], count]);
  def sb-fork(s) {
   let a = sb-log(["f", s[0], s[7]]);
   sb-tick(10);
  }
  def sb-stop(s) = len(s[5]) > 0 && s[17] >= 3;
  // the fake cache's one entry (blocks it holds) is let go when the pool is asked for blocks it does not have; the machine's budget is the band's to set
  def sb-reclaim(need) {
   let e = record_get(SB, "entry");
   let a = nil?(e) ? 0 : sb-log(["r", need, len(e)]);
   let b = nil?(e) ? 0 : svb-release(record_get(SB, "pool"), e);
   let c = record_set(SB, "entry", []);
   svb-free-n(record_get(SB, "pool"));
  }
  def sb-env(share) = [() => record_get(SB, "t"), () => record_get(SB, "limit"), sb-begin, sb-chunk, sb-fork, sb-decode, sb-stop, record_get(SB, "pool"), tok => tok >= 20, 64, share, sb-snap, () => record_get(SB, "budget"), sb-reclaim];
  def sb-seq(id, prio, arrive, n, last, max, stops) = svs-seq([id, "p", "", 1, max, stops, prio, "band"], append(range(0, n - 1), [last]), arrive);
  def sb-run(S, env, ticks, fin) = ticks <= 0 || svs-idle?(S) ? [S, fin] : { let r = svs-tick(S, env); sb-run(r[0], env, ticks - 1, append(fin, r[1])); };
  def sb-events(kind) = filter(e => e[1][0] == kind, record_get(SB, "ev"));
  def sb-fin(fin, id) = filter(s => (String) s[0] == id, fin);
  def sb-has(s, part) = str_find(s, part, 0) >= 0;
  // claim 1
  def sb-c-parse(ctx) {
   let ok = svs-parse("r1", "{\"prompt\":\"hello\"}");
   let full = svs-parse("r2", "{\"prompt\":\"hi\",\"lens\":\"be brief\",\"chat\":0,\"max_tokens\":40,\"stop\":[\"END\",\"X\"],\"priority\":3,\"who\":\"planner\"}");
   let typo = svs-parse("r3", "{\"promt\":\"hello\"}");
   let bad = svs-parse("r4", "{bad");
   let env1 = svs-parse("r5", "{\"prompt\":\"a\",\"envelope\":\"local-plan\"}");
   let gram = svs-parse("r6", "{\"prompt\":\"a\",\"grammar\":\"root ::= x\"}");
   (String) ok[0] == "ok" && ok[1][0] == "r1" && ok[1][3] == 1 && ok[1][4] == 0 && ok[1][6] == 0 && (String) ok[1][7] == "caller"
    && (String) full[0] == "ok" && full[1][2] == "be brief" && full[1][3] == 0 && full[1][4] == 40 && len(full[1][5]) == 2 && full[1][6] == 3 && (String) full[1][7] == "planner"
    && (String) typo[0] == "refused" && sb-has(typo[1], "unknown key \"promt\"")
    && (String) bad[0] == "refused" && sb-has(bad[1], "not well-formed")
    && (String) svs-parse("r7", "   ")[0] == "refused" && (String) svs-parse("r8", "{}")[1] == "no prompt" && (String) svs-parse("r9", "{\"prompt\":\"a\",\"max_tokens\":-1}")[1] == "max_tokens below zero"
    && sb-has(env1[1], "envelope-unsupported") && sb-has(gram[1], "envelope-unsupported");
  }
  // claim 2: two slots, three requests of the same priority (last ids 15, 15, 15: five tokens each, then the end of turn at 20)
  def sb-c-admission(ctx) {
   let a = sb-reset(8);
   let S = svs-submit(svs-submit(svs-submit(svs-new(2), sb-seq("a", 0, 0, 3, 15, 0, [])), sb-seq("b", 0, 1, 3, 15, 0, [])), sb-seq("c", 0, 2, 3, 15, 0, []));
   let first = svs-tick(S, sb-env(100));
   let again = sb-reset(8);
   let r = sb-run(S, sb-env(100), 200, []);
   let begins = sb-events("b");
   let c = sb-fin(r[1], "c")[0];
   len(r[1]) == 3 && svs-idle?(r[0]) && len(begins) == 3
    && begins[0][1][1] == "a" && begins[1][1][1] == "b" && begins[2][1][1] == "c"
    && begins[0][1][2] == 0 && begins[1][1][2] == 1
    && (begins[2][1][2] == 0 || begins[2][1][2] == 1)
    && svs-queued(first[0]) == 2 && svs-active(first[0]) == 1
    && c[12] > 0 && (String) c[15] == "stop";
  }
  // claim 4
  def sb-c-priority(ctx) {
   let a = sb-reset(8);
   let S = svs-submit(svs-submit(svs-submit(svs-submit(svs-new(1), sb-seq("busy", 0, 0, 2, 15, 0, [])), sb-seq("low", 0, 1, 2, 15, 0, [])), sb-seq("high", 5, 9, 2, 15, 0, [])), sb-seq("low2", 0, 3, 2, 15, 0, []));
   let r = sb-run(S, sb-env(100), 400, []);
   let order = map(e => e[1][1], sb-events("b"));
   sb-c-priority-ok(order);
  }
  // the highest priority first, then arrival: high (5), busy (0, arrival 0), low (1), low2 (3)
  def sb-c-priority-ok(order) = len(order) == 4 && (String) order[0] == "high" && (String) order[1] == "busy" && (String) order[2] == "low" && (String) order[3] == "low2";
  // claim 8: a 641-id prompt beside a stream that decodes for a long while (last id 0, so it runs to 19 then ends: 19 tokens)
  def sb-c-interleave(ctx) {
   let a = sb-reset(8);
   let S0 = svs-submit(svs-new(2), sb-seq("short", 0, 0, 2, 0 - 970, 0, []));
   let warm = sb-run(S0, sb-env(100), 3, []);
   let S1 = svs-submit(warm[0], sb-seq("long", 0, 0, 641, 15, 0, []));
   let r = sb-run(S1, sb-env(100), 3000, warm[1]);
   let ev = record_get(SB, "ev");
   let chunks = filter(e => e[1][0] == "c" && (String) e[1][1] == "long", ev);
   let gaps = sb-gaps(chunks);
   let stall = sb-max-decode-gap(filter(e => e[1][0] == "d", ev), 0, 0);
   len(chunks) == 10 && len(sb-fin(r[1], "long")) == 1 && len(gaps) == 9 && all?(g => g >= 4, gaps) && stall <= 510;
  }
  // decode steps (by event count) between consecutive chunks
  def sb-gaps(chunks) = len(chunks) < 2 ? [] : map(i => len(filter(e => e[1][0] == "d" && e[0] > chunks[i][0] && e[0] <= chunks[i + 1][0], record_get(SB, "ev"))), range(0, len(chunks) - 1));
  def sb-max-decode-gap(ds, i, best) = i + 1 >= len(ds) ? best : sb-max-decode-gap(ds, i + 1, ds[i + 1][0] - ds[i][0] > best ? ds[i + 1][0] - ds[i][0] : best);
  // claim 16
  def sb-c-alone(ctx) {
   let a = sb-reset(8);
   let S = svs-submit(svs-new(2), sb-seq("solo", 0, 0, 321, 15, 0, []));
   let r = sb-run(S, sb-env(100), 400, []);
   let ev = record_get(SB, "ev");
   let cs = filter(e => e[1][0] == "c", ev);
   let firstd = filter(e => e[1][0] == "d", ev)[0];
   len(cs) == 5 && cs[4][0] - cs[0][0] == 1600 && firstd[0] > cs[4][0] && len(sb-fin(r[1], "solo")) == 1;
  }
  // claim 32
  def sb-c-evict(ctx) {
   let a = sb-reset(8);
   let S = svs-submit(svs-submit(svs-submit(svs-submit(svs-new(4), sb-seq("e", 0, 0, 2, 17, 0, [])), sb-seq("l", 0, 0, 2, 5, 4, [])), sb-seq("s", 0, 0, 2, 5, 0, ["END"])), sb-seq("x", 0, 0, 2, 5, 0, []));
   let r = sb-run(S, sb-env(100), 400, []);
   let e = sb-fin(r[1], "e")[0];
   let l = sb-fin(r[1], "l")[0];
   let st = sb-fin(r[1], "s")[0];
   let x = sb-fin(r[1], "x")[0];
   let p2 = sb-pool(2);
   let cap = sb-run(svs-submit(svs-new(1), sb-seq("cap", 0, 0, 2, 5, 0, [])), sb-env(100), 400, []);
   let capped = sb-fin(cap[1], "cap")[0];
   (String) e[15] == "stop" && svs-gen(e) == [18, 19] && svs-gen-n(e) == 2
    && (String) l[15] == "length" && svs-gen(l) == [6, 7, 8, 9]
    && (String) st[15] == "stop-string" && svs-gen-n(st) == 3
    && (String) x[15] == "stop" && svs-gen-n(x) == 14
    && (String) capped[15] == "stop" && capped[11] == 15
    && svs-idle?(r[0]) && svs-free-slot(r[0]) == 0;
  }
  // claim 64
  def sb-c-rows(ctx) {
   let a = sb-reset(8);
   let live = [svs-put(svs-put(svs-put(sb-seq("p", 0, 0, 2, 5, 0, []), 7, 0), 10, 41), 11, 7), svs-put(svs-put(svs-put(sb-seq("q", 0, 0, 2, 5, 0, []), 7, 2), 10, 43), 11, 9)];
   let S = [[], [], live, 0, 0, 4];
   svs-rows(S) == [[0, 41, 7, 0, 0, 0, []], [1, 0, 0, 0, 0, 0, []], [2, 43, 9, 0, 0, 0, []]];
  }
  // claim 128
  def sb-c-limit(ctx) {
   let gib = 1073741824;
   let a = svs-limit(8, 0) == 8 && svs-limit(8, 2) == 2 && svs-limit(2, 5) == 2 && svs-limit(8, -1) == 8
    && svs-budget(10, 100 * gib, gib / 2, 8 * gib) == 10 + 184 && svs-budget(10, 9 * gib, gib / 2, 8 * gib) == 12 && svs-budget(10, 8 * gib, gib / 2, 8 * gib) == 10 && svs-budget(10, 2 * gib, gib / 2, 8 * gib) == 10
    && svs-budget(10, 0 - 1, gib / 2, 8 * gib) == -1 && svs-budget(10, 100 * gib, 0, 8 * gib) == -1;
   let r0 = sb-reset(1);
   let S = svs-submit(svs-submit(svs-new(4), sb-seq("one", 0, 0, 2, 5, 0, [])), sb-seq("two", 0, 0, 2, 5, 0, []));
   let t1 = svs-tick(S, sb-env(100));
   let t2 = svs-tick(t1[0], sb-env(100));
   let waits = svs-active(t2[0]) == 1 && svs-queued(t2[0]) == 1;
   let up = record_set(SB, "limit", 4);
   let t3 = svs-tick(t2[0], sb-env(100));
   let both = svs-active(t3[0]) == 2 && svs-queued(t3[0]) == 0;
   let down = record_set(SB, "limit", 1);
   let t4 = sb-run(t3[0], sb-env(100), 400, []);
   a && waits && both && len(t4[1]) >= 1 && svs-idle?(t4[0]) && all?(s => (String) s[15] == "stop" && s[17] == 14, t4[1]);
  }
  // claim 256: an empty prompt ends by name and takes no row; a prompt larger than the whole pool, with nothing else to give, ends by name with the pool at fault (pool-too-small)
  def sb-c-refuse(ctx) {
   let a = sb-reset(8);
   let p = sb-pool(3);
   let S = svs-submit(svs-submit(svs-new(2), sb-seq("big", 0, 0, 40, 5, 0, [])), svs-seq(["empty", "p", "", 1, 0, [], 0, "band"], [], 0));
   let r = sb-run(S, sb-env(100), 50, []);
   let big = sb-fin(r[1], "big")[0];
   let empty = sb-fin(r[1], "empty")[0];
   (String) big[15] == "pool-too-small" && (String) empty[15] == "empty-prompt" && len(sb-events("b")) == 0 && svs-idle?(r[0]) && svb-free-n(record_get(SB, "pool")) == 2;
  }
  // claim 8192: PAGED KV. (a) a prompt of 500 ids, far past what a slot of 30 or 4000 positions held, is read and decoded: it takes 32 blocks of 16 for its positions, one more as its decode crosses
  // position 512, and gives every one back at its end; (b) with the pool at 11 blocks and a row free a second prompt of 6 blocks WAITS (queued, not refused) until the first ends, then runs;
  // (c) the block table a row hands the pass is the sequence's blocks in order
  def sb-c-paged(ctx) {
   let a = sb-reset(8);
   let p = sb-pool(100);
   let ra = sb-run(svs-submit(svs-new(2), sb-seq("big", 0, 0, 500, 0, 0, [])), sb-env(100), 600, []);
   let big = sb-fin(ra[1], "big")[0];
   let okA = (String) big[15] == "stop" && big[17] == 19 && len(big[24]) == 33 && svb-free-n(record_get(SB, "pool")) == 99 && len(sb-events("c")) == 8 && svs-gen(big) == range(1, 20);
   let b = sb-reset(8);
   let p2 = sb-pool(12);
   let S = svs-submit(svs-submit(svs-new(2), sb-seq("w1", 0, 0, 90, 15, 0, [])), sb-seq("w2", 0, 1, 90, 15, 0, []));
   let t1 = svs-tick(S, sb-env(100));
   let t2 = svs-tick(t1[0], sb-env(100));
   let waits = svs-active(t2[0]) == 1 && svs-queued(t2[0]) == 1 && svb-used(record_get(SB, "pool")) == 6 && svs-free-slot(t2[0]) >= 0;
   let rb = sb-run(t2[0], sb-env(100), 600, append(t1[1], t2[1]));
   let begins = map(e => e[1][1], sb-events("b"));
   let okB = waits && len(rb[1]) == 2 && all?(s => (String) s[15] == "stop", rb[1]) && begins == ["w1", "w2"] && svs-idle?(rb[0]) && svb-free-n(record_get(SB, "pool")) == 11;
   let live = [svs-put(svs-put(svs-put(svs-put(sb-seq("t", 0, 0, 2, 5, 0, []), 7, 0), 10, 41), 11, 7), 24, [9, 3, 77])];
   let okC = svs-rows([[], [], live, 0, 0, 4]) == [[0, 41, 7, 0, 0, 0, [9, 3, 77]]];
   okA && okB && okC;
  }
  // claim 16384: PRESSURE YIELDS, NEVER CUTS. (a) two sequences whose positions need 6 blocks in a pool of 3: both are admitted on one block, the later one gives its block back when the pool is empty and is
  // queued with its reply so far, the earlier finishes, the later is read again and ends with the SAME reply it would have had alone (1 to 19), a yield counted in its ledger; (b) a sequence that alone holds the whole pool
  // and needs more ends by name (pool-full) with the ids it said; (c) a prompt the pool cannot hold while a cache entry holds blocks: the entry is let go (reclaim) and the prompt goes in; (d) the machine's budget
  // holds a second prompt back while the first runs though blocks are free, never the first (a sequence alone is never held), and it goes in when the first ends
  def sb-c-yield(ctx) {
   let a = sb-reset(8);
   let p = sb-pool(4);
   let S = svs-submit(svs-submit(svs-new(2), sb-seq("A", 0, 0, 14, 0, 0, [])), sb-seq("B", 0, 1, 14, 0, 0, []));
   let r = sb-run(S, sb-env(100), 900, []);
   let fa = sb-fin(r[1], "A")[0];
   let fb = sb-fin(r[1], "B")[0];
   let okA = len(r[1]) == 2 && (String) fa[15] == "stop" && (String) fb[15] == "stop" && svs-gen(fa) == range(1, 20) && svs-gen(fb) == range(1, 20) && svs-yields(fb) >= 1 && svs-yields(fa) == 0 && svs-idle?(r[0]) && svb-free-n(record_get(SB, "pool")) == 3
    && take(14, fb[3]) == fb[25] && fb[3][14:] == take(len(fb[3]) - 14, svs-gen(fb)) && len(fb[3]) > 14 && len(fb[25]) == 14;
   let b = sb-reset(8);
   let p2 = sb-pool(3);
   let rb = sb-run(svs-submit(svs-new(2), sb-seq("solo", 0, 0, 14, 0, 0, [])), sb-env(100), 900, []);
   let solo = sb-fin(rb[1], "solo")[0];
   let okB = (String) solo[15] == "pool-full" && solo[17] == 19 && svs-gen(solo) == range(1, 20) && svb-free-n(record_get(SB, "pool")) == 2 && svs-idle?(rb[0]);
   let c = sb-reset(8);
   let p3 = sb-pool(10);
   let held = svb-take(record_get(SB, "pool"), 8);
   let e = record_set(SB, "entry", held);
   let rc = sb-run(svs-submit(svs-new(2), sb-seq("fit", 0, 0, 40, 15, 0, [])), sb-env(100), 400, []);
   let evr = sb-events("r");
   let okC = len(evr) == 1 && evr[0][1][1] == 3 && evr[0][1][2] == 8 && len(rc[1]) == 1 && (String) rc[1][0][15] == "stop" && svb-free-n(record_get(SB, "pool")) == 9;
   let d = sb-reset(8);
   let p4 = sb-pool(100);
   let bg = record_set(SB, "budget", 8);
   let S4 = svs-submit(svs-submit(svs-new(2), sb-seq("b1", 0, 0, 100, 15, 0, [])), sb-seq("b2", 0, 1, 100, 15, 0, []));
   let u1 = svs-tick(S4, sb-env(100));
   let u2 = svs-tick(u1[0], sb-env(100));
   let u3 = svs-tick(u2[0], sb-env(100));
   let held2 = svs-active(u3[0]) == 1 && svs-queued(u3[0]) == 1 && svb-used(record_get(SB, "pool")) >= 7;
   let rd = sb-run(u3[0], sb-env(100), 600, []);
   let begins = map(e => e[1][1], sb-events("b"));
   let okD = held2 && begins == ["b1", "b2"] && len(rd[1]) == 2 && all?(s => (String) s[15] == "stop", rd[1]) && svs-idle?(rd[0]);
   okA && okB && okC && okD;
  }
  // claim 512
  def sb-c-ledger(ctx) {
   let a = sb-reset(8);
   let S = svs-submit(svs-new(2), sb-seq("led", 2, 0, 3, 15, 0, []));
   let r = sb-run(S, sb-env(100), 100, []);
   let s = r[1][0];
   let row = parse-json("band", svs-ledger-row(s, 123));
   let reply = parse-json("band", svs-reply-row(s, "hello \"there\"\nline", 123));
