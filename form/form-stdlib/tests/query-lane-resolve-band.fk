; query-lane-resolve-band.fk — dozens of asks resolve on the substrate,
; and an ask outside the recipes births one the next time can reuse.
; witnessed: 2026-10-03 -> 4095
;   1 thirty-six or more real asks
;   2 all six lanes are walked
;   4 more answers come from the substrate than from the model door
;   8 a core what-question is discovery
;  16 an ask outside the lexicon is exploration, and the model is only chosen
;  32 the same ask reuses the recipe, and the growth names the miss
;  64 five teachings each carry discovery, play, and exploration
; 128 why of the self walks to nothing
; 256 the model left outside is the reason home
; 512 play reports the arm the worth selects
; 1024 a held claim answers without the model, and an unheld ask still names it
; 2048 a later process reads the kept reply, and a retained voice answer is not asked again
; preludes: form/form-stdlib/query-lane-resolve.bml
(do
    (defn qlrb-bit (ok bit) (if ok bit 0))
    (defn qlrb-has (rows kind) (if (eq (len rows) 0) 0 (if (str_eq (nth (head rows) 2) kind) 1 (qlrb-has (tail rows) kind))))
    (defn qlrb-src (rows kind) (if (eq (len rows) 0) 0 (if (str_eq (nth (head rows) 3) kind) 1 (qlrb-src (tail rows) kind))))
    (let batch (qlr-batch))
    (let won (qlr-both (nth batch 4) "What does a check below its pin mean?" (list)))
    (let grown (qlr-both (nth batch 4) "What does a check below its pin mean for the next repair?" (list)))
    (let why (qlr-arm-text "Why is the self?" "discovery"))
    (let play-in (qlr-play-text "What is nothing?"))
    (let play-out (qlr-play-text "Where does the body rebuild a stale native image?"))
    (let rent (qlr-both (nth batch 4) "Where is a session rent reading kept?" (list)))
    (let open (qlr-both (nth batch 4) "What remains rented once the answer voice is admitted?" (list)))
    (let served (qlr-serve "" "What does a check below its pin mean?"))
    (let again (qlr-serve (nth served 1) "What does a check below its pin mean?"))
    (let opened (qlr-serve "" "Who carries the landing onto origin when the gates are green?"))
    (let voiced (qlr-serve-voice (nth opened 1) "Who carries the landing onto origin when the gates are green?" "the gates pass and the line fast-forwards"))
    (let reused (qlr-serve voiced "Who carries the landing onto origin when the gates are green?"))
    (sum (list
        (qlrb-bit (ge (len (qlr-requests)) 36) 1)
        (qlrb-bit (eq (nth batch 3) 63) 2)
        (qlrb-bit (gt (nth batch 0) (nth batch 1)) 4)
        (qlrb-bit (and (str_eq (qlr-pick "What is nothing?") "discovery")
            (and (eq (qlr-outside? "What is nothing?") 0)
                 (ge (str_find (qlr-discover-text "What is nothing?") "not" 0) 0))) 8)
        (qlrb-bit (and (str_eq (qlr-pick "What does a check below its pin mean?") "exploration")
            (and (str_eq (qlr-model) "deepseek4")
                 (ge (str_find (qlr-recipe-text "What does a check below its pin mean?") "may reason outside" 0) 0))) 16)
        (qlrb-bit (and (eq (qlrb-has won "exploration") 1)
            (and (eq (qlrb-has won "recipe") 1)
            (and (eq (qlrb-src won "substrate") 1)
            (and (eq (qlrb-has grown "grown") 1)
            (and (ge (str_find (nth (head grown) 4) "learned" 0) 0)
            (and (ge (str_find (nth (head grown) 4) "is a miss" 0) 0)
                 (ge (str_find (nth (head grown) 4) "names the miss" 0) 0))))))) 32)
        (qlrb-bit (and (eq (qlr-teach-ok?) 1) (eq (len (qlr-arms)) 3)) 64)
        (qlrb-bit (and (ge (str_find why "self" 0) 0) (ge (str_find why "nothing" 0) 0)) 128)
        (qlrb-bit (str_eq (lmc-home "reason") (qlr-model)) 256)
        (qlrb-bit (and (ge (str_find play-in "discovery" 0) 0)
            (and (gt (qlr-worth "What is nothing?" "discovery") (qlr-worth "What is nothing?" "play"))
                 (ge (str_find play-out "exploration" 0) 0))) 512)
        (qlrb-bit (and (eq (qlrb-src rent "substrate") 1)
            (and (eq (qlrb-src rent "local-model") 0)
            (and (ge (str_find (nth (head rent) 4) "session-rent-ledger" 0) 0)
            (and (eq (qlrb-src open "local-model") 1)
                 (ge (str_find (nth (head open) 4) "may reason outside" 0) 0))))) 1024)
        (qlrb-bit (and (str_eq (nth (nth served 0) 3) "substrate")
            (and (ge (str_find (nth (nth served 0) 4) "is a miss" 0) 0)
            (and (str_eq (nth (nth again 0) 2) "recipe")
            (and (str_eq (nth (nth again 0) 3) "substrate")
            (and (str_eq (nth (nth opened 0) 3) "substrate")
            (and (ge (str_find (nth (nth opened 0) 4) "lands the line" 0) 0)
            (and (str_eq (nth (nth reused 0) 3) "local-voice")
                 (ge (str_find (nth (nth reused 0) 4) "fast-forwards" 0) 0)))))))) 2048))))
