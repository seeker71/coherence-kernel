; bml-demand-jit-fault-key-process-band.fk — durable 64-bit locator witness.
; PROOF LEVEL: FOURTH-ARM ONLY (host-exec starts fresh fkwu processes).
; Verdict 31.
; preludes: form/form-stdlib/bml-demand-jit.fk form/form-stdlib/form-glass-telemetry-membrane.bml

(do
    (defn bdjfkp-bit (truth weight) (if (eq truth 1) weight 0))
    (defn bdjfkp-run (path) (trim (host-exec (str_concat "./fkwu " path) "")))
    (let path-a "form/form-stdlib/tests/bml-demand-jit-fault-key-probe-a.fk")
    (let path-b "form/form-stdlib/tests/bml-demand-jit-fault-key-probe-b.fk")
    (let a-first (bdjfkp-run path-a))
    (let b (bdjfkp-run path-b))
    (let a-second (bdjfkp-run path-a))
    (sum (list
        (bdjfkp-bit (str_eq a-first a-second) 1)
        (bdjfkp-bit (not (str_eq a-first b)) 2)
        (bdjfkp-bit (and (eq (str_find a-first "jit.f.n64." 0) 0)
                          (eq (str_find b "jit.f.n64." 0) 0)) 4)
        (bdjfkp-bit (and (le (str_len a-first) 64)
                          (le (str_len b) 64)) 8)
        (bdjfkp-bit (and (eq (fgtm-channel-id? a-first) 1)
                          (eq (fgtm-channel-id? b) 1)) 16))))
