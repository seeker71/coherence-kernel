; list-equal-depth-band.bml — two lists compare in constant stack, whatever their length.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/value-operators.bml
;
; bml-value-list-equal put its recursive call to the right of an `&&`: one walker frame per element, and two lists of 416
; thousand token ids (the trainer's startup, 2026-10-09: "stack-depth ... bml-value-number? ... 416081 frames deep") stopped on
; the walker's 266 MB stack; the stop answered nothing and the trainer went on without what the comparison would have said.
; The call is now a branch of the conditional, a tail call. This band compares lists of half a million elements.
;
; Verdict 127 when every claim lands:
;   1     two equal lists of 500,000 elements are equal
;   2     lists that differ in their last element are not
;   4     lists that differ in their first element are not
;   8     a list and its own prefix are not equal, in either order
;   16    two empty lists are equal; an empty list and a one-element list are not
;   32    nested lists compare element by element, equal and unequal
;   64    a list of 500,000 strings compares equal to a copy of itself
section [form.bml] {
 class ListEqualDepthBand {
  def ledb-bit(ok, bit) = ok ? bit : 0;
  def ledb-score() {
   let a = range(0, 500000);
   let b = range(0, 500000);
   let last = append(range(0, 499999), [7]);
   let first = cons(7, range(1, 500000));
   let strings = map(i => "s" + i.str(), range(0, 500000));
   let copy = map(i => "s" + i.str(), range(0, 500000));
   ledb-bit(bml-value-equal(a, b) == 1, 1)
     + ledb-bit(bml-value-equal(a, last) == 0, 2)
     + ledb-bit(bml-value-equal(a, first) == 0, 4)
     + ledb-bit(bml-value-equal(a, range(0, 499999)) == 0 && bml-value-equal(range(0, 499999), a) == 0, 8)
     + ledb-bit(bml-value-equal([], []) == 1 && bml-value-equal([], [1]) == 0, 16)
     + ledb-bit(bml-value-equal([[1, 2], [3, [4]]], [[1, 2], [3, [4]]]) == 1 && bml-value-equal([[1, 2], [3, [4]]], [[1, 2], [3, [5]]]) == 0, 32)
     + ledb-bit(bml-value-equal(strings, copy) == 1, 64);
  }
 }
 ledb-score();
}
