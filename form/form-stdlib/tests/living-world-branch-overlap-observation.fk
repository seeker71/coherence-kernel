; Privacy-safe overlap/compost observation: counts and authority bits only.
; No payload, route, response, or source surface is emitted.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-continuity-branch.fk form-stdlib/living-world-branch-overlap.fk form-stdlib/tests/living-world-branch-overlap-witness.fk

(do
    (let branch-a (lwbow-branch-a))
    (let branch-b (lwbow-branch-b))
    (let overlap (lwbow-overlap))
    (let minimal (lwbow-minimal-contention))
    (let layered (lwbow-layered-contention))
    (let restored (lwbow-restored-world))
    (let after-a-leaves-b (lwbow-after-a-leaves-b))
    (let proposal (lwbow-compost-proposal-a))
    (let plan (lwt-proposal-candidate proposal))
    (let partial-world (lwbow-partial-compost-world))
    (let partial-outcome (lwt-evaluate-proposal partial-world proposal))
    (let transition (lwbow-compost-transition))
    (let successor (lwbow-successor-world))
    (let receipt (lwbow-compost-receipt))
    (list
        ; branch validity, projected cell/source/participant counts
        (list
            (lwcb-branch-valid? branch-a)
            (lwo-field-size (lwo-world-cells (lwcb-branch-world branch-a)))
            (lwo-field-size (lwcn-active-sources
                                (lwcb-branch-world branch-a)))
            (lwo-field-size (lwcb-branch-participants branch-a))
            (lwcb-branch-valid? branch-b)
            (lwo-field-size (lwo-world-cells (lwcb-branch-world branch-b)))
            (lwo-field-size (lwcn-active-sources
                                (lwcb-branch-world branch-b)))
            (lwo-field-size (lwcb-branch-participants branch-b)))
        ; overlap/contention counts, no-selected-slot shape, optional surfaces
        (list
            (lwbo-overlap-valid? overlap)
            (lwo-field-size (lwbo-overlap-cells overlap))
            (lwo-field-size (lwbo-overlap-relations overlap))
            (lwo-field-size (lwbo-overlap-attributions overlap))
            (lwo-field-size (lwbo-overlap-conflicts overlap))
            (lwo-field-size (lwbo-overlap-routes overlap))
            (lwbo-contention-valid? minimal)
            (len (node_children minimal))
            (lwo-field-size (lwbo-contention-alternatives minimal))
            (lwbo-contention-valid? layered)
            (lwo-field-size (lwbo-contention-alternatives layered)))
        ; restoration and source-local leave
        (list
            (lwo-field-size
                (lwo-active-attributions-for restored
                    (lwbow-candidate-a)))
            (lwo-field-size
                (lwo-active-attributions-for restored
                    (lwbow-candidate-b)))
            (lwcb-restored? restored (lwbow-candidate-a))
            (lwcb-restored? restored (lwbow-candidate-b))
            (lwo-attribution-revoked? after-a-leaves-b
                (lwbow-candidate-b) (lwbow-source-a))
            (lwo-attribution-revoked? after-a-leaves-b
                (lwbow-candidate-b) (lwbow-source-b))
            (lwcb-restored? after-a-leaves-b (lwbow-candidate-b)))
        ; compost participant/option counts and partial outcome
        (list
            (lwo-field-size (lwbo-compost-attributions plan))
            (lwo-field-size (lwbo-compost-participants plan))
            (if (node_eq (lwbo-compost-declaration plan)
                    (lwo-none)) 0 1)
            (if (node_eq (lwbo-compost-lens plan)
                    (lwo-none)) 0 1)
            (lwo-field-size (lwbo-compost-alternatives plan))
            (if (node_eq (lwbo-compost-unknowable plan)
                    (lwo-none)) 0 1)
            (lwt-outcome-yes partial-outcome)
            (lwt-outcome-no partial-outcome)
            (lwt-outcome-silence partial-outcome)
            (lwt-outcome-missing partial-outcome)
            (node_eq (lwt-outcome-status partial-outcome)
                (lwt-status-waiting)))
        ; successor: A view retired, B active, shared/routes retained, receipt
        (list
            (eq (oac-node? (lwo-transition-ack transition)) 1)
            (lwbo-compost-receipt? receipt)
            (lwcb-restored? successor (lwbow-candidate-a))
            (lwcb-restored? successor (lwbow-candidate-b))
            (lwo-active? successor (lwbow-shared))
            (lwo-active? successor (lwbow-relation-a))
            (lwo-active? successor (lwbow-relation-b))
            (node_eq (lwbo-receipt-prior-world receipt)
                (lwbow-unanimous-compost-world))
            (node_eq (lwbo-receipt-successor-world receipt) successor))))
