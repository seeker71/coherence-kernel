; query-lane-native-band.fk — core words keep their concept frequency,
; and the six ask lanes round-trip through the local model's tokens.
; witnessed: 2026-10-02 -> 2047
;   1 every core word's frequency is its concept family
;   2 the eight concepts keep their order
;   4 who asks for a self, at the person frequency
;   8 where asks for here, at the place frequency
;  16 what asks for a thing, at the relation frequency
;  32 when asks for now, at the time frequency
;  64 how asks for a way, at the relation frequency
; 128 why rests in nothing, at the ground frequency
; 256 the six lane words are the local model's own tokens
; 512 all 64 core words are the local model's own tokens
; 1024 each lane word is one local token
; preludes: form/form-stdlib/query-lane-native.bml form/form-stdlib/model-registry.bml
(do
    (defn qlnb-bit (ok bit) (if ok bit 0))
    (let src (eqr-of-file (mr-path (mr-find "qwen38-q8")) 0 40000000))
    (sum (list
        (qlnb-bit (eq (qln-aligned?) 1) 1)
        (qlnb-bit (and (eq (len (qln-concepts)) 8)
            (and (str_eq (qln-concept 0) "ground")
                 (str_eq (qln-concept 63) "relation"))) 2)
        (qlnb-bit (and (eq (qln-substrate? "who") 1) (eq (qln-lane-freq "who") 1)) 4)
        (qlnb-bit (and (eq (qln-substrate? "where") 1) (eq (qln-lane-freq "where") 5)) 8)
        (qlnb-bit (and (eq (qln-substrate? "what") 1) (eq (qln-lane-freq "what") 7)) 16)
        (qlnb-bit (and (eq (qln-substrate? "when") 1) (eq (qln-lane-freq "when") 4)) 32)
        (qlnb-bit (and (eq (qln-substrate? "how") 1) (eq (qln-lane-freq "how") 7)) 64)
        (qlnb-bit (and (eq (qln-substrate? "why") 1)
            (and (eq (qln-lane-freq "why") 0) (eq (cl-why-rests-in-nothing?) 1))) 128)
        (qlnb-bit (eq (qln-lane-tokens? src (qln-lanes)) 1) 256)
        (qlnb-bit (eq (qln-vocab-tokens? src) 1) 512)
        (qlnb-bit (eq (qln-lanes-one-piece? src (qln-lanes)) 1) 1024))))
