; prebuilt-doors-band.bml — the two doors a fetched object stands on, fkwu-witnessed (observe/prebuilt-run.bml).
;
; A fetched object is trusted by a hash committed in the repo, never by a seal it carries: float_leaf 65 hashes a regular file
; (SHA-256, 64 lower-case hex digits) and float_leaf 66 names the kernel that asks (the seed digest and the OS-arch it runs on,
; which the objects of its warm packs follow). Each claim is pure over a scratch directory this band makes and removes.
;
; Expected: 15
; Verdict 15 when every claim lands:
;   1   the SHA-256 of "abc" is the published vector ba7816bf...15ad, and of an empty file e3b0c442...b855
;   2   a file over the limit, an absent path and a directory answer nothing (a FIFO or device would too, with no waiting)
;   4   the kernel's identity opens "fkwu-image-v1 "
;   8   a kernel the seed built (" seed " in its identity) names 16 hex digits of seed and a target that holds a dash
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml
section [form.bml] {
 class PrebuiltDoorsBand {
  def pdb-dir() = ".hearth/prebuilt-doors-band";
  def pdb-sha(p, lim) = (String) (float_leaf(65, [p, lim]) ?? "nothing");
  def pdb-id() = (String) float_leaf(66, 0);
  def pdb-make() {
   let a = fs_mkdir(".hearth");
   let b = fs_mkdir(pdb-dir());
   let c = write_file_text(pdb-dir() ++ "/abc", "abc");
   let d = write_file_text(pdb-dir() ++ "/empty", "");
   0;
  }
  def pdb-clean() {
   let a = host_path_remove(pdb-dir() ++ "/abc");
   let b = host_path_remove(pdb-dir() ++ "/empty");
   let c = fs_rmdir(pdb-dir());
   0;
  }
  def pdb-c-vector(ctx) = pdb-sha(pdb-dir() ++ "/abc", 1000) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" && pdb-sha(pdb-dir() ++ "/empty", 1000) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
  def pdb-c-refuse(ctx) = pdb-sha(pdb-dir() ++ "/abc", 2) == "nothing" && pdb-sha(pdb-dir() ++ "/absent", 1000) == "nothing" && pdb-sha(pdb-dir(), 1000) == "nothing";
  def pdb-c-identity(ctx) = len(pdb-id()) > 14 && (String) substring(pdb-id(), 0, 14) == "fkwu-image-v1 ";
  def pdb-hex?(s, i) = i >= len(s) ? true : ((str_byte_at(s, i) >= 48 && str_byte_at(s, i) <= 57) || (str_byte_at(s, i) >= 97 && str_byte_at(s, i) <= 102)) && pdb-hex?(s, i + 1);
  def pdb-c-seed(ctx) = str_find(pdb-id(), " seed ", 0) < 0 || (len(pdb-id()) > 36 && pdb-hex?((String) substring(pdb-id(), 19, 35), 0) && str_find((String) substring(pdb-id(), 36, len(pdb-id())), "-", 0) > 0);
  def pdb-run() {
   let made = pdb-make();
   let verdict = live-claims("prebuilt-doors-band", 0, [["vector", 1, 1, pdb-c-vector], ["refuse", 2, 1, pdb-c-refuse], ["identity", 4, 1, pdb-c-identity], ["seed", 8, 1, pdb-c-seed]]);
   let cleaned = pdb-clean();
   verdict;
  }
 }
 pdb-run();
}
