; prebuilt-doors-band.bml — the two doors a fetched object stands on, fkwu-witnessed (observe/prebuilt-run.bml).
;
; A fetched object is trusted by a hash committed in the repo, never by a seal it carries: float_leaf 65 hashes a regular file
; (SHA-256, 64 lower-case hex digits) and float_leaf 66 names the kernel that asks (the seed digest and the OS-arch it runs on,
; which the objects of its warm packs follow). Each claim is pure over a scratch directory this band makes and removes.
;
; float_leaf 67 renames a directory exclusively (the GPU lease takes its lock with it): the hand-assembled syscall image the lease
; once used answered -2 on this seed and no lease could be taken, so no local model could open.
;
; float_leaf 68 takes a file lock (flock): the directory lock under the memory governor's reservations and the model admission
; took theirs through the same hand-assembled image, which throws on this seed, so no reservation change could be acknowledged.
;
; Expected: 63
; Verdict 63 when every claim lands:
;   1   the SHA-256 of "abc" is the published vector ba7816bf...15ad, and of an empty file e3b0c442...b855
;   2   a file over the limit, an absent path and a directory answer nothing (a FIFO or device would too, with no waiting)
;   4   the kernel's identity opens "fkwu-image-v1 "
;   8   a kernel the seed built (" seed " in its identity) names 16 hex digits of seed and a target that holds a dash
;   16  an exclusive rename of a staged directory answers 0 and lands it where nothing stood; the same rename over an existing
;       directory, even an empty one, answers a negative errno and leaves both where they were
;   32  a file lock on one descriptor is held against another open of the same file (LOCK_EX|LOCK_NB answers 0, then -11), and
;       released with LOCK_UN it passes to the other
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml
section [form.bml] {
 class PrebuiltDoorsBand {
  def pdb-dir() = ".hearth/prebuilt-doors-band";
  def pdb-sha(p, lim) = (String) (float_leaf(65, [p, lim]) ?? "nothing");
  def pdb-id() = (String) float_leaf(66, 0);
  def pdb-make() {
   let a = fs_mkdir(".hearth");
   let b = fs_mkdir(pdb-dir());
   let c = write_file_text(pdb-dir() ++ "/abc", "abc");
   let d = write_file_text(pdb-dir() ++ "/empty", "");
   0;
  }
  def pdb-clean() {
   let a = host_path_remove(pdb-dir() ++ "/abc");
   let b = host_path_remove(pdb-dir() ++ "/empty");
   let c = fs_rmdir(pdb-dir());
   0;
  }
  def pdb-c-vector(ctx) = pdb-sha(pdb-dir() ++ "/abc", 1000) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" && pdb-sha(pdb-dir() ++ "/empty", 1000) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
  def pdb-c-refuse(ctx) = pdb-sha(pdb-dir() ++ "/abc", 2) == "nothing" && pdb-sha(pdb-dir() ++ "/absent", 1000) == "nothing" && pdb-sha(pdb-dir(), 1000) == "nothing";
  def pdb-c-identity(ctx) = len(pdb-id()) > 14 && (String) substring(pdb-id(), 0, 14) == "fkwu-image-v1 ";
  def pdb-hex?(s, i) = i >= len(s) ? true : ((str_byte_at(s, i) >= 48 && str_byte_at(s, i) <= 57) || (str_byte_at(s, i) >= 97 && str_byte_at(s, i) <= 102)) && pdb-hex?(s, i + 1);
  def pdb-c-seed(ctx) = str_find(pdb-id(), " seed ", 0) < 0 || (len(pdb-id()) > 36 && pdb-hex?((String) substring(pdb-id(), 19, 35), 0) && str_find((String) substring(pdb-id(), 36, len(pdb-id())), "-", 0) > 0);
  def pdb-xr(a, b) = float_leaf(67, [pdb-dir() ++ "/" ++ a, pdb-dir() ++ "/" ++ b]);
  // stage a, an empty directory e, and nothing at n: a->n lands; a2->e (an empty directory stands there) is refused
  def pdb-c-exclusive(ctx) {
   let m1 = fs_mkdir(pdb-dir() ++ "/xa");
   let m2 = fs_mkdir(pdb-dir() ++ "/xe");
   let m3 = fs_mkdir(pdb-dir() ++ "/xb");
   let landed = pdb-xr("xa", "xn");
   let after = host_path_exists(pdb-dir() ++ "/xn") == 1 && host_path_exists(pdb-dir() ++ "/xa") == 0;
   let over = pdb-xr("xb", "xe");
   let refused = (Comparable) over < 0 && host_path_exists(pdb-dir() ++ "/xb") == 1 && host_path_exists(pdb-dir() ++ "/xe") == 1;
   let c1 = fs_rmdir(pdb-dir() ++ "/xn");
   let c2 = fs_rmdir(pdb-dir() ++ "/xe");
   let c3 = fs_rmdir(pdb-dir() ++ "/xb");
   (Comparable) landed == 0 && after && refused;
  }
  // two opens of one 0600 file: the first takes the lock, the second is refused (-11), and after LOCK_UN the second takes it
  def pdb-c-flock(ctx) {
   let p = pdb-dir() ++ "/lock";
   let w = write_file_text(p, "x");
   let m = host_chmod(p, 384);
   let a = float_leaf(60, ["regular-open", p, 1]);
   let b = float_leaf(60, ["regular-open", p, 1]);
   let ok = !nothing?(a) && !nothing?(b) && (Comparable) float_leaf(68, [a[1], 6]) == 0 && (Comparable) float_leaf(68, [b[1], 6]) == -11 && (Comparable) float_leaf(68, [a[1], 8]) == 0 && (Comparable) float_leaf(68, [b[1], 6]) == 0;
   let c1 = nothing?(a) ? 0 : float_leaf(60, ["close", a[0]]);
   let c2 = nothing?(b) ? 0 : float_leaf(60, ["close", b[0]]);
   let r = host_path_remove(p);
   ok;
  }
  def pdb-run() {
   let made = pdb-make();
   let verdict = live-claims("prebuilt-doors-band", 0, [["vector", 1, 1, pdb-c-vector], ["refuse", 2, 1, pdb-c-refuse], ["identity", 4, 1, pdb-c-identity], ["seed", 8, 1, pdb-c-seed], ["exclusive", 16, 1, pdb-c-exclusive], ["flock", 32, 1, pdb-c-flock]]);
   let cleaned = pdb-clean();
   verdict;
  }
 }
 pdb-run();
}
