; living-world-behavioral-species-band.fk -- distinct source, shared behavior.
; Verdict 32767 proves fifteen receipt, identity, reciprocity, and consent claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk form-stdlib/tests/living-world-behavioral-species-witness.fk

(do
    (let fixture (lwbsw-build-equivalent))
    (let world (lwbsw-aligned-world fixture))
    (let first
        (lwtnw-trial-candidate (lwbsw-equivalent-e-trial fixture)))
    (let second
        (lwtnw-trial-candidate (lwbsw-equivalent-g-trial fixture)))
    (let first-receipt (lwbs-receipt-for world first))
    (let second-receipt (lwbs-receipt-for world second))
    (let first-signature (lwbs-signature-for first-receipt))
    (let second-signature (lwbs-signature-for second-receipt))
    (let comparison (lwbs-comparison-for first-receipt second-receipt))
    (let field (lwbs-field-for world first second 2))
    (let set (lwbs-field-evidence field))
    (let proposal (lwbs-proposal world first second 2))
    (let candidate (lwt-proposal-candidate proposal))
    (let waiting-round
        (lwt-round world (lwo-field (list proposal))
            (lwo-empty-field)
            (lwtnw-trial-round (lwbsw-equivalent-g-trial fixture))))
    (let waiting (lwbs-integrate waiting-round proposal (lwigw-action)))
    (let admitted (lwbsw-integrated-species fixture))
    (let admitted-world (lwt-round-world (lwbsw-species-round admitted)))
    (let admitted-candidate (lwbsw-species-candidate admitted))

    (let c1
        (if (and (not (node_eq
                          (lwbs-receipt-source first-receipt)
                          (lwbs-receipt-source second-receipt)))
                 (not (eq (str_eq
                            (lwre-recipe-source
                                (lwbs-receipt-recipe first-receipt))
                            (lwre-recipe-source
                                (lwbs-receipt-recipe second-receipt))) 1))) 1 0))
    (let c2
        (if (and (eq (lwbs-historical-trial-valid? world first) 1)
                 (eq (lwbs-historical-trial-valid? world second) 1)) 2 0))
    (let c3
        (if (and (eq (lwbs-receipt-current? world first-receipt) 1)
                 (eq (lwbs-receipt-current? world second-receipt) 1)) 4 0))
    (let c4
        (if (and (node_eq (lwbs-receipt-trial first-receipt) first)
                 (and (node_eq (lwbs-receipt-trace first-receipt)
                               (lwtn-trial-trace
                                  (lwo-emergent-shape first)))
                      (eq (lwbs-receipt-budget first-receipt) 128))) 8 0))
    (let c5
        (if (and (node_eq first-signature second-signature)
                 (and (node_eq (lwbs-signature-before first-signature)
                               (intern_trivial_int 1))
                      (node_eq (lwbs-signature-after first-signature)
                               (intern_trivial_int 4)))) 16 0))
    (let c6
        (if (and (eq (oac-one? comparison) 1)
                 (node_eq (oac-payload comparison) first-signature)) 32 0))
    (let c7
        (if (eq (lwbs-aligned? (lwbs-field-status field)) 1) 64 0))
    (let c8
        (if (and (eq (lwbs-evidence-count
                         (lwbs-evidence-first-supports set)) 2)
                 (eq (lwbs-evidence-count
                         (lwbs-evidence-second-supports set)) 2)) 128 0))
    (let c9
        (if (and (eq (lwbs-evidence-count
                         (lwbs-evidence-silences set)) 1)
                 (eq (lwbs-blocker-count set) 0)) 256 0))
    (let c10
        (if (and (eq (lwo-field-has?
                         (lwbs-field-alternative-field field)
                         (lwbsw-alternative)) 1)
                 (eq (lwo-field-has?
                         (lwbs-field-unknown-field field)
                         (lwlc-unknown (lwbsw-evidence))) 1)) 512 0))
    (let c11
        (if (and (eq (lwo-field-size (lwbs-field-members field)) 2)
                 (eq (lwo-field-size (lwbs-field-receipts field)) 2)) 1024 0))
    (let c12
        (if (and (eq (lwo-field-size
                         (lwbs-field-witness-field field)) 23)
                 (eq (lwo-field-size
                         (lwt-proposal-participants proposal)) 16)) 2048 0))
    (let c13
        (if (and (eq (lwbs-proposal-current? world proposal) 1)
                 (eq (lwbs-candidate-current? world candidate) 1)) 4096 0))
    (let c14
        (if (eq (lwo-active?
                    (lwt-round-world waiting) candidate) 0) 8192 0))
    (let c15
        (if (and (eq (lwbs-integrated-current?
                         admitted-world admitted-candidate) 1)
                 (node_eq (lwo-emergent-shape admitted-candidate)
                          (lwbsw-species-field admitted))) 16384 0))
    (lwtnw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
