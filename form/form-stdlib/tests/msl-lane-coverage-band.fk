; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk
;
; msl-lane-coverage-band — the claim "every MSL family this body emits is RUN against its recipe",
; held by the body instead of by whoever last swept the tests directory.
;
; On 2026-09-09 that sentence was true and lived nowhere. Ten live bands existed, a person ran them
; with a shell loop, and the conclusion went into a receipt. Nothing in the tree would notice a
; fourteenth family emitted with no band behind it: the mint gate would still read 32767, every emit
; band would still be green, and the new family would compile and never be asked a number. A coverage
; claim that lives in prose cannot be kept OR lost — it just stops being true quietly, which is
; `namedaway` (row 1385) one level up: the understanding was spent, and the export was a sentence.
;
; So this walks `form/form-stdlib/tests/` with the body's own `fs-list` and `fs-read-text`, keeps only
; the bands that actually DISPATCH — the ones that call `metal_enqueue`, because emitting and minting
; are not running — and demands every entry point in the roster appear in one of them.
;
; THE ROSTER IS THE WEAK PART, named rather than hidden: it is written here by hand, because the body
; cannot enumerate the recipes a cell defines — that is reflection over its own definitions, a door it
; does not have. Bit 16 is the guard that keeps the hand-written list honest: the emitter's count of
; `-msl (fname)` entry points must equal the roster's length, so a family added or deleted there turns
; this band red instead of leaving the roster quietly short.
;
; Verdict 31:
;    1  the tests directory reads, and at least one band in it dispatches
;    2  every roster name is a `defn` in jit-tensor-emit.fk — the roster is not fiction
;    4  every roster name appears in a band that calls `metal_enqueue` — RUN, not merely minted
;    8  MINTING IS NOT RUNNING: a band that asks for handles and never enqueues (msl-families-mint-band)
;       must be absent from the dispatching set, while a live band must be present — so bit 4 cannot
;       be satisfied by a band that only compiles
;   16  THE ROSTER IS THE EMITTER'S OWN COUNT: 15 `-msl (fname)` entry points, 15 roster names
;
(do
    (defn mlc-has? (hay needle) (if (lt (str_find hay needle 0) 0) 0 1))
    (defn mlc-ends-with? (s p)
        (if (lt (str_len s) (str_len p)) 0
            (if (str_eq (substring s (sub (str_len s) (str_len p)) (str_len s)) p) 1 0)))
    (defn mlc-count-from (s needle i n)
        (do (let j (str_find s needle i))
            (if (lt j 0) n (mlc-count-from s needle (add j (str_len needle)) (add n 1)))))
    (defn mlc-count (s needle) (mlc-count-from s needle 0 0))

    (defn mlc-roster ()
        (list "jte-matvec-msl" "jte-affine-train-msl" "jte-mlp-train-msl" "jte-mlp-fwd-msl"
              "jte-resid-train-msl" "jte-attn-train-msl" "jte-block-fwd-msl"
              "jte-llama-block-fwd-msl" "jte-llama-block-fwd-causal-msl" "jte-gqa-attn-msl"
              "jte-gqa-llama-block-fwd-causal-msl" "jte-llama-block-decode-step-msl"
              "jte-gqa-llama-block-decode-step-msl"
              "jte-matvec-t-msl" "jte-outer-acc-msl"))

    (defn mlc-dir () "form/form-stdlib/tests")

    ; the names of every band in the directory that dispatches, and their text joined
    (defn mlc-walk (names accn acct)
        (if (eq (len names) 0) (list accn acct)
            (do (let n (head names))
                (if (eq (mlc-ends-with? n "band.fk") 0)
                    (mlc-walk (tail names) accn acct)
                    (do (let t (fs-read-text (fs-path-join (mlc-dir) n)))
                        (if (nothing? t) (mlc-walk (tail names) accn acct)
                            (if (eq (mlc-has? t "metal_enqueue") 1)
                                (mlc-walk (tail names) (cons n accn) (str_concat acct (str_concat " " t)))
                                (mlc-walk (tail names) accn acct))))))))

    (let entries (fs-list (mlc-dir)))
    (let walked (if (nothing? entries) (list (empty) "") (mlc-walk entries (empty) "")))
    (let dispatched (nth walked 0))
    (let corpus (nth walked 1))
    (let c0 (if (gt (len dispatched) 0) 1 0))

    (let emitter (fs-read-text "form/form-stdlib/jit-tensor-emit.fk"))
    (defn mlc-all-defined? (ns src)
        (if (eq (len ns) 0) 1
            (if (eq (mlc-has? src (str_concat "(defn " (head ns))) 1)
                (mlc-all-defined? (tail ns) src) 0)))
    (let c1 (if (nothing? emitter) 0 (if (eq (mlc-all-defined? (mlc-roster) emitter) 1) 2 0)))

    (defn mlc-all-covered? (ns hay)
        (if (eq (len ns) 0) 1
            (if (eq (mlc-has? hay (head ns)) 1) (mlc-all-covered? (tail ns) hay) 0)))
    (let c2 (if (eq (mlc-all-covered? (mlc-roster) corpus) 1) 4 0))

    (defn mlc-in? (n xs)
        (if (eq (len xs) 0) 0 (if (str_eq (head xs) n) 1 (mlc-in? n (tail xs)))))
    ; the witness has to be a band that MINTS and does not RUN, or the bit proves nothing: an emit-only
    ; band touches no Metal at all and is excluded under any test, so it cannot tell `metal_enqueue`
    ; from `metal_pipeline`. msl-families-mint-band asks this host for fourteen handles and never
    ; enqueues once — loosening the dispatch test to minting pulls it into the set, and this falls.
    ; The first draft used the emit-only band, and loosening the test left the verdict at 31.
    (let c3 (if (eq (mlc-in? "msl-families-mint-band.fk" dispatched) 0)
            (if (eq (mlc-in? "mlp-train-metal-live-band.fk" dispatched) 1) 8 0) 0))

    (let c4 (if (nothing? emitter) 0
            (if (eq (mlc-count emitter "-msl (fname)") (len (mlc-roster))) 16 0)))

    (add c0 (add c1 (add c2 (add c3 c4)))))
