; living-world-relation-hypothesis-band.fk -- correction can become hypothesis only.
; Verdict 32767 proves fifteen optional offer and first-boundary claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/living-world-multilens-plan.fk form-stdlib/living-world-composition-outcome.fk form-stdlib/living-world-composition-voice.fk form-stdlib/living-world-relation-hypothesis.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk form-stdlib/tests/living-world-relational-voice-witness.fk form-stdlib/tests/living-world-multilens-witness.fk form-stdlib/tests/living-world-composition-outcome-witness.fk form-stdlib/tests/living-world-relation-hypothesis-witness.fk

(do
    (let world (lwrhw-world))
    (let proposal (lwrhw-proposal))
    (let candidate (lwrhw-candidate))
    (let hypothesis (lwrhw-hypothesis))
    (let waiting
        (lwrh-integrate (lwrhw-round) proposal (lwrew-action)))
    (let integrated-world (lwrhw-integrated-world))
    (let open-offer
        (lwrh-offer (lwrhw-correction) (lwo-none) (lwo-none)
            (lwo-empty-field) (lwo-none) (lwrhw-evidence)))
    (let open-world
        (lwt-receive-stream
            (lwcow-confirmed-integrated-world)
            (list
                (lwcow-entry-g (lwrhw-correction))
                (lwcow-entry-g open-offer))))
    (let open-proposal (lwrh-proposal-for open-world open-offer))
    (let before-plan
        (lwrp-plan-for integrated-world
            (lwrhw-relation-zeta) (lwmpw-nodes)))
    (let before-relation-proposals
        (lwrl-proposals integrated-world 2))
    (let before-first-proposal
        (lwmpw-find-proposal before-relation-proposals
            (lwrhw-relation-zeta) (lwrvw-left) (lwmpw-third)))
    (let before-second-proposal
        (lwmpw-find-proposal before-relation-proposals
            (lwrhw-relation-zeta) (lwmpw-third) (lwrvw-right)))

    (let c1 (if (eq (lwrh-offer-valid? (lwrhw-offer)) 1) 1 0))
    (let c2 (if (and (eq (lwo-field-size
                              (lwrh-hypothesis-proposed-pairs hypothesis)) 2)
                         (eq (lwo-field-size
                              (lwrh-hypothesis-displaced-pairs hypothesis)) 2))
                     2 0))
    (let c3 (if (and (not (node_eq (lwrhw-pair-first) (lwo-none)))
                         (not (node_eq (lwrhw-pair-second) (lwo-none)))) 4 0))
    (let c4 (if (and (not (node_eq
                               (lwrhw-find-pair
                                (lwrh-hypothesis-displaced-pairs hypothesis)
                                (lwrvw-left) (lwrvw-right)) (lwo-none)))
                         (not (node_eq
                               (lwrhw-find-pair
                                (lwrh-hypothesis-displaced-pairs hypothesis)
                                (lwrvw-right) (lwmpw-third)) (lwo-none))))
                     8 0))
    (let c5 (if (and (eq (lwo-field-size
                              (lwrh-hypothesis-witnesses hypothesis)) 2)
                         (eq (lwo-field-size
                              (lwt-proposal-participants proposal)) 1)) 16 0))
    (let c6 (if (and (eq (lwo-world-has?
                              (lwt-round-world waiting) candidate) 0)
                         (eq (lwo-active? integrated-world candidate) 1)) 32 0))
    (let c7 (if (eq (lwrh-integrated-current?
                         integrated-world candidate) 1) 64 0))
    (let c8 (if (eq (lwrh-candidate-current?
                         (lwrhw-revoked-offer-world) candidate) 0) 128 0))
    (let c9 (if (and (node_eq
                          (lwrh-hypothesis-relation hypothesis)
                          (lwrhw-relation-zeta))
                         (node_eq
                          (lwrh-hypothesis-lens hypothesis)
                          (lwrhw-lens-zeta))) 256 0))
    (let c10 (if (and (eq (lwo-field-size
                               (lwrh-hypothesis-alternatives hypothesis)) 0)
                          (eq (lwlc-unknown?
                               (lwrh-hypothesis-unknown hypothesis)) 1)) 512 0))
    (let c11 (if (and (eq (lwrh-offer-valid? open-offer) 1)
                          (and (not (node_eq open-proposal (lwo-none)))
                               (node_eq
                                (lwrh-hypothesis-relation
                                  (lwo-emergent-shape
                                    (lwt-proposal-candidate open-proposal)))
                                (lwo-none)))) 1024 0))
    (let c12 (if (and (eq (lwrh-candidate? candidate) 1)
                          (and (eq (lwrl-candidate? candidate) 0)
                               (eq (lwrl-observation? hypothesis) 0))) 2048 0))
    (let c13 (if (and (node_eq before-first-proposal (lwo-none))
                          (and (node_eq before-second-proposal (lwo-none))
                          (eq (lwrp-ambiguous?
                               (lwrp-plan-status before-plan)) 1))) 4096 0))
    (let c14 (if (and (eq (lwo-field-has?
                               (lwt-proposal-participants proposal)
                               (lwcow-source-g)) 1)
                          (eq (lwo-field-size
                               (lwt-proposal-participants proposal)) 1)) 8192 0))
    (let c15 (if (and (eq (lwo-active?
                               integrated-world (lwrhw-correction)) 1)
                          (and (eq (lwo-active?
                                    integrated-world (lwrhw-offer)) 1)
                               (eq (lwo-active?
                                    integrated-world candidate) 1))) 16384 0))
    (lwrhw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
