; Session admission and independent checks, without generation or living writes.
; preludes: form-stdlib/bml/form-cli-response-resident.bml
(do
 (defn frssb-assert (name ok) (if ok 1 (form_error name)))
 (let request (parse-json "request" "{\"mode\":\"review\",\"review_entry\":\"direct\",\"evaluation\":1,\"goal\":\"Read the value\",\"documents\":[{\"id\":\"value\",\"path\":\"value.json\",\"text\":\"{\\\"value\\\":7}\"}],\"writable\":[],\"checks\":[{\"tool\":\"jq\",\"arguments\":[\".value\",\"value.json\"],\"stdout\":\"7\\n\"}],\"report_checks\":[{\"tool\":\"jq\",\"arguments\":[\".value\"],\"stdout\":\"7\\n\"}]}"))
 (let member (json-node-object (list (nsm-s "id" "one") (json-node-pair "request" request))))
 (let manifest (json-node-object (list (nsm-s "session" "test") (json-node-pair "cases" (json-node-array (list member))))))
 (let keyed (oh-set manifest "run_id" (json-node-string "logical-1")))
 (let result (json-node-object (list (nsm-s "status" "complete") (nsm-n "release_ok" 1) (nsm-s "report" "{\"value\":7}") (json-node-pair "documents" (json-object-get request "documents")))))
 (frssb-assert "valid frozen assessment" (frss-valid manifest))
 (frssb-assert "valid caller replay identity" (frss-valid keyed))
 (frssb-assert "empty replay identity rejected" (not (frss-valid (oh-set manifest "run_id" (json-node-string "")))))
 (frssb-assert "blank replay identity rejected" (not (frss-valid (oh-set manifest "run_id" (json-node-string " \t")))))
 (let path-label (oh-set manifest "run_id" (json-node-string "../label:with_separator")))
 (frssb-assert "identity labels do not become paths" (and (frss-valid path-label) (str_eq (fs-path-dirname (frss-root "/tmp/frss" path-label "ignored")) "/tmp/frss")))
 (frssb-assert "identity pair has no separator ambiguity" (not (str_eq (frss-root "/tmp/frss" (oh-set (oh-set keyed "session" (json-node-string "a:b")) "run_id" (json-node-string "c")) "") (frss-root "/tmp/frss" (oh-set (oh-set keyed "session" (json-node-string "a")) "run_id" (json-node-string "b:c")) ""))))
 (frssb-assert "non-string replay identity rejected" (not (frss-valid (oh-set manifest "run_id" (json-node-int 7)))))
 (frssb-assert "keyed root binds session and run id" (and (str_eq (frss-root "/tmp/frss" keyed "ignored") (frss-root "/tmp/frss" keyed "changed")) (not (str_eq (frss-root "/tmp/frss" keyed "ignored") (frss-root "/tmp/frss" (oh-set keyed "session" (json-node-string "other")) "ignored")))))
 (frssb-assert "unkeyed root retains manifest digest" (ge (str_find (frss-root "/tmp/frss" manifest "manifest-digest") "manifest-digest-" 0) 0))
 (frssb-assert "no training in assessment" (not (frsh-request-valid (oh-set request "evaluation" (json-node-int 0)))))
 (frssb-assert "no duplicate case names" (not (frss-members-valid (list member member) (list))))
 (frssb-assert "no empty case set" (not (frss-valid (oh-set manifest "cases" (json-node-array (list))))))
 (frssb-assert "checks re-run successfully" (eq (nsm-num (frss-recheck request result) "checked_behavior_passed") 1))
 (frssb-assert "false report cannot pass" (eq (nsm-num (frss-recheck request (oh-set result "report" (json-node-string "{\"value\":8}"))) "checked_behavior_passed") 0))
 (frssb-assert "incomplete result cannot pass" (eq (nsm-num (frss-recheck request (oh-set result "status" (json-node-string "attention"))) "checked_behavior_passed") 0))
 (frssb-assert "changed review sources cannot pass" (eq (nsm-num (frss-recheck request (oh-set result "documents" (parse-json "changed" "[{\"id\":\"value\",\"path\":\"value.json\",\"text\":\"{\\\"value\\\":8}\"}]"))) "checked_behavior_passed") 0))
 (frssb-assert "release failure cannot pass" (eq (nsm-num (frss-recheck request (oh-set result "release_ok" (json-node-int 0))) "checked_behavior_passed") 0))
 (frssb-assert "missing output stays failed" (eq (nsm-num (frss-recheck request (json-node-object (list))) "checked_behavior_passed") 0))
 (frssb-assert "behavior does not assert quality" (node_eq (json-object-get (frss-recheck request result) "semantic_quality") (json-node-null)))
 (let code (oh-set (oh-set request "mode" (json-node-string "code")) "writable" (json-node-array (list (json-node-string "value.json")))))
 (let extra (parse-json "extra" "[{\"id\":\"value\",\"path\":\"value.json\",\"text\":\"{\\\"value\\\":7}\"},{\"id\":\"other\",\"path\":\"other.json\",\"text\":\"{}\"}]"))
 (frssb-assert "unwritable added documents are refused" (eq (nsm-num (frss-recheck code (oh-set result "documents" extra)) "document_contract_passed") 0))
 (frssb-assert "missing original document is refused" (not (frss-doc-contract request (fat-wire-documents (oh-set result "documents" (json-node-array (list)))))))
 (let provider (parse-json "provider" "{\"allowed\":true,\"interface\":\"codex-exec\",\"max_processes\":2,\"seconds\":60}"))
 (let offered (oh-set manifest "provider" provider))
 (let denied (oh-set manifest "provider" (parse-json "denied" "{\"allowed\":false}")))
 (frssb-assert "resident read-only evaluation admitted" (frsr-valid manifest))
 (frssb-assert "resident excludes provider allowance" (not (frsr-valid offered)))
 (frssb-assert "resident explicitly denied provider stays local" (frsr-valid denied))
 (frssb-assert "resident rejects code mutation" (not (frsr-compatible (list (oh-set member "request" code)) "qwen38-q8" 8192)))
 (frssb-assert "resident rejects mixed model" (not (frsr-compatible (list (oh-set member "request" (oh-set request "model" (json-node-string "different-model")))) "qwen38-q8" 8192)))
 (frssb-assert "resident rejects mixed context" (not (frsr-compatible (list (oh-set member "request" (oh-set request "context" (json-node-int 4096)))) "qwen38-q8" 8192)))
 (frssb-assert "resident rejects zero reply allowance" (not (frsr-compatible (list (oh-set member "request" (oh-set request "turns" (json-node-int 0)))) "qwen38-q8" 8192)))
 (frssb-assert "resident reasoning channel is explicit" (not (frsr-compatible (list (oh-set member "request" (oh-set request "initial_reasoning_tokens" (json-node-int 32)))) "qwen38-q8" 8192)))
 (let retained-state (fcap-with-report (fcaq-initial request (fat-wire-value (fat-wire-documents request))) "{\"value\":7}"))
 (let boundary (json-node-object (list (nsm-n "generated_ids" 17) (nsm-n "injected_ids" 4) (nsm-n "observations" 1))))
 (let held (list member retained-state boundary))
 (let released-outcome (frsr-outcome held 1))
 (let refused-outcome (frsr-outcome held 0))
 (frssb-assert "shared release preserves original state and counts" (and (value_eq (head released-outcome) retained-state) (value_eq (tail released-outcome) (list 1 17 4 1))))
 (frssb-assert "failed lifecycle preserves report with an incomplete result" (and (str_eq (fcap-report (head refused-outcome)) "{\"value\":7}") (and (eq (nth refused-outcome 1) 0) (str_eq (fcap-note (head refused-outcome)) "resident-batch-lifecycle-incomplete"))))
 (frssb-assert "retired stream failure cannot be treated as renewal success" (not (frsr-transition-ok (list 1 "old-stream-release-incomplete" (list)))))
 (frssb-assert "successful stream retirement admitted" (frsr-transition-ok (list 1 "fresh-stream-same-weights" (list))))
 (let failed (oh-set result "report" (json-node-string "{\"value\":8}")))
 (let failed-check (frss-recheck request failed))
 (let passed-check (frss-recheck request result))
 (let changed-result (oh-set failed "documents" (parse-json "changed-source" "[{\"id\":\"value\",\"path\":\"value.json\",\"text\":\"{\\\"value\\\":8}\"}]")))
 (let changed-check (frss-recheck request changed-result))
 (frssb-assert "absent provider keeps native manifest valid" (frss-valid manifest))
 (frssb-assert "bounded provider manifest admitted" (frss-valid offered))
 (frssb-assert "progress-aware provider manifest admitted" (frss-valid (oh-set offered "provider" (oh-set provider "seconds" (json-node-int 0)))))
 (frssb-assert "rejected permission remains native-only" (frss-valid denied))
 (frssb-assert "large provider budget is outside session contract" (not (frss-valid (oh-set offered "provider" (oh-set provider "max_processes" (json-node-int 9))))))
 (frssb-assert "failed released review selected" (str_eq (frss-assistance-reason offered request failed failed-check 1 2) "provider-repair"))
 (frssb-assert "shared budget exhaustion retained" (str_eq (frss-assistance-reason offered request failed failed-check 1 0) "provider-budget-exhausted"))
 (frssb-assert "absent permission retained" (str_eq (frss-assistance-reason manifest request failed failed-check 1 2) "provider-not-offered"))
 (frssb-assert "rejected permission retained" (str_eq (frss-assistance-reason denied request failed failed-check 1 2) "provider-not-offered"))
 (frssb-assert "missing local report retained" (str_eq (frss-assistance-reason offered request failed failed-check 0 2) "local-report-missing"))
 (frssb-assert "source failure retained" (str_eq (frss-assistance-reason offered request changed-result changed-check 1 2) "source-check-failed"))
 (frssb-assert "release failure retained" (str_eq (frss-assistance-reason offered request (oh-set failed "release_ok" (json-node-int 0)) failed-check 1 2) "local-model-not-released"))
 (frssb-assert "passing local review needs no provider" (str_eq (frss-assistance-reason offered request result passed-check 1 2) "native-review-passed"))
 (frssb-assert "passing report assertions are not repaired" (str_eq (frss-assistance-reason offered request (oh-set result "status" (json-node-string "attention")) (frss-recheck request (oh-set result "status" (json-node-string "attention"))) 1 2) "local-report-assertions-passed"))
 (frssb-assert "code remains native-only" (str_eq (frss-assistance-reason offered code failed failed-check 1 2) "code-case-native-only"))
 (let session-resource (frss-resource-request offered member request "report.json"))
 (frssb-assert "case cannot enlarge resource process allowance" (eq (fcaq-number (json-object-get session-resource "provider") "max_processes" 0) 1))
 (let usage (parse-json "usage" "{\"status\":\"observed\",\"input_tokens\":12,\"output_tokens\":3}"))
 (let resource-ok (json-node-object (list (nsm-s "status" "checked") (nsm-s "answer_source" "codex-exec-through-native-form") (nsm-n "provider_processes_new" 1) (nsm-n "verified_repair" 1) (nsm-s "usage_event" "event-1") (json-node-pair "provider_usage" usage))))
 (let resource-failed (oh-set resource-ok "verified_repair" (json-node-int 0)))
 (let assisted (frss-assistance "provider-repair" resource-ok))
 (let unresolved (frss-assistance "provider-repair" resource-failed))
 (frssb-assert "assisted success stays distinct" (str_eq (frss-case-status failed-check assisted) "assisted-success"))
 (frssb-assert "failed provider repair remains unresolved" (str_eq (frss-case-status failed-check unresolved) "unresolved"))
 (frssb-assert "native success stays native" (str_eq (frss-case-status passed-check assisted) "native-only-success"))
 (let usage-once (frss-usage-add (list) assisted))
 (let usage-replayed (frss-usage-add usage-once (frss-assistance "provider-repair" (oh-set resource-ok "provider_processes_new" (json-node-int 0)))))
 (frssb-assert "replayed usage event counted once" (eq (len usage-replayed) 1))
 (frssb-assert "actual new process count sums replay as zero" (eq (frss-process-count (list (json-node-object (list (nsm-n "provider_processes_new" 1))) (json-node-object (list (nsm-n "provider_processes_new" 0))))) 1))
 (let historical (json-node-object (list (nsm-s "status" "terminal") (nsm-n "cases" 2) (nsm-n "native_executions_new" 2) (nsm-n "provider_processes_new" 1) (nsm-n "rented_provider_calls" 1) (json-node-pair "provider_usage_events" (json-node-array (list (json-node-object (list (nsm-s "usage_event" "fixture-event")))))) (json-node-pair "overall_session_quality" (json-node-null)))))
 (let replayed (frss-replay-report historical))
 (frssb-assert "replay attributes zero new execution and retains history" (and (str_eq (fcap-string replayed "status") "terminal-replay") (and (eq (nsm-num replayed "native_executions_new") 0) (and (eq (nsm-num replayed "provider_processes_new") 0) (and (eq (nsm-num replayed "native_executions_historical") 2) (eq (nsm-num replayed "provider_processes_historical") 1))))))
 (frssb-assert "replay retains usage and semantic unknown" (and (node_eq (json-object-get replayed "provider_usage_events") (json-object-get historical "provider_usage_events")) (node_eq (json-object-get replayed "overall_session_quality") (json-node-null))))
 1)
