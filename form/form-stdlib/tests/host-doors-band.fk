; host-doors-band.fk — what the doors that end the shell MEAN, including their refusals.
;
; The seed has had host_spawn, host_spawn_quiet, host_wait and host_kill for a long
; while, and the family had a missing sibling. host_spawn_quiet sends a child's output
; to /dev/null and hands it the PARENT'S OWN standard input, so a lane born from a
; sensor sitting on a terminal waits at its first read forever — 0.0% cpu, no model
; opened, not one byte written, and every axis above it reading "awake, silent", which
; is a true measurement of a lane that never started and a lie about the room (corpus
; row 1339 mutebirth). The cure the ear carried was a shell in the middle of a birth,
; there for nothing but three file descriptors. The reason was sound; the shell was
; furniture. Two more crossings sat beside it: a fork every two seconds to ask whether
; a pid still answered, and a third to make a fifo.
;
; Three names answer all of it, riding the leaf door as rewrite modes 17-19. No AST tag
; was spendable and none was taken (corpus rows 1358 limbkept, 1373 freefeint).
;
;   host_spawn_at argv (list in out err)  fork and execvp the argument list itself —
;       no shell reads it, so a path holding a space is a path and not a program. Each
;       standard stream opens where the caller says; "" keeps the parent's. Out and err
;       open APPEND, because a log that chronicles every life a lane has had must not
;       be truncated by the next birth, and an err path byte-equal to the out path
;       shares the one descriptor.
;   host_alive pid   1 the pid answers, 0 it is gone, -1 none was given.
;   fs_mkfifo path   1 made, 0 one already stands, -1 refused.
;
; FOUR REFUSALS, ANSWERING DIFFERENT QUESTIONS, AND EVERY ONE BEFORE THE CALLER HOLDS
; A PID IT COULD MISTAKE FOR A LIVING CHILD:
;   -1  the argv — nothing here can be run: not a list, empty, or a word in it is not
;       a string.
;   -2  the redirect — a stream could not be opened where it was sent. Judged in the
;       PARENT, before the fork, which is why row 8 and row 9 below are answers and
;       not orphans.
;   -3  the fork — the host refused to fork. Not walked here: a band that exhausted
;       the process table to reach it would stain the machine it measures (bandstain,
;       corpus row 1193). It is the one refusal this cell names and does not pin.
;   -4  the binary — the fork happened and execvp did not. This is the row that pays
;       for the whole door. host_spawn answers a pid whatever follows, so a missing
;       binary surfaces later as a 127 from host_wait — indistinguishable, for as long
;       as the patience lasts, from a lane that is merely quiet. Here the child holds
;       the write end of a close-on-exec pipe: a successful exec closes it and the
;       parent reads zero bytes; a failed one writes its errno, and the parent reaps
;       the corpse and answers -4 AT BIRTH.
;
; The paths this cell touches carry its own pid, because siblings share /tmp and a
; band that read another hand's bytes would agree with itself about the wrong world.
; The last row reads the ear cell's own text: the heal is not proven by the doors alone,
; only by the lane no longer reaching for a shell.
;
; Expected: 131071
; Verdict 131071
; PROOF LEVEL: FOURTH-ARM ONLY (a host process family; no sibling kernel carries host_spawn)
; preludes: form/form-stdlib/core.fk
(do
    (defn hdb-bit (ok v) (if ok v 0))
    (defn hdb-tmp (suffix) (str_concat "/tmp/host-doors-" (str_concat (int_to_str (host_pid)) suffix)))
    (defn hdb-holds? (path needle) (ge (str_find (hdb-text path) needle 0) 0))
    (defn hdb-text (path) (if (lt (file_size path) 0) "" (read_file path)))
    (defn hdb-none () (list "" "" ""))

    (let logp (hdb-tmp ".log"))
    (let bellp (hdb-tmp ".bell"))
    (let g0 (fs_remove logp))
    (let g1 (fs_remove bellp))

    ; ── the door does its work: a real child, its streams where the caller said ──
    (let p1 (host_spawn_at (list "/bin/echo" "one") (list "/dev/null" logp logp)))
    (let w1 (host_wait p1))
    (let c1 (hdb-bit (and (gt p1 0) (eq w1 0)) 1))
    (let c2 (hdb-bit (hdb-holds? logp "one") 2))

    ; err placed at the same path as out is ONE descriptor — what 2>&1 meant. ls says
    ; its refusal on stderr, and it lands in the same log beside the stdout bytes.
    (let size1 (file_size logp))
    (let p2 (host_spawn_at (list "/bin/ls" (hdb-tmp ".absent")) (list "" logp logp)))
    (let w2 (host_wait p2))
    (let c3 (hdb-bit (and (gt w2 0) (gt (file_size logp) size1)) 4))

    ; APPEND, not truncate: the first child's voice is still there under the second's
    (let c4 (hdb-bit (hdb-holds? logp "one") 8))

    ; stdin PLACED: a child that reads its input to the end ends at once on /dev/null.
    ; With the parent's own stdin it would wait forever — the whole of the mutebirth
    ; wound, and the reason this door exists.
    (let inlog (hdb-tmp ".in.log"))
    (let g2 (fs_remove inlog))
    (let p3 (host_spawn_at (list "/bin/cat") (list "/dev/null" inlog inlog)))
    (let w3 (host_wait p3))
    (let c5 (hdb-bit (and (eq w3 0) (eq (file_size inlog) 0)) 16))

    ; ── the refusals ──
    ; -1 the argv: nothing here can be run
    (let c6 (hdb-bit (eq (host_spawn_at (list) (hdb-none)) (sub 0 1)) 32))
    (let c7 (hdb-bit (and (eq (host_spawn_at "not a list" (hdb-none)) (sub 0 1))
                          (and (eq (host_spawn_at (nothing) (hdb-none)) (sub 0 1))
                               (eq (host_spawn_at (list 5 "x") (hdb-none)) (sub 0 1)))) 64))

    ; -2 the redirect: judged in the parent, so no child is ever born to be misread
    (let c8 (hdb-bit (eq (host_spawn_at (list "/bin/echo" "x")
                                        (list "" (hdb-tmp ".no/such/dir/out") "")) (sub 0 2)) 128))
    (let c9 (hdb-bit (eq (host_spawn_at (list "/bin/echo" "x")
                                        (list (hdb-tmp ".absent-input") "" "")) (sub 0 2)) 256))
    (let c10 (hdb-bit (eq (host_spawn_at (list "/bin/echo" "x")
                                         (list "" "" (hdb-tmp ".no/such/dir/err"))) (sub 0 2)) 512))

    ; -4 the binary: answered at birth, not as a 127 minutes later
    (let c11 (hdb-bit (eq (host_spawn_at (list (hdb-tmp ".no-such-binary")) (hdb-none)) (sub 0 4)) 1024))

    ; a child that DIES AT ONCE is not a refusal — it was born, and its status says so
    (let p4 (host_spawn_at (list "/usr/bin/false") (hdb-none)))
    (let w4 (host_wait p4))
    (let c12 (hdb-bit (and (gt p4 0) (eq w4 1)) 2048))

    ; ── host_alive: the fork this replaces asked exactly this and nothing more ──
    (let c13 (hdb-bit (eq (host_alive (host_pid)) 1) 4096))
    ; a reaped child is GONE; a pid that was never given is a refusal, and they are
    ; different numbers, because a sensor that read one as the other killed a newborn
    (let c14 (hdb-bit (and (eq (host_alive p4) 0)
                           (and (eq (host_alive 0) (sub 0 1))
                                (eq (host_alive (sub 0 3)) (sub 0 1)))) 8192))

    ; ── fs_mkfifo: report what IS there, never remove a path on its own ──
    (let m1 (fs_mkfifo bellp))
    (let m2 (fs_mkfifo bellp))
    (let c15 (hdb-bit (and (eq m1 1) (eq m2 0)) 16384))
    (let g3 (fs_remove bellp))
    (let g4 (write_file_text bellp "x"))
    (let m3 (fs_mkfifo bellp))
    (let c16 (hdb-bit (and (eq m3 (sub 0 1)) (eq (file_size bellp) 1)) 32768))

    ; ── and the reason all of this exists: the lane no longer reaches for a shell ──
    ; The doors mean nothing on their own. This row reads the cell they were built for
    ; and refuses if a crossing comes back into it — the only row here that can go red
    ; from a hand editing some OTHER file.
    (let ear (hdb-text "observe/form-glass-ear-live.fk"))
    (let c17 (hdb-bit (and (gt (str_len ear) 0)
                           (and (lt (str_find ear "host-exec" 0) 0)
                                (lt (str_find ear "sh -c" 0) 0))) 65536))

    (let g5 (fs_remove bellp))
    (let g6 (fs_remove logp))
    (let g7 (fs_remove inlog))

    (print_str (str_concat "spawn_at pid>0=" (str_concat (int_to_str (if (gt p1 0) 1 0))
        (str_concat " nobinary=" (str_concat (int_to_str (host_spawn_at (list (hdb-tmp ".nb")) (hdb-none)))
        (str_concat " alive-self=" (int_to_str (host_alive (host_pid)))))))))
    (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9 (add c10
        (add c11 (add c12 (add c13 (add c14 (add c15 (add c16 c17)))))))))))))))))
