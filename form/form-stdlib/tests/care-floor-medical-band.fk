; care-floor-medical-band.fk — the care floor hears a heart attack and breathlessness in every tongue it holds,
; still holds everything it held, and stays quiet on the words that only sound alike. 7 bits -> 127.
; A gap in learn/native-turn-queue.jsonl: the native code lane is asked to turn it green.
; preludes: form-stdlib/bml/care-floor.bml
(do
    (defn cfm-bit (ok n) (if (eq ok 1) n 0))
    (let en (mul (cf-is "I think I am having a heart attack" "medical") (cf-is "my father had a stroke" "medical")))
    (let de (mul (cf-is "Ich habe Atemnot" "medical") (cf-is "Verdacht auf Herzinfarkt" "medical")))
    (let pt (mul (cf-is "acho que estou tendo um infarto" "medical") (cf-is "ele teve um derrame" "medical")))
    (let id (mul (cf-is "sepertinya saya kena serangan jantung" "medical") (cf-is "ayah saya terkena stroke" "medical")))
    (let fa (cf-is "فکر می‌کنم سکته قلبی کرده‌ام" "medical"))
    (let before (if (eq (cf-self-check) 255) 1 0))
    (let quiet (cf-quiet (list "the attack on the castle" "the heart of the matter" "a stroke of luck" "Herz und Seele")))
    (add (cfm-bit en 1) (add (cfm-bit de 2) (add (cfm-bit pt 4) (add (cfm-bit id 8) (add (cfm-bit fa 16) (add (cfm-bit before 32) (cfm-bit quiet 64))))))))
