; native-model-session-grounding-native-band.fk -- pure/native carrier pieces
; preserve JSON strings transiently, minimize to salted digests/path IDs, keep
; optional expiry/default/lens distinct, and reject missing consent.
;
; witnessed: 2026-08-08 -> 2047 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/native-model-session-grounding-native.fk

(do
    (let candidates
        (list
            (nmsgn-candidate "form/a.fk" "form/a.fk alpha source")
            (nmsgn-candidate "form/b.fk" "form/b.fk beta source")
            (nmsgn-candidate "form/c.fk" "form/c.fk gamma source")
            (nmsgn-candidate "form/d.fk" "form/d.fk delta source")))
    (let user-line
        "{\"timestamp\":\"2026-08-08T01:02:03Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"private question\"}}")
    (let done-line
        "{\"timestamp\":\"2026-08-08T01:02:04Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"task_complete\",\"last_agent_message\":\"bounded answer cites form/c.fk\"}}")
    (let after-user
        (nmsgn-session-event user-line (nmsgn-empty-pairs)))
    (let after-done
        (nmsgn-session-event done-line after-user))
    (let finalized
        (nmsgn-pairs-finalize after-done
            (nmsgn-labels (nmsgn-pairs-latest-completion after-done)
                candidates) "salt"))
    (let admitted
        (nmsgn-admit (nmsgn-pairs-latest-labels finalized) candidates 4))
    (let digest (nmsgn-pairs-latest-digest finalized))
    (let stream0 (nmsgn-index-state 0 (list) (list)))
    (let stream1
        (nmsgn-index-accept (nth candidates 3) "cites form/c.fk" 2 stream0))
    (let stream2
        (nmsgn-index-accept (nth candidates 2) "cites form/c.fk" 2 stream1))
    (let stream3
        (nmsgn-index-accept (nth candidates 1) "cites form/c.fk" 2 stream2))
    (let stream4
        (nmsgn-index-accept (nth candidates 0) "cites form/c.fk" 2 stream3))
    (let refusal
        (nmsgn-run "" "owner" "/missing" "/missing" "/missing"
            "/missing" "/missing" 1 4 0 "" "" (now_unix_ms)))
    (sum (list
        (if (str_eq (nmsgn-pairs-query after-user) "private question") 1 0)
        (if (str_eq (nmsgn-pairs-query after-done) "") 2 0)
        (if (eq (nmsgn-pairs-completed after-done) 1) 4 0)
        (if (eq (nmsgn-pairs-labeled finalized) 1) 8 0)
        (if (str_eq (head (nmsgn-pairs-latest-labels finalized))
                "form/c.fk") 16 0)
        (if (eq (nmsg-digest? digest) 1) 32 0)
        (if (eq (len admitted) 4) 64 0)
        (if (str_eq (nmsgn-candidate-id (nth admitted 0)) "form/a.fk") 128 0)
        (if (str_eq (nmsgn-candidate-id (nth admitted 2)) "form/c.fk") 256 0)
        (if (str_eq (nmsgn-report-value "a=1\nb=two\n" "b") "two") 512 0)
        (if (eq (len (nth refusal 6)) 14) 1024 0)
        (if (and (eq (nmsgn-index-valid stream4) 4)
                 (str_eq (nmsgn-candidate-id
                    (head (nmsgn-index-cited stream4))) "form/c.fk")) 2048 0)
        (if (and (eq (len (nmsgn-index-fallback stream4)) 2)
                 (and (str_eq (nmsgn-candidate-id
                    (nth (nmsgn-index-fallback stream4) 0)) "form/a.fk")
                      (str_eq (nmsgn-candidate-id
                    (nth (nmsgn-index-fallback stream4) 1)) "form/b.fk"))) 4096 0))))
