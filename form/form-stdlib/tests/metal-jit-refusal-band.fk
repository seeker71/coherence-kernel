; Cache failures remain explicit. This band owns files only below its stdin directory.
; preludes: form-stdlib/bml/metal-jit.bml
(do
 (defn mjrb-run (directory)
 (do
 (let source (mj-source "kernel void cache_probe(device uint *y [[buffer(0)]], uint i [[thread_position_in_grid]]) { y[i] = i * 3u + 7u; }"))
 (let path (mj-cache-path directory source "cache_probe"))
 (let changed (mj-source "kernel void cache_probe(device uint *y [[buffer(0)]], uint i [[thread_position_in_grid]]) { y[i] = i * 3u + 8u; }"))
 (let missing (mj-admit source "cache_probe" 2 (str_concat directory "/missing.metalbin")))
 (let missing-status (metal_status))
 (let wrong-program (mj-admit changed "cache_probe" 2 path))
 (let corrupt-path (str_concat directory "/corrupt.metalbin"))
 (write_file corrupt-path "corrupt archive witness")
 (let corrupt (mj-admit source "cache_probe" 2 corrupt-path))
 (let bad-header (metal_pipeline "FMJ1" "form_metal_jit_v1"))
 (let bad-mode (metal_pipeline (mj-descriptor source "cache_probe" 3 "") "form_metal_jit_v1"))
 (let status (metal_status))
 (sum (list
  (if (nothing? missing) 1 0)
  (if (ge (str_find missing-status "metal jit archive:" 0) 0) 2 0)
  (if (nothing? wrong-program) 4 0)
  (if (nothing? corrupt) 8 0)
  (if (eq bad-header 0) 16 0)
  (if (eq bad-mode 0) 32 0)
  (if (and (ge (str_find status "pipelines=0" 0) 0) (ge (str_find status "metal_jit_archive_writes=0" 0) 0)) 64 0)))))
 (let directory (read_line))
 (if (and (not (nothing? directory)) (eq (str_find directory "/tmp/fkwu-metal-cache." 0) 0)) (mjrb-run directory) 0))
