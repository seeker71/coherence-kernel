// Round-trip the contracts that are easy to lose in a surface lift.
// preludes: form-stdlib/bml/form-source-lift.bml
section [form.bml] {
 let cases = list("", "; comments only\n",
  "(defn arithmetic (a b c) (eq (sub a (sub b c)) (add b c)))",
  "(defn comparisons (a b) (if (eq (sub a b) 0) (str_eq a b) (value_eq a b)))",
  "(defn choose (a b c) (if a (if b 1 0) (and b (or c a))))",
  "(defn bindings (stop fail) (add (stop 1) (fail 2)))",
  "(defn bytes () \"quote:\\\" slash:\\\\ newline:\\n tab:\\t\")",
  "; header\n(do ; body\n (defn predicate (a) (if a true false)))");
 let results = map(source => head(form-source-lift(source,"lift-contract.fk")),cases);
 if !all?(identity,results) then { print(results); form_error("source lift changed a contract"); } else {
  let unsafe = form-source-lift("(defn literal () \"a;b\")","lift-contract.fk");
  let scope = form-source-lift("(defn scopes (a) (do (let b (add a 1)) (defn inner (c) (mul b c)) (inner 2)))","lift-contract.fk");
  let shadow = form-source-lift("(defn shadow (false) false)","lift-contract.fk");
  if head(unsafe) || head(scope) || head(shadow) then form_error("compiler-added construction or binding changed unnoticed") else print(list("source-lift-contracts",len(results),"construction-and-binding-changes-refused",3));
 };
}
