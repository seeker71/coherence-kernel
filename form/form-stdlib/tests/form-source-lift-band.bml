// Round-trip the contracts that are easy to lose in a surface lift.
// preludes: form-stdlib/bml/form-source-lift.bml
section [form.bml] {
 let cases = list("", "; comments only\n",
  "(defn arithmetic (a b c) (eq (sub a (sub b c)) (add b c)))",
  "(defn comparisons (a b) (if (eq (sub a b) 0) (str_eq a b) (value_eq a b)))",
  "(defn choose (a b c) (if a (if b 1 0) (and b (or c a))))",
  "(defn bindings (stop fail) (add (stop 1) (fail 2)))",
  "(defn bytes () \"quote:\\\" slash:\\\\ newline:\\n tab:\\t\")",
  "; header\n(do ; body\n (defn predicate (a) (if a true false)))",
  "(defn literal () \";a;b;\")",
  "(defn literal () \";quote:\\\" slash:\\\\ newline:\\n;\")",
  "(defn append-literal (s) (str_concat s \"a;b\"))",
  "(do (let x 1) (do (let x 2) x) x)",
  "(do (let x 1) x) (do (let x 2) x)",
  "import \"form/form-stdlib/core.fk\"\n(do (defn identity-import (x) x))",
  "(defn rows (x i) (list (list) (nth (nth x i) 0) (nth (range 1 (add i 2)) 0)))",
  "(defn pick (x) (if (value_eq x 0) (list 1) (if (value_eq x 1) (list 2) (list 3))))",
  "(defn nested (x) (if (if x 0 1) (if x 2 3) (if x 4 5)))",
  "(defn range-group (a b c) (range (range a b) c))",
  "section [form.bml] { class Rows<T> { def at(rows,i) = nth(rows,i); def values() = list(list(1,2),3); } }",
  "section [form.bml] { def list(x) = x; def range(a,b) = list(a,b); def take(rows) = nth(rows,0)(2); }",
  "section [form.bml] { // nth(rows,0)\n def text() = \"list(1,2) nth(rows,0)\"; def get(rows) = nth( // keep this note\n rows,0); }",
  "section [form.bml] { def get(xs,c) = nth(c ? xs : list(1,2),0); def numbers() = map(x => x + 1, range(0,3)); }",
  "section [form.bml] { def capture(k) = list(x => nth(x,0) * k); }",
  "section [form.bml] { def selected(c,xs) = nth(if c then xs else list(1,2),0); def values() = list(1,); }"
 );
 let results = map(source => head(form-source-lift(source,"lift-contract.fk")),cases);
 let surface = form-source-lift("section [form.bml] { def rows(xs) = list(nth(xs,0),range(0,3)); }","lift-contract.fk");
 if surface[1] != "section [form.bml] { def rows(xs) = [xs[0],(0 .. 3)]; }" then form_error("cursor lift did not apply collection syntax") else 0;
 let surfaces = filter(source => fsc-find-section-open(source,0) >= 0,cases);
 if !all?(source => form-bml-surface-equivalent?(source,fsl-surface-sections(source,0)),surfaces) then form_error("cursor lift changed compiler recipes") else 0;
 if form-bml-surface-equivalent?("section [form.bml] { def same(x: String,y) = x == y; }","section [form.bml] { def same(x: Value,y) = x == y; }") then form_error("surface proof erased comparison metadata") else 0;
 if !all?(identity,results) then { print(results); form_error("source lift changed a contract"); } else {
  let unsafe = form-source-lift("(defn literal (byte_to_str) \"a;b\")","lift-contract.fk");
  let scope = form-source-lift("(defn scopes (a) (do (let b (add a 1)) (defn inner (c) (mul b c)) (inner 2)))","lift-contract.fk");
  let shadow = form-source-lift("(defn shadow (false) false)","lift-contract.fk");
  if head(unsafe) || head(scope) || head(shadow) then form_error("shadowing or local binding changed unnoticed") else print(list("source-lift-contracts",len(results),"shadowing-and-binding-changes-refused",3));
 };
}
