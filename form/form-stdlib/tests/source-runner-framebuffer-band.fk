; source-runner-framebuffer-band.fk -- consented resident Form source exposes
; every top-level expression while preserving non-ONE acknowledgement arms.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk observe/live-call-framebuffer.fk form-stdlib/source-runner-framebuffer.fk

(let SRFBB-PROVENANCE (bp "SRFBB-PROVENANCE"))
(let SRFBB-LENS       (bp "SRFBB-LENS"))
(let SRFBB-CONSENT    (bp "SRFBB-CONSENT"))

(defn srfbb-cell (kind) (intern_node kind (empty)))

(defn srfbb-all-calls? (events)
    (if (eq (len events) 0) 1
        (if (eq (lcfb-call? (head events)) 0) 0
            (srfbb-all-calls? (tail events)))))

(defn srfbb-call-events (events)
    (if (eq (len events) 0) (empty)
        (if (eq (lcfb-call? (head events)) 1)
            (cons (head events) (srfbb-call-events (tail events)))
            (srfbb-call-events (tail events)))))

(defn srfbb-step-events (events)
    (if (eq (len events) 0) (empty)
        (if (eq (srfb-step? (head events)) 1)
            (cons (head events) (srfbb-step-events (tail events)))
            (srfbb-step-events (tail events)))))

(defn srfbb-ordinals? (events expected)
    (if (eq (len events) 0) 1
        (if (not (eq
                    (node_value (nth (node_children (head events)) 7))
                    expected)) 0
            (srfbb-ordinals? (tail events) (add expected 1)))))

(defn srfbb-run ()
    (do
        (let source
            "(do (defn dbl (n) (add n n)) (let x 7 (dbl x)) (mul 6 7))")
        (let provenance (srfbb-cell SRFBB-PROVENANCE))
        (let lens (srfbb-cell SRFBB-LENS))
        (let consent (oac-one (srfbb-cell SRFBB-CONSENT)))
        (let offer (srfb-offer source consent provenance lens))
        (let repeated-offer (srfb-offer source consent provenance lens))
        (let ack (srfb-run offer))
        (let result (oac-payload ack))
        (let steps (srfb-result-steps result))
        (let events (framebuffer-events))
        (let call-events (srfbb-call-events events))
        (let step-events (srfbb-step-events events))
        (let first-step (head steps))
        (let second-step (head (tail steps)))
        (let third-step (head (tail (tail steps))))
        (let declined-offer
            (srfb-offer source (oac-zero) provenance lens))
        (let declined (srfb-run declined-offer))
        (let declined-events (framebuffer-events))
        (sum (list
            (if (and (eq (oac-one? ack) 1)
                     (eq (srfb-result? result) 1)) 1 0)
            (if (eq (srfb-result-value result) 42) 2 0)
            (if (and (eq (len steps) 3)
                     (and (eq (srfb-step-value second-step) 14)
                          (eq (srfb-step-value third-step) 42))) 4 0)
            (if (and (eq (len events) 12)
                     (and (eq (len call-events) 9)
                          (and (eq (len step-events) 3)
                               (eq (srfbb-all-calls? call-events) 1)))) 8 0)
            (if (eq (srfbb-ordinals? call-events 0) 1) 16 0)
            (if (and (lt (srfb-step-start first-step)
                         (srfb-step-end first-step))
                     (lt (srfb-step-end first-step)
                         (srfb-step-start second-step))) 32 0)
            (if (and (eq (node_eq offer repeated-offer) 1)
                     (eq (node_eq (srfb-result-offer result) offer) 1)) 64 0)
            (if (eq (oac-zero? declined) 1) 128 0)
            (if (and (eq (len declined-events) 2)
                     (str_eq
                        (node_value
                            (nth (node_children (nth declined-events 1)) 6))
                        (srfb-target "not-accepted" 0 0 (str_len source)))) 256 0)
            (if (and (eq (srfb-step-index first-step) 0)
                     (eq (srfb-step-index third-step) 2)) 512 0)))))

(srfbb-run)
