; transmute-band.bml — the transmute organ's pure parts, fkwu-witnessed (form-stdlib/bml/transmute.bml).
;
; The organ lifts a passage's control words by the purify grammar, measures its register, reads the field's seeds from
; the parent's own index lines, finds which seeds an event resonates with, composes the five-layer event packet, and
; checks the ideas a voice names against the seeds. These claims are pure over fixture text; no voice is asked and
; nothing is written.
;
; Expected: 255
; Verdict 255 when every claim lands:
;    1   counting: "must" is sighted once in "You must leave. Mustard is yellow." and not inside "mustard"; case folds
;    2   lifts: a passage carrying "must" and "not" lifts exactly those two rows; a passage carrying none lifts none
;    4   register: the sightings sum across the grammar's words, so "The law says you must not." reads 3
;    8   the passage packet opens with the covenant card, carries the source, the lifted words and the passage, and asks
;        for the transmutation last
;   16   a concept line reads to its id, Hz and essence (the bold form with a status suffix, and the plain form); an
;        idea row reads to its id and its essence cell; a line of neither shape reads as no seed
;   32   resonance: the seed sharing the event's words stands first; a seed sharing none is not listed
;   64   the event packet carries the five headings in order, the shown seeds by id, and the event last
;  128   served: of the ids a voice names, only those the seeds hold are kept, in seed order
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/transmute.bml
section [form.bml] {
 class TransmuteBand {
  def tb-c-count(ctx) = tm-count("You must leave. Mustard is yellow.", "must") == 1 && tm-count("MUST and must", "must") == 2 && tm-count("a mustard seed", "must") == 0;
  def tb-c-lifts(ctx) {
   let two = tm-lifts("Citizens must not gather after dark, the ministry said.");
   let none = tm-lifts("The river rose two metres overnight, the village said.");
   len(two) == 2 && (String) wfp-word(two[0]) == "must" && (String) wfp-word(two[1]) == "not" && len(none) == 0;
  }
  def tb-c-register(ctx) = tm-register("The law says you must not.") == 3 && tm-register("A quiet morning.") == 0;
  def tb-c-packet(ctx) {
   let p = tm-packet("https://example.org/story", "You must not gather.", tm-lifts("You must not gather."));
   str_find(p, "UPLIFTING DIALOGUE", 0) >= 0 && str_find(p, "https://example.org/story", 0) > 0 && str_find(p, "must — common:", 0) > 0 && str_find(p, "The passage:", 0) > 0 && str_find(p, "The transmutation:", 0) > str_find(p, "The passage:", 0);
  }
  def tb-concepts() = "### Level 0\n- **[Energy](concepts/lc-energy.md)** ★ — 417 Hz — field metabolism | `status: deepening`\n- [Ceremony](concepts/lc-ceremony.md) — 963 Hz — field recognizes itself\n- a line of neither shape\n";
  def tb-ideas() = "| Idea | Pillar | Stage | Specs | Essence |\n|---|---|---|---|---|\n| [Light Hub Membrane](light-hub-membrane.md) | surfaces | impl | 1 | Service board, light identity, places, grocery ledger |\n| [Coherence Credit](coherence-credit.md) | economics | impl | 6 | CC as unit of account, cost and value measurement |\n";
  def tb-c-seeds(ctx) {
   let cs = tm-concept-seeds(tb-concepts());
   let is = tm-idea-seeds(tb-ideas());
   len(cs) == 2 && (String) tm-sid(cs[0]) == "lc-energy" && tm-shz(cs[0]) == 417 && (String) tm-sessence(cs[0]) == "field metabolism" && (String) tm-sid(cs[1]) == "lc-ceremony" && tm-shz(cs[1]) == 963 && (String) tm-sessence(cs[1]) == "field recognizes itself" && len(is) == 2 && (String) tm-sid(is[0]) == "light-hub-membrane" && (String) tm-sessence(is[0]) == "Service board, light identity, places, grocery ledger" && (String) tm-skind(is[0]) == "idea";
  }
  def tb-c-resonance(ctx) {
   let seeds = append(tm-idea-seeds(tb-ideas()), tm-concept-seeds(tb-concepts()));
   let rs = tm-resonance(seeds, "The village grocery ledger showed the service board's places and the cost of light.");
   len(rs) >= 1 && (String) tm-sid(rs[0][1]) == "light-hub-membrane" && rs[0][0] >= 3 && !tm-in?("lc-ceremony", map(p => tm-sid(p[1]), rs));
  }
  def tb-c-event-packet(ctx) {
   let seeds = append(tm-idea-seeds(tb-ideas()), tm-concept-seeds(tb-concepts()));
   let p = tm-event-packet("https://example.org/story", "Villagers marched over the cost of living.", [], seeds);
   let a = str_find(p, "What happened", 0);
   let b = str_find(p, "What it is asking for", 0);
   let c = str_find(p, "Which ideas it serves", 0);
   let d = str_find(p, "The gift", 0);
   let e = str_find(p, "The lift", 0);
   let s = str_find(p, "[light-hub-membrane]", 0);
   let v = str_find(p, "The event:", 0);
   str_find(p, "UPLIFTING DIALOGUE", 0) >= 0 && a > 0 && b > a && c > b && d > c && e > d && s > e && v > s && str_find(p, "The reading:", 0) > v;
  }
  def tb-c-served(ctx) {
   let seeds = append(tm-idea-seeds(tb-ideas()), tm-concept-seeds(tb-concepts()));
   let served = tm-served("This serves [lc-ceremony] and [coherence-credit], and also [lc-not-a-seed].", seeds);
   len(served) == 2 && (String) tm-sid(served[0]) == "coherence-credit" && (String) tm-sid(served[1]) == "lc-ceremony";
  }
 }
 live-claims("transmute-band", 0, [["count", 1, 1, tb-c-count], ["lifts", 2, 1, tb-c-lifts], ["register", 4, 1, tb-c-register], ["packet", 8, 1, tb-c-packet], ["seeds", 16, 1, tb-c-seeds], ["resonance", 32, 1, tb-c-resonance], ["event-packet", 64, 1, tb-c-event-packet], ["served", 128, 1, tb-c-served]]);
}
