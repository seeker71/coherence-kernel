; transmute-band.bml — the transmute organ's pure parts, fkwu-witnessed (form-stdlib/bml/transmute.bml).
;
; The organ lifts a passage's control words by the purify grammar, measures its register, and composes the packet the
; body's voice speaks from. These claims are pure over fixture text; no voice is asked and nothing is written.
;
; Expected: 15
; Verdict 15 when every claim lands:
;   1   counting: "must" is sighted once in "You must leave. Mustard is yellow." and not inside "mustard"; case folds
;   2   lifts: a passage carrying "must" and "not" lifts exactly those two rows; a passage carrying none lifts none
;   4   register: the sightings sum across the grammar's words, so "The law says you must not." reads 3
;   8   the packet opens with the covenant card, carries the source, the lifted words and the passage, and asks for
;       the transmutation last
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/transmute.bml
section [form.bml] {
 class TransmuteBand {
  def tb-c-count(ctx) = tm-count("You must leave. Mustard is yellow.", "must") == 1 && tm-count("MUST and must", "must") == 2 && tm-count("a mustard seed", "must") == 0;
  def tb-c-lifts(ctx) {
   let two = tm-lifts("Citizens must not gather after dark, the ministry said.");
   let none = tm-lifts("The river rose two metres overnight, the village said.");
   len(two) == 2 && (String) wfp-word(two[0]) == "must" && (String) wfp-word(two[1]) == "not" && len(none) == 0;
  }
  def tb-c-register(ctx) = tm-register("The law says you must not.") == 3 && tm-register("A quiet morning.") == 0;
  def tb-c-packet(ctx) {
   let p = tm-packet("https://example.org/story", "You must not gather.", tm-lifts("You must not gather."));
   str_find(p, "UPLIFTING DIALOGUE", 0) >= 0 && str_find(p, "https://example.org/story", 0) > 0 && str_find(p, "must — common:", 0) > 0 && str_find(p, "The passage:", 0) > 0 && str_find(p, "The transmutation:", 0) > str_find(p, "The passage:", 0);
  }
 }
 live-claims("transmute-band", 0, [["count", 1, 1, tb-c-count], ["lifts", 2, 1, tb-c-lifts], ["register", 4, 1, tb-c-register], ["packet", 8, 1, tb-c-packet]]);
}
