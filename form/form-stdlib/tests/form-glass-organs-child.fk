; form-glass-organs-child.fk — the organs process the events/channels band spawns: three ticks into the band's own space, then it
; stays a moment so the band can take the frame from a process that is still alive.
; preludes: form/form-stdlib/form-glass-organs.bml

(do
    (let done (fgor-run-ticks "/tmp/form-glass-organs-band" 3 (fgor-state-empty)))
    (host_sleep_ms 5000))
