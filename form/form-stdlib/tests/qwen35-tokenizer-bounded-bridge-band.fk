; qwen35-tokenizer-bounded-bridge-band.fk -- pure progress/lifecycle proof.
;
; The GGUF extraction and file-backed encode are effectful and therefore live
; elsewhere.  This band fixes the resumable state, source freshness, bounded
; breath, raw-byte compatibility, and resource/lifecycle vocabulary without
; opening a model or filesystem artifact.
;
; preludes: form-stdlib/qwen35-tokenizer-bounded-bridge.fk

(do
    (defn q35tbbb-bit (ok bit) (if ok bit 0))
    (let p (q35tbb-progress 1 29047086048 1787570000 0 17 10997123
                            17 0 381 31 8))
    (let parsed (q35tbb-parse-progress-cursor
        (cursor-str (q35tbb-progress-text p)) (q35tba-max-row-bytes)))
    (let p2 (q35tbb-progress-result-value parsed))
    (let next (q35tbb-progress-next p 0 18 10997154 18 0 29 29 16))
    (let breath (q35tbb-breath-result "progress" next 16 1 29 29
                                       1 1 0 0 0 0 1 "breath-complete"))
    (let encoded0 (q35tbb-encode-result "ok" (list 0) 1 1 0 1 1 12 0 0 1 "exact"))
    (let encoded1 (q35tbb-encode-result "ok" (list 1) 1 1 0 1 1 12 0 0 1 "exact"))
    (let absent (q35tbb-encode-result "miss" (nothing) 0 1 0 1 1 12 0 1 1 "absent"))
    (sum (list
        (q35tbbb-bit (str_eq (q35tbb-progress-result-status parsed) "ok") 1)
        (q35tbbb-bit (and (eq (q35tbb-progress-next-index p2) 17)
                            (eq (q35tbb-progress-next-off p2) 10997123)) 2)
        (q35tbbb-bit (eq (q35tbb-progress-current? p2 29047086048 1787570000) 1) 4)
        (q35tbbb-bit (eq (q35tbb-progress-current? p2 29047086049 1787570000) 0) 8)
        (q35tbbb-bit (and (eq (q35tbb-progress-next-index next) 18)
                            (eq (q35tbb-progress-appended-bytes next) 410)) 16)
        (q35tbbb-bit (and (eq (q35tbb-progress-peak-row next) 31)
                            (eq (q35tbb-progress-max-batch next) 16)) 32)
        (q35tbbb-bit (and (eq (q35tbb-breath-window breath) 256)
                            (nothing? (q35tbb-breath-os-peak-rss breath))) 64)
        (q35tbbb-bit (and (eq (q35tbb-breath-choices breath) 1)
                            (and (eq (q35tbb-breath-cuts breath) 1)
                                 (eq (q35tbb-breath-releases breath) 1))) 128)
        (q35tbbb-bit (q35tba-list-eq (q35tbb-string-bytes "Form")
                                     (list 70 111 114 109)) 256)
        (q35tbbb-bit (and (eq (head (q35tbb-encode-ids encoded0)) 0)
                            (not (nothing? (q35tbb-encode-ids encoded0)))) 512)
        (q35tbbb-bit (and (eq (head (q35tbb-encode-ids encoded1)) 1)
                            (not (nothing? (q35tbb-encode-ids encoded1)))) 1024)
        (q35tbbb-bit (and (eq (q35tbb-encode-present? absent) 0)
                            (and (nothing? (q35tbb-encode-ids absent))
                                 (eq (q35tbb-encode-released? absent) 1))) 2048))))
