; living-world-transformation-nursery-successor-band.fk -- growth re-enters action.
; Verdict 32767 proves fifteen re-offer, selection, execution, and revocation claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk

(do
    (let fixture (lwtnw-build-target))
    (let target (lwtnw-target fixture))
    (let growth-fixture (lwtnw-integrated-growth fixture))
    (let growth-world
        (lwt-round-world (lwtnw-growth-round growth-fixture)))
    (let growth-candidate (lwtnw-growth-candidate growth-fixture))
    (let successor
        (lwtn-successor-offer growth-world growth-candidate))
    (let before-field (lwac-field-for growth-world target 2))
    (let reoffered-world
        (lwt-receive-stream growth-world
            (list
                (lwtnw-entry-y successor)
                (lwtnw-entry-z successor))))
    (let action-field (lwac-field-for reoffered-world target 2))
    (let selection-proposal
        (lwac-selection-proposal reoffered-world target 2))
    (let selection-candidate
        (lwt-proposal-candidate selection-proposal))
    (let selection-round
        (lwt-round reoffered-world
            (lwo-field (list selection-proposal))
            (lwo-empty-field) (lwtnw-growth-round growth-fixture)))
    (let selection-waiting
        (lwac-selection-integrate selection-round selection-proposal
            (lwigw-action)))
    (let selection-yes
        (lwt-round-receive selection-round
            (lwtnw-response-entries selection-proposal
                (lwtnw-successor-participants))))
    (let selection-integrated
        (lwac-selection-integrate selection-yes selection-proposal
            (lwigw-action)))
    (let selection-world (lwt-round-world selection-integrated))
    (let execution-proposal
        (lwac-execution-proposal selection-world selection-candidate
            (intern_trivial_int 5) (lwtnw-evidence)))
    (let execution-candidate
        (lwt-proposal-candidate execution-proposal))
    (let execution-shape
        (lwo-emergent-shape execution-candidate))
    (let execution-round
        (lwt-round selection-world
            (lwo-field (list execution-proposal))
            (lwo-empty-field) selection-integrated))
    (let execution-waiting
        (lwac-execution-integrate execution-round execution-proposal
            (lwigw-action)))
    (let execution-yes
        (lwt-round-receive execution-round
            (lwtnw-response-entries execution-proposal
                (lwtnw-successor-participants))))
    (let execution-integrated
        (lwac-execution-integrate execution-yes execution-proposal
            (lwigw-action)))
    (let execution-world (lwt-round-world execution-integrated))
    (let actual (lwac-execution-actual execution-shape))
    (let revocation
        (lwo-revocation successor (lwtnw-source-y)
            (lwtnw-reason) (lwtnw-prov-y)))
    (let revoked-world
        (lwt-receive-stream execution-world
            (list (lwtnw-entry-y revocation))))

    (let c1
        (if (and (eq (lwtn-growth-integrated-current?
                         growth-world growth-candidate) 1)
                 (eq (lwac-offer-valid? successor) 1)) 1 0))
    (let c2
        (if (and (eq (lwac-open? (lwac-field-status before-field)) 1)
                 (node_eq (lwac-selection-proposal growth-world target 2)
                          (lwo-none))) 2 0))
    (let c3
        (if (and (eq (lwac-ready? (lwac-field-status action-field)) 1)
                 (node_eq
                    (lwac-intention-action
                        (lwac-intention-evidence-intention
                            (lwac-field-primary action-field)))
                    (lwtnw-recipe-e))) 4 0))
    (let c4
        (if (and (eq (lwo-field-size
                         (lwt-proposal-participants selection-proposal)) 9)
                 (eq (lwac-selection-proposal-current?
                         reoffered-world selection-proposal) 1)) 8 0))
    (let c5
        (if (eq (lwo-active?
                    (lwt-round-world selection-waiting)
                    selection-candidate) 0) 16 0))
    (let c6
        (if (eq (lwac-selection-integrated-current?
                    selection-world selection-candidate) 1) 32 0))
    (let c7
        (if (and (node_eq (lwac-execution-intention execution-shape)
                          (lwac-intention-evidence-intention
                            (lwac-field-primary action-field)))
                 (node_eq (lwac-intention-focus
                              (lwac-execution-intention execution-shape))
                          target)) 64 0))
    (let c8
        (if (and (eq (lwo-field-size
                         (lwt-proposal-participants execution-proposal)) 9)
                 (eq (lwac-execution-proposal-current?
                         selection-world execution-proposal) 1)) 128 0))
    (let c9
        (if (eq (lwo-active?
                    (lwt-round-world execution-waiting)
                    execution-candidate) 0) 256 0))
    (let c10
        (if (eq (lwac-execution-integrated-current?
                    execution-world execution-candidate) 1) 512 0))
    (let c11
        (if (and (node_eq
                    (lwre-trace-recipe
                        (lwac-execution-trace execution-shape))
                    (lwtnw-recipe-e))
                 (node_eq
                    (lwre-result-primary
                        (lwre-trace-result
                            (lwac-execution-trace execution-shape)))
                    (intern_trivial_int 4))) 1024 0))
    (let c12
        (if (and (node_eq (lwac-delta-before actual)
                          (intern_trivial_int 1))
                 (and (node_eq (lwac-delta-after actual)
                               (intern_trivial_int 4))
                      (node_eq (lwac-delta-lens actual)
                               (lwtnw-lens-e)))) 2048 0))
    (let c13
        (if (and (eq (oac-one?
                         (lwac-execution-comparison execution-shape)) 1)
                 (node_eq (oac-payload
                              (lwac-execution-comparison execution-shape))
                          actual)) 4096 0))
    (let c14
        (if (node_eq (lwac-execution-prediction execution-shape)
                     actual) 8192 0))
    (let c15
        (if (and (eq (lwac-selection-integrated-current?
                         revoked-world selection-candidate) 0)
                 (eq (lwac-execution-integrated-current?
                         revoked-world execution-candidate) 0)) 16384 0))
    (lwtnw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
