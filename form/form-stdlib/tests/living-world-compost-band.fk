; living-world-compost-band.fk -- all holders release one current-world root.
; Verdict 1023 proves ten consent, dependency, and reversibility properties.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-compost.fk form-stdlib/tests/living-world-compost-witness.fk

(do
    (let base (lwcw-base-world))
    (let active-refused (lwc-compost-proposal base (lwcw-target)))
    (let after-a (lwcw-release-a base))
    (let after-a-refused
        (lwc-compost-proposal after-a (lwcw-target)))
    (let after-b (lwcw-release-b after-a))
    (let dependent-refused
        (lwc-compost-proposal after-b (lwcw-target)))
    (let ready-world (lwcw-release-dependent after-b))
    (let proposal (lwc-compost-proposal ready-world (lwcw-target)))
    (let plan (lwt-proposal-candidate proposal))
    (let partial-world (lwcw-partial-response-world ready-world proposal))
    (let partial-outcome (lwt-evaluate-proposal partial-world proposal))
    (let partial-transition (lwc-integrate partial-world proposal))
    (let unanimous-world
        (lwcw-unanimous-response-world partial-world proposal))
    (let transition (lwc-integrate unanimous-world proposal))
    (let successor (lwo-transition-world transition))
    (let receipt (oac-payload (lwo-transition-ack transition)))

    (let c1 (if (node_eq active-refused (lwo-none)) 1 0))
    (let c2 (if (node_eq after-a-refused (lwo-none)) 2 0))
    (let c3 (if (and (eq (lwo-active? after-b (lwcw-target)) 0)
                         (node_eq dependent-refused (lwo-none))) 4 0))
    (let c4 (if (and (not (node_eq proposal (lwo-none)))
                         (and (eq (lwo-field-size
                                      (lwt-proposal-participants proposal)) 3)
                              (eq (lwo-field-size
                                      (lwc-plan-attributions plan)) 3))) 8 0))
    (let c5 (if (and (node_eq (lwt-outcome-status partial-outcome)
                               (lwt-status-waiting))
                         (and (eq (lwt-outcome-yes partial-outcome) 2)
                              (eq (lwt-outcome-missing partial-outcome) 1))) 16 0))
    (let c6 (if (and (eq (oac-zero?
                              (lwo-transition-ack partial-transition)) 1)
                         (node_eq (lwo-transition-world partial-transition)
                                  partial-world)) 32 0))
    (let c7 (if (and (eq (oac-node? (lwo-transition-ack transition)) 1)
                         (eq (lwc-receipt? receipt) 1)) 64 0))
    (let c8 (if (and (eq (lwc-world-contains?
                              successor (lwcw-target)) 0)
                         (and (eq (lwo-world-has?
                                      successor (lwcw-target)) 0)
                              (eq (lwo-world-has?
                                      successor (lwcw-dependent)) 0))) 128 0))
    (let c9 (if (and (eq (lwc-world-contains?
                              unanimous-world (lwcw-target)) 1)
                         (node_eq (lwc-receipt-prior-world receipt)
                                  unanimous-world)) 256 0))
    (let c10 (if (and (node_eq (lwc-receipt-successor-world receipt)
                                successor)
                          (and (node_eq (lwc-receipt-target receipt)
                                        (lwcw-target))
                               (eq (lwo-field-size
                                    (lwc-receipt-attributions receipt)) 3))) 512 0))
    (lwcw-sum (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10)))
