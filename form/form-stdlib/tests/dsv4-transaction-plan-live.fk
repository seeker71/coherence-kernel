; Real DS4 descriptor witness for the cached transaction recipe.  This reads
; the configured GGUF metadata but does not open or contend for a Metal model
; session.
;
; preludes: native/metal/dsv4-layer-walk.fk

(do
    (let src (eqr-of-file (dlp-model-path) 0 (gm-window)))
    (let base (egg-data-base src (gm-alignment)))
    (let descs
        (dlp-collect
            src base (egg-tinfo-start src) (egg-tensor-count src)))
    (let plan (dlw-layer-plan src descs 0))
    (let recipe (dlw-layer-transaction-recipe plan 17 3))
    (if (and
            (eq (len plan) 61)
            (and
                (eq (str_find recipe
                        "f16_matvec\tdsv4-f16\tform_dsv4_f16_matvec\t" 0)
                    0)
                (and
                    (ge (str_find recipe "hash_route\tdsv4-route\t" 0) 0)
                    (and
                        (ge (str_find recipe
                                " 17 6 1.5 0.00006103515625\n" 0)
                            0)
                        (ge (str_find recipe
                                "state_save\tlayer0-output-streams\n" 0)
                            0)))))
        255
        0))
