; form-cli-resident-recipe-birth-exec-band.fk — pure two-crossing witness.
;
; Verdict 16777215 (24 bits):
;   1        seven new protocol categories are fixed and pairwise distinct
;   2        birth recognition crosses split chunks as raw bytes
;   4        a recipe containing exact integer 0 and 1 is born ready
;   8        birth observation is scannerless and executes neither carrier/model
;   16       invocation resolves the born NodeID, not the fixed demo recipe
;   32       request identity retains born recipe, input and carrier
;   64       request observation is distinct from birth observation
;   128      ready request carries choice/cut/release
;   256      malformed request carries failure/undo/refine/cut/release
;   512      request timeout carries timeout/cut/undo/refine/release
;   1024     generated MSL is composed directly from born 0/1 children
;   2048     code and code-observation identities remain separate
;   4096     present value 0 is not nothing
;   8192     present value 1 is not nothing
;   16384    nothing has value-present=0 and a distinct observation identity
;   32768    value execution carries choice/crystallize/dissolve/release
;   65536    execution failure carries undo/refine
;   131072   execution timeout carries cut/undo/refine
;   262144   request/code/execution observations have distinct categories
;   524288   bounded rendering names lineage without replaying control surfaces
;   1048576 pure shape claims no native execution and model-executed=0
;   2097152 model birth/invoke/answer lanes remain separate
;   4194304 birth and execution injections remain separate from model bytes
;   8388608 equal birth content shares identity; changed content does not
;
; preludes: form-stdlib/form-cli-resident-recipe-birth-exec.fk

(do
    (defn frbeb-bit (ok bit) (if ok bit 0))
    (defn frbeb-different-from? (node rest)
        (if (eq (len rest) 0) 1
            (if (node_eq node (head rest)) 0
                (frbeb-different-from? node (tail rest)))))
    (defn frbeb-distinct? (nodes)
        (if (lt (len nodes) 2) 1
            (if (eq (frbeb-different-from? (head nodes) (tail nodes)) 1)
                (frbeb-distinct? (tail nodes)) 0)))
    (defn frbeb-has-all-ready? (trace)
        (if (and (eq (frbe-trace-has? trace "choice") 1)
            (and (eq (frbe-trace-has? trace "cut") 1)
                 (eq (frbe-trace-has? trace "release") 1))) 1 0))

    (defn form-cli-resident-recipe-birth-exec-band ()
        (do
            (let categories (list
                (frbe-request-category)
                (frbe-request-observation-category)
                (frbe-code-observation-category)
                (frbe-execution-category)
                (frbe-execution-observation-category)
                (frbe-event-category)
                (frbe-absent-category)))
            (let expected (list
                (make_nodeid 31 2 0 101)
                (make_nodeid 31 2 0 102)
                (make_nodeid 31 2 0 103)
                (make_nodeid 31 2 0 104)
                (make_nodeid 31 2 0 105)
                (make_nodeid 31 2 0 106)
                (make_nodeid 31 2 0 107)))

            (let birth-surface (frbt-surface 0 1))
            (let split-at 17)
            (let birth-c1 (frbe-birth-frame-feed (frbe-frame-fresh)
                (str_concat "ordinary-prefix"
                    (substring birth-surface 0 split-at))))
            (let birth-c2 (frbe-birth-frame-feed birth-c1
                (substring birth-surface split-at (str_len birth-surface))))
            (let born (frbe-birth-from-frame (frbe-frame-value birth-c2)))
            (let birth-result (frbe-birth-result born))
            (let birth-observed (frbe-birth-observation born))
            (let birth-observation
                (frbt-observation-token birth-observed))
            (let recipe (frbt-result-recipe birth-result))

            (let request-surface (frex-surface recipe 0 "auto"))
            (let request (frbe-parse-exec-frame recipe request-surface))
            (let request-observed (frbe-request-observation request))
            (let request-observation
                (frbe-request-observation-token request-observed))
            (let request-trace
                (frbe-request-observation-trace request-observed))
            (let malformed (frbe-parse-exec-frame recipe
                (str_concat (frex-open)
                    (str_concat "@31.2.0.999;input=x;carrier=auto"
                        (frex-close)))))
            (let malformed-trace (frbe-request-trace malformed))
            (let timed (frbe-timeout-request "frame-budget-exceeded"
                recipe (add (frex-max-frame-bytes) 1)))
            (let timed-trace (frbe-request-trace timed))

            (let zero (frbe-scripted-result birth-observation request
                "value" "scripted-zero" 0 1))
            (let one (frbe-scripted-result birth-observation request
                "value" "scripted-one" 1 1))
            (let absent (frbe-scripted-result birth-observation request
                "nothing" "scripted-nothing" 0 0))
            (let failed (frbe-scripted-result birth-observation request
                "failure" "scripted-failure" 0 0))
            (let timeout (frbe-scripted-result birth-observation request
                "timeout" "scripted-timeout" 0 0))
            (let code (frbe-result-code zero))
            (let code-observation (frbe-result-code-observation zero))
            (let rendered (frbe-result-render birth-observation zero))

            (let movement (frbe-movement "opaque-session" 2 birth-c2
                (frbe-frame-fresh) birth-observation request zero
                "birth-model" "invoke-model" "answer-model"
                "birth-observation" "execution-observation"
                (list 1 2) (list 3 4 5) (list 6)))
            (let born2 (frbe-birth-from-frame birth-surface))
            (let changed (frbe-birth-from-frame (frbt-surface 1 0)))

            (sum (list
                (frbeb-bit (and (eq (len categories) 7)
                    (and (eq (frbeb-distinct? categories) 1)
                         (eq (frbeb-distinct? (append categories expected)) 0))) 1)
                (frbeb-bit (and (str_eq (frbe-frame-terminal birth-c2)
                                        "complete")
                    (and (str_eq (frbe-frame-value birth-c2) birth-surface)
                    (and (eq (frbe-frame-chunks birth-c2) 2)
                         (eq (frbe-pretokenized?) 0)))) 2)
                (frbeb-bit (and (str_eq (frbt-result-status birth-result)
                                        "ready")
                    (and (eq (frbt-recipe-mul recipe) 0)
                         (eq (frbt-recipe-add recipe) 1))) 4)
                (frbeb-bit (and
                    (eq (frbt-observation-scannerless? birth-observed) 1)
                    (and (eq (frbt-observation-carrier-executed?
                                birth-observed) 0)
                         (eq (frbt-observation-model-executed?
                                birth-observed) 0))) 8)
                (frbeb-bit (and (eq (frbe-request-ready? request) 1)
                    (and (node_eq (frbe-request-recipe request) recipe)
                         (not (node_eq recipe (frex-recipe))))) 16)
                (frbeb-bit (and (eq (frbe-request-node-valid? request) 1)
                    (and (node_eq (nth (node_children
                            (frbe-request-token request)) 0) recipe)
                    (and (eq (node_value (nth (node_children
                            (frbe-request-token request)) 1)) 0)
                         (str_eq (node_value (nth (node_children
                            (frbe-request-token request)) 2)) "auto")))) 32)
                (frbeb-bit (and
                    (not (node_eq request-observation birth-observation))
                    (and (node_eq (node_category request-observation)
                                  (frbe-request-observation-category))
                         (node_eq (nth (node_children request-observation) 1)
                                  recipe))) 64)
                (frbeb-bit (frbeb-has-all-ready? request-trace) 128)
                (frbeb-bit (and (eq (frbe-trace-has? malformed-trace
                                             "failure") 1)
                    (and (eq (frbe-trace-has? malformed-trace "undo") 1)
                    (and (eq (frbe-trace-has? malformed-trace "refine") 1)
                    (and (eq (frbe-trace-has? malformed-trace "cut") 1)
                         (eq (frbe-trace-has? malformed-trace "release") 1)))))
                    256)
                (frbeb-bit (and (eq (frbe-trace-has? timed-trace
                                             "timeout") 1)
                    (and (eq (frbe-trace-has? timed-trace "cut") 1)
                    (and (eq (frbe-trace-has? timed-trace "undo") 1)
                    (and (eq (frbe-trace-has? timed-trace "refine") 1)
                         (eq (frbe-trace-has? timed-trace "release") 1))))) 512)
                (frbeb-bit (and (eq (frexl-code-valid? code recipe) 1)
                    (and (ge (str_find (frexl-msl recipe) " * 0" 0) 0)
                         (ge (str_find (frexl-msl recipe) " + 1" 0) 0))) 1024)
                (frbeb-bit (and (not (node_eq code code-observation))
                    (and (node_eq (node_category code-observation)
                                  (frbe-code-observation-category))
                         (node_eq (nth (node_children code-observation) 2)
                                  code))) 2048)
                (frbeb-bit (and (str_eq (frbe-result-status zero) "value")
                    (and (eq (frbe-result-value-present? zero) 1)
                         (eq (frbe-result-value zero) 0))) 4096)
                (frbeb-bit (and (str_eq (frbe-result-status one) "value")
                    (and (eq (frbe-result-value-present? one) 1)
                         (eq (frbe-result-value one) 1))) 8192)
                (frbeb-bit (and (str_eq (frbe-result-status absent) "nothing")
                    (and (eq (frbe-result-value-present? absent) 0)
                         (not (node_eq (frbe-result-observation absent)
                                       (frbe-result-observation zero))))) 16384)
                (frbeb-bit (and (eq (frbe-trace-has?
                            (frbe-result-trace zero) "choice") 1)
                    (and (eq (frbe-trace-has? (frbe-result-trace zero)
                                                   "crystallize") 1)
                    (and (eq (frbe-trace-has? (frbe-result-trace zero)
                                                   "dissolve") 1)
                         (eq (frbe-trace-has? (frbe-result-trace zero)
                                                   "release") 1)))) 32768)
                (frbeb-bit (and (eq (frbe-trace-has?
                            (frbe-result-trace failed) "failure") 1)
                    (and (eq (frbe-trace-has? (frbe-result-trace failed)
                                                   "undo") 1)
                         (eq (frbe-trace-has? (frbe-result-trace failed)
                                                   "refine") 1))) 65536)
                (frbeb-bit (and (eq (frbe-trace-has?
                            (frbe-result-trace timeout) "timeout") 1)
                    (and (eq (frbe-trace-has? (frbe-result-trace timeout)
                                                   "cut") 1)
                    (and (eq (frbe-trace-has? (frbe-result-trace timeout)
                                                   "undo") 1)
                         (eq (frbe-trace-has? (frbe-result-trace timeout)
                                                   "refine") 1)))) 131072)
                (frbeb-bit (frbeb-distinct? (list
                    (frbe-result-request-observation zero)
                    (frbe-result-code-observation zero)
                    (frbe-result-execution zero)
                    (frbe-result-observation zero))) 262144)
                (frbeb-bit (and (gt (str_len rendered) 0)
                    (and (le (str_len rendered) (frbe-max-render-bytes))
                    (and (ge (str_find rendered "birth-observation-node=@" 0) 0)
                    (and (ge (str_find rendered "request-observation-node=@" 0) 0)
                    (and (ge (str_find rendered "code-observation-node=@" 0) 0)
                    (and (ge (str_find rendered "execution-observation-node=@" 0)
                             0)
                    (and (lt (str_find rendered birth-surface 0) 0)
                         (lt (str_find rendered request-surface 0) 0)))))))) 524288)
                (frbeb-bit (and (eq (frbe-result-native-code-generated? zero) 0)
                    (and (eq (frbe-result-executed? zero) 0)
                         (eq (frbe-result-model-executed? zero) 0))) 1048576)
                (frbeb-bit (and
                    (str_eq (frbe-movement-birth-model movement) "birth-model")
                    (and (str_eq (frbe-movement-invoke-model movement)
                                 "invoke-model")
                    (and (str_eq (frbe-movement-answer-model movement)
                                 "answer-model")
                    (and (eq (len (frbe-movement-birth-ids movement)) 2)
                    (and (eq (len (frbe-movement-invoke-ids movement)) 3)
                         (eq (len (frbe-movement-answer-ids movement)) 1))))))
                    2097152)
                (frbeb-bit (and (eq (frbe-movement-crossings movement) 2)
                    (and (eq (frbe-movement-model-bytes movement)
                             (add (str_len "birth-model")
                             (add (str_len "invoke-model")
                                  (str_len "answer-model"))))
                         (eq (frbe-movement-injected-bytes movement)
                             (add (str_len "birth-observation")
                                  (str_len "execution-observation"))))) 4194304)
                (frbeb-bit (and (node_eq recipe
                        (frbt-result-recipe (frbe-birth-result born2)))
                    (not (node_eq recipe
                        (frbt-result-recipe (frbe-birth-result changed)))))
                    8388608)))))

    (form-cli-resident-recipe-birth-exec-band))
