; form-cli-peer-research-contribution-band.fk — research/evaluation speech
; contributes only after the body's primary+negative-control validator observes
; every declared meaning.  No model, carrier, file, shell, or network opens.
;
; Verdict 4095:
;   1    fluent/nonempty speech with no observation contributes zero
;   2    a fully observed PASS contributes as observed-research
;   4    a fully observed REVISE finding also contributes as observed-research
;   8    incomplete/open evidence contributes zero
;   16   stale evidence contributes zero
;   32   duplicate meaning coverage contributes zero
;   64   evidence for different response bytes contributes zero
;   128  empty response contributes zero even with determinate rows
;   256  existing recipe callback remains contribution one and keeps its kind
;   512  callback assessment can retain language nothing as evidence
;   1024 observed row values preserve integer zero and one distinctly
;   2048 assessment retains the original result without rewriting speech
;
; preludes: form-stdlib/form-cli-peer-agent.fk
(do
    (defn fcparb-bit (held weight) (if held weight 0))
    (let ctx (list "opaque-context"))
    (let sts (list "opaque-state"))
    (let session (fcms-session "live" "opened" "m.gguf" "src" ctx sts
        2048 50 0 0 49 4 3 1))
    (let cursor (frxc-fresh))
    (let research-result
        (fcpa-result session cursor "the negative control exposes the bypass" 7 0))
    (let callback-result
        (fcpa-result session cursor "carrier returned 42" 5 1))
    (let empty-result (fcpa-result session cursor "" 1 0))

    (let pass-row (ro-row 108 1 1 1 0 0 1 1))
    (let revise-row (ro-row 109 1 0 1 0 0 1 1))
    (let open-row (ro-row 110 1 1 1 0 0 0 1))
    (let stale-row (ro-row 111 1 1 1 0 0 1 0))
    (let pass-observation
        (fcpa-research-observation (fcpa-response research-result)
                                   (list pass-row) 1))
    (let revise-observation
        (fcpa-research-observation (fcpa-response research-result)
                                   (list revise-row) 1))
    (let open-observation
        (fcpa-research-observation (fcpa-response research-result)
                                   (list open-row) 1))
    (let stale-observation
        (fcpa-research-observation (fcpa-response research-result)
                                   (list stale-row) 1))
    (let duplicate-observation
        (fcpa-research-observation (fcpa-response research-result)
                                   (list pass-row pass-row) 2))
    (let wrong-response-observation
        (fcpa-research-observation "different fluent bytes" (list pass-row) 1))
    (let empty-observation
        (fcpa-research-observation "" (list pass-row) 1))

    (let unvalidated (fcpa-assess research-result (nothing)))
    (let passed (fcpa-assess research-result pass-observation))
    (let revised (fcpa-assess research-result revise-observation))
    (let opened (fcpa-assess research-result open-observation))
    (let stale (fcpa-assess research-result stale-observation))
    (let duplicate (fcpa-assess research-result duplicate-observation))
    (let wrong (fcpa-assess research-result wrong-response-observation))
    (let empty-speech (fcpa-assess empty-result empty-observation))
    (let callback (fcpa-assess callback-result (nothing)))

    (sum (list
        (fcparb-bit (and
            (eq (fcpa-assessment-contribution unvalidated) 0)
            (str_eq (fcpa-assessment-kind unvalidated)
                    "unvalidated-speech")) 1)
        (fcparb-bit (and
            (eq (fcpa-assessment-contribution passed) 1)
            (str_eq (fcpa-assessment-kind passed) "observed-research")) 2)
        (fcparb-bit (and
            (eq (fcpa-assessment-contribution revised) 1)
            (eq (fcpa-research-verdict revise-observation) (ro-revise))) 4)
        (fcparb-bit (eq (fcpa-assessment-contribution opened) 0) 8)
        (fcparb-bit (eq (fcpa-assessment-contribution stale) 0) 16)
        (fcparb-bit (eq (fcpa-assessment-contribution duplicate) 0) 32)
        (fcparb-bit (eq (fcpa-assessment-contribution wrong) 0) 64)
        (fcparb-bit (eq (fcpa-assessment-contribution empty-speech) 0) 128)
        (fcparb-bit (and
            (eq (fcpa-assessment-contribution callback) 1)
            (str_eq (fcpa-assessment-kind callback) "recipe-callback")) 256)
        (fcparb-bit (nothing? (fcpa-assessment-evidence callback)) 512)
        (fcparb-bit (and
            (eq (ro-primary-observe pass-row) 1)
            (eq (ro-control-observe pass-row) 0)) 1024)
        (fcparb-bit (and
            (node_eq (fcpa-assessment-result passed) research-result)
            (str_eq (fcpa-response (fcpa-assessment-result passed))
                    "the negative control exposes the bypass")) 2048))))
