; Reject nonfinite device values before they can become enormous fake floats.
; Expected 15. Pure IEEE-754 byte fixtures.
; preludes: form-stdlib/qwen-lora-train.fk
(do
 (defn qlfb-raw (u) (byte_to_str (mod u 256)))
 (defn qlfb-word (u) (str_concat (qlfb-raw u) (str_concat (qlfb-raw (div u 256)) (str_concat (qlfb-raw (div u 65536)) (qlfb-raw (div u 16777216))))))
 (sum (list
  (if (nil? (qlt-f32s (qlfb-word 2139095040) 1)) 1 0)
  (if (nil? (qlt-f32s (qlfb-word 4286578688) 1)) 2 0)
  (if (nil? (qlt-f32s (qlfb-word 2143289344) 1)) 4 0)
  (if (eq (head (qlt-f32s (qlfb-word 3221225472) 1)) -2.0) 8 0))))
