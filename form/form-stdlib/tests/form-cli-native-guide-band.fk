; The real heal dispatcher guides a proposed command without entering repair.
; preludes: form-stdlib/bml/form-cli-heal.bml
; witnessed: 2026-09-09 -> 7
(do
 (let answer (parse-json "guide" (fh-command "guide|python3 form/scripts/gen_flt_ops_from_manifest.py --write")))
 (add (if (str_eq (json-string-value (json-object-get answer "kind")) "native-command-guidance") 1 0)
  (add (if (str_eq (json-string-value (json-object-get answer "signal")) "python-interpreter") 2 0)
   (if (str_eq (json-string-value (json-object-get (json-object-get answer "native") "source")) "observe/native-op-emitter-run.fk") 4 0))))
