; form-knowledge-public-family-challenge-seals-band.fk -- cold proof that the
; hot family challenge seals still equal SHA-256 of every public prompt.
;
; Expected: 32767 (15/15 canonical families).
; This is intentionally a cold/slow witness. Physical execution consumes the
; crystallized values and does not repeat these byte walks on every request.
; preludes: form-stdlib/form-knowledge-public-family-mastery.fk

(do
    (defn fkpfcsb-bit (row weight)
        (if (str_eq (fkpfm-family-challenge-sha (fkhe-family row))
                    (nmfe-sha256 (fkhe-prompt row))) weight 0))

    (defn form-knowledge-public-family-challenge-seals-band ()
        (do
            (let rows (fkhe-rows))
            (sum (list
                (fkpfcsb-bit (nth rows 0) 1)
                (fkpfcsb-bit (nth rows 1) 2)
                (fkpfcsb-bit (nth rows 2) 4)
                (fkpfcsb-bit (nth rows 3) 8)
                (fkpfcsb-bit (nth rows 4) 16)
                (fkpfcsb-bit (nth rows 5) 32)
                (fkpfcsb-bit (nth rows 6) 64)
                (fkpfcsb-bit (nth rows 7) 128)
                (fkpfcsb-bit (nth rows 8) 256)
                (fkpfcsb-bit (nth rows 9) 512)
                (fkpfcsb-bit (nth rows 10) 1024)
                (fkpfcsb-bit (nth rows 11) 2048)
                (fkpfcsb-bit (nth rows 12) 4096)
                (fkpfcsb-bit (nth rows 13) 8192)
                (fkpfcsb-bit (nth rows 14) 16384)))))

    (form-knowledge-public-family-challenge-seals-band))
