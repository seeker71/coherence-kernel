; form-choice-flow-sources-band — every wired source gives a choice point whose
; ledger is the count the body already holds, and the frame gives them back.
;
; Expected: 32767
;
; The claims, each a power of two:
;   1     the live page's native flag splits into taken, held and declined, and
;         the held rows' heat is the wait a walking recipe has already served
;   2     the float page reads as BOTH legs: slots minted and bodies folded
;   4     the box point is a real two-way choice: it read as a corridor only
;         while nothing counted the leg it was choosing against
;   8     the mint ledger splits a call into reuse (taken) and arena growth
;   16    the organs frame's own counts arrive as NUMBERS -- attempts from the
;         routing row, the part carried from the choice row -- and the movement
;         states it publishes in the row's channels become the point's options,
;         seven of them, none written down here
;   32    the protocol row's proven-N-of-M arrives as taken over offered
;   64    the roster reading splits into current (taken), absent (held) and
;         malformed (declined), and a frame standing but SILENT is held too
;   128   the governor's three admission lifecycles ARE the body's three
;         outcomes, and the ledger grows through fcf-ledger-note
;   256   the real route candidates lift through branch-choice-order into
;         options, and the point reads DARK: this lane has never been metered
;   512   the one restricting point reads as a wound and the one unmetered lane
;         as a gap, each carrying an ask, and every ask folds to a label a
;         frame will accept
;   1024  the play scores the sequence by its NARROWEST gate and names the step
;         that restricts most
;   2048  the published frame reads back with the same points a reader takes
;   4096  the live doors answer in the shape these readers read: every row the
;         kernel's own page gives carries all ten of its words
;   8192  a tick the governor never measured put no choice at all, and neither
;         does a tick with no governor frame standing: the ledger stands where
;         it stood -- silence is the offer held open, this is the offer never made
;   16384 a frame carries WHEN it was given: standing is not giving, and a
;         publisher silent for two hours still parses "current" with all its rows
;
; A band writes no living state: it publishes into its own root, never the
; hearth's, so measuring the choices does not stain them.
;
; preludes: form/form-stdlib/form-choice-flow-glass.bml

(do
    (let band-root "/tmp/form-choice-flow-sources-band")

    ; ---- the live page's own row shape: (heat name unit line col fbox unbox native mint fold)
    (let hot-rows (list
        (list 1000 "alpha" "u.fk" 1 1 0 0 2 0)
        (list 700 "beta" "u.fk" 2 1 0 0 0 0)
        (list 300 "gamma" "u.fk" 3 1 0 0 -1 0)))
    (let crystallize (fcfs-crystallize-point hot-rows))
    (let cl (fcf-point-ledger crystallize))

    (let box-rows (list
        (list 10 "delta" "u.fk" 1 1 100 40 0 0 300)
        (list 10 "epsilon" "u.fk" 1 1 50 90 0 0 100)))
    (let box (fcfs-box-point box-rows))
    (let bl (fcf-point-ledger box))

    (let mint-rows (list
        (list 100 "zeta" "u.fk" 1 1 0 0 0 20)
        (list 100 "eta" "u.fk" 1 1 0 0 0 5)))
    (let mint (fcfs-mint-point mint-rows))
    (let ml (fcf-point-ledger mint))

    ; ---- the organs frame's own rows, in the shape that frame publishes
    (let routing-sample (fgtm-sample "surprise.routing" (fgtm-absent) "event" "membrane" "organs"
        "channel" "carried550-rested6971" (fgtm-absent) (fgtm-present 7521) "active"
        (fgtm-present 1) (fgtm-present 1) (fgtm-present 0) (fgtm-present 2) "never" "physical-live" "organs"
        (list "events" "surprise")))
    (let choice-sample (fgtm-sample "choice.surprise-route" (fgtm-absent) "choice" "membrane" "organs"
        "route" "taken-move" (fgtm-absent) (fgtm-present 550) "active"
        (fgtm-present 1) (fgtm-present 1) (fgtm-present 1) (fgtm-present 2) "never" "physical-live" "organs"
        (list "choice" "options" "compost" "hold" "rest" "tend" "play" "wander" "move")))
    (let protocol-sample (fgtm-sample "choice.protocol-floor" (fgtm-absent) "choice" "membrane" "organs"
        "protocol" "proven-19-of-22" (fgtm-absent) (fgtm-present 19) "ready"
        (fgtm-present 1) (fgtm-present 1) (fgtm-present 0) (fgtm-present 2) "never" "physical-live" "organs"
        (list "choice" "protocol")))
    (let organ-samples (list routing-sample choice-sample protocol-sample))
    (let surprise (fcfs-surprise-point-of organ-samples))
    (let sl (fcf-point-ledger surprise))
    (let protocol (fcfs-protocol-point-of organ-samples))
    (let pl (fcf-point-ledger protocol))

    ; ---- the roster reading, without opening a single frame
    ; a frame standing but silent is the offer HELD -- its giver may speak again --
    ; never a taking: standing is not giving, and shared memory outlives the process
    (let frame (fcfs-frame-point (list "alpha" "beta" "gamma" "delta") (list "current" "absent" "silent" "malformed")))
    (let fl (fcf-point-ledger frame))

    ; ---- the governor's admission: one outcome a tick, through the body's door
    (let admit-sample (fgtm-sample "governor.admission.metal" (fgtm-absent) "admission" "metal" "resource.governor"
        "scheduler" "admission-submitted-correlated" (fgtm-absent) (fgtm-present 1) "active"
        (fgtm-present 1) (fgtm-present 1) (fgtm-present 1000) (fgtm-absent) "never" "derived-window" "governor.admission"
        (list "governor" "metal")))
    (let refuse-sample (fgtm-sample "governor.admission.metal" (fgtm-absent) "admission" "metal" "resource.governor"
        "scheduler" "admission-refused" (fgtm-absent) (fgtm-present 0) "failed"
        (fgtm-present 1) (fgtm-present 1) (fgtm-present 0) (fgtm-absent) "never" "derived-window" "governor.admission"
        (list "governor" "metal")))
    (let offer-sample (fgtm-sample "governor.admission.metal" (fgtm-absent) "admission" "metal" "resource.governor"
        "scheduler" "admission-offered" (fgtm-absent) (fgtm-present 1) "ready"
        (fgtm-present 1) (fgtm-present 1) (fgtm-present 0) (fgtm-absent) "never" "derived-window" "governor.admission"
        (list "governor" "metal")))
    ; a tick where the governor never read its signals: it put no choice at all
    (let unmeasured-sample (fgtm-sample "governor.admission.metal" (fgtm-absent) "admission" "metal" "resource.governor"
        "scheduler" "admission-unmeasured" (fgtm-absent) (fgtm-present 0) "unknown"
        (fgtm-present 1) (fgtm-present 1) (fgtm-present 0) (fgtm-absent) "never" "derived-window" "governor.fail-closed"
        (list "governor" "metal")))
    (let a1 (fcf-point-ledger (fcfs-admission-point-of (list admit-sample) (fcf-ledger-empty) 100)))
    (let a2 (fcf-point-ledger (fcfs-admission-point-of (list refuse-sample) a1 100)))
    (let a3 (fcf-point-ledger (fcfs-admission-point-of (list offer-sample) a2 100)))
    ; two ticks the governor never measured, and one with no frame standing: nothing put, nothing noted
    (let a4 (fcf-point-ledger (fcfs-admission-point-of (list unmeasured-sample) a3 100)))
    (let a5 (fcf-point-ledger (fcfs-admission-point-of (list unmeasured-sample) a4 100)))
    (let a6 (fcf-point-ledger (fcfs-admission-point-of (list) a5 100)))
    (let admission (fcfs-admission-point a6))

    ; ---- the route lane the body has never metered
    (let route (fcfs-route-category-point-live))
    (let rl (fcf-point-ledger route))

    ; ---- the findings and the play over all eight
    (let points (list crystallize box mint surprise protocol frame admission route))
    (let findings (fcf-findings points))
    (let play (fcf-play points))
    (let corridors (fcf-findings-of-kind findings "gap-corridor"))
    (let darks (fcf-findings-of-kind findings "gap-dark"))
    (let wounds (fcf-findings-of-kind findings "wound-restricting"))

    ; every ask folds to a label a frame will accept
    (defn asks-labelled? (fs)
        (if (eq (len fs) 0) 1
            (if (eq (fgtm-label? (fcfg-label (fcf-finding-asks (head fs)))) 1)
                (asks-labelled? (tail fs))
                0)))

    ; ---- the frame gives them back
    (let published (fgtm-publish-snapshot band-root "choices" 1 (fcfg-rows points 1 2 "form-choice-flow-sources-band")))
    (let taken (fcfg-samples-of band-root "choices"))
    (defn choice-ids (ss)
        (if (eq (len ss) 0) (list)
            (if (str_eq (fgtm-sample-kind (head ss)) "choice")
                (cons (substring (fgtm-sample-id (head ss)) 7 (str_len (fgtm-sample-id (head ss)))) (choice-ids (tail ss)))
                (choice-ids (tail ss)))))
    (defn same-ids? (a b)
        (if (eq (len a) 0) (if (eq (len b) 0) 1 0)
            (if (eq (len b) 0) 0
                (if (str_eq (head a) (head b)) (same-ids? (tail a) (tail b)) 0))))

    ; ---- the live doors, in this kernel's own page
    (defn warm-band (n acc) (if (le n 0) acc (warm-band (sub n 1) (add acc n))))
    (let warmed (warm-band 200000 0))
    (defn rows-whole? (rs)
        (if (eq (len rs) 0) 1
            (if (ge (len (head rs)) 10) (rows-whole? (tail rs)) 0)))
    (let live-rows (kernel_page_hot (host_pid) 8))

    (let c0 (if (and (eq (fcf-ledger-offered cl) 3)
                (and (eq (fcf-ledger-taken cl) 1)
                (and (eq (fcf-ledger-held cl) 1)
                (and (eq (fcf-ledger-declined cl) 1)
                (and (eq (fcf-ledger-wait cl) 700) (eq (fcf-ledger-last-wait cl) 700)))))) 1 0))
    ; both legs from the page: 150 results took a pool slot, 400 folded into
    ; registers, and the flow is how much of the float work ran in-RAM
    (let c1 (if (and (eq (fcf-ledger-offered bl) 550)
                (and (eq (fcf-ledger-taken bl) 400)
                (and (eq (fcf-ledger-declined bl) 150) (eq (fcf-flow box) 72)))) 2 0))
    ; the corridor is CLOSED: this was a one-option point only because nothing
    ; counted the leg it was choosing against (fold, page field 9, 2026-09-07)
    (let c2 (if (and (eq (len (fcf-point-options box)) 2)
                (and (eq (fcf-corridor? box) 0)
                (and (eq (fcf-corridor? crystallize) 0)
                (and (eq (len corridors) 0) (eq (fcfs-row-fold (head box-rows)) 300))))) 4 0))
    (let c3 (if (and (eq (fcf-ledger-offered ml) 200)
                (and (eq (fcf-ledger-taken ml) 175)
                (and (eq (fcf-ledger-declined ml) 25) (eq (fcf-restriction mint) 12)))) 8 0))
    (let c4 (if (and (eq (fcf-ledger-offered sl) 7521)
                (and (eq (fcf-ledger-taken sl) 550)
                (and (and (eq (fcf-ledger-declined sl) 0) (eq (fcf-ledger-held sl) 6971))
                (and (eq (len (fcf-point-options surprise)) 7)
                (and (str_eq (fcf-option-id (head (fcf-point-options surprise))) "compost")
                     (eq (fcf-flow surprise) 7)))))) 16 0))
    (let c5 (if (and (eq (fcf-ledger-offered pl) 22)
                (and (eq (fcf-ledger-taken pl) 19)
                (and (eq (fcf-ledger-held pl) 3) (eq (fcf-flow protocol) 86)))) 32 0))
    (let c6 (if (and (eq (fcf-ledger-offered fl) 4)
                (and (eq (fcf-ledger-taken fl) 1)
                (and (eq (fcf-ledger-held fl) 2)
                (and (eq (fcf-ledger-declined fl) 1) (eq (len (fcf-point-options frame)) 4))))) 64 0))
    (let c7 (if (and (eq (fcf-ledger-offered a3) 3)
                (and (eq (fcf-ledger-taken a3) 1)
                (and (eq (fcf-ledger-declined a3) 1)
                (and (eq (fcf-ledger-held a3) 1)
                (and (str_eq (fcfs-admission-outcome admit-sample) (cr-outcome-success))
                (and (str_eq (fcfs-admission-outcome refuse-sample) (cr-outcome-fail))
                     (str_eq (fcfs-admission-outcome offer-sample) (cr-outcome-silence)))))))) 128 0))
    (let c8 (if (and (eq (len (fcf-point-options route)) 2)
                (and (eq (fcf-ledger-offered rl) 0)
                (and (eq (fcf-dark? route) 1)
                (and (eq (fcf-flow route) -1)
                     (str_eq (fcf-option-id (head (fcf-point-options route))) "form/form-stdlib/bml-source.fk"))))) 256 0))
    ; the surprise point no longer closes what it never closed: its resting
    ; movements are held offers, so it holds where it used to read as a wound
    (let c9 (if (and (and (eq (fcf-restricting? surprise) 0) (gt (fcf-holding surprise) 90))
                (and (eq (len wounds) 0)
                (and (eq (len darks) 1)
                (and (str_eq (fcf-finding-asks (head darks)) "reach it, or retire it")
                     (eq (asks-labelled? findings) 1))))) 512 0))
    ; the sequence still plays at its narrowest gate; with the surprise point
    ; holding rather than closing, that gate is the JIT crystallize choice
    (let c10 (if (and (eq (fcf-play-flow play) 7)
                 (and (str_eq (fcf-play-narrowest play) "jit.crystallize")
                 (and (eq (fcf-play? play) 1)
                      (eq (len (fcf-play-steps play)) 8)))) 1024 0))
    (let c11 (if (and (str_eq (nth published 1) "published")
                 (and (eq (len taken) (add 11 (len findings)))
                      (eq (same-ids? (choice-ids taken) (fcfs-point-ids points)) 1))) 2048 0))
    (let c12 (if (and (gt warmed 0)
                 (and (gt (len live-rows) 0) (eq (rows-whole? live-rows) 1))) 4096 0))
    ; an idle tick is not an offer: a governor that never read its signals put no
    ; choice, and a ledger noting that stands exactly where it stood. Three such
    ; ticks used to add three offers and three held legs, so an idle host grew a
    ; point that held 50 of every 100 offers nobody ever made.
    (let c13 (if (and (str_eq (fcfs-admission-outcome unmeasured-sample) (fcf-outcome-none))
                 (and (str_eq (fcfs-admission-outcome (list)) (fcf-outcome-none))
                 (and (eq (fcf-ledger-offered a6) 3)
                 (and (eq (fcf-ledger-held a6) 1)
                 (and (eq (fcf-ledger-wait a6) (fcf-ledger-wait a3))
                      (eq (fcf-holding admission) 33)))))) 8192 0))

    ; 16384 — a frame carries WHEN it was given, and standing is not giving.
    ; Shared memory outlives the process, so a publisher that stopped hours ago
    ; still parses "current" with every one of its rows. Witnessed 2026-09-07 on
    ; this host: four publishers current, two of them silent for 100 and 118
    ; minutes, and the frame point reading 100% flow over them. The age is read
    ; from the snapshot's own epoch, through the membrane, over a real publish.
    (let old-root (str_concat "/tmp/form-choice-flow-sources-band-age." (int_to_str (host_pid))))
    (let long-ago (sub (now_unix_ms) 7090890))
    (let put (fgtm-publish-snapshot old-root "choices" long-ago (list routing-sample)))
    (let stale-read (fgtm-read-current old-root "choices"))
    (let absent-read (fgtm-read-current old-root "organs"))
    (let c14 (if (and (str_eq (fgtm-read-state-status stale-read) "current")
                 (and (ge (fgtm-read-age stale-read (now_unix_ms)) 7090890)
                 (and (eq (fgtm-read-given-within? stale-read (now_unix_ms) 3000) 0)
                 (and (eq (fgtm-read-given-within? stale-read (now_unix_ms) 9999999) 1)
                 (and (eq (fgtm-read-age absent-read (now_unix_ms)) -1)
                 (and (eq (fgtm-read-given-within? absent-read (now_unix_ms) 3000) -1)
                      (eq (fcfs-frame-held? "silent") 1))))))) 16384 0))

    (print (list "sources" "wounds" (len wounds) "darks" (len darks) "corridors" (len corridors) "play-flow" (fcf-play-flow play) "narrowest" (fcf-play-narrowest play) "steps" (len (fcf-play-steps play)) "surprise-holding" (fcf-holding surprise)))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9 (add c10 (add c11 (add c12 (add c13 c14)))))))))))))))
