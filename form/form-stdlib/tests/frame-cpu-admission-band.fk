; Equal CPU programs share code while every admission owns a separate lifetime.
; Expected 255 on the ARM64 fkwu RAM leaf carrier.
; preludes: form-stdlib/bml/frame-cpu.bml form-stdlib/tests/frame-luma-fixture.fk
(do
 (let a (fc-open "same-label" (fc-max-pixels)))
 (let b (fc-open "same-label" (fc-max-pixels)))
 (let opened (and (fc-active? a) (fc-active? b)))
 (let capture (fc-capture (flmb-uniform 6 3 0)))
 (let expected (list 0 0 0 100 0 0 0 6 3))
 (let before-a (fc-stat a capture (flm-default-policy)))
 (let before-b (fc-stat b capture (flm-default-policy)))
 (let request-a (record_get a "request"))
 (let released-a (fc-release a))
 (let after-b (fc-stat b capture (flm-default-policy)))
 (let stale-a (jit_leaf_inram request-a 0))
 (let c (fc-open "same-label" (fc-max-pixels)))
 (let after-c (fc-stat c capture (flm-default-policy)))
 (let released-b (fc-release b))
 (let retained-c (fc-stat c capture (flm-default-policy)))
 (let released-c (fc-release c))
 (let d (fc-open "same-label" (fc-max-pixels)))
 (let after-d (fc-stat d capture (flm-default-policy)))
 (let stale-a-again (jit_leaf_inram request-a 0))
 (let released-d (fc-release d))
 (sum (list
  (if opened 1 0)
  (if (and (node_eq (record_get a "program-identity") (record_get b "program-identity"))
           (not (node_eq (record_get a "identity") (record_get b "identity")))) 2 0)
  (if (and (value_eq before-a expected) (value_eq before-b expected)) 4 0)
  (if (and (eq released-a 1) (and (value_eq after-b expected) (nothing? stale-a))) 8 0)
  (if (and (value_eq after-c expected)
           (not (node_eq (record_get c "identity") (record_get a "identity")))) 16 0)
  (if (and (eq released-b 1) (and (value_eq retained-c expected) (eq released-c 1))) 32 0)
  (if (and (value_eq after-d expected) (and (nothing? stale-a-again) (eq released-d 1))) 64 0)
  (if (and (eq (fc-release a) 0) (and (nothing? (fc-stat a capture (flm-default-policy)))
           (nothing? (jit_leaf_inram (record_get b "request") 0)))) 128 0))))
