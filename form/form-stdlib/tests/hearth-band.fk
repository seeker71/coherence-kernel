; hearth-band.fk — the hearth's stable spellings, board text grammar,
; and shared quantities. PURE: a band proves logic and must never touch
; the living board — the previous form of this band wrote the live
; board with a test pid on every run and became the boardghost.
;
; 2^17-1 below is the hearth's pure spellings; the six bits above them (131072 .. 4194304) hold the process, clock and
; file reads against the host's own doors, no program: the band's own process is a row of the host's table and a line of the
; listing (131072), a live pid reads alive and a pid that cannot exist reads gone (262144), the elapsed-time spelling is
; ps's [[dd-]hh:]mm:ss from seconds (524288), a fifo made by the band is told from a file (1048576), HOME comes from the
; environment door (2097152), and a one-second rest holds for about a second (4194304).
; Expected: 8388607
; Verdict 8388607
; REQUIRES: the host doors host_processes host_process host_alive host_getenv host_sleep_ms fs_mkfifo host_file_mode (seed doors; the sibling kernels carry no host doors)
; preludes: form-stdlib/hearth.bml
(do
    (defn hb-find-row (rows me)
        (if (eq (len rows) 0) (list)
            (if (eq (head (head rows)) me) (head rows) (hb-find-row (tail rows) me))))
    (defn hb-me-row () (hb-find-row (host_processes "fkwu*") (host_pid)))
    (defn hb-me-listed? ()
        (ge (str_find (str_concat "\n" (hearth-ps-text)) (str_concat "\n" (str_concat (int_to_str (host_pid)) " ")) 0) 0))
    (defn hb-timed-line? (line)
        (and (str_eq (hearth-field line 1) (int_to_str (host_pid)))
        (and (ge (str_find (hearth-field line 2) ":" 0) 0)
             (ge (len (hearth-field line 3)) 1))))
    (defn hb-me-timed? () (hb-timed-line? (hearth-ps-line (hb-me-row) 1)))
    (defn hb-flag (b) (if b 1 0))
    (defn hb-rest-claim ()
        (do
            (let t0 (host_monotonic_ms))
            (let r (hearth-rest-s 1))
            (let dt (sub (host_monotonic_ms) t0))
            (and (eq r 1) (and (ge dt 900) (le dt 5000)))))
    (defn hb-fifo-claim ()
        (do
            (let dir (str_concat (host_temp_dir) (str_concat "/hearth-band-" (int_to_str (host_pid)))))
            (let made (host_dir_mkdir dir))
            (let mf (fs_mkfifo (str_concat dir "/bell")))
            (let wf (write_file (str_concat dir "/plain") "x"))
            (let ok (and (eq mf 1)
                    (and (eq (hb-flag (hfs-fifo? (str_concat dir "/bell"))) 1)
                    (and (eq (hb-flag (hfs-fifo? (str_concat dir "/plain"))) 0)
                         (eq (hb-flag (hfs-fifo? (str_concat dir "/no-such"))) 0)))))
            (let gone (host_dir_rmdir dir))
            ok))
    (defn hb-bit (ok bit) (if ok bit 0))
    (defn join-lines (xs sep)
        (if (eq (len xs) 0) ""
            (if (eq (len xs) 1) (head xs)
                (str_concat (head xs) (str_concat sep (join-lines (tail xs) sep))))))
    (defn hb-cmds ()
        (str_concat "./fkwu observe/glass-live-run.fk\n"
        (str_concat "/w/fkwu observe/cell-channel-cell-live.fk\n"
        (str_concat "fkwu observe/cell-channel-field-live.fk extra\n"
        (str_concat "./xfkwuy observe/glass-live-run.fk\n"
                    "/bin/sh -c glass-live-run\n")))))
    (defn hb-times ()
        (str_concat "  101     05:03 ./fkwu a b\n"
        (str_concat " 202 00:10 /x/fkwu form/z.fk\n"
                    "  303 1-02:00:00 /bin/zsh -c fkwu\n")))
    (defn hb-wide-go (n acc)
        (if (eq n 0) acc (hb-wide-go (sub n 1) (str_concat acc " 9 00:01 fkwu some-long-entry-name.fk\n"))))
    (defn hb-wide () (hb-wide-go 12 ""))
    (defn hb-ps ()
        (str_concat "  101 ./fkwu form/form-stdlib/form-cli-peer-contribution-live.fk\n"
        (str_concat "  102 /usr/bin/other form/form-stdlib/form-cli-peer-contribution-live.fk\n"
        (str_concat "  103 ./fkwu form/form-stdlib/form-cli-peer-birth-feeder.fk\n"
        (str_concat " 1040 /w/x/fkwu form-cli-peer-contribution-live.fk extra\n"
        (str_concat "  105 ./notfkwu form-cli-peer-contribution-live.fk\n"
                    "  106 ./fkwu a form-cli-peer-contribution-live.fk.bak\n"))))))
    (let bt (hearth-board-text 4242 "direct-answer-v1 source-action-v1"))
    (sum (list
        (hb-bit (str_eq (hearth-task) ".hearth/task.spool") 1)
        (hb-bit (str_eq (hearth-bell) ".hearth/bell") 2)
        (hb-bit (ge (str_find bt "pid=4242" 0) 0) 4)
        (hb-bit (ge (str_find bt "capabilities=direct-answer-v1 source-action-v1" 0) 0) 8)
        (hb-bit (eq (hearth-maxpos) 4096) 16)
        (hb-bit (str_eq (hearth-kind-answer) "direct-answer") 32)
        ; the caller's patience rows: each former C or cell literal has one
        ; home here — the metal command-buffer deadline and the artifact fetch
        ; deadline (bit 64); the cadences and the rest door (bit 4096, below)
        (hb-bit (and (eq (hearth-metal-deadline-ms) 300000)
                     (eq (hearth-fetch-deadline-ms) 300000)) 64)
        (hb-bit (and (eq (hearth-board-mend-needed? 41 42) 1)
            (and (eq (hearth-board-mend-needed? 42 42) 0)
                 (eq (hearth-board-mend-needed? 42 0) 0))) 128)
        (hb-bit (and (ge (str_find (hearth-capabilities)
                "hearth-telemetry-v2" 0) 0)
            (and (eq (hearth-board-current? 42 42 (hearth-capabilities)) 1)
                 (eq (hearth-board-current? 42 42 "direct-answer-v1") 0))) 256)
        ; the model a resident holds is read from its residency note (model-admission.bml), the first .gguf line by its file name
        (hb-bit (and (str_eq (hearth-model-of-note "/m/other.bin\n  /models/Qwen3-8B-Q8_0.gguf \n/m/second.gguf\n") "Qwen3-8B-Q8_0.gguf")
            (and (str_eq (hearth-model-of-note "/m/a.bin\n") "")
            (and (str_eq (hearth-model-of-note "") "")
            (and (str_eq (hearth-model-of-note "bare.gguf") "bare.gguf")
            (and (str_eq (hearth-resident-model 0) "nothing")
                 (str_eq (hearth-resident-model 2147483646) "nothing")))))) 512)
        (hb-bit (and (str_eq (hearth-model-of "") "nothing")
            (and (str_eq (hearth-model-of "name.gguf") "name.gguf")
                 (str_eq (hearth-board-read-value (nothing)) ""))) 1024)
        ; the resident listing is `ps` text read in Form: argv[0] is fkwu (bare or by a path) and
        ; argv[1] ends in the resident entry; a birth feeder, another entry and a neighbour word are not
        (hb-bit (and (str_eq (join-lines (hearth-resident-pids-of (hb-ps)) ",") "101,1040")
            (and (eq (hearth-resident-pid-of (hb-ps)) 101)
            (and (eq (hearth-resident-pid-of "  7 /bin/sh x\n") 0)
                 (str_eq (hearth-field "  42 ./fkwu a b" 3) "a")))) 2048)
        (hb-bit (str_eq (hearth-telemetry-root) "/tmp/form-glass-telemetry") 4096)
        (hb-bit (and (str_eq (hearth-stones) ".hearth/stones")
                     (str_eq (hearth-readings) ".hearth/readings")) 8192)
        ; the cadence rows, and the rest door answers 1 when a (zero-length)
        ; rest actually held — a beat that did not hold is never mistaken for one
        (hb-bit (and (eq (hearth-patrol-beat-s) 20)
            (and (eq (hearth-glass-tick-s) 1)
            (and (eq (hearth-review-tick-s) 2)
            (and (eq (hearth-review-wait-s) 1200)
            (and (eq (hearth-crossing-window-s) 60)
                 (eq (hearth-rest-s 0) 1)))))) 16384)
        ; the entry count over `ps` command text: one fkwu running the glass entry, none for a word
        ; that only ends in it, two names counted once each, and nothing listed is nothing counted
        (hb-bit (and (eq (hearth-fkwu-count-of (hb-cmds) (list "glass-live-run")) 1)
            (and (eq (hearth-fkwu-count-of (hb-cmds) (list "cell-channel-cell-live" "cell-channel-field-live")) 2)
            (and (eq (hearth-fkwu-count-of (hb-cmds) (list "no-such-entry")) 0)
                 (eq (hearth-fkwu-count-of "" (list "glass-live-run")) 0)))) 32768)
        ; the census: pid+etime and the last word of each fkwu process, ps order, a shell naming fkwu
        ; only in its args left out, and the line cut to 190 bytes
        (hb-bit (and (str_eq (hearth-fkwu-census-of (hb-times)) "101+05:03 b; 202+00:10 form/z.fk; ")
            (and (str_eq (hearth-fkwu-census-of "") "")
                 (eq (len (hearth-fkwu-census-of (hb-wide))) 190))) 65536)
        ; the band's own process is a row of the host's table and a line of the listing, with its argv and its elapsed time
        (hb-bit (and (ge (len (hb-me-row)) 4)
            (and (hb-me-listed?)
                 (hb-me-timed?))) 131072)
        ; liveness is the host's own answer: this pid lives, a pid that cannot exist (above any pid_max) and 0 and a negative do not
        (hb-bit (and (eq (hearth-alive (host_pid)) 1)
            (and (eq (hearth-alive 2147483646) 0)
            (and (eq (hearth-alive 0) 0)
                 (eq (hearth-alive (sub 0 5)) 0)))) 262144)
        ; ps's elapsed spelling from seconds, by hand: under an hour mm:ss, under a day hh:mm:ss, then d-hh:mm:ss
        (hb-bit (and (str_eq (hearth-etime 0) "00:00")
            (and (str_eq (hearth-etime 59) "00:59")
            (and (str_eq (hearth-etime 61) "01:01")
            (and (str_eq (hearth-etime 3600) "01:00:00")
            (and (str_eq (hearth-etime 3661) "01:01:01")
            (and (str_eq (hearth-etime 86400) "1-00:00:00")
            (and (str_eq (hearth-etime (add 86400 3661)) "1-01:01:01")
                 (str_eq (hearth-etime (nothing)) "00:00")))))))) 524288)
        ; a fifo the band makes is a fifo, a file and an absent path are not; the hearth's own bell answers 0 or 1, never a stop
        (hb-bit (and (hb-fifo-claim)
                     (ge (hearth-bell-fifo?) 0)) 1048576)
        ; HOME is the environment door's string, a directory, and the hearth's host home is it
        (hb-bit (and (str_eq (hearth-host-home) (host_getenv "HOME"))
            (and (eq (host_path_is_dir (host_getenv "HOME")) 1)
                 (str_eq (hfs-env "HEARTH_BAND_SURELY_UNSET_NAME" "dflt") "dflt"))) 2097152)
        ; a one-second rest holds for about a second (the body's own sleep, measured on its monotonic clock)
        (hb-bit (hb-rest-claim) 4194304))))
