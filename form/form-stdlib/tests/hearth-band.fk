; hearth-band.fk — the hearth's stable spellings and its board roundtrip.
; Expected: 15
; preludes: form-stdlib/hearth.bml
(do
    (defn hb-bit (ok bit) (if ok bit 0))
    (let w (hearth-board-write 4242 "direct-answer-v1 source-action-v1"))
    (sum (list
        (hb-bit (str_eq (hearth-task) ".hearth/task.spool") 1)
        (hb-bit (str_eq (hearth-bell) ".hearth/bell") 2)
        (hb-bit (eq (hearth-board-pid) 4242) 4)
        (hb-bit (ge (str_find (hearth-board-read) "direct-answer-v1" 0) 0) 8))))
