; tests/dsv4-control-emit-band.fk — the joint writes the verdict, exactly, and touches nothing else.
;
; PREREGISTERED 2026-08-18, predicted verdict 31.
;
;   bit  1  THE VERDICT IS RIGHT ON HELD GROUND: the fresh TIMEOUT situation ("backup restore
;           ran out of its window before anything settled") answers index 3 and the fresh NIL
;           situation answers index 0 — both witnessed correct picks of the leakage-free fit.
;   bit  2  THE LINES ARE ONE-HOT AND EXACT: index 3 at strength "50.0" emits
;           "0.0\n0.0\n0.0\n50.0\n0.0\n" byte for byte.
;   bit  4  THE FILE ROUND-TRIPS: dce-emit writes the witness file (gitignored
;           .dsv4-control-emit-witness.f32) and read_file returns the same bytes.
;   bit  8  ZERO RESTORES: dce-zero writes five zero lines, read back byte-exact.
;   bit 16  THE TRACKED ARTIFACT IS UNTOUCHED: form/native/metal/artifacts/
;           dsv4-control-logit-adapter.f32 still reads as five zero lines — the joint writes
;           per-run files, never the committed zeros.
;
; preludes: form-stdlib/dsv4-control-emit.fk

(do
    (defn deb-score (ok bit) (if ok bit 0))
    (defn deb-path () ".dsv4-control-emit-witness.f32")
    (defn deb-timeout-s () "backup restore ran out of its window before anything settled")
    (defn deb-nil-s () "backup restore finished cleanly and returned nothing at all")

    (let vt (dce-verdict-index (deb-timeout-s)))
    (let vn (dce-verdict-index (deb-nil-s)))
    (let c0 (deb-score (and (eq vt 3) (eq vn 0)) 1))

    (let want "0.0\n0.0\n0.0\n50.0\n0.0\n")
    (let c1 (deb-score (str_eq (dce-lines 3 "50.0") want) 2))

    (let idx (dce-emit (deb-path) (deb-timeout-s) "50.0"))
    (let back (read_file (deb-path)))
    (let c2 (deb-score (if (eq idx 3) (str_eq back want) false) 4))

    (let _z (dce-zero (deb-path)))
    (let c3 (deb-score (str_eq (read_file (deb-path)) (dce-zero-lines)) 8))

    (let c4 (deb-score (str_eq (read_file "form/native/metal/artifacts/dsv4-control-logit-adapter.f32")
                               (dce-zero-lines)) 16))

    (add c0 (add c1 (add c2 (add c3 c4)))))
