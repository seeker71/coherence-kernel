; preludes: form-stdlib/native-llama-tokenizer.bml
(do
 (defn nltb-fill (i t) (if (lt i 0) t (nltb-fill (sub i 1) (noi-put t (nlt-number-key i) i))))
 (defn nltb-read (i t) (if (lt i 0) 1 (and (eq (noi-get t (nlt-number-key i)) i) (nltb-read (sub i 1) t))))
 (defn nltb-pieces (tk s i) (if (ge i (str_len s)) (list) (do (let end (nlt-end tk s i)) (cons (substring s i end) (nltb-pieces tk s end)))))
 (let tree (nltb-fill 512 (list)))
 (let balanced (and (le (noi-height tree) 10) (nltb-read 512 tree)))
 (let absent (and (nothing? (noi-get tree "missing")) (and (eq (noi-get tree (nlt-number-key 0)) 0) (eq (noi-get tree (nlt-number-key 1)) 1))))
 (let categories (nlt-category-lines (split-on (read_file "form/form-stdlib/data/DerivedGeneralCategory-15.1.0.txt") (byte_to_str 10)) (list)))
 (let tk (list (list) (list) (list) (list) categories "fixture"))
 (let pieces (nltb-pieces tk "DON'T _home 1234\nسلام دنیا! Café 世界 ۱۲۳۴ 🦙" 0))
 (let wanted (list "DON" "'T" " _" "home" " " "123" "4" "\n" "سلام" " دنیا" "!" " Café" " 世界" " " "۱۲۳" "۴" " 🦙"))
 (let unicode (value_eq pieces wanted))
 (let merge (noi-put (noi-put (noi-put (list) "a b" 2) "b c" 1) "a bc" 3))
 (let bpe (value_eq (nlt-bpe merge (list "a" "b" "c" "d")) (list "abc" "d")))
 (let bytes (nlt-decode-piece (nlt-symbol 255) 0 ""))
 (let raw (and (eq (str_len bytes) 1) (eq (str_byte_at bytes 0) 255)))
 (print (list "avl" balanced "presence" absent "unicode-pieces" pieces "unicode" unicode "ranked-bpe" bpe "raw-byte" raw))
 (if (and balanced (and absent (and unicode (and bpe raw)))) 31 (form_error "native tokenizer witness refused")))
