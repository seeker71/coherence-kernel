; generative-form-skill-gate-band.fk -- adversarial execution-backed witness.
;
; Expected: 1048575
; A string containing the right nouns cannot pass.  The positive candidate
; executes BML through the AST and fk walkers, lowers/matches BMF through the raw cursor, and executes
; the NodeID/control/JIT plan.  Each negative preserves surface vocabulary
; while breaking one semantic crossing.
;
; witnessed: 2026-08-25 -> direct fkwu
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml.fk form-stdlib/hati-os-kernel.fk form-stdlib/form-recipe-exec-token.fk control/offer-ack-core.fk control/choice-lane-core.fk form-stdlib/jit-decision.fk observe/inquiry-planes.fk form-stdlib/bml-bmf-stream-curriculum.fk form-stdlib/bml-bmf-control-curriculum.fk form-stdlib/generative-form-skill-gate.fk

(do
    (defn fgsgb-bit (ok bit) (if ok bit 0))
    (defn fgsgb-bml-good ()
        "int Lift(int n) { return n + 8; }\nreturn Lift(65);\n")
    (defn fgsgb-bml-wrong ()
        "int Lift(int n) { return n + 7; }\nreturn Lift(65);\n")
    (defn fgsgb-bml-lexical-only ()
        "BML method invocation return 73 Hati BMA but this is not source")
    (defn fgsgb-bmf-good ()
        "grammar {\n  rule atmark { lit @ }\n  rule vowel { class ae }\n  rule markedvowel { seq atmark vowel }\n  rule entrance { alt vowel markedvowel }\n  top entrance\n  probe @a\n}")
    (defn fgsgb-bmf-first-wins ()
        "grammar {\n  rule atmark { lit @ }\n  rule vowel { class ae }\n  rule markedvowel { seq atmark vowel }\n  rule entrance { alt vowel markedvowel }\n  top entrance\n  probe a\n}")
    (defn fgsgb-bmf-lexical-only ()
        "grammar choice cut undo timeout alt seq probe but no executable rules")
    (defn fgsgb-form (node plan probe checkpoint budget plane heat pure)
        (fgsg-control-canonical
            (fgsg-cat (list "<|form:recipe-exec|>" node
                ";input=17;carrier=auto<|/form:recipe-exec|>"))
            plan probe (int_to_str checkpoint) (int_to_str budget) plane
            (int_to_str heat) (int_to_str pure)))
    (defn fgsgb-form-good ()
        (fgsgb-form (frex-node-coordinate (frex-recipe))
                    "nothing,timeout,zero" "one"
                    29 2 "why" 6 1))
    (defn fgsgb-candidate (bml bmf form)
        (fgsg-candidate bml bmf form))
    (defn fgsgb-framed (bml bmf form)
        (fgsg-cat (list
            "<BML>\n" bml "\n</BML>\n"
            "<BMF>\n" bmf "\n</BMF>\n"
            "<FORM>\n" form "\n</FORM>")))
    (defn fgsgb-run ()
        (do
            (let challenge (fgsg-challenge))
            (let good (fgsgb-candidate (fgsgb-bml-good)
                (fgsgb-bmf-good) (fgsgb-form-good)))
            (let verdict (fgsg-verify good challenge))
            (let bmlobs (fgsg-verdict-bml-observation verdict))
            (let bmfobs (fgsg-verdict-bmf-observation verdict))
            (let formobs (fgsg-verdict-form-observation verdict))
            (let bad-bml-lex (fgsg-verify
                (fgsgb-candidate (fgsgb-bml-lexical-only)
                    (fgsgb-bmf-good) (fgsgb-form-good)) challenge))
            (let bad-bml-value (fgsg-verify
                (fgsgb-candidate (fgsgb-bml-wrong)
                    (fgsgb-bmf-good) (fgsgb-form-good)) challenge))
            (let bad-bmf-lex (fgsg-verify
                (fgsgb-candidate (fgsgb-bml-good)
                    (fgsgb-bmf-lexical-only) (fgsgb-form-good)) challenge))
            (let bad-bmf-first (fgsg-verify
                (fgsgb-candidate (fgsgb-bml-good)
                    (fgsgb-bmf-first-wins) (fgsgb-form-good)) challenge))
            (let bad-bmf-trailing (fgsg-verify
                (fgsgb-candidate (fgsgb-bml-good)
                    (str_concat (fgsgb-bmf-good) " trailing")
                    (fgsgb-form-good)) challenge))
            (let bad-node (fgsg-verify
                (fgsgb-candidate (fgsgb-bml-good) (fgsgb-bmf-good)
                    (fgsgb-form "@31.2.0.57" "nothing,timeout,zero" "one"
                        29 2 "why" 6 1)) challenge))
            (let bad-zero (fgsg-verify
                (fgsgb-candidate (fgsgb-bml-good) (fgsgb-bmf-good)
                    (fgsgb-form (frex-node-coordinate (frex-recipe))
                        "nothing,timeout,one" "one"
                        29 2 "why" 6 1)) challenge))
            (let bad-checkpoint (fgsg-verify
                (fgsgb-candidate (fgsgb-bml-good) (fgsgb-bmf-good)
                    (fgsgb-form (frex-node-coordinate (frex-recipe))
                        "nothing,timeout,zero" "one"
                        30 2 "why" 6 1)) challenge))
            (let framed (fgsgb-framed (fgsgb-bml-good)
                (fgsgb-bmf-good) (fgsgb-form-good)))
            (let parsed (fgsg-candidate-from-text framed))
            (let duplicated (fgsg-candidate-from-text
                (str_concat framed "<BML>return 73;</BML>")))
            (sum (list
                (fgsgb-bit (eq (fgsg-exact-leakage) 0) 1)
                (fgsgb-bit (ge (str_find (fgsg-leakage-boundary)
                    "paraphrase" 0) 0) 2)
                (fgsgb-bit (eq (fgsg-candidate? good) 1) 4)
                (fgsgb-bit (eq (fgsg-verdict-bml verdict) 1) 8)
                (fgsgb-bit (eq (fgsg-verdict-bmf verdict) 1) 16)
                (fgsgb-bit (eq (fgsg-verdict-form verdict) 1) 32)
                (fgsgb-bit (eq (fgsg-verdict-overall verdict) 1) 64)
                (fgsgb-bit (and (eq (nth bmlobs 3) 73)
                    (eq (nth bmlobs 5) 73)) 128)
                (fgsgb-bit (and (ge (nth bmfobs 9) 2)
                    (and (ge (nth bmfobs 10) 1)
                         (ge (nth bmfobs 11) 1))) 256)
                (fgsgb-bit (and (str_eq (nth formobs 5) "value")
                    (and (eq (nth formobs 6) 0)
                    (and (eq (nth formobs 7) 1)
                    (and (eq (nth formobs 12) 1)
                         (eq (nth formobs 13) 1))))) 512)
                (fgsgb-bit (eq (fgsg-verdict-bml bad-bml-lex) 0) 1024)
                (fgsgb-bit (eq (fgsg-verdict-bml bad-bml-value) 0) 2048)
                (fgsgb-bit (eq (fgsg-verdict-bmf bad-bmf-lex) 0) 4096)
                (fgsgb-bit (eq (fgsg-verdict-bmf bad-bmf-first) 0) 8192)
                (fgsgb-bit (eq (fgsg-verdict-bmf bad-bmf-trailing) 0) 16384)
                (fgsgb-bit (eq (fgsg-verdict-form bad-node) 0) 32768)
                (fgsgb-bit (eq (fgsg-verdict-form bad-zero) 0) 65536)
                (fgsgb-bit (eq (fgsg-verdict-form bad-checkpoint) 0) 131072)
                (fgsgb-bit (nothing? duplicated) 262144)
                (fgsgb-bit (eq (fgsg-verdict-overall
                    (fgsg-verify parsed challenge)) 1) 524288)))))
    (fgsgb-run))
