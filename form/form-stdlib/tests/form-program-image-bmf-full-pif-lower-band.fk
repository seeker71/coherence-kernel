; form-program-image-bmf-full-pif-lower-band.fk -- two grammar values cross
; canonical bytes, admission and the unchanged full-PIF protocol from raw-only
; OFFERs. Query identity and decision nothing/0/1 remain typed result children.
; Expected: 524287
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/bmf-core.fk
; preludes: form-stdlib/bmf-grammar.fk
; preludes: form-stdlib/form-program-image-bmf-full-pif-lower.fk

(do
    (defn fpbflb-bit (held weight) (if held weight 0))
    (defn fpbflb-sum (values)
        (if (nil? values) 0
            (add (head values) (fpbflb-sum (tail values)))))
    (defn fpbflb-all? (values)
        (if (nil? values) 1
            (if (head values) (fpbflb-all? (tail values)) 0)))
    (defn fpbflb-limits ()
        (fpbsl-limits 8 96 512 16 64 2048 1024 64))
    (defn fpbflb-concept-class ()
        (fpbsl-class "concept-byte"
            (list (list 45 45) (list 48 57) (list 97 122))))
    (defn fpbflb-query-spec ()
        (fpbsl-spec
            (grammar "query" (list
                (rule3 "query"
                    (list "seq"
                        (p-lit "<q>")
                        (p-cap "coordinate" (p-run "concept-byte"))
                        (p-lit "</q>"))
                    (fpbsl-t-node (list 31 2 0 98)
                        (list
                            (fpbsl-t-trivial-string "concept")
                            (fpbsl-t-capture-trivial-string "coordinate")
                            (fpbsl-t-trivial-int 96)
                            (fpbsl-t-trivial-int 1)
                            (fpbsl-t-trivial-int 0)
                            (fpbsl-t-trivial-string
                                "bmf-core-raw-byte-cursor-v1"))))))
            (list (fpbflb-concept-class)) (fpbflb-limits)))
    (defn fpbflb-decision-spec ()
        (fpbsl-spec
            (grammar "start" (list
                (rule3 "start"
                    (list "alt" (p-ref "allow") (p-ref "deny"))
                    (fpbsl-t-nothing))
                (rule3 "allow"
                    (list "seq" (p-lit "a") (p-lit "x"))
                    (fpbsl-t-int 1))
                (rule3 "deny"
                    (list "seq" (p-lit "a") (p-lit "b"))
                    (fpbsl-t-int 0))))
            (empty) (fpbflb-limits)))

    (defn fpbflb-status? (receipt status)
        (if (not (fpcpf-receipt? receipt)) 0
            (str_eq (fpcp-ack-status
                (fpcpf-receipt-ack receipt)) status)))
    (defn fpbflb-raw-result (receipt)
        (fpcpf-value-raw
            (fpcp-ack-value (fpcpf-receipt-ack receipt))))
    (defn fpbflb-semantic (receipt)
        (fprsl-result-semantic (fpbflb-raw-result receipt)))
    (defn fpbflb-semantic-kind (receipt)
        (nth (rpmw-kind-children
            (fpcpf-value-kind
                (fpcp-ack-value (fpcpf-receipt-ack receipt)))) 3))
    (defn fpbflb-execute-retained (result raw fuel correlation)
        (fpbfl-execute result raw fuel correlation))
    (defn fpbflb-replace-raw (result raw-image)
        (fpbfl-ready-row
            (fpbfl-spec result) raw-image (fpbfl-entry-index result)
            (fpbfl-key result) (fpbfl-pif result) (fpbfl-container result)
            (fpbfl-decode result) (fpbfl-admission result)
            (fpbfl-envelope result) (fpbfl-binding result)
            (fpbfl-caller result) (fpbfl-capability result)
            (fpbfl-call result) (fpbfl-protocol result)
            (fpbfl-receiver result) (fpbfl-resolution result)))
    (defn form-program-image-bmf-full-pif-lower-band ()
        (do
            (let query (fpbfl-lower (fpbflb-query-spec)))
            (let decision (fpbfl-lower (fpbflb-decision-spec)))
            (let query-correlation
                (intern_trivial_string "correlation/bmf-full-pif/query"))
            (let decision-correlation
                (intern_trivial_string "correlation/bmf-full-pif/decision"))
            (let query-receipt (fpbfl-execute query
                "<q>novel-7</q>" 300000 query-correlation))
            (let allow-receipt (fpbflb-execute-retained decision
                "ax" 300000 decision-correlation))
            (let deny-receipt (fpbflb-execute-retained decision
                "ab" 300000 decision-correlation))
            (let miss-receipt (fpbflb-execute-retained decision
                "z" 300000 decision-correlation))
            (let timeout-receipt (fpbflb-execute-retained decision
                "ax" 0 decision-correlation))
            (let expected-query-node
                (intern_node (make_nodeid 31 2 0 98)
                    (list
                        (intern_trivial_string "concept")
                        (intern_trivial_string "novel-7")
                        (intern_trivial_int 96)
                        (intern_trivial_int 1)
                        (intern_trivial_int 0)
                        (intern_trivial_string
                            "bmf-core-raw-byte-cursor-v1"))))
            (let query-pif (fpbfl-pif query))
            (let query-bytes
                (pifbc-container-bytes (fpbfl-container query)))
            (let query-payload
                (pifbd-decode-payload (fpbfl-decode query)))
            (let query-ir (nth (fpbfl-raw-image query) 3))
            (let query-table (fpis-table (fpis-link query-ir)))
            (let query-root (nth (pif-table-fn-roots query-table)
                (fpis-label-index (nth query-ir 1) (fprsl-label-entry))))
            (let query-symbol-row (head (pif-symbol-image-node-rows
                (pif-envelope-symbol-image query-pif))))
            (let forged-raw (fprsl-image (fpbflb-query-spec)
                (nth (fpbfl-raw-image decision) 3)))
            (let forged-correlation
                (fpbflb-replace-raw query forged-raw))
            (let swapped-receiver (fpcpf-receiver
                (fpbfl-binding query) (fpbfl-envelope query)
                (fpbfl-admission decision)
                (pise-request-by-canonical-key (fpbfl-key query))))
            (let swapped-receipt (fpcpf-execute
                (fpbfl-protocol query)
                (fpcpf-receipt-offer query-receipt) swapped-receiver))

            (fpbflb-sum (list
                (fpbflb-bit (and (fpbfl-ready-shape? query)
                    (fpbflb-status? query-receipt "returned")) 1)
                (fpbflb-bit (and (fpbfl-ready-shape? decision)
                    (fpbflb-status? allow-receipt "returned")) 2)
                (fpbflb-bit (fpbflb-all? (list
                    (pif-envelope-valid? query-pif)
                    (pifbc-ready? (fpbfl-container query))
                    (pifbd-decoded? (fpbfl-decode query))
                    (pifbd-admitted? (fpbfl-admission query)))) 4)
                (fpbflb-bit (and
                    (str_eq (fpbfl-sha256-hex query-bytes)
                        (pif-envelope-content-hash query-pif))
                    (value_eq query-payload
                        (pifbd-decode-payload
                            (fpbfl-decode-canonical-bytes query-bytes
                                "bmf-full-pif-band")))) 8)
                (fpbflb-bit (and (fpcpf-registry-valid?
                        (fpbfl-protocol query))
                    (fpcpf-receiver-valid? (fpbfl-receiver query))) 16)
                (fpbflb-bit (and (fpbflb-status? query-receipt "returned")
                    (and (eq (fpcp-ack-output
                            (fpcpf-receipt-ack query-receipt)) 1)
                        (rpmw-kind-named?
                            (fpcpf-value-kind (head (fpcpf-offer-values
                                (fpcpf-receipt-offer query-receipt))))
                            "string"))) 32)
                (fpbflb-bit (and
                    (eq (fprsl-result-code
                        (fpbflb-raw-result query-receipt))
                        (fprsl-code-ready))
                    (node_eq (fpbflb-semantic query-receipt)
                        expected-query-node)) 64)
                (fpbflb-bit (and (rpmw-native-node?
                        (fpbflb-semantic-kind query-receipt))
                    (eq (fprsl-result-at
                        (fpbflb-raw-result query-receipt)) 14)) 128)
                (fpbflb-bit (and (fpbflb-status? allow-receipt "returned")
                    (and (rpmw-kind-named?
                            (fpbflb-semantic-kind allow-receipt) "int")
                        (eq (fpbflb-semantic allow-receipt) 1))) 256)
                (fpbflb-bit (and (fpbflb-status? deny-receipt "returned")
                    (and (rpmw-kind-named?
                            (fpbflb-semantic-kind deny-receipt) "int")
                        (eq (fpbflb-semantic deny-receipt) 0))) 512)
                (fpbflb-bit (and (fpbflb-status? miss-receipt "returned")
                    (and (rpmw-kind-named?
                            (fpbflb-semantic-kind miss-receipt) "nothing")
                        (nothing? (fpbflb-semantic miss-receipt)))) 1024)
                (fpbflb-bit (and
                    (not (rpmw-kind-equal?
                        (fpbflb-semantic-kind miss-receipt)
                        (fpbflb-semantic-kind deny-receipt)))
                    (not (rpmw-kind-equal?
                        (fpbflb-semantic-kind miss-receipt)
                        (fpbflb-semantic-kind allow-receipt)))) 2048)
                (fpbflb-bit (and
                    (eq (fprsl-result-code
                        (fpbflb-raw-result miss-receipt))
                        (fprsl-code-no))
                    (eq (fprsl-result-at
                        (fpbflb-raw-result miss-receipt)) 0)) 4096)
                (fpbflb-bit (and (fpbflb-status? timeout-receipt "timeout")
                    (eq (fpcp-ack-output
                        (fpcpf-receipt-ack timeout-receipt)) 0)) 8192)
                (fpbflb-bit (and
                    (fpbfl-receipt-observed? query query-receipt)
                    (fpbfl-receipt-observed? decision deny-receipt)) 16384)
                (fpbflb-bit (and
                    (eq (pif-node-symbol-row-node query-symbol-row)
                        query-root)
                    (str_eq (pif-symbol-row-key
                        (head (pif-symbol-image-rows
                            (pif-envelope-symbol-image query-pif))))
                        (fpbfl-key query))) 32768)
                ; Authentic spec/IR rejection is already held by the raw-state
                ; component band. This long integration band keeps only the
                ; cheap mutation witness; it does not re-lower a third time.
                (fpbflb-bit (and (fprsl-image-shape? forged-raw)
                    (not (value_eq forged-correlation query))) 65536)
                (fpbflb-bit (and (not (fpcpf-receiver-valid?
                        swapped-receiver))
                    (fpbflb-status? swapped-receipt "failure")) 131072)
                (fpbflb-bit (and
                    (not (str_eq (fpbfl-key query) (fpbfl-key decision)))
                    (not (str_eq
                        (pif-envelope-content-hash (fpbfl-pif query))
                        (pif-envelope-content-hash
                            (fpbfl-pif decision))))) 262144)))))

    (form-program-image-bmf-full-pif-lower-band))
