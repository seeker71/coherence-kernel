; living-world-answer-offers-witness.fk -- another answer and timed defaults.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-enquiry.fk form-stdlib/living-world-enquiry-answer.fk form-stdlib/living-world-contention-tending.fk form-stdlib/living-world-contextual-answer.fk form-stdlib/living-world-answer-offers.fk form-stdlib/tests/living-world-contention-witness.fk form-stdlib/tests/living-world-contention-tending-witness.fk

(let LWAOW-OTHER (bp "LWAOW-OTHER"))

(defn lwaow-other-output ()
    (intern_node LWAOW-OTHER
        (list (intern_trivial_string "holder-offered-possibility"))))
(defn lwaow-evidence ()
    (intern_trivial_string "lwaow-local-answer-evidence"))
(defn lwaow-expiration () (intern_trivial_int 30))
(defn lwaow-observed-expiration () (intern_trivial_int 30))

(defn lwaow-alternative-stance (question)
    (lwctd-stance question (lwcttw-identity-route question)
        (oac-alternative-ack
            question (lwaow-other-output) (lwaow-evidence))
        (lwaow-evidence)))

(defn lwaow-no-default-outcome ()
    (oac-timeout-condense
        (oac-timeout (lwaow-expiration)
            (oac-no-default) (lwaow-evidence))
        (lwaow-observed-expiration)))

(defn lwaow-default-outcome (question)
    (oac-timeout-condense
        (oac-timeout (lwaow-expiration)
            (oac-one (lwcttw-identity-route question))
            (lwaow-evidence))
        (lwaow-observed-expiration)))

(defn lwaow-no-default-stance (question)
    (do
        (let outcome (lwaow-no-default-outcome))
        (lwctd-stance question (lwcttw-identity-route question)
            (oac-time-outcome-ack outcome) outcome)))

(defn lwaow-default-stance (question)
    (do
        (let outcome (lwaow-default-outcome question))
        (lwctd-stance question (lwcttw-identity-route question)
            (oac-time-outcome-ack outcome) outcome)))

(defn lwaow-offer-world (world question)
    (lwt-receive-stream world
        (list
            (lwcttw-stance-entry
                (lwct-source-a) (lwct-provenance-a)
                (lwaow-alternative-stance question))
            (lwcttw-stance-entry
                (lwct-source-b) (lwct-provenance-b)
                (lwaow-no-default-stance question))
            (lwcttw-stance-entry
                (lwct-source-c) (lwct-provenance-c)
                (lwaow-default-stance question)))))

(defn lwaow-release-alternative (world question)
    (lwt-receive-stream world
        (list
            (lwcttw-release-entry
                (lwct-source-a) (lwct-provenance-a)
                (lwaow-alternative-stance question)))))

(defn lwaow-proposal-answer (proposal)
    (lwo-emergent-shape (lwt-proposal-candidate proposal)))

(defn lwaow-find-alternative-proposal (items)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let proposal (head items))
            (if (node_eq
                    (lwao-answer-kind
                        (lwaow-proposal-answer proposal))
                    (lwao-alternative-kind)) proposal
                (lwaow-find-alternative-proposal (tail items))))))

(defn lwaow-find-timed-nothing-proposal (items)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let proposal (head items))
            (let answer (lwaow-proposal-answer proposal))
            (if (and (node_eq (lwao-answer-kind answer)
                              (lwao-timed-kind))
                     (eq (oac-nothing?
                            (lwao-answer-ack answer)) 1)) proposal
                (lwaow-find-timed-nothing-proposal (tail items))))))

(defn lwaow-find-timed-default-proposal (items)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let proposal (head items))
            (let answer (lwaow-proposal-answer proposal))
            (if (and (node_eq (lwao-answer-kind answer)
                              (lwao-timed-kind))
                     (eq (oac-one?
                            (lwao-answer-ack answer)) 1)) proposal
                (lwaow-find-timed-default-proposal (tail items))))))

(defn lwaow-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwaow-sum (tail items)))))
