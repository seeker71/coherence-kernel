; preludes: form-stdlib/trig.fk form-stdlib/quaternion.fk
;
; quaternion-band — Hamilton's algebra made falsifiable, and the 3D-vs-4D rotation teaching
; proven by direct computation instead of asserted. Rotor q is 90° about the z-axis:
; q = q-from-axis-angle(0,0,1, HALF-PI) = (cos45°, 0, 0, sin45°). Claims c0-c2 are exact
; integer arithmetic (i,j,k literally multiply out to ±1/±k with no rounding involved);
; c3-c6 round to 3 decimals (fsin/fcos are a 10-term Taylor series, not libm); c7-c8 are
; exact again (the off-plane components of an isoclinic rotation come out to a literal 0.0
; from the Hamilton-product formula, not an approximation that happens to be small). Every
; quaternion equality below is checked component-by-component — eq is a scalar compare, so
; there is no shortcut through a 4-list at once.
;
; Verdict 511 when every claim lands:
;   1    i·i = -1                          pure imaginary units square to -1
;   2    i·j = k                           the defining cyclic product
;   4    j·i = -k                          q-mul is NON-commutative (order flips the sign)
;   8    |q-from-axis-angle(...)| = 1      the rotor built from a unit axis is itself unit
;   16   q-rotate3(q, x-axis) = y-axis     SO(3): 90° about z sends x -> y
;   32   q-rotate3(q, z-axis) = z-axis     SO(3): the sandwich FIXES q's own axis
;   64   |q-left-rotate(q, p)| = |p|       q-left-rotate is still an isometry of ℝ⁴
;   128  q-left-rotate(q, e_i) ≠ e_i  ∀i   …but generically fixes NO basis axis — the
;                                          3D-vs-4D difference claim 32 does not hold here
;   256  isoclinic invariant planes exact  q-left-rotate(q,·) keeps {e0,e3} and {e1,e2}
;                                          each within its own plane (off-plane coord = 0.0
;                                          exactly) — the two orthogonal 2-plane rotation
;                                          structure that has no 3D analog
;   512  q-hopf(q) = q-hopf(-q), exact     the Hopf map is blind to the same ±q the double
;                                          cover is blind to — both built from an even count
;                                          of q's own components, verified bit-identical
;   1024 the Hopf fiber is a LEFT coset    rotor(t)·q0 (rotor LEFT, i-axis) leaves q-hopf
;                                          fixed at q-hopf(q0); q0·rotor(t) (RIGHT, same
;                                          rotor) generically does not — measured, not
;                                          assumed: an earlier draft of this band had the
;                                          side backwards until a direct probe corrected it
(do
    (let q (q-from-axis-angle 0.0 0.0 1.0 (HALF-PI)))
    (let i (quat 0.0 1.0 0.0 0.0))
    (let j (quat 0.0 0.0 1.0 0.0))
    (let k (quat 0.0 0.0 0.0 1.0))

    ; --- c0-c2: the defining relations, exact — compared component by component ---
    (let ii (q-mul i i))
    (let c0 (if (and (eq (qw ii) -1.0) (and (eq (qx ii) 0.0) (and (eq (qy ii) 0.0) (eq (qz ii) 0.0)))) 1 0))
    (let ij (q-mul i j))
    (let c1 (if (and (eq (qw ij) 0.0) (and (eq (qx ij) 0.0) (and (eq (qy ij) 0.0) (eq (qz ij) 1.0)))) 2 0))
    (let ji (q-mul j i))
    (let c2 (if (and (eq (qw ji) 0.0) (and (eq (qx ji) 0.0) (and (eq (qy ji) 0.0) (eq (qz ji) -1.0)))) 4 0))

    ; --- c3: the rotor is unit norm (±1e-3, Taylor-series trig) ---
    (let c3 (if (eq (round (mul (q-norm q) 1000.0)) 1000) 8 0))

    ; --- c4: SO(3) sends x-axis to y-axis under a 90° z-rotation ---
    (let r-x (q-rotate3 q 1.0 0.0 0.0))
    (let c4 (if (and (eq (round (mul (nth r-x 0) 1000.0)) 0)
                (and (eq (round (mul (nth r-x 1) 1000.0)) 1000)
                     (eq (round (mul (nth r-x 2) 1000.0)) 0)))
               16 0))

    ; --- c5: SO(3) fixes q's own axis (z stays z) ---
    (let r-z (q-rotate3 q 0.0 0.0 1.0))
    (let c5 (if (and (eq (round (mul (nth r-z 0) 1000.0)) 0)
                (and (eq (round (mul (nth r-z 1) 1000.0)) 0)
                     (eq (round (mul (nth r-z 2) 1000.0)) 1000)))
               32 0))

    ; --- c6: q-left-rotate is an isometry — norm² of p=(1,2,3,4) is 30, preserved ---
    (let p (quat 1.0 2.0 3.0 4.0))
    (let lp (q-left-rotate q p))
    (let c6 (if (eq (round (mul (q-norm2 lp) 1000.0)) 30000) 64 0))

    ; --- c7: q-left-rotate fixes NONE of the four basis axes (unlike q-rotate3's c5) ---
    (let e0 (quat 1.0 0.0 0.0 0.0)) (let e1 (quat 0.0 1.0 0.0 0.0))
    (let e2 (quat 0.0 0.0 1.0 0.0)) (let e3 (quat 0.0 0.0 0.0 1.0))
    (let moved0 (if (eq (round (mul (qw (q-left-rotate q e0)) 1000.0)) 1000) 0 1))
    (let moved1 (if (eq (round (mul (qx (q-left-rotate q e1)) 1000.0)) 1000) 0 1))
    (let moved2 (if (eq (round (mul (qy (q-left-rotate q e2)) 1000.0)) 1000) 0 1))
    (let moved3 (if (eq (round (mul (qz (q-left-rotate q e3)) 1000.0)) 1000) 0 1))
    (let c7 (if (eq (add (add moved0 moved1) (add moved2 moved3)) 4) 128 0))

    ; --- c8: the two invariant planes are EXACT — off-plane components are literal 0.0 ---
    (let l0 (q-left-rotate q e0)) (let l3 (q-left-rotate q e3))
    (let l1 (q-left-rotate q e1)) (let l2 (q-left-rotate q e2))
    (let plane-wz (and (eq (qx l0) 0.0) (and (eq (qy l0) 0.0) (and (eq (qx l3) 0.0) (eq (qy l3) 0.0)))))
    (let plane-xy (and (eq (qw l1) 0.0) (and (eq (qz l1) 0.0) (and (eq (qw l2) 0.0) (eq (qz l2) 0.0)))))
    (let c8 (if (and plane-wz plane-xy) 256 0))

    ; --- c9: q-hopf is exactly blind to q -> -q (every term is a product of two components) ---
    (let hp (q-hopf p)) (let hnp (q-hopf (q-neg p)))
    (let c9 (if (and (eq (nth hp 0) (nth hnp 0)) (and (eq (nth hp 1) (nth hnp 1)) (eq (nth hp 2) (nth hnp 2)))) 512 0))

    ; --- c10: the Hopf fiber through a generic q0 is a LEFT coset of the i-axis circle:
    ; rotor(1.0)·q0 keeps q-hopf fixed at q-hopf(q0); q0·rotor(1.0) generically moves it. ---
    (let q0 (q-normalize (quat 1.0 2.0 3.0 4.0)))
    (let ir (q-orbit 1.0 1.0 0.0 0.0))
    (let h0 (q-hopf q0))
    (let hleft (q-hopf (q-mul ir q0)))
    (let hright (q-hopf (q-mul q0 ir)))
    (let left-fixed (and (eq (round (mul (sub (nth h0 0) (nth hleft 0)) 1000.0)) 0)
                     (and (eq (round (mul (sub (nth h0 1) (nth hleft 1)) 1000.0)) 0)
                          (eq (round (mul (sub (nth h0 2) (nth hleft 2)) 1000.0)) 0))))
    (let right-moved (not (and (eq (round (mul (sub (nth h0 0) (nth hright 0)) 1000.0)) 0)
                           (and (eq (round (mul (sub (nth h0 1) (nth hright 1)) 1000.0)) 0)
                                (eq (round (mul (sub (nth h0 2) (nth hright 2)) 1000.0)) 0)))))
    (let c10 (if (and left-fixed right-moved) 1024 0))

    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9 c10)))))))))))
