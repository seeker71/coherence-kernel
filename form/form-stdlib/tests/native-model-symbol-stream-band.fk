; native-model-symbol-stream-band.fk — lane-purified symbol descriptions,
; native action bindings, local projection, and operational assemblage choice.
;
; preludes: form-stdlib/core.fk form-stdlib/native-model-control-plane.fk form-stdlib/native-model-control-plane-eval.fk form-stdlib/form-teach-layer.fk form-stdlib/native-model-form-token-envelope.bml form-stdlib/form-agent-protocol.fk form-stdlib/native-model-form-action-protocol.bml form-stdlib/assemblage-point.fk form-stdlib/native-model-symbol-stream.bml
;
; Verdict 4095: 2047 executable + 2048 high-BML authority.

(do
    (defn nmfssb-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))
    (let translation (nmfss-stream (NMFTEThreeB) "nl-to-form-proposer"))
    (let reasoning (nmfss-stream (NMFTEQwen) "reasoning-fallback"))
    (let relation (nmfss-stream (NMFTEQwen) "relation"))
    (let every (nmfss-stream (NMFTEThreeB) "all"))
    (let audio (nmfss-stream "speech.whisper-block-native" "translation"))
    (let remote (nmfss-stream "oracle.agent-remote" "translation"))
    (let feeds (nmfss-project-local (nmcp-registry) "reasoning-fallback"))
    (let qwen-feed (nmfss-find-feed (NMFTEQwen) feeds))
    (let prompt (nmfss-wrap-id (NMFTEThreeB) "nl-to-form-proposer" "multiply seven by seven"))
    (let translation-frame (nmfss-assemblage "translation"))
    (let reasoning-frame (nmfss-assemblage "reasoning"))
    (let c0 (if (eq (len (nmfte-native-vocabulary)) 20) 1 0))
    (let c1 (if (and (eq (len translation) 3) (and (gt (len (nmfss-find-symbol "nothing" translation)) 0) (gt (len (nmfss-find-symbol "eval" translation)) 0))) 2 0))
    (let c2 (if (and (eq (len reasoning) 10) (and (gt (len (nmfss-find-symbol "ask" reasoning)) 0) (eq (len (nmfss-find-symbol "satsang" reasoning)) 0))) 4 0))
    (let c3 (if (and (eq (len relation) 9) (gt (len (nmfss-find-symbol "satsang" relation)) 0)) 8 0))
    (let c4 (if (and (eq (len every) 20) (eq (nmfss-count-admitted every) 20)) 16 0))
    (let c5 (if (and (eq (len audio) 3) (eq (nmfss-count-admitted audio) 0)) 32 0))
    (let c6 (if (eq (len remote) 0) 64 0))
    (let c7 (if (and (str_eq (nmfss-frame-label translation-frame) "grammar-grounded") (str_eq (nmfss-frame-label reasoning-frame) "exploratory-grounded")) 128 0))
    (let envelopes (nmfte-project-all (nmcp-registry)))
    (let c8 (if (and (eq (len feeds) (nmfte-count-local envelopes)) (and (eq (nmfss-feed-count qwen-feed) 10) (eq (nmfss-feed-admitted qwen-feed) 10))) 256 0))
    (let c9 (if (and (eq (nmfssb-has prompt "eval=native-validate-run") 1) (and (eq (nmfssb-has prompt "consent-witness-dissent") 0) (eq (nmfssb-has prompt "multiply seven by seven") 1))) 512 0))
    (let eval-symbol (nmfss-find-symbol "eval" translation))
    (let observed (nmfss-stream-to-framebuffer (NMFTEThreeB) "nl-to-form-proposer"))
    (let c10 (if (and (str_eq (nmfss-symbol-route eval-symbol) "form-eval")
                       (and (eq (nmfss-symbol-admitted? eval-symbol) 1)
                            (and (eq (nth (nmfss-feed (nmfte-find-row (NMFTEThreeB) (nmcp-registry)) "translation") 10) 0)
                                 (and (eq (nth observed 2) 3)
                                      (and (eq (nth observed 3) 3) (eq (nth observed 4) 0)))))) 1024 0))
    (let base (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10)))
    (let src (read_file "form/form-stdlib/bml/native-model-symbol-stream.bml"))
    (let authority
        (if (eq (nmfssb-has src "const String PurificationRule = \"a query receives compact vocabulary names plus descriptions only for symbols selected by its lane\"") 1)
            (if (eq (nmfssb-has src "const String AssemblageRule = \"the selected frame is the most alive of two explicit success-aliveness candidates; this operational selector is not a metaphysical claim\"") 1)
                (if (eq (nmfssb-has src "const String StreamingRule = \"the core framebuffer feed carries symbol identities, lane, counts, and state but never private prompt or answer content\"") 1) 2048 0) 0) 0))
    (add base authority))
