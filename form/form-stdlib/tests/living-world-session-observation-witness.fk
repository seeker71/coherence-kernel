; living-world-session-observation-witness.fk -- minimized reports cross only
; with exact scoped consent; reruns add no vote; revocation remains owner-local.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/native-model-evidence.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-session-observation.fk observe/live-call-framebuffer.fk

(let LWRSW-OWNER (bp "LWRSW-OWNER"))
(let LWRSW-FOREIGN (bp "LWRSW-FOREIGN"))
(let LWRSW-PURPOSE (bp "LWRSW-PURPOSE"))
(let LWRSW-ACTION (bp "LWRSW-ACTION"))
(let LWRSW-LENS (bp "LWRSW-LENS"))
(let LWRSW-ALTERNATIVE (bp "LWRSW-ALTERNATIVE"))
(let LWRSW-UNKNOWN (bp "LWRSW-UNKNOWN"))
(let LWRSW-DEFAULT (bp "LWRSW-DEFAULT"))
(let LWRSW-REASON (bp "LWRSW-REASON"))
(let LWRSW-PROVENANCE (bp "LWRSW-PROVENANCE"))

(defn lwrsw-dataset-a ()
    (lwrs-digest
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
(defn lwrsw-dataset-b ()
    (lwrs-digest
        "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"))
(defn lwrsw-candidate ()
    (lwrs-digest
        "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"))
(defn lwrsw-contract ()
    (lwrs-digest
        "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"))
(defn lwrsw-uppercase-digest ()
    (lwrs-digest
        "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"))

(defn lwrsw-metrics ()
    (lwrs-metrics 67 16 84 8 881 4 1 0 0 1 250000 1 0))
(defn lwrsw-bad-metrics ()
    (lwrs-metrics 67 16 84 8 881 4 1 0 0 1 250000000000 1 0))
(defn lwrsw-report-a ()
    (lwrs-report (lwrsw-dataset-a) (lwrsw-candidate)
        (lwrsw-contract) (lwrsw-metrics)))
(defn lwrsw-report-b ()
    (lwrs-report (lwrsw-dataset-b) (lwrsw-candidate)
        (lwrsw-contract) (lwrsw-metrics)))
(defn lwrsw-raw-shaped-report ()
    (lwrs-report (intern_trivial_string "raw-private")
        (lwrsw-candidate) (lwrsw-contract) (lwrsw-metrics)))
(defn lwrsw-bad-metric-report ()
    (lwrs-report (lwrsw-dataset-a) (lwrsw-candidate)
        (lwrsw-contract) (lwrsw-bad-metrics)))

(defn lwrsw-consent (dataset expiry expiry-default)
    (lwrs-consent LWRSW-OWNER dataset LWRSW-PURPOSE
        (lwo-interface (list LWRSW-ACTION)) LWRSW-LENS
        expiry expiry-default 1 1))
(defn lwrsw-consent-a ()
    (lwrsw-consent (lwrsw-dataset-a) (lwo-none) (lwo-none)))
(defn lwrsw-consent-b ()
    (lwrsw-consent (lwrsw-dataset-b) (lwo-none) (lwo-none)))
(defn lwrsw-expired-consent ()
    (lwrsw-consent (lwrsw-dataset-a) (intern_trivial_int 100)
        (oac-one LWRSW-DEFAULT)))
(defn lwrsw-future-consent ()
    (lwrsw-consent (lwrsw-dataset-a) (intern_trivial_int 101)
        (oac-one LWRSW-DEFAULT)))

(defn lwrsw-entry (source payload provenance)
    (lwt-entry
        (lwo-offer source (lwo-interface (list LWRSW-ACTION)) 1
            payload provenance 1)
        LWRSW-ACTION))
(defn lwrsw-response-entry (proposal)
    (lwrsw-entry LWRSW-OWNER
        (lwt-response proposal (oac-one proposal) LWRSW-PROVENANCE)
        LWRSW-PROVENANCE))
(defn lwrsw-revocation-entry (source observation)
    (lwrsw-entry source
        (lwo-revocation observation source LWRSW-REASON LWRSW-PROVENANCE)
        LWRSW-PROVENANCE))

(defn lwrsw-empty-content? (transition)
    (do
        (let world (lwo-transition-world transition))
        (if (and (eq (lwo-field-size (lwo-world-cells world)) 0)
                 (eq (lwo-field-size
                        (lwo-world-attributions world)) 0)) 1 0)))

; Result retains only minimized codec cells and worlds.  No report fixture has
; a raw prompt, answer, session text, path label, or model output field.
(defn lwrsw-run (started)
    (do
        (let report-a (lwrsw-report-a))
        (let report-b (lwrsw-report-b))
        (let consent-a (lwrsw-consent-a))
        (let consent-b (lwrsw-consent-b))
        (let observation (lwrs-observation report-a LWRSW-LENS))

        (let validate-enter
            (lcfb-call-stream "living-world-session-observation"
                "validate-minimized" "enter" "form-native"
                "lwrs-report-valid?" "digest-and-aggregate-only" 1 started
                "form/form-stdlib/tests/living-world-session-observation-witness.fk"
                96 13))
        (let bad-raw
            (lwrs-receive (lwo-empty-world) (lwrsw-raw-shaped-report)
                consent-a LWRSW-ACTION 10))
        (let bad-metric
            (lwrs-receive (lwo-empty-world) (lwrsw-bad-metric-report)
                consent-a LWRSW-ACTION 10))
        (let validate-leave
            (lcfb-call-stream "living-world-session-observation"
                "validate-minimized" "leave" "form-native"
                "lwrs-report-valid?" "digest-and-aggregate-only" 2 started
                "form/form-stdlib/tests/living-world-session-observation-witness.fk"
                108 13))

        (let refuse-enter
            (lcfb-call-stream "living-world-session-observation"
                "refuse-no-consent" "enter" "form-native"
                "lwrs-receive" "content-blind-boundary" 3 started
                "form/form-stdlib/tests/living-world-session-observation-witness.fk"
                115 13))
        (let missing
            (lwrs-receive (lwo-empty-world) report-a (lwo-none)
                LWRSW-ACTION 10))
        (let mismatch
            (lwrs-receive (lwo-empty-world) report-b consent-a
                LWRSW-ACTION 10))
        (let refuse-leave
            (lcfb-call-stream "living-world-session-observation"
                "refuse-no-consent" "leave" "form-native"
                "lwrs-receive" "content-blind-boundary" 4 started
                "form/form-stdlib/tests/living-world-session-observation-witness.fk"
                127 13))

        (let expiry-enter
            (lcfb-call-stream "living-world-session-observation"
                "distinguish-expiry" "enter" "form-native"
                "lwrs-expiry-ack" "declared-default-at-boundary" 5 started
                "form/form-stdlib/tests/living-world-session-observation-witness.fk"
                134 13))
        (let expired
            (lwrs-receive (lwo-empty-world) report-a
                (lwrsw-expired-consent) LWRSW-ACTION 100))
        (let future
            (lwrs-receive (lwo-empty-world) report-a
                (lwrsw-future-consent) LWRSW-ACTION 100))
        (let expiry-leave
            (lcfb-call-stream "living-world-session-observation"
                "distinguish-expiry" "leave" "form-native"
                "lwrs-expiry-ack" "declared-default-at-boundary" 6 started
                "form/form-stdlib/tests/living-world-session-observation-witness.fk"
                146 13))

        (let admit-enter
            (lcfb-call-stream "living-world-session-observation"
                "admit-distinct-evidence" "enter" "form-native"
                "lwrs-receive" "same-owner-distinct-datasets" 7 started
                "form/form-stdlib/tests/living-world-session-observation-witness.fk"
                153 13))
        (let first
            (lwrs-receive (lwo-empty-world) report-a consent-a
                LWRSW-ACTION 10))
        (let first-world (lwo-transition-world first))
        (let duplicate
            (lwrs-receive first-world report-a consent-a LWRSW-ACTION 10))
        (let duplicate-world (lwo-transition-world duplicate))
        (let duplicate-proposal
            (lwtf-proposal-for duplicate-world observation 2))
        (let second
            (lwrs-receive duplicate-world report-b consent-b LWRSW-ACTION 10))
        (let evidence-world (lwo-transition-world second))
        (let proposal (lwtf-proposal-for evidence-world observation 2))
        (let admit-leave
            (lcfb-call-stream "living-world-session-observation"
                "admit-distinct-evidence" "leave" "form-native"
                "lwrs-receive" "same-owner-distinct-datasets" 8 started
                "form/form-stdlib/tests/living-world-session-observation-witness.fk"
                172 13))

        (let integrate-enter
            (lcfb-call-stream "living-world-session-observation"
                "consent-integrate" "enter" "form-native"
                "lwtf-integrate" "one-owner-one-vote" 9 started
                "form/form-stdlib/tests/living-world-session-observation-witness.fk"
                179 13))
        (let round
            (lwt-round evidence-world (lwo-field (list proposal))
                (lwo-empty-field) (lwo-none)))
        (let responded
            (lwt-round-receive round (list (lwrsw-response-entry proposal))))
        (let integrated
            (lwtf-integrate responded proposal LWRSW-ACTION))
        (let integrated-world (lwt-round-world integrated))
        (let candidate (lwt-proposal-candidate proposal))
        (let alternatives (lwo-field (list LWRSW-ALTERNATIVE)))
        (let prediction
            (lwtf-predict integrated-world (lwrs-context report-a)
                alternatives LWRSW-UNKNOWN))
        (let integrate-leave
            (lcfb-call-stream "living-world-session-observation"
                "consent-integrate" "leave" "form-native"
                "lwtf-integrate" "one-owner-one-vote" 10 started
                "form/form-stdlib/tests/living-world-session-observation-witness.fk"
                198 13))

        (let revoke-enter
            (lcfb-call-stream "living-world-session-observation"
                "revoke-owner-support" "enter" "form-native"
                "lwo-revocation" "foreign-refused-owner-honored" 11 started
                "form/form-stdlib/tests/living-world-session-observation-witness.fk"
                205 13))
        (let foreign-world
            (lwt-receive-stream integrated-world
                (list (lwrsw-revocation-entry LWRSW-FOREIGN observation))))
        (let revoked-world
            (lwt-receive-stream foreign-world
                (list (lwrsw-revocation-entry LWRSW-OWNER observation))))
        (let after-revoke
            (lwtf-predict revoked-world (lwrs-context report-a)
                alternatives LWRSW-UNKNOWN))
        (let revoke-leave
            (lcfb-call-stream "living-world-session-observation"
                "revoke-owner-support" "leave" "form-native"
                "lwo-revocation" "foreign-refused-owner-honored" 12 started
                "form/form-stdlib/tests/living-world-session-observation-witness.fk"
                220 13))

        (list report-a report-b observation bad-raw bad-metric missing mismatch
              expired future first-world duplicate-world duplicate-proposal
              evidence-world proposal integrated-world candidate prediction
              foreign-world revoked-world after-revoke)))

(defn lwrsw-verdict (r)
    (do
        (let report-a (nth r 0))
        (let report-b (nth r 1))
        (let observation (nth r 2))
        (let bad-raw (nth r 3))
        (let bad-metric (nth r 4))
        (let missing (nth r 5))
        (let mismatch (nth r 6))
        (let expired (nth r 7))
        (let future (nth r 8))
        (let first-world (nth r 9))
        (let duplicate-world (nth r 10))
        (let duplicate-proposal (nth r 11))
        (let evidence-world (nth r 12))
        (let proposal (nth r 13))
        (let integrated-world (nth r 14))
        (let candidate (nth r 15))
        (let prediction (nth r 16))
        (let foreign-world (nth r 17))
        (let revoked-world (nth r 18))
        (let after-revoke (nth r 19))
        (sum (list
            (if (and (eq (lwrs-digest? (lwrsw-dataset-a)) 1)
                     (eq (lwrs-digest? (lwrsw-uppercase-digest)) 0)) 1 0)
            (if (and (eq (lwrs-metrics-valid? (lwrsw-metrics)) 1)
                     (eq (lwrs-metrics-valid? (lwrsw-bad-metrics)) 0)) 2 0)
            (if (and (eq (lwrs-report-valid? report-a) 1)
                     (eq (lwrs-report-valid?
                            (lwrsw-raw-shaped-report)) 0)) 4 0)
            (if (and (eq (oac-zero? (lwo-transition-ack missing)) 1)
                     (eq (lwrsw-empty-content? missing) 1)) 8 0)
            (if (and (eq (oac-one? (lwo-transition-ack expired)) 1)
                     (and (node_eq (oac-payload
                                    (lwo-transition-ack expired))
                                   LWRSW-DEFAULT)
                          (eq (lwrsw-empty-content? expired) 1))) 16 0)
            (if (not (node_eq (lwo-transition-ack missing)
                              (lwo-transition-ack expired))) 32 0)
            (if (and (eq (lwo-active? first-world observation) 1)
                     (eq (lwo-field-size
                            (lwo-active-attributions-for
                                first-world observation)) 1)) 64 0)
            (if (and (eq (lwo-field-size
                            (lwo-active-attributions-for
                                duplicate-world observation)) 1)
                     (node_eq duplicate-proposal (lwo-none))) 128 0)
            (if (and (node_eq observation
                        (lwrs-observation report-b LWRSW-LENS))
                     (and (eq (lwo-field-size
                                (lwo-active-attributions-for
                                    evidence-world observation)) 2)
                          (not (node_eq proposal (lwo-none))))) 256 0)
            (if (eq (lwo-field-size
                        (lwt-proposal-participants proposal)) 1) 512 0)
            (if (node_eq (lwo-emergent-shape
                            (lwt-proposal-candidate proposal))
                         observation) 1024 0)
            (if (eq (lwtf-integrated-current?
                        integrated-world candidate) 1) 2048 0)
            (if (and (eq (oac-one? (lwtf-prediction-ack prediction)) 1)
                     (node_eq (oac-payload
                                (lwtf-prediction-ack prediction))
                        (lwrs-outcome (lwrs-report-metrics report-a)))) 4096 0)
            (if (and (node_eq (lwtf-prediction-alternatives prediction)
                              (lwo-field (list LWRSW-ALTERNATIVE)))
                     (node_eq (lwtf-prediction-unknown prediction)
                              LWRSW-UNKNOWN)) 8192 0)
            (if (and (eq (oac-zero? (lwo-transition-ack mismatch)) 1)
                     (eq (lwrsw-empty-content? mismatch) 1)) 16384 0)
            (if (and (eq (lwo-active? (lwo-transition-world future)
                                observation) 1)
                     (eq (lwrs-consent-expired?
                            (lwrsw-expired-consent) 100) 1)) 32768 0)
            (if (and (eq (lwrsw-empty-content? bad-raw) 1)
                     (eq (lwrsw-empty-content? bad-metric) 1)) 65536 0)
            (if (and (eq (lwtf-integrated-current?
                            foreign-world candidate) 1)
                     (eq (lwo-active? foreign-world observation) 1)) 131072 0)
            (if (and (eq (lwtf-integrated-current?
                            revoked-world candidate) 0)
                     (eq (lwo-active? revoked-world observation) 0)) 262144 0)
            (if (and (eq (oac-nothing?
                            (lwtf-prediction-ack after-revoke)) 1)
                     (and (eq (lwo-active? revoked-world candidate) 1)
                          (and (eq (lwo-field-size
                                    (lwtf-prediction-possibilities
                                        after-revoke)) 0)
                               (node_eq (lwtf-prediction-unknown after-revoke)
                                        LWRSW-UNKNOWN)))) 524288 0)))))
