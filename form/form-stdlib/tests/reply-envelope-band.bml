// reply-envelope-band.bml — the planner reply's envelope grammar (reply-envelope.bml), read on scripted replies, no model.
// Verdict 16383 when every claim lands:
//   1    a whole cases reply (plan, goal, two cases, reference) walks to end, where a stop may end it
//   2    a whole band reply walks to end
//   4    a raw newline inside a JSON string is refused; its escape holds
//   8    no count of cases ends a list: eight hold, a ninth's ',{' holds, and forty hold
//   16   a case key outside function, arguments, equals and call is refused at its first wrong byte
//   32   prose between blocks, a second <cases>, and <band> after <cases> are refused
//   64   a stop is refused inside a JSON block, inside a text block, and before <plan> and its witness close; it is
//        allowed between blocks once they have; cases and reference without a plan are not whole
//   128  a case string as long as the longest one a reply that reached the parser held (4080 bytes) holds, and so do a JSON string
//        of 20000 bytes and a block of 9000: no byte count ends them
//   256  after the whole reply, whitespace up to its tail room holds and a stop may still end it; any other byte is refused
//   512  an empty cases array and a plan that is not an object are refused
//   1024 the pick keeps an accepted greedy id, swaps a refused one for the first accepted candidate, and answers nothing
//        when no candidate holds
//   2048 a case holds flp-case?'s shape: function and arguments, or call, beside equals, each once; function and call
//        strings that are not blank, arguments an array, no object anywhere in equals; an object argument holds
//   4096 every block holds UTF-8: a character's continuation bytes come before anything else, a stray continuation and
//        an overlong lead are refused, and a JSON string holds a whole character
//   8192 a JSON number holds JSON's form: no leading zero before a digit, a digit after the point and the exponent
import form/form-stdlib/bml/reply-envelope.bml;
section [form.bml] {
 class ReplyEnvelopeBand {
  def reb-plan() = "<plan>{\"id\":\"gap-one\",\"writable\":[\"form/x.bml\"],\"definitions\":[{\"name\":\"f\",\"params\":[\"a\"]}],\"full\":1,\"ok\":true,\"none\":null,\"n\":-1.5e3}</plan>\n";
  def reb-goal() = "<goal>f answers its argument doubled; a < b stays text.</goal>\n";
  def reb-cases() = "<cases>[{\"function\":\"f\",\"arguments\":[2],\"equals\":4},\n {\"call\":\"f(3)\",\"equals\":[6,\"six\\n\"]}]</cases>\n";
  def reb-reference() = "<reference>def f(a) = a * 2; // <b> stays text</reference>";
  def reb-whole() = reb-plan() ++ reb-goal() ++ reb-cases() ++ reb-reference();
  def reb-mode(text) = nothing?(renv-feed(renv-start(), text)) ? "refused" : renv-mode(renv-feed(renv-start(), text));
  def reb-refused?(text) = nothing?(renv-feed(renv-start(), text));
  def reb-held?(text) = !reb-refused?(text);
  def reb-case() = "{\"function\":\"f\",\"arguments\":[1],\"equals\":2}";
  def reb-cases-of(n) = n <= 1 ? reb-case() : reb-case() ++ "," ++ reb-cases-of(n - 1);
  def reb-repeat(s, n) = n <= 0 ? "" : s ++ reb-repeat(s, n - 1);
  def reb-bytes(bs) = foldl((s, b) => s ++ byte_to_str(b), "", bs);
  def reb-stop?(id) = id == 0;
  def reb-text(id) = id == 1 ? "}" : id == 2 ? "\n" : id == 3 ? "]" : id == 4 ? "<" : "x";
  def reb-observe() {
   let whole = renv-feed(renv-start(), reb-whole());
   let c1 = !nothing?(whole) && (String) renv-mode(whole) == "end" && renv-stop-ok?(whole) ? 1 : 0;
   let c2 = (String) reb-mode(reb-plan() ++ reb-goal() ++ "<band>; Verdict 1\n(do 1)</band>" ++ reb-reference()) == "end" ? 2 : 0;
   let c4 = reb-refused?("<cases>[{\"call\":\"a\nb\"") && reb-held?("<cases>[{\"call\":\"a\\nb\"") ? 4 : 0;
   let c8 = reb-held?("<cases>[" ++ reb-cases-of(8) ++ "]</cases>") && reb-held?("<cases>[" ++ reb-cases-of(8) ++ ",{") && reb-held?("<cases>[" ++ reb-cases-of(40) ++ "]</cases>") ? 8 : 0;
   let c16 = reb-refused?("<cases>[{\"funx") && reb-held?("<cases>[{\"func") && reb-refused?("<cases>[{\"function\":\"f\",\"args\"") && reb-held?("<plan>{\"args\":1}") ? 16 : 0;
   let c32 = reb-refused?(reb-plan() ++ "Here is the plan") && reb-refused?(reb-cases() ++ "<cases>") && reb-refused?(reb-cases() ++ "<band>") && reb-held?(reb-cases() ++ "<goal>") ? 32 : 0;
   let mid-json = renv-feed(renv-start(), "<cases>[{\"call\":\"f");
   let mid-text = renv-feed(renv-start(), "<goal>half");
   let between = renv-feed(renv-start(), reb-plan() ++ reb-cases());
   let planned = renv-feed(renv-start(), reb-plan());
   let unplanned = renv-feed(renv-start(), reb-cases() ++ reb-reference());
   let c64 = !renv-stop-ok?(mid-json) && !renv-stop-ok?(mid-text) && renv-stop-ok?(between) && !renv-stop-ok?(planned) && !renv-stop-ok?(renv-feed(renv-start(), "<pla")) && !renv-stop-ok?(renv-start()) && (String) renv-mode(unplanned) == "out" && !renv-stop-ok?(unplanned) && (String) renv-mode(renv-feed(unplanned, reb-plan())) == "end" ? 64 : 0;
   let c128 = reb-held?("<cases>[{\"call\":\"" ++ reb-repeat("a", 4080) ++ "\",\"equals\":1}]</cases>") && reb-held?("<cases>[{\"call\":\"" ++ reb-repeat("a", 20000)) && reb-held?("<goal>" ++ reb-repeat("b", 9000)) ? 128 : 0;
   let c256 = !nothing?(whole) && renv-stop-ok?(renv-step(whole, 10)) && nothing?(renv-step(whole, 60)) && nothing?(renv-step(whole, 120)) && reb-held?(reb-whole() ++ reb-repeat("\n", renv-tail-room())) && reb-refused?(reb-whole() ++ reb-repeat("\n", renv-tail-room() + 1)) ? 256 : 0;
   let c512 = reb-refused?("<cases>[]") && reb-refused?("<plan>[") && reb-refused?("<cases>{") && reb-refused?("<cases>[1") ? 512 : 0;
   let inside = renv-feed(renv-start(), "<plan>{\"a\":1");
   let c1024 = renv-pick(inside, [1, 3], reb-text, reb-stop?) == 1 && renv-pick(inside, [0, 3, 4, 2, 1], reb-text, reb-stop?) == 2 && nothing?(renv-pick(inside, [0, 3, 4, 9], reb-text, reb-stop?)) && renv-pick(between, [0, 9], reb-text, reb-stop?) == 0 ? 1024 : 0;
   let c2048 = reb-refused?("<cases>[{\"function\":\"f\",\"equals\":1}") && reb-refused?("<cases>[{\"call\":\"f(1)\",\"f") && reb-refused?("<cases>[{\"function\":\"f\",\"arguments\":[1],\"equals\":{")
    && reb-refused?("<cases>[{\"function\":\"f\",\"arguments\":[1],\"equals\":[[1,{") && reb-refused?("<cases>[{\"function\":1") && reb-refused?("<cases>[{\"function\":\"f\",\"arguments\":{")
    && reb-refused?("<cases>[{\"call\":\" \\n \"") && reb-refused?("<cases>[{\"function\":\"f\",\"function\"") && reb-refused?("<cases>[{}") && reb-refused?("<cases>[{\"call\":\"g()\",\"equals\":1,\"arguments\"")
    && reb-held?("<cases>[{\"function\":\"f\",\"arguments\":[{\"count\":0}],\"equals\":[1,[2,\"x\"]]},{\"equals\":null,\"call\":\"g()\"}]</cases>") ? 2048 : 0;
   let c4096 = reb-held?("<goal>caf" ++ reb-bytes([195, 169]) ++ "</goal>") && reb-refused?("<goal>caf" ++ reb-bytes([195]) ++ "<") && reb-refused?("<goal>" ++ reb-bytes([128]))
    && reb-refused?("<goal>" ++ reb-bytes([192, 175])) && reb-held?("<cases>[{\"call\":\"" ++ reb-bytes([226, 130, 172]) ++ "\"") && reb-refused?("<cases>[{\"call\":\"" ++ reb-bytes([226, 130]) ++ "\"")
    && reb-refused?("<plan>{" ++ reb-bytes([195, 169])) ? 4096 : 0;
   let c8192 = reb-refused?("<plan>{\"a\":01") && reb-refused?("<plan>{\"a\":1.}") && reb-refused?("<plan>{\"a\":-}") && reb-refused?("<plan>{\"a\":--1") && reb-refused?("<plan>{\"a\":1e}")
    && reb-held?("<plan>{\"a\":0.5,\"b\":-0,\"c\":2E3,\"d\":1e+5,\"e\":[10,-7.25e-2]}</plan>") ? 8192 : 0;
   print(["reply-envelope", c1, c2, c4, c8, c16, c32, c64, c128, c256, c512, c1024, c2048, c4096, c8192]);
   c1 + c2 + c4 + c8 + c16 + c32 + c64 + c128 + c256 + c512 + c1024 + c2048 + c4096 + c8192;
  }
 }
 let verdict = reb-observe();
 verdict == 16383 ? verdict : form_error("the reply envelope read " + verdict.str() + " of 16383");
}
