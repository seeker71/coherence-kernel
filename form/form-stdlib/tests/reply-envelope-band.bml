// reply-envelope-band.bml — the planner reply's envelope grammar (reply-envelope.bml), read on scripted replies, no model.
// Verdict 2047 when every claim lands:
//   1    a whole cases reply (plan, goal, two cases, reference) walks to end, where a stop may end it
//   2    a whole band reply walks to end
//   4    a raw newline inside a JSON string is refused; its escape holds
//   8    eight cases hold, a ninth's ',' is refused, and ']' after the eighth holds
//   16   a case key outside function, arguments, equals and call is refused at its first wrong byte
//   32   prose between blocks, a second <cases>, and <band> after <cases> are refused
//   64   a stop is refused inside a JSON block and inside a text block, and allowed between blocks
//   128  a JSON string past its room and a block past its room are refused
//   256  after the whole reply, any byte is refused
//   512  an empty cases array and a plan that is not an object are refused
//   1024 the pick keeps an accepted greedy id, swaps a refused one for the first accepted candidate, and answers nothing
//        when no candidate holds
import form/form-stdlib/bml/reply-envelope.bml;
section [form.bml] {
 class ReplyEnvelopeBand {
  def reb-plan() = "<plan>{\"id\":\"gap-one\",\"writable\":[\"form/x.bml\"],\"definitions\":[{\"name\":\"f\",\"params\":[\"a\"]}],\"full\":1,\"ok\":true,\"none\":null,\"n\":-1.5e3}</plan>\n";
  def reb-goal() = "<goal>f answers its argument doubled; a < b stays text.</goal>\n";
  def reb-cases() = "<cases>[{\"function\":\"f\",\"arguments\":[2],\"equals\":4},\n {\"call\":\"f(3)\",\"equals\":[6,\"six\\n\"]}]</cases>\n";
  def reb-reference() = "<reference>def f(a) = a * 2; // <b> stays text</reference>";
  def reb-whole() = reb-plan() ++ reb-goal() ++ reb-cases() ++ reb-reference();
  def reb-mode(text) = nothing?(renv-feed(renv-start(), text)) ? "refused" : renv-mode(renv-feed(renv-start(), text));
  def reb-refused?(text) = nothing?(renv-feed(renv-start(), text));
  def reb-held?(text) = !reb-refused?(text);
  def reb-case() = "{\"function\":\"f\",\"arguments\":[1],\"equals\":2}";
  def reb-cases-of(n) = n <= 1 ? reb-case() : reb-case() ++ "," ++ reb-cases-of(n - 1);
  def reb-repeat(s, n) = n <= 0 ? "" : s ++ reb-repeat(s, n - 1);
  def reb-stop?(id) = id == 0;
  def reb-text(id) = id == 1 ? "}" : id == 2 ? "\n" : id == 3 ? "]" : id == 4 ? "<" : "x";
  def reb-observe() {
   let whole = renv-feed(renv-start(), reb-whole());
   let c1 = !nothing?(whole) && (String) renv-mode(whole) == "end" && renv-stop-ok?(whole) ? 1 : 0;
   let c2 = (String) reb-mode(reb-plan() ++ reb-goal() ++ "<band>; Verdict 1\n(do 1)</band>" ++ reb-reference()) == "end" ? 2 : 0;
   let c4 = reb-refused?("<cases>[{\"call\":\"a\nb\"") && reb-held?("<cases>[{\"call\":\"a\\nb\"") ? 4 : 0;
   let c8 = reb-held?("<cases>[" ++ reb-cases-of(8) ++ "]</cases>") && reb-refused?("<cases>[" ++ reb-cases-of(8) ++ ",") && reb-held?("<cases>[" ++ reb-cases-of(7) ++ ",{") ? 8 : 0;
   let c16 = reb-refused?("<cases>[{\"funx") && reb-held?("<cases>[{\"func") && reb-refused?("<cases>[{\"function\":\"f\",\"args\"") && reb-held?("<plan>{\"args\":1}") ? 16 : 0;
   let c32 = reb-refused?(reb-plan() ++ "Here is the plan") && reb-refused?(reb-cases() ++ "<cases>") && reb-refused?(reb-cases() ++ "<band>") && reb-held?(reb-cases() ++ "<goal>") ? 32 : 0;
   let mid-json = renv-feed(renv-start(), "<cases>[{\"call\":\"f");
   let mid-text = renv-feed(renv-start(), "<goal>half");
   let between = renv-feed(renv-start(), reb-plan());
   let c64 = !renv-stop-ok?(mid-json) && !renv-stop-ok?(mid-text) && renv-stop-ok?(between) && !renv-stop-ok?(renv-feed(renv-start(), "<pla")) ? 64 : 0;
   let c128 = reb-held?("<cases>[{\"call\":\"" ++ reb-repeat("a", 1200)) && reb-refused?("<cases>[{\"call\":\"" ++ reb-repeat("a", 1201)) && reb-held?("<goal>" ++ reb-repeat("b", 2999)) && reb-refused?("<goal>" ++ reb-repeat("b", 3001)) ? 128 : 0;
   let c256 = !nothing?(whole) && nothing?(renv-step(whole, 32)) && nothing?(renv-step(whole, 60)) ? 256 : 0;
   let c512 = reb-refused?("<cases>[]") && reb-refused?("<plan>[") && reb-refused?("<cases>{") && reb-refused?("<cases>[1") ? 512 : 0;
   let inside = renv-feed(renv-start(), "<plan>{\"a\":1");
   let c1024 = renv-pick(inside, [1, 3], reb-text, reb-stop?) == 1 && renv-pick(inside, [0, 3, 4, 2, 1], reb-text, reb-stop?) == 2 && nothing?(renv-pick(inside, [0, 3, 4, 9], reb-text, reb-stop?)) && renv-pick(between, [0, 9], reb-text, reb-stop?) == 0 ? 1024 : 0;
   print(["reply-envelope", c1, c2, c4, c8, c16, c32, c64, c128, c256, c512, c1024]);
   c1 + c2 + c4 + c8 + c16 + c32 + c64 + c128 + c256 + c512 + c1024;
  }
 }
 let verdict = reb-observe();
 verdict == 2047 ? verdict : form_error("the reply envelope read " + verdict.str() + " of 2047");
}
