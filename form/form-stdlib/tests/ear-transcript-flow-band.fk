; Synthetic speech only. No mic, model, shared frame, or live lease writes.
; Expected: 65535.
; preludes: form/form-stdlib/form-glass-meaning-ui.bml form/form-stdlib/bml/ear-worker-life.bml form/form-stdlib/bml/ear-translation-flow.bml
(do
    (defn efb-bit (name ok weight) (if ok weight (do (print name) 0)))
    (defn efb-row (kind code text epoch life) (etr-row kind code text epoch life "synthetic fixture"))
    (defn efb-text (rows) (fgo-text-value (etr-latest rows)))
    (let first (efb-row "original-growing" "en" "The door" 100 "source"))
    (let held (etr-flow (list) (list first)))
    (let quiet (etr-flow held (list)))
    (let beat (etr-flow quiet (list (efb-row "original-growing" "en" "The door" 200 "source"))))
    (let correction (etr-flow beat (list (efb-row "original-growing" "en" "The floor" 300 "source"))))
    (let closed (etr-flow correction (list (efb-row "original-closed" "en" "The floor is warm." 400 "stored"))))
    (let next (etr-flow closed (list (efb-row "original-growing" "en" "We can" 500 "source"))))
    (let older (etr-flow next (list (efb-row "original-growing" "en" "Old words" 250 "source"))))
    (let translated (etr-flow (list (efb-row "translation-growing" "pt" "A porta" 700 "source")) (list (efb-row "translation-closed" "pt" "Velha frase" 600 "stored"))))
    (let longRow (efb-row "original-growing" "en" "one two three four five six seven eight nine ten eleven twelve thirteen fourteen" 500 "source"))
    (let owner (ewl-token 123 456))
    (print (sum (list
        (efb-bit "quiet retains words" (str_eq (efb-text quiet) "The door") 1)
        (efb-bit "heartbeat retains source stamp" (eq (fgo-observed-epoch (head beat)) 100) 2)
        (efb-bit "correction is not hidden" (str_eq (efb-text correction) "The floor") 4)
        (efb-bit "final replaces partial in its slot" (str_eq (efb-text closed) "The floor is warm.") 8)
        (efb-bit "next segment flows immediately" (str_eq (efb-text next) "We can") 16)
        (efb-bit "late partial cannot rewind" (str_eq (efb-text older) "We can") 32)
        (efb-bit "late closed translation cannot rewind" (str_eq (efb-text translated) "A porta") 64)
        (efb-bit "missing short long slots have same height" (and (eq (len (fglm-code-lines (list) "en" 20)) 5) (and (eq (len (fglm-code-lines closed "en" 20)) 5) (eq (len (fglm-code-lines (list longRow) "en" 20)) 5))) 128)
        (efb-bit "bounded identities not history" (eq (len older) 1) 256)
        (efb-bit "owner encoding and live lease" (and (eq (ewl-pid owner) 123) (ewl-same? owner owner 1)) 512)
        (efb-bit "dead or replaced owner stops" (and (not (ewl-same? owner owner 0)) (not (ewl-same? owner (ewl-token 123 789) 1))) 1024)
        (efb-bit "standalone lease compatible; expired deadline stops" (and (ewl-owned? "") (not (ewl-running? (ewl-session 0 "")))) 2048)
        (efb-bit "aged speech not stamped fresh by polling" (eq (fgo-age (head (fgo-age-rows-at beat 1000))) 900) 4096)
        (efb-bit "unchanged source reuses previous decode" (eq (len (etf-forced "door" "door" (list 1) (list 1 2))) 2) 8192)
        (efb-bit "extension reuses only agreed prefix" (eq (len (etf-forced "door" "door open" (list 1) (list 1 2))) 1) 16384)
        (efb-bit "corrected source cannot force wrong translation" (and (eq (len (etf-forced "door" "floor" (list 1) (list 1 2))) 0) (not (etf-extends? "در باز است" "در"))) 32768)
    )))
)
