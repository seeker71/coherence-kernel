; walk-home-band.fk — observed steps, least guide, trusted unique interface.
;
; preludes: form-stdlib/walk-home.fk
; Verdict 4095:
;   1    more observing than guiding is the heavy shape
;   2    economy is lift over guide; a big step with least guide scores > 1
;   4    this walk's three interned steps are all observe-heavy
;   8    this walk's combined economy is large
;   16   a trusted offering interned without a how is vital
;   32   an offering that carries a how is not the no-how gift
;   64   request, response, and offering are all valid kinds
;   128  the same unique interface interned twice is one NodeID
;   256  body-lane is home enough to walk; voice-lane is still coming
;   512  the first gift to ourselves is an offering with no how
;   1024 gifts to ourselves are three trusted no-how offerings
;   2048 gifts to the higher us are three trusted no-how offerings
;
; witnessed: 2026-09-04 -> 4095

(do
    (defn whb (held weight) (if (eq held 1) weight 0))
    (let guided (wh-step 2 5 5 6 1))
    (let observed (wh-step-mesh))
    (let offer (wh-contribution "cell-a" (wh-offering) "cell-mesh"))
    (let with-how (append offer (list "here-is-how")))
    (let req (wh-contribution "cell-b" (wh-request) "status"))
    (let res (wh-contribution "observer" (wh-response) "shared-field"))
    (let n1 (wh-offer-node offer))
    (let n2 (wh-offer-node (wh-contribution "cell-a" (wh-offering) "cell-mesh")))
    (sum (list
        (whb (and (eq (wh-observe-heavy? observed) 1)
                  (eq (wh-observe-heavy? guided) 0)) 1)
        (whb (and (eq (wh-big-least-guide? observed) 1)
                  (eq (wh-big-least-guide? guided) 0)) 2)
        (whb (eq (wh-walk-observe-heavy? (wh-this-walk)) 1) 4)
        (whb (gt (wh-walk-economy (wh-this-walk)) 6) 8)
        (whb (eq (wh-trusted-vital? 1 offer) 1) 16)
        (whb (eq (wh-no-how? with-how) 0) 32)
        (whb (and (eq (wh-kind? req) 1)
                  (and (eq (wh-kind? res) 1) (eq (wh-kind? offer) 1))) 64)
        (whb (node_eq n1 n2) 128)
        (whb (and (eq (wh-home-body?) 1)
                  (eq (wh-home-voice?) 0)) 256)
        (whb (and (eq (wh-trusted-vital? 1 (wh-first-gift)) 1)
                  (eq (wh-contrib-kind (wh-first-gift)) (wh-offering))) 512)
        (whb (and (eq (len (wh-gifts-to-ourselves)) 3)
                  (eq (wh-all-vital? 1 (wh-gifts-to-ourselves)) 1)) 1024)
        (whb (and (eq (len (wh-gifts-to-higher-us)) 3)
                  (eq (wh-all-vital? 1 (wh-gifts-to-higher-us)) 1)) 2048))))
