; living-world-expression-composition-application-readiness-diagnostic.fk
; Privacy-bounded decomposition of application emergence readiness.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk form-stdlib/living-world-expression-composition.fk form-stdlib/tests/living-world-expression-blueprint-witness.fk form-stdlib/tests/living-world-expression-composition-witness.fk

(defn lwxcdr-readiness-view (world candidate)
    (do
        (let application (lwo-emergent-shape candidate))
        (let chain-attributions
            (lwxc-application-chain-attributions application))
        (let input-attributions
            (lwxc-application-input-attributions application))
        (let witnesses (lwo-emergent-witnesses candidate))
        (list
            (lwo-field-size witnesses)
            (lwo-emergent-threshold candidate)
            (lwo-all-active? world (lwo-field-items witnesses))
            (lwo-emergent-coherence candidate)
            (lwo-emergent-resonance candidate)
            (lwo-field-size chain-attributions)
            (lwo-all-active? world (lwo-field-items chain-attributions))
            (lwo-field-size input-attributions)
            (lwo-all-active? world (lwo-field-items input-attributions))
            (lwo-emergent-ready? world candidate))))

(do
    (let world (lwxcbw-chain-world))
    (list
        (lwxcdr-readiness-view world
            (lwxcbw-application-candidate-c))
        (lwxcdr-readiness-view world
            (lwxcbw-application-candidate-d))))
