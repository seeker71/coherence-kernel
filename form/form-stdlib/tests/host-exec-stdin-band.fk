; host-exec-stdin-band.fk — (host-exec cmd input): input is the child's STDIN
; and cmd has no length wall. Before 2026-09-04 fk_host_exec read
; `(void)inputv` — the input was discarded — so (host-exec "cat" "hello")
; answered "" while the Go arm fed its second argument; and the command
; crossed through a fixed char cmd[8192], so a 368-path `git ls-files ... |
; xargs wc -l` composed in the shell because its list could not cross the
; membrane (observe/carrier-mass.bml). The sibling band
; host-exec-launch-honesty-band.fk owns the ABSENCE law (a launch that never
; happened answers nothing; "" is reserved for a command that ran and spoke
; zero bytes); this band owns the two doors R69 opened and proves the absence
; law holds through the stdin lane too.
;
; PROOF LEVEL: FOURTH-ARM ONLY — host-exec binds on go and fkwu (pf-arm-mask
; 9), and the starvation leg drives the repo-root fkwu binary itself, so this
; band runs on its home arm:
;   ./fkwu form/form-stdlib/tests/host-exec-stdin-band.fk
;
; Bits (power-of-two weights):
;    1  input crosses: (host-exec "cat" "hello") answers "hello"
;    2  empty input unchanged: (host-exec "printf hx-tok" "") answers "hx-tok"
;    4  a 20,000-byte input crosses whole: (host-exec "wc -c" big) counts 20000
;    8  a 20,000-byte COMMAND crosses whole: `printf %s <big>` answers 20000 bytes
;   16  a command that ran silent with input answers "" (a string, not nothing)
;   32  a nonzero exit with input still answers its output
;   64  a child that never reads a 262,144-byte input does not kill fkwu
;       (the write meets a closed pipe; SIGPIPE is held off)
;  128  a child that speaks 100,000 bytes BEFORE reading 262,144 bytes of stdin
;       completes — interleaved poll, no write-everything-first deadlock
;  256  a launch that never happened through the stdin lane answers nothing:
;       observe/host-exec-starved-stdin-probe.fk under ulimit -u 1 answers 1
; witnessed: 2026-09-04 -> 511
(do
    (defn hxs-digit? (b) (if (and (ge b 48) (le b 57)) 1 0))
    (defn hxs-int (s i n acc started)
        (if (ge i n) acc
            (do (let b (str_byte_at s i))
                (if (eq (hxs-digit? b) 1)
                    (hxs-int s (add i 1) n (add (mul acc 10) (sub b 48)) 1)
                    (if (eq started 1) acc (hxs-int s (add i 1) n acc 0))))))
    (defn hxs-lead-int (s) (if (nothing? s) (sub 0 1) (hxs-int s 0 (str_len s) 0 0)))
    (defn hxs-dbl (s n) (if (le n 0) s (hxs-dbl (str_concat s s) (sub n 1))))
    (defn hxs-str-is (r want) (if (nothing? r) 0 (if (str_eq r want) 1 0)))

    ; 16384 + 2048 + 1024 + 512 + 32 = 20000 bytes
    (let big (str_concat (hxs-dbl "x" 14)
             (str_concat (hxs-dbl "x" 11)
             (str_concat (hxs-dbl "x" 10)
             (str_concat (hxs-dbl "x" 9) (hxs-dbl "x" 5))))))
    (let huge (hxs-dbl "x" 18))

    (let c0 (if (eq (hxs-str-is (host-exec "cat" "hello") "hello") 1) 1 0))
    (let c1 (if (eq (hxs-str-is (host-exec "printf hx-tok" "") "hx-tok") 1) 2 0))
    (let c2 (if (eq (hxs-lead-int (host-exec "wc -c" big)) 20000) 4 0))
    (let r3 (host-exec (str_concat "printf %s " big) ""))
    (let c3 (if (nothing? r3) 0 (if (eq (str_len r3) 20000) 8 0)))
    (let r4 (host-exec "cat >/dev/null" "hello"))
    (let c4 (if (nothing? r4) 0 (if (eq (str_len r4) 0) 16 0)))
    (let c5 (if (eq (hxs-str-is (host-exec "cat; exit 3" "hx") "hx") 1) 32 0))
    (let c6 (if (eq (hxs-str-is (host-exec "printf done" huge) "done") 1) 64 0))
    (let r7 (host-exec "head -c 100000 /dev/zero; cat" huge))
    (let c7 (if (nothing? r7) 0 (if (eq (str_len r7) 362144) 128 0)))
    (let c8 (if (eq (hxs-lead-int (host-exec
        "ulimit -u 1; exec ./fkwu observe/host-exec-starved-stdin-probe.fk 2>/dev/null" "")) 1) 256 0))

    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 c8)))))))))
