; A real failed learner child must retain its exit, release the lock and keep the example pending.
; preludes: form-stdlib/native-session-memory.bml
(do
 (let home (str_concat "/tmp/session-worker-failure-" (nsm-id)))
 (nsm-init home)
 (nsm-write (nsm-at home "config.json") (json-node-object (list (nsm-s "validation" (nsm-at home "absent.jsonl")))))
 (nsm-record home "session" "one" "fixture" "x" "y" "caller-teaching" "public fixture" 0)
 (let launched (nsm-kick home))
 (let pid (str_to_int (nsm-text (nsm-at home "worker.pid"))))
 (let rc (host_wait pid))
 (let status (nsm-status home))
 (let checks (list (str_eq launched "launched") (not (eq rc 0))
  (str_eq (nsm-str status "worker_status") "failed-exit-1")
  (eq (nsm-num status "pending") 1)
  (gt (file_size (nsm-at home "learner.err")) 0)
  (not (fs-exists? (nsm-at home "worker.lock")))))
 (print checks)
 (fs-remove-tree home)
 (if (value_eq checks (list 1 1 1 1 1 1)) 63 (form_error "session learner failure was hidden")))
