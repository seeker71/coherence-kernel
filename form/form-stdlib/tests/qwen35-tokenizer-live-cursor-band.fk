; qwen35-tokenizer-live-cursor-band.fk -- pure cursor shape and semantics.
; Expected: 8191.
;
; preludes: form-stdlib/qwen35-tokenizer-live-cursor.fk

(do
    (defn qtlcb-bit (ok bit) (if ok bit 0))
    ; A current empty synthetic index is enough to prove constant-id streaming;
    ; no file lookup occurs on this path.
    (let x (list "current" "synthetic" "" 0 1 23 0 1 1 32))
    (let c0 (qtlc-open-index x
        (list (qtlc-id-segment (list 0 1 7))
              (qtlc-text-segment ""))))
    (let a (qtlc-next c0))
    (let b (qtlc-next (qtlc-next-cursor a)))
    (let c (qtlc-next (qtlc-next-cursor b)))
    (let d (qtlc-next (qtlc-next-cursor c)))
    (let counted (qtlc-count c0))
    (let absent-index
        (list "absent" "manifest-absent" "" 0 0 0 0 0 0 0))
    (let absent (qtlc-next (qtlc-open-index absent-index (empty))))
    (let absent-count (qtlc-count
        (qtlc-open-index absent-index (empty))))
    (let bad (qtlc-next (qtlc-open-index x
        (list (list "unknown" (list 9))))))
    (let segments (list (qtlc-id-segment (list 5 6))
                        (qtlc-text-segment "abc")))
    (let crystal (list 1 10 11 12 13 (list 20) (list 21)
        (list 22) (list 23)))
    (let full (qtlc-full-chat-segments "p" "s" crystal))
    (add
        (qtlcb-bit (and (eq (qtlc-next-present? a) 1)
                         (eq (qtlc-next-value a) 0)) 1)
    (add (qtlcb-bit (and (eq (qtlc-next-present? b) 1)
                          (eq (qtlc-next-value b) 1)) 2)
    (add (qtlcb-bit (and (eq (qtlc-next-present? c) 1)
                          (eq (qtlc-next-value c) 7)) 4)
    (add (qtlcb-bit (and (eq (qtlc-next-present? d) 0)
                          (nothing? (qtlc-next-value d))) 8)
    (add (qtlcb-bit (and (str_eq (qtlc-next-status d) "done")
                          (eq (qtlc-released? (qtlc-next-cursor d)) 1)) 16)
    (add (qtlcb-bit (eq (qtlc-token-count (qtlc-next-cursor d)) 3) 32)
    (add (qtlcb-bit (and (str_eq (qtlc-next-status absent) "absent")
                          (eq (qtlc-next-present? absent) 0)) 64)
    (add (qtlcb-bit (and (nothing? (qtlc-next-value absent))
                          (eq (qtlc-released? (qtlc-next-cursor absent)) 1)) 128)
    (add (qtlcb-bit (and (str_eq (qtlc-next-status bad) "failure")
                          (str_eq (qtlc-reason (qtlc-next-cursor bad))
                                  "unknown-segment")) 256)
    (add (qtlcb-bit (eq (qtlc-segments-upper-bound segments 0) 5) 512)
    (add (qtlcb-bit (eq (qtlc-segments-upper-bound full 0) 22) 1024)
    (add (qtlcb-bit (and (str_eq (nth counted 0) "done")
                    (and (eq (qtlc-token-count (nth counted 1)) 3)
                         (eq (qtlc-released? (nth counted 1)) 1))) 2048)
         (qtlcb-bit (and (str_eq (nth absent-count 0) "absent")
                         (eq (qtlc-token-count (nth absent-count 1)) 0))
                    4096)))))))))))))
)
