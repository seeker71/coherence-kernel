; situated-lens-authorized-control-band.fk — prove that only an admitted,
; fresh, distinct authority quorum may change the situated evidence field.
; preludes: form-stdlib/core.fk form-stdlib/core-word-inquiry.fk form-stdlib/situated-lens-conclusion.fk form-stdlib/situated-lens-conclusion-control.fk form-stdlib/situated-evidence-authority.fk form-stdlib/situated-lens-authorized-control.fk

(do
    (defn slacb-bit (condition bit) (if condition bit 0))
    (defn slacb-sum (values)
        (if (eq (len values) 0) 0
            (add (head values) (slacb-sum (tail values)))))

    (let lens (cwi-lens 1 2 3 4))
    (let offered (slc-observation 10 lens 1 6 9001))
    (let policy (sea-policy (list 7001 7002) 2 3))
    (let a (sea-endorsement 7001 9001 10 lens 1 6 11))
    (let b (sea-endorsement 7002 9001 10 lens 1 6 12))
    (let trusted (list a b))
    (let missing (slc-settle-situated
        "WE" "we" "what" 0 5 (list) 10 lens 1))
    (let admitted
        (slac-decide (slcc-action missing)
            (list) offered 10 lens (slc-o-node missing) 9901
            trusted policy 13))
    (let admitted-authority (slac-d-authority admitted))
    (let admitted-state (slac-d-state admitted))
    (let after-admitted (slc-settle-situated
        "WE" "we" "what" 0 5
        (slcc-s-field admitted-state) 10 lens 1))

    (let insufficient
        (slac-decide (slcc-action missing)
            (list) offered 10 lens (slc-o-node missing) 9902
            (list a) policy 13))
    (let insufficient-state (slac-d-state insufficient))
    (let after-insufficient (slc-settle-situated
        "WE" "we" "what" 0 5
        (slcc-s-field insufficient-state) 10 lens 1))

    (let equivocation
        (slac-decide (slcc-action missing)
            (list) offered 10 lens (slc-o-node missing) 9903
            (list a b (sea-endorsement
                7001 9001 10 lens 0 6 13))
            policy 13))
    (let equivocation-state (slac-d-state equivocation))

    (let ambiguous-field
        (list offered (slc-observation 10 lens 0 7 9002)))
    (let ambiguous (slc-settle-situated
        "WE" "we" "what" 0 5 ambiguous-field 10 lens 1))
    (let abstained
        (slac-decide (slcc-action ambiguous)
            ambiguous-field offered 10 lens
            (slc-o-node ambiguous) 9904
            (list) (list) 999))

    (let invalid-field
        (list (slc-observation 10 lens 1 -1 9004)))
    (let invalid (slc-settle-situated
        "WE" "we" "what" 0 5 invalid-field 10 lens 1))
    (let revised
        (slac-decide (slcc-action invalid)
            invalid-field offered 10 lens
            (slc-o-node invalid) 9905 trusted policy 13))
    (let revised-state (slac-d-state revised))
    (let after-revised (slc-settle-situated
        "WE" "we" "what" 0 5
        (slcc-s-field revised-state) 10 lens 1))

    ; 262143 means all 18 observations held.
    (slacb-sum
        (list
            (slacb-bit (eq (slcc-action missing) 4) 1)
            (slacb-bit (eq (sea-o-admitted admitted-authority) 1) 2)
            (slacb-bit (eq (slcc-s-accepted admitted-state) 1) 4)
            (slacb-bit (eq (slcc-s-selected admitted-state) 9001) 8)
            (slacb-bit
                (and (eq (slc-o-kind after-admitted) (slc-tag-value))
                     (eq (slc-o-conclusion after-admitted) 1)) 16)
            (slacb-bit
                (eq (sea-o-reason
                    (slac-d-authority insufficient)) 2) 32)
            (slacb-bit (eq (slcc-s-accepted insufficient-state) 0) 64)
            (slacb-bit (eq (slcc-s-selected insufficient-state) 9902) 128)
            (slacb-bit
                (eq (slc-o-reason after-insufficient) 2) 256)
            (slacb-bit
                (eq (sea-o-reason
                    (slac-d-authority equivocation)) 3) 512)
            (slacb-bit (eq (slcc-s-accepted equivocation-state) 0) 1024)
            (slacb-bit (eq (slcc-action ambiguous) 3) 2048)
            (slacb-bit
                (eq (sea-o-reason (slac-d-authority abstained)) 4) 4096)
            (slacb-bit
                (and (eq (slcc-s-accepted (slac-d-state abstained)) 1)
                     (eq (slcc-s-selected
                            (slac-d-state abstained)) 9904)) 8192)
            (slacb-bit (eq (slcc-action invalid) 2) 16384)
            (slacb-bit (eq (slcc-s-accepted revised-state) 1) 32768)
            (slacb-bit
                (and (eq (slc-o-kind after-revised) (slc-tag-value))
                     (eq (slc-o-source after-revised) 9001)) 65536)
            (slacb-bit
                (and (eq (slac-authority-required? 0) 0)
                     (eq (slac-authority-required? 4) 1)) 131072))))
