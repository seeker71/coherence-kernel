; Regression: stream commits, current gauges, exact census, safe preflight.
; Fixture I/O is private; no writes to hearth or live Glass frames.
; Expected: 262143 (18 independent assertions).
; preludes: form-stdlib/form-glass-live.bml form-stdlib/bml/form-glass-organ-care.bml
(do
    (defn fghb-fold (rows weight) (if (eq (len rows) 0) 0
        (add (if (head rows) weight 0) (fghb-fold (tail rows) (mul weight 2)))))
    (defn fghb-has (text needle) (ge (str_find text needle 0) 0))
    (defn fghb-prefix (text i) (if (eq i 9000) 1
        (if (eq (str_byte_at text i) 65) (fghb-prefix text (add i 1)) 0)))
    (defn fghb-guarded (path) (fghb-has (read_file path) "; preflight-exec: forbidden"))
    (defn fghb-row (id value unit) (fgo-int "host" id id value unit 0 "cpu" "physical-live" "fixture" "live" "health" "fixture"))
    (let stream (host_capture (list "./fkwu" "form/form-stdlib/tests/fixtures/file-append-stream.fk")))
    (let disk (fghb-row "disk-mbps" 907 "centi-MB/s"))
    (let silent (fgo-row-with-truth disk "silent" "silent"))
    (let cpu (fghb-row "model-owner-cpu" 12000 "microseconds"))
    (let rss (fghb-row "model-owner-rss" 1024 "bytes"))
    (let a (fgoc-organ "a" 1 "fixture" "observed" "" 1))
    (let b (fgoc-organ "b" 1 "fixture" "observed" "" 1))
    (let census (fgoc-census (list "a" "b")))
    (let doing (ftc-text-as-string (ftc-segment-text (head (fglat-doing-line (list disk) (list) 1000 80)))))
    (let owner (fgl-owner-process-rows-present (fgo-ps-process 123 1024 12000 10) 19))
    (fghb-fold (list
        (and (fghb-prefix stream 0) (str_eq (substring stream 9000 9003) "BBB"))
        (fghb-has stream "[9000, 3, 0]")
        (eq (file_append_bytes "." (list 65)) -1)
        (str_eq (fglat-disk-rate-text disk (list)) "9.07MB/s")
        ; a silent gauge names the DOOR that owes the reading, not a bare "?";
        ; this asserted the bare mark and stood red from cc876f0a until 2026-09-07,
        ; so it is written against fglat-door now and cannot go stale on its wording
        (str_eq (fglat-disk-rate-text silent (list)) (fglat-door "host"))
        (and (eq (fglat-metric-live? silent) 1) (eq (fglat-metric-current? silent) 0))
        (str_eq (fglat-cpu-text cpu) "12ms-total")
        (str_eq (fglat-cpu-text (fghb-row "cpu" 123 "tenths-percent")) "12.3%")
        (fghb-has (fglat-owner-doing-text (list rss)) "cpu=?")
        (fghb-has doing "DOING dsk=9.07MB/s")
        (str_eq (fgo-unit (nth owner 2)) "microseconds")
        (eq (fgoc-all-held? census (list a b) (list)) 1)
        (eq (fgoc-coverage-complete? census (list b a)) 1)
        (eq (fgoc-all-held? (fgoc-census (list "a" "x")) (list a b) (list)) 0)
        (eq (fgoc-coverage-complete? census (list a a)) 0)
        (fghb-guarded "observe/form-glass-run.fk")
        (fghb-guarded "observe/form-glass-machine-live.fk")
        (fghb-guarded "observe/form-glass-organs-live.fk")) 1))
