; frame-read-dynamic-band.fk — Form-owned file interpretation witness.
; It opens no camera. Run from an isolated working directory containing a
; `form` symlink; the fixed compatibility filename then belongs to that run.
; Expected: 127
; preflight-exec: forbidden
; preludes: form-stdlib/bml/frame-luma.bml form-stdlib/form-fs.fk form-stdlib/tests/frame-luma-fixture.fk

(do
    (defn frdb-bit (ok bit) (if ok bit 0))
    (defn frdb-path () "fkwu-cam-frame.bmp")

    (fs-remove-file (frdb-path))
    (let large-bytes 1050624)
    (let large (str_concat (flmb-header 1024 342 large-bytes 0) (flmb-repeat (flmb-b 120) large-bytes "")))
    (let wrote-large (write_file (frdb-path) large))
    (let large-mean (flm-mean-file (frdb-path) (flm-default-policy)))

    (let top (str_concat (flmb-header 6 -1 20 0) (flmb-six-pixels)))
    (let wrote-top (write_file (frdb-path) top))
    (let top-mean (flm-mean-file (frdb-path) (flm-default-policy)))

    (let wrote-huge (write_file (frdb-path) (flmb-header 2147483647 2147483647 0 0)))
    (let huge-result (flm-mean-file (frdb-path) (flm-default-policy)))
    (let wrote-short (write_file (frdb-path) (substring top 0 60)))
    (let short-result (flm-mean-file (frdb-path) (flm-default-policy)))
    (fs-remove-file (frdb-path))

    (sum (list
        (frdb-bit (eq wrote-large (add 54 large-bytes)) 1)
        (frdb-bit (eq large-mean 120) 2)
        (frdb-bit (eq wrote-top 74) 4)
        (frdb-bit (eq top-mean 111) 8)
        (frdb-bit (and (eq wrote-huge 54) (eq huge-result -1)) 16)
        (frdb-bit (and (eq wrote-short 60) (eq short-result -1)) 32)
        (frdb-bit (eq (fs-exists? (frdb-path)) 0) 64))))
