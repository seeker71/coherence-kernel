; frame-read-dynamic-band.fk — file-only compatibility witness for tag 213.
; It opens no camera. Run from an isolated working directory containing a
; `form` symlink; the fixed compatibility filename then belongs to that run.
; Expected: 127
; preflight-exec: forbidden
; preludes: form-stdlib/bml/frame-luma.bml form-stdlib/form-fs.fk

(do
    (defn frdb-bit (ok bit) (if ok bit 0))
    (defn frdb-b (n) (byte_to_str (mod (if (lt n 0) (add n 4294967296) n) 256)))
    (defn frdb-u16 (n) (str_concat (frdb-b n) (frdb-b (div n 256))))
    (defn frdb-u32 (n)
        (do (let u (if (lt n 0) (add n 4294967296) n))
            (str_concat (frdb-u16 (mod u 65536)) (frdb-u16 (div u 65536)))))
    (defn frdb-join (xs)
        (if (eq (len xs) 0) ""
            (if (eq (len xs) 1) (head xs)
                (str_concat (head xs) (frdb-join (tail xs))))))
    (defn frdb-header (width height data-bytes compression)
        (frdb-join (list "BM" (frdb-u32 (add 54 data-bytes)) (frdb-u32 0) (frdb-u32 54)
            (frdb-u32 40) (frdb-u32 width) (frdb-u32 height) (frdb-u16 1) (frdb-u16 24)
            (frdb-u32 compression) (frdb-u32 data-bytes) (frdb-u32 0) (frdb-u32 0)
            (frdb-u32 0) (frdb-u32 0))))
    (defn frdb-repeat (piece n acc)
        (if (le n 0) acc
            (frdb-repeat (str_concat piece piece) (div n 2)
                (if (eq (mod n 2) 1) (str_concat acc piece) acc))))
    (defn frdb-fill (byte n) (frdb-repeat (frdb-b byte) n ""))
    (defn frdb-pixel (v) (str_concat (frdb-b v) (str_concat (frdb-b v) (frdb-b v))))
    (defn frdb-small-data ()
        (frdb-join (list (frdb-pixel 10) (frdb-pixel 20) (frdb-pixel 100)
                         (frdb-pixel 120) (frdb-pixel 200) (frdb-pixel 220)
                         (frdb-b 0) (frdb-b 0))))
    (defn frdb-path () "fkwu-cam-frame.bmp")

    (fs-remove-file (frdb-path))
    (let large-bytes 1050624)
    (let large (str_concat (frdb-header 1024 342 large-bytes 0) (frdb-fill 120 large-bytes)))
    (let wrote-large (write_file (frdb-path) large))
    (let large-mean (sense_frame_read))

    (let top (str_concat (frdb-header 6 -1 20 0) (frdb-small-data)))
    (let wrote-top (write_file (frdb-path) top))
    (let top-mean (sense_frame_read))

    (let wrote-huge (write_file (frdb-path) (frdb-header 2147483647 2147483647 0 0)))
    (let huge-result (sense_frame_read))
    (let wrote-short (write_file (frdb-path) (substring top 0 60)))
    (let short-result (sense_frame_read))
    (fs-remove-file (frdb-path))

    (sum (list
        (frdb-bit (eq wrote-large (add 54 large-bytes)) 1)
        (frdb-bit (eq large-mean 120) 2)
        (frdb-bit (eq wrote-top 74) 4)
        (frdb-bit (eq top-mean 111) 8)
        (frdb-bit (and (eq wrote-huge 54) (eq huge-result -1)) 16)
        (frdb-bit (and (eq wrote-short 60) (eq short-result -1)) 32)
        (frdb-bit (eq (fs-exists? (frdb-path)) 0) 64))))
