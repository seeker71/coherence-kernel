; tests/ontology-emit-band.fk
;
; preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/form-ontology-bp.fk form-stdlib/bml/ontology-emit.bml
;
; What form-ontology.json generates is what the tree carries. Verdict 31 when
; every claim lands:
;    1  the dialect text the JSON emits equals dialect-categories.fk byte for byte
;    2  engine-constants.fk carries the engine row block the JSON emits, once
;    4  every emitted dialect name is distinct
;    8  every emitted dialect row is a row of the reviewed table in
;       form-ontology-bp.fk at the same type and inst, and that table holds no
;       dialect row the JSON lacks: no coordinate minted, none dropped
;   16  the four NATURAL-BMF rows emit at type 99, insts 760 to 763

(do
    (defn oeb-count-from (text needle from n)
        (do
            (let at (str_find text needle from))
            (if (lt at 0) n (oeb-count-from text needle (add at 1) (add n 1)))))

    (defn oeb-name-in? (name names)
        (if (nil? names)
            false
            (if (str_eq (head names) name) true (oeb-name-in? name (tail names)))))

    (defn oeb-distinct? (rows seen)
        (if (nil? rows)
            true
            (if (oeb-name-in? (nth (head rows) 0) seen)
                false
                (oeb-distinct? (tail rows) (cons (nth (head rows) 0) seen)))))

    (defn oeb-starts? (name prefix)
        (if (ge (str_len name) (str_len prefix))
            (str_eq (substring name 0 (str_len prefix)) prefix)
            false))

    (defn oeb-prefixed? (name prefixes)
        (if (nil? prefixes)
            false
            (if (oeb-starts? name (head prefixes)) true (oeb-prefixed? name (tail prefixes)))))

    ;; reviewed rows are (name pkg level type inst)
    (defn oeb-reviewed (table prefixes)
        (if (nil? table)
            (empty)
            (if (oeb-prefixed? (nth (head table) 0) prefixes)
                (cons (head table) (oeb-reviewed (tail table) prefixes))
                (oeb-reviewed (tail table) prefixes))))

    (defn oeb-find (name table)
        (if (nil? table)
            (empty)
            (if (str_eq (nth (head table) 0) name) (head table) (oeb-find name (tail table)))))

    (defn oeb-agrees? (row table)
        (do
            (let found (oeb-find (nth row 0) table))
            (if (nil? found)
                false
                (if (eq (nth found 3) (nth row 1)) (eq (nth found 4) (nth row 2)) false))))

    (defn oeb-all-agree? (rows table)
        (if (nil? rows)
            true
            (if (oeb-agrees? (head rows) table) (oeb-all-agree? (tail rows) table) false)))

    (defn oeb-row-is? (rows name ty inst)
        (do
            (let found (oeb-find name rows))
            (if (nil? found) false (if (eq (nth found 1) ty) (eq (nth found 2) inst) false))))

    (let root (oe-root))
    (let rows (oe-dialect-rows root))
    (let reviewed (oeb-reviewed (FOL-BP-BOOTSTRAP-TABLE) (oe-dialect-prefixes root)))
    (let block (oe-engine-block root))

    (sum
        (list
            (if (str_eq (oe-dialect-text root) (read_file (oe-dialect-path))) 1 0)
            (if (eq (oeb-count-from (read_file (oe-engine-path)) block 0 0) 1) 2 0)
            (if (oeb-distinct? rows (empty)) 4 0)
            (if (oeb-all-agree? rows reviewed) (if (eq (len reviewed) (len rows)) 8 0) 0)
            (if (oeb-row-is? rows "NATURAL-BMF-FACT" 99 760)
                (if (oeb-row-is? rows "NATURAL-BMF-RELATION" 99 761)
                    (if (oeb-row-is? rows "NATURAL-BMF-QUESTION" 99 762)
                        (if (oeb-row-is? rows "NATURAL-BMF-MEANING" 99 763) 16 0)
                        0)
                    0)
                0))))
