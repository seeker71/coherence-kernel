; living-world-concept-field-band.fk -- two learned lenses form one living path.
; Verdict 16383 proves fourteen discovery, composition, consent, and reopening properties.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/tests/living-world-concept-witness.fk

(do
    (let base (lwcxw-base-round))
    (let first-proposal (lwcxw-first-proposal base))
    (let second-proposal (lwcxw-second-proposal base))
    (let first-candidate (lwt-proposal-candidate first-proposal))
    (let second-candidate (lwt-proposal-candidate second-proposal))
    (let first-integrated
        (lwt-integrate (lwcxw-first-yes-round base first-proposal)
                       first-proposal (lwcxw-action)))
    (let second-round
        (lwt-round (lwt-round-world first-integrated)
            (lwo-field-add (lwo-empty-field) second-proposal)
            (lwo-empty-field) first-integrated))
    (let second-integrated
        (lwt-integrate
            (lwcxw-second-yes-round second-round second-proposal)
            second-proposal (lwcxw-action)))
    (let mapping-world (lwt-round-world second-integrated))

    (let chain-proposals (lwcx-chain-proposals mapping-world))
    (let chain-proposal (head (lwo-field-items chain-proposals)))
    (let chain-candidate (lwt-proposal-candidate chain-proposal))
    (let chain (lwo-emergent-shape chain-candidate))
    (let chain-round
        (lwt-round mapping-world chain-proposals
            (lwo-empty-field) second-integrated))
    (let chain-yes
        (lwcxw-chain-yes-round chain-round chain-proposal))
    (let chain-integrated
        (lwcx-integrate-chain chain-yes chain-proposal (lwcxw-action)))
    (let chain-world (lwt-round-world chain-integrated))

    (let input-world (lwcxw-input-world chain-world))
    (let application-round
        (lwcx-application-round input-world chain-candidate
                                (lwcxw-unseen-input) chain-integrated))
    (let application-proposal
        (head (lwo-field-items (lwt-round-proposals application-round))))
    (let application-candidate
        (lwt-proposal-candidate application-proposal))
    (let application (lwo-emergent-shape application-candidate))
    (let derivation (lwcx-application-derivation application))
    (let application-yes
        (lwcxw-application-yes-round
            application-round application-proposal))
    (let successful
        (lwcx-integrate-application
            application-yes application-proposal (lwcxw-action)))
    (let successful-world (lwt-round-world successful))

    ; The same fully acknowledged application is denied on a sibling branch
    ; when fresh experience reopens either component before integration.
    (let first-signature (lwcx-chain-first-signature chain))
    (let stale-round
        (lwt-round-receive application-yes
            (list (lwcxw-entry (lwcxw-source-e)
                (lwcxw-confirming-experience first-signature)
                (lwcxw-provenance-e)))))
    (let stale-world (lwt-round-world stale-round))
    (let stale-integration
        (lwcx-integrate-application
            stale-round application-proposal (lwcxw-action)))

    (let c1 (if (eq (lwo-field-size
                         (lwt-round-proposals base)) 2) 1 0))
    (let c2 (if (and (eq (lwrl-steady? mapping-world first-candidate) 1)
                         (eq (lwrl-steady? mapping-world second-candidate) 1)) 2 0))
    (let c3 (if (eq (lwo-field-size chain-proposals) 1) 4 0))
    (let c4 (if (and (node_eq (lwcx-chain-bridge-skeleton chain)
                               (lwrr-signature-target-skeleton
                                   (lwcx-chain-first-signature chain)))
                         (node_eq (lwcx-chain-path chain)
                                  (lwo-local-path))) 8 0))
    (let c5 (if (and (eq (lwo-field-size
                              (lwt-proposal-participants chain-proposal)) 4)
                         (eq (lwo-field-size
                              (lwo-emergent-witnesses chain-candidate)) 4)) 16 0))
    (let c6 (if (eq (lwo-world-has?
                         mapping-world chain-candidate) 0) 32 0))
    (let c7 (if (and (eq (lwo-active? chain-world chain-candidate) 1)
                         (eq (lwo-field-size
                              (lwo-active-attributions-for
                                  chain-world chain-candidate)) 4)) 64 0))
    (let c8 (if (eq (lwo-active?
                         input-world (lwcxw-unseen-input)) 1) 128 0))
    (let c9 (if (node_eq (lwcx-derivation-bridge derivation)
                          (lwcxw-expected-bridge)) 256 0))
    (let c10 (if (and (node_eq (lwcx-derivation-output derivation)
                                (lwcxw-expected-output))
                          (node_eq (lwcx-derivation-path derivation)
                                   (lwo-local-path))) 512 0))
    (let c11 (if (and (eq (lwo-field-size
                               (lwt-proposal-participants
                                   application-proposal)) 5)
                          (eq (lwo-field-size
                               (lwo-emergent-witnesses
                                   application-candidate)) 5)) 1024 0))
    (let c12 (if (and (eq (lwo-active?
                               successful-world application-candidate) 1)
                          (eq (lwo-field-size
                               (lwo-active-attributions-for
                                   successful-world application-candidate)) 5)) 2048 0))
    (let c13 (if (and (eq (lwrl-steady? stale-world first-candidate) 0)
                          (eq (lwcx-chain-steady?
                               stale-world chain-candidate) 0)) 4096 0))
    (let c14 (if (and (eq (lwo-world-has?
                               (lwt-round-world stale-integration)
                               application-candidate) 0)
                          (eq (lwo-active?
                               successful-world application-candidate) 1)) 8192 0))
    (lwcxw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14)))
