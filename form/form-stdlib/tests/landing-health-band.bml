; landing-health-band.bml — a landing that landed reads as landed, not as a surprise (form-cli-landing.bml, ld-health).
;
; ld-health speaks the landing's organ-health reading: expected "landed", observed what the landing saw. A landing that
; landed has no reason (its state's reason is empty), so its reading observes "landed", carries no surprise and names no
; need; a held landing observes its reason.
;
; Expected: 7
; Verdict 7 when every claim lands:
;   1   a landed landing observes "landed" and reads no surprise
;   2   a held landing observes its reason
;   4   a landed landing names no need
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/form-cli-landing.bml
section [form.bml] {
 class LandingHealthBand {
  def lhb-c-landed(ctx) {
   let r = ld-health("a movement", "", true);
   (String) fhn-text(r, "observed") == "landed" && fhn-count(r, "surprise") == 0;
  }
  def lhb-c-held(ctx) {
   let r = ld-health("a movement", "a-gate-refused", false);
   (String) fhn-text(r, "observed") == "a-gate-refused";
  }
  def lhb-c-needless(ctx) {
   let r = ld-health("a movement", "", true);
   nil?(json-array-elements(json-object-get(r, "needs")));
  }
 }
 live-claims("landing-health-band", 0, [["landed", 1, 1, lhb-c-landed], ["held", 2, 1, lhb-c-held], ["needless", 4, 1, lhb-c-needless]]);
}
