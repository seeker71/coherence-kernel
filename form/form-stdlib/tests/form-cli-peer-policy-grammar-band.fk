; form-cli-peer-policy-grammar-band.fk -- the raw policy image grammar is
; scannerless and four-way independent of the host JIT page. Expected: 63.
;
; The companion route band owns `jit_leaf_inram` as a fkwu-only carrier proof.
; This band proves the image grammar itself: exact bytes become rows, malformed
; syntax becomes `nothing`, and the NodeID is recomputed locally.
;
; preludes: form-stdlib/form-cli-peer-policy-route.fk

(do
    (defn fcpgb-bit (held weight) (if held weight 0))
    (defn fcpgb-image (symbol root program tail)
        (str_concat (fcpr-open)
        (str_concat "symbol="
        (str_concat symbol
        (str_concat "\nroot="
        (str_concat (int_to_str root)
        (str_concat "\nprogram="
        (str_concat program
        (str_concat (fcpr-close) tail)))))))))
    (defn fcpgb-host ()
        (fcrt-host-from-shared
            (fcrt-shared "" "" (empty) (empty) 256 8 (jonb-registry 1))
            0 1 (fcrt-unbound-route)))

    (defn form-cli-peer-policy-grammar-band ()
        (do
            (let image (fcpgb-image "policy/identity" 0 "2" ""))
            (let parsed (fcpr-parse image))
            (let c0 (fcpgb-bit (and (not (nothing? parsed))
                (and (str_eq (nth parsed 0) "policy/identity")
                     (and (eq (nth parsed 1) 0)
                          (and (eq (len (nth parsed 2)) 1)
                               (eq (head (head (nth parsed 2))) 2))))) 1))
            (let c1 (fcpgb-bit (nothing?
                (fcpr-parse (fcpgb-image "policy/bad-row" 0 "1,1;" ""))) 2))
            (let c2 (fcpgb-bit (nothing?
                (fcpr-parse (fcpgb-image "policy/bad-root" 1 "2" ""))) 4))
            (let c3 (fcpgb-bit (nothing?
                (fcpr-parse (fcpgb-image "policy/trailing" 0 "2" "x"))) 8))
            (let route (fcpr-route-from-text (fcpgb-host) image))
            (let expected (jonb-identity (list (list 2)) 0 1))
            (let c4 (fcpgb-bit (and (not (nothing? route))
                (and (node_eq (fcrt-route-identity route) expected)
                     (not (node_eq (fcrt-route-identity route)
                         (make_nodeid 9 9 9 9))))) 16))
            (let c5 (fcpgb-bit (and
                (str_eq (fcpr-action-name 1) "model")
                (and (str_eq (fcpr-action-name 2) "source-knowledge")
                     (and (str_eq (fcpr-action-name 3) "repo-patch")
                          (nothing? (fcpr-action-name 0))))) 32))
            (sum (list c0 c1 c2 c3 c4 c5))))

    (form-cli-peer-policy-grammar-band))
