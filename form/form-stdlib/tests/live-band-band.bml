; Verdict 15 when a live band holds what it claims:
;   1   a claim that holds at its first reading
;   2   a claim that fails, and holds after the repair that gives it the context it needs
;   4   a claim whose first repair acts without helping and whose second cannot act, and whose third
;       makes it hold: the walk carries both findings forward
;   8   a claim that stops (a stop is an observation, not an exit), and holds after a repair
;   16  a claim no repair makes hold stays out of the verdict, so the verdict is 15, not 31
; Every observation and every applied repair is spoken on stderr as an organ-health reading.
// preludes: form-stdlib/bml/live-band.bml
section [form.bml] {
 class LiveBandBand {
  def lbb-ctx(n) = list("ctx", n);
  def lbb-n(ctx) = nth(ctx, 1);
  def lbb-holds(ctx) = 42;
  def lbb-needs-one(ctx) = if (lbb-n(ctx) == 1) then 42 else 0;
  def lbb-needs-two(ctx) = if (lbb-n(ctx) == 2) then 42 else 0;
  def lbb-stops-until-one(ctx) = if (lbb-n(ctx) == 1) then 42 else len(nothing());
  def lbb-never(ctx) = 7;
  def lbb-to-one(ctx) = if (lbb-n(ctx) == 0) then lbb-ctx(1) else nothing();
  def lbb-cannot(ctx) = nothing();
  def lbb-to-two(ctx) = lbb-ctx(2);
 }
 lb-run("live-band-band", lbb-ctx(0),
  list(lb-claim("holds", 1, 42, lbb-holds),
   lb-claim("needs-one", 2, 42, lbb-needs-one),
   lb-claim("needs-two", 4, 42, lbb-needs-two),
   lb-claim("stops-until-one", 8, 42, lbb-stops-until-one),
   lb-claim("never", 16, 42, lbb-never)),
  list(lb-repair("to-one", lbb-to-one), lb-repair("cannot", lbb-cannot), lb-repair("to-two", lbb-to-two)));
}
