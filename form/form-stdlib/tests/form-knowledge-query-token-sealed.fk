; form-knowledge-query-token-sealed.fk — frozen stream-envelope cases for
; Form-native knowledge lookup requests emitted by a local model.
;
; This table is DATA only.  The parser may not read it at runtime.  Positive
; cases are whole envelopes; negative cases cover ordinary prose, quotation,
; incompleteness, trailing bytes, nesting, and an empty query.  The split keeps
; parser calibration separate from adversarial holdout.
;
; A case is: (id split surface expected-ready expected-reason expected-query).
; witnessed: 2026-08-24 -> sealed before form-knowledge-query-token.fk

(do
    (defn fkqts-case (id split surface ready reason query)
        (list id split surface ready reason query))
    (defn fkqts-id (c) (nth c 0))
    (defn fkqts-split (c) (nth c 1))
    (defn fkqts-surface (c) (nth c 2))
    (defn fkqts-ready (c) (nth c 3))
    (defn fkqts-reason (c) (nth c 4))
    (defn fkqts-query (c) (nth c 5))

    (defn fkqts-cases ()
        (list
            (fkqts-case "c01" "cal"
                "<|form:knowledge-query|>what is a Form cell?<|/form:knowledge-query|>"
                1 "ready" "what is a Form cell?")
            (fkqts-case "c02" "cal"
                "<|form:knowledge-query|>NodeID source attribution<|/form:knowledge-query|>"
                1 "ready" "NodeID source attribution")
            (fkqts-case "c03" "cal" "ordinary answer text" 0 "no-query-token" "")
            (fkqts-case "c04" "cal"
                "<|form:knowledge-query|>unfinished request"
                0 "held-incomplete" "")
            (fkqts-case "h01" "holdout"
                "<|form:knowledge-query|>how does nothing differ from miss?<|/form:knowledge-query|>"
                1 "ready" "how does nothing differ from miss?")
            (fkqts-case "h02" "holdout"
                "please quote <|form:knowledge-query|>not an executable envelope<|/form:knowledge-query|>"
                0 "no-query-token" "")
            (fkqts-case "h03" "holdout"
                "<|form:knowledge-query|>valid body<|/form:knowledge-query|> trailing"
                0 "trailing-bytes" "")
            (fkqts-case "h04" "holdout"
                "<|form:knowledge-query|>outer <|form:knowledge-query|>inner<|/form:knowledge-query|>"
                0 "nested-query-token" "")
            (fkqts-case "h05" "holdout"
                "<|form:knowledge-query|><|/form:knowledge-query|>"
                0 "empty-query" "")))

    0)
