; preludes: form-stdlib/bml/text-diff.bml
;
; text-diff-band — the body reads the changed region between two texts itself (form-stdlib/bml/text-diff.bml).
;
; Verdict 63 when every claim lands:
;   1   two equal texts answer ""
;   2   one changed line in the middle: header @@ -2,1 +2,1 @@, then -b and +B
;   4   one inserted line: @@ -3,0 +3,1 @@ carrying +x
;   8   one removed line: @@ -2,1 +2,0 @@ carrying -b
;   16  context: with context 1 the unchanged neighbours appear as " a" and " c"
;   32  cap: a hunk longer than the cap is cut to exactly the cap
(do
    (defn tdb-bit (ok v) (if (eq ok 1) v 0))
    (defn tdb-has (s part) (if (ge (str_find s part 0) 0) 1 0))
    (let same (td-diff "a\nb\nc\n" "a\nb\nc\n" 1 400))
    (let changed (td-diff "a\nb\nc\n" "a\nB\nc\n" 0 400))
    (let inserted (td-diff "a\nb\nc\n" "a\nb\nx\nc\n" 0 400))
    (let removed (td-diff "a\nb\nc\n" "a\nc\n" 0 400))
    (let near (td-diff "a\nb\nc\n" "a\nB\nc\n" 1 400))
    (let cut (td-diff "a\nb\nc\n" "a\nB\nc\n" 1 10))
    (let b1 (if (str_eq same "") 1 0))
    (let b2 (if (and (eq (tdb-has changed "@@ -2,1 +2,1 @@") 1) (and (eq (tdb-has changed "\n-b\n") 1) (eq (tdb-has changed "\n+B\n") 1))) 1 0))
    (let b3 (if (and (eq (tdb-has inserted "@@ -3,0 +3,1 @@") 1) (eq (tdb-has inserted "\n+x\n") 1)) 1 0))
    (let b4 (if (and (eq (tdb-has removed "@@ -2,1 +2,0 @@") 1) (eq (tdb-has removed "\n-b\n") 1)) 1 0))
    (let b5 (if (and (eq (tdb-has near "\n a\n") 1) (eq (tdb-has near "\n c\n") 1)) 1 0))
    (let b6 (if (eq (str_len cut) 10) 1 0))
    (add (tdb-bit b1 1) (add (tdb-bit b2 2) (add (tdb-bit b3 4) (add (tdb-bit b4 8) (add (tdb-bit b5 16) (tdb-bit b6 32)))))))
