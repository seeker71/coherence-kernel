; str-to-int-reading-band.bml — one reading of an integer's text, four-way.
;
; preludes: form-stdlib/core.fk
;
; core.fk's str_to_int gives fkwu its reading, and Go, Rust and TS carry the same reading as a native:
; leading space, tab, LF and CR are skipped, one leading "-" negates, and the digits run to the first
; non-digit. Text with no digits reads 0.
;
; Verdict 127 when every claim lands:
;   1     digits read as written, and one leading "-" negates
;   2     leading space, tab, LF and CR are skipped
;   4     the digits stop at the first non-digit: a trailing newline, a trailing word
;   8     text with no digits reads 0: "", "-", "abc", "+5"
;   16    one "-" only: "--5" and "- 5" read 0
;   32    past 2^53 every digit counts: 9007199254740993 and -9007199254740993 read back as written
;   64    the read integers stay exact in arithmetic, and 21 digits led by zeros read 42
section [form.bml] {
    class StrToIntReadingBand {
        def stirb-bit(ok, bit) = if ok then bit else 0;
        def stirb-reads(text, n) = eq(str_to_int(text), n);
        def stirb-text(text) = str_eq(int_to_str(str_to_int(text)), text);
        def stirb-space() = str_concat(" ", str_concat(byte_to_str(9), str_concat(byte_to_str(10), byte_to_str(13))));
        def stirb-score() = add(
            stirb-bit(and(stirb-reads("42", 42), stirb-reads("-7", sub(0, 7))), 1),
            add(stirb-bit(and(stirb-reads(str_concat(stirb-space(), "42"), 42), stirb-reads(str_concat(stirb-space(), "-3"), sub(0, 3))), 2),
            add(stirb-bit(and(stirb-reads(str_concat("42", byte_to_str(10)), 42), stirb-reads("12abc", 12)), 4),
            add(stirb-bit(and(and(stirb-reads("", 0), stirb-reads("-", 0)), and(stirb-reads("abc", 0), stirb-reads("+5", 0))), 8),
            add(stirb-bit(and(stirb-reads("--5", 0), stirb-reads("- 5", 0)), 16),
            add(stirb-bit(and(stirb-text("9007199254740993"), stirb-text("-9007199254740993")), 32),
                stirb-bit(and(eq(sub(str_to_int("9007199254740993"), str_to_int("9007199254740992")), 1), stirb-reads("000000000000000000042", 42)), 64)))))));
    }
    stirb-score();
}
