; form-terminal-canvas-band.fk — executable proof for the reusable canvas.
;
; preludes: form-stdlib/core.fk form-stdlib/form-terminal-canvas.bml
; Verdict 524287: canvas data, composition, clipping, semantic styles,
; deterministic diff, ANSI projection, capabilities, BML authority, and
; byte-native full/delta projections exactly matching the legacy text bytes.

(do
    (defn ftcb-bit (held weight) (if (eq held 1) weight 0))
    (defn ftcb-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))
    (defn ftcb-byte-lists-equal? (left right)
        (if (not (eq (len left) (len right)))
            0
            (if (eq (len left) 0)
                1
                (if (not (eq (head left) (head right)))
                    0
                    (ftcb-byte-lists-equal? (tail left) (tail right))))))

    (let neutral (ftc-style "neutral" 180 180 180 -1 -1 -1 48 0 "·"))
    (let blue (ftc-style "blueprint" 80 150 255 -1 -1 -1 255 1 "◇"))
    (let hot (ftc-style "recipe-heat" 255 130 40 20 5 0 220 0 "◆"))
    (let base (ftc-canvas 6 2 neutral))
    (let texted (ftc-put-text base 1 0 "FORM" blue))
    (let clipped (ftc-clip texted 2 0 3 1))
    (let left (ftc-put-text (ftc-canvas 2 1 neutral) 0 0 "AB" blue))
    (let right (ftc-put-text (ftc-canvas 2 1 neutral) 0 0 "CD" hot))
    (let horizontal (ftc-hcompose left right))
    (let vertical (ftc-vcompose left right))
    (let bar (ftc-bar 5 3 5 hot neutral))
    (let spark (ftc-spark (list 0 3 7) hot))
    (let heat (ftc-heat (list 40 160 255) hot))
    (let changed (ftc-put-glyph texted 5 1 "X" hot))
    (let changes (ftc-diff texted changed))
    (let caps (ftc-terminal-fallback 80 24))
    (let surface (ftc-surface horizontal caps (list "memory" "health")))
    (let ansi (ftc-ansi-project surface))
    (let patch (ftc-ansi-diff changes))
    (let split (ftc-measured-split 120 20 3 (ftc-measure 40 70) (ftc-measure 30 60)))
    (let segmentLines (list
        (list (ftc-segment "FORM" blue "focus" "node.form" (list "memory") "fixture")
              (ftc-segment " 42" hot "none" "node.value" (list "health") "fixture"))
        (list (ftc-segment "ready" neutral "none" "node.ready" (list "model") "fixture"))))
    (let changedSegmentLines (list
        (head segmentLines)
        (list (ftc-segment "active" hot "none" "node.ready" (list "model") "fixture"))))
    (let legacyFrame (ftc-cat (list (ftc-terminal-home) (ftc-ansi-segment-lines segmentLines) (ftc-terminal-erase-rest))))
    (let legacyDelta (ftc-segment-lines-diff segmentLines changedSegmentLines))
    (let authority (read_file "form/form-stdlib/bml/form-terminal-canvas.bml"))

    (let b0 (ftcb-bit (and (eq (ftc-width base) 6)
                            (and (eq (ftc-height base) 2)
                                 (eq (len (ftc-rows base)) 2))) 1))
    (let b1 (ftcb-bit (and (str_eq (ftc-cell-glyph (ftc-cell-at texted 1 0)) "F")
                            (str_eq (ftc-style-concept (ftc-cell-style (ftc-cell-at texted 1 0))) "blueprint")) 2))
    (let b2 (ftcb-bit (and (eq (ftc-width clipped) 3)
                            (str_eq (ftc-cell-glyph (ftc-cell-at clipped 0 0)) "O")) 4))
    (let b3 (ftcb-bit (and (eq (ftc-width horizontal) 4)
                            (and (str_eq (ftc-cell-glyph (ftc-cell-at horizontal 2 0)) "C")
                                 (eq (ftc-height horizontal) 1))) 8))
    (let b4 (ftcb-bit (and (eq (ftc-width vertical) 2)
                            (and (eq (ftc-height vertical) 2)
                                 (str_eq (ftc-cell-glyph (ftc-cell-at vertical 0 1)) "C"))) 16))
    (let b5 (ftcb-bit (and (str_eq (ftc-cell-glyph (ftc-cell-at bar 2 0)) "█")
                            (str_eq (ftc-cell-glyph (ftc-cell-at bar 4 0)) "░")) 32))
    (let b6 (ftcb-bit (and (eq (ftc-width spark) 3)
                            (str_eq (ftc-cell-glyph (ftc-cell-at spark 2 0)) "█")) 64))
    (let b7 (ftcb-bit (and (eq (ftc-style-alpha (ftc-cell-style (ftc-cell-at heat 0 0))) 40)
                            (eq (ftc-style-alpha (ftc-cell-style (ftc-cell-at heat 2 0))) 255)) 128))
    (let b8 (ftcb-bit (and (eq (len changes) 1)
                            (and (eq (nth (head changes) 1) 5)
                                 (eq (nth (head changes) 2) 1))) 256))
    (let b9 (ftcb-bit (and (str_eq (nth caps 3) "caller-fallback-unobserved")
                            (and (str_eq (nth caps 5) "alpha-dim-projection")
                                 (str_eq (nth caps 6) "line-input-only"))) 512))
    (let b10 (ftcb-bit (and (str_eq (head surface) "ftc-surface")
                             (and (eq (ftc-width (ftc-surface-canvas surface)) 4)
                                  (eq (len (ftc-surface-channels surface)) 2))) 1024))
    (let b11 (ftcb-bit (and (eq (ftcb-has ansi "38;2;80;150;255") 1)
                             (eq (ftcb-has ansi "FORM") 0)) 2048))
    (let b12 (ftcb-bit (and (eq (ftcb-has patch "[2;6H") 1)
                             (eq (ftcb-has patch "X") 1)) 4096))
    (let b13 (ftcb-bit (and (eq (ftcb-has (ftc-terminal-open) (tg-alt-screen-on)) 1)
                             (eq (ftcb-has (ftc-terminal-close) (tg-alt-screen-off)) 1)) 8192))
    (let b14 (ftcb-bit (and (eq (ftcb-has authority "const String SizeSeam") 1)
                             (and (eq (ftcb-has authority "const String InputSeam") 1)
                                  (eq (ftcb-has authority "const String WidthSeam") 1))) 16384))
    (let b15 (ftcb-bit (and (eq (ftcb-has authority "surface-neutral") 1)
                             (eq (ftcb-has authority "ANSI true-colour is one projection") 1)) 32768))
    (let b16 (ftcb-bit (and (eq (len split) 2)
                             (and (eq (add (ftc-region-width (head split)) (add 3 (ftc-region-width (nth split 1)))) 120)
                                  (eq (ftc-region-x (nth split 1)) (add (ftc-region-width (head split)) 3)))) 65536))
    (let b17 (ftcb-bit (ftcb-byte-lists-equal? (ftcb-full-frame segmentLines) (ftcb-text legacyFrame)) 131072))
    (let b18 (ftcb-bit (ftcb-byte-lists-equal? (ftcb-segment-lines-diff segmentLines changedSegmentLines) (ftcb-text legacyDelta)) 262144))
    (sum (list b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 b16 b17 b18)))
