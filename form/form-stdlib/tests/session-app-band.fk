; preludes: form-stdlib/core.fk form-stdlib/session-evidence.fk form-stdlib/session-app.fk
;
; session-app-band — the room stays open while every observed interruption
; returns a next movement and every original recording stays named.
; Verdict: 65535.
(do
    (defn sab-score (yes bit) (if yes bit 0))
    (defn session-app-band ()
        (do
            (let row (sa-row 0 600 "book." "Book." "Urs" 1))
            (let unknown (sa-row 600 1200 "hello" "hello" "guess" 0))
            (let escaped (sa-html "<script> & 'them'"))
            (let interrupted (sa-attention "recording-interrupted"))
            (let save (sa-attention "transcript-save"))
            (sum (list
                (sab-score (eq (sa-move? "new" "receiving") 1) 1)
                (sab-score (eq (sa-move? "new" "ready") 0) 2)
                (sab-score (and (eq (sa-move? "receiving" "attention") 1)
                                (eq (sa-move? "attention" "receiving") 1)) 4)
                (sab-score (and (eq (sa-move? "listening" "ready") 1)
                                (eq (sa-move? "ready" "listening") 1)) 8)
                (sab-score (and (eq (sa-att-kept? interrupted) 1)
                                (gt (str_len (sa-att-next interrupted)) 0)) 16)
                (sab-score (and (eq (sa-att-kept? save) 1)
                                (gt (str_len (sa-att-message save)) 0)) 32)
                (sab-score (and (eq (sa-session-id? "20260817-123456") 1)
                                (eq (sa-session-id? "../private") 0)) 64)
                (sab-score (and (str_eq (sa-row-speaker row) "Urs")
                                (str_eq (sa-row-speaker unknown) "Unknown speaker")) 128)
                (sab-score (and (eq (sa-row-edited? row) 1)
                                (eq (sa-row-edited? unknown) 0)) 256)
                (sab-score (and (eq (sa-row-sane? row) 1)
                                (eq (sa-row-sane? (sa-row 5 5 "x" "x" "" 0)) 0)) 512)
                (sab-score (str_eq escaped "&lt;script&gt; &amp; &#39;them&#39;") 1024)
                (sab-score (str_eq (sa-url-decode "A+room%2C+together") "A room, together") 2048)
                (sab-score (str_eq (sa-source-link "20260817-1" 1250)
                                   "session:20260817-1#t=1250") 4096)
                (sab-score (and (eq (ses-consent? 1) 1)
                                (eq (ses-consent? 0) 0)) 8192)
                (sab-score (and (eq (ses-known-labels-reviewed? 2 2) 1)
                                (eq (ses-known-labels-reviewed? 2 1) 0)) 16384)
                (sab-score (and (str_eq (sa-att-code (sa-attention "speech-returned-nothing"))
                                            "speech-returned-nothing")
                                (eq (sa-att-kept? (sa-attention "session-unknown")) 0)) 32768)))))
    (session-app-band))
