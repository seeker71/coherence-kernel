   len(layers) == 43 && layers[0] == touched && layers[0] == 3018191320 && layers[1] == 1959129560 && layers[2] == 1975917016 && layers[42] == 1972815320 && dvr-layer-touched(m, 2) == layers[2] && dvr-layer-touched(m, 0) == dvr-layer-dense(m, 0) + dls-layer-stacks(m, 0)
    && dvr-max(layers) == layers[0] && dvr-min(layers) == layers[1] && dvr-index-of(layers, dvr-max(layers), 0) == 0 && dvr-index-of(layers, dvr-min(layers), 0) == 1 && dvr-sum(layers) == 85700536136
    && dvr-ask-reason(empty, dvr-max(layers)) == "" && dvr-ask-reason(empty, dvr-sum(layers)) == "ask-denied:wired-cap" && dvr-sum(layers) > mg-wired-cap-of(dvb-gib(128))
    && dvr-index-of([5, 7, 9], 9, 0) == 2 && dvr-index-of([5, 7, 9], 4, 0) == 0 - 1
