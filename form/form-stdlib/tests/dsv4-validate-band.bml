  // the gap list reads the layout's one table of the types each role may carry: EMPTY on the IQ2XXS header (its Q8_0 dense and output tensors and Q2_K down stacks are run since driver stage 4), on the reap25
  // header, on both fixtures; and a header with a type outside the table reads one line a tensor type (the doctored fixture: a Q8_0 projection retyped F16, the Q8_0 output retyped F16, one Q2_K stack retyped MXFP8
  // and a router retyped F32), the head's among them
  def dvb-gaps(iq2, reap, fixture, doctored) {
   let g = dvr-gaps(iq2);
   let d = dvr-gaps(doctored);
   let said = print_str("  gaps " ++ len(g).str() ++ " on the IQ2XXS header, " ++ len(dvr-gaps(reap)).str() ++ " on reap25, " ++ len(dvr-gaps(fixture)).str() ++ " on the fixture, " ++ len(d).str() ++ " on the doctored one: " ++ flp-join(d, "; "));
   len(g) == 0 && len(dvr-gaps(reap)) == 0 && len(dvr-gaps(fixture)) == 0 && len(dvr-dense-leaves()) == 8 && len(dvr-head-gaps(iq2)) == 0 && len(dvr-head-gaps(reap)) == 0 && len(dvr-notes(iq2)) == 1 && len(dvr-notes(reap)) == 0
    && len(d) == 4 && dvb-has?(d[0], "output.weight type 1 (the driver reads MXFP8 (41) or Q8_0 (8))") && dvb-has?(d[1], "attn_q_a.weight type 1") && dvb-has?(d[2], "ffn_down_exps.weight type 41") && dvb-has?(d[3], "ffn_gate_inp.weight type 0") && len(dvr-head-gaps(doctored)) == 1;
  }
  def dvb-retype(specs, name, ty) = len(specs) == 0 ? [] : cons(specs[0][0] == name ? [specs[0][0], ty, specs[0][2], specs[0][3], specs[0][4], specs[0][5]] : specs[0], dvb-retype(specs[1:], name, ty));
  def dvb-doctored-specs() = dvb-retype(dvb-retype(dvb-retype(dvb-retype(dfx-v-specs(), "blk.0.attn_q_a.weight", 1), "output.weight", 1), "blk.1.ffn_down_exps.weight", 41), "blk.2.ffn_gate_inp.weight", 0);
  // ---- 512: the stream records OUR top-two margin and the recorded id's gap at each of its 24 steps -----------------------------------------------------
  def dvb-rep(n, v) = n == 0 ? [] : cons(v, dvb-rep(n - 1, v));
  def dvb-margins() = [0.5, 0.25, 0.125, 1.5, 2.0, 0.75, 0.0625, 3.0, 0.5, 0.25, 0.125, 1.5, 2.0, 0.75, 0.0625, 3.0, 0.5, 0.25, 0.125, 1.5, 2.0, 0.75, 0.0625, 3.0];
  def dvb-rgaps() = append(dvb-rep(3, 0.0), cons(0.125, dvb-rep(20, 0.0)));
