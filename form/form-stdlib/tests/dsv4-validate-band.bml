   let quiet = dvb-quiet();
   let lease = dvb-gib(33);
   let row = dvr-receipt-row("2026-10-03 03:00:00 WITA", 1790000000000, dvb-record());
   let broken = dvb-without(row, ",\"reason\":\"stage-refused\"");
   let sameRule = dvr-abort-reason(quiet, base, lease, 0) == "" && dvr-abort-reason(dvb-vm(128, 100, 4 + 34, 1), base, lease, 0) == "wired-above-lease";
   sameRule && (try !dvb-row-ok(broken) catch true) && !dvb-has?(broken, "stage-refused\",\"file");
  }
  def dvb-without(s, part) = substring(s, 0, str_find(s, part, 0)) ++ substring(s, str_find(s, part, 0) + len(part), len(s));
