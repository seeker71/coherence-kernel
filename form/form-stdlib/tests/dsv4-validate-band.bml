   let wrongTokens = dvb-row-doc(0, dvb-sys(), dvr-prompt(), 13, dvb-pin());
   let noSystem = dvb-row-doc(0, [], dvr-prompt(), 14, append([0, 128803], append(dvr-prompt(), [128804, 128821])));
   let bosNone = dvb-row-doc(0 - 1, dvb-sys(), dvr-prompt(), 14, cons(0 - 1, dvb-pin()[1:14]));
   let supplied = host-exec("echo '{\"logits_prompt_ids\":[1,2,3]}' | ./fkwu observe/dsv4-validate-run.bml 2>&1", "") ?? "";
   let said = print_str("  pinned ids " ++ dvr-ids-json(ids) ++ ", from " ++ dvr-logits-from(none) ++ ", supplied " ++ dvr-logits-from(given));
   ids == dvb-pin() && len(ids) == 14 && ids[0] == 0 && ids[6] == 128803 && ids[7:12] == dvr-prompt() && ids[12] == 128804 && ids[13] == 128821 && dvr-chat-ids-ok?(ids, row)
    && dvr-pinned-ids() == dvb-pin() && dvr-logits-ids(none) == dvb-pin() && dvr-logits-from(none) == "pinned" && dvr-logits-ids(given) == [1, 2, 3] && dvr-logits-from(given) == "supplied"
    && dvr-pinned-go(good) == dvb-pin() && dvr-pinned-go(wrongId) == [] && dvr-pinned-go(wrongCount) == [] && dvr-pinned-go(noBos) == [] && dvr-pinned-go(otherPrompt) == [] && dvr-pinned-go(wrongTokens) == []
    && dvr-pinned-go(noSystem) == [] && dvr-pinned-go(bosNone) == []
