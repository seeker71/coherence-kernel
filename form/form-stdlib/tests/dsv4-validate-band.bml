  // ---- 1024: the logits leg's default prompt ids: the pinned row, the request's own, and a row that fails its check --------------------------------------------
  def dvb-pin() = [0, 3476, 477, 260, 11502, 22896, 128803, 671, 6102, 294, 8760, 344, 128804, 128821];
  // a row of the shape the door reads: bos, user, assistant, think, the system ids, the prompt ids, prompt_tokens and the ids
  def dvb-row-doc(bos, sys, prompt, count, ids) = parse-json("opts", "{\"bos\":" ++ bos.str() ++ ",\"user\":128803,\"assistant\":128804,\"think\":128821,\"system_ids\":" ++ dvr-ids-json(sys) ++ ",\"prompt_ids\":" ++ dvr-ids-json(prompt) ++ ",\"prompt_tokens\":" ++ count.str() ++ ",\"ids\":" ++ dvr-ids-json(ids) ++ "}");
  def dvb-sys() = [3476, 477, 260, 11502, 22896];
  def dvb-pinned() {
   let none = json-node-object([]);
   let given = parse-json("opts", "{\"logits_prompt_ids\":[1,2,3]}");
   let row = dvr-logits-row();
   let ids = dvr-ints(row, "ids");
   let good = dvb-row-doc(0, dvb-sys(), dvr-prompt(), 14, dvb-pin());
   let wrongId = dvb-row-doc(0, dvb-sys(), dvr-prompt(), 14, append(dvb-pin()[0:3], cons(261, dvb-pin()[4:14])));
   let wrongCount = dvb-row-doc(0, dvb-sys(), dvr-prompt(), 14, dvb-pin()[0:13]);
   let noBos = dvb-row-doc(0 - 1, dvb-sys(), dvr-prompt(), 13, dvb-pin()[1:14]);
