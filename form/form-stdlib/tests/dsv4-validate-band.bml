    && dvr-int(json-object-get(doc, "vm_window"), "pageins", 0) == 1234 && dvr-int(json-object-get(doc, "vm_window"), "compressor_pages_stored", 0) == 1824749
    && len(json-array-elements(json-object-get(doc, "organs"))) == 3 && dvr-int(json-array-elements(json-object-get(doc, "organs"))[0], "resident", 0) == dvb-gib(49) && dvr-text(json-array-elements(json-object-get(doc, "organs"))[0], "command", "") == "./fkwu observe/form-glass-live-run.fk"
    && len(json-array-elements(json-object-get(doc, "moved"))) == 2 && dvr-int(json-array-elements(json-object-get(doc, "moved"))[0], "change", 0) == dvb-gib(44);
