    && dvb-has?(supplied, "logits leg: will run on the 3 prompt ids supplied [1,2,3], ask 18.1 GiB (19478347776 B)") && !dvb-has?(supplied, "pinned beside the recording") && !dvb-has?(supplied, "WAITS");
  }

  // ---- 2048: the organs of ours are named, not subtracted ------------------------------------------------------------------------------------------------
  // dvr-stage-run itself (not the window: it opens nothing) on a stage that does no work: the row it logs carries six values (label, estimate, wired growth, ms, own device bytes: 0 while Metal is not up, the machine's
  // reading), a stage that answers nothing reads stage-refused, and a quiet stage is no abort whatever the machine moved
  def dvb-stage-run(m) {
   let vm = mg-sense();
   let env = dvr-env(dvb-iq2(), m, 1, 1, 64, 64, mg-wired(vm), dvb-gib(60));
   let vmNoted = record_set(env, "vm0", vm);
   let a = dvr-stage(env, "band-probe", dvb-gib(1), () => 1);
   let log = record_get(env, "log");
   let b = dvr-stage-run(env, "band-refused", dvb-gib(8), () => nothing());
   a == "" && len(log) == 1 && len(log[0]) == 6 && log[0][0] == "band-probe" && log[0][1] == dvb-gib(1) && log[0][4] == 0 && len(log[0][5]) == 7 && log[0][5][0] > 0 && log[0][5][1] > 0 && b == "stage-refused" && len(record_get(env, "log")) == 2
    && len(json-array-elements(parse-json("organs", record_get(env, "organs")))) >= 0 && parse-json("moved", record_get(env, "moved")) != 0;
  }
  def dvb-organ-rows() {
   let me = host_pid();
