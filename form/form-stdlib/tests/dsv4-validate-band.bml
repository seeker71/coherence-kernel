    && dvr-int(json-object-get(json-array-elements(json-object-get(doc, "stages"))[1], "vm"), "pageins", 0) == 1234 && dvr-int(json-object-get(json-array-elements(json-object-get(doc, "stages"))[1], "vm"), "pageouts", 0) == 5
