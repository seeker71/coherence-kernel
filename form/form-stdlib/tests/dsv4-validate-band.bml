    && dvb-has?(said, "available 100.0 GiB, wired 10.0 GiB, compressor occupied 1.0 GiB; since the window began pageins +100, pageouts +5, swapins +7, swapouts +9");
  }
  def dvb-backoff() = dvb-denial-wait() && dvb-denial-record() && dvb-field-8() && dvb-vm-counters-claim();

  // ---- 8192: the layer price is the bytes its dispatches can touch, never summed --------------------------------------------------------------------------
  def dvb-layer-price(m) {
   let layers = dvr-est-layers(m);
   let empty = dvb-vm(128, 110, 4, 0);
