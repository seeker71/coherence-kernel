  def dvb-organs-claim(m) = dvb-organs-rules() && dvb-organ-rows() && dvb-stage-rule(m) && dvb-stage-run(m);

  // ---- 4096: the denial, the wait ---------------------------------------------------------------------------------------------------------------------
  def dvb-vmstat-sample() = "Mach Virtual Memory Statistics: (page size of 16384 bytes)\nPages free:                             1852536.\nPages stored in compressor:             1824749.\nPages occupied by compressor:            413974.\nDecompressions:                        81053743.\n";
  // [the wait's answer [verdict, reading, ms waited, asks], the naps it took, the lines it said]
  def dvb-wait(seq, until) {
   let st = dvb-st();
   let g = dvr-wait-go(dvb-gib(1), until, dvb-io(st, seq), mg-nap-first(), 0, 0);
   [g, record_get(st, "naps"), record_get(st, "said")];
  }
  def dvb-denial-wait() {
   let quiet = dvb-quiet();
   let a = dvb-wait([dvb-busy(), dvb-busy(), dvb-busy(), quiet], 300000);
   let capped = dvb-wait([dvb-capped()], 3600000);
   let unreadable = dvb-wait([[]], 3600000);
   let reserve = dvb-wait([dvb-short(), quiet], 300000);
   let never = dvb-wait([dvb-busy()], 300000);
   let unbounded = dvb-wait([dvb-busy()], 3600000);
   let nowait = dvb-wait([dvb-busy(), quiet], 0);
   let said = print_str("  wait: naps " ++ a[1].str() ++ " then " ++ a[0][0][1] ++ " after " ++ a[0][2].str() ++ " ms; never lifting " ++ never[1].str() ++ " " ++ never[0][2].str() ++ " ms " ++ never[0][3].str() ++ " asks; unbounded would nap " ++ len(unbounded[1]).str() ++ " times; first line: " ++ a[2][0]);
   a[0][0][0] == 1 && a[0][0][1] == "room" && a[0][2] == 70000 && a[0][3] == 4 && a[1] == [10000, 20000, 40000] && len(a[2]) == 4 && dvb-has?(a[2][0], "ask 1 for 1.0 GiB (1073741824 B): compressor; available 100.0 GiB, wired 10.0 GiB, compressor occupied 40.0 GiB (cap 32.0 GiB)")
    && dvb-has?(a[2][0], "the window is idle and backs off") && dvb-has?(a[2][3], "ask 4 for 1.0 GiB") && dvb-has?(a[2][3], ": room;") && dvb-has?(a[2][3], "70 s waited") && !dvb-has?(a[2][3], "backs off")
    && capped[0][0][1] == "wired-cap" && capped[1] == [] && capped[0][3] == 1 && unreadable[0][0][1] == "memory-unreadable" && unreadable[1] == [] && unreadable[0][3] == 1
    && reserve[0][0][0] == 1 && reserve[1] == [10000] && reserve[0][2] == 10000
    && !dvr-transient?("wired-cap") && !dvr-transient?("memory-unreadable") && !dvr-transient?("room") && dvr-transient?("reserve") && dvr-transient?("compressor")
    && never[0][0][1] == "compressor" && never[1] == [10000, 20000, 40000, 60000, 60000, 60000, 60000] && never[0][2] == 310000 && never[0][3] == 8 && len(unbounded[1]) > 50 && unbounded[0][2] > 3000000
    && nowait[0][0][1] == "compressor" && nowait[1] == [] && nowait[0][2] == 0
    && dvr-wait-until(0, 0) == 300000 && dvr-wait-until(100000, 0) == 400000 && dvr-wait-until(1100000, 0) == 1200000 && dvr-wait-until(1190000, 0) == 1200000;
  }
  // the reading that denied, whole, in the record and in the stop
  def dvb-denial-record() {
   let never = dvb-wait([dvb-busy()], 300000);
   let g = never[0];
   let doc = parse-json("denied", dvr-denied-json(g, dvb-gib(1), 1824749));
   let env = dvr-env(dvb-iq2(), nothing(), 1, 1, 64, 64, 0, 0);
   let why = dvr-stop-denied(env, "head", dvb-gib(1), g);
   let kept = parse-json("kept", record_get(env, "denied"));
