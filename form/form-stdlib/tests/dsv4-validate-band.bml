  // the step reading on hand-made logits: [argmax, margin, gap of the recorded id below the top]
  def dvb-step-reads() {
   let ours = [0.5, 3.0, 2.75, 1.0];
   dvr-step(ours, 2) == [1, 0.25, 0.25] && dvr-step(ours, 1) == [1, 0.25, 0.0] && dvr-step([2.0, 2.0, 1.0], 2) == [0, 0.0, 1.0] && dvr-step([2.0, 1.0], 0 - 1) == [0, 1.0, 0.0]
    && dvr-want-at(0) == 11111 && dvr-want-at(23) == 455 && dvr-want-at(24) == 0 - 1
    && dvr-steps-margins([[1, 0.25, 0.25], [0, 0.0, 1.0]]) == [0.25, 0.0] && dvr-steps-gaps([[1, 0.25, 0.25], [0, 0.0, 1.0]]) == [0.25, 1.0];
