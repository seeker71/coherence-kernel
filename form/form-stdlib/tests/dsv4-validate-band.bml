  // the receipt carries both arrays whole, and a record without them (the plant: margins not recorded) reads empty arrays and is told from one with them
  def dvb-margin-row() {
   let row = dvr-receipt-row("2026-10-03 03:00:00 WITA", 1790000000000, dvb-record());
   let bare = dvr-receipt-row("2026-10-03 03:00:00 WITA", 1790000000000, record_set(dvb-record(), "margins", []));
   dvb-has?(row, "\"stream_margins\":" ++ dvr-floats-json(dvb-margins())) && dvb-has?(row, "\"stream_recorded_gap\":" ++ dvr-floats-json(dvb-rgaps()))
    && dvb-doc-len(row, "stream_margins") == 24 && dvb-doc-len(row, "stream_recorded_gap") == 24 && dvb-doc-len(bare, "stream_margins") == 0 && dvb-doc-len(bare, "stream_recorded_gap") == 24;
  }
  // the wrong index: the gap read against the wrong recorded id is a different number, and a margin read off the second place instead of the top is a different one
  def dvb-margin-plants() {
   let ours = [0.5, 3.0, 2.75, 1.0];
   let truth = dvr-step(ours, 2);
   dvr-step(ours, 0)[2] != truth[2] && dvr-step(ours, 3)[2] != truth[2] && (dvr-two(ours)[2] != dvr-two(ours)[1]) && (dvr-two(ours)[1] - dvr-two(ours)[2]) == truth[1];
  }
  // ---- 256: the go path with gaps maps nothing, writes the row, gives the lease back; the steps; the waits ----------------------------------------------------
  def dvb-refuse-gaps(m, path, receipt) {
   let held = mg-lease("dsv4-validate-band", "", dvb-mib(1), dvb-mib(1));
   let leaseFile = mg-lease-path(mg-lease-dir(), host_pid());
   let took = mg-granted?(held) && file_size(leaseFile) > 0;
   let opts = parse-json("opts", "{\"go\":1,\"receipt\":\"" ++ receipt ++ "\"}");
   let r = dvr-refuse-gaps(opts, path, file_size(path), m);
   let text = read_file(receipt) ?? "";
   let doc = len(text) > 0 ? parse-json("row", trim(text)) : json-node-object([]);
   let said = print_str("  go with gaps: lease taken " ++ took.str() ++ ", exit " ++ r.str() ++ ", row " ++ len(text).str() ++ " bytes, lease file after " ++ file_size(leaseFile).str());
   took && r == 1 && dvr-text(doc, "status", "") == "refused" && dvr-text(doc, "reason", "") == "driver-gaps" && len(json-array-elements(json-object-get(doc, "driver_gaps"))) == 4 && !(file_size(leaseFile) > 0);
