    && dvr-int(doc, "compressor_pages_stored", 0) == 1824749 && dvr-int(doc, "need", 0) == dvb-gib(1) && dvr-int(doc, "mem", 0) == dvb-gib(128) && dvr-int(doc, "waited_ms", 0) == 310000 && dvr-int(doc, "asks", 0) == 8
    && why == "ask-denied:compressor" && dvr-text(kept, "reason", "") == "compressor" && dvr-int(kept, "need", 0) == dvb-gib(1) && record_get(dvr-env(dvb-iq2(), nothing(), 1, 1, 64, 64, 0, 0), "denied") == "{}";
  }
  // what field 8 is: vm_stat's text, and this Mac's own two readings of it
  def dvb-field-8() {
   let vm = host_vm_stat();
   let text = host-exec("vm_stat", "") ?? "";
   let occupied = dvr-vmstat-field(text, "Pages occupied by compressor");
   let stored = dvr-vmstat-field(text, "Pages stored in compressor");
   let said = print_str("  host_vm_stat field 8 " ++ vm[8].str() ++ " pages; vm_stat occupied " ++ occupied.str() ++ ", stored " ++ stored.str() ++ " (" ++ (stored * 16384 / dvb-gib(1)).str() ++ " GiB stored in " ++ (occupied * 16384 / dvb-gib(1)).str() ++ " GiB)");
   dvr-vmstat-field(dvb-vmstat-sample(), "Pages stored in compressor") == 1824749 && dvr-vmstat-field(dvb-vmstat-sample(), "Pages occupied by compressor") == 413974 && dvr-vmstat-field(dvb-vmstat-sample(), "Decompressions") == 81053743
    && dvr-vmstat-field(dvb-vmstat-sample(), "Pages missing") == 0 - 1 && occupied > 0 && abs(vm[8] - occupied) <= (vm[8] / 50) + 5000 && stored > occupied && dvr-stored-pages() > 0;
  }
  def dvb-vm-counters-claim() {
