; form-cli-author-altitude-band.fk — the altitude mirror, authored in BML.
;
; Verdict 783:
;   1..8    aar-check (pictures live, cells outnumber pictures, bindings live, fold agrees)
;   256     class descriptor FormAuthorAltitude minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-author-altitude-xtal.fk
; witnessed: 2026-08-30 -> 783

(do
    (defn aarb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn aarb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (aarb-has-name? (tail xs) name))))

    (let bits (aar-check))
    (let desc (FormAuthorAltitude))
    (let src (read_file "form/form-stdlib/bml/form-cli-author-altitude.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormAuthorAltitude")
                     (and (eq (aarb-has-name? (nth desc 2) "T") 1)
                          (and (eq (aarb-has-name? (nth desc 3) "aar-run") 1)
                               (eq (aarb-has-name? (nth desc 4) "PicturesDir") 1))))
                256 0))
    (let b9 (if (and (eq (aarb-has-str? src "package Form.cli.authoraltitude") 1)
                     (and (eq (aarb-has-str? src "interface IAuthorAltitude") 1)
                          (and (eq (aarb-has-str? src "class FormAuthorAltitude") 1)
                               (and (eq (aarb-has-str? src "const String PicturesDir") 1)
                                    (eq (aarb-has-str? src "template AltitudeRow") 1)))))
                512 0))
    (add bits (add b8 b9)))
