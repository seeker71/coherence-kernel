; dsv4-control-tokens-native-band.fk — artifact-backed alias witness.
; Expected verdict 31.
; preludes: form-stdlib/dsv4-control-tokens.fk

(do
    (defn dctb-eq (a b)
        (if (eq (len a) (len b))
            (if (eq (len a) 0) 1
                (if (eq (head a) (head b)) (dctb-eq (tail a) (tail b)) 0))
            0))
    (let src (tkz-src (dct-model)))
    (let a (if (dct-all-safe? src (dct-manifest)) 1 0))
    (let b (if (dctb-eq (dct-ids) (list 128000 128001 128002 128003 128004)) 2 0))
    (let c (if (eq (dct-name (dct-id "TIMEOUT")) "TIMEOUT") 4 0))
    (let d (if (eq (dct-wire "CHOICE") "<BMF:CHOICE>") 8 0))
    ; No type-5 row exists: allocation honestly uses the reserved type-3 bank.
    (let tkv (dct-type-kv src))
    (let e (if (if (eq (gmt-arr-count src tkv) 129280)
                    (eq (dct-artifact-type src 128000) 3) 0) 16 0))
    (add a (add b (add c (add d e)))))
