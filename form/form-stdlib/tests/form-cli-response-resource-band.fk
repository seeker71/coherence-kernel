   if not(value_eq(toolCommand,append(fat-take(ordinaryCommand,10),list("--add-dir","/tmp/owned-evidence","-o","/tmp/reply","-")))) then form_error("native tool write scope differs from its owned directory") else 0;
   let lifecycle = list(frrb-yes(frr-lifecycle(judged,finished)),not(frrb-yes(frr-lifecycle(judged,oh-set(finished,"state",json-node-string("running"))))),not(frrb-yes(frr-lifecycle(judged,oh-set(finished,"cleanup",json-node-object(list()))))),not(frrb-yes(frr-lifecycle(judged,oh-set(finished,"status",json-node-int(1))))),not(frrb-yes(frr-lifecycle(frr-judgment(assessment,"{\"answer\":false}","0",usage),finished))));
   let defaults = list(not(frr-allowed(json-node-object(list()))),not(frr-allowed(oh-set(request,"provider",json-node-null()))),not(frr-valid(oh-set(request,"assessment",oh-set(assessment,"mode",json-node-string("code"))))));
   print(append(checks,append(integrity,append(lifecycle,defaults))));
   if and(frrb-all(checks),and(frrb-all(integrity),and(frrb-all(lifecycle),frrb-all(defaults)))) then 1 else form_error("response resource contract failed");
  }
 }
 frrb-run();
}
