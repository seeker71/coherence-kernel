section [form.bml] {
 class FormResponseResourceBand {
  def frrb-assessment() = parse-json("assessment","{\"mode\":\"review\",\"evaluation\":1,\"goal\":\"Return a JSON answer from the supplied evidence.\",\"writable\":[],\"documents\":[{\"id\":\"evidence\",\"path\":\"evidence.json\",\"text\":\"{\\\"known\\\":true}\"}],\"checks\":[{\"tool\":\"cat\",\"arguments\":[\"evidence.json\"],\"stdout\":\"{\\\"known\\\":true}\"}],\"report_checks\":[{\"tool\":\"jq\",\"arguments\":[\".answer\"],\"stdout\":\"true\\n\"}]}");
  def frrb-request() = json-node-object(list(nsm-s("id","resource-boundary"),json-node-pair("assessment",frrb-assessment()),json-node-pair("local_reports",json-node-array(list(json-node-string("retained-local-report.json")))),json-node-pair("provider",parse-json("provider","{\"allowed\":true,\"interface\":\"codex-exec\",\"max_processes\":1,\"seconds\":180}"))));
  def frrb-yes(row) = eq(nsm-num(row,"verified_repair"),1);
  def frrb-all(xs) = if nil?(xs) then 1 else and(head(xs),frrb-all(tail(xs)));
  def frrb-run() {
   let request = frrb-request();
   if not(and(str_eq(nsm-str(frr-input(nothing()),"status"),"invalid-or-oversized-resource-request"),str_eq(nsm-str(frr-input("@"),"status"),"resource-request-file-unavailable-or-oversized"))) then form_error("empty resource input reached execution") else 0;
   if not(str_eq(nsm-str(frr-input("@form/form-stdlib/tests/form-cli-response-resource-band.fk"),"status"),"invalid-or-oversized-resource-request")) then form_error("file-backed invalid JSON reached execution") else 0;
   if not(and(str_eq(frr-query("help"),frr-help()),str_eq(nsm-str(frr-input("{}"),"status"),"invalid-readonly-assessment-or-local-evidence-contract"))) then form_error("resource query changed inline validation or help") else 0;
   let assessment = frrb-assessment();
   let provider = frr-provider(request);
   if not(frr-provider-valid(oh-set(provider,"seconds",json-node-int(0)))) then form_error("progress-aware supervision refused") else 0;
   if or(frr-provider-valid(json-node-object(oh-without(json-object-pairs(provider),"seconds"))),or(frr-provider-valid(oh-set(provider,"seconds",json-node-string("0"))),frr-provider-valid(oh-set(provider,"seconds",parse-json("fraction","0.5"))))) then form_error("implicit or noninteger supervision admitted") else 0;
   let source = frr-source(assessment);
   let wrong = frr-report(assessment,"{\"answer\":false}");
   let good = frr-report(assessment,"{\"answer\":true}");
   let usage = json-node-object(list(nsm-s("status","observed")));
   let changed = oh-set(assessment,"documents",json-node-array(list(parse-json("changed","{\"id\":\"evidence\",\"path\":\"evidence.json\",\"text\":\"changed\"}"))));
   let sentinel = oh-set(assessment,"report_checks",json-node-array(list(parse-json("sentinel","{\"tool\":\"jq\",\"arguments\":[\".answer\"],\"stdout\":\"expected-only-sentinel\\n\"}"))));
   let prompt = frr-prompt(sentinel,"{\"answer\":false}",frr-report(sentinel,"{\"answer\":false}"));
   let checks = list(frr-valid(request),frr-allowed(request),not(frr-allowed(oh-set(request,"provider",parse-json("number-permission","{\"allowed\":1}")))),not(frr-valid(oh-set(request,"assessment",oh-set(assessment,"evaluation",json-node-int(0))))),not(frr-valid(oh-set(request,"assessment",oh-set(assessment,"writable",json-node-array(list(json-node-string("evidence.json"))))))),frr-provider-valid(frr-provider(request)),not(frr-provider-valid(oh-set(frr-provider(request),"max_processes",json-node-int(2)))),not(frr-provider-valid(oh-set(frr-provider(request),"seconds",json-node-int(-1)))),str_eq(frr-plan(1,source,good),"local-report-passed"),str_eq(frr-plan(0,source,wrong),"provider-not-offered"),str_eq(frr-plan(1,frr-source(changed),wrong),"source-needs-repair"),str_eq(frr-plan(1,source,wrong),"provider-repair"),frrb-yes(frr-judgment(assessment,"{\"answer\":true}","0",usage)),not(frrb-yes(frr-judgment(assessment,"{\"answer\":false}","0",usage))),not(frrb-yes(frr-judgment(assessment,"{\"answer\":true}","1",usage))),not(frrb-yes(frr-judgment(assessment,"{\"answer\":true}","0",json-node-object(list())))),not(frrb-yes(frr-judgment(changed,"{\"answer\":true}","0",usage))),lt(str_find(prompt,"expected-only-sentinel",0),0));
   let stamp = json-node-object(list(nsm-s("answer_sha256",fcam-hash("answer")),nsm-s("usage_sha256",fcam-hash("events"))));
   let integrity = list(frr-intact("answer","events",stamp),not(frr-intact("changed","events",stamp)),not(frr-intact("answer","changed",stamp)),not(frr-intact("answer","events",json-node-object(list()))),frsh-write-confirmed(0,1,"",""),not(frsh-write-confirmed(-1,1,"","")),not(frsh-write-confirmed(0,0,"","")),not(frsh-write-confirmed(1,1,"actual","different")));
   let judged = frr-judgment(assessment,"{\"answer\":true}","0",usage);
   let finished = parse-json("finished","{\"state\":\"finished\",\"status\":0,\"cleanup\":{\"state\":\"released\"}}");
   let interrupted = frr-lifecycle(judged,oh-set(finished,"status",json-node-int(143)));
   if not(and(eq(nsm-num(interrupted,"process_released"),1),not(frrb-yes(interrupted)))) then form_error("released failure was confused with successful repair") else 0;
   let ordinaryCommand = list("codex","exec","--sandbox","workspace-write","--ephemeral","--skip-git-repo-check","--ignore-user-config","--json","--cd","/tmp/work","-o","/tmp/reply","-");
   let timedPrompt = frr-timed-prompt("REQUEST-SENTINEL",480);
   if not(and(eq(str_find(timedPrompt,"Form process budget: 480 seconds",0),0),and(ge(str_find(timedPrompt,"REQUEST-SENTINEL",0),0),str_eq(frr-timed-prompt("REQUEST-SENTINEL",0),"REQUEST-SENTINEL")))) then form_error("provider deadline notice or unbounded prompt changed incorrectly") else 0;
   if not(value_eq(frr-command("/tmp/work","/tmp/reply",""),ordinaryCommand)) then form_error("ordinary provider scope changed") else 0;
