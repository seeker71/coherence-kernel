; living-world-composition-voice-witness.fk -- confirmed multi-lens composition speaks.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/living-world-multilens-plan.fk form-stdlib/living-world-composition-outcome.fk form-stdlib/living-world-composition-voice.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk form-stdlib/tests/living-world-relational-voice-witness.fk form-stdlib/tests/living-world-multilens-witness.fk form-stdlib/tests/living-world-composition-outcome-witness.fk

(let LWCVW-CAPABILITY (bp "LWCVW-CAPABILITY"))
(let LWCVW-SOURCE-I (bp "LWCVW-SOURCE-I"))
(let LWCVW-PROV-I (bp "LWCVW-PROV-I"))
(let LWCVW-EVIDENCE (bp "LWCVW-EVIDENCE"))

(defn lwcvw-cell (kind) (intern_node kind (empty)))
(defn lwcvw-capability () (lwcvw-cell LWCVW-CAPABILITY))
(defn lwcvw-source-i () (lwcvw-cell LWCVW-SOURCE-I))
(defn lwcvw-prov-i () (lwcvw-cell LWCVW-PROV-I))
(defn lwcvw-evidence () (lwcvw-cell LWCVW-EVIDENCE))

(defn lwcvw-basis ()
    (lwt-proposal-candidate
        (lwrew-proposal-for-world (lwrew-world))))
(defn lwcvw-composition-candidate ()
    (lwt-proposal-candidate (lwcow-confirmed-proposal)))
(defn lwcvw-edge (relation left right)
    (lwt-proposal-candidate
        (lwmpw-find-proposal
            (lwt-round-proposals (lwmpw-relation-round))
            relation left right)))
(defn lwcvw-alpha-first ()
    (lwcvw-edge (lwrvw-relation) (lwrvw-left) (lwrvw-right)))
(defn lwcvw-alpha-second ()
    (lwcvw-edge (lwrvw-relation) (lwrvw-right) (lwmpw-third)))
(defn lwcvw-beta-first ()
    (lwcvw-edge (lwmpw-relation-beta) (lwrvw-left) (lwrvw-right)))
(defn lwcvw-beta-second ()
    (lwcvw-edge (lwmpw-relation-beta) (lwrvw-right) (lwmpw-third)))

(defn lwcvw-entry-i (payload)
    (lwrvw-entry-for (lwcvw-source-i) (lwcvw-prov-i) payload))
(defn lwcvw-grant-entry (source provenance payload)
    (lwrvw-entry-for source provenance
        (lwcp-grant payload (lwcvw-capability) (lwcvw-evidence))))

(defn lwcvw-world ()
    (lwt-receive-stream (lwcow-confirmed-integrated-world)
        (list
            (lwcvw-entry-i (lwcvw-capability))
            ; Exact execution ground.
            (lwcvw-grant-entry (lwrew-source-a) (lwrew-prov-a)
                (lwcvw-basis))
            (lwcvw-grant-entry (lwrew-source-b) (lwrew-prov-b)
                (lwcvw-basis))
            (lwcvw-grant-entry (lwrew-source-a) (lwrew-prov-a)
                (lwrew-recipe))
            (lwcvw-grant-entry (lwrew-source-a) (lwrew-prov-a)
                (lwrew-declaration))
            (lwcvw-grant-entry (lwrew-source-b) (lwrew-prov-b)
                (lwrew-before))
            ; Three learned symbols.
            (lwcvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwrvw-left))
            (lwcvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwrvw-left))
            (lwcvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwrvw-right))
            (lwcvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwrvw-right))
            (lwcvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwmpw-third))
            (lwcvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwmpw-third))
            (lwcvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwrvw-forty-observation))
            (lwcvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwrvw-forty-observation))
            (lwcvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwrvw-nine-observation))
            (lwcvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwrvw-nine-observation))
            (lwcvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwmpw-third-observation))
            (lwcvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwmpw-third-observation))
            ; Alpha edge candidates and exact observations.
            (lwcvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwcvw-alpha-first))
            (lwcvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwcvw-alpha-first))
            (lwcvw-grant-entry (lwslw-source-c) (lwslw-prov-c)
                (lwcvw-alpha-first))
            (lwcvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwcvw-alpha-second))
            (lwcvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwcvw-alpha-second))
            (lwcvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwrvw-order-support-a))
            (lwcvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwrvw-order-support-b))
            (lwcvw-grant-entry (lwslw-source-c) (lwslw-prov-c)
                (lwrvw-order-inverse-c))
            (lwcvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwmpw-alpha-second-a))
            (lwcvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwmpw-alpha-second-b))
            ; Beta edge candidates and exact observations.
            (lwcvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwcvw-beta-first))
            (lwcvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwcvw-beta-first))
            (lwcvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwcvw-beta-second))
            (lwcvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwcvw-beta-second))
            (lwcvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwmpw-beta-first-a))
            (lwcvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwmpw-beta-first-b))
            (lwcvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwmpw-beta-second-a))
            (lwcvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwmpw-beta-second-b))
            ; Exact aligned declaration.
            (lwcvw-grant-entry (lwrvw-source-d) (lwrvw-prov-d)
                (lwmpw-aligned-declaration))
            ; Confirmed composition candidate: every integrated holder grants.
            (lwcvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwcvw-composition-candidate))
            (lwcvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwcvw-composition-candidate))
            (lwcvw-grant-entry (lwslw-source-c) (lwslw-prov-c)
                (lwcvw-composition-candidate))
            (lwcvw-grant-entry (lwrvw-source-d) (lwrvw-prov-d)
                (lwcvw-composition-candidate))
            (lwcvw-grant-entry (lwrvw-source-e) (lwrvw-prov-e)
                (lwcvw-composition-candidate))
            (lwcvw-grant-entry (lwcow-source-f) (lwcow-prov-f)
                (lwcvw-composition-candidate))
            ; Outcome evidence needed to rederive confirmed state.
            (lwcvw-grant-entry (lwrvw-source-e) (lwrvw-prov-e)
                (lwcow-confirmation))
            (lwcvw-grant-entry (lwcow-source-f) (lwcow-prov-f)
                (lwcow-silence)))))

(defn lwcvw-context-for (world)
    (lwcp-context world (lwcvw-capability)))
(defn lwcvw-context () (lwcvw-context-for (lwcvw-world)))
(defn lwcvw-proposal-for (world)
    (lwcv-proposal (lwcvw-context-for world)
        (lwcvw-basis) (lwrvw-referent)
        (lwcvw-composition-candidate)
        (lwo-empty-field) (lwo-none) (lwo-none) (lwcvw-evidence)))
(defn lwcvw-round ()
    (do
        (let world (lwcvw-world))
        (let proposal (lwcvw-proposal-for world))
        (lwt-round world (lwo-field (list proposal))
            (lwo-empty-field) (lwo-none))))
(defn lwcvw-response (source provenance proposal)
    (lwrvw-entry-for source provenance
        (lwt-response proposal (oac-one proposal) provenance)))
(defn lwcvw-yes-round ()
    (do
        (let round (lwcvw-round))
        (let proposal (head (lwo-field-items (lwt-round-proposals round))))
        (lwt-round-receive round
            (list
                (lwcvw-response
                    (lwrew-source-a) (lwrew-prov-a) proposal)
                (lwcvw-response
                    (lwrew-source-b) (lwrew-prov-b) proposal)
                (lwcvw-response
                    (lwslw-source-a) (lwslw-prov-a) proposal)
                (lwcvw-response
                    (lwslw-source-b) (lwslw-prov-b) proposal)
                (lwcvw-response
                    (lwslw-source-c) (lwslw-prov-c) proposal)
                (lwcvw-response
                    (lwrvw-source-d) (lwrvw-prov-d) proposal)
                (lwcvw-response
                    (lwrvw-source-e) (lwrvw-prov-e) proposal)
                (lwcvw-response
                    (lwcow-source-f) (lwcow-prov-f) proposal)
                (lwcvw-response
                    (lwcvw-source-i) (lwcvw-prov-i) proposal)))))
(defn lwcvw-integrated-round ()
    (do
        (let round (lwcvw-yes-round))
        (let proposal (head (lwo-field-items (lwt-round-proposals round))))
        (lwcv-integrate round proposal (lwrew-action))))

(defn lwcvw-late-world ()
    (lwt-receive-stream (lwcvw-world)
        (list
            (lwcow-entry-g (lwcow-correction))
            (lwcow-entry-h (lwcow-alternative-offer)))))

(defn lwcvw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwcvw-sum (tail items)))))
