; preludes: form-stdlib/core.fk form-stdlib/bml/vector-ops.bml form-stdlib/bml/gpu-dispatch.bml
; gpu-dispatch-band — a recipe takes the GPU lane by the shape of its data; callers never name it.
; PROOF LEVEL: FOURTH-ARM ONLY (metal handle door)
;
; dot_product and vector_scale are the same names every kernel calls over lists. Handed tensors,
; they run their own nodes as Metal kernels, compiled once per process and kept, and a map's
; answer stays resident until a number is read.
;
; Verdict 63 when every claim lands:
;   1   gd-tensor? knows a tensor from a float list and from an int
;   2   dot_product over two tensors equals dot_product over the lists within one part in ten thousand
;   4   the second call compiles nothing: gd-program answers the same admitted handle
;   8   vector_scale over a tensor answers a tensor whose first eight floats equal the list answer's
;   16  the chooser's belief is law today and chooses gpu for a tensor, cpu for a list
;   32  a resident map feeds a resident reduce with one read at the end: dot_product(vector_scale(t, 2), ones)
;       equals twice the list sum within the tolerance, and the two calls made two dispatches
;
; Verdict 63
(do
    (defn gdb-fill (n acc) (if (eq n 0) acc (gdb-fill (sub n 1) (cons (add 0.5 (div (add (mod n 97) 0.0) 97.0)) acc))))
    (defn gdb-ones (n acc) (if (eq n 0) acc (gdb-ones (sub n 1) (cons 1.0 acc))))
    (defn gdb-near? (a b) (do (let d (if (lt (sub a b) 0.0) (sub b a) (sub a b))) (let m (if (lt a 0.0) (sub 0.0 a) a)) (le d (mul m 0.0001))))
    (defn gdb-all-near? (xs ys) (if (nil? xs) 1 (if (gdb-near? (head xs) (head ys)) (gdb-all-near? (tail xs) (tail ys)) 0)))
    (let a (gdb-fill 1000 (empty)))
    (let b (gdb-fill 1000 (empty)))
    (let ta (gd-tensor a))
    (let tb (gd-tensor b))
    (let ones (gd-tensor (gdb-ones 1000 (empty))))
    (let g (dot_product ta tb))
    (let c (dot_product a b))
    (let p1 (gd-program "vo-dot-onto" (list)))
    (let p2 (gd-program "vo-dot-onto" (list)))
    (let ts (vector_scale ta 2.5))
    (let ls (vector_scale a 2.5))
    (let d0 (gl-count "total_dispatch"))
    (let chained (dot_product (vector_scale ta 2.0) ones))
    (let d1 (gl-count "total_dispatch"))
    (let twice (mul 2.0 (sum a)))
    (print (list "gpu" g "cpu" c "chained" chained "twice" twice "dispatches" (sub d1 d0) "choose" (gd-choose ta) (gd-choose a)))
    (let v0 (if (and (eq (gd-tensor? ta) 1) (and (eq (gd-tensor? a) 0) (eq (gd-tensor? 7) 0))) 1 0))
    (let v1 (if (gdb-near? g c) 2 0))
    (let v2 (if (and (gl-ok? p1) (eq (mj-handle (nth p1 1)) (mj-handle (nth p2 1)))) 4 0))
    (let v3 (if (and (eq (gd-tensor? ts) 1) (eq (gdb-all-near? (gd-read ts 8) (take 8 ls)) 1)) 8 0))
    (let v4 (if (and (eq (bf-law? (gd-belief) 20260915) 1) (and (str_eq (gd-choose ta) "gpu") (str_eq (gd-choose a) "cpu"))) 16 0))
    (let v5 (if (and (gdb-near? chained twice) (eq (sub d1 d0) 2)) 32 0))
    (gd-free ta)
    (gd-free tb)
    (gd-free ones)
    (gd-free ts)
    (add v0 (add v1 (add v2 (add v3 (add v4 v5))))))
