; form-cli-peer-contribution-live-birth-band.fk -- contribution-resident birth
; comes from BML; absent source context remains nothing and zero remains zero.
; Expected: 255
; preludes: form-stdlib/bml/form-cli-peer-contribution-live-birth.bml

(do
    (defn fcpclbb-bit (ok bit) (if ok bit 0))
    (framebuffer-clear)
    (let observed (fcpclb-birth "ready" 0 7 7))
    (let absent (fcpclb-birth "cold" (nothing) 0 0))
    (let birth-frame (fcpclb-record-birth observed))
    (let prefill-frame (fcpclb-record-prefill 11))
    (let release-frame (fcpclb-record-release 1))
    (sum (list
        (fcpclbb-bit (and (eq (fcpclb-birth? observed) 1)
            (and (str_eq (fcpclb-cache observed) "ready")
                (and (eq (fcpclb-source-context-ms observed) 0)
                    (and (eq (fcpclb-native-program-ms observed) 7)
                        (eq (fcpclb-setup-ms observed) 7))))) 1)
        (fcpclbb-bit (and (nothing? (fcpclb-source-context-ms absent))
            (and (eq (fcpclb-native-program-ms absent) 0)
                (eq (fcpclb-setup-ms absent) 0))) 2)
        (fcpclbb-bit (and (str_eq (fcpclb-entry-source)
                "observe/form-cli-peer-contribution-live.fk")
            (str_eq (fcpclb-entry-cache)
                "observe/form-cli-peer-contribution-live.fk.fkb")) 4)
        (fcpclbb-bit (and (eq (fcplf-stage-code "resident-cache") 1)
            (and (eq (fcplf-stage-code "source-context-ready") 2)
                (and (eq (fcplf-stage-code "native-program-ready") 3)
                    (and (eq (fcplf-stage-code "resident-setup") 4)
                        (and (eq (fcplf-stage-code "prefill-ready") 5)
                            (eq (fcplf-stage-code "release") 8)))))) 8)
        (fcpclbb-bit (eq (len (framebuffer-events)) 6) 16)
        (fcpclbb-bit (and (eq (fcpclb-source-context-ms observed) 0)
            (nothing? (fcpclb-source-context-ms absent))) 32)
        (fcpclbb-bit (or (str_eq (fcpclb-cache-state) "ready")
            (or (str_eq (fcpclb-cache-state) "cold")
                (or (str_eq (fcpclb-cache-state) "stale")
                    (str_eq (fcpclb-cache-state) "missing")))) 64)
        (fcpclbb-bit (and (str_eq (fcpclb-cache observed) "ready")
            (nothing? (fcpclb-source-context-ms absent))) 128))))
