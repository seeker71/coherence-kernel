; living-world-tissue-prediction-witness.fk -- admitted contextual tissue
; risks a future, meets independent observation, and changes its next risk.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk form-stdlib/living-world-contextual-species.fk form-stdlib/living-world-tissue-prediction.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk form-stdlib/tests/living-world-behavioral-species-witness.fk form-stdlib/tests/living-world-contextual-species-witness.fk

(let LWTPW-BASE-FIXTURE       (bp "LWTPW-BASE-FIXTURE"))
(let LWTPW-PREDICTION-FIXTURE (bp "LWTPW-PREDICTION-FIXTURE"))
(let LWTPW-EXPERIENCE-FIXTURE (bp "LWTPW-EXPERIENCE-FIXTURE"))
(let LWTPW-SOURCE-T            (bp "LWTPW-SOURCE-T"))
(let LWTPW-SOURCE-U            (bp "LWTPW-SOURCE-U"))
(let LWTPW-SOURCE-V            (bp "LWTPW-SOURCE-V"))
(let LWTPW-SOURCE-W            (bp "LWTPW-SOURCE-W"))
(let LWTPW-PROV-T              (bp "LWTPW-PROV-T"))
(let LWTPW-PROV-U              (bp "LWTPW-PROV-U"))
(let LWTPW-PROV-V              (bp "LWTPW-PROV-V"))
(let LWTPW-PROV-W              (bp "LWTPW-PROV-W"))
(let LWTPW-EVIDENCE-A          (bp "LWTPW-EVIDENCE-A"))
(let LWTPW-EVIDENCE-B          (bp "LWTPW-EVIDENCE-B"))
(let LWTPW-OPTION-A            (bp "LWTPW-OPTION-A"))
(let LWTPW-OPTION-B            (bp "LWTPW-OPTION-B"))
(let LWTPW-UNKNOWN-A           (bp "LWTPW-UNKNOWN-A"))
(let LWTPW-REASON              (bp "LWTPW-REASON"))

(defn lwtpw-cell (kind) (intern_node kind (empty)))
(defn lwtpw-source-t () (lwtpw-cell LWTPW-SOURCE-T))
(defn lwtpw-source-u () (lwtpw-cell LWTPW-SOURCE-U))
(defn lwtpw-source-v () (lwtpw-cell LWTPW-SOURCE-V))
(defn lwtpw-source-w () (lwtpw-cell LWTPW-SOURCE-W))
(defn lwtpw-prov-t () (lwtpw-cell LWTPW-PROV-T))
(defn lwtpw-prov-u () (lwtpw-cell LWTPW-PROV-U))
(defn lwtpw-prov-v () (lwtpw-cell LWTPW-PROV-V))
(defn lwtpw-prov-w () (lwtpw-cell LWTPW-PROV-W))
(defn lwtpw-evidence-a () (lwtpw-cell LWTPW-EVIDENCE-A))
(defn lwtpw-evidence-b () (lwtpw-cell LWTPW-EVIDENCE-B))
(defn lwtpw-option-a () (lwtpw-cell LWTPW-OPTION-A))
(defn lwtpw-option-b () (lwtpw-cell LWTPW-OPTION-B))
(defn lwtpw-unknown-a () (lwtpw-cell LWTPW-UNKNOWN-A))
(defn lwtpw-reason () (lwtpw-cell LWTPW-REASON))

(defn lwtpw-entry (source provenance payload)
    (lwcsw-entry source provenance payload))
(defn lwtpw-entry-t (payload)
    (lwtpw-entry (lwtpw-source-t) (lwtpw-prov-t) payload))
(defn lwtpw-entry-u (payload)
    (lwtpw-entry (lwtpw-source-u) (lwtpw-prov-u) payload))
(defn lwtpw-entry-v (payload)
    (lwtpw-entry (lwtpw-source-v) (lwtpw-prov-v) payload))
(defn lwtpw-entry-w (payload)
    (lwtpw-entry (lwtpw-source-w) (lwtpw-prov-w) payload))

; children: split world, admitted three-Recipe tissue, previous round
(defn lwtpw-base-fixture (world tissue round)
    (intern_node LWTPW-BASE-FIXTURE (list world tissue round)))
(defn lwtpw-base-world (fixture) (nth (node_children fixture) 0))
(defn lwtpw-base-tissue (fixture) (nth (node_children fixture) 1))
(defn lwtpw-base-round (fixture) (nth (node_children fixture) 2))
(defn lwtpw-build-base ()
    (do
        (let multi (lwcsw-build-multi))
        (let coherent (lwcsw-integrated-coherent-tissue multi))
        (let split (lwcsw-build-split multi coherent))
        (let tissue-fixture (lwcsw-split-tissue split))
        (lwtpw-base-fixture
            (lwcsw-split-world-cell split)
            (lwcsw-tissue-candidate tissue-fixture)
            (lwcsw-tissue-round tissue-fixture))))

(defn lwtpw-timeout-a ()
    (oac-timeout (intern_trivial_int 10)
        (oac-alternative-ack (lwtpw-option-a) (lwtpw-option-b)
            (lwtpw-evidence-a))
        (lwtpw-evidence-a)))
(defn lwtpw-choice-a ()
    (lwlc-choice (lwo-none)
        (lwo-field (list (lwtpw-option-a) (lwtpw-option-b)))
        (lwlc-unknown (lwtpw-unknown-a)) (lwtpw-evidence-a)))
(defn lwtpw-target-a ()
    (lwtp-target (intern_trivial_int 1) (lwcsw-context-a)
        (lwo-field (list (lwtpw-option-a) (lwtpw-option-b)))
        (lwlc-unknown (lwtpw-unknown-a)) (lwtpw-choice-a)
        (lwtpw-timeout-a) (lwtpw-evidence-a)))
(defn lwtpw-target-b ()
    (lwtp-target (intern_trivial_int 1) (lwo-none)
        (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none)
        (lwtpw-evidence-b)))
(defn lwtpw-target-world (base target)
    (lwt-receive-stream (lwtpw-base-world base)
        (list
            (lwtpw-entry-t target)
            (lwtpw-entry-u target))))

; A proposal's exact witness attributions already carry the source and
; provenance required for consent. Duplicate sources merely repeat the same
; ONE and cannot increase the distinct participant field.
(defn lwtpw-response-entries-items (proposal items)
    (if (eq (len items) 0) (list)
        (do
            (let attribution (head items))
            (let source (lwo-attribution-source attribution))
            (let provenance (nth (node_children attribution) 2))
            (cons
                (lwtpw-entry source provenance
                    (lwt-response proposal (oac-one proposal) provenance))
                (lwtpw-response-entries-items proposal (tail items))))))
(defn lwtpw-response-entries (proposal)
    (lwtpw-response-entries-items proposal
        (lwo-field-items
            (lwo-emergent-witnesses
                (lwt-proposal-candidate proposal)))))

; children: integrated round, exact candidate/proposal/target/prediction
(defn lwtpw-prediction-fixture
    (round candidate proposal target prediction)
    (intern_node LWTPW-PREDICTION-FIXTURE
        (list round candidate proposal target prediction)))
(defn lwtpw-prediction-round (fixture) (nth (node_children fixture) 0))
(defn lwtpw-prediction-candidate (fixture) (nth (node_children fixture) 1))
(defn lwtpw-prediction-proposal-cell (fixture) (nth (node_children fixture) 2))
(defn lwtpw-prediction-target (fixture) (nth (node_children fixture) 3))
(defn lwtpw-prediction-shape (fixture) (nth (node_children fixture) 4))
(defn lwtpw-integrate-prediction
    (world tissue target threshold observed-time previous)
    (do
        (let proposal
            (lwtp-prediction-proposal
                world tissue target threshold observed-time))
        (let candidate (lwt-proposal-candidate proposal))
        (let prediction (lwo-emergent-shape candidate))
        (let round
            (lwt-round world (lwo-field (list proposal))
                (lwo-empty-field) previous))
        (let answered
            (lwt-round-receive round
                (lwtpw-response-entries proposal)))
        (let integrated
            (lwtp-prediction-integrate answered proposal (lwigw-action)))
        (lwtpw-prediction-fixture
            integrated candidate proposal target prediction)))
(defn lwtpw-initial-a (base)
    (do
        (let target (lwtpw-target-a))
        (lwtpw-integrate-prediction
            (lwtpw-target-world base target) (lwtpw-base-tissue base)
            target 2 (intern_trivial_int 5) (lwtpw-base-round base))))
(defn lwtpw-initial-b (base)
    (do
        (let target (lwtpw-target-b))
        (lwtpw-integrate-prediction
            (lwtpw-target-world base target) (lwtpw-base-tissue base)
            target 2 (lwo-none) (lwtpw-base-round base))))

(defn lwtpw-confirmation (prediction)
    (lwtp-observation (lwtpw-prediction-candidate prediction)
        (intern_trivial_int 4) (oac-one (intern_trivial_int 4))
        (lwo-field (list (lwtpw-option-a))) (lwo-none)
        (intern_trivial_int 6) (lwtpw-evidence-a)))
(defn lwtpw-mismatch (prediction)
    (lwtp-observation (lwtpw-prediction-candidate prediction)
        (intern_trivial_int 3) (oac-zero)
        (lwo-field (list (intern_trivial_int 3)))
        (lwlc-unknown (lwtpw-unknown-a)) (lwo-none)
        (lwtpw-evidence-b)))
(defn lwtpw-observation-world (prediction observation)
    (lwt-receive-stream
        (lwt-round-world (lwtpw-prediction-round prediction))
        (list (lwtpw-entry-v observation) (lwtpw-entry-w observation))))

; children: integrated round, exact experience candidate/proposal/observation
(defn lwtpw-experience-fixture (round candidate proposal observation)
    (intern_node LWTPW-EXPERIENCE-FIXTURE
        (list round candidate proposal observation)))
(defn lwtpw-experience-round (fixture) (nth (node_children fixture) 0))
(defn lwtpw-experience-candidate (fixture) (nth (node_children fixture) 1))
(defn lwtpw-experience-proposal-cell (fixture) (nth (node_children fixture) 2))
(defn lwtpw-experience-observation (fixture) (nth (node_children fixture) 3))
(defn lwtpw-integrate-experience (prediction observation)
    (do
        (let world (lwtpw-observation-world prediction observation))
        (let proposal (lwtp-experience-proposal world observation 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let round
            (lwt-round world (lwo-field (list proposal))
                (lwo-empty-field) (lwtpw-prediction-round prediction)))
        (let answered
            (lwt-round-receive round
                (lwtpw-response-entries proposal)))
        (let integrated
            (lwtp-experience-integrate answered proposal (lwigw-action)))
        (lwtpw-experience-fixture
            integrated candidate proposal observation)))
(defn lwtpw-confirmed-a (prediction)
    (lwtpw-integrate-experience prediction (lwtpw-confirmation prediction)))
(defn lwtpw-diverged-b (prediction)
    (lwtpw-integrate-experience prediction (lwtpw-mismatch prediction)))

(defn lwtpw-next-a (base initial experience)
    (lwtpw-integrate-prediction
        (lwt-round-world (lwtpw-experience-round experience))
        (lwtpw-base-tissue base) (lwtpw-prediction-target initial) 2
        (intern_trivial_int 7) (lwtpw-experience-round experience)))
(defn lwtpw-next-b (base initial experience)
    (lwtpw-integrate-prediction
        (lwt-round-world (lwtpw-experience-round experience))
        (lwtpw-base-tissue base) (lwtpw-prediction-target initial) 2
        (lwo-none) (lwtpw-experience-round experience)))
(defn lwtpw-revoke-v-observation (world observation)
    (lwt-receive-stream world
        (list
            (lwtpw-entry-v
                (lwo-revocation observation (lwtpw-source-v)
                    (lwtpw-reason) (lwtpw-prov-v))))))

0
