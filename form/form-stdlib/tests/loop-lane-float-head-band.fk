; loop-lane-float-head-band.fk — a float rides up out of a list head, and a float loop over a float list crystallizes.
;
; The float read side of the list door. A list head is a word of a kind the leaf cannot know (typefall); until now it
; was taken only for an int, so a loop folding floats out of a list fell to the walker. Now, where a head meets a float
; -- the other side of an add, a compare -- it is narrowed to a double: a local float box (v <= fk_fbase-3, its index
; in the process's float pool), the double loaded from the pool; any other word (an int, a field float) leaves for the
; overflow block and the walker answers. So a monomorphic float loop over a list of floats runs native, and a mixed
; list falls through, exactly, to the walker.
;
; Verdict 31
; PROOF LEVEL: FOURTH-ARM ONLY (the transparent lanes are fkwu's MAP_JIT arm64 door; a defn's native state is the 8th field of its hot row)
; preludes: form-stdlib/core.fk
;
;   1   a float sum over a hundred floats crystallizes (state 2) and answers as its walker twin
;   2   an int element among the floats leaves for the walker, byte-equal (the head is no float box)
;   4   a float compared out of a head crystallizes: the largest of a float list, as the walker finds it
;   8   the empty list answers the init, and a one-element list its one float
;   16  the warm sum is under the walker twin's run of the same work
(do
    (defn lfh-bit (ok bit) (if ok bit 0))
    (defn lfh-state (name rows) (if (eq (len rows) 0) -99 (if (str_eq (nth (head rows) 1) name) (nth (head rows) 7) (lfh-state name (tail rows)))))
    (defn lfh-native (name) (lfh-state name (kernel_page_hot (host_pid) 240)))
    (defn lfh-lt? (a b) (if (lt (host_monotonic_ms) 0) false (lt a b))) ; a host clock: a door the lanes decline by meaning, so the twins walk
    (defn lfh-mkf (n acc) (if (le n 0) acc (lfh-mkf (sub n 1) (cons (mul n 0.5) acc))))
    (let xs (lfh-mkf 100 (list)))
    ; 1: the float sum
    (defn lfh-sum (xs acc) (if (nil? xs) acc (lfh-sum (tail xs) (add acc (head xs)))))
    (defn lfh-sum-walk (xs acc) (if (lfh-lt? 0 (len xs)) (lfh-sum-walk (tail xs) (add acc (head xs))) acc))
    (defn lfh-h1 (xs n acc) (if (lfh-lt? 0 n) (lfh-h1 xs (sub n 1) (add acc (lfh-sum xs 0.0))) acc))
    (let h1 (lfh-h1 xs 1100 0.0))
    (let sum-state (lfh-native "lfh-sum"))
    (let sum-ok (if (eq (lfh-sum xs 0.0) (lfh-sum-walk xs 0.0)) (eq (lfh-sum xs 0.0) 2525.0) false))
    ; 2: an int element among the floats
    (let ys (cons 1 (cons 2.5 (cons 3.0 (list)))))
    (let mix-ok (eq (lfh-sum ys 0.0) (lfh-sum-walk ys 0.0)))
    ; 4: the largest of a float list, a float compared out of a head
    (defn lfh-max (xs acc) (if (nil? xs) acc (lfh-max (tail xs) (if (lt acc (head xs)) (head xs) acc))))
    (defn lfh-max-walk (xs acc) (if (lfh-lt? 0 (len xs)) (lfh-max-walk (tail xs) (if (lt acc (head xs)) (head xs) acc)) acc))
    (defn lfh-h4 (xs n acc) (if (lfh-lt? 0 n) (lfh-h4 xs (sub n 1) (add acc (lfh-max xs 0.0))) acc))
    (let h4 (lfh-h4 xs 1100 0.0))
    (let max-state (lfh-native "lfh-max"))
    (let max-ok (if (eq (lfh-max xs 0.0) (lfh-max-walk xs 0.0)) (eq (lfh-max xs 0.0) 50.0) false))
    ; 8: edges
    (let edge-ok (if (eq (lfh-sum (list) 7.5) 7.5) (eq (lfh-sum (cons 4.25 (list)) 0.0) 4.25) false))
    ; 16: the warm sum against the twin's
    (defn lfh-rep (xs n acc) (if (le n 0) acc (lfh-rep xs (sub n 1) (add acc (lfh-sum xs 0.0)))))
    (defn lfh-rep-walk (xs n acc) (if (lfh-lt? 0 n) (lfh-rep-walk xs (sub n 1) (add acc (lfh-sum-walk xs 0.0))) acc))
    (let w0 (host_monotonic_ms)) (let warm (lfh-rep xs 5000 0.0)) (let w1 (host_monotonic_ms))
    (let k0 (host_monotonic_ms)) (let cold (lfh-rep-walk xs 5000 0.0)) (let k1 (host_monotonic_ms))
    (let told (print (list "states" sum-state max-state "sum" sum-ok "mix" mix-ok "max" max-ok "edge" edge-ok "ms" (sub w1 w0) (sub k1 k0))))
    (let b1 (lfh-bit (if (eq sum-state 2) sum-ok false) 1))
    (let b2 (lfh-bit mix-ok 2))
    (let b3 (lfh-bit (if (eq max-state 2) max-ok false) 4))
    (let b4 (lfh-bit edge-ok 8))
    (let b5 (lfh-bit (if (eq warm cold) (lt (sub w1 w0) (sub k1 k0)) false) 16))
    (add b1 (add b2 (add b3 (add b4 b5)))))
