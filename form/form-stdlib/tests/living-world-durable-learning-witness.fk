; living-world-durable-learning-witness.fk -- a prediction crosses a process,
; meets a new independent observation, and returns as an optional successor.
;
; Fixture vocabulary and the observed value live here, outside the organs.
; Continuation functions consume the exact loaded world: only the seed writer
; constructs the historical execution.  Restore, learning, and adoption each
; enumerate the proposal's own participant field; a response is represented as
; a fresh explicit offer by that source, never inferred by the body.
; witnessed: 2026-08-08 -> 31/65535/65535/65535 across fresh fkwu processes
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk

(let LWDLW-SOURCE-CUSTODIAN   (bp "LWDLW-SOURCE-CUSTODIAN"))
(let LWDLW-PROV-CUSTODIAN     (bp "LWDLW-PROV-CUSTODIAN"))
(let LWDLW-CONSENT-PROVENANCE (bp "LWDLW-CONSENT-PROVENANCE"))

(defn lwdlw-cell (kind) (intern_node kind (empty)))
(defn lwdlw-source-custodian () (lwdlw-cell LWDLW-SOURCE-CUSTODIAN))
(defn lwdlw-prov-custodian () (lwdlw-cell LWDLW-PROV-CUSTODIAN))

(defn lwdlw-before-path ()
    "/tmp/coherence-living-world-durable-learning-before-v1.ccs")
(defn lwdlw-after-path ()
    "/tmp/coherence-living-world-durable-learning-after-v1.ccs")
(defn lwdlw-final-path ()
    "/tmp/coherence-living-world-durable-learning-final-v1.ccs")

(defn lwdlw-entry-for (source provenance payload)
    (lwacw-entry-for source provenance payload))

; The provenance is content-addressed by this exact proposal and source.  The
; fixture still has to offer each response into the current admission world.
(defn lwdlw-consent-provenance (proposal source)
    (intern_node LWDLW-CONSENT-PROVENANCE
        (list proposal source (lwo-local-path))))

(defn lwdlw-response-entry (proposal source)
    (do
        (let provenance (lwdlw-consent-provenance proposal source))
        (lwdlw-entry-for source provenance
            (lwt-response proposal (oac-one proposal) provenance))))

(defn lwdlw-response-entries-items (proposal items)
    (if (eq (len items) 0) (list)
        (cons (lwdlw-response-entry proposal (head items))
            (lwdlw-response-entries-items proposal (tail items)))))

(defn lwdlw-response-entries (proposal)
    (lwdlw-response-entries-items proposal
        (lwo-field-items (lwt-proposal-participants proposal))))

(defn lwdlw-answered-round (world proposal previous)
    (lwt-round-receive
        (lwt-round world (lwo-field (list proposal))
            (lwo-empty-field) previous)
        (lwdlw-response-entries proposal)))

; A loaded image first exists only in this empty admission world.  Its active
; historical sources must each offer a response before the stored world is
; returned as a successor.
(defn lwdlw-admission-world (image)
    (lwt-receive-stream (lwo-empty-world)
        (list
            (lwdlw-entry-for
                (lwdlw-source-custodian) (lwdlw-prov-custodian) image))))

(defn lwdlw-restored-round (image)
    (do
        (let admission (lwdlw-admission-world image))
        (let proposal (lwcn-restore-proposal admission image))
        (let answered
            (lwdlw-answered-round admission proposal (lwo-none)))
        (lwcn-integrate-restore answered proposal (lwrew-action))))

(defn lwdlw-restored-world (image)
    (lwt-round-world (lwdlw-restored-round image)))

(defn lwdlw-current-executions-items (world items field)
    (if (eq (len items) 0) field
        (do
            (let candidate (head items))
            (lwdlw-current-executions-items world (tail items)
                (if (eq (lwac-execution-integrated-current?
                            world candidate) 1)
                    (lwo-field-add field candidate) field)))))

(defn lwdlw-current-executions (world)
    (lwdlw-current-executions-items world
        (lwo-field-items (lwo-world-cells world)) (lwo-empty-field)))

(defn lwdlw-current-selections-items (world items field)
    (if (eq (len items) 0) field
        (do
            (let candidate (head items))
            (lwdlw-current-selections-items world (tail items)
                (if (eq (lwac-selection-integrated-current?
                            world candidate) 1)
                    (lwo-field-add field candidate) field)))))

(defn lwdlw-current-selections (world)
    (lwdlw-current-selections-items world
        (lwo-field-items (lwo-world-cells world)) (lwo-empty-field)))

(defn lwdlw-active-learning-items (world items field)
    (if (eq (len items) 0) field
        (do
            (let candidate (head items))
            (lwdlw-active-learning-items world (tail items)
                (if (and (eq (lwac-learning-candidate? candidate) 1)
                         (eq (lwo-active? world candidate) 1))
                    (lwo-field-add field candidate) field)))))

(defn lwdlw-active-learning (world)
    (lwdlw-active-learning-items world
        (lwo-field-items (lwo-world-cells world)) (lwo-empty-field)))

(defn lwdlw-current-learning-items (world items threshold field)
    (if (eq (len items) 0) field
        (do
            (let candidate (head items))
            (lwdlw-current-learning-items world (tail items) threshold
                (if (eq (lwac-learning-integrated-current?
                            world candidate threshold) 1)
                    (lwo-field-add field candidate) field)))))

(defn lwdlw-current-learning (world threshold)
    (lwdlw-current-learning-items world
        (lwo-field-items (lwo-world-cells world)) threshold
        (lwo-empty-field)))

; The learner may become stale when its proposed successor is actually
; re-offered.  Adoption therefore follows the active offer's exact evidence
; link back to that retained learning cell; it never regenerates the offer
; from a stale proposal or guesses the proposed value.
(defn lwdlw-successor-offers-items (world items learning field)
    (if (eq (len items) 0) field
        (do
            (let offer (head items))
            (lwdlw-successor-offers-items world (tail items) learning
                (if (and (eq (lwac-offer? offer) 1)
                         (and (eq (lwo-active? world offer) 1)
                              (node_eq (lwac-offer-evidence offer)
                                       learning)))
                    (lwo-field-add field offer) field)))))

(defn lwdlw-successor-offers (world learning)
    (lwdlw-successor-offers-items world
        (lwo-field-items (lwo-world-cells world)) learning
        (lwo-empty-field)))

(defn lwdlw-only (field)
    (if (eq (lwo-field-size field) 1)
        (head (lwo-field-items field)) (lwo-none)))

; This observation did not exist in the seed image.  Its alternatives,
; unknowable remainder, and timeout evidence are optional independent fields.
(defn lwdlw-observation-for (execution)
    (lwac-observation execution
        (lwacw-actual-delta) (oac-one (lwacw-actual-delta))
        (lwo-field (list (lwacw-action-b)))
        (lwlc-unknown (lwacw-evidence))
        (oac-timeout-condense
            (lwacw-timeout) (intern_trivial_int 5))
        (lwacw-evidence)))

(defn lwdlw-observed-world (world execution)
    (do
        (let observation (lwdlw-observation-for execution))
        (lwt-receive-stream world
            (list
                (lwacw-entry-h observation)
                (lwacw-entry-i observation)))))

(defn lwdlw-learning-round (world execution previous)
    (do
        (let observation (lwdlw-observation-for execution))
        (let observed (lwdlw-observed-world world execution))
        (let proposal (lwac-learning-proposal observed observation 2))
        (let answered (lwdlw-answered-round observed proposal previous))
        (lwac-learning-integrate answered proposal (lwrew-action))))

(defn lwdlw-two-predictions-world (world learning)
    (do
        (let successor (lwac-successor-offer world learning 2))
        (lwt-receive-stream world
            (list
                (lwacw-entry-c successor)
                (lwacw-entry-d successor)))))

(defn lwdlw-successor-reoffered? (world successor)
    (if (and (eq (lwac-offer? successor) 1)
             (and (eq (lwo-active-by? world successor
                        (lwacw-source-c)) 1)
                  (eq (lwo-active-by? world successor
                        (lwacw-source-d)) 1))) 1 0))

(defn lwdlw-revised-world (world successor)
    (if (eq (lwdlw-successor-reoffered? world successor) 1)
        (lwacw-revoked-old-world world) world))

(defn lwdlw-selection-round (world previous)
    (do
        (let proposal (lwacw-selection-proposal-for world))
        (let answered (lwdlw-answered-round world proposal previous))
        (lwac-selection-integrate answered proposal (lwrew-action))))

(defn lwdlw-execution-round (world selection previous)
    (do
        (let proposal
            (lwacw-execution-proposal-for world selection
                (intern_trivial_int 5)))
        (let answered (lwdlw-answered-round world proposal previous))
        (lwac-execution-integrate answered proposal (lwrew-action))))

(defn lwdlw-adopted-round (world successor previous)
    (do
        (let revised (lwdlw-revised-world world successor))
        (let selection-proposal (lwacw-selection-proposal-for revised))
        (let selection (lwt-proposal-candidate selection-proposal))
        (let selected (lwdlw-selection-round revised previous))
        (lwdlw-execution-round
            (lwt-round-world selected) selection selected)))

(defn lwdlw-save-image (path world)
    (lwcd-save-new path (lwcn-image world) (lwo-none)))

(defn lwdlw-load-image (path)
    (lwcd-load path (lwo-none)))

(defn lwdlw-remove-path (path)
    (if (eq (fs-exists? path) 1) (fs-remove-file path) 0))

(defn lwdlw-clean ()
    (do
        (lwdlw-remove-path (lwdlw-before-path))
        (lwdlw-remove-path (lwcd-pending-path (lwdlw-before-path)))
        (lwdlw-remove-path (lwdlw-after-path))
        (lwdlw-remove-path (lwcd-pending-path (lwdlw-after-path)))
        (lwdlw-remove-path (lwdlw-final-path))
        (lwdlw-remove-path (lwcd-pending-path (lwdlw-final-path)))))

(defn lwdlw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwdlw-sum (tail items)))))
