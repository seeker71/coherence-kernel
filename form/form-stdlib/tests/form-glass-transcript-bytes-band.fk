; Pure byte-buffer transcript contract; verdict 1023. No live publication.
; preludes: form/form-stdlib/form-glass-meaning-ui.bml
(do
  (defn gtbb-text (lines) (if (eq (len lines) 0) "" (str_concat (ftc-text-as-string (ftc-segment-text (head (head lines)))) (gtbb-text (tail lines)))))
  (defn gtbb-bit (ok bit) (if ok bit 0))
  (let controls (str_concat "a\n\t" (str_concat (byte_to_str 27) (str_concat (byte_to_str 127) "z"))))
  (let cleaned (fglm-wrap controls 80 "fixture" "declared" 4))
  (let unicode (fglm-wrap "در 日本語" 4 "fixture" "declared" 8))
  (let clipped (fglm-wrap "abcdefghijk" 3 "fixture" "declared" 2))
  (let stable (fglm-wrap "unchanged" 80 "fixture" "declared" 4))
  (print (sum (list
    (gtbb-bit (str_eq (gtbb-text cleaned) "a    z") 1)
    (gtbb-bit (eq (ftc-byte-text? (ftc-segment-text (head (head cleaned)))) 1) 2)
    (gtbb-bit (str_eq (gtbb-text unicode) "در 日本語") 4)
    (gtbb-bit (and (eq (len clipped) 3) (str_eq (gtbb-text clipped) "abcdef[co")) 8)
    (gtbb-bit (eq (len (fglm-wrap "abc" 0 "fixture" "declared" 4)) 0) 16)
    (gtbb-bit (eq (len (fglm-wrap "abc" 3 "fixture" "declared" 0)) 0) 32)
    (gtbb-bit (eq (len (fglm-wrap "" 3 "fixture" "declared" 4)) 0) 64)
    (gtbb-bit (eq (len (fglm-wrap "日" 2 "fixture" "declared" 4)) 0) 128)
    (gtbb-bit (eq (len (ftcb-screen-diff stable (fglm-wrap "unchanged" 80 "fixture" "declared" 4))) 0) 256)
    (gtbb-bit (and (str_eq (ftc-segment-node-id (head (head stable))) "fixture") (str_eq (ftc-segment-evidence (head (head stable))) "declared")) 512)
  )))
)
