; Deliberate failing child for native-wav-band; never run as a standalone band.
; preflight-exec: forbidden
; preludes: form-stdlib/native-wav.bml
(do (let path (read_line)) (let mode (read_line)) (let wav (nwa-open path))
 (if (str_eq mode "level") (nwa-level wav) 0)
 (nwa-close wav)
 (form_error "invalid audio unexpectedly admitted"))
