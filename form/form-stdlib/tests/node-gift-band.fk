; node-gift-band.fk — cells cross a gift frame as themselves: blueprint and children, read by intern.
;
; node_gift_write handle value / node_gift_read handle carry the whole value
; universe -- ints, floats, strings, nothing, lists, trivial nodes, composite
; nodes, NodeIDs -- and a composite node comes back as the SAME cell: the
; reader interns the same category over the same children and axiom 3 gives
; it the same identity (node_eq). No wire text, no parser.
; Expected: 4095
; preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk

(do
    (defn ngb-bit (ok bit) (if ok bit 0))
    (let h (shm_offer "/fk-node-gift-band" 65536))

    ; scalars
    (let s1 (node_gift_write h 42)) (let b1 (ngb-bit (eq (node_gift_read h) 42) 1))
    (let s2 (node_gift_write h "a gift of text")) (let b2 (ngb-bit (str_eq (node_gift_read h) "a gift of text") 2))
    (let s3 (node_gift_write h 2.5)) (let b3 (ngb-bit (eq (node_gift_read h) 2.5) 4))
    (let s4 (node_gift_write h (nothing))) (let b4 (ngb-bit (nothing? (node_gift_read h)) 8))

    ; lists, nested, mixed
    (let xs (list 1 "two" (list 3 4.5 (list)) (nothing) 6))
    (let s5 (node_gift_write h xs)) (let back (node_gift_read h))
    (let b5 (ngb-bit (and (eq (len back) 5) (and (str_eq (nth back 1) "two") (and (eq (len (nth back 2)) 3) (and (nothing? (nth back 3)) (eq (nth back 4) 6))))) 16))
    (let b6 (ngb-bit (and (eq (nth (nth back 2) 0) 3) (eq (nth (nth back 2) 1) 4.5)) 32))

    ; trivial nodes keep their identity
    (let ti (intern_trivial_int 7)) (let s7 (node_gift_write h ti))
    (let b7 (ngb-bit (eq (node_eq (node_gift_read h) ti) 1) 64))
    (let ts (intern_trivial_string "seven")) (let s8 (node_gift_write h ts))
    (let b8 (ngb-bit (eq (node_eq (node_gift_read h) ts) 1) 128))

    ; a composite cell -- blueprint category over children -- comes back as the same cell
    (let cell (intern_node (bp "CHANNEL-V0") (list (intern_trivial_string "glass.monitor") (intern_trivial_int 5) (intern_trivial_string "events"))))
    (let s9 (node_gift_write h cell)) (let cellBack (node_gift_read h))
    (let b9 (ngb-bit (eq (node_eq cellBack cell) 1) 256))
    (let b10 (ngb-bit (and (eq (node_eq (node_category cellBack) (bp "CHANNEL-V0")) 1) (eq (node_inst cellBack) (node_inst cell))) 512))

    ; a NodeID coordinate crosses as itself
    (let nid (make_nodeid 1 2 99 1700)) (let s11 (node_gift_write h nid))
    (let b11 (ngb-bit (and (eq (node_eq (node_gift_read h) nid) 1) (eq (node_inst (node_gift_read h)) 1700)) 1024))

    ; a CHILD PROCESS reads the cell the parent gave -- shared memory, no text between them
    (let s12 (node_gift_write h cell))
    (let child (host-exec "./fkwu form/form-stdlib/tests/node-gift-child.fk 2>/dev/null" ""))
    (let b12 (ngb-bit (and (not (nothing? child)) (ge (str_find child "same-category-across-processes" 0) 0)) 2048))
    (let rel (shm_release h))

    (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 (add b9 (add b10 (add b11 b12))))))))))))
