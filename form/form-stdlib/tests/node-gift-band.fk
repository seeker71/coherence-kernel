; node-gift-band.fk — owned shared roots, identity, retention and retirement.
;
; node_gift_write handle value / node_gift_read handle carry the whole value
; universe -- ints, floats, strings, nothing, lists, trivial nodes, composite
; nodes, NodeIDs -- and a composite node comes back as the SAME cell: the
; reader adopts the actual shared root; ggf-cell reads its first child.
; Replaced generations stay held through descendants and retire after GC.
; Verdict 4095
; REQUIRES: the node gift doors (shm_offer)
; preludes: form-stdlib/form-glass-gift-frame.bml form-stdlib/core.fk form-stdlib/form-ontology-bp.fk

(do
    (defn ngb-bit (ok bit) (if ok bit 0))
    (defn ngb-check (ok why) (if ok 0 (form_error why)))
    (defn ngb-churn (n acc) (if (le n 0) acc (ngb-churn (sub n 1) (cons n acc))))
    (defn ngb-melt-until (before) (if (gt (kernel_stat 69) before) 0 (do (let waste (ngb-churn 4096 (list))) (let counted (len waste)) (ngb-melt-until before))))
    (defn ngb-held (h) (do
        (let given (node_gift_write h (list "held" (list 8 "descendant"))))
        (let root (ggf-root h))
        (let checked (ngb-check (and (eq (str_len (shm_read h)) 64) (nothing? (cell_ref root))) "native reference shape or unversioned export"))
        (nth (ggf-root-cell root) 1)))
    (defn ngb-replace (h n) (if (le n 0) 0 (do (let given (node_gift_write h (list "next" n))) (ngb-replace h (sub n 1)))))
    (defn ngb-promoted (h) (do
        (let given (node_gift_write h (cons "head" "tail")))
        (let root (ggf-root h))
        (let kept (intern_node (intern_trivial_string "owned-dotted-tail") (ggf-root-cell root)))
        (let retired (ggf-retire h root)) kept))
    (let h (shm_offer "/fk-node-gift-band" (list 65536)))

    ; scalars
    (let s1 (node_gift_write h 42)) (let b1 (ngb-bit (eq (ggf-cell h) 42) 1))
    (let s2 (node_gift_write h "a gift of text")) (let b2 (ngb-bit (str_eq (ggf-cell h) "a gift of text") 2))
    (let s3 (node_gift_write h 2.5)) (let b3 (ngb-bit (eq (ggf-cell h) 2.5) 4))
    (let s4 (node_gift_write h (nothing))) (let b4 (ngb-bit (nothing? (ggf-cell h)) 8))

    ; lists, nested, mixed
    (let xs (list 1 "two" (list 3 4.5 (list)) (nothing) 6))
    (let s5 (node_gift_write h xs)) (let back (ggf-cell h))
    (let b5 (ngb-bit (and (eq (len back) 5) (and (str_eq (nth back 1) "two") (and (eq (len (nth back 2)) 3) (and (nothing? (nth back 3)) (eq (nth back 4) 6))))) 16))
    (let b6 (ngb-bit (and (eq (nth (nth back 2) 0) 3) (eq (nth (nth back 2) 1) 4.5)) 32))

    ; trivial nodes keep their identity
    (let ti (intern_trivial_int 7)) (let s7 (node_gift_write h ti))
    (let b7 (ngb-bit (eq (node_eq (ggf-cell h) ti) 1) 64))
    (let ts (intern_trivial_string "seven")) (let s8 (node_gift_write h ts))
    (let b8 (ngb-bit (eq (node_eq (ggf-cell h) ts) 1) 128))

    ; a composite cell -- blueprint category over children -- comes back as the same cell
    (let cell (intern_node (bp "CHANNEL-V0") (list (intern_trivial_string "glass.monitor") (intern_trivial_int 5) (intern_trivial_string "events"))))
    (let s9 (node_gift_write h cell)) (let cellBack (ggf-cell h))
    (let b9 (ngb-bit (eq (node_eq cellBack cell) 1) 256))
    (let b10 (ngb-bit (and (eq (node_eq (node_category cellBack) (bp "CHANNEL-V0")) 1) (eq (node_inst cellBack) (node_inst cell))) 512))

    ; a NodeID coordinate crosses as itself
    (let nid (make_nodeid 1 2 99 1700)) (let s11 (node_gift_write h nid))
    (let b11 (ngb-bit (and (eq (node_eq (ggf-cell h) nid) 1) (eq (node_inst (ggf-cell h)) 1700)) 1024))

    ; a CHILD PROCESS reads the cell the parent gave -- shared memory, no text between them
    (let s12 (node_gift_write h cell))
    (let child (host-exec "./fkwu form/form-stdlib/tests/node-gift-child.fk 2>/dev/null" ""))
    (let b12 (ngb-bit (and (not (nothing? child)) (ge (str_find child "same-category-across-processes" 0) 0)) 2048))
    ; Native reader holds, full IDs, reuse and late retirement.
    (let held (ngb-held h))
    (let replacements (ngb-replace h 64))
    (let collected (ngb-melt-until (kernel_stat 69)))
    (let descendant (ngb-check (and (eq (head held) 8) (str_eq (nth held 1) "descendant")) "held descendant retired before its reader"))
    (let old (ggf-root h))
    (let original-id (ggf-root-id old))
    (let resolved (node_at original-id))
    (let same (ngb-check (value_eq (ggf-root-id resolved) original-id) "shared node ID did not resolve"))
    (let replaced (node_gift_write h (list "replacement" 65)))
    (let late (ngb-check (nothing? (ggf-retire h old)) "late retirement withdrew a replacement"))
    (let retired-id (ngb-check (nothing? (node_at original-id)) "retired node ID resolved as current"))
    (let promoted (ngb-promoted h))
    (let more (ngb-replace h 8))
    (let collected-again (ngb-melt-until (kernel_stat 69)))
    (let tail-kept (ngb-check (value_eq (node_children promoted) (cons "head" "tail")) "permanent promotion lost its dotted tail"))
    (let reused (ngb-check (gt (kernel_stat 85) 0) "retired native storage was not reused"))
    (let last (ggf-root h))
    (let retired (ggf-retire h last))
    (let gone (ngb-check (nothing? (ggf-root h)) "retired frame still offers a root"))
    (let rel (shm_release h))

    (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 (add b9 (add b10 (add b11 b12))))))))))))
