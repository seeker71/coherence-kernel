(let LWRHA-ATTESTATION-FIRST (lwrhw-attestation-first))
(let LWRHA-ATTESTATION-SECOND (lwrhw-attestation-second))
(let LWRHA-OBSERVATION-FIRST
    (lwrh-derived-observation LWRHA-ATTESTATION-FIRST))
(let LWRHA-OBSERVATION-SECOND
    (lwrh-derived-observation LWRHA-ATTESTATION-SECOND))

(defn lwrha-one-world-build ()
    (lwt-receive-stream (lwrhw-integrated-world)
        (list
            (lwrhw-entry-h LWRHA-ATTESTATION-FIRST)
            (lwrhw-entry-h LWRHA-ATTESTATION-SECOND)
            (lwrhw-entry-h LWRHA-OBSERVATION-FIRST)
            (lwrhw-entry-h LWRHA-OBSERVATION-SECOND))))
(let LWRHA-ONE-WORLD (lwrha-one-world-build))
(defn lwrha-one-world () LWRHA-ONE-WORLD)

(defn lwrha-world-build ()
    (lwt-receive-stream LWRHA-ONE-WORLD
        (list
            (lwrhw-entry-i LWRHA-ATTESTATION-FIRST)
            (lwrhw-entry-i LWRHA-ATTESTATION-SECOND)
            (lwrhw-entry-i LWRHA-OBSERVATION-FIRST)
            (lwrhw-entry-i LWRHA-OBSERVATION-SECOND))))
(let LWRHA-WORLD (lwrha-world-build))
(defn lwrha-world () LWRHA-WORLD)
