; membrane-sites-band.fk — the static census of host-exec membrane crossings, held on synthetic truth first, then on the real tree's structure.
;
; A made-up source stands in for the tree: a direct host-exec of a three-command pipeline, a wrapper of a wrapper, a computed command,
; an argv literal, a ./fkwu child spawned through a shell string and through an argv, a commented-out call and a prose mention (neither
; may count). Each site has the verdict the table gives it. The real tree is read last and only its STRUCTURE is pinned (no site counts:
; they must fall as migrations land).
;
; Expected: 8191
; Verdict 8191 when every claim lands:
;   1     pipeline: `ps -axo .. | grep fkwu | head -3` is one site with three words (ps grep head), route line, kind prim
;   2     wrappers: a call of a wrapper of a wrapper reads through to the command: chain w2>w1>host-exec, words sleep and date (&&); the
;         wrappers found include w1, w2 and the pass-through d (a thin def that runs a command of its own is a wrapper too)
;   4     computed: a command built by a call the reading cannot see is computed (word <unknown>), its verdict is computed
;   8     argv: a host_spawn_at argv literal reads its first element (cp), route argv; cp is a door when read_file_slice and write_file
;         stand in the optable text and door-planned when they do not
;   16    self: ./fkwu spawned through an argv is self and not via a shell; the same through a shell string is self-via-shell
;   32    not counted: a commented-out call and a string that mentions host-exec and grep in prose add no site (seven sites in all); a
;         plain substring count of the source reads more
;   64    pass-through: the defs that hand a command on (w1, w2, d) hold rows of kind pass, counted nowhere
;   128   partial: `"echo " ++ x` through a let reads echo, partial, a builtin
;   256   verdict table: sed is internal-tool, grep internal-tool (the catalog's sixteenth tool landed), git exception-git, perl forbidden, an unheard-of word unknown,
;         sh inside the token verbs shell-by-design and elsewhere shell; the worst word is the site's verdict
;   512   class and refinement: a path under /tests/ is fixture, spawn-guard.bml is guard; `ln -s` reads as ln -s and `mkdir -m` as mkdir -m
;   1024  tree walk: the real tree lists observe/membrane-sites-run.bml, sorted, and no file under receipts/ docs/ or .hearth
;   2048  real tree, structure: every counted site has words or is computed, every verdict is one the table names, the wrapper list is a
;         list of names and the ambiguous list is a list; the unknown words are listed from the same rows
;   4096  plant: with the comment test off the synthetic source reads more sites than seven (the live test is what holds claim 32)
;
; REQUIRES: the body root as the working directory (claims 1024 and 2048 read the tree) and runtime/fkwu-optable.h.
// preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/bml/live.bml form-stdlib/bml/membrane-sites.bml
section [form.bml] {
 class MembraneSitesBand {
  def msb-src() = "class X {\n"
   ++ " def w1(c) = host-exec(c, \"\");\n"
   ++ " def w2(c2) = w1(c2);\n"
   ++ " def d(t) = host-exec(t ++ \" --flag\", \"\");\n"
   ++ " def a() = host-exec(\"ps -axo pid= | grep fkwu | head -3\", \"\");\n"
   ++ " def b() = w2(\"sleep 1 && date\");\n"
   ++ " def c(x) {\n  let cmd = \"echo \" ++ x;\n  host-exec(cmd, \"\");\n }\n"
   ++ " def e() = host-exec(build-it(), \"\");\n"
   ++ " def f() = host_spawn_at([\"/bin/cp\", \"a\", \"b\"], [\"/dev/null\"]);\n"
   ++ " def g() = host_spawn_at([\"./fkwu\", \"x.bml\"], [\"/dev/null\"]);\n"
   ++ " def h() = host-exec(\"./fkwu x.bml 2>&1\", \"\");\n"
   ++ " // host-exec(\"sed p f\", \"\")\n"
   ++ " def i() = \"prose that mentions host-exec(x) and grep\";\n"
   ++ "}\n";
  def msb-srcs() = [["syn/a.bml", msb-src()]];
  def msb-census() = mbs-census(msb-srcs());
  def msb-counted() = mbs-counted(msb-census()[0]);
  def msb-site-in(def-name) = foldl((acc, s) => (String) s[3] == def-name && s[10] == 0 ? s : acc, nothing(), msb-census()[0]);
  def msb-optable() = "\"host_processes\" \"host_alive\" \"host_process\" \"host_sleep_ms\" \"fs_list\" \"read_file_slice\" \"write_file\"";
  def msb-words?(s, ws) = !nothing?(s) && len(s[6]) == len(ws) && (String) mbs-join(s[6], ",") == mbs-join(ws, ",");
  // ---- 1 pipeline
  def msb-c-pipeline(ctx) {
   let s = msb-site-in("a");
   msb-words?(s, ["ps", "grep", "head"]) && (String) s[5] == "line" && (String) s[2] == "prim";
  }
  // ---- 2 wrapper chain
  def msb-c-wrappers(ctx) {
   let s = msb-site-in("b");
   let ws = msb-census()[1];
   !nothing?(s) && (String) s[4] == "w2>w1>host-exec" && msb-words?(s, ["sleep", "date"]) && (String) s[2] == "call" && mbs-has?(ws, "w1") && mbs-has?(ws, "w2") && mbs-has?(ws, "d");
  }
  // ---- 4 computed
  def msb-c-computed(ctx) {
   let s = msb-site-in("e");
   !nothing?(s) && s[7] == 1 && (String) mbs-site-verdict(s, msb-optable()) == "computed";
  }
  // ---- 8 argv
  def msb-c-argv(ctx) {
   let s = msb-site-in("f");
   msb-words?(s, ["cp"]) && (String) s[5] == "argv" && (String) mbs-site-verdict(s, msb-optable()) == "door" && (String) mbs-site-verdict(s, "\"write_file\"") == "door-planned";
  }
  // ---- 16 self
  def msb-c-self(ctx) {
   let g = msb-site-in("g");
   let h = msb-site-in("h");
   msb-words?(g, ["fkwu"]) && msb-words?(h, ["fkwu"]) && !mbs-self-via-shell?(g) && mbs-self-via-shell?(h) && (String) mbs-site-verdict(g, msb-optable()) == "self" && (String) mbs-site-verdict(h, msb-optable()) == "self";
  }
  // ---- 32 not counted
  def msb-c-uncounted(ctx) = len(msb-counted()) == 7 && len(filter(s => (String) s[3] == "i", msb-census()[0])) == 0 && mbs-count-substr(msb-src(), "host-exec(") > 7;
  // ---- 64 pass-through
  def msb-c-pass(ctx) {
   let rows = filter(s => s[10] == 1, msb-census()[0]);
   len(rows) == 3 && len(msb-counted()) == len(msb-census()[0]) - 3;
  }
  // ---- 128 partial
  def msb-c-partial(ctx) {
   let s = msb-site-in("c");
   msb-words?(s, ["echo"]) && s[8] == 1 && (String) mbs-site-verdict(s, msb-optable()) == "builtin";
  }
  // ---- 256 the table
  def msb-v(w, path) = mbs-word-verdict(w, msb-optable(), path)[0];
  def msb-c-table(ctx) = (String) msb-v("sed", "x.bml") == "internal-tool" && (String) msb-v("grep", "x.bml") == "internal-tool" && (String) msb-v("git", "x.bml") == "exception-git" && (String) msb-v("perl", "x.bml") == "forbidden" && (String) msb-v("zzz-unheard", "x.bml") == "unknown"
   && (String) msb-v("sh", "form/form-stdlib/bml/form-token-verbs.bml") == "shell-by-design" && (String) msb-v("sh", "x.bml") == "shell" && (String) msb-v("date", "x.bml") == "door-planned" && (String) msb-v("sleep", "x.bml") == "door"
   && (String) mbs-worse("door", "internal-tool-pending") == "door" && (String) mbs-worse("unknown", "door") == "unknown";
  // ---- 512 class and refinement
  def msb-c-class(ctx) = (String) mbs-class-of("form/form-stdlib/tests/x-band.bml") == "fixture" && (String) mbs-class-of("form/form-stdlib/bml/spawn-guard.bml") == "guard" && (String) mbs-class-of("observe/x.bml") == "product"
   && (String) mbs-refine("ln", "[\"ln\", \"-s\", a, b]") == "ln -s" && (String) mbs-refine("ln", "[\"ln\", a, b]") == "ln" && (String) mbs-refine("mkdir", "[\"mkdir\", \"-m\", \"700\", d]") == "mkdir -m";
  // ---- 1024 tree walk
  def msb-c-tree(ctx) {
   let paths = map(s => s[0], mbs-tree("."));
   mbs-has?(paths, "observe/membrane-sites-run.bml") && len(filter(p => mbs-starts?(p, "receipts/") || mbs-starts?(p, "docs/") || mbs-starts?(p, ".hearth/"), paths)) == 0 && mbs-sorted?(paths);
  }
  // ---- 2048 the real tree, structure only
  def msb-real(ctx) = ctx[2];
  def msb-c-real(ctx) {
   let c = msb-real(ctx);
   let sites = mbs-counted(c[0]);
   let names = mbs-verdict-names();
   let optable = read_file(mbs-optable-path()) ?? "";
   len(sites) >= 0 && all?(s => (len(s[6]) > 0 || s[7] == 1) && mbs-has?(names, mbs-site-verdict(s, optable)), sites)
   && (String) value_kind(c[1]) == "list" && (String) value_kind(c[2]) == "list" && (String) value_kind(mbs-word-rows(sites, optable)) == "list"
   && all?(r => (String) r[1] == "unknown" || mbs-has?(names, r[1]), mbs-word-rows(sites, optable));
  }
  // ---- 4096 plant: no comment test
  def msb-c-plant(ctx) = mbs-count-substr(msb-src(), "host-exec(") > len(msb-counted());
 }
 let ctx = ["membrane-sites-band", "", mbs-census(mbs-tree("."))];
 live-claims("membrane-sites-band", ctx, [["pipeline", 1, 1, msb-c-pipeline], ["wrappers", 2, 1, msb-c-wrappers], ["computed", 4, 1, msb-c-computed], ["argv", 8, 1, msb-c-argv], ["self", 16, 1, msb-c-self], ["uncounted", 32, 1, msb-c-uncounted], ["pass", 64, 1, msb-c-pass], ["partial", 128, 1, msb-c-partial], ["table", 256, 1, msb-c-table], ["class", 512, 1, msb-c-class], ["tree", 1024, 1, msb-c-tree], ["real", 2048, 1, msb-c-real], ["plant", 4096, 1, msb-c-plant]]);
}
