; qwen4exp-flash-next-acceptance-band.fk — the no-server 90% crossing contract.
;
; preludes: form-stdlib/core.fk form-stdlib/qwen4exp-flash-next-acceptance.bml
;
; Verdict 255: 127 from the executable boundary/current observation; 128 from
; the high-BML authority naming oracle rates, observed rates and ownership.

(do
    (defn q4ab-has (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let base (q4a-check))
    (let src (read_file "form/form-stdlib/bml/qwen4exp-flash-next-acceptance.bml"))
    (let authority
        (if (eq (q4ab-has src "const String Backend = \"form-native-metal-jit\"") 1)
            (if (eq (q4ab-has src "const String ForbiddenRuntime = \"llama-server\"") 1)
                (if (eq (q4ab-has src "const int DecodeFloorTokpsX1000 = 23922") 1)
                    (if (eq (q4ab-has src "const int PrefillFloorTokpsX1000 = 286947") 1)
                        (if (eq (q4ab-has src "const int FormDecodeTokpsX1000 = 12188") 1)
                            (if (eq (q4ab-has src "const int FormSequentialPrefillTokpsX1000 = 12340") 1)
                                128 0) 0) 0) 0) 0) 0))
    (add base authority))
