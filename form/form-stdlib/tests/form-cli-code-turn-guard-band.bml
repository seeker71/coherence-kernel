; form-cli-code-turn-guard-band.bml — the lane reads its own tool turns: the stillstreak window, call repair and the
; counterexample without document identities. No model runs; recorded replies replay through the policy.
;
; REQUIRES: fkwu's shared memory -- fcsw-step speaks the stage bus, which lives there: each stage
; rides as (cons stage key) onto float_leaf 29, a non-list tail. The heal is one language rule for cons onto a non-list.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-code-swerve.bml
;
; The fixtures are option 1's retained replies of closure-unit-line (walk .hearth/code-memory/replies/21393-*):
; reply 1 and 4 are one read (sha256 d7127a2b...), replies 2, 3 and 5 one guarded edit (sha256 99a98cec...), each
; rebuilt here, written through the carrier and read back. Option 1 replayed read A, edit E, edit E, read A, edit E
; with no document change. "Moved" is the pre-turn closure-lines.fk without its final newline: its bytes no longer
; hold the edit's guard, so every E fails the same way, as the witnessed E failed at every rung.
;
; Verdict 131071 when every claim lands:
;   1    both fixtures read back with their recorded sha256
;   2    through the policy alone, A E E A E A over the moved resident never takes the no-progress route
;        (replan_required stays 0) and never ends: its window held one [call result] pair at a time
;   4    through fcsw-step the same six replies read stillstreak 0 0 1 2 3 4
;   8    at 2 the observation names the repeat and the stage stays; at 3 replan_required is 1 with the
;        no-progress note; at 4 the attempt ends attention "stillstreak;candidate-retained"
;   16   over the pre-turn resident the edit ladder lands reply 2, and replies 1-5 never reach stillstreak 2
;   32   A B A B with unchanged documents reaches 2 at the fourth turn
;   64   read, a successful edit, then the same read reads 0: the changed document opened a new span
;   128  {"tool":"edit","arguments":{"file_path","old_string","new_string"}} is admitted as [path,old,new], the
;        document changes, one native-tool-argument-repair row is kept and the observation carries it
;   256  "Read" and "functions.read" resolve to read and run; an unknown name is refused with the native names
;   512  a case-fold collision ("READ" over read and Read) refuses and lists both
;   1024 number and boolean arguments become strings; an object field that is not an argument is refused,
;        every failing field listed with what it received
;   2048 one failed caller assertion over two different document bytes reads as one counterexample (the raw
;        stdouts differ by their document_catalog), and after a reflection the policy marks it repeated
;   4096 an echocall (the same failed edit, its old text respelled in other whitespace) counts as a repeat,
;        while an edit with other old text does not
;   8192 replies taken as fcac-loop takes them (each decoded by fcsw-reply over a scripted session, then
;        stepped): reads a, b, c in one context, renewal, then a, b, c, a read [0,0,0] and [0,0,0,1], and the
;        record counts two contexts; a fresh context's re-read gives it back its sight, it is no still turn
;   16384 a checkpoint saved at stillstreak 3 packs and unpacks equal, and the resumed option's first re-read
;        in its fresh context stays below 2 and does not end the attempt
;   32768 the same read four times in a row raises repair_attempts by one at the fourth turn: the policy's own
;        count rule and the guard's replan are one no-progress route, taken once
;   65536 the policy's own count restarts with a context: read a twice, renewal, and the first re-read counts 1
;        and stays in implement with no repair; the third read in that one context takes no-progress
section [form.bml] {
 class FormCliCodeTurnGuardBand {
  def tgb-bit(ok, bit) = ok ? bit : 0;
  def tgb-path() = "form/form-stdlib/closure-lines.fk";
  def tgb-u(last) = byte_to_str(226) ++ byte_to_str(128) ++ byte_to_str(last);
  def tgb-resident() = str-join-with(["; closure-lines.fk " ++ tgb-u(148) ++ " read a line of an fkwu closure back to the unit that wrote it.", ";",
   "; `./fkwu --closure <unit> <out>` joins every unit of a closure into one plain-Form",
   "; file and heads each unit's text with a line \"; unit: <path>\". A sibling kernel",
   "; reports a stop at a line of that file; this unit names the authored unit and", "; the line within it.", "", "(do", "    0)", ""], "\n");
  def tgb-moved() = substring(tgb-resident(), 0, len(tgb-resident()) - 1);
  def tgb-new() = str-join-with(["(do",
   "  (defn cl-marker? (s at) (eq (str_find s \"; unit: \" at) at))",
   "  (defn cl-line-end (s at)", "    (do", "      (let e (str_find s (byte_to_str 10) at))", "      (if (lt e 0) (str_len s) e)))",
   "  (defn cl-walk (s at line want unit start)", "    (do", "      (if (ge at (str_len s))", "          (nothing)", "          (do",
   "            (let end (cl-line-end s at))", "            (let mark (cl-marker? s at))", "            (if (eq line want)",
   "                (if (or mark (eq unit (nothing)))", "                    (nothing)", "                    (list unit (sub line start)))",
   "                (do", "                  (let next-unit (if mark (substring s (add at 8) end) unit))", "                  (let next-start (if mark line start))",
   "                  (cl-walk s (add end 1) (add line 1) want next-unit next-start)))))))",
   "  (defn cl-unit-at (text line) (cl-walk text 0 1 line (nothing) 0))", "  0)"], "\n");
  def tgb-read-reply() = json-emit(json-node-object([json-node-pair("tool", json-node-string("read")), json-node-pair("arguments", json-node-array([json-node-string(tgb-path())])), json-node-pair("input", json-node-string(""))]));
  def tgb-edit-reply() = json-emit(json-node-object([json-node-pair("tool", json-node-string("edit")), json-node-pair("arguments", json-node-array([json-node-string(tgb-path()), json-node-string("e5cbb7b3ed16cba2730c41b7137c048bee6ca527637c06eff2adbc2f4934c6dd"), json-node-string("(do\n     0)"), json-node-string(tgb-new())]))]));
  def tgb-sha(text) = hex-encode(sha256-stream-string(text));
  def tgb-carried(name, text) {
   let path = temp_dir() ++ "/form-cli-code-turn-guard-band-" ++ host_pid().str() ++ "-" ++ name;
   let wrote = write_file(path, text);
   let back = read_file(path);
   let gone = fs_remove(path);
   back ?? "";
  }
  def tgb-checker() = [(contract, docs) => [1, "stub caller check"], []];
  def tgb-open(docs, writable) = fcap-begin-context(fcap-with-document-context(fcap-open-direct-code("closure-unit-line: add four definitions inside the (do ...), before the final 0.", docs, writable), "catalog"));
  def tgb-state(text) = tgb-open([[tgb-path(), tgb-path(), text]], [tgb-path()]);
  // [last-state states]: every reply through step, in order
  def tgb-run(step, s, replies) = foldl((acc, raw) => tgb-next(acc, step(acc[0], raw, tgb-checker())), [s, []], replies);
  def tgb-next(acc, next) = [next, append(acc[1], [next])];
  def tgb-streak(s) = fcctg-stillstreak(fcsw-slot(s)[0]);
  def tgb-streaks(run) = run[1] |> map(tgb-streak);
  def tgb-call(tool, args) = json-emit(json-node-object([json-node-pair("tool", json-node-string(tool)), json-node-pair("arguments", json-node-array(fcctg-strings(args))), json-node-pair("input", json-node-string(""))]));

  def tgb-policy-alone(a, e) {
   let run = tgb-run(fcap-step, tgb-state(tgb-moved()), [a, e, e, a, e, a]);
   all?(s => !fcap-repeat(s) && !fcap-done(s), run[1]) && fcap-calls(run[0]) == 6;
  }
  def tgb-guarded(a, e) = tgb-run(fcsw-step, tgb-state(tgb-moved()), [a, e, e, a, e, a]);
  def tgb-crossings(run) {
   let s = run[1];
   fat-starts(fcap-note(s[3]), "Turn guard: the same read call") && fcap-stage(s[3]) == fcap-stage(s[2]) && !fcap-repeat(s[3])
   && fcap-repeat(s[4]) && fcap-stage(s[4]) == "repair" && str_find(fcap-note(s[4]), "repeating the call is not progress", 0) > 0
   && fcap-stage(s[5]) == "attention" && fcap-note(s[5]) == "stillstreak;candidate-retained";
  }
  def tgb-laddered(a, e) {
   let run = tgb-run(fcsw-step, tgb-state(tgb-resident()), [a, e, e, a, e]);
   let landed = fat-find-doc(fcap-docs(run[1][1]), tgb-path());
   str_find(landed[2], "(defn cl-unit-at", 0) > 0 && all?(n => n < 2, tgb-streaks(run)) && !fcap-done(run[0]);
  }
  def tgb-docs2() = [["a.txt", "a.txt", "alpha\n"], ["b.txt", "b.txt", "beta\n"]];
  def tgb-abab() {
   let run = tgb-run(fcsw-step, tgb-open(tgb-docs2(), ["a.txt"]), [tgb-call("read", ["a.txt"]), tgb-call("read", ["b.txt"]), tgb-call("read", ["a.txt"]), tgb-call("read", ["b.txt"])]);
   tgb-streaks(run) == [0, 0, 1, 2] && fat-starts(fcap-note(run[0]), "Turn guard:");
  }
  def tgb-new-span() {
   let run = tgb-run(fcsw-step, tgb-open(tgb-docs2(), ["a.txt"]), [tgb-call("read", ["a.txt"]), tgb-call("edit", ["a.txt", "alpha", "ALPHA"]), tgb-call("read", ["a.txt"])]);
   tgb-streaks(run) == [0, 0, 0] && fat-find-doc(fcap-docs(run[0]), "a.txt")[2] == "ALPHA\n";
  }
  def tgb-alias() {
   let raw = "{\"tool\":\"edit\",\"arguments\":{\"file_path\":\"a.txt\",\"old_string\":\"alpha\",\"new_string\":\"ALPHA\"}}";
   let next = fcsw-step(tgb-open(tgb-docs2(), ["a.txt"]), raw, tgb-checker());
   let rows = fcsw-slot(next)[1];
   let row = len(rows) == 1 ? parse-json("band-row", rows[0]) : json-node-object([]);
   fat-find-doc(fcap-docs(next), "a.txt")[2] == "ALPHA\n" && len(rows) == 1 && fcap-string(row, "method") == "native-tool-argument-repair"
   && fcap-string(row, "before_sha256") == tgb-sha(raw) && fcsw-signature(next)[1] == ["a.txt", "alpha", "ALPHA"]
   && str_find(fcap-note(next), "native_tool_repairs", 0) > 0;
  }
  def tgb-names() {
   let s = tgb-open(tgb-docs2(), ["a.txt"]);
   let read = fcsw-step(s, "{\"tool\":\"Read\",\"arguments\":[\"a.txt\"],\"input\":\"\"}", tgb-checker());
   let spaced = fcsw-step(s, "{\"tool\":\"functions.read\",\"arguments\":[\"b.txt\"]}", tgb-checker());
   let unknown = fcsw-step(s, "{\"tool\":\"bash\",\"arguments\":[\"ls\"]}", tgb-checker());
   fcsw-signature(read)[0] == "read" && fcsw-signature(read)[4] == "alpha\n" && fcsw-signature(spaced)[0] == "read" && fcsw-signature(spaced)[4] == "beta\n"
   && fcap-calls(unknown) == fcap-calls(s) && str_find(fcap-note(unknown), "Unknown tool \"bash\". Native tools: rg, jq, read", 0) == 0;
  }
  def tgb-collision() {
   let named = fcctg-name("READ", ["read", "Read"]);
   let refused = fcctg-repair("{\"tool\":\"READ\",\"arguments\":[\"a\"]}", ["read", "Read"]);
   named[0] == "ambiguous" && named[2] == ["read", "Read"] && str_find(refused[2], "read, Read", 0) > 0 && refused[0] == "{\"tool\":\"READ\",\"arguments\":[\"a\"]}";
  }
  def tgb-scalars() {
   let names = fcsw-tool-names();
   let scalar = fcctg-repair("{\"tool\":\"head\",\"arguments\":[\"-n\",5,\"a.txt\"],\"input\":\"\"}", names);
   let flag = fcctg-args("tail", parse-json("band-args", "[true,\"x\"]"));
   let refused = fcctg-repair("{\"tool\":\"edit\",\"arguments\":{\"path\":\"a.txt\",\"bogus\":3}}", names);
   scalar[0] == "{\"tool\":\"head\",\"arguments\":[\"-n\",\"5\",\"a.txt\"],\"input\":\"\"}" && len(scalar[1]) == 1 && flag[1] == ["true", "x"] && flag[0] == "repaired"
   && fat-starts(refused[2], "Tool arguments must be an array of strings. Received: bogus=3 (is not an argument of this tool); old=absent (is required); new=absent (is required). Existing documents require edit");
  }
  // one failed caller assertion, its actual carrying the document catalog of the bytes it read
  def tgb-assertion(docs) = "Failed caller assertion: {\"tool\":\"rg\",\"arguments\":[\"-c\",\"-F\",\"(defn cl-unit-at\",\"form/form-stdlib/closure-lines.fk\"],\"stdout\":\"1\\n\"} actual="
   ++ json-emit(json-node-object([json-node-pair("schema", json-node-string("form-native-source-check-v1")), json-node-pair("exit", json-node-int(0)), json-node-pair("stdout", json-node-string("form/form-stdlib/closure-lines.fk:1\n")), json-node-pair("stderr", json-node-string("")), json-node-pair("document_catalog", json-node-array(fcap-document-catalog(docs))), json-node-pair("crossings", json-node-int(0))]));
  def tgb-reason(s) = "Native tool failed: " ++ fcap-verification-note(s, fat-result(2, tgb-assertion(fcap-docs(s)), "caller verification refused", fcap-docs(s)));
  def tgb-raw-stdout(reason) = node_value(json-object-get(parse-json("band-reason", substring(reason, str_find(reason, "{", 0), len(reason))), "stdout"));
  def tgb-counterexample() {
   let one = tgb-state(tgb-resident() ++ "; one\n");
   let two = tgb-state(tgb-resident() ++ "; two\n");
   let r1 = tgb-reason(one);
   let r2 = tgb-reason(two);
   let failed = fcap-repair-state(one, r1);
   let reflected = fcap-repaired(failed, "the check names the path", "write the definition", "implement");
   let again = fcap-repair-state(reflected, r2);
   tgb-raw-stdout(r1) != tgb-raw-stdout(r2) && fcap-counterexample(r1) == fcap-counterexample(r2) && str_find(fcap-counterexample(r1), "document_catalog", 0) < 0
   && !fcap-repeat(failed) && fcap-repeat(again);
  }
  def tgb-echocall() {
   let run = tgb-run(fcsw-step, tgb-open(tgb-docs2(), ["a.txt"]), [tgb-call("edit", ["a.txt", "zeta  one", "z"]), tgb-call("edit", ["a.txt", "zeta\tone", "z"]), tgb-call("edit", ["a.txt", "zeta two", "z"])]);
   tgb-streaks(run) == [0, 1, 1] && all?(s => fcsw-signature(s)[5] == "edit-not-found", run[1]);
  }
  // ── contexts ──
  def tgb-docs3() = append(tgb-docs2(), [["c.txt", "c.txt", "gamma\n"]]);
  def tgb-reads(paths) = paths |> map(p => tgb-call("read", [p]));
  // a scripted session that has observed `observed` observations in its context
  def tgb-session(observed) = fcms-session("live", "band", "", "", [], [], 64, 10, 7, 0, 0, 0, 0, observed);
  def tgb-decode() = (sess, state, started, stops, ids) => fcms-generation("", [5], sess);
  def tgb-kept() = (g, state, checker, turns, started) => state;
  // one reply as fcac-loop takes it: decoded by fcsw-reply, then stepped
  def tgb-reply(s, observed, raw) = fcsw-step(fcsw-reply(tgb-session(observed), s, tgb-checker(), 64, now_unix_ms(), [0, 1], tgb-decode(), tgb-kept()), raw, tgb-checker());
  // one context's replies: [last-state streaks]; its n-th reply follows n observations
  def tgb-context(s, raws) = foldl((acc, raw) => tgb-context-next(acc, tgb-reply(acc[0], len(acc[1]), raw)), [s, []], raws);
  def tgb-context-next(acc, next) = [next, append(acc[1], [tgb-streak(next)])];
  def tgb-renewal() {
   let one = tgb-context(tgb-open(tgb-docs3(), ["a.txt"]), tgb-reads(["a.txt", "b.txt", "c.txt"]));
   let two = tgb-context(fcap-begin-context(one[0]), tgb-reads(["a.txt", "b.txt", "c.txt", "a.txt"]));
   one[1] == [0, 0, 0] && two[1] == [0, 0, 0, 1] && fcsw-context(one[0]) == 1 && fcsw-context(two[0]) == 2 && !fcap-done(two[0]) && nil?(fcsw-slot(two[0])[7]);
  }
  def tgb-resume() {
   let saved = tgb-context(tgb-open(tgb-docs3(), ["a.txt"]), tgb-reads(["a.txt", "b.txt", "c.txt", "a.txt", "b.txt", "c.txt"]));
   let carried = fcam-unpack(fcam-pack(saved[0]));
   let resumed = tgb-context(fcap-begin-context(carried), tgb-reads(["a.txt"]));
   saved[1] == [0, 0, 0, 1, 2, 3] && fcap-stage(saved[0]) == "repair" && (Value) carried == saved[0] && resumed[1][0] < 2 && !fcap-done(resumed[0]);
  }
  def tgb-once() {
   let run = tgb-run(fcsw-step, tgb-open(tgb-docs2(), ["a.txt"]), tgb-reads(["a.txt", "a.txt", "a.txt", "a.txt"]));
   let s = run[1];
   tgb-streaks(run) == [0, 1, 2, 3] && fcap-failures(s[2]) == fcap-failures(s[1]) + 1 && fcap-failures(s[3]) == fcap-failures(s[2]) + 1 && fcap-repeat(s[3]) && !fcap-done(s[3]);
  }
  def tgb-recount() {
   let one = tgb-context(tgb-open(tgb-docs2(), ["a.txt"]), tgb-reads(["a.txt", "a.txt"]))[0];
   let first = tgb-reply(fcap-begin-context(one), 0, tgb-call("read", ["a.txt"]));
   let second = tgb-reply(first, 1, tgb-call("read", ["a.txt"]));
   let third = tgb-reply(second, 2, tgb-call("read", ["a.txt"]));
   fcap-tool-history(one)[1] == 2 && fcap-tool-history(first)[1] == 1 && fcap-failures(first) == fcap-failures(one) && fcap-stage(first) == "implement"
   && fcap-tool-history(third)[1] == 3 && fcap-failures(third) == fcap-failures(one) + 1 && fcap-stage(third) == "repair";
  }
 }
 let a = tgb-carried("reply-1-read.json", tgb-read-reply());
 let e = tgb-carried("reply-2-edit.json", tgb-edit-reply());
 let guarded = tgb-guarded(a, e);
 let verdict = tgb-bit(tgb-sha(a) == "d7127a2bfc21dca793e8c6efe7b982bc65784e65c2206fcabadac4ebb4888aef" && tgb-sha(e) == "99a98cec6aeb5dc26fc8958a3800dcb21707d45d16a68cdd95a3b77e4dff29ec", 1)
  + tgb-bit(tgb-policy-alone(a, e), 2) + tgb-bit(tgb-streaks(guarded) == [0, 0, 1, 2, 3, 4], 4) + tgb-bit(tgb-crossings(guarded), 8)
  + tgb-bit(tgb-laddered(a, e), 16) + tgb-bit(tgb-abab(), 32) + tgb-bit(tgb-new-span(), 64) + tgb-bit(tgb-alias(), 128)
  + tgb-bit(tgb-names(), 256) + tgb-bit(tgb-collision(), 512) + tgb-bit(tgb-scalars(), 1024) + tgb-bit(tgb-counterexample(), 2048)
  + tgb-bit(tgb-echocall(), 4096) + tgb-bit(tgb-renewal(), 8192) + tgb-bit(tgb-resume(), 16384) + tgb-bit(tgb-once(), 32768)
  + tgb-bit(tgb-recount(), 65536);
 print_str("form-cli-code-turn-guard-band " ++ verdict.str() ++ " streaks=" ++ json-emit(json-node-array(tgb-streaks(guarded) |> map(json-node-int))));
 verdict;
}
