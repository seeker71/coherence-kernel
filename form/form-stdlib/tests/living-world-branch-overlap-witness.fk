; living-world-branch-overlap-witness.fk -- two capability views share one
; cell, disagree in relation, and release only one restored view.
;
; Fixture names are opaque local distinctions.  The organ receives no domain
; vocabulary or preferred route.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-continuity-branch.fk form-stdlib/living-world-branch-overlap.fk

(let LWBOW-SOURCE-A       (bp "LWBOW-SOURCE-A"))
(let LWBOW-SOURCE-B       (bp "LWBOW-SOURCE-B"))
(let LWBOW-CUSTODIAN      (bp "LWBOW-CUSTODIAN"))
(let LWBOW-PROVENANCE-A   (bp "LWBOW-PROVENANCE-A"))
(let LWBOW-PROVENANCE-B   (bp "LWBOW-PROVENANCE-B"))
(let LWBOW-PROVENANCE-C   (bp "LWBOW-PROVENANCE-C"))
(let LWBOW-SHARED         (bp "LWBOW-SHARED"))
(let LWBOW-PREDICATE      (bp "LWBOW-PREDICATE"))
(let LWBOW-OBJECT-A       (bp "LWBOW-OBJECT-A"))
(let LWBOW-OBJECT-B       (bp "LWBOW-OBJECT-B"))
(let LWBOW-EVIDENCE-A     (bp "LWBOW-EVIDENCE-A"))
(let LWBOW-EVIDENCE-B     (bp "LWBOW-EVIDENCE-B"))
(let LWBOW-COHERENCE      (bp "LWBOW-COHERENCE"))
(let LWBOW-RESONANCE      (bp "LWBOW-RESONANCE"))
(let LWBOW-UNCERTAINTY    (bp "LWBOW-UNCERTAINTY"))
(let LWBOW-CAPABILITY-A   (bp "LWBOW-CAPABILITY-A"))
(let LWBOW-CAPABILITY-B   (bp "LWBOW-CAPABILITY-B"))
(let LWBOW-GRANT-A        (bp "LWBOW-GRANT-A"))
(let LWBOW-GRANT-B        (bp "LWBOW-GRANT-B"))
(let LWBOW-DECLARATION    (bp "LWBOW-DECLARATION"))
(let LWBOW-LENS           (bp "LWBOW-LENS"))
(let LWBOW-ALTERNATIVE    (bp "LWBOW-ALTERNATIVE"))
(let LWBOW-UNKNOWN        (bp "LWBOW-UNKNOWN"))
(let LWBOW-ACTION         (bp "LWBOW-ACTION"))
(let LWBOW-REASON         (bp "LWBOW-REASON"))

(defn lwbow-cell (kind) (intern_node kind (empty)))
(defn lwbow-source-a () (lwbow-cell LWBOW-SOURCE-A))
(defn lwbow-source-b () (lwbow-cell LWBOW-SOURCE-B))
(defn lwbow-custodian () (lwbow-cell LWBOW-CUSTODIAN))
(defn lwbow-provenance-a () (lwbow-cell LWBOW-PROVENANCE-A))
(defn lwbow-provenance-b () (lwbow-cell LWBOW-PROVENANCE-B))
(defn lwbow-provenance-c () (lwbow-cell LWBOW-PROVENANCE-C))
(defn lwbow-shared () (lwbow-cell LWBOW-SHARED))
(defn lwbow-predicate () (lwbow-cell LWBOW-PREDICATE))
(defn lwbow-object-a () (lwbow-cell LWBOW-OBJECT-A))
(defn lwbow-object-b () (lwbow-cell LWBOW-OBJECT-B))
(defn lwbow-evidence-a () (lwbow-cell LWBOW-EVIDENCE-A))
(defn lwbow-evidence-b () (lwbow-cell LWBOW-EVIDENCE-B))
(defn lwbow-coherence () (lwbow-cell LWBOW-COHERENCE))
(defn lwbow-resonance () (lwbow-cell LWBOW-RESONANCE))
(defn lwbow-uncertainty () (lwbow-cell LWBOW-UNCERTAINTY))
(defn lwbow-capability-a () (lwbow-cell LWBOW-CAPABILITY-A))
(defn lwbow-capability-b () (lwbow-cell LWBOW-CAPABILITY-B))
(defn lwbow-grant-evidence-a () (lwbow-cell LWBOW-GRANT-A))
(defn lwbow-grant-evidence-b () (lwbow-cell LWBOW-GRANT-B))
(defn lwbow-declaration () (lwbow-cell LWBOW-DECLARATION))
(defn lwbow-lens () (lwbow-cell LWBOW-LENS))
(defn lwbow-alternative () (lwbow-cell LWBOW-ALTERNATIVE))
(defn lwbow-unknown () (lwbow-cell LWBOW-UNKNOWN))
(defn lwbow-action () (lwbow-cell LWBOW-ACTION))
(defn lwbow-reason () (lwbow-cell LWBOW-REASON))

(defn lwbow-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwbow-sum (tail items)))))

(defn lwbow-interface () (lwo-interface (list (lwbow-action))))

(defn lwbow-entry (source provenance payload)
    (lwt-entry
        (lwo-offer source (lwbow-interface) 1 payload provenance 1)
        (lwbow-action)))

(defn lwbow-revocation-entry (source provenance target)
    (lwbow-entry source provenance
        (lwo-revocation target source (lwbow-reason) provenance)))

(defn lwbow-relation-a ()
    (lwo-relation
        (lwbow-shared) (lwbow-predicate) (lwbow-object-a)
        (lwbow-evidence-a) (lwbow-coherence) (lwbow-resonance)
        (lwbow-uncertainty) (lwbow-provenance-a)))

(defn lwbow-relation-b ()
    (lwo-relation
        (lwbow-shared) (lwbow-predicate) (lwbow-object-b)
        (lwbow-evidence-b) (lwbow-coherence) (lwbow-resonance)
        (lwbow-uncertainty) (lwbow-provenance-b)))

(defn lwbow-grant (payload capability evidence)
    (lwcp-grant payload capability evidence))

(defn lwbow-shared-grant-a ()
    (lwbow-grant (lwbow-shared) (lwbow-capability-a)
        (lwbow-grant-evidence-a)))
(defn lwbow-shared-grant-b ()
    (lwbow-grant (lwbow-shared) (lwbow-capability-b)
        (lwbow-grant-evidence-b)))
(defn lwbow-relation-grant-a ()
    (lwbow-grant (lwbow-relation-a) (lwbow-capability-a)
        (lwbow-grant-evidence-a)))
(defn lwbow-relation-grant-b ()
    (lwbow-grant (lwbow-relation-b) (lwbow-capability-b)
        (lwbow-grant-evidence-b)))

; Both shared-cell holders grant both views.  Each source alone grants its
; branch-local relation.  Thus either branch has two participants, while no
; holder exposes the other's indistinguishable shared contribution.
(defn lwbow-historical-world ()
    (lwt-receive-stream (lwo-empty-world)
        (list
            (lwbow-entry (lwbow-source-a) (lwbow-provenance-a)
                (lwbow-shared))
            (lwbow-entry (lwbow-source-b) (lwbow-provenance-b)
                (lwbow-shared))
            (lwbow-entry (lwbow-source-a) (lwbow-provenance-a)
                (lwbow-relation-a))
            (lwbow-entry (lwbow-source-b) (lwbow-provenance-b)
                (lwbow-relation-b))
            (lwbow-entry (lwbow-source-a) (lwbow-provenance-a)
                (lwbow-capability-a))
            (lwbow-entry (lwbow-source-b) (lwbow-provenance-b)
                (lwbow-capability-b))
            (lwbow-entry (lwbow-source-a) (lwbow-provenance-a)
                (lwbow-shared-grant-a))
            (lwbow-entry (lwbow-source-b) (lwbow-provenance-b)
                (lwbow-shared-grant-a))
            (lwbow-entry (lwbow-source-a) (lwbow-provenance-a)
                (lwbow-shared-grant-b))
            (lwbow-entry (lwbow-source-b) (lwbow-provenance-b)
                (lwbow-shared-grant-b))
            (lwbow-entry (lwbow-source-a) (lwbow-provenance-a)
                (lwbow-relation-grant-a))
            (lwbow-entry (lwbow-source-b) (lwbow-provenance-b)
                (lwbow-relation-grant-b)))))

(defn lwbow-image () (lwcn-image (lwbow-historical-world)))

(defn lwbow-branch-a ()
    (lwcb-branch (lwbow-image) (lwbow-capability-a)
        (lwo-none) (lwo-none) (lwo-empty-field) (lwo-none)))

(defn lwbow-branch-b ()
    (lwcb-branch (lwbow-image) (lwbow-capability-b)
        (lwbow-declaration) (lwbow-lens)
        (lwo-field (list (lwbow-alternative))) (lwbow-unknown)))

(defn lwbow-overlap ()
    (lwbo-overlap (lwbow-branch-a) (lwbow-branch-b)))

(defn lwbow-minimal-contention ()
    (lwbo-contention-for
        (lwbow-branch-a) (lwbow-branch-b)
        (lwo-none) (lwo-none) (lwo-empty-field) (lwo-none)))

(defn lwbow-layered-contention ()
    (lwbo-contention-for
        (lwbow-branch-a) (lwbow-branch-b)
        (lwbow-declaration) (lwbow-lens)
        (lwo-field (list (lwbow-alternative))) (lwbow-unknown)))

(defn lwbow-admission-world ()
    (lwt-receive-stream (lwo-empty-world)
        (list
            (lwbow-entry (lwbow-custodian) (lwbow-provenance-c)
                (lwbow-branch-a))
            (lwbow-entry (lwbow-custodian) (lwbow-provenance-c)
                (lwbow-branch-b)))))

(defn lwbow-proposal-a ()
    (lwcb-restore-proposal (lwbow-admission-world) (lwbow-branch-a)))
(defn lwbow-proposal-b ()
    (lwcb-restore-proposal (lwbow-admission-world) (lwbow-branch-b)))
(defn lwbow-candidate-a () (lwt-proposal-candidate (lwbow-proposal-a)))
(defn lwbow-candidate-b () (lwt-proposal-candidate (lwbow-proposal-b)))

(defn lwbow-response-entry (source provenance proposal ack)
    (lwbow-entry source provenance
        (lwt-response proposal ack provenance)))

(defn lwbow-restoration-response-world ()
    (lwt-receive-stream (lwbow-admission-world)
        (list
            (lwbow-response-entry
                (lwbow-source-a) (lwbow-provenance-a)
                (lwbow-proposal-a) (oac-one (lwbow-proposal-a)))
            (lwbow-response-entry
                (lwbow-source-b) (lwbow-provenance-b)
                (lwbow-proposal-a) (oac-one (lwbow-proposal-a)))
            (lwbow-response-entry
                (lwbow-source-a) (lwbow-provenance-a)
                (lwbow-proposal-b) (oac-one (lwbow-proposal-b)))
            (lwbow-response-entry
                (lwbow-source-b) (lwbow-provenance-b)
                (lwbow-proposal-b) (oac-one (lwbow-proposal-b))))))

(defn lwbow-round (world)
    (lwt-round world
        (lwo-field (list (lwbow-proposal-a) (lwbow-proposal-b)))
        (lwo-empty-field) (lwo-none)))

(defn lwbow-after-a-world ()
    (lwt-round-world
        (lwcb-integrate-restore
            (lwbow-round (lwbow-restoration-response-world))
            (lwbow-proposal-a) (lwbow-action))))

(defn lwbow-restored-world ()
    (lwt-round-world
        (lwcb-integrate-restore
            (lwbow-round (lwbow-after-a-world))
            (lwbow-proposal-b) (lwbow-action))))

; A may revoke only A's attribution to B's restored view.  B's attribution
; continues to hold that view active.
(defn lwbow-after-a-leaves-b ()
    (lwt-receive-stream (lwbow-restored-world)
        (list
            (lwbow-revocation-entry
                (lwbow-source-a) (lwbow-provenance-a)
                (lwbow-candidate-b)))))

(defn lwbow-compost-proposal-a ()
    (lwbo-compost-proposal
        (lwbow-after-a-leaves-b) (lwbow-candidate-a)
        (lwo-none) (lwo-none) (lwo-empty-field) (lwo-none)))

(defn lwbow-partial-compost-world ()
    (lwt-receive-stream (lwbow-after-a-leaves-b)
        (list
            (lwbow-response-entry
                (lwbow-source-a) (lwbow-provenance-a)
                (lwbow-compost-proposal-a)
                (oac-one (lwbow-compost-proposal-a))))))

(defn lwbow-partial-transition ()
    (lwbo-integrate-compost
        (lwbow-partial-compost-world) (lwbow-compost-proposal-a)))

(defn lwbow-unanimous-compost-world ()
    (lwt-receive-stream (lwbow-partial-compost-world)
        (list
            (lwbow-response-entry
                (lwbow-source-b) (lwbow-provenance-b)
                (lwbow-compost-proposal-a)
                (oac-one (lwbow-compost-proposal-a))))))

(defn lwbow-compost-transition ()
    (lwbo-integrate-compost
        (lwbow-unanimous-compost-world) (lwbow-compost-proposal-a)))

(defn lwbow-successor-world ()
    (lwo-transition-world (lwbow-compost-transition)))

(defn lwbow-compost-receipt ()
    (oac-payload (lwo-transition-ack (lwbow-compost-transition))))
