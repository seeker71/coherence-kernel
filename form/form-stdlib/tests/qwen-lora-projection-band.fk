; preludes: form-stdlib/bml/qwen-lora-projection.bml
(do
 (let p (qlp-projection "qwen-local" "form-local" "projection-0" (list 1 0) (list 0 2)))
 (let ok (qlp-receive "qwen-local" p (list 3 4)))
 (let bad (qlp-receive "other" p (list 3 4)))
 (sum (list (if (eq (qlp-valid? p) 1) 1 0) (if (str_eq (head ok) "received") 2 0) (if (eq (nth (nth ok 1) 1) 10) 4 0) (if (str_eq (head bad) "refused") 8 0))))
