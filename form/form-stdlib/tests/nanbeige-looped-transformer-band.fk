; preludes: form-stdlib/core.fk form-stdlib/transformer-numerics.fk form-stdlib/trig.fk form-stdlib/llama-numerics.fk form-stdlib/rope.fk form-stdlib/transformer-block.fk form-stdlib/transformer-mh.fk form-stdlib/gqa-attn.fk form-stdlib/llama-block.fk form-stdlib/llama-gqa-block.fk form-stdlib/kv-cache.fk form-stdlib/kv-llama-block.fk form-stdlib/kv-gqa-llama-block.fk form-stdlib/multi-layer-stack.fk form-stdlib/gqa-multi-layer-stack.fk form-stdlib/nanbeige-looped-transformer.fk
;
; Verdict 1023: exact upstream inventory plus a real two-pass
; RMSNorm/RoPE/GQA/SwiGLU composition whose cached and recompute paths agree.
(do
    (let xs (list (list 1.0 -0.5 0.5 2.0) (list -1.0 0.25 1.5 -0.75)))
    (let g1 (list 0.9 1.1 1.0 0.95))
    (let g2 (list 1.05 0.95 1.0 0.9))
    (let gf (list 1.0 1.0 1.0 1.0))
    (let wq (list (list 0.5 -0.25 0.1 0.3) (list 0.2 0.4 -0.3 0.1)
                  (list -0.1 0.2 0.5 -0.2) (list 0.3 0.0 -0.15 0.25)))
    (let wk (list (list 0.2 0.4 -0.3 0.1) (list 0.3 -0.2 0.25 0.5)))
    (let wv (list (list 0.3 -0.2 0.25 0.5) (list 0.6 0.1 -0.2 0.4)))
    (let wo (list (list 0.6 0.1 -0.2 0.4) (list -0.2 0.4 0.3 0.1)
                  (list 0.25 -0.15 0.5 0.05) (list 0.1 0.2 -0.3 0.45)))
    (let wg (list (list 0.5 -0.3 0.2 0.1) (list 0.2 0.7 -0.4 0.3)
                  (list -0.1 0.25 0.4 -0.2) (list 0.3 0.1 -0.15 0.5)))
    (let wu (list (list 0.25 -0.15 0.3 0.05) (list 0.1 0.4 -0.2 0.15)
                  (list 0.35 0.2 -0.1 0.25) (list -0.2 0.3 0.15 0.4)))
    (let wd (list (list 0.4 -0.2 0.3 0.1) (list 0.15 0.5 -0.25 0.2)
                  (list -0.3 0.1 0.45 -0.15) (list 0.2 -0.1 0.35 0.3)))
    (let layers (list (list g1 wq wk wv wo g2 wg wu wd)))
    (let eps 0.00001)
    (let scale (div 1.0 (tn-sqrt 2.0)))
    (let rope (rope-cfg 70000000.0 32.0 1.0 2.0 262144.0))
    (let once (nblt-pass-causal xs layers gf eps scale 2 1 2 rope))
    (let twice-c (nblt-two-loop-causal xs layers gf eps scale 2 1 2 rope))
    (let twice-g (nblt-two-loop-generate xs layers gf eps scale 2 1 2 rope))
    (add
        (if (eq (nblt-tensor-count) 201) 1 0)
        (add (if (eq (nblt-total-bytes) 8339601408) 2 0)
        (add (if (eq (nblt-manifest-complete?) 1) 4 0)
        (add (if (eq (len (nblt-shape-contract)) 12) 8 0)
        (add (if (eq (kv-lol-eq twice-c twice-g) 1) 16 0)
        (add (if (eq (kv-lol-eq once twice-c) 0) 32 0)
        (add (if (eq (len twice-c) 2) 64 0)
        (add (if (eq (len (head twice-c)) 4) 128 0)
        (add (if (eq (add (nblt-shard1-tensors) (nblt-shard2-tensors)) 201) 256 0)
             (if (eq (nblt-layer-count) 22) 512 0)))))))))))
