; living-world-shared-field-live-atomic-witness.fk -- a deliberately oversized
; sealed cell exercises the bounded atomic carrier special case.  Ordinary
; world growth remains one independently admitted canonical cell at a time.
;
; preludes: form-stdlib/core.fk observe/live-call-framebuffer.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-session-observation.fk form-stdlib/living-world-session-learning.fk form-stdlib/living-world-shared-field-channel.fk form-stdlib/living-world-shared-field-continuity.fk form-stdlib/living-world-generative-continuation.fk form-stdlib/living-world-shared-field-live.fk form-stdlib/tests/living-world-generative-continuation-witness.fk form-stdlib/tests/living-world-shared-field-live-witness.fk

(let LWSFLAW-TRANSFER       (bp "LWSFLAW-TRANSFER"))
(let LWSFLAW-OTHER-TRANSFER (bp "LWSFLAW-OTHER-TRANSFER"))

(defn lwsflaw-cell (kind) (intern_node kind (empty)))
(defn lwsflaw-transfer () (lwsflaw-cell LWSFLAW-TRANSFER))
(defn lwsflaw-other-transfer () (lwsflaw-cell LWSFLAW-OTHER-TRANSFER))

(defn lwsflaw-large-text ()
    (do
        (let a "0123456789abcdef")
        (let b (str_concat a a))
        (let c (str_concat b b))
        (let d (str_concat c c))
        (let e (str_concat d d))
        (let f (str_concat e e))
        (let g (str_concat f f))
        (let h (str_concat g g))
        (let i (str_concat h h))
        i))

(defn lwsflaw-open ()
    (lwsfl-open 2 (lwsgw-action) (lwo-none) (lwo-none)
        (lwo-empty-field) (lwo-none) (lwsflw-close)
        (intern_trivial_string (lwsflaw-large-text))))

(defn lwsflaw-chunks (hex transfer at ordinal acc)
    (do
        (let length (str_len hex))
        (let end (lwsfl-frame-end at length))
        (let final (if (eq end length) 1 0))
        (let chunk
            (lwsfl-chunk transfer ordinal final
                (substring hex at end)))
        (let next (cons chunk acc))
        (if (eq final 1) (reverse next)
            (lwsflaw-chunks hex transfer end
                (add ordinal 1) next))))

(defn lwsflaw-chunks-valid? (items transfer expected)
    (if (eq (len items) 0) 1
        (do
            (let chunk (head items))
            (if (and
                    (eq (lwsfl-expected-chunk?
                        chunk transfer expected) 1)
                    (le (str_len (lwsfl-hex-cell chunk)) 4096))
                (lwsflaw-chunks-valid? (tail items)
                    transfer (add expected 1)) 0))))

(defn lwsflaw-assemble (items text)
    (if (eq (len items) 0) text
        (lwsflaw-assemble (tail items)
            (str_concat text
                (lwsfl-chunk-fragment (head items))))))

(defn lwsflaw-final-shape? (items at)
    (if (eq (len items) 0) 1
        (do
            (let chunk (head items))
            (let expected
                (if (eq (len (tail items)) 0) 1 0))
            (if (eq (lwsfl-chunk-final chunk) expected)
                (lwsflaw-final-shape? (tail items) (add at 1)) 0))))

(defn lwsflaw-observe (items started ordinal)
    (if (eq (len items) 0) ordinal
        (do
            (let chunk (head items))
            (let observed
                (lwsfl-observe-chunk
                    (lwsfl-chunk-ordinal chunk)
                    (str_len (lwsfl-chunk-fragment chunk))
                    started ordinal "lwsflaw-observe"))
            (lwsflaw-observe (tail items) started
                (add ordinal 1)))))

; Result: open, root hex, chunks, assembled decode, hostile order, hostile
; transfer, hostile uppercase fragment, retained framebuffer events.
(defn lwsflaw-run ()
    (do
        (let open (lwsflaw-open))
        (let hex (lwsfl-hex-cell open))
        (let chunks
            (lwsflaw-chunks hex (lwsflaw-transfer) 0 0 (empty)))
        (let assembled (lwsflaw-assemble chunks ""))
        (let decoded (lwsfl-decode-line assembled))
        (let hostile-order
            (lwsfl-chunk (lwsflaw-transfer) 2 0 "00"))
        (let hostile-transfer
            (lwsfl-chunk (lwsflaw-other-transfer) 1 0 "00"))
        (let hostile-uppercase
            (lwsfl-chunk (lwsflaw-transfer) 1 0 "A0"))
        (let started
            (lcfb-open-stream "living-world-shared-field-live-atomic"
                "form-native" "lwsflaw-run" "bounded-atomic-special-case"
                "form/form-stdlib/tests/living-world-shared-field-live-atomic-witness.fk"
                100 13))
        (let observed (lwsflaw-observe chunks started 1))
        (let events (framebuffer-events))
        (list open hex chunks decoded hostile-order hostile-transfer
            hostile-uppercase events)))

(defn lwsflaw-bit (condition bit) (if condition bit 0))
(defn lwsflaw-verdict (result)
    (do
        (let open (nth result 0))
        (let hex (nth result 1))
        (let chunks (nth result 2))
        (let decoded (nth result 3))
        (let hostile-order (nth result 4))
        (let hostile-transfer (nth result 5))
        (let hostile-uppercase (nth result 6))
        (let events (nth result 7))
        (add
            (lwsflaw-bit (gt (str_len hex) 4096) 1)
        (add (lwsflaw-bit (and (gt (len chunks) 1)
                (eq (lwsflaw-chunks-valid?
                    chunks (lwsflaw-transfer) 0) 1)) 2)
        (add (lwsflaw-bit
                (and (eq (lwsfl-decoded-canonical? decoded) 1)
                     (node_eq (lwsfl-decoded-cell decoded) open)) 4)
        (add (lwsflaw-bit
                (and (eq (lwsfl-expected-chunk?
                        hostile-order (lwsflaw-transfer) 1) 0)
                     (eq (lwsfl-expected-chunk?
                        hostile-transfer (lwsflaw-transfer) 1) 0)) 8)
        (add (lwsflaw-bit
                (and (eq (lwsfl-chunk-valid? hostile-uppercase) 0)
                     (eq (lwsflaw-final-shape? chunks 0) 1)) 16)
        (lwsflaw-bit (ge (len events) (add (len chunks) 1))
            32))))))))

0
