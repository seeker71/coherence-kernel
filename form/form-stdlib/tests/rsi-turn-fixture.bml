// rsi-turn-fixture.bml — a stand-in turn door for form-stdlib/tests/rsi-turns-band.bml: no model, no band run.
// It takes the stdin the rounds door hands observe/native-turn-run.bml (gap, ledger, queue, session, deadline_ms) and
// lands the option rows its queue row scripts ("standin": [[band_before, band_after, band_green], ...]) in the given
// ledger, shaped as the real door's rows; when the last option is green and the row names a candidate text it keeps
// that text as <turns_dir>/<gap>-<ms>-fixture.fk.candidate, the name the real door gives a kept candidate.
// A row with "exit": n ends the process with form_error after landing its rows, so the rounds door reads a nonzero exit.
// preflight-exec: forbidden
import form-stdlib/bml/form-cli-guide-packet.bml;
import form-stdlib/bml/form-cli-heal-native-io.bml;
import form-stdlib/bml/stdin-source.bml;
section [form.bml] {
 class RsiTurnFixture {
  def rtf-row(gap, n, o, full) = "{\"at_unix_ms\":" ++ now_unix_ms().str() ++ ",\"gap\":\"" ++ gap ++ "\",\"option\":" ++ n.str() ++ ",\"band_before\":" ++ o[0].str() ++ ",\"band_after\":" ++ o[1].str() ++ ",\"full\":" ++ full.str() ++ ",\"band_green\":" ++ o[2].str() ++ ",\"dry\":0,\"test\":0,\"rented_mind\":0,\"rung\":\"standin\"}\n";
  def rtf-ints(node) = map(x => json-int-value(x), json-array-elements(node));
  def rtf-script(q) = map(o => rtf-ints(o), json-array-elements(json-object-get(q, "standin")));
  def rtf-land(ledger, gap, script, full, n) = nil?(script) ? n : rtf-land(ledger, gap, script[1:], full, n + (fhn-append(ledger, rtf-row(gap, n + 1, script[0], full)) == "appended" ? 1 : 0));
  def rtf-run(opts) {
   let gap = fcgp-str(opts, "gap");
   let q = foldl((acc, r) => (String) fcgp-str(r, "id") == gap ? r : acc, nothing(), fcgp-rows(fcgp-str(opts, "queue")));
   let script = nothing?(q) ? [] : rtf-script(q);
   let landed = rtf-land(fcgp-str(opts, "ledger"), gap, script, nothing?(q) ? 0 : (fcgp-num(q, "full") ?? 0), 0);
   let green = !nil?(script) && (Comparable) script[-1][2] == 1;
   let kept = green && (String) fcgp-str(q, "candidate") != "" ? write_file_text(fcgp-str(q, "turns_dir") ++ "/" ++ gap ++ "-" ++ now_unix_ms().str() ++ "-fixture.fk.candidate", fcgp-str(q, "candidate")) : 0;
   let said = print_str("[rsi-turn-fixture] " ++ gap ++ " options=" ++ landed.str());
   !nothing?(q) && (fcgp-num(q, "exit") ?? 0) > 0 ? form_error("rsi-turn-fixture: scripted exit") : 0;
  }
 }
 rtf-run(parse-json("rsi-turn-fixture", stdin-text()));
 0;
}
