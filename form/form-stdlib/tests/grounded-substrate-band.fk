; grounded-substrate-band.fk — a short question the body already holds
; is answered before a model is admitted. A long enquiry is not.
; witnessed: 2026-10-03 -> 7
;   1 a held question is the sentence
;   2 the open landing ask has no held claim
;   4 a long enquiry is outside this door
; preludes: form/form-stdlib/bml/form-cli-grounded-synthesis.bml
(do
    (defn gsb-bit (ok bit) (if ok bit 0))
    (let q "What does a check below its pin mean?")
    (let open "Who carries the landing onto origin when the gates are green?")
    (let long "What does a check below its pin mean? xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")
    (sum (list
        (gsb-bit (and (ge (str_find (fgs-substrate-text q) "is a miss" 0) 0) (eq (fgs-question? q) 1)) 1)
        (gsb-bit (eq (len (qlr-held open)) 0) 2)
        (gsb-bit (and (eq (fgs-question? long) 0) (eq (len (fgs-substrate-text long)) 0)) 4))))
