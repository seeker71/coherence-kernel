; form-bml-cursor-reader-band.bml — actual source admission: escaped, sibling and shadowed lexical
; functions execute; malformed class members fail with their source and cause named. The cursor's
; goldens over the tree's own sections live in form-bml-cursor-full-band.fk.
;
; Verdict 7 = 1 runs | 2 refuses | 4 collections; the children write under temp_dir, removed at the end.
;
; REQUIRES: a ./fkwu child -- each claim spawns ./fkwu (host_spawn_at) and reads its stdout.
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml
section [form.bml] {
 class CursorReaderBand {
  def fcrb-root(ctx) = ctx[1];
  def fcrb-fresh() {
   let root = temp_dir() + ("/form-cursor-reader-" + now_unix_ms().str());
   (Comparable) host_dir_mkdir(root) == 1 ? ["reader", root] : nothing();
  }
  def fcrb-run(ctx, id, text) {
   let base = fcrb-root(ctx) + ("/" + id.str());
   let path = base + ".bml";
   write_file(path, text);
   let pid = host_spawn_at(["./fkwu", path], ["/dev/null", base + ".stdout", base + ".stderr"]);
   let status = pid <= 0 ? -1 : host_wait(pid);
   [status, read_file(base + ".stdout"), read_file(base + ".stderr")];
  }
  def fcrb-runs(ctx) {
   let r = fcrb-run(ctx, 1, "// preludes: form-stdlib/core.fk control/choice-lane-core.fk\nsection [form.bml] {\ndef make(scale) { def middle() { def result(x) = scale * x; result; } middle(); }\ndef siblings(scale) { def factor(x): Number = x * scale; def use(x): Number = factor(x) + 1; map(use,list(1,2)); }\ndef shadow(scale) { def middle(scale) { def result(x) = scale * x; result; } middle(11); }\ndef flow(scale) = 1 .. 5 |> map(x => x * scale) |> foldl((sum,x) => sum + x,0);\ndef capture(noise,scale) = x => x * scale;\ndef coordinates(stop) = stop + 1;\ndef invoke(stop) = stop(4);\ndef retain(fail) = () => fail;\ndef via(store) = 2 |> store(3);\ndef offer(a,b,c) = a + b + c;\ndef locals() { let stop = 8; let fail = 6; stop + fail; }\ndef nested(scale) = bias => x => x * scale + bias;\nlet a = make(7); let b = make(9); let c = shadow(99);\nlet checkpoint = list(1,2) |> store;\nlet values = choice { fail; 0; form_error(\"unselected\"); };\nif flow(3) == 30 && capture(99,3)(4) == 12 && nested(3)(2)(4) == 14 && (1 ? 42 : form_error(\"unselected\")) == 42 && (try stop catch restore(checkpoint)) == checkpoint && undo(fail,checkpoint,list(9)) == checkpoint && values == 0 && (1 |> and(0)) == 0 && a(2) == 14 && b(2) == 18 && a(3) == 21 && c(2) == 22 && siblings(5) == list(6,11) && coordinates(3) == 4 && invoke(x => x + 1) == 5 && retain(9)() == 9 && via((a,b) => a + b) == 5 && offer(1,2,3) == 6 && locals() == 14 then 42 else form_error(\"local function capture differs\");\n}\n");
   r[0] == 0 && r[1] == "42\n";
  }
  def fcrb-collections(ctx) {
   let r = fcrb-run(ctx,6,"// preludes: form-stdlib/core.fk\nsection [form.bml] {\nlet state = record_new(0,\"count\",0);\ndef step() { record_set(state,\"count\",record_get(state,\"count\") + 1); record_get(state,\"count\"); }\ndef rows() = [[1,2],[3,4]];\ndef scaled(k) = [x => x * k];\nlet ordered = [step(),step(),step()];\nlet picked = [10,20][step() - 4];\nlet held = scaled(3);\nif ordered == [1,2,3] && picked == 10 && record_get(state,\"count\") == 4 && rows()[1][0] == 3 && held[0](7) == 21 && (1 .. 4)[2] == 3 && nothing?([][0]) && [1][-1] == 1 && nothing?([1][1]) && [0,nothing(),[]] == list(0,nothing(),list()) then 42 else form_error(\"collection surface changed execution\");\n}\n");
   r[0] == 0 && r[1] == "42\n";
  }
  def fcrb-refuses(ctx) {
   def refuses(id,source,diagnostic) {
    let r = fcrb-run(ctx,id,"section [form.bml] {\n" + (source + "\n}\n"));
    r[0] != 0 && r[1] == "" && str_find(r[2],diagnostic,0) >= 0 &&
     str_find(r[2],fcrb-root(ctx) + ("/" + (id.str() + ".bml")),0) >= 0;
   }
   refuses(2,"def f(x) = x + 1; class K { bogus } f(1);","line 2: bogus (wanted: member)") &&
    refuses(3,"fail(1);","intrinsic call requires 0 arguments; got 1") &&
    refuses(4,"repeat(1,2,3,4);","intrinsic call requires 5 arguments; got 4") &&
    refuses(5,"1 |> and(0,1);","boolean call requires 2 arguments; got 3") &&
    refuses(7,"[1,];","line 2: ] (wanted: expr)") &&
    refuses(8,"[1,,2];","line 2: , (wanted: expr)") &&
    refuses(9,"[1][];","line 2: ] (wanted: expr)");
  }
 }
 let ctx = fcrb-fresh();
 nothing?(ctx) ? form_error("cursor reader witness needs a fresh directory") : 0;
 let verdict = live-claims("form-bml-cursor-reader-band", ctx, [["runs",1,1,fcrb-runs],["refuses",2,1,fcrb-refuses],["collections",4,1,fcrb-collections]]);
 host_dir_rmdir(fcrb-root(ctx));
 verdict;
}
