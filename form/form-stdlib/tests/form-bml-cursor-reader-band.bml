// Actual source admission: escaped, sibling and shadowed lexical functions
// execute; malformed class members fail with their source and cause named.
// Cursor/line-reader tree parity lives in form-bml-cursor-full-band.fk.
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml
section [form.bml] {
 class CursorReaderBand {
  def fcrb-root(ctx) = nth(ctx, 1);
  def fcrb-fresh() {
   let root = str_concat("/tmp/form-cursor-reader-", int_to_str(now_unix_ms()));
   if ((Comparable) host_dir_mkdir(root) == 1) then list("reader", root) else nothing();
  }
  def fcrb-run(ctx, id, text) {
   let base = str_concat(fcrb-root(ctx), str_concat("/", int_to_str(id)));
   let path = str_concat(base, ".bml");
   write_file(path, text);
   let pid = host_spawn_at(list("./fkwu", path), list("/dev/null", str_concat(base, ".stdout"), str_concat(base, ".stderr")));
   let status = if (pid <= 0) then -1 else host_wait(pid);
   list(status, read_file(str_concat(base, ".stdout")), read_file(str_concat(base, ".stderr")));
  }
  def fcrb-runs(ctx) {
   let r = fcrb-run(ctx, 1, "// preludes: form-stdlib/core.fk control/choice-lane-core.fk\nsection [form.bml] {\ndef make(scale) { def middle() { def result(x) = scale * x; result; } middle(); }\ndef siblings(scale) { def factor(x): Number = x * scale; def use(x): Number = factor(x) + 1; map(use,list(1,2)); }\ndef shadow(scale) { def middle(scale) { def result(x) = scale * x; result; } middle(11); }\ndef flow(scale) = 1 .. 5 |> map(x => x * scale) |> foldl((sum,x) => sum + x,0);\ndef capture(noise,scale) = x => x * scale;\ndef coordinates(stop) = stop + 1;\ndef invoke(stop) = stop(4);\ndef retain(fail) = () => fail;\ndef via(store) = 2 |> store(3);\ndef offer(a,b,c) = a + b + c;\ndef locals() { let stop = 8; let fail = 6; stop + fail; }\ndef nested(scale) = bias => x => x * scale + bias;\nlet a = make(7); let b = make(9); let c = shadow(99);\nlet checkpoint = list(1,2) |> store;\nlet values = choice { fail; 0; form_error(\"unselected\"); };\nif flow(3) == 30 && capture(99,3)(4) == 12 && nested(3)(2)(4) == 14 && (1 ? 42 : form_error(\"unselected\")) == 42 && (try stop catch restore(checkpoint)) == checkpoint && undo(fail,checkpoint,list(9)) == checkpoint && values == 0 && (1 |> and(0)) == 0 && a(2) == 14 && b(2) == 18 && a(3) == 21 && c(2) == 22 && siblings(5) == list(6,11) && coordinates(3) == 4 && invoke(x => x + 1) == 5 && retain(9)() == 9 && via((a,b) => a + b) == 5 && offer(1,2,3) == 6 && locals() == 14 then 42 else form_error(\"local function capture differs\");\n}\n");
   nth(r,0) == 0 && nth(r,1) == "42\n";
  }
  def fcrb-refuses(ctx) {
   def refuses(id,source,diagnostic) {
    let r = fcrb-run(ctx,id,str_concat("section [form.bml] {\n",str_concat(source,"\n}\n")));
    nth(r,0) != 0 && nth(r,1) == "" && str_find(nth(r,2),diagnostic,0) >= 0 &&
     str_find(nth(r,2),str_concat(fcrb-root(ctx),str_concat("/",str_concat(int_to_str(id),".bml"))),0) >= 0;
   }
   refuses(2,"def f(x) = x + 1; class K { bogus } f(1);","unrecognized form.bml class member: bogus") &&
    refuses(3,"fail(1);","intrinsic call requires 0 arguments; got 1") &&
    refuses(4,"repeat(1,2,3,4);","intrinsic call requires 5 arguments; got 4") &&
    refuses(5,"1 |> and(0,1);","boolean call requires 2 arguments; got 3");
  }
 }
 let ctx = fcrb-fresh();
 if nothing?(ctx) then form_error("cursor reader witness needs a fresh directory") else 0;
 live-claims("form-bml-cursor-reader-band", ctx, list(list("runs", 1, 1, fcrb-runs), list("refuses", 2, 1, fcrb-refuses)));
}
