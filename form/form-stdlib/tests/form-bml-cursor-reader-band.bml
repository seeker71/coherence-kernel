; Verdict 3 when the source compiler reads form.bml with the cursor:
;   1   a section the cursor reads whole compiles and runs: 42
;   2   a section it does not read is refused with the file's line and the first word the cursor could
;       not read there: line 3, class
; PROOF LEVEL: FOURTH-ARM ONLY -- the witness compiles each source in an fkwu child (host_spawn_at) and
; reads its stdout and stderr, so its subject is fkwu's own source runner
// The source compiler reads a form.bml section with the cursor (R144). Each claim is a live step
// (form-stdlib/bml/live.bml), spoken as it lands; a claim that does not hold needs the source
// compiler's code, and the turn that reads this band carries that.
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml
section [form.bml] {
 class CursorReaderBand {
  def fcrb-root(ctx) = nth(ctx, 1);
  def fcrb-fresh() {
   let root = str_concat("/tmp/form-cursor-reader-", int_to_str(now_unix_ms()));
   if ((Comparable) host_dir_mkdir(root) == 1) then list("reader", root) else nothing();
  }
  def fcrb-run(ctx, id, text) {
   let base = str_concat(fcrb-root(ctx), str_concat("/", int_to_str(id)));
   let path = str_concat(base, ".bml");
   write_file(path, text);
   let pid = host_spawn_at(list("./fkwu", path), list("/dev/null", str_concat(base, ".stdout"), str_concat(base, ".stderr")));
   let status = if (pid <= 0) then -1 else host_wait(pid);
   list(status, read_file(str_concat(base, ".stdout")), read_file(str_concat(base, ".stderr")));
  }
  def fcrb-runs(ctx) {
   let r = fcrb-run(ctx, 1, "section [form.bml] {\ndef f(x) = x + 1;\nf(41);\n}\n");
   if (((Comparable) nth(r, 0) == 0) && ((String) nth(r, 1) == "42\n")) then 1 else 0;
  }
  def fcrb-refuses(ctx) {
   let r = fcrb-run(ctx, 2, "section [form.bml] {\ndef f(x) = x + 1;\nclass K { bogus }\nf(1);\n}\n");
   if ((!((Comparable) nth(r, 0) == 0)) && (str_find(nth(r, 2), "the cursor does not read this form.bml section: line 3: class", 0) >= 0)) then 1 else 0;
  }
 }
 let ctx = fcrb-fresh();
 if nothing?(ctx) then form_error("cursor reader witness needs a fresh directory") else 0;
 live-claims("form-bml-cursor-reader-band", ctx, list(list("runs", 1, 1, fcrb-runs), list("refuses", 2, 1, fcrb-refuses)));
}
