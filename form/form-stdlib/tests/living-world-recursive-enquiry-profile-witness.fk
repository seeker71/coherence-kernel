; living-world-recursive-enquiry-profile-witness.fk -- a learned successor
; opens its own consented possibility field and retains finite-space sameness
; without choosing or collapsing provenance-distinct Recipes.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-prospective-suite.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk

(let LWRPW-LEFT     (bp "LWRPW-LEFT"))
(let LWRPW-RIGHT    (bp "LWRPW-RIGHT"))
(let LWRPW-EVIDENCE (bp "LWRPW-EVIDENCE"))
(let LWRPW-REASON   (bp "LWRPW-REASON"))
(let LWRPW-RESULT   (bp "LWRPW-RESULT"))

(defn lwrpw-cell (kind) (intern_node kind (empty)))
(defn lwrpw-left () (lwrpw-cell LWRPW-LEFT))
(defn lwrpw-right () (lwrpw-cell LWRPW-RIGHT))
(defn lwrpw-evidence () (lwrpw-cell LWRPW-EVIDENCE))
(defn lwrpw-reason () (lwrpw-cell LWRPW-REASON))

(defn lwrpw-values ()
    (lwo-field
        (list
            (intern_trivial_int (sub 0 3))
            (intern_trivial_int (sub 0 2))
            (intern_trivial_int (sub 0 1))
            (intern_trivial_int 0) (intern_trivial_int 1)
            (intern_trivial_int 2) (intern_trivial_int 3)
            (intern_trivial_int 4) (intern_trivial_int 5)
            (intern_trivial_int 6))))

(defn lwrpw-blueprint ()
    (lwbb-blueprint
        (lwbb-slots
            (list
                (lwbb-slot "left" (lwrpw-left)
                    (lwrpw-values) (lwrpw-evidence))
                (lwbb-slot "right" (lwrpw-right)
                    (lwrpw-values) (lwrpw-evidence))))
        (lwo-empty-field) (lwlc-unknown (lwrpw-evidence))
        (lwrpw-evidence)))

(defn lwrpw-entry (source payload)
    (lwphw-entry source (lwrpw-evidence) payload))

(defn lwrpw-binding-entries (source items entries)
    (if (eq (len items) 0) entries
        (do
            (let binding (head items))
            (let projection (lwre-binding-projection binding))
            (lwrpw-binding-entries source (tail items)
                (cons (lwrpw-entry source binding)
                    (cons (lwrpw-entry source
                            (lwre-binding-source binding))
                        (cons (lwrpw-entry source projection)
                            (cons (lwrpw-entry source
                                    (lwre-projection-scope projection))
                                entries))))))))

(defn lwrpw-space-entries (source items entries)
    (if (eq (len items) 0) entries
        (lwrpw-space-entries source (tail items)
            (lwrpw-binding-entries source
                (lwre-binding-items (head items)) entries))))

(defn lwrpw-result
    (active blueprint bindings world space enquiry profiles classes class
     revoked stale)
    (intern_node LWRPW-RESULT
        (list active blueprint bindings world space enquiry profiles classes
              class revoked stale)))

(defn lwrpw-run ()
    (do
        ; The active loop owns and streams its own initial framebuffer window.
        (let active (lwhlw-run))
        (let base (nth (node_children active) 0))
        (let arriving (nth (node_children active) 2))
        (let tissue (lwps-candidate-model arriving))
        (let started
            (lcfb-open-stream "living-world-recursive-enquiry-profile"
                "form-native" "lwrpw-run"
                "successor-to-offered-profile-classes"
                "form/form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk"
                83 1))

        (let blueprint (lwrpw-blueprint))
        (let bindings (lwbb-expand blueprint))
        (let blueprint-world
            (lwt-receive-stream base
                (list (lwphw-entry-m blueprint) (lwphw-entry-n blueprint))))
        (let dependency-world
            (lwt-receive-stream blueprint-world
                (append
                    (lwrpw-space-entries (lwphw-source-m)
                        (lwo-field-items bindings) (empty))
                    (lwrpw-space-entries (lwphw-source-n)
                        (lwo-field-items bindings) (empty)))))
        (let expand-frame
            (lcfb-call-stream "living-world-recursive-enquiry-profile"
                "blueprint" "leave" "form-native" "lwbb-expand"
                "slots:2:values-each:10:bindings:100:scoped:1" 1 started
                "form/form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk"
                103 1))

        (let space
            (lwhe-space tissue bindings (lwo-empty-field)
                (lwlc-unknown blueprint) (lwo-none) blueprint))
        (let world
            (lwt-receive-stream dependency-world
                (list (lwphw-entry-m space) (lwphw-entry-n space))))
        (let enquiry (lwhe-enquiry-for world space 2))
        (let enquiry-frame
            (lcfb-call-stream "living-world-recursive-enquiry-profile"
                "enquiry" "leave" "form-native" "lwhe-enquiry-for"
                "trials:100:separating:0:aligned:100" 2 started
                "form/form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk"
                116 1))

        (let profiles (lwep-profiles-for enquiry))
        (let classes (lwep-classes-for enquiry))
        (let class (head (lwo-field-items classes)))
        (let profile-frame
            (lcfb-call-stream "living-world-recursive-enquiry-profile"
                "profiles" "leave" "form-native" "lwep-classes-for"
                "hypotheses:2:profile-classes:1:finite-unknown:1:no-collapse"
                3 started
                "form/form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk"
                128 1))

        ; Withdrawing one of the two exact space offers closes recurrence.  The
        ; historical enquiry and class remain cells, but neither stays current.
        (let revocation
            (lwo-revocation space (lwphw-source-m) (lwrpw-reason)
                (lwphw-prov-m)))
        (let revoked
            (lwt-receive-stream world (list (lwphw-entry-m revocation))))
        (let stale (lwhe-enquiry-for revoked space 2))
        (let revoke-frame
            (lcfb-call-stream "living-world-recursive-enquiry-profile"
                "revocation" "leave" "form-native"
                "lwo-revocation/lwep-class-current?"
                "space-recurrence:1->0:class-current:1->0:history-retained"
                4 started
                "form/form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk"
                143 1))
        (lwrpw-result active blueprint bindings world space enquiry profiles
            classes class revoked stale)))

0
