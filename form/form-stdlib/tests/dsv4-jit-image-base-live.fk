; Live Form-emitted ARM64 image-base resolver.
;
; The emitted bytes make Darwin getpid(2) and proc_info(2) syscalls directly.
; PROC_PIDREGIONINFO at address 0 returns the first mapped region. For a Mach-O
; executable that is the main image's __PAGEZERO; pri_address is therefore the
; ASLR-adjusted image base. No C function, dlsym, shell lookup, or stored runtime
; pointer participates in the resolution.
;
; The machine result is shifted left once before returning because
; native_call_bytes speaks the tagged Form Value ABI.
;
; witnessed: 2026-07-28 -> nonzero ASLR-adjusted live image base
;
; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk

(do
    (defn djib-image ()
        (fa-image
            (list
                ; 96-byte proc_regioninfo result on the native stack.
                (fa-sub-x-imm 31 31 96)

                ; pid = getpid(): Darwin UNIX syscall 20.
                (fa-movz-x 16 20)
                (fa-movk-x-16 16 512)
                (fa-svc 128)
                (fa-mov 1 0)

                ; proc_info(PROC_INFO_CALL_PIDINFO=2, pid,
                ;           PROC_PIDREGIONINFO=7, address=0, sp, 96)
                (fa-movz-x 0 2)
                (fa-movz-x 2 7)
                (fa-movz-x 3 0)
                (fa-add-x-imm 4 31 0)
                (fa-movz-x 5 96)
                (fa-movz-x 16 336)
                (fa-movk-x-16 16 512)
                (fa-svc 128)

                ; proc_regioninfo.pri_address is byte offset 80 (scaled index 10).
                ; Return it as a tagged Form integer.
                (fa-ldr 0 31 10)
                (fa-lsl-x-imm 0 0 1)
                (fa-add-x-imm 31 31 96)
                (fa-ret))))

    (native_call_bytes (djib-image) 0))
