; offline-exam-band.bml — the exam with the network denied (observe/offline-exam-run.bml, form-stdlib/bml/offline-exam.bml), fkwu-witnessed.
;
; The door runs in its planted lane: the witness and the control are real (a real sandbox-exec, a real loopback port), the answers are planted in place of the voice, rows land in a scratch ledger. No model opens.
;
; Expected: 255
; Verdict 255 when every claim lands:
;   1   denied: under the door's own profile each of the five kinds lands network_denied 1, and the control connected; under a profile that allows the network the witness connects, the row reads network_denied 0, answered 0, graded 0, status not-asked: the denial is observed, never declared
;   2   keys: the true answer of each of the five kinds reads answered 1 graded 1
;   4   plants: a wrong answer of each of the five kinds reads graded 0 with the key it missed named, answered stays 1; a key whose text left the body reads key-gone, a door's silence reads answered 0
;   8   row: when the host names no session, what an asker with no id reads here ("" on the schedule, the rented mark beneath a rented mind), rent_tokens 0, a wall_ms, kind, exam, in the ledger the door was told, and the session's id when the host names one
;   16  refusal: another host is refused by name, exit non-zero, and no row lands; planted answers with no ledger of their own are refused
;   32  bound: a window that has passed reads each kind unread by name with no row, a set unread by name, and the reading door names the scenarios it did not reach and lands no row
;   64  exam: exactly the five kinds, every key's path standing and holding its text today, every exam a floor and a cap, the plan's target standing and a request id the register reads past; the rotation brings each set to the front in turn
;   128 wiring: the walk begins the door after the page and before the reading, the day's turn does not, the landing carries the exam's ledger and both alignment ledgers, and no part of the walk grew past the part-size limit
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/offline-exam.bml form-stdlib/bml/host-walk.bml
section [form.bml] {
 class OfflineExamBand {
  def oeb-dir() = ".hearth/offline-exam-band";
  def oeb-door() = ["env", "-u", "CLAUDE_CODE_SESSION_ID", "./fkwu", "observe/offline-exam-run.bml"];
  def oeb-kinds() = ["structural", "lookup", "prose", "code", "plan"];
  def oeb-has?(hay, needle) = str_find(hay, needle, 0) >= 0;
  def oeb-run-door(name, argv, request) = hch-run-in(oeb-dir() ++ "/io", name, argv, request, hch-by(600000));
  def oeb-ledger(name) = oeb-dir() ++ "/" ++ name ++ ".jsonl";
  def oeb-rows(name) = ep-text-rows(oeb-ledger(name));
  def oeb-row(name, kind) = foldl((found, r) => (String) fcgp-str(r, "kind") == kind ? r : found, json-node-object([]), oeb-rows(name));
  def oeb-n(row, key) = fcgp-num(row, key) ?? -1;
  def oeb-answer(kind, status, answer) = json-emit(json-node-object([fhn-s("kind", kind), fhn-s("status", status), fhn-s("answer", answer)])) ++ "\n";
  def oeb-code-result(text) = json-emit(json-node-object([fhn-s("schema", "form-native-code-v1"), fhn-s("status", "complete"), fhn-n("release_ok", 1), fhn-n("generated_ids", 9), json-node-pair("documents", json-node-array([json-node-object([fhn-s("path", "exam/state.txt"), fhn-s("text", text)])]))]));
  def oeb-after() = "# an offline exam fixture\nmode=resident\nstate=warm\n";
  def oeb-plan-line(tail) = "request=offline-exam-plan band=model/fixtures/offline-exam/exam.jsonl full=7 today=3 " ++ tail;
  def oeb-find-line() = "observe/form-find-ask.bml:" ++ oex-line-no("observe/form-find-ask.bml", "def ffa-run(").str() ++ ":  def ffa-run() = x";
  def oeb-true() = oeb-answer("structural", "answered", oeb-find-line()) ++ oeb-answer("lookup", "answered", "value=axioms/core-axioms.form: the smallest set") ++ oeb-answer("prose", "answered", "It is its transitions times its context.") ++ oeb-answer("code", "answered", oeb-code-result(oeb-after())) ++ oeb-answer("plan", "answered", oeb-plan-line("exit=0 verdict=verified ids=9 right=7"));
  def oeb-wrong() = oeb-answer("structural", "answered", "observe/form-path-ask.bml:9: def ffa-run") ++ oeb-answer("lookup", "answered", "value=receipts/somewhere.md: something") ++ oeb-answer("prose", "answered", "It costs a great deal.") ++ oeb-answer("code", "answered", oeb-code-result("state=cold\n")) ++ oeb-answer("plan", "answered", "request=offline-exam-plan band=model/fixtures/offline-exam/exam.jsonl full=7 today=7");
  def oeb-request(answers, ledger) = "{\"answers\":\"" ++ answers ++ "\",\"ledger\":\"" ++ ledger ++ "\",\"sets\":\"none\"}\n";
  def oeb-all-rows?(name) = all?(k => (String) fcgp-str(oeb-row(name, k), "kind") == k, oeb-kinds());
  // ---- 1 denied --------------------------------------------------------------------------------------------------------
  def oeb-c-denied(ctx) {
   let open = oeb-row("open", "structural");
   oeb-all-rows?("true") && all?(k => (Comparable) oeb-n(oeb-row("true", k), "network_denied") == 1, oeb-kinds())
   && (Comparable) oeb-n(open, "network_denied") == 0 && (Comparable) oeb-n(open, "answered") == 0 && (Comparable) oeb-n(open, "graded") == 0 && (String) fcgp-str(open, "status") == "not-asked" && oeb-has?(fcgp-str(open, "failed"), "the witness connected");
  }
  // ---- 2 keys ----------------------------------------------------------------------------------------------------------
  def oeb-c-keys(ctx) = all?(k => (Comparable) oeb-n(oeb-row("true", k), "answered") == 1 && (Comparable) oeb-n(oeb-row("true", k), "graded") == 1, oeb-kinds());
  // ---- 4 plants --------------------------------------------------------------------------------------------------------
  def oeb-misses?(kind, needle) = (Comparable) oeb-n(oeb-row("wrong", kind), "answered") == 1 && (Comparable) oeb-n(oeb-row("wrong", kind), "graded") == 0 && oeb-has?(fcgp-str(oeb-row("wrong", kind), "failed"), needle);
  def oeb-gone-exam() = parse-json("gone", "{\"kind\":\"lookup\",\"keys\":[{\"path\":\"axioms/core-axioms.form\",\"holds\":\"a text no axiom holds zz9\"}]}");
  def oeb-exam(kind) = foldl((found, r) => (String) fcgp-str(r, "kind") == kind ? r : found, nothing(), ep-text-rows(oex-exams()));
  def oeb-why(kind, answer) = str-join-with(oex-failed(oeb-exam(kind), answer), ",");
  // the answers that read true while false: a warning naming the door, a true path ranked below a wrong one, a band that crashed, a plan the planner refused, a voice that spoke no id, a band blind to the right function
  def oeb-sly() = oeb-has?(oeb-why("structural", "fkwu: warning: observe/form-find-ask.bml.fkb: bml cache does not match today's bytes"), "line:") && oeb-has?(oeb-why("lookup", "value=receipts/x.md: the smallest set | axioms/core-axioms.form"), "leads:")
   && oeb-has?(oeb-why("plan", oeb-plan-line("exit=1 verdict=verified ids=9 right=7")), "band-exit:1") && oeb-has?(oeb-why("plan", oeb-plan-line("exit=0 verdict=rejected ids=9 right=7")), "plan-not-verified:rejected") && oeb-has?(oeb-why("plan", oeb-plan-line("exit=0 verdict=verified ids=0 right=7")), "voice-silent") && oeb-has?(oeb-why("plan", oeb-plan-line("exit=0 verdict=verified ids=9 right=0")), "band-not-turned:0/7")
   && oeb-has?(oeb-why("code", "{\"schema\":\"form-native-code-v1\",\"status\":\"complete\",\"release_ok\":1,\"documents\":[]}"), "voice-silent");
  // the door's children: the exam is the asker they name, each inside the profile, and structural is asked cold
  def oeb-inside() {
   let argv = oex-denied("p.sb", "d.bml");
   any?(a => (String) a == "CLAUDE_CODE_SESSION_ID=offline-exam", argv) && any?(a => (String) a == "FORM_FIND_COLD=1", argv) && any?(a => (String) a == "sandbox-exec", argv) && oeb-has?(read_file("observe/form-find-ask.bml") ?? "", "FORM_FIND_COLD");
  }
  def oeb-c-plants(ctx) = oeb-sly() && oeb-inside() && (Comparable) host_path_exists(oex-home() ++ "/planted/lookup.last") == 1 && oeb-misses?("structural", "names:observe/form-find-ask.bml") && oeb-misses?("lookup", "names:axioms/core-axioms.form") && oeb-misses?("prose", "says:transitions") && oeb-misses?("code", "document-differs:exam/state.txt") && oeb-misses?("plan", "band-not-open:7/7")
   && any?(w => ep-starts?(w, "key-gone:"), oex-failed(oeb-gone-exam(), "axioms/core-axioms.form")) && oeb-has?(str-join-with(oex-failed(parse-json("none", "{\"kind\":\"lookup\"}"), "anything"), ","), "no-key")
   && (Comparable) oeb-n(oeb-row("silent", "lookup"), "answered") == 0 && (Comparable) oeb-n(oeb-row("silent", "lookup"), "graded") == 0;
  // ---- 8 row -----------------------------------------------------------------------------------------------------------
  def oeb-c-row(ctx) {
   let r = oeb-row("true", "lookup");
   let named = oeb-row("named", "lookup");
   (String) fcgp-str(r, "session") == lrun-session-of("", crd-host-row, crd-host-row(host_pid())) && fcgp-present?(r, "session") &&(Comparable) oeb-n(r, "rent_tokens") == 0 && oeb-n(r, "wall_ms") >= 0 && (String) fcgp-str(r, "exam") == "where-the-axioms-live" && (String) fcgp-str(named, "session") == "a-session";
  }
  // ---- 16 refusal ------------------------------------------------------------------------------------------------------
  def oeb-c-refusal(ctx) {
   let r = oeb-run-door("linux", oeb-door(), "{\"host\":\"Linux\",\"ledger\":\"" ++ oeb-ledger("linux") ++ "\",\"sets\":\"none\"}\n");
   let p = oeb-run-door("noledger", oeb-door(), "{\"answers\":\"" ++ oeb-dir() ++ "/true.answers\",\"sets\":\"none\"}\n");
   (Comparable) (r[0] ?? 0) != 0 && oeb-has?(r[1], "this host (Linux) carries no sandbox-exec") && nil?(oeb-rows("linux")) && (Comparable) (p[0] ?? 0) != 0 && oeb-has?(p[1], "planted answers name their own ledger");
  }
  // ---- 32 bound --------------------------------------------------------------------------------------------------------
  def oeb-c-bound(ctx) {
   let r = oeb-run-door("late", oeb-door(), "{\"until_ms\":1,\"answers\":\"" ++ oeb-dir() ++ "/true.answers\",\"ledger\":\"" ++ oeb-ledger("late") ++ "\",\"sets\":\"model/fixtures/alignment/scenarios-4.jsonl\"}\n");
   let scens = len(ep-text-rows("model/fixtures/alignment/scenarios-4.jsonl"));
   let before = file_size("receipts/alignment-ledger.jsonl");
   let reading = oeb-run-door("reading", ["./fkwu", "observe/alignment-read-run.bml"], "{\"until_ms\":1,\"fixtures\":\"model/fixtures/alignment/scenarios-4.jsonl\"}\n");
   hch-ok?(r) && nil?(oeb-rows("late")) && all?(k => oeb-has?(r[1], "[offline-exam] " ++ k ++ ": unread this night"), oeb-kinds()) && oeb-has?(r[1], "scenarios-4.jsonl: unread this night")
   && hch-ok?(reading) && oeb-has?(reading[1], "[alignment] unread " ++ scens.str() ++ " by the window: s4-val-own-data,") && oeb-has?(reading[1], "scenarios=0 ") && (Comparable) file_size("receipts/alignment-ledger.jsonl") == before;
  }
  // ---- 64 exam ---------------------------------------------------------------------------------------------------------
  def oeb-key-stands?(key) = !fcgp-present?(key, "path") || oex-holds?(fcgp-str(key, "path"), fcgp-str(key, "holds"));
  def oeb-c-exam(ctx) {
   let rows = ep-text-rows(oex-exams());
   let plan = foldl((found, r) => (String) fcgp-str(r, "kind") == "plan" ? r : found, nothing(), rows);
   let sets = ["a", "b", "c", "d"];
   (Comparable) len(rows) == 5 && all?(k => any?(r => (String) fcgp-str(r, "kind") == k, rows), oeb-kinds())
   && all?(r => !nil?(oex-keys(r)) && all?(key => oeb-key-stands?(key), oex-keys(r)) && (fcgp-num(r, "floor_ms") ?? 0) > 0 && (fcgp-num(r, "cap_ms") ?? 0) >= (fcgp-num(r, "floor_ms") ?? 0), rows)
   && all?(p => (Comparable) host_path_exists(json-string-value(p)) == 1, json-array-elements(json-object-get(fcgp-obj(plan, "request"), "files")))
   && oeb-has?(fhn-read("learn/offline-voice-gaps.jsonl"), "\"request\":{\"!=\":\"" ++ fcgp-str(fcgp-obj(plan, "request"), "id") ++ "\"}")
   && all?(i => (String) oex-rotate(sets, i)[0] == nth(sets, i), range(0, 4)) && (Comparable) len(oex-rotate(sets, 5)) == 4;
  }
  // ---- 128 wiring ------------------------------------------------------------------------------------------------------
  def oeb-c-wiring(ctx) {
   let night = read_file("observe/scheduled-walk.bml") ?? "";
   let day = read_file("observe/day-turn.bml") ?? "";
   str_find(night, "let build = hw-build()", 0) < str_find(night, "hw-exam(until)", 0) && str_find(night, "hw-exam(until)", 0) < str_find(night, "hw-safe-skips?(safe, \"turns\")", 0) && !oeb-has?(day, "hw-exam")
   && all?(p => any?(q => (String) q == p, hw-learned()), ["receipts/offline-exam-ledger.jsonl", "receipts/alignment-ledger.jsonl", "receipts/alignment-axis-ledger.jsonl"])
   && any?(d => (String) d == hw-exam-door(), hw-walk-doors()) && any?(s => (String) s == "exam", hw-safe-steps())
   && file_size("form/form-stdlib/bml/host-walk-learn.bml") < 12000 && file_size("form/form-stdlib/bml/host-walk-exam.bml") > 0 && file_size("form/form-stdlib/bml/host-walk-exam.bml") < 12000;
  }
  def oeb-clean() = fs-remove-tree(oeb-dir());
  def oeb-make() {
   let swept = oeb-clean();
   let made = hch-mkdirs(oeb-dir() ++ "/io");
   let t = write_file_text(oeb-dir() ++ "/true.answers", oeb-true());
   let w = write_file_text(oeb-dir() ++ "/wrong.answers", oeb-wrong());
   let s = write_file_text(oeb-dir() ++ "/silent.answers", oeb-answer("lookup", "exit 1", ""));
   write_file_text(oeb-dir() ++ "/open.sb", "(version 1)\n(allow default)\n");
  }
  def oeb-run() {
   let made = oeb-make();
   let t = oeb-run-door("true", oeb-door(), oeb-request(oeb-dir() ++ "/true.answers", oeb-ledger("true")));
   let w = oeb-run-door("wrong", oeb-door(), oeb-request(oeb-dir() ++ "/wrong.answers", oeb-ledger("wrong")));
   let o = oeb-run-door("open", oeb-door(), "{\"answers\":\"" ++ oeb-dir() ++ "/true.answers\",\"ledger\":\"" ++ oeb-ledger("open") ++ "\",\"sets\":\"none\",\"kinds\":\"structural\",\"profile\":\"" ++ oeb-dir() ++ "/open.sb\"}\n");
   let s = oeb-run-door("silent", oeb-door(), "{\"answers\":\"" ++ oeb-dir() ++ "/silent.answers\",\"ledger\":\"" ++ oeb-ledger("silent") ++ "\",\"sets\":\"none\",\"kinds\":\"lookup\"}\n");
   let n = oeb-run-door("named", ["env", "CLAUDE_CODE_SESSION_ID=a-session", "./fkwu", "observe/offline-exam-run.bml"], "{\"answers\":\"" ++ oeb-dir() ++ "/true.answers\",\"ledger\":\"" ++ oeb-ledger("named") ++ "\",\"sets\":\"none\",\"kinds\":\"lookup\"}\n");
   let verdict = live-claims("offline-exam-band", 0, [["denied", 1, 1, oeb-c-denied], ["keys", 2, 1, oeb-c-keys], ["plants", 4, 1, oeb-c-plants], ["row", 8, 1, oeb-c-row], ["refusal", 16, 1, oeb-c-refusal], ["bound", 32, 1, oeb-c-bound], ["exam", 64, 1, oeb-c-exam], ["wiring", 128, 1, oeb-c-wiring]]);
   let cleaned = oeb-clean();
   verdict;
  }
 }
 oeb-run();
}
