; living-world-enquiry-gap-band.fk -- an active path asks and answers locally.
; Verdict 32767 proves fifteen autonomous-gap, consent, trace, and staleness properties.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-enquiry.fk form-stdlib/living-world-enquiry-answer.fk form-stdlib/tests/living-world-concept-witness.fk form-stdlib/tests/living-world-enquiry-witness.fk

(do
    (let setup (lwenw-setup))
    (let world (lwenw-world setup))
    (let proposals (lwen-question-proposals world))
    (let question-proposal
        (lwenw-chain-question-proposal setup proposals))
    (let question-candidate
        (lwt-proposal-candidate question-proposal))
    (let question (lwo-emergent-shape question-candidate))
    (let route (head (lwo-field-items (lwen-question-routes question))))
    (let question-round
        (lwenw-round-with-proposal
            world question-proposal (lwenw-prior setup)))
    (let question-yes
        (lwenw-five-yes-round question-round question-proposal))
    (let question-integrated
        (lwen-integrate-question
            question-yes question-proposal (lwcxw-action)))
    (let question-world (lwt-round-world question-integrated))

    (let answer-proposal
        (lwen-answer-proposal question-world question-candidate))
    (let answer-candidate
        (lwt-proposal-candidate answer-proposal))
    (let answer (lwo-emergent-shape answer-candidate))
    (let answer-round
        (lwenw-round-with-proposal
            question-world answer-proposal question-integrated))
    (let answer-yes
        (lwenw-five-yes-round answer-round answer-proposal))
    (let answer-integrated
        (lwen-integrate-answer
            answer-yes answer-proposal (lwcxw-action)))
    (let answer-world (lwt-round-world answer-integrated))

    (let stale-question-round
        (lwenw-add-first-experience question-yes setup))
    (let stale-question
        (lwen-integrate-question
            stale-question-round question-proposal (lwcxw-action)))
    (let stale-answer-round
        (lwenw-add-first-experience answer-yes setup))
    (let stale-answer
        (lwen-integrate-answer
            stale-answer-round answer-proposal (lwcxw-action)))
    (let after-answer-proposals
        (lwen-question-proposals answer-world))

    (let c1 (if (eq (lwo-field-size proposals) 2) 1 0))
    (let c2 (if (and (node_eq (lwen-question-kind question) (lwen-gap))
                         (eq (lwo-field-size
                              (lwen-question-routes question)) 1)) 2 0))
    (let c3 (if (and (eq (lwo-field-size
                              (lwt-proposal-participants
                                  question-proposal)) 5)
                         (eq (lwo-field-size
                              (lwo-emergent-witnesses
                                  question-candidate)) 5)) 4 0))
    (let c4 (if (node_eq (lwen-route-output route)
                          (lwcxw-expected-output)) 8 0))
    (let c5 (if (and (node_eq
                          (lwcx-derivation-bridge
                              (lwen-route-derivation route))
                          (lwcxw-expected-bridge))
                         (node_eq (lwen-route-path route)
                                  (lwo-local-path))) 16 0))
    (let c6 (if (eq (len (node_children
                             (lwen-route-uncertainty route))) 2) 32 0))
    (let c7 (if (eq (lwo-world-has?
                         world question-candidate) 0) 64 0))
    (let c8 (if (and (eq (lwo-active?
                              question-world question-candidate) 1)
                         (eq (lwo-field-size
                              (lwo-active-attributions-for
                                  question-world question-candidate)) 5)) 128 0))
    (let c9 (if (and (node_eq (lwen-answer-output answer)
                               (lwcxw-expected-output))
                         (and (eq (oac-node? (lwen-answer-ack answer)) 1)
                              (node_eq (oac-payload (lwen-answer-ack answer))
                                       (lwen-route-derivation route)))) 256 0))
    (let c10 (if (and (eq (lwo-field-size
                               (lwen-answer-alternatives answer)) 1)
                          (eq (lwo-field-size
                               (lwen-answer-uncertainties answer)) 1)) 512 0))
    (let c11 (if (and (eq (lwo-field-size
                               (lwt-proposal-participants answer-proposal)) 5)
                          (eq (lwo-field-size
                               (lwo-emergent-witnesses answer-candidate)) 5)) 1024 0))
    (let c12 (if (and (eq (lwo-active?
                               answer-world answer-candidate) 1)
                          (eq (lwo-field-size
                               (lwo-active-attributions-for
                                   answer-world answer-candidate)) 5)) 2048 0))
    (let c13 (if (eq (lwenw-proposals-have-path?
                          (lwo-field-items after-answer-proposals)
                          (lwenw-chain-candidate setup)
                          (lwcxw-unseen-input)) 0) 4096 0))
    (let c14 (if (eq (lwo-world-has?
                          (lwt-round-world stale-question)
                          question-candidate) 0) 8192 0))
    (let c15 (if (and (eq (lwo-world-has?
                               (lwt-round-world stale-answer)
                               answer-candidate) 0)
                          (eq (lwo-active?
                               answer-world answer-candidate) 1)) 16384 0))
    (lwenw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
