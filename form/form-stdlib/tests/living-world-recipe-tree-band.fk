; living-world-recipe-tree-band.fk -- offered mixed-arity tree becomes one
; compatible attempt without becoming a hypothesis or answer.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk

(defn lwrtb-bit (ok bit) (if ok bit 0))

(defn lwrtb-run ()
    (do
        (let result (lwrtw-run))
        (let target (nth (node_children result) 1))
        (let tree (nth (node_children result) 2))
        (let open-field (nth (node_children result) 4))
        (let one-field (nth (node_children result) 6))
        (let two-world (nth (node_children result) 7))
        (let field (nth (node_children result) 8))
        (let candidate (nth (node_children result) 10))
        (let waiting (nth (node_children result) 11))
        (let admitted (nth (node_children result) 12))
        (let composition (nth (node_children result) 13))
        (let recipe (nth (node_children result) 14))
        (let revoked-world (nth (node_children result) 15))
        (let revoked-field (nth (node_children result) 16))
        (let events (nth (node_children result) 17))
        (let admitted-world (lwt-round-world admitted))
        (let target-shape (lwo-emergent-shape target))
        (let blueprint (lwrtw-tree-blueprint tree))
        (add
            (lwrtb-bit (and (eq (lwht-integrated-current?
                                    (nth (node_children result) 3) target) 1)
                             (eq (lwht-contradicted?
                                    (lwht-tissue-status target-shape)) 1)) 1)
            (add
            (lwrtb-bit (and (eq (lwrt-field? open-field) 1)
                             (eq (lwo-field-size
                                    (lwrt-field-blueprints open-field)) 0)) 2)
            (add
            (lwrtb-bit (eq (lwo-field-size
                                (lwrt-field-blueprints one-field)) 0) 4)
            (add
            (lwrtb-bit (eq (lwrt-tree-valid? (lwrtw-tree-root tree)) 1) 8)
            (add
            (lwrtb-bit (gt (str_len (lwrt-source-for
                                (lwrtw-tree-root tree))) 0) 16)
            (add
            (lwrtb-bit (eq (lwrt-tree-current? two-world
                                (lwrtw-tree-root tree) target 2) 1) 32)
            (add
            (lwrtb-bit (eq (lwo-field-size
                                (lwrt-field-blueprints field)) 1) 64)
            (add
            (lwrtb-bit (eq (lwo-field-size
                                (lwrt-field-compositions field)) 1) 128)
            (add
            (lwrtb-bit (eq (lwo-field-size
                                (lwrt-field-compatible field)) 1) 256)
            (add
            (lwrtb-bit (eq (lwo-field-size
                                (lwrt-field-divergent field)) 0) 512)
            (add
            (lwrtb-bit (eq (lwo-field-size
                                (lwrt-field-unresolved field)) 0) 1024)
            (add
            (lwrtb-bit (eq (lwhrn-ready?
                                (lwrt-field-status field)) 1) 2048)
            (add
            (lwrtb-bit (eq (lwo-field-size
                                (lwrt-composition-evaluations composition))
                                (lwo-field-size
                                    (lwht-tissue-placements target-shape))) 4096)
            (add
            (lwrtb-bit (eq (lwph-consistent?
                                (lwrt-composition-state composition)) 1) 8192)
            (add
            (lwrtb-bit (not (node_eq
                                (nth (node_children result) 9)
                                (lwo-none))) 16384)
            (add
            (lwrtb-bit (eq (lwo-active?
                                (lwt-round-world waiting) candidate) 0) 32768)
            (add
            (lwrtb-bit (eq (lwrt-integrated-current?
                                admitted-world candidate) 1) 65536)
            (add
            (lwrtb-bit (eq (lwre-recipe-valid? recipe) 1) 131072)
            (add
            (lwrtb-bit (eq (lwo-active? admitted-world recipe) 0) 262144)
            (add
            (lwrtb-bit (not (node_eq blueprint recipe)) 524288)
            (add
            (lwrtb-bit (eq (lwrt-field?
                                (lwo-emergent-shape candidate)) 1) 1048576)
            (add
            (lwrtb-bit (ge (lwo-field-size
                                (lwrt-field-alternatives field))
                                (lwo-field-size
                                    (lwht-tissue-alternatives target-shape)))
                                2097152)
            (add
            (lwrtb-bit (gt (lwo-field-size
                                (lwrt-field-unknowns field)) 0) 4194304)
            (add
            (lwrtb-bit (eq (lwph-active-source-count
                                two-world blueprint) 2) 8388608)
            (add
            (lwrtb-bit (eq (len events) 16) 16777216)
            (add
            (lwrtb-bit (eq (lwo-field-size
                                (lwrt-field-blueprints revoked-field)) 0)
                                33554432)
            (add
            (lwrtb-bit (eq (lwrt-candidate-current?
                                revoked-world candidate) 0) 67108864)
            (add
            (lwrtb-bit (eq (lwo-member?
                                (lwo-field-items
                                    (lwo-world-cells revoked-world))
                                blueprint) 1) 134217728)
            (add
            (lwrtb-bit (eq (lwht-integrated-current?
                                revoked-world target) 1) 268435456)
            (add
            (lwrtb-bit (eq (lwht-contradicted?
                                (lwht-tissue-status
                                    (lwo-emergent-shape target))) 1) 536870912)
            (lwrtb-bit (eq (lwph-hypothesis? composition) 0)
                1073741824)))))))))))))))))))))))))))))))))

(lwrtb-run)
