; jit-lower-self-crystallized-band.fk — one structural shape specialization is
; born, then threaded through an actual recursive jit-lower program flow.
; Fourth-arm verdict 4095.
;
; preludes: form-stdlib/jit-lower-self-crystallized.fk

(do
    (defn jlscb-bit (ok bit) (if ok bit 0))
    (defn jlscb-shapes-agree (handle tag bad)
        (if (ge tag 80) bad
            (jlscb-shapes-agree handle (add tag 1)
                (add bad (if (eq (jlsc-shape handle tag)
                                 (jit-shape tag)) 0 1)))))
    (defn jlscb-native-routes (handle tag bad)
        (if (ge tag 80) bad
            (jlscb-native-routes handle (add tag 1)
                (add bad (if (str_eq (nth (jlsc-shape-route handle tag) 0)
                                            "native") 0 1)))))
    (defn jlscb-program ()
        (list
            (fk-if (fk-le (fk-arg) (fk-lit 10))
                (fk-if (fk-le (fk-lit 0) (fk-arg))
                    (fk-lit 1) (fk-lit 0))
                (fk-lit 0))
            (fk-add (fk-lit 40) (fk-lit 2))
            (fk-closure-lifted 9 (fk-add (fk-lit 1) (fk-lit 2)))
            (fk-bmf-lowered (fk-add (fk-lit 40) (fk-lit 2)))))
    (defn jlscb-run-agree (a b i bad)
        (if (ge i (len a)) bad
            (jlscb-run-agree a b (add i 1)
                (add bad
                    (if (eq (fk-run (nth a i) 5)
                            (fk-run (nth b i) 5)) 0 1)))))
    (defn jit-lower-self-crystallized-band ()
        (do (let source (jlscb-program))
            (let expected (jit-lower-program source))
            (let result (jlsc-lower-program source))
            (let actual (jlsc-lowered result))
            (let handle (jlsc-handle result))
            (let identity (jssc-handle-identity handle))
            (let changed (jssc-birth
                (cons 9 (tail (jit-shape-table)))))
            (sum (list
                (jlscb-bit (eq (jlsc-births result) 1) 1)
                (jlscb-bit (str_eq (jlsc-route result) "native") 2)
                (jlscb-bit (eq (jlscb-shapes-agree handle 0 0) 0) 4)
                (jlscb-bit (eq (jlscb-native-routes handle 0 0) 0) 8)
                (jlscb-bit (value_eq actual expected) 16)
                (jlscb-bit (eq (jlscb-run-agree actual expected 0 0) 0) 32)
                (jlscb-bit (eq (fk-tag (nth actual 0)) 70) 64)
                (jlscb-bit (and (eq (fk-tag (nth actual 1)) 73)
                                 (eq (fk-run (nth actual 1) 0) 42)) 128)
                (jlscb-bit (and (eq (fk-tag (nth actual 2)) 77)
                                 (eq (fk-run (nth actual 2) 0) 3)) 256)
                (jlscb-bit (and (eq (fk-tag (nth actual 3)) 78)
                                 (eq (fk-run (nth actual 3) 0) 42)) 512)
                (jlscb-bit (and
                    (str_eq (nth (jssc-route-at handle identity 77) 0) "native")
                    (eq (jssc-apply-at handle identity 77) 4)) 1024)
                (jlscb-bit (and
                    (str_eq (nth (jssc-route-at handle
                                      (jssc-handle-identity changed) 77) 0)
                                "refused")
                    (nothing? (jssc-apply-at handle
                        (jssc-handle-identity changed) 77))) 2048)))))
    (jit-lower-self-crystallized-band))
