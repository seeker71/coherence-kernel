; form-cli-peer-hearth-telemetry-birth-band.fk -- a caller-born telemetry
; answer projects resident birth without a model or provider turn.
; Expected: 63
; preludes: form-stdlib/bml/form-cli-peer-hearth-telemetry-action.bml

(do
    (defn fcphtbb-bit (ok bit) (if ok bit 0))
    (let out "form-peer program-image-cache=ready\nform-peer source-context-ms=0\nform-peer native-program-ms=7\nform-peer resident-setup-ms=7\nform-peer admit-prefill-ms=11\n")
    (let snapshot (fcphta-snapshot "pid=71\ncapabilities=hearth-telemetry\n" 8 13 "turn=1\nelapsed-ms=3\nroute=hearth-telemetry\n" out))
    (let sparse (fcphta-snapshot "" 0 0 "" ""))
    (let response (fcphta-response snapshot))
    (let session (list "non-model-sentinel" 71))
    (let peer (fcphta-peer (fcphta-run session "hearth-telemetry" "birth")))
    (sum (list
        (fcphtbb-bit (and (eq (fcphta-snapshot? snapshot) 1)
            (str_eq (fcrbo-cache (fcphta-snapshot-birth snapshot)) "ready")) 1)
        (fcphtbb-bit (and (eq (fcrbo-source-context-ms (fcphta-snapshot-birth snapshot)) 0)
            (and (eq (fcrbo-native-program-ms (fcphta-snapshot-birth snapshot)) 7)
                (and (eq (fcrbo-resident-setup-ms (fcphta-snapshot-birth snapshot)) 7)
                     (eq (fcrbo-prefill-ms (fcphta-snapshot-birth snapshot)) 11)))) 2)
        (fcphtbb-bit (and (ge (str_find response "birth-cache=ready" 0) 0)
            (and (ge (str_find response "birth-source-context-ms=0" 0) 0)
                (and (ge (str_find response "birth-native-program-ms=7" 0) 0)
                    (and (ge (str_find response "birth-resident-setup-ms=7" 0) 0)
                         (ge (str_find response "birth-prefill-ms=11" 0) 0))))) 4)
        (fcphtbb-bit (and (nothing? (fcrbo-cache (fcphta-snapshot-birth sparse)))
            (and (nothing? (fcrbo-source-context-ms (fcphta-snapshot-birth sparse)))
                (nothing? (fcrbo-prefill-ms (fcphta-snapshot-birth sparse)))) ) 8)
        (fcphtbb-bit (and (value_eq (fcpa-session peer) session)
            (and (eq (fcpa-callback-calls peer) 0)
                (and (eq (fcpa-lookup-count peer) 0)
                     (str_eq (fcpa-carrier peer) "form-native-hearth")))) 16)
        (fcphtbb-bit (and (str_eq (fcrbo-display-int(fcrbo-source-context-ms (fcphta-snapshot-birth snapshot))) "0")
            (str_eq (fcrbo-display-int(fcrbo-source-context-ms (fcphta-snapshot-birth sparse))) "nothing")) 32))))
