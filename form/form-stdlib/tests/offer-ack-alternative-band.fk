; offer-ack-alternative-band.fk -- alternatives recur; time keeps its history.
; Verdict 32767 proves fifteen counter-offer, pending, expiry, and default claims.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk

(do
    (let reference
        (intern_node (bp "OACAB-REFERENCE")
            (list (intern_trivial_string "question"))))
    (let offered
        (intern_node (bp "OACAB-OFFERED")
            (list (intern_trivial_string "another-possibility"))))
    (let evidence
        (intern_node (bp "OACAB-EVIDENCE")
            (list (intern_trivial_string "observed-locally"))))
    (let alternative
        (oac-alternative reference offered evidence))
    (let alternative-ack
        (oac-alternative-ack reference offered evidence))
    (let expiration (intern_trivial_int 30))
    (let before (intern_trivial_int 29))
    (let at-expiry (intern_trivial_int 30))
    (let default-ack (oac-one offered))
    (let with-default
        (oac-timeout expiration default-ack evidence))
    (let without-default
        (oac-timeout expiration (oac-no-default) evidence))
    (let alternative-default
        (oac-timeout expiration alternative-ack evidence))
    (let pending
        (oac-timeout-condense with-default before))
    (let defaulted
        (oac-timeout-condense with-default at-expiry))
    (let silent-expiry
        (oac-timeout-condense without-default at-expiry))
    (let alternative-expiry
        (oac-timeout-condense alternative-default at-expiry))
    (let immediate-nothing (oac-nothing))

    (let c1 (if (eq (oac-alternative? alternative) 1) 1 0))
    (let c2 (if (node_eq
                    (oac-alternative-reference alternative)
                    reference) 2 0))
    (let c3 (if (node_eq
                    (oac-alternative-offered alternative)
                    offered) 4 0))
    (let c4 (if (node_eq
                    (oac-alternative-evidence alternative)
                    evidence) 8 0))
    (let c5 (if (and (eq (oac-node? alternative-ack) 1)
                         (eq (oac-alternative-ack?
                                alternative-ack) 1)) 16 0))
    (let c6 (if (and (eq (oac-timeout-valid? with-default) 1)
                         (node_eq
                            (oac-timeout-expiration with-default)
                            expiration)) 32 0))
    (let c7 (if (and (eq (oac-time-pending? pending) 1)
                         (node_eq
                            (oac-time-pending-observed pending)
                            before)) 64 0))
    (let c8 (if (and (eq (oac-time-outcome? defaulted) 1)
                         (node_eq
                            (oac-time-outcome-observed defaulted)
                            at-expiry)) 128 0))
    (let c9 (if (node_eq
                    (oac-time-outcome-ack defaulted)
                    default-ack) 256 0))
    (let c10 (if (and (eq (oac-time-outcome?
                               silent-expiry) 1)
                          (eq (oac-nothing?
                               (oac-time-outcome-ack
                                   silent-expiry)) 1)) 512 0))
    ; The terminal ack may share OAC-NOTHING identity, but its timed outcome
    ; is a distinct cell retaining contract and observed expiry.
    (let c11 (if (and (not (node_eq
                                silent-expiry immediate-nothing))
                          (node_eq
                            (oac-time-outcome-timeout silent-expiry)
                            without-default)) 1024 0))
    (let c12 (if (and (eq (oac-time-outcome?
                               alternative-expiry) 1)
                          (eq (oac-alternative-ack?
                               (oac-time-outcome-ack
                                   alternative-expiry)) 1)) 2048 0))
    (let c13 (if (and (node_eq
                           (oac-timeout-evidence with-default)
                           evidence)
                          (eq (oac-no-default?
                               (oac-timeout-default
                                   without-default)) 1)) 4096 0))
    (let c14 (if (and (node_eq
                           with-default
                           (oac-timeout expiration default-ack evidence))
                          (node_eq
                           defaulted
                           (oac-timeout-condense
                               with-default at-expiry))) 8192 0))
    ; Alternative remains NODE, and expired no-default remains NOTHING: the
    ; four acknowledgment tags have not grown a fifth state.
    (let c15 (if (and (eq (oac-kind alternative-ack)
                               (oac-tag-node))
                          (eq (oac-kind
                               (oac-time-outcome-ack silent-expiry))
                              (oac-tag-nothing))) 16384 0))
    (add c1
        (add c2
            (add c3
                (add c4
                    (add c5
                        (add c6
                            (add c7
                                (add c8
                                    (add c9
                                        (add c10
                                            (add c11
                                                (add c12
                                                    (add c13
                                                        (add c14 c15)))))))))))))))
