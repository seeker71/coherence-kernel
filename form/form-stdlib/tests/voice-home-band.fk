; voice-home-band.fk — a whole local adapter plus an utterance is home present.
;
; Verdict 3: 1 complete local voice state; 2 empty utterance does not pretend.
; preludes: form-stdlib/voice-home.fk

(do
    (defn vhb-artifact () (fs-path-join (fs-temp-dir) "voice-home-band.safetensors"))
    (defn vhb-utterance () (fs-path-join (fs-temp-dir) "voice-home-band.txt"))
    (let artifact (vhb-artifact))
    (let utterance (vhb-utterance))
    (let wrote (qlh-write artifact "one local utterance is present"))
    (let said (write_file utterance "We are here."))
    (sum (list
        (if (eq (vhome-local? artifact utterance) 1) 1 0)
        (if (eq (vhome-local? artifact "") 0) 2 0))))
