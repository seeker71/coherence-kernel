; preludes: form/form-stdlib/voice-score.bml
; Expected: 1023
; PROOF LEVEL: FKWU-STAGED — it preludes a .bml; no model, no Metal, no file is read.
;
; voice-score-band — the word and character error between a given text and a heard text, counted by
; the body, pinned on texts whose distance is known before the count.
;
; Verdict 1023:
;   1    the same text is distance zero in words and in characters
;   2    spelling that is not an error costs nothing: case, the curly quote, the possessive, -ise/-ize,
;        -our/-or, -ogue/-og, towards/toward, punctuation
;   4    one substituted word of four is one word error and one character error
;   8    an inserted word and a deleted word are each one error; an empty heard text costs every word
;   16   Persian: ZWNJ, the harakat, Arabic ya and Arabic kaf fold to the Persian forms and cost nothing
;   32   Portuguese: capitals with accents fold, and a dropped accent is one word error, one character error
;   64   a word is a run of letters with at most one inner apostrophe: rock'n'roll is two words, so
;        "rock n roll" is two edits away
;   128  the ratio prints four decimals rounded half up: 1/8 0.1250, 2/4 0.5000, 1/3 0.3333, 3/10000 0.0003
;   256  the tsv sums its rows (rows, word errors, words, char errors, chars) and names the rows done
;   512  a longer pair (56 words with 3 known edits) is counted in one row-wise pass and gives the 3
(do
    (defn vsb-bit (ok v) (if ok v 0))
    (defn vsb-s (r) (str_concat (str_concat (int_to_str (nth r 0)) ",") (str_concat (int_to_str (nth r 1)) (str_concat "," (str_concat (int_to_str (nth r 2)) (str_concat "," (int_to_str (nth r 3))))))))
    (defn vsb-row (tab i e n ce c) (str_concat i (str_concat tab (str_concat e (str_concat tab (str_concat n (str_concat tab (str_concat "t" (str_concat tab (str_concat "h" (str_concat tab (str_concat ce (str_concat tab (str_concat c (byte_to_str 10)))))))))))))))
    (let a (vsc-score "We are the operators." "We are the operators"))
    (let b0 (vsc-score "The Colour of the Organisation's glass, towards the dialogue; honour the realised." "the color of the organization glass toward the dialog honor the realized"))
    (let c (vsc-score "the quick brown fox" "the quick brown box"))
    (let d (vsc-score "one two three four five" "one two three five"))
    (let d2 (vsc-score "one two" "one extra two"))
    (let e (vsc-score "alpha beta gamma" ""))
    ; kaf ya fe + fatha, written in Arabic code points
    (let fa-ref (str_concat (byte_to_str 218) (str_concat (byte_to_str 169) (str_concat (byte_to_str 219) (str_concat (byte_to_str 140) (str_concat (byte_to_str 217) (byte_to_str 129)))))))
    (let fa-got (str_concat (byte_to_str 217) (str_concat (byte_to_str 131) (str_concat (byte_to_str 217) (str_concat (byte_to_str 138) (str_concat (byte_to_str 217) (str_concat (byte_to_str 129) (str_concat (byte_to_str 217) (str_concat (byte_to_str 142) (str_concat (byte_to_str 226) (str_concat (byte_to_str 128) (byte_to_str 140))))))))))))
    (let f (vsc-score fa-ref fa-got))
    (let f2 (vsc-score (str_concat fa-ref " x") (str_concat (str_concat fa-got " ") "y")))
    ; "Sao-with-tilde Paulo e-acute grande" against the same with a plain e: capitals fold, the dropped accent is one error
    (let sao (str_concat "S" (str_concat (byte_to_str 195) (str_concat (byte_to_str 163) "o"))))
    (let eacute (str_concat (byte_to_str 195) (byte_to_str 169)))
    (let g (vsc-score (str_concat sao (str_concat " Paulo " (str_concat eacute " grande"))) (str_concat "s" (str_concat (byte_to_str 195) (str_concat (byte_to_str 163) "o paulo e grande")))))
    (let h (vsc-score "rock'n'roll" "rock n roll"))
    (let w60 "alpha bravo charlie delta echo foxtrot golf hotel india juliet kilo lima mike november oscar papa quebec romeo sierra tango uniform victor whiskey xray yankee zulu alpha bravo charlie delta echo foxtrot golf hotel india juliet kilo lima mike november oscar papa quebec romeo sierra tango uniform victor whiskey xray yankee zulu alpha bravo charlie delta")
    (let w60h "alpha bravo charlie delta echo foxtrot golf hotel india juliet kilo lima mike november oscar papa quebec romeo SIERRA tango uniform whiskey xray yankee zulu alpha bravo charlie delta echo foxtrot gulf hotel india juliet kilo lima mike november oscar papa quebec romeo sierra tango uniform victor whiskey xray yankee zulu alpha bravo charlie delta extra")
    (let k (vsc-score w60 w60h))
    (let tab (byte_to_str 9))
    (let tsv (str_concat (vsb-row tab "0" "1" "4" "2" "20") (vsb-row tab "1" "0" "6" "0" "30")))
    (let t (vsc-sum tsv))
    (let done (vsc-done tsv))
    (let c0 (vsb-bit (and (eq (nth a 0) 0) (and (eq (nth a 1) 4) (and (eq (nth a 2) 0) (eq (nth a 3) 17)))) 1))
    (let c1 (vsb-bit (and (eq (nth b0 0) 0) (eq (nth b0 2) 0)) 2))
    (let c2 (vsb-bit (and (eq (nth c 0) 1) (and (eq (nth c 1) 4) (and (eq (nth c 2) 1) (eq (nth c 3) 16)))) 4))
    (let c3 (vsb-bit (and (eq (nth d 0) 1) (and (eq (nth d2 0) 1) (and (eq (nth e 0) 3) (eq (nth e 2) 14)))) 8))
    (let c4 (vsb-bit (and (eq (nth f 0) 0) (and (eq (nth f 2) 0) (and (eq (nth f2 0) 1) (eq (nth f2 1) 2)))) 16))
    (let c5 (vsb-bit (and (eq (nth g 0) 1) (and (eq (nth g 1) 4) (eq (nth g 2) 1))) 32))
    (let c6 (vsb-bit (and (eq (nth h 1) 2) (eq (nth h 0) 2)) 64))
    (let c7 (vsb-bit (and (str_eq (vsc-ratio 1 8) "0.1250") (and (str_eq (vsc-ratio 2 4) "0.5000") (and (str_eq (vsc-ratio 1 3) "0.3333") (str_eq (vsc-ratio 3 10000) "0.0003")))) 128))
    (let c8 (vsb-bit (and (eq (nth t 0) 2) (and (eq (nth t 1) 1) (and (eq (nth t 2) 10) (and (eq (nth t 3) 2) (and (eq (nth t 4) 50) (and (vsc-has? done 1) (vsc-has? done 0))))))) 256))
    (let c9 (vsb-bit (and (eq (nth k 1) 56) (eq (nth k 0) 3)) 512))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 c9))))))))))
