; form-recipe-birth-token-band.fk — scannerless affine signed-i32 recipe birth.
;
; Verdict 1048575 (20 bits):
;   1       markers and byte/render bounds are fixed
;   2       each input byte advances the cursor exactly once, pretokenized=0
;   4       partial prefix and body remain held rather than fabricated
;   8       ordinary text is nothing; malformed/trailing is failure
;   16      over-budget input is timeout and distinct from failure
;   32      canonical multiplier/addend 0 and 1 are valid recipe content
;   64      negative and signed-i32 endpoint values remain exact
;   128     leading-zero, plus-sign, overflow and extra fields fail
;   256     equal recipes share a NodeID; changed content does not
;   512     birth-token identity includes the exact interned recipe
;   1024    recipe shape exposes stable tag/mul/add/signed-i32 children
;   2048    ready/held/nothing/failure/timeout observations stay distinct
;   4096    ready lifecycle observes choice/crystallize/dissolve/release
;   8192    failure observes undo/refine; timeout additionally observes cut
;   16384   held remains open; nothing dissolves and releases
;   32768   equal birth observations share identity; changed content does not
;   65536   valid zero/one remain recipe-present, never observation nothing
;   131072  rendering returns recipe/birth/observation NodeIDs
;   262144  rendering is bounded and never reproduces the raw birth surface
;   524288  scannerless/model/carrier flags truthfully name this pure seam
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/form-recipe-birth-token.fk

(do
    (defn frbtb-bit (condition bit) (if condition bit 0))
    (defn frbtb-repeat (chunk n out)
        (if (eq n 0) out
            (frbtb-repeat chunk (sub n 1) (str_concat out chunk))))
    (defn frbtb-status-is? (surface status)
        (str_eq (frbt-result-status (frbt-parse-stream surface)) status))

    (defn form-recipe-birth-token-band ()
        (do
            (let zero-one-surface (frbt-surface 0 1))
            (let zero-one-result (frbt-parse-stream zero-one-surface))
            (let zero-one-result2 (frbt-parse-stream zero-one-surface))
            (let zero-one (frbt-result-recipe zero-one-result))
            (let changed-result (frbt-parse-stream (frbt-surface 1 0)))
            (let changed (frbt-result-recipe changed-result))
            (let negative-result (frbt-parse-stream (frbt-surface -3 -7)))
            (let negative (frbt-result-recipe negative-result))
            (let endpoints-result
                (frbt-parse-stream (frbt-surface -2147483648 2147483647)))
            (let endpoints (frbt-result-recipe endpoints-result))

            (let held-prefix (frbt-parse-cursor
                (frbt-feed-text "<|form:rec")))
            (let held-body (frbt-parse-cursor
                (frbt-feed-text "<|form:recipe-birth|>affine-i32;mul=0")))
            (let nothing-result (frbt-parse-stream "ordinary text"))
            (let malformed-result (frbt-parse-stream
                (str_concat (frbt-open)
                    (str_concat "affine-i32;mul=x;add=1" (frbt-close)))))
            (let trailing-result (frbt-parse-stream
                (str_concat zero-one-surface "x")))
            (let timeout-result (frbt-parse-stream (str_concat (frbt-open)
                (frbtb-repeat "0123456789" 20 ""))))

            (let invalids (list
                (str_concat (frbt-open)
                    (str_concat "affine-i32;mul=00;add=1" (frbt-close)))
                (str_concat (frbt-open)
                    (str_concat "affine-i32;mul=+1;add=1" (frbt-close)))
                (str_concat (frbt-open)
                    (str_concat "affine-i32;mul=2147483648;add=1" (frbt-close)))
                (str_concat (frbt-open)
                    (str_concat "affine-i32;mul=1;add=-2147483649" (frbt-close)))
                (str_concat (frbt-open)
                    (str_concat "affine-i32;mul=1;add=1;extra=0" (frbt-close)))))

            (let ready-observation (frbt-observe zero-one-result))
            (let ready-observation2 (frbt-observe zero-one-result2))
            (let changed-observation (frbt-observe changed-result))
            (let held-observation (frbt-observe held-body))
            (let nothing-observation (frbt-observe nothing-result))
            (let failure-observation (frbt-observe malformed-result))
            (let timeout-observation (frbt-observe timeout-result))
            (let rendered (frbt-render ready-observation))

            (sum (list
                (frbtb-bit (and
                    (str_eq (frbt-open) "<|form:recipe-birth|>")
                    (and (str_eq (frbt-close) "<|/form:recipe-birth|>")
                    (and (eq (frbt-max-payload-bytes) 64)
                         (eq (frbt-max-render-bytes) 1024)))) 1)
                (frbtb-bit (and
                    (eq (frbt-cursor-bytes
                            (frbt-result-cursor zero-one-result))
                        (str_len zero-one-surface))
                    (and (str_eq (frbt-cursor-frame
                                    (frbt-result-cursor zero-one-result))
                                 zero-one-surface)
                         (eq (frbt-result-pretokenized? zero-one-result) 0))) 2)
                (frbtb-bit (and (str_eq (frbt-result-status held-prefix) "held")
                                  (str_eq (frbt-result-status held-body) "held")) 4)
                (frbtb-bit (and (str_eq (frbt-result-status nothing-result)
                                        "nothing")
                    (and (str_eq (frbt-result-status malformed-result) "failure")
                         (str_eq (frbt-result-status trailing-result) "failure"))) 8)
                (frbtb-bit (and (str_eq (frbt-result-status timeout-result)
                                        "timeout")
                                  (not (str_eq (frbt-result-status timeout-result)
                                               (frbt-result-status malformed-result)))) 16)
                (frbtb-bit (and (str_eq (frbt-result-status zero-one-result) "ready")
                    (and (eq (frbt-recipe-mul zero-one) 0)
                         (eq (frbt-recipe-add zero-one) 1))) 32)
                (frbtb-bit (and (eq (frbt-recipe-mul negative) -3)
                    (and (eq (frbt-recipe-add negative) -7)
                    (and (eq (frbt-recipe-mul endpoints) -2147483648)
                         (eq (frbt-recipe-add endpoints) 2147483647)))) 64)
                (frbtb-bit (and
                    (frbtb-status-is? (nth invalids 0) "failure")
                    (and (frbtb-status-is? (nth invalids 1) "failure")
                    (and (frbtb-status-is? (nth invalids 2) "failure")
                    (and (frbtb-status-is? (nth invalids 3) "failure")
                         (frbtb-status-is? (nth invalids 4) "failure"))))) 128)
                (frbtb-bit (and
                    (node_eq zero-one (frbt-result-recipe zero-one-result2))
                    (not (node_eq zero-one changed))) 256)
                (frbtb-bit (and
                    (node_eq (frbt-result-birth-token zero-one-result)
                             (frbt-result-birth-token zero-one-result2))
                    (not (node_eq (frbt-result-birth-token zero-one-result)
                                  (frbt-result-birth-token changed-result)))) 512)
                (frbtb-bit (and (eq (frbt-recipe-shape? zero-one) 1)
                    (and (str_eq (frbt-recipe-tag zero-one) "affine-scalar-v1")
                    (and (eq (len (node_children zero-one)) 6)
                    (and (str_eq (node_value (nth (node_children zero-one) 3))
                                 "signed-i32")
                         (str_eq (node_value (nth (node_children zero-one) 4))
                                 "signed-i32"))))) 1024)
                (frbtb-bit (and
                    (str_eq (frbt-observation-status ready-observation) "ready")
                    (and (str_eq (frbt-observation-status held-observation) "held")
                    (and (str_eq (frbt-observation-status nothing-observation)
                                 "nothing")
                    (and (str_eq (frbt-observation-status failure-observation)
                                 "failure")
                         (str_eq (frbt-observation-status timeout-observation)
                                 "timeout"))))) 2048)
                (frbtb-bit (and
                    (eq (frbt-trace-has? (frbt-observation-trace ready-observation)
                                         "choice") 1)
                    (and (eq (frbt-trace-has?
                                (frbt-observation-trace ready-observation)
                                "crystallize") 1)
                    (and (eq (frbt-trace-has?
                                (frbt-observation-trace ready-observation)
                                "dissolve") 1)
                         (eq (frbt-trace-has?
                                (frbt-observation-trace ready-observation)
                                "release") 1)))) 4096)
                (frbtb-bit (and
                    (eq (frbt-trace-has? (frbt-observation-trace failure-observation)
                                         "undo") 1)
                    (and (eq (frbt-trace-has?
                                (frbt-observation-trace failure-observation)
                                "refine") 1)
                         (eq (frbt-trace-has?
                                (frbt-observation-trace timeout-observation)
                                "cut") 1))) 8192)
                (frbtb-bit (and
                    (eq (frbt-trace-has? (frbt-observation-trace held-observation)
                                         "held") 1)
                    (and (eq (frbt-trace-has?
                                (frbt-observation-trace held-observation)
                                "release") 0)
                    (and (eq (frbt-trace-has?
                                (frbt-observation-trace nothing-observation)
                                "dissolve") 1)
                         (eq (frbt-trace-has?
                                (frbt-observation-trace nothing-observation)
                                "release") 1)))) 16384)
                (frbtb-bit (and
                    (node_eq (frbt-observation-token ready-observation)
                             (frbt-observation-token ready-observation2))
                    (not (node_eq (frbt-observation-token ready-observation)
                                  (frbt-observation-token changed-observation)))) 32768)
                (frbtb-bit (and
                    (not (node_eq (frbt-observation-recipe ready-observation)
                                  (frbt-absent)))
                    (and (eq (frbt-recipe-mul
                                (frbt-observation-recipe ready-observation)) 0)
                         (eq (frbt-recipe-add
                                (frbt-observation-recipe ready-observation)) 1))) 65536)
                (frbtb-bit (and (ge (str_find rendered "recipe-node=@" 0) 0)
                    (and (ge (str_find rendered "birth-node=@" 0) 0)
                         (ge (str_find rendered "observation-node=@" 0) 0))) 131072)
                (frbtb-bit (and (gt (str_len rendered) 0)
                    (and (le (str_len rendered) (frbt-max-render-bytes))
                    (and (lt (str_find rendered zero-one-surface 0) 0)
                    (and (lt (str_find rendered ";mul=" 0) 0)
                         (lt (str_find rendered (frbt-open) 0) 0))))) 262144)
                (frbtb-bit (and (eq (frbt-observation-scannerless?
                                        ready-observation) 1)
                    (and (eq (frbt-observation-pretokenized?
                                ready-observation) 0)
                    (and (eq (frbt-observation-carrier-executed?
                                ready-observation) 0)
                         (eq (frbt-observation-model-executed?
                                ready-observation) 0)))) 524288)))))

    (form-recipe-birth-token-band))
