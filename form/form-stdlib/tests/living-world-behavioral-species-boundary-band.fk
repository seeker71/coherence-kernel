; living-world-behavioral-species-boundary-band.fk -- difference stays alive.
; Verdict 32767 proves fifteen divergence, ambiguity, silence, and revocation claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk form-stdlib/tests/living-world-behavioral-species-witness.fk

(do
    (let equivalent (lwbsw-build-equivalent))
    (let aligned-world (lwbsw-aligned-world equivalent))
    (let first
        (lwtnw-trial-candidate (lwbsw-equivalent-e-trial equivalent)))
    (let second
        (lwtnw-trial-candidate (lwbsw-equivalent-g-trial equivalent)))
    (let aligned-field (lwbs-field-for aligned-world first second 2))
    (let aligned-proposal (lwbs-proposal aligned-world first second 2))
    (let aligned-candidate (lwt-proposal-candidate aligned-proposal))
    (let ambiguous-world
        (lwbsw-ambiguous-world aligned-world first second
            (lwtnw-trial-candidate
                (lwbsw-divergent-f-trial (lwbsw-build-divergent)))))
    (let ambiguous-field (lwbs-field-for ambiguous-world first second 2))
    (let dissent-world (lwbsw-dissent-world aligned-world first second))
    (let dissent-field (lwbs-field-for dissent-world first second 2))
    (let revoked-world
        (lwbsw-revoked-support-world aligned-world first second))
    (let revoked-field (lwbs-field-for revoked-world first second 2))
    (let revoked-set (lwbs-field-evidence revoked-field))
    (let divergent (lwbsw-build-divergent))
    (let divergent-world (lwbsw-divergent-observed-world divergent))
    (let divergent-first
        (lwtnw-trial-candidate (lwbsw-divergent-e-trial divergent)))
    (let divergent-second
        (lwtnw-trial-candidate (lwbsw-divergent-f-trial divergent)))
    (let divergent-first-receipt
        (lwbs-receipt-for divergent-world divergent-first))
    (let divergent-second-receipt
        (lwbs-receipt-for divergent-world divergent-second))
    (let divergent-comparison
        (lwbs-comparison-for
            divergent-first-receipt divergent-second-receipt))
    (let divergent-field
        (lwbs-field-for divergent-world
            divergent-first divergent-second 2))
    (let divergent-set (lwbs-field-evidence divergent-field))

    (let c1
        (if (and (eq (lwbs-receipt-current?
                         divergent-world divergent-first-receipt) 1)
                 (eq (lwbs-receipt-current?
                         divergent-world divergent-second-receipt) 1)) 1 0))
    (let c2
        (if (not (node_eq
                    (lwbs-signature-for divergent-first-receipt)
                    (lwbs-signature-for divergent-second-receipt))) 2 0))
    (let c3
        (if (and (eq (oac-alternative-ack? divergent-comparison) 1)
                 (eq (lwbs-divergent?
                         (lwbs-field-status divergent-field)) 1)) 4 0))
    (let c4
        (if (and (node_eq
                    (lwbs-signature-after
                        (lwbs-signature-for divergent-first-receipt))
                    (intern_trivial_int 4))
                 (node_eq
                    (lwbs-signature-after
                        (lwbs-signature-for divergent-second-receipt))
                    (intern_trivial_int 3))) 8 0))
    (let c5
        (if (and (eq (lwbs-evidence-count
                         (lwbs-evidence-unresolved divergent-set)) 4)
                 (eq (lwbs-evidence-count
                         (lwbs-evidence-silences divergent-set)) 1)) 16 0))
    (let c6
        (if (and (node_eq
                    (lwbs-proposal divergent-world
                        divergent-first divergent-second 2)
                    (lwo-none))
                 (gt (lwo-field-size
                         (lwbs-field-unknown-field divergent-field)) 0)) 32 0))
    (let c7
        (if (eq (lwbs-ambiguous?
                    (lwbs-field-status ambiguous-field)) 1) 64 0))
    (let c8
        (if (eq (lwbs-blocker-count
                    (lwbs-field-evidence ambiguous-field)) 1) 128 0))
    (let c9
        (if (eq (lwo-field-has?
                    (lwbs-field-alternative-field ambiguous-field)
                    (lwtnw-trial-candidate
                        (lwbsw-divergent-f-trial
                            (lwbsw-build-divergent)))) 1) 256 0))
    (let c10
        (if (node_eq
                (lwbs-proposal ambiguous-world first second 2)
                (lwo-none)) 512 0))
    (let c11
        (if (and (eq (lwbs-ambiguous?
                         (lwbs-field-status dissent-field)) 1)
                 (eq (lwbs-evidence-count
                         (lwbs-evidence-dissents
                            (lwbs-field-evidence dissent-field))) 1)) 1024 0))
    (let c12
        (if (eq (lwbs-open?
                    (lwbs-field-status revoked-field)) 1) 2048 0))
    (let c13
        (if (and (eq (lwbs-evidence-count
                         (lwbs-evidence-first-supports revoked-set)) 1)
                 (eq (lwbs-evidence-count
                         (lwbs-evidence-second-supports revoked-set)) 2)) 4096 0))
    (let c14
        (if (and (eq (lwbs-candidate-current?
                         revoked-world aligned-candidate) 0)
                 (and (node_eq
                        (lwbs-proposal revoked-world first second 2)
                        (lwo-none))
                      (and (eq (lwbs-open?
                                  (lwbs-field-status
                                    (lwbs-field-for
                                      aligned-world first second 0))) 1)
                           (node_eq
                              (lwbs-proposal aligned-world first second 0)
                              (lwo-none))))) 8192 0))
    (let c15
        (if (and (eq (lwbs-evidence-count
                         (lwbs-evidence-silences revoked-set)) 1)
                 (and (eq (lwo-field-has?
                              (lwbs-field-alternative-field revoked-field)
                              (lwbsw-alternative)) 1)
                      (gt (lwo-field-size
                              (lwbs-field-unknown-field revoked-field)) 0)))
            16384 0))
    (lwtnw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
