; Strict parser, expanded seed-curriculum training, family-heldout
; generalization, boundary shift, order sensitivity, and mutation band.
; preludes: form-stdlib/core.fk form-stdlib/dsv4-validation-protocol.fk form-stdlib/dsv4-validation-calibrator.fk
(do
  (defn dvpb-good ()
    "<FORM_VALIDATION>\nstate=CLEAR\nconfidence=96\nsupport=94\ncontradiction=4\ncompleteness=91\nrepairability=20\nuncertainty=8\nresult=Paris\nevidence=capital reference and execution agree\nissue=\n</FORM_VALIDATION>")
  (defn dvpb-repair ()
    "<FORM_VALIDATION>\nstate=REPAIR\nconfidence=91\nsupport=51\ncontradiction=82\ncompleteness=55\nrepairability=94\nuncertainty=27\nresult=Paris\nevidence=the cited source names Paris\nissue=candidate named Lyon\n</FORM_VALIDATION>")
  (defn dvpb-unresolved ()
    "<FORM_VALIDATION>\nstate=UNRESOLVED\nconfidence=86\nsupport=42\ncontradiction=44\ncompleteness=39\nrepairability=21\nuncertainty=88\nresult=\nevidence=two sources disagree\nissue=need a primary source\n</FORM_VALIDATION>")
  (defn dvpb-dup ()
    "<FORM_VALIDATION>\nstate=CLEAR\nstate=REPAIR\nconfidence=96\nsupport=94\ncontradiction=4\ncompleteness=91\nrepairability=20\nuncertainty=8\nresult=Paris\nevidence=x\nissue=\n</FORM_VALIDATION>")
  (defn dvpb-oob ()
    "<FORM_VALIDATION>\nstate=CLEAR\nconfidence=101\nsupport=94\ncontradiction=4\ncompleteness=91\nrepairability=20\nuncertainty=8\nresult=Paris\nevidence=x\nissue=\n</FORM_VALIDATION>")
  (defn dvpb-bit (ok bit) (if ok bit 0))
  (let pc (dvp-parse (dvpb-good)))
  (let pr (dvp-parse (dvpb-repair)))
  (let pu (dvp-parse (dvpb-unresolved)))
  (let model (dvc-train))
  (let reversed-model (dvc-train-reversed))
  (let train-correct (dvc-correct model (dvc-train-rows)))
  (let held-correct (dvc-correct model (dvc-heldout-rows)))
  (let boundary-correct (dvc-correct model (dvc-boundary-rows)))
  (let reversed-held-correct (dvc-correct reversed-model (dvc-heldout-rows)))
  (let held-c0 (dvc-class-correct model (dvc-heldout-rows) 0))
  (let held-c1 (dvc-class-correct model (dvc-heldout-rows) 1))
  (let held-c2 (dvc-class-correct model (dvc-heldout-rows) 2))
  (let matrix (dvc-confusion-matrix model (dvc-heldout-rows)))
  (let boundary-matrix (dvc-confusion-matrix model (dvc-boundary-rows)))
  (let score0 (dvpb-bit (and (eq (nth pc 0) 1) (eq (nth pc 1) (dvp-state-clear))) 1))
  (let score1 (add score0 (dvpb-bit (and (eq (nth pr 0) 1) (eq (nth pr 1) (dvp-state-repair))) 2)))
  (let score2 (add score1 (dvpb-bit (and (eq (nth pu 0) 1) (eq (nth pu 1) (dvp-state-unresolved))) 4)))
  (let score3 (add score2 (dvpb-bit (eq (nth (dvp-parse (dvpb-dup)) 0) 0) 8)))
  (let score4 (add score3 (dvpb-bit (eq (nth (dvp-parse (dvpb-oob)) 0) 0) 16)))
  (let score5 (add score4 (dvpb-bit (eq (nth (dvp-parse (str_concat (dvpb-good) " trailing")) 0) 0) 32)))
  (let score6 (add score5 (dvpb-bit (eq train-correct (len (dvc-train-rows))) 64)))
  (let score7 (add score6 (dvpb-bit (ge held-correct 57) 128)))
  (let score8 (add score7 (dvpb-bit (ge held-c0 19) 256)))
  (let score9 (add score8 (dvpb-bit (ge held-c1 19) 512)))
  (let score10 (add score9 (dvpb-bit (ge held-c2 19) 1024)))
  (let score11 (add score10 (dvpb-bit (ge boundary-correct 15) 2048)))
  (let score12 (add score11 (dvpb-bit (ge reversed-held-correct 54) 4096)))
  (let score13 (add score12 (dvpb-bit (eq (dvc-sum matrix) (len (dvc-heldout-rows))) 8192)))
  (let score14 (add score13 (dvpb-bit (and (eq (dvc-agrees? model pc) 1)
                                           (and (eq (dvc-agrees? model pr) 1)
                                                (eq (dvc-agrees? model pu) 1))) 16384)))
  (let score (add score14 (dvpb-bit (and (eq (len (dvc-train-rows)) 120)
                                         (and (eq (len (dvc-heldout-rows)) 60)
                                              (eq (len (dvc-boundary-rows)) 18))) 32768)))
  ; Every metric is returned as data: no perfect scalar can hide a weak class.
  ; [nothing,node,score,counts,heldout-per-class,boundary,reverse,matrices,weights,success]
  (list (nothing) 1001099899 score
        (list train-correct (len (dvc-train-rows)) held-correct (len (dvc-heldout-rows)))
        (list held-c0 held-c1 held-c2)
        (list boundary-correct (len (dvc-boundary-rows)))
        (list reversed-held-correct (len (dvc-heldout-rows)))
        (list matrix boundary-matrix) model (if (eq score 65535) 1 0)))
