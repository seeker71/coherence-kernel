; qwen4exp-flash-next-graph-band.fk — architecture order and geometry.
;
; preludes: form-stdlib/core.fk form-stdlib/qwen4exp-flash-next-graph.bml
;
; Verdict 1023: 511 executable + 512 high-BML authority.

(do
    (defn q4gb-has (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let base (q4g-check))
    (let src (read_file "form/form-stdlib/bml/qwen4exp-flash-next-graph.bml"))
    (let authority
        (if (eq (q4gb-has src "const int Layers = 48") 1)
            (if (eq (q4gb-has src "const int SelectedExperts = 10") 1)
                (if (eq (q4gb-has src "const int PLEHistory = 9") 1)
                    (if (eq (q4gb-has src "const String ExternalRuntime = \"none\"") 1)
                        512 0) 0) 0) 0))
    (add base authority))
