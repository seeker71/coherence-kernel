; qwen35-artifact-state-band.fk — resumable artifact ledger is offset + SHA state.
;
; preludes: form-stdlib/qwen35-artifact-fetch.fk

(do
    (let raw (saj-initial-state-bytes))
    (let text (qaf-state-text 1879048192 raw))
    (let roundtrip (qaf-state-hash-of text))
    (sum (list
        (if (eq (qaf-state-offset-of text) 1879048192) 1 0)
        (if (str_eq roundtrip raw) 2 0)
        (if (eq (str_len text) 80) 4 0)
        (if (eq (qaf-state-offset-of "qaf1:805306368") 805306368) 8 0)
        (if (eq (str_len (qaf-state-hash-of "qaf1:805306368")) 0) 16 0)
        (if (eq (str_len (qaf-state-hash-of
                 "qaf2:1:zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")) 0)
            32 0))))
