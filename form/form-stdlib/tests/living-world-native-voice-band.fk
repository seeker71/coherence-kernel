; living-world-native-voice-band.fk -- executed composition speaks offered text.
; Verdict 32767 proves fifteen native rendering, consent, and revocation claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-native-voice.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-native-voice-witness.fk

(do
    (let world (lwnvw-world))
    (let context (lwnvw-context-for-world world))
    (let proposal (lwnvw-proposal-for world))
    (let candidate (lwt-proposal-candidate proposal))
    (let utterance (lwo-emergent-shape candidate))
    (let sequence (lwnv-utterance-sequence utterance))
    (let waiting
        (lwnv-integrate (lwnvw-round) proposal (lwrew-action)))
    (let integrated (lwnvw-integrated-round))
    (let integrated-world (lwt-round-world integrated))
    (let revoked (lwnvw-revoked-world))
    (let revoked-round
        (lwt-round revoked
            (lwo-field-add (lwo-empty-field) proposal)
            (lwo-empty-field) (lwo-none)))
    (let revoked-attempt
        (lwnv-integrate revoked-round proposal (lwrew-action)))
    (let empty-context
        (lwcp-context (lwt-receive-stream (lwo-empty-world)
            (list (lwnvw-entry-e (lwnvw-capability))))
            (lwnvw-capability)))
    (let empty-emission
        (lwnv-emit empty-context (lwnvw-basis) (lwnvw-referent)
            (lwo-empty-field) (lwo-none) (lwo-none)
            (lwnvw-evidence)))

    (let c1 (if (and (eq (lwcp-context-current?
                              world context) 1)
                         (eq (lwo-active?
                              (lwcp-context-world context)
                              (lwnvw-basis)) 1)) 1 0))
    (let c2 (if (and (eq (lwnv-sequence? sequence) 1)
                         (eq (len (lwnv-sequence-items sequence)) 2)) 2 0))
    (let c3 (if (and (eq (lwnv-symbol-position
                              (nth (lwnv-sequence-items sequence) 0)) 0)
                         (eq (lwnv-symbol-position
                              (nth (lwnv-sequence-items sequence) 1)) 1)) 4 0))
    (let c4 (if (str_eq (lwnv-utterance-surface utterance)
                         "forty-nine") 8 0))
    (let c5 (if (and (node_eq (lwnv-utterance-basis utterance)
                               (lwnvw-basis))
                         (node_eq (lwnv-utterance-referent utterance)
                                  (lwnvw-referent))) 16 0))
    (let c6 (if (and (eq (lwo-field-size
                              (lwnv-utterance-alternatives utterance)) 1)
                         (eq (lwlc-unknown?
                              (lwnv-utterance-unknown utterance)) 1)) 32 0))
    (let c7 (if (and (eq (lwo-field-size
                              (lwnv-utterance-witnesses utterance)) 5)
                         (eq (lwo-field-size
                              (lwt-proposal-participants proposal)) 5)) 64 0))
    (let c8 (if (and (eq (lwnv-utterance-current?
                              world utterance) 1)
                         (eq (lwnv-proposal-current?
                              world proposal) 1)) 128 0))
    (let c9 (if (eq (lwo-world-has?
                         (lwt-round-world waiting) candidate) 0) 256 0))
    (let c10 (if (and (eq (lwo-active?
                               integrated-world candidate) 1)
                          (eq (lwo-field-size
                               (lwo-active-attributions-for
                                integrated-world candidate)) 5)) 512 0))
    (let c11 (if (str_eq
                          (lwnv-utterance-surface
                            (lwo-emergent-shape candidate))
                          "forty-nine") 1024 0))
    (let c12 (if (and (eq (lwcp-context-current?
                               revoked context) 0)
                          (eq (lwnv-proposal-current?
                               revoked proposal) 0)) 2048 0))
    (let c13 (if (eq (lwo-world-has?
                          (lwt-round-world revoked-attempt)
                          candidate) 0) 4096 0))
    (let c14 (if (node_eq empty-emission (lwo-none)) 8192 0))
    (let c15 (if (and (node_eq
                           (lwnv-utterance-context utterance) context)
                          (and (node_eq
                                (lwre-result-primary
                                  (lwre-trace-result
                                    (lwo-emergent-shape
                                      (lwnv-utterance-basis utterance))))
                                (lwnv-utterance-referent utterance))
                               (eq (lwlc-choice-valid?
                                    (lwnv-utterance-choice utterance)) 1)))
                      16384 0))
    (lwnvw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
