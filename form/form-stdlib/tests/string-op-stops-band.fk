; string-op-stops-band.fk -- a string op handed a non-string stops, on fkwu as on Go, Rust and TypeScript.
;
; str_len, str_eq, str_concat, str_byte_at, str_to_float and byte_to_str answered an fkwu program 0, -1 or "" when
; handed the wrong kind, where the sibling kernels stop on the argument's type. (str_eq 5 6) answered 1: two ints both
; read as "no string", and no string equals no string. Each op now stops with its own words, as arithmetic and order
; already do over a non-number. A stop ends the run, so each stopping case is a child process and the band reads its
; exit code.
;
; Verdict 127
; PROOF LEVEL: FOURTH-ARM ONLY (each case is an fkwu child process; the sibling kernels stop on the same calls)
;
;   1   str_len of an int stops (the child exits 1)
;   2   str_eq of two ints stops, where it once answered 1
;   4   str_concat of a string and a list stops
;   8   str_byte_at of an int stops, and past a string's end it still answers -1
;  16   byte_to_str of a string stops, and past 255 it still answers ""
;  32   str_to_float of an int stops
;  64   each op still answers its strings as before
(do
    (defn sos-bit (ok bit) (if ok bit 0))
    (defn sos-rc (pid) (if (gt pid 0) (host_wait pid) -1))
    (defn sos-stops? (case) (eq (sos-rc (host_spawn_quiet (list "./fkwu" (str_concat "form/form-stdlib/tests/string-op-stops-" (str_concat case "-child.fk"))))) 1))
    (let len-ok (sos-stops? "len"))
    (let eq-ok (sos-stops? "eq"))
    (let concat-ok (sos-stops? "concat"))
    (let byte-ok (if (sos-stops? "byte") (eq (str_byte_at "abc" 5) -1) false))
    (let tostr-ok (if (sos-stops? "tostr") (str_eq (byte_to_str 300) "") false))
    (let float-ok (sos-stops? "float"))
    (let strings-ok (if (eq (str_len "abc") 3) (if (eq (str_eq "ab" "ab") 1) (if (eq (str_eq "ab" "ac") 0) (if (str_eq (str_concat "ab" "c") "abc") (if (eq (str_byte_at "abc" 0) 97) (if (str_eq (byte_to_str 65) "A") (eq (str_to_float "2.5") 2.5) false) false) false) false) false) false))
    (add (sos-bit len-ok 1) (add (sos-bit eq-ok 2) (add (sos-bit concat-ok 4) (add (sos-bit byte-ok 8) (add (sos-bit tostr-ok 16) (add (sos-bit float-ok 32) (sos-bit strings-ok 64))))))))
