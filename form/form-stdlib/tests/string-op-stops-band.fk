; string-op-stops-band.fk -- a string op handed a non-string stops, on fkwu.
;
; str_len, str_eq, str_concat, str_byte_at, str_to_float and byte_to_str answered an fkwu program 0, -1 or "" when
; handed the wrong kind, where a stop on the argument's type is the honest answer. (str_eq 5 6) answered 1: two ints both
; read as "no string", and no string equals no string. Each op now stops with its own words, as arithmetic and order
; already do over a non-number. A stop ends the cell, so each stopping case is a cell this band writes under temp_dir and
; runs in this process (cell_run answers a record whose `stopped` is the stop).
;
; Verdict 127
; REQUIRES: cell_run
;
;   1   str_len of an int stops
;   2   str_eq of two ints stops, where it once answered 1
;   4   str_concat of a string and a list stops
;   8   str_byte_at of an int stops, and past a string's end it still answers -1
;  16   byte_to_str of a string stops, and past 255 it still answers ""
;  32   str_to_float of an int stops
;  64   each op still answers its strings as before
(do
    (defn sos-bit (ok bit) (if ok bit 0))
    (defn sos-dir () (str_concat (temp_dir) (str_concat "/string-op-stops-" (value_str (host_pid)))))
    (defn sos-stops? (case text)
        (do (let p (str_concat (sos-dir) (str_concat "/" (str_concat case ".fk"))))
            (let w (write_file p text))
            (let rec (cell_run p 0 10000 (nothing)))
            (let gone (host_path_remove p))
            (not (nothing? (record_get rec "stopped")))))
    (let made (host_dir_mkdir (sos-dir)))
    (let len-ok (sos-stops? "len" "(print (str_len 5))\n"))
    (let eq-ok (sos-stops? "eq" "(print (str_eq 5 6))\n"))
    (let concat-ok (sos-stops? "concat" "(print (str_concat \"a\" (list 1)))\n"))
    (let byte-ok (if (sos-stops? "byte" "(print (str_byte_at 5 0))\n") (eq (str_byte_at "abc" 5) -1) false))
    (let tostr-ok (if (sos-stops? "tostr" "(print (byte_to_str \"a\"))\n") (str_eq (byte_to_str 300) "") false))
    (let float-ok (sos-stops? "float" "(print (str_to_float 5))\n"))
    (let removed (host_dir_rmdir (sos-dir)))
    (let strings-ok (if (eq (str_len "abc") 3) (if (eq (str_eq "ab" "ab") 1) (if (eq (str_eq "ab" "ac") 0) (if (str_eq (str_concat "ab" "c") "abc") (if (eq (str_byte_at "abc" 0) 97) (if (str_eq (byte_to_str 65) "A") (eq (str_to_float "2.5") 2.5) false) false) false) false) false) false))
    (add (sos-bit len-ok 1) (add (sos-bit eq-ok 2) (add (sos-bit concat-ok 4) (add (sos-bit byte-ok 8) (add (sos-bit tostr-ok 16) (add (sos-bit float-ok 32) (sos-bit strings-ok 64))))))))
