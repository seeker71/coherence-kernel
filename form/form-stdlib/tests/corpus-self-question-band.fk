; corpus-self-question-band.fk — the weave reads exactly over synthetic rows:
; re-use counts exclude a row's own question, the most-woven word wins, the
; EARLIEST never-re-used word is the orphan, and the body's self-posed
; question carries both in the corpus's own token shape.
;
; Synthetic corpus (row shape (mid date tokens answer fresh src)):
;   601 fresh "spurious" — spoken again by 602 and 603 -> weave count 2
;   602 fresh "melt"     — spoken again by 603          -> weave count 1
;   603 fresh "return"   — never spoken again           -> orphan, mid 603
;   604 fresh "door"     — only its OWN question says it -> orphan, mid 604
;
; Verdict 31 (5 bits):
;   1    most-woven word is "spurious"
;   2    its weave count is exactly 2 (self row excluded)
;   4    the orphan is "return" — earliest by meaning-id, not "door"
;   8    orphan count is exactly 2
;   16   the self-posed question is the six tokens
;        (what movement joins spurious with return)
;
; preludes: form-stdlib/core.fk form-stdlib/corpus-self-question.fk

(do
    (defn csqb-bit (ok weight) (if ok weight 0))
    (defn csqb-rows ()
        (list
            (list 601 20260701 (list "what" "is" "an" "edge")
                "spurious" "spurious" "test")
            (list 602 20260702 (list "does" "a" "spurious" "edge" "melt")
                "melt" "melt" "test")
            (list 603 20260703 (list "can" "a" "spurious" "melt" "return")
                "return" "return" "test")
            (list 604 20260704 (list "who" "holds" "the" "door")
                "door" "door" "test")))

    (defn corpus-self-question-band ()
        (do
            (let w (csq-weave (csqb-rows)))
            (let q (csq-question (csq-best-word w) (csq-orphan-word w)))
            (add (csqb-bit (str_eq (csq-best-word w) "spurious") 1)
            (add (csqb-bit (eq (csq-best-count w) 2) 2)
            (add (csqb-bit (and (str_eq (csq-orphan-word w) "return")
                                (eq (csq-orphan-mid w) 603)) 4)
            (add (csqb-bit (eq (csq-orphan-count w) 2) 8)
                 (csqb-bit (and (eq (len q) 6)
                            (and (str_eq (nth q 0) "what")
                            (and (str_eq (nth q 3) "spurious")
                                 (str_eq (nth q 5) "return")))) 16)))))))

    (corpus-self-question-band))
