; preludes: form-stdlib/core.fk
; Expected: 31
;
; float-printer-fourway-band — the printer's range split, read by every kernel that has one.
; core.fk's float_to_str overflowed an int64 above 9.223e12 and answered instead of refusing
; (corpus row 1418 printpast). The split must mean the same thing in all four kernels, because
; core.fk is the deepest prelude any of them load.
;
; Verdict 31:
;   1   the ordinary range is unchanged — six decimals, trailing zeros trimmed
;   2   nine trillion prints as nine trillion, not as a negative number
;   4   the sign survives the whole-number band
;   8   past 9e18 the exponent is carried instead of the digits being invented
;   16  zero is zero and a small fraction is still exact
(do
    (let c0 (if (and (str_eq (float_to_str 1.5) "1.5") (str_eq (float_to_str 1211.166382) "1211.166382")) 1 0))
    (let c1 (if (str_eq (float_to_str 9000000000000.0) "9000000000000") 2 0))
    (let c2 (if (str_eq (float_to_str (sub 0.0 9000000000000.0)) "-9000000000000") 4 0))
    (let c3 (if (and (str_eq (float_to_str 1.0e20) "1e20") (str_eq (float_to_str 1.0e300) "1e300")) 8 0))
    (let c4 (if (and (str_eq (float_to_str 0.0) "0") (str_eq (float_to_str 0.000001) "0.000001")) 16 0))
    (add c0 (add c1 (add c2 (add c3 c4)))))
