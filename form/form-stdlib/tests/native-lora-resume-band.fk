; Adam continuation after saving/loading must equal uninterrupted training byte for byte.
; Both models share the same deterministic fixture, with independently allocated owners.
; preludes: form-stdlib/native-lora-train.bml form-stdlib/tests/native-llama-fixture.bml
(do
 (defn nlrb-step (m state step)
  (do (nlb-clear state)
   (let ctx (nll-context m 4))
   (let r (nll-forward m ctx (list 1 5 9 12) 0 1))
   (nlb-backward-masked m r (list 5 9 12 17) (list 0.0 0.0 1.0 1.0) state 1.0)
   (nll-forward-close r) (nll-context-close ctx)
   (nlb-safe-step state 0.0001 step 1.0)))
 (defn nlrb-equal (a b)
  (if (nil? a) (nil? b)
   (and (str_eq (metal_buf_read (nth (head a) 1) 0 (nlc-bytes (head a))) (metal_buf_read (nth (head b) 1) 0 (nlc-bytes (head b)))) (nlrb-equal (tail a) (tail b)))))
 (let m (nlf-model)) (let s (nlb-state m)) (nlrb-step m s 1)
 (let root (str_concat "/tmp/native-lora-resume-" (int_to_str (host_pid)))) (fs-mkdir root)
 (let a (str_concat root "/adapters.safetensors")) (let o (str_concat root "/optimizer.safetensors"))
 (nlc-save a (nlc-adapter-rows (nlb-pairs (nth m 1))) "fixture" 1)
 (nlc-save o (nlc-optimizer-rows s) "fixture" 1)
 (let resumed (nlf-model)) (let rs (nlb-state resumed))
 (nlc-restore (nlc-adapter-rows (nlb-pairs (nth resumed 1))) (sti-open a))
 (nlc-load-optimizer rs o)
 (nlrb-step m s 2) (nlrb-step resumed rs 2)
 (let parameters (nlrb-equal (nlc-adapter-rows (nlb-pairs (nth m 1))) (nlc-adapter-rows (nlb-pairs (nth resumed 1)))))
 (let moments (nlrb-equal (nlc-optimizer-rows s) (nlc-optimizer-rows rs)))
 (nlb-state-close s) (nlb-state-close rs) (nll-close m) (nll-close resumed)
 (fs-remove-tree root)
 (print (list "parameters-byte-equal" parameters "moments-byte-equal" moments "retained" (nth (metal_live) 2)))
 (if (and parameters (and moments (eq (nth (metal_live) 2) 0))) 7 (form_error "native Adam resume diverged")))
