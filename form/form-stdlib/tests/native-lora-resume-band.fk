; Adam continuation after saving/loading must equal uninterrupted training byte for byte.
; Both models share the same deterministic fixture, with independently allocated owners.
; preludes: form-stdlib/native-lora-train.bml form-stdlib/tests/native-llama-fixture.bml
(do
 (defn nlrb-step (m state step checkpointed output)
  (do (nlb-clear state)
   (let ctx (nll-context m 4))
   (let context (list output 1))
   (let r (if checkpointed (nlrc-forward-observed m ctx (list 1 5 9 12) context ntr-recompute-event) (nll-forward m ctx (list 1 5 9 12) 0 1)))
   (if checkpointed (nlrc-backward-observed m r (list 5 9 12 17) (list 0.0 0.0 1.0 1.0) state 1.0 context ntr-recompute-event) (nlb-backward-masked m r (list 5 9 12 17) (list 0.0 0.0 1.0 1.0) state 1.0))
   (nll-forward-close r) (nll-context-close ctx)
   (nlb-safe-step state 0.0001 step 1.0)))
 (defn nlrb-equal (a b)
  (if (nil? a) (nil? b)
   (and (str_eq (metal_buf_read (nth (head a) 1) 0 (nlc-bytes (head a))) (metal_buf_read (nth (head b) 1) 0 (nlc-bytes (head b)))) (nlrb-equal (tail a) (tail b)))))
 (defn nlrb-assess (m ids targets mask whole limit)
  (do
   (let c (nll-context m (len ids)))
   (let totals (ntr-score-slices m c ids targets mask 0 limit 0.0 0.0 0 0))
   (nll-context-close c)
   (let difference (abs (sub whole (ntr-score-loss totals))))
   (print (list "assessment-slice-limit" limit "loss-difference" difference "totals" totals))
   (and (lt difference 0.000001) (and (eq (nth totals 1) (sum mask)) (eq (nth totals 2) (len ids))))))
 (let m (nlf-model)) (let s (nlb-state m))
 (let ids (list 1 5 9 12 17 23 29)) (let targets (list 5 9 12 17 23 29 31))
 (let mask (list 0.0 0.0 1.0 0.0 1.0 1.0 0.0))
 (let c (nll-context m 7)) (let r (nll-forward m c ids 0 1))
 (let whole (nlb-loss-masked m r targets mask))
 (let headEqual (ntr-head-equality m r))
 (if (head headEqual) 1 (form_error "training head disagrees with independent final row"))
 (let headReading (ntr-head-reading "resume-band" 1 headEqual))
 (if (and (node_eq (oh-get headReading "health") (json-node-int 1)) (node_eq (oh-get headReading "surprise") (json-node-int 0))) 1 (form_error "equal projection raised a false surprise"))
 (let finalOffset (mul (sub (len ids) 1) (nth (head m) 5)))
 (let originalFinal (metal_buf_read (head r) (mul finalOffset 4) (mul (nth (head m) 5) 4)))
 (metal_buf_write (head r) (mul finalOffset 4) (nam-f32s (nlf-repeat (nth (head m) 5) 0.0)))
 (let headUnequal (ntr-head-equality m r))
 (if (not (head headUnequal)) 1 (form_error "unwritten finite head row escaped observation"))
 (let headRefusal (ntr-head-reading "resume-band" 1 headUnequal))
 (if (and (node_eq (oh-get headRefusal "health") (json-node-int 0)) (node_eq (oh-get headRefusal "surprise") (json-node-int 1))) 1 (form_error "unequal projection lost its diagnostic signal"))
 (metal_buf_write (head r) (mul finalOffset 4) originalFinal)
 (if (head (ntr-head-equality m r)) 1 (form_error "restored head was not re-observed"))
 (nll-forward-close r) (nll-context-close c)
 (let live (nth (metal_live) 2))
 (let one (nlrb-assess m ids targets mask whole 1))
 (let uneven (nlrb-assess m ids targets mask whole 3))
 (let automatic (ntr-score m (list ids targets mask 3.0 1)))
 (let scores (and one (and uneven (and (lt (abs (sub whole (ntr-score-loss automatic))) 0.000001) (eq live (nth (metal_live) 2))))))
 (nlrb-step m s 1 0 "")
 (let root (str_concat "/tmp/native-lora-resume-" (int_to_str (host_pid)))) (fs-mkdir root)
 (let a (str_concat root "/adapters.safetensors")) (let o (str_concat root "/optimizer.safetensors"))
 (nlc-save a (nlc-adapter-rows (nlb-pairs (nth m 1))) "fixture" 1)
 (nlc-save o (nlc-optimizer-rows s) "fixture" 1)
 (let resumed (nlf-model)) (let rs (nlb-state resumed))
 (nlc-restore (nlc-adapter-rows (nlb-pairs (nth resumed 1))) (sti-open a))
 (nlc-load-optimizer rs o)
 (nlrb-step m s 2 0 "") (nlrb-step resumed rs 2 1 root)
 (let parameters (nlrb-equal (nlc-adapter-rows (nlb-pairs (nth m 1))) (nlc-adapter-rows (nlb-pairs (nth resumed 1)))))
 (let moments (nlrb-equal (nlc-optimizer-rows s) (nlc-optimizer-rows rs)))
 (nlb-state-close s) (nlb-state-close rs) (nll-close m) (nll-close resumed)
 (fs-remove-tree root)
 (print (list "assessment-loss-and-release" scores "parameters-byte-equal" parameters "moments-byte-equal" moments "retained" (nth (metal_live) 2)))
 (if (and scores (and parameters (and moments (eq (nth (metal_live) 2) 0)))) 7 (form_error "native assessment or Adam resume diverged")))
