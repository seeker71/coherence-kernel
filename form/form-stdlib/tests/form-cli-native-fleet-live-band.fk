; form-cli-native-fleet-live-band.fk -- source and result-shape proof for the
; physical two-model BML witness.  The live runner performs the hardware
; crossing with caller-supplied local artifacts.
; Expected: 511
;
; preludes: form-stdlib/bml/form-cli-native-fleet-live.bml

(do
    (defn fcnflb-bit (held weight) (if held weight 0))
    (let fleet (fcmf-fleet (list
        (fcmf-seat "alpha" (fcms-none "not-opened"))
        (fcmf-seat "beta" (fcms-none "not-opened")))))
    (let alpha (fcdq-state "done" (fcms-none "released") "A" (list 0) 0 1 "done"))
    (let beta (fcdq-state "done" (fcms-none "released") "B" (list 1) 0 1 "done"))
    (let result (fcnfl-result "value" "two-native-model-tokens-observed"
        fleet alpha beta 1))
    (let source (read_file "form/form-stdlib/bml/form-cli-native-fleet-live.bml"))
    (sum (list
        (fcnflb-bit (and (str_eq (fcnfl-status result) "value")
            (str_eq (fcnfl-reason result) "two-native-model-tokens-observed")) 1)
        (fcnflb-bit (eq (fcmf-seat-count (fcnfl-fleet result)) 2) 2)
        (fcnflb-bit (and (eq (fcnfl-token-count (fcnfl-alpha result)) 1)
            (and (eq (head (fcdq-ids (fcnfl-alpha result))) 0)
                (eq (head (fcdq-ids (fcnfl-beta result))) 1))) 4)
        (fcnflb-bit (eq (fcnfl-released result) 1) 8)
        (fcnflb-bit (and (ge (str_find source "fcmf-open" 0) 0)
            (and (ge (str_find source "fcdq-advance" 0) 0)
                (ge (str_find source "fcmf-release" 0) 0))) 16)
        (fcnflb-bit (and (ge (str_find source "Alpha()" 0) 0)
            (ge (str_find source "Beta()" 0) 0)) 32)
        (fcnflb-bit (and (not (nothing? (fcnfl-alpha result)))
            (not (nothing? (fcnfl-beta result)))) 64)
        (fcnflb-bit (and (str_eq (fcdq-phase (fcnfl-alpha result)) "done")
            (str_eq (fcdq-phase (fcnfl-beta result)) "done")) 128)
        (fcnflb-bit (and (ge (str_find (read_file "observe/form-cli-native-fleet-live.fk") "metal-before" 0) 0)
            (ge (str_find (read_file "observe/form-cli-native-fleet-live.fk") "metal-after" 0) 0)) 256))))
