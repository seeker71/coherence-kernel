; bml-bmf-stream-authority-band.fk -- actual high-BML cursor parse witness.
;
; Expected: 1023
; This proves the held-out authority is valid BML through the repository's
; scannerless BMF grammar and a seven-byte file window.  Executable method
; behavior is separately witnessed by bml-bmf-stream-curriculum-band.fk.
;
; witnessed: 2026-08-24 -> direct fkwu
; preludes: form-stdlib/core.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml.fk

(do
    (defn bbsab-bit (ok bit) (if ok bit 0))
    (defn bbsab-path ()
        (if (ge (file_size
                "form/form-stdlib/bml/bml-bmf-stream-curriculum.bml") 0)
            "form/form-stdlib/bml/bml-bmf-stream-curriculum.bml"
            "form-stdlib/bml/bml-bmf-stream-curriculum.bml"))
    (defn bbsab-has? (text needle)
        (if (ge (str_find text needle 0) 0) 1 0))
    (defn bbsab-run ()
        (do
            (let path (bbsab-path))
            (let source (read_file path))
            (let cursor (cursor-file-window path 7))
            (let result (g-match-rule (bml-grammar) "unit" cursor))
            (sum (list
                (bbsab-bit (and (eq (cur-pos cursor) 0)
                                (eq (bbc-window-size (cur-state cursor)) 7)) 1)
                (bbsab-bit (rok? result) 2)
                (bbsab-bit (g-complete? result) 4)
                (bbsab-bit (eq (bbsab-has? source
                    "package Form.learning.stream") 1) 8)
                (bbsab-bit (eq (bbsab-has? source
                    "interface IStreamCurriculum") 1) 16)
                (bbsab-bit (eq (bbsab-has? source
                    "class StreamCurriculum<TGrammar>") 1) 32)
                (bbsab-bit (and (eq (bbsab-has? source
                    "const int CaptureBound = 8") 1)
                    (eq (bbsab-has? source
                    "const String CursorRoute") 1)) 64)
                (bbsab-bit (and (eq (bbsab-has? source
                    "scannerless-byte-fold-no-tokenizer") 1)
                    (eq (bbsab-has? source
                    "fixed-state-plus-two-bounded-captures") 1)) 128)
                (bbsab-bit (and (eq (bbsab-has? source
                    "unsupported-grammar-is-nothing-never-zero-or-one") 1)
                    (eq (bbsab-has? source
                    "continue-until-suffix-incomplete-on-final-prefix") 1)) 256)
                (bbsab-bit (and (eq (bbsab-has? source "SourceScanner") 0)
                    (eq (bbsab-has? source "TToken[]") 0)) 512)))))
    (bbsab-run))
