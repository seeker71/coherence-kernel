; ear-axes-band.fk — a heard line is a point, and the point has axes.
;
; Every bit here is folded over frames written by hand, so the band answers the
; same on a silent Mac, a mic that was never granted, and a room full of voices:
; a band proves the cell, only the door witnesses the body. Bit 15 is the glass's
; side of it — the painting decisions, which are pure — and not a live frame.
; Bit 16 is the lanes behind the point: a lane born mute writes no frame at all,
; and every other bit here would still read a perfectly silent room, so the three
; lane axes are what separate a quiet room from a lane that never opened.
;
; Expected: 131071.
; preludes: form-stdlib/ear-axes.bml form-stdlib/form-glass-live.bml
(do
    (defn eab-nl () (byte_to_str 10))
    (defn eab-kv (k v) (ea-cat (list k "=" v (eab-nl))))
    (defn eab-frame (body) (ea-cat (list "<|ear:frame|>" (eab-nl) body "<|/ear:frame|>" (eab-nl))))
    (defn eab-live (t db text lang ms enc dec ntok)
        (eab-frame (ea-cat (list (eab-kv "t" (int_to_str t)) (eab-kv "kind" "live") (eab-kv "db" (int_to_str db))
                                 (eab-kv "live" text) (eab-kv "livelang" lang) (eab-kv "livems" (int_to_str ms))
                                 (eab-kv "encms" (int_to_str enc)) (eab-kv "decms" (int_to_str dec)) (eab-kv "ntok" (int_to_str ntok))
                                 (eab-kv "heard" "") (eab-kv "lang" "") (eab-kv "nsp" "0") (eab-kv "heardms" "0")))))
    (defn eab-quiet (t db)
        (eab-frame (ea-cat (list (eab-kv "t" (int_to_str t)) (eab-kv "kind" "quiet") (eab-kv "db" (int_to_str db))
                                 (eab-kv "live" "") (eab-kv "livelang" "") (eab-kv "livems" "0")
                                 (eab-kv "heard" "") (eab-kv "lang" "") (eab-kv "nsp" "0") (eab-kv "heardms" "0")))))
    (defn eab-heard (t db text lang commit)
        (eab-frame (ea-cat (list (eab-kv "t" (int_to_str t)) (eab-kv "kind" "heard") (eab-kv "db" (int_to_str db))
                                 (eab-kv "live" "") (eab-kv "livelang" "") (eab-kv "livems" "0")
                                 (eab-kv "heard" text) (eab-kv "lang" lang) (eab-kv "nsp" "0") (eab-kv "heardms" (int_to_str commit))))))
    (defn eab-said (t text en pt saidms)
        (eab-frame (ea-cat (list (eab-kv "t" (int_to_str t)) (eab-kv "kind" "said") (eab-kv "heard" text) (eab-kv "lang" "en")
                                 (eab-kv "tongues" "en pt fa") (eab-kv "t_en" en) (eab-kv "t_pt" pt) (eab-kv "t_fa" "")
                                 (eab-kv "saidms" (int_to_str saidms))))))
    (defn eab-live2 (t db text lang ms enc dec ntok stable fl gate)
        (eab-frame (ea-cat (list (eab-kv "t" (int_to_str t)) (eab-kv "kind" "live") (eab-kv "db" (int_to_str db))
                                 (eab-kv "live" text) (eab-kv "livelang" lang) (eab-kv "livems" (int_to_str ms))
                                 (eab-kv "encms" (int_to_str enc)) (eab-kv "decms" (int_to_str dec)) (eab-kv "ntok" (int_to_str ntok))
                                 (eab-kv "heard" "") (eab-kv "lang" "") (eab-kv "nsp" "0") (eab-kv "heardms" "0")
                                 (eab-kv "stable" (int_to_str stable)) (eab-kv "floor" (int_to_str fl)) (eab-kv "gate" (int_to_str gate))))))
    (defn eab-heard2 (t db text lang commit why settled)
        (eab-frame (ea-cat (list (eab-kv "t" (int_to_str t)) (eab-kv "kind" "heard") (eab-kv "db" (int_to_str db))
                                 (eab-kv "live" "") (eab-kv "livelang" "") (eab-kv "livems" "0")
                                 (eab-kv "heard" text) (eab-kv "lang" lang) (eab-kv "nsp" "0") (eab-kv "heardms" (int_to_str commit))
                                 (eab-kv "why" why) (eab-kv "settled" (int_to_str settled))))))
    (defn eab-phantom (t db tags)
        (eab-frame (ea-cat (list (eab-kv "t" (int_to_str t)) (eab-kv "kind" "phantom") (eab-kv "db" (int_to_str db))
                                 (eab-kv "live" "") (eab-kv "livelang" "") (eab-kv "livems" "0")
                                 (eab-kv "heard" "") (eab-kv "lang" "") (eab-kv "nsp" "414") (eab-kv "heardms" "0")
                                 (eab-kv "tags" tags)))))
    (defn eab-done (t) (eab-frame (ea-cat (list (eab-kv "t" (int_to_str t)) (eab-kv "kind" "done") (eab-kv "db" "-120") (eab-kv "live" "") (eab-kv "heard" "")))))
    (defn eab-find (rows id) (if (eq (len rows) 0) (list) (if (str_eq (fgo-id (head rows)) id) (head rows) (eab-find (tail rows) id))))
    (defn eab-num (rows id) (do (let r (eab-find rows id)) (if (eq (len r) 0) (sub 0 1) (if (eq (fgo-present? r) 0) (sub 0 1) (fgo-int-value r)))))
    (defn eab-str (rows id) (do (let r (eab-find rows id)) (if (eq (len r) 0) "" (if (eq (fgo-present? r) 0) "" (fgo-text-value r)))))
    (defn eab-absent? (rows id) (do (let r (eab-find rows id)) (if (eq (len r) 0) 0 (if (eq (fgo-present? r) 0) 1 0))))
    (defn eab-door (rows id) (do (let r (eab-find rows id)) (if (eq (len r) 0) "" (fgo-source r))))
    (defn eab-has? (hay needle) (if (ge (str_find hay needle 0) 0) 1 0))
    (defn eab-hex8? (s) (if (eq (str_len s) 8) (sv-hex? s 0) 0))
    (defn eab-ids (rows) (if (eq (len rows) 0) (list) (cons (fgo-id (head rows)) (eab-ids (tail rows)))))
    (defn eab-at (xs i) (nth xs i))
    (defn eab-verse-all? (table) (if (eq (len table) 0) 1 (if (and (gt (str_len (ea-verse-text (head table))) 0) (gt (ea-verse-poem (head table)) 0)) (eab-verse-all? (tail table)) 0)))
    (defn eab-count-life (rows want) (if (eq (len rows) 0) 0 (add (if (str_eq (fgo-lifecycle (head rows)) want) 1 0) (eab-count-life (tail rows) want))))
    ; a bit with many parts is a fold over its parts, not a stair of ands: the stair hides
    ; which part fell, and a paren miscount in it is a whole band mis-read
    (defn eab-all? (xs) (if (eq (len xs) 0) 1 (if (eq (head xs) 1) (eab-all? (tail xs)) 0)))

    ; ── the frames the band folds over ──────────────────────────────────────
    (let LINE "the body observed the glass and the water froze to ice")
    (let fLive (eab-live 1000 -42 LINE "en" 37 30 7 12))
    (let fQuiet (eab-quiet 1100 -54))
    (let fHeard (eab-heard 1200 -42 LINE "en" 26))
    (let fSaid (eab-said 1300 LINE "the body saw the glass" "o corpo viu o vidro" 640))
    (let fDone (eab-done 1400))
    ; the live frame stands LAST among the non-commit frames: if the newest walk were wrong,
    ; the said frame that follows it in the run would take live's place and the stage rows would go dark
    (let text (ea-cat (list fQuiet fHeard fSaid fLive)))
    (let frames (ea-frames text 0 (list)))
    (let newest (ea-newest frames "" "" "" ""))

    ; ── the tables, walked once ─────────────────────────────────────────────
    (let sense0 (ea-sense-born))
    (let senseLight (ea-sense (list) (list) (list) "" (list) 0))
    (let sense1 (ea-sense-step sense0 (head newest) (nth newest 1) (nth newest 2) 1))
    ; two lanes standing, twelve seconds old, stood once, the live lane's last word in hand
    (let lanes (ea-lanes 4242 4243 12000 1 "live: live lane open, pid 4242, mic 0, standing 86400 s"))
    (let rows (ea-rows sense1 (head newest) (nth newest 1) (nth newest 2) "en pt fa" 1 2000 lanes (nth newest 3)))
    ; a second run for the close axes: a line closed by the decoder with the words already final,
    ; a live frame carrying the room own gate, and a refusal standing AFTER the live frame — so a
    ; phantom taking the live slot would blank the open line and this bit would see it
    (let fLive2 (eab-live2 1500 -36 LINE "en" 37 30 7 12 5 74 296))
    (let fHeard2 (eab-heard2 1600 -36 LINE "en" 22 "decoder" 900))
    (let fGhost (eab-phantom 1700 -48 "(music playing)"))
    (let newest2 (ea-newest (ea-frames (ea-cat (list fHeard2 fLive2 fGhost)) 0 (list)) "" "" "" ""))
    (let rows2 (ea-rows (ea-sense-step sense0 (head newest2) (nth newest2 1) (nth newest2 2) 1) (head newest2) (nth newest2 1) (nth newest2 2) "en pt fa" 1 2000 lanes (nth newest2 3)))
    (let hits (ea-symbols (ea-sense-meanings sense0) LINE))

    ; ── the stream: three closings, one of them a repeat ────────────────────
    (let s1 (ea-sense-step senseLight fQuiet (eab-heard 10 -40 "one" "en" 5) "" 1))
    (let s2 (ea-sense-step s1 fQuiet (eab-heard 20 -40 "two" "en" 5) "" 1))
    (let s3 (ea-sense-step s2 fQuiet (eab-heard 30 -40 "two" "en" 5) "" 1))
    (let s4 (ea-sense-step s3 fQuiet (eab-heard 40 -40 "three" "en" 5) "" 1))
    (let points (ea-sense-points s4))

    ; ── the glass's painting decisions, pure ────────────────────────────────
    (let mixed (list (fgo-text "ear" "ear.state" "the ear" "speaking" "organ" "physical-live" "ear-organ" "live" "voice" "n")
                     (fgo-int "memory" "cells" "cells" 7 "nodes" 0 "cpu-arena" "physical-live" "kernel_stat:4" "resident" "cell" "n")))
    (let ordered (fgl-ear-first (list (head mixed)) (list (nth mixed 1))))

    (sum (list
        ; 1 — the roster names itself and the row reports its own length
        ; (24 until the three lane axes joined it: a point about the room that cannot
        ;  tell a quiet room from a lane that never opened is a point missing an axis)
        (if (and (eq (len (ea-axes)) 31) (eq (eab-num rows "ear.axes") (len (ea-axes)))) 1 0)
        ; 2 — a frame's fields read back exactly, ints and text alike
        (if (and (str_eq (ea-field fLive "live") LINE)
                 (and (eq (ea-int fLive "db") -42) (and (eq (ea-int fLive "ntok") 12) (str_eq (ea-field fLive "livelang") "en")))) 2 0)
        ; 4 — the frames of a run are found, and draining again from the watermark finds nothing twice
        (if (and (eq (len frames) 4) (and (gt (ea-through text 0 0) 0) (eq (len (ea-frames text (ea-through text 0 0) (list))) 0))) 4 0)
        ; 8 — live never takes a commit frame; heard and said each take their own
        (if (and (str_eq (ea-field (head newest) "kind") "live")
                 (and (str_eq (ea-field (nth newest 1) "heard") LINE) (str_eq (ea-field (nth newest 2) "t_pt") "o corpo viu o vidro"))) 8 0)
        ; 16 — the state word, in each of the five conditions the ear knows
        (if (and (str_eq (ea-state 0 fLive fHeard) "asleep")
                 (and (str_eq (ea-state 1 fDone fHeard) "deaf")
                      (and (str_eq (ea-state 1 fLive fHeard) "speaking")
                           (and (str_eq (ea-state 1 fQuiet fHeard) "heard") (str_eq (ea-state 1 fQuiet (eab-heard 900 -42 "" "" 0)) "silent"))))) 16 0)
        ; 32 — the trend: no previous is said so, and three dB is the step that counts
        (if (and (str_eq (ea-trend -42 (list)) "first reading")
                 (and (eq (eab-has? (ea-trend -42 (list -48)) "rising") 1)
                      (and (eq (eab-has? (ea-trend -48 (list -42)) "falling") 1) (str_eq (ea-trend -42 (list -42)) "steady")))) 32 0)
        ; 64 — the line resolves to the meanings it carries, and not to ones it does not
        (if (and (eq (eab-has? (ea-sym-line hits) "you") 1)
                 (and (eq (eab-has? (ea-sym-line hits) "SEE") 1)
                      (and (eq (eab-has? (ea-sym-line hits) "glass") 1)
                           (and (eq (eab-has? (ea-sym-line hits) "ice") 1) (eq (eab-has? (ea-sym-line hits) "adapter") 0))))) 64 0)
        ; 128 — every symbol carries an eight-hex node id, and it is the anchor of that symbol
        (if (and (gt (len hits) 0)
                 (and (eq (eab-hex8? (ea-meaning-node (head hits))) 1)
                      (and (str_eq (ea-meaning-node (head hits)) (mc-anchor (ea-meaning-sym (head hits))))
                           (eq (len (split-on (ea-node-line hits) " ")) (len hits))))) 128 0)
        ; 256 — codes are shorter than words when meanings stand, and nothing when none do
        (if (and (gt (ea-compression LINE hits) 0) (eq (ea-compression "zzz qqq" (list)) 0)) 256 0)
        ; 512 — every state word finds a couplet AND the poem it stands in
        (if (eq (eab-verse-all? (ea-sense-verses sense0)) 1) 512 0)
        ; 1024 — each stage's own latency lands on its own axis
        (if (and (eq (eab-num rows "ear.encode") 30)
                 (and (eq (eab-num rows "ear.decode") 7)
                      (and (eq (eab-num rows "ear.tokens") 12)
                           (and (eq (eab-num rows "ear.commit") 26) (eq (eab-num rows "ear.said") 640))))) 1024 0)
        ; 2048 — a tongue offered carries its words; one not offered names its own door
        (if (and (str_eq (eab-str rows "ear.tongue.pt") "o corpo viu o vidro")
                 (and (eq (eab-num rows "ear.tongues") 2)
                      (and (eq (eab-absent? rows "ear.tongue.fa") 1) (str_eq (eab-door rows "ear.tongue.fa") "ear.spool.t_fa")))) 2048 0)
        ; 4096 — the phase census counts every measured row by the lifecycle word the glass sorts by,
        ; and says so honestly: the two rows about the stream itself are water and stand outside it
        (if (and (eq (eab-has? (eab-str rows "ear.phase") (ea-cat (list "gas " (int_to_str (eab-count-life rows "source"))))) 1)
                 (and (eq (eab-has? (eab-str rows "ear.phase") (ea-cat (list "water " (int_to_str (sub (eab-count-life rows "live") 2))))) 1)
                      (and (eq (eab-has? (eab-str rows "ear.phase") (ea-cat (list "ice " (int_to_str (eab-count-life rows "stored"))))) 1)
                           (gt (eab-count-life rows "stored") 0)))) 4096 0)
        ; 8192 — the stream is newest first, a repeat does not become a moment, six is the depth
        (if (and (eq (len points) 3)
                 (and (str_eq (ea-point-text (head points)) "three")
                      (and (str_eq (ea-point-text (nth points 1)) "two")
                           (and (str_eq (ea-point-text (nth points 2)) "one") (le (len points) 6))))) 8192 0)
        ; 16384 — the glass paints the room: r is a focus on the ear, the selector lets it stand, the stream leads
        (if (and (str_eq (fgl-control-key-action "r") "focus")
                 (and (str_eq (fgl-control-key-argument "r" "") "ear")
                      (and (eq (fgl-control-key-needs-argument? "r" "focus") 0)
                           (and (eq (fgl-ear-selector? "ear") 1)
                                (and (eq (fgl-ear-selector? "no-such-lane") 0)
                                     (and (str_eq (fgo-id (head ordered)) "ear.state")
                                          (eq (len (fgd-filter-metrics mixed "ear")) 1))))))) 16384 0)
        ; 32768 — the lanes behind the point: what stands, what it last said, how often it was
        ; stood; a lane that is gone says so rather than reading as a pid; no lane at all names
        ; its own door instead of painting a standing that is not there; and the last words a
        ; lane left behind survive into the sleep that follows it
        (if (eq (eab-all? (list
                (eab-has? (eab-str rows "ear.lanes") "#4242")
                (eab-has? (eab-str rows "ear.lanes") "#4243")
                (eab-has? (eab-str rows "ear.lanes") "12 s")
                (eab-has? (eab-str rows "ear.voice") "live lane open")
                (if (eq (eab-num rows "ear.stands") 1) 1 0)
                (eab-has? (ea-lanes-text (ea-lanes 7 0 500 2 "")) "tongue gone")
                (eab-has? (ea-lanes-text (ea-lanes 7 0 500 2 "")) "500 ms")
                (if (str_eq (ea-lanes-text (ea-lanes-none)) "") 1 0)
                (eab-absent? (ea-lane-rows (ea-lanes-none)) "ear.lanes")
                (if (str_eq (eab-door (ea-lane-rows (ea-lanes-none)) "ear.lanes") "ear.lane.pid") 1 0)
                (eab-has? (eab-str (ea-asleep-rows lanes) "ear.voice") "live lane open")
                (eab-absent? (ea-asleep-rows (ea-lanes-none)) "ear.voice"))) 1) 32768 0)
        ; 65536 — the ear's own latency instruments. Which of the three closes ended the line, and
        ; how long the words had already been final when it fired; how many passes the open line
        ; has held still, so a reader can take settled words without waiting for the close; the
        ; room's own quiet and the gate standing over it — the one row that tells a gate sitting
        ; ON the noise floor, which is a gate that can never fall silent and so a line that can
        ; never close on a pause; and a refusal shown AS a refusal, which must not cost the open
        ; line its words: the phantom stands after the live frame in this run on purpose
        (if (eq (eab-all? (list
                (eab-has? (eab-str rows2 "ear.close") "decoder")
                (eab-has? (eab-str rows2 "ear.close") "already final 900 ms")
                (if (eq (eab-num rows2 "ear.stable") 5) 1 0)
                (eab-has? (eab-str rows2 "ear.gate") "quiet 74")
                (eab-has? (eab-str rows2 "ear.gate") "voice over 296")
                (if (str_eq (eab-str rows2 "ear.phantom") "(music playing)") 1 0)
                (eab-has? (eab-str rows2 "ear.live") LINE)
                (eab-absent? rows "ear.phantom")
                (if (str_eq (eab-door rows "ear.phantom") "ear.spool.phantom") 1 0)
                (if (str_eq (ea-close-of "" 0) "") 1 0)
                (if (str_eq (ea-close-of "pause" (sub 0 1)) "pause") 1 0))) 1) 65536 0))))
