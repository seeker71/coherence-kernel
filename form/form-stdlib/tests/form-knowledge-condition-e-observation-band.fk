; witnessed: 2026-08-27 -> 4095
; preludes: form-stdlib/form-knowledge-condition-e-observation.fk

(do
    (defn fkceob-bit (held bit) (if held bit 0))
    (let o (fkceo-observe))
    (sum (list
        (fkceob-bit (str_eq (nth o 0) (fkceo-schema)) 1)
        (fkceob-bit (eq (fkceo-current? o) 1) 2)
        (fkceob-bit (eq (fkceo-bytes o) 622) 4)
        (fkceob-bit (str_eq (nth o 2) (nth o 3)) 8)
        (fkceob-bit (eq (fkceo-parse-signal o) 0) 16)
        (fkceob-bit (str_eq (fkceo-parse-reason o) "present-invalid") 32)
        (fkceob-bit (nothing? (fkceo-lowered o)) 64)
        (fkceob-bit (eq (fkceo-harness-ran? o) 0) 128)
        (fkceob-bit (nothing? (fkceo-semantic o)) 256)
        (fkceob-bit (eq (fkceo-semantic-max o) 511) 512)
        (fkceob-bit (and (eq (nth o 12) 0)
                          (and (eq (nth o 13) 0) (eq (nth o 14) 0))) 1024)
        (fkceob-bit (and (str_eq (fked-challenge-id)
                    "59cb1b298ad94c111b19943580a4155bb332efec3b3d85a7b132f1a2e8866b70")
                    (eq (fked-training-denied?) 1)) 2048))))
