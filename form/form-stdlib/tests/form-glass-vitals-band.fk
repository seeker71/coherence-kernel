; form-glass-vitals-band.fk — the body takes its own vitals, naming no organ.
;
; A declaration of which organs must keep giving is only as good as what
; somebody remembered to write in it. This door writes down no organ at all: it
; watches, and lets every surface teach its own rhythm. Health is not a number
; anyone set — it is a surface still resembling itself.
;
; The hardest thing to get right here is not detecting a stopped organ. It is
; refusing to accuse a slow one, and refusing to mistake a young watch for a
; still body. Bits 4 and 8 are those two refusals.
;
; Bits 1..64 are pure over fixtures. Bit 128 crosses for real: a surface is
; published into a band-private space, watched across two real censuses, and
; the body's own vitals are published as a frame and read back.
;
; Expected: 1023
;
;   1    a watched surface carries its name, the stamp it last showed, how many
;        beats this watch has seen, and the widest gap it has demonstrated
;   2    the bound is the surface's OWN widest gap times the slack — a 500 ms
;        organ and a 5 s organ are held to different silences, and neither
;        number was chosen by this door
;   4    a surface not seen to move at least TWICE is RESTING, never faltering:
;        one gap is a moment, not a cadence, so no claim is made. This is the
;        refusal that keeps a slow publisher from being called sick.
;   8    a watch reports how long it has been watching, so a reading from a
;        young watch cannot pass its own youth off as the body's stillness
;   16   observing a census updates a known surface, admits an unknown one with
;        no rhythm and no claim, and counts a beat only when the stamp ADVANCES
;   32   the widest gap is the widest ever seen, not the latest: a surface that
;        was once slow is still allowed to be that slow again
;   64   the body's reading partitions into beating, faltering and resting, and
;        attention is exactly the faltering ones
;   128  a REAL surface: published, watched across real censuses, found beating,
;        and the vitals SIGNALLED as a frame and read back — one body row plus
;        one row per surface asking for attention, so the signal is bounded by
;        what is wrong and not by how much exists, and the surface true name,
;        which the membrane label law will not take as an id, rides in the cell
;   256  EFFORT: a surface can beat exactly on time and still consume a whole
;        core. One core is the unit, not a preference, so SATURATED needs a
;        single reading; LABOURING is the relative one, a departure from this
;        kernel own calmest; and with too few readings, "unlearned", not a guess
;   512  a REAL kernel: this process own live page read twice with work between,
;        so the effort reported is CPU this process actually spent
;
; preludes: form/form-stdlib/form-glass-vitals.bml

(do
    (defn xb (ok bit) (if ok bit 0))

    ; a surface last seen at 10000, four beats, widest gap it ever showed 500 ms
    (let fast (fgv-entry "fixture.fast" 10000 4 500 1000))
    ; the same history, but this one has demonstrated it can take 5 s
    (let slow (fgv-entry "fixture.slow" 10000 4 5000 1000))
    ; seen once, never seen to move: nothing is known about its rhythm
    (let fresh (fgv-entry "fixture.fresh" 10000 0 0 9000))

    (let b1 (xb (and (str_eq (fgv-name fast) "fixture.fast")
              (and (eq (fgv-last-spoke fast) 10000)
              (and (eq (fgv-beats fast) 4)
              (and (eq (fgv-widest fast) 500)
              (and (eq (fgv-entry? fast) 1)
              (and (eq (fgv-entry? (list "nope")) 0)
                   (eq (fgv-silence fast 10400) 400))))))) 1))

    ; the same silence, two verdicts, because each surface set its own bound
    (let b2 (xb (and (eq (fgv-own-bound fast) 1500)
              (and (eq (fgv-own-bound slow) 15000)
              (and (str_eq (fgv-state fast 11400) "beating")
              (and (str_eq (fgv-state fast 11600) "faltering")
              (and (str_eq (fgv-state slow 11600) "beating")
                   (str_eq (fgv-state slow 25100) "faltering")))))) 2))

    ; the refusal: no rhythm witnessed, no claim made — however long it is quiet
    (let b3 (xb (and (str_eq (fgv-state fresh 10400) "resting")
              (and (str_eq (fgv-state fresh 99999999) "resting")
              (and (eq (fgv-attention? fresh 99999999) 0)
                   (eq (fgv-attention? fast 11600) 1)))) 4))

    ; the watch says how young it is
    (let es (list fast slow fresh))
    (let b4 (xb (and (eq (fgv-watched-ms es 11000) 10000)
              (and (eq (fgv-watching-since es -1) 1000)
              (and (eq (fgv-watched-ms (list) 11000) 0)
                   (eq (fgv-watched-ms es 500) 0)))) 8))

    ; observing: a stamp that advanced is a beat, one that did not is not, and a
    ; name never seen before is admitted with no rhythm and no claim
    (let census (list (fgx-slot "fixture.fast" 10800 0) (fgx-slot "fixture.slow" 10000 0) (fgx-slot "fixture.new" 777 0)))
    (let seen (fgv-observe es census 12000))
    (let b5 (xb (and (eq (len seen) 3)
              (and (eq (fgv-beats (fgv-find seen "fixture.fast")) 5)
              (and (eq (fgv-last-spoke (fgv-find seen "fixture.fast")) 10800)
              (and (eq (fgv-beats (fgv-find seen "fixture.slow")) 4)
              (and (eq (fgv-beats (fgv-find seen "fixture.new")) 0)
              (and (eq (fgv-first-seen (fgv-find seen "fixture.new")) 12000)
                   (eq (len (fgv-find seen "fixture.gone")) 0))))))) 16))

    ; the widest gap is the widest EVER, so a once-slow surface keeps its licence
    (let narrow (fgv-observe seen (list (fgx-slot "fixture.fast" 10850 0)) 12100))
    (let b6 (xb (and (eq (fgv-widest (head narrow)) 800)
              (and (eq (fgv-beats (head narrow)) 6)
                   (eq (fgv-own-bound (head narrow)) 2400))) 32))

    (let body (fgv-body es 11600))
    (let b7 (xb (and (eq (fgv-body? body) 1)
              (and (eq (fgv-body-watched body) 3)
              (and (eq (fgv-body-beating body) 1)
              (and (eq (fgv-body-faltering body) 1)
              (and (eq (fgv-body-resting body) 1)
              (and (eq (add (fgv-body-beating body) (add (fgv-body-faltering body) (fgv-body-resting body))) (fgv-body-watched body))
                   (str_eq (fgv-name (head (fgv-needing-attention es 11600))) "fixture.fast"))))))) 64))

    ; ---- a real surface, watched across two real censuses, and the signal given
    (defn v-sample (id)
        (fgtm-sample id (fgtm-absent) "metric" "membrane" "band" "lane" "vitals"
            (fgtm-absent) (fgtm-absent) "active" (fgtm-present 1) (fgtm-present 1)
            (fgtm-absent) (fgtm-absent) "never" "declared" "band" (list "vitals")))
    (let root (str_concat "/tmp/form-glass-vitals-band." (int_to_str (host_pid))))
    (let nm (str_concat root "|band.vital"))
    ; three gives, so TWO gaps: one gap is a moment, two are a rhythm. The gaps
    ; are 50 ms because the bound they build (widest x slack) must outlast the
    ; reading itself — at 4 ms gaps the surface was called faltering by the very
    ; pass that was measuring it.
    (let p1 (fgtm-publish-snapshot root "band.vital" (now_unix_ms) (list (v-sample "v.one"))))
    (let w1 (fgv-observe (list) (fgx-roster-slots (now_unix_ms)) (now_unix_ms)))
    (let gap1 (host_sleep_ms 50))
    (let p2 (fgtm-publish-snapshot root "band.vital" (now_unix_ms) (list (v-sample "v.one"))))
    (let w1b (fgv-observe w1 (fgx-roster-slots (now_unix_ms)) (now_unix_ms)))
    (let gap2 (host_sleep_ms 50))
    (let p3 (fgtm-publish-snapshot root "band.vital" (now_unix_ms) (list (v-sample "v.one"))))
    (let w2 (fgv-observe w1b (fgx-roster-slots (now_unix_ms)) (now_unix_ms)))
    (let mine (fgv-find w2 nm))
    ; one surface that taught a rhythm and then departed from it, so the signal
    ; has something real to carry beside the healthy ones
    (let w3 (cons (fgv-entry "fixture.stalled" 1000 4 500 1000) w2))
    (let put (fgv-publish root w3 (list) (now_unix_ms)))
    (let back (fgtm-read-current root "vitals"))
    (let rows (fgtm-snapshot-samples (fgtm-field-value (fgtm-read-state-value back))))
    ; the signal is bounded by what is WRONG, not by how much exists: one body
    ; row and one row per surface asking for attention. A watch of 140-odd
    ; surfaces signals in two rows, and the surface's true name — which the
    ; membrane's label law will not take as an id — rides in the cell.
    (let signalBody (fgv-signal-body rows))
    (let signalFindings (fgv-signal-findings rows))
    (let b8 (xb (and (eq (fgv-beats mine) 2)
              (and (gt (fgv-own-bound mine) 100)
              (and (str_eq (fgv-state mine (now_unix_ms)) "beating")
              (and (str_eq (nth put 1) "published")
              (and (str_eq (fgtm-read-state-status back) "current")
              (and (lt (len rows) (len w3))
              (and (eq (fgv-body-watched signalBody) (len w3))
              (and (eq (fgv-body-faltering signalBody) (len signalFindings))
              (and (eq (fgv-signal-attention? signalFindings "fixture.stalled") 1)
              (and (eq (fgv-signal-attention? signalFindings nm) 0)
                   (eq (fgv-signal-attention? signalFindings "never.watched") 0))))))))))) 128))

    ; ---- EFFORT: a surface can beat on time and still consume a whole core
    (defn burn (n acc) (if (eq n 0) acc (burn (sub n 1) (add acc n))))
    (let idle (fgv-effort 999 1000 5000 4 10 20 10))
    (let hot (fgv-effort 999 1000 5000 4 10 900 900))
    (let pinned (fgv-effort 999 1000 5000 1 0 1004 1004))
    (let young (fgv-effort 999 1000 5000 1 40 40 40))
    ; one core is the unit, not a preference; saturation needs one reading only
    (let b9 (xb (and (eq (fgv-saturation) 937)
              (and (str_eq (fgv-effort-state pinned) "saturated")
              (and (eq (fgv-saturated? pinned) 1)
              (and (str_eq (fgv-effort-state idle) "easy")
              (and (str_eq (fgv-effort-state hot) "labouring")
              (and (str_eq (fgv-effort-state young) "unlearned")
              (and (eq (fgv-effort-attention? idle) 0)
              (and (eq (fgv-effort-attention? young) 0)
              (and (eq (len (fgv-labouring (list idle hot pinned young))) 2)
                   (str_eq (fgv-finding-name (fgv-effort-finding pinned)) "kernel.999")))))))))) 256))

    ; ---- a REAL kernel: this process's own page, read twice with work between
    (let e1 (fgv-efforts (list)))
    (let toil (burn 200000 0))
    (let e2 (fgv-efforts e1))
    (let self (fgv-effort-find e2 (host_pid)))
    (let b10 (xb (and (gt (len e2) 0)
               (and (gt (len self) 0)
               (and (ge (fgv-effort-samples self) 1)
               (and (ge (fgv-effort-latest self) 0)
               (and (gt (fgv-effort-cpu self) 0)
                    (ge (fgv-effort-busiest self) (fgv-effort-calmest self))))))) 512))

    (print (list "vitals" (fgv-body w2 (now_unix_ms)) "self-effort" self))
    (sum (list b1 b2 b3 b4 b5 b6 b7 b8 b9 b10)))
