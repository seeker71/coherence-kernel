; form-knowledge-ingest-source-band.fk — ingest teaching points at the cells
; the sealed family actually cites, and those cells still hold their laws.
;
; No Qwen. No sealed prompts. Verdict 2047:
;   1     nbo source is ingest/name-build-observe.fk, not crystallize
;   2     equivalent-storage teach source is the public curriculum, not the sealed cell
;   4     depth-threshold teach source is the public curriculum, not the sealed cell
;   8     public curriculum and the three ingest cells are readable
;  16     same Blueprint -> one cell (ec-cells2)
;  32     ki-deep? at depth 3, not at depth 1
;  64     overlay prefix names the three ingest paths
; 128     knowledge-prefix names the three ingest paths
; 256     collapse cell contains "one cell"
; 512     knowledge-ingest cell contains "depth at least 3"
; 1024    census registers both ingest concepts on those cells
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/equivalence-collapse.fk form-stdlib/knowledge-ingest.fk
; witnessed: 2026-08-26 -> 2047; public curriculum disjoint; overlay names cells; v326 live 1000000ppm

(do
    (defn fisb (ok bit) (if ok bit 0))
    (let p0 (fqt-source-of "ingest-name-build-observe"))
    (let p1 (fqt-source-of "ingest-equivalent-storage"))
    (let p2 (fqt-source-of "ingest-depth-threshold"))
    (let nbo "ingest/name-build-observe.fk")
    (let collapse "form/form-stdlib/equivalence-collapse.fk")
    (let depth "form/form-stdlib/knowledge-ingest.fk")
    (let pub "form/form-stdlib/form-knowledge-ingest-public-curriculum.fk")
    (add (fisb (str_eq p0 nbo) 1)
    (add (fisb (and (str_eq p1 pub) (not (str_eq p1 collapse))) 2)
    (add (fisb (and (str_eq p2 pub) (not (str_eq p2 depth))) 4)
    (add (fisb (and (gt (str_len (read_file pub)) 0)
                    (and (gt (str_len (read_file nbo)) 0)
                    (and (gt (str_len (read_file collapse)) 0)
                         (gt (str_len (read_file depth)) 0)))) 8)
    (add (fisb (eq (ec-cells2 (list 7) (list 7)) 1) 16)
    (add (fisb (and (eq (ki-deep? (list 3 0)) 1)
                    (eq (ki-deep? (list 1 0)) 0)) 32)
    (add (fisb (and (ge (str_find (fqt-overlay-prefix) collapse 0) 0)
                    (and (ge (str_find (fqt-overlay-prefix) depth 0) 0)
                         (ge (str_find (fqt-overlay-prefix) nbo 0) 0))) 64)
    (add (fisb (and (ge (str_find (fqt-knowledge-prefix) collapse 0) 0)
                    (and (ge (str_find (fqt-knowledge-prefix) depth 0) 0)
                         (ge (str_find (fqt-knowledge-prefix) nbo 0) 0))) 128)
    (add (fisb (ge (str_find (read_file collapse) "one cell" 0) 0) 256)
    (add (fisb (ge (str_find (read_file depth) "depth at least 3" 0) 0) 512)
         (fisb (and (ge (str_find (read_file "form/form-stdlib/form-knowledge-integration-census.fk")
                                  "equivalent-source-storage" 0) 0)
                    (ge (str_find (read_file "form/form-stdlib/form-knowledge-integration-census.fk")
                                  "knowledge-depth-threshold" 0) 0)) 1024))))))))))))
