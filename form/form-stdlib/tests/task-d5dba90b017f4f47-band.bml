; Native case observations; the final reading is their conjunction.
; Verdict 1
; preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-code-memory.bml form-stdlib/bml/host-child.bml form-stdlib/core.fk
section [form.bml] {
 let all=true;
 let result0=try [(hch-tail-line("hello\n"))] catch [];
 let actual0=nil?(result0) ? nothing() : result0[0];
 let expected0="hello";
 let held0=len(result0)==1 && actual0==expected0;
 print_str(json-emit(fcam-pack(["hch-tail-line(\"hello\\n\")",value_kind(actual0),actual0,expected0,held0,len(result0)==1])));
