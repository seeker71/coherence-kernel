// preludes: form-stdlib/bml/form-cli-review-spans.bml
section [form.bml] {
 class ReviewSpanBehavior {
  def rsb-same(label,actual,expected) = if value_eq(actual,expected) then 1 else {
   print(list("failed",label,"actual",actual,"expected",expected));
   form_error(str_concat("review span behavior: ",label));
  };
 }
 let empty = rsb-same("empty",fcrs-spans(""),list());
 let unicode = rsb-same("UTF-8 byte offsets",fcrs-spans("é. 好?"),list(list(0,4,"é. "),list(4,8,"好?")));
 let punctuation = rsb-same("adjacent punctuation and suffix",fcrs-spans("A?! B. tail"),list(list(0,4,"A?! "),list(4,7,"B. "),list(7,11,"tail")));
 let decimal = rsb-same("decimal and newline",fcrs-spans("v2.5 ok.\nNext!"),list(list(0,9,"v2.5 ok.\n"),list(9,14,"Next!")));
 let whitespace = rsb-same("whitespace only",fcrs-spans(" \t\n"),list(list(0,3," \t\n")));
 let suffix = rsb-same("no punctuation",fcrs-spans("Hello"),list(list(0,5,"Hello")));
 let final = rsb-same("no empty tail",fcrs-spans("A."),list(list(0,2,"A.")));
 let rows = list(list(0,3,"A. "),list(3,4,"B"));
 let complete = rsb-same("exact partition",fcrs-complete?("A. B",rows),1);
 let gap = rsb-same("gap",fcrs-complete?("A. B",list(list(0,2,"A."),list(3,4,"B"))),0);
 let overlap = rsb-same("overlap",fcrs-complete?("A. B",list(list(0,3,"A. "),list(2,4," B"))),0);
 let altered = rsb-same("changed bytes",fcrs-complete?("A. B",list(list(0,3,"A! "),list(3,4,"B"))),0);
 let outside = rsb-same("end out of bounds",fcrs-complete?("A. B",list(list(0,5,"A. B"))),0);
 let malformed = rsb-same("short row",fcrs-complete?("A.",list(list(0,2))),0);
 let scalarRow = rsb-same("scalar row",fcrs-complete?("A.",list(3)),0);
 let scalarRows = rsb-same("non-list rows",fcrs-complete?("A.","rows"),0);
 let floatStart = rsb-same("float start",fcrs-complete?("A.",list(list(0.0,2,"A."))),0);
 let textStart = rsb-same("string start",fcrs-complete?("A.",list(list("0",2,"A."))),0);
 let floatEnd = rsb-same("float end",fcrs-complete?("A.",list(list(0,2.0,"A."))),0);
 let missingTail = rsb-same("missing suffix",fcrs-complete?("A. B",list(list(0,3,"A. "))),0);
 let emptyComplete = rsb-same("empty complete",fcrs-complete?("",list()),1);
 let emptyIncomplete = rsb-same("empty omits nonempty",fcrs-complete?("A.",list()),0);
 let zeroWidth = rsb-same("zero width row",fcrs-complete?("",list(list(0,0,""))),0);
 let ids = rsb-same("all IDs",fcrs-ids-complete?(rows,list(0,1)),1);
 let missingId = rsb-same("missing ID",fcrs-ids-complete?(rows,list(0)),0);
 let duplicateId = rsb-same("duplicate ID",fcrs-ids-complete?(rows,list(0,0)),0);
 let reordered = rsb-same("reordered IDs",fcrs-ids-complete?(rows,list(1,0)),0);
 let extra = rsb-same("extra ID",fcrs-ids-complete?(rows,list(0,1,2)),0);
 let floatId = rsb-same("float ID",fcrs-ids-complete?(rows,list(0.0,1)),0);
 let textId = rsb-same("string ID",fcrs-ids-complete?(rows,list("0",1)),0);
 let scalarIds = rsb-same("non-list IDs",fcrs-ids-complete?(rows,"01"),0);
 let noIds = rsb-same("no spans no IDs",fcrs-ids-complete?(list(),list()),1);
 let negative = rsb-same("negative ID",fcrs-ids-complete?(rows,list(-1,0)),0);
 print_str("review-span behavior cases=32 passed=32; coverage does not establish judgment correctness");
 1;
}
