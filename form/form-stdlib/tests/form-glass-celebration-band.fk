; form-glass-celebration-band.fk — observed change, offered feeling, shared receipt.
; preludes: form-stdlib/bml/form-glass-celebration.bml
; Verdict 16383: valid change, movement, named feeling, exact matching, waiting
; without an offer, refusal on mismatch, celebration, received-body observation,
; human line, stable receipt identity, steady state, wake provenance, and an
; observed ice change received as a gift without inventing a feeling.
; witnessed: 2026-09-04 -> 16383

(do
    (defn fgcb (held bit) (if (eq held 1) bit 0))
    (let change (fgc-change "walk-home" "economy" "8" "9"))
    (let same (fgc-change "walk-home" "economy" "9" "9"))
    (let felt (fgc-felt "Urs" "walk-home" "economy" "received"))
    (let other (fgc-felt "Urs" "walk-home" "other" "received"))
    (let ice (fgc-change "glass" "ice" "0" "1"))
    (let awaiting (fgc-receive change (list)))
    (let refused (fgc-receive change other))
    (let celebrated (fgc-receive change felt))
    (let body (fgc-body-observation celebrated))
    (let wake (fgel-wake "telemetry" 7 "walk-home" "economy"))
    (let from-wake (fgc-change-from-wake wake "8" "9"))
    (sum (list
        (fgcb (eq (fgc-change-valid? change) 1) 1)
        (fgcb (eq (fgc-change-observed? change) 1) 2)
        (fgcb (eq (fgc-felt-valid? felt) 1) 4)
        (fgcb (eq (fgc-felt-for? change felt) 1) 8)
        (fgcb (str_eq (fgc-receipt-state awaiting) "awaiting-felt") 16)
        (fgcb (str_eq (fgc-receipt-state refused) "refused-unmatched-felt") 32)
        (fgcb (eq (fgc-celebrated? celebrated) 1) 64)
        (fgcb (and (eq (len body) 5) (str_eq (head body) "form-glass-felt-received-v1")) 128)
        (fgcb (ge (str_find (fgc-line celebrated) "received from Urs as received" 0) 0) 256)
        (fgcb (node_eq (fgc-receipt-node celebrated) (fgc-receipt-node (fgc-receive change felt))) 512)
        (fgcb (str_eq (fgc-receipt-state (fgc-receive same felt)) "steady") 1024)
        (fgcb (and (str_eq (fgc-change-source from-wake) "walk-home")
                   (str_eq (fgc-change-evidence from-wake) "economy")) 2048)
        (fgcb (str_eq (fgc-receipt-state (fgc-receive ice (list))) "gift-received") 4096)
        (fgcb (and (eq (len (fgc-ice-gift-observation ice)) 5)
                   (str_eq (head (fgc-ice-gift-observation ice)) "form-glass-ice-gift-received-v1")) 8192))))
