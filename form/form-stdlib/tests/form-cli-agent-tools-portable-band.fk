; Nested BML preludes must reach every proof sibling, as they reach fkwu.
; Verdict 127. No host effects or runtime counters are invoked in this band.
; witnessed: 2026-09-04 -> 127
; preludes: form-stdlib/core.fk form-stdlib/form-cli.fk
(do
    (defn fatp-docs () (list (list "src:one" "one.txt" "alpha 1\nbeta 2\n")))
    (defn fatp-call (tool args input) (fc-tool-call (fatp-docs) tool args input))
    (defn fatp-good (r text)
        (and (eq (fat-exit r) 0) (and (str_eq (fat-error r) "") (str_eq (fat-out r) text))))
    (defn fatp-bit (ok bit) (if ok bit 0))
    (sum (list
        (fatp-bit (eq (len (fat-tools)) 15) 1)
        (fatp-bit (fatp-good (fatp-call "rg" (list "-n" "^alpha\\s+[0-9]+$") "") "one.txt:1:alpha 1\n") 2)
        (fatp-bit (fatp-good (fatp-call "jq" (list "-r" ".items[] | .name") "{\"items\":[{\"name\":\"a\"},{\"name\":\"b\"}]}") "a\nb\n") 4)
        (fatp-bit (fatp-good (fatp-call "sed" (list "-n" "2p" "one.txt") "") "beta 2\n") 8)
        (fatp-bit (str_eq (fat-error (fatp-call "jq" (list ".") "truefalse")) "invalid-json-input") 16)
        (fatp-bit (do (let r (fatp-call "edit" (list "one.txt" "alpha" "gamma") ""))
            (and (eq (fat-exit r) 0)
                (and (str_eq (nth (fat-find-doc (fat-documents r) "one.txt") 2) "gamma 1\nbeta 2\n")
                     (str_eq (nth (fat-find-doc (fatp-docs) "one.txt") 2) "alpha 1\nbeta 2\n")))) 32)
        (fatp-bit (str_eq (fat-error (fc-tool-command (fatp-docs) "cat | wc" "")) "shell-syntax-not-supported") 64))))
