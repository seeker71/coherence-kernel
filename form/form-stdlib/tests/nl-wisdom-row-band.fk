; preludes: form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-loader.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/string-case.fk form-stdlib/nl-lexicon-data.fk form-stdlib/nl-translate.fk form-stdlib/nl-tongues.fk form-stdlib/nl-wisdom-row.fk
;
; nl-wisdom-row-band.fk — fourteen tongues, one NEW meaning, one node:
; WISDOM IS TENDED, property(n7, n8).
;
; PROOF LEVEL: FOUR-WAY on 2026-08-04 — 268435455 on fkwu (--src, fresh
; compile) and on the three heavy kernels (go, rust, ts), each run on the
; concatenated prelude closure + this band (the heavy kernels do not read the
; `; preludes:` line; the elder nl-many-band calibrated every arm at its known
; 67108863 the same day, same method). Two seams named, not hidden: the three
; MINIMAL walkers cannot run this chain at all (`bp` is unbound there — the
; same set-boundary room-cipher-band already names), and the ts heavy kernel
; in this checkout answers only through an esbuild bundle of src/main.ts,
; because its deep-stack worker re-imports kernel.ts extensionless and the
; tsx loader does not ride into Worker threads. fkwu's fresh compile carries
; the four already-named numb-op seams of the prelude chain (value_kind and
; kin, CURRENT_FLOOR.md); preflight reads the chain clean and the verdict
; readable — the elder band carries the identical four.
;
; The same sentence — the meaning nl-wisdom-row.fk carried home — enters
; through all fourteen tongue doors (en id from nl-translate; es de fr pt ru
; sw zh ja ar hi tr sa from nl-tongues, each with its two appended rows), and
; every parse is asked to intern to the IDENTICAL pivot node; each decoder then
; projects the pivot back to its surface and the round-trip is asked to return
; the same node again. Translation as content-address identity, no tongue
; favored — the shelf's own acceptance shape (nl-many-band.fk), pointed at a
; row the corpus did not hold yesterday.
;
; Bits, mirroring nl-many-band's 26: for each of the 12 shelf tongues a pair
; (parse ≡ pivot at bit-lo, round-trip ≡ pivot at bit-lo*2, sa riding
; 16777216 as there); + the elder id door meeting the node (4194304); + a
; chain es -> ja -> hi holding the node fixed (8388608). Two bits beyond the
; shelf's shape pin the pivot to the SYMBOL space: its kid values are the
; neutral symbols n7 (67108864) and n8 (134217728). A lexicon miss passes a
; surface through unchanged and still round-trips green; these two bits are
; where that silence would show.
;
; Verdict 268435455 when every tongue speaks, none is favored, and the pivot
; speaks the body's own neutral symbols.
(do
    (let pivot (wr-norm-en (g-parse (nl-en) "the wisdom is tended")))

    (defn wpair (enc-node rt-node pv bit-lo)
        (add (if (node_eq enc-node pv) bit-lo 0)
             (if (node_eq rt-node pv) (mul bit-lo 2) 0)))

    (let p-es (wr-enc-es "el saber es cuidado"))
    (let p-de (wr-enc-de "der weisheit ist gepflegt"))
    (let p-fr (wr-enc-fr "le discernement est soigne"))
    (let p-pt (wr-enc-pt "o discernimento e cuidado"))
    (let p-ru (wr-enc-ru "мудрость есть ухожена"))
    (let p-sw (wr-enc-sw "hekima ni inatunzwa"))
    (let p-zh (wr-enc-zh "智慧 是 培育"))
    (let p-ar (wr-enc-ar "حكمة هو مرعية"))
    (let p-hi (wr-enc-hi "प्रज्ञा पोषित है"))
    (let p-tr (wr-enc-tr "bilgelik bakılan dir"))
    (let p-ja (wr-enc-ja "ちえ は そだてられる です"))
    (let p-sa (wr-enc-sa "प्रज्ञा पोषिता अस्ति"))

    (let c-es (wpair p-es (wr-enc-es (wr-dec-es pivot)) pivot 1))
    (let c-de (wpair p-de (wr-enc-de (wr-dec-de pivot)) pivot 4))
    (let c-fr (wpair p-fr (wr-enc-fr (wr-dec-fr pivot)) pivot 16))
    (let c-pt (wpair p-pt (wr-enc-pt (wr-dec-pt pivot)) pivot 64))
    (let c-ru (wpair p-ru (wr-enc-ru (wr-dec-ru pivot)) pivot 256))
    (let c-sw (wpair p-sw (wr-enc-sw (wr-dec-sw pivot)) pivot 1024))
    (let c-zh (wpair p-zh (wr-enc-zh (wr-dec-zh pivot)) pivot 4096))
    (let c-ar (wpair p-ar (wr-enc-ar (wr-dec-ar pivot)) pivot 16384))
    (let c-hi (wpair p-hi (wr-enc-hi (wr-dec-hi pivot)) pivot 65536))
    (let c-tr (wpair p-tr (wr-enc-tr (wr-dec-tr pivot)) pivot 262144))
    (let c-ja (wpair p-ja (wr-enc-ja (wr-dec-ja pivot)) pivot 1048576))
    (let c-sa (wpair p-sa (wr-enc-sa (wr-dec-sa pivot)) pivot 16777216))

    ; the elder id door meets the same node through its own grammar
    (let c-elder (if (node_eq (wr-enc-id "kebijaksanaan adalah dirawat") pivot) 4194304 0))
    ; a chain across three scripts holds the node fixed
    (let c-chain (if (node_eq (wr-enc-hi (wr-dec-hi (wr-enc-ja (wr-dec-ja (wr-enc-es (wr-dec-es pivot)))))) pivot) 8388608 0))
    ; the pivot speaks the neutral symbols, not a passed-through surface
    (let c-sym7 (if (str_eq (nlt-kidv pivot 0) "n7") 67108864 0))
    (let c-sym8 (if (str_eq (nlt-kidv pivot 1) "n8") 134217728 0))

    (add c-es (add c-de (add c-fr (add c-pt (add c-ru (add c-sw (add c-zh
        (add c-ar (add c-hi (add c-tr (add c-ja (add c-sa
        (add c-elder (add c-chain (add c-sym7 c-sym8))))))))))))))))
