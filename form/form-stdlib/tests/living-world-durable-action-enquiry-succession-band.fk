; living-world-durable-action-enquiry-succession-band.fk -- a new source may
; join, revise, abstain, revoke, and leave without choosing for the field.
; Verdict 65535 proves sixteen durable succession and no-action properties.
; witnessed: 2026-08-08 -> 65535 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-action-enquiry.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk form-stdlib/tests/living-world-action-enquiry-witness.fk form-stdlib/tests/living-world-durable-action-enquiry-witness.fk form-stdlib/tests/living-world-durable-action-enquiry-succession-witness.fk

(do
    (lwdaes-clean-all)
    (let seed (lwaew-outsider-world))
    (let seed-question (lwdaes-question-for seed))
    (let seed-evidence
        (lwae-stance-evidence-for seed seed-question))
    (let seed-image (lwcn-image seed))
    (let saved-before (lwdaeq-save-world seed))
    (let loaded-before (lwdaeq-load))
    (let before-image (lwcd-result-image loaded-before))
    (let before-stored (lwcn-image-world before-image))
    (let before-proposal
        (lwcn-restore-proposal
            (lwdaeq-admission-world before-image) before-image))
    (let before-restored
        (lwt-round-world (lwdaeq-restored-round before-image)))
    (let question (lwdaes-question-for before-restored))
    (let historical
        (lwae-stance-evidence-for before-restored question))
    (let alternative (lwdaes-alternative-stance question))
    (let abstain (lwdaes-abstain-stance question))
    (let unjoined (lwdaes-unjoined-world before-restored))
    (let joined (lwdaes-joined-world before-restored))
    (let revised (lwdaes-revised-world joined))
    (let successor (lwdaes-successor-world revised))
    (let successor-evidence
        (lwae-stance-evidence-for successor question))
    (let successor-image (lwcn-image successor))
    (let saved-after (lwdaes-save-after successor))
    (let loaded-after (lwdaes-load-after))
    (let after-image (lwcd-result-image loaded-after))
    (let after-stored (lwcn-image-world after-image))
    (let after-question (lwdaes-question-for after-stored))
    (let after-evidence
        (lwae-stance-evidence-for after-stored after-question))
    (let after-proposal
        (lwcn-restore-proposal
            (lwdaeq-admission-world after-image) after-image))
    (let after-candidate (lwt-proposal-candidate after-proposal))
    (let abstaining
        (lwt-round-world
            (lwdaes-abstaining-restore-round after-image)))
    (let restored
        (lwt-round-world (lwdaeq-restored-round after-image)))
    (let restored-question (lwdaes-question-for restored))
    (let restored-evidence
        (lwae-stance-evidence-for restored restored-question))
    (let restored-abstain
        (lwdaes-evidence-for-stance
            restored restored-question abstain))
    (let pending
        (lwae-stance-evidence-stance
            (lwdaeq-evidence-pending
                (lwo-field-items restored-evidence))))
    (let expired-nothing
        (lwae-stance-evidence-stance
            (lwdaeq-evidence-expired-nothing
                (lwo-field-items restored-evidence))))
    (let stack
        (lwlc-declaration-stack (lwae-stance-declaration pending)))
    (let field
        (lwae-question-field
            (lwo-emergent-shape restored-question)))
    (let departed (lwdaes-departed-world restored))
    (let departed-evidence
        (lwae-stance-evidence-for departed restored-question))
    (let score
        (lwdaeq-sum
            (list
                (if (and (eq (lwo-field-size
                                  (lwdaeq-questions seed)) 1)
                         (eq (lwo-field-size seed-evidence) 4)) 1 0)
                (if (and (eq (lwcd-saved? saved-before) 1)
                         (and (eq (lwcd-loaded? loaded-before) 1)
                              (and (node_eq before-image seed-image)
                                   (node_eq before-stored seed)))) 2 0)
                (if (and (eq (lwcn-restored? before-restored
                                  (lwt-proposal-candidate
                                      before-proposal)) 1)
                         (and (node_eq question seed-question)
                              (eq (lwo-field-size historical) 4))) 4 0)
                (if (and (eq (lwo-field-size
                                  (lwae-stance-evidence-for
                                      unjoined question)) 4)
                         (node_eq
                            (lwdaes-evidence-for-stance
                                unjoined question alternative)
                            (lwo-none))) 8 0)
                (if (and (eq (lwo-active-by? joined question
                                  (lwdaes-source-j)) 1)
                         (and (eq (lwo-field-size
                                      (lwae-stance-evidence-for
                                          joined question)) 5)
                              (eq (lwdaes-field-contained? historical
                                      (lwae-stance-evidence-for
                                          joined question)) 1))) 16 0)
                (if (and (eq (lwo-field-size
                                  (lwae-stance-evidence-for
                                      revised question)) 6)
                         (and (not (node_eq
                                      (lwdaes-evidence-for-stance
                                          revised question alternative)
                                      (lwo-none)))
                              (not (node_eq
                                      (lwdaes-evidence-for-stance
                                          revised question abstain)
                                      (lwo-none))))) 32 0)
                (if (and (eq (lwo-field-size successor-evidence) 5)
                         (and (node_eq
                                  (lwdaes-evidence-for-stance
                                      successor question alternative)
                                  (lwo-none))
                              (not (node_eq
                                      (lwdaes-evidence-for-stance
                                          successor question abstain)
                                      (lwo-none))))) 64 0)
                (if (eq (lwdaes-field-contained?
                            historical successor-evidence) 1) 128 0)
                (if (and (eq (lwcd-saved? saved-after) 1)
                         (and (eq (lwcd-loaded? loaded-after) 1)
                              (and (node_eq
                                      (lwcd-result-image saved-after)
                                      successor-image)
                                   (node_eq after-image
                                      successor-image)))) 256 0)
                (if (and (node_eq after-question question)
                         (and (eq (lwo-field-size after-evidence) 5)
                              (and (eq (lwo-active-by?
                                          after-stored after-question
                                          (lwdaes-source-j)) 1)
                                   (eq (lwo-field-has?
                                          (lwt-proposal-participants
                                              after-proposal)
                                          (lwdaes-source-j)) 1)))) 512 0)
                (if (eq (lwcn-restored?
                            abstaining after-candidate) 0) 1024 0)
                (if (and (eq (lwcn-restored?
                                  restored after-candidate) 1)
                         (and (node_eq restored-question question)
                              (eq (lwo-field-size
                                      restored-evidence) 5))) 2048 0)
                (if (and (not (node_eq restored-abstain (lwo-none)))
                         (and (eq (lwae-stance-immediate-nothing?
                                      abstain) 1)
                              (and (not (node_eq expired-nothing
                                          (lwo-none)))
                                   (and (not (node_eq abstain
                                              expired-nothing))
                                        (and (eq (lwlc-lens?
                                                  (lwlc-stack-default
                                                      stack)) 1)
                                             (eq (lwlc-unknown?
                                                  (lwlc-stack-unknown
                                                      stack)) 1))))))
                    4096 0)
                (if (and (eq (lwac-open?
                                  (lwac-field-status field)) 1)
                         (and (node_eq (lwac-field-primary field)
                                      (lwo-none))
                              (eq (lwo-field-size
                                  (lwae-eligible-for-field
                                      restored field)) 2))) 8192 0)
                (if (and (eq (lwo-field-size
                                  (lwdaeq-current-selections restored)) 0)
                         (eq (lwo-field-size
                                  (lwdaeq-current-executions restored)) 0))
                    16384 0)
                (if (and (eq (lwo-active-by? departed restored-question
                                  (lwdaes-source-j)) 0)
                         (and (eq (lwo-field-size departed-evidence) 4)
                              (and (node_eq
                                      (lwdaes-evidence-for-stance
                                          departed restored-question abstain)
                                      (lwo-none))
                                   (and (eq (lwdaes-field-contained?
                                              historical
                                              departed-evidence) 1)
                                        (eq (lwae-question-steady?
                                              departed
                                              restored-question) 1)))))
                    32768 0))))
    (lwdaes-clean-all)
    score)
