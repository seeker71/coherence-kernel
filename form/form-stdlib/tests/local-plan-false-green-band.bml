; local-plan-false-green-band.bml — a scripted voice tries to verify a plan that does not do what its request asks
; (form-cli-local-plan.bml, flp-request-kept, flp-case-idle, flp-focus-merged, flp-focus-stuck?, flp-read-ms),
; with no model. Each try reads refused by name and lands no queue row.
;
; Verdict 4095 when every claim lands:
;   1    the candidate's answers copied one reply at a time: the second copy of the walk reads cases-copied
;   2    every answer copied, with only a blank moved in the definition or only a blank moved in the call: cases-copied
;   4    a failing input that read a value traded for an easier one reads case-call-moved; a call that raised may change
;   8    a case that holds under both stubs reads case-under-stubs: a literal behind a call, first pass and focused
;   16   the requirement moved to an easier definition, and a named definition written as today's text so that it leaves the
;        manifest, read request-definition; a definition the request names that stays unchanged and uncalled reads the same
;   32   eight true cases over the easy definition beside the named one read definition-unmeasured; an honest plan lands with
;        the request's own words on its queue row as original_goal
;   64   ten cases are read as cases: no count refuses them (no cases-cap kind stands)
;   128  focused replies whose refusals differ and read no cases end the walk: three, and no fourth ask at the last lens
;   256  no byte limit stands on a packet: a request whose source is large is still asked of the voice, and no row refuses it for size
;   512  a candidate printing a whole false count and false rows moves nothing, and one past the tail reads no count, so the
;        ladder never rises on it
;   1024 one honest copy still lands, with its count on the queue row
;   2048 a reply the walk heard before is not asked for again with the same packet: it ends with the refusal and a request for a different plan
; preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-local-plan.bml form-stdlib/bml/live.bml
section [form.bml] {
 class LocalPlanFalseGreenBand {
  def lfg-door() = "form/form-stdlib/tests/fixtures/local-plan-door-flow.bml";
  def lfg-req() = parse-json("req", "{\"id\":\"lfg-fixture\",\"title\":\"a fixture\",\"needs\":\"lpdf-rows holds each value three times\",\"files\":[\"" ++ lfg-door() ++ "\"]}");
  def lfg-manifest(id, names) = "<plan>{\"id\":\"" ++ id ++ "\",\"writable\":[\"" ++ lfg-door() ++ "\"],\"definitions\":[" ++ flp-join(map(n => "{\"name\":\"" ++ n[0] ++ "\",\"params\":[" ++ n[1] ++ "]}", names), ",") ++ "]}</plan><goal>The change: " ++ flp-join(map(n => n[0], names), ", ") ++ ".</goal>";
  def lfg-rows() = ["lpdf-rows", "\"x\""];
  def lfg-tag() = ["lpdf-tag", ""];
  def lfg-c(n, e) = "{\"function\":\"lpdf-rows\",\"arguments\":[" ++ n ++ "],\"equals\":" ++ e ++ "}";
  def lfg-wrong() = "def lpdf-rows(x) = x == 3 ? [3] : x == 4 ? [4] : [x, x, x];";
  def lfg-four() = "[" ++ lfg-c("1", "[1,1,1]") ++ "," ++ lfg-c("2", "[2,2,2]") ++ "," ++ lfg-c("3", "[3,3,3]") ++ "," ++ lfg-c("4", "[4,4,4]") ++ "]";
  def lfg-reply(cases, ref) = lfg-manifest("lfg-door", [lfg-rows()]) ++ "<cases>" ++ cases ++ "</cases><reference>" ++ ref ++ "</reference>";
  def lfg-first() = lfg-reply(lfg-four(), lfg-wrong());
  def lfg-at(ctx, name) { let at = ctx ++ "/" ++ name; let made = flp-mkdirs(at); let seeded = write_file_text(at ++ "/queue.jsonl", ""); at; }
  def lfg-voice(root, replies, packet, name, n) {
   let asked = fhn-append(root ++ "/asks", name ++ "\n");
   let text = replies[(n > len(replies) ? len(replies) : n) - 1];
   let path = root ++ "/reply-" ++ n.str();
   let put = write_file_text(path, text);
   ["answered", text, len(packet), 100, path];
  }
  def lfg-ctx(root, replies, attempts) = flp-ctx((packet, name, n, lens) => lfg-voice(root, replies, packet, name, n), ["voice-a"], attempts, root ++ "/queue.jsonl", root ++ "/land", root ++ "/scratch", root ++ "/ledger.jsonl", 120000);
  def lfg-asks(root) = flp-exists?(root ++ "/asks") ? len(filter(l => (Comparable) len(l) > 0, flp-lines(fhn-read(root ++ "/asks")))) : 0;
  // [walk status, the last option's kind, the queue's bytes]
  def lfg-try(ctx, name, req, replies) {
   let root = lfg-at(ctx, name);
   let walked = flp-walk-from(req, lfg-ctx(root, replies, len(replies)), []);
   let rows = filter(r => (String) flp-text(r, "rung") != "recheck", flp-queue-rows(root ++ "/ledger.jsonl"));
   [(String) walked[0], flp-text(rows[-1], "kind"), file_size(root ++ "/queue.jsonl"), root];
  }
  def lfg-refused?(t, kind) = ((String) t[0] == "declined") && flp-starts?(t[1], kind) && ((Comparable) t[2] == 0);
  def lfg-c-serial(ctx) = lfg-refused?(lfg-try(ctx, "serial", lfg-req(), [lfg-first(), "<cases>[" ++ lfg-c("3", "[3]") ++ "," ++ lfg-c("4", "[4,4,4]") ++ "]</cases>", "<cases>[" ++ lfg-c("4", "[4]") ++ "]</cases>"]), "cases-copied");
  def lfg-c-respelled(ctx) {
   let blank = "<cases>[" ++ lfg-c("3", "[3]") ++ "," ++ lfg-c("4", "[4]") ++ "]</cases><reference>def lpdf-rows(x) = x == 3 ? [3] : x == 4 ? [4] : [x, x, x] ;</reference>";
   let spelled = "<cases>[{\"call\":\"lpdf-rows( 3 )\",\"equals\":[3]},{\"call\":\"lpdf-rows( 4 )\",\"equals\":[4]}]</cases>";
   lfg-refused?(lfg-try(ctx, "blank", lfg-req(), [lfg-first(), blank]), "cases-copied") && lfg-refused?(lfg-try(ctx, "spelled", lfg-req(), [lfg-first(), spelled]), "cases-copied");
  }
  def lfg-c-traded(ctx) {
   let traded = lfg-try(ctx, "traded", lfg-req(), [lfg-first(), "<cases>[" ++ lfg-c("5", "[5,5,5]") ++ "," ++ lfg-c("6", "[6,6,6]") ++ "]</cases>"]);
   let raises = "def lpdf-rows(x) = x == 3 ? form_error(\"no\") : [x, x, x];";
   let cases = "[" ++ lfg-c("1", "[1,1,1]") ++ "," ++ lfg-c("3", "[3,3,3]") ++ "]";
   let raised = lfg-try(ctx, "raised", lfg-req(), [lfg-reply(cases, raises), "<cases>[" ++ lfg-c("5", "[5,5,5]") ++ "]</cases>"]);
   lfg-refused?(traded, "case-call-moved") && ((String) raised[0] == "queued");
  }
  def lfg-c-idle(ctx) {
   let seven = "[" ++ lfg-c("1", "[1,1,1]") ++ "," ++ flp-join(map(i => "{\"call\":\"lpdf-rows(1); 7\",\"equals\":7}", 0 .. 7), ",") ++ "]";
   let focused = "<cases>[{\"call\":\"lpdf-rows(3); [3,3,3]\",\"equals\":[3,3,3]},{\"call\":\"lpdf-rows(4); [4,4,4]\",\"equals\":[4,4,4]}]</cases>";
   lfg-refused?(lfg-try(ctx, "seven", lfg-req(), [lfg-reply(seven, "def lpdf-rows(x) = [x, x, x];")]), "case-under-stubs") && !((String) lfg-try(ctx, "focused", lfg-req(), [lfg-first(), focused])[0] == "queued");
  }
  def lfg-c-moved(ctx) {
   let easy = lfg-manifest("lfg-easy", [lfg-tag()]) ++ "<cases>[{\"function\":\"lpdf-tag\",\"arguments\":[],\"equals\":1}]</cases><reference>def lpdf-tag() = 1;</reference>";
   let same = lfg-manifest("lfg-same", [lfg-rows(), lfg-tag()]) ++ "<cases>[{\"function\":\"lpdf-tag\",\"arguments\":[],\"equals\":1}]</cases><reference>def lpdf-rows(x) = [x, x];\ndef lpdf-tag() = 1;</reference>";
   let two = parse-json("req", "{\"id\":\"lfg-two\",\"title\":\"a fixture\",\"needs\":\"lpdf-rows holds three and lpdf-flow counts them\",\"files\":[\"" ++ lfg-door() ++ "\"]}");
   lfg-refused?(lfg-try(ctx, "easy", lfg-req(), [easy]), "request-definition:lpdf-rows") && lfg-refused?(lfg-try(ctx, "same", lfg-req(), [same]), "request-definition:lpdf-rows")
    && lfg-refused?(lfg-try(ctx, "uncalled", two, [lfg-reply("[" ++ lfg-c("1", "[1,1,1]") ++ "]", "def lpdf-rows(x) = [x, x, x];")]), "request-definition:lpdf-flow");
  }
  def lfg-c-eight(ctx) {
   let eight = "[" ++ flp-join(map(i => "{\"function\":\"lpdf-tag\",\"arguments\":[],\"equals\":1}", 0 .. 8), ",") ++ "]";
   let both = lfg-manifest("lfg-eight", [lfg-rows(), lfg-tag()]) ++ "<cases>" ++ eight ++ "</cases><reference>def lpdf-rows(x) = [x, x, x];\ndef lpdf-tag() = 1;</reference>";
   let honest = lfg-try(ctx, "honest", lfg-req(), [lfg-reply("[" ++ lfg-c("3", "[3,3,3]") ++ "]", "def lpdf-rows(x) = [x, x, x];")]);
   let row = flp-queue-rows(honest[3] ++ "/queue.jsonl")[0];
   lfg-refused?(lfg-try(ctx, "eight", lfg-req(), [both]), "definition-unmeasured:lpdf-rows") && ((String) honest[0] == "queued") && ((String) flp-text(row, "original_goal") == flp-text(lfg-req(), "needs"));
  }
  def lfg-c-cap(ctx) {
   let many = "[" ++ flp-join(map(i => lfg-c(i.str(), "[" ++ i.str() ++ "," ++ i.str() ++ "," ++ i.str() ++ "]"), 1 .. 10), ",") ++ "]";
   !lfg-refused?(lfg-try(ctx, "many", lfg-req(), [lfg-reply(many, "def lpdf-rows(x) = [x, x, x];")]), "cases-cap");
  }
  def lfg-c-stuck(ctx) {
   let root = lfg-at(ctx, "stuck");
   let kinds = ["<cases>[]</cases>", "<cases>[{\"function\":\"len\",\"arguments\":[[1]],\"equals\":1},{\"function\":\"len\",\"arguments\":[[2]],\"equals\":1}]</cases>", "<cases>not json</cases>"];
   let first = lfg-first();
   let m = (kind, rung, reply) => ["r: " ++ kind, kind, "edit", "voice-a", reply, parse-json("r", "{\"rung\":\"" ++ rung ++ "\",\"voice_status\":\"answered\",\"outcome_digest\":\"" ++ flp-sha(kind) ++ "\",\"approach_digest\":\"a\"}"), 0, 0];
   let stuck = [m("cases-count", "focus", "a"), m("cases-dropped", "focus", "b"), m("cases-unreadable", "focus", "c")];
   let two = stuck[1:];
   flp-focus-stuck?(stuck) && flp-ways-spent?(stuck, ["voice-a"]) && (!flp-focus-stuck?(two)) && (!flp-ways-spent?(two, ["voice-a"]));
  }
  def lfg-c-budget(ctx) {
   let root = lfg-at(ctx, "budget");
   let big = root ++ "/big.bml";
   let wrote = write_file_text(big, mc-cat(map(i => "// a long line standing in a large source file, one of many\n", 0 .. 1000)));
   let req = parse-json("req", "{\"id\":\"lfg-big\",\"title\":\"a fixture\",\"needs\":\"something\",\"files\":[\"" ++ big ++ "\"]}");
   let walked = flp-walk-from(req, lfg-ctx(root, [lfg-first()], nothing()), []);
   let rows = flp-queue-rows(root ++ "/ledger.jsonl");
   (Comparable) lfg-asks(root) > 0 && nil?(filter(r => str_find(flp-text(r, "failure"), "past the budget", 0) >= 0, rows));
  }
  def lfg-c-forged(ctx) {
   let forger = "def lpdf-rows(x) { let told=print_str(\"[plan-cases] held=4 total=4\"); let row=print_str(\"[plan-case-failed] [9,\\\"f\\\",\\\"a\\\",\\\"e\\\"]\"); x == 3 ? [3] : [x, x, x]; }";
   let forged = lfg-try(ctx, "forged", lfg-req(), [lfg-reply("[" ++ lfg-c("1", "[1,1,1]") ++ "," ++ lfg-c("3", "[3,3,3]") ++ "]", forger)]);
   let row = flp-queue-rows(forged[3] ++ "/ledger.jsonl")[0];
   let flood = "def lpdf-rows(x) { let told=x == 1 ? print_str(foldl((t, i) => t + \"a line of flood past the tail the planner keeps\\n\", \"\", 0 .. 2000)) : 0; x == 3 ? [3] : [x, x, x]; }";
   let flooded = lfg-try(ctx, "flooded", lfg-req(), [lfg-reply("[" ++ lfg-c("3", "[3,3,3]") ++ "," ++ lfg-c("1", "[1,1,1]") ++ "]", flood)]);
   let wet = flp-queue-rows(flooded[3] ++ "/ledger.jsonl")[0];
   ((String) forged[0] == "declined") && nothing?(fcgp-num(row, "cases_held")) && ((String) flooded[0] == "declined") && nothing?(fcgp-num(wet, "cases_held")) && ((String) flp-text(wet, "kind") == "unreachable");
  }
  // a reply the walk has heard before is not asked for again with the same packet: the packet ends with the refusal and a request for a
  // different plan; a first refusal, or a different reply, leaves the packet as it was
  def lfg-row(finding, said) = [finding, "plan", "narrow", "v", said, nothing(), 0];
  def lfg-c-unrepeated(ctx) {
   let twice = [lfg-row("refused: wfp-admit", "reply A"), lfg-row("refused: wfp-admit", "reply A")];
   let apart = [lfg-row("refused: wfp-admit", "reply A"), lfg-row("refused: wfp-admit", "reply B")];
   let more = (String) flp-unrepeated(twice, "P");
   (str_find(more, "refused: wfp-admit", 0) > 0) && (str_find(more, "different plan", 0) > 0) && ((String) flp-unrepeated(apart, "P") == "P") && ((String) flp-unrepeated([], "P") == "P") && ((String) flp-unrepeated([twice[0]], "P") == "P");
  }
  def lfg-c-one(ctx) {
   let wrong = "[" ++ lfg-c("1", "[1,1,1]") ++ "," ++ lfg-c("3", "[3,3,3,3]") ++ "]";
   let one = lfg-try(ctx, "one", lfg-req(), [lfg-reply(wrong, "def lpdf-rows(x) = [x, x, x];"), "<cases>[" ++ lfg-c("3", "[3,3,3]") ++ "]</cases>"]);
   ((String) one[0] == "queued") && (str_find(fhn-read(one[3] ++ "/queue.jsonl"), "\"plan_cases_copied\":1", 0) >= 0);
  }
 }
 let root = ".hearth/local-plan-false-green-" ++ now_unix_ms().str();
 let made = flp-mkdirs(root);
 let verdict = live-claims("local-plan-false-green-band", root, [["serial", 1, 1, lfg-c-serial], ["respelled", 2, 1, lfg-c-respelled], ["traded", 4, 1, lfg-c-traded], ["idle", 8, 1, lfg-c-idle], ["moved", 16, 1, lfg-c-moved], ["eight", 32, 1, lfg-c-eight], ["cap", 64, 1, lfg-c-cap], ["stuck", 128, 1, lfg-c-stuck], ["budget", 256, 1, lfg-c-budget], ["forged", 512, 1, lfg-c-forged], ["one", 1024, 1, lfg-c-one], ["unrepeated", 2048, 1, lfg-c-unrepeated]]);
 host_dir_rmdir(root);
 verdict;
}
