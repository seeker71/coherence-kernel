; preludes: form-stdlib/core.fk form-stdlib/transformer-numerics.fk form-stdlib/trig.fk form-stdlib/llama-numerics.fk form-stdlib/rope.fk form-stdlib/transformer-block.fk form-stdlib/transformer-mh.fk form-stdlib/gqa-attn.fk form-stdlib/llama-block.fk form-stdlib/llama-gqa-block.fk form-stdlib/kv-cache.fk form-stdlib/kv-llama-block.fk form-stdlib/kv-gqa-llama-block.fk form-stdlib/multi-layer-stack.fk form-stdlib/gqa-multi-layer-stack.fk form-stdlib/greedy-decode.fk form-stdlib/llama-generate.fk form-stdlib/e2e-driver.fk
;
; e2e-driver-band — the end-to-end chat driver's COMPOSITION SPINE at proof scale: template ->
; tokenize -> forward+sample -> detokenize -> transcript, over a tiny fixture vocab and the SAME
; grounded weight fixture llama-generate-band pins against the independent libm reference
; (scripts/llama_generate_reference.py: generate([0,1],3) == [0 1 1 1 1]). The fixture vocab binds
; byte 65..68 ('A'..'D') to ids 0..3, and the template fixture (pre=[65] ps=[66] suf=[]) tokenizes
; to EXACTLY the reference seed [0 1], so the full driver composition reuses the published pin —
; the transcript's generated ids are python-grounded end to end, through every stage boundary.
;
; The band's second heart is the REFUSAL LAW: a vocab that cannot map a byte makes ed-run stop at
; tokenize with (0 tpl () ()) — real template bytes, honestly EMPTY ids and text, never a guessed
; id and never canned text. That is the shape the real-prompt witness lane shows today (the llama3
; rank-table carrier is pending), so the refusal is proven at the same floor as the happy path.
;
; Verdict 255 when the driver spine lands four-way:
;   1    tpl == [65 66]                  (template: byte-list composition exact)
;   2    tokenize == (1 [0 1])           (fixture binding live: status 1, the reference seed)
;   4    driver gen == [0 1 1 1 1]       (GROUNDED: full composition reproduces the python pin)
;   8    driver gen == manual pipeline   (composition order: ed-run == cached loop over ed-tokenize(ed-template))
;   16   txt == [66 66 66]               (detokenize: the three generated ids map back to 'B' bytes)
;   32   every generated id in [0,V)     (legal vocab indices)
;   64   driver cached == recompute      (the cache law survives the driver binding, token-for-token)
;   128  refusal == (0 [65 66 71] () ()) (unmappable byte 71: stop at tokenize, nothing fabricated)
(do
    (defn edb-ieq (a b)
      (if (eq (len a) 0) (if (eq (len b) 0) 1 0)
          (if (eq (len b) 0) 0
              (if (eq (head a) (head b)) (edb-ieq (tail a) (tail b)) 0))))
    (defn edb-ids-ok (xs v)
      (if (eq (len xs) 0) 1
          (if (lt (head xs) 0) 0
              (if (lt (head xs) v) (edb-ids-ok (tail xs) v) 0))))

    ; --- the llama-generate-band grounded weight fixture (d=4, 2 layers, V=4, tied unembed) ---
    (let g1 (list 0.9 1.1 1.0 0.95))   (let g2 (list 1.05 0.95 1.0 0.9))
    (let wq (list (list 0.5 -0.25 0.1 0.3) (list 0.2 0.4 -0.3 0.1) (list -0.1 0.2 0.5 -0.2) (list 0.3 0.0 -0.15 0.25)))
    (let wk (list (list 0.2 0.4 -0.3 0.1) (list 0.3 -0.2 0.25 0.5) (list 0.1 0.15 -0.05 0.2) (list -0.25 0.3 0.4 -0.1)))
    (let wv (list (list 0.3 -0.2 0.25 0.5) (list 0.6 0.1 -0.2 0.4) (list 0.05 -0.1 0.3 0.2) (list 0.15 0.35 -0.25 0.1)))
    (let wo (list (list 0.6 0.1 -0.2 0.4) (list -0.2 0.4 0.3 0.1) (list 0.25 -0.15 0.5 0.05) (list 0.1 0.2 -0.3 0.45)))
    (let wg (list (list 0.5 -0.3 0.2 0.1) (list 0.2 0.7 -0.4 0.3) (list -0.1 0.25 0.4 -0.2) (list 0.3 0.1 -0.15 0.5)))
    (let wu (list (list 0.25 -0.15 0.3 0.05) (list 0.1 0.4 -0.2 0.15) (list 0.35 0.2 -0.1 0.25) (list -0.2 0.3 0.15 0.4)))
    (let wd (list (list 0.4 -0.2 0.3 0.1) (list 0.15 0.5 -0.25 0.2) (list -0.3 0.1 0.45 -0.15) (list 0.2 -0.1 0.35 0.3)))
    (let g1b (list 1.0 0.9 1.05 1.1))  (let g2b (list 0.95 1.1 0.9 1.0))
    (let wqb (list (list 0.1 0.3 -0.2 0.4) (list -0.3 0.2 0.5 -0.1) (list 0.4 -0.1 0.2 0.3) (list 0.0 0.25 -0.35 0.15)))
    (let wkb (list (list 0.3 -0.2 0.4 0.1) (list 0.15 0.5 -0.1 0.2) (list -0.05 0.3 0.25 -0.15) (list 0.4 -0.25 0.1 0.35)))
    (let wvb (list (list 0.2 0.4 -0.15 0.3) (list 0.5 -0.1 0.2 0.45) (list -0.2 0.35 0.1 -0.05) (list 0.25 0.15 -0.3 0.2)))
    (let wob (list (list 0.4 -0.3 0.2 0.5) (list 0.1 0.45 -0.15 0.2) (list -0.25 0.3 0.4 0.05) (list 0.35 -0.1 0.25 -0.2)))
    (let wgb (list (list 0.3 0.2 -0.4 0.1) (list 0.5 -0.3 0.15 0.25) (list -0.1 0.4 0.3 -0.2) (list 0.2 0.05 -0.25 0.45)))
    (let wub (list (list 0.15 0.35 -0.2 0.1) (list 0.4 -0.15 0.25 0.3) (list -0.25 0.2 0.35 -0.1) (list 0.3 0.1 -0.05 0.4)))
    (let wdb (list (list 0.35 -0.15 0.25 0.2) (list 0.2 0.4 -0.3 0.1) (list -0.2 0.15 0.5 -0.25) (list 0.1 -0.05 0.3 0.45)))
    (let eps 0.00001)
    (let layers2 (list (list g1 wq wk wv wo g2 wg wu wd) (list g1b wqb wkb wvb wob g2b wgb wub wdb)))
    (let tok (list (list 1.0 -0.5 0.5 2.0) (list -1.0 0.25 1.5 -0.75)
                   (list 0.5 1.0 -0.5 0.25) (list 0.25 -1.0 0.75 -0.5)))
    (let gf (list 1.1 0.9 1.0 1.05))
    (let cfg10 (rope-cfg 10000.0 32.0 1.0 4.0 8192.0))
    (let sc4 (div 1.0 (tn-sqrt 4.0)))
    (let v 4)  (let steps 3)

    ; --- fixture bindings: vocab 'A'..'D' -> ids 0..3; template pre=[65] ps=[66] suf=[] ---
    (let vocab (list 65 66 67 68))
    (let pre (list 65))  (let ps (list 66))  (let suf (empty))

    ; --- the driver, end to end ---
    (let tr  (ed-run pre ps suf vocab tok layers2 gf eps sc4 1 1 4 cfg10 steps))
    (let st  (nth tr 0))
    (let tpl (nth tr 1))
    (let gen (nth tr 2))
    (let txt (nth tr 3))

    (let c0 (if (eq (edb-ieq tpl (list 65 66)) 1) 1 0))
    (let tk (ed-tokenize vocab tpl))
    (let c1 (if (eq (head tk) 1) (if (eq (edb-ieq (tail tk) (list 0 1)) 1) 2 0) 0))
    (let c2 (if (eq st 1) (if (eq (edb-ieq gen (list 0 1 1 1 1)) 1) 4 0) 0))

    ; --- composition order: the driver == the manual pipeline over the same stages ---
    (let manual (lg-generate-cached (tail tk) tok layers2 gf tok eps sc4 1 1 4 cfg10 steps))
    (let c3 (if (eq (edb-ieq gen manual) 1) 8 0))

    (let c4 (if (eq (edb-ieq txt (list 66 66 66)) 1) 16 0))
    (let c5 (if (eq (edb-ids-ok gen v) 1) 32 0))

    ; --- the cache law through the driver binding ---
    (let grc (ed-generate-recompute (tail tk) tok layers2 gf eps sc4 1 1 4 cfg10 steps))
    (let c6 (if (eq (edb-ieq gen grc) 1) 64 0))

    ; --- the refusal law: byte 71 ('G') has no vocab binding — stop at tokenize, fabricate nothing ---
    (let tr2 (ed-run pre ps (list 71) vocab tok layers2 gf eps sc4 1 1 4 cfg10 steps))
    (let c7 (if (eq (nth tr2 0) 0)
                (if (eq (edb-ieq (nth tr2 1) (list 65 66 71)) 1)
                    (if (eq (len (nth tr2 2)) 0) (if (eq (len (nth tr2 3)) 0) 128 0) 0) 0) 0))

    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
