; local-plan-parks-band.bml — a planner window stops re-asking what it already heard (form-cli-local-plan.bml,
; flp-ways-spent?, flp-parked?, flp-flow-held), with a scripted voice and no model.
;
; Verdict 127 when every claim lands:
;   1   at the last lens and the last voice, a reply the voice already gave with this outcome spends the ways: on today's
;       digest the walk declines at once, with no ask
;   2   the digest moves: the request does not read parked, one ask reads the outcome again, the same reply declines, and
;       the new row parks it on the new digest
;   4   a swerve still left is taken: a repeated reply with a lens left moves the lens and never reads spent
;   8   a voice that could not open says nothing of the plan: such rows never park a request
;   16  flp-flow-held keeps every class and holds what stands after the last; text with no flow, no class or two sections
;       stands as written; a brace in a string or a comment moves nothing
;   32  a door with its flow at import: under both stubs the band reads a number on its cases, the door's flow never ran,
;       the same flow runs on today's text, and the whole verification holds with a reference
;   64  three answers with one outcome at the ladder's end spend the ways even as the replies differ, and two do not
; preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-local-plan.bml form-stdlib/bml/live.bml
section [form.bml] {
 class LocalPlanParksBand {
  def lppb-door() = "form/form-stdlib/tests/fixtures/local-plan-door-flow.bml";
  def lppb-mark() = ".hearth/local-plan-door-flow.mark";
  def lppb-req() = parse-json("req", "{\"id\":\"lppb-fixture\",\"title\":\"a fixture\",\"files\":[\"" ++ lppb-door() ++ "\"]}");
  def lppb-row(kind, voice, lens, status, digest) = json-node-object([fhn-s("request", "lppb-fixture"), fhn-s("rung", "resume"), fhn-s("outcome_digest", flp-sha(kind)), fhn-s("approach_digest", flp-sha(voice ++ "|" ++ lens ++ "|resume")), fhn-s("source_digest", digest), fhn-s("voice_status", status), fhn-s("verdict", "refused"), fhn-s("kind", kind), fhn-s("voice", voice), fhn-s("lens", lens), fhn-s("failure", "refused " ++ kind)]);
  def lppb-m(kind, voice, lens, status, reply, digest) = ["Verification refused: " ++ kind, kind, lens, voice, reply, lppb-row(kind, voice, lens, status, digest), 0, 0];
  def lppb-said(root, reply, packet, name, n, lens) {
   let asked = fhn-append(root ++ "/asks", name ++ "\n");
   ["answered", reply, len(packet), 100];
  }
  def lppb-ctx(root, reply, voices) = flp-ctx((packet, name, n, lens) => lppb-said(root, reply, packet, name, n, lens), voices, nothing(), root ++ "/queue.jsonl", root ++ "/land", root ++ "/scratch", root ++ "/ledger.jsonl", 120000);
  def lppb-asks(root) = flp-exists?(root ++ "/asks") ? len(filter(l => (Comparable) len(l) > 0, flp-lines(fhn-read(root ++ "/asks")))) : 0;
  def lppb-at(ctx, name) { let at = ctx ++ "/" ++ name; let made = flp-mkdirs(at); let seeded = write_file_text(at ++ "/queue.jsonl", ""); at; }
  def lppb-spent-memory(digest) = [lppb-m("plan-unreadable", "voice-a", "edit", "answered", "not a plan", digest), lppb-m("plan-unreadable", "voice-a", "edit", "answered", "not a plan", digest)];
  def lppb-c-parked(ctx) {
   let root = lppb-at(ctx, "parked");
   let memory = lppb-spent-memory(flp-source-digest(lppb-req()));
   let walked = flp-walk-from(lppb-req(), lppb-ctx(root, "not a plan", ["voice-a"]), memory);
   flp-parked?(lppb-req(), memory, ["voice-a"]) && ((String) walked[0] == "declined") && ((Comparable) lppb-asks(root) == 0);
  }
  def lppb-c-moved(ctx) {
   let root = lppb-at(ctx, "moved");
   let memory = lppb-spent-memory("an older digest");
   let walked = flp-walk-from(lppb-req(), lppb-ctx(root, "not a plan", ["voice-a"]), memory);
   (!flp-parked?(lppb-req(), memory, ["voice-a"])) && ((String) walked[0] == "declined") && ((Comparable) lppb-asks(root) == 1) && ((Comparable) len(walked[2]) == 3) && flp-parked?(lppb-req(), walked[2], ["voice-a"]);
  }
  def lppb-c-swerve(ctx) {
   let d = flp-source-digest(lppb-req());
   let memory = [lppb-m("k-one", "voice-a", "band-first", "answered", "r1", d), lppb-m("k-two", "voice-a", "band-first", "answered", "r2", d), lppb-m("k-one", "voice-a", "band-first", "answered", "r1", d)];
   ((String) flp-way(memory, ["voice-a"])[2] == "lens") && (!flp-ways-spent?(memory, ["voice-a"])) && (!flp-parked?(lppb-req(), memory, ["voice-a"]));
  }
  def lppb-c-unopened(ctx) {
   let d = flp-source-digest(lppb-req());
   let memory = map(i => lppb-m("voice-unavailable", "voice-a", "edit", "unavailable", "the voice could not open", d), 0 .. 4);
   (!flp-ways-spent?(memory, ["voice-a"])) && (!flp-parked?(lppb-req(), memory, ["voice-a"]));
  }
  def lppb-c-held(ctx) {
   let t1 = "section [form.bml] {\n class A {\n  def a(x) = \"}\"; // }\n }\n go(a(1));\n}\n";
   let h1 = "section [form.bml] {\n class A {\n  def a(x) = \"}\"; // }\n }\n 0;\n}\n";
   let t2 = "section [form.bml] {\n class A {\n  def a(x) = 1;\n }\n 0;\n}\n";
   let t3 = "section [form.bml] {\n go();\n}\n";
   let t4 = "section [a] {\n class A {\n }\n go();\n}\nsection [b] {\n class B {\n }\n go();\n}\n";
   let t5 = "(do\n (go)\n 0)\n";
   let t6 = "; a head with a { brace\nsection [f] {\n class A {\n }\n let x = 1;\n class B {\n  def b() {\n   1;\n  }\n }\n go();\n}\n";
   let h6 = "; a head with a { brace\nsection [f] {\n class A {\n }\n let x = 1;\n class B {\n  def b() {\n   1;\n  }\n }\n 0;\n}\n";
   ((String) flp-flow-held(t1) == h1) && ((String) flp-flow-held(t2) == t2) && ((String) flp-flow-held(t3) == t3) && ((String) flp-flow-held(t4) == t4) && ((String) flp-flow-held(t5) == t5) && ((String) flp-flow-held(t6) == h6);
  }
  def lppb-c-door(ctx) {
   let root = lppb-at(ctx, "door");
   let tree = root ++ "/tree";
   let parsed = flp-parse("<plan>{\"id\":\"lppb-door\",\"writable\":[\"" ++ lppb-door() ++ "\"],\"definitions\":[{\"name\":\"lpdf-rows\",\"params\":[\"x\"]}]}</plan><goal>Each row holds its value three times: lpdf-rows.</goal><cases>[{\"function\":\"lpdf-rows\",\"arguments\":[1],\"equals\":[1,1,1]}]</cases><reference>def lpdf-rows(x) = [x, x, x];</reference>");
   let cleared = host_path_remove(lppb-mark());
   let c = lppb-ctx(root, "", ["voice-a"]);
   let stubs = flp-stubs(parsed[2], c, tree, 0);
   let unrun = !flp-exists?(lppb-mark());
   let today = flp-open(parsed[2], c, tree);
   let ran = flp-exists?(lppb-mark());
   let swept = host_path_remove(lppb-mark());
   let verified = flp-verify-run(parsed[2], lppb-req(), c, root ++ "/verify");
   let gone = host_path_remove(lppb-mark());
   ((String) parsed[0] == "") && flp-held?(stubs) && ((Value) stubs[4] == [0, 0]) && unrun && ran && ((Comparable) today[3] == 0) && flp-held?(verified) && ((Comparable) verified[5] == 1);
  }
  def lppb-c-three(ctx) {
   let d = flp-source-digest(lppb-req());
   let two = [lppb-m("k", "voice-a", "edit", "answered", "r1", d), lppb-m("k", "voice-a", "edit", "answered", "r2", d)];
   let three = append(two, [lppb-m("k", "voice-a", "edit", "answered", "r3", d)]);
   (!flp-ways-spent?(two, ["voice-a"])) && flp-ways-spent?(three, ["voice-a"]) && flp-parked?(lppb-req(), three, ["voice-a"]);
  }
 }
 let root = ".hearth/local-plan-parks-" ++ now_unix_ms().str();
 let made = flp-mkdirs(root);
 let verdict = live-claims("local-plan-parks-band", root, [["parked", 1, 1, lppb-c-parked], ["moved", 2, 1, lppb-c-moved], ["swerve", 4, 1, lppb-c-swerve], ["unopened", 8, 1, lppb-c-unopened], ["held", 16, 1, lppb-c-held], ["door", 32, 1, lppb-c-door], ["three", 64, 1, lppb-c-three]]);
 host_dir_rmdir(root);
 verdict;
}
