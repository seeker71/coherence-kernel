; form-glass-staged-startup-band.fk — staging, cache and RAM snapshot policy.
; Verdict 65535.
; preludes: form-stdlib/form-glass-staged-startup.bml

(do
    (defn fglsb-bit (held weight) (if (eq held 1) weight 0))
    (defn fglsb-snapshot (diskState)
        (fgls-snapshot 200000 71 1 0 33000 100 1700000 190 10000 diskState))
    (let candidate (fglsb-snapshot "mtime-age-candidate"))
    (let missing (fglsb-snapshot "image-missing"))
    (let ram0 (fgls-ram-snapshot candidate 0))
    (let read1 (fgls-ram-snapshot-read ram0))
    (let read2 (fgls-ram-snapshot-read (nth read1 1)))
    (let fullCandidate (fgls-route "memory" candidate))
    (let fullMissing (fgls-route "flow" missing))
    (let authority (read_file "form/form-stdlib/bml/form-glass-staged-startup.bml"))
    (sum (list
        (fglsb-bit (and (eq (fgls-snapshot? candidate) 1)
                         (and (eq (FGLSAttentionMs) 5000)
                              (and (str_eq (fgls-attention-state 5000) "within-attention")
                                   (str_eq (fgls-attention-state 5001) "close-attention")))) 1)
        (fglsb-bit (and (str_eq (fgls-route-status (fgls-route "startup" candidate)) "ready")
                        (str_eq (fgls-route-status (fgls-route "atlas" candidate)) "offered")) 2)
        (fglsb-bit (str_eq (fgls-route-reason fullCandidate) "loader-validation-required") 4)
        (fglsb-bit (str_eq (fgls-route-reason fullMissing) "compile-on-demand") 8)
        (fglsb-bit (str_eq (fgls-route-door fullCandidate) "runtime.full-program-image.call") 16)
        (fglsb-bit (eq (fgls-ram-snapshot-reads (nth read2 1)) 2) 32)
        (fglsb-bit (eq (fgls-snapshot-epoch (head read2)) 200000) 64)
        (fglsb-bit (str_eq (fgls-disk-candidate-state "/missing/source" "/missing/image" 200000 1000) "source-missing") 128)
        (fglsb-bit (str_eq (fgls-route-status (fgls-route "unknown" candidate)) "refused") 256)
        (fglsb-bit (ge (str_find (fgls-render candidate) "full-program-image-call=unavailable" 0) 0) 512)
        (fglsb-bit (ge (str_find authority "mtime and age candidate until the fkwu loader validates its source identity" 0) 0) 1024)
        (fglsb-bit (and (ge (str_find authority "current runtime exposes no generic in-process full program-image call" 0) 0)
                         (ge (str_find authority "identify its exact stage, process load, cache candidate, JIT key, map, and missing door" 0) 0)) 2048)
        (fglsb-bit (and (str_eq (fgls-disk-state 0 20 10 100) "source-missing")
                       (and (str_eq (fgls-disk-state 10 0 10 100) "image-missing")
                       (and (str_eq (fgls-disk-state 20 10 10 100) "stale-mtime")
                       (and (str_eq (fgls-disk-state 10 20 -1 100) "age-unavailable")
                       (and (str_eq (fgls-disk-state 10 20 101 100) "expired")
                            (str_eq (fgls-disk-state 10 20 100 100) "mtime-age-candidate")))))) 4096)
        (fglsb-bit (and (str_eq (FGLSFullSource) "observe/form-glass-live-run.fk")
                       (str_eq (FGLSFullImage) "observe/form-glass-live-run.fkb")) 8192)
        (fglsb-bit (ge (str_find authority "lowfk lowering memo is separately keyed by raw BML bytes and recursive floor digest" 0) 0) 16384)
        (fglsb-bit (ge (str_find (fgls-render candidate) "candidate-only=yes" 0) 0) 32768))))
