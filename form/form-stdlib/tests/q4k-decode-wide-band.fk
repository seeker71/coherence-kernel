; q4k-decode-wide-band.fk — the Qwen3.8 lane's K-quant decode matvecs (form_qwen_q4k_decode_f32 and
; form_qwen_q6k_decode_f32, the fused cooperative dots of form-stdlib/bml/qwen38-decode-quant.bml) answer to
; the exact dot within the door's named bound, on one committed superblock fixture and on real rows of the
; Q4_K_M file, and the lane dispatches them through the door's own record.
;   bit 1   float(as_type<half>(bits)) is bit-identical to the body's q4k_f16(bits) on every finite f16
;           (all 65536 patterns, the 2048 inf/nan ones excluded): the kernels' d/dmin decode IS the attestant's
;   bit 2   the Q4_K fixture (q4k-two-superblocks.bin, one row of 512, repeated to 3 rows): the fused kernel
;           and the one-thread attestant (form_q4k_matvec_f32) both sit within their bound of the Form fp64 dot
;   bit 4   real weights, the first Q4_K ffn_gate of the file: four rows (the first and last pair) within
;           the bound of the fp64 dot; 20 dispatches of the fused kernel and of the serial hoist (the previous
;           kernel, compiled beside) timed, the best of five rounds each (the GPU is shared with siblings)
;   bit 8   the first Q4_K ffn_down (the wide rows), the same
;   bit 16  the first Q4_K attn_q / attn_qkv, the same
;   bit 32  q38-mv-rec hands a type-12 view to pipeline 57 with (rows + 1) / 2 groups — the door's record
;   bit 64  q38-mv-rec hands a type-14 view to pipeline 58 with (rows + 1) / 2 groups — the same record shape
;   bit 128 the Q6_K fixture (q6k-two-superblocks.bin): the fused Q6_K kernel and its one-thread attestant
;           (form_q6k_matvec_f32) within their bound of the fp64 dot
;   bit 256 real weights, the first Q6_K ffn_down: four rows within the bound; fused and hoist timed
;   bit 512 the first Q6_K attn_qkv, the same
;   bit 1024 the head (output.weight, Q6_K, the widest dispatch of a token), four rows; 4 dispatches timed
; Verdict 2047 when every claim lands; a short verdict is a form_error (exit 1).
; The bound (qwen38-decode-quant.bml): |y - exact| <= q38dq-bound-coeff(cols) * 2^-24 * S, S the unfused
; magnitude sum(|d sc nib x| + |dmin mn x|) for Q4_K and sum|w x| for Q6_K; the serial attestants' coefficient
; is cols (their fold depth).
; REQUIRES: a live Metal device and the Q4_K_M file of the registry row qwen38-q4 (a physical run; it needs
; the GPU). Opened through q38-open, the lane's own door, mmap-shared with any sibling lease.
; preludes: native/metal/qwen35-dense-token-handle.fk form-stdlib/model-registry.bml form-stdlib/lora-adapter.bml
(do
    (defn qdw-abs (v) (if (lt v 0.0) (sub 0.0 v) v))
    (defn qdw-u () 0.000000059604644775390625)
    ; x_i exact in f32: multiples of 2^-10 in [-1, 1]
    (defn qdw-xv (i) (div (mul 1.0 (sub (mod (mul i 37) 2049) 1024)) 1024.0))
    (defn qdw-xs-chunk (lo hi acc) (if (ge lo hi) acc (qdw-xs-chunk (add lo 1) hi (str_concat acc (md-le32 (md-f32-bits (qdw-xv lo)))))))
    (defn qdw-xs (n lo acc) (if (ge lo n) acc (qdw-xs n (add lo 256) (str_concat acc (qdw-xs-chunk lo (if (gt (add lo 256) n) n (add lo 256)) "")))))
    (defn qdw-f (s i) (ln-f32-decode (ln-u32-le s (mul 4 i))))
    ; the two parts of the Q4_K weight at flat index idx of row bytes `src` (block stride 144, base 0):
    ; the scale part (d * sc) * nib and the min part dmin * mn — q4m-flat-at's own decomposition
    (defn qdw-b (idx) (mul 144 (div idx 256)))
    (defn qdw-i (idx) (mod idx 256))
    (defn qdw-j (i) (add (mul 2 (div i 64)) (div (mod i 64) 32)))
    (defn qdw-nib (src idx)
        (do (let i (qdw-i idx)) (let c (div i 64)) (let within (mod i 64)) (let hf (div within 32)) (let l (mod within 32))
            (let qb (q4m-qsb src (qdw-b idx) (add (mul c 32) l)))
            (if (eq hf 0) (q4k-mod qb 16) (div qb 16))))
    (defn qdw-sp4 (src idx) (mul (mul (q4m-d src (qdw-b idx)) (q4m-scale src (qdw-b idx) (qdw-j (qdw-i idx)))) (qdw-nib src idx)))
    (defn qdw-mp4 (src idx) (mul (q4m-dmin src (qdw-b idx)) (q4m-min src (qdw-b idx) (qdw-j (qdw-i idx)))))
    ; the parts by type: Q6_K has no min term (q6m-flat-at, stride 210)
    (defn qdw-sp (type src idx) (if (eq type 12) (qdw-sp4 src idx) (q6m-flat-at src 0 idx)))
    (defn qdw-mp (type src idx) (if (eq type 12) (qdw-mp4 src idx) 0.0))
    ; the exact (fp64) dot of one row with x, and S, folded 256 weights a chunk
    (defn qdw-dot-chunk (type src lo hi acc) (if (ge lo hi) acc (qdw-dot-chunk type src (add lo 1) hi (add acc (mul (sub (qdw-sp type src lo) (qdw-mp type src lo)) (qdw-xv lo))))))
    (defn qdw-dot (type src cols lo acc) (if (ge lo cols) acc (qdw-dot type src cols (add lo 256) (add acc (qdw-dot-chunk type src lo (add lo 256) 0.0)))))
    (defn qdw-mag-chunk (type src lo hi acc) (if (ge lo hi) acc (qdw-mag-chunk type src (add lo 1) hi (add acc (add (qdw-abs (mul (qdw-sp type src lo) (qdw-xv lo))) (qdw-abs (mul (qdw-mp type src lo) (qdw-xv lo))))))))
    (defn qdw-mag (type src cols lo acc) (if (ge lo cols) acc (qdw-mag type src cols (add lo 256) (add acc (qdw-mag-chunk type src lo (add lo 256) 0.0)))))
    (defn qdw-within? (got exact S coeff) (le (qdw-abs (sub got exact)) (add (mul (mul coeff (qdw-u)) S) 0.000000000001)))
    (defn qdw-ratio (got exact S coeff) (div (qdw-abs (sub got exact)) (add (mul (mul coeff (qdw-u)) S) 0.000000000001)))
    (defn qdw-n (pipe bind threads n) (if (le n 0) 0 (do (let e (metal_enqueue pipe bind threads)) (qdw-n pipe bind threads (sub n 1)))))
    ; count the nonzero words of a u32 buffer read-back, 1024 a chunk (the words are 0 or 1: the low byte says)
    (defn qdw-cnt1 (s i end acc) (if (ge i end) acc (qdw-cnt1 s (add i 1) end (add acc (str_byte_at s (mul 4 i))))))
    (defn qdw-cnt (s i n acc) (if (ge i n) acc (qdw-cnt s (add i 1024) n (qdw-cnt1 s i (if (gt (add i 1024) n) n (add i 1024)) acc))))
    (defn qdw-stride (type) (if (eq type 12) 144 210))
    ; one row of a real tensor: its bytes from the file, the exact dot and S, the kernel's value at row r
    (defn qdw-row-ok? (type path base dataoff cols r y coeff label)
        (do (let rowbytes (mul (qdw-stride type) (div cols 256)))
            (let src (read_file_slice path (add base (add dataoff (mul r rowbytes))) rowbytes))
            (let exact (qdw-dot type src cols 0 0.0))
            (let S (qdw-mag type src cols 0 0.0))
            (let got (qdw-f y r))
            (print (list label "row" r "exact" exact "got" got "S" S "dev/bound" (qdw-ratio got exact S coeff)))
            (qdw-within? got exact S coeff)))
    ; the first layer whose slot `slot` is type `ty`, or -1
    (defn qdw-find (lays slot ty l) (if (ge l (len lays)) (sub 0 1) (if (eq (kth-tv-ty (nth (nth lays l) slot)) ty) l (qdw-find lays slot ty (add l 1)))))
    ; a layer's slot k >= 5 reads table 5 + (k - 5) on a linear layer and 14 + (k - 5) on a full-attention
    ; layer (q38-layer); slot 5 is attn_qkv there and attn_q here
    (defn qdw-tab (slot l interval) (if (lt slot 5) slot (if (kth-full? l interval) (add 14 (sub slot 5)) slot)))
    (defn qdw-census (tvs k acc) (if (ge k (len tvs)) acc (qdw-census tvs (add k 1) (str_concat acc (str_concat " " (int_to_str (kth-tv-ty (nth tvs k))))))))
    ; one timing round: n dispatches of the fused record, sync, n of the hoist, sync; the best of `rounds` rounds
    ; of each is kept (the GPU is shared with sibling sessions, so a single round reads their load, not the kernel)
    (defn qdw-rounds (rec ph bindh rows n k bestf besth)
        (if (le k 0) (list bestf besth)
            (do (let t0 (now_unix_ms))
                (let a (qdw-n (nth rec 0) (nth rec 1) (nth rec 2) n))
                (let s0 (metal_sync))
                (let t1 (now_unix_ms))
                (let b (qdw-n ph bindh rows n))
                (let s1 (metal_sync))
                (let t2 (now_unix_ms))
                (let df (sub t1 t0)) (let dh (sub t2 t1))
                (qdw-rounds rec ph bindh rows n (sub k 1) (if (or (lt bestf 0) (lt df bestf)) df bestf) (if (or (lt besth 0) (lt dh besth)) dh besth)))))
    ; one real shape: the fused kernel (the door's record) and the serial hoist of that type (compiled beside,
    ; the previous kernel) n times each, best of five rounds; four rows of the fused kernel against the fp64
    ; dot; the hoist's row 0 too
    (defn qdw-shape (ps ph ctx tv tioff xh n bit label)
        (do (let type (kth-tv-ty tv)) (let rows (kth-tv-r tv)) (let cols (kth-tv-c tv))
            (let path (nth ctx 9)) (let base (nth ctx 8))
            (let dataoff (egg-ti-dataoff (nth ctx 7) tioff))
            (let ya (metal_buf_alloc (mul 4 (add rows 1)))) (let yb (metal_buf_alloc (mul 4 (add rows 1))))
            (let sa (metal_buf_write ya (mul 4 rows) (md-le32 (md-f32-bits 42.25))))
            (let rec (q38dq-rec ps type (kth-tv-h tv) xh ya rows cols 0))
            (let best (qdw-rounds rec ph (md-bind16 (list (kth-tv-h tv) xh yb) (list rows cols 1) 256 0 0 0) rows n 5 (sub 0 1) (sub 0 1)))
            (let a (nth best 0)) (let b (nth best 1))
            (let y (metal_buf_read ya 0 (mul 4 (add rows 1))))
            (let yh (metal_buf_read yb 0 (mul 4 rows)))
            (print_str (str_concat label (str_concat (if (eq type 12) " q4k " " q6k ") (str_concat (int_to_str rows) (str_concat "x" (str_concat (int_to_str cols) (str_concat ": best of 5 rounds, " (str_concat (int_to_str n) (str_concat " fused " (str_concat (int_to_str a) (str_concat " ms, " (str_concat (int_to_str n) (str_concat " hoist " (str_concat (int_to_str b) " ms"))))))))))))))
            (let coeff (q38dq-bound-coeff cols))
            (let r0 (qdw-row-ok? type path base dataoff cols 0 y coeff "fused"))
            (let r1 (qdw-row-ok? type path base dataoff cols 1 y coeff "fused"))
            (let r2 (qdw-row-ok? type path base dataoff cols (sub rows 2) y coeff "fused"))
            (let r3 (qdw-row-ok? type path base dataoff cols (sub rows 1) y coeff "fused"))
            (let h0 (qdw-row-ok? type path base dataoff cols 0 yh cols "hoist"))
            (let sentinel (str_eq (substring y (mul 4 rows) (mul 4 (add rows 1))) (md-le32 (md-f32-bits 42.25))))
            (let freed (add (metal_buf_free ya) (metal_buf_free yb)))
            (if (and (ge a 0) (and (ge b 0) (and sentinel (and r0 (and r1 (and r2 (and r3 h0))))))) bit 0)))
    ; one fixture: a one-row-of-512 K-quant fixture repeated to 3 rows; the fused kernel (the door's record)
    ; and the one-thread attestant `pa` within their bounds of the fp64 dot, the sentinel at y[3] untouched
    (defn qdw-fixture (ps type fx pa bit)
        (do (let n (str_len fx))
            (let fw (metal_buf_alloc (mul 3 n)))
            (let fwrote (metal_buf_write fw 0 (str_concat fx (str_concat fx fx))))
            (let fxh (metal_buf_alloc (mul 4 512)))
            (let fxw (metal_buf_write fxh 0 (qdw-xs 512 0 "")))
            (let fya (metal_buf_alloc 16)) (let fyb (metal_buf_alloc 16))
            (let fsent (add (metal_buf_write fya 12 (md-le32 (md-f32-bits 42.25))) (metal_buf_write fyb 12 (md-le32 (md-f32-bits 42.25)))))
            (let fe (q38-enq (q38dq-rec ps type fw fxh fya 3 512 0)))
            (let fa (metal_enqueue pa (md-bind (list fw fxh fyb) (list 3 512)) 3))
            (let fs (metal_sync))
            (let fy (metal_buf_read fya 0 16)) (let fz (metal_buf_read fyb 0 16))
            (let fexact (qdw-dot type fx 512 0 0.0)) (let fS (qdw-mag type fx 512 0 0.0))
            (let fcoeff (q38dq-bound-coeff 512))
            (print (list "fixture type" type "exact" fexact "S" fS "fused rows" (qdw-f fy 0) (qdw-f fy 1) (qdw-f fy 2) "dev/bound" (qdw-ratio (qdw-f fy 0) fexact fS fcoeff) (qdw-ratio (qdw-f fy 2) fexact fS fcoeff) "attestant" (qdw-f fz 0) "dev/bound" (qdw-ratio (qdw-f fz 0) fexact fS 512)))
            (let freed (sum (list (metal_buf_free fw) (metal_buf_free fxh) (metal_buf_free fya) (metal_buf_free fyb))))
            (if (and (qdw-within? (qdw-f fy 0) fexact fS fcoeff)
                 (and (qdw-within? (qdw-f fy 1) fexact fS fcoeff)
                 (and (qdw-within? (qdw-f fy 2) fexact fS fcoeff)
                 (and (qdw-within? (qdw-f fz 0) fexact fS 512)
                 (and (str_eq (substring fy 12 16) (md-le32 (md-f32-bits 42.25))) (str_eq (substring fz 12 16) (md-le32 (md-f32-bits 42.25)))))))) bit 0)))
    ; ---- the unit: the lane's own, plus the f16 identity probe and the previous (hoisted serial) kernels ----
    (let msl (str_concat (q38-msl) (str_concat (qml-hoist-msl "qdw_hoist_q4k" "q4k" "144") (str_concat (qml-hoist-msl "qdw_hoist_q6k" "q6k" "210") "kernel void qdw_f16 (device uint* out [[buffer(0)]], uint i [[thread_position_in_grid]]) { if (i >= 65536u) return; uint ex = (i / 1024u) % 32u; float a = q4k_f16(int(i)); float b = float(as_type<half>(ushort(i))); out[i] = (ex == 31u) ? 0u : ((as_type<uint>(a) == as_type<uint>(b)) ? 0u : 1u); }"))))
    (let ps (q38-pipes msl))
    (let ph4 (metal_pipeline msl "qdw_hoist_q4k"))
    (let ph6 (metal_pipeline msl "qdw_hoist_q6k"))
    (let pf (metal_pipeline msl "qdw_f16"))
    (if (or (le (nth ps 57) 0) (or (le (nth ps 58) 0) (or (le ph4 0) (or (le ph6 0) (le pf 0))))) (form_error "q4k decode wide band: the unit did not compile (pipeline 57/58, a hoist twin or the f16 probe is 0)") 0)
    ; --- bit 1: the f16 decode identity over every finite pattern ---
    (let fo (metal_buf_alloc (mul 4 65536)))
    (let e1 (metal_enqueue pf (md-bind (list fo) (list)) 65536))
    (let s1 (metal_sync))
    (let mism (qdw-cnt (metal_buf_read fo 0 (mul 4 65536)) 0 65536 0))
    (print (list "f16 identity: patterns" 65536 "excluded inf/nan" 2048 "mismatches" mism))
    (let c1 (if (eq mism 0) 1 0))
    ; --- bits 2 and 128: the committed fixtures, 3 rows of 512 ---
    (let c2 (qdw-fixture ps 12 (read_file_slice "form/form-stdlib/tests/fixtures/q4k-two-superblocks.bin" 0 288) (nth ps 1) 2))
    (let c128 (qdw-fixture ps 14 (read_file_slice "form/form-stdlib/tests/fixtures/q6k-two-superblocks.bin" 0 420) (nth ps 3) 128))
    ; --- bits 4/8/16 and 256/512/1024: real rows of the Q4_K_M file through the lane's open door ---
    (let ctx (q38-open (mr-path (mr-find "qwen38-q4")) 64))
    (if (eq (len ctx) 0) (form_error "q4k decode wide band: q38-open refused the qwen38-q4 artifact") 0)
    (let lays (nth ctx 3))
    (print_str (str_concat "census layer 0 types:" (str_concat (qdw-census (nth lays 0) 0 "") (str_concat "  head type " (int_to_str (kth-tv-ty (nth ctx 6)))))))
    (print_str (str_concat "census layer 3 types:" (qdw-census (nth lays 3) 0 "")))
    (let lg (qdw-find lays 2 12 0)) (let ld (qdw-find lays 4 12 0)) (let lq (qdw-find lays 5 12 0))
    (let l6d (qdw-find lays 4 14 0)) (let l6q (qdw-find lays 5 14 0))
    (if (or (lt lg 0) (or (lt ld 0) (or (lt lq 0) (or (lt l6d 0) (lt l6q 0))))) (form_error "q4k decode wide band: a Q4_K ffn_gate / ffn_down / slot-5 layer or a Q6_K ffn_down / slot-5 layer is missing from the file") 0)
    (let geo (nth ctx 2))
    (let xh (metal_buf_alloc (mul 4 (nth geo 10))))
    (let xw (metal_buf_write xh 0 (qdw-xs (nth geo 10) 0 "")))
    (let cps (nth ctx 0))
    ; the tensor-info offsets come from the lane's own suffix tables (q38-tabs), the way kth-tv-at found them
    (let tabs (q38-tabs (nth ctx 7)))
    (let c4 (qdw-shape cps ph4 ctx (nth (nth lays lg) 2) (gti-off-for (nth tabs (qdw-tab 2 lg (nth geo 22))) lg) xh 20 4 "ffn_gate"))
    (let c8 (qdw-shape cps ph4 ctx (nth (nth lays ld) 4) (gti-off-for (nth tabs (qdw-tab 4 ld (nth geo 22))) ld) xh 20 8 "ffn_down"))
    (let c16 (qdw-shape cps ph4 ctx (nth (nth lays lq) 5) (gti-off-for (nth tabs (qdw-tab 5 lq (nth geo 22))) lq) xh 20 16 (if (kth-full? lq (nth geo 22)) "attn_q" "attn_qkv")))
    (let c256 (qdw-shape cps ph6 ctx (nth (nth lays l6d) 4) (gti-off-for (nth tabs (qdw-tab 4 l6d (nth geo 22))) l6d) xh 20 256 "ffn_down"))
    (let c512 (qdw-shape cps ph6 ctx (nth (nth lays l6q) 5) (gti-off-for (nth tabs (qdw-tab 5 l6q (nth geo 22))) l6q) xh 20 512 (if (kth-full? l6q (nth geo 22)) "attn_q" "attn_qkv")))
    (let c1024 (if (eq (kth-tv-ty (nth ctx 6)) 14) (qdw-shape cps ph6 ctx (nth ctx 6) (egg-find-tensor (nth ctx 7) "output.weight") xh 4 1024 "head") 0))
    ; --- bits 32/64: the lane's dispatch record is the door's ---
    (let gtv (nth (nth lays lg) 2))
    (let grec (q38-mv-rec cps gtv xh xh 0))
    (let c32 (if (and (eq (nth grec 0) (nth cps 57)) (eq (nth grec 2) (div (add (kth-tv-r gtv) 1) 2))) 32 0))
    (let stv (nth (nth lays l6d) 4))
    (let srec (q38-mv-rec cps stv xh xh 0))
    (let c64 (if (and (eq (nth srec 0) (nth cps 58)) (eq (nth srec 2) (div (add (kth-tv-r stv) 1) 2))) 64 0))
    (let verdict (add c1 (add c2 (add c4 (add c8 (add c16 (add c32 (add c64 (add c128 (add c256 (add c512 c1024)))))))))))
    (print (list "q4k-decode-wide-band verdict" verdict))
    (if (eq verdict 2047) verdict (form_error (str_concat "q4k decode wide band failed: " (int_to_str verdict)))))
