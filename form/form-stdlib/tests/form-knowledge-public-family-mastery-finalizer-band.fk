; form-knowledge-public-family-mastery-finalizer-band.fk -- pure convergence.
;
; All live-looking values are synthetic executable fixtures. No model,
; carrier, registry, hidden evaluator, remote lane or generated artifact runs.
; Expected: 1073741823 (30 bits).
; witnessed: 2026-08-25 -> 1073741823, exit 0
; preludes: form-stdlib/form-knowledge-public-family-mastery-finalizer.fk

(do
    (defn fkpmfb-bit (held weight) (if held weight 0))
    (defn fkpmfb-model-id () "synthetic-local-qwen")
    (defn fkpmfb-resident-run-id ()
        (nmfe-sha256 "synthetic-finalizer-resident-run"))
    (defn fkpmfb-run-id (kind family model-id)
        (nmfe-sha256 (nmfe-fields
            (list "synthetic-finalizer-run-v1" kind family model-id))))

    ; ---- 30 public resident trials ----------------------------------
    (defn fkpmfb-raw-prefix ()
        "choice-task=knowledge\nchoice-match=1\nbackend=form-native-metal-jit\ntext:\n")
    (defn fkpmfb-raw-answer (presentation answer)
        (str_concat (fkpmfb-raw-prefix)
            (str_concat (fkqt-open)
            (str_concat (str_concat "finalizer fixture:"
                                    (fkp30-presentation-trial-id presentation))
            (str_concat (fkqt-close) answer)))))
    (defn fkpmfb-score-for (presentation raw)
        (do
            (let row (fkhe-find-row (fkp30-presentation-row-id presentation)
                                    (fkhe-rows)))
            (fkhe-score row (fqt-knowledge-prompt (fkhe-prompt row))
                (fkhe-parse-resident-output raw) 7)))
    (defn fkpmfb-trial-with-raw (presentation raw)
        (do
            (let score (fkpmfb-score-for presentation raw))
            (let observation (fkhe-score-observation score))
            (let error (nmfe-obs-error observation))
            (let present (if (eq error 0) 1 0))
            (let zero (if (and (eq present 1)
                               (str_eq (nth score 8) (nmfe-sha256 "0"))) 1 0))
            (let one (if (and (eq present 1)
                              (str_eq (nth score 8) (nmfe-sha256 "1"))) 1 0))
            (let session (fkp30-session-id-for
                (fkpmfb-resident-run-id) (fkpmfb-model-id)))
            (let nonce (fkp30-trial-nonce-for
                (fkpmfb-resident-run-id) session presentation))
            (fkp30-trial presentation score (fkpmfb-model-id)
                (fkpmfb-resident-run-id) session raw (nmfe-sha256 raw) nonce
                (fkp30-content-sha-for nonce raw) 1 0 1 1 1
                (if (eq present 1) "value" "nothing") present zero one
                12 8 20 1 0 0 0 0 7)))
    (defn fkpmfb-perfect-trial (presentation)
        (do
            (let row (fkhe-find-row (fkp30-presentation-row-id presentation)
                                    (fkhe-rows)))
            (fkpmfb-trial-with-raw presentation
                (fkpmfb-raw-answer presentation (fkhe-expected row)))))
    (defn fkpmfb-perfect-trials (presentations)
        (if (eq (len presentations) 0) (list)
            (cons (fkpmfb-perfect-trial (head presentations))
                  (fkpmfb-perfect-trials (tail presentations)))))
    (defn fkpmfb-replace-at (rows at replacement)
        (if (eq at 0) (cons replacement (tail rows))
            (cons (head rows)
                (fkpmfb-replace-at (tail rows) (sub at 1) replacement))))
    (defn fkpmfb-export-for (trials)
        (fkp30-export (fkp30-result trials 1 0 1)))

    ; ---- family-specific generative evidence -----------------------
    (defn fkpmfb-bml (family)
        (str_concat "int Lift(int n) { return n + "
            (str_concat (int_to_str (fkpfm-family-ordinal family))
                "; }\nreturn Lift(65);")))
    (defn fkpmfb-bmf ()
        "grammar {\n  rule atmark { lit @ }\n  rule vowel { class ae }\n  rule markedvowel { seq atmark vowel }\n  rule entrance { alt vowel markedvowel }\n  top entrance\n  probe @a\n}")
    (defn fkpmfb-form (family)
        (do
            (let challenge (fkpfm-family-exec-challenge family))
            (fgsg-control-canonical
                (fgsg-cat (list "<|form:recipe-exec|>"
                    (frex-node-coordinate (frex-recipe))
                    ";input=" (int_to_str (fgsg-challenge-input challenge))
                    ";carrier=auto<|/form:recipe-exec|>"))
                "nothing,timeout,zero" "one"
                (int_to_str (fgsg-challenge-checkpoint challenge))
                (int_to_str (fgsg-challenge-timeout-budget challenge))
                (fgsg-challenge-plane challenge)
                (int_to_str (fgsg-challenge-heat challenge))
                (int_to_str (fgsg-challenge-pure challenge)))))
    (defn fkpmfb-candidate (family)
        (fgsg-candidate (fkpmfb-bml family) (fkpmfb-bmf)
            (fkpmfb-form family)))
    (defn fkpmfb-candidate-output (candidate)
        (fgsg-cat (list "<BML>" (fgsg-candidate-bml candidate) "</BML>"
            "<BMF>" (fgsg-candidate-bmf candidate) "</BMF>"
            "<FORM>" (fgsg-candidate-form candidate) "</FORM>")))
    (defn fkpmfb-generative-for (family model-id)
        (do
            (let candidate (fkpmfb-candidate family))
            (let raw (fkpmfb-candidate-output candidate))
            (let receipt (fkpfm-generative-receipt family model-id
                (fkpmfb-run-id "generative" family model-id) raw candidate))
            (fkpfm-generative-evidence family model-id receipt raw candidate
                1 0 1)))
    (defn fkpmfb-generatives (families model-id)
        (if (eq (len families) 0) (list)
            (cons (fkpmfb-generative-for (head families) model-id)
                (fkpmfb-generatives (tail families) model-id))))

    ; ---- family-native structured checks/receipts ------------------
    (defn fkpmfb-result-for (family request)
        (do
            (let input (fkpfm-family-native-input family))
            (let value (add (mul 3 input) 7))
            (let base (frex-choice request
                (list (frex-offer "metal" "value" value
                    "fixture-finalizer-native"))))
            (frex-result-with-flags "value" (frex-result-reason base)
                request "metal" value 1 (frex-result-trace base)
                (frex-result-attempts base) 1 0 1)))
    (defn fkpmfb-native-for (family model-id)
        (do
            (let binding (fkfne-binding-for-family family "metal"))
            (let prep (fkfne-prepare binding (fkfne-binding-query binding)))
            (let result (fkpmfb-result-for family (fkfne-prep-request prep)))
            (fkfne-check binding prep result model-id
                (fkpmfb-run-id "native" family model-id) 0 1)))
    (defn fkpmfb-natives (families model-id)
        (if (eq (len families) 0) (list)
            (cons (fkpmfb-native-for (head families) model-id)
                (fkpmfb-natives (tail families) model-id))))

    ; ---- post-constructor adversaries -------------------------------
    (defn fkpmfb-receipt-with-sha (receipt sha)
        (list (nth receipt 0) (nth receipt 1) (nth receipt 2)
            (nth receipt 3) (nth receipt 4) (nth receipt 5)
            (nth receipt 6) (nth receipt 7) (nth receipt 8)
            (nth receipt 9) (nth receipt 10) (nth receipt 11)
            (nth receipt 12) (nth receipt 13) (nth receipt 14)
            (nth receipt 15) (nth receipt 16) (nth receipt 17)
            (nth receipt 18) sha))
    (defn fkpmfb-generative-with (e receipt model source run)
        (list (nth e 0) (nth e 1) (nth e 2) model receipt
            (nth e 5) source (nth e 7) (nth e 8) (nth e 9)
            (nth e 10) (nth e 11) (nth e 12) (nth e 13)
            (nth e 14) run))
    (defn fkpmfb-execution-with (e receipt source run)
        (list (nth e 0) (nth e 1) (nth e 2) (nth e 3) receipt
            (nth e 5) source (nth e 7) (nth e 8) (nth e 9)
            (nth e 10) (nth e 11) (nth e 12) (nth e 13) run))
    (defn fkpmfb-check-with-evidence-receipt (check evidence receipt)
        (fkfne-check-row (fkfne-check-status check)
            (fkfne-check-reason check) (fkfne-check-binding check)
            (fkfne-check-prep check) (fkfne-check-result check)
            (fkfne-check-typed check) (fkfne-check-output-sha check)
            evidence receipt (fkfne-check-raw-query check)
            (fkfne-check-model-id check) (fkfne-check-run-id check)
            (fkfne-check-remote-calls check)
            (fkfne-check-release-ok? check)))
    (defn fkpmfb-cross-family-generative (from-family to-family)
        (do
            (let candidate (fkpmfb-candidate from-family))
            (let raw (fkpmfb-candidate-output candidate))
            (let receipt (fkpfm-generative-receipt to-family
                (fkpmfb-model-id)
                (fkpmfb-run-id "generative" to-family (fkpmfb-model-id))
                raw candidate))
            (fkpfm-generative-evidence to-family (fkpmfb-model-id)
                receipt raw candidate 1 0 1)))
    (defn fkpmfb-cross-family-native (from-family to-check)
        (do
            (let from (fkpmfb-native-for from-family (fkpmfb-model-id)))
            (let result (fkfne-check-result from))
            (let raw (fkfne-check-raw-query from))
            (let receipt (fkpfm-receipt "execution"
                (fkpmf-native-family to-check) (fkpmfb-model-id)
                (fkfne-check-run-id to-check) raw (frex-render result)
                1 0 1 1 1))
            (let evidence (fkpfm-execution-evidence
                (fkpmf-native-family to-check) (fkpmfb-model-id)
                receipt raw 1 0 1 result))
            (fkpmfb-check-with-evidence-receipt to-check evidence receipt)))

    (defn fkpmfb-public-trial-with-seal (trial seal)
        (list (nth trial 0) seal (nth trial 2) (nth trial 3)
            (nth trial 4) (nth trial 5) (nth trial 6) (nth trial 7)
            (nth trial 8) (nth trial 9) (nth trial 10) (nth trial 11)
            (nth trial 12) (nth trial 13) (nth trial 14) (nth trial 15)
            (nth trial 16) (nth trial 17) (nth trial 18) (nth trial 19)
            (nth trial 20) (nth trial 21) (nth trial 22) (nth trial 23)
            (nth trial 24) (nth trial 25) (nth trial 26) (nth trial 27)))
    (defn fkpmfb-export-with-public-trials (export trials)
        (list (nth export 0) (nth export 1) (nth export 2) (nth export 3)
            trials (nth export 5) (nth export 6) (nth export 7)
            (nth export 8) (nth export 9) (nth export 10) (nth export 11)
            (nth export 12) (nth export 13) (nth export 14)
            (nth export 15) (nth export 16) (nth export 17)))
    (defn fkpmfb-source-swapped-export (export)
        (do
            (let public-trials (nth export 4))
            (let first (head public-trials))
            (let seal (nth first 1))
            (let bad-seal (list (nth seal 0) (nth seal 1) (nth seal 2)
                (nth seal 3) (nth seal 4)
                "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
                (nth seal 6) (nth seal 7) (nth seal 8)))
            (fkpmfb-export-with-public-trials export
                (cons (fkpmfb-public-trial-with-seal first bad-seal)
                      (tail public-trials)))))
    (defn fkpmfb-result-with-route (result route)
        (list (nth result 0) (nth result 1) (nth result 2)
            (nth result 3) (nth result 4) (nth result 5)
            (nth result 6) (nth result 7) (nth result 8)
            (nth result 9) (nth result 10) (nth result 11)
            (nth result 12) (nth result 13) (nth result 14)
            (nth result 15) route (nth result 17)))
    (defn fkpmfb-find-result-row (family rows)
        (if (eq (len rows) 0) (nothing)
            (if (str_eq family (nth (head rows) 1)) (head rows)
                (fkpmfb-find-result-row family (tail rows)))))

    (defn form-knowledge-public-family-mastery-finalizer-band ()
        (do
            (let families (fkpfm-family-ids))
            (let presentations (fkp30-presentations))
            (let trials (fkpmfb-perfect-trials presentations))
            (let export (fkpmfb-export-for trials))
            (let generative (fkpmfb-generatives families (fkpmfb-model-id)))
            (let native (fkpmfb-natives families (fkpmfb-model-id)))
            (let result (fkpmf-finalize export generative native))
            (let rows (fkpmf-result-rows result))
            (let mastery (fkpmf-result-mastery result))

            (let wrong-trial (fkpmfb-trial-with-raw (nth presentations 1)
                (fkpmfb-raw-answer (nth presentations 1)
                    "intentionally-wrong-heldout-answer")))
            (let low-trials (fkpmfb-replace-at trials 1 wrong-trial))
            (let low-export (fkpmfb-export-for low-trials))
            (let low-axioms (fkpmf-family-row "axioms" low-export 0
                low-trials (list) (list)))
            (let missing-generative-row (fkpmf-family-row "axioms" export 1
                trials (list) native))
            (let missing-native-row (fkpmf-family-row "axioms" export 1
                trials generative (list)))
            (let duplicate-generative (cons (head generative)
                (cons (head generative) (tail (tail generative)))))
            (let duplicate-native (cons (head native)
                (cons (head native) (tail (tail native)))))

            (let first-gen (head generative))
            (let second-family (nth families 1))
            (let wrong-gen-run (fkpmfb-generative-with first-gen
                (fkpmf-generative-receipt first-gen)
                (fkpmf-generative-model first-gen) (nth first-gen 6)
                "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"))
            (let wrong-gen-source (fkpmfb-generative-with first-gen
                (fkpmf-generative-receipt first-gen)
                (fkpmf-generative-model first-gen)
                "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
                (nth first-gen 15)))
            (let wrong-gen-receipt (fkpmfb-generative-with first-gen
                (fkpmfb-receipt-with-sha
                    (fkpmf-generative-receipt first-gen)
                    "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")
                (fkpmf-generative-model first-gen) (nth first-gen 6)
                (nth first-gen 15)))
            (let other-model-gen
                (fkpmfb-generative-for (head families) "other-local-model"))

            (let first-native (head native))
            (let first-exec (fkfne-check-evidence first-native))
            (let wrong-exec-run (fkpmfb-execution-with first-exec
                (fkfne-check-receipt first-native) (nth first-exec 6)
                "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"))
            (let wrong-exec-source (fkpmfb-execution-with first-exec
                (fkfne-check-receipt first-native)
                "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
                (nth first-exec 14)))
            (let bad-native-receipt (fkpmfb-receipt-with-sha
                (fkfne-check-receipt first-native)
                "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"))
            (let wrong-exec-receipt (fkpmfb-execution-with first-exec
                bad-native-receipt (nth first-exec 6) (nth first-exec 14)))
            (let other-model-native
                (fkpmfb-native-for (head families) "other-local-model"))
            (let bootstrap-row (fkpmfb-find-result-row "bootstrap" rows))
            (let absent-axioms-row missing-native-row)

            (sum (list
                (fkpmfb-bit (and (eq (fkp30-export-valid? export) 1)
                    (and (eq (len trials) 30)
                         (eq (len families) 15))) 1)
                (fkpmfb-bit (and (eq (len generative) 15)
                    (eq (len native) 15)) 2)
                (fkpmfb-bit (eq (fkpmf-all-generative-valid?
                    generative) 1) 4)
                (fkpmfb-bit (eq (fkpmf-all-native-valid? native) 1) 8)
                (fkpmfb-bit (eq (fkpmf-family-counts-unique?
                    families generative native) 1) 16)
                (fkpmfb-bit (eq (fkpmf-all-generative-model?
                    generative (fkpmfb-model-id)) 1) 32)
                (fkpmfb-bit (eq (fkpmf-all-native-model?
                    native (fkpmfb-model-id)) 1) 64)
                (fkpmfb-bit (eq (fkpmf-generative-receipts-unique?
                    generative generative native) 1) 128)
                (fkpmfb-bit (eq (fkpmf-native-receipts-unique?
                    native generative native) 1) 256)
                (fkpmfb-bit (and (eq (fkpmf-count-good-trials low-trials) 29)
                    (and (eq (fkpmf-row-both-heldout? low-axioms) 0)
                         (str_eq (fkpmf-trial-lane (nth low-axioms 4)) "b")))
                    512)
                (fkpmfb-bit (and (eq (fkpmf-row-generative-valid?
                                        missing-generative-row) 0)
                    (and (eq (fkpmf-row-execution-valid?
                                missing-generative-row) 1)
                         (eq (fkpmf-row-mastered?
                                missing-generative-row) 0))) 1024)
                (fkpmfb-bit (and (eq (fkpmf-row-generative-valid?
                                        missing-native-row) 1)
                    (and (eq (fkpmf-row-execution-valid?
                                missing-native-row) 0)
                         (eq (fkpmf-row-mastered? missing-native-row) 0))) 2048)
                (fkpmfb-bit (nothing? (fkpmf-finalize export
                    duplicate-generative native)) 4096)
                (fkpmfb-bit (nothing? (fkpmf-finalize export
                    generative duplicate-native)) 8192)
                (fkpmfb-bit (nothing? (fkpmf-finalize export
                    (cons (head generative)
                        (cons (fkpmfb-cross-family-generative
                            (head families) second-family)
                            (tail (tail generative)))) native)) 16384)
                (fkpmfb-bit (nothing? (fkpmf-finalize export generative
                    (cons (head native)
                        (cons (fkpmfb-cross-family-native
                            (head families) (nth native 1))
                            (tail (tail native)))))) 32768)
                (fkpmfb-bit (nothing? (fkpmf-finalize export
                    (cons wrong-gen-run (tail generative)) native)) 65536)
                (fkpmfb-bit (nothing? (fkpmf-finalize export generative
                    (cons (fkpmfb-check-with-evidence-receipt first-native
                        wrong-exec-run (fkfne-check-receipt first-native))
                        (tail native)))) 131072)
                (fkpmfb-bit (nothing? (fkpmf-finalize export
                    (cons other-model-gen (tail generative)) native)) 262144)
                (fkpmfb-bit (nothing? (fkpmf-finalize export generative
                    (cons other-model-native (tail native)))) 524288)
                (fkpmfb-bit (nothing? (fkpmf-finalize export
                    (cons wrong-gen-source (tail generative)) native)) 1048576)
                (fkpmfb-bit (nothing? (fkpmf-finalize export generative
                    (cons (fkpmfb-check-with-evidence-receipt first-native
                        wrong-exec-source (fkfne-check-receipt first-native))
                        (tail native)))) 2097152)
                (fkpmfb-bit (nothing? (fkpmf-finalize export
                    (cons wrong-gen-receipt (tail generative)) native)) 4194304)
                (fkpmfb-bit (nothing? (fkpmf-finalize export generative
                    (cons (fkpmfb-check-with-evidence-receipt first-native
                        wrong-exec-receipt bad-native-receipt)
                        (tail native)))) 8388608)
                (fkpmfb-bit (nothing? (fkpmf-finalize
                    (fkpmfb-source-swapped-export export)
                    generative native)) 16777216)
                (fkpmfb-bit (and (nothing? (fkpmf-finalize export
                    (list 0) native))
                    (nothing? (fkpmf-finalize export generative
                        (list (fkfne-check-row "value" "forged"
                            0 0 0 "" (nmfe-sha256 "") (nothing) (nothing)
                            "" "" (fkpmfb-resident-run-id) 0 1))))) 33554432)
                (fkpmfb-bit (and (nothing? (fkpmf-finalize
                    (nothing) generative native))
                    (and (nothing? (fkpmf-finalize 0 generative native))
                         (nothing? (fkpmf-finalize 1 generative native))))
                    67108864)
                (fkpmfb-bit (and (eq (fkpmf-row-value-present?
                                        bootstrap-row) 1)
                    (and (eq (fkpmf-row-value bootstrap-row) 1)
                    (and (eq (fkpmf-row-value-present? absent-axioms-row) 0)
                         (nothing? (fkpmf-row-value absent-axioms-row)))))
                    134217728)
                (fkpmfb-bit (and (eq (nth
                    (fkpmfb-result-with-route result 1) 16) 1)
                    (not (eq (fkpfm-equal?
                        (fkpmfb-result-with-route result 1) result) 1)))
                    268435456)
                (fkpmfb-bit (and (eq (fkpfm-list? result) 1)
                    (and (eq (len result) 18)
                    (and (str_eq (fkpmf-result-status result) "value")
                    (and (eq (fkpmf-result-total result) 15)
                    (and (eq (fkpmf-result-mastered result) 15)
                    (and (eq (fkpmf-result-percent result) 100)
                    (and (eq (fkpmf-result-ready? result) 1)
                    (and (eq (fkpmf-result-heldout-generations result) 30)
                    (and (eq (fkpmf-result-heldout-families result) 15)
                    (and (eq (len rows) 15)
                    (and (eq (fkpmf-count-row-field rows 15) 15)
                    (and (eq (fkpfm-report-heldout-families mastery) 15)
                    (and (eq (fkpfm-report-generative-families mastery) 15)
                    (and (eq (fkpfm-report-execution-families mastery) 15)
                    (and (eq (fkpfm-report-invalid-evidence mastery) 0)
                    (and (eq (fkpfm-report-route-addressability-credit
                                 mastery) 0)
                    (and (eq (fkpmf-result-route-credit result) 0)
                         (ge (str_find
                            (fkpmf-result-authentication-seam result)
                            "do not authenticate" 0) 0))))))))))))))))))
                    536870912)))))

    (form-knowledge-public-family-mastery-finalizer-band))
