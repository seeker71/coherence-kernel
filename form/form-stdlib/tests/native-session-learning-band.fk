; A serving decision must retain every held-out row and its identity.
; preludes: form-stdlib/native-session-learning.bml
(do
 (defn nslb-score (id loss) (json-node-object (list (nsm-s "row_sha256" id) (nsm-real "loss" loss))))
 (let before (list (nslb-score "train" 2.0) (nslb-score "held" 1.0)))
 (let better (list (nslb-score "train" 1.0) (nslb-score "held" 0.9)))
 (let worse (list (nslb-score "train" 0.5) (nslb-score "held" 1.1)))
 (let other (list (nslb-score "train" 1.0) (nslb-score "other" 0.9)))
 (let checks (list (nsl-promotable before better) (not (nsl-promotable before worse)) (not (nsl-promotable before other))
   (not (nsl-promotable (take 1 before) (take 1 better)))
   (nsl-overlap (nsm-row "held out" "a") (list (nsm-row "held out" "b")))
   (not (nsl-overlap (nsm-row "new" "a") (list (nsm-row "held out" "b"))))))
 (print checks)
 (if (value_eq checks (list 1 1 1 1 1 1)) 63 (form_error "session learning policy failed")))
