; living-world-contextual-species-enquiry-band.fk -- split fields answer whole.
; Verdict 32767 proves fifteen native answer, derivation, and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk form-stdlib/living-world-contextual-species.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk form-stdlib/tests/living-world-behavioral-species-witness.fk form-stdlib/tests/living-world-contextual-species-witness.fk

(do
    (let multi (lwcsw-build-multi))
    (let coherent (lwcsw-integrated-coherent-tissue multi))
    (let split (lwcsw-build-split multi coherent))
    (let split-tissue (lwcsw-split-tissue split))
    (let tissue (lwcsw-tissue-candidate split-tissue))
    (let question (lwcsw-question tissue))
    (let question-world (lwcsw-question-world split))
    (let answer (lwcs-answer-for question-world question 2))
    (let proposal (lwcs-answer-proposal question-world question 2))
    (let candidate (lwt-proposal-candidate proposal))
    (let waiting-round
        (lwt-round question-world (lwo-field (list proposal))
            (lwo-empty-field) (lwcsw-tissue-round split-tissue)))
    (let waiting
        (lwcs-answer-integrate waiting-round proposal (lwigw-action)))
    (let integrated (lwcsw-integrated-answer split))
    (let integrated-world
        (lwt-round-world (lwcsw-answer-round integrated)))
    (let integrated-candidate (lwcsw-answer-candidate integrated))
    (let derivation (lwcs-answer-derivation answer))
    (let addressed (lwcs-answer-component answer))
    (let components (lwcs-answer-components answer))
    (let other-items
        (lwo-field-items components))
    (let revoked-world
        (lwt-receive-stream integrated-world
            (list
                (lwcsw-entry-r
                    (lwo-revocation question (lwcsw-source-r)
                        (lwcsw-reason) (lwcsw-prov-r))))))

    (let c1
        (if (eq (lwcs-tissue-integrated-current?
                    question-world tissue) 1) 1 0))
    (let c2
        (if (and (eq (lwcs-question-valid? question) 1)
                 (node_eq (lwcs-question-context question)
                          (lwo-none))) 2 0))
    (let c3
        (if (and (eq (lwo-field-size
                         (lwo-active-attributions-for
                           question-world question)) 2)
                 (eq (lwo-field-size
                         (lwcs-question-sources
                           question-world question)) 2)) 4 0))
    (let c4
        (if (and (not (node_eq answer (lwo-none)))
                 (eq (lwcs-answer? answer) 1)) 8 0))
    (let c5
        (if (and (eq (lwcs-split? (lwcs-answer-status answer)) 1)
                 (eq (lwo-field-size components) 2)) 16 0))
    (let c6
        (if (and (node_eq (lwcs-answer-tissue answer) tissue)
                 (eq (lwo-field-size
                         (lwcs-answer-members answer)) 3)) 32 0))
    (let c7
        (if (and (eq (lwo-field-size
                         (lwcs-answer-receipts answer)) 3)
                 (eq (lwo-field-size
                         (lwcs-answer-contexts answer)) 2)) 64 0))
    (let c8
        (if (and (eq (oac-node? (lwcs-answer-ack answer)) 1)
                 (node_eq (oac-payload (lwcs-answer-ack answer))
                          addressed)) 128 0))
    (let c9
        (if (and (eq (lwo-field-has?
                         (lwcs-answer-alternatives answer)
                         (lwcsw-option)) 1)
                 (or (eq (lwo-field-has?
                             (lwcs-answer-alternatives answer)
                             (nth other-items 0)) 1)
                     (eq (lwo-field-has?
                             (lwcs-answer-alternatives answer)
                             (nth other-items 1)) 1))) 256 0))
    (let c10
        (if (eq (lwo-field-has?
                    (lwcs-answer-unknowns answer)
                    (lwlc-unknown (lwcsw-question-evidence))) 1) 512 0))
    (let c11
        (if (and (eq (lwcs-derivation? derivation) 1)
                 (and (node_eq (lwcs-derivation-tissue derivation)
                               tissue)
                      (and (node_eq
                              (lwcs-derivation-field derivation)
                              (lwcs-tissue-field
                                (lwo-emergent-shape tissue)))
                           (eq (lwo-field-size
                                  (lwcs-derivation-question-attributions
                                    derivation)) 2)))) 1024 0))
    (let c12
        (if (and (eq (lwo-field-size
                         (lwt-proposal-participants proposal)) 32)
                 (eq (lwcs-answer-proposal-current?
                         question-world proposal) 1)) 2048 0))
    (let c13
        (if (eq (lwo-active?
                    (lwt-round-world waiting) candidate) 0) 4096 0))
    (let c14
        (if (and (eq (lwcs-answer-integrated-current?
                         integrated-world integrated-candidate) 1)
                 (node_eq (lwcsw-answer-shape integrated) answer)) 8192 0))
    (let c15
        (if (and (node_eq
                    (lwcs-answer-for question-world question 0)
                    (lwo-none))
                 (and (node_eq
                        (lwcs-answer-for revoked-world question 2)
                        (lwo-none))
                      (eq (lwcs-answer-candidate-current?
                              revoked-world integrated-candidate) 0)))
            16384 0))
    (lwtnw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
