//////////////////////////////////////////////////////////////////////
//
// bml-two-preludes-witness.bml
//
// A .bml unit that names its preludes on TWO lines. The seed reads every
// "; preludes:" line of a .fk; the floor's lowering must carry every
// "// preludes:" line the same way, or the second line loads nothing
// and the unit answers with unresolved calls. Run it directly:
//
//   ./fkwu form/form-stdlib/tests/bml-two-preludes-witness.bml   -> 1000007, exit 0
//
// (ppm-scale from scale.bml on the second line, str_len from core.fk on
// the first; a unit that only carried its first line cannot add them.)
//
// preludes: form-stdlib/core.fk
// preludes: form-stdlib/scale.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormBmlTwoPreludesWitness {
        def btpw-answer() = add(ppm-scale(), str_len("witness"));
    }
    btpw-answer();
}
