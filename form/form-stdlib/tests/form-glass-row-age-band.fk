; Reuse unchanged ages; retain normalization, provenance and clock reversal. 31.
; preludes: form/form-stdlib/form-glass-observer.bml
(do
 (let row (fgo-observe-row (fgo-int "fixture" "age" "age" 5 "calls" 0 "cpu-arena" "physical-live" "fixture" "live" "test" "") 1000 7))
 (let absent (fgo-observe-row (fgo-unavailable "fixture" "missing" "missing" "calls" "cpu-arena" "fixture" "test" "absent") 1000 8))
 (let source (append row (list (intern_trivial_int 71))))
 (sum (list
  (if (and (fgo-age-reusable? row) (value_eq row (fgo-age-row-at row 1000))) 1 0)
  (if (value_eq (fgo-age-row-at row 1100) (fgo-row-at row 100 1000 7)) 2 0)
  (if (and (eq (fgo-age (fgo-age-row-at row 999)) -2) (eq (fgo-observation-sequence (fgo-age-row-at row 999)) 7)) 4 0)
  (if (value_eq absent (fgo-age-row-at absent 9000)) 8 0)
  (if (and (value_eq source (fgo-age-row-at source 1000)) (node_eq (fgo-source-node source) (fgo-source-node (fgo-age-row-at source 1100)))) 16 0))))
