; form-cli-lens-mint-band.fk — lenses and staking across query lanes; overlay fits the lens.
;
; Verdict 1023:
;   1..128  fls-check (n=144, mix, leakage, unique, split, heldout>=54, lora-writer=0, covers-all)
;   256     class descriptor FormLensMint minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-lens-mint.bml
; witnessed: 2026-08-26 -> 1023; 8 lenses x 9 lanes, n=144 unique leakage 0, heldout 72/72 covers-all; lora-writer 0

(do
    (defn flsb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn flsb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (flsb-has-name? (tail xs) name))))

    (let bits (fls-check))
    (let desc (FormLensMint))
    (let src (read_file "form/form-stdlib/bml/form-cli-lens-mint.bml"))
    (let exe (read_file "form/form-stdlib/form-cli-lens-mint.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormLensMint")
                     (and (eq (flsb-has-name? (nth desc 2) "T") 1)
                          (and (eq (flsb-has-name? (nth desc 3) "fls-corpus") 1)
                               (eq (flsb-has-name? (nth desc 4) "MixA") 1))))
                256 0))
    (let b9 (if (and (eq (flsb-has-str? src "package Form.cli.lensmint") 1)
                     (and (eq (flsb-has-str? src "interface ILensMint") 1)
                          (and (eq (flsb-has-str? src "class FormLensMint") 1)
                               (and (eq (flsb-has-str? src "const int MixA") 1)
                                    (and (eq (flsb-has-str? src "template SampleRow") 1)
                                         (and (eq (flsb-has-str? exe "heldout-v3") 0)
                                              (eq (flsb-has-str? exe "turn_started") 0)))))))
                512 0))
    (add bits (add b8 b9)))
