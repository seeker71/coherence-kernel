; bml-demand-jit-fault-key-probe-a.fk — fresh-process stable locator fixture.
; preludes: form/form-stdlib/bml-demand-jit.fk

(do
    (let program (list (list 1 0 0) (list 4 1 0)))
    (let pending (bdj-pending "/tmp/source-a" "/tmp/cache-a" program 1 7 301))
    (bdj-fault-id pending 301 "install-challenge" 9001))
