; living-world-enquiry-witness.fk -- an admitted chain meeting an unseen input.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-enquiry.fk form-stdlib/living-world-enquiry-answer.fk form-stdlib/tests/living-world-concept-witness.fk

(let LWENW-SETUP (bp "LWENW-SETUP"))

; children: input world, prior round, first mapping, second mapping, chain
(defn lwenw-setup-node
    (world prior first-candidate second-candidate chain-candidate)
    (intern_node LWENW-SETUP
        (list world prior first-candidate second-candidate chain-candidate)))
(defn lwenw-world (setup) (nth (node_children setup) 0))
(defn lwenw-prior (setup) (nth (node_children setup) 1))
(defn lwenw-first-candidate (setup) (nth (node_children setup) 2))
(defn lwenw-second-candidate (setup) (nth (node_children setup) 3))
(defn lwenw-chain-candidate (setup) (nth (node_children setup) 4))

(defn lwenw-setup ()
    (do
        (let base (lwcxw-base-round))
        (let first-proposal (lwcxw-first-proposal base))
        (let second-proposal (lwcxw-second-proposal base))
        (let first-candidate (lwt-proposal-candidate first-proposal))
        (let second-candidate (lwt-proposal-candidate second-proposal))
        (let first-integrated
            (lwt-integrate (lwcxw-first-yes-round base first-proposal)
                           first-proposal (lwcxw-action)))
        (let second-round
            (lwt-round (lwt-round-world first-integrated)
                (lwo-field-add (lwo-empty-field) second-proposal)
                (lwo-empty-field) first-integrated))
        (let second-integrated
            (lwt-integrate
                (lwcxw-second-yes-round second-round second-proposal)
                second-proposal (lwcxw-action)))
        (let mapping-world (lwt-round-world second-integrated))
        (let chain-proposals (lwcx-chain-proposals mapping-world))
        (let chain-proposal (head (lwo-field-items chain-proposals)))
        (let chain-candidate (lwt-proposal-candidate chain-proposal))
        (let chain-round
            (lwt-round mapping-world chain-proposals
                (lwo-empty-field) second-integrated))
        (let chain-integrated
            (lwcx-integrate-chain
                (lwcxw-chain-yes-round chain-round chain-proposal)
                chain-proposal (lwcxw-action)))
        (let input-world
            (lwcxw-input-world (lwt-round-world chain-integrated)))
        (let focus
            (lwen-focus (lwcxw-unseen-input)
                (intern_trivial_string "lwenw-enquiry-consent")))
        (lwenw-setup-node
            (lwt-receive-stream input-world
                (list (lwcxw-entry (lwcxw-source-e) focus
                                   (lwcxw-provenance-e))))
            chain-integrated first-candidate second-candidate chain-candidate)))

(defn lwenw-question-proposal-for-items
    (items path-candidate input)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let proposal (head items))
            (let candidate (lwt-proposal-candidate proposal))
            (let question (lwo-emergent-shape candidate))
            (if (and (node_eq (lwen-question-kind question) (lwen-gap))
                     (eq (lwen-question-has-path?
                            question path-candidate input) 1))
                proposal
                (lwenw-question-proposal-for-items
                    (tail items) path-candidate input)))))

(defn lwenw-chain-question-proposal (setup proposals)
    (lwenw-question-proposal-for-items
        (lwo-field-items proposals)
        (lwenw-chain-candidate setup) (lwcxw-unseen-input)))

(defn lwenw-five-yes-round (round proposal)
    (lwcxw-application-yes-round round proposal))

(defn lwenw-round-with-proposal (world proposal prior)
    (lwt-round world
        (lwo-field-add (lwo-empty-field) proposal)
        (lwo-empty-field) prior))

(defn lwenw-add-first-experience (round setup)
    (do
        (let signature
            (lwrr-mapping-signature
                (lwo-emergent-shape
                    (lwenw-first-candidate setup))))
        (lwt-round-receive round
            (list (lwcxw-entry (lwcxw-source-e)
                (lwcxw-confirming-experience signature)
                (lwcxw-provenance-e))))))

(defn lwenw-proposals-have-path? (items candidate input)
    (if (eq (len items) 0) 0
        (do
            (let question
                (lwo-emergent-shape
                    (lwt-proposal-candidate (head items))))
            (if (eq (lwen-question-has-path?
                        question candidate input) 1) 1
                (lwenw-proposals-have-path?
                    (tail items) candidate input)))))

(defn lwenw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwenw-sum (tail items)))))
