; jit-flow-admission-band.fk — the hottest recipe in the body is refused by the
; JIT, and the reason is a predicate that cannot admit a flow.
;
; Bit 1 is the finding: heat 506, measured on a live Qwen3.8-27B-Q8_0 turn,
; against a crystallize threshold of 5 — a hundredfold past hot — and
; jd-crystallize? answers 0, because a forward pass writes KV rows and syncs and
; is therefore impure. Not a tuning problem. The predicate has no path that a
; flow can take.
;
; Bit 512 is the other half, and the two must not be confused: even a predicate
; that admitted flows would change nothing today, because the Metal lane never
; asks. jd-crystallize? is consulted only from observe/ cells. A law that only
; spectators consult decides nothing.
;
; PURITY IS NOT WEAKENED — bit 64. Every pure-path answer is identical before and
; after; this adds a second door, it does not widen the first.
;
; PROOF LEVEL: pure arithmetic and list folds over jit-decision.fk, which is
; itself four-way. No host organ, no GPU, no file organ. A candidate for a
; four-arm run; NOT claimed as one — that surface is source_jit_gate's. What is
; witnessed below is the fkwu arm.
;
; Verdict 1023:
;   1     the measured forward recipe (heat 506) is REFUSED today
;   2     and it is refused for impurity, not for lack of heat
;   4     admitted once the artifact carries its own ordering
;   8     ordering is a contract, not a flag: all three properties required
;   16    unordered effects still refuse — the boundary stays honest
;   32    a cold flow is not admitted; heat still has to be earned
;   64    the pure path is untouched, answer for answer
;   128   melting is unchanged, so hysteresis still holds
;   256   generic: the same answer on mlx, metal and cpu from one predicate
;   512   the hot path never asks — the Metal lane names no jd-, jit, crystallize
;
; preludes: form-stdlib/core.fk form-stdlib/jit-decision.fk
; preludes: form-stdlib/jit-flow-admission.fk
; witnessed: 2026-08-24 -> 1023 on fkwu; measured forward heat 506, refused

(do
    (defn jfab-bit (ok bit) (if ok bit 0))
    (defn jfab-has? (s needle) (if (ge (str_find s needle 0) 0) 1 0))

    ; the Metal lane's own source, read to see whether it asks anything
    (let metal-src (read_file "form/native/metal/qwen35-dense-token-handle.fk"))

    (let b0 (jfab-bit (eq (jfa-refused-today) 0) 1))
    ; refused for impurity, not heat: the same heat WITH purity is admitted
    (let b1 (jfab-bit (and (eq (jd-crystallize? (jfa-measured-forward-heat) 0) 0)
                      (and (eq (jd-crystallize? (jfa-measured-forward-heat) 1) 1)
                           (gt (jfa-measured-forward-heat) (jfa-heat-threshold)))) 2))
    (let b2 (jfab-bit (eq (jfa-admitted-as-flow) 1) 4))
    ; ordering is a contract: drop any one property and it is not ordered
    (let b3 (jfab-bit (and (eq (jfa-ordered? 1 1 1) 1)
                      (and (eq (jfa-ordered? 0 1 1) 0)
                           (and (eq (jfa-ordered? 1 0 1) 0)
                                (eq (jfa-ordered? 1 1 0) 0)))) 8))
    ; effects that cannot state their ordering still refuse, however hot
    (let b4 (jfab-bit (and (eq (jfa-crystallize? 9999 0 0) 0)
                           (eq (jfa-crystallize? (jfa-measured-forward-heat) 0 0) 0)) 16))
    ; heat is still earned — a cold flow is not admitted
    (let b5 (jfab-bit (and (eq (jfa-crystallize? 1 0 1) 0)
                      (and (eq (jfa-crystallize? 4 0 1) 0)
                           (eq (jfa-crystallize? 5 0 1) 1))) 32))
    ; the pure path is untouched, answer for answer
    (let b6 (jfab-bit (and (eq (jfa-crystallize? 6 1 0) (jd-crystallize? 6 1))
                      (and (eq (jfa-crystallize? 3 1 0) (jd-crystallize? 3 1))
                           (eq (jfa-crystallize? 6 0 0) (jd-crystallize? 6 0)))) 64))
    ; melting unchanged, so the hysteresis that stops thrashing still holds
    (let b7 (jfab-bit (and (eq (jfa-melt? 1) (jd-melt? 1))
                      (and (eq (jfa-melt? 9) (jd-melt? 9))
                           (gt (jfa-heat-threshold) 1))) 128))
    ; generic: one predicate, the same answer on every backend
    (let b8 (jfab-bit (and (eq (jfa-backend-count) 3)
                      (and (eq (jfa-all-backends 506 1) (jfa-backend-count))
                           (eq (jfa-all-backends 506 0) 0))) 256))
    ; and the hot path never asks any of it
    (let b9 (jfab-bit (and (eq (jfab-has? metal-src "jd-crystallize?") 0)
                      (and (eq (jfab-has? metal-src "jd-melt?") 0)
                           (gt (str_len metal-src) 0))) 512))

    (add b0 (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 b9))))))))))
