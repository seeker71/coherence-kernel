; living-world-expression-blueprint-mapping-observation.fk -- bounded causal
; view of recurrent symbol and ordering evidence; no surface payload is emitted.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk form-stdlib/tests/living-world-expression-blueprint-witness.fk

(do
    (let symbol-world (lwxbw-symbol-world))
    (let mapping-round (lwxbw-mapping-round))
    (let mapping-a
        (lwo-emergent-shape (lwxbw-mapping-candidate-a)))
    (let mapping-b
        (lwo-emergent-shape (lwxbw-mapping-candidate-b)))
    (let uncertainty-a (lwr-mapping-uncertainty mapping-a))
    (let uncertainty-b (lwr-mapping-uncertainty mapping-b))
    (list
        (lwo-field-size (lwt-round-proposals (lwxbw-symbol-round)))
        (lwsl-integrated-current? symbol-world (lwxbw-left))
        (lwsl-integrated-current? symbol-world (lwxbw-primary))
        (lwsl-integrated-current? symbol-world (lwxbw-right))
        (lwsl-integrated-current? symbol-world (lwxbw-alternate))
        (lwo-field-size (lwr-proposals (lwxbw-zero-world) 2))
        (lwo-field-size (lwr-proposals (lwxbw-one-world) 2))
        (lwo-field-size (lwt-round-proposals mapping-round))
        (lwo-field-size (lwr-mapping-supports mapping-a))
        (lwo-field-size (lwr-mapping-counterexamples mapping-a))
        (lwr-uncertainty-counterexamples uncertainty-a)
        (lwr-uncertainty-ambiguous uncertainty-a)
        (lwr-uncertainty-unused-source uncertainty-a)
        (lwo-field-size (lwr-mapping-supports mapping-b))
        (lwo-field-size (lwr-mapping-counterexamples mapping-b))
        (lwr-uncertainty-counterexamples uncertainty-b)
        (lwr-uncertainty-ambiguous uncertainty-b)
        (lwr-uncertainty-unused-source uncertainty-b)
        (if (node_eq (lwxbw-mapping-candidate-a)
                (lwxbw-mapping-candidate-b)) 0 1)
        (lwo-active? (lwxbw-mapping-world)
            (lwxbw-mapping-candidate-a))
        (lwo-active? (lwxbw-mapping-world)
            (lwxbw-mapping-candidate-b))))
