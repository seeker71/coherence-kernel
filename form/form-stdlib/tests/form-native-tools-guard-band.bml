; form-native-tools-guard-band.bml — JSON text does not creep back onto the coding lane's tool-call path.
; preludes: form-stdlib/bml/form-token-grammar.bml
; Verdict 7
; REQUIRES: the checkout's sources, read from the working directory (run from the repository root).
;
; The census (observe/native-tools-census-run.bml, 2026-10-08) counted, per file of the model <-> tool path, the places
; that write or read JSON as text: json-emit(, parse-json(, faj-json(, faj-valid(. Those counts are the ceilings here.
; A file may use fewer; a new site fails this band by count. A site that stays carries guidance on the
; function that holds it: `json-serves: <who>. text: <why these bytes are cheaper than sharing the cell>`.
; The who is the reader who does not hold the cell. An unnamed site is named here as guidance. It does not refuse the tree.
;     1  the call path itself is free of JSON text: the tool control (form-token-tool.bml), the verbs and the lane's
;        session door hold none
;     2  every file of the lane stays at or under its census ceiling. Unnamed text sites are printed as guidance.
;     4  the lane teaches the control table's own call: the tool verb is a stream verb, dispatched by the grammar,
;        its cell is the one constructor the lane's fcap-native-tool uses, and the contract's nine are still nine
section [form.bml] {
 class FormNativeToolsGuardBand {
  def nt-dir() = "form/form-stdlib/bml/";
  def nt-needles() = ["json-emit(", "parse-json(", "faj-json(", "faj-valid("];
  def nt-count-in(text, needle) = len(split-on(text, needle)) - 1;
  def nt-sites(file) {
   let text = read_file(nt-dir() ++ file ++ ".bml") ?? "";
   foldl((acc, n) => acc + nt-count-in(text, n), 0, nt-needles());
  }
  // [file, ceiling]: a tool call is the cell. A JSON tool reply is not read. Role replies, the request door and guard evidence still speak JSON.
  def nt-ceilings() = [["form-cli-code-policy", 47], ["form-cli-code-live", 7], ["form-cli-code-swerve", 7], ["form-cli-code-turn-guard", 6], ["form-cli-code-session", 0], ["form-cli-code-memory", 14], ["form-cli-code-request", 19], ["form-cli-code-circle", 18], ["form-token-grammar", 3], ["form-token-verbs", 0], ["form-token-tool", 0], ["form-token-tool-spell", 0], ["form-agent-tools", 10], ["form-agent-tool-wire", 3]];
  def nt-bit1() = all?(f => nt-sites(f) == 0, ["form-token-tool", "form-token-tool-spell", "form-token-verbs", "form-cli-code-session"]) ? 1 : 0;
  def nt-drop-ws(s) = len(s) == 0 ? s : (substring(s, 0, 1) == " " || substring(s, 0, 1) == "\t") ? nt-drop-ws(substring(s, 1, len(s))) : s;
  def nt-def-name(line) {
   let t = nt-drop-ws(line);
   if !(str_find(t, "def ", 0) == 0) then "" else {
    let rest = substring(t, 4, len(t));
    let at = str_find(rest, "(", 0);
    at < 0 ? "" : substring(rest, 0, at);
   };
  }
  def nt-serves?(line) = str_find(line, "json-serves:", 0) >= 0 && str_find(line, " text:", 0) >= 0;
  def nt-needle-line?(line) = any?(n => str_find(line, n, 0) >= 0, nt-needles());
  def nt-step(state, line) {
   let pending = state[0]; let armed = state[1]; let name = state[2]; let bad = state[3]; let missing = state[4];
   let serves = nt-serves?(line);
   let defn = nt-def-name(line);
   if defn != "" then [0, serves || pending, defn, nt-needle-line?(line) && (serves || pending) == 0, bad ? append(missing, [name]) : missing] else {
    let now = serves ? 1 : armed;
    [serves ? 1 : pending, now, name, bad || (nt-needle-line?(line) && now == 0), missing];
   };
  }
  def nt-unasked(file) {
   let end = foldl(nt-step, [0, 0, "", 0, []], split-on(read_file(nt-dir() ++ file ++ ".bml") ?? "", "\n"));
   end[3] && end[2] != "" ? append(end[4], [end[2]]) : end[4];
  }
  def nt-join(names) = nil?(names) ? "" : names[0] ++ (nil?(names[1:]) ? "" : " " ++ nt-join(names[1:]));
  def nt-ceiling-ok(c) {
   let n = nt-sites(c[0]);
   if n <= c[1] then 1 else { print_str(c[0] ++ " " ++ n.str() ++ " over " ++ c[1].str()); 0; };
  }
  def nt-guide(c) {
   let names = nt-unasked(c[0]);
   if nil?(names) then 0 else print_str(c[0] ++ " guidance: name who reads this text, and why the bytes are the cheaper share: " ++ nt-join(names));
  }
  def nt-bit2() = { map(nt-guide, nt-ceilings()); all?(nt-ceiling-ok, nt-ceilings()) ? 2 : 0; };
  def nt-bit4() {
   let grammar = read_file(nt-dir() ++ "form-token-grammar.bml") ?? "";
   let policy = read_file(nt-dir() ++ "form-cli-code-policy.bml") ?? "";
   let dispatched = str_find(grammar, "verb == \"tool\" then ftt-call(session, payload)", 0) >= 0;
   let one = str_find(policy, "def fcap-native-tool(tool,args,input) = ftt-action(tool,args,input);", 0) >= 0;
   dispatched && one && ftg-verb?("tool") && len(ftg-verbs()) == 9 ? 4 : 0;
  }
  def nt-run() = nt-bit1() + nt-bit2() + nt-bit4();
 }
 nt-run();
}
