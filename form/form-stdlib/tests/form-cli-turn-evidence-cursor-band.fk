; form-cli-turn-evidence-cursor-band.fk — BML cursor discovery is private,
; scannerless, and terminal in one Form call.
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk
; preludes: form-stdlib/form-cli-turn-evidence.fk
; preludes: form-stdlib/form-cli-turn-evidence-live.fk
; preludes: form-stdlib/bml/form-cli-turn-evidence-cursor.bml

(do
    (defn fctecb-bit (ok bit) (if ok bit 0))
    (let path "/tmp/form-cli-turn-evidence-cursor-band.jsonl")
    (let turn1 "{\"timestamp\":\"t1\",\"type\":\"event_msg\",\"payload\":{\"type\":\"task_complete\",\"turn_id\":\"turn-1\"}}\n")
    (let turn2 "{\"timestamp\":\"t2\",\"type\":\"event_msg\",\"payload\":{\"type\":\"task_complete\",\"turn_id\":\"turn-2\"}}\n")
    (let wrote (write_file_text path (str_concat turn1 turn2)))
    (let all (fctec-seek path "" (file_size path)))
    (let first (fctec-seek path "turn-1" (file_size path)))
    (let absent (fctec-seek path "turn-missing" (file_size path)))
    (let src (read_file "form/form-stdlib/bml/form-cli-turn-evidence-cursor.bml"))
    (sum (list
        (fctecb-bit (eq (fctec-result? all) 1) 1)
        (fctecb-bit (and (eq (fctec-found? all) 1)
            (str_eq (fctec-turn-id-at path (fctec-at all)) "turn-2")) 2)
        (fctecb-bit (and (eq (fctec-found? first) 1)
            (str_eq (fctec-turn-id-at path (fctec-at first)) "turn-1")) 4)
        (fctecb-bit (and (eq (fctec-found? absent) 0)
            (and (eq (fctec-at absent) -1)
                (eq (fctec-end absent) 0))) 8)
        (fctecb-bit (str_eq (fctec-rule)
            "scannerless-backward-cursor-runs-to-terminal-in-one-form-call") 16)
        (fctecb-bit (str_eq (fctec-privacy-rule)
            "only-coordinates-turn-id-and-status-leave-the-reader") 32)
        (fctecb-bit (and (ge (str_find src "section [form.bml]" 0) 0)
            (and (ge (str_find src "fctec-seek" 0) 0)
                (eq (str_find src "xtal" 0) -1))) 64))))
