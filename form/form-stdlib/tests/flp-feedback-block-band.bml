; flp-feedback-block-band.bml — the planner's repair block carries the whole refusal (form-cli-local-plan.bml, flp-feedback-block).
;
; Empty feedback stays silent. A refusal carries the exact observation, the candidate with every byte kept, and the
; guidance that the next choice keeps what was verified.
;
; Expected: 7
; Verdict 7 when every claim lands:
;   1   empty feedback, and feedback that is only space, answers ""
;   2   a refusal carries the observation byte for byte
;   4   a candidate longer than 6000 bytes is carried whole, and the block names what to keep
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/form-cli-local-plan.bml
section [form.bml] {
 class FlpFeedbackBlockBand {
  def ffb-long() = foldl((acc, i) => acc ++ "x", "", range(0, 6001));
  def ffb-c-empty(ctx) = (String) flp-feedback-block("", "prior") == "" && (String) flp-feedback-block("   ", "prior") == "";
  def ffb-c-exact(ctx) {
   let feedback = "band read 0\nexact";
   let block = flp-feedback-block(feedback, "");
   str_find(block, feedback, 0) >= 0 && (String) substring(block, str_find(block, feedback, 0), str_find(block, feedback, 0) + len(feedback)) == feedback;
  }
  def ffb-c-whole(ctx) {
   let prior = ffb-long();
   let block = flp-feedback-block("refused", prior);
   str_find(block, prior, 0) >= 0 && str_find(block, "Preserve verified components", 0) >= 0 && str_find(block, "actual native callee declarations", 0) >= 0;
  }
 }
 let verdict = live-claims("flp-feedback-block-band", 0, [["empty", 1, 1, ffb-c-empty], ["exact", 2, 1, ffb-c-exact], ["whole", 4, 1, ffb-c-whole]]);
 verdict;
}
