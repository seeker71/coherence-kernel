; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk form-stdlib/jit-crystallize.fk
;
; jit-crystallize-band — the JIT MECHANISM proven: crystallize-on-heat with a
; NodeID-keyed native cache and champion-challenger dispatch, as a Form composite
; (jit-crystallize.fk), running form-lower's bytes on hardware through nat_run.
;
; The JIT is TOTAL by strategy (jc-strategy): 0 direct-lower, 1 store-as-cell, 2
; inject-bl (unbuilt). Coverage is never a refusal — only a choice of route. Purity
; returns in its CORRECT role: the precondition for store-as-cell (memoizing a value),
; not a JIT gate — an effectful const still direct-lowers so its effect fires each call.
;
; f(n)=n*3+7, g(n)=n-1 (arg-dependent -> direct-lower) · a const 3+4=7 (pure const ->
; store-as-cell) · a bare (read_file) (effectful const -> direct-lower) · ARG+tag99
; (uncovered, arg-dependent -> inject-bl).
;
; Verdict 63 when the whole lifecycle holds:
;   1  HEAT: f walks 4x (tag 0), the 5th call crystallizes (tag 1), the 6th dispatches
;      native from cache (tag 2)
;   2  PARITY: the native challenger reproduces the walker champion — f native at
;      n = 10, 0, 7 gives 37, 7, 28
;   4  MELT: cooled below threshold, the native is evicted and the call walks again
;   8  CACHE-BY-KEY: f and g cache separately, neither shadowing the other
;   16 STORE-AS-CELL: a pure const recipe crystallizes via the cell route to its value (7),
;      dispatching native — and the cell native is strictly SHORTER than direct-lowering the
;      same recipe (extensionally equal, fewer bytes)
;   32 STRATEGY IS TOTAL: jc-strategy routes every recipe — direct-lower(0) for arg-dependent
;      covered f and for the effectful const, store-as-cell(1) for the pure const, inject-bl(2)
;      for the uncovered arg-dependent recipe. Never a refusal, only a route.
(do
    (let progf (list (list 1 7) (list 2) (list 1 3) (list 5 1 2) (list 3 3 0)))
    (let progg (list (list 2) (list 1 1) (list 4 0 1)))
    (let progc (list (list 1 3) (list 1 4) (list 3 0 1)))
    (let progio (list (list 10)))
    (let proguncov (list (list 2) (list 99 0 0)))

    (let s0 (jc-empty))
    (let a1 (jc-call progf 10 37 s0)) (let s1 (nth a1 1))
    (let a2 (jc-call progf 10 37 s1)) (let s2 (nth a2 1))
    (let a3 (jc-call progf 10 37 s2)) (let s3 (nth a3 1))
    (let a4 (jc-call progf 10 37 s3)) (let s4 (nth a4 1))
    (let a5 (jc-call progf 10 37 s4)) (let s5 (nth a5 1))
    (let a6 (jc-call progf 10 37 s5)) (let s6 (nth a6 1))
    (let c0 (if (and (eq (nth a1 2) 0) (and (eq (nth a2 2) 0) (and (eq (nth a3 2) 0) (and (eq (nth a4 2) 0) (and (eq (nth a5 2) 1) (eq (nth a6 2) 2)))))) 1 0))

    (let p10 (jc-call progf 10 37 s6))
    (let p0 (jc-call progf 0 7 s6))
    (let p7 (jc-call progf 7 28 s6))
    (let c1 (if (and (eq (nth p10 0) 37) (and (eq (nth p0 0) 7) (eq (nth p7 0) 28))) 2 0))

    (let sc (jc-cool progf s6 6))
    (let am (jc-call progf 10 37 sc))
    (let c2 (if (eq (nth am 2) 0) 4 0))

    (let sf (jc-warm progf 10 37 (jc-empty) 5))
    (let sfg (jc-warm progg 10 9 sf 5))
    (let df (jc-call progf 10 37 sfg))
    (let dg (jc-call progg 10 9 sfg))
    (let c3 (if (and (eq (nth df 2) 2) (and (eq (nth df 0) 37) (and (eq (nth dg 2) 2) (eq (nth dg 0) 9)))) 8 0))

    (let cst (jc-warm progc 999 7 (jc-empty) 5))
    (let dc (jc-call progc 999 7 cst))
    (let celllen (len (jc-emit progc 7 1)))
    (let directlen (len (lo-compile-fn progc 2)))
    (let c4 (if (and (eq (nth dc 2) 2) (and (eq (nth dc 0) 7) (lt celllen directlen))) 16 0))

    (let c5 (if (and (eq (jc-strategy progf) 0)
                (and (eq (jc-strategy progc) 1)
                (and (eq (jc-strategy progio) 0)
                     (eq (jc-strategy proguncov) 2)))) 32 0))

    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
