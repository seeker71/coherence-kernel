; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk form-stdlib/jit-crystallize.fk
;
; jit-crystallize-band — the JIT MECHANISM proven: crystallize-on-heat with a
; NodeID-keyed native cache and champion-challenger dispatch, as a Form composite
; (jit-crystallize.fk), running form-lower's bytes on hardware through nat_run. The
; loop is byte-source-agnostic; form-lower is the sovereign plugin at the jc-crystallize
; seam. This is the JIT proper (host-kernel.form: "JIT IS one running composite"),
; distinct from form-lower — which just fills the door.
;
; The purity signal is DERIVED from the recipe (jc-pure? over form-lower's op-tags),
; not passed in: pure ops 1 LIT 2 ARG 3 ADD 4 SUB 5 MUL 6 COND 8 DIV 9 STREQ; the
; host-io ops 10 READ_FILE and 11 WRITE_FILE lower to syscalls and are effectful.
;
; f(n) = n*3+7 · g(n) = n-1 (pure) · a bare (read_file) recipe (effectful, tag 10).
;
; Verdict 31 when the whole lifecycle holds:
;   1  HEAT: f walks 4x (tag 0), then the 5th call crystallizes (tag 1), the 6th
;      dispatches native from cache (tag 2) — the hysteresis threshold earns it
;   2  PARITY: the native challenger reproduces the walker champion — f dispatched
;      native at n = 10, 0, 7 gives 37, 7, 28
;   4  MELT: cooled below threshold, the native is evicted and the call walks again
;   8  CACHE-BY-KEY: two distinct recipes cache separately — after both crystallize,
;      f dispatches native to 37 AND g dispatches native to 9, neither shadowing the other
;   16 PURITY DERIVED (the signal, closed): jc-pure? reads purity off the recipe —
;      f is pure, the read_file recipe is impure — and the impure recipe never
;      crystallizes even when hot, with NO purity flag passed anywhere
(do
    (let progf (list (list 1 7) (list 2) (list 1 3) (list 5 1 2) (list 3 3 0)))
    (let progg (list (list 2) (list 1 1) (list 4 0 1)))
    (let progio (list (list 10)))

    (let s0 (jc-empty))
    (let a1 (jc-call progf 10 37 s0)) (let s1 (nth a1 1))
    (let a2 (jc-call progf 10 37 s1)) (let s2 (nth a2 1))
    (let a3 (jc-call progf 10 37 s2)) (let s3 (nth a3 1))
    (let a4 (jc-call progf 10 37 s3)) (let s4 (nth a4 1))
    (let a5 (jc-call progf 10 37 s4)) (let s5 (nth a5 1))
    (let a6 (jc-call progf 10 37 s5)) (let s6 (nth a6 1))
    (let c0 (if (and (eq (nth a1 2) 0) (and (eq (nth a2 2) 0) (and (eq (nth a3 2) 0) (and (eq (nth a4 2) 0) (and (eq (nth a5 2) 1) (eq (nth a6 2) 2)))))) 1 0))

    (let p10 (jc-call progf 10 37 s6))
    (let p0 (jc-call progf 0 7 s6))
    (let p7 (jc-call progf 7 28 s6))
    (let c1 (if (and (eq (nth p10 0) 37) (and (eq (nth p0 0) 7) (eq (nth p7 0) 28))) 2 0))

    (let sc (jc-cool progf s6 6))
    (let am (jc-call progf 10 37 sc))
    (let c2 (if (eq (nth am 2) 0) 4 0))

    (let sf (jc-warm progf 10 37 (jc-empty) 5))
    (let sfg (jc-warm progg 10 9 sf 5))
    (let df (jc-call progf 10 37 sfg))
    (let dg (jc-call progg 10 9 sfg))
    (let c3 (if (and (eq (nth df 2) 2) (and (eq (nth df 0) 37) (and (eq (nth dg 2) 2) (eq (nth dg 0) 9)))) 8 0))

    (let si (jc-warm progio 0 0 (jc-empty) 6))
    (let ai (jc-call progio 0 0 si))
    (let c4 (if (and (eq (jc-pure? progf) 1) (and (eq (jc-pure? progio) 0) (eq (nth ai 2) 0))) 16 0))

    (add c0 (add c1 (add c2 (add c3 c4)))))
