; Form tensor recipes on native Metal. Behavior and refusals travel together.
; preludes: form-stdlib/native-tensor.bml
; Verdict 63.
; preludes: form-stdlib/core.fk form-stdlib/native-tensor-derived.fk

(do
    (defn msb-score (ok bit) (if ok bit 0))
    (defn msb-has (hay needle) (if (lt (str_find hay needle 0) 0) 0 1))
    (defn msb-live? () (msb-has (nt-status) "metal_linked=true"))
    (defn msb-declined? (prog)
        (nt-refused prog "stack underflow"))
    (defn native-tensor-softmax-band ()
        (do
    (let c0 (msb-score (eq (msb-live?) 1) 1))
    (let c1 (msb-score (if (eq (msb-live?) 1)
                           (eq (nt-eval (mld-j "v3 1 2 3 f32" (mld-j (mld-softmax) "sum i32"))) 1) 0) 2))
    (let c2 (msb-score (if (eq (msb-live?) 1)
                           (eq (nt-eval (mld-j "v3 1 2 3 f32" (mld-j (mld-softmax) "sum 1000 mul i32"))) 1000) 0) 4))
    (let c3 (msb-score (if (eq (msb-live?) 1)
                           (eq (nt-eval (mld-j "v2 40 0 r2 1 2 f32 v4 1 0 0 1 r2 2 2 f32 matmul" (mld-j (mld-softmax) "v2 100 0 r2 2 1 f32 matmul i32"))) 100) 0) 8))
    (let c4 (msb-score (if (eq (msb-live?) 1)
                           (eq (nt-eval (mld-j "v2 0 0 r2 1 2 f32 v4 1 0 0 1 r2 2 2 f32 matmul" (mld-j (mld-softmax) "v2 10 30 r2 2 1 f32 matmul i32"))) 20) 0) 16))
    (let c5 (msb-score (if (eq (msb-live?) 1)
                           (if (eq (nt-eval "2 3 add") 5)
                               (if (msb-declined? (mld-j (mld-softmax) "sum i32"))
                                   (if (eq (nt-eval "v3 1 2 3 r2 1 3 f32 v3 4 5 6 r2 3 1 f32 matmul i32") 32) 1 0) 0) 0) 0) 32))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
    )
    (native-tensor-softmax-band))
