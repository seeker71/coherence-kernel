; native-model-resident-fleet-band.fk — retain-until-pressure and honest
; eviction grain for simultaneously available local models.
;
; preludes: form-stdlib/core.fk form-stdlib/native-model-resident-fleet.bml
;
; Verdict 8191: 4095 executable + 4096 high-BML authority.

(do
    (defn nmrft-has (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let dual (nmrf-dual-resident 101 202))
    (let rows (nmrf-rows dual))
    (let total (add (NMRFQwenBytes) (NMRFThreeBBytes)))
    (let c0 (if (eq (nmrf-loaded-count rows) 2) 1 0))
    (let c1 (if (eq (nmrf-prefilled-count rows) 2) 2 0))
    (let c2 (if (eq (nmrf-resident-bytes rows) total) 4 0))
    (let c3 (if (eq (nmrf-can-admit? (nmrf-default) total) 1) 8 0))
    (let no-pressure (nmrf-pressure-plan dual 0 (list)))
    (let c4 (if (and (str_eq (nth no-pressure 0) "native-model-pressure-plan") (eq (len (nth no-pressure 3)) 0)) 16 0))
    (let packed (nmrf-unit "qwen" "expert-shard" 1000 0 0 0 0))
    (let least-expert (nmrf-unit "future-split-qwen" "expert-shard" 600 1 3 0 1))
    (let least-kv (nmrf-unit "qwen" "kv-substate" 900 0 1 0 1))
    (let active-model (nmrf-unit "3b" "inactive-model" 2000 0 0 1 1))
    (let units (list packed least-kv active-model least-expert))
    (let low-use (nmrf-unit "low-use" "kv-substate" 10 0 99 0 1))
    (let high-use (nmrf-unit "high-use" "kv-substate" 10 1 1 0 1))
    (let older (nmrf-unit "older" "kv-substate" 10 1 2 0 1))
    (let newer (nmrf-unit "newer" "kv-substate" 10 1 3 0 1))
    (let c5 (if (and (str_eq (nmrf-unit-owner (nmrf-eviction-next units)) "future-split-qwen")
                     (and (str_eq (nmrf-unit-owner (nmrf-eviction-next (list high-use low-use))) "low-use")
                          (str_eq (nmrf-unit-owner (nmrf-eviction-next (list newer older))) "older"))) 32 0))
    (let pressure-fleet (nmrf-fleet (NMRFDefaultBudget) 500 3 rows))
    (let plan (nmrf-pressure-plan pressure-fleet 0 units))
    (let c6 (if (and (str_eq (nth plan 0) "native-model-pressure-plan") (str_eq (nmrf-unit-grain (head (nth plan 3))) "expert-shard")) 64 0))
    (let c7 (if (eq (nmrf-unit-valid-eviction? packed) 0) 128 0))
    (let c8 (if (eq (nmrf-unit-valid-eviction? active-model) 0) 256 0))
    (let refused (nmrf-observe-loaded (nmrf-default) "x" "dense" 10 0 0))
    (let c9 (if (str_eq (nth refused 0) "native-model-residence-refused") 512 0))
    (let observed (nmrf-observe-loaded (nmrf-default) "x" "dense" 10 55 0))
    (let observed-fleet (nmrf-observe-loaded-fleet observed))
    (let c10 (if (and (eq (nmrf-loaded-count (nmrf-rows observed-fleet)) 1) (eq (nmrf-handle (head (nmrf-rows observed-fleet))) 55)) 1024 0))
    (let touched (nmrf-touch dual "challenger.qwen38-flash-next-q2-metal"))
    (let touched-qwen (nmrf-find "challenger.qwen38-flash-next-q2-metal" (nmrf-rows touched)))
    (let c11 (if (and (eq (nmrf-clock touched) 4) (and (eq (nmrf-uses touched-qwen) 3) (eq (nmrf-last-used touched-qwen) 4))) 2048 0))
    (let base (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11)))
    (let src (read_file "form/form-stdlib/bml/native-model-resident-fleet.bml"))
    (let authority (if (eq (nmrft-has src "const String RetainRule = \"a physical model remains resident and keeps its prefix until measured pressure requires reclamation\"") 1)
        (if (eq (nmrft-has src "const String EvictionRule = \"expert-shard grain precedes KV or substate, which precedes inactive whole-model; within one grain lower use-count precedes older last-use; active units are excluded\"") 1)
            (if (eq (nmrft-has src "const String MoERule = \"only independently mapped experts may be evicted; packed expert tensors remain indivisible\"") 1)
                (if (eq (nmrft-has src "const String AccessRule = \"every physical model evaluation advances the fleet clock and refreshes that model access age without releasing any handle\"") 1) 4096 0) 0) 0) 0))
    (add base authority))
