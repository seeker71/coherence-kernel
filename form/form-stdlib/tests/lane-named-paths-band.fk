; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk
;
; lane-named-paths-band — every path the GPU lanes NAME must exist.
;
; On 2026-09-09 a grep found eighty script paths named across this tree's cells and SIXTY-FOUR of them
; absent — including all twelve `scripts/metal_*_audit.sh` parity gates that the tensor emitters cite
; as the thing proving their arithmetic on silicon. Cells had been citing gates that are not in this
; checkout, in prose, for as long as the prose has existed. Nothing failed, because a citation is not
; executed; it is READ, and a reader who sees a gate named stops asking whether one exists. That is the
; same shape as the carrier header claiming nine Form ops it did not have: an overclaim does not fail
; loudly, it CLOSES THE QUESTION.
;
; So this band walks the GPU-lane cells with the body's own `fs-read-text`, extracts every `scripts/…`
; path they name, and demands each one exist. It is deliberately narrow — the metal and tensor-emit
; cells, not the whole tree — because a band that goes red for sixty-four absences in eleven
; subsystems teaches nobody anything, while one that holds a lane at zero can be kept at zero.
;
; WHAT IT DOES NOT DO, named: it reads `scripts/` paths only. A cell can also name a band, a receipt or
; a `.fk` that is not there, and this does not see those yet. The narrow claim is the honest one.
;
; Verdict 15:
;    1  the lane's cells read
;    2  jit-tensor-emit.fk names NO absent scripts/ path — its twelve metal_*_audit.sh citations were
;       repointed at the live bands that now do that work, and the CUDA pair is marked absent in place
;    4  no emit band under form-stdlib/tests names an absent scripts/ path
;    8  THE CHECK CAN FAIL: a path this band knows to be absent is still absent, so bit 2's green is a
;       reading and not a broken extractor quietly matching nothing
;
(do
    (defn lnp-has? (hay needle) (if (lt (str_find hay needle 0) 0) 0 1))

    ; every "scripts/..." run in `s` from index i, checked for existence; counts the absent ones
    (defn lnp-end (s i)
        (if (ge i (str_len s)) i
            (do (let b (str_byte_at s i))
                (if (or (and (ge b 97) (le b 122))
                    (or (and (ge b 48) (le b 57))
                    (or (eq b 95) (or (eq b 46) (eq b 47))))) (lnp-end s (add i 1)) i))))
    (defn lnp-scan (s i n)
        (do (let j (str_find s "scripts/" i))
            (if (lt j 0) n
                (do (let e (lnp-end s j))
                    (let p (substring s j e))
                    (if (lnp-has? p ".sh")
                        (if (eq (fs-exists? p) 1) (lnp-scan s e n) (lnp-scan s e (add n 1)))
                        (lnp-scan s e n))))))
    (defn lnp-absent (path)
        (do (let t (fs-read-text path))
            (if (nothing? t) (sub 0 1) (lnp-scan t 0 0))))

    (defn lnp-dir () "form/form-stdlib/tests")
    (defn lnp-ends-with? (s p)
        (if (lt (str_len s) (str_len p)) 0
            (if (str_eq (substring s (sub (str_len s) (str_len p)) (str_len s)) p) 1 0)))
    (defn lnp-walk (names n)
        (if (eq (len names) 0) n
            (do (let f (head names))
                ; the CUDA band is the control for bit 8 and is excluded here: it names a script that is
                ; absent BY DESIGN on a host with no NVIDIA GPU, so counting it would make bit 4 and
                ; bit 8 the same claim pulling in opposite directions.
                (if (or (eq (lnp-ends-with? f "emit-band.fk") 0)
                        (str_eq f "jit-tensor-cuda-emit-band.fk")) (lnp-walk (tail names) n)
                    (do (let a (lnp-absent (fs-path-join (lnp-dir) f)))
                        (lnp-walk (tail names) (add n (if (lt a 0) 0 a))))))))

    (let emit (lnp-absent "form/form-stdlib/jit-tensor-emit.fk"))
    (let c0 (if (ge emit 0) 1 0))
    (let c1 (if (eq emit 0) 2 0))
    (let entries (fs-list (lnp-dir)))
    (let bands (if (nothing? entries) (sub 0 1) (lnp-walk entries 0)))
    (let c2 (if (eq bands 0) 4 0))
    ; the extractor must be able to SEE an absence, or bit 2 is a green from a scanner that found
    ; nothing to look at. scripts/cuda_matvec_audit.sh is named in jit-tensor-cuda-emit-band and is
    ; genuinely not here — no CUDA gate and no CUDA GPU in this checkout — so it is the live control.
    (let ctl (lnp-absent "form/form-stdlib/tests/jit-tensor-cuda-emit-band.fk"))
    (let c3 (if (gt ctl 0) 8 0))

    (add c0 (add c1 (add c2 c3))))
