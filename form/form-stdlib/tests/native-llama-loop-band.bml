; native-llama-loop-band.bml — the voice's loop witness reads a loop whose copies differ only where a
; counter ticks (`factorial908`, `factorial909`, …), still reads exact and re-wrapped copies, and does not
; call distinct numbered lines a loop.
;
; Verdict 63
//
// preludes: form-stdlib/core.fk form-stdlib/native-llama-voice.bml form-stdlib/bml/live.bml
section [form.bml] {
 class LoopBand {
  def lb-copy(k) = "factorial" ++ int_to_str(k) ++ ": (n) => { if (n == 0) 1 else n * factorial" ++ int_to_str(k) ++ "(n - 1) },\n";
  def lb-run(k, n) = n <= 0 ? "" : lb-copy(k) ++ lb-run(k + 1, n - 1);
  def lb-counter(ctx) = nlg-stuck(lb-run(908, 2), lb-copy(910));
  def lb-carry(ctx) = nlg-stuck("", lb-run(998, 4));
  def lb-exact(ctx) = nlg-stuck("", "the cat sat on the mat. the cat sat on the mat. the cat sat on the mat. ");
  def lb-wrapped(ctx) = nlg-stuck("", "Alpha beta gamma delta epsilon\nalpha  BETA gamma delta epsilon\nALPHA beta gamma delta epsilon");
  def lb-steps(ctx) = nlg-stuck("", "Step 1: parse the file. Step 2: read the header. Step 3: write the output.");
  def lb-rows(ctx) = nlg-stuck("", "row 1 holds alpha and beta\nrow 2 holds gamma and delta\nrow 3 holds epsilon and zeta\n");
 }
 live-claims("native-llama-loop-band", 0, list(list("counter", 1, 1, lb-counter), list("carry", 2, 1, lb-carry), list("exact", 4, 1, lb-exact), list("wrapped", 8, 1, lb-wrapped), list("steps", 16, 0, lb-steps), list("rows", 32, 0, lb-rows)));
}
