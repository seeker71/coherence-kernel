; rounding-ops-band — floor, ceil, trunc and round answer from their Form home on every kernel.
;
; The band carries no prelude line: each call reaches form-stdlib/bml/rounding-ops.bml by
; name through form-stdlib/home-index.txt, which every kernel reads the same way. fkwu runs
; its C arms for floor, ceil and round, bound to those bodies by content; Go, Rust and TS walk
; the bodies. Every bit holds on each kernel.
;
; Verdict 255 when every claim lands:
;   1   floor: 2.7 -> 2, -2.5 -> -3, -0.5 -> -1, 7 -> 7
;   2   ceil: 2.1 -> 3, -2.5 -> -2, 0.5 -> 1, -7 -> -7
;   4   trunc: 2.9 -> 2, -2.9 -> -2, -7 -> -7
;   8   round, half away from zero: 2.5 -> 3, -2.5 -> -3, 1.4 -> 1, -7 -> -7
;   16  round adds the half before it truncates: 0.49999999999999994 lands on 1
;   32  math_floor and math_ceil answer as floor and ceil
;   64  a whole float far from zero passes exactly: floor 4503599627370497.0, ceil -1e15-0.5
;   128 a zero of either sign lands on 0 in all four
;
; Expected: 255
(do
    (let c0 (if (and (eq (floor 2.7) 2) (and (eq (floor -2.5) -3) (and (eq (floor -0.5) -1) (eq (floor 7) 7)))) 1 0))
    (let c1 (if (and (eq (ceil 2.1) 3) (and (eq (ceil -2.5) -2) (and (eq (ceil 0.5) 1) (eq (ceil -7) -7)))) 2 0))
    (let c2 (if (and (eq (trunc 2.9) 2) (and (eq (trunc -2.9) -2) (eq (trunc -7) -7))) 4 0))
    (let c3 (if (and (eq (round 2.5) 3) (and (eq (round -2.5) -3) (and (eq (round 1.4) 1) (eq (round -7) -7)))) 8 0))
    (let c4 (if (eq (round 0.49999999999999994) 1) 16 0))
    (let c5 (if (and (eq (math_floor -0.5) -1) (eq (math_ceil 0.5) 1)) 32 0))
    (let c6 (if (and (eq (floor 4503599627370497.0) 4503599627370497) (eq (ceil -1000000000000000.5) -1000000000000000)) 64 0))
    (let c7 (if (and (eq (floor 0.0) 0) (and (eq (ceil -0.0) 0) (and (eq (round -0.0) 0) (eq (trunc 0.0) 0)))) 128 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
