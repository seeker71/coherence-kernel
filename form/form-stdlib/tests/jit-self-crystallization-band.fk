; The JIT compiler observes and crystallizes its own comparison-condition
; selector, retains it under a structural NodeID, and runs it through the native
; in-memory carrier.  No duplicate condition map exists here: source values come
; from calling lo-cmp-skip itself.  Fourth-arm band: jit_leaf_inram is the carrier.
; Verdict 2047.
;
; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk form-stdlib/jit-self-crystallization.fk

(do
    (defn jsscb-bit (ok bit) (if ok bit 0))
    (defn jsscb-agree (h i bad)
        (if (ge i (len (jssc-handle-values h))) bad
            (jsscb-agree h (add i 1)
                (add bad (if (eq (jssc-apply h i)
                                 (nth (jssc-handle-values h) i)) 0 1)))))
    (defn jsscb-native-routes (h i bad)
        (if (ge i (len (jssc-handle-values h))) bad
            (jsscb-native-routes h (add i 1)
                (add bad (if (str_eq (nth (jssc-route h i) 0) "native") 0 1)))))
    (defn jsscb-selector-agree (h requested tag bad)
        (if (ge tag 19) bad
            (jsscb-selector-agree h requested (add tag 1)
                (add bad (if (eq (jssc-lo-cmp-skip-at h requested tag)
                                 (lo-cmp-skip tag)) 0 1)))))
    (defn jit-self-shape-crystallization-band ()
        (do (let h (jssc-lo-cmp-skip-birth))
            (let h2 (jssc-lo-cmp-skip-birth))
            (let changed (jssc-birth (cons 9 (tail (jssc-lo-cmp-values)))))
            (let c0 (jsscb-bit (jssc-handle? h) 1))
            (let c1 (jsscb-bit (eq (jssc-handle-carrier-live? h) 1) 2))
            (let c2 (jsscb-bit (eq (jsscb-agree h 0 0) 0) 4))
            (let c3 (jsscb-bit (eq (jsscb-native-routes h 0 0) 0) 8))
            (let c4 (jsscb-bit (node_eq (jssc-handle-identity h)
                                        (jssc-handle-identity h2)) 16))
            (let c5 (jsscb-bit (not (node_eq (jssc-handle-identity h)
                                             (jssc-handle-identity changed))) 32))
            (let c6 (jsscb-bit (str_eq (nth (jssc-route h 5) 0) "nothing") 64))
            (let c7 (jsscb-bit (nothing? (jssc-apply h 5)) 128))
            (let c8 (jsscb-bit (nothing? (jssc-birth (empty))) 256))
            (let c9 (jsscb-bit (eq (jssc-apply h 4)
                                    (jssc-interpreted h 4)) 512))
            (let c10 (jsscb-bit
                (and (eq (jsscb-selector-agree h (jssc-handle-identity h) 0 0) 0)
                     (and (str_eq (nth (jssc-route-at h
                                        (jssc-handle-identity changed) 2) 0)
                                  "refused")
                          (nothing? (jssc-apply-at h
                                      (jssc-handle-identity changed) 2)))) 1024))
            (add c0 (add c1 (add c2 (add c3 (add c4 (add c5
                (add c6 (add c7 (add c8 (add c9 c10))))))))))))
    (jit-self-shape-crystallization-band))
