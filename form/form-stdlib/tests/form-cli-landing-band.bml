; form-cli-landing-band.bml — the landing door reads its witness's exit, and a red witness holds the landing; its git
; steps are argv children whose exits the host answers.
; Verdict 16383
; PROOF LEVEL: FOURTH-ARM ONLY (host_spawn_at and host_wait run each child; no sibling kernel carries them)
;
; Each claim asks the readers and steps of form-stdlib/bml/form-cli-landing.bml, never ld-land itself: no claim adds,
; commits or pushes in this checkout (git runs only over scratch repositories under temp_dir). The witnesses are tiny
; shell commands spawned by the landing's own carrier (ld-witness-at), with their evidence under temp_dir.
;     1  a witness that exits 0 reads exit 0, and it holds nothing
;     2  a witness that exits 3 reads exit 3, and it holds the landing
;     4  a witness that prints the mark itself and then exits 5 reads 5: the exit is the host's, never a printed line
;     8  no witness named holds nothing
;    16  a launch host_spawn_at refused at birth has no exit, and holds the landing
;    32  with everything else ready, a red witness is the reason held, and the [landing] line names its exit
;    64  of a present tracked file and a path that is neither present nor tracked, only the present one is
;        addable, and the other is named unstaged: one unmatched pathspec would make git add stage nothing
;   128  a path that is neither present nor tracked reads untracked (git ls-files answers it nothing)
;   256  in a scratch repository under temp_dir, two tracked files removed from the tree (one named café.txt,
;        which git's own listing would quote) read tracked in the spelling they were named, an untracked absent
;        path does not, and git add of the two stages both removals
;   512  forty paths stage through --pathspec-from-file in a scratch repository: past the 32 words an argv holds
;  1024  forty tracked files removed from the tree read tracked, chunked under the argv cap; a path git tracks as a
;        directory reads tracked; a path with glob characters is a literal one
;  2048  in a scratch origin: the commit, the push and the push of main each say their own exit, a push main
;        refused reads behind, a restart puts the branch on origin/main, and a restart whose fetch fails stops there
;  4096  the census counts what a child costs: host_wait, host_capture and host_spawn_quiet are registered as
;        local-process rows with tags no other row holds, and a child reaped inside a window moves that plane
;  8192  a path is literal, never a glob: in a scratch repository holding f2.txt and a file named f[0-9]*.txt, adding
;        the path "f[0-9]*.txt" stages that one file and not f2.txt (git add without --literal-pathspecs stages both)
// preludes: form-stdlib/bml/form-cli-landing.bml
section [form.bml] {
 class LandingBand {
  def lnb-claim(ok, bit) = ok ? bit : 0;
  def lnb-rc(run) = run[1];
  def lnb-is?(rc, n) = (!nothing?(rc)) && ((Comparable) rc == n);
  def lnb-has?(s, part) = str_find(s, part, 0) >= 0;
  def lnb-git(root, repo, args) = hch-git-in(root ++ "/io", repo, "band", args);
  def lnb-lines(run) = len(filter(l => (Comparable) len(l) > 0, split-on(run[1], "\n")));
  def lnb-staged(root, repo, kind) = len(filter(l => (Comparable) len(l) > 0 && (String) substring(l, 0, 1) == kind, split-on(lnb-git(root, repo, ["diff", "--cached", "--name-status"])[1], "\n")));
  def lnb-seed(root, repo, names) {
   let made = host_dir_mkdir(repo);
   let init = lnb-git(root, repo, ["init", "-q", "."]);
   let wrote = foldl((acc, name) => write_file_text(repo ++ "/" ++ name, name), 0, names);
   let added = lnb-git(root, repo, ["add", "."]);
   lnb-git(root, repo, ["-c", "user.name=band", "-c", "user.email=band@localhost", "commit", "-qm", "seed"]);
  }
  def lnb-remove-all(repo, names) = foldl((acc, name) => host_path_remove(repo ++ "/" ++ name), 0, names);
  def lnb-names(n) = n <= 0 ? [] : append(lnb-names(n - 1), ["f" ++ (n < 10 ? "0" : "") ++ n.str() ++ ".txt"]);
 }
 let root = temp_dir() ++ "/landing-band-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str();
 let made = host_dir_mkdir(root);
 let io = root ++ "/io";
 let green = ld-witness-at(io, "/bin/sh", "true");
 let red = ld-witness-at(io, "/bin/sh", "exit 3");
 let spoof = ld-witness-at(io, "/bin/sh", "printf '[witness] exit=0\\n'; exit 5");
 let none = ld-witness-at(io, "/bin/sh", "");
 let refused = ld-witness-at(io, "/no/such/shell", "true");
 let why = ld-held-why(false, true, 0, ["CURRENT_FLOOR.md"], "a subject", false, false, false);
 let line = ld-landing-line(why, lnb-rc(red));
 let c1 = lnb-claim(lnb-is?(lnb-rc(green), 0) && ld-witness-ok?("true", lnb-rc(green)), 1);
 let c2 = lnb-claim(lnb-is?(lnb-rc(red), 3) && (!ld-witness-ok?("exit 3", lnb-rc(red))), 2);
 let c4 = lnb-claim(lnb-is?(lnb-rc(spoof), 5) && (!ld-witness-ok?("spoof", lnb-rc(spoof))) && lnb-has?(spoof[0], "[witness] exit=0\n\n[witness] exit=5\n"), 4);
 let c8 = lnb-claim(nothing?(lnb-rc(none)) && ld-witness-ok?("", lnb-rc(none)), 8);
 let c16 = lnb-claim(nothing?(lnb-rc(refused)) && (!ld-witness-ok?("true", lnb-rc(refused))) && lnb-has?(refused[0], "the launch was refused at birth") && lnb-has?(refused[0], "(-4)"), 16);
 let c32 = lnb-claim(((String) why == "the-witness-refused") && ((String) line == "held: the witness refused (exit 3)"), 32);
 let gone = "form/form-stdlib/tests/no-such-landing-path-" ++ host_pid().str() ++ ".txt";
 let named = ["CURRENT_FLOOR.md", gone];
 let addable = ld-addable-in(io, ".", named);
 let c64 = lnb-claim(((Comparable) len(addable) == 1) && ((String) addable[0] == "CURRENT_FLOOR.md") && ((String) ld-unstaged-line(ld-unstaged(named, addable)) == "[paths] neither present nor tracked, left unstaged: " ++ gone ++ "\n"), 64);
 let c128 = lnb-claim(nil?(ld-tracked-in(io, ".", [gone])) && nil?(ld-tracked-in(io, ".", [])), 128);
 let repo = root ++ "/two";
 let seeded = lnb-seed(root, repo, ["gone.txt", "café.txt"]);
 let removed = lnb-remove-all(repo, ["gone.txt", "café.txt"]);
 let tracked = ld-tracked-in(io, repo, ["gone.txt", "café.txt", "never.txt"]);
 let staged = ld-add-at(io, repo, root ++ "/two.paths", tracked);
 let c256 = lnb-claim(hch-ok?(seeded) && ((Comparable) len(tracked) == 2) && ((String) tracked[0] == "gone.txt") && ((String) tracked[1] == "café.txt") && ((Comparable) lnb-staged(root, repo, "D") == 2), 256);
 let many = lnb-names(40);
 let bulk = root ++ "/bulk";
 let seededBulk = host_dir_mkdir(bulk);
 let initBulk = lnb-git(root, bulk, ["init", "-q", "."]);
 let wroteBulk = foldl((acc, name) => write_file_text(bulk ++ "/" ++ name, name), 0, many);
 let stagedBulk = ld-add-at(io, bulk, root ++ "/bulk.paths", many);
 let c512 = lnb-claim(((Comparable) len(many) == 40) && ((Comparable) lnb-staged(root, bulk, "A") == 40) && (!lnb-has?(stagedBulk, "fatal")), 512);
 let big = root ++ "/big";
 let seededBig = lnb-seed(root, big, many);
 let dirs = host_dir_mkdir(big ++ "/sub");
 let wroteSub = write_file_text(big ++ "/sub/inner.txt", "inner");
 let addedSub = lnb-git(root, big, ["add", "sub/inner.txt"]);
 let committedSub = lnb-git(root, big, ["-c", "user.name=band", "-c", "user.email=band@localhost", "commit", "-qm", "sub"]);
 let wroteGlob = write_file_text(big ++ "/f[0-9]*.txt", "glob");
 let removedBig = lnb-remove-all(big, many);
 let removedDir = host_dir_rmdir(big ++ "/sub");
 let trackedBig = ld-tracked-in(io, big, append(many, ["sub", "sub/", "f*.txt", "nope.txt"]));
 let c1024 = lnb-claim(hch-ok?(seededBig) && ((Comparable) len(trackedBig) == 42) && ((String) trackedBig[0] == "f01.txt") && ((String) trackedBig[39] == "f40.txt") && ((String) trackedBig[40] == "sub") && ((String) trackedBig[41] == "sub/"), 1024);
 let origin = root ++ "/origin.git";
 let initOrigin = lnb-git(root, root, ["init", "-q", "--bare", "origin.git"]);
 let work = root ++ "/work";
 let cloned = lnb-git(root, root, ["clone", "-q", "origin.git", "work"]);
 let wroteWork = write_file_text(work ++ "/a.txt", "a");
 let addedWork = ld-add-at(io, work, root ++ "/work.paths", ["a.txt"]);
 let message = root ++ "/message.txt";
 let wroteMessage = write_file_text(message, "band subject\n\nband body\n");
 let committed = ld-commit-at(io, work, message);
 let pushed = ld-push-at(io, work, "band-push", "[push]", ["push", "-u", "origin", "HEAD"]);
 let mained = ld-push-at(io, work, "band-main", "[main]", ["push", "origin", "HEAD:main"]);
 let unmessaged = ld-commit-at(io, work, root ++ "/no-message.txt");
 let other = root ++ "/other";
 let clonedOther = lnb-git(root, root, ["clone", "-q", "origin.git", "other"]);
 let onMain = lnb-git(root, other, ["checkout", "-q", "-B", "main", "origin/main"]);
 let wroteOther = write_file_text(other ++ "/b.txt", "b");
 let addedOther = ld-add-at(io, other, root ++ "/other.paths", ["b.txt"]);
 let wroteOtherMessage = write_file_text(root ++ "/other-message.txt", "other\n");
 let committedOther = ld-commit-at(io, other, root ++ "/other-message.txt");
 let mainedOther = ld-push-at(io, other, "band-other", "[main]", ["push", "origin", "HEAD:main"]);
 let wroteAhead = write_file_text(work ++ "/c.txt", "c");
 let addedAhead = ld-add-at(io, work, root ++ "/work.paths", ["c.txt"]);
 let committedAhead = ld-commit-at(io, work, message);
 let behind = ld-push-at(io, work, "band-behind", "[main]", ["push", "origin", "HEAD:main"]);
 let restarted = ld-restart-at(io, work, "origin/main");
 let headWork = trim(lnb-git(root, work, ["rev-parse", "HEAD"])[1]);
 let headOrigin = trim(lnb-git(root, work, ["rev-parse", "origin/main"])[1]);
 let broken = lnb-git(root, work, ["remote", "set-url", "origin", root ++ "/no-such-origin.git"]);
 let before = trim(lnb-git(root, work, ["rev-parse", "HEAD"])[1]);
 let stopped = ld-restart-at(io, work, "origin/main");
 let after = trim(lnb-git(root, work, ["rev-parse", "HEAD"])[1]);
 let c2048 = lnb-claim(lnb-has?(committed, "[commit] exit=0 ") && lnb-has?(committed, "band subject") && lnb-has?(pushed, "[push] exit=0") && lnb-has?(mained, "[main] exit=0") && lnb-has?(unmessaged, "[commit] exit=") && (!lnb-has?(unmessaged, "[commit] exit=0")) && lnb-has?(mainedOther, "[main] exit=0") && lnb-has?(behind, "[main] exit=1") && ld-behind?(behind) && ((Comparable) len(headWork) > 0) && ((String) headWork == headOrigin) && ((Comparable) len(filter(l => (Comparable) len(l) > 0, split-on(restarted, "\n"))) == 3) && lnb-has?(stopped, "(exit ") && ((Comparable) len(filter(l => (Comparable) len(l) > 0, split-on(stopped, "\n"))) == 1) && ((String) before == after), 2048);
 let rows = fmrc-registry();
 let window = fmrc-open("band", "child reaped", "form-cli-landing-band", 1, 1);
 let reaped = hch-run-in(io, "census", ["/usr/bin/true"], "", nothing());
 let result = fmrc-close(window, "ok", "form-cli-landing-band", 2, 1);
 let c4096 = lnb-claim(((Comparable) fmrc-registry-unique?() == 1) && ((Comparable) fmrc-delta-has?(fmrc-result-deltas(result), "host_wait") == 1) && ((Comparable) fmrc-delta-plane-total(fmrc-result-deltas(result), "local-process") >= 1) && ((Comparable) fmrc-has-tag-go(rows, 156) == 1) && ((Comparable) fmrc-has-tag-go(rows, 159) == 1) && ((Comparable) fmrc-has-tag-go(rows, 161) == 1), 4096);
 let lit = root ++ "/lit";
 let seededLit = host_dir_mkdir(lit);
 let initLit = lnb-git(root, lit, ["init", "-q", "."]);
 let wroteLit = foldl((acc, name) => write_file_text(lit ++ "/" ++ name, name), 0, ["f2.txt", "f[0-9]*.txt"]);
 let stagedLit = ld-add-at(io, lit, root ++ "/lit.paths", ["f[0-9]*.txt"]);
 let namesLit = lnb-git(root, lit, ["diff", "--cached", "--name-only"])[1];
 let c8192 = lnb-claim(((Comparable) lnb-lines(lnb-git(root, lit, ["diff", "--cached", "--name-only"])) == 1) && lnb-has?(namesLit, "f[0-9]*.txt") && (!lnb-has?(namesLit, "f2.txt")) && (!lnb-has?(stagedLit, "fatal")), 8192);
 let swept = host_dir_rmdir(root);
 print_str("form-cli-landing-band claims " ++ c1.str() ++ " " ++ c2.str() ++ " " ++ c4.str() ++ " " ++ c8.str() ++ " " ++ c16.str() ++ " " ++ c32.str() ++ " " ++ c64.str() ++ " " ++ c128.str() ++ " " ++ c256.str() ++ " " ++ c512.str() ++ " " ++ c1024.str() ++ " " ++ c2048.str() ++ " " ++ c4096.str() ++ " " ++ c8192.str());
 c1 + c2 + c4 + c8 + c16 + c32 + c64 + c128 + c256 + c512 + c1024 + c2048 + c4096 + c8192;
}
