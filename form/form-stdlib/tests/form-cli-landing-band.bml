; form-cli-landing-band.bml — the landing door reads its witness's exit, and a red witness holds the landing.
; Verdict 511
; PROOF LEVEL: FOURTH-ARM ONLY (host-exec runs each witness; no sibling kernel carries it)
;
; Each claim asks the witness reader of form-stdlib/bml/form-cli-landing.bml, never ld-land itself: no
; claim adds, commits or pushes. The witnesses are tiny shell commands run through the landing's own
; carrier (ld-witness-run).
;     1  a witness that exits 0 reads exit 0, and it holds nothing
;     2  a witness that exits 3 reads exit 3, and it holds the landing
;     4  a witness that prints the mark itself and then exits 5 reads 5: the exit is read after the last mark
;     8  no witness named holds nothing
;    16  a launch that vanished (host-exec answered nothing) has no exit, and holds the landing
;    32  with everything else ready, a red witness is the reason held, and the [landing] line names its exit
;    64  of a present tracked file and a path that is neither present nor tracked, only the present one is
;        addable, and the other is named unstaged: one unmatched pathspec would make git add stage nothing
;   128  a path that is neither present nor tracked reads untracked (git ls-files answers it nothing)
;   256  in a scratch repository under temp_dir, two tracked files removed from the tree (one named café.txt,
;        which git's own listing would quote) read tracked in the spelling they were named, an untracked absent
;        path does not, and git add of the two stages both removals
// preludes: form-stdlib/bml/form-cli-landing.bml
section [form.bml] {
 class LandingBand {
  def lnb-claim(ok, bit) = ok ? bit : 0;
  def lnb-rc(run) = run[1];
  def lnb-is?(rc, n) = (!nothing?(rc)) && ((Comparable) rc == n);
 }
 let green = ld-witness-run("true");
 let red = ld-witness-run("exit 3");
 let spoof = ld-witness-run("printf '[witness] exit=0\\n'; exit 5");
 let none = ld-witness-run("");
 let vanished = ld-witness-read(nothing());
 let why = ld-held-why(false, true, 0, ["CURRENT_FLOOR.md"], "a subject", false, false, false);
 let line = ld-landing-line(why, lnb-rc(red));
 let c1 = lnb-claim(lnb-is?(lnb-rc(green), 0) && ld-witness-ok?("true", lnb-rc(green)), 1);
 let c2 = lnb-claim(lnb-is?(lnb-rc(red), 3) && (!ld-witness-ok?("exit 3", lnb-rc(red))), 2);
 let c4 = lnb-claim(lnb-is?(lnb-rc(spoof), 5) && (!ld-witness-ok?("spoof", lnb-rc(spoof))), 4);
 let c8 = lnb-claim(nothing?(lnb-rc(none)) && ld-witness-ok?("", lnb-rc(none)), 8);
 let c16 = lnb-claim(nothing?(lnb-rc(vanished)) && (!ld-witness-ok?("true", lnb-rc(vanished))), 16);
 let c32 = lnb-claim(((String) why == "the-witness-refused") && ((String) line == "held: the witness refused (exit 3)"), 32);
 let gone = "form/form-stdlib/tests/no-such-landing-path-" ++ host_pid().str() ++ ".txt";
 let named = ["CURRENT_FLOOR.md", gone];
 let addable = ld-addable(named);
 let c64 = lnb-claim(((Comparable) len(addable) == 1) && ((String) addable[0] == "CURRENT_FLOOR.md") && ((String) ld-unstaged-line(ld-unstaged(named, addable)) == "[paths] neither present nor tracked, left unstaged: " ++ gone ++ "\n"), 64);
 let c128 = lnb-claim(nil?(ld-tracked([gone])) && nil?(ld-tracked([])), 128);
 let repo = temp_dir() ++ "/landing-band-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str();
 let made = host-exec("mkdir -p " ++ ld-quote(repo) ++ " && cd " ++ ld-quote(repo) ++ " && git init -q . && printf a > gone.txt && printf b > 'café.txt' && git add . && git -c user.name=band -c user.email=band@localhost commit -qm seed && rm gone.txt 'café.txt' && echo made", "") ?? "";
 let tracked = ld-tracked-in(repo, ["gone.txt", "café.txt", "never.txt"]);
 let staged = host-exec("cd " ++ ld-quote(repo) ++ " && git add " ++ str-join-with(ld-quoted(tracked), " ") ++ " && git diff --cached --name-status | grep -c '^D'", "") ?? "";
 let swept = host_dir_rmdir(repo);
 let c256 = lnb-claim(((String) trim(made) == "made") && ((Comparable) len(tracked) == 2) && ((String) tracked[0] == "gone.txt") && ((String) tracked[1] == "café.txt") && ((String) trim(staged) == "2"), 256);
 print_str("form-cli-landing-band claims " ++ c1.str() ++ " " ++ c2.str() ++ " " ++ c4.str() ++ " " ++ c8.str() ++ " " ++ c16.str() ++ " " ++ c32.str() ++ " " ++ c64.str() ++ " " ++ c128.str() ++ " " ++ c256.str());
 c1 + c2 + c4 + c8 + c16 + c32 + c64 + c128 + c256;
}
