  def lnb-mkdirs(repo, names) = foldl((acc, n) => host_dir_mkdir(repo ++ "/" ++ n), 0, names);
  def lnb-read(path) = read_file(path) ?? "";
  def lnb-page(rows) = "<h1>ladder</h1>\nrows: " ++ rows ++ "\nend\n";
  def lnb-remove-all(repo, names) = foldl((acc, name) => host_path_remove(repo ++ "/" ++ name), 0, names);
  def lnb-names(n) = n <= 0 ? [] : append(lnb-names(n - 1), ["f" ++ (n < 10 ? "0" : "") ++ n.str() ++ ".txt"]);
 }
