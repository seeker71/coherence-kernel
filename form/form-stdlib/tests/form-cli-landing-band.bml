  def lnb-rc(run) = run[1];
  def lnb-is?(rc, n) = (!nothing?(rc)) && ((Comparable) rc == n);
  def lnb-has?(s, part) = str_find(s, part, 0) >= 0;
  def lnb-git(root, repo, args) = hch-git-in(root ++ "/io", repo, "band", args);
  def lnb-lines(run) = len(filter(l => (Comparable) len(l) > 0, split-on(run[1], "\n")));
  def lnb-staged(root, repo, kind) = len(filter(l => (Comparable) len(l) > 0 && (String) substring(l, 0, 1) == kind, split-on(lnb-git(root, repo, ["diff", "--cached", "--name-status"])[1], "\n")));
