; form-cli-landing-band.bml — the landing door reads its witness's exit, and a red witness holds the landing; its git
; steps are argv children whose exits the host answers.
; Verdict 524287
; REQUIRES: child processes (host_spawn_at and host_wait run each child)
;
; Each claim asks the readers and steps of form-stdlib/bml/form-cli-landing.bml, never ld-land itself: no claim adds,
; commits or pushes in this checkout (git runs only over scratch repositories under temp_dir). The witnesses are tiny
; shell commands spawned by the landing's own carrier (ld-witness-at), with their evidence under temp_dir.
;     1  a witness that exits 0 reads exit 0, and it holds nothing
;     2  a witness that exits 3 reads exit 3, and it holds the landing
;     4  a witness that prints the mark itself and then exits 5 reads 5: the exit is the host's, never a printed line
;     8  no witness named holds nothing
;    16  a launch host_spawn_at refused at birth has no exit, and holds the landing
;    32  with everything else ready, a red witness is the reason held, and the [landing] line names its exit
;    64  of a present tracked file and a path that is neither present nor tracked, only the present one is
;        addable, and the other is named left out: one unmatched pathspec would make git add stage nothing. In a real
;        scratch origin, a landing named a path that does not stand, one git ignores, a tracked file removed and a
;        changed file lands the last two, publishes them, says "landed; left out: <path> (does not stand), <path>
;        (ignored by git)", and hands its verification none of the paths it left out. A landing named a folder publishes the
;        files under it, and one an earlier landing left staged under it is the landing's own (ld-owns?), never another
;        owner's path that holds it
;   128  a path that is neither present nor tracked reads untracked (git ls-files answers it nothing)
;   256  in a scratch repository under temp_dir, two tracked files removed from the tree (one named café.txt,
;        which git's own listing would quote) read tracked in the spelling they were named, an untracked absent
;        path does not, and git add of the two stages both removals
;   512  forty paths stage through --pathspec-from-file in a scratch repository: past the 32 words an argv holds
;  1024  forty tracked files removed from the tree read tracked, chunked under the argv cap; a path git tracks as a
;        directory reads tracked; a path with glob characters is a literal one
;  2048  in a scratch origin: the commit, the push and the push of main each say their own exit, a push main
;        refused reads behind, a restart puts the branch on origin/main, and a restart whose fetch fails stops there
;  4096  the census counts what a child costs: host_wait, host_capture and host_spawn_quiet are registered as
;        local-process rows with tags no other row holds, and a child reaped inside a window moves that plane
;  8192  a path is literal, never a glob: in a scratch repository holding f2.txt and a file named f[0-9]*.txt, adding
;        the path "f[0-9]*.txt" stages that one file and not f2.txt (git add without --literal-pathspecs stages both)
; 16384  the reunion after a push behind origin (form-cli-reunion.bml, argv by directory), in a scratch origin: a landing
;        commit that conflicts with main on the drawn page and on a river is joined (the river by union, each row once in
;        order; the page remade through the redraw door, a stub argv here, into the landing's own commit) and pushed
;        ("[push] exit=0 after the reunion", one commit ahead of main); a landing that conflicts on mod.bml, a file the
;        body does not know, keeps both banks under .form-heal/reunion-unlearned, aborts the rebase, stands where it stood
;        and reads "the rows did not join"; the keep path is absolute, and the redraw runs in the checkout (its stub's
;        paths are relative)
; 32768  a rebase git refuses with nothing unmerged (an unstaged change in the checkout) says what git said ("the rebase
;        was refused: ... unstaged ..."), keeps no banks, leaves the branch where it stood and reads "did not join"
; 65536  the side taken for a conflicting page is main's: with a redraw that changes nothing (`true`), the page that
;        stands after the reunion is main's bytes, never the landing's
;131072  the default wiring (fcr-reunion(): the checkout "." and the cell observe/rent-ladder-page-run.bml) in a
;        scratch checkout: a child kernel run in that directory (env -C: this band spawns a kernel on purpose, because what
;        is under test is the directory the process stands in, and a process cannot change its own) drives it with a stub
;        cell there that records that it ran in the scratch checkout; the page it drew stands in the landing's commit,
;        one ahead of main, pushed. The scratch checkout links this checkout's form/ and runtime/ (a kernel lowers from
;        the directory it runs in), and its observe/rent-ladder-page-run.bml is the stub. The lowering finds the root's tokens
;        through the owner's own path (bml-source-repo-prefix, form-stdlib/bml-source.fk): read directly here, so a
;        checkout not named form sees it too, the root is above the form/ or learn/ nearest the file, whatever the path
;        above the checkout holds.
;262144  native publication: ld-publish-in commits the owned path, verifies it twice, publishes the branch and main in
;        one atomic push, sets unrelated work aside and restores it, a repeat publishes the same commit with no stash
;        or private publication ref left, and the rented-work meter counts two usage transitions. With no route to
;        origin (a real git fetch against a closed local port) the landing is the stage "local": verified, its commit
;        on the branch, the origin unreached, the unrelated work restored, "landed locally (offline: ...); the carry
;        pushes it next time"; with the route back the same request publishes that commit. A fetch that failed for any
;        other reason (an origin that is not there) stays attention, naming git's own words. A landing reads the own band
;        of each code file its own commit touched and each named band whose writable file it touched over the tree that
;        lands, its full the pin its head names, a band a gate row ran answered by the gate's want, and the commit it
;        publishes carries each reading as a Band-Witness trailer naming that tree, a short queued one also as read over the
;        tree the commit stands on (a band in the checkout reads its parent's text there), all inside the body's own trailer
;        block, so its co-author still reads as a trailer and stays last; a band whose files it did not touch is not read,
;        a repeat publishes the same commit, the parent's worktree is gone, and a commit a remote already holds, main or the
;        branch alone, is never rewritten by a later landing under the same subject
// preludes: form-stdlib/bml/form-cli-landing.bml
import form-stdlib/bml/rented-work.bml;
import form-stdlib/bml-source.fk;
section [form.bml] {
 class LandingBand {
  def lnb-claim(ok, bit) = ok ? bit : 0;
  def lnb-rc(run) = run[1];
  def lnb-is?(rc, n) = (!nothing?(rc)) && ((Comparable) rc == n);
  def lnb-has?(s, part) = str_find(s, part, 0) >= 0;
  def lnb-git(root, repo, args) = hch-git-in(root ++ "/io", repo, "band", args);
  def lnb-lines(run) = len(filter(l => (Comparable) len(l) > 0, split-on(run[1], "\n")));
  def lnb-staged(root, repo, kind) = len(filter(l => (Comparable) len(l) > 0 && (String) substring(l, 0, 1) == kind, split-on(lnb-git(root, repo, ["diff", "--cached", "--name-status"])[1], "\n")));
  def lnb-seed(root, repo, names) {
   let made = host_dir_mkdir(repo);
   let init = lnb-git(root, repo, ["init", "-q", "."]);
   let wrote = foldl((acc, name) => write_file_text(repo ++ "/" ++ name, name), 0, names);
   let added = lnb-git(root, repo, ["add", "."]);
   lnb-git(root, repo, ["-c", "user.name=band", "-c", "user.email=band@localhost", "commit", "-qm", "seed"]);
  }
  def lnb-write-all(repo, pairs) = foldl((acc, p) => write_file_text(repo ++ "/" ++ p[0], p[1]), 0, pairs);
  def lnb-mkdirs(repo, names) = foldl((acc, n) => host_dir_mkdir(repo ++ "/" ++ n), 0, names);
  def lnb-read(path) = read_file(path) ?? "";
  def lnb-page(rows) = "<h1>ladder</h1>\nrows: " ++ rows ++ "\nend\n";
  def lnb-remove-all(repo, names) = foldl((acc, name) => host_path_remove(repo ++ "/" ++ name), 0, names);
  def lnb-publication-check(s,moved) {
   let runs=fhn-count(ld-state(s),"verification_runs");
   ld-set(s,"verification_runs",json-node-int(runs + 1));
   let peer=fhn-text(ld-field(s,"request"),"peer");
   if runs == 0 then {
    write_file_text(peer + "/peer.txt","main advanced during publication");
    hch-git-in(ld-text(s,"io"),peer,"peer-add",["add","peer.txt"]);
    hch-git-in(ld-text(s,"io"),peer,"peer-commit",["commit","-qm","concurrent main"]);
    hch-git-in(ld-text(s,"io"),peer,"peer-push",["push","-q","origin","HEAD:main"]);
   } else 0;
   !nil?(moved);
  }
  def lnb-usage-row(sample) = jv-emit(jv-object([jv-s("timestamp",sample[0]),jv-s("type","event_msg"),jv-pair("payload",jv-object([jv-s("type","token_count"),jv-pair("info",jv-object([jv-pair("total_token_usage",ru-object(sample[1]))]))]))])) + "\n";
  def lnb-names(n) = n <= 0 ? [] : append(lnb-names(n - 1), ["f" ++ (n < 10 ? "0" : "") ++ n.str() ++ ".txt"]);
  // the root an owner's path spells, in a checkout of any name, and the candidate it gives a token that stands at the root
  def lnb-spelled() = bml-source-repo-prefix("/a/kernel/form/form-stdlib/x.bml") == 10 && bml-source-repo-prefix("/a/form/form/form-stdlib/x.bml") == 8 && bml-source-repo-prefix("/a/form/learn/x.fk") == 8 && bml-source-repo-prefix("/a/learn/form/form-stdlib/x.fk") == 9 && bml-source-repo-prefix("observe/x.bml") == 0 && any?(c => c == "/a/form/observe/y.fk", bml-source-candidates("/a/form/form/form-stdlib/bml/x.bml", "observe/y.fk"));
  // a scratch origin with main, and a clone on its own branch: [origin, the clone]
  def lnb-pair(root, name) {
   let seed = root + "/" + name + "-seed"; let origin = root + "/" + name + "-origin.git"; let work = root + "/" + name + "-work";
   lnb-seed(root, seed, ["owned.bml", "other.txt"]);
   lnb-git(root, seed, ["branch", "-M", "main"]);
   lnb-git(root, root, ["init", "--bare", "-q", origin]);
   lnb-git(root, seed, ["remote", "add", "origin", origin]);
   lnb-git(root, seed, ["push", "-q", "origin", "main"]);
   lnb-git(root, root, ["clone", "-q", "-b", "main", origin, work]);
   lnb-git(root, work, ["config", "user.name", "native-publication-band"]);
   lnb-git(root, work, ["config", "user.email", "native@localhost"]);
   lnb-git(root, work, ["checkout", "-qb", "codex/" + name]);
   [origin, work];
  }
  def lnb-request(owner, paths) = json-node-object([fhn-s("owner", owner), fhn-s("subject", "Native publication: " + owner), fhn-n("main", 1), json-node-pair("paths", json-node-array(paths |> map(json-node-string)))]);
  def lnb-rev(root, repo, ref) = trim(lnb-git(root, repo, ["rev-parse", ref])[1]);
  def lnb-verified(s, moved) = !nil?(moved);
  // a landing's named paths: one does not stand, one git ignores, a tracked file removed, a changed file
  def lnb-left-out(root) {
   let pair = lnb-pair(root, "left");
   let origin = pair[0]; let work = pair[1];
   write_file_text(work + "/.gitignore", ".private/\n");
   host_dir_mkdir(work + "/.private");
   write_file_text(work + "/.private/witness-band.bml", "private");
   write_file_text(work + "/owned.bml", "native verified change");
   host_path_remove(work + "/other.txt");
   let seen = record_new(0, "moved", []);
   let verify = (s, moved) => { record_set(seen, "moved", moved); !nil?(moved); };
   let state = node_children(ld-publish-in(lnb-request("left-out-band", ["owned.bml", "no-such-band.bml", ".private/witness-band.bml", "other.txt"]), work, verify))[0];
   let names = lnb-git(root, work, ["show", "--name-only", "--format=", "HEAD"])[1];
   fhn-text(state, "stage") == "published" && ld-landing-said(state) == "landed; left out: no-such-band.bml (does not stand), .private/witness-band.bml (ignored by git)" && lnb-rev(root, origin, "main") == fhn-text(state, "commit") && lnb-has?(names, "owned.bml") && lnb-has?(names, "other.txt") && lnb-lines(lnb-git(root, work, ["show", "--name-only", "--format=", "HEAD"])) == 2 && !lnb-has?(record_get(seen, "moved").join(" "), "no-such-band") && !lnb-has?(record_get(seen, "moved").join(" "), "witness-band");
  }
  // a landing named a folder carries the files under it, and a file under it an earlier landing left staged is the landing's own, never another owner's
  def lnb-folder(root) {
   let pair = lnb-pair(root, "folder");
   let origin = pair[0]; let work = pair[1];
   host_dir_mkdir(work + "/answers");
   host_dir_mkdir(work + "/answers/abc");
   write_file_text(work + "/answers/abc/set.jsonl", "{\"id\":\"a\",\"answer\":\"kept\"}\n");
   write_file_text(work + "/answers/abc/earlier.jsonl", "{\"id\":\"b\",\"answer\":\"staged before\"}\n");
   lnb-git(root, work, ["add", "answers/abc/earlier.jsonl"]);
   let state = node_children(ld-publish-in(lnb-request("folder-band", ["answers"]), work, lnb-verified))[0];
   let names = lnb-git(root, work, ["show", "--name-only", "--format=", "HEAD"])[1];
   fhn-text(state, "stage") == "published" && lnb-has?(names, "answers/abc/set.jsonl") && lnb-has?(names, "answers/abc/earlier.jsonl") && lnb-rev(root, origin, "main") == fhn-text(state, "commit")
   && ld-owns?(["answers"], "answers/abc/set.jsonl") && ld-owns?(["answers/"], "answers") && !ld-owns?(["answers"], "answers-other.txt") && !ld-owns?(["answers"], "other.txt");
  }
  // the bands a landing reads: the own band of each code file its own commit touched (owned.bml's, standing in the checkout at its full, 3) and each named
  // band whose writable file it touched, read over the tree that lands, and the commit carries each reading as a Band-Witness trailer naming that tree, short
  // ones as read and read once more over the tree the commit stands on: the band in the checkout reads its parent's text there (2), the band outside it the same
  // (3). A band a gate row ran as the landing verified reads the gate's want (7), not read again (it would read 4). The witness opens the body's own trailer block,
  // so the co-author stays a trailer and stays last. A band whose files the commit did not touch is not read; a repeat publishes the same commit, and another
  // landing under the same subject that commits nothing finds main holding that commit and leaves it as it stands
  def lnb-band(path, full, files) = json-node-object([fhn-s("band", path), fhn-n("full", full), fhn-a("writable", files |> map(json-node-string))]);
  def lnb-co() = "Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>";
  def lnb-band-witness(root) {
   let pair = lnb-pair(root, "witness");
   let origin = pair[0]; let work = pair[1];
   let full = root + "/full-band.bml"; let short = root + "/short-band.bml"; let probe = work + "/probe-band.bml"; let gate = root + "/gate-band.bml";
   let own = "form/form-stdlib/tests/owned-band.bml";
   write_file_text(full, "section [form.bml] {\n 7;\n}\n");
   write_file_text(short, "section [form.bml] {\n 3;\n}\n");
   write_file_text(gate, "section [form.bml] {\n 4;\n}\n");
   write_file_text(probe, "// Verd" + "ict 7\nsection [form.bml] {\n 2;\n}\n");
   hch-mkdirs(work + "/form/form-stdlib/tests");
   write_file_text(work + "/" + own, "// Verd" + "ict 3\nsection [form.bml] {\n 3;\n}\n");
   lnb-git(root, work, ["add", "probe-band.bml", own]);
   lnb-git(root, work, ["commit", "-qm", "the probe band stands at 2, and owned.bml's own band"]);
   lnb-git(root, work, ["push", "-q", "origin", "HEAD:main"]);
   write_file_text(probe, "// Verd" + "ict 7\nsection [form.bml] {\n 5;\n}\n");
   write_file_text(work + "/owned.bml", "the voice's edit");
   let gated = (s, moved) => { ld-set(s, "verification", json-node-object([fhn-a("rows", [json-node-object([fhn-s("unit", gate), fhn-n("want", 7)])])])); !nil?(moved); };
   let request = json-node-object([fhn-s("owner", "witness-band"), fhn-s("subject", "Native publication: witness-band"), fhn-s("body", "a body\n\n" + lnb-co()), fhn-n("main", 1), json-node-pair("paths", json-node-array([json-node-string("owned.bml"), json-node-string("probe-band.bml")])), fhn-a("bands", [lnb-band(full, 7, ["owned.bml"]), lnb-band(short, 7, ["owned.bml"]), lnb-band(root + "/untouched-band.bml", 7, ["other.txt"]), lnb-band(probe, 1, ["owned.bml"]), lnb-band(gate, 7, ["owned.bml"])])]);
   let state = node_children(ld-publish-in(request, work, gated))[0];
   let tree = lnb-rev(root, origin, "main^{tree}");
   let before = lnb-rev(root, origin, "main~1^{tree}");
   let message = lnb-git(root, origin, ["log", "-1", "--format=%B", "main"])[1];
   let co = trim(lnb-git(root, origin, ["log", "-1", "--format=%(trailers:key=Co-Authored-By,valueonly)", "main"])[1]);
   let read = trim(lnb-git(root, origin, ["log", "-1", "--format=%(trailers:key=Band-Witness,valueonly,separator=%x3B)", "main"])[1]);
   let again = node_children(ld-publish-in(request, work, lnb-verified))[0];
   let other = json-node-object([fhn-s("owner", "witness-band-again"), fhn-s("subject", "Native publication: witness-band"), fhn-s("body", "another body"), fhn-n("main", 1), json-node-pair("paths", json-node-array([json-node-string("owned.bml")])), fhn-a("bands", [lnb-band(full, 7, ["owned.bml"])])]);
   let held = node_children(ld-publish-in(other, work, lnb-verified))[0];
   let lines = ["Band-Witness: " + own + " 3/3 " + tree + " owned.bml", "Band-Witness: " + full + " 7/7 " + tree + " owned.bml", "Band-Witness: " + short + " 3/7 " + tree + " owned.bml", "Band-Witness: " + short + " 3/7 " + before + " owned.bml", "Band-Witness: " + probe + " 5/7 " + tree + " owned.bml", "Band-Witness: " + probe + " 2/7 " + before + " owned.bml", "Band-Witness: " + gate + " 7/7 " + tree + " owned.bml"];
   fhn-text(state, "stage") == "published" && lnb-rev(root, origin, "main") == fhn-text(state, "commit") && len(tree) == 40 && len(before) == 40 && tree != before
   && trim(message) == "Native publication: witness-band\n\na body\n\n" + lines.join("\n") + "\n" + lnb-co()
   && co == "Claude Opus 5.5 <noreply@anthropic.com>" && read == (lines |> map(l => substring(l, 14, len(l)))).join(";")
   && !lnb-has?(message, "untouched-band") && fhn-text(again, "stage") == "published" && fhn-text(again, "commit") == fhn-text(state, "commit")
   && fhn-text(held, "stage") == "published" && fhn-text(held, "commit") == fhn-text(state, "commit") && lnb-rev(root, origin, "main") == fhn-text(state, "commit")
   && len(filter(l => lnb-has?(l, "worktree "), split-on(lnb-git(root, work, ["worktree", "list", "--porcelain"])[1], "\n"))) == 1;
  }
  // a commit a remote branch already holds is never rewritten: a landing to the branch alone, then another under the same subject with another body that
  // commits nothing, publishes the same commit, its message as it stood
  def lnb-branch-held(root) {
   let pair = lnb-pair(root, "branch-held");
   let origin = pair[0]; let work = pair[1];
   let full = root + "/branch-held-band.bml";
   write_file_text(full, "section [form.bml] {\n 7;\n}\n");
   write_file_text(work + "/owned.bml", "an edit for the branch");
   let first = json-node-object([fhn-s("owner", "branch-held"), fhn-s("subject", "Native publication: branch-held"), fhn-s("body", "the first body"), json-node-pair("paths", json-node-array([json-node-string("owned.bml")])), fhn-a("bands", [lnb-band(full, 7, ["owned.bml"])])]);
   let one = node_children(ld-publish-in(first, work, lnb-verified))[0];
   let said = lnb-git(root, origin, ["log", "-1", "--format=%B", "codex/branch-held"])[1];
   let second = json-node-object([fhn-s("owner", "branch-held-again"), fhn-s("subject", "Native publication: branch-held"), fhn-s("body", "another body"), json-node-pair("paths", json-node-array([json-node-string("owned.bml")])), fhn-a("bands", [lnb-band(full, 7, ["owned.bml"])])]);
   let two = node_children(ld-publish-in(second, work, lnb-verified))[0];
   fhn-text(one, "stage") == "published" && fhn-text(two, "stage") == "published" && fhn-text(two, "commit") == fhn-text(one, "commit")
   && lnb-rev(root, origin, "codex/branch-held") == fhn-text(one, "commit") && lnb-git(root, origin, ["log", "-1", "--format=%B", "codex/branch-held"])[1] == said && lnb-has?(said, "the first body\n\nBand-Witness: " + full + " 7/7 ");
  }
  // no route to origin: a real fetch against a closed local port, then the route back, then an origin that is not there
  def lnb-offline(root) {
   let pair = lnb-pair(root, "off");
   let origin = pair[0]; let work = pair[1];
   let before = lnb-rev(root, origin, "main");
   write_file_text(work + "/owned.bml", "changed while offline");
   write_file_text(work + "/other.txt", "unrelated local work");
   lnb-git(root, work, ["remote", "set-url", "origin", "http://127.0.0.1:9/none.git"]);
   let request = lnb-request("offline-band", ["owned.bml"]);
   let off = node_children(ld-publish-in(request, work, lnb-verified))[0];
   let said = ld-landing-said(off);
   let head = lnb-rev(root, work, "HEAD");
   let unreached = lnb-rev(root, origin, "main") == before;
   let kept = (read_file(work + "/other.txt") ?? "") == "unrelated local work";
   lnb-git(root, work, ["remote", "set-url", "origin", origin]);
   let on = node_children(ld-publish-in(request, work, lnb-verified))[0];
   let reached = lnb-rev(root, origin, "main");
   let keptOn = (read_file(work + "/other.txt") ?? "") == "unrelated local work";
   write_file_text(work + "/owned.bml", "changed with no origin");
   lnb-git(root, work, ["remote", "set-url", "origin", root + "/off-no-such.git"]);
   let gone = node_children(ld-publish-in(lnb-request("offline-gone-band", ["owned.bml"]), work, lnb-verified))[0];
   fhn-text(off, "stage") == "local" && fhn-text(off, "commit") == head && head != before && lnb-has?(said, "landed locally (offline: fatal: unable to access") && lnb-has?(said, "Failed to connect") && lnb-has?(said, "the carry pushes it next time") && unreached && kept && fhn-text(on, "stage") == "published" && fhn-text(on, "commit") == head && reached == head && keptOn && fhn-text(gone, "stage") == "attention" && lnb-has?(fhn-text(gone, "reason"), "does not appear to be a git repository");
  }
 }
 let root = temp_dir() ++ "/landing-band-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str();
 let made = host_dir_mkdir(root);
 let io = root ++ "/io";
 let green = ld-witness-at(io, "/bin/sh", "true");
 let red = ld-witness-at(io, "/bin/sh", "exit 3");
 let spoof = ld-witness-at(io, "/bin/sh", "printf '[witness] exit=0\\n'; exit 5");
 let none = ld-witness-at(io, "/bin/sh", "");
 let refused = ld-witness-at(io, "/no/such/shell", "true");
 let why = ld-held-why(false, true, 0, ["CURRENT_FLOOR.md"], "a subject", false, false, false);
 let line = ld-landing-line(why, lnb-rc(red));
