; tests/hd-core-words-band.fk — the bodygraph said inside the closed 64.
;
; preludes: form-stdlib/core.fk form-stdlib/core-lexicon.fk form-stdlib/hd-bodygraph.fk form-stdlib/hd-core-words.fk
;
; Verdict 255:
;   21 rows: nine centres, five types, seven authorities            1
;   THE CLOSURE: every token is one of the 64 or declared glue      2
;   and the outside-list is empty, which is the same claim twice    4
;   every centre the bodygraph has, this cell can say              8
;   a description renders as a sentence                           16
;   a key the cell does not carry answers nothing, never a guess  32
;   the closure is REAL: a token from outside the 64 is caught    64
;   KINDS ARE DISJOINT: "ego" and "sacral" each name a centre AND
;     an authority, and the two answer different things — the
;     collision a first draft of this cell quietly got wrong      128
(do
    (defn hcb-bit (ok w) (if ok w 0))
    (defn hd-core-words-band ()
        (do
            (let c0 (hcb-bit (eq (hcw-row-count) 21) 1))
            (let c1 (hcb-bit (eq (hcw-closed?) 1) 2))
            (let c2 (hcb-bit (eq (hcw-outside-count) 0) 4))
            (let c3 (hcb-bit (eq (hcw-covers-centres?) 1) 8))
            (let c4 (hcb-bit (str_eq (hcw-sentence (hcw-k-centre) "throat") "you say what you know") 16))
            (let c5 (hcb-bit (nothing? (hcw-say (hcw-k-centre) "no-such-centre")) 32))
            ; the checker must actually reject: "sacral" is HD jargon, not a core word
            (let c6 (hcb-bit (and (eq (hcw-grounded? "know") 1)
                                  (eq (hcw-grounded? "sacral") 0)) 64))
            (let c7 (hcb-bit (and (eq (hcw-kinds-disjoint?) 1)
                             (and (str_eq (hcw-sentence (hcw-k-authority) "ego")
                                          "I want it and I do it")
                                  (not (str_eq (hcw-sentence (hcw-k-centre) "ego")
                                               (hcw-sentence (hcw-k-authority) "ego"))))) 128))
            (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
    (hd-core-words-band))
