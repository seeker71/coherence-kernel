; living-world-expression-blueprint-application-observation.fk -- bounded
; held-out application and all-optional plan view; no surface payload is emitted.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk form-stdlib/tests/living-world-expression-blueprint-witness.fk

(do
    (let world (lwxbw-application-world))
    (let application-a
        (lwo-emergent-shape (lwxbw-application-candidate-a)))
    (let application-b
        (lwo-emergent-shape (lwxbw-application-candidate-b)))
    (let zero (lwxbw-zero-plan))
    (let one (lwxbw-one-plan))
    (let many (lwxbw-many-plan))
    (let rich (lwxbw-rich-plan))
    (list
        (if (node_eq (lwr-application-output application-a)
                (lwxbw-expected-a)) 1 0)
        (if (node_eq (lwr-application-output application-b)
                (lwxbw-expected-b)) 1 0)
        (lwxb-application-current? world
            (lwxbw-application-candidate-a))
        (lwxb-application-current? world
            (lwxbw-application-candidate-b))
        (lwxb-incomplete? (lwxb-plan-status zero))
        (len (lwtv-sequence-items (lwxb-plan-sequence zero)))
        (lwo-field-size (lwxb-plan-options zero))
        (lwxb-ready? (lwxb-plan-status one))
        (len (lwtv-sequence-items (lwxb-plan-sequence one)))
        (lwo-field-size (lwxb-plan-options one))
        (lwxb-ambiguous? (lwxb-plan-status many))
        (len (lwtv-sequence-items (lwxb-plan-sequence many)))
        (lwo-field-size (lwxb-plan-options many))
        (if (node_eq (lwxb-emit-from-plan world many) (lwo-none)) 1 0)
        (lwxb-ready? (lwxb-plan-status rich))
        (if (node_eq
                (lwlc-stack-default
                    (lwlc-declaration-stack
                        (lwxb-plan-declaration rich)))
                (lwxbw-default-lens)) 1 0)
        (len (lwlc-layer-items
            (lwlc-stack-layers
                (lwlc-declaration-stack
                    (lwxb-plan-declaration rich)))))
        (lwo-field-size (lwxb-plan-alternatives rich))
        (lwlc-unknown? (lwxb-plan-unknown rich))
        (lwlc-choice? (lwxb-plan-choice rich))
        (oac-timeout-valid? (lwxb-plan-timeout rich))))
