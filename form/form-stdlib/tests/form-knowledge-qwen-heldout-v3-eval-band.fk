; form-knowledge-qwen-heldout-v3-eval-band.fk -- pure blind-denominator proof.
;
; No model is admitted.  Synthetic answers remain evaluation fixtures and the
; report renderer is checked for absence of every private row field.
;
; preludes: form-stdlib/form-knowledge-qwen-heldout-v3-eval.fk
; PROOF BAND (fkwu): 65535

(do
    (defn fkh3b-bit (ok bit) (if ok bit 0))
    (defn fkh3b-raw (answer)
        (str_concat
            "choice-task=knowledge\nchoice-match=1\nbackend=form-native-metal-jit\ntext:\n"
            answer))
    (defn fkh3b-perfect-score (row)
        (fkh3-score row (fqt-knowledge-prompt (fkh3-prompt row))
            (fkh3-parse-resident-output (fkh3b-raw (fkh3-expected row))) 1))
    (defn fkh3b-perfect-scores (rows)
        (if (eq (len rows) 0) (list)
            (cons (fkh3b-perfect-score (head rows))
                  (fkh3b-perfect-scores (tail rows)))))
    (defn fkh3b-wrong-score (row)
        (fkh3-score row
            (fqt-knowledge-prompt (fkh3-prompt row))
            (fkh3-parse-resident-output (fkh3b-raw "wrong")) 1))
    (defn fkh3b-wrong-first-scores (rows)
        (if (eq (len rows) 0) (list)
            (cons
                (fkh3-score (head rows)
                    (fqt-knowledge-prompt (fkh3-prompt (head rows)))
                    (fkh3-parse-resident-output (fkh3b-raw "wrong")) 1)
                (fkh3b-perfect-scores (tail rows)))))
    (defn fkh3b-tamper-row-source (row)
        (fkh3-row (fkh3-id row) (fkh3-family row) (fkh3-concept row)
            (fkh3-source row)
            "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
            (fkh3-prompt row) (fkh3-expected row) (fkh3-answer-sha row)))
    (defn fkh3b-tamper-row-verifier (row)
        (list (nth row 0) (nth row 1) (nth row 2) (nth row 3)
              (nth row 4) (nth row 5) (nth row 6) (nth row 7) (nth row 8)
              (fkh3-verifier "unsealed-judge" (list (fkh3-expected row))
                             (list "whole-normalized-answer"))
              (nth row 10) (nth row 11)))
    (defn fkh3b-tamper-score-verifier (score)
        (list (nth score 0) (nth score 1) (nth score 2) (nth score 3)
              (nth score 4) (nth score 5)
              "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
              (nth score 7) (nth score 8) (nth score 9) (nth score 10)
              (nth score 11)))

    (defn form-knowledge-qwen-heldout-v3-eval-band ()
        (do
            (let rows (fkh3-rows))
            (let first (head rows))
            (let perfect (fkh3b-perfect-scores rows))
            (let wrong (cons (fkh3b-wrong-score first) (tail perfect)))
            (let audit (fkh3-leakage-audit rows))
            (let perfect-report
                (fkh3-report-with-audit (fkh3-fixture-scope)
                    "synthetic-qwen" 1 1 perfect audit))
            (let wrong-aggregate (fkh3-aggregate wrong))
            (let rendered (fkh3-report-lines perfect-report))
            (let tampered-rows
                (cons (fkh3b-tamper-row-verifier first) (tail rows)))
            (add
                (fkh3b-bit (eq (len rows) 30) 1)
            (add
                (fkh3b-bit (and (eq (fkh3-family-coverage? rows) 1)
                                 (eq (fkh3-every-family-twice?
                                        (fkh3-families) rows) 1)) 2)
            (add
                (fkh3b-bit (eq (fkh3-rows-unique? rows) 1) 4)
            (add
                (fkh3b-bit (eq (fkh3-all-rows-current? rows) 1) 8)
            (add
                (fkh3b-bit (and (str_eq (fkh3-dataset-sha256 rows)
                                        (fkh3-dataset-seal))
                                 (eq (fkh3-dataset-valid-with? rows audit) 1)) 16)
            (add
                (fkh3b-bit (eq (fkh3-leakage-audit-valid? audit) 1) 32)
            (add
                (fkh3b-bit (and (eq (fkh3-verifier? (fkh3-row-verifier first)) 1)
                                 (eq (nmfe-sha256?
                                        (fkh3-verifier-sha
                                            (fkh3-row-verifier first))) 1)) 64)
            (add
                (fkh3b-bit (and (eq (len perfect) (len rows))
                                 (eq (fkh3-every-row-scored-once?
                                        rows perfect) 1)) 128)
            (add
                (fkh3b-bit (and (eq (fkh3-report-overall95 perfect-report) 1)
                            (and (eq (fkh3-report-family95 perfect-report) 1)
                            (and (eq (fkh3-report-row95 perfect-report) 1)
                                 (eq (fkh3-report-live-credit perfect-report) 0)))) 256)
            (add
                (fkh3b-bit (and (eq (fkh3-at-least95?
                                        (nth wrong-aggregate 5)) 1)
                            (and (eq (fkh3-every-family-at-least95?
                                        (fkh3-families) wrong) 0)
                                 (eq (fkh3-every-row-at-least95? wrong) 0))) 512)
            (add
                (fkh3b-bit (and (eq (fkh3-at-least95? 950000) 1)
                                 (eq (fkh3-at-least95? 949999) 0)) 1024)
            (add
                (fkh3b-bit (and (eq (fkh3-row-current?
                                        (fkh3b-tamper-row-source first)) 0)
                            (and (not (str_eq (fkh3-dataset-sha256 tampered-rows)
                                             (fkh3-dataset-seal)))
                                 (eq (fkh3-score-valid?
                                        (fkh3b-tamper-score-verifier (head perfect))
                                        rows) 0))) 2048)
            (add
                (fkh3b-bit (and (eq (fkh3-private-material-absent? rendered rows) 1)
                                 (and (lt (str_find rendered "\ntext:\n" 0) 0)
                                 (and (lt (str_find rendered "answer-sha" 0) 0)
                                 (and (lt (str_find rendered "prompt=" 0) 0)
                                 (and (lt (str_find rendered "expected=" 0) 0)
                                 (and (lt (str_find rendered "source=" 0) 0)
                                      (lt (str_find rendered "answer=" 0) 0))))))) 4096)
            (add
                (fkh3b-bit (and (eq (fkh3-consent-valid?
                                        (fkh3-consent-token)) 1)
                                 (eq (fkh3-consent-valid?
                                        (str_concat (fkh3-consent-token) "x")) 0)) 8192)
            (add
                (fkh3b-bit (and (eq (fkh3-complete-score-set?
                                        (cons (head perfect) perfect) rows) 0)
                                 (eq (fkh3-complete-score-set?
                                        (tail perfect) rows) 0)) 16384)
                (fkh3b-bit (and
                    (eq (fkh3-semantic-ppm (fkh3-row-verifier first)
                                           (fkh3-expected first) 0) 1000000)
                    (and
                        (eq (fkh3-semantic-ppm (fkh3-row-verifier first)
                                               "wrong" 0) 0)
                        (eq (fkh3-obs-promotion
                                (fkh3-score-observation (head wrong))) 0)))
                    32768))))))))))))))))))

    (form-knowledge-qwen-heldout-v3-eval-band))
