; jit-resident-nodeid-band.fk — one existing carrier door speaks a structured
; Form request: [action, NodeID, image]. Cold birth reads image bytes once; hot
; calls reach the resident page by the interned NodeID index; release preserves
; 1 (dissolved), 0 (already absent), and nothing (malformed) distinctly.
; Fourth-arm verdict 16383. The last two bits keep the established string
; primitives whose tags a discarded two-door design accidentally reused.
;
; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk form-stdlib/jit-self-crystallization.fk

(do
    (defn jrnb-bit (ok bit) (if ok bit 0))
    (defn jrnb-values () (list 0 1 42))
    (defn jit-resident-nodeid-band ()
        (do (let h (jssc-birth (jrnb-values)))
            (let id (jssc-handle-identity h))
            (let img (jssc-handle-image h))
            (let request (jssc-handle-request h))
            (let changed (jssc-birth (list 0 1 43)))
            (let c0 (jrnb-bit (jssc-handle? h) 1))
            (let c1 (jrnb-bit (and (eq (jssc-apply h 0) 0)
                                    (str_eq (nth (jssc-route h 0) 0) "native")) 2))
            (let c2 (jrnb-bit (eq (jssc-apply h 1) 1) 4))
            (let c3 (jrnb-bit (eq (jssc-apply h 2) 42) 8))
            (let c4 (jrnb-bit (and (nothing? (jssc-apply h 3))
                                    (str_eq (nth (jssc-route h 3) 0) "nothing")) 16))
            (let c5 (jrnb-bit (and
                (str_eq (nth (jssc-route-at h
                    (jssc-handle-identity changed) 2) 0) "refused")
                (nothing? (jssc-apply-at h
                    (jssc-handle-identity changed) 2))) 32))
            ; An unrecognized action and a non-NodeID request decline; neither
            ; is accidentally interpreted as the legitimate output zero.
            (let c6 (jrnb-bit (nothing?
                (jit_leaf_inram (list 9 id img) 0)) 64))
            (let c7 (jrnb-bit (nothing?
                (jit_leaf_inram (list 0 7 img) 0)) 128))
            ; The raw image contract remains alive for existing callers.
            (let c8 (jrnb-bit (eq (jit_leaf_inram img 2) 42) 256))
            (let c9 (jrnb-bit (eq (jssc-release h) 1) 512))
            (let c10 (jrnb-bit (eq (jssc-release h) 0) 1024))
            ; A released identity stays dead. The cold Form challenger may
            ; still answer, but the old native page does not silently rebirth.
            (let c11 (jrnb-bit (and (nothing? (jit_leaf_inram request 0))
                                 (and (eq (jssc-apply h 2) 42)
                                      (str_eq (nth (jssc-route h 2) 0) "form"))) 2048))
            (let c12 (jrnb-bit (str_eq (substring "abcdef" 1 4) "bcd") 4096))
            (let c13 (jrnb-bit (str_eq (int_to_str 42) "42") 8192))
            (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13))))
    (jit-resident-nodeid-band))
