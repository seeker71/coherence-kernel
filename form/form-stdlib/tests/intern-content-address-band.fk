; intern-content-address-band.fk — the runtime's own half of the promise, guarded.
; PROOF LEVEL: FOURTH-ARM ONLY (fkwu) — intern_trivial_int, node_inst and node_type
; are runtime natives the three minimal proof walkers do not bind (`unbound function`,
; witnessed 2026-09-10), so a bit reading them would have exactly one arm anyway.
; Verdict 127 on fkwu.
;
; preludes: form-stdlib/core.fk
;
; The substrate's claim is that identity comes from content: the same value is the same
; NodeID, everywhere, so a Recipe can be trusted by its address instead of by its source.
; observe/intern-content-address.bml puts that question to every built kernel and reports
; that two of the three siblings answer with a table position rather than the value — a
; wound this band does not assert, because a band that goes green on a broken body is worse
; than no band.
;
; What it DOES guard is the half that stands: fkwu, the runtime the body actually runs on,
; keeps one address for one value. That is not decoration. If the runtime ever traded its
; wide inst for a side table, every NodeID the body has written down would quietly stop
; meaning what it says, and nothing else here would notice.
;
; The bits, each a claim about identity rather than about arithmetic:
;   1   a value past the 32-bit ceiling is its own address
;   2   so is the first value past it, and the first below the floor
;   4   re-interning the same value gives the same node, after other values have been interned
;   8   two different values never share a node
;  16   the address does not depend on how many values came before it
;  32   the leaf still reports itself an integer (type 1), and its value round-trips exactly
;  64   a small value, which fits inline on every kernel, is its own address too
(do
    (defn ica-bit (ok w) (if ok w 0))
    (let seal (intern_trivial_int 501009504543))
    (let over (intern_trivial_int 2147483648))
    (let under (intern_trivial_int -2147483649))
    (let big (intern_trivial_int 4503599627370495))
    (let noise1 (intern_trivial_int 777666555444))
    (let noise2 (intern_trivial_int 888777666555))
    (let noise3 (intern_trivial_int 999888777666))
    (let seal-again (intern_trivial_int 501009504543))
    (let small (intern_trivial_int 42))
    (let c0 (ica-bit (eq (node_inst seal) 501009504543) 1))
    (let c1 (ica-bit (and (eq (node_inst over) 2147483648)
                          (eq (node_inst under) -2147483649)) 2))
    (let c2 (ica-bit (node_eq seal seal-again) 4))
    (let c3 (ica-bit (and (not (node_eq seal over))
                          (and (not (node_eq over under))
                               (not (node_eq big noise1)))) 8))
    ; the order test, within one process: seal was interned FIRST, noise after it,
    ; and big after the noise. If the address were a position, big's would follow
    ; the count of what preceded it. It follows its value instead.
    (let c4 (ica-bit (and (eq (node_inst big) 4503599627370495)
                          (eq (node_inst noise3) 999888777666)) 16))
    (let c5 (ica-bit (and (eq (node_type seal) 1)
                          (and (eq (node_value seal) 501009504543)
                               (eq (node_value under) -2147483649))) 32))
    (let c6 (ica-bit (and (eq (node_inst small) 42) (eq (node_type small) 1)) 64))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6)))))))
