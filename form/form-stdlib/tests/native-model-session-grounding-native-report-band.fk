; native-model-session-grounding-native-report-band.fk -- a pure safe-report
; projection carries identities, aggregates, optional declarations, and no raw
; query/completion language.  It writes no file.
; preludes: form-stdlib/native-model-session-grounding-native-report.fk

(do
    (defn nmsgnrb-score (condition bit) (if condition bit 0))
    (defn native-model-session-grounding-native-report-band ()
        (do
            (let query-digest
                "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
            (let candidate-digest
                "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
            (let dataset-digest
                "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc")
            (let contract-digest
                "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd")
            (let scalar
                (list "native-model-session-grounding-report-v1"
                      4 1 1 0 1 1 0 1000000 1000000 500000
                      candidate-digest dataset-digest 1))
            (let text
                (nmsgn-render-report
                    2 2 1 1 3 2 7 4 scalar 2 query-digest candidate-digest
                    dataset-digest contract-digest "" "" 0
                    "baseline-unavailable" 1 1 1 0 0 17
                    "recipe" 3000 "NOTHING" "/fixture/report.txt"))
            (sum (list
                (nmsgnrb-score
                    (eq (nmsgn-prefix? text
                        "schema=native-model-session-grounding-report-v2\n") 1) 1)
                (nmsgnrb-score
                    (ge (str_find text
                        "execution_mode=form-native-direct-private-replay\n" 0) 0) 2)
                (nmsgnrb-score
                    (ge (str_find text "raw_query_persisted=0\n" 0) 0) 4)
                (nmsgnrb-score
                    (ge (str_find text "raw_completion_persisted=0\n" 0) 0) 8)
                (nmsgnrb-score
                    (and (lt (str_find text "fixture raw query" 0) 0)
                         (lt (str_find text "fixture raw completion" 0) 0)) 16)
                (nmsgnrb-score
                    (str_eq (nmsgn-report-value text "query_sha256")
                            query-digest) 32)
                (nmsgnrb-score
                    (str_eq (nmsgn-report-value text "candidate_set_sha256")
                            candidate-digest) 64)
                (nmsgnrb-score
                    (str_eq (nmsgn-report-value text "dataset_sha256")
                            dataset-digest) 128)
                (nmsgnrb-score
                    (str_eq (nmsgn-report-value text
                                "evaluation_contract_sha256")
                            contract-digest) 256)
                (nmsgnrb-score
                    (and
                        (str_eq (nmsgn-report-value text "declared_lens")
                                "recipe")
                        (str_eq (nmsgn-report-value text
                                    "declared_expiry_default") "NOTHING")) 512)
                (nmsgnrb-score
                    (and (eq (nmsgn-report-int text "declared_expiry_ms" -1)
                             3000)
                         (eq (nmsgn-report-int text "comparison_admissible" -1)
                             0)) 1024)
                (nmsgnrb-score
                    (and (eq (nmsgn-report-int text "mrr5_ppm" -1) 500000)
                         (str_eq (nmsgn-report-value text "authority_movement")
                                 "none")) 2048)
                (nmsgnrb-score
                    (eq (nmsgn-report-int text
                            "unchanged_session_files_admitted" -1) 1) 4096)
                (nmsgnrb-score
                    (and (eq (nmsgn-report-int text
                                "changing_session_files_abstained" -1) 1)
                         (ge (str_find text
                                "changing or unsealed tails abstain" 0) 0))
                    8192)))))
    (native-model-session-grounding-native-report-band))
