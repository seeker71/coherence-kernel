; scale-band.fk — the one fixed-point scale: ratio to ppm, ppm to share
; (floor and ceiling), the empty total answering 0, whole and in-range
; as data.
; Expected: 255
; preludes: form-stdlib/scale.bml
(do
    (defn scb-bit (ok bit) (if ok bit 0))
    (sum (list
        (scb-bit (eq (ppm-scale) 1000000) 1)
        (scb-bit (eq (ppm-of 1 4) 250000) 2)
        (scb-bit (eq (ppm-of 3 0) 0) 4)
        (scb-bit (eq (ppm-of 7 7) (ppm-scale)) 8)
        (scb-bit (eq (ppm-share 250000 400) 100) 16)
        (scb-bit (and (eq (ppm-share-ceil 333333 3) 1) (eq (ppm-share-ceil 1000000 3) 3)) 32)
        (scb-bit (and (eq (ppm-whole? 1000000) 1) (eq (ppm-whole? 999999) 0)) 64)
        (scb-bit (and (eq (ppm-in-range? 0) 1) (and (eq (ppm-in-range? 1000001) 0) (eq (ppm-in-range? (sub 0 1)) 0))) 128))))
