// Small grouped-query transformer with all seven projections trained in two layers.
// Nonzero A and B exercise both factor gradients, residuals and rotary positions.
// preludes: form-stdlib/native-llama-backward.bml
section [form.bml] {
 class NativeLlamaFixture {
  def nlf-values(n,seed,scale) = n <= 0 ? list() : cons(scale * ((((n * 37) + (seed * 13)) % 101) - 50),nlf-values(n - 1,seed,scale));
  def nlf-words(n,seed) = n <= 0 ? "" : md-le32(((n * 2654435761) + (seed * 104729)) % 4294967296) ++ nlf-words(n - 1,seed);
  def nlf-repeat(n,x) = n <= 0 ? list() : cons(x,nlf-repeat(n - 1,x));
  def nlf-view(rows,cols,seed) = list(nam-write(nam-alloc((rows * cols) / 8),nlf-words((rows * cols) / 8,seed)),nam-buffer(nlf-repeat((rows * cols) / 64,0.0125)),nam-buffer(nlf-repeat((rows * cols) / 64,-0.09375)),rows,cols,64,0);
  def nlf-projection(name,rows,cols,seed) = list(nlf-view(rows,cols,seed),list(name,nam-buffer(nlf-values(cols * 2,seed,0.006)),nam-buffer(nlf-values(rows * 2,seed + 7,0.006)),cols,2,rows,0.7));
  def nlf-layer(i) = list(nam-buffer(nlf-repeat(64,1.0)),nlf-projection(nll-prefix(i,"self_attn.q_proj"),64,64,i + 1),nlf-projection(nll-prefix(i,"self_attn.k_proj"),32,64,i + 3),nlf-projection(nll-prefix(i,"self_attn.v_proj"),32,64,i + 5),nlf-projection(nll-prefix(i,"self_attn.o_proj"),64,64,i + 7),nam-buffer(nlf-repeat(64,1.0)),nlf-projection(nll-prefix(i,"mlp.gate_proj"),64,64,i + 9),nlf-projection(nll-prefix(i,"mlp.up_proj"),64,64,i + 11),nlf-projection(nll-prefix(i,"mlp.down_proj"),64,64,i + 13));
  def nlf-freqs(i) = i >= 16 ? list() : cons(1.0 / math_pow(10000.0,i / 16.0),nlf-freqs(i + 1));
  def nlf-model() = list(list(64,64,2,1,32,64,2,0.00001,64,1024,nam-buffer(nlf-freqs(0))),list(nlf-layer(0),nlf-layer(1)),nlf-view(64,64,23),nam-buffer(nlf-repeat(64,1.0)),"fixture",list());
  def nlf-loss(m,c) {
   let r = nll-forward(m,c,list(1,5,9,12),0,1);
   let loss = nlb-loss(m,r,list(5,9,12,17));
   let done = nll-forward-close(r);
   loss;
  }
  def nlf-largest(xs,i,best,value) = nil?(xs) ? best : abs(head(xs)) > value ? nlf-largest(tail(xs),i + 1,i,abs(head(xs))) : nlf-largest(tail(xs),i + 1,best,value);
  def nlf-perturb(h,i,value) = (Comparable) metal_buf_write(h,i * 4,md-le32(md-f32-bits(value))) == 4 ? 1 : form_error("fixture perturbation write refused");
  def nlf-check-factor(m,c,row,factor) {
   let pair = head(row); let h = pair[factor]; let gh = row[factor];
   let n = (Comparable) factor == 1 ? (pair[3] * pair[4]) : (pair[4] * pair[5]);
   let grad = nam-read(gh,n); let i = nlf-largest(grad,0,0,-1.0);
   let analytical = grad[i]; let old = head(nam-read-bytes(metal_buf_read(h,i * 4,4),1));
   let plus = nlf-perturb(h,i,old + 0.003); let high = nlf-loss(m,c);
   let minus = nlf-perturb(h,i,old - 0.003); let low = nlf-loss(m,c);
   let restore = nlf-perturb(h,i,old);
   let numeric = (high - low) / 0.006;
   let error = abs(analytical - numeric);
   let pass = error < (0.0002 + (0.03 * abs(numeric)));
   let evidence = print(list(head(pair),factor,i,analytical,numeric,error,pass));
   pass;
  }
  def nlf-check-pairs(m,c,state) = nil?(state) ? 0 : ((nlf-check-factor(m,c,head(state),1) + nlf-check-factor(m,c,head(state),2)) + nlf-check-pairs(m,c,tail(state)));
 }
 0;
}
