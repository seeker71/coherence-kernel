// Small grouped-query transformer with all seven projections trained in two layers.
// Nonzero A and B exercise both factor gradients, residuals and rotary positions.
// preludes: form-stdlib/native-llama-backward.bml
section [form.bml] {
 class NativeLlamaFixture {
  def nlf-values(n,seed,scale) = n <= 0 ? [] : cons(scale * ((((n * 37) + (seed * 13)) % 101) - 50),nlf-values(n - 1,seed,scale));
  def nlf-words(n,seed) = n <= 0 ? "" : md-le32(((n * 2654435761) + (seed * 104729)) % 4294967296) ++ nlf-words(n - 1,seed);
  def nlf-repeat(n,x) = n <= 0 ? [] : cons(x,nlf-repeat(n - 1,x));
  def nlf-view(rows,cols,seed) = nlf-view-by(nothing(),rows,cols,seed);
  def nlf-view-by(owner,rows,cols,seed) = [nam-write(nll-allocate(owner,(rows*cols)/8),nlf-words((rows*cols)/8,seed)),nll-buffer(owner,nlf-repeat((rows*cols)/64,0.0125)),nll-buffer(owner,nlf-repeat((rows*cols)/64,-0.09375)),rows,cols,64,0];
  def nlf-projection(name,rows,cols,seed) = nlf-projection-by(nothing(),name,rows,cols,seed);
  def nlf-projection-by(owner,name,rows,cols,seed) = [nlf-view-by(owner,rows,cols,seed),[name,nll-buffer(owner,nlf-values(cols*2,seed,0.006)),nll-buffer(owner,nlf-values(rows*2,seed+7,0.006)),cols,2,rows,0.7]];
  def nlf-layer(i) = nlf-layer-by(nothing(),i);
  def nlf-layer-by(owner,i) = [nll-buffer(owner,nlf-repeat(64,1.0)),nlf-projection-by(owner,nll-prefix(i,"self_attn.q_proj"),64,64,i+1),nlf-projection-by(owner,nll-prefix(i,"self_attn.k_proj"),32,64,i+3),nlf-projection-by(owner,nll-prefix(i,"self_attn.v_proj"),32,64,i+5),nlf-projection-by(owner,nll-prefix(i,"self_attn.o_proj"),64,64,i+7),nll-buffer(owner,nlf-repeat(64,1.0)),nlf-projection-by(owner,nll-prefix(i,"mlp.gate_proj"),64,64,i+9),nlf-projection-by(owner,nll-prefix(i,"mlp.up_proj"),64,64,i+11),nlf-projection-by(owner,nll-prefix(i,"mlp.down_proj"),64,64,i+13)];
  def nlf-freqs(i) = i >= 16 ? [] : cons(1.0 / math_pow(10000.0,i / 16.0),nlf-freqs(i + 1));
  def nlf-model() {
   let owner=nll-group(nothing(),"llama-fixture");
   [[64,64,2,1,32,64,2,0.00001,64,1024,nll-buffer(owner,nlf-freqs(0))],[nlf-layer-by(owner,0),nlf-layer-by(owner,1)],nlf-view-by(owner,64,64,23),nll-buffer(owner,nlf-repeat(64,1.0)),"fixture",[],"",owner];
  }
  def nlf-loss(m,c) {
   let r = nll-forward(m,c,[1,5,9,12],0,1);
   let loss = nlb-loss(m,r,[5,9,12,17]);
   let done = nll-forward-close(r);
   loss;
  }
  def nlf-largest(xs,i,best,value) = nil?(xs) ? best : abs(xs[0]) > value ? nlf-largest(xs[1:],i + 1,i,abs(xs[0])) : nlf-largest(xs[1:],i + 1,best,value);
  def nlf-perturb(h,i,value) = (Comparable) metal_buf_write(h,i * 4,md-le32(md-f32-bits(value))) == 4 ? 1 : form_error("fixture perturbation write refused");
  def nlf-check-factor(m,c,row,factor) {
   let pair = row[0]; let h = pair[factor]; let gh = row[factor];
   let n = (Comparable) factor == 1 ? (pair[3] * pair[4]) : (pair[4] * pair[5]);
   let grad = nam-read(gh,n); let i = nlf-largest(grad,0,0,-1.0);
   let analytical = grad[i]; let old = nam-read-bytes(metal_buf_read(h,i * 4,4),1)[0];
   let plus = nlf-perturb(h,i,old + 0.003); let high = nlf-loss(m,c);
   let minus = nlf-perturb(h,i,old - 0.003); let low = nlf-loss(m,c);
   let restore = nlf-perturb(h,i,old);
   let numeric = (high - low) / 0.006;
   let error = abs(analytical - numeric);
   let pass = error < (0.0002 + (0.03 * abs(numeric)));
   let evidence = print([pair[0],factor,i,analytical,numeric,error,pass]);
   pass;
  }
  def nlf-check-pairs(m,c,state) = nil?(state) ? 0 : ((nlf-check-factor(m,c,state[0],1) + nlf-check-factor(m,c,state[0],2)) + nlf-check-pairs(m,c,state[1:]));
 }
 0;
}
