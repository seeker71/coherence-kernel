// Explicit retained identities preserve the same response-correlation contract.
// preludes: form-stdlib/organ-health.bml
section [form.bml] {
 class OrganIdentityWitness {
  def oiw-check(name,ok) = if ok then 1 else form_error(str_concat("organ identity: ",name));
 }
 let evidence = json-node-object(list(oh-s("path","owned-run/action-1.json")));
 let observed = oh-reading-with-id("owned-run/action-1.json","organ","flow","write",json-node-int(1),json-node-int(1),json-node-int(1),list(),list("continue"),evidence);
 oiw-check("explicit identity retained",(oh-valid(observed) && ((String) oh-str(observed,"id") == "owned-run/action-1.json")));
 oiw-check("evidence retained",node_eq(oh-get(observed,"evidence"),evidence));
 let response = oh-response(observed,"continue");
 oiw-check("response correlates",((String) oh-select(observed,response,"abstain") == "continue"));
 let other = oh-set(response,"id",json-node-string("owned-run/action-2.json"));
 oiw-check("other event cannot steer",((String) oh-select(observed,other,"abstain") == "abstain"));
 oiw-check("empty identity invalid",(!oh-valid(oh-set(observed,"id",json-node-string("")))));
 let applied = oh-applied(observed,"continue",json-node-int(1));
 oiw-check("application preserves identity",(oh-valid(applied) && ((String) oh-str(applied,"id") == oh-str(observed,"id"))));
 let automatic = oh-reading("organ","flow","write",json-node-int(1),json-node-int(1),json-node-int(1),list(),list("continue"),evidence);
 oiw-check("default process identity remains valid",(oh-valid(automatic) && (!((String) oh-str(automatic,"id") == oh-str(observed,"id")))));
 1;
}
