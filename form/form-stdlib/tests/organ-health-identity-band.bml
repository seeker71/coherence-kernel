; REQUIRES: fkwu's own frame counter (kernel_stat 12 and framebuffer-events)
; Verdict 1
// Explicit retained identities preserve the same response-correlation contract.
// preludes: form-stdlib/organ-health.bml
section [form.bml] {
 class OrganIdentityWitness {
  def oiw-check(name,ok) = ok ? 1 : form_error("organ identity: " ++ name);
 }
 let evidence = json-node-object([oh-s("path","owned-run/action-1.json")]);
 let observed = oh-reading-with-id("owned-run/action-1.json","organ","flow","write",json-node-int(1),json-node-int(1),json-node-int(1),[],["continue"],evidence);
 oiw-check("explicit identity retained",oh-valid(observed) && ((String) oh-str(observed,"id") == "owned-run/action-1.json"));
 oiw-check("evidence retained",node_eq(oh-get(observed,"evidence"),evidence));
 let response = oh-response(observed,"continue");
 oiw-check("response correlates",(String) oh-select(observed,response,"abstain") == "continue");
 let other = oh-set(response,"id",json-node-string("owned-run/action-2.json"));
 oiw-check("other event cannot steer",(String) oh-select(observed,other,"abstain") == "abstain");
 let failed = oh-current([other],[]);
 let stillOpen = oh-current([observed,response],failed);
 oiw-check("other control cannot clear correlation",oh-pain(filter(row => (String) oh-str(row,"organ") == "health-flow",stillOpen)[0]));
 let accepted = oh-set(other,"at_ms",json-node-int(1234));
 let recovered = oh-current([oh-set(observed,"id",oh-get(other,"id")),accepted],failed);
 let settled = filter(row => (String) oh-str(row,"organ") == "health-flow",recovered)[0];
 oiw-check("matching accepted control settles correlation",!oh-unease(settled) && (String) oh-str(settled,"care_of") == oh-str(failed[0],"id") && json-int-value(oh-get(settled,"at_ms")) == 1234 && json-int-value(oh-get(settled,"observed_at_ms")) == 1234 && (String) oh-str(oh-get(settled,"evidence"),"control_id") == oh-str(other,"id"));
 oiw-check("empty identity invalid",!oh-valid(oh-set(observed,"id",json-node-string(""))));
 let applied = oh-applied(observed,"continue",json-node-int(1));
 oiw-check("application preserves identity",oh-valid(applied) && ((String) oh-str(applied,"id") == oh-str(observed,"id")));
 let beforeFrame = kernel_stat(12);
 let framed = oh-frame(applied);
 oiw-check("one explicit event",kernel_stat(12) == beforeFrame + 1);
 let frame = reverse(framebuffer-events())[0];
 oiw-check("frame carries correlated action",((String) oh-str(frame,"schema") == "organ-frame-v1") && ((String) oh-str(frame,"id") == oh-str(applied,"id")) && ((String) oh-str(frame,"stage") == "applied") && ((String) oh-str(frame,"selected") == "continue"));
 oiw-check("frame excludes owned content",!(json-object-has?(frame,"expected") || json-object-has?(frame,"observed") || json-object-has?(frame,"evidence") || json-object-has?(frame,"result")));
 let automatic = oh-reading("organ","flow","write",json-node-int(1),json-node-int(1),json-node-int(1),[],["continue"],evidence);
 oiw-check("default process identity remains valid",oh-valid(automatic) && (!((String) oh-str(automatic,"id") == oh-str(observed,"id"))));
 1;
}
