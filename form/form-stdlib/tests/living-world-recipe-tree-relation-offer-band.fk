; target: 2147483647
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/living-world-recipe-tree-revision-trial.fk form-stdlib/living-world-recipe-tree-revision-hypothesis.fk form-stdlib/living-world-recipe-tree-revision-prospective.fk form-stdlib/living-world-recipe-tree-relation-nursery.fk form-stdlib/living-world-recipe-tree-relation-offer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk

(defn lwrrob-bit (ok bit) (if ok bit 0))

(defn lwrrob-run ()
    (do
        (let result (lwrrow-run))
        (let children (node_children result))
        (let upstream (nth children 0))
        (let upstream-children (node_children upstream))
        (let parent (nth upstream-children 1))
        (let suite (nth upstream-children 4))
        (let field (nth children 1))
        (let proposals (nth children 2))
        (let proposal (nth children 3))
        (let candidate (nth children 4))
        (let choice (nth children 5))
        (let optional-choice (nth children 6))
        (let optional-proposal (nth children 7))
        (let pending (nth children 8))
        (let expired (nth children 9))
        (let waiting (nth children 10))
        (let admitted (nth children 11))
        (let revoked-world (nth children 12))
        (let admitted-world (lwt-round-world admitted))
        (let declaration (lwrro-choice-declaration optional-choice))
        (let stack (lwlc-declaration-stack declaration))
        (let timeout (lwrro-choice-timeout optional-choice))
        (let trial (lwrro-choice-trial choice))
        (sum (list
            (lwrrob-bit (eq (lwrrn-field? field) 1) 1)
            (lwrrob-bit (eq (lwo-field-size proposals) 1) 2)
            (lwrrob-bit (not (node_eq proposal (lwo-none))) 4)
            (lwrrob-bit
                (node_eq candidate (lwt-proposal-candidate proposal)) 8)
            (lwrrob-bit (eq (lwrro-candidate? candidate) 1) 16)
            (lwrrob-bit (eq (lwrro-choice? choice) 1) 32)
            (lwrrob-bit (eq (lwrro-choice-valid? choice) 1) 64)
            (lwrrob-bit (node_eq (lwrro-choice-field choice) field) 128)
            (lwrrob-bit
                (eq (lwo-field-has? (lwrrn-field-invariants field)
                        (lwrro-choice-invariant choice)) 1) 256)
            (lwrrob-bit
                (eq (lwo-field-has? (lwrrn-field-viable field) trial) 1) 512)
            (lwrrob-bit
                (node_eq (lwrro-choice-alternatives choice)
                    (lwrrn-field-trials field)) 1024)
            (lwrrob-bit
                (node_eq (lwrro-choice-unknowns choice)
                    (lwrrn-field-unknowns field)) 2048)
            (lwrrob-bit
                (node_eq (lwrro-choice-declaration choice) (lwo-none)) 4096)
            (lwrrob-bit
                (node_eq (lwrro-choice-timeout choice) (lwo-none)) 8192)
            (lwrrob-bit (eq (lwrro-choice-valid? optional-choice) 1) 16384)
            (lwrrob-bit (eq (lwlc-declaration-valid? declaration) 1) 32768)
            (lwrrob-bit
                (eq (lwlc-recipe-lens? (lwlc-stack-default stack)) 1) 65536)
            (lwrrob-bit
                (eq (len (lwlc-layer-items
                            (lwlc-stack-layers stack))) 1) 131072)
            (lwrrob-bit (eq (oac-timeout-valid? timeout) 1) 262144)
            (lwrrob-bit (eq (oac-time-pending? pending) 1) 524288)
            (lwrrob-bit (eq (oac-time-outcome? expired) 1) 1048576)
            (lwrrob-bit
                (oac-alternative-ack? (oac-time-outcome-ack expired)) 2097152)
            (lwrrob-bit (not (node_eq pending expired)) 4194304)
            (lwrrob-bit
                (and (not (node_eq optional-proposal (lwo-none)))
                     (eq (node_value (nth children 15)) 0)) 8388608)
            (lwrrob-bit
                (ge (lwo-field-size
                        (lwt-proposal-participants proposal)) 2) 16777216)
            (lwrrob-bit
                (and (eq (node_value (nth children 13)) 0)
                     (eq (node_value (nth children 14)) 0)) 33554432)
            (lwrrob-bit
                (and (eq (node_value (nth children 16)) 1)
                     (eq (lwo-active? admitted-world candidate) 1)) 67108864)
            (lwrrob-bit
                (and (eq (node_value (nth children 17)) 0)
                     (eq (lwo-active? admitted-world
                            (lwrrn-trial-recipe trial)) 0)) 134217728)
            (lwrrob-bit
                (and (eq (node_value (nth children 18)) 0)
                     (eq (lwo-active? revoked-world candidate) 0)) 268435456)
            (lwrrob-bit
                (and (eq (node_value (nth children 19)) 1)
                     (eq (lwrtrp-ready? revoked-world parent suite 2) 1))
                536870912)
            (lwrrob-bit
                (and (eq (len (nth children 20)) 18)
                     (and (eq (lwrrn-trial-exact trial) 2)
                          (eq (lwrrn-trial-total trial) 2))) 1073741824)))))

; witnessed: 2026-08-09 -> 2147483647 (31/31) on fkwu
(lwrrob-run)
