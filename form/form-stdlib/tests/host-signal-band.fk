; host-signal-band.fk — host_signal pid sig, the seed's door for any signal to one process, held against Form children.
;
; host_kill sent SIGTERM and nothing else, so a process that did not hear it was ended through /bin/kill, a foreign
; program borrowed for one syscall. host_signal is that syscall: 0 sent, -1 the host refused (no such process, or one
; this user may not signal), -2 a pid or a signal the door will not send. The children are Form (an fkwu running
; tests/host-sleeper-run.fk, which only waits); nothing foreign runs.
;
;   1    the door refuses what it will not send, with -2, signalling nothing: sig 0 (host_alive asks that), sig 32, sig -1,
;        a string or a float for either argument, pid 0, pid -1, a pid beyond a C int
;   2    a pid the host has no process for answers -1 (99999999)
;   4    SIGSTOP answers 0 and the stopped child is still alive to host_alive
;   8    SIGTERM sent to a stopped child answers 0, and the child is gone once it is continued (SIGCONT) at the latest:
;        its exit reads 143 (128 + SIGTERM). Darwin lets the TERM land at once, Linux holds it until the SIGCONT; the
;        claim is the same on both, and what was seen is printed
;   16   SIGKILL ends a stopped child at once: its exit reads 137 (128 + SIGKILL)
;   32   SIGKILL ends a running child: its exit reads 137
;   64   a signal to a pid already reaped answers -1
;
; A stopped process is not a deaf one on Darwin (witnessed 2026-10-04: SIGTERM ended a SIGSTOPped child there, claim 8),
; so voice-track-reap-band proves its escalation on its own seam instead.
;
; The signal numbers STOP and CONT are the host's: 17 and 19 on Darwin, 19 and 18 on Linux (found by /proc/self).
; A binary without the host_signal door says "door absent" by name and answers 0, spawning nothing. A child still
; standing when the band ends is ended with SIGKILL and reaped, whatever failed.
;
; Expected: 127
; PROOF LEVEL: FOURTH-ARM ONLY (host_signal is a seed door; the sibling kernels carry no host doors)
; preflight-exec: forbidden
section [form.bml] {
  def hsb-bit(ok, bit) = ok ? bit : 0;
  def hsb-say(label, v) = print([label, v]);
  def hsb-linux?() = (Comparable) host_path_exists("/proc/self") == 1;
  def hsb-stop() = hsb-linux?() ? 19 : 17;
  def hsb-cont() = hsb-linux?() ? 18 : 19;
  def hsb-sleeper() {
    let pid = host_spawn_at(["./fkwu", "form/form-stdlib/tests/host-sleeper-run.fk"], ["/dev/null", "/dev/null", "/dev/null"]);
    let settle = host_sleep_ms(400);
    pid;
  }
  def hsb-clean(pid) {
    let ended = (Comparable) host_alive(pid) == 1 ? host_signal(pid, 9) : 0;
    host_wait(pid);
  }
  def hsb-door?() = nothing?(host_signal(0, 9)) ? 0 : 1;
  def hsb-absent() {
    let shown = print(["host-signal-band", "door absent: this fkwu has no host_signal; rebuild it (cc -O2 -o fkwu.new runtime/fkwu-uni.c)"]);
    let verdict = print(["host-signal-band", "verdict", 0]);
    0;
  }
  def hsb-all(xs) = nil?(xs) ? true : ((Comparable) xs[0] == (0 - 2)) && hsb-all(xs[1:]);
  def hsb-run() {
    let p = hsb-sleeper();
    let refusals = [host_signal(p, 0), host_signal(p, 32), host_signal(p, 0 - 1), host_signal(p, "9"), host_signal(p, 1.5), host_signal("12", 15), host_signal(1.5, 15), host_signal(0, 15), host_signal(0 - 1, 15), host_signal(4294967297, 15)];
    let s1 = hsb-say("refused", refusals);
    let b1 = hsb-bit(hsb-all(refusals) && ((Comparable) host_alive(p) == 1), 1);
    let none = host_signal(99999999, 15);
    let s2 = hsb-say("no such process", none);
    let b2 = hsb-bit((Comparable) none == (0 - 1), 2);

    let stopped = host_signal(p, hsb-stop());
    let settle = host_sleep_ms(200);
    let alive_stopped = host_alive(p);
    let s4 = hsb-say("stopped", [stopped, alive_stopped]);
    let b4 = hsb-bit(((Comparable) stopped == 0) && ((Comparable) alive_stopped == 1), 4);

    let termed = host_signal(p, 15);
    let settle2 = host_sleep_ms(400);
    let alive_termed = host_alive(p);
    let conted = host_signal(p, hsb-cont());
    let st8 = host_wait(p);
    let s8 = hsb-say("term to a stopped child (seen alive after term, cont, exit)", [termed, alive_termed, conted, st8]);
    let b8 = hsb-bit(((Comparable) termed == 0) && ((Comparable) st8 == 143), 8);
    let again = host_signal(p, 15);
    let s64 = hsb-say("signal a reaped pid", again);
    let b64 = hsb-bit((Comparable) again == (0 - 1), 64);

    let q = hsb-sleeper();
    let q_stop = host_signal(q, hsb-stop());
    let q_kill = host_signal(q, 9);
    let q_st = host_wait(q);
    let s16 = hsb-say("kill a stopped child", [q_stop, q_kill, q_st]);
    let b16 = hsb-bit(((Comparable) q_stop == 0) && ((Comparable) q_kill == 0) && ((Comparable) q_st == 137), 16);

    let r = hsb-sleeper();
    let r_kill = host_signal(r, 9);
    let r_st = host_wait(r);
    let s32 = hsb-say("kill a running child", [r_kill, r_st]);
    let b32 = hsb-bit(((Comparable) r_kill == 0) && ((Comparable) r_st == 137), 32);
    let cleaned = hsb-clean(p) + hsb-clean(q) + hsb-clean(r);
    let verdict = b1 + b2 + b4 + b8 + b16 + b32 + b64;
    let shown = print(["host-signal-band", "verdict", verdict]);
    verdict;
  }
  (Comparable) hsb-door?() == 1 ? hsb-run() : hsb-absent();
}
