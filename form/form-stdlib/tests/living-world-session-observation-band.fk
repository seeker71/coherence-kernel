; living-world-session-observation-band.fk -- aggregate real-session evidence
; remains content-blind without consent and revocable after admission.
; Verdict 1048575 proves twenty minimization, consent, expiry, recurrence,
; authority, prediction, foreign-refusal, and owner-revocation claims.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/native-model-evidence.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-session-observation.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-session-observation-witness.fk

(do
    (let started
        (lcfb-open-stream "living-world-session-observation-band"
            "form-native" "lwrsw-run" "declared-verdict"
            "form/form-stdlib/tests/living-world-session-observation-band.fk"
            9 9))
    (lwrsw-verdict (lwrsw-run started)))
