; form-cli-route-record-evidence-image-call-band.fk -- focused pure route/source
; evidence image and protocol signal proof.
;
; Expected: 32767
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-cli-route-record-evidence-image-call.fk
;
; PROOF LEVEL: FOURTH-ARM ONLY — Verdict 32767 on fkwu; go/rust/ts agree on 3 (witnessed 2026-09-03).  No parser, filesystem, process, model,
; Metal, HTTP, C, flattening, or operations table is opened by this band.

(do
    (defn fcrreib-bit (held weight) (if held weight 0))
    (defn fcrreib-source ()
        (intern_node (make_nodeid 31 2 0 200)
            (list (intern_trivial_string "source-71"))))
    (defn fcrreib-other-source ()
        (intern_node (make_nodeid 31 2 0 200)
            (list (intern_trivial_string "source-72"))))
    (defn fcrreib-values-as
        (route-present reference-valid reference-key reference-path
         reference-source-key source-record-valid source-path source-key
         key-member entry-source)
        (fcrrei-values
            1 "concept" "defn-synthetic" route-present
            reference-valid "psckr-reference-v1" reference-key "form-stdlib"
            reference-path reference-source-key "entry-content-key-71"
            source-record-valid "pscish-entry-v2" "form-stdlib" source-path
            source-key "entry-content-key-71" key-member
            (fcrreib-source) entry-source))
    (defn fcrreib-values ()
        (fcrreib-values-as 1 1 "defn-synthetic"
            "form/form-stdlib/synthetic.fk" "source-content-key-71"
            1 "form/form-stdlib/synthetic.fk" "source-content-key-71"
            1 (fcrreib-source)))
    (defn fcrreib-values-schema (schema)
        (fcrrei-values
            1 "concept" "defn-synthetic" 1
            1 schema "defn-synthetic" "form-stdlib"
            "form/form-stdlib/synthetic.fk"
            "source-content-key-71" "entry-content-key-71"
            1 "pscish-entry-v2" "form-stdlib"
            "form/form-stdlib/synthetic.fk"
            "source-content-key-71" "entry-content-key-71" 1
            (fcrreib-source) (fcrreib-source)))

    (defn form-cli-route-record-evidence-image-call-band ()
        (do
            (let correlation (intern_trivial_string
                "route-record-evidence-correlation-71"))
            (let admitted (fcrrei-receipt (fcrreib-values) correlation
                (fcrrei-fuel)))
            (let mismatch (fcrrei-receipt
                (fcrreib-values-as 1 1 "other-key"
                    "form/form-stdlib/synthetic.fk" "source-content-key-71"
                    1 "form/form-stdlib/synthetic.fk" "source-content-key-71"
                    1 (fcrreib-source))
                correlation (fcrrei-fuel)))
            (let source-drift (fcrrei-receipt
                (fcrreib-values-as 1 1 "defn-synthetic"
                    "form/form-stdlib/synthetic.fk" "source-content-key-72"
                    1 "form/form-stdlib/synthetic.fk" "source-content-key-71"
                    1 (fcrreib-source))
                correlation (fcrrei-fuel)))
            (let absent (fcrrei-receipt
                (fcrreib-values-as 0 1 "defn-synthetic"
                    "form/form-stdlib/synthetic.fk" "source-content-key-71"
                    1 "form/form-stdlib/synthetic.fk" "source-content-key-71"
                    1 (fcrreib-source))
                correlation (fcrrei-fuel)))
            (let malformed-reference (fcrrei-receipt
                (fcrreib-values-as 1 0 "defn-synthetic"
                    "form/form-stdlib/synthetic.fk" "source-content-key-71"
                    1 "form/form-stdlib/synthetic.fk" "source-content-key-71"
                    1 (fcrreib-source))
                correlation (fcrrei-fuel)))
            (let malformed-source (fcrrei-receipt
                (fcrreib-values-as 1 1 "defn-synthetic"
                    "form/form-stdlib/synthetic.fk" "source-content-key-71"
                    0 "form/form-stdlib/synthetic.fk" "source-content-key-71"
                    1 (fcrreib-source))
                correlation (fcrrei-fuel)))
            (let node-drift (fcrrei-receipt
                (fcrreib-values-as 1 1 "defn-synthetic"
                    "form/form-stdlib/synthetic.fk" "source-content-key-71"
                    1 "form/form-stdlib/synthetic.fk" "source-content-key-71"
                    1 (fcrreib-other-source))
                correlation (fcrrei-fuel)))
            (let schema-drift (fcrrei-receipt
                (fcrreib-values-schema "wrong-reference")
                correlation (fcrrei-fuel)))
            (let timed (fcrrei-receipt (fcrreib-values) correlation
                (sub (fcrrei-fuel) 1)))

            (let protocol (nth admitted 0))
            (let offer (nth admitted 1))
            (let ack (nth admitted 2))
            (let call (fpcp-child offer 0))
            (let capability (fpcp-child call 3))
            (let denied-protocol (fpcp-registry
                (fpcp-registry-images protocol) (empty) (list call)))
            (let denied-ack (fpcp-execute denied-protocol offer))
            (let denied (list denied-protocol offer denied-ack
                (fpcp-ack-observed? denied-protocol offer denied-ack)))

            (let other-call (fpcp-call-binding (fpcp-child call 0)
                "unadmitted-route-record" (fpcp-child call 2) capability))
            (let other-offer (fpcp-offer other-call correlation
                (fpcp-offer-values offer) (fcrrei-fuel)))
            (let other-ack (fpcp-execute protocol other-offer))
            (let unadmitted (list protocol other-offer other-ack
                (fpcp-ack-observed? protocol other-offer other-ack)))

            (let alternate-image (fcatw-image (empty)
                (list (fcatw-row 1 0 0 0)) (empty) 0))
            (let alternate (fcatw-binding
                "form-cli/route-record-evidence-validation" alternate-image))
            (let conflicted-images (fcatw-registry
                (list (fpcp-child call 0) (fpcp-child call 2) alternate)))
            (let conflicted (fpcp-registry conflicted-images
                (list capability) (list call)))
            (let choice-ack (fpcp-execute conflicted offer))
            (let choice (list conflicted offer choice-ack
                (fpcp-ack-observed? conflicted offer choice-ack)))

            (let short-offer (fpcp-offer call correlation
                (tail (fpcp-offer-values offer)) (fcrrei-fuel)))
            (let short-ack (fpcp-execute protocol short-offer))
            (let short (list protocol short-offer short-ack
                (fpcp-ack-observed? protocol short-offer short-ack)))
            (let forged-ack (fpcp-ack offer "returned"
                "resident-thought-returned"
                (fpcp-value (fcatw-kind-int) 1)
                (sub (fcrrei-fuel) 1) 1
                "offer,resolve,call,return,ack,release"))
            (let forged (list protocol offer forged-ack 1))

            (sum (list
                (fcrreib-bit (and (eq (fcatw-image-valid? (fcrrei-image)) 1)
                    (and (eq (fcatw-image-root (fcrrei-image)) 70)
                         (eq (len (fcatw-image-kinds (fcrrei-image))) 20))) 1)
                (fcrreib-bit (and (str_eq (fpcp-ack-status ack) "returned")
                    (and (eq (fcrrei-value admitted) 1)
                    (and (eq (fpcp-ack-steps ack) (fcrrei-fuel))
                    (and (eq (fpcp-ack-output ack) 1)
                    (and (eq (nth admitted 3) 1)
                         (str_eq (fcrrei-status admitted) "admitted")))))) 2)
                (fcrreib-bit (and (eq (fcrrei-value mismatch) 0)
                    (str_eq (fcrrei-status mismatch) "refused")) 4)
                (fcrreib-bit (and (eq (fcrrei-value source-drift) 0)
                    (str_eq (fcrrei-status source-drift) "refused")) 8)
                (fcrreib-bit (and (eq (fcrrei-value absent) 0)
                    (str_eq (fcrrei-status absent) "nothing")) 16)
                (fcrreib-bit (and (eq (fcrrei-value malformed-reference) 0)
                    (str_eq (fcrrei-status malformed-reference) "failure")) 32)
                (fcrreib-bit (and (eq (fcrrei-value malformed-source) 0)
                    (str_eq (fcrrei-status malformed-source) "failure")) 64)
                (fcrreib-bit (and (eq (fcrrei-value node-drift) 0)
                    (str_eq (fcrrei-status node-drift) "refused")) 128)
                (fcrreib-bit (and (eq (fcrrei-value schema-drift) 0)
                    (str_eq (fcrrei-status schema-drift) "refused")) 256)
                (fcrreib-bit (and (str_eq (fcrrei-status timed) "timeout")
                    (and (eq (fpcp-ack-output (nth timed 2)) 0)
                         (eq (fpcp-ack-steps (nth timed 2))
                             (sub (fcrrei-fuel) 1)))) 512)
                (fcrreib-bit (and (str_eq (fcrrei-status denied) "refused")
                    (eq (fpcp-ack-output denied-ack) 0)) 1024)
                (fcrreib-bit (and (str_eq (fcrrei-status unadmitted) "nothing")
                    (eq (fpcp-ack-output other-ack) 0)) 2048)
                (fcrreib-bit (and (str_eq (fcrrei-status choice) "choice")
                    (eq (fpcp-ack-output choice-ack) 0)) 4096)
                (fcrreib-bit (and (str_eq (fcrrei-status short) "refused")
                    (str_eq (fpcp-ack-reason short-ack)
                            "offer-abi-refused")) 8192)
                (fcrreib-bit (and (str_eq (fcrrei-status forged) "failure")
                    (eq (fpcp-ack-observed? protocol offer forged-ack) 0))
                    16384)))))

    (form-cli-route-record-evidence-image-call-band))
