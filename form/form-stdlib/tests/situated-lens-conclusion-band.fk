; situated-lens-conclusion-band.fk — time and every part of the lens select
; observed evidence; only push strictly beyond margin changes a conclusion.
; preludes: form-stdlib/core.fk form-stdlib/core-word-inquiry.fk form-stdlib/situated-lens-conclusion.fk

(do
    (defn slcb-bit (condition bit) (if condition bit 0))
    (defn slcb-sum (values)
        (if (eq (len values) 0) 0
            (add (head values) (slcb-sum (tail values)))))

    (let a (cwi-lens 1 2 3 4))
    (let point-b (cwi-lens 2 2 3 4))
    (let direction-b (cwi-lens 1 3 3 4))
    (let intensity-b (cwi-lens 1 2 4 4))
    (let focus-b (cwi-lens 1 2 3 5))
    (let tie-lens (cwi-lens 0 0 0 0))
    (let low-lens (cwi-lens 0 0 0 1))
    (let same-lens (cwi-lens 0 0 0 2))
    (let missing-lens (cwi-lens 7 7 7 7))
    (let field
        (list
            (slc-observation 10 a 1 6 9001)
            (slc-observation 11 a 0 6 9002)
            (slc-observation 10 point-b 0 6 9003)
            (slc-observation 10 direction-b 0 6 9004)
            (slc-observation 10 intensity-b 0 6 9005)
            (slc-observation 10 focus-b 0 6 9006)
            (slc-observation 10 tie-lens 1 5 9007)
            (slc-observation 10 low-lens 1 4 9008)
            (slc-observation 10 same-lens 0 9 9009)))
    (let changed
        (slc-settle-situated "WE" "we" "what" 0 5 field 10 a 1))
    (let changed-time
        (slc-settle-situated "WE" "we" "what" 0 5 field 11 a 1))
    (let changed-point
        (slc-settle-situated
            "WE" "we" "what" 0 5 field 10 point-b 1))
    (let changed-direction
        (slc-settle-situated
            "WE" "we" "what" 0 5 field 10 direction-b 1))
    (let changed-intensity
        (slc-settle-situated
            "WE" "we" "what" 0 5 field 10 intensity-b 1))
    (let changed-focus
        (slc-settle-situated
            "WE" "we" "what" 0 5 field 10 focus-b 1))
    (let tied
        (slc-settle-situated
            "WE" "we" "what" 0 5 field 10 tie-lens 1))
    (let below
        (slc-settle-situated
            "WE" "we" "what" 0 5 field 10 low-lens 1))
    (let same
        (slc-settle-situated
            "WE" "we" "what" 0 5 field 10 same-lens 1))
    (let missing
        (slc-settle-situated
            "WE" "we" "what" 0 5 field 10 missing-lens 1))
    (let ambiguous-field
        (cons (slc-observation 10 a 0 8 9010) field))
    (let ambiguous
        (slc-settle-situated
            "WE" "we" "what" 0 5 ambiguous-field 10 a 1))
    (let excluded
        (slc-settle-situated "we" "WE" "what" 1 5 field 10 a 1))
    (let declined
        (slc-settle-situated "WE" "we" "what" 1 5 field 10 a 0))
    (let timeless-a
        (slc-settle-timeless "WE" "we" "what" 1 0 a 1))
    (let timeless-b
        (slc-settle-timeless "WE" "we" "what" 1 255 missing-lens 1))
    (let invalid
        (slc-settle-situated "WE" "we" "what" 0 5
            (list (slc-observation 10 a 1 -1 9001)) 10 a 1))

    ; 2097151 means all 21 observations held.
    (slcb-sum
        (list
            (slcb-bit (eq (slc-field-valid? field) 1) 1)
            (slcb-bit (eq (slc-lens-eq? a (cwi-lens 1 2 3 4)) 1) 2)
            (slcb-bit
                (and (eq (slc-o-conclusion changed) 1)
                     (eq (slc-o-changed changed) 1)) 4)
            (slcb-bit (eq (slc-o-conclusion changed-time) 0) 8)
            (slcb-bit (eq (slc-o-conclusion changed-point) 0) 16)
            (slcb-bit (eq (slc-o-conclusion changed-direction) 0) 32)
            (slcb-bit (eq (slc-o-conclusion changed-intensity) 0) 64)
            (slcb-bit (eq (slc-o-conclusion changed-focus) 0) 128)
            (slcb-bit
                (and (eq (slc-o-conclusion tied) 0)
                     (eq (slc-o-push tied) (slc-o-margin tied))) 256)
            (slcb-bit (eq (slc-o-conclusion below) 0) 512)
            (slcb-bit
                (and (eq (slc-o-conclusion same) 0)
                     (eq (slc-o-changed same) 0)) 1024)
            (slcb-bit
                (and (eq (slc-o-kind missing) (slc-tag-nothing))
                     (eq (slc-o-reason missing) 2)) 2048)
            (slcb-bit
                (and (eq (slc-o-kind ambiguous) (slc-tag-nothing))
                     (eq (slc-o-reason ambiguous) 3)) 4096)
            (slcb-bit
                (and (eq (slc-o-conclusion excluded) 0)
                     (eq (slc-o-reason excluded) 4)) 8192)
            (slcb-bit
                (and (eq (slc-o-conclusion declined) 0)
                     (eq (slc-o-reason declined) 5)) 16384)
            (slcb-bit
                (and (eq (slc-o-node timeless-a)
                         (slc-o-node timeless-b))
                     (eq (slc-o-conclusion timeless-a)
                         (slc-o-conclusion timeless-b))) 32768)
            (slcb-bit
                (not (eq (slc-o-node changed)
                         (slc-o-node changed-time))) 65536)
            (slcb-bit (eq (slc-o-source changed) 9001) 131072)
            (slcb-bit
                (and (eq (slc-o-kind invalid) (slc-tag-nothing))
                     (eq (slc-o-reason invalid) 1)) 262144)
            (slcb-bit (eq (slc-crosses? 5 5) 0) 524288)
            (slcb-bit (eq (cwi-root-geometry?) 1) 1048576))))
