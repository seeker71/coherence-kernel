; voice-g2p-bridge-band.fk — the model's IPA spoken in the voice's symbols: first the rules a made-up pair set holds BY
; CONSTRUCTION (so the learner is judged against what is known), then the real taught tables, held out.
;
; MADE-UP TRUTH (bits 1-8). The model "writes" g where the teacher writes G; N is n after a and m after u; a tie bar
; (U+0361) is never spelled by the teacher, so two pairs teach d-tie-zh -> d zh and the alignment has to choose between
; "the tie is deleted" and "the tie becomes zh"; p is taught as a stress mark and p; a symbol never seen passes through
; itself; a symbol the voice's table lacks is dropped and counted; the rows serialise and read back to the same answers.
;
; REAL TABLES (bits 9-15). The shipped bridge tables load; and the words of each taught tongue whose index is a
; multiple of five are HELD OUT of the fitting, the bridge is fitted on the rest, and what it makes of the held-out words
; is pinned with a tolerance: exact-word matches and symbol edit rate against the taught phonemes, stress, length and
; tie marks included. The numbers are what the run measured on 2026-10-03; they stand as ceilings and floors, not as
; claims of perfection: Persian stays poor on purpose (its taught phonemes were guessed from UNVOWELLED text) and the band
; says so.
; Expected: 32767
; Verdict 32767
; PROOF LEVEL: FKWU-STAGED (reads form/form-stdlib/data/g2p-*.tsv and the voices' .onnx.json)
; preludes: form/form-stdlib/voice-say.bml form/form-stdlib/voice-g2p-bridge.bml
(do
    (defn vb-bit (ok v) (if ok v 0))
    (defn T (s) (vgb-join-sep (split-on s " ")))
    (defn P (m t) (list m (T t)))
    (defn showl (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (str_concat "|" (showl (tail xs))))))
    (let pairs (list (P "ga" "G a") (P "gi" "G i") (P "gu" "G u") (P "ga" "G a")
                     (P "kaN" "k a n") (P "taN" "t a n") (P "kuN" "k u m") (P "tuN" "t u m")
                     (P "ka͡i" "k a i") (P "ta͡i" "t a i") (P "ka͡u" "k a u")
                     (P "d͡ʒa" "d ʒ a") (P "d͡ʒi" "d ʒ i")
                     (P "pa" "ˈ p a") (P "pi" "ˈ p i") (P "pu" "ˈ p u")))
    (let rows (vgb-learn-rows pairs))
    (let tab (vgb-rows-add (record_new 0) rows))
    (let valid (vgb-valid-add (record_new 0) (list "G" "a" "n" "u" "m" "i" "k" "t" "d" "ʒ" "p" "ˈ")))
    (let c1 (vb-bit (str_eq (showl (vgb-apply tab "ga")) "G|a|") 1))
    (let c2 (vb-bit (and (str_eq (showl (vgb-apply tab "gaN")) "G|a|n|") (str_eq (showl (vgb-apply tab "guN")) "G|u|m|")) 2))
    (let c3 (vb-bit (str_eq (showl (vgb-apply tab "d͡ʒu")) "d|ʒ|u|") 4))
    (let c4 (vb-bit (and (str_eq (showl (vgb-apply tab "puN")) "ˈ|p|u|m|") (str_eq (showl (vgb-apply tab "ta͡u")) "t|a|u|")) 8))
    (let c5 (vb-bit (str_eq (showl (vgb-apply tab "zaN")) "z|a|n|") 16))
    (let dm (vgb-map tab valid "gaz"))
    (let c6 (vb-bit (and (str_eq (showl (head dm)) "G|a|") (eq (head (tail dm)) 1)) 32))
    (let rt (vgb-learn-table pairs))
    (let c7 (vb-bit (and (str_eq (showl (vgb-apply rt "guN")) (showl (vgb-apply tab "guN"))) (gt (len rows) 8)) 64))
    (let sp (vgb-split (list (P "a" "A") (P "b" "B") (P "c" "C") (P "d" "D") (P "e" "E") (P "f" "F") (P "g" "G") (P "h" "H") (P "i" "I") (P "j" "J"))))
    (let c8 (vb-bit (and (eq (len (head sp)) 8) (eq (len (head (tail sp))) 2)) 128))
    ; ---- the real tables ----
    (defn rate (n d) (if (le d 0) 0 (div (mul n 10000) d)))
    (defn held (code)
        (do (let all (vgb-pairs-of code))
            (let s (vgb-split all))
            (let t (vgb-learn-table-for code (head s)))
            (let v (vgb-valid-of (vp-cfg (vs-voice code))))
            (list (vgb-eval t v (head (tail s))) (vgb-raw (head (tail s))))))
    (let hid (held "id"))
    (let hen (held "en"))
    (let hpt (held "pt"))
    (let hfa (held "fa"))
    (defn exact (r) (rate (nth (head r) 1) (nth (head r) 0)))
    (defn edit (r) (rate (nth (head r) 2) (nth (head r) 3)))
    (defn rawedit (r) (rate (nth (head (tail r)) 2) (nth (head (tail r)) 3)))
    (defn dropped (r) (nth (head r) 4))
    (defn rules (code) (div (len (record_keys (vgb-load code))) 2))
    (let c9 (vb-bit (and (gt (rules "en") 30) (and (gt (rules "pt") 30) (and (gt (rules "fa") 30) (gt (rules "id") 30)))) 256))
    ; measured 2026-10-04 (exact x10000 / edit rate x10000 / the model's own answer's edit rate): id 9957/5/182, en 8389/276/520,
    ; pt 8113/264/3983, fa 942/2573/5358. (2026-10-03, before the decision-list pick and the word-level stress: en 8050/330,
    ; pt 3660/1020.) The pins sit a little off the measure; Persian is pinned as POOR on both sides.
    (let c10 (vb-bit (and (ge (exact hid) 9800) (le (edit hid) 30)) 512))
    (let c11 (vb-bit (and (ge (exact hen) 8200) (le (edit hen) 320)) 1024))
    (let c12 (vb-bit (and (ge (exact hpt) 7800) (le (edit hpt) 320)) 2048))
    (let c13 (vb-bit (and (le (exact hfa) 1500) (and (ge (edit hfa) 2200) (le (edit hfa) 3000))) 4096))
    (let c14 (vb-bit (and (ge (rawedit hpt) 3500) (and (ge (rawedit hfa) 5000) (ge (rawedit hen) 450))) 8192))
    (let c15 (vb-bit (le (add (dropped hid) (add (dropped hen) (add (dropped hpt) (dropped hfa)))) 4) 16384))
    (print_str (str_concat "held-out id exact " (str_concat (int_to_str (exact hid)) (str_concat " edit " (str_concat (int_to_str (edit hid)) (str_concat " raw " (int_to_str (rawedit hid))))))))
    (print_str (str_concat "held-out en exact " (str_concat (int_to_str (exact hen)) (str_concat " edit " (str_concat (int_to_str (edit hen)) (str_concat " raw " (int_to_str (rawedit hen))))))))
    (print_str (str_concat "held-out pt exact " (str_concat (int_to_str (exact hpt)) (str_concat " edit " (str_concat (int_to_str (edit hpt)) (str_concat " raw " (int_to_str (rawedit hpt))))))))
    (print_str (str_concat "held-out fa exact " (str_concat (int_to_str (exact hfa)) (str_concat " edit " (str_concat (int_to_str (edit hfa)) (str_concat " raw " (int_to_str (rawedit hfa))))))))
    (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9 (add c10 (add c11 (add c12 (add c13 (add c14 c15)))))))))))))))
