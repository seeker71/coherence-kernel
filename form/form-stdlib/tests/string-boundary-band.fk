; tests/string-boundary-band.fk — the string addressing natives (substring, char_at,
; str_find) at and inside a multi-byte character.
;
; The body's one meaning is bytes, clamped, never dies. A string is bytes on every
; kernel; char_at is core.fk's recipe on fkwu,
; (substring s i (add i 1)), one byte. Indices are discovered through str_find and
; str_len, and only resulting string values are compared. The laws:
;
;   1. char_at at a found index is that one byte: the same string substring cuts.
;   2. adjacency at a char boundary: substring(s,0,m) + substring(s,m,len) == s; and
;      one byte INTO the char, the piece is those exact bytes — never a different
;      window.
;   3. concatenating char_at over every byte index rebuilds the string exactly.
;   4. find-next from inside a match reaches the next match.
;   5. find-next past the last match finds nothing.
;   6. laws 1-3 again across an astral character (4 UTF-8 bytes).
;
; Verdict 8 when every law holds, on all four kernels. The full statement at every
; byte offset of the real locale rows is substring-one-meaning-band.fk (4095, a drift gate).
;
; preludes: form-stdlib/core.fk

(do
    (defn sbb-rebuild (s i acc)
        (if (ge i (str_len s)) acc
            (sbb-rebuild s (add i 1) (str_concat acc (char_at s i)))))

    (let s "ab—cd—e")

    ;; 1. char_at is the one byte substring cuts
    (let dash1 (str_find s "—" 0))
    (let ok-char (if (str_eq (char_at s dash1) (substring s dash1 (add dash1 1))) 1 0))

    ;; 2. adjacency at the char boundary, and the one meaning one byte in
    (let m (add dash1 1))
    (let sev (substring s 0 m))
    (let ok-sev (if (str_eq sev (substring s 0 dash1)) 0 (if (str_eq sev "") 0 1)))
    (let ok-adj (if (str_eq (str_concat (substring s 0 dash1) (substring s dash1 (str_len s))) s)
                    ok-sev 0))

    ;; 3. bytewise char_at rebuild
    (let ok-rebuild (if (str_eq (sbb-rebuild s 0 "") s) 1 0))

    ;; 4. find-next from inside the first match reaches the second
    (let dash2 (str_find s "—" (add dash1 1)))
    (let ok-next (if (str_eq (substring s dash2 (str_len s)) "—e") 1 0))

    ;; 5. find-next past the second match finds nothing
    (let ok-end (if (lt (str_find s "—" (add dash2 1)) 0) 1 0))

    ;; 6. the same laws across an astral character (4 UTF-8 bytes)
    (let t "x🜂y")
    (let fire (str_find t "🜂" 0))
    (let ok-pair-char (if (str_eq (char_at t fire) (substring t fire (add fire 1))) 1 0))
    (let n (add fire 1))
    (let psev (substring t 0 n))
    (let ok-pair-sev (if (str_eq psev (substring t 0 fire)) 0 (if (str_eq psev "") 0 1)))
    (let ok-pair-adj (if (str_eq (str_concat (substring t 0 fire) (substring t fire (str_len t))) t)
                         ok-pair-sev 0))
    (let ok-pair-rebuild (if (str_eq (sbb-rebuild t 0 "") t) 1 0))

    ;; Band verdict: 8 when every law holds.
    (add ok-char (add ok-adj (add ok-rebuild (add ok-next (add ok-end
        (add ok-pair-char (add ok-pair-adj ok-pair-rebuild))))))))
