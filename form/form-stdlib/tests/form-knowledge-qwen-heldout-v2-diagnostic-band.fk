; form-knowledge-qwen-heldout-v2-diagnostic-band.fk -- pure one-row door proof.
;
; No model path, GPU call, resident generation, selector file, or consent file
; is touched. Synthetic report text proves only the parser/redaction boundary;
; it grants no live, ready95, family-coverage, or model-reasoning credit.
;
; Verdict 16383:
;   1     the scope explicitly withholds full-suite credit
;   2     consent binds the sealed dataset and selected row
;   4     one optional LF selects h01
;   8     multiline and unknown selectors refuse
;   16    consent for h03 cannot admit h01
;   32    an invalid current dataset refuses after consent
;   64    exact selector + consent + dataset admits exactly h01/axioms
;   128   scalar report metadata is extracted
;   256   absent two-ledger fields are explicit, never numeric zero
;   512   text after the report boundary cannot enter rendered metadata
;   1024  non-scalar and over-limit values are redacted
;   2048  gate refusal prints only bounded base fields + missing-field name
;   4096  the allowlist carries the complete two-ledger observation shape
;   8192  exact, token-F1, sequence and promotion remain separate scalars
;
; preludes: form-stdlib/form-knowledge-qwen-heldout-v2-diagnostic.fk

(do
    (defn fkhv2b-bit (ok bit) (if ok bit 0))
    (defn fkhv2b-find-field (name fields)
        (if (eq (len fields) 0) (list)
            (if (str_eq name (fkhv2-stage-name (head fields))) (head fields)
                (fkhv2b-find-field name (tail fields)))))
    (defn fkhv2b-long (n acc)
        (if (eq n 0) acc (fkhv2b-long (sub n 1) (str_concat acc "a"))))

    (let token1 (fkhv2-consent-token "h01"))
    (let token3 (fkhv2-consent-token "h03"))
    (let ready (fkhv2-plan-with 1 "h01\n" token1))
    (let wrong (fkhv2-plan-with 1 "h01" token3))
    (let stale (fkhv2-plan-with 0 "h01" token1))
    (let multiline (fkhv2-plan-with 1 "h01\n\n" token1))
    (let unknown (fkhv2-plan-with 1 "h99" (fkhv2-consent-token "h99")))

    (let fake
        (str_concat "choice-task=probe\nbackend=form-native-metal-jit"
        (str_concat "\ngenerated_tokens=80\nheed_cursor=bounded-current-source-v2"
        (str_concat "\nheed_query_budget=48\nheed_answer_reserve=32"
        (str_concat "\nheed_answer_tokens=7\nheed_evidence_reason=grounded-hit"
                    "\ntext:\nSECRET-PROMPT SECRET-ANSWER")))))
    (let records (fkhv2-stage-records fake))
    (let generated (fkhv2b-find-field "generated_tokens" records))
    (let answer (fkhv2b-find-field "heed_answer_tokens" records))
    (let query-left (fkhv2b-find-field "heed_query_left" records))
    (let rendered (fkhv2-stage-lines fake))

    (let unsafe
        (str_concat "choice-task=probe\nbackend=x\nheed_evidence_reason=answer leaked"
        (str_concat "\nheed_cursor=" (str_concat (fkhv2b-long 80 "")
                    "\ntext:\nSECRET"))))
    (let unsafe-records (fkhv2-stage-records unsafe))
    (let unsafe-reason (fkhv2b-find-field "heed_evidence_reason" unsafe-records))
    (let unsafe-cursor (fkhv2b-find-field "heed_cursor" unsafe-records))
    (let refusal (fkhv2-refusal-lines wrong))

    (let b1 (fkhv2b-bit
        (and (ge (str_find (fkhv2-scope) "no-full-suite-credit" 0) 0)
             (lt (str_find (fkhv2-scope) "ready95" 0) 0)) 1))
    (let b2 (fkhv2b-bit
        (and (ge (str_find token1 (fkhe-dataset-seal) 0) 0)
             (and (ge (str_find token1 ":h01" 0) 0)
                  (not (str_eq token1 token3)))) 2))
    (let b3 (fkhv2b-bit
        (and (str_eq (fkhv2-selector-id "h01\n") "h01")
             (str_eq (fkhe-id (fkhv2-selected-row "h01\n")) "h01")) 4))
    (let b4 (fkhv2b-bit
        (and (eq (fkhv2-plan-admitted multiline) 0)
             (eq (fkhv2-plan-admitted unknown) 0)) 8))
    (let b5 (fkhv2b-bit
        (and (eq (fkhv2-plan-admitted wrong) 0)
             (str_eq (fkhv2-plan-missing wrong)
                     "dataset-and-row-bound-v2-consent")) 16))
    (let b6 (fkhv2b-bit
        (and (eq (fkhv2-plan-admitted stale) 0)
             (str_eq (fkhv2-plan-missing stale)
                     "sealed-current-heldout-dataset")) 32))
    (let b7 (fkhv2b-bit
        (and (eq (fkhv2-plan-admitted ready) 1)
             (and (str_eq (fkhv2-plan-id ready) "h01")
                  (str_eq (fkhv2-plan-family ready) "axioms"))) 64))
    (let b8 (fkhv2b-bit
        (and (eq (fkhv2-stage-present generated) 1)
             (and (str_eq (fkhv2-stage-value generated) "80")
                  (str_eq (fkhv2-stage-value answer) "7"))) 128))
    (let b9 (fkhv2b-bit
        (and (eq (fkhv2-stage-present query-left) 0)
             (ge (str_find rendered "stage-missing-field=heed_query_left" 0) 0)) 256))
    (let b10 (fkhv2b-bit
        (and (lt (str_find rendered "SECRET-PROMPT" 0) 0)
             (and (lt (str_find rendered "SECRET-ANSWER" 0) 0)
                  (lt (str_find rendered "text:" 0) 0))) 512))
    (let b11 (fkhv2b-bit
        (and (str_eq (fkhv2-stage-value unsafe-reason)
                     "redacted-nonstage-value")
             (str_eq (fkhv2-stage-value unsafe-cursor)
                     "redacted-over-limit")) 1024))
    (let b12 (fkhv2b-bit
        (and (ge (str_find refusal "id=h01\nfamily=axioms" 0) 0)
             (and (ge (str_find refusal
                        "stage-missing-field=generation-report-absent-dataset-and-row-bound-v2-consent" 0) 0)
                  (and (lt (str_find refusal (fkhe-prompt (fkhv2-selected-row "h01")) 0) 0)
                       (lt (str_find refusal (fkhe-expected (fkhv2-selected-row "h01")) 0) 0)))) 2048))
    (let b13 (fkhv2b-bit
        (and (eq (fkhv2-stage-field-known? "heed_phase" (fkhv2-stage-fields)) 1)
        (and (eq (fkhv2-stage-field-known? "heed_query_budget" (fkhv2-stage-fields)) 1)
        (and (eq (fkhv2-stage-field-known? "heed_answer_reserve" (fkhv2-stage-fields)) 1)
        (and (eq (fkhv2-stage-field-known? "heed_query_tokens" (fkhv2-stage-fields)) 1)
        (and (eq (fkhv2-stage-field-known? "heed_answer_tokens" (fkhv2-stage-fields)) 1)
        (and (eq (fkhv2-stage-field-known? "heed_query_left" (fkhv2-stage-fields)) 1)
        (and (eq (fkhv2-stage-field-known? "heed_answer_left" (fkhv2-stage-fields)) 1)
        (and (eq (fkhv2-stage-field-known? "heed_query_fuel_cut" (fkhv2-stage-fields)) 1)
        (and (eq (fkhv2-stage-field-known? "heed_stream_bytes" (fkhv2-stage-fields)) 1)
        (and (eq (fkhv2-stage-field-known? "heed_decode_timeout" (fkhv2-stage-fields)) 1)
        (and (eq (fkhv2-stage-field-known? "heed_stopped" (fkhv2-stage-fields)) 1)
             (eq (fkhv2-stage-field-known? "heed_frame_refusals" (fkhv2-stage-fields)) 1)))))))))))) 4096))
    (let scalar-scores
        (fkhv2-base-lines "h03" "form-stdlib"
            0 545455 333333 333333 0 1007807))
    (let b14 (fkhv2b-bit
        (and (ge (str_find scalar-scores "exact-ppm=0\n" 0) 0)
         (and (ge (str_find scalar-scores "f1-ppm=545455\n" 0) 0)
          (and (ge (str_find scalar-scores "sequence-ppm=333333\n" 0) 0)
               (ge (str_find scalar-scores "promotion-ppm=333333\n" 0) 0)))) 8192))

    (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7
        (add b8 (add b9 (add b10 (add b11 (add b12 (add b13 b14))))))))))))))
