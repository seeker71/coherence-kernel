; tests/bml-hati-native-lane-parity-proof.fk
;
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk
;
; The BMA reference lane and the Hati native lane read one scope rule: a
; callee's body resolves its names in the callee's own unit (its package, its
; imports, its methods and consts, its parameters), never in the caller's.
; An imported method that calls its own unit's helpers therefore runs on both
; lanes, a caller's parameter stays invisible to a callee, and calls select
; their overload by arity on both lanes. Each source runs on both lanes and
; must give one answer: the value, or the same named refusal.

(do
    ; the canonical sources live in tests/fixtures, one program to a file
    (defn lp-node (name)
        (bml-source-exec-parse-node
            (bml-source-parse-executable-stream
                (bml-source-scan-file (str_concat "form-stdlib/tests/fixtures/" name)))))

    (defn lp-equal (node units expected)
        (do
            (let on-bma (bml-bma-run-unit-value node units))
            (let on-hati (bml-hati-run-unit-value node units))
            (if (value_eq on-bma on-hati)
                (if (value_eq on-hati expected) 1 0)
                0)))

    (let bmf-unit
        (lp-node "bml-lanes-unit-bmf.bml"))
    (let deep-unit
        (lp-node "bml-import-unit-deep.bml"))
    (let lib-unit
        (lp-node "bml-lanes-unit-lib.bml"))
    (let units (list bmf-unit deep-unit lib-unit))

    (sum
        (list
            (lp-equal (lp-node "bml-import-transitive.bml") units 42)
            (lp-equal (lp-node "bml-lanes-callee-own-scope.bml") units 42)
            (lp-equal (lp-node "bml-lanes-callee-helper-hidden.bml") units "BML-HATI-UNSUPPORTED call/unbound")
            (lp-equal (lp-node "bml-lanes-caller-param-hidden.bml") (empty) "BML-HATI-UNSUPPORTED name/unbound")
            (lp-equal (lp-node "bml-consts-own-unit.bml") (empty) 42)
            (lp-equal (lp-node "bml-calls-arity-overloads.bml") (empty) 42)
            (lp-equal (lp-node "bml-lanes-imported-overloads.bml") units 42)
            (lp-equal (lp-node "bml-calls-short-arity.bml") (empty) "BML-HATI-UNSUPPORTED call/arity")
            (lp-equal (lp-node "bml-names-const-called.bml") (empty) "BML-HATI-UNSUPPORTED call/not-method")
            (lp-equal (lp-node "bml-names-method-as-value.bml") (empty) "BML-HATI-UNSUPPORTED name/method")
            (lp-equal (lp-node "bml-lanes-qualified-twice.bml") (empty) 42)
            (lp-equal (lp-node "bml-lanes-local-assign.bml") (empty) 42)
            (lp-equal (lp-node "bml-lanes-local-const.bml") (empty) 42)
            (lp-equal (lp-node "bml-lanes-imported-nested.bml") units 42))))
