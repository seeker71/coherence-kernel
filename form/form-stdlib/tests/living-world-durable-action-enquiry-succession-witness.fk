; living-world-durable-action-enquiry-succession-witness.fk -- a fresh source
; may join an unresolved question without inheriting action authority.
;
; The newcomer can place a stance in the shared field before joining, but that
; stance is not question evidence.  Only its explicit re-offer of the exact
; current question makes its own active stance attribution eligible.  It may
; then add another stance, revoke the earlier one, or revoke its question
; re-offer and leave every historical stance intact.  None of those movements
; selects or executes an action.
; witnessed: 2026-08-08 -> 32767/65535/65535 across three fresh fkwu processes
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-action-enquiry.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk form-stdlib/tests/living-world-action-enquiry-witness.fk form-stdlib/tests/living-world-durable-action-enquiry-witness.fk

(let LWDAES-SOURCE-J   (bp "LWDAES-SOURCE-J"))
(let LWDAES-PROV-J     (bp "LWDAES-PROV-J"))
(let LWDAES-EVIDENCE-A (bp "LWDAES-EVIDENCE-A"))
(let LWDAES-EVIDENCE-B (bp "LWDAES-EVIDENCE-B"))

(defn lwdaes-cell (kind) (intern_node kind (empty)))
(defn lwdaes-source-j () (lwdaes-cell LWDAES-SOURCE-J))
(defn lwdaes-prov-j () (lwdaes-cell LWDAES-PROV-J))
(defn lwdaes-evidence-a () (lwdaes-cell LWDAES-EVIDENCE-A))
(defn lwdaes-evidence-b () (lwdaes-cell LWDAES-EVIDENCE-B))

(defn lwdaes-after-path ()
    "/tmp/coherence-living-world-durable-action-enquiry-succession-v1.ccs")

(defn lwdaes-remove-path (path)
    (if (eq (fs-exists? path) 1) (fs-remove-file path) 0))

(defn lwdaes-clean-after ()
    (do
        (lwdaes-remove-path (lwdaes-after-path))
        (lwdaes-remove-path (lwcd-pending-path (lwdaes-after-path)))))

(defn lwdaes-clean-all ()
    (do (lwdaeq-clean) (lwdaes-clean-after)))

(defn lwdaes-entry (payload)
    (lwacw-entry-for (lwdaes-source-j) (lwdaes-prov-j) payload))

(defn lwdaes-revocation-entry (payload)
    (lwdaes-entry
        (lwo-revocation payload (lwdaes-source-j)
            (lwrew-action) (lwdaes-prov-j))))

(defn lwdaes-question-for (world)
    (lwdaeq-only (lwdaeq-questions world)))

; A dissenting alternative with a live layered lens and an explicit unknown.
; These fields are optional; their presence here is participant-authored data.
(defn lwdaes-alternative-stance (question)
    (lwae-stance question (oac-zero) (lwo-none)
        (lwaew-layered-declaration)
        (lwo-field (list (lwacw-action-a) (lwacw-action-b)))
        (lwlc-unknown (lwdaes-evidence-a))
        (lwdaes-evidence-a)))

; A later immediate abstention.  It does not erase or reinterpret the earlier
; stance; source-scoped revocation performs that movement separately.
(defn lwdaes-abstain-stance (question)
    (lwae-stance question (oac-nothing) (lwo-none) (lwo-none)
        (lwo-empty-field) (lwo-none) (lwdaes-evidence-b)))

(defn lwdaes-unjoined-world (world)
    (do
        (let question (lwdaes-question-for world))
        (lwt-receive-stream world
            (list (lwdaes-entry
                    (lwdaes-alternative-stance question))))))

(defn lwdaes-joined-world (world)
    (do
        (let question (lwdaes-question-for world))
        (lwt-receive-stream world
            (list (lwdaes-entry question)
                  (lwdaes-entry
                    (lwdaes-alternative-stance question))))))

(defn lwdaes-revised-world (world)
    (do
        (let question (lwdaes-question-for world))
        (lwt-receive-stream world
            (list (lwdaes-entry
                    (lwdaes-abstain-stance question))))))

(defn lwdaes-successor-world (world)
    (do
        (let question (lwdaes-question-for world))
        (lwt-receive-stream world
            (list (lwdaes-revocation-entry
                    (lwdaes-alternative-stance question))))))

(defn lwdaes-departed-world (world)
    (do
        (let question (lwdaes-question-for world))
        (lwt-receive-stream world
            (list (lwdaes-revocation-entry question)))))

(defn lwdaes-field-contained-items? (items field)
    (if (eq (len items) 0) 1
        (if (eq (lwo-field-has? field (head items)) 0) 0
            (lwdaes-field-contained-items? (tail items) field))))

(defn lwdaes-field-contained? (before after)
    (lwdaes-field-contained-items?
        (lwo-field-items before) after))

(defn lwdaes-evidence-for-stance-items (items stance)
    (if (eq (len items) 0) (lwo-none)
        (if (node_eq
                (lwae-stance-evidence-stance (head items)) stance)
            (head items)
            (lwdaes-evidence-for-stance-items (tail items) stance))))

(defn lwdaes-evidence-for-stance (world question stance)
    (lwdaes-evidence-for-stance-items
        (lwo-field-items (lwae-stance-evidence-for world question)) stance))

(defn lwdaes-evidence-without-stance-items (items stance acc)
    (if (eq (len items) 0) acc
        (if (node_eq
                (lwae-stance-evidence-stance (head items)) stance)
            (lwdaes-evidence-without-stance-items
                (tail items) stance acc)
            (lwdaes-evidence-without-stance-items
                (tail items) stance (lwo-field-add acc (head items))))))

(defn lwdaes-evidence-without-stance (evidence stance)
    (lwdaes-evidence-without-stance-items
        (lwo-field-items evidence) stance (lwo-empty-field)))

(defn lwdaes-response-entries-except-items
    (proposal items omitted)
    (if (eq (len items) 0) (list)
        (if (node_eq (head items) omitted)
            (lwdaes-response-entries-except-items
                proposal (tail items) omitted)
            (cons (lwdaeq-response-entry proposal (head items))
                (lwdaes-response-entries-except-items
                    proposal (tail items) omitted)))))

(defn lwdaes-response-entries-except (proposal omitted)
    (lwdaes-response-entries-except-items proposal
        (lwo-field-items (lwt-proposal-participants proposal)) omitted))

(defn lwdaes-abstaining-restore-round (image)
    (do
        (let admission (lwdaeq-admission-world image))
        (let proposal (lwcn-restore-proposal admission image))
        (let round
            (lwt-round-receive
                (lwt-round admission (lwo-field (list proposal))
                    (lwo-empty-field) (lwo-none))
                (lwdaes-response-entries-except
                    proposal (lwdaes-source-j))))
        (lwcn-integrate-restore round proposal (lwrew-action))))

(defn lwdaes-save-after (world)
    (lwcd-save-new (lwdaes-after-path) (lwcn-image world) (lwo-none)))

(defn lwdaes-load-after ()
    (lwcd-load (lwdaes-after-path) (lwo-none)))
