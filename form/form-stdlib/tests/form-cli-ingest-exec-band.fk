; form-cli-ingest-exec-band.fk — ingest observation is the cell's return.
;
; Verdict 1023:
;   1..128  fie-check (same=1, diff=2, deep 3/1, nbo 0/1/2, observe strings)
;   256     class descriptor FormIngestExec minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/equivalence-collapse.fk form-stdlib/knowledge-ingest.fk
; preludes: ingest/name-build-observe.fk
; preludes: form-stdlib/form-cli-ingest-exec.bml
; witnessed: 2026-08-26 -> 1023; same=1 diff=2; ki-deep 3=1 1=0; nbo 0/1/2

(do
    (defn fieb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn fieb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (fieb-has-name? (tail xs) name))))

    (let bits (fie-check))
    (let desc (FormIngestExec))
    (let src (read_file "form/form-stdlib/bml/form-cli-ingest-exec.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormIngestExec")
                     (and (eq (fieb-has-name? (nth desc 2) "T") 1)
                          (and (eq (fieb-has-name? (nth desc 3) "fie-same") 1)
                               (eq (fieb-has-name? (nth desc 4) "SameCells") 1))))
                256 0))
    (let b9 (if (and (eq (fieb-has-str? src "package Form.cli.ingestexec") 1)
                     (and (eq (fieb-has-str? src "interface IIngestExec") 1)
                          (and (eq (fieb-has-str? src "class FormIngestExec") 1)
                               (and (eq (fieb-has-str? src "const int SameCells") 1)
                                    (eq (fieb-has-str? src "template ExecHit") 1)))))
                512 0))
    (add bits (add b8 b9)))
