; Isolate DS4's 43 layer records and file-backed Metal handles from pipeline
; compilation and token generation, using the already sealed Form manifest.
; preludes: native/metal/dsv4-decode-stack.fk
(do
  (let path "/Users/ursmuff/models/ds4-engine/gguf/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf")
  (let src (dfd-src path))
  (let loaded (dfd-stt-cache-load path src))
  (let tab (nth loaded 1))
  (let nlayers 43)
  (let ratios (dfd-st-ratios src (add nlayers 1)))
  (let hashn (dfd-st-hashcount src))
  (let layer-tabs (dfd-stt-layer-tabs tab))
  (let layers (dfd-st-build layer-tabs path 0 nlayers hashn 512 ratios))
  (let ready (dfd-layers-constructed layers nlayers))
  (list (nothing) 1001100002 (nth loaded 0) (len tab) (len layers) ready
        (metal_status)
        (if (and (eq (nth loaded 0) 1) (and (eq (len layers) 43) (eq ready 1))) 1 0)))
