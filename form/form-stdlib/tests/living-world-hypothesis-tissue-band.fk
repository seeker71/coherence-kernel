; living-world-hypothesis-tissue-band.fk -- unequal held-out contexts form
; differentiation tissue without deleting the contradicted generated Recipe.
; Verdict 32767 proves fifteen recurrence, plurality, and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk

(defn lwhtfb-receipt-for (items hypothesis)
    (if (eq (len items) 0) (lwo-none)
        (if (node_eq
                (lwht-receipt-hypothesis (head items)) hypothesis)
            (head items)
            (lwhtfb-receipt-for (tail items) hypothesis))))

(do
    (let fixture (lwhtw-integrated-tissue))
    (let history (lwhtw-tissue-history fixture))
    (let field-fixture (lwhtw-history-field history))
    (let field (lwphw-field-shape field-fixture))
    (let field-candidate (lwphw-field-candidate field-fixture))
    (let first
        (lwphw-probe-placement (lwhtw-history-first history)))
    (let second
        (lwphw-probe-placement (lwhtw-history-second history)))
    (let tissue (lwhtw-tissue-shape fixture))
    (let candidate (lwhtw-tissue-candidate fixture))
    (let world (lwt-round-world (lwhtw-tissue-round fixture)))
    (let forward (lwhtw-forward-hypothesis fixture))
    (let reverse (lwhtw-reverse-hypothesis fixture))
    (let forward-receipt
        (lwhtfb-receipt-for
            (lwo-field-items (lwht-tissue-receipts tissue)) forward))
    (let reverse-receipt
        (lwhtfb-receipt-for
            (lwo-field-items (lwht-tissue-receipts tissue)) reverse))
    (let threshold-three (lwht-tissue-for world field-candidate 3))
    (let revoked (lwhtw-revoked-second-probe-world fixture))
    (let successor (lwht-tissue-for revoked field-candidate 2))

    (let c1
        (if (and (eq (lwph-plural? (lwph-field-status field)) 1)
                 (and (eq (lwo-field-size
                              (lwph-field-consistent field)) 2)
                      (eq (lwo-field-size
                              (lwph-field-refuted field)) 0))) 1 0))
    (let c2
        (if (and (eq (lwph-discriminated?
                         (lwph-placement-status first)) 1)
                 (and (eq (lwo-field-size
                              (lwph-placement-confirmed first)) 1)
                      (and (eq (lwo-field-size
                                  (lwph-placement-diverged first)) 1)
                           (eq (lwo-field-size
                                  (lwph-placement-outputs first)) 2)))) 2 0))
    (let c3
        (if (and (eq (lwph-discriminated?
                         (lwph-placement-status second)) 1)
                 (and (eq (lwo-field-size
                              (lwph-placement-confirmed second)) 1)
                      (and (eq (lwo-field-size
                                  (lwph-placement-diverged second)) 1)
                           (eq (lwo-field-size
                                  (lwph-placement-outputs second)) 2)))) 4 0))
    (let c4
        (if (and (eq (lwo-field-size
                         (lwht-tissue-placements tissue)) 2)
                 (eq (lwo-field-size
                         (lwht-tissue-receipts tissue)) 2)) 8 0))
    (let c5
        (if (and (eq (lwht-coherent?
                         (lwht-tissue-status tissue)) 1)
                 (and (eq (lwo-field-size
                              (lwht-tissue-compatible tissue)) 1)
                      (and (eq (lwo-field-size
                                  (lwht-tissue-contradicted tissue)) 1)
                           (eq (lwo-field-size
                                  (lwht-tissue-unresolved tissue)) 0)))) 16 0))
    (let c6
        (if (and (eq (lwo-field-has?
                         (lwht-tissue-hypotheses tissue) forward) 1)
                 (eq (lwo-field-has?
                         (lwht-tissue-hypotheses tissue) reverse) 0)) 32 0))
    (let c7
        (if (and (eq (lwo-field-size
                         (lwht-receipt-confirmed forward-receipt)) 2)
                 (and (eq (lwo-field-size
                              (lwht-receipt-contradicted
                                  forward-receipt)) 0)
                      (eq (lwph-consistent?
                              (lwht-receipt-state forward-receipt)) 1))) 64 0))
    (let c8
        (if (and (eq (lwo-field-size
                         (lwht-receipt-confirmed reverse-receipt)) 0)
                 (and (eq (lwo-field-size
                              (lwht-receipt-contradicted
                                  reverse-receipt)) 2)
                      (eq (lwph-divergent?
                              (lwht-receipt-state reverse-receipt)) 1))) 128 0))
    (let c9
        (if (and (eq (lwht-candidate? candidate) 1)
                 (and (node_eq (lwo-emergent-shape candidate) tissue)
                      (eq (lwht-integrated-current? world candidate) 1))) 256 0))
    (let c10
        (if (and (eq (lwo-field-size
                         (lwht-tissue-compatible threshold-three)) 0)
                 (and (eq (lwo-field-size
                              (lwht-tissue-unresolved threshold-three)) 1)
                      (eq (lwo-field-size
                              (lwht-tissue-contradicted
                                  threshold-three)) 1))) 512 0))
    (let c11
        (if (and (eq (lwo-field-has?
                         (lwht-tissue-alternatives tissue)
                         (lwph-hypothesis-recipe forward)) 1)
                 (eq (lwo-field-has?
                         (lwht-tissue-alternatives tissue)
                         (lwph-hypothesis-recipe reverse)) 1)) 1024 0))
    (let c12
        (if (and (gt (lwo-field-size
                         (lwht-tissue-unknowns tissue)) 0)
                 (and (gt (lwo-field-size
                              (lwht-receipt-unknowns forward-receipt)) 0)
                      (gt (lwo-field-size
                              (lwht-receipt-unknowns reverse-receipt)) 0))) 2048 0))
    (let c13
        (if (and (gt (lwo-field-size
                         (lwht-tissue-witnesses tissue)) 0)
                 (gt (lwo-field-size
                        (lwt-sources-from-attributions
                            (lwo-field-items
                                (lwht-tissue-witnesses tissue))
                            (lwo-empty-field))) 0)) 4096 0))
    (let c14
        (if (and (eq (lwo-active? revoked candidate) 1)
                 (and (eq (lwht-candidate-current?
                              revoked candidate) 0)
                      (eq (lwht-integrated-current?
                              revoked candidate) 0))) 8192 0))
    (let c15
        (if (and (eq (lwph-integrated-current?
                         revoked field-candidate) 1)
                 (and (eq (lwo-field-size
                              (lwht-tissue-placements successor)) 1)
                      (and (eq (lwo-field-size
                                  (lwht-tissue-compatible successor)) 0)
                           (eq (lwo-field-size
                                  (lwht-tissue-receipts successor)) 2))))
            16384 0))
    (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7
        (add c8 (add c9 (add c10 (add c11 (add c12 (add c13
            (add c14 c15)))))))))))))))
