; living-world-operation-field-witness.fk -- behavior classes narrow and reopen.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk form-stdlib/living-world-operation-field.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-structural-recipe-witness.fk

(let LWOEW-BASE-FIXTURE     (bp "LWOEW-BASE-FIXTURE"))
(let LWOEW-EVOLVED-FIXTURE  (bp "LWOEW-EVOLVED-FIXTURE"))
(let LWOEW-FOCUS            (bp "LWOEW-FOCUS"))
(let LWOEW-EVIDENCE         (bp "LWOEW-EVIDENCE"))
(let LWOEW-ALTERNATIVE      (bp "LWOEW-ALTERNATIVE"))
(let LWOEW-REASON           (bp "LWOEW-REASON"))
(let LWOEW-E1-SCOPE         (bp "LWOEW-E1-SCOPE"))
(let LWOEW-E1-FIRST         (bp "LWOEW-E1-FIRST"))
(let LWOEW-E1-SECOND        (bp "LWOEW-E1-SECOND"))
(let LWOEW-E2-SCOPE         (bp "LWOEW-E2-SCOPE"))
(let LWOEW-E2-FIRST         (bp "LWOEW-E2-FIRST"))
(let LWOEW-E2-SECOND        (bp "LWOEW-E2-SECOND"))
(let LWOEW-Q-SCOPE          (bp "LWOEW-Q-SCOPE"))
(let LWOEW-Q-FIRST          (bp "LWOEW-Q-FIRST"))
(let LWOEW-Q-SECOND         (bp "LWOEW-Q-SECOND"))

(defn lwoew-cell (kind) (intern_node kind (empty)))
(defn lwoew-focus () (lwoew-cell LWOEW-FOCUS))
(defn lwoew-evidence () (lwoew-cell LWOEW-EVIDENCE))
(defn lwoew-alternative () (lwoew-cell LWOEW-ALTERNATIVE))
(defn lwoew-reason () (lwoew-cell LWOEW-REASON))
(defn lwoew-e1-scope () (lwoew-cell LWOEW-E1-SCOPE))
(defn lwoew-e1-first-source () (lwoew-cell LWOEW-E1-FIRST))
(defn lwoew-e1-second-source () (lwoew-cell LWOEW-E1-SECOND))
(defn lwoew-e2-scope () (lwoew-cell LWOEW-E2-SCOPE))
(defn lwoew-e2-first-source () (lwoew-cell LWOEW-E2-FIRST))
(defn lwoew-e2-second-source () (lwoew-cell LWOEW-E2-SECOND))
(defn lwoew-q-scope () (lwoew-cell LWOEW-Q-SCOPE))
(defn lwoew-q-first-source () (lwoew-cell LWOEW-Q-FIRST))
(defn lwoew-q-second-source () (lwoew-cell LWOEW-Q-SECOND))

(defn lwoew-enquiry ()
    (lwph-enquiry (lwoew-focus)
        (lwo-field (list (lwoew-alternative)))
        (lwlc-unknown (lwoew-evidence)) (lwoew-evidence)))
(defn lwoew-add ()
    (lwph-operator (lwoew-enquiry) "add" (lwoew-evidence)))
(defn lwoew-mul ()
    (lwph-operator (lwoew-enquiry) "mul" (lwoew-evidence)))
(defn lwoew-sub ()
    (lwph-operator (lwoew-enquiry) "sub" (lwoew-evidence)))

(defn lwoew-first-role (schema-fixture)
    (lwsrw-first-role schema-fixture))
(defn lwoew-second-role (schema-fixture)
    (lwsrw-second-role schema-fixture))
(defn lwoew-role-order (first second)
    (lwsr-role-sequence (list first second)))
(defn lwoew-carrier (operator first second)
    (lwoe-carrier (lwoew-enquiry) operator
        (lwoew-role-order first second)
        (lwo-field (list (lwoew-alternative)))
        (lwlc-unknown (lwoew-evidence)) (lwoew-evidence)))
(defn lwoew-add-forward (schema-fixture)
    (lwoew-carrier (lwoew-add)
        (lwoew-first-role schema-fixture)
        (lwoew-second-role schema-fixture)))
(defn lwoew-add-reverse (schema-fixture)
    (lwoew-carrier (lwoew-add)
        (lwoew-second-role schema-fixture)
        (lwoew-first-role schema-fixture)))
(defn lwoew-mul-forward (schema-fixture)
    (lwoew-carrier (lwoew-mul)
        (lwoew-first-role schema-fixture)
        (lwoew-second-role schema-fixture)))
(defn lwoew-mul-reverse (schema-fixture)
    (lwoew-carrier (lwoew-mul)
        (lwoew-second-role schema-fixture)
        (lwoew-first-role schema-fixture)))
(defn lwoew-sub-forward (schema-fixture)
    (lwoew-carrier (lwoew-sub)
        (lwoew-first-role schema-fixture)
        (lwoew-second-role schema-fixture)))
(defn lwoew-sub-reverse (schema-fixture)
    (lwoew-carrier (lwoew-sub)
        (lwoew-second-role schema-fixture)
        (lwoew-first-role schema-fixture)))
(defn lwoew-carriers (schema-fixture)
    (lwo-field
        (list
            (lwoew-add-forward schema-fixture)
            (lwoew-add-reverse schema-fixture)
            (lwoew-mul-forward schema-fixture)
            (lwoew-mul-reverse schema-fixture)
            (lwoew-sub-forward schema-fixture)
            (lwoew-sub-reverse schema-fixture))))
(defn lwoew-codecs (schema-fixture)
    (lwo-field
        (list
            (lwsr-codec (lwoew-first-role schema-fixture) "r"
                (lwo-empty-field) (lwo-none) (lwoew-evidence))
            (lwsr-codec (lwoew-second-role schema-fixture) "s"
                (lwo-field (list (lwoew-alternative)))
                (lwlc-unknown (lwoew-evidence))
                (lwoew-evidence)))))

(defn lwoew-projection (scope source value alternatives unknown)
    (lwre-projection scope source (intern_trivial_int value)
        alternatives unknown (lwoew-evidence)))
(defn lwoew-value (role projection alternatives unknown)
    (lwsr-value role projection alternatives unknown (lwoew-evidence)))

(defn lwoew-e1-first-projection ()
    (lwoew-projection (lwoew-e1-scope) (lwoew-e1-first-source) 2
        (lwo-empty-field) (lwo-none)))
(defn lwoew-e1-second-projection ()
    (lwoew-projection (lwoew-e1-scope) (lwoew-e1-second-source) 2
        (lwo-field (list (lwoew-alternative)))
        (lwlc-unknown (lwoew-evidence))))
(defn lwoew-e1-first-value (schema-fixture)
    (lwoew-value (lwoew-first-role schema-fixture)
        (lwoew-e1-first-projection) (lwo-empty-field) (lwo-none)))
(defn lwoew-e1-second-value (schema-fixture)
    (lwoew-value (lwoew-second-role schema-fixture)
        (lwoew-e1-second-projection)
        (lwo-field (list (lwoew-alternative)))
        (lwlc-unknown (lwoew-evidence))))
(defn lwoew-e1-values (schema-fixture)
    (lwo-field
        (list
            (lwoew-e1-first-value schema-fixture)
            (lwoew-e1-second-value schema-fixture))))
(defn lwoew-example-one (schema-fixture)
    (lwoe-example (lwoew-enquiry) (lwoew-e1-values schema-fixture)
        (intern_trivial_int 4) (oac-one (intern_trivial_int 4))
        (lwo-field (list (lwoew-alternative)))
        (lwlc-unknown (lwoew-evidence)) (lwoew-evidence)))

(defn lwoew-e2-first-projection ()
    (lwoew-projection (lwoew-e2-scope) (lwoew-e2-first-source) 3
        (lwo-empty-field) (lwo-none)))
(defn lwoew-e2-second-projection ()
    (lwoew-projection (lwoew-e2-scope) (lwoew-e2-second-source) 4
        (lwo-field (list (lwoew-alternative)))
        (lwlc-unknown (lwoew-evidence))))
(defn lwoew-e2-first-value (schema-fixture)
    (lwoew-value (lwoew-first-role schema-fixture)
        (lwoew-e2-first-projection) (lwo-empty-field) (lwo-none)))
(defn lwoew-e2-second-value (schema-fixture)
    (lwoew-value (lwoew-second-role schema-fixture)
        (lwoew-e2-second-projection)
        (lwo-field (list (lwoew-alternative)))
        (lwlc-unknown (lwoew-evidence))))
(defn lwoew-e2-values (schema-fixture)
    (lwo-field
        (list
            (lwoew-e2-first-value schema-fixture)
            (lwoew-e2-second-value schema-fixture))))
(defn lwoew-example-two (schema-fixture)
    (lwoe-example (lwoew-enquiry) (lwoew-e2-values schema-fixture)
        (intern_trivial_int 7) (oac-one (intern_trivial_int 7))
        (lwo-field (list (lwoew-alternative)))
        (lwlc-unknown (lwoew-evidence)) (lwoew-evidence)))
(defn lwoew-silence-example (schema-fixture)
    (lwoe-example (lwoew-enquiry) (lwoew-e2-values schema-fixture)
        (lwo-none) (oac-nothing)
        (lwo-field (list (lwoew-alternative)))
        (lwlc-unknown (lwoew-evidence)) (lwoew-evidence)))
(defn lwoew-zero-example (schema-fixture)
    (lwoe-example (lwoew-enquiry) (lwoew-e2-values schema-fixture)
        (lwo-none) (oac-zero)
        (lwo-field (list (lwoew-alternative)))
        (lwlc-unknown (lwoew-evidence)) (lwoew-evidence)))

(defn lwoew-q-first-projection ()
    (lwoew-projection (lwoew-q-scope) (lwoew-q-first-source) 8
        (lwo-empty-field) (lwo-none)))
(defn lwoew-q-second-projection ()
    (lwoew-projection (lwoew-q-scope) (lwoew-q-second-source) 5
        (lwo-field (list (lwoew-alternative)))
        (lwlc-unknown (lwoew-evidence))))
(defn lwoew-q-first-value (schema-fixture)
    (lwoew-value (lwoew-first-role schema-fixture)
        (lwoew-q-first-projection) (lwo-empty-field) (lwo-none)))
(defn lwoew-q-second-value (schema-fixture)
    (lwoew-value (lwoew-second-role schema-fixture)
        (lwoew-q-second-projection)
        (lwo-field (list (lwoew-alternative)))
        (lwlc-unknown (lwoew-evidence))))
(defn lwoew-q-values (schema-fixture)
    (lwo-field
        (list
            (lwoew-q-first-value schema-fixture)
            (lwoew-q-second-value schema-fixture))))
(defn lwoew-choice ()
    (lwlc-choice (lwo-none)
        (lwo-field (list (lwoew-alternative)))
        (lwlc-unknown (lwoew-evidence)) (lwoew-evidence)))
(defn lwoew-timeout (candidate)
    (oac-timeout (intern_trivial_int 10)
        (oac-alternative-ack candidate
            (lwoew-alternative) (lwoew-evidence))
        (lwoew-evidence)))
(defn lwoew-rich-query (candidate schema-fixture)
    (lwoe-query candidate (lwoew-q-values schema-fixture)
        (lwo-field (list (lwoew-alternative)))
        (lwlc-unknown (lwoew-evidence))
        (lwoew-choice) (lwoew-timeout candidate) (lwoew-evidence)))
(defn lwoew-minimal-query (candidate schema-fixture)
    (lwoe-query candidate (lwoew-q-values schema-fixture)
        (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none)
        (lwoew-evidence)))

(defn lwoew-base-entry-items (schema-fixture)
    (do
        (let carriers (lwo-field-items (lwoew-carriers schema-fixture)))
        (let codecs (lwo-field-items (lwoew-codecs schema-fixture)))
        (list
            (lwphw-entry-a (lwoew-focus))
            (lwphw-entry-b (lwoew-enquiry))
            (lwphw-entry-c (lwoew-add))
            (lwphw-entry-c (lwoew-mul))
            (lwphw-entry-c (lwoew-sub))
            (lwphw-entry-d (nth codecs 0))
            (lwphw-entry-d (nth codecs 1))
            (lwphw-entry-e (nth carriers 0))
            (lwphw-entry-f (nth carriers 0))
            (lwphw-entry-e (nth carriers 1))
            (lwphw-entry-f (nth carriers 1))
            (lwphw-entry-e (nth carriers 2))
            (lwphw-entry-f (nth carriers 2))
            (lwphw-entry-e (nth carriers 3))
            (lwphw-entry-f (nth carriers 3))
            (lwphw-entry-e (nth carriers 4))
            (lwphw-entry-f (nth carriers 4))
            (lwphw-entry-e (nth carriers 5))
            (lwphw-entry-f (nth carriers 5))
            (lwphw-entry-g (lwoew-e1-scope))
            (lwphw-entry-g (lwoew-e1-first-source))
            (lwphw-entry-g (lwoew-e1-second-source))
            (lwphw-entry-g (lwoew-e1-first-projection))
            (lwphw-entry-g (lwoew-e1-second-projection))
            (lwphw-entry-g (lwoew-e1-first-value schema-fixture))
            (lwphw-entry-g (lwoew-e1-second-value schema-fixture))
            (lwphw-entry-h (lwoew-example-one schema-fixture))
            (lwphw-entry-i (lwoew-example-one schema-fixture)))))
(defn lwoew-base-world (schema-fixture)
    (lwt-receive-stream
        (lwt-round-world (lwsrw-schema-round schema-fixture))
        (lwoew-base-entry-items schema-fixture)))
(defn lwoew-integrate-field (world schema-fixture previous)
    (do
        (let proposal
            (lwoe-proposal world (lwoew-enquiry)
                (lwoew-codecs schema-fixture) 2))
        (let answered (lwphw-answered-round world proposal previous))
        (lwoe-integrate answered proposal (lwphw-action))))

(defn lwoew-query-entry-items (query schema-fixture)
    (list
        (lwphw-entry-j (lwoew-q-scope))
        (lwphw-entry-j (lwoew-q-first-source))
        (lwphw-entry-j (lwoew-q-second-source))
        (lwphw-entry-j (lwoew-q-first-projection))
        (lwphw-entry-j (lwoew-q-second-projection))
        (lwphw-entry-j (lwoew-q-first-value schema-fixture))
        (lwphw-entry-j (lwoew-q-second-value schema-fixture))
        (lwphw-entry-k query)
        (lwphw-entry-l query)))
(defn lwoew-query-world (world query schema-fixture)
    (lwt-receive-stream world
        (lwoew-query-entry-items query schema-fixture)))

; children: schema fixture, integrated field round, candidate, exact field,
;           query world, rich query, branch answer
(defn lwoew-base-fixture
    (schema round candidate field world query answer)
    (intern_node LWOEW-BASE-FIXTURE
        (list schema round candidate field world query answer)))
(defn lwoew-base-schema (fixture) (nth (node_children fixture) 0))
(defn lwoew-base-round (fixture) (nth (node_children fixture) 1))
(defn lwoew-base-candidate (fixture) (nth (node_children fixture) 2))
(defn lwoew-base-field (fixture) (nth (node_children fixture) 3))
(defn lwoew-base-world-cell (fixture) (nth (node_children fixture) 4))
(defn lwoew-base-query (fixture) (nth (node_children fixture) 5))
(defn lwoew-base-answer (fixture) (nth (node_children fixture) 6))
(defn lwoew-build-base ()
    (do
        (let schema (lwsrw-integrated-schema))
        (let world (lwoew-base-world schema))
        (let proposal
            (lwoe-proposal world (lwoew-enquiry)
                (lwoew-codecs schema) 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let field (lwo-emergent-shape candidate))
        (let integrated (lwoew-integrate-field world schema (lwo-none)))
        (let query (lwoew-rich-query candidate schema))
        (let query-world
            (lwoew-query-world (lwt-round-world integrated) query schema))
        (lwoew-base-fixture schema integrated candidate field query-world
            query (lwoe-answer-for query-world query 2
                (intern_trivial_int 5)))))

(defn lwoew-example-two-entry-items (schema-fixture)
    (list
        (lwphw-entry-m (lwoew-e2-scope))
        (lwphw-entry-m (lwoew-e2-first-source))
        (lwphw-entry-m (lwoew-e2-second-source))
        (lwphw-entry-m (lwoew-e2-first-projection))
        (lwphw-entry-m (lwoew-e2-second-projection))
        (lwphw-entry-m (lwoew-e2-first-value schema-fixture))
        (lwphw-entry-m (lwoew-e2-second-value schema-fixture))
        (lwphw-entry-m (lwoew-example-two schema-fixture))
        (lwphw-entry-n (lwoew-example-two schema-fixture))))

; children: base, integrated successor round/candidate/field, query world,
;           minimal query, consensus answer
(defn lwoew-evolved-fixture
    (base round candidate field world query answer)
    (intern_node LWOEW-EVOLVED-FIXTURE
        (list base round candidate field world query answer)))
(defn lwoew-evolved-base (fixture) (nth (node_children fixture) 0))
(defn lwoew-evolved-round (fixture) (nth (node_children fixture) 1))
(defn lwoew-evolved-candidate (fixture) (nth (node_children fixture) 2))
(defn lwoew-evolved-field (fixture) (nth (node_children fixture) 3))
(defn lwoew-evolved-world (fixture) (nth (node_children fixture) 4))
(defn lwoew-evolved-query (fixture) (nth (node_children fixture) 5))
(defn lwoew-evolved-answer (fixture) (nth (node_children fixture) 6))
(defn lwoew-build-evolved ()
    (do
        (let base (lwoew-build-base))
        (let schema (lwoew-base-schema base))
        (let world
            (lwt-receive-stream (lwoew-base-world-cell base)
                (lwoew-example-two-entry-items schema)))
        (let proposal
            (lwoe-proposal world (lwoew-enquiry)
                (lwoew-codecs schema) 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let field (lwo-emergent-shape candidate))
        (let integrated
            (lwoe-integrate
                (lwphw-answered-round world proposal
                    (lwoew-base-round base))
                proposal (lwphw-action)))
        (let query (lwoew-minimal-query candidate schema))
        (let query-world
            (lwoew-query-world (lwt-round-world integrated) query schema))
        (lwoew-evolved-fixture base integrated candidate field query-world
            query (lwoe-answer-for query-world query 2 (lwo-none)))))

(defn lwoew-revoked-example-world (evolved)
    (do
        (let schema
            (lwoew-base-schema (lwoew-evolved-base evolved)))
        (let example (lwoew-example-two schema))
        (lwt-receive-stream (lwoew-evolved-world evolved)
            (list
                (lwphw-entry-n
                    (lwo-revocation example (lwphw-source-n)
                        (lwoew-reason) (lwphw-prov-n)))))))
(defn lwoew-silence-world (base)
    (do
        (let schema (lwoew-base-schema base))
        (lwt-receive-stream (lwoew-base-world-cell base)
            (append
                (list
                    (lwphw-entry-m (lwoew-e2-scope))
                    (lwphw-entry-m (lwoew-e2-first-source))
                    (lwphw-entry-m (lwoew-e2-second-source))
                    (lwphw-entry-m (lwoew-e2-first-projection))
                    (lwphw-entry-m (lwoew-e2-second-projection))
                    (lwphw-entry-m (lwoew-e2-first-value schema))
                    (lwphw-entry-m (lwoew-e2-second-value schema)))
                (list
                    (lwphw-entry-m (lwoew-silence-example schema))
                    (lwphw-entry-n (lwoew-silence-example schema)))))))

0
