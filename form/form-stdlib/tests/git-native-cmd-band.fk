; git-native-cmd-band.fk — the read commands of git as Form functions (git-cmd.bml): the exact stdout, exit code and stderr of each command
; and flag the product uses, over the demonstration history of gw-demo-dag (A <- B <- C <- D, B <- E <- F, M = merge(D, F), G on M) with a
; working tree and an index written by this band. Every expected text is written by hand from git's documented output formats.
;
;   1    rev-parse: HEAD, --short, --abbrev-ref HEAD / origin/main, --show-toplevel, --git-dir, --verify (and -q: silent exit 1),
;        several names at once, the failures (exit 128 with git's message, exit 129 for an unknown flag)
;   2    log: --oneline, -n, -1 --format=%H, a range D..G, --first-parent, --no-merges, a path limit (-- f.txt), the -S pickaxe, --date=short,
;        --format with %x1f / %x1e, the default medium layout for B (Author, Date in the commit's zone, indented body)
;   4    ls-files (-s, -z, a pathspec glob, -m, -o --exclude-standard), ls-tree (-r, --name-only), cat-file (-t -s -p -e, a typed form)
;   8    merge-base (and --all, --is-ancestor with exit 0/1), rev-list (--count, a range, --left-right --count, --first-parent, -n, --parents)
;   16   branch (--show-current, the list, -a, -r), config (--get, --get-all, exit 1 for a missing key), remote (get-url, list, -v),
;        symbolic-ref, worktree list --porcelain, check-attr, hash-object
;   32   diff: --name-only / --name-status / --numstat / --stat between commits, a unified -U0 hunk for f.txt, --quiet exit codes, the
;        working tree against HEAD and against the index, --cached, --diff-filter, -z
;   64   status through the command layer: --porcelain, -s, -b with "[ahead 4]", an untracked file, -uno, -z, and the paths after `--`
;   128  refusals by name: every write command and every transport command (exit 129 naming the phase), `git grep`, the long status
;        format, unknown flags of each supported command; "not a git repository" is exit 128; -C reaches a repository from elsewhere
;
; Expected: 255
; Verdict 255
; REQUIRES: (host doors: host_utimes, host_realpath, host_temp_dir, host_dir_rmdir)
; preflight-exec: forbidden
import form-stdlib/core.fk;
import form-stdlib/bml/git-sha1.bml;
import form-stdlib/bml/git-inflate.bml;
import form-stdlib/bml/git-store.bml;
import form-stdlib/bml/git-refs.bml;
import form-stdlib/bml/git-index.bml;
import form-stdlib/bml/git-ignore.bml;
import form-stdlib/bml/git-status.bml;
import form-stdlib/bml/git-rev.bml;
import form-stdlib/bml/git-diff.bml;
import form-stdlib/bml/git-cmd.bml;
import form-stdlib/bml/git-write.bml;
section [form.bml] {
  def gcb-bit(ok, bit) = ok ? bit : 0;
  def gcb-say(label, v) = print([label, v]);
  def gcb-eq(a, b) = (String) a == (String) b;
  def gcb-nl(lines) = len(lines) == 0 ? "" : ginf-join(ginf-reverse(map(l => l ++ "\n", lines), []));
  def gcb-run(top, line) = git-run-line(top, line);
  def gcb-is(top, line, want, code) {
    let r = gcb-run(top, line);
    gcb-eq(r[0], want) && r[1] == code;
  }
  def gcb-code(top, line, code) = gcb-run(top, line)[1] == code;
  def gcb-err-has?(top, line, code, needle) {
    let r = gcb-run(top, line);
    r[1] == code && str_find(r[2], needle, 0) >= 0;
  }
  def gcb-h7(x) = substring(x, 0, 7);
  def gcb-put(top, rel, content, mtime) {
    let d = gw-mkdirs(gs-parent(top ++ "/" ++ rel));
    let w = write_file(top ++ "/" ++ rel, content);
    let t = host_utimes(top ++ "/" ++ rel, mtime);
    w;
  }
  def gcb-row(top, rel, content) {
    let idn = host_file_identity(top ++ "/" ++ rel);
    [rel, 33188, gs-hash("blob", content), len(content), idn[1] / 1000, (idn[1] % 1000) * 1000000, 0, 0, (idn[1] / 1000) - 1, 0, idn[2], 16777220, 0];
  }
  def gcb-blob(content) = gsha-hex-of-raw(gs-hash("blob", content));
  def gcb-run-all() {
    let t0 = host_monotonic_ms();
    let top0 = host_temp_dir() ++ "/gcb-" ++ host_pid().str();
    let ids = gw-demo-dag(top0);
    let top = host_realpath(top0);
    let A = ids[0];
    let B = ids[1];
    let C = ids[2];
    let D = ids[3];
    let E = ids[4];
    let F = ids[5];
    let M = ids[6];
    let G = ids[7];
    let t = 1700000000000;
    let w1 = gcb-put(top, "f.txt", "1\n2\n3\nE\nF\n", t);
    let w2 = gcb-put(top, "g.txt", "g2\n", t);
    let w3 = gcb-put(top, "h.txt", "h1\n", t);
    let ix = gw-index([gcb-row(top, "f.txt", "1\n2\n3\nE\nF\n"), gcb-row(top, "g.txt", "g2\n"), gcb-row(top, "h.txt", "h1\n")]);
    let wi = gw-put-file(top ++ "/.git/index", ix);
    let fG = gcb-blob("1\n2\n3\nE\nF\n");
    let gG = gcb-blob("g2\n");
    let hG = gcb-blob("h1\n");
    let fB = gcb-blob("1\n2\n");
    let fC = gcb-blob("1\n2\n3\n");
    let treeG = gs-commit-parse(gs-read(git-open(top), gsha-raw-of-hex(G))[1])[0];
    let c1 = gcb-is(top, "rev-parse HEAD", G ++ "\n", 0) && gcb-is(top, "rev-parse --short HEAD", gcb-h7(G) ++ "\n", 0) && gcb-is(top, "rev-parse --abbrev-ref HEAD", "main\n", 0) && gcb-is(top, "rev-parse --abbrev-ref origin/main", "origin/main\n", 0) && gcb-is(top, "rev-parse --show-toplevel", top ++ "\n", 0) && gcb-is(top, "rev-parse --git-dir", ".git\n", 0) && gcb-is(top, "rev-parse --verify HEAD~2", D ++ "\n", 0) && gcb-is(top, "rev-parse main feat", G ++ "\n" ++ F ++ "\n", 0) && gcb-is(top, "rev-parse --is-inside-work-tree", "true\n", 0) && gcb-is(top, "rev-parse HEAD^{tree}", treeG ++ "\n", 0);
    let c1b = gcb-is(top, "rev-parse --verify -q nonesuch", "", 1) && gcb-err-has?(top, "rev-parse nonesuch", 128, "unknown revision") && gcb-err-has?(top, "rev-parse --verify nonesuch", 128, "Needed a single revision") && gcb-err-has?(top, "rev-parse --bogus", 129, "--bogus") && gcb-is(top, "rev-parse --short=10 HEAD", substring(G, 0, 10) ++ "\n", 0) && gcb-is(top, "rev-parse --symbolic-full-name HEAD", "refs/heads/main\n", 0);
    let b1 = gcb-bit(c1 && c1b, 1);
    let subj = ["G: add h", "M: merge feat", "D: touches g only", "F: another side line", "C: third line", "E: a side line", "B: second line", "A: first"];
    let hs = [G, M, D, F, C, E, B, A];
    let oneline = map(i => gcb-h7(hs[i]) ++ " " ++ subj[i], range(0, 8));
    let l1 = gcb-is(top, "log --oneline", gcb-nl(oneline), 0) && gcb-is(top, "log --oneline -n 3", gcb-nl(take(3, oneline)), 0) && gcb-is(top, "log -2 --oneline", gcb-nl(take(2, oneline)), 0) && gcb-is(top, "log -1 --format=%H", G ++ "\n", 0) && gcb-is(top, "log --format=%s " ++ D ++ ".." ++ G, gcb-nl(["G: add h", "M: merge feat", "F: another side line", "E: a side line"]), 0);
    let l2 = gcb-is(top, "log --first-parent --format=%s", gcb-nl(["G: add h", "M: merge feat", "D: touches g only", "C: third line", "B: second line", "A: first"]), 0) && gcb-is(top, "log --no-merges --format=%an -n 2", gcb-nl(["Ann", "Cy"]), 0) && gcb-is(top, "log --format=%s -- f.txt", gcb-nl(["M: merge feat", "F: another side line", "C: third line", "E: a side line", "B: second line", "A: first"]), 0) && gcb-is(top, "log --format=%s -S\"E\" -- f.txt", gcb-nl(["M: merge feat", "E: a side line"]), 0) && gcb-is(top, "log --date=short --format=\"%ad %s\" -n 1", "2023-11-14 G: add h\n", 0);
    let l3 = gcb-is(top, "log -2 --format=%h%x1f%an%x1e", gcb-h7(G) ++ byte_to_str(31) ++ "Ann" ++ byte_to_str(30) ++ "\n" ++ gcb-h7(M) ++ byte_to_str(31) ++ "Ann" ++ byte_to_str(30) ++ "\n", 0) && gcb-is(top, "log -1 --pretty=format:%s", "G: add h\n", 0) && gcb-is(top, "log -1 --format=who=%an-%cd --date=format:%H:%M origin/main", "who=Cy-17:20\n", 0);
    let medium = "commit " ++ B ++ " (tag: v1)\nAuthor: Bob <bob@example.test>\nDate:   Tue Nov 14 23:16:40 2023 +0100\n\n    B: second line\n\n    The body of B,\n    in two lines.\n";
    let l4 = gcb-is(top, "log -1 " ++ B, medium, 0) && gcb-is(top, "show -s --format=%s " ++ B, "B: second line\n", 0) && gcb-is(top, "show " ++ B ++ ":f.txt", "1\n2\n", 0);
    let b2 = gcb-bit(l1 && l2 && l3 && l4, 2);
    let nul = byte_to_str(0);
    let f1 = gcb-is(top, "ls-files", "f.txt\ng.txt\nh.txt\n", 0) && gcb-is(top, "ls-files -s", "100644 " ++ fG ++ " 0\tf.txt\n100644 " ++ gG ++ " 0\tg.txt\n100644 " ++ hG ++ " 0\th.txt\n", 0) && gcb-is(top, "ls-files -z", "f.txt" ++ nul ++ "g.txt" ++ nul ++ "h.txt" ++ nul, 0) && gcb-is(top, "ls-files -- *.txt", "f.txt\ng.txt\nh.txt\n", 0) && gcb-is(top, "ls-files -- g*", "g.txt\n", 0) && gcb-is(top, "ls-files -m", "", 0) && gcb-is(top, "ls-files -o --exclude-standard", "", 0);
    let lt = "100644 blob " ++ fG ++ "\tf.txt\n100644 blob " ++ gG ++ "\tg.txt\n100644 blob " ++ hG ++ "\th.txt\n";
    let f2 = gcb-is(top, "ls-tree HEAD", lt, 0) && gcb-is(top, "ls-tree -r HEAD", lt, 0) && gcb-is(top, "ls-tree --name-only HEAD", "f.txt\ng.txt\nh.txt\n", 0) && gcb-is(top, "ls-tree " ++ B, "100644 blob " ++ fB ++ "\tf.txt\n", 0) && gcb-is(top, "ls-tree HEAD g.txt", "100644 blob " ++ gG ++ "\tg.txt\n", 0);
    let f3 = gcb-is(top, "cat-file -t HEAD", "commit\n", 0) && gcb-is(top, "cat-file -t HEAD:f.txt", "blob\n", 0) && gcb-is(top, "cat-file -t HEAD^{tree}", "tree\n", 0) && gcb-is(top, "cat-file -s HEAD:f.txt", "10\n", 0) && gcb-is(top, "cat-file -p HEAD:g.txt", "g2\n", 0) && gcb-is(top, "cat-file -p HEAD^{tree}", lt, 0) && gcb-is(top, "cat-file blob HEAD:h.txt", "h1\n", 0) && gcb-is(top, "cat-file -e HEAD", "", 0) && gcb-is(top, "cat-file -e " ++ gcb-blob("never written"), "", 1) && gcb-code(top, "cat-file -e nonesuch", 128);
    let commit_text = "tree " ++ treeG ++ "\nparent " ++ M ++ "\nauthor Ann <ann@example.test> 1700000600 +0000\ncommitter Ann <ann@example.test> 1700000600 +0000\n\nG: add h\n";
    let f4 = gcb-is(top, "cat-file -p HEAD", commit_text, 0) && gcb-is(top, "cat-file commit HEAD", commit_text, 0);
    let b4 = gcb-bit(f1 && f2 && f3 && f4, 4);
    let m1 = gcb-is(top, "merge-base " ++ D ++ " " ++ F, B ++ "\n", 0) && gcb-is(top, "merge-base --all " ++ D ++ " " ++ F, B ++ "\n", 0) && gcb-is(top, "merge-base HEAD feat", F ++ "\n", 0) && gcb-is(top, "merge-base --is-ancestor " ++ B ++ " HEAD", "", 0) && gcb-is(top, "merge-base --is-ancestor HEAD " ++ B, "", 1) && gcb-is(top, "merge-base --is-ancestor " ++ F ++ " " ++ D, "", 1) && gcb-code(top, "merge-base nonesuch HEAD", 128);
    let m2 = gcb-is(top, "rev-list --count HEAD", "8\n", 0) && gcb-is(top, "rev-list --count " ++ D ++ ".." ++ G, "4\n", 0) && gcb-is(top, "rev-list --count origin/main..HEAD", "4\n", 0) && gcb-is(top, "rev-list --count HEAD..origin/main", "0\n", 0) && gcb-is(top, "rev-list --left-right --count " ++ D ++ "..." ++ F, "2\t2\n", 0) && gcb-is(top, "rev-list " ++ D ++ ".." ++ G, gcb-nl([G, M, F, E]), 0) && gcb-is(top, "rev-list --first-parent -n 3 HEAD", gcb-nl([G, M, D]), 0) && gcb-is(top, "rev-list --parents -n 1 " ++ B, B ++ " " ++ A ++ "\n", 0) && gcb-is(top, "rev-list --max-count=2 --skip=1 HEAD", gcb-nl([M, D]), 0);
    let b8 = gcb-bit(m1 && m2, 8);
    let ga = gcb-put(top, ".gitattributes", "*.txt text\nf.txt merge=union\n", t);
    let hf = gcb-put(top, "hello.dat", "hello\n", t);
    let o1 = gcb-is(top, "branch --show-current", "main\n", 0) && gcb-is(top, "branch", "  feat\n* main\n", 0) && gcb-is(top, "branch --list", "  feat\n* main\n", 0) && gcb-is(top, "branch -a", "  feat\n* main\n  remotes/origin/main\n", 0) && gcb-is(top, "branch -r", "  origin/main\n", 0) && gcb-is(top, "branch --list \"f*\"", "  feat\n", 0);
    let o2 = gcb-is(top, "config --get user.name", "Demo Person\n", 0) && gcb-is(top, "config --get remote.origin.url", "https://example.test/demo.git\n", 0) && gcb-is(top, "config --get nonesuch.key", "", 1) && gcb-is(top, "config --get-all remote.origin.fetch", "+refs/heads/*:refs/remotes/origin/*\n", 0) && gcb-is(top, "config --get branch.main.merge", "refs/heads/main\n", 0) && gcb-is(top, "remote get-url origin", "https://example.test/demo.git\n", 0) && gcb-is(top, "remote", "origin\n", 0) && gcb-is(top, "remote -v", "origin\thttps://example.test/demo.git (fetch)\norigin\thttps://example.test/demo.git (push)\n", 0) && gcb-err-has?(top, "remote get-url nope", 128, "No such remote");
    let o3 = gcb-is(top, "symbolic-ref HEAD", "refs/heads/main\n", 0) && gcb-is(top, "symbolic-ref --short HEAD", "main\n", 0) && gcb-is(top, "worktree list --porcelain", "worktree " ++ top ++ "\nHEAD " ++ G ++ "\nbranch refs/heads/main\n\n", 0) && gcb-is(top, "check-attr merge text -- f.txt g.txt", "f.txt: merge: union\nf.txt: text: set\ng.txt: merge: unspecified\ng.txt: text: set\n", 0) && gcb-is(top, "hash-object hello.dat", "ce013625030ba8dba906f756967f9e9ca394464a\n", 0);
    let b16 = gcb-bit(o1 && o2 && o3, 16);
    let hunk = "diff --git a/f.txt b/f.txt\nindex " ++ gcb-h7(fB) ++ ".." ++ gcb-h7(fC) ++ " 100644\n--- a/f.txt\n+++ b/f.txt\n@@ -2,0 +3 @@\n+3\n";
    let d1 = gcb-is(top, "diff --name-status " ++ B ++ " " ++ G, "M\tf.txt\nA\tg.txt\nA\th.txt\n", 0) && gcb-is(top, "diff --name-only " ++ B ++ " " ++ C, "f.txt\ng.txt\n", 0) && gcb-is(top, "diff --numstat " ++ B ++ " " ++ G, "3\t0\tf.txt\n1\t0\tg.txt\n1\t0\th.txt\n", 0) && gcb-is(top, "diff --stat " ++ B ++ " " ++ C, " f.txt | 1 +\n g.txt | 1 +\n 2 files changed, 2 insertions(+)\n", 0) && gcb-is(top, "diff -U0 --no-color " ++ B ++ " " ++ C ++ " -- f.txt", hunk, 0) && gcb-is(top, "diff --name-only " ++ D ++ ".." ++ G, "f.txt\nh.txt\n", 0);
    let d2 = gcb-is(top, "diff --quiet", "", 0) && gcb-is(top, "diff --cached --quiet", "", 0) && gcb-is(top, "diff --name-only HEAD", "", 0) && gcb-is(top, "diff --quiet " ++ B ++ " " ++ G, "", 1) && gcb-is(top, "diff --name-only --diff-filter=U", "", 0);
    let w5 = gcb-put(top, "f.txt", "1\n2\n3\nE\nX\n", t + 5000);
    let d3 = gcb-is(top, "diff --name-only", "f.txt\n", 0) && gcb-is(top, "diff --name-only HEAD", "f.txt\n", 0) && gcb-is(top, "diff --name-status HEAD", "M\tf.txt\n", 0) && gcb-is(top, "diff --quiet", "", 1) && gcb-is(top, "diff --cached --name-only", "", 0) && gcb-is(top, "ls-files -m", "f.txt\n", 0) && gcb-is(top, "diff --numstat", "1\t1\tf.txt\n", 0) && gcb-is(top, "diff --name-only -z", "f.txt" ++ nul, 0);
    let b32 = gcb-bit(d1 && d2 && d3, 32);
    let w6 = gcb-put(top, "f.txt", "1\n2\n3\nE\nF\n", t);
    let s1 = gcb-is(top, "status --porcelain", "?? .gitattributes\n?? hello.dat\n", 0) && gcb-is(top, "status -s", "?? .gitattributes\n?? hello.dat\n", 0) && gcb-is(top, "status --porcelain -b", "## main...origin/main [ahead 4]\n?? .gitattributes\n?? hello.dat\n", 0) && gcb-is(top, "status -sb -uno", "## main...origin/main [ahead 4]\n", 0) && gcb-is(top, "status --porcelain -- hello.dat", "?? hello.dat\n", 0);
    let w7 = gcb-put(top, "g.txt", "g2 changed\n", t + 6000);
    let s2 = gcb-is(top, "status --porcelain -uno", " M g.txt\n", 0) && gcb-is(top, "status --porcelain -z -uno", " M g.txt" ++ nul, 0);
    let w8 = gcb-put(top, "g.txt", "g2\n", t);
    let b64 = gcb-bit(s1 && s2, 64);
    let writes = ["add f.txt", "commit -m x", "checkout main", "switch main", "reset --hard", "rebase main", "merge feat", "stash", "init", "update-ref refs/heads/x HEAD", "tag x", "restore f.txt"];
    let transports = ["fetch origin", "pull", "push origin main", "clone x y"];
    let r1 = all?(c => gcb-err-has?(top, c, 129, "write command"), writes) && all?(c => gcb-err-has?(top, c, 129, "transport command"), transports);
    let r2 = gcb-err-has?(top, "grep -n foo", 129, "grep") && gcb-err-has?(top, "status", 129, "long format") && gcb-err-has?(top, "log --graph", 129, "--graph") && gcb-err-has?(top, "diff --word-diff", 129, "--word-diff") && gcb-err-has?(top, "ls-files --eol", 129, "--eol") && gcb-err-has?(top, "frobnicate", 129, "not a git command") && gcb-err-has?(top, "status --porcelain=v2", 129, "porcelain");
    let nonrepo = host_temp_dir() ++ "/gcb-none-" ++ host_pid().str();
    let nm = gw-mkdirs(nonrepo);
    let r3 = gcb-err-has?(nonrepo, "rev-parse HEAD", 128, "not a git repository") && gcb-is(nonrepo, "-C " ++ top ++ " rev-parse HEAD", G ++ "\n", 0) && gcb-is(nonrepo, "-C " ++ top ++ " log -1 --format=%s", "G: add h\n", 0) && gcb-is(top, "--no-pager -c core.pager=cat log -1 --format=%s", "G: add h\n", 0);
    let b128 = gcb-bit(r1 && r2 && r3, 128);
    let rm1 = host_dir_rmdir(top0);
    let rm2 = host_dir_rmdir(nonrepo);
    let s9 = gcb-say("groups", [c1, c1b, l1, l2, l3, l4, f1, f2, f3, f4, m1, m2, o1, o2, o3, d1, d2, d3, s1, s2, r1, r2, r3]);
    let verdict = b1 + b2 + b4 + b8 + b16 + b32 + b64 + b128;
    let shown = print(["git-native-cmd-band", "verdict", verdict, "ms", host_monotonic_ms() - t0]);
    verdict;
  }
  gcb-run-all();
}
