; dsv4-layout-band.bml -- the geometry the DeepSeek-V4 driver needs, read from a GGUF header alone: the fixture's exact 7,168 header bytes and the 8 MB header
; windows of the two real files, and the question of how many layers the reap25 build has, settled by its header.
;
; WHAT THIS PINS. form-stdlib/dsv4-layout.fk computes, from an equireach source over the header (never a weight), the widths, the layer table (each
; layer's compression ratio, coff, routing regime, stored experts, router rows and the three expert types, and the tensors the driver binds), the KV
; cache's bytes a token and its per-layer arenas, and the size of every scratch buffer. The two real files are read for their first 8,388,608 bytes
; (the headers end under 5.4 MB, as the restored bands dsv4-oracle-recipes and ds4-recorded-references read them); no tensor is mapped and no weight
; is read. The fixture's file is written under temp_dir by the fixture cell and removed.
;
; THE FIGURES PINNED AGAINST THE REAL FILES come from two other hands: the KV bytes a token (88,064) from dsv4-kv-cache.fk's header, the buffer sizes
; and 1,202 driver tensors from the lead's design (derived from the old runner), and every per-type and per-layer count from gm-emit-manifest's own
; printed table (a different walk of the same header).
;
; Verdict 511 when every claim lands:
;   1     the fixture, from exactly its 7,168 header bytes: 3 layers, 86 tensors, data base 7,168, and the widths (n_embd 256, 2 heads of 128, nrot 64, q rank 64,
;         2 groups of rank 32, 4 streams, vocabulary 32, 2 of 4 experts, shared 32, mix 24) with the numeric keys the driver reads (eps, rope base, factor)
;   2     the fixture's layer table: ratios 0 4 2, compressing on 1 and 2 with coff 2 and 1 (read from the compressor's own width) and ape rows equal to the ratio,
;         hashed on layer 0 alone, hidden 256 64 64, expert types 16 and 40, 24 28 28 driver tensors a layer, none missing, none unpriced, and the whole layout consistent
;   4     the fixture's KV and scratch figures: 1,536 B a token; compressor state 8,192 and 1,024 B each; compressed rows 17 and 33 at 64 tokens; 142,336 B of cache
;         at 64 tokens; 28 scratch buffers of 27,280 B (residual 4,096, query 1,024, logits 128), and the rows equal the generator's offsets and priced lengths
;   8     the IQ2XXS file (86,720,111,488 B), from its 8 MB window: 43 layers by the key and by the tensors, 0 draft layers, 1,328 tensors, data base 5,333,824, the
;         widths (4096, 64 heads of 512, nrot 64, q rank 1024, 8 groups of rank 1024, 4 streams, vocabulary 129,280, 6 of 256 experts, shared 2,048), the 44 ratios
;         (0 0, then 4 128 twenty times, 4, 0), layers 0 1 2 hashed and the rest biased, the experts 16 16 10 on every layer, 256 stored and 256 router rows
;   16    the IQ2XXS file's figures: 88,064 B a token; residual 65,536 B, query 131,072 B, logits 517,120 B, 1,172,624 B of scratch; the compressor state 32,768 B at ratio 4
;         and 262,144 B at ratio 128; 257 and 9 compressed rows at 1,024 tokens; 113,461,248 B of cache at 1,024 tokens; 1,202 driver tensors, none missing or unpriced
;   32    the reap25 file (91,321,404,640 B), from its 8 MB window: 43 layers, 1,406 tensors, data base 5,339,744, the same widths and ratios and the same
;         88,064 B a token, layers 0 to 2 store 256 experts and layers 3 to 42 store 192 behind 256 router rows, the expert types by the manifest's census (gate and up
;         16 on 31 layers and 40 on 12; down the same counts), 1,202 driver tensors, none missing or unpriced
;   64    43 AND NOT 46: deepseek4.block_count reads 43 on the reap25 file, blk.0 to blk.42 are its layers, and the table carries 3 draft layers (dspark.0, dspark.1,
;         dspark.2) after them, so the control plane's 46 is 43 plus 3; the IQ2XXS file has 43 and no draft layer
;   128   header only: each real window is 8,388,608 bytes of an 85 GB or 80 GB file, the table ends inside it, the fixture's source is its 7,168 header bytes of
;         1,515,232, and the fixture's layout from those bytes equals its layout from the whole file
;   256   the layout can refuse: a fixture built without layer 1's compressor kv tensor reads inconsistent (ratio 4 with no compressor), one built without a layer's
;         shared up projection reads a missing driver tensor, and one that retypes a layer's router to an unpriced type reads unpriced
;
; PROOF LEVEL: FOURTH-ARM ONLY -- bits 8 to 128 read the two model files' headers (host-local paths outside the tree; the 8 MB windows), and every bit reads
; the fixture through write_file and read_file_slice (rust and ts hand back a different file there). No weight is read and no model is opened.
; The band writes only under temp_dir and removes what it made.
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/gguf-manifest.fk form-stdlib/dsv4-fixture-gguf.fk form-stdlib/dsv4-layout.fk
section [form.bml] {
 class Dsv4LayoutBand {
  def dlb-bit(held, bit) = held ? bit : 0;
  def dlb-iq2() = "/Users/ursmuff/models/ds4-engine/gguf/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf";
  def dlb-reap() = "/Users/ursmuff/models/ds4/ds4flash-v5mx-reap25-type40-mxfp8lt-dspark-v1.gguf";
  def dlb-g(m, key) = record_get(m, key);
  def dlb-widths(m) = [dlb-g(m, "e"), dlb-g(m, "nh"), dlb-g(m, "hd"), dlb-g(m, "vd"), dlb-g(m, "nrot"), dlb-g(m, "qr"), dlb-g(m, "ng"), dlb-g(m, "rank"), dlb-g(m, "hc"), dlb-g(m, "vocab"), dlb-g(m, "used"), dlb-g(m, "experts-kv"), dlb-g(m, "sh"), dlb-g(m, "mix")];
  def dlb-col(m, key, il) = il == dlb-g(m, "layers-n") ? [] : cons(dvl-l(m, il, key), dlb-col(m, key, il + 1));
  def dlb-all(m, key, value, il) = il == dlb-g(m, "layers-n") ? true : (dvl-l(m, il, key) == value && dlb-all(m, key, value, il + 1));
  def dlb-count(m, key, value, il) = il == dlb-g(m, "layers-n") ? 0 : (dvl-l(m, il, key) == value ? 1 : 0) + dlb-count(m, key, value, il + 1);
  def dlb-near(a, b) = abs(a - b) <= (0.000001 * abs(b));
  def dlb-pairs(n) = n == 0 ? [] : append([4, 128], dlb-pairs(n - 1));
  def dlb-real-ratios() = append([0, 0], append(dlb-pairs(20), [4, 0]));
  def dlb-rep(n, v) = n == 0 ? [] : cons(v, dlb-rep(n - 1, v));
  def dlb-fixture-header(path) = read_file_slice(path, 0, 7168);

  // ---- 1
  def dlb-fix-widths(m) {
   dlb-g(m, "arch") == "deepseek4" && dlb-g(m, "layers-n") == 3 && dlb-g(m, "tensors") == 86 && dlb-g(m, "data-base") == 7168
    && dlb-widths(m) == [256, 2, 128, 128, 64, 64, 2, 32, 4, 32, 2, 4, 32, 24]
    && dlb-near(dlb-g(m, "eps"), 0.000001) && dlb-g(m, "rope-base") == 10000.0 && dlb-g(m, "rope-factor") == 16.0 && dlb-g(m, "compress-base") == 160000.0
    && dlb-g(m, "orig-ctx") == 4096 && dlb-g(m, "beta-fast") == 32.0 && dlb-g(m, "beta-slow") == 1.0 && dlb-g(m, "wscale") == 1.5 && dlb-g(m, "sliding-window") == 128
    && dlb-g(m, "ratios") == [0, 4, 2, 0] && dlb-g(m, "iters") == 20;
  }

  // ---- 2
  def dlb-fix-layers(m) {
   dlb-col(m, "ratio", 0) == [0, 4, 2] && dlb-col(m, "compressed", 0) == [false, true, true] && dlb-col(m, "coff", 0) == [0, 2, 1] && dlb-col(m, "ape-rows", 0) == [0, 4, 2]
    && dlb-col(m, "hashed", 0) == [true, false, false] && dlb-col(m, "hidden", 0) == [256, 64, 64] && dlb-col(m, "nexp", 0) == [4, 4, 4] && dlb-col(m, "router-rows", 0) == [4, 4, 4]
    && dlb-col(m, "gate-type", 0) == [16, 40, 40] && dlb-col(m, "up-type", 0) == [16, 40, 40] && dlb-col(m, "down-type", 0) == [16, 40, 40]
    && dvl-l(m, 0, "route") == "blk.0.ffn_gate_tid2eid.weight" && dvl-l(m, 1, "route") == "blk.1.exp_probs_b.bias" && dlb-all(m, "indexer", 0, 0)
    && len(dvl-l(m, 0, "names")) == 24 && len(dvl-l(m, 1, "names")) == 28 && len(dvl-l(m, 2, "names")) == 28 && dlb-all(m, "missing", 0, 0)
    && dvl-unpriced(m) == 0 && dvl-consistent?(m) && len(dvl-driver-names(m)) == 86;
  }

  // ---- 4
  def dlb-rows-match(rows, specs, offs, base, i) = i == len(specs) ? true : (rows[i][0] == specs[i][0] && rows[i][1] == specs[i][1] && rows[i][2] == specs[i][2] && rows[i][3] == offs[i] && rows[i][4] == base + offs[i] && rows[i][5] == dfx-tbytes(specs[i][1], specs[i][2]) && dlb-rows-match(rows, specs, offs, base, i + 1));
  def dlb-fix-figures(m, specs) {
   let bufs = dvl-buffers(m);
   dvl-kv-bytes-per-token(m) == 1536 && dvl-state-bytes(m, 0) == 0 && dvl-state-bytes(m, 1) == 8192 && dvl-state-bytes(m, 2) == 1024
    && [dvl-comp-rows(m, 0, 64), dvl-comp-rows(m, 1, 64), dvl-comp-rows(m, 2, 64)] == [0, 17, 33] && dvl-kv-total(m, 64) == 142336
    && len(bufs) == 28 && dvl-scratch-bytes(m) == 27280
    && dvl-buffer-bytes(bufs, "resid") == 4096 && dvl-buffer-bytes(bufs, "q") == 1024 && dvl-buffer-bytes(bufs, "logits") == 128
    && dlb-rows-match(dlb-g(m, "rows"), specs, dfx-offsets(specs, 0), 7168, 0);
  }

  // ---- 8
  def dlb-real-widths(m) = dlb-widths(m) == [4096, 64, 512, 512, 64, 1024, 8, 1024, 4, 129280, 6, 256, 2048, 24];
  def dlb-iq2-table(m) {
   dlb-g(m, "arch") == "deepseek4" && dlb-g(m, "layers-n") == 43 && dlb-g(m, "table-blocks") == 43 && dlb-g(m, "draft-layers") == 0 && dlb-g(m, "tensors") == 1328 && dlb-g(m, "data-base") == 5333824
    && dlb-real-widths(m) && dlb-g(m, "ratios") == dlb-real-ratios() && len(dlb-g(m, "ratios")) == 44
    && dlb-col(m, "hashed", 0) == append([true, true, true], dlb-rep(40, false))
    && dlb-all(m, "gate-type", 16, 0) && dlb-all(m, "up-type", 16, 0) && dlb-all(m, "down-type", 10, 0) && dlb-all(m, "nexp", 256, 0) && dlb-all(m, "router-rows", 256, 0) && dlb-all(m, "hidden", 2048, 0)
    && dlb-count(m, "compressed", true, 0) == 41 && dlb-count(m, "coff", 2, 0) == 21 && dlb-count(m, "coff", 1, 0) == 20 && dlb-count(m, "indexer", 6, 0) == 21;
  }

  // ---- 16
  def dlb-figures(m, total1024) {
   let bufs = dvl-buffers(m);
   dvl-kv-bytes-per-token(m) == 88064 && dvl-buffer-bytes(bufs, "resid") == 65536 && dvl-buffer-bytes(bufs, "q") == 131072 && dvl-buffer-bytes(bufs, "logits") == 517120 && dvl-scratch-bytes(m) == 1172624
    && dvl-state-bytes(m, 2) == 32768 && dvl-state-bytes(m, 3) == 262144 && dvl-state-bytes(m, 0) == 0 && dvl-comp-rows(m, 2, 1024) == 257 && dvl-comp-rows(m, 3, 1024) == 9 && dvl-comp-rows(m, 0, 1024) == 0
    && dvl-kv-total(m, 1024) == total1024 && len(dvl-driver-names(m)) == 1202 && dlb-all(m, "missing", 0, 0) && dvl-unpriced(m) == 0 && dvl-consistent?(m);
  }

  // ---- 32
  def dlb-reap-table(m) {
   dlb-g(m, "arch") == "deepseek4" && dlb-g(m, "layers-n") == 43 && dlb-g(m, "table-blocks") == 43 && dlb-g(m, "tensors") == 1406 && dlb-g(m, "data-base") == 5339744
    && dlb-real-widths(m) && dlb-g(m, "ratios") == dlb-real-ratios() && dvl-kv-bytes-per-token(m) == 88064
    && dlb-col(m, "nexp", 0) == append([256, 256, 256], dlb-rep(40, 192)) && dlb-all(m, "router-rows", 256, 0)
    && dlb-count(m, "gate-type", 16, 0) == 31 && dlb-count(m, "gate-type", 40, 0) == 12 && dlb-count(m, "up-type", 16, 0) == 31 && dlb-count(m, "up-type", 40, 0) == 12
    && dlb-count(m, "down-type", 16, 0) == 31 && dlb-count(m, "down-type", 40, 0) == 12
    && len(dvl-driver-names(m)) == 1202 && dlb-all(m, "missing", 0, 0) && dvl-unpriced(m) == 0 && dvl-consistent?(m);
  }

  // ---- 64
  def dlb-43(iq2, reap, reapSrc) {
   let key = gmt-u32(reapSrc, "deepseek4.block_count");
   key == 43 && dlb-g(reap, "layers-n") == 43 && dlb-g(reap, "table-blocks") == 43 && dlb-g(reap, "draft-layers") == 3 && (key + dlb-g(reap, "draft-layers")) == 46
    && dvl-has?(dlb-g(reap, "index"), "blk.42.attn_norm.weight") && !dvl-has?(dlb-g(reap, "index"), "blk.43.attn_norm.weight")
    && dvl-has?(dlb-g(reap, "index"), "dspark.2.attn_norm.weight") && !dvl-has?(dlb-g(reap, "index"), "dspark.3.attn_norm.weight")
    && dlb-g(iq2, "layers-n") == 43 && dlb-g(iq2, "draft-layers") == 0;
  }

  // ---- 128
  def dlb-header-only(iq2Src, reapSrc, iq2, reap, fixSrc, fixFull, fixPath) {
   str_len(iq2Src) == 8388608 && str_len(reapSrc) == 8388608 && file_size(dlb-iq2()) == 86720111488 && file_size(dlb-reap()) == 91321404640
    && dlb-g(iq2, "data-base") < 8388608 && dlb-g(reap, "data-base") < 8388608
    && str_len(fixSrc) == 7168 && file_size(fixPath) == 1515232 && dlb-g(fixFull, "data-base") == 7168 && dlb-g(fixFull, "rows") == dlb-g(dvl-open(fixSrc), "rows")
    && dlb-col(fixFull, "names", 0) == dlb-col(dvl-open(fixSrc), "names", 0) && dlb-col(fixFull, "ratio", 0) == dlb-col(dvl-open(fixSrc), "ratio", 0)
    && dlb-col(fixFull, "hashed", 0) == dlb-col(dvl-open(fixSrc), "hashed", 0) && dlb-widths(fixFull) == dlb-widths(dvl-open(fixSrc));
  }

  // ---- 256
  def dlb-drop(specs, name) = len(specs) == 0 ? [] : (specs[0][0] == name ? dlb-drop(specs[1:], name) : cons(specs[0], dlb-drop(specs[1:], name)));
  def dlb-retype(specs, name, ty) = len(specs) == 0 ? [] : cons(specs[0][0] == name ? [specs[0][0], ty, specs[0][2], specs[0][3], specs[0][4], specs[0][5]] : specs[0], dlb-retype(specs[1:], name, ty));
  def dlb-layout-of(specs) = dvl-open(dfx-header(specs));
  def dlb-negatives(specs) {
   let noComp = dlb-layout-of(dlb-drop(specs, "blk.1.attn_compressor_kv.weight"));
   let noShared = dlb-layout-of(dlb-drop(specs, "blk.2.ffn_up_shexp.weight"));
   let unpriced = dlb-layout-of(dlb-retype(specs, "blk.1.ffn_gate_inp.weight", 31));
   dvl-consistent?(dlb-layout-of(specs)) && (!dvl-consistent?(noComp)) && dvl-l(noComp, 1, "compressed") == false && dvl-l(noComp, 1, "ratio") == 4
    && (!dvl-consistent?(noShared)) && dvl-l(noShared, 2, "missing") == 1 && dvl-l(noShared, 1, "missing") == 0
    && dvl-unpriced(unpriced) == 1 && dvl-unpriced(dlb-layout-of(specs)) == 0;
  }
 }
 let root = temp_dir() ++ "/dsv4-layout-band-" ++ now_unix_ms().str();
 let fixPath = root ++ ".gguf";
 let specs = dfx-specs();
 let wrote = dfx-write(fixPath);
 let fixSrc = dlb-fixture-header(fixPath);
 let fixFull = dvl-open(eqr-of-file(fixPath, 0, file_size(fixPath)));
 let fix = dvl-open(fixSrc);
 let iq2Src = dvl-src(dlb-iq2());
 let reapSrc = dvl-src(dlb-reap());
 let iq2 = dvl-open(iq2Src);
 let reap = dvl-open(reapSrc);
 // a claim that stops reads as a dark bit, not as a stopped band
 let c1 = dlb-bit(try wrote == 1515232 && dlb-fix-widths(fix) catch false, 1);
 let c2 = dlb-bit(try dlb-fix-layers(fix) catch false, 2);
 let c4 = dlb-bit(try dlb-fix-figures(fix, specs) catch false, 4);
 let c8 = dlb-bit(try dlb-iq2-table(iq2) catch false, 8);
 let c16 = dlb-bit(try dlb-figures(iq2, 113461248) catch false, 16);
 let c32 = dlb-bit(try dlb-reap-table(reap) catch false, 32);
 let c64 = dlb-bit(try dlb-43(iq2, reap, reapSrc) catch false, 64);
 let c128 = dlb-bit(try dlb-header-only(iq2Src, reapSrc, iq2, reap, fixSrc, fixFull, fixPath) catch false, 128);
 let c256 = dlb-bit(try dlb-negatives(specs) catch false, 256);
 let removed = host_path_remove(fixPath);
 print_str("dsv4-layout-band claims " ++ c1.str() ++ " " ++ c2.str() ++ " " ++ c4.str() ++ " " ++ c8.str() ++ " " ++ c16.str() ++ " " ++ c32.str() ++ " " ++ c64.str() ++ " " ++ c128.str() ++ " " ++ c256.str() ++ " removed " ++ removed.str());
 c1 + c2 + c4 + c8 + c16 + c32 + c64 + c128 + c256;
}
