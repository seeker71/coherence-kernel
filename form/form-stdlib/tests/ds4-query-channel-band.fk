; preludes: form-stdlib/core.fk form-stdlib/ds4-query-channel.fk

(do
    (let denied (dqc-stream "consent:no" "review" "q"))
    (let review (dqc-stream "consent:yes" "review" "q"))
    (let generate (dqc-stream "consent:yes" "generate" "q"))
    (let complete (dqc-native-token-stream "consent:yes" 4
        (list "observed:19129:efbbbf7573696e67:BOM+using"
              "observed:42:20:space"
              "eos")))
    (let bounded (dqc-native-token-stream "consent:yes" 2
        (list "observed:1:61:a" "observed:2:62:b" "observed:3:63:c")))
    (let waiting (dqc-native-token-stream "consent:yes" 4
        (list "observed:1:61:a")))
    (let invalid (dqc-native-token-stream "consent:yes" 4
        (list "token:invented")))
    (let a (if (ge (str_find denied "Fail:consent-required" 0) 0) 1 0))
    (let b (if (ge (str_find review "complete-as-witness-review" 0) 0) 2 0))
    (let c (if (ge (str_find generate "Cut:continue-building" 0) 0) 4 0))
    (let d (if (ge (str_find generate "token-id:19129;token-bytes:efbbbf7573696e67" 0) 0) 8 0))
    (let e (if (ge (str_find complete "count=2\ncompletion=complete\nterminal=Nil" 0) 0) 16 0))
    (let f (if (ge (str_find bounded "count=2\ncompletion=bounded\nterminal=Cut:token-bound-reached" 0) 0) 32 0))
    (let g (if (ge (str_find waiting "count=1\ncompletion=pending-token\nterminal=Cut:await-native-token" 0) 0) 64 0))
    (let h (if (ge (str_find invalid "terminal=Fail:invalid-native-token-evidence" 0) 0) 128 0))
    (sum (list a b c d e f g h)))
