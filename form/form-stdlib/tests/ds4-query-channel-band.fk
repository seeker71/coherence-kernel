; preludes: form-stdlib/core.fk form-stdlib/ds4-query-channel.fk

(do
    (let denied (dqc-stream "consent:no" "review" "q"))
    (let review (dqc-stream "consent:yes" "review" "q"))
    (let generate (dqc-stream "consent:yes" "generate" "q"))
    (let complete (dqc-native-token-stream "consent:yes" 4
        (list "observed:19129:efbbbf7573696e67:BOM+using"
              "observed:42:20:space"
              "eos")))
    (let bounded (dqc-native-token-stream "consent:yes" 2
        (list "observed:1:61:a" "observed:2:62:b" "observed:3:63:c")))
    (let waiting (dqc-native-token-stream "consent:yes" 4
        (list "observed:1:61:a")))
    (let invalid (dqc-native-token-stream "consent:yes" 4
        (list "token:invented")))
    (let ctl-nil (dqc-native-token-stream "consent:yes" 128000 (list)))
    (let ctl-cut (dqc-native-token-stream "consent:yes" 128001 (list)))
    (let ctl-fail (dqc-native-token-stream "consent:yes" 128002 (list)))
    (let ctl-timeout (dqc-native-token-stream "consent:yes" 128003 (list)))
    (let ctl-choice (dqc-native-token-stream "consent:yes" 128004 (list)))
    (let ctl-unverified (dqc-native-token-stream "consent:yes" 128005 (list)))
    (let ctl-unobserved (dqc-native-token-stream "consent:yes" 128005 (list)))
    (let ctl-denied (dqc-native-token-stream "consent:no" 128001 (list)))
    (let a (if (ge (str_find denied "Fail:consent-required" 0) 0) 1 0))
    (let b (if (ge (str_find review "complete-as-witness-review" 0) 0) 2 0))
    (let c (if (ge (str_find generate "Cut:continue-building" 0) 0) 4 0))
    (let d (if (ge (str_find generate "token-id:19129;token-bytes:efbbbf7573696e67" 0) 0) 8 0))
    (let e (if (ge (str_find complete "count=2\ncompletion=complete\nterminal=Nil" 0) 0) 16 0))
    (let f (if (ge (str_find bounded "count=2\ncompletion=bounded\nterminal=Cut:token-bound-reached" 0) 0) 32 0))
    (let g (if (ge (str_find waiting "count=1\ncompletion=pending-token\nterminal=Cut:await-native-token" 0) 0) 64 0))
    (let h (if (ge (str_find invalid "terminal=Fail:invalid-native-token-evidence" 0) 0) 128 0))
    (let i (if (ge (str_find ctl-nil "control=NIL\ncompletion=complete\nterminal=Nil" 0) 0) 256 0))
    (let j (if (ge (str_find ctl-cut "control=CUT\ncompletion=paused-by-model\nterminal=Cut:model-emitted" 0) 0) 512 0))
    (let k (if (ge (str_find ctl-fail "control=FAIL\ncompletion=incomplete\nterminal=Fail:model-emitted" 0) 0) 1024 0))
    (let l (if (ge (str_find ctl-timeout "control=TIMEOUT\ncompletion=pending-resume\nterminal=Cut:model-timeout" 0) 0) 2048 0))
    (let m (if (ge (str_find ctl-choice "control=CHOICE\ncompletion=pending-choice\nterminal=Cut:model-choice" 0) 0) 4096 0))
    (let n (if (ge (str_find ctl-unverified "terminal=Fail:unverified-control-id" 0) 0) 8192 0))
    (let o (if (ge (str_find ctl-unobserved "terminal=Fail:unverified-control-id" 0) 0) 16384 0))
    (let p (if (ge (str_find ctl-denied "terminal=Fail:consent-required" 0) 0) 32768 0))
    (sum (list a b c d e f g h i j k l m n o p)))
