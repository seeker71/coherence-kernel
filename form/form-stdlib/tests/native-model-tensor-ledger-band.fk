; native-model-tensor-ledger-band.fk — the allocation spec is the ledger.
; PROOF LEVEL: FOURTH-ARM ONLY + LIVE METAL CARRIER (metal_* pf-arm-mask 8, probed 2026-09-03; Verdict 4095 on this host, go/rust/ts stop at unbound nmtl-qwen-scratch-sizes). The pure size/identity fold always
; runs; the physical allocation/release bits remain dark when Metal is absent.
; preludes: form/form-stdlib/native-model-tensor-ledger.bml form/form-stdlib/native-model-dual-telemetry.bml

(do
    (defn nmtlb-bit (ok bit) (if ok bit 0))
    (defn nmtlb-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))

    (let qscratch (nmtl-qwen-scratch-sizes 128))
    (let qlinear (nmtl-qwen-state-sizes 0 128 0))
    (let qfull (nmtl-qwen-state-sizes 3 128 1))
    (let lscratch (nmtl-llama-scratch-sizes 3072 8192 128256 24 128))
    (let before (metal_status))
    (let linked (nmtlb-has before "metal_linked=true"))
    (let beforeBuffers (nmdt-status-int before "buffers"))
    (let h0 (if (eq linked 1) (metal_buf_alloc 64) 0))
    (let h1 (if (eq linked 1) (metal_buf_alloc 128) 0))
    (let h2 (if (eq linked 1) (metal_buf_alloc 256) 0))
    (let group (nmtl-group "tensor.test" "model.test" "owner.test"
        "allocated-tensors" (list h0 h1 h2) (list 64 128 256) 1000
        "band.live-metal" (list "tensor" "metal" "gpu")))
    (let sample (nmdt-tensor-group-sample group))
    (let mappedGroup (nmtl-group "tensor.test.mapped" "model.test" "owner.test"
        "mapped-tensors" (list h0 h1 h2) (list 64 128 256) 1000
        "band.live-metal" (list "tensor" "metal" "gpu")))
    (let mappedSample (nmdt-tensor-group-sample mappedGroup))
    (let reconciledSamples (nmdt-tensor-reconcile-samples (list group)
        "buffers=3\nmmap_nocopy_buffers=0\n" "owner.test" 1000))
    (let duringBuffers (nmdt-status-int (metal_status) "buffers"))
    (let released (if (eq linked 1)
        (and (eq (metal_buf_free h0) 1)
             (and (eq (metal_buf_free h1) 1) (eq (metal_buf_free h2) 1)))
        0))
    (let afterBuffers (nmdt-status-int (metal_status) "buffers"))
    (let invalid (nmtl-group "tensor.bad" "model.test" "owner.test"
        "allocated-tensors" (list 1 2) (list 64) 1000
        "band.invalid" (list "tensor")))
    (let authority (read_file "form/form-stdlib/bml/native-model-tensor-ledger.bml"))
    (let qprofile (nmtl-qwen-layout-profile))
    (let tprofile (nmtl-llama-layout-profile))
    (let profiles (nmtl-owner-layout-profiles))
    (let qartifacts (nmtl-layout-profile-artifact qprofile))
    (let tartifacts (nmtl-layout-profile-artifact tprofile))
    (let inodeArtifacts (list (nmtl-artifact-identity "artifact.inode-adversary" 4096 1700000000 "12345" "inode")))
    (let digestArtifacts (list (nmtl-artifact-identity "artifact.digest-fixture" 4096 1700000000 "sha256:fixture" "content-digest")))

    (let b0 (nmtlb-bit (eq (len qscratch) 49) 1))
    (let b1 (nmtlb-bit (and (eq (len (nmtl-positive-values qlinear)) 2)
                             (eq (nmtl-sum qlinear) 3309568)) 2))
    (let b2 (nmtlb-bit (and (eq (len (nmtl-positive-values qfull)) 2)
                             (eq (nmtl-sum qfull) 262144)) 4))
    (let b3 (nmtlb-bit (eq (len lscratch) 17) 8))
    (let b4 (nmtlb-bit (eq (nmtl-llama-cache-bytes 1024 128) 524288) 16))
    (let b5 (nmtlb-bit (eq (nmtl-group-valid? invalid) 0) 32))
    (let b6 (nmtlb-bit (and (eq linked 1)
                             (and (eq (nmtl-group-valid? group) 1)
                              (and (eq (nmtl-group-bytes group) 448)
                               (eq (nmtl-group-handles group) 3)))) 64))
    (let b7 (nmtlb-bit (and (eq linked 1)
                             (and (eq (sub duringBuffers beforeBuffers) 3)
                                  (and (eq released 1) (eq afterBuffers beforeBuffers)))) 128))
    (let b8 (nmtlb-bit (and (str_eq (fgtm-sample-evidence sample) "physical-live")
                             (and (eq (fgtm-field-value (fgtm-sample-bytes sample)) 448)
                                  (eq (fgtm-field-value (fgtm-sample-capacity sample)) 3))) 256))
    (let b9 (nmtlb-bit (and (eq (nmtlb-has authority "same size list") 1)
                             (eq (nmtlb-has authority "never mint another group identity") 1)) 512))
    (let b10 (nmtlb-bit (and (eq (fgtm-sample-valid? sample) 1)
                               (and (str_eq (fgtm-sample-plane sample) "unified")
                                    (and (eq (fgtm-sample-valid? mappedSample) 1)
                                         (str_eq (fgtm-sample-plane mappedSample) "disk")))) 1024))
    (let b11 (nmtlb-bit (and (eq (nmtl-qwen-allocated-bytes 128 48 4) 124435036)
                               (and (eq (nmtl-qwen-allocated-handles 128 48 4) 145)
                                (and (eq (nmtl-llama-allocated-bytes 3072 8192 128256 24 1024 28 128) 30102560)
                                     (eq (nmtl-llama-allocated-handles 3072 8192 128256 24 1024 28 128) 73)))) 2048))
    (let b12 (nmtlb-bit (eq (sum (list
        (eq (nmtl-layout-profile-valid? qprofile) 1)
        (eq (nmtl-layout-profile-mapped-bytes qprofile) 78858104320)
        (eq (nmtl-layout-profile-mapped-handles qprofile) 1224)
        (eq (nmtl-layout-profile-allocated-bytes qprofile) 124435036)
        (eq (nmtl-layout-profile-allocated-handles qprofile) 145)
        (eq (len qartifacts) 3)
        (eq (nmtl-artifact-identity-valid? (head qartifacts)) 1)
        (eq (nmtl-artifact-identity-modified (head qartifacts)) 1788069212)
        (eq (nmtl-artifact-identities-content-bound? qartifacts) 0)
        (eq (nmtl-artifact-identities-content-bound? inodeArtifacts) 0)
        (eq (nmtl-artifact-identities-content-bound? digestArtifacts) 1))) 11) 4096))
    (let b13 (nmtlb-bit (and (eq (nmtl-layout-profile-valid? tprofile) 1)
                               (and (eq (nmtl-layout-profile-mapped-bytes tprofile) 2334744832)
                                (and (eq (nmtl-layout-profile-mapped-handles tprofile) 256)
                                 (and (eq (nmtl-profiles-mapped-bytes profiles) 81192849152)
                                  (and (eq (nmtl-profiles-mapped-handles profiles) 1480)
                                   (and (eq (nmtl-profiles-allocated-bytes profiles) 154537596)
                                    (and (eq (nmtl-profiles-allocated-handles profiles) 218)
                                     (and (eq (len tartifacts) 1)
                                          (eq (nmtl-artifact-identity-bytes (head tartifacts)) 2019377376))))))))) 8192))
    (let b14 (nmtlb-bit (and (eq (len reconciledSamples) 5)
                               (and (eq (fgtm-samples-valid? reconciledSamples) 1)
                                (and (str_eq (fgtm-sample-purpose (nth reconciledSamples 3)) "reconciled")
                                 (and (eq (fgtm-field-present? (fgtm-sample-bytes (nth reconciledSamples 3))) 0)
                                  (and (eq (fgtm-field-value (fgtm-sample-capacity (nth reconciledSamples 3))) 3)
                                   (and (str_eq (fgtm-sample-lifecycle mappedSample) "mapped")
                                        (str_eq (fgtm-sample-plane mappedSample) "disk"))))))) 16384))
    (let b15 (nmtlb-bit (and (eq (nmtlb-has authority "profile never promote exact extents") 1)
                               (and (eq (nmtlb-has authority "unpublished carrier count becomes one exact missing door") 1)
                                    (eq (nmtlb-has authority "not-on-owner-path") 1))) 32768))
    (sum (list b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15))
)
