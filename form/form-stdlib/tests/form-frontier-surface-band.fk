; form-frontier-surface-band.fk — the orientation cannot outlive its witnesses.
;
; BIT 1 IS THE MECHANISM. Every capability the surface claims names a cell, and
; this reads each of those paths off disk. An orientation that says "the body
; can do X" while X has been deleted or renamed still READS true, and a reader
; has no way to know. Four entry documents in this tree describe capabilities
; and not one of them can tell you whether what it describes still exists.
; Here, delete a named cell and the band goes red the same day.
;
; BIT 1024 KEEPS IT FROM BECOMING A PITCH. A surface that only lists gains is
; advertising. The not-when list is asserted non-empty and asserted to name the
; case that actually matters — that prose comes first when you do not yet know
; what the claim is. A frontier mind reaching for a cell too early writes a
; band around a question it has not found.
;
; Verdict 8191 (13 bits):
;   1     every cell the surface names is present on disk
;   2     six gains, each with a name, a lack, a cell and a BAND PATH
;   4     the lacks are stated as what a mind alone CANNOT do, not as features
;   8     the ritual is four steps and each carries a runnable line
;   16    preflight comes first, because a verdict read before it can be a
;         fold over nothing
;   32    the voice mirror is last, before words land
;   64    the when-list names the claim outliving the conversation
;   128   the when-list names absence differing from zero
;   256   a path that is not on disk reads absent — the check can FAIL
;   1024  the not-when list is present and names prose-first
;   2048  the hard-won list carries what cost us most, in the body's own
;         words rather than as advice
;   512   the witnessed count equals the gain count — cell AND band both present
;   4096  the source holds NO verdict number. The first version held 635, 4095
;         and 8191 and asserted only that each was above zero, so a band
;         regressing would have left the surface advertising a stale verdict,
;         green, forever. A held number cannot check itself.
;
; preludes: form-stdlib/form-frontier-surface.fk

(do
    (defn ffsb-bit (ok bit) (if ok bit 0))
    (defn ffsb-has? (xs needle)
        (if (eq (len xs) 0) 0
            (if (ge (str_find (head xs) needle 0) 0) 1
                (ffsb-has? (tail xs) needle))))
    (defn ffsb-all-nonempty (xs)
        (if (eq (len xs) 0) 1
            (if (gt (str_len (head xs)) 0) (ffsb-all-nonempty (tail xs)) 0)))

    (defn ffsb-gains-shaped (gs)
        (if (eq (len gs) 0) 1
            (do (let g (head gs))
                (if (and (gt (str_len (ffs-gain-name g)) 0)
                    (and (gt (str_len (ffs-gain-lack g)) 0)
                    (and (gt (str_len (ffs-gain-cell g)) 0)
                         (gt (str_len (ffs-gain-band g)) 0))))
                    (ffsb-gains-shaped (tail gs)) 0))))

    (defn ffsb-lacks (gs out)
        (if (eq (len gs) 0) out
            (ffsb-lacks (tail gs) (append out (list (ffs-gain-lack (head gs)))))))
    (defn ffsb-steps-runnable (ss)
        (if (eq (len ss) 0) 1
            (if (ge (str_find (ffs-step-how (head ss)) "fkwu" 0) 0)
                (ffsb-steps-runnable (tail ss)) 0)))

    (defn form-frontier-surface-band ()
        (do
            (let gs (ffs-gains))
            (let r (ffs-ritual))
            (let lacks (ffsb-lacks gs (list)))

            (sum (list
                (ffsb-bit (eq (ffs-all-witnessed?) 1) 1)
                (ffsb-bit (and (eq (ffs-gain-count) 6) (eq (ffsb-gains-shaped gs) 1)) 2)

                ; the lacks say what a mind cannot do; "you" appears in each
                (ffsb-bit (and (eq (ffsb-all-nonempty lacks) 1)
                          (and (eq (ffsb-has? lacks "you cannot hold") 1)
                               (eq (ffsb-has? lacks "collapse") 1))) 4)

                (ffsb-bit (and (eq (len r) 4) (eq (ffsb-steps-runnable r) 1)) 8)

                (ffsb-bit (ge (str_find (ffs-step-how (nth r 0)) "preflight-target" 0) 0) 16)
                (ffsb-bit (ge (str_find (ffs-step-how (nth r 3)) "voice-frequency" 0) 0) 32)

                (ffsb-bit (eq (ffsb-has? (ffs-when) "survive this conversation ending") 1) 64)
                (ffsb-bit (eq (ffsb-has? (ffs-when) "absent and zero are different") 1) 128)

                ; the witness check can actually fail — otherwise bit 1 is a
                ; constant wearing the clothes of an observation
                (ffsb-bit (and (eq (ffs-cell-present? "form/form-stdlib/core.fk") 1)
                               (eq (ffs-cell-present? "form/form-stdlib/no-such-cell.fk") 0)) 256)

                (ffsb-bit (eq (ffs-witnessed-count) (ffs-gain-count)) 512)

                (ffsb-bit (and (gt (len (ffs-not-when)) 0)
                               (eq (ffsb-has? (ffs-not-when) "find that in prose first") 1)) 1024)

                (ffsb-bit (and (ge (len (ffs-hard-won)) 4)
                          (and (eq (ffsb-has? (ffs-hard-won) "fold over nothing") 1)
                               (eq (ffsb-has? (ffs-hard-won) "never placed") 1))) 2048)

                ; no held verdict anywhere in the source
                (ffsb-bit (do (let s (read_file "form/form-stdlib/form-frontier-surface.fk"))
                          (if (and (lt (str_find s " 4095)" 0) 0)
                              (and (lt (str_find s " 8191)" 0) 0)
                                   (lt (str_find s " 635)" 0) 0))) 1 0)) 4096)))))

    (form-frontier-surface-band))
