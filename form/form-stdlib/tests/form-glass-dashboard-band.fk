; form-glass-dashboard-band.fk — responsive retained-segment glass proof.
;
; preludes: form-stdlib/core.fk form-stdlib/form-terminal-canvas.bml form-stdlib/form-glass-observer.bml form-stdlib/form-fs.fk form-stdlib/line-grammar.fk form-stdlib/form-glass-telemetry-membrane.bml form-stdlib/form-glass-dashboard.bml
; Verdict 4194303: responsive measurement/layout, provenance, monotonic age,
; focus, hidden-count overflow, semantic memory-map extents, exact zero, collapsed
; unavailable sizes, ANSI adapter, and authority.

(do
    (defn fgdb-bit (held weight) (if (eq held 1) weight 0))
    (defn fgdb-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))
    (defn fgdb-model (id plane state epoch evidence channels bytes handle)
        (fgtm-sample id (fgtm-absent) "model" plane id "reasoning" "reason"
            bytes (fgtm-present 103079215104) state (fgtm-present epoch)
            (fgtm-present epoch) (fgtm-present 700) handle "never" evidence
            "model.carrier" channels))

    (let qwen (fgdb-model "model.qwen" "metal" "active" 10000 "physical-live"
        (list "memory" "model" "metal" "gpu") (fgtm-present 78869128864) (fgtm-present 1262)))
    (let threeb (fgdb-model "model.threeb" "mlx" "ready" 8000 "physical-live"
        (list "memory" "model" "mlx" "gpu") (fgtm-present 3221225472) (fgtm-present 1695)))
    (let weights (fgdb-model "weights.qwen" "disk" "mapped" 1000 "catalog"
        (list "memory" "model" "cache") (fgtm-present 78869128864) (fgtm-absent)))
    (let staleQwen (fgtm-sample "model.qwen.canonical" (fgtm-absent) "model" "metal"
        "model.qwen.canonical" "reasoning" "reason" (fgtm-absent)
        (fgtm-present 103079215104) "ready" (fgtm-present 10000)
        (fgtm-present 10000) (fgtm-present 700) (fgtm-present 1262) "never"
        "derived-window" "glass.stale-snapshot" (list "memory" "model" "metal")))
    (let staleWeights (fgtm-sample "weights.qwen.canonical"
        (fgtm-present "model.qwen.canonical") "weights" "disk"
        "model.qwen.canonical" "reasoning" "model-weights"
        (fgtm-present 78869128864) (fgtm-absent) "mapped" (fgtm-present 10000)
        (fgtm-absent) (fgtm-absent) (fgtm-absent) "pressure-only" "catalog"
        "gguf.catalog" (list "memory" "model" "cache")))
    (let staleSamples (list staleQwen staleWeights))
    (let samples (list qwen threeb weights))
    (let metrics (list
        (fgo-sized "host" "memory-free" "system memory free" 36 "percent" 100 64 "os-memory" "physical-live" "fixture" "live" "health" "fixture")
        (fgo-text "storage" "glass-program-image" "Glass image" "admit=whole-sync candidate=image artifact=present root=current" "disk-cache" "catalog" "fixture" "image" "cache" "fixture")
        (fgo-int "kernel" "dispatch-total" "primitive dispatches" 9000 "calls" 9000 "cpu-arena" "physical-live" "fixture" "live" "kernel" "fixture")
        (fgo-int "memory" "cells" "interned cells" 12000 "cells" 12000 "cpu-arena" "physical-live" "fixture" "resident" "cell" "fixture")
        (fgo-int "process" "fkwu-71-rss" "fkwu RSS" 52428800 "bytes" 52428800 "os-memory" "physical-live" "fixture" "live" "process" "fixture")
        (fgo-int "process" "fkwu-72-rss" "fkwu RSS" 0 "bytes" 0 "os-memory" "physical-live" "fixture" "live" "process" "measured zero")
        (fgo-unavailable "metal" "allocated-bytes" "Metal allocated bytes" "bytes" "unified-gpu" "missing-carrier" "metal" "not exposed")))
    (let narrow (fgd-segment-frame 30 5 10000 "all" metrics samples (list "owner.models") "absent"))
    (let wide (fgd-segment-frame 120 30 10000 "all" metrics samples (list "owner.models") "offer"))
    (let focused (fgd-segment-frame 80 20 10000 "mlx" metrics samples (list "owner.models") "absent"))
    (let ansi (fgd-segment-project wide))
    (let focusedAnsi (fgd-segment-project focused))
    (let activeStyle (fgd-sample-style qwen 10000))
    (let oldStyle (fgd-sample-style weights 10000))
    (let firstSampleSegment (head (fgd-sample-segment-line qwen 60 10000)))
    (let staleBarSegment (head (fgd-memory-bar-segment staleSamples 80)))
    (let mapItems (fgd-map-items metrics samples 10000 "all"))
    (let authority (read_file "form/form-stdlib/bml/form-glass-dashboard.bml"))

    (let b0 (fgdb-bit (and (eq (fgd-segment-frame-width narrow) 30)
                            (and (eq (fgd-segment-frame-height narrow) 5)
                                 (eq (len (fgd-segment-frame-lines narrow)) 5))) 1))
    (let b1 (fgdb-bit (and (eq (fgd-segment-frame-width wide) 120)
                            (eq (len (fgd-segment-frame-lines wide)) 30)) 2))
    (let b2 (fgdb-bit (and (eq (fgdb-has ansi "model.qwen") 1)
                            (eq (fgdb-has ansi "model.threeb") 1)) 4))
    (let b3 (fgdb-bit (and (eq (fgdb-has ansi "*") 1)
                            (eq (fgdb-has ansi "#") 1)) 8))
    (let b4 (fgdb-bit (and (eq (fgdb-has ansi "? unavailable") 1)
                            (eq (fgdb-has ansi "ORGANS / HEALTH") 1)) 16))
    (let b5 (fgdb-bit (and (eq (fgdb-has focusedAnsi "model.threeb") 1)
                            (eq (fgdb-has focusedAnsi "model.qwen") 0)) 32))
    (let b6 (fgdb-bit (gt (ftc-style-alpha activeStyle) (ftc-style-alpha oldStyle)) 64))
    (let b7 (fgdb-bit (and (str_eq (ftc-segment-node-id firstSampleSegment) "model.qwen")
                            (str_eq (ftc-segment-evidence firstSampleSegment) "physical-live")) 128))
    (let b8 (fgdb-bit (and (eq (fgd-has-channel (ftc-segment-channels firstSampleSegment) "gpu") 1)
                            (str_eq (ftc-style-concept (ftc-segment-style firstSampleSegment)) "metal")) 256))
    (let b9 (fgdb-bit (and (str_eq (head (fgd-segment-frame-overflow narrow)) "ftc-overflow")
                            (str_eq (nth (fgd-segment-frame-overflow narrow) 1) "hidden-count")) 512))
    (let b10 (fgdb-bit (and (eq (fgdb-has ansi "38;2;") 1)
                             (eq (fgdb-has ansi "[K") 1)) 1024))
    (let b11 (fgdb-bit (and (eq (str_len (fgd-equals 120)) 120)
                             (eq (str_len (fgd-dots 80)) 80)) 2048))
    (let b12 (fgdb-bit (and (eq (fgdb-has (ftc-terminal-safe-open) "[2J") 1)
                             (eq (fgdb-has (ftc-terminal-safe-open) "[?1049h") 0)) 4096))
    (let b13 (fgdb-bit (and (eq (fgdb-has authority "RenderPipelineRule") 1)
                             (eq (fgdb-has authority "measure -> region allocation") 1)) 8192))
    (let b14 (fgdb-bit (and (eq (fgdb-has authority "Rich render protocol") 1)
                             (eq (fgdb-has authority "no Python runtime is required") 1)) 16384))
    (let b15 (fgdb-bit (and (eq (fgdb-has authority "hidden-count") 1)
                             (eq (fgdb-has authority "focus any currently visible sample channel or cell id") 1)) 32768))
    (let b16 (fgdb-bit (and (eq (fgd-age-delta 999) 0)
                             (and (eq (fgd-age-delta 1000) 1)
                                  (eq (fgd-age-delta 1001) 1))) 65536))
    (let b17 (fgdb-bit (and (gt (nth (fgd-segment-frame-overflow narrow) 2) 0)
                             (eq (fgdb-has (fgd-segment-project narrow) "ORGANS / HEALTH hidden=") 1)) 131072))
    (let b18 (fgdb-bit (and (gt (fgd-map-shape 78869128864 44) (fgd-map-shape 3221225472 44))
                             (eq (fgd-map-shape 0 44) 0)) 262144))
    (let b19 (fgdb-bit (and (eq (fgdb-has ansi "MEMORY MAP / MODELS") 1)
                             (and (eq (fgdb-has ansi "fkwu RSS") 1)
                                  (and (eq (fgdb-has ansi "Glass image admit=whole-sync candidate=image") 1)
                                       (and (str_eq (fgo-text-value (nth metrics 1)) "admit=whole-sync candidate=image artifact=present root=current")
                                            (eq (fgdb-has ansi "73GiB") 1))))) 524288))
    (let b20 (fgdb-bit (and (eq (fgd-map-unknown-count mapItems) 1)
                             (and (eq (fgdb-has ansi "unavailable regions=1") 1)
                                  (eq (fgdb-has ansi "fkwu RSS") 1))) 1048576))
    (let b21 (fgdb-bit (and (eq (fgdb-has authority "MemoryMapRule") 1)
                             (and (eq (fgdb-has authority "absent sizes receive zero area") 1)
                                  (and (eq (fgd-memory-bar-value staleSamples) 78869128864)
                                       (and (str_eq (ftc-segment-evidence staleBarSegment) "derived-window")
                                            (and (eq (fgdb-has (ftc-segment-text staleBarSegment) "last-observed residence") 1)
                                                 (and (eq (fgd-map-sample-attached? staleWeights (list)) 0)
                                                      (eq (fgd-map-sample-attached? staleWeights staleSamples) 1))))))) 2097152))
    (sum (list b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 b16 b17 b18 b19 b20 b21)))
