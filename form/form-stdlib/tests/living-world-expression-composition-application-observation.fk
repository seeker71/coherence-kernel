; living-world-expression-composition-application-observation.fk -- held-out
; derivation and zero/one/many plan stage; no surface payload is emitted.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk form-stdlib/living-world-expression-composition.fk form-stdlib/tests/living-world-expression-blueprint-witness.fk form-stdlib/tests/living-world-expression-composition-witness.fk

(do
    (let world (lwxcbw-application-world))
    (let application-c
        (lwo-emergent-shape (lwxcbw-application-candidate-c)))
    (let application-d
        (lwo-emergent-shape (lwxcbw-application-candidate-d)))
    (let derivation-c (lwxc-application-derivation application-c))
    (let derivation-d (lwxc-application-derivation application-d))
    (let zero (lwxcbw-zero-plan))
    (let one (lwxcbw-one-plan))
    (let many (lwxcbw-many-plan))
    (list
        (if (node_eq (lwxc-derivation-bridge derivation-c)
                (lwxbw-expected-a)) 1 0)
        (if (node_eq (lwxc-derivation-bridge derivation-d)
                (lwxbw-expected-a)) 1 0)
        (if (node_eq (lwxc-derivation-output derivation-c)
                (lwxcbw-expected-c)) 1 0)
        (if (node_eq (lwxc-derivation-output derivation-d)
                (lwxcbw-expected-d)) 1 0)
        (if (and (not (node_eq (lwxcbw-expected-c)
                          (lwxcbw-sequence-c-output-one)))
                 (not (node_eq (lwxcbw-expected-c)
                          (lwxcbw-sequence-c-output-two)))) 1 0)
        (lwxc-application-integrated-current? world
            (lwxcbw-application-candidate-c))
        (lwxc-application-integrated-current? world
            (lwxcbw-application-candidate-d))
        (lwxb-incomplete? (lwxc-plan-status zero))
        (lwxb-ready? (lwxc-plan-status one))
        (lwxb-ambiguous? (lwxc-plan-status many))
        (lwo-field-size (lwxc-plan-options many))
        (if (node_eq (lwxc-emit-from-plan world many) (lwo-none)) 1 0)))
