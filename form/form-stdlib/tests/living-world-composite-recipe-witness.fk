; living-world-composite-recipe-witness.fk -- a settled behavior class derives
; two equivalent nested Recipe surfaces and answers held-out use.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk form-stdlib/living-world-operation-field.fk form-stdlib/living-world-composite-recipe.fk form-stdlib/living-world-composite-answer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-structural-recipe-witness.fk form-stdlib/tests/living-world-operation-field-witness.fk

(let LWOECW-FIXTURE      (bp "LWOECW-FIXTURE"))
(let LWOECW-SOURCE-O     (bp "LWOECW-SOURCE-O"))
(let LWOECW-SOURCE-P     (bp "LWOECW-SOURCE-P"))
(let LWOECW-SOURCE-Q     (bp "LWOECW-SOURCE-Q"))
(let LWOECW-SOURCE-R     (bp "LWOECW-SOURCE-R"))
(let LWOECW-SOURCE-S     (bp "LWOECW-SOURCE-S"))
(let LWOECW-SOURCE-T     (bp "LWOECW-SOURCE-T"))
(let LWOECW-SOURCE-U     (bp "LWOECW-SOURCE-U"))
(let LWOECW-SOURCE-V     (bp "LWOECW-SOURCE-V"))
(let LWOECW-SOURCE-W     (bp "LWOECW-SOURCE-W"))
(let LWOECW-PROV-O       (bp "LWOECW-PROV-O"))
(let LWOECW-PROV-P       (bp "LWOECW-PROV-P"))
(let LWOECW-PROV-Q       (bp "LWOECW-PROV-Q"))
(let LWOECW-PROV-R       (bp "LWOECW-PROV-R"))
(let LWOECW-PROV-S       (bp "LWOECW-PROV-S"))
(let LWOECW-PROV-T       (bp "LWOECW-PROV-T"))
(let LWOECW-PROV-U       (bp "LWOECW-PROV-U"))
(let LWOECW-PROV-V       (bp "LWOECW-PROV-V"))
(let LWOECW-PROV-W       (bp "LWOECW-PROV-W"))
(let LWOECW-EVIDENCE     (bp "LWOECW-EVIDENCE"))
(let LWOECW-ALTERNATIVE  (bp "LWOECW-ALTERNATIVE"))
(let LWOECW-REASON       (bp "LWOECW-REASON"))

(defn lwoecw-cell (kind) (intern_node kind (empty)))
(defn lwoecw-source-o () (lwoecw-cell LWOECW-SOURCE-O))
(defn lwoecw-source-p () (lwoecw-cell LWOECW-SOURCE-P))
(defn lwoecw-source-q () (lwoecw-cell LWOECW-SOURCE-Q))
(defn lwoecw-source-r () (lwoecw-cell LWOECW-SOURCE-R))
(defn lwoecw-source-s () (lwoecw-cell LWOECW-SOURCE-S))
(defn lwoecw-source-t () (lwoecw-cell LWOECW-SOURCE-T))
(defn lwoecw-source-u () (lwoecw-cell LWOECW-SOURCE-U))
(defn lwoecw-source-v () (lwoecw-cell LWOECW-SOURCE-V))
(defn lwoecw-source-w () (lwoecw-cell LWOECW-SOURCE-W))
(defn lwoecw-prov-o () (lwoecw-cell LWOECW-PROV-O))
(defn lwoecw-prov-p () (lwoecw-cell LWOECW-PROV-P))
(defn lwoecw-prov-q () (lwoecw-cell LWOECW-PROV-Q))
(defn lwoecw-prov-r () (lwoecw-cell LWOECW-PROV-R))
(defn lwoecw-prov-s () (lwoecw-cell LWOECW-PROV-S))
(defn lwoecw-prov-t () (lwoecw-cell LWOECW-PROV-T))
(defn lwoecw-prov-u () (lwoecw-cell LWOECW-PROV-U))
(defn lwoecw-prov-v () (lwoecw-cell LWOECW-PROV-V))
(defn lwoecw-prov-w () (lwoecw-cell LWOECW-PROV-W))
(defn lwoecw-evidence () (lwoecw-cell LWOECW-EVIDENCE))
(defn lwoecw-alternative () (lwoecw-cell LWOECW-ALTERNATIVE))
(defn lwoecw-reason () (lwoecw-cell LWOECW-REASON))

(defn lwoecw-entry-o (payload)
    (lwphw-entry (lwoecw-source-o) (lwoecw-prov-o) payload))
(defn lwoecw-entry-p (payload)
    (lwphw-entry (lwoecw-source-p) (lwoecw-prov-p) payload))
(defn lwoecw-entry-q (payload)
    (lwphw-entry (lwoecw-source-q) (lwoecw-prov-q) payload))
(defn lwoecw-entry-r (payload)
    (lwphw-entry (lwoecw-source-r) (lwoecw-prov-r) payload))
(defn lwoecw-entry-s (payload)
    (lwphw-entry (lwoecw-source-s) (lwoecw-prov-s) payload))
(defn lwoecw-entry-t (payload)
    (lwphw-entry (lwoecw-source-t) (lwoecw-prov-t) payload))
(defn lwoecw-entry-u (payload)
    (lwphw-entry (lwoecw-source-u) (lwoecw-prov-u) payload))
(defn lwoecw-entry-v (payload)
    (lwphw-entry (lwoecw-source-v) (lwoecw-prov-v) payload))
(defn lwoecw-entry-w (payload)
    (lwphw-entry (lwoecw-source-w) (lwoecw-prov-w) payload))

(defn lwoecw-choice ()
    (lwlc-choice (lwo-none)
        (lwo-field (list (lwoecw-alternative)))
        (lwlc-unknown (lwoecw-evidence)) (lwoecw-evidence)))
(defn lwoecw-timeout ()
    (oac-timeout (intern_trivial_int 10)
        (oac-alternative-ack
            (lwoecw-evidence) (lwoecw-alternative)
            (lwoecw-evidence))
        (lwoecw-evidence)))

(defn lwoecw-other-blueprint (component schema)
    (lwoec-blueprint component (lwoew-second-role schema)
        (lwoew-codecs schema) (lwo-empty-field) (lwo-none)
        (lwo-none) (lwo-none) (lwoecw-evidence)))
(defn lwoecw-blueprint (component schema)
    (lwoec-blueprint component (lwoew-first-role schema)
        (lwoew-codecs schema)
        (lwo-field
            (list (lwoecw-other-blueprint component schema)
                  (lwoecw-alternative)))
        (lwlc-unknown (lwoecw-evidence))
        (lwoecw-choice) (lwoecw-timeout) (lwoecw-evidence)))
(defn lwoecw-example (component schema)
    (lwoec-example (lwoecw-blueprint component schema)
        (lwoew-e2-values schema) (intern_trivial_int 11)
        (oac-one (intern_trivial_int 11))
        (lwo-field (list (lwoecw-alternative)))
        (lwlc-unknown (lwoecw-evidence)) (lwoecw-evidence)))
(defn lwoecw-rich-query (candidate schema)
    (lwoec-query candidate (lwoew-q-values schema)
        (lwo-field (list (lwoecw-alternative)))
        (lwlc-unknown (lwoecw-evidence))
        (lwoecw-choice) (lwoecw-timeout) (lwoecw-evidence)))
(defn lwoecw-minimal-query (candidate schema)
    (lwoec-query candidate (lwoew-q-values schema)
        (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none)
        (lwoecw-evidence)))

(defn lwoecw-blueprint-world (evolved)
    (do
        (let schema (lwoew-base-schema (lwoew-evolved-base evolved)))
        (let component (lwoew-evolved-candidate evolved))
        (let blueprint (lwoecw-blueprint component schema))
        (let example (lwoecw-example component schema))
        (lwt-receive-stream (lwoew-evolved-world evolved)
            (list
                (lwoecw-entry-o blueprint)
                (lwoecw-entry-p blueprint)
                (lwoecw-entry-w
                    (lwoecw-other-blueprint component schema))
                (lwoecw-entry-q example)
                (lwoecw-entry-r example)))))
(defn lwoecw-query-world (world rich minimal)
    (lwt-receive-stream world
        (list
            (lwoecw-entry-s rich)
            (lwoecw-entry-t rich)
            (lwoecw-entry-u minimal)
            (lwoecw-entry-v minimal))))

; children: evolved operation fixture, blueprint world/proposal/candidate/field,
;           integrated round, query world, rich query/answer, minimal query/
;           answer
(defn lwoecw-fixture
    (evolved blueprint-world proposal candidate field integrated world
     rich rich-answer minimal minimal-answer)
    (intern_node LWOECW-FIXTURE
        (list evolved blueprint-world proposal candidate field integrated
              world rich rich-answer minimal minimal-answer)))
(defn lwoecw-fixture-evolved (fixture) (nth (node_children fixture) 0))
(defn lwoecw-fixture-blueprint-world (fixture)
    (nth (node_children fixture) 1))
(defn lwoecw-fixture-proposal (fixture) (nth (node_children fixture) 2))
(defn lwoecw-fixture-candidate (fixture) (nth (node_children fixture) 3))
(defn lwoecw-fixture-field (fixture) (nth (node_children fixture) 4))
(defn lwoecw-fixture-integrated (fixture) (nth (node_children fixture) 5))
(defn lwoecw-fixture-world (fixture) (nth (node_children fixture) 6))
(defn lwoecw-fixture-rich-query (fixture) (nth (node_children fixture) 7))
(defn lwoecw-fixture-rich-answer (fixture) (nth (node_children fixture) 8))
(defn lwoecw-fixture-minimal-query (fixture) (nth (node_children fixture) 9))
(defn lwoecw-fixture-minimal-answer (fixture)
    (nth (node_children fixture) 10))

(defn lwoecw-build ()
    (do
        (let evolved (lwoew-build-evolved))
        (let schema (lwoew-base-schema (lwoew-evolved-base evolved)))
        (let component (lwoew-evolved-candidate evolved))
        (let blueprint (lwoecw-blueprint component schema))
        (let blueprint-world (lwoecw-blueprint-world evolved))
        (let proposal (lwoec-proposal blueprint-world blueprint 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let field (lwo-emergent-shape candidate))
        (let integrated
            (lwoec-integrate
                (lwphw-answered-round blueprint-world proposal
                    (lwoew-evolved-round evolved))
                proposal (lwphw-action)))
        (let rich (lwoecw-rich-query candidate schema))
        (let minimal (lwoecw-minimal-query candidate schema))
        (let world
            (lwoecw-query-world (lwt-round-world integrated) rich minimal))
        (lwoecw-fixture evolved blueprint-world proposal candidate field
            integrated world rich
            (lwoec-answer-for world rich 2 (intern_trivial_int 5))
            minimal (lwoec-answer-for world minimal 2 (lwo-none)))))

(defn lwoecw-revoked-example-world (fixture)
    (do
        (let evolved (lwoecw-fixture-evolved fixture))
        (let schema (lwoew-base-schema (lwoew-evolved-base evolved)))
        (let example
            (lwoecw-example (lwoew-evolved-candidate evolved) schema))
        (lwt-receive-stream (lwoecw-fixture-world fixture)
            (list
                (lwoecw-entry-r
                    (lwo-revocation example (lwoecw-source-r)
                        (lwoecw-reason) (lwoecw-prov-r)))))))

0
