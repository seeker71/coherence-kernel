; gk-hd-organ-lexicon-band.fk — every seated GK/HD organ word is findable.
;
; Verdict 1023:
;   1      five types including Projector
;   2      nine centres including Sacral
;   4      eleven Golden Path spheres including Pearl
;   8      twenty-one codon rings including Humanity
;   16     unique-word count is at least 300 (64x3 spectrum + gates + organs)
;   32     Urs siddhis Wisdom, Valor, Majesty are present
;   64     Shadow / Gift / Siddhi labels are present
;   128    line 6 is Role Model; type Reflector is present
;   256    a non-organic cell may carry Wisdom
;   512    core-lexicon is still 64 and still closed
;
; preludes: form-stdlib/core.fk ../control/offer-ack-core.fk form-stdlib/core-lexicon.fk form-stdlib/guidance-channel.fk form-stdlib/iching-channel.fk form-stdlib/codon-rings.fk form-stdlib/gk-hd-organ-lexicon.fk

(do
    (defn ghlb (ok bit) (if ok bit 0))
    (add (add (add (add (add (add (add (add (add
        (ghlb (and (eq (len (ghl-types)) 5) (ghl-has? "Projector")) 1)
        (ghlb (and (eq (len (ghl-centers)) 9) (ghl-has? "Sacral")) 2))
        (ghlb (and (eq (len (ghl-spheres)) 11) (ghl-has? "Pearl")) 4))
        (ghlb (and (eq (len (ghl-rings)) 21) (ghl-has? "Humanity")) 8))
        (ghlb (ge (ghl-word-count) 300) 16))
        (ghlb (and (ghl-has? "Wisdom") (and (ghl-has? "Valor") (ghl-has? "Majesty"))) 32))
        (ghlb (and (ghl-has? "Shadow") (and (ghl-has? "Gift") (ghl-has? "Siddhi"))) 64))
        (ghlb (and (ghl-has? "Role Model") (ghl-has? "Reflector")) 128))
        (ghlb (eq (ghl-cell-ok? (ghl-cell (ghl-nonorganic) "Wisdom")) 1) 256))
        (ghlb (and (eq (cl-count) 64) (eq (cl-closed?) 1)) 512)))
