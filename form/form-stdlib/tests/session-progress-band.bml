; session-progress-band.bml — the measure's reads of the host: the environment, a file's times and the local day, with no program.
; The measure ran `printenv NAME`, `stat -f '%B %m'` and `date -r secs +%Y-%m-%d` through a shell; they are host_getenv, host_file_identity and
; host_localtime now (host-fs.bml). No ledger is touched and no transcript is read: the band's own scratch file is the only file.
;
;   1     env: sp-env is the host's value trimmed ("" for a name nothing sets), HOME is a directory, and sp-session-now is the host's
;         CLAUDE_CODE_SESSION_ID ("" when the host has none)
;   2     the day: sp-date of an instant is the civil date of its local time, by hand (the era algorithm over the instant plus the offset east of UTC
;         the host reports for that instant), for 0, a leap day, an instant at a day's last second, today and the year 2100
;   4     the times: sp-times-of reads [birth, mtime] from an identity row ([0 0] for a path that does not stat); the times of a scratch file whose
;         mtime the band sets to 1700000000123 (host_utimes) are [birth, 1700000000123] with the birth a real instant not after now
;
; The band's scratch directory is made under host_temp_dir() and removed (recursively) at the end, whatever failed.
; Expected: 31
; Verdict 31
; REQUIRES: the host doors host_getenv host_localtime host_file_identity host_utimes (seed doors; the sibling kernels carry no host doors)
; preflight-exec: forbidden
; preludes: form-stdlib/bml/session-progress.bml form-stdlib/bml/host-fs.bml
section [form.bml] {
 class SessionProgressBand {
  def spb-dir() = host_temp_dir() ++ "/session-progress-band-" ++ host_pid().str();
  def spb-say(label, v) = print([label, v]);
  // floor division and the civil date of a day count since 1970-01-01 (the era algorithm), by hand
  def spb-fdiv(a, b) = a >= 0 ? a / b : 0 - ((0 - a + b - 1) / b);
  def spb-civil(days) {
   let z = days + 719468;
   let era = spb-fdiv(z, 146097);
   let doe = z - (era * 146097);
   let yoe = (doe - (doe / 1460) + (doe / 36524) - (doe / 146096)) / 365;
   let doy = doe - ((365 * yoe) + (yoe / 4) - (yoe / 100));
   let mp = ((5 * doy) + 2) / 153;
   let dd = doy - (((153 * mp) + 2) / 5) + 1;
   let mm = mp < 10 ? mp + 3 : mp - 9;
   [yoe + (era * 400) + (mm <= 2 ? 1 : 0), mm, dd];
  }
  def spb-pad(n) = n < 10 ? "0" ++ n.str() : n.str();
  // the day `date -r secs +%Y-%m-%d` would name for a unix ms, given the offset east of UTC (seconds) the host reports for it
  def spb-day-by-hand(ms) {
   let off = host_localtime(ms)[7];
   let c = spb-civil(spb-fdiv(spb-fdiv(ms, 1000) + off, 86400));
   c[0].str() ++ "-" ++ spb-pad(c[1]) ++ "-" ++ spb-pad(c[2]);
  }
  def spb-days-ok?(xs) = nil?(xs) ? true : ((String) sp-date(xs[0]) == spb-day-by-hand(xs[0])) && spb-days-ok?(xs[1:]);
  def spb-c-env() {
   let home = host_getenv("HOME");
   let id = host_getenv("CLAUDE_CODE_SESSION_ID");
   let said = spb-say("env", [home, id, sp-session-now()]);
   (String) sp-env("HOME") == (String) trim(home) && (Comparable) host_path_is_dir(sp-env("HOME")) == 1 && (String) sp-env("SESSION_PROGRESS_BAND_SURELY_UNSET_NAME") == "" && (String) sp-session-now() == (nothing?(id) ? "" : (String) trim(id));
  }
  def spb-c-day() {
   let now = now_unix_ms();
   let xs = [0, 951782400000, 951868799000, 1791087423285, now, 4102444800000];
   let said = spb-say("day", [sp-date(0), sp-date(951782400000), sp-date(now), sp-date(4102444800000)]);
   spb-days-ok?(xs) && len(sp-date(now)) == 10 && (String) substring(sp-date(now), 4, 5) == "-" && (String) sp-date(951782400000) == spb-day-by-hand(951782400000);
  }
  def spb-c-times() {
   let dir = spb-dir();
   let made = host_dir_mkdir(dir);
   let path = dir ++ "/t";
   let w = write_file(path, "x");
   let set = host_utimes(path, 1700000000123);
   let now = now_unix_ms();
   let t = sp-times(path);
   let none = sp-times(dir ++ "/no-such-file");
   let said = spb-say("times", [t, none, sp-times-of([213, 1771990892000, 55032659, 1771990000000]), sp-times-of(nothing())]);
   let cleaned = host_dir_rmdir(dir);
   (Comparable) set == 0 && len(t) == 2 && t[1] == 1700000000123 && t[0] > 0 && t[0] <= now + 5000 && none == [0, 0] && sp-times-of([213, 1771990892000, 55032659, 1771990000000]) == [1771990000000, 1771990892000] && sp-times-of(nothing()) == [0, 0];
  }
  def spb-usage() {
   let dir = spb-dir(); let made = fs_mkdir(dir); let path = dir ++ "/codex.jsonl";
   let header = "{\"type\":\"session_meta\",\"payload\":{\"id\":\"synthetic\"}}\n";
   write_file_text(path, header);
   let old = row-cell("SessionRent", "{\"at_unix_ms\":1,\"session\":\"codex\",\"rented\":{\"requests\":0,\"input\":0,\"cache_write\":0,\"cache_read\":0,\"output\":0,\"transcripts\":1},\"local\":{\"drafts\":0,\"generated\":0},\"local_share_ppm\":0,\"bytes\":100}");
   let current = sp-cell(path, [], [], 100);
   let schema = !nothing?(old) && !nothing?(row-cell("SessionRent", row-json(current))) && row-get(current, "measurement_version") == 2 && !sp-held?(sp-held-rows([old]), "codex", 100) && sp-held?(sp-held-rows([current]), "codex", 100);
   let unknown = nothing?(sp-field(current, "rented", "output")) && nothing?(row-get(current, "local_share_ppm")) && nothing?(sp-sum([old, current], "rented", "output")) && nothing?(sp-share(100, nothing())) && sp-sum([old], "rented", "output") == 0 && str_find(sp-line("mixed", [old, current]), "null", 0) >= 0;
   let zeroLine = "{\"timestamp\":\"2026-10-28T00:00:01Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"token_count\",\"info\":{\"total_token_usage\":{\"input_tokens\":0,\"cached_input_tokens\":0,\"output_tokens\":0,\"reasoning_output_tokens\":0,\"total_tokens\":0}}}}\n";
   write_file_text(path, header ++ zeroLine);
   let zero = sp-cell(path, [], [], file_size(path));
   let run = LocalRun{at_unix_ms: 1, session: "synthetic", lane: "fixture", status: "complete", prompt_ids: 0, generated_ids: 50, model: "fixture"};
   let owned = sp-cell(path, [], [run], file_size(path));
   write_file_text(path, "{\"type\":\"session_meta\",\"payload\":{}}\n" ++ zeroLine);
   let missing = sp-cell(path, [], [run], file_size(path));
   let ownership = row-get(owned, "session") == "codex" && row-get(owned, "provider_session") == "synthetic" && sp-field(owned, "local", "run_generated") == 50 && sp-local-of(owned) == 50 && nothing?(sp-local-of(missing)) && nothing?(row-get(missing, "local_share_ppm"));
   let counts = ownership && unknown && sp-field(zero, "rented", "output") == 0 && nothing?(sp-field(zero, "rented", "requests")) && nothing?(sp-field(zero, "rented", "cache_write"));
   let gone = fs_rmdir(dir);
   [schema ? 8 : 0, counts ? 16 : 0];
  }
  def spb-run() {
   let b1 = spb-c-env() ? 1 : 0;
   let b2 = spb-c-day() ? 2 : 0;
   let b4 = spb-c-times() ? 4 : 0;
   let usage = spb-usage();
   let verdict = b1 + b2 + b4 + usage[0] + usage[1];
   let shown = print(["session-progress-band", "verdict", verdict]);
   verdict;
  }
 }
 spb-run();
}
