; living-world-recipe-tree-revision-hypothesis-band.fk -- 31 checks for a
; composition-scoped independent trial and consented successor hypothesis.
; target: 2147483647
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/living-world-recipe-tree-revision-trial.fk form-stdlib/living-world-recipe-tree-revision-hypothesis.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk

(defn lwrtrhb-bit (ok bit) (if ok bit 0))

(defn lwrtrhb-run ()
    (do
        (let result (lwrtrhw-run))
        (let composition-candidate (nth (node_children result) 1))
        (let composition (nth (node_children result) 2))
        (let recipe (nth (node_children result) 3))
        (let base-world (nth (node_children result) 4))
        (let offer (nth (node_children result) 5))
        (let one-world (nth (node_children result) 6))
        (let one-field (nth (node_children result) 7))
        (let trial-field (nth (node_children result) 9))
        (let trial-proposal (nth (node_children result) 10))
        (let trial-waiting (nth (node_children result) 11))
        (let trial-admitted (nth (node_children result) 12))
        (let trial-candidate (nth (node_children result) 13))
        (let successor-field (nth (node_children result) 14))
        (let match (nth (node_children result) 15))
        (let successor-proposal (nth (node_children result) 16))
        (let successor-waiting (nth (node_children result) 17))
        (let successor-admitted (nth (node_children result) 18))
        (let successor-candidate (nth (node_children result) 19))
        (let revoked-world (nth (node_children result) 20))
        (let revoked-trial-field (nth (node_children result) 21))
        (let revoked-successor-field (nth (node_children result) 22))
        (let composition-after-offers
            (node_value (nth (node_children result) 23)))
        (let trial-current
            (node_value (nth (node_children result) 24)))
        (let admitted-successor-current
            (node_value (nth (node_children result) 25)))
        (let revoked-trial-current
            (node_value (nth (node_children result) 26)))
        (let revoked-successor-current
            (node_value (nth (node_children result) 27)))
        (let revoked-composition-current
            (node_value (nth (node_children result) 28)))
        (let events (nth (node_children result) 29))
        (let trial (head (lwo-field-items (lwrtrt-field-viable trial-field))))
        (let trial-world (lwt-round-world trial-admitted))
        (let successor-world (lwt-round-world successor-admitted))
        (let construction-sources
            (lwrtrt-trial-construction-sources trial))
        (let trial-sources (lwrtrt-trial-sources trial))
        (let metrics (lwrtrt-trial-metrics trial))
        (sum (list
            (lwrtrhb-bit
                (and (eq (lwrtr-candidate? composition-candidate) 1)
                     (and (eq (lwo-active? base-world composition-candidate) 1)
                          (eq composition-after-offers 1))) 1)
            (lwrtrhb-bit (eq (lwrtrt-offer-valid? offer) 1) 2)
            (lwrtrhb-bit
                (node_eq (lwrtrt-offer-composition-candidate offer)
                    composition-candidate) 4)
            (lwrtrhb-bit
                (node_eq (lwrtrt-offer-recipe offer) recipe) 8)
            (lwrtrhb-bit
                (eq (lwo-field-size (lwrtrt-field-candidates one-field)) 0) 16)
            (lwrtrhb-bit
                (eq (lwo-field-size
                        (lwrth-direct-sources one-world offer)) 1) 32)
            (lwrtrhb-bit
                (eq (lwo-field-size
                        (lwrtrt-field-candidates trial-field)) 1) 64)
            (lwrtrhb-bit
                (eq (lwo-field-size (lwrtrt-field-viable trial-field)) 1) 128)
            (lwrtrhb-bit
                (eq (lwo-field-size (lwrtrt-field-divergent trial-field)) 0)
                256)
            (lwrtrhb-bit
                (eq (lwhrn-ready? (lwrtrt-field-status trial-field)) 1) 512)
            (lwrtrhb-bit (eq (lwo-field-size trial-sources) 2) 1024)
            (lwrtrhb-bit (eq (lwo-field-size construction-sources) 8) 2048)
            (lwrtrhb-bit
                (eq (lwrth-fields-disjoint?
                        construction-sources trial-sources) 1) 4096)
            (lwrtrhb-bit
                (eq (lwo-field-size (lwrtrt-trial-retained trial)) 3) 8192)
            (lwrtrhb-bit
                (node_eq (lwrtrt-trial-retained trial)
                    (lwrtr-composition-retained composition)) 16384)
            (lwrtrhb-bit
                (eq (lwo-field-size (lwrtrt-trial-prospective trial)) 5) 32768)
            (lwrtrhb-bit
                (node_eq (lwrtrt-trial-prospective trial)
                    (lwrtr-composition-placements composition)) 65536)
            (lwrtrhb-bit
                (and (eq (lwps-metrics-value metrics 1) 3)
                     (and (eq (lwps-metrics-value metrics 2) 3)
                          (eq (lwps-metrics-value metrics 4) 0))) 131072)
            (lwrtrhb-bit
                (eq (lwph-consistent? (lwrtrt-trial-state trial)) 1) 262144)
            (lwrtrhb-bit
                (not (node_eq trial-proposal (lwo-none))) 524288)
            (lwrtrhb-bit
                (eq (lwo-active? (lwt-round-world trial-waiting)
                        trial-candidate) 0) 1048576)
            (lwrtrhb-bit
                (and (eq trial-current 1)
                     (eq (lwo-active? trial-world recipe) 0)) 2097152)
            (lwrtrhb-bit
                (eq (lwo-field-size
                        (lwrtrh-field-matches successor-field)) 1) 4194304)
            (lwrtrhb-bit
                (eq (lwhrn-ready? (lwrtrh-field-status successor-field)) 1)
                8388608)
            (lwrtrhb-bit
                (and (node_eq (lwrtrh-match-composition match) composition)
                     (and (node_eq (lwrtrh-match-trial match) trial)
                          (node_eq (lwrtrh-match-recipe match) recipe)))
                16777216)
            (lwrtrhb-bit
                (and (node_eq
                        (lwrtrh-match-construction-sources match)
                        construction-sources)
                     (node_eq (lwrtrh-match-trial-sources match)
                        trial-sources)) 33554432)
            (lwrtrhb-bit
                (not (node_eq successor-proposal (lwo-none))) 67108864)
            (lwrtrhb-bit
                (and (eq (lwo-active?
                            (lwt-round-world successor-waiting)
                            successor-candidate) 0)
                     (eq (len events) 26)) 134217728)
            (lwrtrhb-bit
                (and (eq admitted-successor-current 1)
                     (eq (lwo-active? successor-world recipe) 0)) 268435456)
            (lwrtrhb-bit
                (and (eq (lwo-field-size
                            (lwrtrt-field-candidates revoked-trial-field)) 0)
                     (and (eq revoked-trial-current 0)
                          (and (eq revoked-successor-current 0)
                               (node_eq revoked-successor-field (lwo-none)))))
                536870912)
            (lwrtrhb-bit
                (and (eq revoked-composition-current 1)
                     (eq (lwo-member?
                            (lwo-field-items (lwo-world-cells revoked-world))
                            offer) 1)) 1073741824)))))

(lwrtrhb-run)
