; Third process: load the successor inertly, let the newcomer abstain from
; restore, then restore with fresh consent and verify source-scoped departure.
; Verdict 65535 proves sixteen continuity, optionality, and no-action bits.
; witnessed: 2026-08-08 -> 65535 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-action-enquiry.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk form-stdlib/tests/living-world-action-enquiry-witness.fk form-stdlib/tests/living-world-durable-action-enquiry-witness.fk form-stdlib/tests/living-world-durable-action-enquiry-succession-witness.fk

(do
    (let loaded (lwdaes-load-after))
    (let image (lwcd-result-image loaded))
    (let stored (lwcn-image-world image))
    (let stored-question (lwdaes-question-for stored))
    (let stored-evidence
        (lwae-stance-evidence-for stored stored-question))
    (let abstain (lwdaes-abstain-stance stored-question))
    (let alternative (lwdaes-alternative-stance stored-question))
    (let stored-new
        (lwdaes-evidence-for-stance stored stored-question abstain))
    (let stored-historical
        (lwdaes-evidence-without-stance stored-evidence abstain))
    (let admission (lwdaeq-admission-world image))
    (let proposal (lwcn-restore-proposal admission image))
    (let candidate (lwt-proposal-candidate proposal))
    (let abstaining
        (lwt-round-world (lwdaes-abstaining-restore-round image)))
    (let restored (lwt-round-world (lwdaeq-restored-round image)))
    (let restored-question (lwdaes-question-for restored))
    (let restored-evidence
        (lwae-stance-evidence-for restored restored-question))
    (let restored-new
        (lwdaes-evidence-for-stance
            restored restored-question abstain))
    (let pending
        (lwae-stance-evidence-stance
            (lwdaeq-evidence-pending
                (lwo-field-items restored-evidence))))
    (let timed-alternative
        (lwae-stance-evidence-stance
            (lwdaeq-evidence-timed-alternative
                (lwo-field-items restored-evidence))))
    (let expired-nothing
        (lwae-stance-evidence-stance
            (lwdaeq-evidence-expired-nothing
                (lwo-field-items restored-evidence))))
    (let stack
        (lwlc-declaration-stack (lwae-stance-declaration pending)))
    (let field
        (lwae-question-field
            (lwo-emergent-shape restored-question)))
    (let departed (lwdaes-departed-world restored))
    (let departed-evidence
        (lwae-stance-evidence-for departed restored-question))
    (let score
        (lwdaeq-sum
            (list
                (if (eq (lwcd-loaded? loaded) 1) 1 0)
                (if (eq (lwcn-image-valid? image) 1) 2 0)
                (if (and (eq (lwo-field-size
                                  (lwdaeq-questions stored)) 1)
                         (eq (lwo-field-size stored-evidence) 5)) 4 0)
                (if (and (eq (lwo-active-by? stored stored-question
                                  (lwdaes-source-j)) 1)
                         (and (not (node_eq stored-new (lwo-none)))
                              (eq (lwo-field-size
                                  (lwae-stance-evidence-attributions
                                      stored-new)) 1))) 8 0)
                (if (and (eq (lwo-field-size stored-historical) 4)
                         (and (node_eq
                                  (lwdaes-evidence-for-stance
                                      stored stored-question alternative)
                                  (lwo-none))
                              (eq (lwae-stance-immediate-nothing?
                                      abstain) 1))) 16 0)
                (if (and (eq (lwo-field-size
                                  (lwdaeq-questions admission)) 0)
                         (and (eq (lwo-field-size
                                      (lwae-stance-evidence-for
                                          admission stored-question)) 0)
                              (and (eq (lwo-field-size
                                          (lwdaeq-current-selections
                                              admission)) 0)
                                   (eq (lwo-field-size
                                          (lwdaeq-current-executions
                                              admission)) 0)))) 32 0)
                (if (and (eq (lwo-field-has?
                                  (lwt-proposal-participants proposal)
                                  (lwdaes-source-j)) 1)
                         (eq (lwcn-restored? abstaining candidate) 0)) 64 0)
                (if (eq (lwcn-restored? restored candidate) 1) 128 0)
                (if (and (node_eq restored-question stored-question)
                         (and (eq (lwo-field-size restored-evidence) 5)
                              (eq (lwae-question-steady?
                                    restored restored-question) 1))) 256 0)
                (if (and (eq (lwdaes-field-contained?
                                  stored-historical restored-evidence) 1)
                         (and (not (node_eq restored-new (lwo-none)))
                              (eq (lwo-field-size
                                  (lwae-stance-evidence-attributions
                                      restored-new)) 1))) 512 0)
                (if (and (not (node_eq pending (lwo-none)))
                         (and (not (node_eq timed-alternative (lwo-none)))
                              (not (node_eq expired-nothing
                                        (lwo-none))))) 1024 0)
                (if (and (eq (lwlc-lens?
                                  (lwlc-stack-default stack)) 1)
                         (and (eq (len (lwlc-layer-items
                                          (lwlc-stack-layers stack))) 2)
                              (and (eq (lwo-field-size
                                          (lwlc-stack-alternatives stack)) 1)
                                   (eq (lwlc-unknown?
                                          (lwlc-stack-unknown stack)) 1))))
                    2048 0)
                (if (and (eq (lwae-stance-alternative?
                                  timed-alternative) 1)
                         (and (eq (lwae-stance-expired-to-nothing?
                                      expired-nothing) 1)
                              (not (node_eq abstain
                                        expired-nothing)))) 4096 0)
                (if (and (eq (lwac-open?
                                  (lwac-field-status field)) 1)
                         (and (node_eq (lwac-field-primary field)
                                      (lwo-none))
                              (eq (lwo-field-size
                                  (lwae-eligible-for-field
                                      restored field)) 2))) 8192 0)
                (if (and (eq (lwo-field-size
                                  (lwdaeq-current-selections restored)) 0)
                         (eq (lwo-field-size
                                  (lwdaeq-current-executions restored)) 0))
                    16384 0)
                (if (and (eq (lwo-active-by? departed restored-question
                                  (lwdaes-source-j)) 0)
                         (and (eq (lwo-field-size departed-evidence) 4)
                              (and (node_eq
                                      (lwdaes-evidence-for-stance
                                          departed restored-question abstain)
                                      (lwo-none))
                                   (and (eq (lwdaes-field-contained?
                                              stored-historical
                                              departed-evidence) 1)
                                        (eq (lwae-question-steady?
                                              departed
                                              restored-question) 1)))))
                    32768 0))))
    (lwdaes-clean-after)
    score)
