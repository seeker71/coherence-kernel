; Declared transport framing never rewrites JSON content or completes fragments.
; preludes: form-stdlib/bml/form-cli-generation-json.bml
(do
 (defn fcgjb-need (ok why) (if ok 1 (form_error why)))
 (defn fcgjb-header (stopped queries)
  (str_concat "report\nstate_released=1\nheed_decode_timeout=0\nheed_injection_refusals=0\nheed_frame_refusals=0\nheed_stopped="
   (str_concat stopped (str_concat "\nheed_honor_attempts=" (str_concat queries "\ntext:\n")))))
 (let body "{\"answer\":\"Literal <STOP>, <FAIL>, and <|form:knowledge-query|> remain data.\",\"zero\":0,\"no\":false,\"absent\":null}")
 (let query (str_concat (HeedOpen) (str_concat "anchor ; path" (HeedClose))))
 (let prefix (str_concat " \n" (str_concat query (str_concat (fcgj-tag "choice") "\n"))))
 (let raw (str_concat prefix (str_concat body (str_concat "\n" (fcgj-tag "stop")))))
 (let result (fcgj-generation (str_concat (fcgjb-header "1" "1") raw) 1))
 (fcgjb-need (and (fcgj-ok result) (str_eq (fcgj-body result) body)) "framed value changed")
 (fcgjb-need (str_eq (fcgj-report result) (str_concat (fcgjb-header "1" "1") raw)) "generation metadata lost")
 (let refused-report "generation refused: model handle close mismatch")
 (let refused (fcgj-generation refused-report 1))
 (fcgjb-need (and (not (fcgj-ok refused)) (str_eq (fcgj-report refused) refused-report)) "release refusal evidence lost")
 (fcgjb-need (str_eq raw (str_concat (fcgj-prefix result) (str_concat (fcgj-body result) (fcgj-suffix result)))) "raw reconstruction differs")
 (fcgjb-need (and (fcgj-ok (fcgj-surface "0" 1 0)) (and (fcgj-ok (fcgj-surface "false" 1 0)) (fcgj-ok (fcgj-surface "null" 1 0)))) "JSON values collapsed to absence")
 (fcgjb-need (not (fcgj-ok (fcgj-generation (str_concat (fcgjb-header "0" "1") raw) 1))) "unfinished generation admitted")
 (fcgjb-need (not (fcgj-ok (fcgj-generation (str_concat (fcgjb-header "1" "1") raw) 0))) "unreleased model admitted")
 (fcgjb-need (not (fcgj-ok (fcgj-surface raw 1 0))) "unobserved query removed")
 (fcgjb-need (not (fcgj-ok (fcgj-surface body 1 1))) "missing query silently accepted")
 (fcgjb-need (not (fcgj-ok (fcgj-surface (str_concat (fcgj-tag "fail") body) 1 0))) "failure control removed")
 (fcgjb-need (not (fcgj-ok (fcgj-surface (str_concat body " trailing") 1 0))) "trailing prose removed")
 (fcgjb-need (not (fcgj-ok (fcgj-surface "{\"answer\":\"unfinished" 1 0))) "JSON fragment completed")
 (fcgjb-need (not (fcgj-ok (fcgj-surface (str_concat body body) 1 0))) "second JSON value ignored")
 (fcgjb-need (not (fcgj-ok (fcgj-generation (str_concat "report\nstate_released=0\n" (str_concat (fcgjb-header "1" "1") raw)) 1))) "duplicate metadata admitted")
 (fcgjb-need (not (fcgj-ok (fcgj-surface (str_concat (HeedOpen) body) 1 1))) "unclosed query admitted")
 (fcgjb-need (not (fcgj-ok (fcgj-surface (str_concat "```json\n" (str_concat body "\n```")) 1 0))) "unoffered Markdown repair")
 1)
