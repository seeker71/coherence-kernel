; Same-length source and output mutations must invalidate reuse; legacy files too.
; The worker must preserve a real child failure without fabricating an artifact.
; preludes: form-stdlib/native-lora-fuse.bml learn/train-loop-outcome-ack.fk
(do
 (defn nlfc-files (paths) (if (nil? paths) 1 (do (nag-write (head paths) "aaaa") (nlfc-files (tail paths)))))
 (let root (str_concat "/tmp/native-fusion-current-" (int_to_str (host_pid))))
 (let base (str_concat root "/base")) (let adapter (str_concat root "/adapter")) (let out (str_concat root "/out"))
 (fs-mkdir root) (fs-mkdir base) (fs-mkdir adapter) (fs-mkdir out)
 (nlfc-files (nfg-paths base (list "model.safetensors" "config.json" "tokenizer.json" "tokenizer_config.json")))
 (nlfc-files (nfg-paths adapter (list "adapters.safetensors" "adapter_config.json")))
 (nlfc-files (nfg-paths out (nfg-names)))
 (let legacy (not (nlfu-current base adapter out)))
 (nag-write (str_concat out "/fusion-inputs.json") (nlfu-inputs base adapter))
 (nag-write (str_concat out "/fusion-outputs.json") (nlfu-outputs out))
 (let fresh (nlfu-current base adapter out))
 (nag-write (str_concat adapter "/adapters.safetensors") "bbbb")
 (let changed (not (nlfu-current base adapter out)))
 (nag-write (str_concat adapter "/adapters.safetensors") "aaaa")
 (nag-write (str_concat out "/model.safetensors") "bbbb")
 (let corrupt (not (nlfu-current base adapter out)))
 (let failed (nlfu-worker (str_concat root "/missing") adapter (str_concat root "/failed")))
 (let real-exit (str_eq (tloa-report-value failed "exit") "1"))
 (print (list "legacy-refused" legacy "fresh" fresh "adapter-change" changed "output-change" corrupt "child-exit-one" real-exit "retained" (nth (metal_live) 2)))
 (fs-remove-tree root)
 (if (and legacy (and fresh (and changed (and corrupt (and real-exit (eq (nth (metal_live) 2) 0)))))) 63 (form_error "native fusion freshness witness failed")))
