; care-floor-tongues-band.fk — the care floor holds in every tongue the ear hears: Spanish and French hear the
; danger and answer in their own words, and the five tongues it held before still hold. 6 bits -> 63.
; This band is the first gap in learn/native-turn-queue.jsonl: the native code lane is asked to turn it green.
; preludes: form-stdlib/bml/care-floor.bml
(do
    (defn cft-bit (ok n) (if (eq ok 1) n 0))
    (defn cft-own (kind lang) (if (and (ge (str_find (cf-reply kind lang) "112" 0) 0) (not (str_eq (cf-reply kind lang) (cf-reply kind "en")))) 1 0))
    (let es (mul (cf-is "Quiero morir" "self-harm") (cf-is "Estoy pensando en el suicidio" "self-harm")))
    (let fr (mul (cf-is "Je veux mourir" "self-harm") (cf-is "Je pense au suicide" "self-harm")))
    (let es-words (mul (cft-own "self-harm" "es") (cft-own "medical" "es")))
    (let fr-words (mul (cft-own "self-harm" "fr") (cft-own "medical" "fr")))
    (let before (if (eq (cf-self-check) 255) 1 0))
    (let quiet (cf-quiet (list "mata el proceso" "ce bug me tue" "la batería murió" "j'ai tué le processus")))
    (add (cft-bit es 1) (add (cft-bit fr 2) (add (cft-bit es-words 4) (add (cft-bit fr-words 8) (add (cft-bit before 16) (cft-bit quiet 32)))))))
