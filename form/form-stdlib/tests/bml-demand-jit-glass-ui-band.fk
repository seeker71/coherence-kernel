; bml-demand-jit-glass-ui-band.fk — typed staged JIT snapshot projection.
; Verdict 1023.
; preludes: form-stdlib/bml-demand-jit.fk form-stdlib/bml/bml-demand-jit-glass.bml

(do
    (defn bdjgu-bit (ok bit) (if ok bit 0))
    (let epoch 6000)
    (let state (bdj-empty 42))
    (let stage (bdj-stage 6000 6007 "current"
        (bdj-field-present 2000) (bdj-field-present 3000)
        (bdj-field-present 4) (bdj-field-present 3)
        1 0 2 4 "disk-image"))
    (let step (bdj-step-receipt "disk-installed" "current" 7 state
        "reused-disk" 1 1 stage))
    (let first (bdj-receipt "form-ready-specialization-pending"
        "not-inspected" 22 "form" state 0))
    (let samples (bdjg-comparison-samples epoch 0 first step 231
        0 first step 231))
    (let liveSamples (bdjg-samples epoch 0 first step 231))
    (let liveRendered (bdjg-render-snapshot 6250
        (fgtm-snapshot "jit.bml-demand" epoch liveSamples)))
    (let cacheAgeSample (nth samples 3))
    (let faultStage (bdj-stage 6100 6103 "runtime-identity-unavailable"
        (bdj-field-absent "not-inspected") (bdj-field-present 3000)
        (bdj-field-absent "path-absent") (bdj-field-present 3)
        3 0 0 0 "none"))
    (let faultPending (bdj-pending "/tmp/fault-source" "/tmp/fault-cache"
        (list (list 1 7)) 0 9 42))
    (let faultState (bdj-fault-state state faultPending
        "runtime-identity-unavailable" faultStage))
    (let faultStep (bdj-step-fault-held faultState))
    (let faultSamples (bdjg-samples 6200 0 first faultStep 0))
    (let faultComparison (bdjg-comparison-samples 6200 0 first faultStep 0
        0 first step 231))
    (let faultRendered (bdjg-render-snapshot 6250
        (fgtm-snapshot "jit.bml-demand" 6200
            faultComparison)))
    (let snapshot (fgtm-snapshot "jit.bml-demand" epoch samples))
    (let rendered (bdjg-render-snapshot 6250 snapshot))
    (let absent-reading (fgtm-read-state "jit.bml-demand" "absent"
        (fgtm-absent)))
    (let absent-rendered (bdjg-render-reading 6250 absent-reading))
    (sum (list
        (bdjgu-bit (and (eq (len samples) 20)
                        (eq (fgtm-samples-valid? samples) 1)) 1)
        (bdjgu-bit (ge (str_find rendered "FORM GLASS JIT" 0) 0) 2)
        (bdjgu-bit (ge (str_find rendered "hit-current  dt=1ms" 0) 0) 4)
        (bdjgu-bit (and (ge (str_find rendered "cache-age-ms  age=2s" 0) 0)
                         (and (eq (fgtm-field-value
                                    (fgtm-sample-read-epoch cacheAgeSample))
                                  epoch)
                              (eq (fgtm-field-value
                                    (fgtm-sample-write-epoch cacheAgeSample))
                                  4000))) 8)
        (bdjgu-bit (ge (str_find rendered "disk-image  dt=<1ms" 0) 0) 16)
        (bdjgu-bit (ge (str_find rendered
            "runtime.full-program-image.call  carrier-door-absent" 0) 0) 32)
        (bdjgu-bit (ge (str_find rendered "250ms" 0) 0) 64)
        (bdjgu-bit (ge (str_find absent-rendered "snapshot=absent" 0) 0)
            128)
        (bdjgu-bit (and (eq (len faultSamples) 11)
                         (and (ge (str_find faultRendered "!! FAULT" 0) 0)
                         (and (ge (str_find faultRendered
                                      "HEALING   runtime-identity-unavailable priority=1000"
                                      0) 0)
                         (and (str_eq (fgtm-sample-kind (nth faultSamples 10))
                                  "diagnostic-control")
                         (and (eq (len faultComparison) 21)
                              (str_eq (fgtm-sample-id (nth faultComparison 20))
                                  (bdj-fault-key (bdj-state-fault faultState)))))))) 256)
        (bdjgu-bit (and (eq (len liveSamples) 10)
                         (and (ge (str_find liveRendered "live  I inspect" 0) 0)
                              (lt (str_find liveRendered "sample-absent" 0) 0))) 512))))
