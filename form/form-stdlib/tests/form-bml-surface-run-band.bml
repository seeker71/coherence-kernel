; form-bml-surface-run-band.bml — the compact forms that must run, not only lower: `let [a, _, c]`
; binds by position, and `defer` runs at block end in reverse order, on a normal exit and on a stop.
;
; Verdict 15
;
; PROOF LEVEL: FOURTH-ARM ONLY -- each claim spawns ./fkwu (host_spawn_at) and reads its stdout; the
; reference kernels hold no fkwu child to spawn. The lowering twins of the same surface stay four-way in
; form-bml-surface-band.
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml
section [form.bml] {
 class SurfaceRunBand {
  def sr-root(ctx) = ctx[1];
  def sr-fresh() {
   let root = "/tmp/form-surface-run-" ++ int_to_str(now_unix_ms());
   host_dir_mkdir(root) == 1 ? list("surface", root) : nothing();
  }
  def sr-run(ctx, id, body) {
   let base = sr-root(ctx) ++ "/" ++ int_to_str(id);
   let path = base ++ ".bml";
   write_file(path, "// preludes: form-stdlib/core.fk form-stdlib/bml/disposable.bml\nsection [form.bml] {\n" ++ body ++ "\n}\n");
   let pid = host_spawn_at(list("./fkwu", path), list("/dev/null", base ++ ".stdout", base ++ ".stderr"));
   let status = pid <= 0 ? -1 : host_wait(pid);
   list(status, read_file(base ++ ".stdout"));
  }
  def sr-prints(ctx, id, body, out) {
   let r = sr-run(ctx, id, body);
   r[0] == 0 && r[1] == out;
  }
  def sr-destructure(ctx) = sr-prints(ctx, 1, "def f() { let [a, _, c] = list(1, 2, 3); a * 10 + c; }\nf();", "13\n");
  def sr-defer-order(ctx) = sr-prints(ctx, 2, "def work() { print_str(\"a\"); defer print_str(\"z\"); defer print_str(\"y\"); print_str(\"b\"); 7; }\nwork();", "a\nb\ny\nz\n7\n");
  def sr-defer-stop(ctx) = sr-prints(ctx, 3, "def work() { defer print_str(\"closed\"); form_error(\"boom\"); print_str(\"unreached\"); 1; }\ntry work() else 5;", "closed\n5\n");
  def sr-dispose(ctx) = sr-prints(ctx, 4, "class Slot : Disposable<Int> { def dispose(h) = print_str(\"free \" ++ int_to_str(h)); }\ndef work() { defer Slot_dispose(1); defer Slot_dispose(2); print_str(\"held\"); 7; }\nwork();", "held\nfree 2\nfree 1\n7\n");
 }
 let ctx = sr-fresh();
 nothing?(ctx) ? form_error("surface run witness needs a fresh directory") : 0;
 live-claims("form-bml-surface-run-band", ctx, list(list("destructure", 1, 1, sr-destructure), list("defer-order", 2, 1, sr-defer-order), list("defer-stop", 4, 1, sr-defer-stop), list("dispose", 8, 1, sr-dispose)));
}
