; ask-lane-router-band.fk — the one ask door, proven bit by bit.
;
; Bit weights are powers of two so every reading is exact past the fifteenth digit on all four arms
; (a decimal-digit verdict rounds on the TypeScript arm, and three agreeing kernels then disagree
; with arithmetic).  Expected verdict: 2047.
;
;   1     record shapes and accessors round-trip
;   2     status and surface ranks order, and the dead statuses rank zero
;   4     needs are derived from the row's own surface and runtime
;   8     each admissibility gate closes separately and names itself
;   16    a remote lane cannot answer without off-host consent
;   32    choosing over the REAL registry: status first, then surface, then priority
;   64    the carried route: row, blob and carrier all joined
;   128   the unfinished route names the one missing member
;   256   the by-id door, and a Metal row with no bound architecture
;   512   the mirror: capability this host has that no row vouched for
;   1024  the law — every row in the registry routes to carried or unfinished, never a third word
;
; The blob and carrier fixtures are the ones witnessed on this host 2026-08-03: six GGUFs under
; ~/models across three architectures, read by model-discovery.fk out of each file's own header.
;
; WHY EVERY BIT IS A FLAT LIST AND NOT A NEST OF `and`.  The first draft nested eleven `and`s per
; bit and the paren count went wrong twice in the same file; fkwu reported `stray ')' in value
; position`, the surplus closed the whole `do` early, and thirty later `let` bindings became
; unbound-name errors far from their cause.  A shape whose correctness depends on counting twelve
; identical characters at the end of a line is a shape that will be wrong again.  `alrb-all` takes a
; list, so each claim is one line that opens and closes on itself.
;
; preludes: form-stdlib/core.fk form-stdlib/native-model-control-plane.fk form-stdlib/ask-lane-router.fk

(do
    ; every claim must hold; the first zero decides
    (defn alrb-all (xs)
        (if (eq (len xs) 0) 1
            (if (head xs) (alrb-all (tail xs)) 0)))
    (defn alrb-bit (weight claims) (if (eq (alrb-all claims) 1) weight 0))
    (defn alrb-says? (r word) (if (ge (str_find (alr-route-reason r) word 0) 0) 1 0))

    ; the walk used by bit 1024.  A band defn cannot see an enclosing let, so the whole registry
    ; rides along as an argument rather than being closed over.
    (defn alrb-two-verdicts? (all rest host binds)
        (if (eq (len rest) 0) 1
            (do
                (let row (head rest))
                (let a (alr-ask (nmcp-lane row) (nmcp-modality row) 8 0 1))
                (let r (alr-ask-door-by-id all a host binds (nmcp-id row)))
                (if (eq (alr-route? r) 1)
                    (if (eq (alr-status? (alr-route-status r)) 1)
                        (alrb-two-verdicts? all (tail rest) host binds)
                        0)
                    0))))

    (let day 20260803)
    (let registry (nmcp-registry))
    (let binds (alr-bindings))

    ; ---- what the host reported on 2026-08-03 -------------------------------------------------
    (let path-llama "/Users/ursmuff/models/form-llama-vital-ground-q4_k_m.gguf")
    (let path-ds4 "/Users/ursmuff/models/ds4/ds4flash-v5mx-reap25-type40-mxfp8lt-dspark-v1.gguf")
    (let path-kat "/Users/ursmuff/models/katcoder/kat-coder-v2.5-dev-compact.gguf")
    (let blob-llama (alr-blob path-llama "llama" 28))
    (let blob-ds4 (alr-blob path-ds4 "deepseek4" 43))
    (let blob-kat (alr-blob path-kat "qwen35moe" 41))
    (let car-llama (alr-carrier "form/native/metal/metal_ask.sh" "llama"))
    (let car-ds4 (alr-carrier "form/native/metal/ask_ds4.sh" "deepseek4"))
    (let car-kat (alr-carrier "form/native/metal/metal_kat_block0.sh" "qwen35moe"))
    (let all-blobs (list blob-llama blob-ds4 blob-kat))
    (let all-carriers (list car-llama car-ds4 car-kat))
    (let runtimes (list "ollama" "host-process" "network"))
    (let host-full (alr-host day 1 all-blobs all-carriers runtimes))
    (let host-noblob (alr-host day 1 (list blob-llama blob-kat) all-carriers runtimes))
    (let host-nocarrier (alr-host day 1 all-blobs (list car-llama car-kat) runtimes))
    (let host-nometal (alr-host day 0 all-blobs all-carriers runtimes))
    (let host-nokat (alr-host day 1 all-blobs (list car-llama car-ds4) runtimes))
    (let host-stale (alr-host 20260910 1 all-blobs all-carriers runtimes))

    ; ---- what the caller asked -----------------------------------------------------------------
    (let ask-ds4 (alr-ask "general-reasoning-code-agent" "text" 40 3 0))
    (let ask-llama (alr-ask "general-text" "text" 40 2 0))
    (let ask-llama-proven (alr-ask "general-text" "text" 40 3 0))
    (let ask-llama-remote (alr-ask "general-text" "text" 40 2 1))
    (let ask-wrong-modality (alr-ask "general-text" "audio" 40 2 0))
    (let ask-translation (alr-ask "translation" "text" 40 1 0))
    (let ask-nowhere (alr-ask "lane-that-nobody-carries" "text" 40 1 0))

    (let row-ds4 (alr-row-by-id registry "challenger.deepseek-ds4-metal"))
    (let row-llama (alr-row-by-id registry "base.llama32-3b-metal"))
    (let row-core (alr-row-by-id registry "llm.transformer-core"))
    (let row-lora (alr-row-by-id registry "llm.form-llama-lora"))
    (let row-claude (alr-row-by-id registry "oracle.claude-cli-remote"))
    (let row-i18n (alr-row-by-id registry "text.i18n-affine"))

    ; ---- 1: shapes and accessors ----------------------------------------------------------------
    (let carried (alr-ask-door registry ask-ds4 host-full binds))
    (let b1 (alrb-bit 1 (list
        (eq (alr-ask? ask-ds4) 1)
        (eq (alr-ask? (list "alr-ask" "a" "b" 1 1)) 0)
        (eq (alr-blob? blob-kat) 1)
        (eq (alr-carrier? car-kat) 1)
        (eq (alr-host? host-full) 1)
        (eq (alr-route? carried) 1)
        (eq (alr-ask-steps ask-ds4) 40)
        (eq (alr-ask-floor ask-ds4) 3)
        (eq (alr-blob-layers blob-kat) 41)
        (str_eq (alr-blob-arch blob-ds4) "deepseek4")
        (str_eq (alr-carrier-path car-ds4) "form/native/metal/ask_ds4.sh")
        (eq (alr-host-day host-full) 20260803))))

    ; ---- 2: ranks.  failing, pending and historical are not slow lanes; they are silent ones. ----
    (let b2 (alrb-bit 2 (list
        (eq (alr-status-rank "proven") 3)
        (eq (alr-status-rank "observed") 2)
        (eq (alr-status-rank "partial") 1)
        (eq (alr-status-rank "trained-unpromoted") 1)
        (eq (alr-status-rank "failing") 0)
        (eq (alr-status-rank "pending") 0)
        (eq (alr-status-rank "historical") 0)
        (eq (alr-surface-rank "native-recipe") 3)
        (eq (alr-surface-rank "local-process") 2)
        (eq (alr-surface-rank "remote-membrane") 1)
        (eq (alr-surface-rank "no-such-surface") 0)
        (eq (alr-has-metal? "fkwu+Metal") 1)
        (eq (alr-has-metal? "fkwu") 0))))

    ; ---- 4: needs read off the row, not attached to it -------------------------------------------
    (let needs-ds4 (alr-needs row-ds4))
    (let needs-core (alr-needs row-core))
    (let needs-lora (alr-needs row-lora))
    (let needs-claude (alr-needs row-claude))
    (let b3 (alrb-bit 4 (list
        (eq (len needs-ds4) 4)
        (eq (alr-name-in? "metal-device" needs-ds4) 1)
        (eq (alr-name-in? "model-blob" needs-ds4) 1)
        (eq (alr-name-in? "carrier" needs-ds4) 1)
        (eq (len needs-core) 2)
        (eq (alr-name-in? "recipe-cell" needs-core) 1)
        (eq (alr-name-in? "model-blob" needs-core) 0)
        (eq (alr-name-in? "host-process" needs-lora) 1)
        (eq (alr-name-in? "ollama+mlx" needs-lora) 1)
        (eq (alr-name-in? "off-host-consent" needs-claude) 1)
        (eq (alr-name-in? "call-ledger" needs-claude) 1))))

    ; ---- 8: one gate at a time, and the refusal says which ---------------------------------------
    (let b4 (alrb-bit 8 (list
        (eq (alr-admissible? row-ds4 ask-ds4 host-full) 1)
        (str_eq (alr-closed-gate row-ds4 ask-ds4 host-full) "none")
        (eq (alr-admissible? row-ds4 ask-ds4 host-stale) 0)
        (str_eq (alr-closed-gate row-ds4 ask-ds4 host-stale) "witness-stale")
        (eq (alr-admissible? row-llama ask-llama-proven host-full) 0)
        (str_eq (alr-closed-gate row-llama ask-llama-proven host-full) "status-below-floor")
        (eq (alr-admissible? row-llama ask-wrong-modality host-full) 0)
        (str_eq (alr-closed-gate row-llama ask-wrong-modality host-full) "lane-or-modality")
        (eq (alr-admissible? row-i18n ask-translation host-full) 0)
        (str_eq (alr-closed-gate row-i18n ask-translation host-full) "row-not-active"))))

    ; ---- 16: consent is the caller's to give, and nothing else can stand in for it ----------------
    (let remote-fresh (nmcp-model "fixture.remote-fresh" "general-text" "text" "remote-oracle"
        "teacher" "observed" "remote-membrane" "agent-cli" "fixture-remote" "none" "none"
        "fixture-probe" "audited-teacher-value" 0 0 0 50 "fixture" 20260803 7 0 0 1 0))
    (let b5 (alrb-bit 16 (list
        (eq (alr-admissible? remote-fresh ask-llama host-full) 0)
        (str_eq (alr-closed-gate remote-fresh ask-llama host-full) "off-host-consent")
        (eq (alr-admissible? remote-fresh ask-llama-remote host-full) 1)
        (str_eq (alr-closed-gate remote-fresh ask-llama-remote host-full) "none"))))

    ; ---- 32: choosing, over the registry the body actually carries --------------------------------
    ; Two fixtures share the champion's lane so the ordering is proven and not merely observed: one
    ; at equal status with equal priority (surface must decide), one proven but far from the metal
    ; and at priority 10 (status must decide anyway).
    (let fx-lp-observed (nmcp-model "fixture.lp-observed" "general-text" "text" "local-native"
        "shadow" "observed" "local-process" "ollama" "fixture-a" "none" "none" "fx" "m"
        0 0 0 100 "fixture" 20260803 30 0 0 1 0))
    (let fx-lp-proven (nmcp-model "fixture.lp-proven" "general-text" "text" "local-native"
        "shadow" "proven" "local-process" "ollama" "fixture-b" "none" "none" "fx" "m"
        0 0 0 10 "fixture" 20260803 30 0 0 1 0))
    (let b6 (alrb-bit 32 (list
        (str_eq (nmcp-id (alr-choose registry ask-ds4 host-full)) "challenger.deepseek-ds4-metal")
        (str_eq (nmcp-id (alr-choose registry ask-llama host-full)) "base.llama32-3b-metal")
        (str_eq (nmcp-id (alr-choose registry ask-nowhere host-full)) "none")
        (str_eq (nmcp-id (alr-choose (list fx-lp-observed row-llama) ask-llama host-full))
                "base.llama32-3b-metal")
        (str_eq (nmcp-id (alr-choose (list row-llama fx-lp-proven) ask-llama host-full))
                "fixture.lp-proven")
        (str_eq (nmcp-id (alr-choose registry ask-ds4 host-stale)) "none"))))

    ; ---- 64: the carried route --------------------------------------------------------------------
    (let b7 (alrb-bit 64 (list
        (eq (alr-carried? carried) 1)
        (str_eq (alr-route-status carried) "carried")
        (eq (alr-status? (alr-route-status carried)) 1)
        (str_eq (alr-route-id carried) "challenger.deepseek-ds4-metal")
        (str_eq (alr-route-arch carried) "deepseek4")
        (str_eq (alr-route-carrier carried) "form/native/metal/ask_ds4.sh")
        (str_eq (alr-route-blob carried) path-ds4)
        (eq (len (alr-route-needs carried)) 4)
        (eq (alrb-says? carried "joined") 1))))

    ; ---- 128: unfinished, with the one missing member named ----------------------------------------
    ; The needs are ordered metal, blob, carrier, so each host isolates exactly one of them.
    (let no-metal (alr-ask-door registry ask-ds4 host-nometal binds))
    (let no-blob (alr-ask-door registry ask-ds4 host-noblob binds))
    (let no-carrier (alr-ask-door registry ask-ds4 host-nocarrier binds))
    (let no-lane (alr-ask-door registry ask-nowhere host-full binds))
    (let b8 (alrb-bit 128 (list
        (eq (alr-carried? no-metal) 0)
        (eq (alrb-says? no-metal "metal-device") 1)
        (eq (alrb-says? no-blob "model-blob") 1)
        (eq (alrb-says? no-carrier "carrier") 1)
        (eq (alrb-says? no-lane "lane-that-nobody-carries") 1)
        (eq (alr-status? (alr-route-status no-metal)) 1)
        (eq (alr-status? (alr-route-status no-blob)) 1)
        (eq (alr-status? (alr-route-status no-carrier)) 1)
        (eq (alr-status? (alr-route-status no-lane)) 1)
        (str_eq (alr-route-status no-blob) "unfinished")
        (eq (alr-carried? no-lane) 0))))

    ; ---- 256: naming a model directly, and a lane whose architecture nobody witnessed --------------
    (let fx-unbound (nmcp-model "fixture.unbound-metal" "general-text" "text" "local-native"
        "champion" "observed" "native-recipe" "fkwu+Metal" "fixture-c" "none" "none" "fx" "m"
        0 0 0 90 "bind an architecture to this row" 20260803 30 0 0 1 0))
    (let by-id (alr-ask-door-by-id registry ask-ds4 host-full binds "challenger.deepseek-ds4-metal"))
    (let no-such (alr-ask-door-by-id registry ask-ds4 host-full binds "model.that.is.not.here"))
    (let unbound (alr-ask-door-by-id (list fx-unbound) ask-llama host-full binds
                                     "fixture.unbound-metal"))
    (let b9 (alrb-bit 256 (list
        (eq (alr-carried? by-id) 1)
        (str_eq (alr-route-carrier by-id) "form/native/metal/ask_ds4.sh")
        (eq (alr-carried? no-such) 0)
        (eq (alrb-says? no-such "no row with id") 1)
        (eq (alr-carried? unbound) 0)
        (eq (alrb-says? unbound "no architecture is bound") 1)
        (str_eq (alr-route-arch unbound) ""))))

    ; ---- 512: the mirror.  qwen35moe runs on this host and no row has ever said so. ----------------
    (let unvouched (alr-unvouched host-full binds registry))
    (let b10 (alrb-bit 512 (list
        (eq (len unvouched) 1)
        (eq (alr-name-in? "qwen35moe" unvouched) 1)
        (eq (alr-name-in? "deepseek4" unvouched) 0)
        (eq (alr-name-in? "llama" unvouched) 0)
        (eq (len (alr-unvouched host-nokat binds registry)) 0))))

    ; ---- 1024: the law.  There is no third verdict, for any row in the registry. -------------------
    (let b11 (alrb-bit 1024 (list
        (eq (alrb-two-verdicts? registry registry host-full binds) 1)
        (eq (alrb-two-verdicts? registry registry host-nometal binds) 1)
        (eq (alr-status? "unsupported") 0)
        (eq (alr-status? "limit") 0)
        (eq (alr-status? "carried") 1)
        (eq (alr-status? "unfinished") 1))))

    (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7
        (add b8 (add b9 (add b10 b11)))))))))))
