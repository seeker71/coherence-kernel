; preludes: form-stdlib/bml/form-agent-tools.bml
;
; form-agent-arity-band — the coding lane's arity tool reads a Form source against the argument counts fkwu's reader
; demands (form-stdlib/fkwu-op-arity.fk), in the lane's own session, before any band runs.
;
; Verdict 127 when every claim lands:
;   1   a whole source reads ""
;   2   the night's miss: (and (eq b 1)) reads "line 1: (and ...) takes 2, given 1"
;   4   a host door with too few arguments: (http_get url) takes 3, given 1
;   8   a defn's parameters named like ops are names, not calls: nothing is read
;   16  strings and ; comments are read as themselves: a call inside them is not a call
;   32  the line counts from the top: a miss on the third line says line 3
;   64  a document that is not a Form source is declined: arity-reads-fk-sources
(do
    (defn fab-bit (ok v) (if ok v 0))
    (defn fab-docs ()
        (list
            (list "source:whole" "whole.fk" "(defn f (x) (add x 1))\n(f 2)\n")
            (list "source:night" "night.fk" "(defn g (b) (if (and (eq b 1)) 1 0))\n")
            (list "source:door" "door.fk" "(defn h (url) (http_get url))\n")
            (list "source:names" "names.fk" "(defn k (len head) (add len head))\n")
            (list "source:quiet" "quiet.fk" "; (and x) in a comment\n(print_str \"(and x) in a string\")\n")
            (list "source:third" "third.fk" "(defn a (x)\n    (do\n        (add x)))\n")
            (list "config:bml" "c.bml" "def x() = 1;\n")))
    (defn fab-out (path) (fat-out (fat-call (fab-docs) "arity" (list path) "")))
    (defn fab-err (path) (fat-error (fat-call (fab-docs) "arity" (list path) "")))
    (let b1 (str_eq (fab-out "whole.fk") ""))
    (let b2 (str_eq (fab-out "night.fk") "line 1: (and ...) takes 2, given 1\n"))
    (let b3 (str_eq (fab-out "door.fk") "line 1: (http_get ...) takes 3, given 1\n"))
    (let b4 (str_eq (fab-out "names.fk") ""))
    (let b5 (str_eq (fab-out "quiet.fk") ""))
    (let b6 (str_eq (fab-out "third.fk") "line 3: (add ...) takes 2, given 1\n"))
    (let b7 (str_eq (fab-err "c.bml") "arity-reads-fk-sources"))
    (add (fab-bit b1 1) (add (fab-bit b2 2) (add (fab-bit b3 4) (add (fab-bit b4 8) (add (fab-bit b5 16) (add (fab-bit b6 32) (fab-bit b7 64))))))))
