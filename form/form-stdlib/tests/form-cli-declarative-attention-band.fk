; Verdict 31: refusal accounting, admission, and budget boundaries.
; preludes: form-stdlib/form-cli-declarative-attention.bml
(do
    (let cfg (da-config 2 10 12 (list (list 1 2 10))))
    (let state (da-initial cfg))
    (let refused (qdag-forwarded (empty) (empty) cfg (empty) (empty)
        state -1 12 3 (empty) 1 (list 123) 9 17 1))
    (sum (list
        (if (str_eq (nth refused 0) "forward-refused") 1 0)
        (if (and (eq (nth refused 3) 12) (eq (nth refused 6) 1)) 2 0)
        (if (and (eq (nth refused 4) 9) (eq (nth refused 5) 17)) 4 0)
        (if (str_eq (head (qdag-generate (empty) (empty) (nothing) (empty) 2 (empty) 1)) "config-refused") 8 0)
        (if (str_eq (head (qdag-generate (empty) (empty) cfg (list 1) 2 (empty) 1)) "prompt-coordinates-refused") 16 0))))
