; living-world-tissue-response-band.fk -- silence, counter-offer, and timeout
; retain different histories while every option remains optional.
; Verdict 32767 proves fifteen response, consent, and open-field claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk form-stdlib/living-world-contextual-species.fk form-stdlib/living-world-tissue-prediction.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk form-stdlib/tests/living-world-behavioral-species-witness.fk form-stdlib/tests/living-world-contextual-species-witness.fk form-stdlib/tests/living-world-tissue-prediction-witness.fk

(defn lwtpr-nothing-now (prediction)
    (lwtp-observation (lwtpw-prediction-candidate prediction)
        (lwo-none) (oac-nothing) (lwo-empty-field)
        (lwlc-unknown (lwtpw-unknown-a)) (intern_trivial_int 6)
        (lwtpw-evidence-a)))
(defn lwtpr-alternative (prediction)
    (lwtp-observation (lwtpw-prediction-candidate prediction)
        (intern_trivial_int 3)
        (oac-alternative-ack (intern_trivial_int 4)
            (intern_trivial_int 3) (lwtpw-evidence-b))
        (lwo-field (list (intern_trivial_int 3))) (lwo-none)
        (intern_trivial_int 6) (lwtpw-evidence-b)))
(defn lwtpr-late-confirmation (prediction)
    (lwtp-observation (lwtpw-prediction-candidate prediction)
        (intern_trivial_int 4) (oac-one (intern_trivial_int 4))
        (lwo-empty-field) (lwo-none) (intern_trivial_int 10)
        (lwtpw-evidence-a)))
(defn lwtpr-inside-outside-world (prediction observation)
    (lwt-receive-stream
        (lwt-round-world (lwtpw-prediction-round prediction))
        (list (lwtpw-entry-t observation) (lwtpw-entry-v observation))))

(do
    (let base (lwtpw-build-base))
    (let initial (lwtpw-initial-a base))
    (let world (lwt-round-world (lwtpw-prediction-round initial)))
    (let tissue (lwtpw-base-tissue base))
    (let target (lwtpw-prediction-target initial))
    (let now (lwtpr-nothing-now initial))
    (let now-experience (lwtpw-integrate-experience initial now))
    (let now-shape
        (lwo-emergent-shape
            (lwtpw-experience-candidate now-experience)))
    (let after-now (lwtpw-next-a base initial now-experience))
    (let after-now-shape (lwtpw-prediction-shape after-now))
    (let alternative (lwtpr-alternative initial))
    (let alternative-experience
        (lwtpw-integrate-experience initial alternative))
    (let alternative-shape
        (lwo-emergent-shape
            (lwtpw-experience-candidate alternative-experience)))
    (let after-alternative
        (lwtpw-next-a base initial alternative-experience))
    (let after-alternative-shape
        (lwtpw-prediction-shape after-alternative))
    (let late (lwtpr-late-confirmation initial))
    (let late-world (lwtpw-observation-world initial late))
    (let inside-world (lwtpr-inside-outside-world initial alternative))
    (let no-default
        (oac-timeout (intern_trivial_int 10) (oac-no-default)
            (lwtpw-evidence-b)))
    (let no-default-outcome
        (oac-timeout-condense no-default (intern_trivial_int 10)))
    (let default-outcome
        (lwtp-target-time-for target (intern_trivial_int 10)))

    (let c1
        (if (and (eq (lwtp-observation-valid? now) 1)
                 (and (eq (oac-nothing?
                              (lwtp-observation-ack now)) 1)
                      (node_eq (lwtp-observation-observed now) (lwo-none))))
            1 0))
    (let c2
        (if (and (eq (lwtp-wait?
                         (lwtp-experience-state now-shape)) 1)
                 (node_eq (lwtp-experience-observed now-shape) (lwo-none)))
            2 0))
    (let c3
        (if (and (eq (lwo-field-size
                         (lwtp-prediction-experiences after-now-shape)) 1)
                 (and (eq (lwo-field-size
                              (lwtp-prediction-experience-outputs
                                after-now-shape)) 0)
                      (and (eq (lwtp-consensus?
                                  (lwtp-prediction-status after-now-shape)) 1)
                           (node_eq
                              (lwtp-prediction-predicted after-now-shape)
                              (intern_trivial_int 4))))) 4 0))
    (let c4
        (if (and (eq (lwtp-observation-valid? alternative) 1)
                 (and (eq (oac-alternative-ack?
                              (lwtp-observation-ack alternative)) 1)
                      (node_eq
                        (oac-alternative-offered
                          (oac-payload
                            (lwtp-observation-ack alternative)))
                        (intern_trivial_int 3)))) 8 0))
    (let c5
        (if (and (eq (lwtp-diverge?
                         (lwtp-experience-state alternative-shape)) 1)
                 (and (eq (lwtp-branch?
                              (lwtp-prediction-status
                                after-alternative-shape)) 1)
                      (eq (lwo-field-size
                              (lwtp-prediction-combined-outputs
                                after-alternative-shape)) 2))) 16 0))
    (let c6
        (if (node_eq alternative (lwtpr-alternative initial)) 32 0))
    (let c7
        (if (and (eq (lwtp-observation-valid? late) 0)
                 (node_eq
                    (lwtp-experience-proposal late-world late 2)
                    (lwo-none))) 64 0))
    (let c8
        (if (and (eq (oac-time-pending?
                         (lwtp-target-time-for target
                           (intern_trivial_int 6))) 1)
                 (eq (oac-time-outcome? default-outcome) 1)) 128 0))
    (let c9
        (if (and (eq (oac-alternative-ack?
                         (oac-time-outcome-ack default-outcome)) 1)
                 (not (node_eq
                        (oac-time-outcome-ack default-outcome)
                        (lwtp-observation-ack now)))) 256 0))
    (let c10
        (if (and (eq (oac-time-outcome? no-default-outcome) 1)
                 (and (eq (oac-nothing?
                              (oac-time-outcome-ack no-default-outcome)) 1)
                      (not (node_eq no-default-outcome (oac-nothing)))))
            512 0))
    (let c11
        (if (and (eq (lwo-field-size
                         (lwtp-observation-independent-sources
                           inside-world alternative)) 1)
                 (node_eq
                    (lwtp-experience-proposal inside-world alternative 2)
                    (lwo-none))) 1024 0))
    (let c12
        (if (and (eq (lwo-field-size
                         (lwtp-observation-independent-sources
                           (lwtpw-observation-world initial alternative)
                           alternative)) 2)
                 (not (node_eq
                    (lwtp-experience-proposal
                        (lwtpw-observation-world initial alternative)
                        alternative 2)
                    (lwo-none)))) 2048 0))
    (let c13
        (if (and (node_eq
                    (lwtp-prediction-proposal world tissue target 3
                        (intern_trivial_int 5))
                    (lwo-none))
                 (node_eq
                    (lwtp-prediction-proposal world tissue target 0
                        (intern_trivial_int 5))
                    (lwo-none))) 4096 0))
    (let c14
        (if (and (eq (lwo-field-has?
                         (lwtp-experience-unknowns now-shape)
                         (lwlc-unknown (lwtpw-unknown-a))) 1)
                 (eq (lwo-field-has?
                         (lwtp-prediction-alternatives after-now-shape)
                         (lwtpw-option-b)) 1)) 8192 0))
    (let c15
        (if (and (eq (lwtp-target-current? world target) 1)
                 (and (eq (lwo-field-size
                              (lwtp-target-sources world target)) 2)
                      (not (node_eq
                        (lwtpw-prediction-candidate initial)
                        (lwtpw-prediction-candidate after-now))))) 16384 0))
    (lwtnw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
