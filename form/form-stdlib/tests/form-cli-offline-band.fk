; preludes: form-stdlib/core.fk form-stdlib/form-cli-offline.fk
;
; form-cli-offline-band — the offline law of the form-cli loop, witnessed on
; the TREE'S OWN CELL (form-cli-offline.fk rides this prelude chain) over core
; alone. The 2026-08-14 receipt first witnessed these four claims at 480
; exit 0, but over a /tmp cell that PASTED the fcl definitions — a copy that
; would keep passing if the tree's cell drifted. This band retires that copy:
; same bits, same expected 480, but the definitions under witness are the ones
; the loop actually composes.
;
; Verdict 2016 when the offline law and the share stamp hold:
;   32  offline, low confidence is nothing — not Starlink
;   64  edit / commit / review / crystallize stay local with no network
;   128 push with no network is nothing
;   256 push with a network is local host git, not a rented mind
;   512 a share of 100 parts is well-formed
;   1024 this turn's three parts are declared, not counted
;
; witnessed: 2026-08-14 -> 2016; 1024 now names declared-kind, not a lock on typed 50/20/30.
(do
    ; 32 — no network: a miss is silence, not a remote call.
    (let c5
        (if (and (str_eq (fcl-route-net 40 70 0) "nothing")
                 (str_eq (fcl-route-net 40 70 1) "oracle"))
            32 0))
    ; 64 — this prompt's local work does not wait on the satellite.
    (let c6
        (if (and (str_eq (fcl-step-lane (fcl-step-edit) 0) "local")
            (and (str_eq (fcl-step-lane (fcl-step-commit) 0) "local")
            (and (str_eq (fcl-step-lane (fcl-step-review) 0) "local")
                 (str_eq (fcl-step-lane (fcl-step-crystallize) 0) "local"))))
            64 0))
    ; 128 / 256 — push is host git: silence offline, local when the net is up.
    (let c7 (if (str_eq (fcl-step-lane (fcl-step-push) 0) "nothing") 128 0))
    (let c8 (if (str_eq (fcl-step-lane (fcl-step-push) 1) "local") 256 0))
    (let c9 (if (eq (fcl-share-ok? (fcl-this-turn)) 1) 512 0))
    (let c10
        (if (eq (fcl-this-kind) (fcl-share-kind-declared)) 1024 0))
    (add c5 (add c6 (add c7 (add c8 (add c9 c10))))))
