; form-knowledge-bml-temporal-witness-freeze-band.fk -- the new semantic
; family is byte-sealed, current, executable and gradient-denied before any
; prompt or model candidate exists.
;
; Expected: 32767 (15 bits)
;
; preludes: form-stdlib/core.fk form-stdlib/sha256.fk
; preludes: form-stdlib/native-model-evidence.fk
; preludes: form-stdlib/input-stream-lifecycle.fk form-stdlib/obs-verify.fk
; preludes: form-stdlib/form-knowledge-bml-temporal-witness-freeze.fk

(do
    (defn fktwfb-bit (ok bit) (if ok bit 0))
    (defn fktwfb-member? (needle values)
        (if (nil? values) 0
            (if (str_eq needle (head values)) 1
                (fktwfb-member? needle (tail values)))))
    (defn fktwfb-signal (args)
        (if (eq (nth args 0) 0) (nothing)
            (isl-signal 71 1 (nth args 1) (nothing) (nothing)
                (nth args 2))))
    (defn fktwfb-eval (row)
        (do
            (let args (fktwf-case-args row))
            (if (str_eq (fktwf-case-family row) "verify")
                (obs-state-code (obs-verify
                    (ov-reading (nth args 0) (nth args 1) (nth args 2))
                    (nth args 3)))
                (isl-transition (isl-live) (fktwfb-signal args)
                    (nth args 3) (nth args 4)))))
    (defn fktwfb-all-exact? (rows)
        (if (nil? rows) 1
            (if (eq (fktwfb-eval (head rows))
                    (fktwf-case-expected (head rows)))
                (fktwfb-all-exact? (tail rows)) 0)))
    (defn fktwfb-axis-in? (axis rows)
        (if (nil? rows) 0
            (if (str_eq axis (fktwf-case-axis (head rows))) 1
                (fktwfb-axis-in? axis (tail rows)))))
    (defn fktwfb-no-source-in-corpus? (path)
        (and (lt (str_find
                    (read_file "model/fixtures/form-bml-exec-finetune/train.jsonl")
                    path 0) 0)
             (and (lt (str_find
                    (read_file "model/fixtures/form-bml-exec-finetune/valid.jsonl")
                    path 0) 0)
                  (lt (str_find
                    (read_file "model/fixtures/form-bml-exec-finetune/test.jsonl")
                    path 0) 0))))
    (defn fktwfb-run ()
        (do
            (let rows (fktwf-cases))
            (let bans (fktwf-leakage-bans))
            (sum (list
                (fktwfb-bit (and (str_eq (fktwf-schema)
                    "form-bml-temporal-witness-freeze-v1")
                    (str_eq (fktwf-split)
                        "heldout-frozen-before-transform")) 1)
                (fktwfb-bit (str_eq (fktwf-source-group-id)
                    (fktwf-sealed-source-group-id)) 2)
                (fktwfb-bit (eq (fktwf-sources-current?) 1) 4)
                (fktwfb-bit (and (eq (len (fktwf-source-paths)) 2)
                    (eq (len (fktwf-source-provenance)) 2)) 8)
                (fktwfb-bit (eq (len rows) 10) 16)
                (fktwfb-bit (fktwfb-all-exact? rows) 32)
                (fktwfb-bit (and (eq (fktwfb-eval (nth rows 4)) 0)
                    (eq (fktwfb-eval (nth rows 5)) 4)) 64)
                (fktwfb-bit (and (eq (fktwfb-eval (nth rows 5)) 4)
                    (eq (fktwfb-eval (nth rows 6)) 5)) 128)
                (fktwfb-bit (and (eq (fktwfb-eval (nth rows 0)) 1)
                    (and (eq (fktwfb-eval (nth rows 1)) 0)
                         (eq (fktwfb-eval (nth rows 2)) -1))) 256)
                (fktwfb-bit (and (fktwfb-axis-in? "inclusive-deadline" rows)
                    (and (fktwfb-axis-in? "acknowledgement" rows)
                         (fktwfb-axis-in? "signal-kind" rows))) 512)
                (fktwfb-bit (and (eq (fktwf-gradient-allowed?) 0)
                    (and (eq (fktwf-rag-allowed-for-heldout?) 0)
                         (eq (fktwf-shared-grammar-novel?) 0))) 1024)
                (fktwfb-bit (and (eq (fktwf-prompt-derived?) 0)
                    (and (eq (fktwf-candidate-observed?) 0)
                         (eq (fktwf-model-opened?) 0))) 2048)
                (fktwfb-bit (and (fktwfb-member? "59cb1b298ad94c111b19943580a4155bb332efec3b3d85a7b132f1a2e8866b70" bans)
                    (and (fktwfb-member? "00786c0f827f90a967a33f59cfcd3bb010f6af2c4ad63ed7528cc5b6b93017d4" bans)
                         (fktwfb-member? "aa5d3b417a381fff35c8b22832c700690a759cb64148593a8470e09a6b780a02" bans))) 4096)
                (fktwfb-bit (and (fktwfb-no-source-in-corpus?
                        (nth (fktwf-source-paths) 0))
                    (fktwfb-no-source-in-corpus?
                        (nth (fktwf-source-paths) 1))) 8192)
                (fktwfb-bit (and (not (str_eq
                        (nth (fktwf-source-shas) 0)
                        (nth (fktwf-source-shas) 1)))
                    (eq (fktwf-frozen-at) 20260826)) 16384)))))
    (fktwfb-run))
