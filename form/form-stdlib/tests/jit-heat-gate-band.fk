; jit-heat-gate-band.fk — crystallize-on-heat closed over the live door:
; cold walks, hot births once, cooled melts, rebirth on reheat, unlowerable
; heat surfaced never acted, ties kept as choice.
;
; Verdict 4095 (12 bits):
;   1     calls 1..4 answer route "form", born 0 — cold work walks
;   2     call 5 crosses jd-crystallize? and births native, born 1
;   4     call 6 answers native, born 0 — once-born under the gate
;   8     every answer along the way is RIGHT (22 at n=5 throughout)
;   16    a second shape heats independently and births at ITS fifth call
;   32    an unlowerable program (cond tag 6) at heat 7 stays route "form",
;         zero births — hot-and-impure never crystallizes
;   64    hg-hottest reports it flagged low=0 — wasted heat is a visible row
;   128   ties: two identities at one maximum both return
;   256   hg-cool halves heat and MELTS the cooled entry — dissolved counted,
;         registry size drops
;   512   after melt, the next crossing REbirths (born 1 again) — hysteresis
;   1024  a hot entry (fires 12 -> 6) SURVIVES the same cool that melts a
;         cold one — jd-melt? decides per identity, not globally
;   2048  route provenance never lies: form answers equal native answers on
;         the same shape and argument
;
; preludes: form-stdlib/jit-heat-gate.fk

(do
    (defn hgb-bit (ok bit) (if ok bit 0))
    (defn hgb-p1 () (list (list 1 7) (list 2) (list 1 3) (list 5 1 2) (list 3 3 0)))
    (defn hgb-p2 () (list (list 1 1) (list 2) (list 5 1 1) (list 3 2 0)))
    (defn hgb-bad () (list (list 1 1) (list 2) (list 6 0 1 1)))

    ; run n requests of one shape, return (list last-value last-route gate borns)
    (defn hgb-run (g prog root arg n v route borns)
        (if (eq n 0) (list v route g borns)
            (do (let r (hg-request g prog root arg))
                (hgb-run (nth r 2) prog root arg (sub n 1)
                    (nth r 0) (nth r 1) (add borns (nth r 3))))))

    (defn jit-heat-gate-band ()
        (do
            (let g0 (hg-gate 1111))
            (let a4 (hgb-run g0 (hgb-p1) 4 5 4 0 "" 0))
            (let a5 (hg-request (nth a4 2) (hgb-p1) 4 5))
            (let a6 (hg-request (nth a5 2) (hgb-p1) 4 5))
            (let b5 (hgb-run (nth a6 2) (hgb-p2) 3 6 5 0 "" 0))
            (let u7 (hgb-run (nth b5 2) (hgb-bad) 2 9 7 0 "" 0))
            (let gHot (nth u7 2))
            ; heat p1 up to 12 fires so it survives one halving
            (let more (hgb-run gHot (hgb-p1) 4 5 6 0 "" 0))
            (let gMore (nth more 2))
            ; one halving: p2 5->2 SURVIVES jd-melt? (lt 2 2 = 0); the second
            ; halving 2->1 melts it while p1 12->6->3 stays — hysteresis is
            ; a slope, and the fixture walks both sides of it
            (let cooled1 (hg-cool gMore))
            (let cooled (hg-cool (nth cooled1 0)))
            (let gC (nth cooled 0))
            (let melted (nth cooled 1))
            (let re5 (hgb-run gC (hgb-p2) 3 6 5 0 "" 0))

            (sum (list
                (hgb-bit (and (str_eq (nth a4 1) "form")
                         (and (eq (nth a4 3) 0) (eq (nth a4 0) 22))) 1)
                (hgb-bit (and (str_eq (nth a5 1) "native") (eq (nth a5 3) 1)) 2)
                (hgb-bit (and (str_eq (nth a6 1) "native") (eq (nth a6 3) 0)) 4)
                (hgb-bit (and (eq (nth a5 0) 22) (eq (nth a6 0) 22)) 8)
                (hgb-bit (and (eq (nth b5 3) 1) (eq (nth b5 0) 37)) 16)
                (hgb-bit (and (str_eq (nth u7 1) "form") (eq (nth u7 3) 0)) 32)
                (hgb-bit (hgb-flagged? (hg-hottest gHot)) 64)
                (hgb-bit (hgb-tie-check (hg-gate 1111)) 128)
                (hgb-bit (and (gt melted 0)
                              (lt (jonb-size (hg-reg gC)) (jonb-size (hg-reg (nth cooled1 0))))) 256)
                (hgb-bit (eq (nth re5 3) 1) 512)
                (hgb-bit (eq (hgb-survives? gMore) 1) 1024)
                (hgb-bit (eq (jonb-eval (hgb-p1) 4 5)
                             (nth (hg-request (nth a6 2) (hgb-p1) 4 5) 0)) 2048)))))

    ; hottest carries the unlowerable at 7 fires with low flag 0
    (defn hgb-flagged? (rows)
        (if (eq (len rows) 0) 0
            (if (and (eq (nth (head rows) 1) 7) (eq (nth (head rows) 2) 0)) 1
                (hgb-flagged? (tail rows)))))

    ; two shapes, three fires each: both rows return at the max
    (defn hgb-tie-check (g)
        (do (let g1 (nth (hgb-run g (hgb-p1) 4 5 3 0 "" 0) 2))
            (let g2 (nth (hgb-run g1 (hgb-p2) 3 6 3 0 "" 0) 2))
            (if (eq (len (hg-hottest g2)) 2) 1 0)))

    ; p1 at 12 fires halves twice to 3 — jd-melt? says stay; survives BOTH
    (defn hgb-survives? (g)
        (do (let c (hg-cool (nth (hg-cool g) 0)))
            (let id1 (jonb-identity (hgb-p1) 4 1111))
            (if (nothing? (jonb-find (jonb-entries (hg-reg (nth c 0))) id1)) 0 1)))

    (jit-heat-gate-band))
