; loop-lane-list-door-band.fk — a list crosses into the loop lane: head, tail, len, nil?, and a word taken for its kind.
;
; The eighth rung of Urs's 2026-09-12 goal. A list is a word: the empty list 1, or an odd positive word whose pair
; index is under the heap's top -- every other tagged word is negative -- so the door admits a list parameter as its
; raw word, and head and tail are one load each from the pair arrays, their base read when the leaf runs (the heap grows
; in place, and a leaf never conses, so no melt moves a pair under it). A head is a word of unknown kind: beside a number
; it is taken for an int, beside a list for a list, and a word not of that kind leaves for the overflow block, where the
; walker answers -- typefall. len of a list walks its tails; (eq (len L) 0) is L against 1. A compare is a value, 1 or
; 0; any int expression is a condition, tested against 0 as the walker tests it; and a call to a small defn -- one
; expression over its parameters, core.fk's nil? among them -- is that expression inlined. A leaf answers a list or a
; word as the raw word. The C twin of nil? is gone.
;
; Verdict 255
; PROOF LEVEL: FOURTH-ARM ONLY (the transparent lanes are fkwu's MAP_JIT arm64 door; a defn's native state is the 8th field of its hot row)
; preludes: form-stdlib/core.fk
;
;   1   a sum over a list of ints, its condition core.fk's nil?, reads state 2 and agrees with its twin; nil? itself reads state 1
;   2   a loop answering a list (core.fk's drop) reads state 2 and answers as the walker, the empty list past the end
;   4   a loop answering a head's word (an nth) reads state 2: an int, a string, a list back as itself; the empty list's head is nothing
;   8   typefall: a float among the ints, and a string, are answered through the walker, as the twin answers
;   16  len of a list in a leaf, and (eq (len L) 0) as L against 1, at state 1; a find over eq answers the index, or -1
;   32  a twin whose compare holds a host clock stays the walker's (state under 1): a door the lanes decline by meaning
;   64  a loop over a list of lists (identity eq on words) reads state 2 and finds the same list, not an equal one
;   128 the warm run of the sum is under the twin's run of the same work
(do
    (defn lld-bit (ok bit) (if ok bit 0))
    (defn lld-state (name rows) (if (eq (len rows) 0) -99 (if (str_eq (nth (head rows) 1) name) (nth (head rows) 7) (lld-state name (tail rows)))))
    (defn lld-native (name) (lld-state name (kernel_page_hot (host_pid) 240)))
    ; a twin's compare holds a host clock: the lanes decline host doors by meaning, so the twin walks
    (defn lld-lt? (a b) (if (lt (host_monotonic_ms) 0) false (lt a b)))
    (defn lld-mk (n acc) (if (le n 0) acc (lld-mk (sub n 1) (cons n acc))))
    (let xs (lld-mk 50 (list)))
    ; 1: the sum, nil? inlined as its condition
    (defn lld-sum (xs acc) (if (nil? xs) acc (lld-sum (tail xs) (add acc (head xs)))))
    (defn lld-sum-walk (xs acc) (if (lld-lt? 0 (len xs)) (lld-sum-walk (tail xs) (add acc (head xs))) acc))
    (defn lld-h1 (xs n acc) (if (le n 0) acc (lld-h1 xs (sub n 1) (add acc (add (lld-sum xs 0) (nil? xs))))))
    (let h1 (lld-h1 xs 3000 0))
    (let sum-state (lld-native "lld-sum"))
    (let nil-state (lld-native "nil?"))
    (let sum-ok (if (eq (lld-sum xs 0) (lld-sum-walk xs 0)) (eq (lld-sum (list) 7) 7) false))
    ; 2: drop, core.fk's own
    (defn lld-h2 (xs n acc) (if (le n 0) acc (lld-h2 xs (sub n 1) (add acc (len (drop 3 xs))))))
    (let h2 (lld-h2 xs 3000 0))
    (let drop-state (lld-native "drop"))
    (let drop-ok (if (eq (len (drop 3 xs)) 47) (if (eq (head (drop 49 xs)) 50) (if (eq (drop 50 xs) (list)) (eq (drop 60 xs) (list)) false) false) false))
    ; 4: an nth answering a word
    (defn lld-nth (xs i) (if (eq i 0) (head xs) (lld-nth (tail xs) (sub i 1))))
    (defn lld-h4 (xs n acc) (if (le n 0) acc (lld-h4 xs (sub n 1) (add acc (lld-nth xs 7)))))
    (let h4 (lld-h4 xs 3000 0))
    (let nth-state (lld-native "lld-nth"))
    (let mixed (list 1 "two" (list 3) 4.5))
    (let nth-ok (if (eq (lld-nth xs 7) 8) (if (str_eq (lld-nth mixed 1) "two") (if (eq (head (lld-nth mixed 2)) 3) (if (eq (lld-nth mixed 3) 4.5) (nothing? (lld-nth (list) 0)) false) false) false) false))
    ; 8: typefall
    (let ys (cons 1 (cons 2.5 (cons 3 (list)))))
    (let fall-ok (if (eq (lld-sum ys 0) (lld-sum-walk ys 0)) (if (eq (lld-sum ys 0) 6.5) (str_eq (lld-nth (list "a" "b") 1) "b") false) false))
    ; 16: len in a leaf, nil? as L against 1, a find
    (defn lld-len (xs) (len xs))
    (defn lld-find (xs x i) (if (nil? xs) -1 (if (eq (head xs) x) i (lld-find (tail xs) x (add i 1)))))
    ; the driver walks (the clock), so lld-len is called and heated itself rather than inlined into a hot driver
    (defn lld-h16 (xs n acc) (if (lld-lt? 0 n) (lld-h16 xs (sub n 1) (add acc (add (lld-len xs) (lld-find xs 37 0)))) acc))
    (let h16 (lld-h16 xs 3000 0))
    (let len-state (lld-native "lld-len"))
    (let find-state (lld-native "lld-find"))
    (let len-ok (if (eq (lld-len xs) 50) (if (eq (lld-len (list)) 0) (if (eq (lld-find xs 37 0) 36) (eq (lld-find xs 99 0) -1) false) false) false))
    ; 32: the clock-guarded twin stays cold
    (defn lld-h32 (xs n acc) (if (le n 0) acc (lld-h32 xs (sub n 1) (add acc (lld-sum-walk xs 0)))))
    (let h32 (lld-h32 xs 3000 0))
    (let twin-state (lld-native "lld-sum-walk"))
    ; 64: identity over words
    (let inner (list 2))
    (let lol (list (list 1) inner (list 2)))
    (defn lld-h64 (xs x n acc) (if (le n 0) acc (lld-h64 xs x (sub n 1) (add acc (lld-find xs x 0)))))
    (let h64 (lld-h64 lol inner 3000 0))
    (let ident-ok (if (eq (lld-find lol inner 0) 1) (eq (lld-find lol (list 2) 0) -1) false))
    ; 128: the warm run against the twin's
    (let zs (lld-mk 200 (list)))
    (defn lld-rep (xs n acc) (if (le n 0) acc (lld-rep xs (sub n 1) (add acc (lld-sum xs 0)))))
    (defn lld-rep-walk (xs n acc) (if (le n 0) acc (lld-rep-walk xs (sub n 1) (add acc (lld-sum-walk xs 0)))))
    (let w0 (host_monotonic_ms)) (let warm (lld-rep zs 20000 0)) (let w1 (host_monotonic_ms))
    (let k0 (host_monotonic_ms)) (let cold (lld-rep-walk zs 20000 0)) (let k1 (host_monotonic_ms))
    (let told (print (list "states" sum-state nil-state drop-state nth-state len-state find-state "twin" twin-state "sum" sum-ok "drop" drop-ok "nth" nth-ok "fall" fall-ok "len" len-ok "ident" ident-ok "ms" (sub w1 w0) (sub k1 k0))))
    (let b1 (lld-bit (if (eq sum-state 2) (if (eq nil-state 1) sum-ok false) false) 1))
    (let b2 (lld-bit (if (eq drop-state 2) drop-ok false) 2))
    (let b3 (lld-bit (if (eq nth-state 2) nth-ok false) 4))
    (let b4 (lld-bit fall-ok 8))
    (let b5 (lld-bit (if (eq len-state 1) (if (eq find-state 2) len-ok false) false) 16))
    (let b6 (lld-bit (lt twin-state 1) 32))
    (let b7 (lld-bit ident-ok 64))
    (let b8 (lld-bit (if (eq warm cold) (lt (sub w1 w0) (sub k1 k0)) false) 128))
    (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 b8))))))))
