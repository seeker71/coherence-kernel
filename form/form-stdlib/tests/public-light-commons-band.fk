; public-light-commons-band.fk — numeric shared-role identity, explicit public
; choice, append-only routing, and unchanged observation.
;
; preludes: form-stdlib/core.fk cognition/language-neutral-symbol-identity.fk form-stdlib/public-light-commons.fk
;
; Verdict 262143 (all eighteen observations):
;   1       seven public roles are numeric cells
;   2       four locale surfaces resolve to one trust identity
;   4       each trust surface renders from the same identity
;   8       no explicit public choice creates no message
;   16      an unknown role creates no message
;   32      a message addressed to trust is admitted
;   64      an expression through fire is admitted
;   128     the first append creates a one-cell ledger
;   256     the second append preserves the first cell
;   512     a duplicate message id cannot enter the ledger
;   1024    public observation returns the unchanged ledger
;   2048    trust filtering returns only the trust route
;   4096    fire filtering returns only the fire route
;   8192    an unknown locale remains absent
;   16384   every authored role recipe uses known be/do/see/humm modes
;   32768   non-public scope cannot be published
;   65536   blank author or payload cannot be published
;   131072  an unknown route direction cannot be published
;
; witnessed: 2026-08-15 -> fkwu 262143; Go/Rust/TypeScript agree at 262143

(do
    (defn plcb-score (condition weight) (if condition weight 0))
    (defn plcb-recipes-valid? (roles)
        (if (nil? roles) 1
            (if (eq (plc-recipe-valid? (head roles)) 0) 0
                (plcb-recipes-valid? (tail roles)))))
    (defn plcb-same-message? (left right)
        (if (str_eq (plc-message-id left) (plc-message-id right))
            (if (str_eq (plc-message-receipt left)
                        (plc-message-receipt right)) 1 0) 0))

    (let roles (plc-roles))
    (let trust (plc-role-trust))
    (let fire (plc-role-fire))
    (let en-trust (plc-role-resolve "en" "trust"))
    (let id-trust (plc-role-resolve "id" "kepercayaan"))
    (let zh-trust (plc-role-resolve "zh" "信任"))
    (let ja-trust (plc-role-resolve "ja" "信頼"))
    (let no-choice (plc-publish "m-0" "yes-trust" trust (plc-route-to)
        "hello" "33" "" (plc-scope-public) 0 "r-0" "genesis"))
    (let unknown-role (plc-publish "m-0" "yes-trust" 999 (plc-route-to)
        "hello" "33" "" (plc-scope-public) 1 "r-0" "genesis"))
    (let trust-opt (plc-publish "m-1" "yes-trust" trust (plc-route-to)
        "Can trust see this gift?" "33" "" (plc-scope-public) 1
        "receipt-1" "genesis"))
    (let trust-message (head trust-opt))
    (let fire-opt (plc-publish "m-2" "light-worker" fire (plc-route-through)
        "A clear spark offered to the commons." "77777" "m-1"
        (plc-scope-public) 1 "receipt-2" "receipt-1"))
    (let fire-message (head fire-opt))
    (let ledger-one-opt (plc-append (empty) trust-message))
    (let ledger-one (head ledger-one-opt))
    (let ledger-two-opt (plc-append ledger-one fire-message))
    (let ledger-two (head ledger-two-opt))
    (let duplicate (plc-append ledger-two trust-message))
    (let observed (plc-observe ledger-two))
    (let trust-view (plc-observe-role ledger-two trust))
    (let fire-view (plc-observe-role ledger-two fire))
    (let private-scope (plc-publish "m-3" "yes-trust" trust (plc-route-to)
        "private" "" "" (plc-symbol 5 99) 1 "r-3" "receipt-2"))
    (let blank-author (plc-publish "m-3" "" trust (plc-route-to)
        "hello" "" "" (plc-scope-public) 1 "r-3" "receipt-2"))
    (let blank-payload (plc-publish "m-3" "yes-trust" trust (plc-route-to)
        "" "" "" (plc-scope-public) 1 "r-3" "receipt-2"))
    (let bad-route (plc-publish "m-3" "yes-trust" trust (plc-symbol 2 99)
        "hello" "" "" (plc-scope-public) 1 "r-3" "receipt-2"))

    (sum (list
        (plcb-score (and (eq (len roles) 7)
            (and (gt (head roles) 0) (plc-role-known? (nth roles 6)))) 1)
        (plcb-score (and (eq en-trust trust)
            (and (eq id-trust trust) (and (eq zh-trust trust)
                                           (eq ja-trust trust)))) 2)
        (plcb-score (and (str_eq (head (plc-role-render-in trust "en")) "trust")
            (and (str_eq (head (plc-role-render-in trust "id")) "kepercayaan")
            (and (str_eq (head (plc-role-render-in trust "zh")) "信任")
                 (str_eq (head (plc-role-render-in trust "ja")) "信頼")))) 4)
        (plcb-score (eq (len no-choice) 0) 8)
        (plcb-score (eq (len unknown-role) 0) 16)
        (plcb-score (and (eq (len trust-opt) 1)
            (and (eq (plc-message-role trust-message) trust)
                 (eq (plc-message-route trust-message) (plc-route-to)))) 32)
        (plcb-score (and (eq (len fire-opt) 1)
            (and (eq (plc-message-role fire-message) fire)
                 (eq (plc-message-route fire-message) (plc-route-through)))) 64)
        (plcb-score (and (eq (len ledger-one-opt) 1)
            (and (eq (len ledger-one) 1)
                 (plcb-same-message? (head ledger-one) trust-message))) 128)
        (plcb-score (and (eq (len ledger-two-opt) 1)
            (and (eq (len ledger-two) 2)
                 (plcb-same-message? (head ledger-two) trust-message))) 256)
        (plcb-score (eq (len duplicate) 0) 512)
        (plcb-score (and (eq (len observed) (len ledger-two))
            (and (plcb-same-message? (nth observed 0) (nth ledger-two 0))
                 (plcb-same-message? (nth observed 1) (nth ledger-two 1)))) 1024)
        (plcb-score (and (eq (len trust-view) 1)
            (plcb-same-message? (head trust-view) trust-message)) 2048)
        (plcb-score (and (eq (len fire-view) 1)
            (plcb-same-message? (head fire-view) fire-message)) 4096)
        (plcb-score (eq (len (plc-role-render-in trust "unknown")) 0) 8192)
        (plcb-score (plcb-recipes-valid? roles) 16384)
        (plcb-score (eq (len private-scope) 0) 32768)
        (plcb-score (and (eq (len blank-author) 0)
                         (eq (len blank-payload) 0)) 65536)
        (plcb-score (eq (len bad-route) 0) 131072)))
)
