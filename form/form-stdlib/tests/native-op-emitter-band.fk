; preludes: form-stdlib/bml/native-op-emitter.bml gate/lens-text.bml form-stdlib/fkc-table-serialize.fk
; Verdict 0
; the slice is the BML definition `def flt-ops() = [[name, arity, tag], ...];`: bit 1 replaces it between its neighbours and a name's quoted ] and \" stay text,
; bit 2 is idempotent, bit 4 refuses a list that never ends, bit 8 refuses a negative arity, bit 16 refuses a commented definition and reads the live manifest whole
(do
 (defn noeb-k (ok bit) (if ok bit 0))
 (let rows (list (list "add" 2 3 "binary")))
 (let before "// a header\n    def flt-ops() =     // GENERATED\n[[\"quoted]\\\"\", 1, 2], [\"x\", 0, 9]];\n    def after() = 42;\n")
 (let after (noe-replace before rows))
 (sum (list
  (noeb-k (str_eq after (str_concat "// a header\n" (str_concat (noe-block rows) "\n    def after() = 42;\n"))) 1)
  (noeb-k (str_eq (noe-replace after rows) after) 2)
  (noeb-k (nothing? (noe-replace "    def flt-ops() =\n[[\"a\", 1, 2]" rows)) 4)
  (noeb-k (nothing? (noe-replace before (list (list "print" -1 239 "variadic")))) 8)
  (noeb-k (and (nothing? (noe-replace "// def flt-ops() = 0\n42" rows)) (noe-valid (nom-ops))) 16)
  ; bit 32: the walker the emitter builds answers each tag with one arm (the first arm of an if-chain hides a second)
  (noeb-k (eq (len (lx-slow-chain-dups (fkc-walk-many-text))) 0) 32))))
