; preludes: form-stdlib/bml/native-op-emitter.bml
; witnessed: 2026-09-09 -> 31
(do
 (defn noeb-k (ok bit) (if ok bit 0))
 (let rows (list (list "add" 2 3 "binary")))
 (let before "; a header\n(defn flt-ops () (list (list \"quoted)\\\"\" 1 2)))\n(defn after () 42)\n")
 (let after (noe-replace before rows))
 (sum (list
  (noeb-k (str_eq after (str_concat "; a header\n" (str_concat (noe-block rows) "\n(defn after () 42)\n"))) 1)
  (noeb-k (str_eq (noe-replace after rows) after) 2)
  (noeb-k (nothing? (noe-replace "(defn flt-ops () (list" rows)) 4)
  (noeb-k (nothing? (noe-replace before (list (list "print" -1 239 "variadic")))) 8)
  (noeb-k (and (nothing? (noe-replace "; (defn flt-ops () 0)\n42" rows)) (noe-valid (nom-ops))) 16))))
