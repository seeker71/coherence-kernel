; program-image-typed-emission-band.fk -- typed NodeID image reaches text.
;
; The rendering boundary admits only structural typed leaves.  There is no
; raw value-kind probe: BMF construction carries a typed table, and the
; renderer reads trivial integer NodeIDs only after that shape is proven.
;
; preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk form-stdlib/bml/program-image-typed-emission.bml
;
; Expected: 16383

(do
    (defn pitteb-score (ok bit) (if ok bit 0))
    (defn pitteb-has? (text needle) (ge (str_find text needle 0) 0))
    (defn pitteb-roots () (pitte-roots (list 0 3)))
    (defn pitteb-rows ()
        (pitte-rows (list
            (pitte-row 1 42 0 0)
            (pitte-row 12 0 0 0))))
    (defn pitteb-strings ()
        (pitte-strings (list
            (pitte-string-row (list 65 66))
            (pitte-string-row (list 0 255)))))
    (defn pitteb-good ()
        (pitte-table (pitteb-roots) (pitteb-rows) (pitteb-strings)))
    (defn pitteb-envelope ()
        (pitte-envelope "src/typed.fdl" "sha:typed-source" 100
                        "src/typed.fkb" "sha:typed-artifact" 101
                        1 (pitteb-good)))
    (defn pitteb-bad-seal ()
        (pitte-envelope "src/typed.fdl" "sha:typed-source" 100
                        "src/typed.fkb" "sha:typed-artifact" 101
                        0 (pitteb-good)))
    (defn pitteb-golden () "2 0 3 2 1 42 0 0 12 0 0 0 2 2 65 66 2 0 255\n")
    (defn pitteb-bad-root ()
        (pitte-table-node
            (pitte-int 1)
            (intern_node (pitte-roots-bp) (list (pitte-string "0")))
            (pitte-int 1)
            (pitte-rows (list (pitte-row 1 42 0 0)))
            (pitte-int 1)
            (pitte-strings (list (pitte-string-row (list 65))))))
    (defn pitteb-bad-byte ()
        (pitte-table (pitte-roots (list 0))
                     (pitte-rows (list (pitte-row 1 42 0 0)))
                     (pitte-strings (list (pitte-string-row (list 256))))))
    (defn pitteb-bad-count ()
        (pitte-table-node
            (pitte-int 2)
            (pitte-roots (list 0))
            (pitte-int 1)
            (pitte-rows (list (pitte-row 1 42 0 0)))
            (pitte-int 1)
            (pitte-strings (list (pitte-string-row (list 65))))))
    (defn pitteb-bad-row ()
        (pitte-table (pitte-roots (list 0))
                     (pitte-rows (list
                         (intern_node (pitte-row-bp)
                             (list (pitte-int 1) (pitte-int 42) (pitte-string "0") (pitte-int 0)))))
                     (pitte-strings (list (pitte-string-row (list 65))))))
    (defn pitteb-source ()
        (read_file "form/form-stdlib/bml/program-image-typed-emission.bml"))

    (defn program-image-typed-emission-band ()
        (sum (list
            (pitteb-score (str_eq (pitte-version) "program-image-typed-emission-v1") 1)
            (pitteb-score (str_eq (pitte-invariant) "typed-nodeid-before-render") 2)
            (pitteb-score (pitte-table-valid? (pitteb-good)) 4)
            (pitteb-score (str_eq (pitte-table-text (pitteb-good)) (pitteb-golden)) 8)
            (pitteb-score (str_eq (pitte-table-text (pitteb-bad-root)) "") 16)
            (pitteb-score (str_eq (pitte-table-text (pitteb-bad-byte)) "") 32)
            (pitteb-score (str_eq (pitte-table-text (pitteb-bad-count)) "") 64)
            (pitteb-score (str_eq (pitte-table-text (pitteb-bad-row)) "") 128)
            (pitteb-score
                (and (eq (node_type (head (node_children (pitte-int 7)))) 1)
                     (eq (node_type (head (node_children (pitte-string "7")))) 2))
                256)
            (pitteb-score
                (and (pitteb-has? (pitteb-source) "section [form.bml]")
                     (and (pitteb-has? (pitteb-source) "typed-nodeid-before-render")
                          (not (pitteb-has? (pitteb-source) "value_kind"))))
                512)
            (pitteb-score (pitte-envelope-valid? (pitteb-envelope)) 1024)
            (pitteb-score (pif-envelope-valid? (pitte-raw-envelope (pitteb-envelope))) 2048)
            (pitteb-score
                (str_eq (pitte-envelope-table-text (pitteb-envelope))
                        (pitte-table-text (pitteb-good)))
                4096)
            (pitteb-score
                (and (nothing? (pitte-raw-envelope (pitteb-bad-seal)))
                     (nothing? (pitte-envelope-table-text (pitteb-bad-seal))))
                8192))))

    (program-image-typed-emission-band))
