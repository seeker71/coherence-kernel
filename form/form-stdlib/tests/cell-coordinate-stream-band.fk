; cell-coordinate-stream-band.fk -- unknown categories cross text by coordinate.
; Verdict 131071 proves seventeen identity, value, category, and refusal claims.
; preludes: form-stdlib/core.fk form-stdlib/cell-coordinate-stream.fk

(defn ccsb-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (ccsb-sum (tail items)))))

(do
    ; This category is intentionally not created through bp and has no name
    ; registry.  Its exact coordinate is the only required structural lens.
    (let unknown-category (make_nodeid 8 45 99 424242))
    (let nested-category (make_nodeid 8 45 99 424243))
    (let delimiter-string
        (intern_trivial_string "raw,:n5:[]\nbytes remain unescaped"))
    (let original
        (intern_node unknown-category
            (list
                (intern_trivial_int -17)
                delimiter-string
                (intern_trivial_bool true)
                (intern_trivial_float "3.5")
                (intern_node nested-category (list)))))
    (let text (ccs-emit original))
    (let restored (ccs-decode text))
    (let difficult-float (intern_trivial_float "0.123456789012345"))
    (let difficult
        (intern_node unknown-category (list difficult-float)))
    ; Direct-source bp categories are canonical strings in the present body,
    ; not coordinate NodeIDs.  They cross without a name registry through the
    ; source-category stream arm and retain exact content identity.
    (let source-category (bp "CCSB-SOURCE-CATEGORY"))
    (let source-child-category (bp "CCSB-SOURCE-CHILD-CATEGORY"))
    (let source-original
        (intern_node source-category
            (list (intern_node source-child-category
                    (list (intern_trivial_int 23))))))
    (let source-text (ccs-emit source-original))
    (let source-restored (ccs-decode source-text))
    (let source-atom-text (ccs-emit source-category))
    (let coordinate-atom-text (ccs-emit unknown-category))
    (ccsb-sum
        (list
            (if (eq (ccs-supported? original) 1) 1 0)
            (if (node_eq restored original) 2 0)
            (if (node_eq (node_category restored) unknown-category) 4 0)
            (if (eq (node_value (nth (node_children restored) 0)) -17) 8 0)
            (if (node_eq (nth (node_children restored) 1)
                         delimiter-string) 16 0)
            (if (node_value (nth (node_children restored) 2)) 32 0)
            (if (eq (node_value (nth (node_children restored) 3)) 3.5) 64 0)
            (if (node_eq (node_category
                            (nth (node_children restored) 4))
                         nested-category) 128 0)
            (if (eq (len (node_children
                            (nth (node_children restored) 4))) 0) 256 0)
            (if (eq (ccs-decoded-size text) (str_len text)) 512 0)
            (if (eq (ccs-canonical? text) 1) 1024 0)
            (if (eq (ccs-supported? difficult) 0) 2048 0)
            (if (eq (ccs-supported? source-original) 1) 4096 0)
            (if (node_eq source-restored source-original) 8192 0)
            (if (node_eq (node_category source-restored)
                         source-category) 16384 0)
            (if (and (node_eq (ccs-decode source-atom-text) source-category)
                     (eq (ccs-canonical? source-atom-text) 1)) 32768 0)
            (if (and (node_eq (ccs-decode coordinate-atom-text)
                              unknown-category)
                     (eq (ccs-canonical? coordinate-atom-text) 1)) 65536 0))))
