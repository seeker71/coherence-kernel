; form-cli-token-route-sealed.fk — frozen paired cases for the first live
; Form-TOKEN execution route.
;
; This file was sealed before the router implementation.  The router may not
; read these rows at run time.  Calibration rows author the intentionally
; narrow surface grammar; holdout rows vary arguments and carry adversarial
; declines.  There is no threshold search over either split.
;
; A case is:
;   (id split locale query expected-route expected-result execution-kind)
; expected-route: 1 = form-token-eval, 0 = incumbent route.
; expected-result: integer for an admitted recipe, -999 for a decline.
; execution-kind: derived for computed output, incumbent for a decline.
;
; witnessed: 2026-08-17 -> sealed before implementation; digest in receipt

(do
  (defn fctrs-case (id split locale query route result kind)
    (list id split locale query route result kind))
  (defn fctrs-id (c) (nth c 0))
  (defn fctrs-split (c) (nth c 1))
  (defn fctrs-locale (c) (nth c 2))
  (defn fctrs-query (c) (nth c 3))
  (defn fctrs-route (c) (nth c 4))
  (defn fctrs-result (c) (nth c 5))
  (defn fctrs-kind (c) (nth c 6))

  (defn fctrs-cases ()
    (list
      ; Calibration: four independently authored surface planes converge on
      ; the same three numeric recipe TOKENs.
      (fctrs-case "c01" "cal" "en" "token add 2 3" 1 5 "derived")
      (fctrs-case "c02" "cal" "en" "token equal 4 4" 1 1 "derived")
      (fctrs-case "c03" "cal" "en" "token and 1 0" 1 0 "derived")
      (fctrs-case "c04" "cal" "de" "token addiere 7 8" 1 15 "derived")
      (fctrs-case "c05" "cal" "de" "token gleich 9 8" 1 0 "derived")
      (fctrs-case "c06" "cal" "de" "token und 1 1" 1 1 "derived")
      (fctrs-case "c07" "cal" "zh" "令牌 加 10 5" 1 15 "derived")
      (fctrs-case "c08" "cal" "zh" "令牌 等于 6 6" 1 1 "derived")
      (fctrs-case "c09" "cal" "zh" "令牌 与 0 1" 1 0 "derived")
      (fctrs-case "c10" "cal" "ja" "トークン 加算 3 9" 1 12 "derived")
      (fctrs-case "c11" "cal" "ja" "トークン 等値 2 7" 1 0 "derived")
      (fctrs-case "c12" "cal" "ja" "トークン 論理積 1 1" 1 1 "derived")
      (fctrs-case "c13" "cal" "form" "token-add 20 22" 1 42 "derived")
      (fctrs-case "c14" "cal" "form" "token-eq 5 5" 1 1 "derived")
      (fctrs-case "c15" "cal" "form" "token-and 0 0" 1 0 "derived")
      (fctrs-case "c16" "cal" "en" "token add -2 5" 1 3 "derived")

      ; Positive holdout: unseen numeric bindings only.  These rows measure
      ; executable recipe generalization, not unseen-language generalization.
      (fctrs-case "h01" "holdout" "en" "token add 34 8" 1 42 "derived")
      (fctrs-case "h02" "holdout" "de" "token gleich 17 17" 1 1 "derived")
      (fctrs-case "h03" "holdout" "zh" "令牌 与 1 0" 1 0 "derived")
      (fctrs-case "h04" "holdout" "ja" "トークン 加算 -10 4" 1 -6 "derived")
      (fctrs-case "h05" "holdout" "form" "token-eq 0 0" 1 1 "derived")
      (fctrs-case "h06" "holdout" "en" "token and 1 1" 1 1 "derived")
      (fctrs-case "h07" "holdout" "de" "token addiere 100 -1" 1 99 "derived")
      (fctrs-case "h08" "holdout" "zh" "令牌 等于 -3 -3" 1 1 "derived")

      ; Negative holdout: quotation, negation, incomplete/unknown recipes,
      ; invalid numeric bindings, extra arguments, and unrelated incumbent ask.
      (fctrs-case "n01" "holdout" "en" "translate the string token add 2 3 into German" 0 -999 "incumbent")
      (fctrs-case "n02" "holdout" "en" "not token add 2 3" 0 -999 "incumbent")
      (fctrs-case "n03" "holdout" "en" "token add 2" 0 -999 "incumbent")
      (fctrs-case "n04" "holdout" "en" "token add two three" 0 -999 "incumbent")
      (fctrs-case "n05" "holdout" "form" "token-mul 2 3" 0 -999 "incumbent")
      (fctrs-case "n06" "holdout" "en" "token add 2 3 extra" 0 -999 "incumbent")
      (fctrs-case "n07" "holdout" "zh" "令牌 加 二 三" 0 -999 "incumbent")
      (fctrs-case "n08" "holdout" "en" "standard receipt" 0 -999 "incumbent")))

  0)
