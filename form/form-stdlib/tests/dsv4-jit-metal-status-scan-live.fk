; Exact operation-bearing receipt scan in Form-emitted ARM64.
; FAIL has precedence over NOTHING; NOTHING over the PASS summary.
;
; preludes: native/metal/dsv4-jit-metal-abi.fk

(if (and
        (eq
            (djma-status-live
                "transaction-step=0\noperation=state_save\nPASS metal_model_state_save\nPASS metal_model_transaction\noutcome=success\n")
            1)
        (and
            (eq
                (djma-status-live
                    "transaction-step=0\noperation=state_save\nNOTHING metal_model_state_save\ntransaction-outcome=stopped\n")
                2)
            (and
                (eq
                    (djma-status-live
                        "transaction-step=0\nFAIL metal_model_state_save\nPASS metal_model_transaction\n")
                    0)
                (eq
                    (djma-status-live
                        "transaction-step=0\noperation=state_save\n")
                    0))))
    255
    0)
