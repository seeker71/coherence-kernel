; Prepared trace funnel, not the default layer path while the active token run
; is full-detail. Output proves: one detailed PASS receipt, no second PASS
; payload for funnel mode, and a complete FAIL receipt in funnel mode.
;
; preludes: native/metal/dsv4-jit-metal-abi.fk

(do
    (let route
        (dsv4-jit-metal-transaction-route
            "fkwu-metal-transaction"))
    (let detailed
        (dsv4-jit-metal-transaction-routed-parts-detail
            route (list "" "") 1))
    (let quiet-pass
        (dsv4-jit-metal-transaction-routed-parts-funnel
            route (list "" "")))
    (let diagnostic
        (dsv4-jit-metal-transaction-routed-parts-funnel
            route
            (list "state_" "save\ttrace-funnel\n")))
    (if (and
            (eq detailed 1)
            (and (eq quiet-pass 1) (eq diagnostic 0)))
        255
        0))
