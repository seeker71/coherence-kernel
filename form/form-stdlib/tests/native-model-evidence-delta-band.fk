; Form witness for content-identity state and comparison admissibility.
; preludes: form-stdlib/core.fk form-stdlib/native-model-evidence-delta.fk
; Verdict 15.

(do
    (let a "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    (let b "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
    (let c "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc")
    (let d "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd")
    (let baseline (nmed-evidence-state a b c "" "" ""))
    (let unchanged (nmed-evidence-state a b c a b c))
    (let changed (nmed-evidence-state d b c a b c))
    (let contract-changed (nmed-evidence-state a b d a b c))
    (sum (list
        (if (str_eq baseline "baseline-unavailable") 1 0)
        (if (and (str_eq unchanged "unchanged-evidence-comparable")
                 (eq (nmed-comparison-admissible? a b c a b c) 1)) 2 0)
        (if (and (str_eq changed "evidence-changed-not-comparable")
                 (eq (nmed-comparison-admissible? d b c a b c) 0)) 4 0)
        (if (str_eq contract-changed "contract-changed-not-comparable") 8 0))))
