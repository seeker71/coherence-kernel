; form-cli-token-route-band.fk — the live ASK TOKEN evaluator, its semantic
; identity, substrate binding, split accounting, provenance axes, and declines.
;
; Verdict: 2097151 (21 bits).
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/storage-port.fk
; preludes: form-stdlib/form-cli-router.fk form-stdlib/str-byte-at.fk form-stdlib/sha256.fk form-stdlib/hex.fk
; preludes: form-stdlib/text-tokenize.fk form-stdlib/rag-embed.fk
; preludes: form-stdlib/rag-index-codec.fk form-stdlib/rag-retrieve.fk form-stdlib/rag-ask.fk
; preludes: form-stdlib/ask-cost-receipt.fk form-stdlib/ask-native-lane.fk
; preludes: form-stdlib/form-cli-ask.fk form-stdlib/tests/form-cli-token-route-sealed.fk

(do
  (defn fctrb-bit (condition bit) (if condition bit 0))
  (defn fctrb-case-ok? (c)
    (do (let route (fctr-route (fctrs-query c)))
        (if (eq (fctrs-route c) 1)
            (if (and (eq (fctr-hit? route) 1)
                     (and (eq (fctr-result route) (fctrs-result c))
                          (not (lt (str_find (fctr-answer route)
                            "content-grade=derived" 0) 0)))) 1 0)
            (if (eq (fctr-hit? route) 0) 1 0))))
  (defn fctrb-pass-count (cases)
    (if (eq (len cases) 0) 0
        (add (fctrb-case-ok? (head cases))
             (fctrb-pass-count (tail cases)))))
  (defn fctrb-split-count (cases split)
    (if (eq (len cases) 0) 0
        (add (if (str_eq (fctrs-split (head cases)) split) 1 0)
             (fctrb-split-count (tail cases) split))))
  (defn fctrb-route-count (cases expected)
    (if (eq (len cases) 0) 0
        (add (if (eq (fctrs-route (head cases)) expected) 1 0)
             (fctrb-route-count (tail cases) expected))))

  (defn form-cli-token-route-band ()
    (do
      (let cases (fctrs-cases))
      (let en-add (fctr-s-token (fctr-find-surface "token add 1 2")))
      (let de-add (fctr-s-token (fctr-find-surface "token addiere 1 2")))
      (let zh-add (fctr-s-token (fctr-find-surface "令牌 加 1 2")))
      (let ja-add (fctr-s-token (fctr-find-surface "トークン 加算 1 2")))
      (let pl-add (fctr-s-token (fctr-find-surface "token-add 1 2")))
      (let numeric (fctr-token-numeric en-add))
      (let registry (fctr-registry en-add "authored-form"))
      (let wrong-ctor (intern_node (fctr-constructor-category)
        (list en-add (intern_trivial_int 99))))
      (let forged-ctor (fctr-registry-row en-add (fctr-blueprint en-add)
        wrong-ctor (fctr-suite-seal) "authored-form"))
      (let stale (fctr-registry-row en-add (fctr-blueprint en-add)
        (fctr-constructor en-add) "stale-seal" "authored-form"))
      (let remote-origin (fctr-registry-row en-add (fctr-blueprint en-add)
        (fctr-constructor en-add) (fctr-suite-seal) "remote-derived"))
      (let live-route (fctr-route "token add 20 22"))
      (let live-answer (fctr-answer live-route))
      (sum (list
        (fctrb-bit (and (eq (len cases) 32)
          (eq (fctrb-pass-count cases) 32)) 1)
        (fctrb-bit (and (eq (fctrb-split-count cases "cal") 16)
          (eq (fctrb-split-count cases "holdout") 16)) 2)
        (fctrb-bit (and (eq (fctrb-route-count cases 1) 24)
          (eq (fctrb-route-count cases 0) 8)) 4)
        (fctrb-bit (and (node_eq en-add de-add)
          (and (node_eq en-add zh-add)
            (and (node_eq en-add ja-add) (node_eq en-add pl-add)))) 8)
        (fctrb-bit (node_eq en-add (fctr-token-from-numeric numeric)) 16)
        (fctrb-bit (and (eq (nth numeric 0) 1)
          (eq (nth numeric 1) (fctr-op-add))) 32)
        (fctrb-bit (eq (fctr-token-valid? en-add) 1) 64)
        (fctrb-bit (eq (fctr-registry-valid? registry) 1) 128)
        (fctrb-bit (eq (fctr-substrate-valid? registry) 1) 256)
        (fctrb-bit (and (eq (fctr-registry-valid? forged-ctor) 0)
          (eq (fctr-substrate-valid? forged-ctor) 0)) 512)
        (fctrb-bit (and (eq (fctr-registry-valid? stale) 0)
          (eq (fctr-registry-valid? remote-origin) 0)) 1024)
        (fctrb-bit (and (eq (fctr-eval en-add (list 20 22)) 42)
          (eq (fctr-result live-route) 42)) 2048)
        (fctrb-bit (and (eq (fctr-hit? live-route) 1)
          (str_eq (fca-lane-of "token add 20 22") "form-token-eval")) 4096)
        (fctrb-bit (and (not (lt (str_find live-answer
            "execution-lane=form-token-eval" 0) 0))
          (not (lt (str_find live-answer
            "semantic-origin=authored-form" 0) 0))) 8192)
        (fctrb-bit (and (not (lt (str_find live-answer
            "substrate-binding=observed" 0) 0))
          (not (lt (str_find live-answer "validator=fkwu" 0) 0))) 16384)
        (fctrb-bit (str_eq (fca-ask "token add 20 22") live-answer) 32768)
        (fctrb-bit (and (eq (fctr-hit? (fctr-route
            "translate the string token add 2 3 into German")) 0)
          (eq (fctr-hit? (fctr-route "not token add 2 3")) 0)) 65536)
        (fctrb-bit (and (eq (fctr-hit? (fctr-route "token add 2")) 0)
          (eq (fctr-hit? (fctr-route "token add 2 3 extra")) 0)) 131072)
        (fctrb-bit (and (eq (fctr-hit? (fctr-route "token add two three")) 0)
          (eq (fctr-hit? (fctr-route "token-mul 2 3")) 0)) 262144)
        (fctrb-bit (and (eq (node_level (head (node_children en-add))) 1)
          (eq (node_type (head (node_children en-add))) 1)) 524288)
        (fctrb-bit (and (not (node_eq en-add
            (fctr-token (fctr-op-eq))))
          (not (node_eq (fctr-blueprint en-add)
            (fctr-blueprint (fctr-token (fctr-op-eq)))))) 1048576)))))

  (form-cli-token-route-band))
