; form-knowledge-exec-diagnostic-harness-band.fk -- the hidden executable
; vector, frozen before any local model candidate is sampled.
;
; Verdict 2047 (11 bits): the nine semantic gates, exact perfect score, and an
; adversarial candidate that confuses nothing/0, choice/cut, undo and timeout
; cannot receive their credit.
;
; preludes: form-stdlib/core.fk control/offer-ack-core.fk control/choice-lane-core.fk
; preludes: form-stdlib/form-knowledge-exec-diagnostic-harness.fk

(do
    (defn fkedhb-silent (args) (oac-nothing))
    (defn fkedhb-one (args) (oac-one (intern_trivial_int 1)))
    (defn fkedhb-presence () (list (nothing) 0 1))
    (defn fkedhb-choice ()
        (oac-choice (list fkedhb-silent fkedhb-one) (list)))
    (defn fkedhb-cut ()
        (oac-cut-with-receipt (list fkedhb-silent fkedhb-one) (list)))
    (defn fkedhb-undo () (oac-undo (oac-nothing) 41 99))
    (defn fkedhb-timeout ()
        (oac-timeout-walk (list fkedhb-silent fkedhb-one) (list) 1))

    (defn fkedhb-wrong-presence () (list 0 0 1))
    (defn fkedhb-wrong-choice () (oac-nothing))
    (defn fkedhb-wrong-cut ()
        (oac-cut-with-receipt (list fkedhb-one fkedhb-silent) (list)))
    (defn fkedhb-wrong-undo () 99)
    (defn fkedhb-wrong-timeout ()
        (oac-timeout-walk (list fkedhb-silent) (list) 2))

    (defn fkedhb-run ()
        (do
            (let good (fkedh-score fkedhb-presence fkedhb-choice fkedhb-cut
                fkedhb-undo fkedhb-timeout))
            (let wrong (fkedh-score fkedhb-wrong-presence fkedhb-wrong-choice
                fkedhb-wrong-cut fkedhb-wrong-undo fkedhb-wrong-timeout))
            (sum (list
                (if (eq good 511) 511 0)
                (if (eq good (fkedh-perfect)) 512 0)
                (if (and (eq (mod wrong 4) 1)
                    (and (eq (mod (div wrong 16) 2) 0)
                    (and (eq (mod (div wrong 32) 2) 0)
                    (and (eq (mod (div wrong 128) 2) 0)
                         (eq (mod (div wrong 256) 2) 0))))) 1024 0)))))

    (fkedhb-run))
