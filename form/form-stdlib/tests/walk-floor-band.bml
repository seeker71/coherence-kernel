; walk-floor-band.bml — a window holds an option only when its room holds a real option of that lane (host-walk-window.bml,
; hw-option-floor-of), and an option begun inside the window ends with it (form-token-grammar.bml, ftg-window-*).
;
; The floor is the median of a lane's real options: rows that opened a model and reached a verdict. A recheck, an
; already-full or idle read, a refusal before any model, a dry or test row, a lane that gave its memory back, a broken
; generation and an option cut at the window's end are rows too, and none of them is an option. The voice that will open
; is measured by its own rows when it has any, else by every voice's. A median longer than the window lets no turn start,
; and a turn that does not start writes no row, so the floor could never come down again: it is held at 60 min, half of
; the night's 120-minute window, and its words say so.
;
; Expected: 2047
; Verdict 2047 when every claim lands:
;   1   a median above 60 min is held at 3600000 ms: "the median of 3 real options of qwen38-q4, held at 60 min"
;   2   a median at or below 60 min stands unchanged: "the median of 3 real options of qwen38-q4"
;   4   a 120-minute window holds the held floor
;   8   an empty ledger still asks for half an hour: "no real option measured yet"
;   16  the mixed ledger reads the median of the chosen voice's real options: qwen38-q8's three planner options read
;       700000, qwen38-q4's three turn options read 1500000; its rechecks, already-full and idle reads, refusals before
;       any model, dry and test rows, memory endings, broken and cut options measure nothing
;   32  a voice with no real option reads every voice's six: 1400000, "the median of 6 real options of every voice, none
;       of qwen38-q9 yet"
;   64  a ledger of rows with no real option among them reads the unmeasured floor, and names the voice it asked for
;   128 a planner row and a turn row each name their voice (voice, approach model); a real row's wall is its measure
;   256 a decode past the window ends: with the window an instant past, the feed hands the window's word, which is the
;       floor's cut word; with no window the same feed is not past
;   512 a coding lane past its window ends between replies with window-end;checkpoint-retained and its checkpoint saved;
;       with the window given back the same lane goes on to its own next decision (its turn budget)
;   1024 a window is heard only by the cell that set it: a cell stopped at its deadline runs no defer and leaves its
;       window behind, and a later cell in the same process that set none hears no window; a window recorded under
;       another cell's name is not heard here, and this cell's own is
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/form-cli-code-live.bml form-stdlib/bml/host-walk.bml
section [form.bml] {
 class WalkFloorBand {
  def wfb-turn(model, wall) = "{\"approach\":{\"rung\":\"first\",\"model\":\"" ++ model ++ "\"},\"lane\":\"lane-exit=0\",\"lane_status\":\"attention\",\"lane_reason\":\"caller-turn-budget-reached;checkpoint-retained\",\"local_generated_ids\":900,\"dry\":0,\"test\":0,\"wall_ms\":" ++ wall.str() ++ "}\n";
  def wfb-plan(voice, wall) = "{\"rung\":\"lens\",\"voice\":\"" ++ voice ++ "\",\"verdict\":\"refused\",\"voice_status\":\"answered\",\"local_generated_ids\":500,\"wall_ms\":" ++ wall.str() ++ "}\n";
  def wfb-long() = wfb-turn("qwen38-q4", 7300000) ++ wfb-turn("qwen38-q4", 7400000) ++ wfb-turn("qwen38-q4", 7500000);
  def wfb-short() = wfb-turn("qwen38-q4", 600000) ++ wfb-turn("qwen38-q4", 900000) ++ wfb-turn("qwen38-q4", 1200000);
  // rows that are no option: each carries a wall, so a floor that read every row would read them
  def wfb-noise() = "{\"rung\":\"recheck\",\"voice\":\"qwen38-q8\",\"verdict\":\"refused\",\"voice_status\":\"retained\",\"local_generated_ids\":0,\"wall_ms\":2500}\n"
   ++ "{\"rung\":\"recheck\",\"voice\":\"qwen38-q8\",\"verdict\":\"verified\",\"voice_status\":\"answered\",\"local_generated_ids\":12,\"wall_ms\":43000}\n"
   ++ "{\"lane\":\"band\",\"lane_status\":\"complete\",\"lane_reason\":\"already-full\",\"approach\":{\"rung\":\"band\",\"model\":\"\"},\"local_generated_ids\":0,\"dry\":0,\"test\":0,\"wall_ms\":5000}\n"
   ++ "{\"lane\":\"lane-exit=0\",\"lane_status\":\"attention\",\"approach\":{\"model\":\"qwen38-q4\"},\"local_generated_ids\":0,\"dry\":0,\"test\":0,\"wall_ms\":60000}\n"
   ++ "{\"rung\":\"resume\",\"voice\":\"qwen38-q8\",\"verdict\":\"refused\",\"voice_status\":\"unavailable\",\"local_generated_ids\":0,\"wall_ms\":3000}\n"
   ++ "{\"approach\":{\"model\":\"qwen38-q4\"},\"lane\":\"lane-exit=0\",\"lane_status\":\"attention\",\"lane_reason\":\"checkpoint-absent-corrupt-or-contract-changed\",\"local_generated_ids\":0,\"dry\":0,\"test\":0,\"wall_ms\":4000}\n"
   ++ "{\"approach\":{\"model\":\"qwen38-q4\"},\"lane\":\"lane-exit=0\",\"lane_status\":\"attention\",\"local_generated_ids\":50,\"dry\":1,\"test\":0,\"wall_ms\":100}\n"
   ++ "{\"approach\":{\"model\":\"qwen38-q4\"},\"lane\":\"lane-exit=0\",\"lane_status\":\"attention\",\"local_generated_ids\":50,\"dry\":0,\"test\":1,\"wall_ms\":200}\n"
   ++ "{\"approach\":{\"model\":\"qwen38-q4\"},\"lane\":\"lane-exit=0\",\"lane_status\":\"attention\",\"lane_reason\":\"host-memory-low\",\"local_generated_ids\":30,\"dry\":0,\"test\":0,\"wall_ms\":50000}\n"
   ++ "{\"approach\":{\"model\":\"qwen38-q4\"},\"lane\":\"lane-exit=0\",\"lane_status\":\"attention\",\"lane_reason\":\"generation-incomplete;candidate-retained\",\"local_generated_ids\":40,\"dry\":0,\"test\":0,\"wall_ms\":90000}\n"
   ++ "{\"approach\":{\"model\":\"qwen38-q4\"},\"lane\":\"lane-exit=0\",\"lane_status\":\"attention\",\"lane_reason\":\"window-end;checkpoint-retained\",\"local_generated_ids\":800,\"dry\":0,\"test\":0,\"wall_ms\":300000}\n"
   ++ "{\"approach\":{\"model\":\"qwen38-q4\"},\"lane\":\"lane-exit=0\",\"lane_status\":\"attention\",\"lane_reason\":\"window-end;checkpoint-write-refused;candidate-retained\",\"local_generated_ids\":700,\"dry\":0,\"test\":0,\"wall_ms\":200000}\n"
   ++ "{\"rung\":\"focus\",\"voice\":\"qwen38-q8\",\"verdict\":\"refused\",\"voice_status\":\"window-end\",\"local_generated_ids\":300,\"wall_ms\":120000}\n";
  def wfb-mixed() = wfb-noise() ++ wfb-plan("qwen38-q8", 600000) ++ wfb-turn("qwen38-q4", 1400000) ++ wfb-plan("qwen38-q8", 800000) ++ wfb-turn("qwen38-q4", 1600000) ++ wfb-plan("qwen38-q8", 700000) ++ wfb-turn("qwen38-q4", 1500000);
  def wfb-c-held(ctx) {
   let f = hw-option-floor-of(wfb-long(), "qwen38-q4");
   f[0] == 3600000 && (String) f[1] == "the median of 3 real options of qwen38-q4, held at 60 min";
  }
  def wfb-c-short(ctx) {
   let f = hw-option-floor-of(wfb-short(), "qwen38-q4");
   f[0] == 900000 && (String) f[1] == "the median of 3 real options of qwen38-q4";
  }
  def wfb-c-room(ctx) = hw-room-at(7200000, 0, hw-option-floor-of(wfb-long(), "qwen38-q4"))[0];
  def wfb-c-empty(ctx) {
   let f = hw-option-floor-of("", "");
   f[0] == 1800000 && (String) f[1] == "no real option measured yet";
  }
  def wfb-c-voice(ctx) {
   let q8 = hw-option-floor-of(wfb-mixed(), "qwen38-q8");
   let q4 = hw-option-floor-of(wfb-mixed(), "qwen38-q4");
   q8[0] == 700000 && (String) q8[1] == "the median of 3 real options of qwen38-q8" && q4[0] == 1500000 && (String) q4[1] == "the median of 3 real options of qwen38-q4";
  }
  def wfb-c-every(ctx) {
   let f = hw-option-floor-of(wfb-mixed(), "qwen38-q9");
   f[0] == 1400000 && (String) f[1] == "the median of 6 real options of every voice, none of qwen38-q9 yet";
  }
  def wfb-c-none(ctx) {
   let f = hw-option-floor-of(wfb-noise(), "qwen38-q8");
   f[0] == 1800000 && (String) f[1] == "no real option measured yet, of qwen38-q8 or any voice";
  }
  def wfb-c-rows(ctx) {
   let plan = wfb-plan("qwen38-q8", 700000);
   let turn = wfb-turn("qwen38-q4", 1500000);
   (String) hw-voice-of(plan) == "qwen38-q8" && (String) hw-voice-of(turn) == "qwen38-q4" && hw-wall(turn) == 1500000 && hw-wall(plan) == 700000;
  }
  def wfb-c-feed(ctx) {
   let saved = ftg-window-until();
   let none = ftg-window-at(0);
   let open = !ftg-window-past?();
   let set = ftg-window-at(host_monotonic_ms() - 1);
   let past = ftg-window-past?();
   let fed = ftg-window-feed(0, 0, "x");
   let back = ftg-window-at(saved);
   open && past && (String) fed[2] == ftg-window-end() && (String) ftg-window-end() == hw-cut-word();
  }
  def wfb-session() = fcms-session("live", "scripted", "/scripted.gguf", "", [], [], 4096, 10, -1, 0, 0, 0, 0, 0);
  def wfb-goal() = "Add (defn cl-unit-at (text line) ...) inside the (do ...) before the final 0.";
  def wfb-docs() = [["closure-lines.fk", "closure-lines.fk", "(do\n    0)\n"]];
  def wfb-state(root) = fcam-with(fcap-open-direct-code(wfb-goal(), wfb-docs(), ["closure-lines.fk"]), [root, "walk-floor-band", fcam-scope(wfb-goal(), wfb-docs(), ["closure-lines.fk"], "[]"), 0]);
  def wfb-roomy() = [16384, 128 * mg-gib(), 8 * 65536, 0, 0, 20 * 65536, 2 * 65536, 2 * 65536, 4 * 65536, 0, 0, 0, 0, 0, 0, 48 * 65536, 0];
  def wfb-c-lane(ctx) {
   let root = temp_dir() ++ "/walk-floor-band-" ++ now_unix_ms().str();
   let made = host_dir_mkdir(root);
   let state = wfb-state(root);
   let saved = ftg-window-until();
   let set = ftg-window-at(host_monotonic_ms() - 1);
   let cut = fcac-loop-with(wfb-session(), state, [], 10, now_unix_ms(), () => wfb-roomy());
   let open = ftg-window-at(0);
   let counted = append(state[:9], [1] + state[10:]);
   let after = fcac-loop-with(wfb-session(), counted, [], 1, now_unix_ms(), () => wfb-roomy());
   let back = ftg-window-at(saved);
   let kept = fcam-read(fcam-path(root, "walk-floor-band", "checkpoint"));
   let swept = host_dir_rmdir(root);
   (String) fcap-note(cut[1]) == "window-end;checkpoint-retained" && fcap-done(cut[1]) && !nothing?(kept) && (String) fcap-note(after[1]) == "caller-turn-budget-reached;checkpoint-retained";
  }
  // two cells called in this process: the first sets a window an instant ahead and is stopped at its deadline before
  // its defer gives the window back; the second sets none and answers whether it hears a window
  def wfb-stopped-cell() = "import form-stdlib/bml/form-token-grammar.bml;\nsection [form.bml] {\n class WfbStopped {\n  def wfb-spin(until, n) = host_monotonic_ms() >= until ? n : wfb-spin(until, n + 1);\n  def wfb-door() {\n   let window = ftg-window-until();\n   let set = ftg-window-at(host_monotonic_ms() + 200);\n   defer ftg-window-at(window);\n   wfb-spin(host_monotonic_ms() + 20000, 0);\n  }\n }\n wfb-door();\n}\n";
  def wfb-later-cell() = "import form-stdlib/bml/form-token-grammar.bml;\nsection [form.bml] {\n ftg-window-until() == 0 && !ftg-window-past?() ? 1 : 0;\n}\n";
  def wfb-c-owner(ctx) {
   let dir = temp_dir() ++ "/walk-floor-owner-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str();
   let made = host_dir_mkdir(dir);
   let a = write_file_text(dir ++ "/stopped.bml", wfb-stopped-cell());
   let b = write_file_text(dir ++ "/later.bml", wfb-later-cell());
   let stopped = cell_run(dir ++ "/stopped.bml", 0, 1500, nothing());
   let rested = host_sleep_ms(400);
   let later = cell_run(dir ++ "/later.bml", 0, 30000, nothing());
   let saved = ftg-window-until();
   let other = record_set(FTG-DEFAULT, "window-owner", dir ++ "/stopped.bml");
   let stale = record_set(FTG-DEFAULT, "window-until", host_monotonic_ms() - 1);
   let unheard = ftg-window-until() == 0 && !ftg-window-past?();
   let own = ftg-window-at(host_monotonic_ms() - 1);
   let heard = ftg-window-past?();
   let back = ftg-window-at(saved);
   let gone = host_dir_rmdir(dir);
   let kind = nothing?(stopped) || nothing?(record_get(stopped, "stopped")) ? "" : (String) record_get(record_get(stopped, "stopped"), "kind");
   (String) kind == "deadline" && !nothing?(later) && (Comparable) (record_get(later, "value") ?? 0) == 1 && unheard && heard;
  }
 }
 live-claims("walk-floor-band", 0, [["held", 1, 1, wfb-c-held], ["short", 2, 1, wfb-c-short], ["room", 4, 1, wfb-c-room], ["empty", 8, 1, wfb-c-empty], ["voice", 16, 1, wfb-c-voice], ["every", 32, 1, wfb-c-every], ["none", 64, 1, wfb-c-none], ["rows", 128, 1, wfb-c-rows], ["feed", 256, 1, wfb-c-feed], ["lane", 512, 1, wfb-c-lane], ["owner", 1024, 1, wfb-c-owner]]);
}
