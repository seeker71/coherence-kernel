; walk-floor-band.bml — the walk's option floor has a ceiling, so a window always holds a turn (host-walk-window.bml, hw-option-floor-of).
;
; The floor is the median real option the checkout's own ledger measured. A median longer than the window lets no turn
; start, and a turn that does not start writes no row, so the floor could never come down again: a stopping point. The
; floor is held at 60 min, half of the night's 120-minute window, and its words say so.
;
; Expected: 15
; Verdict 15 when every claim lands:
;   1   a median above 60 min is held at 3600000 ms, and its words read "the median of 3 measured, held at 60 min"
;   2   a median at or below 60 min stands unchanged, its words "the median of 3 measured"
;   4   a 120-minute window holds the held floor
;   8   an empty ledger still asks for half an hour: "no option measured yet"
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/host-walk.bml
section [form.bml] {
 class WalkFloorBand {
  def wfb-long() = "{\"wall_ms\":7300000}\n{\"wall_ms\":7400000}\n{\"wall_ms\":7500000}\n";
  def wfb-short() = "{\"wall_ms\":600000}\n{\"wall_ms\":900000}\n{\"wall_ms\":1200000}\n";
  def wfb-c-held(ctx) {
   let f = hw-option-floor-of(wfb-long());
   f[0] == 3600000 && (String) f[1] == "the median of 3 measured, held at 60 min";
  }
  def wfb-c-short(ctx) {
   let f = hw-option-floor-of(wfb-short());
   f[0] == 900000 && (String) f[1] == "the median of 3 measured";
  }
  def wfb-c-room(ctx) = hw-room-at(7200000, 0, hw-option-floor-of(wfb-long()))[0];
  def wfb-c-empty(ctx) {
   let f = hw-option-floor-of("");
   f[0] == 1800000 && (String) f[1] == "no option measured yet";
  }
 }
 live-claims("walk-floor-band", 0, [["held", 1, 1, wfb-c-held], ["short", 2, 1, wfb-c-short], ["room", 4, 1, wfb-c-room], ["empty", 8, 1, wfb-c-empty]]);
}
