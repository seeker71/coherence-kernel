; Verdict 4095: valid admission, full scope, split declarations, focus,
; local scaffold, restoration, multi-region order, invalid references,
; duplicate ids, bounded control text, invalid coordinates, causal limits.
; preludes: form-stdlib/core.fk form-stdlib/declarative-attention.bml

(do
    (defn dab-fill (n) (if (eq n 0) "" (str_concat "x" (dab-fill (sub n 1)))))
    (let cfg (da-config 2 10 12 (list (list 1 2 6) (list 2 6 10))))
    (let initial (da-initial cfg))
    (let partial (da-feed-output initial "<focus magic_chunks=\"" cfg))
    (let focus (da-feed-output partial "2\">" cfg))
    (let local (da-feed-output focus "</focus><local>" cfg))
    (let restored (da-feed-output local "</local>" cfg))
    (let multi (da-feed-output initial "<focus magic_chunks=\"2,1\">" cfg))
    (let bad (da-feed-output focus "<focus magic_chunks=\"99\">" cfg))
    (let duplicate (da-feed-output focus "<focus magic_chunks=\"2,2\">" cfg))
    (let wide (da-feed-output focus (str_concat "<focus " (dab-fill 200)) cfg))
    (sum (list
        (if (not (nothing? cfg)) 1 0)
        (if (eq (da-attended initial 16) 16) 2 0)
        (if (and (eq (da-mode partial) 0) (gt (str_len (da-pending partial)) 0)) 4 0)
        (if (and (eq (da-attended focus 16) 12) (and (eq (da-visible focus 3 16) 0) (eq (da-visible focus 7 16) 1))) 8 0)
        (if (and (eq (da-attended local 16) 8) (and (eq (da-visible local 0 16) 1) (eq (da-visible local 11 16) 1))) 16 0)
        (if (and (eq (da-mode restored) 0) (eq (da-attended restored 16) 16)) 32 0)
        (if (and (eq (da-attended multi 16) 16) (eq (nth (nth (da-ranges multi) 1) 0) 2)) 64 0)
        (if (and (eq (da-mode bad) 0) (eq (da-refused bad) 1)) 128 0)
        (if (and (eq (da-mode duplicate) 0) (eq (da-refused duplicate) 1)) 256 0)
        (if (and (eq (da-mode wide) 0) (and (eq (da-refused wide) 1) (eq (str_len (da-pending wide)) 0))) 512 0)
        (if (and (nothing? (da-config 2 10 12 (list (list 1 1 6)))) (nothing? (da-config 2 10 12 (list (list 1 2 7) (list 2 6 10))))) 1024 0)
        (if (and (eq (da-visible focus 16 16) 0) (and (eq (da-visible focus -1 16) 0) (nothing? (da-attended focus 11)))) 2048 0))))
