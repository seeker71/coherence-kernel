//////////////////////////////////////////////////////////////////////
//
// bml-float-literal-fixture.bml
//
// Decimal float literals in every position the form.bml lowering carries
// an expression: a list element, a def body, a call argument, a negative,
// a nested list, a comparison, a block let, a class field default, an
// arithmetic operand. The int path sits beside them so the band can hold
// both. Read by tests/bml-float-literal-band.fk; running this unit alone
// answers the float list's length: 3.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    def bfl-floats() = list("x", 1.0, 0.5);
    def bfl-ints() = list("x", 1, 5);
    def bfl-half() = 0.5;
    def bfl-neg() = -2.25;
    def bfl-nested() = list(1, list(0.25, 0.75), "y");
    def bfl-pass(v) = v;
    def bfl-passed() = bfl-pass(0.5);
    def bfl-compare(v) = if eq(v, 1.5) then 1 else 0;
    def bfl-sum() = add(0.5, 0.25);
    def bfl-block() {
        let f = 3.75;
        f;
    }
    class BflHolder {
        field bfl-default = 0.125;
    }
    len(bfl-floats());
}
