; living-world-resonance-shape-band.fk -- infer without naming a domain.
; Verdict 1023 proves ten structural/evidence properties.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/tests/living-world-resonance-witness.fk

(do
    (let round (lwrw-base-round 2))
    (let world (lwt-round-world round))
    (let signature-a (lwr-signature-for (lwrw-correspondence-a)))
    (let signature-b (lwr-signature-for (lwrw-correspondence-b)))
    (let signature-c (lwr-signature-for (lwrw-correspondence-c)))
    (let template (lwr-signature-template signature-a))
    (let terms (lwr-template-items template))
    (let proposals (lwt-round-proposals round))
    (let proposal (lwrw-first-proposal round))
    (let candidate (lwrw-candidate proposal))
    (let mapping (lwo-emergent-shape candidate))
    (let uncertainty (lwr-mapping-uncertainty mapping))

    (let c1 (if (and (eq (lwo-field-size (lwo-world-cells world)) 3)
                         (eq (lwo-field-size
                                (lwo-world-attributions world)) 3)) 1 0))
    (let c2 (if (and (not (node_eq (node_category (lwrw-left-a))
                                             (node_category (lwrw-right-a))))
                         (not (node_eq (lwrw-left-a) (lwrw-right-a)))) 2 0))
    (let c3 (if (and (node_eq signature-a signature-b)
                         (not (node_eq signature-a signature-c))) 4 0))
    (let c4 (if (and (eq (lwr-slot-index (nth terms 0)) 1)
                         (and (eq (lwr-slot-index (nth terms 1)) 0)
                              (node_eq (lwr-constant-value (nth terms 2))
                                       (lwrw-marker)))) 8 0))
    (let c5 (if (and (eq (lwo-field-size proposals) 1)
                         (eq (lwr-mapping? mapping) 1)) 16 0))
    (let c6 (if (and (eq (lwo-field-size
                              (lwr-mapping-supports mapping)) 2)
                         (eq (lwo-field-size
                              (lwr-mapping-counterexamples mapping)) 1)) 32 0))
    (let c7 (if (and (eq (lwr-uncertainty-counterexamples uncertainty) 1)
                         (and (eq (lwr-uncertainty-ambiguous uncertainty) 0)
                              (eq (lwr-uncertainty-unused-source uncertainty) 0))) 64 0))
    (let c8 (if (and (eq (lwo-field-size
                              (lwt-proposal-participants proposal)) 3)
                         (eq (lwo-field-size
                              (lwo-emergent-witnesses candidate)) 3)) 128 0))
    (let c9 (if (and (eq (lwo-emergent-ready? world candidate) 1)
                         (eq (lwo-world-has? world candidate) 0)) 256 0))
    (let high-round (lwrw-base-round 3))
    (let c10 (if (eq (lwo-field-size
                          (lwt-round-proposals high-round)) 0) 512 0))
    (lwrw-sum (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10)))
