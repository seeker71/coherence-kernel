; living-world-recipe-hypothesis-field-band.fk -- examples grow plural Recipes.
; Verdict 32767 proves fifteen generation, plurality, and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk

(defn lwphfb-has-source? (items source)
    (if (eq (len items) 0) 0
        (if (str_eq
                (lwre-recipe-source
                    (lwph-hypothesis-recipe (head items))) source) 1
            (lwphfb-has-source? (tail items) source))))
(defn lwphfb-all-state? (items state)
    (if (eq (len items) 0) 1
        (if (node_eq (lwph-hypothesis-state (head items)) state)
            (lwphfb-all-state? (tail items) state) 0)))

(do
    (let world (lwphw-training-world))
    (let enquiry (lwphw-enquiry))
    (let field (lwph-field-for world enquiry 2))
    (let fixture (lwphw-integrated-field))
    (let candidate (lwphw-field-candidate fixture))
    (let integrated-world (lwt-round-world (lwphw-field-round fixture)))
    (let hypotheses (lwph-field-hypotheses field))
    (let consistent (lwph-field-consistent field))
    (let refuted (lwph-field-refuted field))
    (let threshold-three (lwph-field-for world enquiry 3))
    (let unsafe-operator
        (lwph-operator enquiry "add) (mul left right)" (lwphw-evidence)))
    (let revoked (lwphw-revoked-add-world fixture))
    (let successor (lwph-field-for revoked enquiry 2))

    (let c1
        (if (and (eq (lwph-enquiry-current? world enquiry) 1)
                 (and (eq (lwo-field-size
                              (lwph-operators-for world enquiry 2)) 3)
                      (and (eq (lwo-field-size
                                  (lwph-examples-for world enquiry 2)) 1)
                           (eq (lwph-operator-valid?
                                  unsafe-operator) 0)))) 1 0))
    (let c2
        (if (and (eq (lwre-bindings-current?
                         world (lwphw-train-bindings)) 1)
                 (and (eq (lwre-projection-current?
                              world (lwphw-train-left-projection)) 1)
                      (eq (lwre-projection-current?
                              world (lwphw-train-right-projection)) 1))) 2 0))
    (let c3
        (if (and (eq (lwo-active? world (intern_trivial_int 2)) 0)
                 (and (node_eq
                        (lwre-binding-value
                            (head (lwre-binding-items
                                (lwphw-train-bindings))))
                        (intern_trivial_int 2))
                      (eq (lwph-example-scored? (lwphw-example)) 1))) 4 0))
    (let c4
        (if (and (eq (lwph-plural? (lwph-field-status field)) 1)
                 (and (eq (lwo-field-size hypotheses) 6)
                      (and (eq (lwo-field-size consistent) 4)
                           (eq (lwo-field-size refuted) 2)))) 8 0))
    (let c5
        (if (and (eq (lwo-field-size
                         (lwph-field-unresolved field)) 0)
                 (and (eq (lwphfb-all-state?
                              (lwo-field-items consistent)
                              (lwph-consistent)) 1)
                      (eq (lwphfb-all-state?
                              (lwo-field-items refuted)
                              (lwph-divergent)) 1))) 16 0))
    (let c6
        (if (and (eq (lwphfb-has-source?
                         (lwo-field-items consistent)
                         "(add left right)") 1)
                 (and (eq (lwphfb-has-source?
                              (lwo-field-items consistent)
                              "(add right left)") 1)
                      (and (eq (lwphfb-has-source?
                                  (lwo-field-items consistent)
                                  "(mul left right)") 1)
                           (eq (lwphfb-has-source?
                                  (lwo-field-items consistent)
                                  "(mul right left)") 1)))) 32 0))
    (let c7
        (if (and (eq (lwphfb-has-source?
                         (lwo-field-items refuted)
                         "(sub left right)") 1)
                 (eq (lwphfb-has-source?
                         (lwo-field-items refuted)
                         "(sub right left)") 1)) 64 0))
    (let c8
        (if (and (eq (lwo-field-size
                         (lwph-field-alternatives field)) 7)
                 (and (eq (lwo-field-has?
                              (lwph-field-alternatives field)
                              (lwphw-alternative)) 1)
                      (gt (lwo-field-size
                              (lwph-field-unknowns field)) 0))) 128 0))
    (let c9
        (if (and (not (node_eq
                         (head (lwo-field-items consistent))
                         (head (tail (lwo-field-items consistent)))))
                 (node_eq field (lwph-field-for world enquiry 2))) 256 0))
    (let c10
        (if (and (eq (lwt-proposal? (lwphw-field-proposal fixture)) 1)
                 (eq (lwo-field-size
                         (lwt-proposal-participants
                            (lwphw-field-proposal fixture))) 10)) 512 0))
    (let c11
        (if (and (eq (lwo-active? integrated-world candidate) 1)
                 (eq (lwph-integrated-current?
                         integrated-world candidate) 1)) 1024 0))
    (let c12
        (if (and (eq (lwo-field-size
                         (lwph-field-witness-field field)) 26)
                 (eq (lwo-field-size
                         (lwo-emergent-witnesses candidate)) 26)) 2048 0))
    (let c13
        (if (and (eq (lwo-field-size
                         (lwph-field-hypotheses threshold-three)) 0)
                 (node_eq (lwph-proposal world enquiry 3) (lwo-none))) 4096 0))
    (let c14
        (if (and (eq (lwph-integrated-current? revoked candidate) 0)
                 (and (eq (lwo-field-size
                              (lwph-field-operators successor)) 2)
                      (and (eq (lwo-field-size
                                  (lwph-field-hypotheses successor)) 4)
                           (eq (lwo-field-size
                                  (lwph-field-consistent successor)) 2))))
            8192 0))
    (let c15
        (if (and (eq (lwo-field-size
                         (lwph-field-refuted successor)) 2)
                 (and (eq (lwph-plural?
                              (lwph-field-status successor)) 1)
                      (eq (lwo-field-has?
                              (lwph-field-alternatives successor)
                              (lwphw-alternative)) 1))) 16384 0))
    (add c1 (add c2 (add c3 (add c4 (add c5
      (add c6 (add c7 (add c8 (add c9 (add c10
        (add c11 (add c12 (add c13 (add c14 c15)))))))))))))))
