; Privacy-safe branch-continuity observation: counts, state bits, and authority.
; No payload surface or response content is emitted.
; witnessed: 2026-08-08 -> exact aggregate vector on direct-source fkwu
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-continuity-branch.fk form-stdlib/tests/living-world-continuity-branch-witness.fk

(do
    (let historical (lwcbw-historical-world))
    (let image (lwcbw-image))
    (let branch-a (lwcbw-branch-a))
    (let branch-b (lwcbw-branch-b))
    (let context-a (lwcb-branch-context branch-a))
    (let context-b (lwcb-branch-context branch-b))
    (let projected-a (lwcp-context-world context-a))
    (let projected-b (lwcp-context-world context-b))
    (let admission (lwcbw-admission-world))
    (let proposal-a (lwcbw-proposal-a))
    (let proposal-b (lwcbw-proposal-b))
    (let candidate-a (lwt-proposal-candidate proposal-a))
    (let candidate-b (lwt-proposal-candidate proposal-b))
    (let response-world (lwcbw-response-world))
    (let outcome-a (lwt-evaluate-proposal response-world proposal-a))
    (let outcome-b (lwt-evaluate-proposal response-world proposal-b))
    (let after-a (lwcbw-after-a-world))
    (let after-waiting-b (lwcbw-after-waiting-b-world))
    (let dissent-world (lwcbw-dissent-world))
    (let dissent-outcome
        (lwt-evaluate-proposal dissent-world proposal-b))
    (let after-dissent-b (lwcbw-after-dissent-b-world))
    (let revised-world (lwcbw-revised-b-world))
    (let revised-outcome
        (lwt-evaluate-proposal revised-world proposal-b))
    (let restored (lwcbw-restored-world))
    (let cross-revoked (lwcbw-after-cross-revocation))
    (let local-revoked (lwcbw-after-local-revocation))
    (list
        ; One image has two active historical sources.  Each exact context is
        ; valid, nonempty, and governed by only its own source.
        (list
            (lwcn-image-valid? image)
            (lwo-field-size (lwcn-active-sources historical))
            (lwcb-branch-valid? branch-a)
            (lwo-field-size (lwo-world-cells projected-a))
            (lwo-field-size (lwcn-active-sources projected-a))
            (lwo-field-size (lwcb-branch-participants branch-a))
            (lwcb-branch-valid? branch-b)
            (lwo-field-size (lwo-world-cells projected-b))
            (lwo-field-size (lwcn-active-sources projected-b))
            (lwo-field-size (lwcb-branch-participants branch-b)))
        ; Exact branch offers produce distinct current candidates.  Branch A
        ; keeps every descriptive option absent; B retains each offered layer.
        (list
            (if (node_eq proposal-a (lwo-none)) 0 1)
            (if (node_eq proposal-b (lwo-none)) 0 1)
            (if (node_eq candidate-a candidate-b) 0 1)
            (lwcb-restore-current? admission candidate-a)
            (lwcb-restore-current? admission candidate-b)
            (lwo-field-size
                (lwcb-restore-grant-evidence
                    (lwo-emergent-shape candidate-a)))
            (lwo-field-size
                (lwcb-restore-grant-evidence
                    (lwo-emergent-shape candidate-b)))
            (if (node_eq (lwcb-branch-declaration branch-a)
                    (lwo-none)) 1 0)
            (if (node_eq (lwcb-branch-lens branch-a)
                    (lwo-none)) 1 0)
            (lwo-field-size (lwcb-branch-alternatives branch-a))
            (if (node_eq (lwcb-branch-unknowable branch-a)
                    (lwo-none)) 1 0)
            (node_eq (lwcb-branch-declaration branch-b)
                (lwcbw-declaration-b))
            (node_eq (lwcb-branch-lens branch-b) (lwcbw-lens-b))
            (lwo-field-size (lwcb-branch-alternatives branch-b))
            (node_eq (lwcb-branch-unknowable branch-b)
                (lwcbw-unknown-b)))
        ; Both proposals retain two active response derivations, including one
        ; off-scope source.  Only the named participant affects each outcome.
        (list
            (lwo-field-size
                (lwt-response-derivations response-world proposal-a))
            (lwt-outcome-yes outcome-a)
            (lwt-outcome-no outcome-a)
            (lwt-outcome-silence outcome-a)
            (lwt-outcome-missing outcome-a)
            (node_eq (lwt-outcome-status outcome-a)
                (lwt-status-acknowledged))
            (lwo-field-size
                (lwt-response-derivations response-world proposal-b))
            (lwt-outcome-yes outcome-b)
            (lwt-outcome-no outcome-b)
            (lwt-outcome-silence outcome-b)
            (lwt-outcome-missing outcome-b)
            (node_eq (lwt-outcome-status outcome-b)
                (lwt-status-waiting)))
        ; A restores while B waits.  Stored capability/grant control tissue is
        ; not imported, and attempting B changes no world identity.
        (list
            (lwo-active? after-a (lwcbw-payload-a))
            (lwo-active? after-a (lwcbw-payload-b))
            (lwo-world-has? after-a (lwcbw-capability-a))
            (lwo-world-has? after-a (lwcbw-grant-a))
            (lwcb-restored? after-a candidate-a)
            (lwcb-restored? after-a candidate-b)
            (node_eq after-a after-waiting-b))
        ; B may dissent without touching A.  The failed integration leaves the
        ; world exact and B remains absent.
        (list
            (lwt-outcome-no dissent-outcome)
            (node_eq (lwt-outcome-status dissent-outcome)
                (lwt-status-dissented))
            (lwo-active? after-dissent-b (lwcbw-payload-a))
            (lwo-active? after-dissent-b (lwcbw-payload-b))
            (node_eq after-dissent-b after-waiting-b))
        ; After B revokes only its dissent and adds ONE, its earlier NOTHING
        ; stays as history but ONE authorizes its own branch.
        (list
            (lwt-outcome-yes revised-outcome)
            (lwt-outcome-no revised-outcome)
            (lwt-outcome-silence revised-outcome)
            (lwt-outcome-missing revised-outcome)
            (node_eq (lwt-outcome-status revised-outcome)
                (lwt-status-acknowledged))
            (lwo-active? restored (lwcbw-payload-a))
            (lwo-active? restored (lwcbw-payload-b))
            (lwo-world-has? restored (lwcbw-capability-b))
            (lwo-world-has? restored (lwcbw-grant-b))
            (lwcb-restored? restored candidate-a)
            (lwcb-restored? restored candidate-b))
        ; A cannot revoke B.  B can revoke only its own attribution; A and all
        ; historical cells remain reachable.
        (list
            (lwo-active? cross-revoked (lwcbw-payload-a))
            (lwo-active? cross-revoked (lwcbw-payload-b))
            (lwo-field-size (lwo-world-revocations cross-revoked))
            (lwo-active? local-revoked (lwcbw-payload-a))
            (lwo-active? local-revoked (lwcbw-payload-b))
            (lwo-world-has? local-revoked (lwcbw-payload-a))
            (lwo-world-has? local-revoked (lwcbw-payload-b)))))
