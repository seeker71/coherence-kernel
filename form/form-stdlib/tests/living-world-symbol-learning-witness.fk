; living-world-symbol-learning-witness.fk -- recurrence grows two surface cells.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk

(let LWSLW-SOURCE-A (bp "LWSLW-SOURCE-A"))
(let LWSLW-SOURCE-B (bp "LWSLW-SOURCE-B"))
(let LWSLW-SOURCE-C (bp "LWSLW-SOURCE-C"))
(let LWSLW-SOURCE-D (bp "LWSLW-SOURCE-D"))
(let LWSLW-SOURCE-E (bp "LWSLW-SOURCE-E"))
(let LWSLW-SOURCE-F (bp "LWSLW-SOURCE-F"))
(let LWSLW-PROV-A (bp "LWSLW-PROV-A"))
(let LWSLW-PROV-B (bp "LWSLW-PROV-B"))
(let LWSLW-PROV-C (bp "LWSLW-PROV-C"))
(let LWSLW-PROV-D (bp "LWSLW-PROV-D"))
(let LWSLW-PROV-E (bp "LWSLW-PROV-E"))
(let LWSLW-PROV-F (bp "LWSLW-PROV-F"))
(let LWSLW-ACTION (bp "LWSLW-ACTION"))
(let LWSLW-LENS (bp "LWSLW-LENS"))
(let LWSLW-EVIDENCE (bp "LWSLW-EVIDENCE"))

(defn lwslw-cell (kind) (intern_node kind (empty)))
(defn lwslw-source-a () (lwslw-cell LWSLW-SOURCE-A))
(defn lwslw-source-b () (lwslw-cell LWSLW-SOURCE-B))
(defn lwslw-source-c () (lwslw-cell LWSLW-SOURCE-C))
(defn lwslw-source-d () (lwslw-cell LWSLW-SOURCE-D))
(defn lwslw-source-e () (lwslw-cell LWSLW-SOURCE-E))
(defn lwslw-source-f () (lwslw-cell LWSLW-SOURCE-F))
(defn lwslw-prov-a () (lwslw-cell LWSLW-PROV-A))
(defn lwslw-prov-b () (lwslw-cell LWSLW-PROV-B))
(defn lwslw-prov-c () (lwslw-cell LWSLW-PROV-C))
(defn lwslw-prov-d () (lwslw-cell LWSLW-PROV-D))
(defn lwslw-prov-e () (lwslw-cell LWSLW-PROV-E))
(defn lwslw-prov-f () (lwslw-cell LWSLW-PROV-F))
(defn lwslw-action () (lwslw-cell LWSLW-ACTION))
(defn lwslw-lens () (lwslw-cell LWSLW-LENS))
(defn lwslw-evidence () (lwslw-cell LWSLW-EVIDENCE))
(defn lwslw-referent () (intern_trivial_int 49))

(defn lwslw-forty-support ()
    (lwsl-observation (lwslw-referent) 0 "forty"
        (lwslw-lens) (oac-one (lwslw-referent)) (lwslw-evidence)))
(defn lwslw-forty-alternative ()
    (lwsl-observation (lwslw-referent) 0 "fourty"
        (lwslw-lens) (oac-one (lwslw-referent)) (lwslw-evidence)))
(defn lwslw-forty-dissent ()
    (lwsl-observation (lwslw-referent) 0 "forty"
        (lwslw-lens) (oac-zero) (lwslw-evidence)))
(defn lwslw-forty-silence ()
    (lwsl-observation (lwslw-referent) 0 "forty"
        (lwslw-lens) (oac-nothing) (lwslw-evidence)))
(defn lwslw-nine-support ()
    (lwsl-observation (lwslw-referent) 1 "-nine"
        (lwslw-lens) (oac-one (lwslw-referent)) (lwslw-evidence)))
(defn lwslw-late-alternative ()
    (lwsl-observation (lwslw-referent) 0 "four tens and nine"
        (lwslw-lens)
        (oac-alternative-ack (lwslw-referent)
            (lwslw-referent) (lwslw-evidence))
        (lwslw-evidence)))

(defn lwslw-entry-for (source provenance payload)
    (lwt-entry
        (lwo-offer source (lwo-interface (list (lwslw-action)))
            1 payload provenance 1)
        (lwslw-action)))
(defn lwslw-entry-a (payload)
    (lwslw-entry-for (lwslw-source-a) (lwslw-prov-a) payload))
(defn lwslw-entry-b (payload)
    (lwslw-entry-for (lwslw-source-b) (lwslw-prov-b) payload))
(defn lwslw-entry-c (payload)
    (lwslw-entry-for (lwslw-source-c) (lwslw-prov-c) payload))
(defn lwslw-entry-d (payload)
    (lwslw-entry-for (lwslw-source-d) (lwslw-prov-d) payload))
(defn lwslw-entry-e (payload)
    (lwslw-entry-for (lwslw-source-e) (lwslw-prov-e) payload))
(defn lwslw-entry-f (payload)
    (lwslw-entry-for (lwslw-source-f) (lwslw-prov-f) payload))

(defn lwslw-observation-world-from (base)
    (lwt-receive-stream base
        (list
            (lwslw-entry-a (lwslw-forty-support))
            (lwslw-entry-b (lwslw-forty-support))
            (lwslw-entry-c (lwslw-forty-alternative))
            (lwslw-entry-d (lwslw-forty-dissent))
            (lwslw-entry-e (lwslw-forty-silence))
            (lwslw-entry-a (lwslw-nine-support))
            (lwslw-entry-b (lwslw-nine-support)))))
(defn lwslw-world () (lwslw-observation-world-from (lwo-empty-world)))

(defn lwslw-proposal-surface (proposal)
    (lwnv-symbol-surface
        (lwo-emergent-shape (lwt-proposal-candidate proposal))))
(defn lwslw-find-proposal-items (items surface)
    (if (eq (len items) 0) (lwo-none)
        (if (str_eq (lwslw-proposal-surface (head items)) surface)
            (head items)
            (lwslw-find-proposal-items (tail items) surface))))
(defn lwslw-find-proposal (proposals surface)
    (lwslw-find-proposal-items (lwo-field-items proposals) surface))

(defn lwslw-round-from (base)
    (do
        (let world (lwslw-observation-world-from base))
        (lwt-round world (lwsl-proposals world 2)
            (lwo-empty-field) (lwo-none))))
(defn lwslw-round () (lwslw-round-from (lwo-empty-world)))

(defn lwslw-response (source provenance proposal)
    (lwslw-entry-for source provenance
        (lwt-response proposal (oac-one proposal) provenance)))

(defn lwslw-yes-round-from (base)
    (do
        (let round (lwslw-round-from base))
        (let proposals (lwt-round-proposals round))
        (let forty (lwslw-find-proposal proposals "forty"))
        (let nine (lwslw-find-proposal proposals "-nine"))
        (lwt-round-receive round
            (list
                (lwslw-response (lwslw-source-a) (lwslw-prov-a) forty)
                (lwslw-response (lwslw-source-b) (lwslw-prov-b) forty)
                (lwslw-response (lwslw-source-c) (lwslw-prov-c) forty)
                (lwslw-response (lwslw-source-d) (lwslw-prov-d) forty)
                (lwslw-response (lwslw-source-e) (lwslw-prov-e) forty)
                (lwslw-response (lwslw-source-a) (lwslw-prov-a) nine)
                (lwslw-response (lwslw-source-b) (lwslw-prov-b) nine)))))

(defn lwslw-integrated-round-from (base)
    (do
        (let round (lwslw-yes-round-from base))
        (let proposals (lwt-round-proposals round))
        (let forty (lwslw-find-proposal proposals "forty"))
        (let nine (lwslw-find-proposal proposals "-nine"))
        (let first (lwsl-integrate round forty (lwslw-action)))
        (lwsl-integrate first nine (lwslw-action))))
(defn lwslw-integrated-round ()
    (lwslw-integrated-round-from (lwo-empty-world)))

(defn lwslw-revoked-world ()
    (lwt-receive-stream (lwslw-world)
        (list
            (lwslw-entry-a
                (lwo-revocation (lwslw-forty-support)
                    (lwslw-source-a) (lwslw-action) (lwslw-prov-a))))))

(defn lwslw-late-world ()
    (lwt-receive-stream (lwslw-world)
        (list (lwslw-entry-f (lwslw-late-alternative)))))

(defn lwslw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwslw-sum (tail items)))))
