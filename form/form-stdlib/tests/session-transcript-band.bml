; session-transcript-band.bml — the transcripts' root is read once and walked for every session a door asks after.
; preludes: form-stdlib/core.fk form-stdlib/bml/session-transcript.bml
; Verdict 15
;
; A scratch root under temp_dir stands in for <home>/.claude/projects: two project directories, the second
; holding one session's transcript, and a stray file beside them.
;     1  st-find-under finds a session's transcript in whichever directory holds it
;     2  a session no directory holds, and a root that does not stand, read "" (no transcript found)
;     4  an unknown home is no root: st-root-of reads nothing, st-dirs-at reads no directories, and st-find-under
;        over it reads ""
;     8  st-home-of an unknown home stops with its reason, never walks over nothing
section [form.bml] {
 class SessionTranscriptBand {
  def stb-claim(held, bit) = held ? bit : 0;
  def stb-score(root) {
   let a = fs_mkdir(root ++ "/proj-a");
   let b = fs_mkdir(root ++ "/proj-b");
   let t = write_file_text(root ++ "/proj-b/sess-1.jsonl", "{\"type\":\"user\"}\n");
   let stray = write_file_text(root ++ "/stray.txt", "x\n");
   let c1 = stb-claim((String) st-find-under(root, "sess-1") == root ++ "/proj-b/sess-1.jsonl", 1);
   let c2 = stb-claim(((String) st-find-under(root, "sess-2") == "") && ((String) st-find-under(root ++ "/no-such-root", "sess-1") == ""), 2);
   let c4 = stb-claim(nothing?(st-root-of(nothing())) && ((String) st-root-of("/h") == "/h/.claude/projects") && nil?(st-dirs-at(nothing())) && ((String) st-find-under(nothing(), "sess-1") == ""), 4);
   let stopped = try st-home-of(nothing()) else "stopped";
   let c8 = stb-claim(((String) stopped == "stopped") && ((String) st-home-of(root) == root), 8);
   print_str("session-transcript-band claims " ++ c1.str() ++ " " ++ c2.str() ++ " " ++ c4.str() ++ " " ++ c8.str());
   c1 + c2 + c4 + c8;
  }
  def stb-run() {
   let root = temp_dir() ++ "/session-transcript-band-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str();
   let made = fs_mkdir(root);
   let score = stb-score(root);
   let gone = fs_rmdir(root);
   score;
  }
 }
 stb-run();
}
