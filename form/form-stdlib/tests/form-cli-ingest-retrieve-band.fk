; form-cli-ingest-retrieve-band.fk — Form retrieves ingest laws from cells.
;
; Verdict 2047:
;   1..128  fir-check (three cells readable, phrases present, ONE cell, ge 3)
;   256     class descriptor FormIngestRetrieve minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;   1024    heed-shaped span (128 before, 768 long) holds the three phrases
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-ingest-retrieve.bml
; witnessed: 2026-08-26 -> 2047; three cells; heed-span 128/768 holds the phrases

(do
    (defn firb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn firb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (firb-has-name? (tail xs) name))))

    (let bits (fir-check))
    (let desc (FormIngestRetrieve))
    (let src (read_file "form/form-stdlib/bml/form-cli-ingest-retrieve.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormIngestRetrieve")
                     (and (eq (firb-has-name? (nth desc 2) "T") 1)
                          (and (eq (firb-has-name? (nth desc 3) "fir-retrieve") 1)
                               (eq (firb-has-name? (nth desc 4) "OneCell") 1))))
                256 0))
    (let b9 (if (and (eq (firb-has-str? src "package Form.cli.ingestretrieve") 1)
                     (and (eq (firb-has-str? src "interface IIngestRetrieve") 1)
                          (and (eq (firb-has-str? src "class FormIngestRetrieve") 1)
                               (and (eq (firb-has-str? src "const String OneCell") 1)
                                    (eq (firb-has-str? src "template RetrieveHit") 1)))))
                512 0))
    (let span (if (eq (fir-span-check) 7) 1024 0))
    (add bits (add b8 (add b9 span))))
