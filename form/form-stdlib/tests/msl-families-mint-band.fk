; preludes: form-stdlib/core.fk form-stdlib/tensor-ir.fk form-stdlib/jit-tensor-emit.fk form-stdlib/metal-door.fk
;
; msl-families-mint-band — every MSL family this body emits, asked of the silicon rather than of the
; emitter. This band exists because of what the emit bands could NOT see on 2026-09-09: eight of the
; fourteen families were refused by this host's Metal compiler, and every one of their emit bands read
; a green pinned verdict straight through the refusal. A band that compares bytes to bytes proves the
; text is stable; it cannot tell a kernel from a string, and stability over a string that is not a
; kernel is a proof of nothing wearing a proof's number. This is the missing half: mint each family,
; and let the handle answer.
;
; The cost is one compile per family per fresh host cache — the whole band is the price of a single
; cold `metal_pipeline` times fourteen, and the second run of the day is nearly free (row 1375,
; twoprice: this host hands back a compiled unit it has seen before).
;
; Verdict 32767 when every family is a kernel here:
;      1  matvec f32              128  ffn-fwd f32            (was refused: bare mem_flags)
;      2  matvec f16              256  mlp-train f32          (was refused: bare mem_flags)
;      4  affine-train f32        512  resid-train f32        (was refused: bare mem_flags)
;      8  attn-train f32         1024  llama-block-fwd        (was refused: undefined round)
;     16  block-fwd              2048  llama-block-fwd-causal (was refused: undefined round)
;     32  gqa-attn               4096  gqa-llama-blk-causal   (was refused: undefined round)
;                                8192  llama-decode-step      (was refused: undefined round)
;                               16384  gqa-llama-decode-step  (was refused: undefined round)
;
;    64  THE DOOR IS NOT LYING: a unit this host genuinely refuses still returns 0. Without this bit a
;        dead carrier — unlinked, or answering 0 for everything — would read as fourteen green mints,
;        since a refused compile and an absent Metal wear the same handle. The canary is a bare
;        `mem_flags::` barrier, the exact shape that refused eight families, paired with its `metal::`
;        twin: the refusal must still refuse AND the qualified form must still mint.
;
; Nothing here reads a number the emitted text computes — that is ffn-fwd-metal-live-band's work, and
; it covers one family so far. This band claims only that fourteen kernels exist on this silicon.
;
(do
    (defn mfm-bit (src name w) (if (gt (metal_pipeline src name) 0) w 0))

    (let b0 (mfm-bit (jte-matvec-msl-fmt "mfm_a" "f32") "mfm_a" 1))
    (let b1 (mfm-bit (jte-matvec-msl-fmt "mfm_b" "f16") "mfm_b" 2))
    (let b2 (mfm-bit (jte-affine-train-msl-fmt "mfm_c" "f32") "mfm_c" 4))
    (let b3 (mfm-bit (jte-attn-train-msl-fmt "mfm_d" "f32") "mfm_d" 8))
    (let b4 (mfm-bit (jte-block-fwd-msl "mfm_e") "mfm_e" 16))
    (let b5 (mfm-bit (jte-gqa-attn-msl "mfm_f") "mfm_f" 32))

    ; the canary, before the eight that were refused — so a dead door cannot pass this band
    (let bare "kernel void mfm_bare(device float* o [[buffer(0)]], uint t [[thread_position_in_threadgroup]]) { o[t] = 1.0f; threadgroup_barrier(mem_flags::mem_device); }")
    (let qual "kernel void mfm_qual(device float* o [[buffer(0)]], uint t [[thread_position_in_threadgroup]]) { o[t] = 1.0f; threadgroup_barrier(metal::mem_flags::mem_device); }")
    (let b6 (if (eq (metal_pipeline bare "mfm_bare") 0)
            (if (gt (metal_pipeline qual "mfm_qual") 0) 64 0) 0))

    (let b7  (mfm-bit (jte-mlp-fwd-msl-fmt "mfm_g" "f32") "mfm_g" 128))
    (let b8  (mfm-bit (jte-mlp-train-msl-fmt "mfm_h" "f32") "mfm_h" 256))
    (let b9  (mfm-bit (jte-resid-train-msl-fmt "mfm_i" "f32") "mfm_i" 512))
    (let b10 (mfm-bit (jte-llama-block-fwd-msl "mfm_j") "mfm_j" 1024))
    (let b11 (mfm-bit (jte-llama-block-fwd-causal-msl "mfm_k") "mfm_k" 2048))
    (let b12 (mfm-bit (jte-gqa-llama-block-fwd-causal-msl "mfm_l") "mfm_l" 4096))
    (let b13 (mfm-bit (jte-llama-block-decode-step-msl "mfm_m") "mfm_m" 8192))
    (let b14 (mfm-bit (jte-gqa-llama-block-decode-step-msl "mfm_n") "mfm_n" 16384))

    (add b0 (add b1 (add b2 (add b3 (add b4 (add b5 (add b6
    (add b7 (add b8 (add b9 (add b10 (add b11 (add b12 (add b13 b14)))))))))))))))
