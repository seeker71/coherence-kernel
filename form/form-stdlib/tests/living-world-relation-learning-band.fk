; living-world-relation-learning-band.fk -- recurrent relations become governed edges.
; Verdict 32767 proves fifteen optionality, uncertainty, and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-relation-learning.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk

(do
    (let world (lwrlw-world))
    (let evidence
        (lwrl-evidence-for world (lwrlw-relation)
            (lwrlw-left) (lwrlw-right)))
    (let round (lwrlw-round))
    (let proposals (lwt-round-proposals round))
    (let proposal
        (lwrlw-find-proposal proposals (lwrlw-left) (lwrlw-right)))
    (let inverse
        (lwrlw-find-proposal proposals (lwrlw-right) (lwrlw-left)))
    (let candidate (lwt-proposal-candidate proposal))
    (let edge (lwo-emergent-shape candidate))
    (let waiting (lwrl-integrate round proposal (lwslw-action)))
    (let integrated (lwrlw-integrated-round))
    (let integrated-world (lwt-round-world integrated))
    (let revoked (lwrlw-revoked-world))
    (let late (lwrlw-cycle-world))

    (let c1 (if (and (eq (lwrl-observation-valid?
                              (lwrlw-support-a)) 1)
                         (and (node_eq (lwrl-observation-lens
                                        (lwrlw-support-a)) (lwo-none))
                              (node_eq (lwrl-observation-unknown
                                        (lwrlw-support-a)) (lwo-none)))) 1 0))
    (let c2 (if (and (eq (lwrl-observation-valid?
                              (lwrlw-support-b)) 1)
                         (eq (lwlc-unknown?
                              (lwrl-observation-unknown
                                (lwrlw-support-b))) 1)) 2 0))
    (let c3 (if (eq (lwrl-support-count evidence) 2) 4 0))
    (let c4 (if (eq (lwrl-alternative-count evidence) 2) 8 0))
    (let c5 (if (and (eq (lwrl-dissent-count evidence) 1)
                         (and (eq (lwrl-silence-count evidence) 1)
                              (eq (lwrl-unresolved-count evidence) 1))) 16 0))
    (let c6 (if (and (eq (lwo-field-size proposals) 1)
                         (node_eq inverse (lwo-none))) 32 0))
    (let c7 (if (and (node_eq (lwrl-edge-relation edge)
                               (lwrlw-relation))
                         (and (node_eq (lwrl-edge-left edge) (lwrlw-left))
                              (node_eq (lwrl-edge-right edge)
                                       (lwrlw-right)))) 64 0))
    (let c8 (if (node_eq (lwrl-edge-evidence edge) evidence) 128 0))
    (let c9 (if (and (eq (lwo-field-size
                              (lwrl-witnesses evidence)) 7)
                         (eq (lwo-field-size
                              (lwt-proposal-participants proposal)) 7)) 256 0))
    (let c10 (if (eq (lwo-world-has?
                          (lwt-round-world waiting) candidate) 0) 512 0))
    (let c11 (if (eq (lwo-active?
                          integrated-world candidate) 1) 1024 0))
    (let c12 (if (eq (lwrl-integrated-current?
                          integrated-world candidate) 1) 2048 0))
    (let c13 (if (eq (lwrl-candidate-current?
                          revoked candidate) 0) 4096 0))
    (let c14 (if (eq (lwrl-candidate-current?
                          late candidate) 0) 8192 0))
    (let c15 (if (and (eq (lwrl-exact-direction?
                               (lwrlw-support-a) (lwrlw-relation)
                               (lwrlw-left) (lwrlw-right)) 1)
                          (eq (lwrl-inverse-direction?
                               (lwrlw-inverse-c) (lwrlw-relation)
                               (lwrlw-left) (lwrlw-right)) 1)) 16384 0))
    (lwrlw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
