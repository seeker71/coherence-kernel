; candidate-floor-band.bml — the resident witnesses another kernel through host-child.
; Expected: 32767
; Verdict 32767 when every claim lands:
;   1     full: ./fkwu answers a small pinned band, with its path, reading, pin and actual exit
;   2     short: a Form fixture answers 3 against 7, exit 0
;   4     stop: a Form fixture ends in form_error, with its actual nonzero exit
;   8     non-number: a clean child returning prose is stop, its last line retained
;   16    deadline: the child prints its entered marker then spins past two seconds, exit stays nothing
;   32    absence: no output/exit/pin stays nothing; an unpinned numeric answer is stop
;   64    comparison: signed and fractional numbers compare numerically; above-pin is stop
;   128   strict: malformed/nonobject/unknown/wrong-kind/duplicate requests refuse by name and exit 1
;   256   required: empty stdin and a missing fkwu key refuse by name and exit 1
;   512   executable: absent file, directory, non-executable file, owner-denied file and empty path refuse; a symlink reads
;   1024  deadline option: zero and negative deadlines refuse; the omitted allowance is the sweep's
;   2048  selection: ERE anchors/alternatives preserve sweep order, an empty selection refuses
;   4096  regex: malformed regex refuses before any child band
;   8192  child door: the real door-options band answers its pin and exactly one row and one summary, exit 0
;   16384 summary: all four classes counted and a short row retains its actual reading and exit
;
; REQUIRES: built ./fkwu, repository root, run ALONE. Fixtures are private Form sources,
; outside enumeration; they are removed only after every claim holds. Existing bands stay untouched.
// preludes: form-stdlib/bml/candidate-floor.bml form-stdlib/bml/live.bml
section [form.bml] {
 class CandidateFloorBand {
  def cfb-root(ctx) = ctx[1];
  def cfb-fixture(ctx, name, source) {
   let path = cfb-root(ctx) ++ "/" ++ name ++ ".fk";
   let wrote = write_file(path, source);
   [name, [path]];
  }
  def cfb-leg(ctx, name, source) = cfl-leg("./fkwu", cfb-fixture(ctx, name, source), 30, cfb-root(ctx), name);
  def cfb-has(text, part) = str_find(text, part, 0) >= 0;
  def cfb-door(ctx, name, input) = hch-run-in(cfb-root(ctx), name, ["./fkwu", "observe/candidate-floor-run.bml"], input, hch-by(60000));
  def cfb-refused(run, why) = !nothing?(run[0]) && run[0] == 1 && cfb-has(run[1], "candidate-floor: " ++ why)
   && !cfb-has(run[1], "candidate-floor fkwu=") && !cfb-has(run[1], "\tclass=");
  def cfb-input(path, extra) = "{\"fkwu\":" ++ json-emit-precise(json-node-string(path)) ++ extra ++ "}";
  def cfb-c-full(ctx) {
   let w = bsw-stdlib-one("binary-freshness-band.fk");
   let row = cfl-leg("./fkwu", w, 30, cfb-root(ctx), "full");
   row[0] == bsw-band-of(w) && row[1] == "31" && row[2] == 31 && row[3] == 0 && row[4] == "full";
  }
  def cfb-c-short(ctx) {
   let row = cfb-leg(ctx, "short", "; Verdict 7\n(do (print_str \"earlier\") 3)\n");
   row[0] == cfb-root(ctx) ++ "/short.fk" && row[1] == "3" && row[2] == 7 && row[3] == 0 && row[4] == "short";
  }
  def cfb-c-stop(ctx) {
   let row = cfb-leg(ctx, "stop", "; Verdict 7\n(form_error \"candidate-floor planted stop\")\n");
   !nothing?(row[3]) && row[3] == 1 && row[4] == "stop" && cfb-has(row[1], "candidate-floor planted stop");
  }
  def cfb-c-prose(ctx) {
   let row = cfb-leg(ctx, "prose", "; Verdict 7\n\"not a number\"\n");
   row[1] == "not a number" && row[3] == 0 && row[4] == "stop";
  }
  def cfb-c-deadline(ctx) {
   let w = cfb-fixture(ctx, "spin", "; Verdict 7\n(do (defn cfb-spin (n) (cfb-spin (add n 1))) (print_str \"candidate-floor entered spin\") (cfb-spin 0))\n");
   let start = host_monotonic_ms();
   let row = cfl-leg("./fkwu", w, 2, cfb-root(ctx), "spin");
   let elapsed = host_monotonic_ms() - start;
   row[1] == "candidate-floor entered spin" && row[2] == 7 && nothing?(row[3]) && row[4] == "deadline"
    && elapsed >= 2000 && elapsed < 30000
    && cfb-has(read_file(hch-exit-path(cfb-root(ctx), "spin")), "none deadline:");
  }
  def cfb-c-absence(ctx) {
   let absent = cfl-row("absent", nothing(), [nothing(), "", "birth refused: no exit"]);
   let unpinned = cfb-leg(ctx, "unpinned", "7\n");
   nothing?(absent[1]) && nothing?(absent[2]) && nothing?(absent[3]) && absent[4] == "stop"
    && nothing?(cfl-pin(cfb-root(ctx) ++ "/absent.fk")) && nothing?(unpinned[2]) && unpinned[1] == "7" && unpinned[4] == "stop"
    && cfl-line(absent) == "absent\treading=nothing\tpin=nothing\texit=nothing\tclass=stop";
  }
  def cfb-c-comparison(ctx) = cfl-class("7.0", 7, 0, "") == "full" && cfl-class("-1", 7, 0, "") == "short"
   && cfl-class("6.5", 7, 0, "") == "short" && cfl-class("8", 7, 0, "") == "stop"
   && cfl-class("7", 7, 1, "") == "stop" && cfl-class("7", 7, nothing(), "deadline: stopped") == "deadline"
   && cfl-class("7x", 7, 0, "") == "stop" && cfl-class("0", 0, 0, "") == "full";
  def cfb-c-strict(ctx) {
   let cases = [["{bad json", "stdin is not well-formed JSON"], ["{} trailing", "stdin is not well-formed JSON"], ["[]", "stdin must be one JSON object"],
    ["{\"fwku\":\"./fkwu\"}", "unknown key \"fwku\""], ["{\"fkwu\":1}", "key \"fkwu\" must be a string"],
    ["{\"fkwu\":\"./fkwu\",\"match\":1}", "key \"match\" must be a string"],
    ["{\"fkwu\":\"./fkwu\",\"deadline_s\":1.5}", "key \"deadline_s\" must be an integer"],
    ["{\"fkwu\":\"./fkwu\",\"fkwu\":\"./fkwu\"}", "key \"fkwu\" is given twice"]];
   all?(one => cfb-refused(cfb-door(ctx, "strict", one[0]), one[1]), cases);
  }
  def cfb-c-required(ctx) = cfb-refused(cfb-door(ctx, "empty", ""), "missing required key \"fkwu\"")
   && cfb-refused(cfb-door(ctx, "required", "{\"match\":\"door-options\"}"), "missing required key \"fkwu\"");
  def cfb-c-executable(ctx) {
   let file = cfb-fixture(ctx, "not-executable", "7\n")[1][0];
   let mode = host_chmod(file, 384);
   let link = cfb-root(ctx) ++ "/candidate link";
   let linked = host_symlink(host_realpath("./fkwu"), link);
   let denied = cfb-root(ctx) ++ "/owner-denied";
   let copied = host_file_copy("./fkwu", denied);
   let denied-mode = host_chmod(denied, 1);
   let denied-run = cfb-door(ctx, "owner-denied", cfb-input(denied, ",\"match\":\"door-options\""));
   mode == 0 && linked == 0 && cfl-executable?(link) && cfl-executable?("./fkwu")
    && copied > 0 && denied-mode == 0 && cfb-refused(denied-run, "fkwu is not an executable file for this process:")
    && all?(path => cfb-refused(cfb-door(ctx, "not-executable", cfb-input(path, "")), "fkwu is not an executable file:"), [file, cfb-root(ctx), cfb-root(ctx) ++ "/absent", ""]);
  }
  def cfb-c-seconds(ctx) = cfl-seconds(cfl-doc("{\"fkwu\":\"./fkwu\"}")) == bsw-ceiling-s()
   && all?(n => cfb-refused(cfb-door(ctx, "seconds", cfb-input("./fkwu", ",\"deadline_s\":" ++ n.str())), "deadline_s must be a positive integer"), [0, 0 - 1]);
  def cfb-c-selection(ctx) {
   let all = bsw-all();
   let selected = cfl-select(all, "^form/form-stdlib/tests/(door-options|candidate-floor)-band[.]bml$");
   let expected = filter(w => bsw-band-of(w) == "form/form-stdlib/tests/door-options-band.bml" || bsw-band-of(w) == "form/form-stdlib/tests/candidate-floor-band.bml", all);
   len(selected) == 2 && map(w => bsw-band-of(w), selected) == map(w => bsw-band-of(w), expected)
    && len(cfl-select(all, "")) == len(all)
    && cfb-refused(cfb-door(ctx, "no-match", cfb-input("./fkwu", ",\"match\":\"^no-such-candidate-floor-band$\"")), "match selects no band:");
  }
  def cfb-c-regex(ctx) = cfb-refused(cfb-door(ctx, "regex", cfb-input("./fkwu", ",\"match\":\"[\"")), "match does not read:");
  def cfb-c-door(ctx) {
   let run = cfb-door(ctx, "door", cfb-input(cfb-root(ctx) ++ "/candidate link", ",\"match\":\"^form/form-stdlib/tests/door-options-band[.]bml$\",\"deadline_s\":30"));
   let summary = cfl-summary(cfb-root(ctx) ++ "/candidate link", 1, [1, 0, 0, 0]);
   run[0] == 0 && run[1] == "form/form-stdlib/tests/door-options-band.bml\treading=1023\tpin=1023\texit=0\tclass=full\n" ++ summary ++ "\n";
  }
  def cfb-c-summary(ctx) {
   let counts = foldl((counts, kind) => cfl-counts(counts, kind), [0, 0, 0, 0], ["full", "short", "stop", "deadline", "short"]);
   cfl-summary("./fkwu", 5, counts) == "candidate-floor fkwu=./fkwu bands=5 full=1 short=2 stop=1 deadline=1"
    && cfl-line(["a", "3", 7, 0, "short"]) == "a\treading=3\tpin=7\texit=0\tclass=short";
  }
 }
 let ctx = ["candidate-floor", ".hearth/candidate-floor-band-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str(), 0];
 let made = host_dir_mkdir(cfb-root(ctx));
 made != 1 ? form_error("candidate-floor band needs a fresh fixture directory") : 0;
 let verdict = live-claims("candidate-floor-band", ctx, [["full", 1, 1, cfb-c-full], ["short", 2, 1, cfb-c-short], ["stop", 4, 1, cfb-c-stop], ["non-number", 8, 1, cfb-c-prose], ["deadline", 16, 1, cfb-c-deadline], ["absence", 32, 1, cfb-c-absence], ["comparison", 64, 1, cfb-c-comparison], ["strict", 128, 1, cfb-c-strict], ["required", 256, 1, cfb-c-required], ["executable", 512, 1, cfb-c-executable], ["seconds", 1024, 1, cfb-c-seconds], ["selection", 2048, 1, cfb-c-selection], ["regex", 4096, 1, cfb-c-regex], ["door", 8192, 1, cfb-c-door], ["summary", 16384, 1, cfb-c-summary]]);
 verdict == 32767 ? host_dir_rmdir(cfb-root(ctx)) : print_str("candidate-floor band evidence=" ++ cfb-root(ctx));
 verdict;
}
