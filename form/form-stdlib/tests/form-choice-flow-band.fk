; form-choice-flow-band.fk — a choice point is a cell with a ledger, a sequence
; plays at its narrowest gate, and the body says which gaps to nourish and which
; wounds to heal.
;
; Four shapes, each one the body actually has:
;   jit.crystallize  — a real choice with all three outcomes on it
;   ice.load         — one way through: a corridor wearing a choice's name
;   model.route      — two options nobody has ever been offered
;   governor.admit   — a choice that closes four times for every once it opens
;
; The three outcomes are the body's own (choice-receipt.fk): success, fail, and
; SILENCE — the held offer of core-axioms.form, which is not a refusal. A held
; offer whose wait is falling is ripening and wants nourishing; one whose wait
; is not falling is stalled and wants healing. That difference is the whole
; reason silence is counted apart from a decline.
;
; And a held offer that nothing TIMES is neither: it is unclocked, a gap asking
; for the clock. Answering "stalled" there would be a claim about a wait that
; was never taken.
;
; Expected: 8191
; preludes: form/form-stdlib/form-choice-flow.bml

(do
    (defn fcb-bit (ok bit) (if ok bit 0))
    (defn fcb-note-many (p outcome wait n) (if (eq n 0) p (fcb-note-many (fcf-point-note p outcome wait) outcome wait (sub n 1))))
    (defn fcb-kind? (fs kind pointId)
        (if (eq (len fs) 0) 0
            (if (and (str_eq (fcf-finding-kind (head fs)) kind) (str_eq (fcf-finding-point (head fs)) pointId)) 1
                (fcb-kind? (tail fs) kind pointId))))

    (let crystallize (fcf-option "crystallize" "emit an arm64 leaf for this body" 3 9 8 7))
    (let walk (fcf-option "walk" "keep the tree walk" 1 2 5 9))
    (let jit0 (fcf-point "jit.crystallize" "crystallize this defn or walk it?" (list crystallize walk) (fcf-ledger-empty)))
    (let jit1 (fcb-note-many jit0 (cr-outcome-success) 2 7))
    (let jit2 (fcb-note-many jit1 (cr-outcome-fail) 5 3))
    (let jit (fcb-note-many jit2 (cr-outcome-silence) 9 2))

    (let corridor (fcf-point "ice.load" "load the ice?" (list (fcf-option "load" "load it" 1 5 6 6)) (fcf-ledger-empty)))
    (let dark (fcf-point "model.route" "which model answers?"
        (list (fcf-option "local" "local model" 2 7 7 6) (fcf-option "rented" "rented mind" 9 8 4 5)) (fcf-ledger-empty)))
    (let w0 (fcf-point "governor.admit" "admit this work?"
        (list (fcf-option "admit" "let it run" 2 8 7 7) (fcf-option "hold" "wait for room" 1 3 6 8)) (fcf-ledger-empty)))
    (let w1 (fcb-note-many w0 (cr-outcome-fail) 40 9))
    (let wound (fcb-note-many w1 (cr-outcome-success) 3 2))

    ; a held offer whose latest wait is under its own mean: ripening, not stalled
    (let r0 (fcf-point "breath.hold" "wait for the room to quiet?" (list (fcf-option "wait" "hold the offer" 1 6 7 8) (fcf-option "speak" "answer now" 3 4 5 5)) (fcf-ledger-empty)))
    (let r1 (fcb-note-many r0 (cr-outcome-silence) 900 3))
    (let ripening (fcf-point-note r1 (cr-outcome-silence) 1))

    ; a held offer whose wait is clocked and NOT falling: stalled, truly
    (let s0 (fcf-point "breath.stall" "wait for the room to quiet?" (list (fcf-option "wait" "hold the offer" 1 6 7 8) (fcf-option "speak" "answer now" 3 4 5 5)) (fcf-ledger-empty)))
    (let stalled (fcb-note-many s0 (cr-outcome-silence) 5 4))
    ; a held offer nothing times at all: not stalled, unclocked
    (let u0 (fcf-point "breath.unclocked" "wait for the room to quiet?" (list (fcf-option "wait" "hold the offer" 1 6 7 8) (fcf-option "speak" "answer now" 3 4 5 5)) (fcf-ledger-empty)))
    (let unclocked (fcb-note-many u0 (cr-outcome-silence) 0 4))

    (let points (list jit corridor dark wound))
    (let play (fcf-play points))
    (let findings (fcf-play-findings play))
    (let next (fcf-next-choice points (list)))

    ; the ledger holds all three outcomes apart
    (let b0 (fcb-bit (and (eq (fcf-ledger-offered (fcf-point-ledger jit)) 12)
                     (and (eq (fcf-ledger-taken (fcf-point-ledger jit)) 7)
                     (and (eq (fcf-ledger-declined (fcf-point-ledger jit)) 3)
                          (eq (fcf-ledger-held (fcf-point-ledger jit)) 2)))) 1))
    ; flow, restriction and holding are shares of the offers, and they are whole
    (let b1 (fcb-bit (and (eq (fcf-flow jit) 58) (and (eq (fcf-restriction jit) 25) (eq (fcf-holding jit) 16))) 2))
    ; a point never offered reads -1, never 0: no reading is not no flow
    (let b2 (fcb-bit (and (eq (fcf-flow dark) (sub 0 1)) (eq (fcf-restriction dark) (sub 0 1))) 4))
    ; a corridor is not a choice
    (let b3 (fcb-bit (and (eq (fcf-corridor? corridor) 1) (eq (fcf-corridor? jit) 0)) 8))
    ; a choice that closes more than it opens is a wound, and a dark one is not
    (let b4 (fcb-bit (and (eq (fcf-restricting? wound) 1) (and (eq (fcf-restricting? jit) 0) (eq (fcf-restricting? dark) 0))) 16))
    ; the wound's own numbers
    (let b5 (fcb-bit (and (eq (fcf-flow wound) 18) (eq (fcf-restriction wound) 81)) 32))
    ; a sequence plays at its NARROWEST gate, never its average
    (let b6 (fcb-bit (and (eq (fcf-play-flow play) 18) (str_eq (fcf-play-narrowest play) "governor.admit")) 64))
    ; every step names the option worth the most at its point
    (let b7 (fcb-bit (and (eq (len (fcf-play-steps play)) 4)
                          (str_eq (fcf-step-option (head (fcf-play-steps play))) "crystallize")) 128))
    ; gaps and wounds are told apart, and each asks for something
    (let b8 (fcb-bit (and (eq (fcb-kind? findings "gap-corridor" "ice.load") 1)
                     (and (eq (fcb-kind? findings "gap-dark" "model.route") 1)
                     (and (eq (fcb-kind? findings "wound-restricting" "governor.admit") 1)
                          (eq (fcb-kind? findings "wound-restricting" "jit.crystallize") 0)))) 256))
    (let b9 (fcb-bit (gt (str_len (fcf-finding-asks (head findings))) 0) 512))
    ; a held offer whose wait is falling is ripening, and one whose wait is not is stalled
    (let b10 (fcb-bit (and (eq (fcf-ripening? ripening) 1) (eq (fcf-ripening? jit) 0)) 1024))
    ; the next choice worth offering is the one nobody has been able to make
    (let b11 (fcb-bit (str_eq (fcf-point-id next) "ice.load") 2048))
    ; a wait nobody clocked is no reading: a point that holds most of its offers
    ; and times none of them is unclocked, never stalled, and what it asks for is
    ; the clock. A point that DOES time them and whose clock is not falling is
    ; stalled, exactly as before.
    (let sf (fcf-point-findings stalled))
    (let uf (fcf-point-findings unclocked))
    (let b12 (fcb-bit (and (eq (fcf-wait-metered? stalled) 1)
                      (and (eq (fcf-wait-metered? unclocked) 0)
                      (and (eq (fcb-kind? sf "wound-stalled" "breath.stall") 1)
                      (and (eq (fcb-kind? sf "gap-unclocked" "breath.stall") 0)
                      (and (eq (fcb-kind? uf "gap-unclocked" "breath.unclocked") 1)
                      (and (eq (fcb-kind? uf "wound-stalled" "breath.unclocked") 0)
                           (eq (fcf-ripening? unclocked) 0))))))) 4096))

    (print (list "choice-flow" "jit" (fcf-flow jit) (fcf-restriction jit) (fcf-holding jit)
        "wound" (fcf-flow wound) (fcf-restriction wound)
        "play" (fcf-play-flow play) (fcf-play-narrowest play) "worth" (fcf-play-worth play)
        "findings" (len findings) "next" (fcf-point-id next)))
    (add b0 (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 (add b9 (add b10 (add b11 b12)))))))))))))
