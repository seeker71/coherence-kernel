; situated-witness-continuity-band.fk — prove that only complete,
; caller-keyed, unbroken endorsement chains reach situated authority.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/sha256.fk form-stdlib/hmac-sha256.fk form-stdlib/core-word-inquiry.fk form-stdlib/situated-lens-conclusion.fk form-stdlib/situated-evidence-authority.fk form-stdlib/situated-witness-continuity.fk
;
; Expected: 2147483647

(do
    (defn swcb-bit (condition bit)
        (if condition bit 0))
    (defn swcb-sum (values)
        (if (eq (len values) 0) 0
            (add (head values)
                (swcb-sum (tail values)))))
    (defn swcb-key-a ()
        (swc-string-bytes
            "0123456789abcdef0123456789abcdef"))
    (defn swcb-key-b ()
        (swc-string-bytes
            "abcdef0123456789abcdef0123456789"))
    (defn swcb-key-wrong ()
        (swc-string-bytes
            "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"))
    (defn swcb-key-c ()
        (swc-string-bytes
            "fedcba9876543210fedcba9876543210"))
    (defn swcb-replace-seal (entry seal)
        (swc-entry
            (swc-e-witness entry)
            (swc-e-key-id entry)
            (swc-e-epoch entry)
            (swc-e-sequence entry)
            (swc-e-predecessor entry)
            (swc-e-endorsement entry)
            seal))

    (let lens (cwi-lens 1 2 3 4))
    (let offered (slc-observation 10 lens 1 6 9001))
    (let policy (sea-policy (list 7001 7002) 2 3))
    (let binding-a (swc-binding 7001 8001 1 (swcb-key-a)))
    (let binding-b (swc-binding 7002 8002 1 (swcb-key-b)))
    (let bindings (list binding-a binding-b))
    (let endorsement-a
        (sea-endorsement 7001 9001 10 lens 1 6 11))
    (let endorsement-b
        (sea-endorsement 7002 9001 10 lens 1 6 12))
    (let entry-a
        (swc-seal-entry binding-a 0
            (swc-root-predecessor) endorsement-a))
    (let entry-b
        (swc-seal-entry binding-b 0
            (swc-root-predecessor) endorsement-b))
    (let admitted
        (swc-admit offered
            (list entry-a entry-b)
            bindings policy 13))

    (let continuation-endorsement
        (sea-endorsement 7001 9001 10 lens 1 6 12))
    (let continuation
        (swc-seal-entry binding-a 1
            (swc-e-seal entry-a)
            continuation-endorsement))
    (let continued
        (swc-verify
            (list entry-a continuation)
            (list binding-a)))
    (let gap
        (swc-seal-entry binding-a 2
            (swc-e-seal entry-a)
            continuation-endorsement))
    (let fork
        (swc-seal-entry binding-a 0
            (swc-root-predecessor)
            continuation-endorsement))

    (let tampered-endorsement
        (sea-endorsement 7001 9001 10
            (cwi-lens 1 2 3 5) 1 6 11))
    (let tampered-entry
        (swc-entry 7001 8001 1 0
            (swc-root-predecessor)
            tampered-endorsement
            (swc-e-seal entry-a)))
    (let tampered-candidate
        (swc-entry 7001 8001 1 0
            (swc-root-predecessor)
            (sea-endorsement 7001 9001 10 lens 0 6 11)
            (swc-e-seal entry-a)))
    (let wrong-key-binding
        (swc-binding 7001 8001 1
            (swcb-key-wrong)))
    (let missing-binding
        (swc-verify (list entry-a) (list binding-b)))
    (let duplicate-binding
        (swc-verify (list entry-a)
            (list binding-a binding-a)))
    (let relabeled-shared-secret
        (swc-binding 7002 8002 1
            (swcb-key-a)))
    (let short-key-binding
        (swc-binding 7001 8001 1
            (swc-string-bytes "short")))
    (let malformed-seal
        (swcb-replace-seal entry-a
            "hmac-sha256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"))
    (let wrong-root
        (swc-entry 7001 8001 1 0
            (swc-e-seal entry-a)
            endorsement-a
            (swc-e-seal entry-a)))
    (let wrong-predecessor
        (swc-seal-entry binding-a 1
            (swc-e-seal entry-b)
            continuation-endorsement))

    (let stale-endorsement
        (sea-endorsement 7002 9001 10 lens 1 6 8))
    (let stale-entry
        (swc-seal-entry binding-b 0
            (swc-root-predecessor)
            stale-endorsement))
    (let stale-outcome
        (swc-admit offered
            (list entry-a stale-entry)
            bindings policy 13))
    (let contradicting-endorsement
        (sea-endorsement 7001 9001 10 lens 0 6 13))
    (let contradiction
        (swc-seal-entry binding-a 1
            (swc-e-seal entry-a)
            contradicting-endorsement))
    (let equivocation-outcome
        (swc-admit offered
            (list entry-a entry-b contradiction)
            bindings policy 13))
    ; A new epoch has a new key and a new root. This proves local continuity
    ; only; it is deliberately not a cross-epoch rotation/delegation proof.
    (let epoch-two-binding
        (swc-binding 7001 8003 2 (swcb-key-c)))
    (let epoch-two-entry
        (swc-seal-entry epoch-two-binding 0
            (swc-root-predecessor)
            continuation-endorsement))
    (let epoch-two-verification
        (swc-verify
            (list entry-a epoch-two-entry)
            (list binding-a epoch-two-binding)))

    ; 2147483647 means all 31 observations held.
    (swcb-sum
        (list
            (swcb-bit
                (eq (swc-binding-valid? binding-a) 1) 1)
            (swcb-bit
                (eq (swc-bindings-valid? bindings) 1) 2)
            (swcb-bit
                (and
                    (str_eq
                        (swc-entry-message entry-a)
                        "30:situated-witness-continuity-v14:70014:80011:11:04:root4:70014:90012:101:11:21:31:41:11:62:11")
                    (not (str_eq
                        (swc-fields (list "ab" "c"))
                        (swc-fields (list "a" "bc")))))
                4)
            (swcb-bit
                (str_eq
                    (swc-e-seal entry-a)
                    "hmac-sha256:6959cf9e750de2f443dd8670034216633326e0d2efbe9fc35cf291be12475ec0")
                8)
            (swcb-bit
                (eq (swc-canonical-seal?
                    (swc-e-seal entry-a)) 1) 16)
            (swcb-bit
                (eq (swc-v-status
                    (swc-verify
                        (list entry-a) (list binding-a))) 0) 32)
            (swcb-bit
                (eq (swc-o-admitted admitted) 1) 64)
            (swcb-bit
                (eq (swc-o-status admitted) 0) 128)
            (swcb-bit
                (eq (swc-o-verified-count admitted) 2) 256)
            (swcb-bit
                (eq (sea-o-fresh-distinct
                    (swc-o-authority admitted)) 2) 512)
            (swcb-bit
                (eq (swc-v-status continued) 0) 1024)
            (swcb-bit
                (eq (swc-v-verified-count continued) 2) 2048)
            (swcb-bit
                (eq (swc-v-status
                    (swc-verify
                        (list entry-a gap)
                        (list binding-a))) 4) 4096)
            (swcb-bit
                (eq (swc-v-status
                    (swc-verify
                        (list entry-a fork)
                        (list binding-a))) 4) 8192)
            (swcb-bit
                (and
                    (eq (swc-v-status
                        (swc-verify
                            (list tampered-entry)
                            (list binding-a))) 3)
                    (eq (swc-v-status
                        (swc-verify
                            (list tampered-candidate)
                            (list binding-a))) 3))
                16384)
            (swcb-bit
                (eq (swc-v-status
                    (swc-verify
                        (list entry-a)
                        (list wrong-key-binding))) 3) 32768)
            (swcb-bit
                (eq (swc-v-status missing-binding) 2) 65536)
            (swcb-bit
                (and
                    (eq (swc-v-status duplicate-binding) 1)
                    (eq (swc-bindings-valid?
                        (list binding-a
                            relabeled-shared-secret)) 0))
                131072)
            (swcb-bit
                (eq (swc-binding-valid?
                    short-key-binding) 0) 262144)
            (swcb-bit
                (eq (swc-v-status
                    (swc-verify
                        (list malformed-seal)
                        (list binding-a))) 1) 524288)
            (swcb-bit
                (eq (swc-v-status
                    (swc-verify
                        (list wrong-root)
                        (list binding-a))) 1) 1048576)
            (swcb-bit
                (eq (swc-v-status
                    (swc-verify
                        (list entry-a wrong-predecessor)
                        (list binding-a))) 4) 2097152)
            (swcb-bit
                (eq (swc-o-admitted stale-outcome) 0) 4194304)
            (swcb-bit
                (and (eq (swc-o-status
                            stale-outcome) 0)
                     (eq (sea-o-stale-exact
                            (swc-o-authority
                                stale-outcome)) 1))
                8388608)
            (swcb-bit
                (eq (swc-o-admitted
                    equivocation-outcome) 0) 16777216)
            (swcb-bit
                (eq (sea-o-reason
                    (swc-o-authority
                        equivocation-outcome)) 3) 33554432)
            (swcb-bit
                (eq (sea-o-equivocator
                    (swc-o-authority
                        equivocation-outcome)) 7001) 67108864)
            (swcb-bit
                (eq (swc-v-status
                    epoch-two-verification) 0) 134217728)
            (swcb-bit
                (not (str_eq
                    (swc-e-seal entry-a)
                    (swc-e-seal epoch-two-entry)))
                268435456)
            (swcb-bit
                (eq (len (swc-o-authority admitted)) 7)
                536870912)
            (swcb-bit
                (and (eq (len admitted) 5)
                     (eq (len
                        (swc-b-key binding-a)) 32))
                1073741824))))
