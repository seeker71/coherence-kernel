// Deterministic tool replay; no response is attributed to a model.
// preludes: form-stdlib/bml/form-cli-code-policy.bml
section [form.bml] {
 class CodeBmlRepairBand {
  def cbrb-assert(name,ok) = if ok then 1 else form_error(str_concat("code BML repair: ",name));
  def cbrb-check(contract,docs) = list(0,"retained caller behavior failure");
 }
 let source = "section [form.bml] { def f(a,b,c) = and(a,b,c); 0; }";
 let docs = list(list("code","candidate.bml",source),list("locked","checks.bml","caller-owned"));
 let s = fcap-open-direct-code("Repair this source and preserve behavior",docs,list("candidate.bml"));
 cbrb-assert("relevant BML carries tool guidance",(str_find(fcap-bootstrap(s),fcbmr-guidance(),0) >= 0));
 cbrb-assert("unrelated coding avoids extra guidance",(str_find(fcap-bootstrap(fcap-open-direct-code("Edit JSON",list(list("json","config.json","{}")),list("config.json"))),fcbmr-guidance(),0) < 0));
 let wire = "{\"tool\":\"repair-bml\",\"arguments\":[\"candidate.bml\"],\"input\":\"\"}";
 let repaired = fcap-step(s,wire,list(cbrb-check,0));
 cbrb-assert("native change admitted",((String) nth(fat-find-doc(fcap-docs(repaired),"candidate.bml"),2) == "section [form.bml] { def f(a,b,c) = and(a,and(b,c)); 0; }"));
 cbrb-assert("original evidence retained",((Value) nth(repaired,2) == docs));
 cbrb-assert("locked source preserved",((Value) fat-find-doc(fcap-docs(repaired),"checks.bml") == nth(docs,1)));
 cbrb-assert("explicit provenance",(str_find(fcap-note(repaired),"native-bml-boolean-repair",0) >= 0));
 cbrb-assert("tool success is not completion",(((String) fcap-stage(repaired) == "implement") && ((Comparable) fcap-checks(repaired) == 0)));
 let heldFailure = fat-result(2,"same caller failure","caller verification refused",docs);
 let beforeNote = fcap-tool-note(s,"verify",list(),heldFailure);
 let afterNote = fcap-tool-note(repaired,"verify",list(),heldFailure);
 cbrb-assert("same failure binds changed checked source",(!((String) beforeNote == afterNote)));
 cbrb-assert("same source and failure remain stable",((String) afterNote == fcap-tool-note(repaired,"verify",list(),heldFailure)));
 let note = parse-json("verification-source-boundary",afterNote);
 let observedDocs = node_children(json-object-get(note,"checked_documents"));
 cbrb-assert("caller failure preserved exactly",((String) fcap-string(note,"stdout") == "same caller failure"));
 cbrb-assert("checked bytes hashed exactly",((String) fcap-string(head(observedDocs),"sha256") == hex-encode(sha256-stream-string(nth(head(fcap-docs(repaired)),2)))));
 let verified = fcap-step(repaired,"{\"tool\":\"verify\",\"arguments\":[]}",list(cbrb-check,0));
 cbrb-assert("unchanged caller failure retained",(((String) fcap-stage(verified) == "repair") && (((Comparable) fcap-checks(verified) == 1) && (str_find(fcap-evidence(verified),"retained caller behavior failure",0) >= 0))));
 let review = fcap-step(fcap-open-direct-review("Inspect",docs),wire,list(cbrb-check,0));
 cbrb-assert("review cannot mutate",((Value) fcap-docs(review) == docs));
 let locked = fcap-step(fcap-open-direct-code("Repair",docs,list("checks.bml")),wire,list(cbrb-check,0));
 cbrb-assert("non-writable target preserved",((Value) fcap-docs(locked) == docs));
 let bad = fcbmr-call(docs,list("candidate.bml"),"and(1,2,3)");
 cbrb-assert("input cannot replace source",((!((Comparable) fat-exit(bad) == 0)) && ((Value) fat-documents(bad) == docs)));
 1;
}
