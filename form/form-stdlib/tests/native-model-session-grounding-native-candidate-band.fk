; native-model-session-grounding-native-candidate-band.fk -- minimal public
; candidates are content-addressed cells, path-confined, and vocabulary-free.
; preludes: form-stdlib/native-model-session-grounding-native-candidate.fk

(do
    (defn nmsgncb-score (condition bit) (if condition bit 0))
    (defn native-model-session-grounding-native-candidate-band ()
        (do
            (let first (nmsgn-candidate "form/a.fk" "bounded public text"))
            (let same (nmsgn-candidate "form/a.fk" "bounded public text"))
            (let changed (nmsgn-candidate "form/a.fk" "changed public text"))
            (sum (list
                (nmsgncb-score
                    (and (eq (len first) 4)
                         (eq (str_len (nmsgn-candidate-address first)) 64)) 1)
                (nmsgncb-score
                    (str_eq (nmsgn-candidate-address first)
                            (nmsgn-candidate-address same)) 2)
                (nmsgncb-score
                    (not (str_eq (nmsgn-candidate-address first)
                                 (nmsgn-candidate-address changed))) 4)
                (nmsgncb-score
                    (str_eq (nmsgn-candidate-id first) "form/a.fk") 8)
                (nmsgncb-score
                    (str_eq (nmsgn-candidate-text first)
                            "bounded public text") 16)
                (nmsgncb-score
                    (and (eq (nmsgn-safe-path? "form/a.fk") 1)
                         (eq (nmsgn-safe-path? "/form/a.fk") 0)) 32)
                (nmsgncb-score
                    (and (eq (nmsgn-safe-path? "form/../private") 0)
                         (eq (nmsgn-string-in? "b" (list "a" "b")) 1))
                    64)))))
    (native-model-session-grounding-native-candidate-band))
