; manifest-words-clean-band.bml — a gap's manifest line reads each name once, with no empty name, and reads only its own line (native-turn-manifest.bml, ntl-manifest-of).
;
; The second of two band-first steps split from manifest-words-band.bml (31), which stays the whole witness. Once the one
; line is cut at commas and at spaces (manifest-words-space-band.bml), this band asks that doubled and trailing separators
; leave no empty name, that a goal with no manifest line still reads [], and that text on later lines is still not read.
;
; Expected: 3
; Verdict 3 when every claim lands:
;   1   commas and spaces mixed, doubled or trailing read each name once, with no empty name
;   2   a goal with no manifest line reads [], and only the manifest's own line is read
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/native-turn-ladder.bml
section [form.bml] {
 class ManifestWordsCleanBand {
  def mwc-is?(goal, want) = (String) ntl-manifest-of(goal).str() == want.str();
  def mwc-c-mixed(ctx) = mwc-is?("g\nDefinition manifest: a, b  c ,d, ", ["a", "b", "c", "d"]);
  def mwc-c-line(ctx) = mwc-is?("g with no line", []) && mwc-is?("g\nDefinition manifest: a b\nGuide: c d", ["a", "b"]);
 }
 live-claims("manifest-words-clean-band", 0, [["mixed", 1, 1, mwc-c-mixed], ["line", 2, 1, mwc-c-line]]);
}
