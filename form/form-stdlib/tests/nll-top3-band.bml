; nll-top3-band.bml — the best three logits in one dispatch equal the three selects in a row.
;
; preludes: form-stdlib/core.fk form-stdlib/native-llama-metal.bml
; REQUIRES: the Metal carrier (a fresh worktree builds it: form-stdlib/metal-carrier.bml)
;
; The in-stream walk asks the voice for its best, second and third pick after every token (a repeated word is turned aside for
; the second). That was three dispatches of nll_argmax, nll_argmax_except and nll_argmax_except2 with a read back between: 60 ms a
; token against 43 for one. nll_top3 keeps the best three of each lane and merges them in three rounds: one dispatch, one read.
; It must answer what the three answer: value descending, the lowest index among equals, and 0xffffffff for all three when any logit
; is not finite. This band runs both over the same logits.
;
; Verdict 15 when every claim lands:
;   1   3000 logits full of ties (a hundred distinct values): nll-select3 equals best, second, third from the three selects
;   2   fewer logits than lanes (7), and fewer than three (2): the same, the missing picks 0xffffffff
;   4   a NaN among the logits: all three 0xffffffff, as each select answers
;   8   the 3B vocabulary (128256 logits, a pattern with ties at the top): the same
section [form.bml] {
 class NllTop3Band {
  def nt3-bit(ok, bit) = ok ? bit : 0;
  def nt3-tied(n) = map(i => ((i * 37) % 101) / 10.0, range(0, n));
  def nt3-buf(floats) = nam-write(nam-alloc(len(floats)), nam-f32s(floats));
  def nt3-three(buf, n) {
   let best = nll-select(buf, n);
   let second = nll-select-except(buf, n, best);
   let third = nll-select-except2(buf, n, best, second);
   [best, second, third];
  }
  def nt3-same?(floats) {
   let buf = nt3-buf(floats);
   let n = len(floats);
   let a = nt3-three(buf, n);
   let b = nll-select3(buf, n);
   let freed = nam-free([buf]);
   (Comparable) a[0] == b[0] && (Comparable) a[1] == b[1] && (Comparable) a[2] == b[2];
  }
  def nt3-nan?() {
   let floats = nt3-tied(200);
   let bytes = nam-f32s(take(100, floats)) ++ md-le32(2143289344) ++ nam-f32s(drop(100, floats));
   let buf = nam-write(nam-alloc(len(floats) + 1), bytes);
   let n = len(floats) + 1;
   let a = nt3-three(buf, n);
   let b = nll-select3(buf, n);
   let freed = nam-free([buf]);
   (Comparable) a[0] == 4294967295 && (Comparable) b[0] == 4294967295 && (Comparable) b[1] == 4294967295 && (Comparable) b[2] == 4294967295 && (Comparable) a[1] == b[1] && (Comparable) a[2] == b[2];
  }
  def nt3-score() {
   nt3-bit(nt3-same?(nt3-tied(3000)), 1)
   + nt3-bit(nt3-same?(nt3-tied(7)) && nt3-same?(nt3-tied(2)) && nt3-same?(nt3-tied(33)), 2)
   + nt3-bit(nt3-nan?(), 4)
   + nt3-bit(nt3-same?(map(i => (((i * 7919) % 100003) % 997) / 100.0, range(0, 128256))), 8);
  }
 }
 nt3-score();
}
