// Numeric observations share the learner's comparison, without state writes.
// preludes: form-stdlib/native-session-learning.bml
section [form.bml] {
 class NativeSessionLossEvidenceBand {
  def nsleb-row(id,loss) = json-node-object(list(nsm-s("row_sha256",id),nsm-real("loss",loss)));
  def nsleb-check() {
   let improved = nsl-loss-evidence(2.0,1.5,0.125);
   let equal = nsl-loss-evidence(2.0,2.0,0.125);
   let edge = nsl-loss-evidence(2.0,2.125,0.125);
   let worse = nsl-loss-evidence(2.0,2.25,0.125);
   let checks = list(
    and(node_eq(oh-get(improved,"strictly_improved"),json-node-bool(1)),node_eq(oh-get(improved,"within_tolerance"),json-node-bool(1))),
    and(node_eq(oh-get(equal,"strictly_improved"),json-node-bool(0)),node_eq(oh-get(equal,"within_tolerance"),json-node-bool(1))),
    and(eq(nsm-num(edge,"allowed_after"),2.125),node_eq(oh-get(edge,"within_tolerance"),json-node-bool(1))),
    node_eq(oh-get(worse,"within_tolerance"),json-node-bool(0)),
    and(nsl-row-health(nsleb-row("same",2.0),nsleb-row("same",1.5)),not(nsl-row-health(nsleb-row("first",2.0),nsleb-row("other",1.5)))),
    and(nsl-row-health(nsleb-row("same",2.0),nsleb-row("same",2.0000005)),not(nsl-row-health(nsleb-row("same",2.0),nsleb-row("same",2.000002)))));
   print(list("native-loss-evidence",checks));
   if value_eq(checks,list(1,1,1,1,1,1)) then 63 else form_error("native loss evidence disagrees with comparison or row binding");
  }
 }
 nsleb-check();
}
