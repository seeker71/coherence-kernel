// Numeric observations share the learner's comparison, without state writes.
// preludes: form-stdlib/native-session-learning.bml
section [form.bml] {
 class NativeSessionLossEvidenceBand {
  def nsleb-row(id,loss) = json-node-object(list(nsm-s("row_sha256",id),nsm-real("loss",loss)));
  def nsleb-cache() {
   let row = json-node-object(list(nsm-s("prompt","observed question"),nsm-s("completion","verified answer")));
   let changed = oh-set(row,"completion",json-node-string("different answer"));
   let key = nsl-cache-key("sealed model and adapter",row);
   let score = json-node-object(list(nsm-n("index",4),nsm-s("row_sha256",nsm-hash(json-emit-precise(row))),nsm-real("loss",1.25),nsm-real("supervised_tokens",3.0)));
   let record = json-node-object(list(nsm-s("key",key),nsm-s("score_sha256",nsm-hash(json-emit-precise(score))),json-node-pair("score",score)));
   let corrupt = oh-set(record,"score",oh-set(score,"loss",json-precise-float(0.0)));
   let accepted = nsl-cache-score(record,key,row,0);
   let restored = nsl-cache-score(parse-json("retained-assessment",json-emit-precise(record)),key,row,0);
   if not(str_eq(json-emit-precise(restored),json-emit-precise(accepted))) then form_error("retained assessment changed numeric values or row order") else 0;
   let observations = nsl-cache-observations(list(list(accepted,row),list(json-node-null(),changed)),0);
   if not(and(str_eq(nsm-str(head(observations),"source"),"reused"),and(str_eq(nsm-str(nth(observations,1),"source"),"measured"),and(eq(nsm-num(nth(observations,1),"index"),1),str_eq(nsm-str(nth(observations,1),"row_sha256"),nsm-hash(json-emit-precise(changed))))))) then form_error("assessment reuse lost per-row provenance") else 0;
   let checks = list(value_eq(accepted,oh-set(score,"index",json-node-int(0))),node_eq(nsl-cache-score(record,"other binding",row,0),json-node-null()),node_eq(nsl-cache-score(record,key,changed,0),json-node-null()),node_eq(nsl-cache-score(corrupt,key,row,0),json-node-null()),node_eq(nsl-cache-score(json-node-object(list()),key,row,0),json-node-null()),not(str_eq(key,nsl-cache-key("other adapter",row))),not(str_eq(key,nsl-cache-key("sealed model and adapter",changed))));
   if value_eq(checks,list(1,1,1,1,1,1,1)) then 1 else form_error("assessment reuse admitted changed identity, row or score");
  }
  def nsleb-check() {
   let cache = nsleb-cache();
   let improved = nsl-loss-evidence(2.0,1.5,0.125);
   let equal = nsl-loss-evidence(2.0,2.0,0.125);
   let edge = nsl-loss-evidence(2.0,2.125,0.125);
   let worse = nsl-loss-evidence(2.0,2.25,0.125);
   let checks = list(
    and(node_eq(oh-get(improved,"strictly_improved"),json-node-bool(1)),node_eq(oh-get(improved,"within_tolerance"),json-node-bool(1))),
    and(node_eq(oh-get(equal,"strictly_improved"),json-node-bool(0)),node_eq(oh-get(equal,"within_tolerance"),json-node-bool(1))),
    and(eq(nsm-num(edge,"allowed_after"),2.125),node_eq(oh-get(edge,"within_tolerance"),json-node-bool(1))),
    node_eq(oh-get(worse,"within_tolerance"),json-node-bool(0)),
    and(nsl-row-health(nsleb-row("same",2.0),nsleb-row("same",1.5)),not(nsl-row-health(nsleb-row("first",2.0),nsleb-row("other",1.5)))),
    and(nsl-row-health(nsleb-row("same",2.0),nsleb-row("same",2.0000005)),not(nsl-row-health(nsleb-row("same",2.0),nsleb-row("same",2.000002)))));
   print(list("native-loss-evidence",checks));
   if value_eq(checks,list(1,1,1,1,1,1)) then 63 else form_error("native loss evidence disagrees with comparison or row binding");
  }
 }
 nsleb-check();
}
