; bounded-health-projection-band.fk — full-shape, shallow-work health proof.
;
; preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/bounded-health-projection.fk
;
; Verdict 4095 proves the compatibility shape and the absent deep-proof lanes.

section [form.bml] {
    def bhpb-score(ok, bit) = if ok then bit else 0;

    def bounded-health-projection-band-score() {
        let outcomes = json-node-object(list(json-node-pair("last_1m", json-node-int(3))));
        let projection = bounded-health-projection("ok", "1.0.0", "2026-10-11T01:00:00Z", "2026-10-11T00:00:00Z", 3600, "1h 0m 0s", "abc123", "config:deployed_sha", false, true, true, true, true, "", outcomes, "form-kernel-go");
        let emitted = json-emit(projection);
        sum(list(
            bhpb-score(str_eq(json-string-value(json-object-get(projection, "status")), "ok"), 1),
            bhpb-score(str_eq(json-string-value(json-object-get(projection, "version")), "1.0.0"), 2),
            bhpb-score(eq(json-int-value(json-object-get(projection, "uptime_seconds")), 3600), 4),
            bhpb-score(str_eq(json-string-value(json-object-get(projection, "deployed_sha")), "abc123"), 8),
            bhpb-score(str_eq(json-string-value(json-object-get(projection, "deployed_sha_source")), "config:deployed_sha"), 16),
            bhpb-score(gt(str_find(emitted, "\"integrity_verified\":true", 0), -1), 32),
            bhpb-score(gt(str_find(emitted, "\"schema_ok\":true", 0), -1), 64),
            bhpb-score(gt(str_find(emitted, "\"recent_outcomes\":{\"last_1m\":3}", 0), -1), 128),
            bhpb-score(gt(str_find(emitted, "\"native_runtime_observation\":null", 0), -1), 256),
            bhpb-score(gt(str_find(emitted, "\"deployment_witness_node_id\":null", 0), -1), 512),
            bhpb-score(gt(str_find(emitted, "\"deployment_observation_fresh\":false", 0), -1), 1024),
            bhpb-score(gt(str_find(emitted, "\"kernel_runtime\":\"form-kernel-go\"", 0), -1), 2048)
        ));
    }

    bounded-health-projection-band-score();
}
