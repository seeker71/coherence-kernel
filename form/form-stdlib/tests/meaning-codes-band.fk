; meaning-codes-band.fk — one meaning, many codes, every code resolves back.
; Expected: 31
;   1 a meaning's codes carry symbol, nl and node   2 the node id is the phrase's content address
;   4 every meaning round-trips through every present code   8 an unknown code resolves to nothing
;   16 a tongue row present in the locale file appears as a code and resolves (Persian for "said")
; preludes: form/form-stdlib/meaning-codes.bml
(do
    (defn mcb-bit (ok bit) (if ok bit 0))
    (defn mcb-kind? (codes k) (if (eq (len codes) 0) 0 (if (str_eq (head (head codes)) k) 1 (mcb-kind? (tail codes) k))))
    (let g (mc-codes "r"))
    (sum (list
        (mcb-bit (and (eq (mcb-kind? g "symbol") 1) (and (eq (mcb-kind? g "nl") 1) (eq (mcb-kind? g "node") 1))) 1)
        (mcb-bit (and (eq (str_len (mc-node "a gift")) 8) (str_eq (mc-node "a gift") (mc-node (mc-nl "r")))) 2)
        (mcb-bit (eq (mc-all-round? (mc-meanings)) 1) 4)
        (mcb-bit (eq (str_len (mc-resolve "zorble-nothing")) 0) 8)
        (mcb-bit (and (eq (mcb-kind? (mc-codes "say") "persian") 1) (eq (mc-member? (mc-resolve-all "گفت") "say") 1)) 16))))
