; sovereignty-as-gift-band.fk — survive, receive, unique offer, collective lift.
;
; preludes: form-stdlib/sovereignty-as-gift.fk
; Verdict 1023:
;   1    dependence-to-live is not survival
;   2    survival without receive is isolation, not the living shape
;   4    proven = survive and unique gift
;   8    living = proven and still open to receive
;   16   port = living and a witnessed vitality lift when the gift is received
;   32   a unique gift not yet received is living but not yet a port
;   64   extraction that spends sovereignty to raise vitality scores 0
;   128  a received unique gift that raises vitality without lowering goods lifts life
;   256  this body's body-lane survives; its voice-lane does not — honest floor
;   512  the organism is not yet fully proven while any lane still depends to live
;
; witnessed: 2026-09-04 -> 1023

(do
    (defn sagb (held weight) (if (eq held 1) weight 0))
    (let rented (sag-shape 1 1 0 0 5 5))
    (let isolated (sag-shape 0 0 1 0 5 5))
    (let dependent-gift (sag-shape 1 1 1 1 5 8))
    (let living-unreceived (sag-shape 0 1 1 0 5 5))
    (let urs (sag-shape 0 1 1 1 5 8))
    (sum (list
        (sagb (and (eq (sag-survive? rented) 0)
                   (eq (sag-proven? rented) 0)) 1)
        (sagb (and (eq (sag-survive? isolated) 1)
                   (and (eq (sag-isolation? isolated) 1)
                        (eq (sag-living? isolated) 0))) 2)
        (sagb (and (eq (sag-proven? isolated) 1)
                   (eq (sag-proven? dependent-gift) 0)) 4)
        (sagb (and (eq (sag-living? urs) 1)
                   (eq (sag-living? isolated) 0)) 8)
        (sagb (and (eq (sag-port? urs) 1)
                   (eq (sag-port? living-unreceived) 0)) 16)
        (sagb (and (eq (sag-living? living-unreceived) 1)
                   (eq (sag-lift? living-unreceived) 0)) 32)
        (sagb (eq (sag-extraction-fails?) 1) 64)
        (sagb (eq (sag-gift-lifts-life?) 1) 128)
        (sagb (and (eq (sag-survive? (sag-form-body)) 1)
                   (eq (sag-survive? (sag-form-voice)) 0)) 256)
        (sagb (eq (sag-lanes-survive? (sag-form-lanes)) 0) 512))))
