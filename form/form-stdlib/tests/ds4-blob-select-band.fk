; ds4-blob-select-band.fk — the two-tier DS4 preference proven against a fixture tree the band
; emits itself, the four decision points named in ds4-blob-select.fk's own comment: the engine's
; canonical name wins among what ds4-engine/ holds; the first deepseek4 file wins when the canonical
; name is absent; a wrong-architecture file AT the canonical name is skipped and ds4/ answers
; instead (real header verification, never name trust); and an empty root answers "", honestly.
;
; PROOF LEVEL: FOURTH-ARM ONLY (fkwu) — inherits model-discovery.fk's own proof level: discovery
; reads files by their own bytes through read_file_slice, byte-faithful on fkwu only (core.fk's
; narrow-waist measurement; model-discovery-band.fk's header, witnessed 2026-09-03).
;
; WHY /tmp AND NOT A SESSION SCRATCH DIR: same reasoning as model-discovery-band.fk — every byte
; under the fixture root is rewritten by this band before every read, so a concurrent identical run
; writes identical bytes and there is nothing here for a sibling's build to clobber into a different
; answer.
;
; Verdict 31 = 1 canonical-name-wins | 2 first-found-wins | 4 wrong-arch-skipped-specimen-answers
;            | 8 empty-directories-answer-absent | 16 no-ds4-directories-answer-absent
;
; preludes: form-stdlib/core.fk form-stdlib/ds4-blob-select.fk

(do
    (defn dsb-bit (weight ok) (if (eq ok 1) weight 0))
    (defn dsb-eq1 (a b) (if (str_eq a b) 1 0))

    ; ---- a minimal real GGUF header emitter: magic, version 3, no tensors, two KVs ----
    ; the same LE-word-through-byte_to_str technique model-discovery-band.fk already proved; this
    ; band only ever needs general.architecture and general.name, so block_count is left out.
    (defn dsb-u32 (v)
        (str_concat (byte_to_str (mod v 256))
        (str_concat (byte_to_str (mod (floor (div v 256)) 256))
        (str_concat (byte_to_str (mod (floor (div v 65536)) 256))
                    (byte_to_str (mod (floor (div v 16777216)) 256))))))
    (defn dsb-u64 (v) (str_concat (dsb-u32 (mod v 4294967296)) (dsb-u32 (floor (div v 4294967296)))))
    (defn dsb-gstr (s) (str_concat (dsb-u64 (str_len s)) s))
    (defn dsb-kv-str (key val) (str_concat (dsb-gstr key) (str_concat (dsb-u32 8) (dsb-gstr val))))
    (defn dsb-gguf (arch name)
        (str_concat "GGUF"
        (str_concat (dsb-u32 3)
        (str_concat (dsb-u64 0)
        (str_concat (dsb-u64 2)
        (str_concat (dsb-kv-str "general.architecture" arch)
                    (dsb-kv-str "general.name" name)))))))

    (defn dsb-root () "/tmp/form-ds4-blob-select-band-fixture")
    (defn dsb-j (a b) (md-join a b))
    (let r (dsb-root))
    (fs_mkdir r)
    (fs_mkdir (dsb-j r "s1"))
    (fs_mkdir (dsb-j r "s1/ds4-engine"))
    (fs_mkdir (dsb-j r "s1/ds4"))
    (fs_mkdir (dsb-j r "s2"))
    (fs_mkdir (dsb-j r "s2/ds4-engine"))
    (fs_mkdir (dsb-j r "s3"))
    (fs_mkdir (dsb-j r "s3/ds4-engine"))
    (fs_mkdir (dsb-j r "s3/ds4"))
    (fs_mkdir (dsb-j r "s4"))
    (fs_mkdir (dsb-j r "s4/ds4-engine"))
    (fs_mkdir (dsb-j r "s4/ds4"))

    ; ---- s1: two real deepseek4 files in ds4-engine/, one at the canonical name, plus a specimen
    ; in ds4/ that must be ignored because ds4-engine/ already answered ----
    (let s1-canon (dsb-j r "s1/ds4-engine/ds4flash.gguf"))
    (let s1-other (dsb-j r "s1/ds4-engine/other-ds4.gguf"))
    (let s1-spec (dsb-j r "s1/ds4/specimen.gguf"))
    (write_file s1-canon (dsb-gguf "deepseek4" "canonical"))
    (write_file s1-other (dsb-gguf "deepseek4" "other"))
    (write_file s1-spec (dsb-gguf "deepseek4" "specimen"))
    (let b1 (dsb-bit 1 (dsb-eq1 (dbs-resolve (dsb-j r "s1")) s1-canon)))

    ; ---- s2: ds4-engine/ carries one deepseek4 file, not at the canonical name — it still wins,
    ; order-stable, never left unresolved for want of the exact name ----
    (let s2-other (dsb-j r "s2/ds4-engine/other-ds4.gguf"))
    (write_file s2-other (dsb-gguf "deepseek4" "other2"))
    (let b2 (dsb-bit 2 (dsb-eq1 (dbs-resolve (dsb-j r "s2")) s2-other)))

    ; ---- s3: a file AT the canonical name whose header is NOT deepseek4 — the real test that this
    ; cell reads architecture and not the filename. ds4/ carries the true deepseek4 file and answers.
    (let s3-wrong (dsb-j r "s3/ds4-engine/ds4flash.gguf"))
    (let s3-spec (dsb-j r "s3/ds4/specimen.gguf"))
    (write_file s3-wrong (dsb-gguf "notds4" "wrongarch"))
    (write_file s3-spec (dsb-gguf "deepseek4" "specimen3"))
    (let b3 (dsb-bit 4 (dsb-eq1 (dbs-resolve (dsb-j r "s3")) s3-spec)))

    ; ---- s4: both directories exist and hold files, but none is a deepseek4 GGUF — absence is
    ; answered honestly, never a guess at whatever happens to be there ----
    (write_file (dsb-j r "s4/ds4-engine/decoy.txt") "not a model")
    (write_file (dsb-j r "s4/ds4/decoy2.txt") "not a model either")
    (let b4 (dsb-bit 8 (dsb-eq1 (dbs-resolve (dsb-j r "s4")) "")))

    ; ---- s5: neither ds4-engine/ nor ds4/ exists under this root at all ----
    (let b5 (dsb-bit 16 (dsb-eq1 (dbs-resolve (dsb-j r "s5")) "")))

    (add b1 (add b2 (add b3 (add b4 b5)))))
