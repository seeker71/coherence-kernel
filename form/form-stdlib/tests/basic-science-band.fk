; basic-science-band.fk — executable first science surface, four-way pure Form.
;
; preludes: form-stdlib/basic-science.fk
;
; Verdict 16383 when each named model holds:
;   1     equal dimensions add
;   2     a dimensional mismatch is nothing
;   4     zero is a real quantity, not nothing
;   8     constant velocity produces a labelled displacement
;   16    F = ma produces a labelled force
;   32    1/2 mv² produces a labelled kinetic energy
;   64    water formation conserves hydrogen
;   128   water formation conserves oxygen
;   256   the declared H/O reaction is balanced
;   512   an unbalanced reaction is rejected
;   1024  a heterozygous cross has four outcomes
;   2048  that classroom cross has three dominant outcomes
;   4096  that classroom cross has one recessive outcome
;   8192  a recessive allele is represented by 0, never nothing
;
(do
    (let length-a (bsc-length-m 2.0))
    (let length-b (bsc-length-m 3.0))
    (let zero-length (bsc-length-m 0.0))
    (let total-length (bsc-add length-a length-b))
    (let mismatch (bsc-add length-a (bsc-duration-s 3.0)))
    (let distance (bsc-displacement (bsc-speed-mps 3.0) (bsc-duration-s 4.0)))
    (let force (bsc-force (bsc-mass-kg 2.0) (bsc-accel-mps2 3.0)))
    (let energy (bsc-kinetic-energy (bsc-mass-kg 2.0) (bsc-speed-mps 3.0)))

    ; 2 H2 + O2 -> 2 H2O. Species are atom-count maps, reaction terms are
    ; coefficient/species pairs, and H/O are the declared conservation domain.
    (let hydrogen (list (list "H" 2)))
    (let oxygen (list (list "O" 2)))
    (let water (list (list "H" 2) (list "O" 1)))
    (let balanced-left (list (list 2 hydrogen) (list 1 oxygen)))
    (let balanced-right (list (list 2 water)))
    (let unbalanced-left (list (list 1 hydrogen) (list 1 oxygen)))
    (let atoms (list "H" "O"))

    ; Aa x Aa: the four equally represented classroom outcomes are AA, Aa, aA, aa.
    (let heterozygous (bsc-genotype 1 0))
    (let offspring (bsc-cross heterozygous heterozygous))

    (let c0 (if (and (str_eq (bsc-dimension total-length) "length-m")
                      (eq (bsc-value total-length) 5.0)) 1 0))
    (let c1 (if (nothing? mismatch) 2 0))
    (let c2 (if (and (eq (bsc-value zero-length) 0.0)
                      (if (nothing? zero-length) 0 1)) 4 0))
    (let c3 (if (and (str_eq (bsc-dimension distance) "length-m")
                      (eq (bsc-value distance) 12.0)) 8 0))
    (let c4 (if (and (str_eq (bsc-dimension force) "force-n")
                      (eq (bsc-value force) 6.0)) 16 0))
    (let c5 (if (and (str_eq (bsc-dimension energy) "energy-j")
                      (eq (bsc-value energy) 9.0)) 32 0))
    (let c6 (if (bsc-balanced-atom? balanced-left balanced-right "H") 64 0))
    (let c7 (if (bsc-balanced-atom? balanced-left balanced-right "O") 128 0))
    (let c8 (if (bsc-balanced-elements? balanced-left balanced-right atoms) 256 0))
    (let c9 (if (eq (bsc-balanced-elements? unbalanced-left balanced-right atoms) 0) 512 0))
    (let c10 (if (eq (len offspring) 4) 1024 0))
    (let c11 (if (eq (bsc-count-dominant offspring) 3) 2048 0))
    (let c12 (if (eq (bsc-count-recessive offspring) 1) 4096 0))
    (let c13 (if (and (eq (nth (nth offspring 3) 0) 0)
                       (if (nothing? (nth (nth offspring 3) 0)) 0 1)) 8192 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6
         (add c7 (add c8 (add c9 (add c10 (add c11 (add c12 c13))))))))))))))
