// preludes: form-stdlib/bml/formbin-codec.bml observe/formbin-depth-fixtures.bml
section [form.bml] {
 class FormbinCodecWitness {
  def fcb-k(ok, bit) = if ok then bit else 0;
  def fcb-raw(hex) = fcb-bytes(hex-decode(hex), "");
  def fcb-bytes(bytes, s) = if nil?(bytes) then s else fcb-bytes(tail(bytes), str_concat(s, byte_to_str(head(bytes))));
  def fcb-number(hex, tag) = fbc-number(tag, fcb-raw(hex));
  def fcb-root() = fbc-composite(fbc-leaf(1, 2, 34, 1), list(fbc-string(1, "grounded ∴ observed"), fbc-leaf(1, 1, 1, 42), fcb-number("0000000000010000", 3), fcb-number("0000000000000c40", 2)));
  def fcb-roundtrip(root) {
   let encoded = fbc-encode(root);
   let decoded = fbc-decode(fbc-value(encoded));
   let repacked = fbc-encode(fbc-value(decoded));
   and(fbc-good(encoded), and(fbc-good(decoded), and(fbc-good(repacked), str_eq(fbc-value(encoded), fbc-value(repacked)))));
  }
  def fcb-numeric-cases(xs, tag) = if nil?(xs) then 1 else and(fcb-roundtrip(fcb-number(head(xs), tag)), fcb-numeric-cases(tail(xs), tag));
  def fcb-refused(raw, reason) = str_eq(fbc-error(fbc-decode(raw)), str_concat("form binary: ", reason));
  def fcb-run() {
   let encoded = fbc-encode(fcb-root());
   let decoded = fbc-decode(fbc-value(encoded));
   let alternateLeaf = str_concat(fbc-word(0), str_concat(fbc-word(7), str_concat(fbc-word(1), str_concat(fbc-word(2), fbc-word(1)))));
   let alternatePool = str_concat(fbc-word(2), str_concat(fbc-word(6), str_concat("unused", str_concat(fbc-word(1), "x"))));
   let alternate = str_concat("FORMBIN2", str_concat(alternatePool, alternateLeaf));
   let one = fbc-encode(fbc-string(1, "x"));
   let deep = fbc-decode(fbw-artifact(1024));
   let invalidIndex = str_concat("FORMBIN2", str_concat(fbc-word(0), fbw-leaf(1, 2, 0)));
   let badUtf = list("c080", "eda080", "f4908080", "f5808080", "e282", "80", "ff");
   let sameStructure = str_eq(fbc-structural(fbc-value(fbc-decode(alternate))), fbc-structural(fbc-value(fbc-decode(fbc-value(one)))));
   let zeroDiff = not(str_eq(fbc-structural(fcb-number("0000000000000000", 2)), fbc-structural(fcb-number("0000000000000080", 2))));
   let nanDiff = not(str_eq(fbc-structural(fcb-number("010000000000f07f", 2)), fbc-structural(fcb-number("020000000000f07f", 2))));
   sum(list(
    fcb-k(and(fbc-good(decoded), and(eq(nth(decoded, 3), 6), fcb-roundtrip(fcb-root()))), 1),
    fcb-k(fcb-numeric-cases(list("0000000000000080", "ffffffffffffff7f", "ffffffffffffffff", "0000000000000000", "0100000000000000"), 3), 2),
    fcb-k(fcb-numeric-cases(list("0000000000000080", "000000000000f07f", "000000000000f0ff", "010000000000f07f", "ab0000000000f87f", "0100000000000000"), 2), 4),
    fcb-k(and(fbc-good(fbc-decode(alternate)), and(not(str_eq(alternate, fbc-value(one))), sameStructure)), 8),
    fcb-k(and(fbc-good(deep), and(eq(nth(deep, 4), 1024), str_eq(fbc-value(fbc-encode(fbc-value(deep))), fbw-artifact(1024)))), 16),
    fcb-k(and(fcb-refused("FKB1", "bad magic"), fcb-refused("FORMBIN2", "truncated u32")), 32),
    fcb-k(fcb-refused(invalidIndex, "bad string index 0"), 64),
    fcb-k(fcb-utf-refused(badUtf), 128),
    fcb-k(and(fbc-utf8("grounded ∴ observed", 0), fbc-utf8(fcb-raw("f48fbfbf"), 0)), 256),
    fcb-k(and(nothing?(fbc-leaf(1, 2, 1, -1)), and(nothing?(fbc-leaf(1, 2, 1, 4294967296)), nothing?(fbc-number(3, "short")))), 512),
    fcb-k(and(zeroDiff, nanDiff), 1024),
    fcb-k(and(fcb-refused(str_concat("FORMBIN2", str_concat(fbc-word(0), str_concat(fbc-word(2), "a"))), "truncated float64"), fcb-refused(str_concat("FORMBIN2", str_concat(fbc-word(0), str_concat(fbc-word(3), "a"))), "truncated int64")), 2048),
    fcb-k(and(nothing?(fbc-leaf(1, 2, 3, 1.5)), and(nothing?(fbc-leaf(1, 2, 3, "1")), and(not(fbc-good(fbc-encode(42))), not(fbc-good(fbc-encode(list(0, 1, 1, 2, 0))))))), 4096),
    fcb-k(fcb-roundtrip(fbc-composite(fbc-leaf(1, 2, 34, 1), list(fbc-string(1, str_concat("x", byte_to_str(0))), fbc-string(1, "x"), fbc-string(1, str_concat("x", byte_to_str(0)))))), 8192)
   ));
  }
  def fcb-utf-refused(xs) = if nil?(xs) then 1 else and(not(fbc-utf8(fcb-raw(head(xs)), 0)), fcb-utf-refused(tail(xs)));
 }
 fcb-run();
}
