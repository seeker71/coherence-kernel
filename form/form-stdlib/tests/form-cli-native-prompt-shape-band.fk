; The live CLI and the canonical Form generation request must present the same
; changing inquiry to DS4. This rejects an unrequested system preamble without
; storing one prompt's expected token ids as the rule.
;
; preludes: form-stdlib/form-cli-dsv4-local.fk

(do
    (let question "Which native path is fresh?")
    (let path (str_concat (temp_dir) "/form-cli-native-prompt-shape.txt"))
    (let wrote (write_file path question))
    (let model (dsv4-local-model-resource))
    (let src (tkz-src model))
    (let cli-ids (fdl-chat-ids src question))
    (let request-ids (dgr-chat-ids (dgr-request model path 1)))
    (let verdict
        (if (and
                (gt wrote 0)
                (and
                    (gt (len cli-ids) 4)
                    (str_eq
                        (dgr-ids-csv cli-ids)
                        (dgr-ids-csv request-ids))))
            7
            0))
    (fs_remove path)
    verdict)
