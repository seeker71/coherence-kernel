; dsv4-token-recipe-swap-band.fk — one bounded alternative to a DS4 argmax token.
;
; Verdict 65535 when the shared deadline/bandwidth membrane, fallback, arbitrary Form-recipe call,
; vitality selection, and reversible baseline installation all hold.
;
;   1      the measured DS4 envelope is pinned: 34 ms, 471 GB/s, 9.103 GB default
;   2      the shared envelope leaves exactly 6.911 GB for the alternative
;   4      a function-valued Form recipe actually runs and returns token default+7
;   8      an in-window, in-bandwidth, witnessed candidate is admissible
;   16     a strictly more-vital alternative replaces the default token
;   32     a vitality tie keeps the default
;   64     a late recipe is timeout==nothing and keeps the default
;   128    an over-bandwidth recipe is nothing and keeps the default
;   256    an untrusted boundary result is held and keeps the default
;   512    an explicit nothing acknowledgment keeps the default
;   1024   vitality is the weakest witnessed axis, not a flattering average
;   2048   select-any chooses the most vital admissible recipe, independent of order
;   4096   a safe, majority-winning, strictly more-vital window promotes the recipe
;   8192   installation is a new generation whose parent is the exact old baseline
;   16384  a tied window cannot install a challenger
;   32768  one unsafe/meaning-unwitnessed trial blocks installation
;
; preludes: form-stdlib/core.fk form-stdlib/dsv4-token-recipe-swap.fk

(do
    (defn dtrsb-score (ok bit) (if ok bit 0))
    (defn dtrsb-plus-seven (context default-token deadline)
        (dtrs-offer "node" (add default-token 7) 1000000000
            (dtrs-vitality 90 88 87 86 85 89) "recipe-plus-seven-witness"))
    (defn dtrsb-fixed-offer (token bytes vitality witness)
        (dtrs-offer "1" token bytes vitality witness))

    (let w (dtrs-dsv4-window 1000))
    (let base (dtrs-initial-baseline 70))
    (let default (dtrs-default-candidate w base 42 70 "dsv4-default-token-witness"))
    (let alt (dtrs-run-observed dtrsb-plus-seven (list 1 2 3) "form-plus-seven" w 42
                   1000 1020 1 1 1 1))
    (let tied (dtrs-candidate "form-tie" (dtrsb-fixed-offer 50 1000000000 70 "tie-witness")
                   1000 1020 1 1 1 1))
    (let late (dtrs-candidate "form-late" (dtrsb-fixed-offer 51 1000000000 90 "late-witness")
                   1000 1035 1 1 1 1))
    (let wide (dtrs-candidate "form-wide" (dtrsb-fixed-offer 52 7000000000 90 "wide-witness")
                   1000 1020 1 1 1 1))
    (let untrusted (dtrs-candidate "form-untrusted" (dtrsb-fixed-offer 53 1000000000 90 "trust-witness")
                   1000 1020 1 0 1 1))
    (let silent (dtrs-candidate "form-silent" (dtrs-offer "nothing" 0 0 0 "silence-witness")
                   1000 1000 1 1 1 1))
    (let better (dtrs-candidate "form-better" (dtrsb-fixed-offer 54 1000000000 91 "better-witness")
                   1000 1021 1 1 1 1))

    (let choose-alt (dtrs-select w default alt))
    (let choose-tie (dtrs-select w default tied))
    (let choose-late (dtrs-select w default late))
    (let choose-wide (dtrs-select w default wide))
    (let choose-untrusted (dtrs-select w default untrusted))
    (let choose-silent (dtrs-select w default silent))
    (let choose-any (dtrs-select-any w default (list tied better alt)))

    (let good-trials (list
        (dtrs-trial (dtrs-dsv4-model-id) "form-better" 70 82 1 1 "trial-1")
        (dtrs-trial (dtrs-dsv4-model-id) "form-better" 72 84 1 1 "trial-2")
        (dtrs-trial (dtrs-dsv4-model-id) "form-better" 76 74 1 1 "trial-3")))
    (let installed (dtrs-install base good-trials 3))
    (let tied-trials (list
        (dtrs-trial (dtrs-dsv4-model-id) "form-tie" 70 70 1 1 "tie-1")
        (dtrs-trial (dtrs-dsv4-model-id) "form-tie" 70 70 1 1 "tie-2")
        (dtrs-trial (dtrs-dsv4-model-id) "form-tie" 70 70 1 1 "tie-3")))
    (let unsafe-trials (list
        (dtrs-trial (dtrs-dsv4-model-id) "form-better" 70 82 1 1 "safe-1")
        (dtrs-trial (dtrs-dsv4-model-id) "form-better" 70 84 1 0 "unsafe-meaning")
        (dtrs-trial (dtrs-dsv4-model-id) "form-better" 70 86 1 1 "safe-3")))

    (sum (list
        (dtrsb-score (and (eq (dtrs-dsv4-timeout-ms) 34)
                       (and (eq (dtrs-dsv4-bandwidth-bytes-per-ms) 471000000)
                            (eq (dtrs-dsv4-default-bytes) 9103000000))) 1)
        (dtrsb-score (eq (dtrs-window-recipe-room w) 6911000000) 2)
        (dtrsb-score (eq (dtrs-candidate-token alt) 49) 4)
        (dtrsb-score (eq (dtrs-candidate-admissible? w alt) 1) 8)
        (dtrsb-score (and (eq (dtrs-choice-token choose-alt) 49)
                           (str_eq (dtrs-choice-reason choose-alt) "recipe-more-vital")) 16)
        (dtrsb-score (and (eq (dtrs-choice-token choose-tie) 42)
                           (str_eq (dtrs-choice-reason choose-tie) "default-more-vital-or-tie")) 32)
        (dtrsb-score (and (eq (dtrs-choice-token choose-late) 42)
                           (str_eq (dtrs-choice-alternative-state choose-late) "timeout-nothing")) 64)
        (dtrsb-score (and (eq (dtrs-choice-token choose-wide) 42)
                           (str_eq (dtrs-choice-alternative-state choose-wide) "bandwidth-nothing")) 128)
        (dtrsb-score (and (eq (dtrs-choice-token choose-untrusted) 42)
                           (str_eq (dtrs-choice-alternative-state choose-untrusted) "boundary-hold")) 256)
        (dtrsb-score (and (eq (dtrs-choice-token choose-silent) 42)
                           (str_eq (dtrs-choice-alternative-state choose-silent) "ack-nothing")) 512)
        (dtrsb-score (eq (dtrs-vitality 99 95 91 87 83 79) 79) 1024)
        (dtrsb-score (and (eq (dtrs-choice-token choose-any) 54)
                           (str_eq (dtrs-choice-recipe choose-any) "form-better")) 2048)
        (dtrsb-score (and (eq (dtrs-promote? good-trials 3) 1)
                           (and (str_eq (dtrs-baseline-recipe installed) "form-better")
                                (str_eq (dtrs-baseline-status installed) "installed-more-vital"))) 4096)
        (dtrsb-score (and (eq (dtrs-baseline-generation installed) 1)
                           (str_eq (dtrs-baseline-recipe (dtrs-baseline-parent installed))
                                   (dtrs-dsv4-model-id))) 8192)
        (dtrsb-score (and (eq (dtrs-promote? tied-trials 3) 0)
                           (str_eq (dtrs-baseline-recipe (dtrs-install base tied-trials 3))
                                   (dtrs-dsv4-model-id))) 16384)
        (dtrsb-score (and (eq (dtrs-promote? unsafe-trials 3) 0)
                           (str_eq (dtrs-baseline-recipe (dtrs-install base unsafe-trials 3))
                                   (dtrs-dsv4-model-id))) 32768))))
