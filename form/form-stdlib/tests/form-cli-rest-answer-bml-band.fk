; form-cli-rest-answer-bml-band.fk — the answering surface, risen: the
; authored BML lowers in memory through the floor, its split agrees with
; the organ token-for-token, the corpus lane answers fresh words and
; exact nothing, the registry lane answers pointers — and the riseproof
; (fra-agree) holds surface and organ as one.
;
; Expected: 15
;   1   fra-agree = 63 — six agreement gates, all live
;   2   the authority binding names the restanswer lawface exactly
;   4   the executable .bml text carries its section and corpus def
;   8   the lawface text carries its package and class
;
; preludes: form-stdlib/form-cli-rest-answer.bml
; witnessed: 2026-08-30 -> 15 on fkwu through the airborne floor

(do
    (defn frab-bit (ok bit) (if ok bit 0))
    (defn frab-has? (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let exec-text (read_file "form/form-stdlib/form-cli-rest-answer.bml"))
    (let law-text (read_file "form/form-stdlib/bml/form-cli-restanswer.bml"))
    (sum (list
        (frab-bit (eq (fra-agree) 63) 1)
        (frab-bit (and (str_eq (RestAnswerSurfacePath)
                           "form/form-stdlib/bml/form-cli-restanswer.bml")
                       (str_eq (RestAnswerSurfaceKind)
                           "high-bml-class-template-field")) 2)
        (frab-bit (and (eq (frab-has? exec-text "section [form.bml]") 1)
                       (eq (frab-has? exec-text "def fra-corpus-word") 1)) 4)
        (frab-bit (and (eq (frab-has? law-text "package Form.cli.restanswer") 1)
                       (eq (frab-has? law-text "class FormRestAnswer") 1)) 8))))
