; host-walk-retry-band.bml — the informed retry: its evidence read as text, its class, its plan, its ladder and its attempts,
; with no launchd, no model and no walk; the plants show each flaw a retry could have is caught.
;
; Verdict 4194303 = 1 stamp-time | 2 launchctl | 4 reports | 8 classes | 16 plan | 32 ladder | 64 child-word | 128 slots
;   | 256 row | 512 door | 1024 attempts | 2048 plants | 4096 safe | 8192 lens | 16384 plists | 32768 state
;   | 65536 heal-classes | 131072 state-effects | 262144 intent | 524288 nits | 1048576 heal-plants | 2097152 launchd-log
;
; The retry (observe/walk-retry.bml over form-stdlib/bml/host-walk-retry.bml, -evidence.bml and -attempt.bml) is the second job
; of each schedule: it reads the first slot's stamp (host-walk-began.bml), and when the slot did not begin it reads why, names a
; class, changes a named variable and begins the walk door as its own child, at most twice. This band holds that with synthetic
; evidence only: the launchctl text is a copy of the shape `launchctl print` printed for the real job (tab-indented first level,
; "last exit reason = OS_REASON_CODESIGNING"), a diagnostic report is a header line and a JSON body of the shape the OS wrote at
; 2026-10-04 03:30:04, and an attempt begins a stub in the walk door's place. Nothing here runs launchctl, a walk, a compiler or a
; model; the band writes only under temp_dir and removes what it made (the door claim writes one row to its scratch record).
;
; stamp-time: a report's "2026-10-04 03:30:04.2316 +0800" reads 1791055804231 (the fraction in whole ms, the zone as written);
; with no fraction, a one-digit fraction (".5" is 500 ms), a west zone and a text that does not read (nothing, never 0).
; launchctl: the first level of the job's block reads state, runs, last exit reason, last exit code, the log paths and the home
; the plist stands in; a nested "state = active" two tabs deep is not the job's state.
; reports: a report row reads its launch, signal, termination namespace and indicator, image names, coalition and life in ms;
; one that is half written or not JSON is nothing, never a stop; a report counts only inside the slot's window and for the
; first job's own label (the legacy job's coalition is another job's); a kill is CODESIGNING, a Launch Constraint Violation,
; Code Signature Invalid, an unreadable executable path, or a SIGKILL within 100 ms; a crash is a crash signal that is not a kill.
; classes: begun beats every piece of evidence; a kill report is launch-killed, and so is launchd's own CODESIGNING reason
; with no report; a crash report is crashed-after-launch (a kill outranks a crash); a log's [walk-lock] "does not start" line is
; held; nothing at all is nothing-found.
; plan: launch-killed is two attempts (a child of the live retry, then a fresh kernel's child), crashed-after-launch one safe
; child, held one wait, nothing-found one captured child after a longer nap; begun plans none; no plan is longer than two.
; ladder: it goes on only after an attempt that died at once, never reaches a third, stops at the first ok, begun or refused,
; and its outcome says "ok: <how>", or "retry-failed" naming what each attempt saw.
; child-word: a child's end reads ok, begun, refused, died-at-once (a birth refused, or a signal or failure within five seconds),
; failed (the same after longer) or stopped (past its deadline).
; slots: the retry at 03:40, 12:40 and 19:10 each finds its own first slot (a start from five to forty-five minutes after it);
; four minutes after and forty-six minutes after find none; a door named by hand finds its latest slot that has begun.
; row: the record row carries the slot, the class and why, the evidence paths, the launchd line, what was changed, each attempt
; and the outcome; the lens line reads "walk retry <hh:mm> <day>: <class> -> <what it did>: <word>", and a row that does not
; read adds no line.
; door: observe/walk-retry.bml run as a child over a scratch stamp, launchctl text and reports directory: a dry run names the
; class and writes its row; a slot whose stamp stands ends "nothing to heal" with no attempt; a clock with no slot due ends
; "nothing to retry".
; attempts: stubs for the walk door: the child's stdin is {} for the first attempt, {"safe":1} for a safe one and carries
; {"again":1} after the first; an exit 0 with the holds line is ok, the lock's refusal and "already began" are read as such, a
; child that killed itself died at once, a fresh attempt whose build failed begins no child, and a wait with a holder alive ends
; refused while one with none runs the child.
; plants: a classifier blind to its evidence, one that ignores that the first slot began, a plan that is the same for every
; class and a ladder that allows a third attempt each fail the checks the real ones keep.
; safe: {"safe":1} and {"again":1} read from a door's stdin; a safe start skips the four model steps (turns, drafts, page,
; movement) and no other; each model step of scheduled-walk.bml and day-turn.bml is guarded by hw-safe-skips?.
; lens: observe/walk-began-run.bml over a scratch stamp file and retry record prints one note with the hours, the gap and the
; last retry's line, then the hours as its last line; with a retry record and no stamp it prints the retry line and ends 0.
; plists: the repo's launchd sources (docs/launchd) and the schedule's table say the same: each first job's label and door, the
; retry job's label and door (observe/walk-retry.bml), the same working directory for both, the first slots of the table as the
; first job's StartCalendarInterval and each of them ten minutes later as the retry's, and no retry job that runs at load.
;
; state: a retry may start 5 to 45 minutes after its slot, so the first slot's stamp is read against the SLOT (no earlier than the
; slot less two minutes, no later than now), not against now: a retry 40 minutes late still finds the stamp; the lock's owner file
; then says running (the stamped pid alive), crashed (the pid gone, the lock never released) or finished (no owner, or another
; walk's); a stamp from before the slot, yesterday's, or from the future is none; with no stamp (a first slot of older code) a live
; owner of the same door that began no earlier than the slot is running, a dead one, another door's or an older one is not.
; heal-classes: a running first slot (the stamp's pid, or launchctl state = running) is begun; a job log written in the slot's
; window by a door that stamps nothing is begun, and a held line outranks it; a stamp whose pid is gone with the lock unreleased is
; crashed-after-launch, its row in the why and a crash report in the paths when one stands; launchctl's last exit reason counts as
; a launch kill only when `runs` advanced past the last retry row's (stale: the same runs, a lower baseline, or no row), and a
; kill report counts whatever the runs say.
; state-effects: hr-state-of over a scratch stamp and lock with this process's pid as the live one and a pid that ended as the dead one.
; intent: hr-retry writes the intent row before the first child begins (a stub attempt reads the record and finds one row, phase
; intent) and the outcome row after, one retry_id on both; a dry retry writes both and begins nothing; a retry that writes its row
; only at the end fails the check.
; nits: every number the reading stands on is a named def with its value pinned (the abs-time ticks per ms, the launch life, the report
; slack, the due range, the naps, the hold, the child output kept, the clips, the log slack and tail, the gap limit); a child's output
; is kept from its last 65536 bytes and a lock line clipped to 300; the reports directory falls back to the HOME the process was
; given when launchctl did not answer; a safe start tells the child {"again":1,"safe":1} (its crashed predecessor's stamp would refuse
; it); the four doors read stdin through hw-stdin (a terminal reads as none, so a hand start waits on no one).
; launchd-log: launchd's own log (`log show`, launchd's lines for the label over the slot's first minute) says "service inactive:
; <label>" when a job ends; a job that ran ends minutes later, so such a line in the first minute with no stamp, no report, no
; refusal and no log line is a launch the OS killed (the 12:30 day-turn of 2026-10-04 left no report): the label is matched at the
; line's end, so the retry job's line is not the first job's; a stamp, a report, a refusal and a log line each outrank it; the
; argv reads the slot's local first minute; the door hands the line in and names launch-killed from it; a classifier deaf to it fails.
; heal-plants: a state read against now, one that ignores the pid's liveness either way, one that ignores the door, a class blind to the
; state, one that trusts a stale exit reason, one blind to the job's log each fail the checks the real ones keep.
;
; REQUIRES: host_spawn_at (children through host-child.bml), fkwu doors.
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/host-walk.bml
section [form.bml] {
 class HostWalkRetryBand {
  def hrb-root(ctx) = ctx[1];
  def hrb-fresh() {
   let root = temp_dir() ++ "/host-walk-retry-band-" ++ now_unix_ms().str();
   (Comparable) host_dir_mkdir(root) == 1 ? ["host-walk-retry", root] : nothing();
  }
  def hrb-bit(held) = held ? 1 : 0;
  def hrb-has?(s, part) = str_find(s, part, 0) >= 0;
  def hrb-io(ctx) = hrb-root(ctx) ++ "/io";
  def hrb-hour(h) = h * 3600000;
  def hrb-zone() = hrb-hour(8);
  // fixed instants: the first slots of 2026-10-04 in a zone eight hours east
  def hrb-slot-night() = 1791055800000;
  def hrb-slot-noon() = hrb-slot-night() + hrb-hour(9);
  def hrb-slot-dusk() = hrb-slot-night() + hrb-hour(15) + 1800000;
  def hrb-tab() = byte_to_str(9);
  // ── synthetic evidence ──
  def hrb-launchd(reason, code, runs) = "gui/501/earth.hati.rent-walk = {\n" ++ hrb-tab() ++ "active count = 0\n" ++ hrb-tab() ++ "path = /Users/ursmuff/Library/LaunchAgents/earth.hati.rent-walk.plist\n" ++ hrb-tab() ++ "type = LaunchAgent\n" ++ hrb-tab() ++ "state = not running\n\n" ++ hrb-tab() ++ "program = /Users/ursmuff/source/coherence-kernel-walk/fkwu\n" ++ hrb-tab() ++ "stdout path = /Users/ursmuff/Library/Logs/CoherenceSense/rent-walk.log\n" ++ hrb-tab() ++ "stderr path = /Users/ursmuff/Library/Logs/CoherenceSense/rent-walk.err.log\n" ++ hrb-tab() ++ "default environment = {\n" ++ hrb-tab() ++ hrb-tab() ++ "PATH => /usr/bin:/bin\n" ++ hrb-tab() ++ "}\n" ++ hrb-tab() ++ "runs = " ++ runs ++ "\n" ++ (reason == "" ? "" : hrb-tab() ++ "last exit reason = " ++ reason ++ "\n") ++ (code == "" ? "" : hrb-tab() ++ "last exit code = " ++ code ++ "\n") ++ hrb-tab() ++ "event triggers = {\n" ++ hrb-tab() ++ hrb-tab() ++ "state = active\n" ++ hrb-tab() ++ "}\n}";
  def hrb-ips(launch, signal, ns, ind, images, coalition, start, exit) = "{\"app_name\":\"fkwu\",\"bug_type\":\"309\"}\n{\n  \"procLaunch\" : \"" ++ launch ++ "\",\n  \"coalitionName\" : \"" ++ coalition ++ "\",\n  \"procStartAbsTime\" : " ++ start.str() ++ ",\n  \"procExitAbsTime\" : " ++ exit.str() ++ ",\n  \"exception\" : {\"type\":\"EXC_CRASH\",\"signal\":\"" ++ signal ++ "\"},\n  \"termination\" : {\"namespace\":\"" ++ ns ++ "\",\"indicator\":\"" ++ ind ++ "\"},\n  \"usedImages\" : [" ++ images ++ "]\n}\n";
  def hrb-lost() = "{\"name\":\"dyld_path_missing\"},{\"name\":\"main_executable_path_missing\"}";
  def hrb-killed-text() = hrb-ips("2026-10-04 03:30:04.2337 +0800", "SIGKILL (Code Signature Invalid)", "CODESIGNING", "Launch Constraint Violation", hrb-lost(), "earth.hati.rent-walk", 3046226328366, 3046226683817);
  def hrb-crash-text() = hrb-ips("2026-10-04 03:31:10.5 +0800", "SIGSEGV (Address size fault)", "SIGNAL", "Segmentation fault: 11", "{\"name\":\"fkwu\"}", "earth.hati.rent-walk", 1000000000, 1216000000);
  def hrb-fast-text() = hrb-ips("2026-10-04 03:30:09.0 +0800", "SIGKILL (Killed: 9)", "SIGNAL", "Killed: 9", "{\"name\":\"fkwu\"}", "earth.hati.rent-walk", 1000000000, 1000480000);
  def hrb-late-text() = hrb-ips("2026-10-04 03:32:00.0 +0800", "SIGKILL (Killed: 9)", "SIGNAL", "Killed: 9", "{\"name\":\"fkwu\"}", "earth.hati.rent-walk", 1000000000, 1480000000);
  def hrb-legacy-text() = hrb-ips("2026-10-04 03:30:04.2316 +0800", "SIGKILL (Code Signature Invalid)", "CODESIGNING", "Launch Constraint Violation", hrb-lost(), "earth.hati.coherence.rent-walk", 3046226277158, 3046226646261);
  def hrb-early-text() = hrb-ips("2026-10-04 05:00:00.0 +0800", "SIGKILL (Code Signature Invalid)", "CODESIGNING", "Launch Constraint Violation", hrb-lost(), "earth.hati.rent-walk", 1000000000, 1000300000);
  def hrb-row-of(name, text) = hr-report-of("/scratch/" ++ name ++ ".ips", text);
  def hrb-label() = "earth.hati.rent-walk";
  def hrb-window() = hw-slot-window-ms();
  def hrb-held-log() = "[walk] 2026-10-03 branch=walk\n[walk-lock] scheduled-walk does not start: day-turn (pid 4242) has walked this checkout for 31 min; one walk at a time\n";
  // ── 1 stamp-time ──
  def hrb-stamp-time(ctx) = hrb-bit(((Comparable) hr-stamp-ms("2026-10-04 03:30:04.2316 +0800") == 1791055804231) && ((Comparable) hr-stamp-ms("2026-10-04 03:30:04 +0800") == 1791055804000) && ((Comparable) hr-stamp-ms("2026-10-04 03:30:04.5 +0800") == 1791055804500) && ((Comparable) hr-stamp-ms("2026-10-03 22:30:04.25 -0500") == 1791084604250) && nothing?(hr-stamp-ms("garbage that is long enough to try")) && nothing?(hr-stamp-ms("2026-10-04")) && nothing?(hr-stamp-ms("")) && nothing?(hr-stamp-ms(nothing())) && hr-stamp-zone("2026-10-04 03:30:04 +0000") == 0 && all?(zone=>nothing?(hr-stamp-zone("2026-10-04 03:30:04 " + zone)),["+++++","+-100","+2500","+0860","UTC",""]) && ((Comparable) hr-days(1970, 1, 1) == 0) && ((Comparable) hr-days(2024, 2, 29) == 19782) && ((Comparable) hr-days(2024, 3, 1) == 19783));
  // ── 2 launchctl ──
  def hrb-launchctl-hold(ctx) {
   let a = hrb-launchd("OS_REASON_CODESIGNING", "", "2");
   let b = hrb-launchd("", "0", "3");
   hrb-bit(((String) hr-launchd-state(a) == "not running") && ((String) hr-launchd-runs(a) == "2") && ((String) hr-launchd-reason(a) == "OS_REASON_CODESIGNING") && ((String) hr-launchd-code(a) == "") && ((String) hr-launchd-out(a) == "/Users/ursmuff/Library/Logs/CoherenceSense/rent-walk.log") && ((String) hr-launchd-err(a) == "/Users/ursmuff/Library/Logs/CoherenceSense/rent-walk.err.log") && ((String) hr-launchd-home(a) == "/Users/ursmuff") && ((String) hr-launchd-runs(b) == "3") && ((String) hr-launchd-code(b) == "0") && ((String) hr-launchd-reason(b) == "") && ((String) hr-launchd-line(a) == "state=not running runs=2 last-exit-reason=OS_REASON_CODESIGNING") && ((String) hr-launchd-state("") == "") && ((String) hr-launchd-home("") == ""));
  }
  // ── 3 reports ──
  def hrb-reports(ctx) {
   let k = hrb-row-of("k", hrb-killed-text());
   let c = hrb-row-of("c", hrb-crash-text());
   let f = hrb-row-of("f", hrb-fast-text());
   let l = hrb-row-of("l", hrb-late-text());
   let g = hrb-row-of("g", hrb-legacy-text());
   let e = hrb-row-of("e", hrb-early-text());
   let slot = hrb-slot-night();
   hrb-bit(!nothing?(k) && !nothing?(c) && !nothing?(f) && !nothing?(l) && !nothing?(g) && ((Comparable) hr-row-launch(k) == 1791055804233) && ((String) hr-row-signal(k) == "SIGKILL (Code Signature Invalid)") && ((String) hr-row-namespace(k) == "CODESIGNING") && ((String) hr-row-indicator(k) == "Launch Constraint Violation") && hrb-has?(hr-row-images(k), "main_executable_path_missing") && ((String) hr-row-coalition(k) == hrb-label()) && ((Comparable) hr-row-life(k) == 14) && ((Comparable) hr-row-life(c) == 9000) && ((Comparable) hr-row-life(l) == 20000)
    && hr-killed?(k) && !hr-crashed?(k) && hr-crashed?(c) && !hr-killed?(c) && hr-killed?(f) && !hr-killed?(l) && !hr-crashed?(l) && hr-killed?(g)
    && nothing?(hr-report-of("/scratch/half.ips", "{\"app_name\":\"fkwu\"}\n{\"procLaunch\" : \"2026-10-04 03:30:0")) && nothing?(hr-report-of("/scratch/none.ips", "not json at all")) && nothing?(hr-report-of("/scratch/empty.ips", "")) && nothing?(hr-report-of("/scratch/bare.ips", "{\"a\":1}\n{\"procLaunch\" : \"2026-10-04 03:30:04.2337 +0800\"}")) && ((String) hr-oneline("a\nb  c ") == "a b c") && ((String) hr-oneline(nothing()) == "")
    && hr-in-window?(k, slot, hrb-window()) && hr-in-window?(c, slot, hrb-window()) && !hr-in-window?(e, slot, hrb-window()) && hr-of-job?(k, hrb-label()) && !hr-of-job?(g, hrb-label())
    && ((String) hr-held-line(hrb-held-log()) == "[walk-lock] scheduled-walk does not start: day-turn (pid 4242) has walked this checkout for 31 min; one walk at a time") && ((String) hr-held-line("[walk-lock] scheduled-walk holds this checkout, pid 5\n") == "") && ((String) hr-held-line(nothing()) == ""));
  }
  // ── 4 classes: the table the real classifier and its blind plants answer ──
  def hrb-classes-hold?(classify) {
   let k = hrb-row-of("k", hrb-killed-text());
   let c = hrb-row-of("c", hrb-crash-text());
   let held = hr-held-line(hrb-held-log());
   ((String) hr-class(classify(hrb-fin(), hrb-launchd("OS_REASON_CODESIGNING", "", "2"), [k], held, false, nothing())) == "begun") && ((String) hr-class(classify(hrb-none(), "", [k], "", false, nothing())) == "launch-killed") && ((String) hr-class(classify(hrb-none(), hrb-launchd("OS_REASON_CODESIGNING", "", "3"), [], "", false, 2)) == "launch-killed")
    && ((String) hr-class(classify(hrb-none(), hrb-launchd("", "", "2"), [c], "", false, nothing())) == "crashed-after-launch") && ((String) hr-class(classify(hrb-none(), hrb-launchd("", "", "2"), [c, k], "", false, nothing())) == "launch-killed") && ((String) hr-class(classify(hrb-none(), hrb-launchd("", "0", "2"), [], held, false, nothing())) == "held")
    && ((String) hr-class(classify(hrb-none(), hrb-launchd("", "0", "2"), [], "", false, nothing())) == "nothing-found") && hrb-has?(hr-why(classify(hrb-none(), "", [k], "", false, nothing())), "Code Signature Invalid") && ((String) hr-paths(classify(hrb-none(), "", [k], "", false, nothing()))[0] == "/scratch/k.ips") && nil?(hr-paths(classify(hrb-fin(), "", [k], "", false, nothing())));
  }
  def hrb-none() = ["", ""];
  def hrb-stamp-row(at) = hw-owner-text("scheduled-walk", 4242, at);
  def hrb-fin() = ["finished", hrb-stamp-row(hrb-slot-night() + 1000)];
  def hrb-run-state() = ["running", hrb-stamp-row(hrb-slot-night() + 1000)];
  def hrb-crash-state() = ["crashed", hrb-stamp-row(hrb-slot-night() + 1000)];
  def hrb-classes(ctx) = hrb-bit(hrb-classes-hold?(hr-classify));
  // ── 5 plan ──
  def hrb-plan-hold?(plan) {
   let a = plan("launch-killed");
   let b = plan("crashed-after-launch");
   let c = plan("held");
   let d = plan("nothing-found");
   ((Comparable) len(a) == 2) && ((String) a[0][2] == "same") && ((String) a[1][2] == "fresh") && ((Comparable) len(b) == 1) && ((String) b[0][2] == "safe") && ((Comparable) len(c) == 1) && ((String) c[0][2] == "wait") && ((Comparable) len(d) == 1) && ((String) d[0][2] == "capture") && ((Comparable) d[0][1] > b[0][1]) && nil?(plan("begun")) && nil?(plan("something-else"));
  }
  def hrb-plan-capped?(plan) = ((Comparable) len(plan("launch-killed")) <= hr-max-attempts()) && ((Comparable) len(plan("crashed-after-launch")) <= hr-max-attempts()) && ((Comparable) len(plan("held")) <= hr-max-attempts()) && ((Comparable) len(plan("nothing-found")) <= hr-max-attempts());
  def hrb-changed-named?() = ((String) hr-changed("launch-killed") != "") && ((String) hr-changed("crashed-after-launch") != "") && ((String) hr-changed("held") != "") && ((String) hr-changed("nothing-found") != "") && ((String) hr-changed("begun") == "") && hrb-has?(hr-changed("crashed-after-launch"), "safe") && hrb-has?(hr-changed("launch-killed"), "fresh") && hrb-has?(hr-changed("launch-killed"), "a new inode") && !hrb-has?(hr-changed("launch-killed"), "signature");
  def hrb-plan(ctx) = hrb-bit(hrb-plan-hold?(hr-plan) && hrb-plan-capped?(hr-plan) && hrb-changed-named?() && ((Comparable) hr-max-attempts() == 2));
  // ── 6 ladder ──
  def hrb-act-dead(spec, k) = hr-attempt-of(spec, 0, "died-at-once", "stub " ++ k.str());
  def hrb-act-ok(spec, k) = hr-attempt-of(spec, 0, "ok", "stub");
  def hrb-act-refused(spec, k) = hr-attempt-of(spec, 0, "refused", "stub");
  def hrb-act-then-ok(spec, k) = k < 2 ? hr-attempt-of(spec, 0, "died-at-once", "stub first") : hr-attempt-of(spec, 0, "ok", "stub second");
  def hrb-plan3() = [["a", 0, "same"], ["b", 0, "same"], ["c", 0, "same"]];
  def hrb-ladder-hold?(ladder) {
   let dead = ladder(hr-plan("launch-killed"), 1, hrb-act-dead, []);
   let long = ladder(hrb-plan3(), 1, hrb-act-dead, []);
   let ok = ladder(hr-plan("launch-killed"), 1, hrb-act-ok, []);
   let refused = ladder(hr-plan("launch-killed"), 1, hrb-act-refused, []);
   let then = ladder(hr-plan("launch-killed"), 1, hrb-act-then-ok, []);
   ((Comparable) len(dead) == 2) && ((Comparable) len(long) == 2) && ((Comparable) len(ok) == 1) && ((Comparable) len(refused) == 1) && ((Comparable) len(then) == 2) && ((String) then[1][2] == "ok") && nil?(ladder([], 1, hrb-act-dead, []));
  }
  def hrb-ladder(ctx) {
   let dead = hr-ladder(hr-plan("launch-killed"), 1, hrb-act-dead, []);
   let then = hr-ladder(hr-plan("launch-killed"), 1, hrb-act-then-ok, []);
   hrb-bit(hrb-ladder-hold?(hr-ladder) && ((String) hr-outcome("launch-killed", then) == "ok: fresh-binary-child") && ((String) hr-outcome("begun", []) == "nothing to heal: the first slot began") && hrb-has?(hr-outcome("launch-killed", dead), "retry-failed: attempt 1 (child-of-the-retry): died-at-once stub 1; attempt 2 (fresh-binary-child): died-at-once stub 2") && hrb-has?(hr-outcome("nothing-found", []), "no attempt") && hr-continue?("died-at-once") && !hr-continue?("failed") && !hr-continue?("ok") && !hr-continue?("refused") && !hr-continue?("stopped"));
  }
  // a ladder that allows a third attempt
  def hrb-ladder3(plan, k, act, seen) = nil?(plan) || k > 3 ? seen : hrb-ladder3-next(plan, k, act, append(seen, [act(plan[0], k)]));
  def hrb-ladder3-next(plan, k, act, seen) = hr-continue?(seen[len(seen) - 1][2]) ? hrb-ladder3(plan[1:], k + 1, act, seen) : seen;
  // ── 7 child-word ──
