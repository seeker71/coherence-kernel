 let ctx = hrb-fresh();
 nothing?(ctx) ? form_error("host-walk-retry band needs a fresh directory under temp_dir") : 0;
 let verdict = live-claims("host-walk-retry-band", ctx, [["stamp-time", 1, 1, hrb-stamp-time], ["launchctl", 2, 1, hrb-launchctl-hold], ["reports", 4, 1, hrb-reports], ["classes", 8, 1, hrb-classes], ["plan", 16, 1, hrb-plan], ["ladder", 32, 1, hrb-ladder], ["child-word", 64, 1, hrb-child-word], ["slots", 128, 1, hrb-slots], ["row", 256, 1, hrb-row], ["door", 512, 1, hrb-door-claims], ["attempts", 1024, 1, hrb-attempts], ["plants", 2048, 1, hrb-plants], ["safe", 4096, 1, hrb-safe], ["lens", 8192, 1, hrb-lens], ["plists", 16384, 1, hrb-plists], ["state", 32768, 1, hrb-state], ["heal-classes", 65536, 1, hrb-heal-classes], ["state-effects", 131072, 1, hrb-state-effects], ["intent", 262144, 1, hrb-intent], ["nits", 524288, 1, hrb-nits], ["heal-plants", 1048576, 1, hrb-heal-plants], ["launchd-log", 2097152, 1, hrb-launchd-log]]);
 host_dir_rmdir(hrb-root(ctx));
 verdict;
}
