; living-world-active-learning-loop-witness.fk -- derived separating enquiries
; become recurrent placements, successor tissue, and an identity-clean
; prospective comparison without importing a winner or promotion decision.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-prospective-suite.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk

(let LWHLW-RESULT (bp "LWHLW-RESULT"))

(defn lwhlw-trial-for-bindings (items bindings)
    (if (eq (len items) 0) (lwo-none)
        (if (node_eq (lwhe-trial-bindings (head items)) bindings)
            (head items)
            (lwhlw-trial-for-bindings (tail items) bindings))))

(defn lwhlw-diff-dependency-entries (source)
    (list
        (lwpsw-entry source (lwpsw-diff-role "left"))
        (lwpsw-entry source (lwpsw-diff-role "right"))
        (lwpsw-entry source (intern_trivial_int 5))
        (lwpsw-entry source (intern_trivial_int 2))
        (lwpsw-entry source (lwpsw-diff-left))
        (lwpsw-entry source (lwpsw-diff-right))))

(defn lwhlw-space (candidate)
    (lwhe-space candidate
        (lwo-field
            (list (lwhew-non-bindings)
                  (lwphw-probe-bindings)
                  (lwpsw-diff-bindings)))
        (lwo-field (list (lwphw-alternative)))
        (lwlc-unknown (lwhew-evidence)) (lwhew-lens) (lwhew-evidence)))

; children: final world, incumbent/arriving candidates, enquiry, two selected
; trials, two placements, tissue, suite, evaluations, comparison.
(defn lwhlw-result
    (world incumbent arriving enquiry first-trial second-trial first-placement
     second-placement tissue suite incumbent-eval arriving-eval comparison)
    (intern_node LWHLW-RESULT
        (list world incumbent arriving enquiry first-trial second-trial
              first-placement second-placement tissue suite incumbent-eval
              arriving-eval comparison)))

(defn lwhlw-run ()
    (do
        (let started
            (lcfb-open-stream "living-world-active-learning-loop" "form-native"
                "lwhlw-run" "enquiry-to-successor-prospective"
                "form/form-stdlib/tests/living-world-active-learning-loop-witness.fk"
                45 1))
        (let field-fixture (lwphw-integrated-field))
        (let field-model (lwphw-field-candidate field-fixture))
        (let field-shape (lwphw-field-shape field-fixture))
        (let base (lwt-round-world (lwphw-field-round field-fixture)))
        (let first-dependencies (lwphw-probe-dependencies base (empty)))
        (let aligned-dependencies (lwhew-non-dependencies first-dependencies))
        (let all-dependencies
            (lwt-receive-stream aligned-dependencies
                (append
                    (lwhlw-diff-dependency-entries (lwpsw-source-a))
                    (lwhlw-diff-dependency-entries (lwpsw-source-b)))))
        (let space (lwhlw-space field-model))
        (let space-world
            (lwt-receive-stream all-dependencies
                (list (lwphw-entry-k space) (lwphw-entry-l space))))
        (let enquiry (lwhe-enquiry-for space-world space 2))
        (let first-trial
            (lwhlw-trial-for-bindings
                (lwo-field-items (lwhe-enquiry-separating enquiry))
                (lwphw-probe-bindings)))
        (let second-trial
            (lwhlw-trial-for-bindings
                (lwo-field-items (lwhe-enquiry-separating enquiry))
                (lwpsw-diff-bindings)))
        (let space-frame
            (lcfb-call-stream "living-world-active-learning-loop" "enquiry"
                "leave" "form-native" "lwhe-enquiry-for"
                "bindings:3:separating:2:aligned:1" 1 started
                "form/form-stdlib/tests/living-world-active-learning-loop-witness.fk"
                74 1))
        (let timeout
            (oac-timeout (intern_trivial_int 10) (oac-no-default)
                (lwhew-evidence)))
        (let first-request
            (lwhe-request enquiry (oac-one first-trial) timeout
                (lwhew-evidence) (lwhew-lens)))
        (let second-request
            (lwhe-request enquiry (oac-one second-trial) timeout
                (lwhew-evidence) (lwhew-lens)))
        (let first-probe
            (lwhe-probe-from-request first-request (intern_trivial_int 7)
                (oac-one (intern_trivial_int 7))
                (lwo-field (list (lwphw-alternative)))
                (lwlc-unknown (lwhew-evidence)) (lwhew-evidence)))
        (let first-world
            (lwt-receive-stream space-world
                (list (lwphw-entry-k first-probe)
                      (lwphw-entry-l first-probe))))
        (let first-placement (lwph-placement-for first-world first-probe 2))
        (let first-proposal (lwph-probe-proposal first-world first-probe 2))
        (let first-answered
            (lwphw-answered-round first-world first-proposal
                (lwphw-field-round field-fixture)))
        (let first-integrated
            (lwph-probe-integrate first-answered first-proposal
                (lwphw-action)))
        (let second-probe
            (lwhe-probe-from-request second-request (intern_trivial_int 7)
                (oac-one (intern_trivial_int 7))
                (lwo-field (list (lwphw-alternative)))
                (lwlc-unknown (lwhew-evidence)) (lwhew-evidence)))
        (let second-world
            (lwt-receive-stream (lwt-round-world first-integrated)
                (list (lwpsw-entry (lwpsw-source-a) second-probe)
                      (lwpsw-entry (lwpsw-source-b) second-probe))))
        (let second-placement
            (lwph-placement-for second-world second-probe 2))
        (let second-proposal
            (lwph-probe-proposal second-world second-probe 2))
        (let second-answered
            (lwphw-answered-round second-world second-proposal
                first-integrated))
        (let second-integrated
            (lwph-probe-integrate second-answered second-proposal
                (lwphw-action)))
        (let placements-frame
            (lcfb-call-stream "living-world-active-learning-loop" "placements"
                "leave" "form-native" "lwhe-probe-from-request/lwph-probe-integrate"
                "placements:2:confirmed-each:2:diverged-each:2" 2 started
                "form/form-stdlib/tests/living-world-active-learning-loop-witness.fk"
                125 1))
        (let tissue-world (lwt-round-world second-integrated))
        (let tissue (lwht-tissue-for tissue-world field-model 2))
        (let tissue-proposal (lwht-proposal tissue-world field-model 2))
        (let tissue-model (lwt-proposal-candidate tissue-proposal))
        (let tissue-answered
            (lwphw-answered-round tissue-world tissue-proposal
                second-integrated))
        (let tissue-integrated
            (lwht-integrate tissue-answered tissue-proposal (lwphw-action)))
        (let models
            (lwpsw-models (lwt-round-world tissue-integrated)
                field-model field-shape tissue-model tissue))
        (let incumbent (lwpsw-incumbent models))
        (let arriving (lwpsw-arriving models))
        (let tissue-frame
            (lcfb-call-stream "living-world-active-learning-loop" "successor"
                "leave" "form-native" "lwht-tissue-for/lwht-integrate"
                "incumbent:4:successor:2" 3 started
                "form/form-stdlib/tests/living-world-active-learning-loop-witness.fk"
                145 1))
        (let suite (lwpsw-suite))
        (let observed
            (lwt-receive-stream (lwpsw-model-world models)
                (append
                    (lwpsw-suite-entries (lwpsw-source-a) incumbent arriving)
                    (lwpsw-suite-entries (lwpsw-source-b) incumbent arriving))))
        (let incumbent-eval (lwps-evaluate observed incumbent suite 2))
        (let arriving-eval (lwps-evaluate observed arriving suite 2))
        (let comparison (lwps-compare incumbent-eval arriving-eval))
        (let compare-frame
            (lcfb-call-stream "living-world-active-learning-loop" "prospective"
                "leave" "form-native" "lwps-evaluate/lwps-compare"
                "admissible:1:exact-delta:3:plural-delta:-3:no-promotion" 4 started
                "form/form-stdlib/tests/living-world-active-learning-loop-witness.fk"
                160 1))
        (lwhlw-result observed incumbent arriving enquiry first-trial
            second-trial first-placement second-placement tissue suite
            incumbent-eval arriving-eval comparison)))
