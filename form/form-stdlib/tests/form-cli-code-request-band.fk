; Request admission and callable live dependency chain; never admits a model.
; Expected 255.
; preludes: form-stdlib/bml/form-cli-code-request.bml
(do
 (defn fcaqb-bit (ok bit) (if ok bit 0))
 (defn fcaqb-assert (name ok) (if ok 1 (form_error (str_concat "request boundary: " name))))
 (defn fcaqb-bomb (contract docs) (form_error "fresh evaluation consulted continuity"))
 (let docs (list (list "config" "config.json" "{\"enabled\":true}")))
 (let checks (node_children (faj-json "checks" "[{\"tool\":\"jq\",\"arguments\":[\".enabled\",\"config.json\"],\"stdout\":\"true\\n\"}]")))
 (let review (faj-json "review" "{\"mode\":\"review\",\"goal\":\"Inspect without editing\",\"writable\":[],\"checks\":[{\"tool\":\"jq\",\"arguments\":[\".enabled\",\"config.json\"],\"stdout\":\"true\\n\"}],\"report_checks\":[{\"tool\":\"jq\",\"arguments\":[\".found\"],\"stdout\":\"true\\n\"}]}"))
 (let checker (fcaq-checker review))
 (let wordCheck (faj-json "word-range" "{\"kind\":\"word-range\",\"path\":\"answer.md\",\"minimum\":2,\"maximum\":3}"))
 (fcaqb-assert "word range admits ordered integer bounds" (fcaq-check-valid wordCheck))
 (fcaqb-assert "word range includes both edges and UTF-8 words" (and (head (fcaq-check (list wordCheck) (list (list "answer" "answer.md" "été\tآری")))) (head (fcaq-check (list wordCheck) (list (list "answer" "answer.md" "#\tété\nآری\r\n"))))))
 (fcaqb-assert "word range reports actual overlong count" (ge (str_find (nth (fcaq-check (list wordCheck) (list (list "answer" "answer.md" "one two three four"))) 1) "\"observed_words\":4" 0) 0))
 (fcaqb-assert "word range rejects either unmet edge" (and (not (head (fcaq-check (list wordCheck) (list (list "answer" "answer.md" "one"))))) (not (head (fcaq-check (list wordCheck) (list (list "answer" "answer.md" "one two three four")))))))
 (let emptyCheck (oh-set (oh-set wordCheck "minimum" (json-node-int 0)) "maximum" (json-node-int 0)))
 (fcaqb-assert "missing document is distinct from zero words" (and (head (fcaq-check (list emptyCheck) (list (list "answer" "answer.md" " \n\t")))) (not (head (fcaq-check (list emptyCheck) (list))))))
 (fcaqb-assert "word range rejects reversed negative and noninteger bounds" (and (not (fcaq-check-valid (oh-set wordCheck "maximum" (json-node-int 1)))) (and (not (fcaq-check-valid (oh-set wordCheck "minimum" (json-node-int -1)))) (and (not (fcaq-check-valid (oh-set wordCheck "minimum" (json-node-string "2")))) (not (fcaq-check-valid (oh-set wordCheck "maximum" (parse-json "fraction" "3.5"))))))))
 (fcaqb-assert "word range cannot replace document bytes with stdin" (not (fcaq-check-valid (oh-set wordCheck "input" (json-node-string "one two")))))
 (fcaqb-assert "word range is a document check, not a report tool" (not (fcaq-report-check-valid wordCheck)))
 (fcaqb-assert "word range keeps subsequent assertions" (not (head (fcaq-check (cons wordCheck checks) (list (list "answer" "answer.md" "one two"))))))
 (let wordChecker (list fcaq-check (list wordCheck)))
 (let wordState (fcap-open-direct-code "Shorten the answer" (list (list "answer" "answer.md" "one two three four five")) (list "answer.md")))
 (let wordEdited (fcap-step wordState "{\"tool\":\"edit\",\"arguments\":[\"answer.md\",\"one two three four five\",\"one two three four\"]}" wordChecker))
 (let wordDone (fcap-step wordEdited "{\"task\":\"done\"}" wordChecker))
 (fcaqb-assert "overlong changed document returns to repair before review" (and (str_eq (fcap-stage wordDone) "repair") (and (eq (fcap-checks wordDone) 1) (ge (str_find (fcap-observation wordDone) "observed_words" 0) 0))))
 (fcaqb-assert "ordinary requests need no reasoning option" (fcaq-request-valid review))
 (fcaqb-assert "positive reply token limit admitted" (fcaq-request-valid (oh-set review "max_reply_tokens" (json-node-int 17))))
 (fcaqb-assert "zero reply token limit refused" (not (fcaq-request-valid (oh-set review "max_reply_tokens" (json-node-int 0)))))
 (fcaqb-assert "negative reply token limit refused" (not (fcaq-request-valid (oh-set review "max_reply_tokens" (json-node-int -1)))))
 (fcaqb-assert "fractional reply token limit refused" (not (fcaq-request-valid (oh-set review "max_reply_tokens" (parse-json "fraction" "1.5")))))
 (fcaqb-assert "float spelling is not an integer allowance" (not (fcaq-request-valid (oh-set review "max_reply_tokens" (parse-json "float" "17.0")))))
 (fcaqb-assert "fractional reasoning limit refused" (not (fcaq-request-valid (oh-set review "initial_reasoning_tokens" (parse-json "fraction" "1.5")))))
 (fcaqb-assert "string reply token limit refused" (not (fcaq-request-valid (oh-set review "max_reply_tokens" (json-node-string "17")))))
 (fcaqb-assert "null reply token limit refused" (not (fcaq-request-valid (oh-set review "max_reply_tokens" (json-node-null)))))
 (let tokenRequest (oh-set review "max_reply_tokens" (json-node-int 17)))
 (let tokenState (fcaq-initial tokenRequest (list)))
 (fcaqb-assert "request allowance is carried in state" (eq (fcap-reply-token-limit tokenState) 17))
 (fcaqb-assert "allowance survives native checkpoint" (eq (fcap-reply-token-limit (fcam-unpack (bytes_to_recipe (recipe_to_bytes (fcam-pack tokenState))))) 17))
 (fcaqb-assert "resume caller may replace allowance" (eq (fcap-reply-token-limit (fcaq-context-state (oh-set tokenRequest "max_reply_tokens" (json-node-int 9)) tokenState)) 9))
 (fcaqb-assert "omission restores context-only allowance" (eq (fcap-reply-token-limit (fcaq-context-state review tokenState)) 0))
 (fcaqb-assert "explicit bounded initial reasoning admitted" (fcaq-request-valid (oh-set review "initial_reasoning_tokens" (json-node-int 4096))))
 (fcaqb-assert "zero reasoning budget is refused" (not (fcaq-request-valid (oh-set review "initial_reasoning_tokens" (json-node-int 0)))))
 (fcaqb-assert "negative reasoning budget is refused" (not (fcaq-request-valid (oh-set review "initial_reasoning_tokens" (json-node-int -1)))))
 (fcaqb-assert "oversized reasoning budget is refused" (not (fcaq-request-valid (oh-set review "initial_reasoning_tokens" (json-node-int (add (hearth-code-initial-reasoning-limit) 1))))))
 (fcaqb-assert "reasoning budget is typed" (not (fcaq-request-valid (oh-set review "initial_reasoning_tokens" (json-node-string "4096")))))
 (fcaqb-assert "reasoning null does not silently select a default" (not (fcaq-request-valid (oh-set review "initial_reasoning_tokens" (json-node-null)))))
 (let reserved (oh-set (oh-set review "initial_reasoning_tokens" (json-node-int 512)) "reasoning_answer_tokens" (json-node-int 1024)))
 (fcaqb-assert "explicit answer reserve admitted with initial reasoning" (fcaq-request-valid reserved))
 (fcaqb-assert "answer reserve requires reasoning" (not (fcaq-request-valid (oh-set review "reasoning_answer_tokens" (json-node-int 1024)))))
 (fcaqb-assert "answer reserve cannot bypass invalid initial allowance" (not (fcaq-request-valid (oh-set reserved "initial_reasoning_tokens" (json-node-null)))))
 (fcaqb-assert "answer reserve refuses zero negative fractional and oversized allowances"
  (and (not (fcaq-request-valid (oh-set reserved "reasoning_answer_tokens" (json-node-int 0))))
   (and (not (fcaq-request-valid (oh-set reserved "reasoning_answer_tokens" (json-node-int -1))))
    (and (not (fcaq-request-valid (oh-set reserved "reasoning_answer_tokens" (parse-json "fraction" "1.5"))))
     (not (fcaq-request-valid (oh-set reserved "reasoning_answer_tokens" (json-node-int (add (hearth-code-initial-reasoning-limit) 1)))))))))
 (fcaqb-assert "answer reserve rejects string null and float spelling"
  (and (not (fcaq-request-valid (oh-set reserved "reasoning_answer_tokens" (json-node-string "1024"))))
   (and (not (fcaq-request-valid (oh-set reserved "reasoning_answer_tokens" (json-node-null))))
    (not (fcaq-request-valid (oh-set reserved "reasoning_answer_tokens" (parse-json "float" "1024.0")))))))
 (fcaqb-assert "reply ceiling still caps each reserved stage" (and (eq (fcac-token-allowance tokenState 512) 17) (eq (fcac-token-allowance tokenState 1024) 17)))
 (let reservedSession (fcms-session "live" "fixture" "synthetic" "" (list "ctx") (list "state") 100 14 77 1 10 4 3 1))
 (let reservedFirst (fcms-generation "private reasoning" (list 5 6) reservedSession))
 (let reservedFinal (fcms-generation "final report" (list 0 1) reservedSession))
 (let reservedComplete (frbg-result reservedSession reservedFirst reservedFinal "final report" "controller-final-stage" "stage observation" 1 "complete"))
 (fcaqb-assert "reserved route selects only complete final text" (value_eq (fcacr-reserved-answer reservedComplete) (list 1 "final report" "")))
 (let reservedPartial (frbg-result reservedSession reservedFirst reservedFinal "partial private report" "controller-final-stage" "stage observation" 0 "final-generation-incomplete"))
 (fcaqb-assert "incomplete reserved output supplies no action text" (and (not (head (fcacr-reserved-answer reservedPartial))) (str_eq (nth (fcacr-reserved-answer reservedPartial) 1) "")))
 (let unstopped (fcms-with-stream reservedSession 14 77 0 4 3 1))
 (fcaqb-assert "completion flag alone cannot admit an unstopped stream" (not (head (fcacr-reserved-answer (frbg-result unstopped reservedFirst reservedFinal "partial" "controller-final-stage" "" 1 "complete")))))
 (fcaqb-assert "missing request file is an explicit refusal" (ge (str_find (fcaq-command "@/nonexistent-form-request-file.json") "request-file-unavailable-or-oversized" 0) 0))
 (let state (fcap-note-at (fcaq-initial review docs) "review" "source inspected"))
 (let done (fcap-step state "{\"verdict\":\"accept\",\"report\":\"{\\\"found\\\":true}\"}" checker))
 (fcaqb-assert "review checks source and returned report" (and (fcaq-request-valid review) (and (str_eq (fcap-stage done) "complete") (value_eq (fcap-docs done) docs))))
 (fcaqb-assert "report assertions actually run" (str_eq (fcap-stage (fcap-step state "{\"verdict\":\"accept\",\"report\":\"{\\\"found\\\":false}\"}" checker)) "repair"))
 (let mismatched (fcap-step state "{\"found\":false}" checker))
 (fcaqb-assert "report repair can submit a checked correction immediately" (and (str_eq (fcap-stage (fcap-step mismatched "{\"report\":{\"found\":true}}" checker)) "complete") (value_eq (fcap-docs (fcap-step mismatched "{\"report\":{\"found\":true}}" checker)) docs)))
 (fcaqb-assert "report repair cannot accept a still-false report" (str_eq (fcap-stage (fcap-step mismatched "{\"report\":{\"found\":false}}" checker)) "repair"))
 (let sourceMismatch (fcaq-checker (oh-set review "checks" (faj-json "checks" "[{\"tool\":\"jq\",\"arguments\":[\".enabled\",\"config.json\"],\"stdout\":\"false\\n\"}]"))))
 (fcaqb-assert "corrected report still reruns source checks" (str_eq (fcap-stage (fcap-step mismatched "{\"report\":{\"found\":true}}" sourceMismatch)) "repair"))
 (let codeRepair (fcap-rework (fcap-open "change config" docs (list "config.json")) "unresolved implementation"))
 (fcaqb-assert "a report cannot complete coding repair" (str_eq (fcap-stage (fcap-step codeRepair "{\"report\":{\"found\":true}}" checker)) "repair"))
 (let mismatch (fcaq-report-failure (faj-json "expected" "{\"tool\":\"jq\",\"arguments\":[\".found\"],\"stdout\":\"private-expected-answer\"}") (fat-result 0 "observed-value" "" (list))))
 (fcaqb-assert "report mismatch names check and observation without expected stdout" (and (ge (str_find mismatch "Report value mismatch" 0) 0) (and (ge (str_find mismatch ".found" 0) 0) (and (ge (str_find mismatch "observed-value" 0) 0) (lt (str_find mismatch "private-expected-answer" 0) 0)))))
 (fcaqb-assert "tool failure is not described as a value mismatch" (lt (str_find (fcaq-report-failure (head checks) (fat-result 2 "" "invalid query" (list))) "Report value mismatch" 0) 0))
 (fcaqb-assert "review rejects writable sources" (not (fcaq-request-valid (oh-set review "writable" (json-node-array (list (json-node-string "config.json")))))))
 (fcaqb-assert "review needs report assertions" (not (fcaq-request-valid (oh-set review "report_checks" (json-node-array (list))))))
 (fcaqb-assert "caller cannot replace report stdin" (not (fcaq-report-checks-valid (list (faj-json "bad" "{\"tool\":\"jq\",\"arguments\":[\".found\"],\"input\":\"{}\",\"stdout\":\"true\\n\"}")))))
 (let replayCheck (faj-json "native-replay-check" "{\"kind\":\"provider-usage-sequences\"}"))
 (fcaqb-assert "native replay check is offered through review requests" (fcaq-request-valid (oh-set review "report_checks" (json-node-array (list replayCheck)))))
 (fcaqb-assert "native replay cannot replace the submitted report" (not (fcaq-report-checks-valid (list (oh-set replayCheck "input" (json-node-string "{}"))))))
 (let replayMismatch "{\"findings\":[{\"sequence\":{\"thread_id\":\"selected\",\"turn_id\":\"selected\",\"events\":[{}],\"claimed_status\":\"observed-prefix\"}}]}")
 (let replayMatch "{\"findings\":[{\"sequence\":{\"thread_id\":\"selected\",\"turn_id\":\"selected\",\"events\":[{}],\"claimed_status\":\"unobserved\"}}]}")
 (fcaqb-assert "native replay contradicts a claimed accepted snapshot" (eq (head (fcaq-report-check (list replayCheck) replayMismatch)) 0))
 (fcaqb-assert "native replay observes the actual ignored-event status" (eq (head (fcaq-report-check (list replayCheck) replayMatch)) 1))
 (fcaqb-assert "native replay keeps subsequent report assertions" (eq (head (fcaq-report-check (cons replayCheck (fcap-array review "report_checks")) replayMatch)) 0))
 (fcaqb-assert "report cannot read source documents" (eq (head (fcaq-report-check checks "{\"found\":true}")) 0))
 (fcaqb-assert "mode is typed and known" (not (fcaq-request-valid (oh-set review "mode" (json-node-string "unknown")))))
 (fcaqb-assert "evaluation is a numeric flag" (not (fcaq-request-valid (oh-set review "evaluation" (json-node-string "1")))))
 (let sustained (oh-set (oh-set review "reasoning_tokens" (json-node-int 512)) "reasoning_answer_tokens" (json-node-int 1024)))
 (fcaqb-assert "continuing reasoning reaches native policy" (and (fcaq-request-valid sustained) (value_eq (fcap-reasoning (fcaq-initial sustained docs)) (list 512 1024))))
 (fcaqb-assert "continuing and initial-only reasoning cannot conflict" (not (fcaq-request-valid (oh-set sustained "initial_reasoning_tokens" (json-node-int 512)))))
 (fcaqb-assert "continuing reasoning requires an answer reserve" (not (fcaq-request-valid (oh-set review "reasoning_tokens" (json-node-int 512)))))
 (fcaqb-assert "continuing reasoning rejects zero oversized and textual limits" (and (not (fcaq-request-valid (oh-set sustained "reasoning_tokens" (json-node-int 0)))) (and (not (fcaq-request-valid (oh-set sustained "reasoning_tokens" (json-node-int (add (hearth-code-initial-reasoning-limit) 1))))) (not (fcaq-request-valid (oh-set sustained "reasoning_tokens" (json-node-string "512")))))))
 (fcaqb-assert "continuing reasoning defaults to absent" (value_eq (fcap-reasoning (fcaq-initial review docs)) (list 0 0)))
 (let evaluation (oh-set review "evaluation" (json-node-int 1)))
 (fcaqb-assert "evaluation refuses resume" (not (fcaq-request-valid (oh-set evaluation "resume" (json-node-string "old")))))
 (let absentRoot (str_concat "/tmp/form-code-evaluation-unused-" (int_to_str (host_pid))))
 (let codeRequest (faj-json "code" "{\"goal\":\"Enable local coding\",\"writable\":[\"config.json\"],\"checks\":[{\"tool\":\"jq\",\"arguments\":[\".enabled\",\"config.json\"],\"stdout\":\"true\\n\"}],\"evaluation\":1}"))
 (let codeDirect (oh-set codeRequest "code_entry" (json-node-string "direct")))
 (let nativeBudget (oh-set codeDirect "native_rehearsal_checks" (json-node-int 8)))
 (fcaqb-assert "caller rehearsal allowance reaches native policy" (and (fcaq-request-valid nativeBudget) (eq (fcap-rehearsal-budget (fcaq-initial nativeBudget docs)) 8)))
 (fcaqb-assert "rehearsal is disabled by default" (eq (fcap-rehearsal-budget (fcaq-initial codeDirect docs)) 0))
 (fcaqb-assert "rehearsal refuses oversized negative fractional and string allowances" (and (not (fcaq-request-valid (oh-set codeDirect "native_rehearsal_checks" (json-node-int 65)))) (and (not (fcaq-request-valid (oh-set codeDirect "native_rehearsal_checks" (json-node-int -1)))) (and (not (fcaq-request-valid (oh-set codeDirect "native_rehearsal_checks" (parse-json "fraction" "1.5")))) (not (fcaq-request-valid (oh-set codeDirect "native_rehearsal_checks" (json-node-string "8"))))))))
 (fcaqb-assert "review cannot enable source rehearsal" (not (fcaq-request-valid (oh-set review "native_rehearsal_checks" (json-node-int 8)))))
 (fcaqb-assert "coding keeps the staged default" (and (fcaq-request-valid codeRequest) (str_eq (fcap-stage (fcaq-initial codeRequest docs)) "refine")))
 (fcaqb-assert "explicit direct coding begins implementation without continuity" (and (fcaq-request-valid codeDirect) (str_eq (fcap-stage (fcaq-prepare codeDirect docs (list fcaqb-bomb "") absentRoot)) "implement")))
 (fcaqb-assert "explicit staged coding remains available" (str_eq (fcap-stage (fcaq-initial (oh-set codeRequest "code_entry" (json-node-string "staged")) docs)) "refine"))
 (fcaqb-assert "code entry is typed and known" (and (not (fcaq-request-valid (oh-set codeRequest "code_entry" (json-node-int 1)))) (not (fcaq-request-valid (oh-set codeRequest "code_entry" (json-node-string "unknown"))))))
 (fcaqb-assert "review cannot acquire a coding entry" (not (fcaq-request-valid (oh-set review "code_entry" (json-node-string "direct")))))
 (fcaqb-assert "coding cannot acquire a review entry" (not (fcaq-request-valid (oh-set codeDirect "review_entry" (json-node-string "direct")))))
 (let fresh (fcaq-prepare evaluation docs (list fcaqb-bomb "") absentRoot))
 (let direct (oh-set evaluation "review_entry" (json-node-string "direct")))
 (let directState (fcaq-initial direct docs))
 (fcaqb-assert "direct structured report uses the same checker" (str_eq (fcap-stage (fcap-step directState "{\"found\":true}" checker)) "complete"))
 (fcaqb-assert "structured wrong report still fails" (str_eq (fcap-stage (fcap-step directState "{\"found\":false}" checker)) "repair"))
 (fcaqb-assert "wrapped object report is admitted" (str_eq (fcap-stage (fcap-step directState "{\"verdict\":\"accept\",\"report\":{\"found\":true}}" checker)) "complete"))
 (fcaqb-assert "reply diagnostics exclude private content" (lt (str_find (json-emit (fcap-reply-shape directState "{\"found\":true,\"answer\":\"private-sentinel\"}" done)) "private-sentinel" 0) 0))
 (fcaqb-assert "direct review preserves checks and documents" (and (fcaq-request-valid direct) (and (str_eq (fcap-stage directState) "review") (value_eq (fcap-docs (fcap-step directState "{\"verdict\":\"accept\",\"report\":\"{\\\"found\\\":true}\"}" checker)) docs))))
 (fcaqb-assert "direct review does not admit a false report" (str_eq (fcap-stage (fcap-step directState "{\"verdict\":\"accept\",\"report\":\"{\\\"found\\\":false}\"}" checker)) "repair"))
 (fcaqb-assert "direct review remains read-only" (not (fcap-tool-allowed directState "write" (list "config.json"))))
 (fcaqb-assert "review entry is typed and known" (and (not (fcaq-request-valid (oh-set direct "review_entry" (json-node-int 1)))) (not (fcaq-request-valid (oh-set direct "review_entry" (json-node-string "unknown"))))))
 (fcaqb-assert "coding does not accept a review entry" (not (fcaq-request-valid (oh-set direct "mode" (json-node-string "code")))))
 (fcaqb-assert "evaluation bypasses recall and checkpoint creation" (and (not (fcam-managed fresh)) (and (eq (fcam-hits fresh) 0) (and (str_eq (fcap-stage fresh) "refine") (not (fs-exists? absentRoot))))))
 (let result (faj-json "result" (fcaq-result-core (list done 1 0 0 0))))
 (fcaqb-assert "report and mode reach the agent interface" (and (str_eq (fcap-string result "mode") "review") (str_eq (fcap-string result "report") "{\"found\":true}")))
 (sum (list
  (fcaqb-bit (fcaq-checks-valid checks) 1)
  (fcaqb-bit (eq (head (fcaq-check checks docs)) 1) 2)
  (fcaqb-bit (eq (head (fcaq-check checks (list (list "config" "config.json" "{}")))) 0) 4)
  (fcaqb-bit (not (fcaq-check-valid (faj-json "bad" "{\"tool\":\"write\",\"arguments\":[\"x\"],\"stdout\":\"\"}"))) 8)
  (fcaqb-bit (not (fcaq-request-valid (faj-json "bad" "{\"goal\":\"x\",\"writable\":[],\"checks\":[]}"))) 16)
  (fcaqb-bit (ge (str_find (fcaq-call "no") "invalid-or-oversized" 0) 0) 32)
  (fcaqb-bit (not (fcac-model-ready "absent-model")) 64)
  (fcaqb-bit (ge (str_find (fcaq-help) "resident documents" 0) 0) 128))))
