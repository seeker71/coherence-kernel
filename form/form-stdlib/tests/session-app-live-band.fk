; preludes: form-stdlib/core.fk form-stdlib/session-evidence.fk form-stdlib/session-app.fk form-stdlib/session-app-live.fk
;
; The HTTP and browser membrane is still ordinary Form data before a socket
; carries it. Verdict 524287 proves its bounded request, response, body, edit,
; CSV, and human-surface shapes across all four walkers.
(do
    (defn salb-score (yes bit) (if yes bit 0))
    (defn session-app-live-band ()
        (do
            (let raw "POST /save?id=20260817-1 HTTP/1.1\r\nContent-Length: 17\r\n\r\ntitle=One&text=Hi")
            (let csv "start,end,text\n0,600,\" book.\"\n600,1200,\" hello.\"\n")
            (let wire (sal-wire 200 "text/plain" "alive"))
            (let attention (sal-attention-html "recording-interrupted"))
            (sum (list
                (salb-score (str_eq (sal-method raw) "POST") 1)
                (salb-score (str_eq (sal-path-only (sal-target raw)) "/save") 2)
                (salb-score (str_eq (sal-param (sal-query (sal-target raw)) "id") "20260817-1") 4)
                (salb-score (eq (sal-header-int raw "Content-Length: ") 17) 8)
                (salb-score (eq (sal-request-complete? raw) 1) 16)
                (salb-score (str_eq (sal-body raw) "title=One&text=Hi") 32)
                (salb-score (str_eq (sal-param (sal-body raw) "title") "One") 64)
                (salb-score (str_eq (sal-csv-text csv) " book.\n hello.") 128)
                (salb-score (ge (str_find wire "Content-Length: 5" 0) 0) 256)
                (salb-score (ge (str_find wire "\r\n\r\nalive" 0) 0) 512)
                (salb-score (and (ge (str_find attention "recording paused" 0) 0)
                                 (ge (str_find attention "pieces that arrived are still here" 0) 0)) 1024)
                (salb-score (and (ge (str_find (sal-script) "MediaRecorder" 0) 0)
                                 (ge (str_find (sal-style) ".sessions" 0) 0)) 2048)
                (salb-score (str_eq (sal-hearing-result 0 0 0 0 0) "recording-empty") 4096)
                (salb-score (str_eq (sal-hearing-result 100 0 0 0 0) "speech-not-ready") 8192)
                (salb-score (str_eq (sal-hearing-result 100 1 0 0 0) "audio-unread") 16384)
                (salb-score (and
                    (str_eq (sal-hearing-result 100 1 1 0 0) "speech-returned-nothing")
                    (str_eq (sal-hearing-result 100 1 1 1 1) "ready")) 32768)
                (salb-score (and (str_eq (sal-platform-from-os "Windows_NT\r\n") "windows")
                                 (str_eq (sal-platform-from-os "%OS%\n") "posix")) 65536)
                (salb-score (and (str_eq (sal-quote-for 1 "a b") "\"a b\"")
                    (and (str_eq (sal-quote-for 0 "a b") "'a b'")
                         (ge (str_find (sal-command-probe 1 "ffmpeg") ">nul 2>nul" 0) 0))) 131072)
                (salb-score (and
                    (ge (str_find (sal-windows-whisper-prepare-command)
                        "7d8be46ecd31828e1eb7a2ecdd0d6b314feafd82163038ab6092594b0a063539" 0) 0)
                    (ge (str_find (sal-windows-ffmpeg-prepare-command) "Gyan.FFmpeg" 0) 0)) 262144)))))
    (session-app-live-band))
