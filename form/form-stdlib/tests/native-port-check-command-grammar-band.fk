; native-port-check-command-grammar-band.fk -- direct Form proof for the
; closed native-port-check command grammar.
;
; This proves source-level parsing only.  It does not invoke fsh, the emitted
; runner, a native port, a child, a resource, a filesystem, or a network.
; The emitted-fixture mirror checks that the named Form grammar has the exact
; command framing baked by the disposable closed table profile.
;
; Verdict: 127.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/native-port-check-command-grammar.fk

(do
    (let id "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    (let uppercase-id
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    (let uppercase (str_concat "A" (substring uppercase-id 1 64)))
    (let short-id (substring id 0 63))
    (let non-hex-id (str_concat "g" (substring id 1 64)))
    (let valid (str_concat (fnpcg-command-prefix) id))
    (let wrong-name (str_concat "turn " id))
    (let missing-separator (str_concat (fnpcg-command-name) id))
    (let doubled-separator
        (str_concat (fnpcg-command-prefix)
                    (str_concat " " id)))
    (let extra (str_concat valid " extra"))
    (let newline (str_concat valid "\n"))
    (let uppercase-line (str_concat (fnpcg-command-prefix) uppercase))
    (let short-line (str_concat (fnpcg-command-prefix) short-id))
    (let non-hex-line (str_concat (fnpcg-command-prefix) non-hex-id))
    (let valid-parse (fnpcg-parse valid))
    (let refused-parse (fnpcg-parse wrong-name))
    (let c0
        (if (and (str_eq (fnpcg-emitted-command-name) "native-port-check")
                 (and (str_eq (fnpcg-emitted-command-prefix)
                              "native-port-check ")
                      (and (eq (fnpcg-emitted-command-prefix-length) 18)
                           (and (eq (fnpcg-emitted-exchange-id-length) 64)
                                (eq (fnpcg-emitted-command-line-length) 82)))))
            1 0))
    (let c1
        (if (and (eq (fnpcg-command-admitted? valid) 1)
                 (and (str_eq (fnpcg-command-id valid) id)
                      (eq (fnpcg-command-refused? valid) 0))) 2 0))
    (let c2
        (if (and (eq (fnpcg-exchange-id? id) 1)
                 (and (eq (fnpcg-exchange-id? uppercase) 0)
                      (and (eq (fnpcg-exchange-id? short-id) 0)
                           (eq (fnpcg-exchange-id? non-hex-id) 0)))) 4 0))
    (let c3
        (if (and (eq (fnpcg-command-admitted? wrong-name) 0)
                 (and (eq (fnpcg-command-admitted? missing-separator) 0)
                      (and (eq (fnpcg-command-admitted? doubled-separator) 0)
                           (and (eq (fnpcg-command-admitted? extra) 0)
                                (and (eq (fnpcg-command-admitted? newline) 0)
                                     (and (eq (fnpcg-command-admitted? uppercase-line) 0)
                                          (and (eq (fnpcg-command-admitted? short-line) 0)
                                               (eq (fnpcg-command-admitted? non-hex-line) 0)))))))) 8 0))
    (let c4
        (if (and (str_eq (nth valid-parse 0) "admitted")
                 (and (str_eq (nth valid-parse 1) id)
                      (and (str_eq (nth refused-parse 0) "refused")
                           (str_eq (nth refused-parse 1) "")))) 16 0))
    (let c5
        (if (and (eq (fnpcg-matches-emitted-fixture? valid) 1)
                 (and (eq (fnpcg-matches-emitted-fixture? wrong-name) 1)
                      (and (eq (fnpcg-matches-emitted-fixture? uppercase-line) 1)
                           (and (eq (fnpcg-matches-emitted-fixture? extra) 1)
                                (eq (fnpcg-matches-emitted-fixture? newline) 1))))) 32 0))
    (let c6
        (if (and (eq (fnpcg-emitted-fixture-command-admitted? valid) 1)
                 (and (eq (fnpcg-emitted-fixture-command-admitted? wrong-name) 0)
                      (and (eq (fnpcg-emitted-fixture-command-admitted? uppercase-line) 0)
                           (and (eq (fnpcg-emitted-fixture-command-admitted? extra) 0)
                                (eq (fnpcg-emitted-fixture-command-admitted? newline) 0))))) 64 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6)))))))
