; form-glass-observation-v2-band.fk -- typed Glass truth/provenance proof.
; Each verdict bit is tied to behavior, not a source-string census.
; preludes: form-stdlib/bml/form-glass-observation-v2.bml

(defn fgov2b-bit (held weight) (if (eq held 1) weight 0))
(defn fgov2b-all-kind (rows kind)
    (if (eq (len rows) 0) 1
        (if (str_eq (fgov2-observation-kind (head rows)) kind)
            (fgov2b-all-kind (tail rows) kind) 0)))
(defn fgov2b-find (rows id)
    (if (eq (len rows) 0) (nothing)
        (if (str_eq (fgov2-observation-id (head rows)) id) (head rows)
            (fgov2b-find (tail rows) id))))

(defn fgov2b-main ()
  (do
    (let lifetime (fgov2-process-lifetime 4242 1700000000 "pid-4242-start-1700000000"))
    (let provenance (fgov2-provenance "physical-live" "native-model-resident"
        (fgov2-measured lifetime) (fgov2-measured 73) (fgov2-measured 1700000250)
        "metal_status"))
    (let unscoped (fgov2-provenance "declared" "glass-policy"
        (fgov2-unavailable "publisher-process-not-observed" "process.lifetime")
        (fgov2-measured 0) (fgov2-measured 1700000250) "glass.policy"))
    (let measured-zero (fgov2-measured 0))
    (let absent (fgov2-absent "no-queue-item"))
    (let unavailable (fgov2-unavailable "allocator-bytes-not-exposed" "metal.allocator-ledger"))
    (let stale (fgov2-stale 17 1700000000 "publisher-lease-expired"))
    (let failed (fgov2-error "metal-status-parse" "noncanonical-uint:pending" 0))
    (let identity (fgov2-model-identity
        "qwen3.8-flash-next:ud-q2-k-xl:sha256-0123"
        "Qwen3.8-Flash-Next UD-Q2_K_XL (Unsloth)"
        "Qwen3.8-Flash-Next" "UD-Q2_K_XL" "GGUF"
        "sha256-shard-set-0123" "gguf.metadata" "sha256-source-0123"))
    (let model (fgov2-model-observation "model.qwen3.8-flash-next.ud-q2-k-xl"
        (fgov2-measured identity) (list "reasoning-fallback" "thinking")
        (fgov2-measured "resident") unavailable provenance))
    (let counters (fgov2-queue-counters measured-zero measured-zero
        (fgov2-measured 8) (fgov2-measured 8) (fgov2-measured 7)
        measured-zero measured-zero measured-zero))
    (let transition (fgov2-queue-transition "hearth.requests" "request.8"
        "waiting" "running" (fgov2-measured 1700000240) (fgov2-measured 73) provenance))
    (let queue (fgov2-queue-snapshot "hearth.requests" counters absent
        (fgov2-measured transition) provenance))
    (let recipe (fgov2-recipe-observation "recipe.form-query" "crystallized"
        "eval" (fgov2-measured 91) provenance))
    (let structures (fgov2-current-structure-observations provenance))
    (let cell-count (fgov2b-find structures "cells.interned.count"))
    (let blueprint-bytes (fgov2b-find structures "blueprints.allocation.bytes"))
    (let recipe-bytes (fgov2b-find structures "recipes.allocation.bytes"))
    (let tensor-bytes (fgov2b-find structures "tensors.allocation.bytes"))
    (let memory-bytes (fgov2b-find structures "memory.arena.bytes"))
    (let metal-fixture (str_concat
        "metal_owner=fkwu-form-cli\nmetal_linked=true\nmetal_door=handle\n"
        (str_concat "device=fixture\nunified_memory=1\nbuffers=3\npipelines=2\n"
        (str_concat "buffer_slots=8\nfree_slots=5\nmmap_nocopy_buffers=1\npending=0\n"
        (str_concat "batch=none\nin_flight=0\ntotal_dispatch=11\ntotal_sync=9\n"
        "cpu_jit_dispatch=0\ncpu_jit_busy_us_total=0\ngpu_busy_us_total=41\nlast_error=none\n")))))
    (let metal (fgov2-metal-observations metal-fixture provenance))
    (let pending (fgov2b-find metal "metal.pending"))
    (let batch (fgov2b-find metal "metal.batch.mode"))
    (let inflight (fgov2b-find metal "metal.in-flight"))
    (let slots (fgov2b-find metal "metal.buffer-slots"))
    (let cpu-jit (fgov2b-find metal "metal.cpu-jit.dispatch"))
    (let malformed-metal (fgov2-metal-observations
        "metal_linked=true\npending=-1\nbatch=none\n" provenance))
    (let malformed-pending (fgov2b-find malformed-metal "metal.pending"))
    (let boundary-metal (fgov2-metal-observations
        "metal_linked=true\nmmap_nocopy_buffers=7\nbatch=none\n" provenance))
    (let boundary-buffers (fgov2b-find boundary-metal "metal.buffers.active"))
    (let jit (fgov2-current-jit-observations provenance))
    (let current-metal (fgov2-current-metal-observations provenance))
    (sum (list
        (fgov2b-bit (and (eq (fgov2-truth? measured-zero) 1)
            (and (eq (fgov2-measured? measured-zero) 1)
                 (eq (fgov2-truth-value measured-zero) 0))) 1)
        (fgov2b-bit (and (eq (fgov2-absent? absent) 1)
            (and (nothing? (fgov2-truth-value absent))
                 (not (eq measured-zero absent)))) 2)
        (fgov2b-bit (and (eq (fgov2-unavailable? unavailable) 1)
            (and (str_eq (fgov2-truth-reason unavailable) "allocator-bytes-not-exposed")
                 (str_eq (fgov2-truth-door unavailable) "metal.allocator-ledger"))) 4)
        (fgov2b-bit (and (eq (fgov2-stale? stale) 1)
            (and (eq (fgov2-truth-value stale) 17)
                 (eq (fgov2-truth-last-observed stale) 1700000000))) 8)
        (fgov2b-bit (and (eq (fgov2-error? failed) 1)
            (and (str_eq (fgov2-truth-stage failed) "metal-status-parse")
                 (eq (fgov2-truth-retryable failed) 0))) 16)
        (fgov2b-bit (and (eq (fgov2-provenance? provenance) 1)
            (and (eq (fgov2-lifetime-pid (fgov2-truth-value (fgov2-provenance-lifetime provenance))) 4242)
                 (eq (fgov2-truth-value (fgov2-provenance-sequence provenance)) 73))) 32)
        (fgov2b-bit (and (eq (fgov2-provenance? unscoped) 1)
            (and (eq (fgov2-unavailable? (fgov2-provenance-lifetime unscoped)) 1)
                 (eq (fgov2-truth-value (fgov2-provenance-sequence unscoped)) 0))) 64)
        (fgov2b-bit (and (eq (fgov2-model-identity? identity) 1)
            (and (str_eq (fgov2-model-display identity) "Qwen3.8-Flash-Next UD-Q2_K_XL (Unsloth)")
                 (not (str_eq (fgov2-model-canonical identity) "reasoning-fallback")))) 128)
        (fgov2b-bit (and (eq (fgov2-observation? model) 1)
            (and (str_eq (head (fgov2-observation-roles model)) "reasoning-fallback")
                 (str_eq (fgov2-model-quantization (fgov2-truth-value (fgov2-observation-identity model))) "UD-Q2_K_XL"))) 256)
        (fgov2b-bit (and (eq (fgov2-queue-snapshot? queue) 1)
            (and (eq (fgov2-truth-value (fgov2-queue-depth counters)) 0)
                 (eq (fgov2-absent? (fgov2-queue-snapshot-oldest queue)) 1))) 512)
        (fgov2b-bit (and (eq (fgov2-queue-transition? transition) 1)
            (and (str_eq (fgov2-transition-from transition) "waiting")
                 (str_eq (fgov2-transition-to transition) "running"))) 1024)
        (fgov2b-bit (and (eq (fgov2-observation? recipe) 1)
            (and (str_eq (fgov2-truth-value (fgov2-observation-state recipe)) "crystallized")
                 (str_eq (fgov2-observation-access recipe) "eval"))) 2048)
        (fgov2b-bit (and (eq (len structures) 9)
            (and (eq (fgov2-measured? (fgov2-observation-measurement cell-count)) 1)
                 (and (eq (fgov2-unavailable? (fgov2-observation-measurement blueprint-bytes)) 1)
                      (and (eq (fgov2-unavailable? (fgov2-observation-measurement recipe-bytes)) 1)
                           (and (eq (fgov2-unavailable? (fgov2-observation-measurement tensor-bytes)) 1)
                                (eq (fgov2-unavailable? (fgov2-observation-measurement memory-bytes)) 1)))))) 4096)
        (fgov2b-bit (and (eq (len metal) 13)
            (and (eq (fgov2-truth-value (fgov2-observation-measurement pending)) 0)
                 (and (str_eq (fgov2-truth-value (fgov2-observation-measurement batch)) "none")
                      (and (eq (fgov2-truth-value (fgov2-observation-measurement inflight)) 0)
                           (and (eq (fgov2-truth-value (fgov2-observation-measurement slots)) 8)
                                (eq (fgov2-truth-value (fgov2-observation-measurement cpu-jit)) 0)))))) 8192)
        (fgov2b-bit (and (eq (fgov2-observations-valid? metal) 1)
            (and (eq (fgov2-error? (fgov2-observation-measurement malformed-pending)) 1)
                 (eq (fgov2-unavailable? (fgov2-observation-measurement boundary-buffers)) 1))) 16384)
        (fgov2b-bit (and (eq (len jit) 3)
            (and (eq (fgov2-observations-valid? jit) 1)
                 (fgov2b-all-kind jit "jit"))) 32768)
        (fgov2b-bit (and (eq (len (fgov2-access-vocabulary)) 24)
            (and (eq (fgov2-member? "nothing" (fgov2-access-vocabulary)) 1)
                 (and (eq (fgov2-member? "timeout" (fgov2-access-vocabulary)) 1)
                      (and (eq (fgov2-member? "broadcast" (fgov2-access-vocabulary)) 1)
                           (eq (fgov2-member? "satsang" (fgov2-access-vocabulary)) 1))))) 65536)
        (fgov2b-bit (and (eq (fgov2-queue-counters? (fgov2-queue-counters
            (fgov2-measured -1) measured-zero measured-zero measured-zero
            measured-zero measured-zero measured-zero measured-zero)) 0)
            (eq (fgov2-queue-transition? (fgov2-queue-transition "hearth.requests" "request.9"
                "waiting" "invented-state" measured-zero measured-zero provenance)) 0)) 131072)
        (fgov2b-bit (and (str_eq (fgov2-truth-door (fgov2-observation-measurement blueprint-bytes)) "kernel.blueprint-byte-ledger")
            (and (str_eq (fgov2-truth-door (fgov2-observation-measurement recipe-bytes)) "kernel.recipe-byte-ledger")
                 (str_eq (fgov2-truth-door (fgov2-observation-measurement tensor-bytes)) "tensor.allocation-ledger"))) 262144)
        (fgov2b-bit (and (eq (len current-metal) 13)
            (eq (fgov2-observations-valid? current-metal) 1)) 524288)
        (fgov2b-bit (and (eq (fgov2-truth? (fgov2-measured (nothing))) 1)
            (and (eq (fgov2-error? (fgov2-measured (nothing))) 1)
                 (and (str_eq (fgov2-truth-code (fgov2-measured (nothing))) "measured-nothing")
                      (eq (fgov2-truth? (fgov2-truth "measured" 0 (nothing) (nothing) "extra-stage" (nothing) (nothing) (nothing))) 0)))) 1048576)))))

(print (fgov2b-main))
