; form-cli-peer-direct-answer-dispatch-band.fk -- BML direct speech enters
; the caller-held session without first taking the generic task-observation
; route.
;
; PROOF BAND (fkwu): 255
; preludes: form-stdlib/form-cli-peer-stream-ingress.fk

(do
    (defn fcpdadb-bit (ok bit) (if ok bit 0))
    (defn fcpdadb-task (node)
        (fcpsi-task node "direct-band" 1 19 7 "direct-answer"
            "state the local carrier" "frame" 99))
    (defn form-cli-peer-direct-answer-dispatch-band ()
        (do
            (let node (make_nodeid 31 19 7 1))
            (let task (fcpdadb-task node))
            (let state (fcpsi-state (nothing) (list) (list task) (list)
                (list) 8))
            (let session (fcms-none "sentinel-no-model"))
            ; An unavailable session makes this an effect-boundary witness:
            ; the BML direct branch returns before any Metal/model call, so a
            ; generic fcpa-observe-task stage would be observable as stray
            ; output and is absent from this band's clean single-value run.
            (let ran (fcpsi-run-peer-with-action-with-patch-with-stage-context
                state session node 23 (nothing) "direct-answer"
                fcpa-knowledge-stage-observer-with-context (nothing)))
            (let peer (nth ran 1))
            (let candidate (nth ran 2))
            (sum (list
                (fcpdadb-bit (and (str_eq (fcpdad-route) "direct-answer")
                    (and (str_eq (fcpdad-carrier) "form-native-metal-jit")
                    (and (eq (fcpdad-selected? "direct-answer") 1)
                         (eq (fcpdad-selected? "model") 0)))) 1)
                (fcpdadb-bit (and (str_eq (fcpa-route peer) "direct-answer")
                    (and (str_eq (fcpa-carrier peer) "form-native-metal-jit")
                    (and (str_eq (fcpa-tool-status peer)
                        "nothing;tokens=0;pos=0;pending=-1;stopped=0;observations=0")
                    (and (str_eq (fcpa-lifecycle peer) "nothing,release")
                         (value_eq (fcpa-session peer) session))))) 2)
                (fcpdadb-bit (and (eq (fcpa-contribution peer) 0)
                    (and (eq (fcpa-callback-calls peer) 0)
                    (and (eq (fcpa-injected-bytes peer) 0)
                    (and (eq (fcpa-lookup-count peer) 0)
                         (eq (fcms-observations (fcpa-session peer)) 0))))) 4)
                (fcpdadb-bit (and (str_eq (fcpsi-result-signal candidate)
                    "candidate")
                    (and (eq (fcpsi-result-present? candidate) 1)
                    (and (str_eq (fcpsi-candidate-state
                        (fcpsi-result-value candidate)) "candidate")
                         (eq (fcpsi-candidate-exchange
                            (fcpsi-result-value candidate)) 19)))) 8)
                (fcpdadb-bit (and (ge (str_find (fcpdad-branch-rule)
                    "before-model-task-observation" 0) 0)
                    (and (not (nothing? 0))
                         (not (eq 0 (nothing))))) 16)
                (fcpdadb-bit (and (str_eq (fcpdaa-signal (fcpa-cursor peer))
                    "nothing")
                    (and (str_eq (fcpdaa-reason (fcpa-cursor peer))
                        "model-session-not-live")
                         (eq (fcpdaa-generated-tokens (fcpa-cursor peer)) 0))) 32)
                (fcpdadb-bit (and (eq (fcpa-native-code-generated? peer) 0)
                    (and (eq (fcpa-value-present? peer) 0)
                         (nothing? (fcpa-value peer)))) 64)
                (fcpdadb-bit (and (str_eq (fcpsi-result-reason candidate)
                    "evaluation-not-yet-observed")
                    (and (eq (len (fcpsi-events (fcpsi-result-state candidate))) 1)
                         (str_eq (nth (head (fcpsi-events
                            (fcpsi-result-state candidate))) 3) "candidate"))) 128)))))

    (form-cli-peer-direct-answer-dispatch-band))
