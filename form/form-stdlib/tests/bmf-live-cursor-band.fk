; bmf-live-cursor-band.fk -- delta-only cursor, checkpoint and signal proof.
;
; Expected: 32767 (15 claims).
; preludes: form-stdlib/bmf-live-cursor.fk

(do
    (defn blcb-bit (ok bit) (if ok bit 0))
    (defn blcb-run ()
        (do
            (let fresh (blc-fresh 8 256))
            (let a (blc-feed fresh "def x() = " 64))
            (let ca (blc-result-cursor a))
            (let checkpoint (blc-checkpoint ca))
            (let b (blc-feed ca "add(20,22);\n" 64))
            (let cb (blc-result-cursor b))
            (let final (blc-feed cb "0;" 64))
            (let cf (blc-result-cursor final))
            (let bad (blc-feed checkpoint ")" 64))
            (let quoted (blc-feed (blc-fresh 16 256)
                "def x() = \"});\";\n0;" 128))
            (let comment-a (blc-feed (blc-fresh 16 256)
                "def x() = 1; /* }" 128))
            (let comment-b (blc-feed (blc-result-cursor comment-a)
                " */\n0;" 128))
            (let timed (blc-feed (blc-fresh 8 256) "abcdef" 2))
            (let resumed (blc-feed (blc-result-cursor timed)
                (substring "abcdef" (blc-result-offset timed) 6) 16))
            (let full (blc-feed (blc-fresh 4 3) "abcd" 16))
            (let empty-result (blc-feed fresh "" 16))
            (let far (blc-cursor-row 10000000 9 4 "tail" 8 "x" 256
                "open" "open" "code" 0 0 0 (empty) 0 1 0))
            (let farther (blc-feed far "a" 1))
            (sum (list
                (blcb-bit (eq (blc-manifest-has?
                    "unbounded-logical-position" (blc-manifest)) 1) 1)
                (blcb-bit (and (str_eq (blc-result-status a) "open")
                    (str_eq (blc-result-status b) "open")) 2)
                (blcb-bit (and (str_eq (blc-result-status final) "candidate")
                    (str_eq (blc-material cf)
                        "def x() = add(20,22);\n0;")) 4)
                (blcb-bit (eq (blc-pos cf)
                    (str_len "def x() = add(20,22);\n0;")) 8)
                (blcb-bit (and (le (str_len (blc-window cf)) 8)
                    (str_eq (blc-window cf) ",22);\n0;")) 16)
                (blcb-bit (and (str_eq (blc-result-status bad) "malformed")
                    (node_eq (blc-restore checkpoint) checkpoint)) 32)
                (blcb-bit (and (str_eq (blc-result-status quoted) "candidate")
                    (nil? (blc-stack (blc-result-cursor quoted)))) 64)
                (blcb-bit (str_eq (blc-result-status comment-b) "candidate") 128)
                (blcb-bit (and (str_eq (blc-result-status timed) "timeout")
                    (eq (blc-result-offset timed) 2)) 256)
                (blcb-bit (and (str_eq (blc-result-status resumed) "open")
                    (eq (blc-pos (blc-result-cursor resumed)) 6)) 512)
                (blcb-bit (and (str_eq (blc-result-status full)
                        "materialization-full")
                    (eq (blc-pos (blc-result-cursor full)) 3)) 1024)
                (blcb-bit (and
                    (str_eq (blc-result-status empty-result) "nothing")
                    (eq (blc-pos (blc-result-cursor empty-result)) 0)) 2048)
                (blcb-bit (eq (blc-pos (blc-result-cursor farther)) 10000001)
                    4096)
                (blcb-bit (and (eq (blc-terminal-count cb) 1)
                    (eq (blc-terminal-count cf) 2)) 8192)
                (blcb-bit (and (eq (blc-chunks cf) 3)
                    (eq (blc-result-fuel final) 62)) 16384)))))
    (blcb-run))
