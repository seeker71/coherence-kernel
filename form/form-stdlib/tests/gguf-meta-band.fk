; gguf-meta-band.fk — typed metadata reads over one byte-faithful mini-GGUF.
;
; The fixture is built as a host string from bytes below 128, so fkwu and Go preserve every byte.
; It carries the exact split.no shape that Qwen3.8-Flash-Next uses: GGUF type 2 (u16), not u32.
; A typed read must accept its own width, refuse another width, find later records after walking it,
; and never turn absence into zero.
;
; PROOF LEVEL: TWO-ARM (fkwu + go). The other two arms cannot hold arbitrary binary host strings;
; equireach-band.fk records that carrier seam. The field arithmetic itself is ordinary Form.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/q6k-dequant.fk form-stdlib/equireach-gguf.fk form-stdlib/gguf-meta.fk
;
; Verdict 127:
;   1   magic is GGUF
;   2   split.no u16 reads 3
;   4   split.count u32 reads 3
;   8   the u16 reader refuses split.count's u32 width
;   16  the u32 reader refuses split.no's u16 width
;   32  the later string record survives the mixed-width walk
;   64  an absent key returns the -1 sentinel

(do
    (defn gmtb-u32 (v)
        (str_concat (byte_to_str (mod v 256))
        (str_concat (byte_to_str (mod (div v 256) 256))
        (str_concat (byte_to_str (mod (div v 65536) 256))
                    (byte_to_str (mod (div v 16777216) 256))))))
    (defn gmtb-u64 (v) (str_concat (gmtb-u32 (mod v 4294967296)) (gmtb-u32 (div v 4294967296))))
    (defn gmtb-u16 (v) (str_concat (byte_to_str (mod v 256)) (byte_to_str (mod (div v 256) 256))))
    (defn gmtb-gstr (s) (str_concat (gmtb-u64 (str_len s)) s))
    (defn gmtb-kv-u16 (key v) (str_concat (gmtb-gstr key) (str_concat (gmtb-u32 2) (gmtb-u16 v))))
    (defn gmtb-kv-u32 (key v) (str_concat (gmtb-gstr key) (str_concat (gmtb-u32 4) (gmtb-u32 v))))
    (defn gmtb-kv-str (key v) (str_concat (gmtb-gstr key) (str_concat (gmtb-u32 8) (gmtb-gstr v))))
    (defn gmtb-gguf ()
        (str_concat "GGUF"
        (str_concat (gmtb-u32 3)
        (str_concat (gmtb-u64 0)
        (str_concat (gmtb-u64 3)
        (str_concat (gmtb-kv-u16 "split.no" 3)
        (str_concat (gmtb-kv-u32 "split.count" 3)
                    (gmtb-kv-str "general.architecture" "qwen4exp"))))))))
    (defn gmtb-bit (ok bit) (if ok bit 0))
    (let src (eqr-of-string (gmtb-gguf)))
    (let c0 (gmtb-bit (eq (egg-magic-ok? src) 1) 1))
    (let c1 (gmtb-bit (eq (gmt-u16 src "split.no") 3) 2))
    (let c2 (gmtb-bit (eq (gmt-u32 src "split.count") 3) 4))
    (let c3 (gmtb-bit (eq (gmt-u16 src "split.count") (gmt-absent)) 8))
    (let c4 (gmtb-bit (eq (gmt-u32 src "split.no") (gmt-absent)) 16))
    (let c5 (gmtb-bit (str_eq (gmt-str src "general.architecture") "qwen4exp") 32))
    (let c6 (gmtb-bit (eq (gmt-u16 src "missing") (gmt-absent)) 64))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6)))))))
