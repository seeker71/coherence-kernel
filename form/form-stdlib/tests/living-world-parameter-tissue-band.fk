; living-world-parameter-tissue-band.fk -- Recipes travel through new cells.
; Verdict 32767 proves fifteen native parameter, tissue, and revision claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk form-stdlib/living-world-contextual-species.fk form-stdlib/living-world-tissue-prediction.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk form-stdlib/tests/living-world-parameter-tissue-witness.fk

(defn lwptb-all-executions-bound? (items bindings output)
    (if (eq (len items) 0) 1
        (do
            (let execution (head items))
            (let trace (lwtp-execution-trace execution))
            (if (and (node_eq (lwre-trace-bindings trace) bindings)
                     (node_eq (lwtp-execution-output execution) output))
                (lwptb-all-executions-bound?
                    (tail items) bindings output) 0))))

(do
    (let history (lwptw-build-history))
    (let p-trial (lwtnw-trial-candidate (lwptw-history-p history)))
    (let q-trial (lwtnw-trial-candidate (lwptw-history-q history)))
    (let p-shape (lwo-emergent-shape p-trial))
    (let q-shape (lwo-emergent-shape q-trial))
    (let history-world (lwptw-history-world history))
    (let species-fixture (lwptw-build-species history))
    (let species (lwptw-species-candidate species-fixture))
    (let species-world (lwt-round-world (lwptw-species-round species-fixture)))
    (let species-field (lwptw-species-field species-fixture))
    (let tissue-fixture (lwptw-build-tissue species-fixture))
    (let tissue (lwptw-tissue-candidate tissue-fixture))
    (let tissue-world (lwt-round-world (lwptw-tissue-round tissue-fixture)))
    (let tissue-shape (lwo-emergent-shape tissue))
    (let component (lwcs-tissue-component tissue-shape))
    (let prediction-a (lwptw-prediction-a tissue-fixture))
    (let prediction-b (lwptw-prediction-b tissue-fixture))
    (let candidate-a (lwptw-prediction-candidate prediction-a))
    (let candidate-b (lwptw-prediction-candidate prediction-b))
    (let shape-a (lwptw-prediction-shape prediction-a))
    (let shape-b (lwptw-prediction-shape prediction-b))
    (let world-a (lwt-round-world (lwptw-prediction-round prediction-a)))
    (let world-b (lwt-round-world (lwptw-prediction-round prediction-b)))
    (let experience-fixture (lwptw-build-experience prediction-a))
    (let experience (lwptw-experience-candidate experience-fixture))
    (let experience-shape (lwo-emergent-shape experience))
    (let experience-world
        (lwt-round-world (lwptw-experience-round experience-fixture)))
    (let next (lwptw-next-prediction tissue-fixture experience-fixture))
    (let next-shape (lwptw-prediction-shape next))
    (let revoked (lwptw-revoke-one-observer experience-fixture))
    (let restored
        (lwtp-prediction-for revoked tissue (lwptw-target-a) 2 (lwo-none)))

    (let c1
        (if (and (node_eq
                    (lwrx-overall-after (lwtn-trial-actual p-shape))
                    (intern_trivial_int 4))
                 (node_eq
                    (lwrx-overall-after (lwtn-trial-actual q-shape))
                    (intern_trivial_int 4))) 1 0))
    (let c2
        (if (and (not (node_eq (lwptw-recipe-p) (lwptw-recipe-q)))
                 (and (eq (lwre-bound-contract? (lwptw-contract)) 1)
                      (eq (lwre-unbound-contract? (lwptw-contract)) 0))) 2 0))
    (let c3
        (if (and (node_eq
                    (lwtn-candidate-bindings
                        (lwtn-trial-candidate p-shape))
                    (lwptw-history-bindings))
                 (and (node_eq
                        (lwtn-candidate-bindings
                            (lwtn-trial-candidate q-shape))
                        (lwptw-history-bindings))
                      (and (eq (lwre-trace-current?
                                  history-world
                                  (lwtn-trial-trace p-shape)) 1)
                           (eq (lwre-trace-current?
                                  history-world
                                  (lwtn-trial-trace q-shape)) 1)))) 4 0))
    (let c4
        (if (and (eq (lwbs-aligned?
                         (lwbs-field-status species-field)) 1)
                 (and (eq (lwo-field-size
                              (lwbs-field-members species-field)) 2)
                      (and (eq (lwo-field-size
                                  (lwbs-field-receipts species-field)) 2)
                           (eq (lwbs-integrated-current?
                                  species-world species) 1)))) 8 0))
    (let c5
        (if (and (eq (lwcs-coherent?
                         (lwcs-field-status
                            (lwptw-tissue-field tissue-fixture))) 1)
                 (and (eq (lwo-field-size
                              (lwcs-component-members component)) 2)
                      (and (eq (lwo-field-size
                                  (lwcs-component-receipts component)) 2)
                           (eq (lwcs-tissue-integrated-current?
                                  tissue-world tissue) 1)))) 16 0))
    (let c6
        (if (and (eq (lwtp-consensus?
                         (lwtp-prediction-status shape-a)) 1)
                 (and (node_eq (lwtp-prediction-predicted shape-a)
                               (intern_trivial_int 36))
                      (and (eq (lwo-field-size
                                  (lwtp-prediction-recipes shape-a)) 2)
                           (eq (lwo-field-size
                                  (lwtp-prediction-executions shape-a)) 2))))
            32 0))
    (let c7
        (if (and (eq (lwtp-consensus?
                         (lwtp-prediction-status shape-b)) 1)
                 (and (node_eq (lwtp-prediction-predicted shape-b)
                               (intern_trivial_int 52))
                      (and (eq (lwo-field-size
                                  (lwtp-prediction-recipes shape-b)) 2)
                           (eq (lwo-field-size
                                  (lwtp-prediction-executions shape-b)) 2))))
            64 0))
    (let c8
        (if (and (node_eq (lwtp-prediction-recipes shape-a)
                          (lwtp-prediction-recipes shape-b))
                 (and (not (node_eq (lwptw-prediction-target prediction-a)
                                    (lwptw-prediction-target prediction-b)))
                      (not (node_eq (lwtp-target-bindings
                                      (lwptw-prediction-target prediction-a))
                                    (lwtp-target-bindings
                                      (lwptw-prediction-target prediction-b))))))
            128 0))
    (let c9
        (if (and (eq (lwptb-all-executions-bound?
                         (lwo-field-items
                            (lwtp-prediction-executions shape-a))
                         (lwptw-target-bindings-a)
                         (intern_trivial_int 36)) 1)
                 (eq (lwptb-all-executions-bound?
                         (lwo-field-items
                            (lwtp-prediction-executions shape-b))
                         (lwptw-target-bindings-b)
                         (intern_trivial_int 52)) 1)) 256 0))
    (let c10
        (if (and (eq (lwo-field-has?
                         (lwtp-prediction-alternatives shape-a)
                         (lwptw-alternative)) 1)
                 (and (eq (lwo-field-has?
                              (lwtp-prediction-alternatives shape-a)
                              (lwptw-recipe-p)) 1)
                      (and (eq (lwo-field-has?
                                  (lwtp-prediction-alternatives shape-a)
                                  (lwptw-recipe-q)) 1)
                           (gt (lwo-field-size
                                  (lwtp-prediction-unknowns shape-a)) 0))))
            512 0))
    (let c11
        (if (and (eq (lwtp-diverge?
                         (lwtp-experience-state experience-shape)) 1)
                 (and (node_eq (lwtp-experience-observed experience-shape)
                               (intern_trivial_int 37))
                      (and (eq (lwo-field-size
                                  (lwtp-experience-observation-evidence
                                    experience-shape)) 2)
                           (eq (lwtp-experience-integrated-current?
                                  experience-world experience) 1)))) 1024 0))
    (let c12
        (if (and (eq (lwtp-branch?
                         (lwtp-prediction-status next-shape)) 1)
                 (and (node_eq (lwtp-prediction-predicted next-shape)
                               (lwo-none))
                      (and (eq (lwo-field-has?
                                  (lwtp-prediction-combined-outputs next-shape)
                                  (intern_trivial_int 36)) 1)
                           (eq (lwo-field-has?
                                  (lwtp-prediction-combined-outputs next-shape)
                                  (intern_trivial_int 37)) 1)))) 2048 0))
    (let c13
        (if (and (eq (lwtp-prediction-historical-valid?
                         experience-world candidate-a) 1)
                 (and (eq (lwtp-prediction-integrated-current?
                              world-a candidate-a) 1)
                      (not (node_eq candidate-a candidate-b)))) 4096 0))
    (let c14
        (if (and (eq (lwtp-experience-integrated-current?
                         revoked experience) 0)
                 (and (node_eq
                        (lwtp-experience-proposal revoked
                            (lwptw-experience-observation experience-fixture) 2)
                        (lwo-none))
                      (and (eq (lwtp-consensus?
                                  (lwtp-prediction-status restored)) 1)
                           (node_eq (lwtp-prediction-predicted restored)
                                    (intern_trivial_int 36))))) 8192 0))
    (let c15
        (if (and (eq (lwtp-target-current? world-a (lwptw-target-a)) 1)
                 (and (eq (lwtp-target-current? world-b (lwptw-target-b)) 1)
                      (and (node_eq
                              (lwre-contract-evaluator (lwptw-contract))
                              (lwre-bound-form-evaluator))
                           (not (node_eq
                                  (lwptw-prediction-candidate next)
                                  candidate-a))))) 16384 0))
    (add c1 (add c2 (add c3 (add c4 (add c5
      (add c6 (add c7 (add c8 (add c9 (add c10
        (add c11 (add c12 (add c13 (add c14 c15)))))))))))))))
