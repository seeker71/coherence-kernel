; qwen-lora-resident-band.fk — stream ownership and position are exact.
;
; Verdict 63: release, EOF, decoded position, empty decode, room, no-room.
; preludes: form-stdlib/qwen-lora-resident.fk

(do
    (sum (list
        (if (eq (qlr-release? "release") 1) 1 0)
        (if (eq (qlr-release? (nothing)) 1) 2 0)
        (if (eq (qlr-next-pos 10 (list 4 5) (list 6 7 8 9)) 15) 4 0)
        (if (eq (qlr-next-pos 10 (list 4 5) (empty)) 12) 8 0)
        (if (eq (qlr-room? 10 (list 1 2) 4 16) 1) 16 0)
        (if (eq (qlr-room? 11 (list 1 2) 4 16) 0) 32 0))))
