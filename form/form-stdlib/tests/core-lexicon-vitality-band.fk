; core-lexicon-vitality-band.fk — core words may be tended by an earned,
; reversible vitality overlay without mutating or escaping the closed lexicon.
;
; The word pairs and scores below are mechanics fixtures. They prove the
; admission law, not a semantic judgment that one word is better than another.
;
; preludes: form-stdlib/core.fk ../control/offer-ack-core.fk form-stdlib/core-lexicon.fk ../ingest/satsang-transmute.fk ../ingest/core-lexicon-vitality.fk
;
; Verdict 2047 when all eleven readings hold.

(do
    (defn clvb-score (ok bit) (if ok bit 0))
    (defn clvb-profile
        (word vitality trust sovereignty coverage proofs residuals source)
        (clv-profile word vitality trust sovereignty coverage proofs residuals source))

    (defn clvb-admitted ()
        (clv-candidate
            (clvb-profile "want" 40 50 70 40 1 3 "fixture-before")
            (clvb-profile "do"   60 70 70 60 2 2 "fixture-after")))
    (defn clvb-sovereignty-drop ()
        (clv-candidate
            (clvb-profile "they" 40 50 80 40 1 3 "fixture-before")
            (clvb-profile "we"   80 80 79 70 2 2 "fixture-after")))
    (defn clvb-unmeasured ()
        (clv-candidate
            (clvb-profile "less" 40 50 70 40 0 3 "fixture-before")
            (clvb-profile "more" 60 70 70 60 0 2 "fixture-after")))
    (defn clvb-no-coverage-lift ()
        (clv-candidate
            (clvb-profile "before" 40 50 70 60 1 3 "fixture-before")
            (clvb-profile "after"  60 70 70 60 2 2 "fixture-after")))
    (defn clvb-not-core ()
        (clv-candidate
            (clvb-profile "some" 40 50 70 40 1 3 "fixture-before")
            (clvb-profile "maybe" 60 70 70 60 2 2 "fixture-after")))
    (defn clvb-second-admitted ()
        (clv-candidate
            (clvb-profile "want" 40 50 70 40 1 3 "fixture-before")
            (clvb-profile "make" 65 75 70 65 3 1 "fixture-after-two")))

    (defn core-lexicon-vitality-band ()
        (do
            (let admitted (clvb-admitted))
            (let sovereignty-drop (clvb-sovereignty-drop))
            (let unmeasured (clvb-unmeasured))
            (let no-coverage-lift (clvb-no-coverage-lift))
            (let not-core (clvb-not-core))
            (let one (list admitted))
            (let duplicate (list admitted (clvb-second-admitted)))
            (let tended (clv-tended-words one))
            (let receipt (clv-receipt admitted))

            (add
                ; An earned candidate is acknowledged 1 and freezes.
                (clvb-score
                    (and (eq (clv-ack-kind admitted) (stx-tag-one))
                         (eq (clv-verdict admitted) 2)) 1)
            (add
                ; The admitted successor is served.
                (clvb-score (str_eq (clv-serve-word "want" one) "do") 2)
            (add
                ; A sovereignty loss is declined and the original remains.
                (clvb-score
                    (and (eq (clv-ack-kind sovereignty-drop) (stx-tag-zero))
                         (str_eq (clv-served-candidate-word sovereignty-drop)
                                 "they")) 4)
            (add
                ; Missing proof rests as nothing and keeps the original visible.
                (clvb-score
                    (and (eq (clv-ack-kind unmeasured) (stx-tag-nothing))
                    (and (eq (clv-verdict unmeasured) 1)
                         (str_eq (clv-served-candidate-word unmeasured) "less"))) 8)
            (add
                ; One admitted overlay changes exactly one of the 64 surfaces.
                (clvb-score
                    (and (eq (len tended) 64)
                         (eq (clv-transmuted-count one) 1)) 16)
            (add
                ; The tended surface stays closed over the core dictionary.
                (clvb-score
                    (and (eq (clv-all-core? tended) 1)
                         (eq (cl-count) 64)) 32)
            (add
                ; Ambiguous candidates cannot crown a winner.
                (clvb-score
                    (and (eq (clv-candidate-count-for duplicate "want") 2)
                         (str_eq (clv-serve-word "want" duplicate) "want")) 64)
            (add
                ; The receipt serves the successor while rollback reads the original.
                (clvb-score
                    (and (str_eq (clv-receipt-served receipt) "do")
                    (and (str_eq (clv-receipt-proposed receipt) "do")
                         (str_eq (clv-rollback receipt) "want"))) 128)
            (add
                ; Equality is not improvement: strict vitality/trust lift is required.
                (clvb-score
                    (eq (clv-better?
                        (clv-candidate
                            (clvb-profile "here" 60 60 70 60 1 2 "fixture-before")
                            (clvb-profile "there" 60 60 70 70 2 1 "fixture-after")))
                        0) 256)
            (add
                ; Coverage is part of vitality; other gains cannot hide its stall.
                (clvb-score
                    (eq (clv-ack-kind no-coverage-lift) (stx-tag-zero)) 512)
                ; A word outside the core is declined and cannot enter the overlay.
                (clvb-score
                    (and (eq (clv-ack-kind not-core) (stx-tag-zero))
                         (str_eq (clv-serve-word "some" (list not-core)) "some"))
                    1024)))))))))))))

    (core-lexicon-vitality-band))
