; form-cli-heed-cursor-adversarial-band.fk — the cursor meets streams built to
; break it, and every failure it can have is a NAMED observation.
;
; THE DEFECT THIS BAND EXISTS FOR. An earlier cursor held one rolling window
; clipped from the left at frame width. An over-long query pushed its own open
; mark out of that window, the frame never completed, and the model asked and
; heard nothing back — no observation, no reason, no status. A status could have
; named it and none did. Bit 512 is that regression, held down: the open mark
; must still be there after the query outgrows its budget.
;
; NO PRETOKENIZATION, NO CLIPPING THE MARK AWAY. The repair is two named caps
; from the law, not a bigger buffer: fhm-detect-cap() before an open mark is
; seen, fhm-hold-cap() from it onward. Bytes only. No ops table, no flattened
; surface, no token index, and no runtime C.
;
; TIMEOUT IS A NAMED OBSERVATION CARRYING ITS MEASUREMENT, never 0/1 — bit 128.
;
; THE CUT WAS MADE AGAINST EVIDENCE — bit 256. Three candidate framings for an
; over-long query are scored on four observable criteria in the law itself, and
; the band witnesses which one wins rather than taking the author's word.
;
; PROOF LEVEL: pure arithmetic, string and list folds over the lowered xtal, plus
; now_unix_ms inside fhc-honor (read twice, differenced; the toy lookups return
; at once so the elapsed reading is 0 and the verdict is deterministic). No GPU,
; no weights, no index, no host organ beyond that clock. A candidate for a
; four-arm run; NOT claimed as one — the four-arm surface is source_jit_gate's.
; What is witnessed below is the fkwu arm.
;
; Verdict 2047:
;   1     exact limit — a 256-byte query is held, then completes and fires
;   2     one byte over — 257 refuses, names query-budget-exceeded, does NO lookup
;   4     a refusal costs no budget: lookups 0, injected 0, refused 1
;   8     way over (640 bytes) refuses once, and the stream RECOVERS
;   16    after recovery a later valid envelope still fires — the window reset
;   32    an embedded close mark ends the frame early, at the first close
;   64    a nested open is carried whole to the adapter, not silently dropped
;   128   timeout is a named observation carrying its ms, not a bit
;   256   the framing cut is observable: hold-refuse-typed strictly wins
;   512   THE REGRESSION: the open mark survives an over-long query
;   1024  THE LIVE-WITNESSED REGRESSION: a prefill's first token is part of the
;         reply. It must reach the window and `out`, or an envelope that begins
;         with it loses its first byte and never matches. Qwen found this; three
;         green bands had not.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-heedmark-xtal.fk
; preludes: form-stdlib/form-cli-heed-cursor.fk
; witnessed: 2026-08-24 -> 2047 on fkwu; hold-cap 280, exact 256 fires, 257 refuses,
;            seed token reaches out (live Qwen witness found the seed drop)

(do
    ; ── pieces ─────────────────────────────────────────────────────────────
    (defn fhca-fill () "abcdefghijklmnopqrstuvwxyz012345")          ; exactly 32
    (defn fhca-whole ()
        (str_concat (HeedOpen) (str_concat "q" (HeedClose))))

    ; Sequences, each in its own id range so every branch is reachable and the
    ; walk stays a pure function of the id.
    ;   100..110  exact limit      open, 8x32 = 256, close, end
    ;   200..211  one byte over    open, 8x32, "x", close, end
    ;   300..324  way over         open, 20x32 = 640, close, " ok", whole, end
    ;   400..403  repeated heeds   three whole envelopes, end
    (defn fhca-piece (id)
        (if (eq id 100) (HeedOpen)
        (if (and (ge id 101) (le id 108)) (fhca-fill)
        (if (eq id 109) (HeedClose)
        (if (eq id 110) " end"
        (if (eq id 200) (HeedOpen)
        (if (and (ge id 201) (le id 208)) (fhca-fill)
        (if (eq id 209) "x"
        (if (eq id 210) (HeedClose)
        (if (eq id 211) " end"
        (if (eq id 300) (HeedOpen)
        (if (and (ge id 301) (le id 320)) (fhca-fill)
        (if (eq id 321) (HeedClose)
        (if (eq id 322) " ok"
        (if (eq id 323) (fhca-whole)
        (if (eq id 324) " end"
        (if (and (ge id 400) (le id 402)) (fhca-whole)
        (if (eq id 403) " end"
        (if (eq id 900) ""
            " z")))))))))))))))))))

    (defn fhca-next (id)
        (if (eq id 900) 401
        (if (and (ge id 99) (lt id 110)) (add id 1)
        (if (and (ge id 199) (lt id 211)) (add id 1)
        (if (and (ge id 299) (lt id 324)) (add id 1)
        (if (and (ge id 399) (lt id 403)) (add id 1)
            999))))))

    (defn fhca-decode-loop (ids acc)
        (if (eq (len ids) 0) acc
            (fhca-decode-loop (tail ids) (str_concat acc (fhca-piece (head ids))))))
    (defn fhca-decodef (ctx ids) (fhca-decode-loop ids ""))
    (defn fhca-stepf (ctx id pos) (fhca-next id))
    (defn fhca-encode-n (n i acc)
        (if (ge i n) acc (fhca-encode-n n (add i 1) (append acc (list 901)))))
    (defn fhca-encodef (ctx text)
        (if (eq (str_len text) 0) (empty)
            (fhca-encode-n (add (div (str_len text) 8) 1) 0 (empty))))
    (defn fhca-prefillf (ctx ids pos) (list 900 (add pos (len ids))))

    (defn fhca-hit-span ()
        (str_concat "<|form:knowledge-observation|>\nstatus=hit\nsource-path=core.fk"
                    "\nanswer:quiet\n<|/form:knowledge-observation|>"))
    (defn fhca-lookup-hit (ctx surface local-ready)
        (list "hit" (fhca-hit-span) "grounded-hit"))

    (defn fhca-run (start budget n)
        (fhc-run 0 fhca-stepf fhca-prefillf fhca-decodef fhca-encodef
            fhca-lookup-hit 1 start 0 n (list 999) (fhc-fresh budget) (empty)))

    (defn fhca-cur (r) (fhc-cursor-of r))
    (defn fhca-count-loop (xs name acc)
        (if (eq (len xs) 0) acc
            (fhca-count-loop (tail xs) name (add acc (if (str_eq (head xs) name) 1 0)))))
    (defn fhca-count (r name) (fhca-count-loop (fhc-honored (fhca-cur r)) name 0))
    (defn fhca-bit (ok bit) (if ok bit 0))

    ; ── the runs ───────────────────────────────────────────────────────────
    (let exact (fhca-run 99 1 10))       ; 100..109, query exactly 256
    (let over1 (fhca-run 199 1 10))      ; 200..209, query 257 — one byte over
    ; 300..324: a 640-byte query then a valid envelope. Budget 1 on purpose —
    ; the toy prefill resumes at id 900, which rejoins the repeated-heeds
    ; sequence, and those later completions are then correctly reported spent
    ; rather than firing. The cursor is doing the right thing either way; this
    ; keeps the run's counts about sequence C alone.
    (let wayover (fhca-run 299 1 26))
    (let repeated (fhca-run 399 2 12))   ; three envelopes, budget 2

    ; ── embedded marks, read directly off the scan and the frame ───────────
    (let embedded-close
        (str_concat (HeedOpen) (str_concat "a" (str_concat (HeedClose)
            (str_concat "b" (HeedClose))))))
    (let nested-open
        (str_concat (HeedOpen) (str_concat "a" (str_concat (HeedOpen)
            (str_concat "b" (HeedClose))))))

    ; ── the over-long window, to hold the regression down ──────────────────
    ; Feed an open mark and then far more than a legal query, one token at a
    ; time, exactly as the cursor does.
    (defn fhca-feed-fill (w i n)
        (if (ge i n) w (fhca-feed-fill (fhc-feed w (fhca-fill)) (add i 1) n)))
    (let long-window (fhca-feed-fill (fhc-feed "" (HeedOpen)) 0 20))

    (let b0 (fhca-bit (and (eq (fhc-lookups (fhca-cur exact)) 1)
                      (and (eq (fhca-count exact "hit") 1)
                           (eq (fhc-refused (fhca-cur exact)) 0))) 1))
    (let b1 (fhca-bit (and (eq (fhc-refused (fhca-cur over1)) 1)
                      (and (eq (fhca-count over1 (fhm-over-reason)) 1)
                           (eq (fhc-lookups (fhca-cur over1)) 0))) 2))
    ; a refusal spends nothing: budget untouched, nothing injected
    (let b2 (fhca-bit (and (eq (fhc-injected (fhca-cur over1)) 0)
                      (and (eq (fhc-budget (fhca-cur over1)) 1)
                           (eq (fhca-count over1 "hit") 0))) 4))
    (let b3 (fhca-bit (and (eq (fhc-refused (fhca-cur wayover)) 1)
                           (eq (fhca-count wayover (fhm-over-reason)) 1)) 8))
    ; the stream RECOVERED: the later whole envelope at 323 still fired
    (let b4 (fhca-bit (and (eq (fhca-count wayover "hit") 1)
                      (and (eq (fhc-lookups (fhca-cur wayover)) 1)
                           (gt (fhc-injected (fhca-cur wayover)) 0))) 16))
    ; an embedded close ends the frame at the FIRST close, not the last
    (let b5 (fhca-bit (and (str_eq (fhc-scan embedded-close) (fhm-state-complete))
                      (and (str_eq (fhc-frame embedded-close)
                                (str_concat (HeedOpen) (str_concat "a" (HeedClose))))
                           (lt (str_len (fhc-frame embedded-close))
                               (str_len embedded-close)))) 32))
    ; a nested open is carried WHOLE to the adapter — the cursor does not parse
    (let b6 (fhca-bit (and (str_eq (fhc-scan nested-open) (fhm-state-complete))
                      (and (str_eq (fhc-frame nested-open) nested-open)
                           (ge (str_find (fhc-frame nested-open) (HeedOpen)
                                (str_len (HeedOpen))) 0))) 64))
    ; timeout names itself and carries the measurement
    (let b7 (fhca-bit (and (and (eq (fhm-late? (add (LookupLateMs) 1)) 1)
                                (eq (fhm-late? 0) 0))
                      (and (ge (str_find (fhm-late-reason 4321) "4321" 0) 0)
                           (str_eq (nth (fhm-late-observation 4321) 0) "timeout"))) 128))
    ; the cut was made against evidence, not taste
    (let b8 (fhca-bit (and (str_eq (fhm-best-framing) "hold-refuse-typed")
                      (and (gt (fhm-framing-score "hold-refuse-typed")
                               (fhm-framing-score "clip-left-silent"))
                           (gt (fhm-framing-score "hold-refuse-typed")
                               (fhm-framing-score "hold-truncate-lookup")))) 256))
    ; THE REGRESSION: 24 + 640 bytes fed in, and the open mark is STILL THERE.
    ; The old clip-left window would have eaten it and gone silent.
    (let b9 (fhca-bit (and (eq (str_find long-window (HeedOpen) 0) 0)
                      (and (str_eq (fhc-scan long-window) (fhm-state-over))
                           (and (eq (fhm-hold-cap) 280)
                                (gt (str_len long-window) (fhm-hold-cap))))) 512))

    ; THE LIVE-WITNESSED REGRESSION. Seed the cursor with a token that is itself
    ; a whole envelope: it must be honored AND appear as the first id of `out`.
    ; The dropped-seed wiring produced neither.
    (let seeded (fhc-run-seeded 0 fhca-stepf fhca-prefillf fhca-decodef fhca-encodef
                    fhca-lookup-hit 1 400 0 4 (list 999) 1))
    (let b10 (fhca-bit (and (eq (fhc-lookups (fhca-cur seeded)) 1)
                       (and (gt (len (fhc-out seeded)) 0)
                            (eq (head (fhc-out seeded)) 400))) 1024))

    (add b0 (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 (add b9 b10)))))))))))
