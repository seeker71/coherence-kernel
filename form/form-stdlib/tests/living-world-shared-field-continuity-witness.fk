; living-world-shared-field-continuity-witness.fk -- an evolved transition and
; its learned surface cross the registry-free carrier, require fresh holder
; responses, then receive new evidence after restoration.
; preludes: form-stdlib/core.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/living-world-shared-field-continuity.fk form-stdlib/tests/living-world-session-learning-witness.fk form-stdlib/tests/living-world-shared-field-channel-witness.fk

(let LWSFCW-CUSTODIAN-PROV (bp "LWSFCW-CUSTODIAN-PROV"))
(let LWSFCW-RESTORE-PROV   (bp "LWSFCW-RESTORE-PROV"))

(defn lwsfcw-cell (kind) (intern_node kind (empty)))
(defn lwsfcw-custodian-provenance ()
    (lwsfcw-cell LWSFCW-CUSTODIAN-PROV))
(defn lwsfcw-restore-provenance (proposal source)
    (intern_node LWSFCW-RESTORE-PROV
        (list proposal source (lwo-local-path))))

(defn lwsfcw-before-path ()
    "/tmp/coherence-living-world-shared-field-before-v1.ccs")
(defn lwsfcw-after-path ()
    "/tmp/coherence-living-world-shared-field-after-v1.ccs")
(defn lwsfcw-remove (path)
    (if (eq (fs-exists? path) 1) (fs-remove-file path) 0))
(defn lwsfcw-clean ()
    (do
        (lwsfcw-remove (lwsfcw-before-path))
        (lwsfcw-remove (lwcd-pending-path (lwsfcw-before-path)))
        (lwsfcw-remove (lwsfcw-after-path))
        (lwsfcw-remove (lwcd-pending-path (lwsfcw-after-path)))))

(defn lwsfcw-image-entry (image)
    (lwt-entry
        (lwo-offer (lwsnw-source-f) (lwsnw-interface) 1 image
            (lwsfcw-custodian-provenance) 1)
        (lwsnw-action)))

(defn lwsfcw-response-entry (proposal source)
    (do
        (let provenance (lwsfcw-restore-provenance proposal source))
        (lwt-entry
            (lwo-offer source (lwsnw-interface) 1
                (lwt-response proposal (oac-one proposal) provenance)
                provenance 1)
            (lwsnw-action))))
(defn lwsfcw-response-items (proposal items)
    (if (eq (len items) 0) (list)
        (cons (lwsfcw-response-entry proposal (head items))
            (lwsfcw-response-items proposal (tail items)))))
(defn lwsfcw-responses (proposal)
    (lwsfcw-response-items proposal
        (lwo-field-items (lwt-proposal-participants proposal))))

; Returns state, current answer, first session receipt, first candidate,
; learned symbol candidate.
(defn lwsfcw-seed (started)
    (do
        (let state-0 (lwsf-open 2 (lwsnw-action)))
        (let offer-a
            (lwsfw-apply state-0
                (lwsf-session (lwsnw-offer-a)
                    (lwsnw-consent (lwsnw-source-a))
                    (lwsnw-action) 0)
                started 10))
        (let offer-b
            (lwsfw-apply (lwsf-step-state offer-a)
                (lwsf-session (lwsnw-offer-a)
                    (lwsnw-consent (lwsnw-source-b))
                    (lwsnw-action) 0)
                started 11))
        (let proposal-a
            (lwsnw-find-proposal
                (lwsf-settlement-proposals
                    (lwsf-step-settlement offer-b))
                (lwsnw-outcome-a)))
        (let response-a
            (lwsfw-apply (lwsf-step-state offer-b)
                (lwsfw-response-entry (lwsnw-source-a) proposal-a
                    (oac-one (lwt-proposal-candidate proposal-a))
                    (lwsnw-prov-a))
                started 12))
        (let response-b
            (lwsfw-apply (lwsf-step-state response-a)
                (lwsfw-response-entry (lwsnw-source-b) proposal-a
                    (oac-one (lwt-proposal-candidate proposal-a))
                    (lwsnw-prov-b))
                started 13))
        (let structural-question
            (lwsfw-apply (lwsf-step-state response-b)
                (lwsfw-question-entry (lwsnw-source-e)) started 14))
        (let structural-answer (lwsf-step-answer structural-question))
        (let derivation
            (lwsnw-find-derivation
                (lwsf-answer-prediction structural-answer)
                (lwsnw-outcome-a)))
        (let symbol-c
            (lwsfw-apply (lwsf-step-state structural-question)
                (lwsnw-symbol-entry
                    (lwsnw-source-c) (lwsnw-prov-c) derivation)
                started 15))
        (let symbol-d
            (lwsfw-apply (lwsf-step-state symbol-c)
                (lwsnw-symbol-entry
                    (lwsnw-source-d) (lwsnw-prov-d) derivation)
                started 16))
        (let symbol-proposal
            (lwsnw-find-symbol-proposal-items
                (lwo-field-items
                    (lwsf-settlement-proposals
                        (lwsf-step-settlement symbol-d))) derivation))
        (let symbol-response-c
            (lwsfw-apply (lwsf-step-state symbol-d)
                (lwsfw-response-entry (lwsnw-source-c) symbol-proposal
                    (oac-one (lwt-proposal-candidate symbol-proposal))
                    (lwsnw-prov-c))
                started 17))
        (let symbol-response-d
            (lwsfw-apply (lwsf-step-state symbol-response-c)
                (lwsfw-response-entry (lwsnw-source-d) symbol-proposal
                    (oac-one (lwt-proposal-candidate symbol-proposal))
                    (lwsnw-prov-d))
                started 18))
        (let voiced-question
            (lwsfw-apply (lwsf-step-state symbol-response-d)
                (lwsfw-question-entry (lwsnw-source-e)) started 19))
        (list (lwsf-step-state voiced-question)
              (lwsf-step-answer voiced-question)
              (lwsf-step-boundary offer-a)
              (lwt-proposal-candidate proposal-a)
              (lwt-proposal-candidate symbol-proposal))))

(defn lwsfcw-run (started)
    (do
        (lwsfcw-clean)
        (let seed (lwsfcw-seed started))
        (let seed-state (nth seed 0))
        (let seed-answer (nth seed 1))
        (let seed-receipt (nth seed 2))
        (let candidate-a (nth seed 3))
        (let symbol-candidate (nth seed 4))
        (let image (lwsfc-image seed-state))
        (let image-text (ccs-emit image))
        (let image-roundtrip (ccs-decode image-text))
        (let saved
            (lwcd-save-new (lwsfcw-before-path) image (lwo-none)))
        (let loaded (lwcd-load (lwsfcw-before-path) (lwo-none)))
        (let loaded-image (lwcd-result-image loaded))
        (let image-entry (lwsfcw-image-entry loaded-image))
        (let admission
            (lwt-receive-stream (lwo-empty-world) (list image-entry)))
        (let restore-proposal
            (lwcn-restore-proposal admission loaded-image))
        (let responses (lwsfcw-responses restore-proposal))
        (let partial
            (lwsfc-restore-observed loaded-image image-entry
                (tail responses) 2 (lwsnw-action) started 20))
        (let restored
            (lwsfc-restore-observed loaded-image image-entry
                responses 2 (lwsnw-action) started 21))
        (let restored-state (lwsfc-result-state restored))
        (let restored-question
            (lwsfw-apply restored-state
                (lwsfw-question-entry (lwsnw-source-e)) started 22))
        (let restored-answer (lwsf-step-answer restored-question))

        ; New evidence after restoration grows a second branch.
        (let outcome-c
            (lwsfw-apply (lwsf-step-state restored-question)
                (lwsf-session (lwsnw-offer-b)
                    (lwsnw-consent (lwsnw-source-c))
                    (lwsnw-action) 0)
                started 23))
        (let outcome-d
            (lwsfw-apply (lwsf-step-state outcome-c)
                (lwsf-session (lwsnw-offer-b)
                    (lwsnw-consent (lwsnw-source-d))
                    (lwsnw-action) 0)
                started 24))
        (let proposal-b
            (lwsnw-find-proposal
                (lwsf-settlement-proposals
                    (lwsf-step-settlement outcome-d))
                (lwsnw-outcome-b)))
        (let response-c
            (lwsfw-apply (lwsf-step-state outcome-d)
                (lwsfw-response-entry (lwsnw-source-c) proposal-b
                    (oac-one (lwt-proposal-candidate proposal-b))
                    (lwsnw-prov-c))
                started 25))
        (let response-d
            (lwsfw-apply (lwsf-step-state response-c)
                (lwsfw-response-entry (lwsnw-source-d) proposal-b
                    (oac-one (lwt-proposal-candidate proposal-b))
                    (lwsnw-prov-d))
                started 26))
        (let candidate-b (lwt-proposal-candidate proposal-b))
        (let plural-question
            (lwsfw-apply (lwsf-step-state response-d)
                (lwsfw-question-entry (lwsnw-source-e)) started 27))
        (let plural-answer (lwsf-step-answer plural-question))

        ; Historical owner release remains live after the process seam.
        (let revoke-a
            (lwsfw-apply (lwsf-step-state plural-question)
                (lwsfw-revocation-entry (lwsnw-source-a)
                    (lwsn-receipt-payload seed-receipt))
                started 28))
        (let final-question
            (lwsfw-apply (lwsf-step-state revoke-a)
                (lwsfw-question-entry (lwsnw-source-e)) started 29))
        (let final-state (lwsf-step-state final-question))
        (let final-answer (lwsf-step-answer final-question))
        (let final-image (lwsfc-image final-state))
        (let final-saved
            (lwcd-save-new (lwsfcw-after-path) final-image (lwo-none)))
        (let final-loaded
            (lwcd-load (lwsfcw-after-path) (lwo-none)))
        (let events (framebuffer-events))

        (let bits
            (list
                (if (and (eq (oac-one? (lwsf-answer-ack seed-answer)) 1)
                         (eq (oac-one?
                                (lwsf-answer-voice-ack seed-answer)) 1)) 1 0)
                (if (and (eq (lwcn-image-valid? image) 1)
                         (eq (ccs-supported? image) 1)) 1 0)
                (if (and (eq (ccs-canonical? image-text) 1)
                         (node_eq image-roundtrip image)) 1 0)
                (if (and (eq (lwcd-saved? saved) 1)
                         (eq (fs-exists? (lwsfcw-before-path)) 1)) 1 0)
                (if (and (eq (lwcd-loaded? loaded) 1)
                         (node_eq loaded-image image)) 1 0)
                (if (node_eq
                        (lwsf-answer-for (lwo-empty-world)
                            (lwsfw-question))
                        (lwo-none)) 1 0)
                (if (eq (lwo-field-size
                            (lwt-proposal-participants restore-proposal)) 5) 1 0)
                (if (and (eq (oac-nothing?
                                (lwsfc-result-ack partial)) 1)
                         (and (node_eq (lwsfc-result-state partial) (lwo-none))
                              (eq (lwt-outcome-missing
                                    (lwsfc-result-outcome partial)) 1))) 1 0)
                (if (and (eq (oac-one?
                                (lwsfc-result-ack restored)) 1)
                         (eq (lwsf-state? restored-state) 1)) 1 0)
                (if (eq (lwcn-restored?
                            (lwsf-state-world restored-state)
                            (lwt-proposal-candidate restore-proposal)) 1) 1 0)
                (if (and (eq (lwsn-trace-current?
                                (lwsfw-world restored-question)
                                (lwsf-answer-trace restored-answer)) 1)
                         (node_eq restored-answer seed-answer)) 1 0)
                (if (and (eq (lwsf-state-threshold restored-state) 2)
                         (node_eq (lwsf-state-action restored-state)
                                  (lwsnw-action))) 1 0)
                (if (and (not (node_eq proposal-b (lwo-none)))
                         (eq (lwo-field-size
                                (lwt-proposal-participants proposal-b)) 2)) 1 0)
                (if (eq (lwtf-integrated-current?
                            (lwsfw-world response-d) candidate-b) 1) 1 0)
                (if (and (eq (oac-node?
                                (lwsf-answer-ack plural-answer)) 1)
                         (eq (lwo-field-size
                                (lwtf-prediction-nexts
                                    (lwsf-answer-prediction plural-answer))) 2)) 1 0)
                (if (and (eq (oac-one?
                                (lwsf-answer-voice-ack restored-answer)) 1)
                         (str_eq
                            (lwtx-surface-text
                                (head (lwo-field-items
                                    (lwtx-plan-surfaces
                                        (lwsf-answer-plan restored-answer)))))
                            "arrives")) 1 0)
                (if (and (eq (oac-one? (lwsf-step-ack revoke-a)) 1)
                         (and (eq (lwtf-integrated-current?
                                    (lwsfw-world revoke-a) candidate-a) 0)
                              (eq (lwtf-integrated-current?
                                    (lwsfw-world revoke-a) candidate-b) 1))) 1 0)
                (if (and (eq (oac-one?
                                (lwsf-answer-ack final-answer)) 1)
                         (and (eq (lwsnw-prediction-has?
                                    (lwsf-answer-prediction final-answer)
                                    (lwsnw-outcome-b)) 1)
                              (eq (lwsnw-prediction-has?
                                    (lwsf-answer-prediction final-answer)
                                    (lwsnw-outcome-a)) 0))) 1 0)
                (if (and (eq (oac-nothing?
                                (lwsf-answer-voice-ack final-answer)) 1)
                         (eq (lwsl-integrated-current?
                                (lwsf-state-world final-state)
                                symbol-candidate) 1)) 1 0)
                (if (and (eq (lwcd-saved? final-saved) 1)
                         (and (eq (lwcd-loaded? final-loaded) 1)
                              (node_eq
                                (lwcd-result-image final-loaded)
                                final-image))) 1 0)
                (if (ge (len events) 41) 1 0)))
        (let verdict (lwsnw-verdict bits))
        (lwsfcw-clean)
        verdict))
