; living-world-relational-voice-witness.fk -- arbitrary coordinates learn an ordered voice.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk

(let LWRVW-SLOT-LEFT (bp "LWRVW-SLOT-LEFT"))
(let LWRVW-SLOT-RIGHT (bp "LWRVW-SLOT-RIGHT"))
(let LWRVW-RELATION (bp "LWRVW-RELATION"))
(let LWRVW-OTHER-RELATION (bp "LWRVW-OTHER-RELATION"))
(let LWRVW-LENS (bp "LWRVW-LENS"))
(let LWRVW-EVIDENCE (bp "LWRVW-EVIDENCE"))
(let LWRVW-CAPABILITY (bp "LWRVW-CAPABILITY"))
(let LWRVW-SOURCE-D (bp "LWRVW-SOURCE-D"))
(let LWRVW-SOURCE-E (bp "LWRVW-SOURCE-E"))
(let LWRVW-PROV-D (bp "LWRVW-PROV-D"))
(let LWRVW-PROV-E (bp "LWRVW-PROV-E"))

(defn lwrvw-cell (kind) (intern_node kind (empty)))
(defn lwrvw-slot-left () (lwrvw-cell LWRVW-SLOT-LEFT))
(defn lwrvw-slot-right () (lwrvw-cell LWRVW-SLOT-RIGHT))
(defn lwrvw-relation () (lwrvw-cell LWRVW-RELATION))
(defn lwrvw-other-relation () (lwrvw-cell LWRVW-OTHER-RELATION))
(defn lwrvw-lens () (lwrvw-cell LWRVW-LENS))
(defn lwrvw-evidence () (lwrvw-cell LWRVW-EVIDENCE))
(defn lwrvw-capability () (lwrvw-cell LWRVW-CAPABILITY))
(defn lwrvw-source-d () (lwrvw-cell LWRVW-SOURCE-D))
(defn lwrvw-source-e () (lwrvw-cell LWRVW-SOURCE-E))
(defn lwrvw-prov-d () (lwrvw-cell LWRVW-PROV-D))
(defn lwrvw-prov-e () (lwrvw-cell LWRVW-PROV-E))
(defn lwrvw-referent () (intern_trivial_int 49))

(defn lwrvw-forty-observation ()
    (lwsl-observation-at (lwrvw-referent) (lwrvw-slot-left) "forty"
        (lwo-none) (oac-one (lwrvw-referent)) (lwrvw-evidence)))
(defn lwrvw-nine-observation ()
    (lwsl-observation-at (lwrvw-referent) (lwrvw-slot-right) "-nine"
        (lwo-none) (oac-one (lwrvw-referent)) (lwrvw-evidence)))

(defn lwrvw-recipe-world ()
    (lwt-round-world (lwrew-integrated-round)))
(defn lwrvw-symbol-world ()
    (lwt-receive-stream (lwrvw-recipe-world)
        (list
            (lwslw-entry-a (lwrvw-forty-observation))
            (lwslw-entry-b (lwrvw-forty-observation))
            (lwslw-entry-a (lwrvw-nine-observation))
            (lwslw-entry-b (lwrvw-nine-observation)))))
(defn lwrvw-symbol-round ()
    (do
        (let world (lwrvw-symbol-world))
        (lwt-round world (lwsl-proposals world 2)
            (lwo-empty-field) (lwo-none))))
(defn lwrvw-symbol-proposals ()
    (lwt-round-proposals (lwrvw-symbol-round)))
(defn lwrvw-left ()
    (lwt-proposal-candidate
        (lwslw-find-proposal (lwrvw-symbol-proposals) "forty")))
(defn lwrvw-right ()
    (lwt-proposal-candidate
        (lwslw-find-proposal (lwrvw-symbol-proposals) "-nine")))

(defn lwrvw-symbol-response (source provenance proposal)
    (lwslw-entry-for source provenance
        (lwt-response proposal (oac-one proposal) provenance)))
(defn lwrvw-symbol-yes-round ()
    (do
        (let round (lwrvw-symbol-round))
        (let proposals (lwt-round-proposals round))
        (let left (lwslw-find-proposal proposals "forty"))
        (let right (lwslw-find-proposal proposals "-nine"))
        (lwt-round-receive round
            (list
                (lwrvw-symbol-response
                    (lwslw-source-a) (lwslw-prov-a) left)
                (lwrvw-symbol-response
                    (lwslw-source-b) (lwslw-prov-b) left)
                (lwrvw-symbol-response
                    (lwslw-source-a) (lwslw-prov-a) right)
                (lwrvw-symbol-response
                    (lwslw-source-b) (lwslw-prov-b) right)))))
(defn lwrvw-symbol-integrated-round ()
    (do
        (let round (lwrvw-symbol-yes-round))
        (let proposals (lwt-round-proposals round))
        (let left (lwslw-find-proposal proposals "forty"))
        (let right (lwslw-find-proposal proposals "-nine"))
        (let first (lwsl-integrate round left (lwslw-action)))
        (lwsl-integrate first right (lwslw-action))))
(defn lwrvw-symbol-integrated-world ()
    (lwt-round-world (lwrvw-symbol-integrated-round)))

(defn lwrvw-order-support-a ()
    (lwrl-observation (lwrvw-relation) (lwrvw-left) (lwrvw-right)
        (lwo-none) (oac-one (lwrvw-relation))
        (lwo-empty-field) (lwo-none) (lwrvw-evidence)))
(defn lwrvw-order-support-b ()
    (lwrl-observation (lwrvw-relation) (lwrvw-left) (lwrvw-right)
        (lwrvw-lens) (oac-one (lwrvw-relation))
        (lwo-empty-field) (lwlc-unknown (lwrvw-evidence))
        (lwrvw-evidence)))
(defn lwrvw-order-inverse-c ()
    (lwrl-observation (lwrvw-relation) (lwrvw-right) (lwrvw-left)
        (lwo-none) (oac-one (lwrvw-relation))
        (lwo-empty-field) (lwo-none) (lwrvw-evidence)))
(defn lwrvw-order-inverse-e ()
    (lwrl-observation (lwrvw-relation) (lwrvw-right) (lwrvw-left)
        (lwrvw-lens) (oac-one (lwrvw-relation))
        (lwo-empty-field) (lwlc-unknown (lwrvw-evidence))
        (lwrvw-evidence)))

(defn lwrvw-relation-world ()
    (lwt-receive-stream (lwrvw-symbol-integrated-world)
        (list
            (lwslw-entry-a (lwrvw-order-support-a))
            (lwslw-entry-b (lwrvw-order-support-b))
            (lwslw-entry-c (lwrvw-order-inverse-c)))))
(defn lwrvw-relation-round ()
    (do
        (let world (lwrvw-relation-world))
        (lwt-round world (lwrl-proposals world 2)
            (lwo-empty-field) (lwo-none))))
(defn lwrvw-edge-proposal ()
    (lwrlw-find-proposal (lwt-round-proposals (lwrvw-relation-round))
        (lwrvw-left) (lwrvw-right)))
(defn lwrvw-edge () (lwt-proposal-candidate (lwrvw-edge-proposal)))

(defn lwrvw-relation-response (source provenance proposal)
    (lwslw-entry-for source provenance
        (lwt-response proposal (oac-one proposal) provenance)))
(defn lwrvw-relation-yes-round ()
    (do
        (let round (lwrvw-relation-round))
        (let proposal
            (lwrlw-find-proposal (lwt-round-proposals round)
                (lwrvw-left) (lwrvw-right)))
        (lwt-round-receive round
            (list
                (lwrvw-relation-response
                    (lwslw-source-a) (lwslw-prov-a) proposal)
                (lwrvw-relation-response
                    (lwslw-source-b) (lwslw-prov-b) proposal)
                (lwrvw-relation-response
                    (lwslw-source-c) (lwslw-prov-c) proposal)))))
(defn lwrvw-relation-integrated-round ()
    (do
        (let round (lwrvw-relation-yes-round))
        (let proposal
            (lwrlw-find-proposal (lwt-round-proposals round)
                (lwrvw-left) (lwrvw-right)))
        (lwrl-integrate round proposal (lwslw-action))))
(defn lwrvw-relation-integrated-world ()
    (lwt-round-world (lwrvw-relation-integrated-round)))

(defn lwrvw-basis ()
    (lwt-proposal-candidate
        (lwrew-proposal-for-world (lwrew-world))))
(defn lwrvw-nodes ()
    (lwo-field (list (lwrvw-left) (lwrvw-right))))

(defn lwrvw-entry-for (source provenance payload)
    (lwt-entry
        (lwo-offer source (lwo-interface (list (lwrew-action)))
            1 payload provenance 1)
        (lwrew-action)))
(defn lwrvw-entry-d (payload)
    (lwrvw-entry-for (lwrvw-source-d) (lwrvw-prov-d) payload))
(defn lwrvw-entry-e (payload)
    (lwrvw-entry-for (lwrvw-source-e) (lwrvw-prov-e) payload))
(defn lwrvw-grant-entry (source provenance payload)
    (lwrvw-entry-for source provenance
        (lwcp-grant payload (lwrvw-capability) (lwrvw-evidence))))

(defn lwrvw-world ()
    (lwt-receive-stream (lwrvw-relation-integrated-world)
        (list
            (lwrvw-entry-d (lwrvw-capability))
            ; Exact execution ground.
            (lwrvw-grant-entry (lwrew-source-a) (lwrew-prov-a)
                (lwrvw-basis))
            (lwrvw-grant-entry (lwrew-source-b) (lwrew-prov-b)
                (lwrvw-basis))
            (lwrvw-grant-entry (lwrew-source-a) (lwrew-prov-a)
                (lwrew-recipe))
            (lwrvw-grant-entry (lwrew-source-a) (lwrew-prov-a)
                (lwrew-declaration))
            (lwrvw-grant-entry (lwrew-source-b) (lwrew-prov-b)
                (lwrew-before))
            ; Arbitrary-coordinate learned symbols and their observations.
            (lwrvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwrvw-left))
            (lwrvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwrvw-left))
            (lwrvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwrvw-right))
            (lwrvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwrvw-right))
            (lwrvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwrvw-forty-observation))
            (lwrvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwrvw-forty-observation))
            (lwrvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwrvw-nine-observation))
            (lwrvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwrvw-nine-observation))
            ; Learned relation and every observation needed to rederive it.
            (lwrvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwrvw-edge))
            (lwrvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwrvw-edge))
            (lwrvw-grant-entry (lwslw-source-c) (lwslw-prov-c)
                (lwrvw-edge))
            (lwrvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwrvw-order-support-a))
            (lwrvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwrvw-order-support-b))
            (lwrvw-grant-entry (lwslw-source-c) (lwslw-prov-c)
                (lwrvw-order-inverse-c)))))

(defn lwrvw-context-for (world)
    (lwcp-context world (lwrvw-capability)))
(defn lwrvw-context () (lwrvw-context-for (lwrvw-world)))

(defn lwrvw-proposal-for (world)
    (lwrv-proposal (lwrvw-context-for world)
        (lwrvw-basis) (lwrvw-referent) (lwrvw-relation) (lwrvw-nodes)
        (lwo-empty-field) (lwo-none) (lwo-none) (lwrvw-evidence)))
(defn lwrvw-round ()
    (do
        (let world (lwrvw-world))
        (let proposal (lwrvw-proposal-for world))
        (lwt-round world (lwo-field (list proposal))
            (lwo-empty-field) (lwo-none))))
(defn lwrvw-response (source provenance proposal)
    (lwrvw-entry-for source provenance
        (lwt-response proposal (oac-one proposal) provenance)))
(defn lwrvw-yes-round ()
    (do
        (let round (lwrvw-round))
        (let proposal (head (lwo-field-items (lwt-round-proposals round))))
        (lwt-round-receive round
            (list
                (lwrvw-response
                    (lwrew-source-a) (lwrew-prov-a) proposal)
                (lwrvw-response
                    (lwrew-source-b) (lwrew-prov-b) proposal)
                (lwrvw-response
                    (lwslw-source-a) (lwslw-prov-a) proposal)
                (lwrvw-response
                    (lwslw-source-b) (lwslw-prov-b) proposal)
                (lwrvw-response
                    (lwslw-source-c) (lwslw-prov-c) proposal)
                (lwrvw-response
                    (lwrvw-source-d) (lwrvw-prov-d) proposal)))))
(defn lwrvw-integrated-round ()
    (do
        (let round (lwrvw-yes-round))
        (let proposal (head (lwo-field-items (lwt-round-proposals round))))
        (lwrv-integrate round proposal (lwrew-action))))

(defn lwrvw-late-world ()
    (lwt-receive-stream (lwrvw-world)
        (list (lwrvw-entry-e (lwrvw-order-inverse-e)))))

(defn lwrvw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwrvw-sum (tail items)))))
