; form-cli-nodeid-know-bml-band.fk — knowledge-as-offer, risen to BML.
;
; Verdict 31:
;   1   fnkb-check = 255
;   2   surface and organ both 255 and agree value-for-value
;   4   authority picture names package and class
;   8   executable .bml carries section and know def
;   16  the .bml runs as itself (floor)
;
; preludes: form-stdlib/form-cli-nodeid-know.fk form-stdlib/form-cli-nodeid-know.bml
; witnessed: 2026-08-30 -> 31

(do
    (defn fnkbb-bit (ok bit) (if ok bit 0))
    (defn fnkbb-has? (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let exec-text (read_file "form/form-stdlib/form-cli-nodeid-know.bml"))
    (let pic-text (read_file "form/form-stdlib/bml/form-cli-nodeid-know.bml"))
    (add
        (fnkbb-bit (eq (fnkb-check) 255) 1)
        (add (fnkbb-bit (and (eq (fnk-check) 255)
                             (and (eq (fnkb-check) 255)
                                  (eq (fnk-know-reply "bootstrap/ground")
                                      (fnkb-know-reply "bootstrap/ground")))) 2)
        (add (fnkbb-bit (and (eq (fnkbb-has? pic-text "package Form.cli.nodeidknow") 1)
                             (eq (fnkbb-has? pic-text "class FormNodeidKnow") 1)) 4)
        (add (fnkbb-bit (and (eq (fnkbb-has? exec-text "section [form.bml]") 1)
                             (eq (fnkbb-has? exec-text "def fnkb-know") 1)) 8)
            (fnkbb-bit (eq (fnkbb-has? exec-text "preludes: form-stdlib/form-cli-nodeid-answer.fk") 1) 16))))))
