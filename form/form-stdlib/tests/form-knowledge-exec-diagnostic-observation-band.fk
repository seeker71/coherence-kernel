; form-knowledge-exec-diagnostic-observation-band.fk -- exact retained
; condition identities and interpretation without style-to-semantics leakage.
;
; Verdict 4095 (12 bits).
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-knowledge-exec-diagnostic-observation.fk

(do
    (defn fkedob-bit (ok bit) (if ok bit 0))
    (defn fkedob-run ()
        (do
            (let rows (fkedo-observations))
            (let a (nth rows 0))
            (let b (nth rows 1))
            (let c (nth rows 2))
            (let d (nth rows 3))
            (sum (list
                (fkedob-bit (eq (len rows) 4) 1)
                (fkedob-bit (and (str_eq (fkedo-condition a) "A-base-closed")
                                 (str_eq (fkedo-condition d) "D-form-lora-closed")) 2)
                (fkedob-bit (str_eq (fkedo-prompt-sha a) (fkedo-prompt-sha d)) 4)
                (fkedob-bit (and (eq (fkedo-query a) 0)
                                 (eq (fkedo-query b) 1)) 8)
                (fkedob-bit (and (eq (fkedo-api-grounding a) 0)
                                 (eq (fkedo-api-grounding b) 5)) 16)
                (fkedob-bit (and (eq (fkedo-feedback c) 1)
                    (and (str_eq (fkedo-continuation c)
                                 "continuation-of-B-reloaded-residence")
                         (eq (fkedo-same-residence c) 0))) 32)
                (fkedob-bit (and (eq (fkedo-form-syntax a) 0)
                                 (eq (fkedo-form-syntax d) 1)) 64)
                (fkedob-bit (and (str_eq (fkedo-adapter d) (fkedo-adapter-sha))
                                 (eq (fkedo-response-tokens d) 18)) 128)
                (fkedob-bit (and (eq (fkedo-semantic-max a) 511)
                                 (eq (fkedo-semantic-max d) 511)) 256)
                (fkedob-bit (eq (fkedo-all-semantic-zero? rows) 1) 512)
                (fkedob-bit (eq (fkedo-all-released? rows) 1) 1024)
                (fkedob-bit (and (ge (str_find (fkedo-next-question)
                    "scannerless BMF grammar transport" 0) 0)
                    (and (gt (fkedo-preflight-errors b)
                             (fkedo-preflight-errors c))
                         (lt (fkedo-elapsed-ms d) (fkedo-elapsed-ms a)))) 2048)))))

    (fkedob-run))
