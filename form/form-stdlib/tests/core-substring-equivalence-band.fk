; core-substring-equivalence-band.fk — the halved substring returns exactly what
; the one-byte-at-a-time one returned, on every case that one could reach.
;
; WHY A REFERENCE AND NOT A TABLE. `substring` has 847 call sites here and sits
; under char_at, so what those callers were written against is the LOOP, not
; what one author believed on one afternoon. The loop is kept below verbatim,
; under a private name, and asked the same questions. Where the two disagree the
; disagreement is the finding; no expected value stands between them.
;
; `fstr-substring-loop` is still defined in core.fk and still exact — it is no
; longer what `substring` calls. This band asks it directly, so the comparison
; is against the real previous behaviour rather than a copy that might drift.
;
; UNDEFINED CASES ARE ASKED FOR AGREEMENT, NOT FOR A VALUE. A slice past the end
; of a string reads `str_byte_at` out of bounds, which fkwu recovers to nothing
; and go and rust treat as fatal. This band therefore never asserts WHAT such a
; slice returns — only that both constructions return the same thing, which is
; the whole claim being made. Asserting a value would be inventing a contract
; the body does not have.
;
; ONLY FKWU REACHES EITHER FORM. go, rust and ts keep a native `substring` that
; floors byte offsets to character starts. This band is fkwu's.
;
; Verdict 2047 (11 bits):
;   1     ordinary interior slices, and both boundaries
;   2     empty slice, reversed bounds, and zero-length at every position
;   4     the whole string, and a single byte at each end
;   8     multi-byte UTF-8 sliced on character boundaries
;   16    multi-byte UTF-8 sliced MID-CODEPOINT — every index is a byte offset
;   32    every start/end pair of a short string agrees, exhaustively
;   64    a slice long enough that the join shape differs — 5,000 bytes
;   128   out-of-range end: both forms agree, whatever they do
;   256   negative and past-the-end starts: both forms agree
;   512   real bytes off disk, sliced at several offsets and widths
;   1024  every bit above compared two constructions, not a stored answer
;
; PROOF LEVEL: FKWU-STAGED. The Form recipe under test is not reached on the
; three sibling kernels.
;
; preludes: form-stdlib/core.fk

(do
    (defn cseb-bit (ok bit) (if ok bit 0))

    ; the previous construction, asked directly out of core.fk
    (defn cseb-ref (s start end) (fstr-substring-loop s start end ""))

    (defn cseb-agree? (s start end)
        (if (str_eq (substring s start end) (cseb-ref s start end)) 1 0))

    (defn cseb-and2 (a b) (if (and (eq a 1) (eq b 1)) 1 0))
    (defn cseb-and3 (a b c) (cseb-and2 a (cseb-and2 b c)))
    (defn cseb-and4 (a b c d) (cseb-and2 (cseb-and2 a b) (cseb-and2 c d)))

    ; every (start, end) pair of a string, including the reversed ones
    (defn cseb-sweep-end (s start end)
        (if (gt end (str_len s)) 1
            (if (eq (cseb-agree? s start end) 1)
                (cseb-sweep-end s start (add end 1)) 0)))
    (defn cseb-sweep (s start)
        (if (gt start (str_len s)) 1
            (if (eq (cseb-sweep-end s start 0) 1)
                (cseb-sweep s (add start 1)) 0)))

    (defn cseb-zero-at (s i)
        (if (gt i (str_len s)) 1
            (if (eq (cseb-agree? s i i) 1) (cseb-zero-at s (add i 1)) 0)))

    (defn cseb-dbl (s n) (if (le n 0) s (cseb-dbl (str_concat s s) (sub n 1))))

    (defn core-substring-equivalence-band ()
        (do
            (let h "abcdefghij")
            (let u "aΩb中c—d")          ; 1 + 2 + 1 + 3 + 1 + 3 + 1 = 12 bytes
            (let big (cseb-dbl "0123456789abcdefghijklmnopqrstuvwxyz*" 7))
            (let disk (read_file "form/form-stdlib/core.fk"))

            (sum (list
                (cseb-bit (eq (cseb-and4
                    (cseb-agree? h 2 5)
                    (cseb-agree? h 0 4)
                    (cseb-agree? h 6 10)
                    (cseb-agree? h 1 9)) 1) 1)

                (cseb-bit (eq (cseb-and3
                    (cseb-agree? h 3 3)
                    (cseb-agree? h 7 2)
                    (cseb-zero-at h 0)) 1) 2)

                (cseb-bit (eq (cseb-and3
                    (cseb-agree? h 0 (str_len h))
                    (cseb-agree? h 0 1)
                    (cseb-agree? h 9 10)) 1) 4)

                ; Ω is bytes 1-2, 中 is 4-6, — is 8-10
                (cseb-bit (eq (cseb-and4
                    (cseb-agree? u 1 3)
                    (cseb-agree? u 4 7)
                    (cseb-agree? u 8 11)
                    (cseb-agree? u 0 12)) 1) 8)

                (cseb-bit (eq (cseb-and4
                    (cseb-agree? u 1 2)
                    (cseb-agree? u 5 6)
                    (cseb-agree? u 2 5)
                    (cseb-agree? u 9 10)) 1) 16)

                (cseb-bit (eq (cseb-and2
                    (cseb-sweep h 0)
                    (cseb-sweep u 0)) 1) 32)

                (cseb-bit (eq (cseb-and3
                    (cseb-agree? big 0 5000)
                    (cseb-agree? big 137 4999)
                    (cseb-agree? big 1 4097)) 1) 64)

                (cseb-bit (eq (cseb-and3
                    (cseb-agree? h 0 20)
                    (cseb-agree? h 8 200)
                    (cseb-agree? "" 0 5)) 1) 128)

                (cseb-bit (eq (cseb-and3
                    (cseb-agree? h 20 25)
                    (cseb-agree? h -3 4)
                    (cseb-agree? h -5 -1)) 1) 256)

                (cseb-bit (eq (cseb-and4
                    (cseb-agree? disk 0 400)
                    (cseb-agree? disk 1000 1001)
                    (cseb-agree? disk 2048 6144)
                    (cseb-agree? disk 77 77)) 1) 512)

                (cseb-bit 1 1024)))))

    (core-substring-equivalence-band))
