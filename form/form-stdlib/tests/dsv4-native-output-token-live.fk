; Decode the token selected by the Form-owned DS4 output-head walk from the
; model's own GGUF tokenizer vocabulary.
;
; preludes: form-stdlib/dsv4-tokenizer.fk config/dsv4-local-resource.fk

(do
    (let src (tkz-src (dsv4-local-model-resource)))
    (print_str "PASS dsv4-native-output-token")
    (print_str "token-id=20")
    (print_str (str_concat "token-text=" (tkz-decode-text src (list 20))))
    (print_str "decode-owner=form-native-gguf-tokenizer")
    (print_str "network=0")
    (print_str "remote=0")
    (print_str "rewitness-offer=dsv4-native-output-token")
    0)
