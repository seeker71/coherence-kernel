; Native case observations; the final reading is their conjunction.
; Verdict 1
; preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-code-memory.bml form-stdlib/bml/host-child.bml form-stdlib/core.fk
section [form.bml] {
 let all=true;
 let result0=try [(hch-reaped(0))] catch [];
 let actual0=nil?(result0) ? nothing() : result0[0];
 let expected0=[0,""];
 let held0=len(result0)==1 && actual0==expected0;
 print_str(json-emit(fcam-pack(["hch-reaped(0)",value_kind(actual0),actual0,expected0,held0,len(result0)==1])));
 let all=all && held0;
 let result1=try [(hch-reaped(1))] catch [];
 let actual1=nil?(result1) ? nothing() : result1[0];
 let expected1=[1,""];
 let held1=len(result1)==1 && actual1==expected1;
 print_str(json-emit(fcam-pack(["hch-reaped(1)",value_kind(actual1),actual1,expected1,held1,len(result1)==1])));
 let all=all && held1;
 let result2=try [(hch-reaped(-1))] catch [];
 let actual2=nil?(result2) ? nothing() : result2[0];
 let expected2=[nothing(),"no exit: host_wait answered -1"];
 let held2=len(result2)==1 && actual2==expected2;
 print_str(json-emit(fcam-pack(["hch-reaped(-1)",value_kind(actual2),actual2,expected2,held2,len(result2)==1])));
 let all=all && held2;
 let result3=try [(hch-reaped(nothing()))] catch [];
 let actual3=nil?(result3) ? nothing() : result3[0];
 let expected3=[nothing(),"no exit: no exit arrived"];
 let held3=len(result3)==1 && actual3==expected3;
 print_str(json-emit(fcam-pack(["hch-reaped(nothing())",value_kind(actual3),actual3,expected3,held3,len(result3)==1])));
 let all=all && held3;
 all ? 1 : 0;
}
