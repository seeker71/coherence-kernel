; native-model-session-grounding-native-discovery-band.fk -- a recursive tree
; is observed one directory cell at a time, old subtrees are rejected before
; their children are listed, and retained session descriptors stay bounded.
; No private session source is read by this witness. Verdict 4095 includes the
; native resource lens on the last observed entry cell.
; preludes: form-stdlib/native-model-session-grounding-native-discovery.fk

(do
    (defn nmsgndb-score (condition bit) (if condition bit 0))
    (defn native-model-session-grounding-native-discovery-band ()
        (do
            (let root
                (fs-path-join (fs-temp-dir)
                    (str_concat "native-model-session-grounding-discovery-band-"
                        (int_to_str (now_unix_ms)))))
            ; The previous fixed-name witness left this public fixture because
            ; two identical effect recipes shared one content identity.  Give
            ; that historical cleanup its own path/occurrence; the current
            ; fixture has a fresh path and exactly one removal occurrence.
            (let prior-root
                (fs-path-join (fs-temp-dir)
                    "native-model-session-grounding-discovery-band"))
            (let cleaned-prior (fs-remove-tree prior-root))
            (let prior-run-root
                (fs-path-join (fs-temp-dir)
                    "native-model-session-grounding-discovery-band-1786205270416"))
            (let cleaned-prior-run (fs-remove-tree prior-run-root))
            (let made-root (fs-mkdir root))
            (let nested (fs-path-join root "nested"))
            (let made-nested (fs-mkdir nested))
            (let metadata
                "{\"timestamp\":\"2026-08-09T00:00:00Z\",\"cwd\":\"/fixture/coherence-kernel\",\"parent_thread_id\":\"\"}\n")
            (let foreign
                "{\"timestamp\":\"2026-08-09T00:00:00Z\",\"cwd\":\"/fixture/elsewhere\",\"parent_thread_id\":\"\"}\n")
            (let wrote-a
                (fs-write-text (fs-path-join root "a.jsonl") metadata))
            (let wrote-b
                (fs-write-text (fs-path-join root "b.jsonl") metadata))
            (let wrote-c
                (fs-write-text (fs-path-join nested "c.jsonl") metadata))
            (let wrote-foreign
                (fs-write-text (fs-path-join root "foreign.jsonl") foreign))
            (let started
                (lcfb-open-stream "native-session-discovery-band" "form-native"
                    "directory-cell-cursor" "public-fixture"
                    "form/form-stdlib/tests/native-model-session-grounding-native-discovery-band.fk"
                    43 17))
            (let observed
                (nmsgn-session-tree-root root "/fixture/coherence-kernel" 0 2
                    (nmsgn-empty-selection) started))
            (let observed-events (framebuffer-events))
            (let frames-after-observed (len observed-events))
            (let last-observed (nth observed-events
                (sub frames-after-observed 1)))
            (let last-target
                (node_value (nth (node_children last-observed) 6)))
            (let future-cutoff (add (div (now_unix_ms) 1000) 1000))
            (let pruned
                (nmsgn-session-tree-root root "/fixture/coherence-kernel"
                    future-cutoff 2 (nmsgn-empty-selection) started))
            (let cleaned-after (fs-remove-tree root))
            (sum (list
                (nmsgndb-score
                    (str_eq (nth observed 0) "native-session-selection-v2") 1)
                (nmsgndb-score
                    (eq (nmsgn-selection-source-count observed) 3) 2)
                (nmsgndb-score
                    (eq (len (nmsgn-selection-selected observed)) 2) 4)
                (nmsgndb-score (eq (nmsgn-selection-dirs observed) 2) 8)
                (nmsgndb-score (eq (nmsgn-selection-entries observed) 5) 16)
                (nmsgndb-score (ge frames-after-observed 5) 32)
                (nmsgndb-score
                    (and
                        (eq (len (head
                            (nmsgn-selection-selected observed))) 5)
                        (eq (str_len (nmsgn-session-address (head
                            (nmsgn-selection-selected observed)))) 64)) 64)
                (nmsgndb-score
                    (eq (nmsgn-selection-source-count pruned) 0) 128)
                (nmsgndb-score (eq (nmsgn-selection-dirs pruned) 1) 256)
                (nmsgndb-score (eq (nmsgn-selection-entries pruned) 4) 512)
                (nmsgndb-score (eq cleaned-after 0) 1024)
                (nmsgndb-score
                    (and (eq (lcfb-call? last-observed) 1)
                         (and (gt (str_find last-target ":o" 0) 0)
                              (and (gt (str_find last-target ":n" 0) 0)
                                   (gt (str_find last-target ":e" 0) 0))))
                    2048)))))
    (native-model-session-grounding-native-discovery-band))
