; form-cli-resident-continuity-band.fk — an agent opens at artifact capacity;
; ordinary one-shot work remains exact-need.
;
; preludes: form-stdlib/form-cli-model-session.fk

(do
    (let capacity 32768)
    (let ordinary (fcmg-open-ceiling "full" 96 capacity))
    (let agent (fcmg-open-ceiling (frc-profile) 96 capacity))
    (let residence (fcmr "/m/qwen.gguf" agent (list 1) "src" "qwen35"))
    (let absent-peer (fcms-open-resident-agent "" "bootstrap"))
    (let peer-src (read_file "form/form-stdlib/bml/form-cli-peer-agent-live.bml"))
    (sum (list
        (if (str_eq (frc-profile) "resident-agent") 1 0)
        (if (str_eq (frc-capacity-rule)
                    "open-at-artifact-declared-context-capacity") 2 0)
        (if (str_eq (frc-reuse-rule)
                    "same-sealed-artifact-and-fitting-capsule-reuses-residence") 4 0)
        (if (str_eq (frc-overflow-rule)
                    "beyond-artifact-context-is-typed-local-gap-not-remote-fallback") 8 0)
        (if (eq ordinary 96) 16 0)
        (if (eq agent capacity) 32 0)
        (if (eq (fcmr-fits? residence "/m/qwen.gguf" 1024) 1) 64 0)
        (if (eq (fcmr-fits? residence "/m/qwen.gguf" capacity) 1) 128 0)
        (if (eq (fcmr-fits? residence "/m/qwen.gguf" (add capacity 1)) 0) 256 0)
        (if (eq (frc-is-agent-profile? (frc-profile)) 1) 512 0)
        (if (eq (frc-is-agent-profile? "full") 0) 1024 0)
        (if (str_eq (frc-peer-open-rule)
                    "resident-peer-opens-at-artifact-declared-context-capacity") 2048 0)
        (if (str_eq (fcms-reason absent-peer) "model-path-absent") 4096 0)
        (if (and (ge (str_find peer-src "fcms-open-resident-agent" 0) 0)
                 (lt (str_find peer-src "(fcms-open path (fcpa-bootstrap) 4096)" 0) 0))
            8192 0)
        (if (str_eq (frc-stage-rule)
                    "admission-emits-native-framebuffer-stages-before-and-after-open-prefill")
            16384 0)
        (if (and (ge (str_find (read_file "form/form-stdlib/form-cli-model-session.fk")
                               "model-session-seal-begin" 0) 0)
                 (ge (str_find (read_file "form/form-stdlib/form-cli-model-session.fk")
                               "model-session-open-prefill-complete" 0) 0))
            32768 0)
        (if (and (ge (str_find (read_file "form/form-stdlib/form-cli-model-session.fk")
                               "model-session-header-begin" 0) 0)
                 (ge (str_find (read_file "form/form-stdlib/form-cli-model-session.fk")
                               "model-session-header-complete" 0) 0))
            65536 0)
        (if (and (ge (str_find (read_file "form/form-stdlib/form-cli-model-session.fk")
                               "model-session-tokenizer-crystal-begin" 0) 0)
                 (ge (str_find (read_file "form/form-stdlib/form-cli-model-session.fk")
                               "model-session-tokenizer-crystal-complete" 0) 0))
            131072 0)
        (if (and (ge (str_find (read_file "form/form-stdlib/form-cli-model-session.fk")
                               "model-session-prompt-cursor-begin" 0) 0)
                 (ge (str_find (read_file "form/form-stdlib/form-cli-model-session.fk")
                               "model-session-prompt-cursor-complete" 0) 0))
            262144 0)
        (if (and (ge (str_find (read_file "form/form-stdlib/form-cli-model-session.fk")
                               "model-session-prompt-count-begin" 0) 0)
                 (ge (str_find (read_file "form/form-stdlib/form-cli-model-session.fk")
                               "model-session-prompt-count-complete" 0) 0))
            524288 0)
        (if (and (ge (str_find (read_file "form/form-stdlib/form-cli-model-session.fk")
                               "model-session-prompt-cursor-reopen-begin" 0) 0)
                 (ge (str_find (read_file "form/form-stdlib/form-cli-model-session.fk")
                               "model-session-prompt-cursor-reopen-complete" 0) 0))
            1048576 0))))
