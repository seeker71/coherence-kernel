; arg-order-lane-parity-band.fk -- one contract, every lane: the cold walker, the ANF evaluator, and the C loop lane
; heated past 1024 calls must write the same BYTE SEQUENCE; every Form lane must decline what its vocabulary cannot name.
;
; Found 2026-10-03: past FK_F64_HEAT (1024) the C loop lane crystallizes a recipe and inlines small callees by
; substituting each argument EXPRESSION at the callee's parameter reads. A parameter the body never reads dropped its
; argument (and the appends inside it); one read twice ran it twice; one read in an untaken branch ran it never. The walker
; evaluates each argument once, in order, read or not. dd397a892 guards the C inliner; this band is the check that
; survives it: the contract is anf-lower.bml's rows, anf-eval runs them, and the hot walker is held to that sequence.
;
; Each shape (tests/arg-order-shapes-fixture.bml) appends distinct bytes to a scratch file. It runs
;   cold   the walker, N=50 -- under the heat, the reference every lane inherits
;   anf50  anf-eval at N=50: must equal cold, byte for byte
;   hot    the SAME defns run on to N=2500 (250 rounds for the pair), which crosses the heat inside the call
;   anf    anf-eval at N=2500: the contract sequence the hot walker must equal
; and the walker's answers (values) must equal anf-eval's.
;
;   1    native-t5 pair (mutual recursion, the next ignoring its first parameter, an effectful call as argument)
;   2    a callee that never reads its first parameter
;   4    a callee that reads it twice
;   8    a callee that reads it only in a branch never taken
;   16   an unread let bound to an effect
;   32   nested pairs of effectful arguments, the walker's number kept
;   64   pure arguments: the sum is exact
;   128  three effectful arguments, the callee reading only the middle one
;   256  the decline family, hg-request and jonb-request: a host-effect row the root does not reach, and a node tag the
;        lowering does not cover, answer nothing() on route "refused" -- never a value from a program that lost a node
;   512  lo-compile-fn: the same two programs lower to nothing(), never to a shorter image
;   1024 bdj-request (bml-demand-jit): the same two programs are refused with value nothing(); a program it covers
;        (ARG + 2, and a tag-14 root the form route evaluates) is still answered, by the form route
;   2048 gl-lower declines the effectful defns, by name; anf-lower declines the one holding an unknown node with a reason
;        and lowers the effectful defn whose every node it names
;   4096 native division: a negative dividend through jit_leaf_inram equals the walker's /, with no reader knowing a
;        width (the unsigned divide answered -7/2 as 2147483644; the walker says -3; form-lower's epilogue now
;        sign-extends, so the page answers -3). A division whose divisor is not a nonzero literal is DECLINED to the
;        form route (native route false), whose answer is the walker's.
;   8192 the zero divisor: the walker stops ("integer division by zero"), a native page answers 0 and cannot stop, so
;        no lane lowers it -- every request for it stops, as the walker does (attempt reads each stop as nothing())
;
; Verdict 16383 when every claim lands. Witnessed 2026-10-03: the runtime without dd397a892's guard reads 8164 -- bits 1, 2,
; 8 and 16 fail, the hot walker writing 2270 of 6500 bytes (the pair) and 1944 of 5000 (ignored argument, untaken branch,
; unread let), while bits 4, 32, 64 and 128 hold; the guarded runtime reads 8191.
; REQUIRES: (jit_leaf_inram and the C loop lane's heat are fkwu's own; bit 4096 needs the carrier door)
; preflight-exec: forbidden
import form-stdlib/bml/anf-lower.bml;
import form-stdlib/tests/arg-order-shapes-fixture.bml;
import form-stdlib/jit-heat-gate.fk;
import form-stdlib/bml/bml-demand-jit.bml;
import form-stdlib/bml/gpu-lower.bml;
section [form.bml] {
    def aop-anf-run(name, args) {
        let prog = anf-program(name);
        nothing?(prog) ? nothing() : anf-eval(prog, anf-idx-of(name), args);
    }
    // a division program, native route and form route at one argument: list(native-route?, native value, walker value).
    // No reader here knows a width: form-lower's epilogue sign-extends (lo-sign), so -3 arrives as -3.
    def aop-div(prog, root, arg) {
        let r = jonb-request(jonb-registry(1), prog, root, arg);
        let w = jonb-request-form(jonb-registry(1), prog, root, arg);
        [(String) r[1] == "native", r[0], w[0]];
    }
    def aop-div-ok?(r) = r[0] && ((Comparable) r[1] == r[2]);
    // a division the page must NOT answer (the divisor is not a nonzero literal): the request is declined to the form
    // route, whose answer is the walker's -- list(declined?, value, walker value)
    def aop-div-declined-ok?(r) = (!r[0]) && ((Comparable) r[1] == r[2]);
    // the zero divisor: the walker STOPS, so the request, whatever route it takes, stops too; attempt turns each stop
    // into nothing()
    def aop-div-stops?(prog, root, arg) = nothing?(attempt(jonb-request(jonb-registry(1), prog, root, arg))) && nothing?(attempt(jonb-request-form(jonb-registry(1), prog, root, arg)));
    // programs for the decline family: ADD(ARG, node 99) holds a tag no lane covers; (ARG + 1) beside a write row it never reaches
    def aop-unknown() = [[2], [99], [3, 0, 1]];
    def aop-dead() = [[2], [1, 1], [3, 0, 1], [11]];
    def aop-dead-read() = [[2], [1, 1], [3, 0, 1], [10]];

    let p1 = alb-path("c1.txt");
    let p2 = alb-slot("c2.txt");
    let p3 = alb-slot("c3.txt");
    let p4 = alb-slot("c4.txt");
    let p5 = alb-slot("c5.txt");
    let p6 = alb-slot("c6.txt");
    let p9 = alb-slot("c9.txt");
    let q1 = alb-path("a1.txt");
    let q2 = alb-slot("a2.txt");
    let q3 = alb-slot("a3.txt");
    let q4 = alb-slot("a4.txt");
    let q5 = alb-slot("a5.txt");
    let q6 = alb-slot("a6.txt");
    let q9 = alb-slot("a9.txt");
    let ls12 = alb-layers(1, []);
    let z0 = [alb-reset(p1), alb-reset(p2), alb-reset(p3), alb-reset(p4), alb-reset(p5), alb-reset(p6), alb-reset(p9), alb-reset(q1), alb-reset(q2), alb-reset(q3), alb-reset(q4), alb-reset(q5), alb-reset(q6), alb-reset(q9)];

    // cold: the walker at N=50 (5 rounds for the pair)
    let c1 = s1-outer([p1, ls12], 0, 5);
    let c2 = s2-go(p2, 0, 50);
    let c3 = s3-go(p3, 0, 50);
    let c4 = s4-go(p4, 0, 50);
    let c5 = s5-go(p5, 0, 50);
    let c6 = s6-go(p6, 0, 50, 0);
    let c7 = s7-go(0, 50, 0);
    let c9 = s9-pick(0, 0, 0, p9, 0, 50, 0);
    let cb1 = alb-read(p1);
    let cb2 = alb-read(p2);
    let cb3 = alb-read(p3);
    let cb4 = alb-read(p4);
    let cb5 = alb-read(p5);
    let cb6 = alb-read(p6);
    let cb9 = alb-read(p9);
    let z1 = [alb-reset(p1), alb-reset(p2), alb-reset(p3), alb-reset(p4), alb-reset(p5), alb-reset(p6), alb-reset(p9)];

    // anf50: the contract at N=50
    let a1 = aop-anf-run("s1-outer", [[q1, ls12], 0, 5]);
    let a2 = aop-anf-run("s2-go", [q2, 0, 50]);
    let a3 = aop-anf-run("s3-go", [q3, 0, 50]);
    let a4 = aop-anf-run("s4-go", [q4, 0, 50]);
    let a5 = aop-anf-run("s5-go", [q5, 0, 50]);
    let a6 = aop-anf-run("s6-go", [q6, 0, 50, 0]);
    let a7 = aop-anf-run("s7-go", [0, 50, 0]);
    let a9 = aop-anf-run("s9-pick", [0, 0, 0, q9, 0, 50, 0]);
    let ab1 = alb-read(q1);
    let ab2 = alb-read(q2);
    let ab3 = alb-read(q3);
    let ab4 = alb-read(q4);
    let ab5 = alb-read(q5);
    let ab6 = alb-read(q6);
    let ab9 = alb-read(q9);
    let z2 = [alb-reset(q1), alb-reset(q2), alb-reset(q3), alb-reset(q4), alb-reset(q5), alb-reset(q6), alb-reset(q9)];

    // hot: the same defns, N=2500 -- the heat of 1024 is crossed inside these calls
    let h1 = s1-outer([p1, ls12], 0, 250);
    let h2 = s2-go(p2, 0, 2500);
    let h3 = s3-go(p3, 0, 2500);
    let h4 = s4-go(p4, 0, 2500);
    let h5 = s5-go(p5, 0, 2500);
    let h6 = s6-go(p6, 0, 2500, 0);
    let h7 = s7-go(0, 2500, 0);
    let h9 = s9-pick(0, 0, 0, p9, 0, 2500, 0);
    let hb1 = alb-read(p1);
    let hb2 = alb-read(p2);
    let hb3 = alb-read(p3);
    let hb4 = alb-read(p4);
    let hb5 = alb-read(p5);
    let hb6 = alb-read(p6);
    let hb9 = alb-read(p9);

    // anf: the contract at N=2500
    let g1 = aop-anf-run("s1-outer", [[q1, ls12], 0, 250]);
    let g2 = aop-anf-run("s2-go", [q2, 0, 2500]);
    let g3 = aop-anf-run("s3-go", [q3, 0, 2500]);
    let g4 = aop-anf-run("s4-go", [q4, 0, 2500]);
    let g5 = aop-anf-run("s5-go", [q5, 0, 2500]);
    let g6 = aop-anf-run("s6-go", [q6, 0, 2500, 0]);
    let g7 = aop-anf-run("s7-go", [0, 2500, 0]);
    let g9 = aop-anf-run("s9-pick", [0, 0, 0, q9, 0, 2500, 0]);
    let gb1 = alb-read(q1);
    let gb2 = alb-read(q2);
    let gb3 = alb-read(q3);
    let gb4 = alb-read(q4);
    let gb5 = alb-read(q5);
    let gb6 = alb-read(q6);
    let gb9 = alb-read(q9);
    let shown = print(["arg-order-lane-parity", "bytes hot walker / contract (want equal)", [[len(hb1), len(gb1)], [len(hb2), len(gb2)], [len(hb3), len(gb3)], [len(hb4), len(gb4)], [len(hb5), len(gb5)], [len(hb6), len(gb6)], [len(hb9), len(gb9)]], "cold = anf50", [(Comparable) cb1 == ab1, (Comparable) cb2 == ab2, (Comparable) cb3 == ab3, (Comparable) cb4 == ab4, (Comparable) cb5 == ab5, (Comparable) cb6 == ab6, (Comparable) cb9 == ab9], "values hot/anf", [[h6, g6], [h7, g7], [h9, g9]]]);
    let z3 = [alb-reset(p1), alb-reset(p2), alb-reset(p3), alb-reset(p4), alb-reset(p5), alb-reset(p6), alb-reset(p9), alb-reset(q1), alb-reset(q2), alb-reset(q3), alb-reset(q4), alb-reset(q5), alb-reset(q6), alb-reset(q9)];

    // the decline family
    let reg = jonb-registry(1);
    let gate = hg-gate(1);
    let hu = hg-request(gate, aop-unknown(), 2, 5);
    let hd = hg-request(gate, aop-dead(), 2, 5);
    let hr = hg-request(gate, aop-dead-read(), 2, 5);
    let ju = jonb-request(reg, aop-unknown(), 2, 5);
    let jd = jonb-request(reg, aop-dead(), 2, 5);
    let jr = jonb-request(reg, aop-dead-read(), 2, 5);
    let jf = jonb-request-form(reg, aop-dead(), 2, 5);
    let li-u = lo-compile-fn(aop-unknown(), 2);
    let li-d = lo-compile-fn(aop-dead(), 2);
    let li-r = lo-compile-fn(aop-dead-read(), 2);
    let li-n = lo-compile-fn-n(aop-dead(), 2, 1);
    let lf-u = lo-fcompile(aop-unknown(), 2);
    let bs = bdj-state(1, jonb-registry(1), nothing(), "idle");
    let bu = bdj-request(bs, "", "", aop-unknown(), 2, 5);
    let bd = bdj-request(bs, "", "", aop-dead(), 2, 5);
    let bg = bdj-request(bs, alb-file(alb-slot("bdj-src.txt")), alb-file(alb-slot("bdj-cache.txt")), [[2], [1, 2], [3, 0, 1]], 2, 5);
    let be = bdj-request(bs, alb-file(alb-slot("bdj-src.txt")), alb-file(alb-slot("bdj-cache.txt")), [[2], [1, 2], [14, 0, 1]], 2, 5);
    let gl1 = gl-lower("s5-un");
    let gl2 = gl-lower("d3-before");
    let gl3 = gl-lower("s2-go");
    let shown2 = print(["arg-order-lane-parity", "declines", [[hu[0], hu[1]], [hd[0], hd[1]], [hr[0], hr[1]], [ju[0], ju[1]], [jd[0], jd[1]], [jf[0], jf[1]], [nothing?(li-u), nothing?(li-d), nothing?(li-r), nothing?(li-n), nothing?(lf-u)], [bu[0], bd[0]], [gl1[0], gl2[0], gl3[0]], anf-why("s5-un"), anf-why("d3-before")]]);

    // native division against the walker
    let dA1 = aop-div([[2], [1, 2], [8, 0, 1]], 2, 0 - 7);
    let dA2 = aop-div([[2], [1, 2], [8, 0, 1]], 2, 0 - 8);
    let dA3 = aop-div([[2], [1, 2], [8, 0, 1]], 2, 7);
    let dB1 = aop-div([[2], [1, 3], [8, 1, 0]], 2, 0 - 3);
    let dB2 = aop-div([[2], [1, 3], [8, 1, 0]], 2, 0 - 2);
    let dB3 = aop-div([[2], [1, 3], [8, 1, 0]], 2, 2);
    let dC1 = aop-div([[2], [1, 1], [3, 0, 1], [1, 2], [3, 0, 3], [8, 2, 4]], 5, 0 - 7);
    let dC2 = aop-div([[2], [1, 1], [3, 0, 1], [1, 2], [3, 0, 3], [8, 2, 4]], 5, 20);
    let dZ1 = aop-div-stops?([[2], [1, 3], [8, 1, 0]], 2, 0);
    let dZ2 = aop-div-stops?([[2], [1, 0], [8, 0, 1]], 2, 5);
    let dZ3 = aop-div-stops?([[2], [1, 1], [3, 0, 1], [1, 2], [3, 0, 3], [8, 2, 4]], 5, 0 - 2);
    let shown3 = print(["arg-order-lane-parity", "division native/signed/walker", [dA1, dA2, dA3, dB1, dB2, dB3, dC1, dC2], "zero divisor stops", [dZ1, dZ2, dZ3]]);

    let verdict = alb-bit(((Comparable) cb1 == ab1) && (((Comparable) hb1 == gb1) && ((Comparable) c1 == a1) && ((Comparable) h1 == g1)), 1)
        + alb-bit(((Comparable) cb2 == ab2) && (((Comparable) hb2 == gb2) && ((Comparable) c2 == a2) && ((Comparable) h2 == g2)), 2)
        + alb-bit(((Comparable) cb3 == ab3) && (((Comparable) hb3 == gb3) && ((Comparable) c3 == a3) && ((Comparable) h3 == g3)), 4)
        + alb-bit(((Comparable) cb4 == ab4) && (((Comparable) hb4 == gb4) && ((Comparable) c4 == a4) && ((Comparable) h4 == g4)), 8)
        + alb-bit(((Comparable) cb5 == ab5) && (((Comparable) hb5 == gb5) && ((Comparable) c5 == a5) && ((Comparable) h5 == g5)), 16)
        + alb-bit(((Comparable) cb6 == ab6) && (((Comparable) hb6 == gb6) && ((Comparable) c6 == a6) && ((Comparable) h6 == g6)), 32)
        + alb-bit(((Comparable) c7 == a7) && ((Comparable) h7 == g7) && ((Comparable) g7 == 3126250), 64)
        + alb-bit(((Comparable) cb9 == ab9) && (((Comparable) hb9 == gb9) && ((Comparable) c9 == a9) && ((Comparable) h9 == g9)), 128)
        + alb-bit(nothing?(hu[0]) && (nothing?(hd[0]) && (nothing?(hr[0]) && (nothing?(ju[0]) && (nothing?(jd[0]) && (nothing?(jr[0]) && (nothing?(jf[0]) && ((String) hu[1] == "refused" && ((String) hd[1] == "refused" && ((String) ju[1] == "refused" && ((String) jd[1] == "refused")))))))))), 256)
        + alb-bit(nothing?(li-u) && (nothing?(li-d) && (nothing?(li-r) && (nothing?(li-n) && nothing?(lf-u)))), 512)
        + alb-bit(nothing?(bu[2]) && nothing?(bd[2]) && ((String) bu[3] == "refused") && ((String) bd[3] == "refused") && ((Comparable) bg[2] == 7) && ((String) bg[3] == "form") && ((Comparable) be[2] == 0), 1024)
        + alb-bit(((Comparable) gl1[0] == 0) && (((Comparable) gl2[0] == 0) && ((Comparable) gl3[0] == 0) && (len(anf-why("s5-un")) == 0) && (len(anf-why("d3-before")) > 0)), 2048)
        + alb-bit(aop-div-ok?(dA1) && aop-div-ok?(dA2) && aop-div-ok?(dA3) && aop-div-declined-ok?(dB1) && aop-div-declined-ok?(dB2) && aop-div-declined-ok?(dB3) && aop-div-declined-ok?(dC1) && aop-div-declined-ok?(dC2), 4096)
        + alb-bit(dZ1 && dZ2 && dZ3, 8192);
    let end = print(["arg-order-lane-parity-band", "verdict", verdict]);
    verdict;
}
