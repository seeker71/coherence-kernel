; kat-coder-pipeline-map-band.fk — the pipeline map accounts for every tensor
; in the file, and its per-stage counts are the file's own.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/equireach-gguf.fk form-stdlib/gguf-tensor-index.fk form-stdlib/kat-coder-pipeline-map.fk
;
; run: ./fkwu --src form/form-stdlib/tests/kat-coder-pipeline-map-band.fk   ; -> 255 with the file
;
; Verdict 255 when the file is readable; 3 without, and that is the report.
;
; THE POINT OF BIT 8. The inventory is only worth something if it is COMPLETE —
; a stage list that omits a tensor is a build that discovers it halfway through.
; So the band does not merely check a few counts: it requires
; 3 + 30x19 + 10x16 + 20 to equal the file's own tensor count exactly. Any
; tensor this map does not know about makes that sum wrong.

(do
    (defn kpb-score (ok bit) (if ok bit 0))

    (defn kat-coder-pipeline-map-band ()
        (do
    (let s (kpm-src))
    (let ok (kpm-present?))
    ; the ledger is internally honest: six gaps, five of them one kernel each
    (let c0 (kpb-score (if (eq (kpm-open-gaps) 5) (eq (kpm-open-one-kernel) 5) 0) 1))
    ; the MTP head is off the plain forward path
    (let c1 (kpb-score (if (eq (kpm-forward-blocks) 40)
                           (eq (kpm-mtp-index) 40) 0) 2))
    ; THE COMPLETENESS CLAIM: the map's own arithmetic equals the file's count
    (let c2 (kpb-score (if (eq ok 1) (eq (kpm-sum) (kpm-live-total s)) 0) 4))
    (let c3 (kpb-score (eq (kpm-sum) (kpm-total)) 8))
    ; the three tensors that define the block classes appear exactly as often as
    ; the map says blocks of each class exist
    (let c4 (kpb-score (if (eq ok 1)
                           (if (eq (kpm-live-count s ".ssm_conv1d.weight") (kpm-linear-blocks))
                               (eq (kpm-live-count s ".attn_q.weight")
                                   (add (kpm-full-blocks) (kpm-mtp-blocks))) 0) 0) 16))
    ; the MoE half is in EVERY block — linear, full and MTP alike, all 41
    (let c5 (kpb-score (if (eq ok 1)
                           (if (eq (kpm-live-count s ".ffn_gate_inp.weight") 41)
                               (if (eq (kpm-live-count s ".ffn_down_exps.weight") 41)
                                   (eq (kpm-live-count s ".ffn_down_shexp.weight") 41) 0) 0) 0) 32))
    ; the fused output gate: q is 8192 wide while attn_output takes 4096, in
    ; every full block. This is the stage that would otherwise be discovered
    ; mid-build.
    (let c6 (kpb-score (if (eq ok 1)
                           (if (eq (kpm-live-count s ".attn_q_norm.weight")
                                   (add (kpm-full-blocks) (kpm-mtp-blocks)))
                               (eq (kpm-live-count s ".attn_gate.weight") (kpm-linear-blocks)) 0) 0) 64))
    ; the dispatch prediction is recorded BEFORE the run, so the run can refute
    ; it: ~3300 dispatches at the measured 113 us of seam
    (let c7 (kpb-score (if (eq (kpm-disp-per-token) 3300)
                           (eq (kpm-predicted-seam-us) 372900) 0) 128))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
    )
    (kat-coder-pipeline-map-band))
