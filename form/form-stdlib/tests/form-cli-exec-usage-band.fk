; Codex CLI carrier accounting: 4095. No live state or provider calls.
; preludes: form-stdlib/bml/form-cli-exec-usage.bml
(do
 (defn feub-prefix () "{\"type\":\"thread.started\",\"thread_id\":\"test\"}\n{\"type\":\"turn.started\"}\n")
 (defn feub-done () "{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":100,\"cached_input_tokens\":60,\"output_tokens\":20,\"cache_write_input_tokens\":0,\"reasoning_output_tokens\":7}}\n")
 (defn feub-one () (str_concat (feub-prefix) (feub-done)))
 (defn feub-bit (condition bit) (if condition bit 0))
 (let one (feu-scan (feub-one)))
 (let two (feu-scan (str_concat (feub-one) (str_concat "{\"type\":\"turn.started\"}\n" (feub-done)))))
 (let nested (feu-scan (str_concat (feub-prefix) (str_concat "{\"type\":\"item.completed\",\"item\":{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":900,\"output_tokens\":999}}}\n" (feub-done)))))
 (let optional (feu-scan (str_concat (feub-prefix) "{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":3,\"cached_input_tokens\":0,\"output_tokens\":2}}\n")))
 (let split (feu-lines (feu-empty) (str_concat (feub-prefix) "{\"type\":\"turn.com") 0))
 (let resumed (feu-lines (head split) (str_concat (nth split 1) "pleted\",\"usage\":{\"input_tokens\":100,\"cached_input_tokens\":60,\"output_tokens\":20,\"cache_write_input_tokens\":0,\"reasoning_output_tokens\":7}}\n") 0))
 (let interrupted (feu-scan (str_concat (feub-one) "{\"type\":\"turn.started\"}\n")))
 (let interruptedReport (feu-report "fixture" 0 interrupted))
 (let prefixReport (json-object-get interruptedReport "completed_prefix_usage"))
 (if (not (and (str_eq (json-emit (json-object-get interruptedReport "input_tokens")) "null") (and (eq (json-int-value (json-object-get prefixReport "input_plus_output_tokens")) 120) (eq (json-int-value (json-object-get prefixReport "unobserved_remainder")) 1)))) (form_error "interrupted stream lost its completed prefix or claimed a full total") 0)
 (let failed (feu-scan (str_concat (feub-one) "{\"type\":\"turn.started\"}\n{\"type\":\"turn.failed\"}\n")))
 (let poisoned (feu-scan (str_concat (feub-one) (str_concat "{\"type\":\"turn.failed\"}\n{\"type\":\"turn.started\"}\n" (feub-done)))))
 (let malformed (feu-scan (str_concat (feub-one) (str_concat "{bad}\n{\"type\":\"turn.started\"}\n" (feub-done)))))
 (if (not (and (feu-prefix-observed failed) (and (eq (nth poisoned 5) 100) (and (eq (nth malformed 5) 100) (and (not (feu-complete poisoned)) (not (feu-complete malformed))))))) (form_error "usage after failure or malformed input contaminated the retained prefix") 0)
 (if (not (and (not (feu-prefix-observed (feu-scan (feub-prefix)))) (and (not (feu-prefix-observed (feu-unreadable one))) (str_eq (json-emit (feu-prefix-quantity (feu-unreadable one) 5)) "null")))) (form_error "absent or unreadable usage became observed") 0)
 (if (not (and (eq (json-int-value (json-object-get (feu-prefix-report one) "unobserved_remainder")) 0) (str_eq (json-emit (json-object-get (feu-prefix-report optional) "reasoning_output_tokens")) "null"))) (form_error "complete or optional prefix quantities changed meaning") 0)
 (sum (list
  (feub-bit (and (feu-complete one) (and (eq (nth one 5) 100) (and (eq (nth one 6) 60) (and (eq (nth one 7) 20) (eq (nth one 9) 7))))) 1)
  (feub-bit (and (feu-complete two) (and (eq (nth two 3) 2) (and (eq (nth two 5) 200) (eq (nth two 7) 40)))) 2)
  (feub-bit (node_eq nested one) 4)
  (feub-bit (not (feu-complete (feu-scan ""))) 8)
  (feub-bit (not (feu-complete (feu-scan (feub-prefix)))) 16)
  (feub-bit (not (feu-complete (feu-scan (str_concat (feub-one) (feub-done))))) 32)
  (feub-bit (not (feu-complete (feu-scan (str_concat (feub-one) "{\"type\":\"turn.failed\"}\n")))) 64)
  (feub-bit (and (feu-complete optional) (and (nothing? (nth optional 8)) (nothing? (nth optional 9)))) 128)
  (feub-bit (not (feu-complete (feu-scan (str_concat (feub-prefix) "{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":3,\"cached_input_tokens\":4,\"output_tokens\":2}}\n")))) 256)
  (feub-bit (not (feu-complete (feu-scan (str_concat (feub-prefix) "{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":\"3\",\"cached_input_tokens\":0,\"output_tokens\":2}}\n")))) 512)
  (feub-bit (and (node_eq (head resumed) one) (str_eq (nth resumed 1) "")) 1024)
  (feub-bit (and (not (feu-complete (feu-scan (str_concat (feub-one) "{")))) (not (feu-complete (feu-scan (str_concat (feub-prefix) "{\"type\":\"turn.completed\",}\n"))))) 2048))))
