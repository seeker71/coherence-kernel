; bml-bmf-stream-curriculum-band.fk -- held-out streaming curriculum witness.
;
; Expected: 16777215
; witnessed: 2026-08-24 -> direct fkwu
; preludes: form-stdlib/core.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml-bmf-stream-curriculum.fk form-stdlib/bml-bmf-stream-curriculum.bml

(do
    (defn bbscb-bit (ok bit) (if ok bit 0))
    (defn bbscb-invalid-grammar ()
        (grammar "stream" (list
            (rule3 "stream" (p-rep (p-ref "missing"))
                (t-emit "do" (list))))))
    (defn bbscb-empty-suffix-grammar ()
        (grammar "stream" (list
            (rule3 "stream"
                (p-cap "records" (p-rep (p-ref "record")))
                (t-emit "do" (list (t-splices "records"))))
            (rule3 "record"
                (list "seq" (p-lit "x=")
                    (p-cap "v" (p-run "digit")) (p-lit ""))
                (t-emit "fncall" (list (t-const "__x__") (t-splice "v")))))))
    (defn bbscb-source-text ()
        (if (ge (file_size "form/form-stdlib/bml-bmf-stream-curriculum.fk") 0)
            (read_file "form/form-stdlib/bml-bmf-stream-curriculum.fk")
            (read_file "form-stdlib/bml-bmf-stream-curriculum.fk")))
    (defn bbscb-file-present? (a b)
        (if (ge (file_size a) 0) 1
            (if (ge (file_size b) 0) 1 0)))
    (defn bbscb-source-paths-present? ()
        (and
            (bbscb-file-present?
                "form/form-stdlib/bml/bml-bmf-stream-curriculum.bml"
                "form-stdlib/bml/bml-bmf-stream-curriculum.bml")
            (bbscb-file-present?
                "form/form-stdlib/bml-bmf-stream-curriculum.bml"
                "form-stdlib/bml-bmf-stream-curriculum.bml")))
    (defn bbscb-run ()
        (do
            (let manifest (bbsc-manifest))
            (let program (bbsc-compile-grammar (bbsc-heldout-grammar) 8))
            (let whole (bbsc-whole-state))
            (let bytewise (bbsc-one-byte-state))
            (let partial (bbsc-feed-chunk (bbsc-open (bbsc-heldout-grammar) 8) "signal=12"))
            (let incomplete (bbsc-finish partial))
            (let overflow (bbsc-feed-chunk (bbsc-open (bbsc-heldout-grammar) 8)
                "signal=123456789;"))
            (let repeated (bbsc-repeated-state 64))
            (let empty-mixed (bbsc-finish
                (bbsc-feed-chunks (bbsc-open (bbsc-heldout-grammar) 8)
                    (list "" "signal=12;" "" "signal=345;" ""))))
            (let trailing (bbsc-feed-chunk
                (bbsc-feed-chunk (bbsc-open (bbsc-heldout-grammar) 8) (bbsc-source)) "x"))
            (let text (bbscb-source-text))
            (sum (list
                (bbscb-bit (eq (bbsc-manifest-has? "executable-bml" manifest) 1) 1)
                (bbscb-bit (eq (bbsc-manifest-has? "custom-bmf-grammar" manifest) 1) 2)
                (bbscb-bit (eq (bbsc-manifest-has? "no-tokenizer-prestep" manifest) 1) 4)
                (bbscb-bit (eq (bbsc-exact-leakage) 0) 8)
                (bbscb-bit (bbsc-program? program) 16)
                (bbscb-bit (eq (bbsc-bml-check) 15) 32)
                (bbscb-bit
                    (and (str_eq (bbsc-state-status whole) "complete")
                         (and (eq (bbsc-state-count whole) 2)
                              (str_eq (bbsc-event-value (bbsc-state-last-event whole)) "345")))
                    64)
                (bbscb-bit (eq (bbsc-feed-all-splits?) 1) 128)
                (bbscb-bit (bbsc-state-equivalent? whole bytewise) 256)
                (bbscb-bit (eq (bbsc-bmf-stream-equivalent?) 1) 512)
                (bbscb-bit (str_eq (bbsc-state-status partial) "continue") 1024)
                (bbscb-bit (str_eq (bbsc-state-status incomplete) "incomplete") 2048)
                (bbscb-bit (nil? (bbsc-compile-grammar (bbscb-invalid-grammar) 8)) 4096)
                (bbscb-bit (nil? (bbsc-compile-grammar (bbscb-empty-suffix-grammar) 8)) 8192)
                (bbscb-bit
                    (and (str_eq (bbsc-state-status overflow) "overflow")
                         (le (bbsc-retained-payload overflow) (bbsc-retained-bound program)))
                    16384)
                (bbscb-bit
                    (and (str_eq (bbsc-state-status repeated) "complete")
                         (and (eq (bbsc-state-count repeated) 64)
                              (le (bbsc-state-peak repeated) (bbsc-retained-bound program))))
                    32768)
                (bbscb-bit
                    (and (lt (str_find text "(tokenize" 0) 0)
                         (lt (str_find text "tokenize-grammar" 0) 0))
                    65536)
                (bbscb-bit
                    (and (eq (bbsc-manifest-has? "scannerless-byte-fold" manifest) 1)
                         (eq (bbsc-manifest-has? "finite-contract-not-infinity-claim" manifest) 1))
                    131072)
                (bbscb-bit
                    (str_eq (node_value
                        (g-parse-full (bbsc-heldout-grammar) "signal=12"))
                        "PARSE-FAIL")
                    262144)
                (bbscb-bit (bbsc-state-equivalent? whole empty-mixed) 524288)
                (bbscb-bit (str_eq (bbsc-state-status trailing) "malformed") 1048576)
                (bbscb-bit (eq (bbscb-source-paths-present?) 1) 2097152)
                (bbscb-bit
                    (and (eq (len (bbsc-training-rows)) 3)
                         (eq (len (bbsc-heldout-rows)) 3))
                    4194304)
                (bbscb-bit
                    (and (eq (bbsc-retained-bound program) 16)
                         (and (le (bbsc-state-peak whole) 16)
                              (le (bbsc-state-peak repeated) 16)))
                    8388608)))))
    (bbscb-run))
