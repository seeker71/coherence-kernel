; native-model-session-grounding-native-json-string-band.fk -- the minimal
; private JSON lens decodes only the requested string and preserves UTF-8.
; Missing and non-string fields remain an honest empty result.
; preludes: form-stdlib/native-model-session-grounding-native-json-string.fk

(do
    (defn nmsgnjb-score (condition bit) (if condition bit 0))
    (defn nmsgnjb-snowman ()
        (nmsgn-json-utf8 9731))
    (defn nmsgnjb-rocket ()
        (nmsgn-json-utf8 128640))
    (defn native-model-session-grounding-native-json-string-band ()
        (add
          (nmsgnjb-score
            (str_eq (nmsgn-json-string "{\"wanted\":\"plain\"}" "wanted")
                    "plain") 1)
          (add
            (nmsgnjb-score
              (str_eq
                (nmsgn-json-string
                  "{\"wanted\":\"quote \\\" slash \\\\\"}" "wanted")
                "quote \" slash \\") 2)
            (add
              (nmsgnjb-score
                (str_eq
                  (nmsgn-json-string
                    "{\"wanted\":\"line\\ncolumn\\tend\"}" "wanted")
                  (nmsgn-cat (list "line" (byte_to_str 10) "column"
                                   (byte_to_str 9) "end"))) 4)
              (add
                (nmsgnjb-score
                  (str_eq
                    (nmsgn-json-string "{\"wanted\":\"snow \\u2603\"}"
                                       "wanted")
                    (str_concat "snow " (nmsgnjb-snowman))) 8)
                (add
                  (nmsgnjb-score
                    (str_eq
                      (nmsgn-json-string
                        "{\"wanted\":\"flight \\ud83d\\ude80\"}" "wanted")
                      (str_concat "flight " (nmsgnjb-rocket))) 16)
                  (add
                    (nmsgnjb-score
                      (and
                        (str_eq (nmsgn-json-string "{\"other\":\"x\"}"
                                                  "wanted") "")
                        (and
                          (str_eq (nmsgn-json-string "{\"wanted\":null}"
                                                    "wanted") "")
                          (str_eq (nmsgn-json-string "{\"wanted\":7}"
                                                    "wanted") ""))) 32)
                    (add
                      (nmsgnjb-score
                        (str_eq
                          (nmsgn-json-string
                            "{\"wanted\":\"before \\\" after\",\"other\":\"private-fixture\"}"
                            "wanted")
                          "before \" after") 64)
                      (nmsgnjb-score
                        (and
                          (str_eq
                            (nmsgn-json-string
                              "{\"first\":\"private-fixture\",\"wanted\":\"only-this\"}"
                              "wanted") "only-this")
                          (lt (str_len
                            (nmsgn-json-string
                              "{\"first\":\"private-fixture\",\"wanted\":\"only-this\"}"
                              "wanted"))
                            (str_len
                              "{\"first\":\"private-fixture\",\"wanted\":\"only-this\"}")))
                        128)))))))))
    (native-model-session-grounding-native-json-string-band))
