; form-metal-in-process-live.fk
; Form owns the MSL, kernel identity, and model values. The linked carrier owns
; only the irreducible Metal API calls: compile, allocate, dispatch, and observe.
; No process, shell, Swift, filesystem, or temporary path participates.

(do
  (let msl
    "#include <metal_stdlib>\nusing namespace metal;\nkernel void form_matvec(device const float *w [[buffer(0)]], device const float *x [[buffer(1)]], device float *y [[buffer(2)]], device const uint *shape [[buffer(3)]], uint i [[thread_position_in_grid]]) { uint rows = shape[0]; uint cols = shape[1]; if (i >= rows) return; float acc = 0.0f; for (uint j = cols; j > 0; --j) { acc = w[i * cols + (j - 1)] * x[j - 1] + acc; } y[i] = acc; }\n")
  ; rows=2 cols=3, W=[[1,2,3],[4,5,6]], x=[7,8,9] => [50,122].
  (print_str (metal_matvec_f32 msl "form_matvec" "2 3 1 2 3 4 5 6 7 8 9")))
