; form-knowledge-public-generative-supervised-exemplar-band.fk
; The public post-failure lesson is executable for every current family.
; Expected: 15.
; preludes: form-stdlib/form-knowledge-public-generative-school.fk

(do
    (defn fkgseb-all-pass? (plans)
        (if (eq (len plans) 0) 1
            (do
                (let plan (head plans))
                (let exemplar (fkg15-supervised-exemplar plan))
                (let check (fkg15-check plan exemplar))
                (if (and (eq (fgsg-candidate?
                                  (fkg15-check-candidate check)) 1)
                         (and (eq (fkg15-check-pass? check) 1)
                              (eq (fkg15-check-valid? plan exemplar check) 1)))
                    (fkgseb-all-pass? (tail plans)) 0))))
    (let plans (fkg15-plans))
    (let first (head plans))
    (let exemplar (fkg15-supervised-exemplar first))
    (let repair (fkg15-repair-prompt first
        (fkg15-check first "independent-miss")))
    (sum (list
        (if (eq (fkgseb-all-pass? plans) 1) 1 0)
        (if (eq (fgsg-exact-leakage) 0) 2 0)
        (if (and (ge (str_find repair exemplar 0) 0)
                 (ge (str_find repair "Supervised" 0) 0)) 4 0)
        (if (eq (len plans) (len (fkpfm-family-ids))) 8 0))))
