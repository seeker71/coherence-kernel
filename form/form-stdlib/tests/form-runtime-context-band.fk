; Two cooperative owners keep source/run state and actual native leases apart.
; Expected 524287 on the ARM64 fkwu RAM leaf carrier.
; preludes: form-stdlib/bml/form-runtime-context.bml form-stdlib/form-asm.fk
(do
 (let entry (fk-sequence (fk-store (fk-lit 7) (fk-arg)) (fk-call 1 (fk-lit 0))))
 (let indirect (fk-icall (fk-cons (fk-lit 2) (fk-cons (fk-lit 0) (fk-empty))) (fk-empty)))
 (let leaf (fk-add (fk-load (fk-lit 7)) (fk-buf (fk-lit 0))))
 (let scoped (fk-node 109 (ms-intern (fk-lit 1) (ms-intern (fk-lit 36)
                  (fk-add (fk-node 110 (fk-lit 1)) (fk-buf (fk-lit 1)))))))
 (let fns (list entry indirect leaf (fk-buf (fk-arg)) scoped))
 (let a (fctx-open fns "A0"))
 (let b (fctx-open fns "Z9"))
 (let opened (and (fctx-open? a) (fctx-open? b)))
 (let memory-a (record_get a "memory"))
 (let memory-b (record_get b "memory"))
 (let run-a (fctx-run a 10))
 (let run-b (fctx-run b 20))
 (let retained-a (fctx-call a 2 0))
 (let bytes-a (list (fctx-call a 3 0) (fctx-call a 3 1) (fctx-call a 3 2) (fctx-call a 3 -1)))
 (let bytes-b (list (fctx-call b 3 0) (fctx-call b 3 1) (fctx-call b 3 2)))
 (let scoped-bytes (list (fctx-call a 4 0) (fctx-call b 4 0)))
 (let image (fa-image (list (fa-add-x-imm 0 0 1) (fa-ret))))
 (let native-a (fctx-native-admit a image 40))
 (let native-b (fctx-native-admit b image 50))
 (let probe-a (record_get native-a "probe"))
 (let probe-b (record_get native-b "probe"))
 (let request-a (record_get native-a "request"))
 (let identity-a (record_get native-a "identity"))
 (let same-code (node_eq (record_get native-a "program") (record_get native-b "program")))
 (let own-admissions (not (node_eq identity-a (record_get native-b "identity"))))
 (let cross-call (fctx-native-call b native-a 99))
 (let cross-release (fctx-native-release b native-a))
 ; This reaches the real carrier's malformed-release refusal. It does not
 ; substitute a simulated free result. Restore identity and retry the owner.
 (record_set native-a "identity" 7)
 (let refused (fctx-close a))
 (let pain-a (record_get a "health"))
 (let still-admitted (jit_leaf_inram request-a 40))
 (let held (and (str_eq (record_get a "state") "closing")
                (and (str_eq (record_get a "source") "A0")
                     (eq (record_get (record_get a "memory") "7") 10))))
 (let blocked (and (nothing? (fctx-run a 99))
                  (and (nothing? (fctx-native-call a native-a 99))
                       (nothing? (fctx-native-admit a image 99)))))
 (let meanwhile (list (fctx-call b 2 0) (fctx-native-call b native-b 60)))
 (record_set native-a "identity" identity-a)
 (let closed-a (fctx-close a))
 (let old-a (jit_leaf_inram request-a 0))
 (let after-b (list (fctx-call b 2 0) (fctx-native-call b native-b 70)))
 (let cleared-a (and (nothing? (record_get memory-a "7"))
                    (and (nothing? (record_get a "source"))
                         (and (nothing? (record_get a "memory"))
                              (nothing? (record_get a "functions"))))))
 (let request-b (record_get native-b "request"))
 (let closed-b (fctx-close b))
 (let old-b (jit_leaf_inram request-b 0))
 (let c (fctx-open fns "C"))
 (let invalid (and (nothing? (fctx-call c -1 0))
              (and (nothing? (fctx-call c 1.5 0))
                   (nothing? (fctx-native-admit c (list 0) 0)))))
 (let native-c (fctx-native-admit c image 80))
 (let new-call (fctx-native-call c native-c 90))
 (let closed-c (fctx-close c))
 (let failed-owner (fctx-open fns "F"))
 (let failed-admission (fctx-native-admit failed-owner image (list 1 2 3 4 5 6 7 8 9)))
 (let held-failed (eq (len (record_get failed-owner "admissions")) 1))
 (let closed-failed (fctx-close failed-owner))
 (let recursive (fk-if (fk-le (fk-arg) (fk-lit 0)) (fk-buf (fk-lit 0))
                      (fk-self (fk-sub (fk-arg) (fk-lit 1)))))
 (let recursive-owner (fctx-open (list recursive) "R"))
 (let recursive-source (fctx-run recursive-owner 21))
 (let closed-recursive (fctx-close recursive-owner))
 (sum (list
  (if opened 1 0)
  (if (and (eq run-a 75) (eq run-b 110)) 2 0)
  (if (and (eq retained-a 75) (not (eq memory-a memory-b))) 4 0)
  (if (and (value_eq bytes-a (list 65 48 0 0)) (value_eq bytes-b (list 90 57 0))) 8 0)
  (if (and (eq probe-a 41) (eq probe-b 51)) 16 0)
  (if (and same-code own-admissions) 32 0)
  (if (and (nothing? cross-call) (nothing? cross-release)) 64 0)
  (if (and (and (nothing? refused) (and held (eq still-admitted 41)))
    (and (and (oh-valid pain-a) (oh-pain pain-a))
     (str_eq (oh-select pain-a (oh-response pain-a "request-evidence") "retain") "request-evidence"))) 128 0)
  (if blocked 256 0)
  (if (value_eq meanwhile (list 110 61)) 512 0)
  (if (and (and (eq closed-a 1) (and (nothing? old-a) cleared-a))
     (and (not (oh-pain (record_get a "health")))
      (and (str_eq (oh-select pain-a (record_get a "health-response") "retain") "retry-release")
       (eq (json-int-value (oh-get (record_get a "health-applied") "result")) 1)))) 1024 0)
  (if (value_eq after-b (list 110 71)) 2048 0)
  (if (and (eq (fctx-close a) 0) (nothing? (fctx-call a 2 0))) 4096 0)
  (if (and (eq closed-b 1) (and (nothing? old-b) (nothing? (record_get memory-b "7")))) 8192 0)
  (if (and (eq new-call 91) (and (eq closed-c 1) (nothing? (jit_leaf_inram request-a 0)))) 16384 0)
  (if (and (nothing? (fctx-open (list) "x"))
           (and (nothing? (fctx-open fns 3))
                invalid)) 32768 0)
  (if (value_eq scoped-bytes (list 84 93)) 65536 0)
  (if (and (nothing? failed-admission) (and held-failed (eq closed-failed 1))) 131072 0)
  (if (and (eq recursive-source 82) (eq closed-recursive 1)) 262144 0))))
