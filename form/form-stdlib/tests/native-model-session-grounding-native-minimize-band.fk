; native-model-session-grounding-native-minimize-band.fk -- public in-memory
; event fixtures prove transient language reduces to a content-addressed safe
; observation containing only a salted digest, bounded path IDs, and counts.
; preludes: form-stdlib/native-model-session-grounding-native-minimize.fk

(do
    (defn nmsgnmb-score (condition bit) (if condition bit 0))
    (defn native-model-session-grounding-native-minimize-band ()
        (do
            (let candidates
                (list
                    (nmsgn-candidate "form/a.fk" "form/a.fk alpha source")
                    (nmsgn-candidate "form/b.fk" "form/b.fk beta source")
                    (nmsgn-candidate "form/c.fk" "form/c.fk gamma source")
                    (nmsgn-candidate "form/d.fk" "form/d.fk delta source")))
            (let query "fixture inquiry")
            (let completion "fixture completion cites form/c.fk")
            (let user-line
                "{\"timestamp\":\"2026-08-08T01:02:03Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"fixture inquiry\"}}")
            (let done-line
                "{\"timestamp\":\"2026-08-08T01:02:04Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"task_complete\",\"last_agent_message\":\"fixture completion cites form/c.fk\"}}")
            (let after-user
                (nmsgn-session-event user-line (nmsgn-empty-pairs)))
            (let after-done
                (nmsgn-session-event done-line after-user))
            (let finalized
                (nmsgn-pairs-finalize after-done
                    (nmsgn-labels
                        (nmsgn-pairs-latest-completion after-done) candidates)
                    "fixture-salt"))
            (let safe (nmsgn-safe-pairs finalized))
            (let admitted
                (nmsgn-admit (nmsgn-safe-pairs-labels safe) candidates 4))
            (sum (list
                (nmsgnmb-score
                    (str_eq (nmsgn-pairs-query after-user) query) 1)
                (nmsgnmb-score
                    (str_eq (nmsgn-pairs-query after-done) "") 2)
                (nmsgnmb-score
                    (eq (nmsgn-pairs-completed after-done) 1) 4)
                (nmsgnmb-score
                    (eq (nmsgn-pairs-labeled finalized) 1) 8)
                (nmsgnmb-score
                    (eq (str_len (nmsgn-pairs-latest-digest finalized)) 64)
                    16)
                (nmsgnmb-score
                    (str_eq (nmsgn-pairs-latest-digest finalized)
                        (nmsgn-sha256
                            (nmsgn-cat (list "fixture-salt" "\n" query)))) 32)
                (nmsgnmb-score
                    (str_eq (head (nmsgn-pairs-latest-labels finalized))
                            "form/c.fk") 64)
                (nmsgnmb-score (eq (len safe) 7) 128)
                (nmsgnmb-score
                    (eq (str_len (nmsgn-safe-pairs-address safe)) 64) 256)
                (nmsgnmb-score
                    (str_eq (nmsgn-safe-pairs-digest safe)
                            (nmsgn-pairs-latest-digest finalized)) 512)
                (nmsgnmb-score
                    (str_eq (head (nmsgn-safe-pairs-labels safe))
                            "form/c.fk") 1024)
                (nmsgnmb-score
                    (and (eq (len admitted) 4)
                         (str_eq (nmsgn-candidate-id (nth admitted 2))
                                 "form/c.fk")) 2048)
                (nmsgnmb-score
                    (and
                        (str_eq (nmsgn-pairs-latest-completion finalized) "")
                        (and
                        (not (str_eq (nth safe 0) query))
                        (and (not (str_eq (nth safe 1) query))
                             (and (not (str_eq (nth safe 2) query))
                                  (not (str_eq (nth safe 3) query)))))) 4096)))))
    (native-model-session-grounding-native-minimize-band))
