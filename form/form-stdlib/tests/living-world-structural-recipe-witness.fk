; living-world-structural-recipe-witness.fk -- opaque roles recur across one
; training example and two differentiated placements, then two replaceable
; codecs execute one structural carrier without inheriting role surfaces.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk

(let LWSRW-ROLE-FIXTURE        (bp "LWSRW-ROLE-FIXTURE"))
(let LWSRW-HISTORY             (bp "LWSRW-HISTORY"))
(let LWSRW-SCHEMA-FIXTURE      (bp "LWSRW-SCHEMA-FIXTURE"))
(let LWSRW-APPLICATION-FIXTURE (bp "LWSRW-APPLICATION-FIXTURE"))
(let LWSRW-COORDINATE-A        (bp "LWSRW-COORDINATE-A"))
(let LWSRW-COORDINATE-B        (bp "LWSRW-COORDINATE-B"))
(let LWSRW-APPLICATION-SCOPE   (bp "LWSRW-APPLICATION-SCOPE"))
(let LWSRW-APPLICATION-A       (bp "LWSRW-APPLICATION-A"))
(let LWSRW-APPLICATION-B       (bp "LWSRW-APPLICATION-B"))
(let LWSRW-EVIDENCE            (bp "LWSRW-EVIDENCE"))
(let LWSRW-ALTERNATIVE         (bp "LWSRW-ALTERNATIVE"))
(let LWSRW-REASON              (bp "LWSRW-REASON"))

(defn lwsrw-cell (kind) (intern_node kind (empty)))
(defn lwsrw-coordinate-a () (lwsrw-cell LWSRW-COORDINATE-A))
(defn lwsrw-coordinate-b () (lwsrw-cell LWSRW-COORDINATE-B))
(defn lwsrw-application-scope ()
    (lwsrw-cell LWSRW-APPLICATION-SCOPE))
(defn lwsrw-application-a () (lwsrw-cell LWSRW-APPLICATION-A))
(defn lwsrw-application-b () (lwsrw-cell LWSRW-APPLICATION-B))
(defn lwsrw-evidence () (lwsrw-cell LWSRW-EVIDENCE))
(defn lwsrw-alternative () (lwsrw-cell LWSRW-ALTERNATIVE))
(defn lwsrw-reason () (lwsrw-cell LWSRW-REASON))

(defn lwsrw-site-binding (site index)
    (nth (lwre-binding-items (lwsr-site-bindings site)) index))
(defn lwsrw-training-site () (lwhtw-example))
(defn lwsrw-first-site (tissue-fixture)
    (lwphw-probe-candidate
        (lwhtw-history-first
            (lwhtw-tissue-history tissue-fixture))))
(defn lwsrw-second-site (tissue-fixture)
    (lwphw-probe-candidate
        (lwhtw-history-second
            (lwhtw-tissue-history tissue-fixture))))
(defn lwsrw-enquiry () (lwhtw-enquiry))

(defn lwsrw-role-observation (coordinate site index ack)
    (lwsr-role-observation (lwsrw-enquiry) coordinate site
        (lwsrw-site-binding site index) ack
        (lwo-field (list (lwsrw-alternative)))
        (lwlc-unknown (lwsrw-evidence)) (lwsrw-evidence)))
(defn lwsrw-support (coordinate site index)
    (lwsrw-role-observation coordinate site index
        (oac-one (lwsrw-site-binding site index))))
(defn lwsrw-alternative-observation (coordinate site index)
    (lwsrw-role-observation coordinate site index
        (oac-alternative-ack coordinate
            (lwsrw-alternative) (lwsrw-evidence))))
(defn lwsrw-silence-observation (coordinate site index)
    (lwsrw-role-observation coordinate site index (oac-nothing)))
(defn lwsrw-dissent-observation (coordinate site index)
    (lwsrw-role-observation coordinate site index (oac-zero)))

(defn lwsrw-observation-world (tissue-fixture)
    (do
        (let base
            (lwt-round-world (lwhtw-tissue-round tissue-fixture)))
        (let training (lwsrw-training-site))
        (let first (lwsrw-first-site tissue-fixture))
        (let second (lwsrw-second-site tissue-fixture))
        (lwt-receive-stream base
            (list
                (lwphw-entry-a (lwsrw-coordinate-a))
                (lwphw-entry-b (lwsrw-coordinate-a))
                (lwphw-entry-a (lwsrw-coordinate-b))
                (lwphw-entry-b (lwsrw-coordinate-b))
                (lwphw-entry-c
                    (lwsrw-support (lwsrw-coordinate-a) training 0))
                (lwphw-entry-d
                    (lwsrw-support (lwsrw-coordinate-a) training 0))
                (lwphw-entry-c
                    (lwsrw-support (lwsrw-coordinate-a) first 0))
                (lwphw-entry-d
                    (lwsrw-support (lwsrw-coordinate-a) first 0))
                (lwphw-entry-c
                    (lwsrw-support (lwsrw-coordinate-a) second 0))
                (lwphw-entry-d
                    (lwsrw-support (lwsrw-coordinate-a) second 0))
                (lwphw-entry-c
                    (lwsrw-support (lwsrw-coordinate-b) training 1))
                (lwphw-entry-d
                    (lwsrw-support (lwsrw-coordinate-b) training 1))
                (lwphw-entry-c
                    (lwsrw-support (lwsrw-coordinate-b) first 1))
                (lwphw-entry-d
                    (lwsrw-support (lwsrw-coordinate-b) first 1))
                (lwphw-entry-c
                    (lwsrw-support (lwsrw-coordinate-b) second 1))
                (lwphw-entry-d
                    (lwsrw-support (lwsrw-coordinate-b) second 1))
                (lwphw-entry-e
                    (lwsrw-alternative-observation
                        (lwsrw-coordinate-a) second 0))
                (lwphw-entry-f
                    (lwsrw-silence-observation
                        (lwsrw-coordinate-b) second 1))))))

; children: integrated round, candidate, proposal, exact role
(defn lwsrw-role-fixture (round candidate proposal role)
    (intern_node LWSRW-ROLE-FIXTURE
        (list round candidate proposal role)))
(defn lwsrw-role-round (fixture) (nth (node_children fixture) 0))
(defn lwsrw-role-candidate (fixture) (nth (node_children fixture) 1))
(defn lwsrw-role-proposal (fixture) (nth (node_children fixture) 2))
(defn lwsrw-role-shape (fixture) (nth (node_children fixture) 3))
(defn lwsrw-integrate-role (world coordinate previous)
    (do
        (let role
            (lwsr-role-for world (lwsrw-enquiry) coordinate 2 3))
        (let proposal
            (lwsr-role-proposal world (lwsrw-enquiry) coordinate 2 3))
        (let candidate (lwt-proposal-candidate proposal))
        (let answered (lwphw-answered-round world proposal previous))
        (let integrated
            (lwsr-role-integrate answered proposal (lwphw-action)))
        (lwsrw-role-fixture integrated candidate proposal role)))

; children: tissue fixture, first role, second role
(defn lwsrw-history (tissue first second)
    (intern_node LWSRW-HISTORY (list tissue first second)))
(defn lwsrw-history-tissue (history) (nth (node_children history) 0))
(defn lwsrw-history-first (history) (nth (node_children history) 1))
(defn lwsrw-history-second (history) (nth (node_children history) 2))
(defn lwsrw-build-roles ()
    (do
        (let tissue (lwhtw-integrated-tissue))
        (let world (lwsrw-observation-world tissue))
        (let first
            (lwsrw-integrate-role world (lwsrw-coordinate-a)
                (lwhtw-tissue-round tissue)))
        (let second
            (lwsrw-integrate-role
                (lwt-round-world (lwsrw-role-round first))
                (lwsrw-coordinate-b) (lwsrw-role-round first)))
        (lwsrw-history tissue first second)))
(defn lwsrw-role-field (history)
    (lwo-field
        (list
            (lwsrw-role-candidate (lwsrw-history-first history))
            (lwsrw-role-candidate (lwsrw-history-second history)))))

; children: integrated round, candidate, proposal, exact schema, role history
(defn lwsrw-schema-fixture (round candidate proposal schema history)
    (intern_node LWSRW-SCHEMA-FIXTURE
        (list round candidate proposal schema history)))
(defn lwsrw-schema-round (fixture) (nth (node_children fixture) 0))
(defn lwsrw-schema-candidate (fixture) (nth (node_children fixture) 1))
(defn lwsrw-schema-proposal (fixture) (nth (node_children fixture) 2))
(defn lwsrw-schema-shape (fixture) (nth (node_children fixture) 3))
(defn lwsrw-schema-history (fixture) (nth (node_children fixture) 4))
(defn lwsrw-integrated-schema ()
    (do
        (let history (lwsrw-build-roles))
        (let tissue
            (lwhtw-tissue-candidate (lwsrw-history-tissue history)))
        (let roles (lwsrw-role-field history))
        (let world
            (lwt-round-world
                (lwsrw-role-round (lwsrw-history-second history))))
        (let schema (lwsr-schema-for world tissue roles))
        (let proposal (lwsr-schema-proposal world tissue roles))
        (let candidate (lwt-proposal-candidate proposal))
        (let answered
            (lwphw-answered-round world proposal
                (lwsrw-role-round (lwsrw-history-second history))))
        (let integrated
            (lwsr-schema-integrate answered proposal (lwphw-action)))
        (lwsrw-schema-fixture integrated candidate proposal schema history)))
(defn lwsrw-carrier (schema-fixture)
    (head
        (lwo-field-items
            (lwsr-schema-carriers
                (lwsrw-schema-shape schema-fixture)))))
(defn lwsrw-first-role (schema-fixture)
    (lwsrw-role-candidate
        (lwsrw-history-first
            (lwsrw-schema-history schema-fixture))))
(defn lwsrw-second-role (schema-fixture)
    (lwsrw-role-candidate
        (lwsrw-history-second
            (lwsrw-schema-history schema-fixture))))
(defn lwsrw-contradicted-carrier (schema-fixture)
    (do
        (let tissue-fixture
            (lwsrw-history-tissue
                (lwsrw-schema-history schema-fixture)))
        (let tissue (lwhtw-tissue-shape tissue-fixture))
        (let roles
            (lwsr-schema-roles
                (lwsrw-schema-shape schema-fixture)))
        (lwsr-carrier-for tissue roles
            (lwhtw-reverse-hypothesis tissue-fixture))))

(defn lwsrw-first-projection ()
    (lwre-projection
        (lwsrw-application-scope) (lwsrw-application-a)
        (intern_trivial_int 20)
        (lwo-field (list (lwsrw-alternative)))
        (lwlc-unknown (lwsrw-evidence)) (lwsrw-evidence)))
(defn lwsrw-second-projection ()
    (lwre-projection
        (lwsrw-application-scope) (lwsrw-application-b)
        (intern_trivial_int 6)
        (lwo-field (list (lwsrw-alternative)))
        (lwlc-unknown (lwsrw-evidence)) (lwsrw-evidence)))
(defn lwsrw-first-value (schema-fixture)
    (lwsr-value (lwsrw-first-role schema-fixture)
        (lwsrw-first-projection)
        (lwo-field (list (lwsrw-alternative)))
        (lwlc-unknown (lwsrw-evidence)) (lwsrw-evidence)))
(defn lwsrw-second-value (schema-fixture)
    (lwsr-value (lwsrw-second-role schema-fixture)
        (lwsrw-second-projection)
        (lwo-field (list (lwsrw-alternative)))
        (lwlc-unknown (lwsrw-evidence)) (lwsrw-evidence)))
(defn lwsrw-values (schema-fixture)
    (lwo-field
        (list (lwsrw-first-value schema-fixture)
              (lwsrw-second-value schema-fixture))))
(defn lwsrw-codec (role token)
    (lwsr-codec role token
        (lwo-field (list (lwsrw-alternative)))
        (lwlc-unknown (lwsrw-evidence)) (lwsrw-evidence)))
(defn lwsrw-codecs-a (schema-fixture)
    (lwo-field
        (list
            (lwsrw-codec (lwsrw-first-role schema-fixture) "u")
            (lwsrw-codec (lwsrw-second-role schema-fixture) "v"))))
(defn lwsrw-codecs-b (schema-fixture)
    (lwo-field
        (list
            (lwsrw-codec (lwsrw-first-role schema-fixture) "p")
            (lwsrw-codec (lwsrw-second-role schema-fixture) "q"))))
(defn lwsrw-before () (intern_trivial_int 0))
(defn lwsrw-choice ()
    (lwlc-choice (lwo-none)
        (lwo-field (list (lwsrw-alternative)))
        (lwlc-unknown (lwsrw-evidence)) (lwsrw-evidence)))
(defn lwsrw-timeout (schema-fixture)
    (oac-timeout (intern_trivial_int 10)
        (oac-alternative-ack
            (lwsrw-schema-candidate schema-fixture)
            (lwsrw-alternative) (lwsrw-evidence))
        (lwsrw-evidence)))
(defn lwsrw-application-a-cell (schema-fixture)
    (lwsr-application (lwsrw-schema-candidate schema-fixture)
        (lwsrw-carrier schema-fixture) (lwsrw-codecs-a schema-fixture)
        (lwsrw-values schema-fixture) (lwsrw-before)
        (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none)
        (lwsrw-evidence)))
(defn lwsrw-application-b-cell (schema-fixture)
    (lwsr-application (lwsrw-schema-candidate schema-fixture)
        (lwsrw-carrier schema-fixture) (lwsrw-codecs-b schema-fixture)
        (lwsrw-values schema-fixture) (lwsrw-before)
        (lwo-field (list (lwsrw-alternative)))
        (lwlc-unknown (lwsrw-evidence)) (lwsrw-choice)
        (lwsrw-timeout schema-fixture) (lwsrw-evidence)))
(defn lwsrw-contradicted-application (schema-fixture)
    (lwsr-application (lwsrw-schema-candidate schema-fixture)
        (lwsrw-contradicted-carrier schema-fixture)
        (lwsrw-codecs-a schema-fixture)
        (lwsrw-values schema-fixture) (lwsrw-before)
        (lwo-field (list (lwsrw-alternative)))
        (lwlc-unknown (lwsrw-evidence)) (lwo-none) (lwo-none)
        (lwsrw-evidence)))

(defn lwsrw-application-dependencies (world schema-fixture)
    (do
        (let role-a (lwsrw-first-role schema-fixture))
        (let role-b (lwsrw-second-role schema-fixture))
        (let codec-au (lwsrw-codec role-a "u"))
        (let codec-av (lwsrw-codec role-b "v"))
        (let codec-bp (lwsrw-codec role-a "p"))
        (let codec-bq (lwsrw-codec role-b "q"))
        (lwt-receive-stream world
            (list
                (lwphw-entry-i (lwsrw-application-scope))
                (lwphw-entry-j (lwsrw-application-scope))
                (lwphw-entry-i (lwsrw-application-a))
                (lwphw-entry-j (lwsrw-application-a))
                (lwphw-entry-i (lwsrw-application-b))
                (lwphw-entry-j (lwsrw-application-b))
                (lwphw-entry-i (lwsrw-first-projection))
                (lwphw-entry-j (lwsrw-first-projection))
                (lwphw-entry-i (lwsrw-second-projection))
                (lwphw-entry-j (lwsrw-second-projection))
                (lwphw-entry-k (lwsrw-first-value schema-fixture))
                (lwphw-entry-l (lwsrw-first-value schema-fixture))
                (lwphw-entry-k (lwsrw-second-value schema-fixture))
                (lwphw-entry-l (lwsrw-second-value schema-fixture))
                (lwphw-entry-g codec-au)
                (lwphw-entry-g codec-av)
                (lwphw-entry-h codec-bp)
                (lwphw-entry-h codec-bq)
                (lwphw-entry-i (lwsrw-before))
                (lwphw-entry-j (lwsrw-before))))))
(defn lwsrw-application-world (schema-fixture)
    (do
        (let world
            (lwsrw-application-dependencies
                (lwt-round-world (lwsrw-schema-round schema-fixture))
                schema-fixture))
        (lwt-receive-stream world
            (list
                (lwphw-entry-m
                    (lwsrw-application-a-cell schema-fixture))
                (lwphw-entry-n
                    (lwsrw-application-a-cell schema-fixture))
                (lwphw-entry-m
                    (lwsrw-application-b-cell schema-fixture))
                (lwphw-entry-n
                    (lwsrw-application-b-cell schema-fixture))
                (lwphw-entry-m
                    (lwsrw-contradicted-application schema-fixture))
                (lwphw-entry-n
                    (lwsrw-contradicted-application schema-fixture))))))

; children: schema fixture, world, three applications, two executions
(defn lwsrw-application-fixture
    (schema world first second contradicted first-execution second-execution)
    (intern_node LWSRW-APPLICATION-FIXTURE
        (list schema world first second contradicted first-execution
              second-execution)))
(defn lwsrw-application-schema (fixture) (nth (node_children fixture) 0))
(defn lwsrw-application-world-cell (fixture) (nth (node_children fixture) 1))
(defn lwsrw-application-first (fixture) (nth (node_children fixture) 2))
(defn lwsrw-application-second (fixture) (nth (node_children fixture) 3))
(defn lwsrw-application-contradicted (fixture)
    (nth (node_children fixture) 4))
(defn lwsrw-application-first-execution (fixture)
    (nth (node_children fixture) 5))
(defn lwsrw-application-second-execution (fixture)
    (nth (node_children fixture) 6))
(defn lwsrw-build-applications ()
    (do
        (let schema (lwsrw-integrated-schema))
        (let world (lwsrw-application-world schema))
        (let first (lwsrw-application-a-cell schema))
        (let second (lwsrw-application-b-cell schema))
        (let contradicted (lwsrw-contradicted-application schema))
        (lwsrw-application-fixture schema world first second contradicted
            (lwsr-execution-for world first 2 (lwo-none))
            (lwsr-execution-for world second 2
                (intern_trivial_int 5)))))

(defn lwsrw-revoked-codec-world (fixture)
    (do
        (let schema (lwsrw-application-schema fixture))
        (let codec
            (lwsrw-codec (lwsrw-first-role schema) "u"))
        (lwt-receive-stream
            (lwsrw-application-world-cell fixture)
            (list
                (lwphw-entry-g
                    (lwo-revocation codec (lwphw-source-g)
                        (lwsrw-reason) (lwphw-prov-g)))))))
(defn lwsrw-dissent-world (schema-fixture)
    (do
        (let tissue
            (lwsrw-history-tissue
                (lwsrw-schema-history schema-fixture)))
        (let site (lwsrw-second-site tissue))
        (lwt-receive-stream
            (lwt-round-world (lwsrw-schema-round schema-fixture))
            (list
                (lwphw-entry-e
                    (lwsrw-dissent-observation
                        (lwsrw-coordinate-a) site 0))))))
