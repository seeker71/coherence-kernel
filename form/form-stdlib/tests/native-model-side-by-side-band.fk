; native-model-side-by-side-band.fk — exhaustive registry projection and
; evidence-bound capability overlay.
;
; preludes: form-stdlib/core.fk form-stdlib/native-model-control-plane.fk form-stdlib/native-model-control-plane-eval.fk form-stdlib/form-teach-layer.fk form-stdlib/native-model-form-token-envelope.bml form-stdlib/form-agent-protocol.fk form-stdlib/native-model-form-action-protocol.bml form-stdlib/assemblage-point.fk form-stdlib/native-model-symbol-stream.bml form-stdlib/native-model-side-by-side.bml
;
; Verdict 1023: 511 executable + 512 high-BML authority.

(do
    (defn nmssb-has (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let registry (nmcp-registry))
    (let rows (nmss-project-all registry))
    (let qwen (nmss-find "challenger.qwen38-flash-next-q2-metal" rows))
    (let unknown (nmss-find "oracle.agent-remote" rows))
    (let c0 (if (and (eq (len registry) 62) (eq (len rows) 62)) 1 0))
    (let c1 (if (eq (nmss-population-complete? registry rows) 1) 2 0))
    (let c2 (if (and (eq (len qwen) 44) (str_eq (nmss-row-cap-token qwen) "proven-two-token-parity")) 4 0))
    (let c3 (if (and (str_eq (nmss-row-prefill-state qwen) "native-sequential-vocab-on-final; token-batch-pending") (str_eq (nmss-row-decode-state qwen) "failing-90pct-gate")) 8 0))
    (let c4 (if (and (eq (nmss-row-prefill-rate qwen) 12340) (eq (nmss-row-decode-rate qwen) 12188)) 16 0))
    (let c5 (if (and (eq (nmss-row-context qwen) 2048) (str_eq (nmss-row-substate qwen) "proven-lookup-evaluate")) 32 0))
    (let c6 (if (and (eq (nmss-qwen-performance-accepted? qwen) 0) (str_eq (nmss-row-cap-token unknown) "unmeasured")) 64 0))
    (let c7 (if (and (eq (nmss-row-form-prompt-admitted? qwen) 1) (and (str_eq (nmss-row-form-mode qwen) "compact-prefix") (eq (nmss-row-form-controls qwen) 8))) 128 0))
    (let c8 (if (and (eq (nmss-row-form-native-words qwen) 20) (and (str_eq (nmss-row-form-action-state qwen) "proposal-enabled-native-gated") (and (str_eq (nmss-row-form-query-lane qwen) "reasoning") (and (eq (nmss-row-form-selected-symbols qwen) 10) (and (eq (nmss-row-form-admitted-symbols qwen) 10) (str_eq (nmss-row-form-assemblage qwen) "exploratory-grounded")))))) 256 0))
    (let base (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8)))
    (let src (read_file "form/form-stdlib/bml/native-model-side-by-side.bml"))
    (let authority
        (if (eq (nmssb-has src "const String PopulationRule = \"exactly one projected row for every registry row\"") 1)
            (if (eq (nmssb-has src "const String UnknownRule = \"missing capability evidence is the literal unmeasured\"") 1)
                (if (eq (nmssb-has src "const String FormTokenRule = \"every registry row carries explicit local, prompt-admitted, native-admitted, delivery-mode, state, reason, native-word count, action-proposal state, query-lane symbol count, admitted symbol count, and assemblage fields\"") 1)
                    (if (eq (nmssb-has src "const int QwenDecodeFloorMilliTokps = 23922") 1)
                        (if (eq (nmssb-has src "const int QwenPrefillFloorMilliTokps = 286947") 1) 512 0) 0) 0) 0) 0))
    (add base authority))
