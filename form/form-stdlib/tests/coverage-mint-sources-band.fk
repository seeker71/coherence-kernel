; coverage-mint-sources-band.fk — the many-source provenance mint, model-free.
;
; Everything here is provable without a mind: extraction across sources, the
; sealed guard witnessed on a real minted question, the JSONL row shape with
; its escaping, the present-0 empty case, the counted skip for a path not on
; disk, and the write door with its byte receipt.
;
; PROOF LEVEL: FOURTH-ARM + GO — go answers 255 too (witnessed 2026-09-03; host-exec pf-arm-mask 9, rust/ts do not bind it). This band reaches host paths (host-exec
; mkdir, write_file into the training data home) that live on the fkwu arm.
; Verdict 255 (8 bits):
;   1    at least two real sources yield fact pairs
;   2    at least two sources contribute kept rows to the combined text
;   4    the combined text carries both training role markers
;   8    a double quote entering a question leaves as an escaped quote
;   16   a real minted question, sealed, is rejected; unsealed it lands
;   32   an empty source list yields a present empty text, never nothing
;   64   a source path not on disk keeps zero rows and is counted skipped
;   128  the write door: bytes returned equal bytes on disk, and rows landed
;
; preludes: learn/coverage-mint-sources.fk

(do
    (defn cmsb-bit (ok bit) (if ok bit 0))
    (defn cmsb-find-pair (ps val)
        (if (eq (len ps) 0) (nothing)
            (if (str_eq (nth (head ps) 1) val) (head ps)
                (cmsb-find-pair (tail ps) val))))
    (defn cmsb-sources-with-pairs (counts n)
        (if (eq (len counts) 0) n
            (cmsb-sources-with-pairs (tail counts)
                (if (ge (cms-count-pairs (head counts)) 1) (add n 1) n))))
    (defn cmsb-sources-with-kept (counts n)
        (if (eq (len counts) 0) n
            (cmsb-sources-with-kept (tail counts)
                (if (ge (cms-count-kept (head counts)) 1) (add n 1) n))))
    (defn coverage-mint-sources-band ()
        (do
            (let m (cms-mint-all (cms-sources)))
            (let text (nth m 0))
            (let counts (nth m 2))
            (let ps (cm-pairs "axioms/host-kernel.form"))
            (let p (cmsb-find-pair ps "CAN-not-MUST"))
            (let q (cm-mint-q "host-kernel.form" (nth p 0) (nth p 1) (nth p 2)))
            (let unsealed (cms-mint-all-with (list "axioms/host-kernel.form") (list)))
            (let sealedrun (cms-mint-all-with (list "axioms/host-kernel.form") (list q)))
            (let emptyrun (cms-mint-all-with (list) (list)))
            (let missing (cms-mint-all-with (list "axioms/no-such-source.form") (list)))
            (let mrow (nth (nth missing 2) 0))
            (let receipt (cms-emit))
            (sum (list
                (cmsb-bit (ge (cmsb-sources-with-pairs counts 0) 2) 1)
                (cmsb-bit (ge (cmsb-sources-with-kept counts 0) 2) 2)
                (cmsb-bit (and (ge (str_find text "\"role\":\"user\"" 0) 0)
                               (ge (str_find text "\"role\":\"assistant\"" 0) 0)) 4)
                (cmsb-bit (ge (str_find (cm-row "say \"hi\" back" "x-y")
                                        "\\\"" 0) 0) 8)
                (cmsb-bit (and (eq (cm-guard-ok? q (list q)) 0)
                          (and (ge (str_find (nth unsealed 0) q 0) 0)
                          (and (lt (str_find (nth sealedrun 0) q 0) 0)
                               (eq (add (nth sealedrun 1) 1)
                                   (nth unsealed 1))))) 16)
                (cmsb-bit (and (not (nothing? (nth emptyrun 0)))
                          (and (eq (str_len (nth emptyrun 0)) 0)
                          (and (eq (nth emptyrun 1) 0)
                               (eq (len (nth emptyrun 2)) 0)))) 32)
                (cmsb-bit (and (eq (nth missing 1) 0)
                          (and (eq (cms-count-pairs mrow) 0)
                          (and (eq (cms-count-kept mrow) 0)
                               (eq (cms-count-skipped mrow) 1)))) 64)
                (cmsb-bit (and (gt (nth receipt 0) 0)
                          (and (eq (nth receipt 0)
                                   (file_size (cms-out-path)))
                               (gt (nth receipt 1) 0))) 128)))))
    (coverage-mint-sources-band))
