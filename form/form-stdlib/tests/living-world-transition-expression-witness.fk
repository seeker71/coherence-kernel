; living-world-transition-expression-witness.fk -- opaque learned surfaces can
; voice exact current transition derivations, become stale, and be re-offered.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-transition-expression.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-transition-field-witness.fk

(let LWTXW-SOURCE-G (bp "LWTXW-SOURCE-G"))
(let LWTXW-SOURCE-H (bp "LWTXW-SOURCE-H"))
(let LWTXW-SOURCE-I (bp "LWTXW-SOURCE-I"))
(let LWTXW-SOURCE-J (bp "LWTXW-SOURCE-J"))
(let LWTXW-SOURCE-K (bp "LWTXW-SOURCE-K"))
(let LWTXW-SOURCE-L (bp "LWTXW-SOURCE-L"))
(let LWTXW-PROVENANCE (bp "LWTXW-PROVENANCE"))
(let LWTXW-RESPONSE-PROVENANCE (bp "LWTXW-RESPONSE-PROVENANCE"))
(let LWTXW-ACTION (bp "LWTXW-ACTION"))
(let LWTXW-REASON (bp "LWTXW-REASON"))
(let LWTXW-COORDINATE (bp "LWTXW-COORDINATE"))
(let LWTXW-LENS (bp "LWTXW-LENS"))
(let LWTXW-EVIDENCE (bp "LWTXW-EVIDENCE"))

(defn lwtxw-entry (source payload provenance)
    (lwt-entry
        (lwo-offer source (lwo-interface (list LWTXW-ACTION)) 1
            payload provenance 1)
        LWTXW-ACTION))

(defn lwtxw-response-entry (source proposal)
    (lwtxw-entry source
        (lwt-response proposal (oac-one proposal)
            LWTXW-RESPONSE-PROVENANCE)
        LWTXW-RESPONSE-PROVENANCE))

(defn lwtxw-observation (derivation surface)
    (lwsl-observation-at derivation LWTXW-COORDINATE surface
        LWTXW-LENS (oac-one derivation) LWTXW-EVIDENCE))

(defn lwtxw-revoke-entry (source target)
    (lwtxw-entry source
        (lwo-revocation target source LWTXW-REASON LWTXW-PROVENANCE)
        LWTXW-PROVENANCE))

(defn lwtxw-derivation-next (derivation)
    (lwtf-observation-next
        (lwtf-derivation-observation derivation)))

(defn lwtxw-find-derivation-items (items next)
    (if (eq (len items) 0) (lwo-none)
        (if (node_eq (lwtxw-derivation-next (head items)) next)
            (head items)
            (lwtxw-find-derivation-items (tail items) next))))

(defn lwtxw-find-derivation (prediction next)
    (lwtxw-find-derivation-items
        (lwo-field-items (lwtf-prediction-derivations prediction)) next))

(defn lwtxw-proposal-matches? (proposal referent surface)
    (do
        (let symbol (lwo-emergent-shape
                        (lwt-proposal-candidate proposal)))
        (if (and (node_eq (lwnv-symbol-referent symbol) referent)
                 (str_eq (lwnv-symbol-surface symbol) surface)) 1 0)))

(defn lwtxw-find-proposal-items (items referent surface)
    (if (eq (len items) 0) (lwo-none)
        (if (eq (lwtxw-proposal-matches?
                    (head items) referent surface) 1)
            (head items)
            (lwtxw-find-proposal-items (tail items) referent surface))))

(defn lwtxw-find-proposal (proposals referent surface)
    (lwtxw-find-proposal-items
        (lwo-field-items proposals) referent surface))

(defn lwtxw-surface-has-text-items (items surface)
    (if (eq (len items) 0) 0
        (if (str_eq (lwtx-surface-text (head items)) surface) 1
            (lwtxw-surface-has-text-items (tail items) surface))))

(defn lwtxw-surface-has-text? (plan surface)
    (lwtxw-surface-has-text-items
        (lwo-field-items (lwtx-plan-surfaces plan)) surface))

; Result retains worlds and exact derivations.  The declared verdict emits only
; the bit sum, never the offered fixture surfaces.
(defn lwtxw-run (started)
    (do
        (let transition-result (lwtfw-run started))
        (let transition-world (nth transition-result 10))
        (let prediction (nth transition-result 11))
        (let unseen-prediction (nth transition-result 12))
        (let derivation-c
            (lwtxw-find-derivation prediction LWTFW-CELL-C))
        (let derivation-d
            (lwtxw-find-derivation prediction LWTFW-CELL-D))
        (let observation-c (lwtxw-observation derivation-c "s0"))
        (let observation-d (lwtxw-observation derivation-d "s1"))

        (let teach-enter
            (lcfb-call-stream "living-world-transition-expression"
                "teach-surfaces" "enter" "form-native"
                "lwsl-observation-at" "exact-current-derivations" 13 started
                "form/form-stdlib/tests/living-world-transition-expression-witness.fk"
                97 13))
        (let observed-world
            (lwt-receive-stream transition-world
                (list
                    (lwtxw-entry LWTXW-SOURCE-G observation-c LWTXW-PROVENANCE)
                    (lwtxw-entry LWTXW-SOURCE-H observation-c LWTXW-PROVENANCE)
                    (lwtxw-entry LWTXW-SOURCE-I observation-d LWTXW-PROVENANCE)
                    (lwtxw-entry LWTXW-SOURCE-J observation-d LWTXW-PROVENANCE))))
        (let teach-leave
            (lcfb-call-stream "living-world-transition-expression"
                "teach-surfaces" "leave" "form-native"
                "lwsl-observation-at" "exact-current-derivations" 14 started
                "form/form-stdlib/tests/living-world-transition-expression-witness.fk"
                110 13))

        (let consent-enter
            (lcfb-call-stream "living-world-transition-expression"
                "consent-surfaces" "enter" "form-native"
                "lwsl-integrate" "plural-learned-surfaces" 15 started
                "form/form-stdlib/tests/living-world-transition-expression-witness.fk"
                117 13))
        (let proposals (lwsl-proposals observed-world 2))
        (let proposal-c (lwtxw-find-proposal proposals derivation-c "s0"))
        (let proposal-d (lwtxw-find-proposal proposals derivation-d "s1"))
        (let round
            (lwt-round observed-world proposals (lwo-empty-field) (lwo-none)))
        (let responded
            (lwt-round-receive round
                (list
                    (lwtxw-response-entry LWTXW-SOURCE-G proposal-c)
                    (lwtxw-response-entry LWTXW-SOURCE-H proposal-c)
                    (lwtxw-response-entry LWTXW-SOURCE-I proposal-d)
                    (lwtxw-response-entry LWTXW-SOURCE-J proposal-d))))
        (let integrated-c (lwsl-integrate responded proposal-c LWTXW-ACTION))
        (let integrated (lwsl-integrate integrated-c proposal-d LWTXW-ACTION))
        (let voice-world (lwt-round-world integrated))
        (let candidate-c (lwt-proposal-candidate proposal-c))
        (let candidate-d (lwt-proposal-candidate proposal-d))
        (let consent-leave
            (lcfb-call-stream "living-world-transition-expression"
                "consent-surfaces" "leave" "form-native"
                "lwsl-integrate" "plural-learned-surfaces" 16 started
                "form/form-stdlib/tests/living-world-transition-expression-witness.fk"
                140 13))

        (let project-enter
            (lcfb-call-stream "living-world-transition-expression"
                "project-voice" "enter" "form-native"
                "lwtx-plan-for" "plural-and-unseen-predictions" 17 started
                "form/form-stdlib/tests/living-world-transition-expression-witness.fk"
                147 13))
        (let symbols (lwo-field (list candidate-c candidate-d)))
        (let initial-plan (lwtx-plan-for voice-world prediction symbols))
        (let unseen-plan
            (lwtx-plan-for voice-world unseen-prediction symbols))
        (let project-leave
            (lcfb-call-stream "living-world-transition-expression"
                "project-voice" "leave" "form-native"
                "lwtx-plan-for" "plural-and-unseen-predictions" 18 started
                "form/form-stdlib/tests/living-world-transition-expression-witness.fk"
                157 13))

        (let revise-enter
            (lcfb-call-stream "living-world-transition-expression"
                "revoke-revoice" "enter" "form-native"
                "lwsl-integrate" "source-local-surface-replacement" 19 started
                "form/form-stdlib/tests/living-world-transition-expression-witness.fk"
                164 13))
        (let c-revoked-world
            (lwt-receive-stream voice-world
                (list (lwtxw-revoke-entry LWTXW-SOURCE-G observation-c))))
        (let after-c
            (lwtx-plan-for c-revoked-world prediction symbols))
        (let replacement-observation
            (lwtxw-observation derivation-c "s2"))
        (let repair-observed
            (lwt-receive-stream c-revoked-world
                (list
                    (lwtxw-entry LWTXW-SOURCE-K replacement-observation
                        LWTXW-PROVENANCE)
                    (lwtxw-entry LWTXW-SOURCE-L replacement-observation
                        LWTXW-PROVENANCE))))
        (let repair-proposals (lwsl-proposals repair-observed 2))
        (let replacement-proposal
            (lwtxw-find-proposal repair-proposals derivation-c "s2"))
        (let repair-round
            (lwt-round repair-observed repair-proposals
                (lwo-empty-field) (lwo-none)))
        (let repair-responded
            (lwt-round-receive repair-round
                (list
                    (lwtxw-response-entry LWTXW-SOURCE-H replacement-proposal)
                    (lwtxw-response-entry LWTXW-SOURCE-K replacement-proposal)
                    (lwtxw-response-entry LWTXW-SOURCE-L replacement-proposal))))
        (let repaired-round
            (lwsl-integrate repair-responded replacement-proposal LWTXW-ACTION))
        (let repaired-world (lwt-round-world repaired-round))
        (let replacement-candidate
            (lwt-proposal-candidate replacement-proposal))
        (let repaired-symbols
            (lwo-field (list candidate-c candidate-d replacement-candidate)))
        (let repaired-plan
            (lwtx-plan-for repaired-world prediction repaired-symbols))
        (let d-revoked-world
            (lwt-receive-stream repaired-world
                (list (lwtxw-revoke-entry LWTXW-SOURCE-I observation-d))))
        (let after-d
            (lwtx-plan-for d-revoked-world prediction repaired-symbols))
        (let revise-leave
            (lcfb-call-stream "living-world-transition-expression"
                "revoke-revoice" "leave" "form-native"
                "lwsl-integrate" "source-local-surface-replacement" 20 started
                "form/form-stdlib/tests/living-world-transition-expression-witness.fk"
                210 13))

        (list derivation-c derivation-d prediction unseen-prediction
              observed-world proposal-c proposal-d voice-world candidate-c
              candidate-d initial-plan unseen-plan c-revoked-world after-c
              replacement-proposal repaired-world replacement-candidate
              repaired-plan d-revoked-world after-d)))

(defn lwtxw-verdict (r)
    (do
        (let derivation-c (nth r 0))
        (let derivation-d (nth r 1))
        (let prediction (nth r 2))
        (let voice-world (nth r 7))
        (let candidate-c (nth r 8))
        (let candidate-d (nth r 9))
        (let initial (nth r 10))
        (let unseen (nth r 11))
        (let c-revoked-world (nth r 12))
        (let after-c (nth r 13))
        (let repaired-world (nth r 15))
        (let replacement (nth r 16))
        (let repaired (nth r 17))
        (let d-revoked-world (nth r 18))
        (let after-d (nth r 19))
        (sum (list
            (if (eq (lwtf-prediction-current? voice-world prediction) 1) 1 0)
            (if (eq (lwo-field-size
                        (lwtf-prediction-derivations prediction)) 2) 2 0)
            (if (and (eq (lwsl-integrated-current?
                            voice-world candidate-c) 1)
                     (eq (lwsl-integrated-current?
                            voice-world candidate-d) 1)) 4 0)
            (if (eq (lwtx-plan-current? voice-world initial) 1) 8 0)
            (if (eq (lwo-field-size (lwtx-plan-surfaces initial)) 2) 16 0)
            (if (eq (lwo-field-size (lwtx-plan-unvoiced initial)) 0) 32 0)
            (if (eq (oac-node? (lwtx-plan-ack initial)) 1) 64 0)
            (if (and (eq (lwtxw-surface-has-text? initial "s0") 1)
                     (eq (lwtxw-surface-has-text? initial "s1") 1)) 128 0)
            (if (node_eq (lwtx-plan-alternatives initial)
                    (lwtf-prediction-alternatives prediction)) 256 0)
            (if (node_eq (lwtx-plan-unknown initial)
                    (lwtf-prediction-unknown prediction)) 512 0)
            (if (eq (oac-nothing? (lwtx-plan-ack unseen)) 1) 1024 0)
            (if (and (eq (lwo-field-size
                            (lwtx-plan-surfaces unseen)) 0)
                     (eq (lwo-field-size
                            (lwtx-plan-unvoiced unseen)) 0)) 2048 0)
            (if (and (eq (lwsl-integrated-current?
                            c-revoked-world candidate-c) 0)
                     (eq (lwsl-integrated-current?
                            c-revoked-world candidate-d) 1)) 4096 0)
            (if (and (eq (lwo-field-size
                            (lwtx-plan-surfaces after-c)) 1)
                     (eq (lwo-field-size
                            (lwtx-plan-unvoiced after-c)) 1)) 8192 0)
            (if (and (eq (oac-one? (lwtx-plan-ack after-c)) 1)
                     (node_eq
                        (lwtx-surface-derivation
                            (oac-payload (lwtx-plan-ack after-c)))
                        derivation-d)) 16384 0)
            (if (and (eq (lwsl-integrated-current?
                            repaired-world replacement) 1)
                     (eq (lwsl-integrated-current?
                            repaired-world candidate-c) 0)) 32768 0)
            (if (and (eq (lwtx-plan-current? repaired-world repaired) 1)
                     (and (eq (lwo-field-size
                                (lwtx-plan-surfaces repaired)) 2)
                          (and (eq (lwo-field-size
                                    (lwtx-plan-unvoiced repaired)) 0)
                               (eq (oac-node?
                                    (lwtx-plan-ack repaired)) 1)))) 65536 0)
            (if (and (eq (lwsl-integrated-current?
                            d-revoked-world candidate-d) 0)
                     (and (eq (lwsl-integrated-current?
                                d-revoked-world replacement) 1)
                          (and (eq (lwo-field-size
                                    (lwtx-plan-surfaces after-d)) 1)
                               (and (eq (lwo-field-size
                                        (lwtx-plan-unvoiced after-d)) 1)
                                    (and (eq (oac-one?
                                            (lwtx-plan-ack after-d)) 1)
                                         (node_eq
                                            (lwtx-surface-derivation
                                                (oac-payload
                                                    (lwtx-plan-ack after-d)))
                                            derivation-c)))))) 131072 0)))))
