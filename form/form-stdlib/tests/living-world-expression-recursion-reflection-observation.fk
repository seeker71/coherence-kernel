; living-world-expression-recursion-reflection-observation.fk -- bounded first
; checkpoint: two application outcomes cross the reflection membrane.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk form-stdlib/living-world-expression-composition.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-expression-recursion.fk form-stdlib/tests/living-world-expression-composition-witness.fk

(let LWXRO-SOURCE-M (bp "LWXRO-SOURCE-M"))
(let LWXRO-SOURCE-N (bp "LWXRO-SOURCE-N"))
(let LWXRO-SOURCE-O (bp "LWXRO-SOURCE-O"))
(let LWXRO-PROV-M   (bp "LWXRO-PROV-M"))
(let LWXRO-PROV-N   (bp "LWXRO-PROV-N"))
(let LWXRO-PROV-O   (bp "LWXRO-PROV-O"))

(defn lwxro-source-m () (lwxbw-cell LWXRO-SOURCE-M))
(defn lwxro-source-n () (lwxbw-cell LWXRO-SOURCE-N))
(defn lwxro-source-o () (lwxbw-cell LWXRO-SOURCE-O))
(defn lwxro-prov-m () (lwxbw-cell LWXRO-PROV-M))
(defn lwxro-prov-n () (lwxbw-cell LWXRO-PROV-N))
(defn lwxro-prov-o () (lwxbw-cell LWXRO-PROV-O))

(defn lwxro-material-two ()
    (lwxb-material
        (list (lwxbw-primary) (lwxbw-right) (lwxbw-left))))
(defn lwxro-material-world-build ()
    (lwt-receive-stream (lwxcbw-application-world)
        (list (lwxbw-entry (lwxro-source-m) (lwxro-prov-m)
            (lwxro-material-two)))))
(let LWXRO-MATERIAL-WORLD-VALUE (lwxro-material-world-build))
(defn lwxro-material-world () LWXRO-MATERIAL-WORLD-VALUE)

(let LWXRO-APPLICATION-PROPOSAL-VALUE
    (lwxc-application-proposal (lwxro-material-world)
        (lwxcbw-chain-candidate-c) (lwxro-material-two)))
(defn lwxro-application-proposal () LWXRO-APPLICATION-PROPOSAL-VALUE)
(defn lwxro-application-candidate ()
    (lwt-proposal-candidate (lwxro-application-proposal)))
(defn lwxro-application-round-build ()
    (lwt-round (lwxro-material-world)
        (lwo-field (list (lwxro-application-proposal)))
        (lwo-empty-field) (lwxcbw-application-integrated-round)))
(defn lwxro-application-yes-round-build ()
    (do
        (let proposal (lwxro-application-proposal))
        (lwt-round-receive (lwxro-application-round-build)
            (lwxbw-responses proposal
                (oac-one (lwt-proposal-candidate proposal))))))
(defn lwxro-application-integrated-round-build ()
    (lwxc-integrate-application (lwxro-application-yes-round-build)
        (lwxro-application-proposal) (lwxbw-action)))
(let LWXRO-APPLICATION-ROUND-VALUE
    (lwxro-application-integrated-round-build))
(defn lwxro-application-integrated-round ()
    LWXRO-APPLICATION-ROUND-VALUE)
(defn lwxro-application-world ()
    (lwt-round-world (lwxro-application-integrated-round)))

(defn lwxro-output (candidate)
    (lwxc-derivation-output
        (lwxc-application-derivation (lwo-emergent-shape candidate))))
(defn lwxro-confirmation-one ()
    (do
        (let output (lwxro-output (lwxcbw-application-candidate-c)))
        (lwxr-reflection (lwxcbw-application-candidate-c)
            output (oac-one output) (lwo-none) (lwo-empty-field)
            (lwo-none) (lwo-none) (lwo-none) (lwxbw-evidence))))
(defn lwxro-confirmation-two ()
    (do
        (let output (lwxro-output (lwxro-application-candidate)))
        (lwxr-reflection (lwxro-application-candidate)
            output (oac-one output) (lwo-none) (lwo-empty-field)
            (lwo-none) (lwo-none) (lwo-none) (lwxbw-evidence))))
(defn lwxro-offer-world-build ()
    (lwt-receive-stream (lwxro-application-world)
        (list
            (lwxbw-entry (lwxro-source-n) (lwxro-prov-n)
                (lwxro-confirmation-one))
            (lwxbw-entry (lwxro-source-o) (lwxro-prov-o)
                (lwxro-confirmation-two)))))
(let LWXRO-OFFER-WORLD-VALUE (lwxro-offer-world-build))
(defn lwxro-offer-world () LWXRO-OFFER-WORLD-VALUE)

(let LWXRO-PROPOSAL-ONE-VALUE
    (lwxr-reflection-proposal
        (lwxro-offer-world) (lwxro-confirmation-one)))
(let LWXRO-PROPOSAL-TWO-VALUE
    (lwxr-reflection-proposal
        (lwxro-offer-world) (lwxro-confirmation-two)))
(defn lwxro-proposal-one () LWXRO-PROPOSAL-ONE-VALUE)
(defn lwxro-proposal-two () LWXRO-PROPOSAL-TWO-VALUE)
(defn lwxro-candidate-one ()
    (lwt-proposal-candidate (lwxro-proposal-one)))
(defn lwxro-candidate-two ()
    (lwt-proposal-candidate (lwxro-proposal-two)))
(defn lwxro-round-build ()
    (lwt-round (lwxro-offer-world)
        (lwo-field (list (lwxro-proposal-one) (lwxro-proposal-two)))
        (lwo-empty-field) (lwxro-application-integrated-round)))
(defn lwxro-yes-round-build ()
    (do
        (let first (lwxro-proposal-one))
        (let second (lwxro-proposal-two))
        (lwt-round-receive (lwxro-round-build)
            (append
                (lwxbw-responses first
                    (oac-one (lwt-proposal-candidate first)))
                (lwxbw-responses second
                    (oac-one (lwt-proposal-candidate second)))))))
(defn lwxro-integrated-round-build ()
    (do
        (let round (lwxro-yes-round-build))
        (let first
            (lwxr-integrate-reflection round
                (lwxro-proposal-one) (lwxbw-action)))
        (lwxr-integrate-reflection first
            (lwxro-proposal-two) (lwxbw-action))))
(let LWXRO-INTEGRATED-ROUND-VALUE (lwxro-integrated-round-build))
(defn lwxro-integrated-round () LWXRO-INTEGRATED-ROUND-VALUE)
(defn lwxro-world () (lwt-round-world (lwxro-integrated-round)))

(do
    ; Each integration already checked exact proposal currentness, unanimous
    ; acknowledgement, and witness readiness.  Observe those two settled acts
    ; from their retained outcomes and active identities without reopening the
    ; later focus and correspondence membranes in this causal checkpoint.
    (let final (lwxro-integrated-round))
    (let first (lwt-round-prior final))
    (let outcome-one (lwt-outcome-for first (lwxro-proposal-one)))
    (let outcome-two (lwt-outcome-for final (lwxro-proposal-two)))
    (list
        (lwo-field-size (lwt-proposal-participants (lwxro-proposal-one)))
        (lwo-field-size (lwt-proposal-participants (lwxro-proposal-two)))
        (lwt-outcome-yes outcome-one)
        (lwt-outcome-yes outcome-two)
        (if (node_eq (lwt-outcome-status outcome-one)
                (lwt-status-acknowledged)) 1 0)
        (if (node_eq (lwt-outcome-status outcome-two)
                (lwt-status-acknowledged)) 1 0)
        (lwo-active? (lwxro-world) (lwxro-candidate-one))
        (lwo-active? (lwxro-world) (lwxro-candidate-two))
        (if (node_eq (lwxro-candidate-one)
                (lwxro-candidate-two)) 0 1)))
