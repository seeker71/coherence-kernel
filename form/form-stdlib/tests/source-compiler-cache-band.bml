; source-compiler-cache-band.bml — the floor compiler's disk rows (the per-file discovery row and the compiler pin) survive a binary write and read (form-stdlib/source-compiler.fk fsc-bml-cache-pack / -unpack).
;
; A node read back from a binary row carries its category as the wire marker's own STRING, not as the marker node: node_eq against the marker answered false, fsc-bml-cache-unpack answered nothing for every row,
; the publish's read-back check failed and removed the row, and from then on no discovery row and no pin was kept: every process parsed all of a closure's sources with the grammar again (measured 2026-11-14:
; 14 to 19 s a run on the planner's closure of 355 files, 1.4 s with the rows standing). This band reads the round trip itself, so that cannot go quiet again.
;
; Verdict 31 when every claim lands:
;   1   a string row survives a binary write and read
;   2   a list row of strings, ints and a nested list survives, equal to what was written
;   4   the markers' category reads back as a string, and the unpacker accepts it (fsc-bml-cache-category?)
;   8   a category that is the marker NODE (a row packed in this process, not yet written) is accepted too
;   16  a row shape the unpacker does not know reads as nothing, not as a wrong value
//
// REQUIRES: the built ./fkwu and the body root as the working directory.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/source-compiler.fk
section [form.bml] {
 class SourceCompilerCacheBand {
  def scb-path() = "/tmp/source-compiler-cache-band.fkb";
  def scb-roundtrip(v) {
   let written = write_form_binary(scb-path(), fsc-bml-cache-pack(v));
   let back = fsc-bml-cache-unpack(read_form_binary(scb-path()));
   let gone = host_path_remove(scb-path());
   back;
  }
  def scb-1() = scb-roundtrip("hello") == "hello";
  def scb-2() { let row = ["fsc-discovery-fnv64-v2", "form/x.bml", 7, ["a", "b", ["c", 3]]]; scb-roundtrip(row) == row; }
  def scb-4() {
   let node = fsc-bml-cache-pack("x");
   let written = write_form_binary(scb-path(), node);
   let back = read_form_binary(scb-path());
   let gone = host_path_remove(scb-path());
   (String) value_kind(node_category(back)) == "string" && fsc-bml-cache-category?(back, FSC-BML-DISK-STRING) && !fsc-bml-cache-category?(back, FSC-BML-DISK-INT);
  }
  def scb-8() = fsc-bml-cache-category?(fsc-bml-cache-pack("x"), FSC-BML-DISK-STRING) && fsc-bml-cache-category?(fsc-bml-cache-pack(5), FSC-BML-DISK-INT) && !fsc-bml-cache-category?(fsc-bml-cache-pack(5), FSC-BML-DISK-STRING);
  def scb-16() = nothing?(fsc-bml-cache-unpack(intern_node(intern_trivial_string("some-other-marker"), [intern_trivial_string("v")])));
  def scb-32() = BML-SOURCE-ROOT != "" && fsc-bml-cache-rel(BML-SOURCE-ROOT ++ "/observe/x.fk") == "observe/x.fk" && fsc-bml-cache-rel(BML-SOURCE-ROOT ++ "/form/form-stdlib/y.bml") == "form/form-stdlib/y.bml" && fsc-bml-cache-rel("/elsewhere/z.bml") == "/elsewhere/z.bml";
 }
 print_str("[source-compiler-cache] 1 " ++ scb-1().str() ++ " 2 " ++ scb-2().str() ++ " 4 " ++ scb-4().str() ++ " 8 " ++ scb-8().str() ++ " 16 " ++ scb-16().str() ++ " 32 " ++ scb-32().str());
 (scb-1() ? 1 : 0) + (scb-2() ? 2 : 0) + (scb-4() ? 4 : 0) + (scb-8() ? 8 : 0) + (scb-16() ? 16 : 0) + (scb-32() ? 32 : 0);
}
