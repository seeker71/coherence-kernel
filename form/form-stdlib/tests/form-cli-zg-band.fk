; form-cli-zg-band.fk — the zg tool executes inside form-cli.
;
; Verdict 255 when the actual fc-respond dispatch searches resident tool rows,
; exposes every route, reports zero crossings, and stays a kernel:call tool.
;
; PROOF LEVEL: FOURTH-ARM ONLY — the zg BM25 lane uses native math_log.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli.fk

(do
    (defn fczgb-bit (ok bit) (if ok bit 0))
    (defn form-cli-zg-band ()
        (do
            (let hybrid (fc-respond "zg hybrid kernel call"))
            (let exact (fc-respond "zg rg cap.host.file"))
            (let fts (fc-respond "zg fts parallel compute"))
            (let vector (fc-respond "zg vector kernel call"))
            (let miss (fc-respond "zg rg no-such-resident-tool-phrase"))
            (let help (fc-respond "help"))
            (let plan (tc-plan-tool "zg" "cap.kernel.call"))
            (sum (list
                (fczgb-bit (and (eq (str_find hybrid "zg-native status=hit route=hybrid" 0) 0)
                                 (ge (str_find hybrid "form-cli/tool/call" 0) 0)) 1)
                (fczgb-bit (and (eq (str_find exact "zg-native status=hit route=rg" 0) 0)
                                 (ge (str_find exact "form-cli/tool/file" 0) 0)) 2)
                (fczgb-bit (eq (str_find fts "zg-native status=hit route=fts" 0) 0) 4)
                (fczgb-bit (eq (str_find vector "zg-native status=hit route=vector" 0) 0) 8)
                (fczgb-bit (eq (str_find miss "zg-native status=miss route=rg" 0) 0) 16)
                (fczgb-bit (and (ge (str_find hybrid "crossings=0" 0) 0)
                                 (ge (str_find exact "crossings=0" 0) 0)) 32)
                (fczgb-bit (and (eq (len (fc-zg-resident-docs)) (len (tc-tools)))
                                 (ge (str_find help "zg [rg|fts|vector|hybrid]" 0) 0)) 64)
                (fczgb-bit (and (str_eq (tc-plan-protocol plan) "kernel:call")
                                 (and (str_eq (tc-plan-op plan) "zvec-grep")
                                      (eq (tc-native-option? "zg") 1))) 128)))))
    (form-cli-zg-band))
