; parse-float-dot-band.bml — a dot with no digits after it is no float (parse.bml, frac-end).
;
; The grammar parse.bml names is [sign] digits [. digits] [e|E [sign] digits]: "1." and "1.e3" stand outside it and read 1 and 1000.
;
; Expected: 31
; Verdict 31 when every claim lands:
;   1   a dot that ends the text reads nothing()
;   2   a dot before an exponent reads nothing()
;   4   the grammar's own floats still read, with and without a fraction or exponent
;   8   an int-shaped text, a signed text and a text with no digits read as they did
;   16  frac-end itself answers -1 for a dot with no digit after it, and its other answers stay
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/parse.bml
section [form.bml] {
 class ParseFloatDotBand {
  def pfd-is?(v, want) = ((String) value_kind(v) == "float") && ((Comparable) v == want);
  def pfd-c-end(ctx) = nothing?(parse-float("1.")) && nothing?(parse-float("-1."));
  def pfd-c-exp(ctx) = nothing?(parse-float("1.e3")) && nothing?(parse-float("2.E+4"));
  def pfd-c-floats(ctx) = pfd-is?(parse-float("3.5"), 3.5) && pfd-is?(parse-float("-1.5e1"), -15.0) && pfd-is?(parse-float("2e3"), 2000.0) && pfd-is?(parse-float("7"), 7.0);
  def pfd-c-index(ctx) = (Comparable) frac-end("1.", 1) == -1 && (Comparable) frac-end("1.e3", 1) == -1 && (Comparable) frac-end("3.5", 1) == 3 && (Comparable) frac-end("7", 1) == 1;
  def pfd-c-rest(ctx) = nothing?(parse-float(".5")) && nothing?(parse-float("1e")) && nothing?(parse-float("-")) && pfd-is?(parse-float(" 0.25 "), 0.25);
 }
 live-claims("parse-float-dot-band", 0, [["end", 1, 1, pfd-c-end], ["exp", 2, 1, pfd-c-exp], ["floats", 4, 1, pfd-c-floats], ["rest", 8, 1, pfd-c-rest], ["index", 16, 1, pfd-c-index]]);
}
