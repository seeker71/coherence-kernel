; pivot-coverage-band.fk — the no-favored-tongue coverage lens counts, and the
; first five homecoming words reach the pivot from both tongue doors.
;
; form-stdlib/pivot-coverage.bml holds the corpus's fresh words (hdc-fresh)
; against the pivot lexicon's en column (nlt-lexicon) and answers
; words*10^6 + pivoted*10^3 + missing. This band plants a two-word world
; against a one-row lexicon so the fold is read exactly, then reads the
; living walk for its shape (the corpus grows every sitting, so the living
; numbers are held by relation, never pinned), then walks the five rows
; minted 2026-09-03 (m1257..m1261 in nl-lexicon-data.fk) through the
; existing nl-translate doors: en surface -> symbol -> id surface -> symbol,
; and the same meaning from the en door and the id door interning to ONE node.
;
; Verdict 65535 (sixteen bits):
;   1      planted: pivoted count 1 of ("hearth" "moonwell") against one row
;   2      planted: the missing list is exactly ("moonwell")
;   4      planted: pc-pivoted? says 1 for the row's word, 0 for the other
;   8      planted: field code 2*10^6 + 1*10^3 + 1 = 2001001
;   16     living: the walk counts every corpus row (words = hdc-count)
;   32     living: at least the five rows minted today are pivoted
;   64     living: words = pivoted + missing (the fold loses nothing)
;   128    m1257 twicegrown <-> tumbuhdua, both ways through the symbol
;   256    m1258 seatrace   <-> balapkursi
;   512    m1259 afterwall  <-> pascatembok
;   1024   m1260 keloid     <-> keloid
;   2048   m1261 seedshell  <-> cangkangbenih
;   4096   "the afterwall is keloid" and "pascatembok adalah keloid" intern to ONE node
;   8192   tr-en-id "the seatrace is afterwall" -> "balapkursi adalah pascatembok"
;   16384  tr-id-en "cangkangbenih adalah tumbuhdua" -> "the seedshell is twicegrown"
;   32768  living: the missing list no longer names afterwall, and the pivot
;          node speaks the meaning-id (m1259), not any tongue's lemma
;
; PROOF LEVEL: FOURTH-ARM ONLY — the lens is BML on fkwu's own lane.
;
; preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/string-case.fk form-stdlib/nl-lexicon-data.fk form-stdlib/nl-translate.fk learn/homecoming-distillation-corpus.fk form-stdlib/pivot-coverage.bml
;
; The organ's top-level statement runs the living walk when preluded, so a
; run of this band prints the body's coverage report first; the verdict is
; the last line and the exit code.
;
; run: ./fkwu form/form-stdlib/tests/pivot-coverage-band.fk    ; -> 65535

(do
    (defn pcb-k (cond bit) (if cond bit 0))
    ;; a row resolves both ways: en -> symbol, symbol -> id, id -> symbol, symbol -> en
    (defn pcb-both-ways? (sy en id)
        (and (str_eq (nlt-en->c en) sy)
             (and (str_eq (nlt-c->id sy) id)
                  (and (str_eq (nlt-id->c id) sy)
                       (str_eq (nlt-c->en sy) en)))))
    (defn pivot-coverage-band ()
        (do
            ;; ---- the planted world ----
            (let lex1 (list (list "p0" "gas" "hearth" "perapian")))
            (let words2 (list "hearth" "moonwell"))
            (let c2 (pc-cover words2 lex1))
            (let c0 (pcb-k (eq (pc-pivoted c2) 1) 1))
            (let c1 (pcb-k (and (eq (pc-missing-count c2) 1) (str_eq (head (pc-missing c2)) "moonwell")) 2))
            (let c2b (pcb-k (and (eq (pc-pivoted? lex1 "hearth") 1) (eq (pc-pivoted? lex1 "moonwell") 0)) 4))
            (let c3 (pcb-k (eq (pc-field 2 c2) 2001001) 8))
            ;; ---- the living walk ----
            (let rows (hdc-rows))
            (let words (pc-words rows))
            (let live (pc-cover words (nlt-lexicon)))
            (let c4 (pcb-k (eq (len words) (hdc-count rows)) 16))
            (let c5 (pcb-k (ge (pc-pivoted live) 5) 32))
            (let c6 (pcb-k (eq (len words) (add (pc-pivoted live) (pc-missing-count live))) 64))
            ;; ---- the five rows, both ways ----
            (let c7 (pcb-k (pcb-both-ways? "m1257" "twicegrown" "tumbuhdua") 128))
            (let c8 (pcb-k (pcb-both-ways? "m1258" "seatrace" "balapkursi") 256))
            (let c9 (pcb-k (pcb-both-ways? "m1259" "afterwall" "pascatembok") 512))
            (let c10 (pcb-k (pcb-both-ways? "m1260" "keloid" "keloid") 1024))
            (let c11 (pcb-k (pcb-both-ways? "m1261" "seedshell" "cangkangbenih") 2048))
            ;; ---- one meaning, two doors, one node ----
            (let p-en (norm-en (g-parse (nl-en) "the afterwall is keloid")))
            (let p-id (norm-id (g-parse (nl-id) "pascatembok adalah keloid")))
            (let c12 (pcb-k (node_eq p-en p-id) 4096))
            (let c13 (pcb-k (str_eq (tr-en-id "the seatrace is afterwall") "balapkursi adalah pascatembok") 8192))
            (let c14 (pcb-k (str_eq (tr-id-en "cangkangbenih adalah tumbuhdua") "the seedshell is twicegrown") 16384))
            (let c15 (pcb-k (and (eq (pc-holds? (pc-missing live) "afterwall") 0)
                                 (str_eq (nlt-kidv p-en 0) "m1259")) 32768))
            (add c0 (add c1 (add c2b (add c3 (add c4 (add c5 (add c6 (add c7
                (add c8 (add c9 (add c10 (add c11 (add c12 (add c13 (add c14 c15)))))))))))))))))
    (pivot-coverage-band))
