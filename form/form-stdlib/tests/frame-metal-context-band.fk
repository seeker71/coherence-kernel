; Independent cooperative Form owners, actual resident buffers and program leases.
; The spin version exercises lifetime only. The frame version proves exact results.
; Expected 131071. No address-space isolation claim is made by record ownership.
; preludes: form-stdlib/bml/frame-metal.bml form-stdlib/tests/frame-luma-fixture.fk
(do
 (let before (metal_status))
 (let version (fg-version 1024))
 (let raw-program (record_get version "program"))
 (let slow (fg-version-admit 1024 (mj-memory (mj-source "kernel void spin(device const uchar *s [[buffer(0)]], device uint *o [[buffer(1)]], uint gid [[thread_position_in_grid]]) { uint a=0; for(uint i=0;i<16000000u;i++) a+=uint(s[a&3u]); o[gid]=a; }") "spin")))
 (let a (fg-open version))
 (let bytes (flmb-bmp 1))
 (let af (fg-capture a bytes))
 (let aj (fg-submit a af (flm-default-policy)))
 (let ready (fg-await a aj))
 (let b (fg-open slow))
 (let bf (fg-capture b bytes))
 (let bj (fg-submit b bf (flm-default-policy)))
 (let selected (fg-publish b version))
 (let bk (fg-submit b bf (flm-default-policy)))
 (let retired (fg-retire version))
 (let two-leases (record_get version "leases"))
 (let kept (eq (record_get version "disposed") 0))
 (let previous (metal_deadline 1))
 (let timed (fg-await b bj))
 (let observed-before (metal_status))
 (let row (fg-result a aj))
 (let free-a (fg-release a aj))
 (let close-a (fg-close a))
 (let observed-after (metal_status))
 (let one-lease (record_get version "leases"))
 (let remains (eq (record_get version "disposed") 0))
 (let foreign (fg-release a bk))
 (let cancelled (fg-cancel b bj))
 (metal_deadline 15000)
 (let drained (fg-await-all b))
 (let result-b (fg-result b bk))
 (let close-b (fg-close b))
 (let disposed (record_get version "disposed"))
 (let replacement (fg-version 1024))
 (let c (fg-open replacement))
 (let cf (fg-capture c bytes))
 (let probe-output (metal_buf_alloc 32))
 (let stale (mj-enqueue raw-program
   (md-bind (list (record_get cf "input") probe-output)
     (fg-constants (record_get cf "layout") (flm-default-policy))) 1))
 (let freed-probe (metal_buf_free probe-output))
 (let reused (and (eq (mod (mj-handle raw-program) 2147483648)
                      (mod (mj-handle (record_get replacement "program")) 2147483648))
                  (not (eq (mj-handle raw-program) (mj-handle (record_get replacement "program"))))))
 (let cj (fg-submit c cf (flm-default-policy)))
 (let cw (fg-await c cj))
 (let cr (fg-result c cj))
 (let cc (fg-close c))
 (let retired-c (fg-retire replacement))
 (let release-slow (fg-retire slow))
 (let duplicate (fg-retire version))
 (metal_deadline previous)
 (let after (metal_status))
 (sum (list
  (if (and (str_eq ready "completed") (and (record? b) (record? bf))) 1 0)
  (if (and (eq selected 1) (and (eq retired 1) (and (eq two-leases 2) kept))) 2 0)
  (if (str_eq timed "pending") 4 0)
  (if (value_eq row (flm-stat bytes)) 8 0)
  (if (and (eq free-a 1) (eq close-a 1)) 16 0)
  (if (and (eq (fg-status-number observed-before "in_flight") 2)
           (eq (fg-status-number observed-after "in_flight") 2)) 32 0)
  (if (and (eq (fg-status-number observed-before "gpu_busy_us_total")
               (fg-status-number observed-after "gpu_busy_us_total"))
           (eq (fg-status-number observed-after "shelf") 0)) 64 0)
  (if (and (eq one-lease 1) remains) 128 0)
  (if (and (eq foreign 0) (eq cancelled 1)) 256 0)
  (if (and (eq drained 1) (nothing? (fg-result b bj))) 512 0)
  (if (value_eq result-b (flm-stat bytes)) 1024 0)
  (if (and (eq close-b 1) (and (eq disposed 1) (eq (record_get version "leases") 0))) 2048 0)
  (if (and (eq stale 0) (and (eq release-slow 1) (eq duplicate 1))) 4096 0)
  (if (and (eq (fg-status-number before "buffers") (fg-status-number after "buffers"))
           (eq (fg-status-number before "pipelines") (fg-status-number after "pipelines"))) 8192 0)
  (if (and (eq (fg-status-number after "in_flight") 0) (eq (fg-status-number after "shelf") 0)) 16384 0)
  (if (and reused (eq freed-probe 1)) 32768 0)
  (if (and (str_eq cw "completed") (and (value_eq cr (flm-stat bytes))
       (and (eq cc 1) (eq retired-c 1)))) 65536 0))))
