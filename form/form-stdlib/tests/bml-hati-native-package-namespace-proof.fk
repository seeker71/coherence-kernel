; tests/bml-hati-native-package-namespace-proof.fk
;
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk
;
; Closes package-namespace-resolution. `package A.B;` parses as the unit's
; scope; a name qualified by the unit's own package resolves to its member in
; the BMA reference lane and in the Hati native table lane; the scope travels
; as a bnii-package row from both the executable and the declaration stream of
; the real compiler picture; and a foreign qualifier, a second package, or a
; package outside a unit is named before any table is emitted.

(do
    (defn score-bool (actual)
        (if actual 1 0))

    (defn score-int (actual expected)
        (if (eq actual expected) 1 0))

    (defn score-str (actual expected)
        (if (nil? actual)
            0
            (if (str_eq actual expected) 1 0)))

    (defn str-contains? (haystack needle)
        (ge (str_find haystack needle 0) 0))

    (defn ns-parse (text)
        (bml-source-parse-executable-stream (bml-source-scan-text text)))

    (defn ns-node (text)
        (bml-source-exec-parse-node (ns-parse text)))

    (let source
        "package BML.compiler;\nint Inc(int n) { return n + 1; }\nreturn BML.compiler.Inc(41);\n")
    (let parsed (ns-parse source))
    (let source-node (bml-source-exec-parse-node parsed))
    (let package-node (head (bml-source-exec-parse-nodes parsed)))
    (let scope (bml-scope-unit-rows source-node))
    (let source-image (bml-hati-compile-image source-node))
    (let source-table (bml-hati-table-file source-image))

    (let member-node
        (ns-node "package BML.compiler;\nint Inc(int n) { return n + 1; }\nconst int base = 40;\nreturn BML.compiler.Inc(base) + 1;\n"))
    (let const-node
        (ns-node "package BML.compiler;\nconst int base = 40;\nreturn BML.compiler.base + 2;\n"))
    (let deep-node
        (ns-node "package BML.compiler.core;\nint Inc(int n) { return n + 1; }\nreturn BML.compiler.core.Inc(41);\n"))

    (let picture-path "form-stdlib/bml/bmf-bml-compiler-picture.bml")
    (let picture-parsed
        (bml-source-parse-executable-stream (bml-source-scan-file picture-path)))
    (let picture-scope
        (bml-scope-unit-rows (bml-ast-block (bml-source-exec-parse-nodes picture-parsed))))
    (let declaration-scope
        (bml-model-scope
            (bml-source-declaration-model
                (bml-source-file-parse-declarations picture-path))))

    (let foreign-image
        (bml-hati-compile-image
            (ns-node "package BML.compiler;\nint Inc(int n) { return n + 1; }\nreturn Other.Inc(41);\n")))
    (let duplicate-image
        (bml-hati-compile-image (ns-node "package A;\npackage B;\nreturn 1;\n")))
    (let bare-image (bml-hati-compile-image (bml-ast-package "A")))

    (sum
        (list
            (score-bool (bml-source-exec-parse-ok? parsed))
            (score-int (len (bml-source-exec-parse-rest parsed)) 0)
            (score-int (len (bml-source-exec-parse-nodes parsed)) 3)
            (score-str (nth (bml-source-exec-parse-rules parsed) 0) "package-scope")
            (score-str (nth (bml-source-exec-parse-rules parsed) 2) "return-expr")
            (score-bool (node_eq (node_category package-node) BML-AST-PACKAGE))
            (score-str (node_value (bml-node-child package-node 0)) "BML.compiler")
            (score-int (bnii-unit? scope) 1)
            (score-int (bnii-package? (bnii-unit-package scope)) 1)
            (score-str (bnii-unit-package-name scope) "BML.compiler")
            (score-int (bma-run-value (bml-compile-unit-program source-node (empty))) 42)
            (score-bool (bml-hati-image-supported? source-image))
            (score-int (len (bml-hati-image-fns source-image)) 2)
            (score-int (bml-hati-run-value source-node) 42)
            (score-bool (str-contains? source-table "12 1"))
            (score-bool (not (str-contains? source-table "BML-HATI-UNSUPPORTED")))
            (score-int (bma-run-value (bml-compile-unit-program member-node (empty))) 42)
            (score-int (bml-hati-run-value member-node) 42)
            (score-int (bma-run-value (bml-compile-unit-program const-node (empty))) 42)
            (score-int (bml-hati-run-value const-node) 42)
            (score-int (bml-hati-run-value deep-node) 42)
            (score-str (nth (bml-source-exec-parse-rules picture-parsed) 0) "package-scope")
            (score-str (bnii-unit-package-name picture-scope) "BML.compiler")
            (score-int (bnii-unit-import-count picture-scope) 2)
            (score-str (bnii-unit-package-name declaration-scope) "BML.compiler")
            (score-int (bnii-unit-import-count declaration-scope) 2)
            (score-bool (not (bml-hati-image-supported? foreign-image)))
            (score-str (head (bml-hati-image-unsupported foreign-image)) "call/unbound")
            (score-bool (str-contains? (bml-hati-table-file foreign-image) "BML-HATI-UNSUPPORTED call/unbound"))
            (score-str (head (bml-hati-image-unsupported duplicate-image)) "package/duplicate")
            (score-str (head (bml-hati-image-unsupported bare-image)) "package/outside-unit"))))
