; Exact first output token for the prompt whose durable 64-token receipt was
; semantically rejected after generation. All 22 prompt positions execute
; layer-major through all 43 layers. Successful prefill transactions use the
; compact JIT funnel; the output-head receipt remains detailed so its complete
; candidate surface can be inspected.
; witnessed: 2026-07-29 -> 255 (token 32111; top1/top2 gap 0.0919914)
;
; preludes: native/metal/dsv4-native-session.fk native/metal/dsv4-jit-metal-abi.fk config/dsv4-local-resource.fk

(do
    (defn dap-position-walk (route plan ids position)
        (if (eq (len ids) 0) 1
            (do
                (let passed
                    (dlw-direct-layer-plan-jit-prefill
                        route plan (head ids) position))
                (if (nothing? passed) (nothing)
                    (if (eq passed 1)
                        (dap-position-walk
                            route plan (tail ids) (add position 1))
                        0)))))

    (defn dap-layer-walk
        (route src descs ids layer end)
        (if (eq layer end) 1
            (do
                (let passed
                    (dap-position-walk
                        route
                        (dlw-layer-plan src descs layer)
                        ids 0))
                (if (nothing? passed) (nothing)
                    (if (eq passed 1)
                        (dap-layer-walk
                            route src descs ids
                            (add layer 1) end)
                        0)))))

    (defn dap-run ()
        (do
            (let ids
                (list
                    0 128803 71343 270 9152 11499 111127 295
                    566 3277 12818 9353 3618 305 2329 270
                    2894 4181 2757 16 128804 128822))
            (let admitted (dns-open))
            (if (not (eq admitted 1)) 0
                (do
                    (let src
                        (eqr-of-file
                            (dlp-model-path) 0 (gm-window)))
                    (let base
                        (egg-data-base src (gm-alignment)))
                    (let descs
                        (dlp-collect
                            src base
                            (egg-tinfo-start src)
                            (egg-tensor-count src)))
                    (let route
                        (dsv4-jit-metal-transaction-route
                            (dsv4-local-jit-carrier-resource)))
                    (print_str "DAP manifest-begin")
                    (print_str "prompt-token-count=22")
                    (print_str
                        "prompt-crossing-id=3818c2494a76084d5e033457ee87e499c1e4d3d923db2ddb2d902176797da7f1")
                    (print_str "expected-first-token=32111")
                    (print_str "network=0")
                    (print_str "remote=0")
                    (print_str "DAP manifest-end")
                    (dlw-init-prompt descs ids 0)
                    (let started (now_unix_ms))
                    (let prefilled
                        (dap-layer-walk
                            route src descs ids 0 43))
                    (let prefill-elapsed
                        (sub (now_unix_ms) started))
                    (print_str
                        (str_concat "DAP prefill-ms="
                            (int_to_str prefill-elapsed)))
                    (if (not (eq prefilled 1)) 0
                        (do
                            (dlw-say
                                (metal_model_state_load
                                    (dlw-prompt-state 21)))
                            (let receipt
                                (dlw-output-head descs))
                            ; dlw-output-head returns the complete argmax
                            ; receipt even when the generic dlw-say filter
                            ; keeps it quiet. This witness is specifically
                            ; about that candidate surface, so emit the value.
                            (print_str receipt)
                            (let token
                                (dns-token-id receipt))
                            (print_str
                                (str_concat
                                    "DAP observed-first-token="
                                    (if (nothing? token)
                                        "nothing"
                                        (int_to_str token))))
                            (print_str
                                (str_concat
                                    "DAP matches-recorded="
                                    (if (nothing? token) "0"
                                        (if (eq token 32111)
                                            "1" "0"))))
                            (print_str
                                (metal_model_close))
                            (if (and
                                    (not (nothing? token))
                                    (eq token 32111))
                                255 0)))))))

    (dap-run))
