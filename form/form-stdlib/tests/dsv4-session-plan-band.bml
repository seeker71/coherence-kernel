; dsv4-session-plan-band.bml -- the DeepSeek-V4 session door's dry plan (observe/dsv4-session-run.bml) on the real IQ2XXS header: nothing opened, nothing mapped, no lease taken, no row written.
;
; WHAT THIS PINS. form-stdlib/bml/dsv4-session-ask.bml's plan (dsa-plan-lines, what the door prints for {} and {"dry":1}) reads the header alone: the 8 MB window of the real file and its first 64 KiB, and the
; sidecar's presence (the seal's bytes are not read). The plan states what an ask would do, so a person can read it before the lead's go: the file and its lane, the seal sidecar, the chat template's ids, the
; capacity and the position limit, the lease the governor would be asked, the driver's gaps and the machine.
;
; Verdict 31 when every claim lands:
;   1     the plan's first lines name the real file (86,720,111,488 bytes), architecture deepseek4 and the lane dsv4 wired, and open with DRY and close with DRY ends
;   2     the prompt line carries the 14 chat-templated ids of "The capital of France is" (the recording's row: BOS 0, the system's five, User 128803, the prompt's five, Assistant 128804, <think> 128821) and the
;         header's eos stop id
;   4     the capacity line is 14 + 24 = 38 positions for the default 24 tokens and says the driver serves positions 0 through 2047; a request for 3,000 tokens is cut to 2,048
;   8     the lease line is the derived working set at that capacity (dls-weights-bytes-at, 26,7xx,xxx,xxx B on this header) with the 8 GiB private margin, the seal line reads present or ABSENT (the sidecar's own state),
;         and the gaps line reads none
;   16    the checks can fail: the dry door refuses a file that is not a deepseek4 GGUF (dsa-dry on a text file answers 1), an empty prompt plans no ids, and a plan for another file differs from this one's
;
; REQUIRES: the host-local IQ2XXS file (outside the tree): its header is read (8 MB and 64 KiB windows) and nothing else. No model is opened, no device is touched, no lease is taken. The band writes one text file under temp_dir and removes it.
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/gguf-manifest.fk form-stdlib/dsv4-layout.fk form-stdlib/dsv4-lease.fk form-stdlib/dsv4-tokenizer.fk form-stdlib/json.fk form-stdlib/bml/dsv4-session-ask.bml
section [form.bml] {
 class Dsv4SessionPlan {
  def dsp-bit(held, bit) = held ? bit : 0;
  def dsp-iq2() = "/Users/ursmuff/models/ds4-engine/gguf/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf";
  def dsp-has?(s, part) = str_find(s, part, 0) >= 0;
  def dsp-all(lines) = len(lines) == 0 ? "" : lines[0] ++ "\n" ++ dsp-all(lines[1:]);
  def dsp-opts(tokens) = json-node-object([json-node-pair("tokens", json-node-int(tokens))]);
  def dsp-plan(file, tokens) = dsp-all(dsa-plan-lines(file, file_size(file), dsp-opts(tokens)));
 }
 let iq2 = dsp-iq2();
 let textFile = temp_dir() ++ "/dsv4-session-plan-band-" ++ now_unix_ms().str() ++ ".txt";
 let wroteText = write_file(textFile, "not a model");
 let lines = dsa-plan-lines(iq2, file_size(iq2), dsp-opts(24));
 let plan = dsp-all(lines);
 let big = dsp-plan(iq2, 3000);
 let shared38 = dls-weights-bytes-at(iq2, 38);
 let said = print_str(plan);
 let r1 = try len(lines) == 9 && dsp-has?(lines[0], "DRY: the plan; nothing is opened") && dsp-has?(lines[8], "DRY ends") && dsp-has?(plan, "86720111488 B") && dsp-has?(plan, "architecture deepseek4, lane dsv4 (wired)") catch false;
 let r2 = try dsp-has?(plan, "14 ids from the chat template") && dsp-has?(plan, "[0,3476,477,260,11502,22896,128803,671,6102,294,8760,344,128804,128821]") && dsp-has?(plan, "stop id [1]") catch false;
 let r4 = try dsp-has?(plan, "capacity 38 positions (asked 38, the driver serves positions 0 through 2047)") && dsp-has?(big, "capacity 2048 positions (asked 3014, the driver serves positions 0 through 2047)") && dsp-has?(plan, "context-limit") catch false;
 let r8 = try shared38 > 20000000000 && dsp-has?(plan, "shared " ++ mg-gib-text(shared38) ++ " (" ++ shared38.str() ++ " B") && dsp-has?(plan, "private " ++ mg-gib-text(mg-kv-margin())) && (dsp-has?(plan, "present (the open hashes") || dsp-has?(plan, "ABSENT: the session door refuses")) && dsp-has?(plan, "the driver's gaps: none") catch false;
 let refusedText = dsa-dry(json-node-object([json-node-pair("file", json-node-string(textFile))]));
 let emptyPlan = dsp-all(dsa-plan-lines(iq2, file_size(iq2), json-node-object([json-node-pair("prompt", json-node-string(""))])));
 let r16 = try refusedText == 1 && dsp-has?(emptyPlan, "the prompt: 0 ids") && emptyPlan != plan && big != plan catch false;
 let removed = host_path_remove(textFile);
 print_str("dsv4-session-plan-band claims " ++ dsp-bit(r1, 1).str() ++ " " ++ dsp-bit(r2, 2).str() ++ " " ++ dsp-bit(r4, 4).str() ++ " " ++ dsp-bit(r8, 8).str() ++ " " ++ dsp-bit(r16, 16).str() ++ " removed " ++ removed.str());
 dsp-bit(r1, 1) + dsp-bit(r2, 2) + dsp-bit(r4, 4) + dsp-bit(r8, 8) + dsp-bit(r16, 16);
}
