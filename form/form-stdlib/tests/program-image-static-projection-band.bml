// program-image-static-projection-band.bml — an admitted cell projects to a static graph.
//
// The catalog is the cell's own admission (kernel_ast "catalog"). The projector
// walks that catalog through callbacks and never reads a hold. Two projections
// of the same admission are the same graph. A value that is not an admitted
// function refuses.
//   1  the admitted function projects, and its export is the name the cell defined
//   2  a second projection is the same nodes, functions and symbols
//   4  nothing admits no catalog
//   8  the projected rows are a valid program-image table, and its roots are the function bodies
//  16  that table's container is ready, and a second projection flats to the same image
//  32  a process id was rewritten, it is absent from the flat, and the demand wire is that flat
// Verdict 63.
// preludes: form-stdlib/program-image-fkb-byte-container.fk form-stdlib/bml/bml-demand-jit.bml
section [form.bml] {
 class ProgramImageStaticProjectionBand {
  def pispb-path() = "/tmp/program-image-static-projection.fk";
  def pispb-say(s) = print_str("[program-image-static-projection] " ++ s ++ "\n");
  def pispb-named?(rows, name) = nil?(rows) ? 0 : rows[0][0] == name ? 1 : pispb-named?(rows[1:], name);
  def pispb-in?(xs, n) = nil?(xs) ? 0 : xs[0] == n ? 1 : pispb-in?(xs[1:], n);
  def pispb-bodies(fns) = nil?(fns) ? [] : cons(fns[0][1], pispb-bodies(fns[1:]));
  def pispb-roots-in?(roots, n) = nil?(roots) ? 1 : roots[0] >= 0 && roots[0] < n ? pispb-roots-in?(roots[1:], n) : 0;
  def pispb-foreign(keys, map, n, flat, seen) = nil?(keys) ? seen : pispb-foreign-one(keys, map, n, flat, seen, str_to_int(keys[0]));
  def pispb-foreign-one(keys, map, n, flat, seen, id) = if (id >= n && pispb-in?(flat, id)) then -1 else pispb-foreign(keys[1:], map, n, flat, id != record_get(map, keys[0]) ? 1 : seen);
  def pispb-run() {
   let wrote = write_file(pispb-path(), "(do (defn pisp-answer () 7) pisp-answer)\n");
   let ran = cell_call(pispb-path(), nothing(), nothing());
   let fn = record_get(ran, "value");
   let first = pifbc-project-admitted(fn);
   let second = pifbc-project-admitted(fn);
   let refused = pifbc-project-admitted(nothing());
   let status = record_get(first, "status");
   let reason = record_get(first, "reason");
   let nodes = record_get(first, "nodes");
   let root = record_get(first, "roots")[0];
   let table = pifbc-projection-table(first);
   let flat = jonb-flat(nodes, root, 1);
   let again = jonb-flat(record_get(second, "nodes"), record_get(second, "roots")[0], 1);
   let wire = bdj-projected-program-wire(nodes, root, 1);
   let held = pifbc-projection-container(first, pispb-path());
   let nodeMap = record_get(first, "relocation")[0];
   let moved = pispb-foreign(record_keys(nodeMap), nodeMap, len(nodes), flat, 0);
   pispb-say(status ++ " " ++ reason ++ " nodes " ++ len(nodes).str() ++ " symbols " ++ len(record_get(first, "symbols")).str());
   let b1 = status == "projected" && reason == "" && pispb-named?(record_get(first, "symbols"), "pisp-answer") ? 1 : 0;
   let b2 = value_eq(nodes, record_get(second, "nodes")) && value_eq(record_get(first, "functions"), record_get(second, "functions")) && value_eq(record_get(first, "symbols"), record_get(second, "symbols")) ? 2 : 0;
   let b4 = record_get(refused, "status") == "refused" ? 4 : 0;
   let b8 = !nothing?(table) && pif-table-valid?(table) && value_eq(pif-table-node-rows(table), nodes) && value_eq(pif-table-fn-roots(table), pispb-bodies(record_get(first, "functions"))) && pispb-roots-in?(record_get(first, "roots"), len(nodes)) ? 8 : 0;
   let b16 = !nothing?(held) && pifbc-ready?(held) && value_eq(flat, again) ? 16 : 0;
   let b32 = moved == 1 && wire == bdj-image-text(flat) ? 32 : 0;
   pispb-say("bits " ++ b1.str() ++ " " ++ b2.str() ++ " " ++ b4.str() ++ " " ++ b8.str() ++ " " ++ b16.str() ++ " " ++ b32.str() ++ " moved " ++ moved.str());
   if (b16 == 0) then pispb-say(nothing?(held) ? "container nothing" : "container " ++ pifbc-container-status(held) ++ " " ++ pifbc-container-reason(held)) else 0;
   b1 + b2 + b4 + b8 + b16 + b32;
  }
 }
 pispb-run();
}
