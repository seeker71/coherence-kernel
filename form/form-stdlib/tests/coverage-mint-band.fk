; coverage-mint-band.fk — the mint's mechanical surface, model-free.
;
; The model-facing pieces (authoring was tried and demoted, attestation is a
; counted courtesy) are witnessed by live runs and the receipt; this band
; proves everything that does not need a mind: extraction, guards, template,
; and the row shape training consumes.
;
; Verdict 255 (8 bits):
;   1    host-kernel.form yields 30+ comment-bearing clean fact pairs
;   2    the CAN-not-MUST pair is among them, comment intact
;   4    the question is the source's own comment asked back
;   8    a question containing its own answer is rejected (leak guard)
;   16   a question opening with a sealed prompt's first eight words is
;        rejected (sealed guard), and an unrelated question passes
;   32   the emitted row is one JSONL line in the training shape
;   64   first-segment: CAN-not-MUST -> CAN; segmentless tokens are whole
;   128  a pair with an empty comment mints nothing
;
; preludes: learn/coverage-mint.fk

(do
    (defn cmb-bit (ok bit) (if ok bit 0))
    (defn cmb-find-pair (ps val)
        (if (eq (len ps) 0) (nothing)
            (if (str_eq (nth (head ps) 1) val) (head ps)
                (cmb-find-pair (tail ps) val))))
    (defn coverage-mint-band ()
        (do
            (let ps (cm-pairs "axioms/host-kernel.form"))
            (let p (cmb-find-pair ps "CAN-not-MUST"))
            (let q (cm-mint-q "host-kernel.form" (nth p 0) (nth p 1) (nth p 2)))
            (let sealed (list "In host-kernel.form, what exact token names whether native resource replacement is optional?"))
            (let row (cm-row "which token?" "CAN-not-MUST"))
            (sum (list
                (cmb-bit (ge (len ps) 30) 1)
                (cmb-bit (and (not (nothing? p))
                              (gt (str_len (nth p 2)) 0)) 2)
                (cmb-bit (and (ge (str_find q "which token names" 0) 0)
                              (ge (str_find q (nth p 2) 0) 0)) 4)
                (cmb-bit (ge (str_find "does CAN-not-MUST apply?" "CAN-not-MUST" 0) 0) 8)
                (cmb-bit (and (eq (cm-guard-ok? "In host-kernel.form, what exact token names whether native anything" sealed) 0)
                              (eq (cm-guard-ok? "which token names: a choice on measured benefit?" sealed) 1)) 16)
                (cmb-bit (and (ge (str_find row "\"role\":\"user\"" 0) 0)
                         (and (ge (str_find row "\"role\":\"assistant\"" 0) 0)
                              (ge (str_find row "CAN-not-MUST\"}]}" 0) 0))) 32)
                (cmb-bit (and (str_eq (cm-first-seg "CAN-not-MUST") "CAN")
                              (str_eq (cm-first-seg "plain") "plain")) 64)
                (cmb-bit (nothing? (cm-mint-q "x" "k" "a-b" "")) 128)))))
    (coverage-mint-band))
