; Second half of the real two-process witness.  It does not rebuild the world.
; It loads, validates, inspects one known cell, then removes the exact temp file.
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/tests/living-world-continuity-durable-witness.fk

(do
    (let loaded (lwcd-load (lwcdw-path) (lwcdw-evidence)))
    (let image (lwcd-result-image loaded))
    (let world (lwcn-image-world image))
    (let before-clean
        (lwcdw-sum
            (list
                (if (eq (lwcd-loaded? loaded) 1) 1 0)
                (if (eq (lwcn-image-valid? image) 1) 2 0)
                (if (eq (lwo-active? world (lwcdw-payload)) 1) 4 0)
                (if (eq (lwo-field-size (lwo-world-cells world)) 1) 8 0)
                (if (eq (lwo-field-size
                            (lwo-world-attributions world)) 1) 16 0))))
    (lwcdw-clean)
    before-clean)
