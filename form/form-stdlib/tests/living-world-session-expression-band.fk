; living-world-session-expression-band.fk -- an aggregate-only session
; derivation acquires and loses a participant-learned opaque surface.
; Verdict 32767 proves fifteen derivation, evidence, consent, projection,
; optional-field, foreign-refusal, and owner-revocation claims.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/native-model-evidence.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-session-observation.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-session-observation-witness.fk form-stdlib/tests/living-world-session-expression-witness.fk

(do
    (let started
        (lcfb-open-stream "living-world-session-expression-band"
            "form-native" "lwrsx-run" "declared-verdict"
            "form/form-stdlib/tests/living-world-session-expression-band.fk"
            9 9))
    (lwrsx-verdict (lwrsx-run started)))
