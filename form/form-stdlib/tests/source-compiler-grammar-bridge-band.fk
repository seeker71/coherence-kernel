; source-compiler-grammar-bridge-band.fk -- FDL grammar feeds source compiler emission.
;
; preludes: form-stdlib/core.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/defdata.fk form-stdlib/form-definition-language.fk form-stdlib/source-artifact-cache.fk form-stdlib/source-artifact-descriptor.fk form-stdlib/runtime-artifact-plan.fk form-stdlib/runtime-artifact-selector.fk form-stdlib/runtime-artifact-outcome.fk form-stdlib/runtime-artifact-retry.fk form-stdlib/runtime-artifact-load-envelope.fk form-stdlib/program-image-fkb.fk form-stdlib/program-image-tbl-emit.fk form-stdlib/source-compiler-emission.fk form-stdlib/source-compiler-grammar-bridge.fk
; preludes: form-stdlib/form-fs.fk form-stdlib/source-artifact-probe.fk
;
; Verdict 32767
; Emission rejoins content identity across changed source timestamps; selection
; retains a valid parsed image when an optional native artifact is unusable.

(do
    (defn scgbb-score (ok bit) (if ok bit 0))
    (defn scgbb-manifest-has (name)
        (source-compiler-grammar-bridge-manifest-has?
            name
            (source-compiler-grammar-bridge-manifest)))

    (defn scgbb-surface ()
        "module calc { data rows = [40,2]; fn answer() = add(40,2); }")
    (defn scgbb-expected-lowered ()
        "(let rows (list 40 2))\n(defn answer () (add 40 2))")
    (defn scgbb-bad-surface ()
        (str_concat (scgbb-surface) " trailing"))

    (defn scgbb-source () (sad-source "src/calc.fdl" "sha:calc-fdl" 200))
    (defn scgbb-output-fkb () (sac-compile-output 0 0))
    (defn scgbb-table ()
        (pif-table-image 1
                         (list 0)
                         1
                         (list (pif-node-row 1 42 0 0))
                         0
                         (empty)))
    (defn scgbb-pif ()
        (pif-envelope "src/calc.fdl" "sha:calc-fdl" 100
                      "src/calc.fkb" "sha:calc-fkb" 101
                      1
                      (scgbb-table)))
    (defn scgbb-text ()
        (pite-table-text-from-envelope (scgbb-pif)))
    (defn scgbb-text-bad () "1 0 1 1 43 0 0 0\n")

    (defn scgbb-fkb (hash seal version)
        (sad-program-image-fkb version "src/calc.fkb" hash "sha:calc-fkb" 0 seal 1))
    (defn scgbb-dylib (hash seal proof callable)
        (sad-native-dylib (sad-version-native-dylib) "src/calc.dylib"
            hash "sha:calc-native" 0 seal proof callable 1))
    (defn scgbb-selected (source fkb dylib)
        (ras-selection-selected
            (ras-selection-from-plan (rap-plan-from-descriptors source fkb dylib))))
    (defn scgbb-content-selection? ()
        (do
            (let source (sad-source "src/calc.fdl" "sha:calc-fdl" 0))
            (let fkb (scgbb-fkb "sha:calc-fdl" 1 (sad-version-program-image-fkb)))
            (let native (scgbb-dylib "sha:calc-fdl" 1 1 1))
            (and
                (str_eq (scgbb-selected source fkb native) (rap-act-run-native))
                (and
                    (str_eq (scgbb-selected source fkb (scgbb-dylib "sha:other" 1 1 1)) (rap-act-run-program-image))
                    (and
                        (str_eq (scgbb-selected source fkb (scgbb-dylib "sha:calc-fdl" 0 1 1)) (rap-act-run-program-image))
                        (and
                            (str_eq (scgbb-selected source fkb (scgbb-dylib "sha:calc-fdl" 1 0 1)) (rap-act-run-program-image))
                            (and
                                (str_eq (scgbb-selected source fkb (scgbb-dylib "sha:calc-fdl" 1 1 0)) (rap-act-run-program-image))
                                (and
                                    (str_eq (scgbb-selected source (sad-no-artifact) native) (rap-act-compile-source))
                                    (and
                                        (str_eq (scgbb-selected source (scgbb-fkb "sha:other" 1 (sad-version-program-image-fkb)) native) (rap-act-compile-source))
                                        (and
                                            (str_eq (scgbb-selected source (scgbb-fkb "sha:calc-fdl" 0 (sad-version-program-image-fkb)) native) (rap-act-compile-source))
                                            (str_eq (scgbb-selected source (scgbb-fkb "sha:calc-fdl" 1 "old-image") native) (rap-act-compile-source))))))))))))
    (defn scgbb-content-probe? ()
        (do
            (let source (sap-source-observation "src/calc.fdl" 1 10 0 "sha:calc-fdl"))
            (let fkb (sap-program-image-fkb-observation "src/calc.fkb" 1 20 0 "sha:calc-fdl" "sha:calc-fkb" 1 1))
            (let missing (sap-native-dylib-observation "src/calc.dylib" 0 -1 -1 "" "" 0 0 0 0))
            (and
                (eq (sap-delegated-route (sap-bundle source fkb missing)) (sac-run-fkb))
                (and
                    (eq (sap-observation-contradictory? (sap-source-observation "src/calc.fdl" 0 10 0 "sha:calc-fdl")) 1)
                    (eq (sap-observation-contradictory? (sap-source-observation "src/calc.fdl" 1 -1 100 "sha:calc-fdl")) 1)))))
    (defn scgbb-content-emission? ()
        (do
            (let pif (pif-envelope "src/calc.fdl" "sha:calc-fdl" 0
                "src/calc.fkb" "sha:calc-fkb" 0 1 (scgbb-table)))
            (and
                (eq (pif-route-from-envelope pif) (sac-run-fkb))
                (and
                    (sce-source-pif-match? (scgbb-source) pif)
                    (and
                        (eq (sce-source-pif-match? (sad-source "src/calc.fdl" "sha:other" 0) pif) 0)
                        (and
                            (eq (sce-source-pif-match? (sad-source "src/other.fdl" "sha:calc-fdl" 0) pif) 0)
                            (eq (sad-source-valid? (list "source-artifact-source" "src/calc.fdl" "sha:calc-fdl")) 0)))))))
    (defn scgbb-repair-observation? ()
        (do
            (let source (scgbb-source))
            (let fkb (scgbb-fkb "sha:calc-fdl" 1 (sad-version-program-image-fkb)))
            (let native (scgbb-dylib "sha:calc-fdl" 1 1 1))
            (let selected (ras-selection-from-plan (rap-plan-from-descriptors source fkb native)))
            (let failure (rao-outcome-from-selection-observation selected
                (rao-run-observation (rap-act-run-native) (rao-obs-error) "admitted-image-rejected" 17)))
            (let waiting (rar-retry-from-outcome failure))
            (let load (rale-envelope-from-retry source fkb native waiting))
            (let reobserved (rao-outcome-from-selection-observation selected
                (rao-run-observation (rap-act-run-native) (rao-obs-ok) "owner-repaired-and-reobserved" 0)))
            (and
                (str_eq (rao-outcome-status failure) (rao-status-repair-required))
                (and
                    (str_eq (rar-retry-status waiting) (rar-status-waiting-repair))
                    (and
                        (rar-no-selection? (rar-retry-next-selection waiting))
                        (and
                            (eq (rar-retry-source-outcome waiting) failure)
                            (and
                                (str_eq (rao-outcome-detail (rar-retry-source-outcome waiting)) "admitted-image-rejected")
                                (and
                                    (eq (rao-outcome-code (rar-retry-source-outcome waiting)) 17)
                                    (and
                                        (str_eq (rale-envelope-reason load) (rale-reason-retry-not-ready))
                                        (str_eq (rar-retry-status (rar-retry-from-outcome reobserved)) (rar-status-terminal-complete)))))))))))

    (defn scgbb-compile-selection ()
        (ras-selection-from-plan
            (rap-plan-from-descriptors
                (scgbb-source)
                (sad-no-artifact)
                (sad-no-artifact))))
    (defn scgbb-compile-envelope ()
        (rale-envelope-from-selection
            (scgbb-source)
            (sad-no-artifact)
            (sad-no-artifact)
            (scgbb-compile-selection)))
    (defn scgbb-ready-row ()
        (scgb-from-form-definition-source
            (scgbb-surface)
            (scgbb-compile-envelope)
            (scgbb-output-fkb)
            (scgbb-pif)
            (scgbb-text)
            (sce-no-dylib)))
    (defn scgbb-bad-parse-row ()
        (scgb-from-form-definition-source
            (scgbb-bad-surface)
            (scgbb-compile-envelope)
            (scgbb-output-fkb)
            (scgbb-pif)
            (scgbb-text)
            (sce-no-dylib)))
    (defn scgbb-bad-table-row ()
        (scgb-from-form-definition-source
            (scgbb-surface)
            (scgbb-compile-envelope)
            (scgbb-output-fkb)
            (scgbb-pif)
            (scgbb-text-bad)
            (sce-no-dylib)))

    (defn source-compiler-grammar-bridge-band ()
        (do
            (let ready (scgbb-ready-row))
            (let lower (scgb-row-lowering ready))
            (let emission (scgb-row-emission ready))
            (let bad-parse (scgbb-bad-parse-row))
            (let bad-table (scgbb-bad-table-row))
            (let bad-emission (scgb-row-emission bad-table))
            (add
                (scgbb-score (eq (scgbb-manifest-has "form-definition-grammar-admission") 1) 1)
            (add
                (scgbb-score (eq (scgbb-manifest-has "scannerless-bmf-cursor-required") 1) 2)
            (add
                (scgbb-score (eq (scgbb-manifest-has "source-compiler-emission-delegated") 1) 4)
            (add
                (scgbb-score (eq (scgbb-manifest-has "parse-failure-refuses-emission") 1) 8)
            (add
                (scgbb-score (scgb-ready? ready) 16)
            (add
                (scgbb-score (sce-emitted? emission) 32)
            (add
                (scgbb-score (str_eq (fdl-lowering-name lower) "calc") 64)
            (add
                (scgbb-score (str_eq (fdl-lowering-source lower) (scgbb-expected-lowered)) 128)
            (add
                (scgbb-score (and (str_eq (sad-artifact-path (sce-emission-fkb-descriptor emission)) "src/calc.fkb")
                    (and (scgbb-content-selection?) (and (scgbb-content-probe?) (scgbb-content-emission?)))) 256)
            (add
                (scgbb-score (scgb-refused? bad-parse) 512)
            (add
                (scgbb-score (str_eq (scgb-row-reason bad-parse) (scgb-reason-parse-failed)) 1024)
            (add
                (scgbb-score (scgb-investigate? bad-table) 2048)
            (add
                (scgbb-score (str_eq (sce-emission-reason bad-emission) (sce-reason-table-text-mismatch)) 4096)
            (add
                (scgbb-score (and (eq (scgbb-manifest-has "no-c-seed-growth") 1) (scgbb-repair-observation?)) 8192)
                (scgbb-score (str_eq (scgb-row-reason ready) (scgb-reason-ready)) 16384)))))))))))))))))

    (source-compiler-grammar-bridge-band))
