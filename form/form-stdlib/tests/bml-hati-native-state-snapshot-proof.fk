; tests/bml-hati-native-state-snapshot-proof.fk
;
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk
;
; save/restore/discard as one state snapshot on both lanes. `mark;` (and
; `save`) takes a snapshot of the state, `restore;` returns to it and
; `discard;` drops it. The state is the mutable locals and the value a
; statement list stands on: on BMA the locals ride the value stack, so its
; stack snapshot carries them; on Hati the bnml frame keeps a snapshot stack
; beside the locals. Every source here runs on both lanes to the same value.
; A restore with no snapshot to return to is named before any table exists.

(do
    (defn score-bool (actual)
        (if actual 1 0))

    (defn score-int (actual expected)
        (if (eq actual expected) 1 0))

    (defn score-str (actual expected)
        (if (str_eq (value_kind actual) "string")
            (if (str_eq actual expected) 1 0)
             0))

    (defn str-contains? (haystack needle)
        (ge (str_find haystack needle 0) 0))

    (defn parse (source)
        (bml-source-parse-executable-stream (bml-source-scan-text source)))

    (defn node-of (source)
        (bml-source-exec-parse-node (parse source)))

    (defn both (node expected)
        (add (score-int (bma-run-value (bml-compile-program node)) expected)
             (score-int (bml-hati-run-value node) expected)))

    ;; the whole source reads, so no value stands on a partial parse
    (defn whole (source)
        (do
            (let parsed (parse source))
            (if (bml-source-exec-parse-ok? parsed)
                (score-int (len (bml-source-exec-parse-rest parsed)) 0)
                0)))

    (let keep-rules
        (bml-source-exec-parse-rules (parse "int x = 1;\nmark;\nx = 5;\ndiscard;\nreturn x;\n")))
    (let save-rules
        (bml-source-exec-parse-rules (parse "int x = 1;\nsave;\nx = 2;\nrestore;\nreturn x;\n")))

    ;; restore returns a rebound local to its value at the mark
    (let rollback-node (node-of "int x = 1;\nmark;\nx = 5;\nrestore;\nreturn x;\n"))
    (let rollback-image (bml-hati-compile-image rollback-node))
    (let rollback-table (bml-hati-table-file rollback-image))

    ;; discard keeps what happened since the mark
    (let keep-node (node-of "int x = 1;\nmark;\nx = 5;\ndiscard;\nreturn x;\n"))

    ;; snapshots stack: the inner restore, then the outer one dropped
    (let nested-node
        (node-of "int x = 1;\nint y = 0;\nmark;\nx = 2;\nmark;\nx = 3;\nrestore;\ny = x;\ndiscard;\nreturn x + y;\n"))

    ;; without a return, the value stands where the snapshot left it
    (let stack-node (node-of "const int a = 2;\nmark;\nconst int b = 7;\nrestore;\n"))
    (let state-node (node-of "save;\n5;\ndiscard;\n"))

    ;; a rebinding inside a nested block is inside the snapshot too
    (let block-node (node-of "int x = 1;\nmark;\n{\n    x = 9;\n}\nrestore;\nreturn x;\n"))

    ;; a called method snapshots its own frame
    (let call-node
        (node-of "int Undo(int n) {\n    int x = n;\n    mark;\n    x = x + 100;\n    restore;\n    return x;\n}\nreturn Undo(7);\n"))

    (let orphan-image (bml-hati-compile-image (node-of "restore;\nreturn 1;\n")))

    (sum
        (list
            (whole "int x = 1;\nmark;\nx = 5;\nrestore;\nreturn x;\n")
            (whole "int x = 1;\nmark;\nx = 5;\ndiscard;\nreturn x;\n")
            (whole "int x = 1;\nint y = 0;\nmark;\nx = 2;\nmark;\nx = 3;\nrestore;\ny = x;\ndiscard;\nreturn x + y;\n")
            (whole "int x = 1;\nmark;\n{\n    x = 9;\n}\nrestore;\nreturn x;\n")
            (score-str (nth keep-rules 3) "discard-simple")
            (score-str (nth save-rules 1) "save-simple")
            (both (node-of "int x = 1;\nsave;\nx = 2;\nrestore;\nreturn x;\n") 1)
            (both rollback-node 1)
            (score-bool (bml-hati-image-supported? rollback-image))
            (score-bool (not (str-contains? rollback-table "BML-HATI-UNSUPPORTED")))
            (both keep-node 5)
            (both nested-node 4)
            (both stack-node 2)
            (both state-node 5)
            (both block-node 1)
            (both call-node 7)
            (score-str (head (bml-hati-image-unsupported orphan-image)) "restore/no-mark"))))
