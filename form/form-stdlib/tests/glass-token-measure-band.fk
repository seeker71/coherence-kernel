; glass-token-measure-band.fk — the glass counts every model's live form-token position.
; witnessed: 2026-10-01 -> 127
;   1 three models stay, an older position of the same model does not
;   2 the live total is the sum of those newest positions
;   4 the doing line names the total and each model
;   8 a token-flow model is named from its channel, with no handle required
;   16 a zero handle still counts
;   32 an empty frame stays an empty measure
;   64 generated form tokens are named, and stay beside a context position
; preludes: form/form-stdlib/form-glass-flow-ui.bml
(do
    (defn gtm-pos (id parent owner purpose capacity handle epoch channels)
        (fgtm-sample id (fgtm-present parent) "token-position" "form" owner
            "reasoning" purpose (fgtm-absent) (fgtm-present capacity) "active"
            (fgtm-present epoch) (fgtm-present epoch) (fgtm-absent)
            handle "never" "physical-live" "model.context-position" channels))
    (defn gtm-bit (ok bit) (if ok bit 0))
    (let qwen (FGLUIQwenOwnerParent))
    (let three (FGLUIThreeBOwnerParent))
    (let older (gtm-pos "tokens.qwen38-q8.old" "1.2.99.1" "flow.owner" "tok-1" 5 (fgtm-absent) 50 (list "flow" "token-flow" "model.qwen38-q8")))
    (let flash (gtm-pos "tokens.qwen38-flash.position" qwen qwen "context-position" 10 (fgtm-present 7) 100 (list "memory" "token")))
    (let llama (gtm-pos "tokens.llama32-3b.position" three three "context-position" 20 (fgtm-present 0) 100 (list "memory" "token")))
    (let kat (gtm-pos "tokens.qwen38-q8.position" "1.2.99.2" "flow.owner" "tok-7" 30 (fgtm-absent) 200 (list "flow" "token-flow" "model.qwen38-q8")))
    (let noise (fgtm-sample "metric.other" (fgtm-absent) "metric" "form" "meter" "accounting" "other" (fgtm-absent) (fgtm-present 99) "active" (fgtm-present 1) (fgtm-present 1) (fgtm-absent) (fgtm-absent) "pinned" "physical-live" "form.meter" (list "share")))
    (let rows (fglui-owner-token-fallback-samples (list older flash llama kat noise)))
    (let text (fglui-owner-token-measure (list older flash llama kat noise)))
    (let gen (fgtm-sample "code.1.generated-ids" (fgtm-absent) "metric" "form" "qwen.coding" "generated-ids" "implement" (fgtm-absent) (fgtm-present 12) "active" (fgtm-present 3) (fgtm-present 4) (fgtm-absent) (fgtm-absent) "pinned" "physical-live" "form-cli-code" (list "qwen" "coding")))
    (let beside (fglui-owner-token-measure (list flash gen)))
    (sum (list
        (gtm-bit (eq (len rows) 3) 1)
        (gtm-bit (eq (fglui-owner-token-sum rows 0) 60) 2)
        (gtm-bit (str_eq text "T=60 qwen38-q8=30 qwen38-flash=10 llama32-3b=20") 4)
        (gtm-bit (eq (str_find text "qwen38-q8=30" 0) 5) 8)
        (gtm-bit (eq (str_find text "llama32-3b=20" 0) 34) 16)
        (gtm-bit (str_eq (fglui-owner-token-measure (list)) "") 32)
        (gtm-bit (and (str_eq (fglui-owner-token-measure (list gen)) "T=12 qwen.coding=12") (str_eq beside "T=10 qwen38-flash=10 gen=12 qwen.coding=12")) 64))))
