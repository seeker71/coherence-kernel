; Form-owned refusals execute before any model admission; bounded health
; controls correlate the withheld answer with the observed refusal.
; preludes: form-stdlib/bml/metal-ask-request.bml
; Verdict: 511
(do
 (defn mab-refused (text reason)
  (do (let got (mar-read text)) (and (eq (head got) 0) (str_eq (nth got 1) reason))))
 (defn mab-json ()
  (and (head (mar-read "{\"prompt\":\"hello\",\"max_tokens\":1,\"model\":\"llama3.2:3b\",\"blob\":\"/absent\",\"artifact\":\"answer\"}"))
   (and (mab-refused "{\"prompt\":\"hello\"" "request-json-invalid")
    (and (mab-refused "{\"prompt\":\"hello\",}" "request-json-invalid")
     (and (mab-refused "{\"prompt\":\"hello\"} trailing" "request-json-invalid")
      (and (mab-refused "[]" "request-object-required")
       (and (mab-refused "{\"prompt\":7}" "request-prompt-string-required")
        (and (mab-refused "{\"prompt\":\"hello\",\"model\":null}" "request-option-string-required")
         (and (mab-refused "{\"prompt\":\"hello\",\"blob\":[]}" "request-option-string-required")
          (and (mab-refused "{\"prompt\":\"hello\",\"artifact\":true}" "request-option-string-required")
           (and (mab-refused "{\"prompt\":\"hello\",\"max_tokens\":\"1\"}" "request-token-cap-integer-required")
            (and (mab-refused "{\"prompt\":\"hello\",\"max_tokens\":1.0}" "request-token-cap-integer-required")
             (and (mab-refused "{\"prompt\":\"hello\",\"max_tokens\":true}" "request-token-cap-integer-required")
              (mab-refused "{\"prompt\":\"one\",\"prompt\":\"two\"}" "request-duplicate-field"))))))))))))))
 (let before (metal_live))
 (let empty (ma-ask "/absent-model" (ma-model) "" 12))
 (let model (ma-ask "/absent-model" "different-model" "hello" 12))
 (let cap (ma-ask "/absent-model" (ma-model) "hello" 0))
 (let absent (ma-ask "/absent-model" (ma-model) "hello" 12))
 (let json (mab-json))
 (let after (metal_live))
 (sum (list
  (if (str_eq (record_get empty "reason") "empty-prompt") 1 0)
  (if (str_eq (record_get model "reason") "model-not-admitted") 2 0)
  (if (str_eq (record_get cap "reason") "positive-integer-token-cap-required") 4 0)
  (if (str_eq (record_get absent "reason") "model-file-absent") 8 0)
  (if (and (eq (nth before 2) (nth after 2)) (eq (nth before 3) (nth after 3))) 16 0)
  (if (and (oh-valid (record_get absent "health")) (str_eq (oh-select (record_get absent "health") (record_get absent "health-response") "other") "abstain")) 32 0)
  (if (str_eq (oh-str (record_get absent "health-applied") "stage") "applied") 64 0)
  (if (and (eq (record_get absent "ok") 0) (eq (str_len (record_get absent "text")) 0)) 128 0)
  (if json 256 0))))
