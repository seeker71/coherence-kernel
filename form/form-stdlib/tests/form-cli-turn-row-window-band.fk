; Complete physical rows survive a slice boundary; the cap still refuses.
; preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-turn-row-window.bml
(do
 (defn fctrb-bit (yes bit) (if yes bit 0))
 (let part (fctr-piece 100 "abcd" "ef" 12))
 (let whole (fctr-piece 100 (nth part 1) "gh\nlater" 12))
 (sum (list
  (fctrb-bit (and (eq (head part) -2) (str_eq (nth part 1) "abcdef")) 1)
  (fctrb-bit (and (eq (head whole) 109) (str_eq (nth whole 1) "abcdefgh\n")) 2)
  (fctrb-bit (eq (head (fctr-piece 100 "abcd" "ef\nignored" 7)) 107) 4)
  (fctrb-bit (eq (head (fctr-piece 100 "abcd" "ef\n" 6)) -1) 8)
  (fctrb-bit (eq (head (fctr-piece 100 "abcd" "efgh" 7)) -1) 16)
  (fctrb-bit (and (eq (head (fctr-piece 100 "abcd" "" 8)) -1) (eq (head (fctr-piece 100 "abcd" (nothing) 8)) -1)) 32)
  (fctrb-bit (eq (fctr-row-limit 2097152) 8388608) 64))))
