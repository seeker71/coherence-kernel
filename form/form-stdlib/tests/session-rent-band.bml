; session-rent-band.bml — one session read three ways agrees, and its local tokens include the lane it began.
; preludes: form-stdlib/bml/session-rent.bml form-stdlib/bml/form-cli-turn-meter.bml form-stdlib/bml/form-cli-flow-meter.bml
; Verdict 63
;
; A scratch session: a transcript with two askings, one subagent transcript opened inside the first and one,
; two directories deep, inside the second. Each provider message carries its usage once per request id; the
; first spans two rows, as a message with two content blocks does. Two scratch checkouts hold native-turn
; ledgers that share one row.
;     1  session-rent, the turn meter and the flow meter read the same requests, output and total
;     2  the turn meter credits each subagent to the asking that opened it, shown apart in that turn's row
;     4  the flow row says how much came from subagents
;     8  rows where turns run: both checkouts, one row per at+gap+option, in time order, each tagged
;    16  the session's local tokens add the lane options it began; the share counts them
;    32  the schedule names the walk checkout; a plist without one names none
section [form.bml] {
 class SessionRentBand {
  def srb-claim(ok, bit) = if ok then bit else 0;
  def srb-user(content, ts) = "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":\"" ++ content ++ "\"},\"timestamp\":\"" ++ ts ++ "\"}\n";
  def srb-assistant(id, req, inp, cw, cr, out, ts, tool) = "{\"message\":{\"id\":\"" ++ id ++ "\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[" ++ tool ++ "],\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":" ++ inp.str() ++ ",\"cache_creation_input_tokens\":" ++ cw.str() ++ ",\"cache_read_input_tokens\":" ++ cr.str() ++ ",\"output_tokens\":" ++ out.str() ++ "}},\"requestId\":\"" ++ req ++ "\",\"type\":\"assistant\",\"timestamp\":\"" ++ ts ++ "\"}\n";
  def srb-bash() = "{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"Bash\",\"input\":{\"command\":\"./fkwu observe/local-flow-review.bml\"}}";
  def srb-turn-row(at, gap, option, session, gen, inj) = "{\"at_unix_ms\":" ++ at.str() ++ ",\"gap\":\"" ++ gap ++ "\",\"option\":" ++ option.str() ++ ",\"session\":\"" ++ session ++ "\",\"local_generated_ids\":" ++ gen.str() ++ ",\"local_injected_ids\":" ++ inj.str() ++ "}\n";
  def srb-get(doc, key) = fcgp-num(doc, key) ?? (0 - 1);
  def srb-score(dir) {
   let main = dir ++ "/sess.jsonl";
   let m1 = fs_mkdir(dir ++ "/sess");
   let m2 = fs_mkdir(dir ++ "/sess/subagents");
   let m3 = fs_mkdir(dir ++ "/sess/subagents/workflows");
   let m4 = fs_mkdir(dir ++ "/sess/subagents/workflows/wf_x");
   let w1 = write_file_text(main, srb-user("first asking", "2026-10-01T07:00:00.000Z") ++ srb-assistant("msg_a1", "req_a1", 3, 100, 1000, 50, "2026-10-01T07:00:05.000Z", "") ++ srb-assistant("msg_a1", "req_a1", 3, 100, 1000, 50, "2026-10-01T07:00:05.000Z", "") ++ srb-user("second asking", "2026-10-01T08:00:00.000Z") ++ srb-assistant("msg_a2", "req_a2", 2, 10, 2000, 70, "2026-10-01T08:00:09.000Z", srb-bash()));
   let w2 = write_file_text(dir ++ "/sess/subagents/agent-1.jsonl", srb-user("a subagent task", "2026-10-01T07:30:00.000Z") ++ srb-assistant("msg_s1", "req_s1", 1, 5, 500, 30, "2026-10-01T07:30:04.000Z", ""));
   let w3 = write_file_text(dir ++ "/sess/subagents/workflows/wf_x/agent-2.jsonl", srb-user("a workflow task", "2026-10-01T08:30:00.000Z") ++ srb-assistant("msg_s2", "req_s2", 4, 20, 300, 40, "2026-10-01T08:30:04.000Z", ""));
   let w4 = write_file_text(dir ++ "/sess/subagents/agent-1.meta.json", "{\"agentType\":\"fixture\"}");
   let files = sr-files(main);
   let rented = sr-rented(files, [0, 0, 0, 0, 0], rtm-seen-none());
   let turn = ftm-reading(main);
   let flow = fm-reading(main, "")[0];
   let c1 = srb-claim(((Comparable) len(files) == 3) && ((Comparable) rented[4] == 4) && ((Comparable) rented[3] == 190) && ((Comparable) srb-get(turn, "provider_messages") == 4) && ((Comparable) srb-get(turn, "output") == 190) && ((Comparable) srb-get(flow, "provider_turns") == 4) && ((Comparable) srb-get(flow, "output_tokens") == 190) && ((Comparable) srb-get(turn, "total") == (rented[0] + (rented[1] + (rented[2] + rented[3])))) && ((Comparable) srb-get(flow, "tokens_total") == srb-get(turn, "total")) && ((Comparable) srb-get(turn, "total") == 4135), 1);
   let per = json-array-elements(json-object-get(turn, "per_turn"));
   let c2 = srb-claim(((Comparable) len(per) == 2) && ((Comparable) srb-get(per[0], "output") == 80) && ((Comparable) srb-get(per[0], "subagent_output") == 30) && ((Comparable) srb-get(per[0], "subagent_transcripts") == 1) && ((Comparable) srb-get(per[1], "output") == 110) && ((Comparable) srb-get(per[1], "subagent_output") == 40) && ((Comparable) srb-get(turn, "subagent_output") == 70) && ((Comparable) len(ftm-turns(fhn-read(main))) == 2), 2);
   let c3 = srb-claim(((Comparable) srb-get(flow, "transcripts") == 3) && ((Comparable) srb-get(flow, "subagent_provider_turns") == 2) && ((Comparable) srb-get(flow, "subagent_output_tokens") == 70) && ((Comparable) srb-get(flow, "native_fkwu_calls") == 1), 4);
   let a = dir ++ "/a";
   let b = dir ++ "/b";
   let ma = fs_mkdir(a);
   let mb = fs_mkdir(b);
   let mra = fs_mkdir(a ++ "/receipts");
   let mrb = fs_mkdir(b ++ "/receipts");
   let la = write_file_text(a ++ "/" ++ sr-turn-ledger(), srb-turn-row(100, "g1", 1, "sess", 300, 1000) ++ srb-turn-row(300, "g1", 2, "other", 50, 60));
   let lb = write_file_text(b ++ "/" ++ sr-turn-ledger(), srb-turn-row(100, "g1", 1, "sess", 300, 1000) ++ srb-turn-row(200, "g2", 1, "sess", 400, 2000) ++ srb-turn-row(400, "g1", 3, "other", 70, 80));
   let rows = sr-turn-rows-from([a, b]);
   let c4 = srb-claim(((Comparable) len(rows) == 4) && ((Value) map(r => srb-get(r, "at_unix_ms"), rows) == [100, 200, 300, 400]) && ((Value) map(r => fcgp-str(r, "checkout"), rows) == [a, b, a, b]), 8);
   let drafts = dir ++ "/draft-ledger.jsonl";
   let wd = write_file_text(drafts, "{\"session\":\"sess\",\"generated\":100}\n{\"session\":\"else\",\"generated\":900}\n");
   let lane = sr-lane("sess", rows);
   let row = parse-json("rent", sr-row-with(main, drafts, rows));
   let local = fcgp-obj(row, "local");
   let c5 = srb-claim(((Value) lane == [2, 700, 3000]) && ((Comparable) srb-get(local, "drafts") == 1) && ((Comparable) srb-get(local, "generated") == 100) && ((Comparable) srb-get(local, "lane_options") == 2) && ((Comparable) srb-get(local, "lane_generated") == 700) && ((Comparable) srb-get(local, "lane_injected") == 3000) && ((Comparable) srb-get(row, "local_share_ppm") == 808080) && ((String) fcgp-str(row, "session") == "sess"), 16);
   let c6 = srb-claim(((String) sr-plist-dir("<dict><key>WorkingDirectory</key><string>/x/walk</string></dict>") == "/x/walk") && ((String) sr-plist-dir("<dict><key>Label</key><string>x</string></dict>") == ""), 32);
   print_str("session-rent-band claims " ++ c1.str() ++ " " ++ c2.str() ++ " " ++ c3.str() ++ " " ++ c4.str() ++ " " ++ c5.str() ++ " " ++ c6.str());
   c1 + c2 + c3 + c4 + c5 + c6;
  }
  def srb-run() {
   let dir = temp_dir() ++ "/session-rent-band-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str();
   let made = fs_mkdir(dir);
   let score = srb-score(dir);
   let gone = fs_rmdir(dir);
   score;
  }
 }
 srb-run();
}
