; hearth-home-band.bml — the hearth's home over every .git shape a checkout of this body meets (hearth.bml, hearth-home-root-of).
;
; A checkout shares the hearth of its repository's main worktree. A main worktree's .git is a directory, and it keeps its own. A
; linked worktree's .git file names <main>/.git/worktrees/<name>, and it shares <main>'s. A submodule's .git file names a module
; directory inside its superproject's .git (<super>/.git/modules/<name>, or <super>/.git/worktrees/<w>/modules/<name> when the
; superproject checkout is itself a linked worktree): that directory is the submodule's own repository, so the submodule keeps its
; own hearth, and a kernel lodged as the form submodule of an application worktree never resolves into the application's primary
; checkout. The texts are the shapes git writes, at neutral places (the person's places are read, never spelled here). Nothing is
; written; the one read is of a directory, the checkout's own root, as a main worktree's .git is one.
;
; Expected: 63
; Verdict 63 when every claim lands:
;   1   a main worktree (the seed's shape): a .git directory reads as no text, and nothing keeps this checkout
;   2   a linked worktree of the kernel (the walk checkout's shape): "gitdir: /r/kernel/.git/worktrees/walk" shares /r/kernel
;   4   the form submodule of an application's linked worktree (this checkout's shape), relative and absolute:
;       "gitdir: ../../../../.git/worktrees/w/modules/form" and "gitdir: /r/app/.git/worktrees/w/modules/form" keep this checkout
;   8   a submodule of a main checkout: "gitdir: ../.git/modules/form" keeps this checkout
;  16   a linked worktree of an application: "gitdir: /r/app/.git/worktrees/w" shares /r/app
;  32   the word modules outside the module mark moves nothing: a main checkout at /r/modules/k with a worktree named modules
;       ("gitdir: /r/modules/k/.git/worktrees/modules") shares /r/modules/k
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/hearth.bml
section [form.bml] {
 class HearthHomeBand {
  def hhb-root(text) = hearth-home-root-of(text);
  def hhb-here?(text) = (String) hhb-root(text) == host_cwd();
  def hhb-c-main(ctx) = hhb-here?(read_file(".")) && hhb-here?(nothing());
  def hhb-c-walk(ctx) = (String) hhb-root("gitdir: /r/kernel/.git/worktrees/walk\n") == "/r/kernel";
  def hhb-c-app-submodule(ctx) = hhb-here?("gitdir: ../../../../.git/worktrees/w/modules/form\n") && hhb-here?("gitdir: /r/app/.git/worktrees/w/modules/form\n");
  def hhb-c-main-submodule(ctx) = hhb-here?("gitdir: ../.git/modules/form\n");
  def hhb-c-app-linked(ctx) = (String) hhb-root("gitdir: /r/app/.git/worktrees/w\n") == "/r/app";
  def hhb-c-modules-word(ctx) = (String) hhb-root("gitdir: /r/modules/k/.git/worktrees/modules\n") == "/r/modules/k";
 }
 live-claims("hearth-home-band", 0, [["main", 1, 1, hhb-c-main], ["walk", 2, 1, hhb-c-walk], ["app-submodule", 4, 1, hhb-c-app-submodule], ["main-submodule", 8, 1, hhb-c-main-submodule], ["app-linked", 16, 1, hhb-c-app-linked], ["modules-word", 32, 1, hhb-c-modules-word]]);
}
