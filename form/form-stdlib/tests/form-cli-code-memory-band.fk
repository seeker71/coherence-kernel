; Native binary checkpoints, exact contract binding and verified lesson reuse.
; Private process-scoped temp directory; no model or live Glass publication.
; Expected 65535.
; preludes: form-stdlib/bml/form-cli-code-repair-fixture.bml
(do
 (defn fcmb-bit (ok bit) (if ok bit 0))
 (let root (str_concat "/tmp/form-code-memory-band-" (int_to_str (host_pid))))
 (let initial (fcap-open (fcrf-goal) (fcrf-docs) (list "calc.form")))
 (let checks (json-emit (json-node-array (fcrf-contract))))
 (let first (fcam-prepare root initial checks "" (fcrf-checker)))
 (let failed (fcam-with (fcrf-failure) (fcam-context first)))
 (let saved (fcam-save failed))
 (let restored (fcam-prepare root initial checks (fcam-id failed) (fcrf-checker)))
 (let repair (fcap-step restored "{\"diagnosis\":\"At zero the constant is wrong and the square is absent\",\"change\":\"Use add(add(mul(x,x),x),1); check zero and negative inputs\",\"next\":\"implement\"}" (fcrf-checker)))
 (let edited (fcap-step repair "{\"tool\":\"edit\",\"arguments\":[\"calc.form\",\"add(x,2)\",\"add(add(mul(x,x),x),1)\"]}" (fcrf-checker)))
 (let reviewed (fcap-step edited "{\"task\":\"done\"}" (fcrf-checker)))
 (let done (fcap-step reviewed "{\"verdict\":\"accept\"}" (fcrf-checker)))
 (let learned (fcam-learn done))
 (let recalled (fcam-prepare root initial checks "" (fcrf-checker)))
 (let mismatch (fcam-prepare root initial "[]" (fcam-id first) (fcrf-checker)))
 (let other (fcam-prepare root (fcap-open "another task" (fcrf-docs) (list "calc.form")) checks "" (fcrf-checker)))
 (let encoded (fcam-pack (list "λ\n\"" -9 (list 0 "nested" (list)))))
 (let decoded (fcam-unpack (bytes_to_recipe (recipe_to_bytes encoded))))
 (let packet (fcam-packet done "lesson"))
 (let corrupt (json-node-object (list (json-node-pair "schema" (json-node-string "form-code-continuity-v1")) (json-node-pair "kind" (json-node-string "lesson")) (json-node-pair "digest" (json-node-string "bad")) (json-node-pair "payload" (json-object-get packet "payload")))))
 (let writebad (fcam-write (str_concat root "/missing-parent/checkpoint") packet))
 (let completedSaved (fcam-save done))
 (let completed (fcam-prepare root initial checks (fcam-id done) (fcrf-checker)))
 (let verdict (sum (list
  (fcmb-bit (and saved (value_eq failed restored)) 1)
  (fcmb-bit (and (str_eq (fcap-stage done) "complete") (eq (fcap-checks done) 2)) 2)
  (fcmb-bit (and learned (eq (fcam-hits recalled) 1)) 4)
  (fcmb-bit (and (eq (fcap-failures recalled) 0) (value_eq (fcap-docs recalled) (fcrf-docs))) 8)
  (fcmb-bit (ge (str_find (fcap-bootstrap recalled) "square is absent" 0) 0) 16)
  (fcmb-bit (str_eq (fcap-stage mismatch) "attention") 32)
  (fcmb-bit (eq (fcam-hits other) 0) 64)
  (fcmb-bit (value_eq decoded (list "λ\n\"" -9 (list 0 "nested" (list)))) 128)
  (fcmb-bit (not (fcam-packet-valid corrupt "lesson" (fcam-contract done))) 256)
  (fcmb-bit (and (not (fcam-id-valid "../other")) (fcam-id-valid (fcam-id done))) 512)
  (fcmb-bit (and (eq writebad 0) (fcam-packet-valid (fcam-read (fcam-path root (fcam-id first) "checkpoint")) "checkpoint" (fcam-contract first))) 1024)
  (fcmb-bit (and completedSaved (str_eq (fcap-stage completed) "complete")) 2048)
  (fcmb-bit (value_eq (nth done 4) (nth initial 4)) 4096)
  (fcmb-bit (ge (str_find (fcap-bootstrap restored) (nth restored 7) 0) 0) 8192)
  (fcmb-bit (and (fcam-managed repair) (fcam-managed edited)) 16384)
  (fcmb-bit (and (not (fcam-packet-valid packet "checkpoint" (fcam-contract done))) (eq (fcam-hits (fcam-recall-packet first corrupt (fcrf-checker))) 0)) 32768))))
 (let clean1 (fs-remove-file (fcam-path root (fcam-id first) "checkpoint")))
 (let clean2 (fs-remove-file (fcam-path root (fcam-hash (fcam-contract first)) "lesson")))
 verdict)
