; field-band.fk — one field, one word: shared nodes are not copied per process.
;
; A child process interns the composite ("field-band" 40 "two" 2.5) and hands over
; its pid and the raw word. This process interns the same composite from its own
; private strings and floats and gets the SAME word -- the field's content-addressed
; intern found the child's cell -- and the field's node count does not move. The
; float node's value reads the same through the kernel and through the field reader.
;
; Expected: 255
; preludes: form/form-stdlib/form-glass-gift-frame.bml

(do
    (defn fb-bit (ok bit) (if ok bit 0))
    (let stale (ggf-offer "field-band.child" 4096))
    (let cleared (node_gift_write stale (list)))
    (let releasedStale (ggf-release stale))
    (let child (host_spawn_quiet (list "./fkwu" "form/form-stdlib/tests/field-child.fk")))
    (let waited (host_wait child))
    (let handle (ggf-receive "field-band.child"))
    (let frame (if (nothing? handle) (list) (node_gift_read handle)))
    (let released (ggf-release handle))
    (let childWord (if (eq (len frame) 3) (nth frame 1) 0))
    (let before (kernel_stat 4))
    (let mine (intern_node (intern_trivial_string "field-band") (list (intern_trivial_int 40) (intern_trivial_string "two") 2.5)))
    (let after (kernel_stat 4))
    (let me (cell_map 0))
    (let live (kernel_live (host_pid)))
    (let fn (intern_trivial_float "3.25"))
    (let b0 (fb-bit (and (eq (len frame) 3) (gt (nth frame 0) 0)) 1))
    (let b1 (fb-bit (eq childWord (cell_ref mine)) 2))
    (let b2 (fb-bit (eq before after) 4))
    (let b3 (fb-bit (and (eq (node_value (head (node_children mine))) 40) (str_eq (node_value (head (tail (node_children mine)))) "two")) 8))
    (let b4 (fb-bit (eq (head (tail (tail (node_children mine)))) 2.5) 16))
    (let b5 (fb-bit (and (eq (node_value fn) 3.25) (eq (cell_value me (cell_field me (cell_ref fn) 3)) 3.25)) 32))
    (let b6 (fb-bit (and (ge (len live) 24) (eq (nth live 22) 2)) 64))
    (let b7 (fb-bit (and (eq (cell_field me childWord 0) 2) (str_eq (cell_value me (cell_field me (cell_field me childWord 1) 3)) "field-band")) 128))
    (print (list "field-band" "child-word" childWord "my-word" (cell_ref mine) "field-nodes" before after "store" (if (ge (len live) 24) (nth live 22) -1)))
    (add b0 (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 b7))))))))
