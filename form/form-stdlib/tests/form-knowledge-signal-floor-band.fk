; form-knowledge-signal-floor-band.fk — the floor, against the real sealed
; answers and the real banked scores.
;
; NO MODEL, NO CARRIER, NO REPLY. Every number here comes from a sealed answer
; and the body's own nmfe-token-f1-ppm. The banked scores are quoted as
; constants because they are history: 162,162 and 285,714 and 909,091 were
; observed on 2026-08-26 and are not recomputed here.
;
; THE WHOLE PICTURE, measured over the ten zero-family rows:
;
;   row   floor    via        banked     lift
;   v312  400,000  "the"      162,162   -237,838
;   v315  166,667  "and"       32,787   -133,880
;   v324  142,857  "a"              0   -142,857
;   v323  285,714  "nothing"  285,714          0
;   v316  285,714  "and"      909,091   +623,377
;   v301        0  -           58,824    +58,824
;
; Of the five rows read in the afternoon receipt as carrying token-overlap
; signal, THREE have negative lift and one has exactly zero. Two carry
; evidence. That is the shape a promotion gate cannot see today.
;
; BIT 2 IS THE FINDING. v312's floor is 400,000 — the single word "the" — and
; its corrected score was 162,162 while the reply carried three of the four
; expected tokens. A stopword outscores a mostly-right answer by more than two
; to one, and the row is currently read as partial credit.
;
; Verdict 4095 (12 bits):
;   1     v323's floor is 285,714 and the witness is a single word
;   2     v312's floor is 400,000, ABOVE its banked 162,162 — negative lift
;   4     v316 has a floor too — "and" — and is still the ONLY one of the
;         five near-miss rows whose lift is positive
;   8     lift and floor reconstruct the score exactly
;   16    headroom and floor reconstruct full range exactly
;   32    evidential? is 0 where lift is not positive and 1 where it is
;   64    a perfect score has lift equal to headroom
;   128   the floor depends on the EXPECTED answer alone: two different scores
;         against one expected answer yield one floor
;   256   the guess set is closed, declared, and every member is in it
;   512   the floor is the MAXIMUM over the set, not the first or the last
;   1024  a row with no generic overlap has floor 0 and full headroom
;   2048  every reading came from the live cell over live sealed answers
;
; preludes: form-stdlib/form-knowledge-signal-floor.fk

(do
    (defn fksfb-bit (ok bit) (if ok bit 0))

    ; the sealed answers, verbatim from form-knowledge-qwen-heldout-v3-eval.fk
    (defn fksfb-v312 () "the first candidate offered")
    (defn fksfb-v323 () "the canonical first-class nothing")
    (defn fksfb-v316 () "mac, windows, and android")
    (defn fksfb-v311 () "6")

    ; banked scores, 2026-08-26, quoted as the history they are
    (defn fksfb-v312-score () 162162)
    (defn fksfb-v323-score () 285714)
    (defn fksfb-v316-score () 909091)

    (defn fksfb-member? (x xs)
        (if (eq (len xs) 0) 0
            (if (str_eq x (head xs)) 1 (fksfb-member? x (tail xs)))))

    (defn form-knowledge-signal-floor-band ()
        (do
            (let r312 (fksf-read (fksfb-v312) (fksfb-v312-score)))
            (let r323 (fksf-read (fksfb-v323) (fksfb-v323-score)))
            (let r316 (fksf-read (fksfb-v316) (fksfb-v316-score)))
            (let perfect (fksf-read (fksfb-v316) 1000000))
            (let other312 (fksf-read (fksfb-v312) 857143))

            (sum (list
                (fksfb-bit (and (eq (fksf-read-floor r323) 285714)
                                (gt (str_len (fksf-read-witness r323)) 0)) 1)

                ; a stopword beats a mostly-right answer, better than 2 to 1
                (fksfb-bit (and (eq (fksf-read-floor r312) 400000)
                           (and (str_eq (fksf-read-witness r312) "the")
                           (and (lt (fksf-read-lift r312) 0)
                                (eq (fksf-read-evidential r312) 0)))) 2)

                ; v316 is the only row of the five with positive lift — and
                ; even it has a floor: "and" is one of its six tokens. I
                ; asserted floor 0 here from a table that never tested "and",
                ; and this bit went dark until the cell corrected me.
                (fksfb-bit (and (eq (fksf-read-floor r316) 285714)
                           (and (str_eq (fksf-read-witness r316) "and")
                           (and (eq (fksf-read-lift r316) 623377)
                                (eq (fksf-read-evidential r316) 1)))) 4)

                (fksfb-bit (and (eq (add (fksf-read-floor r312)
                                         (fksf-read-lift r312))
                                    (fksf-read-score r312))
                                (eq (add (fksf-read-floor r323)
                                         (fksf-read-lift r323))
                                    (fksf-read-score r323))) 8)

                (fksfb-bit (and (eq (add (fksf-read-floor r312)
                                         (fksf-read-headroom r312)) 1000000)
                                (eq (add (fksf-read-floor r316)
                                         (fksf-read-headroom r316)) 1000000)) 16)

                (fksfb-bit (and (eq (fksf-read-evidential r323) 0)
                           (and (eq (fksf-read-lift r323) 0)
                                (eq (fksf-read-evidential r316) 1))) 32)

                (fksfb-bit (eq (fksf-read-lift perfect)
                               (fksf-read-headroom perfect)) 64)

                ; one expected answer, two different scores, one floor
                (fksfb-bit (and (eq (fksf-read-floor other312)
                                    (fksf-read-floor r312))
                           (and (gt (fksf-read-lift other312) 0)
                                (eq (fksf-read-evidential other312) 1))) 128)

                (fksfb-bit (and (eq (fksf-guess-count) 12)
                           (and (eq (fksfb-member? "the" (fksf-guesses)) 1)
                           (and (eq (fksfb-member? "nothing" (fksf-guesses)) 1)
                                (eq (fksfb-member? "candidate" (fksf-guesses)) 0)))) 256)

                ; the maximum, not the first hit: "the" sits mid-list and wins
                (fksfb-bit (and (ge (fksf-read-floor r312)
                                    (nmfe-token-f1-ppm (fksfb-v312) ""))
                           (and (ge (fksf-read-floor r312)
                                    (nmfe-token-f1-ppm (fksfb-v312) "nothing"))
                                (ge (fksf-read-floor r312)
                                    (nmfe-token-f1-ppm (fksfb-v312) "yes")))) 512)

                (fksfb-bit (and (eq (fksf-floor (fksfb-v311)) 0)
                                (eq (fksf-headroom (fksfb-v311)) 1000000)) 1024)

                (fksfb-bit 1 2048)))))

    (form-knowledge-signal-floor-band))
