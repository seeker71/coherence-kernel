; End-to-end native session admission on four real prompt tokens.
;
; preludes: native/metal/dsv4-native-session.fk form-stdlib/dsv4-generation-request.fk config/dsv4-local-resource.fk

(do
    (let ids (dns-generate-ids (list 0 3476 477 22651) 1))
    (let src (tkz-src (dsv4-local-model-resource)))
    (print_str (str_concat "NATIVE result-token-ids=" (dgr-ids-csv ids)))
    (print_str (str_concat "NATIVE result-text=" (tkz-decode-text src ids)))
    0)
