; q8-0-matvec-tg-band.fk — the cooperative twins answer to their attestants bit for bit, on real
; weights: form_q80_matvec_tg_f32 against form_q80_matvec_f32 over llama3.2:1b's first Q8_0
; projection with a fixed input (byte equality of the read-back, not an epsilon), and
; the cooperative rmsnorm is NOT exact (it parts from the attestant at element 4) and so is not dispatched;
; the band prints where it parts. Twenty dispatches of each matvec timed.
; Expected: 1
; PROOF LEVEL: FOURTH-ARM ONLY (metal handle door)
; preludes: native/metal/dense-token-handle.fk form-stdlib/model-registry.bml
(do
    (defn qb-f32s (n i acc) (if (ge i n) acc (qb-f32s n (add i 1) (str_concat acc (md-le32 (md-f32-bits (div (str_to_float (int_to_str (sub (mod (mul i 7919) 2000) 1000))) 1000.0)))))))
    (defn qb-q8 (views) (if (eq (len views) 0) (list) (if (eq (dth-tv-ty (head views)) 8) (head views) (qb-q8 (tail views)))))
    (defn qb-shape (views) (if (eq (len views) 0) "" (str_concat (int_to_str (dth-tv-ty (head views))) (str_concat ":" (str_concat (int_to_str (dth-tv-r (head views))) (str_concat "x" (str_concat (int_to_str (dth-tv-c (head views))) (str_concat " " (qb-shape (tail views))))))))))
    (defn qb-n (ps pipe bind threads n) (if (le n 0) 0 (do (let e (metal_enqueue pipe bind threads)) (qb-n ps pipe bind threads (sub n 1)))))
    (defn qb-first-diff (a b i n) (if (ge i n) (sub 0 1) (if (eq (str_byte_at a i) (str_byte_at b i)) (qb-first-diff a b (add i 1) n) i)))
    (let st (dth-open (mr-path (mr-find "llama32-1b")) 256 (sub 0 1)))
    (let ps (nth st 0)) (let lays (nth st 3))
    (let layer (head lays))
    (print_str (str_concat "layer views ty:rows x cols = " (qb-shape layer)))
    (let tv (qb-q8 layer))
    (let rows (dth-tv-r tv)) (let cols (dth-tv-c tv))
    (let xh (metal_buf_alloc (mul 4 cols)))
    (let w (metal_buf_write xh 0 (qb-f32s cols 0 "")))
    (let ya (metal_buf_alloc (mul 4 rows))) (let yb (metal_buf_alloc (mul 4 rows)))
    (let t0 (now_unix_ms))
    (let a (qb-n ps (nth ps 2) (md-bind (list (dth-tv-h tv) xh ya) (list rows cols)) rows 20))
    (let s0 (metal_sync))
    (let t1 (now_unix_ms))
    (let b (qb-n ps (nth ps 23) (md-bind16 (list (dth-tv-h tv) xh yb) (list rows cols) 32 0 1 0) rows 20))
    (let s1 (metal_sync))
    (let t2 (now_unix_ms))
    (let ra (metal_buf_read ya 0 (mul 4 rows))) (let rb (metal_buf_read yb 0 (mul 4 rows)))
    (let c1 (if (and (eq (str_len ra) (mul 4 rows)) (str_eq ra rb)) 1 0))
    (let gh (dth-tv-h (head layer)))
    (let na (metal_buf_alloc (mul 4 cols))) (let nb (metal_buf_alloc (mul 4 cols)))
    (let epsBits (md-f32-bits 0.00001))
    (let r1 (metal_enqueue (nth ps 6) (md-bind (list xh gh na) (list cols epsBits)) 1))
    (let r2 (metal_enqueue (nth ps 24) (md-bind16 (list xh gh nb) (list cols epsBits) 256 0 1 0) 1))
    (let s2 (metal_sync))
    (let qa (metal_buf_read na 0 (mul 4 cols))) (let qb (metal_buf_read nb 0 (mul 4 cols)))
    (let c2 0)
    (print_str (str_concat "q8 view type=" (str_concat (int_to_str (dth-tv-ty tv)) (str_concat " rows=" (str_concat (int_to_str rows) (str_concat " cols=" (str_concat (int_to_str cols) (str_concat " 20 attestant matvecs " (str_concat (int_to_str (sub t1 t0)) (str_concat " ms, 20 twin matvecs " (str_concat (int_to_str (sub t2 t1)) (str_concat " ms; matvec first differing byte=" (str_concat (int_to_str (qb-first-diff ra rb 0 (str_len ra))) (str_concat " rmsnorm first differing byte=" (int_to_str (qb-first-diff qa qb 0 (str_len qa)))))))))))))))))
    (print (add c1 c2)))
