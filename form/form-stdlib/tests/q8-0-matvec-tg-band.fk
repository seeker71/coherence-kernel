; q8-0-matvec-tg-band.fk — the cooperative twins answer to their attestants bit for bit, on real
; weights (llama3.2:1b's first Q8_0 projection, a fixed input, byte equality of the read-back):
; bit 1 form_q80_matvec_tg_f32, bit 2 form_q80_matvec_tg2_f32 (each block read once), and of the two
; candidate rmsnorm twins bit 4 for A (the attestant's own statements) or bit 8 for B (an fma fold)
; — exactly one of them can be the attestant's compiled arithmetic; bit 16 form_q80_matvec_tg3_f32, the
; double-buffered twin (two simdgroups a row). Forty dispatches of each timed.
; Expected: 27
; PROOF LEVEL: FOURTH-ARM ONLY (metal handle door)
; preludes: native/metal/dense-token-handle.fk form-stdlib/model-registry.bml
(do
    (defn qb-f32s (n i acc) (if (ge i n) acc (qb-f32s n (add i 1) (str_concat acc (md-le32 (md-f32-bits (div (str_to_float (int_to_str (sub (mod (mul i 7919) 2000) 1000))) 1000.0)))))))
    (defn qb-q8 (views) (if (eq (len views) 0) (list) (if (eq (dth-tv-ty (head views)) 8) (head views) (qb-q8 (tail views)))))
    (defn qb-n (pipe bind threads n) (if (le n 0) 0 (do (let e (metal_enqueue pipe bind threads)) (qb-n pipe bind threads (sub n 1)))))
    (defn qb-same? (a b n) (if (and (eq (str_len a) n) (str_eq a b)) 1 0))
    (let st (dth-open (mr-path (mr-find "llama32-1b")) 256 (sub 0 1)))
    (let ps (nth st 0)) (let layer (head (nth st 3)))
    (let tv (qb-q8 layer))
    (let rows (dth-tv-r tv)) (let cols (dth-tv-c tv))
    (let xh (metal_buf_alloc (mul 4 cols)))
    (let w (metal_buf_write xh 0 (qb-f32s cols 0 "")))
    (let ya (metal_buf_alloc (mul 4 rows))) (let yb (metal_buf_alloc (mul 4 rows))) (let yc (metal_buf_alloc (mul 4 rows)))
    (let t0 (now_unix_ms))
    (let a (qb-n (nth ps 2) (md-bind (list (dth-tv-h tv) xh ya) (list rows cols)) rows 40))
    (let s0 (metal_sync))
    (let t1 (now_unix_ms))
    (let b (qb-n (nth ps 23) (md-bind16 (list (dth-tv-h tv) xh yb) (list rows cols) 32 0 1 0) rows 40))
    (let s1 (metal_sync))
    (let t2 (now_unix_ms))
    (let c (qb-n (nth ps 25) (md-bind16 (list (dth-tv-h tv) xh yc) (list rows cols) 32 0 1 0) rows 40))
    (let s2 (metal_sync))
    (let t3 (now_unix_ms))
    (let ra (metal_buf_read ya 0 (mul 4 rows))) (let rb (metal_buf_read yb 0 (mul 4 rows))) (let rc (metal_buf_read yc 0 (mul 4 rows)))
    (let yd (metal_buf_alloc (mul 4 rows)))
    (let t4 (now_unix_ms))
    (let dd (qb-n (nth ps 28) (md-bind16 (list (dth-tv-h tv) xh yd) (list rows cols) 64 0 1 0) rows 40))
    (let s5 (metal_sync))
    (let t5 (now_unix_ms))
    (let rd (metal_buf_read yd 0 (mul 4 rows)))
    (let c1 (qb-same? ra rb (mul 4 rows)))
    (let c2 (mul 2 (qb-same? ra rc (mul 4 rows))))
    (let c5 (mul 16 (qb-same? ra rd (mul 4 rows))))
    (print_str (str_concat "40 twin3 (double-buffered) ms=" (int_to_str (sub t5 t4))))
    (let gh (dth-tv-h (head layer)))
    (let na (metal_buf_alloc (mul 4 cols))) (let nb (metal_buf_alloc (mul 4 cols))) (let nc (metal_buf_alloc (mul 4 cols)))
    (let epsBits (md-f32-bits 0.00001))
    (let u0 (now_unix_ms))
    (let r1 (qb-n (nth ps 6) (md-bind (list xh gh na) (list cols epsBits)) 1 40))
    (let s3 (metal_sync))
    (let u1 (now_unix_ms))
    (let r2 (qb-n (nth ps 26) (md-bind16 (list xh gh nb) (list cols epsBits) 256 0 1 0) 1 40))
    (let r3 (qb-n (nth ps 27) (md-bind16 (list xh gh nc) (list cols epsBits) 256 0 1 0) 1 40))
    (let s4 (metal_sync))
    (let u2 (now_unix_ms))
    (let qa (metal_buf_read na 0 (mul 4 cols))) (let qb (metal_buf_read nb 0 (mul 4 cols))) (let qc (metal_buf_read nc 0 (mul 4 cols)))
    (let c3 (mul 4 (qb-same? qa qb (mul 4 cols))))
    (let c4 (mul 8 (qb-same? qa qc (mul 4 cols))))
    (print_str (str_concat "q8 " (str_concat (int_to_str rows) (str_concat "x" (str_concat (int_to_str cols) (str_concat ": 40 attestant " (str_concat (int_to_str (sub t1 t0)) (str_concat " ms, 40 twin " (str_concat (int_to_str (sub t2 t1)) (str_concat " ms, 40 twin2 " (str_concat (int_to_str (sub t3 t2)) (str_concat " ms | rmsnorm 40 attestant " (str_concat (int_to_str (sub u1 u0)) (str_concat " ms, 40 A + 40 B " (str_concat (int_to_str (sub u2 u1)) " ms")))))))))))))))
    (print (add c1 (add c2 (add c3 (add c4 c5))))))
