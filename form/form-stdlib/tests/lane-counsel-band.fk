; lane-counsel-band.fk — the counsel judges purely: values judged
; through the one scale, kvpct derived from the shared maxpos, deltas
; against the previous reading, worst lane's stone named, good lanes
; carry no advice.
; Expected: 2047
; preludes: form-stdlib/lane-counsel.bml
(do
    (defn lcb-bit (ok bit) (if ok bit 0))
    (let s "lastms=31000\ntpot=505\np95=45000\nkvpos=2780\nhopper=0\nicemiss=0\nfails=0\ntouts=0\n")
    (let p "lastms=33000\ntpot=1327\np95=44000\nkvpos=2124\nhopper=0\nicemiss=0\nfails=0\ntouts=0\n")
    (let absent "alive=0\nlastms=0\ntpot=0\np95=0\nkvpos=0\nhopper=0\nicemiss=0\nfails=0\ntouts=0\nadmit=0\nerrs=0\ndegraded=0\norphans=0\n")
    (sum (list
        (lcb-bit (str_eq (lc-verdict s (lc-row "lastms" 1000 30000 "")) "bad") 1)
        (lcb-bit (str_eq (lc-verdict s (lc-row "tpot" 800 2000 "")) "good") 2)
        (lcb-bit (eq (lc-val s "kvpct") (div (mul 2780 100) 4096)) 4)
        (lcb-bit (str_eq (lc-delta-of s p "lastms") "improving") 8)
        (lcb-bit (str_eq (lc-delta-of s "" "lastms") "first-reading") 16)
        (lcb-bit (eq (str_len (lc-stone "good" "x")) 0) 32)
        (lcb-bit (nothing? (lc-val s "admit")) 64)
        (lcb-bit (str_eq (lc-verdict s (lc-row "admit" 1 2 "")) "dim") 128)
        (lcb-bit (and (str_eq (lc-delta-of s p "admit") "unobserved")
            (ge (str_find (lc-report s p) "admit ? no-sample" 0) 0)) 256)
        (lcb-bit (and (nothing? (lc-val absent "lastms"))
            (eq (lc-val absent "orphans") 0)) 512)
        (lcb-bit (and (ge (str_find (lc-report absent "")
            "lastms ? no-standing-hearth" 0) 0)
            (and (ge (str_find (lc-report absent "") "orphans 0" 0) 0)
                (and (ge (str_find (lc-improve absent)
                    "11/12 judged lanes unobserved" 0) 0)
                    (eq (str_find (lc-report absent "")
                        "all judged lanes good" 0) -1)))) 1024))))
