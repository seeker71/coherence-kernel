; form-token-lora-metal-band.bml — the Qwen layer overlay's kernels and the control-ID doors, on this host's GPU.
;
; preludes: form-stdlib/core.fk form-stdlib/qwen-lora-train.fk
;
; REQUIRES: a live Metal device -- qlh-rr-open compiles the overlay's two kernels (metal_pipeline) and qlh-rr-apply dispatches them (metal_enqueue)
;
; The layer overlay (qwen-lora-head.fk qlh-rr-*) is read against Form's own arithmetic through the one
; walk the run door's kernels lane also reads (qwen-lora-train.fk qlt-rr-check). No model is opened.
;
; Verdict 15 when every claim lands:
;   1  a fixture (din 64, rank 4, dout 48, three tokens) through qlh-rr-apply matches lora-backward.bml's
;      transposed walks within 1e-4, every output read back, every handle freed
;   2  a span one token past the record's capacity is not applied
;   4  before any table is built, qlh-rr-refusal names a span the records cannot hold and a record on
;      a slot its layer does not carry (attn_output on a linear layer, ssm_out on a full one), each
;      with its layer; ffn_down sits on every layer; qlh-rr-table answers the adapted table (linear
;      15 entries, full 12) when the records hold, and nothing when one does not; the record frees
;   8  the control-ID doors: the bare opening and the eight contract verbs in order through
;      qlt-control-text-at, nothing without a first PAD row or an id, qlt-control-verbs the contract's
;      one list, and a head row asked for an opening that did not arrive refused before any dispatch
section [form.bml] {
 class FormTokenLoraMetalBand {
  def ftlmb-bit(ok, bit) = ok ? bit : 0;
  def ftlmb-zeros(n) = map(i => 0, lbw-of-iota(n));
  // ---- bit 1 and 2 ----
  def ftlmb-kernels() {
   let r = qlt-rr-check(64, 4, 48, 3, 2.5);
   let shown = print(["form-token-lora-metal", "applied", r[0], "outputs", r[1], "max_abs_difference", r[2], "freed", r[3], "applied_past_capacity", r[4]]);
   r;
  }
  def ftlmb-kernels-held(r) = (Comparable) r[0] == 1 && (Comparable) r[1] == 144 && r[2] >= 0.0 && r[2] < 0.0001;
  // ---- bit 4: four layers, every fourth full (layer 3) ----
  def ftlmb-lays() = [ftlmb-zeros(14), ftlmb-zeros(14), ftlmb-zeros(14), ftlmb-zeros(11)];
  def ftlmb-slot(rec, slot) = cons(slot, rec[1:]);
  def ftlmb-slots(rec) {
   let ok = [[ftlmb-slot(rec, 13)], [rec], [], [ftlmb-slot(rec, 10)]];
   let table = qlh-rr-table(ftlmb-lays(), ok, 4, 3);
   let refusals = [qlh-rr-refusal(ok, 4, 3), qlh-rr-refusal([[ftlmb-slot(rec, 10)], [], [], []], 4, 3), qlh-rr-refusal([[], [], [], [ftlmb-slot(rec, 13)]], 4, 3), qlh-rr-refusal(ok, 4, 4)];
   let shown = print(["form-token-lora-metal", "refusals", refusals]);
   (Value) refusals == ["", "slot-kind:0:10", "slot-kind:3:13", "span-exceeds-capacity:0"] && (Value) map(l => len(l), table) == [15, 15, 15, 12] && nothing?(qlh-rr-table(ftlmb-lays(), [[], [], [], [ftlmb-slot(rec, 13)]], 4, 3)) && nothing?(qlh-rr-table(ftlmb-lays(), [[rec]], 4, 3));
  }
  // ---- bit 8 ----
  def ftlmb-control-ids() {
   let first = 248077;
   let texts = map(i => qlt-control-text-at(first, i) ?? "<nothing>", [first, first + 1, first + 2, first + 3, first + 4, first + 5, first + 6, first + 7, first + 8, first + 9]);
   (Value) texts == ["<|form:", "<|form:recipe-birth|>", "<|form:recipe-exec|>", "<|form:choice|>", "<|form:eval|>", "<|form:knowledge-query|>", "<|form:node-get|>", "<|form:node-make|>", "<|form:node-select|>", "<nothing>"]
   && nothing?(qlt-control-text-at(nothing(), first)) && nothing?(qlt-control-text-at(first, nothing())) && nothing?(qlt-control-id-at([], 0, nothing()))
   && (Value) qlt-control-verbs() == lbw-of-verbs() && (Comparable) len(qlt-head-row([], nothing())) == 0;
  }
 }
 let r = ftlmb-kernels();
 let rec = qlh-rr-open(4, qlt-f32-bytes(qlt-rr-values(64 * 4, 1, 0.01)), qlt-f32-bytes(qlt-rr-values(4 * 48, 2, 0.02)), 64, 4, 48, 2.5, 3);
 let slots = ftlmb-slots(rec);
 let closed = qlh-rr-close(rec);
 let verdict = ftlmb-bit(ftlmb-kernels-held(r), 1)
  + ftlmb-bit((Comparable) r[4] == 0, 2)
  + ftlmb-bit(slots && closed > 0, 4)
  + ftlmb-bit(ftlmb-control-ids(), 8);
 let shown = print(["form-token-lora-metal-band", "verdict", verdict]);
 verdict;
}
