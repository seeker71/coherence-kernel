; form-cli-nodeid-knowledge-session-band.fk — pure scannerless + resident
; session composition witness. It opens no model, registry, source, Metal,
; generated artifact, or remote lane. Scripted typed bridge evidence crosses
; the real byte cursor; opaque model/session values prove the residence shape.
;
; Expected verdict: 33554431 (25 bits).
;
; preludes: form-stdlib/form-cli-nodeid-knowledge-session.fk

(do
    (defn fknssb-bit (held weight) (if held weight 0))
    (defn fknssb-repeat (chunk n out)
        (if (le n 0) out
            (fknssb-repeat chunk (sub n 1) (str_concat out chunk))))
    (defn fknssb-source-id ()
        "sha256:1111111111111111111111111111111111111111111111111111111111111111")
    (defn fknssb-path () "form/form-stdlib/synthetic-resident-knowledge.fk")
    (defn fknssb-key () "defn-synthetic-resident-knowledge")
    (defn fknssb-answer () "(defn synthetic-resident-knowledge () 1)")
    (defn fknssb-source ()
        (psci-source-node "form-stdlib" (fknssb-path)
            (fknssb-source-id) 41))
    (defn fknssb-entry ()
        (psci-entry (fknssb-source)
            (list (fknssb-key) "path-synthetic-resident-knowledge")))
    (defn fknssb-current (status)
        (if (str_eq status "hit")
            (fkss-result "hit" "concept-registry-current-source-hit"
                (fknssb-source-id) (fknssb-path) 1 6 (fknssb-answer)
                1 1 1 41 0)
        (if (str_eq status "miss")
            (fkss-result "miss" "concept-not-in-current-source"
                (fknssb-source-id) (fknssb-path) 0 -1 ""
                1 1 1 41 0)
            (fknq-empty-current-result "current-source-unavailable"))))
    (defn fknssb-registry (status reason request fresh rebuild matches
                           source entry lookup)
        (fknq-registry-result status reason request
            (if (eq (psci-source-node-valid? source) 1) "form-stdlib" "")
            (if (eq (psci-source-node-valid? source) 1) (fknssb-path) "")
            (if (eq (psci-source-node-valid? source) 1)
                (fknssb-source-id) "")
            fresh rebuild matches source entry lookup))
    (defn fknssb-registry-with-source (status reason request fresh rebuild)
        (fknssb-registry status reason request fresh rebuild 1
            (fknssb-source) (fknssb-entry) 1))
    (defn fknssb-result-for (status frame)
        (do
            (let scan (fknq-bmf-consume-default frame))
            (let request (fknq-scan-request scan))
            (if (str_eq status "hit")
                (fknq-result-from-evidence scan
                    (fknssb-registry-with-source "hit"
                        "current-content-addressed-source" request 1 0)
                    (fknssb-current "hit") 0)
            (if (str_eq status "miss")
                (fknq-result-from-evidence scan
                    (fknssb-registry "miss" "concept-not-registered"
                        request 0 0 0 (nothing) (nothing) 1)
                    (fknssb-current "nothing") 0)
            (if (str_eq status "nothing")
                (fknq-result-from-evidence scan
                    (fknssb-registry-with-source "hit"
                        "current-content-addressed-source" request 1 0)
                    (fknssb-current "nothing") 0)
            (if (str_eq status "stale")
                (fknq-result-from-evidence scan
                    (fknssb-registry-with-source "stale"
                        "source-rebuild-needed" request 0 1)
                    (fknssb-current "nothing") 0)
            (if (str_eq status "ambiguous")
                (fknq-result-from-evidence scan
                    (fknssb-registry "ambiguous"
                        "ambiguous-registry-request" request 0 0 2
                        (nothing) (nothing) 1)
                    (fknssb-current "nothing") 0)
                (fknq-result-from-evidence scan
                    (fknssb-registry "failure" "registry-unavailable"
                        request 0 0 0 (nothing) (nothing) 1)
                    (fknssb-current "nothing") 0))))))))
    (defn fknssb-executor (status frame)
        (fknssb-result-for status frame))

    ; run = cursor exact-model-deltas exact-injected-deltas
    (defn fknssb-run-two (surface at status)
        (do
            (let first (substring surface 0 at))
            (let second (substring surface at (str_len surface)))
            (let a (fknsc-feed status fknssb-executor
                (fknsc-fresh) first))
            (let b (fknsc-feed status fknssb-executor
                (fknsc-transfer-cursor a) second))
            (list (fknsc-transfer-cursor b)
                (str_concat (fknsc-transfer-model a)
                            (fknsc-transfer-model b))
                (str_concat (fknsc-transfer-injected a)
                            (fknsc-transfer-injected b)))))
    (defn fknssb-run-cursor (r) (nth r 0))
    (defn fknssb-run-model (r) (nth r 1))
    (defn fknssb-run-injected (r) (nth r 2))
    (defn fknssb-run-one (surface status)
        (do
            (let x (fknsc-feed status fknssb-executor
                (fknsc-fresh) surface))
            (list (fknsc-transfer-cursor x)
                  (fknsc-transfer-model x)
                  (fknsc-transfer-injected x))))
    (defn fknssb-split-valid? (surface at)
        (do
            (let run (fknssb-run-two surface at "hit"))
            (let c (fknssb-run-cursor run))
            (if (and (str_eq (fknssb-run-model run) surface)
                (and (eq (fknsc-offered c) 1)
                (and (eq (fknsc-injections c) 1)
                     (str_eq (fknq-status (fknsc-result c)) "hit")))) 1 0)))
    (defn fknssb-every-split? (surface at)
        (if (gt at (str_len surface)) 1
            (if (eq (fknssb-split-valid? surface at) 1)
                (fknssb-every-split? surface (add at 1)) 0)))
    (defn fknssb-byte-loop (surface at cursor model injected)
        (if (ge at (str_len surface)) (list cursor model injected)
            (do
                (let x (fknsc-feed "hit" fknssb-executor cursor
                    (substring surface at (add at 1))))
                (fknssb-byte-loop surface (add at 1)
                    (fknsc-transfer-cursor x)
                    (str_concat model (fknsc-transfer-model x))
                    (str_concat injected (fknsc-transfer-injected x))))))
    (defn fknssb-run-bytes (surface)
        (fknssb-byte-loop surface 0 (fknsc-fresh) "" ""))
    (defn fknssb-trace-all? (trace actions)
        (if (nil? actions) 1
            (if (eq (fknq-trace-has? trace (head actions)) 1)
                (fknssb-trace-all? trace (tail actions)) 0)))

    (defn form-cli-nodeid-knowledge-session-band ()
        (do
            (let concept (fknq-concept-surface (fknssb-key)))
            (let nodeid (fknq-nodeid-surface
                (fknq-node-key (fknssb-entry))))
            (let lead-tail (str_concat "before:" (str_concat concept ":after")))
            (let every-split (fknssb-every-split? concept 0))
            (let bytes-run (fknssb-run-bytes concept))
            (let bytes-c (fknssb-run-cursor bytes-run))
            (let node-run (fknssb-run-one nodeid "hit"))
            (let node-c (fknssb-run-cursor node-run))
            (let hit-run (fknssb-run-one concept "hit"))
            (let hit-c (fknssb-run-cursor hit-run))
            (let hit (fknsc-result hit-c))
            (let miss-c (fknssb-run-cursor
                (fknssb-run-one concept "miss")))
            (let nothing-c (fknssb-run-cursor
                (fknssb-run-one concept "nothing")))
            (let stale-c (fknssb-run-cursor
                (fknssb-run-one concept "stale")))
            (let ambiguous-c (fknssb-run-cursor
                (fknssb-run-one concept "ambiguous")))
            (let failure-c (fknssb-run-cursor
                (fknssb-run-one concept "failure")))

            (let prose-x (fknsc-feed "hit" fknssb-executor
                (fknsc-fresh) (fknssb-repeat "abcdefghij" 100 "")))
            (let prose-c (fknsc-transfer-cursor prose-x))
            (let partial-x (fknsc-feed "hit" fknssb-executor
                (fknsc-fresh) (str_concat (fknq-open) "concept=held")))
            (let partial-c (fknsc-transfer-cursor partial-x))
            (let timeout-x (fknsc-timeout partial-c))
            (let timeout-c (fknsc-transfer-cursor timeout-x))
            (let over-x (fknsc-feed "hit" fknssb-executor
                (fknsc-fresh) (str_concat (fknq-open)
                    (fknssb-repeat "x" (fknsc-hold-cap) ""))))
            (let over-c (fknsc-transfer-cursor over-x))

            (let repeat-a (fknsc-feed "hit" fknssb-executor
                (fknsc-fresh) (str_concat concept concept)))
            (let repeat-b (fknsc-feed "hit" fknssb-executor
                (fknsc-transfer-cursor repeat-a) concept))
            (let repeat-c (fknsc-transfer-cursor repeat-b))

            (let opaque-ctx (list "same-qwen-context"))
            (let opaque-sts (list "same-kv-stream"))
            (let s (fcms-session "live" "opened" "model.gguf" "src"
                opaque-ctx opaque-sts 2048 77 0 0 76 4 3 0))
            (let s2 (fcms-with-stream s 81 9 0 9 17 1))
            (let joined (fknss-result s2 hit-c concept "continued-answer"
                (fknsc-observation hit-c) (list 1 2 3) (list 4 5)))
            (let rendered (fknsc-observation hit-c))

            (sum (list
                (fknssb-bit (and
                    (eq (fknsc-detect-cap) (sub (str_len (fknq-open)) 1))
                    (and (eq (fknsc-hold-cap) (fknq-max-frame-bytes))
                    (and (eq (fknsc-injection-cap) (fkqt-max-render-bytes))
                         (eq (fknsc-max-offers) 1)))) 1)
                (fknssb-bit (and
                    (str_eq (fknsc-scan "ordinary") (fknsc-state-none))
                    (and (str_eq (fknsc-scan (fknq-open))
                                 (fknsc-state-held))
                    (and (str_eq (fknsc-scan concept)
                                 (fknsc-state-complete))
                         (str_eq (fknsc-scan
                            (str_concat (fknq-open)
                                (fknssb-repeat "x" (fknsc-hold-cap) "")))
                            (fknsc-state-over))))) 2)
                (fknssb-bit (str_eq (fknsc-frame
                    (fknsc-feed-window "" lead-tail)) concept) 4)
                (fknssb-bit (eq every-split 1) 8)
                (fknssb-bit (and (str_eq (fknssb-run-model bytes-run) concept)
                    (and (eq (fknsc-model-chunks bytes-c) (str_len concept))
                    (and (eq (fknsc-offered bytes-c) 1)
                         (eq (fknsc-injections bytes-c) 1)))) 16)
                (fknssb-bit (and (eq (fknsc-offered node-c) 1)
                    (and (str_eq (fknq-request-kind
                            (fknq-request (fknsc-result node-c))) "nodeid")
                         (eq (fknsc-lookup-count node-c) 1))) 32)
                (fknssb-bit (and (eq (fknsc-offered prose-c) 0)
                    (and (str_eq (fknsc-scan-state prose-c)
                                 (fknsc-state-none))
                         (le (str_len (fknsc-window prose-c))
                             (fknsc-detect-cap)))) 64)
                (fknssb-bit (and (str_eq (fknsc-scan-state partial-c)
                                         (fknsc-state-held))
                    (and (eq (fknsc-offered partial-c) 0)
                         (eq (fknsc-injections partial-c) 0))) 128)
                (fknssb-bit (and (str_eq (fknsc-terminal timeout-c) "timeout")
                    (and (eq (fknsc-offered timeout-c) 0)
                    (and (eq (fknsc-injections timeout-c) 1)
                    (and (str_eq (fknsc-status timeout-c) "timeout")
                         (eq (fknssb-trace-all?
                            (fknq-trace (fknsc-result timeout-c))
                            (list "choice" "timeout" "cut" "undo"
                                  "refine" "release")) 1))))) 256)
                (fknssb-bit (and (str_eq (fknsc-terminal over-c) "over")
                    (and (str_eq (fknsc-status over-c) "failure")
                    (and (eq (fknsc-offered over-c) 0)
                         (eq (fknsc-injections over-c) 1)))) 512)
                (fknssb-bit (and (eq (fknsc-offered repeat-c) 1)
                    (and (eq (fknsc-injections repeat-c) 1)
                         (eq (fknsc-model-bytes repeat-c)
                             (mul (str_len concept) 3)))) 1024)
                (fknssb-bit (and (str_eq (fknssb-run-model hit-run) concept)
                    (and (str_eq (fknssb-run-injected hit-run) rendered)
                    (and (lt (str_find (fknssb-run-model hit-run)
                                      (fknq-observation-open) 0) 0)
                         (lt (str_find rendered (fknq-open) 0) 0)))) 2048)
                (fknssb-bit (and (eq (fknsc-callback-calls hit-c) 1)
                    (and (eq (fknsc-lookup-count hit-c) 1)
                    (and (eq (fknq-model-executed? hit) 0)
                    (and (node_eq (node_category (fknq-source hit))
                                  (fknq-source-category))
                    (and (node_eq (node_category (fknq-entry hit))
                                  (fknq-entry-category))
                    (and (node_eq (node_category (fknq-request hit))
                                  (fknq-request-category))
                    (and (node_eq (node_category (fknq-executor hit))
                                  (fknq-executor-category))
                         (node_eq (node_category (fknq-observation hit))
                                  (fknq-observation-category))))))))) 4096)
                (fknssb-bit (and
                    (node_eq (fknq-source-original (fknq-source hit))
                             (fknssb-source))
                    (and (node_eq (fknq-entry-original (fknq-entry hit))
                                  (fknssb-entry))
                         (node_eq (node_category
                            (fknq-existing-current-observation hit))
                            (fhcs-observation-category)))) 8192)
                (fknssb-bit (and
                    (ge (str_find rendered "\nsource-node=@" 0) 0)
                    (and (ge (str_find rendered "\nentry-node=@" 0) 0)
                    (and (ge (str_find rendered "\nrequest-node=@" 0) 0)
                    (and (ge (str_find rendered "\nexecutor-node=@" 0) 0)
                    (and (ge (str_find rendered "\nobservation-node=@" 0) 0)
                    (and (ge (str_find rendered
                        "\ncurrent-source-observation-node=@" 0) 0)
                         (ge (str_find rendered "\nmodel-executed=0\n" 0)
                             0))))))) 16384)
                (fknssb-bit (and
                    (node_eq (head (fcms-ctx (fknss-session joined)))
                             (head opaque-ctx))
                    (and (node_eq (head (fcms-sts (fknss-session joined)))
                                  (head opaque-sts))
                    (and (eq (fcms-generated-ids (fknss-session joined)) 9)
                    (and (eq (fcms-injected-ids (fknss-session joined)) 17)
                         (eq (fcms-observations (fknss-session joined)) 1)))))
                    32768)
                (fknssb-bit (and
                    (ge (str_find (fcms-generated-id-policy) "original" 0) 0)
                    (and (str_eq (fcms-resume-encode-scope)
                        "new-observation-bytes-and-role-crossing-only")
                         (eq (fknss-model-executed-form? joined) 0))) 65536)
                (fknssb-bit (and (str_eq (fknsc-status hit-c) "hit")
                    (and (str_eq (fknsc-status miss-c) "miss")
                         (str_eq (fknsc-status nothing-c) "nothing"))) 131072)
                (fknssb-bit (and (str_eq (fknsc-status stale-c) "stale")
                    (eq (fknssb-trace-all?
                        (fknq-trace (fknsc-result stale-c))
                        (list "choice" "undo" "refine" "release")) 1))
                    262144)
                (fknssb-bit (and
                    (str_eq (fknsc-status ambiguous-c) "ambiguous")
                    (eq (fknssb-trace-all?
                        (fknq-trace (fknsc-result ambiguous-c))
                        (list "choice" "cut" "undo" "refine" "release"))
                        1)) 524288)
                (fknssb-bit (and (str_eq (fknsc-status timeout-c) "timeout")
                    (eq (fknq-model-executed?
                        (fknsc-result timeout-c)) 0)) 1048576)
                (fknssb-bit (and (str_eq (fknsc-status failure-c) "failure")
                    (eq (fknssb-trace-all?
                        (fknq-trace (fknsc-result failure-c))
                        (list "choice" "cut" "undo" "refine" "release"))
                        1)) 2097152)
                (fknssb-bit (and
                    (eq (fknssb-trace-all? (fknq-trace hit)
                        (list "choice" "cut" "release")) 1)
                    (and (eq (fknssb-trace-all?
                            (fknq-trace (fknsc-result stale-c))
                            (list "undo" "refine")) 1)
                         (eq (fknssb-trace-all?
                            (fknq-trace (fknsc-result failure-c))
                            (list "failure" "release")) 1))) 4194304)
                (fknssb-bit (and (le (str_len rendered)
                                         (fknsc-injection-cap))
                    (and (ge (str_find rendered (fknssb-path) 0) 0)
                    (and (ge (str_find rendered (fknssb-answer) 0) 0)
                         (eq (fknsc-observation-valid? rendered) 1)))) 8388608)
                (fknssb-bit (and (eq (fknsc-model-executed? hit-c) 0)
                    (and (eq (fknq-model-executed? hit) 0)
                    (and (eq (fknss-model-executed-form? joined) 0)
                         (eq (fknss-callback-calls joined) 1)))) 16777216)))))

    (form-cli-nodeid-knowledge-session-band))
