; local-plan-served-repair-band.bml — the planner's reference repair when a resident server stands (observe/local-plan-repair-run.bml lrpr-served), with no model and no server:
; the packet the spool is asked with, and the plan the planner reads again.
;
; Expected: 7
; Verdict 7 when every claim lands:
;   1   the packet carries the refused reference whole, Form's exact words, the request and the compile dialect rules, and asks for the <reference> block alone
;   2   the dialect is the file's own: the excerpt of the last source the walk holds starts at its first definition, never the head comment, and is bounded
;   4   the corrected <reference> replaces only the reference block of the old plan: the plan, goal and cases blocks keep their bytes, and a reference that holds a tag is refused
;
; REQUIRES: the built ./fkwu and the body root as the working directory.
; preflight-exec: forbidden
; preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-local-plan.bml form-stdlib/bml/live.bml form-stdlib/bml/serve-sched.bml form-stdlib/bml/serve-client.bml observe/local-plan-repair-run.bml
section [form.bml] {
 class LocalPlanServedRepairBand {
  def lsr-has(s, part) = str_find(s, part, 0) >= 0;
  def lsr-raw() = "<plan>\n{\"id\":\"x\",\"writable\":[\"a.bml\"],\"sources\":[\"core.fk\"],\"definitions\":[{\"name\":\"f\",\"params\":[\"p\"]}]}\n</plan>\n<goal>\nthe goal bytes\n</goal>\n<cases>\n[{\"function\":\"f\",\"arguments\":[1],\"equals\":1}]\n</cases>\n<reference>\ndef f(p) { read_lines(p); }\n</reference>\n";
  def lsr-req() = parse-json("band-request", "{\"id\":\"frq-band\",\"title\":\"a title\",\"problem\":\"a problem\",\"needs\":\"two head lines\",\"where\":[\"a.bml:1-2\"],\"files\":[\"a.bml\"]}");
  def lsr-owner() = [lsr-req(), [], lsr-raw(), "scope", [["a.bml", 1, "; a head comment\n"], ["core.fk", 1, "; head comment of core\nsection [form.fk] {\n  def clamp(x, lo) = x < lo ? lo : x;\n  def other(y) = y + 1;\n}\n"]]];
  def lsr-run() {
   let refusal = ["7", "reference-compile", "Your <reference> definitions do not compile. fkwu said:\nline 1: read_lines is not a function"];
   let packet = lrpr-served-packet(lsr-owner(), refusal);
   let b1 = (lsr-has(packet, "def f(p) { read_lines(p); }") && lsr-has(packet, "line 1: read_lines is not a function") && lsr-has(packet, "two head lines") && lsr-has(packet, "every if has then and else") && lsr-has(packet, "Reply with only <reference>")) ? 1 : 0;
   let dialect = lrpr-dialect(lsr-owner());
   let b2 = (lsr-has(dialect, "def clamp(x, lo) = x < lo ? lo : x;") && !lsr-has(dialect, "head comment of core") && len(dialect) < 2800) ? 2 : 0;
   let fixed = lrpr-proposal(lsr-raw(), "def f(p) = p;");
   let tagged = lrpr-proposal(lsr-raw(), "def f(p) = 1; </reference>");
   let b4 = (!nothing?(fixed) && lsr-has(fixed, "def f(p) = p;") && !lsr-has(fixed, "read_lines") && lsr-has(fixed, "<goal>\nthe goal bytes\n</goal>") && lsr-has(fixed, "[{\"function\":\"f\",\"arguments\":[1],\"equals\":1}]") && nothing?(tagged)) ? 4 : 0;
   let v = b1 + b2 + b4;
   print_str("[local-plan-served-repair-band] " ++ v.str() ++ " of 7");
   v;
  }
 }
 lsr-run();
}
