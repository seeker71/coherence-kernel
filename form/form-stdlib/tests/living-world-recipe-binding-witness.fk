; living-world-recipe-binding-witness.fk -- one exact Recipe consumes only
; explicitly offered, content-addressed numeric projections.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk

(let LWRBW-SOURCE-A (bp "LWRBW-SOURCE-A"))
(let LWRBW-SOURCE-B (bp "LWRBW-SOURCE-B"))
(let LWRBW-PROV-A   (bp "LWRBW-PROV-A"))
(let LWRBW-PROV-B   (bp "LWRBW-PROV-B"))
(let LWRBW-ACTION   (bp "LWRBW-ACTION"))
(let LWRBW-DIRECTION (bp "LWRBW-DIRECTION"))
(let LWRBW-SIGNAL-A (bp "LWRBW-SIGNAL-A"))
(let LWRBW-SIGNAL-B (bp "LWRBW-SIGNAL-B"))
(let LWRBW-EVIDENCE (bp "LWRBW-EVIDENCE"))
(let LWRBW-FLOW-A   (bp "LWRBW-FLOW-A"))
(let LWRBW-FLOW-B   (bp "LWRBW-FLOW-B"))

(defn lwrbw-cell (kind) (intern_node kind (empty)))
(defn lwrbw-source-a () (lwrbw-cell LWRBW-SOURCE-A))
(defn lwrbw-source-b () (lwrbw-cell LWRBW-SOURCE-B))
(defn lwrbw-prov-a () (lwrbw-cell LWRBW-PROV-A))
(defn lwrbw-prov-b () (lwrbw-cell LWRBW-PROV-B))
(defn lwrbw-action () (lwrbw-cell LWRBW-ACTION))
(defn lwrbw-direction () (lwrbw-cell LWRBW-DIRECTION))
(defn lwrbw-evidence () (lwrbw-cell LWRBW-EVIDENCE))
(defn lwrbw-flow-a () (lwrbw-cell LWRBW-FLOW-A))
(defn lwrbw-flow-b () (lwrbw-cell LWRBW-FLOW-B))
(defn lwrbw-signal-a ()
    (intern_node LWRBW-SIGNAL-A
        (list (intern_trivial_int 3) (lwrbw-evidence))))
(defn lwrbw-signal-b ()
    (intern_node LWRBW-SIGNAL-B
        (list (intern_trivial_int 4) (lwrbw-evidence))))

(defn lwrbw-contract ()
    (lwre-bound-form-contract 128 (lwrbw-evidence)))
(defn lwrbw-recipe ()
    (lwre-recipe "(add origin field)"
        (lwrbw-contract) (lwrbw-evidence)))
(defn lwrbw-lens ()
    (lwlc-lens (lwlc-recipe-shape)
        (lwrbw-recipe) (lwrbw-evidence)))
(defn lwrbw-declaration ()
    (lwlc-declaration (lwrbw-direction)
        (lwlc-stack (lwrbw-lens) (lwlc-layers (list))
            (lwo-empty-field) (lwo-none) (lwrbw-evidence))
        (lwrbw-evidence)))

(defn lwrbw-origin-a ()
    (lwre-binding "origin" (intern_trivial_int 2)
        (intern_trivial_int 2) (lwrbw-evidence)))
(defn lwrbw-field-a ()
    (lwre-binding "field" (lwrbw-signal-a)
        (intern_trivial_int 3) (lwrbw-evidence)))
(defn lwrbw-bindings-a ()
    (lwre-bindings (list (lwrbw-origin-a) (lwrbw-field-a))))
(defn lwrbw-origin-b ()
    (lwre-binding "origin" (intern_trivial_int 7)
        (intern_trivial_int 7) (lwrbw-evidence)))
(defn lwrbw-field-b ()
    (lwre-binding "field" (lwrbw-signal-b)
        (intern_trivial_int 4) (lwrbw-evidence)))
(defn lwrbw-bindings-b ()
    (lwre-bindings (list (lwrbw-origin-b) (lwrbw-field-b))))

(defn lwrbw-entry (source provenance payload)
    (lwt-entry
        (lwo-offer source (lwo-interface (list (lwrbw-action)))
            1 payload provenance 1)
        (lwrbw-action)))
(defn lwrbw-entry-a (payload)
    (lwrbw-entry (lwrbw-source-a) (lwrbw-prov-a) payload))
(defn lwrbw-entry-b (payload)
    (lwrbw-entry (lwrbw-source-b) (lwrbw-prov-b) payload))
(defn lwrbw-world-a ()
    (lwt-receive-stream (lwo-empty-world)
        (list
            (lwrbw-entry-a (lwrbw-recipe))
            (lwrbw-entry-a (lwrbw-declaration))
            (lwrbw-entry-a (intern_trivial_int 2))
            (lwrbw-entry-a (lwrbw-origin-a))
            (lwrbw-entry-b (lwrbw-signal-a))
            (lwrbw-entry-b (intern_trivial_int 3))
            (lwrbw-entry-b (lwrbw-field-a)))))
(defn lwrbw-world-b ()
    (lwt-receive-stream (lwo-empty-world)
        (list
            (lwrbw-entry-a (lwrbw-recipe))
            (lwrbw-entry-a (lwrbw-declaration))
            (lwrbw-entry-a (intern_trivial_int 7))
            (lwrbw-entry-a (lwrbw-origin-b))
            (lwrbw-entry-b (lwrbw-signal-b))
            (lwrbw-entry-b (intern_trivial_int 4))
            (lwrbw-entry-b (lwrbw-field-b)))))
(defn lwrbw-trace-a ()
    (lwre-execute-bound (lwrbw-world-a) (lwrbw-declaration)
        (lwrbw-lens) (intern_trivial_int 2) (lwrbw-bindings-a)
        (lwo-empty-field) (lwo-none) (lwo-none)
        (lwrbw-flow-a) (lwo-none) (lwrbw-evidence)))
(defn lwrbw-trace-b ()
    (lwre-execute-bound (lwrbw-world-b) (lwrbw-declaration)
        (lwrbw-lens) (intern_trivial_int 7) (lwrbw-bindings-b)
        (lwo-empty-field) (lwo-none) (lwo-none)
        (lwrbw-flow-b) (lwo-none) (lwrbw-evidence)))
(defn lwrbw-proposal-a ()
    (lwre-proposal-bound (lwrbw-world-a) (lwrbw-declaration)
        (lwrbw-lens) (intern_trivial_int 2) (lwrbw-bindings-a)
        (lwo-empty-field) (lwo-none) (lwo-none)
        (lwrbw-flow-a) (lwo-none) (lwrbw-evidence)))
(defn lwrbw-revoked-world-a ()
    (lwt-receive-stream (lwrbw-world-a)
        (list
            (lwrbw-entry-b
                (lwo-revocation (lwrbw-signal-a) (lwrbw-source-b)
                    (lwrbw-evidence) (lwrbw-prov-b))))))
(defn lwrbw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwrbw-sum (tail items)))))

0
