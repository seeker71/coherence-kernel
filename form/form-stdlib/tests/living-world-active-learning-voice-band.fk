; living-world-active-learning-voice-band.fk -- self-derived successor evidence
; reaches one participant-learned native surface through four distinct
; authority membranes. Twenty-four claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-shared-field-channel.fk form-stdlib/living-world-generative-continuation.fk form-stdlib/living-world-hypothesis-transfer.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-hypothesis-transfer-witness.fk form-stdlib/tests/living-world-active-learning-voice-witness.fk

(do
    (let result (lwhlv-run))
    (let active (nth (node_children result) 0))
    (let application (nth (node_children result) 1))
    (let execution (nth (node_children result) 2))
    (let symbol (nth (node_children result) 3))
    (let transfer (nth (node_children result) 4))
    (let transfer-plan (nth (node_children result) 5))
    (let transition (nth (node_children result) 6))
    (let transition-candidate (nth (node_children result) 7))
    (let prediction (nth (node_children result) 8))
    (let expression (nth (node_children result) 9))
    (let trace (nth (node_children result) 10))
    (let world (nth (node_children result) 11))
    (let arriving (nth (node_children active) 2))
    (let events (framebuffer-events))
    (sum (list
        (if (eq (lwo-field-size (lwps-candidate-hypotheses arriving)) 2) 1 0)
        (if (eq (lwht-application-shape-valid? application) 1) 2 0)
        (if (eq (lwht-application-current? world application 2) 1) 4 0)
        (if (eq (lwht-execution? execution) 1) 8 0)
        (if (eq (lwht-execution-current? world execution) 1) 16 0)
        (if (node_eq (lwht-execution-output execution)
                     (oac-payload (lwht-execution-immediate execution))) 32 0)
        (if (eq (lwsl-candidate-current? world symbol) 1) 64 0)
        (if (eq (lwhtr-plan? transfer-plan) 1) 128 0)
        (if (eq (lwhtr-candidate-active? world transfer) 1) 256 0)
        (if (eq (lwtf-observation? transition) 1) 512 0)
        (if (eq (lwtf-candidate-current? world transition-candidate) 1) 1024 0)
        (if (eq (lwtf-prediction? prediction) 1) 2048 0)
        (if (eq (oac-one? (lwtf-prediction-ack prediction)) 1) 4096 0)
        (if (eq (lwtx-plan? expression) 1) 8192 0)
        (if (eq (oac-one? (lwtx-plan-ack expression)) 1) 16384 0)
        (if (eq (lwsg-trace? trace) 1) 32768 0)
        (if (eq (len (lwsg-turn-items (lwsg-trace-turns trace))) 1) 65536 0)
        (if (gt (str_len (lwsg-trace-rendered trace)) 0) 131072 0)
        (if (str_eq (lwsg-trace-rendered trace)
                    (lwnv-symbol-surface
                        (lwo-emergent-shape symbol))) 262144 0)
        (if (node_eq (lwsg-trace-prediction trace) prediction) 524288 0)
        (if (node_eq (lwsg-trace-plan trace) expression) 1048576 0)
        (if (and (node_eq (lwhtr-plan-transition transfer-plan) transition)
                 (and (eq (lwo-field-size
                            (lwtf-prediction-derivations prediction)) 1)
                      (node_eq
                        (lwtf-derivation-candidate
                            (head (lwo-field-items
                                (lwtf-prediction-derivations prediction))))
                        transition-candidate))) 2097152 0)
        (if (eq (len events) 8) 4194304 0)
        (if (and (eq (lwps-comparison-admissible
                        (nth (node_children active) 12)) 1)
                 (eq (lwps-comparison-repeated
                        (nth (node_children active) 12)) 0)) 8388608 0))))
