; exit-proof-band.bml — the goal's exit proof, read from fixtures and from the living tree (observe/exit-proof-run.bml).
;
; The door is spawned over fixture worlds this band writes under a scratch directory, each a small git repository whose origin/main it reads, so no
; live ledger row lands (stdin: root, ref, walk, logs, ledger, panel_dir, now_ms, zone_ms). Its last run reads the living tree with no ledger row and no
; model door. Every reading has its way of looking true while it is false, and a fixture asks each.
;
; Expected: 511
; Verdict 511 when every claim lands:
;   1   E1 holds on the newest on-schedule "scheduled" row with a rent row and a landing that carries it, naming the sha. Passed over on the way, newest first: a
;       walk-here row reading rented_mind 0, a row naming a session, a row off its slot, a row with no landing, a row whose landing does not carry it, a row with no
;       answered rent row, a provider's answer at rent 0, a landing a co-author signed. While the night's stamp stands its pid is read against the voice's evidence
;   2   E1 reads a wall when no row qualifies, and unread when the ledger is not on the ref; a row only in the working tree or on a local branch never reads
;   4   E2 sums the path ledger's second column, commas read; the meters stand beside it, each session's last row once; a wall when E1 does not hold
;   8   E3 reads the windows: on-schedule rows at coordinating rent 0, the session's row that read the schedule named and counted apart; a wall when E1 does not hold, and when an on-schedule row carries no coordinating_rent (unknown, never 0)
;   16  E4 reads two walls by name when S1 is no default and fewer than 6 receipts are cited, says what was offered, and that the row is the voice walk's;
;       it holds when form-cli's code names fgs-answer and its session's code names fc-s1-ask (a comment naming either calls nothing) and an S1 row reads at most 10,000 with 6 cited
;   32  E5 reads the wall headless-share with the turns it found; it holds when every provider row reads observed, and when no turn and no door stands
;   64  E6 reads the newest walk's gate lines, by the walk's own begun instant: a refused gate in the newest walk is a wall though an older walk read full;
;       no gate line is unread; gate lines from a walk older than seven days are the wall stale-gates; a native landing that touched code whose band no gate runs is the
;       wall step-unread (a comment naming the band runs nothing), and it holds when a gate's row names that band, and when the landing's own Band-Witness read the
;       band of a file with no band of its own at its full over the tree that landed. A witness short of its full, over another tree or naming another file, a file
;       whose own band stands at the landing's commit, and a gate row that landed after it each stay step-unread: the gates are read at the landing's own commit
;   128 the summary, one ledger row carrying each verdict and reading flat for the register, exit 0; a request that does not read is refused by name
;   256 the living tree: six lines, exit 0, a summary, and E1 not unread
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/host-child.bml form-stdlib/bml/exit-proof.bml
section [form.bml] {
 class ExitProofBand {
  def epb-dir() = ".hearth/exit-proof-band";
  def epb-has?(hay, needle) = str_find(hay, needle, 0) >= 0;
  // 2026-10-31 15:25:00 at +08:00
  def epb-now() = 1793431500000;
  def epb-zone() = 28800000;
  def epb-hour() = 3600000;
  def epb-day() = 86400000;
  def epb-dir-of(p) { let at = ep-rfind(p, "/", 0, -1); at < 0 ? "." : substring(p, 0, at); }
  def epb-write(root, path, text) {
   let made = hch-mkdirs(epb-dir-of(root ++ "/" ++ path));
   write_file_text(root ++ "/" ++ path, text);
  }
  def epb-git(root, step, args) = hch-run-quiet-in(epb-dir() ++ "/io", "git-" ++ step, append(["git", "-C", root, "-c", "user.name=band", "-c", "user.email=band@local", "-c", "commit.gpgsign=false"], args), "", hch-by(120000));
  def epb-init(root) = epb-git(root, "init", ["init", "-q", "."]);
  def epb-commit(root, subject, paths) {
   let added = epb-git(root, "add", append(["add", "-f", "--"], paths));
   epb-git(root, "commit", ["commit", "-q", "--allow-empty", "--date=" ++ (epb-now() / 1000).str() ++ " +0800", "-m", subject]);
  }
  def epb-publish(root) = epb-git(root, "ref", ["update-ref", "refs/remotes/origin/main", "HEAD"]);
  def epb-crossing(at, m, by, exe, rented, extra) = "{\"at_unix_ms\":" ++ at.str() ++ ",\"movement\":\"" ++ m ++ "\",\"coordinated_by\":\"" ++ by ++ "\",\"coordinator\":\"" ++ exe ++ "\",\"rented_mind\":" ++ rented.str() ++ ",\"coordinating_rent\":0" ++ extra ++ "}\n";
  def epb-kept(at, m) = epb-crossing(at, m, "host-schedule", "/sbin/launchd", 0, "");
  def epb-rent(m, rent, cited, source, extra) = "{\"at_unix_ms\":1,\"movement\":\"" ++ m ++ "\",\"enquiry\":\"" ++ ep-pinned() ++ "\",\"source\":\"" ++ source ++ "\",\"oracle\":\"answered\",\"rent_tokens\":" ++ rent.str() ++ ",\"answer_bytes\":9,\"answer_receipts_cited\":" ++ cited.str() ++ ",\"answer_receipts_existing\":" ++ cited.str() ++ ",\"evidence\":\"x/native-voice-92701-1\"" ++ extra ++ "}\n";
  // the night of a day `back` days before the band's instant, at 03:30 plus the minutes
  def epb-night(back, minutes) = hr-slot-ms(hr-slots()[0], epb-now() - back * epb-day(), epb-zone()) + minutes * 60000;
  def epb-day-name(back) = hw-day-in(epb-zone(), epb-night(back, 0));
  def epb-goal() = "(ledger\n (L1 \"a\"\n  \"11272414 (coordinating 10527049; providers 745365)\"\n \"d\" \"r\" \"e\")\n (L2 \"b\"\n  \"0 by the walk itself\"\n \"d\")\n (L3 \"c\"\n  \"13,285 by the walk\"\n \"d\"))\n";
  def epb-gates(ground, fresh, pass, refused, pid, begun) = "noise\nground  rc=0  " ++ ground.str() ++ "  pass\nbinary-freshness  rc=0  " ++ fresh.str() ++ "  pass\ndrift-gates pass=" ++ pass.str() ++ " full=63 refused=" ++ refused.str() ++ " names=-\nform-organ health {\"schema\":\"organ-health-v1\",\"id\":\"" ++ pid.str() ++ ":" ++ begun.str() ++ ":1:landing\"}\n";
  // the main world: every row a reading must pass over, and one it must stop at
  def epb-write-main(w) {
   let d1 = epb-day-name(1);
   let d2 = epb-day-name(2);
   let d3 = epb-day-name(3);
   let d4 = epb-day-name(4);
   let d0 = epb-day-name(0);
   let d5 = epb-day-name(5);
   // oldest first: d5 lands well and d4 is the one to stop at; then, newer, each row that must be passed over
   let crossings = epb-kept(epb-night(5, 20), "scheduled " ++ d5)
    ++ epb-kept(epb-night(4, 20), "scheduled " ++ d4)
    ++ epb-kept(epb-night(3, 20), "scheduled " ++ d3)
    ++ epb-kept(epb-night(2, 20), "scheduled " ++ d2)
    ++ epb-kept(epb-night(2, 21), "scheduled " ++ d2 ++ "c")
    ++ epb-kept(epb-night(2, 22), "scheduled " ++ d2 ++ "p")
    ++ epb-kept(epb-night(1, 20), "scheduled " ++ d1)
    ++ epb-kept(epb-night(1, 600), "scheduled " ++ d1 ++ "x")
    ++ epb-crossing(epb-night(0, 20), "scheduled " ++ d0, "host-schedule", "/sbin/launchd", 0, ",\"session\":\"s\"")
    ++ epb-kept(epb-night(0, 25), "walk-here " ++ d0);
   let a = epb-write(w, "receipts/crossings-ledger.jsonl", epb-kept(epb-night(5, 20), "scheduled " ++ d5) ++ epb-kept(epb-night(4, 20), "scheduled " ++ d4));
   let b = epb-write(w, "receipts/rent-ledger.jsonl", "");
   let e = epb-write(w, "docs/rent-to-zero-goal.form", epb-goal());
   let f = epb-write(w, "receipts/session-rent-ledger.jsonl", "{\"at_unix_ms\":1,\"session\":\"s1\",\"rented\":{\"input\":1,\"cache_write\":2,\"cache_read\":3,\"output\":4}}\n{\"at_unix_ms\":2,\"session\":\"s1\",\"rented_total\":100}\n{\"at_unix_ms\":3,\"session\":\"s2\",\"rented_total\":5}\n");
   let g = epb-write(w, "receipts/rented-work-sessions.jsonl", "{\"session\":\"w1\",\"work\":{\"total_tokens\":70}}\n");
   let i = epb-init(w);
   // d4's landing carries its row; the others follow, the last commits naming rows they do not carry
   let c1 = epb-commit(w, "Scheduled movement " ++ d4 ++ ": the body walks with no rented mind", ["."]);
   let wr = epb-write(w, "receipts/crossings-ledger.jsonl", crossings);
   let wr2 = epb-write(w, "receipts/rent-ledger.jsonl", epb-rent("scheduled " ++ d5, 0, 1, "fkwu-model-session", "") ++ epb-rent("scheduled " ++ d4, 0, 2, "fkwu-model-session", "") ++ epb-rent("scheduled " ++ d2, 0, 2, "fkwu-model-session", "") ++ epb-rent("scheduled " ++ d2 ++ "c", 0, 2, "fkwu-model-session", "") ++ epb-rent("scheduled " ++ d2 ++ "p", 0, 2, "provider", "") ++ epb-rent("scheduled " ++ d1 ++ "x", 0, 2, "fkwu-model-session", "") ++ epb-rent("scheduled " ++ d0, 0, 2, "fkwu-model-session", "") ++ epb-rent("walk-here " ++ d0, 0, 2, "fkwu-model-session", ""));
   // d3 holds no rent row; d2's rent row reads, and no landing names it; d1 has a landing whose blob this commit does not make hold its row
   let c2 = epb-commit(w, "the rows land under a subject of no movement", ["receipts/crossings-ledger.jsonl", "receipts/rent-ledger.jsonl"]);
   // a landing that carries its row and a co-author signed it; and one whose rent row is a provider's answer at rent 0
   let signed = epb-git(w, "signed", ["commit", "-q", "--allow-empty", "--date=" ++ (epb-now() / 1000).str() ++ " +0800", "-m", "Scheduled movement " ++ d2 ++ "c: the body walks with no rented mind", "-m", "Co-Authored-By: Claude <noreply@anthropic.com>"]);
   let bought = epb-git(w, "bought", ["commit", "-q", "--allow-empty", "--date=" ++ (epb-now() / 1000).str() ++ " +0800", "-m", "Scheduled movement " ++ d2 ++ "p: the body walks with no rented mind"]);
   // a later commit quotes the landing's subject in its body: a message is not a subject
   let quoted = epb-git(w, "quote", ["commit", "-q", "--allow-empty", "--date=" ++ (epb-now() / 1000).str() ++ " +0800", "-m", "a note", "-m", "Scheduled movement " ++ d4 ++ ": the body walks with no rented mind"]);
   let p = epb-publish(w);
   // a row and a landing that never reached the ref
   let inTree = epb-write(w, "receipts/crossings-ledger.jsonl", crossings ++ epb-kept(epb-night(0, 30), "scheduled " ++ d0 ++ "y"));
   let stamp = epb-write(w, ".hearth/walk.began", "pid=92701 at=" ++ (epb-night(4, 0) + 1000).str() ++ " door=scheduled-walk\n");
   0;
  }
  // no row qualifies: every row reads off the schedule, and the ref holds only them
  def epb-write-none(w) {
   let a = epb-write(w, "receipts/crossings-ledger.jsonl", epb-kept(epb-night(0, 25), "walk-here " ++ epb-day-name(0)) ++ epb-crossing(epb-night(0, 26), "scheduled " ++ epb-day-name(0), "session", "/bin/zsh", 1, ""));
   let b = epb-write(w, "receipts/rent-ledger.jsonl", epb-rent("scheduled " ++ epb-day-name(0), 0, 1, "fkwu-model-session", ""));
   let e = epb-write(w, "docs/rent-to-zero-goal.form", epb-goal());
   let i = epb-init(w);
   let c = epb-commit(w, "Scheduled movement " ++ epb-day-name(0) ++ ": a session said so", ["."]);
   epb-publish(w);
  }
  // E4 and E5 hold here: form-cli names S1, an S1 row reads 6 cited, every provider row reads observed
  def epb-write-holds(w) {
   let a = epb-write(w, "form/form-stdlib/form-cli.fk", "def fc-ask(q) = fgs-answer(q);\n");
   let a2 = epb-write(w, "form/form-stdlib/form-cli-repl.fk", "def fc-repl-ask(q) = fc-s1-ask(q);\n");
   let b = epb-write(w, "receipts/rent-ledger.jsonl", epb-rent("voice walk", 0, 1, "fkwu-model-session", "") ++ epb-rent("S1 pinned", 40, 6, "fkwu-model-session", ",\"door\":\"S1\",\"citation_keys_offered\":8") ++ epb-rent("a provider turn", 13, 6, "provider", ",\"kind\":\"observed\""));
   0;
  }
  // E4 short at rent; E5 with no turn and no door
  def epb-write-quiet(w) = epb-write(w, "receipts/rent-ledger.jsonl", epb-rent("voice walk", 20000, 6, "fkwu-model-session", ""));
  def epb-write-e5-wall(w) {
   let named = epb-write(w, "form/form-stdlib/form-cli.fk", "// fgs-answer named in a comment calls nothing\ndef fc-ask(q) = q;\n");
   let quoted = epb-write(w, "form/form-stdlib/form-cli-repl.fk", "// fc-s1-ask named in a comment calls nothing\n");
   let a = epb-write(w, "form/form-stdlib/bml/review-panel.bml", "// a door\n");
   let b = epb-write(w, "receipts/rent-ledger.jsonl", epb-rent("a provider turn", 13, 1, "provider", "") ++ epb-rent("voice walk", 0, 1, "fkwu-model-session", ",\"citation_keys_offered\":2"));
   hch-mkdirs(epb-dir() ++ "/panel/1793");
  }
  // the same landing with a gate that runs the band of the code it touched
  def epb-write-gated(w) {
   let m = "scheduled " ++ epb-day-name(1);
   let a = epb-write(w, "receipts/crossings-ledger.jsonl", epb-kept(epb-night(1, 20), m));
   let b = epb-write(w, "receipts/rent-ledger.jsonl", epb-rent(m, 0, 1, "fkwu-model-session", ""));
   let e = epb-write(w, "docs/rent-to-zero-goal.form", epb-goal());
   let t = epb-write(w, "form/form-stdlib/bml/x-touched.bml", "// touched\n");
   let g = epb-write(w, "gate/drift-gates.bml", "dg-row(\"x\", \"form/form-stdlib/tests/x-touched-band.bml\", nothing(), 1),\ndg-row(\"y\", \"form/form-stdlib/tests/drift-gates-band.bml\", nothing(), 1),\n");
   let i = epb-init(w);
   let c = epb-commit(w, "Scheduled movement " ++ epb-day-name(1) ++ ": the body walks with no rented mind", ["."]);
   epb-publish(w);
  }
  // a landing whose commit carries a band witness: the tree is read from the index the commit is made of, so a witness names the tree that lands ("") or another.
  // A witness is [band, "value/full", tree or "", paths]
  def epb-commit-witnessed(root, subject, paths, witness) {
   let added = epb-git(root, "add", append(["add", "-f", "--"], paths));
   let tree = trim(hch-said(epb-git(root, "tree", ["write-tree"])));
   let lines = map(x => "Band-Witness: " ++ x[0] ++ " " ++ x[1] ++ " " ++ ((String) x[2] == "" ? tree : x[2]) ++ " " ++ x[3], witness);
   epb-git(root, "commit", append(["commit", "-q", "--allow-empty", "--date=" ++ (epb-now() / 1000).str() ++ " +0800", "-m", subject], nil?(lines) ? [] : ["-m", str-join-with(lines, "\n")]));
  }
  def epb-turn-subject(hhmm) = "Native turn " ++ epb-day-name(1) ++ " " ++ hhmm ++ ": the body's own loop, no rented mind";
  // a turn's code landed with no gate row and no band of its own, its queued gap's band read at its full over the tree that landed: E6 holds
  def epb-write-witness(w) {
   let m = "scheduled " ++ epb-day-name(1);
   let a = epb-write(w, "receipts/crossings-ledger.jsonl", epb-kept(epb-night(1, 20), m));
   let t = epb-write(w, "form/form-stdlib/bml/y-turned.bml", "// the voice's edit\n");
   let i = epb-init(w);
   let c = epb-commit-witnessed(w, "Scheduled movement " ++ epb-day-name(1) ++ ": the body walks with no rented mind", ["."], [["form/form-stdlib/tests/y-gap-band.bml", "31/31", "", "form/form-stdlib/bml/y-turned.bml"]]);
   epb-publish(w);
  }
  // five native turns, each landing code whose witness does not stand: its band short of its full, a witness over another tree, a witness naming another file, a file
  // whose own band stands at its commit, and a gate row added after the landing, which ran nothing when it landed
  def epb-write-short(w) {
   let d = epb-day-name(1);
   let hhmm = ["0351", "0352", "0353", "0354", "0355"];
   let a = epb-write(w, "receipts/crossings-ledger.jsonl", foldl((acc, k) => acc ++ epb-kept(epb-night(1, 20 + k), "native-turn " ++ d ++ " " ++ hhmm[k - 1]), "", [1, 2, 3, 4, 5]));
   let i = epb-init(w);
   let c0 = epb-commit(w, "the ledger lands under a subject of no movement", ["receipts/crossings-ledger.jsonl"]);
   let b = "form/form-stdlib/tests/s-gap-band.bml";
   let t1 = epb-write(w, "form/form-stdlib/bml/s-short.bml", "// short\n");
   let c1 = epb-commit-witnessed(w, epb-turn-subject(hhmm[0]), ["form/form-stdlib/bml/s-short.bml"], [[b, "6/31", "", "form/form-stdlib/bml/s-short.bml"]]);
   let t2 = epb-write(w, "form/form-stdlib/bml/s-tree.bml", "// another tree\n");
   let c2 = epb-commit-witnessed(w, epb-turn-subject(hhmm[1]), ["form/form-stdlib/bml/s-tree.bml"], [[b, "31/31", "4b825dc642cb6eb9a060e54bf8d69288fbee4904", "form/form-stdlib/bml/s-tree.bml"]]);
   let t3 = epb-write(w, "form/form-stdlib/bml/s-other.bml", "// another file\n");
   let c3 = epb-commit-witnessed(w, epb-turn-subject(hhmm[2]), ["form/form-stdlib/bml/s-other.bml"], [[b, "31/31", "", "form/form-stdlib/bml/s-elsewhere.bml"]]);
   let t4 = epb-write(w, "form/form-stdlib/bml/s-own.bml", "// a file with a band of its own\n");
   let t4b = epb-write(w, "form/form-stdlib/tests/s-own-band.bml", "// its own band\n");
   let c4 = epb-commit-witnessed(w, epb-turn-subject(hhmm[3]), ["form/form-stdlib/bml/s-own.bml", "form/form-stdlib/tests/s-own-band.bml"], [[b, "31/31", "", "form/form-stdlib/bml/s-own.bml"]]);
   let t5 = epb-write(w, "form/form-stdlib/bml/s-late.bml", "// a gate came later\n");
   let c5 = epb-commit-witnessed(w, epb-turn-subject(hhmm[4]), ["form/form-stdlib/bml/s-late.bml"], []);
   let g = epb-write(w, "gate/drift-gates.bml", "dg-row(\"s\", \"form/form-stdlib/tests/s-late-band.bml\", nothing(), 1),\n");
   let c6 = epb-commit(w, "a gate row lands after the turn, under a subject of no movement", ["gate/drift-gates.bml"]);
   epb-publish(w);
  }
  // an on-schedule row with no coordinating_rent column: its rent is unknown, never 0. Its landing touched code, and only a comment in the gates names that code's band
  def epb-write-nocol(w) {
   let t = epb-write(w, "form/form-stdlib/bml/x-touched.bml", "// touched\n");
   let g = epb-write(w, "gate/drift-gates.bml", "// form/form-stdlib/tests/x-touched-band.bml\n");
   let m = "scheduled " ++ epb-day-name(1);
   let a = epb-write(w, "receipts/crossings-ledger.jsonl", "{\"at_unix_ms\":" ++ epb-night(1, 20).str() ++ ",\"movement\":\"" ++ m ++ "\",\"coordinated_by\":\"host-schedule\",\"coordinator\":\"/sbin/launchd\",\"rented_mind\":0}\n");
   let b = epb-write(w, "receipts/rent-ledger.jsonl", epb-rent(m, 0, 1, "fkwu-model-session", ""));
   let e = epb-write(w, "docs/rent-to-zero-goal.form", epb-goal());
   let i = epb-init(w);
   let c = epb-commit(w, "Scheduled movement " ++ epb-day-name(1) ++ ": the body walks with no rented mind", ["."]);
   epb-publish(w);
  }
  def epb-write-logs() {
   let a = write_file_text(epb-dir() ++ "/night.log", epb-gates(42, 31, 63, 0, 7, epb-now() - 3000));
   let b = write_file_text(epb-dir() ++ "/day-red.log", epb-gates(42, 31, 55, 8, 8, epb-now() - 2000));
   let c = write_file_text(epb-dir() ++ "/day-older.log", epb-gates(42, 31, 55, 8, 9, epb-now() - 4000));
   let d = write_file_text(epb-dir() ++ "/old.log", epb-gates(42, 31, 63, 0, 6, epb-now() - 8 * epb-day()));
   write_file_text(epb-dir() ++ "/none.log", "no gate here\n");
  }
  // ---- the door --------------------------------------------------------------------------------------------------------
  def epb-door(name, request) {
   let base = epb-dir() ++ "/" ++ name;
   let w = write_file_text(base ++ ".in", request);
   let pid = host_spawn_at(["./fkwu", "observe/exit-proof-run.bml"], [base ++ ".in", base ++ ".out", base ++ ".err"]);
   let status = pid <= 0 ? -1 : host_wait(pid);
   [status, read_file(base ++ ".out") ?? "", read_file(base ++ ".err") ?? ""];
  }
  def epb-q(s) = "\"" ++ s ++ "\"";
  def epb-request(root, logs, ledger, panel) = "{\"root\":" ++ epb-q(root) ++ ",\"walk\":" ++ epb-q(root) ++ ",\"logs\":[" ++ str-join-with(map(l => epb-q(epb-dir() ++ "/" ++ l), logs), ",") ++ "],\"ledger\":" ++ epb-q(ledger) ++ ",\"panel_dir\":" ++ epb-q(panel) ++ ",\"now_ms\":" ++ epb-now().str() ++ ",\"zone_ms\":" ++ epb-zone().str() ++ "}";
  def epb-main() = epb-dir() ++ "/main";
  def epb-none() = epb-dir() ++ "/none";
  def epb-holds() = epb-dir() ++ "/holds";
  def epb-quiet() = epb-dir() ++ "/quiet";
  def epb-e5w() = epb-dir() ++ "/e5w";
  def epb-empty() = epb-dir() ++ "/empty";
  def epb-nocol() = epb-dir() ++ "/nocol";
  def epb-gated() = epb-dir() ++ "/gated";
  def epb-witness() = epb-dir() ++ "/witness";
  def epb-short() = epb-dir() ++ "/short";
  def epb-ledger() = epb-dir() ++ "/ledger.jsonl";
  def epb-line(out, id) = foldl((best, l) => epb-has?(l, "[exit-proof] " ++ id ++ ":") ? l : best, "", split-on(out, "\n"));
  // the commit whose own subject names the landing, read over every commit of the ref
  def epb-sha(root, ref) = foldl((best, l) => epb-has?(l, " Scheduled movement " ++ epb-day-name(4) ++ ":") ? substring(l, 0, 40) : best, "", split-on(hch-said(epb-git(root, "sha", ["log", ref, "--format=%H %s"])), "\n"));
  // ---- the claims ------------------------------------------------------------------------------------------------------
  def epb-c-e1(ctx) {
   let l = epb-line(ctx[0][1], "E1");
   (Comparable) ctx[0][0] == 0 && epb-has?(l, "E1: holds — scheduled " ++ epb-day-name(4) ++ " at ") && epb-has?(l, "coordinator /sbin/launchd, rented_mind 0, rent 0, answered 9 bytes by fkwu-model-session, receipts cited 2, landed " ++ substring(epb-sha(epb-main(), "origin/main"), 0, 9) ++ " on origin/main") && epb-has?(l, "the stamp's pid 92701 is the pid the voice's evidence names") && !epb-has?(l, "walk-here");
  }
  def epb-c-e1-wall(ctx) = epb-has?(epb-line(ctx[1][1], "E1"), "E1: wall — ") && epb-has?(epb-line(ctx[1][1], "E1"), "no crossings row on the schedule reads rented_mind 0 on origin/main") && epb-has?(epb-line(ctx[4][1], "E1"), "E1: unread — no crossings or rent ledger on origin/main");
  def epb-c-e2(ctx) {
   let l = epb-line(ctx[0][1], "E2");
   epb-has?(l, "E2: holds — the second column of L1..L3 sums to 11285699") && epb-has?(l, "session-rent-ledger 105 tokens over 2 session(s), rented-work-sessions 70 over 1") && epb-has?(epb-line(ctx[1][1], "E2"), "E2: wall — the score is read at E1, which does not hold; the column reads 11285699");
  }
  def epb-c-e3(ctx) {
   let l = epb-line(ctx[0][1], "E3");
   epb-has?(l, "E3: holds — L1 coordinating 10527049 -> over the last 7 days: ") && epb-has?(l, "walk-here " ++ epb-day-name(0)) && epb-has?(l, "on the schedule at coordinating rent 0") && epb-has?(epb-line(ctx[1][1], "E3"), "E3: wall — E1 does not hold")
   && epb-has?(epb-line(ctx[8][1], "E1"), "E1: holds — ") && epb-has?(epb-line(ctx[8][1], "E3"), "E3: wall — the nearest window") && epb-has?(epb-line(ctx[8][1], "E3"), "(1 with no such column, unknown)");
  }
  def epb-c-e4(ctx) {
   let main = epb-line(ctx[5][1], "E4");
   let holds = epb-line(ctx[2][1], "E4");
   let rent = epb-line(ctx[3][1], "E4");
   epb-has?(main, "E4: wall — wall s1-not-default:") && epb-has?(main, "wall s1-receipts-cited:") && epb-has?(main, "through the voice walk, not S1") && epb-has?(main, "2 receipt key(s) offered") && epb-has?(main, "no door serves S1")
   && epb-has?(holds, "E4: holds — the pinned reading S1 pinned through S1: rent 40 <= 10000 holds") && epb-has?(holds, "receipts cited by an existing path 6 >= 6 holds, 8 receipt key(s) offered")
   && epb-has?(rent, "E4: wall — wall s1-not-default:") && epb-has?(rent, "rent 20000 <= 10000 fails");
  }
  def epb-c-e5(ctx) {
   let wall = epb-line(ctx[5][1], "E5");
   epb-has?(wall, "E5: wall — wall headless-share:") && epb-has?(wall, "the rent ledger's last provider row is a provider turn") && epb-has?(wall, "1 review panel run(s) this host still holds, which land no row") && epb-has?(wall, "0 of 2 turn(s) read kind=observed") && epb-has?(wall, "1 door(s) can launch one (form/form-stdlib/bml/review-panel.bml)")
   && epb-has?(epb-line(ctx[2][1], "E5"), "E5: holds — ") && epb-has?(epb-line(ctx[2][1], "E5"), "1 of 1 turn(s) read kind=observed")
   && epb-has?(epb-line(ctx[3][1], "E5"), "E5: holds — no door can launch a provider and no turn stands");
  }
  def epb-c-e6(ctx) {
   epb-has?(epb-line(ctx[0][1], "E6"), "E6: holds — the walk's own last gate lines (" ++ epb-dir() ++ "/night.log, ") && epb-has?(epb-line(ctx[0][1], "E6"), "ground 42, freshness 31, drift-gates pass=63 full=63 refused=0 names=-")
   && epb-has?(epb-line(ctx[1][1], "E6"), "E6: wall — wall regression: the walk's own last gate lines (" ++ epb-dir() ++ "/day-red.log, ") && epb-has?(epb-line(ctx[1][1], "E6"), "drift-gates pass=55 full=63 refused=8")
   && epb-has?(epb-line(ctx[4][1], "E6"), "E6: unread — no gate lines in ")
   && epb-has?(epb-line(ctx[7][1], "E6"), "E6: wall — wall stale-gates: the newest gate lines (" ++ epb-dir() ++ "/old.log) are from a walk begun ")
   && epb-has?(epb-line(ctx[8][1], "E6"), "E6: wall — wall step-unread: a native landing inside 7 days touched code whose band no gate runs (") && epb-has?(epb-line(ctx[8][1], "E6"), " form/form-stdlib/bml/x-touched.bml") && epb-has?(epb-line(ctx[8][1], "E6"), "), so that nothing a step touched broke stands unread; ")
   && epb-has?(epb-line(ctx[9][1], "E6"), "E6: holds — the walk's own last gate lines (")
   && epb-has?(epb-line(ctx[10][1], "E6"), "E6: holds — the walk's own last gate lines (")
   && epb-has?(epb-line(ctx[11][1], "E6"), "E6: wall — wall step-unread: a native landing inside 7 days touched code whose band no gate runs (")
   && all?(p => epb-has?(epb-line(ctx[11][1], "E6"), " form/form-stdlib/bml/" ++ p ++ ".bml"), ["s-short", "s-tree", "s-other", "s-own", "s-late"]);
  }
  def epb-c-row(ctx) {
   let reg = read_file(epb-ledger()) ?? "";
   let bad = epb-door("bad", "{\"moon\":1}");
   epb-has?(ctx[0][1], "[exit-proof] summary: 6 readings: holds ") && epb-has?(ctx[0][1], "ledger " ++ epb-ledger() ++ " appended") && epb-has?(reg, "\"E1\":\"holds\",\"E1_reading\":\"scheduled ") && epb-has?(reg, "\"E4\":\"wall\",\"E4_reading\":\"wall s1-not-default") && epb-has?(reg, "\"ref\":\"origin/main\",\"ref_sha\":\"") && (Comparable) bad[0] != 0 && epb-has?(bad[1] ++ bad[2], "exit-proof");
  }
  def epb-c-live(ctx) {
   let live = ctx[6];
   (Comparable) live[0] == 0 && all?(id => (String) epb-line(live[1], id) != "", ["E1", "E2", "E3", "E4", "E5", "E6"]) && epb-has?(live[1], "[exit-proof] summary: 6 readings:") && epb-has?(live[1], "ledger none") && !epb-has?(epb-line(live[1], "E1"), "E1: unread");
  }
  def epb-clean() = fs-remove-tree(epb-dir());
  def epb-run() {
   let swept = epb-clean();
   let a = hch-mkdirs(epb-dir() ++ "/io");
   let b = map(d => hch-mkdirs(d), [epb-main(), epb-none(), epb-holds(), epb-quiet(), epb-e5w(), epb-empty(), epb-nocol(), epb-gated(), epb-witness(), epb-short()]);
   let c = epb-write-main(epb-main());
   let d = epb-write-none(epb-none());
   let e = epb-write-holds(epb-holds());
   let f = epb-write-quiet(epb-quiet());
   let g = epb-write-e5w-world();
   let h = epb-write-logs();
   let n = epb-write-nocol(epb-nocol());
   let n2 = epb-write-gated(epb-gated());
   let n3 = epb-write-witness(epb-witness());
   let n4 = epb-write-short(epb-short());
   let i = epb-git(epb-empty(), "init-empty", ["init", "-q", "."]);
   let ctx = [
    epb-door("main", epb-request(epb-main(), ["night.log", "day-older.log"], epb-ledger(), epb-dir() ++ "/no-panel")),
    epb-door("none-world", epb-request(epb-none(), ["night.log", "day-red.log"], "", epb-dir() ++ "/no-panel")),
    epb-door("holds-world", epb-request(epb-holds(), ["night.log"], "", epb-dir() ++ "/no-panel")),
    epb-door("quiet-world", epb-request(epb-quiet(), ["night.log"], "", epb-dir() ++ "/no-panel")),
    epb-door("empty-world", epb-request(epb-empty(), ["none.log"], "", epb-dir() ++ "/no-panel")),
    epb-door("e5w-world", epb-request(epb-e5w(), ["night.log"], "", epb-dir() ++ "/panel")),
    epb-door("live", "{\"ledger\":\"\"}"),
    epb-door("stale-world", epb-request(epb-quiet(), ["old.log"], "", epb-dir() ++ "/no-panel")),
    epb-door("nocol-world", epb-request(epb-nocol(), ["night.log"], "", epb-dir() ++ "/no-panel")),
    epb-door("gated-world", epb-request(epb-gated(), ["night.log"], "", epb-dir() ++ "/no-panel")),
    epb-door("witness-world", epb-request(epb-witness(), ["night.log"], "", epb-dir() ++ "/no-panel")),
    epb-door("short-world", epb-request(epb-short(), ["night.log"], "", epb-dir() ++ "/no-panel"))];
   let verdict = live-claims("exit-proof-band", ctx, [["e1", 1, 1, epb-c-e1], ["e1-wall", 2, 1, epb-c-e1-wall], ["e2", 4, 1, epb-c-e2], ["e3", 8, 1, epb-c-e3], ["e4", 16, 1, epb-c-e4], ["e5", 32, 1, epb-c-e5], ["e6", 64, 1, epb-c-e6], ["row", 128, 1, epb-c-row], ["live", 256, 1, epb-c-live]]);
   let cleaned = epb-clean();
   verdict;
  }
  def epb-write-e5w-world() = epb-write-e5-wall(epb-e5w());
 }
 epb-run();
}
