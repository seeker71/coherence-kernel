; sovereign-field-band.fk — the third coverage state, proven on a claim this
; tree actually made today.
;
; BITS 32, 64 AND 128 ARE THE HISTORY, NOT AN EXAMPLE. On 2026-08-26 the
; safetensors parser band read 4095 over twelve honest bits while
; observe/lora-index-run.fk printed header bytes -2201022797451419013 beside a
; correct data start. A sibling ran the reporter and found it. Every bit in the
; band was true; no bit ran the reporter; and there was no place to say so.
;
; Reconstructed as claims: the 4095 claim ASKED the parser surface and declared
; nothing out of view, so `lora-index-run` answered NOTHING — silent, and not
; knowing it was silent. The 8191 claim asks it. The name moved from field to
; sovereign, which is the only direction that movement runs.
;
; Verdict 4095 (12 bits):
;   1     a name that was asked reads 1
;   2     a name declared out of view reads 0 — knowingly silent
;   4     a name in neither list reads NOTHING — silent, unknowingly
;   8     the three states are pairwise distinct on one claim
;   16    a claim declaring no horizon answers nothing to everything outside
;         it, and so cannot be told apart from one that saw everything
;   32    the 4095 claim answers NOTHING about the reporter
;   64    the 8191 claim answers 1 about the reporter
;   128   that is a widening: nothing -> 1
;   256   declaring is also a widening: nothing -> 0, without asking anything
;   512   a name already sovereign does not widen again
;   1024  width counts both lists; asking and declaring each add one
;   2048  a declared-unseen name and a never-considered name are DIFFERENT
;         states of the same claim, and folding them together loses which of
;         them anyone could have known
;
; preludes: form-stdlib/sovereign-field.fk

(do
    (defn sfb-bit (ok bit) (if ok bit 0))

    ; the claim as it stood at 4095 — twelve bits over the parser alone
    (defn sfb-4095 ()
        (sf-claim 4095
            (list "sfh-header-len" "sfh-dataoff" "sfh-bind" "sfh-lora-present?")
            (list)))

    ; the claim as it stands at 8191, after the reporter was brought in
    (defn sfb-8191 ()
        (sf-claim 8191
            (list "sfh-header-len" "sfh-dataoff" "sfh-bind" "sfh-lora-present?"
                  "lora-index-run" "sfh-reading-coherent?")
            (list "metal-bind" "overlay-matvec")))

    (defn sfb-reporter () "lora-index-run")

    (defn sovereign-field-band ()
        (do
            (let c (sf-claim 7 (list "a" "b") (list "c")))
            (let bare (sf-claim 1 (list "a") (list)))
            (let before (sfb-4095))
            (let after (sfb-8191))
            (let r (sfb-reporter))
            (let declared (sf-declare before "metal-bind"))

            (sum (list
                (sfb-bit (eq (sf-covers? c "a") 1) 1)
                (sfb-bit (eq (sf-covers? c "c") 0) 2)
                (sfb-bit (nothing? (sf-covers? c "z")) 4)

                (sfb-bit (and (eq (sf-covers? c "a") 1)
                         (and (eq (sf-covers? c "c") 0)
                              (nothing? (sf-covers? c "z")))) 8)

                (sfb-bit (and (eq (sf-horizon-declared? bare) 0)
                         (and (nothing? (sf-covers? bare "c"))
                              (nothing? (sf-covers? bare "z")))) 16)

                ; the day's history
                (sfb-bit (and (nothing? (sf-covers? before r))
                              (eq (sf-horizon-declared? before) 0)) 32)
                (sfb-bit (and (eq (sf-covers? after r) 1)
                              (eq (sf-horizon-declared? after) 1)) 64)
                (sfb-bit (eq (sf-widened? before after r) 1) 128)

                ; declaring an edge widens without asking anything
                (sfb-bit (and (eq (sf-widened? before declared "metal-bind") 1)
                         (and (eq (sf-covers? declared "metal-bind") 0)
                              (eq (len (sf-asked declared))
                                  (len (sf-asked before))))) 256)

                (sfb-bit (eq (sf-widened? after after r) 0) 512)

                (sfb-bit (and (eq (sf-width before) 4)
                         (and (eq (sf-width declared) 5)
                              (eq (sf-width (sf-ask before "x")) 5))) 1024)

                ; 0 and nothing are not the same silence
                (sfb-bit (and (eq (sf-covers? after "metal-bind") 0)
                         (and (nothing? (sf-covers? after "never-named"))
                              (eq (sf-horizon-declared? after) 1))) 2048)))))

    (sovereign-field-band))
