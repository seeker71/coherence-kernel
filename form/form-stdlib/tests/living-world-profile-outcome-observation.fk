; Privacy-safe aggregate observation for profile-outcome tissue movement.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk

(do
    (let result (lwpow-run))
    (let placement-candidate (nth (node_children result) 14))
    (let placement-world (nth (node_children result) 15))
    (let tissue-proposal (nth (node_children result) 17))
    (let successor-candidate (nth (node_children result) 18))
    (let tissue-world (nth (node_children result) 19))
    (let placement (lwo-emergent-shape placement-candidate))
    (let successor (lwo-emergent-shape successor-candidate))
    (list
        (lwo-field-size (lwph-placement-confirmed placement))
        (lwo-field-size (lwph-placement-diverged placement))
        (lwo-field-size (lwph-placement-unresolved placement))
        (lwo-field-size (lwht-tissue-compatible successor))
        (lwo-field-size (lwht-tissue-contradicted successor))
        (lwo-field-size (lwht-tissue-unresolved successor))
        (lwo-field-size (lwht-tissue-hypotheses successor))
        (lwht-candidate-current? placement-world successor-candidate)
        (lwht-candidate-current? tissue-world successor-candidate)
        (lwo-active? tissue-world successor-candidate)
        (lwht-integrated-current? tissue-world successor-candidate)
        (if (node_eq (lwt-proposal-candidate tissue-proposal)
                successor-candidate) 1 0)
        (if (eq (lwht-contradicted?
                    (lwht-tissue-status successor)) 1) 1 0)))
