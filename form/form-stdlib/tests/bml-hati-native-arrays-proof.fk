; tests/bml-hati-native-arrays-proof.fk
;
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk
;
; general-arrays. `#(a, b)` literals carry any expression as an element
; (names, sums, nested literals) and `a[i]` indexes a literal, a const, a
; mutable local or another index. The Hati lane lowers a literal to a cons
; list (tag 19) and an index to nth (tag 23); the BMA reference lane builds
; the same list with its array op and reads it with its index op. An index
; the compiler can already see past the end, or into a value that is no
; array, is named before any table exists.

(do
    (defn score-bool (actual)
        (if actual 1 0))

    (defn score-int (actual expected)
        (if (eq actual expected) 1 0))

    (defn score-str (actual expected)
        (if (str_eq (value_kind actual) "string")
            (if (str_eq actual expected) 1 0)
             0))

    (defn str-contains? (haystack needle)
        (ge (str_find haystack needle 0) 0))

    (defn parse (source)
        (bml-source-parse-executable-stream (bml-source-scan-text source)))

    (defn node-of (source)
        (bml-source-exec-parse-node (parse source)))

    (let literal-parsed (parse "return #(3, 5)[1];\n"))
    (let literal-node (bml-source-exec-parse-node literal-parsed))
    (let literal-image (bml-hati-compile-image literal-node))
    (let literal-table (bml-hati-table-file literal-image))

    (let local-node (node-of "int[] a = #(2, 4, 6);\nreturn a[2] + a[0];\n"))
    (let const-node (node-of "const int[] a = #(7, 9);\nconst int i = 1;\nreturn a[i];\n"))
    (let nested-node (node-of "return #(#(1, 2), #(3, 4))[1][0];\n"))
    (let element-node (node-of "int x = 5;\nreturn #(x, x + 1)[1];\n"))
    (let rebind-node (node-of "int[] a = #(1, 2);\na = #(8, 9);\nreturn a[0];\n"))

    ;; an array is itself a value on both lanes
    (let value-node (node-of "return #(3, 5);\n"))
    (let value-hati (bml-hati-run-value value-node))
    (let value-bma (bma-run-value (bml-compile-program value-node)))

    ;; the fixed one-int literal row reads as an executable statement
    (let int-parsed (parse "#(6)\n"))

    (let oob-image (bml-hati-compile-image (node-of "return #(3, 5)[2];\n")))
    (let scalar-image (bml-hati-compile-image (node-of "const int k = 4;\nreturn k[0];\n")))

    (sum
        (list
            (score-bool (bml-source-exec-parse-ok? literal-parsed))
            (score-int (len (bml-source-exec-parse-rest literal-parsed)) 0)
            (score-str (head (bml-source-exec-parse-rules literal-parsed)) "return-expr")
            (score-int (bma-run-value (bml-compile-program literal-node)) 5)
            (score-bool (bml-hati-image-supported? literal-image))
            (score-int (fk-tag (head (bml-hati-image-fns literal-image))) 23)
            (score-bool (not (str-contains? literal-table "BML-HATI-UNSUPPORTED")))
            (score-int (bml-hati-run-value literal-node) 5)
            (score-int (bma-run-value (bml-compile-program local-node)) 8)
            (score-int (bml-hati-run-value local-node) 8)
            (score-int (bma-run-value (bml-compile-program const-node)) 9)
            (score-int (bml-hati-run-value const-node) 9)
            (score-int (bma-run-value (bml-compile-program nested-node)) 3)
            (score-int (bml-hati-run-value nested-node) 3)
            (score-int (bma-run-value (bml-compile-program element-node)) 6)
            (score-int (bml-hati-run-value element-node) 6)
            (score-int (bma-run-value (bml-compile-program rebind-node)) 8)
            (score-int (bml-hati-run-value rebind-node) 8)
            (score-int (len value-hati) 2)
            (score-int (nth value-hati 1) 5)
            (score-int (len value-bma) 2)
            (score-int (nth value-bma 0) 3)
            (score-bool (bml-source-exec-parse-ok? int-parsed))
            (score-str (head (bml-source-exec-parse-rules int-parsed)) "array-int")
            (score-int (head (bml-hati-run-value (bml-source-exec-parse-node int-parsed))) 6)
            (score-str (head (bml-hati-image-unsupported oob-image)) "index/out-of-range")
            (score-bool (str-contains? (bml-hati-table-file oob-image) "BML-HATI-UNSUPPORTED index/out-of-range"))
            (score-str (head (bml-hati-image-unsupported scalar-image)) "index/not-array"))))
