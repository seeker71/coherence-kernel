; iq4nl-dequant-band.fk — exact GGML type-20 carver against b10686.
;
; preludes: form-stdlib/core.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/iq4nl-layout.bml form-stdlib/iq4nl-dequant.fk
;
; Independent C oracle: tests/iq4nl-ggml-oracle.c. Verdict 63.

(do
    (defn iq4nlb-byte (i)
        (if (eq i 0) 0
        (if (eq i 1) 60
            (do (let q (sub i 2)) (add q (mul 16 (sub 15 q)))))))
    (defn iq4nlb-build (i acc)
        (if (eq i (IQ4NLBlockBytes)) (reverse acc)
            (iq4nlb-build (add i 1) (cons (iq4nlb-byte i) acc))))
    (defn iq4nlb-bit (ok bit) (if ok bit 0))
    (defn iq4nlb-sum (bytes i acc)
        (if (eq i 32) acc
            (iq4nlb-sum bytes (add i 1)
                (add acc (float_to_int (mul 1000000.0 (iq4nl-at-flat bytes 0 i)))))))
    (let bytes (iq4nlb-build 0 (empty)))
    (let c0 (iq4nlb-bit (if (eq (IQ4NLGGMLType) 20) (if (eq (IQ4NLBlockElements) 32) (eq (IQ4NLBlockBytes) 18) 0) 0) 1))
    (let c1 (iq4nlb-bit (if (eq (float_to_int (mul 1000000.0 (iq4nl-at-flat bytes 0 0))) -127000000) (eq (float_to_int (mul 1000000.0 (iq4nl-at-flat bytes 0 15))) 113000000) 0) 2))
    (let c2 (iq4nlb-bit (if (eq (float_to_int (mul 1000000.0 (iq4nl-at-flat bytes 0 16))) 113000000) (eq (float_to_int (mul 1000000.0 (iq4nl-at-flat bytes 0 31))) -127000000) 0) 4))
    (let c3 (iq4nlb-bit (eq (iq4nlb-sum bytes 0 0) -188000000) 8))
    (let c4 (iq4nlb-bit (if (eq (iq4nl-slot-admissible 2560 640) 1) (eq (iq4nl-slot-threads 2560) 81920) 0) 16))
    (let authority (read_file "form/form-stdlib/bml/iq4nl-layout.bml"))
    (let c5 (iq4nlb-bit (if (ge (str_find authority "const int GGMLType = 20" 0) 0) (ge (str_find authority "const int BlockBytes = 18" 0) 0) 0) 32))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
