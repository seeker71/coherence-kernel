; preludes: form-stdlib/core.fk form-stdlib/f64-bytes.fk form-stdlib/wire-corba-cdr.fk form-stdlib/voice-render.fk
;
; f64-wire-band — the mouth's floats travel EXACTLY: WAV format 3, 64-bit IEEE, bit-for-bit.
;
; Four-way: 2047 on go, rust, ts and the repo-root fkwu (witnessed 2026-09-03); deliberately NOT in fourth-arm-bands.txt.
; The pre-flattened fourth-arm lane miscomputes the decode leg IN THE FULL voice-render-band and
; only there: ten reductions on 2026-07-30 — same chain, same functions, computed args, nth args,
; 8-arity calls, do-let bodies, 260-defn padding, cross-file recompose — every one crosses four-way
; green; the unreduced band answers 511 against the walkers' 2047, decode numb-empty. The defect
; needs the whole band as its habitat and is reproducible on demand by re-adding these legs to
; voice-render-band. Owned in fourth-arm-bands.txt's standing-walls note; this band keeps the
; CLAIMS proven on the arms that carry them rather than holding the wire hostage to the hunt.
;
; Verdict 2047 when every claim lands. Bits 1..511 mirror nothing — they are fresh here:
;   1    the f64 header is the canonical 44 bytes with computed sizes: 6 samples → RIFF size 92−8
;   2    format code 3 (IEEE float) at byte 20 — not PCM wearing a float name
;   4    64 bits per sample at byte 34, block align 8 at byte 32
;   8    byte-rate is rate×8 at byte 28
;   16   the body is 8 bytes per sample: len = 44 + 48
;   32   a NEGATIVE value's sign bit survives the wire: −0.25 comes back negative
;   64   ZERO comes back zero (the all-zero encoding, both directions)
;   128  π returns to the LAST BIT: eq on floats, no epsilon, no rounding
;   256  every one of the six probe values returns bit-identical (two-sided compare — an empty
;        decode equals nothing; the one-sided draft of this compare passed vacuously once)
;   512  DETERMINISM: the same samples give the same wire bytes, twice
;   1024 the wire rejects nothing it carried: decoded length equals encoded length
(do
    (defn fwb-alleq (a b)
        (if (nil? a) (if (nil? b) 1 0)
            (if (nil? b) 0
                (if (eq (head a) (head b)) (fwb-alleq (tail a) (tail b)) 0))))
    (let fx (list 0.5 -0.25 0.7182617 -1.0 0.0 3.141592653589793))
    (let fb (vrn-wav-f64-bytes fx 8000))
    (let dec (vrn-f64-samples (vrn-body-f64 fx)))

    (let c0 (if (eq (nth fb 4) 84) (if (eq (nth fb 5) 0) 1 0) 0))
    (let c1 (if (eq (nth fb 20) 3) 2 0))
    (let c2 (if (eq (nth fb 34) 64) (if (eq (nth fb 32) 8) 4 0) 0))
    (let c3 (if (eq (nth fb 28) 0) (if (eq (nth fb 29) 250) 8 0) 0))
    (let c4 (if (eq (len fb) 92) 16 0))
    (let c5 (if (lt (nth dec 1) 0.0) 32 0))
    (let c6 (if (eq (nth dec 4) 0.0) 64 0))
    (let c7 (if (eq (nth dec 5) 3.141592653589793) 128 0))
    (let c8 (if (eq (fwb-alleq dec fx) 1) 256 0))
    (let c9 (if (eq (fwb-alleq (vrn-wav-f64-bytes fx 8000) fb) 1) 512 0))
    (let c10 (if (eq (len dec) (len fx)) 1024 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9 c10)))))))))))
