; Form tensor recipes on native Metal. Behavior and refusals travel together.
; preludes: form-stdlib/native-tensor.bml
; Verdict 63.
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk

(do
    (defn mqb-score (ok bit) (if ok bit 0))
    (defn mqb-has (hay needle) (if (lt (str_find hay needle 0) 0) 0 1))
    (defn mqb-live? () (mqb-has (nt-status) "metal_linked=true"))
    (defn mqb-path () "/tmp/fk-native-tensor-q8-band-fixture.bin")
    (defn mqb-qs (k acc) (if (gt k 32) acc (mqb-qs (add k 1) (str_concat acc (byte_to_str k)))))
    (defn mqb-block (lo hi) (str_concat (byte_to_str lo) (str_concat (byte_to_str hi) (mqb-qs 1 ""))))
    (defn mqb-bytes () (str_concat (mqb-block 0 60) (mqb-block 0 64)))
    (defn mqb-prog (off r c tail)
        (str_concat "q8 " (str_concat (mqb-path)
        (str_concat " " (str_concat (int_to_str off)
        (str_concat " " (str_concat (int_to_str r)
        (str_concat " " (str_concat (int_to_str c) (str_concat " " (str_concat tail " i32")))))))))))
    (defn native-tensor-q8-band ()
        (do
    (let wrote (fs-write-text (mqb-path) (mqb-bytes)))
    (let c0 (mqb-score (and (eq wrote 68) (eq (mqb-live?) 1)) 1))
    (let c1 (mqb-score (if (eq (mqb-live?) 1)
                           (eq (nt-eval (mqb-prog 0 1 32 "sum")) 528) 0) 2))
    (let c2 (mqb-score (if (eq (mqb-live?) 1)
                           (eq (nt-eval (mqb-prog 34 1 32 "sum")) 1056) 0) 4))
    (let c3 (mqb-score (if (eq (mqb-live?) 1)
                           (eq (nt-eval (mqb-prog 0 1 32
                               "32 iota 0 mul 1 add r2 32 1 f32 matmul"))
                               528) 0) 8))
    (let c4 (mqb-score (if (eq (mqb-live?) 1)
                           (nt-refused (mqb-prog 0 1 33 "sum") "q8 shape needs whole quant blocks") 0) 16))
    (let c5 (mqb-score (if (eq (mqb-live?) 1)
                           (nt-refused (mqb-prog 0 1 320 "sum") "q8 file is shorter than the shape asked for") 0) 32))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
    )
    (native-tensor-q8-band))
