; Isolated private journal: idempotence, exclusion, failed-target separation and pending census.
; preludes: form-stdlib/native-session-memory.bml
(do
 (let home (str_concat "/tmp/native-session-memory-" (nsm-id)))
 (let excluded (nsm-record home "s" "e" "native" "x" "bad" "verified-answer" "check" 1))
 (let noSideEffect (le (file_size home) 0))
 (let one (nsm-record home "s" "e" "native" "Say hello." "Hello." "verified-answer" "fixture-check=pass" 0))
 (let again (nsm-record home "s" "e" "native" "Say hello." "Hello." "verified-answer" "fixture-check=pass" 0))
 (let failed (nsm-record home "s" "failure" "local-model" "secret prompt" "wrong answer" "checker-failed" "exit=1" 0))
 (let record (nsm-json (nsm-at failed "record.json")))
 (let census (nsm-census home (nsm-dirs home) 0 (list)))
 (if (and (eq (nsm-num census "retained_examples") 2) (eq (nsm-num census "distinct_sessions") 1)) 1 (form_error "session corpus census confused events and sessions"))
 (let checks (list (str_eq excluded "evaluation-excluded") noSideEffect (str_eq one again)
   (eq (len (nsm-pending home (nsm-dirs home))) 2)
   (str_eq (nsm-str record "objective") "observed-execution-status")
   (lt (str_find (json-emit record) "wrong answer" 0) 0)
   (lt (str_find (nsm-text (nsm-at home "events.jsonl")) "Say hello" 0) 0)))
 (fs-remove-tree home)
 (print checks)
 (if (value_eq checks (list 1 1 1 1 1 1 1)) 127 (form_error "session memory witness failed")))
