; form-teach-layer-band.fk — the teaching layer is shareable text, not a GGUF edit.
;
; preludes: form-stdlib/form-teach-layer.fk
;
; Four-way: no model file is opened.
; Verdict 1023 when every claim holds.

(do
    (defn ftlb (ok bit) (if ok bit 0))
    (let sys (ftl-system-text))
    (let wrapped (ftl-wrapped-prompt "hello"))
    (sum (list
        (ftlb (eq (len (ftl-controls)) 8) 1)
        (ftlb (str_eq (ftl-ctl-tag (ftl-ctl-locate "timeout")) "<TIMEOUT>") 2)
        (ftlb (eq (len (ftl-concepts)) 11) 4)
        (ftlb (eq (ftl-has? "Blueprint") 1) 8)
        (ftlb (eq (ftl-has? "Cell") 1) 16)
        (ftlb (eq (ftl-has? "NL-to-form") 1) 32)
        (ftlb (ge (str_find sys "<CHOICE>" 0) 0) 64)
        (ftlb (and (eq (ftl-shareable? "qwen35") 1)
                   (eq (ftl-shareable? "llama") 1)) 128)
        (ftlb (and (str_eq (ftl-writer-kind "qwen35") "system-prefix")
                   (str_eq (ftl-writer-payload "qwen35") (ftl-writer-payload "llama"))) 256)
        (ftlb (and (eq (ftl-shareable? "deepseek4") 0)
                   (str_eq (ftl-writer-kind "deepseek4") "control-logit")) 512))))
