; A token stream proves generation, not semantic sufficiency. Keep generated,
; accepted, and nothing/unadjudicated distinct before a grounding comparison.
;
; preludes: form-stdlib/form-cli-dsv4-local.fk

(do
    (let some (fdl-generation-adjudication 8))
    (let none (fdl-generation-adjudication 0))
    (sum
        (list
            (if (ge (str_find some
                "form-cli-local-ds4-generated:1" 0) 0) 1 0)
            (if (ge (str_find some
                "form-cli-local-ds4-accepted:0" 0) 0) 2 0)
            (if (ge (str_find some
                "form-cli-local-ds4-sufficiency:unadjudicated" 0) 0) 4 0)
            (if (ge (str_find none
                "form-cli-local-ds4-sufficiency:nothing" 0) 0) 8 0))))
