; form-cli-peer-grounded-symbol-answer-band.fk -- a grounded task cannot enter
; the model until an admission-born symbol becomes a current-source observation.
;
; preludes: form-stdlib/form-cli-peer-grounded-symbol-answer.fk

(do
    (defn fcpagsab-bit (held weight) (if held weight 0))
    (defn fcpagsab-root ()
        (fs-path-join (fs-temp-dir) "form-cli-peer-grounded-symbol-answer-band"))
    (defn fcpagsab-setup ()
        (do
            (let root (fcpagsab-root))
            (let _old (fs-remove-tree root))
            (let _root (fs-mkdir root))
            (let _form (fs-mkdir (fs-path-join root "form")))
            (let _source (fs-write-text (fs-path-join root "form/unique.fk")
                "(defn unique-defn () \"Choice is a source-held exact acknowledgement for grounded symbol questions.\")"))
            root))
    (defn fcpagsab-context (root)
        (fcpalsa-source-context root "artifact"
            (sof-snapshot 17 (list "form")
                (list (list "unique-defn" "form/unique.fk"))) 17))
    (defn form-cli-peer-grounded-symbol-answer-band ()
        (do
            (let root (fcpagsab-setup))
            (let session (fcms-none "model-not-opened-in-source-band"))
            (let context (fcpagsab-context root))
            (let ready (fcpagsa-task
                "unique-defn :: What does the source hold about choice?"))
            (let malformed (fcpagsa-task "unique-defn"))
            (let result (fcpagsa-run session
                "unique-defn :: What does the source hold about choice?"
                context 1))
            (let source (fcpagsa-symbol-result result))
            (let observation (fcpagsa-source-observation result))
            (let direct (fcpagsa-direct-result result))
            (let peer (fcpagsa-peer result))
            (let unborn (fcpagsa-run session
                "unborn-defn :: What does the source hold?" context 2))
            (let absent-context (fcpagsa-run session
                "unique-defn :: What does the source hold?" (nothing) 3))
            (let score (sum (list
                (fcpagsab-bit (and (str_eq (fcpagsa-task-status ready) "value")
                                   (and (str_eq (fcpagsa-task-symbol ready)
                                                "unique-defn")
                                   (and (str_eq (fcpagsa-task-question ready)
                                                "What does the source hold about choice?")
                                        (str_eq (fcpagsa-task-reason ready)
                                                "ground-task-ready")))) 1)
                (fcpagsab-bit (and (str_eq (fcpagsa-task-status malformed)
                                            "choice")
                                   (str_eq (fcpagsa-task-reason malformed)
                                           "ground-requires-symbol-delimiter-question")) 2)
                (fcpagsab-bit (and (str_eq (fcpssa-signal source) "value")
                                   (and (str_eq (fcpagsa-observation-status observation)
                                                "hit")
                                   (and (ge (str_find (fcpagsa-observation-span observation)
                                                      "source-path=form/unique.fk" 0) 0)
                                   (and (ge (str_find (fcpagsa-observation-span observation)
                                                      "model-executed=0" 0) 0)
                                        (ge (str_find (fcpagsa-observation-span observation)
                                                      "(defn unique-defn" 0) 0))))) 4)
                ; The model seat is intentionally unavailable here, but the
                ; returned direct result proves it was offered only after the
                ; source observation reached the constructed user-turn task.
                (fcpagsab-bit (and (str_eq (fcpagsa-signal result) "nothing")
                                   (and (str_eq (fcpagsa-reason result)
                                                "model-session-not-live")
                                   (and (str_eq (fcpdaa-signal direct) "nothing")
                                   (ge (str_find (fcpagsa-model-task
                                                    (fcpagsa-task-question ready)
                                                    observation)
                                                 "source-path=form/unique.fk" 0) 0)))) 8)
                (fcpagsab-bit (and (str_eq (fcpagsa-signal unborn) "nothing")
                                   (and (str_eq (fcpagsa-reason unborn)
                                                "symbol-unborn")
                                   (and (nothing? (fcpagsa-source-observation unborn))
                                        (nothing? (fcpagsa-direct-result unborn))))) 16)
                (fcpagsab-bit (and (str_eq (fcpagsa-signal absent-context)
                                            "choice")
                                   (and (str_eq (fcpagsa-reason absent-context)
                                                "source-index-absent")
                                   (and (nothing? (fcpagsa-source-observation absent-context))
                                        (nothing? (fcpagsa-direct-result absent-context))))) 32)
                (fcpagsab-bit (and (str_eq (fcpa-route peer) "grounded-answer")
                                   (and (eq (fcpa-callback-calls peer) 0)
                                   (and (eq (fcpa-contribution peer) 0)
                                   (and (eq (fcpa-lookup-count peer) 2)
                                        (value_eq (fcpa-session peer) session))))) 64))))
            (let _cleanup (fs-remove-tree root))
            score))
    (form-cli-peer-grounded-symbol-answer-band))
