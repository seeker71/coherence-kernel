; living-world-resonance-witness.fk -- offered tissue for resonance bands.
;
; All names and domain shapes here are fixtures, never organ vocabulary.  Small
; constructor functions keep each native source unit shallow enough that the
; witness observes the organ rather than source-prescan depth.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk

(let LWRW-SOURCE-KIND (bp "LWRW-SOURCE-SHAPE"))
(let LWRW-TARGET-KIND (bp "LWRW-TARGET-SHAPE"))
(let LWRW-ACTION      (bp "LWRW-ACTION"))

(defn lwrw-action () LWRW-ACTION)
(defn lwrw-interface () (lwo-interface (list LWRW-ACTION)))
(defn lwrw-source-a () (intern_trivial_string "lwrw-source-a"))
(defn lwrw-source-b () (intern_trivial_string "lwrw-source-b"))
(defn lwrw-source-c () (intern_trivial_string "lwrw-source-c"))
(defn lwrw-source-d () (intern_trivial_string "lwrw-source-d"))
(defn lwrw-provenance-a () (intern_trivial_string "lwrw-provenance-a"))
(defn lwrw-provenance-b () (intern_trivial_string "lwrw-provenance-b"))
(defn lwrw-provenance-c () (intern_trivial_string "lwrw-provenance-c"))
(defn lwrw-provenance-d () (intern_trivial_string "lwrw-provenance-d"))
(defn lwrw-response-provenance ()
    (intern_trivial_string "lwrw-response-provenance"))
(defn lwrw-marker () (intern_trivial_string "lwrw-observed-constant"))

(defn lwrw-left-a ()
    (lwo-compose LWRW-SOURCE-KIND
        (list (intern_trivial_string "alice")
              (intern_trivial_string "red"))))
(defn lwrw-right-a ()
    (lwo-compose LWRW-TARGET-KIND
        (list (intern_trivial_string "red")
              (intern_trivial_string "alice") (lwrw-marker))))
(defn lwrw-left-b ()
    (lwo-compose LWRW-SOURCE-KIND
        (list (intern_trivial_string "bob")
              (intern_trivial_string "blue"))))
(defn lwrw-right-b ()
    (lwo-compose LWRW-TARGET-KIND
        (list (intern_trivial_string "blue")
              (intern_trivial_string "bob") (lwrw-marker))))
(defn lwrw-left-c ()
    (lwo-compose LWRW-SOURCE-KIND
        (list (intern_trivial_string "carol")
              (intern_trivial_string "green"))))
(defn lwrw-right-c ()
    (lwo-compose LWRW-TARGET-KIND
        (list (intern_trivial_string "carol")
              (intern_trivial_string "green") (lwrw-marker))))
(defn lwrw-unseen-input ()
    (lwo-compose LWRW-SOURCE-KIND
        (list (intern_trivial_string "dana")
              (intern_trivial_string "yellow"))))
(defn lwrw-expected-output ()
    (lwo-compose LWRW-TARGET-KIND
        (list (intern_trivial_string "yellow")
              (intern_trivial_string "dana") (lwrw-marker))))

(defn lwrw-correspondence-a ()
    (lwr-correspondence (lwrw-left-a) (lwrw-right-a)))
(defn lwrw-correspondence-b ()
    (lwr-correspondence (lwrw-left-b) (lwrw-right-b)))
(defn lwrw-correspondence-c ()
    (lwr-correspondence (lwrw-left-c) (lwrw-right-c)))

(defn lwrw-offer (source payload provenance)
    (lwo-offer source (lwrw-interface) 1 payload provenance 1))
(defn lwrw-entry (source payload provenance)
    (lwt-entry (lwrw-offer source payload provenance) (lwrw-action)))

(defn lwrw-correspondence-entries ()
    (list
        (lwrw-entry (lwrw-source-a) (lwrw-correspondence-a)
                    (lwrw-provenance-a))
        (lwrw-entry (lwrw-source-b) (lwrw-correspondence-b)
                    (lwrw-provenance-b))
        (lwrw-entry (lwrw-source-c) (lwrw-correspondence-c)
                    (lwrw-provenance-c))))

(defn lwrw-base-round (threshold)
    (lwr-tend (lwo-empty-world) (lwrw-correspondence-entries)
              threshold (lwo-none)))
(defn lwrw-first-proposal (round)
    (head (lwo-field-items (lwt-round-proposals round))))
(defn lwrw-candidate (proposal) (lwt-proposal-candidate proposal))

(defn lwrw-yes-response (proposal)
    (lwt-response proposal (oac-one (lwrw-candidate proposal))
                  (lwrw-response-provenance)))
(defn lwrw-no-response (proposal)
    (lwt-response proposal (oac-zero) (lwrw-response-provenance)))
(defn lwrw-response-entry (source provenance response)
    (lwrw-entry source response provenance))

(defn lwrw-support-yes-round (round proposal)
    (lwt-round-receive round
        (list
            (lwrw-response-entry (lwrw-source-a) (lwrw-provenance-a)
                                 (lwrw-yes-response proposal))
            (lwrw-response-entry (lwrw-source-b) (lwrw-provenance-b)
                                 (lwrw-yes-response proposal)))))

(defn lwrw-dissent-round (round proposal)
    (lwt-round-receive round
        (list (lwrw-response-entry
            (lwrw-source-c) (lwrw-provenance-c)
            (lwrw-no-response proposal)))))

(defn lwrw-revoked-dissent-round (round proposal)
    (do
        (let revocation
            (lwo-revocation (lwrw-no-response proposal) (lwrw-source-c)
                (intern_trivial_string "lwrw-response-revised")
                (lwrw-provenance-c)))
        (lwt-round-receive round
            (list (lwrw-entry (lwrw-source-c) revocation
                              (lwrw-provenance-c))))))

(defn lwrw-unanimous-mapping-round (dissent-round proposal)
    (lwt-round-receive
        (lwrw-revoked-dissent-round dissent-round proposal)
        (list (lwrw-response-entry
            (lwrw-source-c) (lwrw-provenance-c)
            (lwrw-yes-response proposal)))))

(defn lwrw-integrated-mapping-round (base-round proposal)
    (do
        (let support-round (lwrw-support-yes-round base-round proposal))
        (let dissent-round (lwrw-dissent-round support-round proposal))
        (let unanimous-round
            (lwrw-unanimous-mapping-round dissent-round proposal))
        (lwt-integrate unanimous-round proposal (lwrw-action))))

(defn lwrw-input-world (mapping-world)
    (lwt-receive-stream mapping-world
        (list (lwrw-entry (lwrw-source-d) (lwrw-unseen-input)
                          (lwrw-provenance-d)))))

(defn lwrw-application-round (input-world mapping-candidate prior)
    (lwr-application-round input-world mapping-candidate
                           (lwrw-unseen-input) prior))

(defn lwrw-application-yes (application-proposal)
    (lwt-response application-proposal
        (oac-one (lwrw-candidate application-proposal))
        (lwrw-response-provenance)))

(defn lwrw-application-yes-entry (source provenance proposal)
    (lwrw-response-entry source provenance
                         (lwrw-application-yes proposal)))

(defn lwrw-partial-application-round (round proposal)
    (lwt-round-receive round
        (list
            (lwrw-application-yes-entry
                (lwrw-source-a) (lwrw-provenance-a) proposal)
            (lwrw-application-yes-entry
                (lwrw-source-b) (lwrw-provenance-b) proposal)
            (lwrw-application-yes-entry
                (lwrw-source-c) (lwrw-provenance-c) proposal))))

(defn lwrw-unanimous-application-round (partial-round proposal)
    (lwt-round-receive partial-round
        (list (lwrw-application-yes-entry
            (lwrw-source-d) (lwrw-provenance-d) proposal))))

(defn lwrw-input-revoked-round (unanimous-round)
    (do
        (let revocation
            (lwo-revocation (lwrw-unseen-input) (lwrw-source-d)
                (intern_trivial_string "lwrw-input-withdrawn")
                (lwrw-provenance-d)))
        (lwt-round-receive unanimous-round
            (list (lwrw-entry (lwrw-source-d) revocation
                              (lwrw-provenance-d))))))

(defn lwrw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwrw-sum (tail items)))))
