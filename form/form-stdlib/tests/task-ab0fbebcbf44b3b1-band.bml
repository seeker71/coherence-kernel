; Native case observations; the final reading is their conjunction.
; Verdict 1
; Claims 0-3 read the refusal. Claims 4-8 read the question lane over receipts this band writes under temp_dir and removes
; (fcaq-decoded-in, ftv-session-at), one fresh session per request, as fcaq-decoded takes one: what follows a question travels in
; the request's fields. The living receipts move as the body speaks, so they answer no claim here: who over the checkout's newest
; three names whoever they name, and the behavior that stays is read over fixtures. The fixture's names and dates are the claims.
; preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-code-memory.bml form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 class QuestionLaneBand {
  // one fixture root: <root>receipts/<name> per [name, text], each written whole
  def qlb-plant(root, rows) {
   let made = fs_mkdir(substring(root, 0, len(root) - 1)) + fs_mkdir(root ++ "receipts");
   all?(row => (Comparable) write_file(root ++ "receipts/" ++ row[0], row[1]) == len(row[1]), rows);
  }
  def qlb-ask(root, request) = fcaq-decoded-in(parse-json("question", request), ftv-session-at(root));
  def qlb-asked(root, goal) = qlb-ask(root, "{\"goal\":\"" ++ goal ++ "\"}");
  def qlb-follow(root, goal, asked) = qlb-ask(root, "{\"goal\":\"" ++ goal ++ "\",\"thread\":\"" ++ fcap-string(asked, "thread") ++ "\",\"offered\":\"" ++ fcap-string(asked, "offered") ++ "\",\"deepened\":\"" ++ fcap-string(asked, "deepened") ++ "\",\"context\":\"" ++ fcap-string(asked, "context") ++ "\"}");
  // a claim's row in the shape of the cases below, so a 0 names the claim that did not hold
  def qlb-row(name, actual, expected, held) {
   let said = print_str(json-emit(fcam-pack([name, value_kind(actual), actual, expected, held])));
   held;
  }
 }
 let all=true;
 let actual0=(fcaq-request-refusal(parse-json("empty", "{}")));
 let expected0="missing:goal,writable,checks";
 let held0=actual0==expected0;
 print_str(json-emit(fcam-pack(["fcaq-request-refusal(parse-json(\"empty\", \"{}\"))",value_kind(actual0),actual0,expected0,held0])));
 let all=all && held0;
 let actual1=(fcaq-request-refusal(parse-json("partial", "{\"goal\":\"inspect\",\"writable\":[]}")));
 let expected1="missing:checks";
 let held1=actual1==expected1;
 print_str(json-emit(fcam-pack(["fcaq-request-refusal(parse-json(\"partial\", \"{\\\"goal\\\":\\\"inspect\\\",\\\"writable\\\":[]}\"))",value_kind(actual1),actual1,expected1,held1])));
 let all=all && held1;
 let actual2=(fcaq-request-refusal(parse-json("two", "{\"checks\":[]}")));
 let expected2="missing:goal,writable";
 let held2=actual2==expected2;
 print_str(json-emit(fcam-pack(["fcaq-request-refusal(parse-json(\"two\", \"{\\\"checks\\\":[]}\"))",value_kind(actual2),actual2,expected2,held2])));
 let all=all && held2;
 let actual3=(fcaq-request-refusal(parse-json("all", "{\"goal\":\"inspect\",\"writable\":[],\"checks\":[]}")));
 let expected3="valid goal,writable,documents,checks required; review needs empty writable and report_checks; evaluation cannot resume";
 let held3=actual3==expected3;
 print_str(json-emit(fcam-pack(["fcaq-request-refusal(parse-json(\"all\", \"{\\\"goal\\\":\\\"inspect\\\",\\\"writable\\\":[],\\\"checks\\\":[]}\"))",value_kind(actual3),actual3,expected3,held3])));
 let all=all && held3;
 let base=temp_dir() ++ "/task-ab0fbebcbf44b3b1-band-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str();
 let made=fs_mkdir(base);
 let nobody=base ++ "/nobody/";
 let named=base ++ "/named/";
 let planted=qlb-plant(nobody, [["2026-01-02-trust-kept.md", "# Trust kept\nThe oldest receipt waits for the next ask.\n"], ["2026-03-04-trust-seam.md", "# The trust seam\nNo name stands here.\n"], ["2026-05-06-quiet-trust.md", "# A quiet trust\nIt stood in a corner.\n"], ["2026-07-08-trust-carried.md", "# Trust carried\nIt was carried by hand across the room.\n"]]) && qlb-plant(named, [["2026-08-09-trust-offered.md", "# Trust offered\nIt was carried by hand and offered by Ember.\n"]]);
 let all=all && planted;
 let three="receipts/2026-07-08-trust-carried.md: Trust carried | receipts/2026-05-06-quiet-trust.md: A quiet trust | receipts/2026-03-04-trust-seam.md: The trust seam";
 let asked=qlb-asked(nobody, "trust");
 let held4=qlb-row("ask: an authored sense, then the fixture's three newest", fcap-string(asked, "answer"), "value=trust: <sense> | " ++ three ++ ";", ((String) fcap-string(asked, "status") == "complete") && ((String) fcap-string(asked, "lane") == "query") && ((String) fcap-string(asked, "thread") == "trust") && ((String) fcap-string(asked, "offered") == "2026-07-08-trust-carried.md,2026-05-06-quiet-trust.md,2026-03-04-trust-seam.md") && ftv-starts?(fcap-string(asked, "answer"), "value=trust: ") && ftv-ends?(fcap-string(asked, "answer"), " | " ++ three ++ ";"));
 let all=all && held4;
 let further="value=" ++ fcap-string(asked, "context") ++ " | receipts/2026-01-02-trust-kept.md: Trust kept;";
 let next=qlb-follow(nobody, "continue", asked);
 let held5=qlb-row("next: continue keeps the earlier answer and reads the receipt not yet offered", fcap-string(next, "answer"), further, ((String) fcap-string(next, "status") == "complete") && ((String) fcap-string(next, "thread") == "trust") && ((String) fcap-string(next, "answer") == further) && ((String) fcap-string(next, "offered") == fcap-string(asked, "offered") ++ ",2026-01-02-trust-kept.md"));
 let all=all && held5;
 let keyed=qlb-follow(nobody, "trust", asked);
 let held6=qlb-row("keyed: a keyword of the thread reads the next of it", fcap-string(keyed, "answer"), further, ((String) fcap-string(keyed, "status") == "complete") && ((String) fcap-string(keyed, "thread") == "trust") && ((String) fcap-string(keyed, "answer") == further));
 let all=all && held6;
 let who=qlb-follow(nobody, "who", asked);
 let held7=qlb-row("who: lowercase after by names no one", fcap-string(who, "answer"), "nothing=no-who;", ((String) fcap-string(who, "status") == "complete") && ((String) fcap-string(who, "thread") == "trust") && ((String) fcap-string(who, "answer") == "nothing=no-who;") && ((String) fcap-string(who, "context") == fcap-string(asked, "context")) && ((String) fcap-string(who, "answer") != fcap-string(asked, "context")));
 let all=all && held7;
 let offered=qlb-asked(named, "trust");
 let whose=qlb-follow(named, "who", offered);
 let held8=qlb-row("who: a receipt's own text offered by a name reads that name", fcap-string(whose, "answer"), "value=Ember;", ((String) fcap-string(whose, "status") == "complete") && ((String) fcap-string(whose, "thread") == "trust") && ((String) fcap-string(whose, "answer") == "value=Ember;") && ((String) fcap-string(whose, "context") == fcap-string(offered, "context")));
 let all=all && held8;
 let gone=fs_rmdir(base);
 let all=all && ((Comparable) fs_is_dir(base) == 0);
 all ? 1 : 0;
}
