; cell-store-child.fk — the other process of cell-store-band: interns one composite cell
; and hands its pid and the raw references (not the cell) into a gift frame, then stays
; alive so the band can map this process's store and read the cell where it lives.
;
; preludes: form/form-stdlib/form-glass-gift-frame.bml

(do
    (let cat (intern_trivial_string "cell-store-band"))
    (let cell (intern_node cat (list (intern_trivial_int 2) (intern_trivial_int 3))))
    (let handle (ggf-offer "cell-store-band.child" 4096))
    (let given (node_gift_write handle (list (host_pid) (cell_ref cell) (cell_ref cat))))
    (let released (ggf-release handle))
    (host_sleep_ms 6000))
