; form-cli-allowance-birth-band.fk — BML names 2+3; form_cpu_jit births 5.
;
; Verdict 255:
;   1    BML lhs is 2
;   2    BML rhs is 3
;   4    BML expect is 5
;   8    BML add is 5
;   16   handle door is live
;   32   cpu jit pipeline installed
;   64   enqueue returned 1
;   128  buffer reads 5 and status shows cpu_jit_dispatch
;
; The AArch64 image is the same add the cpu-jit-pipeline-band already
; proved (7+5=12). Operands come from BML. Dispatch is form_cpu_jit.
;
; preludes: form-stdlib/form-asm.fk form-stdlib/metal-door.fk form-stdlib/form-cli-allowance-birth-xtal.fk
; witnessed: 2026-08-20 -> 255

(do
    (defn alb-bytes (xs)
        (if (eq (len xs) 0) ""
            (str_concat (byte_to_str (head xs)) (alb-bytes (tail xs)))))
    (let image
        (fa-image (list
            (fa-ldr 3 0 0)
            (fa-ldr-w 4 1 0)
            (fa-ldr-w 5 3 0)
            (fa-add-r 5 5 4)
            (fa-str-w 5 3 0)
            (fa-ret))))
    (let code (alb-bytes image))
    (let buffer (metal_buf_alloc 4))
    (metal_buf_write buffer 0 (md-le32 (alb-lhs)))
    (let pipeline (metal_pipeline code "form_cpu_jit"))
    (let enqueued (metal_enqueue pipeline (md-bind (list buffer) (list (alb-rhs))) 1))
    (let result (metal_buf_read buffer 0 4))
    (let status (metal_status))
    (metal_buf_free buffer)
    (add (alb-check)
        (add (if (md-door-live?) 16 0)
        (add (if (gt pipeline 0) 32 0)
        (add (if (eq enqueued 1) 64 0)
             (if (and (eq (str_len result) 4)
                      (and (eq (str_byte_at result 0) (alb-expect))
                       (and (eq (str_byte_at result 1) 0)
                        (and (eq (str_byte_at result 2) 0)
                         (and (eq (str_byte_at result 3) 0)
                              (ge (str_find status "cpu_jit_dispatch=" 0) 0))))))
                 128 0)))))
)
