; nl-lexicon-grow-band.fk — proves the Form-native projector form-stdlib/nl-lexicon-grow.fk.
;
; grow-rows parses two parallel json texts, walks them together (nested objects
; recursed, single-char keys filtered), lowercases, and emits neutral-symbol rows —
; all in Form. Expected output is built from the cell's OWN jlg-row emitter, so the
; band proves the walk + filter + assignment, not a hand-typed string.
;
; R36 adds the read-back fold: jlg-carry-m-rows reads every m<mid> row already
; living in an existing nl-lexicon-data.fk, and jlg-emit-cell carries each one
; forward, byte for byte, alongside the freshly-derived c<i> rows — a
; regeneration keeps every hand- or pivot-mint-minted pivot row, never drops
; one. The fixture here is a small planted
; file text (one c-row, one m-row), typed literally, never read from real disk —
; the disk-reading proof itself lives on scratch fixtures under /private/tmp,
; outside this band (see r36-proof.fk / r36-proof-nofile.fk in that session's
; scratch, or re-derive: this band only proves the PURE fold). Bitmask witness,
; across Go / Rust / TS / fkwu.
;
; preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/string-case.fk form-stdlib/nl-lexicon-grow.fk

(do
    (defn chk (got exp bit) (if (str_eq got exp) bit 0))
    (let en "{\"a\":\"Company\",\"x\":{\"c\":\"Home\"},\"n\":\"a\"}")
    (let id "{\"a\":\"perusahaan\",\"x\":{\"c\":\"rumah\"},\"n\":\"b\"}")

    ;; a planted existing-file text: one c-row (stands for prior projector output)
    ;; plus one m-row (stands for a hand- or pivot-mint-minted pivot row) —
    ;; same shape jlg-emit-cell itself emits, typed literally so the fixture
    ;; owes nothing to the function under test.
    (let planted-m-row "            (list \"m9999\" \"gas\" \"planted\" \"tertanam\")\n")
    (let planted-file
        (str_concat "(do\n    (defn nlt-corpus-lexicon ()\n        (list\n"
        (str_concat "            (list \"c0\" \"water\" \"old\" \"lama\")\n"
        (str_concat planted-m-row "        ))\n    0)\n"))))

    (add
        ;; full walk: nested "Home"/"rumah" + top "Company"/"perusahaan"; "a"/"b" too short, dropped
        (chk (grow-rows en id 10)
             (str_concat (jlg-row 0 "home" "rumah") (jlg-row 1 "company" "perusahaan")) 1)
    (add
        ;; the cap holds: only the first kept pair
        (chk (grow-rows en id 1) (jlg-row 0 "home" "rumah") 2)
    (add
        ;; jlg-carry-m-rows pulls exactly the one planted m-row, byte for byte —
        ;; no more, no less; the planted c-row is NOT carried (that is grow-rows'
        ;; own job, unchanged)
        (chk (jlg-carry-m-rows planted-file) planted-m-row 4)
    (add
        ;; first run: no existing file (read_file's `nothing`) carries zero rows
        (chk (jlg-carry-m-rows (core-nothing)) "" 8)
    (add
        ;; jlg-emit-cell folds the carried m-row in alongside the fresh c-rows —
        ;; a regeneration keeps the planted pivot row
        (if (ge (str_find (jlg-emit-cell (grow-rows en id 10) planted-file) planted-m-row 0) 0) 16 0)
    (add
        ;; ...and still emits the freshly-derived c-rows in the same regeneration
        (if (ge (str_find (jlg-emit-cell (grow-rows en id 10) planted-file) (jlg-row 0 "home" "rumah") 0) 0) 32 0)
        ;; first run (no existing file): jlg-emit-cell still emits the fresh rows,
        ;; carrying nothing forward because there was nothing to carry
        (if (ge (str_find (jlg-emit-cell (grow-rows en id 10) (core-nothing)) (jlg-row 0 "home" "rumah") 0) 0) 64 0))))))))
