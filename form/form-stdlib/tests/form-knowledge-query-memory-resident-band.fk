; form-knowledge-query-memory-resident-band.fk — the stage machine and the wire
; boundary, provable without a peer.
;
; WHAT THIS BAND DOES NOT DO. It does not contact a model. The live crossing has
; its own door — observe/qmx-resident-answer-live-run.fk against an
; already-running server — and a band that needed a peer would be red whenever
; the household's model was busy, which is most of the time. What is provable
; here is everything except the peer's own words: the stage order, the
; transitions, the nothing/zero distinction, the thought seam, and the wire
; decoding that turns a JSON escape into the byte it stands for.
;
; THE STAGE ORDER IS THE POINT. A crossing that stops reports WHERE, so the
; frames are returned in every outcome and the band reads them positionally.
;
; Verdict 2047 (11 bits):
;   1     a ready request produces five frames in stage order
;   2     a refused request stops at stage one, names its gate, and adds no more
;   4     a lookup that ran and missed keeps "miss" while ask and answer are
;         nothing — a ran-and-found-zero is not an absence
;   8     the wire decoder turns \n \t \" \\ into the bytes they stand for
;   16    a reply carrying a closed thought yields only what follows it
;   32    an UNFINISHED thought is nothing, never a short answer
;   64    a reply with no thought at all passes through, trimmed
;   128   the three frame states are distinct, and every frame carries one
;   256   model-executed is 0
;   512   the span the answer stage would carry is the RENDERED observation,
;         non-empty on a hit — the defect that made a live crossing answer from
;         an empty span while every stage reported that it ran
;   1024  every bit above ran against the live cells, not a restatement
;
; preludes: form-stdlib/form-knowledge-query-memory-resident.fk

(do
    (defn fqmrb-bit (ok bit) (if ok bit 0))

    (defn fqmrb-bytes-loop (s i n out)
        (if (ge i n) out (fqmrb-bytes-loop s (add i 1) n (cons (str-byte-at s i) out))))
    (defn fqmrb-rev (xs out)
        (if (eq (len xs) 0) out (fqmrb-rev (tail xs) (cons (head xs) out))))
    (defn fqmrb-bytes (s) (fqmrb-rev (fqmrb-bytes-loop s 0 (str_len s) (empty)) (empty)))
    (defn fqmrb-sha (s) (hex-encode (sha256-stream-string s)))

    (defn fqmrb-answer ()
        "Kernel deployment is live and verified by current production evidence.")
    (defn fqmrb-index-line ()
        (ric-emit-grounded "@1.1.9.41" "@8.4.4.12" "docs/deployment.form" "cell"
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            (hex-encode (sha256 (fqmrb-bytes (fqmrb-answer))))
            (hex-encode (fqmrb-bytes (fqmrb-answer)))
            (fqmrb-answer)
            (re-semantic-vec
                "deployment evidence kernel production verified witness")))

    (defn fqmrb-offer (anchor)
        (intern_node (fkqmx-offer-category)
            (list (intern_trivial_string (fkqmx-offer-schema))
                  (intern_trivial_string "band-source")
                  (intern_trivial_string
                      (str_concat (fkqmx-open-mark)
                          (str_concat anchor (fkqmx-close-mark))))
                  (intern_trivial_string (fqmrb-sha anchor)))))
    (defn fqmrb-mem (tag)
        (intern_node (make_nodeid 31 2 0 127) (list (intern_trivial_string tag))))

    (defn fqmrb-request (anchor tag stored)
        (do (let m (fqmrb-mem (str_concat tag "-m")))
            (let b (fqmrb-mem (str_concat tag "-b")))
            (let r (intern_node (fkqmrt-recipe-category)
                (list (intern_trivial_string (fkqmrt-recipe-schema))
                      m b (fqmrb-offer anchor)
                      (intern_trivial_string (fqmrb-sha (str_concat tag "-q")))
                      (intern_trivial_string (fqmrb-sha (str_concat tag "-s")))
                      (intern_trivial_string (fqmrb-sha (str_concat tag "-p")))
                      (intern_trivial_string (fqmrb-sha (str_concat tag "-y")))
                      (intern_trivial_string tag)
                      (intern_trivial_string "band-lane")
                      (intern_trivial_int 1) (intern_trivial_int 1)
                      (intern_trivial_int 0) (intern_trivial_int 0)
                      (intern_trivial_int stored) (intern_trivial_int 0))))
            (intern_node (fkqmrt-request-category)
                (list (intern_trivial_string (fkqmrt-request-schema))
                      (fkqmrt-action-node) r m b
                      (intern_trivial_string tag)
                      (intern_trivial_string "band-lane")
                      (intern_trivial_int 0) (intern_trivial_int 1)))))

    ; a port nothing listens on, so the ask stage reports a silent peer without
    ; needing one to be absent by luck
    (defn fqmrb-dead-port () 9)

    (defn fqmrb-stage-is? (frames i stage state)
        (do (let f (fqmr-stage-at frames i))
            (if (nothing? f) 0
                (if (and (str_eq (fqmr-frame-stage f) stage)
                         (str_eq (fqmr-frame-state f) state)) 1 0))))

    (defn fqmrb-all-stated? (frames i)
        (if (ge i (len frames)) 1
            (if (eq (fqmr-state? (fqmr-frame-state (nth frames i))) 0) 0
                (fqmrb-all-stated? frames (add i 1)))))

    (defn form-knowledge-query-memory-resident-band ()
        (do
            (let path (str_concat (temp_dir)
                "/form-knowledge-query-memory-resident-band.jsonl"))
            (let wrote (write_file path (fqmrb-index-line)))

            (let hit-req  (fqmrb-request "deployed proof kernel" "r1" 0))
            (let miss-req (fqmrb-request "banana photosynthesis galaxy" "r2" 0))
            (let bad-req  (fqmrb-request "deployed proof kernel" "r3" 1))

            ; a hit whose peer is not there: five frames, the first three ran
            (let hit-frames (fqmr-cross path hit-req "q?" "127.0.0.1"
                                (fqmrb-dead-port) 8))
            (let miss-frames (fqmr-cross path miss-req "q?" "127.0.0.1"
                                (fqmrb-dead-port) 8))
            (let bad-frames (fqmr-cross path bad-req "q?" "127.0.0.1"
                                (fqmrb-dead-port) 8))
            (let hit-obs (fkqmx-execute-at path hit-req 0))
            (let cleaned (fs_remove path))

            (sum (list
                (fqmrb-bit (and (gt wrote 0)
                           (and (eq (len hit-frames) 5)
                           (and (fqmrb-stage-is? hit-frames 0 "request" "ran")
                           (and (fqmrb-stage-is? hit-frames 1 "query" "ran")
                                (fqmrb-stage-is? hit-frames 2 "lookup" "ran"))))) 1)

                (fqmrb-bit (and (eq (len bad-frames) 1)
                           (and (fqmrb-stage-is? bad-frames 0 "request" "refused")
                                (str_eq (fqmr-frame-detail (nth bad-frames 0))
                                        "provenance-flags"))) 2)

                (fqmrb-bit (and (fqmrb-stage-is? miss-frames 2 "lookup" "ran")
                           (and (str_eq (fqmr-frame-detail (nth miss-frames 2))
                                        "miss")
                           (and (fqmrb-stage-is? miss-frames 3 "ask" "nothing")
                                (nothing? (fqmr-answer-of miss-frames))))) 4)

                (fqmrb-bit (and (str_eq (fqmr-unesc "a\\nb") "a\nb")
                           (and (str_eq (fqmr-unesc "x\\ty") "x\ty")
                           (and (str_eq (fqmr-unesc "q\\\"r") "q\"r")
                                (str_eq (fqmr-unesc "s\\\\t") "s\\t")))) 8)

                (fqmrb-bit (str_eq (fqmr-answer-part "<think>musing</think>  Yes.")
                                   "Yes.") 16)

                (fqmrb-bit (nothing? (fqmr-answer-part "<think>still going")) 32)

                (fqmrb-bit (str_eq (fqmr-answer-part "   plain answer")
                                   "plain answer") 64)

                (fqmrb-bit (and (eq (fqmr-state? (fqmr-state-ran)) 1)
                           (and (eq (fqmr-state? "invented") 0)
                           (and (eq (fqmrb-all-stated? hit-frames 0) 1)
                                (eq (fqmrb-all-stated? miss-frames 0) 1)))) 128)

                (fqmrb-bit (eq (fqmr-model-executed) 0) 256)

                ; the defect that made a live crossing answer from an empty span
                (fqmrb-bit (and (str_eq (fkqmx-obs-status hit-obs) "hit")
                           (and (gt (str_len (fkqmx-obs-span hit-obs)) 0)
                                (ge (str_find (fkqmx-obs-span hit-obs)
                                        (fkqt-observation-open) 0) 0))) 512)

                (fqmrb-bit (eq cleaned 0) 1024)))))

    (form-knowledge-query-memory-resident-band))
