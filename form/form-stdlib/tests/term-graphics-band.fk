; term-graphics-band.fk — the generic engine: one duration voice, one
; threshold scale, tones over codes, shade at three scales, panel fold.
; Expected: 4095
; preludes: form-stdlib/term-graphics.bml
(do
    (defn tgb-bit (ok bit) (if ok bit 0))
    (sum (list
        (tgb-bit (str_eq (tg-dur 850) "850ms") 1)
        (tgb-bit (str_eq (tg-dur 3200) "3s") 2)
        (tgb-bit (str_eq (tg-dur 240000) "4m") 4)
        (tgb-bit (str_eq (tg-dur 7200000) "2h") 8)
        (tgb-bit (str_eq (tg-scale 2 3 30) "good") 16)
        (tgb-bit (str_eq (tg-scale 10 3 30) "warn") 32)
        (tgb-bit (str_eq (tg-scale 40 3 30) "bad") 64)
        (tgb-bit (eq (str_len (tg-ramp 3)) 9) 128)
        (tgb-bit (eq (str_len (tg-bar 4 10)) 18) 256)
        (tgb-bit (eq (str_len (tg-spark (list 1 2 3 4))) 12) 512)
        (tgb-bit (ge (str_find (tg-span "good" "x") "[32m" 0) 0) 1024)
        (tgb-bit (ge (str_find (tg-lane-render (tg-lane "lbl " "val" "plain" (sub 0 1))) "lbl " 0) 0) 2048))))
