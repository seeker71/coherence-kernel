; term-graphics-band.fk — the generic engine: one duration voice, one
; threshold scale, tones over codes, shade at three scales, panel fold.
; Expected: 524287
; preludes: form-stdlib/term-graphics.bml
(do
    (defn tgb-bit (ok bit) (if ok bit 0))
    (sum (list
        (tgb-bit (str_eq (tg-dur 850) "850ms") 1)
        (tgb-bit (str_eq (tg-dur 3200) "3s") 2)
        (tgb-bit (str_eq (tg-dur 240000) "4m") 4)
        (tgb-bit (str_eq (tg-dur 7200000) "2h") 8)
        (tgb-bit (str_eq (tg-scale 2 3 30) "good") 16)
        (tgb-bit (str_eq (tg-scale 10 3 30) "warn") 32)
        (tgb-bit (str_eq (tg-scale 40 3 30) "bad") 64)
        (tgb-bit (eq (str_len (tg-ramp 3)) 9) 128)
        (tgb-bit (eq (str_len (tg-bar 4 10)) 18) 256)
        (tgb-bit (eq (str_len (tg-spark (list 1 2 3 4))) 12) 512)
        (tgb-bit (ge (str_find (tg-span "good" "x") "[32m" 0) 0) 1024)
        (tgb-bit (ge (str_find (tg-lane-render (tg-lane "lbl " "val" "plain" (sub 0 1))) "lbl " 0) 0) 2048)
        (tgb-bit (str_eq (tg-dur 172800000) "2d") 4096)
        (tgb-bit (and (str_eq (tg-dur-us 850) "850us") (str_eq (tg-dur-us 3200000) "3s")) 8192)
        (tgb-bit (and (str_eq (tg-count 1500) "1K") (and (str_eq (tg-count 2500000) "2M") (and (str_eq (tg-count 3000000000) "3G") (str_eq (tg-count 999) "999")))) 16384)
        (tgb-bit (and (str_eq (tg-bytes 2048) "2KiB") (and (str_eq (tg-bytes 1073741824) "1GiB") (and (str_eq (tg-bytes 3145728) "3MiB") (str_eq (tg-bytes 5) "5B")))) 32768)
        (tgb-bit (and (eq (tg-rung 0 (list 250 1000)) 0) (and (eq (tg-rung 999 (list 250 1000)) 1) (and (eq (tg-rung 1000 (list 250 1000)) 2) (eq (tg-rung 7 (list)) 0)))) 65536)
        (tgb-bit (and (str_eq (tg-cursor-to 2 3) (str_concat (tg-esc) "[4;3H")) (str_eq (tg-home) (str_concat (tg-cursor-home) (tg-screen-clear)))) 131072)
        (tgb-bit (and (str_eq (tg-fg-rgb 1 2 3) "38;2;1;2;3") (and (str_eq (tg-bg-rgb 4 5 6) "48;2;4;5;6") (ge (str_find (tg-span "bold" "x") "[1m" 0) 0))) 262144))))
