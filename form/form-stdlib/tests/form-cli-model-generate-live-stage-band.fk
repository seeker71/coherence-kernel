; form-cli-model-generate-live-stage-band.fk — a local Form generation speaks
; its next blocking stage on the flushed stream and retains its source-attributed
; stage coordinate in the framebuffer. This band exercises neither a model nor
; Metal; the normal generator calls this exact stage door around its real seal,
; open, prefill, decode, and return boundaries.
;
; Expected: 63
; preludes: form-stdlib/form-cli-model-generate.fk

(do
    (defn fcmglsb-bit (ok bit) (if ok bit 0))
    (defn fcmglsb-source? (event expected-line)
        (do
            (let source (node_source event))
            (if (eq (len source) 3)
                (if (eq (nth source 1) expected-line) 1 0) 0)))
    (defn form-cli-model-generate-live-stage-band ()
        (do
            (framebuffer-clear)
            (let first (fcmg-live-stage "model-prefill-begin" 4587521))
            (let second (fcmg-live-stage "model-decode-begin" 4849665))
            (let events (framebuffer-events))
            (sum (list
                (fcmglsb-bit (and (eq first 0) (eq second 0)) 1)
                (fcmglsb-bit (eq (len events) 2) 2)
                (fcmglsb-bit (fcmglsb-source? (head events) 70) 4)
                (fcmglsb-bit (fcmglsb-source? (head (tail events)) 74) 8)
                (fcmglsb-bit (and (eq (len (node_source (head events))) 3)
                    (eq (len (node_source (head (tail events)))) 3)) 16)
                (fcmglsb-bit (eq (len (framebuffer-events)) 2) 32)))))
    (form-cli-model-generate-live-stage-band))
