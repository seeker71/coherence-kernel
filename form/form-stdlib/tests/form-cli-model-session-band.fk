; form-cli-model-session-band.fk — pure shape proof for the persistent local
; Qwen conversation door. It opens no model and drives no carrier.
;
; Verdict 4095:
;   1    state shape keeps context, stream state, position and pending id
;   2    initial and resume encoding scopes are distinct
;   4    generated IDs are carried rather than reconstructed from decoded text
;   8    Form execution remains outside logits
;   16   a nothing session is not live and has no pending id
;   32   stream updates preserve context/state identity and counters
;   64   generated text and ids remain separate fields
;   128  a zero token id is a valid pending id, not nothing
;   256  stopped and position are explicit, not inferred from empty output
;   512  observation count and injected-id count are independent
;   1024 operation status is separate from physical residence ownership
;   2048 rejection closes the assistant without committing pending id 0/1
;
; preludes: form-stdlib/form-cli-model-session.fk

(do
    (defn fcmsb-bit (ok bit) (if ok bit 0))
    (defn fcmsb-assert (name ok)
        (if ok 1 (form_error (str_concat "model adapter boundary: " name))))
    (defn fcmsb-bytes (xs)
        (if (nil? xs) "" (str_concat (byte_to_str (head xs)) (fcmsb-bytes (tail xs)))))
    ; Tiny in-memory GGUF: the selected IDs exercise the actual tokenizer
    ; metadata walk, byte alphabet, output order and repeated/empty pieces.
    (defn fcmsb-u64 (n) (str_concat (byte_to_str n) (fcmsb-bytes (list 0 0 0 0 0 0 0))))
    (defn fcmsb-str (s) (str_concat (fcmsb-u64 (str_len s)) s))
    (defn fcmsb-token-rows (rows)
        (if (nil? rows) "" (str_concat (fcmsb-str (head rows)) (fcmsb-token-rows (tail rows)))))
    (defn fcmsb-token-source (letter)
        (str_concat "GGUF" (str_concat (fcmsb-bytes (list 3 0 0 0))
        (str_concat (fcmsb-u64 0) (str_concat (fcmsb-u64 1)
        (str_concat (fcmsb-str "tokenizer.ggml.tokens")
        (str_concat (fcmsb-bytes (list 9 0 0 0 8 0 0 0))
        (str_concat (fcmsb-u64 8) (fcmsb-token-rows (list "" letter "Ġ" "Ã©" "Ċ" "Ā" "Ń" "｜"))))))))))
    (let token-src (fcmsb-token-source "A"))
    (let token-ids (list 0 1 6 3 5 4 2 0 1 6))
    (fcmsb-assert "batch decode preserves byte alphabet and exact requested order"
        (value_eq (ftdb-bytes token-src token-ids) (list 65 173 195 169 0 10 32 65 173)))
    (fcmsb-assert "batch text preserves the reference rendering"
        (str_eq (ftdb-text token-src token-ids) (tkz-decode-text token-src token-ids)))
    (fcmsb-assert "empty decode needs no source" (str_eq (ftdb-text "" (list)) ""))
    (fcmsb-assert "zero and one are present token IDs"
        (value_eq (ftdb-bytes token-src (list 0 1 0 1)) (list 65 65)))
    (fcmsb-assert "a later source cannot reuse another vocabulary's pieces"
        (value_eq (ftdb-bytes (fcmsb-token-source "B") (list 1 1 1)) (list 66 66 66)))
    (fcmsb-assert "out-of-radius special token keeps reference behavior"
        (value_eq (ftdb-bytes token-src (list 7 7 0)) (tkz-decode-bytes token-src (list 7 7 0))))
    (fcmsb-assert "one high token keeps scalar lookup" (not (ftdb-batch? (ftdb-plan (list 7) 8))))
    (fcmsb-assert "repeated traversals choose the single pass" (ftdb-batch? (ftdb-plan token-ids 8)))
    (fcmsb-assert "negative oversized float and string IDs refuse before reading"
        (and (not (head (ftdb-plan (list -1) 8)))
        (and (not (head (ftdb-plan (list 8) 8)))
        (and (not (head (ftdb-plan (list 1.5) 8))) (not (head (ftdb-plan (list "1") 8)))))))
    (let ctx (list "opaque-model-context"))
    (let sts (list "opaque-stream-state"))
    (let s (fcms-session "live" "opened" "m.gguf" "src" ctx sts
        2048 41 0 0 40 3 7 1))
    (let s2 (fcms-with-stream s 44 9 1 6 12 2))
    (let absent (fcms-none "no-model"))
    (let refused-resident (fcms-session "nothing" "window-refused" "m.gguf"
        "src" ctx sts 2048 44 9 1 40 6 12 2))
    (let g (fcms-generation "bytes" (list 0 7 9) s2))
    (let ordinary (fcms-crossing-prefix-ids 0 0 77 1))
    (let stopped-prefix (fcms-crossing-prefix-ids 1 1 77 1))
    (let rejected-zero (fcms-crossing-prefix-ids 0 0 77 0))
    (let rejected-one (fcms-crossing-prefix-ids 1 0 77 0))
    ; Opaque numeric handles exercise ownership shape only; no device is opened.
    (let carrier (list "qwen-session-adapter-v1" "candidate.safetensors" "tensor-digest"
        (list 101 102 103 (qlh-width) (md-f32-bits 1.0))))
    (let carried (fcmd-with-carrier s carrier))
    (let advanced (fcms-with-stream carried 44 9 1 6 12 2))
    (let carrier-refused (fcms-refuse advanced "test-refusal"))
    (fcmsb-assert "ordinary sessions have no adapter" (nil? (fcmd-carrier s)))
    (fcmsb-assert "stream update keeps exact adapter owner" (value_eq (fcmd-carrier advanced) carrier))
    (fcmsb-assert "refusal keeps the owner for release" (value_eq (fcmd-carrier carrier-refused) carrier))
    (fcmsb-assert "refusal retains stream counters" (and (eq (fcms-pos carrier-refused) 44) (eq (fcms-generated-ids carrier-refused) 6)))
    (fcmsb-assert "adapter buffers have separate release accounting" (eq (fcmd-owned carrier) 3))
    (fcmsb-assert "partial allocation remains counted" (eq (fcmd-owned (list "qwen-session-adapter-v1" "p" "d" (list 101 102 0 (qlh-width) 0))) 2))
    (fcmsb-assert "second attachment refuses without replacing the first" (value_eq (fcmd-carrier (fcms-attach-adapter carried "other")) carrier))
    (fcmsb-assert "late attachment refuses before artifact access" (str_eq (fcms-reason (fcms-attach-adapter s "missing")) "adapter-admission-requires-fresh-session"))
    (fcmsb-assert "unadapted token zero remains a prediction" (eq (fcmd-pending (list) (list) 0) 0))
    (let zero (fcmsb-bytes (hex-decode "00000000")))
    (let one (fcmsb-bytes (hex-decode "0000803f")))
    (fcmsb-assert "finite byte pair accepted" (fcmd-pair-valid? zero one 1))
    (fcmsb-assert "short pair refused" (not (fcmd-pair-valid? zero "" 1)))
    (fcmsb-assert "infinity refused" (not (fcmd-pair-valid? zero (fcmsb-bytes (hex-decode "0000807f")) 1)))
    (fcmsb-assert "NaN refused" (not (fcmd-pair-valid? (fcmsb-bytes (hex-decode "0000c07f")) zero 1)))
    (fcmsb-assert "byte lists are not silently treated as strings" (not (fcmd-pair-valid? (list 0 0 0 0) zero 1)))
    (fcmsb-assert "tensor identity retains vector order" (not (str_eq (fcmd-pair-digest zero one) (fcmd-pair-digest one zero))))
    (sum (list
        (fcmsb-bit (and (str_eq (nth s 0) "form-cli-model-session-v1")
            (and (str_eq (head (fcms-ctx s)) "opaque-model-context")
            (and (str_eq (head (fcms-sts s)) "opaque-stream-state")
            (and (eq (fcms-pos s) 41) (eq (fcms-pending s) 0))))) 1)
        (fcmsb-bit (not (str_eq (fcms-initial-encode-scope)
                                (fcms-resume-encode-scope))) 2)
        (fcmsb-bit (and (ge (str_find (fcms-generated-id-policy) "original" 0) 0)
            (and (lt (str_find (fcms-generated-id-policy) "re-encode" 0) 0)
                 (ge (str_find (fcms-inline-bml-encode-scope)
                    "no-role-replay" 0) 0))) 4)
        (fcmsb-bit (eq (fcms-model-executed-form?) 0) 8)
        (fcmsb-bit (and (eq (fcms-live? absent) 0)
                        (eq (fcms-pending? absent) 0)) 16)
        (fcmsb-bit (and (node_eq (head (fcms-ctx s2)) (head ctx))
            (and (node_eq (head (fcms-sts s2)) (head sts))
            (and (eq (fcms-pos s2) 44)
            (and (eq (fcms-generated-ids s2) 6)
                 (eq (fcms-injected-ids s2) 12))))) 32)
        (fcmsb-bit (and (str_eq (fcms-generation-text g) "bytes")
            (and (eq (len (fcms-generation-ids g)) 3)
                 (eq (fcms-pending (fcms-generation-session g)) 9))) 64)
        (fcmsb-bit (and (eq (fcms-pending s) 0) (eq (fcms-pending? s) 1)) 128)
        (fcmsb-bit (and (eq (fcms-stopped? s2) 1) (eq (fcms-pos s2) 44)) 256)
        (fcmsb-bit (and (eq (fcms-observations s2) 2)
                        (eq (fcms-injected-ids s2) 12)) 512)
        (fcmsb-bit (and (eq (fcms-live? refused-resident) 0)
            (and (eq (fcms-resident? refused-resident) 1)
                 (eq (fcms-resident? absent) 0))) 1024)
        (fcmsb-bit (and (node_eq ordinary (list 0 77))
            (and (node_eq stopped-prefix (list 1))
            (and (node_eq rejected-zero (list 77))
            (and (node_eq rejected-one (list 77))
                 (ge (str_find (fcms-rejection-pending-policy)
                    "discard-uncommitted" 0) 0))))) 2048))))
