; form-knowledge-heldout-reproduction-band.fk — equal f1 does not mean equal
; answer, and here are two answers that prove it.
;
; BIT 4 IS THE WHOLE BAND. Two DIFFERENT replies are scored against one
; expected answer and land on the IDENTICAL f1 ppm, because f1 is
; round(2,000,000 * overlap / total) and both replies have the same overlap
; count and the same token count. Their actual-shas differ. From the ppm alone
; those two sittings are indistinguishable from a model that said the same
; thing twice — which is exactly the inference an exact reproduction invites.
;
; This does not overturn the anchored/fragile reading. It supplies the field
; that decides it, which the evaluator has been computing all along at index 3
; and which nothing reads.
;
; Verdict 255 (8 bits):
;   1    the index contract holds against a LIVE observation, not a restatement
;   2    the same reply twice: same f1, same actual-sha, relation is anchored
;   4    DIFFERENT replies, IDENTICAL f1, different actual-sha -> coincident
;   8    a changed reply with a changed score is moved
;   16   the three relations are distinct names
;   32   anchor evidence requires the ANSWER, not the score: bit 4's pair is
;        refused as anchor evidence while bit 2's pair is accepted
;   64   held-out safe: every value this cell returns is a digest, a ppm or a
;        name — no reply text crosses it
;   128  every bit above ran against the live evaluator's own constructor
;
; preludes: form-stdlib/form-knowledge-qwen-heldout-v3-eval.fk
; preludes: form-stdlib/form-knowledge-heldout-reproduction.fk

(do
    (defn fkhrb-bit (ok bit) (if ok bit 0))

    ; one expected answer, and replies built to collide on the ratio
    (defn fkhrb-expected () "alpha beta gamma delta")
    (defn fkhrb-obs (actual)
        (fkh3-observation "prompt" (fkhrb-expected) actual
            (fkh3-exact-verifier (fkhrb-expected)) 100 0))

    (defn fkhrb-distinct3 (a b c)
        (if (or (str_eq a b) (or (str_eq a c) (str_eq b c))) 0 1))

    (defn form-knowledge-heldout-reproduction-band ()
        (do
            ; "alpha beta" and "beta gamma": two tokens each, two overlapping
            ; each, so 2*2*1000000/(4+2) is the same ppm for both.
            (let one   (fkhrb-obs "alpha beta"))
            (let one2  (fkhrb-obs "alpha beta"))
            (let other (fkhrb-obs "beta gamma"))
            (let far   (fkhrb-obs "alpha"))

            (sum (list
                (fkhrb-bit (eq (fkhr-contract-ok? one "alpha beta") 1) 1)

                (fkhrb-bit (and (eq (fkhr-same-f1? one one2) 1)
                           (and (eq (fkhr-same-answer? one one2) 1)
                                (str_eq (fkhr-relation one one2)
                                        (fkhr-anchored)))) 2)

                ; the case the totals cannot see
                (fkhrb-bit (and (eq (fkh3-obs-f1 one) (fkh3-obs-f1 other))
                           (and (eq (fkhr-same-answer? one other) 0)
                                (str_eq (fkhr-relation one other)
                                        (fkhr-coincident)))) 4)

                (fkhrb-bit (and (not (eq (fkh3-obs-f1 one) (fkh3-obs-f1 far)))
                                (str_eq (fkhr-relation one far)
                                        (fkhr-moved))) 8)

                (fkhrb-bit (eq (fkhrb-distinct3 (fkhr-anchored)
                                                (fkhr-coincident)
                                                (fkhr-moved)) 1) 16)

                (fkhrb-bit (and (eq (fkhr-anchor-evidence? one other) 0)
                                (eq (fkhr-anchor-evidence? one one2) 1)) 32)

                ; a digest is 64 hex; a reply is not. Nothing readable crosses.
                (fkhrb-bit (and (eq (str_len (fkhr-actual-sha one)) 64)
                           (and (eq (str_len (fkhr-expected-sha one)) 64)
                                (eq (str_len (fkhr-prompt-sha one)) 64))) 64)

                (fkhrb-bit 1 128)))))

    (form-knowledge-heldout-reproduction-band))
