; glass-transcripts-band.bml — the live transcripts the glass paints carry the ear's own doubt and
; start from the spool's newest bytes (ear-axes.bml, ear-transcript.bml, form-glass-meaning-ui.bml).
;
; On 2026-11-06 the room's spool held 385 MB, and a newborn ear sensor framed it from byte zero
; before its first give. Of the last 2389 closed translations in it, 160 carried one text in
; pt, fa and id and 82 copied the line untranslated; 7% of its heard lines came in tongues the
; house never offered. The glass painted every one of them as a translation, with a raw epoch
; for a label. Fixture frames below have the same shapes; no recorded speech is in them.
;
; Expected: 127
; Verdict 127 when every claim lands:
;   1   a newborn reads the spool's last 64 KiB: the newest heard and said frames are found
;       there, and far fewer frames are framed than the spool holds
;   2   one text in every other tongue marks each translation "same text in every tongue"
;   4   a translation that is the line itself is "untranslated copy", and only that tongue
;   8   a line heard in a tongue the house did not offer is in doubt, and so is each translation of it
;   16  a clean line and its translations carry no doubt, and their labels say the stage and its cost
;   32  a growing line older than the standing lanes is not painted as growing; a newer one is
;   64  the painted view names the doubt in the slot header and shows no raw epoch
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/ear-axes.bml form-stdlib/form-glass-meaning-ui.bml
section [form.bml] {
 class GlassTranscriptsBand {
  def gtb-frame(pairs) = "<|ear:frame|>\n" + foldl((acc, p) => acc + p[0] + "=" + p[1] + "\n", "", pairs) + "<|/ear:frame|>\n";
  def gtb-quiet(t) = gtb-frame([["t", t.str()], ["kind", "quiet"], ["db", "-54"], ["live", ""], ["livelang", ""], ["livems", "0"], ["heard", ""], ["lang", ""], ["nsp", "0"], ["heardms", "0"], ["floor", "123"], ["gate", "246"]]);
  def gtb-quiets(t, n, acc) = n <= 0 ? acc : gtb-quiets(t + 1, n - 1, acc + gtb-quiet(t));
  def gtb-heard(text, lang) = gtb-frame([["t", "1792231031000"], ["kind", "heard"], ["live", ""], ["heard", text], ["lang", lang], ["nsp", "0"], ["heardms", "64"]]);
  def gtb-said(text, lang, pt, fa, id) = gtb-frame([["t", "1792231031518"], ["kind", "said"], ["heard", text], ["lang", lang], ["tend", "1792231031010"], ["tongues", "en pt fa id"], ["t_en", lang == "en" ? text : "the kettle is on"], ["t_pt", pt], ["t_fa", fa], ["t_id", id], ["saidms", "508"]]);
  def gtb-live(t, text) = gtb-frame([["t", t.str()], ["kind", "live"], ["live", text], ["livelang", "en"], ["livems", "60"]]);
  def gtb-wanted() = "en pt fa id";
  def gtb-rows(heard, said) = ea-transcript-rows("", heard, said, gtb-wanted(), 0);
  def gtb-row(rows, id) = nil?(rows) ? [] : (String) fgo-id(rows[0]) == id ? rows[0] : gtb-row(rows[1:], id);
  def gtb-doubt(rows, id) = etr-doubt(gtb-row(rows, id));
  def gtb-said-frame(text, lang, pt, fa, id) = ea-frames(gtb-said(text, lang, pt, fa, id), 0, [])[0];
  def gtb-heard-frame(text, lang) = ea-frames(gtb-heard(text, lang), 0, [])[0];
  def gtb-head-texts(lines) = map(l => (String) value_kind(ftc-segment-text(l[0])) == "string" ? ftc-segment-text(l[0]) : "", lines);

  def gtb-c-tail(ctx) {
   let quiet = gtb-quiets(1792231000000, 2000, "");
   let text = quiet + gtb-heard("the kettle is on", "en") + gtb-said("the kettle is on", "en", "a chaleira está ligada", "کتری روشن است", "ketel sudah menyala");
   let mark = ea-birth-mark(len(text));
   let slice = substring(text, mark, len(text));
   let frames = ea-frames(substring(slice, 0, ea-through(slice, 0, 0)), 0, []);
   let newest = ea-newest(frames, "", "", "", "");
   ea-birth-mark(385544206) == 385544206 - 65536 && ea-birth-mark(0 - 1) == 0 && ea-birth-mark(4096) == 0
    && (String) ea-field(newest[1], "heard") == "the kettle is on" && (String) ea-field(newest[2], "t_pt") == "a chaleira está ligada"
    && len(frames) < 600 && len(frames) > 2;
  }
  def gtb-c-same(ctx) {
   let rows = gtb-rows(gtb-heard-frame("good morning", "en"), gtb-said-frame("good morning", "en", "2019-08-26 (JST)", "2019-08-26 (JST)", "2019-08-26 (JST)"));
   gtb-doubt(rows, "ear.transcript.translation-closed.pt") == 8 && gtb-doubt(rows, "ear.transcript.translation-closed.fa") == 8
    && gtb-doubt(rows, "ear.transcript.translation-closed.id") == 8 && gtb-doubt(rows, "ear.transcript.original-closed.en") == 0;
  }
  def gtb-c-copy(ctx) {
   let rows = gtb-rows(gtb-heard-frame("the kettle is on", "en"), gtb-said-frame("the kettle is on", "en", "the kettle is on", "کتری روشن است", "ketel sudah menyala"));
   gtb-doubt(rows, "ear.transcript.translation-closed.pt") == 4 && gtb-doubt(rows, "ear.transcript.translation-closed.fa") == 0
    && (String) etr-doubt-words(4) == "untranslated copy of the line";
  }
  def gtb-c-tongue(ctx) {
   let rows = gtb-rows(gtb-heard-frame("diolch yn fawr", "cy"), gtb-said-frame("diolch yn fawr", "cy", "muito obrigado", "خیلی ممنون", "terima kasih banyak"));
   gtb-doubt(rows, "ear.transcript.original-closed.cy") == 2 && gtb-doubt(rows, "ear.transcript.translation-closed.pt") == 16
    && gtb-doubt(rows, "ear.transcript.translation-closed.en") == 16;
  }
  def gtb-c-clean(ctx) {
   let rows = gtb-rows(gtb-heard-frame("the kettle is on", "en"), gtb-said-frame("the kettle is on", "en", "a chaleira está ligada", "کتری روشن است", "ketel sudah menyala"));
   len(rows) == 4 && all?(r => etr-doubt(r) == 0, rows)
    && (String) fgo-label(gtb-row(rows, "ear.transcript.original-closed.en")) == "heard 64 ms"
    && (String) fgo-label(gtb-row(rows, "ear.transcript.translation-closed.pt")) == "translated 508 ms";
  }
  def gtb-c-growing(ctx) {
   let old = ea-frames(gtb-live(1792231000000, "the kett"), 0, [])[0];
   let fresh = ea-frames(gtb-live(1792231009000, "the kettle"), 0, [])[0];
   let born = 1792231005000;
   nil?(ea-transcript-rows(old, "", "", gtb-wanted(), born))
    && (String) fgo-label(ea-transcript-rows(fresh, "", "", gtb-wanted(), born)[0]) == "hearing 60 ms";
  }
  def gtb-c-render(ctx) {
   let rows = fgo-age-rows-at(gtb-rows(gtb-heard-frame("good morning", "en"), gtb-said-frame("good morning", "en", "2019-08-26 (JST)", "2019-08-26 (JST)", "2019-08-26 (JST)")), 1792231033000);
   let heads = gtb-head-texts(fglm-lines-fit(rows, "all", 1792231033000, 100, 30));
   any?(h => str_find(h, "Portuguese | translated 508 ms", 0) == 0 && str_find(h, "doubt: same text in every tongue", 0) > 0, heads)
    && any?(h => str_find(h, "English | heard 64 ms", 0) == 0 && str_find(h, "doubt", 0) < 0, heads)
    && !any?(h => str_find(h, " @1792", 0) >= 0, heads);
  }
 }
 live-claims("glass-transcripts-band", 0, [["tail", 1, 1, gtb-c-tail], ["same", 2, 1, gtb-c-same], ["copy", 4, 1, gtb-c-copy], ["tongue", 8, 1, gtb-c-tongue], ["clean", 16, 1, gtb-c-clean], ["growing", 32, 1, gtb-c-growing], ["render", 64, 1, gtb-c-render]]);
}
