; glass-transcripts-band.bml — the live transcripts the glass paints carry the ear's own doubt and
; start from the spool's newest bytes (ear-axes.bml, ear-transcript.bml, form-glass-meaning-ui.bml).
;
; On 2026-11-06 the room's spool held 385 MB, and a newborn ear sensor framed it from byte zero
; before its first give. Of the last 2389 closed translations in it, 160 carried one text in
; pt, fa and id and 82 copied the line untranslated; 7% of its heard lines came in tongues the
; house never offered. The glass painted every one of them as a translation, with a raw epoch
; for a label. Fixture frames below have the same shapes; no recorded speech is in them.
;
; Music and nature reach the ear as passes that heard only a tag ([MUSIC], (water running)). The
; same spool's 2366 heard lines: 741 came while the room named its sound six or more times in the
; ten seconds before, 47% of those carrying the tag in the line itself against 2.5% in a room that
; named nothing; whisper's own confidence did not tell them apart.
;
; Expected: 32767
; Verdict 32767 when every claim lands:
;   1   a newborn reads the spool's last 64 KiB: the newest heard and said frames are found
;       there, and far fewer frames are framed than the spool holds
;   2   one text in every other tongue marks each translation "same text in every tongue"
;   4   a translation that is the line itself is "untranslated copy", and only that tongue
;   8   a line heard in a tongue the house did not offer is in doubt, and so is each translation of it
;   16  a clean line and its translations carry no doubt, and their labels say the stage and its cost
;   32  a growing line older than the standing lanes is not painted as growing; a newer one is
;   64  the painted view names the doubt in the slot header and shows no raw epoch
;   128 a line heard with six named sounds in the ten seconds before it is heard over the room's
;       sound, and its translations say their line is in doubt; with two named sounds, neither is
;   256 a line that carries the room's own tag says so
;   512 the view names the room: its newest tag and how often it named itself
;   1024 the same closed line read again keeps the doubt it was first read with
;   2048 a growing line whose live slot went quiet past the patience is let go unclosed, with its
;        growing translation; while the slot still carries words it is not, and going live clears it
;   4096 standing text is what two consecutive passes agree on: a later pass that rewrites a
;        standing word does not take it back, the view paints standing bytes apart from the
;        tentative rest, and a close or a pause past the patience starts the next line clean
;   8192 a line doubted twice (a tongue not offered, let go unclosed) is withheld with its
;        translation: the view names the doubt and shows none of its words
;   16384 the ear gives every 40 ms while a line grows, 100 ms in a quiet room, 500 ms asleep
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/ear-axes.bml form-stdlib/form-glass-meaning-ui.bml
section [form.bml] {
 class GlassTranscriptsBand {
  def gtb-frame(pairs) = "<|ear:frame|>\n" + foldl((acc, p) => acc + p[0] + "=" + p[1] + "\n", "", pairs) + "<|/ear:frame|>\n";
  def gtb-quiet(t) = gtb-frame([["t", t.str()], ["kind", "quiet"], ["db", "-54"], ["live", ""], ["livelang", ""], ["livems", "0"], ["heard", ""], ["lang", ""], ["nsp", "0"], ["heardms", "0"], ["floor", "123"], ["gate", "246"]]);
  def gtb-quiets(t, n, acc) = n <= 0 ? acc : gtb-quiets(t + 1, n - 1, acc + gtb-quiet(t));
  def gtb-heard(text, lang) = gtb-frame([["t", "1792231031000"], ["kind", "heard"], ["live", ""], ["heard", text], ["lang", lang], ["nsp", "0"], ["heardms", "64"]]);
  def gtb-said(text, lang, pt, fa, id) = gtb-frame([["t", "1792231031518"], ["kind", "said"], ["heard", text], ["lang", lang], ["tend", "1792231031010"], ["tongues", "en pt fa id"], ["t_en", lang == "en" ? text : "the kettle is on"], ["t_pt", pt], ["t_fa", fa], ["t_id", id], ["saidms", "508"]]);
  def gtb-live(t, text) = gtb-frame([["t", t.str()], ["kind", "live"], ["live", text], ["livelang", "en"], ["livems", "60"]]);
  def gtb-wanted() = "en pt fa id";
  def gtb-rows(heard, said) = ea-transcript-rows("", heard, said, gtb-wanted(), 0, [], []);
  def gtb-phantom(t, tags) = gtb-frame([["t", t.str()], ["kind", "phantom"], ["db", "-40"], ["live", ""], ["heard", ""], ["lang", ""], ["nsp", "0"], ["tags", tags]]);
  def gtb-phantoms(t, n, acc) = n <= 0 ? acc : gtb-phantoms(t + 1000, n - 1, acc + gtb-phantom(t, "[MUSIC]"));
  def gtb-room(n) = ea-room-next([], ea-room-points(ea-frames(gtb-phantoms(1792231022000, n, ""), 0, [])));
  def gtb-room-rows(room, heard, said) = ea-transcript-rows("", heard, said, gtb-wanted(), 0, room, []);
  def gtb-seg-text(s) = (String) value_kind(ftc-segment-text(s)) == "string" ? ftc-segment-text(s) : ftc-byte-text?(ftc-segment-text(s)) ? foldl((acc, b) => acc + byte_to_str(b), "", ftc-segment-text(s)[1]) : "";
  def gtb-line-text(l) = foldl((acc, s) => acc + gtb-seg-text(s), "", l);
  def gtb-lives(t, texts) = nil?(texts) ? [] : cons(ea-frames(gtb-live(t, texts[0]), 0, [])[0], gtb-lives(t + 200, texts[1:]));
  def gtb-row(rows, id) = nil?(rows) ? [] : (String) fgo-id(rows[0]) == id ? rows[0] : gtb-row(rows[1:], id);
  def gtb-doubt(rows, id) = etr-doubt(gtb-row(rows, id));
  def gtb-said-frame(text, lang, pt, fa, id) = ea-frames(gtb-said(text, lang, pt, fa, id), 0, [])[0];
  def gtb-heard-frame(text, lang) = ea-frames(gtb-heard(text, lang), 0, [])[0];
  def gtb-head-texts(lines) = map(l => (String) value_kind(ftc-segment-text(l[0])) == "string" ? ftc-segment-text(l[0]) : "", lines);

  def gtb-c-tail(ctx) {
   let quiet = gtb-quiets(1792231000000, 2000, "");
   let text = quiet + gtb-heard("the kettle is on", "en") + gtb-said("the kettle is on", "en", "a chaleira está ligada", "کتری روشن است", "ketel sudah menyala");
   let mark = ea-birth-mark(len(text));
   let slice = substring(text, mark, len(text));
   let frames = ea-frames(substring(slice, 0, ea-through(slice, 0, 0)), 0, []);
   let newest = ea-newest(frames, "", "", "", "");
   ea-birth-mark(385544206) == 385544206 - 65536 && ea-birth-mark(0 - 1) == 0 && ea-birth-mark(4096) == 0
    && (String) ea-field(newest[1], "heard") == "the kettle is on" && (String) ea-field(newest[2], "t_pt") == "a chaleira está ligada"
    && len(frames) < 600 && len(frames) > 2;
  }
  def gtb-c-same(ctx) {
   let rows = gtb-rows(gtb-heard-frame("good morning", "en"), gtb-said-frame("good morning", "en", "2019-08-26 (JST)", "2019-08-26 (JST)", "2019-08-26 (JST)"));
   gtb-doubt(rows, "ear.transcript.translation-closed.pt") == 8 && gtb-doubt(rows, "ear.transcript.translation-closed.fa") == 8
    && gtb-doubt(rows, "ear.transcript.translation-closed.id") == 8 && gtb-doubt(rows, "ear.transcript.original-closed.en") == 0;
  }
  def gtb-c-copy(ctx) {
   let rows = gtb-rows(gtb-heard-frame("the kettle is on", "en"), gtb-said-frame("the kettle is on", "en", "the kettle is on", "کتری روشن است", "ketel sudah menyala"));
   gtb-doubt(rows, "ear.transcript.translation-closed.pt") == 4 && gtb-doubt(rows, "ear.transcript.translation-closed.fa") == 0
    && (String) etr-doubt-words(4) == "untranslated copy of the line";
  }
  def gtb-c-tongue(ctx) {
   let rows = gtb-rows(gtb-heard-frame("diolch yn fawr", "cy"), gtb-said-frame("diolch yn fawr", "cy", "muito obrigado", "خیلی ممنون", "terima kasih banyak"));
   gtb-doubt(rows, "ear.transcript.original-closed.cy") == 2 && gtb-doubt(rows, "ear.transcript.translation-closed.pt") == 16
    && gtb-doubt(rows, "ear.transcript.translation-closed.en") == 16;
  }
  def gtb-c-clean(ctx) {
   let rows = gtb-rows(gtb-heard-frame("the kettle is on", "en"), gtb-said-frame("the kettle is on", "en", "a chaleira está ligada", "کتری روشن است", "ketel sudah menyala"));
   len(rows) == 4 && all?(r => etr-doubt(r) == 0, rows)
    && (String) fgo-label(gtb-row(rows, "ear.transcript.original-closed.en")) == "heard 64 ms"
    && (String) fgo-label(gtb-row(rows, "ear.transcript.translation-closed.pt")) == "translated 508 ms";
  }
  def gtb-c-growing(ctx) {
   let old = ea-frames(gtb-live(1792231000000, "the kett"), 0, [])[0];
   let fresh = ea-frames(gtb-live(1792231009000, "the kettle"), 0, [])[0];
   let born = 1792231005000;
   nil?(ea-transcript-rows(old, "", "", gtb-wanted(), born, [], []))
    && (String) fgo-label(ea-transcript-rows(fresh, "", "", gtb-wanted(), born, [], [])[0]) == "hearing 60 ms";
  }
  def gtb-c-room(ctx) {
   let loud = gtb-room-rows(gtb-room(8), gtb-heard-frame("take me higher", "en"), gtb-said-frame("take me higher", "en", "leve-me mais alto", "مرا بالاتر ببر", "bawa aku lebih tinggi"));
   let calm = gtb-room-rows(gtb-room(2), gtb-heard-frame("take me higher", "en"), gtb-said-frame("take me higher", "en", "leve-me mais alto", "مرا بالاتر ببر", "bawa aku lebih tinggi"));
   gtb-doubt(loud, "ear.transcript.original-closed.en") == 32 && gtb-doubt(loud, "ear.transcript.translation-closed.pt") == 32
    && gtb-doubt(calm, "ear.transcript.original-closed.en") == 0 && gtb-doubt(calm, "ear.transcript.translation-closed.pt") == 0;
  }
  def gtb-c-tag(ctx) {
   let heard = ea-frames(gtb-frame([["t", "1792231031000"], ["kind", "heard"], ["heard", "[Music] take me higher"], ["lang", "en"], ["heardms", "64"], ["tags", "[Music]"]]), 0, [])[0];
   gtb-doubt(gtb-room-rows([], heard, ""), "ear.transcript.original-closed.en") == 64 && (String) etr-doubt-words(64) == "carries the room's own tag";
  }
  def gtb-c-room-view(ctx) {
   let room = gtb-room(8);
   let rows = cons(ea-room-row(room, 1792231031000), fgo-age-rows-at(gtb-room-rows(room, gtb-heard-frame("take me higher", "en"), ""), 1792231033000));
   let heads = gtb-head-texts(fglm-lines-fit(rows, "all", 1792231033000, 100, 30));
   any?(h => str_find(h, "room: [MUSIC] named 8x in the last 10 s; lines heard over it are dimmed", 0) == 0, heads)
    && any?(h => str_find(h, "doubt: heard over the room's named sound", 0) > 0, heads);
  }
  def gtb-c-let-go(ctx) {
   let growing = ea-frames(gtb-live(1792231000000, "pencidous"), 0, [])[0];
   let saying = ea-frames(gtb-frame([["t", "1792231000300"], ["kind", "saying"], ["heard", "pencidous"], ["lang", "en"], ["tend", "1792231000000"], ["tongues", "en pt fa id"], ["t_pt", "penicídio"], ["saidms", "300"]]), 0, [])[0];
   let rows = ea-transcript-rows(growing, "", saying, gtb-wanted(), 0, [], []);
   let quiet = ea-frames(gtb-quiet(1792231009000), 0, [])[0];
   let gone = ea-transcript-let-go(rows, quiet, 1792231009000);
   let still = ea-transcript-let-go(rows, growing, 1792231009000);
   let back = ea-transcript-let-go(gone, growing, 1792231009000);
   gtb-doubt(gone, "ear.transcript.original-growing.en") == 128 && gtb-doubt(gone, "ear.transcript.translation-growing.pt") == 128
    && gtb-doubt(still, "ear.transcript.original-growing.en") == 0 && gtb-doubt(back, "ear.transcript.original-growing.en") == 0
    && gtb-doubt(ea-transcript-let-go(rows, quiet, 1792231003000), "ear.transcript.original-growing.en") == 0
    && (String) etr-doubt-words(128) == "the ear let it go unclosed";
  }
  // five passes of one line: the third says "want" where two passes agreed on "went"
  def gtb-c-agree(ctx) {
   let fs = gtb-lives(1792231000000, ["I went", "I went to the", "I want to the store", "I went to the store", "I went to the store."]);
   let s2 = ea-agree(ea-agree-born(), take(2, fs));
   let s3 = ea-agree(s2, [fs[2]]);
   let s5 = ea-agree(s3, fs[3:]);
   let row2 = ea-transcript-rows(fs[1], "", "", gtb-wanted(), 0, [], s2)[0];
   let body = fglm-slot-wrap-at(fgo-text-value(row2), 0, 80, "x", "physical-live", 3, 220, etr-standing(row2));
   (String) ea-agree-shown(s2)[0] == "I went to the" && ea-agree-shown(s2)[1] == 6
    && (String) ea-agree-shown(s3)[0] == "I went" && ea-agree-shown(s3)[1] == 6
    && (String) ea-agree-shown(s5)[0] == "I went to the store." && ea-agree-shown(s5)[1] == len("I went to the store.")
    && len(body[0]) == 2 && (String) gtb-seg-text(body[0][0]) == "I went" && (String) gtb-seg-text(body[0][1]) == " to the"
    && nil?(ea-agree(s5, [ea-frames(gtb-heard("I went to the store.", "en"), 0, [])[0]])[0])
    && nil?(ea-agree(s2, [ea-frames(gtb-live(1792231009000, "and then"), 0, [])[0]])[0]);
  }
  // a hallucinated line: heard in a tongue the house did not offer, and let go unclosed
  def gtb-c-withheld(ctx) {
   let growing = ea-frames(gtb-frame([["t", "1792231000000"], ["kind", "live"], ["live", "PENCIDOUS!"], ["livelang", "nn"], ["livems", "17"]]), 0, [])[0];
   let saying = ea-frames(gtb-frame([["t", "1792231000300"], ["kind", "saying"], ["heard", "PENCIDOUS!"], ["lang", "nn"], ["tend", "1792231000000"], ["tongues", "en pt fa id"], ["t_pt", "Penicídio!"], ["saidms", "365"]]), 0, [])[0];
   let quiet = ea-frames(gtb-quiet(1792231009000), 0, [])[0];
   let rows = fgo-age-rows-at(ea-transcript-let-go(ea-transcript-rows(growing, "", saying, gtb-wanted(), 0, [], []), quiet, 1792231009000), 1792231009000);
   let lines = map(l => gtb-line-text(l), fglm-lines-fit(rows, "all", 1792231009000, 100, 30));
   gtb-doubt(rows, "ear.transcript.original-growing.nn") == 386 && gtb-doubt(rows, "ear.transcript.translation-growing.pt") == 400
    && len(filter(l => str_find(l, "withheld: the ear doubts this line twice", 0) == 0, lines)) == 2
    && !any?(l => str_find(l, "PENCIDOUS", 0) >= 0 || str_find(l, "Penicídio", 0) >= 0, lines);
  }
  def gtb-c-cadence(ctx) = ea-cadence(1, ea-frames(gtb-live(1792231000000, "I went"), 0, [])[0]) == 40 && ea-cadence(1, ea-frames(gtb-quiet(1792231000000), 0, [])[0]) == 100 && ea-cadence(0, "") == 500;
  def gtb-c-kept(ctx) {
   let held = gtb-room-rows(gtb-room(8), gtb-heard-frame("take me higher", "en"), "");
   let again = etr-flow(held, gtb-room-rows([], gtb-heard-frame("take me higher", "en"), ""));
   gtb-doubt(again, "ear.transcript.original-closed.en") == 32;
  }
  def gtb-c-render(ctx) {
   let rows = fgo-age-rows-at(gtb-rows(gtb-heard-frame("good morning", "en"), gtb-said-frame("good morning", "en", "2019-08-26 (JST)", "2019-08-26 (JST)", "2019-08-26 (JST)")), 1792231033000);
   let heads = gtb-head-texts(fglm-lines-fit(rows, "all", 1792231033000, 100, 30));
   any?(h => str_find(h, "Portuguese | translated 508 ms", 0) == 0 && str_find(h, "doubt: same text in every tongue", 0) > 0, heads)
    && any?(h => str_find(h, "English | heard 64 ms", 0) == 0 && str_find(h, "doubt", 0) < 0, heads)
    && !any?(h => str_find(h, " @1792", 0) >= 0, heads);
  }
 }
 live-claims("glass-transcripts-band", 0, [["tail", 1, 1, gtb-c-tail], ["same", 2, 1, gtb-c-same], ["copy", 4, 1, gtb-c-copy], ["tongue", 8, 1, gtb-c-tongue], ["clean", 16, 1, gtb-c-clean], ["growing", 32, 1, gtb-c-growing], ["render", 64, 1, gtb-c-render], ["room", 128, 1, gtb-c-room], ["tag", 256, 1, gtb-c-tag], ["room-view", 512, 1, gtb-c-room-view], ["kept", 1024, 1, gtb-c-kept], ["let-go", 2048, 1, gtb-c-let-go], ["agree", 4096, 1, gtb-c-agree], ["withheld", 8192, 1, gtb-c-withheld], ["cadence", 16384, 1, gtb-c-cadence]]);
}
