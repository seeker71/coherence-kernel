; One direct, copyable call for every resident coding-agent tool.
; Verdict 32767: the fifteen bits are rg, jq, read, cat, head, tail, wc,
; sort, uniq, tr, cut, awk, sed, edit, and write, in that order.
; witnessed: 2026-09-04 -> 32767
; preludes: form-stdlib/core.fk form-stdlib/form-cli.fk
(do
    (defn fatx-docs ()
        (list
            (list "source:alpha" "alpha.txt" "alpha 1\nbeta 2\n")
            (list "source:table" "table.txt" "left:right\nup:down\n")
            (list "source:package" "package.json" "{\"name\":\"demo\",\"version\":1}")))
    (defn fatx-call (tool args input) (fc-tool-call (fatx-docs) tool args input))
    (defn fatx-good (tool args input expected)
        (do (let r (fatx-call tool args input))
            (and (eq (fat-exit r) 0)
                (and (str_eq (fat-error r) "") (str_eq (fat-out r) expected)))))
    (defn fatx-next-good (result path expected)
        (and (eq (fat-exit result) 0)
            (do (let read-back (fc-tool-call (fat-documents result) "read" (list path) ""))
                (and (eq (fat-exit read-back) 0)
                    (str_eq (fat-out read-back) expected)))))
    (defn fatx-bit (ok bit) (if ok bit 0))
    (sum (list
        (fatx-bit (fatx-good "rg" (list "-nF" "alpha 1") "" "alpha.txt:1:alpha 1\n") 1)
        (fatx-bit (fatx-good "jq" (list "-r" ".name" "package.json") "" "demo\n") 2)
        (fatx-bit (fatx-good "read" (list "alpha.txt") "" "alpha 1\nbeta 2\n") 4)
        (fatx-bit (fatx-good "cat" (list "alpha.txt" "table.txt") "" "alpha 1\nbeta 2\nleft:right\nup:down\n") 8)
        (fatx-bit (fatx-good "head" (list "-n" "1" "alpha.txt") "" "alpha 1\n") 16)
        (fatx-bit (fatx-good "tail" (list "-n" "1" "alpha.txt") "" "beta 2\n") 32)
        (fatx-bit (fatx-good "wc" (list "-lwc") "one two\n" "1 2 8\n") 64)
        (fatx-bit (fatx-good "sort" (list "-nu") "10\n2\n2\n" "2\n10\n") 128)
        (fatx-bit (fatx-good "uniq" (list "-c") "a\na\nb\n" "2 a\n1 b\n") 256)
        (fatx-bit (fatx-good "tr" (list "-d" "\\n") "one\ntwo\n" "onetwo") 512)
        (fatx-bit (fatx-good "cut" (list "-d" ":" "-f" "2") "left:right\nup:down\n" "right\ndown\n") 1024)
        (fatx-bit (fatx-good "awk" (list "{print $2}") "one two\nthree four\n" "two\nfour\n") 2048)
        (fatx-bit (fatx-good "sed" (list "-n" "2p" "alpha.txt") "" "beta 2\n") 4096)
        (fatx-bit (fatx-next-good (fatx-call "edit" (list "alpha.txt" "beta 2" "gamma 3") "") "alpha.txt" "alpha 1\ngamma 3\n") 8192)
        (fatx-bit (fatx-next-good (fatx-call "write" (list "notes.md") "held note\n") "notes.md" "held note\n") 16384))))
