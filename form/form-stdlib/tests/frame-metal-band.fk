; Real GPU frame jobs over one capture; Form interpreter is the explicit oracle.
; Expected 65535 on a host with the dynamically loaded Metal adapter.
; preludes: form-stdlib/bml/frame-metal.bml form-stdlib/tests/frame-luma-fixture.fk
(do
 (defn fg-b (ok bit) (if ok bit 0))
 (defn fg-equal (a b) (if (or (nothing? a) (nothing? b)) 0 (if (not (eq (len a) (len b))) 0 (if (nil? a) 1 (and (eq (head a) (head b)) (fg-equal (tail a) (tail b)))))))
 (let before (fg-status-number (metal_status) "buffers"))
 (let a (fg-version 1024))
 (let b (fg-version 128))
 (let owner (fg-open a))
 (let foreign (fg-open a))
 (let bytes (flmb-bmp -1))
 (let frame (fg-capture owner bytes))
 (let ja (fg-submit owner frame (flm-default-policy)))
 (let upload-while-pending (fg-capture owner bytes))
 (let early-free (fg-release owner ja))
 (let early-close (fg-close owner))
 (let published (fg-publish owner b))
 (let other-policy (list 0 0 100 0))
 (let jb (fg-submit owner frame other-policy))
 (let jc (fg-submit owner frame other-policy))
 (let retired (fg-retire a))
 (let retire-select (fg-publish owner a))
 (let foreign-wait (fg-await foreign ja))
 (let foreign-free (fg-release foreign ja))
 (let cancelled (fg-cancel owner jc))
 (let all (fg-await-all owner))
 (let duplicate (fg-await owner ja))
 (let ra (fg-result owner ja))
 (let rb (fg-result owner jb))
 (let rc (fg-result owner jc))
 (let free-a (fg-release owner ja))
 (let double-free (fg-release owner ja))
 (let close (fg-close owner))
 (let foreign-close (fg-close foreign))
 (let after (fg-status-number (metal_status) "buffers"))
 (sum (list
  (fg-b (and (record? a) (record? b)) 1)
  (fg-b (and (record? owner) (record? frame)) 2)
  (fg-b (nothing? upload-while-pending) 4)
  (fg-b (and (eq early-free 0) (eq early-close 0)) 8)
  (fg-b (and (eq published 1) (eq retire-select 0)) 16)
  (fg-b (and (eq (record_get ja "version") a) (eq (record_get jb "version") b)) 32)
  (fg-b (and (str_eq foreign-wait "foreign") (eq foreign-free 0)) 64)
  (fg-b (and (eq cancelled 1) (nothing? rc)) 128)
  (fg-b (eq all 1) 256)
  (fg-b (fg-equal ra (flm-stat bytes)) 512)
  (fg-b (fg-equal rb (flm-stat-policy bytes other-policy)) 1024)
  (fg-b (and (str_eq duplicate "unchanged") (eq double-free 0)) 2048)
  (fg-b (and (eq free-a 1) (eq close 1)) 4096)
  (fg-b (and (eq before after) (eq foreign-close 1)) 8192)
  (fg-b (and (nothing? (fg-submit owner frame other-policy)) (nothing? (fg-result owner ja))) 16384)
  (fg-b (not (eq (mj-handle (record_get a "program")) (mj-handle (record_get b "program")))) 32768))))
