// query-coverage-band.bml — form-stdlib/bml/form-cli-grounded-synthesis.bml lands one coverage row per answer, and the
// fraction reader counts them back by kind. No model runs: the rows are written to a scratch ledger in .hearth with the
// exact shapes fgs-start would write, and the classifier is read over fixed enquiries. Last line: claims that agree.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-grounded-synthesis.bml
section [form.bml] {
 class QueryCoverageBand {
  def qcb-row(label, ok) {
   let said = print_str((ok ? "ok   " : "FAIL ") ++ label);
   ok ? 1 : 0;
  }
  def qcb-path() = ".hearth/query-coverage-band.jsonl";
  def qcb-count?(table, kind, native, all) = any?(row => ((String) row[0] == kind) && (row[1] == native) && (row[2] == all), table);
  def qcb-run() {
   let made = fs_mkdir(".hearth");
   let cleared = write_file_text(qcb-path(), "");
   // the classifier: the first word row the enquiry carries, else its shape
   let r1 = qcb-row("a short question with a lane word is a lookup", (String) fgs-kind("What does a check below its pin mean?") == "lookup");
   let r2 = qcb-row("an enquiry naming a definition or a source file is structural", ((String) fgs-kind("Where is fgs-answer defined?") == "structural") && ((String) fgs-kind("Which file owns form-cli-grounded-synthesis.bml") == "structural") && ((String) fgs-kind("Who calls fgs-answer in observe/companion-ground.bml?") == "structural"));
   let r3 = qcb-row("an enquiry asking for a band, a patch or a fix is code", ((String) fgs-kind("Write a band that reads the ledger back") == "code") && ((String) fgs-kind("How do I fix the empty output?") == "code"));
   let r4 = qcb-row("an enquiry asking for steps is a plan", (String) fgs-kind("Plan the steps to retire the Python host") == "plan");
   let r5 = qcb-row("everything else is prose, a long one too", ((String) fgs-kind("Tell me about the voice") == "prose") && ((String) fgs-kind("Who carries the landing onto origin when the gates are green? xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx") == "prose"));
   // the lane of a row follows the source, then the voice's adapter
   let voiced = ["answered", "text", 120, 300, "/m/model.gguf", 1, 1, "answered", "raw", [1, 2], ""];
   let worn = ["answered", "text", 40, 10, "/m/base", 1, 1, "answered", "raw", [], "form/form-stdlib/adapters/x"];
   let r6 = qcb-row("substrate, provider, registry weights, a worn adapter and an ask not made are told apart", ((String) fgs-coverage-lane("substrate", true, fgs-substrate-oracle("t")) == "substrate") && ((String) fgs-coverage-lane("provider", true, voiced) == "provider") && ((String) fgs-coverage-lane("fkwu-model-session", true, voiced) == "registry-weights") && ((String) fgs-coverage-lane("fkwu-model-session", true, worn) == "native-metal-lora") && ((String) fgs-coverage-lane("none", false, fcnv-not-asked()) == "not-asked"));
   // the writer: six answers, each one row
   let a1 = fgs-coverage-record-at(qcb-path(), "lookup", "substrate", "substrate", "substrate", 1, 0, 12);
   let a2 = fgs-coverage-record-at(qcb-path(), "lookup", "fkwu-model-session", "registry-weights", "/m/model.gguf", 1, 0, 80500);
   let a3 = fgs-coverage-record-at(qcb-path(), "structural", "provider", "provider", "", 1, 7514, 50814);
   let a4 = fgs-coverage-record-at(qcb-path(), "code", "none", "registry-weights", "/m/model.gguf", 0, 0, 3000);
   let a5 = fgs-coverage-record-at(qcb-path(), "prose", "fkwu-model-session", "native-metal-lora", "/m/base", 1, 0, 9000);
   let a6 = fgs-coverage-record-at(qcb-path(), "plan", "provider", "provider", "", 1, 44495, 60000);
   let rows = fgs-coverage-rows(qcb-path());
   let r7 = qcb-row("each answer lands one row", ((String) a1 == "appended") && ((String) a6 == "appended") && (len(rows) == 6));
   let r8 = qcb-row("a row keeps its kind, source, lane, model, rent and wall clock", ((String) row-get(rows[2], "kind") == "structural") && ((String) row-get(rows[2], "source") == "provider") && ((String) row-get(rows[1], "lane") == "registry-weights") && ((String) row-get(rows[1], "model") == "/m/model.gguf") && (row-get(rows[2], "rent_tokens") == 7514) && (row-get(rows[1], "wall_ms") == 80500));
   // the reader: native is answered from the substrate or the fkwu model session; a provider answer and no answer are not
   let r9 = qcb-row("the substrate and the fkwu model session are native; a provider answer and no answer are not", fgs-coverage-native?(rows[0]) && fgs-coverage-native?(rows[1]) && (!fgs-coverage-native?(rows[2])) && (!fgs-coverage-native?(rows[3])) && fgs-coverage-native?(rows[4]) && (!fgs-coverage-native?(rows[5])));
   let table = fgs-coverage-table(rows);
   let r10 = qcb-row("the fraction by kind: lookup 2 of 2, structural 0 of 1, prose 1 of 1, code 0 of 1, plan 0 of 1", qcb-count?(table, "lookup", 2, 2) && qcb-count?(table, "structural", 0, 1) && qcb-count?(table, "prose", 1, 1) && qcb-count?(table, "code", 0, 1) && qcb-count?(table, "plan", 0, 1));
   let r11 = qcb-row("overall: 3 native of 6, and the table ends on `all`", qcb-count?(table, "all", 3, 6) && ((String) table[len(table) - 1][0] == "all") && (len(table) == 6));
   let r12 = qcb-row("a whole percent, and nothing to divide reads as nothing", (fgs-coverage-percent(3, 6) == 50) && (fgs-coverage-percent(2, 3) == 66) && nothing?(fgs-coverage-percent(0, 0)));
   // since: a row's own time decides, so an old row written before this band is left out of a windowed reading
   let old = sbt-append-count(qcb-path(), "{\"at_unix_ms\":1000,\"kind\":\"lookup\",\"source\":\"substrate\",\"lane\":\"substrate\",\"model\":\"substrate\",\"answered\":1,\"rent_tokens\":0,\"wall_ms\":1}" ++ "\n");
   let all = fgs-coverage-rows(qcb-path());
   let recent = fgs-coverage-since(all, now_unix_ms() - 60000);
   let r13 = qcb-row("since_ms keeps the rows at or after it: the old row is read without a window and left out with one", (len(all) == 7) && qcb-count?(fgs-coverage-table(all), "all", 4, 7) && (len(recent) == 6) && qcb-count?(fgs-coverage-table(recent), "all", 3, 6));
   let r14 = qcb-row("a line that is not a row is not one; the other rows read on", (sbt-append-count(qcb-path(), "{\"kind\":\"lookup\"}\n") > 0) && (len(fgs-coverage-rows(qcb-path())) == 7));
   let r15 = qcb-row("an empty or absent ledger reads as no rows, every kind at 0 of 0", (len(fgs-coverage-rows(".hearth/query-coverage-band-absent.jsonl")) == 0) && qcb-count?(fgs-coverage-table([]), "all", 0, 0) && qcb-count?(fgs-coverage-table([]), "plan", 0, 0));
   print_str("[query-coverage-band] " ++ value_str(r1 + r2 + r3 + r4 + r5 + r6 + r7 + r8 + r9 + r10 + r11 + r12 + r13 + r14 + r15) ++ " of 15");
  }
 }
 qcb-run();
}
