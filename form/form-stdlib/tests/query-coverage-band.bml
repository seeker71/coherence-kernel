// query-coverage-band.bml — form-stdlib/bml/local-run.bml lands one coverage row per ask through a lane, the voice door
// (form-cli-native-voice.bml fcnv-recorded-at) lands its row and its timed LocalRun row at once, the grounded synthesis
// door lands only the rows the voice did not make, the code lane's seam lands one row for a request handed to it in this
// process as for the wire's, and the fraction reader counts them back by kind. No model runs: the
// rows are written to scratch ledgers in .hearth with the exact shapes the doors would write, and the classifier is read
// over fixed enquiries. Last line: claims that agree.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-grounded-synthesis.bml form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 class QueryCoverageBand {
  def qcb-row(label, ok) {
   let said = print_str((ok ? "ok   " : "FAIL ") ++ label);
   ok ? 1 : 0;
  }
  def qcb-path() = ".hearth/query-coverage-band.jsonl";
  def qcb-runs() = ".hearth/query-coverage-band-runs.jsonl";
  def qcb-count?(table, kind, native, all) = any?(row => ((String) row[0] == kind) && (row[1] == native) && (row[2] == all), table);
  def qcb-near?(v, want) = !nothing?(v) && ((String) value_kind(v) == "float") && (v > want - 0.01) && (v < want + 0.01);
  def qcb-run() {
   let made = fs_mkdir(".hearth");
   let cleared = write_file_text(qcb-path(), "");
   let clearedRuns = write_file_text(qcb-runs(), "");
   // the classifier: the first word row the enquiry carries, else its shape
   let r1 = qcb-row("a short question with a lane word is a lookup", (String) qc-kind("What does a check below its pin mean?") == "lookup");
   let r2 = qcb-row("an enquiry naming a definition or a source file is structural", ((String) qc-kind("Where is fgs-answer defined?") == "structural") && ((String) qc-kind("Which file owns form-cli-grounded-synthesis.bml") == "structural") && ((String) qc-kind("Who calls fgs-answer in observe/companion-ground.bml?") == "structural"));
   let r3 = qcb-row("an enquiry asking for a band, a patch or a fix is code", ((String) qc-kind("Write a band that reads the ledger back") == "code") && ((String) qc-kind("How do I fix the empty output?") == "code"));
   let r4 = qcb-row("an enquiry asking for steps is a plan", (String) qc-kind("Plan the steps to retire the Python host") == "plan");
   let r5 = qcb-row("everything else is prose, a long one too", ((String) qc-kind("Tell me about the voice") == "prose") && ((String) qc-kind("Who carries the landing onto origin when the gates are green? xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx") == "prose"));
   // a packet opens with the enquiry; the grounding after the blank line names paths and sources, and is not the enquiry
   let packet = fgs-packet("Tell me about the voice", "enrich: voice / form-cli-native-voice.bml source path", "--- [R1] receipts/x.md");
   let r6 = qcb-row("the enquiry a packet opens with is its first paragraph, so the grounding's paths do not make it structural", ((String) qc-enquiry-of(packet) == "Tell me about the voice") && ((String) qc-kind(qc-enquiry-of(packet)) == "prose") && ((String) qc-kind(packet) == "structural") && ((String) qc-enquiry-of("one line, no grounding") == "one line, no grounding"));
   // the lane of a row follows the source, then the voice's adapter
   let voiced = ["answered", "text", 120, 300, "/m/model.gguf", 1, 1, "answered", "raw", [1, 2], ""];
   let worn = ["answered", "text", 40, 10, "/m/base", 1, 1, "answered", "raw", [], "form/form-stdlib/adapters/x"];
   let r7 = qcb-row("substrate, provider, registry weights, a worn adapter and an ask not made are told apart", ((String) qc-lane("substrate", true, fgs-substrate-oracle("t")) == "substrate") && ((String) qc-lane("provider", true, voiced) == "provider") && ((String) qc-lane("fkwu-model-session", true, voiced) == "registry-weights") && ((String) qc-lane("fkwu-model-session", true, worn) == "native-metal-lora") && ((String) qc-lane("none", false, fcnv-not-asked()) == "not-asked"));
   // the writer: six answers, each one row
   let a1 = qc-record-at(qcb-path(), "lookup", "substrate", "substrate", "substrate", 1, 0, 12);
   let a2 = qc-record-at(qcb-path(), "lookup", "fkwu-model-session", "registry-weights", "/m/model.gguf", 1, 0, 80500);
   let a3 = qc-record-at(qcb-path(), "structural", "provider", "provider", "", 1, 7514, 50814);
   let a4 = qc-record-at(qcb-path(), "code", "none", "registry-weights", "/m/model.gguf", 0, 0, 3000);
   let a5 = qc-record-at(qcb-path(), "prose", "fkwu-model-session", "native-metal-lora", "/m/base", 1, 0, 9000);
   let a6 = qc-record-at(qcb-path(), "plan", "provider", "provider", "", 1, 44495, 60000);
   let rows = qc-rows(qcb-path());
   let r8 = qcb-row("each answer lands one row", ((String) a1 == "appended") && ((String) a6 == "appended") && (len(rows) == 6));
   let r9 = qcb-row("a row keeps its kind, source, lane, model, rent and wall clock", ((String) row-get(rows[2], "kind") == "structural") && ((String) row-get(rows[2], "source") == "provider") && ((String) row-get(rows[1], "lane") == "registry-weights") && ((String) row-get(rows[1], "model") == "/m/model.gguf") && (row-get(rows[2], "rent_tokens") == 7514) && (row-get(rows[1], "wall_ms") == 80500));
   // the reader: native is answered from the body's own sources; a provider answer and no answer are not
   let r10 = qcb-row("the substrate and the fkwu model session are native; a provider answer and no answer are not", qc-native?(rows[0]) && qc-native?(rows[1]) && (!qc-native?(rows[2])) && (!qc-native?(rows[3])) && qc-native?(rows[4]) && (!qc-native?(rows[5])));
   let table = qc-table(rows);
   let r11 = qcb-row("the fraction by kind: lookup 2 of 2, structural 0 of 1, prose 1 of 1, code 0 of 1, plan 0 of 1", qcb-count?(table, "lookup", 2, 2) && qcb-count?(table, "structural", 0, 1) && qcb-count?(table, "prose", 1, 1) && qcb-count?(table, "code", 0, 1) && qcb-count?(table, "plan", 0, 1));
   let r12 = qcb-row("overall: 3 native of 6, and the table ends on `all`", qcb-count?(table, "all", 3, 6) && ((String) table[len(table) - 1][0] == "all") && (len(table) == 6));
   let r13 = qcb-row("a whole percent, and nothing to divide reads as nothing", (qc-percent(3, 6) == 50) && (qc-percent(2, 3) == 66) && nothing?(qc-percent(0, 0)));
   // since: a row's own time decides, so an old row written before this band is left out of a windowed reading
   let old = sbt-append-count(qcb-path(), "{\"at_unix_ms\":1000,\"kind\":\"lookup\",\"source\":\"substrate\",\"lane\":\"substrate\",\"model\":\"substrate\",\"answered\":1,\"rent_tokens\":0,\"wall_ms\":1}" ++ "\n");
   let all = qc-rows(qcb-path());
   let recent = qc-since(all, now_unix_ms() - 60000);
   let r14 = qcb-row("since_ms keeps the rows at or after it: the old row is read without a window and left out with one", (len(all) == 7) && qcb-count?(qc-table(all), "all", 4, 7) && (len(recent) == 6) && qcb-count?(qc-table(recent), "all", 3, 6));
   let r15 = qcb-row("a line that is not a row is not one; the other rows read on", (sbt-append-count(qcb-path(), "{\"kind\":\"lookup\"}\n") > 0) && (len(qc-rows(qcb-path())) == 7));
   let r16 = qcb-row("an empty or absent ledger reads as no rows, every kind at 0 of 0", (len(qc-rows(".hearth/query-coverage-band-absent.jsonl")) == 0) && qcb-count?(qc-table([]), "all", 0, 0) && qcb-count?(qc-table([]), "plan", 0, 0));
   // the voice door: one ask lands its LocalRun row (timed by the lane's clocks) and its coverage row at once
   let clocked = fcnv-clocked(voiced, 24000, 150000);
   let v1 = fcnv-recorded-at(qcb-runs(), qcb-path(), packet, json-node-object([]), clocked, 200000);
   let runs = qc-rows(qcb-path());
   let lruns = ledger-rows(qcb-runs(), "LocalRun");
   let r17 = qcb-row("an answered ask through the voice is one coverage row: prose from the packet's own enquiry, fkwu-model-session, registry-weights, answered, rent 0, its wall clock", ((String) v1[0] == "answered") && (len(v1) == 13) && (len(runs) == 8) && ((String) row-get(runs[7], "kind") == "prose") && ((String) row-get(runs[7], "source") == "fkwu-model-session") && ((String) row-get(runs[7], "lane") == "registry-weights") && ((String) row-get(runs[7], "model") == "/m/model.gguf") && (row-get(runs[7], "answered") == 1) && (row-get(runs[7], "rent_tokens") == 0) && (row-get(runs[7], "wall_ms") == 200000));
   let r18 = qcb-row("and one LocalRun row with the rates its clocks read (120 ids / 24 s = 5 tok/s prefill, 300 / 150 s = 2 tok/s decode), no reason", (len(lruns) == 1) && (row-get(lruns[0], "wall_ms") == 200000) && qcb-near?(row-get(lruns[0], "prefill_tok_s"), 5.0) && qcb-near?(row-get(lruns[0], "decode_tok_s"), 2.0) && nothing?(row-get(lruns[0], "reason")));
   let v2 = fcnv-recorded-at(qcb-runs(), qcb-path(), "Where is fgs-answer defined?\n\n[grounding]", json-node-object([fhn-s("enquiry", "Plan the steps to retire the Python host")]), fcnv-none("unavailable", "/m/model.gguf", "model-queued: fcms-open waits for memory: capacity"), 1200);
   let held = qc-rows(qcb-path());
   let lheld = ledger-rows(qcb-runs(), "LocalRun");
   let r19 = qcb-row("a request that names its enquiry is classified by it, not by the packet; an ask that was not admitted is a row answered 0", (len(held) == 9) && ((String) row-get(held[8], "kind") == "plan") && (row-get(held[8], "answered") == 0) && (row-get(held[8], "wall_ms") == 1200) && (len(lheld) == 2));
   let r20 = qcb-row("the LocalRun row of an ask that did not answer carries the reason the lane named, and no rates", ((String) row-get(lheld[1], "status") == "unavailable") && ((String) row-get(lheld[1], "reason") == "model-queued: fcms-open waits for memory: capacity") && nothing?(row-get(lheld[1], "prefill_tok_s")) && nothing?(row-get(lheld[1], "decode_tok_s")) && (row-get(lheld[1], "wall_ms") == 1200));
   let r21 = qcb-row("a result with no clocks reads both as 0, so no rate is inferred from it", (fcnv-prefill-ms(voiced) == 0) && (fcnv-decode-ms(voiced) == 0) && (fcnv-prefill-ms(clocked) == 24000) && (fcnv-decode-ms(clocked) == 150000));
   // a row names the session that asked; a row before that column reads with it absent. A measurement arm is no traffic: no coverage row, and its LocalRun row names its kind
   let r28 = qcb-row("a coverage row carries the asking session and a row with no session column still reads", ((String) row-get(held[8], "session") == lrun-session()) && nothing?(row-get(held[6], "session")));
   let arm = fcnv-recorded-at(qcb-runs(), qcb-path(), "Tell me about the voice", json-node-object([fhn-s("enquiry_kind", qc-measurement())]), clocked, 9000);
   let armRuns = ledger-rows(qcb-runs(), "LocalRun");
   let r29 = qcb-row("a measurement ask lands no coverage row, keeps its LocalRun row with its kind, and returns the voice's result; a named plain kind stays traffic", ((String) arm[0] == "answered") && (len(qc-rows(qcb-path())) == 9) && (len(armRuns) == 3) && ((String) row-get(armRuns[2], "enquiry_kind") == "measurement") && nothing?(row-get(lheld[1], "enquiry_kind")) && ((String) qc-record-at(qcb-path(), qc-measurement(), "fkwu-model-session", "l", "", 1, 0, 1) == "measurement") && ((String) qc-kind-named("Tell me about the voice", "") == "prose") && ((String) qc-kind-named("Tell me about the voice", "plan") == "plan"));
   // who asked is read from the ancestor line alone: an empty session belongs to the schedule or the person; under a rented agent, through whatever stands between, the id its argv carries or its word; the exam names its own children; a public row names no home
   let lineage = pid => (Comparable) pid == 1 ? [1, 0, "/sbin/launchd"] : (Comparable) pid == 2 ? [2, 1, "/Applications/Claude/2.1/claude"] : (Comparable) pid == 3 ? [3, 2, "/bin/zsh"] : (Comparable) pid == 4 ? [4, 3, "/usr/bin/timeout"] : (Comparable) pid == 5 ? [5, 4, "/x/fkwu"] : (Comparable) pid == 6 ? [6, 1, "/x/fkwu"] : (Comparable) pid == 7 ? [7, 8, "/x/fkwu"] : (Comparable) pid == 8 ? [8, 1, "/Applications/Terminal"] : (Comparable) pid == 9 ? [9, 10, "/x/fkwu"] : (Comparable) pid == 10 ? [10, 1, "/opt/homebrew/bin/codex"]
    : (Comparable) pid == 11 ? [11, 12, "/x/fkwu"] : (Comparable) pid == 12 ? [12, 13, "/bin/zsh", "/c", ["/bin/zsh"]] : (Comparable) pid == 13 ? [13, 1, "/x/claude", "/c", ["/x/claude", "--output-format", "stream-json", "--resume=abc-id"]]
    : (Comparable) pid == 14 ? [14, 15, "/x/fkwu", "/c", ["./fkwu", "observe/form-find-ask.bml"]] : (Comparable) pid == 15 ? [15, 2, "/x/fkwu", "/c", ["./fkwu", "observe/offline-exam-run.bml"]]
    : (Comparable) pid == 17 ? [17, 18, "/x/fkwu"] : (Comparable) pid == 18 ? [18, 1, "/x/claude", "/c", ["/x/claude", "--session-id", "s-2", "-p"]]
    : (Comparable) pid == 19 ? [19, 20, "/w/fkwu", "/w", ["./fkwu", "observe/day-turn.bml"]] : (Comparable) pid == 20 ? [20, 1, "/w/launch/fkwu", "/w", ["/w/launch/fkwu", "/w/launch/walk-launch.fk", "observe/day-turn.bml"]] : [];
   let r30 = qcb-row("who asked, from the ancestor line alone: under a rented agent its word (through timeout and a shell), its argv's --resume= or --session-id id; the walk launcher's child and a terminal's read empty, launchd's bare child reads detached; the exam's children read offline-exam and the exam itself its rented agent", ((String) lrun-session-in(lineage, lineage(5)) == "rented:claude") && ((String) lrun-session-in(lineage, lineage(9)) == "rented:codex") && ((String) lrun-session-in(lineage, lineage(11)) == "abc-id") && ((String) lrun-session-in(lineage, lineage(17)) == "s-2") && ((String) lrun-session-in(lineage, lineage(6)) == "detached") && ((String) lrun-session-in(lineage, lineage(19)) == "") && ((String) lrun-session-in(lineage, lineage(7)) == "") && ((String) lrun-session-in(lineage, lineage(14)) == "offline-exam") && ((String) lrun-session-in(lineage, lineage(15)) == "rented:claude"));
   let r31 = qcb-row("the home reads ~ in a model path and a reason, the weights' names stay for the readers, and nothing stays nothing", ((String) lrun-home-free-of("/h/u/models/Q4_K_M.gguf", "/h/u") == "~/models/Q4_K_M.gguf") && ((String) lrun-home-free-of("carrier;evidence=/h/u/a /h/u/b", "/h/u") == "carrier;evidence=~/a ~/b") && ((String) lrun-home-free-of("/m/model.gguf", "") == "/m/model.gguf") && nothing?(lrun-home-free-of(nothing(), "/h/u")));
   // the synthesis door lands only what the voice did not: the substrate's answer, a provider turn, an ask not made
   let r22 = qcb-row("the synthesis door's own row: substrate yes, provider yes, not asked yes; an ask the voice carried, no", fgs-own-row?(true, true, false) && fgs-own-row?(false, true, true) && fgs-own-row?(false, false, false) && (!fgs-own-row?(false, true, false)));
   // the LoRA lane's clocks are its own stage events read back as values: each stage's wall_ms summed, other stages left out
   let events = ".hearth/query-coverage-band-events.jsonl";
   let wroteEvents = write_file_text(events, "{\"stage\":\"model-admission\",\"wall_ms\":900}\n{\"stage\":\"prefill\",\"tokens\":32,\"wall_ms\":400}\n{\"stage\":\"prefill\",\"tokens\":8,\"wall_ms\":100}\n{\"stage\":\"decode\",\"tokens\":1,\"wall_ms\":70}\n{\"stage\":\"decode\",\"tokens\":1,\"wall_ms\":80}\n{\"stage\":\"finished\",\"wall_ms\":1700}\n");
   let stages = fcgp-rows(events);
   let r23 = qcb-row("the LoRA lane's prefill is the sum of its prefill events (500 ms) and its decode the sum of its decode events (150 ms); admission and finish are not counted", (fcnv-stage-ms(stages, "prefill") == 500) && (fcnv-stage-ms(stages, "decode") == 150) && (fcnv-stage-ms(fcgp-rows(".hearth/query-coverage-band-absent.jsonl"), "prefill") == 0));
   // the two seams that carry no voice: the structural door and the code lane's door, each answered natively with one row
   let seamRows = ".hearth/query-coverage-band-seams.jsonl";
   let seamCleared = write_file_text(seamRows, "");
   let s1 = qc-record-at(seamRows, "structural", "form-find", "form-find", "", 1, 0, 3);
   let s2 = qc-record-at(seamRows, "code", "form-cli-code", "native-code", "", 1, 0, 3);
   let s3 = qc-record-at(seamRows, "structural", "form-find", "form-find", "", 0, 0, 3);
   let seams = qc-rows(seamRows);
   let r24 = qcb-row("the structural door and the code lane read native when answered, and an unanswered row does not", qc-native?(seams[0]) && qc-native?(seams[1]) && (!qc-native?(seams[2])));
   // the door itself, copied under a scratch root: the ledger is the one beside the door, so nothing lands on the living one.
   // Each scratch root begins empty and stands after the run only when a claim of its own failed, with the door's own output to read
   let door = ".hearth/query-coverage-band-door";
   let lane = ".hearth/query-coverage-band-lane";
   let fresh = map(d => fs-remove-tree(d), [door, lane]);
   let dirs = map(d => fs_mkdir(d), [door, door ++ "/observe", door ++ "/receipts"]);
   let copied = write_file_text(door ++ "/observe/form-find-ask.bml", read_file("observe/form-find-ask.bml"));
   let hit = qcb-find(door, "hit", "defs fat-wire-call");
   let miss = qcb-find(door, "miss", "defs qcb-no-such-name-anywhere");
   let wire = qcb-find(door, "wire", "{\"command\":\"defs fat-wire-call\"}");
   let refused = qcb-find(door, "refused", "qcb-no-such-tool anything");
   let doorRows = qc-rows(door ++ "/receipts/query-coverage-ledger.jsonl");
   let r25 = qcb-row("a question the door carries is one row beside the door: structural, form-find, answered with the command's own exit 0, rent 0", ((Comparable) hit[0] == 0) && (str_find(hit[1], "fat-wire-call", 0) >= 0) && (len(doorRows) == 4) && ((String) row-get(doorRows[0], "kind") == "structural") && ((String) row-get(doorRows[0], "source") == "form-find") && (row-get(doorRows[0], "answered") == 1) && (row-get(doorRows[0], "rent_tokens") == 0));
   let r26 = qcb-row("a question that misses keeps its exit 1 and reads answered 1, for no such name is the lane's answer; a tool the lane refuses reads answered 0; the wire form lands its row and prints the wire's answer", ((Comparable) miss[0] != 0) && (row-get(doorRows[1], "answered") == 1) && (str_find(wire[1], "form-agent-tool-wire-v1", 0) >= 0) && (row-get(doorRows[2], "answered") == 1) && ((Comparable) refused[0] != 0) && (row-get(doorRows[3], "answered") == 0));
   // the code lane's door, begun from a scratch directory that holds no receipts: the lane finds nothing there, and its row says so
   let laneDirs = map(d => fs_mkdir(d), [lane, lane ++ "/receipts"]);
   let asked = qcb-code(lane, "asked", "{\"goal\":\"where is fat-wire-call defined\"}");
   let evaluated = qcb-code(lane, "evaluated", "{\"goal\":\"where is fat-wire-call defined\",\"evaluation\":1}");
   let laneRows = qc-rows(lane ++ "/receipts/query-coverage-ledger.jsonl");
   let r27 = qcb-row("the code lane's door lands one row per request: a bare question's own kind, form-cli-code, and an answer of nothing reads answered 0; an evaluation lands none", ((Comparable) asked[0] == 0) && (len(laneRows) == 1) && ((String) row-get(laneRows[0], "kind") == "structural") && ((String) row-get(laneRows[0], "source") == "form-cli-code") && ((String) row-get(laneRows[0], "lane") == "query") && (row-get(laneRows[0], "answered") == 0) && ((Comparable) evaluated[0] == 0));
   // a request handed to the lane in this process crosses the seam the wire's request crosses: the lane's result is the value, then one
   // row naming the session that asked; the carried results here are fixed nodes, so no lane and no model runs
   let cPath = ".hearth/query-coverage-band-carried.jsonl";
   let cCleared = write_file_text(cPath, "");
   let work = parse-json("carried", "{\"goal\":\"make the band read full\",\"writable\":[\"w.bml\"],\"checks\":[],\"model\":\"qwen38-q8\"}");
   let complete = json-node-object([json-node-pair("status", json-node-string("complete"))]);
   let done = fcaq-carried-at(cPath, work, () => complete);
   let short = fcaq-carried-at(cPath, work, () => fcaq-refused("checkpoint-write-refused"));
   let judged = fcaq-carried-at(cPath, parse-json("judged", "{\"goal\":\"make the band read full\",\"writable\":[\"w.bml\"],\"checks\":[],\"evaluation\":1}"), () => complete);
   let carried = qc-rows(cPath);
   let r35 = qcb-row("a request carried in this process is the lane's result, then one row: code, form-cli-code, native-code, its model, answered 1 when complete and 0 when not, the session that asked; an evaluation lands none", node_eq(done, complete) && ((String) fcap-string(short, "status") == "attention") && node_eq(judged, complete) && (len(carried) == 2) && ((String) row-get(carried[0], "kind") == "code") && ((String) row-get(carried[0], "source") == "form-cli-code") && ((String) row-get(carried[0], "lane") == "native-code") && ((String) row-get(carried[0], "model") == "qwen38-q8") && (row-get(carried[0], "answered") == 1) && (row-get(carried[1], "answered") == 0) && ((String) row-get(carried[1], "session") == lrun-session()));
   // the schedule's code asks are the native turn's model ways: they and form-cli task hand their requests through that seam, and the
   // planner's repair stays its option's ask
   let turnSrc = read_file("observe/native-turn-run.bml") ?? "";
   let taskSrc = read_file("form/form-stdlib/bml/form-cli-task.bml") ?? "";
   let r36 = qcb-row("the native turn's model ways and form-cli task hand their requests to the lane through fcaq-managed-covered, and neither reaches fcaq-managed-with past the seam", (str_find(turnSrc, "fcaq-managed-covered(approach,", 0) >= 0) && (str_find(turnSrc, "fcaq-managed-with(", 0) < 0) && (str_find(taskSrc, "fcaq-managed-covered(offered,", 0) >= 0) && (str_find(taskSrc, "fcaq-managed-with(", 0) < 0));
   // a plan is answered once verified: the planner's ask names coverage "after-verdict", so the voice door lands its LocalRun row and no coverage row,
   // and the planner's own row (source local-plan) reads native only when the verdict was verified
   let vPath = ".hearth/query-coverage-band-verdict.jsonl";
   let vRuns = ".hearth/query-coverage-band-verdict-runs.jsonl";
   let vCleared = [write_file_text(vPath, ""), write_file_text(vRuns, "")];
   let planned = fcnv-recorded-at(vRuns, vPath, "Implement the band", json-node-object([fhn-s("enquiry", "plan request r option 1: the steps and the witness of one gap"), fhn-s("coverage", "after-verdict")]), clocked, 9000);
   let r32 = qcb-row("an ask naming coverage after-verdict lands its LocalRun row and no coverage row", ((String) planned[0] == "answered") && (len(qc-rows(vPath)) == 0) && (len(ledger-rows(vRuns, "LocalRun")) == 1));
   let p1 = qc-record-at(vPath, "plan", "local-plan", "registry-weights", "qwen38-q8", 1, 0, 9000);
   let p0 = qc-record-at(vPath, "plan", "local-plan", "registry-weights", "qwen38-q8", 0, 0, 9000);
   let verdicts = qc-rows(vPath);
   let r33 = qcb-row("a verified plan (local-plan, answered 1) reads native and a refused one (answered 0) does not: plan 1 of 2", qc-native?(verdicts[0]) && (!qc-native?(verdicts[1])) && qcb-count?(qc-table(verdicts), "plan", 1, 2));
   // the planner's rows become one coverage row per option: a refusal and its reference care are one ask, a recheck that
   // verified answers the option before it, a row before the walk's start is no row of it, and the mark keeps a second
   // reading from landing a row twice while a killed walk's options land with the next walk
   let pPath = ".hearth/query-coverage-band-plans.jsonl";
   let pCleared = write_file_text(pPath, "");
   let base = now_unix_ms() - 100000;
   let plans = [["A", 1, "first", "refused", "q8", base - 50, 5], ["A", 1, "first", "refused", "q8", base + 100, 7], ["A", 1, "reference-attention", "refused", "q8", base + 200, 11], ["A", 2, "lens", "verified", "q8", base + 300, 13], ["B", 1, "first", "refused", "q4", base + 400, 17], ["B", 0, "recheck", "verified", "retained", base + 500, 0], ["C", 1, "first", "refused", "q8", base + 600, 19]];
   let landed = qc-plan-covered-at(plans, pPath, base);
   let pRows = qc-rows(pPath);
   let again = qc-plan-covered-at(plans, pPath, base);
   let later = now_unix_ms() + 1000;
   let killed = qc-plan-covered-at([["D", 1, "first", "refused", "q8", later, 23]], pPath, later + 5000);
   let r34 = qcb-row("the planner's options become one coverage row each, answered when it or its recheck verified: A#1 0 (wall 18), A#2 1, B#1 1, C#1 0; a second reading lands none, and a killed walk's option lands with the next", (landed == 4) && (len(pRows) == 4) && ((String) row-get(pRows[0], "source") == "local-plan") && (row-get(pRows[0], "answered") == 0) && (row-get(pRows[0], "wall_ms") == 18) && (row-get(pRows[1], "answered") == 1) && (row-get(pRows[2], "answered") == 1) && ((String) row-get(pRows[2], "model") == "q4") && (row-get(pRows[3], "answered") == 0) && (again == 0) && (killed == 1) && (len(qc-rows(pPath)) == 5));
   let swept = map(d => fs-remove-tree(d), append((r25 + r26) == 2 ? [door] : [], r27 == 1 ? [lane] : []));
   print_str("[query-coverage-band] " ++ value_str(r1 + r2 + r3 + r4 + r5 + r6 + r7 + r8 + r9 + r10 + r11 + r12 + r13 + r14 + r15 + r16 + r17 + r18 + r19 + r20 + r21 + r22 + r23 + r24 + r25 + r26 + r27 + r28 + r29 + r30 + r31 + r32 + r33 + r34 + r35 + r36) ++ " of 36");
  }
  def qcb-find(door, name, ask) {
   let base = door ++ "/" ++ name;
   let w = write_file_text(base ++ ".in", ask);
   let pid = host_spawn_at(["./fkwu", door ++ "/observe/form-find-ask.bml"], [base ++ ".in", base ++ ".out", base ++ ".err"]);
   [pid <= 0 ? -1 : host_wait(pid), read_file(base ++ ".out") ?? ""];
  }
  def qcb-code(lane, name, ask) {
   let base = host_cwd() ++ "/" ++ lane ++ "/" ++ name;
   let w = write_file_text(base ++ ".in", ask ++ "\n");
   let pid = host_spawn_at([host_cwd() ++ "/fkwu", host_cwd() ++ "/observe/form-cli-code-run.fk"], [base ++ ".in", base ++ ".out", base ++ ".err", host_cwd() ++ "/" ++ lane]);
   [pid <= 0 ? -1 : host_wait(pid), read_file(base ++ ".out") ?? ""];
  }
 }
 qcb-run();
}
