; form-token-teaching-band.bml — the voice is taught every Form token it can write.
;
; preludes: form-stdlib/bml/form-token-grammar.bml form-stdlib/lora-backward.bml
; REQUIRES: nothing opened; the teaching text is read and its examples are answered
;
; The census counts the nine Form tokens (recipe-birth, recipe-exec, recipe-import, choice, eval, knowledge-query,
; node-get, node-make, node-select) the voice authors, per 1,000 generated IDs. On 2026-10-08 it read recipe-import
; authored 0 of 252: the verb sat in the table and had its executor, and the teaching the voice reads (ftg-teaching)
; never named it. A token the voice is not told about is not written. This band reads the teaching as the voice does:
; every control it contains is scanned out, and the verbs those controls name must be every verb the table holds.
;
; The same census, asked of the trainer (observe/form-token-lora-run.bml, lane census), refused all 36 recipe-import rows
; unknown-verb: the contract's verb list (lora-backward.bml lbw-of-verbs, which is also the Qwen head's control-ID rows)
; held eight verbs and the grammar nine, so the adapter was never taught the ninth token. Claim 8 holds the two lists to
; the same verbs.
;
; Verdict 15 when every claim lands:
;   1     the controls the teaching shows name all nine of the contract's verbs (none is left untaught)
;   2     every control the teaching shows names a verb the stream answers (an example is never an unknown verb)
;   4     the recipe-import example that lists the libraries is answered by Form with a library by name
;   8     the trainer's contract holds every verb the grammar holds, and no other (one list of Form tokens, in two places)
section [form.bml] {
 class FormTokenTeachingBand {
  def ftt-bit(ok, bit) = ok ? bit : 0;
  // VERB is the teaching's own placeholder and observation is Form's envelope: neither is a verb the voice writes
  def ftt-shown() = ftg-scan-any(ftg-teaching()) |> map(c => c[0]) |> filter(v => v != "VERB" && v != "observation");
  def ftt-covered?(verb) = any?(v => v == verb, ftt-shown());
  def ftt-score() {
   let listing = ftg-observe-with(ftg-session-fresh(), "recipe-import", "?");
   ftt-bit(all?(v => ftt-covered?(v), ftg-verbs()), 1)
     + ftt-bit(all?(v => ftg-verb?(v), ftt-shown()), 2)
     + ftt-bit(ftv-starts?(listing, "value=") && str_find(listing, "training-cost", 0) >= 0, 4)
     + ftt-bit(len(lbw-of-verbs()) == len(ftg-verbs()) && all?(v => lbw-of-verb?(v), ftg-verbs()), 8);
  }
 }
 ftt-score();
}
