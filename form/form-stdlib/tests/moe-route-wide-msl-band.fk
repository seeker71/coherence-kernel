; moe-route-wide-msl-band.fk — the wide softmax router's emitted text says what
; the recombination claims, and differs from BOTH parents where it must.
;
; preludes: form-stdlib/core.fk form-stdlib/moe-route-wide-msl.fk
;
; run: ./fkwu form/form-stdlib/tests/moe-route-wide-msl-band.fk   ; -> 255
;
; Verdict 255. A read-back gate, no GPU — the same shape dsv4-moe-msl-band uses:
; the emitted MSL is read back into Form and pinned, so the transcription can be
; falsified on this machine without a device.
;
; What this band does NOT claim: that the kernel RUNS, or that it agrees with the
; recipe numerically. That is a GPU harness's job and it has not been run. This
; gates the text and the contract only, and says so.

(do
    (defn mrwb-find (h n) (str_find h n 0))
    (defn mrwb-has (h n) (if (lt (mrwb-find h n) 0) 0 1))
    (defn mrwb-count-from (h n from c)
        (do (let i (str_find h n from))
            (if (lt i 0) c (mrwb-count-from h n (add i 1) (add c 1)))))
    (defn mrwb-count (h n) (mrwb-count-from h n 0 0))
    (defn mrwb-score (ok bit) (if ok bit 0))

    (defn moe-route-wide-msl-band ()
        (do
    (let U (mrw-msl-appendix))
    ; the kernel is present, once, under the name the carrier binds
    (let c0 (mrwb-score (eq (mrwb-count U "kernel void form_moe_route_wide_f32") 1) 1))
    ; SCALE taken from dsv4-router: 256-wide thread-local arrays and the refusal
    (let c1 (mrwb-score (if (eq (mrwb-has U "float p[256]") 1)
                            (if (eq (mrwb-has U "float taken[256]") 1)
                                (mrwb-has U "if (ne > 256u) return;") 0) 0) 2))
    ; the nsel refusal and the pick array it protects
    (let c2 (mrwb-score (if (eq (mrwb-has U "if (nsel > 8u) return;") 1)
                            (mrwb-has U "uint pick[8]") 0) 4))
    ; MATH taken from mm-route: softmax with max-subtract through fexp
    (let c3 (mrwb-score (mrwb-has U "fexp(logits[i] - mx)") 8))
    ; renormalization over the CHOSEN only — the wsum/winv pair, not the full sum
    (let c4 (mrwb-score (if (eq (mrwb-has U "float winv = 1.0f / wsum;") 1)
                            (mrwb-has U "wts[k] = p[pick[k]] * winv;") 0) 16))
    ; FALSIFIER — the write order is mm-route's NATURAL order, not dsv4's
    ; reversal. If someone "fixes" this to match the sibling, this bit dies.
    (let c5 (mrwb-score (if (eq (mrwb-has U "ids[k] = pick[k];") 1)
                            (if (eq (mrwb-has U "nused - 1u - j") 0) 1 0) 0) 32))
    ; FALSIFIER — softmax routing carries NO steering signal. DS4's bias must be
    ; absent from both the selection and the interface.
    (let c6 (mrwb-score (if (eq (mrwb-has U "bias") 0)
                            (if (eq (mrwb-has U "wscale") 0) 1 0) 0) 64))
    ; APPENDIX contract: emits no spine of its own, so it can never double-define
    (let c7 (mrwb-score (if (eq (mrwbb-none U) 1) 1 0) 128))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))

    ; the appendix contract, read as three absences at once
    (defn mrwbb-none (U)
        (if (eq (mrwb-has U "#include") 0)
            (if (eq (mrwb-has U "using namespace") 0)
                (if (eq (mrwb-has U "float fexp(") 0) 1 0)
                0)
            0))

    (moe-route-wide-msl-band))
