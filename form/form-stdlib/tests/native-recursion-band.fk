; Recursion and logic behavior: 7. The in-RAM native leaf is witnessed on its home arm by
; jit-leaf-inram-band.fk.
; preludes: form-stdlib/core.fk
(do
    (defn fact (n)
        (if (le n 1) 1
            (mul n (fact (sub n 1)))))
    (let r0 (fact 6))
    (let r1 (fact 6))
    (let r2 (fact 7))
    (let r3 (fact 0))
    (defn in-range (x) (if (and (ge x 0) (le x 5)) 1 0))
    (let rlog1 (in-range 3))
    (let rlog2 (in-range 6))
    (let rlog3 (in-range -1))
    (add (if (eq r0 720) 1 0)
         (add (if (eq r1 720) 1 0)
              (add (if (eq r2 5040) 1 0)
                   (add (if (eq r3 1) 1 0)
                        (add (if (eq rlog1 1) 1 0)
                             (add (if (eq rlog2 0) 1 0)
                                  (if (eq rlog3 0) 1 0))))))))
