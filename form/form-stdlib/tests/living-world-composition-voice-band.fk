; living-world-composition-voice-band.fk -- confirmed three-node composition speaks.
; Verdict 32767 proves fifteen capability, voice, and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/living-world-multilens-plan.fk form-stdlib/living-world-composition-outcome.fk form-stdlib/living-world-composition-voice.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk form-stdlib/tests/living-world-relational-voice-witness.fk form-stdlib/tests/living-world-multilens-witness.fk form-stdlib/tests/living-world-composition-outcome-witness.fk form-stdlib/tests/living-world-composition-voice-witness.fk

(do
    (let world (lwcvw-world))
    (let context (lwcvw-context-for world))
    (let context-world (lwcp-context-world context))
    (let proposal (lwcvw-proposal-for world))
    (let candidate (lwt-proposal-candidate proposal))
    (let utterance (lwo-emergent-shape candidate))
    (let composition (lwcv-utterance-composition utterance))
    (let waiting
        (lwcv-integrate (lwcvw-round) proposal (lwrew-action)))
    (let integrated (lwcvw-integrated-round))
    (let integrated-world (lwt-round-world integrated))
    (let late (lwcvw-late-world))
    (let contested
        (lwo-emergent-shape
            (lwt-proposal-candidate (lwcow-contested-proposal))))

    (let c1 (if (and (eq (lwco-integrated-current?
                              context-world
                              (lwcvw-composition-candidate)) 1)
                         (eq (lwo-active? context-world
                              (lwo-emergent-shape (lwrvw-left))) 0)) 1 0))
    (let c2 (if (eq (lwco-confirmed?
                         (lwco-composition-state composition)) 1) 2 0))
    (let c3 (if (and (eq (len
                              (lwrp-sequence-items
                                (lwcv-utterance-sequence utterance))) 3)
                         (eq (lwmp-aligned?
                              (lwmp-bundle-status
                                (lwco-composition-bundle composition))) 1))
                     4 0))
    (let c4 (if (str_eq (lwcv-utterance-surface utterance)
                         "forty-nine!") 8 0))
    (let c5 (if (and (node_eq
                          (lwcv-utterance-composition-candidate utterance)
                          (lwcvw-composition-candidate))
                         (eq (lwlc-unknown?
                              (lwmp-bundle-declared-unknown
                                (lwco-composition-bundle composition))) 1))
                     16 0))
    (let c6 (if (and (eq (lwo-field-size
                              (lwcv-utterance-alternatives utterance)) 0)
                         (and (node_eq (lwcv-utterance-unknown utterance)
                                      (lwo-none))
                              (node_eq (lwcv-utterance-choice utterance)
                                       (lwo-none)))) 32 0))
    (let c7 (if (and (eq (lwo-field-size
                              (lwcv-utterance-witnesses utterance)) 9)
                         (eq (lwo-field-size
                              (lwt-proposal-participants proposal)) 9)) 64 0))
    (let c8 (if (and (eq (lwcp-context-current? world context) 1)
                         (eq (lwcv-utterance-current?
                              world utterance) 1)) 128 0))
    (let c9 (if (and (eq (lwo-world-has?
                              (lwt-round-world waiting) candidate) 0)
                         (and (eq (lwo-active?
                                   integrated-world candidate) 1)
                              (eq (lwo-field-size
                                   (lwo-active-attributions-for
                                     integrated-world candidate)) 9))) 256 0))
    (let c10 (if (eq (lwcv-proposal-current?
                          integrated-world proposal) 1) 512 0))
    (let c11 (if (and (eq (lwcp-context-current? late context) 1)
                          (eq (lwco-candidate-current? late
                               (lwcvw-composition-candidate)) 0)) 1024 0))
    (let c12 (if (and (eq (lwcv-utterance-current?
                               late utterance) 0)
                          (eq (lwcv-proposal-current?
                               late proposal) 0)) 2048 0))
    (let c13 (if (and (eq (lwcv-composition-speakable?
                               composition) 1)
                          (eq (lwcv-composition-speakable?
                               contested) 0)) 4096 0))
    (let c14 (if (and (node_eq
                           (lwco-proposal-for world
                             (lwmpw-divergent-bundle)) (lwo-none))
                          (and (node_eq
                                (lwco-proposal-for world
                                  (lwmpw-open-bundle)) (lwo-none))
                               (node_eq
                                (lwco-proposal-for world
                                  (lwmpw-ambiguous-bundle)) (lwo-none))))
                      8192 0))
    (let c15 (if (and (node_eq
                           (lwnv-sequence-for context-world
                             (lwrvw-referent)) (lwo-none))
                          (and (eq (lwnv-symbol-positioned?
                                    (lwo-emergent-shape
                                      (lwmpw-third))) 0)
                               (node_eq
                                (lwcv-utterance-evidence utterance)
                                (lwcvw-evidence)))) 16384 0))
    (lwcvw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
