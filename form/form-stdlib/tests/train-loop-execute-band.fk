; train-loop-execute-band.fk — the hands actually write.
;
; Verdict 63 (6 bits):
;   1   emit-nothing-rows writes real bytes; return equals summed file_size
;   2   the calibration corpus is STRICTLY larger — the permission-phrased
;       fact rows are in it (abstaintax fix present in the bytes)
;   4   a calibration line carries BOTH the permission phrase and a real fact
;       answer — the pairing that unteaches over-refusal
;   8   the host command door returns its actual output; native training's
;       process and failure contract has its own native-lora-worker band
;   16  an unknown directive is nothing; the live coverage-mint carrier is not
;       opened by this bounded dispatcher band (coverage-mint-band is separate)
;   32  write_file returns the byte count (probed: 6 for "hello\n") — the
;       reporting mystery was the reader's tail -1, never the writer
;
; preludes: learn/train-loop-execute.fk

(do
    (defn tleb-bit (ok bit) (if ok bit 0))
    (defn tleb-has (s sub) (if (ge (str_find s sub 0) 0) 1 0))
    (defn train-loop-execute-band ()
        (do
            (let dir (str_concat "/tmp/native-train-emitter-" (int_to_str (host_pid))))
            (fs-mkdir dir)
            (let n (tle-emit-nothing-at dir))
            (let sz1 (add (file_size (str_concat dir "/train.jsonl"))
                          (file_size (str_concat dir "/valid.jsonl"))))
            (let c (tle-emit-calibration-at dir))
            (let cal (cte-calibration-text))
            (let wf (write_file (str_concat dir "/writer.txt") "hello\n"))
            (fs-remove-tree dir)
            (sum (list
                (tleb-bit (and (not (nothing? n)) (eq n sz1)) 1)
                (tleb-bit (and (not (nothing? c)) (gt c n)) 2)
                (tleb-bit (and (eq (tleb-has cal "reply exactly: nothing") 1)
                               (eq (tleb-has cal "\"spurious\"") 1)) 4)
                (tleb-bit (str_eq (host-exec "printf handsok" "") "handsok") 8)
                (tleb-bit (nothing? (tle-execute "unknown-directive" "" "")) 16)
                (tleb-bit (eq wf 6) 32)))))
    (train-loop-execute-band))
