; tests/bml-hati-native-import-consts-proof.fk
;
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk
;
; A unit's top-level consts are part of its scope. Its own methods read
; them; importers reach them by qualified name (`import BMF;`), through an
; on-demand import (`import BMF.*;`) and as one symbol (`import BMF.step;`).
; A const's value resolves in its own unit, so a const built from another
; const, or from a const its unit imports, carries its value across. A local
; const shadows an imported one, and a const no import reaches stays
; unresolved. Every source runs on BMA and on Hati with one answer.

(do
    (defn score-bool (actual)
        (if actual 1 0))

    ; the canonical sources live in tests/fixtures, one program to a file
    (defn ic-node (name)
        (bml-source-exec-parse-node
            (bml-source-parse-executable-stream
                (bml-source-scan-file (str_concat "form-stdlib/tests/fixtures/" name)))))

    ; both lanes answer the same value, and it is the expected one
    (defn ic-equal (node units expected)
        (do
            (let on-bma (bml-bma-run-unit-value node units))
            (let on-hati (bml-hati-run-unit-value node units))
            (if (value_eq on-bma on-hati)
                (if (value_eq on-hati expected) 1 0)
                0)))

    (let bmf-unit
        (ic-node "bml-consts-unit-bmf.bml"))
    (let deep-unit
        (ic-node "bml-consts-unit-deep.bml"))
    (let units (list bmf-unit deep-unit))

    (let star-image (bml-hati-compile-unit-image (ic-node "bml-consts-star.bml") units))

    (sum
        (list
            (ic-equal (ic-node "bml-consts-star.bml") units 42)
            (ic-equal (ic-node "bml-consts-qualified.bml") units 42)
            (ic-equal (ic-node "bml-consts-single-symbol.bml") units 42)
            (ic-equal (ic-node "bml-consts-built-from-const.bml") units 42)
            (ic-equal (ic-node "bml-consts-read-by-method.bml") units 42)
            (ic-equal (ic-node "bml-consts-through-import.bml") units 42)
            (ic-equal (ic-node "bml-consts-local-shadows.bml") units 42)
            (ic-equal (ic-node "bml-consts-own-unit.bml") (empty) 42)
            (ic-equal (ic-node "bml-consts-unimported.bml") units "BML-HATI-UNSUPPORTED name/unbound")
            (ic-equal (ic-node "bml-consts-package-bare.bml") units "BML-HATI-UNSUPPORTED name/unbound")
            (ic-equal (ic-node "bml-consts-missing-symbol.bml") units "BML-HATI-UNSUPPORTED import/unresolved")
            (score-bool (bml-hati-image-supported? star-image))
            (score-bool (lt (str_find (bml-hati-table-file star-image) "BML-HATI-UNSUPPORTED" 0) 0)))))
