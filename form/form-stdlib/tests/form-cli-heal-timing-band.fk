; Expected 255. Pure interval accounting; no writes to living state.
; preludes: form-stdlib/bml/form-cli-heal-timing.bml
(do
 (let spans (fhwt-spans (list (list "open-begin" 10) (list "load-begin" 20) (list "load-ready" 70) (list "stop" 90)) 100))
 (add (if (and (eq (len spans) 5) (eq (fhwt-total spans) 100)) 1 0)
 (add (if (eq (nth (nth spans 2) 3) 50) 2 0)
 (add (if (eq (fhwt-total (fhwt-spans (list) 87)) 87) 4 0)
 (add (if (nil? (fhwt-spans (list (list "a" 20) (list "b" 10)) 30)) 8 0)
 (add (if (nil? (fhwt-spans (list (list "a" 40)) 30)) 16 0)
 (add (if (eq (fhwt-total (fhwt-spans (list (list "a" 10) (list "b" 10)) 20)) 20) 32 0)
 (add (if (and (str_eq (fhwt-family "work-begin") "other-observed-stages") (str_eq (fhwt-family "model-prefill-positions-64") "prefill")) 64 0)
      (if (eq (fhwt-family-ms (fhwt-spans (list (list "model-session-prefill-begin" 10) (list "model-prefill-positions-64" 30) (list "model-session-open-prefill-complete" 80)) 100) "prefill") 70) 128 0)))))))))
