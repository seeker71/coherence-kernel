; form-cli-flow-bml-band.fk — real BML class/template/field flow is used.
;
; Verdict 1023 when every claim lands:
;     1  named grains Ice/Liquid/Compost
;     2  choice-walk native/local/remote
;     4  ingest uses named grains
;     8  cut: capability 0 scores 0
;    16  route: learned native wins (named weights)
;    32  route: blind native yields to agent
;    64  flywheel flips agent -> native
;   128  weak local still loses
;   256  class descriptor FormCliFlow minted (generic T)
;   512  high-grammar authority carries package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk form-stdlib/form-cli-flow-xtal.fk
; Proven by: this band on fkwu
; witnessed: 2026-08-21 -> 1023

(do
    (defn fcf-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn fcf-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (fcf-has-name? (tail xs) name))))

    (let bits (fcf-check))
    (let desc (FormCliFlow))
    (let dname (nth desc 1))
    (let tparams (nth desc 2))
    (let methods (nth desc 3))
    (let fields (nth desc 4))
    (let src (read_file "form/form-stdlib/bml/form-cli-flow.bml"))
    (let b8 (if (and (str_eq dname "FormCliFlow")
                     (and (eq (fcf-has-name? tparams "T") 1)
                          (and (eq (fcf-has-name? methods "fcf-walk") 1)
                               (eq (fcf-has-name? fields "Ice") 1))))
                256 0))
    (let b9 (if (and (eq (fcf-has-str? src "package Form.cli.flow") 1)
                     (and (eq (fcf-has-str? src "interface IChoiceWalk") 1)
                          (and (eq (fcf-has-str? src "class FormCliRouter") 1)
                               (and (eq (fcf-has-str? src "const int WeightSovereignty") 1)
                                    (eq (fcf-has-str? src "template BackendCell") 1)))))
                512 0))
    (add bits (add b8 b9)))
