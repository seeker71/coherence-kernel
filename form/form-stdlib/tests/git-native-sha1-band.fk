; git-native-sha1-band.fk — SHA-1 in Form (git-sha1.bml), held against the published vectors and against the names git itself gave objects.
;
; The recorded constants are FIPS 180-4 / NIST vectors and ids git documents; nothing is computed by another program.
;
;   1    "abc" = a9993e36 4706816a ba3e2571 7850c26c 9cd0d89d
;   2    the empty string = da39a3ee 5e6b4b0d 3255bfef 95601890 afd80709
;   4    the 56-byte two-block vector "abcdbcdecdef...nopq" = 84983e44 1c3bd26e baae4aa1 f95129e5 e54670f1
;   8    the 112-byte vector "abcdefghbcdefghi...nopqrstu" = a49b2446 a02c645b f419f995 b6709125 3a04a259
;   16   one million "a" = 34aa973c d4c4daa4 f61eeb2b dbad2731 6534016f (15,625 blocks through the loop)
;   32   git's object ids: the empty blob e69de29b..., "hello\n" ce013625..., "test content\n" d670460b... (hash-object's own manual)
;   64   gsha-hex-of-raw / gsha-raw-of-hex round-trip every digest above; a non-hex or odd-length string answers nothing()
;   128  self-verification: at least 24 (48 here) of this repository's loose objects, of every size git happened to store, are inflated
;        and hashed, and every one equals the name it was stored under (sha1 of the framed object IS its name)
;
; Expected: 255
; Verdict 255
; REQUIRES: (the string natives and the u32 bit natives of fkwu)
; preflight-exec: forbidden
import form-stdlib/core.fk;
import form-stdlib/bml/git-sha1.bml;
import form-stdlib/bml/git-inflate.bml;
import form-stdlib/bml/git-store.bml;
section [form.bml] {
  def gsb-bit(ok, bit) = ok ? bit : 0;
  def gsb-say(label, v) = print([label, v]);
  def gsb-rep(s, n) = n <= 1 ? s : n % 2 == 0 ? gsb-rep(str_concat(s, s), n / 2) : str_concat(s, gsb-rep(str_concat(s, s), n / 2));
  def gsb-eq(a, b) = (String) a == (String) b;
  // the loose objects of one fan-out directory: [name hex ...]
  def gsb-names(root, d) = map(f => d ++ f, host_dir_list(root ++ "/" ++ d) ?? []);
  def gsb-obj-ok(root, hex) {
    let src = read_file(root ++ "/" ++ substring(hex, 0, 2) ++ "/" ++ substring(hex, 2, 40));
    let z = nothing?(src) ? nothing() : ginf-zlib(src, 0);
    nothing?(z) ? false : gsb-eq(gsha-hex(z[0]), hex);
  }
  def gsb-sizes(root, hex) {
    let src = read_file(root ++ "/" ++ substring(hex, 0, 2) ++ "/" ++ substring(hex, 2, 40));
    let z = nothing?(src) ? nothing() : ginf-zlib(src, 0);
    nothing?(z) ? 0 - 1 : len(z[0]);
  }
  def gsb-all(root, names) = nil?(names) ? true : gsb-obj-ok(root, names[0]) && gsb-all(root, names[1:]);
  def gsb-run() {
    let t0 = host_monotonic_ms();
    let h1 = gsha-hex("abc");
    let h2 = gsha-hex("");
    let h3 = gsha-hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq");
    let h4 = gsha-hex("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu");
    let million = gsb-rep("a", 1000000);
    let t1 = host_monotonic_ms();
    let h5 = gsha-hex(million);
    let t2 = host_monotonic_ms();
    let e1 = gsha-object-hex("blob", "");
    let e2 = gsha-object-hex("blob", "hello\n");
    let e3 = gsha-object-hex("blob", "test content\n");
    let s1 = gsb-say("vectors", [h1, h2, h3, h4]);
    let s2 = gsb-say("million a", [h5, len(million), "ms", t2 - t1]);
    let s3 = gsb-say("git ids", [e1, e2, e3]);
    let b1 = gsb-bit(gsb-eq(h1, "a9993e364706816aba3e25717850c26c9cd0d89d"), 1);
    let b2 = gsb-bit(gsb-eq(h2, "da39a3ee5e6b4b0d3255bfef95601890afd80709"), 2);
    let b4 = gsb-bit(gsb-eq(h3, "84983e441c3bd26ebaae4aa1f95129e5e54670f1"), 4);
    let b8 = gsb-bit(gsb-eq(h4, "a49b2446a02c645bf419f995b67091253a04a259"), 8);
    let b16 = gsb-bit(gsb-eq(h5, "34aa973cd4c4daa4f61eeb2bdbad27316534016f"), 16);
    let b32 = gsb-bit(gsb-eq(e1, "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391") && gsb-eq(e2, "ce013625030ba8dba906f756967f9e9ca394464a") && gsb-eq(e3, "d670460b4b4aece5915caf5c68d12f560a9fe3e4"), 32);
    let raw = gsha-raw("abc");
    let rt = gsha-raw-of-hex(gsha-hex-of-raw(raw));
    let b64 = gsb-bit(len(raw) == 20 && gsb-eq(rt, raw) && nothing?(gsha-raw-of-hex("zz")) && nothing?(gsha-raw-of-hex("abc")) && gsha-hex?("00ff") && !gsha-hex?("0g"), 64);
    let r = git-open(".");
    let objroot = nothing?(r) ? "" : gs-common(r) ++ "/objects";
    let dirs = ["01", "1a", "2b", "3c", "4d", "5e", "6f", "7a", "8b", "9c", "ad", "be", "cf", "d0", "e1", "f2"];
    let names = nothing?(r) ? [] : gs-flatten(map(d => take(3, gsb-names(objroot, d)), dirs));
    let s4 = gsb-say("loose objects hashed", [len(names)]);
    let b128 = gsb-bit(!nothing?(r) && len(names) >= 24 && gsb-all(objroot, names), 128);
    let verdict = b1 + b2 + b4 + b8 + b16 + b32 + b64 + b128;
    let shown = print(["git-native-sha1-band", "verdict", verdict, "ms", host_monotonic_ms() - t0]);
    verdict;
  }
  gsb-run();
}
