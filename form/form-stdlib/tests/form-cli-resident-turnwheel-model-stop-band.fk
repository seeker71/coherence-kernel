; form-cli-resident-turnwheel-model-stop-band.fk — a terminal stop carries
; into the resident session itself, so a later task cannot read it as live.
; Expected: 127
;
; This is a pure session/flow witness: no model context is opened, no Metal
; work is submitted, and the synthetic handles are never dereferenced.
;
; preludes: form-stdlib/form-cli-resident-turnwheel.fk

(do
    (defn fcrtmssb-bit (held weight) (if held weight 0))
    (defn fcrtmssb-seed ()
        (fcms-session "live" "before-stop" "/m/qwen.gguf" "qwen"
            (list 1 2 3) (list 4 5) 128 47 29 0 13 11 7 3))
    (defn form-cli-resident-turnwheel-model-stop-band ()
        (do
            (let seed (fcrtmssb-seed))
            (let receipt (list "token-route" 17 1 0))
            (let stopped (fcrt-model-stop-session seed))
            (let flow (fcrt-model-stop-flow seed receipt))
            (let carried (fcrt-flow-payload flow))
            (sum (list
                (fcrtmssb-bit (and (eq (fcms-live? stopped) 1)
                    (and (str_eq (fcms-reason stopped) "before-stop")
                         (eq (fcms-stopped? stopped) 1))) 1)
                (fcrtmssb-bit (and (eq (fcms-pos stopped) 47)
                    (eq (fcms-pending stopped) 29)) 2)
                (fcrtmssb-bit (and (eq (fcms-generated-ids stopped) 11)
                    (and (eq (fcms-injected-ids stopped) 7)
                         (eq (fcms-observations stopped) 3))) 4)
                (fcrtmssb-bit (and (eq (fcms-stopped? seed) 0)
                    (and (eq (fcms-prompt-ids stopped) 13)
                    (and (eq (value_eq (fcms-ctx stopped) (fcms-ctx seed)) 1)
                         (eq (value_eq (fcms-sts stopped) (fcms-sts seed)) 1)))) 8)
                (fcrtmssb-bit (str_eq (fcrt-flow-phase flow) "model") 16)
                (fcrtmssb-bit (and (eq (fcms-stopped? carried) 1)
                    (and (eq (fcms-pos carried) (fcms-pos stopped))
                         (eq (fcms-pending carried) (fcms-pending stopped)))) 32)
                (fcrtmssb-bit (eq (value_eq (fcrt-flow-receipt flow) receipt) 1) 64)))))

    (form-cli-resident-turnwheel-model-stop-band))
