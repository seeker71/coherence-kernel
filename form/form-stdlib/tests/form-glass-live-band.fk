; form-glass-live-band.fk — cadence, ownership, and control adapter proof.
;
; preludes: form-stdlib/form-glass-live.bml
; Verdict 536870911: inventory merge, newest-id deduplication, model activity, observer exclusion,
; terminal host-port parsing, cadence, held controls, stale projection,
; refused unsupported control, privacy, source selfmolt, exact model route doors,
; measured route projection, exact derived tensor extents, typed owner
; observations, and authority.

(do
    (defn fglb-bit (held weight) (if (eq held 1) weight 0))
    (defn fglb-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))
    (let self (fgl-monitor-sample 100))
    (let model (fgtm-sample "model.qwen" (fgtm-absent) "model" "metal"
        "model.qwen" "reasoning" "reason" (fgtm-absent) (fgtm-absent)
        "active" (fgtm-present 100) (fgtm-present 100) (fgtm-present 900)
        (fgtm-present 1262) "never" "physical-live" "model.carrier"
        (list "memory" "model" "gpu")))
    (let snapshot (fgtm-snapshot "models.owner" 100 (list model)))
    (let reading (fgtm-read-state "models.owner" "current" (fgtm-present snapshot)))
    (let inventory (list "glass-inventory-v1" "/tmp/test" "current"
        (list "models.owner") (list reading)))
    (let legacyReading (fgtm-read-state "models.dual-resident" "current"
        (fgtm-present (fgtm-snapshot "models.dual-resident" 90 (list model)))))
    (let incarnatedReading (fgtm-read-state "models.dual-resident.i42" "current"
        (fgtm-present (fgtm-snapshot "models.dual-resident.i42" 100 (list model)))))
    (let migratedInventory (list "glass-inventory-v1" "/tmp/test" "current"
        (list "models.dual-resident" "models.dual-resident.i42")
        (list legacyReading incarnatedReading)))
    (let offer (fgtm-control-offer "glass-monitor" "offer.1" 1 "focus"
        (fgtm-present "gpu") "declared" "terminal.operator"))
    (let held (fgl-control-new "all" "offer.1" offer (list model) 2))
    (let freshSamples (fgl-inventory-samples-at inventory 100))
    (let staleSamples (fgl-inventory-samples-at inventory 6000))
    (let unsupported (fgtm-control-offer "glass-monitor" "offer.2" 2 "inspect"
        (fgtm-present "model.qwen") "declared" "terminal.operator"))
    (let duplicate (fgtm-sample "model.qwen" (fgtm-absent) "model" "metal"
        "model.qwen" "reasoning" "older" (fgtm-absent) (fgtm-absent)
        "released" (fgtm-present 10) (fgtm-present 10) (fgtm-present 0)
        (fgtm-absent) "released" "derived-window" "older.owner" (list "model")))
    (let sameHandleNewer (fgtm-sample "model.physical-alias" (fgtm-absent) "model" "metal"
        "model.carrier" "reasoning" "same physical model, newer publisher name"
        (fgtm-absent) (fgtm-absent) "active"
        (fgtm-present 200) (fgtm-present 200) (fgtm-present 901)
        (fgtm-present 1262) "never" "physical-live" "newer.owner" (list "memory" "model" "gpu")))
    (let authority (read_file "form/form-stdlib/bml/form-glass-live.bml"))
    (let executable (read_file "form/form-stdlib/form-glass-live.bml"))
    (let staleState (fgl-control-stale-state "all" offer))
    (let staleHeld (fgl-control-new (fgl-control-focus staleState)
        (fgl-control-last-offer staleState) offer (list model) 40001))
    (let one (fgd-segment-frame 1 1 100 "all" (list) (list) (list) "held"))
    (let two (fgd-segment-frame 1 2 100 "all" (list) (list) (list) "held"))
    (let previousControl (fgl-control-state "all" "none" 0 "held"))
    (let proposedControl (fgl-control-state "gpu" "offer.1" 0 "focus"))
    (let failedCommit (fgl-control-commit previousControl proposedControl
        (list "glass-control-write-v1" "failed")))
    (let acknowledgedCommit (fgl-control-commit previousControl proposedControl
        (list "glass-control-write-v1" "acknowledged")))
    (let inactiveQueue (fgl-hearth-queue-rows 4 3 0 0 1))
    (let activeQueue (fgl-hearth-queue-rows 4 3 1 7721 1))
    (let drainedQueue (fgl-hearth-queue-rows 3 3 1 7721 1))
    (let absentQueue (fgl-hearth-queue-present
        "/tmp/form-glass-absent-task-spool" "/tmp/form-glass-absent-reply-spool"
        (nothing) (nothing)))
    (let dependencyIdentity (fglu-dependency-manifest))
    (let routeRows (fgl-model-route-rows freshSamples 100))
    (let readyRouteRow (fgl-route-row
        (nmrr-measured "model.qwen" 1 100 "fixture-ready") "Qwen route"))
    (let owner "models.dual-resident.i1000")
    (let ownerHeartbeat (fgtm-sample "heartbeat.i1000" (fgtm-absent)
        "owner-heartbeat" "form" owner "model-owner" "dual-model-owner"
        (fgtm-absent) (fgtm-present 7) "active" (fgtm-present 2000)
        (fgtm-present 1000) (fgtm-absent) (fgtm-present 4242) "never"
        "physical-live" "model.owner" (list "process" "model" "health" "membrane")))
    (let derivedLedger (fgl-owner-derived-ledger-present owner 2000))
    (let allocatedLedger (fgl-find-sample derivedLedger "tensor.owner.allocated"))
    (let allocatedObservation (fgl-owner-observation allocatedLedger ownerHeartbeat))

    (let b0 (fglb-bit (and (eq (len freshSamples) 1)
                            (eq (len (fgl-inventory-samples-at migratedInventory 100)) 1)) 1))
    (let b1 (fglb-bit (and (eq (len (fgl-inventory-publishers inventory)) 1)
                            (str_eq (head (fgl-inventory-publishers inventory)) "models.owner")) 2))
    (let b2 (fglb-bit (and (eq (fgl-any-active? (list self)) 0)
                            (and (eq (fgl-any-active? (list self model)) 1)
                                 (eq (fgl-any-active? staleSamples) 0))) 4))
    (let b3 (fglb-bit (and (eq (fgl-cycle? 0 5) 1)
                            (and (eq (fgl-cycle? 5 5) 1)
                                 (eq (fgl-cycle? 6 5) 0))) 8))
    (let b4 (fglb-bit (and (eq (fgl-terminal-number "/usr/bin/printf 88" 40 1 100) 88)
                            (eq (fgl-terminal-number "/usr/bin/printf 8" 40 1 100) 8)) 16))
    (let b5 (fglb-bit (and (str_eq (fgl-control-focus held) "all")
                            (and (str_eq (fgl-control-last-offer held) "offer.1")
                                 (str_eq (fgl-control-status held) "held"))) 32))
    (let b6 (fglb-bit (and (eq (fgtm-sample-valid? self) 1)
                            (eq (fgtm-field-present? (fgtm-sample-bytes self)) 0)) 64))
    (let b7 (fglb-bit (and (str_eq (fgtm-sample-evidence self) "physical-live")
                            (str_eq (fgtm-sample-id self) "process.form-glass")) 128))
    (let b8 (fglb-bit (and (eq (fglb-has authority "OwnershipRule") 1)
                            (eq (fglb-has authority "owner Metal, MLX, JIT") 1)) 256))
    (let b9 (fglb-bit (and (eq (fglb-has authority "250ms") 1)
                            (and (eq (fglb-has authority "500ms") 1)
                                 (and (eq (fglb-has authority "every frame") 1)
                                      (and (eq (fglb-has authority "every 4 frames") 1)
                                           (and (eq (fglb-has authority "every 16 frames") 1)
                                                (and (eq (fglb-has authority "every 20 frames") 1)
                                                     (and (eq (fglb-has authority "DemandRule") 1)
                                                          (eq (fglb-has authority "warm organs") 0)))))))) 512))
    (let b10 (fglb-bit (and (eq (fglb-has authority "never prompt or answer bytes") 1)
                             (eq (fglb-has authority "enum actions") 1)) 1024))
    (let b11 (fglb-bit (and (eq (fglb-has authority "without hiding the cursor") 1)
                             (eq (fglb-has authority "alternate-screen cleanup") 1)) 2048))
    (let b12 (fglb-bit (and (eq (fglb-has authority "ObserverTaxRule") 1)
                             (and (eq (fglb-has authority "never serializes or reparses its own changing epoch") 1)
                                  (eq (fglb-has authority "suppresses identical terminal projections") 1))) 4096))
    (let b13 (fglb-bit (and (str_eq (fgtm-sample-evidence (head staleSamples)) "derived-window")
                             (and (str_eq (fgtm-sample-source (head staleSamples)) "model.carrier")
                                  (eq (fgd-has-channel (fgtm-sample-channels (head staleSamples)) "snapshot-stale") 1))) 8192))
    (let b14 (fglb-bit (and (eq (fgl-control-offer-applicable? (list model) offer) 1)
                             (eq (fgl-control-offer-applicable? (list model) unsupported) 1)) 16384))
    (let b15 (fglb-bit (and (eq (fglb-has authority "LeaseRule") 1)
                             (and (eq (fglb-has authority "QueueRule") 1)
                                  (and (eq (fglb-has authority "surviving file never proves a living owner") 1)
                                       (and (str_eq (fgo-id (head inactiveQueue)) "queue-state")
                                            (and (str_eq (fgo-evidence (head inactiveQueue)) "catalog")
                                                 (and (str_eq (fgo-id (head activeQueue)) "queue-depth")
                                                      (and (str_eq (fgo-evidence (head activeQueue)) "physical-live")
                                                           (eq (fgl-control-offer-fresh? offer 40000) 0)))))))) 32768))
    (let deduped (fgl-newest-samples-by-snapshot
        (list (fgl-sample-entry 100 "models.owner" model)
              (fgl-sample-entry 200 "models.owner" duplicate))))
    (let handleDeduped (fgl-newest-samples-by-snapshot
        (list (fgl-sample-entry 100 "models.owner" model)
              (fgl-sample-entry 300 "models.owner" sameHandleNewer))))
    (let crossPublisherHandle (fgl-newest-samples-by-snapshot
        (list (fgl-sample-entry 100 "models.owner" model)
              (fgl-sample-entry 300 "other.process" sameHandleNewer))))
    (let crossPublisherId (fgl-newest-samples-by-snapshot
        (list (fgl-sample-entry 100 "models.owner" model)
              (fgl-sample-entry 200 "other.process" duplicate))))
    (let b16 (fglb-bit (and (eq (len deduped) 1)
        (and (str_eq (fgtm-sample-lifecycle (head deduped)) "released")
             (and (eq (len handleDeduped) 1)
                  (and (str_eq (fgtm-sample-id (head handleDeduped)) "model.physical-alias")
                       (and (eq (len crossPublisherHandle) 2)
                            (eq (len crossPublisherId) 2)))))) 65536))
    (let b17 (fglb-bit (and (eq (fglb-has authority "ProcessRule") 1)
                             (and (eq (fglb-has authority "GovernorRefreshRule") 1)
                                  (and (eq (fglb-has executable "fgo-live-process-rows") 1)
                                       (and (eq (fglb-has executable "form-resource-governor-glass-current-run.fk") 1)
                                            (eq (fglb-has executable "/bin/ps -axo") 0))))) 131072))
    (let b18 (fglb-bit (and (str_eq (fgl-control-focus staleState) "all")
                             (and (str_eq (fgl-control-last-offer staleState) "offer.1")
                                  (and (str_eq (fgl-control-status staleState) "stale")
                                       (str_eq (fgl-control-status staleHeld) "held")))) 262144))
    (let b19 (fglb-bit (and (eq (len (fgd-segment-frame-lines one)) 1)
                             (and (le (str_len (ftc-segment-text (head (head (fgd-segment-frame-lines one))))) 1)
                                  (and (eq (len (fgd-segment-frame-lines two)) 2)
                                       (le (str_len (ftc-segment-text (head (nth (fgd-segment-frame-lines two) 1)))) 1)))) 524288))
    (let b20 (fglb-bit (and (str_eq (fgl-control-status failedCommit) "ack-failed")
                             (and (str_eq (fgl-control-focus failedCommit) "all")
                                  (and (str_eq (fgl-control-last-offer failedCommit) "none")
                                       (str_eq (fgl-control-focus acknowledgedCommit) "gpu")))) 1048576))
    (let b21 (fglb-bit (and (eq (fgl-dependency-changed? dependencyIdentity 4) 0)
                             (and (eq (fgl-dependency-changed? "changed" 3) 0)
                                  (and (eq (fgl-dependency-changed? "changed" 4) 1)
                                       (and (eq (fglb-has authority "SelfMoltRule") 1)
                                            (eq (fglb-has executable "fglu-supervisor-mark") 1))))) 2097152))
    (let b22 (fglb-bit (and (eq (len routeRows) 3)
                             (and (str_eq (fgo-id (head routeRows))
                                      "route.model.qwen3.8-flash-next.ud-q2_k_xl.unsloth")
                                  (and (eq (fgo-present? (head routeRows)) 0)
                                       (str_eq (fgo-source (head routeRows))
                                           "host.process.owner-liveness")))) 4194304))
    (let b23 (fglb-bit (and (eq (fgo-present? readyRouteRow) 1)
                             (and (eq (fgo-int-value readyRouteRow) 1)
                                  (and (str_eq (fgo-evidence readyRouteRow) "physical-live")
                                       (str_eq (fgo-lifecycle readyRouteRow) "ready")))) 8388608))
    (let b24 (fglb-bit (and (eq (fgl-string-selfmolt-at? 100 262244 4) 1)
                              (and (eq (fgl-string-selfmolt-at? 100 262244 3) 0)
                               (and (eq (fgl-string-selfmolt-at? 100 262243 4) 0)
                                (and (eq (fgl-node-selfmolt-at? 100 262244 4) 1)
                                 (and (str_eq (fgo-lifecycle (head drainedQueue)) "drained")
                                  (and (eq (fglb-has authority "StringPoolRule") 1)
                                       (eq (fglb-has authority "kernel.ephemeral-render-string") 1))))))) 16777216))
    (let b25 (fglb-bit (and (eq (len derivedLedger) 8)
                              (and (eq (fgtm-samples-valid? derivedLedger) 1)
                               (and (eq (fgtm-field-value (fgtm-sample-bytes allocatedLedger)) 154537596)
                                (eq (fgtm-field-value (fgtm-sample-capacity allocatedLedger)) 218)))) 33554432))
    (let b26 (fglb-bit (and (eq (fgov2-observation? allocatedObservation) 1)
                              (and (str_eq (fgov2-observation-kind allocatedObservation) "tensor")
                               (and (eq (fgov2-truth-value (fgov2-observation-measurement allocatedObservation)) 154537596)
                                (and (eq (fgov2-lifetime-pid (fgov2-truth-value (fgov2-provenance-lifetime (fgov2-observation-provenance allocatedObservation)))) 4242)
                                 (eq (fgov2-truth-value (fgov2-provenance-sequence (fgov2-observation-provenance allocatedObservation))) 7))))) 67108864))
    (let b27 (fglb-bit (and (str_eq (fgl-control-key-action "h") "focus")
                             (and (str_eq (fgl-control-key-argument "h" "") "help")
                              (and (str_eq (fgl-control-key-action "i") "inspect")
                               (and (eq (fgl-control-key-needs-argument? "i" "inspect") 1)
                                (and (str_eq (fgl-control-key-action "q") "abstain")
                                     (eq (fgl-control-key-needs-argument? "q" "abstain") 0)))))) 134217728))
    (let b28 (fglb-bit (and (eq (fgl-queue-file-present? (nothing)) 0)
                             (and (eq (fgl-count-substring (nothing) "turn=") 0)
                                  (and (eq (len absentQueue) 3)
                                       (and (str_eq (fgo-id (nth absentQueue 1)) "queue-task-frames")
                                            (and (eq (fgo-int-value (nth absentQueue 1)) 0)
                                                 (eq (fglb-has authority "typed nothing are handled before string measurement") 1)))))) 268435456))
    (sum (list b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 b16 b17 b18 b19 b20 b21 b22 b23 b24 b25 b26 b27 b28)))
