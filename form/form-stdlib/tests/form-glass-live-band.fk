; form-glass-live-band.fk — cadence, ownership, and control adapter proof.
;
; preludes: form-stdlib/form-glass-live.bml
; Verdict 1073741823: inventory merge, newest-id deduplication, model activity, observer exclusion,
; terminal host-port parsing, cadence, held controls, stale projection,
; refused unsupported control, privacy, source selfmolt, exact model route doors,
; measured route projection, exact profile arithmetic, catalog/stat-only
; promotion refusal, adversarial profile relabel refusal, carried strong
; identity comparison, typed owner observations, and authority.

(do
    (defn fglb-bit (held weight) (if (eq held 1) weight 0))
    (defn fglb-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))
    (defn fglb-artifact-samples (identities parent owner handle)
        (if (eq (len identities) 0) (list)
            (cons (fgtm-sample (nmtl-artifact-identity-id (head identities))
                (fgtm-present parent) "artifact-open-stat" "disk" owner
                "memory" "open-time-file-stat"
                (fgtm-present (nmtl-artifact-identity-bytes (head identities)))
                (fgtm-present (nmtl-artifact-identity-modified (head identities)))
                "mapped" (fgtm-present 1000) (fgtm-absent) (fgtm-absent)
                (fgtm-present handle) "pressure-only" "physical-live"
                "fixture.open-path-file-stat"
                (list "process" "model" "memory" "tensor" "metal" "gpu"))
                (fglb-artifact-samples (tail identities) parent owner handle))))
    (defn fglb-strong-identities (identities)
        (if (eq (len identities) 0) (list)
            (cons (nmtl-artifact-identity
                (nmtl-artifact-identity-id (head identities))
                (nmtl-artifact-identity-bytes (head identities))
                (nmtl-artifact-identity-modified (head identities))
                (nmtl-artifact-identity-locator (head identities))
                "content-digest")
                (fglb-strong-identities (tail identities)))))
    (defn fglb-strong-samples (identities owner handle)
        (if (eq (len identities) 0) (list)
            (cons (nmdt-open-artifact-identity-sample-at
                (nmtl-artifact-identity-id (head identities))
                (nmtl-artifact-identity-id (head identities)) owner
                (nmtl-artifact-identity-strength (head identities))
                (nmtl-artifact-identity-locator (head identities))
                handle 1000 "fixture.open-content-digest"
                (list "process" "model" "memory" "tensor" "metal" "gpu"))
                (fglb-strong-samples (tail identities) owner handle))))
    (defn fglb-profile-with-identities (profile identities)
        (nmtl-layout-profile (nmtl-layout-profile-id profile)
            (nmtl-layout-profile-catalog-bytes profile)
            (nmtl-layout-profile-mapped-bytes profile)
            (nmtl-layout-profile-mapped-handles profile)
            (nmtl-layout-profile-allocated-bytes profile)
            (nmtl-layout-profile-allocated-handles profile)
            identities (nmtl-layout-profile-witnessed profile)))
    (let self (fgl-monitor-sample 100))
    (let model (fgtm-sample "model.qwen" (fgtm-absent) "model" "metal"
        "model.qwen" "reasoning" "reason" (fgtm-absent) (fgtm-absent)
        "active" (fgtm-present 100) (fgtm-present 100) (fgtm-present 900)
        (fgtm-present 1262) "never" "physical-live" "model.carrier"
        (list "memory" "model" "gpu")))
    (let attention (fgtm-sample "state.model.qwen.active" (fgtm-present "model.qwen")
        "model-state" "metal" "models.owner" "reasoning" "active"
        (fgtm-absent) (fgtm-absent) "active" (fgtm-present 100)
        (fgtm-present 100) (fgtm-absent) (fgtm-present 1262) "never"
        "physical-live" "model.session" (list "model" "gpu" "query-lane")))
    (let activeRequest (fgtm-sample "request.flow.active" (fgtm-absent)
        "request" "membrane" "models.owner" "reasoning" "model-flow"
        (fgtm-absent) (fgtm-present 1) "active" (fgtm-present 100)
        (fgtm-present 100) (fgtm-absent) (fgtm-absent) "pressure-only"
        "physical-live" "model-flow.owner" (list "flow" "query-lane")))
    (let completedRequest (fgtm-sample "request.flow.completed" (fgtm-absent)
        "request" "membrane" "models.owner" "reasoning" "model-flow"
        (fgtm-absent) (fgtm-present 1) "completed" (fgtm-present 100)
        (fgtm-present 100) (fgtm-absent) (fgtm-absent) "pressure-only"
        "physical-live" "model-flow.owner" (list "flow" "query-lane")))
    (let snapshot (fgtm-snapshot "models.owner" 100 (list model)))
    (let reading (fgtm-read-state "models.owner" "current" (fgtm-present snapshot)))
    (let inventory (list "glass-inventory-v1" "/tmp/test" "current"
        (list "models.owner") (list reading)))
    (let legacyReading (fgtm-read-state "models.dual-resident" "current"
        (fgtm-present (fgtm-snapshot "models.dual-resident" 90 (list model)))))
    (let incarnatedReading (fgtm-read-state "models.dual-resident.i42" "current"
        (fgtm-present (fgtm-snapshot "models.dual-resident.i42" 100 (list model)))))
    (let migratedInventory (list "glass-inventory-v1" "/tmp/test" "current"
        (list "models.dual-resident" "models.dual-resident.i42")
        (list legacyReading incarnatedReading)))
    (let offer (fgtm-control-offer "glass-monitor" "offer.1" 1 "focus"
        (fgtm-present "gpu") "declared" "terminal.operator"))
    (let held (fgl-control-new "all" "offer.1" offer (list model) 2))
    (let freshSamples (fgl-inventory-samples-at inventory 100))
    (let staleSamples (fgl-inventory-samples-at inventory 6000))
    (let unsupported (fgtm-control-offer "glass-monitor" "offer.2" 2 "inspect"
        (fgtm-present "model.qwen") "declared" "terminal.operator"))
    (let duplicate (fgtm-sample "model.qwen" (fgtm-absent) "model" "metal"
        "model.qwen" "reasoning" "older" (fgtm-absent) (fgtm-absent)
        "released" (fgtm-present 10) (fgtm-present 10) (fgtm-present 0)
        (fgtm-absent) "released" "derived-window" "older.owner" (list "model")))
    (let sameHandleNewer (fgtm-sample "model.physical-alias" (fgtm-absent) "model" "metal"
        "model.carrier" "reasoning" "same physical model, newer publisher name"
        (fgtm-absent) (fgtm-absent) "active"
        (fgtm-present 200) (fgtm-present 200) (fgtm-present 901)
        (fgtm-present 1262) "never" "physical-live" "newer.owner" (list "memory" "model" "gpu")))
    (let authority (read_file "form/form-stdlib/bml/form-glass-live.bml"))
    (let executable (read_file "form/form-stdlib/form-glass-live.bml"))
    (let sensors (read_file "observe/form-glass-sensors-live.fk"))
    (let staleState (fgl-control-stale-state "all" offer))
    (let staleHeld (fgl-control-new (fgl-control-focus staleState)
        (fgl-control-last-offer staleState) offer (list model) 40001))
    (let one (fgd-segment-frame 1 1 100 "all" (list) (list) (list) "held"))
    (let two (fgd-segment-frame 1 2 100 "all" (list) (list) (list) "held"))
    (let previousControl (fgl-control-state "all" "none" 0 "held"))
    (let proposedControl (fgl-control-state "gpu" "offer.1" 0 "focus"))
    (let failedCommit (fgl-control-commit previousControl proposedControl
        (list "glass-control-write-v1" "failed")))
    (let acknowledgedCommit (fgl-control-commit previousControl proposedControl
        (list "glass-control-write-v1" "acknowledged")))
    (let inactiveQueue (fgl-hearth-queue-rows 4 3 0 0 1))
    (let activeQueue (fgl-hearth-queue-rows 4 3 1 7721 1))
    (let drainedQueue (fgl-hearth-queue-rows 3 3 1 7721 1))
    (let absentQueue (fgl-hearth-queue-present
        "/tmp/form-glass-absent-task-spool" "/tmp/form-glass-absent-reply-spool"
        (nothing) (nothing)))
    (let dependencyIdentity (fglu-dependency-manifest))
    (let routeRows (fgl-model-route-rows freshSamples 100 7))
    (let readyRouteRow (fgl-route-row
        (nmrr-measured "model.qwen" 1 100 "fixture-ready") "Qwen route"))
    (let owner "models.dual-resident.i1000")
    (let ownerHeartbeat (fgtm-sample "heartbeat.i1000" (fgtm-absent)
        "owner-heartbeat" "form" owner "model-owner" "dual-model-owner"
        (fgtm-absent) (fgtm-present 7) "active" (fgtm-present 2000)
        (fgtm-present 1000) (fgtm-absent) (fgtm-present 4242) "never"
        "physical-live" "model.owner" (list "process" "model" "health" "membrane")))
    (let qownerModel (fgtm-sample (FGLQwenRouteId) (fgtm-absent) "model"
        "metal" owner "reasoning" "callable-model-context" (fgtm-absent)
        (fgtm-absent) "ready" (fgtm-present 1000) (fgtm-present 1000)
        (fgtm-absent) (fgtm-present 1262) "inactive-only" "physical-live"
        "model.carrier-handle" (list "memory" "model" "metal" "gpu")))
    (let townerModel (fgtm-sample (FGLThreeBRouteId) (fgtm-absent) "model"
        "metal" owner "reasoning" "callable-model-context" (fgtm-absent)
        (fgtm-absent) "ready" (fgtm-present 1000) (fgtm-present 1000)
        (fgtm-absent) (fgtm-present 1695) "inactive-only" "physical-live"
        "model.carrier-handle" (list "memory" "model" "metal" "gpu")))
    (let qweight (fgtm-sample (FGLQwenWeightId) (fgtm-present (FGLQwenRouteId))
        "weights" "disk" (FGLQwenRouteId) "reasoning" "model-weights"
        (fgtm-present 78869128864) (fgtm-absent) "unknown"
        (fgtm-present 1000) (fgtm-absent) (fgtm-absent) (fgtm-absent)
        "pressure-only" "catalog" "gguf.catalog" (list "memory" "model" "cache")))
    (let tweight (fgtm-sample (FGLThreeBWeightId) (fgtm-present (FGLThreeBRouteId))
        "weights" "disk" (FGLThreeBRouteId) "reasoning" "model-weights"
        (fgtm-present 2019377376) (fgtm-absent) "unknown"
        (fgtm-present 1000) (fgtm-absent) (fgtm-absent) (fgtm-absent)
        "pressure-only" "catalog" "gguf.catalog" (list "memory" "model" "cache")))
    (let mappedCounter (fgtm-sample "mapping.owner.mmap-buffer-handles"
        (fgtm-absent) "mapping-counter" "metal" owner "memory"
        "mmap-no-copy-buffer-handles" (fgtm-absent) (fgtm-present 1480)
        "active" (fgtm-present 2000) (fgtm-absent) (fgtm-absent)
        (fgtm-absent) "never" "physical-live"
        "metal_status.mmap_nocopy_buffers" (list "process" "model" "memory" "metal")))
    (let bufferCounter (fgtm-sample "metal.owner.buffers" (fgtm-absent)
        "metal-gauge" "metal" owner "memory" "allocated-metal-buffer-handles"
        (fgtm-absent) (fgtm-present 1698) "active" (fgtm-present 2000)
        (fgtm-absent) (fgtm-absent) (fgtm-absent) "never" "physical-live"
        "metal_status.buffers" (list "process" "model" "memory" "metal")))
    (let qidentities (nmtl-layout-profile-artifact (nmtl-qwen-layout-profile)))
    (let tidentities (nmtl-layout-profile-artifact (nmtl-llama-layout-profile)))
    (let qartifacts (fglb-artifact-samples qidentities
        (FGLQwenRouteId) owner 1262))
    (let tartifacts (fglb-artifact-samples tidentities
        (FGLThreeBRouteId) owner 1695))
    (let catalogInputs (list qownerModel townerModel qweight tweight
        mappedCounter bufferCounter))
    (let ledgerInputs (append catalogInputs (append qartifacts tartifacts)))
    (let derivedLedger (fgl-owner-derived-ledger-present ledgerInputs owner 2000))
    (let profileLedger (fgl-owner-derived-ledger-profile ledgerInputs owner 2000
        (nmtl-qwen-layout-profile) (nmtl-llama-layout-profile)))
    (let allocatedLedger (fgl-find-sample profileLedger "tensor.owner.allocated"))
    (let mappedLedger (fgl-find-sample profileLedger "tensor.owner.mapped"))
    (let qMappedLedger (fgl-find-sample profileLedger "tensor.qwen38.mapped"))
    (let tMappedLedger (fgl-find-sample profileLedger "tensor.llama32-3b.mapped"))
    (let mappedReconciled (fgl-find-sample profileLedger
        "tensor.owner.mapped-reconciliation"))
    (let buffersReconciled (fgl-find-sample profileLedger
        "tensor.owner.buffer-reconciliation"))
    (let mlxPath (fgl-find-sample profileLedger "mlx.owner.model-path"))
    (let profileGap (fgl-owner-derived-ledger-present
        (list qownerModel townerModel qweight mappedCounter bufferCounter)
        owner 2000))
    (let artifactGap (fgl-owner-derived-ledger-present catalogInputs owner 2000))
    (let firstQIdentity (head qidentities))
    (let badArtifact (fgtm-sample
        (nmtl-artifact-identity-id firstQIdentity)
        (fgtm-present (FGLQwenRouteId)) "artifact-open-stat" "disk"
        owner "memory" "open-time-file-stat"
        (fgtm-present (add (nmtl-artifact-identity-bytes firstQIdentity) 1))
        (fgtm-present (nmtl-artifact-identity-modified firstQIdentity))
        "mapped" (fgtm-present 1000) (fgtm-absent) (fgtm-absent)
        (fgtm-present 1262) "pressure-only" "physical-live"
        "fixture.open-path-file-stat"
        (list "process" "model" "memory" "tensor" "metal" "gpu")))
    (let mismatchInputs (append catalogInputs
        (append (cons badArtifact (tail qartifacts)) tartifacts)))
    (let mismatchGap (fgl-owner-derived-ledger-present
        mismatchInputs owner 2000))
    (let relabeledQIdentities (fglb-strong-identities qidentities))
    (let relabeledTIdentities (fglb-strong-identities tidentities))
    (let relabeledQProfile (fglb-profile-with-identities
        (nmtl-qwen-layout-profile) relabeledQIdentities))
    (let relabeledTProfile (fglb-profile-with-identities
        (nmtl-llama-layout-profile) relabeledTIdentities))
    (let relabelGap (fgl-owner-derived-ledger-profiles ledgerInputs owner 2000
        relabeledQProfile relabeledTProfile))
    (let qStrongSamples (fglb-strong-samples relabeledQIdentities owner 1262))
    (let tStrongSamples (fglb-strong-samples relabeledTIdentities owner 1695))
    (let badStrong (nmdt-open-artifact-identity-sample-at
        (nmtl-artifact-identity-id (head relabeledQIdentities))
        (nmtl-artifact-identity-id (head relabeledQIdentities)) owner
        "content-digest" "adversarial-relabel-value" 1262 1000
        "fixture.open-content-digest"
        (list "process" "model" "memory" "tensor" "metal" "gpu")))
    (let strongMismatchInputs (append ledgerInputs
        (append (cons badStrong (tail qStrongSamples)) tStrongSamples)))
    (let strongMismatchGap (fgl-owner-derived-ledger-profiles
        strongMismatchInputs owner 2000 relabeledQProfile relabeledTProfile))
    (let admissionHeld (eq (sum (list
        (if (eq (len derivedLedger) 2) 1 0)
        (if (str_eq (fgtm-sample-purpose (head derivedLedger))
                "open-time-content-identity-not-published") 1 0)
        (if (str_eq (fgtm-sample-source (head derivedLedger))
                "model.owner.open-artifact-content-identity") 1 0)
        (if (eq (fgtm-field-present?
                (fgtm-sample-bytes (head derivedLedger))) 0) 1 0)
        (if (str_eq (fgtm-sample-purpose (head artifactGap))
                "open-time-artifact-identity-not-published") 1 0)
        (if (str_eq (fgtm-sample-source (head artifactGap))
                "model.owner.open-artifact-identity") 1 0)
        (if (str_eq (fgtm-sample-purpose (head mismatchGap))
                "open-time-artifact-identity-mismatch") 1 0)
        (if (str_eq (fgtm-sample-source (head mismatchGap))
                "model.owner.open-artifact-identity-match") 1 0)
        (if (eq (len (fgl-find-sample relabelGap "tensor.owner.mapped")) 0) 1 0)
        (if (str_eq (fgtm-sample-purpose (head relabelGap))
                "open-time-content-identity-not-published") 1 0)
        (if (eq (len (fgl-find-sample strongMismatchGap
                "tensor.owner.mapped")) 0) 1 0)
        (if (str_eq (fgtm-sample-purpose (head strongMismatchGap))
                "open-time-content-identity-mismatch") 1 0)
        (fglb-has authority "collision-prone size-plus-mtime equality")
        (fglb-has authority "carried strong-identity kind and exact value")
        (fglb-has executable "nmdt-open-artifact-identity-value"))) 15))
    (let allocatedObservation (fgl-owner-observation allocatedLedger ownerHeartbeat))
    (let heldOwnerMetric (fgo-int "process" "model-owner-cpu"
        "Model owner CPU" 42 "tenths-percent" 42 "cpu-scheduler"
        "physical-live" "fixture" "live" "cpu" "retained epoch"))
    (let heldOtherMetric (fgo-int "host" "memory-free" "Memory free"
        9 "percent" 9 "host-memory" "physical-live" "fixture" "live"
        "memory" "not owner"))
    (let heldOwnerRows (fgl-held-owner-rows
        (list heldOtherMetric heldOwnerMetric)))
    (let heldSurface (fgl-surface-at (list 88 8 1000) 1999))

    (let b0 (fglb-bit (and (eq (len freshSamples) 1)
                            (eq (len (fgl-inventory-samples-at migratedInventory 100)) 1)) 1))
    (let b1 (fglb-bit (and (eq (len (fgl-inventory-publishers inventory)) 1)
                            (str_eq (head (fgl-inventory-publishers inventory)) "models.owner")) 2))
    (let b2 (fglb-bit (and (eq (fgl-any-active? (list self model ownerHeartbeat mappedCounter completedRequest)) 0)
                            (and (eq (fgl-any-active? (list attention activeRequest)) 1)
                                 (and (eq (fgl-attention-active-sample? activeRequest) 1)
                                      (and (eq (fgl-attention-active-sample? completedRequest) 0)
                                           (eq (fgl-any-active? staleSamples) 0))))) 4))
    (let b3 (fglb-bit (and (eq (fgl-cycle? 0 5) 1)
                            (and (eq (fgl-cycle? 5 5) 1)
                                 (eq (fgl-cycle? 6 5) 0))) 8))
    (let b4 (fglb-bit (and (eq (fgl-terminal-number "/usr/bin/printf 88" 40 1 100) 88)
                            (and (eq (fgl-terminal-number "/usr/bin/printf 8" 40 1 100) 8)
                                 (and (eq (len heldOwnerRows) 1)
                                      (and (str_eq (fgo-id (head heldOwnerRows)) "model-owner-cpu")
                                           (and (eq (nth heldSurface 0) 88)
                                           (and (eq (nth heldSurface 1) 8)
                                           (and (eq (nth heldSurface 2) 1000)
                                           (and (eq (fgl-count-substring executable "fgl-terminal-width()") 2)
                                                (eq (fgl-count-substring executable "fgl-terminal-height()") 2))))))))) 16))
    (let b5 (fglb-bit (and (str_eq (fgl-control-focus held) "all")
                            (and (str_eq (fgl-control-last-offer held) "offer.1")
                                 (str_eq (fgl-control-status held) "held"))) 32))
    (let b6 (fglb-bit (and (eq (fgtm-sample-valid? self) 1)
                            (eq (fgtm-field-present? (fgtm-sample-bytes self)) 0)) 64))
    (let b7 (fglb-bit (and (str_eq (fgtm-sample-evidence self) "physical-live")
                            (str_eq (fgtm-sample-id self) "process.form-glass")) 128))
    (let b8 (fglb-bit (and (eq (fglb-has authority "OwnershipRule") 1)
                            (eq (fglb-has authority "owner Metal, MLX, JIT") 1)) 256))
    (let b9 (fglb-bit (and (eq (fglb-has authority "40ms") 1)
                            (and (eq (fglb-has authority "50ms") 1)
                                 (and (eq (fglb-has authority "every frame") 1)
                                      (and (eq (fglb-has authority "every 4 frames") 1)
                                           (and (eq (fglb-has authority "every 10 frames") 1)
                                                (and (eq (fglb-has authority "form-glass-sensors-live.fk") 1)
                                                     (and (eq (fglb-has authority "DemandRule") 1)
                                                          (eq (fglb-has authority "warm organs") 0)))))))) 512))
    (let b10 (fglb-bit (and (eq (fglb-has authority "never prompt or answer bytes") 1)
                             (eq (fglb-has authority "enum actions") 1)) 1024))
    (let b11 (fglb-bit (and (eq (fglb-has authority "without hiding the cursor") 1)
                             (eq (fglb-has authority "alternate-screen cleanup") 1)) 2048))
    (let b12 (fglb-bit (and (eq (fglb-has authority "ObserverTaxRule") 1)
                             (and (eq (fglb-has authority "never serializes or reparses its own changing epoch") 1)
                                  (eq (fglb-has authority "suppresses identical terminal projections") 1))) 4096))
    (let b13 (fglb-bit (and (str_eq (fgtm-sample-evidence (head staleSamples)) "derived-window")
                             (and (str_eq (fgtm-sample-source (head staleSamples)) "model.carrier")
                                  (eq (fgd-has-channel (fgtm-sample-channels (head staleSamples)) "snapshot-stale") 1))) 8192))
    (let b14 (fglb-bit (and (eq (fgl-control-offer-applicable? (list model) offer) 1)
                             (eq (fgl-control-offer-applicable? (list model) unsupported) 1)) 16384))
    (let b15 (fglb-bit (and (eq (fglb-has authority "LeaseRule") 1)
                             (and (eq (fglb-has authority "QueueRule") 1)
                                  (and (eq (fglb-has authority "surviving file never proves a living owner") 1)
                                       (and (str_eq (fgo-id (head inactiveQueue)) "queue-state")
                                            (and (str_eq (fgo-evidence (head inactiveQueue)) "catalog")
                                                 (and (str_eq (fgo-id (head activeQueue)) "queue-depth")
                                                      (and (str_eq (fgo-evidence (head activeQueue)) "physical-live")
                                                           (eq (fgl-control-offer-fresh? offer 40000) 0)))))))) 32768))
    (let deduped (fgl-newest-samples-by-snapshot
        (list (fgl-sample-entry 100 "models.owner" model)
              (fgl-sample-entry 200 "models.owner" duplicate))))
    (let handleDeduped (fgl-newest-samples-by-snapshot
        (list (fgl-sample-entry 100 "models.owner" model)
              (fgl-sample-entry 300 "models.owner" sameHandleNewer))))
    (let crossPublisherHandle (fgl-newest-samples-by-snapshot
        (list (fgl-sample-entry 100 "models.owner" model)
              (fgl-sample-entry 300 "other.process" sameHandleNewer))))
    (let crossPublisherId (fgl-newest-samples-by-snapshot
        (list (fgl-sample-entry 100 "models.owner" model)
              (fgl-sample-entry 200 "other.process" duplicate))))
    (let b16 (fglb-bit (and (eq (len deduped) 1)
        (and (str_eq (fgtm-sample-lifecycle (head deduped)) "released")
             (and (eq (len handleDeduped) 1)
                  (and (str_eq (fgtm-sample-id (head handleDeduped)) "model.physical-alias")
                       (and (eq (len crossPublisherHandle) 2)
                            (eq (len crossPublisherId) 2)))))) 65536))
    (let b17 (fglb-bit (and (eq (fglb-has authority "ProcessRule") 1)
                             (and (eq (fglb-has authority "GovernorRefreshRule") 1)
                                  (and (eq (fglb-has sensors "fgo-live-process-rows") 1)
                                       (and (eq (fglb-has sensors "form-resource-governor-glass-current-run.fk") 1)
                                       (and (eq (fglb-has executable "form-resource-governor-glass-current-run.fk") 0)
                                            (eq (fglb-has executable "/bin/ps -axo") 0)))))) 131072))
    (let b18 (fglb-bit (and (str_eq (fgl-control-focus staleState) "all")
                             (and (str_eq (fgl-control-last-offer staleState) "offer.1")
                                  (and (str_eq (fgl-control-status staleState) "stale")
                                       (str_eq (fgl-control-status staleHeld) "held")))) 262144))
    (let b19 (fglb-bit (and (eq (len (fgd-segment-frame-lines one)) 1)
