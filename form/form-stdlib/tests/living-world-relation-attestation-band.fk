; living-world-relation-attestation-band.fk -- independent seeing, still no edge.
; Verdict 32767 proves fifteen attestation and non-promotion claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/living-world-multilens-plan.fk form-stdlib/living-world-composition-outcome.fk form-stdlib/living-world-composition-voice.fk form-stdlib/living-world-relation-hypothesis.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk form-stdlib/tests/living-world-relational-voice-witness.fk form-stdlib/tests/living-world-multilens-witness.fk form-stdlib/tests/living-world-composition-outcome-witness.fk form-stdlib/tests/living-world-relation-hypothesis-witness.fk form-stdlib/tests/living-world-relation-attestation-witness.fk

(do
    (let one-world LWRHA-ONE-WORLD)
    (let world LWRHA-WORLD)
    (let self-attestation (lwrhw-self-attestation))
    (let self-world (lwrhw-self-world))
    (let one-first-current
        (lwrh-attestation-current? one-world LWRHA-ATTESTATION-FIRST))
    (let one-first-observation-current
        (lwrh-observation-current? one-world LWRHA-OBSERVATION-FIRST
            LWRHA-ATTESTATION-FIRST))
    (let two-first-current
        (lwrh-attestation-current? world LWRHA-ATTESTATION-FIRST))
    (let two-second-current
        (lwrh-attestation-current? world LWRHA-ATTESTATION-SECOND))
    (let two-first-observation-current
        (lwrh-observation-current? world LWRHA-OBSERVATION-FIRST
            LWRHA-ATTESTATION-FIRST))
    (let two-second-observation-current
        (lwrh-observation-current? world LWRHA-OBSERVATION-SECOND
            LWRHA-ATTESTATION-SECOND))
    (let one-proposals (lwrl-proposals one-world 2))
    (let one-first-proposal
        (lwmpw-find-proposal one-proposals
            (lwrhw-relation-zeta) (lwrvw-left) (lwmpw-third)))
    (let one-second-proposal
        (lwmpw-find-proposal one-proposals
            (lwrhw-relation-zeta) (lwmpw-third) (lwrvw-right)))
    (let first-sources
        (lwt-sources-from-attributions
            (lwo-field-items
                (lwo-active-attributions-for world LWRHA-ATTESTATION-FIRST))
            (lwo-empty-field)))

    (let c1 (if (eq (lwrh-attestation-valid-shape?
                         LWRHA-ATTESTATION-FIRST) 1) 1 0))
    (let c2 (if (eq one-first-current 1) 2 0))
    (let c3 (if (eq one-first-observation-current 1) 4 0))
    (let c4 (if (and (node_eq one-first-proposal (lwo-none))
                         (node_eq one-second-proposal (lwo-none))) 8 0))
    (let c5 (if (and (eq two-first-current 1)
                         (eq two-second-current 1)) 16 0))
    (let c6 (if (and (eq two-first-observation-current 1)
                         (eq two-second-observation-current 1)) 32 0))
    (let c7 (if (and (eq (lwo-field-size first-sources) 2)
                         (eq (lwo-field-has? first-sources
                              (lwrhw-source-h)) 1)) 64 0))
    (let c8 (if (and (eq (lwo-field-has? first-sources
                              (lwrhw-source-i)) 1)
                         (eq (lwo-field-has? first-sources
                              (lwcow-source-g)) 0)) 128 0))
    (let c9 (if (and (eq (lwrh-attestation-valid-shape?
                              self-attestation) 1)
                         (eq (lwrh-attestation-current?
                              self-world self-attestation) 0)) 256 0))
    (let c10 (if (node_eq (lwrh-attestation-hypothesis
                               LWRHA-ATTESTATION-FIRST)
                              (lwrhw-candidate)) 512 0))
    (let c11 (if (node_eq (lwrh-attestation-pair
                               LWRHA-ATTESTATION-FIRST)
                              (lwrhw-pair-first-cached)) 1024 0))
    (let c12 (if (and (eq (oac-one?
                               (lwrh-attestation-ack
                                 LWRHA-ATTESTATION-FIRST)) 1)
                          (node_eq (lwrh-attestation-unknown
                                     LWRHA-ATTESTATION-FIRST)
                                   (lwo-none))) 2048 0))
    (let c13 (if (and (node_eq
                               (lwrl-observation-evidence
                                 LWRHA-OBSERVATION-FIRST)
                               LWRHA-ATTESTATION-FIRST)
                          (node_eq
                               (lwrl-observation-relation
                                 LWRHA-OBSERVATION-FIRST)
                               (lwrhw-relation-zeta))) 4096 0))
    (let c14 (if (and (node_eq
                               (lwrl-observation-left
                                 LWRHA-OBSERVATION-FIRST)
                               (lwrvw-left))
                          (node_eq
                               (lwrl-observation-right
                                 LWRHA-OBSERVATION-FIRST)
                               (lwmpw-third))) 8192 0))
    (let c15 (if (and (eq (lwrl-candidate?
                               LWRHA-OBSERVATION-FIRST) 0)
                          (eq (lwo-active? world (lwrhw-candidate)) 1))
                      16384 0))
    (lwrhw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
