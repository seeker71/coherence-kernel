; closure-capture-melt-band.fk -- an escaped closure owns the value it froze.
;
; A closure instance stores its captured words outside the evaluator's value
; stack.  Those words are roots for as long as the instance can be called: a
; pair may move during an arena melt, and a dynamically-built string reachable
; through that pair may be reclaimed during the string melt.  This band keeps
; only the closure value, drops the factory frame, churns 64,000 temporary
; pairs (enough for several melts from the 4,096-pair birth arena), and then
; asks the closure for its captured structure.
;
; The pressure is part of the proof.  ccm-c40 creates forty pairs per call and
; ccm-churn checks their lengths before dropping them.  A run with
; FK_MELT_WITNESS=1 in fkwu.conf witnesses the exact melt count; bit 16 keeps a
; future edit from shrinking the pressure away while leaving the value checks
; green.
;
; Verdict 31 when pair relocation, nested reachability, dynamic string
; reachability, independent instances, and the pressure itself all hold.
; preludes: form-stdlib/core.fk

(do
    (defn ccm-bit (ok bit) (if ok bit 0))

    (defn ccm-c40 (n)
        (cons n (cons n (cons n (cons n (cons n (cons n (cons n (cons n
        (cons n (cons n (cons n (cons n (cons n (cons n (cons n (cons n
        (cons n (cons n (cons n (cons n (cons n (cons n (cons n (cons n
        (cons n (cons n (cons n (cons n (cons n (cons n (cons n (cons n
        (cons n (cons n (cons n (cons n (cons n (cons n (cons n
        (cons n (list))))))))))))))))))))))))))))))))))))))))))

    (defn ccm-churn (n seen)
        (if (le n 0)
            seen
            (ccm-churn (sub n 1) (add seen (len (ccm-c40 n))))))

    (defn ccm-freeze (seed)
        (do
            (let label (str_concat "held-" (int_to_str seed)))
            (let payload (list seed (list (add seed 1) label) label))
            (defn ccm-read () payload)
            ccm-read))

    (let held (ccm-freeze 4242))
    (let other (ccm-freeze 7))
    (let pressure (ccm-churn 1600 0))
    (let got (held))
    (let got-other (other))
    (let inner (nth got 1))

    (add (ccm-bit (and (eq (len got) 3) (eq (head got) 4242)) 1)
    (add (ccm-bit (and (eq (len inner) 2) (eq (head inner) 4243)) 2)
    (add (ccm-bit (and (str_eq (nth inner 1) "held-4242")
                       (str_eq (nth got 2) "held-4242")) 4)
    (add (ccm-bit (and (eq (head got-other) 7)
                       (str_eq (nth got-other 2) "held-7")) 8)
         (ccm-bit (eq pressure 64000) 16)))))
)
