; living-world-profile-outcome-witness.fk -- native voice feedback reopens the
; exact profile, grows a successor tissue, and may later be composted.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk

(let LWPOW-SOURCE-P (bp "LWPOW-SOURCE-P"))
(let LWPOW-SOURCE-Q (bp "LWPOW-SOURCE-Q"))
(let LWPOW-SOURCE-R (bp "LWPOW-SOURCE-R"))
(let LWPOW-SOURCE-S (bp "LWPOW-SOURCE-S"))
(let LWPOW-EVIDENCE (bp "LWPOW-EVIDENCE"))
(let LWPOW-REASON   (bp "LWPOW-REASON"))
(let LWPOW-RESULT   (bp "LWPOW-RESULT"))

(defn lwpow-cell (kind) (intern_node kind (empty)))
(defn lwpow-source-p () (lwpow-cell LWPOW-SOURCE-P))
(defn lwpow-source-q () (lwpow-cell LWPOW-SOURCE-Q))
(defn lwpow-source-r () (lwpow-cell LWPOW-SOURCE-R))
(defn lwpow-source-s () (lwpow-cell LWPOW-SOURCE-S))
(defn lwpow-evidence () (lwpow-cell LWPOW-EVIDENCE))
(defn lwpow-reason () (lwpow-cell LWPOW-REASON))

(defn lwpow-entry (source payload)
    (lwphw-entry source (lwpow-evidence) payload))
(defn lwpow-offer-two (world payload first second)
    (lwt-receive-stream world
        (list (lwpow-entry first payload)
              (lwpow-entry second payload))))

(defn lwpow-response-entries (items proposal entries)
    (if (eq (len items) 0) entries
        (lwpow-response-entries (tail items) proposal
            (cons
                (lwpow-entry (head items)
                    (lwt-response proposal (oac-one proposal)
                        (lwpow-evidence)))
                entries))))
(defn lwpow-respond-all (world proposal)
    (lwt-receive-stream world
        (lwpow-response-entries
            (lwo-field-items (lwt-proposal-participants proposal))
            proposal (empty))))
(defn lwpow-round-for (world proposal prior)
    (lwt-round world (lwo-field (list proposal))
        (lwo-empty-field) prior))

(defn lwpow-expected (answer)
    (oac-payload (lwepv-answer-immediate answer)))
(defn lwpow-correction-value (answer)
    (intern_trivial_int (add (node_value (lwpow-expected answer)) 1)))
(defn lwpow-alternative-value (answer)
    (intern_trivial_int (add (node_value (lwpow-expected answer)) 2)))

(defn lwpow-declaration (answer)
    (do
        (let default-lens
            (lwlc-lens (lwlc-blueprint-shape) answer (lwpow-evidence)))
        (let additional-lens
            (lwlc-lens (lwlc-cell-shape)
                (lwpow-correction-value answer) (lwpow-evidence)))
        (lwlc-declaration answer
            (lwlc-stack default-lens (lwlc-layers (list additional-lens))
                (lwo-empty-field) (lwlc-unknown (lwpow-evidence))
                (lwpow-evidence))
            (lwpow-evidence))))

(defn lwpow-confirmation (answer)
    (lwpo-outcome answer (lwpow-expected answer)
        (oac-one (lwpow-expected answer)) (lwo-none)
        (lwo-empty-field) (lwo-none) (lwo-none)
        (intern_trivial_int 0) (lwpow-evidence)))
(defn lwpow-correction (answer declaration)
    (lwpo-outcome answer (lwpow-correction-value answer) (oac-zero)
        declaration
        (lwo-field (list (lwpow-correction-value answer)))
        (lwlc-unknown (lwpow-evidence)) (lwo-none)
        (intern_trivial_int 0) (lwpow-evidence)))
(defn lwpow-alternative (answer)
    (lwpo-outcome answer (lwpow-alternative-value answer)
        (oac-alternative-ack answer (lwpow-alternative-value answer)
            (lwpow-evidence))
        (lwo-none) (lwo-field (list (lwpow-alternative-value answer)))
        (lwlc-unknown (lwpow-evidence)) (lwo-none)
        (intern_trivial_int 0) (lwpow-evidence)))
(defn lwpow-timed-silence (answer)
    (lwpo-outcome answer (lwo-none) (oac-nothing) (lwo-none)
        (lwo-field (list (lwpow-alternative-value answer)))
        (lwlc-unknown (lwpow-evidence))
        (oac-timeout (intern_trivial_int 10)
            (oac-alternative-ack answer (lwpow-alternative-value answer)
                (lwpow-evidence))
            (lwpow-evidence))
        (intern_trivial_int 10) (lwpow-evidence)))

(defn lwpow-offer-outcomes
    (world declaration confirmation correction alternative silence)
    (lwt-receive-stream world
        (list
            (lwpow-entry (lwpow-source-p) declaration)
            (lwpow-entry (lwpow-source-q) declaration)
            (lwpow-entry (lwpow-source-p) confirmation)
            (lwpow-entry (lwpow-source-q) confirmation)
            (lwpow-entry (lwpow-source-p) correction)
            (lwpow-entry (lwpow-source-q) correction)
            (lwpow-entry (lwpow-source-p) alternative)
            (lwpow-entry (lwpow-source-q) alternative)
            (lwpow-entry (lwpow-source-p) silence)
            (lwpow-entry (lwpow-source-q) silence))))

(defn lwpow-find-derivation (items kind)
    (if (eq (len items) 0) (lwo-none)
        (if (node_eq (lwpo-derivation-kind (head items)) kind)
            (head items) (lwpow-find-derivation (tail items) kind))))

(defn lwpow-release-entries (items entries)
    (if (eq (len items) 0) entries
        (do
            (let attribution (head items))
            (let payload (lwo-attribution-payload attribution))
            (let source (lwo-attribution-source attribution))
            (let provenance (nth (node_children attribution) 2))
            (lwpow-release-entries (tail items)
                (cons
                    (lwphw-entry source provenance
                        (lwo-revocation payload source
                            (lwpow-reason) provenance))
                    entries)))))
(defn lwpow-release-containing (world target)
    (lwt-receive-stream world
        (lwpow-release-entries
            (lwo-field-items
                (lwc-attributions-containing world target))
            (empty))))

(defn lwpow-result
    (profile-result answer declaration confirmation correction alternative
     silence outcome-world proposal candidate waiting admitted probes
     correction-probe placement-candidate placement-world prior-tissue
     tissue-proposal successor-tissue tissue-world released-world
     compost-proposal compost-transition events)
    (intern_node LWPOW-RESULT
        (list profile-result answer declaration confirmation correction
              alternative silence outcome-world proposal candidate waiting
              admitted probes correction-probe placement-candidate
              placement-world prior-tissue tissue-proposal successor-tissue
              tissue-world released-world compost-proposal compost-transition
              events)))

(defn lwpow-run ()
    (do
        (let profile-result (lwrpv-run))
        (let base-world (nth (node_children profile-result) 1))
        (let answer (nth (node_children profile-result) 4))
        (let declaration (lwpow-declaration answer))
        (let confirmation (lwpow-confirmation answer))
        (let correction (lwpow-correction answer declaration))
        (let alternative (lwpow-alternative answer))
        (let silence (lwpow-timed-silence answer))
        (let started
            (lcfb-open-stream "living-world-profile-outcome-witness"
                "form-native" "lwpow-run"
                "native-answer-to-successor-tissue-and-compost"
                "form/form-stdlib/tests/living-world-profile-outcome-witness.fk"
                170 14))
        (let outcome-world
            (lwpow-offer-outcomes base-world declaration confirmation
                correction alternative silence))
        (let proposal
            (lwpo-proposal-for-observed outcome-world answer started 1))
        (let candidate (lwt-proposal-candidate proposal))
        (let waiting
            (lwpo-integrate
                (lwpow-round-for outcome-world proposal (lwo-none))
                proposal (lwphw-action)))
        (let responded-world (lwpow-respond-all outcome-world proposal))
        (let admitted
            (lwpo-integrate
                (lwpow-round-for responded-world proposal waiting)
                proposal (lwphw-action)))
        (let admitted-world (lwt-round-world admitted))
        (let admitted-frame
            (lcfb-call-stream "living-world-profile-outcome-witness"
                "cycle" "leave" "form-native" "lwpo-integrate"
                "plural-cycle-current:1:no-auto-probe" 4 started
                "form/form-stdlib/tests/living-world-profile-outcome-witness.fk"
                194 14))
        (let probes (lwpo-probe-successors admitted-world candidate))
        (let correction-derivation
            (lwpow-find-derivation
                (lwo-field-items
                    (lwpo-cycle-derivations
                        (lwo-emergent-shape candidate)))
                (lwpo-correction)))
        (let correction-probe
            (lwpo-derivation-probe correction-derivation))
        (let probe-frame
            (lcfb-call-stream "living-world-profile-outcome-witness"
                "probes" "leave" "form-native" "lwpo-probe-successors"
                "derivations:4:probes:4:correction-selected-by-kind" 5 started
                "form/form-stdlib/tests/living-world-profile-outcome-witness.fk"
                211 14))

        ; A described correction cannot move tissue until independently offered,
        ; proposed, unanimously acknowledged, and integrated as a placement.
        (let probe-world
            (lwpow-offer-two admitted-world correction-probe
                (lwpow-source-r) (lwpow-source-s)))
        (let placement-proposal
            (lwph-probe-proposal probe-world correction-probe 2))
        (let placement-responded
            (lwpow-respond-all probe-world placement-proposal))
        (let placement-round
            (lwph-probe-integrate
                (lwpow-round-for placement-responded placement-proposal
                    admitted)
                placement-proposal (lwphw-action)))
        (let placement-world (lwt-round-world placement-round))
        (let placement-candidate
            (lwt-proposal-candidate placement-proposal))
        (let placement
            (lwo-emergent-shape placement-candidate))
        (let placement-frame
            (lcfb-call-stream "living-world-profile-outcome-witness"
                "placement" "leave" "form-native"
                "lwph-probe-integrate"
                "correction:confirmed:0:diverged:4:integrated:1" 6 started
                "form/form-stdlib/tests/living-world-profile-outcome-witness.fk"
                236 14))

        (let prior-tissue
            (lwhe-space-candidate
                (lwhe-enquiry-space
                    (lwep-class-enquiry
                        (lwepv-request-class
                            (lwepv-answer-request answer))))))
        (let field-candidate (lwht-tissue-field
                                (lwo-emergent-shape prior-tissue)))
        (let tissue-proposal
            (lwht-proposal placement-world field-candidate 2))
        (let tissue-responded
            (lwpow-respond-all placement-world tissue-proposal))
        (let tissue-round
            (lwht-integrate
                (lwpow-round-for tissue-responded tissue-proposal
                    placement-round)
                tissue-proposal (lwphw-action)))
        (let tissue-world (lwt-round-world tissue-round))
        (let successor-tissue (lwt-proposal-candidate tissue-proposal))
        (let tissue-frame
            (lcfb-call-stream "living-world-profile-outcome-witness"
                "tissue" "leave" "form-native" "lwht-integrate"
                "prior-current:0:successor-current:1:compatible:0:contradicted:4"
                7 started
                "form/form-stdlib/tests/living-world-profile-outcome-witness.fk"
                264 14))

        ; Re-hold the exact timed-silence identity in a narrow two-holder root.
        ; Compost proves release of that exact root; it does not pretend to
        ; remove the same cell from the still-live tissue world.  Global reverse
        ; dependency indexing remains separate work.
        (let compost-root
            (lwpow-offer-two (lwo-empty-world) silence
                (lwpow-source-p) (lwpow-source-q)))
        (let released-world
            (lwpow-release-containing compost-root silence))
        (let release-frame
            (lcfb-call-stream "living-world-profile-outcome-witness"
                "release" "leave" "form-native"
                "lwpow-release-containing"
                "exact-root-inactive:1:live-tissue-unchanged:1" 8 started
                "form/form-stdlib/tests/living-world-profile-outcome-witness.fk"
                276 14))
        (let compost-proposal
            (lwc-compost-proposal released-world silence))
        (let compost-responded
            (lwpow-respond-all released-world compost-proposal))
        (let compost-transition
            (lwc-integrate compost-responded compost-proposal))
        (let compost-frame
            (lcfb-call-stream "living-world-profile-outcome-witness"
                "compost" "leave" "form-native" "lwc-integrate"
                "target-absent:1:prior-recoverable:1:no-overwrite" 9 started
                "form/form-stdlib/tests/living-world-profile-outcome-witness.fk"
                289 14))
        (let events (framebuffer-events))
        (lwpow-result profile-result answer declaration confirmation correction
            alternative silence outcome-world proposal candidate waiting
            admitted probes correction-probe placement-candidate placement-world
            prior-tissue tissue-proposal successor-tissue tissue-world
            released-world compost-proposal compost-transition events)))

0
