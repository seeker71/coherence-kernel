; Native buffered renderer: unchanged=0 bytes, changed segment only, no
; intermediate clear/scroll, synchronized batch, correlated physical commit.
; Expected: 4095. Only a bounded terminal frame is written, no live state.
; preludes: form-stdlib/form-glass-live.bml observe/bidirectional-framebuffer-channel.fk
(do
    (defn fgrbb-has (text needle) (ge (str_find text needle 0) 0))
    (defn fgrbb-text (bytes) (ftc-text-as-string (ftc-byte-text bytes)))
    (defn fgrbb-bits (rows weight) (if (eq (len rows) 0) 0 (add (if (head rows) weight 0) (fgrbb-bits (tail rows) (mul weight 2)))))
    (let style (fgd-title))
    (let fixed (ftc-segment "FIXED " style "none" "fixed" (list) "physical-live"))
    (let a (ftc-segment "1" style "none" "value" (list) "physical-live"))
    (let b (ftc-segment "2" style "none" "value" (list) "physical-live"))
    (let old (list (list fixed a)))
    (let next (list (list fixed b)))
    (let patch (ftcb-screen-diff old next))
    (let text (fgrbb-text patch))
    (let full (fgrbb-text (ftcb-screen-frame next)))
    (let framed (fgrbb-text (ftcb-display-patch patch)))
    (let removed (fgrbb-text (ftcb-screen-diff old (list))))
    (let before (fgel-buffer-empty))
    (let frame (fgd-segment-frame 20 8 1 "jit" (list) (list) (list) "render-band"))
    (let planned (fgel-buffer-commit (fgel-buffer-stage before frame)))
    ; Send only counters and control symbols; no conversational content.
    (let outbound (bfc-envelope 0 20260907 0 (list 1 0) 0))
    (let recorded (bfc-record-out outbound 0))
    (let inbound (bfc-control outbound 0))
    (let received (bfc-record-in inbound 1))
    (let chosen (bfc-apply outbound inbound planned before))
    (let writeResult (fgl-render-frame (fgel-buffer-front before) (fgel-buffer-front chosen)))
    (let committed (fgl-render-commit writeResult before chosen))
    (let observed (bfc-envelope 0 20260908 0 (list writeResult (fgel-buffer-presented committed)) 0))
    (let reobserved (bfc-record-out observed 2))
    (fgrbb-bits (list
        (eq (len (ftcb-screen-diff old old)) 0)
        (eq (len (ftcb-display-patch (list))) 0)
        (not (fgrbb-has text "FIXED"))
        (and (fgrbb-has text (tg-cursor-to 6 0)) (fgrbb-has text "2"))
        (not (fgrbb-has full (byte_to_str 10)))
        (not (fgrbb-has full (tg-screen-clear)))
        (fgrbb-has removed (tg-line-erase-rest))
        (str_eq (substring framed 0 (str_len (tg-sync-begin))) (tg-sync-begin))
        (str_eq (substring framed (sub (str_len framed) (str_len (tg-sync-end))) (str_len framed)) (tg-sync-end))
        (and (fgrbb-has framed (tg-cursor-hide)) (fgrbb-has framed (tg-cursor-show)))
        (eq (fgel-buffer-presented (fgl-render-commit -1 before planned)) 0)
        (and (ge writeResult 0) (eq (fgel-buffer-presented committed) 1))) 1))
