; Pure workflow replay; no model, disk writes or model claims. Expected 65535.
; preludes: form-stdlib/bml/form-cli-code-policy.bml
(do
 (defn fcapb-check (expected docs)
  (list (str_eq (nth (fat-find-doc docs "config.json") 2) expected) "config verification"))
 (defn fcapb-bit (ok bit) (if ok bit 0))
 (defn fcapb-assert (name ok) (if ok 1 (form_error (str_concat "review boundary: " name))))
 (defn fcapb-report-check (expected subject) (list (str_eq expected (nth subject 1)) "report verification"))
 (defn fcapb-bomb (contract subject) (form_error "model parameters reached caller verification"))
 (let docs (list (list "config" "config.json" "{\"enabled\":false}") (list "checks" "checks.txt" "immutable")))
 (let checker (list fcapb-check "{\"enabled\":true}"))
 (let s0 (fcap-open "Enable local coding" docs (list "config.json")))
 (let bad (fcap-step s0 "not JSON" checker))
 (let denied (fcap-step s0 "{\"tool\":\"write\",\"arguments\":[\"config.json\"],\"input\":\"oops\"}" checker))
 (let s1 (fcap-step s0 "{\"brief\":\"Enable local coding; preserve checks.\"}" checker))
 (let s2 (fcap-step s1 "{\"plan\":\"Read config; change flag; verify boolean.\"}" checker))
 (let s3 (fcap-step s2 "{\"tasks\":[\"Change enabled flag\",\"Inspect config\"]}" checker))
 (let outside (fcap-step s3 "{\"tool\":\"write\",\"arguments\":[\"checks.txt\"],\"input\":\"changed\"}" checker))
 (let remote (fcap-step s3 "{\"tool\":\"curl\",\"arguments\":[\"localhost\"]}" checker))
 (let s4 (fcap-step s3 "{\"tool\":\"edit\",\"arguments\":[\"config.json\",\"false\",\"true\"]}" checker))
 (let s5 (fcap-step s4 "{\"task\":\"done\"}" checker))
 (let s6 (fcap-step s5 "{\"tool\":\"jq\",\"arguments\":[\".enabled\",\"config.json\"]}" checker))
 (let s7 (fcap-step s6 "{\"task\":\"done\"}" checker))
 (let s8 (fcap-step s7 "{\"verdict\":\"accept\",\"reason\":\"The flag is true.\"}" checker))
 (let fail (fcap-step s7 "{\"verdict\":\"accept\"}" (list fcapb-check "wrong")))
 (let rejected (fcap-step s7 "{\"verdict\":\"reject\",\"reason\":\"Check edge case.\"}" checker))
 ; Exercise the executing review boundaries without teaching a model this fixture.
 (let review (fcap-note-at (fcap-open-review "Inspect; do not edit" docs) "review" "inspection complete"))
 (let reportChecker (list fcapb-report-check "finding" fcapb-check "{\"enabled\":false}"))
 (let verified (fcap-step review "{\"tool\":\"verify\",\"arguments\":[]}" reportChecker))
 (let reportDone (fcap-step verified "{\"verdict\":\"accept\",\"report\":\"finding\"}" reportChecker))
 (fcapb-assert "unchanged sources and report are distinct results" (and (str_eq (fcap-stage reportDone) "complete") (and (value_eq (fcap-docs reportDone) docs) (str_eq (fcap-report reportDone) "finding"))))
 (fcapb-assert "verify and submission both count" (and (eq (fcap-checks reportDone) 2) (eq (fcap-calls reportDone) 1)))
 (fcapb-assert "empty report cannot complete" (not (fcap-done (fcap-step review "{\"verdict\":\"accept\",\"report\":\" \"}" reportChecker))))
 (let wrongReport (fcap-step review "{\"verdict\":\"accept\",\"report\":\"wrong\"}" reportChecker))
 (let repairedReport (fcap-step wrongReport "{\"diagnosis\":\"report check failed\",\"change\":\"reinspect source\",\"next\":\"plan\"}" reportChecker))
 (fcapb-assert "repair retains report and read-only mode" (and (str_eq (fcap-stage repairedReport) "plan") (and (fcap-reviewing repairedReport) (str_eq (fcap-report repairedReport) "wrong"))))
 (let reviewWithWritable (fcap-inherit review (fcap-open "Inspect; do not edit" docs (list "config.json"))))
 (let reviewEdit (fcap-step (fcap-note-at reviewWithWritable "implement" "inspect") "{\"mode\":\"code\",\"tool\":\"write\",\"arguments\":[\"config.json\"],\"input\":\"changed\"}" reportChecker))
 (fcapb-assert "caller review mode dominates write list and model mode" (and (value_eq (fcap-docs reviewEdit) docs) (eq (fcap-calls reviewEdit) 0)))
 (let badVerify (fcap-step review "{\"tool\":\"verify\",\"arguments\":[\"command\"]}" (list fcapb-bomb "" fcapb-bomb "")))
 (let badInput (fcap-step review "{\"tool\":\"verify\",\"arguments\":[],\"input\":\"command\"}" (list fcapb-bomb "" fcapb-bomb "")))
 (fcapb-assert "verify cannot receive model code" (and (eq (fcap-calls badVerify) 0) (eq (fcap-calls badInput) 0)))
 (let malformed (fcap-verify-observed review (list 1 99)))
 (fcapb-assert "malformed checker cannot complete and is counted" (and (str_eq (fcap-stage malformed) "attention") (eq (fcap-checks malformed) 1)))
 (let verifyTwice (fcap-step verified "{\"tool\":\"verify\",\"arguments\":[]}" reportChecker))
 (let verifyThrice (fcap-step verifyTwice "{\"tool\":\"verify\",\"arguments\":[]}" reportChecker))
 (fcapb-assert "repeated checks request replanning" (and (str_eq (fcap-stage verifyThrice) "repair") (and (eq (fcap-repeat verifyThrice) 1) (eq (fcap-checks verifyThrice) 3))))
 (fcapb-assert "code still needs a document change" (str_eq (fcap-stage (fcap-step (fcap-note-at s0 "review" "unchanged") "{\"verdict\":\"accept\"}" checker)) "repair"))
 (sum (list
  (fcapb-bit (str_eq (fcap-stage s1) "plan") 1)
  (fcapb-bit (str_eq (fcap-stage s2) "split") 2)
  (fcapb-bit (and (str_eq (fcap-stage s3) "implement") (eq (len (nth s3 5)) 2)) 4)
  (fcapb-bit (str_eq (fcap-stage bad) "refine") 8)
  (fcapb-bit (value_eq (fcap-docs denied) docs) 16)
  (fcapb-bit (value_eq (fcap-docs outside) docs) 32)
  (fcapb-bit (and (value_eq (fcap-docs remote) docs) (eq (fcap-calls remote) 0)) 64)
  (fcapb-bit (str_eq (nth (fat-find-doc (fcap-docs s4) "config.json") 2) "{\"enabled\":true}") 128)
  (fcapb-bit (and (eq (len (nth s5 5)) 1) (eq (nth s5 11) 1)) 256)
  (fcapb-bit (and (eq (fcap-calls s6) 2) (ge (str_find (fcap-note s6) "true" 0) 0)) 512)
  (fcapb-bit (str_eq (fcap-stage s7) "review") 1024)
  (fcapb-bit (and (str_eq (fcap-stage s8) "complete") (eq (nth s8 11) 2)) 2048)
  (fcapb-bit (and (str_eq (fcap-stage fail) "repair") (eq (len (nth fail 5)) 1)) 4096)
  (fcapb-bit (str_eq (fcap-stage rejected) "repair") 8192)
  (fcapb-bit (value_eq (fcap-step s8 "invalid" checker) s8) 16384)
  (fcapb-bit (value_eq (fat-find-doc (fcap-docs s8) "checks.txt") (nth docs 1)) 32768))))
