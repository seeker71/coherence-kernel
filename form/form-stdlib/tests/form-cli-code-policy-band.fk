; Pure workflow replay; no model, disk writes or model claims. Expected 65535.
; preludes: form-stdlib/bml/form-cli-code-policy.bml
(do
 (defn fcapb-check (expected docs)
  (list (str_eq (nth (fat-find-doc docs "config.json") 2) expected) "config verification"))
 (defn fcapb-bit (ok bit) (if ok bit 0))
 (defn fcapb-assert (name ok) (if ok 1 (form_error (str_concat "review boundary: " name))))
 (defn fcapb-report-check (expected subject) (list (str_eq expected (nth subject 1)) "report verification"))
 (defn fcapb-bomb (contract subject) (form_error "model parameters reached caller verification"))
 (defn fcapb-malformed-check (contract subject) (list 1 99))
 (defn fcapb-hash-command (path digest text)
  (json-emit (json-node-object (list (json-node-pair "tool" (json-node-string "edit"))
   (json-node-pair "arguments" (json-node-array (fcap-string-json (list path "sha256" digest text))))))))
 (defn fcapb-context-lines (n) (if (le n 0) "" (str_concat "A native source line already present in the admitted context.\n" (fcapb-context-lines (sub n 1)))))
 (defn fcapb-splices (cases) (if (nil? cases) 1 (do
  (let before (split-on (head (head cases)) "\n"))
  (let after (nth (head cases) 1))
  (fcapb-assert "splice reconstructs exact insertion deletion newline unicode and separated changes" (str_eq (fcap-read-rebuild before (fcap-read-splice before (split-on after "\n"))) after))
  (fcapb-splices (tail cases)))))
 (let docs (list (list "config" "config.json" "{\"enabled\":false}") (list "checks" "checks.txt" "immutable")))
 (let checker (list fcapb-check "{\"enabled\":true}"))
 (let s0 (fcap-open "Enable local coding" docs (list "config.json")))
 (let directCode (fcap-open-direct-code "Enable local coding" docs (list "config.json")))
 (let noEdit (fcap-step directCode "{\"tool\":\"edit\",\"arguments\":[\"config.json\",\"false\",\"false\"]}" checker))
 (fcapb-assert "identical replacement immediately enters repair with unchanged source" (and (str_eq (fcap-stage noEdit) "repair") (and (value_eq (fcap-docs noEdit) docs) (ge (str_find (fcap-evidence noEdit) "edit-unchanged" 0) 0))))
 (fcapb-assert "unchanged edit counts one actual tool call and no verification" (and (eq (fcap-calls noEdit) 1) (eq (fcap-checks noEdit) 0)))
 (fcapb-assert "identical missing pattern retains missing evidence" (str_eq (fat-error (fat-call docs "edit" (list "config.json" "missing" "missing") "")) "edit-not-found"))
 (fcapb-assert "identical ambiguous pattern retains ambiguity evidence" (str_eq (fat-error (fat-call (list (list "repeated" "same.txt" "aa")) "edit" (list "same.txt" "a" "a") "")) "edit-ambiguous"))
 (let missingArgs (list "config.json" "{\"enabled\": false}" "replacement"))
 (let missingResult (fat-call docs "edit" missingArgs ""))
 (let missingNote (parse-json "guard" (fcap-tool-note directCode "edit" missingArgs missingResult)))
 (let guard (json-object-get missingNote "guard_evidence"))
 (let comparison (json-object-get guard "whole_document_comparison"))
 (fcapb-assert "guard reports actual unchanged resident bytes and zero matches" (and (eq (node_value (json-object-get guard "documents_changed")) 0) (and (eq (node_value (json-object-get guard "exact_matches")) 0) (value_eq (fat-documents missingResult) docs))))
 (fcapb-assert "guard locates the supplied whitespace mismatch without applying it" (and (eq (node_value (json-object-get comparison "first_difference_byte")) 11) (and (eq (node_value (json-object-get comparison "old_byte")) 32) (eq (node_value (json-object-get comparison "resident_byte")) 102))))
 (let guardContext (fcap-begin-context directCode))
 (let failedGuard (fcap-tool-observed guardContext "edit" missingArgs "" missingResult))
 (let correctiveRead (fcap-tool-note failedGuard "read" (list "config.json") (fat-call docs "read" (list "config.json") "")))
 (fcapb-assert "read after guarded edit failure supplies actual source despite admitted context" (and (ge (str_find correctiveRead "enabled" 0) 0) (lt (str_find correctiveRead "stdout_reference" 0) 0)))
 (fcapb-assert "unrelated read keeps its existing context reference" (ge (str_find (fcap-tool-note failedGuard "read" (list "checks.txt") (fat-call docs "read" (list "checks.txt") "")) "stdout_reference" 0) 0))
 (let overwriteNote (parse-json "guard" (fcap-tool-note directCode "write" (list "config.json") (fat-call docs "write" (list "config.json") "replacement"))))
 (fcapb-assert "overwrite refusal supplies the actual create-only contract" (and (str_eq (fcap-string overwriteNote "stderr") "document-exists-use-guarded-edit") (ge (str_find (fcap-string (json-object-get overwriteNote "guard_evidence") "next") "cannot overwrite" 0) 0)))
 (let hashRead (parse-json "hash-read" (fcap-tool-note guardContext "read" (list "config.json") (fat-call docs "read" (list "config.json") ""))))
 (let observedHash (fcap-string hashRead "resident_sha256"))
 (fcapb-assert "a compact read supplies a canonical current identity" (and (json-object-has? hashRead "stdout_reference") (fat-sha? observedHash)))
 (let hashCommand (fcapb-hash-command "config.json" observedHash "{\"enabled\":true}"))
 (let hashEdited (fcap-step directCode hashCommand checker))
 (let changedDoc (fat-find-doc (fcap-docs hashEdited) "config.json"))
 (let changedHash (fat-document-sha changedDoc))
 (let mutationNote (parse-json "mutation" (fcap-note hashEdited)))
 (fcapb-assert "successful edit returns the accepted current identity and prior identity" (and (str_eq (fcap-string mutationNote "resident_sha256") changedHash) (and (str_eq (fcap-string mutationNote "before_sha256") observedHash) (not (str_eq changedHash observedHash)))))
 (fcapb-assert "mutation acknowledgement retains output without inventing verification" (and (str_eq (fcap-string mutationNote "stdout") "edited\n") (and (eq (node_value (json-object-get mutationNote "documents_changed")) 1) (eq (fcap-checks hashEdited) 0))))
 (let renewed (fcap-begin-context hashEdited))
 (let currentModelDocs (fcap-model-documents (fcap-docs renewed)))
 (fcapb-assert "renewal binds the current text and identity in one model document" (and (str_eq (fcap-string (head currentModelDocs) "text") (nth changedDoc 2)) (str_eq (fcap-string (head currentModelDocs) "resident_sha256") changedHash)))
 (fcapb-assert "full bootstrap supplies those current document objects" (ge (str_find (fcap-bootstrap renewed) (json-emit (json-node-array currentModelDocs)) 0) 0))
 (let currentCatalog (fcap-document-catalog (fcap-docs renewed)))
 (fcapb-assert "catalog supplies current identity without disclosing document text" (and (str_eq (fcap-string (head currentCatalog) "resident_sha256") changedHash) (not (json-object-has? (head currentCatalog) "text"))))
 (let nextHashCommand (fcapb-hash-command "config.json" (fcap-string mutationNote "resident_sha256") "{\"enabled\":true,\"version\":2}"))
 (let nextHashEdit (fcap-step renewed nextHashCommand checker))
 (fcapb-assert "acknowledged identity enables the next guarded edit without a read" (and (str_eq (nth (fat-find-doc (fcap-docs nextHashEdit) "config.json") 2) "{\"enabled\":true,\"version\":2}") (eq (fcap-calls nextHashEdit) 2)))
 (let staleAction (fcap-step renewed hashCommand checker))
 (fcapb-assert "an old identity still refuses mutation after renewal" (and (value_eq (fcap-docs staleAction) (fcap-docs renewed)) (ge (str_find (fcap-evidence staleAction) "edit-sha256-mismatch" 0) 0)))
 (fcapb-assert "failed tools do not emit a success identity at the top level" (not (json-object-has? (parse-json "failed-tool" (fcap-tool-note renewed "edit" (list "config.json" "sha256" observedHash "changed") (fat-call (fcap-docs renewed) "edit" (list "config.json" "sha256" observedHash "changed") ""))) "documents_changed")))
 (let createState (fcap-open-direct-code "Create one document" docs (list "new.txt")))
 (let created (fcap-step createState "{\"tool\":\"write\",\"arguments\":[\"new.txt\"],\"input\":\"new content\"}" checker))
 (let createNote (parse-json "created" (fcap-note created)))
 (fcapb-assert "creation reports a new identity and absent prior document" (and (str_eq (fcap-string createNote "resident_sha256") (fat-document-sha (fat-find-doc (fcap-docs created) "new.txt"))) (node_eq (json-object-get createNote "before_sha256") (json-node-null))))
 (let shortHashArgs (list "config.json" observedHash "{\"enabled\":true}"))
 (let shortHashCommand (json-emit (json-node-object (list (json-node-pair "tool" (json-node-string "edit")) (json-node-pair "arguments" (json-node-array (fcap-string-json shortHashArgs)))))))
 (let shortHashEdited (fcap-step directCode shortHashCommand checker))
 (fcapb-assert "three-argument current identity reaches the same guarded replacement" (value_eq (fcap-docs shortHashEdited) (fcap-docs hashEdited)))
 (let shortStale (fat-call (fcap-docs shortHashEdited) "edit" shortHashArgs ""))
 (fcapb-assert "stale shorthand has no authority over current bytes" (and (str_eq (fat-error shortStale) "edit-not-found") (value_eq (fat-documents shortStale) (fcap-docs shortHashEdited))))
 (fcapb-assert "unchanged shorthand preserves the existing diagnostic" (str_eq (fat-error (fat-call docs "edit" (list "config.json" observedHash (nth (head docs) 2)) "")) "edit-unchanged: old and new text are identical; no source changed"))
 (let literalHashDocs (list (list "literal" "hash.txt" (str_concat "before:" (str_concat observedHash ":after")))))
 (let literalHashEdit (fat-call literalHashDocs "edit" (list "hash.txt" observedHash "replacement") ""))
 (fcapb-assert "a literal hash match keeps substring replacement semantics" (str_eq (nth (head (fat-documents literalHashEdit)) 2) "before:replacement:after"))
 (let repeatedHashDocs (list (list "repeated" "hash.txt" (str_concat observedHash observedHash))))
 (fcapb-assert "multiple literal hash matches stay ambiguous" (str_eq (fat-error (fat-call repeatedHashDocs "edit" (list "hash.txt" observedHash "replacement") "")) "edit-ambiguous"))
 (let shortHashReview (fcap-step (fcap-open-direct-review "read only" docs) shortHashCommand checker))
 (fcapb-assert "shorthand preserves read-only authority" (and (eq (fcap-calls shortHashReview) 0) (value_eq (fcap-docs shortHashReview) docs)))
 (fcapb-assert "observed identity admits exact replacement with document identities preserved" (and (str_eq (nth (fat-find-doc (fcap-docs hashEdited) "config.json") 2) "{\"enabled\":true}") (and (str_eq (head (fat-find-doc (fcap-docs hashEdited) "config.json")) "config") (value_eq (fat-find-doc (fcap-docs hashEdited) "checks.txt") (nth docs 1)))))
 (let staleHash (fat-call (fcap-docs hashEdited) "edit" (list "config.json" "sha256" observedHash "stale replacement") ""))
 (fcapb-assert "a stale identity refuses every changed byte" (and (str_eq (fat-error staleHash) "edit-sha256-mismatch") (value_eq (fat-documents staleHash) (fcap-docs hashEdited))))
 (fcapb-assert "malformed hash is refused before mutation" (str_eq (fat-error (fat-call docs "edit" (list "config.json" "sha256" "wrong" "replacement") "")) "edit-invalid-sha256"))
 (let emptyDocument (list (list "blank" "blank.fk" "")))
 (let filledBlank (fat-call emptyDocument "edit" (list "blank.fk" "sha256" "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" "42") ""))
 (fcapb-assert "existing empty document is guarded by the standard empty SHA256" (and (eq (fat-exit filledBlank) 0) (str_eq (nth (fat-find-doc (fat-documents filledBlank) "blank.fk") 2) "42")))
 (let hashReadOnly (fcap-step (fcap-open-direct-review "read only" docs) hashCommand checker))
 (fcapb-assert "identity cannot grant a reviewing role write authority" (and (eq (fcap-calls hashReadOnly) 0) (value_eq (fcap-docs hashReadOnly) docs)))
 (let otherHash (fat-document-sha (nth docs 1)))
 (let hashUnwritable (fcap-step directCode (fcapb-hash-command "checks.txt" otherHash "changed") checker))
 (fcapb-assert "identity cannot grant an undeclared writable path" (and (eq (fcap-calls hashUnwritable) 0) (value_eq (fcap-docs hashUnwritable) docs)))
 (let hashReview (fcap-step hashEdited "{\"task\":\"done\"}" checker))
 (let hashRefused (fcap-step hashReview "{\"verdict\":\"accept\"}" (list fcapb-check "wrong")))
 (fcapb-assert "hash edit completion still depends on the caller's actual checks" (and (str_eq (fcap-stage hashRefused) "repair") (eq (fcap-checks hashRefused) 2)))
 (let repairStart (fcap-step directCode "{\"tool\":\"verify\",\"arguments\":[]}" checker))
 (let repairRouted (fcap-step repairStart "{\"diagnosis\":\"The actual check requires enabled=true.\",\"change\":\"Edit the current config and check it.\",\"next\":\"implement\"}" checker))
 (let repairRenewed (fcap-begin-context repairRouted))
 (fcapb-assert "a role change and renewal retain the unresolved source check" (and (fcap-source-repair-open repairRenewed) (str_eq (fcap-stage repairRenewed) "implement")))
 (let routedApplied (fcap-step repairRenewed hashCommand checker))
 (fcapb-assert "a routed repair edit immediately checks its candidate and closes the source failure" (and (eq (fcap-checks routedApplied) 2) (and (not (fcap-source-repair-open routedApplied)) (not (fcap-done routedApplied)))))
 (fcapb-assert "a routed repair keeps its model diagnosis and one actual reply" (and (value_eq (fcap-reflections routedApplied) (fcap-reflections repairRenewed)) (eq (fcap-turns routedApplied) (add (fcap-turns repairRenewed) 1))))
 (let routedFailed (fcap-step repairRenewed (fcapb-hash-command "config.json" observedHash "{\"enabled\":null}") checker))
 (fcapb-assert "a routed repair that still fails remains open with fresh evidence" (and (fcap-source-repair-open routedFailed) (and (eq (fcap-checks routedFailed) 2) (str_eq (fcap-stage routedFailed) "repair"))))
 (let routedStale (fcap-step repairRenewed (fcapb-hash-command "config.json" otherHash "changed") (list fcapb-bomb "")))
 (fcapb-assert "a failed tool preserves the open source failure without another check" (and (fcap-source-repair-open routedStale) (eq (fcap-checks routedStale) 1)))
 (let repairPlanned (fcap-step repairStart "{\"diagnosis\":\"The current config fails.\",\"change\":\"Plan the correction.\",\"next\":\"plan\"}" checker))
 (fcapb-assert "planning retains the source failure and permits no edit" (and (fcap-source-repair-open repairPlanned) (not (fcap-tool-allowed repairPlanned "edit" (list "config.json")))))
 (let repairApplied (fcap-step repairStart hashCommand checker))
 (fcapb-assert "repair applies an authorized guarded edit and immediately checks it" (and (value_eq (fcap-docs repairApplied) (fcap-docs hashEdited)) (and (eq (fcap-checks repairApplied) 2) (eq (fcap-calls repairApplied) 3))))
 (fcapb-assert "repair edit uses one model transition and still awaits completion and review" (and (eq (fcap-turns repairApplied) (add (fcap-turns repairStart) 1)) (and (str_eq (fcap-stage repairApplied) "implement") (not (fcap-done repairApplied)))))
 (let repairRecord (head (fcap-reflections repairApplied)))
 (fcapb-assert "repair record retains actual failure and attributes controller observation" (and (str_eq (nth repairRecord 1) (fcap-evidence repairStart)) (and (ge (str_find (nth repairRecord 2) "no model diagnosis" 0) 0) (ge (str_find (nth repairRecord 3) "edit config.json" 0) 0))))
 (let repairFailed (fcap-step repairStart (fcapb-hash-command "config.json" observedHash "{\"enabled\":null}") checker))
 (fcapb-assert "failed repair retains changed candidate and repeated caller counterexample" (and (str_eq (fcap-stage repairFailed) "repair") (and (eq (fcap-checks repairFailed) 2) (and (fcap-repeat repairFailed) (str_eq (nth (head (fcap-docs repairFailed)) 2) "{\"enabled\":null}")))))
 (let repeatCommand (fcapb-hash-command "config.json" (fat-document-sha (head (fcap-docs repairFailed))) "{\"enabled\":true}"))
 (let repeatDenied (fcap-step repairFailed repeatCommand (list fcapb-bomb "")))
 (fcapb-assert "direct repair cannot bypass required replanning" (and (value_eq (fcap-docs repeatDenied) (fcap-docs repairFailed)) (eq (fcap-calls repeatDenied) (fcap-calls repairFailed))))
 (let repairStale (fcap-step repairStart (fcapb-hash-command "config.json" otherHash "changed") (list fcapb-bomb "")))
 (fcapb-assert "stale repair guard retains source without invoking checks" (and (value_eq (fcap-docs repairStale) docs) (and (str_eq (fcap-stage repairStale) "repair") (eq (fcap-checks repairStale) 1))))
 (let repairUnchanged (fcap-step repairStart (fcapb-hash-command "config.json" observedHash (nth (head docs) 2)) (list fcapb-bomb "")))
 (fcapb-assert "unchanged repair remains a failed tool and never advances" (and (value_eq (fcap-docs repairUnchanged) docs) (and (str_eq (fcap-stage repairUnchanged) "repair") (eq (fcap-checks repairUnchanged) 1))))
 (let repairUnwritable (fcap-step repairStart (fcapb-hash-command "checks.txt" otherHash "changed") (list fcapb-bomb "")))
 (fcapb-assert "repair cannot edit outside caller authority" (and (value_eq (fcap-docs repairUnwritable) docs) (eq (fcap-calls repairUnwritable) 1)))
 (fcapb-assert "repair permission leaves planning and review read-only" (and (not (fcap-tool-allowed s0 "edit" (list "config.json"))) (not (fcap-tool-allowed (fcap-note-at s0 "plan" "plan") "edit" (list "config.json")))))
 (fcapb-assert "direct coding holds the original goal without invented planning history" (and (str_eq (fcap-stage directCode) "implement") (and (str_eq (nth directCode 1) "Enable local coding") (and (eq (len (nth directCode 5)) 1) (and (str_eq (nth directCode 6) "") (and (str_eq (nth directCode 7) "") (eq (fcap-turns directCode) 0)))))))
 (fcapb-assert "direct goal is admitted once and referenced by later observations" (and (ge (str_find (fcap-bootstrap directCode) "Enable local coding" 0) 0) (and (lt (str_find (fcap-observation directCode) "Enable local coding" 0) 0) (ge (str_find (fcap-observation directCode) (fcap-direct-task) 0) 0))))
 (fcapb-assert "direct coding cannot accept before implementation and review" (not (fcap-done (fcap-step directCode "{\"verdict\":\"accept\"}" checker))))
 (let directUnchanged (fcap-step directCode "{\"task\":\"done\"}" checker))
 (fcapb-assert "direct coding rejects an unchanged candidate" (str_eq (fcap-stage (fcap-step directUnchanged "{\"verdict\":\"accept\"}" checker)) "repair"))
 (let directEdited (fcap-step directCode "{\"tool\":\"edit\",\"arguments\":[\"config.json\",\"false\",\"true\"]}" checker))
 (let directReview (fcap-step directEdited "{\"task\":\"done\"}" checker))
 (fcapb-assert "last coding task supplies a current check without another model reply or tool" (and (eq (fcap-checks directReview) 1) (and (eq (fcap-turns directReview) (add (fcap-turns directEdited) 1)) (eq (fcap-calls directReview) (fcap-calls directEdited)))))
 (fcapb-assert "review sees the exact checked source identity" (ge (str_find (fcap-note directReview) (fat-document-sha (head (fcap-docs directReview))) 0) 0))
 (let boundaryFailure (fcap-step directEdited "{\"task\":\"done\"}" (list fcapb-check "wrong")))
 (fcapb-assert "current failure enters repair before review" (and (str_eq (fcap-stage boundaryFailure) "repair") (and (eq (fcap-checks boundaryFailure) 1) (value_eq (fcap-docs boundaryFailure) (fcap-docs directEdited)))))
 (fcapb-assert "failed completion preserves a repair task and its actual evidence" (and (not (nil? (nth boundaryFailure 5))) (str_eq (fcap-evidence boundaryFailure) (fcap-note boundaryFailure))))
 (let malformedBoundary (fcap-step directEdited "{\"task\":\"done\"}" (list fcapb-malformed-check "")))
 (fcapb-assert "malformed boundary checker is counted and cannot pass" (and (str_eq (fcap-stage malformedBoundary) "attention") (eq (fcap-checks malformedBoundary) 1)))
 (let inspectionTask (fcap-split-tasks (fcap-open-review "inspect" docs) (list "Inspect caller source")))
 (let inspectionReady (fcap-step inspectionTask "{\"task\":\"done\"}" (list fcapb-bomb "")))
 (fcapb-assert "read-only inspection retains its report-aware submission check" (and (str_eq (fcap-stage inspectionReady) "review") (and (eq (fcap-checks inspectionReady) 0) (value_eq (fcap-docs inspectionReady) docs))))
 (fcapb-assert "direct coding still enters non-writing review" (and (str_eq (fcap-stage directReview) "review") (not (fcap-tool-allowed directReview "write" (list "config.json")))))
 (let directFailure (fcap-step directReview "{\"verdict\":\"accept\"}" (list fcapb-check "wrong")))
 (fcapb-assert "direct coding runs the caller checker and retains failure" (and (str_eq (fcap-stage directFailure) "repair") (eq (fcap-checks directFailure) 2)))
 (let directReplan (fcap-step directFailure "{\"diagnosis\":\"caller check failed\",\"change\":\"reinspect and revise the implementation\",\"next\":\"plan\"}" checker))
 (fcapb-assert "direct coding may replan without changing the goal or write boundary" (and (str_eq (fcap-stage directReplan) "plan") (and (str_eq (nth directReplan 1) "Enable local coding") (value_eq (nth directReplan 4) (list "config.json")))))
 (let directDone (fcap-step directReview "{\"verdict\":\"accept\"}" checker))
 (fcapb-assert "direct coding completes only with checked changed documents" (and (str_eq (fcap-stage directDone) "complete") (and (eq (fcap-checks directDone) 2) (value_eq (fat-find-doc (fcap-docs directDone) "checks.txt") (nth docs 1)))))
 (let contextual (fcap-begin-context s0))
 (let instructionReview (fcap-begin-context (fcap-open-direct-review "Inspect exact source" docs)))
 (fcapb-assert "bootstrap retains full admitted role instructions" (ge (str_find (fcap-bootstrap instructionReview) (fcap-work-instruction instructionReview) 0) 0))
 (fcapb-assert "code and review receive the shared current Form meanings" (and (ge (str_find (fcap-bootstrap contextual) (fqt-meaning-prefix) 0) 0) (ge (str_find (fcap-bootstrap instructionReview) (fqt-meaning-prefix) 0) 0)))
 (fcapb-assert "later observations reference full resident instructions" (and (not (str_eq (fcap-observation-instruction instructionReview) (fcap-work-instruction instructionReview))) (lt (str_len (fcap-observation instructionReview)) (str_len (json-emit (fcap-observation-node instructionReview))))))
 (let instructionRepair (fcap-step instructionReview "{\"report\":\"wrong\"}" (list fcapb-report-check "expected")))
 (fcapb-assert "new repair role carries full instructions and failure evidence" (and (str_eq (fcap-observation-instruction instructionRepair) (fcap-work-instruction instructionRepair)) (ge (str_find (fcap-observation instructionRepair) (fcap-evidence instructionRepair) 0) 0)))
 (let failureProjection (parse-json "observation" (fcap-observation instructionRepair)))
 (fcapb-assert "repair observation carries complete evidence once with local references" (and (str_eq (fcap-string failureProjection "failure_evidence") (fcap-evidence instructionRepair)) (and (str_eq (fcap-string failureProjection "observation") (fcap-evidence-reference-text)) (str_eq (head (fcap-array failureProjection "pending")) (fcap-evidence-reference-text)))))
 (fcapb-assert "projection keeps original failure and task state" (and (str_eq (fcap-note instructionRepair) (fcap-evidence instructionRepair)) (str_eq (head (nth instructionRepair 5)) (fcap-evidence instructionRepair))))
 (let distinctObservation (fcap-note-at instructionRepair "repair" "Keep this distinct observation."))
 (fcapb-assert "distinct observations and tasks survive" (and (str_eq (fcap-string (parse-json "observation" (fcap-observation distinctObservation)) "observation") "Keep this distinct observation.") (str_eq (node_value (head (fcap-pending-observation instructionRepair (list "Inspect the caller source.")))) "Inspect the caller source.")))
 (fcapb-assert "unmeasured and short evidence does not grow" (and (str_eq (fcap-evidence-reference s0 "ordinary note") "ordinary note") (str_eq (fcap-evidence-reference (fcap-with-memory s0 (list 1 "short" (list) 1 0)) "short") "short")))
 (let instructionSeen (fcap-observation-admitted instructionRepair 0 1 1))
 (fcapb-assert "completed observation admits the exact instruction" (and (fat-has (fcap-context-instructions instructionSeen) (fcap-work-instruction instructionSeen)) (not (str_eq (fcap-observation-instruction instructionSeen) (fcap-work-instruction instructionSeen)))))
 (fcapb-assert "failed partial or absent observations do not admit instructions" (and (value_eq (fcap-observation-admitted instructionRepair 0 0 1) instructionRepair) (and (value_eq (fcap-observation-admitted instructionRepair 0 1 0) instructionRepair) (value_eq (fcap-observation-admitted instructionRepair 0 2 1) instructionRepair))))
 (fcapb-assert "unadmitted state carries full instructions" (str_eq (fcap-observation-instruction (fcap-open-direct-review "fresh" docs)) (fcap-work-instruction instructionReview)))
 (let instructionResumed (fcap-begin-context instructionSeen))
 (fcapb-assert "resume resets earlier role history and bootstraps current instructions fully" (and (eq (len (fcap-context-instructions instructionResumed)) 1) (ge (str_find (fcap-bootstrap instructionResumed) (fcap-work-instruction instructionResumed) 0) 0)))
 (let largeFailure (fcap-rework instructionReview (fcapb-context-lines 8)))
 (let largeFirst (parse-json "first-failure" (fcap-observation largeFailure)))
 (let largeSeen (fcap-observation-admitted largeFailure 0 1 1))
 (let largeRepeat (parse-json "repeated-failure" (fcap-observation largeSeen)))
 (let evidenceRef (json-object-get largeRepeat "failure_evidence"))
 (fcapb-assert "first failure carries exact bytes and the identity later references use" (and (str_eq (fcap-string largeFirst "failure_evidence") (fcap-evidence largeFailure)) (str_eq (fcap-string evidenceRef "reference") (fcap-string largeFirst "failure_evidence_id"))))
 (fcapb-assert "repeated evidence names this context and is actually shorter" (and (str_eq (fcap-string evidenceRef "scope") "current-model-context") (lt (str_len (fcap-observation largeSeen)) (str_len (fcap-observation largeFailure)))))
 (fcapb-assert "reference preserves retained evidence source and accounting" (and (str_eq (fcap-evidence largeSeen) (fcap-evidence largeFailure)) (and (value_eq (fcap-docs largeSeen) (fcap-docs largeFailure)) (and (eq (fcap-checks largeSeen) (fcap-checks largeFailure)) (eq (fcap-turns largeSeen) (fcap-turns largeFailure))))))
 (let newFailure (fcap-rework largeSeen (str_concat (fcap-evidence largeSeen) "A new observation.")))
 (fcapb-assert "changed bytes return in full with a different identity" (and (str_eq (fcap-string (parse-json "new-failure" (fcap-observation newFailure)) "failure_evidence") (fcap-evidence newFailure)) (not (str_eq (fcap-evidence-id newFailure) (fcap-context-evidence newFailure)))))
 (fcapb-assert "failed or incomplete feedback cannot authorize an evidence reference" (and (str_eq (fcap-context-evidence (fcap-observation-admitted largeFailure 0 0 1)) "") (and (str_eq (fcap-context-evidence (fcap-observation-admitted largeFailure 0 1 0)) "") (str_eq (fcap-context-evidence (fcap-observation-admitted largeFailure 0 2 1)) ""))))
 (let largeResumed (fcap-begin-context largeSeen))
 (fcapb-assert "fresh context supplies complete evidence even when a checkpoint held a reference" (and (str_eq (fcap-string (fcap-observation-node largeResumed) "failure_evidence") (fcap-evidence largeFailure)) (ge (str_find (fcap-bootstrap largeResumed) (json-emit (fcap-observation-node largeResumed)) 0) 0)))
 (fcapb-assert "short failures stay text after delivery" (str_eq (fcap-string (parse-json "short-failure" (fcap-observation instructionSeen)) "failure_evidence") (fcap-evidence instructionSeen)))
 (fcapb-assert "report updates preserve resident instructions" (value_eq (fcap-context-instructions (fcap-with-report instructionSeen "new report")) (fcap-context-instructions instructionSeen)))
 (let spliceCases (list (list "" "first\n") (list "first\n" "") (list "a\nb\n" "a\nc\n") (list "same\nsame" "same") (list "α\nheart\n⟐" "α\ntrust\n⟐\n") (list "a\nb\nc\nd" "a\nB\nc\nD")))
 (fcapb-splices spliceCases)
 (let longBase (fcapb-context-lines 32))
 (let longCurrent (str_concat "new first line\n" longBase))
 (let patchNote (fcap-read-note (list "large" "large.fk" longBase) (fat-result 0 longCurrent "" docs)))
 (fcapb-assert "large changed reads retain an exact smaller splice" (and (ge (str_find patchNote "stdout_patch" 0) 0) (and (ge (str_find patchNote "new first line" 0) 0) (lt (str_len patchNote) (str_len longCurrent)))))
 (fcapb-assert "changed read errors retain full evidence" (lt (str_find (fcap-read-note (list "large" "large.fk" longBase) (fat-result 2 longCurrent "failed" docs)) "stdout_patch" 0) 0))
 (let nativeRead (fat-call docs "read" (list "config.json") ""))
 (let reused (fcap-tool-note contextual "read" (list "config.json") nativeRead))
 (fcapb-assert "only admitted bytes may be referenced" (and (ge (str_find reused "stdout_reference" 0) 0) (lt (str_find (fcap-tool-note s0 "read" (list "config.json") nativeRead) "stdout_reference" 0) 0)))
 (fcapb-assert "reference names bytes without repeating content" (and (ge (str_find reused "config.json" 0) 0) (lt (str_find reused "enabled" 0) 0)))
 (fcapb-assert "cat still returns the actual bytes" (ge (str_find (fcap-tool-note contextual "cat" (list "config.json") nativeRead) "enabled" 0) 0))
 (let editedContext (fcap-step (fcap-note-at contextual "implement" "edit") "{\"tool\":\"edit\",\"arguments\":[\"config.json\",\"false\",\"true\"]}" checker))
 (let changedRead (fat-call (fcap-docs editedContext) "read" (list "config.json") ""))
 (fcapb-assert "changed content is returned in full" (and (lt (str_find (fcap-tool-note editedContext "read" (list "config.json") changedRead) "stdout_reference" 0) 0) (ge (str_find (fcap-tool-note editedContext "read" (list "config.json") changedRead) "true" 0) 0)))
 (fcapb-assert "new admission resets the context snapshot" (ge (str_find (fcap-tool-note (fcap-begin-context editedContext) "read" (list "config.json") changedRead) "stdout_reference" 0) 0))
 (fcapb-assert "tool errors remain explicit" (lt (str_find (fcap-tool-note contextual "read" (list "config.json") (fat-result 2 "" "read failed" docs)) "stdout_reference" 0) 0))
 (fcapb-assert "context survives report memory updates" (value_eq (fcap-context-docs (fcap-with-report contextual "report")) docs))
 (let bad (fcap-step s0 "not JSON" checker))
 (let denied (fcap-step s0 "{\"tool\":\"write\",\"arguments\":[\"config.json\"],\"input\":\"oops\"}" checker))
 (let s1 (fcap-step s0 "{\"brief\":\"Enable local coding; preserve checks.\"}" checker))
 (let s2 (fcap-step s1 "{\"plan\":\"Read config; change flag; verify boolean.\"}" checker))
 (let s3 (fcap-step s2 "{\"tasks\":[\"Change enabled flag\",\"Inspect config\"]}" checker))
 (let outside (fcap-step s3 "{\"tool\":\"write\",\"arguments\":[\"checks.txt\"],\"input\":\"changed\"}" checker))
 (let remote (fcap-step s3 "{\"tool\":\"curl\",\"arguments\":[\"localhost\"]}" checker))
 (let s4 (fcap-step s3 "{\"tool\":\"edit\",\"arguments\":[\"config.json\",\"false\",\"true\"]}" checker))
 (let s5 (fcap-step s4 "{\"task\":\"done\"}" checker))
 (fcapb-assert "intermediate tasks keep working before the complete-candidate check" (and (str_eq (fcap-stage s5) "implement") (eq (fcap-checks s5) 0)))
 (let s6 (fcap-step s5 "{\"tool\":\"jq\",\"arguments\":[\".enabled\",\"config.json\"]}" checker))
 (let s7 (fcap-step s6 "{\"task\":\"done\"}" checker))
 (let s8 (fcap-step s7 "{\"verdict\":\"accept\",\"reason\":\"The flag is true.\"}" checker))
 (let fail (fcap-step s7 "{\"verdict\":\"accept\"}" (list fcapb-check "wrong")))
 (let rejected (fcap-step s7 "{\"verdict\":\"reject\",\"reason\":\"Check edge case.\"}" checker))
 ; Exercise the executing review boundaries without teaching a model this fixture.
 (let review (fcap-note-at (fcap-open-review "Inspect; do not edit" docs) "review" "inspection complete"))
 (let finding (fcap-step review "{\"verdict\":\"reject\",\"reason\":\"The source violates its policy.\"}" checker))
 (fcapb-assert "negative source findings stay in read-only review" (and (str_eq (fcap-stage finding) "review") (and (fcap-reviewing finding) (value_eq (fcap-docs finding) docs))))
 (fcapb-assert "negative source finding does not become acceptance" (and (not (fcap-done finding)) (ge (str_find (fcap-note finding) "The source violates its policy." 0) 0)))
 (let reportChecker (list fcapb-report-check "finding" fcapb-check "{\"enabled\":false}"))
 (let verified (fcap-step review "{\"tool\":\"verify\",\"arguments\":[]}" reportChecker))
 (let reportDone (fcap-step verified "{\"verdict\":\"accept\",\"report\":\"finding\"}" reportChecker))
 (fcapb-assert "unchanged sources and report are distinct results" (and (str_eq (fcap-stage reportDone) "complete") (and (value_eq (fcap-docs reportDone) docs) (str_eq (fcap-report reportDone) "finding"))))
 (fcapb-assert "verify and submission both count" (and (eq (fcap-checks reportDone) 2) (eq (fcap-calls reportDone) 1)))
 (fcapb-assert "empty report cannot complete" (not (fcap-done (fcap-step review "{\"verdict\":\"accept\",\"report\":\" \"}" reportChecker))))
 (let wrongReport (fcap-step review "{\"verdict\":\"accept\",\"report\":\"wrong\"}" reportChecker))
 (let repairedReport (fcap-step wrongReport "{\"diagnosis\":\"report check failed\",\"change\":\"reinspect source\",\"next\":\"plan\"}" reportChecker))
 (fcapb-assert "repair retains report and read-only mode" (and (str_eq (fcap-stage repairedReport) "plan") (and (fcap-reviewing repairedReport) (str_eq (fcap-report repairedReport) "wrong"))))
 (let reviewWithWritable (fcap-inherit review (fcap-open "Inspect; do not edit" docs (list "config.json"))))
 (let reviewEdit (fcap-step (fcap-note-at reviewWithWritable "implement" "inspect") "{\"mode\":\"code\",\"tool\":\"write\",\"arguments\":[\"config.json\"],\"input\":\"changed\"}" reportChecker))
 (fcapb-assert "caller review mode dominates write list and model mode" (and (value_eq (fcap-docs reviewEdit) docs) (eq (fcap-calls reviewEdit) 0)))
 (let reviewRepairEdit (fcap-step (fcap-note-at reviewWithWritable "repair" "inspect") hashCommand (list fcapb-bomb "")))
 (fcapb-assert "review mode remains immutable during repair even with writable paths" (and (value_eq (fcap-docs reviewRepairEdit) docs) (eq (fcap-calls reviewRepairEdit) 0)))
 (let badVerify (fcap-step review "{\"tool\":\"verify\",\"arguments\":[\"command\"]}" (list fcapb-bomb "" fcapb-bomb "")))
 (let badInput (fcap-step review "{\"tool\":\"verify\",\"arguments\":[],\"input\":\"command\"}" (list fcapb-bomb "" fcapb-bomb "")))
 (fcapb-assert "verify cannot receive model code" (and (eq (fcap-calls badVerify) 0) (eq (fcap-calls badInput) 0)))
 (let malformed (fcap-verify-observed review (list 1 99)))
 (fcapb-assert "malformed checker cannot complete and is counted" (and (str_eq (fcap-stage malformed) "attention") (eq (fcap-checks malformed) 1)))
 (let verifyTwice (fcap-step verified "{\"tool\":\"verify\",\"arguments\":[]}" reportChecker))
 (let verifyThrice (fcap-step verifyTwice "{\"tool\":\"verify\",\"arguments\":[]}" reportChecker))
 (fcapb-assert "repeated checks request replanning" (and (str_eq (fcap-stage verifyThrice) "repair") (and (eq (fcap-repeat verifyThrice) 1) (eq (fcap-checks verifyThrice) 3))))
 (fcapb-assert "code still needs a document change" (str_eq (fcap-stage (fcap-step (fcap-note-at s0 "review" "unchanged") "{\"verdict\":\"accept\"}" checker)) "repair"))
 (sum (list
  (fcapb-bit (str_eq (fcap-stage s1) "plan") 1)
  (fcapb-bit (str_eq (fcap-stage s2) "split") 2)
  (fcapb-bit (and (str_eq (fcap-stage s3) "implement") (eq (len (nth s3 5)) 2)) 4)
  (fcapb-bit (str_eq (fcap-stage bad) "refine") 8)
  (fcapb-bit (value_eq (fcap-docs denied) docs) 16)
  (fcapb-bit (value_eq (fcap-docs outside) docs) 32)
  (fcapb-bit (and (value_eq (fcap-docs remote) docs) (eq (fcap-calls remote) 0)) 64)
  (fcapb-bit (str_eq (nth (fat-find-doc (fcap-docs s4) "config.json") 2) "{\"enabled\":true}") 128)
  (fcapb-bit (and (eq (len (nth s5 5)) 1) (eq (nth s5 11) 1)) 256)
  (fcapb-bit (and (eq (fcap-calls s6) 2) (ge (str_find (fcap-note s6) "true" 0) 0)) 512)
  (fcapb-bit (str_eq (fcap-stage s7) "review") 1024)
  (fcapb-bit (and (str_eq (fcap-stage s8) "complete") (eq (nth s8 11) 2)) 2048)
  (fcapb-bit (and (str_eq (fcap-stage fail) "repair") (eq (len (nth fail 5)) 1)) 4096)
  (fcapb-bit (str_eq (fcap-stage rejected) "repair") 8192)
  (fcapb-bit (value_eq (fcap-step s8 "invalid" checker) s8) 16384)
  (fcapb-bit (value_eq (fat-find-doc (fcap-docs s8) "checks.txt") (nth docs 1)) 32768))))
