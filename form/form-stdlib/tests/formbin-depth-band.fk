; witnessed: 2026-09-09 -> 2047
; preludes: observe/formbin-depth-fixtures.bml
(do
 (defn fbdb-k (ok bit) (if ok bit 0))
 (let source (fbw-body 1024))
 (let full (fbw-finish source (fbd-start 0) 4096 0))
 (let sliced (fbw-finish source (fbd-start 0) 7 0))
 (let state (head full))
 (let short (substring source 0 (sub (str_len source) 1)))
 (let broken (head (fbw-finish short (fbd-start 0) 19 0)))
 (let pressure (fbd-attend 1024 32 128 90 50 1))
 (let recovery (fbd-attend 1024 2050 64 1 50 0))
 (let crossed (fbd-attend 1024 32 128 25 50 0))
 (let collected (fbd-attend 1024 2050 128 3 50 1))
 (let slow (fbd-attend 1024 2050 128 90 50 0))
 (sum (list
  (fbdb-k (and (eq (nth state 4) 2) (eq (nth state 3) 1024)) 1)
  (fbdb-k (and (eq (nth state 0) (str_len source)) (eq (nth state 2) 2049)) 2)
  (fbdb-k (and (eq (nth full 1) 2049) (eq (nth sliced 1) 2049)) 4)
  (fbdb-k (and (eq (nth (head sliced) 4) 2) (eq (nth (head sliced) 0) (str_len source))) 8)
  (fbdb-k (and (eq (nth broken 4) 3) (str_eq (nth broken 5) "form binary: truncated u32")) 16)
  (fbdb-k (and (eq (head pressure) 2) (and (eq (nth pressure 1) 1) (eq (nth pressure 3) 64))) 32)
  (fbdb-k (and (eq (nth recovery 1) 2) (eq (nth recovery 3) 128)) 64)
  (fbdb-k (and (eq (head crossed) 1) (and (eq (nth crossed 1) 0) (eq (nth crossed 2) 2050))) 128)
  (fbdb-k (eq (nth state 6) 0) 256)
  (fbdb-k (and (eq (head collected) 1) (and (eq (nth collected 1) 2) (eq (nth collected 3) 256))) 512)
  (fbdb-k (and (eq (head slow) 2) (and (eq (nth slow 1) 1) (eq (nth slow 3) 64))) 1024))))
