; preludes: form-stdlib/core.fk form/form-stdlib/roster-census.bml
; Expected: 63
; PROOF LEVEL: FKWU-STAGED / FOURTH-ARM ONLY (host_processes, host_spawn and the kernel roster)
;
; roster-census-band — the body's two counts of its kernels agree on the kernels it starts itself.
;
; The host counts every process named fkwu (host_processes, libproc); the roster counts every kernel
; holding a slot in /fg-kernels with a live page that says alive. On 2026-09-11 they disagreed — 14
; against 11 — because three living organs had never landed in the roster. roster-census.bml names the
; difference; this band holds the census to kernels whose lives it controls, so a census that reads only
; the host, or only the roster, cannot pass.
;
; Verdict 63:
;   1  this kernel is in both counts
;   2  three sleepers it starts appear in the host's count while they rest
;   4  the same three appear in the roster
;   8  none of the three is untracked, and once they have ended neither count still holds them
;  16  a kernel left behind on purpose — started by a child that ended without waiting — is named an
;      orphan (parent pid 1, read from host_processes' sixth field), and this kernel is not
;  32  a kernel whose parent is a shell whose own parent is pid 1 is named too — the form-run shape
;      (39711 over 39740 on 2026-09-11) — and one whose shell still has a parent is not; synthetic rows
(do
    (defn rcb-cmd () (list "./fkwu" "observe/tests/roster-sleeper.fk"))
    (defn rcb-spawn (n acc) (if (le n 0) acc (rcb-spawn (sub n 1) (cons (host_spawn_quiet (rcb-cmd)) acc))))
    (defn rcb-all-in? (xs ys) (if (eq (len xs) 0) 1 (if (eq (rce-in? (head xs) ys) 1) (rcb-all-in? (tail xs) ys) 0)))
    (defn rcb-none-in? (xs ys) (if (eq (len xs) 0) 1 (if (eq (rce-in? (head xs) ys) 1) 0 (rcb-none-in? (tail xs) ys))))
    (defn rcb-wait-all (ps) (if (eq (len ps) 0) 0 (add (host_wait (head ps)) (rcb-wait-all (tail ps)))))

    (let me (host_pid))
    (let warm (host_wait (host_spawn_quiet (rcb-cmd))))
    (let pids (rcb-spawn 3 (empty)))
    (let rest (host_sleep_ms 1500))
    (let host (rce-host))
    (let roster (rce-roster))
    (let waited (rcb-wait-all pids))
    (let host2 (rce-host))
    (let roster2 (rce-roster))

    ; an orphan made on purpose: a child starts a sleeper and ends at once, so the sleeper's parent is pid 1
    (let said (host_capture (list "./fkwu" "observe/tests/orphan-maker.fk")))
    (let orphan (str_to_int (substring said 0 (str_find said "\n" 0))))
    (let settle (host_sleep_ms 700))
    (let t (rce-take))

    (let c0 (if (and (eq (rce-in? me host) 1) (eq (rce-in? me roster) 1)) 1 0))
    (let c1 (if (eq (rcb-all-in? pids host) 1) 2 0))
    (let c2 (if (eq (rcb-all-in? pids roster) 1) 4 0))
    (let c3 (if (and (eq (rcb-none-in? pids (rce-minus host roster)) 1)
                (and (eq (rcb-none-in? pids host2) 1) (eq (rcb-none-in? pids roster2) 1))) 8 0))
    (let c4 (if (and (gt orphan 0) (and (eq (rce-in? orphan (nth t 4)) 1) (eq (rce-in? me (nth t 4)) 0))) 16 0))
    (let o5 (rce-orphans-with (list (list 100 0 0 0 0 1) (list 200 0 0 0 0 300) (list 400 0 0 0 0 500))
                              (list (list 300 0 0 0 0 1) (list 500 0 0 0 0 999))))
    (let c5 (if (and (eq (len o5) 2) (and (eq (rce-in? 100 o5) 1) (eq (rce-in? 200 o5) 1))) 32 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
