; local-generate-organ-band.fk — thought kernel: multi-op, catalog, many
; offers, and thoughts at rest (deferred-execution pointers).
; Four-way: no GGUF. Verdict 262143.
; preludes: form-stdlib/local-generate-organ.fk
(do
    (let t (lg-think "A Recipe named add-two whose body is (add 2 3)."))
    (let all (lg-think-all "Compute (add 2 3) then (mul 6 7)."))
    (let cat (lg-think "What is the square of 7?"))
    (let digits (lg-think "Compute 6 times 7 for me."))
    (let ground (lg-think "What is 40 plus 2?"))
    (let minus (lg-think "Take ten minus three."))
    (let same (lg-think "does 42 equal 42?"))
    (let rest (lg-defer "mul" 6 7))
    (let nested (lg-defer "add" (lg-defer "mul" 6 7) (lg-defer "sub" 9 4)))
    (let unknown (lg-defer "boom" 1 2))
    (sum (list
        (if (str_eq (lg-thought-op t) "add") 1 0)
        (if (eq (lg-thought-value t) 5) 2 0)
        (if (str_eq (lg-thought-text t) "(add 2 3)=5") 4 0)
        (if (eq (len (lg-think "no recipe here")) 0) 8 0)
        (if (eq (len all) 2) 16 0)
        (if (eq (lg-thought-value (nth all 1)) 42) 32 0)
        (if (str_eq (lg-values-line all) "5|42") 64 0)
        (if (eq (lg-thought-value cat) 49) 128 0)
        (if (str_eq (lg-thought-text digits) "(mul 6 7)=42") 256 0)
        (if (str_eq (lg-thought-text ground) "(add 40 2)=42") 512 0)
        (if (eq (lg-thought-value minus) 7) 1024 0)
        (if (eq (lg-thought-value same) 1) 2048 0)
        (if (str_eq (lg-defer-text rest) "(mul 6 7)") 4096 0)
        (if (eq (lg-force rest) 42) 8192 0)
        (if (eq (lg-force rest) (lg-thought-value digits)) 16384 0)
        (if (str_eq (lg-defer-text nested) "(add (mul 6 7) (sub 9 4))") 32768 0)
        (if (eq (lg-force nested) 47) 65536 0)
        (if (eq (lg-force unknown) (sub 0 1)) 131072 0))))
