; local-generate-organ-band.fk — structure, seed, soft gate, rest pointers.
; Four-way: no GGUF. Verdict 16777215.
; Catalog phrases = seed rehearsal. Soft = propose+equivalence. Rest = defer/force.
; preludes: form-stdlib/local-generate-organ.fk
(do
    (let t (lg-think "A Recipe named add-two whose body is (add 2 3)."))
    (let all (lg-think-all "Compute (add 2 3) then (mul 6 7)."))
    (let soft (lg-think "What is the square of 7?"))
    (let seed (lg-think-seed "What is the square of 7?"))
    (let digits (lg-think-seed "Compute 6 times 7 for me."))
    (let ground (lg-think-seed "What is 40 plus 2?"))
    (let minus (lg-think-seed "Take ten minus three."))
    (let same (lg-think-seed "does 42 equal 42?"))
    (let obs (lg-observe "Compute (add 2 3) then (mul 6 7)." (empty)))
    (let soft-obs (lg-observe "What is the square of 7?" (empty)))
    (let ok (lg-soft "(mul 7 7)" "(mul 7 7)"))
    (let mismatch (lg-soft "(mul 7 7)" "(mul 6 7)"))
    (let prose (lg-soft "forty nine" "(mul 7 7)"))
    (let nohold (lg-soft "(mul 7 7)" ""))
    (let soft-obs-ok
        (lg-observe-soft "What is the square of 7?" "(mul 7 7)" "(mul 7 7)" (empty)))
    (let rest (lg-defer "mul" 6 7))
    (let nested (lg-defer "add" (lg-defer "mul" 6 7) (lg-defer "sub" 9 4)))
    (let unknown (lg-defer "boom" 1 2))
    (sum (list
        (if (str_eq (lg-thought-op t) "add") 1 0)
        (if (eq (lg-thought-value t) 5) 2 0)
        (if (str_eq (lg-thought-text t) "(add 2 3)=5") 4 0)
        (if (eq (len (lg-think "no recipe here")) 0) 8 0)
        (if (eq (len all) 2) 16 0)
        (if (eq (lg-thought-value (nth all 1)) 42) 32 0)
        (if (str_eq (lg-values-line all) "5|42") 64 0)
        (if (eq (len soft) 0) 128 0)
        (if (eq (lg-thought-value (head seed)) 49) 256 0)
        (if (and (eq (ll-wins (nth obs 1) 1) 2)
                 (and (eq (ll-trials (nth soft-obs 1) 2) 1)
                      (eq (nth soft-obs 2) 1))) 512 0)
        (if (eq (lg-soft-commit? ok) 1) 1024 0)
        (if (and (str_eq (lg-soft-status mismatch) "refuse")
                 (eq (lg-soft-equivalent mismatch) 0)) 2048 0)
        (if (str_eq (lg-soft-status prose) "silent") 4096 0)
        (if (and (str_eq (lg-soft-status nohold) "refuse")
                 (eq (ll-wins (nth soft-obs-ok 1) 2) 1)) 8192 0)
        (if (str_eq (lg-thought-text (head digits)) "(mul 6 7)=42") 16384 0)
        (if (str_eq (lg-thought-text (head ground)) "(add 40 2)=42") 32768 0)
        (if (eq (lg-thought-value (head minus)) 7) 65536 0)
        (if (eq (lg-thought-value (head same)) 1) 131072 0)
        (if (str_eq (lg-defer-text rest) "(mul 6 7)") 262144 0)
        (if (eq (lg-force rest) 42) 524288 0)
        (if (eq (lg-force rest) (lg-thought-value (head digits))) 1048576 0)
        (if (str_eq (lg-defer-text nested) "(add (mul 6 7) (sub 9 4))") 2097152 0)
        (if (eq (lg-force nested) 47) 4194304 0)
        (if (eq (lg-force unknown) (sub 0 1)) 8388608 0))))
