; living-world-contextual-species-accumulation-band.fk -- contexts accumulate.
; Verdict 32767 proves fifteen multi-member, live-lens, and consent claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk form-stdlib/living-world-contextual-species.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk form-stdlib/tests/living-world-behavioral-species-witness.fk form-stdlib/tests/living-world-contextual-species-witness.fk

(do
    (let multi (lwcsw-build-multi))
    (let world (lwcsw-coherent-world multi))
    (let equivalent (lwcsw-multi-equivalent multi))
    (let e
        (lwtnw-trial-candidate (lwbsw-equivalent-e-trial equivalent)))
    (let g
        (lwtnw-trial-candidate (lwbsw-equivalent-g-trial equivalent)))
    (let h (lwtnw-trial-candidate (lwcsw-h-trial multi)))
    (let eg (lwbsw-species-candidate (lwcsw-eg-species multi)))
    (let gh (lwbsw-species-candidate (lwcsw-gh-species multi)))
    (let field (lwcs-field-for world (lwcsw-focus) 2))
    (let set (lwcs-field-evidence field))
    (let components (lwcs-field-components field))
    (let component (head (lwo-field-items components)))
    (let kernel (lwcs-component-kernel component))
    (let proposal
        (lwcs-tissue-proposal world (lwcsw-focus) kernel 2))
    (let integrated (lwcsw-integrated-coherent-tissue multi))
    (let integrated-world
        (lwt-round-world (lwcsw-tissue-round integrated)))
    (let integrated-candidate (lwcsw-tissue-candidate integrated))
    (let context-a (lwcsw-context-a))
    (let context-b (lwcsw-context-b))

    (let c1
        (if (and (eq (lwbs-historical-trial-valid? world h) 1)
                 (and (not (node_eq
                              (lwre-recipe-source-cell
                                (lwtn-candidate-recipe
                                  (lwtn-trial-candidate
                                    (lwo-emergent-shape h))))
                              (lwre-recipe-source-cell
                                (lwtn-candidate-recipe
                                  (lwtn-trial-candidate
                                    (lwo-emergent-shape e))))))
                      (not (node_eq h g)))) 1 0))
    (let c2
        (if (and (eq (lwbs-integrated-current? world eg) 1)
                 (eq (lwbs-integrated-current? world gh) 1)) 2 0))
    (let c3
        (if (and (eq (lwo-field-size (lwcs-set-supports set)) 2)
                 (eq (lwo-field-size
                         (lwcs-evidence-sources
                           (head (lwo-field-items
                             (lwcs-set-supports set))))) 2)) 4 0))
    (let c4
        (if (and (eq (lwlc-declaration-current? world context-a) 1)
                 (and (node_eq
                         (lwlc-stack-default
                           (lwlc-declaration-stack context-a))
                         (lwtnw-lens-e))
                      (eq (len (lwlc-layer-items
                                  (lwlc-stack-layers
                                    (lwlc-declaration-stack context-a))))
                          1))) 8 0))
    (let c5
        (if (and (eq (lwo-field-has?
                         (lwlc-stack-alternatives
                           (lwlc-declaration-stack context-a))
                         (lwcsw-lens-h)) 1)
                 (eq (lwlc-unknown?
                         (lwlc-stack-unknown
                           (lwlc-declaration-stack context-a))) 1)) 16 0))
    (let c6
        (if (and (eq (lwlc-declaration-current? world context-b) 1)
                 (and (node_eq
                         (lwlc-stack-default
                           (lwlc-declaration-stack context-b))
                         (lwo-none))
                      (node_eq
                         (lwlc-stack-unknown
                           (lwlc-declaration-stack context-b))
                         (lwo-none)))) 32 0))
    (let c7
        (if (and (node_eq (lwcs-kernel-before kernel)
                          (intern_trivial_int 1))
                 (and (node_eq (lwcs-kernel-after kernel)
                               (intern_trivial_int 4))
                      (not (node_eq kernel
                            (lwcs-signature-for-anchor world eg))))) 64 0))
    (let c8
        (if (and (eq (lwcs-coherent? (lwcs-field-status field)) 1)
                 (eq (lwo-field-size components) 1)) 128 0))
    (let c9
        (if (and (eq (lwo-field-size
                         (lwcs-component-anchors component)) 2)
                 (and (eq (lwo-field-size
                              (lwcs-component-members component)) 3)
                      (eq (lwo-field-size
                              (lwcs-component-receipts component)) 3)))
            256 0))
    (let c10
        (if (and (eq (lwo-field-size
                         (lwcs-component-contexts component)) 2)
                 (and (eq (lwo-field-has?
                              (lwcs-component-contexts component)
                              context-a) 1)
                      (eq (lwo-field-has?
                              (lwcs-component-contexts component)
                              context-b) 1))) 512 0))
    (let c11
        (if (and (eq (lwo-field-size (lwcs-set-silences set)) 1)
                 (and (eq (lwo-field-size
                              (lwcs-set-provisional set)) 0)
                      (eq (lwcs-set-blocker-count set) 0))) 1024 0))
    (let c12
        (if (and (eq (lwo-field-has?
                         (lwcs-field-alternatives field)
                         (lwcsw-option)) 1)
                 (gt (lwo-field-size (lwcs-field-unknowns field)) 0))
            2048 0))
    (let c13
        (if (and (eq (lwo-field-size
                         (lwcs-field-witnesses field)) 48)
                 (eq (lwo-field-size
                         (lwt-proposal-participants proposal)) 29)) 4096 0))
    (let c14
        (if (and (eq (lwcs-tissue-proposal-current? world proposal) 1)
                 (and (eq (lwcs-open?
                              (lwcs-field-status
                                (lwcs-field-for
                                  world (lwcsw-focus) 0))) 1)
                      (node_eq
                        (lwcs-tissue-proposal
                          world (lwcsw-focus) kernel 0)
                        (lwo-none)))) 8192 0))
    (let c15
        (if (and (eq (lwcs-tissue-integrated-current?
                         integrated-world integrated-candidate) 1)
                 (eq (lwo-field-size
                         (lwcs-component-members
                           (lwcs-tissue-component
                             (lwo-emergent-shape
                               integrated-candidate)))) 3)) 16384 0))
    (lwtnw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
