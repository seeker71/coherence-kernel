; form-cli-one-turn-band.fk — one local turn finishes; remote reviews once.
;
; Verdict 2047:
;   1..128  fot-check
;   256     class descriptor FormOneTurn minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;   1024    remote absent: local still walks, then stop; leak(105)=104
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-router.fk
; preludes: form-stdlib/form-cli-local-ready-xtal.fk
; preludes: form-stdlib/form-cli-one-turn-xtal.fk
; witnessed: 2026-08-26 -> 2047; drop next-stop; leak(105)=104

(do
    (defn fotb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn fotb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (fotb-has-name? (tail xs) name))))

    (let bits (fot-check))
    (let desc (FormOneTurn))
    (let src (read_file "form/form-stdlib/bml/form-cli-one-turn.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormOneTurn")
                     (and (eq (fotb-has-name? (nth desc 2) "T") 1)
                          (and (eq (fotb-has-name? (nth desc 3) "fot-next") 1)
                               (eq (fotb-has-name? (nth desc 4) "OneTurn") 1))))
                256 0))
    (let b9 (if (and (eq (fotb-has-str? src "package Form.cli.oneturn") 1)
                     (and (eq (fotb-has-str? src "interface IOneTurn") 1)
                          (and (eq (fotb-has-str? src "class FormOneTurn") 1)
                               (and (eq (fotb-has-str? src "const int OneTurn") 1)
                                    (eq (fotb-has-str? src "template RequestBudget") 1)))))
                512 0))
    (let drop (if (eq (fot-drop-check) 63) 1024 0))
    (add bits (add b8 (add b9 drop))))
