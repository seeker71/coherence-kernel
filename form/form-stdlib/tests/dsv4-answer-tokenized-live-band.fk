; The same local DS4 path used by form-cli, including the model-owned tokenizer.
; This isolates tokenizer -> native stack -> detokenizer from REPL state while
; preserving the actual prompt, prompt ids, generated ids, and response.
; No stored continuation, shell, HTTP, or remote model enters this witness.
; preludes: native/metal/dsv4-validation-live.fk
(do
  (defn datl-ids-eq (a b)
    (if (not (eq (len a) (len b))) 0
      (if (eq (len a) 0) 1
        (if (eq (head a) (head b))
            (datl-ids-eq (tail a) (tail b)) 0))))
  (let path "/Users/ursmuff/models/ds4-engine/gguf/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf")
  (let prompt "The capital of France is")
  (let src (tkz-src path))
  (let prompt-ids (tkz-encode src prompt))
  (let generated-ids (dfd-stack-stream path prompt-ids 8))
  (let legal (dvl-ids-legal? generated-ids (tkz-vocab-n src)))
  (let response (if (eq legal 1) (tkz-decode-text src generated-ids) ""))
  (list (nothing) 1001100005 prompt prompt-ids generated-ids response
        (metal_status)
        (if (and (eq (datl-ids-eq prompt-ids (list 671 6102 294 8760 344)) 1)
                 (and (eq (len generated-ids) 8)
                      (and (eq (head generated-ids) 11111)
                           (and (eq legal 1) (gt (str_len response) 0))))) 1 0)))
