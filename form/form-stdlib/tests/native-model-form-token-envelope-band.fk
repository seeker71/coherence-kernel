; native-model-form-token-envelope-band.fk — registry-wide compact Form token
; projection with explicit availability boundaries.
;
; preludes: form-stdlib/core.fk form-stdlib/native-model-control-plane.fk form-stdlib/native-model-control-plane-eval.fk form-stdlib/form-teach-layer.fk form-stdlib/native-model-form-token-envelope.bml
;
; Verdict 2047: 1023 executable + 1024 high-BML authority.

(do
    (defn nmfteb-has (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let registry (nmcp-registry))
    (let envelopes (nmfte-project-all registry))
    (let threeb (nmfte-find (NMFTEThreeB) envelopes))
    (let qwen (nmfte-find (NMFTEQwen) envelopes))
    (let ds4 (nmfte-find (NMFTEDS4) envelopes))
    (let world (nmfte-find (NMFTEWorld) envelopes))
    (let audio (nmfte-find "speech.whisper-block-native" envelopes))
    (let remote (nmfte-find "oracle.agent-remote" envelopes))
    (let unbound (nmfte-find "st.llama32-3b-mlx-4bit" envelopes))
    (let c0 (if (and (eq (len registry) 62) (eq (len envelopes) 62)) 1 0))
    (let c1 (if (eq (nmfte-prefix-complete?) 1) 2 0))
    (let c2 (if (and (eq (nmfte-envelope-prompt-admitted? threeb) 1) (str_eq (nmfte-envelope-mode threeb) "compact-prefix")) 4 0))
    (let c3 (if (and (eq (nmfte-envelope-prompt-admitted? qwen) 1) (str_eq (nmfte-envelope-mode ds4) "control-logit+compact-prefix")) 8 0))
    (let c4 (if (and (eq (nmfte-envelope-native-admitted? world) 1) (str_eq (nmfte-envelope-mode world) "native-primitives")) 16 0))
    (let c5 (if (and (str_eq (nmfte-envelope-mode audio) "not-applicable-nontext") (str_eq (nmfte-envelope-mode remote) "excluded-remote-or-fixture")) 32 0))
    (let c6 (if (and (str_eq (nmfte-envelope-mode unbound) "blocked-runtime") (str_eq (nmfte-envelope-state unbound) "blocked")) 64 0))
    (let wrapped (nmfte-wrap-id (NMFTEQwen) "reason here"))
    (let c7 (if (and (eq (nmfteb-has wrapped "inert until native validation") 1) (eq (nmfteb-has wrapped "reason here") 1)) 128 0))
    (let c8 (if (and (gt (nmfte-count-local envelopes) 0) (and (gt (nmfte-count-prompt-admitted envelopes) 0) (gt (nmfte-count-native-admitted envelopes) 0))) 256 0))
    (let c9 (if (and (eq (nmfte-vocabulary-complete?) 1)
                     (and (eq (nmfte-envelope-native-words threeb) 20)
                          (and (eq (nmfte-envelope-native-words audio) 20)
                               (eq (nmfte-envelope-native-words remote) 0)))) 512 0))
    (let base (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9)))
    (let src (read_file "form/form-stdlib/bml/native-model-form-token-envelope.bml"))
    (let authority
        (if (eq (nmfteb-has src "const String PopulationRule = \"exactly one token-envelope projection for every registry row\"") 1)
            (if (eq (nmfteb-has src "const String SafetyRule = \"model-emitted controls and primitives remain inert until native validation admits them\"") 1)
                (if (eq (nmfteb-has src "const String NativeVocabularyRule = \"every local registry row is assigned Node-ID,nothing,choice,fail,cut,undo,timeout,eval,store,release,melt,crystallize/crystalize,open,interface,protocol,offer,ask,broadcast,mesh,satsang\"") 1)
                    (if (and (eq (nmfteb-has src "const int ControlCount = 8") 1) (eq (nmfteb-has src "const int NativeWordCount = 20") 1)) 1024 0) 0) 0) 0))
    (add base authority))
