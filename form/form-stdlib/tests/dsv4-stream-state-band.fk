; DS4 native stream state band.
;
; Proves the four shapes at the generation membrane stay distinct:
; nothing (no receipt), integer 0, integer 1, and content-addressed nodes.
; It also proves a zero-token cap exits before model admission.
;
; 255 = all eight observations passed.
;
; preludes: native/metal/dsv4-native-session.fk

(do
    (framebuffer-clear)
    (let token-zero (dns-token-id "PASS metal_model_argmax\ntoken-id=0\n"))
    (let token-one (dns-token-id "PASS metal_model_argmax\ntoken-id=1"))
    (let absent (dns-token-id "FAIL metal_model_argmax\n"))
    (let empty (dns-token-id "token-id=\n"))
    (let pass-state (dns-receipt-state "PASS metal_model_open\n" "PASS metal_model_open"))
    (let fail-state (dns-receipt-state "FAIL metal_model_open\n" "PASS metal_model_open"))
    (let no-state (dns-receipt-state "NOTHING metal_model_open\n" "PASS metal_model_open"))
    (let token-node (dns-token-node 7 0 (list 65)))
    (let control-node (dns-control-node 7 3))
    (let capped (dns-generate-ids (list 0 1) 0))
    (let frames (framebuffer-events))
    (add
        (if (eq token-zero 0) 1 0)
        (add
            (if (eq token-one 1) 2 0)
            (add
                (if (nothing? absent) 4 0)
                (add
                    (if (nothing? empty) 8 0)
                    (add
                        (if (and (eq pass-state 1) (eq fail-state 0)) 16 0)
                        (add
                            (if (nothing? no-state) 32 0)
                            (add
                                (if (and
                                        (eq (node_value (nth (node_children token-node) 0)) 7)
                                        (eq (node_value (nth (node_children token-node) 1)) 0))
                                    64 0)
                                (if (and
                                        (not (node_eq token-node control-node))
                                        (and (eq (len capped) 0)
                                             (and (eq (len frames) 1)
                                                  (node_eq (head frames)
                                                      (dns-control-node 0 2)))))
                                    128 0)))))))))
