; transmute-grow-band.bml — the grammar grows by the drafts a circle affirmed (form-stdlib/bml/transmute.bml,
; form-stdlib/word-frequency-purify.fk, ingest/satsang-transmute.fk). Pure over a fixture passage; no voice, nothing written.
;
; Expected: 15
; Verdict 15 when every claim lands:
;    1   stx-affirmed keeps the items whose ack freezes (kind 2), in order; a pending, declined or recurring item stays out
;    2   wfp-filled keeps the draft's word and where it arrived and takes the offered reading and lifts
;    4   the fixture passage drafts eight words; with none affirmed the register does not move
;    8   admitted mid-run: the register over the same passage rises by the sightings of each affirmed word, and only those
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/word-frequency-purify.fk cognition/dialogue-covenant.fk ingest/satsang-transmute.fk form-stdlib/bml/order.bml form-stdlib/bml/transmute.bml
section [form.bml] {
 def tgb-p() = "Police faced rioting and rising tension as struggling families felt the pressure.";
 def tgb-drafts() = wfp-drafts(wfp-tokens(wfp-lower(tgb-p())));
 def tgb-c-affirmed() = len(stx-affirmed(["riot", "tension", "pressure"], [2, 1, 2])) == 2 && (String) stx-affirmed(["riot", "tension", "pressure"], [2, 1, 2])[1] == "pressure" && len(stx-affirmed(["riot", "tension"], [3, 0])) == 0 && len(stx-affirmed(["riot"], [])) == 0;
 def tgb-row() = wfp-filled(wfp-draft-of("tension", "rising tension"), "a signal that two needs have not met yet", 2, 1, 1);
 def tgb-c-filled() = (String) wfp-word(tgb-row()) == "tension" && (String) wfp-common(tgb-row()) == "rising tension" && (String) wfp-purified(tgb-row()) == "a signal that two needs have not met yet" && wfp-lifts?(tgb-row()) == 1;
 def tgb-c-pending() = len(tgb-drafts()) == 8 && tm-grow-with(tgb-p(), stx-affirmed(tgb-drafts(), []))[2] == 0;
 def tgb-kept() = stx-affirmed(tgb-drafts(), [0, 0, 2, 0, 2, 1, 3, 2]);
 def tgb-c-grown() = len(tgb-kept()) == 3 && tm-grow-with(tgb-p(), tgb-kept())[1] == 3 && tm-grow-with("Tension here, tension there.", tgb-kept())[2] == 2 && tm-grow-with("The law says you must not.", tgb-kept())[2] == 0;
 (tgb-c-affirmed() ? 1 : 0) + (tgb-c-filled() ? 2 : 0) + (tgb-c-pending() ? 4 : 0) + (tgb-c-grown() ? 8 : 0);
}
