; dsv4-control-training-corpus-native-band.fk — balance and split witness.
; Expected verdict 127.
; preludes: form-stdlib/dsv4-control-training-corpus.fk

(do
    (let rows (dcc-corpus))
    (let a (if (eq (len rows) 750) 1 0))
    (let b (if (eq (dcc-count-class rows "NIL" "train") 120) 2 0))
    (let c (if (eq (dcc-count-class rows "CUT" "train") 120) 4 0))
    (let d (if (eq (dcc-count-class rows "FAIL" "train") 120) 8 0))
    (let e (if (eq (dcc-count-class rows "TIMEOUT" "train") 120) 16 0))
    (let f (if (eq (dcc-count-class rows "CHOICE" "train") 120) 32 0))
    (let g (if (if (eq (dcc-count-class rows "NIL" "heldout-boundary") 30)
                    (if (eq (dcc-count-class rows "CUT" "heldout-boundary") 30)
                    (if (eq (dcc-count-class rows "FAIL" "heldout-boundary") 30)
                    (if (eq (dcc-count-class rows "TIMEOUT" "heldout-boundary") 30)
                        (eq (dcc-count-class rows "CHOICE" "heldout-boundary") 30) 0) 0) 0) 0)
                64 0))
    (add a (add b (add c (add d (add e (add f g)))))))
