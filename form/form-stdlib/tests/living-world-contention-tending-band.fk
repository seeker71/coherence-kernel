; living-world-contention-tending-band.fk -- context can grow beside silence.
; Verdict 32767 proves fifteen stance, resolution, successor, and revocation properties.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-enquiry.fk form-stdlib/living-world-enquiry-answer.fk form-stdlib/living-world-contention-tending.fk form-stdlib/living-world-contextual-answer.fk form-stdlib/tests/living-world-contention-witness.fk form-stdlib/tests/living-world-contention-tending-witness.fk

(do
    (let mapping-world (lwct-mapping-world))
    (let question-proposal (lwcttw-question-proposal mapping-world))
    (let question-candidate
        (lwt-proposal-candidate question-proposal))
    (let question (lwo-emergent-shape question-candidate))
    (let silent-round (lwcttw-silent-round))
    (let silent-world (lwt-round-world silent-round))
    (let silent-candidate
        (lwcta-silent-answer-for silent-world question-candidate))
    (let silent-answer (lwo-emergent-shape silent-candidate))
    (let identity-route (lwcttw-identity-route question-candidate))
    (let swap-route (lwcttw-swap-route question-candidate))

    (let split-world
        (lwcttw-split-world silent-world question-candidate))
    (let split-evidence
        (lwctd-evidence-for split-world question-candidate))
    (let split-proposals
        (lwctd-resolution-proposals split-world))

    (let aligned-world
        (lwcttw-aligned-world split-world question-candidate))
    (let aligned-evidence
        (lwctd-evidence-for aligned-world question-candidate))
    (let resolution-proposals
        (lwctd-resolution-proposals aligned-world))
    (let resolution-proposal
        (head (lwo-field-items resolution-proposals)))
    (let resolution-candidate
        (lwt-proposal-candidate resolution-proposal))
    (let resolution
        (lwo-emergent-shape resolution-candidate))
    (let resolution-round
        (lwt-round aligned-world resolution-proposals
            (lwo-empty-field) silent-round))
    (let resolution-integrated
        (lwctd-integrate-resolution
            (lwct-five-yes-round resolution-round resolution-proposal)
            resolution-proposal (lwct-action)))
    (let resolution-world
        (lwt-round-world resolution-integrated))

    (let contextual-proposal
        (lwcta-answer-proposal
            resolution-world resolution-candidate))
    (let contextual-candidate
        (lwt-proposal-candidate contextual-proposal))
    (let contextual-answer
        (lwo-emergent-shape contextual-candidate))
    (let contextual-round
        (lwt-round resolution-world
            (lwo-field-add (lwo-empty-field) contextual-proposal)
            (lwo-empty-field) resolution-integrated))
    (let contextual-yes
        (lwct-five-yes-round contextual-round contextual-proposal))
    (let successful
        (lwcta-integrate
            contextual-yes contextual-proposal (lwct-action)))
    (let successful-world (lwt-round-world successful))

    ; Revoking one holder's exact stance after all answer acknowledgments
    ; makes both the resolution and successor stale on this sibling branch.
    (let stale-world
        (lwcttw-release-aligned-a
            (lwt-round-world contextual-yes) question-candidate))
    (let stale-round
        (lwt-round stale-world
            (lwo-field-add (lwo-empty-field) contextual-proposal)
            (lwo-empty-field) contextual-yes))
    (let stale-integration
        (lwcta-integrate
            stale-round contextual-proposal (lwct-action)))

    (let c1 (if (and (node_eq
                          (lwen-question-kind question)
                          (lwen-contention))
                         (eq (lwo-field-size
                              (lwen-question-routes question)) 2)) 1 0))
    (let c2 (if (and (eq (lwo-active?
                              silent-world silent-candidate) 1)
                         (eq (oac-nothing?
                              (lwen-answer-ack silent-answer)) 1)) 2 0))
    (let c3 (if (eq (lwo-field-size split-evidence) 3) 4 0))
    (let c4 (if (and
                        (eq (lwctd-source-route-status split-world
                                question-candidate identity-route
                                (lwct-source-a)) 2)
                        (and
                            (eq (lwctd-source-route-status split-world
                                    question-candidate identity-route
                                    (lwct-source-c)) 3)
                            (eq (lwctd-source-route-status split-world
                                    question-candidate identity-route
                                    (lwct-source-e)) 1))) 8 0))
    (let c5 (if (eq (lwo-field-size split-proposals) 0) 16 0))
    (let c6 (if (and (eq (lwo-field-size aligned-evidence) 1)
                         (eq (lwo-field-size
                              (lwctd-stance-evidence-attributions
                                (head (lwo-field-items aligned-evidence))))
                             5)) 32 0))
    (let c7 (if (eq (lwo-field-size resolution-proposals) 1) 64 0))
    (let c8 (if (and (node_eq
                          (lwctd-resolution-route resolution)
                          identity-route)
                         (and (eq (lwo-field-size
                                   (lwctd-resolution-alternatives resolution)) 2)
                              (node_eq
                                (lwctd-resolution-path resolution)
                                (lwo-local-path)))) 128 0))
    (let c9 (if (and (eq (lwo-field-size
                              (lwt-proposal-participants
                                  resolution-proposal)) 5)
                         (eq (lwo-field-size
                              (lwo-emergent-witnesses
                                  resolution-candidate)) 10)) 256 0))
    (let c10 (if (and (eq (lwo-active?
                               resolution-world resolution-candidate) 1)
                          (eq (lwctd-resolution-steady?
                               resolution-world resolution-candidate) 1)) 512 0))
    (let c11 (if (and (node_eq
                           (lwcta-answer-output contextual-answer)
                           (lwct-identity-output))
                          (node_eq
                           (lwcta-answer-ack contextual-answer)
                           (oac-node
                             (lwen-route-derivation identity-route)))) 1024 0))
    (let c12 (if (and (node_eq
                           (lwcta-answer-silent contextual-answer)
                           silent-candidate)
                          (eq (lwo-field-size
                               (lwcta-answer-alternatives
                                   contextual-answer)) 2)) 2048 0))
    (let c13 (if (and (eq (lwo-field-size
                               (lwt-proposal-participants
                                   contextual-proposal)) 5)
                          (eq (lwo-field-size
                               (lwo-emergent-witnesses
                                   contextual-candidate)) 10)) 4096 0))
    (let c14 (if (and (eq (lwo-active?
                               successful-world contextual-candidate) 1)
                          (and (eq (lwo-active?
                                    successful-world silent-candidate) 1)
                               (eq (oac-nothing?
                                    (lwen-answer-ack
                                        (lwo-emergent-shape
                                            silent-candidate))) 1))) 8192 0))
    (let c15 (if (and
                        (eq (lwctd-resolution-current?
                                stale-world resolution-candidate) 0)
                        (and
                            (eq (lwcta-current?
                                    stale-world contextual-candidate) 0)
                            (and (eq (lwo-world-has?
                                        (lwt-round-world stale-integration)
                                        contextual-candidate) 0)
                                 (eq (lwo-active?
                                        successful-world
                                        contextual-candidate) 1)))) 16384 0))
    (lwcttw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
