; ds4-quant-layout-band.fk — the DS4 quant layout table answers what it knows and says what it cannot yet
; compute. Pure arithmetic over the table's own rows: no file is read.
;
; Verdict 127 = 1 type 40 (MXFP4 plane) is 64 elements in 34 bytes
;             | 2 type 41 (MXFP8 plane) is 128 elements in 132 bytes
;             | 4 type 16 (IQ2_XXS) is 256 elements in 66 bytes
;             | 8 types 40 and 41 are arithmetic-ready
;             | 16 the reap25 row (1406 tensors, 45 of type 40, 370 of type 41) is layout-complete and execution-ready
;             | 32 a fully covered small row (6 tensors) is execution-ready
;             | 64 the refusals: an unknown layout is not complete, short arithmetic is not execution-ready,
;                  type 10 (Q2_K) is not arithmetic-ready
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/format-arith.fk form-stdlib/equireach-gguf.fk form-stdlib/ds4-quant-layout.fk

(do
    (let c0 (if (and (eq (dsql-block-elements 40) 64)
                     (eq (dsql-block-bytes 40) 34)) 1 0))
    (let c1 (if (and (eq (dsql-block-elements 41) 128)
                     (eq (dsql-block-bytes 41) 132)) 2 0))
    (let c2 (if (and (eq (dsql-block-elements 16) 256)
                     (eq (dsql-block-bytes 16) 66)) 4 0))
    (let c3 (if (and (eq (dsql-arithmetic-ready? 40) 1)
                     (eq (dsql-arithmetic-ready? 41) 1)) 8 0))
    (let layout-only (dsql-row 1406 1406 1406 0 45 370 91316062968))
    (let c4 (if (and (eq (dsql-layout-complete? layout-only) 1)
                     (eq (dsql-execution-ready? layout-only) 1)) 16 0))
    (let complete (dsql-row 6 6 6 0 0 0 42))
    (let c5 (if (eq (dsql-execution-ready? complete) 1) 32 0))
    ; the refusals: a row with an unknown layout is neither layout-complete nor execution-ready, a row
    ; whose arithmetic covers fewer tensors than it counts is not execution-ready, and a type the table
    ; does not carry (10, Q2_K: the IQ2XXS file's mix) is not arithmetic-ready
    (let unknown (dsql-row 6 5 6 1 0 0 42))
    (let short (dsql-row 6 6 5 0 0 0 42))
    (let c6 (if (and (eq (dsql-layout-complete? unknown) 0)
                 (and (eq (dsql-execution-ready? unknown) 0)
                  (and (eq (dsql-execution-ready? short) 0)
                       (eq (dsql-arithmetic-ready? 10) 0)))) 64 0))
    (sum (list c0 c1 c2 c3 c4 c5 c6)))
