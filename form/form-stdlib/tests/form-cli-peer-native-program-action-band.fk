; form-cli-peer-native-program-action-band.fk -- expected: 255
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-peer-native-dispatch.bml

(do
    (defn fcpnpab-bit (held weight) (if held weight 0))
    (defn form-cli-peer-native-program-action-band ()
        (do
            (let sentinel (list "not-a-model-session" 71))
            (let loaded (fcrnp-load (frpce-empty)))
            (let value (fcpn-run sentinel loaded "41"))
            (let none (fcpn-run sentinel loaded "0"))
            (let malformed (fcpn-run sentinel loaded "forty-one"))
            (add
                (fcpnpab-bit (and
                    (str_eq (fcpa-route value) "resident-native-program")
                    (value_eq (fcpa-session value) sentinel)) 1)
            (add
                (fcpnpab-bit (and (eq (fcpa-value-present? value) 1)
                    (eq (fcpa-value value) 42)) 2)
            (add
                (fcpnpab-bit (and (eq (fcpa-callback-calls value) 0)
                    (eq (fcpa-injected-bytes value) 0)) 4)
            (add
                (fcpnpab-bit (and
                    (str_eq (fcpa-carrier value)
                        "form-native-bml-bmf-resident-nodeid")
                    (str_eq (fcpa-response value)
                        "resident-native-program signal=value")) 8)
            (add
                (fcpnpab-bit (and (eq (fcpa-value-present? none) 1)
                    (nothing? (fcpa-value none))) 16)
            (add
                (fcpnpab-bit (and
                    (str_eq (fcpa-lifecycle none)
                        "resident-nodeid,call,return,observe,release")
                    (str_eq (fcpa-response none)
                        "resident-native-program signal=nothing")) 32)
            (add
                (fcpnpab-bit (and (value_eq (fcpa-session malformed) sentinel)
                    (str_eq (fcrnp-invocation-signal
                        (fcpa-cursor malformed)) "choice")) 64)
                (fcpnpab-bit (and (eq (fcpa-callback-calls malformed) 0)
                    (str_eq (fcpa-lifecycle malformed) "choice,release")) 128))))))))))
    (form-cli-peer-native-program-action-band))
