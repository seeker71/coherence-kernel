; preludes: form-stdlib/core.fk form-stdlib/form-cli-native-flow-contract.fk

(do
    (let current (fnfc-current-ds4-flow))
    (let native (fnfc-flow 1 1 0 0 0 0 0))
    (add
        (if (eq (fnfc-local-offline? current) 1) 1 0)
        (add
            (if (eq (fnfc-end-to-end-form-native? current) 0) 2 0)
            (if (eq (fnfc-end-to-end-form-native? native) 1) 4 0))))
