; care-floor-plain-words-band.fk — the care floor hears the plain ways people say it: "I want to end it all", "I took
; too many pills", "je veux en finir", "não quero mais viver", "quiero acabar con todo", "ich kann nicht atmen",
; "il a fait un AVC" — and stays quiet on the everyday lines that share their words. 7 bits -> 127.
; A gap in learn/native-turn-queue.jsonl: the native code lane is asked to turn it green.
; preludes: form-stdlib/bml/care-floor.bml
(do
    (defn cfp-bit (ok n) (if (eq ok 1) n 0))
    (let en (mul (cf-is "i want to end it all" "self-harm") (cf-is "i took too many pills" "medical")))
    (let de (cf-is "ich kann nicht atmen" "medical"))
    (let pt (cf-is "não quero mais viver" "self-harm"))
    (let fr (mul (cf-is "je veux en finir" "self-harm") (cf-is "il a fait un AVC" "medical")))
    (let es (cf-is "quiero acabar con todo" "self-harm"))
    (let before (if (eq (cf-self-check) 255) 1 0))
    (let quiet (cf-quiet (list "let's end it here for today" "the pills are in the kitchen cabinet" "quiero acabar el informe hoy" "on va finir le rapport ce soir" "ich kann nicht mehr warten")))
    (add (cfp-bit en 1) (add (cfp-bit de 2) (add (cfp-bit pt 4) (add (cfp-bit fr 8) (add (cfp-bit es 16) (add (cfp-bit before 32) (cfp-bit quiet 64))))))))
