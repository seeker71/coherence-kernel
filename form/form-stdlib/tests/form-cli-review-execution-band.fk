// Caller-bound execution: behavior, lazy branches, full-source refusal and errors.
// preludes: form-stdlib/bml/form-cli-review-execution.bml
section [form.bml] {
 class FormCliReviewExecutionBand {
  def freb-add(args) = fcre-ok(add(head(args),nth(args,1)));
  def freb-pair(args) = fcre-ok(args);
  def freb-absent(args) = fcre-ok(nothing());
  def freb-error(args) = fcre-no("observed-binding-failure");
  def freb-malformed(args) = 1;
  def freb-bindings() = list(list("add",2,freb-add),list("pair",2,freb-pair),list("absent",0,freb-absent),list("fail",0,freb-error),list("malformed",0,freb-malformed));
  def freb-run(source,args) = fcre-run(fcre-prepare(source,"candidate",2,freb-bindings()),args,freb-bindings());
  def freb-refused(source) = eq(head(fcre-prepare(source,"candidate",2,freb-bindings())),0);
  def freb-check() {
   let arithmetic = freb-run("def candidate(a,b) = add(a,b);",list(17,25));
   let values = freb-run("def candidate(a,b) = pair(a,\"kept\");",list(list(1,2),nothing()));
   let lazy = freb-run("def candidate(a,b) = if a then b else fail();",list(1,42));
   let failure = freb-run("def candidate(a,b) = if a then b else fail();",list(0,42));
   let absent = freb-run("def candidate(a,b) = absent();",list(0,0));
   let malformed = freb-run("def candidate(a,b) = malformed();",list(0,0));
   let bound = fcre-prepare("def candidate(a,b) = add(a,b);","candidate",2,freb-bindings());
   let rebound = fcre-run(bound,list(1,2),list(list("add",2,freb-pair)));
   let bits = list(
    if and(head(arithmetic),eq(nth(arithmetic,1),42)) then 1 else 0,
    if and(head(values),value_eq(nth(values,1),list(list(1,2),"kept"))) then 2 else 0,
    if and(head(lazy),eq(nth(lazy,1),42)) then 4 else 0,
    if and(not(head(failure)),str_eq(nth(failure,2),"observed-binding-failure")) then 8 else 0,
    if and(head(absent),nothing?(nth(absent,1))) then 16 else 0,
    if and(not(head(malformed)),str_eq(nth(malformed,2),"caller-binding-returned-malformed-result")) then 32 else 0,
    if freb-refused("def candidate(a,b) = a; def hidden() = 0;") then 64 else 0,
    if freb-refused("def candidate(a,b) = if a then b else host_exec(\"ignored\");") then 128 else 0,
    if freb-refused("def candidate(a,b) = unknown;") then 256 else 0,
    if freb-refused("def candidate(a,b) = candidate(a,b);") then 512 else 0,
    if freb-refused("def candidate(a,a) = a;") then 1024 else 0,
    if freb-refused("def other(a,b) = a;") then 2048 else 0,
    if freb-refused("def candidate(a,b) = add(a);") then 4096 else 0,
    if freb-refused("def candidate(a,b) = a(b);") then 8192 else 0,
    if freb-refused("def candidate(a,b) = if a then b;") then 16384 else 0,
    if and(not(head(rebound)),str_eq(nth(rebound,2),"proposal-binding-contract-changed")) then 32768 else 0);
   let verdict = sum(bits);
   print(list("review-execution",verdict,"full",65535,"bits",bits));
   if eq(verdict,65535) then verdict else form_error("review execution behavior failed");
  }
 }
 freb-check();
}
