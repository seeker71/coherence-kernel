import "../form-local-offline-health-map.fk"

(do
    (defn flohmb-bit (held weight) (if held weight 0))
    (let rows (list
        (flohm-organ "kernel" 1 5 5 20260825 "bootstrap/ground.fk" "rehearse" "ready")
        (flohm-organ "knowledge" 0 5 5 20260825 "receipts/baseline" "teach" "gap")
        (flohm-organ "backup" 0 3 2 20260825 "local-bundle" "persist" "gap")
        (flohm-organ "docs" (nothing) 2 2 20260825 "offline-docs" "observe" "unknown")))
    (let map (flohm-map 2026082501 rows))
    (let no-gap (flohm-map 2026082502 (list
        (flohm-organ "kernel" 1 5 5 20260825 "bootstrap/ground.fk" "rehearse" "ready"))))
    (let malformed (list "short" 0 5))
    (add
        (flohmb-bit (eq (flohm-valid-count map) 4) 1)
        (add (flohmb-bit (eq (flohm-ready-count map) 1) 2)
        (add (flohmb-bit (eq (flohm-gap-count map) 2) 4)
        (add (flohmb-bit (eq (flohm-unknown-count map) 1) 8)
        (add (flohmb-bit (eq (flohm-invalid-count map) 0) 16)
        (add (flohmb-bit (eq (flohm-health-permille map) 250) 32)
        (add (flohmb-bit (str_eq (flohm-priority-identity map) "knowledge") 64)
        (add (flohmb-bit (str_eq (flohm-priority-action map) "teach") 128)
        (add (flohmb-bit (str_eq (flohm-next-unknown map) "docs") 256)
        (add (flohmb-bit (nothing? (flohm-priority-identity no-gap)) 512)
             (flohmb-bit (eq (flohm-invalid-count
                (flohm-map 2026082503 (list malformed))) 1) 1024))))))))))))
