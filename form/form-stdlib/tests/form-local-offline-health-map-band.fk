import "../form-local-offline-health-map.fk"

(do
    (defn flohmb-bit (held weight) (if held weight 0))
    (let rows (list
        (flohm-organ "kernel" 1 5 5 20260825 "bootstrap/ground.fk" "rehearse" "ready")
        (flohm-organ "knowledge" 0 5 5 20260825 "receipts/baseline" "teach" "gap")
        (flohm-organ "backup" 0 3 2 20260825 "local-bundle" "persist" "gap")
        (flohm-organ "docs" (nothing) 2 2 20260825 "offline-docs" "observe" "unknown")))
    (let map (flohm-map 2026082501 rows))
    (let no-gap (flohm-map 2026082502 (list
        (flohm-organ "kernel" 1 5 5 20260825 "bootstrap/ground.fk" "rehearse" "ready"))))
    (let tied (flohm-map 2026082504 (list
        (flohm-organ "first-observed-gap" 0 5 5 20260825 "one" "ask-one" "gap")
        (flohm-organ "second-observed-gap" 0 5 5 20260825 "two" "ask-two" "gap")
        (flohm-organ "lesser-gap" 0 4 5 20260825 "three" "ask-three" "gap"))))
    (let malformed (list "short" 0 5))
    (sum (list
        (flohmb-bit (eq (flohm-valid-count map) 4) 1)
        (flohmb-bit (eq (flohm-ready-count map) 1) 2)
        (flohmb-bit (eq (flohm-gap-count map) 2) 4)
        (flohmb-bit (eq (flohm-unknown-count map) 1) 8)
        (flohmb-bit (eq (flohm-invalid-count map) 0) 16)
        (flohmb-bit (eq (flohm-health-permille map) 250) 32)
        (flohmb-bit (str_eq (flohm-priority-identity map) "knowledge") 64)
        (flohmb-bit (str_eq (flohm-priority-action map) "teach") 128)
        (flohmb-bit (str_eq (flohm-next-unknown map) "docs") 256)
        (flohmb-bit (nothing? (flohm-priority-identity no-gap)) 512)
        (flohmb-bit (eq (flohm-invalid-count
            (flohm-map 2026082503 (list malformed))) 1) 1024)
        (flohmb-bit (and (eq (flohm-priority-tie-count tied) 2)
                          (eq (flohm-priority-tie-count no-gap) 0)) 2048)
        (flohmb-bit
            (and (str_eq (nth (flohm-priority-identities tied) 0)
                         "first-observed-gap")
                 (str_eq (nth (flohm-priority-identities tied) 1)
                         "second-observed-gap")) 4096))))
