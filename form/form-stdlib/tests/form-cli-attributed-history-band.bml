// Source selection and loss boundaries, independent of generated answer quality.
// preludes: form-stdlib/bml/form-cli-comparison-review.bml
section [form.bml] {
 let domain = parse-json("retained",read_file("receipts/artifacts/2026-09-20-source-restored-provider-source.json"));
 let before = fcr-fresh-domain(fcr-scoped-domain(domain)); let after = fcr-attributed-domain(domain);
 let oldEvidence = json-object-get(before,"evidence"); let evidence = json-object-get(after,"evidence");
 let oldHistory = json-object-get(oldEvidence,"historical_author_observations"); let history = json-object-get(evidence,"historical_author_observations");
 let sections = node_children(json-object-get(history,"sections")); let encoded = json-emit(history);
 fcr-need(node_eq(json-object-get(before,"original_enquiry"),json-object-get(after,"original_enquiry")),"historical selection changed the enquiry");
 fcr-need(node_eq(oh-set(oldEvidence,"historical_author_observations",json-node-null()),oh-set(evidence,"historical_author_observations",json-node-null())),"historical selection changed other evidence");
 fcr-need(eq(len(sections),7),"historical section missing");
 fcr-need(str_eq(fcap-string(head(sections),"verbatim"),fcr-between(fcap-string(oldHistory,"text"),"## A seam the run opened","## What each answer could see")),"identity seam or its proposed status changed");
 fcr-need(str_eq(fcap-string(nth(sections,1),"verbatim"),fcr-between(fcap-string(oldHistory,"text"),"**Quality.**","**Volume.**")),"quality observation changed");
 fcr-need(and(lt(str_find(encoded,"648,411",0),0),and(lt(str_find(encoded,"44,495",0),0),lt(str_find(encoded,"7%",0),0))),"historical token quantities remain in the selected qualitative sections");
 fcr-need(str_eq(fcap-string(history,"source_sha256"),fcam-hash(fnc-guided-text())),"historical attribution lost its source identity");
 fcr-need(eq(len(node_children(json-object-get(history,"omitted_sections"))),5),"omitted coverage is hidden");
 fcr-need(node_eq(after,parse-json("roundtrip",json-emit(after))),"selected evidence changed on roundtrip");
 print_str("historical judgments retain verbatim attribution and source identity; old numeric prose is excluded with coverage explicit; current evidence unchanged");
 1;
}
