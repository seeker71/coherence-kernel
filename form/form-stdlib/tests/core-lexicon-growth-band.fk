; tests/core-lexicon-growth-band.fk — the seed asked what it can grow.
;
; preludes: form-stdlib/core-lexicon.fk form-stdlib/core-lexicon-growth.fk
;
; Verdict 4095 — twelve readings at POWERS OF TWO (a decimal-digit fold past
; the 15th reading rounds on the TypeScript arm; 2^53 is the wall).
;
; Every claim here is an UNFOLDING, not an admission. Nothing in this band can
; reject anything; the numbers are how far the body reaches from inside itself.
;
;   1     the seed's size: 64 words, 494 definition tokens
;   2     the hub is `is`, carrying in-degree 62 — used by 62 of the other 63
;   4     `thing` 25 and `self` 11: the seed leans on being, then on things,
;           then on selves, in that order
;   8     18 words sit on the RIM, reached by no other definition. The rim is
;           the growing edge, not a defect: nothing depends on those words, so
;           growth there disturbs nothing
;   16    unfolding from `nothing`, the ground word, reaches 30 of 64 — less
;           than half the body from its own floor
;   32    AND THE HUB IS NOT THE BEST ROOT: `is` reaches only 29, fewer than
;           `nothing`. The most depended-upon word is a poor place to start
;           from, which no in-degree count would ever have told us
;   64    the best single root reaches 39, and it is `kind`
;   128   NO word reaches all 64. The graph is not connected: cl-closed? has
;           been green for a long time, and closure was never connectivity
;   256   25 concepts are unreachable from ANY single starting word — to
;           arrive at them you must already know them
;   512   growth is positive and measured: the best rim companion opens 3 new
;           concepts, found by the body walking its own rim
;  1024   and the pair it chose is `kind` with `between` — category and
;           relation — reaching 42. Nobody typed that answer; clg-which-next
;           computes it by unfolding, so it moves when the vocabulary moves
;  2048   MONOTONE, which is this organ's whole character: across every rim
;           word, holding two roots never reaches less than holding one. A
;           gate's answer can go down. Growth's cannot. clg-gain returns 0 for
;           a companion that opens no ground — a number, never a rejection

(do
    ;; (1) the seed's size
    (let c1 (if (and (eq (cl-count) 64) (eq (cl-token-count) 494)) 1 0))

    ;; (2) the hub
    (let c2 (if (and (str_eq (clg-hub-word) "is") (eq (clg-hub-degree) 62)) 2 0))

    ;; (3) what it leans on next
    (let c3 (if (and (eq (clg-indeg "thing") 25) (eq (clg-indeg "self") 11)) 4 0))

    ;; (4) the rim — the free growing edge
    (let c4 (if (eq (clg-rim-count) 18) 8 0))

    ;; (5) from the ground word, less than half the body
    (let c5 (if (and (eq (clg-reach "nothing") 30) (lt (clg-reach "nothing") 32)) 16 0))

    ;; (6) the hub is a WORSE root than the ground — depended-upon is not
    ;; the same as generative, and only unfolding could show it
    (let c6 (if (and (eq (clg-reach "is") 29)
                     (lt (clg-reach "is") (clg-reach "nothing"))) 32 0))

    ;; (7) the best root
    (let c7 (if (and (eq (clg-max-reach) 39) (str_eq (clg-best-root-word) "kind")) 64 0))

    ;; (8) closure was never connectivity
    (let c8 (if (and (eq (clg-any-reaches-all?) 0) (eq (cl-closed?) 1)) 128 0))

    ;; (9) how much of itself the seed cannot reach
    (let c9 (if (eq (clg-unreached) 25) 256 0))

    ;; (10) growth is positive, and the body found it
    (let c10 (if (eq (clg-how-much-next) 3) 512 0))

    ;; (11) the pair it chose, and the reach it opens
    (let c11 (if (and (str_eq (clg-which-root) "kind")
                      (and (str_eq (clg-which-next) "between")
                           (eq (clg-two-root-reach) 42))) 1024 0))

    ;; (12) monotone — the organ cannot refuse
    (let c12 (if (and (eq (clg-monotone?) 1)
                      (ge (clg-gain "kind" "nothing") 0)) 2048 0))

    (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9
        (add c10 (add c11 c12))))))))))))
