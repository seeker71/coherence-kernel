(let LWRHR-PROPOSALS (lwrl-proposals LWRHA-WORLD 2))
(let LWRHR-FIRST-PROPOSAL
    (lwmpw-find-proposal LWRHR-PROPOSALS
        (lwrhw-relation-zeta) (lwrvw-left) (lwmpw-third)))
(let LWRHR-SECOND-PROPOSAL
    (lwmpw-find-proposal LWRHR-PROPOSALS
        (lwrhw-relation-zeta) (lwmpw-third) (lwrvw-right)))
(let LWRHR-FIRST-CANDIDATE
    (lwt-proposal-candidate LWRHR-FIRST-PROPOSAL))
(let LWRHR-SECOND-CANDIDATE
    (lwt-proposal-candidate LWRHR-SECOND-PROPOSAL))
(let LWRHR-ROUND
    (lwt-round LWRHA-WORLD LWRHR-PROPOSALS
        (lwo-empty-field) (lwrhw-integrated-round)))
