// Public regression data; no model admission or living-state writes.
// Reusing a reference is not evidence of a decoding loop.
// preludes: form-stdlib/native-llama-voice.bml observe/bidirectional-framebuffer-channel.fk
section [form.bml] {
 class NativeVoiceRepeatBand {
  def nvrb-repeat(s,n) = if le(n,0) then "" else str_concat(s,nvrb-repeat(s,sub(n,1)));
  def nvrb-prefixes(s,i) = if gt(i,str_len(s)) then 1 else and(eq(nlg-stuck(substring(s,0,i),""),0),nvrb-prefixes(s,add(i,1)));
  def nvrb-reference() = "The configuration file sets the port. The configuration file also sets the host.";
  // Longer than the short window can hold twice, so only the paragraph reading sees it.
  def nvrb-paragraph() = "The first sentence names the door that was opened this morning. The second sentence says which cell answered and what it read. The third sentence records the measurement taken on this machine, with its unit. The fourth sentence closes the paragraph and hands the reading to the next hand. ";
  def nvrb-all(rows) = if nil?(rows) then 1 else and(nth(head(rows),1),nvrb-all(tail(rows)));
  def nvrb-rows() {
   let run = "echo echo echo echo ";
   let same = "This exact sentence is being repeated. ";
   let special = noi-put(noi-put(list(),"<|eot_id|>",128009),"<|end_of_text|>",128001);
   let echo = str_concat("echo",nlt-symbol(32));
   let decoder = noi-put(noi-put(noi-put(list(),md-le32(1),echo),md-le32(2),"finished."),md-le32(3),str_concat(echo,echo));
   let tk = list(list(),decoder,list(),special,list(),"fixture",list());
   list(
    list("empty",eq(nlg-stuck("",""),0)),
    list("short",eq(nlg-stuck("Hello","."),0)),
    list("reference-reuse",eq(nlg-stuck(nvrb-reference(),""),0)),
    list("filename-reuse",eq(nlg-stuck("Read settings.json to learn the port. ","Update settings.json to set the host."),0)),
    list("shared-frame-new-content",eq(nlg-stuck("The first gift to ourselves is the gift of self-awareness. ","The first gift to our children is the gift of self-discipline."),0)),
    list("long-reference",eq(nlg-stuck("Read /workspace/configuration/settings.json first. ","Then update /workspace/configuration/settings.json"),0)),
    list("portuguese-reference",eq(nlg-stuck("A configuração define a porta. ","A configuração também define o servidor."),0)),
    list("han-reference",eq(nlg-stuck("配置文件设置端口。","配置文件也设置主机。"),0)),
    list("all-emitted-prefixes",nvrb-prefixes(nvrb-reference(),0)),
    list("short-period-loop",eq(nlg-stuck(run,"echo "),1)),
    list("one-byte-loop",eq(nlg-stuck(nvrb-repeat("!",23),"!"),1)),
    list("long-block-loop",eq(nlg-stuck("aaaaaaaabbbbbbbbcccccccc","aaaaaaaabbbbbbbbcccccccc"),1)),
    list("sentence-loop",eq(nlg-stuck(same,same),1)),
    list("ascii-case-loop",eq(nlg-stuck(same,"THIS EXACT SENTENCE IS BEING REPEATED. "),1)),
    list("utf8-loop",eq(nlg-stuck(nvrb-repeat("好",8),""),1)),
    list("formatting-space",eq(nlg-stuck(nvrb-repeat(" ",64),""),0)),
    list("formatting-lines",eq(nlg-stuck(nvrb-repeat("\n\t",32),""),0)),
    list("two-short-mentions",eq(nlg-stuck("echo ","echo "),0)),
    list("old-repeat-is-not-current",eq(nlg-stuck(str_concat(nvrb-repeat("echo ",8),"The loop is over; this is distinct new content."),""),0)),
    list("wrapped-sentence-loop",eq(nlg-stuck("It keeps saying the same words again.\n","It keeps saying\nthe same words again. "),1)),
    list("paragraph-loop",eq(nlg-stuck(nvrb-paragraph(),nvrb-paragraph()),1)),
    list("paragraph-once",eq(nlg-stuck(nvrb-paragraph(),"A new paragraph begins here and says something else entirely."),0)),
    list("second-choice",value_eq(nlg-pick(run,"echo ","finished.",1,2),list(2,"adapted-choice"))),
    list("third-choice",value_eq(nlg-pick3(run,"echo ","echo echo ","finished.",1,3,2),list(2,"adapted-choice"))),
    list("all-looping",value_eq(nlg-pick3(run,"echo ","echo echo ","echo echo echo ",1,3,4),list(-1,"adapted-repeat"))),
    list("native-decoded-choice",value_eq(nlg-pick-id(tk,run,1,3,2),list(2,"adapted-choice"))),
    list("eos-keeps-meaning",value_eq(nlg-pick-id(tk,run,128009,1,2),list(128009,"")))
   );
  }
  def nvrb-run() {
   let rows = nvrb-rows(); let out = bfc-envelope(0,17890312,0,list(len(rows),nvrb-all(rows)),-1);
   let sent = bfc-record-out(out,0); let control = bfc-control(out,5);
   let received = bfc-record-in(control,1);
   let replay = bfc-apply(out,control,list(),nvrb-rows());
   let shown = print(replay);
   let after = bfc-record-out(bfc-envelope(0,bfc-exchange(out),0,list(len(replay),nvrb-all(replay)),-1),2);
   if and(nvrb-all(rows),nvrb-all(replay)) then 16777215 else form_error("native repetition behavior refused");
  }
 }
}
