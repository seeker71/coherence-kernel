; form-cli-peer-alias-action-cursor-band.fk -- pure scannerless action grammar.
;
; Verdict 127:
;   1 dynamically resolved task alias remains caller-born
;   2 response carries an explicit BML action verb and alias
;   4 split decoded chunks reach the exact action without tokenizer boundaries
;   8 the retained cursor window is bounded to the expected grammar extent
;   16 absence, ambiguity and wrong task kind do not make an action surface
;   32 a held partial action becomes typed timeout, not an inferred callback
;   64 this witness opens neither model, carrier nor filesystem effect
;
; preludes: form-stdlib/form-cli-peer-alias-action-cursor.fk

(do
    (defn fcpaacb-bit (ok bit) (if ok bit 0))
    (let frame "<|form:repo-patch|>held<|/form:repo-patch|>")
    (let task (fcpa-task-ref "repo-patch" frame))
    (let action (fcpa-action-ref "emit-exact-frame"))
    (let registry (fcpa-alias-registry (list
        (fcpa-alias-binding "p" task))))
    (let ctx (fcpaac-context (list "opaque-patch-context") registry "p" action))
    (let expected (fcpaac-surface ctx))
    (let partial (fcpaac-stream-window expected "" "before (agent-act emit-"))
    (let complete (fcpaac-stream-window expected partial "exact-frame p)"))
    (let absent (fcpaac-context (list "opaque-patch-context") registry "q" action))
    (let ambiguous (fcpaac-context (list "opaque-patch-context")
        (fcpa-alias-registry (list (fcpa-alias-binding "p" task)
            (fcpa-alias-binding "p" (fcpa-task-ref "repo-patch" "other"))))
        "p" action))
    (let wrong-kind (fcpaac-context (list "opaque-patch-context")
        (fcpa-alias-registry (list
            (fcpa-alias-binding "p" (fcpa-task-ref "research" "held"))))
        "p" action))
    (let held (fcpaac-cursor "(agent-act emit-" "held" "open"
        0 0 0 17 2 (nothing) ""))
    (let timed (fcpaac-timeout held))
    (sum (list
        (fcpaacb-bit (and (eq (fcpaac-ready? ctx) 1)
            (and (str_eq (fcpa-alias-resolution-status
                        (fcpaac-resolution ctx)) "value")
                 (node_eq (fcpa-alias-resolution-target
                     (fcpaac-resolution ctx)) task))) 1)
        (fcpaacb-bit (str_eq expected "(agent-act emit-exact-frame p)") 2)
        (fcpaacb-bit (and (str_eq (fcpaac-scan expected partial) "held")
                         (str_eq (fcpaac-scan expected complete) "complete")) 4)
        (fcpaacb-bit (and (le (str_len complete) (str_len expected))
            (str_eq complete expected)) 8)
        (fcpaacb-bit (and (eq (fcpaac-ready? absent) 0)
            (and (eq (fcpaac-ready? ambiguous) 0)
            (and (eq (fcpaac-ready? wrong-kind) 0)
            (and (str_eq (fcpaac-surface absent) "")
            (and (str_eq (fcpaac-surface ambiguous) "")
                 (str_eq (fcpaac-surface wrong-kind) "")))))) 16)
        (fcpaacb-bit (and (str_eq (farp-cursor-terminal timed) "timeout")
            (and (eq (farp-cursor-callbacks timed) 0)
                 (str_eq (farp-status (farp-cursor-result timed)) "timeout"))) 32)
        (fcpaacb-bit 1 64))))
