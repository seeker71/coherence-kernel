; form-cli-offer-ask-bml-band.fk — generic Offer<T>, generated catalog,
; living body lookup (kra then corpus).
;
; Verdict 65535:
;   1..128  foa-check (unknown, unasked nothing, ask q-3, ask q-0,
;                     catalog-8 agrees, cost outside, n=8, catalog-16)
;   256     class descriptor FormOfferAsk minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;   1024    body unknown is nothing
;   2048    body ground offer without ask replies nothing
;   4096    body ask bootstrap/ground replies 42
;   8192    body ask restanswer replies the corpus word
;   16384   body unknown corpus is nothing
;   32768   body ground payload is a rest pointer, not a forced value
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/knowledge-rest-answer.fk
; preludes: form-stdlib/form-cli-offer-ask-xtal.fk
; witnessed: 2026-08-30 -> 65535

(do
    (defn foab-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn foab-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (foab-has-name? (tail xs) name))))

    (let bits (foa-check))
    (let desc (FormOfferAsk))
    (let src (read_file "form/form-stdlib/bml/form-cli-offer-ask.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormOfferAsk")
                     (and (eq (foab-has-name? (nth desc 2) "T") 1)
                          (and (eq (foab-has-name? (nth desc 3) "foa-body-lookup") 1)
                               (eq (foab-has-name? (nth desc 4) "DelayOffer") 1))))
                256 0))
    (let b9 (if (and (eq (foab-has-str? src "package Form.cli.offerask") 1)
                     (and (eq (foab-has-str? src "interface IAsk") 1)
                          (and (eq (foab-has-str? src "class FormOfferAsk") 1)
                               (and (eq (foab-has-str? src "const int MixA") 1)
                                    (eq (foab-has-str? src "template Offer") 1)))))
                512 0))
    (let live (mul (foa-live-check) 1024))
    (add bits (add b8 (add b9 live))))
