; living-world-scoped-projection-band.fk -- local views preserve old history.
; Verdict 32767 proves fifteen projection, identity, and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk form-stdlib/living-world-contextual-species.fk form-stdlib/living-world-tissue-prediction.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk form-stdlib/tests/living-world-parameter-tissue-witness.fk form-stdlib/tests/living-world-scoped-projection-witness.fk

(do
    (let history (lwptw-build-history))
    (let old-world (lwptw-history-world history))
    (let p-trial (lwtnw-trial-candidate (lwptw-history-p history)))
    (let q-trial (lwtnw-trial-candidate (lwptw-history-q history)))
    (let world (lwscp-world history))
    (let bindings (lwscp-bindings))
    (let trace (lwscp-trace world))
    (let naive (lwscp-naive-world world))
    (let moved (lwscp-moved-world world))
    (let moved-trace (lwscp-trace moved))
    (let invalid
        (lwre-projection (lwo-none) (lwscp-origin)
            (intern_trivial_int 1) (lwo-empty-field)
            (lwo-none) (lwscp-evidence)))

    (let c1
        (if (and (eq (lwre-projection-valid?
                         (lwscp-origin-projection)) 1)
                 (eq (lwre-projection-valid?
                         (lwscp-field-projection)) 1)) 1 0))
    (let c2
        (if (and (eq (lwre-projection-current?
                         world (lwscp-origin-projection)) 1)
                 (eq (lwre-projection-current?
                         world (lwscp-field-projection)) 1)) 2 0))
    (let c3
        (if (and (eq (lwre-binding-valid?
                         (lwscp-origin-binding)) 1)
                 (and (eq (lwre-binding-valid?
                              (lwscp-field-binding)) 1)
                      (eq (lwre-bindings-current? world bindings) 1))) 4 0))
    (let c4
        (if (and (node_eq
                    (lwre-binding-value (lwscp-origin-binding))
                    (intern_trivial_int 1))
                 (and (node_eq
                        (lwre-binding-value (lwscp-field-binding))
                        (intern_trivial_int 3))
                      (node_eq
                        (lwre-binding-projection (lwscp-field-binding))
                        (lwscp-field-projection)))) 8 0))
    (let c5
        (if (and (node_eq
                    (lwre-result-primary (lwre-trace-result trace))
                    (intern_trivial_int 4))
                 (node_eq (lwre-trace-bindings trace) bindings)) 16 0))
    (let c6
        (if (and (eq (lwre-trace-current? world trace) 1)
                 (eq (lwre-bindings-current? world bindings) 1)) 32 0))
    (let c7
        (if (and (eq (lwbs-historical-trial-valid?
                         old-world p-trial) 1)
                 (eq (lwbs-historical-trial-valid?
                         old-world q-trial) 1)) 64 0))
    (let c8
        (if (and (eq (lwbs-historical-trial-valid?
                         world p-trial) 1)
                 (eq (lwbs-historical-trial-valid?
                         world q-trial) 1)) 128 0))
    (let c9
        (if (and (eq (lwo-active? world (intern_trivial_int 3)) 1)
                 (eq (lwo-active-by? world (intern_trivial_int 3)
                         (lwscp-source-a)) 0)) 256 0))
    (let c10
        (if (and (eq (lwbs-historical-trial-valid?
                         naive p-trial) 0)
                 (eq (lwbs-historical-trial-valid?
                         naive q-trial) 0)) 512 0))
    (let c11
        (if (and (eq (lwre-trace-current? naive trace) 1)
                 (eq (lwre-bindings-current? naive bindings) 1)) 1024 0))
    (let c12
        (if (and (eq (lwre-trace-current? moved trace) 0)
                 (and (eq (lwre-bindings-current? moved bindings) 1)
                      (not (node_eq moved-trace trace)))) 2048 0))
    (let c13
        (if (and (eq (lwre-trace-current? moved moved-trace) 1)
                 (node_eq
                    (lwre-result-primary (lwre-trace-result moved-trace))
                    (intern_trivial_int 4))) 4096 0))
    (let c14
        (if (and (eq (lwre-projection-valid? invalid) 0)
                 (and (eq (lwo-field-size
                              (lwre-projection-alternatives
                                (lwscp-origin-projection))) 1)
                      (eq (lwlc-unknown?
                              (lwre-projection-unknown
                                (lwscp-origin-projection))) 1))) 8192 0))
    (let c15
        (if (and (not (node_eq
                         (lwscp-origin-projection)
                         (lwscp-field-projection)))
                 (and (not (node_eq
                              (lwscp-origin-binding)
                              (lwscp-field-binding)))
                      (eq (lwre-unbound-contract?
                              (lwre-recipe-contract
                                (lwptw-recipe-p))) 0))) 16384 0))
    (add c1 (add c2 (add c3 (add c4 (add c5
      (add c6 (add c7 (add c8 (add c9 (add c10
        (add c11 (add c12 (add c13 (add c14 c15)))))))))))))))
