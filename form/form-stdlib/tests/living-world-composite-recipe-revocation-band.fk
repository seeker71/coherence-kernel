; living-world-composite-recipe-revocation-band.fk -- one withdrawn source
; stales only the dependent composite while preserving inspectable history.
; Verdict 32767 proves fifteen revocation, continuity, and authority claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk form-stdlib/living-world-operation-field.fk form-stdlib/living-world-composite-recipe.fk form-stdlib/living-world-composite-answer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-structural-recipe-witness.fk form-stdlib/tests/living-world-operation-field-witness.fk form-stdlib/tests/living-world-composite-recipe-witness.fk

(defn lwoecrb-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwoecrb-sum (tail items)))))

(do
    (let evolved (lwoew-build-evolved))
    (let schema (lwoew-base-schema (lwoew-evolved-base evolved)))
    (let component (lwoew-evolved-candidate evolved))
    (let blueprint (lwoecw-blueprint component schema))
    (let example (lwoecw-example component schema))
    (let world (lwoecw-blueprint-world evolved))
    (let proposal (lwoec-proposal world blueprint 2))
    (let candidate (lwt-proposal-candidate proposal))
    (let integrated
        (lwoec-integrate
            (lwphw-answered-round world proposal
                (lwoew-evolved-round evolved))
            proposal (lwphw-action)))
    (let integrated-world (lwt-round-world integrated))
    (let revocation
        (lwo-revocation example (lwoecw-source-r)
            (lwoecw-reason) (lwoecw-prov-r)))
    (let revoked
        (lwt-receive-stream integrated-world
            (list (lwoecw-entry-r revocation))))
    (let active-attributions
        (lwo-active-attributions-for revoked example))

    (let c1
        (if (eq (lwoec-candidate-current? revoked candidate) 0) 1 0))
    (let c2
        (if (eq (lwoe-candidate-current? revoked component) 1) 2 0))
    (let c3
        (if (eq (lwo-active? revoked candidate) 1) 4 0))
    (let c4
        (if (eq (lwo-active? revoked component) 1) 8 0))
    (let c5
        (if (eq (lwo-active? revoked example) 1) 16 0))
    (let c6
        (if (eq (lwph-active-source-count revoked example) 1) 32 0))
    (let c7
        (if (node_eq (lwoec-proposal revoked blueprint 2)
                     (lwo-none)) 64 0))
    (let c8
        (if (and (eq (lwo-active? revoked blueprint) 1)
                 (eq (lwph-active-source-count revoked blueprint) 2)) 128 0))
    (let c9
        (if (and (eq (lwo-owned-by? revoked example
                         (lwoecw-source-r)) 1)
                 (eq (lwo-attribution-revoked? revoked example
                         (lwoecw-source-r)) 1)) 256 0))
    (let c10
        (if (and (eq (lwo-active-by? revoked example
                         (lwoecw-source-r)) 0)
                 (eq (lwo-active-by? revoked example
                         (lwoecw-source-q)) 1)) 512 0))
    (let c11
        (if (eq (lwo-field-size active-attributions) 1) 1024 0))
    (let c12
        (if (and (eq (lwo-field-size
                         (lwo-world-revocations revoked)) 1)
                 (eq (lwo-revocation? revocation) 1)) 2048 0))
    (let c13
        (if (and (node_eq (lwo-revocation-target revocation) example)
                 (node_eq (lwo-revocation-source revocation)
                          (lwoecw-source-r))) 4096 0))
    (let c14
        (if (and (eq (lwo-field-size
                         (lwt-round-outcomes integrated)) 1)
                 (and (eq (lwo-field-has?
                              (lwo-world-revocations revoked)
                              revocation) 1)
                      (node_eq
                          (lwt-proposal-candidate
                              (lwt-outcome-proposal
                                  (head (lwo-field-items
                                      (lwt-round-outcomes integrated)))))
                          candidate))) 8192 0))
    (let c15
        (if (and (eq (lwoec-integrated-current? revoked candidate) 0)
                 (eq (lwoe-integrated-current? revoked component) 1))
            16384 0))
    (lwoecrb-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
