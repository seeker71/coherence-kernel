; table-band.fk — the table engine walks generically: fn-values in,
; carried args replacing closures, one recursion per shape.
; Bits 256-1024: rows may be STRINGS. `len` of a string is its byte length
; four-way (fkwu read 0 there until 2026-09-04 — R70), and tb-any2? walks its
; own recursion instead of measuring the found row, so a row that IS "" or an
; empty list is still found.
; Expected: 2047
; preludes: form-stdlib/table.bml
(do
    (defn tbb-bit (ok bit) (if ok bit 0))
    (defn tbb-first-is (row a) (if (str_eq (nth row 0) a) 1 0))
    (defn tbb-str-is (row a) (if (str_eq row a) 1 0))
    (defn tbb-sum2 (acc row) (add acc (nth row 1)))
    (defn tbb-snd (row) (nth row 1))
    (defn tbb-name (row) (nth row 0))
    (let rows (list (list "a" 3) (list "b" 9) (list "c" 5)))
    (sum (list
        (tbb-bit (str_eq (nth (tb-find2 rows tbb-first-is "b") 0) "b") 1)
        (tbb-bit (eq (len (tb-find2 rows tbb-first-is "zz")) 0) 2)
        (tbb-bit (eq (tb-any2? rows tbb-first-is "c") 1) 4)
        (tbb-bit (eq (len (tb-filter2 rows tbb-first-is "a")) 1) 8)
        (tbb-bit (eq (tb-fold rows tbb-sum2 0) 17) 16)
        (tbb-bit (eq (nth (tb-max-by rows tbb-snd) 1) 9) 32)
        (tbb-bit (str_eq (tb-join rows tbb-name ",") "a,b,c") 64)
        (tbb-bit (eq (nth (tb-map rows tbb-snd) 2) 5) 128)
        (tbb-bit (eq (len "abc") 3) 256)
        (tbb-bit (eq (tb-any2? (list "a" "b") tbb-str-is "b") 1) 512)
        (tbb-bit (eq (tb-any2? (list "" "x") tbb-str-is "") 1) 1024))))
