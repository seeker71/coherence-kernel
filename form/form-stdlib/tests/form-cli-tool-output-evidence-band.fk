; Typed custom-tool input and structured output blocks. Expected: 65535.
; Pure fixtures; no live spool writes or private carrier content.
; preludes: form-stdlib/form-cli-turn-evidence-live.fk

(do
    (defn fctob-bit (ok bit) (if ok bit 0))
    (defn fctob-block (text)
        (str_concat "{\"type\":\"input_text\",\"text\":"
            (str_concat (json-quote-string text) "}")))
    (defn fctob-result (output)
        (str_concat "{\"chunk_id\":\"fixture\",\"wall_time_seconds\":0.1,\"exit_code\":0,\"output\":"
            (str_concat (json-quote-string output) "}")))
    (defn fctob-output (value)
        (str_concat "{\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call_output\",\"call_id\":\"c1\",\"output\":"
            (str_concat value "}}")))
    (defn fctob-fill (text n)
        (if (ge (str_len text) n) text
            (fctob-fill (str_concat text text) n)))
    (let call "{\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call\",\"name\":\"exec\",\"call_id\":\"c1\",\"input\":\"text(await tools.exec_command({cmd: 'form-run ./fkwu witness.fk'}));\"}}")
    (let native (fctob-result "example @form fkwu 0 999 0 999\nreal\n@form fkwu 0 5 0 5\n"))
    (let local (fctob-result (str_concat (fctob-fill "x" 2048)
        "\n@form rg 0 7 0 7\n")))
    (let blocks (fctel-join (list "[" (fctob-block "Script completed") ","
        (fctob-block native) "," (fctob-block local) "]")))
    (let output (fctob-output blocks))
    (let pending (fctel-process-line (fctel-state) call))
    (let measured (fctel-process-line pending output))
    (let ranged (fctel-process-segment
        (str_concat call (str_concat "\n" output)) 0 (fctel-state)))
    (let unknown (fctob-output "null"))
    (let unknown-state (fctel-process-line pending unknown))
    (let sticky (fctel-process-line unknown-state output))
    (let untrusted (fctob-output (str_concat "["
        (str_concat (fctob-block "@form fkwu 0 99 0 99\n") "]"))))
    (let decoy (fctob-output (str_concat "["
        (str_concat (fctob-block "{\"output\":\"@form fkwu 0 99 0 99\\n\"}") "]"))))
    (let malformed (fcto-receipt "@form fkwu 0 nope 0 0\n"))
    (let continuation "{\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call\",\"name\":\"exec\",\"call_id\":\"c1\",\"input\":\"text(await tools.write_stdin({session_id: 12, chars: ''}));\"}}")
    (let quoted "{\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call\",\"name\":\"read\",\"call_id\":\"c1\",\"metadata\":{\"input\":\"form-run ./fkwu\"},\"input\":\"plain\"}}")
    (sum (list
        (fctob-bit (eq (nth (head (nth pending 20)) 1) 2) 1)
        (fctob-bit (eq (nth measured 11) 2) 2)
        (fctob-bit (eq (nth measured 16) 1) 4)
        (fctob-bit (eq (nth measured 18) 1) 8)
        (fctob-bit (eq (nth measured 13) 12) 16)
        (fctob-bit (eq (nth measured 10) (str_len blocks)) 32)
        (fctob-bit (and (eq (nth measured 7) 1)
            (and (eq (nth measured 8) 1) (eq (len (nth measured 20)) 0))) 64)
        (fctob-bit (and (eq (nth ranged 11) 2)
            (and (eq (nth ranged 10) (nth measured 10))
                (eq (nth ranged 13) 12))) 128)
        (fctob-bit (eq (nth unknown-state 10) -1) 256)
        (fctob-bit (eq (nth sticky 10) -1) 512)
        (fctob-bit (eq (nth (fctel-process-line pending untrusted) 16) 0) 1024)
        (fctob-bit (eq (nth (fctel-process-line pending decoy) 16) 0) 2048)
        (fctob-bit (and (eq (nth malformed 0) -1)
            (and (eq (nth (fcto-receipt "@form fkwu 0 9 0 8\n") 0) -1)
                (eq (nth (fcto-executor-result
                    (fctob-result "@form fkwu 1 0 9 9\n")) 0) -1))) 4096)
        (fctob-bit (eq (fcto-request continuation 0) 2) 8192)
        (fctob-bit (eq (fcto-request quoted 0) 0) 16384)
        (fctob-bit (eq (nth (fcto-receipt
            "@form fkwu 0 9 0 9\nnot a final receipt\n") 1) 0) 32768))))
