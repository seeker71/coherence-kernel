; qwen35-tokfast-band.fk — EXPENSIVE CANDIDATE witness for whether the frozen
; tokenizer recording answers exactly what the reference scan answers.
;
; Do not include this artifact-backed band in broad preflight loops. A native
; attempt on 2026-08-24 remained at full CPU for 24m19s without reaching a
; verdict and was bounded. The current monolithic str_find design is not wired
; into generation; fixed-width sorted rows / cursor-native lookup are owed.
;
; Target verdict 63 (not yet observed):
;   1   tokfast file present and keyed to the live seal
;   2   "Reply with exactly: LOCAL FORM ALIVE" — ids equal
;   4   "[form] lower_status=ok rules=4 top=d probe=ab match_verdict=1" — ids equal
;   8   "grammar { rule a { lit a } }\n  probe 1+2" — ids equal
;   16  "user\n" — ids equal (a crystal scaffold, re-derived here)
;   32  the fast path is not accidentally the slow one: 100x re-encode of the
;       short string stays under the time ONE reference encode of it took
;
; preludes: form-stdlib/qwen35-tokfast.fk

(do
    (defn tfb-ids-eq (as bs)
        (if (eq (len as) 0) (if (eq (len bs) 0) 1 0)
            (if (eq (len bs) 0) 0
                (if (eq (head as) (head bs)) (tfb-ids-eq (tail as) (tail bs)) 0))))
    (defn tfb-rep (tf s n) (if (le n 0) 0 (do (let x (qtf-encode tf s)) (tfb-rep tf s (sub n 1)))))
    (let path "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (let tf (qtf-load path))
    (let src (eqr-of-file path 0 40000000))
    (let s1 "Reply with exactly: LOCAL FORM ALIVE")
    (let s2 "[form] lower_status=ok rules=4 top=d probe=ab match_verdict=1")
    (let s3 "grammar { rule a { lit a } }\n  probe 1+2")
    (let s4 "user\n")
    (let hb0 (print "[band] reference encode 1 of 4...\n"))
    (let t0 (now_unix_ms))
    (let r1 (q35-encode src s1))
    (let t1 (now_unix_ms))
    (let f1 (qtf-encode tf s1))
    (let hb1 (print "[band] reference encode 2 of 4...\n"))
    (let r2 (q35-encode src s2)) (let f2 (qtf-encode tf s2))
    (let hb2 (print "[band] reference encode 3 of 4...\n"))
    (let r3 (q35-encode src s3)) (let f3 (qtf-encode tf s3))
    (let hb3 (print "[band] reference encode 4 of 4...\n"))
    (let r4 (q35-encode src s4)) (let f4 (qtf-encode tf s4))
    (let hb4 (print "[band] fast rep x100...\n"))
    (let t2 (now_unix_ms))
    (let reps (tfb-rep tf s1 100))
    (let t3 (now_unix_ms))
    (add (if (eq (nth tf 0) 1) 1 0)
    (add (if (eq (tfb-ids-eq r1 f1) 1) 2 0)
    (add (if (eq (tfb-ids-eq r2 f2) 1) 4 0)
    (add (if (eq (tfb-ids-eq r3 f3) 1) 8 0)
    (add (if (eq (tfb-ids-eq r4 f4) 1) 16 0)
         (if (lt (sub t3 t2) (sub t1 t0)) 32 0)))))))
