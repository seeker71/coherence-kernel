// gpu-window-sleeper.fk — a stand-in for a Metal peer, spawned by gpu-window-band. It touches no device.
//
// It beats: every 30 ms it writes its beat count to a file, so a stopped process is a count that stops and a resumed one is a count that
// moves (the host's process rows carry no run state). The band cannot pass arguments to a cell: after the spawn it writes the beat file's
// path to .hearth/window-probe/req-<this pid>. The beat stops when <beat file>.stop exists, or after 2000 beats.
// The command line of this process names gpu-window-sleeper, which is what the lease's reading of the process table matches.
//
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk
section [form.bml] {
  def gws-dir() = ".hearth/window-probe";
  def gws-req(pid) = gws-dir() ++ "/req-" ++ pid.str();
  def gws-wait(path, n) {
   let t = read_file(path);
   (nothing?(t) && (n > 0)) ? gws-wait-again(path, n) : t;
  }
  def gws-wait-again(path, n) {
   let s = host_sleep_ms(10);
   gws-wait(path, n - 1);
  }
  def gws-beat(path, i) {
   let w = write_file_text(path, i.str());
   let s = host_sleep_ms(30);
   (Comparable) host_path_exists(path ++ ".stop") == 1 ? i : (i >= 2000 ? i : gws-beat(path, i + 1));
  }
  gws-beat(trim(gws-wait(gws-req(host_pid()), 1000) ?? ""), 0);
}
