; cell-coordinate-dag-stream-band.fk -- recurrence crosses once by identity.
; Verdict 32767 proves fifteen DAG, recurrence, option, and legacy claims.
; preludes: form-stdlib/core.fk form-stdlib/cell-coordinate-stream.fk

(defn ccsdb-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (ccsdb-sum (tail items)))))

(do
    (let leaf (intern_trivial_int 7))
    (let shared
        (intern_node (bp "CCSDB-SHARED") (list leaf leaf)))
    (let unknown
        (intern_node (bp "CCSDB-UNKNOWN") (empty)))
    (let alternative
        (intern_node (bp "CCSDB-ALTERNATIVE") (list leaf)))
    (let root
        (intern_node (bp "CCSDB-ROOT")
            (list shared shared unknown alternative shared shared)))
    (let dag-nodes (ccs-dag-nodes root))
    (let dag-text (ccs-emit root))
    (let tree-text (ccs-tree-emit root))
    (let restored (ccs-decode dag-text))
    (let restored-items (node_children restored))
    (ccsdb-sum
        (list
            (if (eq (ccs-supported? root) 1) 1 0)
            (if (eq (str_byte_at dag-text 0) 100) 2 0)
            (if (eq (len dag-nodes) 5) 4 0)
            (if (node_eq restored root) 8 0)
            (if (node_eq (nth restored-items 0)
                         (nth restored-items 1)) 16 0)
            (if (node_eq (nth restored-items 0)
                         (nth restored-items 4)) 32 0)
            (if (node_eq (nth restored-items 2) unknown) 64 0)
            (if (node_eq (nth restored-items 3) alternative) 128 0)
            (if (not (node_eq (nth restored-items 2)
                              (nth restored-items 3))) 256 0)
            (if (lt (str_len dag-text) (str_len tree-text)) 512 0)
            (if (eq (ccs-decoded-size dag-text)
                    (str_len dag-text)) 1024 0)
            (if (eq (ccs-canonical? dag-text) 1) 2048 0)
            (if (node_eq (ccs-decode tree-text) root) 4096 0)
            (if (eq (ccs-canonical? tree-text) 1) 8192 0)
            (if (str_eq (ccs-emit restored) dag-text) 16384 0))))
