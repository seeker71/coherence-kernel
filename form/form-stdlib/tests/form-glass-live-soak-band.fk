; form-glass-live-soak-band.fk — identical-state observer-churn proof.
;
; preludes: form-stdlib/form-glass-live.bml
; Verdict 63: local self composition, external filtering, no self publisher,
; stable projection, and bounded identical-state string interning.

(do
    (defn fglsb-bit (held weight) (if (eq held 1) weight 0))
    (defn fglsb-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))
    (defn fglsb-soak (remaining metrics samples publishers prior)
        (if (le remaining 0)
            prior
            (fglsb-soak (sub remaining 1) metrics samples publishers
                (fgl-projection 80 24 1000 "all" metrics samples publishers "held"))))

    (let model (fgtm-sample "model.fixture" (fgtm-absent) "model" "metal"
        "model.fixture" "reason" "soak" (fgtm-present 1024) (fgtm-present 4096)
        "ready" (fgtm-present 1000) (fgtm-present 1000) (fgtm-present 1)
        (fgtm-present 7) "never" "physical-live" "fixture.owner"
        (list "memory" "model" "metal")))
    (let oldSelf (fgl-monitor-sample 1))
    (let oldProjection (fgtm-sample "state.fixture" (fgtm-present "model.fixture")
        "kv-substate" "metal" "model.fixture" "reason" "soak" (fgtm-absent)
        (fgtm-absent) "ready" (fgtm-present 1) (fgtm-present 1) (fgtm-present 1)
        (fgtm-absent) "unknown" "derived-window" "glass.projection" (list "memory")))
    (let external (fgl-external-samples (list oldSelf oldProjection model)))
    (let local (fgl-local-samples external 1000))
    (let publishers (fgl-external-publishers (list "glass.monitor" "fixture.owner")))
    (let metrics (list (fgo-int "memory" "cells" "interned cells" 42 "cells" 42
        "cpu-arena" "physical-live" "fixture" "resident" "cell" "fixture")))
    (let warm (fglsb-soak 3 metrics local publishers ""))
    (let stringsBefore (kernel_stat 5))
    (let held (fglsb-soak 64 metrics local publishers warm))
    (let stringsAfter (kernel_stat 5))
    (let source (read_file "form/form-stdlib/form-glass-live.bml"))

    (let b0 (fglsb-bit (and (eq (len external) 1)
                             (str_eq (fgtm-sample-id (head external)) "model.fixture")) 1))
    (let b1 (fglsb-bit (and (eq (len publishers) 1)
                             (str_eq (head publishers) "fixture.owner")) 2))
    (let b2 (fglsb-bit (and (eq (len local) 2)
                             (str_eq (fgtm-sample-id (head local)) "process.form-glass")) 4))
    (let b3 (fglsb-bit (eq (fglsb-has source "fgl-publish-self") 0) 8))
    (let b4 (fglsb-bit (le (sub stringsAfter stringsBefore) 2) 16))
    (let b5 (fglsb-bit (and (str_eq held warm)
                             (eq (fglsb-has held "FORM GLASS") 1)) 32))
    (sum (list b0 b1 b2 b3 b4 b5)))
