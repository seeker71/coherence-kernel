; Privacy-safe causal observation: counts, validity, and authority boundaries.
; witnessed: 2026-08-08 -> [[1,4,0],[1,4,1],[1,5,1,1,1,1,1,1,2,1],[6,1,1],[5,1,1,1,1,0,0],[0,4,1,1,1,0,0]] on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-action-enquiry.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk form-stdlib/tests/living-world-action-enquiry-witness.fk form-stdlib/tests/living-world-durable-action-enquiry-witness.fk form-stdlib/tests/living-world-durable-action-enquiry-succession-witness.fk

(do
    (let base (lwaew-outsider-world))
    (let question (lwdaes-question-for base))
    (let historical (lwae-stance-evidence-for base question))
    (let alternative (lwdaes-alternative-stance question))
    (let abstain (lwdaes-abstain-stance question))
    (let unjoined (lwdaes-unjoined-world base))
    (let joined (lwdaes-joined-world base))
    (let revised (lwdaes-revised-world joined))
    (let successor (lwdaes-successor-world revised))
    (let departed (lwdaes-departed-world successor))
    (let joined-evidence
        (lwdaes-evidence-for-stance joined question alternative))
    (let successor-abstain
        (lwdaes-evidence-for-stance successor question abstain))
    (list
        (list
            (lwo-field-size (lwdaeq-questions base))
            (lwo-field-size historical)
            (lwo-active-by? base question (lwdaes-source-j)))
        (list
            (lwo-active? unjoined alternative)
            (lwo-field-size
                (lwae-stance-evidence-for unjoined question))
            (if (node_eq
                    (lwdaes-evidence-for-stance
                        unjoined question alternative)
                    (lwo-none)) 1 0))
        (list
            (lwo-active-by? joined question (lwdaes-source-j))
            (lwo-field-size
                (lwae-stance-evidence-for joined question))
            (lwdaes-field-contained? historical
                (lwae-stance-evidence-for joined question))
            (if (node_eq joined-evidence (lwo-none)) 0 1)
            (lwo-field-size
                (lwae-stance-evidence-attributions joined-evidence))
            (lwae-stance-valid? joined alternative)
            (oac-zero? (lwae-stance-ack alternative))
            (lwlc-declaration-valid?
                (lwae-stance-declaration alternative))
            (lwo-field-size (lwae-stance-alternatives alternative))
            (lwlc-unknown? (lwae-stance-unknown alternative)))
        (list
            (lwo-field-size
                (lwae-stance-evidence-for revised question))
            (if (node_eq
                    (lwdaes-evidence-for-stance
                        revised question alternative)
                    (lwo-none)) 0 1)
            (if (node_eq
                    (lwdaes-evidence-for-stance
                        revised question abstain)
                    (lwo-none)) 0 1))
        (list
            (lwo-field-size
                (lwae-stance-evidence-for successor question))
            (if (node_eq
                    (lwdaes-evidence-for-stance
                        successor question alternative)
                    (lwo-none)) 1 0)
            (if (node_eq successor-abstain (lwo-none)) 0 1)
            (lwae-stance-immediate-nothing? abstain)
            (lwdaes-field-contained? historical
                (lwae-stance-evidence-for successor question))
            (lwo-field-size (lwdaeq-current-selections successor))
            (lwo-field-size (lwdaeq-current-executions successor)))
        (list
            (lwo-active-by? departed question (lwdaes-source-j))
            (lwo-field-size
                (lwae-stance-evidence-for departed question))
            (if (node_eq
                    (lwdaes-evidence-for-stance
                        departed question abstain)
                    (lwo-none)) 1 0)
            (lwdaes-field-contained? historical
                (lwae-stance-evidence-for departed question))
            (lwae-question-steady? departed question)
            (lwo-field-size (lwdaeq-current-selections departed))
            (lwo-field-size (lwdaeq-current-executions departed)))))
