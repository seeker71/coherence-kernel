; Public three-process filesystem diagnostic, phase 1: create one populated
; tree.  No session, corpus, prompt, answer, or model data is touched.
; preludes: form-stdlib/form-fs.fk

(do
    (let root
        (fs-path-join (fs-temp-dir)
            "native-model-session-grounding-cleanup-diagnostic-1786205299000"))
    (let inner (fs-path-join root "inner"))
    (let made-root (fs-mkdir root))
    (let made-inner (fs-mkdir inner))
    (let written
        (fs-write-text (fs-path-join inner "public-fixture.txt") "fixture"))
    (sum (list
        (if (eq made-root 0) 1 0)
        (if (eq made-inner 0) 2 0)
        (if (eq written 7) 4 0)
        (if (eq (fs-is-dir? inner) 1) 8 0))))
