; Owned native images survive cache growth; large images execute to their end.
; Expected 2047 on the Darwin ARM64 RAM-image carrier.
; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk
(do
 (defn joi-id (n) (intern_node (make_nodeid 31 2 0 181)
   (list (intern_trivial_string "jit-owned-images-v1") (intern_trivial_int n))))
 (defn joi-open (n)
  (do (let id (joi-id n))
      (let answer (jit_leaf_inram (list 0 id (fa-image (list (fa-movz 0 n) (fa-ret)))) 0))
      (list id n answer)))
 (defn joi-many (n)
  (if (eq n 0) (list) (cons (joi-open n) (joi-many (sub n 1)))))
 (defn joi-born (xs)
  (if (nil? xs) 1 (and (eq (nth (head xs) 1) (nth (head xs) 2)) (joi-born (tail xs)))))
 (defn joi-hot (xs)
  (if (nil? xs) 1
   (do (let got (jit_leaf_inram (list 0 (head (head xs)) (list)) 0))
       (let rest (joi-hot (tail xs)))
       (and (eq got (nth (head xs) 1)) rest))))
 (defn joi-release (xs)
  (if (nil? xs) 1
   (do (let answer (jit_leaf_inram (list 1 (head (head xs)) (list)) 0))
       (let rest (joi-release (tail xs)))
       (and (eq answer 1) rest))))
 (defn joi-nops (n)
  (if (eq n 0) (list) (cons (fa-nop) (joi-nops (sub n 1)))))
 (let held (joi-many 320))
 (let born (joi-born held))
 (let hot (joi-hot held))
 (let image (fa-image (cons (fa-movz 0 777) (append (joi-nops 4096) (list (fa-ret))))))
 (let large-id (joi-id 1000))
 (let large (jit_leaf_inram (list 0 large-id image) 0))
 (let still-hot (joi-hot held))
 (let shared-id (joi-id 1001))
 (let shared (jit_leaf_inram (list 0 shared-id image) 0))
 (let released-large (jit_leaf_inram (list 1 large-id (list)) 0))
 (let shared-hot (jit_leaf_inram (list 0 shared-id (list)) 0))
 (let stale (jit_leaf_inram (list 0 large-id image) 0))
 (let released-shared (jit_leaf_inram (list 1 shared-id (list)) 0))
 (let released-all (joi-release held))
 (let duplicate (jit_leaf_inram (list 1 (head (head held)) (list)) 0))
 (let replacement (joi-open 900))
 (let replaced-hot (jit_leaf_inram (list 0 (head replacement) (list)) 0))
 (let released-replacement (jit_leaf_inram (list 1 (head replacement) (list)) 0))
 (let absent-id (joi-id 2000))
 (let absent-release (jit_leaf_inram (list 1 absent-id (list)) 0))
 (let absent-readmit (jit_leaf_inram (list 0 absent-id image) 0))
 (let refused-id (joi-id 2001))
 (let refused-birth (jit_leaf_inram (list 0 refused-id (list 256 0 0 0)) 0))
 (let refused-release (jit_leaf_inram (list 1 refused-id (list)) 0))
 (let refused-readmit (jit_leaf_inram (list 0 refused-id image) 0))
 (sum (list
  (if born 1 0)
  (if hot 2 0)
  (if (and (gt (len image) 16384) (eq large 777)) 4 0)
  (if still-hot 8 0)
  (if (and (eq shared 777) (and (eq released-large 1) (eq shared-hot 777))) 16 0)
  (if (nothing? stale) 32 0)
  (if (and (eq released-shared 1) released-all) 64 0)
  (if (eq duplicate 0) 128 0)
  (if (and (eq replaced-hot 900) (eq released-replacement 1)) 256 0)
  (if (and (nothing? (jit_leaf_inram (list 1 2 3) 0))
           (nothing? (jit_leaf_inram (list 256 0 0 0) 0))) 512 0)
  (if (and (and (eq absent-release 0) (nothing? absent-readmit))
           (and (nothing? refused-birth) (and (eq refused-release 0) (nothing? refused-readmit)))) 1024 0))))
