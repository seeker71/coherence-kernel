; living-world-transformation-nursery-field-band.fk -- recurrence may propose.
; Verdict 32767 proves fifteen optionality, ambiguity, consent, and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk

(do
    (let fixture (lwtnw-build-target))
    (let target (lwtnw-target fixture))
    (let world (lwtnw-exact-world fixture))
    (let offers (lwtn-offers-for world target))
    (let offer-items (lwo-field-items offers))
    (let candidates (lwtn-candidates-for offers))
    (let candidate-e
        (lwtn-candidate-for-offer (lwtnw-offer-e target)))
    (let candidate-f
        (lwtn-candidate-for-offer (lwtnw-offer-f target)))
    (let evidence-e
        (lwtn-evidence-for-candidate offer-items candidate-e))
    (let evidence-f
        (lwtn-evidence-for-candidate offer-items candidate-f))
    (let field (lwtn-field-for world target 2))
    (let proposal (lwtn-selection-proposal world target 2))
    (let selection-candidate (lwt-proposal-candidate proposal))
    (let waiting-round
        (lwt-round world (lwo-field (list proposal))
            (lwo-empty-field) (lwtnw-target-round fixture)))
    (let waiting
        (lwtn-selection-integrate waiting-round proposal (lwigw-action)))
    (let integrated (lwtnw-exact-selection fixture))
    (let integrated-world
        (lwt-round-world (lwtnw-selection-round integrated)))
    (let ambiguous-world (lwtnw-ambiguous-world fixture world))
    (let ambiguous (lwtn-field-for ambiguous-world target 2))
    (let open-offer (lwtnw-open-offer target))
    (let invalid-recipe (lwtnw-invalid-recipe))
    (let invalid-lens (lwtnw-lens-for invalid-recipe))
    (let invalid-declaration
        (lwtnw-declaration-for (lwtnw-direction-f) invalid-lens))
    (let invalid-offer
        (lwtn-offer target invalid-recipe invalid-declaration invalid-lens
            (intern_trivial_int 1) (lwo-empty-field) (lwo-none)
            (lwo-none) (lwo-none) (lwtnw-evidence)))
    (let revocation
        (lwo-revocation (lwtnw-offer-e target) (lwtnw-source-v)
            (lwtnw-reason) (lwtnw-prov-v)))
    (let revoked-world
        (lwt-receive-stream world (list (lwtnw-entry-v revocation))))
    (let revoked (lwtn-field-for revoked-world target 2))

    (let c1
        (if (eq (lwrx-integrated-current?
                    (lwtnw-target-world fixture) target) 1) 1 0))
    (let c2
        (if (and (eq (lwtn-offer-valid? open-offer) 1)
                 (eq (lwtn-candidate-complete-current? world
                         (lwtn-candidate-for-offer open-offer)) 0)) 2 0))
    (let c3
        (if (and (eq (lwtn-offer-valid? invalid-offer) 1)
                 (and (eq (lwre-recipe-valid? invalid-recipe) 0)
                      (eq (lwtn-candidate-complete-current? world
                              (lwtn-candidate-for-offer invalid-offer)) 0)))
            4 0))
    (let c4
        (if (and (eq (lwo-field-size offers) 2)
                 (eq (lwo-field-size candidates) 2)) 8 0))
    (let c5
        (if (and (eq (lwo-field-size
                         (lwtn-candidate-evidence-witnesses evidence-e)) 2)
                 (eq (lwo-field-size
                         (lwtn-candidate-evidence-witnesses evidence-f)) 1))
            16 0))
    (let c6
        (if (and (eq (lwtn-ready? (lwtn-field-status field)) 1)
                 (node_eq (lwtn-field-primary field) evidence-e)) 32 0))
    (let c7
        (if (and (eq (lwo-field-has?
                         (lwtn-field-alternatives field) evidence-f) 1)
                 (and (eq (lwo-field-has?
                              (lwtn-field-alternatives field)
                              (lwtnw-option-e)) 1)
                      (eq (lwo-field-has?
                              (lwtn-field-alternatives field)
                              (lwtnw-option-f)) 1))) 64 0))
    (let c8
        (if (and (eq (lwo-field-has?
                         (lwtn-field-unknowns field)
                         (lwlc-unknown (lwtnw-evidence))) 1)
                 (node_eq (lwtn-field-derived-unknown field)
                          (lwo-none))) 128 0))
    (let c9
        (if (and (eq (lwo-field-size
                         (lwt-proposal-participants proposal)) 9)
                 (eq (lwtn-selection-proposal-current? world proposal) 1))
            256 0))
    (let c10
        (if (eq (lwo-active?
                    (lwt-round-world waiting) selection-candidate) 0) 512 0))
    (let c11
        (if (eq (lwtn-selection-integrated-current?
                    integrated-world
                    (lwtnw-selection-candidate integrated)) 1) 1024 0))
    (let c12
        (if (and (eq (lwtn-open? (lwtn-field-status ambiguous)) 1)
                 (node_eq (lwtn-field-primary ambiguous) (lwo-none))) 2048 0))
    (let c13
        (if (and (node_eq
                    (lwtn-selection-proposal ambiguous-world target 2)
                    (lwo-none))
                 (not (node_eq (lwtn-field-derived-unknown ambiguous)
                               (lwo-none)))) 4096 0))
    (let c14
        (if (and (eq (lwo-field-size
                         (lwtn-field-alternatives ambiguous)) 4)
                 (eq (lwtn-selection-candidate-current?
                         ambiguous-world selection-candidate) 0)) 8192 0))
    (let c15
        (if (and (eq (lwtn-open? (lwtn-field-status revoked)) 1)
                 (and (node_eq (lwtn-field-primary revoked) (lwo-none))
                      (not (node_eq
                              (lwtn-field-derived-unknown revoked)
                              (lwo-none))))) 16384 0))
    (lwtnw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
