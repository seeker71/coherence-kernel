; Native memory accounting and projection regressions. Expected: 131071.
; preludes: form/form-stdlib/form-glass-live.bml
(defn fgmb-check (name held weight)
  (do (print (list name held)) (if (eq held 1) weight 0)))
(defn fgmb-sample (id kind bytes capacity)
  (fgtm-sample id (fgtm-absent) kind "unified" "owner.fixture" "memory" "fixture"
    bytes capacity "resident" (fgtm-present 1000) (fgtm-present 1000)
    (fgtm-absent) (fgtm-absent) "never" "physical-live" "fixture" (list "memory")))
(defn fgmb-value (rows id)
  (fgov2-truth-value (fgov2-observation-measurement (fgl-v2-find rows id))))
(defn fgd-segment-lines-text (rows) (ftc-ansi-segment-lines rows))
(do
  (let provenance (fgl-v2-provenance 1000 1))
  (let rows (fgov2-structure-from-counts (list 10 3 5 32 64) provenance))
  (let vm (list 4096 1048576 2 3 4 5 0 0 6 0 0 0 0 0 0 0 0))
  (let host (fgo-vm-byte-rows vm))
  (let badHost (fgo-vm-byte-rows (list)))
  (let pressure (fgmb-sample "pressure" "pressure" (fgtm-present 0) (fgtm-present 12)))
  (let event (fgmb-sample "recipe.1" "recipe" (fgtm-absent) (fgtm-present 10)))
  (let ledger (fgmb-sample "tensor.owner.allocated" "tensor-ledger" (fgtm-present 1024) (fgtm-present 3)))
  (let leaf (fgmb-sample "scratch" "allocated-tensors" (fgtm-present 512) (fgtm-present 2)))
  (let model (fgmb-sample "model.fixture" "model" (fgtm-present 1024) (fgtm-present 99)))
  (let samples (list pressure event ledger leaf model))
  (let derivedLedger (fgtm-sample "tensor.owner.allocated" (fgtm-absent) "tensor-ledger" "unified" "owner.fixture" "memory" "fixture"
    (fgtm-present 1024) (fgtm-present 3) "resident" (fgtm-present 1000) (fgtm-present 1000)
    (fgtm-absent) (fgtm-absent) "never" "derived-window" "fixture" (list "memory")))
  (let owner (fgov2-structure-observation "tensor.owner.allocated" "tensor" "buffer-extents" (fgov2-measured "resident") (fgov2-measured 1024) "bytes" "unified" "read-write" (fgov2-absent "root") provenance))
  (let joined (fgl-memory-owner-join rows (list owner)))
  (let staleOwner (fgov2-structure-observation "tensor.owner.allocated" "tensor" "buffer-extents" (fgov2-measured "resident") (fgov2-stale 1024 900 "expired") "bytes" "unified" "read-write" (fgov2-absent "root") provenance))
  (let narrow (fglui-body 80 20 1000 "memory" "all" "all" 0 host samples (list) rows))
  (let wide (fglui-body 160 20 1000 "memory" "all" "all" 0 host samples (list) rows))
  (sum (list
    (fgmb-check "cell-footprint" (eq (fgmb-value rows "cells.allocation.bytes") 1040) 1)
    (fgmb-check "blueprint-subset" (and (eq (fgmb-value rows "blueprints.allocation.bytes") 320) (str_eq (fgov2-truth-value (fgov2-observation-parent (fgl-v2-find rows "blueprints.allocation.bytes"))) "cells.allocation.bytes")) 2)
    (fgmb-check "quartets-not-unique-blueprints" (and (eq (fgmb-value rows "blueprints.count") 10) (str_eq (fgov2-observation-unit (fgl-v2-find rows "blueprints.count")) "quartets")) 4)
    (fgmb-check "ten-recipe-columns" (eq (fgmb-value rows "recipes.allocation.bytes") 240) 8)
    (fgmb-check "cons-pair-bytes" (eq (fgmb-value rows "memory.arena.bytes") 80) 16)
    (fgmb-check "six-placeholder-gaps-filled" (eq (len (fglui-seam-observations rows)) 1) 32)
    (fgmb-check "native-host-page-bytes" (and (eq (fgo-int-value (nth host 0)) 8192) (eq (fgo-int-value (nth host 4)) 24576)) 64)
    (fgmb-check "missing-host-never-zero" (and (eq (len badHost) 5) (eq (len (fglui-missing-metrics badHost)) 5)) 128)
    (fgmb-check "host-memory-visible" (eq (len (fglui-view-metrics host "memory")) 5) 256)
    (fgmb-check "no-counter-allocation-gaps" (eq (len (fgd-map-sample-items (list pressure event) samples 1000 "all")) 0) 512)
    (fgmb-check "no-parent-child-doublecount" (eq (fgd-memory-bar-value samples) 1024) 1024)
    (fgmb-check "handle-count-is-not-budget" (eq (fgd-memory-bar-capacity samples 0) 0) 2048)
    (fgmb-check "owner-ledger-fills-tensor-gap" (and (eq (fgmb-value joined "tensors.allocation.bytes") 1024) (eq (len (fglui-seam-observations joined)) 0)) 4096)
    (fgmb-check "owner-staleness-preserved" (eq (fgov2-stale? (fgov2-observation-measurement (fgl-memory-owner-allocation (fgl-v2-find rows "tensors.allocation.bytes") staleOwner))) 1) 8192)
    (fgmb-check "narrow-bounded-and-overflow-visible" (and (eq (len narrow) 20) (ge (str_find (fgd-segment-lines-text narrow) "rows above=" 0) 0)) 16384)
    (fgmb-check "wide-keeps-host-and-real-gap" (and (eq (len wide) 20) (and (ge (str_find (fgd-segment-lines-text wide) "tensor.owner.allocated" 0) 0) (ge (str_find (fgd-segment-lines-text wide) "host free pages" 0) 0))) 32768)
    (fgmb-check "fresh-derived-extents-are-not-erased-or-promoted" (and (eq (fgd-memory-bar-value (list derivedLedger model)) 1024) (str_eq (fgd-memory-bar-evidence (list derivedLedger model)) "derived-window")) 65536))))
