; living-world-expression-recursion-proposal-observation.fk -- bounded causal
; checkpoint: one already-admitted application offers one minimal reflection.
; Optional declaration, lens layers, alternatives, unknown, choice, and timeout
; are all absent by participant choice.  No offered surface payload is emitted.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk form-stdlib/living-world-expression-composition.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-expression-recursion.fk form-stdlib/tests/living-world-expression-composition-witness.fk

(let LWXRP-SOURCE (bp "LWXRP-SOURCE"))
(let LWXRP-PROV   (bp "LWXRP-PROV"))

(defn lwxrp-source () (lwxbw-cell LWXRP-SOURCE))
(defn lwxrp-prov () (lwxbw-cell LWXRP-PROV))
(defn lwxrp-application-candidate ()
    (lwxcbw-application-candidate-c))
(defn lwxrp-output ()
    (lwxc-derivation-output
        (lwxc-application-derivation
            (lwo-emergent-shape (lwxrp-application-candidate)))))
(defn lwxrp-reflection ()
    (lwxr-reflection (lwxrp-application-candidate)
        (lwxrp-output) (oac-one (lwxrp-output))
        (lwo-none) (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none)
        (lwxbw-evidence)))
(defn lwxrp-world-build ()
    (lwt-receive-stream (lwxcbw-application-world)
        (list (lwxbw-entry (lwxrp-source) (lwxrp-prov)
            (lwxrp-reflection)))))
(let LWXRP-WORLD-VALUE (lwxrp-world-build))
(defn lwxrp-world () LWXRP-WORLD-VALUE)
(let LWXRP-PROPOSAL-VALUE
    (lwxr-reflection-proposal (lwxrp-world) (lwxrp-reflection)))
(defn lwxrp-proposal () LWXRP-PROPOSAL-VALUE)

(do
    ; The proposal construction already proves application freshness,
    ; reflection shape, exact acknowledgement, and witness collection once.
    ; Inspect that admitted-to-proposal identity instead of replaying those
    ; same proofs again as separate diagnostic fields.
    (let proposal (lwxrp-proposal))
    (if (node_eq proposal (lwo-none)) (list 0 0 0 0 0 0 0 0)
        (do
            (let candidate (lwt-proposal-candidate proposal))
            (let reflection (lwo-emergent-shape candidate))
            (list
                1
                (lwxr-reflection-candidate? candidate)
                (lwo-field-size (lwo-emergent-witnesses candidate))
                (lwo-field-size (lwt-proposal-participants proposal))
                (oac-one? (lwxr-reflection-ack reflection))
                (if (node_eq (lwxr-reflection-declaration reflection)
                        (lwo-none)) 1 0)
                (lwo-field-size
                    (lwxr-reflection-alternatives reflection))
                (if (and (node_eq (lwxr-reflection-unknown reflection)
                                (lwo-none))
                         (and (node_eq (lwxr-reflection-choice reflection)
                                    (lwo-none))
                              (node_eq (lwxr-reflection-timeout reflection)
                                    (lwo-none)))) 1 0)))))
