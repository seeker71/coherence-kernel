; metal-dynamic-carrier-band.fk -- Metal is admitted dynamically, not linked into fkwu.
;
; RUN: ./fkwu form/form-stdlib/tests/metal-dynamic-carrier-band.fk
;
; Verdict 31 = 1 dynamic-carrier | 2 loaded | 4 handle-door | 8 device | 16 live-vector.
; Hosts without the dynamic carrier answer 13 or less; this band is the live-carrier witness.
;
; preludes: form-stdlib/core.fk

(do
    (defn mdcb-bit (ok bit) (if ok bit 0))
    (defn mdcb-has (s sub) (if (ge (str_find s sub 0) 0) 1 0))
    (let st (metal_status))
    (let live (metal_live))
    (add (mdcb-bit (mdcb-has st "metal_carrier=dynamic") 1)
    (add (mdcb-bit (mdcb-has st "metal_loaded=true") 2)
    (add (mdcb-bit (mdcb-has st "metal_door=handle") 4)
    (add (mdcb-bit (mdcb-has st "metal_device=true") 8)
         (mdcb-bit (and (ge (len live) 1) (eq (nth live 0) 1)) 16))))))
