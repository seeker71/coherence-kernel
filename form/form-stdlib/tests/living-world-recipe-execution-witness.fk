; living-world-recipe-execution-witness.fk -- the offered Recipe runs locally.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk

(let LWREW-SOURCE-A   (bp "LWREW-SOURCE-A"))
(let LWREW-SOURCE-B   (bp "LWREW-SOURCE-B"))
(let LWREW-PROV-A     (bp "LWREW-PROV-A"))
(let LWREW-PROV-B     (bp "LWREW-PROV-B"))
(let LWREW-ACTION     (bp "LWREW-ACTION"))
(let LWREW-DIRECTION  (bp "LWREW-DIRECTION"))
(let LWREW-BEFORE     (bp "LWREW-BEFORE"))
(let LWREW-EVIDENCE   (bp "LWREW-EVIDENCE"))
(let LWREW-FLOW       (bp "LWREW-FLOW"))
(let LWREW-CHANGES    (bp "LWREW-CHANGES"))
(let LWREW-ALTERNATE  (bp "LWREW-ALTERNATE"))

(defn lwrew-cell (kind) (intern_node kind (empty)))
(defn lwrew-source-a () (lwrew-cell LWREW-SOURCE-A))
(defn lwrew-source-b () (lwrew-cell LWREW-SOURCE-B))
(defn lwrew-prov-a () (lwrew-cell LWREW-PROV-A))
(defn lwrew-prov-b () (lwrew-cell LWREW-PROV-B))
(defn lwrew-action () (lwrew-cell LWREW-ACTION))
(defn lwrew-direction () (lwrew-cell LWREW-DIRECTION))
(defn lwrew-before () (lwrew-cell LWREW-BEFORE))
(defn lwrew-evidence () (lwrew-cell LWREW-EVIDENCE))
(defn lwrew-flow () (lwrew-cell LWREW-FLOW))
(defn lwrew-changes () (lwrew-cell LWREW-CHANGES))
(defn lwrew-alternate () (lwrew-cell LWREW-ALTERNATE))

(defn lwrew-contract ()
    (lwre-form-contract 128 (lwrew-evidence)))
(defn lwrew-recipe ()
    (lwre-recipe
        "(do (defn sq (x) (mul x x)) (sq 7))"
        (lwrew-contract) (lwrew-evidence)))
(defn lwrew-recipe-lens ()
    (lwlc-lens (lwlc-recipe-shape)
        (lwrew-recipe) (lwrew-evidence)))
(defn lwrew-declaration ()
    (lwlc-declaration (lwrew-direction)
        (lwlc-stack (lwrew-recipe-lens)
            (lwlc-layers (list))
            (lwo-empty-field)
            (lwlc-unknown (lwrew-evidence))
            (lwrew-evidence))
        (lwrew-evidence)))
(defn lwrew-choice ()
    (lwlc-choice (lwrew-action)
        (lwo-field (list (lwrew-alternate)))
        (lwlc-unknown (lwrew-evidence))
        (lwrew-evidence)))

(defn lwrew-entry-for (source provenance payload)
    (lwt-entry
        (lwo-offer source
            (lwo-interface (list (lwrew-action))) 1 payload provenance 1)
        (lwrew-action)))
(defn lwrew-entry-a (payload)
    (lwrew-entry-for (lwrew-source-a) (lwrew-prov-a) payload))
(defn lwrew-entry-b (payload)
    (lwrew-entry-for (lwrew-source-b) (lwrew-prov-b) payload))

(defn lwrew-world ()
    (lwt-receive-stream (lwo-empty-world)
        (list
            (lwrew-entry-a (lwrew-recipe))
            (lwrew-entry-a (lwrew-declaration))
            (lwrew-entry-b (lwrew-before)))))

(defn lwrew-proposal-for-world (world)
    (lwre-proposal world
        (lwrew-declaration) (lwrew-recipe-lens) (lwrew-before)
        (lwo-field (list (lwrew-alternate)))
        (lwlc-unknown (lwrew-evidence))
        (lwrew-choice) (lwrew-flow) (lwrew-changes)
        (lwrew-evidence)))

(defn lwrew-round ()
    (do
        (let world (lwrew-world))
        (let proposal (lwrew-proposal-for-world world))
        (lwt-round world
            (lwo-field-add (lwo-empty-field) proposal)
            (lwo-empty-field) (lwo-none))))

(defn lwrew-response-entry (source provenance proposal ack)
    (lwrew-entry-for source provenance
        (lwt-response proposal ack provenance)))

(defn lwrew-yes-round ()
    (do
        (let round (lwrew-round))
        (let proposal
            (head (lwo-field-items (lwt-round-proposals round))))
        (lwt-round-receive round
            (list
                (lwrew-response-entry (lwrew-source-a) (lwrew-prov-a)
                    proposal (oac-one proposal))
                (lwrew-response-entry (lwrew-source-b) (lwrew-prov-b)
                    proposal (oac-one proposal))))))

(defn lwrew-integrated-round ()
    (do
        (let round (lwrew-yes-round))
        (let proposal
            (head (lwo-field-items (lwt-round-proposals round))))
        (lwre-integrate round proposal (lwrew-action))))

(defn lwrew-revoked-world ()
    (lwt-receive-stream (lwrew-world)
        (list
            (lwrew-entry-a
                (lwo-revocation (lwrew-recipe) (lwrew-source-a)
                    (lwrew-action) (lwrew-prov-a))))))

(defn lwrew-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwrew-sum (tail items)))))
