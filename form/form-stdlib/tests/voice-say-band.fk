; voice-say-band.fk — the shape of the body's mouths, and the honesty of its refusal.
; The ear renders 32 tongues; 29 of them have a piper voice and this band pins that map:
; one row per tongue, two fields to a row, a two-byte code, no tongue named twice, and
; every declared model actually lying on this Mac's disk at model size. The three tongues
; with no voice anywhere (ms, tl, ta) must stay unnamed and must draw the refusal that
; names the tongues that do speak. Nothing here reaches vs-speak, so the band is silent:
; every path it walks returns before the piper crossing.
; Expected: 16383
; Verdict 16383
; PROOF LEVEL: FOURTH-ARM ONLY (host file_size over the voice store)
; preludes: form/form-stdlib/voice-say.bml
(do
    (defn vb-bit (ok v) (if ok v 0))
    (defn vb-rows2? (rows) (if (eq (len rows) 0) 1 (if (eq (len (head rows)) 2) (vb-rows2? (tail rows)) 0)))
    (defn vb-code2? (rows) (if (eq (len rows) 0) 1 (if (eq (str_len (head (head rows))) 2) (vb-code2? (tail rows)) 0)))
    (defn vb-named? (rows) (if (eq (len rows) 0) 1 (if (gt (str_len (nth (head rows) 1)) 0) (vb-named? (tail rows)) 0)))
    (defn vb-has-code? (rows code) (if (eq (len rows) 0) 0 (if (str_eq (head (head rows)) code) 1 (vb-has-code? (tail rows) code))))
    (defn vb-distinct? (rows) (if (eq (len rows) 0) 1 (if (eq (vb-has-code? (tail rows) (head (head rows))) 1) 0 (vb-distinct? (tail rows)))))
    (defn vb-big? (rows) (if (eq (len rows) 0) 1 (if (gt (file_size (vs-model (head (head rows)))) 1000000) (vb-big? (tail rows)) 0)))
    (defn vb-nl (s i n) (if (ge i (str_len s)) n (vb-nl s (add i 1) (if (eq (str_byte_at s i) 10) (add n 1) n))))
    (defn vb-mute? (code) (eq (str_len (vs-voice code)) 0))
    (let rows (vs-voices))
    (let refusal (vs-say "ms" "Selamat pagi."))
    (let mouths (vs-mouths))
    (let codes (vs-codes-of "en pt  fa "))
    (let c1 (vb-bit (eq (len rows) 29) 1))
    (let c2 (vb-bit (eq (vb-rows2? rows) 1) 2))
    (let c3 (vb-bit (eq (vb-code2? rows) 1) 4))
    (let c4 (vb-bit (eq (vb-named? rows) 1) 8))
    (let c5 (vb-bit (eq (vs-mouth-count) 29) 16))
    (let c6 (vb-bit (eq (vb-distinct? rows) 1) 32))
    ; the three the ear renders and no piper voice anywhere speaks
    (let c7 (vb-bit (and (vb-mute? "ms") (and (vb-mute? "tl") (vb-mute? "ta"))) 64))
    (let c8 (vb-bit (starts-with? refusal "no mouth for ms") 128))
    (let c9 (vb-bit (and (ge (find-from refusal "en" 0) 0) (ge (find-from refusal "sw" 0) 0)) 256))
    ; a mouth that exists still refuses an empty line, and never reaches the crossing
    (let c10 (vb-bit (str_eq (vs-say "en" "") "nothing to say") 512))
    (let c11 (vb-bit (str_eq (vs-say-tongues "en pt" "") "nothing to say; nothing to say") 1024))
    (let c12 (vb-bit (and (eq (len codes) 3) (and (str_eq (head codes) "en") (str_eq (nth codes 2) "fa"))) 2048))
    (let c13 (vb-bit (eq (vb-big? rows) 1) 4096))
    (let c14 (vb-bit (and (eq (vb-nl mouths 0 0) 29) (lt (find-from mouths "(model not on disk)" 0) 0)) 8192))
    (print_str (str_concat "mouths=" (int_to_str (vs-mouth-count))))
    (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9 (add c10 (add c11 (add c12 (add c13 c14))))))))))))))
