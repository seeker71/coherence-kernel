; native-science-band.fk — geometry, chemistry, and physics as Form native.
;
; Existing chemistry and physics already live in basic-science.fk (SI, F=ma,
; water, momentum). Geometry was the hole. This band joins them.
; Not vortex cosmology. Not a source code of the universe.
;
; Verdict 127:
;   1    3-4-5 is a right triangle
;   2    2-3-4 is not
;   4    distance² from origin to (3,4) is 25
;   8    3-4-5 area is 6
;   16   2 H2 + O2 -> 2 H2O conserves H and O
;   32   F = ma: 2 kg × 3 m/s² is 6 N
;   64   inverse-square: 36 / 2² = 9, and r=0 is nothing
;
; preludes: form-stdlib/core.fk form-stdlib/euclid.fk form-stdlib/basic-science.fk
; witnessed: 2026-09-10 -> 127

(do
    (defn nsb-bit (ok bit) (if ok bit 0))
    (let hydrogen (list (list 1 2)))
    (let oxygen (list (list 8 2)))
    (let water (list (list 1 2) (list 8 1)))
    (let left (list (list 2 hydrogen) (list 1 oxygen)))
    (let right (list (list 2 water)))
    (let force (bsc-force (bsc-mass-kg 2.0) (bsc-accel-mps2 3.0)))
    (add (nsb-bit (eq (eu-right? 3 4 5) 1) 1)
    (add (nsb-bit (eq (eu-right? 2 3 4) 0) 2)
    (add (nsb-bit (eq (eu-dist2 (eu-point 0 0) (eu-point 3 4)) 25) 4)
    (add (nsb-bit (eq (eu-area-right 3 4) 6) 8)
    (add (nsb-bit (bsc-balanced-elements? left right (list 1 8)) 16)
    (add (nsb-bit (and (value_eq (bsc-dimension force) (bsc-dim-force))
                      (eq (bsc-value force) 6.0)) 32)
         (nsb-bit (and (eq (eu-inv-sq 36 2) 9)
                      (nothing? (eu-inv-sq 36 0))) 64))))))))
