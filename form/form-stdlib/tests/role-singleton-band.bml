// role-singleton-band.bml — one live process of a role: the elder stays, the younger yields (form-stdlib/bml/role-singleton.bml).
//
// Real peers: two gpu-window sleepers (the same door, spawned apart), so the table the organ reads is the host's. The edge cases are rows.
// Verdict 63:
//   1   of two live processes of one door the elder has no elders and the younger has exactly the elder
//   2   the census lists them elder first
//   4   when the elder ends, the younger has no elders: it is the role now
//   8   only `./fkwu <door>` is the role: a --check, a longer argv, another file that merely ends alike are not
//   16  the same start: the lower pid is the elder, exactly one of two is
//   32  a row whose pid is not alive is no elder
//
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/live.bml form-stdlib/bml/role-singleton.bml
section [form.bml] {
 class RoleSingletonBand {
  def rsb-bit(held) = held ? 1 : 0;
  def rsb-door() = "form/form-stdlib/tests/gpu-window-sleeper.fk";
  def rsb-fresh() {
   let root = temp_dir() ++ "/role-singleton-band-" ++ now_unix_ms().str();
   (Comparable) host_dir_mkdir(root) == 1 ? ["role-singleton", root] : nothing();
  }
  def rsb-spawn(ctx, name) {
   let d0 = host_dir_mkdir(".hearth");
   let d1 = host_dir_mkdir(".hearth/window-probe");
   let beat = ctx[1] ++ "/beat-" ++ name;
   let pid = host_spawn_at(["./fkwu", rsb-door()], ["/dev/null", "/dev/null", ctx[1] ++ "/s-" ++ name ++ ".err"]);
   let req = write_file_text(".hearth/window-probe/req-" ++ pid.str(), beat);
   [pid, beat];
  }
  def rsb-reap(s) {
   let st = write_file_text(s[1] ++ ".stop", "x");
   let nap = host_sleep_ms(150);
   let k = host_signal(s[0], 9);
   host_wait(s[0]);
  }
  def rsb-row(pid, start, argv) = [pid, 1, "/x", "/", argv, start, 0];
  // ── 1, 2, 4: real processes ──
  def rsb-real(ctx) {
   let a = rsb-spawn(ctx, "a");
   let nap = host_sleep_ms(1200);
   let b = rsb-spawn(ctx, "b");
   let settle = host_sleep_ms(900);
   let rows = rs-rows(rsb-door());
   let a-elders = rs-elders-of(host_process(a[0]), rows);
   let b-elders = rs-elders-of(host_process(b[0]), rows);
   let one = ((Comparable) len(a-elders) == 0) && ((Comparable) len(b-elders) == 1) && ((Comparable) b-elders[0] == a[0]);
   let census = rs-census(rsb-door());
   let two = ((Comparable) len(census) >= 2) && ((Comparable) census[0][0] == a[0]);
   let killed = rsb-reap(a);
   let after = rs-elders-of(host_process(b[0]), rs-rows(rsb-door()));
   let role = (Comparable) len(after) == 0;
   let rb = rsb-reap(b);
   [rsb-bit(one), rsb-bit(two), rsb-bit(role)];
  }
  // ── 8: only the exact shape is the role ──
  def rsb-shape(ctx) {
   let d = "a/door.fk";
   rsb-bit(rs-door?(rsb-row(10, 5, ["./fkwu", d]), d) && !rs-door?(rsb-row(10, 5, ["./fkwu", "--check", d]), d) && !rs-door?(rsb-row(10, 5, ["./fkwu", "b/otherdoor.fkx"]), d) && !rs-door?(rsb-row(10, 5, ["./fkwu"]), d) && !rs-door?(0 - 1, d));
  }
  // ── 16: the same start, the lower pid ──
  def rsb-tie(ctx) {
   let argv = ["./fkwu", "a/door.fk"];
   let lo = rsb-row(100, 7, argv);
   let hi = rsb-row(200, 7, argv);
   let rows = [lo, hi];
   rsb-bit(((Comparable) len(rs-elders-of(lo, rows)) == 0) && ((Comparable) len(rs-elders-of(hi, rows)) == 1) && ((Comparable) rs-elders-of(hi, rows)[0] == 100));
  }
  // ── 32: a dead pid is no elder (rs-rows filters by host_alive) ──
  def rsb-dead(ctx) {
   let dead = host_spawn_at(["/usr/bin/true"], ["/dev/null", "/dev/null", "/dev/null"]);
   let waited = host_wait(dead);
   rsb-bit(((Comparable) host_alive(dead) == 0) && !rs-live?(rsb-row(dead, 1, ["./fkwu", "a/door.fk"])));
  }
 }
 let ctx = rsb-fresh();
 nothing?(ctx) ? form_error("role-singleton band needs a fresh directory under temp_dir") : 0;
 let real = rsb-real(ctx);
 let verdict = live-claims("role-singleton-band", ctx, [["elder-younger", 1, 1, c => real[0]], ["census", 2, 1, c => real[1]], ["elder-ends", 4, 1, c => real[2]], ["shape", 8, 1, rsb-shape], ["tie", 16, 1, rsb-tie], ["dead", 32, 1, rsb-dead]]);
 host_dir_rmdir(ctx[1]);
 verdict;
}
