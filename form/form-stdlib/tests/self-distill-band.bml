; self-distill-band.bml — the voice's own frontier row (form-stdlib/bml/self-distill.bml, observe/self-distill-run.bml). No model opens: a stand-in reply answers for the voice, through the real door.
; Expected: 255
;   1   admitted: of offered words the first the judge holds lands; a word absent from the corpus and in the lexicon, with a WHY tied to the finding, lands one row with src native-voice in the candidates file and one attempt in the ledger; the corpus file does not move
;   2   refused by name: no-word, not-fresh, already-offered, echo, not-a-word, no-why, why-untethered each land a refused attempt carrying the voice's words, say the name, and leave the candidates file as it was
;   4   held: a voice that did not answer lands a held row with the lane's reason and no candidate
;   8   window: an until_ms that cannot hold an ask asks nothing and lands nothing; no finding asks nothing and lands nothing
;   16  apart: no row of the corpus carries src native-voice, every row of the living candidates file does, and the register's row reads that file and only rows a native landing carried
;   32  findings: walls come first, a finding no attempt asked comes before one that was, and the host's home reads ~ in what lands
;   64  no-lexicon: a word list that does not read refuses, it never admits
;   128 hollow: a real word with a why that restates the finding passes every test of words and is held by the blind read, which sees neither the word nor its stem; a reply with fewer than two other real words is refused by name
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/host-child.bml form-stdlib/bml/self-distill.bml
section [form.bml] {
 class SelfDistillBand {
  def sdb-root() = temp_dir() ++ "/self-distill-band-" ++ host_pid().str();
  def sdb-has?(s, p) = str_find(s, p, 0) >= 0;
  def sdb-wall() = "the walk gate lines stand older than seven days so the proof reads a wall";
  def sdb-why() = "the gate lines stand stale so the proof meets a hollow where its reading should stand";
  def sdb-dir(root, name) { let d = root ++ "/" ++ name; let m = host_dir_mkdir(d); d; }
  def sdb-world(root, name, wall) {
   let d = sdb-dir(root, name);
   let a = write_file_text(d ++ "/corpus.fk", "hdc-row(1, 20260701, [], \"spurious\", \"spurious\", \"rented-oracle\")\n// Capitalword stands in prose\n");
   let b = write_file_text(d ++ "/words", "lacuna\nspurious\nstale\ncapitalword\nbreach\n");
   let c = write_file_text(d ++ "/proof.jsonl", "{\"at_unix_ms\":1,\"E1\":\"holds\",\"E1_reading\":\"a row that holds stays out of this asking\",\"E2\":\"wall\",\"E2_reading\":\"" ++ wall ++ "\"}\n");
   d;
  }
  def sdb-req-read(d, reply, reads) = json-emit(json-node-object([fhn-s("candidates", d ++ "/cand.jsonl"), fhn-s("ledger", d ++ "/led.jsonl"), fhn-s("corpus", d ++ "/corpus.fk"), fhn-s("lexicon", d ++ "/words"), fhn-s("proof", d ++ "/proof.jsonl"), fhn-s("turns", d ++ "/none"), fhn-s("register", d ++ "/none"), fhn-s("reply", reply), json-node-pair("blind", json-node-array(map(r => json-node-string(r), reads)))]));
  def sdb-req(d, reply) = sdb-req-read(d, reply, ["lacuna", "lacuna"]);
  def sdb-offer() = "lacuna, stale, breach";
  def sdb-door(d, text) {
   let i = write_file_text(d ++ "/in", text ++ "\n");
   let pid = host_spawn_at(["./fkwu", "observe/self-distill-run.bml"], [d ++ "/in", d ++ "/out", d ++ "/err"]);
   let status = pid <= 0 ? -1 : host_wait(pid);
   [status, read_file(d ++ "/out") ?? "", read_file(d ++ "/err") ?? ""];
  }
  def sdb-reply(word, why) = "WORD: " ++ word ++ "\nWHY: " ++ why;
  def sdb-rows(p) = (Comparable) host_path_exists(p) == 1 ? fcgp-rows(p) : [];
  def sdb-c-admitted(root) {
   let d = sdb-world(root, "admit", sdb-wall());
   let before = read_file(d ++ "/corpus.fk");
   let f = sdb-world(root, "offers", sdb-wall());
   let o = sdb-door(f, sdb-req(f, sdb-reply("spurious, lacuna, breach", sdb-why())));
   let r = sdb-door(d, sdb-req(d, sdb-reply(sdb-offer(), sdb-why())));
   let c = sdb-rows(d ++ "/cand.jsonl");
   let l = sdb-rows(d ++ "/led.jsonl");
   sdb-has?(o[1], "admitted lacuna") && (Comparable) r[0] == 0 && sdb-has?(r[1], "[self-distill] admitted lacuna from exit-proof E2") && (Comparable) len(c) == 1 && (String) fcgp-str(c[0], "src") == "native-voice" && (String) fcgp-str(c[0], "fresh") == "lacuna" && (String) fcgp-str(c[0], "verdict") == "admitted" && (fcgp-num(c[0], "date") ?? 0) > 20260000 && (Comparable) len(l) == 1 && (String) fcgp-str(l[0], "verdict") == "admitted" && (String) read_file(d ++ "/corpus.fk") == before;
  }
  def sdb-refused?(root, name, word, why, wall, offered) {
   let d = sdb-world(root, "r-" ++ name ++ "-" ++ word, wall);
   let o = offered ? write_file_text(d ++ "/cand.jsonl", "{\"fresh\":\"" ++ word ++ "\",\"src\":\"native-voice\"}\n") : 0;
   let before = read_file(d ++ "/cand.jsonl") ?? "";
   let r = sdb-door(d, sdb-req(d, sdb-reply(word, why)));
   let l = sdb-rows(d ++ "/led.jsonl");
   let ok = (Comparable) r[0] == 0 && sdb-has?(r[1], "refused by name " ++ name ++ ":") && (Comparable) len(l) == 1 && (String) fcgp-str(l[0], "verdict") == "refused" && (String) fcgp-str(l[0], "refused") == name && sdb-has?(fcgp-str(l[0], "said"), word) && (String) (read_file(d ++ "/cand.jsonl") ?? "") == before;
   let p = ok ? 0 : print_str("[self-distill-band] " ++ name ++ " did not refuse: " ++ r[1] ++ r[2]);
   ok;
  }
  def sdb-c-refused(root) = sdb-refused?(root, "no-word", "two words", sdb-why(), sdb-wall(), false)
   && sdb-refused?(root, "not-fresh", "spurious", sdb-why(), sdb-wall(), false)
   && sdb-refused?(root, "not-fresh", "capitalword", sdb-why(), sdb-wall(), false)
   && sdb-refused?(root, "already-offered", "lacuna", sdb-why(), sdb-wall(), true)
   && sdb-refused?(root, "echo", "breach", sdb-why(), "the breach stands so the proof reads a wall over its gate lines", false)
   && sdb-refused?(root, "not-a-word", "xylqzv", sdb-why(), sdb-wall(), false)
   && sdb-refused?(root, "no-why", "lacuna", "it fits", sdb-wall(), false)
   && sdb-refused?(root, "why-untethered", "lacuna", "this is a very nice word about many other things", sdb-wall(), false);
  def sdb-c-held(root) {
   let d = sdb-world(root, "held", sdb-wall());
   let opts = parse-json("opts", sdb-req(d, ""));
   let said = sd-land(["exit-proof E2", sdb-wall()], ["unavailable", "", 0, 0, "m", 0, 1, "metal-carrier-refused", "", [], ""], opts);
   let l = sdb-rows(d ++ "/led.jsonl");
   (Comparable) len(l) == 1 && (String) fcgp-str(l[0], "verdict") == "held" && sdb-has?(fcgp-str(l[0], "said"), "metal-carrier-refused") && (Comparable) host_path_exists(d ++ "/cand.jsonl") == 0 && sdb-has?(said, "held:");
  }
  def sdb-c-window(root) {
   let d = sdb-world(root, "window", sdb-wall());
   let r = sdb-door(d, json-emit(json-node-object(append(json-object-pairs(parse-json("r", sdb-req(d, sdb-reply("lacuna", sdb-why())))), [fhn-n("until_ms", host_monotonic_ms() + 1000)]))));
   let e = sdb-world(root, "nofind", sdb-wall());
   let w = write_file_text(e ++ "/proof.jsonl", "{\"at_unix_ms\":1,\"E1\":\"holds\"}\n");
   let s = sdb-door(e, sdb-req(e, sdb-reply("lacuna", sdb-why())));
   (Comparable) r[0] == 0 && sdb-has?(r[1], "the window cannot hold an ask") && (Comparable) host_path_exists(d ++ "/led.jsonl") == 0 && (Comparable) s[0] == 0 && sdb-has?(s[1], "no finding stands") && (Comparable) host_path_exists(e ++ "/led.jsonl") == 0;
  }
  def sdb-c-apart(root) {
   let corpus = read_file("learn/homecoming-distillation-corpus.fk") ?? "";
   let cands = sdb-rows("learn/distillation-native-candidates.jsonl");
   let gap = foldl((b, g) => (String) fcgp-str(g, "id") == "self-distill" ? g : b, nothing(), fcgp-rows("learn/offline-voice-gaps.jsonl"));
   !sdb-has?(corpus, ", \"native-voice\")") && all?(r => (String) fcgp-str(r, "src") == "native-voice", cands) && !nothing?(gap) && (String) fcgp-str(gap, "source") == "learn/distillation-native-candidates.jsonl" && (Comparable) (fcgp-num(gap, "by_schedule") ?? 0) == 1 && (String) fcgp-str(gap, "door") == "observe/self-distill-run.bml";
  }
  def sdb-c-findings(root) {
   let home = trim(host_getenv("HOME") ?? "");
   let walls = [["a", "first"], ["b", "second"]];
   let asked = [json-node-object([fhn-s("finding", "first"), fhn-n("at_unix_ms", 5)])];
   let d = sdb-world(root, "home", "the gate lines at " ++ home ++ "/x stand older than seven days");
   let r = sdb-door(d, sdb-req(d, sdb-reply("lacuna", sdb-why())));
   (Comparable) r[0] == 0 && (String) sd-pick(walls, asked)[0] == "b" && (String) sd-pick(walls, [])[0] == "a" && !sdb-has?(read_file(d ++ "/led.jsonl") ?? home, home) && sdb-has?(read_file(d ++ "/led.jsonl") ?? "", "~/x");
  }
  def sdb-c-lexicon(root) = (String) sd-judge("lacuna", sdb-why(), sdb-wall(), "", [], nothing()) == "no-lexicon";
  // a why that restates the finding's words and says nothing of its word passes every test of words: only the blind read holds it
  def sdb-hollow() = "this word fits because the gate lines and the proof reads as they stand";
  def sdb-named?(root, name, tag, reply, reads) {
   let d = sdb-world(root, "h-" ++ tag, sdb-wall());
   let r = sdb-door(d, sdb-req-read(d, reply, reads));
   let l = sdb-rows(d ++ "/led.jsonl");
   let ok = (Comparable) r[0] == 0 && sdb-has?(r[1], "refused by name " ++ name ++ ":") && (Comparable) len(l) == 1 && (String) fcgp-str(l[0], "refused") == name && (Comparable) host_path_exists(d ++ "/cand.jsonl") == 0;
   let p = ok ? 0 : print_str("[self-distill-band] hollow " ++ tag ++ " did not refuse: " ++ r[1] ++ r[2]);
   ok;
  }
  def sdb-c-hollow(root) = sdb-named?(root, "blind-miss", "guess", sdb-reply(sdb-offer(), sdb-hollow()), ["stale", "lacuna"])
   && sdb-named?(root, "blind-miss", "none", sdb-reply(sdb-offer(), sdb-hollow()), [])
   && sdb-named?(root, "no-decoys", "alone", sdb-reply("lacuna", sdb-hollow()), ["lacuna", "lacuna"])
   && (String) sd-judge("lacuna", sdb-hollow(), sdb-wall(), "", [], "lacuna\n") == ""
   && !sdb-has?(sd-blanked("Lacuna fits, lacunae fit", "lacuna"), "lacuna") && !sdb-has?(sd-blanked("a lacunary fit", "lacuna"), "lacun")
   && !sdb-has?(sd-blind-packet(sd-blanked(sdb-why() ++ " lacuna", "lacuna"), ["a", "b"]), "lacuna")
   && (String) sd-rotated(["a", "b", "c"], 1)[0] == "b" && (String) sd-rotated(["a", "b", "c"], 0)[0] == "a";
 }
 let root = sdb-root();
 let m = host_dir_mkdir(root);
 let v = live-claims("self-distill-band", root, [["admitted", 1, 1, sdb-c-admitted], ["refused", 2, 1, sdb-c-refused], ["held", 4, 1, sdb-c-held], ["window", 8, 1, sdb-c-window], ["apart", 16, 1, sdb-c-apart], ["findings", 32, 1, sdb-c-findings], ["no-lexicon", 64, 1, sdb-c-lexicon], ["hollow", 128, 1, sdb-c-hollow]]);
 let g = fs-remove-tree(root);
 v;
}
