; preludes: form-stdlib/core.fk form-stdlib/form-cli-adaptive-generation.fk
; 127: Form owns local ordering, remote gating, full evidence, and exhausted miss.

(do
    (let empty "")
    (let weak "tiny")
    (let cheap "GROUNDING: local evidence.\nANSWER: A sufficiently substantive cheap local answer that clears the usable floor.\nUNCERTAINTY: measured.")
    (let strong "GROUNDING: local evidence.\nANSWER: A sufficiently substantive strongest local answer that clears the usable floor.\nUNCERTAINTY: measured.")
    (let remote "GROUNDING: remote evidence.\nANSWER: A sufficiently substantive remote answer used only after both local misses.\nUNCERTAINTY: measured.")
    (let a (fnr-select-adaptive cheap strong remote))
    (let b (fnr-select-adaptive weak strong remote))
    (let c (fnr-select-adaptive weak empty remote))
    (let d (fnr-select-adaptive weak empty empty))
    (let ev (fnr-adaptive-evidence "question" "native-lane:miss" c))
    (add
      (if (str_eq (fnr-s-selected a) "local-cheap") 1 0)
      (add (if (and (str_eq (fnr-s-strong a) "") (str_eq (fnr-s-remote a) "")) 2 0)
      (add (if (str_eq (fnr-s-selected b) "local-strong") 4 0)
      (add (if (str_eq (fnr-s-remote b) "") 8 0)
      (add (if (str_eq (fnr-s-selected c) "remote") 16 0)
      (add (if (and (str_eq (fnr-s-selected d) "miss")
                    (eq (fnr-s-exhausted d) 1)) 32 0)
           (if (and (ge (str_find ev "PROMPT-BEGIN\nquestion\nPROMPT-END" 0) 0)
                    (and (ge (str_find ev "CHEAP-BEGIN\ntiny\nCHEAP-END" 0) 0)
                         (ge (str_find ev "SELECTED remote\nEXHAUSTED 0" 0) 0)))
               64 0))))))))
