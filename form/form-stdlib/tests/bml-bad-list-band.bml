; bml-bad-list-band.bml — a unit the floor compiler refused is refused only while what it was refused for stands, and a
; candidate never stands half written under a floor that reads it.
;
; fk_bml_bad_add / fk_bml_bad_has (runtime/fkwu-uni.c) once remembered a refused .bml by its path for the life of the
; process, so a writable refused once stayed refused after a repaired text was written to the same path, while the same
; text at a fresh path read in that process (.hearth/dead-band/skeptic/09-bad-list.log). Walk turns run as cells in one
; process, so one candidate with a syntax error blinded every later option of that lane: their bands read null. An entry
; now holds the unit's own bytes and the count of this process's writes of source files; "said once, and not asked again"
; holds while both stand. hw-put (form-stdlib/bml/host-walk-publish.bml) once stood a candidate with write_file, O_TRUNC
; and then the bytes, so a floor reading mid-write stopped once on "BML contract source incomplete"
; (.hearth/cache-race-skeptic/kernels/skeptic-before-mover-r1-k4.out).
;
; A refusal voices a compile error each time the floor is asked, so a read with errors 0 and no words of its own is a read
; the floor was not asked for. Every unit here lives in a scratch directory under temp_dir; no model is opened.
;
; Expected: 511
; Verdict 511 when every claim lands:
;   1    a unit that does not compile reads errors above 0, a stop of kind unrunnable and no value
;   2    read again unchanged it is refused with errors 0 and no words: the floor was not asked; the ladder reads both
;        records as the compile class (ntl-band-ending ""), never as a band that died
;   4    rewritten valid at the same path it reads its value, in the same process
;   8    a second unit importing a refused unit is refused the same way (errors above 0, then 0); once this process
;        rewrites the import valid it reads its value, its own bytes never having moved
;   16   a write of a file that is no source moves nothing (still refused, the floor not asked); a removal of a source
;        moves the count (the floor is asked again and refuses again, voiced again); a rename into a source path moves it too
;   32   hw-put stands a candidate by rename: a hard link to the old bytes keeps them, the path reads the new, no stage
;        remains, the permission bits stay and a symlink stays a symlink whose target reads the new bytes
;   64   hw-put refuses by name: a path whose directory does not stand and a path that is a directory answer
;        "put-refused: <path>: ...", no stage remains; removing what does not stand answers ""; hw-put-all stops at the
;        first refusal and hw-with-published answers it as why nothing was published, with no run and the first path restored
;   128  a killed publish's stage goes with its marker when the next start heals (hw-heal-publishes)
;   256  the walk itself: the door, over a gap whose writable does not compile and whose rung-0 boolean repair makes the
;        band read full, reads null before the option (the floor refused the band), and the same process's native rung
;        lands green: the repair it proposed is judged, where a refusal kept by path read the band null under every
;        candidate and left the rung exhausted
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/native-turn-ladder.bml form-stdlib/bml/host-walk-publish.bml
section [form.bml] {
 class BmlBadListBand {
  def bbl-bad() = "section [form.bml] {\n class BblBadZz {\n  def bbl-all(a, b, c) = and(a, b, c);\n }\n 3;\n}\n";
  def bbl-good() = "section [form.bml] {\n class BblGoodZz {\n  def bbl-answer() = 3;\n }\n bbl-answer();\n}\n";
  def bbl-importer(unit) = "import " ++ unit ++ ";\nsection [form.bml] {\n class BblImporterZz {\n  def bbi-go() = 40 + 2;\n }\n bbi-go();\n}\n";
  def bbl-read(path) = cell_run(path, 0, nothing(), nothing());
  def bbl-p(ctx, name) = record_get(ctx, "dir") ++ "/" ++ name;
  // a refused read the floor was asked for, and one it was not
  def bbl-stop-kind(rec) = nothing?(record_get(rec, "stopped")) ? "" : (String) record_get(record_get(rec, "stopped"), "kind");
  def bbl-refused?(rec) = ((String) bbl-stop-kind(rec) == "unrunnable") && nothing?(record_get(rec, "value"));
  def bbl-asked?(rec) = bbl-refused?(rec) && ((Comparable) record_get(rec, "errors") > 0);
  def bbl-unasked?(rec) = bbl-refused?(rec) && ((Comparable) record_get(rec, "errors") == 0) && ((Comparable) len(record_get(rec, "err")) == 0);
  def bbl-value?(rec, v) = ((Comparable) record_get(rec, "errors") == 0) && nothing?(record_get(rec, "stopped")) && (((Value) record_get(rec, "value")) == v);
  def bbl-ladder-compile?(rec) = (String) ntl-band-ending(rec, false) == "";
  // claims 1, 2, 4: one unit, refused, read again, rewritten
  def bbl-c-own(ctx) {
   let u = bbl-p(ctx, "u-own.bml");
   let w1 = write_file_text(u, bbl-bad());
   let first = bbl-read(u);
   let second = bbl-read(u);
   let w2 = write_file_text(u, bbl-good());
   let third = bbl-read(u);
   let kept = record_set(record_set(record_set(ctx, "first", first), "second", second), "third", third);
   bbl-asked?(first);
  }
  def bbl-c-once(ctx) = bbl-unasked?(record_get(ctx, "second")) && bbl-ladder-compile?(record_get(ctx, "first")) && bbl-ladder-compile?(record_get(ctx, "second"));
  def bbl-c-recovers(ctx) = bbl-value?(record_get(ctx, "third"), 3);
  // claim 8: refused for what it imports; the import rewritten, the importer's own bytes never moved
  def bbl-c-import(ctx) {
   let v = bbl-p(ctx, "v-import.bml");
   let i = bbl-p(ctx, "i-import.bml");
   let w1 = write_file_text(v, bbl-bad());
   let w2 = write_file_text(i, bbl-importer(v));
   let first = bbl-read(i);
   let second = bbl-read(i);
   let w3 = write_file_text(v, bbl-good());
   let third = bbl-read(i);
   bbl-asked?(first) && bbl-unasked?(second) && bbl-value?(third, 42);
  }
  // claim 16: which writes move the count
  def bbl-c-count(ctx) {
   let u = bbl-p(ctx, "u-count.bml");
   let other = bbl-p(ctx, "other.bml");
   let stage = bbl-p(ctx, "other.stage");
   let w1 = write_file_text(u, bbl-bad());
   let w2 = write_file_text(other, "; a source no one reads\n");
   let w3 = write_file_text(stage, "; a stage\n");
   let refused = bbl-read(u);
   let w4 = write_file_text(bbl-p(ctx, "note.txt"), "no source\n");
   let textMoved = bbl-read(u);
   let removed = host_path_remove(other);
   let afterRemove = bbl-read(u);
   let renamed = host_path_rename(stage, other);
   let afterRename = bbl-read(u);
   let again = bbl-read(u);
   bbl-asked?(refused) && bbl-unasked?(textMoved) && ((Comparable) removed == 0) && bbl-asked?(afterRemove) && ((Comparable) renamed == 0) && bbl-asked?(afterRename) && bbl-unasked?(again);
  }
  def bbl-no-stage?(dir) = !any?(name => str_find(name, ".hw-", 0) >= 0, fs_list(dir) ?? []);
  // claim 32: the rename, seen through a hard link to the old bytes
  def bbl-c-rename(ctx) {
   let d = bbl-p(ctx, "put");
   let made = fs_mkdir(d);
   let t = d ++ "/target.txt";
   let l = d ++ "/old-bytes.txt";
   let w1 = write_file_text(t, "old\n");
   let linked = host_link(t, l);
   let moded = host_chmod(t, 416);
   let put = hw-put(t, "new\n");
   let real = d ++ "/real.txt";
   let link = d ++ "/through.txt";
   let w2 = write_file_text(real, "old\n");
   let sym = host_symlink(host_realpath(real), link);
   let through = hw-put(link, "new\n");
   ((String) put == "") && ((Comparable) linked == 0) && ((String) (read_file(t) ?? "") == "new\n") && ((String) (read_file(l) ?? "") == "old\n") && ((Comparable) (host_file_mode(t) % 4096) == 416) && ((String) through == "") && ((String) (read_file(real) ?? "") == "new\n") && ((String) host_realpath(link) == host_realpath(real)) && bbl-no-stage?(d);
  }
  // claim 64: the refusals, each by name, none leaving a stage
  def bbl-c-refuse(ctx) {
   let d = bbl-p(ctx, "refuse");
   let made = fs_mkdir(d);
   let inside = d ++ "/no-such-dir/f.txt";
   let over = d ++ "/a-dir";
   let dirmade = fs_mkdir(over);
   let first = d ++ "/first.txt";
   let w1 = write_file_text(first, "A\n");
   let missing = hw-put(inside, "x\n");
   let onto = hw-put(over, "x\n");
   let nobody = hw-put(d ++ "/never-stood.txt", nothing());
   let several = hw-put-all([first, inside, d ++ "/after.txt"], ["B\n", "C\n", "D\n"]);
   let back = write_file_text(first, "A\n");
   let ran = record_new(0, "ran", 0);
   let window = hw-with-published(d ++ "/publish", [first, inside], ["A\n", nothing()], ["B\n", "C\n"], () => { record_set(ran, "ran", 1); [1]; });
   (str_find(missing, "put-refused: " ++ inside, 0) == 0) && (str_find(onto, "put-refused: " ++ over, 0) == 0) && (str_find(onto, "rename", 0) > 0) && ((String) nobody == "") && (str_find(several, "put-refused: " ++ inside, 0) == 0) && nothing?(read_file(d ++ "/after.txt")) && nothing?(window[0]) && window[1] && (str_find(window[2], "put-refused: " ++ inside, 0) == 0) && ((Comparable) record_get(ran, "ran") == 0) && ((String) (read_file(first) ?? "") == "A\n") && bbl-no-stage?(d);
  }
  // claim 128: a stage a killed publish left goes when its marker heals (a pid above the host's range holds nothing)
  def bbl-c-sweep(ctx) {
   let d = bbl-p(ctx, "killed");
   let made = fs_mkdir(d);
   let f = d ++ "/source.txt";
   let dead = 999999;
   let stage = hw-stage-of(f, dead);
   let w1 = write_file_text(f, "A\n");
   let w2 = write_file_text(stage, "half a candi");
   let w3 = write_file_text(d ++ "/publish-" ++ dead.str() ++ ".marker", hw-marker-text(dead, now_unix_ms(), [f], ["A\n"], ["B\n"]));
   let healed = hw-heal-publishes(d);
   ((Comparable) healed[0] == 1) && nil?(healed[1]) && ((String) (read_file(f) ?? "") == "A\n") && bbl-no-stage?(d);
  }
  // claim 256: the door, one process, the writable's and() of three repaired by rung 0
  def bbl-c-walk(ctx) {
   let w = bbl-p(ctx, "w-walk.bml");
   let b = bbl-p(ctx, "b-walk.bml");
   let q = bbl-p(ctx, "q-walk.jsonl");
   let l = bbl-p(ctx, "l-walk.jsonl");
   let w1 = write_file_text(w, "section [form.bml] {\n class BblWalkZz {\n  def bbw-all(a, b, c) = and(a, b, c);\n  def bbw-answer(n) = n;\n }\n 0;\n}\n");
   let w2 = write_file_text(b, "; Verdict 3\nimport " ++ w ++ ";\nsection [form.bml] {\n class BblWalkBandZz {\n  def bwb-go() = bbw-answer(3);\n }\n bwb-go();\n}\n");
   let w3 = write_file_text(q, json-emit(json-node-object([fhn-s("id", "bbl-walk"), fhn-s("goal", "the band reads three"), json-node-pair("writable", json-node-array([json-node-string(w)])), fhn-s("band", b), fhn-n("full", 3)])) ++ "\n");
   let opts = json-node-object([fhn-s("queue", q), fhn-s("ledger", l), json-node-pair("ways", json-node-array([json-node-string("native")]))]);
   let rec = cell_run("observe/native-turn-run.bml", 0, nothing(), [json-emit(opts)]);
   let rows = fcgp-rows(l);
   ((Comparable) len(rows) == 1) && nothing?(fcgp-num(rows[0], "band_before")) && ((Comparable) (fcgp-num(rows[0], "band_after") ?? 0) == 3) && ((Comparable) (fcgp-num(rows[0], "band_green") ?? 0) == 1) && ((String) fcgp-str(rows[0], "lane") == "native") && ((String) fcgp-str(rows[0], "lane_reason") == "boolean-syntax-repair") && (str_find(read_file(w) ?? "", "and(a,and( b, c))", 0) >= 0);
  }
  def bbl-sweep-one(path) = fs_is_dir(path) == 1 ? bbl-sweep-dir(path) : host_path_remove(path);
  def bbl-sweep-dir(dir) {
   let swept = (fs_list(dir) ?? []) |> map(name => bbl-sweep-one(dir ++ "/" ++ name));
   fs_rmdir(dir);
  }
  def bbl-run() {
   let dir = temp_dir() ++ "/bml-bad-list-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str();
   let made = fs_mkdir(dir);
   let ctx = record_new(0, "dir", dir);
   let verdict = live-claims("bml-bad-list-band", ctx, [["refused", 1, 1, bbl-c-own], ["said-once", 2, 1, bbl-c-once], ["recovers", 4, 1, bbl-c-recovers], ["import-recovers", 8, 1, bbl-c-import], ["count", 16, 1, bbl-c-count], ["rename", 32, 1, bbl-c-rename], ["refuses-by-name", 64, 1, bbl-c-refuse], ["stage-swept", 128, 1, bbl-c-sweep], ["walk", 256, 1, bbl-c-walk]]);
   let swept = bbl-sweep-dir(dir);
   verdict;
  }
 }
 bbl-run();
}
