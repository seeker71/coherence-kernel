; preludes: form-stdlib/form-asm.fk form-stdlib/f64-bytes.fk form-stdlib/form-lower.fk
;
; form-lower-flit-band — a FLOAT LITERAL lowers to arm64 native bytes, no clang, no pool.
; The float twin (lo-fnode) refused a literal-bearing tree to the walk ("left as the
; empty tail"), and the walk's tag-53 evaluator was where the boxvoice board caught the
; constant 1.5 minting 300,000 float-pool slots in one loop. onemint capped the walk at
; one mint per process; THIS rung is the native floor under that heal: lo-flit
; materializes the constant's IEEE754 bits with movz + 3·movk into scratch x8, then
; reinterprets d0 <- x8 (fa-fmov-d-x) — the trig lane's own constant idiom
; (fam-exp-reduce's shape) lifted into the lowerer. A native page pays ZERO pool slots
; for its constants.
;
; Oracle: otool -tvj of the system assembler over the exact sequence (M4, cc -c):
;   d2800008 movz x8,#0        f2a00008 movk x8,#0,lsl 16   f2c00008 movk x8,#0,lsl 32
;   f2e7ff08 movk x8,#0x3ff8,lsl 48   9e670100 fmov d0,x8          (1.5 = 0x3FF8...)
;   f2f80088 movk x8,#0xc004,lsl 48                                (-2.5 = 0xC004...)
;   1e604001 fmov d1,d0   1e612800 fadd d0,d0,d1   d65f03c0 ret
;
; Verdict 31 when every claim lands:
;   1   f(x) = 1.5 + x lowers whole: preamble + 5-instruction flit + fadd + ret,
;       byte-identical to the 32-byte oracle
;   2   the lo-flit block alone byte-equals the 20-byte oracle block
;   4   f(x) = x + 1.5 (commuted) lowers to the SAME image — operand-aware fadd
;   8   a NEGATIVE constant's sign rides f64-bytes: -2.5's high movk word is exact
;   16  the whole image is exactly 8 instructions (32 bytes) — no spill, no junk
(do
    (let prog-la (list (list 2) (list 1 1.5) (list 3 1 0)))   ; f(x) = ADD(FLIT 1.5, ARG)
    (let prog-al (list (list 2) (list 1 1.5) (list 3 0 1)))   ; f(x) = ADD(ARG, FLIT 1.5)
    (let want-flit (list 8 0 128 210  8 0 160 242  8 0 192 242  8 255 231 242  0 1 103 158))
    (let want-full (list 1 64 96 30
                         8 0 128 210  8 0 160 242  8 0 192 242  8 255 231 242  0 1 103 158
                         0 40 97 30  192 3 95 214))
    (let want-neg-hi (list 136 0 248 242))
    (let img-la (lo-fcompile-fn prog-la 2))
    (let img-al (lo-fcompile-fn prog-al 2))
    (let flit-neg (lo-flit (list (list 1 -2.5)) 0))

    (let c0 (if (eq (fa-conviction img-la want-full) 1) 1 0))
    (let c1 (if (eq (fa-conviction (lo-flit prog-la 1) want-flit) 1) 2 0))
    (let c2 (if (eq (fa-conviction img-al want-full) 1) 4 0))
    (let c3 (if (eq (fa-conviction (list (nth flit-neg 12) (nth flit-neg 13) (nth flit-neg 14) (nth flit-neg 15)) want-neg-hi) 1) 8 0))
    (let c4 (if (eq (len img-la) 32) 16 0))

    (add c0 (add c1 (add c2 (add c3 c4)))))
