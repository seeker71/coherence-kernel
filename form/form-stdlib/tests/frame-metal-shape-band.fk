; Independent colored/padded BMP fixtures: CPU reference vs Form-generated GPU.
; Expected 1023 with a dynamic Metal adapter; no camera or filesystem mutation.
; preludes: form-stdlib/bml/frame-metal.bml form-stdlib/tests/frame-luma-fixture.fk
(do
 (defn fgs-equal (a b)
  (if (or (nothing? a) (nothing? b)) 0
   (if (not (eq (len a) (len b))) 0
    (if (nil? a) 1 (and (eq (head a) (head b)) (fgs-equal (tail a) (tail b)))))))
 (defn fgs-case (version width height)
  (do (let s (flmb-colored width height))
      (let owner (fg-open version))
      (let frame (fg-capture owner s))
      (let job (fg-submit owner frame (flm-default-policy)))
      (let waited (fg-await-all owner))
      (let observed (fg-result owner job))
      (let closed (fg-close owner))
      (and (eq waited 1) (and (eq closed 1) (fgs-equal observed (flm-stat s))))))
 (defn fgs-cases (v widths)
  (if (nil? widths) 1 (and (fgs-case v (head widths) 3)
      (and (fgs-case v (head widths) -3) (fgs-cases v (tail widths))))))
 (let version (fg-version 1024))
 (let owner (fg-open version))
 (let before (fg-status-number (metal_status) "buffers"))
 (let valid (flmb-bmp 1))
 (let large-header (flmb-header 2147483647 -2147483648 0 0))
 (let invalid (list (nothing) "" "not-bmp" (substring valid 0 73)
    (str_concat (flmb-header 6 1 20 1) (flmb-six-pixels)) large-header))
 (defn fgs-refused (owner inputs)
  (if (nil? inputs) 1 (and (nothing? (fg-capture owner (head inputs)))
      (and (nothing? (flm-stat (head inputs))) (fgs-refused owner (tail inputs))))))
 (let refused (fgs-refused owner invalid))
 (let after (fg-status-number (metal_status) "buffers"))
 (let closed (fg-close owner))
 (sum (list
  (if (fgs-cases version (list 1 2 3 4 5 6)) 1 0)
  (if (fgs-case version 1023 1) 2 0)
  (if (fgs-case version 1024 -1) 4 0)
  (if (fgs-case version 1025 1) 8 0)
  (if (and refused (eq before after)) 16 0)
  (if (and (nothing? (flm-stat-policy valid (list 60 -1 75 12)))
           (nothing? (flm-stat-policy valid (list 60 76 75 12)))) 32 0)
  (if (and (nothing? (flm-stat-policy valid (list 60.5 8 75 12)))
           (nothing? (flm-stat-policy valid (nothing)))) 64 0)
  (if (and (eq (flm-row-bytes 2147483647) 6442450944)
           (fgs-equal (fg-wide 6442450944) (list 2147483648 1))) 128 0)
  (if (and (eq closed 1) (nothing? (fg-version 16843010))) 256 0)
  (if (eq (nth (flm-stat-policy valid (list 0 0 100 0)) 3) 0) 512 0))))
