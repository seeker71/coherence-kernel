; nd-geometry-band.fk — fold, project, transform, bridge-strings.
; Verdict 16383:
;   1    4D orthogonal axes dot to 0
;   2    project (3,4) onto (1,0) is (3,0)
;   4    4D->3D axis projection drops the last coordinate
;   8    fold (1,2,3,4) last-two is (1,2,7)
;   16   identity 2×2 leaves (3,4)
;   32   90° turn (1,0) -> (0,1)
;   64   bridge (0,0)->(4,0) in 2 steps has 3 points and meets both ends
;   128  a non-dividing bridge is nothing
;   256  2D perpendicular (3,4) -> (-4,3)
;   512  3D cross (1,0,0)×(0,1,0)=(0,0,1)
;   1024 compose two 90° turns is 180°
;   2048 2D⊗2D lifts to 4D
;   4096 homog (4,6,2) projects to (2,3)
;   8192 affine identity+(0,2) sends (1,0) to (1,2)
; preludes: form-stdlib/core.fk form-stdlib/nd-geometry.fk
; witnessed: 2026-09-10 -> 16383

(do
    (defn ndb-bit (ok bit) (if ok bit 0))
    (let e1 (list 1 0 0 0))
    (let e2 (list 0 1 0 0))
    (let id (list (list 1 0) (list 0 1)))
    (let rot (list (list 0 (sub 0 1)) (list 1 0)))
    (let bridge (nd-bridge (list 0 0) (list 4 0) 2))
    (add (ndb-bit (eq (nd-dot e1 e2) 0) 1)
    (add (ndb-bit (value_eq (nd-project (list 3 4) (list 1 0)) (list 3 0)) 2)
    (add (ndb-bit (value_eq (nd-project-axis (list 1 2 3 4)) (list 1 2 3)) 4)
    (add (ndb-bit (value_eq (nd-fold-last (list 1 2 3 4)) (list 1 2 7)) 8)
    (add (ndb-bit (value_eq (nd-transform id (list 3 4)) (list 3 4)) 16)
    (add (ndb-bit (value_eq (nd-transform rot (list 1 0)) (list 0 1)) 32)
    (add (ndb-bit (and (eq (len bridge) 3)
                      (and (value_eq (head bridge) (list 0 0))
                           (value_eq (nth bridge 2) (list 4 0)))) 64)
    (add (ndb-bit (nothing? (nd-bridge (list 0 0) (list 3 0) 2)) 128)
    (add (ndb-bit (value_eq (nd-perp2 (list 3 4)) (list (sub 0 4) 3)) 256)
    (add (ndb-bit (value_eq (nd-cross3 (list 1 0 0) (list 0 1 0)) (list 0 0 1)) 512)
    (add (ndb-bit (value_eq (nd-transform (nd-compose rot rot) (list 1 0)) (list (sub 0 1) 0)) 1024)
    (add (ndb-bit (value_eq (nd-tensor2 (list 1 2) (list 3 4)) (list 3 4 6 8)) 2048)
    (add (ndb-bit (value_eq (nd-from-homog (list 4 6 2)) (list 2 3)) 4096)
         (ndb-bit (value_eq (nd-affine id (list 1 0) (list 0 2)) (list 1 2)) 8192)))))))))))))))
