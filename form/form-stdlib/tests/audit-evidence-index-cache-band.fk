; audit-evidence-index-cache-band.fk - dynamic evidence index round-trips as .fkb.
;
; preludes: form-stdlib/json.fk form-stdlib/audit-evidence-cells.fk

; Band verdict on fkwu today: 833, standing on two absences. Re-read 2026-07-25.
;
; A line I wrote here earlier on 2026-07-25 said "1023 when every check lands — DERIVED
; from the bit weights". That was a sum, not a witness. Two grounds sit under 833:
;
;   1. The corpus. docs/system_audit/ has never existed in this repository — checked
;      against the full 937-commit history, not the shallow 73 the clone arrived with.
;      See audit-evidence-cells-band.fk for the measurement.
;   2. The carrier. write_form_binary / read_form_binary are the fourth-arm host-io wall
;      this tree already names (mesh-sensings-store-band.fk says so in its own header).
;      They are registered in primitive-registry.fk and carried by no op row fkwu answers,
;      so every call here recovers to nothing under axiom-5 and the cache is never written.
;
; 833 = 512 + 256 + 64 + 1. Worth knowing about those bits rather than counting them: 64
; and 256 land on the NOT-FOUND fallback, which builds an empty node carrying the right
; category — so they read green off a miss. A weight that a miss can satisfy is not
; measuring what it looks like it measures, and that is true whether or not the corpus
; ever arrives.
;
(do
    (let cache-path "form-stdlib/.cache/audit-evidence-index-test.fkb")
    (let first-result (aec-ensure-index-cache ".." cache-path))
    (let second-result (aec-ensure-index-cache ".." cache-path))
    (let index (aec-read-index-cache cache-path))
    (let recipes (node_children index))
    (let known
        (aec-find-recipe-by-source
            recipes
            "docs/system_audit/commit_evidence_2026-06-07_json_lens_tending.json"))

    (add
        (add
            (add
                (if (aec-cache-result? second-result) 1 0)
                (if (str_eq (aec-cache-status second-result) "fresh") 2 0))
            (add
                (if (eq (file_size cache-path) (aec-cache-bytes second-result)) 4 0)
                (if (gt (aec-cache-source-count second-result) 600) 8 0)))
        (add
            (add
                (if (ge (aec-cache-mtime second-result) (aec-cache-source-max-mtime second-result)) 16 0)
                (if (node_eq (node_category index) (AEC-BP-EVIDENCE-INDEX)) 32 0))
            (add
                (if (node_eq (node_category known) (AEC-BP-EVIDENCE-CELL)) 64 0)
                (add
                    (if (str_eq (aec-recipe-local-status known) "pass") 128 0)
                    (add
                        (if (eq (aec-recipe-phase-can-move? known) false) 256 0)
                        (if (or (str_eq (aec-cache-status first-result) "write") (str_eq (aec-cache-status first-result) "fresh")) 512 0)))))))
