; preludes: form/form-stdlib/bml/wall-census.bml form/form-stdlib/line-grammar.fk
; Expected: 63
; PROOF LEVEL: FKWU-STAGED — it preludes a .bml and walks this checkout.
;
; wall-census-band — the lens that asks a written limit whether anyone ran it.
;
; Urs, 2026-09-10: "that wall is not real, it just needs attention, like all other wall we have invented
; and then taking as fact instead of question." The same day a gaps table read "W'v — a transposed matvec |
; nothing, for any quantisation or f32. This is the wall." It had never been attempted and took an
; afternoon; and the file said "Q8_0 — no carver anywhere in the body" beside a Q8_0 band at 1023 (corpus
; row 1422 walltest). The lens cannot know whether a limit is TRUE. It asks the one question that
; separates a measurement from a sentence: does it carry a witness?
;
; Verdict 63:
;   1   a limit written with nothing beside it reads as bare
;   2   a limit with a band, a verdict or a number on its own line reads as witnessed
;   4   a witness on the line UNDER a claim counts, and one on the line above does not — a table row
;       often carries the mark and its evidence apart, and the file must be read in the order written
;   8   this body's "cannot" is mostly the good kind ("a paren cannot rearrange them" proves something
;       cannot go wrong), so it is soft and never counted as a wall
;   16  the walk reads the DOCS as well as the cells — the walls live in .md files
;   32  a real walk of receipts/ finds limits written in its .md files — where "Named, not attempted"
;       lives
(do
    (let r1 (wln-scan (list "| Q8_0 | ⬜ no carver anywhere in the body |" "| thing | fine |") "fx" (list)))
    (let c0 (if (and (eq (len r1) 1) (eq (wln-r-wit (head r1)) 0)) 1 0))
    (let r2 (wln-scan (list "| W'v | ⬜ this is the wall, and matvec-t-band reads 127 |") "fx" (list)))
    (let c1 (if (and (eq (len r2) 1) (eq (wln-r-wit (head r2)) 1)) 2 0))
    (let r3 (wln-scan (list "| gather | ⬜ not attempted |" "|  | measured 0.05 ms on this host |") "fx" (list)))
    (let r4 (wln-scan (list "|  | measured 0.05 ms on this host |" "| gather | ⬜ not attempted |") "fx" (list)))
    (let c2 (if (and (eq (wln-r-wit (head r3)) 1) (eq (wln-r-wit (head r4)) 0)) 4 0))
    (let good "a paren cannot rearrange them")
    (let c3 (if (and (eq (wln-claim? good) 0) (eq (wln-soft? good) 1)) 8 0))
    (let c4 (if (and (and (eq (wln-ext-ok? "a.md") 1) (eq (wln-ext-ok? "a.bml") 1))
                     (and (eq (wln-ext-ok? "a.fk") 1) (eq (wln-ext-ok? "a.txt") 0))) 16 0))
    (defn wcb-md? (rs) (if (eq (len rs) 0) 0 (if (ge (str_find (wln-r-path (head rs)) ".md" 0) 0) 1 (wcb-md? (tail rs)))))
    (let c5 (if (eq (wcb-md? (wln-bare (wln-walk (wln-files "receipts" (list)) (list)) (list))) 1) 32 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
