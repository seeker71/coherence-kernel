(let LWRSR-OWNER (bp "LWRSR-OWNER"))
(let LWRSR-PURPOSE (bp "LWRSR-PURPOSE"))
(let LWRSR-ACTION (bp "LWRSR-ACTION"))
(let LWRSR-LENS (bp "LWRSR-LENS"))

(do
    (let started
        (lcfb-open-stream "living-world-session-real-report"
