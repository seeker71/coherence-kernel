        (if (eq (lwrs-digest? dataset) 1) 2 0)
        (if (eq (lwrs-digest? contract) 1) 4 0)
        (if (eq (lwrs-metrics-valid? historical-metrics) 0) 8 0)
        (if (eq report-valid 0) 16 0)
        (if (eq (lwrs-consent-shape-valid? consent) 1) 32 0)
        (if (eq (lwrs-consent-scopes?
