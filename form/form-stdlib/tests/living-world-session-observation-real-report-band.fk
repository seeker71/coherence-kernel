            "lwrs-report-valid?" "historical-privacy-safe-fields" 2 started
            "form/form-stdlib/tests/living-world-session-observation-real-report-band.fk"
            52 9))
    (let gate-enter
        (lcfb-call-stream "living-world-session-real-report"
