            "f197839c6fbb6513d8d19d02319a66464a30bbdbc108393506885c81b6417631"))
    (let dataset
        (lwrs-digest
            "be57aefc16712643eacebad649aeb5d7092c0a8faa9a393cfd69e222ed8ee4ea"))
    (let contract
