; preludes: form-stdlib/core.fk form/form-stdlib/form-fs.fk form/form-stdlib/born-under.bml
; Expected: 31
; PROOF LEVEL: FOURTH-ARM ONLY (host_spawn, host_processes and a parent that ends: fkwu doors)
;
; born-under-band — a kernel ends itself once the parent it was born under is gone, and not before.
;
; On 2026-09-11 three glass organs ran five hours under pid 1: the Codex session that started their
; fleet ended the carrier with `kill -TERM`, which skips the carrier's own end of its organs, and no
; organ asked whether its carrier lived. born-under.bml reads a kernel's parent at birth from the host's
; process table and answers whether that parent is still its parent; the glass organs ask it every two
; seconds. Here the same watcher is started twice: under this band, which stays, and under a kernel
; that ends.
;
; Verdict 31:
;   1  a watcher this band starts reads this band as the parent it was born under
;   2  two seconds later it is alive and has not said it released
;   4  a watcher started by a kernel that then ends is gone within three seconds of that end
;   8  and it said so: it ended by its own reading ("released"), not by a crash or its ten-second bound
;  16  the rule's edges: born under pid 1, or unread, is held; a parent unread now is held; the same
;      parent is held; a parent that became pid 1 is not
(do
    (defn bub-path (pid) (str_concat ".hearth/born-under-" (str_concat (int_to_str pid) ".said")))
    (defn bub-said (pid) (if (lt (file_size (bub-path pid)) 0) "" (read_file (bub-path pid))))
    (defn bub-has? (s w) (if (ge (str_find s w 0) 0) 1 0))
    (let mk (fs-mkdir ".hearth"))
    (let me (host_pid))
    (let w1 (host_spawn_quiet (list "./fkwu" "observe/tests/born-under-watcher.fk")))
    (let rest (host_sleep_ms 2000))
    (let s1 (bub-said w1))
    (let a1 (host_alive w1))
    (let out (host_capture (list "./fkwu" "observe/tests/born-under-leaver.fk")))
    (let w2 (str_to_int (substring out 0 (str_find out "\n" 0))))
    (let settle (host_sleep_ms 3000))
    (let a2 (host_alive w2))
    (let s2 (bub-said w2))
    (let k1 (host_kill w1))
    (let r1 (host_wait w1))
    (let g1 (fs-remove-file (bub-path w1)))
    (let g2 (fs-remove-file (bub-path w2)))

    (let told (print (list "me" me "w1" w1 "said1" s1 "alive1" a1 "w2" w2 "said2" s2 "alive2" a2)))
    (let c0 (if (eq (bub-has? s1 (str_concat "born " (int_to_str me))) 1) 1 0))
    (let c1 (if (and (eq a1 1) (eq (bub-has? s1 "released") 0)) 2 0))
    (let c2 (if (and (gt w2 0) (eq a2 0)) 4 0))
    (let c3 (if (eq (bub-has? s2 "released") 1) 8 0))
    (let c4 (if (and (eq (bun-held-by 5 1) 1) (and (eq (bun-held-by 5 (sub 0 1)) 1)
                (and (eq (bun-held-by (sub 0 1) 500) 1) (and (eq (bun-held-by 500 500) 1) (eq (bun-held-by 1 500) 0))))) 16 0))
    (add c0 (add c1 (add c2 (add c3 c4)))))
