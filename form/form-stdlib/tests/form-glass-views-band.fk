; Pure all-view/interaction regression, no sensor publication or admission.
; Expected: 262143
; preludes: form/form-stdlib/bml/glass-view-audit.bml observe/bidirectional-framebuffer-channel.fk
(defn gvb-check (name ok weight)
  (do (print (list name ok)) (if (eq ok 1) weight 0)))
(defn gvb-metric (domain id value)
  (fgo-int domain id id value "bytes" 0 "cpu-arena" "physical-live" "fixture" "live" domain "fixture"))
(defn gvb-many (n)
  (if (eq n 0) (list)
    (cons (gvb-metric "memory" (str_concat "row." (int_to_str n)) n) (gvb-many (sub n 1)))))
(defn gvb-text (lines) (ftc-ansi-segment-lines lines))
(defn gvb-has (text part) (ge (str_find text part 0) 0))
(defn gvb-line-width (segments)
  (if (eq (len segments) 0) 0 (add (ftc-text-width (ftc-segment-text (head segments))) (gvb-line-width (tail segments)))))
(defn gvb-fit (lines width)
  (if (eq (len lines) 0) 1 (and (le (gvb-line-width (head lines)) width) (gvb-fit (tail lines) width))))
(defn gvb-frame-ok (data view width height)
  (do
    (let lines (fgd-segment-frame-lines (fgva-frame data view width height)))
    (and (eq (len lines) height) (gvb-fit lines width))))
(defn gvb-all-views (data views)
  (if (eq (len views) 0) 1
    (and (gvb-frame-ok data (head views) 80 24)
      (and (gvb-frame-ok data (head views) 160 40)
        (and (gvb-frame-ok data (head views) 1 1)
          (and (gvb-frame-ok data (head views) 20 4) (gvb-all-views data (tail views))))))))
(defn gvb-sample (id kind)
  (fgtm-sample id (fgtm-absent) kind "form" "fixture" "fixture" "fixture"
    (fgtm-absent) (fgtm-present 1) "live" (fgtm-present 1000) (fgtm-present 1000)
    (fgtm-absent) (fgtm-absent) "never" "physical-live" "fixture" (list "all" "fixture")))
(do
  (let rows (gvb-many 150))
  (let first (head rows))
  (let last (nth rows 149))
  (let selector (fgd-metric-selector last))
  (let metricLines (fgd-metric-segment-lines rows 80))
  (let keys (fglui-selection-projections selector rows (list) (list)))
  (let observations (fgov2-structure-from-counts (list 10 3 5 32 64) (fgl-v2-provenance 1000 1)))
  (let event (gvb-sample "event.fixture" "event"))
  (let channel (gvb-sample "channel.fixture" "channel"))
  (let samples (list event channel))
  (let data (list 1000 (fgd-take rows 20) samples observations (list)))
  (let sameId (list (gvb-metric "metal" "allocated-bytes" 11) (gvb-metric "mlx" "allocated-bytes" 22)))
  (let start (fgl-input-context (fgl-control-state-full "all" "fixture" 0 "held" "memory" "all" "none" 0) rows observations))
  (let previous (fgl-input-apply start samples "inspect" (fgd-metric-selector (nth rows 148)) 1000))
  (let out (bfc-envelope 0 908 0 (list "selected-index" 148 "target-index" 149) previous))
  (let observed (bfc-record-out out 0))
  (let inbound (bfc-control out 5))
  (let received (bfc-record-in inbound 1))
  (let moved (bfc-apply out inbound previous (fgl-input-move previous samples 1 1000)))
  (let after (bfc-record-out (bfc-envelope 0 908 0 (list "selected-index" (fgl-input-key-index (fglui-metric-keys rows) (fgl-control-selected moved) 0)) previous) 2))
  (let inspected (fgl-input-key moved samples "e" 1000))
  (let held (fgsr-held-at 7 1000 (list (fgo-observe-row first 1000 7)) 50))
  (let late (fgo-age-rows-at (fgsr-rows-or-absent-at "fixture" held 1200) 1200))
  (let body (fglui-body 80 20 1000 "memory" "all" selector 1 rows samples (list) observations))
  (let eventBody (fglui-body 80 20 1000 "events" "all" (fgtm-sample-selection-id event) 1 rows samples (list) observations))
  (sum (list
    (gvb-check "all-12-views-four-dimensions" (and (eq (len (fgva-views)) 12) (gvb-all-views data (fgva-views))) 1)
    (gvb-check "shared-projection-is-not-row-identity" (node_eq (fgo-projection-node first) (fgo-projection-node last)) 2)
    (gvb-check "selection-finds-row-150-not-shape-first" (eq (fgvp-index metricLines keys 0) 149) 4)
    (gvb-check "domain-qualified-metric-collision" (eq (fgo-int-value (fglui-find-selected-metric sameId "metric.mlx.allocated-bytes")) 22) 8)
    (gvb-check "legacy-metric-selector-still-resolves" (eq (fgo-int-value (fglui-find-selected-metric rows "metric.row.1")) 1) 16)
    (gvb-check "navigation-passes-old-128-cap" (str_eq (fgl-control-selected moved) selector) 32)
    (gvb-check "control-context-survives-inspect-and-evidence" (and (eq (len inspected) 12) (and (eq (len (nth inspected 10)) 150) (eq (fgl-control-evidence-open? inspected) 1))) 64)
    (gvb-check "selected-memory-and-evidence-visible" (and (eq (len body) 20) (and (gvb-has (gvb-text body) "E metric.memory.row.1=") (gvb-has (gvb-text body) "rows above="))) 128)
    (gvb-check "event-evidence-is-not-discarded" (gvb-has (gvb-text eventBody) (str_concat "E " (fgtm-sample-selection-id event))) 256)
    (gvb-check "event-filter-no-false-dead-publisher" (gvb-has (gvb-text (fglui-body 80 20 1000 "events" "no-match" "none" 0 rows samples (list) observations)) "no matching event rows") 512)
    (gvb-check "channel-filter-no-false-dead-publisher" (gvb-has (gvb-text (fglui-body 80 20 1000 "channels" "no-match" "none" 0 rows samples (list) observations)) "no matching channel rows") 1024)
    (gvb-check "frame-sequence-is-not-a-duration" (str_eq (fgo-unit (head late)) "sequence") 2048)
    (gvb-check "frame-age-preserves-publisher-time" (and (eq (fgo-age (head late)) 200) (eq (fgo-observed-epoch (head late)) 1000)) 4096)
    (gvb-check "stale-values-stay-stale" (and (str_eq (fgo-evidence (nth late 1)) "silent") (eq (fgo-int-value (nth late 1)) 150)) 8192)
    (gvb-check "typed-selection-reaches-exact-row" (ge (fgvp-index (fglui-observation-lines observations 1000 80) (fglui-selection-projections "recipes.allocation.bytes" rows samples observations) 0) 0) 16384)
    (gvb-check "empty-navigation-keeps-state" (str_eq (fgl-control-selected (fgl-input-move (fgl-input-context start (list) (list)) (list) 1 1000)) "none") 32768)
    (gvb-check "duplicate-keys-cannot-trap-tab" (eq (len (fglui-navigation-keys (append rows rows) samples (list) "memory" "all")) 150) 65536)
    (gvb-check "summary-hidden-field-becomes-visible" (ge (fgvp-index (fglui-ensure-selected (list (fgd-title-segment-line "summary" 80 "fixture")) selector rows samples observations 1000 80) keys 0) 0) 131072))))
