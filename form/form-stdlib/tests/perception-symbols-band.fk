; perception-symbols-band.fk — everything perceived carries a symbol, and every
; symbol goes both ways.
;
; The words a line closes on already resolve to symbols. This band is the rest of the
; point: the room's kind, the colour of its own quiet, the ear's condition and the
; seven voice-manner axes. Each of the twenty is proved BOTH ways — the symbol and its
; English phrase resolve back to it, and a token this body has no meaning for resolves
; to nothing rather than to something plausible.
;
; Every bit folds over rows written by hand, so the band answers the same on a silent
; Mac, a mic never granted and a room full of voices: a band proves the cell, only the
; door witnesses the body (observe/perception-say-run.fk is that door).
;
; Expected: 8191.
; preludes: form-stdlib/perception-symbols.bml form-stdlib/meaning-codes.bml
(do
    (defn psb-bit (ok w) (if ok w 0))
    (defn psb-has? (hay needle) (if (ge (str_find hay needle 0) 0) 1 0))
    ; every symbol belongs to exactly one of the four families
    (defn psb-one-family? (syms)
        (if (eq (len syms) 0) 1
            (if (eq (str_len (ps-family (head syms))) 0) 0
                (if (eq (mc-member? (ps-families) (ps-family (head syms))) 1) (psb-one-family? (tail syms)) 0))))
    (defn psb-all-nl? (syms) (if (eq (len syms) 0) 1 (if (gt (str_len (ps-nl (head syms))) 0) (psb-all-nl? (tail syms)) 0)))
    ; the symbol code resolves back to the symbol, inside the perception roster
    (defn psb-sym-round? (syms) (if (eq (len syms) 0) 1 (if (str_eq (mc-perceived (head syms)) (head syms)) (psb-sym-round? (tail syms)) 0)))
    ; and so does the English phrase — the word roster must NOT claim it
    (defn psb-nl-round? (syms)
        (if (eq (len syms) 0) 1
            (if (str_eq (mc-perceived (ps-nl (head syms))) (head syms))
                (if (eq (str_len (mc-resolve (ps-nl (head syms)))) 0) (psb-nl-round? (tail syms)) 0) 0)))
    (defn psb-node8? (syms)
        (if (eq (len syms) 0) 1
            (if (eq (str_len (mc-anchor (head syms))) 8) (if (eq (sv-hex? (mc-anchor (head syms)) 0) 1) (psb-node8? (tail syms)) 0) 0)))
    ; every manner names one row of its own, and that row names the manner back
    (defn psb-manner-round? (syms)
        (if (eq (len syms) 0) 1
            (if (eq (str_len (ps-manner-door (head syms))) 0) 0
                (if (str_eq (ps-manner-of (ps-manner-door (head syms))) (head syms)) (psb-manner-round? (tail syms)) 0))))
    (defn psb-said? (syms kind)
        (if (eq (len syms) 0) 1
            (if (eq (str_len (mc-say-in (head syms) kind)) 0) 0 (psb-said? (tail syms) kind))))

    ; ── one frame of rows, written by hand: a voice in a hissy room, two manners
    ;    carrying a reading and one whose own door answered nothing ──────────────
    (let rows (list
        (fgo-text "ear" "ear.state" "the ear" "speaking — grown" "organ" "physical-live" "ear" "live" "voice" "n")
        (fgo-text "room" "room.kind" "what kind of sound this is" "voice" "room" "physical-live" "room" "live" "room" "n")
        (fgo-text "room" "room.tone" "the room's signature" "-44 dBFS, hissy, steady 8 s" "room" "physical-live" "room" "live" "room" "n")
        (fgo-int "prosody" "prosody.pitch" "the voice's fundamental" 128 "hertz" 0 "room" "physical-live" "prosody" "live" "prosody" "n")
        (fgo-int "prosody" "prosody.volume" "the room's level now" -44 "dbfs" 0 "room" "physical-live" "prosody" "live" "prosody" "n")
        (fgo-unavailable "prosody" "prosody.cadence.rate" "the pace of the speaking" "onsets-per-minute" "room" "prosody.onsets" "prosody" "no onset in the window")))
    (let seen (ps-perceive rows))
    (let syms (ps-syms seen))
    ; the same frame after its publisher stopped giving: the glass rewrites every row's truth
    ; to silent (fgsr-rows-or-absent does this for a frame older than three declared cadences)
    (let silent (fgo-rows-with-truth rows "silent" "silent"))

    (sum (list
        ; 1 — the roster: twenty perceived things, four families, each in exactly one
        (psb-bit (and (eq (len (ps-symbols)) 20)
                      (and (eq (len (ps-families)) 4)
                           (and (eq (psb-one-family? (ps-symbols)) 1)
                                (and (eq (str_len (ps-family "zorble")) 0) (eq (ps-symbol? "zorble") 0))))) 1)
        ; 2 — every symbol carries an English phrase; a token this body does not perceive carries none
        (psb-bit (and (eq (psb-all-nl? (ps-symbols)) 1) (eq (str_len (ps-nl "zorble")) 0)) 2)
        ; 4 — every symbol addresses: eight hex, its own anchor, and two symbols differ
        (psb-bit (and (eq (psb-node8? (ps-symbols)) 1)
                      (and (str_eq (mc-anchor "air") (mc-node "air")) (not (str_eq (mc-anchor "air") (mc-anchor "hiss"))))) 4)
        ; 8 — the symbol resolves back to itself inside the perception roster
        (psb-bit (eq (psb-sym-round? (ps-symbols)) 1) 8)
        ; 16 — so does its English phrase, and the word roster does not claim it:
        ;      a spoken "still" stays a word, the room being still is a different thing
        (psb-bit (and (eq (psb-nl-round? (ps-symbols)) 1) (eq (mc-member? (mc-meanings) "still") 0)) 16)
        ; 32 — a thing this body has no meaning for refuses instead of guessing
        (psb-bit (and (eq (str_len (mc-perceived "zorble-nothing")) 0)
                      (and (eq (len (mc-perceived-all "zorble-nothing")) 0)
                           (str_eq (mc-line-in (list "zorble-nothing") "german") "[zorble-nothing?]"))) 32)
        ; 64 — every symbol speaks in every tongue the locale rows carry, and the word comes back
        (psb-bit (and (eq (psb-said? (ps-symbols) "german") 1)
                      (and (eq (psb-said? (ps-symbols) "persian") 1)
                           (and (str_eq (mc-say-in "air" "german") "luftig") (str_eq (mc-perceived "luftig") "air")))) 64)
        ; 128 — a tongue with no cell yet says so rather than inventing a word for it
        (psb-bit (and (eq (str_len (mc-say-in "release" "french")) 0)
                      (and (str_eq (mc-line-in (list "release") "french") "[release?]")
                           (str_eq (mc-say-in "release" "german") "freigab"))) 128)
        ; 256 — each perceived thing is read off the sensor's OWN value, and a value naming none reads none
        (psb-bit (and (str_eq (ps-kind-of "still") "still")
                      (and (str_eq (ps-colour-of "-50 dBFS, airy, steady 3 s") "air")
                           (and (str_eq (ps-state-of "asleep — write .hearth/ear.wanted to wake it") "asleep")
                                (and (eq (str_len (ps-kind-of "weather")) 0)
                                     (and (eq (str_len (ps-colour-of "-50 dBFS, steady")) 0) (eq (str_len (ps-state-of "dreaming — x")) 0)))))) 256)
        ; 512 — every manner names one row of its own and that row names the manner back; a room row names none
        (psb-bit (and (eq (psb-manner-round? (ps-manners)) 1)
                      (and (eq (str_len (ps-manner-of "room.kind")) 0) (eq (str_len (ps-manner-of "prosody.line")) 0))) 512)
        ; 1024 — the whole perception of one frame is one line, in the order a room is read
        (psb-bit (and (str_eq (ps-line seen) "speaking voice hiss pitch volume")
                      (and (eq (len seen) 5)
                           (and (str_eq (ps-seen-family (head seen)) "ear-state")
                                (and (str_eq (ps-seen-door (nth seen 3)) "prosody.pitch")
                                     (str_eq (ps-seen-reading (nth seen 3)) "128 hertz"))))) 1024)
        ; 2048 — a door that answered nothing is not a perception: it stays out of the line and is named
        (psb-bit (and (eq (psb-has? (ps-line seen) "cadence") 0)
                      (and (eq (len (ps-unsensed rows)) 5)
                           (and (str_eq (head (ps-unsensed rows)) "cadence")
                                (str_eq (mc-line-in syms "romanian") "o linie este deschisă, o voce, șuierător, înălțimea vocii, nivelul camerei")))) 2048)
        ; 4096 — a publisher that stopped giving is not a room: every row of a silent frame reads
        ; as nothing, so a dead sensor's last confident words cannot become a live perception
        (psb-bit (and (eq (str_len (ps-line-of silent)) 0)
                      (and (eq (len (ps-perceive silent)) 0)
                           (and (eq (ps-live? (head rows)) 1)
                                (and (eq (ps-live? (head silent)) 0)
                                     (eq (len (ps-unsensed silent)) 7))))) 4096))))
