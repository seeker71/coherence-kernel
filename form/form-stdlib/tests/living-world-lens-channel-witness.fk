; living-world-lens-channel-witness.fk -- two directions retain source and lens.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk

(let LWLCW-SOURCE      (bp "LWLCW-SOURCE"))
(let LWLCW-RESONATED   (bp "LWLCW-RESONATED"))
(let LWLCW-ILLUMINATED (bp "LWLCW-ILLUMINATED"))
(let LWLCW-RETURNED    (bp "LWLCW-RETURNED"))
(let LWLCW-EVIDENCE    (bp "LWLCW-EVIDENCE"))
(let LWLCW-FLOW        (bp "LWLCW-FLOW"))
(let LWLCW-CHANGES     (bp "LWLCW-CHANGES"))
(let LWLCW-DIRECTION-A (bp "LWLCW-DIRECTION-A"))
(let LWLCW-DIRECTION-B (bp "LWLCW-DIRECTION-B"))
(let LWLCW-SOURCE-A    (bp "LWLCW-SOURCE-A"))
(let LWLCW-PROVENANCE  (bp "LWLCW-PROVENANCE"))
(let LWLCW-ACTION      (bp "LWLCW-ACTION"))

(defn lwlcw-cell (kind) (intern_node kind (empty)))
(defn lwlcw-evidence () (lwlcw-cell LWLCW-EVIDENCE))
(defn lwlcw-pure () (lwlcw-cell LWLCW-SOURCE))
(defn lwlcw-resonated () (lwlcw-cell LWLCW-RESONATED))
(defn lwlcw-illuminated () (lwlcw-cell LWLCW-ILLUMINATED))
(defn lwlcw-returned () (lwlcw-cell LWLCW-RETURNED))
(defn lwlcw-flow () (lwlcw-cell LWLCW-FLOW))
(defn lwlcw-changes () (lwlcw-cell LWLCW-CHANGES))
(defn lwlcw-direction-a () (lwlcw-cell LWLCW-DIRECTION-A))
(defn lwlcw-direction-b () (lwlcw-cell LWLCW-DIRECTION-B))
(defn lwlcw-source-a () (lwlcw-cell LWLCW-SOURCE-A))
(defn lwlcw-provenance () (lwlcw-cell LWLCW-PROVENANCE))
(defn lwlcw-action () (lwlcw-cell LWLCW-ACTION))
(defn lwlcw-named-action (name)
    (intern_node (bp "LWLCW-NAMED-ACTION")
        (list (intern_trivial_string name))))

(defn lwlcw-blueprint-lens ()
    (lwlc-lens (lwlc-blueprint-shape) LWLCW-RESONATED
        (lwlcw-evidence)))
(defn lwlcw-recipe ()
    (intern_node (bp "add")
        (list (intern_trivial_int 2) (intern_trivial_int 3))))
(defn lwlcw-recipe-lens ()
    (lwlc-lens (lwlc-recipe-shape) (lwlcw-recipe)
        (lwlcw-evidence)))
(defn lwlcw-cell-lens ()
    (lwlc-lens (lwlc-cell-shape) (lwlcw-illuminated)
        (lwlcw-evidence)))
(defn lwlcw-alternative-lens ()
    (lwlc-lens (lwlc-cell-shape) (lwlcw-returned)
        (lwlcw-evidence)))

(defn lwlcw-choice ()
    (lwlc-choice
        (lwlcw-named-action "observe")
        (lwo-field
            (list
                (lwlcw-named-action "be")
                (lwlcw-named-action "do")
                (lwlcw-named-action "integrate")
                (lwlcw-named-action "release")
                (lwlcw-named-action "digest")
                (lwlcw-named-action "transmute")
                (lwlcw-named-action "illuminate")
                (lwlcw-named-action "identify")))
        (lwlc-unknown (lwlcw-evidence))
        (lwlcw-evidence)))

(defn lwlcw-out-stack ()
    (lwlc-stack
        (lwlcw-blueprint-lens)
        (lwlc-layers
            (list (lwlcw-recipe-lens) (lwlcw-cell-lens)))
        (lwo-field (list (lwlcw-alternative-lens)))
        (lwlc-unknown (lwlcw-evidence))
        (lwlcw-evidence)))

(defn lwlcw-return-stack ()
    (lwlc-stack (lwo-none)
        (lwlc-layers (list (lwlcw-cell-lens)))
        (lwo-empty-field) (lwo-none) (lwo-none)))

(defn lwlcw-out-declaration ()
    (lwlc-declaration (lwlcw-direction-a)
        (lwlcw-out-stack) (lwlcw-evidence)))
(defn lwlcw-return-declaration ()
    (lwlc-declaration (lwlcw-direction-b)
        (lwlcw-return-stack) (lwlcw-evidence)))

(defn lwlcw-out-pass-for-result (observed-result)
    (do
        (let first
            (lwlc-step (lwlcw-pure) (lwlcw-blueprint-lens)
                (lwo-none) (lwlcw-resonated)
                (lwlcw-flow) (lwlcw-changes)
                (lwlcw-choice) (lwlcw-evidence)))
        (let execution
            (lwlc-execution (lwlcw-recipe-lens)
                (lwlcw-resonated) observed-result
                (lwlcw-flow) (lwlcw-changes)))
        (let second
            (lwlc-step-from-execution execution
                (lwo-none) (lwlcw-evidence)))
        (let third
            (lwlc-step (lwlc-execution-result execution)
                (lwlcw-cell-lens) (lwo-none)
                (lwlcw-illuminated)
                (lwlcw-flow) (lwlcw-changes)
                (lwo-none) (lwlcw-evidence)))
        (lwlc-pass (lwlcw-out-declaration)
            (lwlcw-pure) (lwlcw-pure)
            (lwlc-steps (list first second third))
            (lwlcw-illuminated) (lwlcw-evidence))))

(defn lwlcw-out-pass ()
    (lwlcw-out-pass-for-result (intern_trivial_int 5)))

(defn lwlcw-return-pass ()
    (do
        (let step
            (lwlc-step (lwlcw-illuminated)
                (lwlcw-cell-lens) (lwo-none)
                (lwlcw-returned)
                (lwlcw-flow) (lwlcw-changes)
                (lwo-none) (lwlcw-evidence)))
        (lwlc-pass (lwlcw-return-declaration)
            (lwlcw-pure) (lwlcw-illuminated)
            (lwlc-steps (list step))
            (lwlcw-returned) (lwlcw-evidence))))

(defn lwlcw-exchange ()
    (lwlc-exchange (lwlcw-pure)
        (lwlcw-out-pass) (lwlcw-return-pass)
        (lwo-field
            (list
                (oac-alternative (lwlcw-out-pass)
                    (lwlcw-return-pass) (lwlcw-evidence))))
        (lwlc-unknown (lwlcw-evidence))
        (lwlcw-evidence)))

(defn lwlcw-entry (payload)
    (lwt-entry
        (lwo-offer (lwlcw-source-a)
            (lwo-interface (list (lwlcw-action))) 1 payload
            (lwlcw-provenance) 1)
        (lwlcw-action)))

(defn lwlcw-world ()
    (lwt-receive-stream (lwo-empty-world)
        (list
            (lwlcw-entry (lwlcw-out-declaration))
            (lwlcw-entry (lwlcw-return-declaration))
            (lwlcw-entry (lwlcw-exchange)))))

(defn lwlcw-revoked-world ()
    (lwt-receive-stream (lwlcw-world)
        (list
            (lwlcw-entry
                (lwo-revocation (lwlcw-return-declaration)
                    (lwlcw-source-a)
                    (lwlcw-named-action "release")
                    (lwlcw-provenance))))))

(defn lwlcw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwlcw-sum (tail items)))))
