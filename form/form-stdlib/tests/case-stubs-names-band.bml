; case-stubs-names-band.bml — the case-under-stubs refusal names the definitions it stubbed (form-cli-local-plan.bml, flp-stubs).
;
; A planner told "each named definition a stub" hears no name: its next proposal has to recover which definitions the walk read.
;
; Expected: 7
; Verdict 7 when every claim lands:
;   1   the refusal of a one-definition manifest names that definition
;   2   the refusal of a two-definition manifest names both, in order
;   4   the refusal keeps its kind, its case number and the words a stub
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-local-plan.bml form-stdlib/bml/live.bml
section [form.bml] {
 class CaseStubsNamesBand {
  def csn-door() = "form/form-stdlib/tests/fixtures/local-plan-door-flow.bml";
  def csn-req() = parse-json("req", "{\"id\":\"csn-fixture\",\"title\":\"a fixture\",\"needs\":\"lpdf-rows holds each value three times\",\"files\":[\"" ++ csn-door() ++ "\"]}");
  def csn-manifest(names) = "<plan>{\"id\":\"csn-door\",\"writable\":[\"" ++ csn-door() ++ "\"],\"definitions\":[" ++ flp-join(map(n => "{\"name\":\"" ++ n[0] ++ "\",\"params\":[" ++ n[1] ++ "]}", names), ",") ++ "]}</plan><goal>The change: " ++ flp-join(map(n => n[0], names), ", ") ++ ".</goal>";
  def csn-seven() = "[{\"function\":\"lpdf-rows\",\"arguments\":[1],\"equals\":[1,1,1]}," ++ flp-join(map(i => "{\"call\":\"lpdf-rows(1); 7\",\"equals\":7}", 0 .. 7), ",") ++ "]";
  def csn-reply(names, ref) = csn-manifest(names) ++ "<cases>" ++ csn-seven() ++ "</cases><reference>" ++ ref ++ "</reference>";
  def csn-voice(root, text, packet) {
   let path = root ++ "/reply";
   let put = write_file_text(path, text);
   ["answered", text, len(packet), 100, path];
  }
  def csn-walk(ctx, name, names, ref) {
   let root = ctx ++ "/" ++ name;
   let made = flp-mkdirs(root);
   let seeded = write_file_text(root ++ "/queue.jsonl", "");
   let walking = flp-ctx((packet, n1, n, lens) => csn-voice(root, csn-reply(names, ref), packet), ["voice-a"], 1, root ++ "/queue.jsonl", root ++ "/land", root ++ "/scratch", root ++ "/ledger.jsonl", 120000);
   let walked = flp-walk-from(csn-req(), walking, []);
   filter(r => (String) flp-text(r, "rung") != "recheck", flp-queue-rows(root ++ "/ledger.jsonl"))[-1];
  }
  def csn-one(ctx) = csn-walk(ctx, "one", [["lpdf-rows", "\"x\""]], "def lpdf-rows(x) = [x, x, x];");
  def csn-two(ctx) = csn-walk(ctx, "two", [["lpdf-rows", "\"x\""], ["lpdf-flow", ""]], "def lpdf-rows(x) = [x, x, x];\n  def lpdf-flow() = 3;");
  def csn-has?(row, word) = str_find(flp-text(row, "failure"), word, 0) >= 0;
  def csn-c-one(ctx) = csn-has?(csn-one(ctx), "definition (lpdf-rows) a stub");
  def csn-c-two(ctx) = csn-has?(csn-two(ctx), "definition (lpdf-rows, lpdf-flow) a stub");
  def csn-c-kept(ctx) {
   let r = csn-one(ctx);
   flp-starts?(flp-text(r, "kind"), "case-under-stubs:") && csn-has?(r, "of your <cases> holds with") && csn-has?(r, "a stub, both answering (nothing)");
  }
 }
 let root = temp_dir() ++ "/case-stubs-names-band-" ++ host_pid().str();
 let made = flp-mkdirs(root);
 live-claims("case-stubs-names-band", root, [["one", 1, 1, csn-c-one], ["two", 2, 1, csn-c-two], ["kept", 4, 1, csn-c-kept]]);
}
