; form-knowledge-public-query-offer-batch-band.fk -- pure offer/evidence proof.
;
; Synthetic local reports exercise the answer-free public offer boundary.  No
; model, carrier, private prompt, or consent material is reached.
;
; Expected: 8388607
; preludes: form-stdlib/form-knowledge-public-query-offer-batch.fk
; PROOF BAND (fkwu): 8388607

(do
    (defn fkpqob-bit (ok bit) (if ok bit 0))
    (defn fkpqob-run-id () (nmfe-sha256 "public-query-offer-band-run"))
    (defn fkpqob-model-id () "synthetic-local-qwen")
    (defn fkpqob-residence-id ()
        (nmfe-sha256 "public-query-offer-band-residence"))

    (defn fkpqob-line (name value)
        (str_concat "\n" (str_concat name (str_concat "=" value))))
    ; counts = lookups searches honored hits commits misses nothings spent
    ;          injection-refusals timeout frame-refusals bound-matches
    ;          bound-mismatches
    (defn fkpqob-counts
        (lookups searches honored hits commits misses nothings spent
         injection-refusals timeout frame-refusals bound-matches
         bound-mismatches)
        (list lookups searches honored hits commits misses nothings spent
              injection-refusals timeout frame-refusals bound-matches
              bound-mismatches))
    (defn fkpqob-good-counts (n)
        (fkpqob-counts n n n n n 0 0 0 0 0 0 n 0))
    (defn fkpqob-failure-counts (kind)
        (fkpqob-counts 1 1 1 1 1
            (if (str_eq kind "miss") 1 0)
            (if (str_eq kind "nothing") 1 0)
            (if (str_eq kind "spent") 1 0)
            (if (str_eq kind "injection-refusal") 1 0)
            (if (str_eq kind "timeout") 1 0)
            (if (str_eq kind "frame-refusal") 1 0)
            1 0))
    (defn fkpqob-wrong-second-binding-counts ()
        (fkpqob-counts 2 2 2 2 2 0 0 0 0 0 0 1 1))
    (defn fkpqob-refined-query ()
        (fkpqo-query "gl-register duplicate names"))
    (defn fkpqob-third-query ()
        (fkpqo-query "gl-register duplicate names collision semantics"))
    (defn fkpqob-report-with (offer generated answer counts)
        (do
            (let answer-key (nmfe-sha256
                (str_concat "public-query-answer-key:"
                            (fkpqo-offer-family offer))))
            (str_concat "choice-task=knowledge"
            (str_concat (fkpqob-line "prompt_cursor" "bmf-qtf2-live-v1")
            (str_concat (fkpqob-line "heed_cursor"
                                      "bounded-current-source-v1")
            (str_concat (fkpqob-line "heed_lookups" (int_to_str (nth counts 0)))
            (str_concat (fkpqob-line "heed_source_searches" (int_to_str (nth counts 1)))
            (str_concat (fkpqob-line "heed_honored" (int_to_str (nth counts 2)))
            (str_concat (fkpqob-line "heed_hits" (int_to_str (nth counts 3)))
            (str_concat (fkpqob-line "heed_close_commits" (int_to_str (nth counts 4)))
            (str_concat (fkpqob-line "heed_misses" (int_to_str (nth counts 5)))
            (str_concat (fkpqob-line "heed_nothings" (int_to_str (nth counts 6)))
            (str_concat (fkpqob-line "heed_spent" (int_to_str (nth counts 7)))
            (str_concat (fkpqob-line "heed_injection_refusals" (int_to_str (nth counts 8)))
            (str_concat (fkpqob-line "heed_decode_timeout" (int_to_str (nth counts 9)))
            (str_concat (fkpqob-line "heed_frame_refusals" (int_to_str (nth counts 10)))
            (str_concat (fkpqob-line "heed_bound_source_matches" (int_to_str (nth counts 11)))
            (str_concat (fkpqob-line "heed_bound_source_mismatches" (int_to_str (nth counts 12)))
            (str_concat (fkpqob-line "heed_injected_tokens" "7")
            (str_concat (fkpqob-line "heed_evidence_status" "hit")
            (str_concat (fkpqob-line "heed_evidence_reason"
                                      "current-source-context-path-hit")
            (str_concat (fkpqob-line "heed_source_path"
                                      (fkpqo-offer-path offer))
            (str_concat (fkpqob-line "heed_source_artifact"
                                      (fkpqo-offer-source-id offer))
            (str_concat (fkpqob-line "heed_answer_key" answer-key)
            (str_concat (fkpqob-line "heed_model_executed" "0")
            (str_concat (fkpqob-line "state_released" "1")
            (str_concat (fkpqob-line "heed_query_tokens" "12")
            (str_concat (fkpqob-line "heed_answer_tokens" "8")
            (str_concat (fkpqob-line "generated_tokens" "20")
            (str_concat (fkpqob-line "forward_passes" "42")
            (str_concat "\ntext:\n"
                (str_concat generated answer))))))))))))))))))))))))))))))))
    (defn fkpqob-report (offer answer)
        (fkpqob-report-with offer (fkpqo-offer-query offer) answer
            (fkpqob-good-counts 1)))

    (defn fkpqob-answer-for (offer)
        (do
            (let row (fkhe-find-row (fkpqo-offer-row-id offer) (fkhe-rows)))
            (fkhe-expected row)))
    (defn fkpqob-observation-for (offer raw remote model-id)
        (fkpqo-observation offer (fkpqo-plan-sha) (fkpqob-run-id)
            model-id (fkpqob-residence-id) raw 1 1 remote 1 7))
    (defn fkpqob-perfect-observation (offer)
        (fkpqob-observation-for offer
            (fkpqob-report offer (fkpqob-answer-for offer)) 0
            (fkpqob-model-id)))
    (defn fkpqob-perfect-observations (offers)
        (if (eq (len offers) 0) (list)
            (cons (fkpqob-perfect-observation (head offers))
                  (fkpqob-perfect-observations (tail offers)))))
    (defn fkpqob-all-offers-answer-free? (offers)
        (if (eq (len offers) 0) 1
            (do
                (let offer (head offers))
                (if (and (eq (fkpqo-offer-answer-present offer) 0)
                         (str_eq (fkpqo-offer-query offer)
                                 (fkpqo-query
                                     (fkpqo-offer-anchor offer))))
                    (fkpqob-all-offers-answer-free? (tail offers)) 0))))
    (defn fkpqob-all-anchors-derived? (offers)
        (if (eq (len offers) 0) 1
            (do
                (let offer (head offers))
                (if (and (ge (str_find (fkpqo-offer-question offer)
                                      (fkpqo-offer-anchor offer) 0) 0)
                         (le (str_len (fkpqo-offer-anchor offer))
                             (fkss-max-query-atom)))
                    (fkpqob-all-anchors-derived? (tail offers)) 0))))
    (defn fkpqob-all-projections-valid? (projections)
        (if (eq (len projections) 0) 1
            (if (eq (fkpqo-projection-valid? (head projections)) 1)
                (fkpqob-all-projections-valid? (tail projections)) 0)))
    (defn fkpqob-offer-keys (offers)
        (if (eq (len offers) 0) (list)
            (cons (fkpqo-offer-key (head offers))
                  (fkpqob-offer-keys (tail offers)))))
    (defn fkpqob-copy-offer-query (offer query)
        (list (fkpqo-schema) (fkpqo-offer-node offer)
              (fkpqo-offer-key offer) (fkpqo-offer-family offer)
              (fkpqo-offer-row-id offer) (fkpqo-offer-concept offer)
              (fkpqo-offer-path offer) (fkpqo-offer-source-sha offer)
              (fkpqo-offer-source-id offer) (fkpqo-offer-question offer)
              (fkpqo-offer-question-sha offer)
              (fkpqo-offer-challenge-sha offer)
              (fkpqo-offer-anchor offer) query
              (fkpqo-offer-model-executed offer)
              (fkpqo-offer-answer-present offer)))

    (defn form-knowledge-public-query-offer-batch-band ()
        (do
            (let offers (fkpqo-offers))
            (let projections (fkpqo-projections))
            (let supervised (fkpqo-supervised-projections))
            (let first-offer (head offers))
            (let second-offer (nth offers 1))
            (let heldout-projection (head projections))
            (let supervised-projection (nth projections 1))
            (let bad-offer (fkpqob-copy-offer-query first-offer
                (str_concat (fkpqo-offer-query first-offer) "x")))
            (let observations (fkpqob-perfect-observations offers))
            (let perfect (fkpqo-finalize observations 1 0 1))
            (let missing (fkpqo-finalize (tail observations) 1 0 1))
            (let remote-first (fkpqob-observation-for first-offer
                (fkpqob-report first-offer (fkpqob-answer-for first-offer))
                1 (fkpqob-model-id)))
            (let remote-result
                (fkpqo-finalize (cons remote-first (tail observations)) 1 0 1))
            ; Rebinding another family around the first raw report cannot make
            ; the report's query/source relation fit the second offer.
            (let replay-second (fkpqob-observation-for second-offer
                (fkpqo-obs-raw (head observations)) 0 (fkpqob-model-id)))
            (let replay-result (fkpqo-finalize
                (cons (head observations)
                    (cons replay-second (tail (tail observations)))) 1 0 1))
            (let other-model-second (fkpqob-observation-for second-offer
                (fkpqob-report second-offer (fkpqob-answer-for second-offer))
                0 "other-local-model"))
            (let other-model-result (fkpqo-finalize
                (cons (head observations)
                    (cons other-model-second (tail (tail observations)))) 1 0 1))
            (let zero-offer (nth offers 10))
            (let zero-observation (fkpqob-perfect-observation zero-offer))
            (let one-observation (fkpqob-observation-for first-offer
                (fkpqob-report first-offer "1") 0 (fkpqob-model-id)))
            (let nothing-observation (fkpqob-observation-for first-offer
                "choice-task=knowledge\nprompt_cursor=bmf-qtf2-live-v1\n"
                0 (fkpqob-model-id)))
            (let unsorted (list
                (fkpqo-scheduled first-offer 10)
                (fkpqo-scheduled second-offer 30)
                (fkpqo-scheduled (nth offers 2) 20)))
            (let sorted (fkpqo-schedule-sort unsorted (list)))
            (let first-query (fkpqo-offer-query first-offer))
            (let first-answer (fkpqob-answer-for first-offer))
            (let refined-generated
                (str_concat first-query (fkpqob-refined-query)))
            (let one-frame-raw (fkpqob-report-with first-offer first-query
                first-answer (fkpqob-good-counts 1)))
            (let two-frame-raw (fkpqob-report-with first-offer refined-generated
                first-answer (fkpqob-good-counts 2)))
            (let zero-frame-raw (fkpqob-report-with first-offer ""
                first-answer (fkpqob-good-counts 0)))
            (let three-frame-raw (fkpqob-report-with first-offer
                (str_concat refined-generated (fkpqob-third-query))
                first-answer (fkpqob-good-counts 3)))
            (let malformed-frame-raw (fkpqob-report-with first-offer
                (str_concat first-query (fkqt-close))
                first-answer (fkpqob-good-counts 2)))
            (let partial-frame-raw (fkpqob-report-with first-offer
                (str_concat first-query
                    (str_concat (fkqt-open) "gl-register duplicate names"))
                first-answer (fkpqob-good-counts 2)))
            (let duplicate-first-raw (fkpqob-report-with first-offer
                (str_concat first-query first-query)
                first-answer (fkpqob-good-counts 2)))
            (let count-mismatch-raw (fkpqob-report-with first-offer
                refined-generated first-answer (fkpqob-good-counts 1)))
            (let wrong-second-binding-raw (fkpqob-report-with first-offer
                refined-generated first-answer
                (fkpqob-wrong-second-binding-counts)))
            (let miss-raw (fkpqob-report-with first-offer first-query
                first-answer (fkpqob-failure-counts "miss")))
            (let nothing-raw (fkpqob-report-with first-offer first-query
                first-answer (fkpqob-failure-counts "nothing")))
            (let spent-raw (fkpqob-report-with first-offer first-query
                first-answer (fkpqob-failure-counts "spent")))
            (let injection-refusal-raw (fkpqob-report-with first-offer first-query
                first-answer (fkpqob-failure-counts "injection-refusal")))
            (let timeout-raw (fkpqob-report-with first-offer first-query
                first-answer (fkpqob-failure-counts "timeout")))
            (let frame-refusal-raw (fkpqob-report-with first-offer first-query
                first-answer (fkpqob-failure-counts "frame-refusal")))
            (sum (list
                (fkpqob-bit (and (eq (len offers) 15)
                    (eq (len offers) (fkpqo-family-total))) 1)
                (fkpqob-bit (and (eq (fkpqo-all-offers-valid? offers) 1)
                    (eq (fkhe-family-coverage? (fkhe-rows)) 1)) 2)
                (fkpqob-bit (and (eq (fkpqob-all-offers-answer-free? offers) 1)
                    (eq (fkpqob-all-anchors-derived? offers) 1)) 4)
                (fkpqob-bit (and (eq (len projections) 30)
                    (and (eq (len supervised) 15)
                         (eq (fkpqob-all-projections-valid? projections) 1))) 8)
                (fkpqob-bit (and
                    (and (str_eq (fkpqo-projection-lane heldout-projection)
                                 "canonical-heldout")
                    (and (eq (fkpqo-projection-query-offered
                                heldout-projection) 0)
                    (and (eq (fkpqo-projection-heldout-credit
                                heldout-projection) 1)
                         (eq (fkpqo-projection-supervised-credit
                                heldout-projection) 0))))
                    (and (str_eq (fkpqo-projection-lane supervised-projection)
                                 "supervised-rag")
                    (and (eq (fkpqo-projection-heldout-credit
                                supervised-projection) 0)
                         (eq (fkpqo-projection-supervised-credit
                                supervised-projection) 1)))) 16)
                (fkpqob-bit (and (eq (fkpqo-unique-strings?
                                        (fkpqob-offer-keys offers)) 1)
                    (and (eq (nmfe-sha256? (fkpqo-offer-key first-offer)) 1)
                         (eq (fkpqo-offer-valid? bad-offer) 0))) 32)
                (fkpqob-bit (and (eq (nmfe-sha256? (fkpqo-plan-sha)) 1)
                    (str_eq (fkpqo-plan-sha) (fkpqo-plan-sha))) 64)
                (fkpqob-bit (and (eq (fkpqo-scheduled-need (head sorted)) 30)
                    (eq (fkpqo-scheduled-need (nth sorted 2)) 10)) 128)
                (fkpqob-bit (and (eq (len observations) 15)
                    (eq (fkpqo-all-observations-valid? observations) 1)) 256)
                (fkpqob-bit (and (eq (fkpqo-result-ready perfect) 1)
                    (and (eq (fkpqo-result-transport perfect) 15)
                         (eq (fkpqo-result-answer95 perfect) 15))) 512)
                (fkpqob-bit (and (eq (fkpqo-result-heldout-credit perfect) 0)
                    (and (eq (fkpqo-result-supervised-credit perfect) 15)
                    (and (eq (fkpqo-result-local perfect) 15)
                         (eq (fkpqo-result-remote perfect) 0)))) 1024)
                (fkpqob-bit (and (nothing? missing)
                    (and (not (nothing? remote-result))
                         (eq (fkpqo-result-ready remote-result) 0))) 2048)
                (fkpqob-bit (eq (fkpqo-observation-valid? remote-first) 0) 4096)
                (fkpqob-bit (and (eq (fkpqo-observation-valid?
                                        replay-second) 1)
                    (eq (fkpqo-result-ready replay-result) 0)) 8192)
                (fkpqob-bit (and (eq (fkpqo-observation-valid?
                                        other-model-second) 1)
                    (eq (fkpqo-result-ready other-model-result) 0)) 16384)
                (fkpqob-bit (and
                    (and (str_eq (fkpqo-obs-outcome zero-observation) "value")
                    (and (eq (fkpqo-obs-present zero-observation) 1)
                         (eq (fkpqo-obs-zero zero-observation) 1)))
                    (and (str_eq (fkpqo-obs-outcome one-observation) "value")
                    (and (eq (fkpqo-obs-one one-observation) 1)
                    (and (str_eq (fkpqo-obs-outcome nothing-observation)
                                 "nothing")
                         (eq (fkpqo-obs-present nothing-observation) 0)))))
                    32768)
                (fkpqob-bit (and (eq (MaxHeeds) 2)
                    (and (eq (fkpqo-transport-ready?
                                first-offer one-frame-raw 1) 1)
                         (eq (fkpqo-transport-ready?
                                first-offer two-frame-raw 1) 1))) 65536)
                (fkpqob-bit (and (eq (fkpqo-transport-ready?
                                        first-offer zero-frame-raw 1) 0)
                    (eq (fkpqo-transport-ready?
                            first-offer three-frame-raw 1) 0)) 131072)
                (fkpqob-bit (and (eq (fkpqo-transport-ready?
                                        first-offer malformed-frame-raw 1) 0)
                    (eq (fkpqo-transport-ready?
                            first-offer partial-frame-raw 1) 0)) 262144)
                (fkpqob-bit (eq (fkpqo-transport-ready?
                                    first-offer duplicate-first-raw 1) 0) 524288)
                (fkpqob-bit (eq (fkpqo-transport-ready?
                                    first-offer count-mismatch-raw 1) 0) 1048576)
                (fkpqob-bit (eq (fkpqo-transport-ready?
                                    first-offer wrong-second-binding-raw 1) 0) 2097152)
                (fkpqob-bit (and
                    (and (eq (fkpqo-transport-ready?
                                first-offer miss-raw 1) 0)
                    (and (eq (fkpqo-transport-ready?
                                first-offer nothing-raw 1) 0)
                         (eq (fkpqo-transport-ready?
                                first-offer spent-raw 1) 0)))
                    (and (eq (fkpqo-transport-ready?
                                first-offer injection-refusal-raw 1) 0)
                    (and (eq (fkpqo-transport-ready?
                                first-offer timeout-raw 1) 0)
                         (eq (fkpqo-transport-ready?
                                first-offer frame-refusal-raw 1) 0)))) 4194304)))))

    (form-knowledge-public-query-offer-batch-band))
