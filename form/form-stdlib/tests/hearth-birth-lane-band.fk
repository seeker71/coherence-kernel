; hearth-birth-lane-band.fk -- the glass renders observed birth values and
; preserves absence rather than converting it to a duration.
; Expected: 31
; preludes: form-stdlib/hearth-glass-door.bml

(do
    (defn hbbl-bit (ok bit) (if ok bit 0))
    (let born "bootcache=ready bootctx=0 bootprog=7 bootsetup=7 bootprefill=11")
    (let absent "bootcache=nothing bootctx=nothing bootprog=nothing bootsetup=nothing bootprefill=nothing")
    (let present-lane (hgd-birth-lane born (sub 0 1)))
    (let absent-lane (hgd-birth-lane absent (sub 0 1)))
    (sum (list
        (hbbl-bit (str_eq (nth present-lane 0) "birth   ") 1)
        (hbbl-bit (and (ge (str_find (nth present-lane 1) "cache=ready" 0) 0)
            (and (ge (str_find (nth present-lane 1) "ctx=0ms" 0) 0)
                (and (ge (str_find (nth present-lane 1) "prog=7ms" 0) 0)
                    (and (ge (str_find (nth present-lane 1) "setup=7ms" 0) 0)
                         (ge (str_find (nth present-lane 1) "prefill=11ms" 0) 0))))) 2)
        (hbbl-bit (and (ge (str_find (nth absent-lane 1) "cache=nothing" 0) 0)
            (and (ge (str_find (nth absent-lane 1) "ctx=nothing" 0) 0)
                (and (ge (str_find (nth absent-lane 1) "prog=nothing" 0) 0)
                    (and (ge (str_find (nth absent-lane 1) "setup=nothing" 0) 0)
                         (ge (str_find (nth absent-lane 1) "prefill=nothing" 0) 0))))) 4)
        (hbbl-bit (and (str_eq (nth present-lane 2) "plain")
            (and (eq (nth present-lane 3) (sub 0 1))
                 (eq (nth absent-lane 3) (sub 0 1)))) 8)
        (hbbl-bit (and (str_eq (hgd-birth-ms born "bootctx") "0ms")
            (str_eq (hgd-birth-ms absent "bootctx") "nothing")) 16))))
