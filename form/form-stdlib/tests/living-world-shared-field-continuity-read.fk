; Second process of the shared-field continuity witness.  It loads rather than
; rebuilding the world, receives fresh holder responses, re-answers, learns,
; revokes, persists the successor, and removes the exact transient carriers.
; Expected verdict: 1048575.
; preludes: form-stdlib/core.fk form-stdlib/living-world-compost.fk form-stdlib/tests/living-world-shared-field-continuity-witness.fk

(let LWSFCX-RELEASE-TARGET (bp "LWSFCX-RELEASE-TARGET"))

(defn lwsfcx-release-target ()
    (intern_node LWSFCX-RELEASE-TARGET (empty)))

(defn lwsfcx-release-entry ()
    (lwt-entry
        (lwo-offer (lwsnw-source-f) (lwsnw-interface) 1
            (lwsfcx-release-target) (lwsnw-prov-f) 1)
        (lwsnw-action)))

(defn lwsfcx-observation-has? (payload outcome)
    (if (eq (lwtf-observation? payload) 0) 0
        (do
            (let answer (lwtf-observation-next payload))
            (if (eq (lwsn-answer? answer) 0) 0
                (lwo-field-has? (lwsn-answer-outcomes answer) outcome)))))

(defn lwsfcx-attribution-observation?
    (world attribution source outcome)
    (if (eq (lwo-active-attribution? world attribution) 0) 0
        (if (not (node_eq (lwo-attribution-source attribution) source)) 0
            (lwsfcx-observation-has?
                (lwo-attribution-payload attribution) outcome))))

(defn lwsfcx-find-observation-items (world items source outcome)
    (if (eq (len items) 0) (lwo-none)
        (if (eq (lwsfcx-attribution-observation?
                    world (head items) source outcome) 1)
            (lwo-attribution-payload (head items))
            (lwsfcx-find-observation-items
                world (tail items) source outcome))))

(defn lwsfcx-find-observation (world source outcome)
    (lwsfcx-find-observation-items world
        (lwo-field-items (lwo-world-attributions world)) source outcome))

(defn lwsfcx-candidate-has? (candidate outcome)
    (if (eq (lwtf-candidate? candidate) 0) 0
        (do
            (let observation (lwo-emergent-shape candidate))
            (if (eq (lwtf-observation? observation) 0) 0
                (do
                    (let answer (lwtf-observation-next observation))
                    (if (eq (lwsn-answer? answer) 0) 0
                        (lwo-field-has?
                            (lwsn-answer-outcomes answer) outcome)))))))

(defn lwsfcx-find-candidate-items (items outcome)
    (if (eq (len items) 0) (lwo-none)
        (if (eq (lwsfcx-candidate-has? (head items) outcome) 1)
            (head items)
            (lwsfcx-find-candidate-items (tail items) outcome))))

(defn lwsfcx-find-candidate (world outcome)
    (lwsfcx-find-candidate-items
        (lwo-field-items (lwo-world-cells world)) outcome))

(defn lwsfcx-compost-proposal-target (proposal)
    (if (node_eq proposal (lwo-none)) "proposal:none"
        (lcfb-cat (list "participants:"
            (int_to_str (lwo-field-size
                (lwt-proposal-participants proposal)))))))

(defn lwsfcx-compost-transition-target (transition)
    (lcfb-cat (list "ack:"
        (int_to_str (oac-kind (lwo-transition-ack transition))))))

(defn lwsfcx-run (started)
    (do
        (let loaded (lwcd-load (lwsfcw-before-path) (lwo-none)))
        (let image (lwcd-result-image loaded))
        (let image-entry (lwsfcw-image-entry image))
        (let admission
            (lwt-receive-stream (lwo-empty-world) (list image-entry)))
        (let restore-proposal (lwcn-restore-proposal admission image))
        (let responses (lwsfcw-responses restore-proposal))
        (let partial
            (lwsfc-restore-observed image image-entry (tail responses)
                2 (lwsnw-action) started 10))
        (let restored
            (lwsfc-restore-observed image image-entry responses
                2 (lwsnw-action) started 11))
        (let restored-state (lwsfc-result-state restored))
        (let restored-question
            (lwsfw-apply restored-state
                (lwsfw-question-entry (lwsnw-source-e)) started 12))
        (let restored-answer (lwsf-step-answer restored-question))
        (let restored-world (lwsfw-world restored-question))
        (let candidate-a
            (lwsfcx-find-candidate restored-world (lwsnw-outcome-a)))
        (let observation-a
            (lwsfcx-find-observation restored-world
                (lwsnw-source-a) (lwsnw-outcome-a)))

        (let outcome-c
            (lwsfw-apply (lwsf-step-state restored-question)
                (lwsf-session (lwsnw-offer-b)
                    (lwsnw-consent (lwsnw-source-c))
                    (lwsnw-action) 0)
                started 13))
        (let outcome-d
            (lwsfw-apply (lwsf-step-state outcome-c)
                (lwsf-session (lwsnw-offer-b)
                    (lwsnw-consent (lwsnw-source-d))
                    (lwsnw-action) 0)
                started 14))
        (let proposal-b
            (lwsnw-find-proposal
                (lwsf-settlement-proposals
                    (lwsf-step-settlement outcome-d))
                (lwsnw-outcome-b)))
        (let response-c
            (lwsfw-apply (lwsf-step-state outcome-d)
                (lwsfw-response-entry (lwsnw-source-c) proposal-b
                    (oac-one (lwt-proposal-candidate proposal-b))
                    (lwsnw-prov-c))
                started 15))
        (let response-d
            (lwsfw-apply (lwsf-step-state response-c)
                (lwsfw-response-entry (lwsnw-source-d) proposal-b
                    (oac-one (lwt-proposal-candidate proposal-b))
                    (lwsnw-prov-d))
                started 16))
        (let candidate-b (lwt-proposal-candidate proposal-b))
        (let plural-question
            (lwsfw-apply (lwsf-step-state response-d)
                (lwsfw-question-entry (lwsnw-source-e)) started 17))
        (let plural-answer (lwsf-step-answer plural-question))
        (let revoke-a
            (lwsfw-apply (lwsf-step-state plural-question)
                (lwsfw-revocation-entry
                    (lwsnw-source-a) observation-a) started 18))
        (let final-question
            (lwsfw-apply (lwsf-step-state revoke-a)
                (lwsfw-question-entry (lwsnw-source-e)) started 19))
        (let final-state (lwsf-step-state final-question))
        (let final-answer (lwsf-step-answer final-question))
        (let release-step
            (lwsfw-apply final-state (lwsfcx-release-entry) started 20))
        (let release-revoke
            (lwsfw-apply (lwsf-step-state release-step)
                (lwsfw-revocation-entry (lwsnw-source-f)
                    (lwsfcx-release-target)) started 21))
        (let release-world (lwsfw-world release-revoke))
        (let compost-entered
            (lcfb-call-stream "living-world-shared-field-continuity"
                "compost-proposal" "enter" "form-native"
                "lwc-compost-proposal" "inactive-offered-cell" 44 started
                "form/form-stdlib/tests/living-world-shared-field-continuity-read.fk"
                159 13))
        (let compost-proposal
            (lwc-compost-proposal release-world (lwsfcx-release-target)))
        (let compost-proposed
            (lcfb-call-stream "living-world-shared-field-continuity"
                "compost-proposal" "leave" "form-native"
                "lwc-compost-proposal"
                (lwsfcx-compost-proposal-target compost-proposal) 45 started
                "form/form-stdlib/tests/living-world-shared-field-continuity-read.fk"
                164 17))
        (let compost-response
            (lwsfw-response-entry (lwsnw-source-f) compost-proposal
                (oac-one (lwt-proposal-candidate compost-proposal))
                (lwsnw-prov-f)))
        (let compost-answered
            (lwt-receive-stream release-world (list compost-response)))
        (let compost-integrate-entered
            (lcfb-call-stream "living-world-shared-field-continuity"
                "compost-integrate" "enter" "form-native"
                "lwc-integrate" "fresh-holder-response" 46 started
                "form/form-stdlib/tests/living-world-shared-field-continuity-read.fk"
                180 13))
        (let compost-transition
            (lwc-integrate compost-answered compost-proposal))
        (let compost-integrated
            (lcfb-call-stream "living-world-shared-field-continuity"
                "compost-integrate" "leave" "form-native"
                "lwc-integrate"
                (lwsfcx-compost-transition-target compost-transition) 47 started
                "form/form-stdlib/tests/living-world-shared-field-continuity-read.fk"
                185 17))
        (let compost-world (lwo-transition-world compost-transition))
        (let compost-receipt
            (oac-payload (lwo-transition-ack compost-transition)))
        (let compost-state
            (lwsf-state compost-world 2 (lwsnw-action) (lwo-none)))
        (let final-image (lwsfc-image compost-state))
        (let final-saved
            (lwcd-save-new (lwsfcw-after-path) final-image (lwo-none)))
        (let final-loaded
            (lwcd-load (lwsfcw-after-path) (lwo-none)))

        (let bits
            (list
                (if (eq (lwcd-loaded? loaded) 1) 1 0)
                (if (eq (lwcn-image-valid? image) 1) 1 0)
                (if (eq (lwcn-restored? (lwcn-image-world image)
                            (lwt-proposal-candidate restore-proposal)) 0) 1 0)
                (if (eq (lwo-field-size
                            (lwt-proposal-participants restore-proposal)) 5) 1 0)
                (if (and (eq (oac-nothing? (lwsfc-result-ack partial)) 1)
                         (eq (lwt-outcome-missing
                                (lwsfc-result-outcome partial)) 1)) 1 0)
                (if (and (eq (oac-one? (lwsfc-result-ack restored)) 1)
                         (eq (lwsf-state? restored-state) 1)) 1 0)
                (if (eq (lwcn-restored?
                            (lwsf-state-world restored-state)
                            (lwt-proposal-candidate restore-proposal)) 1) 1 0)
                (if (and (eq (lwsn-trace-current? restored-world
                                    (lwsf-answer-trace restored-answer)) 1)
                         (and (eq (lwsnw-prediction-has?
                                    (lwsf-answer-prediction restored-answer)
                                    (lwsnw-outcome-a)) 1)
                              (eq (oac-one?
                                    (lwsf-answer-voice-ack restored-answer)) 1))) 1 0)
                (if (and (not (node_eq candidate-a (lwo-none)))
                         (not (node_eq observation-a (lwo-none)))) 1 0)
                (if (and (not (node_eq proposal-b (lwo-none)))
                         (eq (lwo-field-size
                                (lwt-proposal-participants proposal-b)) 2)) 1 0)
                (if (eq (lwtf-integrated-current?
                            (lwsfw-world response-d) candidate-b) 1) 1 0)
                (if (and (eq (oac-node?
                                (lwsf-answer-ack plural-answer)) 1)
                         (eq (lwo-field-size
                                (lwtf-prediction-nexts
                                    (lwsf-answer-prediction plural-answer))) 2)) 1 0)
                (if (and (eq (oac-one? (lwsf-step-ack revoke-a)) 1)
                         (and (eq (lwtf-integrated-current?
                                    (lwsfw-world revoke-a) candidate-a) 0)
                              (eq (lwtf-integrated-current?
                                    (lwsfw-world revoke-a) candidate-b) 1))) 1 0)
                (if (and (eq (lwsnw-prediction-has?
                                (lwsf-answer-prediction final-answer)
                                (lwsnw-outcome-b)) 1)
                         (and (eq (lwsnw-prediction-has?
                                    (lwsf-answer-prediction final-answer)
                                    (lwsnw-outcome-a)) 0)
                              (eq (oac-nothing?
                                    (lwsf-answer-voice-ack final-answer)) 1))) 1 0)
                (if (and (eq (lwcd-saved? final-saved) 1)
                         (and (eq (lwcd-loaded? final-loaded) 1)
                              (node_eq (lwcd-result-image final-loaded)
                                       final-image))) 1 0)
                (if (and (eq (oac-one? (lwsf-step-ack release-step)) 1)
                         (eq (lwo-active?
                                (lwsfw-world release-step)
                                (lwsfcx-release-target)) 1)) 1 0)
                (if (and (eq (oac-one?
                                (lwsf-step-ack release-revoke)) 1)
                         (eq (lwo-active? release-world
                                (lwsfcx-release-target)) 0)) 1 0)
                (if (and (not (node_eq compost-proposal (lwo-none)))
                         (eq (lwo-field-size
                                (lwt-proposal-participants
                                    compost-proposal)) 1)) 1 0)
                (if (and (eq (oac-node?
                                (lwo-transition-ack compost-transition)) 1)
                         (and (eq (lwc-receipt? compost-receipt) 1)
                              (eq (lwc-world-contains? compost-world
                                    (lwsfcx-release-target)) 0))) 1 0)
                (if (and (eq (lwc-world-contains?
                                (lwc-receipt-prior-world compost-receipt)
                                (lwsfcx-release-target)) 1)
                         (eq (lwc-world-contains?
                                (lwc-receipt-successor-world compost-receipt)
                                (lwsfcx-release-target)) 0)) 1 0)))
        (let verdict (lwsnw-verdict bits))
        (lwsfcw-clean)
        verdict))

(do
    (let started
        (lcfb-open-stream "living-world-shared-field-continuity-read"
            "form-native" "lwsfcx-run" "load-restore-and-grow"
            "form/form-stdlib/tests/living-world-shared-field-continuity-read.fk"
            284 5))
    (lwsfcx-run started))
