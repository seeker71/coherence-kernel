; tests/bml-hati-native-path-words-proof.fk
;
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk
;
; A path is words joined by dots, and every word reads as a segment: each
; BML property word (native, public, static, get, ...) and each keyword, at
; the head, in the middle and at the tail of a package path and an import
; path. The same holds for a qualified reference in an expression and after
; a dot in a type, and the paths resolve: `package A.native;` names its
; member on both lanes, and an import through `lib.static` links its unit.

(do
    (defn score-bool (actual)
        (if actual 1 0))

    (defn score-int (actual expected)
        (if (eq actual expected) 1 0))

    (defn score-str (actual expected)
        (if (nil? actual)
            0
            (if (str_eq actual expected) 1 0)))

    (defn pw-parse (text)
        (bml-source-parse-executable-stream (bml-source-scan-text text)))

    (defn pw-node (text)
        (bml-source-exec-parse-node (pw-parse text)))

    ; the one declaration a line parses to: its path, or "" when it does not
    ; parse whole
    (defn pw-path (text)
        (do
            (let parsed (pw-parse text))
            (if (bml-source-exec-parse-ok? parsed)
                (if (eq (len (bml-source-exec-parse-nodes parsed)) 1)
                    (node_value (bml-node-child (head (bml-source-exec-parse-nodes parsed)) 0))
                    "")
                "")))

    (defn pw-word-ok? (word)
        (do
            (let inner (str_concat word (str_concat ".mid." word)))
            (let tail-path (str_concat "a." word))
            (and (str_eq (pw-path (str_concat "package " (str_concat inner ";\n"))) inner)
                 (and (str_eq (pw-path (str_concat "import " (str_concat tail-path ".*;\n"))) tail-path)
                      (str_eq (pw-path (str_concat "import " (str_concat word ".x;\n")))
                              (str_concat word ".x"))))))

    (defn pw-count (words)
        (if (nil? words)
            0
            (add (if (pw-word-ok? (head words)) 1 0) (pw-count (tail words)))))

    (defn pw-both (node units)
        (if (eq (bma-run-value (bml-compile-unit-program node units)) 42)
            (if (eq (bml-hati-run-unit-value node units) 42) 1 0)
            0))

    (let properties (bml-source-properties 0))
    (let keywords (bml-source-keywords 0))

    (let native-node
        (pw-node "package A.native;\nint Inc(int n) { return n + 1; }\nreturn A.native.Inc(41);\n"))
    (let static-unit (pw-node "package lib.static;\nint Twice(int n) { return n + n; }\n"))
    (let static-node (pw-node "import lib.static.*;\nreturn lib.static.Twice(20) + Twice(1);\n"))
    (let head-node (pw-node "package native;\nconst int k = 41;\nreturn native.k + 1;\n"))
    (let type-parse (bml-source-parse-type (bml-source-scan-text "a.native.T x")))

    (sum
        (list
            (score-int (pw-count properties) (len properties))
            (score-int (pw-count keywords) (len keywords))
            (score-bool (gt (len properties) 30))
            (score-str (pw-path "package A.native;\n") "A.native")
            (pw-both native-node (empty))
            (pw-both static-node (list static-unit))
            (score-int (bml-hati-run-value head-node) 42)
            (score-int (bma-run-value (bml-compile-unit-program head-node (empty))) 42)
            (score-str (nth type-parse 0) "a.native.T")
            (score-bool (str_eq (pw-path "package a.;\n") ""))
            (score-bool (str_eq (pw-path "import a..b;\n") "")))))
