; jit-meaning-epoch-band.fk — the membrane sees through preludes.
;
; Verdict 31 (5 bits):
;   1   the closure from jit-once-born.fk reaches core.fk transitively — the
;       meaning is the closure, not the file
;   2   the closure visits each file once (no cycle doubling)
;   4   the epoch roots include this cell's own bytes and the registry's —
;       the fold is not self-exempt
;   8   an edited prelude ALONE moves an epoch whose root is unchanged
;   16  the kernel stamp differs between two files of different content and
;       is 0 for an absent kernel path — absence is not a stamp
;
; preludes: form-stdlib/jit-meaning-epoch.fk

(do
    (defn jmb-bit (ok bit) (if ok bit 0))
    (defn jmb-has (xs needle)
        (if (eq (len xs) 0) 0
            (if (ge (str_find (head xs) needle 0) 0) 1 (jmb-has (tail xs) needle))))
    (defn jmb-count (xs needle n)
        (if (eq (len xs) 0) n
            (jmb-count (tail xs) needle
                (add n (if (ge (str_find (head xs) needle 0) 0) 1 0)))))
    (defn jit-meaning-epoch-band ()
        (do
            (let cl (jme-closure (list "form/form-stdlib/jit-once-born.fk")))
            (let roots (jme-roots))
            ; a root file and a prelude file for the edited-prelude probe
            (let w1 (write_file "/tmp/jme-root.fk" "; preludes: /tmp/jme-dep.fk\nroot body\n"))
            (let d1 (write_file "/tmp/jme-dep.fk" "dep one"))
            (let ea (jme-epoch-of (list "/tmp/jme-root.fk") "/tmp/absent"))
            (let d2 (write_file "/tmp/jme-dep.fk" "dep two"))
            (let eb (jme-epoch-of (list "/tmp/jme-root.fk") "/tmp/absent"))
            (sum (list
                (jmb-bit (eq (jmb-has cl "core.fk") 1) 1)
                (jmb-bit (eq (jmb-count cl "core.fk" 0) 1) 2)
                (jmb-bit (and (eq (jmb-has roots "jit-meaning-epoch.fk") 1)
                              (eq (jmb-has roots "jit-once-born.fk") 1)) 4)
                (jmb-bit (not (eq ea eb)) 8)
                (jmb-bit (and (not (eq (jme-kernel-stamp "form/form-stdlib/core.fk")
                                       (jme-kernel-stamp "form/form-stdlib/form-asm.fk")))
                              (eq (jme-kernel-stamp "/tmp/no-such-kernel") 0)) 16)))))
    (jit-meaning-epoch-band))
