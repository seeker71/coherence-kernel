; aware-axes-band.fk — proof of the body's self-awareness axes.
;
; preludes: form/form-stdlib/aware-axes.bml form/form-stdlib/form-glass-sensor-rows.bml
;
;      ./fkwu form/form-stdlib/tests/aware-axes-band.fk     ; -> 4095
;
; This band proves the AXES, on counts it supplies itself. It never opens a model
; and never asks the GPU: the dense walk that produces the counts is witnessed by
; observe/aware-axes-run.fk on real lines and real weights, because a band that
; needed a 1.2-billion-parameter file would be proving the file, not the arithmetic.
; Bands prove cells; only the door witnesses the body.
;
; The gift-frame bit publishes under "aware-band", NOT under the live sensor's own
; "aware" — a band that wrote the sensor's frame would stain the surface it measures
; (bandstain, corpus row 1193) and would fight a standing sensor for its own shm.
;
; The bits:
;   1     the line becomes the body's own lowercase words, punctuation dropped
;   2     a word the body itself minted is found in its own vocabulary; a stranger is not
;   4     recurrence counts exact prior lines, and the memory keeps them in order
;   8     surprise is per-mille of tokens the body did NOT already name
;   16    novelty is pieces per word; coherence is words held whole per mille
;   32    the crossing: nonsense is all surprise and no aliveness; a teaching is both
;   64    an axis with nothing to measure answers -1, never a 0 wearing a reading's clothes
;   128   the rows are the glass's own metric shape, with int and text kinds where they belong
;   256   every row is this sensor's domain, source and channel -- no row leaks another organ's name
;   512   a reading's three costs are three lanes, and the total is their sum
;   1024  give -> take: the rows cross a gift frame as cells and come back identical
;   2048  a publisher nobody stands is named absent, and the absent row says which door to run

(do
    (defn ab-bit (ok w) (if ok w 0))
    (defn ab-nth-str (xs i) (nth xs i))

    ; --- 1: words ---------------------------------------------------------------
    (let ws (awx-words "A Keloid, is-a door's wound!"))
    (let c0 (ab-bit (and (eq (len ws) 6)
                    (and (str_eq (nth ws 0) "a")
                    (and (str_eq (nth ws 1) "keloid")
                    (and (str_eq (nth ws 2) "is")
                    (and (str_eq (nth ws 3) "a")
                    (and (str_eq (nth ws 4) "door's")
                         (str_eq (nth ws 5) "wound"))))))) 1))

    ; --- 2: the body's own vocabulary -------------------------------------------
    (let vocab (list "keloid" "tailkeep" "icetide"))
    (let c1 (ab-bit (and (eq (awx-held (awx-words "a keloid and an icetide") vocab) 2)
                    (and (eq (awx-held (awx-words "xqzt fribble morgnash") vocab) 0)
                         (eq (awx-in? vocab "tailkeep") 1))) 2))

    ; --- 4: recurrence and memory ------------------------------------------------
    (let h0 (list))
    (let h1 (awx-remember h0 "the floor is warm"))
    (let h2 (awx-remember h1 "the floor is warm"))
    (let c2 (ab-bit (and (eq (awx-recurrence h0 "the floor is warm") 0)
                    (and (eq (awx-recurrence h1 "the floor is warm") 1)
                    (and (eq (awx-recurrence h2 "the floor is warm") 2)
                         (eq (awx-recurrence h2 "a line never said") 0)))) 4))

    ; --- 8: surprise --------------------------------------------------------------
    (let c3 (ab-bit (and (eq (awx-surprise 7 7) 0)
                    (and (eq (awx-surprise 0 7) 1000)
                    (and (eq (awx-surprise 5 7) 286)
                         (eq (awx-permille 933 1000) 933)))) 8))

    ; --- 16: novelty and coherence -------------------------------------------------
    (let c4 (ab-bit (and (eq (awx-novelty 8 6) 133)
                    (and (eq (awx-novelty 15 5) 300)
                    (and (eq (awx-coherence 14 15) 933)
                         (eq (awx-coherence 0 5) 0)))) 16))

    ; --- 32: the crossing -----------------------------------------------------------
    ; nonsense is ALL surprise: 1000 on the axis that most tells aliveness from
    ; repetition, and 0 alive, because nothing in it resolved. A line of the body's
    ; own teaching is high on both and the crossing keeps it high. A line the body
    ; could have said is coherent and unsurprising and lands near the floor.
    (let c5 (ab-bit (and (eq (awx-alive 1000 0) 0)
                    (and (eq (awx-alive 824 933) 768)
                    (and (eq (awx-alive 286 1000) 286)
                         (gt (awx-alive 824 933) (awx-alive 1000 0))))) 32))

    ; --- 64: an unmeasured axis says so ----------------------------------------------
    (let empty (awx-reading-empty))
    (let c6 (ab-bit (and (eq (awx-surprise 0 0) -1)
                    (and (eq (awx-coherence 0 0) -1)
                    (and (eq (awx-novelty 0 0) -1)
                    (and (eq (awx-alive -1 1000) -1)
                    (and (eq (awx-alive 500 -1) -1)
                    (and (eq (awx-r-empty? empty) 1)
                         (eq (awx-r-per-token-ms empty) -1))))))) 64))

    ; --- a real reading, built from counts this band supplies -------------------------
    ; 17 line tokens, 14 of 17 unnamed by the body's own argmax, 15 words, 14 held
    ; whole, one of them the body's own; 297 ms on the GPU, 5090 cutting the line,
    ; 15983 pricing its words.
    (let r (awx-reading "a keloid is a door's kept wound" "the capital of france is paris"
                        3 17 9078 5340 17 17 15 14 1 0 297 1200 15983 5090))
    (let rows (awx-rows r))

    ; --- 128: the glass's own metric shape ---------------------------------------------
    (let c7 (ab-bit (and (eq (len rows) 16)
                    (and (str_eq (nth (head rows) 0) "form-glass-metric-v2")
                    (and (eq (len (head rows)) 22)
                    (and (str_eq (nth (head rows) 4) "text")
                    (and (str_eq (nth (nth rows 2) 4) "int")
                         (eq (nth (nth rows 2) 5) (awx-r-surprise r))))))) 128))

    ; --- 256: no row leaks another organ's name -------------------------------------
    (defn ab-mine? (rs)
        (if (eq (len rs) 0) 1
            (if (and (str_eq (nth (head rs) 1) (AWXDomain))
                (and (str_eq (nth (head rs) 15) (AWXSource))
                     (str_eq (nth (head rs) 17) (AWXChannel))))
                (ab-mine? (tail rs)) 0)))
    (let c8 (ab-bit (and (eq (ab-mine? rows) 1)
                    (and (eq (ab-mine? (awx-waiting-rows)) 1)
                         (eq (ab-mine? (awx-floor-rows 3669 1288 "unweighed" 1216)) 1))) 256))

    ; --- 512: three lanes, and the total is their sum -----------------------------------
    (let c9 (ab-bit (and (eq (awx-r-dense-ms r) 297)
                    (and (eq (awx-r-tokenize-ms r) 5090)
                    (and (eq (awx-r-vocab-ms r) 15983)
                    (and (eq (awx-r-ms r) 21370)
                    (and (eq (awx-r-per-token-ms r) 17)
                         (eq (awx-r-surprise r) 824)))))) 512))

    ; --- 1024: give -> take, the rows crossing a frame as cells --------------------------
    (let gave (fgsr-give-at "aware-band" 1788000000000 rows 10000))
    (let held (fgsr-take "aware-band" (list)))
    (let back (fgsr-held-rows held))
    (let c10 (ab-bit (and (str_eq (nth gave 1) "given")
                    (and (eq (len back) (len rows))
                    (and (eq (fgsr-held-epoch held) 1788000000000)
                    (and (eq (fgsr-held-cadence held) 10000)
                    (and (str_eq (nth (nth back 2) 2) "aware.surprise")
                    (and (eq (nth (nth back 2) 5) 824)
                         (str_eq (nth (head back) 6) "a keloid is a door's kept wound"))))))) 1024))

    ; --- 2048: a publisher nobody stands is named absent ----------------------------------
    (let absent (fgsr-absent-row "aware-nobody-stands-this"))
    (let c11 (ab-bit (and (eq (fgsr-standing? "aware-nobody-stands-this") 0)
                    (and (eq (nth absent 7) 0)
                    (and (str_eq (nth absent 4) "absent")
                         (ge (str_find (nth absent 18) "no sensor process is giving this frame" 0) 0)))) 2048))

    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9 (add c10 c11))))))))))))
