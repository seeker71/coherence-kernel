; form-knowledge-public-resident-eval-band.fk -- pure 30-trial contract.
;
; Synthetic reports exercise the public schema without opening a model or
; carrier.  Repetition cannot enlarge the 15-family denominator.
;
; Expected: 65535
; preludes: form-stdlib/form-knowledge-public-resident-eval.fk
; PROOF BAND (fkwu): 65535

(do
    (defn fkp30b-bit (ok bit) (if ok bit 0))
    (defn fkp30b-model-id () "synthetic-local-qwen")
    (defn fkp30b-run-id () (nmfe-sha256 "synthetic-public-resident-run"))
    (defn fkp30b-receipt-sha () (nmfe-sha256 "synthetic-public-receipt"))
    (defn fkp30b-prefix ()
        "choice-task=knowledge\nchoice-match=1\nbackend=form-native-metal-jit\ntext:\n")
    (defn fkp30b-raw-answer (presentation answer)
        (str_concat (fkp30b-prefix)
            (str_concat (fkqt-open)
            (str_concat (str_concat "public fixture lookup:"
                                    (fkp30-presentation-trial-id presentation))
            (str_concat (fkqt-close) answer)))))
    (defn fkp30b-score-for (presentation raw)
        (do
            (let row (fkhe-find-row (fkp30-presentation-row-id presentation)
                                    (fkhe-rows)))
            (fkhe-score row (fqt-knowledge-prompt (fkhe-prompt row))
                (fkhe-parse-resident-output raw) 7)))
    (defn fkp30b-trial-with-raw (presentation raw)
        (do
            (let score (fkp30b-score-for presentation raw))
            (let o (fkhe-score-observation score))
            (let error (nmfe-obs-error o))
            (let present (if (eq error 0) 1 0))
            (let zero (if (and (eq present 1)
                               (str_eq (nth score 8) (nmfe-sha256 "0"))) 1 0))
            (let one (if (and (eq present 1)
                              (str_eq (nth score 8) (nmfe-sha256 "1"))) 1 0))
            (let session (fkp30-session-id-for
                            (fkp30b-run-id) (fkp30b-model-id)))
            (let nonce (fkp30-trial-nonce-for
                            (fkp30b-run-id) session presentation))
            (fkp30-trial presentation score (fkp30b-model-id)
                (fkp30b-run-id) session raw (nmfe-sha256 raw) nonce
                (fkp30-content-sha-for nonce raw) 1 0 1 1 1
                (if (eq present 1) "value" "nothing") present zero one
                12 8 20 1 0 0 0 0 7)))
    (defn fkp30b-perfect-trial (presentation)
        (do
            (let row (fkhe-find-row (fkp30-presentation-row-id presentation)
                                    (fkhe-rows)))
            (fkp30b-trial-with-raw presentation
                (fkp30b-raw-answer presentation (fkhe-expected row)))))
    (defn fkp30b-perfect-trials (presentations)
        (if (eq (len presentations) 0) (list)
            (cons (fkp30b-perfect-trial (head presentations))
                  (fkp30b-perfect-trials (tail presentations)))))
    (defn fkp30b-copy-trial
        (t local remote model state same query answer generated hits misses
         nothings timeout frames)
        (fkp30-trial (fkp30-trial-presentation t) (fkp30-trial-score t)
            (fkp30-trial-model-id t) (fkp30-trial-run-id t)
            (fkp30-trial-session-id t) (fkp30-trial-raw-output t)
            (fkp30-trial-output-sha t)
            (fkp30-trial-family-nonce t) (fkp30-trial-content-sha t)
            local remote model state same
            (fkp30-trial-outcome t) (fkp30-trial-present t)
            (fkp30-trial-zero t) (fkp30-trial-one t) query answer generated
            hits misses nothings timeout frames (fkp30-trial-latency t)))
    (defn fkp30b-copy-bindings (t raw output-sha family-nonce content-sha)
        (fkp30-trial (fkp30-trial-presentation t) (fkp30-trial-score t)
            (fkp30-trial-model-id t) (fkp30-trial-run-id t)
            (fkp30-trial-session-id t) raw output-sha family-nonce content-sha
            (fkp30-trial-local t) (fkp30-trial-remote t)
            (fkp30-trial-model-executed t)
            (fkp30-trial-state-released t)
            (fkp30-trial-same-residence t) (fkp30-trial-outcome t)
            (fkp30-trial-present t) (fkp30-trial-zero t)
            (fkp30-trial-one t) (fkp30-trial-query-tokens t)
            (fkp30-trial-answer-tokens t)
            (fkp30-trial-generated-tokens t) (fkp30-trial-hits t)
            (fkp30-trial-misses t) (fkp30-trial-nothings t)
            (fkp30-trial-timeout t) (fkp30-trial-frame-refusals t)
            (fkp30-trial-latency t)))
    (defn fkp30b-remote-trial (t)
        (fkp30b-copy-trial t 1 1 1 1 1 12 8 20 1 0 0 0 0))
    (defn fkp30b-missing-telemetry-trial (t)
        (fkp30b-copy-trial t 1 0 1 1 1 -1 8 20 1 0 0 0 0))
    (defn fkp30b-wrong-one-trial (presentation)
        (fkp30b-trial-with-raw presentation
            (fkp30b-raw-answer presentation "1")))

    (defn form-knowledge-public-resident-eval-band ()
        (do
            (let presentations (fkp30-presentations))
            (let trials (fkp30b-perfect-trials presentations))
            (let first-trial (head trials))
            (let zero-presentation
                (fkp30-presentation
                    (fkhe-find-row "h11" (fkhe-rows)) "a"))
            (let zero-trial (fkp30b-perfect-trial zero-presentation))
            (let one-trial (fkp30b-wrong-one-trial (head presentations)))
            (let perfect-result (fkp30-result trials 1 0 1))
            (let perfect-export (fkp30-export perfect-result))
            (let evidences
                (fkp30-export-heldout-evidences perfect-export))
            (let remote-trial (fkp30b-remote-trial first-trial))
            (let missing-trial
                (fkp30b-missing-telemetry-trial first-trial))
            ; A fully rebound score/nonce/content is still a replay when the
            ; same canonical bytes cross into a different family.
            (let replay-presentation (nth presentations 2))
            (let replay-trial (fkp30b-trial-with-raw replay-presentation
                                  (fkp30-trial-raw-output first-trial)))
            (let replay-trials
                (cons first-trial
                    (cons (nth trials 1)
                        (cons replay-trial (tail (tail (tail trials)))))))
            ; Copying a family nonce and then recomputing content around that
            ; copied nonce cannot impersonate a different challenge.
            (let second-family-trial (nth trials 2))
            (let copied-nonce (fkp30-trial-family-nonce first-trial))
            (let nonce-replay-trial
                (fkp30b-copy-bindings second-family-trial
                    (fkp30-trial-raw-output second-family-trial)
                    (fkp30-trial-output-sha second-family-trial) copied-nonce
                    (fkp30-content-sha-for copied-nonce
                        (fkp30-trial-raw-output second-family-trial))))
            (let stale-raw-trial
                (fkp30b-copy-bindings first-trial
                    (str_concat (fkp30-trial-raw-output first-trial) "x")
                    (fkp30-trial-output-sha first-trial)
                    (fkp30-trial-family-nonce first-trial)
                    (fkp30-trial-content-sha first-trial)))
            (let unsorted
                (list (fkp30-scheduled (head presentations) 10)
                      (fkp30-scheduled (nth presentations 1) 30)
                      (fkp30-scheduled (nth presentations 2) 20)))
            (let sorted (fkp30-schedule-sort unsorted (list)))
            (sum (list
                (fkp30b-bit (and (eq (len presentations) 30)
                    (eq (fkp30-family-total) 15)) 1)
                (fkp30b-bit (eq (fkp30-every-row-twice?
                                    (fkhe-rows) trials) 1) 2)
                (fkp30b-bit (and (eq (fkp30-presentation-valid?
                                        (head presentations)) 1)
                    (eq (fkp30-presentation-seal-valid?
                            (fkp30-presentation-seal
                                (head presentations))) 1)) 4)
                (fkp30b-bit (and (eq (fkp30-schedule-descending? sorted) 1)
                    (and (eq (fkp30-scheduled-need (head sorted)) 30)
                         (eq (fkp30-scheduled-need (nth sorted 2)) 10))) 8)
                (fkp30b-bit (eq (fkp30-trial-valid? first-trial) 1) 16)
                (fkp30b-bit (and (str_eq (fkp30-trial-output-sha first-trial)
                                          (nmfe-sha256
                                            (fkp30-trial-raw-output first-trial)))
                    (str_eq (fkp30-trial-output-sha first-trial)
                            (nth (fkp30-trial-score first-trial) 7))) 32)
                (fkp30b-bit (and (str_eq
                                    (fkp30-trial-family-nonce first-trial)
                                    (fkp30-trial-nonce-for
                                        (fkp30b-run-id)
                                        (fkp30-trial-session-id first-trial)
                                        (head presentations)))
                    (str_eq (fkp30-trial-content-sha first-trial)
                            (fkp30-content-sha-for
                                (fkp30-trial-family-nonce first-trial)
                                (fkp30-trial-raw-output first-trial)))) 64)
                (fkp30b-bit (and (str_eq (fkp30-trial-outcome zero-trial) "value")
                    (and (eq (fkp30-trial-present zero-trial) 1)
                    (and (eq (fkp30-trial-zero zero-trial) 1)
                         (eq (fkp30-trial-one zero-trial) 0)))) 128)
                (fkp30b-bit (and (str_eq (fkp30-trial-outcome one-trial) "value")
                    (and (eq (fkp30-trial-present one-trial) 1)
                    (and (eq (fkp30-trial-zero one-trial) 0)
                         (eq (fkp30-trial-one one-trial) 1)))) 256)
                (fkp30b-bit (and (eq (fkp30-result-complete? perfect-result) 1)
                    (eq (fkp30-result-ready95? perfect-result) 1)) 512)
                (fkp30b-bit (and (eq (len (nth perfect-result 5)) 15)
                    (eq (fkhe-report-live-credit
                            (fkp30-result-report perfect-result)) 1)) 1024)
                (fkp30b-bit (and (eq (fkp30-export-valid? perfect-export) 1)
                    (and (eq (len (nth perfect-export 4)) 30)
                    (and (eq (len (nth (head (nth perfect-export 4)) 1)) 9)
                    (and (eq (len (head (nth perfect-export 4))) 28)
                         (str_eq (nth (head (nth perfect-export 4)) 6)
                                 (fkp30-trial-raw-output first-trial)))))) 2048)
                (fkp30b-bit (and (eq (len evidences) 15)
                    (eq (fkpfm-heldout-valid? (head evidences)) 1)) 4096)
                (fkp30b-bit (and (eq (fkp30-trial-valid? remote-trial) 0)
                    (and (eq (fkp30-trial-valid? missing-trial) 1)
                         (eq (fkp30-trial-telemetry-present?
                                missing-trial) 0))) 8192)
                (fkp30b-bit (and (eq (fkp30-trial-valid? replay-trial) 1)
                    (and (eq (len replay-trials) 30)
                         (eq (fkp30-no-cross-family-output-replay?
                                (list first-trial replay-trial)) 0))) 16384)
                (fkp30b-bit (and (eq (fkp30-trial-valid?
                                        nonce-replay-trial) 0)
                    (eq (fkp30-trial-valid? stale-raw-trial) 0)) 32768)))))

    (form-knowledge-public-resident-eval-band))
