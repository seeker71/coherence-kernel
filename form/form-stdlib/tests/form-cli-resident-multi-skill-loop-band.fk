; form-cli-resident-multi-skill-loop-band.fk -- pure adversarial witness.
; Opens no model, source, registry, carrier, or remote lane.
; Expected: 16777215 (24 bits).
; witnessed: 2026-08-25 -> direct fkwu
; preludes: form-stdlib/form-cli-resident-multi-skill-loop.fk

(do
    (defn fmslb-bit (held weight) (if held weight 0))
    (defn fmslb-concept () "defn-psci-schema")
    (defn fmslb-path () "form/form-stdlib/public-source-concept-index.fk")
    (defn fmslb-source-id ()
        "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    (defn fmslb-content () "definition body held by the exact source")
    (defn fmslb-frame ()
        (fmsl-cat (list (fknq-observation-open)
            "\nstatus=hit\nreason=indexed\nanswer:" (fmslb-content) "\n"
            (fknq-observation-close))))
    (defn fmslb-binding-with (source-id content frame)
        (fmsl-knowledge-binding (fmslb-concept) "concept" (fmslb-concept)
            (fknq-concept-surface (fmslb-concept)) "hit" "indexed"
            source-id (fmslb-path) content frame
            (fmsl-knowledge-response (fmslb-concept) (fmslb-path))))
    (defn fmslb-binding ()
        (fmslb-binding-with (fmslb-source-id) (fmslb-content) (fmslb-frame)))
    (defn fmslb-binding-digest-swap (binding digest)
        (list (nth binding 0) (nth binding 1) (nth binding 2)
            (nth binding 3) (nth binding 4) (nth binding 5)
            (nth binding 6) (nth binding 7) (nth binding 8)
            (nth binding 9) (nth binding 10) (nth binding 11)
            (nth binding 12) (nth binding 13) (nth binding 14)
            digest (nth binding 16) (nth binding 17)))
    (defn fmslb-evidence (binding)
        (fmsl-knowledge-evidence "hit" 1 1 1 1 1 0 0 1 1 1 binding))

    (defn fmslb-bml-good ()
        "int Lift(int n) { return n + 8; }\nreturn Lift(65);\n")
    (defn fmslb-bml-failed ()
        "int Shift(int n) { return n + 72; }\nint main() { return Shift(1); }\nreturn main();\n")
    (defn fmslb-bml-other ()
        "int Lift(int n) { return n + 9; }\nreturn Lift(65);\n")
    (defn fmslb-bmf ()
        "grammar {\n  rule atmark { lit @ }\n  rule vowel { class ae }\n  rule markedvowel { seq atmark vowel }\n  rule entrance { alt vowel markedvowel }\n  top entrance\n  probe @a\n}")
    (defn fmslb-form ()
        (fgsg-control-canonical
            (fgsg-cat (list "<|form:recipe-exec|>"
                (frex-node-coordinate (frex-recipe))
                ";input=17;carrier=auto<|/form:recipe-exec|>"))
            "nothing,timeout,zero" "one" "29" "2" "why" "6" "1"))
    (defn fmslb-text (bml)
        (fmsl-cat (list "<BML>" bml "</BML>\n<BMF>" (fmslb-bmf)
            "</BMF>\n<FORM>" (fmslb-form) "</FORM>")))

    (defn fmslb-session (ctx sts pos generated injected observations)
        (fcms-session "live" "resident" "model.gguf" "src" ctx sts
            8192 pos 90 0 90 generated injected observations))
    (defn fmslb-sessions ()
        (do
            (let ctx (list "same-qwen-context"))
            (let sts (list "same-qwen-state"))
            (list
                (fmslb-session ctx sts 100 0 0 0)
                (fmslb-session ctx sts 160 7 18 1)
                (fmslb-session ctx sts 190 7 35 2)
                (fmslb-session ctx sts 280 80 35 2)
                (fmslb-session ctx sts 310 80 49 3)
                (fmslb-session ctx sts 340 180 49 3)
                (fmslb-session ctx sts 370 180 65 4)
                (fmslb-session ctx sts 390 190 65 4))))
    (defn fmslb-snap (sessions at) (fmsl-snapshot (nth sessions at)))
    (defn fmslb-attempt-replace
        (attempt text candidate-digest verdict verdict-digest leakage)
        (list (nth attempt 0) (nth attempt 1) (nth attempt 2)
            (nth attempt 3) text (nth attempt 5) (nth attempt 6)
            candidate-digest verdict verdict-digest (nth attempt 10)
            (nth attempt 11) leakage (nth attempt 13)))
    (defn fmslb-loop
        (sessions binding first second finalization refined-lane)
        (do
            (let final-attempt (if refined-lane second first))
            (let lane (if refined-lane "supervised-embodiment"
                "independent-generative"))
            (fmsl-loop (fmslb-snap sessions 0) (fmslb-snap sessions 1)
                (fmslb-snap sessions 2) (fmslb-snap sessions 3)
                (fmslb-snap sessions 4) (fmslb-snap sessions 5)
                (fmslb-evidence binding) (fmsl-skill-evidence final-attempt lane)
                (fmsl-attempt-signal final-attempt) (fmsl-kb-frame binding)
                (fmsl-teaching-frame (fmslb-concept))
                (fmsl-check-frame first) first second finalization 1 0 1)))

    (defn fmslb-run ()
        (do
            (let sessions (fmslb-sessions))
            (let binding (fmslb-binding))
            (let good (fmsl-candidate-attempt 1 "candidate" "root"
                (fmslb-text (fmslb-bml-good))))
            (let good-check (fmsl-check-frame good))
            (let ack (fmsl-ack-attempt 2 (nmfe-sha256 good-check)
                "embodied and held"))
            (let first-final (fmsl-finalization "first-pass" good-check
                "embodied and held" (fmslb-snap sessions 4)
                (fmslb-snap sessions 5)))
            (let first-loop
                (fmslb-loop sessions binding good ack first-final 0))

            (let failed (fmsl-candidate-attempt 1 "candidate" "root"
                (fmslb-text (fmslb-bml-failed))))
            (let failed-check (fmsl-check-frame failed))
            (let refined (fmsl-candidate-attempt 2 "refinement"
                (nmfe-sha256 failed-check)
                (fmslb-text (fmsl-bml-repair-source))))
            (let refined-check (fmsl-check-frame refined))
            (let refined-final (fmsl-finalization "supervised-refinement"
                refined-check "embodied and held" (fmslb-snap sessions 6)
                (fmslb-snap sessions 7)))
            (let refined-loop
                (fmslb-loop sessions binding failed refined refined-final 1))

            (let wrong-content (fmslb-binding-with (fmslb-source-id)
                "wrong-content" (fmslb-frame)))
            (let wrong-digest (fmslb-binding-digest-swap binding
                (fmsl-typed-digest "content" "wrong-content")))
            (let wrong-source (fmslb-binding-with "sha256:no"
                (fmslb-content) (fmslb-frame)))
            (let wrong-candidate (fmslb-attempt-replace good
                (fmslb-text (fmslb-bml-other)) (nth good 7)
                (nth good 8) (nth good 9) (nth good 12)))
            (let wrong-candidate-digest (fmslb-attempt-replace good
                (nth good 4) (fmsl-typed-digest "model-candidate" "wrong")
                (nth good 8) (nth good 9) (nth good 12)))
            (let replayed-verdict (fmslb-attempt-replace refined
                (nth refined 4) (nth refined 7) (nth failed 8)
                (nth failed 9) (nth refined 12)))
            (let wrong-parent (fmsl-candidate-attempt 2 "refinement" "root"
                (fmslb-text (fmsl-bml-repair-source))))
            (let false-ack (fmsl-ack-attempt 2 (nmfe-sha256 good-check)
                "embodied but not held"))
            (let leaked-first (fmslb-attempt-replace good (nth good 4)
                (nth good 7) (nth good 8) (nth good 9) 1))
            (let leaked-second (fmslb-attempt-replace refined (nth refined 4)
                (nth refined 7) (nth refined 8) (nth refined 9) 1))
            (let replayed-final (fmsl-finalization "supervised-refinement"
                failed-check "embodied and held" (fmslb-snap sessions 6)
                (fmslb-snap sessions 7)))
            (let repair (fmsl-bml-repair failed))
            (let other-failed (fmsl-candidate-attempt 1 "candidate" "root"
                (fmslb-text (fmslb-bml-other))))
            (let reopened (fmslb-session (list "new-qwen-context")
                (list "same-qwen-state") 390 190 65 4))
            (let zero (fmsl-signal "value" 1 0))
            (let one (fmsl-signal "value" 1 1))
            (let absent (fmsl-signal "nothing" 0 0))
            (let timeout (fmsl-signal "timeout" 0 0))
            (let failure (fmsl-signal "failure" 0 0))

            (sum (list
                (fmslb-bit (eq (fmsl-loop-valid? first-loop) 1) 1)
                (fmslb-bit (eq (fmsl-loop-valid? refined-loop) 1) 2)
                (fmslb-bit (eq (fmsl-knowledge-binding-valid? binding) 1) 4)
                (fmslb-bit (eq (fmsl-knowledge-binding-valid? wrong-content) 0) 8)
                (fmslb-bit (eq (fmsl-knowledge-binding-valid? wrong-digest) 0) 16)
                (fmslb-bit (eq (fmsl-knowledge-binding-valid? wrong-source) 0) 32)
                (fmslb-bit (eq (fmsl-teaching-bound? "wrong-concept"
                    (fmsl-teaching-frame (fmslb-concept))) 0) 64)
                (fmslb-bit (eq (fmsl-teaching-bound? (fmslb-concept)
                    (str_concat (fmsl-teaching-frame (fmslb-concept))
                        "wrong-challenge")) 0) 128)
                (fmslb-bit (eq (fmsl-attempt-valid? wrong-candidate) 0) 256)
                (fmslb-bit (eq (fmsl-attempt-valid? wrong-candidate-digest) 0) 512)
                (fmslb-bit (eq (fmsl-attempt-valid? replayed-verdict) 0) 1024)
                (fmslb-bit (eq (fmsl-loop-valid? (fmslb-loop sessions binding
                    failed wrong-parent refined-final 1)) 0) 2048)
                (fmslb-bit (eq (fmsl-attempt-valid? false-ack) 0) 4096)
                (fmslb-bit (eq (fmsl-attempt-valid? leaked-first) 0) 8192)
                (fmslb-bit (eq (fmsl-attempt-valid? leaked-second) 0) 16384)
                (fmslb-bit (eq (fmsl-loop-valid? (fmslb-loop sessions binding
                    failed refined replayed-final 1)) 0) 32768)
                (fmslb-bit (eq (fmsl-bml-repair-valid? failed repair) 1) 65536)
                (fmslb-bit (eq (fmsl-bml-repair-valid? other-failed repair) 0) 131072)
                (fmslb-bit (and (eq (nth repair 5) 73)
                    (and (eq (nth repair 6) 73)
                    (and (eq (nth repair 8) 0) (eq (nth repair 10) 0)))) 262144)
                (fmslb-bit (eq (fmsl-snapshot-step? (fmslb-snap sessions 6)
                    (fmsl-snapshot reopened) 0 1 0) 0) 524288)
                (fmslb-bit (and (eq (fmsl-signal-valid? zero) 1)
                    (and (eq (fmsl-signal-value zero) 0)
                         (eq (fmsl-signal-present? zero) 1))) 1048576)
                (fmslb-bit (and (eq (fmsl-signal-valid? one) 1)
                    (and (eq (fmsl-signal-value one) 1)
                         (eq (fmsl-signal-present? one) 1))) 2097152)
                (fmslb-bit (and (eq (fmsl-signal-valid? absent) 1)
                    (and (eq (fmsl-signal-present? absent) 0)
                         (str_eq (fmsl-signal-status absent) "nothing"))) 4194304)
                (fmslb-bit (and (eq (fmsl-signal-valid? timeout) 1)
                    (and (eq (fmsl-signal-valid? failure) 1)
                         (not (str_eq (fmsl-signal-trace timeout)
                            (fmsl-signal-trace failure))))) 8388608)))))
    (fmslb-run))
