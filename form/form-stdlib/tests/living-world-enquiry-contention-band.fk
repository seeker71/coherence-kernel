; living-world-enquiry-contention-band.fk -- disagreement answers with alternatives and silence.
; Verdict 32767 proves fifteen competing-path, consent, and no-hidden-winner properties.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-enquiry.fk form-stdlib/living-world-enquiry-answer.fk form-stdlib/tests/living-world-contention-witness.fk

(do
    (let base (lwct-base-round))
    (let identity-proposal (lwct-identity-proposal base))
    (let swap-proposal (lwct-swap-proposal base))
    (let identity-candidate
        (lwt-proposal-candidate identity-proposal))
    (let swap-candidate
        (lwt-proposal-candidate swap-proposal))
    (let world (lwct-mapping-world))
    (let proposals (lwen-question-proposals world))
    (let question-proposal (lwct-contention-proposal proposals))
    (let question-candidate
        (lwt-proposal-candidate question-proposal))
    (let question (lwo-emergent-shape question-candidate))
    (let routes (lwen-question-routes question))
    (let route-items (lwo-field-items routes))
    (let question-round
        (lwt-round world
            (lwo-field-add (lwo-empty-field) question-proposal)
            (lwo-empty-field) (lwo-none)))
    (let question-integrated
        (lwen-integrate-question
            (lwct-five-yes-round question-round question-proposal)
            question-proposal (lwct-action)))
    (let question-world (lwt-round-world question-integrated))

    (let answer-proposal
        (lwen-answer-proposal question-world question-candidate))
    (let answer-candidate
        (lwt-proposal-candidate answer-proposal))
    (let answer (lwo-emergent-shape answer-candidate))
    (let answer-round
        (lwt-round question-world
            (lwo-field-add (lwo-empty-field) answer-proposal)
            (lwo-empty-field) question-integrated))
    (let answer-integrated
        (lwen-integrate-answer
            (lwct-five-yes-round answer-round answer-proposal)
            answer-proposal (lwct-action)))
    (let answer-world (lwt-round-world answer-integrated))
    (let repeated (lwen-question-proposals answer-world))

    (let c1 (if (eq (lwo-field-size
                         (lwt-round-proposals base)) 2) 1 0))
    (let c2 (if (and (eq (lwrl-steady?
                              world identity-candidate) 1)
                         (eq (lwrl-steady?
                              world swap-candidate) 1)) 2 0))
    (let c3 (if (eq (lwo-field-size proposals) 3) 4 0))
    (let c4 (if (and (node_eq (lwen-question-kind question)
                               (lwen-contention))
                         (eq (lwo-field-size routes) 2)) 8 0))
    (let c5 (if (and (node_eq
                          (lwen-route-source-skeleton (nth route-items 0))
                          (lwen-route-source-skeleton (nth route-items 1)))
                         (and (node_eq
                              (lwen-route-target-skeleton (nth route-items 0))
                              (lwen-route-target-skeleton (nth route-items 1)))
                              (not (node_eq
                                  (lwen-route-output (nth route-items 0))
                                  (lwen-route-output (nth route-items 1)))))) 16 0))
    (let c6 (if (and (eq (lwo-field-size
                              (lwt-proposal-participants
                                  question-proposal)) 5)
                         (eq (lwo-field-size
                              (lwo-emergent-witnesses
                                  question-candidate)) 9)) 32 0))
    (let c7 (if (and (eq (lwct-routes-have-output?
                              route-items (lwct-identity-output)) 1)
                         (eq (lwct-routes-have-output?
                              route-items (lwct-swap-output)) 1)) 64 0))
    (let c8 (if (and (eq (lwo-active?
                              question-world question-candidate) 1)
                         (eq (lwo-field-size
                              (lwo-active-attributions-for
                                  question-world question-candidate)) 5)) 128 0))
    (let c9 (if (and (node_eq (lwen-answer-output answer) (lwo-none))
                         (eq (oac-nothing? (lwen-answer-ack answer)) 1)) 256 0))
    (let c10 (if (and (eq (lwo-field-size
                               (lwen-answer-alternatives answer)) 2)
                          (and (eq (lwct-routes-have-output?
                                    (lwo-field-items
                                        (lwen-answer-alternatives answer))
                                    (lwct-identity-output)) 1)
                               (eq (lwct-routes-have-output?
                                    (lwo-field-items
                                        (lwen-answer-alternatives answer))
                                    (lwct-swap-output)) 1))) 512 0))
    (let c11 (if (and (eq (lwo-field-size
                               (lwen-answer-uncertainties answer)) 1)
                          (node_eq
                              (lwen-route-uncertainty (nth route-items 0))
                              (lwen-route-uncertainty (nth route-items 1)))) 1024 0))
    (let c12 (if (and (eq (lwo-field-size
                               (lwt-proposal-participants answer-proposal)) 5)
                          (eq (lwo-field-size
                               (lwo-emergent-witnesses
                                   answer-candidate)) 5)) 2048 0))
    (let c13 (if (and (eq (lwo-active?
                               answer-world answer-candidate) 1)
                          (eq (lwo-field-size
                               (lwo-active-attributions-for
                                   answer-world answer-candidate)) 5)) 4096 0))
    (let c14 (if (eq (lwo-field-size repeated) 0) 8192 0))
    (let c15 (if (and (eq (lwo-active?
                               answer-world identity-candidate) 1)
                          (eq (lwo-active?
                               answer-world swap-candidate) 1)) 16384 0))
    (lwct-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
