; living-world-symbol-learning-band.fk -- experience proposes vocabulary.
; Verdict 32767 proves fifteen recurrence, uncertainty, and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/tests/living-world-symbol-learning-witness.fk

(do
    (let world (lwslw-world))
    (let evidence
        (lwsl-evidence-for world (lwslw-referent) 0 "forty"))
    (let round (lwslw-round))
    (let proposals (lwt-round-proposals round))
    (let forty-proposal (lwslw-find-proposal proposals "forty"))
    (let nine-proposal (lwslw-find-proposal proposals "-nine"))
    (let forty (lwt-proposal-candidate forty-proposal))
    (let nine (lwt-proposal-candidate nine-proposal))
    (let waiting (lwsl-integrate round forty-proposal (lwslw-action)))
    (let integrated (lwslw-integrated-round))
    (let integrated-world (lwt-round-world integrated))
    (let revoked (lwslw-revoked-world))
    (let late (lwslw-late-world))
    (let fourty-proposal (lwslw-find-proposal proposals "fourty"))

    (let c1 (if (and (eq (lwsl-observation-valid?
                              (lwslw-forty-support)) 1)
                         (eq (lwsl-observation-valid?
                              (lwslw-forty-silence)) 1)) 1 0))
    (let c2 (if (eq (lwsl-support-count evidence) 2) 2 0))
    (let c3 (if (eq (lwsl-alternative-count evidence) 1) 4 0))
    (let c4 (if (and (eq (lwsl-dissent-count evidence) 1)
                         (and (eq (lwsl-silence-count evidence) 1)
                              (eq (lwsl-unresolved-count evidence) 0))) 8 0))
    (let c5 (if (eq (lwo-field-size proposals) 2) 16 0))
    (let c6 (if (and (str_eq
                          (lwnv-symbol-surface
                            (lwo-emergent-shape forty)) "forty")
                         (node_eq
                          (lwnv-symbol-evidence
                            (lwo-emergent-shape forty)) evidence)) 32 0))
    (let c7 (if (eq (lwo-field-size
                         (lwt-proposal-participants forty-proposal)) 5) 64 0))
    (let c8 (if (eq (lwo-field-size
                         (lwt-proposal-participants nine-proposal)) 2) 128 0))
    (let c9 (if (eq (lwo-world-has?
                         (lwt-round-world waiting) forty) 0) 256 0))
    (let c10 (if (and (eq (lwo-active?
                               integrated-world forty) 1)
                          (eq (lwo-active?
                               integrated-world nine) 1)) 512 0))
    (let c11 (if (and (eq (lwsl-integrated-current?
                               integrated-world forty) 1)
                          (eq (lwsl-integrated-current?
                               integrated-world nine) 1)) 1024 0))
    (let c12 (if (and (eq (lwo-active?
                               revoked (lwslw-forty-support)) 1)
                          (eq (lwsl-candidate-current?
                               revoked forty) 0)) 2048 0))
    (let c13 (if (eq (lwsl-candidate-current?
                          late forty) 0) 4096 0))
    (let c14 (if (node_eq fourty-proposal (lwo-none)) 8192 0))
    (let c15 (if (and (eq (lwo-field-size
                               (lwsl-witnesses evidence)) 5)
                          (and (gt (lwsl-alternative-count evidence) 0)
                               (and (gt (lwsl-dissent-count evidence) 0)
                                    (gt (lwsl-silence-count evidence) 0))))
                      16384 0))
    (lwslw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
