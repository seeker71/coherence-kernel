; living-world-composite-recipe-answer-band.fk -- a consented composite field
; answers held-out use through every compatible Recipe surface.
; Verdict 32767 proves fifteen integration, answer, option, and time claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk form-stdlib/living-world-operation-field.fk form-stdlib/living-world-composite-recipe.fk form-stdlib/living-world-composite-answer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-structural-recipe-witness.fk form-stdlib/tests/living-world-operation-field-witness.fk form-stdlib/tests/living-world-composite-recipe-witness.fk

(defn lwoecab-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwoecab-sum (tail items)))))

(do
    (let evolved (lwoew-build-evolved))
    (let schema (lwoew-base-schema (lwoew-evolved-base evolved)))
    (let component (lwoew-evolved-candidate evolved))
    (let blueprint (lwoecw-blueprint component schema))
    (let blueprint-world (lwoecw-blueprint-world evolved))
    (let proposal (lwoec-proposal blueprint-world blueprint 2))
    (let candidate (lwt-proposal-candidate proposal))
    (let field (lwo-emergent-shape candidate))
    (let profiles (lwoec-field-profiles field))
    (let first-recipe
        (lwoec-surface-recipe
            (lwoec-profile-surface
                (nth (lwo-field-items profiles) 0))))
    (let second-recipe
        (lwoec-surface-recipe
            (lwoec-profile-surface
                (nth (lwo-field-items profiles) 1))))
    (let integrated
        (lwoec-integrate
            (lwphw-answered-round blueprint-world proposal
                (lwoew-evolved-round evolved))
            proposal (lwphw-action)))
    (let integrated-world (lwt-round-world integrated))
    (let rich (lwoecw-rich-query candidate schema))
    (let minimal (lwoecw-minimal-query candidate schema))
    (let world
        (lwt-receive-stream integrated-world
            (list (lwoecw-entry-s rich) (lwoecw-entry-t rich))))
    (let answer
        (lwoec-answer-for world rich 2 (intern_trivial_int 5)))
    (let evaluations (lwoec-answer-evaluations answer))
    (let first-eval (nth (lwo-field-items evaluations) 0))
    (let second-eval (nth (lwo-field-items evaluations) 1))
    (let immediate (lwoec-answer-immediate-ack answer))
    (let pending (lwoec-answer-time-observation answer))
    (let expired
        (lwoec-answer-time rich (intern_trivial_int 10)))
    (let answer-witnesses (lwoec-answer-witnesses-field answer))
    (let answer-sources
        (lwt-sources-from-attributions
            (lwo-field-items answer-witnesses) (lwo-empty-field)))
    (let outcome
        (head (lwo-field-items (lwt-round-outcomes integrated))))

    (let c1
        (if (and (eq (lwoec-candidate? candidate) 1)
                 (and (eq (lwo-field-size profiles) 2)
                      (eq (lwo-field-size
                              (lwoec-field-compatible field)) 2))) 1 0))
    (let c2
        (if (eq (lwo-field-size
                    (lwt-proposal-participants proposal)) 18) 2 0))
    (let c3
        (if (and (eq (lwo-field-size
                         (lwt-round-outcomes integrated)) 1)
                 (node_eq
                    (lwt-proposal-candidate
                        (lwt-outcome-proposal outcome)) candidate)) 4 0))
    (let c4
        (if (and (eq (lwo-active? integrated-world candidate) 1)
                 (and (eq (lwo-active? integrated-world component) 1)
                      (and (eq (lwo-active?
                                  integrated-world first-recipe) 0)
                           (eq (lwo-active?
                                  integrated-world second-recipe) 0)))) 8 0))
    (let c5
        (if (and (eq (lwoec-query-valid? rich) 1)
                 (and (eq (lwoec-answer? answer) 1)
                      (node_eq (lwoec-answer-query answer) rich))) 16 0))
    (let c6
        (if (and (eq (lwo-field-size evaluations) 2)
                 (eq (lwo-field-size
                         (lwoec-answer-outputs answer)) 1)) 32 0))
    (let c7
        (if (and (eq (node_value
                         (lwoec-query-eval-output first-eval)) 18)
                 (eq (node_value
                         (lwoec-query-eval-output second-eval)) 18)) 64 0))
    (let c8
        (if (and (eq (oac-one? immediate) 1)
                 (eq (node_value (oac-payload immediate)) 18)) 128 0))
    (let c9
        (if (and (eq (oac-time-pending? pending) 1)
                 (eq (node_value
                         (lwoec-answer-observed-time answer)) 5)) 256 0))
    (let c10
        (if (and (gt (lwo-field-size
                         (lwoec-answer-alternatives answer)) 0)
                 (gt (lwo-field-size
                         (lwoec-answer-unknowns answer)) 0)) 512 0))
    (let c11
        (if (and (gt (lwo-field-size answer-witnesses) 0)
                 (gt (lwo-field-size answer-sources) 0)) 1024 0))
    (let c12
        (if (or
                (and (str_eq (lwre-recipe-source first-recipe)
                             "(add (add r s) s)")
                     (str_eq (lwre-recipe-source second-recipe)
                             "(add s (add s r))"))
                (and (str_eq (lwre-recipe-source first-recipe)
                             "(add s (add s r))")
                     (str_eq (lwre-recipe-source second-recipe)
                             "(add (add r s) s)"))) 2048 0))
    (let c13
        (if (and
                (or (node_eq (lwoec-query-eval-recipe first-eval)
                             first-recipe)
                    (node_eq (lwoec-query-eval-recipe first-eval)
                             second-recipe))
                (and
                    (or (node_eq (lwoec-query-eval-recipe second-eval)
                                 first-recipe)
                        (node_eq (lwoec-query-eval-recipe second-eval)
                                 second-recipe))
                    (not (node_eq
                            (lwoec-query-eval-recipe first-eval)
                            (lwoec-query-eval-recipe second-eval))))) 4096 0))
    (let c14
        (if (and (eq (lwoec-query-valid? minimal) 1)
                 (and (eq (lwo-field-size
                              (lwoec-query-alternatives minimal)) 0)
                      (and (node_eq (lwoec-query-unknown minimal)
                                    (lwo-none))
                           (and (node_eq (lwoec-query-choice minimal)
                                         (lwo-none))
                                (node_eq (lwoec-query-timeout minimal)
                                         (lwo-none)))))) 8192 0))
    (let c15
        (if (and (eq (oac-time-outcome? expired) 1)
                 (and (eq (oac-alternative-ack?
                              (oac-time-outcome-ack expired)) 1)
                      (not (node_eq pending expired)))) 16384 0))
    (lwoecab-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
