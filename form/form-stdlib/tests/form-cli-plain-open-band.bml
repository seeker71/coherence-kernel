// Voice ownership, completion and prefill admission. Model-free: nonexistent
// paths and an empty context expose accidental model or Metal access; scripted
// leases distinguish a smaller fitting width from an unrelated refusal.
// Expected: 1023
// preludes: form-stdlib/bml/form-cli-native-voice.bml form-stdlib/bml/live.bml
section [form.bml] {
 class FormCliPlainOpenBand {
  def fcpob-open(spec,path,packet,context,profile,reserve) = [spec(path,[],context),path,packet,context,profile,reserve];
  def fcpob-inert(o) = q38x-on?(o)==0 && record_get(o,"reason")=="spec-off:single-token-cursor" && nothing?(q38x-tap(o)) && q38x-owned(o)==0;
  def fcpob-owner(ctx) {
   let o=fcsp-open-plain("/absent/model.gguf",[],128);
   let s=fcsp-attach(fcms-none("fixture"),o,[]);
   fcpob-inert(o) && fcsp-owned(s)==0 && fcsp-close(s)==0 && fcsp-close(s)==0;
  }
  def fcpob-reserved(ctx) {
   let opened=fcnv-open-by(fcpob-open,"a small shared game","/absent/model.gguf",nothing());
   fcpob-inert(opened[0]) && opened[1:]==["/absent/model.gguf","a small shared game",0,"knowledge-query",1536];
  }
  def fcpob-sized(ctx) {
   let opened=fcnv-open-by(fcpob-open,"an open question","/absent/other.gguf",2048);
   fcpob-inert(opened[0]) && opened[1:]==["/absent/other.gguf","an open question",2048,"knowledge-query",0];
  }
  def fcpob-partial(ctx) {
   let r=fcnv-lora-read("base","adapter",12,["An unfinished line","cancelled",4],1);
   r[0]=="incomplete" && r[1]=="" && r[5]==0 && r[6]==1 && r[7]=="cancelled" && r[8]=="An unfinished line";
  }
  def fcpob-release(ctx) {
   let r=fcnv-lora-read("base","adapter",12,["A finished line","",4],0);
   r[0]=="release-incomplete" && r[1]=="" && r[5]==1 && r[6]==0 && r[7]=="release-incomplete" && r[8]=="A finished line";
  }
  def fcpob-finished(ctx) {
   let r=fcnv-lora-read("base","adapter",12,["A finished line","",4],1);
   let empty=fcnv-lora-read("base","adapter",12,[" ","",1],1);
   r[0]=="answered" && r[1]=="A finished line" && r[5]==1 && r[6]==1 && empty[0]=="empty" && empty[1]=="";
  }
  def fcpob-ask(seen,limit,span) {
   record_set(seen,"asked",append(record_get(seen,"asked"),[span]));
   [span <= limit ? 1 : 0,span <= limit ? "room" : "capacity"];
  }
  def fcpob-wide(ctx) {
   let seen=record_new(0,"asked",[]);
   let r=fcma-lease-span(span => fcpob-ask(seen,1024,span),846);
   let fixed=fcma-lease-fixed(span => fcpob-ask(seen,1024,span),846);
   r==[846,[1,"room"]] && fixed==[64,[1,"room"]] && record_get(seen,"asked")==[846,64] && fcma-prefill-span(2000)==1024 && fcma-span(2000)==64;
  }
  def fcpob-fit(ctx) {
   let seen=record_new(0,"asked",[]);
   let r=fcma-lease-span(span => fcpob-ask(seen,256,span),2000);
   r==[256,[1,"room"]] && record_get(seen,"asked")==[1024,512,256];
  }
  def fcpob-held(ctx) {
   let seen=record_new(0,"asked",[]);
   let r=fcma-lease-span(span => fcpob-ask(seen,0,span),846);
   let short=fcma-lease-span(span => [0,"capacity"],13);
   r==[64,[0,"capacity"]] && record_get(seen,"asked")==[846,423,211,105,64] && short==[13,[0,"capacity"]];
  }
  def fcpob-unread(ctx) {
   let seen=record_new(0,"asked",[]);
   let r=fcma-lease-span(span => { fcpob-ask(seen,0,span); [0,"lease-lock-busy"]; },846);
   r==[846,[0,"lease-lock-busy"]] && record_get(seen,"asked")==[846];
  }
  def fcpob-run() = live-claims("form-cli-plain-open-band",nothing(),[["inert-owner",1,1,fcpob-owner],["prompt-and-reserve",2,1,fcpob-reserved],["explicit-capacity",4,1,fcpob-sized],["partial-stays-partial",8,1,fcpob-partial],["release-precedes-answer",16,1,fcpob-release],["completed-answer",32,1,fcpob-finished],["wide-prefill",64,1,fcpob-wide],["lease-selects-width",128,1,fcpob-fit],["minimum-can-refuse",256,1,fcpob-held],["non-capacity-stops",512,1,fcpob-unread]]);
 }
 fcpob-run();
}
