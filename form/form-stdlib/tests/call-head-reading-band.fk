; call-head-reading-band.fk — one call-position reading on every arm.
;
; preludes: form/form-stdlib/core.fk
;
; A local binding spelled like a name some arm carries natively, called as a
; head. fkwu reserves its op rows, rewrite rows and control forms: such a head
; answers as the primitive under any local of its spelling. Every other head
; reads the nearest local binding first. gate/reserved-heads.bml writes fkwu's
; list into Go, Rust and TS and the three walkers, so every arm reads alike.
; A marker function passed as the local answers -1 when the local is reached.
; witnessed: 2026-09-12 -> 255 on fkwu, Go, Rust and TS

(defn chr-m1 (a) -1)
(defn chr-m2 (a b) -1)
(defn chr-m3 (a b c) -1)
(defn chr-abs (abs x) (abs x))
(defn chr-char-at (char_at x) (char_at x 1))
(defn chr-int-to-str (int_to_str x) (int_to_str x))
(defn chr-ord (ord x) (ord x))
(defn chr-str-find (str_find x) (str_find x "c" 0))
(defn chr-str-to-int (str_to_int x) (str_to_int x))
(defn chr-substring (substring x) (substring x 1 3))
(defn chr-sum (sum x) (sum x))
(defn chr-bit (hit bit) (if hit bit 0))

(add (chr-bit (eq (chr-abs chr-m1 -5) 5) 1)
(add (chr-bit (eq (chr-char-at chr-m2 "abc") -1) 2)
(add (chr-bit (eq (chr-int-to-str chr-m1 12345) -1) 4)
(add (chr-bit (eq (chr-ord chr-m1 "A") -1) 8)
(add (chr-bit (eq (chr-str-find chr-m3 "abc") 2) 16)
(add (chr-bit (eq (chr-str-to-int chr-m1 "42") -1) 32)
(add (chr-bit (str_eq (chr-substring chr-m3 "abcd") "bc") 64)
     (chr-bit (eq (chr-sum chr-m1 (list 1 2 3)) -1) 128))))))))
