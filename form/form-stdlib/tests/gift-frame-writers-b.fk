; gift-frame-writers-b.fk — one of the three writers of gift-frame-writers-band.fk.
; It gives twenty thousand "b" into the band's frame four hundred times, as fast
; as it can, so a reader meets a give in flight. Three cells rather than one
; taking a letter: the seed has no argument door, and a writer whose letter came
; from a shared file once raced its siblings and wrote an empty payload, which
; read as a corrupt frame and was my own probe lying (2026-09-07).
;
; preludes: form/form-stdlib/form-glass-gift-frame.bml

(do
    (defn gfwb-rep (n acc) (if (eq n 0) acc (gfwb-rep (sub n 1) (str_concat acc "b"))))
    (defn gfwb-loop (n h payload) (if (eq n 0) 0 (do (let s (ggf-give h payload)) (gfwb-loop (sub n 1) h payload))))
    (let payload (gfwb-rep 20000 ""))
    (let h (ggf-offer "gift-frame-writers-band.frame" 262144))
    (let done (gfwb-loop 400 h payload))
    (print (ggf-release h)))
