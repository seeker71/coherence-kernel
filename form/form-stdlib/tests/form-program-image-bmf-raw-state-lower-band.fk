; form-program-image-bmf-raw-state-lower-band.fk -- executable raw matcher proof.
;
; The first slice exercises generated literal helpers directly. The full fold
; witnesses linked raw-state IR for seq/ref/cap(run)/ordered-alt and typed
; results. Envelope, admission and FPCPF adapter claims remain outside it.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/bmf-core.fk
; preludes: form-stdlib/bmf-grammar.fk
; preludes: form-stdlib/program-image-fkb.fk
; preludes: form-stdlib/program-image-fkb-byte-container.fk
; preludes: form-stdlib/program-image-fkb-byte-file-witness.fk
; preludes: form-stdlib/program-image-fkb-byte-decode.fk
; preludes: form-stdlib/runtime-artifact-load-envelope.fk
; preludes: form-stdlib/runtime-program-image-fkb-attempt.fk
; preludes: form-stdlib/runtime-program-image-fkb-walker-trace.fk
; preludes: form-stdlib/runtime-program-image-fkb-micro-walker.fk
; preludes: form-stdlib/form-program-image-symbolic-linker.fk
; preludes: form-stdlib/form-program-image-bmf-subset-lower.fk
; preludes: form-stdlib/form-program-image-bmf-raw-state-lower.fk

(do
    (defn fprslb-state-kind ()
        (rpmw-kind-list (list
            (rpmw-kind-string)
            (rpmw-kind-int)
            (rpmw-kind-list (empty)))))
    (defn fprslb-walk (ir entry raw at budget)
        (do
            (let linked (fpis-link ir))
            (let table (fpis-table linked))
            (let entry-index (fpis-label-index (nth ir 1) entry))
            (let root (nth (pif-table-fn-roots table) entry-index))
            (rpmw-eval-node table root budget
                (rpmw-frame-one (fprsl-state raw at (empty))
                    (fprslb-state-kind))
                (rpmw-kind-absent))))
    (defn fprslb-walk-raw (ir raw budget)
        (do
            (let linked (fpis-link ir))
            (let table (fpis-table linked))
            (let entry-index (fpis-label-index
                (nth ir 1) (fprsl-label-entry)))
            (let root (nth (pif-table-fn-roots table) entry-index))
            (rpmw-eval-node table root budget
                (rpmw-frame-one raw (rpmw-kind-string))
                (rpmw-kind-absent))))
    (defn fprslb-result-code-is? (walk code)
        (if (not (rpmw-result-ok? walk)) 0
            (eq (fprsl-result-code (rpmw-result-value walk)) code)))
    (defn fprslb-result-at-is? (walk at)
        (if (not (rpmw-result-ok? walk)) 0
            (eq (fprsl-result-at (rpmw-result-value walk)) at)))
    (defn fprslb-result-kind-child (walk at)
        (nth (rpmw-kind-children (rpmw-result-kind walk)) at))
    (defn fprslb-sum (values)
        (if (nil? values) 0
            (add (head values) (fprslb-sum (tail values)))))
    (defn fprslb-bit (held weight) (if held weight 0))
    (defn fprslb-repeat (value count)
        (if (le count 0) ""
            (str_concat value (fprslb-repeat value (sub count 1)))))
    (defn fprslb-string-row-present? (rows value)
        (if (nil? rows) 0
            (if (value_eq (head rows) (fpbsl-string-bytes value)) 1
                (fprslb-string-row-present? (tail rows) value))))

    (defn fprslb-limits ()
        (fpbsl-limits 8 96 512 16 64 2048 1024 64))
    (defn fprslb-concept-class ()
        (fpbsl-class "concept-byte"
            (list (list 45 45) (list 48 57) (list 97 122))))
    (defn fprslb-digit-class ()
        (fpbsl-class "concept-byte" (list (list 48 57))))
    (defn fprslb-query-grammar ()
        (grammar "query" (list
                (rule3 "query"
                    (list "seq"
                        (p-lit "<q>")
                        (p-cap "coordinate" (p-run "concept-byte"))
                        (p-lit "</q>"))
                    (fpbsl-t-node (list 31 2 0 98)
                        (list
                            (fpbsl-t-trivial-string "concept")
                            (fpbsl-t-capture-trivial-string "coordinate")
                            (fpbsl-t-trivial-int 96)
                            (fpbsl-t-trivial-int 1)
                            (fpbsl-t-trivial-int 0)
                            (fpbsl-t-trivial-string
                                "bmf-core-raw-byte-cursor-v1")))))))
    (defn fprslb-query-spec-with-class (class-row)
        (fpbsl-spec (fprslb-query-grammar)
            (list class-row) (fprslb-limits)))
    (defn fprslb-query-spec ()
        (fprslb-query-spec-with-class (fprslb-concept-class)))
    ; Both ref arms share prefix `a`. This one grammar proves immutable retry,
    ; incomplete cut, ready cut/trailing, and semantic 1/0 pass-through.
    (defn fprslb-decision-spec-with-allow-byte (allow-byte)
        (fpbsl-spec
            (grammar "start" (list
                (rule3 "start"
                    (list "alt" (p-ref "allow") (p-ref "deny"))
                    (fpbsl-t-nothing))
                (rule3 "allow"
                    (list "seq" (p-lit "a") (p-lit allow-byte))
                    (fpbsl-t-int 1))
                (rule3 "deny"
                    (list "seq" (p-lit "a") (p-lit "b"))
                    (fpbsl-t-int 0))))
            (list) (fprslb-limits)))
    (defn fprslb-decision-spec ()
        (fprslb-decision-spec-with-allow-byte "x"))
    (defn fprslb-timeout-alt-spec ()
        (fpbsl-spec
            (grammar "start" (list
                (rule3 "start"
                    (list "alt"
                        (p-cap "digits" (p-run "concept-byte"))
                        (p-lit (fprslb-repeat "7" 257)))
                    (fpbsl-t-nothing))))
            (list (fprslb-digit-class)) (fprslb-limits)))
    (defn fprslb-kind-proof? (ready query-ready allow deny miss)
        (and (rpmw-kind-named?
            (fprslb-result-kind-child ready 0) "int")
        (and (rpmw-kind-named?
            (fprslb-result-kind-child ready 1) "int")
        (and (rpmw-kind-named?
            (fprslb-result-kind-child ready 2) "list")
        (and (rpmw-kind-named?
            (fprslb-result-kind-child ready 3) "nothing")
        (and (rpmw-native-node?
            (fprslb-result-kind-child query-ready 3))
        (and (rpmw-kind-named?
            (fprslb-result-kind-child allow 3) "int")
        (and (rpmw-kind-named?
            (fprslb-result-kind-child deny 3) "int")
            (rpmw-kind-named?
                (fprslb-result-kind-child miss 3) "nothing")))))))))
    (defn fprslb-topology-mutation? (base changed literal-ir)
        (and (eq (len (nth base 1)) (len (nth changed 1)))
        (and (eq (len (nth base 2)) (len (nth changed 2)))
        (and (eq (len (nth base 3)) (len (nth changed 3)))
        (and (not (fpbsl-int-stream-exact?
            (pif-table-numeric-stream (fpis-table (fpis-link base)))
            (pif-table-numeric-stream (fpis-table (fpis-link changed)))))
            (eq (fprslb-string-row-present?
                (pif-table-string-byte-rows
                    (fpis-table (fpis-link literal-ir))) "ax") 0))))))

    (defn form-program-image-bmf-raw-state-lower-band ()
        (do
            (let ir (fprsl-literal-probe-ir "ab"))
            (let changed-ir (fprsl-literal-probe-ir "ac"))
            (let ready (fprslb-walk ir "raw/literal-probe" "ab" 0 10000))
            (let incomplete
                (fprslb-walk ir "raw/literal-probe" "a" 0 10000))
            (let early-no
                (fprslb-walk ir "raw/literal-probe" "xb" 0 10000))
            (let late-no
                (fprslb-walk ir "raw/literal-probe" "ax" 0 10000))
            (let malformed
                (fprslb-walk ir "raw/literal-probe" "ab" 3 10000))
            (let exact-steps (rpmw-result-steps ready))
            (let exact
                (fprslb-walk ir "raw/literal-probe" "ab" 0 exact-steps))
            (let one-short
                (fprslb-walk ir "raw/literal-probe" "ab" 0
                    (sub exact-steps 1)))
            (let query-image (fprsl-lower (fprslb-query-spec)))
            (let decision-image (fprsl-lower (fprslb-decision-spec)))
            (let query-ir (nth query-image 3))
            (let decision-ir (nth decision-image 3))
            (let query-ready (fprslb-walk-raw query-ir
                "<q>novel-7</q>" 200000))
            (let query-node (fprsl-result-semantic
                (rpmw-result-value query-ready)))
            (let expected-query-node
                (intern_node (make_nodeid 31 2 0 98)
                    (list
                        (intern_trivial_string "concept")
                        (intern_trivial_string "novel-7")
                        (intern_trivial_int 96)
                        (intern_trivial_int 1)
                        (intern_trivial_int 0)
                        (intern_trivial_string
                            "bmf-core-raw-byte-cursor-v1"))))
            (let query-miss (fprslb-walk-raw query-ir "z" 200000))
            (let allow (fprslb-walk-raw decision-ir "ax" 200000))
            (let deny (fprslb-walk-raw decision-ir "ab" 200000))
            (let decision-miss
                (fprslb-walk-raw decision-ir "z" 200000))
            (let held-incomplete
                (fprslb-walk-raw decision-ir "a" 200000))
            (let cut-trailing
                (fprslb-walk-raw decision-ir "abz" 200000))
            (let mutation-image (fprsl-lower
                (fprslb-decision-spec-with-allow-byte "y")))
            (let mutation-ir (nth mutation-image 3))
            (let range-image (fprsl-lower
                (fprslb-query-spec-with-class (fprslb-digit-class))))
            (let range-ir (nth range-image 3))
            (let range-no (fprslb-walk-raw range-ir
                "<q>novel-7</q>" 200000))
            (let timeout-image (fprsl-lower (fprslb-timeout-alt-spec)))
            (let timeout-ir (nth timeout-image 3))
            (let run-max-raw (fprslb-repeat "7" 256))
            (let run-over-raw (fprslb-repeat "7" 257))
            (let run-max
                (fprslb-walk-raw timeout-ir run-max-raw 500000))
            (let run-over
                (fprslb-walk-raw timeout-ir run-over-raw 500000))
            (let public-steps (rpmw-result-steps query-ready))
            (let public-exact (fprslb-walk-raw query-ir
                "<q>novel-7</q>" public-steps))
            (let public-short (fprslb-walk-raw query-ir
                "<q>novel-7</q>" (sub public-steps 1)))
            (let forged (fprsl-image (fprslb-decision-spec) query-ir))
            (fprslb-sum (list
                (fprslb-bit (and (fpis-linked? (fpis-link ir))
                    (eq (len (nth ir 1)) 5)) 1)
                (fprslb-bit (and
                    (fprslb-result-code-is? ready (fprsl-code-ready))
                    (fprslb-result-at-is? ready 2)) 2)
                (fprslb-bit (and
                    (fprslb-result-code-is? incomplete
                        (fprsl-code-incomplete))
                    (fprslb-result-at-is? incomplete 1)) 4)
                (fprslb-bit (and
                    (fprslb-result-code-is? early-no (fprsl-code-no))
                    (fprslb-result-at-is? early-no 0)) 8)
                (fprslb-bit (and
                    (fprslb-result-code-is? malformed
                        (fprsl-code-malformed))
                    (fprslb-result-at-is? malformed 3)) 16)
                (fprslb-bit (gt (rpmw-result-steps late-no)
                    (rpmw-result-steps early-no)) 32)
                (fprslb-bit (not (fpbsl-int-stream-exact?
                    (pif-table-numeric-stream
                        (fpis-table (fpis-link ir)))
                    (pif-table-numeric-stream
                        (fpis-table (fpis-link changed-ir))))) 64)
                (fprslb-bit (and (rpmw-result-ok? exact)
                    (and (not (rpmw-result-ok? one-short))
                        (str_eq (rpmw-result-trace-status one-short)
                            (rao-obs-timeout)))) 128)
                (fprslb-bit (and (fprsl-image-shape? query-image)
                    (fprsl-image-shape? decision-image)) 256)
                (fprslb-bit (and
                    (fprslb-result-code-is? query-ready
                        (fprsl-code-ready))
                    (and (node_eq query-node expected-query-node)
                        (eq (fprslb-string-row-present?
                            (pif-table-string-byte-rows
                                (fpis-table (fpis-link query-ir)))
                            "novel-7") 0))) 512)
                (fprslb-bit (and
                    (fprslb-result-code-is? query-miss (fprsl-code-no))
                    (nothing? (fprsl-result-semantic
                        (rpmw-result-value query-miss)))) 1024)
                (fprslb-bit (and
                    (fprslb-result-code-is? allow (fprsl-code-ready))
                    (eq (fprsl-result-semantic
                        (rpmw-result-value allow)) 1)) 2048)
                (fprslb-bit (and
                    (fprslb-result-code-is? deny (fprsl-code-ready))
                    (and (eq (fprslb-result-at-is? deny 2) 1)
                        (eq (fprsl-result-semantic
                            (rpmw-result-value deny)) 0))) 4096)
                (fprslb-bit (and
                    (fprslb-result-code-is? decision-miss (fprsl-code-no))
                    (nothing? (fprsl-result-semantic
                        (rpmw-result-value decision-miss)))) 8192)
                (fprslb-bit (fprslb-result-code-is? held-incomplete
                    (fprsl-code-incomplete)) 16384)
                (fprslb-bit (fprslb-result-code-is? cut-trailing
                    (fprsl-code-malformed)) 32768)
                (fprslb-bit (and
                    (fprslb-result-code-is? run-max (fprsl-code-ready))
                    (and (fprslb-result-at-is? run-max 256)
                        (nothing? (fprsl-result-semantic
                            (rpmw-result-value run-max))))) 65536)
                (fprslb-bit (and
                    (fprslb-result-code-is? run-over
                        (fprsl-code-semantic-timeout))
                    (and (fprslb-result-at-is? run-over 256)
                        (nothing? (fprsl-result-semantic
                            (rpmw-result-value run-over))))) 131072)
                (fprslb-bit (and (rpmw-result-ok? public-exact)
                    (and (not (rpmw-result-ok? public-short))
                        (str_eq (rpmw-result-trace-status public-short)
                            (rao-obs-timeout)))) 262144)
                (fprslb-bit (fprslb-kind-proof? ready query-ready
                    allow deny decision-miss) 524288)
                (fprslb-bit (fprslb-topology-mutation?
                    decision-ir mutation-ir ir) 1048576)
                (fprslb-bit (eq (fprsl-image? forged) 0) 2097152)
                (fprslb-bit (and
                    (fprsl-image-shape? range-image)
                    (and (not (fpbsl-int-stream-exact?
                        (pif-table-numeric-stream
                            (fpis-table (fpis-link query-ir)))
                        (pif-table-numeric-stream
                            (fpis-table (fpis-link range-ir)))))
                        (fprslb-result-code-is? range-no
                            (fprsl-code-no)))) 4194304)
                (fprslb-bit (and (fprsl-image? query-image)
                    (fprsl-image? decision-image)) 8388608)))))

    (form-program-image-bmf-raw-state-lower-band))
; expect 16777215
