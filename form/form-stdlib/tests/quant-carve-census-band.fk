; preludes: form-stdlib/core.fk form-stdlib/qk-matvec-lane.fk form-stdlib/q6k-msl.fk form-stdlib/q4k-msl.fk form-stdlib/q8-0-msl.fk form-stdlib/q5-msl.fk form-stdlib/q3k-msl.fk form-stdlib/q2k-msl.fk form-stdlib/iq2xxs-msl.fk form-stdlib/iq2xs-msl.fk form-stdlib/iq3xxs-msl.fk form-stdlib/iq4nl-msl.fk form-stdlib/iq4xs-msl.fk form-stdlib/mxfp4-msl.fk form-stdlib/mxfp8-msl.fk
; Expected: 32767
; PROOF LEVEL: FOURTH-ARM ONLY (metal handle door)
;
; quant-carve-census-band — every quantized format this body carves on the GPU, asked of this Mac's
; Metal compiler in one place, each unit assembled the way its live lane assembles it.
;
; The carvers' own bands compare the emitted text with Form's arithmetic and with independent oracles;
; they never hand the text to a compiler. msl-families-mint-band exists because eight tensor families
; read green for months while the compiler was not taking them (corpus row 1414, saidsocompile). The quant carvers
; had the same blind spot: five of the fourteen (Q2_K, Q5_0/Q5_K, IQ3_XXS, IQ4_NL, IQ4_XS) had no band
; that ever asked for a handle. This band asks.
;
; What it claims: fourteen GGUF quant formats have a Metal carver that is a kernel on this host. What
; it does not claim: that each decodes correctly. That is witnessed per format elsewhere — q8-0-msl,
; q2k/q3k/q4k/q6k-dequant and -msl, iq2xxs/iq2xs/iq3xxs/iq4nl/iq4xs-dequant against ggml-shaped oracles,
; mx-msl, and on real weights q8-0-matvec-tg and q6k-q4k-matvec-tg. Storage types (F32, F16, BF16, I32)
; need no carver and are not counted.
;
; Verdict 32767, one bit per GGUF type, in type order:
;      1  Q5_0      (6)          128  IQ2_XXS  (16)
;      2  Q8_0      (8)          256  IQ2_XS   (17)
;      4  Q2_K     (10)          512  IQ3_XXS  (18)
;      8  Q3_K     (11)         1024  IQ4_NL   (20)
;     16  Q4_K     (12)         2048  IQ4_XS   (23)
;     32  Q5_K     (13)         4096  MXFP4, plane-split (40)
;     64  Q6_K     (14)         8192  MXFP8, plane-split (41)
;  16384  THE DOOR IS NOT LYING: the compiler still does not take a bare `mem_flags::` barrier and still
;         mints its `metal::` twin, so a dead carrier answering 0 for everything, or yes for everything,
;         cannot pass
(do
    (defn qc-bit (src name w) (if (gt (metal_pipeline src name) 0) w 0))
    (defn qc-unit (body) (str_concat (qml-msl-header) body))

    (let q5 (qc-unit (str_concat (q4m-msl-helpers)
                (q5m-msl-appendix "qc_q5kd" "qc_q5km" "qc_q50d" "qc_q50m"))))
    (let b0 (qc-bit q5 "qc_q50d" 1))
    (let b1 (qc-bit (qc-unit (q80-msl-unit "qc_q80d" "qc_q80m" "qc_q80l")) "qc_q80d" 2))
    (let b2 (qc-bit (qc-unit (q2km-dequant-msl "qc_q2kd")) "qc_q2kd" 4))
    (let b3 (qc-bit (qc-unit (str_concat (q6m-msl-int) (str_concat (q6m-msl-f16)
                (str_concat (q3m-fh16-bridge) (str_concat (q3m-decl) (q3m-dequant-msl "qc_q3kd"))))))
                "qc_q3kd" 8))
    (let b4 (qc-bit (qc-unit (q4m-msl-unit "qc_q4kd" "qc_q4km")) "qc_q4kd" 16))
    (let b5 (qc-bit q5 "qc_q5kd" 32))
    (let b6 (qc-bit (qc-unit (q6m-msl-unit "qc_q6kd" "qc_q6km")) "qc_q6kd" 64))
    (let b7 (qc-bit (qc-unit (iq2m-dequant-msl "qc_iq2xxsd")) "qc_iq2xxsd" 128))
    (let b8 (qc-bit (qc-unit (iq2xsm-msl-unit "qc_iq2xsd" "qc_iq2xsm" "qc_iq2xss" "qc_iq2xsq")) "qc_iq2xsd" 256))
    (let b9 (qc-bit (qc-unit (iq3xsm-unit "qc_iq3d" "qc_iq3m" "qc_iq3s")) "qc_iq3d" 512))
    (let b10 (qc-bit (qc-unit (str_concat (iq4nlsm-msl-helpers) (iq4nlsm-row-gather-body "qc_iq4nlg"))) "qc_iq4nlg" 1024))
    (let b11 (qc-bit (qc-unit (iq4xsm-unit "qc_iq4xsd" "qc_iq4xsm" "qc_iq4xss" "qc_iq4xsg")) "qc_iq4xsd" 2048))
    (let b12 (qc-bit (qc-unit (mx4m-msl-unit "qc_mx4d" "qc_mx4m")) "qc_mx4d" 4096))
    (let b13 (qc-bit (qc-unit (mxm-msl-unit "qc_mx4d8" "qc_mx4m8" "qc_mx8d" "qc_mx8m")) "qc_mx8d" 8192))

    (let bare "kernel void qc_bare(device float* o [[buffer(0)]], uint t [[thread_position_in_threadgroup]]) { o[t] = 1.0f; threadgroup_barrier(mem_flags::mem_device); }")
    (let qual "kernel void qc_qual(device float* o [[buffer(0)]], uint t [[thread_position_in_threadgroup]]) { o[t] = 1.0f; threadgroup_barrier(metal::mem_flags::mem_device); }")
    (let b14 (if (eq (metal_pipeline bare "qc_bare") 0)
             (if (gt (metal_pipeline qual "qc_qual") 0) 16384 0) 0))

    (add b0 (add b1 (add b2 (add b3 (add b4 (add b5 (add b6
    (add b7 (add b8 (add b9 (add b10 (add b11 (add b12 (add b13 b14)))))))))))))))
