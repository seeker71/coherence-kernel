; we-glass-band.fk — WE on glass: the fold is pure and every row carries
; its source; a percentage exists only where one unit does; absent says
; so; primitives are named through the manifest; every choice vocabulary
; is a row, counted where it can be. No host read, no bus write.
; Expected: 1023
;   1    process rows: cpu and recipe parse; renderers see, blocked residents are, the rest does
;   2    cpu shares by mode sum to 100 when cpu burns, and are all 0 over an idle host
;   4    tool shares: edits do, probes see, no be; whole is their sum
;   8    the census: fifteen rows, five levels by three modes, every row valid
;   16   absent says so: me.see and us.be are absent and never present
;   32   a value found by (level mode) is the value handed in
;   64   the hottest tag is named through the manifest; an unknown tag keeps its number
;   128  choices: every declared family is rows with count -1 (an offer to be observed)
;        and the channel family counts 0 over an empty root; the observed count folds
;   256  every sample built for the bus is valid under the membrane
;   512  the witness word of a receipt head reads Witness: and Signed, forms; the
;        witness line counts by name
; preludes: form/form-stdlib/we-glass.bml
(do
    (defn wgb-bit (ok bit) (if ok bit 0))
    (defn wgb-ps () "99 observe/form-glass-live-run.fk\n0 observe/form-cli-peer-contribution-live.fk\n50 observe/cell-channel-witness-run.fk\n\n")
    (defn wgb-rows () (wg-census-of (wg-process-rows (wgb-ps)) 205624904899 7 15 161 1200 70 16 1 57 38 662))
    (defn wgb-all-valid (samples) (if (eq (len samples) 0) 1 (if (eq (fgtm-sample-valid? (head samples)) 1) (wgb-all-valid (tail samples)) 0)))

    (defn wgb-k1 ()
        (do (let rows (wg-process-rows (wgb-ps)))
            (and (eq (len rows) 3)
            (and (eq (head (head rows)) 99)
            (and (str_eq (nth (head rows) 2) "see")
            (and (str_eq (nth (nth rows 1) 2) "be")
                 (str_eq (nth (nth rows 2) 2) "do")))))))
    (defn wgb-k2 ()
        (do (let s (wg-cpu-shares (wg-process-rows (wgb-ps))))
            (let idle (wg-cpu-shares (wg-process-rows "0 observe/x-live.fk\n")))
            (and (eq (add (nth s 0) (add (nth s 1) (nth s 2))) 99)
            (and (eq (nth s 2) 66)
            (and (eq (nth s 0) 33)
            (and (eq (nth s 3) 149)
            (and (eq (nth idle 3) 0)
                 (eq (nth idle 2) 0))))))))
    (defn wgb-k4 ()
        (do (let t (wg-tool-shares 15 161))
            (and (eq (nth t 3) 176)
            (and (eq (nth t 1) 0)
            (and (eq (nth t 0) 8)
                 (eq (nth t 2) 91))))))
    (defn wgb-k8 ()
        (do (let rows (wgb-rows))
            (and (eq (len rows) 15)
            (and (eq (wg-rows-valid? rows) 1)
                 (eq (len (wg-levels)) 5)))))
    (defn wgb-k16 ()
        (do (let rows (wgb-rows))
            (and (eq (wg-present? (wg-find rows "me" "see")) 0)
            (and (eq (wg-present? (wg-find rows "us" "be")) 0)
            (and (str_eq (wg-evidence (wg-find rows "me" "see")) "declared")
                 (str_eq (wg-cell rows "me" "see") "absent"))))))
    (defn wgb-k32 ()
        (do (let rows (wgb-rows))
            (and (eq (wg-value-of rows "me" "do") 7)
            (and (eq (wg-value-of rows "us-all" "do") 70)
            (and (eq (wg-value-of rows "we" "see") 662)
            (and (eq (wg-value-of rows "you" "do") 205624904899)
                 (eq (wg-value-of rows "nowhere" "do") (sub 0 1))))))))
    (defn wgb-k64 ()
        (and (str_eq (wg-op-name 3) "add")
        (and (str_eq (wg-op-name 20) "head")
             (str_eq (wg-op-name 9999) "tag-9999"))))
    (defn wgb-k128 ()
        (do (let cs (wg-choices "/tmp/we-glass-band-no-such-root"))
            (let glass (wg-choices-of-family cs "glass-control"))
            (let channel (wg-choices-of-family cs "channel"))
            (and (eq (len glass) 9)
            (and (eq (wg-choice-count (head glass)) (sub 0 1))
            (and (str_eq (wg-choice-evidence (head glass)) "declared")
            (and (eq (len channel) 4)
            (and (eq (wg-choice-count (head channel)) 0)
            (and (eq (wg-choices-observed cs) 4)
                 (eq (len cs) 23)))))))))
    (defn wgb-k256 ()
        (do (let rows (wgb-rows))
            (let prims (list (wg-prim "owner.dispatch-total" 205624904899 "models.dual-resident.i1" "physical-live") (wg-prim "self.hottest.add" 12 "kernel-stat-2-3" "physical-live")))
            (let samples (wg-samples rows (wg-cpu-shares (wg-process-rows (wgb-ps))) (wg-tool-shares 15 161) prims (wg-choices "/tmp/we-glass-band-no-such-root") 1700000000000))
            (and (eq (wgb-all-valid samples) 1)
                 (eq (len samples) (add 15 (add 2 (add 2 23)))))))
    (defn wgb-k512 ()
        (do (let ws (list "Grok" "Grok" "Codex" "Claude"))
            (and (str_eq (wg-witness-word "# T\n\nDate: x\nWitness: Grok, in relation with Urs\n") "Grok,")
            (and (str_eq (wg-witness-clean (wg-witness-word "# T\n\nDate: x\nWitness: Grok, in relation with Urs\n")) "Grok")
            (and (str_eq (wg-witness-clean (wg-witness-word "body\nSigned, Codex.\n")) "Codex")
            (and (str_eq (wg-witness-word "no signature") "unsigned")
            (and (eq (wg-count-word ws "Grok") 2)
            (and (eq (len (wg-distinct ws (list))) 3)
                 (str_eq (wg-witness-line ws (wg-distinct ws (list))) "Grok=2 Codex=1 Claude=1 ")))))))))

    (sum (list
        (wgb-bit (wgb-k1) 1)
        (wgb-bit (wgb-k2) 2)
        (wgb-bit (wgb-k4) 4)
        (wgb-bit (wgb-k8) 8)
        (wgb-bit (wgb-k16) 16)
        (wgb-bit (wgb-k32) 32)
        (wgb-bit (wgb-k64) 64)
        (wgb-bit (wgb-k128) 128)
        (wgb-bit (wgb-k256) 256)
        (wgb-bit (wgb-k512) 512))))
