; living-world-enquiry-profile-voice-witness.fk -- one shared observed profile
; speaks without choosing either executable hypothesis.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-prospective-suite.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk

(let LWRPV-SOURCE-A   (bp "LWRPV-SOURCE-A"))
(let LWRPV-SOURCE-B   (bp "LWRPV-SOURCE-B"))
(let LWRPV-SOURCE-C   (bp "LWRPV-SOURCE-C"))
(let LWRPV-SOURCE-D   (bp "LWRPV-SOURCE-D"))
(let LWRPV-OUTSIDE-A  (bp "LWRPV-OUTSIDE-A"))
(let LWRPV-OUTSIDE-B  (bp "LWRPV-OUTSIDE-B"))
(let LWRPV-COORDINATE (bp "LWRPV-COORDINATE"))
(let LWRPV-EVIDENCE   (bp "LWRPV-EVIDENCE"))
(let LWRPV-RESULT     (bp "LWRPV-RESULT"))

(defn lwrpv-cell (kind) (intern_node kind (empty)))
(defn lwrpv-source-a () (lwrpv-cell LWRPV-SOURCE-A))
(defn lwrpv-source-b () (lwrpv-cell LWRPV-SOURCE-B))
(defn lwrpv-source-c () (lwrpv-cell LWRPV-SOURCE-C))
(defn lwrpv-source-d () (lwrpv-cell LWRPV-SOURCE-D))
(defn lwrpv-outside-a () (lwrpv-cell LWRPV-OUTSIDE-A))
(defn lwrpv-outside-b () (lwrpv-cell LWRPV-OUTSIDE-B))
(defn lwrpv-coordinate () (lwrpv-cell LWRPV-COORDINATE))
(defn lwrpv-evidence () (lwrpv-cell LWRPV-EVIDENCE))

(defn lwrpv-entry (source payload)
    (lwphw-entry source (lwrpv-evidence) payload))
(defn lwrpv-response-entry (source proposal)
    (lwrpv-entry source
        (lwt-response proposal (oac-one proposal) (lwrpv-evidence))))

(defn lwrpv-symbol-observation (output)
    (lwsl-observation-at output (lwrpv-coordinate) "profile-voice"
        (lwo-none) (oac-one output) (lwrpv-evidence)))

(defn lwrpv-offer-request (world request)
    (lwt-receive-stream world
        (list (lwrpv-entry (lwrpv-source-c) request)
              (lwrpv-entry (lwrpv-source-d) request))))

(defn lwrpv-outside-binding-entries (source items entries)
    (if (eq (len items) 0) entries
        (do
            (let binding (head items))
            (let projection (lwre-binding-projection binding))
            (lwrpv-outside-binding-entries source (tail items)
                (cons (lwrpv-entry source binding)
                    (cons (lwrpv-entry source
                            (lwre-binding-source binding))
                        (cons (lwrpv-entry source projection)
                            entries)))))))

(defn lwrpv-outside-bindings (blueprint)
    (lwre-bindings
        (list
            (lwre-projected-binding "left"
                (lwre-projection blueprint (lwrpv-outside-a)
                    (intern_trivial_int 7) (lwo-empty-field) (lwo-none)
                    (lwrpv-evidence))
                (lwrpv-evidence))
            (lwre-projected-binding "right"
                (lwre-projection blueprint (lwrpv-outside-b)
                    (intern_trivial_int 7) (lwo-empty-field) (lwo-none)
                    (lwrpv-evidence))
                (lwrpv-evidence)))))

(defn lwrpv-result
    (profile-result symbol-world symbol exact-request exact-answer exact-plan
     utterance open-request open-answer open-plan expired-request expired-answer
     expired-plan revoked)
    (intern_node LWRPV-RESULT
        (list profile-result symbol-world symbol exact-request exact-answer
              exact-plan utterance open-request open-answer open-plan
              expired-request expired-answer expired-plan revoked)))

(defn lwrpv-run ()
    (do
        ; Recursive profile formation streams its own first framebuffer window.
        (let profile-result (lwrpw-run))
        (let world (nth (node_children profile-result) 3))
        (let blueprint (nth (node_children profile-result) 1))
        (let space (nth (node_children profile-result) 4))
        (let class (nth (node_children profile-result) 8))
        (let point (head (lwo-field-items (lwep-class-points class))))
        (let bindings (lwep-point-bindings point))
        (let output (lwep-point-output point))
        (let started
            (lcfb-open-stream "living-world-enquiry-profile-voice"
                "form-native" "lwrpv-run"
                "shared-profile-to-native-surface"
                "form/form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk"
                72 1))

        ; Surface learning is a separate participant membrane over the shared
        ; output identity, never over one selected hypothesis.
        (let observation (lwrpv-symbol-observation output))
        (let observed
            (lwt-receive-stream world
                (list (lwrpv-entry (lwrpv-source-a) observation)
                      (lwrpv-entry (lwrpv-source-b) observation))))
        (let proposal (lwsl-proposal-for observed observation 2))
        (let round
            (lwt-round observed (lwo-field (list proposal))
                (lwo-empty-field) (lwo-none)))
        (let responded
            (lwt-round-receive round
                (list (lwrpv-response-entry (lwrpv-source-a) proposal)
                      (lwrpv-response-entry (lwrpv-source-b) proposal))))
        (let integrated (lwsl-integrate responded proposal (lwphw-action)))
        (let symbol-world (lwt-round-world integrated))
        (let symbol (lwt-proposal-candidate proposal))
        (let symbol-frame
            (lcfb-call-stream "living-world-enquiry-profile-voice"
                "surface" "leave" "form-native" "lwsl-integrate"
                "shared-output-surface-current:1" 1 started
                "form/form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk"
                98 1))

        (let pending-timeout
            (oac-timeout (intern_trivial_int 10) (oac-no-default)
                (lwrpv-evidence)))
        (let exact-request
            (lwepv-request class bindings (lwo-field (list symbol))
                (lwo-empty-field) (lwep-class-unknown class) (lwo-none)
                pending-timeout (intern_trivial_int 5) (lwrpv-evidence)))
        (let exact-world (lwrpv-offer-request symbol-world exact-request))
        (let exact-answer (lwepv-answer-for exact-world exact-request))
        (let exact-plan
            (lwepv-plan-for exact-world exact-answer
                (lwo-field (list symbol))))
        (let utterance (lwepv-utterance-for exact-world exact-plan))
        (let answer-frame
            (lcfb-call-stream "living-world-enquiry-profile-voice"
                "answer" "leave" "form-native"
                "lwepv-answer-for/lwepv-utterance-for"
                "immediate:ONE:time:PENDING:hypotheses:2:voice:1"
                2 started
                "form/form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk"
                119 1))

        ; A current binding outside the finite profile has NOTHING now.  Its
        ; unexpired timeout remains a distinct pending observation.
        (let outside (lwrpv-outside-bindings blueprint))
        (let outside-world
            (lwt-receive-stream exact-world
                (append
                    (lwrpv-outside-binding-entries (lwrpv-source-c)
                        (lwre-binding-items outside) (empty))
                    (lwrpv-outside-binding-entries (lwrpv-source-d)
                        (lwre-binding-items outside) (empty)))))
        (let open-request
            (lwepv-request class outside (lwo-field (list symbol))
                (lwo-empty-field) (lwep-class-unknown class) (lwo-none)
                pending-timeout (intern_trivial_int 5) (lwrpv-evidence)))
        (let open-world (lwrpv-offer-request outside-world open-request))
        (let open-answer (lwepv-answer-for open-world open-request))
        (let open-plan
            (lwepv-plan-for open-world open-answer
                (lwo-field (list symbol))))
        (let open-frame
            (lcfb-call-stream "living-world-enquiry-profile-voice"
                "nothing-now" "leave" "form-native" "lwepv-answer-for"
                "immediate:NOTHING:time:PENDING:voice:0" 3 started
                "form/form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk"
                143 1))

        ; The sender may separately declare what expiration condenses to.  That
        ; alternative remains a timed response and cannot invent a profile point.
        (let default
            (oac-alternative-ack class outside (lwrpv-evidence)))
        (let expired-timeout
            (oac-timeout (intern_trivial_int 10) default (lwrpv-evidence)))
        (let expired-request
            (lwepv-request class outside (lwo-field (list symbol))
                (lwo-field (list outside)) (lwep-class-unknown class)
                (lwo-none) expired-timeout (intern_trivial_int 10)
                (lwrpv-evidence)))
        (let expired-world
            (lwrpv-offer-request open-world expired-request))
        (let expired-answer
            (lwepv-answer-for expired-world expired-request))
        (let expired-plan
            (lwepv-plan-for expired-world expired-answer
                (lwo-field (list symbol))))
        (let time-frame
            (lcfb-call-stream "living-world-enquiry-profile-voice"
                "timeout" "leave" "form-native" "oac-timeout-condense"
                "immediate:NOTHING:time:OUTCOME:default:ALTERNATIVE:voice:0"
                4 started
                "form/form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk"
                166 1))

        ; Revoking one required class-space offer stales the exact utterance in
        ; the fully augmented world without removing its historical lineage.
        (let revocation
            (lwo-revocation space (lwphw-source-m) (lwrpw-reason)
                (lwphw-prov-m)))
        (let revoked
            (lwt-receive-stream expired-world
                (list (lwphw-entry-m revocation))))
        (let revoke-frame
            (lcfb-call-stream "living-world-enquiry-profile-voice"
                "revocation" "leave" "form-native"
                "lwo-revocation/lwepv-utterance-current?"
                "class-current:1->0:utterance-current:1->0:history-retained"
                5 started
                "form/form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk"
                184 1))
        (lwrpv-result profile-result expired-world symbol exact-request
            exact-answer exact-plan utterance open-request open-answer open-plan
            expired-request expired-answer expired-plan revoked)))

0
