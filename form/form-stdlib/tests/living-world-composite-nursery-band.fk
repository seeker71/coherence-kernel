(defn lwocnb-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwocnb-sum (tail items)))))

(defn lwocnb-progress
    (live-start call phase modifier target ordinal line)
    (lcfb-call-stream "living-world-composite-nursery-band"
        call phase "form-native" modifier target ordinal live-start
        "form/form-stdlib/tests/living-world-composite-nursery-band.fk"
        line 9))

; The earlier composite witnesses are real Form calls, not fixtures loaded from
; an oracle.  Keep the exact active call visible while they build this world.
(defn lwocnb-build-base-stream (live-start)
    (do
        (let schema-enter
            (lwocnb-progress live-start "evolved.base.schema" "enter"
                "lwsrw-integrated-schema" "construct:schema" 201 23))
        (let schema (lwsrw-integrated-schema))
        (let world-enter
            (lwocnb-progress live-start "evolved.base.world" "enter"
                "lwoew-base-world" "construct:base-world" 202 27))
        (let world (lwoew-base-world schema))
        (let proposal-enter
            (lwocnb-progress live-start "evolved.base.proposal" "enter"
                "lwoe-proposal" "propose:operation-field" 203 31))
        (let proposal
            (lwoe-proposal world (lwoew-enquiry)
                (lwoew-codecs schema) 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let field (lwo-emergent-shape candidate))
        (let integrate-enter
            (lwocnb-progress live-start "evolved.base.integrate" "enter"
                "lwoew-integrate-field" "integrate:operation-field" 204 39))
        (let integrated (lwoew-integrate-field world schema (lwo-none)))
        (let query-enter
            (lwocnb-progress live-start "evolved.base.query" "enter"
                "lwoew-query-world" "construct:rich-query" 205 43))
        (let query (lwoew-rich-query candidate schema))
        (let query-world
            (lwoew-query-world (lwt-round-world integrated) query schema))
        (let answer-enter
            (lwocnb-progress live-start "evolved.base.answer" "enter"
                "lwoe-answer-for" "observe:base-answer" 206 49))
        (let answer
            (lwoe-answer-for query-world query 2 (intern_trivial_int 5)))
        (let base
            (lwoew-base-fixture schema integrated candidate field query-world
                query answer))
        (let base-leave
            (lwocnb-progress live-start "evolved.base" "leave"
                "lwoew-base-fixture" "constructed:base" 207 57))
        base))

(defn lwocnb-build-evolved-stream (live-start)
