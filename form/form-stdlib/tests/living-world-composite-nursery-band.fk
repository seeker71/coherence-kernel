                313 9))
        (let blueprint (lwocnb-blueprint-stream component schema live-start))
        (let blueprint-world-enter
            (lwocnb-progress live-start "core.blueprint.world" "enter"
                "lwoecw-blueprint-world" "construct:blueprint-world" 407 320))
        (let blueprint-world (lwoecw-blueprint-world evolved))
        (let proposal-enter
            (lwocnb-progress live-start "core.blueprint.proposal" "enter"
                "lwoec-proposal" "propose:composite-recipe" 408 324))
        (let proposal
            (lwocnb-proposal-stream blueprint-world blueprint 2 live-start))
        (let production-enter
            (lwocnb-progress live-start "core.blueprint.production-proposal"
                "enter" "lwoec-proposal" "verify:exact-production-identity"
                409 329))
        (let production-proposal
            (lwoec-proposal blueprint-world blueprint 2))
        (let identity-clean (node_eq proposal production-proposal))
        (let production-leave
            (lwocnb-progress live-start "core.blueprint.production-proposal"
                "leave" "lwoec-proposal"
                (if identity-clean "identity-clean:1" "identity-clean:0")
                410 336))
        (let composite
            (if identity-clean (lwt-proposal-candidate proposal) (lwo-none)))
        (let integrate-enter
            (lcfb-call-stream "living-world-composite-nursery-band"
                "core.composite" "enter" "form-native" "lwoec-integrate"
                "integrate:composite" 104 live-start
                "form/form-stdlib/tests/living-world-composite-nursery-band.fk"
                343 9))
        (let integrated
            (lwoec-integrate
                (lwphw-answered-round blueprint-world proposal
                    (lwoew-evolved-round evolved))
                proposal (lwphw-action)))
        (let field (lwo-emergent-shape composite))
        (let profiles (lwo-field-items (lwoec-field-compatible field)))
        (let target-enter
            (lcfb-call-stream "living-world-composite-nursery-band"
                "core.target" "enter" "form-native" "lwtnw-build-target"
                "construct:transformation-target" 105 live-start
                "form/form-stdlib/tests/living-world-composite-nursery-band.fk"
                356 9))
        (let target-fixture (lwtnw-build-target))
        (let merge-enter
            (lcfb-call-stream "living-world-composite-nursery-band"
                "core.world" "enter" "form-native" "lwocnw-merge-world"
                "merge:consented-worlds" 106 live-start
                "form/form-stdlib/tests/living-world-composite-nursery-band.fk"
                363 9))
        (let world
            (lwocnw-merge-world (lwt-round-world integrated)
                (lwtnw-target-world target-fixture)))
        (let core
            (lwocnw-core world composite blueprint
                (nth profiles 0) (nth profiles 1)
                (lwtnw-target target-fixture)
                (lwtnw-target-round target-fixture) schema))
        (let core-leave
            (lcfb-call-stream "living-world-composite-nursery-band"
                "core.world" "leave" "form-native" "lwocnw-core"
                "constructed:merged-core" 107 live-start
                "form/form-stdlib/tests/living-world-composite-nursery-band.fk"
                377 9))
        core))

