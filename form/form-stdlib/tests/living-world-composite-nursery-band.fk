        (let evolved-leave
            (lwocnb-progress live-start "evolved" "leave"
                "lwoew-evolved-fixture" "constructed:evolved" 307 104))
        evolved))

(defn lwocnb-blueprint-stream (component schema live-start)
    (do
        (let role-enter
            (lwocnb-progress live-start "core.blueprint.role" "enter"
                "lwoew-first-role" "read:first-role" 401 111))
        (let role (lwoew-first-role schema))
        (let codecs-enter
            (lwocnb-progress live-start "core.blueprint.codecs" "enter"
                "lwoew-codecs" "read:codecs" 402 115))
        (let codecs (lwoew-codecs schema))
        (let other-enter
            (lwocnb-progress live-start "core.blueprint.alternative" "enter"
                "lwoecw-other-blueprint" "construct:other-blueprint" 403 119))
        (let other (lwoecw-other-blueprint component schema))
        (let alternatives
            (lwo-field (list other (lwoecw-alternative))))
        (let choice-enter
            (lwocnb-progress live-start "core.blueprint.optionality" "enter"
                "lwoecw-choice" "construct:choice-unknown-timeout" 404 125))
        (let unknown (lwlc-unknown (lwoecw-evidence)))
        (let choice (lwoecw-choice))
        (let timeout (lwoecw-timeout))
        (let intern-enter
            (lwocnb-progress live-start "core.blueprint.intern" "enter"
                "lwoec-blueprint" "intern:composite-blueprint" 405 131))
        (let blueprint
            (lwoec-blueprint component role codecs alternatives unknown
                choice timeout (lwoecw-evidence)))
        (let blueprint-leave
            (lwocnb-progress live-start "core.blueprint" "leave"
                "lwoec-blueprint" "constructed:composite-blueprint" 406 137))
        blueprint))

(defn lwocnb-field-for-stream (world blueprint threshold live-start)
    (do
        (let current-enter
            (lwocnb-progress live-start "core.proposal.current" "enter"
                "lwoec-blueprint-current?" "observe:blueprint-current" 501 144))
        (let current
            (lwoec-blueprint-current? world blueprint threshold))
        (if (eq current 0) (lwo-none)
            (do
                (let component-enter
                    (lwocnb-progress live-start "core.proposal.component" "enter"
                        "lwo-emergent-shape" "read:component-field" 502 151))
                (let component-field
                    (lwo-emergent-shape
                        (lwoec-blueprint-component blueprint)))
                (let examples-enter
                    (lwocnb-progress live-start "core.proposal.examples" "enter"
                        "lwoec-examples-for-under-current-blueprint"
                        "collect:current-examples" 503 157))
                (let examples
                    (lwoec-examples-for-under-current-blueprint
                        world blueprint threshold))
                (if (eq (lwo-field-size examples) 0) (lwo-none)
                    (do
                        (let profiles-enter
                            (lwocnb-progress live-start "core.proposal.profiles"
                                "enter" "lwoec-profiles-for-current-items"
                                "derive:current-profiles" 504 166))
                        (let profiles
                            (lwoec-profiles-for-current-items blueprint
                                (lwo-field-items
                                    (lwoe-field-compatible component-field))
                                examples (lwo-empty-field)))
                        (let classify-enter
                            (lwocnb-progress live-start "core.proposal.classify"
                                "enter" "lwoec-filter-profiles"
                                "partition:profile-states" 505 175))
                        (let compatible
                            (lwoec-filter-profiles
                                (lwo-field-items profiles)
                                (lwph-consistent) (lwo-empty-field)))
                        (let contradicted
                            (lwoec-filter-profiles
                                (lwo-field-items profiles)
                                (lwph-divergent) (lwo-empty-field)))
                        (let unresolved
                            (lwoec-filter-profiles
                                (lwo-field-items profiles)
                                (lwph-unresolved) (lwo-empty-field)))
                        (let signatures-enter
                            (lwocnb-progress live-start "core.proposal.signatures"
                                "enter" "lwoec-signatures-for-profiles"
                                "derive:signatures" 506 191))
                        (let signatures
                            (lwoec-signatures-for-profiles
                                (lwo-field-items compatible)
                                (lwo-empty-field)))
                        (let classes-enter
                            (lwocnb-progress live-start "core.proposal.classes"
                                "enter" "lwoec-classes-for-signatures"
                                "derive:classes" 507 199))
                        (let classes
                            (lwoec-classes-for-signatures
                                (lwo-field-items signatures)
                                (lwo-field-items compatible)
                                (lwo-empty-field)))
                        (let class-count (lwo-field-size classes))
                        (let profile-count (lwo-field-size profiles))
                        (let status
                            (if (eq profile-count 0) (lwph-open)
                                (if (gt class-count 1) (lwph-plural)
                                    (if (eq class-count 1) (lwph-singular)
                                        (if (eq (lwo-field-size contradicted)
                                                profile-count)
                                            (lwph-refuted) (lwph-open))))))
                        (let optionality-enter
                            (lwocnb-progress live-start "core.proposal.optionality"
                                "enter" "lwoec-profile-alternatives-items"
                                "collect:alternatives-unknowns" 508 217))
                        (let alternatives
                            (lwoec-profile-alternatives-items
                                (lwo-field-items profiles)
                                (lwoec-blueprint-alternatives blueprint)))
                        (let blueprint-unknown
                            (lwoec-blueprint-unknown blueprint))
                        (let unknown-seed
                            (if (node_eq blueprint-unknown (lwo-none))
                                (lwo-empty-field)
                                (lwo-field-add (lwo-empty-field)
                                    blueprint-unknown)))
                        (let unknowns
                            (lwoec-profile-unknowns-items
                                (lwo-field-items profiles) unknown-seed))
                        (let witnesses-enter
                            (lwocnb-progress live-start "core.proposal.witnesses"
                                "enter" "lwoec-field-witnesses"
                                "collect:witnesses" 509 235))
                        (let witnesses
                            (lwoec-field-witnesses world blueprint examples))
                        (let field-enter
                            (lwocnb-progress live-start "core.proposal.field"
                                "enter" "lwoec-field" "intern:field" 510 241))
                        (let field
                            (lwoec-field blueprint examples profiles compatible
                                contradicted unresolved classes status
                                alternatives unknowns witnesses threshold))
                        (let field-leave
                            (lwocnb-progress live-start "core.proposal.field"
                                "leave" "lwoec-field" "constructed:field" 511 248))
                        field)))))

(defn lwocnb-proposal-stream (world blueprint threshold live-start)
    (do
        (let field-enter
            (lwocnb-progress live-start "core.proposal.field-for" "enter"
                "lwocnb-field-for-stream" "construct:field" 601 255))
        (let field
            (lwocnb-field-for-stream world blueprint threshold live-start))
        (if (or (node_eq field (lwo-none))
                (eq (lwo-field-size (lwoec-field-profiles field)) 0))
            (lwo-none)
            (do
                (let candidate-enter
                    (lwocnb-progress live-start "core.proposal.candidate" "enter"
                        "lwo-emergent" "construct:candidate" 602 264))
                (let witnesses (lwoec-field-witness-field field))
                (let origin (lwoec-origin blueprint threshold))
                (let candidate
                    (lwo-emergent field witnesses
                        (intern_trivial_int 1)
                        (intern_trivial_int
                            (lwo-field-size
                                (lwoec-field-compatible field)))
                        (intern_trivial_int
                            (lwo-field-size
                                (lwoec-field-profiles field)))
                        origin))
                (let participants-enter
                    (lwocnb-progress live-start "core.proposal.participants"
                        "enter" "lwt-sources-from-attributions"
                        "derive:participants" 603 279))
                (let participants
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field)))
                (let proposal
                    (lwt-proposal candidate participants origin))
                (let proposal-leave
                    (lwocnb-progress live-start "core.blueprint.proposal"
                        "leave" "lwt-proposal"
                        "constructed:composite-recipe-proposal" 604 288))
                proposal))))

