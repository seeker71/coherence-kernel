                "form/form-stdlib/tests/living-world-composite-nursery-band.fk"
                305 9))
        (let schema (lwoew-base-schema (lwoew-evolved-base evolved)))
        (let component (lwoew-evolved-candidate evolved))
        (let blueprint-enter
            (lcfb-call-stream "living-world-composite-nursery-band"
                "core.blueprint" "enter" "form-native" "lwoecw-blueprint"
                "construct:composite-blueprint" 103 live-start
