; loop-lane-cons-band.fk — a leaf conses: the write side of lists, and the last two C twins leave the seed.
;
; The ninth rung of Urs's 2026-09-12 goal. A leaf that conses takes a run of pairs above the heap's top: the door
; melts the heap first when it is near full (the arguments sit on the value stack, the melt's roots) and grows it in
; place until the run fits -- growth moves no pair -- then hands the leaf the run's cursor and limit and the pair
; arrays' bases. cons is two stores and a tagged word; the head an int tagged, a list or a word as it is, a string
; parameter's or literal's word. A run spent leaves for the second overflow block, and the door asks again with a
; run twice as long, up to four million pairs, the spent attempt's pairs let go. A loop hands its frame back to the
; door at the pass boundary where its run is half spent: the pairs so far become the heap's, melted when it is near
; full, and the loop goes on from where it stood, so a loop consing past the largest run stays in the lane. When the
; leaf answers, its last pair is the heap's top. A callee that conses draws on its caller's run and hands the cursor
; back; the call arm gives it no mark, so a callee never hands its frame back. With cons in the lane
; core.fk's reverse-onto crystallizes as it stands, append is written as two reversals, and the C twins of append
; and reverse-onto -- the last of the recipe twins -- leave the seed.
;
; Verdict 511
; PROOF LEVEL: FOURTH-ARM ONLY (the transparent lanes are fkwu's MAP_JIT arm64 door; a defn's native state is the 8th field of its hot row)
; preludes: form-stdlib/core.fk
;
;   1   a reversing loop reads state 2 and answers as its walker twin, the empty list and a one-element list among the cases
;   2   heads of every kind the lane holds: an int, a string parameter, a string literal, a list, a word a head handed up
;   4   a 20,000-element list reverses through the run doubling and answers as the walker, element for element at both ends
;   8   core.fk's reverse-onto reads state 2 (no twin binds it) and reverse answers as the walker
;   16  core.fk's append, two reversals, answers as the walker over the empty list on either side and a long left side
;   32  a loop consing a float head is the walker's (the lane declines a float head): state under 1, the answer whole
;   64  a leaf calling a consing loop reads state 1 and its answer's length is the walker's: the cursor came back through the call
;   128 the warm run of the reversal is under the walker twin's run of the same work
;   256 a loop consing past the largest run stays in the lane: a churn needing 4.8 million pairs answers the closed form,
;       and all 1700 of its passes are the leaf's (kernel_stat 50, the lane's loop passes, rises by 1700)
(do
    (defn lcn-bit (ok bit) (if ok bit 0))
    (defn lcn-state (name rows) (if (eq (len rows) 0) -99 (if (str_eq (nth (head rows) 1) name) (nth (head rows) 7) (lcn-state name (tail rows)))))
    (defn lcn-native (name) (lcn-state name (kernel_page_hot (host_pid) 240)))
    (defn lcn-lt? (a b) (if (lt (host_monotonic_ms) 0) false (lt a b))) ; a host clock: a door the lanes decline by meaning, so the twins walk
    (defn lcn-mk (n acc) (if (le n 0) acc (lcn-mk (sub n 1) (cons n acc))))
    (defn lcn-same (xs ys) (if (nil? xs) (nil? ys) (if (nil? ys) false (if (eq (head xs) (head ys)) (lcn-same (tail xs) (tail ys)) false))))
    (let xs (lcn-mk 200 (list)))
    ; 1: the reversal
    (defn lcn-rev (xs acc) (if (nil? xs) acc (lcn-rev (tail xs) (cons (head xs) acc))))
    (defn lcn-rev-walk (xs acc) (if (lcn-lt? 0 (len xs)) (lcn-rev-walk (tail xs) (cons (head xs) acc)) acc))
    (defn lcn-h1 (xs n acc) (if (lcn-lt? 0 n) (lcn-h1 xs (sub n 1) (add acc (len (lcn-rev xs (list))))) acc))
    (let h1 (lcn-h1 xs 1100 0))
    (let rev-state (lcn-native "lcn-rev"))
    (let rev-ok (if (lcn-same (lcn-rev xs (list)) (lcn-rev-walk xs (list))) (if (lcn-same (lcn-rev (list) (list 9)) (list 9)) (lcn-same (lcn-rev (list 7) (list)) (list 7)) false) false))
    ; 2: heads of every kind
    (defn lcn-tag (xs s acc) (if (nil? xs) acc (lcn-tag (tail xs) s (cons "k" (cons s (cons (head xs) acc))))))
    (defn lcn-h2 (xs n acc) (if (lcn-lt? 0 n) (lcn-h2 xs (sub n 1) (add acc (len (lcn-tag xs "v" (list))))) acc))
    (let h2 (lcn-h2 (list 1 2) 1100 0))
    (let tag-state (lcn-native "lcn-tag"))
    (let tagged (lcn-tag (list 1 (list 5) 3) "v" (list)))
    (let heads-ok (if (eq (len tagged) 9) (if (str_eq (head tagged) "k") (if (str_eq (nth tagged 1) "v") (if (eq (nth tagged 2) 3) (if (eq (head (nth tagged 5)) 5) (eq (nth tagged 8) 1) false) false) false) false) false))
    ; 4: the run doubling
    (let big (lcn-mk 20000 (list)))
    (let rbig (lcn-rev big (list)))
    (let big-ok (if (eq (len rbig) 20000) (if (eq (head rbig) 20000) (if (eq (nth rbig 19999) 1) (eq (nth rbig 10000) 10000) false) false) false))
    ; 8: core.fk's reverse-onto, no twin
    (defn lcn-h8 (xs n acc) (if (lcn-lt? 0 n) (lcn-h8 xs (sub n 1) (add acc (len (reverse xs)))) acc))
    (let h8 (lcn-h8 xs 1100 0))
    (let ro-state (lcn-native "reverse-onto"))
    (let ro-ok (if (lcn-same (reverse xs) (lcn-rev-walk xs (list))) (lcn-same (reverse (list)) (list)) false))
    ; 16: append as two reversals
    (let app-ok (if (lcn-same (append (list 1 2) (list 3)) (list 1 2 3)) (if (lcn-same (append (list) (list 3)) (list 3)) (if (lcn-same (append (list 1 2) (list)) (list 1 2)) (if (lcn-same (append (list) (list)) (list)) (eq (len (append big (list 0))) 20001) false) false) false) false))
    ; 32: a float head declines
    (defn lcn-fl (n acc) (if (le n 0) acc (lcn-fl (sub n 1) (cons (mul n 0.5) acc))))
    (defn lcn-h32 (n acc) (if (lcn-lt? 0 n) (lcn-h32 (sub n 1) (add acc (len (lcn-fl 3 (list))))) acc))
    (let h32 (lcn-h32 1100 0))
    (let fl-state (lcn-native "lcn-fl"))
    (let fl-ok (if (eq (len (lcn-fl 3 (list))) 3) (eq (head (lcn-fl 3 (list))) 0.5) false))
    ; 64: a leaf calling a consing loop
    (defn lcn-twice (xs) (len (lcn-rev (lcn-rev xs (list)) (list))))
    (defn lcn-h64 (xs n acc) (if (lcn-lt? 0 n) (lcn-h64 xs (sub n 1) (add acc (lcn-twice xs))) acc))
    (let h64 (lcn-h64 xs 1100 0))
    (let twice-state (lcn-native "lcn-twice"))
    (let twice-ok (if (eq (lcn-twice xs) 200) (eq (lcn-twice (list)) 0) false))
    ; 128: the warm run against the twin's
    (defn lcn-rep (xs n acc) (if (le n 0) acc (lcn-rep xs (sub n 1) (add acc (len (lcn-rev xs (list)))))))
    (defn lcn-rep-walk (xs n acc) (if (lcn-lt? 0 n) (lcn-rep-walk xs (sub n 1) (add acc (len (lcn-rev-walk xs (list))))) acc))
    (let w0 (host_monotonic_ms)) (let warm (lcn-rep xs 5000 0)) (let w1 (host_monotonic_ms))
    (let k0 (host_monotonic_ms)) (let cold (lcn-rep-walk xs 5000 0)) (let k1 (host_monotonic_ms))
    ; 256: past the largest run
    (defn lcn-churn (n xs acc) (if (le n 0) acc (lcn-churn (sub n 1) (reverse-onto xs (list n)) (add acc (len xs)))))
    (let c256 (lcn-churn 1100 (list 1) 0))
    (let churn-state (lcn-native "lcn-churn"))
    (let x2k (lcn-mk 2000 (list)))
    (let i0 (kernel_stat 50))
    (let churned (lcn-churn 1700 x2k 0))
    (let i1 (kernel_stat 50))
    (let churn-ok (if (eq churned 4844150) (eq (sub i1 i0) 1700) false))
    (let told (print (list "states" rev-state tag-state ro-state fl-state twice-state churn-state "rev" rev-ok "heads" heads-ok "big" big-ok "ro" ro-ok "app" app-ok "fl" fl-ok "twice" twice-ok "churn" churned (sub i1 i0) "ms" (sub w1 w0) (sub k1 k0))))
    (let b1 (lcn-bit (if (eq rev-state 2) rev-ok false) 1))
    (let b2 (lcn-bit (if (eq tag-state 2) heads-ok false) 2))
    (let b3 (lcn-bit big-ok 4))
    (let b4 (lcn-bit (if (eq ro-state 2) ro-ok false) 8))
    (let b5 (lcn-bit app-ok 16))
    (let b6 (lcn-bit (if (lt fl-state 1) fl-ok false) 32))
    (let b7 (lcn-bit (if (eq twice-state 1) twice-ok false) 64))
    (let b8 (lcn-bit (if (eq warm cold) (lt (sub w1 w0) (sub k1 k0)) false) 128))
    (let b9 (lcn-bit (if (eq churn-state 2) churn-ok false) 256))
    (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 b9)))))))))
