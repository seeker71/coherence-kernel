; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk
;
; ADR literal-address encoding, byte-verified against the ARM64 assembler.
;   adr x1, +28 -> e1 00 00 10
;   adr x0, +17 -> 80 00 00 30
(do
    (let a (fa-adr-x 1 28))
    (let b (fa-adr-x 0 17))
    (if (and
            (eq (fa-conviction a (list 225 0 0 16)) 1)
            (eq (fa-conviction b (list 128 0 0 48)) 1))
        3
        0))
