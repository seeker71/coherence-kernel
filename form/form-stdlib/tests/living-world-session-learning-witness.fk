; living-world-session-learning-witness.fk -- public digest-only session offers
; grow, voice, and revise an ontology-open transition field.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/native-model-evidence.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-session-observation.fk form-stdlib/living-world-session-learning.fk observe/live-call-framebuffer.fk

(let LWSNW-SOURCE-A (bp "LWSNW-SOURCE-A"))
(let LWSNW-SOURCE-B (bp "LWSNW-SOURCE-B"))
(let LWSNW-SOURCE-C (bp "LWSNW-SOURCE-C"))
(let LWSNW-SOURCE-D (bp "LWSNW-SOURCE-D"))
(let LWSNW-SOURCE-E (bp "LWSNW-SOURCE-E"))
(let LWSNW-SOURCE-F (bp "LWSNW-SOURCE-F"))
(let LWSNW-ACTION   (bp "LWSNW-ACTION"))
(let LWSNW-PURPOSE  (bp "LWSNW-PURPOSE"))
(let LWSNW-DIRECTION (bp "LWSNW-DIRECTION"))
(let LWSNW-REASON   (bp "LWSNW-REASON"))
(let LWSNW-PROV-A   (bp "LWSNW-PROV-A"))
(let LWSNW-PROV-B   (bp "LWSNW-PROV-B"))
(let LWSNW-PROV-C   (bp "LWSNW-PROV-C"))
(let LWSNW-PROV-D   (bp "LWSNW-PROV-D"))
(let LWSNW-PROV-E   (bp "LWSNW-PROV-E"))
(let LWSNW-PROV-F   (bp "LWSNW-PROV-F"))

(defn lwsnw-cell (kind) (intern_node kind (empty)))
(defn lwsnw-source-a () (lwsnw-cell LWSNW-SOURCE-A))
(defn lwsnw-source-b () (lwsnw-cell LWSNW-SOURCE-B))
(defn lwsnw-source-c () (lwsnw-cell LWSNW-SOURCE-C))
(defn lwsnw-source-d () (lwsnw-cell LWSNW-SOURCE-D))
(defn lwsnw-source-e () (lwsnw-cell LWSNW-SOURCE-E))
(defn lwsnw-source-f () (lwsnw-cell LWSNW-SOURCE-F))
(defn lwsnw-action () (lwsnw-cell LWSNW-ACTION))
(defn lwsnw-purpose () (lwsnw-cell LWSNW-PURPOSE))
(defn lwsnw-direction () (lwsnw-cell LWSNW-DIRECTION))
(defn lwsnw-reason () (lwsnw-cell LWSNW-REASON))
(defn lwsnw-prov-a () (lwsnw-cell LWSNW-PROV-A))
(defn lwsnw-prov-b () (lwsnw-cell LWSNW-PROV-B))
(defn lwsnw-prov-c () (lwsnw-cell LWSNW-PROV-C))
(defn lwsnw-prov-d () (lwsnw-cell LWSNW-PROV-D))
(defn lwsnw-prov-e () (lwsnw-cell LWSNW-PROV-E))
(defn lwsnw-prov-f () (lwsnw-cell LWSNW-PROV-F))

(defn lwsnw-dataset ()
    (lwrs-digest "1111111111111111111111111111111111111111111111111111111111111111"))
(defn lwsnw-query ()
    (lwrs-digest "2222222222222222222222222222222222222222222222222222222222222222"))
(defn lwsnw-candidates ()
    (lwrs-digest "3333333333333333333333333333333333333333333333333333333333333333"))
(defn lwsnw-contract ()
    (lwrs-digest "4444444444444444444444444444444444444444444444444444444444444444"))
(defn lwsnw-contract-next ()
    (lwrs-digest "5555555555555555555555555555555555555555555555555555555555555555"))
(defn lwsnw-outcome-a ()
    (lwrs-digest "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
(defn lwsnw-outcome-b ()
    (lwrs-digest "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"))
(defn lwsnw-alternative ()
    (lwrs-digest "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"))
(defn lwsnw-evidence ()
    (lwrs-digest "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"))
(defn lwsnw-unknown-evidence ()
    (lwrs-digest "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"))
(defn lwsnw-node-evidence ()
    (lwrs-digest "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"))

(defn lwsnw-context ()
    (lwsn-context (lwsnw-dataset) (lwsnw-query)
        (lwsnw-candidates) (lwsnw-contract)))
(defn lwsnw-context-next ()
    (lwsn-context (lwsnw-dataset) (lwsnw-query)
        (lwsnw-candidates) (lwsnw-contract-next)))

(defn lwsnw-field (items)
    (lwsnw-field-items items (lwo-empty-field)))
(defn lwsnw-field-items (items field)
    (if (eq (len items) 0) field
        (lwsnw-field-items (tail items)
            (lwo-field-add field (head items)))))

(defn lwsnw-default-lens ()
    (lwlc-lens (lwlc-cell-shape) (lwsnw-candidates) (lwsnw-evidence)))
(defn lwsnw-layer-lens ()
    (lwlc-lens (lwlc-blueprint-shape) (lwsnw-contract) (lwsnw-evidence)))
(defn lwsnw-alternative-lens ()
    (lwlc-lens (lwlc-recipe-shape) (lwsnw-alternative) (lwsnw-evidence)))
(defn lwsnw-lens-declaration ()
    (lwlc-declaration (lwsnw-direction)
        (lwlc-stack (lwsnw-default-lens)
            (lwlc-layers (list (lwsnw-layer-lens)))
            (lwsnw-field (list (lwsnw-alternative-lens)))
            (lwlc-unknown (lwsnw-unknown-evidence))
            (lwsnw-evidence))
        (lwsnw-evidence)))
(defn lwsnw-unknown ()
    (lwlc-unknown (lwsnw-unknown-evidence)))

(defn lwsnw-offer-a ()
    (lwsn-offer (lwsnw-context)
        (lwsnw-field (list (lwsnw-outcome-a)))
        (oac-one (lwsnw-outcome-a))
        (lwsnw-field (list (lwsnw-alternative)))
        (lwsnw-unknown) (lwsnw-evidence)))
(defn lwsnw-offer-b ()
    (lwsn-offer (lwsnw-context)
        (lwsnw-field (list (lwsnw-outcome-b)))
        (oac-one (lwsnw-outcome-b))
        (lwsnw-field (list (lwsnw-outcome-a)))
        (lwsnw-unknown) (lwsnw-evidence)))
(defn lwsnw-immediate-nothing-offer ()
    (lwsn-offer (lwsnw-context) (lwo-empty-field) (oac-nothing)
        (lwsnw-field (list (lwsnw-outcome-a) (lwsnw-outcome-b)))
        (lwsnw-unknown) (lwsnw-evidence)))
(defn lwsnw-node-offer ()
    (lwsn-offer (lwsnw-context) (lwo-empty-field)
        (oac-alternative-ack (lwsnw-context)
            (lwsnw-outcome-b) (lwsnw-node-evidence))
        (lwsnw-field (list (lwsnw-outcome-b)))
        (lwsnw-unknown) (lwsnw-evidence)))
(defn lwsnw-invalid-one-offer ()
    (lwsn-offer (lwsnw-context) (lwo-empty-field)
        (oac-one (lwsnw-outcome-a)) (lwo-empty-field)
        (lwo-none) (lwsnw-evidence)))

(defn lwsnw-interface () (lwo-interface (list (lwsnw-action))))
(defn lwsnw-consent (source)
    (lwrs-consent source (lwsnw-dataset) (lwsnw-purpose)
        (lwsnw-interface) (lwsnw-lens-declaration)
        (lwo-none) (lwo-none) 1 1))
(defn lwsnw-expiring-consent (source expiry-default)
    (lwrs-consent source (lwsnw-dataset) (lwsnw-purpose)
        (lwsnw-interface) (lwsnw-lens-declaration)
        (intern_trivial_int 100) expiry-default 1 1))

(defn lwsnw-frame (started call phase modifier ordinal source-line)
    (lcfb-call-stream "living-world-session-learning"
        call phase "form-native" modifier "public-digest-only"
        ordinal started
        "form/form-stdlib/tests/living-world-session-learning-witness.fk"
        source-line 9))

(defn lwsnw-proposal-answer-has? (proposal outcome)
    (if (eq (lwt-proposal? proposal) 0) 0
        (do
            (let candidate (lwt-proposal-candidate proposal))
            (if (eq (lwtf-candidate? candidate) 0) 0
                (do
                    (let answer
                        (lwtf-observation-next
                            (lwo-emergent-shape candidate)))
                    (if (eq (lwsn-answer? answer) 0) 0
                        (lwo-field-has?
                            (lwsn-answer-outcomes answer) outcome)))))))
(defn lwsnw-find-proposal-items (items outcome)
    (if (eq (len items) 0) (lwo-none)
        (if (eq (lwsnw-proposal-answer-has?
                    (head items) outcome) 1)
            (head items)
            (lwsnw-find-proposal-items (tail items) outcome))))
(defn lwsnw-find-proposal (proposals outcome)
    (lwsnw-find-proposal-items (lwo-field-items proposals) outcome))

(defn lwsnw-response-entry (source provenance proposal)
    (lwt-entry
        (lwo-offer source (lwsnw-interface) 1
            (lwt-response proposal
                (oac-one (lwt-proposal-candidate proposal)) provenance)
            provenance 1)
        (lwsnw-action)))

(defn lwsnw-integrate-two
    (world proposals proposal source-a provenance-a source-b provenance-b)
    (do
        (let round
            (lwt-round world proposals (lwo-empty-field) (lwo-none)))
        (let answered
            (lwt-round-receive round
                (list
                    (lwsnw-response-entry source-a provenance-a proposal)
                    (lwsnw-response-entry source-b provenance-b proposal))))
        (lwtf-integrate answered proposal (lwsnw-action))))

(defn lwsnw-prediction-has? (prediction outcome)
    (lwsnw-answer-items-have?
        (lwo-field-items (lwtf-prediction-nexts prediction)) outcome))
(defn lwsnw-possibilities-have? (prediction outcome)
    (lwsnw-answer-items-have?
        (lwo-field-items (lwtf-prediction-possibilities prediction)) outcome))
(defn lwsnw-answer-items-have? (items outcome)
    (if (eq (len items) 0) 0
        (do
            (let answer (head items))
            (if (and (eq (lwsn-answer? answer) 1)
                     (eq (lwo-field-has?
                            (lwsn-answer-outcomes answer) outcome) 1))
                1 (lwsnw-answer-items-have? (tail items) outcome)))))

(defn lwsnw-find-derivation-items (items outcome)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let derivation (head items))
            (let answer
                (lwtf-observation-next
                    (lwtf-derivation-observation derivation)))
            (if (and (eq (lwsn-answer? answer) 1)
                     (eq (lwo-field-has?
                            (lwsn-answer-outcomes answer) outcome) 1))
                derivation
                (lwsnw-find-derivation-items (tail items) outcome)))))
(defn lwsnw-find-derivation (prediction outcome)
    (lwsnw-find-derivation-items
        (lwo-field-items (lwtf-prediction-derivations prediction)) outcome))

(defn lwsnw-symbol-observation (derivation)
    (lwsl-observation derivation 0 "arrives"
        (lwsnw-lens-declaration) (oac-one derivation) (lwsnw-evidence)))
(defn lwsnw-symbol-entry (source provenance derivation)
    (lwt-entry
        (lwo-offer source (lwsnw-interface) 1
            (lwsnw-symbol-observation derivation) provenance 1)
        (lwsnw-action)))
(defn lwsnw-find-symbol-proposal-items (items derivation)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let proposal (head items))
            (let symbol
                (lwo-emergent-shape
                    (lwt-proposal-candidate proposal)))
            (if (and (node_eq (lwnv-symbol-referent symbol) derivation)
                     (str_eq (lwnv-symbol-surface symbol) "arrives"))
                proposal
                (lwsnw-find-symbol-proposal-items
                    (tail items) derivation)))))
(defn lwsnw-integrate-symbol (world prediction)
    (do
        (let derivation
            (lwsnw-find-derivation prediction (lwsnw-outcome-b)))
        (let observed
            (lwt-receive-stream world
                (list
                    (lwsnw-symbol-entry
                        (lwsnw-source-c) (lwsnw-prov-c) derivation)
                    (lwsnw-symbol-entry
                        (lwsnw-source-d) (lwsnw-prov-d) derivation))))
        (let proposals (lwsl-proposals observed 2))
        (let proposal
            (lwsnw-find-symbol-proposal-items
                (lwo-field-items proposals) derivation))
        (let round
            (lwt-round observed proposals (lwo-empty-field) (lwo-none)))
        (let answered
            (lwt-round-receive round
                (list
                    (lwsnw-response-entry
                        (lwsnw-source-c) (lwsnw-prov-c) proposal)
                    (lwsnw-response-entry
                        (lwsnw-source-d) (lwsnw-prov-d) proposal))))
        (lwsl-integrate answered proposal (lwsnw-action))))

(defn lwsnw-score (condition) (if condition 1 0))
(defn lwsnw-verdict-items (items weight total)
    (if (eq (len items) 0) total
        (lwsnw-verdict-items (tail items) (mul weight 2)
            (add total (if (eq (head items) 1) weight 0)))))
(defn lwsnw-verdict (bits)
    (lwsnw-verdict-items bits 1 0))

(defn lwsnw-run (started)
    (do
        (let phase-a (lwsnw-frame started "consent" "enter"
            "validate-scope-lens-expiry" 1 266))
        (let refused
            (lwsn-receive (lwo-empty-world) (lwsnw-offer-a)
                (lwo-none) (lwsnw-action) 0))
        (let expired-nothing
            (lwsn-receive (lwo-empty-world) (lwsnw-offer-a)
                (lwsnw-expiring-consent
                    (lwsnw-source-e) (lwo-none))
                (lwsnw-action) 100))
        (let expired-zero
            (lwsn-receive (lwo-empty-world) (lwsnw-offer-a)
                (lwsnw-expiring-consent
                    (lwsnw-source-f) (oac-zero))
                (lwsnw-action) 100))
        (let immediate
            (lwsn-receive (lwo-empty-world)
                (lwsnw-immediate-nothing-offer)
                (lwsnw-consent (lwsnw-source-e))
                (lwsnw-action) 0))
        (let phase-b (lwsnw-frame started "consent" "leave"
            "distinct-immediate-and-expired" 2 284))

        (let receipt-a
            (lwsn-receive (lwo-empty-world) (lwsnw-offer-a)
                (lwsnw-consent (lwsnw-source-a))
                (lwsnw-action) 0))
        (let receipt-b
            (lwsn-receive (lwsn-receipt-world receipt-a)
                (lwsnw-offer-a) (lwsnw-consent (lwsnw-source-b))
                (lwsnw-action) 0))
        (let world-a (lwsn-receipt-world receipt-b))
        (let phase-c (lwsnw-frame started "recurrence" "modify"
            "two-source-support" 3 294))
        (let proposals-a (lwtf-proposals world-a 2))
        (let proposal-a
            (lwsnw-find-proposal proposals-a (lwsnw-outcome-a)))
        (let integrated-a
            (lwsnw-integrate-two world-a proposals-a proposal-a
                (lwsnw-source-a) (lwsnw-prov-a)
                (lwsnw-source-b) (lwsnw-prov-b)))
        (let world-integrated-a (lwt-round-world integrated-a))
        (let prediction-a (lwsn-predict world-integrated-a (lwsnw-context)))
        (let phase-d (lwsnw-frame started "candidate" "leave"
            "unanimous-integration" 4 303))

        (let silence-receipt
            (lwsn-receive world-integrated-a
                (lwsnw-immediate-nothing-offer)
                (lwsnw-consent (lwsnw-source-e))
                (lwsnw-action) 0))
        (let node-receipt
            (lwsn-receive (lwsn-receipt-world silence-receipt)
                (lwsnw-node-offer)
                (lwsnw-consent (lwsnw-source-f))
                (lwsnw-action) 0))
        (let evidence-world (lwsn-receipt-world node-receipt))
        (let prediction-evidence
            (lwsn-predict evidence-world (lwsnw-context)))
        (let collected-evidence
            (lwsn-context-evidence evidence-world (lwsnw-context)))
        (let phase-e (lwsnw-frame started "evidence" "modify"
            "non-one-does-not-train" 5 325))

        (let receipt-c
            (lwsn-receive evidence-world (lwsnw-offer-b)
                (lwsnw-consent (lwsnw-source-c))
                (lwsnw-action) 0))
        (let receipt-d
            (lwsn-receive (lwsn-receipt-world receipt-c)
                (lwsnw-offer-b) (lwsnw-consent (lwsnw-source-d))
                (lwsnw-action) 0))
        (let world-b (lwsn-receipt-world receipt-d))
        (let proposals-b (lwtf-proposals world-b 2))
        (let proposal-b
            (lwsnw-find-proposal proposals-b (lwsnw-outcome-b)))
        (let integrated-b
            (lwsnw-integrate-two world-b proposals-b proposal-b
                (lwsnw-source-c) (lwsnw-prov-c)
                (lwsnw-source-d) (lwsnw-prov-d)))
        (let plural-world (lwt-round-world integrated-b))
        (let plural-prediction
            (lwsn-predict plural-world (lwsnw-context)))
        (let plural-trace (lwsn-trace plural-world (lwsnw-context)))
        (let phase-f (lwsnw-frame started "field" "leave"
            "plural-candidates" 6 347))

        (let symbol-round
            (lwsnw-integrate-symbol plural-world plural-prediction))
        (let voice-world (lwt-round-world symbol-round))
        (let symbol-candidate
            (lwt-proposal-candidate
                (head (lwo-field-items
                    (lwt-round-proposals symbol-round)))))
        (let symbols (lwsnw-field (list symbol-candidate)))
        (let voice-plan
            (lwtx-plan-for voice-world plural-prediction symbols))
        (let phase-g (lwsnw-frame started "voice" "leave"
            "participant-learned-surface" 7 361))

        (let foreign
            (lwsn-revoke voice-world receipt-a
                (lwsnw-source-d) (lwsnw-action)
                (lwsnw-reason) (lwsnw-prov-d)))
        (let foreign-world (lwo-transition-world foreign))
        (let owner
            (lwsn-revoke foreign-world receipt-a
                (lwsnw-source-a) (lwsnw-action)
                (lwsnw-reason) (lwsnw-prov-a)))
        (let owner-world (lwo-transition-world owner))
        (let after-prediction
            (lwsn-predict owner-world (lwsnw-context)))
        (let after-trace (lwsn-trace owner-world (lwsnw-context)))
        (let after-plan
            (lwtx-plan-for owner-world after-prediction symbols))
        (let phase-h (lwsnw-frame started "revocation" "modify"
            "source-local-reopen" 8 366))
        (let phase-i (lwsnw-frame started "trace" "leave"
            "current-derivation" 9 379))
        (let events (framebuffer-events))

        (list
            (lwsnw-score (eq (lwsn-context-valid? (lwsnw-context)) 1))
            (lwsnw-score (eq (lwsn-context-aligned?
                                (lwsnw-context) (lwsnw-context)) 1))
            (lwsnw-score (eq (lwsn-context-aligned?
                                (lwsnw-context) (lwsnw-context-next)) 0))
            (lwsnw-score (eq (lwsn-offer-valid? (lwsnw-offer-a)) 1))
            (lwsnw-score (node_eq (lwsnw-offer-a) (lwsnw-offer-a)))
            (lwsnw-score (eq (lwsn-offer-valid?
                                (lwsnw-invalid-one-offer)) 0))
            (lwsnw-score
                (and (node_eq (lwsn-receipt-state refused) (lwsn-refused))
                     (and (eq (lwo-field-size
                                (lwo-world-cells
                                    (lwsn-receipt-world refused))) 0)
                          (eq (lwo-field-size
                                (lwo-world-attributions
                                    (lwsn-receipt-world refused))) 0))))
            (lwsnw-score
                (and (node_eq (lwsn-receipt-state expired-nothing)
                              (lwsn-expired))
                     (and (eq (oac-time-outcome?
                                (lwsn-receipt-timing expired-nothing)) 1)
                          (eq (oac-nothing?
                                (lwsn-receipt-ack expired-nothing)) 1))))
            (lwsnw-score
                (and (node_eq (lwsn-receipt-state expired-zero)
                              (lwsn-expired))
                     (eq (oac-zero?
                            (lwsn-receipt-ack expired-zero)) 1)))
            (lwsnw-score
                (and (node_eq (lwsn-receipt-state immediate)
                              (lwsn-admitted))
                     (and (eq (lwsn-evidence?
                                (lwsn-receipt-payload immediate)) 1)
                          (eq (oac-nothing?
                                (lwsn-offer-ack
                                    (lwsn-evidence-offer
                                        (lwsn-receipt-payload immediate)))) 1))))
            (lwsnw-score (not (node_eq immediate expired-nothing)))
            (lwsnw-score
                (node_eq
                    (lwtf-observation-lens
                        (lwsn-receipt-payload receipt-a))
                    (lwsnw-lens-declaration)))
            (lwsnw-score
                (eq (lwo-field-size
                        (lwo-active-attributions-for world-a
                            (lwsn-receipt-payload receipt-a))) 2))
            (lwsnw-score
                (and (not (node_eq proposal-a (lwo-none)))
                     (eq (lwo-field-size
                            (lwt-proposal-participants proposal-a)) 2)))
            (lwsnw-score
                (eq (lwtf-integrated-current?
                        world-integrated-a
                        (lwt-proposal-candidate proposal-a)) 1))
            (lwsnw-score
                (and (eq (oac-one? (lwtf-prediction-ack prediction-a)) 1)
                     (and (eq (lwo-field-size
                                (lwtf-prediction-nexts prediction-a)) 1)
                          (eq (lwo-field-size
                                (lwtf-prediction-possibilities prediction-a)) 1))))
            (lwsnw-score
                (and (eq (lwo-field-size
                            (lwtf-prediction-nexts prediction-evidence)) 1)
                     (and (eq (lwo-field-size
                                (lwtf-prediction-possibilities
                                    prediction-evidence)) 1)
                          (and (eq (lwo-field-size
                                    (lwsn-evidence-field
                                        collected-evidence)) 3)
                               (and (eq (lwo-field-has?
                                        (lwtf-prediction-alternatives
                                            prediction-evidence)
                                        (lwsnw-outcome-b)) 1)
                                    (not (node_eq
                                        (lwtf-prediction-unknown
                                            prediction-evidence)
                                        (lwo-none))))))))
            (lwsnw-score
                (and (not (node_eq proposal-b (lwo-none)))
                     (not (node_eq
                            (lwt-proposal-candidate proposal-a)
                            (lwt-proposal-candidate proposal-b)))))
            (lwsnw-score
                (and (eq (oac-node? (lwtf-prediction-ack
                                        plural-prediction)) 1)
                     (and (eq (lwo-field-size
                                (lwtf-prediction-nexts plural-prediction)) 2)
                          (eq (lwo-field-size
                                (lwtf-prediction-possibilities
                                    plural-prediction)) 2))))
            (lwsnw-score
                (and (eq (lwsn-trace-current?
                            plural-world plural-trace) 1)
                     (eq (lwo-field-size
                            (lwtf-prediction-derivations
                                plural-prediction)) 2)))
            (lwsnw-score
                (and (eq (lwsl-integrated-current?
                            voice-world symbol-candidate) 1)
                     (and (eq (lwo-field-size
                                (lwtx-plan-surfaces voice-plan)) 1)
                          (eq (lwo-field-size
                                (lwtx-plan-unvoiced voice-plan)) 1))))
            (lwsnw-score
                (and (str_eq
                        (lwtx-surface-text
                            (head (lwo-field-items
                                (lwtx-plan-surfaces voice-plan))))
                        "arrives")
                     (and (node_eq (lwtx-plan-unknown voice-plan)
                                   (lwtf-prediction-unknown
                                        plural-prediction))
                          (node_eq (lwtx-plan-alternatives voice-plan)
                                   (lwtf-prediction-alternatives
                                        plural-prediction)))))
            (lwsnw-score
                (and (eq (oac-zero? (lwo-transition-ack foreign)) 1)
                     (eq (lwtf-integrated-current? foreign-world
                            (lwt-proposal-candidate proposal-a)) 1)))
            (lwsnw-score
                (and (eq (oac-one? (lwo-transition-ack owner)) 1)
                     (and (eq (lwtf-integrated-current? owner-world
                                (lwt-proposal-candidate proposal-a)) 0)
                          (eq (lwtf-integrated-current? owner-world
                                (lwt-proposal-candidate proposal-b)) 1))))
            (lwsnw-score
                (and (eq (oac-one? (lwtf-prediction-ack
                                        after-prediction)) 1)
                     (and (eq (lwsnw-prediction-has?
                                after-prediction (lwsnw-outcome-b)) 1)
                          (and (eq (lwsnw-prediction-has?
                                    after-prediction (lwsnw-outcome-a)) 0)
                               (and (eq (lwsnw-possibilities-have?
                                        after-prediction
                                        (lwsnw-outcome-a)) 1)
                                    (and (eq (lwsn-trace-current?
                                                owner-world plural-trace) 0)
                                         (eq (lwsn-trace-current?
                                                owner-world after-trace) 1)))))))
            (lwsnw-score
                (and (eq (lwtx-plan-current? owner-world after-plan) 1)
                     (and (eq (lwo-field-size
                                (lwtx-plan-surfaces after-plan)) 1)
                          (eq (lwo-field-size
                                (lwtx-plan-unvoiced after-plan)) 0))))
            (lwsnw-score (ge (len events) 10)))))

0
