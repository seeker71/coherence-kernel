; tests/hd-activation-lane-band.fk — an activation knows how it got here.
;
; preludes: form-stdlib/core.fk form-stdlib/hd-bodygraph.fk form-stdlib/hd-activation-lane.fk
;
; Verdict 255:
;   computed ranks strictly below witnessed — the lane order IS the law   1
;   a computed row carries no authority and no day                        2
;   a witnessed row carries both                                          4
;   a witnessed row missing its authority is REFUSED                      8
;   a computed row that claims an authority is REFUSED                   16
;   the witnessed rows this body holds: pluto gate 46 line 2 from
;     jpl horizons, and it names its day                                 32
;   a reading with any witnessed row is NOT fully derived                64
;   gates flow lane-blind into the bodygraph, so a witnessed pluto can
;     complete a channel exactly as a computed gate would               128
(do
    (defn halb-bit (ok w) (if ok w 0))
    (defn hd-activation-lane-band ()
        (do
            (let c (hal-computed-act "sun" 48 4))
            (let w (hal-pluto-1971-10-06))
            (let c0 (halb-bit (eq (hal-lane-order?) 1) 1))
            (let c1 (halb-bit (and (eq (str_len (hal-authority c)) 0)
                                   (eq (hal-day c) 0)) 2))
            (let c2 (halb-bit (and (gt (str_len (hal-authority w)) 0)
                                   (gt (hal-day w) 0)) 4))
            (let bad1 (hal-act "x" 1 1 (hal-witnessed) "" 20260830))
            (let c3 (halb-bit (eq (hal-row-ok? bad1) 0) 8))
            (let bad2 (hal-act "x" 1 1 (hal-computed) "someone" 0))
            (let c4 (halb-bit (eq (hal-row-ok? bad2) 0) 16))
            (let c5 (halb-bit (and (eq (hal-witnessed-count) 2)
                              (and (eq (hal-gate w) 46)
                              (and (eq (hal-line w) 2)
                              (and (str_eq (hal-authority w) (hal-jpl))
                                   (eq (hal-day w) 20260830))))) 32))
            (let mixed (list c w))
            (let c6 (halb-bit (and (eq (hal-fully-derived? mixed) 0)
                              (and (eq (hal-fully-derived? (list c)) 1)
                              (and (eq (hal-computed-count mixed) 1)
                                   (eq (hal-witnessed-in mixed) 1)))) 64))
            ; 46-29 is a real channel (G to Sacral). A witnessed 46 plus a
            ; computed 29 must define it exactly as two computed gates would.
            (let pair (list (hal-witnessed-act "pluto" 46 2 (hal-jpl) 20260830)
                            (hal-computed-act "x" 29 1)))
            (let c7 (halb-bit (and (eq (hal-well-formed? pair) 1)
                              (and (eq (len (hdb-defined-channels (hal-gates pair))) 1)
                                   (eq (hdb-centre-defined? (hal-gates pair) (hdb-g)) 1))) 128))
            (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
    (hd-activation-lane-band))
