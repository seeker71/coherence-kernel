; tests/llama3-tokenize-band.fk — does the body's own encoder produce the recorded oracle's ids?
;
; This band runs NO Metal and NO external tool: it reads the GGUF blob's header and judges pure
; Form arithmetic, so any arm that can open the file can run it. The oracle values are RECORDED —
; witnessed on 2026-08-04 from the proven generation lane and carried in commit 2e914252e — not
; re-generated here, per the standing word: no swift, no external tools.
;
; Verdict 31 = 1 + 2 + 4 + 8 + 16.
;
;   bit  1  THE FILE IS THERE AND SPEAKS GGUF. Magic bytes checked, not the extension — the blob
;           has no extension at all.
;   bit  2  BOS IS THE FILE'S AND IS THE RECORDED ONE. tokenizer.ggml.bos_token_id reads 128000,
;           the id the recorded prompt stream starts with.
;   bit  4  THE RECORDED PROMPT ENCODES TO THE RECORDED IDS. "The capital of France is" ->
;           [128000, 791, 6864, 315, 9822, 374] — the exact ids the proven lane fed the model when
;           it answered " Paris. The capital of Italy is Rome. The capital of".
;   bit  8  THE ROUND TRIP CLOSES. The encoder's non-BOS ids, through llama3-detokenize.fk's own
;           l3d-text, spell the prompt back byte for byte. Encoder and decoder are separate cells
;           reaching the same vocabulary from opposite sides; a drift in either breaks this bit.
;   bit 16  THE ROUND TRIP CLOSES ON A SECOND STRING with different shape (leading capital, no
;           leading space on later words handled by the space-fused pieces): "Once upon a time".
;           No recorded ids exist for it, so the claim is self-consistency, stated as exactly that.
;
; RADIUS: greedy longest-match, the attestant's own stated algorithm — NOT merge-order BPE. A
; prompt where the two diverge is outside this band's radius until the pretokenize+merge rung
; lands, and the cell's header names that rung.
;
; preludes: form-stdlib/llama3-tokenize.fk form-stdlib/model-registry.bml

(do
    (defn ltb2-blob () (mr-path (mr-find "llama32-3b")))
    (defn ltb2-prompt () "The capital of France is")
    (defn ltb2-want () (list 128000 791 6864 315 9822 374))

    (defn ltb2-eqlist (a b)
        (if (eq (len a) (len b))
            (if (eq (len a) 0) true
                (if (eq (head a) (head b)) (ltb2-eqlist (tail a) (tail b)) false))
            false))

    (let src (eqr-of-file (ltb2-blob) 0 8000000))
    (let magic-ok (eq (egg-magic-ok? src) 1))

    (let bos (gmt-u32 src "tokenizer.ggml.bos_token_id"))
    (let bos-ok (eq bos 128000))

    (let ids (l3t-encode src (ltb2-prompt)))
    (let enc-ok (ltb2-eqlist ids (ltb2-want)))

    (let rt1 (if (gt (len ids) 0) (str_eq (l3d-text src (tail ids)) (ltb2-prompt)) false))

    (let ids2 (l3t-encode src "Once upon a time"))
    (let rt2 (if (gt (len ids2) 0) (str_eq (l3d-text src (tail ids2)) "Once upon a time") false))

    (add (if magic-ok 1 0)
    (add (if magic-ok (if bos-ok 2 0) 0)
    (add (if magic-ok (if enc-ok 4 0) 0)
    (add (if magic-ok (if rt1 8 0) 0)
         (if magic-ok (if rt2 16 0) 0))))))
