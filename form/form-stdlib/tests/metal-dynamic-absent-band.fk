; metal-dynamic-absent-band.fk -- a bad explicit carrier path stays absent.
;
; RUN: FKWU_METAL_CARRIER=/tmp/fkwu-no-metal-carrier.dylib ./fkwu form/form-stdlib/tests/metal-dynamic-absent-band.fk
;
; Verdict 31 = 1 dynamic-carrier | 2 unloaded | 4 handle-door | 8 reason-spoken
;             | 16 no-late-default-load.
;
; preludes: form-stdlib/core.fk

(do
    (defn mdab-bit (ok bit) (if ok bit 0))
    (defn mdab-has (s sub) (if (ge (str_find s sub 0) 0) 1 0))
    (let st (metal_status))
    (let alloc (metal_buf_alloc 4))
    (add (mdab-bit (mdab-has st "metal_carrier=dynamic") 1)
    (add (mdab-bit (mdab-has st "metal_loaded=false") 2)
    (add (mdab-bit (mdab-has st "metal_door=handle") 4)
    (add (mdab-bit (mdab-has st "last_error=dynamic carrier artifact unavailable") 8)
         (mdab-bit (and (eq alloc 0) (eq (mdab-has (metal_status) "metal_loaded=true") 0)) 16))))))
