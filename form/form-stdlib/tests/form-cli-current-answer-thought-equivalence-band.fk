; form-cli-current-answer-thought-equivalence-band.fk -- the compact resident
; evaluator and canonical PIF walker must agree before the former enters the
; large REPL closure.  Expected: 511.
;
; preludes: form-stdlib/runtime-program-image-fkb-current-answer-recipe.fk
; preludes: form-stdlib/form-cli-current-answer-thought-walk.fk

(do
    (defn fcateb-bit (held weight) (if held weight 0))
    (defn fcateb-source (name) (intern_trivial_string name))
    (defn fcateb-values ()
        (do
            (let source (fcateb-source "sha256:current-source"))
            (list source source "answer" "answer" "hit" "hit"
                "concept-registry-current-source-hit"
                "concept-registry-current-source-hit"
                1 1 1 1 1 1 "choice,cut,release"
                "choice,cut,release")))
    (defn fcateb-kinds ()
        (list (fcatw-kind-node) (fcatw-kind-node)
              (fcatw-kind-string) (fcatw-kind-string)
              (fcatw-kind-string) (fcatw-kind-string)
              (fcatw-kind-string) (fcatw-kind-string)
              (fcatw-kind-int) (fcatw-kind-int)
              (fcatw-kind-int) (fcatw-kind-int)
              (fcatw-kind-int) (fcatw-kind-int)
              (fcatw-kind-string) (fcatw-kind-string)))
    (defn fcateb-replace (xs at value)
        (if (nil? xs) (empty)
            (cons (if (eq at 0) value (head xs))
                (fcateb-replace (tail xs) (sub at 1) value))))
    (defn fcateb-full (values budget)
        (rpsw-walk-symbol-with-kind
            (rpicr-envelope) (rpicr-admission) (rpicr-recipe-identity)
            budget values (rpica-input-kind)))
    (defn fcateb-full-trace (values budget)
        (rpsw-receipt-trace (fcateb-full values budget)))
    (defn fcateb-row-agrees? (a b)
        (if (not (eq (len a) (len (node_children b)))) 0
        (if (not (eq (nth a 0) (fcatw-row-child b 0))) 0
        (if (not (eq (nth a 1) (fcatw-row-child b 1))) 0
        (if (not (eq (nth a 2) (fcatw-row-child b 2))) 0
            (if (eq (nth a 3) (fcatw-row-child b 3)) 1 0))))))
    (defn fcateb-nodes-agree-loop (a b at)
        (if (ge at (len a)) (if (eq (len a) (len b)) 1 0)
            (if (or (ge at (len b))
                    (not (eq (fcateb-row-agrees? (nth a at) (nth b at)) 1))) 0
                (fcateb-nodes-agree-loop a b (add at 1)))))
    (defn form-cli-current-answer-thought-equivalence-band ()
        (do
            (let values (fcateb-values))
            (let mismatch (fcateb-replace values 3 "different"))
            (let full-ok (fcateb-full-trace values 93))
            (let full-zero (fcateb-full-trace mismatch 93))
            (let full-timeout (fcateb-full-trace values 92))
            (let small-ok (fcatw-run values (fcateb-kinds) 93))
            (let small-zero (fcatw-run mismatch (fcateb-kinds) 93))
            (let small-timeout (fcatw-run values (fcateb-kinds) 92))
            (sum (list
                (fcateb-bit (fcateb-nodes-agree-loop
                    (rpicr-nodes) (fcatw-nodes) 0) 1)
                (fcateb-bit (and (eq (rpiwt-trace-output-count full-ok) 1)
                    (eq (rpiwt-trace-first-value full-ok)
                        (fcatw-value small-ok))) 2)
                (fcateb-bit (and (eq (rpiwt-trace-first-value full-ok) 1)
                    (eq (fcatw-value small-ok) 1)) 4)
                (fcateb-bit (and (eq (rpiwt-trace-output-count full-zero) 1)
                    (eq (rpiwt-trace-first-value full-zero)
                        (fcatw-value small-zero))) 8)
                (fcateb-bit (and (eq (rpiwt-trace-first-value full-zero) 0)
                    (eq (fcatw-value small-zero) 0)) 16)
                (fcateb-bit (and (eq (rpiwt-trace-output-count full-timeout) 0)
                    (eq (fcatw-output-count small-timeout) 0)) 32)
                (fcateb-bit (and (str_eq (rpiwt-trace-status full-timeout)
                        (rao-obs-timeout))
                    (str_eq (fcatw-status small-timeout) "timeout")) 64)
                (fcateb-bit (and (eq (rpiwt-trace-steps-used full-ok)
                        (fcatw-steps small-ok))
                    (eq (fcatw-steps small-ok) 93)) 128)
                (fcateb-bit (and (eq (rpiwt-trace-steps-used full-zero)
                        (fcatw-steps small-zero))
                    (eq (rpiwt-trace-steps-used full-timeout)
                        (fcatw-steps small-timeout))) 256)))))

    (form-cli-current-answer-thought-equivalence-band))
