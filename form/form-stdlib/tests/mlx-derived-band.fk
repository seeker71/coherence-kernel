;   32768  gated    sigmoid(0) * 6 = 3.000
;   65536    sin      sin(0) = 0.000                    (row, irreducible)
;   131072   cos      cos(0) = 1.000                    (row, irreducible)
;   262144   log      log(1) = 0.000                    (row, irreducible)
;   524288   pow      2^3 = 8.000 as exp(3 log 2)       (derived — the 2026-08-20 miss)
