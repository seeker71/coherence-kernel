;   256    mean     mean[1,2,3,4] = 2.500
;   512    l2norm   sum(x*rsqrt(sum x^2)) over [3,4] = 1.400
;   1024   rmsnorm  sum(x*rsqrt(mean x^2)) over [3,3] = 2.000
;   2048   softmax  sum(softmax[1,1]) = 1.000
;   4096   matmul   sum([[1,2],[3,4]]^2) = 54.000 (MLX refuses integer matmul)
;   8192   take     [10,20,30,40][2] = 30
