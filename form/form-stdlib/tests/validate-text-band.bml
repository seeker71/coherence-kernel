section [form.bml] {
 def tb-count(t, c, from, n) { let at = str_find(t, c, from); at < 0 ? n : tb-count(t, c, at + 1, n + 1); }
 let t = read_file("form/validate.sh") ?? "";
 let ok = len(t) > 0 && (str_find("form/validate.sh", ".md", 0) > 0 || tb-count(t, "{", 0, 0) == tb-count(t, "}", 0, 0));
 print_str("[validate-text-band] " ++ (ok ? "reads" : "BROKEN"));
