; living-world-expression-composition-witness.fk -- two learned orderings
; compose over held-out material without importing a grammar or primary.
; preludes: form-stdlib/core.fk observe/live-call-framebuffer.fk observe/living-world-expression-progress.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk form-stdlib/living-world-expression-composition.fk form-stdlib/tests/living-world-expression-blueprint-witness.fk

(let LWXCBW-SOURCE-I (bp "LWXCBW-SOURCE-I"))
(let LWXCBW-SOURCE-J (bp "LWXCBW-SOURCE-J"))
(let LWXCBW-SOURCE-K (bp "LWXCBW-SOURCE-K"))
(let LWXCBW-SOURCE-L (bp "LWXCBW-SOURCE-L"))
(let LWXCBW-PROV-I   (bp "LWXCBW-PROV-I"))
(let LWXCBW-PROV-J   (bp "LWXCBW-PROV-J"))
(let LWXCBW-PROV-K   (bp "LWXCBW-PROV-K"))
(let LWXCBW-PROV-L   (bp "LWXCBW-PROV-L"))

(defn lwxcbw-source-i () (lwxbw-cell LWXCBW-SOURCE-I))
(defn lwxcbw-source-j () (lwxbw-cell LWXCBW-SOURCE-J))
(defn lwxcbw-source-k () (lwxbw-cell LWXCBW-SOURCE-K))
(defn lwxcbw-source-l () (lwxbw-cell LWXCBW-SOURCE-L))
(defn lwxcbw-prov-i () (lwxbw-cell LWXCBW-PROV-I))
(defn lwxcbw-prov-j () (lwxbw-cell LWXCBW-PROV-J))
(defn lwxcbw-prov-k () (lwxbw-cell LWXCBW-PROV-K))
(defn lwxcbw-prov-l () (lwxbw-cell LWXCBW-PROV-L))

; --- two recurrent sequence-to-sequence structural orderings ---------

(defn lwxcbw-sequence-input-one () (lwxbw-a-sequence-one))
(defn lwxcbw-sequence-input-two () (lwxbw-a-sequence-two))
(defn lwxcbw-sequence-c-output-one ()
    (lwtv-sequence
        (list (lwxbw-left) (lwxbw-right) (lwxbw-primary))))
(defn lwxcbw-sequence-c-output-two ()
    (lwtv-sequence
        (list (lwxbw-right) (lwxbw-left) (lwxbw-alternate))))
(defn lwxcbw-sequence-d-output-one () (lwxbw-a-sequence-one))
(defn lwxcbw-sequence-d-output-two () (lwxbw-a-sequence-two))

(defn lwxcbw-correspondence-c-one ()
    (lwr-correspondence
        (lwxcbw-sequence-input-one) (lwxcbw-sequence-c-output-one)))
(defn lwxcbw-correspondence-c-two ()
    (lwr-correspondence
        (lwxcbw-sequence-input-two) (lwxcbw-sequence-c-output-two)))
(defn lwxcbw-correspondence-d-one ()
    (lwr-correspondence
        (lwxcbw-sequence-input-one) (lwxcbw-sequence-d-output-one)))
(defn lwxcbw-correspondence-d-two ()
    (lwr-correspondence
        (lwxcbw-sequence-input-two) (lwxcbw-sequence-d-output-two)))

(defn lwxcbw-sequence-entries ()
    (list
        (lwxbw-entry (lwxcbw-source-i) (lwxcbw-prov-i)
            (lwxcbw-correspondence-c-one))
        (lwxbw-entry (lwxcbw-source-j) (lwxcbw-prov-j)
            (lwxcbw-correspondence-c-two))
        (lwxbw-entry (lwxcbw-source-k) (lwxcbw-prov-k)
            (lwxcbw-correspondence-d-one))
        (lwxbw-entry (lwxcbw-source-l) (lwxcbw-prov-l)
            (lwxcbw-correspondence-d-two))))

(defn lwxcbw-sequence-world ()
    (lwt-receive-stream
        (lwxbw-mapping-world) (lwxcbw-sequence-entries)))
(defn lwxcbw-sequence-round-build ()
    (do
        (let world (lwxcbw-sequence-world))
        (lwt-round world (lwr-proposals world 2)
            (lwo-empty-field) (lwxbw-mapping-integrated-round))))
(defn lwxcbw-sequence-round ()
    (do
        (let found (fbvc-find (fbvc-key "lwxcbw-sequence-round")))
        (if (eq (fbvc-hit? found) 1)
            (fbvc-value found)
            (do
                (let entered
                    (lwx-progress "sequence-round-build" "enter"
                        "lwxcbw-sequence-round-build" "lwxcbw-sequence-round" 13
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk" 75 21))
                (let value (lwxcbw-sequence-round-build))
                (let left
                    (lwx-progress "sequence-round-build" "leave"
                        "lwxcbw-sequence-round-build" "lwxcbw-sequence-round" 14
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk" 80 21))
                (let stored
                    (fbvc-store (fbvc-key "lwxcbw-sequence-round") value
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk"
                        84 21))
                value))))

(defn lwxcbw-proposal-output (proposal input)
    (lwr-apply-mapping
        (lwo-emergent-shape (lwt-proposal-candidate proposal)) input))
(defn lwxcbw-proposal-for-output-items (items input expected)
    (if (eq (len items) 0) (lwo-none)
        (if (node_eq (lwxcbw-proposal-output (head items) input) expected)
            (head items)
            (lwxcbw-proposal-for-output-items
                (tail items) input expected))))
(defn lwxcbw-proposal-for-output (input expected)
    (lwxcbw-proposal-for-output-items
        (lwo-field-items
            (lwt-round-proposals (lwxcbw-sequence-round))) input expected))
(let LWXCBW-SEQUENCE-PROPOSAL-C-VALUE
    (lwxcbw-proposal-for-output
        (lwxcbw-sequence-input-one) (lwxcbw-sequence-c-output-one)))
(let LWXCBW-SEQUENCE-PROPOSAL-D-VALUE
    (lwxcbw-proposal-for-output
        (lwxcbw-sequence-input-one) (lwxcbw-sequence-d-output-one)))
(defn lwxcbw-sequence-proposal-c ()
    LWXCBW-SEQUENCE-PROPOSAL-C-VALUE)
(defn lwxcbw-sequence-proposal-d ()
    LWXCBW-SEQUENCE-PROPOSAL-D-VALUE)
(defn lwxcbw-sequence-candidate-c ()
    (lwt-proposal-candidate (lwxcbw-sequence-proposal-c)))
(defn lwxcbw-sequence-candidate-d ()
    (lwt-proposal-candidate (lwxcbw-sequence-proposal-d)))

(defn lwxcbw-sequence-yes-round-build ()
    (do
        (let round (lwxcbw-sequence-round))
        (let pc (lwxcbw-sequence-proposal-c))
        (let pd (lwxcbw-sequence-proposal-d))
        (lwt-round-receive round
            (append
                (lwxbw-responses pc
                    (oac-one (lwt-proposal-candidate pc)))
                (lwxbw-responses pd
                    (oac-one (lwt-proposal-candidate pd)))))))
(defn lwxcbw-sequence-first-integrated-round-build ()
    (lwt-integrate (lwxcbw-sequence-yes-round-build)
        (lwxcbw-sequence-proposal-c) (lwxbw-action)))
(defn lwxcbw-sequence-first-integrated-round ()
    (do
        (let found
            (fbvc-find (fbvc-key "lwxcbw-sequence-first-integrated-round")))
        (if (eq (fbvc-hit? found) 1)
            (fbvc-value found)
            (do
                (let entered
                    (lwx-progress "sequence-first-integration" "enter"
                        "lwxcbw-sequence-first-integrated-round-build"
                        "lwxcbw-sequence-first-integrated-round" 15
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk" 139 21))
                (let value (lwxcbw-sequence-first-integrated-round-build))
                (let left
                    (lwx-progress "sequence-first-integration" "leave"
                        "lwxcbw-sequence-first-integrated-round-build"
                        "lwxcbw-sequence-first-integrated-round" 16
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk" 145 21))
                (let stored
                    (fbvc-store
                        (fbvc-key "lwxcbw-sequence-first-integrated-round") value
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk"
                        150 21))
                value))))
(defn lwxcbw-sequence-first-world ()
    (lwt-round-world (lwxcbw-sequence-first-integrated-round)))
(defn lwxcbw-sequence-integrated-round-build ()
    (lwt-integrate (lwxcbw-sequence-first-integrated-round)
        (lwxcbw-sequence-proposal-d) (lwxbw-action)))
(defn lwxcbw-sequence-integrated-round ()
    (do
        (let found
            (fbvc-find (fbvc-key "lwxcbw-sequence-integrated-round")))
        (if (eq (fbvc-hit? found) 1)
            (fbvc-value found)
            (do
                (let entered
                    (lwx-progress "sequence-second-integration" "enter"
                        "lwxcbw-sequence-integrated-round-build"
                        "lwxcbw-sequence-integrated-round" 17
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk" 168 21))
                (let value (lwxcbw-sequence-integrated-round-build))
                (let left
                    (lwx-progress "sequence-second-integration" "leave"
                        "lwxcbw-sequence-integrated-round-build"
                        "lwxcbw-sequence-integrated-round" 18
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk" 174 21))
                (let stored
                    (fbvc-store
                        (fbvc-key "lwxcbw-sequence-integrated-round") value
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk"
                        179 21))
                value))))
(defn lwxcbw-sequence-mapping-world ()
    (lwt-round-world (lwxcbw-sequence-integrated-round)))

; --- two compatible chains remain separate ---------------------------

(let LWXCBW-CHAIN-PROPOSAL-C-VALUE
    (lwxc-chain-proposal (lwxcbw-sequence-mapping-world)
        (lwxbw-mapping-candidate-a) (lwxcbw-sequence-candidate-c)))
(let LWXCBW-CHAIN-PROPOSAL-D-VALUE
    (lwxc-chain-proposal (lwxcbw-sequence-mapping-world)
        (lwxbw-mapping-candidate-a) (lwxcbw-sequence-candidate-d)))
(defn lwxcbw-chain-proposal-c () LWXCBW-CHAIN-PROPOSAL-C-VALUE)
(defn lwxcbw-chain-proposal-d () LWXCBW-CHAIN-PROPOSAL-D-VALUE)
(defn lwxcbw-chain-candidate-c ()
    (lwt-proposal-candidate (lwxcbw-chain-proposal-c)))
(defn lwxcbw-chain-candidate-d ()
    (lwt-proposal-candidate (lwxcbw-chain-proposal-d)))
(defn lwxcbw-chain-round-build ()
    (lwt-round (lwxcbw-sequence-mapping-world)
        (lwo-field
            (list (lwxcbw-chain-proposal-c) (lwxcbw-chain-proposal-d)))
        (lwo-empty-field) (lwxcbw-sequence-integrated-round)))
(defn lwxcbw-chain-yes-round-build ()
    (do
        (let round (lwxcbw-chain-round-build))
        (let pc (lwxcbw-chain-proposal-c))
        (let pd (lwxcbw-chain-proposal-d))
        (lwt-round-receive round
            (append
                (lwxbw-responses pc
                    (oac-one (lwt-proposal-candidate pc)))
                (lwxbw-responses pd
                    (oac-one (lwt-proposal-candidate pd)))))))
(defn lwxcbw-chain-integrated-round-build ()
    (do
        (let round (lwxcbw-chain-yes-round-build))
        (let first (lwxc-integrate-chain round
            (lwxcbw-chain-proposal-c) (lwxbw-action)))
        (lwxc-integrate-chain first
            (lwxcbw-chain-proposal-d) (lwxbw-action))))
(defn lwxcbw-chain-integrated-round ()
    (do
        (let found
            (fbvc-find (fbvc-key "lwxcbw-chain-integrated-round")))
        (if (eq (fbvc-hit? found) 1)
            (fbvc-value found)
            (do
                (let entered
                    (lwx-progress "chain-integrated-round-build" "enter"
                        "lwxcbw-chain-integrated-round-build"
                        "lwxcbw-chain-integrated-round" 19
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk" 232 21))
                (let value (lwxcbw-chain-integrated-round-build))
                (let left
                    (lwx-progress "chain-integrated-round-build" "leave"
                        "lwxcbw-chain-integrated-round-build"
                        "lwxcbw-chain-integrated-round" 20
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk" 238 21))
                (let stored
                    (fbvc-store (fbvc-key "lwxcbw-chain-integrated-round") value
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk"
                        243 21))
                value))))
(defn lwxcbw-chain-world ()
    (lwt-round-world (lwxcbw-chain-integrated-round)))

; --- both chains derive a new held-out sequence ----------------------

(defn lwxcbw-expected-c ()
    (lwtv-sequence
        (list (lwxbw-left) (lwxbw-right) (lwxbw-alternate))))
(defn lwxcbw-expected-d () (lwxbw-expected-a))
(let LWXCBW-APPLICATION-PROPOSAL-C-VALUE
    (lwxc-application-proposal (lwxcbw-chain-world)
        (lwxcbw-chain-candidate-c) (lwxbw-heldout-material)))
(let LWXCBW-APPLICATION-PROPOSAL-D-VALUE
    (lwxc-application-proposal (lwxcbw-chain-world)
        (lwxcbw-chain-candidate-d) (lwxbw-heldout-material)))
(defn lwxcbw-application-proposal-c ()
    LWXCBW-APPLICATION-PROPOSAL-C-VALUE)
(defn lwxcbw-application-proposal-d ()
    LWXCBW-APPLICATION-PROPOSAL-D-VALUE)
(defn lwxcbw-application-candidate-c ()
    (lwt-proposal-candidate (lwxcbw-application-proposal-c)))
(defn lwxcbw-application-candidate-d ()
    (lwt-proposal-candidate (lwxcbw-application-proposal-d)))
(defn lwxcbw-application-round-build ()
    (lwt-round (lwxcbw-chain-world)
        (lwo-field
            (list (lwxcbw-application-proposal-c)
                  (lwxcbw-application-proposal-d)))
        (lwo-empty-field) (lwxcbw-chain-integrated-round)))
(defn lwxcbw-application-yes-round-build ()
    (do
        (let round (lwxcbw-application-round-build))
        (let pc (lwxcbw-application-proposal-c))
        (let pd (lwxcbw-application-proposal-d))
        (lwt-round-receive round
            (append
                (lwxbw-responses pc
                    (oac-one (lwt-proposal-candidate pc)))
                (lwxbw-responses pd
                    (oac-one (lwt-proposal-candidate pd)))))))
(defn lwxcbw-application-integrated-round-build ()
    (do
        (let round (lwxcbw-application-yes-round-build))
        (let first (lwxc-integrate-application round
            (lwxcbw-application-proposal-c) (lwxbw-action)))
        (lwxc-integrate-application first
            (lwxcbw-application-proposal-d) (lwxbw-action))))
(defn lwxcbw-application-integrated-round ()
    (do
        (let found
            (fbvc-find (fbvc-key "lwxcbw-application-integrated-round")))
        (if (eq (fbvc-hit? found) 1)
            (fbvc-value found)
            (do
                (let entered
                    (lwx-progress "application-integrated-round-build" "enter"
                        "lwxcbw-application-integrated-round-build"
                        "lwxcbw-application-integrated-round" 21
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk" 302 21))
                (let value (lwxcbw-application-integrated-round-build))
                (let left
                    (lwx-progress "application-integrated-round-build" "leave"
                        "lwxcbw-application-integrated-round-build"
                        "lwxcbw-application-integrated-round" 22
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk" 308 21))
                (let stored
                    (fbvc-store
                        (fbvc-key "lwxcbw-application-integrated-round") value
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk"
                        313 21))
                value))))
(defn lwxcbw-application-world ()
    (lwt-round-world (lwxcbw-application-integrated-round)))

; --- zero / one / many, optional live channel, and final consent ------

(defn lwxcbw-minimal-plan (applications)
    (lwxc-plan-for (lwxcbw-application-world)
        (lwxbw-heldout-material) applications (lwo-none)
        (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none)
        (lwxbw-evidence)))
(let LWXCBW-ZERO-PLAN-VALUE
    (lwxcbw-minimal-plan (lwo-empty-field)))
(let LWXCBW-ONE-PLAN-VALUE
    (lwxcbw-minimal-plan
        (lwo-field (list (lwxcbw-application-candidate-c)))))
(let LWXCBW-MANY-PLAN-VALUE
    (lwxcbw-minimal-plan
        (lwo-field
            (list (lwxcbw-application-candidate-c)
                  (lwxcbw-application-candidate-d)))))
(let LWXCBW-RICH-PLAN-VALUE
    (lwxc-plan-for (lwxcbw-application-world)
        (lwxbw-heldout-material)
        (lwo-field (list (lwxcbw-application-candidate-c)))
        (lwxbw-declaration) (lwo-field (list (lwxbw-alternative)))
        (lwlc-unknown (lwxbw-evidence)) (lwxbw-choice)
        (lwxbw-timeout) (lwxbw-evidence)))
(defn lwxcbw-zero-plan () LWXCBW-ZERO-PLAN-VALUE)
(defn lwxcbw-one-plan () LWXCBW-ONE-PLAN-VALUE)
(defn lwxcbw-many-plan () LWXCBW-MANY-PLAN-VALUE)
(defn lwxcbw-rich-plan () LWXCBW-RICH-PLAN-VALUE)

(let LWXCBW-UTTERANCE-VALUE
    (lwxc-emit-from-plan
        (lwxcbw-application-world) (lwxcbw-rich-plan)))
(let LWXCBW-UTTERANCE-PROPOSAL-VALUE
    (lwxc-utterance-proposal
        (lwxcbw-application-world) (lwxcbw-rich-plan)))
(defn lwxcbw-utterance () LWXCBW-UTTERANCE-VALUE)
(defn lwxcbw-utterance-proposal () LWXCBW-UTTERANCE-PROPOSAL-VALUE)
(defn lwxcbw-voice-round-build ()
    (lwt-round (lwxcbw-application-world)
        (lwo-field (list (lwxcbw-utterance-proposal)))
        (lwo-empty-field) (lwxcbw-application-integrated-round)))
(defn lwxcbw-dissent-round-build ()
    (do
        (let round (lwxcbw-voice-round-build))
        (let proposal (lwxcbw-utterance-proposal))
        (let participants
            (lwo-field-items (lwt-proposal-participants proposal)))
        (lwt-round-receive round
            (append
                (list (lwxbw-response-entry
                    (head participants) proposal (oac-zero)))
                (lwxbw-response-items (tail participants) proposal
                    (oac-one (lwt-proposal-candidate proposal)))))))
(defn lwxcbw-voice-integrated-round-build ()
    (do
        (let round (lwxcbw-voice-round-build))
        (let proposal (lwxcbw-utterance-proposal))
        (let yes (lwt-round-receive round
            (lwxbw-responses proposal
                (oac-one (lwt-proposal-candidate proposal)))))
        (lwxc-integrate-utterance yes proposal (lwxbw-action))))
(defn lwxcbw-voice-integrated-round ()
    (do
        (let found (fbvc-find (fbvc-key "lwxcbw-voice-integrated-round")))
        (if (eq (fbvc-hit? found) 1)
            (fbvc-value found)
            (do
                (let entered
                    (lwx-progress "voice-integrated-round-build" "enter"
                        "lwxcbw-voice-integrated-round-build"
                        "lwxcbw-voice-integrated-round" 23
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk" 389 21))
                (let value (lwxcbw-voice-integrated-round-build))
                (let left
                    (lwx-progress "voice-integrated-round-build" "leave"
                        "lwxcbw-voice-integrated-round-build"
                        "lwxcbw-voice-integrated-round" 24
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk" 395 21))
                (let stored
                    (fbvc-store (fbvc-key "lwxcbw-voice-integrated-round") value
                        "form/form-stdlib/tests/living-world-expression-composition-witness.fk"
                        400 21))
                value))))
(defn lwxcbw-voice-world ()
    (lwt-round-world (lwxcbw-voice-integrated-round)))
(defn lwxcbw-revoked-world ()
    (lwt-receive-stream (lwxcbw-voice-world)
        (list (lwxbw-entry (lwxbw-source-g) (lwxbw-prov-g)
            (lwo-revocation (lwxbw-heldout-material)
                (lwxbw-source-g) (lwxbw-reason) (lwxbw-prov-g))))))
