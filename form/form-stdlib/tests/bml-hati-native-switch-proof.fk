; tests/bml-hati-native-switch-proof.fk
;
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk
;
; Closes the general-switch family on the Hati table lane:
; `switch (e) { case v: ... default: ... }` from source with the
; scrutinee evaluated once into a cell, fall-through until break, stacked
; case labels, default in the middle (a later case still wins), a labeled
; switch break, and a switch inside a loop where break leaves the switch
; and continue reaches the loop.

(do
    (defn score-bool (actual)
        (if actual 1 0))

    (defn score-int (actual expected)
        (if (eq actual expected) 1 0))

    (defn score-str (actual expected)
        (if (nil? actual)
            0
            (if (str_eq actual expected) 1 0)))

    (defn str-contains? (haystack needle)
        (ge (str_find haystack needle 0) 0))

    (defn parse-source (source)
        (bml-source-parse-executable-stream (bml-source-scan-text source)))

    (defn method-node (source)
        (head (bml-source-exec-parse-nodes (parse-source source))))

    (defn acc-self (k)
        (record_set (record_new (make_nodeid 1 9 2026 613) "k" k) "acc" 0))

    (let main-parsed
        (parse-source "switch (2 * 3) { case 6: return 60; default: return 0; }\n"))
    (let main-node (bml-source-exec-parse-node main-parsed))
    (let main-image (bml-hati-compile-image main-node))
    (let main-table (bml-hati-table-file main-image))

    (let pick-node
        (method-node
            "int Pick(int k) { switch (k) { case 1: return 10; case 2: case 3: return 23; default: return 99; } }\n"))

    (let fall-node
        (method-node
            "int Fall() { switch (this.k) { case 1: this.acc = this.acc + 1; case 2: this.acc = this.acc + 10; break; case 3: this.acc = this.acc + 100; default: this.acc = this.acc + 1000; } return this.acc; }\n"))

    (let mid-node
        (method-node
            "int Mid(int k) { switch (k) { case 1: return 1; default: return 50; case 2: return 2; } }\n"))

    (let lab-node
        (method-node
            "int Lab(int k) { sw: switch (k) { case 1: { if (k == 1) break sw; return 5; } default: return 9; } return 77; }\n"))

    (let mix-node
        (method-node
            "int Mix() { for (int i = 0; i < 5; i++) { switch (i) { case 1: continue; case 3: break; default: this.acc = this.acc + i; } this.acc = this.acc + 100; } return this.acc; }\n"))

    (sum
        (list
            (score-bool (bml-source-exec-parse-ok? main-parsed))
            (score-int (len (bml-source-exec-parse-rest main-parsed)) 0)
            (score-str (head (bml-source-exec-parse-rules main-parsed)) "control-switch")
            (score-bool (bml-hati-image-supported? main-image))
            (score-bool (not (str-contains? main-table "BML-HATI-UNSUPPORTED")))
            (score-int (bml-hati-run-value main-node) 60)
            (score-int (bml-hati-run-value-with-arg pick-node 1) 10)
            (score-int (bml-hati-run-value-with-arg pick-node 2) 23)
            (score-int (bml-hati-run-value-with-arg pick-node 3) 23)
            (score-int (bml-hati-run-value-with-arg pick-node 7) 99)
            (score-int (bml-hati-run-value-with-arg fall-node (acc-self 1)) 11)
            (score-int (bml-hati-run-value-with-arg fall-node (acc-self 2)) 10)
            (score-int (bml-hati-run-value-with-arg fall-node (acc-self 3)) 1100)
            (score-int (bml-hati-run-value-with-arg fall-node (acc-self 5)) 1000)
            (score-int (bml-hati-run-value-with-arg mid-node 2) 2)
            (score-int (bml-hati-run-value-with-arg mid-node 9) 50)
            (score-int (bml-hati-run-value-with-arg mid-node 1) 1)
            (score-int (bml-hati-run-value-with-arg lab-node 1) 77)
            (score-int (bml-hati-run-value-with-arg lab-node 2) 9)
            (score-int (bml-hati-run-value-with-arg mix-node (acc-self 0)) 406))))
