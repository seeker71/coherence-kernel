; form-glass-organ-care-band — care is explicit, coverage-bound, and never
; turns an attention receipt into a fabricated healed claim.
; preludes: form-stdlib/bml/form-glass-organ-care.bml
(do
    (defn fgocb-bit (condition bit) (if condition bit 0))
    (let voice (fgoc-organ "voice" 0 "HOMECOMING.md" "LoraWriter=0" "write-one-adapter" 25))
    (let kernel (fgoc-organ "kernel" 1 "bootstrap/ground.fk" "ground=42" "" 25))
    (let unknown (fgoc-organ "ear" (nothing) "HOMECOMING.md" "ear-unobserved" "observe-ear" 20))
    (let received (fgoc-attention "voice" "LoraWriter=0" "write-one-adapter" "received" "care-1"))
    (let applied (fgoc-attention "voice" "LoraWriter=0" "write-one-adapter" "applied" "care-2"))
    (let mismatch (fgoc-attention "voice" "other-evidence" "write-one-adapter" "received" "care-3"))
    (let rows (list voice kernel unknown))
    (let complete (fgoc-census (list "voice" "kernel" "ear")))
    (let held (list voice kernel))
    (let held-census (fgoc-census (list "voice" "kernel")))
    (let complete-coverage (fgoc-coverage-complete? complete rows))
    (let held-all (fgoc-all-held? held-census held (list received)))
    (let duplicate-coverage (fgoc-coverage (fgoc-census (list "voice" "voice")) held))
    (let healthy-count (fgoc-status-count rows (list received) "healthy"))
    (let attended-count (fgoc-status-count rows (list received) "attention-received"))
    (sum (list
        (fgocb-bit (fgoc-organ-valid? voice) 1)
        (fgocb-bit (str_eq (fgoc-status voice (list)) "asking") 2)
        (fgocb-bit (str_eq (fgoc-status voice (list received)) "attention-received") 4)
        (fgocb-bit (str_eq (fgoc-status voice (list applied)) "attention-applied") 8)
        (fgocb-bit (str_eq (fgoc-status kernel (list)) "healthy") 16)
        (fgocb-bit (str_eq (fgoc-status unknown (list)) "unobserved") 32)
        (fgocb-bit (eq complete-coverage 1) 64)
        (fgocb-bit (eq (fgoc-all-held? complete rows (list received)) 0) 128)
        (fgocb-bit (eq held-all 1) 256)
        (fgocb-bit (str_eq duplicate-coverage "partial") 512)
        (fgocb-bit (str_eq (fgoc-status voice (list mismatch)) "asking") 1024)
        (fgocb-bit (and (eq healthy-count 1)
                        (eq attended-count 1)) 2048))))
