; The same callable symbol delta paired with a deliberately wrong __TEXT size
; must return 0 before BLR. This witnesses that an artifact/current-carrier
; identity mismatch cannot become an indirect call through a guessed address.
;
; witnessed: 2026-07-28 -> 0 before BLR for mismatched live __TEXT size
;
; preludes: native/metal/dsv4-jit-metal-abi.fk

(do
    (let route
        (dsv4-jit-metal-transaction-route "fkwu-metal-transaction"))
    (if (lt (len route) 2) 0
        (native_call_bytes
            (djma-transaction-controller-bytes "")
            (add
                (nth route 0)
                (mul (add (nth route 1) 4096) 4294967296)))))
