; form-native-decode-chain-encoding-band.fk — the FOUR-WAY-PROVABLE slice of
; form-native-decode-chain.fk, following form-native-decode-encoding-band.fk's exact precedent: the
; new pure-Form arithmetic this file's probe adds has nothing to do with Metal, and burying it inside
; a Metal-gated witness would have hidden a claim this repo's discipline says to register.
;
; WHAT IS NEW HERE, beyond what form-native-decode-encoding-band.fk and q4k-msl-band.fk already
; prove: (1) fndc-q-row-bytes, the cols->row_bytes formula this probe's correctness depended on and
; whose first draft got wrong (144, a SUPERBLOCK stride, instead of (cols/256)*144, a ROW stride —
; the exact bug this band's bit 1 pins down so it cannot silently return); (2) md-bind16 exercised
; WITH its barrier_before=1 tail (metal-door.fk itself is proven elsewhere, but not with barrier=1
; specifically — this file is the first caller to need it); (3) the row-major flat-index composition
; (idx = row*cols + j) this probe's fndc-ref-dot-loop feeds into q4k-msl.fk's q4m-flat-at.
;
; WHAT IS NOT HERE, and why: q4m-flat-at's own arithmetic (the Q4_K unpack itself) is q4k-msl.fk's
; claim, tested at q4k-msl-band.fk, and that band is TWO-ARM (fkwu+go) because it reads real GGUF
; bytes through eqr-of-file — a limit this band inherits rather than re-litigates. Nothing below
; opens a file or touches Metal.
;
; verdict bits: 1 row-bytes formula, 2 barrier=1 tail decodes correctly, 4 barrier=0 tail still
; decodes correctly (same primitive, both values), 8 the row-major flat-index composition
;
; preludes: form-stdlib/core.fk form-stdlib/format-arith.fk form-stdlib/metal-door.fk
;
; NOTE ON WHY THIS DOES NOT PRELUDE form-native-decode-chain.fk DIRECTLY: that file (like its
; timing-probe kin, form-native-decode-timing.fk / -timing-concurrent.fk) is a LIVE, self-executing
; witness — it ends by CALLING (fndc-show), which dispatches real Metal primitives. Preluding it here
; would pull that live call onto every arm this band runs on, and go/rust/ts have no metal_* ops
; bound at all (they crash with "unbound function metal_status" the moment the file loads) — the
; same reason form-native-decode-encoding-band.fk preludes the INERT form-native-decode.fk (which
; only DEFINES fnd-run, never calls it) rather than either of the live timing files. This band's
; equivalent of that inert base is a one-line duplication below (fncb-row-bytes), not a prelude,
; because form-native-decode-chain.fk mixes its definitions and its live call in one file rather
; than splitting them the way form-native-decode.fk / *-timing*.fk do — kept in sync by inspection
; against form-native-decode-chain.fk's own fndc-q-row-bytes, which this band's bit 1 exists to
; pin down.
;
; Proven by: this file.

(do
    ; an independent reading of md-bind16's output — str_byte_at direct, NOT md-le32 re-asked —
    ; DEFINED BEFORE ITS CALLER, this body's own stated discipline.
    (defn c2b-u32 (s off) (add (str_byte_at s off) (mul 256 (add (str_byte_at s (add off 1))
                             (mul 256 (add (str_byte_at s (add off 2)) (mul 256 (str_byte_at s (add off 3)))))))))

    ; the SAME formula form-native-decode-chain.fk's fndc-q-row-bytes computes, duplicated (not
    ; preluded — see header) so this band stays Metal-free.
    (defn fncb-row-bytes (cols) (mul (div cols 256) 144))

    ; ---- bit 1: the row-bytes formula — the exact bug class this file's header names. A Q4_K row
    ; is (cols/256) superblocks of 144 bytes: cols=256 -> 144 (one superblock), cols=3072 -> 1728
    ; (the real attn_q.weight width, 12 superblocks), cols=512 -> 288 (two superblocks,
    ; q4k-msl-band.fk's own fixture width). NOT 144 for every width — that was the bug. ----
    (let c1 (if (eq (fncb-row-bytes 256) 144)
            (if (eq (fncb-row-bytes 3072) 1728)
            (if (eq (fncb-row-bytes 512) 288) 1 0) 0) 0))

    ; ---- bit 2 / bit 4: md-bind16 WITH barrier_before=1 and barrier_before=0 — the base+16 tail
    ; this probe is the first caller to exercise with barrier=1 (metal-door.fk's own proofs exercise
    ; the shape, not necessarily this value; stage A in the probe still needs barrier=0 to work
    ; through the SAME primitive). Layout per the door's own header:
    ;   n_buf | buf[0] | n_const | const[0] | tpg | tgmem | mode | barrier
    ;   [0..3]   [4..7]   [8..11]   [12..15]  [16..19][20..23][24..27][28..31] ----
    (let bound (md-bind16 (list 7) (list 9) 0 0 0 1))
    (let c2 (if (eq (str_len bound) 32)
            (if (eq (c2b-u32 bound 0) 1)
            (if (eq (c2b-u32 bound 4) 7)
            (if (eq (c2b-u32 bound 8) 1)
            (if (eq (c2b-u32 bound 12) 9)
            (if (eq (c2b-u32 bound 16) 0)
            (if (eq (c2b-u32 bound 20) 0)
            (if (eq (c2b-u32 bound 24) 0)
            (if (eq (c2b-u32 bound 28) 1) 2 0) 0) 0) 0) 0) 0) 0) 0) 0))

    (let bound0 (md-bind16 (list 7) (list 9) 0 0 0 0))
    (let c2z (if (eq (c2b-u32 bound0 28) 0) 4 0))

    ; ---- bit 8: the row-major flat-index composition fndc-ref-dot-loop feeds q4m-flat-at —
    ; idx = row*cols + j. Row 0 is just j; row 1 starts exactly one row-width later; a wider row
    ; (cols=3072, the real attn_q.weight width) starts row 2 at 6144, and the LAST element of the
    ; last of `fndc-rows` () = 8 real rows lands at 24575, not at some drifted value. ----
    (let c4 (if (eq (add (mul 0 256) 0) 0)
            (if (eq (add (mul 0 256) 255) 255)
            (if (eq (add (mul 1 256) 0) 256)
            (if (eq (add (mul 2 3072) 0) 6144)
            (if (eq (add (mul 7 3072) 3071) 24575) 8 0) 0) 0) 0) 0))

    (add c1 (add c2 (add c2z c4))))
