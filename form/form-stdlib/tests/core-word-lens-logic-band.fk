; core-word-lens-logic-band.fk — timeless invariance and situated dependence
; on time plus the complete point/direction/intensity/focus lens.
; import "form-stdlib/core-word-inquiry.fk"

(do
    (defn cwll-bit (condition bit) (if condition bit 0))
    (defn cwll-sum (values)
        (if (eq (len values) 0) 0
            (add (head values) (cwll-sum (tail values)))))

    (let lens-a (cwi-lens 1 2 3 4))
    (let lens-point (cwi-lens 2 2 3 4))
    (let lens-direction (cwi-lens 1 3 3 4))
    (let lens-intensity (cwi-lens 1 2 4 4))
    (let lens-focus (cwi-lens 1 2 3 5))
    (let timeless-a
        (cwi-logic-node (cwi-logic-mode-timeless)
            "WE" "we" "WHY" 0 lens-a 1))
    (let timeless-b
        (cwi-logic-node (cwi-logic-mode-timeless)
            "WE" "we" "WHY" 255 lens-focus 1))
    (let situated-a
        (cwi-logic-node (cwi-logic-mode-situated)
            "WE" "we" "WHY" 17 lens-a 1))
    (let situated-time
        (cwi-logic-node (cwi-logic-mode-situated)
            "WE" "we" "WHY" 18 lens-a 1))
    (let situated-point
        (cwi-logic-node (cwi-logic-mode-situated)
            "WE" "we" "WHY" 17 lens-point 1))
    (let situated-direction
        (cwi-logic-node (cwi-logic-mode-situated)
            "WE" "we" "WHY" 17 lens-direction 1))
    (let situated-intensity
        (cwi-logic-node (cwi-logic-mode-situated)
            "WE" "we" "WHY" 17 lens-intensity 1))
    (let situated-focus
        (cwi-logic-node (cwi-logic-mode-situated)
            "WE" "we" "WHY" 17 lens-focus 1))
    (let situated-max
        (cwi-logic-node (cwi-logic-mode-situated)
            "EXIST" "EXIST" "WHY" 255 (cwi-lens 7 7 7 7) 1))

    ; 65535 means all 16 observations held.
    (cwll-sum
        (list
            (cwll-bit (eq (cwi-lens? lens-a) 1) 1)
            (cwll-bit
                (and (eq (cwi-l-point lens-a) 1)
                    (and (eq (cwi-l-direction lens-a) 2)
                    (and (eq (cwi-l-intensity lens-a) 3)
                         (eq (cwi-l-focus lens-a) 4)))) 2)
            (cwll-bit (eq (cwi-lens? (cwi-lens 8 0 0 0)) 0) 4)
            (cwll-bit (eq (cwi-lens-rank lens-a) 668) 8)
            (cwll-bit (eq timeless-a timeless-b) 16)
            (cwll-bit (not (eq situated-a situated-time)) 32)
            (cwll-bit (not (eq situated-a situated-point)) 64)
            (cwll-bit (not (eq situated-a situated-direction)) 128)
            (cwll-bit (not (eq situated-a situated-intensity)) 256)
            (cwll-bit (not (eq situated-a situated-focus)) 512)
            (cwll-bit
                (eq situated-a
                    (cwi-request-node "WE" "we" "WHY" 17 lens-a 1)) 1024)
            (cwll-bit
                (and (eq (cwi-node-mode timeless-a)
                         (cwi-logic-mode-timeless))
                     (eq (cwi-node-mode situated-a)
                         (cwi-logic-mode-situated))) 2048)
            (cwll-bit
                (and (eq (cwi-r-direction situated-a) 2)
                    (and (eq (cwi-r-intensity situated-a) 3)
                         (eq (cwi-r-focus situated-a) 4))) 4096)
            (cwll-bit (eq (cwi-request-node? situated-a) 1) 8192)
            (cwll-bit
                (gt (cwi-cross-root-distance-min)
                    (cwi-request-detail-max)) 16384)
            (cwll-bit
                (and (eq situated-max (cwi-request-node-max))
                     (eq (cwi-node-detail situated-max)
                         (cwi-request-detail-max))) 32768))))
