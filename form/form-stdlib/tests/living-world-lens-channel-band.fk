; living-world-lens-channel-band.fk -- source light and both resonances remain.
; Verdict 32767 proves fifteen optional lens, execution, flow, and freedom claims.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/tests/living-world-lens-channel-witness.fk

(do
    ; The same exact `(add 2 3)` recipe is executed separately through the
    ; Form-native --src witness. This band inspects its bound receipt.
    (let observed 5)
    (let out (lwlcw-out-pass))
    (let back (lwlcw-return-pass))
    (let exchange (lwlcw-exchange))
    (let world (lwlcw-world))
    (let revoked (lwlcw-revoked-world))
    (let steps (lwlc-step-items (lwlc-pass-steps out)))
    (let execution (lwlc-step-execution (nth steps 1)))
    (let choice (lwlc-step-choice (head steps)))
    (let empty-stack
        (lwlc-stack (lwo-none) (lwlc-layers (list))
            (lwo-empty-field) (lwo-none) (lwo-none)))
    (let empty-declaration
        (lwlc-declaration (lwlcw-direction-a)
            empty-stack (lwo-none)))
    (let empty-pass
        (lwlc-pass empty-declaration (lwlcw-pure) (lwlcw-pure)
            (lwlc-steps (list)) (lwlcw-pure) (lwo-none)))

    (let c1 (if (and (node_eq
                          (lwlc-lens-shape (lwlcw-blueprint-lens))
                          (lwlc-blueprint-shape))
                      (and (node_eq
                            (lwlc-lens-shape (lwlcw-recipe-lens))
                            (lwlc-recipe-shape))
                           (node_eq
                            (lwlc-lens-shape (lwlcw-cell-lens))
                            (lwlc-cell-shape)))) 1 0))
    (let c2 (if (and (eq (lwlc-stack-valid?
                              (lwlcw-out-stack)) 1)
                         (eq (len (lwlc-stack-applied-lenses
                                   (lwlcw-out-stack))) 3)) 2 0))
    (let c3 (if (and (eq (lwlc-execution? execution) 1)
                         (and (node_eq
                                (lwlc-lens-payload
                                  (lwlc-execution-lens execution))
                                (lwlcw-recipe))
                              (and (eq (node_value
                                    (lwlc-execution-result execution)) observed)
                              (node_eq (lwlc-execution-before execution)
                                       (lwlcw-resonated))))) 4 0))
    (let c4 (if (and (eq (lwlc-pass-valid? out) 1)
                         (eq (len steps) 3)) 8 0))
    (let c5 (if (eq (lwlc-pass-valid? back) 1) 16 0))
    (let c6 (if (and (eq (lwlc-exchange-valid? exchange) 1)
                         (and (node_eq (lwlc-pass-pure-source out)
                                       (lwlcw-pure))
                              (node_eq (lwlc-pass-pure-source back)
                                       (lwlcw-pure)))) 32 0))
    (let c7 (if (and (eq (lwo-active? world
                              (lwlcw-out-declaration)) 1)
                         (and (eq (lwo-active? world
                                   (lwlcw-return-declaration)) 1)
                              (eq (lwo-active? world exchange) 1))) 64 0))
    (let c8 (if (eq (lwlc-exchange-current? world exchange) 1) 128 0))
    (let c9 (if (and (eq (lwo-field-size
                              (lwlc-stack-alternatives
                                (lwlcw-out-stack))) 1)
                         (eq (lwlc-unknown?
                              (lwlc-stack-unknown
                                (lwlcw-out-stack))) 1)) 256 0))
    (let c10 (if (and (node_eq (lwlc-choice-primary choice)
                                (lwlcw-named-action "observe"))
                          (and (eq (lwo-field-size
                                    (lwlc-choice-alternatives choice)) 8)
                               (eq (lwlc-unknown?
                                    (lwlc-choice-unknown choice)) 1))) 512 0))
    (let c11 (if (and (eq (lwlc-stack-valid? empty-stack) 1)
                          (and (eq (lwlc-pass-valid? empty-pass) 1)
                               (eq (lwlc-choice-valid?
                                    (lwo-none)) 1))) 1024 0))
    (let c12 (if (and (eq (lwlc-exchange-current?
                               revoked exchange) 0)
                          (eq (lwo-world-has? revoked exchange) 1)) 2048 0))
    (let c13 (if (and (eq (oac-alternative?
                               (head (lwo-field-items
                                (lwlc-exchange-alternatives exchange)))) 1)
                          (eq (lwo-field-size
                               (lwlc-exchange-alternatives exchange)) 1)) 4096 0))
    (let c14 (if (and (not (node_eq
                                (lwlc-exchange-unknown exchange)
                                (lwo-none)))
                          (node_eq
                            (lwlc-unknown-evidence
                              (lwlc-exchange-unknown exchange))
                            (lwlcw-evidence))) 8192 0))
    (let c15 (if (and (node_eq
                           (lwlc-exchange-pure-source exchange)
                           (lwlcw-pure))
                          (and (not (node_eq
                                      (lwlc-pass-result out)
                                      (lwlcw-pure)))
                               (not (node_eq
                                      (lwlc-pass-result back)
                                      (lwlc-pass-result out))))) 16384 0))
    (lwlcw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
