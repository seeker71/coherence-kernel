; form-knowledge-heldout-v4-band.fk — the v4 sealed family's own proof.
;
; No model is admitted. Every bit is a property of the rows themselves and of
; the live training file on this host: shape, count integrity, sources on
; disk, unique identities, the seal against training data, and the honest
; nothing for an id nobody carries.
;
; PROOF LEVEL: FOURTH-ARM + GO — go answers 255 too, rust/ts 251 (witnessed 2026-09-03). This band reads the training JSONL at its
; absolute home path, a surface of the fkwu arm on this host.
; Verdict 255 (8 bits):
;   1    fkh4-count is 8 and equals (len (fkh4-rows))
;   2    every prompt and every expected answer is nonempty
;   4    every source path is on disk (file_size at least 0)
;   8    the eight ids are unique
;   16   the seal holds: no expected answer appears in the training file,
;        or that file is absent and the check reports skipped, not leakage
;   32   find-row of an absent id answers nothing, never a default row
;   64   find-row of h401 answers a well-shaped row carrying that id
;   128  the eight prompts are unique and the eight expected answers are unique
;
; preludes: learn/form-knowledge-heldout-v4.fk

(do
    (defn fkb4-bit (ok bit) (if ok bit 0))
    (defn fkb4-all-nonempty? (rows)
        (if (eq (len rows) 0) 1
            (if (and (gt (str_len (fkh4-prompt (head rows))) 0)
                     (gt (str_len (fkh4-expected (head rows))) 0))
                (fkb4-all-nonempty? (tail rows)) 0)))
    (defn fkb4-all-sources-on-disk? (rows)
        (if (eq (len rows) 0) 1
            (if (ge (file_size (fkh4-source (head rows))) 0)
                (fkb4-all-sources-on-disk? (tail rows)) 0)))
    (defn fkb4-all-shaped? (rows)
        (if (eq (len rows) 0) 1
            (if (eq (fkh4-row? (head rows)) 1)
                (fkb4-all-shaped? (tail rows)) 0)))
    (defn fkb4-count-string (x xs)
        (if (eq (len xs) 0) 0
            (add (if (str_eq x (head xs)) 1 0)
                 (fkb4-count-string x (tail xs)))))
    (defn fkb4-unique-strings? (xs)
        (if (eq (len xs) 0) 1
            (if (eq (fkb4-count-string (head xs) (tail xs)) 0)
                (fkb4-unique-strings? (tail xs)) 0)))
    (defn fkb4-field (rows at)
        (if (eq (len rows) 0) (list)
            (cons (nth (head rows) at) (fkb4-field (tail rows) at))))
    (defn form-knowledge-heldout-v4-band ()
        (do
            (let rows (fkh4-rows))
            (let found (fkh4-find-row "h401"))
            (sum (list
                (fkb4-bit (and (eq (fkh4-count) 8)
                               (eq (len rows) (fkh4-count))) 1)
                (fkb4-bit (and (eq (fkb4-all-shaped? rows) 1)
                               (eq (fkb4-all-nonempty? rows) 1)) 2)
                (fkb4-bit (eq (fkb4-all-sources-on-disk? rows) 1) 4)
                (fkb4-bit (eq (fkb4-unique-strings? (fkb4-field rows 1)) 1) 8)
                (fkb4-bit (ge (fkh4-leak-status) 1) 16)
                (fkb4-bit (nothing? (fkh4-find-row "h499")) 32)
                (fkb4-bit (and (eq (fkh4-row? found) 1)
                               (str_eq (fkh4-id found) "h401")) 64)
                (fkb4-bit (and (eq (fkb4-unique-strings?
                                       (fkb4-field rows 3)) 1)
                               (eq (fkb4-unique-strings?
                                       (fkb4-field rows 4)) 1)) 128)))))
    (form-knowledge-heldout-v4-band))
