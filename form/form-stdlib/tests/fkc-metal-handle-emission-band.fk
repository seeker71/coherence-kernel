; The standalone Form emitter must carry the same handle-shaped Metal organ as
; the source-running fkwu: correct row arities, native translations, and walker
; arms. This band does not need a GPU; it proves the emitted body's anatomy.
; preludes: form-stdlib/minimal-surface.fk form-stdlib/hati-os-kernel.fk form-stdlib/host-io-fs-fkwu-emit.fk form-stdlib/fkc-table-serialize.fk

(defn form_table_text (roots rows) "")

(do
  (defn fmhb-bit (condition bit) (if condition bit 0))
  (defn fmhb-tag-row (tag body) (head (fkc-flat (fk-node tag body) (empty))))
  (let leaf (fk-lit 7))
  (let pair (ms-intern leaf leaf))
  (let tri (ms-intern leaf pair))
  (let r-null (fmhb-tag-row 252 leaf))
  (let r-unary (fmhb-tag-row 246 leaf))
  (let r-binary (fmhb-tag-row 245 pair))
  (let r-tri (fmhb-tag-row 251 tri))
  (let decl (fkc-metal-handle-decl-text))
  (let arms (fkc-metal-handle-arms-text))
  (let full-decl (fkc-arena-decl-text))
  (let full-arms (fkc-arms-many-text))
  (let score
    (add (fmhb-bit (and (eq (nth r-null 0) 252) (eq (nth r-null 1) 0)) 1)
    (add (fmhb-bit (and (eq (nth r-unary 0) 246) (ge (nth r-unary 1) 0)) 2)
    (add (fmhb-bit (and (eq (nth r-binary 0) 245) (gt (nth r-binary 2) 0)) 4)
    (add (fmhb-bit (and (eq (nth r-tri 0) 251) (gt (nth r-tri 3) 0)) 8)
    (add (fmhb-bit (ge (str_find decl "fk_metal_pipeline_external" 0) 0) 16)
    (add (fmhb-bit (ge (str_find decl "fk_metal_status_native" 0) 0) 32)
    (add (fmhb-bit (ge (str_find arms "if (t == 245)" 0) 0) 64)
    (add (fmhb-bit (ge (str_find arms "if (t == 252)" 0) 0) 128)
    (add (fmhb-bit (ge (str_find full-decl "fk_metal_fence_wait_external" 0) 0) 256)
         (fmhb-bit (ge (str_find full-arms "fk_metal_buf_read_native" 0) 0) 512)))))))))))
  (list score (if (eq score 1023) 1 0)))
