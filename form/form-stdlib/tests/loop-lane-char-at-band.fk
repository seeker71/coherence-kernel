; loop-lane-char-at-band.fk -- a substring cut in a leaf's answer position crystallizes: char_at warms.
;
; substring (the byte-indexed cut, mode 9 of the leaf door) used to be reachable only from the walker, so char_at
; -- (substring s i (add i 1)) -- and every recipe over it stayed cold (declined -1201). substring's one meaning
; now lives in a callable C primitive (fk_substring_word), and the leaf calls it: when the cut is a leaf's TERMINAL
; answer, the door emits a C-call whose interned-string result rides back as a raw word. That is safe exactly there
; -- the interned word is stable across a pool realloc (only a byte pointer would stale), and nothing reads a held
; pointer after the answer. So a one-expression string-cut recipe (char_at, and any (substring s a b) body) is warm.
;
; Verdict 7
; PROOF LEVEL: FOURTH-ARM ONLY (crystallization is fkwu's MAP_JIT lane; a defn's native state is the 8th hot-row field)
; preludes: form-stdlib/core.fk
;
;   1   a one-expression char_at recipe (substring in answer position) reads state 1 (crystallized leaf)
;   2   it agrees with the walker's substring across indices, both edges, an out-of-range index, and a multi-byte cut
;   4   the warm run is under a walker twin's run of the same work
(do
    (defn ca-bit (ok bit) (if ok bit 0))
    (defn ca-state (name rows) (if (eq (len rows) 0) -99 (if (str_eq (nth (head rows) 1) name) (nth (head rows) 7) (ca-state name (tail rows)))))
    (defn myca (s i) (substring s i (add i 1)))                                  ; the cut IS the answer -> crystallizes
    (defn mycaw (s i) (if (lt (host_monotonic_ms) 0) "" (substring s i (add i 1)))) ; a host clock the lane declines: the twin walks
    (defn hot (s n acc) (if (le n 0) acc (hot s (sub n 1) (add acc (str_len (myca s 3))))))
    (defn hotw (s n acc) (if (le n 0) acc (hotw s (sub n 1) (add acc (str_len (mycaw s 3))))))
    (let S "hello world")
    (let heat (hot S 8000 0))
    (let st (ca-state "myca" (kernel_page_hot (host_pid) 300)))
    (let cryst-ok (eq st 1))
    ; agreement with the walker's substring: every index, both edges, out of range, and a multi-byte string's byte
    (defn ag (s i) (if (str_eq (myca s i) (substring s i (add i 1))) 1 0))
    (let U "aΩz")   ; Ω is two bytes (206 169): a byte-indexed cut of it exercises the multi-byte path
    (let ans-ok (if (eq (ag S 0) 1) (if (eq (ag S 5) 1) (if (eq (ag S 10) 1) (if (eq (ag S 11) 1)   ; 11 is one past the end -> ""
                    (if (eq (ag S 99) 1) (if (eq (ag U 1) 1) (eq (ag U 2) 1) false) false) false) false) false) false))
    (let w0 (host_monotonic_ms)) (let warm (hot S 40000 0)) (let w1 (host_monotonic_ms))
    (let k0 (host_monotonic_ms)) (let cold (hotw S 40000 0)) (let k1 (host_monotonic_ms))
    (let fast-ok (if (eq warm cold) (lt (sub w1 w0) (sub k1 k0)) false))
    (let told (print (list "state" st "cryst" cryst-ok "ans" ans-ok "fast" fast-ok "ms" (sub w1 w0) (sub k1 k0))))
    (add (ca-bit cryst-ok 1) (add (ca-bit (if cryst-ok ans-ok false) 2) (ca-bit fast-ok 4))))
