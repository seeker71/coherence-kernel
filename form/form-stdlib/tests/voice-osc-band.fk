; preludes: form-stdlib/core.fk form-stdlib/trig.fk form-stdlib/voice-formant.fk form-stdlib/voiced-reading.fk form-stdlib/word-hear.fk form-stdlib/voice-osc.fk
;
; voice-osc-band — the recurrence mouth speaks the same voice 40× cheaper, proven four-way.
;
; Measured 2026-07-30: 4800 vowel samples cost 1.64 s user through vf-sample's per-sample Taylor
; series and 0.04 s through the oscillator bank — the recurrence pays trig once per utterance.
; Wall time is the receipt's claim (a band cannot time itself); THIS band pins what has to hold
; for the speedup to be worth anything: the fast mouth is the same voice.
;
; Verdict 15 when every claim lands:
;   1   AGREEMENT, at its measured worst: max |osc − Taylor| over probe samples 0,1,7,100,477,4799
;       is 4.786e-6 (pinned ×1e9 within ±1, sample 4799 — recurrence drift grows with n and is
;       named, not hidden under a loose epsilon)
;   2   the ear cannot tell the mouths apart: the osc /e/ reads vowel-class with /e/ identity
;   4   …and the osc /a/ reads /a/ identity — the formant probe hears the same two vowels
;   8   the one-row bank is the murmur: vo-m reads nasal-class (tilt under the 80 floor)
(do
    (defn vob-d (e i) (abs (sub (nth e i) (vf-sample 165.0 500.0 900.0 2500.0 90.0 8000.0 i 12))))
    (defn vob-mx (a b) (if (gt a b) a b))
    (let e (vo-e 4800))
    (let a (vo-a 480))
    (let m (vo-m 480))
    (let dmax (vob-mx (vob-d e 0) (vob-mx (vob-d e 1) (vob-mx (vob-d e 7)
              (vob-mx (vob-d e 100) (vob-mx (vob-d e 477) (vob-d e 4799)))))))
    (let dpin (round (mul dmax 1000000000.0)))
    (let c0 (if (ge dpin 4785) (if (le dpin 4787) 1 0) 0))
    (let c1 (if (eq (wh-class e 480 8000 100 400) 2)
               (if (eq (wh-vowel-id e 480 8000 165.0) 1) 2 0) 0))
    (let c2 (if (eq (wh-vowel-id a 480 8000 165.0) 2) 4 0))
    (let c3 (if (eq (wh-class m 480 8000 100 400) 3) 8 0))
    (add c0 (add c1 (add c2 c3))))
