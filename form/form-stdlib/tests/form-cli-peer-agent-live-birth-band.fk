; form-cli-peer-agent-live-birth-band.fk — BML birth stages are separate,
; cache-addressed, and preserve nothing apart from measured zero durations.
;
; preludes: form-stdlib/form-cli-peer-native-dispatch.bml form-stdlib/bml/form-cli-peer-live-framebuffer.bml
; preludes: ../bml/form-cli-peer-agent-live.bml

(do
    (defn fcpalbb-bit (ok bit) (if ok bit 0))
    (let snapshot (fcpal-birth-snapshot "ready" 0 7 7))
    (let absent nothing)
    (let src (read_file "form/form-stdlib/bml/form-cli-peer-agent-live.bml"))
    (sum (list
        (fcpalbb-bit (eq (fcpal-birth-snapshot? snapshot) 1) 1)
        (fcpalbb-bit (and (str_eq (fcpal-birth-cache snapshot) "ready")
            (and (eq (fcpal-birth-source-context-ms snapshot) 0)
                (and (eq (fcpal-birth-native-program-ms snapshot) 7)
                     (eq (fcpal-birth-setup-ms snapshot) 7)))) 2)
        (fcpalbb-bit (eq (fcpal-birth-snapshot? absent) 0) 4)
        (fcpalbb-bit (str_eq (fcpal-resident-bml-path)
            "form/form-stdlib/bml/form-cli-peer-agent-live.bml") 8)
        (fcpalbb-bit (str_eq (fcpal-resident-cache-path)
            "form/form-stdlib/bml/form-cli-peer-agent-live.bml.fkb") 16)
        (fcpalbb-bit (str_eq (fcpal-birth-rule)
            "cache-source-context-native-program-and-prefill-are-separate-observable-stages") 32)
        (fcpalbb-bit (and (ge (str_find src "section [form.bml]" 0) 0)
            (and (ge (str_find src "resident-setup" 0) 0)
                (eq (str_find src "xtal" 0) -1))) 64)
        (fcpalbb-bit (and (ge (str_find src "resident-cache" 0) 0)
            (and (ge (str_find src "source-context-ready" 0) 0)
                (and (ge (str_find src "native-program-ready" 0) 0)
                     (ge (str_find src "prefill-ready" 0) 0)))) 128)
        (fcpalbb-bit (and (ge (str_find src "def fcpal-release" 0) 0)
            (ge (str_find src "let releaseFrame" 0) 0)) 256))))
