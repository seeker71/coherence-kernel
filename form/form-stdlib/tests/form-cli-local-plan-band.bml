; form-cli-local-plan-band.bml — the local planner's verification, with a scripted voice and no model: every
; verification rung refuses a plan that fails it with the exact failure, the failure reaches the next option, a
; repeat swerves, and only the repaired plan lands its band and its queue row.
;
; Verdict 33554431 when every claim lands:
;   1     a reply with no <plan> is refused at rung 6 (plan-unreadable); the next packet carries that exact failure
;         and the reply it refused
;   2     the same failure twice swerves: walk A's rungs read first, resume, lens (narrow), resume; walk C,
;         refused five times alike, reads first, resume, lens, lens, voice, and its fifth option asks voice-b
;   4     full 12 is refused (full) and a head declaring Verdict 7 over full 3 is refused (verdict-head), both at 6
;   8     a writable path outside form/, observe/, gate/ and learn/ that does not exist is refused at 5
;   16    a check no document can meet (head -n 1 asking two lines) is refused at 4 with its witness pair
;   32    a band that calls a definition no file defines is refused at 1 with fkwu's own words naming it
;   64    a band whose claims hold for a stub is refused at 3 with the stub's reading 3 of 3, and a band one of whose
;         claims holds under both stubs (readings [1,1], below full) is refused at 3 naming that claim's bit
;   128   the repaired plan is verified: today it reads nothing (its file is new), both stubs read 0, its band lands
;         under the landing root with its text, and one queue row lands that reads back as native-turn-run reads it,
;         with origin local-plan, the request id, 12 options and 1278 generated IDs, checks fccw finds meetable, and
;         its one definition's solofall 3 (read from the nothing-stub, with no run of its own)
;   256   walk B is declined: an id the queue holds (6), a head pin today's sort.fk does not hold (4), a band whose
;         and takes three arguments, named by the arity tool before any run (1), a band that stops on today's
;         sort-ints though every definition it names stands (1), and a band that already reads full today and
;         under a stub (2, gap-closed, band_before 1, the stub's reading 1); no row and no band land, and the
;         guide is not earned (swervecount 2 of 6: the four resumes are one approach)
;   512   the checkout is untouched: its queue reads as before, and no fixture file or band of the scenario exists
;   1024  the plan role names qwen38-q8 first and qwen38-q4 second in the model registry
;   2048  stubs stand where they must: a BML brace def, a one-line def and a new def in a class; a .fk defn whose
;         string holds ';' and '(' is cut at its own close, and a new defn stands before the final 0
;   4096  a fenced <reference> under which the band reads 0 of 3 is refused at 7 (unreachable); the reference under
;         which it reads 3 lands the row with reachable 1, and neither the row nor the landed band carries it
;   8192  a later walk of walk B's request resumes from its ledger rows: its one option is option 6, a resume
;         whose packet carries the gap-closed refusal, and the walk keeps all six findings
;   16384 observe/local-plan-run.bml {"next":1,"dry":1}, run as its own fkwu with no model, passes a closed request,
;         a doc, a two-file request, a band and a refuted request, and takes the pending single Form source; without
;         one, the doc; a moved request comes after every pending one (the doc before a moved Form source, the
;         moved one when only statements, moot and context rows stand beside it), and its packet carries the change
;         its fixborn names (commit, file, lines, the code line it wrote) with the word that the request may be healed
;   32768 a band with one ')' too many is refused at 1 before any run, naming line 9, where the stray one stands
;   65536 two definitions over sort.fk: a band that measures only sort-int-le?'s change, with no check that does,
;         is refused at 8 (definition-unmeasured:sort-str-le?) with solofall {"sort-int-le?":1,"sort-str-le?":0};
;         the same band beside a check of the text only sort-str-le?'s change writes lands, with that solofall and
;         checkfall {"sort-int-le?":0,"sort-str-le?":1} in its ledger row and queue row
;   131072 a plan with no <reference> is refused at 7 (reference-none), and the queued row reads reachable 1
;   262144 a check that holds today and on its witness but not with the reference standing (rg -c "(le a b)", which
;         the turned comparator removes) is refused at 7 (reference-check), naming what it printed and asked, and no
;         reference run follows
;   524288 a request the queue already carries is refused at 6 (row-request-taken) under a new id and band, and the
;         door, asked for that request against such a queue, says it is queued and prints no packet
;   1048576 the GPU holders of a process table: the session learning's and a LoRA lane's doors and a planner that
;         began first, in this checkout or another, and a native turn under a day turn elsewhere; never this
;         process, an ancestor, a planner that began later, a walk's coordinator (day-turn, scheduled-walk: it opens
;         no model and may be waiting for this planner's walk) or a door that opens no model; every walk door but a
;         coordinator is a GPU door; a voice held at option 2 ends its walk held, with one row and no queue change
;   2097152 a reference's delimiters are read by its own lines: a '}' closing a '(' (line 4 of 2), a '}' closing a
;         '[' past a string holding '}', an unclosed '{', a stray ')' of a .fk reference; comments and strings read
;         past; and a compiler's "line N" is quoted from the placed file it names
;   4194304 a moved request already healed is moot after one option: the voice's sort-ints band reads its full today
;         and 0 under both stubs, over sort-ints, the definition the request's fixborn stands in, so the walk ends
;         with status moot (options 1), the row reads verdict moot at rung 2 with band_before 1 and stub readings
;         [0,0], the band is kept in the option's scratch tree (its sha, its text and its defs in the witness) and no
;         queue row or band lands; written on the request's moved row the witness makes it read moot, and it stands
;         only beside its fixborn; on a row with no fixborn the door says the row does not read moot and the row stays
;         pending; on a ledger whose last line is half written it writes nothing and names the line; the same plan for
;         a request that names another file stays gap-closed, as does one whose stub still reads full
;   8388608 the approach digest hashes the approach (voice, lens, kind), never the feedback: walk B's four resumes
;         are one digest and its first option another, walk A's first four options are four digests, a digest is the
;         sha of "voice|lens|kind", the row carries the approach, and the guide packet's swervecount reads walk B as 2
;   16777216 moot is proposed only over the change's own definition: the same honest sort-ints band reads its full
;         today and 0 under both stubs, yet for a moved request whose fixborn stands in sort-str-le? and for a request
;         with no fixborn the walk ends gap-closed (the stub readings kept), no scratch tree stays, and flp-on-request?
;         reads true only for the request whose fixborn names sort-ints; the packet of the first says the change stands
;         in sort-str-le?
; preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-local-plan.bml form-stdlib/bml/findings-requests.bml form-stdlib/model-registry.bml form-stdlib/bml/live.bml
;
; PROOF LEVEL: FOURTH-ARM ONLY -- the planner verifies each plan by spawning ./fkwu on its band (host_spawn_at,
; host_alive, host_wait and host_kill are fkwu doors). The band writes only under temp_dir and removes what it made.
section [form.bml] {
 class LocalPlanBand {
  def lpb-bit(ok) = if ok then 1 else 0;
  def lpb-root(ctx) = ctx[0];
  def lpb-fresh() {
   let root = temp_dir() ++ "/local-plan-band-" ++ now_unix_ms().str();
   let made = flp-mkdirs(root ++ "/packets");
   if flp-is-dir?(root ++ "/packets") then root else nothing();
  }
  // ── the scripted voice: it keeps each packet it hears and answers the next reply of its script ──
  def lpb-say(root, walk, replies, packet, name, n) {
   let kept = write_file_text(mc-cat([root, "/packets/", walk, "-", n.str(), ".txt"]), packet);
   let named = write_file_text(mc-cat([root, "/packets/", walk, "-", n.str(), ".voice"]), name);
   ["answered", if (n <= len(replies)) then replies[(n - 1)] else "", len(packet), (100 + n)];
  }
  def lpb-voice(root, walk, replies) = (packet, name, n) => lpb-say(root, walk, replies, packet, name, n);
  def lpb-packet(root, walk, n) = fhn-read(mc-cat([root, "/packets/", walk, "-", n.str(), ".txt"]));
  def lpb-asked(root, walk, n) = fhn-read(mc-cat([root, "/packets/", walk, "-", n.str(), ".voice"]));
  def lpb-ctx(root, walk, replies, attempts) = flp-ctx(lpb-voice(root, walk, replies), ["voice-a", "voice-b"], attempts, root ++ "/queue.jsonl", root ++ "/land", root ++ "/scratch", mc-cat([root, "/ledger-", walk, ".jsonl"]), 120000);
  // ── replies ──
  def lpb-reply(plan, goal, band) = mc-cat(["<plan>\n", plan, "\n</plan>\n<goal>\n", goal, "\n</goal>\n<band>\n", band, "</band>\n"]);
  def lpb-referred(reply, reference) = mc-cat([reply, "<reference>\n", reference, "\n</reference>\n"]);
  def lpb-plan(id, band, full, writable, defs, checks) = json-emit(json-node-object([fhn-s("id", id), fhn-s("band", band), fhn-n("full", full), json-node-pair("writable", flp-json-strings(writable)), json-node-pair("sources", json-node-array([])), json-node-pair("definitions", json-node-array(defs)), json-node-pair("checks", json-node-array(checks))]));
  def lpb-def(name, params) = json-node-object([fhn-s("name", name), json-node-pair("params", flp-json-strings(params))]);
  def lpb-check(tool, args, stdout) = json-node-object([fhn-s("tool", tool), json-node-pair("arguments", flp-json-strings(args)), fhn-s("stdout", stdout)]);
  def lpb-target() = "form/form-stdlib/flp-fixture-twice.fk";
  def lpb-band() = "form/form-stdlib/tests/flp-twice-band.fk";
  def lpb-head(verdict, prelude) = mc-cat(["; flp-twice-band.fk — twice an int. 2 bits -> 3.\n; Verdict ", verdict, "\n; preludes: form-stdlib/core.fk ", prelude, "\n"]);
  def lpb-body(call) = mc-cat(["(do\n    (defn ftb-bit (ok n) (if ok n 0))\n    (defn ftb-is? (x n) (if (str_eq (value_kind x) \"int\") (eq x n) false))\n    (let small (ftb-is? (", call, " 21) 42))\n    (let signs (and (ftb-is? (", call, " 0) 0) (ftb-is? (", call, " (sub 0 4)) (sub 0 8))))\n    (add (ftb-bit small 1) (ftb-bit signs 2)))\n"]);
  def lpb-loose() = "(do\n    (defn ftb-bit (ok n) (if ok n 0))\n    (add (ftb-bit (eq 1 1) 1) (ftb-bit (eq 2 2) 2)))\n";
  def lpb-half() = "(do\n    (defn ftb-bit (ok n) (if ok n 0))\n    (defn ftb-is? (x n) (if (str_eq (value_kind x) \"int\") (eq x n) false))\n    (add (ftb-bit (eq 1 1) 1) (ftb-bit (ftb-is? (flp-twice 21) 42) 2)))\n";
  def lpb-goal() = "form/form-stdlib/flp-fixture-twice.fk is new. Write (do (defn flp-twice (n) (mul n 2)) 0): flp-twice answers twice its integer argument n.";
  def lpb-rg() = lpb-check("rg", ["-c", "-F", "(defn flp-twice", lpb-target()], "1\n");
  def lpb-twice(full, writable, checks, band) = lpb-reply(lpb-plan("flp-twice", lpb-band(), full, writable, [lpb-def("flp-twice", ["n"])], checks), lpb-goal(), band);
  def lpb-good() = lpb-twice(3, [lpb-target()], [lpb-rg()], lpb-head("3", "form-stdlib/flp-fixture-twice.fk") ++ lpb-body("flp-twice"));
  def lpb-replies-a() = [
   "I would write a band for twice.",
   "Still thinking about the band.",
   lpb-twice(12, [lpb-target()], [lpb-rg()], lpb-head("12", "form-stdlib/flp-fixture-twice.fk") ++ lpb-body("flp-twice")),
   lpb-twice(3, [lpb-target()], [lpb-rg()], lpb-head("7", "form-stdlib/flp-fixture-twice.fk") ++ lpb-body("flp-twice")),
   lpb-twice(3, ["runtime/flp-new.c"], [lpb-rg()], lpb-head("3", "runtime/flp-new.c") ++ lpb-body("flp-twice")),
   lpb-twice(3, [lpb-target()], [lpb-rg(), lpb-check("head", ["-n", "1", lpb-target()], "a\nb\n")], lpb-head("3", "form-stdlib/flp-fixture-twice.fk") ++ lpb-body("flp-twice")),
   lpb-twice(3, [lpb-target()], [lpb-rg()], lpb-head("3", "form-stdlib/flp-fixture-twice.fk") ++ lpb-body("flp-thrice")),
   lpb-twice(3, [lpb-target()], [lpb-rg()], lpb-head("3", "form-stdlib/flp-fixture-twice.fk") ++ lpb-loose()),
   lpb-twice(3, [lpb-target()], [lpb-rg()], lpb-head("3", "form-stdlib/flp-fixture-twice.fk") ++ lpb-half()),
   lpb-good(),
   lpb-referred(lpb-good(), "```\n(defn flp-twice (n) (mul n 3))\n```"),
   lpb-referred(lpb-good(), "(defn flp-twice (n) (add n n))")];
  def lpb-request-a() = parse-json("request-a", "{\"id\":\"flp-fixture-twice\",\"title\":\"twice an int\",\"problem\":\"the body has no twice\",\"needs\":\"flp-twice answers twice its argument\",\"where\":\"form/form-stdlib/flp-fixture-twice.fk\",\"files\":[\"form/form-stdlib/flp-fixture-twice.fk\"],\"evidence\":\"none\"}");
  def lpb-sorted-band(verdict) = mc-cat(["; flp-sorted-band.fk — sort-ints orders two ints. 1 bit -> 1.\n; Verdict ", verdict, "\n; preludes: form-stdlib/core.fk form-stdlib/sort.fk\n(do\n    (defn fsb-two? (xs) (if (str_eq (value_kind xs) \"list\") (if (nil? xs) false (if (nil? (tail xs)) false (and (eq (head xs) 1) (eq (nth xs 1) 2)))) false))\n    (if (fsb-two? (sort-ints (list 2 1))) 1 0))\n"]);
  def lpb-sorted-with(id, checks, band) = lpb-reply(lpb-plan(id, "form/form-stdlib/tests/flp-sorted-band.fk", 1, ["form/form-stdlib/sort.fk"], [json-node-object([fhn-s("name", "sort-ints")])], checks), "form/form-stdlib/sort.fk: sort-ints orders a list of ints.", band);
  def lpb-sorted(id, checks) = lpb-sorted-with(id, checks, lpb-sorted-band("1"));
  // a band that stops on today's sort-ints: arithmetic over a string
  def lpb-stops-band() = "; flp-sorted-band.fk — stops on today's sort-ints. 1 bit -> 1.\n; Verdict 1\n; preludes: form-stdlib/core.fk form-stdlib/sort.fk\n(do\n    (if (eq (add (head (sort-ints (list 2 1))) \"x\") 1) 1 0))\n";
  def lpb-sort-rg() = lpb-check("rg", ["-c", "-F", "(defn sort-ints", "form/form-stdlib/sort.fk"], "1\n");
  // a band whose and takes three arguments
  def lpb-arity-band() = "; flp-sorted-band.fk — three-argument and. 1 bit -> 1.\n; Verdict 1\n; preludes: form-stdlib/core.fk form-stdlib/sort.fk\n(do\n    (if (and (eq 1 1) (eq 2 2) (nil? (sort-ints (list 1)))) 1 0))\n";
  // a band that reads its full on today's files and under any stub: it measures nothing the definitions change
  def lpb-loose-band() = "; flp-sorted-band.fk — a band no stub fails. 1 bit -> 1.\n; Verdict 1\n; preludes: form-stdlib/core.fk form-stdlib/sort.fk\n(do\n    (if (eq 1 1) 1 0))\n";
  def lpb-replies-b() = [lpb-sorted("sort-home", [lpb-sort-rg()]), lpb-sorted("flp-sorted", [lpb-sort-rg(), lpb-check("head", ["-n", "1", "form/form-stdlib/sort.fk"], "; not the header\n")]), lpb-sorted-with("flp-sorted", [lpb-sort-rg()], lpb-arity-band()), lpb-sorted-with("flp-sorted", [lpb-sort-rg()], lpb-stops-band()), lpb-sorted-with("flp-sorted", [lpb-sort-rg()], lpb-loose-band())];
  // the same sorted band as walk B's honest one, for a request already healed (moot), for one that names another file, for
  // a moved request whose fixborn stands in another definition and for one with no fixborn
  def lpb-fixborn(named) = mc-cat(["{\"commit\":\"abc123def\",\"path\":\"form/form-stdlib/sort.fk\",\"needle\":\"(defn sort-ints (xs) (sort-by xs))\",\"span\":\"4-5\",\"seen\":\"6e3b5d313\",\"def\":\"", named, "\"}"]);
  def lpb-moved-request(id, named) = parse-json("request-moved", mc-cat(["{\"id\":\"", id, "\",\"title\":\"sorted ints\",\"problem\":\"none\",\"needs\":\"sort-ints\",\"where\":\"form/form-stdlib/sort.fk\",\"files\":[\"form/form-stdlib/sort.fk\"],\"evidence\":\"none\",\"status\":\"moved\",\"fixborn\":", lpb-fixborn(named), "}"]));
  def lpb-request-m() = lpb-moved-request("flp-fixture-moot", "sort-ints");
  def lpb-request-q() = lpb-moved-request("flp-fixture-otherdef", "sort-str-le?");
  def lpb-request-o() = parse-json("request-o", "{\"id\":\"flp-fixture-nofix\",\"title\":\"sorted ints\",\"problem\":\"none\",\"needs\":\"sort-ints\",\"where\":\"form/form-stdlib/sort.fk\",\"files\":[\"form/form-stdlib/sort.fk\"],\"evidence\":\"none\"}");
  def lpb-request-n() = parse-json("request-n", "{\"id\":\"flp-fixture-elsewhere\",\"title\":\"sorted ints\",\"problem\":\"none\",\"needs\":\"json\",\"where\":\"form/form-stdlib/json.fk\",\"files\":[\"form/form-stdlib/json.fk\"],\"evidence\":\"none\"}");
  def lpb-request-b() = parse-json("request-b", "{\"id\":\"flp-fixture-sorted\",\"title\":\"sorted ints\",\"problem\":\"none\",\"needs\":\"sort-ints\",\"where\":\"form/form-stdlib/sort.fk\",\"files\":[\"form/form-stdlib/sort.fk\"],\"evidence\":\"none\"}");
  def lpb-request-c() = parse-json("request-c", "{\"id\":\"flp-fixture-silent\",\"title\":\"silent\",\"files\":[]}");
  def lpb-request-e() = parse-json("request-e", "{\"id\":\"flp-fixture-balance\",\"title\":\"twice, unbalanced\",\"files\":[\"form/form-stdlib/flp-fixture-twice.fk\"]}");
  // the good band with one ')' too many on its last line, line 9
  def lpb-unbalanced() = lpb-reply(lpb-plan("flp-twice-e", "form/form-stdlib/tests/flp-twice-e-band.fk", 3, [lpb-target()], [lpb-def("flp-twice", ["n"])], [lpb-rg()]), lpb-goal(), lpb-head("3", "form-stdlib/flp-fixture-twice.fk") ++ substring(lpb-body("flp-twice"), 0, (len(lpb-body("flp-twice")) - 1)) ++ ")\n");
  // two comparators of sort.fk turned: sort-int-le? answers (ge a b), sort-str-le? (sort-str-le-at b a 0); strs is
  // the second claim's call, and the reference's second definition is given whole
  def lpb-pair-band(strs) = mc-cat(["; flp-pair-band.fk — two comparators of sort.fk. 2 bits -> 3.\n; Verdict 3\n; preludes: form-stdlib/core.fk form-stdlib/sort.fk\n(do\n    (defn fpb-bit (ok n) (if ok n 0))\n    (defn fpb-yes? (x) (if (str_eq (value_kind x) \"int\") (eq x 1) false))\n    (let ints (fpb-yes? (sort-int-le? 2 1)))\n    (let strs (fpb-yes? ", strs, "))\n    (add (fpb-bit ints 1) (fpb-bit strs 2)))\n"]);
  def lpb-pair-rg() = lpb-check("rg", ["-c", "-F", "(defn sort-int-le?", "form/form-stdlib/sort.fk"], "1\n");
  def lpb-pair(checks, strs, second) = lpb-referred(lpb-reply(lpb-plan("flp-pair", "form/form-stdlib/tests/flp-pair-band.fk", 3, ["form/form-stdlib/sort.fk"], [json-node-object([fhn-s("name", "sort-int-le?")]), json-node-object([fhn-s("name", "sort-str-le?")])], checks), "form/form-stdlib/sort.fk: sort-int-le? answers (ge a b), and sort-str-le? answers (sort-str-le-at b a 0): both comparators turn.", lpb-pair-band(strs)), mc-cat(["(defn sort-int-le? (a b) (ge a b))\n", second]));
  def lpb-replies-p() = [
   lpb-pair([lpb-pair-rg()], "(sort-str-le? \"a\" \"b\")", "(defn sort-str-le? (a b) (sort-str-le-at a b 0))"),
   lpb-pair([lpb-pair-rg(), lpb-check("rg", ["-c", "-F", "(le a b)", "form/form-stdlib/sort.fk"], "1\n")], "(sort-str-le? \"b\" \"a\")", "(defn sort-str-le? (a b) (sort-str-le-at b a 0))"),
   lpb-pair([lpb-pair-rg(), lpb-check("rg", ["-c", "-F", "(sort-str-le-at b a 0)", "form/form-stdlib/sort.fk"], "1\n")], "(sort-str-le? \"a\" \"a\")", "(defn sort-str-le? (a b) (sort-str-le-at b a 0))")];
  def lpb-request-p() = parse-json("request-p", "{\"id\":\"flp-fixture-pair\",\"title\":\"two comparators\",\"files\":[\"form/form-stdlib/sort.fk\"]}");
  // walk A's request again, under a new id and band
  def lpb-again() = lpb-referred(lpb-reply(lpb-plan("flp-twice-f", "form/form-stdlib/tests/flp-twice-f-band.fk", 3, [lpb-target()], [lpb-def("flp-twice", ["n"])], [lpb-rg()]), lpb-goal(), lpb-head("3", "form-stdlib/flp-fixture-twice.fk") ++ lpb-body("flp-twice")), "(defn flp-twice (n) (add n n))");
  // a voice whose second option finds the GPU held
  def lpb-held-say(root, packet, n) {
   let kept = write_file_text(mc-cat([root, "/packets/g-", n.str(), ".txt"]), packet);
   if (n <= 1) then ["answered", "no plan here", len(packet), 101] else ["held", "[local-plan:yield] observe/native-lora-train-run.fk (pid 7) in /x still holds the GPU; no model opens", 0, 0];
  }
  def lpb-held-ctx(root) = flp-ctx((packet, name, n) => lpb-held-say(root, packet, n), ["voice-a", "voice-b"], 3, root ++ "/queue.jsonl", root ++ "/land", root ++ "/scratch", root ++ "/ledger-g.jsonl", 120000);
  // ── the scenario: the walks over a copy of the queue, under temp_dir ──
  def lpb-lines(root) = len(flp-queue-lines(root ++ "/queue.jsonl"));
  def lpb-run(root) {
   let queue = fhn-read(flp-queue());
   let seeded = write_file_text(root ++ "/queue.jsonl", queue);
   let lines0 = lpb-lines(root);
   let a = flp-walk(lpb-request-a(), lpb-ctx(root, "a", lpb-replies-a(), 12));
   let lines1 = lpb-lines(root);
   let b = flp-walk(lpb-request-b(), lpb-ctx(root, "b", lpb-replies-b(), 5));
   let lines2 = lpb-lines(root);
   let c = flp-walk(lpb-request-c(), lpb-ctx(root, "c", ["no", "no", "no", "no", "no"], 5));
   let d = flp-walk-from(lpb-request-b(), lpb-ctx(root, "d", ["no", "no", "no", "no", "no", "no"], 1), flp-memory-of(flp-queue-rows(root ++ "/ledger-b.jsonl"), "flp-fixture-sorted", p => fhn-read(p)));
   let e = flp-walk(lpb-request-e(), lpb-ctx(root, "e", [lpb-unbalanced()], 1));
   let f = flp-walk(lpb-request-a(), lpb-ctx(root, "f", [lpb-again()], 1));
   let lines3 = lpb-lines(root);
   let p = flp-walk(lpb-request-p(), lpb-ctx(root, "p", lpb-replies-p(), 3));
   let lines4 = lpb-lines(root);
   let g = flp-walk(lpb-request-c(), lpb-held-ctx(root));
   let lines5 = lpb-lines(root);
   let m = flp-walk(lpb-request-m(), lpb-ctx(root, "m", [lpb-sorted("flp-sorted-m", [lpb-sort-rg()])], 3));
   let n = flp-walk(lpb-request-n(), lpb-ctx(root, "n", [lpb-sorted("flp-sorted-n", [lpb-sort-rg()])], 1));
