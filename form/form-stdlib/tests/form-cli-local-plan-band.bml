; form-cli-local-plan-band.bml — the local planner's verification, with a scripted voice and no model: every
; verification rung refuses a plan that fails it with the exact failure, the failure reaches the next option, a
; repeat swerves, and only the repaired plan lands its band and its queue row.
;
; Verdict 32767 when every claim lands:
;   1     a reply with no <plan> is refused at rung 6 (plan-unreadable); the next packet carries that exact failure
;         and the reply it refused
;   2     the same failure twice swerves: walk A's rungs read first, local-guide, lens (narrow), local-guide; walk C,
;         refused five times alike, reads first, local-guide, lens, lens, voice, and its fifth option asks voice-b
;   4     full 12 is refused (full) and a head declaring Verdict 7 over full 3 is refused (verdict-head), both at 6
;   8     a writable path outside form/, observe/, gate/ and learn/ that does not exist is refused at 5
;   16    a check no document can meet (head -n 1 asking two lines) is refused at 4 with its witness pair
;   32    a band that calls a definition no file defines is refused at 1 with fkwu's own words naming it
;   64    a band whose claims hold for a stub is refused at 3 with the stub's reading 3 of 3, and a band one of whose
;         claims holds under both stubs (readings [1,1], below full) is refused at 3 naming that claim's bit
;   128   the repaired plan is verified: today it reads nothing (its file is new), both stubs read 0, its band lands
;         under the landing root with its text, and one queue row lands that reads back as native-turn-run reads it,
;         with origin local-plan, the request id, 11 options and 1166 generated IDs, and checks fccw finds meetable
;   256   walk B is declined: an id the queue holds (6), a head pin today's sort.fk does not hold (4), a band that
;         stops on today's sort-ints though every definition it names stands (1), and a band that already reads full
;         today (2, band_before 1); no row and no band land, and the guide is not earned
;   512   the checkout is untouched: its queue reads as before, and no fixture file or band of the scenario exists
;   1024  the plan role names qwen38-q8 first and qwen38-q4 second in the model registry
;   2048  stubs stand where they must: a BML brace def, a one-line def and a new def in a class; a .fk defn whose
;         string holds ';' and '(' is cut at its own close, and a new defn stands before the final 0
;   4096  a fenced <reference> under which the band reads 0 of 3 is refused at 7 (unreachable); the reference under
;         which it reads 3 lands the row with reachable 1, and neither the row nor the landed band carries it
;   8192  a later walk of walk B's request resumes from its ledger rows: its one option is option 5, a local guide
;         whose packet carries the gap-closed refusal, and the walk keeps all five findings
;   16384 observe/local-plan-run.bml {"next":1,"dry":1}, run as its own fkwu with no model, passes a closed request,
;         a doc, a two-file request and a band, and takes the pending single Form source; without one, the doc
; preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-local-plan.bml form-stdlib/model-registry.bml form-stdlib/bml/live.bml
;
; PROOF LEVEL: FOURTH-ARM ONLY -- the planner verifies each plan by spawning ./fkwu on its band (host_spawn_at,
; host_alive, host_wait and host_kill are fkwu doors). The band writes only under temp_dir and removes what it made.
section [form.bml] {
 class LocalPlanBand {
  def lpb-bit(ok) = if ok then 1 else 0;
  def lpb-root(ctx) = ctx[0];
  def lpb-fresh() {
   let root = temp_dir() ++ "/local-plan-band-" ++ now_unix_ms().str();
   let made = flp-mkdirs(root ++ "/packets");
   if flp-is-dir?(root ++ "/packets") then root else nothing();
  }
  // ── the scripted voice: it keeps each packet it hears and answers the next reply of its script ──
  def lpb-say(root, walk, replies, packet, name, n) {
   let kept = write_file_text(mc-cat([root, "/packets/", walk, "-", n.str(), ".txt"]), packet);
   let named = write_file_text(mc-cat([root, "/packets/", walk, "-", n.str(), ".voice"]), name);
   ["answered", if (n <= len(replies)) then replies[(n - 1)] else "", len(packet), (100 + n)];
  }
  def lpb-voice(root, walk, replies) = (packet, name, n) => lpb-say(root, walk, replies, packet, name, n);
  def lpb-packet(root, walk, n) = fhn-read(mc-cat([root, "/packets/", walk, "-", n.str(), ".txt"]));
  def lpb-asked(root, walk, n) = fhn-read(mc-cat([root, "/packets/", walk, "-", n.str(), ".voice"]));
  def lpb-ctx(root, walk, replies, attempts) = flp-ctx(lpb-voice(root, walk, replies), ["voice-a", "voice-b"], attempts, root ++ "/queue.jsonl", root ++ "/land", root ++ "/scratch", mc-cat([root, "/ledger-", walk, ".jsonl"]), 120000);
  // ── replies ──
  def lpb-reply(plan, goal, band) = mc-cat(["<plan>\n", plan, "\n</plan>\n<goal>\n", goal, "\n</goal>\n<band>\n", band, "</band>\n"]);
  def lpb-referred(reply, reference) = mc-cat([reply, "<reference>\n", reference, "\n</reference>\n"]);
  def lpb-plan(id, band, full, writable, defs, checks) = json-emit(json-node-object([fhn-s("id", id), fhn-s("band", band), fhn-n("full", full), json-node-pair("writable", flp-json-strings(writable)), json-node-pair("sources", json-node-array([])), json-node-pair("definitions", json-node-array(defs)), json-node-pair("checks", json-node-array(checks))]));
  def lpb-def(name, params) = json-node-object([fhn-s("name", name), json-node-pair("params", flp-json-strings(params))]);
  def lpb-check(tool, args, stdout) = json-node-object([fhn-s("tool", tool), json-node-pair("arguments", flp-json-strings(args)), fhn-s("stdout", stdout)]);
  def lpb-target() = "form/form-stdlib/flp-fixture-twice.fk";
  def lpb-band() = "form/form-stdlib/tests/flp-twice-band.fk";
  def lpb-head(verdict, prelude) = mc-cat(["; flp-twice-band.fk — twice an int. 2 bits -> 3.\n; Verdict ", verdict, "\n; preludes: form-stdlib/core.fk ", prelude, "\n"]);
  def lpb-body(call) = mc-cat(["(do\n    (defn ftb-bit (ok n) (if ok n 0))\n    (defn ftb-is? (x n) (if (str_eq (value_kind x) \"int\") (eq x n) false))\n    (let small (ftb-is? (", call, " 21) 42))\n    (let signs (and (ftb-is? (", call, " 0) 0) (ftb-is? (", call, " (sub 0 4)) (sub 0 8))))\n    (add (ftb-bit small 1) (ftb-bit signs 2)))\n"]);
  def lpb-loose() = "(do\n    (defn ftb-bit (ok n) (if ok n 0))\n    (add (ftb-bit (eq 1 1) 1) (ftb-bit (eq 2 2) 2)))\n";
  def lpb-half() = "(do\n    (defn ftb-bit (ok n) (if ok n 0))\n    (defn ftb-is? (x n) (if (str_eq (value_kind x) \"int\") (eq x n) false))\n    (add (ftb-bit (eq 1 1) 1) (ftb-bit (ftb-is? (flp-twice 21) 42) 2)))\n";
  def lpb-goal() = "form/form-stdlib/flp-fixture-twice.fk is new. Write (do (defn flp-twice (n) (mul n 2)) 0): flp-twice answers twice its integer argument n.";
  def lpb-rg() = lpb-check("rg", ["-c", "-F", "(defn flp-twice", lpb-target()], "1\n");
  def lpb-twice(full, writable, checks, band) = lpb-reply(lpb-plan("flp-twice", lpb-band(), full, writable, [lpb-def("flp-twice", ["n"])], checks), lpb-goal(), band);
  def lpb-good() = lpb-twice(3, [lpb-target()], [lpb-rg()], lpb-head("3", "form-stdlib/flp-fixture-twice.fk") ++ lpb-body("flp-twice"));
  def lpb-replies-a() = [
   "I would write a band for twice.",
   "Still thinking about the band.",
   lpb-twice(12, [lpb-target()], [lpb-rg()], lpb-head("12", "form-stdlib/flp-fixture-twice.fk") ++ lpb-body("flp-twice")),
   lpb-twice(3, [lpb-target()], [lpb-rg()], lpb-head("7", "form-stdlib/flp-fixture-twice.fk") ++ lpb-body("flp-twice")),
   lpb-twice(3, ["runtime/flp-new.c"], [lpb-rg()], lpb-head("3", "runtime/flp-new.c") ++ lpb-body("flp-twice")),
   lpb-twice(3, [lpb-target()], [lpb-rg(), lpb-check("head", ["-n", "1", lpb-target()], "a\nb\n")], lpb-head("3", "form-stdlib/flp-fixture-twice.fk") ++ lpb-body("flp-twice")),
   lpb-twice(3, [lpb-target()], [lpb-rg()], lpb-head("3", "form-stdlib/flp-fixture-twice.fk") ++ lpb-body("flp-thrice")),
   lpb-twice(3, [lpb-target()], [lpb-rg()], lpb-head("3", "form-stdlib/flp-fixture-twice.fk") ++ lpb-loose()),
   lpb-twice(3, [lpb-target()], [lpb-rg()], lpb-head("3", "form-stdlib/flp-fixture-twice.fk") ++ lpb-half()),
   lpb-referred(lpb-good(), "```\n(defn flp-twice (n) (mul n 3))\n```"),
   lpb-referred(lpb-good(), "(defn flp-twice (n) (add n n))")];
  def lpb-request-a() = parse-json("request-a", "{\"id\":\"flp-fixture-twice\",\"title\":\"twice an int\",\"problem\":\"the body has no twice\",\"needs\":\"flp-twice answers twice its argument\",\"where\":\"form/form-stdlib/flp-fixture-twice.fk\",\"files\":[\"form/form-stdlib/flp-fixture-twice.fk\"],\"evidence\":\"none\"}");
  def lpb-sorted-band(verdict) = mc-cat(["; flp-sorted-band.fk — sort-ints orders two ints. 1 bit -> 1.\n; Verdict ", verdict, "\n; preludes: form-stdlib/core.fk form-stdlib/sort.fk\n(do\n    (defn fsb-two? (xs) (if (str_eq (value_kind xs) \"list\") (if (nil? xs) false (if (nil? (tail xs)) false (and (eq (head xs) 1) (eq (nth xs 1) 2)))) false))\n    (if (fsb-two? (sort-ints (list 2 1))) 1 0))\n"]);
  def lpb-sorted-with(id, checks, band) = lpb-reply(lpb-plan(id, "form/form-stdlib/tests/flp-sorted-band.fk", 1, ["form/form-stdlib/sort.fk"], [json-node-object([fhn-s("name", "sort-ints")])], checks), "form/form-stdlib/sort.fk: sort-ints orders a list of ints.", band);
  def lpb-sorted(id, checks) = lpb-sorted-with(id, checks, lpb-sorted-band("1"));
  // a band that stops on today's sort-ints: arithmetic over a string
  def lpb-stops-band() = "; flp-sorted-band.fk — stops on today's sort-ints. 1 bit -> 1.\n; Verdict 1\n; preludes: form-stdlib/core.fk form-stdlib/sort.fk\n(do\n    (if (eq (add (head (sort-ints (list 2 1))) \"x\") 1) 1 0))\n";
  def lpb-sort-rg() = lpb-check("rg", ["-c", "-F", "(defn sort-ints", "form/form-stdlib/sort.fk"], "1\n");
  def lpb-replies-b() = [lpb-sorted("sort-home", [lpb-sort-rg()]), lpb-sorted("flp-sorted", [lpb-sort-rg(), lpb-check("head", ["-n", "1", "form/form-stdlib/sort.fk"], "; not the header\n")]), lpb-sorted-with("flp-sorted", [lpb-sort-rg()], lpb-stops-band()), lpb-sorted("flp-sorted", [lpb-sort-rg()])];
  def lpb-request-b() = parse-json("request-b", "{\"id\":\"flp-fixture-sorted\",\"title\":\"sorted ints\",\"problem\":\"none\",\"needs\":\"sort-ints\",\"where\":\"form/form-stdlib/sort.fk\",\"files\":[\"form/form-stdlib/sort.fk\"],\"evidence\":\"none\"}");
  def lpb-request-c() = parse-json("request-c", "{\"id\":\"flp-fixture-silent\",\"title\":\"silent\",\"files\":[]}");
  // ── the scenario: three walks over a copy of the queue, under temp_dir ──
  def lpb-run(root) {
   let queue = fhn-read(flp-queue());
   let seeded = write_file_text(root ++ "/queue.jsonl", queue);
   let lines0 = len(flp-queue-lines(root ++ "/queue.jsonl"));
   let a = flp-walk(lpb-request-a(), lpb-ctx(root, "a", lpb-replies-a(), 11));
   let lines1 = len(flp-queue-lines(root ++ "/queue.jsonl"));
   let b = flp-walk(lpb-request-b(), lpb-ctx(root, "b", lpb-replies-b(), 4));
   let lines2 = len(flp-queue-lines(root ++ "/queue.jsonl"));
   let c = flp-walk(lpb-request-c(), lpb-ctx(root, "c", ["no", "no", "no", "no", "no"], 5));
   let d = flp-walk-from(lpb-request-b(), lpb-ctx(root, "d", ["no", "no", "no", "no", "no"], 1), flp-memory-of(flp-queue-rows(root ++ "/ledger-b.jsonl"), "flp-fixture-sorted", p => fhn-read(p)));
   [root, a, b, c, [lines0, lines1, lines2], queue, d];
  }
  def lpb-rows(ctx, walk) = flp-queue-rows(mc-cat([lpb-root(ctx), "/ledger-", walk, ".jsonl"]));
  def lpb-row(ctx, walk, n) = lpb-rows(ctx, walk)[(n - 1)];
  def lpb-s(row, key) = fcgp-str(row, key);
  def lpb-n(row, key) = fcgp-num(row, key);
  def lpb-is(row, rung, kind) = ((Comparable) (lpb-n(row, "verify_rung") ?? -1) == rung) && ((String) lpb-s(row, "kind") == kind);
  def lpb-kind-starts(row, rung, kind) = ((Comparable) (lpb-n(row, "verify_rung") ?? -1) == rung) && flp-starts?(lpb-s(row, "kind"), kind);
  def lpb-ways(ctx, walk) = map(r => mc-cat([lpb-s(r, "rung"), "/", lpb-s(r, "lens"), "/", lpb-s(r, "voice")]), lpb-rows(ctx, walk));
  // ── claims ──
  def lpb-unreadable(ctx) {
   let r1 = lpb-row(ctx, "a", 1);
   let p2 = lpb-packet(lpb-root(ctx), "a", 2);
   lpb-bit(lpb-is(r1, 6, "plan-unreadable") && (str_find(p2, "The reply has no <plan>...</plan> block.", 0) >= 0) && (str_find(p2, "I would write a band for twice.", 0) >= 0) && (str_find(lpb-packet(lpb-root(ctx), "a", 1), "Your previous plan", 0) < 0));
  }
  def lpb-swerves(ctx) {
   let a = take(4, lpb-ways(ctx, "a"));
   let c = lpb-ways(ctx, "c");
   lpb-bit((a == ["first/band-first/voice-a", "local-guide/band-first/voice-a", "lens/narrow/voice-a", "local-guide/narrow/voice-a"]) && (c == ["first/band-first/voice-a", "local-guide/band-first/voice-a", "lens/narrow/voice-a", "lens/edit/voice-a", "voice/band-first/voice-b"]) && ((String) lpb-asked(lpb-root(ctx), "c", 5) == "voice-b") && (str_find(lpb-packet(lpb-root(ctx), "a", 3), "Lens: narrow.", 0) >= 0));
  }
  def lpb-shape(ctx) = lpb-bit(lpb-is(lpb-row(ctx, "a", 3), 6, "full") && lpb-is(lpb-row(ctx, "a", 4), 6, "verdict-head"));
  def lpb-paths(ctx) = lpb-bit(lpb-is(lpb-row(ctx, "a", 5), 5, "writable-path:runtime/flp-new.c"));
  def lpb-checks(ctx) {
   let r = lpb-row(ctx, "a", 6);
   lpb-bit(lpb-kind-starts(r, 4, "check-unmeetable:") && (str_find(lpb-s(r, "failure"), "can never hold", 0) >= 0) && (str_find(lpb-s(r, "failure"), "where it asks \"a\\nb\\n\"", 0) >= 0));
  }
  def lpb-compiles(ctx) {
   let r = lpb-row(ctx, "a", 7);
   lpb-bit(lpb-is(r, 1, "band-no-number:nothing") && (str_find(lpb-s(r, "failure"), "flp-thrice", 0) >= 0) && nothing?(lpb-n(r, "band_before")));
  }
  def lpb-stubbed(ctx) {
   let r = lpb-row(ctx, "a", 8);
   let half = lpb-row(ctx, "a", 9);
   lpb-bit(lpb-is(r, 3, "band-full-under-stub:nothing") && ((String) json-emit(json-object-get(r, "stub_readings")) == "[3]")
    && lpb-is(half, 3, "claim-holds-under-stubs:1") && ((String) json-emit(json-object-get(half, "stub_readings")) == "[1,1]"));
  }
  def lpb-reachable(ctx) {
   let wrong = lpb-row(ctx, "a", 10);
   let right = lpb-row(ctx, "a", 11);
   let line = flp-queue-lines(lpb-root(ctx) ++ "/queue.jsonl")[(ctx[4][1] - 1)];
   let row = parse-json("queued", line);
   lpb-bit(lpb-is(wrong, 7, "unreachable") && ((Comparable) (lpb-n(wrong, "reference_reading") ?? -1) == 0) && (str_find(lpb-s(wrong, "failure"), "reads 0 of 3", 0) >= 0)
    && ((Comparable) (lpb-n(right, "reference_reading") ?? -1) == 3) && ((Comparable) (lpb-n(row, "reachable") ?? 0) == 1)
    && (str_find(line, "add n n", 0) < 0) && (str_find(fhn-read(lpb-root(ctx) ++ "/land/" ++ lpb-band()), "add n n", 0) < 0));
  }
  // a later walk of walk B's request resumes from its ledger: option 4 hears the gap-closed refusal
  def lpb-resumes(ctx) {
   let d = ctx[6];
   let rows = lpb-rows(ctx, "d");
   lpb-bit(((String) d[0] == "declined") && ((Comparable) len(d[2]) == 5) && ((Comparable) len(rows) == 1) && ((Comparable) (lpb-n(rows[0], "option") ?? 0) == 5)
    && ((String) lpb-s(rows[0], "rung") == "local-guide") && (str_find(lpb-packet(lpb-root(ctx), "d", 5), "On today's files the band already reads its full 1", 0) >= 0));
  }
  def lpb-queued(ctx) {
   let a = ctx[1];
   let r = lpb-row(ctx, "a", 11);
   let line = flp-queue-lines(lpb-root(ctx) ++ "/queue.jsonl")[(ctx[4][1] - 1)];
   let row = parse-json("queued", line);
   let landed = lpb-root(ctx) ++ "/land/" ++ lpb-band();
   let docs = map(p => [p, p, fhn-read(p)], flp-strs(row, "writable"));
   lpb-bit(((String) a[0] == "queued") && lpb-is(r, 0, "") && nothing?(lpb-n(r, "band_before")) && ((String) json-emit(json-object-get(r, "stub_readings")) == "[0,0]")
    && ((String) fhn-read(landed) == lpb-head("3", "form-stdlib/flp-fixture-twice.fk") ++ lpb-body("flp-twice")) &&((Comparable) ctx[4][1] == (ctx[4][0] + 1))
    && ((String) lpb-s(row, "origin") == "local-plan") && ((String) lpb-s(row, "request") == "flp-fixture-twice") && ((String) lpb-s(row, "id") == "flp-twice") && ((Comparable) (lpb-n(row, "plan_options") ?? 0) == 11)
    && ((Comparable) (lpb-n(row, "plan_local_generated_ids") ?? 0) == 1166) && ((lpb-n(row, "plan_local_injected_ids") ?? 0) > 0) && ((String) lpb-s(row, "document_context") == "catalog")
    && ((Comparable) (lpb-n(row, "full") ?? 0) == 3) && (flp-strs(row, "writable") == [lpb-target()]) && (!fccw-refused?(fccw-rehearse(row, docs))));
  }
  def lpb-declined(ctx) {
   let b = ctx[2];
   let rows = lpb-rows(ctx, "b");
   lpb-bit(((String) b[0] == "declined") && lpb-is(rows[0], 6, "row-id-taken:sort-home") && lpb-kind-starts(rows[1], 4, "check-pin:") && lpb-is(rows[2], 1, "band-no-number:today") && (str_find(lpb-s(rows[2], "failure"), "today's included", 0) >= 0)
    && lpb-is(rows[3], 2, "gap-closed") && ((Comparable) (lpb-n(rows[3], "band_before") ?? 0) == 1)
    && ((Comparable) ctx[4][2] == ctx[4][1]) && (!flp-exists?(lpb-root(ctx) ++ "/land/form/form-stdlib/tests/flp-sorted-band.fk")) && ((Comparable) (fcgp-num(b[3], "earned") ?? -1) == 0) && ((String) fcgp-str(b[3], "why") == "swervecount 4 of 6") && ((String) b[4] == ""));
  }
  def lpb-untouched(ctx) = lpb-bit(((String) fhn-read(flp-queue()) == ctx[5]) && (!flp-exists?(lpb-target())) && (!flp-exists?(lpb-band())) && (!flp-exists?("form/form-stdlib/tests/flp-sorted-band.fk")));
  def lpb-role(ctx) = lpb-bit(mr-chain-names("plan") == ["qwen38-q8", "qwen38-q4"]);
  // ── the door's choice of the next request, read from its dry packet line ──
  def lpb-req(id, status, files) = json-emit(json-node-object([fhn-s("id", id), fhn-s("title", "a fixture request"), fhn-s("status", status), json-node-pair("files", flp-json-strings(files))]));
  def lpb-door(root, name, lines) {
   let reqs = mc-cat([root, "/", name, ".jsonl"]);
   let wrote = write_file_text(reqs, flp-join(lines, "\n") ++ "\n");
   let input = mc-cat([root, "/", name, ".in"]);
   let asked = write_file_text(input, json-emit(json-node-object([fhn-s("requests", reqs), fhn-n("next", 1), fhn-n("dry", 1)])) ++ "\n");
   let out = mc-cat([root, "/", name, ".out"]);
   let pid = host_spawn_at(["./fkwu", "observe/local-plan-run.bml"], [input, out, out ++ ".err"]);
   let waited = if (pid <= 0) then [nothing(), 0] else flp-wait(pid, (host_monotonic_ms() + 600000));
   flp-first(flp-lines(fhn-read(out)), l => flp-starts?(l, "[local-plan:dry] request ")) ?? "";
  }
  def lpb-picks(ctx) {
   let closed = lpb-req("zz-closed", "closed", ["form/form-stdlib/sort.fk"]);
   let doc = lpb-req("zz-doc", "pending", ["docs/form-native-coding.md"]);
   let two = lpb-req("zz-two", "pending", ["form/form-stdlib/sort.fk", "form/form-stdlib/core.fk"]);
   let measure = lpb-req("zz-band", "pending", ["form/form-stdlib/tests/sort-band.fk"]);
   let form = lpb-req("zz-form", "pending", ["form/form-stdlib/sort.fk"]);
   let first = lpb-door(lpb-root(ctx), "picks-a", [closed, doc, two, measure, form]);
   let second = lpb-door(lpb-root(ctx), "picks-b", [closed, two, doc]);
   lpb-bit(flp-starts?(first, "[local-plan:dry] request zz-form voices ") && flp-starts?(second, "[local-plan:dry] request zz-doc voices "));
  }
  // ── stubs, read on text alone ──
  def lpb-bml-text() = "section [form.bml] {\n class T {\n  def a(x) = x + 1;\n  def b(p: List, q) {\n   let y = p;\n   y;\n  }\n  // c follows\n  def c() = 3;\n }\n 0;\n}\n";
  def lpb-fk-text() = "(do\n    (defn cl-x (s at) (if (eq (str_find s \"; (unit\" at) at) 1 0))\n    (defn other () 2)\n    0)\n";
  def lpb-sites(ctx) {
   let b = flp-stub-def(lpb-bml-text(), ["b", nothing(), "t.bml"], true, "nothing");
   let a = flp-stub-def(lpb-bml-text(), ["a", nothing(), "t.bml"], true, "echo");
   let z = flp-stub-def(lpb-bml-text(), ["z", ["m", "n"], "t.bml"], true, "echo");
   let x = flp-stub-def(lpb-fk-text(), ["cl-x", nothing(), "t.fk"], false, "nothing");
   let w = flp-stub-def(lpb-fk-text(), ["w", ["a", "b"], "t.fk"], false, "echo");
   lpb-bit(((String) b == "section [form.bml] {\n class T {\n  def a(x) = x + 1;\n  def b(p: List, q) = nothing();\n  // c follows\n  def c() = 3;\n }\n 0;\n}\n")
    && ((String) a == "section [form.bml] {\n class T {\n  def a(x) = x;\n  def b(p: List, q) {\n   let y = p;\n   y;\n  }\n  // c follows\n  def c() = 3;\n }\n 0;\n}\n")
    && ((String) z == "section [form.bml] {\n class T {\n  def z(m, n) = m;\n  def a(x) = x + 1;\n  def b(p: List, q) {\n   let y = p;\n   y;\n  }\n  // c follows\n  def c() = 3;\n }\n 0;\n}\n")
    && ((String) x == "(do\n    (defn cl-x (s at) (nothing))\n    (defn other () 2)\n    0)\n")
    && ((String) w == "(do\n    (defn cl-x (s at) (if (eq (str_find s \"; (unit\" at) at) 1 0))\n    (defn other () 2)\n    (defn w (a b) a)\n    0)\n"));
  }
 }
 let root = lpb-fresh();
 nothing?(root) ? form_error("local-plan band needs a fresh directory under temp_dir") : 0;
 let ctx = lpb-run(root);
 let verdict = live-claims("local-plan-band", ctx, [["unreadable", 1, 1, lpb-unreadable], ["swerves", 2, 1, lpb-swerves], ["shape", 4, 1, lpb-shape], ["paths", 8, 1, lpb-paths], ["checks", 16, 1, lpb-checks], ["compiles", 32, 1, lpb-compiles], ["stubbed", 64, 1, lpb-stubbed], ["queued", 128, 1, lpb-queued], ["declined", 256, 1, lpb-declined], ["untouched", 512, 1, lpb-untouched], ["role", 1024, 1, lpb-role], ["sites", 2048, 1, lpb-sites], ["reachable", 4096, 1, lpb-reachable], ["resumes", 8192, 1, lpb-resumes], ["picks", 16384, 1, lpb-picks]]);
 host_dir_rmdir(root);
 verdict;
}
