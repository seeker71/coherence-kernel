    && (str_find(flp-result-line(lpb-request-m(), m), "\"status\":\"moot\",\"options\":1,", 0) >= 0)
    && ((Value) flp-strs(w, "defs") == ["form/form-stdlib/sort.fk:sort-ints"]) && ((String) lpb-s(w, "band_text") == kept)
    && frq-moot-stands?(frq-put(lpb-moved-row("flp-fixture-moot", "sort-ints"), "moot", w)) && (!frq-moot-stands?(json-node-object([json-node-pair("moot", w)])))
    && (str_find(said, "the row reads moot", 0) >= 0) && ((String) frq-text(frq-rows(ledger)[0], "status") == "moot")
    && (str_find(unproved, "the row does not read moot", 0) >= 0) && ((String) frq-text(frq-rows(bare)[0], "status") == "pending") && node_eq(frq-get(frq-rows(bare)[0], "moot"), json-node-null())
    && (str_find(untouched, "line 2 of the requests file is not whole; nothing is written", 0) >= 0) && ((String) fhn-read(torn) == (frq-lines([lpb-moved-row("flp-fixture-moot", "sort-ints")]) ++ "{\"id\":\"frq-trunc\",\"origin\":\"x/u/iss"))
    && ((String) n[0] == "declined") && lpb-is(rn, 2, "gap-closed") && ((String) json-emit(json-object-get(rn, "stub_readings")) == "[0,0]") && ((String) lpb-s(rn, "verdict") == "refused") && ((String) lpb-s(rn, "scratch") == ""));
  }
  // the row of a moved request: its fixborn names the definition the change stands in
  def lpb-moved-row(id, named) = json-node-object([fhn-s("id", id), fhn-s("needs", "sort-ints"), frq-strs("files", ["form/form-stdlib/sort.fk"]), fhn-s("status", "moved"), json-node-pair("fixborn", parse-json("fixborn", lpb-fixborn(named))), json-node-pair("answers", json-node-array([]))]);
  // a band over a definition the request's change does not stand in, or a request with no fixborn, ends gap-closed
  def lpb-proposed(ctx) {
   let o = ctx[13];
   let q = ctx[14];
   let ro = lpb-row(ctx, "o", 1);
   let rq = lpb-row(ctx, "q", 1);
   let lines = ctx[4];
   lpb-bit(((String) o[0] == "declined") && lpb-is(ro, 2, "gap-closed") && ((String) json-emit(json-object-get(ro, "stub_readings")) == "[0,0]") && ((String) lpb-s(ro, "verdict") == "refused") && ((String) lpb-s(ro, "scratch") == "")
    && ((String) q[0] == "declined") && lpb-is(rq, 2, "gap-closed") && ((String) json-emit(json-object-get(rq, "stub_readings")) == "[0,0]") && ((String) lpb-s(rq, "verdict") == "refused") && ((String) lpb-s(rq, "scratch") == "")
    && (!flp-on-request?(lpb-plan-of-sort(), lpb-request-q())) && flp-on-request?(lpb-plan-of-sort(), lpb-request-m()) && (!flp-on-request?(lpb-plan-of-sort(), lpb-request-o()))
    && (str_find(lpb-packet(lpb-root(ctx), "q", 1), "over sort-str-le?, the definition that change stands in", 0) >= 0) && (str_find(lpb-packet(lpb-root(ctx), "o", 1), "since its review", 0) < 0)
    && ((Comparable) lines[6] == lines[5]));
  }
  // the plan of the honest sorted band (one definition, sort-ints of sort.fk), as the voice's reply reads
  def lpb-plan-of-sort() = flp-parse(lpb-sorted("x", []))[2];
  // ── the approach digest ──
  def lpb-digests(ctx, walk) = map(r => lpb-s(r, "approach_digest"), lpb-rows(ctx, walk));
  def lpb-approach(ctx) {
   let a = take(4, lpb-digests(ctx, "a"));
   let b = lpb-digests(ctx, "b");
   let rows = lpb-rows(ctx, "b");
   lpb-bit(((Comparable) len(b) == 5) && (!((String) b[0] == b[1])) && ((String) b[1] == b[2]) && ((String) b[2] == b[3]) && ((String) b[3] == b[4])
    && ((Comparable) len(lpb-unique(a)) == 4) && ((String) b[1] == flp-sha("voice-a|band-first|resume")) && ((String) b[0] == flp-sha("voice-a|band-first|first"))
    && ((Value) map(r => lpb-s(r, "rung"), rows) == ["first", "resume", "resume", "resume", "resume"])
    && ((String) json-emit(json-object-get(rows[1], "approach")) == "{\"voice\":\"voice-a\",\"lens\":\"band-first\",\"kind\":\"resume\"}")
    && ((Comparable) len(lpb-unique(map(r => lpb-s(r, "failure"), rows))) == 5) && ((Comparable) fcgp-swervecount(rows) == 2));
  }
  def lpb-unique(xs) = foldl((acc, x) => if flp-has?(acc, x) then acc else append(acc, [x]), [], xs);
  // ── stubs, read on text alone ──
  def lpb-bml-text() = "section [form.bml] {\n class T {\n  def a(x) = x + 1;\n  def b(p: List, q) {\n   let y = p;\n   y;\n  }\n  // c follows\n  def c() = 3;\n }\n 0;\n}\n";
  def lpb-fk-text() = "(do\n    (defn cl-x (s at) (if (eq (str_find s \"; (unit\" at) at) 1 0))\n    (defn other () 2)\n    0)\n";
  def lpb-sites(ctx) {
   let b = flp-stub-def(lpb-bml-text(), ["b", nothing(), "t.bml"], true, "nothing");
   let a = flp-stub-def(lpb-bml-text(), ["a", nothing(), "t.bml"], true, "echo");
   let z = flp-stub-def(lpb-bml-text(), ["z", ["m", "n"], "t.bml"], true, "echo");
   let x = flp-stub-def(lpb-fk-text(), ["cl-x", nothing(), "t.fk"], false, "nothing");
   let w = flp-stub-def(lpb-fk-text(), ["w", ["a", "b"], "t.fk"], false, "echo");
   lpb-bit(((String) b == "section [form.bml] {\n class T {\n  def a(x) = x + 1;\n  def b(p: List, q) = nothing();\n  // c follows\n  def c() = 3;\n }\n 0;\n}\n")
    && ((String) a == "section [form.bml] {\n class T {\n  def a(x) = x;\n  def b(p: List, q) {\n   let y = p;\n   y;\n  }\n  // c follows\n  def c() = 3;\n }\n 0;\n}\n")
    && ((String) z == "section [form.bml] {\n class T {\n  def z(m, n) = m;\n  def a(x) = x + 1;\n  def b(p: List, q) {\n   let y = p;\n   y;\n  }\n  // c follows\n  def c() = 3;\n }\n 0;\n}\n")
    && ((String) x == "(do\n    (defn cl-x (s at) (nothing))\n    (defn other () 2)\n    0)\n")
    && ((String) w == "(do\n    (defn cl-x (s at) (if (eq (str_find s \"; (unit\" at) at) 1 0))\n    (defn other () 2)\n    (defn w (a b) a)\n    0)\n"));
  }
 }
 let root = lpb-fresh();
 nothing?(root) ? form_error("local-plan band needs a fresh directory under temp_dir") : 0;
 let ctx = lpb-run(root);
 let verdict = live-claims("local-plan-band", ctx, [["unreadable", 1, 1, lpb-unreadable], ["swerves", 2, 1, lpb-swerves], ["shape", 4, 1, lpb-shape], ["paths", 8, 1, lpb-paths], ["checks", 16, 1, lpb-checks], ["compiles", 32, 1, lpb-compiles], ["stubbed", 64, 1, lpb-stubbed], ["queued", 128, 1, lpb-queued], ["declined", 256, 1, lpb-declined], ["untouched", 512, 1, lpb-untouched], ["role", 1024, 1, lpb-role], ["sites", 2048, 1, lpb-sites], ["reachable", 4096, 1, lpb-reachable], ["resumes", 8192, 1, lpb-resumes], ["picks", 16384, 1, lpb-picks], ["balanced", 32768, 1, lpb-balanced], ["measured", 65536, 1, lpb-measured], ["referenced", 131072, 1, lpb-referenced], ["ref-checked", 262144, 1, lpb-ref-checked], ["once", 524288, 1, lpb-once], ["gpu", 1048576, 1, lpb-gpu], ["delims", 2097152, 1, lpb-delims], ["mooted", 4194304, 1, lpb-mooted], ["approach", 8388608, 1, lpb-approach], ["proposed", 16777216, 1, lpb-proposed]]);
 host_dir_rmdir(root);
 verdict;
}
