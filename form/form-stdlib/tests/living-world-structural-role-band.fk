; living-world-structural-role-band.fk -- recurrent binding relations become
; opaque roles and one behavior carrier without importing semantic labels.
; Verdict 32767 proves fifteen recurrence, carrier, and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-structural-recipe-witness.fk

(defn lwsrrb-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwsrrb-sum (tail items)))))

(do
    (let fixture (lwsrw-integrated-schema))
    (let history (lwsrw-schema-history fixture))
    (let tissue-fixture (lwsrw-history-tissue history))
    (let tissue (lwhtw-tissue-shape tissue-fixture))
    (let tissue-candidate (lwhtw-tissue-candidate tissue-fixture))
    (let first-fixture (lwsrw-history-first history))
    (let second-fixture (lwsrw-history-second history))
    (let first (lwsrw-role-shape first-fixture))
    (let second (lwsrw-role-shape second-fixture))
    (let first-candidate (lwsrw-role-candidate first-fixture))
    (let second-candidate (lwsrw-role-candidate second-fixture))
    (let schema (lwsrw-schema-shape fixture))
    (let schema-candidate (lwsrw-schema-candidate fixture))
    (let carrier (lwsrw-carrier fixture))
    (let world (lwt-round-world (lwsrw-schema-round fixture)))
    (let first-set (lwsr-role-evidence-set-cell first))
    (let second-set (lwsr-role-evidence-set-cell second))
    (let first-sources
        (lwt-sources-from-attributions
            (lwo-field-items (lwsr-support-attributions first-set))
            (lwo-empty-field)))
    (let dissent (lwsrw-dissent-world fixture))

    (let c1
        (if (and (eq (lwsr-site-current? world
                         (lwsrw-training-site) (lwsrw-enquiry)) 1)
                 (and (eq (lwsr-site-current? world
                              (lwsrw-first-site tissue-fixture)
                              (lwsrw-enquiry)) 1)
                      (eq (lwsr-site-current? world
                              (lwsrw-second-site tissue-fixture)
                              (lwsrw-enquiry)) 1))) 1 0))
    (let c2
        (if (and (eq (lwsr-role-ready?
                         (lwsr-role-status first)) 1)
                 (and (eq (lwo-field-size
                              (lwsr-role-sites first)) 3)
                      (eq (lwo-field-size
                              (lwsr-role-bindings first)) 3))) 2 0))
    (let c3
        (if (and (eq (lwsr-role-ready?
                         (lwsr-role-status second)) 1)
                 (and (eq (lwo-field-size
                              (lwsr-role-sites second)) 3)
                      (eq (lwo-field-size
                              (lwsr-role-bindings second)) 3))) 4 0))
    (let c4
        (if (and (eq (lwo-field-size
                         (lwsr-evidence-supports first-set)) 3)
                 (and (eq (lwo-field-size
                              (lwsr-evidence-alternatives first-set)) 1)
                      (eq (lwo-field-size
                              (lwsr-evidence-dissents first-set)) 0))) 8 0))
    (let c5
        (if (and (eq (lwo-field-size
                         (lwsr-evidence-supports second-set)) 3)
                 (and (eq (lwo-field-size
                              (lwsr-evidence-silences second-set)) 1)
                      (eq (lwo-field-size
                              (lwsr-evidence-dissents second-set)) 0))) 16 0))
    (let c6
        (if (and (eq (lwo-field-size first-sources) 2)
                 (and (gt (lwo-field-size
                              (lwsr-role-alternatives first)) 0)
                      (gt (lwo-field-size
                              (lwsr-role-unknowns first)) 0))) 32 0))
    (let c7
        (if (and (eq (lwsr-role-integrated-current?
                         world first-candidate) 1)
                 (eq (lwsr-role-integrated-current?
                         world second-candidate) 1)) 64 0))
    (let c8
        (if (and (node_eq (lwsr-role-coordinate first)
                         (lwsrw-coordinate-a))
                 (and (node_eq (lwsr-role-coordinate second)
                              (lwsrw-coordinate-b))
                      (not (node_eq
                              (lwsr-role-coordinate first)
                              (lwsr-role-coordinate second))))) 128 0))
    (let c9
        (if (and (eq (lwsr-binding-name-in-role? first "left") 1)
                 (and (eq (lwsr-binding-name-in-role? first "right") 0)
                      (and (eq (lwsr-binding-name-in-role? second "right") 1)
                           (eq (lwsr-binding-name-in-role? second "left") 0))))
            256 0))
    (let c10
        (if (and (eq (lwo-field-size
                         (lwsr-schema-roles schema)) 2)
                 (eq (lwo-field-size
                         (lwsr-schema-carriers schema)) 1)) 512 0))
    (let c11
        (if (and (node_eq
                     (nth (lwsr-role-items
                              (lwsr-carrier-roles carrier)) 0)
                     first-candidate)
                 (node_eq
                     (nth (lwsr-role-items
                              (lwsr-carrier-roles carrier)) 1)
                     second-candidate)) 1024 0))
    (let c12
        (if (and (node_eq
                     (lwsr-carrier-hypothesis carrier)
                     (lwhtw-forward-hypothesis tissue-fixture))
                 (and (eq (lwo-field-size
                              (lwht-receipt-confirmed
                                (lwsr-carrier-receipt carrier))) 2)
                      (node_eq (lwsr-carrier-operator carrier)
                          (lwph-hypothesis-operator
                              (lwhtw-forward-hypothesis tissue-fixture)))))
            2048 0))
    (let c13
        (if (and (eq (lwo-field-has?
                         (lwsr-schema-alternatives schema)
                         (lwph-hypothesis-recipe
                            (lwhtw-reverse-hypothesis tissue-fixture))) 1)
                 (and (gt (lwo-field-size
                              (lwsr-schema-unknowns schema)) 0)
                      (gt (lwo-field-size
                              (lwsr-schema-witnesses schema)) 0))) 4096 0))
    (let c14
        (if (and (eq (lwsr-schema-integrated-current?
                         world schema-candidate) 1)
                 (and (node_eq
                          (lwo-emergent-shape schema-candidate) schema)
                      (eq (lwht-integrated-current?
                              world tissue-candidate) 1))) 8192 0))
    (let c15
        (if (and (eq (lwo-active? dissent first-candidate) 1)
                 (and (eq (lwsr-role-integrated-current?
                              dissent first-candidate) 0)
                      (and (eq (lwsr-role-integrated-current?
                                  dissent second-candidate) 1)
                           (and (eq (lwsr-schema-integrated-current?
                                      dissent schema-candidate) 0)
                                (eq (lwht-integrated-current?
                                      dissent tissue-candidate) 1)))))
            16384 0))
    (lwsrrb-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
