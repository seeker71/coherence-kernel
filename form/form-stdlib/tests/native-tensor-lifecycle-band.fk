; Form tensor recipes on native Metal. Behavior and refusals travel together.
; Verdict 1023. Live Metal required; absence cannot pass as a successful zero.
; preludes: form-stdlib/native-tensor.bml form-stdlib/form-cli-allowance-birth.bml form-stdlib/form-asm.fk form-stdlib/form-lower.fk form-stdlib/jit-heat-gate.fk form-stdlib/language-model.fk form-stdlib/form-cli-jit.bml
(do
 (defn ntlb-bit (ok bit) (if ok bit 0))
 (let first (nt-run "2 3 add"))
 (let repeat (nt-run "2 3 add"))
 (let zero (nt-run "0"))
 (let refusal (nt-run "0 mystery"))
 (let recovered (nt-run "3 4 add"))
 (sum (list
  (ntlb-bit (nt-live?) 1)
  (ntlb-bit (nt-check-result first (alb-bml)) 2)
  (ntlb-bit (eq (sub (nth (nt-after first) 7) (nth (nt-before first) 7)) 1) 4)
  (ntlb-bit (and (nt-check-result repeat 5) (eq (nth (nt-after repeat) 3) (nth (nt-before repeat) 3))) 8)
  (ntlb-bit (eq (nth (nt-after repeat) 2) (nth (nt-before repeat) 2)) 16)
  (ntlb-bit (and (nt-check-result zero 0) (nt-refused-result refusal "unknown tensor token; offer NodeID JIT")) 32)
  (ntlb-bit (and (nt-check-result recovered 7) (nt-refused-result refusal "unknown tensor token; offer NodeID JIT")) 64)
  (ntlb-bit (and (eq (fjit-apply-metal 1000) 3007) (eq (fjit-apply-cpu 1000) 3007)) 128)
  (ntlb-bit (and (eq (fjit-apply-metal -9) -20) (and (eq (fjit-apply-cpu -9) -20) (eq (fjit-apply-tensor -9) -20))) 256)
  (ntlb-bit (and (eq (len (nth repeat 6)) 3) (str_eq (nth (nth (nth repeat 6) 2) 2) "native-metal")) 512))))
