// Native review addressing and preservation, not model judgment quality.
// preludes: form-stdlib/bml/form-cli-review-enquiry.bml
section [form.bml] {
 class ReviewEditsBand {
  def reb-need(ok,name) = if ok then 1 else form_error(str_concat("review edits: ",name));
  def reb-row(id,action,text) = json-node-object(append(list(json-node-pair("id",id),json-node-pair("status",json-node-string("style")),json-node-pair("action",json-node-string(action)),json-node-pair("reason",json-node-string("fixture judgment"))),if str_eq(action,"replace") then list(json-node-pair("text",json-node-string(text))) else list()));
  def reb-wire(text,rows) = json-node-object(list(json-node-pair("base",json-node-string(fcra-id(text))),json-node-pair("edits",json-node-array(rows))));
  def reb-patch(text,rows) = json-node-object(list(json-node-pair("base",json-node-string(fcrp-id(text,list("answer","next_action")))),json-node-pair("span_edits",json-node-array(rows))));
  def reb-change(id,action,text) = json-node-object(append(list(json-node-pair("id",id),json-node-pair("action",json-node-string(action)),json-node-pair("reason",json-node-string("observed defect"))),if str_eq(action,"replace") then list(json-node-pair("text",json-node-string(text))) else list()));
 }
 let text = "{\"answer\":\"α. B? \",\"next_action\":\"Later.\",\"resident_answer_observed\":false,\"other\":{\"kept\":null}}";
 let fields = list("answer","next_action");
 let packet = fcre-packet(text,fields);
 reb-need(head(packet),"packet admitted");
 let spans = node_children(json-object-get(nth(packet,1),"spans"));
 reb-need(and(eq(len(spans),3),eq(node_value(json-object-get(nth(spans,1),"start_byte")),4)),"exact UTF-8 offsets and field coverage");
 let keep = reb-row(json-node-int(0),"keep","");
 let remove = reb-row(json-node-int(1),"remove","");
 let replace = reb-row(json-node-int(2),"replace","Done.");
 let rows = list(keep,remove,replace);
 let missingReason = parse-json("incomplete","{\"id\":2,\"status\":\"style\",\"action\":\"replace\",\"text\":\"Done.\"}");
 let diagnosed = fcre-apply(text,fields,reb-wire(text,list(keep,remove,missingReason)));
 reb-need(and(not(head(diagnosed)),ge(str_find(nth(diagnosed,2),"span 2:",0),0)),"refusal identifies the exact incomplete decision");
 let applied = fcre-apply(text,fields,reb-wire(text,rows));
 reb-need(head(applied),"complete edit accepted");
 let changed = nth(applied,1);
 reb-need(and(str_eq(fcre-string(changed,"answer"),"α. "),str_eq(fcre-string(changed,"next_action"),"Done.")),"keep remove replace assembled without invented text");
 let original = parse-json("before",text);
 reb-need(and(node_eq(json-object-get(original,"other"),json-object-get(changed,"other")),node_eq(json-object-get(original,"resident_answer_observed"),json-object-get(changed,"resident_answer_observed"))),"unselected values and booleans preserved");
 reb-need(not(head(fcre-apply(text,fields,reb-wire(text,list(keep,remove))))),"partial review refused atomically");
 reb-need(not(head(fcre-apply(text,fields,reb-wire(text,list(keep,keep,replace))))),"duplicate id refused");
 reb-need(not(head(fcre-apply(text,fields,reb-wire(text,list(remove,keep,replace))))),"reordered id refused");
 reb-need(not(head(fcre-apply(text,fields,reb-wire(text,list(keep,remove,reb-row(json-node-string("2"),"replace","Done.")))))),"text id refused");
 reb-need(not(head(fcre-apply(text,fields,reb-wire(text,list(keep,remove,reb-row(parse-json("float","2.0"),"replace","Done.")))))),"float id refused");
 reb-need(not(head(fcre-apply(text,fields,reb-wire(text,list(keep,remove,reb-row(json-node-int(2),"replace","Later.")))))),"unchanged replacement refused");
 reb-need(not(head(fcre-apply(text,fields,reb-wire(text,list(keep,remove,reb-row(json-node-int(2),"replace","")))))),"empty replacement needs explicit remove");
 reb-need(not(head(fcre-apply(text,fields,reb-wire(str_concat(text," "),rows)))),"stale byte identity refused");
 reb-need(not(head(fcre-packet(text,list("answer","answer")))),"duplicate selected field refused");
 reb-need(not(head(fcre-packet(text,list("resident_answer_observed")))),"nontext field cannot be edited");
 let kept = fcre-apply(text,fields,reb-wire(text,list(keep,reb-row(json-node-int(1),"keep",""),reb-row(json-node-int(2),"keep",""))));
 reb-need(and(head(kept),node_eq(nth(kept,1),original)),"keep-only review preserves the complete report");
 let cut = reb-change(json-node-int(1),"remove","");
 let amend = reb-change(json-node-int(2),"replace","Done.");
 let sparse = fcrp-apply(text,fields,reb-patch(text,list(cut,amend)));
 reb-need(and(head(sparse),node_eq(nth(sparse,1),changed)),"sparse changes reproduce complete edits including untouched UTF-8 and other values");
 reb-need(not(head(fcrp-apply(text,fields,reb-patch(text,list())))),"empty amendment refused");
 reb-need(not(head(fcrp-apply(text,fields,reb-patch(text,list(cut,cut))))),"duplicate sparse id refused atomically");
 reb-need(not(head(fcrp-apply(text,fields,reb-patch(text,list(amend,cut))))),"reordered sparse id refused");
 reb-need(not(head(fcrp-apply(text,fields,reb-patch(text,list(reb-change(json-node-int(3),"remove","")))))),"out-of-range sparse id refused");
 reb-need(not(head(fcrp-apply(text,fields,reb-patch(text,list(reb-change(json-node-string("1"),"remove","")))))),"string sparse id refused");
 reb-need(not(head(fcrp-apply(text,fields,reb-patch(text,list(reb-change(parse-json("float","1.0"),"remove","")))))),"float sparse id refused");
 reb-need(not(head(fcrp-apply(text,fields,reb-patch(str_concat(text," "),list(cut))))),"stale sparse base refused");
 reb-need(not(head(fcrp-apply(text,reverse(fields),reb-patch(text,list(cut))))),"same source with reordered selected fields cannot retarget IDs");
 reb-need(not(head(fcrp-apply(text,fields,reb-patch(text,list(reb-change(json-node-int(1),"keep","")))))),"sparse keeps do not pretend a change");
 reb-need(not(head(fcrp-apply(text,fields,reb-patch(text,list(reb-change(json-node-int(2),"replace","Later.")))))),"unchanged sparse replacement refused");
 let cancel = list(reb-change(json-node-int(0),"replace","α. B? "),cut);
 reb-need(not(head(fcrp-apply(text,fields,reb-patch(text,cancel)))),"individually changed spans with unchanged combined text refused");
 1;
}
