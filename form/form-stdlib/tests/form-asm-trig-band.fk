; form-asm-trig-band — sin(x)/cos(x) END-TO-END as Form->asm BYTES: the LAST cpu-native nonlinear rung,
; four-way + byte-identical to the M4 assembler oracle, no rustc/clang. Closes the RoPE gap named in
; form-native-models.form ("exp/sin/cos/rsqrt for softmax/RoPE/RMSNorm/SwiGLU as asm") — exp/silu/tanh
; already run on this lane (form-asm-fam-exp 7, form-asm-fam-silu 7, form-asm-fam-tanh 7).
;
; The algorithm reduces mod PI (not pi/2): k=round(x/pi), r=x-k*pi (|r|<=pi/2), then
; sin(x)=(-1)^k*sin(r), cos(x)=(-1)^k*cos(r) — since sin(t+pi)=-sin(t) and cos(t+pi)=-cos(t), this needs
; only ONE Horner polynomial per function (sin(r)=r*Qsin(r^2), cos(r)=Qcos(r^2), 7 terms each) and ONE
; sign flip, unlike the textbook mod-pi/2 quadrant reduction which needs a float conditional-select
; (fcsel — a primitive this lane does not have) to swap between two polynomials. The (-1)^k sign uses
; only pre-existing GP encoders (UDIV/MUL/CMP for the mod-2 parity test, no new bitwise AND/EOR) and the
; same "0.0 minus x" negate trick (fmov-d-x xzr + fsub) fam-relu/fam-silu/fam-tanh already proved needs
; no dedicated fa-fneg. Domain: x >= 0 (the UDIV-based parity test is unsigned — RoPE's
; position*inv_freq and every named accuracy-bar point are non-negative, so this is a documented domain,
; not a gap). Full derivation: form-asm-trig.fk's own header.
;
; Accuracy (measured on real M4 hardware, scripts/form_asm_trig_witness.sh, dlopen+call over the actual
; emitted bytes — not just the recipe): max|err| = 6.6e-10 (sin) / 6.3e-9 (cos) against libm across
; 74,944 points of RoPE's real domain (position 0..8192, inv_freq=1/base^(2i/d), d=128, base=500000, the
; llama3 RoPE convention) — comfortably inside the exp family's ~1e-7 bar.
;
; Layout: fam-sin is 38 code words (152 bytes) + a 7-f64 pool (56 bytes) = 208 bytes (LEAD=15, TAIL=16).
; fam-cos is 36 code words (144 bytes) + a 7-f64 pool (56 bytes) = 200 bytes (LEAD=21, TAIL=22) — 2 words
; shorter than sin (no save-r / final r-multiply; the parity branch + negate sit after the poly instead
; of before it, since cos is even in r and sin is odd). Both oracles below are the exact M4-assembled
; image (`clang -c -arch arm64` of the hand-written mnemonic sequence mirroring every fa-* call 1:1,
; then `otool -s __TEXT __text`) — every individual encoder used here (fa-mov-imm64, fa-fmov-d-x,
; fa-fmul, fa-frintn, fa-fcvtzs, fa-fmadd, fa-movz, fa-udiv, fa-mul, fa-cmp-r, fa-bcond, fa-fsub, fa-fmov,
; fa-ldr-d-lit) was already individually byte-convicted in an earlier band; this band's claim is that the
; COMPOSITION — register plan, branch offset, Horner LEAD/TAIL derivation — is correct.
;
; Verdict 15 when every claim lands:
;   1   the composed sin program is 208 bytes (38 code words + a 7-quad pool)          (len == 208)
;   2   the FULL 208-byte sin program byte-equals the M4 assembler oracle              (fa-conviction == 1)
;   4   the composed cos program is 200 bytes (36 code words + a 7-quad pool)          (len == 200)
;   8   the FULL 200-byte cos program byte-equals the M4 assembler oracle              (fa-conviction == 1)
;
; preludes: form-stdlib/format-arith.fk form-stdlib/f64-bytes.fk form-stdlib/form-asm.fk form-stdlib/form-asm-matvec.fk form-stdlib/form-asm-trig.fk
(do
    (let sin-prog (fam-sin))
    (let cos-prog (fam-cos))
    (let sin-oracle (list
        104 16 153 210 40 185 173 242 8 230 203 242 136 250 231 242
        1 1 103 158 1 8 97 30 33 64 100 30 41 0 120 158
        8 163 133 210 136 136 170 242 104 63 196 242 40 1 248 242
        2 1 103 158 32 0 66 31 74 0 128 82 43 9 202 26
        108 125 10 27 63 1 12 107 96 0 0 84 227 3 103 158
        96 56 96 30 4 64 96 30 0 8 96 30 225 1 0 92
        2 2 0 92 33 8 64 31 2 2 0 92 33 8 64 31
        2 2 0 92 33 8 64 31 2 2 0 92 33 8 64 31
        2 2 0 92 33 8 64 31 2 2 0 92 32 8 64 31
        0 8 100 30 192 3 95 214 9 109 168 19 70 18 230 61
        228 68 245 103 69 230 90 190 52 199 86 165 227 29 199 62
        26 160 1 26 160 1 42 191 17 17 17 17 17 17 129 63
        85 85 85 85 85 85 197 191 0 0 0 0 0 0 240 63))
    (let cos-oracle (list
        104 16 153 210 40 185 173 242 8 230 203 242 136 250 231 242
        1 1 103 158 1 8 97 30 33 64 100 30 41 0 120 158
        8 163 133 210 136 136 170 242 104 63 196 242 40 1 248 242
        2 1 103 158 32 0 66 31 0 8 96 30 161 2 0 92
        194 2 0 92 33 8 64 31 194 2 0 92 33 8 64 31
        194 2 0 92 33 8 64 31 194 2 0 92 33 8 64 31
        194 2 0 92 33 8 64 31 194 2 0 92 32 8 64 31
        74 0 128 82 43 9 202 26 108 125 10 27 63 1 12 107
        96 0 0 84 227 3 103 158 96 56 96 30 192 3 95 214
        152 216 248 239 216 238 33 62 92 159 120 183 79 126 146 190
        26 160 1 26 160 1 250 62 23 108 193 22 108 193 86 191
        85 85 85 85 85 85 165 63 0 0 0 0 0 0 224 191
        0 0 0 0 0 0 240 63))
    (let c1 (if (eq (len sin-prog) 208)                             1 0))
    (let c2 (if (eq (fa-conviction sin-prog sin-oracle)         1)  2 0))
    (let c3 (if (eq (len cos-prog) 200)                             4 0))
    (let c4 (if (eq (fa-conviction cos-prog cos-oracle)         1)  8 0))
    (add c1 (add c2 (add c3 c4))))
