; living-world-contextual-species-witness.fk -- overlapping native species
; accumulate under offered lenses and split without erasing their history.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk form-stdlib/living-world-contextual-species.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk form-stdlib/tests/living-world-behavioral-species-witness.fk

(let LWCSW-MULTI-FIXTURE   (bp "LWCSW-MULTI-FIXTURE"))
(let LWCSW-TISSUE-FIXTURE  (bp "LWCSW-TISSUE-FIXTURE"))
(let LWCSW-SPLIT-FIXTURE   (bp "LWCSW-SPLIT-FIXTURE"))
(let LWCSW-ANSWER-FIXTURE  (bp "LWCSW-ANSWER-FIXTURE"))
(let LWCSW-SOURCE-A        (bp "LWCSW-SOURCE-A"))
(let LWCSW-SOURCE-B        (bp "LWCSW-SOURCE-B"))
(let LWCSW-SOURCE-C        (bp "LWCSW-SOURCE-C"))
(let LWCSW-SOURCE-D        (bp "LWCSW-SOURCE-D"))
(let LWCSW-SOURCE-E        (bp "LWCSW-SOURCE-E"))
(let LWCSW-SOURCE-F        (bp "LWCSW-SOURCE-F"))
(let LWCSW-SOURCE-S        (bp "LWCSW-SOURCE-S"))
(let LWCSW-SOURCE-I        (bp "LWCSW-SOURCE-I"))
(let LWCSW-SOURCE-J        (bp "LWCSW-SOURCE-J"))
(let LWCSW-SOURCE-K        (bp "LWCSW-SOURCE-K"))
(let LWCSW-SOURCE-L        (bp "LWCSW-SOURCE-L"))
(let LWCSW-SOURCE-M        (bp "LWCSW-SOURCE-M"))
(let LWCSW-SOURCE-N        (bp "LWCSW-SOURCE-N"))
(let LWCSW-SOURCE-Q        (bp "LWCSW-SOURCE-Q"))
(let LWCSW-SOURCE-R        (bp "LWCSW-SOURCE-R"))
(let LWCSW-PROV-A          (bp "LWCSW-PROV-A"))
(let LWCSW-PROV-B          (bp "LWCSW-PROV-B"))
(let LWCSW-PROV-C          (bp "LWCSW-PROV-C"))
(let LWCSW-PROV-D          (bp "LWCSW-PROV-D"))
(let LWCSW-PROV-E          (bp "LWCSW-PROV-E"))
(let LWCSW-PROV-F          (bp "LWCSW-PROV-F"))
(let LWCSW-PROV-S          (bp "LWCSW-PROV-S"))
(let LWCSW-PROV-I          (bp "LWCSW-PROV-I"))
(let LWCSW-PROV-J          (bp "LWCSW-PROV-J"))
(let LWCSW-PROV-K          (bp "LWCSW-PROV-K"))
(let LWCSW-PROV-L          (bp "LWCSW-PROV-L"))
(let LWCSW-PROV-M          (bp "LWCSW-PROV-M"))
(let LWCSW-PROV-N          (bp "LWCSW-PROV-N"))
(let LWCSW-PROV-Q          (bp "LWCSW-PROV-Q"))
(let LWCSW-PROV-R          (bp "LWCSW-PROV-R"))
(let LWCSW-DIRECTION-H     (bp "LWCSW-DIRECTION-H"))
(let LWCSW-CONTEXT-A       (bp "LWCSW-CONTEXT-A"))
(let LWCSW-CONTEXT-B       (bp "LWCSW-CONTEXT-B"))
(let LWCSW-FOCUS           (bp "LWCSW-FOCUS"))
(let LWCSW-OPTION          (bp "LWCSW-OPTION"))
(let LWCSW-EVIDENCE        (bp "LWCSW-EVIDENCE"))
(let LWCSW-QUESTION-EVIDENCE (bp "LWCSW-QUESTION-EVIDENCE"))
(let LWCSW-REASON          (bp "LWCSW-REASON"))

(defn lwcsw-cell (kind) (intern_node kind (empty)))
(defn lwcsw-source-a () (lwcsw-cell LWCSW-SOURCE-A))
(defn lwcsw-source-b () (lwcsw-cell LWCSW-SOURCE-B))
(defn lwcsw-source-c () (lwcsw-cell LWCSW-SOURCE-C))
(defn lwcsw-source-d () (lwcsw-cell LWCSW-SOURCE-D))
(defn lwcsw-source-e () (lwcsw-cell LWCSW-SOURCE-E))
(defn lwcsw-source-f () (lwcsw-cell LWCSW-SOURCE-F))
(defn lwcsw-source-s () (lwcsw-cell LWCSW-SOURCE-S))
(defn lwcsw-source-i () (lwcsw-cell LWCSW-SOURCE-I))
(defn lwcsw-source-j () (lwcsw-cell LWCSW-SOURCE-J))
(defn lwcsw-source-k () (lwcsw-cell LWCSW-SOURCE-K))
(defn lwcsw-source-l () (lwcsw-cell LWCSW-SOURCE-L))
(defn lwcsw-source-m () (lwcsw-cell LWCSW-SOURCE-M))
(defn lwcsw-source-n () (lwcsw-cell LWCSW-SOURCE-N))
(defn lwcsw-source-q () (lwcsw-cell LWCSW-SOURCE-Q))
(defn lwcsw-source-r () (lwcsw-cell LWCSW-SOURCE-R))
(defn lwcsw-prov-a () (lwcsw-cell LWCSW-PROV-A))
(defn lwcsw-prov-b () (lwcsw-cell LWCSW-PROV-B))
(defn lwcsw-prov-c () (lwcsw-cell LWCSW-PROV-C))
(defn lwcsw-prov-d () (lwcsw-cell LWCSW-PROV-D))
(defn lwcsw-prov-e () (lwcsw-cell LWCSW-PROV-E))
(defn lwcsw-prov-f () (lwcsw-cell LWCSW-PROV-F))
(defn lwcsw-prov-s () (lwcsw-cell LWCSW-PROV-S))
(defn lwcsw-prov-i () (lwcsw-cell LWCSW-PROV-I))
(defn lwcsw-prov-j () (lwcsw-cell LWCSW-PROV-J))
(defn lwcsw-prov-k () (lwcsw-cell LWCSW-PROV-K))
(defn lwcsw-prov-l () (lwcsw-cell LWCSW-PROV-L))
(defn lwcsw-prov-m () (lwcsw-cell LWCSW-PROV-M))
(defn lwcsw-prov-n () (lwcsw-cell LWCSW-PROV-N))
(defn lwcsw-prov-q () (lwcsw-cell LWCSW-PROV-Q))
(defn lwcsw-prov-r () (lwcsw-cell LWCSW-PROV-R))
(defn lwcsw-focus () (lwcsw-cell LWCSW-FOCUS))
(defn lwcsw-option () (lwcsw-cell LWCSW-OPTION))
(defn lwcsw-evidence () (lwcsw-cell LWCSW-EVIDENCE))
(defn lwcsw-question-evidence () (lwcsw-cell LWCSW-QUESTION-EVIDENCE))
(defn lwcsw-reason () (lwcsw-cell LWCSW-REASON))

(defn lwcsw-entry (source provenance payload)
    (lwtnw-entry source provenance payload))
(defn lwcsw-entry-a (payload)
    (lwcsw-entry (lwcsw-source-a) (lwcsw-prov-a) payload))
(defn lwcsw-entry-b (payload)
    (lwcsw-entry (lwcsw-source-b) (lwcsw-prov-b) payload))
(defn lwcsw-entry-c (payload)
    (lwcsw-entry (lwcsw-source-c) (lwcsw-prov-c) payload))
(defn lwcsw-entry-d (payload)
    (lwcsw-entry (lwcsw-source-d) (lwcsw-prov-d) payload))
(defn lwcsw-entry-e (payload)
    (lwcsw-entry (lwcsw-source-e) (lwcsw-prov-e) payload))
(defn lwcsw-entry-f (payload)
    (lwcsw-entry (lwcsw-source-f) (lwcsw-prov-f) payload))
(defn lwcsw-entry-s (payload)
    (lwcsw-entry (lwcsw-source-s) (lwcsw-prov-s) payload))
(defn lwcsw-entry-i (payload)
    (lwcsw-entry (lwcsw-source-i) (lwcsw-prov-i) payload))
(defn lwcsw-entry-j (payload)
    (lwcsw-entry (lwcsw-source-j) (lwcsw-prov-j) payload))
(defn lwcsw-entry-k (payload)
    (lwcsw-entry (lwcsw-source-k) (lwcsw-prov-k) payload))
(defn lwcsw-entry-l (payload)
    (lwcsw-entry (lwcsw-source-l) (lwcsw-prov-l) payload))
(defn lwcsw-entry-m (payload)
    (lwcsw-entry (lwcsw-source-m) (lwcsw-prov-m) payload))
(defn lwcsw-entry-n (payload)
    (lwcsw-entry (lwcsw-source-n) (lwcsw-prov-n) payload))
(defn lwcsw-entry-q (payload)
    (lwcsw-entry (lwcsw-source-q) (lwcsw-prov-q) payload))
(defn lwcsw-entry-r (payload)
    (lwcsw-entry (lwcsw-source-r) (lwcsw-prov-r) payload))
(defn lwcsw-pair (source provenance) (list source provenance))

(defn lwcsw-ab ()
    (list
        (lwcsw-pair (lwcsw-source-a) (lwcsw-prov-a))
        (lwcsw-pair (lwcsw-source-b) (lwcsw-prov-b))))
(defn lwcsw-cdefs ()
    (list
        (lwcsw-pair (lwcsw-source-c) (lwcsw-prov-c))
        (lwcsw-pair (lwcsw-source-d) (lwcsw-prov-d))
        (lwcsw-pair (lwcsw-source-e) (lwcsw-prov-e))
        (lwcsw-pair (lwcsw-source-f) (lwcsw-prov-f))
        (lwcsw-pair (lwcsw-source-s) (lwcsw-prov-s))))
(defn lwcsw-ijklmn ()
    (list
        (lwcsw-pair (lwcsw-source-i) (lwcsw-prov-i))
        (lwcsw-pair (lwcsw-source-j) (lwcsw-prov-j))
        (lwcsw-pair (lwcsw-source-k) (lwcsw-prov-k))
        (lwcsw-pair (lwcsw-source-l) (lwcsw-prov-l))
        (lwcsw-pair (lwcsw-source-m) (lwcsw-prov-m))
        (lwcsw-pair (lwcsw-source-n) (lwcsw-prov-n))))
(defn lwcsw-qr ()
    (list
        (lwcsw-pair (lwcsw-source-q) (lwcsw-prov-q))
        (lwcsw-pair (lwcsw-source-r) (lwcsw-prov-r))))
(defn lwcsw-h-participants ()
    (append (lwtnw-pqrstu)
        (cons (lwcsw-pair (lwtnw-source-x) (lwtnw-prov-x))
              (lwcsw-ab))))
(defn lwcsw-gh-participants ()
    (append (lwtnw-pqrstu)
        (append
            (list
                (lwcsw-pair (lwtnw-source-x) (lwtnw-prov-x))
                (lwcsw-pair (lwbsw-source-k) (lwbsw-prov-k))
                (lwcsw-pair (lwbsw-source-l) (lwbsw-prov-l)))
            (append (lwcsw-ab) (lwcsw-cdefs)))))
(defn lwcsw-f-participants () (lwbsw-f-participants))

; All sources governing E/G, G/H, live contexts, facets, and the focus.
(defn lwcsw-coherent-participants ()
    (append (lwbsw-species-participants)
        (append (lwcsw-ab)
            (append (lwcsw-cdefs) (lwcsw-ijklmn)))))
(defn lwcsw-split-participants ()
    (append (lwcsw-coherent-participants)
        (list (lwcsw-pair (lwtnw-source-y) (lwtnw-prov-y)))))
(defn lwcsw-answer-participants ()
    (append (lwcsw-split-participants) (lwcsw-qr)))

; H is a third source-distinct Recipe with the same local 1 -> 4 boundary.
(defn lwcsw-recipe-h ()
    (lwre-recipe "(sub 9 5)" (lwtnw-contract) (lwcsw-evidence)))
(defn lwcsw-lens-h () (lwtnw-lens-for (lwcsw-recipe-h)))
(defn lwcsw-declaration-h ()
    (lwtnw-declaration-for
        (lwcsw-cell LWCSW-DIRECTION-H) (lwcsw-lens-h)))
(defn lwcsw-offer-h (target)
    (lwtn-offer target (lwcsw-recipe-h) (lwcsw-declaration-h)
        (lwcsw-lens-h) (intern_trivial_int 1)
        (lwo-field (list (lwcsw-option)))
        (lwlc-unknown (lwcsw-evidence))
        (lwo-none) (lwo-none) (lwcsw-evidence)))
(defn lwcsw-revoke-g-offers (world target)
    (lwt-receive-stream world
        (list
            (lwbsw-entry-k
                (lwo-revocation (lwbsw-offer-g target)
                    (lwbsw-source-k) (lwcsw-reason) (lwbsw-prov-k)))
            (lwbsw-entry-l
                (lwo-revocation (lwbsw-offer-g target)
                    (lwbsw-source-l) (lwcsw-reason) (lwbsw-prov-l))))))
(defn lwcsw-world-with-h (world target)
    (lwt-receive-stream world
        (list
            (lwcsw-entry-a (lwcsw-recipe-h))
            (lwcsw-entry-a (lwcsw-declaration-h))
            (lwcsw-entry-a (lwcsw-offer-h target))
            (lwcsw-entry-b (lwcsw-offer-h target)))))
(defn lwcsw-revoke-h-offers (world target)
    (lwt-receive-stream world
        (list
            (lwcsw-entry-a
                (lwo-revocation (lwcsw-offer-h target)
                    (lwcsw-source-a) (lwcsw-reason) (lwcsw-prov-a)))
            (lwcsw-entry-b
                (lwo-revocation (lwcsw-offer-h target)
                    (lwcsw-source-b) (lwcsw-reason) (lwcsw-prov-b))))))

(defn lwcsw-gh-observed-world (world g h)
    (do
        (let direct (lwbsw-support-observation world g h))
        (let inverse (lwbsw-support-observation world h g))
        (let silence (lwbsw-silence-observation g h))
        (lwt-receive-stream world
            (list
                (lwcsw-entry-c direct) (lwcsw-entry-d direct)
                (lwcsw-entry-e inverse) (lwcsw-entry-f inverse)
                (lwcsw-entry-s silence)))))
(defn lwcsw-integrate-gh (world g h previous)
    (do
        (let observed (lwcsw-gh-observed-world world g h))
        (let field (lwbs-field-for observed g h 2))
        (let proposal (lwbs-proposal observed g h 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let round
            (lwt-round observed (lwo-field (list proposal))
                (lwo-empty-field) previous))
        (let yes
            (lwt-round-receive round
                (lwtnw-response-entries proposal
                    (lwcsw-gh-participants))))
        (let integrated (lwbs-integrate yes proposal (lwigw-action)))
        (lwbsw-species-fixture integrated candidate proposal field)))

; children: final world, equivalent base, E/G species, H trial, G/H species
(defn lwcsw-multi-fixture
    (world equivalent eg-species h-trial gh-species)
    (intern_node LWCSW-MULTI-FIXTURE
        (list world equivalent eg-species h-trial gh-species)))
(defn lwcsw-multi-world (fixture) (nth (node_children fixture) 0))
(defn lwcsw-multi-equivalent (fixture) (nth (node_children fixture) 1))
(defn lwcsw-eg-species (fixture) (nth (node_children fixture) 2))
(defn lwcsw-h-trial (fixture) (nth (node_children fixture) 3))
(defn lwcsw-gh-species (fixture) (nth (node_children fixture) 4))
(defn lwcsw-build-multi ()
    (do
        (let equivalent (lwbsw-build-equivalent))
        (let eg-species (lwbsw-integrated-species equivalent))
        (let world (lwt-round-world (lwbsw-species-round eg-species)))
        (let target
            (lwtnw-target (lwbsw-equivalent-target equivalent)))
        (let reopened (lwcsw-revoke-g-offers world target))
        (let h-world (lwcsw-world-with-h reopened target))
        (let h-selection
            (lwtnw-integrate-selection h-world target
                (lwbsw-species-round eg-species)
                (lwcsw-h-participants)))
        (let h-trial
            (lwtnw-integrate-trial h-selection (lwcsw-h-participants)))
        (let g
            (lwtnw-trial-candidate
                (lwbsw-equivalent-g-trial equivalent)))
        (let h (lwtnw-trial-candidate h-trial))
        (let gh-species
            (lwcsw-integrate-gh
                (lwt-round-world (lwtnw-trial-round h-trial))
                g h (lwtnw-trial-round h-trial)))
        (lwcsw-multi-fixture
            (lwt-round-world (lwbsw-species-round gh-species))
            equivalent eg-species h-trial gh-species)))

; Real-time optional lens declarations for the shared field.
(defn lwcsw-context-a ()
    (lwlc-declaration (lwcsw-cell LWCSW-CONTEXT-A)
        (lwlc-stack (lwtnw-lens-e)
            (lwlc-layers (list (lwbsw-lens-g)))
            (lwo-field (list (lwcsw-lens-h)))
            (lwlc-unknown (lwcsw-evidence)) (lwcsw-evidence))
        (lwcsw-evidence)))
(defn lwcsw-context-b ()
    (lwlc-declaration (lwcsw-cell LWCSW-CONTEXT-B)
        (lwlc-stack (lwo-none)
            (lwlc-layers (list (lwcsw-lens-h)))
            (lwo-empty-field) (lwo-none) (lwcsw-evidence))
        (lwcsw-evidence)))
(defn lwcsw-support-facet (anchor context)
    (lwcs-facet (lwcsw-focus) anchor context (oac-one anchor)
        (lwo-field (list (lwcsw-option)))
        (lwlc-unknown (lwcsw-evidence)) (lwcsw-evidence)))
(defn lwcsw-silence-facet (anchor)
    (lwcs-facet (lwcsw-focus) anchor (lwo-none) (oac-nothing)
        (lwo-empty-field) (lwlc-unknown (lwcsw-evidence))
        (lwcsw-evidence)))
(defn lwcsw-alternative-facet (anchor offered)
    (lwcs-facet (lwcsw-focus) anchor (lwcsw-context-b)
        (oac-alternative-ack anchor offered (lwcsw-evidence))
        (lwo-field (list offered))
        (lwlc-unknown (lwcsw-evidence)) (lwcsw-evidence)))
(defn lwcsw-context-world (world eg gh)
    (do
        (let first (lwcsw-support-facet eg (lwcsw-context-a)))
        (let second (lwcsw-support-facet gh (lwcsw-context-b)))
        (let silence (lwcsw-silence-facet eg))
        (lwt-receive-stream world
            (list
                (lwcsw-entry-i (lwcsw-focus))
                (lwcsw-entry-j (lwcsw-focus))
                (lwcsw-entry-k (lwcsw-focus))
                (lwcsw-entry-l (lwcsw-focus))
                (lwcsw-entry-m (lwcsw-focus))
                (lwcsw-entry-n (lwcsw-focus))
                (lwcsw-entry-i (lwcsw-context-a))
                (lwcsw-entry-j (lwcsw-context-a))
                (lwcsw-entry-k (lwcsw-context-b))
                (lwcsw-entry-l (lwcsw-context-b))
                (lwcsw-entry-i first) (lwcsw-entry-j first)
                (lwcsw-entry-k second) (lwcsw-entry-l second)
                (lwcsw-entry-m silence) (lwcsw-entry-n silence)))))
(defn lwcsw-coherent-world (fixture)
    (lwcsw-context-world (lwcsw-multi-world fixture)
        (lwbsw-species-candidate (lwcsw-eg-species fixture))
        (lwbsw-species-candidate (lwcsw-gh-species fixture))))

; children: integrated round, candidate, proposal, exact pre-admission field
(defn lwcsw-tissue-fixture (round candidate proposal field)
    (intern_node LWCSW-TISSUE-FIXTURE
        (list round candidate proposal field)))
(defn lwcsw-tissue-round (fixture) (nth (node_children fixture) 0))
(defn lwcsw-tissue-candidate (fixture) (nth (node_children fixture) 1))
(defn lwcsw-tissue-proposal-cell (fixture) (nth (node_children fixture) 2))
(defn lwcsw-tissue-field (fixture) (nth (node_children fixture) 3))
(defn lwcsw-integrated-coherent-tissue (fixture)
    (do
        (let world (lwcsw-coherent-world fixture))
        (let eg (lwbsw-species-candidate (lwcsw-eg-species fixture)))
        (let kernel (lwcs-kernel-for-anchor world eg))
        (let field (lwcs-field-for world (lwcsw-focus) 2))
        (let proposal
            (lwcs-tissue-proposal world (lwcsw-focus) kernel 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let round
            (lwt-round world (lwo-field (list proposal))
                (lwo-empty-field)
                (lwbsw-species-round (lwcsw-gh-species fixture))))
        (let yes
            (lwt-round-receive round
                (lwtnw-response-entries proposal
                    (lwcsw-coherent-participants))))
        (let integrated
            (lwcs-tissue-integrate yes proposal (lwigw-action)))
        (lwcsw-tissue-fixture integrated candidate proposal field)))

; Build the real 1 -> 3 F trial after coherent tissue admission, so the old
; tissue remains as history when the context field splits.
(defn lwcsw-build-f-trial (multi tissue)
    (do
        (let world (lwt-round-world (lwcsw-tissue-round tissue)))
        (let target
            (lwtnw-target
                (lwbsw-equivalent-target
                    (lwcsw-multi-equivalent multi))))
        (let reopened (lwcsw-revoke-h-offers world target))
        (let f-world (lwbsw-world-with-f-second reopened target))
        (let f-selection
            (lwtnw-integrate-selection f-world target
                (lwcsw-tissue-round tissue) (lwcsw-f-participants)))
        (lwtnw-integrate-trial f-selection (lwcsw-f-participants))))
(defn lwcsw-split-world (multi tissue f-trial)
    (do
        (let world (lwt-round-world (lwtnw-trial-round f-trial)))
        (let f (lwtnw-trial-candidate f-trial))
        (let facet (lwcsw-support-facet f (lwcsw-context-b)))
        (lwt-receive-stream world
            (list (lwcsw-entry-m (lwcsw-context-b))
                  (lwcsw-entry-n (lwcsw-context-b))
                  (lwcsw-entry-m facet) (lwcsw-entry-n facet)))))

; children: split world, F trial, re-admitted component tissue fixture
(defn lwcsw-split-fixture (world f-trial tissue)
    (intern_node LWCSW-SPLIT-FIXTURE (list world f-trial tissue)))
(defn lwcsw-split-world-cell (fixture) (nth (node_children fixture) 0))
(defn lwcsw-split-f-trial (fixture) (nth (node_children fixture) 1))
(defn lwcsw-split-tissue (fixture) (nth (node_children fixture) 2))
(defn lwcsw-build-split (multi coherent-tissue)
    (do
        (let f-trial (lwcsw-build-f-trial multi coherent-tissue))
        (let world (lwcsw-split-world multi coherent-tissue f-trial))
        (let eg (lwbsw-species-candidate (lwcsw-eg-species multi)))
        (let kernel (lwcs-kernel-for-anchor world eg))
        (let field (lwcs-field-for world (lwcsw-focus) 2))
        (let proposal
            (lwcs-tissue-proposal world (lwcsw-focus) kernel 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let round
            (lwt-round world (lwo-field (list proposal))
                (lwo-empty-field) (lwtnw-trial-round f-trial)))
        (let yes
            (lwt-round-receive round
                (lwtnw-response-entries proposal
                    (lwcsw-split-participants))))
        (let integrated
            (lwcs-tissue-integrate yes proposal (lwigw-action)))
        (lwcsw-split-fixture
            (lwt-round-world integrated) f-trial
            (lwcsw-tissue-fixture integrated candidate proposal field))))

(defn lwcsw-ambiguous-world (coherent-world anchor offered)
    (do
        (let facet (lwcsw-alternative-facet anchor offered))
        (lwt-receive-stream coherent-world
            (list (lwcsw-entry-m facet) (lwcsw-entry-n facet)))))
(defn lwcsw-revoked-context-world (coherent-world anchor context)
    (do
        (let facet (lwcsw-support-facet anchor context))
        (lwt-receive-stream coherent-world
            (list
                (lwcsw-entry-l
                    (lwo-revocation facet (lwcsw-source-l)
                        (lwcsw-reason) (lwcsw-prov-l)))))))

(defn lwcsw-question (tissue)
    (lwcs-question tissue (lwo-none)
        (lwo-field (list (lwcsw-option)))
        (lwlc-unknown (lwcsw-question-evidence))
        (lwcsw-question-evidence)))
(defn lwcsw-question-world (split)
    (do
        (let tissue
            (lwcsw-tissue-candidate (lwcsw-split-tissue split)))
        (let question (lwcsw-question tissue))
        (lwt-receive-stream (lwcsw-split-world-cell split)
            (list (lwcsw-entry-q question) (lwcsw-entry-r question)))))
; children: integrated round, answer candidate, proposal, exact answer/question
(defn lwcsw-answer-fixture (round candidate proposal answer question)
    (intern_node LWCSW-ANSWER-FIXTURE
        (list round candidate proposal answer question)))
(defn lwcsw-answer-round (fixture) (nth (node_children fixture) 0))
(defn lwcsw-answer-candidate (fixture) (nth (node_children fixture) 1))
(defn lwcsw-answer-proposal-cell (fixture) (nth (node_children fixture) 2))
(defn lwcsw-answer-shape (fixture) (nth (node_children fixture) 3))
(defn lwcsw-answer-question (fixture) (nth (node_children fixture) 4))
(defn lwcsw-integrated-answer (split)
    (do
        (let world (lwcsw-question-world split))
        (let tissue
            (lwcsw-tissue-candidate (lwcsw-split-tissue split)))
        (let question (lwcsw-question tissue))
        (let proposal (lwcs-answer-proposal world question 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let answer (lwo-emergent-shape candidate))
        (let round
            (lwt-round world (lwo-field (list proposal))
                (lwo-empty-field)
                (lwcsw-tissue-round (lwcsw-split-tissue split))))
        (let yes
            (lwt-round-receive round
                (lwtnw-response-entries proposal
                    (lwcsw-answer-participants))))
        (let integrated
            (lwcs-answer-integrate yes proposal (lwigw-action)))
        (lwcsw-answer-fixture integrated candidate proposal answer question)))

0
