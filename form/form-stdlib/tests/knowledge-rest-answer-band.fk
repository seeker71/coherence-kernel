; knowledge-rest-answer-band.fk — the model's question, answered at rest:
; a known query returns a pointer whose text is the recipe, force pays at
; the JIT door and agrees with the tree-walk, a composed answer lowers
; whole, and an unknown query answers exact nothing — never a zero.
;
; Expected: 511
; Witnessed 2026-08-30 on fkwu (63, rc 0). The walkers' next door on this
; chain is intern_node (probed by name, teaching round in flight) — a door
; being opened, not a wall.
; preludes: form-stdlib/knowledge-rest-answer.fk
(do
    (defn krab-bit (ok bit) (if ok bit 0))
    (let p (kra-answer "bootstrap/ground"))
    (let forced (kra-force (hg-gate 4242) "bootstrap/ground"))
    (let twice (kra-force (hg-gate 4242) "ground twice"))
    (let unknown (kra-force (hg-gate 4242) "unasked question"))
    (sum (list
        (krab-bit (eq (lg-defer? p) 1) 1)
        (krab-bit (str_eq (lg-defer-text p) "(add 40 2)") 2)
        (krab-bit (and (eq (nth forced 0) 42)
                       (str_eq (nth forced 1) "form")) 4)
        (krab-bit (eq (nth forced 0) (lg-force p)) 8)
        (krab-bit (eq (nth twice 0) 84) 16)
        (krab-bit (nothing? unknown) 32)
        (krab-bit (str_eq (kra-corpus-word "what names speech borrowed from a prior's tongue fluent and plausible that dies when the body executes it") "loanspeak") 64)
        (krab-bit (str_eq (kra-corpus-word "what names an answer that sleeps as a recipe until need wakes it into data?") "restanswer") 128)
        (krab-bit (nothing? (kra-corpus-word "a question the corpus never held")) 256))))
