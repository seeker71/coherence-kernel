; A real carrier release refusal cannot repeat a successful output free or lease drop.
; Expected 4095. A deliberately invalid admission tests failure; the owned handle
; is restored before retry so the same actual resource can then be reclaimed.
; preludes: form-stdlib/bml/frame-metal.bml form-stdlib/tests/frame-luma-fixture.fk
(do
 (let before (metal_status))
 (let version (fg-version 1024))
 (let program (record_get version "program"))
 (let owner (fg-open version))
 (let bytes (flmb-bmp 1))
 (let frame (fg-capture owner bytes))
 (let job (fg-submit owner frame (flm-default-policy)))
 (let completed (fg-await owner job))
 (let row (fg-result owner job))
 (let retired (fg-retire version))
 (let held (and (eq (record_get version "leases") 1) (eq (record_get version "disposed") 0)))
 (record_set version "program" (list 4294967295 "invalid-admission" "" "" 0 ""))
 (let frees-before (kernel_stat 354))
 (let first (fg-release owner job))
 (let middle (metal_status))
 (let lease-once (and (eq (record_get job "released") 1) (eq (record_get version "leases") 0)))
 (let close-refused (fg-close owner))
 (let release-pain (record_get version "health"))
 (let frees-after-refusal (kernel_stat 354))
 (let still-owned (and (eq (record_get owner "closed") 0) (eq (record_get version "disposed") 0)))
 (record_set version "program" program)
 (let second (fg-close owner))
 (let after (metal_status))
 (sum (list
  (if (and (record? frame) (str_eq completed "completed")) 1 0)
  (if (value_eq row (flm-stat bytes)) 2 0)
  (if (and (eq retired 1) held) 4 0)
  (if (and (eq first 0) lease-once) 8 0)
  (if (eq (fg-status-number middle "buffers") (add (fg-status-number before "buffers") 1)) 16 0)
  (if (and (and (eq close-refused 0) still-owned)
    (and (and (oh-valid release-pain) (oh-pain release-pain))
     (str_eq (oh-select release-pain (oh-response release-pain "request-evidence") "retain") "request-evidence"))) 32 0)
  (if (eq (sub frees-after-refusal frees-before) 1) 64 0)
  (if (and (eq second 1)
    (and (not (oh-pain (record_get version "health")))
     (and (str_eq (oh-select release-pain (record_get version "health-response") "retain") "retry-release")
      (eq (json-int-value (oh-get (record_get version "health-applied") "result")) 1)))) 128 0)
  (if (and (eq (record_get version "disposed") 1) (eq (record_get version "leases") 0)) 256 0)
  (if (eq (fg-status-number before "buffers") (fg-status-number after "buffers")) 512 0)
  (if (eq (fg-status-number before "pipelines") (fg-status-number after "pipelines")) 1024 0)
  (if (and (eq (fg-release owner job) 0) (eq (fg-close owner) 0)) 2048 0))))
