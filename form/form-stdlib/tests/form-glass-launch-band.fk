; form-glass-launch-band.fk — content dependency and selective cache plan proof.
;
; preludes: form-stdlib/form-glass-launch.bml
; Verdict 32767: source content changes alter dependency identity, every live
; consumer image is mapped, lowering memos remain outside release, and the
; five-second attention/next-runner and Form-owned supervision contracts are executable.

(do
    (defn fglub-bit (held weight) (if (eq held 1) weight 0))
    (defn fglub-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))
    (let sources (fglu-sources))
    (let images (fglu-images))
    (let manifest (fglu-dependency-manifest))
    (let result (fglu-launch-result 1 7 manifest 5001))
    (let authority (read_file "form/form-stdlib/bml/form-glass-launch.bml"))
    (let carrier (read_file "tools/watch-glass.sh"))
    (sum (list
        (fglub-bit (and (eq (fglub-has manifest "source-hash") 1) (eq (fglub-has manifest "form-glass-flow-ui.bml") 1)) 1)
        (fglub-bit (and (eq (len sources) 18) (and (eq (len (fglu-refresh-units)) 15) (and (eq (len (fglu-consumer-sources)) 5) (eq (len images) 6)))) 2)
        (fglub-bit (and (eq (fglub-has (fglu-join images) "form-glass-flow-ui.bml.fkb") 0) (eq (fglub-has manifest "form-glass-flow-ui.bml") 1)) 4)
        (fglub-bit (and (eq (fglub-has (fglu-join images) "form-glass-observation-ui.bml.fkb") 0) (eq (fglub-has manifest "form-glass-observation-ui.bml") 1)) 8)
        (fglub-bit (and (eq (fglub-has (fglu-join images) "form-glass-layout-ui.bml.fkb") 0) (eq (fglub-has manifest "form-glass-layout-ui.bml") 1)) 16)
        (fglub-bit (and (eq (fglub-has (fglu-join images) "form-glass-live-ui.bml.fkb") 0) (eq (fglub-has manifest "form-glass-live-ui.bml") 1)) 32)
        (fglub-bit (eq (fglub-has (fglu-join images) "form-glass-live.bml.fkb") 1) 64)
        (fglub-bit (and (eq (fglub-has (fglu-join images) "observe/form-glass-live-run.fkb") 1) (eq (fglub-has (fglu-join images) "observe/form-resource-governor-glass-current-run.fkb") 1)) 128)
        (fglub-bit (eq (fglub-has (fglu-join images) ".lowfk") 0) 256)
        (fglub-bit (and (eq (nth result 4) 5001) (str_eq (nth result 5) "close-attention")) 512)
        (fglub-bit (and (str_eq (nth result 6) "observe/form-glass-live-run.fk") (eq (FGLUAttentionMs) 5000)) 1024)
        (fglub-bit (and (eq (fglub-has authority "content-derived source-hash") 1) (eq (fglub-has authority "matching bml.lowfk") 1)) 2048)
        (fglub-bit (and (eq (fglu-supervisor-restart-of "abstain") 0) (and (eq (fglu-supervisor-restart-of "selfmolt") 1) (eq (fglub-has authority "Form persists running, selfmolt, or abstain") 1))) 4096)
        (fglub-bit (and (eq (fglub-has carrier "form-glass-supervisor-restart-run.fk") 1) (and (eq (fglub-has carrier "observe/form-glass-live-run.fk") 1) (eq (fglub-has carrier "observe/hearth-glass-live.fk") 0))) 8192)
        (fglub-bit (and (str_eq (fglu-refresh-plan 0) "identity-current-loader-on-demand")
                        (and (eq (fglu-refresh-if-changed 0) 0)
                             (and (str_eq (fglu-refresh-plan 1) "identity-changed-refresh")
                                  (eq (fglub-has authority "rejects missing, stale, or foreign images") 1)))) 16384))))
