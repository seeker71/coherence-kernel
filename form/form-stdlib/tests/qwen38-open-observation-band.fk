; qwen38-open-observation-band.fk -- native admission phases are BML data,
; observable through the framebuffer, and keep zero distinct from nothing.
; Expected: 255
; preludes: form-stdlib/bml/qwen38-open-observation.bml

(do
    (defn q38oob-bit (ok bit) (if ok bit 0))
    (framebuffer-clear)
    (let artifact (q38oo-artifact-begin))
    (let pipeline (q38oo-pipeline-begin))
    (let ready (q38oo-open-ready))
    (let settled (q38oo-stage "model-scratch-ready" 3))
    (let began (q38oo-stage "model-scratch-begin" 4))
    (sum (list
        (q38oob-bit (and (eq artifact 0)
            (and (eq pipeline 0) (eq ready 0))) 1)
        (q38oob-bit (and (str_eq (q38oo-route) "model-admission")
            (str_eq (q38oo-source) "native/metal/qwen35-dense-token-handle.fk")) 2)
        (q38oob-bit (and (str_eq (q38oo-stage-status "model-pipeline-jit-begin") "begin")
            (str_eq (q38oo-stage-status "model-pipeline-jit-ready") "value")) 4)
        (q38oob-bit (and (ge (str_find (q38oo-stage-line "model-layer-map-begin" 7)
                "route=model-admission" 0) 0)
            (and (ge (str_find (q38oo-stage-line "model-layer-map-begin" 7)
                    "status=begin" 0) 0)
                (ge (str_find (q38oo-stage-line "model-layer-map-begin" 7)
                    "stamp-ms=7" 0) 0))) 8)
        (q38oob-bit (eq (len (framebuffer-events)) 5) 16)
        (q38oob-bit (and (eq settled 0) (not (nothing? settled))) 32)
        (q38oob-bit (and (eq began 0) (eq (len (framebuffer-events)) 5)) 64)
        (q38oob-bit (and (str_eq (q38oo-stage-status "model-artifact-admission-refused") "value")
            (str_eq (q38oo-stage-status "model-artifact-admission-begin") "begin")) 128))))
