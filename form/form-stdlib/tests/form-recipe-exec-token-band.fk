; form-recipe-exec-token-band.fk — the pure NodeID request and lifecycle seam.
;
; Verdict 1048575 (20 bits):
;   1       stream and witness markers plus bounds are fixed
;   2       equal recipe compositions share a content-addressed NodeID
;   4       the rendered coordinate reconstructs the registered recipe NodeID
;   8       an exact envelope becomes a valid request with input/carrier intact
;   16      equal requests share identity; changed input changes identity
;   32      ordinary/incomplete/trailing/nested/empty surfaces stay nothing
;   64      an over-budget partial frame stays nothing
;   128     malformed/noncanonical/unknown NodeID coordinates stay nothing
;   256     wrong fields/carrier/noncanonical input stay nothing
;   512     parsed input 0 and input 1 are distinct from parser nothing
;   1024    offer nothing/value-0/value-1/failure/timeout stay typed and distinct
;   2048    failure, timeout, nothing fall through to a later value-0 choice
;   4096    value 0 and value 1 are both present and have distinct observations
;   8192    exhausted nothing remains status=nothing with no value
;   16384   an exhausted failure remains failure and carries undo/refine
;   32768   an exhausted timeout remains timeout and carries cut/undo/refine
;   65536   the attempt budget cuts a fifth offer and returns timeout
;   131072  equal lifecycle observations share identity; changed value does not
;   262144  rendering is bounded, typed, and does not reproduce the raw request
;   524288  pure seam never claims model/native execution or native codegen
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/form-recipe-exec-token.fk

(do
    (defn frexb-bit (condition bit) (if condition bit 0))
    (defn frexb-envelope (payload)
        (str_concat (frex-open) (str_concat payload (frex-close))))
    (defn frexb-repeat (chunk n out)
        (if (eq n 0) out
            (frexb-repeat chunk (sub n 1) (str_concat out chunk))))
    (defn frexb-all-nothing? (requests)
        (if (eq (len requests) 0) 1
            (if (eq (frex-request-ready? (head requests)) 0)
                (frexb-all-nothing? (tail requests)) 0)))
    (defn frexb-offer-node-distinct? (offers)
        (if (eq (len offers) 0) 1
            (if (eq (len (tail offers)) 0) 1
                (if (node_eq (frex-offer-token (head offers))
                             (frex-offer-token (head (tail offers)))) 0
                    (frexb-offer-node-distinct? (tail offers))))))

    (defn form-recipe-exec-token-band ()
        (do
            (let recipe (frex-recipe))
            (let coordinate (frex-node-coordinate recipe))
            (let reconstructed (frex-node-from-coordinate coordinate))
            (let resolved (frex-recipe-from-coordinate coordinate))
            (let request (frex-parse (frex-surface recipe 5 "auto")))
            (let request2 (frex-parse (frex-surface recipe 5 "auto")))
            (let changed (frex-parse (frex-surface recipe 6 "auto")))
            (let zero-request (frex-parse (frex-surface recipe 0 "auto")))
            (let one-request (frex-parse (frex-surface recipe 1 "auto")))

            (let parser-nothings (list
                (frex-parse "ordinary prose")
                (frex-parse "<|form:recipe-exec|>@1.2.3.4;input=5;carrier=auto")
                (frex-parse (str_concat (frex-surface recipe 5 "auto") " tail"))
                (frex-parse (frexb-envelope (str_concat (frex-open)
                    "@1.2.3.4;input=5;carrier=auto")))
                (frex-parse (frexb-envelope ""))))
            (let too-long (frex-parse (str_concat (frex-open)
                (frexb-repeat "0123456789" 20 ""))))
            (let coordinate-nothings (list
                (frex-parse (frexb-envelope "@01.2.3.4;input=5;carrier=auto"))
                (frex-parse (frexb-envelope "@1.2.3;input=5;carrier=auto"))
                (frex-parse (frexb-envelope "@1.2.x.4;input=5;carrier=auto"))
                (frex-parse (frexb-envelope "@31.2.0.999;input=5;carrier=auto"))))
            (let field-nothings (list
                (frex-parse (frexb-envelope (str_concat coordinate
                    ";carrier=auto;input=5")))
                (frex-parse (frexb-envelope (str_concat coordinate
                    ";input=5;carrier=remote")))
                (frex-parse (frexb-envelope (str_concat coordinate
                    ";input=05;carrier=auto")))
                (frex-parse (frexb-envelope (str_concat coordinate
                    ";input=5;carrier=auto;extra=1")))))

            (let o-nothing (frex-offer "metal" "nothing" 0 "unavailable"))
            (let o-zero (frex-offer "cpu" "value" 0 "observed-zero"))
            (let o-one (frex-offer "cpu" "value" 1 "observed-one"))
            (let o-failure (frex-offer "metal" "failure" 0 "compile-failure"))
            (let o-timeout (frex-offer "mlx" "timeout" 0 "time-budget"))
            (let offers (list o-nothing o-zero o-one o-failure o-timeout))

            ; failure and timeout are observed and transformed before a later
            ; nothing leaves room for the fourth choice, which returns value 0.
            (let fallback (frex-choice request (list
                o-failure o-timeout o-nothing o-zero)))
            (let zero-result (frex-choice request (list o-zero)))
            (let zero-result2 (frex-choice request (list o-zero)))
            (let one-result (frex-choice request (list o-one)))
            (let nothing-result (frex-choice request (list o-nothing)))
            (let failure-result (frex-choice request (list o-failure)))
            (let timeout-result (frex-choice request (list o-timeout)))
            (let budget-result (frex-choice request (list
                o-failure o-failure o-nothing o-timeout o-one)))
            (let rendered (frex-render fallback))

            (sum (list
                (frexb-bit (and
                    (str_eq (frex-open) "<|form:recipe-exec|>")
                    (and (str_eq (frex-close) "<|/form:recipe-exec|>")
                    (and (str_eq (frex-observation-open)
                                 "<|form:recipe-observation|>")
                    (and (eq (frex-max-payload-bytes) 128)
                         (eq (frex-max-attempts) 4))))) 1)
                (frexb-bit (node_eq recipe (frex-recipe)) 2)
                (frexb-bit (and (not (nothing? reconstructed))
                    (and (str_eq (frex-node-coordinate reconstructed) coordinate)
                    (and (eq (frex-node-coordinate-eq? reconstructed recipe) 1)
                         (node_eq resolved recipe)))) 4)
                (frexb-bit (and (eq (frex-request-ready? request) 1)
                    (and (eq (frex-request-input request) 5)
                    (and (str_eq (frex-request-carrier request) "auto")
                         (eq (frex-request-node-valid?
                                (frex-request-token request)) 1)))) 8)
                (frexb-bit (and
                    (node_eq (frex-request-token request)
                             (frex-request-token request2))
                    (not (node_eq (frex-request-token request)
                                  (frex-request-token changed)))) 16)
                (frexb-bit (eq (frexb-all-nothing? parser-nothings) 1) 32)
                (frexb-bit (and (eq (frex-request-ready? too-long) 0)
                    (str_eq (frex-request-reason too-long)
                            "payload-budget-exceeded")) 64)
                (frexb-bit (eq (frexb-all-nothing? coordinate-nothings) 1) 128)
                (frexb-bit (eq (frexb-all-nothing? field-nothings) 1) 256)
                (frexb-bit (and (eq (frex-request-ready? zero-request) 1)
                    (and (eq (frex-request-input zero-request) 0)
                    (and (eq (frex-request-ready? one-request) 1)
                    (and (eq (frex-request-input one-request) 1)
                         (not (node_eq (frex-request-token zero-request)
                                       (frex-request-token one-request))))))) 512)
                (frexb-bit (and (eq (frexb-offer-node-distinct? offers) 1)
                    (and (eq (frex-offer-value-present? o-nothing) 0)
                    (and (eq (frex-offer-value-present? o-zero) 1)
                    (and (eq (frex-offer-value o-zero) 0)
                    (and (eq (frex-offer-value-present? o-one) 1)
                         (eq (frex-offer-value o-one) 1)))))) 1024)
                (frexb-bit (and (str_eq (frex-result-status fallback) "value")
                    (and (str_eq (frex-result-carrier fallback) "cpu")
                    (and (eq (frex-result-value fallback) 0)
                    (and (eq (frex-result-value-present? fallback) 1)
                    (and (eq (frex-result-attempts fallback) 4)
                    (and (eq (frex-trace-has? (frex-result-trace fallback)
                                                   "failure") 1)
                    (and (eq (frex-trace-has? (frex-result-trace fallback)
                                                   "timeout") 1)
                    (and (eq (frex-trace-has? (frex-result-trace fallback)
                                                   "nothing") 1)
                         (eq (frex-trace-count (frex-result-trace fallback)
                                              "choice") 4))))))))) 2048)
                (frexb-bit (and (str_eq (frex-result-status zero-result) "value")
                    (and (eq (frex-result-value-present? zero-result) 1)
                    (and (eq (frex-result-value zero-result) 0)
                    (and (str_eq (frex-result-status one-result) "value")
                    (and (eq (frex-result-value-present? one-result) 1)
                    (and (eq (frex-result-value one-result) 1)
                         (not (node_eq (frex-result-observation zero-result)
                                       (frex-result-observation one-result))))))))) 4096)
                (frexb-bit (and (str_eq (frex-result-status nothing-result)
                                        "nothing")
                    (and (eq (frex-result-value-present? nothing-result) 0)
                         (eq (frex-trace-has? (frex-result-trace nothing-result)
                                                   "release") 1))) 8192)
                (frexb-bit (and (str_eq (frex-result-status failure-result)
                                        "failure")
                    (and (eq (frex-trace-has? (frex-result-trace failure-result)
                                                   "undo") 1)
                         (eq (frex-trace-has? (frex-result-trace failure-result)
                                                   "refine") 1))) 16384)
                (frexb-bit (and (str_eq (frex-result-status timeout-result)
                                        "timeout")
                    (and (eq (frex-trace-has? (frex-result-trace timeout-result)
                                                   "cut") 1)
                    (and (eq (frex-trace-has? (frex-result-trace timeout-result)
                                                   "undo") 1)
                         (eq (frex-trace-has? (frex-result-trace timeout-result)
                                                   "refine") 1)))) 32768)
                (frexb-bit (and (str_eq (frex-result-status budget-result)
                                        "timeout")
                    (and (str_eq (frex-result-reason budget-result)
                                 "attempt-budget")
                    (and (eq (frex-result-attempts budget-result) 4)
                         (eq (frex-trace-has? (frex-result-trace budget-result)
                                                   "cut") 1)))) 65536)
                (frexb-bit (and
                    (node_eq (frex-result-observation zero-result)
                             (frex-result-observation zero-result2))
                    (not (node_eq (frex-result-observation zero-result)
                                  (frex-result-observation one-result)))) 131072)
                (frexb-bit (and (gt (str_len rendered) 0)
                    (and (le (str_len rendered) (frex-max-render-bytes))
                    (and (ge (str_find rendered (frex-observation-open) 0) 0)
                    (and (ge (str_find rendered "lifecycle=" 0) 0)
                    (and (lt (str_find rendered ";input=" 0) 0)
                    (and (lt (str_find rendered (frex-open) 0) 0)
                         (ge (str_find rendered "value-present=1" 0) 0))))))) 262144)
                (frexb-bit (and (eq (frex-result-executed? fallback) 0)
                    (and (eq (frex-result-model-executed? fallback) 0)
                         (eq (frex-result-native-code-generated? fallback) 0)))
                    524288)))))

    (form-recipe-exec-token-band))
