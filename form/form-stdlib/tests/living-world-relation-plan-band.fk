; living-world-relation-plan-band.fk -- ready, ambiguous, and cycle stay distinct.
; Verdict 32767 proves fifteen group, plan, alternatives, and unknown claims.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk

(do
    (let nodes (lwo-field (list (lwrlw-left) (lwrlw-right))))
    (let ready-world (lwt-round-world (lwrlw-integrated-round)))
    (let ready (lwrp-plan-for ready-world (lwrlw-relation) nodes))
    (let ready-group (lwrp-plan-group ready))
    (let ready-items
        (lwrp-sequence-items (lwrp-plan-sequence ready)))
    (let ambiguous
        (lwrp-plan-for ready-world (lwrlw-alternate) nodes))
    (let cycle-world
        (lwt-round-world (lwrlw-cycle-integrated-round)))
    (let cycle (lwrp-plan-for cycle-world (lwrlw-relation) nodes))

    (let c1 (if (and (eq (lwrp-group? ready-group) 1)
                         (node_eq (lwrp-group-relation ready-group)
                                  (lwrlw-relation))) 1 0))
    (let c2 (if (and (eq (lwo-field-size
                              (lwrp-group-nodes ready-group)) 2)
                         (eq (lwo-field-size
                              (lwrp-group-edges ready-group)) 1)) 2 0))
    (let c3 (if (eq (lwo-field-size
                         (lwrp-group-witnesses ready-group)) 14) 4 0))
    (let c4 (if (eq (lwrp-ready?
                         (lwrp-plan-status ready)) 1) 8 0))
    (let c5 (if (and (eq (len ready-items) 2)
                         (and (node_eq (nth ready-items 0) (lwrlw-left))
                              (node_eq (nth ready-items 1)
                                       (lwrlw-right)))) 16 0))
    (let c6 (if (and (eq (lwo-field-size
                              (lwrp-plan-remaining ready)) 0)
                         (and (eq (lwo-field-size
                                   (lwrp-plan-alternatives ready)) 0)
                              (node_eq (lwrp-plan-unknown ready)
                                       (lwo-none)))) 32 0))
    (let c7 (if (eq (lwrp-plan-current? ready-world ready) 1) 64 0))
    (let c8 (if (eq (lwrp-ambiguous?
                         (lwrp-plan-status ambiguous)) 1) 128 0))
    (let c9 (if (and (eq (lwo-field-size
                              (lwrp-plan-alternatives ambiguous)) 2)
                         (eq (lwlc-unknown?
                              (lwrp-plan-unknown ambiguous)) 1)) 256 0))
    (let c10 (if (and (eq (len
                               (lwrp-sequence-items
                                 (lwrp-plan-sequence ambiguous))) 0)
                          (eq (lwo-field-size
                               (lwrp-group-edges
                                 (lwrp-plan-group ambiguous))) 0)) 512 0))
    (let c11 (if (eq (lwrp-cycle?
                          (lwrp-plan-status cycle)) 1) 1024 0))
    (let c12 (if (and (eq (lwo-field-size
                               (lwrp-group-edges
                                 (lwrp-plan-group cycle))) 2)
                          (eq (lwo-field-size
                               (lwrp-plan-remaining cycle)) 2)) 2048 0))
    (let c13 (if (and (eq (lwo-field-size
                               (lwrp-plan-alternatives cycle)) 0)
                          (eq (lwlc-unknown?
                               (lwrp-plan-unknown cycle)) 1)) 4096 0))
    (let c14 (if (eq (lwrp-plan-current? cycle-world cycle) 1) 8192 0))
    (let c15 (if (and (not (node_eq ready ambiguous))
                          (and (not (node_eq ambiguous cycle))
                               (not (node_eq ready cycle)))) 16384 0))
    (lwrlw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
