; Re-witness all eight real DS4 tokens from the 2026-07-28 native generation
; through the live stream receipt.  Token 201 decoded to an ambiguous blank
; line before byte/timing evidence was carried.  This cell uses the observed
; token sequence, the actual GGUF tokenizer, the native clock, and framebuffer.
;
; 31 = ids + eight events + endpoint sequence/ids + time + exact endpoint bytes.
;
; preludes: native/metal/dsv4-native-session.fk config/dsv4-local-resource.fk

(do
    (defn dtsr-record (src ids sequence started)
        (if (eq (len ids) 0) (list)
            (cons
                (dns-record-token src sequence (head ids) started)
                (dtsr-record src (tail ids) (add sequence 1) started))))

    (framebuffer-clear)
    (let src (tkz-src (dsv4-local-model-resource)))
    (let started (sub (now_unix_ms) 5))
    (let ids (list 201 223 680 223 18 14 223 14490))
    (let tokens (dtsr-record src ids 0 started))
    (let events (framebuffer-events))
    (let first-kids (node_children (head events)))
    (let last-kids (node_children (nth events 7)))
    (add
        (if (and (eq (len tokens) 8)
                 (and (eq (head tokens) 201) (eq (nth tokens 7) 14490)))
            1 0)
        (add
            (if (eq (len events) 8) 2 0)
            (add
                (if (and
                        (eq (node_value (nth first-kids 0)) 0)
                        (and (eq (node_value (nth first-kids 1)) 201)
                             (and (eq (node_value (nth last-kids 0)) 7)
                                  (eq (node_value (nth last-kids 1)) 14490))))
                    4 0)
                (add
                    (if (and
                            (gt (node_value (nth first-kids 2)) started)
                            (ge (node_value (nth last-kids 3)) 5))
                        8 0)
                    (if (and
                            (and (eq (len first-kids) 5)
                                 (eq (node_value (nth first-kids 4)) 10))
                            (and (eq (len last-kids) 10)
                                 (str_eq
                                    (dns-byte-values
                                        (list
                                            (node_value (nth last-kids 4))
                                            (node_value (nth last-kids 5))
                                            (node_value (nth last-kids 6))
                                            (node_value (nth last-kids 7))
                                            (node_value (nth last-kids 8))
                                            (node_value (nth last-kids 9))))
                                    "32,82,101,97,99,116")))
                        16 0))))))
