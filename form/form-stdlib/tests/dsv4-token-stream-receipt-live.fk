; Re-witness the first real DS4 token from the 2026-07-28 native generation
; through the live stream receipt.  Token 201 decoded to an ambiguous blank
; line before byte/timing evidence was carried.  This cell uses that observed
; token, the actual GGUF tokenizer, the native clock, and the framebuffer.
;
; 31 = id + one event + sequence/id + time + exact newline byte.
;
; preludes: native/metal/dsv4-native-session.fk config/dsv4-local-resource.fk

(do
    (framebuffer-clear)
    (let src (tkz-src (dsv4-local-model-resource)))
    (let started (sub (now_unix_ms) 5))
    (let token (dns-record-token src 0 201 started))
    (let events (framebuffer-events))
    (let kids (node_children (head events)))
    (add
        (if (eq token 201) 1 0)
        (add
            (if (eq (len events) 1) 2 0)
            (add
                (if (and
                        (eq (node_value (nth kids 0)) 0)
                        (eq (node_value (nth kids 1)) 201))
                    4 0)
                (add
                    (if (and
                            (gt (node_value (nth kids 2)) started)
                            (ge (node_value (nth kids 3)) 5))
                        8 0)
                    (if (and
                            (eq (len kids) 5)
                            (eq (node_value (nth kids 4)) 10))
                        16 0))))))
