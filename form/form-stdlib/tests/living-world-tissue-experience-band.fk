; living-world-tissue-experience-band.fk -- observation changes the next risk.
; Verdict 32767 proves fifteen confirm, divergence, and revocation claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk form-stdlib/living-world-contextual-species.fk form-stdlib/living-world-tissue-prediction.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk form-stdlib/tests/living-world-behavioral-species-witness.fk form-stdlib/tests/living-world-contextual-species-witness.fk form-stdlib/tests/living-world-tissue-prediction-witness.fk

(do
    (let base (lwtpw-build-base))
    (let initial-a (lwtpw-initial-a base))
    (let confirmed (lwtpw-confirmed-a initial-a))
    (let confirmed-world
        (lwt-round-world (lwtpw-experience-round confirmed)))
    (let confirmed-candidate (lwtpw-experience-candidate confirmed))
    (let confirmed-shape (lwo-emergent-shape confirmed-candidate))
    (let next-a (lwtpw-next-a base initial-a confirmed))
    (let next-a-world
        (lwt-round-world (lwtpw-prediction-round next-a)))
    (let next-a-shape (lwtpw-prediction-shape next-a))

    (let initial-b (lwtpw-initial-b base))
    (let diverged (lwtpw-diverged-b initial-b))
    (let diverged-world
        (lwt-round-world (lwtpw-experience-round diverged)))
    (let diverged-candidate (lwtpw-experience-candidate diverged))
    (let diverged-shape (lwo-emergent-shape diverged-candidate))
    (let next-b (lwtpw-next-b base initial-b diverged))
    (let next-b-world
        (lwt-round-world (lwtpw-prediction-round next-b)))
    (let next-b-candidate (lwtpw-prediction-candidate next-b))
    (let next-b-shape (lwtpw-prediction-shape next-b))
    (let revoked
        (lwtpw-revoke-v-observation next-b-world
            (lwtpw-experience-observation diverged)))
    (let after-revoke
        (lwtp-prediction-for revoked (lwtpw-base-tissue base)
            (lwtpw-prediction-target initial-b) 2 (lwo-none)))

    (let c1
        (if (and (not (node_eq
                         (lwtpw-experience-proposal-cell confirmed)
                         (lwo-none)))
                 (eq (lwo-field-size
                         (lwtp-observation-independent-sources
                           confirmed-world
                           (lwtpw-experience-observation confirmed))) 2)) 1 0))
    (let c2
        (if (and (eq (lwtp-confirm?
                         (lwtp-experience-state confirmed-shape)) 1)
                 (node_eq (lwtp-experience-observed confirmed-shape)
                          (intern_trivial_int 4))) 2 0))
    (let c3
        (if (and (eq (lwtp-experience-candidate-current?
                         confirmed-world confirmed-candidate) 1)
                 (node_eq confirmed-shape
                    (lwtp-experience-for confirmed-world
                        (lwtpw-experience-observation confirmed) 2))) 4 0))
    (let c4
        (if (and (eq (lwo-field-size
                         (lwtp-prediction-experiences next-a-shape)) 1)
                 (and (eq (lwtp-consensus?
                              (lwtp-prediction-status next-a-shape)) 1)
                      (node_eq (lwtp-prediction-predicted next-a-shape)
                               (intern_trivial_int 4)))) 8 0))
    (let c5
        (if (and (not (node_eq
                         (lwtpw-prediction-candidate initial-a)
                         (lwtpw-prediction-candidate next-a)))
                 (and (eq (lwtp-prediction-candidate-current?
                              confirmed-world
                              (lwtpw-prediction-candidate initial-a)) 0)
                      (eq (lwtp-prediction-integrated-current?
                              next-a-world
                              (lwtpw-prediction-candidate next-a)) 1))) 16 0))
    (let c6
        (if (and (eq (lwtp-diverge?
                         (lwtp-experience-state diverged-shape)) 1)
                 (node_eq (lwtp-experience-observed diverged-shape)
                          (intern_trivial_int 3))) 32 0))
    (let c7
        (if (and (eq (lwtp-experience-candidate-current?
                         diverged-world diverged-candidate) 1)
                 (and (eq (lwo-field-has?
                              (lwtp-experience-alternatives diverged-shape)
                              (intern_trivial_int 3)) 1)
                      (gt (lwo-field-size
                              (lwtp-experience-unknowns diverged-shape)) 0)))
            64 0))
    (let c8
        (if (and (eq (lwo-field-size
                         (lwtp-prediction-experiences next-b-shape)) 1)
                 (and (eq (lwtp-branch?
                              (lwtp-prediction-status next-b-shape)) 1)
                      (node_eq (lwtp-prediction-predicted next-b-shape)
                               (lwo-none)))) 128 0))
    (let c9
        (if (and (eq (lwo-field-size
                         (lwtp-prediction-combined-outputs next-b-shape)) 2)
                 (and (eq (lwo-field-has?
                              (lwtp-prediction-combined-outputs next-b-shape)
                              (intern_trivial_int 3)) 1)
                      (eq (lwo-field-has?
                              (lwtp-prediction-combined-outputs next-b-shape)
                              (intern_trivial_int 4)) 1))) 256 0))
    (let c10
        (if (and (eq (lwo-field-size
                         (lwtp-prediction-recipes next-b-shape)) 3)
                 (and (eq (lwo-field-has?
                              (lwtp-prediction-alternatives next-b-shape)
                              (intern_trivial_int 3)) 1)
                      (eq (lwo-field-has?
                              (lwtp-prediction-alternatives next-b-shape)
                              (intern_trivial_int 4)) 1))) 512 0))
    (let c11
        (if (and (eq (lwtp-prediction-integrated-current?
                         next-b-world next-b-candidate) 1)
                 (eq (lwtp-prediction-proposal-current?
                         next-b-world
                         (lwtpw-prediction-proposal-cell next-b)) 1)) 1024 0))
    (let c12
        (if (and (eq (lwtp-experience-candidate-usable?
                         revoked diverged-candidate) 0)
                 (eq (lwtp-experience-candidate-current?
                         revoked diverged-candidate) 0)) 2048 0))
    (let c13
        (if (and (eq (lwo-field-size
                         (lwtp-prediction-experiences after-revoke)) 0)
                 (and (eq (lwtp-consensus?
                              (lwtp-prediction-status after-revoke)) 1)
                      (node_eq (lwtp-prediction-predicted after-revoke)
                               (intern_trivial_int 4)))) 4096 0))
    (let c14
        (if (and (eq (lwo-active? revoked next-b-candidate) 1)
                 (eq (lwtp-prediction-candidate-current?
                         revoked next-b-candidate) 0)) 8192 0))
    (let c15
        (if (and (eq (lwo-active-by? revoked
                         (lwtpw-experience-observation diverged)
                         (lwtpw-source-v)) 0)
                 (eq (lwo-active-by? revoked
                         (lwtpw-experience-observation diverged)
                         (lwtpw-source-w)) 1)) 16384 0))
    (lwtnw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
