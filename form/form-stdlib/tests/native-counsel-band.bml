; native-counsel-band.bml — the native turn's counsel call (form-stdlib/bml/native-counsel.bml), with no model and no server: the replies are the server's own reply rows, written by the band.
;
; Expected: 15
; Verdict 15 when every claim lands:
;   1   no server standing is named, never waited for: ncs-ask of a spool no server holds answers ["unserved" "no server stands (...)"] with no texts, and opens no model
;   2   the server's replies read as the turn reads them: each text ends at the model's end-of-turn, the line names the lenses, the ids a lens read, the queue and prefill ms and the
;       tokens, and the lens it was surest of is the one with the lowest surprise
;   4   the question carries the gap's goal; counsel is asked only where .hearth/walk.counsel stands (absent: no counsel, present: counsel), and the band leaves the file as it found it
;   8   the texts are kept beside the turn's candidates, one paragraph a lens under the lens's own words, and read back whole
;
; REQUIRES: the built ./fkwu and the body root as the working directory.
// preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/bml/live.bml form-stdlib/bml/serve-sched.bml form-stdlib/bml/serve-client.bml form-stdlib/bml/native-counsel.bml
section [form.bml] {
 class NativeCounselBand {
  def ncb-has(s, part) = str_find(s, part, 0) >= 0;
  def ncb-doc(text, surprise) = parse-json("band-reply", "{\"status\":\"stop\",\"text\":\"" ++ text ++ "\",\"prompt_ids\":210,\"generated_ids\":31,\"queue_ms\":12,\"prefill_ms\":340,\"surprise_micro_nats\":" ++ surprise.str() ++ "}");
  def ncb-run() {
   let none = ncs-ask(temp_dir() ++ "/native-counsel-band-no-spool-" ++ now_unix_ms().str(), "q", ncs-lenses(), 8, "band");
   let b1 = ((String) none[0] == "unserved" && ncb-has(none[1], "no server stands (") && len(none[2]) == 0) ? 1 : 0;
   let lenses = ncs-lenses();
   let r = ncs-of-docs(lenses, [ncb-doc("first<|im_end|>tail", 900), ncb-doc("second", 400)]);
   let b2 = ((String) r[0] == "served" && (String) r[2][0] == "first" && (String) r[2][1] == "second" && ncb-has(r[1], "2 lenses, prompt 210 ids a lens; queue 12 ms, prefill 340 ms, 31 tokens; surest lens 1") && r[3][1] == 400) ? 2 : 0;
   let before = host_path_remove(".hearth/walk.counsel");
   let absent = ncs-wanted?();
   let made = host_dir_mkdir(".hearth");
   let w = write_file(".hearth/walk.counsel", "on\n");
   let present = ncs-wanted?();
   let gone = host_path_remove(".hearth/walk.counsel");
   let b4 = (ncb-has(ncs-question("repair the foo definition"), "repair the foo definition") && !absent && present && !ncs-wanted?()) ? 4 : 0;
   let kept = ncs-keep("band-gap", lenses, ["alpha", "beta"]);
   let back = read_file(".hearth/native-turns/band-gap.counsel");
   let b8 = (!nothing?(back) && ncb-has(back, "[" ++ lenses[0] ++ "]\nalpha") && ncb-has(back, "[" ++ lenses[1] ++ "]\nbeta")) ? 8 : 0;
   let cleaned = host_path_remove(".hearth/native-turns/band-gap.counsel");
   let v = b1 + b2 + b4 + b8;
   print_str("[native-counsel-band] " ++ v.str() ++ " of 15");
   v;
  }
 }
 ncb-run();
}
