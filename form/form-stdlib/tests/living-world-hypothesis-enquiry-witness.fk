; living-world-hypothesis-enquiry-witness.fk -- a plural field derives every
; separating binding, asks without choosing, and lowers one consented choice
; into the ordinary recurrent probe cycle.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-enquiry.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk

(let LWHEW-NON-SCOPE  (bp "LWHEW-NON-SCOPE"))
(let LWHEW-NON-LEFT   (bp "LWHEW-NON-LEFT"))
(let LWHEW-NON-RIGHT  (bp "LWHEW-NON-RIGHT"))
(let LWHEW-SPACE-EVIDENCE (bp "LWHEW-SPACE-EVIDENCE"))
(let LWHEW-LENS-PAYLOAD   (bp "LWHEW-LENS-PAYLOAD"))
(let LWHEW-REASON         (bp "LWHEW-REASON"))
(let LWHEW-RESULT         (bp "LWHEW-RESULT"))

(defn lwhew-cell (kind) (intern_node kind (empty)))
(defn lwhew-non-scope () (lwhew-cell LWHEW-NON-SCOPE))
(defn lwhew-non-left () (lwhew-cell LWHEW-NON-LEFT))
(defn lwhew-non-right () (lwhew-cell LWHEW-NON-RIGHT))
(defn lwhew-evidence () (lwhew-cell LWHEW-SPACE-EVIDENCE))
(defn lwhew-reason () (lwhew-cell LWHEW-REASON))
(defn lwhew-lens ()
    (lwlc-lens (lwlc-cell-shape) (lwhew-cell LWHEW-LENS-PAYLOAD)
        (lwhew-evidence)))

(defn lwhew-non-left-projection ()
    (lwphw-projection (lwhew-non-scope) (lwhew-non-left)
        (intern_trivial_int 0) (lwo-empty-field) (lwo-none)))
(defn lwhew-non-right-projection ()
    (lwphw-projection (lwhew-non-scope) (lwhew-non-right)
        (intern_trivial_int 0) (lwo-empty-field)
        (lwlc-unknown (lwhew-evidence))))
(defn lwhew-non-bindings ()
    (lwre-bindings
        (list
            (lwre-projected-binding "left"
                (lwhew-non-left-projection) (lwhew-evidence))
            (lwre-projected-binding "right"
                (lwhew-non-right-projection) (lwhew-evidence)))))

(defn lwhew-non-dependencies (world)
    (lwt-receive-stream world
        (list
            (lwphw-entry-k (lwhew-non-scope))
            (lwphw-entry-l (lwhew-non-scope))
            (lwphw-entry-k (lwhew-non-left))
            (lwphw-entry-l (lwhew-non-left))
            (lwphw-entry-k (lwhew-non-right))
            (lwphw-entry-l (lwhew-non-right))
            (lwphw-entry-k (lwhew-non-left-projection))
            (lwphw-entry-l (lwhew-non-left-projection))
            (lwphw-entry-k (lwhew-non-right-projection))
            (lwphw-entry-l (lwhew-non-right-projection))
            (lwphw-entry-k (nth (lwre-binding-items
                                  (lwhew-non-bindings)) 0))
            (lwphw-entry-l (nth (lwre-binding-items
                                  (lwhew-non-bindings)) 0))
            (lwphw-entry-k (nth (lwre-binding-items
                                  (lwhew-non-bindings)) 1))
            (lwphw-entry-l (nth (lwre-binding-items
                                  (lwhew-non-bindings)) 1)))))

(defn lwhew-space (candidate)
    (lwhe-space candidate
        (lwo-field (list (lwhew-non-bindings) (lwphw-probe-bindings)))
        (lwo-field (list (lwphw-alternative)))
        (lwlc-unknown (lwhew-evidence)) (lwhew-lens) (lwhew-evidence)))

; children: field fixture, world with space, exact space.
(defn lwhew-space-fixture (field-fixture world space)
    (intern_node LWHEW-RESULT (list field-fixture world space)))
(defn lwhew-space-field-fixture (fixture) (nth (node_children fixture) 0))
(defn lwhew-space-world (fixture) (nth (node_children fixture) 1))
(defn lwhew-space-cell (fixture) (nth (node_children fixture) 2))

(defn lwhew-space-fixture-for ()
    (do
        (let field-fixture (lwphw-integrated-field))
        (let candidate (lwphw-field-candidate field-fixture))
        (let base (lwt-round-world (lwphw-field-round field-fixture)))
        (let with-separating
            (lwphw-probe-dependencies base (empty)))
        (let with-non-separating
            (lwhew-non-dependencies with-separating))
        (let space (lwhew-space candidate))
        (let world
            (lwt-receive-stream with-non-separating
                (list (lwphw-entry-k space) (lwphw-entry-l space))))
        (lwhew-space-fixture field-fixture world space)))

; result children: space fixture, enquiry, separating trial, aligned trial,
; open/chosen/alternative/invalid requests, derived probe, placement,
; revoked world, stale enquiry.
(defn lwhew-result
    (fixture enquiry separating aligned open chosen alternative invalid probe
     placement revoked stale)
    (intern_node LWHEW-RESULT
        (list fixture enquiry separating aligned open chosen alternative
              invalid probe placement revoked stale)))
(defn lwhew-result-fixture (result) (nth (node_children result) 0))
(defn lwhew-result-enquiry (result) (nth (node_children result) 1))
(defn lwhew-result-separating (result) (nth (node_children result) 2))
(defn lwhew-result-aligned (result) (nth (node_children result) 3))
(defn lwhew-result-open (result) (nth (node_children result) 4))
(defn lwhew-result-chosen (result) (nth (node_children result) 5))
(defn lwhew-result-alternative (result) (nth (node_children result) 6))
(defn lwhew-result-invalid (result) (nth (node_children result) 7))
(defn lwhew-result-probe (result) (nth (node_children result) 8))
(defn lwhew-result-placement (result) (nth (node_children result) 9))
(defn lwhew-result-revoked (result) (nth (node_children result) 10))
(defn lwhew-result-stale (result) (nth (node_children result) 11))

(defn lwhew-run ()
    (do
        (let started
            (lcfb-open-stream "living-world-hypothesis-enquiry" "form-native"
                "lwhew-run" "plural-field-to-consented-probe"
                "form/form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk"
                114 1))
        (let build-enter
            (lcfb-call-stream "living-world-hypothesis-enquiry" "space"
                "enter" "form-native" "lwphw-integrated-field/lwhe-space"
                "offered-bindings" 1 started
                "form/form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk"
                119 1))
        (let fixture (lwhew-space-fixture-for))
        (let world (lwhew-space-world fixture))
        (let space (lwhew-space-cell fixture))
        (let build-leave
            (lcfb-call-stream "living-world-hypothesis-enquiry" "space"
                "leave" "form-native" "lwhe-space-current?"
                "bindings:2:sources:2" 2 started
                "form/form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk"
                128 1))
        (let enquire-enter
            (lcfb-call-stream "living-world-hypothesis-enquiry" "enquire"
                "enter" "form-native" "lwhe-enquiry-for"
                "execute-all-consistent-recipes" 3 started
                "form/form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk"
                134 1))
        (let enquiry (lwhe-enquiry-for world space 2))
        (let separating (head (lwo-field-items
                                (lwhe-enquiry-separating enquiry))))
        (let aligned (head (lwo-field-items (lwhe-enquiry-aligned enquiry))))
        (let enquire-leave
            (lcfb-call-stream "living-world-hypothesis-enquiry" "enquire"
                "leave" "form-native" "lwhe-filter-trials"
                "trials:2:separating:1:aligned:1" 4 started
                "form/form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk"
                144 1))
        (let timeout
            (oac-timeout (intern_trivial_int 10) (oac-no-default)
                (lwhew-evidence)))
        (let open
            (lwhe-request enquiry (oac-nothing) timeout
                (lwhew-evidence) (lwhew-lens)))
        (let chosen
            (lwhe-request enquiry (oac-one separating) timeout
                (lwhew-evidence) (lwhew-lens)))
        (let alternative
            (lwhe-request enquiry
                (oac-alternative-ack enquiry aligned (lwhew-evidence))
                timeout (lwhew-evidence) (lwo-none)))
        (let invalid
            (lwhe-request enquiry (oac-one aligned) timeout
                (lwhew-evidence) (lwhew-lens)))
        (let request-frame
            (lcfb-call-stream "living-world-hypothesis-enquiry" "request"
                "leave" "form-native" "lwhe-request"
                "open:1:chosen:1:alternative:1:invalid-choice:1" 5 started
                "form/form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk"
                166 1))
        (let probe
            (lwhe-probe-from-request chosen (intern_trivial_int 7)
                (oac-one (intern_trivial_int 7))
                (lwo-field (list (lwphw-alternative)))
                (lwlc-unknown (lwhew-evidence)) (lwhew-evidence)))
        (let probe-world
            (lwt-receive-stream world
                (list (lwphw-entry-k probe) (lwphw-entry-l probe))))
        (let placement (lwph-placement-for probe-world probe 2))
        (let answer-frame
            (lcfb-call-stream "living-world-hypothesis-enquiry" "answer"
                "leave" "form-native" "lwhe-probe-from-request/lwph-placement-for"
                "confirmed:2:diverged:2:no-promotion" 6 started
                "form/form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk"
                181 1))
        (let revocation
            (lwo-revocation space (lwphw-source-k) (lwhew-reason)
                (lwphw-prov-k)))
        (let revoked
            (lwt-receive-stream world (list (lwphw-entry-k revocation))))
        (let stale (lwhe-enquiry-for revoked space 2))
        (let revoke-frame
            (lcfb-call-stream "living-world-hypothesis-enquiry" "revocation"
                "leave" "form-native" "lwo-revocation/lwhe-enquiry-for"
                "space-current:0:history-retained:1" 7 started
                "form/form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk"
                193 1))
        (lwhew-result fixture enquiry separating aligned open chosen alternative
            invalid probe placement revoked stale)))
