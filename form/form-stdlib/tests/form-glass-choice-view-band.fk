; form-glass-choice-view-band.fk — the choice view: the points a reader is standing in front of,
; what each option is worth, how much of what was offered got through, and what the sequence asks for.
;
; Bits 1-8192 are PURE over a fixture: four choice points arrive the way the choice publisher gives them
; (one sample per point, the point carried in that sample's channels), so this band does not wait on any
; other lane to land.  Bit 2048 walks the whole play loop through the membrane's own control inbox: the
; take is offered as a command, consumed the way the choice organ consumes it, and applied -- and the
; point's ledger has moved. The band uses a process-private publisher and consumes only its own command;
; the living choice organ's inbox is never touched.
; Expected: 16383
; preludes: form-stdlib/form-glass-live.bml

(do
    (defn cvb-bit (ok bit) (if ok bit 0))
    (defn cvb-sample (id channels)
        (fgtm-sample id (fgtm-absent) "choice" "membrane" "choice" "choice" "choice point" (fgtm-absent) (fgtm-absent) "active" (fgtm-present 1) (fgtm-present 1) (fgtm-present 0) (fgtm-absent) "never" "declared" "band" channels))
    (defn cvb-text (line) (ftc-segment-text (head line)))
    (defn cvb-fits? (lines width)
        (if (eq (len lines) 0) 1
            (if (le (str_len (cvb-text (head lines))) width) (cvb-fits? (tail lines) width) 0)))
    (defn cvb-has-text? (lines needle)
        (if (eq (len lines) 0) 0
            (if (ge (str_find (cvb-text (head lines)) needle 0) 0) 1 (cvb-has-text? (tail lines) needle))))
    (defn cvb-finding-of (findings kind)
        (if (eq (len findings) 0) (list)
            (if (str_eq (fgch-finding-kind (head findings)) kind) (head findings) (cvb-finding-of (tail findings) kind))))

    ; ---- the fixture: four points, given the way the choice publisher gives them ----
    ; alpha flows: three of five offers were taken, one turned away, one still held
    (let alpha (cvb-sample "choice.alpha" (list "choice"
        "point|alpha|Which lane carries the next token?"
        "opt|metal|run it on the GPU carrier|2|9"
        "opt|mlx|run it on the MLX carrier|3|6"
        "out|metal|taken|100" "out|metal|taken|120" "out|mlx|taken|80" "out|metal|restricted|300" "out|metal|held|900")))
    ; beta is a corridor with a restrictor sitting in it
    (let beta (cvb-sample "choice.beta" (list "choice"
        "point|beta|Do we widen the ear window?"
        "opt|widen|carry eight seconds of context|4|7"
        "out|widen|taken|50" "out|widen|restricted|50" "out|widen|restricted|50" "out|widen|restricted|50")))
    ; gamma has never been offered at all -- dark, not refused
    (let gamma (cvb-sample "choice.gamma" (list "choice"
        "point|gamma|Should the glass name its own gaps?"
        "opt|name-them|render gaps beside wounds|1|8")))
    ; delta is held every time: the offer stands and nothing decides
    (let delta (cvb-sample "choice.delta" (list "choice"
        "point|delta|Do we let the hearth answer first?"
        "opt|let-it|route the prompt through the hearth|2|5"
        "out|let-it|held|900" "out|let-it|held|900" "out|let-it|held|900" "out|let-it|held|900")))
    (let noise (fgtm-sample "model.one" (fgtm-absent) "model" "metal" "band" "lane" "not a choice" (fgtm-absent) (fgtm-absent) "active" (fgtm-present 1) (fgtm-present 1) (fgtm-present 0) (fgtm-absent) "never" "declared" "band" (list "model")))
    (let samples (list alpha beta gamma delta noise))
    (let points (fgch-samples-points samples))

    ; 1 — the view is registered on every door the glass keys a view through
    (let b1 (cvb-bit (and (eq (fgd-view? "choice") 1) (and (eq (fgls-full-view? "choice") 1) (str_eq (fgl-control-key-view "d") "choice"))) 1))

    ; 2 — the three play keys map to actions, are supported, and ask for no argument
    (let b2 (cvb-bit
        (and (and (str_eq (fgl-control-key-action "g") "step") (and (str_eq (fgl-control-key-action "y") "take") (str_eq (fgl-control-key-action "w") "hold")))
             (and (and (eq (fgl-control-supported? "step") 1) (and (eq (fgl-control-supported? "take") 1) (eq (fgl-control-supported? "hold") 1)))
                  (and (eq (fgl-control-key-needs-argument? "g" "step") 0) (and (eq (fgl-control-key-needs-argument? "y" "take") 0) (eq (fgl-control-key-needs-argument? "w" "hold") 0))))) 2))

    ; 4 — the points decode from the samples' channels, and the model sample is not one of them
    (let b3 (cvb-bit
        (and (eq (len points) 4)
             (and (str_eq (fgch-point-id (head points)) "alpha")
                  (and (str_eq (fgch-point-question (head points)) "Which lane carries the next token?")
                       (and (eq (len (fgch-point-options (head points))) 2) (eq (len (fgch-point-ledger (head points))) 5))))) 4))

    (let pAlpha (nth points 0))
    (let pBeta (nth points 1))
    (let pGamma (nth points 2))
    (let pDelta (nth points 3))

    ; 8 — the shares: taken, restricted, held and the mean wait; never offered reads -1, never 0
    (let b4 (cvb-bit
        (and (and (eq (fgch-flow pAlpha) 60) (and (eq (fgch-restriction pAlpha) 20) (and (eq (fgch-holding pAlpha) 20) (eq (fgch-mean-wait pAlpha) 300))))
             (and (and (eq (fgch-flow pGamma) -1) (and (eq (fgch-restriction pGamma) -1) (eq (fgch-mean-wait pGamma) -1)))
                  (and (eq (fgch-flow pDelta) 0) (and (eq (fgch-holding pDelta) 100) (eq (fgch-ripening? pDelta) 1))))) 8))

    ; 16 — worth: an option is its reward less its cost, a point is its best option, a sequence is its points
    (let b5 (cvb-bit
        (and (eq (fgch-option-worth (head (fgch-point-options pAlpha))) 7)
             (and (eq (fgch-point-worth pAlpha) 7) (eq (fgch-total-worth points) 20))) 16))

    (let play (fgch-play points))

    ; 32 — the sequence's flow is its narrowest gate, and the most restricting step is named apart from it
    (let b6 (cvb-bit
        (and (and (str_eq (fgch-play-gate play) "gamma") (eq (fgch-play-flow play) -1))
             (and (str_eq (fgch-play-restricting play) "beta") (eq (fgch-play-worth play) 20))) 32))

    (let findings (fgch-play-findings play))
    (let dark (cvb-finding-of findings "gap-dark"))
    (let corridor (cvb-finding-of findings "gap-corridor"))
    (let restricting (cvb-finding-of findings "wound-restricting"))
    (let stalled (cvb-finding-of findings "wound-stalled"))

    ; 64 — all four findings arrive, each carrying what it asks for, and gaps part from wounds
    (let b7 (cvb-bit
        (and (and (gt (len dark) 0) (and (gt (len corridor) 0) (and (gt (len restricting) 0) (gt (len stalled) 0))))
             (and (and (gt (str_len (fgch-finding-asks dark)) 0) (and (gt (str_len (fgch-finding-asks corridor)) 0) (and (gt (str_len (fgch-finding-asks restricting)) 0) (gt (str_len (fgch-finding-asks stalled)) 0))))
                  (and (eq (len (fgch-gaps findings)) 2) (eq (len (fgch-wounds findings)) 2)))) 64))

    (let lines (fgch-view-lines samples "choice.2" 120 60))

    ; 128 — the view renders a row per point, a row per option, the play line and both finding sections
    ;       title + 4 points + 5 options + play + 2 section titles + 4 findings = 17
    (let b8 (cvb-bit
        (and (eq (len lines) 17)
             (and (and (eq (cvb-has-text? lines "alpha") 1) (eq (cvb-has-text? lines "metal") 1))
                  (and (and (eq (cvb-has-text? lines "PLAY steps=4") 1) (eq (cvb-has-text? lines "gate=gamma") 1))
                       (and (eq (cvb-has-text? lines "GAPS to nourish: 2") 1) (eq (cvb-has-text? lines "WOUNDS to heal: 2") 1))))) 128))

    ; 256 — the bar shows the taken and restricted shares; a point never offered shows a dash run, not a full bar
    (let b9 (cvb-bit
        (and (str_eq (fgch-bar pAlpha 10) "######::..")
             (and (str_eq (fgch-bar pGamma 10) "----------") (str_eq (fgch-bar pDelta 10) ".........."))) 256))

    ; 512 — every rendered line fits its width, narrow and wide
    (let b10 (cvb-bit
        (and (eq (cvb-fits? lines 120) 1)
             (and (eq (cvb-fits? (fgch-view-lines samples "choice.0" 80 60) 80) 1)
                  (eq (cvb-fits? (fgch-view-lines samples "choice.0" 40 60) 40) 1))) 512))

    ; 1024 — the cursor walks the slots and wraps: five slots over four points
    (let b11 (cvb-bit
        (and (eq (len (fgch-slots points)) 5)
             (and (and (str_eq (fgch-cursor-step "choice.2") "choice.3") (str_eq (fgch-cursor-step "all") "choice.0"))
                  (and (eq (fgch-cursor-at points "choice.5") 0)
                       (and (str_eq (fgch-point-id (head (fgch-cursor-slot points "choice.2"))) "beta")
                            (str_eq (fgch-option-id (nth (fgch-cursor-slot points "choice.2") 1)) "widen"))))) 1024))

    ; 2048 — a take under the cursor travels the control inbox and the point's ledger moves
    (let publisher (str_concat "choice.keyboard.band." (int_to_str (host_pid))))
    (let previous (fgl-control-state-full "all" "none" 0 "held" "choice" "all" "choice.2" 0))
    (let offer (fgtm-control-offer (FGLControlChannel) "band.take" 1 "take" (fgtm-absent) "declared" "band"))
    (let command (fgch-slot-command points "choice.2" "taken" 42))
    (let offered (fgl-choice-effect-to previous (fgl-control-proposed previous offer samples) offer samples 43 publisher))
    (let leased (fgl-choice-effect-to previous (fgl-control-proposed previous offer samples) offer samples 43 publisher))
    (let consumed (fgtm-command-consume publisher))
    (let moved (fgch-apply-outcome points (fgtm-command-value consumed)))
    (let movedBeta (nth moved 1))
    (let b12 (cvb-bit
        (and (str_eq command "outcome|beta|widen|taken|42")
             (and (and (and (str_eq (fgl-control-status offered) "take") (str_eq (fgl-control-status leased) "refused")) (str_eq (fgtm-command-status consumed) "ready"))
                  (and (and (eq (len (fgch-point-ledger pBeta)) 4) (eq (len (fgch-point-ledger movedBeta)) 5))
                       (and (eq (fgch-flow pBeta) 25) (eq (fgch-flow movedBeta) 40))))) 2048))

    ; 4096 — with nothing published the view names the door that owes the points, never a bare ?
    (let empty (fgch-view-lines (list noise) "choice.0" 100 20))
    (let b13 (cvb-bit
        (and (eq (cvb-has-text? empty "door=gift:choice") 1)
             (and (eq (cvb-has-text? empty "publisher=choice") 1) (eq (cvb-has-text? empty "form-choice-flow") 1))) 4096))

    ; 8192 — the choice most worth putting in front of a reader is the first step that asks for something
    (let b14 (cvb-bit (str_eq (fgch-point-id (fgch-next-choice points)) "beta") 8192))

    (let closed (fgtm-command-consume publisher))
    (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 (add b9 (add b10 (add b11 (add b12 (add b13 b14))))))))))))))
