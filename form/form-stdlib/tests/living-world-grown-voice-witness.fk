; living-world-grown-voice-witness.fk -- learned symbol candidates voice a Recipe.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk

(let LWGVW-SOURCE-G (bp "LWGVW-SOURCE-G"))
(let LWGVW-PROV-G (bp "LWGVW-PROV-G"))
(let LWGVW-CAPABILITY (bp "LWGVW-CAPABILITY"))
(let LWGVW-EVIDENCE (bp "LWGVW-EVIDENCE"))
(let LWGVW-ALTERNATE (bp "LWGVW-ALTERNATE"))

(defn lwgvw-cell (kind) (intern_node kind (empty)))
(defn lwgvw-source-g () (lwgvw-cell LWGVW-SOURCE-G))
(defn lwgvw-prov-g () (lwgvw-cell LWGVW-PROV-G))
(defn lwgvw-capability () (lwgvw-cell LWGVW-CAPABILITY))
(defn lwgvw-evidence () (lwgvw-cell LWGVW-EVIDENCE))
(defn lwgvw-alternate () (lwgvw-cell LWGVW-ALTERNATE))

(defn lwgvw-recipe-world ()
    (lwt-round-world (lwrew-integrated-round)))
(defn lwgvw-learning-round ()
    (lwslw-integrated-round-from (lwgvw-recipe-world)))
(defn lwgvw-learning-world ()
    (lwt-round-world (lwgvw-learning-round)))
(defn lwgvw-learning-proposals ()
    (lwt-round-proposals
        (lwslw-round-from (lwgvw-recipe-world))))
(defn lwgvw-forty-candidate ()
    (lwt-proposal-candidate
        (lwslw-find-proposal
            (lwgvw-learning-proposals) "forty")))
(defn lwgvw-nine-candidate ()
    (lwt-proposal-candidate
        (lwslw-find-proposal
            (lwgvw-learning-proposals) "-nine")))
(defn lwgvw-basis ()
    (lwt-proposal-candidate
        (lwrew-proposal-for-world (lwrew-world))))
(defn lwgvw-referent () (intern_trivial_int 49))

(defn lwgvw-entry-for (source provenance payload)
    (lwt-entry
        (lwo-offer source (lwo-interface (list (lwrew-action)))
            1 payload provenance 1)
        (lwrew-action)))
(defn lwgvw-entry-g (payload)
    (lwgvw-entry-for (lwgvw-source-g) (lwgvw-prov-g) payload))
(defn lwgvw-grant-entry (source provenance payload)
    (lwgvw-entry-for source provenance
        (lwcp-grant payload (lwgvw-capability) (lwgvw-evidence))))

(defn lwgvw-world ()
    (lwt-receive-stream (lwgvw-learning-world)
        (list
            (lwgvw-entry-g (lwgvw-capability))
            ; Executed-referent ground.
            (lwgvw-grant-entry (lwrew-source-a) (lwrew-prov-a)
                (lwgvw-basis))
            (lwgvw-grant-entry (lwrew-source-b) (lwrew-prov-b)
                (lwgvw-basis))
            (lwgvw-grant-entry (lwrew-source-a) (lwrew-prov-a)
                (lwrew-recipe))
            (lwgvw-grant-entry (lwrew-source-a) (lwrew-prov-a)
                (lwrew-declaration))
            (lwgvw-grant-entry (lwrew-source-b) (lwrew-prov-b)
                (lwrew-before))
            ; Learned symbol candidates: every integrated holder grants.
            (lwgvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwgvw-forty-candidate))
            (lwgvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwgvw-forty-candidate))
            (lwgvw-grant-entry (lwslw-source-c) (lwslw-prov-c)
                (lwgvw-forty-candidate))
            (lwgvw-grant-entry (lwslw-source-d) (lwslw-prov-d)
                (lwgvw-forty-candidate))
            (lwgvw-grant-entry (lwslw-source-e) (lwslw-prov-e)
                (lwgvw-forty-candidate))
            (lwgvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwgvw-nine-candidate))
            (lwgvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwgvw-nine-candidate))
            ; Exact observation ground needed to re-derive current symbols.
            (lwgvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwslw-forty-support))
            (lwgvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwslw-forty-support))
            (lwgvw-grant-entry (lwslw-source-c) (lwslw-prov-c)
                (lwslw-forty-alternative))
            (lwgvw-grant-entry (lwslw-source-d) (lwslw-prov-d)
                (lwslw-forty-dissent))
            (lwgvw-grant-entry (lwslw-source-e) (lwslw-prov-e)
                (lwslw-forty-silence))
            (lwgvw-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwslw-nine-support))
            (lwgvw-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwslw-nine-support)))))

(defn lwgvw-context-for (world)
    (lwcp-context world (lwgvw-capability)))
(defn lwgvw-context () (lwgvw-context-for (lwgvw-world)))
(defn lwgvw-choice ()
    (lwlc-choice (lwrew-action)
        (lwo-field (list (lwgvw-alternate)))
        (lwlc-unknown (lwgvw-evidence))
        (lwgvw-evidence)))

(defn lwgvw-proposal-for (world)
    (lwnv-proposal (lwgvw-context-for world)
        (lwgvw-basis) (lwgvw-referent)
        (lwo-field
            (list
                (oac-alternative (lwgvw-basis)
                    (lwgvw-alternate) (lwgvw-evidence))))
        (lwlc-unknown (lwgvw-evidence))
        (lwgvw-choice) (lwgvw-evidence)))

(defn lwgvw-round ()
    (do
        (let world (lwgvw-world))
        (let proposal (lwgvw-proposal-for world))
        (lwt-round world
            (lwo-field-add (lwo-empty-field) proposal)
            (lwo-empty-field) (lwo-none))))

(defn lwgvw-response (source provenance proposal)
    (lwgvw-entry-for source provenance
        (lwt-response proposal (oac-one proposal) provenance)))

(defn lwgvw-yes-round ()
    (do
        (let round (lwgvw-round))
        (let proposal
            (head (lwo-field-items (lwt-round-proposals round))))
        (lwt-round-receive round
            (list
                (lwgvw-response (lwrew-source-a) (lwrew-prov-a) proposal)
                (lwgvw-response (lwrew-source-b) (lwrew-prov-b) proposal)
                (lwgvw-response (lwslw-source-a) (lwslw-prov-a) proposal)
                (lwgvw-response (lwslw-source-b) (lwslw-prov-b) proposal)
                (lwgvw-response (lwslw-source-c) (lwslw-prov-c) proposal)
                (lwgvw-response (lwslw-source-d) (lwslw-prov-d) proposal)
                (lwgvw-response (lwslw-source-e) (lwslw-prov-e) proposal)
                (lwgvw-response (lwgvw-source-g) (lwgvw-prov-g) proposal)))))

(defn lwgvw-integrated-round ()
    (do
        (let round (lwgvw-yes-round))
        (let proposal
            (head (lwo-field-items (lwt-round-proposals round))))
        (lwnv-integrate round proposal (lwrew-action))))

(defn lwgvw-late-world ()
    (lwt-receive-stream (lwgvw-world)
        (list (lwslw-entry-f (lwslw-late-alternative)))))

(defn lwgvw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwgvw-sum (tail items)))))
