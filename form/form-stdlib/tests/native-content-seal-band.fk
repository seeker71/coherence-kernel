; SHA-256 padding edges against independent Form compression, plus a two-leaf tree.
; preludes: form-stdlib/native-content-seal.bml
(do
 (defn ncsb-bytes (xs) (if (nil? xs) "" (str_concat (byte_to_str (head xs)) (ncsb-bytes (tail xs)))))
 (defn ncsb-repeat (n) (if (eq n 0) "" (str_concat "a" (ncsb-repeat (sub n 1)))))
 (defn ncsb-check (sizes) (if (nil? sizes) 1
  (do (let text (ncsb-repeat (head sizes)))
   (and (str_eq (ncs-string text) (ncsb-bytes (sha256-stream-string text))) (ncsb-check (tail sizes))))))
 (let vectors (ncsb-check (list 0 3 55 56 63 64 65 119 120 128)))
 (let text (ncsb-repeat 80)) (let h (nam-write (nam-held (metal_buf_alloc 80)) text))
 (let actual (ncs-tree h 80 64))
 (let expected (ncsb-bytes (sha256-stream-string (str_concat (ncs-domain 80 64) (str_concat (ncsb-bytes (sha256-stream-string (substring text 0 64))) (ncsb-bytes (sha256-stream-string (substring text 64 80))))))))
 (let tree (str_eq actual (ncs-hex expected 0))) (nam-free (list h))
 (let abc (str_eq (ncs-hex (ncs-string "abc") 0) "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))
 (print (list "padding-vectors" vectors "tree-equal" tree "FIPS-abc" abc "retained" (nth (metal_live) 2)))
 (if (and vectors (and tree (and abc (eq (nth (metal_live) 2) 0)))) 15 (form_error "native content seal witness failed")))
