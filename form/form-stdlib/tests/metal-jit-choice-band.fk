; Two domain policies coexist over real resident GPU programs. A failing
; re-witness releases selection while preserving the scoped evidence value.
; Expected 262143; arbitrary thought addresses coexist and retire independently.
; preludes: form-stdlib/bml/metal-jit-choice.bml
(do
 (defn mjqb-source (scale)
  (mj-source (str_concat "kernel void scale_value(device uint *out [[buffer(0)]]) { out[0] = 7u * " (str_concat (int_to_str scale) "u; }"))))
 (defn mjqb-run (version buffer)
  (if (eq (mj-enqueue version (md-bind (list buffer) (list)) 1) 1) (metal_buf_read buffer 0 4) "refused"))
 (defn mjqb-all (checks) (if (nil? checks) 1 (and (head checks) (mjqb-all (tail checks)))))
 (defn mjqb-thought-run (table address buffer)
  (if (eq (metal_enqueue (mj-thought-recall table address) (md-bind (list buffer) (list)) 1) 1) (metal_buf_read buffer 0 4) "refused"))
 (defn mjqb-addresses (first second)
  (do
   (let table (mj-thought-table))
   (let buffer (metal_buf_alloc 4))
   (let a (mj-thought table first (mjqb-source 2) "scale_value" 0 ""))
   (let b (mj-thought table second (mjqb-source 3) "scale_value" 0 ""))
   (let ha (mj-thought-recall table first))
   (let hb (mj-thought-recall table second))
   (let ra (mjqb-thought-run table first buffer))
   (let rb (mjqb-thought-run table second buffer))
   (let retired (mj-thought-release table first))
   (let preserved (mjqb-thought-run table second buffer))
   (let replacement (mj-thought table first (mjqb-source 4) "scale_value" 0 ""))
   (let rh (mj-thought-recall table first))
   (let stale (metal_enqueue ha (md-bind (list buffer) (list)) 1))
   (let renewed (mjqb-thought-run table first buffer))
   (let stable (mjqb-thought-run table second buffer))
   (let released (add (mj-thought-release table first) (mj-thought-release table second)))
   (let freed (metal_buf_free buffer))
   (mjqb-all (list (not (nothing? a)) (not (nothing? b)) (not (eq ha hb))
    (str_eq ra (md-le32 14)) (str_eq rb (md-le32 21)) (eq retired 1)
    (str_eq preserved rb) (not (nothing? replacement)) (not (eq ha rh))
    (eq stale 0) (str_eq renewed (md-le32 28)) (str_eq stable rb)
    (eq released 2) (eq freed 1)))))
 (let a (mj-memory (mjqb-source 2) "scale_value"))
 (let b (mj-memory (mjqb-source 3) "scale_value"))
 (let buffer (metal_buf_alloc 4))
 (let ra (mjqb-run a buffer))
 (let rb (mjqb-run b buffer))
 (let pa (mjc-witness 1 "double" a 20260910 (md-le32 14) ra))
 (let pb (mjc-witness 2 "triple" b 20260910 (md-le32 21) rb))
 (let ca (mjc-choose pa "double" 20260910))
 (let cb (mjc-choose pb "triple" 20260910))
 (let selected-a (mjqb-run ca buffer))
 (let selected-b (mjqb-run cb buffer))
 (let released (mjc-rewitness pa 20260911 (md-le32 14) rb))
 (let renewed (mjc-rewitness pb 20260911 (md-le32 21) rb))
 (let thought (mj-thought (mj-thought-table) "scale/2" (mjqb-source 2) "scale_value" 0 ""))
 (let recalled (mj-thought thought "scale/2" (mjqb-source 2) "scale_value" 0 ""))
 (let thought-handle (mj-thought-recall thought "scale/2"))
 (let recalled-handle (mj-thought-recall recalled "scale/2"))
 (let thought-enqueued (metal_enqueue thought-handle (md-bind (list buffer) (list)) 1))
 (let thought-bytes (metal_buf_read buffer 0 4))
 (let collision (mj-thought thought "scale/2" (mjqb-source 3) "scale_value" 0 ""))
 (let entry-collision (mj-thought thought "scale/2" (mjqb-source 2) "another_entry" 0 ""))
 (let retired-thought (mj-thought-release thought "scale/2"))
 (let stale-thought (metal_enqueue thought-handle (md-bind (list buffer) (list)) 1))
 (let replaced (mj-thought thought "scale/2" (mjqb-source 3) "scale_value" 0 ""))
 (let replacement-handle (mj-thought-recall replaced "scale/2"))
 (let replacement-enqueued (metal_enqueue replacement-handle (md-bind (list buffer) (list)) 1))
 (let replacement-bytes (metal_buf_read buffer 0 4))
 (let freed (metal_buf_free buffer))
 (let retired-all (add (mj-release a) (add (mj-release b) (mj-thought-release replaced "scale/2"))))
 (let suffix-order (mjqb-addresses "x" "x#src"))
 (let prefix-order (mjqb-addresses "x#src" "x"))
 (let any-address (mjqb-addresses "" "kind"))
 (let malformed (record_set (mj-thought-table) "occupied" -2))
 (let malformed-refused (mj-thought malformed "occupied" (mjqb-source 2) "scale_value" 0 ""))
 (let after (str_concat "\n" (metal_status)))
 (sum (list
  (if (and (str_eq ra (md-le32 14)) (str_eq rb (md-le32 21))) 1 0)
  (if (and (str_eq selected-a ra) (str_eq selected-b rb)) 2 0)
  (if (nothing? (mjc-choose pa "triple" 20260910)) 4 0)
  (if (nothing? (mjc-choose pa "double" 20260911)) 8 0)
  (if (nothing? (mjc-choose released "double" 20260911)) 16 0)
  (if (eq (mj-handle (mjc-choose renewed "triple" 20260911)) (mj-handle b)) 32 0)
  (if (eq (mj-handle (mjc-choose pa "double" 20260910)) (mj-handle a)) 64 0)
  (if (and (gt thought-handle 0) (not (eq thought-handle (mj-handle a)))) 128 0)
  (if (and (eq thought-handle recalled-handle) (and (eq thought-enqueued 1) (str_eq thought-bytes (md-le32 14)))) 256 0)
  (if (and (nothing? collision) (nothing? entry-collision)) 512 0)
  (if (eq freed 1) 1024 0)
  (if (and (eq retired-thought 1) (eq stale-thought 0)) 2048 0)
  (if (and (not (eq replacement-handle thought-handle)) (and (eq replacement-enqueued 1) (str_eq replacement-bytes (md-le32 21)))) 4096 0)
  (if (and (eq retired-all 3) (eq (mj-thought-release replaced "scale/2") 0)) 8192 0)
  (if suffix-order 16384 0)
  (if prefix-order 32768 0)
  (if any-address 65536 0)
  (if (and (nothing? malformed-refused) (and (eq (record_get malformed "occupied") -2)
       (and (ge (str_find after "\npipelines=0\n" 0) 0)
            (ge (str_find after "\npipeline_cache_entries=0\n" 0) 0)))) 131072 0))))
