; living-world-expression-blueprint-voice-observation.fk -- bounded consent,
; time, dissent, admission, and revocation view; no surface payload is emitted.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk form-stdlib/tests/living-world-expression-blueprint-witness.fk

(do
    (let world (lwxbw-application-world))
    (let rich (lwxbw-rich-plan))
    (let utterance (lwxbw-utterance))
    (let proposal (lwxbw-voice-proposal))
    (let dissent (lwxbw-dissent-round-build))
    (let dissent-outcome
        (lwt-evaluate-proposal (lwt-round-world dissent) proposal))
    (let refused (lwxb-integrate dissent proposal (lwxbw-action)))
    (let admitted (lwxbw-voice-world))
    (let revoked (lwxbw-revoked-world))
    (let expected-surface
        (str_concat
            (lwnv-symbol-surface
                (lwo-emergent-shape (lwxbw-left)))
            (str_concat
                (lwnv-symbol-surface
                    (lwo-emergent-shape (lwxbw-alternate)))
                (lwnv-symbol-surface
                    (lwo-emergent-shape (lwxbw-right))))))
    (let pending (lwxb-time-observation rich (intern_trivial_int 9)))
    (let expired (lwxb-time-observation rich (intern_trivial_int 10)))
    (list
        (if (str_eq (lwxb-utterance-surface utterance)
                expected-surface) 1 0)
        (oac-one? (lwxb-utterance-immediate utterance))
        (lwo-field-size (lwxb-utterance-alternatives utterance))
        (lwlc-unknown? (lwxb-utterance-unknown utterance))
        (lwlc-choice? (lwxb-utterance-choice utterance))
        (oac-timeout-valid? (lwxb-utterance-timeout utterance))
        (lwo-field-size (lwxb-utterance-witnesses utterance))
        (lwo-field-size (lwt-proposal-participants proposal))
        (oac-time-pending? pending)
        (oac-time-outcome? expired)
        (oac-alternative-ack? (oac-time-outcome-ack expired))
        (if (node_eq (lwxb-utterance-immediate utterance)
                (oac-time-outcome-ack expired)) 0 1)
        (if (node_eq (lwt-outcome-status dissent-outcome)
                (lwt-status-dissented)) 1 0)
        (lwo-world-has? (lwt-round-world refused)
            (lwt-proposal-candidate proposal))
        (lwo-active? admitted (lwt-proposal-candidate proposal))
        (lwxb-plan-current? admitted rich)
        (lwxb-utterance-current? admitted utterance)
        (lwxb-material-current? revoked (lwxbw-heldout-material))
        (lwxb-application-current? revoked
            (lwxbw-application-candidate-a))
        (lwxb-plan-current? revoked rich)
        (lwxb-utterance-current? revoked utterance)))
