; hearth-glass-band.fk — the glass renders pure: shade ramp, seconds
; decomposition, latency color, sparkline, symbols, ledger line,
; age-wearing (every lane shows how old its point is).
; Expected: 32767
; preludes: form-stdlib/hearth-glass.bml
(do
    (defn hgb-bit (ok bit) (if ok bit 0))
    (sum (list
        (hgb-bit (eq (str_len (gl-seconds-bar 3500)) 9) 1)
        (hgb-bit (eq (str_len (gl-seconds-bar 200)) 3) 2)
        (hgb-bit (ge (str_find (gl-lat-line "t " 400) "[32m" 0) 0) 4)
        (hgb-bit (ge (str_find (gl-lat-line "t " 7000) "[31m" 0) 0) 8)
        (hgb-bit (eq (str_len (gl-spark (list 1 2 3 4))) 12) 16)
        (hgb-bit (ge (str_find (gl-ledger-line "prefill" 5 "ms=440704") "prefill t=5 ms=440704" 0) 0) 32)
        (hgb-bit (eq (gl-pct (list 10 20 30 40 100) 50) 30) 64)
        (hgb-bit (eq (gl-pct (list 10 20 30 40 100) 95) 100) 128)
        (hgb-bit (eq (gl-newest (gl-collect "pos=1339 x pos=1463" "pos")) 1463) 256)
        (hgb-bit (eq (str_len (gl-gauge 36)) 18) 512)
        (hgb-bit (str_eq (gl-word-field "a\nsignal=choice b" "signal") "choice") 1024)
        (hgb-bit (str_eq (gl-turns-line (gl-waiting-turns (list 1 2 3) (list 3 1))) " 2") 2048)
        (hgb-bit (str_eq (gl-phase-line 1 0 2) "gas=1 water=0 ice=2") 4096)
        (hgb-bit (str_eq (gl-age-text 45) "45s") 8192)
        (hgb-bit (str_eq (gl-age-text 7200) "2h") 16384))))
