; hearth-glass-band.fk — the glass data vocabulary: collectors,
; percentiles, field readers (the newest signal speaks, not the
; oldest), waiting-set diffs, phase text, ledger line.
; Expected: 2097151
; preludes: form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/lane-motion.bml form-stdlib/hearth-glass-door.bml form-stdlib/spool-bell-transport.fk
(do
    (defn hgb-bit (ok bit) (if ok bit 0))
    (let active "before\nform-peer stage route=direct-answer phase=observe status=begin generated=0 stamp-ms=1000\n")
    (let settled (str_concat active "form-peer stage route=direct-answer phase=run status=value generated=7 stamp-ms=1100\n"))
    (sum (list
        (hgb-bit (eq (gl-newest (gl-collect "pos=1339 x pos=1463" "pos")) 1463) 1)
        (hgb-bit (eq (gl-pct (list 10 20 30 40 100) 50) 30) 2)
        (hgb-bit (eq (gl-pct (list 10 20 30 40 100) 95) 100) 4)
        (hgb-bit (str_eq (gl-word-field "a\nsignal=choice b" "signal") "choice") 8)
        (hgb-bit (str_eq (gl-word-field-last "signal=old x signal=new y" "signal") "new") 16)
        (hgb-bit (str_eq (gl-turns-line (gl-waiting-turns (list 1 2 3) (list 3 1))) " 2") 32)
        (hgb-bit (str_eq (gl-phase-line 1 0 2) "gas=1 water=0 ice=2") 64)
        (hgb-bit (ge (str_find (gl-ledger-line "prefill" 5 "ms=440704") "prefill t=5 ms=440704" 0) 0) 128)
        (hgb-bit (eq (gl-count-of "turn=1 turn=2" "turn=") 2) 256)
        (hgb-bit (eq (len (gl-waiting-turns (list 4 5 6) (list 5))) 2) 512)
        (hgb-bit (and (str_eq (gl-direct-phase active) "observe")
            (and (str_eq (gl-direct-flight-phase active) "observe")
                 (eq (gl-direct-flight? active) 1))) 1024)
        (hgb-bit (and (eq (gl-direct-flight-age active 3500) 2500)
            (ge (str_find (gl-direct-stage-line active) "stamp-ms=1000" 0) 0)) 2048)
        (hgb-bit (and (str_eq (gl-direct-phase settled) "run")
            (and (str_eq (gl-direct-flight-phase settled) "none")
            (and (eq (gl-direct-flight? settled) 0)
                 (eq (gl-direct-flight-age settled 9999) 0)))) 4096)
        (hgb-bit (str_eq (gl-line-field
            "capabilities=direct-answer-v1 hearth-telemetry-v2\n" "capabilities")
            "direct-answer-v1 hearth-telemetry-v2") 8192)
        (hgb-bit (str_eq (gl-line-field-last "task=old ask\nx\ntask=the new ask here\ny" "task") "the new ask here") 16384)
        (hgb-bit (and (str_eq (gl-clip "abcdef" 4) "abcd...") (str_eq (gl-clip "ab" 4) "ab")) 32768)
        (hgb-bit (str_eq (gl-body-after "x<|form:response|>\n<think>\n\n</think>\nthe body line\nrest" "<|form:response|>") "the body line") 65536)
        (hgb-bit (eq (gl-turn-before "turn=7 a\nturn=9 b lifecycle=choice\nturn=11 c" (str_find "turn=7 a\nturn=9 b lifecycle=choice\nturn=11 c" "lifecycle=" 0)) 9) 131072)
        (hgb-bit (str_eq (gl-stage-field "x\nform-peer stage route=task-observation phase=begin status=choice stamp-ms=5\ny" "route") "task-observation") 262144)
        (hgb-bit (str_eq (gl-stage-field (str_concat "form-peer stage route=policy phase=a status=b stamp-ms=1\n" "form-peer stage route=direct-answer phase=run status=begin stamp-ms=2\n") "phase") "run") 524288)
        (hgb-bit (and (eq (hgd-frame-on-tick? 1) 1) (eq (hgd-frame-on-tick? 0) 0)) 1048576))))
