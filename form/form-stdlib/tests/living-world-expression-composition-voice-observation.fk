; living-world-expression-composition-voice-observation.fk -- local voice,
; optional time, dissent, admission, and selective revocation stage.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk form-stdlib/living-world-expression-composition.fk form-stdlib/tests/living-world-expression-blueprint-witness.fk form-stdlib/tests/living-world-expression-composition-witness.fk

(do
    (let rich (lwxcbw-rich-plan))
    (let utterance (lwxcbw-utterance))
    (let proposal (lwxcbw-utterance-proposal))
    (let dissent (lwxcbw-dissent-round-build))
    (let refused
        (lwxc-integrate-utterance dissent proposal (lwxbw-action)))
    (let admitted (lwxcbw-voice-world))
    (let revoked (lwxcbw-revoked-world))
    (let pending
        (lwxc-time-observation rich (intern_trivial_int 9)))
    (let expired
        (lwxc-time-observation rich (intern_trivial_int 10)))
    (let expected-surface
        (str_concat
            (lwnv-symbol-surface
                (lwo-emergent-shape (lwxbw-left)))
            (str_concat
                (lwnv-symbol-surface
                    (lwo-emergent-shape (lwxbw-right)))
                (lwnv-symbol-surface
                    (lwo-emergent-shape (lwxbw-alternate))))))
    (list
        (if (str_eq (lwxc-utterance-surface utterance)
                expected-surface) 1 0)
        (oac-one? (lwxc-utterance-immediate utterance))
        (lwo-field-size (lwxc-utterance-witnesses utterance))
        (lwo-field-size (lwt-proposal-participants proposal))
        (oac-time-pending? pending)
        (oac-time-outcome? expired)
        (oac-alternative-ack? (oac-time-outcome-ack expired))
        (if (node_eq
                (lwt-outcome-status
                    (lwt-evaluate-proposal
                        (lwt-round-world dissent) proposal))
                (lwt-status-dissented)) 1 0)
        (lwo-world-has? (lwt-round-world refused)
            (lwt-proposal-candidate proposal))
        (lwo-active? admitted (lwt-proposal-candidate proposal))
        (lwxc-plan-current? admitted rich)
        (lwxc-utterance-current? admitted utterance)
        (lwxc-chain-integrated-current? revoked
            (lwxcbw-chain-candidate-c))
        (lwxc-application-integrated-current? revoked
            (lwxcbw-application-candidate-c))
        (lwxc-plan-current? revoked rich)
        (lwxc-utterance-current? revoked utterance)))
