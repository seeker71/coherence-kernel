; Empty live evidence is a valid no-quality-observation, not a broken replay.
; preludes: form-stdlib/core.fk form-stdlib/rag-embed.fk form-stdlib/rag-retrieve.fk form-stdlib/native-model-session-grounding.fk

(do
    (let digest "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    (let candidates (list
        (nmsg-candidate "form/form-stdlib/core.fk" "core cell list arithmetic")
        (nmsg-candidate "form/form-stdlib/oracle-catalog.fk" "local remote oracle catalog")))
    (let summary
        (nmsg-daily-summary candidates (list)
            (nmsg-daily-context digest digest digest -1 0 9 3 12 0 99)))
    (if (and (ge (str_find summary "replayed_queries=0" 0) 0)
             (and (ge (str_find summary "evidence_state=no-replayable-live-indexed-query" 0) 0)
                  (and (ge (str_find summary "replay_valid=1" 0) 0)
                       (and (ge (str_find summary "label_pool_coverage_ppm=0" 0) 0)
                            (and (ge (str_find summary "top5_delta_ppm=-1" 0) 0)
                                 (lt (str_find summary "query_1_" 0) 0)))))) 31 0))
