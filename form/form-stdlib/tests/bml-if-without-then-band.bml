; bml-if-without-then-band.bml — an if reads with or without `then` before its branch (grammars/form-bml.fk, ifx).
; A local voice wrote `if (c) { a } else { b }` and `if c { a } else { b }` in its references and the cursor
; stopped at the token before the brace; both now read as `if c then { a } else { b }`.
;
; Verdict 15 when every claim lands:
;   1    a parenthesized condition with braced branches and no then
;   2    a bare condition whose last word stands before the brace is no record literal
;   4    else if chains without then
;   8    the spelling with then reads as before, in a block and in an expression
; preludes: form-stdlib/core.fk
section [form.bml] {
 class BmlIfWithoutThenBand {
  def biw-paren(x) { if (x > 0 && x >= 0) { let y = x + 1; y; } else { -1; }; }
  def biw-clamp(floor, window) {
   let half = window / 2;
   if floor > half { half; } else { floor; }
  }
  def biw-sign(x) { if x > 0 { 1; } else if x == 0 { 0; } else { -1; }; }
  def biw-then(x) = if x > 0 then { let y = x; y; } else 0;
  def biw-plain(x) = if x > 0 then 1 else 0;
 }
 (biw-paren(4) == 5 && biw-paren(-3) == -1 ? 1 : 0)
  + (biw-clamp(9, 10) == 5 && biw-clamp(3, 10) == 3 ? 2 : 0)
  + (biw-sign(-2) == -1 && biw-sign(0) == 0 && biw-sign(7) == 1 ? 4 : 0)
  + (biw-then(4) == 4 && biw-then(-1) == 0 && biw-plain(2) == 1 ? 8 : 0);
}
