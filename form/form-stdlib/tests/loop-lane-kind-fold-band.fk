; loop-lane-kind-fold-band.fk -- a kind the leaf already knows is not asked: value_kind folds in the lane.
;
; value_kind answers a word's kind as a string, and the lane had no arm for it (-1201), so int_to_str, whose dispatch
; asks (str_eq (value_kind n) "string") and its siblings, walked for every number. Inside a leaf most values carry
; their type from the frame -- an int parameter is an int, a float a float -- so the kind test is a constant the lane
; folds at compile time: an if whose condition folds admits only the arm it takes, and a compare of two constants is
; a constant. int_to_str compiles for ints; its value_str arm, dead for an int, is never admitted. A record is its own
; odd word band, so an int is never a record's word and its kind is "int" in every run.
;
; Verdict 31
; PROOF LEVEL: FOURTH-ARM ONLY (crystallization is fkwu's MAP_JIT lane; a defn's native state is the 8th hot-row field)
; preludes: form-stdlib/core.fk
;
;   1   int_to_str, driven hot on ints, reads state 1 and answers as it did cold, over edge ints
;   2   a kind test over a typed parameter reads state 1 and answers 1 for a float, 0 for an int, a string and a list
;   4   a leaf whose dead arm holds an operation the lane declines compiles when its condition is a constant
;   8   int_to_str of a float, a string and a list still answers as value_str writes them (those take the walker)
;  16   with records minted, -1 and -2 are still ints and a record a record, cold and hot (kindshadow, row 1525)
(do
    (defn kfb-bit (ok bit) (if ok bit 0))
    (defn kfb-state (name rows) (if (eq (len rows) 0) -99 (if (str_eq (nth (head rows) 1) name) (nth (head rows) 7) (kfb-state name (tail rows)))))
    (defn kfb-native (name) (kfb-state name (kernel_page_hot (host_pid) 300)))
    (defn kfb-lt? (a b) (if (lt (host_monotonic_ms) 0) false (lt a b))) ; a host clock the lane declines: the drivers walk
    ; 1: int_to_str hot on ints, against its own cold answers
    (let cold-ints (list (int_to_str 0) (int_to_str 7) (int_to_str -1) (int_to_str 1234567890123) (int_to_str -9876543210)))
    (defn kfb-drive (n acc) (if (kfb-lt? 0 n) (kfb-drive (sub n 1) (add acc (str_len (int_to_str n)))) acc))
    (let driven (kfb-drive 3000 0))
    (let its-state (kfb-native "int_to_str"))
    (let hot-ints (list (int_to_str 0) (int_to_str 7) (int_to_str -1) (int_to_str 1234567890123) (int_to_str -9876543210)))
    (let ints-ok (if (eq its-state 1) (if (value_eq hot-ints cold-ints) (value_eq hot-ints (list "0" "7" "-1" "1234567890123" "-9876543210")) false) false))
    ; 2: a kind test over a typed parameter, one instance per type
    (defn kfb-float? (x) (if (str_eq (value_kind x) "float") 1 0))
    (defn kfb-drive-f (n acc) (if (kfb-lt? 0 n) (kfb-drive-f (sub n 1) (add acc (add (kfb-float? 2.5) (kfb-float? 3)))) acc))
    (let fsum (kfb-drive-f 3000 0))
    (let kf-state (kfb-native "kfb-float?"))
    (let kind-ok (if (eq kf-state 1) (if (eq fsum 3000) (if (eq (kfb-float? 2.5) 1) (if (eq (kfb-float? 7) 0) (if (eq (kfb-float? "s") 0) (eq (kfb-float? (list 1)) 0) false) false) false) false) false))
    ; 4: a dead arm under a constant condition is never admitted
    (defn kfb-dead (x) (if (eq 1 2) (value_str x) (add x 1)))
    (defn kfb-drive-d (n acc) (if (kfb-lt? 0 n) (kfb-drive-d (sub n 1) (add acc (kfb-dead n))) acc))
    (let dsum (kfb-drive-d 3000 0))
    (let dead-state (kfb-native "kfb-dead"))
    (let dead-ok (if (eq dead-state 1) (if (eq (kfb-dead 41) 42) (eq dsum 4504500) false) false))
    ; 8: the other kinds still answer through value_str
    (let others-ok (if (str_eq (int_to_str 2.5) "2.5") (if (str_eq (int_to_str "abc") "abc") (str_eq (int_to_str (list 1 2)) "[1, 2]") false) false))
    ; 16: a record's word is no integer's -- -1 answers "int" however many records exist, and the hot fold agrees
    (defn kfb-int? (x) (if (str_eq (value_kind x) "int") 1 0))
    (defn kfb-record? (x) (if (str_eq (value_kind x) "record") 1 0))
    (let minted (record_new (make_nodeid 1 5 4 1)))
    (let minted2 (record_new (make_nodeid 1 5 4 1)))
    (defn kfb-drive-s (n acc) (if (kfb-lt? 0 n) (kfb-drive-s (sub n 1) (add acc (add (mul 2 (kfb-int? (sub 0 (add 1 (mod n 2))))) (kfb-record? -1)))) acc))
    (let ssum (kfb-drive-s 3000 0))
    (let int-state (kfb-native "kfb-int?"))
    (let shadow-ok (if (eq ssum 6000) (if (eq int-state 1) (if (str_eq (value_kind -1) "int") (if (eq (record? -2) 0) (if (eq (kfb-record? minted2) 1) (str_eq (value_kind minted) "record") false) false) false) false) false))
    (let told (print (list "states" its-state kf-state dead-state int-state "sums" driven fsum dsum ssum)))
    (add (kfb-bit ints-ok 1) (add (kfb-bit kind-ok 2) (add (kfb-bit dead-ok 4) (add (kfb-bit others-ok 8) (kfb-bit shadow-ok 16))))))
