; living-world-action-cycle-witness.fk -- one opaque action learns its delta.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/tests/living-world-recipe-execution-witness.fk

(let LWACW-FOCUS      (bp "LWACW-FOCUS"))
(let LWACW-ACTION-A   (bp "LWACW-ACTION-A"))
(let LWACW-ACTION-B   (bp "LWACW-ACTION-B"))
(let LWACW-SOURCE-C   (bp "LWACW-SOURCE-C"))
(let LWACW-SOURCE-D   (bp "LWACW-SOURCE-D"))
(let LWACW-SOURCE-E   (bp "LWACW-SOURCE-E"))
(let LWACW-SOURCE-H   (bp "LWACW-SOURCE-H"))
(let LWACW-SOURCE-I   (bp "LWACW-SOURCE-I"))
(let LWACW-PROV-C     (bp "LWACW-PROV-C"))
(let LWACW-PROV-D     (bp "LWACW-PROV-D"))
(let LWACW-PROV-E     (bp "LWACW-PROV-E"))
(let LWACW-PROV-H     (bp "LWACW-PROV-H"))
(let LWACW-PROV-I     (bp "LWACW-PROV-I"))
(let LWACW-EVIDENCE   (bp "LWACW-EVIDENCE"))

(defn lwacw-cell (kind) (intern_node kind (empty)))
(defn lwacw-focus () (lwacw-cell LWACW-FOCUS))
(defn lwacw-action-a () (lwacw-cell LWACW-ACTION-A))
(defn lwacw-action-b () (lwacw-cell LWACW-ACTION-B))
(defn lwacw-source-c () (lwacw-cell LWACW-SOURCE-C))
(defn lwacw-source-d () (lwacw-cell LWACW-SOURCE-D))
(defn lwacw-source-e () (lwacw-cell LWACW-SOURCE-E))
(defn lwacw-source-h () (lwacw-cell LWACW-SOURCE-H))
(defn lwacw-source-i () (lwacw-cell LWACW-SOURCE-I))
(defn lwacw-prov-c () (lwacw-cell LWACW-PROV-C))
(defn lwacw-prov-d () (lwacw-cell LWACW-PROV-D))
(defn lwacw-prov-e () (lwacw-cell LWACW-PROV-E))
(defn lwacw-prov-h () (lwacw-cell LWACW-PROV-H))
(defn lwacw-prov-i () (lwacw-cell LWACW-PROV-I))
(defn lwacw-evidence () (lwacw-cell LWACW-EVIDENCE))

(defn lwacw-wrong-delta ()
    (lwac-delta (lwrew-before) (intern_trivial_int 48)
        (lwrew-recipe-lens)))
(defn lwacw-actual-delta ()
    (lwac-delta (lwrew-before) (intern_trivial_int 49)
        (lwrew-recipe-lens)))
(defn lwacw-timeout ()
    (oac-timeout (intern_trivial_int 10)
        (oac-alternative-ack (lwacw-action-a) (lwacw-action-b)
            (lwacw-evidence))
        (lwacw-evidence)))

(defn lwacw-offer-a ()
    (lwac-offer (lwacw-focus) (lwacw-action-a)
        (lwrew-declaration) (lwrew-recipe-lens) (lwrew-before)
        (lwacw-wrong-delta)
        (lwo-field (list (lwacw-action-b)))
        (lwlc-unknown (lwacw-evidence))
        (lwo-none) (lwacw-timeout) (lwacw-evidence)))
(defn lwacw-offer-b ()
    (lwac-offer (lwacw-focus) (lwacw-action-b)
        (lwrew-declaration) (lwrew-recipe-lens) (lwrew-before)
        (lwo-none)
        (lwo-field (list (lwacw-action-a)))
        (lwo-none) (lwo-none) (lwo-none) (lwacw-evidence)))

(defn lwacw-entry-for (source provenance payload)
    (lwrew-entry-for source provenance payload))
(defn lwacw-entry-c (payload)
    (lwacw-entry-for (lwacw-source-c) (lwacw-prov-c) payload))
(defn lwacw-entry-d (payload)
    (lwacw-entry-for (lwacw-source-d) (lwacw-prov-d) payload))
(defn lwacw-entry-e (payload)
    (lwacw-entry-for (lwacw-source-e) (lwacw-prov-e) payload))
(defn lwacw-entry-h (payload)
    (lwacw-entry-for (lwacw-source-h) (lwacw-prov-h) payload))
(defn lwacw-entry-i (payload)
    (lwacw-entry-for (lwacw-source-i) (lwacw-prov-i) payload))

(defn lwacw-world ()
    (lwt-receive-stream (lwrew-world)
        (list
            (lwacw-entry-c (lwacw-focus))
            (lwacw-entry-d (lwacw-focus))
            (lwacw-entry-e (lwacw-focus))
            (lwacw-entry-c (lwacw-action-a))
            (lwacw-entry-d (lwacw-action-a))
            (lwacw-entry-e (lwacw-action-b))
            (lwacw-entry-c (lwacw-offer-a))
            (lwacw-entry-d (lwacw-offer-a))
            (lwacw-entry-e (lwacw-offer-b)))))

(defn lwacw-field-for (world)
    (lwac-field-for world (lwacw-focus) 2))
(defn lwacw-selection-proposal-for (world)
    (lwac-selection-proposal world (lwacw-focus) 2))

(defn lwacw-response-entry (source provenance proposal)
    (lwacw-entry-for source provenance
        (lwt-response proposal (oac-one proposal) provenance)))

(defn lwacw-five-responses (proposal)
    (list
        (lwacw-response-entry
            (lwrew-source-a) (lwrew-prov-a) proposal)
        (lwacw-response-entry
            (lwrew-source-b) (lwrew-prov-b) proposal)
        (lwacw-response-entry
            (lwacw-source-c) (lwacw-prov-c) proposal)
        (lwacw-response-entry
            (lwacw-source-d) (lwacw-prov-d) proposal)
        (lwacw-response-entry
            (lwacw-source-e) (lwacw-prov-e) proposal)))

(defn lwacw-selection-round-for (world previous)
    (do
        (let proposal (lwacw-selection-proposal-for world))
        (lwt-round world (lwo-field (list proposal))
            (lwo-empty-field) previous)))
(defn lwacw-selection-yes-round-for (world previous)
    (do
        (let round (lwacw-selection-round-for world previous))
        (let proposal
            (head (lwo-field-items (lwt-round-proposals round))))
        (lwt-round-receive round (lwacw-five-responses proposal))))
(defn lwacw-selection-integrated-round ()
    (do
        (let yes-round
            (lwacw-selection-yes-round-for (lwacw-world) (lwo-none)))
        (let proposal
            (head (lwo-field-items (lwt-round-proposals yes-round))))
        (lwac-selection-integrate yes-round proposal (lwrew-action))))
(defn lwacw-selection-world ()
    (lwt-round-world (lwacw-selection-integrated-round)))
(defn lwacw-selection-candidate ()
    (lwt-proposal-candidate
        (lwacw-selection-proposal-for (lwacw-world))))

(defn lwacw-ambiguous-world ()
    (lwt-receive-stream (lwacw-world)
        (list
            (lwacw-entry-h (lwacw-focus))
            (lwacw-entry-h (lwacw-action-b))
            (lwacw-entry-h (lwacw-offer-b)))))

(defn lwacw-revoked-old-world (world)
    (lwt-receive-stream world
        (list
            (lwacw-entry-c
                (lwo-revocation (lwacw-offer-a) (lwacw-source-c)
                    (lwrew-action) (lwacw-prov-c)))
            (lwacw-entry-d
                (lwo-revocation (lwacw-offer-a) (lwacw-source-d)
                    (lwrew-action) (lwacw-prov-d))))))

(defn lwacw-execution-proposal-for (world selection observed-time)
    (lwac-execution-proposal world selection observed-time
        (lwacw-evidence)))
(defn lwacw-execution-round-for (world selection observed-time previous)
    (do
        (let proposal
            (lwacw-execution-proposal-for world selection observed-time))
        (lwt-round world (lwo-field (list proposal))
            (lwo-empty-field) previous)))
(defn lwacw-execution-yes-round-for
    (world selection observed-time previous)
    (do
        (let round
            (lwacw-execution-round-for world selection observed-time previous))
        (let proposal
            (head (lwo-field-items (lwt-round-proposals round))))
        (lwt-round-receive round (lwacw-five-responses proposal))))
(defn lwacw-execution-integrated-round ()
    (do
        (let selection-round (lwacw-selection-integrated-round))
        (let world (lwt-round-world selection-round))
        (let selection (lwacw-selection-candidate))
        (let yes-round
            (lwacw-execution-yes-round-for world selection
                (intern_trivial_int 5) selection-round))
        (let proposal
            (head (lwo-field-items (lwt-round-proposals yes-round))))
        (lwac-execution-integrate yes-round proposal (lwrew-action))))
(defn lwacw-execution-world ()
    (lwt-round-world (lwacw-execution-integrated-round)))
(defn lwacw-execution-candidate ()
    (do
        (let world (lwacw-selection-world))
        (lwt-proposal-candidate
            (lwacw-execution-proposal-for world
                (lwacw-selection-candidate) (intern_trivial_int 5)))))

(defn lwacw-observation ()
    (lwac-observation (lwacw-execution-candidate)
        (lwacw-actual-delta) (oac-one (lwacw-actual-delta))
        (lwo-field (list (lwacw-action-b)))
        (lwlc-unknown (lwacw-evidence))
        (oac-timeout-condense
            (lwacw-timeout) (intern_trivial_int 5))
        (lwacw-evidence)))
(defn lwacw-observed-world ()
    (lwt-receive-stream (lwacw-execution-world)
        (list
            (lwacw-entry-h (lwacw-observation))
            (lwacw-entry-i (lwacw-observation)))))
(defn lwacw-learning-proposal-for (world)
    (lwac-learning-proposal world (lwacw-observation) 2))

(defn lwacw-seven-responses (proposal)
    (append (lwacw-five-responses proposal)
        (list
            (lwacw-response-entry
                (lwacw-source-h) (lwacw-prov-h) proposal)
            (lwacw-response-entry
                (lwacw-source-i) (lwacw-prov-i) proposal))))
(defn lwacw-learning-round ()
    (do
        (let world (lwacw-observed-world))
        (let proposal (lwacw-learning-proposal-for world))
        (lwt-round world (lwo-field (list proposal))
            (lwo-empty-field) (lwacw-execution-integrated-round))))
(defn lwacw-learning-yes-round ()
    (do
        (let round (lwacw-learning-round))
        (let proposal
            (head (lwo-field-items (lwt-round-proposals round))))
        (lwt-round-receive round (lwacw-seven-responses proposal))))
(defn lwacw-learning-integrated-round ()
    (do
        (let yes-round (lwacw-learning-yes-round))
        (let proposal
            (head (lwo-field-items (lwt-round-proposals yes-round))))
        (lwac-learning-integrate yes-round proposal (lwrew-action))))
(defn lwacw-learning-world ()
    (lwt-round-world (lwacw-learning-integrated-round)))
(defn lwacw-learning-candidate ()
    (lwt-proposal-candidate
        (lwacw-learning-proposal-for (lwacw-observed-world))))
(defn lwacw-successor-offer ()
    (lwac-successor-offer (lwacw-learning-world)
        (lwacw-learning-candidate) 2))

(defn lwacw-two-predictions-world ()
    (lwt-receive-stream (lwacw-learning-world)
        (list
            (lwacw-entry-c (lwacw-successor-offer))
            (lwacw-entry-d (lwacw-successor-offer)))))
(defn lwacw-revised-world ()
    (lwt-receive-stream
        (lwacw-revoked-old-world (lwacw-learning-world))
        (list
            (lwacw-entry-c (lwacw-successor-offer))
            (lwacw-entry-d (lwacw-successor-offer)))))

(defn lwacw-revised-selection-integrated-round ()
    (do
        (let previous (lwacw-learning-integrated-round))
        (let world (lwacw-revised-world))
        (let yes-round (lwacw-selection-yes-round-for world previous))
        (let proposal
            (head (lwo-field-items (lwt-round-proposals yes-round))))
        (lwac-selection-integrate yes-round proposal (lwrew-action))))
(defn lwacw-revised-selection-world ()
    (lwt-round-world (lwacw-revised-selection-integrated-round)))
(defn lwacw-revised-selection-candidate ()
    (lwt-proposal-candidate
        (lwacw-selection-proposal-for (lwacw-revised-world))))
(defn lwacw-revised-execution-proposal ()
    (lwacw-execution-proposal-for
        (lwacw-revised-selection-world)
        (lwacw-revised-selection-candidate)
        (intern_trivial_int 5)))

(defn lwacw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwacw-sum (tail items)))))
