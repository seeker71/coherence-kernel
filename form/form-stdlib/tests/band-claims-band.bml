; band-claims-band.bml — a band's red claims, named from its own head, fkwu-witnessed (form-stdlib/bml/band-claims.bml).
;
; A ledger row reads "band_after 33030143 of 33554431" and nothing says which claim is short. The claim rows of a band's comment
; head (a power of two at a shallow indent, continued by deeper lines) name the bits; a reading lacks the bits of its red claims.
;
; Expected: 15
; Verdict 15 when every claim lands:
;   1   a head with claims 1, 2 and 4 parses to three rows with their bits, and a deeper line continues the claim above it
;   2   a reading of 5 leaves claim 2 red, 7 leaves none, 0 leaves all three, and 6 leaves claim 1 red
;   4   a digit run that is not a power of two (a "12 options" or "3 of 3" on a continuation, or a line of prose) opens no claim,
;       and a line before the first claim opens none
;   8   the planner band's real head names bit 524288 as the one red claim of the reading 33030143 the night's ledger carried,
;       and its 524288 claim text names row-request-taken
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/band-claims.bml
section [form.bml] {
 class BandClaimsBand {
  def bcb-head() = "; a-band.bml — prose first.\n;\n; Expected: 7\n; Verdict 7 when every claim lands:\n;   1   the first claim, which runs on\n;       onto a continuation line with 12 options and 3 of 3\n;   2   the second claim\n;   4   the third claim\n; preludes: form-stdlib/core.fk\nsection [form.bml] { 0; }\n";
  def bcb-bits(rows) = map(r => r[0], rows);
  def bcb-c-parse(ctx) {
   let rows = bc-claims(bcb-head());
   len(rows) == 3 && bcb-bits(rows) == [1, 2, 4] && str_find(rows[0][1], "onto a continuation line with 12 options and 3 of 3", 0) >= 0 && rows[1][1] == "the second claim";
  }
  def bcb-c-red(ctx) = bcb-bits(bc-red(bcb-head(), 5)) == [2] && nil?(bc-red(bcb-head(), 7)) && bcb-bits(bc-red(bcb-head(), 0)) == [1, 2, 4] && bcb-bits(bc-red(bcb-head(), 6)) == [1];
  def bcb-c-only(ctx) = bc-pow2?(1) && bc-pow2?(1024) && !bc-pow2?(12) && !bc-pow2?(3) && !bc-pow2?(0) && len(bc-claims("; Verdict 3\n; 12 is not a bit\n;   3   nor is three\n;   2   but two is\n")) == 1;
  def bcb-c-real(ctx) {
   let text = (String) (read_file("form/form-stdlib/tests/form-cli-local-plan-band.bml") ?? "");
   let red = bc-red(text, 33030143);
   len(text) > 0 && len(bc-claims(text)) >= 25 && len(red) == 1 && red[0][0] == 524288 && str_find(red[0][1], "row-request-taken", 0) >= 0 && nil?(bc-red(text, 33554431));
  }
  def bcb-run() = live-claims("band-claims-band", 0, [["parse", 1, 1, bcb-c-parse], ["red", 2, 1, bcb-c-red], ["only", 4, 1, bcb-c-only], ["real", 8, 1, bcb-c-real]]);
 }
 bcb-run();
}
