; def-window-band.bml — a file read through its definitions by line and indent (form-stdlib/bml/def-window.bml), never by a count of characters, and never whole for want of a name.
;
; Verdict 4095 when every claim lands:
;   1    two-space indent: a named definition is its own text, up to the next definition
;   2    eight-space indent (the file that made every named definition run to its end): the same, and the definition after it is not in its region
;   4    a Form file: "(defn NAME" definitions read the same way
;   8    a definition nested deeper than its parent stays inside the parent's region
;   16   a file with definitions, none named: its head and every definition's name and parameters, never the whole text (a 1.6 MB C-sized file once went whole into a planner packet)
;   32   a 1-based line number names the definition that holds it
;   64   every definition's name and parameters follow the regions, so no name or arity is invented
;   128  no length decides: a definition of 400 lines is returned whole
;   256  a file with no definitions, the reader may only read, nothing named: a named omission with its size, not the text
;   512  the same file with a line named: the paragraph that holds that line, and not the rest
;   1024 the same file when the reader may write it: its whole text
;   2048 a file with no definitions never lets a line number past its end through (the paragraph of a line beyond the file is empty, not an error)
//
// REQUIRES: the built ./fkwu and the body root as the working directory.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/bml/string-join.bml form-stdlib/bml/def-window.bml
section [form.bml] {
 class DefWindowBand {
  def dwb-two() = "// head\nsection {\n  def a(x) = x + 1;\n  def b(y) {\n   let z = y;\n   z;\n  }\n  def c() = 0;\n}";
  def dwb-eight() = "// head\nsection {\n        def a(x) = x + 1;\n        def b(y) {\n         let z = y;\n         z;\n        }\n        def c() = 0;\n}";
  def dwb-form() = "; head\n(do\n    (defn fa (x) (add x 1))\n    (defn fb (y)\n        (add y 2))\n    (defn fc () 0))";
  def dwb-nested() = "// head\nsection {\n  def a(x) {\n    def inner(q) = q;\n    inner(x);\n  }\n  def b() = 1;\n}";
  def dwb-long() = "// head\nsection {\n  def big(x) {\n" ++ str-join-with(map(i => "   let v" ++ i.str() ++ " = " ++ i.str() ++ ";", range(0, 400)), "\n") ++ "\n  }\n  def after() = 1;\n}";
  def dwb-c() = "#include <stdio.h>\n\nstatic int f(int x) {\n  return x + 1;\n}\n\nstatic int g(int y) {\n  return y * 2;\n}\n";
  def dwb-region(text, name) { let L = split-on(text, "\n"); fdw-region-of(L, fdw-infos(L), name); }
  def dwb-1() = dwb-region(dwb-two(), "b") == "  def b(y) {\n   let z = y;\n   z;\n  }";
  def dwb-2() = dwb-region(dwb-eight(), "b") == "        def b(y) {\n         let z = y;\n         z;\n        }" && str_find(dwb-region(dwb-eight(), "b"), "def c", 0) < 0;
  def dwb-4() = dwb-region(dwb-form(), "fb") == "    (defn fb (y)\n        (add y 2))";
  def dwb-8() = str_find(dwb-region(dwb-nested(), "a"), "inner(x);", 0) >= 0 && str_find(dwb-region(dwb-nested(), "a"), "def b", 0) < 0;
  def dwb-16() { let w = fdw-window(dwb-two(), ["nosuch"], [], 1); w != dwb-two() && str_find(w, "def a(x)", 0) >= 0 && str_find(w, "def c()", 0) >= 0 && str_find(w, "let z = y;", 0) < 0; }
  def dwb-32() = str_find(fdw-window(dwb-two(), [], [5], 1), "let z = y;", 0) >= 0 && str_find(fdw-window(dwb-two(), [], [5], 1), "def c() = 0;\n  def b", 0) < 0;
  def dwb-64() { let w = fdw-window(dwb-two(), ["b"], [], 1); str_find(w, "def a(x)", 0) >= 0 && str_find(w, "def c()", 0) >= 0 && str_find(w, "the definitions of this file, name and parameters", 0) >= 0; }
  def dwb-128() = len(split-on(dwb-region(dwb-long(), "big"), "\n")) == 402 && str_find(dwb-region(dwb-long(), "big"), "after", 0) < 0;
  def dwb-256() { let w = fdw-window(dwb-c(), [], [], 0); str_find(w, "not shown here", 0) >= 0 && str_find(w, "return x + 1", 0) < 0 && str_find(w, ((String) len(dwb-c()).str()) ++ " bytes", 0) >= 0; }
  def dwb-512() { let w = fdw-window(dwb-c(), [], [4], 0); str_find(w, "return x + 1;", 0) >= 0 && str_find(w, "return y * 2", 0) < 0; }
  def dwb-1024() = fdw-window(dwb-c(), [], [], 1) == dwb-c();
  def dwb-2048() { let w = fdw-window(dwb-c(), [], [900], 0); str_find(w, "return", 0) < 0; }
 }
 print_str("[def-window] 1 " ++ dwb-1().str() ++ " 2 " ++ dwb-2().str() ++ " 4 " ++ dwb-4().str() ++ " 8 " ++ dwb-8().str() ++ " 16 " ++ dwb-16().str() ++ " 32 " ++ dwb-32().str() ++ " 64 " ++ dwb-64().str() ++ " 128 " ++ dwb-128().str() ++ " 256 " ++ dwb-256().str() ++ " 512 " ++ dwb-512().str() ++ " 1024 " ++ dwb-1024().str() ++ " 2048 " ++ dwb-2048().str());
 (dwb-1() ? 1 : 0) + (dwb-2() ? 2 : 0) + (dwb-4() ? 4 : 0) + (dwb-8() ? 8 : 0) + (dwb-16() ? 16 : 0) + (dwb-32() ? 32 : 0) + (dwb-64() ? 64 : 0) + (dwb-128() ? 128 : 0) + (dwb-256() ? 256 : 0) + (dwb-512() ? 512 : 0) + (dwb-1024() ? 1024 : 0) + (dwb-2048() ? 2048 : 0);
}
