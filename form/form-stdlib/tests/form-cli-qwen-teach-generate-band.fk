; form-cli-qwen-teach-generate-band.fk — generate door carries the teach prompt.
;
; Verdict 127:
;   1  fcmg-teach is fqt-prompt
;   2  the taught prompt still holds the overlay
;   4  the compact knowledge profile carries the exact query envelope
;   8  the compact profile is smaller than the full teaching overlay
;   16 compact query grammar orders anchor, exact path, parser-ready close;
;      the two ledgers are query 48 and answer reserve 32
;   32 compact teaching distinguishes timeout/exhaustion and nothing/0/1,
;      and counts the first generated seed token once
;   64 answer extraction preserves source words and exact requested shape
;
; preludes: form-stdlib/form-cli-model-generate.fk
; witnessed: 2026-08-24 -> 63

(do
    (let compact (fqt-knowledge-prompt "read docs/x.md"))
    (let shape (fqt-query-shape))
    (let anchor-at (str_find shape "ANCHOR" 0))
    (let path-at (str_find shape "PATH" 0))
    (let close-at (str_find shape (fkqt-close) 0))
    (sum (list
        (if (str_eq (fcmg-teach "hello") (fqt-prompt "hello")) 1 0)
        (if (eq (fqt-prompt-has-overlay? "hello") 1) 2 0)
        (if (and (ge (str_find compact (fkqt-open) 0) 0)
                 (ge (str_find compact (fkqt-close) 0) 0)) 4 0)
        (if (lt (str_len compact) (str_len (fqt-prompt "read docs/x.md"))) 8 0)
        (if (and (eq (fqt-query-budget) 48)
             (and (eq (fqt-answer-reserve) 32)
              (and (lt anchor-at path-at) (lt path-at close-at)))) 16 0)
        (if (and (ge (str_find compact
                     "timeout with the answer alternative untried, not exhaustion" 0) 0)
             (and (ge (str_find compact "grounded 0 and 1 as valid values" 0) 0)
                  (ge (str_find compact "count it exactly once in the current phase" 0) 0))) 32 0)
        (if (and (ge (str_find compact
                         "Preserve the source's exact words" 0) 0)
                 (ge (str_find compact "Add no explanation" 0) 0)) 64 0))))
