; form-cli-qwen-teach-generate-band.fk — generate door carries the teach prompt.
;
; Verdict 15:
;   1  fcmg-teach is fqt-prompt
;   2  the taught prompt still holds the overlay
;   4  the compact knowledge profile carries the exact query envelope
;   8  the compact profile is smaller than the full teaching overlay
;
; preludes: form-stdlib/form-cli-model-generate.fk
; witnessed: 2026-08-19 -> 3

(do
    (let compact (fqt-knowledge-prompt "read docs/x.md"))
    (sum (list
        (if (str_eq (fcmg-teach "hello") (fqt-prompt "hello")) 1 0)
        (if (eq (fqt-prompt-has-overlay? "hello") 1) 2 0)
        (if (and (ge (str_find compact (fkqt-open) 0) 0)
                 (ge (str_find compact (fkqt-close) 0) 0)) 4 0)
        (if (lt (str_len compact) (str_len (fqt-prompt "read docs/x.md"))) 8 0))))
