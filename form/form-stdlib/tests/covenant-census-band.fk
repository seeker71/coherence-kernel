; covenant-census-band.fk — the winnowing classifier reads exactly: four
; living identical answers are covenant, living disagreement is split, a
; refusing arm makes partial, silence everywhere is refused; whitespace
; never fakes a split; atlas rows round-trip and drift is only a CHANGED
; class, never a new name.
;
; Verdict 255 (8 bits):
;   1    four alive, identical -> covenant
;   2    four alive, one differs -> split
;   4    one arm refuses -> partial (and its rc travels in the answers text)
;   8    all refuse -> refused
;   16   trailing newline / spaces never fake a split ("42\n" vs " 42")
;   32   an atlas row parses its class back by name
;   64   drift answers the OLD class when the class changed
;   128  drift stays silent for an unchanged class AND for a new name
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/covenant-census.fk

(do
    (defn cvcb-bit (ok weight) (if ok weight 0))

    (defn covenant-census-band ()
        (do
            (let ok (cvc-result "1" 0))
            (let ok2 (cvc-result "2" 0))
            (let dead (cvc-result "" 1))

            (let c0 (cvcb-bit (str_eq (cvc-class ok ok ok ok) "covenant") 1))
            (let c1 (cvcb-bit (str_eq (cvc-class ok ok ok ok2) "split") 2))
            (let c2 (cvcb-bit
                (and (str_eq (cvc-class ok ok ok dead) "partial")
                     (ge (str_find (cvc-answers ok ok ok dead)
                        "ts=refuse(1)" 0) 0)) 4))
            (let c3 (cvcb-bit
                (str_eq (cvc-class dead dead dead dead) "refused") 8))
            (let c4 (cvcb-bit
                (str_eq (cvc-class (cvc-result "42\n" 0)
                    (cvc-result " 42" 0) (cvc-result "42" 0)
                    (cvc-result "42 " 0)) "covenant") 16))

            (let atlas (str_concat
                (cvc-atlas-row "eq-nothing-int" "covenant" "fkwu=0 go=0" 1)
                (cvc-atlas-row "lt-nothing-int" "partial" "fkwu=1 go=refuse(1)" 1)))
            (let c5 (cvcb-bit
                (and (str_eq (cvc-atlas-class atlas "lt-nothing-int")
                        "partial")
                     (str_eq (cvc-atlas-class atlas "eq-nothing-int")
                        "covenant")) 32))
            (let c6 (cvcb-bit
                (str_eq (cvc-drift atlas "eq-nothing-int" "partial")
                    "covenant") 64))
            (let c7 (cvcb-bit
                (and (str_eq (cvc-drift atlas "eq-nothing-int" "covenant") "")
                     (str_eq (cvc-drift atlas "never-seen" "split") "")) 128))

            (add c0 (add c1 (add c2 (add c3
                (add c4 (add c5 (add c6 c7)))))))))

    (covenant-census-band))
