; source-of-band.fk — the discovery organ reads a directory's cells in Form and names the births it finds.
;
; preludes: form-stdlib/source-of.fk gate/lens-text.bml
;
; run: ./fkwu form/form-stdlib/tests/source-of-band.fk   ; -> 31
;
; The scan lists a directory (fs_list), takes its `*.fk` cells in byte order, reads each and cuts every
; `  (defn name rest` line into [name, path]. No process runs and no file is made. The band writes its
; own cells under temp_dir (and removes them), so no checkout file is read.
;
; Verdict 31:
;   1   a row `path:  (defn name rest` reads as [name, path]; leading spaces after the colon are
;       skipped, and a name ends at a space or at `(`
;   2   a line that is no defn row (no colon, no `(defn `, an empty name) reads as nothing
;   4   a scan of a directory of two cells answers the names they birth, each with its own path, and
;       a name born in both cells answers both paths
;   8   the scan leaves nothing behind: the temp directory lists the same names before and after it
;   16  the cells come in byte order (a.fk before b.fk before c.fk, though written c, a, b), a dotfile
;       cell, a `.fkb` and a plain text file are not read, a directory named like a cell is not a
;       cell, a defn on a last line with no newline counts, and a directory that is not there is empty

(do
    (defn sob-k (ok bit) (if ok bit 0))
    (defn sob-nl () (byte_to_str 10))
    (defn sob-dir () (str_concat (temp_dir) (str_concat "/sof-band-" (value_str (host_pid)))))
    (defn sob-has-path? (rows name path)
        (if (eq (len rows) 0) 0
            (if (and (str_eq (head (head rows)) name) (str_eq (nth (head rows) 1) path)) 1
                (sob-has-path? (tail rows) name path))))
    (defn sob-paths (rows)
        (if (eq (len rows) 0) ""
            (str_concat (nth (head rows) 1) (str_concat "," (sob-paths (tail rows))))))
    (defn source-of-band ()
        (do
            (let one (sof-grep-row "a/b.fk:  (defn alpha (x) x)"))
            (let two (sof-grep-row "c.fk:(defn beta-1(y) y)"))
            (let no-colon (sof-grep-row "(defn lonely (x) x)"))
            (let no-defn (sof-grep-row "z.fk:  (let q 1)"))
            (let empty-name (sof-grep-row "z.fk:(defn (x) x)"))
            (let d (sob-dir))
            (let made (host_dir_mkdir d))
            (let w1 (write_file (str_concat d "/one.fk") (str_concat "(defn shared (x) x)" (str_concat (sob-nl) (str_concat "  (defn only-one (y) y)" (sob-nl))))))
            (let w2 (write_file (str_concat d "/two.fk") (str_concat "(defn shared (x) x)" (str_concat (sob-nl) "(let z 1)"))))
            (let temp-before (len (fs_list (temp_dir))))
            (let rows (sof-index-dir d))
            (let temp-after (len (fs_list (temp_dir))))
            (let gone (host_dir_rmdir d))
            (let d2 (str_concat d "-order"))
            (let made2 (host_dir_mkdir d2))
            (let o1 (write_file (str_concat d2 "/c.fk") (str_concat "(defn from-c (x) x)" (sob-nl))))
            (let o2 (write_file (str_concat d2 "/a.fk") (str_concat "(defn from-a (x) x)" (sob-nl))))
            (let o3 (write_file (str_concat d2 "/b.fk") (str_concat "(let k 1)" (str_concat (sob-nl) "(defn from-b (x) x)"))))
            (let o4 (write_file (str_concat d2 "/.hid.fk") "(defn from-hidden (x) x)"))
            (let o5 (write_file (str_concat d2 "/a.fkb") "(defn from-fkb (x) x)"))
            (let o6 (write_file (str_concat d2 "/notes.txt") "(defn from-text (x) x)"))
            (let o7 (host_dir_mkdir (str_concat d2 "/sub.fk")))
            (let orows (sof-index-dir d2))
            (let missing (sof-index-dir (str_concat d "-nowhere")))
            (let gone2 (host_dir_rmdir d2))
            (sum (list
                (sob-k (and (eq (len one) 2) (and (str_eq (head one) "alpha") (and (str_eq (nth one 1) "a/b.fk")
                       (and (eq (len two) 2) (and (str_eq (head two) "beta-1") (str_eq (nth two 1) "c.fk")))))) 1)
                (sob-k (and (eq (len no-colon) 0) (and (eq (len no-defn) 0) (eq (len empty-name) 0))) 2)
                (sob-k (and (eq (len rows) 3)
                            (and (eq (sob-has-path? rows "shared" (str_concat d "/one.fk")) 1)
                            (and (eq (sob-has-path? rows "shared" (str_concat d "/two.fk")) 1)
                                 (eq (sob-has-path? rows "only-one" (str_concat d "/one.fk")) 1)))) 4)
                (sob-k (eq temp-after temp-before) 8)
                (sob-k (and (eq (len orows) 3)
                            (and (str_eq (head (nth orows 0)) "from-a")
                            (and (str_eq (head (nth orows 1)) "from-b")
                            (and (str_eq (head (nth orows 2)) "from-c")
                                 (eq (len missing) 0))))) 16)))))
    (source-of-band))
