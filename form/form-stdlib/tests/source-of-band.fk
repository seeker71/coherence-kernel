; source-of-band.fk — the body finds its own birth sources, shows plurality
; as choice, and answers nothing for the unbirthable.
;
; Verdict 127 (7 bits):
;   1    the LIVE index over form-stdlib holds thousands of rows — the tree
;        indexed itself through the host's spoken-token door
;   2    a uniquely-born name resolves to its one file ("one", the path)
;   4    append — four definers today — answers "choice" with 4+ files,
;        core.fk among them; the index shows plurality, never picks
;   8    an unborn name is NOTHING
;   16   the synthetic path: sof-parse structures two host rows in order
;        and skips a malformed line without inventing a row
;   32   a missing directory contributes nothing and the index survives
;   64   a host-created shard lease is accepted only at the exact prefix with
;        a shell-inert path alphabet; malformed completion bytes cannot steer
;        the subsequent read or release
;
; preludes: form-stdlib/source-of.fk

(do
    (defn sob-bit (ok bit) (if ok bit 0))
    (defn sob-has (xs needle)
        (if (eq (len xs) 0) 0
            (if (ge (str_find (head xs) needle 0) 0) 1 (sob-has (tail xs) needle))))
    (defn source-of-band ()
        (do
            (let ix (sof-index (list "form/form-stdlib")))
            (let one (sof-find ix "sbt-delta"))
            (let many (sof-find ix "append"))
            (let no (sof-find ix "no-such-name-anywhere-xq"))
            (let syn (sof-parse "alpha a.fk\nbeta b.fk\nmalformed\n" 0 (list)))
            (let lease (sof-shard-path-from-output
                "ZDONE:/tmp/sof-shard.aB-1_2"))
            (let malformed-lease (sof-shard-path-from-output
                "ZDONE:/tmp/sof-shard.good;rm"))
            (sum (list
                (sob-bit (ge (sof-size ix) 2000) 1)
                (sob-bit (and (str_eq (nth one 0) "one")
                              (ge (str_find (nth one 1) "spool-bell-transport.fk" 0) 0)) 2)
                (sob-bit (and (str_eq (nth many 0) "choice")
                         (and (ge (len (nth many 1)) 4)
                              (eq (sob-has (nth many 1) "core.fk") 1))) 4)
                (sob-bit (nothing? no) 8)
                (sob-bit (and (eq (len syn) 2)
                         (and (str_eq (nth (nth syn 0) 0) "alpha")
                              (str_eq (nth (nth syn 1) 1) "b.fk"))) 16)
                (sob-bit (eq (len (sof-index (list "/no/such/dir"))) 0) 32)
                (sob-bit (and (str_eq lease "/tmp/sof-shard.aB-1_2")
                         (nothing? malformed-lease)) 64)))))
    (source-of-band))
