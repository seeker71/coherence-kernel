; source-of-band.fk — the discovery organ reads grep's rows in Form and names the births it finds.
;
; preludes: form-stdlib/source-of.fk gate/lens-text.bml
;
; run: ./fkwu form/form-stdlib/tests/source-of-band.fk   ; -> 15
;
; The scan was a grep piped through sed; the shard now holds grep's own rows (`path:  (defn name
; rest`) and Form cuts the name and the path out. The band writes its own two cells under temp_dir
; (and removes them), so no checkout file is read.
;
; Verdict 15:
;   1   a row `path:  (defn name rest` reads as [name, path]; leading spaces after the colon are
;       skipped, and a name ends at a space or at `(`
;   2   a line that is no defn row (no colon, no `(defn `, an empty name) reads as nothing
;   4   a scan of a directory of two cells answers the names they birth, each with its own path, and
;       a name born in both cells answers both paths
;   8   the scan leaves nothing behind in the temp directory (the shard lease is released)

(do
    (defn sob-k (ok bit) (if ok bit 0))
    (defn sob-nl () (byte_to_str 10))
    (defn sob-dir () (str_concat (temp_dir) (str_concat "/sof-band-" (value_str (host_pid)))))
    ; how many shard leases the scan's directory (/tmp) holds
    (defn sob-shards-in (names n)
        (if (eq (len names) 0) n
            (sob-shards-in (tail names) (if (eq (lx-at? (head names) 0 "sof-shard.") 1) (add n 1) n))))
    (defn sob-shards () (sob-shards-in (fs_list "/tmp") 0))
    (defn sob-has-path? (rows name path)
        (if (eq (len rows) 0) 0
            (if (and (str_eq (head (head rows)) name) (str_eq (nth (head rows) 1) path)) 1
                (sob-has-path? (tail rows) name path))))
    (defn source-of-band ()
        (do
            (let one (sof-grep-row "a/b.fk:  (defn alpha (x) x)"))
            (let two (sof-grep-row "c.fk:(defn beta-1(y) y)"))
            (let no-colon (sof-grep-row "(defn lonely (x) x)"))
            (let no-defn (sof-grep-row "z.fk:  (let q 1)"))
            (let empty-name (sof-grep-row "z.fk:(defn (x) x)"))
            (let d (sob-dir))
            (let made (host_dir_mkdir d))
            (let w1 (write_file (str_concat d "/one.fk") (str_concat "(defn shared (x) x)" (str_concat (sob-nl) (str_concat "  (defn only-one (y) y)" (sob-nl))))))
            (let w2 (write_file (str_concat d "/two.fk") (str_concat "(defn shared (x) x)" (str_concat (sob-nl) "(let z 1)"))))
            (let shards-before (sob-shards))
            (let rows (sof-index-dir d))
            (let shards-after (sob-shards))
            (let gone (host_dir_rmdir d))
            (sum (list
                (sob-k (and (eq (len one) 2) (and (str_eq (head one) "alpha") (and (str_eq (nth one 1) "a/b.fk")
                       (and (eq (len two) 2) (and (str_eq (head two) "beta-1") (str_eq (nth two 1) "c.fk")))))) 1)
                (sob-k (and (eq (len no-colon) 0) (and (eq (len no-defn) 0) (eq (len empty-name) 0))) 2)
                (sob-k (and (eq (len rows) 3)
                            (and (eq (sob-has-path? rows "shared" (str_concat d "/one.fk")) 1)
                            (and (eq (sob-has-path? rows "shared" (str_concat d "/two.fk")) 1)
                                 (eq (sob-has-path? rows "only-one" (str_concat d "/one.fk")) 1)))) 4)
                (sob-k (eq shards-after shards-before) 8)))))
    (source-of-band))
