; Structural guard for the observed final-slice/head command-buffer boundary.
; Not an arithmetic proof; real first-reply and parity witnesses run separately.
; Expected 7.
; preludes: form-stdlib/core.fk
(do
 (let source (read_file "form/native/metal/qwen35-dense-token-handle.fk"))
 (let start (str_find source "(defn q38-prefill-span-sliced " 0))
 (let end (str_find source "(defn q38-last-slice-n " start))
 (let body (substring source start end))
 (let slices (str_find body "(let end (q38-prefill-sliced-go" 0))
 (let armed (str_find body "(metal_batch_concurrent)" 0))
 (let gather (str_find body "(q38-gather " 0))
 (let head (str_find body "(q38-head-only " 0))
 (add (if (and (ge slices 0) (gt armed slices)) 1 0)
  (add (if (gt gather armed) 2 0) (if (gt head gather) 4 0))))
