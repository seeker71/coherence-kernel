; qwen4exp-flash-next-quant-jit-band.fk — pure contract before the live Metal door.
;
; Verdict 1023: exact type/bytes, BML thread map and refusal, one emitted helper
; spine, and one named four-row kernel. The sibling live observer proves JIT
; compilation and dispatch on the linked carrier.
;
; preludes: form/native/metal/qwen4exp-flash-next-quant-jit.fk form/form-stdlib/tests/iq2xs-msl-band.fk

(do
    (let unit (q4eq-msl))
    (let c0 (iq2xmb-bit (eq (q4eq-type) 17) 1))
    (let c1 (iq2xmb-bit (iq2xmb-all (list
        (eq (q4eq-bytes 17 256) 74)
        (eq (q4eq-bytes 17 2560) 740)
        (eq (q4eq-bytes 18 256) 0)
        (eq (q4eq-bytes 17 255) 0))) 2))
    (let c2 (iq2xmb-bit (iq2xmb-all (list
        (eq (q4eq-threads 17 1 256) 32)
        (eq (q4eq-threads 17 4 256) 32)
        (eq (q4eq-threads 17 5 256) 64)
        (eq (q4eq-threads 17 640 2560) 5120)
        (eq (q4eq-threads 17 641 2560) 5152))) 4))
    (let c3 (iq2xmb-bit (iq2xmb-all (list
        (eq (q4eq-threads 18 640 2560) 0)
        (eq (q4eq-threads 17 640 2559) 0)
        (eq (q4eq-threads 17 0 2560) 0))) 8))
    (let c4 (iq2xmb-bit (eq (iq2xmb-count unit "kernel void form_qwen4exp_iq2xs_slot4_f32") 1) 16))
    (let c5 (iq2xmb-bit (iq2xmb-all (list
        (eq (iq2xmb-count unit "constant uchar iq2xs_grid") 1)
        (eq (iq2xmb-count unit "constant uchar iq2xs_ksigns") 1)
        (eq (iq2xmb-count unit "packed_ushort4") 1))) 32))
    (let c6 (iq2xmb-bit (iq2xmb-all (list
        (eq (iq2xmb-count unit "#include <metal_stdlib>") 1)
        (eq (iq2xmb-count unit "metal::simd_sum") 1))) 64))
    (let c7 (iq2xmb-bit (iq2xmb-all (list
        (eq (iq2xmb-count unit "74ul") 2)
        (eq (iq2xmb-count unit "r0 + rr < rows") 2))) 128))
    (let c8 (iq2xmb-bit (eq (str_eq (IQ2XSAuthorityKind) "high-bml-interface-class-const") 1) 256))
    (let c9 (iq2xmb-bit (iq2xmb-all (list
        (eq (iq2x-slot-row0 32) 4)
        (eq (iq2x-slot-block 15) 1)
        (eq (iq2x-slot-group 15) 7))) 512))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 c9))))))))))
