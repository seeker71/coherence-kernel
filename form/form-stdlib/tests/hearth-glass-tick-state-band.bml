//////////////////////////////////////////////////////////////////////
//
// hearth-glass-tick-state-band.bml
//
// The high-grammar BML witness for the state that carries one glass
// frame into the next. Expected: 511.
//
// preludes: form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/lane-motion.bml form-stdlib/hearth-glass-door.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormHearthGlassTickStateBand {
        def hgs-bit(ok, bit) = if ok then bit else 0;
        def hgs-band() {
            let state = hgd-tick-state("taskb=5\nreplyb=9\npf=3\ncp=10\nlastms=7\n", 4, 8, 2, 6, list(2), 1);
            sum(list(
                hgs-bit(str_eq(nth(state, 0), hgd-tick-state-tag()), 1),
                hgs-bit(eq(hgd-tick-state-taskb(state), 5), 2),
                hgs-bit(eq(hgd-tick-state-replyb(state), 9), 4),
                hgs-bit(eq(hgd-tick-state-pf(state), 3), 8),
                hgs-bit(eq(hgd-tick-state-cp(state), 10), 16),
                hgs-bit(str_eq(hgd-tick-state-kv(state), "miss"), 32),
                hgs-bit(eq(head(hgd-tick-state-spark(state)), 4), 64),
                hgs-bit(eq(hgd-tick-state-alive(state), 1), 128),
                hgs-bit(eq(hgd-tick-state-lastms(state), 7), 256)
            ));
        }
    }
    hgs-band();
}
