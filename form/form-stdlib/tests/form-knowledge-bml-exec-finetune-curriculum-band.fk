; form-knowledge-bml-exec-finetune-curriculum-band.fk -- the adaptation rows
; are source-disjoint, scannerless, deterministically lowered and executable
; where the Form cursor evaluator carries the required primitives.
;
; Expected: 131071 (17 bits)
;
; preludes: form-stdlib/core.fk form-stdlib/json.fk
; preludes: form-stdlib/str-byte-at.fk form-stdlib/sha256.fk form-stdlib/hex.fk
; preludes: form-stdlib/native-model-evidence.fk form-stdlib/bmf-core.fk
; preludes: form-stdlib/bmf-grammar.fk form-stdlib/grammars/form-bml.fk
; preludes: form-stdlib/form-knowledge-query-token.fk
; preludes: form-stdlib/form-knowledge-exec-diagnostic.fk
; preludes: form-stdlib/form-knowledge-exec-grammar-transport.fk
; preludes: form-stdlib/form-eval-full.fk
; preludes: form-stdlib/form-knowledge-bml-exec-finetune-curriculum.fk

(do
    (defn fkbefb-bit (ok bit) (if ok bit 0))
    (defn fkbefb-count-exec (rows)
        (if (nil? rows) 0
            (add (fkbef-executable? (head rows))
                 (fkbefb-count-exec (tail rows)))))
    (defn fkbefb-all-parse? (rows)
        (if (nil? rows) 1
            (if (eq (fkegt-parse-signal (fkbef-answer (head rows))
                        (fkegt-max-bytes)) 1)
                (fkbefb-all-parse? (tail rows)) 0)))
    (defn fkbefb-all-lower? (rows)
        (if (nil? rows) 1
            (if (nothing? (fkegt-form-body (fkbef-answer (head rows))
                               (fkegt-max-bytes))) 0
                (fkbefb-all-lower? (tail rows)))))
    (defn fkbefb-eval-source (row)
        (do
            (let body (fkegt-form-body (fkbef-answer row) (fkegt-max-bytes)))
            ; Every canonical answer lowers with the final `0` plus newline.
            (let definitions (substring body 0 (sub (str_len body) 2)))
            (let supplied
                (if (str_eq (fkbef-family row) "willow-supplied")
                    "(defn willow-external (x) (add x 2))\n"
                (if (str_eq (fkbef-family row) "xeno-supplied")
                    "(defn xeno-route (x y) (if (eq x y) 42 0))\n"
                (if (str_eq (fkbef-family row) "coral-jit-call")
                    "(defn coral-jit (heat pure) (if (and (gt heat 5) pure) 42 0))\n"
                (if (str_eq (fkbef-family row) "wave-supplied")
                    "(defn wave-shift (x) (add x 3))\n"
                (if (str_eq (fkbef-family row) "zeal-supplied")
                    "(defn zeal-shift (x) (add x 5))\n"
                    ""))))))
            (fked-cat (list "(do\n" supplied definitions
                "(" (fkbef-target row) ")\n)"))))
    (defn fkbefb-all-exec? (rows)
        (if (nil? rows) 1
            (if (eq (fkbef-executable? (head rows)) 0)
                (fkbefb-all-exec? (tail rows))
                (if (eq (fef-eval (fkbefb-eval-source (head rows)))
                        (fkbef-expected (head rows)))
                    (fkbefb-all-exec? (tail rows)) 0))))
    (defn fkbefb-contains? (row needle)
        (if (or (ge (str_find (fkbef-prompt row) needle 0) 0)
                (ge (str_find (fkbef-answer row) needle 0) 0)) 1 0))
    (defn fkbefb-none-contain? (rows needle)
        (if (nil? rows) 1
            (if (eq (fkbefb-contains? (head rows) needle) 1) 0
                (fkbefb-none-contain? (tail rows) needle))))
    (defn fkbefb-no-answer-contains? (rows needle)
        (if (nil? rows) 1
            (if (ge (str_find (fkbef-answer (head rows)) needle 0) 0) 0
                (fkbefb-no-answer-contains? (tail rows) needle))))
    (defn fkbefb-family-in? (family rows)
        (if (nil? rows) 0
            (if (str_eq family (fkbef-family (head rows))) 1
                (fkbefb-family-in? family (tail rows)))))
    (defn fkbefb-disjoint? (left right)
        (if (nil? left) 1
            (if (eq (fkbefb-family-in? (fkbef-family (head left)) right) 1) 0
                (fkbefb-disjoint? (tail left) right))))
    (defn fkbefb-all-split? (rows split)
        (if (nil? rows) 1
            (if (str_eq (fkbef-split (head rows)) split)
                (fkbefb-all-split? (tail rows) split) 0)))
    (defn fkbefb-run ()
        (do
            (let train (fkbef-train-rows))
            (let valid (fkbef-valid-rows))
            (let test (fkbef-test-rows))
            (let all (fkbef-all-rows))
            (sum (list
                (fkbefb-bit (eq (len train) 24) 1)
                (fkbefb-bit (and (eq (len valid) 6) (eq (len test) 4)) 2)
                (fkbefb-bit (and (fkbefb-all-split? train "train")
                    (and (fkbefb-all-split? valid "valid")
                         (fkbefb-all-split? test "test"))) 4)
                (fkbefb-bit (and (fkbefb-disjoint? train valid)
                    (and (fkbefb-disjoint? train test)
                         (fkbefb-disjoint? valid test))) 8)
                (fkbefb-bit (fkbefb-all-parse? all) 16)
                (fkbefb-bit (fkbefb-all-lower? all) 32)
                (fkbefb-bit (eq (fkbefb-count-exec all) 24) 64)
                (fkbefb-bit (fkbefb-all-exec? all) 128)
                (fkbefb-bit (str_eq (fkbef-jsonl "train")
                    (read_file "model/fixtures/form-bml-exec-finetune/train.jsonl")) 256)
                (fkbefb-bit (str_eq (fkbef-jsonl "valid")
                    (read_file "model/fixtures/form-bml-exec-finetune/valid.jsonl")) 512)
                (fkbefb-bit (str_eq (fkbef-jsonl "test")
                    (read_file "model/fixtures/form-bml-exec-finetune/test.jsonl")) 1024)
                (fkbefb-bit (and (fkbefb-none-contain? all "59cb1b29")
                    (and (fkbefb-none-contain? all "fkecc-")
                    (and (fkbefb-none-contain? all "oac-")
                    (and (fkbefb-none-contain? all "offer-ack")
                         (fkbefb-none-contain? all "choice-lane"))))) 2048)
                (fkbefb-bit (and (fkbefb-none-contain? all "511")
                    (and (fkbefb-none-contain? all "20260826T012801Z")
                    (and (fkbefb-none-contain? all "a771e529")
                    (and (fkbefb-none-contain? all "41")
                         (fkbefb-none-contain? all "99"))))) 4096)
                (fkbefb-bit (and (fkbefb-no-answer-contains? all "```")
                    (and (fkbefb-no-answer-contains? all "[")
                         (fkbefb-no-answer-contains? all "None"))) 8192)
                (fkbefb-bit (and (ge (str_find (fkbef-jsonl "train")
                    "list(nothing(),0,1)" 0) 0)
                    (ge (str_find (fkbef-jsonl "train")
                    "list(pine-silent,empty,0,1)" 0) 0)) 16384)
                (fkbefb-bit (and (eq (fkbef-executable? (nth test 0)) 1)
                    (and (eq (fkbef-executable? (nth test 1)) 1)
                    (and (eq (fkbef-executable? (nth test 2)) 1)
                         (eq (fkbef-executable? (nth test 3)) 0)))) 32768)
                (fkbefb-bit (and (ge (str_len (fkbef-jsonl "train")) 1000)
                    (nothing? (fkbef-jsonl "foreign"))) 65536)))))
    (fkbefb-run))
