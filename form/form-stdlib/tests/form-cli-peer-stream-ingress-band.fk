; form-cli-peer-stream-ingress-band.fk — arbitrary byte deltas, not lines,
; become correlated resident-peer tasks and typed contribution evidence.
; Expected: 2097151
;
; No model, Metal, HTTP, C, flattening, or fixed channel/function table runs.
;
; preludes: form-stdlib/form-cli-peer-stream-ingress.fk

(do
    (defn fcpsib-bit (held weight) (if held weight 0))
    (defn fcpsib-envelope
        (channel sequence exchange kind payload alternative deadline)
        (rai-envelope channel sequence exchange kind payload alternative deadline))
    (defn fcpsib-offer-step (s envelope now)
        (do
            (let offered (fcpsi-offer s envelope))
            (fcpsi-step (fcpsi-result-state offered) now)))

    (defn form-cli-peer-stream-ingress-band ()
        (do
            (let alpha "@0.2.0.950")
            (let beta "@0.2.0.951")
            (let ingress (rai-organ
                (list (rai-channel alpha 16 64 0)
                      (rai-channel beta 16 64 0)) 8))
            (let state0 (fcpsi-new ingress 8))

            ; Idle is absence. A bare newline is accepted bytes but is not a
            ; task clock and dispatches nothing.
            (let idle (fcpsi-step state0 1))
            (let offered-nl (fcpsi-offer state0
                (fcpsib-envelope alpha 1 90 "task-bytes" "\n" "wait" -1)))
            (let nl (fcpsi-step (fcpsi-result-state offered-nl) 1))
            (let c0 (fcpsib-bit (and
                (str_eq (fcpsi-result-signal idle) "nothing")
                (and (eq (fcpsi-result-present? offered-nl) 1)
                (and (eq (fcpsi-result-value offered-nl) 1)
                     (str_eq (fcpsi-result-signal nl) "nothing")))) 1))

            ; One research frame arrives without a trailing newline and with
            ; both marks split across arbitrary delta boundaries.
            (let research (fcpa-task-frame 7 "research"
                "map JIT heat without a server"))
            (let r1 (fcpsib-offer-step (fcpsi-result-state nl)
                (fcpsib-envelope alpha 2 91 "task-bytes"
                    (substring research 0 5) "hold" -1) 2))
            (let r2 (fcpsib-offer-step (fcpsi-result-state r1)
                (fcpsib-envelope alpha 3 91 "task-bytes"
                    (substring research 5 29) "hold" -1) 2))
            (let r3 (fcpsib-offer-step (fcpsi-result-state r2)
                (fcpsib-envelope alpha 4 91 "task-bytes"
                    (substring research 29 (str_len research)) "hold" -1) 2))
            (let state1 (fcpsi-result-state r3))
            (let research-task (head (fcpsi-result-value r3)))
            (let research-end (add 1 (str_len research)))
            (let research-replayed (fcpsi-frame-parse alpha 999 91 research research-end))
            (let c1 (fcpsib-bit (and
                (or (str_eq (fcpsi-result-signal r1) "nothing")
                    (str_eq (fcpsi-result-signal r1) "held"))
                (and (eq (fcpsi-cursor-complete-through
                    (fcpsi-cursor-of (fcpsi-result-state r1) alpha)) 0)
                (and (eq (fcpsi-cursor-complete-through
                    (fcpsi-cursor-of (fcpsi-result-state r2) alpha)) 0)
                (and (str_eq (fcpsi-result-signal r2) "held")
                     (str_eq (fcpsi-result-signal r3) "value"))))) 2))
            (let c2 (fcpsib-bit (and
                (eq (fcpsi-task-turn research-task) 7)
                (and (str_eq (fcpsi-task-kind research-task) "research")
                (and (str_eq (fcpsi-task-text research-task)
                        "map JIT heat without a server")
                (and (eq (fcpsi-task-complete-through research-task)
                         research-end)
                     ; Chunk sequence is transport metadata, not task identity.
                     (eq (fcpsi-nodeid-eq? (fcpsi-task-node research-task)
                              (fcpsi-task-node research-replayed)) 1))))) 4))
            (let alpha-cursor (fcpsi-cursor-of state1 alpha))
            (let c3 (fcpsib-bit (and
                (eq (fcpsi-cursor-bytes alpha-cursor)
                    (add 1 (str_len research)))
                (and (eq (fcpsi-cursor-chunks alpha-cursor) 4)
                (and (eq (fcpsi-cursor-completed alpha-cursor) 1)
                     (eq (fcpsi-cursor-complete-through alpha-cursor)
                         (add 1 (str_len research)))))) 8))

            ; A different dynamic channel carries two frames in one delta;
            ; newline is merely an optional separator between their marks.
            (let eval-frame (fcpa-task-frame 8 "evaluation"
                "check the evidence"))
            (let test-frame (fcpa-task-frame 9 "test" "run held-out cases"))
            (let two (fcpsib-offer-step state1
                (fcpsib-envelope beta 5 92 "task-bytes"
                    (str_concat eval-frame (str_concat "\n" test-frame))
                    "hold" -1) 3))
            (let state2 (fcpsi-result-state two))
            (let two-tasks (fcpsi-result-value two))
            (let c4 (fcpsib-bit (and (eq (len two-tasks) 2)
                (and (str_eq (fcpsi-task-kind (nth two-tasks 0)) "evaluation")
                (and (str_eq (fcpsi-task-kind (nth two-tasks 1)) "test")
                     (eq (fcpsi-task-complete-through (nth two-tasks 0))
                         (str_len eval-frame))))) 16))
            (let c5 (fcpsib-bit (and
                (eq (fcpsi-nodeid-eq? (fcpsi-task-node research-task)
                    (fcpsi-task-node (nth two-tasks 0))) 0)
                (and (eq (fcpsi-task-complete-through (nth two-tasks 1))
                         (add (str_len eval-frame)
                              (add 1 (str_len test-frame))))
                (and (eq (fcpsi-cursor-completed
                    (fcpsi-cursor-of state2 beta)) 2)
                     (eq (fcpsi-cursor-complete-through
                        (fcpsi-cursor-of state2 beta))
                        (add (str_len eval-frame)
                            (add 1 (str_len test-frame))))))) 32))

            ; A complete malformed turn is failure, not an accidental turn 0.
            (let malformed (str_concat (fcpa-task-open)
                (str_concat "\nturn=x\nkind=research\ntask=bad\n"
                    (fcpa-task-close))))
            (let bad (fcpsib-offer-step state2
                (fcpsib-envelope alpha 6 93 "task-bytes" malformed
                    "revise" -1) 4))
            (let c6 (fcpsib-bit (and
                (str_eq (fcpsi-result-signal bad) "failure")
                (nothing? (fcpsi-result-value bad))) 64))

            ; Deadline expiry happens before bytes touch the cursor.
            (let before-timeout (fcpsi-cursor-bytes
                (fcpsi-cursor-of (fcpsi-result-state bad) alpha)))
            (let timeout (fcpsib-offer-step (fcpsi-result-state bad)
                (fcpsib-envelope alpha 7 94 "task-bytes"
                    (fcpa-task-open) "pause-and-observe" 9) 10))
            (let c7 (fcpsib-bit (and
                (str_eq (fcpsi-result-signal timeout) "timeout")
                (and (nothing? (fcpsi-result-value timeout))
                     (eq (fcpsi-cursor-bytes
                        (fcpsi-cursor-of (fcpsi-result-state timeout) alpha))
                        before-timeout))) 128))

            ; Direct research speech becomes a present candidate. Acceptance
            ; remains first-class nothing until a correlated evaluation.
            (let task-node (fcpsi-task-node research-task))
            (let direct (fcpsib-offer-step (fcpsi-result-state timeout)
                (fcpsib-envelope alpha 8 91 "peer-result"
                    (list task-node "the hot path is NodeID lookup" 0)
                    "evaluate" -1) 11))
            (let direct-candidate (fcpsi-result-value direct))
            (let c8 (fcpsib-bit (and
                (str_eq (fcpsi-result-signal direct) "candidate")
                (and (eq (fcpsi-result-present? direct) 1)
                (and (str_eq (fcpsi-candidate-state direct-candidate) "candidate")
                     (nothing? (fcpsi-candidate-accepted direct-candidate))))) 256))

            ; Rejection is present integer 0, not absence. Undo restores
            ; unevaluated candidate; acceptance is present integer 1.
            (let candidate-node (fcpsi-candidate-node direct-candidate))
            (let revise (fcpsib-offer-step (fcpsi-result-state direct)
                (fcpsib-envelope alpha 9 91 "evaluation"
                    (list candidate-node 0 "missing held-out evidence")
                    "revise" -1) 12))
            (let c9 (fcpsib-bit (and
                (str_eq (fcpsi-result-signal revise) "revise")
                (and (eq (fcpsi-result-present? revise) 1)
                     (eq (fcpsi-result-value revise) 0))) 512))
            (let undo (fcpsib-offer-step (fcpsi-result-state revise)
                (fcpsib-envelope alpha 10 91 "undo" candidate-node
                    "retain-candidate" -1) 13))
            (let c10 (fcpsib-bit (and
                (str_eq (fcpsi-result-signal undo) "undo")
                (nothing? (fcpsi-candidate-accepted
                    (fcpsi-result-value undo)))) 1024))
            (let accept (fcpsib-offer-step (fcpsi-result-state undo)
                (fcpsib-envelope alpha 11 91 "evaluation"
                    (list candidate-node 1 "held-out evidence matches")
                    "accept" -1) 14))
            (let c11 (fcpsib-bit (and
                (str_eq (fcpsi-result-signal accept) "accepted")
                (and (eq (fcpsi-result-present? accept) 1)
                     (eq (fcpsi-result-value accept) 1))) 2048))

            ; Physical recipe contribution retains its stronger observed state
            ; without changing how direct research is represented.
            (let eval-task (nth two-tasks 0))
            (let executed (fcpsib-offer-step (fcpsi-result-state accept)
                (fcpsib-envelope beta 12 92 "peer-result"
                    (list (fcpsi-task-node eval-task) "carrier returned 22" 1)
                    "observed" -1) 15))
            (let executed-candidate (fcpsi-result-value executed))
            (let c12 (fcpsib-bit (and
                (str_eq (fcpsi-result-signal executed) "observed-executed")
                (and (eq (fcpsi-candidate-accepted executed-candidate) 1)
                     (str_eq (fcpsi-candidate-state executed-candidate)
                        "observed-executed"))) 4096))

            ; Evaluation cannot borrow another exchange; absence remains
            ; nothing and an unknown movement remains explicit choice.
            (let wrong-exchange (fcpsib-offer-step (fcpsi-result-state executed)
                (fcpsib-envelope alpha 13 999 "evaluation"
                    (list candidate-node 1 "stale") "branch" -1) 16))
            (let c13 (fcpsib-bit (and
                (str_eq (fcpsi-result-signal wrong-exchange) "choice")
                (eq (fcpsi-result-present? wrong-exchange) 1)) 8192))
            (let absent (fcpsib-offer-step (fcpsi-result-state wrong-exchange)
                (fcpsib-envelope alpha 14 91 "evaluation"
                    (list (make_nodeid 9 9 9 9) 1 "borrow") "nothing" -1) 17))
            (let c14 (fcpsib-bit (and
                (str_eq (fcpsi-result-signal absent) "nothing")
                (nothing? (fcpsi-result-value absent))) 16384))
            (let unknown (fcpsib-offer-step (fcpsi-result-state absent)
                (fcpsib-envelope alpha 15 91 "invent" "x" "ask" -1) 18))
            (let c15 (fcpsib-bit (and
                (str_eq (fcpsi-result-signal unknown) "choice")
                (str_eq (fcpsi-result-value unknown) "ask")) 32768))

            ; Native ingress cut and release remain distinct. Release closes
            ; only beta; a later offer is present integer 0 backpressure.
            (let cut (fcpsib-offer-step (fcpsi-result-state unknown)
                (fcpsib-envelope alpha 16 91 "cut" "" "cut" -1) 19))
            (let c16 (fcpsib-bit (str_eq (fcpsi-result-signal cut) "cut") 65536))
            (let release (fcpsib-offer-step (fcpsi-result-state cut)
                (fcpsib-envelope beta 17 92 "release" "" "release" -1) 20))
            (let after-release (fcpsi-offer (fcpsi-result-state release)
                (fcpsib-envelope beta 18 92 "task-bytes" eval-frame
                    "closed" -1)))
            (let c17 (fcpsib-bit (and
                (str_eq (fcpsi-result-signal release) "release")
                (and (str_eq (fcpsi-result-signal after-release) "backpressure")
                (and (eq (fcpsi-result-present? after-release) 1)
                     (eq (fcpsi-result-value after-release) 0)))) 131072))

            ; Output is another typed envelope, not an unflushed status write.
            (let output (fcpsi-output-envelope accept alpha 19 91
                "retain" -1))
            (let c18 (fcpsib-bit (and
                (str_eq (rai-env-kind output) "peer-observation")
                (and (eq (rai-env-exchange output) 91)
                (and (str_eq (fcpsi-result-signal (rai-env-payload output))
                              (fcpsi-result-signal accept))
                (and (eq (fcpsi-result-present? (rai-env-payload output))
                          (fcpsi-result-present? accept))
                (and (eq (fcpsi-result-value (rai-env-payload output))
                          (fcpsi-result-value accept))
                     (str_eq (fcpsi-result-reason (rai-env-payload output))
                             (fcpsi-result-reason accept))))))) 262144))

            ; Both diagnostic windows stay bounded and no fixed channel name
            ; occurs in the implementation source.
            (let final (fcpsi-result-state after-release))
            (let source (read_file
                "form/form-stdlib/form-cli-peer-stream-ingress.fk"))
            (let c19 (fcpsib-bit (and (eq (len (fcpsi-events final)) 8)
                (and (le (len (rai-events (fcpsi-ingress final))) 8)
                (and (eq (str_find source alpha 0) -1)
                     (eq (str_find source beta 0) -1)))) 524288))

            ; The source-level fallback agrees with the hot-swappable policy:
            ; an explicit direct-answer never falls through to a recipe/model
            ; action just because a caller has no published policy route.
            (let direct-task (fcpsi-frame-parse alpha 20 91
                (fcpa-task-frame 10 "direct-answer" "answer directly") 999))
            (let c20 (fcpsib-bit (str_eq
                (fcpsi-default-action direct-task) "direct-answer") 1048576))

            (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12
                       c13 c14 c15 c16 c17 c18 c19 c20))))

    (form-cli-peer-stream-ingress-band))
