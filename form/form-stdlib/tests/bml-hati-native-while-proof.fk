; tests/bml-hati-native-while-proof.fk
;
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk
;
; Closes the arbitrary-while family on the Hati table lane: `while (c) s`
; from source, its condition re-read against changing state each pass
; (record-backed self fields, and a for-owned variable), a labeled
; continue, a break, and a run far past the 64-pass cap of the BMA
; while_success reference loop. The loop is one LOOP row the recipe
; walker iterates in place. while_success keeps its own named refusal.

(do
    (defn score-bool (actual)
        (if actual 1 0))

    (defn score-int (actual expected)
        (if (eq actual expected) 1 0))

    (defn score-str (actual expected)
        (if (str_eq (value_kind actual) "string")
            (if (str_eq actual expected) 1 0)
             0))

    (defn str-contains? (haystack needle)
        (ge (str_find haystack needle 0) 0))

    (defn parse-source (source)
        (bml-source-parse-executable-stream (bml-source-scan-text source)))

    (defn run-source (source)
        (bml-hati-run-value (bml-source-exec-parse-node (parse-source source))))

    (defn method-node (source)
        (head (bml-source-exec-parse-nodes (parse-source source))))

    (defn counter (n m)
        (record_set (record_new (make_nodeid 1 9 2026 613) "n" n) "m" m))

    ;; a method that reads this lives in a class; its receiver rides its own slot
    (defn in-class (method)
        (bml-ast-class
            "Counter"
            "Object"
            (bml-ast-block
                (list
                    (bml-ast-section
                        (bml-ast-name "public")
                        (bml-ast-block
                            (list (bml-ast-field "int" "n") (bml-ast-field "int" "m") method)))))))

    (defn run-member (method self)
        (bml-hati-run-class-method (in-class method) (bml-method-node-name method) self (empty)))

    (let count-parsed
        (parse-source
            "int Count() { while (this.n < 5) { this.n = this.n + 1; } return this.n; }\n"))
    (let count-node (head (bml-source-exec-parse-nodes count-parsed)))
    (let count-image (bml-hati-compile-image (in-class count-node)))
    (let count-table (bml-hati-table-file count-image))
    (let from-zero (counter 0 0))
    (let from-nine (counter 9 0))

    (let long-node
        (method-node
            "int Long() { while (this.n < 200) { this.n = this.n + 1; } return this.n; }\n"))

    (let tally-node
        (method-node
            "int Tally() { outer: while (this.n < 10) { this.n = this.n + 1; if (this.n < 5) continue outer; this.m = this.m + 1; } return this.m; }\n"))
    (let tally-self (counter 0 0))

    (let down-node
        (method-node
            "int Down(int n) { int steps = 0; while (n > 0) { n = n - 3; steps++; } return steps * 100 + n; }\n"))

    (let local-source "int x = 0; while (x < 5) { x = x + 1; } return x;\n")
    (let local-image
        (bml-hati-compile-image (bml-source-exec-parse-node (parse-source local-source))))

    (let success-image
        (bml-hati-compile-image
            (bml-ast-while-success (bml-ast-block (list (bml-ast-fail 0))))))

    (sum
        (list
            (score-bool (bml-source-exec-parse-ok? count-parsed))
            (score-str (head (bml-source-exec-parse-rules count-parsed)) "method-body")
            (score-bool (bml-hati-image-supported? count-image))
            (score-bool (not (str-contains? count-table "BML-HATI-UNSUPPORTED")))
            (score-bool (bml-hati-image-has-tag? count-image (bml-ctl-loop-tag 0)))
            (score-int (run-member count-node from-zero) 5)
            (score-int (record_get from-zero "n") 5)
            (score-int (run-member count-node from-nine) 9)
            (score-int (run-member long-node (counter 0 0)) 200)
            (score-int (run-member tally-node tally-self) 6)
            (score-int (record_get tally-self "n") 10)
            (score-int (run-source "while (1) { break; } return 3;\n") 3)
            (score-int (run-source "while (2 < 1) { return 1; } return 2;\n") 2)
            (score-int (run-source local-source) 5)
            (score-bool (bml-hati-image-has-tag? local-image (bml-ctl-loop-tag 0)))
            (score-int
                (run-source
                    "int x = 1; int steps = 0; while (x < 1000) { x = x * 2; steps++; } return steps * 10000 + x;\n")
                101024)
            (score-int (bml-hati-run-value-with-arg down-node 10) 398)
            (score-int
                (run-source
                    "for (int i = 0; i < 10; i = i + 1) { while (i < 4) { i = i + 1; } if (i == 4) return i * 10; } return 0;\n")
                40)
            (score-str (head (bml-hati-image-unsupported success-image)) "while"))))
