; form-cli-resident-turnwheel-bml-band.fk -- high BML is the sole decision
; declaration; a resident reads it once, lowers structural programs, then
; reaches retained native bytes by NodeID. No `xtal` source mirror exists.
;
; Expected: 65535
; preludes: form-stdlib/form-cli-resident-turnwheel.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml.fk

(do
    (defn fcrtbmlb-bit (ok bit) (if ok bit 0))
    (defn fcrtbmlb-all? (bits)
        (if (nil? bits) 1
            (if (eq (head bits) 0) 0
                (fcrtbmlb-all? (tail bits)))))
    (defn fcrtbmlb-high-path ()
        (if (ge (file_size
                "form/form-stdlib/bml/form-cli-resident-turnwheel.bml") 0)
            "form/form-stdlib/bml/form-cli-resident-turnwheel.bml"
            "form-stdlib/bml/form-cli-resident-turnwheel.bml"))
    (defn fcrtbmlb-native-path ()
        (if (ge (file_size
                "form/form-stdlib/form-cli-resident-turnwheel-native-bml.fk") 0)
            "form/form-stdlib/form-cli-resident-turnwheel-native-bml.fk"
            "form-stdlib/form-cli-resident-turnwheel-native-bml.fk"))
    (defn fcrtbmlb-legacy-bml-path ()
        (if (ge (file_size "form/form-stdlib") 0)
            "form/form-stdlib/form-cli-resident-turnwheel.bml"
            "form-stdlib/form-cli-resident-turnwheel.bml"))
    (defn fcrtbmlb-legacy-xtal-path ()
        (if (ge (file_size "form/form-stdlib") 0)
            "form/form-stdlib/form-cli-resident-turnwheel-xtal.fk"
            "form-stdlib/form-cli-resident-turnwheel-xtal.fk"))
    (defn fcrtbmlb-has? (text needle)
        (if (ge (str_find text needle 0) 0) 1 0))
    (defn fcrtbmlb-native-return? (call value born)
        (fcrtbmlb-all?
            (list (str_eq (fcrtn-call-status call) "returned")
                  (str_eq (fcrtn-call-route call) "native")
                  (eq (fcrtn-call-value call) value)
                  (eq (fcrtn-call-born call) born))))

    (defn form-cli-resident-turnwheel-bml-band ()
        (do
            (let high-path (fcrtbmlb-high-path))
            (let high-source (read_file high-path))
            (let native-source (read_file (fcrtbmlb-native-path)))
            (let cursor (cursor-file-window high-path 7))
            (let parsed (g-match-rule (bml-grammar) "unit" cursor))
            (let cache (fcrtn-build))
            (let cache-again (fcrtn-build))
            (let terminal-returned (fcrtn-invoke cache (jonb-registry 99)
                (fcrtn-terminal-selector)
                (fcrtn-terminal-code cache "returned")))
            (let terminal-live (fcrtn-invoke cache
                (fcrtn-call-registry terminal-returned)
                (fcrtn-terminal-selector)
                (fcrtn-terminal-code cache "live")))
            (let phase-program (fcrtn-invoke cache
                (fcrtn-call-registry terminal-live)
                (fcrtn-phase-selector) (fcrtn-phase-code cache "program")))
            (let phase-returned (fcrtn-invoke cache
                (fcrtn-call-registry phase-program)
                (fcrtn-phase-selector) (fcrtn-phase-code cache "returned")))
            (let stop-carried (fcrtn-invoke cache
                (fcrtn-call-registry phase-returned)
                (fcrtn-stop-selector) 1))
            (let stop-open (fcrtn-invoke cache
                (fcrtn-call-registry stop-carried)
                (fcrtn-stop-selector) 0))
            (let shared (fcrt-shared "" "" (empty) (empty) 256 8
                (jonb-registry 41)))
            (let cut (fcrt-terminal-call shared "cut"))
            (let undo (fcrt-terminal-call (fcrt-tc-shared cut) "undo"))
            (let malformed (fcrtn-build-source
                "class FormCliResidentTurnwheel {}"))
            (let refused (fcrtn-invoke malformed (jonb-registry 8)
                (fcrtn-terminal-selector) 0))
            (let resident-source (read_file
                "form/form-stdlib/form-cli-resident-turnwheel.fk"))
            (sum (list
                (fcrtbmlb-bit (rok? parsed) 1)
                (fcrtbmlb-bit (g-complete? parsed) 2)
                (fcrtbmlb-bit (fcrtbmlb-all? (list
                    (fcrtbmlb-has? high-source "package Form.cli.resident")
                    (fcrtbmlb-has? high-source "interface IResidentTurnwheelNative")
                    (fcrtbmlb-has? high-source "[native, cached, jit]"))) 4)
                (fcrtbmlb-bit (fcrtbmlb-all? (list
                    (fcrtbmlb-has? high-source "scannerless-byte-fold-no-tokenizer")
                    (fcrtbmlb-has? high-source "every admitted route is a NodeID program image")
                    (fcrtbmlb-has? high-source "nothing-is-not-zero-or-one"))) 8)
                (fcrtbmlb-bit (fcrtbmlb-all? (list
                    (eq (fcrtbmlb-has? high-source
                        "form-cli-resident-turnwheel-xtal.fk") 0)
                    (eq (file_size (fcrtbmlb-legacy-bml-path)) -1)
                    (eq (file_size (fcrtbmlb-legacy-xtal-path)) -1))) 16)
                (fcrtbmlb-bit (fcrtbmlb-all? (list
                    (fcrtbmlb-has? native-source "jonb-request")
                    (fcrtbmlb-has? native-source "high-bml-native-page-unavailable")
                    (eq (fcrtbmlb-has? native-source "form-eval") 0))) 32)
                (fcrtbmlb-bit (fcrtn-cache-ready? cache) 64)
                (fcrtbmlb-bit (node_eq (fcrtn-cache-source cache)
                    (fcrtn-cache-source cache-again)) 128)
                (fcrtbmlb-bit (fcrtbmlb-all? (list
                    (eq (fcrtn-terminal-code cache "live") 0)
                    (eq (fcrtn-terminal-code cache "undo") 1)
                    (eq (fcrtn-terminal-code cache "cut") 6)
                    (eq (fcrtn-phase-code cache "program") 1)
                    (eq (fcrtn-phase-code cache "returned") 0))) 256)
                (fcrtbmlb-bit (fcrtbmlb-native-return?
                    terminal-returned 1 1) 512)
                (fcrtbmlb-bit (fcrtbmlb-native-return? terminal-live 0 0) 1024)
                (fcrtbmlb-bit (fcrtbmlb-native-return? phase-program 1 1) 2048)
                (fcrtbmlb-bit (fcrtbmlb-native-return? phase-returned 0 0) 4096)
                (fcrtbmlb-bit (fcrtbmlb-all? (list
                    (fcrtbmlb-native-return? stop-carried 1 1)
                    (fcrtbmlb-native-return? stop-open 0 0))) 8192)
                (fcrtbmlb-bit (fcrtbmlb-all? (list
                    (str_eq (fcrt-tc-status cut) "returned")
                    (str_eq (fcrt-tc-route cut) "native")
                    (eq (fcrt-tc-terminal? cut) 1)
                    (str_eq (fcrt-tc-status undo) "returned")
                    (eq (fcrt-tc-terminal? undo) 0))) 16384)
                (fcrtbmlb-bit (fcrtbmlb-all? (list
                    (fcrtn-cache-refused? malformed)
                    (str_eq (fcrtn-call-status refused) "refused")
                    (eq (fcrtbmlb-has? resident-source
                        "form-cli-resident-turnwheel-xtal") 0)
                    (fcrtbmlb-has? resident-source
                        "form-cli-resident-turnwheel-native-bml.fk"))) 32768)))))

    (form-cli-resident-turnwheel-bml-band))
