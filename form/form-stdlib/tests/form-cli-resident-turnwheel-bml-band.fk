; form-cli-resident-turnwheel-bml-band.fk -- the resident's BML authority is
; scannerlessly parsed, lowered, and called by the live Form turnwheel.
;
; Expected: 65535
; `undo` stays a retained-state control action rather than a terminal row
; status. `nothing`, 0, and 1 stay three distinct values in this vocabulary.
;
; preludes: form-stdlib/form-cli-resident-turnwheel.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml.fk

(do
    (defn fcrtbmlb-bit (ok bit) (if ok bit 0))
    (defn fcrtbmlb-high-path ()
        (if (ge (file_size
                "form/form-stdlib/bml/form-cli-resident-turnwheel.bml") 0)
            "form/form-stdlib/bml/form-cli-resident-turnwheel.bml"
            "form-stdlib/bml/form-cli-resident-turnwheel.bml"))
    (defn fcrtbmlb-executable-path ()
        (if (ge (file_size
                "form/form-stdlib/form-cli-resident-turnwheel.bml") 0)
            "form/form-stdlib/form-cli-resident-turnwheel.bml"
            "form-stdlib/form-cli-resident-turnwheel.bml"))
    (defn fcrtbmlb-xtal-path ()
        (if (ge (file_size
                "form/form-stdlib/form-cli-resident-turnwheel-xtal.fk") 0)
            "form/form-stdlib/form-cli-resident-turnwheel-xtal.fk"
            "form-stdlib/form-cli-resident-turnwheel-xtal.fk"))
    (defn fcrtbmlb-has? (text needle)
        (if (ge (str_find text needle 0) 0) 1 0))
    (defn fcrtbmlb-terminal-vocabulary? ()
        (and (eq (fcrtbml-terminal "returned") 1)
        (and (eq (fcrtbml-terminal "done") 1)
        (and (eq (fcrtbml-terminal "nothing") 1)
        (and (eq (fcrtbml-terminal "choice") 1)
        (and (eq (fcrtbml-terminal "cut") 1)
        (and (eq (fcrtbml-terminal "timeout") 1)
        (and (eq (fcrtbml-terminal "failure") 1)
        (and (eq (fcrtbml-terminal "refused") 1)
             (eq (fcrtbml-terminal "release") 1))))))))))
    (defn fcrtbmlb-run ()
        (do
            (let high-path (fcrtbmlb-high-path))
            (let high-source (read_file high-path))
            (let executable-source (read_file (fcrtbmlb-executable-path)))
            (let xtal-source (read_file (fcrtbmlb-xtal-path)))
            (let cursor (cursor-file-window high-path 7))
            (let result (g-match-rule (bml-grammar) "unit" cursor))
            (let descriptor (FormCliResidentTurnwheel))
            (sum (list
                (fcrtbmlb-bit (eq (fcrtbml-check) 1023) 1)
                (fcrtbmlb-bit (rok? result) 2)
                (fcrtbmlb-bit (g-complete? result) 4)
                (fcrtbmlb-bit (and (eq (cur-pos cursor) 0)
                    (eq (bbc-window-size (cur-state cursor)) 7)) 8)
                (fcrtbmlb-bit (eq (fcrtbmlb-has? high-source
                    "package Form.cli.resident") 1) 16)
                (fcrtbmlb-bit (and (eq (fcrtbmlb-has? high-source
                    "interface IResidentTurnwheel") 1)
                    (eq (fcrtbmlb-has? high-source
                    "interface IResidentTurnStage") 1)) 32)
                (fcrtbmlb-bit (and (eq (fcrtbmlb-has? high-source
                    "scannerless-byte-fold-no-tokenizer") 1)
                    (eq (fcrtbmlb-has? high-source "SourceScanner") 0)) 64)
                (fcrtbmlb-bit (eq (fcrtbmlb-terminal-vocabulary?) 1) 128)
                (fcrtbmlb-bit (and (eq (fcrtbml-terminal "live") 0)
                    (eq (fcrtbml-terminal "undo") 0)) 256)
                (fcrtbmlb-bit (and (eq (fcrtbml-runnable "live" 1) 1)
                    (and (eq (fcrtbml-runnable "live" 0) 0)
                    (and (eq (fcrtbml-runnable "cut" 8) 0)
                         (eq (fcrtbml-runnable "release" 8) 0)))) 512)
                (fcrtbmlb-bit (and (eq (fcrtbml-stop-carries 1) 1)
                    (eq (fcrtbml-stop-carries 0) 0)) 1024)
                (fcrtbmlb-bit (and (eq (fcrt-terminal? "cut") 1)
                    (and (eq (fcrt-terminal? "release") 1)
                    (and (eq (fcrt-terminal? "undo") 0)
                         (eq (fcrt-terminal? "live") 0)))) 2048)
                (fcrtbmlb-bit (and (str_eq (nth descriptor 0) "abstraction")
                    (and (str_eq (nth descriptor 1)
                        "FormCliResidentTurnwheel")
                    (eq (len (nth descriptor 3)) 4))) 4096)
                (fcrtbmlb-bit (and (eq (fcrtbmlb-has? executable-source
                    "choice-cut-undo-timeout") 1)
                    (eq (fcrtbmlb-has? executable-source
                    "nothing-is-not-zero-or-one") 1)) 8192)
                (fcrtbmlb-bit (and (eq (fcrtbmlb-has? xtal-source
                    "defn fcrtbml-terminal") 1)
                    (eq (fcrtbmlb-has? xtal-source
                    "defn fcrtbml-runnable") 1)) 16384)
                (fcrtbmlb-bit (and (eq (fcrtbmlb-has? high-source
                    "new epoch for new rows; pinned old epoch for live rows") 1)
                    (eq (fcrtbmlb-has? high-source
                    "terminal row and carried session agree") 1)) 32768)))))

    (fcrtbmlb-run))
