; tests/genekey-profile-band.fk — the hologenetic profile cast end to end, pinned.
;
; The test vector is a real birth-moment (1971-10-06 08:15 UT, Luzern — the cast that
; brought this cell home; receipts/2026-08-01-genekey-urs.md). Every pinned gate and
; line below was confirmed by an independent witness (pyephem, epoch-of-date) — the
; band is a regression pin on the whole chain: clock -> ephemeris -> design moment ->
; of-date fold -> wheel -> line.
;
; Verdict 1111111 when every claim holds.
;   the profile is eleven spheres, named                         -> 1
;   the design Sun sits exactly 88 deg behind the natal Sun      -> 10
;   the Earth sits exactly opposite the Sun                      -> 100
;   every line is in 1..6                                        -> 1000
;   Life's Work pins to 48.4 (natal Sun, clock-precise)          -> 10000
;   Attraction pins to 10.1 (design Moon, 0.16 deg past a seam)  -> 100000
;   Pearl pins to 34.4 (natal Jupiter — the of-date fold decides) -> 1000000
;
; preludes: form-stdlib/core.fk form-stdlib/guidance-channel.fk form-stdlib/celestial-pole-channel.fk form-stdlib/trig.fk form-stdlib/ephemeris-sun.fk form-stdlib/ephemeris-moon.fk form-stdlib/ephemeris-nodes.fk form-stdlib/ephemeris-planets.fk form-stdlib/iching-channel.fk form-stdlib/hd-mandala-wheel.fk form-stdlib/genekey-profile.fk
;

(do
    (let p (hgp-profile 1971 10 6 8 15))

    ;; --- 1. eleven spheres, the first one named -----------------------
    (let shape-ok
        (if (eq (len p) 11)
            (if (str_eq (hgp-sphere-name (head p)) "Life's Work") 1 0) 0))

    ;; --- 2. the design Sun is 88 deg of arc behind the natal Sun ------
    (let arc (ang-diff (hgp-sphere-lon (nth p 0)) (hgp-sphere-lon (nth p 2))))
    (let design-ok (if (lt (abs-deg (sub arc 88.0)) 0.001) 10 0))

    ;; --- 3. the Earth is the Sun's opposite ---------------------------
    (let opp (ang-diff (hgp-sphere-lon (nth p 0)) (hgp-sphere-lon (nth p 1))))
    (let earth-ok (if (lt (abs-deg (sub opp 180.0)) 0.001) 100 0))

    ;; --- 4. every line is in 1..6 -------------------------------------
    (defn hgp-band-lines-ok (ps)
        (if (eq (len ps) 0) 1
            (if (ge (hgp-sphere-line (head ps)) 1)
                (if (lt (hgp-sphere-line (head ps)) 7)
                    (hgp-band-lines-ok (tail ps)) 0)
                0)))
    (let lines-ok (if (eq (hgp-band-lines-ok p) 1) 1000 0))

    ;; --- 5. Life's Work: Gate 48 line 4 (natal Sun) -------------------
    (let lw-ok
        (if (eq (hgp-sphere-gate (nth p 0)) 48)
            (if (eq (hgp-sphere-line (nth p 0)) 4) 10000 0) 0))

    ;; --- 6. Attraction: Gate 10 line 1 (design Moon) ------------------
    (let attr-ok
        (if (eq (hgp-sphere-gate (nth p 4)) 10)
            (if (eq (hgp-sphere-line (nth p 4)) 1) 100000 0) 0))

    ;; --- 7. Pearl: Gate 34 line 4 — the read the of-date fold decides;
    ;;        without the fold the J2000 frame answers line 5 -----------
    (let pearl-ok
        (if (eq (hgp-sphere-gate (nth p 10)) 34)
            (if (eq (hgp-sphere-line (nth p 10)) 4) 1000000 0) 0))

    (sum (list shape-ok design-ok earth-ok lines-ok lw-ok attr-ok pearl-ok)))
