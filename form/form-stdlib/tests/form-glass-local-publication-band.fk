; Pure acknowledged-publication contract; verdict 255. No live state is written.
; preludes: form/form-stdlib/form-glass-live.bml
(do
  (defn glpb-bit (ok bit) (if ok bit 0))
  (let given (list (GGFSchema) "given" (fgsr-publisher "glass") "" 42))
  (let rows (fgo-observe-rows (list (fgo-int "kernel" "fixture" "fixture" 7 "calls" 0 "cpu" "physical-live" "fixture" "live" "kernel" "fixture")) 100 9))
  (let localRows (fgl-local-published-rows given 200 rows "/fixture"))
  (let frame (head localRows))
  (print (sum (list
    (glpb-bit (fgl-local-given? given) 1)
    (glpb-bit (eq (fgl-local-given? (list)) 0) 2)
    (glpb-bit (eq (len (fgl-local-published-rows (list (GGFSchema) "refused" (fgsr-publisher "glass") "" -1) 200 rows "/fixture")) 0) 4)
    (glpb-bit (eq (fgl-local-given? (list (GGFSchema) "given" (fgsr-publisher "owner") "" 42)) 0) 8)
    (glpb-bit (eq (fgl-local-given? (list (GGFSchema) "given" (fgsr-publisher "glass") "" 0)) 0) 16)
    (glpb-bit (and (eq (fgo-int-value frame) 42) (eq (fgo-observed-epoch frame) 200)) 32)
    (glpb-bit (and (eq (len localRows) 2) (and (eq (fgo-int-value (nth localRows 1)) 7) (eq (fgo-observed-epoch (nth localRows 1)) 100))) 64)
    (glpb-bit (and (str_eq (fgo-source frame) "shm:/fixture") (ge (str_find (fgo-note frame) "without decoding" 0) 0)) 128)
  )))
)
