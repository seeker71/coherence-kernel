; form-cli-rented-turn-meter-band.fk -- the BML meter counts output-token
; fields exactly and keeps absent data distinct from an observed zero.
; Expected: 255
; preludes: form-stdlib/form-cli-movement.bml

(do
    (defn fcrtm-bit (ok bit) (if ok bit 0))
    (let many "{\"last_token_usage\":{\"output_tokens\":7},\"total_token_usage\":{\"output_tokens\":700}}\n{\"last_token_usage\":{\"output_tokens\":0},\"total_token_usage\":{\"output_tokens\":700}}\n{\"last_token_usage\":{\"output_tokens\":13},\"total_token_usage\":{\"output_tokens\":1300}}\n")
    (let none "{\"total_token_usage\":{\"output_tokens\":99}}\n")
    (let later "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx{\"last_token_usage\":{\"output_tokens\":9}}\n")
    (let state (rtm-state "/private/rollout" 99 20))
    (let parsed (rtm-state-from-text (rtm-state-text state)))
    (sum (list
        (fcrtm-bit (eq (rtm-sum many) 20) 1)
        (fcrtm-bit (eq (rtm-slice-sum many 1) 20) 2)
        (fcrtm-bit (eq (rtm-sum none) 0) 4)
        (fcrtm-bit (eq (rtm-slice-sum later 0) 9) 8)
        (fcrtm-bit (eq (rtm-chunk) 1048576) 16)
        (fcrtm-bit (eq (rtm-over) 32) 32)
        (fcrtm-bit (and (str_eq (rtm-output-mark) "\"output_tokens\":")
            (str_eq (rtm-last-usage-mark) "\"last_token_usage\":")) 64)
        (fcrtm-bit (and (eq (rtm-sum "{\"last_token_usage\":{\"output_tokens\":0}}\n") 0)
            (and (eq (rtm-state? parsed) 1)
                (and (str_eq (rtm-state-path parsed) "/private/rollout")
                    (and (eq (rtm-state-size parsed) 99)
                        (eq (rtm-state-total parsed) 20))))) 128))))
