; form-cli-rented-turn-meter-band.fk -- the BML meter counts the rented mind's
; output tokens exactly on both carriers and keeps absent data distinct from an
; observed zero.
;   1     Codex call-local last_token_usage sums; cumulative total_token_usage does not
;   2     an open row is not read from its partial number; resume names its mark,
;         and a mark cut at the slice end is held back for the next slice
;   4     absent usage sums 0; absent or empty state text is nothing, not a zero state
;   8     resuming at that mark counts the completed row once
;   16    chunk 1 MiB
;   32    over 32 bytes
;   64    the four marks are spelled as the carriers write them
;   128   an observed zero stays zero; v3 state round-trips path, extent, total, seen
;   256   a Claude Code transcript row counts its top-level usage output once,
;         not the iterations repeat
;   512   the rows of one request, one per content block, are one spend
;   1024  a verbatim re-append of earlier rows, and a tool result echoing usage,
;         count nothing
;   2048  a row naming no request counts nothing; a request an earlier reading
;         counted stays counted once
;   4096  an open transcript row stays undecided and counts once when resumed whole
; Verdict 8191
; witnessed: 2026-09-11 -> 8191
; preludes: form-stdlib/form-cli-movement.bml

(do
    (defn fcrtm-bit (ok bit) (if ok bit 0))
    (defn fcrtm-desk (block out req)
        (str_concat "{\"parentUuid\":\"p\",\"isSidechain\":false,\"message\":{\"model\":\"claude-opus-5\",\"id\":\"msg_"
        (str_concat req
        (str_concat "\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"t\"}],\"usage\":{\"input_tokens\":2,\"cache_read_input_tokens\":41153,\"output_tokens\":"
        (str_concat (int_to_str out)
        (str_concat ",\"output_tokens_details\":{\"thinking_tokens\":213},\"iterations\":[{\"input_tokens\":2,\"output_tokens\":"
        (str_concat (int_to_str out)
        (str_concat ",\"type\":\"message\"}],\"speed\":\"standard\"}},\"apiBlockIndex\":"
        (str_concat (int_to_str block)
        (str_concat ",\"requestId\":\"req_"
        (str_concat req "\",\"type\":\"assistant\",\"uuid\":\"u\"}\n")))))))))))
    (let cdx7 "{\"last_token_usage\":{\"output_tokens\":7},\"total_token_usage\":{\"output_tokens\":700}}\n")
    (let many (str_concat cdx7 "{\"last_token_usage\":{\"output_tokens\":0},\"total_token_usage\":{\"output_tokens\":700}}\n{\"last_token_usage\":{\"output_tokens\":13},\"total_token_usage\":{\"output_tokens\":1300}}\n"))
    (let none "{\"total_token_usage\":{\"output_tokens\":99}}\n")
    (let cdx-open (str_concat cdx7 "{\"last_token_usage\":{\"output_tokens\":1"))
    (let cdx-read (rtm-scan cdx-open 0 (rtm-seen-none)))
    (let cdx-whole (str_concat cdx7 "{\"last_token_usage\":{\"output_tokens\":13}}\n"))
    (let a0 (fcrtm-desk 0 367 "A"))
    (let a1 (fcrtm-desk 1 367 "A"))
    (let a2 (fcrtm-desk 2 367 "A"))
    (let b0 (fcrtm-desk 0 520 "B"))
    (let b1 (fcrtm-desk 1 520 "B"))
    (let tool-echo "{\"type\":\"user\",\"message\":{\"content\":[{\"type\":\"tool_result\",\"content\":\"\\\"usage\\\":{\\\"output_tokens\\\":999},\\\"requestId\\\":\\\"req_Z\\\"\"}]}}\n")
    (let synth "{\"message\":{\"model\":\"<synthetic>\",\"usage\":{\"input_tokens\":0,\"output_tokens\":5}},\"type\":\"assistant\"}\n")
    (let desk-whole (str_concat a0 b0))
    (let desk-read (rtm-scan (substring desk-whole 0 (add (str_len a0) 250)) 0 (rtm-seen-none)))
    (let desk-mark (add (str_len a0) (str_find b0 "\"usage\":" 0)))
    (let state (rtm-state "/private/rollout" 99 20 ",req_A,"))
    (let parsed (rtm-state-from-text (rtm-state-text state)))
    (sum (list
        (fcrtm-bit (eq (rtm-sum many) 20) 1)
        (fcrtm-bit (and (eq (nth cdx-read 0) 7)
            (and (eq (nth cdx-read 1) (str_find cdx-open "\"last_token_usage\":" (str_len cdx7)))
                (eq (nth (rtm-scan (str_concat cdx7 "xx{\"last_tok") 0 (rtm-seen-none)) 1) (str_len cdx7)))) 2)
        (fcrtm-bit (and (eq (rtm-sum none) 0)
            (and (nothing? (rtm-state-from-text (nothing)))
                 (nothing? (rtm-state-from-text "")))) 4)
        (fcrtm-bit (eq (nth (rtm-scan (substring cdx-whole (nth cdx-read 1) (str_len cdx-whole)) (nth cdx-read 0) (nth cdx-read 2)) 0) 20) 8)
        (fcrtm-bit (eq (rtm-chunk) 1048576) 16)
        (fcrtm-bit (eq (rtm-over) 32) 32)
        (fcrtm-bit (and (str_eq (rtm-output-mark) "\"output_tokens\":")
            (and (str_eq (rtm-last-usage-mark) "\"last_token_usage\":")
                (and (str_eq (rtm-usage-mark) "\"usage\":")
                    (str_eq (rtm-request-mark) "\"requestId\":\"")))) 64)
        (fcrtm-bit (and (eq (rtm-sum "{\"last_token_usage\":{\"output_tokens\":0}}\n") 0)
            (and (eq (rtm-state? parsed) 1)
                (and (str_eq (rtm-state-path parsed) "/private/rollout")
                    (and (eq (rtm-state-extent parsed) 99)
                        (and (eq (rtm-state-total parsed) 20)
                            (str_eq (rtm-state-seen parsed) ",req_A,")))))) 128)
        (fcrtm-bit (eq (rtm-sum a0) 367) 256)
        (fcrtm-bit (eq (rtm-sum (str_concat a0 (str_concat a1 (str_concat a2 (str_concat b0 b1))))) 887) 512)
        (fcrtm-bit (eq (rtm-sum (str_concat a0 (str_concat a1 (str_concat tool-echo (str_concat b0 (str_concat b1 (str_concat a0 a1))))))) 887) 1024)
        (fcrtm-bit (and (eq (rtm-sum synth) 0)
            (and (eq (nth (rtm-scan desk-whole 0 ",req_A,") 0) 520)
                (str_eq (nth (rtm-scan desk-whole 0 ",req_A,") 2) ",req_A,req_B,"))) 2048)
        (fcrtm-bit (and (eq (nth desk-read 0) 367)
            (and (eq (nth desk-read 1) desk-mark)
                (eq (nth (rtm-scan (substring desk-whole desk-mark (str_len desk-whole)) (nth desk-read 0) (nth desk-read 2)) 0) 887))) 4096))))
