; More than 1000 generated IDs remain a count, never an invalid heat value.
; Pure samples only; no Glass publication. Expected 7.
; preludes: form-stdlib/bml/form-cli-code-live.bml
(do
 (let s (fcap-open "task" (list) (list)))
 (let row (fcac-metric s "generated-ids" 9000 (now_unix_ms)))
 (add (if (fgtm-sample-valid? row) 1 0)
  (add (if (eq (fgtm-field-value (fgtm-sample-capacity row)) 9000) 2 0)
   (if (eq (fgtm-field-present? (fgtm-sample-heat row)) 0) 4 0))))
