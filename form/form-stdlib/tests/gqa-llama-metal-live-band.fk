; preludes: form-stdlib/core.fk form-stdlib/transformer-numerics.fk form-stdlib/trig.fk form-stdlib/llama-numerics.fk form-stdlib/rope.fk form-stdlib/transformer-block.fk form-stdlib/transformer-mh.fk form-stdlib/llama-block.fk form-stdlib/llama-gqa-block.fk form-stdlib/tensor-ir.fk form-stdlib/jit-tensor-emit.fk form-stdlib/metal-door.fk form-stdlib/lora-adapter.bml
;
; gqa-llama-metal-live-band — the two GROUPED-QUERY llama families run on this host's GPU: the causal
; whole-sequence block and the decode step. Both were refused here until 2026-09-09 (the `round` their
; shared helper calls was defined in no unit), and neither had ever produced a number on this silicon.
;
; HOW THEY ARE ANCHORED, on both axes, against recipes. The REDUCTION first: NQ = dq / HD, so at
; dq = KVD = HD and nkv = 1 there is exactly one query head reading exactly one kv head, and the kernel
; must then be `lblk-block-causal` — the four-way-proven recipe — to the last element. That anchors the
; whole block ASSEMBLY: RMSNorm, RoPE, the causal mask, SwiGLU, both residual highways, the cache.
;
; Then the PARTITION, which the reduction cannot reach because at one head there is no partition. Bits
; 32 and 64 run both kernels at genuine grouping — dq 4, HD 2 so NQ = 2, KVD 2, nkv 1: two query heads
; sharing one kv head — and hold every element to `lgqa-block-causal` (llama-gqa-block.fk), the body's
; own GQA recipe, at the inert base-10000 rope-cfg so the comparison isolates the head partition.
;
; An earlier draft of this band spent bit 32 on a LIVENESS check instead: run at grouping, demand the
; answer move. It moved. It was also reading a wo buffer tail the band never wrote, because that draft
; truncated wo to d x KVD — wo is d x dq and the attention output stays dq-wide, head-major — so the
; bit passed on a wrong shape for a reason unrelated to grouping. A liveness bit is the weakest thing
; a band can say and the easiest to fool.
;
; The draft after THAT wrote a fresh GQA recipe into llama-block.fk, because a grep for `gqa` across
; two files found nothing. `llama-gqa-block.fk` had carried `lgqa-block-causal` the whole time, with
; RoPE scaling this one does not even have. The duplicate is gone; a name you cannot find is a name
; you searched for in one shape (`lblk-gqa-`) when the body spells it in another (`lgqa-`), and the
; cheap reflex is a repo-wide grep before the first line, not after the last.
;
; Telling the recipe n_kv = 2 when the kernel groups at n_kv = 1 drops both bits to 31; telling the
; kernel HD = 4 when the recipe partitions at HD = 2 drops the block bit to 95.
;
; Verdict 127 when the silicon answers:
;    1  both pipelines mint, and every dispatch and sync comes back clean
;    2  the GQA causal block is `lblk-block-causal` at ALL THREE positions, element by element
;    4  the GQA decode step at p = 2 is `lblk-block-causal`'s position 2 — the cache reproduces the block
;    8  the decode wrote its own RoPE'd key and its own value into the KVD-strided cache at slot p
;   16  THE CACHE IS READ: perturb a cached key from an earlier position and the decode's answer MOVES
;   32  GENUINE GROUPING, ELEMENT BY ELEMENT: two query heads over one kv head, held to
;       `lgqa-block-causal` at all three positions — the head partition itself, not a liveness bit
;   64  and the DECODE step at that same grouping, over a KVD-strided cache, with its own k and v
;
(do
    (defn gll-close? (a b)
        (lt (if (lt (sub a b) 0.0) (sub b a) (sub a b)) 0.0000305))
    (defn gll-f32s (xs)
        (if (eq (len xs) 0) ""
            (str_concat (md-le32 (md-f32-bits (head xs))) (gll-f32s (tail xs)))))
    (defn gll-getf (h i) (ln-f32-decode (ln-u32-le (metal_buf_read h (mul i 4) 4) 0)))
    (defn gll-flat (rows) (if (eq (len rows) 0) (empty) (tb-cat (head rows) (gll-flat (tail rows)))))
    (defn gll-agree? (h xs i)
        (if (eq (len xs) 0) 1
            (if (gll-close? (gll-getf h i) (head xs)) (gll-agree? h (tail xs) (add i 1)) 0)))
    (defn gll-quad (h i) (list (gll-getf h i) (gll-getf h (add i 1)) (gll-getf h (add i 2)) (gll-getf h (add i 3))))
    (defn gll-differ? (as bs)
        (if (eq (len as) 0) 0
            (if (gll-close? (head as) (head bs)) (gll-differ? (tail as) (tail bs)) 1)))
    (defn gll-take (xs n) (if (eq n 0) (empty) (cons (head xs) (gll-take (tail xs) (sub n 1)))))

    ; --- S 3, d 4, dq 4, hid 6; the reduction runs at HD 4 / KVD 4 / nkv 1 (one query head) ---
    (let XS (list (list 1.5 -0.75 0.5 0.25) (list -0.25 0.875 -1.25 0.625) (list 0.75 0.375 -0.5 1.125)))
    (let G1 (list 1.25 0.75 -0.5 1.125))
    (let WQ (list (list 0.5 -0.25 0.125 0.375) (list -0.375 0.625 0.25 -0.125)
                  (list 0.25 0.5 -0.75 0.125) (list 0.625 -0.5 0.375 0.25)))
    (let WK (list (list 0.25 0.5 -0.375 0.125) (list 0.75 -0.125 0.25 0.5)
                  (list -0.5 0.375 0.625 -0.25) (list 0.125 0.25 -0.125 0.75)))
    (let WV (list (list 0.5 -0.25 0.125 0.625) (list -0.75 0.5 0.25 -0.375)
                  (list 0.25 0.125 -0.5 0.75) (list 0.375 -0.625 0.5 0.125)))
    (let WO (list (list 0.75 -0.125 0.5 0.25) (list 0.25 0.625 -0.375 0.5)
                  (list -0.5 0.125 0.875 -0.25) (list 0.125 -0.375 0.25 0.625)))
    (let G2 (list 0.875 -1.125 0.625 0.75))
    (let WG (list (list 0.5 -0.25 0.125 0.375) (list 0.75 0.375 -0.5 0.125)
                  (list -0.125 0.625 0.25 -0.75) (list 0.25 -0.75 0.5 0.375)
                  (list 0.625 0.125 -0.25 0.5) (list -0.375 0.5 0.75 -0.125)))
    (let WU (list (list 0.25 0.5 -0.125 0.625) (list -0.5 0.125 0.75 -0.25)
                  (list 0.375 -0.625 0.25 0.5) (list 0.125 0.75 -0.375 0.25)
                  (list -0.25 0.375 0.5 -0.625) (list 0.5 -0.125 0.625 0.375)))
    (let WD (list (list 0.5 -0.25 0.125 0.375 -0.625 0.25) (list 0.25 0.625 -0.5 0.125 0.375 -0.75)
                  (list -0.375 0.125 0.75 -0.25 0.5 0.625) (list 0.625 -0.5 0.25 0.75 -0.125 0.375)))
    (let SCALE 0.5)
    (let EPS 0.00001)

    ; --- the recipe, fp64, at HD 4 (one head) ---
    (let e-blk (lblk-block-causal XS G1 EPS WQ WK WV WO SCALE 4 G2 WG WU WD))
    (let n1 (lblk-rms-seq XS G1 EPS))
    (let e-ks (lblk-rope-seq (lblk-proj-seq WK n1) 4))
    (let e-vs (lblk-proj-seq WV n1))

    ; --- mint both ---
    (let pb (metal_pipeline (jte-gqa-llama-block-fwd-causal-msl "form_gqa_blk_live_f32") "form_gqa_blk_live_f32"))
    (let pd (metal_pipeline (jte-gqa-llama-block-decode-step-msl "form_gqa_dec_live_f32") "form_gqa_dec_live_f32"))

    (let bwq (metal_buf_alloc 64))  (let bwk (metal_buf_alloc 64))
    (let bwv (metal_buf_alloc 64))  (let bwo (metal_buf_alloc 64))
    (let bg1 (metal_buf_alloc 16))  (let bg2 (metal_buf_alloc 16))
    (let bwg (metal_buf_alloc 96))  (let bwu (metal_buf_alloc 96))
    (let bwd (metal_buf_alloc 96))
    (let bxs (metal_buf_alloc 48))  (let bx1 (metal_buf_alloc 16))
    (let byb (metal_buf_alloc 48))  (let byd (metal_buf_alloc 16))
    (let bck (metal_buf_alloc 48))  (let bcv (metal_buf_alloc 48))
    (let bscb (metal_buf_alloc 16384)) (let bscd (metal_buf_alloc 16384))
    (let z0 (metal_buf_write bwq 0 (gll-f32s (gll-flat WQ))))
    (let z1 (metal_buf_write bwk 0 (gll-f32s (gll-flat WK))))
    (let z2 (metal_buf_write bwv 0 (gll-f32s (gll-flat WV))))
    (let z3 (metal_buf_write bwo 0 (gll-f32s (gll-flat WO))))
    (let z4 (metal_buf_write bg1 0 (gll-f32s G1)))
    (let z5 (metal_buf_write bwg 0 (gll-f32s (gll-flat WG))))
    (let z6 (metal_buf_write bwu 0 (gll-f32s (gll-flat WU))))
    (let z7 (metal_buf_write bwd 0 (gll-f32s (gll-flat WD))))
    (let z8 (metal_buf_write bg2 0 (gll-f32s G2)))
    (let z9 (metal_buf_write bxs 0 (gll-f32s (gll-flat XS))))
    (let z10 (metal_buf_write bx1 0 (gll-f32s (nth XS 2))))
    (let z11 (metal_buf_write bck 0 (gll-f32s (tb-cat (nth e-ks 0) (nth e-ks 1)))))
    (let z12 (metal_buf_write bcv 0 (gll-f32s (tb-cat (nth e-vs 0) (nth e-vs 1)))))

    ; --- the causal block, one query head: S d dq KVD hid HD nkv scale eps ---
    (let bdims (list 3 4 4 4 6 4 1 (md-f32-bits SCALE) (md-f32-bits EPS)))
    (let eb (metal_enqueue pb (md-bind16 (list bwq bwk bwv bwo bg1 bwg bwu bwd bg2 bxs byb bscb) bdims 1 0 0 0) 1))
    (let sb (metal_sync))

    ; --- the decode step at p = 2: p d dq KVD hid HD nkv scale eps ---
    (let ddims (list 2 4 4 4 6 4 1 (md-f32-bits SCALE) (md-f32-bits EPS)))
    (let dbufs (list bwq bwk bwv bwo bg1 bwg bwu bwd bg2 bx1 bck bcv byd bscd))
    (let ed (metal_enqueue pd (md-bind16 dbufs ddims 1 0 0 0) 1))
    (let sd (metal_sync))
    (let c0 (if (gt pb 0) (if (gt pd 0) (if (ge eb 0) (if (ge sb 0) (if (ge ed 0) (if (ge sd 0) 1 0) 0) 0) 0) 0) 0))

    (let c1 (if (eq (gll-agree? byb (nth e-blk 0) 0) 1)
            (if (eq (gll-agree? byb (nth e-blk 1) 4) 1)
            (if (eq (gll-agree? byb (nth e-blk 2) 8) 1) 2 0) 0) 0))
    (let c2 (if (eq (gll-agree? byd (nth e-blk 2) 0) 1) 4 0))
    (let c3 (if (eq (gll-agree? bck (nth e-ks 2) 8) 1)
            (if (eq (gll-agree? bcv (nth e-vs 2) 8) 1) 8 0) 0))
    (let d-true (gll-quad byd 0))

    ; --- perturb a cached key from position 1 and demand the decode moves ---
    (let z13 (metal_buf_write bck 0 (gll-f32s (tb-cat (nth e-ks 0) (tb-vec-add (nth e-ks 1) (list 0.5 0.0 0.0 0.0))))))
    (let ed2 (metal_enqueue pd (md-bind16 dbufs ddims 1 0 0 0) 1))
    (let sd2 (metal_sync))
    (let c4 (if (ge sd2 0) (if (eq (gll-differ? d-true (gll-quad byd 0)) 1) 16 0) 0))

    ; --- GENUINE GROUPING, held to the recipe element by element. Two query heads over one kv head:
    ; dq stays 4, HD becomes 2 so NQ = dq/HD = 2, and KVD = nkv*HD = 2, so wk and wv narrow to KVD x d
    ; while wq and wo DO NOT MOVE — wo is d x dq and the attention output is still dq-wide, head-major.
    ; An earlier draft of this band truncated wo to d x KVD and asked only whether the answer moved. It
    ; moved, and the bit passed, and it was measuring the kernel reading a buffer tail the band never
    ; wrote. A liveness bit is the weakest thing a band can say and the easiest to fool; now that
    ; lblk-gqa-block-causal exists, the partition has a recipe and gets checked like everything else. ---
    (let WK2 (gll-take WK 2))
    (let WV2 (gll-take WV 2))
    (let RCFG (rope-cfg 10000.0 32.0 1.0 4.0 8192.0))
    (let e-gblk (lgqa-block-causal XS G1 EPS WQ WK2 WV2 WO SCALE 2 1 2 RCFG G2 WG WU WD))
    (let g-n1 (lblk-rms-seq XS G1 EPS))
    (let g-ks (lgqa-rope-seq (lblk-proj-seq WK2 g-n1) 2 RCFG))
    (let g-vs (lblk-proj-seq WV2 g-n1))
    (let z14 (metal_buf_write bwk 0 (gll-f32s (gll-flat WK2))))
    (let z15 (metal_buf_write bwv 0 (gll-f32s (gll-flat WV2))))
    (let gdims (list 3 4 4 2 6 2 1 (md-f32-bits SCALE) (md-f32-bits EPS)))
    (let eg (metal_enqueue pb (md-bind16 (list bwq bwk bwv bwo bg1 bwg bwu bwd bg2 bxs byb bscb) gdims 1 0 0 0) 1))
    (let sg (metal_sync))
    (let c5 (if (ge sg 0)
            (if (eq (gll-agree? byb (nth e-gblk 0) 0) 1)
            (if (eq (gll-agree? byb (nth e-gblk 1) 4) 1)
            (if (eq (gll-agree? byb (nth e-gblk 2) 8) 1) 32 0) 0) 0) 0))

    ; --- and the DECODE step at the same genuine grouping, over a KVD-strided cache ---
    (let z17 (metal_buf_write bck 0 (gll-f32s (tb-cat (nth g-ks 0) (nth g-ks 1)))))
    (let z18 (metal_buf_write bcv 0 (gll-f32s (tb-cat (nth g-vs 0) (nth g-vs 1)))))
    (let gddims (list 2 4 4 2 6 2 1 (md-f32-bits SCALE) (md-f32-bits EPS)))
    (let egd (metal_enqueue pd (md-bind16 dbufs gddims 1 0 0 0) 1))
    (let sgd (metal_sync))
    (let c6 (if (ge sgd 0)
            (if (eq (gll-agree? byd (nth e-gblk 2) 0) 1)
            (if (eq (gll-agree? bck (nth g-ks 2) 4) 1)
            (if (eq (gll-agree? bcv (nth g-vs 2) 4) 1) 64 0) 0) 0) 0))

    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6)))))))
