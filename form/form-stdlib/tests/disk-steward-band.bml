; disk-steward-band.bml — the body's disk awareness, fkwu-witnessed (form-stdlib/bml/disk-steward.bml).
;
; The steward senses the volume, lists the leases it made, composts waste at every tending and weighed leases only
; under pressure, and reads merged own branches. Each claim below is pure over fixtures or over a scratch directory this
; band makes and removes; no host child is begun and nothing outside the scratch is touched.
;
; Expected: 127
; Verdict 127 when every claim lands:
;   1   df -k text reads to [total, free] bytes from its last line; text that does not read answers [0, 0]
;   2   wanted bytes: 0 when free stands above the reserve (a tenth of the volume, at most 100 GiB), the gap otherwise
;   4   kinds: a compile image whose source stands is "image"; one whose source is gone is "orphan-image"; a companion
;       log is "kept"; a .hearth .out file is "log"
;   8   the choice: waste (an orphan image, an old log) is released with no pressure; a fresh image is not; under
;       pressure the biggest, oldest, cheapest lease goes first and the choice stops once the wanted bytes are met
;  16   act 0 removes nothing from the scratch; act 1 removes exactly the chosen paths
;  32   merged own branches: codex/ and claude/ names stay, main and others do not, and a branch a worktree stands on
;       is never listed
;  64   form-run captures in a temp tree: a capture written just now is "capture-live" and never waste; one untouched
;       for two days is "capture" and waste; the .pipe files are not leases; a tree with no captures lists none
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/disk-steward.bml
section [form.bml] {
 class DiskStewardBand {
  def dsb-df() = "Filesystem    1024-blocks      Used Available Capacity iused ifree %iused  Mounted on\n/dev/disk3s1  1942700360 1840000000 102700360    95%  455k  1.2M   28%   /System/Volumes/Data";
  def dsb-c-df(ctx) {
   let r = ds-parse-df(dsb-df());
   r[0] == 1942700360 * 1024 && r[1] == 102700360 * 1024 && ds-parse-df("")[0] == 0 && ds-parse-df("nonsense")[1] == 0;
  }
  def dsb-c-wanted(ctx) = ds-wanted(1000 * ds-gib(), 200 * ds-gib()) == 0 && ds-wanted(1000 * ds-gib(), 60 * ds-gib()) == 40 * ds-gib() && ds-wanted(500 * ds-gib(), 10 * ds-gib()) == 40 * ds-gib();
  def dsb-dir() = ".hearth/disk-steward-band";
  def dsb-make() {
   let root = fs_mkdir(".hearth");
   let d = fs_mkdir(dsb-dir());
   let h = fs_mkdir(dsb-dir() ++ "/.hearth");
   let c = fs_mkdir(dsb-dir() ++ "/.hearth/companion");
   let src = write_file_text(dsb-dir() ++ "/a.bml", "section [form.bml] { 0; }\n");
   let img = write_file_text(dsb-dir() ++ "/a.bml.fkb", "image-bytes");
   let orphan = write_file_text(dsb-dir() ++ "/gone.bml.fkb", "orphan-image-bytes");
   let log = write_file_text(dsb-dir() ++ "/.hearth/old.out", "a very long log line that is pure waste once it is old enough to be waste");
   let kept = write_file_text(dsb-dir() ++ "/.hearth/companion/conversation.jsonl", "{}");
   let aged = host_utimes(dsb-dir() ++ "/.hearth/old.out", now_unix_ms() - 30 * 86400 * 1000);
   1;
  }
  def dsb-clean() {
   let a = host_path_remove(dsb-dir() ++ "/a.bml");
   let b = host_path_remove(dsb-dir() ++ "/a.bml.fkb");
   let c = host_path_remove(dsb-dir() ++ "/gone.bml.fkb");
   let d = host_path_remove(dsb-dir() ++ "/.hearth/old.out");
   let e = host_path_remove(dsb-dir() ++ "/.hearth/companion/conversation.jsonl");
   let f = fs_rmdir(dsb-dir() ++ "/.hearth/companion");
   let g = fs_rmdir(dsb-dir() ++ "/.hearth");
   let h = fs_rmdir(dsb-dir());
   1;
  }
  def dsb-c-kinds(ctx) {
   let made = dsb-make();
   let ok = (String) ds-kind(dsb-dir() ++ "/a.bml.fkb") == "image" && (String) ds-kind(dsb-dir() ++ "/gone.bml.fkb") == "orphan-image" && (String) ds-kind(dsb-dir() ++ "/.hearth/companion/conversation.jsonl") == "kept" && (String) ds-kind(dsb-dir() ++ "/.hearth/old.out") == "log";
   let cleaned = dsb-clean();
   ok;
  }
  // fixture leases: [path, kind, bytes, age_days, make_ms]
  def dsb-fresh-image() = ["x/a.bml.fkb", "image", 2000, 0, 60];
  def dsb-orphan() = ["x/gone.bml.fkb", "orphan-image", 100, 1, 0];
  def dsb-old-log() = ["x/.hearth/old.out", "log", 50000, 30, 0];
  def dsb-big-old-cheap() = ["x/.hearth/scratch.bin", "scratch", 9000000, 40, 10];
  def dsb-small-fresh-costly() = ["x/.hearth/prefix-cache/r.f32", "prefix-row", 4000, 0, 3000];
  def dsb-c-choice(ctx) {
   let calm = ds-choose([dsb-fresh-image(), dsb-orphan(), dsb-old-log(), dsb-big-old-cheap(), dsb-small-fresh-costly()], 0);
   let calmOk = len(calm[0]) == 2 && ds-in?(dsb-orphan(), calm[0]) && ds-in?(dsb-old-log(), calm[0]) && !ds-in?(dsb-fresh-image(), calm[0]);
   let pressed = ds-choose([dsb-fresh-image(), dsb-orphan(), dsb-old-log(), dsb-big-old-cheap(), dsb-small-fresh-costly()], 60000);
   let pressedOk = ds-in?(dsb-big-old-cheap(), pressed[0]) && !ds-in?(dsb-small-fresh-costly(), pressed[0]) && !ds-in?(dsb-fresh-image(), pressed[0]) && len(pressed[0]) == 3;
   calmOk && pressedOk;
  }
  def dsb-c-act(ctx) {
   let made = dsb-make();
   let now = now_unix_ms() / 1000;
   let leases = filter(l => (String) ds-lkind(l) != "kept", ds-leases(dsb-dir(), now));
   let chosen = ds-choose(leases, 0);
   let dry = ds-release(chosen[0], 0);
   let stillThere = (Comparable) fs_exists(dsb-dir() ++ "/gone.bml.fkb") == 1 && (Comparable) fs_exists(dsb-dir() ++ "/.hearth/old.out") == 1;
   let acted = ds-release(chosen[0], 1);
   let gone = (Comparable) fs_exists(dsb-dir() ++ "/gone.bml.fkb") == 0 && (Comparable) fs_exists(dsb-dir() ++ "/.hearth/old.out") == 0;
   let kept = (Comparable) fs_exists(dsb-dir() ++ "/a.bml.fkb") == 1 && (Comparable) fs_exists(dsb-dir() ++ "/.hearth/companion/conversation.jsonl") == 1;
   let cleaned = dsb-clean();
   dry == 0 && stillThere && acted > 0 && gone && kept;
  }
  def dsb-c-branches(ctx) {
   let merged = "main\ncodex/done-a\nclaude/done-b\nclaude/standing-c\nfeature/other\n* codex/current\n";
   let porcelain = "worktree /repo\nHEAD abc\nbranch refs/heads/main\n\nworktree /repo/.wt/c\nHEAD def\nbranch refs/heads/claude/standing-c\n";
   let free = ds-merged-free(merged, porcelain);
   len(free) == 2 && ds-in-list?("codex/done-a", free) && ds-in-list?("claude/done-b", free) && !ds-in-list?("claude/standing-c", free) && !ds-in-list?("main", free) && !ds-in-list?("feature/other", free);
  }
  def dsb-tmp() = ".hearth/disk-steward-band-tmp";
  def dsb-c-captures(ctx) {
   let root = fs_mkdir(".hearth");
   let t = fs_mkdir(dsb-tmp());
   let live = fs_mkdir(dsb-tmp() ++ "/form-run.live01");
   let dead = fs_mkdir(dsb-tmp() ++ "/form-run.dead01");
   let other = fs_mkdir(dsb-tmp() ++ "/pytest-of-someone");
   let w1 = write_file_text(dsb-tmp() ++ "/form-run.live01/stdout", "streaming now");
   let w2 = write_file_text(dsb-tmp() ++ "/form-run.live01/stdout.pipe", "");
   let w3 = write_file_text(dsb-tmp() ++ "/form-run.dead01/stdout", "left behind by a command that ended");
   let w4 = write_file_text(dsb-tmp() ++ "/pytest-of-someone/x", "not a capture");
   let aged = host_utimes(dsb-tmp() ++ "/form-run.dead01/stdout", now_unix_ms() - 2 * 86400 * 1000);
   let now = now_unix_ms() / 1000;
   let rows = ds-captures-in(dsb-tmp(), now);
   let liveRow = filter(l => ds-has?(ds-path(l), "live01"), rows);
   let deadRow = filter(l => ds-has?(ds-path(l), "dead01"), rows);
   let ok = len(rows) == 2 && len(liveRow) == 1 && (String) ds-lkind(liveRow[0]) == "capture-live" && !ds-waste?(liveRow[0]) && len(deadRow) == 1 && (String) ds-lkind(deadRow[0]) == "capture" && ds-waste?(deadRow[0]) && len(ds-captures-in(dsb-tmp() ++ "/pytest-of-someone", now)) == 0;
   let c1 = host_path_remove(dsb-tmp() ++ "/form-run.live01/stdout");
   let c2 = host_path_remove(dsb-tmp() ++ "/form-run.live01/stdout.pipe");
   let c3 = host_path_remove(dsb-tmp() ++ "/form-run.dead01/stdout");
   let c4 = host_path_remove(dsb-tmp() ++ "/pytest-of-someone/x");
   let d1 = fs_rmdir(dsb-tmp() ++ "/form-run.live01");
   let d2 = fs_rmdir(dsb-tmp() ++ "/form-run.dead01");
   let d3 = fs_rmdir(dsb-tmp() ++ "/pytest-of-someone");
   let d4 = fs_rmdir(dsb-tmp());
   ok;
  }
 }
 live-claims("disk-steward-band", 0, [["df", 1, 1, dsb-c-df], ["wanted", 2, 1, dsb-c-wanted], ["kinds", 4, 1, dsb-c-kinds], ["choice", 8, 1, dsb-c-choice], ["act", 16, 1, dsb-c-act], ["branches", 32, 1, dsb-c-branches], ["captures", 64, 1, dsb-c-captures]]);
}
