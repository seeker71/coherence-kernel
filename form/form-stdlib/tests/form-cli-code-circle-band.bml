; form-cli-code-circle-band.bml — the local satsang for code: audits, execution through publish, band and
; restore, a riftcase among execution-tied candidates, voices other than the writer's, consensus with an
; execution veto, refusals as evidence, and exactly one pointing when nothing passes.
;
; Verdict 1048575
;
; REQUIRES: ./fkwu children -- execution is the claim: each candidate is published over a toy copy of the
; closure-unit-line gap and its band runs in a ./fkwu child (host_spawn_at) under a deadline, and riftcase
; inputs run in ./fkwu children too.
;
; Fixtures: candidate A is the recorded option-1 candidate of the closure-unit-line gap (1212 bytes, sha256
; cf247900..., its band body reads 31); B is A with one swerve past the end of the text (also 31); S is a
; stub (28); L loops; N moves a read-only file; D claims done with no change; U moves the paren balance;
; W calls str_find with one argument. Each is published through the disk and read back by a ./fkwu child;
; voices, proposer and judge are scripted functions, and the one local-model voice is asked for a model
; that is not there, so no model opens.
; Claims:
;    1  execution ranks the full candidate first (A before S, though S comes first)
;    2  the circle accepts the full candidate whose voices pass
;    4  execution veto: S's voices all approve and pass by vote, yet S is refused by execution
;    8  riftcase: between A and B (both 31) the agreeing input is dropped and the separating input is kept,
;       and its judge's choice accepts A although B comes first
;   16  every emitted cell holds: the accepted consensus passes, every refusal is valid, the receipt is valid
;   32  a round where nothing passes offers exactly one pointing, not_command true
;   64  audits refuse a moved read-only file, a done claim with no change, and a moved paren balance
;  128  a looping candidate's band is stopped at the deadline, and the source returns byte for byte, no
;       marker left behind
;  256  a publish marker left by a dead process is restored over its own bytes (its ownprint); a live one
;       is left alone
;  512  a voice with the writer's own model and lens keeps silence
; 1024  the receipt's cost is the voices' local generated IDs
; 2048  the round's row reaches <root>/rounds.jsonl and reads back with its acceptance and its cost, exact
;       (voices_cost_unknown 0)
; 4096  a stop inside the publish window: the deferred restore returns the source, the window answers nothing
; 8192  heal never overwrites a later writer: a path changed after the killed publish keeps its bytes, the
;       marker stays, and the round's row carries the heal-conflict; once the path reads as its checkpoint,
;       the next heal clears the marker and writes nothing
; 16384 nothing is published before the marker lands (marker-unwritten) or over a marker this pid already
;       holds (marker-held); the source stays as the lane read it
; 32768 the audit refuses a .fk candidate whose call misses its arity (arity:)
; 65536 the riftcase prober runs a .bml band's surface: the candidate's answer comes back, the source returns
; 131072 a local-model voice whose model is not there abstains with 0 IDs, as a vote too
; 262144 unknown cost stays unknown: a voice that stops and one that answers nothing abstain apart, their IDs
;       are null, and the row's local_review_ids is a lower bound beside voices_cost_unknown
; 524288 once a restore does not hold, the remaining candidates stand unexecuted and nothing is accepted
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/form-cli-code-circle.bml
section [form.bml] {
 class CodeCircleBand {
  def ccb-root(ctx) = ctx[0];
  def ccb-src(ctx) = ctx[1];
  def ccb-band(ctx) = ctx[2];
  def ccb-notes(ctx) = ctx[3];
  def ccb-header() = "; closure-lines.fk — read a line of an fkwu closure back to the unit that wrote it.\n;\n; `./fkwu --closure <unit> <out>` joins every unit of a closure into one plain-Form\n; file and heads each unit's text with a line \"; unit: <path>\". A sibling kernel\n; reports a stop at a line of that file; this unit names the authored unit and\n; the line within it.\n\n(do\n";
  def ccb-original() = ccb-header() ++ "    0)\n";
  // the recorded candidate, with its end-of-text comparison named so B can swerve it
  def ccb-option(op) = ccb-header() ++ "  (defn cl-marker? (s at) (eq (str_find s \"; unit: \" at) at))\n  (defn cl-line-end (s at)\n    (do\n      (let e (str_find s (byte_to_str 10) at))\n      (if (lt e 0) (str_len s) e)))\n  (defn cl-walk (s at line want unit start)\n    (do\n      (if (" ++ op ++ " at (str_len s))\n          (nothing)\n          (do\n            (let end (cl-line-end s at))\n            (let mark (cl-marker? s at))\n            (if (eq line want)\n                (if (or mark (eq unit (nothing)))\n                    (nothing)\n                    (list unit (sub line start)))\n                (do\n                  (let next-unit (if mark (substring s (add at 8) end) unit))\n                  (let next-start (if mark line start))\n                  (cl-walk s (add end 1) (add line 1) want next-unit next-start)))))))\n  (defn cl-unit-at (text line) (cl-walk text 0 1 line (nothing) 0))\n   0)";
  def ccb-a() = ccb-option("ge");
  def ccb-b() = ccb-option("gt");
  def ccb-stub() = ccb-header() ++ "    (defn cl-unit-at (text line) (nothing))\n    0)\n";
  def ccb-loop() = ccb-header() ++ "    (defn cl-unit-at (text line) (cl-unit-at text line))\n    0)\n";
  def ccb-unbalanced() = ccb-header() ++ "    (defn cl-unit-at (text line) (nothing)))\n    0)\n";
  def ccb-wrong-arity() = ccb-header() ++ "    (defn cl-unit-at (text line) (str_find text))\n    0)\n";
  def ccb-band-text(src) = "; Verdict 31\n; preludes: form-stdlib/core.fk " ++ src ++ "\n(do\n    (defn clb-bit (ok n) (if ok n 0))\n    (defn clb-nl () (byte_to_str 10))\n    (let text (str_concat \"; unit: a.fk\" (str_concat (clb-nl)\n              (str_concat \"(defn a () 1)\" (str_concat (clb-nl)\n              (str_concat \"(defn a2 () 2)\" (str_concat (clb-nl)\n              (str_concat \"; unit: b/c.bml\" (str_concat (clb-nl)\n              (str_concat \"(defn c () 3)\" (str_concat (clb-nl)\n              (str_concat \"(defn c2 () 4)\" (str_concat (clb-nl)\n              (str_concat \"(defn c3 () 5)\" (clb-nl)))))))))))))))\n    (let r6 (cl-unit-at text 6))\n    (let in-b (and (str_eq (head r6) \"b/c.bml\") (eq (nth r6 1) 2)))\n    (let r2 (cl-unit-at text 2))\n    (let in-a (and (str_eq (head r2) \"a.fk\") (eq (nth r2 1) 1)))\n    (let marker (nothing? (cl-unit-at text 4)))\n    (let past (nothing? (cl-unit-at text 40)))\n    (let bare (nothing? (cl-unit-at (str_concat \"(defn x () 1)\" (clb-nl)) 1)))\n    (add (clb-bit in-b 1) (add (clb-bit in-a 2) (add (clb-bit marker 4) (add (clb-bit past 8) (clb-bit bare 16))))))\n";
  def ccb-goal() = "closure-lines.fk reads a line of an fkwu closure back to the unit that wrote it; cl-walk answers (nothing) when (ge at (str_len s)), so a line past the end names no unit.";
  def ccb-gap(ctx, deadline) = fccc-gap("closure-unit-line", ccb-goal(), [[ccb-src(ctx), ccb-src(ctx), ccb-original()], [ccb-notes(ctx), ccb-notes(ctx), "read-only notes\n"]], [ccb-src(ctx)], ccb-band(ctx), 31, ccb-root(ctx), deadline);
  def ccb-cand(ctx, id, model, lens, text) = fccc-candidate(id, id ++ "-rung", model, lens, [[ccb-src(ctx), ccb-src(ctx), text]], true, 40);
  // scripted voices: each approves what it reads and reports its local IDs
  def ccb-approve(ids) = packet => ["accept", "the diff meets the goal as read", ids];
  def ccb-voices() = [fccc-voice("v1", "m-review", "lens-a", ccb-approve(7)), fccc-voice("v2", "m-review2", "lens-b", ccb-approve(5)), fccc-voice("v3", "m-writer", "lens-w", ccb-approve(3))];
  // two voices whose cost is unknown: one stops, one answers nothing
  def ccb-unheard() = [fccc-voice("v4", "m-stop", "lens-4", packet => form_error("scripted voice stop")), fccc-voice("v5", "m-blank", "lens-5", packet => nothing())];
  def ccb-input(line) = "(cl-unit-at (str_concat \"; unit: u\" (str_concat (byte_to_str 10) (str_concat \"x\" (byte_to_str 10)))) " ++ line.str() ++ ")";
  def ccb-proposer() = fccc-voice("proposer", "m-small", "lens-p", packet => [[ccb-input(2), ccb-input(3)], "", 6]);
  // the judge reads the goal and the two outputs: a line past the end names no unit
  def ccb-said(packet, key) = (String) faj-type(json-object-get(parse-json("judge", packet), key)) == "null" ? "" : json-string-value(json-object-get(parse-json("judge", packet), key));
  def ccb-judge() = fccc-voice("judge", "m-judge", "lens-j", packet => [(String) ccb-said(packet, "a") == "nothing" ? "a" : (String) ccb-said(packet, "b") == "nothing" ? "b" : "neither", "the goal answers (nothing) past the end", 4]);
  def ccb-opts() = fccc-default-opts(ccb-voices(), 2, ccb-proposer(), ccb-judge(), []);
  def ccb-held?(ctx) = ((String) (read_file(ccb-src(ctx)) ?? "") == ccb-original()) && !fs-exists?(ccb-root(ctx) ++ "/publish-" ++ host_pid().str() ++ ".marker");
  def ccb-standing(r, id) = filter(s => (String) fcap-string(s, "candidate") == id, json-array-elements(json-object-get(fccc-row(r), "standings")))[0];
  def ccb-refusal-for?(r, id, observer) = any?(f => ((String) cc-refusal-subject(f) == id) && (((String) cc-refusal-observer(f) == observer) && cc-refusal-valid?(f)), fccc-refusals(r));
  def ccb-consensus-for(r, id) = filter(c => (String) cc-consensus-subject(c) == id, fccc-consensus(r))[0];
  // the three rounds, each held once and shared by the claims
  def ccb-round-a(ctx) = fccc-circle-rung(ccb-gap(ctx, 20000), [ccb-cand(ctx, "S", "m-stub", "lens-s", ccb-stub()), ccb-cand(ctx, "A", "m-writer", "lens-w", ccb-a())], ccb-opts());
  def ccb-round-b(ctx) = fccc-circle-rung(ccb-gap(ctx, 20000), [ccb-cand(ctx, "B", "m-writer2", "lens-x", ccb-b()), ccb-cand(ctx, "A", "m-writer", "lens-w", ccb-a())], ccb-opts());
  def ccb-round-c(ctx) = fccc-circle-rung(ccb-gap(ctx, 6000), [ccb-cand(ctx, "L", "m-writer", "lens-l", ccb-loop()), fccc-candidate("N", "N-rung", "m-writer", "lens-n", [[ccb-src(ctx), ccb-src(ctx), ccb-original()], [ccb-notes(ctx), ccb-notes(ctx), "moved notes\n"]], true, 40), fccc-candidate("D", "D-rung", "m-writer", "lens-d", [[ccb-src(ctx), ccb-src(ctx), ccb-original()]], true, 40), ccb-cand(ctx, "U", "m-writer", "lens-u", ccb-unbalanced()), ccb-cand(ctx, "S", "m-stub", "lens-s", ccb-stub())], fccc-default-opts(append(ccb-voices(), ccb-unheard()), 2, ccb-proposer(), ccb-judge(), []));
  def ccb-a-r(ctx) = ctx[4][0];
  def ccb-b-r(ctx) = ctx[4][1];
  def ccb-c-r(ctx) = ctx[4][2];

  // 1
  def ccb-ranks(ctx) = (Value) fccc-ranking(ccb-a-r(ctx)) == ["A", "S"];
  // 2
  def ccb-accepts(ctx) = ((String) fccc-accepted-id(ccb-a-r(ctx)) == "A") && (nothing?(fccc-pointing-cell(ccb-a-r(ctx))) && fccc-restored(ccb-a-r(ctx)));
  // 4
  def ccb-veto(ctx) {
   let s = ccb-consensus-for(ccb-a-r(ctx), "S");
   cc-consensus-passed?(s) && ((cc-consensus-approvals(s) == 3) && (ccb-refusal-for?(ccb-a-r(ctx), "S", "execution") && ((Comparable) json-int-value(json-object-get(ccb-standing(ccb-a-r(ctx), "S"), "reading")) == 28)));
  }
  // 8
  def ccb-riftcase(ctx) {
   let rift = json-object-get(fccc-row(ccb-b-r(ctx)), "riftcase");
   let wins = json-int-value(json-object-get(ccb-standing(ccb-b-r(ctx), "A"), "riftcase_wins"));
   ((Comparable) json-int-value(json-object-get(rift, "inputs")) == 2) && (((Comparable) json-int-value(json-object-get(rift, "separating")) == 1) && (((Comparable) json-int-value(json-object-get(rift, "dropped")) == 1) && ((wins == 1) && ((String) fccc-accepted-id(ccb-b-r(ctx)) == "A"))));
  }
  // 16
  def ccb-cells(ctx) {
   let rounds = ctx[4];
   let accepted = filter(r => !((String) fccc-accepted-id(r) == ""), rounds);
   all?(r => cc-consensus-passed?(ccb-consensus-for(r, fccc-accepted-id(r))), accepted) && (all?(r => all?(f => cc-refusal-valid?(f), fccc-refusals(r)), rounds) && (all?(r => cc-receipt-valid?(fccc-receipt(r)), rounds) && all?(r => cc-circle-valid?(fccc-circle(r)), rounds)));
  }
  // 32
  def ccb-one-pointing(ctx) {
   let r = ccb-c-r(ctx);
   let p = fccc-pointing-cell(r);
   ((String) fccc-accepted-id(r) == "") && (!nothing?(p) && (cc-satsang-pointing-valid?(p) && ((cc-pointing-not-command(p) == true) && (((String) cc-receipt-action(fccc-receipt(r)) == cc-action-refused()) && (len(fccc-refusals(r)) == 5)))));
  }
  // 64
  def ccb-audits(ctx) {
   let r = ccb-c-r(ctx);
   fccc-starts?(fcap-string(ccb-standing(r, "N"), "audit"), "touched-non-writable:") && (((String) fcap-string(ccb-standing(r, "D"), "audit") == "done-claim-without-mutation") && (fccc-starts?(fcap-string(ccb-standing(r, "U"), "audit"), "balance-moved:") && (ccb-refusal-for?(r, "N", "audit") && ccb-refusal-for?(r, "U", "audit"))));
  }
  // 128
  def ccb-stop(ctx) {
   let r = ccb-c-r(ctx);
   (String) faj-type(json-object-get(ccb-standing(r, "L"), "reading")) == "null" && (fccc-starts?(fcap-string(ccb-standing(r, "L"), "blocking"), "the band gave no answer within 6000 ms") && (ccb-refusal-for?(r, "L", "execution") && (fccc-restored(r) && ccb-held?(ctx))));
  }
  // 256
  def ccb-dead-pid() {
   let pid = host_spawn_at(["/usr/bin/true"], ["/dev/null", "/dev/null", "/dev/null"]);
   let gone = host_wait(pid);
   pid;
  }
  // a marker as a killed publish leaves it: the checkpoint text and the ownprint of the bytes it wrote
  def ccb-marker(pid, path, before, published) = json-emit(json-node-object([json-node-pair("pid", json-node-int(pid)), json-node-pair("paths", json-node-array([json-node-string(path)])), json-node-pair("texts", json-node-array([json-node-string(before)])), json-node-pair("ownprints", json-node-array([json-node-string(fcam-hash(published))]))])) ++ "\n";
  def ccb-heal(ctx) {
   let pid = ccb-dead-pid();
   let crashed = write_file(ccb-src(ctx), ccb-stub());
   let dead = write_file(ccb-root(ctx) ++ "/publish-" ++ pid.str() ++ ".marker", ccb-marker(pid, ccb-src(ctx), ccb-original(), ccb-stub()));
   let live = write_file(ccb-root(ctx) ++ "/publish-live.marker", ccb-marker(host_pid(), ccb-notes(ctx), "not this\n", "read-only notes\n"));
   let healed = fccc-heal(ccb-root(ctx));
   let held = ((Value) healed == [1, []]) && (((String) (read_file(ccb-src(ctx)) ?? "") == ccb-original()) && (!fs-exists?(ccb-root(ctx) ++ "/publish-" ++ pid.str() ++ ".marker") && (fs-exists?(ccb-root(ctx) ++ "/publish-live.marker") && ((String) (read_file(ccb-notes(ctx)) ?? "") == "read-only notes\n"))));
   let cleared = host_path_remove(ccb-root(ctx) ++ "/publish-live.marker");
   held;
  }
  // 8192: a later writer's bytes are not the killed publish's own, so they stay; the round says so
  def ccb-heal-conflict(ctx) {
   let root = ccb-root(ctx) ++ "/heal";
   let made = fs-mkdir(root);
   let unit = root ++ "/unit.fk";
   let later = write_file(unit, "LATER EDIT\n");
   let pid = ccb-dead-pid();
   let marker = root ++ "/publish-" ++ pid.str() ++ ".marker";
   let marked = write_file(marker, ccb-marker(pid, unit, "ORIGINAL\n", "PUBLISHED\n"));
   let gap = fccc-gap("heal-gap", "unit.fk reads ORIGINAL", [[unit, unit, "ORIGINAL\n"]], [unit], root ++ "/unit-band.fk", 1, root, 6000);
   let r = fccc-circle-rung(gap, [fccc-candidate("D", "D-rung", "m-writer", "lens-d", [[unit, unit, "ORIGINAL\n"]], true, 0)], ccb-opts());
   let rows = filter(line => (len(trim(line)) > 0), split-on(read_file(root ++ "/rounds.jsonl") ?? "", "\n"));
   let row = parse-json("round", rows[len(rows) - 1]);
   let conflicts = json-array-elements(json-object-get(row, "heal_conflicts"));
   let kept = ((String) (read_file(unit) ?? "") == "LATER EDIT\n") && (fs-exists?(marker) && (((Comparable) len(conflicts) == 1) && (fccc-starts?(json-string-value(conflicts[0]), "heal-conflict:" ++ unit) && (((Comparable) json-int-value(json-object-get(row, "healed_markers")) == 0) && ((Comparable) fccc-healed(r)[0] == 0)))));
   let settled = write_file(unit, "ORIGINAL\n");
   let again = fccc-heal(root);
   kept && (((Value) again == [1, []]) && (!fs-exists?(marker) && ((String) (read_file(unit) ?? "") == "ORIGINAL\n")));
  }
  // 16384: a window refused before it opens never runs and never writes
  def ccb-ran(gap, cand, n) = "ran";
  def ccb-unopened(ctx) {
   let lost = fccc-gap("closure-unit-line", ccb-goal(), [[ccb-src(ctx), ccb-src(ctx), ccb-original()]], [ccb-src(ctx)], ccb-band(ctx), 31, ccb-root(ctx) ++ "/absent", 6000);
   let unwritten = fccc-with-published(lost, ccb-cand(ctx, "S", "m-stub", "lens-s", ccb-stub()), ccb-ran, 0);
   let squat = write_file(ccb-root(ctx) ++ "/publish-" ++ host_pid().str() ++ ".marker", "{}\n");
   let held = fccc-with-published(ccb-gap(ctx, 6000), ccb-cand(ctx, "S", "m-stub", "lens-s", ccb-stub()), ccb-ran, 0);
   let cleared = host_path_remove(ccb-root(ctx) ++ "/publish-" ++ host_pid().str() ++ ".marker");
   nothing?(unwritten[0]) && (fccc-starts?(unwritten[2], "marker-unwritten:") && (nothing?(held[0]) && (fccc-starts?(held[2], "marker-held:") && ccb-held?(ctx))));
  }
  // 32768
  def ccb-arity(ctx) {
   let seen = fccc-audit(ccb-gap(ctx, 6000), ccb-cand(ctx, "W", "m-writer", "lens-w", ccb-wrong-arity()));
   fccc-starts?(seen, "arity:" ++ ccb-src(ctx)) && (str_find(seen, "(str_find ...) takes 3, given 1", 0) >= 0);
  }
  // 65536: a .bml band's riftcase input runs in its own surface
  def ccb-twice(body) = "section [form.bml] {\n class U {\n  def u-twice(x) = " ++ body ++ ";\n }\n 0;\n}\n";
  def ccb-bml-probe(ctx) {
   let root = ccb-root(ctx) ++ "/bml";
   let made = fs-mkdir(root);
   let src = root ++ "/unit.bml";
   let band = root ++ "/unit-band.bml";
   let put = write_file(src, ccb-twice("x"));
   let banded = write_file(band, "; Verdict 1\n// preludes: form-stdlib/core.fk " ++ src ++ "\nsection [form.bml] {\n u-twice(2) == 4 ? 1 : 0;\n}\n");
   let gap = fccc-gap("bml-gap", "u-twice doubles its argument", [[src, src, ccb-twice("x")]], [src], band, 1, root, 20000);
   let probed = fccc-probe(gap, fccc-candidate("T", "T-rung", "m-writer", "lens-t", [[src, src, ccb-twice("x * 2")]], true, 0), [["u-twice(21)"], 0]);
   ((Value) probed[0] == ["42"]) && (probed[1] && ((String) (read_file(src) ?? "") == ccb-twice("x")));
  }
  // 131072: no model opens; the lane answers its own count, 0
  def ccb-model-free(ctx) {
   let gap = ccb-gap(ctx, 6000);
   let cand = ccb-cand(ctx, "A", "m-writer", "lens-w", ccb-a());
   let standing = [31, "band read 31 of 31", true, "", cand];
   let v = fccc-qwen-voice("free", "none", "compiler", 4096, 2);
   let said = fccc-call(fccc-voice-act(v), fccc-review-packet(gap, cand, standing, []));
   let vote = fccc-vote(gap, cand, standing, [], v);
   ((String) said[0] == "abstain") && (((Comparable) said[2] == 0) && (((String) vote[1] == "abstain") && ((Comparable) vote[3] == 0)));
  }
  // 262144: round C heard v4 stop and v5 answer nothing on L and on S; v1 7 + v2 5 + v3 3 on each
  def ccb-share-of(r, voice, id) = filter(sh => ((String) cc-share-author(sh) == voice) && ((String) cc-share-payload(sh)[0] == id), fccc-shares(r))[0];
  def ccb-ids-of(r, id, voice) = json-object-get(filter(v => (String) fcap-string(v, "voice") == voice, json-array-elements(json-object-get(ccb-standing(r, id), "votes")))[0], "ids");
  def ccb-unknown(ctx) {
   let r = ccb-c-r(ctx);
   let row = fccc-row(r);
   let stopped = cc-share-payload(ccb-share-of(r, "v4", "S"));
   let blank = cc-share-payload(ccb-share-of(r, "v5", "S"));
   ((Comparable) json-int-value(json-object-get(row, "voices_cost_unknown")) == 4) && (((Comparable) json-int-value(json-object-get(row, "local_review_ids")) == 30) && (((String) stopped[1] == "abstain") && (((String) stopped[2] == "the voice stopped") && (((String) blank[2] == "the voice answered nothing") && (((String) faj-type(ccb-ids-of(r, "S", "v4")) == "null") && (((Comparable) json-int-value(ccb-ids-of(r, "S", "v1")) == 7) && (str_find(cc-receipt-reason(fccc-receipt(r)), "lower bound", 0) >= 0)))))));
  }
  // 524288: the executor reports A's restore did not hold; B is never published
  def ccb-half-restore(gap, cand, n) = [31, "band read 31 of 31", false];
  def ccb-unrestored(ctx) {
   let r = fccc-round(ccb-gap(ctx, 6000), [ccb-cand(ctx, "A", "m-writer", "lens-w", ccb-a()), ccb-cand(ctx, "B", "m-writer2", "lens-x", ccb-b())], fccc-opts(ccb-voices(), 2, [], [], [], ccb-half-restore, fccc-probe));
   let b = ccb-standing(r, "B");
   ((String) fccc-accepted-id(r) == "") && (!fccc-restored(r) && (((Comparable) json-int-value(json-object-get(fccc-row(r), "candidates")) == 2) && (((String) fcap-string(b, "blocking") == fccc-unexecuted()) && (((String) faj-type(json-object-get(b, "reading")) == "null") && (ccb-refusal-for?(r, "A", "execution") && (ccb-refusal-for?(r, "B", "execution") && fccc-starts?(cc-receipt-reason(fccc-receipt(r)), "a restore did not hold"))))))) && ccb-held?(ctx);
  }
  // 512
  def ccb-silence(ctx) {
   let votes = json-array-elements(json-object-get(ccb-standing(ccb-a-r(ctx), "A"), "votes"));
   let v3 = filter(v => (String) fcap-string(v, "voice") == "v3", votes)[0];
   ((String) fcap-string(v3, "vote") == "silence") && ((Value) cc-consensus-voters(ccb-consensus-for(ccb-a-r(ctx), "A")) == ["v1", "v2"]);
  }
  // 1024: A heard v1 7 + v2 5 (v3 silent), S heard 7 + 5 + 3; no tie, no pointing
  def ccb-cost(ctx) = ((Comparable) cc-receipt-cost(fccc-receipt(ccb-a-r(ctx))) == 27) && ((String) cc-receipt-subject(fccc-receipt(ccb-a-r(ctx))) == "A");
  // 2048
  def ccb-row(ctx) {
   let rows = filter(line => (len(trim(line)) > 0), split-on(read_file(ccb-root(ctx) ++ "/rounds.jsonl") ?? "", "\n"));
   let first = parse-json("round", rows[0]);
   let fixture = read_file(ccb-root(ctx) ++ "/fixture-a.fk") ?? "";
   (len(rows) == 3) && (((String) fcap-string(first, "accepted") == "A") && (((Comparable) json-int-value(json-object-get(first, "local_review_ids")) == 27) && (((Comparable) json-int-value(json-object-get(first, "voices_cost_unknown")) == 0) && ((len(fixture) == 1212) && ((String) hex-encode(sha256-stream-string(fixture)) == "cf2479000ada102616cd6bc3869f69a72a69d9bc4959c3f6dd623be5b7902aea")))));
  }
  def ccb-fresh() {
   let root = temp_dir() ++ "/form-code-circle-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str();
   let made = fs-mkdir(root);
   let src = root ++ "/closure-lines.fk";
   let band = root ++ "/closure-lines-band.fk";
   let notes = root ++ "/notes.txt";
   let wrote = write_file(src, ccb-original());
   let banded = write_file(band, ccb-band-text(src));
   let noted = write_file(notes, "read-only notes\n");
   let fixture = write_file(root ++ "/fixture-a.fk", ccb-a());
   fs-exists?(band) ? [root, src, band, notes] : nothing();
  }
  // 4096: a stop inside the publish window — the deferred restore holds and the window answers nothing
  def ccb-stops(gap, cand, n) {
   let seen = read_file(fccc-gap-band(gap));
   form_error("scripted stop inside the publish window");
   seen;
  }
  def ccb-window-stop(ctx) {
   let held = fccc-with-published(ccb-gap(ctx, 6000), ccb-cand(ctx, "S", "m-stub", "lens-s", ccb-stub()), ccb-stops, 0);
   nothing?(held[0]) && (held[1] && (((String) held[2] == "") && ccb-held?(ctx)));
  }
  def ccb-held(ctx) = append(ctx, [[ccb-round-a(ctx), ccb-round-b(ctx), ccb-round-c(ctx)]]);
 }
 let fresh = ccb-fresh();
 nothing?(fresh) ? form_error("code circle band needs a fresh directory") : 0;
 let ctx = ccb-held(fresh);
 let verdict = live-claims("form-cli-code-circle-band", ctx, [["rank-full-first", 1, 1, ccb-ranks], ["accept-full", 2, 1, ccb-accepts], ["execution-veto", 4, 1, ccb-veto], ["riftcase", 8, 1, ccb-riftcase], ["cells-hold", 16, 1, ccb-cells], ["one-pointing", 32, 1, ccb-one-pointing], ["audits", 64, 1, ccb-audits], ["stop-restores", 128, 1, ccb-stop], ["marker-heal", 256, 1, ccb-heal], ["writer-silence", 512, 1, ccb-silence], ["receipt-cost", 1024, 1, ccb-cost], ["row-carrier", 2048, 1, ccb-row], ["window-stop", 4096, 1, ccb-window-stop], ["heal-conflict", 8192, 1, ccb-heal-conflict], ["window-unopened", 16384, 1, ccb-unopened], ["arity-refusal", 32768, 1, ccb-arity], ["bml-prober", 65536, 1, ccb-bml-probe], ["model-free-voice", 131072, 1, ccb-model-free], ["unknown-cost", 262144, 1, ccb-unknown], ["restore-not-held", 524288, 1, ccb-unrestored]]);
 host_dir_rmdir(ccb-root(ctx));
 verdict;
}
