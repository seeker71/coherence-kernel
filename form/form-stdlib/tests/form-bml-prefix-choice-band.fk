; form-bml-prefix-choice-band.fk -- one pending offer is accepted, held,
; readied, undone, timed out or absent before model-state commitment.
;
; Expected: 4194303 (22 bits)
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk
; preludes: form-stdlib/grammars/form-bml.fk form-stdlib/bmf-prefix-state.fk
; preludes: control/offer-ack-core.fk control/choice-lane-core.fk
; preludes: form-stdlib/form-bml-prefix-choice.fk

(do
    (defn fcbpcb-bit (ok bit) (if ok bit 0))
    (defn fcbpcb-decide (prefix token present bytes)
        (fcbpc-decide-materialized prefix token present bytes 512 4096))
    (defn fcbpcb-events? (d expected)
        (node_eq (fcbpc-events d) expected))
    (defn fcbpcb-run ()
        (do
            (let open (fcbpcb-decide "" 71 1 "def "))
            (let continued (fcbpcb-decide "def " 72 1 "temporal-main("))
            (let ready (fcbpcb-decide
                "def temporal-main() = add(20,22);\n0" 73 1 ";"))
            (let malformed (fcbpcb-decide "def temporal-main() = " 74 1 ";"))
            (let canonical-index (fcbpcb-decide "def temporal-main() = " 75 1
                "value[0];"))
            (let string-import (fcbpcb-decide "def temporal-main() = " 76 1
                "\"import None return\";"))
            (let over (fcbpc-decide-materialized "def temporal-main() = " 77 1
                "add(20,22);" 8 4096))
            (let spent (fcbpc-decide-materialized "" 78 1
                "def x() = 1;\n0;" 512 0))
            (let zero (fcbpcb-decide "" 0 1 "d"))
            (let one (fcbpcb-decide "" 1 1 "d"))
            (let absent (fcbpcb-decide "seed" 0 0 "d"))
            (let empty-bytes (fcbpcb-decide "seed" 1 1 ""))
            (let needs-zero (fcbpcb-decide "" 79 1 "def x() = 1;"))
            (let body-zero (fcbpcb-decide "" 80 1 "def x() = 0;"))
            (let generic (fcbpcb-decide "" 81 1
                "def x() = call<Type>(1);"))
            (let live-fresh (blc-fresh 16 256))
            (let live-open (fcbpc-decide-live live-fresh 82 1 "def " 64))
            (let live-ready (fcbpc-decide-live live-fresh 83 1
                "def x() = 1;\n0;" 4096))
            (let live-bad (fcbpc-decide-live live-fresh 84 1 ")" 64))
            (let live-timeout (fcbpc-decide-live live-fresh 85 1 "abc" 2))
            (let live-capacity (fcbpc-decide-live
                (blc-fresh 8 3) 86 1 "abcd" 16))
            (sum (list
                (fcbpcb-bit (and (str_eq (fcbpc-action open) "accept")
                    (str_eq (gsp-state-status (fcbpc-parser-state open))
                        "continue")) 1)
                (fcbpcb-bit (and (str_eq (fcbpc-action continued) "accept")
                    (str_eq (fcbpc-next-prefix continued)
                        "def temporal-main(")) 2)
                (fcbpcb-bit (and (str_eq (fcbpc-action ready) "ready")
                    (and (eq (fcbpc-cut-pruned ready) 0)
                         (fcbpcb-events? ready
                            (list "offer" "ready-to-judge")))) 4)
                (fcbpcb-bit (and (str_eq (fcbpc-action malformed) "undo")
                    (str_eq (fcbpc-next-prefix malformed)
                        (fcbpc-checkpoint malformed))) 8)
                (fcbpcb-bit (and (str_eq (fcbpc-action canonical-index) "accept")
                    (and (str_eq (fcbpc-action string-import) "accept")
                         (str_eq (fcbpc-action generic) "accept"))) 16)
                (fcbpcb-bit (and (str_eq (fcbpc-action over) "undo")
                    (str_eq (gsp-state-status (fcbpc-parser-state over))
                        "materialization-full")) 32)
                (fcbpcb-bit (and (str_eq (fcbpc-action spent) "timeout")
                    (and (eq (fcbpc-timed-out? spent) 1)
                         (eq (fcbpc-ack-kind spent) (oac-tag-nothing)))) 64)
                (fcbpcb-bit (and (eq (fcbpc-token-present? zero) 1)
                    (and (eq (fcbpc-token zero) 0)
                         (str_eq (fcbpc-action zero) "accept"))) 128)
                (fcbpcb-bit (and (eq (fcbpc-token-present? one) 1)
                    (and (eq (fcbpc-token one) 1)
                         (str_eq (fcbpc-action one) "accept"))) 256)
                (fcbpcb-bit (and (eq (fcbpc-token-present? absent) 0)
                    (and (str_eq (fcbpc-action absent) "nothing")
                         (str_eq (fcbpc-next-prefix absent) "seed"))) 512)
                (fcbpcb-bit (and (eq (fcbpc-token-present? empty-bytes) 1)
                    (and (str_eq (fcbpc-action empty-bytes) "nothing")
                         (str_eq (fcbpc-next-prefix empty-bytes) "seed"))) 1024)
                (fcbpcb-bit (and (str_eq (fcbpc-action needs-zero) "accept")
                    (str_eq (gsp-state-reason (fcbpc-parser-state needs-zero))
                        "canonical-final-zero-pending")) 2048)
                (fcbpcb-bit (and (eq (fcbpc-ack-kind open) (oac-tag-one))
                    (eq (fcbpc-ack-kind malformed) (oac-tag-nothing))) 4096)
                (fcbpcb-bit (fcbpcb-events? malformed
                    (list "offer" "failure" "undo" "refine")) 8192)
                (fcbpcb-bit (and (eq (fcbpc-final-zero?
                        "def x() = 1;\n0;\n") 1)
                    (eq (fcbpc-final-zero? "def x() = 1;") 0)) 16384)
                (fcbpcb-bit (and (str_eq (fcbpc-action body-zero) "accept")
                    (str_eq (gsp-state-reason (fcbpc-parser-state body-zero))
                        "canonical-final-zero-pending")) 32768)
                (fcbpcb-bit (and (eq (fcbpc-final-zero?
                        "def x() = 1;\nfalse;") 0)
                    (eq (fcbpc-final-zero?
                        "def x() = 1;\n\"0\";") 0)) 65536)
                (fcbpcb-bit (and (str_eq (fcbpc-action live-open) "accept")
                    (eq (blc-pos (fcbpc-next-cursor live-open)) 4)) 131072)
                (fcbpcb-bit (and (str_eq (fcbpc-action live-ready) "ready")
                    (str_eq (blc-status
                        (fcbpc-next-cursor live-ready)) "candidate")) 262144)
                (fcbpcb-bit (and (str_eq (fcbpc-action live-bad) "undo")
                    (node_eq (fcbpc-next-cursor live-bad) live-fresh)) 524288)
                (fcbpcb-bit (and (str_eq
                        (fcbpc-action live-timeout) "timeout")
                    (node_eq (fcbpc-next-cursor live-timeout)
                        live-fresh)) 1048576)
                (fcbpcb-bit (and (str_eq
                        (fcbpc-action live-capacity) "capacity")
                    (node_eq (fcbpc-next-cursor live-capacity)
                        (blc-fresh 8 3))) 2097152)))))
    (fcbpcb-run))
