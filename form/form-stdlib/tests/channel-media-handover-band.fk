; channel-media-handover-band.fk — high-grammar BML OSI media handover.
;
; preludes: form-stdlib/core.fk form-stdlib/channel-interface.fk form-stdlib/kernel-http.fk form-stdlib/channel-flow.fk form-stdlib/channel-media-bml.fk
;
; Band verdict: 8388607 when BML can author one dynamic OSI profile shape for
; Bluetooth, HTTP, TCP, UDP, NFC, and a previously unnamed optical carrier;
; handover changes the carrier while preserving session/cursor/ack state and
; keeps value/choice/failure/timeout/nothing distinct.

section [form.bml] {
    def cmhb-score(ok, bit) = if ok then bit else 0;

    def cmhb-bad-first-flow(name, phase) {
        let good = cmb-media-flow("bad-first", "bad-radio", "bad", "bad-async");
        let layers = cf-flow-layers(good);
        let first = cf-osi-layer(1, name, phase, "bad-radio", "live-media", "carrier-open-observe");
        cf-channel-flow("bad-first", "form-mesh-v1", list(first, nth(layers, 1), nth(layers, 2), nth(layers, 3), nth(layers, 4), nth(layers, 5), nth(layers, 6)), "sovereign-mesh");
    }

    def cmhb-band-score() {
        let bluetooth = cmb-media-flow("bluetooth", "ble-radio", "ble-gatt", "ble-async");
        let http = cmb-media-flow("http", "wifi-radio", "tcp/http1.1", "http-async");
        let tcp = cmb-media-flow("tcp", "wifi-radio", "tcp", "tcp-async");
        let udp = cmb-media-flow("udp", "wifi-radio", "udp", "udp-datagram");
        let nfc = cmb-media-flow("nfc", "nfc-field", "nfc", "nfc-tap");
        let optical = cmb-media-flow("optical", "framebuffer-light", "light-pulse", "cursor-pulse");
        let session = make_nodeid(1, 2, 99, 1701);
        let h1 = cmb-media-handover(bluetooth, http, session, 0, nothing(), "value", "wifi-arrived");
        let h2 = cmb-next-handover(h1, tcp, 41, 41, "value", "http-body-complete");
        let h3 = cmb-next-handover(h2, udp, 73, 73, "value", "datagram-fits-flow");
        let h4 = cmb-next-handover(h3, nfc, 91, 91, "value", "near-field-arrived");
        let paused = cmb-media-handover(tcp, udp, session, 73, 73, "timeout", "udp-not-yet-visible");
        let choosing = cmb-media-handover(http, tcp, session, 41, 41, "choice", "both-carriers-live");
        let failed = cmb-media-handover(udp, nfc, session, 91, 91, "failure", "tap-left-field");
        let malformed = cmb-media-handover(udp, nfc, session, 91, 91, "malformed", "unknown-signal");
        sum(list(
            cmhb-score(and(cf-channel-flow-valid?(bluetooth), and(cf-channel-flow-valid?(http), and(cf-channel-flow-valid?(tcp), and(cf-channel-flow-valid?(udp), cf-channel-flow-valid?(nfc))))), 1),
            cmhb-score(and(str_eq(cf-flow-carrier(bluetooth), "bluetooth"), str_eq(cf-flow-carrier(nfc), "nfc")), 2),
            cmhb-score(str_eq(cf-osi-layer-carrier(cf-flow-physical-layer(bluetooth)), "ble-radio"), 4),
            cmhb-score(str_eq(cf-osi-layer-carrier(cf-flow-transport-layer(http)), "tcp/http1.1"), 8),
            cmhb-score(str_eq(cf-osi-layer-recipe(cf-flow-transport-layer(nfc)), "nfc-tap"), 16),
            cmhb-score(cf-flow-application-compatible?(bluetooth, http), 32),
            cmhb-score(and(cf-flow-application-compatible?(http, tcp), and(cf-flow-application-compatible?(tcp, udp), cf-flow-application-compatible?(udp, nfc))), 64),
            cmhb-score(cf-media-handover-valid?(h1), 128),
            cmhb-score(cf-media-handover-valid?(h2), 256),
            cmhb-score(cf-media-handover-valid?(h3), 512),
            cmhb-score(cf-media-handover-valid?(h4), 1024),
            cmhb-score(str_eq(cf-flow-carrier(cf-media-handover-active-flow(h1)), "http"), 2048),
            cmhb-score(and(cf-media-handover-valid?(paused), and(not(cf-media-handover-selected?(paused)), str_eq(cf-flow-carrier(cf-media-handover-active-flow(paused)), "tcp"))), 4096),
            cmhb-score(and(node_eq(cf-handover-session-node(h1), cf-handover-session-node(h2)), and(node_eq(cf-handover-session-node(h2), cf-handover-session-node(h3)), node_eq(cf-handover-session-node(h3), cf-handover-session-node(h4)))), 8192),
            cmhb-score(and(eq(cf-handover-cursor(h2), 41), eq(cf-handover-cursor(h4), 91)), 16384),
            cmhb-score(and(nothing?(cf-handover-ack(h1)), eq(cf-handover-cursor(h1), 0)), 32768),
            cmhb-score(and(eq(cf-handover-ack(h2), 41), eq(cf-handover-ack(h4), 91)), 65536),
            cmhb-score(and(cf-media-handover-valid?(choosing), str_eq(cf-flow-carrier(cf-media-handover-active-flow(choosing)), "http")), 131072),
            cmhb-score(and(cf-media-handover-valid?(failed), str_eq(cf-flow-carrier(cf-media-handover-active-flow(failed)), "udp")), 262144),
            cmhb-score(not(cf-media-handover-valid?(malformed)), 524288),
            cmhb-score(not(cf-channel-flow-valid?(cmhb-bad-first-flow("physical", "solid"))), 1048576),
            cmhb-score(not(cf-channel-flow-valid?(cmhb-bad-first-flow("transport", cf-phase-gas()))), 2097152),
            cmhb-score(and(cf-channel-flow-valid?(optical), cf-flow-application-compatible?(nfc, optical)), 4194304)
        ));
    }

    cmhb-band-score();
}
