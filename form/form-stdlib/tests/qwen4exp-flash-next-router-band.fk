; qwen4exp-flash-next-router-band.fk — the 512/top-10 Form recipe and
; the widened Metal radius agree with the BML authority.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/q6k-dequant.fk form-stdlib/q6k-msl.fk form-stdlib/transformer-numerics.fk form-stdlib/moe-msl.fk form-stdlib/qwen4exp-flash-next-router-xtal.fk form-stdlib/moe-route-wide-msl.fk
;
; run: ./fkwu form/form-stdlib/tests/qwen4exp-flash-next-router-band.fk ; -> 255
;
; Verdict 255:
;   1..32  BML-crystallized recipe: exact 512/top-10 shape, ids equal the
;          independent [511..502] truth, distinct selection, normalized and
;          descending weights, and a live radius refusal at 513.
;   64     emitted Metal caps exactly match the BML contract.
;   128    the high-grammar authority names qwen4exp, 512, 10 and routing law.

(do
    (defn q4rb-has (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let base (q4r-check))
    (let metal (if (eq (mrw-ne-cap) (Q4ExpertCount))
                   (if (eq (mrw-nsel-cap) (Q4SelectedCount)) 64 0) 0))
    (let src (read_file "form/form-stdlib/bml/qwen4exp-flash-next-router.bml"))
    (let authority
        (if (eq (q4rb-has src "package Form.native.qwen4exp") 1)
            (if (eq (q4rb-has src "const int ExpertCount = 512") 1)
                (if (eq (q4rb-has src "const int SelectedCount = 10") 1)
                    (if (eq (q4rb-has src "softmax top-k selected-renormalization best-first") 1)
                        128 0) 0) 0) 0))
    (add base (add metal authority)))
