; Form tensor recipes on native Metal. Behavior and refusals travel together.
; preludes: form-stdlib/native-tensor.bml
; Verdict 127.
; preludes: form-stdlib/core.fk form-stdlib/metal-door.fk form-stdlib/form-fs.fk

(do
    (defn mtb-score (ok bit) (if ok bit 0))
    (defn mtb-has (hay needle) (if (lt (str_find hay needle 0) 0) 0 1))
    (defn mtb-live? () (mtb-has (nt-status) "metal_linked=true"))
    (defn mtb-path () "/tmp/fk-native-tensor-files-band-fixture.bin")
    (defn mtb-f32 (x) (md-le32 (md-f32-bits x)))
    (defn mtb-bytes ()
        (str_concat (mtb-f32 99.0) (str_concat (mtb-f32 98.0)
        (str_concat (mtb-f32 1.0) (str_concat (mtb-f32 2.0)
        (str_concat (mtb-f32 3.0) (str_concat (mtb-f32 4.0)
        (str_concat (mtb-f32 5.0) (mtb-f32 6.0)))))))))
    (defn mtb-prog (off r c tail)
        (str_concat "tf32 " (str_concat (mtb-path)
        (str_concat " " (str_concat (int_to_str off)
        (str_concat " " (str_concat (int_to_str r)
        (str_concat " " (str_concat (int_to_str c)
        (str_concat " " (str_concat tail " i32")))))))))))
    (defn native-tensor-files-band ()
        (do
    (let wrote (fs-write-text (mtb-path) (mtb-bytes)))
    (let ctl (eq (nt-eval "3 4 add") 7))
    (let c0 (mtb-score (and (eq wrote 32) (and (eq (mtb-live?) 1) ctl)) 1))
    (let c1 (mtb-score (if ctl (eq (nt-eval (mtb-prog 8 2 3 "sum")) 21) 0) 2))
    (let c2 (mtb-score (if ctl (eq (nt-eval (mtb-prog 0 2 3 "sum")) 207) 0) 4))
    (let c3 (mtb-score (if ctl (eq (nt-eval (mtb-prog 8 2 3 "v3 1 10 100 r2 3 1 f32 matmul sum")) 975) 0) 8))
    (defn mtb-refused-as? (prog words)
        (nt-refused prog words))
    (let c4 (mtb-score (if ctl (eq (mtb-refused-as? (mtb-prog 8 100 100 "sum")
                                     "tf32 file is shorter than the shape asked for") 1) 0) 16))
    (let c5 (mtb-score (if ctl (eq (mtb-refused-as? "tf32 /tmp/fk-native-tensor-no-such-fixture.bin 0 2 3 sum i32"
                                     "tf32 cannot open path") 1) 0) 32))
    (let c6 (mtb-score (if ctl (eq (mtb-refused-as? (mtb-prog 0 2147483647 2 "sum")
                                     "tf32 shape out of range") 1) 0) 64))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6)))))))
    )
    (native-tensor-files-band))
