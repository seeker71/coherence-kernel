; native-resource-attestation-band.fk -- pure classifier proof for the one
; content-blind resource observer.  This band deliberately does not call a carrier.
;
; Verdict 63:
;   1  unlinked carrier is distinct from an unavailable device
;   2  a linked carrier with no default device is device-unavailable
;   4  linked handle-door evidence is device-open
;   8  an explicit carrier error stays an error
;  16  incomplete or unrecognised text stays unexpected
;  32  rendered output holds only fixed states, never the supplied raw text
;
; preludes: form-stdlib/core.fk form-stdlib/native-resource-attestation.fk

(do
    (let unlinked "metal_linked=false\nmetal_door=handle\n")
    (let unavailable "metal_linked=false\nmetal_door=handle\nlast_error=no Metal device\n")
    (let opened "metal_linked=true\nmetal_door=handle\ndevice=private-name\n")
    (let errored "metal_linked=false\nmetal_door=handle\nlast_error=carrier refused\n")
    (let incomplete "metal_linked=true\n")
    (let rendered (nra-render (nra-accelerator-state opened)))
    (let c0 (if (str_eq (nra-accelerator-state unlinked) "carrier-unlinked") 1 0))
    (let c1 (if (str_eq (nra-accelerator-state unavailable) "device-unavailable") 2 0))
    (let c2 (if (str_eq (nra-accelerator-state opened) "device-open") 4 0))
    (let c3 (if (str_eq (nra-accelerator-state errored) "observation-error") 8 0))
    (let c4 (if (and (str_eq (nra-accelerator-state "") "observation-unexpected")
                     (and (str_eq (nra-accelerator-state incomplete) "observation-unexpected")
                          (str_eq (nra-accelerator-state "metal_linked=false")
                                  "observation-unexpected"))) 16 0))
    (let c5 (if (and (str_eq rendered "source_form_executor=observed\naccelerator_state=device-open")
                     (eq (nra-has? rendered "private-name") 0)) 32 0))
    (sum (list c0 c1 c2 c3 c4 c5)))
