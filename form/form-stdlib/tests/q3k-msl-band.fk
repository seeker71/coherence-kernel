; q3k-msl-band.fk — the emitted Q3_K kernel is a transcription of q3k-dequant.fk
; and diverges from it nowhere a reader could be fooled.
;
; preludes: form-stdlib/core.fk form-stdlib/q3k-msl.fk
;
; run: ./fkwu form/form-stdlib/tests/q3k-msl-band.fk   ; -> 255
;
; Verdict 255. A read-back gate, no GPU. The compile gate is
; form/native/metal/metal_q3k.sh; this band can only read text and claims only
; that.

(do
    (defn q3mb-has (h n) (if (lt (str_find h n 0) 0) 0 1))
    (defn q3mb-count-from (h n from c)
        (do (let i (str_find h n from)) (if (lt i 0) c (q3mb-count-from h n (add i 1) (add c 1)))))
    (defn q3mb-count (h n) (q3mb-count-from h n 0 0))
    (defn q3mb-score (ok bit) (if ok bit 0))

    (defn q3k-msl-band ()
        (do
    (let U (q3m-msl-appendix))
    ; the callable a matvec will use, and the kernel a gate can dispatch
    (let c0 (q3mb-score (if (eq (q3mb-count U "float q3k_at(device const uchar* blk, uint i)") 1)
                            (eq (q3mb-count U "kernel void form_q3k_dequant_f32") 1) 0) 1))
    ; the block stride is the struct's 110 bytes and the field offsets are the
    ; struct's: qs at 32, scales at 96, d at 108/109
    (let c1 (q3mb-score (if (eq (q3mb-has U "b * 110u") 1)
                            (if (eq (q3mb-has U "blk[32u + qi]") 1)
                                (if (eq (q3mb-has U "blk + 96u") 1)
                                    (q3mb-has U "uint(blk[108]) + 256u * uint(blk[109])") 0) 0) 0) 2))
    ; the four scale-unpack cases, in the per-byte form the recipe derived
    (let c2 (q3mb-score (if (eq (q3mb-has U "16u * (h2 % 4u)") 1)
                            (if (eq (q3mb-has U "16u * ((h2 / 4u) % 4u)") 1)
                                (if (eq (q3mb-has U "16u * ((h2 / 16u) % 4u)") 1)
                                    (q3mb-has U "16u * ((h2 / 64u) % 4u)") 0) 0) 0) 4))
    ; the reference's `- 32` on the scale
    (let c3 (q3mb-score (q3mb-has U "q3k_scale6(blk + 96u, is) - 32") 8))
    ; FALSIFIER — the -4 is applied when the hmask bit is CLEAR. Inverting the
    ; test still yields weights that look like weights.
    (let c4 (q3mb-score (if (eq (q3mb-has U "(hs == 1u ? 0 : 4)") 1)
                            (eq (q3mb-has U "(hs == 1u ? 4 : 0)") 0) 0) 16))
    ; FALSIFIER — m does not reset per half: the exponent carries 4*n2
    (let c5 (q3mb-score (if (eq (q3mb-has U "q3k_pow2(j + 4u * n2)") 1)
                            (eq (q3mb-has U "q3k_pow2(j)") 0) 0) 32))
    ; FALSIFIER — no bit operators, so this stays a transcription of the recipe
    ; rather than a lookalike that can drift from it
    (let c6 (q3mb-score (if (eq (q3mb-has U ">>") 0)
                            (if (eq (q3mb-has U " & ") 0)
                                (eq (q3mb-has U "metal::") 0) 0) 0) 64))
    ; APPENDIX contract: no spine of its own
    (let c7 (q3mb-score (if (eq (q3mb-has U "#include") 0)
                            (if (eq (q3mb-has U "using namespace") 0)
                                (eq (q3mb-has U "float fh16(") 0) 0) 0) 128))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
    )
    (q3k-msl-band))
