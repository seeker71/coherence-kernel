; living-world-recursive-transfer-band.fk -- an unseen nested composition asks.
; Verdict 1023 proves ten recursive induction/application properties.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-recursive-application.fk form-stdlib/tests/living-world-recursive-witness.fk

(do
    (let base (lwrrw-base-round 2))
    (let mapping-proposal (lwrrw-first-proposal base))
    (let mapping-candidate (lwrrw-candidate mapping-proposal))
    (let mapping (lwo-emergent-shape mapping-candidate))
    (let signature (lwrr-mapping-signature mapping))
    (let uncertainty (lwrr-mapping-uncertainty mapping))
    (let mapping-round
        (lwrrw-integrated-mapping-round base mapping-proposal))
    (let mapping-world (lwt-round-world mapping-round))
    (let input-world (lwrrw-input-world mapping-world))
    (let application-round
        (lwrr-application-round input-world mapping-candidate
                                (lwrrw-unseen-input) mapping-round))
    (let application-proposal (lwrrw-first-proposal application-round))
    (let application-candidate (lwrrw-candidate application-proposal))
    (let application (lwo-emergent-shape application-candidate))
    (let yes-round
        (lwrrw-application-yes-round
            application-round application-proposal))
    (let integrated
        (lwrr-integrate-application
            yes-round application-proposal (lwrrw-action)))
    (let integrated-world (lwt-round-world integrated))

    (let c1 (if (eq (lwrr-signature-valid? signature) 1) 1 0))
    (let c2 (if (and (eq (lwrr-ref-count
                              (lwrr-signature-template signature)) 3)
                         (eq (lwrr-constant-count
                              (lwrr-signature-template signature)) 1)) 2 0))
    (let c3 (if (and (eq (lwo-field-size
                              (lwrr-mapping-supports mapping)) 2)
                         (eq (lwo-field-size
                              (lwrr-mapping-counterexamples mapping)) 1)) 4 0))
    (let c4 (if (and (eq (lwrr-uncertainty-counterexamples uncertainty) 1)
                         (and (eq (lwrr-uncertainty-ambiguous uncertainty) 0)
                              (eq (lwrr-uncertainty-references uncertainty) 3))) 8 0))
    (let c5 (if (and (eq (lwo-active? mapping-world mapping-candidate) 1)
                         (eq (lwrl-steady? mapping-world mapping-candidate) 1)) 16 0))
    (let c6 (if (node_eq (lwrr-application-output application)
                          (lwrrw-expected-output)) 32 0))
    (let c7 (if (and (node_eq
                          (lwrl-state-status
                              (lwrr-application-lifecycle application))
                          (lwrl-steady))
                         (node_eq (lwrr-application-path application)
                                  (lwo-local-path))) 64 0))
    (let c8 (if (and (eq (lwo-field-size
                              (lwt-proposal-participants
                                  application-proposal)) 4)
                         (eq (lwo-emergent-ready?
                              input-world application-candidate) 1)) 128 0))
    (let c9 (if (eq (lwo-world-has?
                         input-world application-candidate) 0) 256 0))
    (let c10 (if (and (eq (lwo-active?
                               integrated-world application-candidate) 1)
                          (eq (lwo-field-size
                               (lwo-active-attributions-for
                                   integrated-world application-candidate)) 4)) 512 0))
    (lwrrw-sum (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10)))
