; living-world-expression-composition-application-admission-diagnostic.fk
; Privacy-bounded causal observation of the failed application membrane.
; No offered surface payload is emitted.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk form-stdlib/living-world-expression-composition.fk form-stdlib/tests/living-world-expression-blueprint-witness.fk form-stdlib/tests/living-world-expression-composition-witness.fk

(do
    (let base-world (lwxcbw-chain-world))
    (let yes-round (lwxcbw-application-yes-round-build))
    (let yes-world (lwt-round-world yes-round))
    (let proposal-c (lwxcbw-application-proposal-c))
    (let proposal-d (lwxcbw-application-proposal-d))
    (let candidate-c (lwxcbw-application-candidate-c))
    (let candidate-d (lwxcbw-application-candidate-d))
    (let outcome-c (lwt-evaluate-proposal yes-world proposal-c))
    (let outcome-d (lwt-evaluate-proposal yes-world proposal-d))
    (let first-round
        (lwxc-integrate-application yes-round proposal-c (lwxbw-action)))
    (let first-world (lwt-round-world first-round))
    (let second-round
        (lwxc-integrate-application first-round proposal-d (lwxbw-action)))
    (let second-world (lwt-round-world second-round))
    (list
        (lwxc-chain-integrated-current? base-world
            (lwxcbw-chain-candidate-c))
        (lwxc-chain-integrated-current? base-world
            (lwxcbw-chain-candidate-d))
        (lwxb-material-current? base-world (lwxbw-heldout-material))
        (lwxc-application-candidate-current? base-world candidate-c)
        (lwxc-application-candidate-current? base-world candidate-d)
        (lwo-emergent-ready? base-world candidate-c)
        (lwo-emergent-ready? base-world candidate-d)
        (lwo-field-size (lwt-proposal-participants proposal-c))
        (lwo-field-size (lwt-proposal-participants proposal-d))
        (lwt-outcome-yes outcome-c)
        (lwt-outcome-no outcome-c)
        (lwt-outcome-silence outcome-c)
        (lwt-outcome-missing outcome-c)
        (if (node_eq (lwt-outcome-status outcome-c)
                (lwt-status-acknowledged)) 1 0)
        (lwt-outcome-yes outcome-d)
        (lwt-outcome-no outcome-d)
        (lwt-outcome-silence outcome-d)
        (lwt-outcome-missing outcome-d)
        (if (node_eq (lwt-outcome-status outcome-d)
                (lwt-status-acknowledged)) 1 0)
        (lwo-active? first-world candidate-c)
        (lwxc-application-candidate-current? first-world candidate-c)
        (lwxc-application-candidate-current? first-world candidate-d)
        (lwo-emergent-ready? first-world candidate-d)
        (lwo-active? second-world candidate-c)
        (lwo-active? second-world candidate-d)
        (lwxc-application-candidate-current? second-world candidate-c)
        (lwxc-application-candidate-current? second-world candidate-d)))
