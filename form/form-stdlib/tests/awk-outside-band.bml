; awk-outside-band.bml — the body's awk reads a named file the index does not hold (form-path.bml, fpa-awk-file).
;
; form-find's awk reads its records from the index, so a file outside the repository (a transcript, a log) was refused as
; "not an indexed text file". A file the index does not hold is read from disk when it reads as text; a path that does
; not read as a file is still refused by name.
;
; Expected: 7
; Verdict 7 when every claim lands:
;   1   a text file outside the index is read: its lines are the records, each carrying the file's name
;   2   a path that does not exist is refused, and the refusal names it
;   4   a directory is refused, and the refusal names it
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/form-path.bml
section [form.bml] {
 class AwkOutsideBand {
  def aob-index() {
   let s = record_new(0);
   let z = record_set(s, "files", record_new(0));
   s;
  }
  def aob-file() = temp_dir() ++ "/awk-outside-band-" ++ host_pid().str() ++ ".txt";
  def aob-c-read(ctx) {
   let w = write_file(aob-file(), "alpha\nbeta\ngamma\n");
   let r = fpa-awk-files(aob-index(), [aob-file()], []);
   let gone = host_path_remove(aob-file());
   (String) r[1] == "" && !nil?(r[0]) && (String) r[0][0][0] == "alpha" && (String) r[0][2][0] == "gamma" && (String) r[0][1][2] == aob-file();
  }
  def aob-c-missing(ctx) {
   let r = fpa-awk-files(aob-index(), ["/no/such/awk-outside-file"], []);
   nil?(r[0]) && str_find(r[1], "/no/such/awk-outside-file", 0) >= 0;
  }
  def aob-c-directory(ctx) {
   let r = fpa-awk-files(aob-index(), [temp_dir()], []);
   nil?(r[0]) && str_find(r[1], temp_dir(), 0) >= 0;
  }
 }
 live-claims("awk-outside-band", 0, [["read", 1, 1, aob-c-read], ["missing", 2, 1, aob-c-missing], ["directory", 4, 1, aob-c-directory]]);
}
