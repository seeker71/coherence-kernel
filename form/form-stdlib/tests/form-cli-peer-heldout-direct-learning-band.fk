; form-cli-peer-heldout-direct-learning-band.fk — a local direct answer reaches
; the sealed evaluator before durable egress, without exposing the private row.
;
; PROOF BAND (fkwu): 1023
; preludes: form-stdlib/form-cli-peer-heldout-direct-learning.fk

(do
    (defn fcphtlb-bit (ok bit) (if ok bit 0))
    (defn fcphtlb-session ()
        (fcms-session "live" "heldout-band" "local.gguf" "src"
            (list "ctx") (list "state") 128 7 11 0 5 3 2 1))
    (defn fcphtlb-task (turn kind text)
        (fcpsi-frame-parse "@0.2.0.992" 1 993
            (fcpa-task-frame turn kind text) 999))
    (defn fcphtlb-peer (session text ids)
        (fcpdaa-peer (fcpdaa-finish session
            (fcms-generation text ids session) 9)))
    (defn form-cli-peer-heldout-direct-learning-band ()
        (do
            (let row (head (fkh3-rows)))
            (let session (fcphtlb-session))
            (let task (fcphtlb-task 41 "direct-answer" (fkh3-prompt row)))
            (let perfect-peer (fcphtlb-peer session (fkh3-expected row) (list 7 8)))
            (let wrong-peer (fcphtlb-peer session "wrong" (list 7)))
            (let empty-peer (fcphtlb-peer session "" (list)))
            (let perfect (fcphtl-run task perfect-peer))
            (let wrong (fcphtl-run task wrong-peer))
            (let empty (fcphtl-run task empty-peer))
            (let unbound (fcphtl-run
                (fcphtlb-task 42 "direct-answer" "ordinary local question")
                perfect-peer))
            (let malformed (fcphtl-run
                (fcphtlb-task 43 "research" (fkh3-prompt row)) perfect-peer))
            (let frame (fcphtl-frame task perfect-peer))
            (sum (list
                (fcphtlb-bit (and (eq (fcphtl-result? perfect) 1)
                    (and (str_eq (fcphtl-state perfect) "value")
                    (and (str_eq (fcphtl-row-id perfect) (fkh3-id row))
                         (str_eq (fcphtl-family perfect) (fkh3-family row))))) 1)
                (fcphtlb-bit (and (eq (fkh3-obs-exact
                    (fcphtl-observation perfect)) 1000000)
                    (and (eq (fcphtl-equivalent perfect) 1)
                         (str_eq (fcphtl-decision perfect)
                                 "record-equivalent-heldout"))) 2)
                (fcphtlb-bit (and (eq (fkh3-obs-exact
                    (fcphtl-observation wrong)) 0)
                    (and (eq (fcphtl-equivalent wrong) 0)
                         (str_eq (fcphtl-decision wrong)
                                 "record-heldout-mismatch"))) 4)
                (fcphtlb-bit (and (str_eq (fcphtl-state empty) "nothing")
                    (and (eq (fcphtl-equivalent empty) 0)
                         (str_eq (fcphtl-decision empty)
                                 "record-heldout-nothing"))) 8)
                (fcphtlb-bit (and (str_eq (fcphtl-state unbound) "nothing")
                    (str_eq (fcphtl-reason unbound) "direct-prompt-not-heldout")) 16)
                (fcphtlb-bit (and (str_eq (fcphtl-state malformed) "nothing")
                    (str_eq (fcphtl-reason malformed) "task-not-direct-answer")) 32)
                (fcphtlb-bit (and (ge (str_find frame
                    "<|form:heldout-local-answer|>" 0) 0)
                    (and (ge (str_find frame
                        (str_concat "\nrow=" (str_concat (fkh3-id row) "\n")) 0) 0)
                    (and (ge (str_find frame "\nequivalent=1\n" 0) 0)
                         (ge (str_find frame
                            "\nlearning-decision=record-equivalent-heldout\n" 0) 0)))) 64)
                (fcphtlb-bit (and (lt (str_find frame (fkh3-prompt row) 0) 0)
                    (and (lt (str_find frame (fkh3-expected row) 0) 0)
                    (and (lt (str_find frame (fcpdaa-response
                        (fcpa-cursor perfect-peer)) 0) 0)
                    (and (lt (str_find frame "answer-sha" 0) 0)
                         (lt (str_find frame "source=" 0) 0))))) 128)
                (fcphtlb-bit (and (eq (fcphtl-generated-tokens perfect) 2)
                    (and (str_eq (fcphtl-direct-signal perfect) "value")
                         (eq (fcphtl-score-valid? (fcphtl-score perfect)
                             (fkh3-rows)) 1))) 256)
                (fcphtlb-bit (and (eq (fcphtl-prompt-count
                    (fkh3-prompt row) (fkh3-rows)) 1)
                    (eq (fcphtl-prompt-count "ordinary local question"
                        (fkh3-rows)) 0)) 512)))))

    (form-cli-peer-heldout-direct-learning-band))
