   let never = "observe/no-such-door-here.bml";
   let hearth = ".hearth/x/untracked.md";
   let dotted = "./observe/land-run.bml";
   let far = "/no/such/band/path.log";
   let here = dnb-root(ctx) ++ "/ledger.jsonl";
   let j = dnr-judged-with(held, [gone, born, never, hearth, dotted, far, here], dnb-t0(), dnb-work(ctx), dnb-tree-dir(ctx));
