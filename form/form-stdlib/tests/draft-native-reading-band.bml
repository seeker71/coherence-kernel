; draft-native-reading-band.bml — the body reads its own drafts natively (observe/draft-native-reading-run.bml), fkwu-witnessed.
; No model opens: the door's voice_lines lane reads one fixture line per draft in place of the voice. A scratch ledger stands in for
; receipts/draft-ledger.jsonl, with twenty-one drafts written the way observe/prompt-draft-run.bml writes them: P-* unread by us (P-22 cut at the reply budget), R-* read of
; record (R-9 accepted, R-19 rejected, R-20 accepted; no reader), E-21 older than the scratch tree's first commit, and a row U-18 whose voice spoke no text.
; A scratch git tree stands for the checkout at the drafts' time: its first commit is before them and holds observe/land-run.bml and
; receipts/gone-since.jsonl; its second, after them, removes the second and adds observe/born-after.bml; .hearth/x/untracked.md stands and git
; never held it. The covenant is the real one, model/fixtures/draft-reading/covenant.jsonl, graded by the real grader
; (observe/alignment-read-run.bml as a cell in its grading lane). The doors run as owned cells over the scratch; nothing outside it is touched.
;
; Verdict 65535 when every claim lands:
;   1    covenant: count 2 with covenant_only reads P-1 then P-2 and lands nothing, newest 1 reads the newest first; the full read rejects P-1 for the path it
;        invents (observe/no-such-door-here.bml) without asking the voice: its fixture line says "accepted" and is never read,
;        the row's tally is 3/4 with predicates_failed ["named-paths lacks:observe/no-such-door-here.bml"]
;   2    parse: P-2's line "Revised: ..." lands revised with its note, tally 4/4; P-7's "**accepted:** ..." lands accepted
;   4    refusal: P-3's line "The draft reads well to me." is refused by name, no row lands for it, and a later read finds it
;        the one draft still readable and pending
;   8    made: the covenant made for each draft: list ordinals and "Step 3:" set aside (P-4 3/3), a number the drafter was
;        never given rejected and named (P-5: 5%), no number predicate where the turn before gave one (P-6 2/2), the person's
;        own "guard against" set aside (P-7 3/3), placeholders naming no path (P-8), the page rule only where a status
;        page is asked for (P-10 rejected on "does not", P-11 4/4); and the voice's packet (rp-sema in front) carries the
;        turn before whole: P-6's count stands at the start of a turn longer than a tail would keep; and the paths of the
;        files the drafter read go beside it, their text named as not shown (P-6's two files, before its draft)
;   16   readers: observe/draft-readings-to-rows.bml by default projects readings of record alone (the receipt readers "of-record"); readers
;        ["native-voice"] writes draft-readings-native.jsonl alone (9 rows, P-4 first; the revised P-2 has no revised text, the accepted P-22 was cut and teaches nothing; no held-out
;        file); a draft we read becomes no native row, whatever the voice read (of_record_stands 3); the agreement on the three
;        both read: agreed 1, same_side 1, confusion by pair; readers ["someone"] is refused by name
;   32   shape: each native row is the reading row (at_unix_ms, draft, reading, note) then reader, predicates_passed, predicates_total,
;        predicates_failed, model, generated, prefill_ms, decode_ms, wall_ms; nineteen landed; the summary reads voice asks 0 and rent_tokens 0
;   64   strict: an unknown key, a count of 0 and an id the ledger holds no draft for are refused by name (exit 1) and the
;        ledger is unchanged; the voice_lines lane with no ledger named (beside receipts/draft-ledger.jsonl) is refused by
;        name before it reads, so a fixture's verdict never lands in the body's ledger (asked covenant_only, its size unchanged)
;   128  second-reader: after the native read our list (observe/draft-reading-run.bml) still names every draft we did not read, 18 lines and no
;        R-* and no U-18; our reading of P-5 lands a row of the four keys and moves our list alone, the native view keeps its reading;
;        a list over the whole ledger (the plant) shrinks with native readings and fails the same check; observe/draft-page-run.bml reads our view
;   256  one-row: neither door builds a reading row by itself: both call dl-land, neither source holds fhn-s("reading"; both rows begin at_unix_ms, draft, reading, note
;   512  at-time: over the scratch tree at the drafts' time, a path gone since holds (P-12 accepted 4/4), a path born after does not (P-13 rejected
;        3/4, named), a path git never held holds while it stands (P-14), a draft older than the tree is passed over by name (E-21), and
;        the judge read directly answers the same; existence now (a plant) and the tree alone (a plant) each fail the same check
;   1024 numbers: names, a bare zero, codes and steps claim no amount (M1, F1, flake8, exit code (0), 0 failed, error code (e.g., 403, 500), steps 1–4,
;        P-16 accepted 3/3), and a quantity stands (5 seconds, 80%, 4.5/5, 10-second, 5–10, n=5, P-17 rejected); four plants, each blind to
;        one set-aside, and one that sets every word aside, fail the check
;   2048 parse: `fkwu.c`/`fkwu.rs` names no path, gap:tests/x.gap names tests/x.gap, /path/to/... names none, two backticked paths joined name both, a URL none,
;        a trailing :<line> is set aside (P-15 accepted 4/4); the plain tokenizer (a plant) fails the check
;   4096 unspoken: dl-spoke? reads a row whose voice spoke no text as no draft (unavailable, empty with generated, generated 0) and an answered or incomplete
;        one as a draft; a plant counting every path row fails; observe/prompt-draft-run.bml over a scratch capture redrafts the prompt
;        whose only row carried no text, lands no file and no row for a voice that spoke none (named), says "drafted 2 of 3" and the rows left
;        with no text; the voice_lines lane beside the body's ledger is refused by name; the presence heartbeat's wake packet and a side session's hand-off brief are no one's words: the drafter leaves
;        them out and dl-drafts lists no draft of either, while a person who says those words mid-sentence stays; plants that read no wake packet, read the words anywhere, or stay blind to the hand-off fail;
;        a draft whose file holds no words is no draft, one with words and one without the drafter's marks stand; plants blind to the empty words, blind to the packets, and reading every file fail
;   8192 teaches: dl-teaches? keeps a draft from a native row whenever we read it (accepted or rejected), and a plant that teaches all fails;
;        dl-voice-read? reads a covenant rejection as no word of the voice's, and a plant reading every row as the voice's fails
;   16384 window: dnr-window-why-at closes the voice when until_ms leaves less than the floor; the door under a spent until_ms lands a covenant
;        rejection, holds the rest by name and lands nothing for them; a voice that did not answer closes the batch: it is refused, the
;        next is held by name, nothing lands; a plant comparing the other way fails
;   32768 voice: dnr-voice-by takes the review voice when it fits, the fast voice when only that fits, none when neither fits or the fast voice is
;        absent (the governor's word on the line); a plant that always takes the first fails
;
; REQUIRES: the built ./fkwu and the body root as the working directory.
// preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/bml/live.bml form-stdlib/bml/host-child.bml form-stdlib/bml/draft-native-reading.bml
section [form.bml] {
 class DraftNativeReadingBand {
  def dnb-has(s, part) = str_find(s, part, 0) >= 0;
  def dnb-fresh() {
   let root = temp_dir() ++ "/draft-native-reading-band-" ++ now_unix_ms().str();
   (Comparable) host_dir_mkdir(root) == 1 ? ["native", root, 0] : nothing();
  }
  def dnb-root(ctx) = ctx[1];
  def dnb-drafts(ctx) = dnb-root(ctx) ++ "/drafts";
  def dnb-ledger(ctx) = dnb-root(ctx) ++ "/ledger.jsonl";
  def dnb-voice(ctx) = dnb-root(ctx) ++ "/voice.jsonl";
  def dnb-work(ctx) = dnb-root(ctx) ++ "/work";
  def dnb-receipt(ctx) = dnb-root(ctx) ++ "/receipt.jsonl";
  def dnb-tree-dir(ctx) = dnb-root(ctx) ++ "/tree";
  def dnb-s(k, v) = json-node-pair(k, json-node-string(v));
  def dnb-n(k, v) = json-node-pair(k, json-node-int(v));
  // ---- the times: the tree's two commits, the drafts between them, and one draft older than the tree
  def dnb-commit-1() = 1700000000;
  def dnb-commit-2() = 1700001000;
  def dnb-t0() = 1700000500000;
  def dnb-old() = 1699000000000;
  // ---- the scratch tree, through git with its dates named
  def dnb-git(ctx, at, args) {
   let date = "@" ++ at.str() ++ " +0000";
   let pid = host_spawn_at(append(["env", "GIT_AUTHOR_DATE=" ++ date, "GIT_COMMITTER_DATE=" ++ date, "git", "-C", dnb-tree-dir(ctx), "-c", "user.name=band", "-c", "user.email=band@band.local", "-c", "commit.gpgsign=false"], args), ["/dev/null", "/dev/null", "/dev/null"]);
   pid <= 0 ? -1 : host_wait(pid);
  }
  def dnb-grow(ctx) {
   let t = dnb-tree-dir(ctx);
   let d1 = hch-mkdirs(t ++ "/observe");
   let d2 = hch-mkdirs(t ++ "/receipts");
   let w1 = write_file_text(t ++ "/observe/land-run.bml", "// lands\n");
   let w2 = write_file_text(t ++ "/receipts/gone-since.jsonl", "{}\n");
   let g1 = dnb-git(ctx, dnb-commit-1(), ["init", "-q"]);
   let g2 = dnb-git(ctx, dnb-commit-1(), ["add", "-A"]);
   let g3 = dnb-git(ctx, dnb-commit-1(), ["commit", "-q", "-m", "one"]);
   let r = host_path_remove(t ++ "/receipts/gone-since.jsonl");
   let w3 = write_file_text(t ++ "/observe/born-after.bml", "// born after\n");
   let g4 = dnb-git(ctx, dnb-commit-2(), ["add", "-A"]);
   let g5 = dnb-git(ctx, dnb-commit-2(), ["commit", "-q", "-m", "two"]);
   let d3 = hch-mkdirs(t ++ "/.hearth/x");
   let w4 = write_file_text(t ++ "/.hearth/x/untracked.md", "hearth\n");
   (Comparable) g3 == 0 && (Comparable) g5 == 0;
  }
  // ---- the drafts: [id, the person's words, the draft, the turn before, the fixture voice line] and, for P-6, the files read
  def dnb-status() = "Write one line for the status page: the walk now runs at night.";
  // a turn before longer than a cut would keep, its count at the start: the voice reads it whole
  def dnb-pad(n) = n <= 0 ? "" : "The walk keeps its own ledger of each night. " ++ dnb-pad(n - 1);
  // the files P-6's drafter read, as observe/prompt-draft-run.bml lists them: one path per line
  def dnb-p6-files() = "/tmp/walk-body/observe/walk-run.bml\n/tmp/walk-body/receipts/walk-ledger.jsonl";
  def dnb-cases() = [
   ["P-1", "Which door lands a change?", "Run observe/no-such-door-here.bml, then read its receipt.", "", "accepted: this line is never read"],
   ["P-2", "Which door lands a change?", "observe/land-run.bml lands the change: it applies the edits, runs the witness and commits.", "", "Revised: names the landing door, then needs the witness the turn named"],
   ["P-3", "What does the walk do at night?", "The walk takes engineering turns at night with the body's own voice.", "", "The draft reads well to me."],
   ["P-4", "How do I read the gap register?", "1. Read the gap register.\n2. Name the open gap.\nStep 3: land the repair.", "", "accepted: kept to the register it was given"],
   ["P-5", "How much of the ledger is read?", "About 5% of the rows carry a reading.", "", "accepted: this line is never read"],
   ["P-6", "How many walks ran?", "The walk ran 3 times; read the walk ledger before the next one.", "The person asked just before: how many walks ran?\n\nThe answer they received: the walk ran 3 times tonight. " ++ dnb-pad(50), "Accepted: kept the turn's own count", dnb-p6-files()],
   ["P-7", "How do I guard against a stale image before a band?", "To guard against a stale image, read the band's exit first and rebuild the image when it is older than its source.", "", "**accepted:** kept the person's own words"],
   ["P-8", "Where does the draft text land?", "The drafter writes <drafts>/<id>.md and each door named observe/*-run.bml reads it.", "", "accepted: named no file it was not given"],
   ["R-9", "Say good morning.", "Good morning.", "", "rejected: too thin to read"],
   ["P-10", dnb-status(), "The walk does not run by day; it runs at night.", "", "accepted: this line is never read"],
   ["P-11", dnb-status(), "The walk runs at night with the body's own voice.", "", "accepted: the line names what carries the walk"],
   ["P-12", "Where did the goal keep its ledger?", "The ledger stood at receipts/gone-since.jsonl then.", "", "accepted: it stood then"],
   ["P-13", "Which door comes first?", "Read observe/born-after.bml first.", "", "accepted: this line is never read"],
   ["P-14", "What does the hearth hold?", "Read .hearth/x/untracked.md first.", "", "accepted: it stands in the hearth"],
   ["P-15", "Which file names the landing?", "See /path/to/form-cli.fk, `fkwu.c`/`fkwu.rs` and gap:observe/land-run.bml for the landing.", "", "accepted: names only what stood"],
   ["P-16", "What reading says it is done?", "The reading is exit code (0) on the M1 chip with `flake8` clean, 0 failed, an error code (e.g., 403, 500) names the refuser, and steps 1–4 stand.", "", "accepted: claims no amount"],
   ["P-17", "How long does it take?", "It finishes under 5 seconds.", "", "accepted: this line is never read"],
   ["R-19", "Say a hard thing kindly.", "A hard thing, said kindly.", "", "accepted: it heard them"],
   ["R-20", "Say a warm thing please.", "A warm thing.", "", "accepted: warm"],
   ["E-21", "Which door lands a change?", "observe/land-run.bml lands.", "", "accepted: this line is never read"],
   ["P-22", "How long is the answer?", "A long answer that stops here.\n\n(cut at the reply budget of 900 tokens)", "", "accepted: it heard them"]
  ];
  def dnb-file(c) = "# The person asked\n\n" ++ c[1] ++ "\n\n# The body's draft\n\n" ++ c[2] ++ "\n" ++ ((Comparable) len(c[3]) == 0 ? "" : "\n# The turn before (what the voice was given)\n\n" ++ c[3] ++ "\n") ++ ((Comparable) len(c) < 6 ? "" : "\n# Files the voice read\n\n" ++ c[5] ++ "\n");
  def dnb-path-row(ctx, at, id, voice, generated) = json-emit(json-node-object([dnb-n("at_unix_ms", at), dnb-s("draft", id), dnb-n("prompt_t", at), dnb-s("session", id), dnb-s("path", dnb-drafts(ctx) ++ "/" ++ id ++ ".md"), dnb-s("voice", voice), dnb-n("generated", generated), dnb-n("wall_ms", 1), dnb-s("reading", "pending")])) ++ "\n";
  def dnb-at(id, t) = (String) id == "E-21" ? dnb-old() : dnb-t0() + t;
  def dnb-path-rows(ctx, cases, t) = nil?(cases) ? "" : dnb-path-row(ctx, dnb-at(cases[0][0], t), cases[0][0], "answered", 10) ++ dnb-path-rows(ctx, cases[1:], t + 1);
  def dnb-ours(id, reading, note) = json-emit(json-node-object([dnb-n("at_unix_ms", dnb-t0() + 100), dnb-s("draft", id), dnb-s("reading", reading), dnb-s("note", note)])) ++ "\n";
  def dnb-voice-rows(cases) = nil?(cases) ? "" : json-emit(json-node-object([dnb-s("draft", cases[0][0]), dnb-s("line", cases[0][4])])) ++ "\n" ++ dnb-voice-rows(cases[1:]);
  def dnb-tree(ctx) {
   let d = host_dir_mkdir(dnb-drafts(ctx));
   let files = map(c => write_file_text(dnb-drafts(ctx) ++ "/" ++ c[0] ++ ".md", dnb-file(c)), dnb-cases());
   let l = write_file_text(dnb-ledger(ctx), dnb-path-rows(ctx, dnb-cases(), 1) ++ dnb-path-row(ctx, dnb-t0() + 50, "U-18", "unavailable", 0) ++ dnb-ours("R-9", "accepted", "warm") ++ dnb-ours("R-19", "rejected", "turned away") ++ dnb-ours("R-20", "accepted", "warm"));
   let v = write_file_text(dnb-voice(ctx), dnb-voice-rows(dnb-cases()));
   let u = write_file_text(dnb-drafts(ctx) ++ "/U-18.md", "# The person asked\n\nSomething asked.\n\n# The body's draft\n\n\n");
   let grown = dnb-grow(ctx);
   (Comparable) d == 1 && grown ? dnb-root(ctx) : nothing();
  }
   // ---- the same public doors as owned cells, with their values and failures retained
  def dnb-door(ctx, door, name, request) {
   let base = dnb-root(ctx) ++ "/" ++ name;
    let run=hch-cell-in(dnb-root(ctx),name,door,request,nothing());
    let rec=run[3];let text=cs-stdout(rec);
    write_file_text(base ++ ".out",text);
    write_file_text(base ++ ".cell",value_str(rec));
    [run[0],text,cs-stderr(rec)];
  }
  def dnb-reader() = "observe/draft-native-reading-run.bml";
  def dnb-rows-door() = "observe/draft-readings-to-rows.bml";
  def dnb-request(ctx, extra) = "{\"ledger\":\"" ++ dnb-ledger(ctx) ++ "\",\"work\":\"" ++ dnb-work(ctx) ++ "\",\"tree\":\"" ++ dnb-tree-dir(ctx) ++ "\"" ++ extra ++ "}";
  def dnb-read-out(ctx) = read_file(dnb-root(ctx) ++ "/read.out") ?? "";
  def dnb-lines(text) = filter(l => len(trim(l)) > 0, split-on(text, "\n"));
  def dnb-draft-lines(text) = filter(l => str_find(l, "[native-reading] ", 0) == 0 && !dnb-has(l, "[native-reading] read "), dnb-lines(text));
  def dnb-line(text, id) = foldl((acc, l) => (Comparable) len(acc) == 0 && str_find(l, "[native-reading] " ++ id ++ " ", 0) == 0 ? l : acc, "", dnb-lines(text));
  def dnb-str(doc, key) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : "";
  def dnb-int(doc, key) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : -1;
  def dnb-strs(doc, key) = json-object-has?(doc, key) ? map(n => json-string-value(n), json-array-elements(json-object-get(doc, key))) : ["absent"];
  def dnb-rows(path) = map(l => parse-json("row", l), dnb-lines(read_file(path) ?? ""));
  def dnb-native(ctx) = filter(r => (String) dnb-str(r, "reader") == "native-voice", dnb-rows(dnb-ledger(ctx)));
  def dnb-row(ctx, id) = foldl((acc, r) => (String) dnb-str(r, "draft") == id ? r : acc, json-node-object([]), dnb-native(ctx));
  def dnb-read-as?(r, reading, passed, total) = (String) dnb-str(r, "reading") == reading && dnb-int(r, "predicates_passed") == passed && dnb-int(r, "predicates_total") == total;
  def dnb-size(ctx) = file_size(dnb-ledger(ctx));
  def dnb-same?(a, b) = (String) str-join-with(a, "|") == str-join-with(b, "|");
  // ---- 1 covenant
  def dnb-c-covenant(ctx) {
   let made = dnb-tree(ctx);
   let before = dnb-size(ctx);
   let only = dnb-door(ctx, dnb-reader(), "only", dnb-request(ctx, ",\"count\":2,\"covenant_only\":1"));
   let newest = dnb-door(ctx, dnb-reader(), "newest", dnb-request(ctx, ",\"count\":1,\"newest\":1,\"covenant_only\":1"));
   let after = dnb-size(ctx);
   let shown = dnb-draft-lines(only[1]);
   let read = dnb-door(ctx, dnb-reader(), "read", dnb-request(ctx, ",\"count\":30,\"voice_lines\":\"" ++ dnb-voice(ctx) ++ "\""));
   let p1 = dnb-row(ctx, "P-1");
   !nothing?(made) && (Comparable) only[0] == 0 && len(shown) == 2 && str_find(shown[0], "[native-reading] P-1 rejected voice=not-asked covenant=3/4", 0) == 0 && str_find(shown[1], "[native-reading] P-2 held voice=not-asked covenant=4/4", 0) == 0
   && dnb-has(only[1], "read 2 of 21 pending") && (Comparable) before == after
   && str_find(dnb-draft-lines(newest[1])[0], "[native-reading] P-22 held voice=not-asked", 0) == 0
   && (Comparable) read[0] == 0 && dnb-has(dnb-line(read[1], "P-1"), "P-1 rejected voice=not-asked covenant=3/4") && dnb-has(dnb-line(read[1], "P-1"), "named-paths: observe/no-such-door-here.bml")
   && dnb-read-as?(p1, "rejected", 3, 4) && dnb-has(dnb-str(p1, "note"), "observe/no-such-door-here.bml") && !dnb-has(dnb-str(p1, "note"), "never read")
   && (String) str-join-with(dnb-strs(p1, "predicates_failed"), "|") == "named-paths lacks:observe/no-such-door-here.bml";
  }
  // ---- 2 parse
  def dnb-c-parse(ctx) {
   let p2 = dnb-row(ctx, "P-2");
   let p7 = dnb-row(ctx, "P-7");
   dnb-read-as?(p2, "revised", 4, 4) && (String) dnb-str(p2, "note") == "names the landing door, then needs the witness the turn named" && nil?(dnb-strs(p2, "predicates_failed"))
   && dnb-read-as?(p7, "accepted", 3, 3) && (String) dnb-str(p7, "note") == "kept the person's own words";
  }
  // ---- 4 refusal
  def dnb-c-refusal(ctx) {
   let again = dnb-door(ctx, dnb-reader(), "again", dnb-request(ctx, ",\"count\":20,\"covenant_only\":1"));
   dnb-has(dnb-read-out(ctx), "[native-reading] P-3 refused: the voice's line does not read as accepted|revised|rejected: <note>: The draft reads well to me.")
   && len(filter(r => (String) dnb-str(r, "draft") == "P-3", dnb-native(ctx))) == 0
   && (Comparable) again[0] == 0 && str_find(dnb-line(again[1], "P-3"), "[native-reading] P-3 held ", 0) == 0 && dnb-has(again[1], "read 1 of 2 pending");
  }
  // ---- 8 made
  def dnb-c-made(ctx) {
   let out = dnb-read-out(ctx);
   let packet = read_file(dnb-work(ctx) ++ "/P-6.packet.txt") ?? "";
   dnb-has(packet, "You are Sema") && dnb-has(packet, "The turn before the draft:\nThe person asked just before: how many walks ran?") && dnb-has(packet, "the walk ran 3 times tonight")
   && dnb-has(packet, "The files the drafter read (their text is not shown here):\n" ++ dnb-p6-files() ++ "\n\nThe draft:\nThe walk ran 3 times")
   && dnb-read-as?(dnb-row(ctx, "P-4"), "accepted", 3, 3)
   && dnb-read-as?(dnb-row(ctx, "P-5"), "rejected", 2, 3) && dnb-has(dnb-str(dnb-row(ctx, "P-5"), "note"), "given-numbers: 5%")
   && dnb-read-as?(dnb-row(ctx, "P-6"), "accepted", 2, 2) && dnb-has(dnb-line(out, "P-6"), "unapplied=affirmative,named-paths,given-numbers ")
   && dnb-read-as?(dnb-row(ctx, "P-7"), "accepted", 3, 3)
   && dnb-read-as?(dnb-row(ctx, "P-8"), "accepted", 3, 3) && dnb-has(dnb-line(out, "P-8"), "unapplied=affirmative,named-paths ")
   && dnb-read-as?(dnb-row(ctx, "P-10"), "rejected", 3, 4) && dnb-has(dnb-str(dnb-row(ctx, "P-10"), "note"), "affirmative: does not")
   && dnb-read-as?(dnb-row(ctx, "P-11"), "accepted", 4, 4);
  }
  // ---- 16 readers
  def dnb-counts?(doc, acc, rev, rej, rows, held, skipped) = dnb-int(doc, "accepted") == acc && dnb-int(doc, "revised") == rev && dnb-int(doc, "rejected") == rej && dnb-int(doc, "rows_written") == rows && dnb-int(doc, "heldout_written") == held && dnb-int(doc, "skipped_no_text") == skipped;
  def dnb-last-json(text) = foldl((acc, l) => (len(l) > 0) && ((Comparable) str_byte_at(l, 0) == 123) ? l : acc, "{}", dnb-lines(text));
  def dnb-rows-request(ctx, out, readers) = "{\"ledger\":\"" ++ dnb-ledger(ctx) ++ "\",\"drafts\":\"" ++ dnb-drafts(ctx) ++ "\",\"out\":\"" ++ out ++ "\",\"receipt\":\"" ++ dnb-receipt(ctx) ++ "\"" ++ readers ++ "}";
  def dnb-c-readers(ctx) {
   let rec = dnb-root(ctx) ++ "/out-record";
   let nat = dnb-root(ctx) ++ "/out-native";
   let r1 = dnb-door(ctx, dnb-rows-door(), "rows-record", dnb-rows-request(ctx, rec, ""));
   let r2 = dnb-door(ctx, dnb-rows-door(), "rows-native", dnb-rows-request(ctx, nat, ",\"readers\":[\"native-voice\"]"));
