  // ---- 32 shape
  def dnb-keys() = ["at_unix_ms", "draft", "reading", "note", "reader", "predicates_passed", "predicates_total", "predicates_failed", "model", "generated", "prefill_ms", "decode_ms", "wall_ms"];
  def dnb-c-shape(ctx) {
   let rows = dnb-native(ctx);
   len(rows) == 19 && all?(r => (String) str-join-with(json-object-keys(r), ",") == str-join-with(dnb-keys(), ","), rows)
