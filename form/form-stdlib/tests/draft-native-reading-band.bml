  // ---- 1024 numbers
  def dnb-no-amount() = ["The target is the M1, M2, M3 chip.", "Score F1 on `flake8` and `whisper-large-v3`.", "The reading is a clean exit code (0).", "Passed with `0 failed`.", "A specific error code (e.g., 403, 500).", "Only after steps 1–4 are complete.", "It ends exit=0.", "Then exit 1 names it."];
  def dnb-amounts() = ["Under 5 seconds.", "For 80% of the cases.", "A threshold (e.g., 4.5/5).", "A 10-second clip.", "Feed 5–10 prompts.", "Take n=5 rows.", "Exit after 5 seconds.", "Code changes in 3 files."];
  def dnb-numbers-hold?(aside) = all?(s => !dnr-has-digit?(dnr-claims-by(aside, s)), dnb-no-amount()) && all?(s => dnr-has-digit?(dnr-claims-by(aside, s)), dnb-amounts());
  def dnb-plant-names(mode, w) { let b = dnr-value(w); ((String) b == "0") || (((String) mode == "code") && dnr-digits?(b)) || (((String) mode == "step") && (dnr-digits?(b) || dnr-range?(b))); }
  def dnb-plant-zero(mode, w) { let b = dnr-value(w); dnr-name?(w) || (((String) mode == "code") && dnr-digits?(b) && !((String) b == "0")) || (((String) mode == "step") && (dnr-digits?(b) || dnr-range?(b))); }
  def dnb-plant-codes(mode, w) { let b = dnr-value(w); dnr-name?(w) || ((String) b == "0") || (((String) mode == "step") && (dnr-digits?(b) || dnr-range?(b))); }
  def dnb-plant-steps(mode, w) { let b = dnr-value(w); dnr-name?(w) || ((String) b == "0") || (((String) mode == "code") && dnr-digits?(b)); }
  def dnb-plant-all(mode, w) = true;
  def dnb-c-numbers(ctx) = dnb-numbers-hold?(dnr-aside?) && !dnb-numbers-hold?(dnb-plant-names) && !dnb-numbers-hold?(dnb-plant-zero) && !dnb-numbers-hold?(dnb-plant-codes) && !dnb-numbers-hold?(dnb-plant-steps) && !dnb-numbers-hold?(dnb-plant-all)
   && dnb-read-as?(dnb-row(ctx, "P-16"), "accepted", 3, 3) && dnb-read-as?(dnb-row(ctx, "P-17"), "rejected", 2, 3) && dnb-has(dnb-str(dnb-row(ctx, "P-17"), "note"), "given-numbers: 5");
