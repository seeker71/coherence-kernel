   let names = dnb-listed(listed[1]);
   let landed = dnb-door(ctx, dnb-our-door(), "ours-read", dnb-our-ask(ctx) ++ "P-5 accepted kept to its word\nP-6 maybe\n");
   let after = dl-rows(dnb-ledger(ctx));
   let ours = foldl((acc, r) => (String) dl-id(r) == "P-5" && !dl-native?(r) && !dl-path?(r) ? r : acc, json-node-object([]), after);
   let again = dnb-door(ctx, dnb-our-door(), "ours-again", dnb-our-ask(ctx));
   (Comparable) listed[0] == 0 && len(names) == 18 && !any?(l => dnb-has(l, "R-") || dnb-has(l, "U-18"), names) && any?(l => dnb-has(l, "P-1 "), names)
   && dnb-has(landed[1], "[reading] P-5 accepted") && dnb-has(landed[1], "not recorded") && (String) str-join-with(json-object-keys(ours), ",") == "at_unix_ms,draft,reading,note" && (String) dnb-str(ours, "note") == "kept to its word"
   && len(dnb-listed(again[1])) == 17 && (String) dl-reading("P-5", dl-of-native(after)) == "rejected" && (String) dl-reading("P-5", dl-of-record(after)) == "accepted"
   && dnb-view-holds?(dl-of-record, rows) && !dnb-view-holds?(x => x, rows)
