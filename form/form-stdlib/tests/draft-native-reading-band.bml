   && dnb-int(c2, "of_record_stands") == 3 && dnb-int(c2, "both_read") == 3 && dnb-int(c2, "agreed") == 1 && dnb-int(c2, "same_side") == 1 && dnb-int(c2, "voice_both_read") == 3 && dnb-int(c2, "voice_agreed") == 1 && dnb-int(c2, "voice_same_side") == 1
