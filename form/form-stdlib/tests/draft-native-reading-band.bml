  // ---- 64 strict
  def dnb-c-strict(ctx) {
   let before = dnb-size(ctx);
   let lane = ",\"voice_lines\":\"" ++ dnb-voice(ctx) ++ "\"";
   let odd = dnb-door(ctx, dnb-reader(), "odd", dnb-request(ctx, lane ++ ",\"lst\":1"));
   let none = dnb-door(ctx, dnb-reader(), "none", dnb-request(ctx, lane ++ ",\"count\":0"));
   let stray = dnb-door(ctx, dnb-reader(), "stray", dnb-request(ctx, lane ++ ",\"ids\":[\"P-1\",\"no-such-draft\"]"));
   let body = file_size("receipts/draft-ledger.jsonl");
   let beside = dnb-door(ctx, dnb-reader(), "beside", "{\"work\":\"" ++ dnb-work(ctx) ++ "\",\"covenant_only\":1" ++ lane ++ "}");
   (Comparable) odd[0] == 1 && dnb-has(odd[1], "draft-native-reading: unknown key \"lst\"") && (Comparable) none[0] == 1 && dnb-has(none[1], "draft-native-reading: count must be 1 or more")
   && (Comparable) stray[0] == 1 && dnb-has(stray[1], "draft-native-reading: ids names no draft in " ++ dnb-ledger(ctx) ++ ": no-such-draft") && (Comparable) dnb-size(ctx) == before
   && (Comparable) beside[0] == 1 && dnb-has(beside[1], "draft-native-reading: voice_lines is the band's lane") && (Comparable) file_size("receipts/draft-ledger.jsonl") == body;
