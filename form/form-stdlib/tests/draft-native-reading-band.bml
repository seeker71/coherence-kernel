  def dnb-plant-now(w, blob, work, tree) = (Comparable) host_path_exists(dnr-abs?(w) ? w : tree ++ "/" ++ dnr-rel(w)) == 1;
  def dnb-plant-tree(w, blob, work, tree) = blob;
