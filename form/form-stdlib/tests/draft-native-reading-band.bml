  def dnb-spoke-holds?(spoke) = !spoke(dnb-spoke-row("unavailable", 0)) && !spoke(dnb-spoke-row("empty", 4)) && !spoke(dnb-spoke-row("answered", 0)) && spoke(dnb-spoke-row("answered", 4)) && spoke(dnb-spoke-row("incomplete", 900));
