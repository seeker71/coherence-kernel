  // ---- 128 second-reader: our list as the door lists it, then as a list over the whole ledger would
  def dnb-our-door() = "observe/draft-reading-run.bml";
  def dnb-our-ask(ctx) = "{\"ledger\":\"" ++ dnb-ledger(ctx) ++ "\"}\n";
  def dnb-listed(text) = filter(l => dnb-has(l, "  ") && !dnb-has(l, "["), dnb-lines(text));
  def dnb-view-holds?(view, rows) { let ids = map(d => dl-id(d), dl-pending(view(rows))); dnb-has(str-join-with(ids, ","), "P-1") && dnb-has(str-join-with(ids, ","), "P-17"); }
  def dnb-c-second(ctx) {
