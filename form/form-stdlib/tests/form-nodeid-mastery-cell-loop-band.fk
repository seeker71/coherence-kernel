; form-nodeid-mastery-cell-loop-band.fk -- pure mastery movement witness.
;
; Verdict 67108863 (26 bits):
;   1        twelve reserved categories are exact and pairwise distinct
;   2        decoded mastery-thought bytes are consumed scannerlessly
;   4        a short cursor budget yields timeout without a callback
;   8        discover carries concept plus absent source/entry honestly
;   16       choose creates a content-addressed attempt identity
;   32       request keeps scannerless=1 and pretokenized=0
;   64       generic lookup returns source/entry/observation identities
;   128      retrieval records one lookup and one-source cut
;   256      attempt retains request, concept, source, and entry
;   512      generic execution becomes a distinct typed observation
;   1024     present verdict 0 is not nothing
;   2048     present verdict 1 is not nothing
;   4096     absent verdict returns exact nothing
;   8192     no supplied Qwen observation keeps model-executed=0
;   16384    invalid model-executed=1 without observation is refused
;   32768    observed verdict 1 crystallizes
;   65536    observed verdict 0 carries surprise then undo/refine
;   131072   failure carries an explicit failure signal
;   262144   refinement births a second attempt from the first
;   524288   dissolve and release remain explicit optional transitions
;   1048576 continuation retains the previous cell and increments generation
;   2097152 channel identity is carried with transported=0
;   4194304 mesh identity is carried with transport/broadcast both 0
;   8388608 persistence may be requested without claiming it was observed
;   16777216 equal cell composition shares identity; changed attempt does not
;   33554432 lifecycle spans discover through release observably
;
; preludes: form-stdlib/form-nodeid-mastery-cell-loop.fk

(do
    (defn fmclb-bit (ok bit) (if ok bit 0))
    (defn fmclb-different-from? (node rest)
        (if (nil? rest) 1
            (if (node_eq node (head rest)) 0
                (fmclb-different-from? node (tail rest)))))
    (defn fmclb-distinct? (nodes)
        (if (lt (len nodes) 2) 1
            (if (eq (fmclb-different-from? (head nodes) (tail nodes)) 1)
                (fmclb-distinct? (tail nodes)) 0)))
    (defn fmclb-source ()
        (intern_node (make_nodeid 31 2 91 1)
            (list (intern_trivial_string "public-source-A"))))
    (defn fmclb-entry ()
        (intern_node (make_nodeid 31 2 91 2)
            (list (fmclb-source) (intern_trivial_string "choice"))))
    (defn fmclb-lookup-hit (ctx request)
        (fmcl-retrieval-evidence "hit" "fixture-current-source"
            (fmclb-source) (fmclb-entry)
            (intern_trivial_string "retrieval-observation") 1))
    (defn fmclb-answer (name)
        (intern_node (make_nodeid 31 2 91 3)
            (list (intern_trivial_string name))))
    (defn fmclb-execute-mastered (ctx state)
        (fmcl-execution-evidence "value" "observed-transfer"
            (fmclb-answer "choice preserves alternatives")
            1 1 0 0 0 (nothing) 1 3))
    (defn fmclb-execute-wrong (ctx state)
        (fmcl-execution-evidence "value" "counterexample"
            (fmclb-answer "choice erases alternatives")
            1 0 1 0 0 (nothing) 1 4))
    (defn fmclb-execute-nothing (ctx state)
        (fmcl-execution-evidence "nothing" "answer-not-yet"
            (nothing) 0 0 0 0 0 (nothing) 1 5))
    (defn fmclb-execute-failure (ctx state)
        (fmcl-execution-evidence "failure" "answer-observer-failed"
            (nothing) 0 0 0 1 0 (nothing) 1 6))
    (defn fmclb-execute-invalid-model (ctx state)
        (fmcl-execution-evidence "value" "unbacked-model-claim"
            (fmclb-answer "unbacked") 1 1 0 0 1 (nothing) 1 1))

    (defn form-nodeid-mastery-cell-loop-band ()
        (do
            (let categories (list
                (fmcl-concept-category) (fmcl-attempt-category)
                (fmcl-request-category) (fmcl-execution-category)
                (fmcl-observation-category) (fmcl-signal-category)
                (fmcl-lifecycle-category) (fmcl-state-category)
                (fmcl-continuation-category) (fmcl-channel-category)
                (fmcl-mesh-category) (fmcl-persistence-category)))
            (let expected (list
                (make_nodeid 31 2 0 108) (make_nodeid 31 2 0 109)
                (make_nodeid 31 2 0 110) (make_nodeid 31 2 0 111)
                (make_nodeid 31 2 0 112) (make_nodeid 31 2 0 113)
                (make_nodeid 31 2 0 114) (make_nodeid 31 2 0 115)
                (make_nodeid 31 2 0 116) (make_nodeid 31 2 0 117)
                (make_nodeid 31 2 0 118) (make_nodeid 31 2 0 119)))
            (let channel (fmcl-channel "live-cell-v1" "teaching-channel-A"))
            (let mesh (fmcl-mesh "mesh-A" "semantic,physical"))
            (let persistence (fmcl-persistence-offer "mastery-cell-A"))
            (let continuation (fmcl-continuation-none channel mesh))
            (let start (fmcl-discover "choice" 512 persistence continuation
                channel mesh))
            (let chosen (fmcl-choose start "explain-choice"))
            (let surface (fmcl-request-surface "choice" "explain-choice"))
            (let scan (fmcl-bmf-consume surface 512))
            (let timed (fmcl-bmf-consume surface 7))
            (let addressed (fmcl-address chosen surface
                "public-source-nodeid" "answer-observer"))
            (let retrieved (fmcl-retrieve-with 0 fmclb-lookup-hit addressed))
            (let attempted (fmcl-begin-attempt retrieved))
            (let observed1
                (fmcl-execute-with 0 fmclb-execute-mastered attempted))
            (let crystal (fmcl-decide observed1))
            (let dissolved (fmcl-dissolve crystal))
            (let released (fmcl-release dissolved))
            (let continued (fmcl-continue-cell released "cut"
                (fmcl-persistence-off)))

            (let observed0 (fmcl-execute-with 0 fmclb-execute-wrong attempted))
            (let refined (fmcl-decide observed0))
            (let next-attempt (fmcl-next-attempt refined "counterexample"))
            (let observed-nothing
                (fmcl-execute-with 0 fmclb-execute-nothing attempted))
            (let observed-failure
                (fmcl-execute-with 0 fmclb-execute-failure attempted))
            (let invalid-model
                (fmcl-execute-with 0 fmclb-execute-invalid-model attempted))
            (let same-start (fmcl-discover "choice" 512 persistence continuation
                channel mesh))
            (let changed-start (fmcl-choose same-start "different-attempt"))

            (sum (list
                (fmclb-bit (and (eq (len categories) 12)
                    (and (eq (fmclb-distinct? categories) 1)
                         (fmclb-all-node-eq? categories expected))) 1)
                (fmclb-bit (and (str_eq (fmcl-scan-status scan) "ready")
                    (and (str_eq (fmcl-scan-concept scan) "choice")
                    (and (str_eq (fmcl-scan-attempt scan) "explain-choice")
                         (eq (fmcl-scan-position scan) (str_len surface))))) 2)
                (fmclb-bit (and (str_eq (fmcl-scan-status timed) "timeout")
                    (eq (fmcl-scan-position timed) 7)) 4)
                (fmclb-bit (and (str_eq (fmcl-stage start) "discover")
                    (and (nothing? (fmcl-concept-source
                            (fmcl-state-concept start)))
                         (nothing? (fmcl-concept-entry
                            (fmcl-state-concept start))))) 8)
                (fmclb-bit (and (str_eq (fmcl-stage chosen) "choose")
                    (and (node_eq (fmcl-attempt-concept
                            (fmcl-state-attempt chosen))
                            (fmcl-state-concept chosen))
                         (eq (fmcl-attempt-ordinal
                            (fmcl-state-attempt chosen)) 1))) 16)
                (fmclb-bit (and (eq (fmcl-request-scannerless?
                        (fmcl-state-request addressed)) 1)
                    (eq (fmcl-request-pretokenized?
                        (fmcl-state-request addressed)) 0)) 32)
                (fmclb-bit (and (node_eq (fmcl-concept-source
                            (fmcl-state-concept retrieved)) (fmclb-source))
                    (and (node_eq (fmcl-concept-entry
                            (fmcl-state-concept retrieved)) (fmclb-entry))
                         (not (nothing? (fmcl-state-observation retrieved))))) 64)
                (fmclb-bit (and (eq (fmcl-state-lookup-count retrieved) 1)
                    (eq (fmcl-trace-has? (fmcl-state-trace retrieved)
                        "cut") 1)) 128)
                (fmclb-bit (and (str_eq (fmcl-stage attempted) "attempt")
                    (and (not (nothing? (fmcl-state-request attempted)))
                    (and (not (nothing? (fmcl-concept-source
                            (fmcl-state-concept attempted))))
                         (not (nothing? (fmcl-concept-entry
                            (fmcl-state-concept attempted))))))) 256)
                (fmclb-bit (and (str_eq (fmcl-stage observed1) "observe")
                    (and (node_eq (node_category
                            (fmcl-state-execution observed1))
                            (fmcl-execution-category))
                         (node_eq (node_category
                            (fmcl-state-observation observed1))
                            (fmcl-observation-category)))) 512)
                (fmclb-bit (and (eq (fmcl-observed-verdict
                            (fmcl-state-execution observed0)) 0)
                         (not (nothing? (fmcl-observed-verdict
                            (fmcl-state-execution observed0))))) 1024)
                (fmclb-bit (and (eq (fmcl-observed-verdict
                            (fmcl-state-execution observed1)) 1)
                         (not (nothing? (fmcl-observed-verdict
                            (fmcl-state-execution observed1))))) 2048)
                (fmclb-bit (nothing? (fmcl-observed-verdict
                    (fmcl-state-execution observed-nothing))) 4096)
                (fmclb-bit (and (eq (fmcl-state-model-executed? observed1) 0)
                    (eq (fmcl-execution-model-executed?
                        (fmcl-state-execution observed1)) 0)) 8192)
                (fmclb-bit (and (str_eq (fmcl-status invalid-model) "failure")
                    (and (eq (fmcl-state-model-executed? invalid-model) 0)
                         (str_eq (fmcl-signal-kind
                            (fmcl-state-signal invalid-model)) "failure"))) 16384)
                (fmclb-bit (and (str_eq (fmcl-stage crystal) "crystallize")
                    (eq (fmcl-trace-has? (fmcl-state-trace crystal)
                        "crystallize") 1)) 32768)
                (fmclb-bit (and (str_eq (fmcl-stage refined) "refine")
                    (and (str_eq (fmcl-signal-kind
                            (fmcl-state-signal observed0)) "surprise")
                    (and (eq (fmcl-trace-has? (fmcl-state-trace refined)
                            "undo") 1)
                         (eq (fmcl-trace-has? (fmcl-state-trace refined)
                            "refine") 1)))) 65536)
                (fmclb-bit (and (str_eq (fmcl-signal-kind
                            (fmcl-state-signal observed-failure)) "failure")
                    (str_eq (fmcl-status observed-failure) "failure")) 131072)
                (fmclb-bit (and (eq (fmcl-attempt-ordinal
                            (fmcl-state-attempt next-attempt)) 2)
                    (node_eq (nth (node_children
                            (fmcl-state-attempt next-attempt)) 3)
                        (fmcl-state-attempt refined))) 262144)
                (fmclb-bit (and (str_eq (fmcl-stage dissolved) "dissolve")
                    (and (str_eq (fmcl-stage released) "release")
                    (and (eq (fmcl-trace-has? (fmcl-state-trace released)
                            "dissolve") 1)
                         (eq (fmcl-trace-has? (fmcl-state-trace released)
                            "release") 1)))) 524288)
                (fmclb-bit (and (eq (fmcl-continuation-generation
                            (fmcl-state-continuation continued)) 1)
                    (and (eq (fmcl-continuation-transported?
                            (fmcl-state-continuation continued)) 0)
                         (node_eq (nth (node_children
                            (fmcl-state-continuation continued)) 0) released)))
                    1048576)
                (fmclb-bit (and (node_eq (fmcl-state-channel continued) channel)
                    (eq (fmcl-channel-transported? channel) 0)) 2097152)
                (fmclb-bit (and (node_eq (fmcl-state-mesh continued) mesh)
                    (and (eq (fmcl-mesh-transported? mesh) 0)
                         (eq (fmcl-mesh-broadcast? mesh) 0))) 4194304)
                (fmclb-bit (and (eq (fmcl-persistence-requested?
                            (fmcl-state-persistence crystal)) 1)
                         (eq (fmcl-persistence-observed?
                            (fmcl-state-persistence crystal)) 0)) 8388608)
                (fmclb-bit (and (node_eq start same-start)
                    (not (node_eq chosen changed-start))) 16777216)
                (fmclb-bit (and (eq (fmcl-trace-has?
                            (fmcl-state-trace released) "discover") 1)
                    (and (eq (fmcl-trace-has? (fmcl-state-trace released)
                            "choice") 1)
                    (and (eq (fmcl-trace-has? (fmcl-state-trace released)
                            "retrieve") 1)
                    (and (eq (fmcl-trace-has? (fmcl-state-trace released)
                            "attempt") 1)
                    (and (eq (fmcl-trace-has? (fmcl-state-trace released)
                            "execute") 1)
                    (and (eq (fmcl-trace-has? (fmcl-state-trace released)
                            "observe") 1)
                    (and (eq (fmcl-trace-has? (fmcl-state-trace released)
                            "crystallize") 1)
                         (eq (fmcl-trace-has? (fmcl-state-trace released)
                            "release") 1)))))))) 33554432)))))

    (defn fmclb-all-node-eq? (left right)
        (if (nil? left) (if (nil? right) 1 0)
            (if (nil? right) 0
                (if (node_eq (head left) (head right))
                    (fmclb-all-node-eq? (tail left) (tail right)) 0))))

    (form-nodeid-mastery-cell-loop-band))
