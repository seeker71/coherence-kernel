; preludes: form/form-stdlib/ear-native.fk
; Expected: 63
; PROOF LEVEL: FKWU-STAGED — it preludes ear-native.fk, whose chain binds the carrier's metal
; natives; nothing here dispatches, but the three sibling kernels cannot resolve the chain.
;
; ear-heard-tongues-band — the tongues the ear listens for ARE the tongues the glass offers.
;
; They were not. enw-three was three tokens written by hand (en, fa, pt) under a comment that
; read "the three the glass offers" while the glass offered four, and the one left out was
; Indonesian — in a house that speaks Indonesian. The room's own spool holds 3692 en, 253 pt,
; 96 fa and zero id, and it could not have held any: a tongue absent from the shortlist is
; snapped to a listed one whenever it comes within 3 logits. A shortlist that is never asked
; where it came from cannot disagree with anything (corpus row 1416 heardshort).
;
; So the heard-token now lives in the SAME catalog row as the code and the name, and the ear
; reads it from there. One row, one truth.
;
; Verdict 63:
;   1   every tongue the catalog holds carries a heard-token — 32 of 32, none absent
;   2   every one of them falls inside the 99 logits the ear actually reads
;   4   Indonesian is among the tongues the ear listens for
;   8   Persian is too — the pair named on 2026-09-09
;   16  the ear's list IS the catalog's defaults, member for member, not a list of its own
;   32  a tongue the catalog does not hold has no token: an absence, never a plausible 50259
(do
    (defn ehb-all-tok? (rs) (if (eq (len rs) 0) 1 (if (lt (nth (head rs) 2) 0) 0 (ehb-all-tok? (tail rs)))))
    (defn ehb-in-window? (rs) (if (eq (len rs) 0) 1
        (do (let off (sub (nth (head rs) 2) (enw-lang-lo)))
            (if (or (lt off 0) (ge off 99)) 0 (ehb-in-window? (tail rs))))))
    (defn ehb-all-in? (xs ys) (if (eq (len xs) 0) 1 (if (eq (enw-has? ys (head xs)) 1) (ehb-all-in? (tail xs) ys) 0)))
    (let rows (tln-rows))
    (let want (tln-default-toks))
    (let got (enw-offered))
    (let c0 (if (and (eq (len rows) 32) (eq (ehb-all-tok? rows) 1)) 1 0))
    (let c1 (if (eq (ehb-in-window? rows) 1) 2 0))
    (let c2 (if (eq (enw-has? got (tln-heard-tok "id")) 1) 4 0))
    (let c3 (if (eq (enw-has? got (tln-heard-tok "fa")) 1) 8 0))
    (let c4 (if (and (eq (len got) (len want)) (and (eq (ehb-all-in? got want) 1) (eq (ehb-all-in? want got) 1))) 16 0))
    (let c5 (if (lt (tln-heard-tok "py") 0) 32 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
