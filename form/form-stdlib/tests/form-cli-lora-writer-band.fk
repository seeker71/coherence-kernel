; form-cli-lora-writer-band.fk — general-d A/B emit, apply, round-trip.
;
; Verdict 1023:
;   1..128  flw-check (d=3 identity, capability, write, parse, size, d=8, sample seed)
;   256     class descriptor FormLoraWriter minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/form-fs.fk
; preludes: form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-lora-writer-xtal.fk
; witnessed: 2026-08-26 -> 1023; d=3 identity 1000/2000/3000; file round-trip; d=8 sample seed

(do
    (defn flwb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn flwb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (flwb-has-name? (tail xs) name))))

    (let bits (flw-check))
    (let desc (FormLoraWriter))
    (let src (read_file "form/form-stdlib/bml/form-cli-lora-writer.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormLoraWriter")
                     (and (eq (flwb-has-name? (nth desc 2) "T") 1)
                          (and (eq (flwb-has-name? (nth desc 3) "flw-id-forward") 1)
                               (eq (flwb-has-name? (nth desc 4) "Scale") 1))))
                256 0))
    (let b9 (if (and (eq (flwb-has-str? src "package Form.cli.lorawriter") 1)
                     (and (eq (flwb-has-str? src "interface ILoraWriter") 1)
                          (and (eq (flwb-has-str? src "class FormLoraWriter") 1)
                               (and (eq (flwb-has-str? src "const int Scale") 1)
                                    (eq (flwb-has-str? src "template AdapterPair") 1)))))
                512 0))
    (add bits (add b8 b9)))
