; living-world-compost-witness.fk -- shared and dependent release fixture.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-compost.fk

(let LWCW-TARGET-KIND    (bp "LWCW-TARGET-KIND"))
(let LWCW-DEPENDENT-KIND (bp "LWCW-DEPENDENT-KIND"))
(let LWCW-ACTION         (bp "LWCW-ACTION"))

(defn lwcw-action () LWCW-ACTION)
(defn lwcw-interface () (lwo-interface (list LWCW-ACTION)))
(defn lwcw-source-a () (intern_trivial_string "lwcw-source-a"))
(defn lwcw-source-b () (intern_trivial_string "lwcw-source-b"))
(defn lwcw-source-c () (intern_trivial_string "lwcw-source-c"))
(defn lwcw-provenance-a () (intern_trivial_string "lwcw-provenance-a"))
(defn lwcw-provenance-b () (intern_trivial_string "lwcw-provenance-b"))
(defn lwcw-provenance-c () (intern_trivial_string "lwcw-provenance-c"))
(defn lwcw-response-provenance ()
    (intern_trivial_string "lwcw-response-provenance"))
(defn lwcw-target ()
    (lwo-compose LWCW-TARGET-KIND
        (list (intern_trivial_string "lwcw-held-value"))))
(defn lwcw-dependent ()
    (lwo-compose LWCW-DEPENDENT-KIND
        (list (intern_trivial_string "lwcw-context") (lwcw-target))))

(defn lwcw-offer (source payload provenance)
    (lwo-offer source (lwcw-interface) 1 payload provenance 1))
(defn lwcw-entry (source payload provenance)
    (lwt-entry (lwcw-offer source payload provenance) (lwcw-action)))

(defn lwcw-base-world ()
    (lwt-receive-stream (lwo-empty-world)
        (list
            (lwcw-entry (lwcw-source-a) (lwcw-target)
                        (lwcw-provenance-a))
            (lwcw-entry (lwcw-source-b) (lwcw-target)
                        (lwcw-provenance-b))
            (lwcw-entry (lwcw-source-c) (lwcw-dependent)
                        (lwcw-provenance-c)))))

(defn lwcw-revocation (target source provenance name)
    (lwo-revocation target source (intern_trivial_string name) provenance))
(defn lwcw-release-a (world)
    (lwt-receive-stream world
        (list (lwcw-entry (lwcw-source-a)
            (lwcw-revocation (lwcw-target) (lwcw-source-a)
                (lwcw-provenance-a) "lwcw-release-a")
            (lwcw-provenance-a)))))
(defn lwcw-release-b (world)
    (lwt-receive-stream world
        (list (lwcw-entry (lwcw-source-b)
            (lwcw-revocation (lwcw-target) (lwcw-source-b)
                (lwcw-provenance-b) "lwcw-release-b")
            (lwcw-provenance-b)))))
(defn lwcw-release-dependent (world)
    (lwt-receive-stream world
        (list (lwcw-entry (lwcw-source-c)
            (lwcw-revocation (lwcw-dependent) (lwcw-source-c)
                (lwcw-provenance-c) "lwcw-release-dependent")
            (lwcw-provenance-c)))))

(defn lwcw-yes-response (proposal)
    (lwt-response proposal (oac-one (lwt-proposal-candidate proposal))
                  (lwcw-response-provenance)))
(defn lwcw-yes-entry (source provenance proposal)
    (lwcw-entry source (lwcw-yes-response proposal) provenance))
(defn lwcw-partial-response-world (world proposal)
    (lwt-receive-stream world
        (list
            (lwcw-yes-entry (lwcw-source-a) (lwcw-provenance-a) proposal)
            (lwcw-yes-entry (lwcw-source-b) (lwcw-provenance-b) proposal))))
(defn lwcw-unanimous-response-world (partial proposal)
    (lwt-receive-stream partial
        (list (lwcw-yes-entry
            (lwcw-source-c) (lwcw-provenance-c) proposal))))

(defn lwcw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwcw-sum (tail items)))))
