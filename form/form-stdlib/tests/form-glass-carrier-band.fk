; Compile the actual supervisor functions without starting its live fleet.
; Temporary fixture only; verify invalid PIDs never enter host_wait/host_kill.
; Expected: 15.
; preludes: form-stdlib/form-glass-launch.bml
(do
    (let source (read_file "observe/form-glass-run.fk"))
    (let split (str_find source "\n    (let niced" 0))
    (let stem (str_concat (temp_dir) (str_concat "/glass-carrier-band-" (int_to_str (now_unix_ms)))))
    (let path (str_concat stem ".fk"))
    (let wrote (if (gt split 0) (write_file_text path (str_concat (substring source 0 split) "\n    (list (fgr-stop -1) (fgr-stop 0) (fgr-end -1 0 -1)))")) -1))
    (let status (if (ge wrote 0) (host_wait (host_spawn_quiet (list "./fkwu" path))) -1))
    (let output (if (eq status 0) (host_capture (list "./fkwu" path)) ""))
    (let removed (fs-remove-file path))
    (let image (fs-remove-file (str_concat stem ".fkb")))
    (let sym (fs-remove-file (str_concat stem ".sym")))
    (sum (list
        (if (gt split 0) 1 0)
        (if (eq status 0) 2 0)
        (if (str_eq (trim output) "[-1, -1, 0]") 4 0)
        (if (and (ge (str_find (fglu-dependency-manifest) "observe/form-glass-machine-live.fk" 0) 0)
                 (ge (str_find source "fgr-loop sensors machine organs 1" 0) 0)) 8 0))))
