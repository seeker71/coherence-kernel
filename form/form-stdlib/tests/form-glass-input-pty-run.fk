; Real terminal acquisition and the production Glass decoder/controller.
; No sensor fleet, shared telemetry write or fake acknowledgement.
; preflight-exec: forbidden
; preludes: form/form-stdlib/form-glass-live.bml
(do
  (defn gkp-loop (control)
    (do
      (let wait (host_sleep_ms (list 5000)))
      (let bytes (fgki-read))
      (if (nothing? bytes) (do (fgki-close) (print "INPUT-CLOSED"))
        (do
          (let next (fgl-input-feed control (list (fgl-monitor-sample 1000)) bytes 0 (now_unix_ms)))
          (let shown (if (gt (str_len bytes) 0) (print (list "KEY-STATE" (fgl-control-view next) (fgl-control-filter next) (fgl-control-selected next) (fgl-control-evidence-open? next) (fgki-mode (fgl-input-state next)) (fgki-serial (fgl-input-state next)) (fgl-wait-woke wait))) 0))
          (if (eq (fgl-control-quit? next) 1) (do (fgki-close) (print "RESTORED")) (gkp-loop next))))))
  (let opened (fgki-open))
  (print (list "INPUT-READY" opened))
  (if (eq opened 1) (gkp-loop (fgl-control-state "all" "none" 0 "held")) (print "NON-TTY"))
  0)
