; qwen35-form-layer-band.fk — the Form teaching layer is a latch, not a GGUF edit.
;
; preludes: form-stdlib/qwen35-form-layer.fk
;
; Four-way: no model file is opened. Chat-id wrapping against the sealed GGUF
; is a live generate concern, not this band.
;
; Verdict 1023 when every claim holds.

(do
    (defn qflb (ok bit) (if ok bit 0))
    (let sys (qfl-system-text))
    (let wrapped (qfl-wrapped-prompt "hello"))
    (sum (list
        (qflb (eq (len (qfl-controls)) 8) 1)
        (qflb (str_eq (qfl-ctl-tag (qfl-ctl-locate "timeout")) "<TIMEOUT>") 2)
        (qflb (eq (len (qfl-concepts)) 11) 4)
        (qflb (eq (qfl-has? "Blueprint") 1) 8)
        (qflb (eq (qfl-has? "Cell") 1) 16)
        (qflb (eq (qfl-has? "NL-to-form") 1) 32)
        (qflb (ge (str_find sys "<CHOICE>" 0) 0) 64)
        (qflb (ge (str_find sys "form-cli" 0) 0) 128)
        (qflb (eq (str_find wrapped (qfl-system-text) 0) 0) 256)
        (qflb (eq (qfl-on-text? "") 0) 512))))
