// Native build working memory is isolated; the parent and sealed source stay intact.
import form-stdlib/bml/form-cli-build.bml;
section [form.bml] {
 class FormCliBuildStoreBand {
 def build-store-proof() {
 let root = host_cwd() ++ "/.hearth/build-store-band-" ++ host_pid().str();
 let made = hch-mkdirs(root);
 defer host_dir_rmdir(root);
 let before = kernel_live(host_pid())[22];
 let source = "(do (let x (intern_trivial_int 7071)) (print (list \"store\" (nth (kernel_live (host_pid)) 22) \"private\" (eq (kernel_stat 58) (kernel_stat 4)) \"field\" (kernel_stat 59) \"owned\" (kernel_stat 60) \"value\" (node_value x))) 0)\n";
 let path = root ++ "/source.fk";
 let written = write_file(path,source);
 let isolated = fcb-private-store(root);
 isolated ? 0 : form_error("private build child configuration unavailable");
 let child = hch-run-at(root,"private-child",root,[host_cwd() ++ "/fkwu",path],"",hch-by(60000));
 let expected = "[store, 0, private, 1, field, 0, owned, 0, value, 7071]";
 isolated && hch-ok?(child) && fcb-has?(child[1],expected) ? print_str("pass compiler cwd selects private native storage") : form_error("private build child storage differs: " ++ child[1]);
 (read_file(path) ?? "") == source && kernel_live(host_pid())[22] == before ? print_str("pass source bytes and parent storage stay intact") : form_error("private build changed source or parent storage");
 let proof = fcb-check-dir(root ++ "/proof");
 let checked = hch-run-at(root,"proof-child",proof,[host_cwd() ++ "/fkwu",path],"",hch-by(60000));
 hch-ok?(checked) && fcb-has?(checked[1],expected) ? print_str("pass proof cwd selects private native storage") : form_error("private build proof storage differs: " ++ checked[1]);
 !fcb-private-store(root ++ "/absent") ? print_str("pass missing configuration destination refuses admission") : form_error("private build accepted an absent configuration destination");
 print(["build-store", "parent-mode", before, "checks", 4, "model_calls", 0]);
 }
 }
 build-store-proof();
}
