; form-glass-live-rate-band.fk — the doing line distinguishes a live interval
; from a boot average, and an old owner token from an active stall.
;
; Verdict 63: centi-MB/s from two driver samples one second apart, unit, render, fresh stall, stale name, no lie.
; preludes: form-stdlib/form-glass-live.bml

(do
    (defn fglrb-bit (ok bit) (if ok bit 0))
    (let before (list (fgl-host-clock-row 0) (fgo-disk-count-row "disk-bytes-read" "disk bytes read" 0 "bytes" "") (fgo-disk-count-row "disk-bytes-written" "disk bytes written" 0 "bytes" "") (fgo-disk-count-row "disk-ops" "disk operations" 0 "ops" "")))
    (let after (list (fgo-disk-count-row "disk-bytes-read" "disk bytes read" 94372 "bytes" "") (fgo-disk-count-row "disk-bytes-written" "disk bytes written" 0 "bytes" "") (fgo-disk-count-row "disk-ops" "disk operations" 5 "ops" "")))
    (let disk (head (fgl-disk-rate-rows before after 1000)))
    (let parent (FGLUIQwenOwnerParent))
    (let token (fgtm-sample "tokens.qwen.position" (fgtm-present parent)
        "token-position" "metal" parent "reasoning" "context-position"
        (fgtm-absent) (fgtm-present 22) "active"
        (fgtm-present 1000) (fgtm-present 1000) (fgtm-absent)
        (fgtm-present 1) "unknown" "physical-live" "fixture"
        (list "model" "token")))
    (let fresh (fglat-token-stall-text (list token) 2000))
    (let stale (fglat-token-stall-text (list token) 7001))
    (sum (list
        (fglrb-bit (eq (fgo-int-value disk) 9) 1)
        (fglrb-bit (str_eq (fgo-unit disk) "centi-MB/s") 2)
        (fglrb-bit (str_eq (fglat-disk-rate-text disk (list)) "0.09MB/s") 4)
        (fglrb-bit (ge (str_find fresh "stall=" 0) 0) 8)
        (fglrb-bit (ge (str_find stale "T=stale age=" 0) 0) 16)
        (fglrb-bit (eq (str_find stale "stall=" 0) -1) 32))))
