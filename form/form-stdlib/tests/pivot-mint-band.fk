; pivot-mint-band.fk — proves form-stdlib/pivot-mint.fk's pivot-mint(mid, en,
; id): the row text it mints must equal, character for character, the row
; R12 already hand-appended to nl-lexicon-data.fk. Fixture is the literal
; text of all five m1257..m1261 rows, typed here (not re-derived through
; nlt-corpus-lexicon or any other reader of that file), so the band proves
; pivot-mint's own shape against the row as it stands on disk, never
; against itself.
;
; Verdict 31 (five bits), one per row minted 2026-09-03:
;   1   m1257 twicegrown / tumbuhdua
;   2   m1258 seatrace   / balapkursi
;   4   m1259 afterwall  / pascatembok
;   8   m1260 keloid     / keloid
;   16  m1261 seedshell  / cangkangbenih
;
; preludes: form-stdlib/core.fk form-stdlib/pivot-mint.fk
;
; run: ./fkwu form/form-stdlib/tests/pivot-mint-band.fk    ; -> 31

(do
    (defn pmb-chk (mid en id expected bit)
        (if (str_eq (pivot-mint mid en id) expected) bit 0))
    (defn pivot-mint-band ()
        (add
            (pmb-chk 1257 "twicegrown" "tumbuhdua"
                "            (list \"m1257\" \"gas\" \"twicegrown\" \"tumbuhdua\")\n" 1)
        (add
            (pmb-chk 1258 "seatrace" "balapkursi"
                "            (list \"m1258\" \"gas\" \"seatrace\" \"balapkursi\")\n" 2)
        (add
            (pmb-chk 1259 "afterwall" "pascatembok"
                "            (list \"m1259\" \"gas\" \"afterwall\" \"pascatembok\")\n" 4)
        (add
            (pmb-chk 1260 "keloid" "keloid"
                "            (list \"m1260\" \"gas\" \"keloid\" \"keloid\")\n" 8)
            (pmb-chk 1261 "seedshell" "cangkangbenih"
                "            (list \"m1261\" \"gas\" \"seedshell\" \"cangkangbenih\")\n" 16))))))
    (pivot-mint-band))
