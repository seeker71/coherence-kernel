// envelope-hold-band.bml — the voice's walk held by the reply envelope (form-cli-native-voice.bml fcnv-envelope-held-by,
// form-cli-recipe-exec-session.fk frxs-held), with a scripted voice: ids are bytes plus 1000, 0 is the stop and the
// close, and the candidates are a scripted top-k. No model, GPU or ledger opens.
// Verdict 511 when every claim lands:
//   1   the walk's hook passes an id through a context with no hold, and a record's hold answers the id it commits
//   2   a whole reply proposed greedily walks held to end with no exchange, and the candidates are never asked
//   4   a raw newline inside a JSON string is exchanged for the first candidate that holds, its escape
//   8   a stop inside a block, or before <plan> and its witness close, is exchanged; a stop once they have is kept
//   16  when no candidate holds, the walk commits the close, counts one end, and passes later ids through
//   32  a voice that repeats its cases runs unheld to the step limit; held, it closes after eight cases and stops,
//       and its reply is the plan and the eight-case envelope byte for byte
//   64  an end names where it cut the reply: the block, between blocks, or that the candidates did not answer; an end
//       where a stop may stand cuts nothing; the planner refuses a cut reply as envelope-ended
//   128 the planner's request carries the envelope, its reply budget (6144) and coverage after-verdict, and the voice
//       door reads all three; an interceptor with no observer walks with the silent one
//   256 a held result carries its reading after the ownership and reused prefix ids (fcnv-metadata): an opened ask's
//       read released and 0, a resident turn's keep its own, and a result the envelope did not hold reads none
import form/form-stdlib/bml/form-cli-native-voice.bml;
import form/form-stdlib/bml/form-cli-local-plan.bml;
section [form.bml] {
 class EnvelopeHoldBand {
  def ehb-id(b) = b + 1000;
  def ehb-text(id) = id == 1010 ? "\n" : id >= 1032 && id <= 1126 ? renv-chr(id - 1000) : "";
  def ehb-stop?(id) = id == 0;
  def ehb-ids(text) = ehb-ids-at(text, len(text) - 1, []);
  def ehb-ids-at(text, i, out) = i < 0 ? out : ehb-ids-at(text, i - 1, cons(ehb-id(str_byte_at(text, i)), out));
  def ehb-case() = "{\"function\":\"f\",\"arguments\":[1],\"equals\":2}";
  def ehb-cases(n) = n <= 1 ? ehb-case() : ehb-case() ++ "," ++ ehb-cases(n - 1);
  def ehb-repeat(s, n) = n <= 0 ? "" : s ++ ehb-repeat(s, n - 1);
  def ehb-plan() = "<plan>{\"id\":\"g\"}</plan>\n";
  def ehb-whole() = ehb-plan() ++ "<goal>f doubles.</goal>\n<cases>[" ++ ehb-case() ++ "]</cases>\n<reference>def f(a) = a * 2;</reference>";
  // a record answers 0 for a key it never held
  def ehb-asked(cursor) = () => { record_set(cursor, "asked", record_get(cursor, "asked") + 1); append(ehb-ids("]"), append([0], ehb-ids("</cases>"))); };
  def ehb-step(cursor, id, found) = fcnv-envelope-held-by(cursor, id, ehb-text, ehb-stop?, found, 0);
  // a greedy voice proposes the next byte of wish at the reply's length; held or not, each step commits one id
  def ehb-walk(cursor, wish, held, step, limit, out) {
   step >= limit ? [out, "limit"] : {
    let proposed = len(out) < len(wish) ? ehb-id(str_byte_at(wish, len(out))) : 0;
    let id = held ? ehb-step(cursor, proposed, ehb-asked(cursor)) : proposed;
    id == 0 ? [out, "stop"] : ehb-walk(cursor, wish, held, step + 1, limit, out ++ ehb-text(id));
   };
  }
  def ehb-feed(cursor, text) = foldl((c, id) => { ehb-step(c, id, ehb-asked(c)); c; }, cursor, ehb-ids(text));
  def ehb-observe() {
   let held = record_new(0);
   record_set(held, "hold", (s, id) => id + 1);
   let c1 = frxs-held(0, nothing(), 7) == 7 && frxs-held(record_new(0), nothing(), 7) == 7 && frxs-held(held, nothing(), 7) == 8 ? 1 : 0;

   let w = fcnv-envelope-cursor();
   let walked = ehb-walk(w, ehb-whole(), true, 0, 1000, "");
   let c2 = (String) walked[1] == "stop" && (String) walked[0] == ehb-whole() && (String) renv-mode(record_get(w, "envelope")) == "end" && record_get(w, "envelope-swaps") == 0 && record_get(w, "asked") == 0 ? 2 : 0;
   let n = ehb-feed(fcnv-envelope-cursor(), "<cases>[{\"call\":\"a");
   let swapped = fcnv-envelope-held-by(n, ehb-id(10), ehb-text, ehb-stop?, () => ehb-ids("\n\\x"), 0);
   let c4 = swapped == ehb-id(92) && record_get(n, "envelope-swaps") == 1 ? 4 : 0;
   let inside = ehb-feed(fcnv-envelope-cursor(), "<goal>half");
   let kept = fcnv-envelope-held-by(inside, 0, ehb-text, ehb-stop?, () => append([0], ehb-ids(".")), 0);
   let early = ehb-feed(fcnv-envelope-cursor(), "<goal>half</goal>");
   let opened = fcnv-envelope-held-by(early, 0, ehb-text, ehb-stop?, () => append([0], ehb-ids("<")), 0);
   let between = ehb-feed(fcnv-envelope-cursor(), ehb-plan() ++ "<band>(do 1)</band>");
   let c8 = kept == ehb-id(46) && opened == ehb-id(60) && fcnv-envelope-held-by(between, 0, ehb-text, ehb-stop?, () => ehb-ids("x"), 0) == 0 && record_get(between, "envelope-swaps") == 0 ? 8 : 0;
   let dead = ehb-feed(fcnv-envelope-cursor(), "<plan>{");
   let closed = fcnv-envelope-held-by(dead, ehb-id(120), ehb-text, ehb-stop?, () => append(ehb-ids("x]"), [0]), 0);
   let c16 = closed == 0 && record_get(dead, "envelope-ends") == 1 && (String) renv-mode(record_get(dead, "envelope")) == "broken" && fcnv-envelope-held-by(dead, ehb-id(120), ehb-text, ehb-stop?, () => [], 0) == ehb-id(120) ? 16 : 0;
   let wish = ehb-plan() ++ "<cases>[" ++ ehb-repeat(ehb-case() ++ ",", 60);
   let unheld = ehb-walk(record_new(0), wish, false, 0, 2000, "");
   let r = fcnv-envelope-cursor();
   let runaway = ehb-walk(r, wish, true, 0, 2000, "");
   let c32 = (String) unheld[1] == "limit" && (String) runaway[1] == "stop" && (String) runaway[0] == ehb-plan() ++ "<cases>[" ++ ehb-cases(8) ++ "]</cases>" && record_get(r, "envelope-ends") == 0 ? 32 : 0;
   let gone = ehb-feed(fcnv-envelope-cursor(), "<goal>half</goal>");
   let left = fcnv-envelope-held-by(gone, ehb-id(120), ehb-text, ehb-stop?, () => ehb-ids("x"), 0);
   let blind = ehb-feed(fcnv-envelope-cursor(), "<cases>[");
   let unread = fcnv-envelope-held-by(blind, ehb-id(120), ehb-text, ehb-stop?, () => [], 0);
   let done = ehb-feed(fcnv-envelope-cursor(), ehb-plan() ++ "<band>(do 1)</band>");
   let stood = fcnv-envelope-held-by(done, ehb-id(120), ehb-text, ehb-stop?, () => ehb-ids("x"), 0);
   let c64 = (String) record_get(dead, "envelope-cut") == "<plan>" && (String) record_get(gone, "envelope-cut") == "<between>" && (String) record_get(blind, "envelope-cut") == "candidates-unavailable"
    && stood == 0 && (String) record_get(done, "envelope-cut") == "" && (String) flp-envelope-refusal(fcnv-envelope-reading(dead))[0] == "envelope-ended" && nothing?(flp-envelope-refusal(fcnv-envelope-reading(done))) && nothing?(flp-envelope-refusal(nothing())) ? 64 : 0;
   let asked = flp-voice-request("qwen38-q8", 3072, flp-reply-budget(), "plan request r option 1", nothing());
   let quiet = ftg-intercept-with(512, nothing());
   let heard = ftg-intercept-with(512, nothing());
   record_set(heard, "observer", (stage, phase, c, generated) => 5);
   let c128 = fcnv-budget(asked) == 6144 && (String) fcnv-envelope(asked) == "local-plan" && fcnv-after-verdict?(asked) && nothing?(fcnv-budget(json-node-object([fhn-s("model", "qwen38-q8")])))
    && ftg-observer(quiet)("run", "begin", 0, 0) == 0 && ftg-observer(heard)("run", "begin", 0, 0) == 5 ? 128 : 0;
   // an opened ask's result is fifteen long (fcnv-admitted); a resident turn's names its ownership and reused ids after
   let opened = fcnv-admitted(fcnv-clocked(fcnv-none("unavailable", "p", "r"), 0, 0), nothing(), nothing());
   let resident = append(opened, ["resident", 12]);
   let reading = ["end", 0, 0, "", 0];
   let heldOpen = fcnv-enveloped(opened, reading);
   let heldResident = fcnv-enveloped(resident, reading);
   let c256 = nothing?(fcnv-envelope-of(opened)) && nothing?(fcnv-envelope-of(resident)) && nothing?(fcnv-envelope-of(fcnv-enveloped(resident, nothing())))
    && fcnv-envelope-of(heldOpen) == reading && (String) fcnv-ownership(heldOpen) == "released" && fcnv-reused-ids(heldOpen) == 0
    && fcnv-envelope-of(heldResident) == reading && (String) fcnv-ownership(heldResident) == "resident" && fcnv-reused-ids(heldResident) == 12 ? 256 : 0;
   print(["envelope-hold", c1, c2, c4, c8, c16, c32, c64, c128, c256, record_get(r, "envelope-swaps"), len(runaway[0]), len(unheld[0])]);
   c1 + c2 + c4 + c8 + c16 + c32 + c64 + c128 + c256;
  }
 }
 let verdict = ehb-observe();
 verdict == 511 ? verdict : form_error("the envelope hold read " + verdict.str() + " of 511");
}
