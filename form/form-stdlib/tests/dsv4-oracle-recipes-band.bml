; dsv4-oracle-recipes-band.bml — the Form-native DeepSeek V4 reference arithmetic answers to the body's own carvers, its
; tensor-view geometry holds, its request admission refuses what it must, and its in-RAM native input organ plans a
; real model's tensors from the header alone.
;
; WHAT THIS PINS. dsv4-oracle-reference.bml is the independent fp64 reference the GPU programs are checked against (it
; replaced a 1,212-line Python oracle in 17f19c8b9). Its recipes were written from ds4.c, apart from the body's carvers
; (f16-decode.fk, mxfp4-plane-dequant.fk, mxfp8-plane-dequant.fk). Two hands, one answer is the witness: bits 2 to 32 hold
; the oracle's decoders and its ordered group dots equal the carvers' on every code and on the real fixture bytes. No
; model file is mapped by any bit; bits 1024 and 2048 read the model's HEADER (and the door answers from it), never a
; weight.
;
; Verdict 16383 when every claim lands:
;   1     dfo-pow2 is exact: 2^10, 2^0, 2^-3, 2^-24 and 2^100 equal their values
;   2     dfo-f16 equals the body's fd-f16 at every 29th half pattern outside the NaN/infinity exponent, and at four pins
;         (0x3C00 is 1, 0xC000 is -2, 0x7BFF is 65504, 0x0001 is 2^-24)
;   4     dfo-e2m1 equals fd-value(c, 2, 1) at all sixteen codes, and the eight magnitudes are 0, 0.5, 1, 1.5, 2, 3, 4, 6
;   8     dfo-e4m3 equals mxp8-code-value at every code but the two NaNs, and 0x7E is 448, 0x38 is 1, 0x01 is 2^-9
;   16    the oracle's MXFP8 group dot of 128 real fixture weights against a varying x equals the carver's weight-by-weight sum
;   32    the oracle's MXFP4 group dot of 128 real fixture weights against a varying x equals the carver's sum
;   64    round to nearest even: f16 ties (1 + 2^-11 reads 1; 1 + 3 * 2^-11 reads 1 + 2^-9), saturation (65520 reads 65504),
;         f32 (1 + 2^-24 reads 1), e4m3 ties (1.0625 reads 1, 1.1875 reads 1.25, -1.0625 reads -1) and saturation (500 reads 448)
;   128   tensor view geometry: a view starts on a page and spans whole pages (inside a page, across a page boundary, exactly
;         one page) and refuses a tensor past the file's extent, a span over the device maximum and a page over the maximum
;   256   extents never wrap: 2^31 * (2^31 - 1) is exact, 2^31 * 2^31 and 2^62 + 2^62 read nothing, and -1 is no natural
;   512   request admission accepts one complete stack request and refuses, each with its own reason, an eleven-field one, a wrong
;         header, a negative token, an unknown mode, a zero layer count, a sequence not ending at the requested position, and a
;         single-layer request that carries a state rounding; env:1 reads as rounding on
;   1024  the plan of the real model reads its header only: 1,406 tensors in the order the file lists them, each view page
;         aligned and whole-tensor, the largest tensor 1,140,850,688 bytes, the file 91,321,404,640 bytes
;   2048  the door answers from the header through the in-RAM native stdin organ: a complete tensor-view request writes the
;         plan (PLAN_EXTENT, 1,406 views) and ends TVDONE 1406 0; a request missing its last NUL is refused and writes nothing
;   4096  the retention door archives a small quiescent directory (a binary file, a name with a space) and reads the archive back
;         (tar lists both, the text extracts intact); it refuses an archive that already exists (the file is left byte for
;         byte) and an archive inside the source (nothing is written there)
;   8192  the native ordered fp64 matrix door (observe/native-fp64-matrix-run.bml) exits 0 and reads healthy on all three aspects:
;         ordered arithmetic equal to the independent scalar reference over every E4M3 and E8M0 byte, 256 repeated calls on one
;         residency, release and refusal of a foreign, stale or short request
;
; PROOF LEVEL: FOURTH-ARM ONLY -- bits 1024 and 2048 read the model file's header (a host-local path outside the tree) and the
; door carries a Darwin ARM64 in-RAM native organ (jit_leaf_inram) that no sibling kernel answers. The pure bits (1..512) have
; not been run on the siblings.
; The band writes only under temp_dir and removes what it made.
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/f16-decode.fk form-stdlib/mxfp4-plane-dequant.fk form-stdlib/mxfp8-plane-dequant.fk form-stdlib/model-registry.bml form-stdlib/bml/dsv4-tensor-views-input.bml
section [form.bml] {
 class Dsv4OracleRecipesBand {
  def dorb-bit(held, bit) = held ? bit : 0;
  def dorb-near(a, b) = abs(a - b) <= (0.000000000001 * (1.0 + abs(b)));
  def dorb-ones(n) = n == 0 ? [] : cons(1.0, dorb-ones(n - 1));
  // a varying x so a misaligned element shows: (-6..6)/4
  def dorb-x(i, n) = i == n ? [] : cons(((((i * 7) % 13) - 6) + 0.0) / 4.0, dorb-x(i + 1, n));
  def dorb-has?(s, part) = str_find(s, part, 0) >= 0;

  // ---- 1: dfo-pow2
  def dorb-pow2() = dfo-pow2(10) == 1024.0 && dfo-pow2(0) == 1.0 && dfo-pow2(-3) == 0.125 && dfo-pow2(-24) == (1.0 / 16777216.0) && dfo-pow2(100) == (1024.0 * 1024.0 * 1024.0 * 1024.0 * 1024.0 * 1024.0 * 1024.0 * 1024.0 * 1024.0 * 1024.0);

  // ---- 2: f16
  def dorb-f16-sweep(bits) = bits >= 65536 ? 1 : (((bits / 1024) % 32) == 31 || dfo-f16(bits) == fd-f16(bits)) ? dorb-f16-sweep(bits + 29) : 0;
  def dorb-f16() = dorb-f16-sweep(0) == 1 && dfo-f16(15360) == 1.0 && dfo-f16(49152) == -2.0 && dfo-f16(31743) == 65504.0 && dfo-f16(1) == (1.0 / 16777216.0);

  // ---- 4: e2m1
  def dorb-e2m1-all(c) = c == 16 ? 1 : (dfo-e2m1(c) == fd-value(c, 2, 1) ? dorb-e2m1-all(c + 1) : 0);
  def dorb-e2m1() = dorb-e2m1-all(0) == 1 && [dfo-e2m1(0), dfo-e2m1(1), dfo-e2m1(2), dfo-e2m1(3), dfo-e2m1(4), dfo-e2m1(5), dfo-e2m1(6), dfo-e2m1(7)] == [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0] && dfo-e2m1(15) == -6.0;

  // ---- 8: e4m3
  def dorb-e4m3-all(b) = b == 256 ? 1 : ((b == 127 || b == 255 || dfo-e4m3(b) == mxp8-code-value(b)) ? dorb-e4m3-all(b + 1) : 0);
  def dorb-e4m3() = dorb-e4m3-all(0) == 1 && dfo-e4m3(126) == 448.0 && dfo-e4m3(56) == 1.0 && dfo-e4m3(1) == (1.0 / 512.0);

  // ---- 16, 32: the ordered group dots against the carvers, on the real fixture bytes
  def dorb-mx8-sum(src, i, n, x) = i == n ? 0.0 : (mxp8-at(src, 0, 1024, i) * x[i]) + dorb-mx8-sum(src, i + 1, n, x);
  def dorb-mx4-sum(src, i, n, x) = i == n ? 0.0 : (mxp4-at(src, 0, 1024, i) * x[i]) + dorb-mx4-sum(src, i + 1, n, x);
  def dorb-mx8() {
   let src = read_file_slice("form/form-stdlib/tests/fixtures/mxfp8-plane-1024.bin", 0, 1056);
   let x = dorb-x(0, 128);
   let oracle = dfo-mx8-groups(substring(src, 0, 1024), substring(src, 1024, 1056), 0, x, 0, 4, 0.0);
   str_len(src) == 1056 && dorb-near(oracle, dorb-mx8-sum(src, 0, 128, x)) && abs(oracle) > 0.0;
  }
  def dorb-mx4() {
   let src = read_file_slice("form/form-stdlib/tests/fixtures/mxfp4-plane-1024.bin", 0, 544);
   let x = dorb-x(0, 128);
   let oracle = dfo-mx4-groups(substring(src, 0, 512), substring(src, 512, 544), 0, x, 0, 4, 0.0);
   str_len(src) == 544 && dorb-near(oracle, dorb-mx4-sum(src, 0, 128, x)) && abs(oracle) > 0.0;
  }

  // ---- 64: rounding
  def dorb-round() {
   let step = 1.0 / 2048.0;
   dfo-round16(1.0 + step) == 1.0 && dfo-round16(1.0 + (3.0 * step)) == 1.001953125 && dfo-round16(65520.0) == 65504.0
    && dfo-round32(1.0 + (1.0 / 16777216.0)) == 1.0 && dfo-round8(1.0625) == 1.0 && dfo-round8(1.1875) == 1.25
    && dfo-round8(-1.0625) == -1.0 && dfo-round8(500.0) == 448.0;
  }

  // ---- 128: tensor view geometry (start, span, inner), refusals through try
  def dorb-view-refused(at, bytes, extent, maximum, page) = try (dtv-view(at, bytes, extent, maximum, page) == []) catch true;
  def dorb-views() {
   let inside = dtv-view(16385, 100, 1000000, 65536, 16384);
   let across = dtv-view(16380, 100, 1000000, 65536, 16384);
   let exact = dtv-view(32768, 16384, 1000000, 65536, 16384);
   inside == [16384, 16384, 1] && across == [0, 32768, 16380] && exact == [32768, 16384, 0]
    && dorb-view-refused(999950, 100, 1000000, 65536, 16384) && dorb-view-refused(0, 70000, 1000000, 65536, 16384)
    && dorb-view-refused(0, 100, 1000000, 8192, 16384) && !dtv-geometry-good(8192, 16384) && dtv-geometry-good(16384, 16384);
  }

  // ---- 256: extents
  def dorb-extents() = dfo-product(2147483648, 2147483647) == 4611686016279904256 && nothing?(dfo-product(2147483648, 2147483648))
   && nothing?(dfo-sum(4611686018427387903, 1)) && dfo-sum(4611686018427387900, 3) == 4611686018427387903 && !dfo-natural(-1) && dfo-natural(0);

  // ---- 512: request admission
  def dorb-fields(token, pos, count, mode, f32, seq) = ["DFO1", "/m/model.gguf", token, pos, count, mode, "", f32, "0", "0", seq, "END"];
  def dorb-refuses(request) = record_get(request, "ready") == 0 ? record_get(request, "reason") : "";
  def dorb-admission() {
   let good = dqi-parse(dorb-fields("5", "0", "3", "stack", "0", ""));
   let sequence = dqi-parse(dorb-fields("5", "1", "2", "stack", "0", "5 9"));
   let rounding = dqi-parse(dorb-fields("5", "0", "3", "stack", "env:1", ""));
   record_get(good, "ready") == 1 && record_get(good, "token") == 5 && record_get(good, "mode") == "stack" && record_get(good, "count") == 3
    && record_get(sequence, "ready") == 1 && record_get(sequence, "tokens") == [5, 9] && record_get(rounding, "f32") == 1
    && dorb-refuses(dqi-parse(["DFO1", "/m/model.gguf", "5", "0", "3", "stack", "", "0", "0", "0", "END"])) == "exactly twelve complete text fields required"
    && dorb-refuses(dqi-parse(["DFO9", "/m/model.gguf", "5", "0", "3", "stack", "", "0", "0", "0", "", "END"])) == "oracle request framing"
    && dorb-refuses(dqi-parse(dorb-fields("-1", "0", "3", "stack", "0", ""))) == "typed finite numeric request fields"
    && dorb-refuses(dqi-parse(dorb-fields("5", "0", "3", "bogus", "0", ""))) == "unknown oracle mode"
    && dorb-refuses(dqi-parse(dorb-fields("5", "0", "0", "stack", "0", ""))) == "positive stack layer count required"
    && dorb-refuses(dqi-parse(dorb-fields("5", "0", "3", "stack", "0", "5 9"))) == "sequence must end at requested position"
    && !dorb-has?(dorb-refuses(dqi-parse(dorb-fields("5", "0", "3", "layer", "1", ""))), "complete");
  }

  // ---- 1024: the plan of the real model, header only
  def dorb-plan-ok(rows, extent, page, i, n) = i == n ? 1 : ((nth(nth(rows, i), 6) % page) == 0 && (nth(nth(rows, i), 7) % page) == 0 && nth(nth(rows, i), 7) >= nth(nth(rows, i), 2) && (nth(nth(rows, i), 6) + nth(nth(rows, i), 7)) <= (extent + page)) ? dorb-plan-ok(rows, extent, page, i + 1, n) : 0;
  def dorb-plan() {
   let path = mr-path(mr-find("ds4flash"));
   let plan = dtv-plan(path, 17179869184, 16384);
   let rows = record_get(plan, "rows");
   len(rows) == 1406 && record_get(plan, "extent") == 91321404640 && record_get(plan, "max-bytes") == 1140850688
    && record_get(plan, "mapped") == 91321417728 && dorb-plan-ok(rows, record_get(plan, "extent"), 16384, 0, len(rows)) == 1
    && nth(nth(rows, 0), 0) == "blk.0.ffn_gate_tid2eid.weight" && nth(nth(rows, 1), 3) == 1;
  }

  // ---- 2048: the door, through the native stdin organ
  def dorb-door(root) {
   let path = mr-path(mr-find("ds4flash"));
   let out = root ++ "/plan.txt";
   let ask = "printf 'DTV1\\0" ++ path ++ "\\0%s\\0%s\\0%s\\0END\\0' 17179869184 16384 " ++ out ++ " | ./fkwu observe/dsv4-tensor-views-run.bml 2>/dev/null";
   let said = host-exec(ask, "") ?? "";
   let plan = host_path_exists(out) ? read_file(out) : "";
   let bad = root ++ "/refused.txt";
   let short = "printf 'DTV1\\0" ++ path ++ "\\0%s\\0%s\\0%s\\0END' 17179869184 16384 " ++ bad ++ " | ./fkwu observe/dsv4-tensor-views-run.bml 2>/dev/null";
   let refused = host-exec(short, "") ?? "";
   dorb-has?(said, "TVDONE 1406 0") && dorb-has?(plan, "PLAN_EXTENT 91321404640") && dorb-has?(plan, "VIEW_1405_BYTES 51920896")
    && !dorb-has?(refused, "TVDONE") && !host_path_exists(bad);
  }

  // ---- 8192: the native ordered fp64 matrix (the in-RAM Darwin ARM64 program the oracle's MXFP8 reductions run on)
  def dorb-healthy(said, aspect) = dorb-has?(said, "\"aspect\":\"" ++ aspect ++ "\",\"stage\":\"observe\",\"expected\":1,\"observed\":1,\"health\":1");
  def dorb-fp64() {
   let said = host-exec("./fkwu observe/native-fp64-matrix-run.bml </dev/null 2>/dev/null; echo R=$?", "") ?? "";
   dorb-has?(said, "R=0") && dorb-healthy(said, "ordered-arithmetic") && dorb-healthy(said, "reused-residency") && dorb-healthy(said, "release-and-refusal");
  }

  // ---- 4096: proof retention, the door that keeps a proof's inputs (a small quiescent directory, no model)
  def dorb-retention(root) {
   let keep = "printf 'DPA1\\0%s\\0%s\\0END\\0' $S/src ";
   let door = " | ./fkwu observe/dsv4-proof-retention-run.bml >/dev/null 2>&1";
   let sh = "S=" ++ root ++ "/ret; mkdir -p $S/src && echo hello > $S/src/a.txt && printf 'x\\001y\\n' > \"$S/src/odd name.bin\"; "
    ++ keep ++ "$S/a.tar" ++ door ++ "; echo R1=$?; "
    ++ "tar tf $S/a.tar | sort | tr '\\n' ','; echo; tar xOf $S/a.tar ./a.txt; cksum < $S/a.tar > $S/c1; "
    ++ keep ++ "$S/a.tar" ++ door ++ "; echo R2=$?; cksum < $S/a.tar > $S/c2; cmp -s $S/c1 $S/c2 && echo UNCHANGED; "
    ++ keep ++ "$S/src/in.tar" ++ door ++ "; echo R3=$?; [ -e $S/src/in.tar ] || echo NOINNER; "
    ++ "rm -rf $S";
   let said = host-exec(sh, "") ?? "";
   dorb-has?(said, "R1=0") && dorb-has?(said, "./a.txt,") && dorb-has?(said, "./odd name.bin,") && dorb-has?(said, "hello")
    && !dorb-has?(said, "R2=0") && dorb-has?(said, "R2=") && dorb-has?(said, "UNCHANGED")
    && !dorb-has?(said, "R3=0") && dorb-has?(said, "R3=") && dorb-has?(said, "NOINNER");
  }
 }
 let root = temp_dir() ++ "/dsv4-oracle-recipes-band-" ++ now_unix_ms().str();
 let made = host_dir_mkdir(root);
 // a claim that stops (the oracle refuses by form_error) reads as a dark bit, not as a stopped band
 let c1 = dorb-bit(try dorb-pow2() catch false, 1);
 let c2 = dorb-bit(try dorb-f16() catch false, 2);
 let c4 = dorb-bit(try dorb-e2m1() catch false, 4);
 let c8 = dorb-bit(try dorb-e4m3() catch false, 8);
 let c16 = dorb-bit(try dorb-mx8() catch false, 16);
 let c32 = dorb-bit(try dorb-mx4() catch false, 32);
 let c64 = dorb-bit(try dorb-round() catch false, 64);
 let c128 = dorb-bit(try dorb-views() catch false, 128);
 let c256 = dorb-bit(try dorb-extents() catch false, 256);
 let c512 = dorb-bit(try dorb-admission() catch false, 512);
 let c1024 = dorb-bit(try dorb-plan() catch false, 1024);
 let c2048 = dorb-bit(try dorb-door(root) catch false, 2048);
 let c4096 = dorb-bit(try dorb-retention(root) catch false, 4096);
 let c8192 = dorb-bit(try dorb-fp64() catch false, 8192);
 let swept = host_path_remove(root ++ "/plan.txt");
 let swept2 = host_dir_rmdir(root);
 print_str("dsv4-oracle-recipes-band claims " ++ c1.str() ++ " " ++ c2.str() ++ " " ++ c4.str() ++ " " ++ c8.str() ++ " " ++ c16.str() ++ " " ++ c32.str() ++ " " ++ c64.str() ++ " " ++ c128.str() ++ " " ++ c256.str() ++ " " ++ c512.str() ++ " " ++ c1024.str() ++ " " ++ c2048.str() ++ " " ++ c4096.str() ++ " " ++ c8192.str());
 c1 + c2 + c4 + c8 + c16 + c32 + c64 + c128 + c256 + c512 + c1024 + c2048 + c4096 + c8192;
}
