; write-code-fits-band.fk — write-code opens the one Qwen voice, then the code voice that waits for its lane.
; Verdict 1
; preludes: form-stdlib/core.fk form-stdlib/model-registry.bml
(do
  (let names (mr-chain-names "write-code"))
  (if (eq (len names) 2)
      (if (str_eq (head names) "qwen38-q4")
          (if (str_eq (head (tail names)) "katcoder")
              1
              0)
          0)
      0))
