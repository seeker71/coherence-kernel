; write-code-fits-band.fk — write-code opens the voice that fits, then the larger one.
; Verdict 1
; preludes: form-stdlib/core.fk form-stdlib/model-registry.bml
(do
  (let names (mr-chain-names "write-code"))
  (if (eq (len names) 3)
      (if (str_eq (head names) "qwen38-q4")
          (if (str_eq (head (tail names)) "qwen38-q8")
              (if (str_eq (head (tail (tail names))) "katcoder")
                  1
                  0)
              0)
          0)
      0))
