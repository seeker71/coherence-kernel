; form-cli-resident-turnwheel-band.fk -- the host exists before either dynamic
; symbol/program, an old row stays pinned across replacement, and both versions
; execute by structural NodeID without entering the startup function table.
; Expected: 65535
;
; This band exercises only op-tag program rows. It opens no model and owns no
; Metal state; the physical Qwen branch is compile-closed by the parent cell.
;
; preludes: form-stdlib/form-cli-resident-turnwheel.fk

(do
    (defn fcrtb-bit (held weight) (if held weight 0))
    (defn fcrtb-v1-program ()
        (list (list 2) (list 1 17) (list 3 0 1)))
    (defn fcrtb-v2-program ()
        (list (list 2) (list 1 5) (list 5 0 1)
              (list 1 1) (list 3 2 3)))
    (defn fcrtb-route (symbol program root epoch)
        (fcrt-route symbol (jonb-identity program root epoch) program root))
    (defn fcrtb-row (host id)
        (wt-find (wt-rows (le-w (fcrt-lw host))) id))
    (defn fcrtb-receipt-route (row)
        (nth (fcrt-flow-receipt (wt-rstate row)) 2))

    (defn form-cli-resident-turnwheel-band ()
        (do
            ; The residence and wheel are already alive while the callable is
            ; structurally absent. No symbol from below occurs in the parent.
            (let shared (fcrt-shared "" "" (empty) (empty) 256 8
                (jonb-registry 1)))
            (let host0 (fcrt-host-from-shared shared 0 1
                (fcrt-unbound-route)))
            (let ready0 (fcrt-ready host0 90))
            (let missing (fcrt-route-invoke (fcrt-unbound-route) shared 5))
            (let c0 (fcrtb-bit (and
                (str_eq (fcrt-route-signal missing) "nothing")
                (and (nothing? (fcrt-route-value missing))
                     (eq (nth ready0 1) 90))) 1))

            ; Version one arrives after host construction and is published.
            (let sym "arriving/shape-not-in-resident-source")
            (let route1 (fcrtb-route sym (fcrtb-v1-program) 2 1))
            (let swap1 (fcrt-publish host0 1 1 route1 91))
            (let host1 (fcrt-act-host swap1))
            (let offer1 (fcrt-accept-program host1 11 5 4 "release/11"))
            (let host2 (fcrt-act-host offer1))
            (let pin1 (le-pin-of (fcrtb-row host2 11)))
            (let c1 (fcrtb-bit (and (str_eq (fcrt-act-signal swap1) "value")
                (str_eq (fcrt-act-signal offer1) "value")) 2))
            (let c2 (fcrtb-bit (le-eid-eq? pin1 (le-eid 1 1)) 4))

            ; Replacement arrives while row 11 is still live. Row 12 pins the
            ; replacement; row 11 retains its former program by epoch lease.
            (let route2 (fcrtb-route sym (fcrtb-v2-program) 4 1))
            (let swap2 (fcrt-publish host2 2 1 route2 92))
            (let host3 (fcrt-act-host swap2))
            (let offer2 (fcrt-accept-program host3 12 5 4 "release/12"))
            (let host4 (fcrt-act-host offer2))
            (let pin2 (le-pin-of (fcrtb-row host4 12)))
            (let c3 (fcrtb-bit (and (not (node_eq
                    (fcrt-route-identity route1) (fcrt-route-identity route2)))
                (le-eid-eq? pin2 (le-eid 2 1))) 8))
            (let c4 (fcrtb-bit (le-eid-eq? pin1 (le-eid 1 1)) 16))

            (let run (fcrt-run host4 1))
            (let old (fcrtb-row run 11))
            (let fresh (fcrtb-row run 12))
            (let c5 (fcrtb-bit (and (str_eq (wt-status old) "returned")
                (and (eq (len (wt-toks old)) 1)
                     (eq (head (wt-toks old)) 22))) 32))
            (let c6 (fcrtb-bit (and (str_eq (wt-status fresh) "returned")
                (and (eq (len (wt-toks fresh)) 1)
                     (eq (head (wt-toks fresh)) 26))) 64))
            (let c7 (fcrtb-bit (and
                (or (str_eq (fcrtb-receipt-route old) "native")
                    (str_eq (fcrtb-receipt-route old) "form"))
                (or (str_eq (fcrtb-receipt-route fresh) "native")
                    (str_eq (fcrtb-receipt-route fresh) "form"))) 128))

            ; Exact returned 0 and 1 remain present; unbound stayed absence.
            (let zero-program (list (list 1 0)))
            (let one-program (list (list 1 1)))
            (let zero (fcrt-route-invoke
                (fcrtb-route "arriving/zero" zero-program 0 1)
                (wt-sctx (le-w (fcrt-lw run))) 9))
            (let one (fcrt-route-invoke
                (fcrtb-route "arriving/one" one-program 0 1)
                (fcrt-route-shared zero) 9))
            (let c8 (fcrtb-bit (and (eq (fcrt-route-present? zero) 1)
                (and (eq (fcrt-route-value zero) 0)
                (and (eq (fcrt-route-present? one) 1)
                     (eq (fcrt-route-value one) 1)))) 256))

            ; Wrong NodeID is an observed refusal, not Form fallback.
            (let wrong (fcrt-route sym (make_nodeid 9 9 9 9)
                (fcrtb-v2-program) 4))
            (let denied (fcrt-route-invoke wrong (fcrt-route-shared one) 5))
            (let c9 (fcrtb-bit (and
                (str_eq (fcrt-route-signal denied) "refused")
                (nothing? (fcrt-route-value denied))) 512))

            ; Duplicate epoch publication is nothing; no current route moves.
            (let duplicate (fcrt-swap run 2 1 route2))
            (let c10 (fcrtb-bit (and
                (str_eq (fcrt-act-signal duplicate) "nothing")
                (le-eid-eq? (le-cur (fcrt-lw (fcrt-act-host duplicate)))
                    (le-eid 2 1))) 1024))

            ; Cut hands both releaser and flow back. Undo is replay data with
            ; the exact pinned epoch, never an in-place KV rewind claim.
            (let offer3 (fcrt-accept-program run 13 7 3 "release/13"))
            (let host5 (fcrt-act-host offer3))
            (let cut (fcrt-cut host5 13))
            (let replay (fcrt-undo-of (nth cut 0) 13))
            (let c11 (fcrtb-bit (and (str_eq (nth cut 1) "release/13")
                (and (str_eq (fcrt-flow-phase (nth cut 2)) "program")
                     (le-eid-eq? (nth replay 1) (le-eid 2 1)))) 2048))

            ; Nonpositive gas is refused as nothing; integer zero remains a
            ; valid program result above.
            (let nogas (fcrt-accept-program run 14 5 0 "release/14"))
            (let c12 (fcrtb-bit (and
                (str_eq (fcrt-act-signal nogas) "nothing")
                (nothing? (fcrt-act-value nogas))) 4096))

            ; Old route dissolved only after its pinned row returned. Current
            ; replacement stays, and both rows retain their exact pin receipt.
            (let c13 (fcrtb-bit (and
                (nothing? (le-find (le-tbl (fcrt-lw run)) (le-eid 1 1)))
                (not (nothing? (le-find (le-tbl (fcrt-lw run))
                    (le-eid 2 1))))) 8192))
            (let c14 (fcrtb-bit (and
                (node_eq (nth (fcrt-flow-receipt (wt-rstate old)) 1)
                    (fcrt-route-identity route1))
                (node_eq (nth (fcrt-flow-receipt (wt-rstate fresh)) 1)
                    (fcrt-route-identity route2))) 16384))

            ; The scheduler's source contains neither arriving symbol. Their
            ; strings and program rows are test-time offered data.
            (let parent (read_file
                "form/form-stdlib/form-cli-resident-turnwheel.fk"))
            (let c15 (fcrtb-bit (and
                (eq (str_find parent sym 0) -1)
                (eq (str_find parent "arriving/zero" 0) -1)) 32768))

            (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15))))

    (form-cli-resident-turnwheel-band))
