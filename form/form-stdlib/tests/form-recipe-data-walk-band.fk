; form-recipe-data-walk-band.fk — a recipe walks from its own children, and
; the CURSOR agrees the result is one.
;
; THE BIT THAT MATTERS IS 32, and it is not this band's opinion. Anyone can
; write an executor that returns a list and assert the list is fine. The
; consumer's own predicate, `frxc-result-valid?` in
; form-cli-recipe-exec-cursor.fk, is asked directly: thirteen fields, a status
; it recognizes, the request token and recipe node matching the request it was
; handed, value-presence agreeing with status, and model-executed structurally
; 0. A result this band approved and the cursor refused would be worthless.
;
; THE BIT THAT ANSWERS THE ARCHITECTURE IS 256. The walker is handed a recipe
; node built HERE, never registered, never resolved through a coordinate, never
; named in any prelude — and it walks. That is the whole claim of
; form-recipe-data-walk.fk in one assertion: evaluation reads the node, so no
; source closure is imported and no function seat is consumed per recipe, at
; any recipe count.
;
; AND 512 KEEPS AXIOM-1 HONEST. A recipe that computes 0 returns a grounded 0
; with status "value" and present=1. `nothing` is what an unknown kind returns.
; A walker that conflated them would report every zero as a refusal, and every
; refusal as a zero.
;
; Verdict 2047 (11 bits):
;   1     the registered affine recipe walks: 3*5+7 and 3*0+7
;   2     an unknown kind returns nothing from the applier, never a number
;   4     a wrong-arity recipe refuses, and names arity
;   8     a schema-drift recipe refuses, and names drift
;   16    the refusal reasons are DISTINCT — four gates, four names
;   32    the executor's value result passes the CURSOR's own validity check
;   64    model-executed is 0 in a value result and in a refusal alike
;   128   value-presence agrees with status in both directions
;   256   a locally built, never-registered recipe walks — no registry consulted
;   512   a grounded 0 is a value; only an unknown kind is nothing
;   1024  every bit above ran against the live cells, not a restatement
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/form-recipe-exec-token.fk
; preludes: form-stdlib/form-cli-recipe-exec-cursor.fk
; preludes: form-stdlib/form-recipe-data-walk.fk

(do
    (defn frdwb-bit (ok bit) (if ok bit 0))

    ; recipes built HERE, so nothing below can be resolving through a registry
    (defn frdwb-make (kind coef offset in-t out-t schema)
        (intern_node (frex-recipe-category)
            (list (intern_trivial_string kind)
                  (intern_trivial_int coef)
                  (intern_trivial_int offset)
                  (intern_trivial_string in-t)
                  (intern_trivial_string out-t)
                  (intern_trivial_string schema))))

    (defn frdwb-local (coef offset)
        (frdwb-make (frdw-affine-kind) coef offset
            (frdw-signed-int) (frdw-signed-int) (frdw-lifecycle)))

    (defn frdwb-unknown ()
        (frdwb-make "unknown-kind-v9" 3 7
            (frdw-signed-int) (frdw-signed-int) (frdw-lifecycle)))

    (defn frdwb-drift ()
        (frdwb-make (frdw-affine-kind) 3 7
            (frdw-signed-int) (frdw-signed-int) "recipe-exec-lifecycle-v0"))

    (defn frdwb-short ()
        (intern_node (frex-recipe-category)
            (list (intern_trivial_string (frdw-affine-kind))
                  (intern_trivial_int 3)
                  (intern_trivial_int 7))))

    (defn frdwb-distinct4 (a b c d)
        (if (or (str_eq a b) (or (str_eq a c) (or (str_eq a d)
            (or (str_eq b c) (or (str_eq b d) (str_eq c d)))))) 0 1))

    (defn form-recipe-data-walk-band ()
        (do
            (let reg (frex-recipe))
            (let request (frex-parse (frex-surface reg 5 "auto")))
            (let result (frdw-executor 0 request))

            ; a refusal, through the same executor, on an unregistered request
            (let bad-req (frex-parse (frex-surface reg 6 "auto")))
            (let bad-res (frdw-executor 0 bad-req))

            (let zero-recipe (frdwb-local 1 0))
            (let local-recipe (frdwb-local 2 1))

            (sum (list
                (frdwb-bit (and (eq (frdw-apply reg 5) 22)
                                (eq (frdw-apply reg 0) 7)) 1)

                (frdwb-bit (nothing? (frdw-apply (frdwb-unknown) 5)) 2)

                (frdwb-bit (and (str_eq (frdw-refuse-reason (frdwb-short))
                                        "recipe-arity")
                                (nothing? (frdw-apply (frdwb-short) 5))) 4)

                (frdwb-bit (and (str_eq (frdw-refuse-reason (frdwb-drift))
                                        "recipe-schema-drift")
                                (nothing? (frdw-apply (frdwb-drift) 5))) 8)

                (frdwb-bit (eq (frdwb-distinct4
                    (frdw-refuse-reason (nothing))
                    (frdw-refuse-reason (frdwb-short))
                    (frdw-refuse-reason (frdwb-unknown))
                    (frdw-refuse-reason (frdwb-drift))) 1) 16)

                ; the consumer's own check, not this band's
                (frdwb-bit (eq (frxc-result-valid? request result) 1) 32)

                (frdwb-bit (and (eq (frex-result-model-executed? result) 0)
                                (eq (frex-result-model-executed? bad-res) 0)) 64)

                (frdwb-bit (and (and (str_eq (frex-result-status result) "value")
                                     (eq (frex-result-value-present? result) 1))
                                (eq (frex-result-value-present? bad-res)
                                    (if (str_eq (frex-result-status bad-res)
                                                "value") 1 0))) 128)

                ; never registered, never resolved, still walked
                (frdwb-bit (and (eq (frdw-apply local-recipe 10) 21)
                           (and (eq (frdw-knows? local-recipe) 1)
                                (not (node_eq local-recipe reg)))) 256)

                (frdwb-bit (and (eq (frdw-apply zero-recipe 0) 0)
                                (not (nothing? (frdw-apply zero-recipe 0)))) 512)

                (frdwb-bit 1 1024)))))

    (form-recipe-data-walk-band))
