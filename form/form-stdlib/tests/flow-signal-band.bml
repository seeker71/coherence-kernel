; flow-signal-band.bml — the flow's signal surface is a frame in shared memory: cells are fixed width, the picture is the lights, the ring is bounded, a second reader sees what the writer gave.
;
; Expected: 31
; Verdict 31 when every claim lands:
;   1   a cell is fixed width (107 columns) and names its stage, kind and why
;   2   the picture row shows the lights: plan ok then cand discomfort reads "+!..."
;   4   sixty cells leave a ring of 48 (old cells are overwritten) and the header counts all sixty
;   8   a second handle on the same name reads the writer's frame, header and picture included
;   16  a fix cell lights its stage "R" and counts a repair
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/serve-sched.bml form-stdlib/bml/flow-signal.bml
section [form.bml] {
 class FlowSignalBand {
  def fsb-slot() = 28;
  def fsb-lines(F) = split-on(fsg-frame(F), "\n");
  def fsb-emit-n(F, n) = n <= 0 ? 0 : fsg-emit(F, "band", "ok", n, 0, "tick", "id-" ++ n.str(), n) == "" ? 0 : fsb-emit-n(F, n - 1);
  def fsb-c-width(ctx) {
   let F = fsg-new(fsb-slot(), "band-request");
   let line = fsg-emit(F, "plan", "ok", 3, 1, "named why here", "frq-abc", 42);
   let r = len(line) == 107 && str_find(line, "plan ", 0) == 21 && str_find(line, "ok   ", 0) == 27 && str_find(line, "named-why-here", 0) > 0;
   let z = fsg-release(F);
   r;
  }
  def fsb-c-lights(ctx) {
   let F = fsg-new(fsb-slot(), "band-request");
   let a = fsg-emit(F, "plan", "ok", 1, 0, "go", "", 1);
   let b = fsg-emit(F, "cand", "disc", 0, 1, "unbound-name", "", 2);
   let r = str_find(fsg-picture(F), "[+!...]", 0) > 0;
   let z = fsg-release(F);
   r;
  }
  def fsb-c-ring(ctx) {
   let F = fsg-new(fsb-slot(), "band-request");
   let a = fsb-emit-n(F, 60);
   let cells = filter(l => len(l) == 107, fsb-lines(F));
   let r = len(cells) == 48 && str_find(fsg-header(F), "seq=00000060", 0) > 0;
   let z = fsg-release(F);
   r;
  }
  def fsb-c-reader(ctx) {
   let F = fsg-new(fsb-slot(), "band-request");
   let a = fsg-emit(F, "plan", "ok", 2, 0, "go", "", 1);
   let h = shm_receive(fsg-name(fsb-slot()));
   let seen = nothing?(h) ? "" : (shm_read(h) ?? "");
   let r = str_find(seen, "FL1 band-request", 0) == 0 && str_find(seen, "[+....]", 0) > 0;
   let z = fsg-release(F);
   r;
  }
  def fsb-c-fix(ctx) {
   let F = fsg-new(fsb-slot(), "band-request");
   let a = fsg-emit(F, "band", "disc", 0, 1, "compile-error", "", 1);
   let b = fsg-emit(F, "band", "fix", 1, 0, "arity", "", 2);
   let r = str_find(fsg-picture(F), "[...R.]", 0) > 0 && str_find(fsg-picture(F), "rep=01", 0) > 0;
   let z = fsg-release(F);
   r;
  }
 }
 live-claims("flow-signal-band", 0, [["width", 1, 1, fsb-c-width], ["lights", 2, 1, fsb-c-lights], ["ring", 4, 1, fsb-c-ring], ["reader", 8, 1, fsb-c-reader], ["fix", 16, 1, fsb-c-fix]]);
}
