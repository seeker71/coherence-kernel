; flow-signal-band.bml — the flow's signal surface is one small frame in shared memory holding one packed integer: the picture is the lights, the frame never grows, a second reader unpacks what the writer gave.
;
; Expected: 4095
; Verdict 4095 when every claim lands:
;   2048 words: what a repair is shown of a red cell (cs-words) holds the compiler's error line, its tally and the cell's own line, and neither an organ-health row nor the cache's image note, while cs-stderr keeps the health row
;   1   a frame is one short line of five words (request, state, t0, tlast, why) under 100 bytes, and its why has no space
;   2   the lights: plan ok then cand discomfort reads "+!..."
;   4   sixty cells leave one frame of the same short size (nothing grows) and the state still carries the last cell
;   8   a second handle on the same name reads the writer's frame, request and lights included
;   16  a fix cell lights its stage "R" and counts a repair
;   64  a landing is witnessed by a behavioural reading: no band (the compile alone) and a band that holds no claim read no-behavioural-witness; a band holding a claim, or an edited band file, reads behavioural
;   128 a request with no manifest gets one from the voice's reply: only lines "name(params) :: call == expected" whose call is that name's survive (prose, other names, empty values fall away); the block handed to the candidate names them and the fixtures, the witness band is generated from them (one claim per fixture, Expected 2^n - 1), and an unbound name is answered with the manifest's names
;   256 an edit to an EXISTING definition that stops calling names the old text called (and that the request's words do not name) is weakening: the 95b3e19d7 rewrite of dcc-reply-lands? (three covenant checks dropped) reads weakened with the three names, an additive edit (a new definition calling the old one), an identical text, and a rewrite the request's words ask for read none
;   512 a fixture a definition only repeats is no witness: the 7c128c84e additions (dc-classify and dcc-classify-claims answering the fixture's value whatever they are handed) read constant with both names, and the ea3f6f608 echo dr-reading-kind(k) = k reads constant too; an additive definition that answers from its arguments, an unchanged text and no manifest read none
;   1024 contrast: the manifest keeps two fixtures a definition (never one call twice); a definition whose fixtures answer one value (dc-classify) or only what they hand it (the ea3f6f608 echo) reads flat and its contrast ask
;        names its line; a pair of readings of two kinds reads contrasted, a merge keeps two a name, the block names the definition once and the band holds a claim a fixture
;   32  pack and unpack round-trip, and a count past its bits saturates instead of spilling into its neighbour
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/serve-sched.bml form-stdlib/bml/def-window.bml form-stdlib/bml/flow-signal.bml form-stdlib/bml/cell-said.bml
section [form.bml] {
 class FlowSignalBand {
  def fsb-slot() = 28;
  def fsb-words(F) = split-on(fsg-frame(F), " ");
  def fsb-state(F) = str_to_int(fsb-words(F)[1]);
  def fsb-emit-n(F, n) = n <= 0 ? 0 : len(fsg-emit(F, "band", "ok", n, 0, "tick", "id-" ++ n.str(), n)) == 0 ? 0 : fsb-emit-n(F, n - 1);
  def fsb-c-width(ctx) {
   let F = fsg-new(fsb-slot(), "band-request");
   let line = fsg-emit(F, "plan", "ok", 3, 1, "named why here", "frq-abc", 42);
   let r = len(line) < 100 && len(split-on(line, " ")) == 5 && str_find(line, "named-why-here", 0) > 0 && str_find(line, "band-request ", 0) == 0;
   let z = fsg-release(F);
   r;
  }
  def fsb-c-lights(ctx) {
   let F = fsg-new(fsb-slot(), "band-request");
   let a = fsg-emit(F, "plan", "ok", 1, 0, "go", "", 1);
   let b = fsg-emit(F, "cand", "disc", 0, 1, "unbound-name", "", 2);
   let r = fsg-glyph-line(fsg-unpack(fsb-state(F))[0]) == "+!...";
   let z = fsg-release(F);
   r;
  }
  def fsb-c-ring(ctx) {
   let F = fsg-new(fsb-slot(), "band-request");
   let before = len(fsg-frame(F));
   let a = fsb-emit-n(F, 60);
   let u = fsg-unpack(fsb-state(F));
   let r = len(fsg-frame(F)) < before + 40 && u[4] == 1 && u[2] == 1;
   let z = fsg-release(F);
   r;
  }
  def fsb-c-reader(ctx) {
   let F = fsg-new(fsb-slot(), "band-request");
   let a = fsg-emit(F, "plan", "ok", 2, 0, "go", "", 1);
   let h = shm_receive(fsg-name(fsb-slot()));
   let seen = nothing?(h) ? "" : (shm_read(h) ?? "");
   let w = split-on(seen, " ");
   let r = len(w) == 5 && w[0] == "band-request" && fsg-glyph-line(fsg-unpack(str_to_int(w[1]))[0]) == "+....";
   let z = fsg-release(F);
   r;
  }
  def fsb-c-fix(ctx) {
   let F = fsg-new(fsb-slot(), "band-request");
   let a = fsg-emit(F, "band", "disc", 0, 1, "compile-error", "", 1);
   let b = fsg-emit(F, "band", "fix", 1, 0, "arity", "", 2);
   let u = fsg-unpack(fsb-state(F));
   let r = fsg-glyph-line(u[0]) == "...R." && u[3] == 1;
   let z = fsg-release(F);
   r;
  }
  def fsb-c-witness(ctx) = fsg-witness("", 0, false) == "no-behavioural-witness" && fsg-witness("x-band.bml", 0, false) == "no-behavioural-witness" && fsg-witness("x-band.bml", 3, false) == "behavioural" && fsg-witness("", 0, true) == "behavioural";
  def fsb-mf-reply() = "Sure, here they are:\n- lx-int-minus(xs, ys) :: lx-int-minus([1, 2, 3], [2]) == [1, 3]\n`lx-int-count(xs) :: lx-int-count([4, 5]) == 2`\nfsg-x(a) :: other(1) == 2\nbad(x) :: bad(1) ==\nThat is all.";
  def fsb-c-manifest(ctx) {
   let rows = fsg-mf-rows(fsb-mf-reply());
   let block = fsg-mf-block(rows);
   let band = fsg-mf-band("mf-band", "form/x.bml", rows);
   len(rows) == 2 && rows[0][0] == "lx-int-minus" && rows[0][3] == "[1, 3]" && rows[1][2] == "lx-int-count([4, 5])" && len(fsg-mf-rows("no lines here")) == 0 && fsg-mf-block([]) == ""
    && str_find(block, "\nDefinition manifest: lx-int-minus, lx-int-count\n", 0) >= 0 && str_find(block, "- lx-int-minus(xs, ys) :: lx-int-minus([1, 2, 3], [2]) == [1, 3]", 0) >= 0
    && fsg-mf-full(rows) == 3 && str_find(band, "; Expected: 3\n", 0) >= 0 && str_find(band, "def mf-c-0(ctx) = lx-int-minus([1, 2, 3], [2]) == [1, 3];", 0) >= 0 && str_find(band, "[\"fixture-1\", 2, 1, mf-c-1]", 0) >= 0 && str_find(band, "// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form/x.bml\n", 0) >= 0
    && str_find(fsg-mf-note(rows, "lx-invented"), "lx-int-minus(xs, ys)", 0) >= 0 && fsg-mf-note([], "lx-invented") == "";
  }
  // the 95b3e19d7 edit: dcc-reply-lands? rewritten so that three of its four covenant checks are no longer called
  def fsb-wk-old() = "    def dcc-reply-lands?(moves, claims) = (Comparable) dc-fabrications(moves) == 0 ? (Comparable) dc-reply-receivable?(moves) == 1 ? (Comparable) dc-ends-open?(moves) == 1 ? (Comparable) dc-one-teaching?(moves) == 1 ? dcc-other-held-open?(claims) : 0 : 0 : 0 : 0;\n    def dcc-landing-reply() = [dc-move(\"advise\", 1)];\n";
  def fsb-wk-bad() = "    def dcc-reply-lands?(moves, claims) = (Comparable) dc-fabrications(moves) == 0 ? (Comparable) dcc-other-held-open?(claims) == 0 ? 1 : 0 : 0;\n    def dcc-landing-reply() = [dc-move(\"advise\", 1)];\n";
  def fsb-wk-add() = fsb-wk-old() ++ "    def dcc-classify(moves, claims) = dcc-reply-lands?(moves, claims) == 1 ? \"lands\" : \"holds\";\n";
  def fsb-c-weakens(ctx) {
   let words = "wire dcc-reply-lands? to a real draft held to a band of authored fixtures";
   let w = fsg-wk-weakened(fsb-wk-old(), fsb-wk-bad(), words);
   let asked = fsg-wk-weakened(fsb-wk-old(), fsb-wk-bad(), "drop dc-reply-receivable?, dc-ends-open? and dc-one-teaching? from dcc-reply-lands?");
   len(w) == 1 && w[0][0] == "dcc-reply-lands?" && len(w[0][1]) == 3 && any?(n => (String) n == "dc-ends-open?", w[0][1]) && !any?(n => (String) n == "dc-fabrications", w[0][1])
    && len(fsg-wk-weakened(fsb-wk-old(), fsb-wk-add(), words)) == 0 && len(asked) == 0 && len(fsg-wk-weakened(fsb-wk-old(), fsb-wk-old(), words)) == 0;
  }
  // the 7c128c84e edit: two classifiers that answer the fixture's value whatever they are handed
  def fsb-cf-rows() = fsg-mf-rows("dc-classify(reply, given) :: dc-classify(\"I feel stuck\", [\"stuck\"]) == [\"advise\"]\ndcc-classify-claims(reply, given) :: dcc-classify-claims(\"I feel stuck\", [\"stuck\"]) == [[\"me\", \"stuck\"]]");
  def fsb-cf-old() = "    def dc-ends-open?(moves) = 1;\n";
  def fsb-cf-bad() = fsb-cf-old() ++ "    def dc-classify(reply, given) = [\"advise\"];\n\n    def dcc-classify-claims(reply, given) = [[\"me\", \"stuck\"]];\n";
  def fsb-cf-good() = fsb-cf-old() ++ "    def dc-classify(reply, given) = str_find(reply, given[0], 0) >= 0 ? [\"advise\"] : [\"hold\"];\n    def dcc-classify-claims(reply, given) = map(g => [\"me\", g], given);\n";
  def fsb-c-constant(ctx) {
   let rows = fsb-cf-rows();
   let c = fsg-mf-constant(fsb-cf-old(), fsb-cf-bad(), rows);
   let echo = fsg-mf-rows("dr-reading-kind(k) :: dr-reading-kind(\"received\") == \"received\"");
   let e = fsg-mf-constant(fsb-cf-old(), fsb-cf-old() ++ "    def dr-reading-kind(k) = k;\n", echo);
   len(rows) == 2 && len(c) == 2 && c[0] == "dc-classify" && c[1] == "dcc-classify-claims"
    && len(echo) == 1 && len(e) == 1 && e[0] == "dr-reading-kind" && len(fsg-mf-constant(fsb-cf-old(), fsb-cf-old() ++ "    def dr-reading-kind(k) = dr-word?(k) ? k : \"unread\";\n", echo)) == 0
    && len(fsg-mf-constant(fsb-cf-old(), fsb-cf-good(), rows)) == 0 && len(fsg-mf-constant(fsb-cf-bad(), fsb-cf-bad(), rows)) == 0 && len(fsg-mf-constant(fsb-cf-old(), fsb-cf-bad(), [])) == 0;
  }
  def fsb-c-pack(ctx) {
   let u = fsg-unpack(fsg-pack(fsg-p8(0) * 2 + fsg-p8(4) * 5, "land", "disc", 7, 5000, 300));
   fsg-glyph-line(u[0]) == "+...R" && fsg-name-at(fsg-stages(), u[1]) == "land" && fsg-name-at(fsg-kinds(), u[2]) == "disc" && u[3] == 7 && u[4] == 4095 && u[5] == 255;
  }
  // ---- 1024 contrast
  def fsb-c-contrast(ctx) {
   let echo = fsg-mf-rows("dr-reading-kind(k) :: dr-reading-kind(\"received\") == \"received\"\ndr-reading-kind(k) :: dr-reading-kind(\"received\") == \"received\"");
   let pair = fsg-mf-rows("dr-reading-kind(k) :: dr-reading-kind(\"received\") == \"received\"\ndr-reading-kind(k) :: dr-reading-kind(\"a wall\") == \"wall\"\ndr-reading-kind(k) :: dr-reading-kind(\"x\") == \"unread\"");
   let same = fsg-mf-rows("dc-classify(r, g) :: dc-classify(\"I feel stuck\", [\"stuck\"]) == [\"advise\"]\ndc-classify(r, g) :: dc-classify(\"I am fine\", [\"stuck\"]) == [\"advise\"]");
   let echoes = fsg-mf-rows("dr-reading-kind(k) :: dr-reading-kind(\"received\") == \"received\"\ndr-reading-kind(k) :: dr-reading-kind(\"wall\") == \"wall\"");
   len(echo) == 1 && len(pair) == 2 && fsg-mf-flat(echo)[0] == "dr-reading-kind" && nil?(fsg-mf-flat(pair)) && fsg-mf-flat(same)[0] == "dc-classify" && fsg-mf-flat(echoes)[0] == "dr-reading-kind"
    && len(fsg-mf-merge(echo, pair)) == 2 && nil?(fsg-mf-flat(fsg-mf-merge(echo, pair)))
    && str_find(fsg-mf-contrast-ask(echo, ["dr-reading-kind"]), "dr-reading-kind(\"received\") == \"received\"", 0) >= 0
    && str_find(fsg-mf-block(pair), "\nDefinition manifest: dr-reading-kind\n", 0) >= 0 && str_find(fsg-mf-band("b", "x.bml", pair), "; Expected: 3\n", 0) >= 0;
  }
  // ---- 2048 words
  def fsb-c-words(ctx) {
   let row = record_new(0, "observed", "compile-error", "path", "observe/x.bml", "line", 3, "detail", "[unbound-name] 'dr-x'", "organ", "fkwu-compiler", "aspect", "source", "stage", "compile", "health", 0, "at_ms", 1, "name", "dr-x");
   let rec = record_new(0, "diag", [row], "errors", 1, "err", "fkwu: observe/x.bml: warning: image admission failed (written by a different fkwu build); rebuilding\nthe cell's own line\n", "stopped", nothing(), "value", nothing(), "out", "");
   let w = cs-words(rec);
   w == "fkwu: observe/x.bml:3: error: [unbound-name] 'dr-x'\nfkwu: 1 error(s), 0 warning(s)\nthe cell's own line\n" && str_find(cs-stderr(rec), "form-organ health ", 0) >= 0 && cs-words(nothing()) == "";
  }
 }
 live-claims("flow-signal-band", 0, [["width", 1, 1, fsb-c-width], ["lights", 2, 1, fsb-c-lights], ["ring", 4, 1, fsb-c-ring], ["reader", 8, 1, fsb-c-reader], ["fix", 16, 1, fsb-c-fix], ["pack", 32, 1, fsb-c-pack], ["witness", 64, 1, fsb-c-witness], ["manifest", 128, 1, fsb-c-manifest], ["weakens", 256, 1, fsb-c-weakens], ["constant", 512, 1, fsb-c-constant], ["contrast", 1024, 1, fsb-c-contrast], ["words", 2048, 1, fsb-c-words]]);
}
