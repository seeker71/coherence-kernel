; living-world-equivalence-band.fk -- structural return must hold both ways.
; Verdict 32767 proves fifteen symmetric-evidence, consent, and lifecycle properties.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-equivalence.fk form-stdlib/tests/living-world-equivalence-witness.fk

(do
    (let base (lweqw-base-round))
    (let forward-proposal (lweqw-forward-proposal base))
    (let inverse-proposal (lweqw-inverse-proposal base))
    (let forward-candidate
        (lwt-proposal-candidate forward-proposal))
    (let inverse-candidate
        (lwt-proposal-candidate inverse-proposal))
    (let mapping-round (lweqw-mapping-round-from base))
    (let mapping-world (lwt-round-world mapping-round))

    (let proposals (lweq-proposals mapping-world 2))
    (let proposal (head (lwo-field-items proposals)))
    (let candidate (lwt-proposal-candidate proposal))
    (let shape (lwo-emergent-shape candidate))
    (let evidence (lweq-shape-evidence shape))
    (let first-returns
        (lwo-field-items (lweq-evidence-first-returns evidence)))
    (let second-returns
        (lwo-field-items (lweq-evidence-second-returns evidence)))
    (let eq-round
        (lwt-round mapping-world proposals
            (lwo-empty-field) mapping-round))
    (let eq-yes (lweqw-all-yes-round eq-round proposal))
    (let successful (lweq-integrate eq-yes proposal (lweqw-action)))
    (let successful-world (lwt-round-world successful))

    ; A fully acknowledged sibling proposal is refused when one supporting
    ; attribution is released before integration.
    (let stale-world (lweqw-release-forward-a (lwt-round-world eq-yes)))
    (let stale-round
        (lwt-round stale-world proposals (lwo-empty-field) eq-yes))
    (let stale-integration
        (lweq-integrate stale-round proposal (lweqw-action)))

    ; The same inverse endpoint shape with a non-returning template produces
    ; four inspectable failures and no equivalence proposal.
    (let wrong-base (lweqw-wrong-base-round))
    (let wrong-forward
        (lwt-proposal-candidate
            (lweqw-forward-proposal wrong-base)))
    (let wrong-inverse
        (lwt-proposal-candidate
            (lweqw-inverse-proposal wrong-base)))
    (let wrong-mapping-round
        (lweqw-mapping-round-from wrong-base))
    (let wrong-world (lwt-round-world wrong-mapping-round))
    (let wrong-evidence
        (lweq-evidence-for wrong-forward wrong-inverse))

    (let c1 (if (and (eq (lwrl-steady?
                              mapping-world forward-candidate) 1)
                         (eq (lwrl-steady?
                              mapping-world inverse-candidate) 1)) 1 0))
    (let c2 (if (eq (lweq-inverse-domains?
                         mapping-world forward-candidate
                         inverse-candidate) 1) 2 0))
    (let c3 (if (eq (lwo-field-size proposals) 1) 4 0))
    (let c4 (if (and (eq (len first-returns) 2)
                         (eq (len second-returns) 2)) 8 0))
    (let c5 (if (and (eq (lweq-all-success? first-returns) 1)
                         (eq (lweq-all-success? second-returns) 1)) 16 0))
    (let c6 (if (and (node_eq
                          (lweq-return-observed-bridge
                              (head first-returns))
                          (lweq-return-expected-bridge
                              (head first-returns)))
                         (node_eq
                          (lweq-return-observed-return
                              (head first-returns))
                          (lweq-return-source
                              (head first-returns)))) 32 0))
    (let c7 (if (and (eq (lwo-field-size
                              (lweq-evidence-failures evidence)) 0)
                         (node_eq (lweq-shape-path shape)
                                  (lwo-local-path))) 64 0))
    (let c8 (if (and (eq (lwo-field-size
                              (lwo-emergent-witnesses candidate)) 8)
                         (eq (lwo-field-size
                              (lwt-proposal-participants proposal)) 4)) 128 0))
    (let c9 (if (eq (lwo-active?
                         mapping-world candidate) 0) 256 0))
    (let c10 (if (and (eq (lwo-active?
                               successful-world candidate) 1)
                          (eq (lwo-field-size
                               (lwo-active-attributions-for
                                   successful-world candidate)) 4)) 512 0))
    (let c11 (if (eq (lweq-steady?
                          successful-world candidate) 1) 1024 0))
    (let c12 (if (and (eq (lwrl-steady?
                               stale-world forward-candidate) 0)
                          (eq (lweq-current?
                               stale-world candidate) 0)) 2048 0))
    (let c13 (if (and (eq (lwo-world-has?
                               (lwt-round-world stale-integration)
                               candidate) 0)
                          (eq (lwo-active?
                               successful-world candidate) 1)) 4096 0))
    (let c14 (if (eq (lwo-field-size
                          (lweq-evidence-failures wrong-evidence)) 4) 8192 0))
    (let c15 (if (and (eq (lwo-field-size
                               (lweq-proposals wrong-world 2)) 0)
                          (eq (lweq-evidence-ready?
                               wrong-evidence 2) 0)) 16384 0))
    (lweqw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
