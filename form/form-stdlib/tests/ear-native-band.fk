; ear-native-band.fk — the native whisper-tiny pass, pinned on a 2 s fixture of this room
; (form-stdlib/tests/fixtures/ear-okay-2s.wav, 16 kHz mono s16): the npz table, one mapped
; tensor byte, the log-mel against the reference's own number, the encoder length at an 8 s
; window, the tongue and the line. The model file is the reference's cache (a model file read).
; Expected: 32767
; Bits 1..128 are the pass as it stood. Bits 256..4096 are the model's own doubt, which the pass
; read for the first time on 2026-09-07: the no-speech probability under the line on speech and
; over it on an empty window, the phantom that empty window still writes now silenced by
; enw-heard while enw-text still shows it, the tongue's own probability beside the tongue, an
; utterance at the window's END not silenced (the reading that moved the line off the
; reference's 0.6), and the decoded line's average log-probability. Bit 8192 is the npz door
; refusing to invent a table for a file that is not an archive — found by asking it to open
; whisper-large-v3-turbo, which is safetensors and which it answered with 7720 rows of nothing.
; Bit 16384 is the window handed in pieces: enw-encode-parts writes the mic's own chunks straight
; into the device buffer where enw-encode joined them into one string first, and the two doors are
; asked whether they are the same function — same Te, same first six encoder floats, same line.
; PROOF LEVEL: FOURTH-ARM ONLY (metal handle door)
; preludes: form/form-stdlib/ear-native.fk
(do
    (defn eb-f32 (b i) (do (let bits (en-u32 b i)) (let s (div bits 2147483648)) (let e (mod (div bits 8388608) 256)) (let m (mod bits 8388608)) (if (eq e 0) 0.0 (if (eq e 255) 99999.0 (mul (if (eq s 1) -1.0 1.0) (mul (add 1.0 (div (add m 0.0) 8388608.0)) (fq-pow2 (sub e 127))))))))
    (defn eb-zeros (s n) (if (ge (str_len s) n) (substring s 0 n) (eb-zeros (str_concat s s) n)))
    (defn eb-bit (ok v) (if ok v 0))
    (defn eb-chunks (s i end acc) (if (ge i end) (reverse acc) (eb-chunks s (add i 3200) end (cons (substring s i (add i 3200)) acc))))
    (let snap (str_concat "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/snapshots/" (trim (en-text (read_file "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/refs/main")))))
    (let path (str_concat snap "/weights.npz"))
    (let rows (en-table path))
    (let r0 (head rows))
    (let st (enw-open path (enw-tokenizer-path)))
    (let bytes (en-text (read_file "form/form-stdlib/tests/fixtures/ear-okay-2s.wav")))
    (let pcm (substring bytes 44 (str_len bytes)))
    (let Te (enw-encode st (str_concat pcm (eb-zeros (byte_to_str 0) (sub 256000 (str_len pcm))))))
    (let mel0 (eb-f32 (en-text (metal_buf_read (enw-mel st) 0 4)) 0))
    (let r (enw-transcribe st Te 24))
    (let text (trim (enw-text st (nth r 1))))
    (let c1 (eb-bit (eq (len rows) 166) 1))
    (let c2 (eb-bit (and (str_eq (head r0) "encoder.conv1.weight") (and (eq (en-off r0) 202) (eq (en-bytes r0) 184320))) 2))
    (let c3 (eb-bit (and (lt mel0 -0.138) (gt mel0 -0.1382)) 4))
    (let c4 (eb-bit (eq Te 400) 8))
    (let c5 (eb-bit (str_eq (enw-lang-code (head r)) "en") 16))
    (let c6 (eb-bit (str_eq text "Okay, let's try the guitar.") 32))
    (let c7 (eb-bit (eq (str_byte_at (en-text (metal_buf_read (enw-h (enw-hs st) "encoder.conv1.bias") 0 8)) 0) 182) 64))
    ; the cut handed to the decoder as its first timestamp: 6 s of silence in front, speak from tick 300
    (let Te2 (enw-encode st (str_concat (eb-zeros (byte_to_str 0) (sub 256000 (str_len pcm))) pcm)))
    (let r2 (enw-transcribe-from st Te2 300 40))
    (let c8 (eb-bit (str_eq (trim (enw-text st (nth r2 1))) "Okay, let's try the guitar.") 128))
    ; ---- the model's own doubt ----
    ; speech: under the line, and the words come through the gate unchanged
    (let nsp1 (enw-nospeech-prob r))
    (let c9 (eb-bit (and (gt nsp1 0.436) (and (lt nsp1 0.437) (str_eq (trim (enw-heard st r)) "Okay, let's try the guitar."))) 256))
    ; an empty window still WRITES a phantom — enw-text shows it — and the gate is what silences it
    (let Te3 (enw-encode st (eb-zeros (byte_to_str 0) 256000)))
    (let r3 (enw-transcribe st Te3 24))
    (let nsp3 (enw-nospeech-prob r3))
    (let c10 (eb-bit (and (gt nsp3 0.877) (and (lt nsp3 0.878) (and (eq (enw-doubted? r3) 1) (and (gt (str_len (trim (enw-text st (nth r3 1)))) 0) (eq (str_len (enw-heard st r3)) 0))))) 512))
    ; the tongue carries its own probability now, not just its name
    (let tp1 (enw-tongue-prob r))
    (let c11 (eb-bit (and (gt tp1 0.315) (lt tp1 0.316)) 1024))
    ; an utterance at the END of the window doubts itself past the reference's 0.6 and is NOT silenced here
    (let nsp2 (enw-nospeech-prob r2))
    (let c12 (eb-bit (and (gt nsp2 0.610) (and (lt nsp2 0.611) (and (gt nsp2 0.6) (eq (enw-doubted? r2) 0)))) 2048))
    ; the decoded line's average log-probability, folded by the argmax that was already reading those logits
    (let alp1 (enw-line-logprob r))
    (let c13 (eb-bit (and (gt alp1 -1.460) (lt alp1 -1.458)) 4096))
    ; the npz door answers an EMPTY table for a file that is not an archive, where it used to invent one:
    ; whisper-large-v3-turbo ships 1.6 GB of safetensors, and this pass cannot read that container
    (let big "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-large-v3-turbo/snapshots/a4aaeec0636e6fef84abdcbe3544cb2bf7e9f6fb/weights.safetensors")
    (let c14 (eb-bit (and (gt (file_size big) 1000000000) (eq (len (en-table big)) 0)) 8192))
    ; ---- the window handed in pieces ----
    ; A live lane holds its window as the mic's own chunks and joined them into one string for the
    ; pass. enw-encode-parts writes the pieces straight into the device buffer instead, silence in
    ; front while the window is short. This asks whether the two doors are the same function: the
    ; same encoder length, the same first six encoder floats, and the same line — the fixture put
    ; at the END of an 8 s window, in twenty 3200-byte pieces, spoken from tick 300.
    (let zpad (eb-zeros (byte_to_str 0) (sub 256000 (str_len pcm))))
    (let TeJ (enw-encode st (str_concat zpad pcm)))
    (let encJ (en-text (metal_buf_read (enw-b st 10) 0 24)))
    (let textJ (trim (enw-text st (nth (enw-transcribe-from st TeJ 300 40) 1))))
    (let TeP (enw-encode-parts st (eb-chunks pcm 0 (str_len pcm) (list)) 256000))
    (let encP (en-text (metal_buf_read (enw-b st 10) 0 24)))
    (let textP (trim (enw-text st (nth (enw-transcribe-from st TeP 300 40) 1))))
    (let c15 (eb-bit (and (eq TeJ TeP) (and (str_eq encJ encP) (and (str_eq textJ textP) (str_eq textP "Okay, let's try the guitar.")))) 16384))
    (print_str (str_concat "text=" text))
    (print_str (str_concat "in pieces: " (str_concat textP (str_concat " Te=" (int_to_str TeP)))))
    (print_str (str_concat "nospeech speech/empty/tail " (str_concat (enw-lang-code (head r)) (str_concat " tongue-prob and line-logprob pinned; empty window wrote: " (trim (enw-text st (nth r3 1)))))))
    (print (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9 (add c10 (add c11 (add c12 (add c13 (add c14 c15)))))))))))))))) 
