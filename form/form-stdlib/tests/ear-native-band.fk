; ear-native-band.fk — the native whisper-tiny pass, pinned on a 2 s fixture of this room
; (form-stdlib/tests/fixtures/ear-okay-2s.wav, 16 kHz mono s16): the npz table, one mapped
; tensor byte, the log-mel against the reference's own number, the encoder length at an 8 s
; window, the tongue and the line. The model file is the reference's cache (a model file read).
; Expected: 127
; PROOF LEVEL: FOURTH-ARM ONLY (metal handle door)
; preludes: form/form-stdlib/ear-native.fk
(do
    (defn eb-f32 (b i) (do (let bits (en-u32 b i)) (let s (div bits 2147483648)) (let e (mod (div bits 8388608) 256)) (let m (mod bits 8388608)) (if (eq e 0) 0.0 (if (eq e 255) 99999.0 (mul (if (eq s 1) -1.0 1.0) (mul (add 1.0 (div (str_to_float (int_to_str m)) 8388608.0)) (fq-pow2 (sub e 127))))))))
    (defn eb-zeros (s n) (if (ge (str_len s) n) (substring s 0 n) (eb-zeros (str_concat s s) n)))
    (defn eb-bit (ok v) (if ok v 0))
    (let snap (str_concat "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/snapshots/" (trim (en-text (read_file "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/refs/main")))))
    (let path (str_concat snap "/weights.npz"))
    (let rows (en-table path))
    (let r0 (head rows))
    (let st (enw-open path "/Users/ursmuff/.mlx-venv/lib/python3.14/site-packages/mlx_whisper/assets/multilingual.tiktoken"))
    (let bytes (en-text (read_file "form/form-stdlib/tests/fixtures/ear-okay-2s.wav")))
    (let pcm (substring bytes 44 (str_len bytes)))
    (let Te (enw-encode st (str_concat pcm (eb-zeros (byte_to_str 0) (sub 256000 (str_len pcm))))))
    (let mel0 (eb-f32 (en-text (metal_buf_read (enw-b st 2) 0 4)) 0))
    (let r (enw-transcribe st Te 24))
    (let text (trim (enw-text st (nth r 1))))
    (let c1 (eb-bit (eq (len rows) 166) 1))
    (let c2 (eb-bit (and (str_eq (head r0) "encoder.conv1.weight") (and (eq (en-off r0) 202) (eq (en-bytes r0) 184320))) 2))
    (let c3 (eb-bit (and (lt mel0 -0.138) (gt mel0 -0.1382)) 4))
    (let c4 (eb-bit (eq Te 400) 8))
    (let c5 (eb-bit (str_eq (enw-lang-code (head r)) "en") 16))
    (let c6 (eb-bit (str_eq text "Okay, let's try the guitar.") 32))
    (let c7 (eb-bit (eq (str_byte_at (en-text (metal_buf_read (enw-h (enw-hs st) "encoder.conv1.bias") 0 8)) 0) 182) 64))
    (print_str (str_concat "text=" text))
    (print (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
