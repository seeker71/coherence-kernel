; form-program-image-bmf-subset-lower-band.fk -- two grammar values lower to
; different symbolic PIF graphs without caller offsets or per-grammar seats.
;
; This band proves the compiler stage only.  The linked pattern roots produce
; descriptors; they do not yet claim raw-byte parse semantics or admission.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/bmf-core.fk
; preludes: form-stdlib/bmf-grammar.fk
; preludes: form-stdlib/program-image-fkb.fk
; preludes: form-stdlib/form-program-image-symbolic-linker.fk
; preludes: form-stdlib/form-program-image-bmf-subset-lower.fk

(do
    (defn fpbslb-limits ()
        (fpbsl-limits 8 96 512 16 64 2048 1024 64))
    (defn fpbslb-concept-class ()
        (fpbsl-class "concept-byte"
            (list (list 45 45) (list 48 57) (list 97 122))))
    (defn fpbslb-digit-class ()
        (fpbsl-class "digit" (list (list 48 57))))

    (defn fpbslb-query-grammar ()
        (grammar "query" (list
            (rule3 "query"
                (list "seq"
                    (p-lit "<|form:nodeid-knowledge-query|>")
                    (p-lit "concept=")
                    (p-cap "coordinate" (p-run "concept-byte"))
                    (p-lit "<|/form:nodeid-knowledge-query|>"))
                (fpbsl-t-node (list 31 2 0 98)
                    (list
                        (fpbsl-t-trivial-string "concept")
                        (fpbsl-t-capture-trivial-string "coordinate")
                        (fpbsl-t-trivial-int 96)
                        (fpbsl-t-trivial-int 1)
                        (fpbsl-t-trivial-int 0)
                        (fpbsl-t-trivial-string
                            "bmf-core-raw-byte-cursor-v1")))))))
    (defn fpbslb-query-spec ()
        (fpbsl-spec (fpbslb-query-grammar)
            (list (fpbslb-concept-class)) (fpbslb-limits)))

    (defn fpbslb-decision-grammar-with-allow (allow-literal)
        (grammar "start" (list
            (rule3 "start"
                (list "alt" (p-ref "allow") (p-ref "deny"))
                (fpbsl-t-nothing))
            (rule3 "allow"
                (list "seq" (p-lit allow-literal)
                    (p-cap "allow-value" (p-run "digit")) (p-lit ";"))
                (fpbsl-t-int 1))
            (rule3 "deny"
                (list "seq" (p-lit "deny:")
                    (p-cap "deny-value" (p-run "digit")) (p-lit ";"))
                (fpbsl-t-int 0)))))
    (defn fpbslb-decision-grammar ()
        (fpbslb-decision-grammar-with-allow "allow:"))
    (defn fpbslb-decision-spec ()
        (fpbsl-spec (fpbslb-decision-grammar)
            (list (fpbslb-digit-class)) (fpbslb-limits)))

    (defn fpbslb-sum (values)
        (if (nil? values) 0
            (add (head values) (fpbslb-sum (tail values)))))
    (defn fpbslb-bit (held weight) (if held weight 0))
    (defn fpbslb-ir-tag-count (nodes tag)
        (if (nil? nodes) 0
            (add (if (eq (nth (head nodes) 1) tag) 1 0)
                 (fpbslb-ir-tag-count (tail nodes) tag))))
    (defn fpbslb-string-row-present? (rows bytes)
        (if (nil? rows) 0
            (if (value_eq (nth (head rows) 1) bytes) 1
                (fpbslb-string-row-present? (tail rows) bytes))))
    (defn fpbslb-refusal? (result reason)
        (and (fpbsl-refused? result)
             (and (str_eq (fpbsl-reason result) reason)
                  (nothing? (fpbsl-ir result)))))

    (defn fpbslb-spec-for (grammar classes limits)
        (fpbsl-spec grammar classes limits))
    (defn fpbslb-single-rule-spec (pattern template)
        (fpbslb-spec-for
            (grammar "start" (list (rule3 "start" pattern template)))
            (list (fpbslb-digit-class)) (fpbslb-limits)))
    (defn fpbslb-rule-limits (rule-limit)
        (fpbsl-limits rule-limit 96 512 16 64 2048 1024 64))
    (defn fpbslb-decision-spec-with-rule-limit (rule-limit)
        (fpbslb-spec-for (fpbslb-decision-grammar)
            (list (fpbslb-digit-class))
            (fpbslb-rule-limits rule-limit)))

    (defn fpbslb-duplicate-rule-spec ()
        (fpbslb-spec-for
            (grammar "start" (list
                (rule3 "start" (p-lit "a") (fpbsl-t-nothing))
                (rule3 "start" (p-lit "b") (fpbsl-t-nothing))))
            (list (fpbslb-digit-class)) (fpbslb-limits)))
    (defn fpbslb-unresolved-ref-spec ()
        (fpbslb-single-rule-spec (p-ref "missing") (fpbsl-t-nothing)))
    (defn fpbslb-cycle-spec ()
        (fpbslb-spec-for
            (grammar "start" (list
                (rule3 "start" (p-ref "other") (fpbsl-t-nothing))
                (rule3 "other" (p-ref "start") (fpbsl-t-nothing))))
            (list (fpbslb-digit-class)) (fpbslb-limits)))
    (defn fpbslb-duplicate-class-spec ()
        (fpbslb-spec-for (fpbslb-decision-grammar)
            (list (fpbslb-digit-class) (fpbslb-digit-class))
            (fpbslb-limits)))
    (defn fpbslb-invalid-range-spec ()
        (fpbslb-spec-for
            (grammar "start" (list
                (rule3 "start" (p-run "bad") (fpbsl-t-nothing))))
            (list (fpbsl-class "bad" (list (list 57 48))))
            (fpbslb-limits)))
    (defn fpbslb-cap-non-run-spec ()
        (fpbslb-single-rule-spec
            (p-cap "x" (p-lit "a")) (fpbsl-t-nothing)))
    (defn fpbslb-undefined-capture-spec ()
        (fpbslb-single-rule-spec
            (p-lit "a") (fpbsl-t-capture-string "x")))
    (defn fpbslb-nondefinite-capture-spec ()
        (fpbslb-single-rule-spec
            (list "seq"
                (list "alt"
                    (p-cap "x" (p-run "digit"))
                    (p-lit "b"))
                (p-lit "c"))
            (fpbsl-t-capture-string "x")))
    (defn fpbslb-duplicate-capture-spec ()
        (fpbslb-single-rule-spec
            (list "seq"
                (p-cap "x" (p-run "digit"))
                (p-cap "x" (p-run "digit")))
            (fpbsl-t-nothing)))
    (defn fpbslb-unsupported-pattern-spec ()
        (fpbslb-single-rule-spec
            (list "rep" (p-lit "a")) (fpbsl-t-nothing)))
    (defn fpbslb-unsupported-template-spec ()
        (fpbslb-single-rule-spec
            (p-lit "a") (list "result-unknown" 1)))
    (defn fpbslb-fractional-limit-spec ()
        (fpbslb-spec-for (fpbslb-decision-grammar)
            (list (fpbslb-digit-class))
            (fpbsl-limits 3.5 96 512 16 64 2048 1024 64)))

    (defn fpbslb-exact-query-limits (ir)
        (do
            (let rules (fpbsl-grammar-rules (fpbslb-query-grammar)))
            (let captures (fpbsl-rules-captures rules))
            (fpbsl-limits
                (len rules)
                (fpbsl-rules-pattern-count rules)
                (fpbsl-rules-literal-bytes rules)
                (len captures)
                (fpbsl-rules-template-count rules)
                (len (nth ir 2))
                (len (nth ir 3))
                (len (nth ir 1)))))
    (defn fpbslb-query-spec-with-limits (limits)
        (fpbslb-spec-for (fpbslb-query-grammar)
            (list (fpbslb-concept-class)) limits))

    (defn form-program-image-bmf-subset-lower-band ()
        (do
            (let query (fpbsl-lower (fpbslb-query-spec)))
            (let decision (fpbsl-lower (fpbslb-decision-spec)))
            (let query-ir (fpbsl-ir query))
            (let decision-ir (fpbsl-ir decision))
            (let query-link (fpis-link query-ir))
            (let decision-link (fpis-link decision-ir))
            (let exact-limits (fpbslb-exact-query-limits query-ir))
            (let exact (fpbsl-lower
                (fpbslb-query-spec-with-limits exact-limits)))
            (let row-low-limits (fpbsl-limits
                (fpbsl-limit exact-limits 0)
                (fpbsl-limit exact-limits 1)
                (fpbsl-limit exact-limits 2)
                (fpbsl-limit exact-limits 3)
                (fpbsl-limit exact-limits 4)
                (sub (fpbsl-limit exact-limits 5) 1)
                (fpbsl-limit exact-limits 6)
                (fpbsl-limit exact-limits 7)))
            (let string-low-limits (fpbsl-limits
                (fpbsl-limit exact-limits 0)
                (fpbsl-limit exact-limits 1)
                (fpbsl-limit exact-limits 2)
                (fpbsl-limit exact-limits 3)
                (fpbsl-limit exact-limits 4)
                (fpbsl-limit exact-limits 5)
                (sub (fpbsl-limit exact-limits 6) 1)
                (fpbsl-limit exact-limits 7)))
            (let function-low-limits (fpbsl-limits
                (fpbsl-limit exact-limits 0)
                (fpbsl-limit exact-limits 1)
                (fpbsl-limit exact-limits 2)
                (fpbsl-limit exact-limits 3)
                (fpbsl-limit exact-limits 4)
                (fpbsl-limit exact-limits 5)
                (fpbsl-limit exact-limits 6)
                (sub (fpbsl-limit exact-limits 7) 1)))
            (let replay (fpbsl-lower (fpbslb-query-spec)))
            (let mutation-spec (fpbslb-spec-for
                (fpbslb-decision-grammar-with-allow "permit:")
                (list (fpbslb-digit-class)) (fpbslb-limits)))
            (let mutation (fpbsl-lower mutation-spec))
            (let forged (fpbsl-linked-descriptor
                (fpbslb-decision-spec) query-ir))
            (fpbslb-sum (list
                (fpbslb-bit (and (fpbsl-linked-descriptor? query)
                    (fpbsl-observed? (fpbslb-query-spec) query)) 1)
                (fpbslb-bit (and (fpbsl-linked-descriptor? decision)
                    (fpbsl-observed? (fpbslb-decision-spec) decision)) 2)
                (fpbslb-bit (and (fpis-linked? query-link)
                    (fpis-linked? decision-link)) 4)
                (fpbslb-bit (not (value_eq
                    (pif-table-numeric-stream (fpis-table query-link))
                    (pif-table-numeric-stream (fpis-table decision-link)))) 8)
                (fpbslb-bit (and
                    (eq (len (nth query-ir 1)) 4)
                    (eq (len (nth decision-ir 1)) 10)) 16)
                (fpbslb-bit (and
                    (eq (fpbslb-ir-tag-count (nth query-ir 2) 91) 1)
                    (eq (fpbslb-ir-tag-count (nth query-ir 2) 47) 1)) 32)
                (fpbslb-bit (and
                    (gt (fpbslb-ir-tag-count (nth decision-ir 2) 12)
                        (fpbslb-ir-tag-count (nth query-ir 2) 12))
                    (gt (fpbslb-ir-tag-count (nth decision-ir 2) 137) 0)) 64)
                (fpbslb-bit (and
                    (fpbslb-string-row-present? (nth decision-ir 3)
                        (fpbsl-string-bytes "allow:"))
                    (fpbslb-string-row-present? (nth decision-ir 3)
                        (fpbsl-string-bytes "deny:"))) 128)
                (fpbslb-bit (and
                    (not (str_eq (nth (head (nth query-ir 1)) 1)
                        (nth (nth (nth query-ir 1) 3) 1)))
                    (not (str_eq (nth (head (nth decision-ir 1)) 1)
                        (nth (nth (nth decision-ir 1) 3) 1)))) 256)
                (fpbslb-bit (and
                    (fpbslb-refusal? (fpbsl-lower
                        (fpbslb-duplicate-rule-spec)) "duplicate-rule")
                    (and
                    (fpbslb-refusal? (fpbsl-lower
                        (fpbslb-unresolved-ref-spec))
                        "pattern-unsupported-or-unresolved")
                    (and
                    (fpbslb-refusal? (fpbsl-lower
                        (fpbslb-cycle-spec)) "reference-cycle")
                    (and
                    (fpbslb-refusal? (fpbsl-lower
                        (fpbslb-duplicate-class-spec)) "duplicate-class")
                    (fpbslb-refusal? (fpbsl-lower
                        (fpbslb-invalid-range-spec)) "class-shape"))))) 512)
                (fpbslb-bit (and
                    (fpbslb-refusal? (fpbsl-lower
                        (fpbslb-cap-non-run-spec))
                        "pattern-unsupported-or-unresolved")
                    (and
                    (fpbslb-refusal? (fpbsl-lower
                        (fpbslb-undefined-capture-spec))
                        "result-template-invalid")
                    (and
                    (fpbslb-refusal? (fpbsl-lower
                        (fpbslb-nondefinite-capture-spec))
                        "result-template-invalid")
                    (fpbslb-refusal? (fpbsl-lower
                        (fpbslb-duplicate-capture-spec))
                        "duplicate-capture")))) 1024)
                (fpbslb-bit (and
                    (fpbslb-refusal? (fpbsl-lower
                        (fpbslb-unsupported-pattern-spec))
                        "pattern-unsupported-or-unresolved")
                    (and
                    (fpbslb-refusal? (fpbsl-lower
                        (fpbslb-unsupported-template-spec))
                        "result-template-invalid")
                    (fpbslb-refusal? (fpbsl-lower
                        (fpbslb-fractional-limit-spec))
                        "limits-shape"))) 2048)
                (fpbslb-bit (and
                    (fpbsl-linked-descriptor?
                        (fpbsl-lower
                            (fpbslb-decision-spec-with-rule-limit 3)))
                    (fpbslb-refusal?
                        (fpbsl-lower
                            (fpbslb-decision-spec-with-rule-limit 2))
                        "rule-bound")) 4096)
                (fpbslb-bit (and
                    (fpbsl-linked-descriptor? exact)
                    (and
                    (fpbslb-refusal? (fpbsl-lower
                        (fpbslb-query-spec-with-limits row-low-limits))
                        "emitted-row-bound")
                    (and
                    (fpbslb-refusal? (fpbsl-lower
                        (fpbslb-query-spec-with-limits string-low-limits))
                        "emitted-string-bound")
                    (fpbslb-refusal? (fpbsl-lower
                        (fpbslb-query-spec-with-limits function-low-limits))
                        "emitted-function-bound")))) 8192)
                (fpbslb-bit (and
                    (value_eq query-ir (fpbsl-ir replay))
                    (fpbsl-observed? (fpbslb-query-spec) replay)) 16384)
                (fpbslb-bit (and
                    (fpbsl-linked-descriptor? mutation)
                    (and
                    (not (value_eq decision-ir (fpbsl-ir mutation)))
                    (and
                    (eq (fpbsl-linked-descriptor? forged) 0)
                    (nothing? (fpbsl-ir forged))))) 32768)))))

    (form-program-image-bmf-subset-lower-band))
; expect 65535
