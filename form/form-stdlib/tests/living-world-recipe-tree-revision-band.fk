; living-world-recipe-tree-revision-band.fk -- 31 checks for source-disjoint
; prospective contradiction assimilation into a reversible composition field.
; target: 2147483647
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-witness.fk

(defn lwrtrb-bit (ok bit) (if ok bit 0))

(defn lwrtrb-run ()
    (do
        (let result (lwrtrw-run))
        (let successor (nth (node_children result) 1))
        (let match (nth (node_children result) 2))
        (let suite (nth (node_children result) 3))
        (let tree (nth (node_children result) 5))
        (let base-world (nth (node_children result) 6))
        (let open-field (nth (node_children result) 7))
        (let one-world (nth (node_children result) 8))
        (let one-field (nth (node_children result) 9))
        (let two-world (nth (node_children result) 10))
        (let field (nth (node_children result) 11))
        (let proposal (nth (node_children result) 12))
        (let candidate (nth (node_children result) 13))
        (let waiting (nth (node_children result) 14))
        (let admitted (nth (node_children result) 15))
        (let composition (nth (node_children result) 16))
        (let recipe (nth (node_children result) 17))
        (let revoked-world (nth (node_children result) 18))
        (let revoked-field (nth (node_children result) 19))
        (let admitted-current
            (node_value (nth (node_children result) 20)))
        (let admitted-successor-current
            (node_value (nth (node_children result) 21)))
        (let revoked-candidate-current
            (node_value (nth (node_children result) 22)))
        (let revoked-successor-current
            (node_value (nth (node_children result) 23)))
        (let revoked-suite-current
            (node_value (nth (node_children result) 24)))
        (let events (nth (node_children result) 25))
        (let blueprint (lwrtrw-tree-blueprint tree))
        (let blueprint-sources
            (lwrth-direct-sources two-world blueprint))
        (let ancestors
            (lwrtr-ancestor-sources two-world match suite))
        (let retained (lwrtr-composition-retained composition))
        (let metrics (lwrtr-composition-metrics composition))
        (let root-args
            (lwrt-application-arguments (lwrtrw-tree-root tree)))
        (let admitted-world (lwt-round-world admitted))
        (sum (list
            (lwrtrb-bit
                (and (eq (lwrth-candidate? successor) 1)
                     (eq (lwo-active? base-world successor) 1)) 1)
            (lwrtrb-bit
                (eq (lwo-field-size
                        (lwrtr-successor-contradicted-cases
                            successor suite)) 1) 2)
            (lwrtrb-bit
                (eq (lwo-field-size
                        (lwrtr-field-blueprints open-field)) 0) 4)
            (lwrtrb-bit
                (eq (lwo-field-size
                        (lwrtr-field-blueprints one-field)) 0) 8)
            (lwrtrb-bit
                (eq (lwo-field-size
                        (lwrth-direct-sources one-world blueprint)) 1) 16)
            (lwrtrb-bit
                (eq (lwo-field-size
                        (lwrtr-field-blueprints field)) 1) 32)
            (lwrtrb-bit
                (eq (lwo-field-size
                        (lwrtr-field-compositions field)) 1) 64)
            (lwrtrb-bit
                (eq (lwo-field-size
                        (lwrtr-field-compatible field)) 1) 128)
            (lwrtrb-bit
                (eq (lwo-field-size
                        (lwrtr-field-divergent field)) 0) 256)
            (lwrtrb-bit
                (eq (lwhrn-ready? (lwrtr-field-status field)) 1) 512)
            (lwrtrb-bit
                (eq (lwo-field-has?
                        (lwrtr-field-blueprints field) blueprint) 1) 1024)
            (lwrtrb-bit
                (eq (lwo-field-size blueprint-sources) 2) 2048)
            (lwrtrb-bit
                (eq (lwo-field-size ancestors) 6) 4096)
            (lwrtrb-bit
                (eq (lwrth-fields-disjoint?
                        blueprint-sources ancestors) 1) 8192)
            (lwrtrb-bit
                (node_eq
                    (nth (lwrt-argument-items root-args) 2)
                    (lwrtr-prior-root match)) 16384)
            (lwrtrb-bit (eq (lwre-recipe-valid? recipe) 1) 32768)
            (lwrtrb-bit
                (not (node_eq recipe (lwrth-match-recipe match))) 65536)
            (lwrtrb-bit
                (gt (str_len (lwre-recipe-source recipe))
                    (str_len (lwre-recipe-source
                        (lwrth-match-recipe match)))) 131072)
            (lwrtrb-bit
                (eq (lwo-field-size retained) 3) 262144)
            (lwrtrb-bit
                (eq (lwph-consistent?
                        (lwhrn-evaluation-state-items
                            (lwo-field-items retained) 0 0 0)) 1) 524288)
            (lwrtrb-bit
                (and (eq (lwps-metrics-value metrics 0) 5)
                     (eq (lwps-metrics-value metrics 1) 3)) 1048576)
            (lwrtrb-bit
                (eq (lwps-metrics-value metrics 2) 3) 2097152)
            (lwrtrb-bit
                (and (eq (lwps-metrics-value metrics 3) 0)
                     (eq (lwps-metrics-value metrics 4) 0)) 4194304)
            (lwrtrb-bit
                (eq (lwph-consistent?
                        (lwrtr-composition-state composition)) 1) 8388608)
            (lwrtrb-bit
                (not (node_eq proposal (lwo-none))) 16777216)
            (lwrtrb-bit
                (eq (lwo-active?
                        (lwt-round-world waiting) candidate) 0) 33554432)
            (lwrtrb-bit
                (and (eq admitted-current 1)
                     (eq (lwo-active? admitted-world recipe) 0)) 67108864)
            (lwrtrb-bit
                (and (eq admitted-successor-current 1)
                     (eq (len events) 21)) 134217728)
            (lwrtrb-bit
                (eq revoked-candidate-current 0) 268435456)
            (lwrtrb-bit
                (and (eq (lwo-field-size
                            (lwrtr-field-blueprints revoked-field)) 0)
                     (and (eq revoked-successor-current 1)
                          (eq revoked-suite-current 1))) 536870912)
            (lwrtrb-bit
                (eq (lwo-member?
                        (lwo-field-items (lwo-world-cells revoked-world))
                        blueprint) 1) 1073741824)))))

(lwrtrb-run)
