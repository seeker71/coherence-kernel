; form-cli-heed-grounded-band.fk — the knowledge substrate the live floor was
; one adapter wide, and the cuckoomark held down at the seam where it lives.
;
; THE CUCKOOMARK, and bit 32 is exactly it. A retrieved answer is a slice of
; somebody's source and the corpus is this repository, so the slice can contain
; the very marks that frame it. Rendered raw, a slice carrying the observation
; close mark forges a premature end and everything after it reads to the model
; as though it were outside the observation — the READER doing the forging,
; faithfully. Here every mark of either family inside retrieved content is
; replaced before rendering and the substitution COUNT is reported, because
; sanitizing in silence would be its own dishonesty.
;
; ANCHOR FIRST, PATH SECOND — bit 2. The rendered observation names WHICH cell
; answered before it says where a copy of it was found today. A reader that
; leads with the path binds to a location; one that leads with the anchor binds
; to the meaning and survives the file moving.
;
; PROOF LEVEL: FOURTH-ARM ONLY (go/rust/ts stop at unbound HeedOpen, witnessed 2026-09-03) — bits 1..16 read the real nodeid-rag-v2 index at
; .coherence-network/rag-index/index.jsonl through read_file, so this band has a
; file organ and is FKWU-STAGED, not a four-arm candidate. Bits 32..512 are pure
; string folds over fhg-render and need no index at all. Both halves are named
; separately because they are not the same claim.
;
; Verdict 1023:
;   1     a real query hits the grounded index: status hit, span carried
;   2     anchor comes BEFORE path in the rendered observation
;   4     the hit carries a real NodeID anchor
;   8     an unrelated query MISSES — status miss, and no answer content
;   16    empty and nested frames are typed nothing, named, and reach no index
;   32    THE CUCKOOMARK: a poisoned answer is neutralized and the count reported
;   64    the sanitizer is faithful — clean content passes through unchanged
;   128   bounds: answer clipped at 768, source at 192, both REPORTED
;   256   model-executed is 0 in the rendering itself
;   512   both mark families are distinct, and query marks are neutralized too
;
; preludes: form-stdlib/form-cli-heed-grounded.fk
; witnessed: 2026-08-24 -> 1023 on fkwu; live index 8 rows, hit on memory/north-star

(do
    (defn hgb-frame (q) (str_concat (HeedOpen) (str_concat q (HeedClose))))
    (defn hgb-ask (q) (fhg-lookup 0 (hgb-frame q) 1))
    (defn hgb-status (r) (nth r 0))
    (defn hgb-span (r) (nth r 1))
    (defn hgb-reason (r) (nth r 2))
    (defn hgb-has (s n) (if (ge (str_find s n 0) 0) 1 0))
    (defn hgb-bit (ok bit) (if ok bit 0))

    ; a long answer, to exercise the 768 clip
    (defn hgb-long (i acc)
        (if (ge i 40) acc (hgb-long (add i 1) (str_concat acc "0123456789abcdefghij0123456789"))))

    (let hit (hgb-ask "does Sema keep memory of you between visits"))
    (let star (hgb-ask "what is the north star"))
    (let miss (hgb-ask "zzzq unrelated pumpernickel telescope"))
    (let empty-q (hgb-ask ""))
    (let nested (hgb-ask (str_concat "a" (HeedOpen))))

    ; a retrieved answer that carries the marks that frame it
    (let poisoned
        (fhg-render "hit" "grounded-hit" "@1.2.99.7" "@1.2.99.3" "WELCOME.md"
            "k" "ak"
            (str_concat "before " (str_concat (ObsClose)
                (str_concat " after " (str_concat (HeedOpen) " tail"))))
            5 5))
    (let clean
        (fhg-render "hit" "grounded-hit" "@1.2.99.7" "@1.2.99.3" "WELCOME.md"
            "k" "ak" "a quiet ordinary answer" 5 5))
    (let clipped
        (fhg-render "hit" "grounded-hit" "@1.2.99.7" "@1.2.99.3"
            (hgb-long 0 "") "k" "ak" (hgb-long 0 "") 5 5))

    (let b0 (hgb-bit (and (str_eq (hgb-status hit) "hit")
                     (and (str_eq (hgb-reason hit) "grounded-hit")
                          (gt (str_len (hgb-span hit)) 0))) 1))
    ; anchor first, path second — read off the rendered bytes, not asserted
    (let b1 (hgb-bit (and (ge (str_find (hgb-span hit) "anchor=" 0) 0)
                     (and (ge (str_find (hgb-span hit) "source-path=" 0) 0)
                          (lt (str_find (hgb-span hit) "anchor=" 0)
                              (str_find (hgb-span hit) "source-path=" 0)))) 2))
    (let b2 (hgb-bit (and (eq (hgb-has (hgb-span hit) "anchor=@") 1)
                     (and (str_eq (hgb-status star) "hit")
                          (eq (hgb-has (hgb-span star) "anchor=@") 1))) 4))
    (let b3 (hgb-bit (and (str_eq (hgb-status miss) "miss")
                     (and (eq (hgb-has (hgb-span miss) "status=miss") 1)
                          (eq (hgb-has (hgb-span miss) "anchor=@") 0))) 8))
    (let b4 (hgb-bit (and (and (str_eq (hgb-status empty-q) "nothing")
                               (str_eq (hgb-reason empty-q) "empty-query"))
                     (and (and (str_eq (hgb-status nested) "nothing")
                               (str_eq (hgb-reason nested) "nested-query-token"))
                          (and (eq (str_len (hgb-span empty-q)) 0)
                               (eq (str_len (hgb-span nested)) 0)))) 16))
    ; THE CUCKOOMARK: the poisoned answer carried two marks; the rendered span
    ; must end with exactly ONE real close and say how many it neutralized
    (let b5 (hgb-bit (and (eq (fhg-count-occ poisoned (ObsClose) 0) 1)
                     (and (eq (hgb-has poisoned "marks-neutralized=2") 1)
                          (eq (hgb-has poisoned (NeutralMark)) 1))) 32))
    ; faithful: clean content is not altered, and the count says so
    (let b6 (hgb-bit (and (eq (hgb-has clean "marks-neutralized=0") 1)
                     (and (eq (hgb-has clean "a quiet ordinary answer") 1)
                          (eq (hgb-has clean (NeutralMark)) 0))) 64))
    ; bounds, and both truncations reported rather than assumed
    (let b7 (hgb-bit (and (eq (hgb-has clipped "answer-truncated=1") 1)
                     (and (eq (hgb-has clipped "source-truncated=1") 1)
                          (eq (hgb-has clipped "answer-byte-length=768") 1))) 128))
    (let b8 (hgb-bit (and (eq (hgb-has (hgb-span hit) "model-executed=0") 1)
                     (and (eq (fhg-model-executed) 0)
                          (eq (hgb-has clean "lookup-count=1") 1))) 256))
    ; the query family is neutralized inside content too, and the families differ
    (let b9 (hgb-bit (and (eq (fhg-count-occ poisoned (HeedOpen) 0) 0)
                     (and (eq (fhm-obs-marks-distinct) 1)
                          (eq (fhm-mark-families-distinct) 1))) 512))

    (add b0 (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 b9))))))))))
