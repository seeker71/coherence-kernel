; Isolate the exact 39-pipeline DS4 stack organ from model buffers and decode.
; preludes: native/metal/dsv4-decode-stack.fk
(do
  (let hmsl (dfd-hc-msl))
  (let mslm (str_concat (dfd-msl-pragma) (mla-msl-unit)))
  (let fmsl (dfd-ffn-msl))
  (let cmsl (dfd-comp-msl))
  (let amsl (str_concat (dfd-msl-pragma)
              (str_concat (ldm-argmax-part-msl "form_argmax_part_f32")
                          (ldm-argmax-comb-msl "form_argmax_comb_f32"))))
  (let pipes (list
    (metal_pipeline (dfd-embed-msl) "form_dsv4_embed_f16_u32")
    (metal_pipeline hmsl "form_hc_broadcast_f32")
    (metal_pipeline hmsl "form_hc_rmsnorm_nw_wide_f32")
    (metal_pipeline (dfd-f16-msl) "form_dsv4_f16_matvec")
    (metal_pipeline hmsl "form_hc_split_seq4_f32")
    (metal_pipeline hmsl "form_hc_wsum_f32")
    (metal_pipeline hmsl "form_hc_post_f32")
    (metal_pipeline (dfd-slice-msl) "dfd_slice")
    (metal_pipeline mslm "form_mla_rmsnorm_reduce_f32")
    (metal_pipeline mslm "form_mla_rmsnorm_apply_f32")
    (metal_pipeline mslm "form_mla_headrms_f32")
    (metal_pipeline mslm "form_mla_rope_f32")
    (metal_pipeline mslm "form_mla_attend_mixed_f32")
    (metal_pipeline (dfd-freqs-msl) "dfd_freqs")
    (metal_pipeline (dfd-kvq-msl) "form_dsv4_kv_fp8_f16_round_par")
    (metal_pipeline (dfd-append-msl) "dfd_kv_append")
    (dfd-mv-pipe 8)
    (dfd-mvg-pipe 8)
    (metal_pipeline fmsl "form_dsv4_hash_select")
    (metal_pipeline fmsl "form_dsv4_hash_probs")
    (metal_pipeline fmsl "form_dsv4_hash_wts")
    (metal_pipeline fmsl "form_dsv4_topk_probs")
    (metal_pipeline fmsl "form_dsv4_topk_select_tg6")
    (metal_pipeline fmsl "form_dsv4_swiglu_f32")
    (metal_pipeline fmsl "form_dsv4_swiglu_experts")
    (metal_pipeline fmsl "form_dsv4_moe_reduce")
    (metal_pipeline fmsl "form_dsv4_scale_f32")
    (metal_pipeline fmsl "form_dsv4_axpy_f32")
    (metal_pipeline (dfd-iq2e-fast-msl) "form_dsv4_iq2_matvec_experts4_fast")
    (metal_pipeline (dfd-q2ke-msl) "form_dsv4_q2k_matvec_experts")
    (metal_pipeline cmsl "form_dsv4_comp_state_f32")
    (metal_pipeline cmsl "form_dsv4_comp_pool_f32")
    (metal_pipeline cmsl "form_dsv4_comp_shift_f32")
    (metal_pipeline hmsl "form_hc_headw_f32")
    (metal_pipeline amsl "form_argmax_part_f32")
    (metal_pipeline amsl "form_argmax_comb_f32")
    (metal_pipeline (dfd-idchain-msl) "form_dsv4_embed_f16_u32_idx")
    (metal_pipeline (dfd-idchain-msl) "form_dsv4_hash_select_idx")
    (metal_pipeline (dfd-idchain-msl) "form_dsv4_copy_u32")))
  (let ready (dfd-handles-positive-n pipes 39))
  (list (nothing) 1001100003 (len pipes) ready (metal_status)
        (if (and (eq (len pipes) 39) (eq ready 1)) 1 0)))
