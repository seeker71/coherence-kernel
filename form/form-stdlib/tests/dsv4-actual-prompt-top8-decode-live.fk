; Decode the exact top-eight candidates from the prompt-conditioned first-token
; output-head receipt. No model arithmetic is rerun.
; witnessed: 2026-07-29 -> 255 (eight byte-exact candidate decodes)
;
; preludes: form-stdlib/dsv4-tokenizer.fk config/dsv4-local-resource.fk

(do
    (defn dat8-bytes (bytes)
        (if (eq (len bytes) 0) ""
            (if (eq (len (tail bytes)) 0)
                (int_to_str (head bytes))
                (str_concat
                    (int_to_str (head bytes))
                    (str_concat "," (dat8-bytes (tail bytes)))))))

    (defn dat8-row (src rank token score)
        (do
            (print_str
                (str_concat "rank=" (int_to_str rank)))
            (print_str
                (str_concat "token-id=" (int_to_str token)))
            (print_str
                (str_concat "score=" score))
            (print_str
                (str_concat "bytes="
                    (dat8-bytes
                        (tkz-decode-id-bytes src token))))
            (print_str
                (str_concat "text="
                    (tkz-decode-text src (list token))))
            1))

    (let src
        (tkz-src (dsv4-local-model-resource)))
    (let observed
        (add
            (dat8-row src 1 32111 "34.9362488")
            (add
                (dat8-row src 2 8229 "34.8442574")
                (add
                    (dat8-row src 3 39111 "33.5957375")
                    (add
                        (dat8-row src 4 5718 "31.5503101")
                        (add
                            (dat8-row src 5 9544 "31.328043")
                            (add
                                (dat8-row src 6 671 "30.3695087")
                                (add
                                    (dat8-row src 7 43 "30.356802")
                                    (dat8-row src 8 372
                                        "29.5291481")))))))))
    (if (eq observed 8) 255 0))
