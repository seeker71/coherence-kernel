// Native identity layout, sign boundaries, exact equality and mapped readers.
// preludes: form/form-stdlib/bml/native-node-word.bml
section [form.bml] {
 def nnwb-check(name, held, bit) { print(list(name, held)); if eq(held, 1) then bit else 0; }
 def nnwb-coordinates(node, p, l, t, i) = and(eq(node_pkg(node), p), and(eq(node_level(node), l), and(eq(node_type(node), t), eq(node_inst(node), i))));
 let u32max = sub(nnw-instance-capacity(), 1);
 let maximum = make_nodeid(63, 8191, 4095, u32max);
 let zero = make_nodeid(0, 0, 0, 0);
 let integerMax = add(mul(nnw-power(31), sub(nnw-power(31), 1)), sub(nnw-power(31), 1));
 let integerMin = sub(sub(0, integerMax), 1);
 let upper = make_nodeid(1, 1, 1, integerMax);
 let lower = make_nodeid(1, 1, 1, integerMin);
 let negative = intern_trivial_int(sub(0, 2));
 let descriptor = make_nodeid(1, 1, 1, sub(0, 2));
 let map = cell_map(host_pid());
 let word = cell_ref(maximum);
 let mapped = and(eq(cell_field(map, word, 4), 63), and(eq(cell_field(map, word, 5), 8191), and(eq(cell_field(map, word, 6), 4095), eq(cell_field(map, word, 7), u32max))));
 let closed = cell_unmap(map);
 let countBefore = kernel_stat(4);
 let logicalBytes = kernel_stat(61);
 let countAfter = kernel_stat(4);
 let result = sum(list(
  nnwb-check("one-native-word", eq(kernel_stat(63), 8), 1),
  nnwb-check("generated-authority", str_eq(read_file("runtime/fkwu-node-word.h"), nnw-header()), 2),
  nnwb-check("non-byte-field-maxima", nnwb-coordinates(maximum, 63, 8191, 4095, u32max), 4),
  nnwb-check("zero-coordinate", nnwb-coordinates(zero, 0, 0, 0, 0), 8),
  nnwb-check("signed-upper", nnwb-coordinates(upper, 1, 1, 1, integerMax), 16),
  nnwb-check("signed-lower", nnwb-coordinates(lower, 1, 1, 1, integerMin), 32),
  nnwb-check("word-equality", eq(maximum, make_nodeid(63, 8191, 4095, u32max)), 64),
  nnwb-check("field-separation", and(not(eq(make_nodeid(1, 0, 0, 0), make_nodeid(0, 1, 0, 0))), and(not(eq(make_nodeid(0, 1, 0, 0), make_nodeid(0, 0, 1, 0))), not(eq(make_nodeid(0, 0, 1, 0), make_nodeid(0, 0, 0, 1))))), 128),
  nnwb-check("kind-semantics", and(not(eq(negative, descriptor)), not(node_eq(negative, descriptor))), 256),
  nnwb-check("mapped-word-fields", mapped, 512),
  nnwb-check("live-lexicon-level", nnwb-coordinates(make_nodeid(32, 7000, 2026, 617), 32, 7000, 2026, 617), 1024),
  nnwb-check("one-past-each-field", and(not(nnw-valid?(64, 0, 0, 0)), and(not(nnw-valid?(0, 8192, 0, 0)), and(not(nnw-valid?(0, 0, 4096, 0)), not(nnw-valid?(0, 0, 0, nnw-instance-capacity()))))), 2048),
  nnwb-check("typed-admission", and(not(nnw-valid?(1.5, 1, 1, 1)), and(not(nnw-valid?(1, 1, 1, "1")), not(nnw-valid?(nothing(), 1, 1, 1)))), 4096),
  nnwb-check("logical-column-bytes", and(eq(mod(logicalBytes, 80), 0), and(ge(logicalBytes, mul(countBefore, 80)), le(logicalBytes, mul(countAfter, 80)))), 8192),
  nnwb-check("mapped-reader-released", nothing?(cell_field(map, word, 4)), 16384)));
 print(result);
 if eq(result, 32767) then result else form_error("native node word contract failed");
}
