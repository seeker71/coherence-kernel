(let LWPTW-SPECIES       (bp "LWPTW-SPECIES"))
(let LWPTW-TISSUE        (bp "LWPTW-TISSUE"))
(let LWPTW-PREDICTION    (bp "LWPTW-PREDICTION"))
(let LWPTW-EXPERIENCE    (bp "LWPTW-EXPERIENCE"))
(let LWPTW-SOURCE-A      (bp "LWPTW-SOURCE-A"))
(let LWPTW-SOURCE-B      (bp "LWPTW-SOURCE-B"))
(let LWPTW-SOURCE-C      (bp "LWPTW-SOURCE-C"))
(let LWPTW-SOURCE-D      (bp "LWPTW-SOURCE-D"))
(let LWPTW-SOURCE-E      (bp "LWPTW-SOURCE-E"))
(let LWPTW-SOURCE-F      (bp "LWPTW-SOURCE-F"))
(let LWPTW-SOURCE-G      (bp "LWPTW-SOURCE-G"))
(let LWPTW-SOURCE-H      (bp "LWPTW-SOURCE-H"))
(let LWPTW-SOURCE-I      (bp "LWPTW-SOURCE-I"))
(let LWPTW-SOURCE-J      (bp "LWPTW-SOURCE-J"))
(let LWPTW-SOURCE-K      (bp "LWPTW-SOURCE-K"))
(let LWPTW-SOURCE-L      (bp "LWPTW-SOURCE-L"))
(let LWPTW-SOURCE-M      (bp "LWPTW-SOURCE-M"))
(let LWPTW-SOURCE-N      (bp "LWPTW-SOURCE-N"))
(let LWPTW-SOURCE-O      (bp "LWPTW-SOURCE-O"))
(let LWPTW-SOURCE-P      (bp "LWPTW-SOURCE-P"))
(let LWPTW-PROV-A        (bp "LWPTW-PROV-A"))
(let LWPTW-PROV-B        (bp "LWPTW-PROV-B"))
(let LWPTW-PROV-C        (bp "LWPTW-PROV-C"))
(let LWPTW-PROV-D        (bp "LWPTW-PROV-D"))
(let LWPTW-PROV-E        (bp "LWPTW-PROV-E"))
(let LWPTW-PROV-F        (bp "LWPTW-PROV-F"))
(let LWPTW-PROV-G        (bp "LWPTW-PROV-G"))
(let LWPTW-PROV-H        (bp "LWPTW-PROV-H"))
(let LWPTW-PROV-I        (bp "LWPTW-PROV-I"))
(let LWPTW-PROV-J        (bp "LWPTW-PROV-J"))
(let LWPTW-PROV-K        (bp "LWPTW-PROV-K"))
(let LWPTW-PROV-L        (bp "LWPTW-PROV-L"))
(let LWPTW-PROV-M        (bp "LWPTW-PROV-M"))
(let LWPTW-PROV-N        (bp "LWPTW-PROV-N"))
(let LWPTW-PROV-O        (bp "LWPTW-PROV-O"))
(let LWPTW-PROV-P        (bp "LWPTW-PROV-P"))
(let LWPTW-DIRECTION-P   (bp "LWPTW-DIRECTION-P"))
(let LWPTW-DIRECTION-Q   (bp "LWPTW-DIRECTION-Q"))
(let LWPTW-FOCUS         (bp "LWPTW-FOCUS"))
(let LWPTW-CONTEXT       (bp "LWPTW-CONTEXT"))
(let LWPTW-SIGNAL-H      (bp "LWPTW-SIGNAL-H"))
(let LWPTW-SIGNAL-A      (bp "LWPTW-SIGNAL-A"))
(let LWPTW-SIGNAL-B      (bp "LWPTW-SIGNAL-B"))
(let LWPTW-ALTERNATIVE   (bp "LWPTW-ALTERNATIVE"))
(let LWPTW-EVIDENCE      (bp "LWPTW-EVIDENCE"))
(let LWPTW-REASON        (bp "LWPTW-REASON"))

(defn lwptw-cell (kind) (intern_node kind (empty)))
(defn lwptw-source-a () (lwptw-cell LWPTW-SOURCE-A))
(defn lwptw-source-b () (lwptw-cell LWPTW-SOURCE-B))
(defn lwptw-source-c () (lwptw-cell LWPTW-SOURCE-C))
(defn lwptw-source-d () (lwptw-cell LWPTW-SOURCE-D))
(defn lwptw-source-e () (lwptw-cell LWPTW-SOURCE-E))
(defn lwptw-source-f () (lwptw-cell LWPTW-SOURCE-F))
(defn lwptw-source-g () (lwptw-cell LWPTW-SOURCE-G))
(defn lwptw-source-h () (lwptw-cell LWPTW-SOURCE-H))
(defn lwptw-source-i () (lwptw-cell LWPTW-SOURCE-I))
(defn lwptw-source-j () (lwptw-cell LWPTW-SOURCE-J))
(defn lwptw-source-k () (lwptw-cell LWPTW-SOURCE-K))
(defn lwptw-source-l () (lwptw-cell LWPTW-SOURCE-L))
(defn lwptw-source-m () (lwptw-cell LWPTW-SOURCE-M))
(defn lwptw-source-n () (lwptw-cell LWPTW-SOURCE-N))
(defn lwptw-source-o () (lwptw-cell LWPTW-SOURCE-O))
(defn lwptw-source-p () (lwptw-cell LWPTW-SOURCE-P))
(defn lwptw-prov-a () (lwptw-cell LWPTW-PROV-A))
(defn lwptw-prov-b () (lwptw-cell LWPTW-PROV-B))
(defn lwptw-prov-c () (lwptw-cell LWPTW-PROV-C))
(defn lwptw-prov-d () (lwptw-cell LWPTW-PROV-D))
(defn lwptw-prov-e () (lwptw-cell LWPTW-PROV-E))
(defn lwptw-prov-f () (lwptw-cell LWPTW-PROV-F))
(defn lwptw-prov-g () (lwptw-cell LWPTW-PROV-G))
(defn lwptw-prov-h () (lwptw-cell LWPTW-PROV-H))
(defn lwptw-prov-i () (lwptw-cell LWPTW-PROV-I))
(defn lwptw-prov-j () (lwptw-cell LWPTW-PROV-J))
(defn lwptw-prov-k () (lwptw-cell LWPTW-PROV-K))
(defn lwptw-prov-l () (lwptw-cell LWPTW-PROV-L))
(defn lwptw-prov-m () (lwptw-cell LWPTW-PROV-M))
(defn lwptw-prov-n () (lwptw-cell LWPTW-PROV-N))
(defn lwptw-prov-o () (lwptw-cell LWPTW-PROV-O))
(defn lwptw-prov-p () (lwptw-cell LWPTW-PROV-P))
(defn lwptw-evidence () (lwptw-cell LWPTW-EVIDENCE))
(defn lwptw-reason () (lwptw-cell LWPTW-REASON))
(defn lwptw-focus () (lwptw-cell LWPTW-FOCUS))
(defn lwptw-alternative () (lwptw-cell LWPTW-ALTERNATIVE))
(defn lwptw-signal-h () (lwptw-cell LWPTW-SIGNAL-H))
(defn lwptw-signal-a () (lwptw-cell LWPTW-SIGNAL-A))
(defn lwptw-signal-b () (lwptw-cell LWPTW-SIGNAL-B))

(defn lwptw-entry (source provenance payload)
    (lwtnw-entry source provenance payload))
(defn lwptw-entry-a (payload) (lwptw-entry (lwptw-source-a) (lwptw-prov-a) payload))
(defn lwptw-entry-b (payload) (lwptw-entry (lwptw-source-b) (lwptw-prov-b) payload))
(defn lwptw-entry-c (payload) (lwptw-entry (lwptw-source-c) (lwptw-prov-c) payload))
(defn lwptw-entry-d (payload) (lwptw-entry (lwptw-source-d) (lwptw-prov-d) payload))
(defn lwptw-entry-e (payload) (lwptw-entry (lwptw-source-e) (lwptw-prov-e) payload))
(defn lwptw-entry-f (payload) (lwptw-entry (lwptw-source-f) (lwptw-prov-f) payload))
(defn lwptw-entry-g (payload) (lwptw-entry (lwptw-source-g) (lwptw-prov-g) payload))
(defn lwptw-entry-h (payload) (lwptw-entry (lwptw-source-h) (lwptw-prov-h) payload))
(defn lwptw-entry-i (payload) (lwptw-entry (lwptw-source-i) (lwptw-prov-i) payload))
(defn lwptw-entry-j (payload) (lwptw-entry (lwptw-source-j) (lwptw-prov-j) payload))
(defn lwptw-entry-k (payload) (lwptw-entry (lwptw-source-k) (lwptw-prov-k) payload))
(defn lwptw-entry-l (payload) (lwptw-entry (lwptw-source-l) (lwptw-prov-l) payload))
(defn lwptw-entry-m (payload) (lwptw-entry (lwptw-source-m) (lwptw-prov-m) payload))
(defn lwptw-entry-n (payload) (lwptw-entry (lwptw-source-n) (lwptw-prov-n) payload))
(defn lwptw-entry-o (payload) (lwptw-entry (lwptw-source-o) (lwptw-prov-o) payload))
(defn lwptw-entry-p (payload) (lwptw-entry (lwptw-source-p) (lwptw-prov-p) payload))

; Exact proposal witnesses already name every consenting source and provenance.
(defn lwptw-response-items (proposal items)
    (if (eq (len items) 0) (list)
        (do
            (let attribution (head items))
            (let source (lwo-attribution-source attribution))
            (let provenance (nth (node_children attribution) 2))
            (cons
                (lwptw-entry source provenance
                    (lwt-response proposal (oac-one proposal) provenance))
                (lwptw-response-items proposal (tail items))))))
(defn lwptw-responses (proposal)
    (lwptw-response-items proposal
        (lwo-field-items
            (lwo-emergent-witnesses
                (lwt-proposal-candidate proposal)))))
(defn lwptw-answered-round (world proposal previous)
    (lwt-round-receive
        (lwt-round world (lwo-field (list proposal))
            (lwo-empty-field) previous)
        (lwptw-responses proposal)))

; Two source-distinct parameter Recipes agree without either becoming primary.
(defn lwptw-contract () (lwre-bound-form-contract 128 (lwptw-evidence)))
(defn lwptw-recipe-p ()
    (lwre-recipe "(add origin field)" (lwptw-contract) (lwptw-evidence)))
(defn lwptw-recipe-q ()
    (lwre-recipe "(add field origin)" (lwptw-contract) (lwptw-evidence)))
(defn lwptw-lens-p ()
    (lwlc-lens (lwlc-recipe-shape) (lwptw-recipe-p) (lwptw-evidence)))
(defn lwptw-lens-q ()
    (lwlc-lens (lwlc-recipe-shape) (lwptw-recipe-q) (lwptw-evidence)))
(defn lwptw-declaration-p ()
        (lwlc-declaration (lwptw-cell LWPTW-DIRECTION-P)
        (lwlc-stack (lwptw-lens-p) (lwlc-layers (list))
            (lwo-empty-field)
            (lwlc-unknown (lwptw-evidence)) (lwptw-evidence))
        (lwptw-evidence)))
(defn lwptw-declaration-q ()
    (lwlc-declaration (lwptw-cell LWPTW-DIRECTION-Q)
        (lwlc-stack (lwptw-lens-q) (lwlc-layers (list))
            (lwo-empty-field) (lwo-none) (lwptw-evidence))
        (lwptw-evidence)))

(defn lwptw-bindings (origin signal field)
    (lwre-bindings
        (list
            (lwre-binding "origin" origin origin (lwptw-evidence))
            (lwre-binding "field" signal field (lwptw-evidence)))))
(defn lwptw-history-bindings ()
    (lwptw-bindings (intern_trivial_int 1)
        (lwptw-signal-h) (intern_trivial_int 3)))
(defn lwptw-binding-origin (bindings)
    (nth (lwre-binding-items bindings) 0))
(defn lwptw-binding-field (bindings)
    (nth (lwre-binding-items bindings) 1))

(defn lwptw-offer (target recipe declaration lens)
    (lwtn-bound-offer target recipe declaration lens
        (intern_trivial_int 1)
        (lwo-field (list (lwptw-alternative)))
        (lwlc-unknown (lwptw-evidence)) (lwo-none) (lwo-none)
        (lwptw-evidence) (lwptw-history-bindings)))
(defn lwptw-offer-p (target)
    (lwptw-offer target (lwptw-recipe-p)
        (lwptw-declaration-p) (lwptw-lens-p)))
(defn lwptw-offer-q (target)
    (lwptw-offer target (lwptw-recipe-q)
        (lwptw-declaration-q) (lwptw-lens-q)))

(defn lwptw-world-with-p (base)
    (do
        (let world (lwtnw-target-world base))
        (let target (lwtnw-target base))
        (let bindings (lwptw-history-bindings))
        (lwt-receive-stream world
            (list
                (lwptw-entry-a (lwptw-signal-h))
                (lwptw-entry-b (lwptw-signal-h))
                (lwptw-entry-a (lwptw-binding-origin bindings))
                (lwptw-entry-b (lwptw-binding-origin bindings))
                (lwptw-entry-a (lwptw-binding-field bindings))
                (lwptw-entry-b (lwptw-binding-field bindings))
                (lwptw-entry-a (lwptw-recipe-p))
                (lwptw-entry-a (lwptw-declaration-p))
                (lwptw-entry-a (lwptw-offer-p target))
                (lwptw-entry-b (lwptw-offer-p target))))))

(defn lwptw-selection (world target previous)
    (do
        (let field (lwtn-field-for world target 2))
        (let proposal (lwtn-selection-proposal world target 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let answered (lwptw-answered-round world proposal previous))
        (let integrated
            (lwtn-selection-integrate answered proposal (lwigw-action)))
        (lwtnw-selection-cell integrated candidate proposal field)))
(defn lwptw-trial (selection)
    (do
        (let world (lwt-round-world (lwtnw-selection-round selection)))
        (let proposal
            (lwtn-trial-proposal world (lwtnw-selection-candidate selection)
                (lwo-none) (lwptw-evidence)))
        (let candidate (lwt-proposal-candidate proposal))
        (let answered
            (lwptw-answered-round world proposal
                (lwtnw-selection-round selection)))
        (let integrated
            (lwtn-trial-integrate answered proposal (lwigw-action)))
        (lwtnw-trial-cell integrated candidate proposal
            (lwo-emergent-shape candidate))))

(defn lwptw-revoke-p-offers (world target)
    (lwt-receive-stream world
        (list
            (lwptw-entry-a
                (lwo-revocation (lwptw-offer-p target) (lwptw-source-a)
                    (lwptw-reason) (lwptw-prov-a)))
            (lwptw-entry-b
                (lwo-revocation (lwptw-offer-p target) (lwptw-source-b)
                    (lwptw-reason) (lwptw-prov-b))))))
(defn lwptw-world-with-q (world target)
    (lwt-receive-stream world
        (list
            (lwptw-entry-c (lwptw-recipe-q))
            (lwptw-entry-c (lwptw-declaration-q))
            (lwptw-entry-c (lwptw-offer-q target))
            (lwptw-entry-d (lwptw-offer-q target)))))

; children: final history world, target fixture, P trial, Q trial
(defn lwptw-history (world base p-trial q-trial)
    (intern_node LWPTW-HISTORY (list world base p-trial q-trial)))
(defn lwptw-history-world (fixture) (nth (node_children fixture) 0))
(defn lwptw-history-base (fixture) (nth (node_children fixture) 1))
(defn lwptw-history-p (fixture) (nth (node_children fixture) 2))
(defn lwptw-history-q (fixture) (nth (node_children fixture) 3))
(defn lwptw-build-history ()
    (do
        (let base (lwtnw-build-target))
        (let target (lwtnw-target base))
        (let p-selection
            (lwptw-selection (lwptw-world-with-p base) target
                (lwtnw-target-round base)))
        (let p-trial (lwptw-trial p-selection))
        (let p-world (lwt-round-world (lwtnw-trial-round p-trial)))
        (let q-world
            (lwptw-world-with-q
                (lwptw-revoke-p-offers p-world target) target))
        (let q-selection
            (lwptw-selection q-world target (lwtnw-trial-round p-trial)))
        (let q-trial (lwptw-trial q-selection))
        (lwptw-history
            (lwt-round-world (lwtnw-trial-round q-trial))
            base p-trial q-trial)))

(defn lwptw-support (world first second)
    (do
        (let signature
            (lwbs-signature-for (lwbs-receipt-for world first)))
        (lwbs-observation first second (oac-one signature)
            (lwo-field (list (lwptw-alternative)))
            (lwlc-unknown (lwptw-evidence)) (lwptw-evidence))))
(defn lwptw-observed-world (history)
    (do
        (let world (lwptw-history-world history))
        (let first (lwtnw-trial-candidate (lwptw-history-p history)))
        (let second (lwtnw-trial-candidate (lwptw-history-q history)))
        (let direct (lwptw-support world first second))
        (let inverse (lwptw-support world second first))
        (lwt-receive-stream world
            (list
                (lwptw-entry-e direct) (lwptw-entry-f direct)
                (lwptw-entry-g inverse) (lwptw-entry-h inverse)))))

; children: integrated species round, candidate, proposal, field
(defn lwptw-species (round candidate proposal field)
    (intern_node LWPTW-SPECIES (list round candidate proposal field)))
(defn lwptw-species-round (fixture) (nth (node_children fixture) 0))
(defn lwptw-species-candidate (fixture) (nth (node_children fixture) 1))
(defn lwptw-species-proposal (fixture) (nth (node_children fixture) 2))
(defn lwptw-species-field (fixture) (nth (node_children fixture) 3))
(defn lwptw-build-species (history)
    (do
        (let world (lwptw-observed-world history))
        (let first (lwtnw-trial-candidate (lwptw-history-p history)))
        (let second (lwtnw-trial-candidate (lwptw-history-q history)))
        (let field (lwbs-field-for world first second 2))
        (let proposal (lwbs-proposal world first second 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let answered
            (lwptw-answered-round world proposal
                (lwtnw-trial-round (lwptw-history-q history))))
        (let integrated (lwbs-integrate answered proposal (lwigw-action)))
        (lwptw-species integrated candidate proposal field)))

(defn lwptw-context ()
    (lwlc-declaration (lwptw-cell LWPTW-CONTEXT)
        (lwlc-stack (lwptw-lens-p)
            (lwlc-layers (list (lwptw-lens-q)))
            (lwo-empty-field)
            (lwlc-unknown (lwptw-evidence)) (lwptw-evidence))
        (lwptw-evidence)))
(defn lwptw-facet (species)
    (lwcs-facet (lwptw-focus) species (lwptw-context) (oac-one species)
        (lwo-field (list (lwptw-alternative)))
        (lwlc-unknown (lwptw-evidence)) (lwptw-evidence)))
(defn lwptw-context-world (species-fixture)
    (do
        (let world (lwt-round-world (lwptw-species-round species-fixture)))
        (let species (lwptw-species-candidate species-fixture))
        (let facet (lwptw-facet species))
        (lwt-receive-stream world
            (list
                (lwptw-entry-i (lwptw-focus))
                (lwptw-entry-j (lwptw-focus))
                (lwptw-entry-i (lwptw-context))
                (lwptw-entry-j (lwptw-context))
                (lwptw-entry-i facet) (lwptw-entry-j facet)))))

; children: integrated tissue round, candidate, proposal, field
(defn lwptw-tissue (round candidate proposal field)
    (intern_node LWPTW-TISSUE (list round candidate proposal field)))
(defn lwptw-tissue-round (fixture) (nth (node_children fixture) 0))
(defn lwptw-tissue-candidate (fixture) (nth (node_children fixture) 1))
(defn lwptw-tissue-proposal (fixture) (nth (node_children fixture) 2))
(defn lwptw-tissue-field (fixture) (nth (node_children fixture) 3))
(defn lwptw-build-tissue (species-fixture)
    (do
        (let world (lwptw-context-world species-fixture))
        (let species (lwptw-species-candidate species-fixture))
        (let kernel (lwcs-kernel-for-anchor world species))
        (let field (lwcs-field-for world (lwptw-focus) 2))
        (let proposal
            (lwcs-tissue-proposal world (lwptw-focus) kernel 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let answered
            (lwptw-answered-round world proposal
                (lwptw-species-round species-fixture)))
        (let integrated
            (lwcs-tissue-integrate answered proposal (lwigw-action)))
        (lwptw-tissue integrated candidate proposal field)))

(defn lwptw-target-bindings-a ()
    (lwptw-bindings (intern_trivial_int 17)
        (lwptw-signal-a) (intern_trivial_int 19)))
(defn lwptw-target-bindings-b ()
    (lwptw-bindings (intern_trivial_int 23)
        (lwptw-signal-b) (intern_trivial_int 29)))
(defn lwptw-target-a ()
    (lwtp-bound-target (intern_trivial_int 17) (lwptw-context)
        (lwo-field (list (lwptw-alternative)))
        (lwlc-unknown (lwptw-evidence)) (lwo-none) (lwo-none)
        (lwptw-evidence) (lwptw-target-bindings-a)))
(defn lwptw-target-b ()
    (lwtp-bound-target (intern_trivial_int 23) (lwo-none)
        (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none)
        (lwptw-evidence) (lwptw-target-bindings-b)))

(defn lwptw-target-world-a (tissue-fixture)
    (do
        (let world (lwt-round-world (lwptw-tissue-round tissue-fixture)))
        (let bindings (lwptw-target-bindings-a))
        (let target (lwptw-target-a))
        (lwt-receive-stream world
            (list
                (lwptw-entry-k target) (lwptw-entry-l target)
                (lwptw-entry-k (intern_trivial_int 17))
                (lwptw-entry-l (intern_trivial_int 17))
                (lwptw-entry-k (intern_trivial_int 19))
                (lwptw-entry-l (intern_trivial_int 19))
                (lwptw-entry-k (lwptw-signal-a))
                (lwptw-entry-l (lwptw-signal-a))
                (lwptw-entry-k (lwptw-binding-origin bindings))
                (lwptw-entry-l (lwptw-binding-origin bindings))
                (lwptw-entry-k (lwptw-binding-field bindings))
                (lwptw-entry-l (lwptw-binding-field bindings))))))
(defn lwptw-target-world-b (tissue-fixture)
    (do
        (let world (lwt-round-world (lwptw-tissue-round tissue-fixture)))
        (let bindings (lwptw-target-bindings-b))
        (let target (lwptw-target-b))
        (lwt-receive-stream world
            (list
                (lwptw-entry-m target) (lwptw-entry-n target)
                (lwptw-entry-m (intern_trivial_int 23))
                (lwptw-entry-n (intern_trivial_int 23))
                (lwptw-entry-m (intern_trivial_int 29))
                (lwptw-entry-n (intern_trivial_int 29))
                (lwptw-entry-m (lwptw-signal-b))
                (lwptw-entry-n (lwptw-signal-b))
                (lwptw-entry-m (lwptw-binding-origin bindings))
                (lwptw-entry-n (lwptw-binding-origin bindings))
                (lwptw-entry-m (lwptw-binding-field bindings))
                (lwptw-entry-n (lwptw-binding-field bindings))))))

; children: integrated prediction round, candidate, proposal, target, shape
(defn lwptw-prediction (round candidate proposal target shape)
    (intern_node LWPTW-PREDICTION
        (list round candidate proposal target shape)))
(defn lwptw-prediction-round (fixture) (nth (node_children fixture) 0))
(defn lwptw-prediction-candidate (fixture) (nth (node_children fixture) 1))
(defn lwptw-prediction-proposal (fixture) (nth (node_children fixture) 2))
(defn lwptw-prediction-target (fixture) (nth (node_children fixture) 3))
(defn lwptw-prediction-shape (fixture) (nth (node_children fixture) 4))
(defn lwptw-integrate-prediction (world tissue target previous)
    (do
        (let proposal
            (lwtp-prediction-proposal world tissue target 2 (lwo-none)))
        (let candidate (lwt-proposal-candidate proposal))
        (let shape (lwo-emergent-shape candidate))
        (let answered (lwptw-answered-round world proposal previous))
        (let integrated
            (lwtp-prediction-integrate answered proposal (lwigw-action)))
        (lwptw-prediction integrated candidate proposal target shape)))
(defn lwptw-prediction-a (tissue-fixture)
    (lwptw-integrate-prediction
        (lwptw-target-world-a tissue-fixture)
        (lwptw-tissue-candidate tissue-fixture) (lwptw-target-a)
        (lwptw-tissue-round tissue-fixture)))
(defn lwptw-prediction-b (tissue-fixture)
    (lwptw-integrate-prediction
        (lwptw-target-world-b tissue-fixture)
        (lwptw-tissue-candidate tissue-fixture) (lwptw-target-b)
        (lwptw-tissue-round tissue-fixture)))

(defn lwptw-mismatch (prediction)
    (lwtp-observation prediction (intern_trivial_int 37) (oac-zero)
        (lwo-field (list (intern_trivial_int 37) (lwptw-alternative)))
        (lwlc-unknown (lwptw-evidence)) (lwo-none) (lwptw-evidence)))
(defn lwptw-observation-world (prediction-fixture)
    (do
        (let world (lwt-round-world
                        (lwptw-prediction-round prediction-fixture)))
        (let observation
            (lwptw-mismatch
                (lwptw-prediction-candidate prediction-fixture)))
        (lwt-receive-stream world
            (list (lwptw-entry-o observation) (lwptw-entry-p observation)))))

; children: integrated experience round, candidate, proposal, observation
(defn lwptw-experience (round candidate proposal observation)
    (intern_node LWPTW-EXPERIENCE
        (list round candidate proposal observation)))
(defn lwptw-experience-round (fixture) (nth (node_children fixture) 0))
(defn lwptw-experience-candidate (fixture) (nth (node_children fixture) 1))
(defn lwptw-experience-proposal (fixture) (nth (node_children fixture) 2))
(defn lwptw-experience-observation (fixture) (nth (node_children fixture) 3))
(defn lwptw-build-experience (prediction-fixture)
    (do
        (let world (lwptw-observation-world prediction-fixture))
        (let observation
            (lwptw-mismatch
                (lwptw-prediction-candidate prediction-fixture)))
        (let proposal (lwtp-experience-proposal world observation 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let answered
            (lwptw-answered-round world proposal
                (lwptw-prediction-round prediction-fixture)))
        (let integrated
            (lwtp-experience-integrate answered proposal (lwigw-action)))
        (lwptw-experience integrated candidate proposal observation)))
(defn lwptw-next-prediction (tissue-fixture experience-fixture)
    (lwptw-integrate-prediction
        (lwt-round-world (lwptw-experience-round experience-fixture))
        (lwptw-tissue-candidate tissue-fixture) (lwptw-target-a)
        (lwptw-experience-round experience-fixture)))
(defn lwptw-revoke-one-observer (experience-fixture)
    (lwt-receive-stream
        (lwt-round-world (lwptw-experience-round experience-fixture))
        (list
            (lwptw-entry-o
                (lwo-revocation
                    (lwptw-experience-observation experience-fixture)
                    (lwptw-source-o) (lwptw-reason) (lwptw-prov-o))))))
