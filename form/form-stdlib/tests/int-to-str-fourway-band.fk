; int-to-str-fourway-band.fk -- int_to_str, a core.fk BML recipe, renders identically on all four kernels.
;
; int_to_str already lives in BML (core.fk): nothing stays nothing, a text-kind value (string/list/float) is handed
; to value_str, and an integer is its own decimal digits (fstr-int-str). This band pins that the recipe answers
; byte-identically across the four reference kernels -- including the float-delegation path, which rides value_str
; and therefore float_sci, the four-way dtoa primitive. A 17-digit tie (built by arithmetic, since the ts lexer
; rejects an e+NN literal -- task_aa2c7c08) exercises the same correctly-rounded digits that once diverged on rust
; before the format_float healing (ae284e7ee); its agreement here witnesses the healing reached int_to_str too.
;
; Verdict 7
; preludes: form-stdlib/core.fk
;
;   1   integers -- zero, positive, negative, large -- render as their decimal digits, matching value_str
;   2   the delegated kinds (float, string) render exactly as value_str renders them, including a 17-digit float tie
;   4   a checksum over a sweep of int_to_str outputs is printed (compared four-way byte-for-byte)
(do
    (defn its-bit (ok bit) (if ok bit 0))
    (defn cs-str (s i n acc) (if (ge i n) acc (cs-str s (add i 1) n (mod (add (mul acc 131) (str_byte_at s i)) 1000000007))))
    ; 1: integers render as decimals and agree with value_str
    (let ints (list 0 5 (sub 0 42) 1000000 (sub 0 1) 123456789))
    (defn ints-ok (xs) (if (nil? xs) 1 (if (str_eq (int_to_str (head xs)) (value_str (head xs))) (ints-ok (tail xs)) 0)))
    (let i-ok (eq (ints-ok ints) 1))
    ; 2: delegated kinds match value_str, including a built 17-digit tie
    (let tie (mul (div 103.0 7.0) 1e13))
    (let d-ok (if (str_eq (int_to_str 2.5) (value_str 2.5))
                  (if (str_eq (int_to_str 1000000.0) (value_str 1000000.0))
                      (if (str_eq (int_to_str tie) (value_str tie))
                          (str_eq (int_to_str "hi") (value_str "hi")) false) false) false))
    ; a curated sample list -- printed so validate.sh compares the exact bytes four-way
    (defn show (xs) (if (nil? xs) 0 (do (let t (print (int_to_str (head xs)))) (show (tail xs)))))
    (let shown (show (list 0 42 (sub 0 7) 1000000 2.5 1000000.0 tie 999999.0 "hi")))
    ; 4: checksum over a sweep (int_to_str of i and of i/7 scaled) -- printed, compared four-way
    (defn sweep (i n acc)
        (if (gt i n) acc
            (do (let si (int_to_str i)) (let sf (int_to_str (mul (div (mul i 1.0) 7.0) 1e13)))
                (sweep (add i 1) n (cs-str sf 0 (str_len sf) (cs-str si 0 (str_len si) acc))))))
    (let checksum (sweep 1 400 0))
    (let told (print (list "ints" i-ok "delegated" d-ok "checksum" checksum)))
    (add (its-bit i-ok 1) (add (its-bit d-ok 2) (its-bit (gt checksum 0) 4))))
