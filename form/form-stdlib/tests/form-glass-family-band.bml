; form-glass-family-band.bml — the glass family stays registered where its cells mint it.
;
; preludes: form-stdlib/core.fk
;
; The four FORM-GLASS names arrived with 41b8e7a5 and no row in any registry: plain bp handed fkwu
; the name back, and Go, Rust and TS stopped at "unregistered blueprint name". 93d4bb6b registered
; them at 1/2/99/1758-1761 and let each defining cell mint its own. This band reads the registry and
; the four cells as text, so a row that moves without its cell, or a cell that goes back to bp, fails
; here on every kernel. It reads from the directory that holds blueprint-registry.json: the siblings
; run from form/ and fkwu from the body root.
;
; Verdict 15 when every claim lands:
;   1  the registry holds FORM-GLASS-OBSERVATION-V1 at 1758 and FORM-GLASS-METRIC-FIELD-V2 at 1759
;   2  the registry holds FORM-GLASS-VALUE-PROJECTION-V1 at 1760 and FORM-GLASS-CELEBRATION-V1 at 1761
;   4  form-glass-observer.bml mints 1758 and 1759, form-glass-dashboard.bml 1760, and
;      bml/form-glass-celebration.bml 1761
;   8  none of the four cells asks bp for a glass category
section [form.bml] {
    def gfb-has(xs, name) = if eq(len(xs), 0) then 0 else if str_eq(head(xs), name) then 1 else gfb-has(tail(xs), name);
    def gfb-root() = if eq(gfb-has(fs_list("form-stdlib"), "blueprint-registry.json"), 1) then "form-stdlib/" else "form/form-stdlib/";
    def gfb-in(text, needle) = if ge(str_find(text, needle, 0), 0) then 1 else 0;
    // a row holds a name at an inst when its name line follows its inst line within a few characters
    def gfb-row(reg, inst, name) {
        let p = str_find(reg, str_concat("\"inst\": ", str_concat(inst, ",")), 0);
        let q = str_find(reg, str_concat("\"name\": \"", str_concat(name, "\"")), 0);
        if and(ge(p, 0), and(gt(q, p), lt(sub(q, p), 40))) then 1 else 0;
    }
    def gfb-mints(text, inst) = gfb-in(text, str_concat("make_nodeid(1, 2, 99, ", str_concat(inst, ")")));
    def gfb-asks-bp(text) = if eq(gfb-in(text, "bp(\"FORM-GLASS"), 1) then 1 else gfb-in(text, "bp(FG");

    let root = gfb-root();
    let reg = read_file(str_concat(root, "blueprint-registry.json"));
    let obs = read_file(str_concat(root, "form-glass-observer.bml"));
    let dash = read_file(str_concat(root, "form-glass-dashboard.bml"));
    let atlas = read_file(str_concat(root, "form-glass-atlas-ui.bml"));
    let cel = read_file(str_concat(root, "bml/form-glass-celebration.bml"));
    let c1 = if eq(add(gfb-row(reg, "1758", "FORM-GLASS-OBSERVATION-V1"), gfb-row(reg, "1759", "FORM-GLASS-METRIC-FIELD-V2")), 2) then 1 else 0;
    let c2 = if eq(add(gfb-row(reg, "1760", "FORM-GLASS-VALUE-PROJECTION-V1"), gfb-row(reg, "1761", "FORM-GLASS-CELEBRATION-V1")), 2) then 2 else 0;
    let c4 = if eq(add(gfb-mints(obs, "1758"), add(gfb-mints(obs, "1759"), add(gfb-mints(dash, "1760"), gfb-mints(cel, "1761")))), 4) then 4 else 0;
    let c8 = if eq(add(gfb-asks-bp(obs), add(gfb-asks-bp(dash), add(gfb-asks-bp(atlas), gfb-asks-bp(cel)))), 0) then 8 else 0;
    add(c1, add(c2, add(c4, c8)));
}
