; disk-steward-image-band.bml — the steward reads an image's own header, fkwu-witnessed (form-stdlib/bml/disk-steward.bml).
;
; A compile image opens with the 8 bytes "FKPIFB1\0" and its format version as a big-endian u32 (float_leaf 64 reads those
; bytes of a file without reading the 54 MB behind them); the kernel of the checkout holding it reads exactly the version
; its runtime/fkwu-uni.c names (FK_FKB_VERSION). Each claim is pure over a scratch directory this band makes and removes.
;
; Expected: 15
; Verdict 15 when every claim lands:
;   1   an image whose header names the version its checkout's kernel reads, with its source standing, is "image"
;   2   an image whose header names another format version is "dead-image" (and waste, composted with no pressure); when
;       the kernel's version is unknown (0) nothing is called dead; the symbol lens beside a dead image is dead with it
;   4   a file named .fkb that opens with the body's data-node magic (FORMBIN) is "kept", never composted, even with no source
;   8   a checkout's kernel version is read from its runtime/fkwu-uni.c (#define FK_FKB_VERSION n); a checkout whose source
;       does not say, or has none, reads 0
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/disk-steward.bml
section [form.bml] {
 class DiskStewardImageBand {
  def dib-dir() = ".hearth/disk-steward-image-band";
  // "FKPIFB1" NUL, then the version as four big-endian bytes (versions under 256 here), then padding
  def dib-header(ver) = "FKPIFB1" ++ byte_to_str(0) ++ byte_to_str(0) ++ byte_to_str(0) ++ byte_to_str(0) ++ byte_to_str(ver) ++ "padding-bytes";
  def dib-make() {
   let a = fs_mkdir(".hearth");
   let b = fs_mkdir(dib-dir());
   let c = fs_mkdir(dib-dir() ++ "/runtime");
   let src = write_file_text(dib-dir() ++ "/live.bml", "section [form.bml] { 0; }\n");
   let src2 = write_file_text(dib-dir() ++ "/old.bml", "section [form.bml] { 0; }\n");
   let live = write_file_text(dib-dir() ++ "/live.bml.fkb", dib-header(9));
   let dead = write_file_text(dib-dir() ++ "/old.bml.fkb", dib-header(5));
   let node = write_file_text(dib-dir() ++ "/ledger.fkb", "FORMBIN2" ++ "node-bytes-of-the-bodys-own-ledger");
   let kernel = write_file_text(dib-dir() ++ "/runtime/fkwu-uni.c", "/* seed */\n#define FK_FKB_VERSION 7\n#define OTHER 1\n");
   0;
  }
  def dib-clean() {
   let a = host_path_remove(dib-dir() ++ "/live.bml.fkb");
   let b = host_path_remove(dib-dir() ++ "/old.bml.fkb");
   let c = host_path_remove(dib-dir() ++ "/ledger.fkb");
   let d = host_path_remove(dib-dir() ++ "/live.bml");
   let e = host_path_remove(dib-dir() ++ "/old.bml");
   let f = host_path_remove(dib-dir() ++ "/runtime/fkwu-uni.c");
   let g = fs_rmdir(dib-dir() ++ "/runtime");
   let h = fs_rmdir(dib-dir());
   0;
  }
  def dib-c-live(ctx) = (String) ds-kind-v(dib-dir() ++ "/live.bml.fkb", 9) == "image" && ds-image-version(ds-head(dib-dir() ++ "/live.bml.fkb")) == 9;
  def dib-c-dead(ctx) {
   let p = dib-dir() ++ "/old.bml.fkb";
   (String) ds-kind-v(p, 9) == "dead-image" && ds-waste?(ds-lease-v(p, 1000000, 9)) && (String) ds-kind-v(p, 0) == "image" && (String) ds-kind-v(dib-dir() ++ "/old.bml.sym", 9) == "dead-image";
  }
  def dib-c-node(ctx) = (String) ds-kind-v(dib-dir() ++ "/ledger.fkb", 9) == "kept" && !ds-waste?(ds-lease-v(dib-dir() ++ "/ledger.fkb", 1000000, 9));
  def dib-c-version(ctx) = ds-kernel-version(dib-dir()) == 7 && ds-kernel-version(dib-dir() ++ "/nowhere") == 0;
  def dib-run() {
   let made = dib-make();
   let verdict = live-claims("disk-steward-image-band", 0, [["live", 1, 1, dib-c-live], ["dead", 2, 1, dib-c-dead], ["node", 4, 1, dib-c-node], ["version", 8, 1, dib-c-version]]);
   let cleaned = dib-clean();
   verdict;
  }
 }
 dib-run();
}
