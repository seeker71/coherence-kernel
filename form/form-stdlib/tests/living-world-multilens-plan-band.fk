; living-world-multilens-plan-band.fk -- concurrent optional lenses do not collapse.
; Verdict 32767 proves fifteen multi-node, alternative, and unknown claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/living-world-multilens-plan.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk form-stdlib/tests/living-world-relational-voice-witness.fk form-stdlib/tests/living-world-multilens-witness.fk

(do
    (let world (lwmpw-world))
    (let aligned (lwmpw-aligned-bundle))
    (let aligned-items
        (lwrp-sequence-items (lwmp-bundle-primary-sequence aligned)))
    (let divergent (lwmpw-divergent-bundle))
    (let open (lwmpw-open-bundle))
    (let ambiguous (lwmpw-ambiguous-bundle))
    (let cycle (lwmpw-cycle-bundle))

    (let c1 (if (and (eq (lwsl-integrated-current?
                              world (lwmpw-third)) 1)
                         (eq (lwnv-symbol-positioned?
                              (lwo-emergent-shape
                                (lwmpw-third))) 0)) 1 0))
    (let c2 (if (and (eq (lwmp-aligned?
                              (lwmp-bundle-status aligned)) 1)
                         (and (eq (lwo-field-size
                                   (lwmp-bundle-views aligned)) 2)
                              (eq (lwo-field-size
                                   (lwmp-bundle-ready-views aligned)) 2))) 2 0))
    (let c3 (if (and (eq (len aligned-items) 3)
                         (and (node_eq (nth aligned-items 0) (lwrvw-left))
                              (and (node_eq (nth aligned-items 1)
                                      (lwrvw-right))
                                   (node_eq (nth aligned-items 2)
                                      (lwmpw-third))))) 4 0))
    (let c4 (if (and (eq (lwo-field-size
                              (lwmp-bundle-unapplied-lenses aligned)) 1)
                         (eq (lwo-field-has?
                              (lwmp-bundle-unapplied-lenses aligned)
                              (lwmpw-lens-gamma)) 1)) 8 0))
    (let c5 (if (and (eq (lwlc-unknown?
                              (lwmp-bundle-declared-unknown aligned)) 1)
                         (node_eq (lwmp-bundle-derived-unknown aligned)
                                  (lwo-none))) 16 0))
    (let c6 (if (eq (lwo-field-size
                         (lwmp-bundle-witnesses aligned)) 16) 32 0))
    (let c7 (if (eq (lwmp-bundle-current? world aligned) 1) 64 0))
    (let c8 (if (and (eq (lwmp-divergent?
                              (lwmp-bundle-status divergent)) 1)
                         (and (node_eq
                               (lwmp-bundle-primary-sequence divergent)
                               (lwo-none))
                              (eq (lwo-field-size
                                   (lwmp-bundle-alternative-sequences
                                     divergent)) 2))) 128 0))
    (let c9 (if (and (eq (lwmp-open?
                              (lwmp-bundle-status open)) 1)
                         (and (eq (lwo-field-size
                                   (lwmp-bundle-views open)) 0)
                              (and (eq (lwo-field-size
                                       (lwmp-bundle-unapplied-lenses open)) 3)
                                   (eq (lwlc-unknown?
                                        (lwmp-bundle-derived-unknown open))
                                       1)))) 256 0))
    (let c10 (if (and (eq (lwmp-unresolved?
                               (lwmp-bundle-status ambiguous)) 1)
                          (and (eq (lwo-field-size
                                    (lwmp-bundle-ambiguous-views
                                      ambiguous)) 1)
                               (eq (lwo-field-size
                                    (lwmp-bundle-cycle-views ambiguous)) 0)))
                      512 0))
    (let c11 (if (and (eq (lwmp-unresolved?
                               (lwmp-bundle-status cycle)) 1)
                          (and (eq (lwo-field-size
                                    (lwmp-bundle-cycle-views cycle)) 1)
                               (eq (lwo-field-size
                                    (lwmp-bundle-ambiguous-views cycle)) 0)))
                      1024 0))
    (let c12 (if (and (eq (lwo-field-size
                               (lwmp-bundle-sequences aligned)) 1)
                          (eq (lwo-field-size
                               (lwmp-bundle-sequences divergent)) 2)) 2048 0))
    (let c13 (if (and (not (node_eq aligned divergent))
                          (and (not (node_eq divergent open))
                               (not (node_eq open ambiguous)))) 4096 0))
    (let c14 (if (eq (lwmp-bundle-current?
                          (lwmpw-revoked-world) aligned) 0) 8192 0))
    (let c15 (if (and (eq (lwo-field-size
                               (lwmp-bundle-ambiguous-views aligned)) 0)
                          (and (eq (lwo-field-size
                                    (lwmp-bundle-cycle-views aligned)) 0)
                               (eq (lwo-field-size
                                    (lwmp-bundle-alternative-sequences
                                      aligned)) 0))) 16384 0))
    (lwmpw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
