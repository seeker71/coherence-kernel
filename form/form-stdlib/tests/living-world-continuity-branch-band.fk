; living-world-continuity-branch-band.fk -- granted branches restore without
; turning another branch's silence or dissent into global veto authority.
; Verdict 65535 proves sixteen scope, optionality, history, and authority bits.
; witnessed: 2026-08-08 -> 65535 on direct-source fkwu
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-continuity-branch.fk form-stdlib/tests/living-world-continuity-branch-witness.fk

(do
    (let historical (lwcbw-historical-world))
    (let image (lwcbw-image))
    (let branch-a (lwcbw-branch-a))
    (let branch-b (lwcbw-branch-b))
    (let projected-a (lwcb-branch-world branch-a))
    (let projected-b (lwcb-branch-world branch-b))
    (let participants-a (lwcb-branch-participants branch-a))
    (let participants-b (lwcb-branch-participants branch-b))
    (let admission (lwcbw-admission-world))
    (let proposal-a (lwcbw-proposal-a))
    (let proposal-b (lwcbw-proposal-b))
    (let candidate-a (lwt-proposal-candidate proposal-a))
    (let candidate-b (lwt-proposal-candidate proposal-b))
    (let restore-a (lwo-emergent-shape candidate-a))
    (let restore-b (lwo-emergent-shape candidate-b))
    (let response-world (lwcbw-response-world))
    (let outcome-a (lwt-evaluate-proposal response-world proposal-a))
    (let outcome-b (lwt-evaluate-proposal response-world proposal-b))
    (let after-a (lwcbw-after-a-world))
    (let after-waiting-b (lwcbw-after-waiting-b-world))
    (let dissent-world (lwcbw-dissent-world))
    (let dissent-outcome
        (lwt-evaluate-proposal dissent-world proposal-b))
    (let after-dissent-b (lwcbw-after-dissent-b-world))
    (let revised-world (lwcbw-revised-b-world))
    (let revised-outcome
        (lwt-evaluate-proposal revised-world proposal-b))
    (let restored (lwcbw-restored-world))
    (let cross-revoked (lwcbw-after-cross-revocation))
    (let local-revoked (lwcbw-after-local-revocation))
    (lwcbw-sum
        (list
            ; One valid image may carry two independently valid exact branches.
            (if (and (eq (lwcn-image-valid? image) 1)
                     (and (eq (lwo-field-size
                                  (lwcn-active-sources historical)) 2)
                          (and (eq (lwcb-branch-valid? branch-a) 1)
                               (eq (lwcb-branch-valid? branch-b) 1)))) 1 0)
            ; Each participant field names only its payload/capability holder.
            (if (and (eq (lwo-field-size participants-a) 1)
                     (and (eq (lwo-field-has? participants-a
                                  (lwcbw-source-a)) 1)
                          (and (eq (lwo-field-has? participants-a
                                       (lwcbw-source-b)) 0)
                               (and (eq (lwo-field-size participants-b) 1)
                                    (and (eq (lwo-field-has? participants-b
                                                 (lwcbw-source-b)) 1)
                                         (eq (lwo-field-has? participants-b
                                                 (lwcbw-source-a)) 0)))))) 2 0)
            ; Projection derives exact payload isolation from holder grants.
            (if (and (eq (lwo-field-size
                              (lwo-world-cells projected-a)) 1)
                     (and (eq (lwo-active? projected-a
                                  (lwcbw-payload-a)) 1)
                          (and (eq (lwo-active? projected-a
                                       (lwcbw-payload-b)) 0)
                               (and (eq (lwo-field-size
                                            (lwo-world-cells projected-b)) 1)
                                    (and (eq (lwo-active? projected-b
                                                 (lwcbw-payload-b)) 1)
                                         (eq (lwo-active? projected-b
                                                 (lwcbw-payload-a)) 0)))))) 4 0)
            ; Exact offers produce distinct, current candidates and one witness
            ; each; storage alone produces none.
            (if (and (eq (lwcb-restore-current?
                              admission candidate-a) 1)
                     (and (eq (lwcb-restore-current?
                                   admission candidate-b) 1)
                          (and (eq (node_eq candidate-a candidate-b) 0)
                               (and (eq (lwo-field-size
                                            (lwo-emergent-witnesses
                                                candidate-a)) 1)
                                    (eq (lwo-field-size
                                            (lwo-emergent-witnesses
                                                candidate-b)) 1))))) 8 0)
            ; Branch options are independently absent or explicitly present.
            (if (and (node_eq (lwcb-branch-declaration branch-a)
                              (lwo-none))
                     (and (node_eq (lwcb-branch-lens branch-a)
                                   (lwo-none))
                          (and (eq (lwo-field-size
                                       (lwcb-branch-alternatives branch-a)) 0)
                               (and (node_eq
                                        (lwcb-branch-unknowable branch-a)
                                        (lwo-none))
                                    (and (node_eq
                                            (lwcb-branch-declaration branch-b)
                                            (lwcbw-declaration-b))
                                         (and (node_eq
                                                (lwcb-branch-lens branch-b)
                                                (lwcbw-lens-b))
                                              (and (eq (lwo-field-size
                                                        (lwcb-branch-alternatives
                                                            branch-b)) 1)
                                                   (node_eq
                                                    (lwcb-branch-unknowable
                                                        branch-b)
                                                    (lwcbw-unknown-b)))))))))
                16 0)
            ; Off-scope responses remain derivable but cannot count as votes.
            (if (and (eq (lwo-field-size
                              (lwt-response-derivations
                                  response-world proposal-a)) 2)
                     (and (eq (lwt-outcome-yes outcome-a) 1)
                          (and (node_eq (lwt-outcome-status outcome-a)
                                       (lwt-status-acknowledged))
                               (and (eq (lwo-field-size
                                            (lwt-response-derivations
                                                response-world proposal-b)) 2)
                                    (and (eq (lwt-outcome-yes outcome-b) 0)
                                         (and (eq (lwt-outcome-silence
                                                        outcome-b) 1)
                                              (node_eq
                                                (lwt-outcome-status outcome-b)
                                                (lwt-status-waiting))))))))
                32 0)
            ; A restores while B remains absent and current-but-unrestored.
            (if (and (eq (lwo-active? after-a (lwcbw-payload-a)) 1)
                     (and (eq (lwo-active? after-a
                                  (lwcbw-payload-b)) 0)
                          (and (eq (lwcb-restored? after-a candidate-a) 1)
                               (and (eq (lwcb-restored?
                                            after-a candidate-b) 0)
                                    (eq (lwcb-restore-current?
                                            after-a candidate-b) 1))))) 64 0)
            ; Stored grant/capability controls and historical events do not leak.
            (if (and (eq (lwo-world-has? after-a
                              (lwcbw-capability-a)) 0)
                     (and (eq (lwo-world-has? after-a
                                  (lwcbw-grant-a)) 0)
                          (eq (lwo-field-has?
                                (lwo-world-events after-a)
                                (lwo-boundary-event (lwcbw-source-a)
                                    (lwcbw-action)
                                    (oac-one (lwcbw-payload-a)))) 0))) 128 0)
            ; Attempting a waiting branch is an exact no-op on world identity.
            (if (and (node_eq after-a after-waiting-b)
                     (eq (lwo-active? after-waiting-b
                            (lwcbw-payload-b)) 0)) 256 0)
            ; Dissent blocks only B while remaining exact, reachable history.
            (if (and (eq (lwt-outcome-no dissent-outcome) 1)
                     (and (node_eq (lwt-outcome-status dissent-outcome)
                                   (lwt-status-dissented))
                          (and (node_eq after-dissent-b dissent-world)
                               (and (eq (lwo-active? after-dissent-b
                                            (lwcbw-payload-a)) 1)
                                    (eq (lwo-active? after-dissent-b
                                            (lwcbw-payload-b)) 0))))) 512 0)
            ; Revoking dissent and adding ONE acknowledges B despite retained
            ; historical NOTHING, then restores B without revising A.
            (if (and (eq (lwt-outcome-yes revised-outcome) 1)
                     (and (eq (lwt-outcome-no revised-outcome) 0)
                          (and (eq (lwt-outcome-silence revised-outcome) 0)
                               (and (node_eq
                                        (lwt-outcome-status revised-outcome)
                                        (lwt-status-acknowledged))
                                    (and (eq (lwo-active? restored
                                                (lwcbw-payload-a)) 1)
                                         (eq (lwo-active? restored
                                                (lwcbw-payload-b)) 1)))))) 1024 0)
            ; Both restore candidates and exact historical source attributions
            ; remain current after independent merge restoration.
            (if (and (eq (lwcb-restored? restored candidate-a) 1)
                     (and (eq (lwcb-restored? restored candidate-b) 1)
                          (and (eq (lwo-active-by? restored
                                       (lwcbw-payload-a)
                                       (lwcbw-source-a)) 1)
                               (eq (lwo-active-by? restored
                                       (lwcbw-payload-b)
                                       (lwcbw-source-b)) 1)))) 2048 0)
            ; Grant evidence and offered option identities survive in the exact
            ; restore shapes without becoming decisions.
            (if (and (eq (lwo-field-size
                              (lwcb-restore-grant-evidence restore-a)) 1)
                     (and (eq (lwo-field-size
                                  (lwcb-restore-grant-evidence restore-b)) 1)
                          (and (node_eq
                                (lwcb-restore-alternatives restore-b)
                                (lwcb-branch-alternatives branch-b))
                               (node_eq
                                (lwcb-restore-unknowable restore-b)
                                (lwcb-branch-unknowable branch-b))))) 4096 0)
            ; A's attempted revocation cannot enter B's revocation ledger or
            ; revoke B's active attribution.
            (if (and (eq (lwo-active? cross-revoked
                              (lwcbw-payload-b)) 1)
                     (and (eq (lwo-field-size
                                  (lwo-world-revocations cross-revoked))
                              (lwo-field-size
                                  (lwo-world-revocations restored)))
                          (eq (lwo-attribution-revoked? cross-revoked
                                (lwcbw-payload-b) (lwcbw-source-b)) 0))) 8192 0)
            ; B may revoke only B; A stays active and both payload histories
            ; remain reachable.
            (if (and (eq (lwo-active? local-revoked
                              (lwcbw-payload-a)) 1)
                     (and (eq (lwo-active? local-revoked
                                  (lwcbw-payload-b)) 0)
                          (and (eq (lwo-world-has? local-revoked
                                       (lwcbw-payload-a)) 1)
                               (eq (lwo-world-has? local-revoked
                                       (lwcbw-payload-b)) 1)))) 16384 0)
            ; Restoring either branch preserves the admission history and the
            ; other exact branch offer rather than replacing the whole world.
            (if (and (eq (lwo-active? after-a branch-a) 1)
                     (and (eq (lwo-active? after-a branch-b) 1)
                          (and (eq (lwo-active? restored branch-a) 1)
                               (eq (lwo-active? restored branch-b) 1)))) 32768 0))))
