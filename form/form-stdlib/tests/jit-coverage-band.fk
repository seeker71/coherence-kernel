; Chained binding and list behavior in the proof walkers and fkwu: 5.
(do
    (let a 7)
    (let b 11)
    (let c (add a b))
    (let d (mul c 2))
    (let e (sub d a))
    (let xs (list a b c d e))
    (let n (len xs))
    (let first (head xs))
    (defn pair-doubled (x y)
        (do
            (let s (add x y))
            (let s2 (mul s 2))
            (list x y s2)))
    (let r1 (pair-doubled a b))
    (let r1-len (len r1))
    (let r1-nth-2 (nth r1 2))
    (let r2 (pair-doubled c d))
    (let r2-nth-2 (nth r2 2))
    (let ok-let-chain (if (eq e 29) 1 0))
    (let ok-list-len  (if (eq n 5) 1 0))
    (let ok-list-head (if (eq first 7) 1 0))
    (let ok-defn-list (if (eq r1-nth-2 36) 1 0))
    (let ok-post-jit  (if (eq r2-nth-2 108) 1 0))
    (add ok-let-chain
    (add ok-list-len
    (add ok-list-head
    (add ok-defn-list ok-post-jit)))))
