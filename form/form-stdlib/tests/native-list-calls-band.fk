; List call behavior, plus an independent native leaf: 4.
; preludes: form-stdlib/bml/native-jit-route.bml
(do
    (defn jit-list-sum (xs acc)
        (if (nil? xs) acc
            (jit-list-sum (tail xs) (add acc (head xs)))))
    (let r0 (jit-list-sum (list 1 2 3 4 5) 0))
    (let compiled (njr-probe))
    (let attempted (if compiled 1 0))
    (let r1 (jit-list-sum (list 1 2 3 4 5) 0))
    (let r2 (jit-list-sum (list 8 13 21) 0))
    (add attempted
         (add (if (eq r0 15) 1 0)
              (add (if (eq r1 15) 1 0)
                   (if (eq r2 42) 1 0)))))
