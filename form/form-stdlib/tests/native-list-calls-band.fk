; List call behavior: 3. The in-RAM native leaf is witnessed on its home arm by
; jit-leaf-inram-band.fk.
; preludes: form-stdlib/core.fk
(do
    (defn jit-list-sum (xs acc)
        (if (nil? xs) acc
            (jit-list-sum (tail xs) (add acc (head xs)))))
    (let r0 (jit-list-sum (list 1 2 3 4 5) 0))
    (let r1 (jit-list-sum (list 1 2 3 4 5) 0))
    (let r2 (jit-list-sum (list 8 13 21) 0))
    (add (if (eq r0 15) 1 0)
         (add (if (eq r1 15) 1 0)
              (if (eq r2 42) 1 0))))
