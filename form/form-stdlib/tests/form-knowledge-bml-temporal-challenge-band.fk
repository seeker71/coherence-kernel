; form-knowledge-bml-temporal-challenge-band.fk -- derived prompt, safe native
; source admission, hidden family judge, and nothing/zero/one evidence.
;
; Expected: 65535 (16 bits)
;
; preludes: form-stdlib/form-knowledge-bml-temporal-challenge.fk

(do
    (defn fktwtb-bit (ok bit) (if ok bit 0))
    (defn fktwtb-good ()
        (fked-cat (list
            "def fktw-verify(answered,value,when,deadline) = if eq(answered,1) then if le(when,deadline) then if eq(value,1) then 1 else 0 else sub(0,1) else sub(0,1);\n"
            "def fktw-stream(frame-present,kind,ack,elapsed,timeout) = if eq(frame-present,0) then if ge(elapsed,timeout) then 4 else 0 else if eq(kind,1) then if eq(ack,0) then 6 else 1 else if eq(kind,2) then if eq(ack,0) then 6 else 2 else if eq(kind,4) then 3 else if eq(kind,5) then 5 else 0;\n"
            "0;")))
    (defn fktwtb-wrong ()
        (fked-cat (list
            "def fktw-verify(answered,value,when,deadline) = 0;\n"
            "def fktw-stream(frame-present,kind,ack,elapsed,timeout) = 0;\n"
            "0;")))
    (defn fktwtb-effect ()
        (fked-cat (list
            "def fktw-verify(answered,value,when,deadline) = host-exec(answered,value);\n"
            "def fktw-stream(frame-present,kind,ack,elapsed,timeout) = 0;\n"
            "0;")))
    (defn fktwtb-run ()
        (do
            (let good (fktwtb-good))
            (let wrong (fktwtb-wrong))
            (let effect (fktwtb-effect))
            (let source (fktwt-eval-source good))
            (let native-score (fktwt-native-score good))
            (let good-ack (fktwt-judge good))
            (let wrong-ack (fktwt-judge wrong))
            (sum (list
                (fktwtb-bit (str_eq (fktwt-version)
                    "form-bml-temporal-challenge-v1") 1)
                (fktwtb-bit (eq (fktwt-prompt-derived-after-freeze?) 1) 2)
                (fktwtb-bit (eq (fktwt-prompt-holds-bans?
                    (fktwf-leakage-bans)) 1) 4)
                (fktwtb-bit (and (ge (str_find (fktwt-prompt)
                        "fktw-verify" 0) 0)
                    (ge (str_find (fktwt-prompt) "fktw-stream" 0) 0)) 8)
                (fktwtb-bit (eq (fktwt-candidate-safe? good) 1) 16)
                (fktwtb-bit (eq (fktwt-candidate-safe? effect) 0) 32)
                (fktwtb-bit (eq (fktwt-candidate-safe?
                    (str_concat good "def extra() = 1;")) 0) 64)
                (fktwtb-bit (and (not (nothing? source))
                    (ge (str_find source "(fktw-verify 1 1 26 29)" 0) 0)) 128)
                (fktwtb-bit (and (ge (str_find source
                        "(fktw-stream 0 0 0 28 29)" 0) 0)
                    (ge (str_find source "(sub 0 1)" 0) 0)) 256)
                (fktwtb-bit (eq (len (fktwf-cases)) 10) 512)
                (fktwtb-bit (eq (fktwt-score-all) 1023) 1024)
                (fktwtb-bit (eq (oac-one? good-ack) 1) 2048)
                (fktwtb-bit (eq (node_value (oac-payload good-ack)) 1023) 4096)
                (fktwtb-bit (eq (oac-zero? wrong-ack) 1) 8192)
                (fktwtb-bit (and
                    (str_eq (fktwt-execution-surface)
                        "resident-form-bmf-ast")
                    (and (eq (fktwt-process-crossings) 0)
                    (and (eq (fktwt-network-crossings) 0)
                    (and (eq (fktwt-value-present? native-score) 1)
                         (eq (fktwt-value-int native-score) 1023))))) 16384)
                (fktwtb-bit (and (not (str_eq (fktwt-prompt-sha) ""))
                    (eq (str_find (fktwt-prompt)
                        (fktwf-sealed-source-group-id) 0) -1)) 32768)))))
    (fktwtb-run))
