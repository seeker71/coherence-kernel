; receipt-texture-band.fk — the payout made computable. A choice receipt and
; the share row the body already measures fold into one value-ledger entry
; by data alone: native, remote-oracle, silence and fail each yield a
; distinct entry; the port refuses the same receipt twice; the balance is
; the fold of the appends; a sensed plane is witnessed (sensed=1) and never
; billed (billed=0, amount 0).
;
; Verdict 16383
;   share3 -> provenance: native / local / remote lanes, unmeasured names nobody  ->     1
;   the resident's own token receipt -> hearth-resident 0 tokens; provider -> remote  ->     2
;   control-plane surface -> provenance rows; an unknown surface is nothing          ->     4
;   four entries: pairwise-distinct ids                                              ->     8
;   four entries: pairwise-distinct kinds                                            ->    16
;   native success: account is the receipt's who, kind and amount as data           ->    32
;   remote-oracle success: remote tokens billed                                      ->    64
;   silence: an effect lane bills its ms                                             ->   128
;   fail: a computed lane on the local-oracle bills its ms                           ->   256
;   the same receipt posted twice is refused by the port: count and balance hold    ->   512
;   the balance is the fold: 300+1500+40+250                                         ->  1024
;   a sensed plane (care): sensed=1 billed=0 amount 0, entry exists, balance 0      ->  2048
;   an unknown unit, a share summing to 50, a malformed receipt: nothing, unposted  ->  4096
;   every texture field is a row naming its source organ; 4 provenances, 4 units   ->  8192
;
; PROOF LEVEL: FOURTH-ARM ONLY (fkwu) — the organ is executable BML.
; preludes: form-stdlib/receipt-texture.bml
(do
    (defn rtb-bit (ok bit) (if ok bit 0))
    (defn rtb-absent? (x xs)
        (if (eq (len xs) 0) true
            (if (str_eq x (head xs)) false (rtb-absent? x (tail xs)))))
    (defn rtb-all-different? (xs)
        (if (eq (len xs) 0) true
            (if (rtb-absent? (head xs) (tail xs)) (rtb-all-different? (tail xs)) false)))
    (let cm (carrier-memory))
    (defn rtb-value () (cr-choice-value (cr-kind-core-alignment) 0 90 88 86))
    (defn rtb-cand () (cr-choice-candidate "answer.native" "TURN" true 0 900 "native lane answered"))
    (let ok-trace (cr-choice-trace 1 1 0 0))
    (let fail-trace (cr-choice-trace 1 0 1 0))
    (let silence-trace (cr-choice-trace 1 0 0 1))
    (defn rtb-receipt (expression path outcome certainty tick trace who)
        (cr-choice-receipt expression "hearth-turn" "TURN" (list (rtb-cand)) path outcome certainty (rtb-value)
            "texture band" who "form/form-stdlib/tests/receipt-texture-band.fk" tick 0 trace))
    (let native-receipt (rtb-receipt "ask(native)" "answer.native" (cr-outcome-success) 90 20260903 ok-trace "texture-band"))
    (let remote-receipt (rtb-receipt "ask(remote)" "answer.native" (cr-outcome-success) 80 20260904 ok-trace "texture-band"))
    (let silence-receipt (rtb-receipt "ask(silence)" "none" (cr-outcome-silence) 0 20260905 silence-trace "texture-band"))
    (let fail-receipt (rtb-receipt "ask(fail)" "answer.native" (cr-outcome-fail) 40 20260906 fail-trace "texture-band"))
    (let sacred-receipt (rtb-receipt "sit(with)" "answer.native" (cr-outcome-success) 95 20260907 ok-trace "texture-band-sacred"))
    (let malformed (rtb-receipt "ask(malformed)" "none" (cr-outcome-success) 90 20260908 ok-trace "texture-band"))

    (let native-share (rtex-share-of-boundary (list 100 0 0) "tokens" 300 "meaning"))
    (let remote-token-receipt (frte-receipt "task" 1 (frte-provider-source) 2 1500))
    (let local-token-receipt (frte-receipt "task" 1 (frte-local-direct-source) 0 0))
    (let remote-share (rtex-share-of-token-receipt remote-token-receipt "meaning"))
    (let resident-share (rtex-share-of-token-receipt local-token-receipt "meaning"))
    (let silence-share (rtex-share-of-boundary (list 60 40 0) "ms" 40 "benefit-of-silence"))
    (let fail-share (rtex-share-of-boundary (list 0 100 0) "ms" 250 "structural-knowledge"))
    (let sacred-share (rtex-share-of-boundary (list 100 0 0) "tokens" 500 "care"))
    (let bad-unit-share (rtex-share "form-native" "joules" 1 100 0 0 "meaning"))
    (let half-share (rtex-share "form-native" "tokens" 1 50 0 0 "meaning"))

    (let t-native (texture-of native-receipt native-share))
    (let t-remote (texture-of remote-receipt remote-share))
    (let t-silence (texture-of silence-receipt silence-share))
    (let t-fail (texture-of fail-receipt fail-share))
    (let t-sacred (texture-of sacred-receipt sacred-share))

    (let s0 (storage-open cm ""))
    (let s1 (rtex-post cm s0 t-native))
    (let s2 (rtex-post cm s1 t-remote))
    (let s3 (rtex-post cm s2 t-silence))
    (let s4 (rtex-post cm s3 t-fail))
    (let balance-4 (vl-balance cm s4 "texture-band"))
    (let s5 (rtex-post cm s4 t-native))
    (let s6 (rtex-post cm s5 t-sacred))
    (let s7 (rtex-post cm s6 (texture-of native-receipt bad-unit-share)))
    (let s8 (rtex-post cm s7 (texture-of native-receipt half-share)))
    (let s9 (rtex-post cm s8 (texture-of malformed native-share)))

    (sum (list
        (rtb-bit (and (str_eq (rtex-provenance-of-share3 100 0 0) "form-native")
                      (and (str_eq (rtex-provenance-of-share3 0 100 0) "local-oracle")
                           (and (str_eq (rtex-provenance-of-share3 0 0 100) "remote-oracle")
                                (nothing? (rtex-provenance-of-share3 0 0 0))))) 1)
        (rtb-bit (and (str_eq (rtex-share-provenance resident-share) "hearth-resident")
                      (and (eq (rtex-share-energy resident-share) 0)
                           (and (str_eq (rtex-share-provenance remote-share) "remote-oracle")
                                (eq (rtex-share-energy remote-share) 1500)))) 2)
        (rtb-bit (and (str_eq (rtex-provenance-of-surface "native-recipe") "form-native")
                      (and (str_eq (rtex-provenance-of-surface "local-process") "local-oracle")
                           (and (str_eq (rtex-provenance-of-surface "remote-membrane") "remote-oracle")
                                (nothing? (rtex-provenance-of-surface "cloud"))))) 4)
        (rtb-bit (rtb-all-different? (list (rtex-entry-id t-native) (rtex-entry-id t-remote)
                                           (rtex-entry-id t-silence) (rtex-entry-id t-fail))) 8)
        (rtb-bit (rtb-all-different? (list (rtex-entry-kind t-native) (rtex-entry-kind t-remote)
                                           (rtex-entry-kind t-silence) (rtex-entry-kind t-fail))) 16)
        (rtb-bit (and (str_eq (rtex-entry-account t-native) "texture-band")
                      (and (str_eq (rtex-entry-kind t-native) "form-native:success:meaning:learned:tokens:100/0/0")
                           (and (eq (rtex-entry-amount t-native) 300)
                                (eq (rtex-outcome-code t-native) 1)))) 32)
        (rtb-bit (and (str_eq (rtex-entry-kind t-remote) "remote-oracle:success:meaning:learned:tokens:0/0/100")
                      (eq (rtex-entry-amount t-remote) 1500)) 64)
        (rtb-bit (and (str_eq (rtex-entry-kind t-silence) "form-native:silence:benefit-of-silence:effect:ms:60/40/0")
                      (and (eq (rtex-entry-amount t-silence) 40)
                           (eq (rtex-outcome-code t-silence) (sub 0 1)))) 128)
        (rtb-bit (and (str_eq (rtex-entry-kind t-fail) "local-oracle:fail:structural-knowledge:computed:ms:0/100/0")
                      (eq (rtex-entry-amount t-fail) 250)) 256)
        (rtb-bit (and (eq (vl-count cm s4) 4)
                      (and (eq (vl-count cm s5) 4)
                           (eq (vl-balance cm s5 "texture-band") balance-4))) 512)
        (rtb-bit (and (eq balance-4 2090)
                      (eq (vl-balance cm s6 "texture-band") 2090)) 1024)
        (rtb-bit (and (eq (rtex-sensed t-sacred) 1)
                      (and (eq (rtex-billed t-sacred) 0)
                           (and (eq (rtex-entry-amount t-sacred) 0)
                                (and (str_eq (rtex-plane t-sacred) "sensed")
                                     (and (eq (vl-entry-exists? cm s6 (rtex-entry-id t-sacred)) 1)
                                          (and (eq (vl-count cm s6) 5)
                                               (eq (vl-balance cm s6 "texture-band-sacred") 0))))))) 2048)
        (rtb-bit (and (nothing? (texture-of native-receipt bad-unit-share))
                      (and (nothing? (texture-of native-receipt half-share))
                           (and (nothing? (texture-of malformed native-share))
                                (eq (vl-count cm s9) 5)))) 4096)
        (rtb-bit (and (eq (len (rtex-fields)) 7)
                      (and (gt (str_len (rtex-field-organ (nth (rtex-fields) 0))) 0)
                           (and (gt (str_len (rtex-field-organ (nth (rtex-fields) 6))) 0)
                                (and (eq (len (rtex-provenances)) 4)
                                     (eq (len (rtex-units)) 4))))) 8192))))
