; living-world-action-enquiry-observation.fk -- privacy-bounded causal view.
; Returns aggregate structure/optionality/authority facts only.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-action-enquiry.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk form-stdlib/tests/living-world-action-enquiry-witness.fk

(defn lwaeo-active-selections (world items count)
    (if (eq (len items) 0) count
        (do
            (let candidate (head items))
            (lwaeo-active-selections world (tail items)
                (if (and (eq (lwac-selection-candidate? candidate) 1)
                         (eq (lwac-selection-integrated-current?
                                world candidate) 1))
                    (add count 1) count)))))

(defn lwaeo-active-executions (world items count)
    (if (eq (len items) 0) count
        (do
            (let candidate (head items))
            (lwaeo-active-executions world (tail items)
                (if (and (eq (lwac-execution-candidate? candidate) 1)
                         (and (eq (lwo-active? world candidate) 1)
                              (eq (lwac-execution-candidate-current?
                                     world candidate) 1)))
                    (add count 1) count)))))

(do
    (let world (lwaew-world))
    (let field (lwaew-field))
    (let eligible (lwae-eligible-for-field world field))
    (let proposal (lwaew-question-proposal))
    (let candidate (lwaew-question-candidate))
    (let waiting-world
        (lwt-round-world (lwaew-question-waiting-round)))
    (let question-world (lwaew-question-world))
    (let stanced-world (lwaew-stanced-world))
    (let stance-evidence (lwaew-stance-evidence))
    (let stanced-field
        (lwac-field-for stanced-world (lwacw-focus) 2))
    (let revoked-world (lwaew-revoked-world))
    (let revoked-field
        (lwac-field-for revoked-world (lwacw-focus) 2))
    (let revoked-selection
        (lwac-selection-proposal revoked-world (lwacw-focus) 2))
    (let layered-stack
        (lwlc-declaration-stack (lwaew-layered-declaration)))
    (list
        (list
            (lwo-field-size (lwac-field-candidates field))
            (lwo-field-size eligible)
            (lwac-open? (lwac-field-status field))
            (node_eq (lwac-field-primary field) (lwo-none))
            (lwo-field-size (lwac-field-alternatives field))
            (lwo-field-size (lwac-field-unknowns field))
            (lwlc-unknown? (lwac-field-derived-unknown field)))
        (list
            (lwo-field-size (lwt-proposal-participants proposal))
            (lwo-field-size (lwo-emergent-witnesses candidate))
            (lwae-question-current? world candidate)
            (lwo-emergent-ready? world candidate)
            (lwo-active? waiting-world candidate)
            (lwo-active? question-world candidate)
            (lwo-field-size
                (lwo-active-attributions-for question-world candidate))
            (lwae-question-steady? question-world candidate)
            (node_eq
                (lwae-question-proposal question-world
                    (lwacw-focus) 2)
                (lwo-none))
            (node_eq
                (lwac-selection-proposal world (lwacw-focus) 2)
                (lwo-none))
            (node_eq
                (lwac-selection-proposal stanced-world
                    (lwacw-focus) 2)
                (lwo-none)))
        (list
            (lwo-field-size stance-evidence)
            (lwae-stance-valid? stanced-world
                (lwaew-immediate-stance))
            (lwae-stance-immediate-nothing?
                (lwaew-immediate-stance))
            (lwae-stance-valid? stanced-world
                (lwaew-pending-stance))
            (lwae-stance-time-pending?
                (lwaew-pending-stance))
            (lwae-stance-alternative?
                (lwaew-pending-stance))
            (lwlc-declaration-valid?
                (lwaew-layered-declaration))
            (lwlc-lens?
                (lwlc-stack-default layered-stack))
            (len (lwlc-layer-items
                (lwlc-stack-layers layered-stack)))
            (lwo-field-size
                (lwlc-stack-alternatives layered-stack))
            (lwlc-unknown?
                (lwlc-stack-unknown layered-stack))
            (lwae-stance-valid? stanced-world
                (lwaew-default-outcome-stance))
            (lwae-stance-timed?
                (lwaew-default-outcome-stance))
            (lwae-stance-alternative?
                (lwaew-default-outcome-stance))
            (lwae-stance-valid? stanced-world
                (lwaew-expired-nothing-stance))
            (lwae-stance-expired-to-nothing?
                (lwaew-expired-nothing-stance))
            (not (node_eq
                (lwaew-immediate-stance)
                (lwaew-expired-nothing-stance)))
            (node_eq field stanced-field)
            (lwaeo-active-selections stanced-world
                (lwo-field-items (lwo-world-cells stanced-world)) 0)
            (lwaeo-active-executions stanced-world
                (lwo-field-items (lwo-world-cells stanced-world)) 0))
        (list
            (lwae-question-current? revoked-world candidate)
            (lwo-field-size
                (lwae-stance-evidence-for revoked-world candidate))
            (lwac-ready? (lwac-field-status revoked-field))
            (not (node_eq revoked-selection (lwo-none)))
            (if (node_eq revoked-selection (lwo-none)) 0
                (lwo-active? revoked-world
                    (lwt-proposal-candidate revoked-selection))))))
