; findings-requests-band.bml — a review's findings become local work requests, read by the body with no model.
; form-stdlib/bml/findings-requests.bml walks any findings document whole and gives one request row per finding;
; observe/findings-to-requests-run.bml feeds learn/local-requests.jsonl from it. Each claim reads exact fields of
; the rows three fixtures give (a workflow's lenses, a survey's faces, a wave's groups), so a stub that answers
; no rows, keeps a refuted finding, takes the finder's fix over the verifier's, or loses a field reads 0.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/findings-requests.bml
;
; Verdict 255 when every claim lands:
;   1     issues[] under two lenses give three rows: problem, the fix as needs, severity, where's file:line spans,
;         files found in the tree (a where naming a file with no line still names it), origin <doc>/<lens>/issues,
;         ref and verdict null, status pending; the receipt and the progress array give nothing
;   2     findings[] join verified[] by id inside their face: a confirmed and a partial finding carry the refined
;         fix and their verdict, the verifier's evidence after the finder's, owner_files of both; the refuted one
;         gives no row; an unverified one keeps its fix; missed[] stands with its own fix; a verdict no finding
;         claims stands alone; the counts read [5 rows, 5 read, 1 refuted, 4 verdicts, 3 joined]
;   4     deferred[] gives its why as problem and its needs as needs, its id as ref, a bare main.go found under the
;         Go kernel's home; open_issues[] strings stand as problems with needs, severity and evidence null; done[],
;         commits[] and verification[] give nothing
;   8     where reads every file:line a text names and nothing else: no bare ":274", no clock time, no URL host,
;         leading "./" dropped, spans kept whole
;   16    the id is a content hash: "frq-" and 16 lowercase hex digits, the same document read twice gives the
;         same ids, another origin or one changed byte of a problem gives another id, and every row is whole
;         (its id recomputes from its origin, where and problem)
;   32    feeding a temp ledger appends each row once: a second feed of the same document adds none, the same
;         survey with one more finding adds only that one, and another document adds its own
;   64    a closure closes a row only when its witness holds, did not already hold in the tree the review read,
;         and a commit stands: a standing needle the review did not see closes it with commit, review and
;         witness carried; a needle that is not there refuses (witness); one the review's tree already held
;         refuses (stood-before); present 0 over a needle that is gone closes, its review taken from the
;         document's map; a commit-of answering "" refuses (commit); an unknown id is counted; the saved
;         ledger reads the closed row back closed
;   128   every row of learn/local-requests.jsonl is whole, with a unique id, and a closed row names its commit
section [form.bml] {
 class FindingsRequestsBand {
  def frb-bit(ok, bit) = if ok then bit else 0;
  def frb-null?(row, k) = node_eq(frq-get(row, k), json-node-null());
  def frb-is(row, k, want) = (String) frq-text(row, k) == want;
  def frb-list-is(row, k, want) = (Value) frq-list(row, k) == want;
  // total over any answer: a row or an id the stub did not give reads as an empty one, so every claim ends
  def frb-at(rows, i) = if ((String) value_kind(rows) != "list") then json-node-object([]) else if (len(rows) > i) then rows[i] else json-node-object([]);
  def frb-id-at(ids, i) = if (len(ids) > i) then ids[i] else "";
  def frb-workflow() = "{\"summary\":\"s\",\"result\":[{\"lens\":\"kernels\",\"issues\":[{\"severity\":\"blocking\",\"where\":\"runtime/fkwu-uni.c:17645-17651 (tag 132); json.fk:12\",\"problem\":\"The flip got lost. More words.\",\"evidence\":\"probe p11\",\"fix\":\"Change line 17651 to return fk_nothing.\"},{\"severity\":\"note\",\"where\":\"gate/drift-gates.bml (no row)\",\"problem\":\"No gate runs the band.\",\"evidence\":\"grep finds nothing\",\"fix\":\"Add a row.\"}],\"receipt\":{\"surprise\":\"x\"}},{\"lens\":\"docs\",\"issues\":[{\"severity\":\"should-fix\",\"where\":\"AGENTS.md:322\",\"problem\":\"AGENTS names walkers.\",\"evidence\":\"line 322\",\"fix\":\"Name the kernels.\"}]}],\"workflowProgress\":[{\"label\":\"kernels\",\"resultPreview\":\"issues\"}]}";
  def frb-more() = ",{\"id\":\"E\",\"title\":\"E new\",\"where\":[\"x/e.fk:6\"],\"truth\":\"e\",\"evidence\":\"ee\",\"fix\":\"fix e\",\"severity\":\"low\"}";
  def frb-survey() = frb-survey-of("");
  def frb-survey-of(more) = frb-survey-head() ++ more ++ frb-survey-tail();
  def frb-survey-head() = "{\"result\":[{\"face\":\"k\",\"found\":{\"findings\":[{\"id\":\"A\",\"title\":\"A breaks\",\"kind\":\"defect\",\"where\":[\"x/a.fk:1-2\"],\"claim\":\"a holds\",\"truth\":\"a breaks\",\"evidence\":\"ea\",\"fix\":\"fix a\",\"owner_files\":[\"form/form-stdlib/json.fk\"],\"severity\":\"high\"},{\"id\":\"B\",\"title\":\"B partly\",\"where\":[\"x/b.fk:3\"],\"truth\":\"b partly\",\"evidence\":\"eb\",\"fix\":\"fix b\",\"severity\":\"medium\"},{\"id\":\"C\",\"title\":\"C wrong\",\"where\":[\"x/c.fk:4\"],\"truth\":\"c\",\"evidence\":\"ec\",\"fix\":\"fix c\",\"severity\":\"low\"},{\"id\":\"D\",\"title\":\"D alone\",\"where\":[\"x/d.fk:5\"],\"truth\":\"d\",\"evidence\":\"ed\",\"fix\":\"fix d\",\"severity\":\"low\"}";
  def frb-survey-tail() = "]},\"verified\":{\"verified\":[{\"id\":\"A\",\"verdict\":\"confirmed\",\"evidence\":\"va\",\"refined_fix\":\"refined a\",\"owner_files\":[\"form/form-stdlib/core.fk\"]},{\"id\":\"B\",\"verdict\":\"partial\",\"evidence\":\"vb\",\"refined_fix\":\"refined b\"},{\"id\":\"C\",\"verdict\":\"refuted\",\"evidence\":\"vc\",\"refined_fix\":\"\"},{\"id\":\"Z\",\"verdict\":\"confirmed\",\"evidence\":\"vz\",\"refined_fix\":\"refined z\"}],\"missed\":[{\"id\":\"M1\",\"title\":\"M one\",\"evidence\":\"see x/m.fk:9\",\"fix\":\"fix m in x/m.fk:9\",\"severity\":\"high\"}]}}]}";
  def frb-wave() = "{\"result\":[{\"group\":\"g\",\"impl\":{\"commits\":[\"abc fix\"],\"done\":[{\"id\":\"K1\",\"what\":\"did\"}],\"deferred\":[{\"id\":\"K4-siblings\",\"why\":\"Go files belong to another group. More.\",\"needs\":\"Go main.go:2670-2705: answer -1.\"}],\"verification\":[{\"command\":\"c\",\"result\":\"r\"}],\"open_issues\":[\"Law 9 stands partly. The rest waits.\",\"Cons keeps the pair.\"]},\"review\":{\"verdict\":\"changes-needed\",\"issues\":[{\"severity\":\"note\",\"where\":\"form/x-band.fk\",\"problem\":\"No gate runs it.\",\"evidence\":\"grep\",\"fix\":\"Register it.\"}],\"checks_rerun\":[{\"command\":\"c\",\"result\":\"r\"}]}}]}";
  def frb-doc(text) = parse-json("fixture", text);
  def frb-rows(text, label) = frq-requests(frb-doc(text), label)[0];
  def frb-issues() {
   let rows = frb-rows(frb-workflow(), "wf");
   let a = frb-at(rows, 0);
   let b = frb-at(rows, 1);
   let c = frb-at(rows, 2);
   (len(rows) == 3) && frb-is(a, "problem", "The flip got lost. More words.") && frb-is(a, "title", "The flip got lost.") && frb-is(a, "needs", "Change line 17651 to return fk_nothing.") && frb-is(a, "severity", "blocking")
   && frb-list-is(a, "where", ["runtime/fkwu-uni.c:17645-17651", "json.fk:12"]) && frb-list-is(a, "files", ["runtime/fkwu-uni.c", "form/form-stdlib/json.fk"]) && frb-is(a, "origin", "wf/kernels/issues")
   && frb-null?(a, "ref") && frb-null?(a, "verdict") && frb-is(a, "status", "pending") && frb-is(a, "evidence", "probe p11")
   && frb-list-is(b, "where", []) && frb-list-is(b, "files", ["gate/drift-gates.bml"]) && frb-is(b, "origin", "wf/kernels/issues")
   && frb-is(c, "origin", "wf/docs/issues") && frb-list-is(c, "where", ["AGENTS.md:322"]) && frb-list-is(c, "files", ["AGENTS.md"]) && frb-is(c, "severity", "should-fix");
  }
  def frb-joins() {
   let made = frq-requests(frb-doc(frb-survey()), "sv");
   let rows = made[0];
   let a = frb-at(rows, 0);
   let b = frb-at(rows, 1);
   let d = frb-at(rows, 2);
   let m = frb-at(rows, 3);
   let z = frb-at(rows, 4);
   (len(rows) == 5) && ((Value) [made[1], made[2], made[3], made[4]] == [5, 1, 4, 3])
   && frb-is(a, "ref", "A") && frb-is(a, "needs", "refined a") && frb-is(a, "verdict", "confirmed") && frb-is(a, "problem", "a breaks\nThe claim it breaks: a holds") && frb-is(a, "evidence", "ea\nVerified confirmed: va")
   && frb-list-is(a, "files", ["form/form-stdlib/json.fk", "form/form-stdlib/core.fk"]) && frb-is(a, "origin", "sv/k/found.findings") && frb-is(a, "title", "A breaks")
   && frb-is(b, "ref", "B") && frb-is(b, "needs", "refined b") && frb-is(b, "verdict", "partial")
   && frb-is(d, "ref", "D") && frb-is(d, "needs", "fix d") && frb-null?(d, "verdict") && frb-is(d, "evidence", "ed")
   && frb-is(m, "ref", "M1") && frb-is(m, "origin", "sv/k/verified.missed") && frb-is(m, "needs", "fix m in x/m.fk:9") && frb-list-is(m, "where", ["x/m.fk:9"]) && frb-is(m, "problem", "M one")
   && frb-is(z, "ref", "Z") && frb-is(z, "needs", "refined z") && frb-is(z, "verdict", "confirmed") && frb-is(z, "origin", "sv/k/verified.verified");
  }
  def frb-handed() {
   let rows = frb-rows(frb-wave(), "wv");
   let d = frb-at(rows, 0);
   let o = frb-at(rows, 1);
   let i = frb-at(rows, 3);
   (len(rows) == 4) && frb-is(d, "origin", "wv/g/impl.deferred") && frb-is(d, "problem", "Go files belong to another group. More.") && frb-is(d, "title", "Go files belong to another group.")
   && frb-is(d, "needs", "Go main.go:2670-2705: answer -1.") && frb-is(d, "ref", "K4-siblings") && frb-list-is(d, "where", ["main.go:2670-2705"]) && frb-list-is(d, "files", ["form/form-kernel-go/main.go"])
   && frb-is(o, "origin", "wv/g/impl.open_issues") && frb-is(o, "problem", "Law 9 stands partly. The rest waits.") && frb-is(o, "title", "Law 9 stands partly.")
   && frb-null?(o, "needs") && frb-null?(o, "severity") && frb-null?(o, "evidence") && frb-null?(o, "ref")
   && frb-is(frb-at(rows, 2), "problem", "Cons keeps the pair.") && frb-is(i, "origin", "wv/g/review.issues") && frb-is(i, "needs", "Register it.");
  }
  def frb-where() {
   let text = "runtime/fkwu-uni.c:17645-17651 (tag 132); commit c6d7478ce; form-fs.fk:262 and :274; at 15:31:20; https://x.y:80/z.md:3 and ./form/a.bml:3, then main.go:2454-2461, end: v1.2.3:4.";
   ((Value) frq-refs(text) == ["runtime/fkwu-uni.c:17645-17651", "form-fs.fk:262", "form/a.bml:3", "main.go:2454-2461"]) && ((Value) frq-refs("no span here: 12 and a.b: 3") == []);
  }
  def frb-hex?(s, i) = if (i >= len(s)) then true else if (((str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57)) || ((str_byte_at(s, i) >= 97) && (str_byte_at(s, i) <= 102))) then frb-hex?(s, (i + 1)) else false;
  def frb-id-shape?(id) = ((Comparable) len(id) == 20) && ((String) substring(id, 0, 4) == "frq-") && frb-hex?(substring(id, 4, 20), 0);
  def frb-ids() {
   let one = frq-ids(frb-rows(frb-survey(), "sv"));
   let two = frq-ids(frb-rows(frb-survey(), "sv"));
   let other = frq-ids(frb-rows(frb-survey(), "sv2"));
   let changed = frq-id("sv/k/found.findings", ["x/a.fk:1-2"], "a breaks\nThe claim it breaks: a hold");
   let all = append(frb-rows(frb-workflow(), "wf"), append(frb-rows(frb-survey(), "sv"), frb-rows(frb-wave(), "wv")));
   (len(one) == 5) && ((Value) one == two) && (!((String) frb-id-at(one, 0) == frb-id-at(other, 0))) && (!((String) frb-id-at(one, 0) == changed)) && all?(frb-id-shape?, one) && all?(frq-whole?, all);
  }
  // a private place for the ledger and the witness
  def frb-dir() = temp_dir() ++ "/frq-band-" ++ host_pid().str();
  def frb-ledger() = frb-dir() ++ "/requests.jsonl";
  def frb-lines(path) = len(filter(l => frq-some?(trim(l)), split-on(read_file(path) ?? "", "\n")));
  def frb-ledger-feeds() {
   let made = fs_mkdir(frb-dir());
   let gone = host_path_remove(frb-ledger());
   let first = frq-feed(frb-ledger(), frb-doc(frb-survey()), "sv");
   let again = frq-feed(frb-ledger(), frb-doc(frb-survey()), "sv");
   let shared = frq-feed(frb-ledger(), frb-doc(frb-survey-of(frb-more())), "sv");
   let wider = frq-feed(frb-ledger(), frb-doc(frb-wave()), "wv");
   ((Value) [first[0], first[1], first[6]] == [5, 5, 5]) && ((Value) [again[0], again[1], again[6]] == [5, 0, 0]) && ((Value) [shared[0], shared[1], shared[6]] == [6, 1, 1]) && ((Comparable) wider[1] == 4) && ((Comparable) frb-lines(frb-ledger()) == 10);
  }
  def frb-witness-file() = frb-dir() ++ "/witness.txt";
  def frb-closure(id, needle, present, commit) = frb-closure-read(id, needle, present, commit, "");
  def frb-closure-read(id, needle, present, commit, reviewed) = parse-json("closure", "{\"id\":\"" ++ id ++ "\",\"commit\":\"" ++ commit ++ "\",\"reviewed\":\"" ++ reviewed ++ "\",\"note\":\"read\",\"witness\":{\"path\":\"" ++ frb-witness-file() ++ "\",\"needle\":\"" ++ needle ++ "\",\"present\":" ++ present.str() ++ "}}");
  def frb-commit-of(c) = frq-text(c, "commit");
  // the witness file as two reviews read it: one before the fix (no needle), one after it (the needle stood)
  def frb-earlier-of(c) = if ((String) frq-text(c, "reviewed") == "3becad905") then "alpha\nreturn 1;\nomega\n" else if ((String) frq-text(c, "reviewed") == "a0c5c01e5") then "alpha\nreturn fk_nothing;\n" else nothing();
  def frb-closes() {
   let made = fs_mkdir(frb-dir());
   let wrote = write_file(frb-witness-file(), "alpha\nreturn fk_nothing;\nomega\n");
   let rows = frb-rows(frb-survey(), "sv");
   let ids = frq-ids(rows);
   let cs = [frb-closure-read(frb-id-at(ids, 0), "return fk_nothing;", 1, "5cf407d15", "3becad905"), frb-closure(frb-id-at(ids, 1), "return 1;", 1, "5cf407d15"), frb-closure(frb-id-at(ids, 2), "return 1;", 0, "13c2d2292"), frb-closure-read(frb-id-at(ids, 3), "alpha", 1, "", "none"), frb-closure-read(frb-id-at(ids, 4), "return fk_nothing;", 1, "5cf407d15", "a0c5c01e5"), frb-closure("frq-0000000000000000", "alpha", 1, "5cf407d15")];
   let r = frq-close(rows, cs, json-node-object([fhn-s("sv", "3becad905")]), frb-commit-of, frb-earlier-of);
   let after = r[0];
   let a = frb-at(after, 0);
   let saved = frq-save(frb-ledger(), after);
   let back = frq-rows(frb-ledger());
   (len(rows) == 5) && ((Value) [r[1], r[2], r[3], r[4], r[5]] == [2, 1, 1, 1, 1]) && frb-is(a, "status", "closed") && frb-is(a, "closed_by", "5cf407d15") && frb-is(a, "reviewed", "3becad905") && frb-is(frq-get(a, "witness"), "needle", "return fk_nothing;") && frb-is(a, "closed_note", "read")
   && frb-is(frb-at(after, 1), "status", "pending") && frb-is(frb-at(after, 2), "status", "closed") && frb-is(frb-at(after, 2), "closed_by", "13c2d2292") && frb-is(frb-at(after, 2), "reviewed", "3becad905") && frb-is(frb-at(after, 3), "status", "pending") && frb-is(frb-at(after, 4), "status", "pending")
   && ((Comparable) saved == 1) && ((Comparable) len(back) == 5) && frb-is(frb-at(back, 0), "status", "closed") && frb-is(frb-at(back, 2), "closed_by", "13c2d2292") && all?(frq-whole?, back);
  }
  // the live ledger the door feeds
  def frb-unique?(ids) = if nil?(ids) then true else if frq-has(ids[1:], ids[0]) then false else frb-unique?(ids[1:]);
  def frb-live() {
   let rows = frq-rows(frq-ledger());
   (len(rows) > 0) && frb-unique?(frq-ids(rows)) && all?(frq-whole?, rows);
  }
 }
 frb-bit(frb-issues(), 1) + frb-bit(frb-joins(), 2) + frb-bit(frb-handed(), 4) + frb-bit(frb-where(), 8)
 + frb-bit(frb-ids(), 16) + frb-bit(frb-ledger-feeds(), 32) + frb-bit(frb-closes(), 64) + frb-bit(frb-live(), 128);
}
