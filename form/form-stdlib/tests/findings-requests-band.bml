   let defs = [frq-text(fix, "path") ++ ":" ++ frq-text(fix, "def")];
   let row = (id, text, f) => frq-restatus(frq-put(frq-put(frq-put(a, "id", json-node-string(id)), "moot", frq-put(frb-moot-text(3, [0, 0], defs, text), "band_sha", json-node-string(frq-sha(frb-chk-band(3))))), "fixborn", f));
   let rows = [row("chk-a", frb-chk-band(3), fix), row("chk-b", frb-chk-band(1), fix), frq-restatus(frq-put(frq-put(a, "id", json-node-string("chk-c")), "moot", frb-moot-text(3, [0, 0], defs, frb-chk-band(1)))), row("chk-d", frb-chk-band(3), frq-put(fix, "needle", json-node-string("(defn nothing-like-this-stands)")))];
   let gone = host_path_remove(dir ++ "/chk.jsonl");
   let saved = frq-save(dir ++ "/chk.jsonl", rows);
   let checked = frb-chk-spawn("chk", "{\"check\":1,\"head\":\"9359992d8\",\"ledger\":\"" ++ dir ++ "/chk.jsonl\"}\n");
   frb-says?(said, "findings-requests: sight rows=1 sight_standing=0 sight_moved=1 sight_gone=0 sight_unseen=0 fixborn=1 demoted=0 unreadable=0 pending=0 context=0 answered=0 handed=0 no_action=0 closed=0 moved=1 moot=0 statement=0 saved=1\n") && frb-is(a, "status", "moved") && frq-hex?(frq-text(fix, "commit")) && frq-at?(frq-text(fix, "def"), 0, "flp-") && frb-is(fix, "seen", "7f557742f")
   && ((Comparable) saved == 1) && ((Value) map(r => frq-text(r, "status"), rows) == ["moot", "moot", "moot", "moot"])
   && frb-says?(checked, " moot_holding=1 moot_reopen=chk-b:refused:band-text,chk-c:refused:band-reads,chk-d:refused:fixborn\n");
  }
 }
 let pure = frb-bit(frb-issues(), 1) + frb-bit(frb-joins(), 2) + frb-bit(frb-handed(), 4) + frb-bit(frb-where(), 8) + frb-bit(frb-ids(), 16) + frb-bit(frb-ledger-feeds(), 32) + frb-bit(frb-gate(), 64) + frb-bit(frb-live(), 128) + frb-bit(frb-repairs(), 256) + frb-bit(frb-across(), 512) + frb-bit(frb-seen(), 1024) + frb-bit(frb-statements(), 32768);
 let git = frb-bit(frb-git(), 2048) + frb-bit(frb-sight() && frb-history(), 16384) + frb-bit(frb-bounds(), 131072) + frb-bit(frb-keeps(), 262144);
 let door = frb-door-run();
 let sighted = frb-sight-door();
 let verdict = pure + git + frb-bit(frb-door-closes(door), 4096) + frb-bit(frb-door-checks(door), 8192) + frb-bit(frb-moots() && frb-sight-door-ok(sighted), 65536) + frb-bit(frb-moot-checks() && frb-chk-door(), 524288);
 let gone = host_dir_rmdir(frb-dir());
 let cleared = frq-git-done();
 verdict;
}
