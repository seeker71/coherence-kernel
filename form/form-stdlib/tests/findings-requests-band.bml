; findings-requests-band.bml — a review's findings become local work requests, read by the body with no model.
; form-stdlib/bml/findings-requests.bml walks any findings document whole and gives one request row per finding;
; observe/findings-to-requests-run.bml feeds learn/local-requests.jsonl from it and closes rows through its gate.
; Each claim reads exact fields of the rows fixtures give (a workflow's lenses, a survey's faces, a wave's groups
; with their repairs), so a stub that answers no rows, keeps a refuted finding, loses an answer, or lets a needle
; close that the gate must refuse reads 0.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/findings-requests.bml
;
; Verdict 1048575 when every claim lands:
;   1     issues[] under two lenses give three pending rows: problem, the fix as needs, severity, where's
;         file:line spans, files found in the tree, origin <doc>/<lens>/issues, ref, verdict and seen null
;   2     findings[] join verified[] by id inside their face: a confirmed and a partial finding carry the refined
;         fix and their verdict, the verifier's evidence after the finder's, owner_files of both; the refuted one
;         gives no row; missed[] stands with its own fix; a verdict no finding claims stands alone; a finding
;         that names no file in the tree is context, not a request
;   4     deferred[] gives its why as problem and its needs as needs, a bare main.go found under the Go kernel's
;         home; open_issues[] strings stand as statements (no needs); done[], commits[] and verification[] give no row
;   8     where reads every file:line a text names and nothing else: no bare ":274", no clock time, no URL host
;   16    the id is a content hash: "frq-" and 16 hex digits, stable, origin- and byte-sensitive, and every row
;         is whole (its id recomputes and its status is the one its fields read)
;   32    feeding a temp ledger appends each row once, and a document's answers stand on the ledger's rows
;         once: a second feed adds no row and a second answering adds no answer
;   64    the gate over a fixture history: a path outside the tree, no seentip, a seentip that is no commit, a
;         named one outside HEAD's history, a witness file the seentip did not hold, a needle that is not there,
;         one that stood before, one only on a comment line, a band bit that is not set, a named commit the
;         pickaxe does not give, and a closing commit inside the reviewed tree each refuse; a fresh code needle,
;         a needle in a text file, a comment needle beside a band bit, and a needle gone (present 0) each close,
;         carrying commit, reviewed tree and witness; a check reads a doctored closed row and names it
;   128   every row of learn/local-requests.jsonl is whole, with a unique id
;   256   a repair answers its unit's review issues: R1-, review-2-, should-fix-3, S1 (within the severity),
;         a topic's words, "(review note #6)" handing the issue to the deferred row; a named severity that
;         disagrees joins nothing; "no change needed" and needs that say None read no-action
;   512   a wave's done and deferred answer another document's findings: a unique id, a named face (d-F1), the
;         face most of the unit's ids land in (M1), the one finding whose file the text names (F7); an id two
;         faces carry with no file named stays unanswered; the answering document's own rows never
;   1024  seen: a review and its impl's deferrals read the tip of impl.commits, a repair's rows the tip of
;         repair.commits; a line that names no commit is passed over; a top-level array reads none
;   2048  the git reader on this repo's history: a blob past host_capture's one megabyte reads whole, a file
;         the tree did not hold reads nothing, commit?, ancestor?, related?, pickaxe, full, a band's verdict
;         equal to its head pin, and the tip of a commit list
;   4096  the door on a scratch ledger: the integrated review with no seentip refuses, and with b5d7288c0 named
;         stood before; a bogus reviewed hash, a witness outside the tree, a needle that stood in a0c5c01e5, a
;         comment needle, a named commit the pickaxe does not give and an unset band bit refuse; a fresh code
;         needle and a comment needle beside a set band bit close
;   8192  the door's check reads every closed row through the gate again: both real closures hold, and a whole
;         row closed by hand on a needle that stood in the reviewed tree is named in reopen
;   16384 sight: a diff -U0 reads as old ranges and added lines; over a fixture history a ref reads moved when a hunk
;         overlaps its span (an insertion at line s counts when the span holds s), standing when none does, gone when
;         HEAD lacks the path, unseen without a seentip or when the seentip never held the path; the fixborn of a
;         moved row is the longest code line the overlapping hunks added, never a comment, and passes the closing
;         gate (commit, path, needle, span, seen kept, and the definition the needle stands in: w-two in a .bml
;         fixture, "" in C); a hunk of two old lines (@@ -2,2) holds both of them and no third, so a ref at line 4 stands
;         and refs at lines 3 and 2 move; over this repo's history read as of d64da0313, the integrated review's
;         fkwu-uni.c:11870-11877 reads moved with a fixborn from 0da9fb03a and form-cli-code-circle.bml:194-199
;         reads standing
;   32768 statements: open_issues strings read statement; the pass names the files their words carry as the reader's
;         HEAD tracks them (a bare validate.sh is form/validate.sh); a deferral with needs and no file stays
;         context; a stored context row of a statement reads statement when the pass reads it again; the nine
;         status words count their rows
;   65536 moot is a proposal the gate confirms: a witness whose band read its full today and below it under every stub,
;         beside a standing fixborn whose path:definition the witness names, makes a moved row moot; a witness over
;         another definition, none, a fixborn without a definition, a row with no fixborn (pending), a witness whose
;         today reads below full, a stub at full, no stub or an unknown id leaves the row and the ledger as they were;
;         a witness without its fixborn reads pending; and the door's sight pass (option "sight", keys sight_*) over a
;         scratch ledger as of d64da0313 reads standing, moved, unseen and statement rows, saves once and finds nothing
;         to save the second time
;   131072 bounds: a ledger saves only whole: a row on disk the caller never read, a half-written last line and a last
;         line with no newline each leave the file as it was (saved 0), and the door reports the unreadable line; a
;         token of 3000 bytes is no file name and no git argv carries it
;   262144 a pass keeps what it proved: a moved row read without its reviewed map (unseen) keeps its fixborn byte for
;         byte and gains its definition when it had none, the door's pass without the map saves nothing and keeps
;         sight-a moved; a sight that reads standing drops the fixborn, and a moved or moot row it turns back is
;         counted as demoted
;   524288 moot read again: a moot row holds while its fixborn passes the gate, its band's text matches its sha and
;         its band reads its full (fixture reader); refused:witness, refused:fixborn, refused:band-text, refused:band-run
;         and refused:band-reads name what fell; the door's check over a real fixborn of the planner (7f557742f to
;         9359992d8) runs the kept band on fkwu and reopens a doctored text, a band reading below full and a fixborn
;         whose needle is gone
;
; PROOF LEVEL: FOURTH-ARM ONLY -- bits 2048-8192 and 16384-524288 spawn git and ./fkwu (host_spawn_at,
; host_spawn_quiet, host_capture); the reference kernels hold no child process to spawn.
section [form.bml] {
 class FindingsRequestsBand {
  def frb-bit(ok, bit) = if ok then bit else 0;
  def frb-null?(row, k) = node_eq(frq-get(row, k), json-node-null());
  def frb-is(row, k, want) = (String) frq-text(row, k) == want;
  def frb-list-is(row, k, want) = (Value) frq-list(row, k) == want;
  // total over any answer: a row or an id the stub did not give reads as an empty one, so every claim ends
  def frb-at(rows, i) = if ((String) value_kind(rows) != "list") then json-node-object([]) else if (len(rows) > i) then rows[i] else json-node-object([]);
  def frb-id-at(ids, i) = if (len(ids) > i) then ids[i] else "";
  def frb-answers(row) = frq-nodes(row, "answers");
  def frb-answer(row, i) = frb-at(frb-answers(row), i);
  def frb-tip(hs) = if nil?(hs) then "" else hs[(len(hs) - 1)];
  def frb-workflow() = "{\"summary\":\"s\",\"result\":[{\"lens\":\"kernels\",\"issues\":[{\"severity\":\"blocking\",\"where\":\"runtime/fkwu-uni.c:17645-17651 (tag 132); json.fk:12\",\"problem\":\"The flip got lost. More words.\",\"evidence\":\"probe p11\",\"fix\":\"Change line 17651 to return fk_nothing.\"},{\"severity\":\"note\",\"where\":\"gate/drift-gates.bml (no row)\",\"problem\":\"No gate runs the band.\",\"evidence\":\"grep finds nothing\",\"fix\":\"Add a row.\"}],\"receipt\":{\"surprise\":\"x\"}},{\"lens\":\"docs\",\"issues\":[{\"severity\":\"should-fix\",\"where\":\"AGENTS.md:322\",\"problem\":\"AGENTS names walkers.\",\"evidence\":\"line 322\",\"fix\":\"Name the kernels.\"}]}],\"workflowProgress\":[{\"label\":\"kernels\",\"resultPreview\":\"issues\"}]}";
  def frb-more() = ",{\"id\":\"E\",\"title\":\"E new\",\"where\":[\"x/e.fk:6\"],\"truth\":\"e\",\"evidence\":\"ee\",\"fix\":\"fix e\",\"severity\":\"low\"}";
  def frb-survey() = frb-survey-of("");
  def frb-survey-of(more) = frb-survey-head() ++ more ++ frb-survey-tail();
  def frb-survey-head() = "{\"result\":[{\"face\":\"k\",\"found\":{\"findings\":[{\"id\":\"A\",\"title\":\"A breaks\",\"kind\":\"defect\",\"where\":[\"x/a.fk:1-2\"],\"claim\":\"a holds\",\"truth\":\"a breaks\",\"evidence\":\"ea\",\"fix\":\"fix a\",\"owner_files\":[\"form/form-stdlib/json.fk\"],\"severity\":\"high\"},{\"id\":\"B\",\"title\":\"B partly\",\"where\":[\"x/b.fk:3\"],\"truth\":\"b partly\",\"evidence\":\"eb\",\"fix\":\"fix b\",\"severity\":\"medium\"},{\"id\":\"C\",\"title\":\"C wrong\",\"where\":[\"x/c.fk:4\"],\"truth\":\"c\",\"evidence\":\"ec\",\"fix\":\"fix c\",\"severity\":\"low\"},{\"id\":\"D\",\"title\":\"D alone\",\"where\":[\"x/d.fk:5\"],\"truth\":\"d\",\"evidence\":\"ed\",\"fix\":\"fix d\",\"severity\":\"low\"}";
  def frb-survey-tail() = "]},\"verified\":{\"verified\":[{\"id\":\"A\",\"verdict\":\"confirmed\",\"evidence\":\"va\",\"refined_fix\":\"refined a\",\"owner_files\":[\"form/form-stdlib/core.fk\"]},{\"id\":\"B\",\"verdict\":\"partial\",\"evidence\":\"vb\",\"refined_fix\":\"refined b\"},{\"id\":\"C\",\"verdict\":\"refuted\",\"evidence\":\"vc\",\"refined_fix\":\"\"},{\"id\":\"Z\",\"verdict\":\"confirmed\",\"evidence\":\"vz\",\"refined_fix\":\"refined z\"}],\"missed\":[{\"id\":\"M1\",\"title\":\"M one\",\"evidence\":\"see x/m.fk:9\",\"fix\":\"fix m in x/m.fk:9\",\"severity\":\"high\"}]}}]}";
  def frb-wave() = "{\"result\":[{\"group\":\"g\",\"impl\":{\"commits\":[\"abc fix\"],\"done\":[{\"id\":\"K1\",\"what\":\"did\"}],\"deferred\":[{\"id\":\"K4-siblings\",\"why\":\"Go files belong to another group. More.\",\"needs\":\"Go main.go:2670-2705: answer -1.\"}],\"verification\":[{\"command\":\"c\",\"result\":\"r\"}],\"open_issues\":[\"Law 9 stands partly. The rest waits.\",\"Cons keeps the pair.\"]},\"review\":{\"verdict\":\"changes-needed\",\"issues\":[{\"severity\":\"note\",\"where\":\"form/x-band.fk\",\"problem\":\"No gate runs it.\",\"evidence\":\"grep\",\"fix\":\"Register it.\"}],\"checks_rerun\":[{\"command\":\"c\",\"result\":\"r\"}]}}]}";
  // a wave group, its review and the repair that answers it
  def frb-repair() = "{\"result\":[{\"group\":\"g\",\"impl\":{\"commits\":[\"1111111 one\",\"2222222 two\",\"(earlier, unchanged: 0000000)\"],\"done\":[{\"id\":\"K9\",\"what\":\"did\"}],\"deferred\":[{\"id\":\"K9-rest\",\"why\":\"Later.\",\"needs\":\"Do the rest in runtime/fkwu-uni.c:9.\"}]},\"review\":{\"verdict\":\"changes-needed\",\"issues\":[" ++ frb-issues-of() ++ "]},\"repair\":{\"commits\":[\"3333333 r\"],\"done\":[{\"id\":\"R1-blocking-flip\",\"what\":\"Flipped.\"},{\"id\":\"review-2-second\",\"what\":\"Checked; no change needed.\"},{\"id\":\"should-fix-3 third\",\"what\":\"Third done.\"},{\"id\":\"S1 again\",\"what\":\"Third again.\"},{\"id\":\"R3-note-wrong\",\"what\":\"Wrong severity.\"},{\"id\":\"review-note-census-floor\",\"what\":\"Census re-read.\"},{\"id\":\"review-9-none\",\"what\":\"No such issue.\"}],\"deferred\":[{\"id\":\"bell (review note #6)\",\"why\":\"Not mine.\",\"needs\":\"Bound the bell in runtime/fkwu-uni.c:60.\"}]}}]}";
  def frb-issue(sev, where, problem, fix) = "{\"severity\":\"" ++ sev ++ "\",\"where\":\"" ++ where ++ "\",\"problem\":\"" ++ problem ++ "\",\"evidence\":\"e\",\"fix\":\"" ++ fix ++ "\"}";
  def frb-issues-of() = str-join-with([frb-issue("blocking", "runtime/fkwu-uni.c:10", "P1 flip lost.", "Fix one in runtime/fkwu-uni.c."), frb-issue("blocking", "runtime/fkwu-uni.c:20", "P2 second.", "Fix two."), frb-issue("should-fix", "runtime/fkwu-uni.c:30", "P3 third.", "Fix three."), frb-issue("note", "runtime/fkwu-uni.c:40", "P4 base.", "None. Review against 1111111."), frb-issue("note", "CURRENT_FLOOR.md:5", "P5 the census figure is stale.", "Re-read the census."), frb-issue("note", "runtime/fkwu-uni.c:60", "P6 bell reader.", "Bound the bell."), frb-issue("note", "runtime/fkwu-uni.c:70", "P7 untouched.", "Leave it.")], ",");
  // a survey of three faces, and a wave whose groups answer it
  def frb-finding(id, title, where, fix, owners) = "{\"id\":\"" ++ id ++ "\",\"title\":\"" ++ title ++ "\",\"where\":[\"" ++ where ++ "\"],\"truth\":\"" ++ title ++ " truth\",\"evidence\":\"e\",\"fix\":\"" ++ fix ++ "\",\"owner_files\":[" ++ owners ++ "]}";
  def frb-face(face, findings, missed) = "{\"face\":\"" ++ face ++ "\",\"found\":{\"findings\":[" ++ findings ++ "]},\"verified\":{\"verified\":[],\"missed\":[" ++ missed ++ "]}}";
  def frb-faces() = "{\"result\":[" ++ str-join-with([frb-face("k", str-join-with([frb-finding("K1", "k1", "runtime/fkwu-uni.c:1", "fix k1", ""), frb-finding("K2", "k2", "runtime/fkwu-uni.c:2", "fix k2", ""), frb-finding("K3", "k3", "runtime/fkwu-uni.c:3", "fix k3", "")], ","), frb-finding("M1", "km1", "runtime/fkwu-uni.c:4", "fix km1", "")), frb-face("d", str-join-with([frb-finding("F1", "d1", "AGENTS.md:1", "fix d1", ""), frb-finding("F7", "d7", "AGENTS.md:7", "fix d7", "\"form/form-stdlib/core.fk\""), frb-finding("F9", "d9", "AGENTS.md:9", "fix d9", "")], ","), frb-finding("M1", "dm1", "AGENTS.md:2", "fix dm1", "")), frb-face("l", str-join-with([frb-finding("F7-rate-slug", "l7", "form/form-stdlib/json.fk:7", "fix l7", ""), frb-finding("F9-meter-slug", "l9", "form/form-stdlib/json.fk:9", "fix l9", "")], ","), "")], ",") ++ "]}";
  def frb-done(id, what) = "{\"id\":\"" ++ id ++ "\",\"what\":\"" ++ what ++ "\"}";
  def frb-group(group, commit, done, deferred) = "{\"group\":\"" ++ group ++ "\",\"impl\":{\"commits\":[\"" ++ commit ++ " c\"],\"done\":[" ++ done ++ "],\"deferred\":[" ++ deferred ++ "]}}";
  def frb-answering() = "{\"result\":[" ++ str-join-with([frb-group("laws", "4444444", str-join-with([frb-done("K1", "K1 done."), frb-done("K3", "K3 done."), frb-done("M1", "M1 done."), frb-done("d-F1", "D F1 done.")], ","), "{\"id\":\"K2-rest\",\"why\":\"Later.\",\"needs\":\"Finish K2 in runtime/fkwu-uni.c:3.\"}"), frb-group("meters", "5555555", frb-done("F7", "Moved the rate into json.fk."), ""), frb-group("walk", "6666666", frb-done("F9", "Waits on its window."), "")], ",") ++ "]}";
  def frb-doc(text) = parse-json("fixture", text);
  def frb-rows(text, label) = frq-requests(frb-doc(text), label, frb-tip)[0];
  def frb-issues() {
   let rows = frb-rows(frb-workflow(), "wf");
   let a = frb-at(rows, 0);
   let b = frb-at(rows, 1);
   let c = frb-at(rows, 2);
   (len(rows) == 3) && frb-is(a, "problem", "The flip got lost. More words.") && frb-is(a, "title", "The flip got lost.") && frb-is(a, "needs", "Change line 17651 to return fk_nothing.") && frb-is(a, "severity", "blocking")
   && frb-list-is(a, "where", ["runtime/fkwu-uni.c:17645-17651", "json.fk:12"]) && frb-list-is(a, "files", ["runtime/fkwu-uni.c", "form/form-stdlib/json.fk"]) && frb-is(a, "origin", "wf/kernels/issues")
   && frb-null?(a, "ref") && frb-null?(a, "verdict") && frb-null?(a, "seen") && frb-is(a, "status", "pending") && frb-is(a, "evidence", "probe p11") && nil?(frb-answers(a))
   && frb-list-is(b, "where", []) && frb-list-is(b, "files", ["gate/drift-gates.bml"]) && frb-is(b, "origin", "wf/kernels/issues") && frb-is(b, "status", "pending")
   && frb-is(c, "origin", "wf/docs/issues") && frb-list-is(c, "where", ["AGENTS.md:322"]) && frb-list-is(c, "files", ["AGENTS.md"]) && frb-is(c, "severity", "should-fix");
  }
  def frb-joins() {
   let made = frq-requests(frb-doc(frb-survey()), "sv", frb-tip);
   let rows = made[0];
   let a = frb-at(rows, 0);
   let b = frb-at(rows, 1);
   let d = frb-at(rows, 2);
   let m = frb-at(rows, 3);
   let z = frb-at(rows, 4);
   (len(rows) == 5) && ((Value) [made[1], made[2], made[3], made[4]] == [5, 1, 4, 3])
   && frb-is(a, "ref", "A") && frb-is(a, "needs", "refined a") && frb-is(a, "verdict", "confirmed") && frb-is(a, "problem", "a breaks\nThe claim it breaks: a holds") && frb-is(a, "evidence", "ea\nVerified confirmed: va")
   && frb-list-is(a, "files", ["form/form-stdlib/json.fk", "form/form-stdlib/core.fk"]) && frb-is(a, "origin", "sv/k/found.findings") && frb-is(a, "title", "A breaks") && frb-is(a, "status", "pending")
   && frb-is(b, "ref", "B") && frb-is(b, "needs", "refined b") && frb-is(b, "verdict", "partial") && frb-is(b, "status", "context")
   && frb-is(d, "ref", "D") && frb-is(d, "needs", "fix d") && frb-null?(d, "verdict") && frb-is(d, "evidence", "ed")
   && frb-is(m, "ref", "M1") && frb-is(m, "origin", "sv/k/verified.missed") && frb-is(m, "needs", "fix m in x/m.fk:9") && frb-list-is(m, "where", ["x/m.fk:9"]) && frb-is(m, "problem", "M one")
   && frb-is(z, "ref", "Z") && frb-is(z, "needs", "refined z") && frb-is(z, "verdict", "confirmed") && frb-is(z, "origin", "sv/k/verified.verified");
  }
  def frb-handed() {
   let rows = frb-rows(frb-wave(), "wv");
   let d = frb-at(rows, 0);
   let o = frb-at(rows, 1);
   let i = frb-at(rows, 3);
   (len(rows) == 4) && frb-is(d, "origin", "wv/g/impl.deferred") && frb-is(d, "problem", "Go files belong to another group. More.") && frb-is(d, "title", "Go files belong to another group.")
   && frb-is(d, "needs", "Go main.go:2670-2705: answer -1.") && frb-is(d, "ref", "K4-siblings") && frb-list-is(d, "where", ["main.go:2670-2705"]) && frb-list-is(d, "files", ["form/form-kernel-go/main.go"]) && frb-is(d, "status", "pending")
   && frb-is(o, "origin", "wv/g/impl.open_issues") && frb-is(o, "problem", "Law 9 stands partly. The rest waits.") && frb-is(o, "title", "Law 9 stands partly.")
   && frb-null?(o, "needs") && frb-null?(o, "severity") && frb-null?(o, "evidence") && frb-null?(o, "ref") && frb-is(o, "status", "statement")
   && frb-is(frb-at(rows, 2), "problem", "Cons keeps the pair.") && frb-is(i, "origin", "wv/g/review.issues") && frb-is(i, "needs", "Register it.") && frb-is(i, "status", "context");
  }
  def frb-where() {
   let text = "runtime/fkwu-uni.c:17645-17651 (tag 132); commit c6d7478ce; form-fs.fk:262 and :274; at 15:31:20; https://x.y:80/z.md:3 and ./form/a.bml:3, then main.go:2454-2461, end: v1.2.3:4.";
   ((Value) frq-refs(text) == ["runtime/fkwu-uni.c:17645-17651", "form-fs.fk:262", "form/a.bml:3", "main.go:2454-2461"]) && ((Value) frq-refs("no span here: 12 and a.b: 3") == []);
  }
  def frb-hex?(s, i) = if (i >= len(s)) then true else if (((str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57)) || ((str_byte_at(s, i) >= 97) && (str_byte_at(s, i) <= 102))) then frb-hex?(s, (i + 1)) else false;
  def frb-id-shape?(id) = ((Comparable) len(id) == 20) && ((String) substring(id, 0, 4) == "frq-") && frb-hex?(substring(id, 4, 20), 0);
  def frb-ids() {
   let one = frq-ids(frb-rows(frb-survey(), "sv"));
   let two = frq-ids(frb-rows(frb-survey(), "sv"));
   let other = frq-ids(frb-rows(frb-survey(), "sv2"));
   let changed = frq-id("sv/k/found.findings", ["x/a.fk:1-2"], "a breaks\nThe claim it breaks: a hold");
   let all = append(frb-rows(frb-workflow(), "wf"), append(frb-rows(frb-survey(), "sv"), append(frb-rows(frb-wave(), "wv"), frb-rows(frb-repair(), "rp"))));
   (len(one) == 5) && ((Value) one == two) && (!((String) frb-id-at(one, 0) == frb-id-at(other, 0))) && (!((String) frb-id-at(one, 0) == changed)) && all?(frb-id-shape?, one) && all?(frq-whole?, all);
  }
  // a private place for the ledgers, the witnesses and the door's documents
  def frb-dir() = temp_dir() ++ "/frq-band-" ++ host_pid().str();
  def frb-ledger() = frb-dir() ++ "/requests.jsonl";
  def frb-lines(path) = len(filter(l => frq-some?(trim(l)), split-on(read_file(path) ?? "", "\n")));
  def frb-ledger-feeds() {
   let made = fs_mkdir(frb-dir());
   let gone = host_path_remove(frb-ledger());
   let first = frq-feed(frb-ledger(), frb-doc(frb-survey()), "sv", frb-tip);
   let again = frq-feed(frb-ledger(), frb-doc(frb-survey()), "sv", frb-tip);
   let shared = frq-feed(frb-ledger(), frb-doc(frb-survey-of(frb-more())), "sv", frb-tip);
   let wider = frq-feed(frb-ledger(), frb-doc(frb-wave()), "wv", frb-tip);
   let repaired = frq-feed(frb-ledger(), frb-doc(frb-repair()), "rp", frb-tip);
   let answered = frq-answer-ledger(frb-ledger(), frq-answers(frb-doc(frb-repair()), "rp"));
   let twice = frq-answer-ledger(frb-ledger(), frq-answers(frb-doc(frb-repair()), "rp"));
   let back = frq-rows(frb-ledger());
   ((Value) [first[0], first[1], first[6]] == [5, 5, 5]) && ((Value) [again[0], again[1], again[6]] == [5, 0, 0]) && ((Value) [shared[0], shared[1], shared[6]] == [6, 1, 1]) && ((Comparable) wider[1] == 4) && ((Comparable) repaired[1] == 9)
