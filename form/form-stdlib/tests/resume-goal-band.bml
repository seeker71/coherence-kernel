; resume-goal-band.bml — a checkpoint names the goal it was opened under, and only a standing checkpoint names one (form-cli-code-memory.bml, fcam-checkpoint-goal).
;
; The contract a checkpoint is held under includes the goal, and a fresh way carries its finding in the goal, so a resume that
; asks with the bare goal is refused as checkpoint-absent-corrupt-or-contract-changed. The turn reads the goal from the packet.
;
; Expected: 255
; Verdict 255 when every claim lands:
;   1   a written checkpoint answers the exact goal of its contract, finding included
;   2   a checkpoint the store does not hold answers nothing()
;   4   an id with bytes no checkpoint id holds answers nothing()
;   8   a contract that is not the five-part contract answers nothing()
;   16  the resume asked with the read goal meets the packet's scope; asked with the bare goal it does not
;   32  the read goal never carries a moved contract: another writable or other checks under it are refused
;   64  the door offers a resume only while the checkpoint stands and its goal carries the gap's goal
;   128 a resume the door would not offer does not keep a gap from parking (nt-way-verdict, the pick's reading of a way)
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/form-cli-code-memory.bml observe/native-turn-run.bml
section [form.bml] {
 class ResumeGoalBand {
  def rgb-root() = temp_dir() ++ "/resume-goal-band-" ++ host_pid().str();
  def rgb-bare() = "the gap's goal";
  def rgb-goal() = rgb-bare() ++ "\nInitial execution evidence:\n\n\nThe native work already observed:\na finding";
  def rgb-scope(goal) = fcam-scope(goal, [], ["a.txt"], "[]");
  def rgb-state() = append(map(i => i, 0 .. 13), [[rgb-root(), "ab12-3", rgb-scope(rgb-goal()), 0]]);
  def rgb-write() {
   let made = fs_mkdir(rgb-root());
   fcam-write(fcam-path(rgb-root(), "ab12-3", "checkpoint"), fcam-packet(rgb-state(), "checkpoint"));
  }
  def rgb-c-goal(ctx) = rgb-write() && (String) fcam-checkpoint-goal(rgb-root(), "ab12-3") == rgb-goal();
  def rgb-c-gone(ctx) = nothing?(fcam-checkpoint-goal(rgb-root(), "cd34-5"));
  def rgb-c-id(ctx) = nothing?(fcam-checkpoint-goal(rgb-root(), "../ab12-3"));
  def rgb-c-shape(ctx) = nothing?(fcam-contract-goal("[\"a\",\"b\"]")) && nothing?(fcam-contract-goal("not json"));
  def rgb-c-moved(ctx) {
   let packet = fcam-read(fcam-path(rgb-root(), "ab12-3", "checkpoint"));
   let read = fcam-checkpoint-goal(rgb-root(), "ab12-3");
   fcam-packet-valid(packet, "checkpoint", fcam-scope(read, [], ["b.txt"], "[]")) == 0 && fcam-packet-valid(packet, "checkpoint", fcam-scope(read, [], ["a.txt"], "[1]")) == 0;
  }
  def rgb-gap(goal) = json-node-object([fhn-s("id", "rgb"), fhn-s("goal", goal), fhn-s("learning_root", rgb-root())]);
  def rgb-c-offer(ctx) = (String) nt-standing-checkpoint(rgb-gap(rgb-bare()), "ab12-3") == "ab12-3" && (String) nt-standing-checkpoint(rgb-gap("a goal that changed"), "ab12-3") == "" && (String) nt-standing-checkpoint(rgb-gap(rgb-bare()), "cd34-5") == "";
  def rgb-way() = ntl-approach("resume", "m", "direct", "catalog", "greedy", 1, "band");
  def rgb-hist(id) = [json-node-object([json-node-pair("approach", json-node-object([fhn-s("model", "m")])), fhn-s("checkpoint_id", id), fhn-s("outcome_digest", "o")])];
  def rgb-admits(goal, id) = (Comparable) nt-way-verdict(rgb-way(), rgb-gap(goal), [], rgb-hist(id))[0] == 1;
  def rgb-c-park(ctx) = rgb-admits(rgb-bare(), "ab12-3") && !rgb-admits(rgb-bare(), "cd34-5") && !rgb-admits("a goal that changed", "ab12-3");
  def rgb-c-scope(ctx) {
   let packet = fcam-read(fcam-path(rgb-root(), "ab12-3", "checkpoint"));
   let read = fcam-checkpoint-goal(rgb-root(), "ab12-3");
   fcam-packet-valid(packet, "checkpoint", rgb-scope(read)) == 1 && fcam-packet-valid(packet, "checkpoint", rgb-scope(rgb-bare())) == 0;
  }
 }
 let verdict = live-claims("resume-goal-band", 0, [["goal", 1, 1, rgb-c-goal], ["gone", 2, 1, rgb-c-gone], ["id", 4, 1, rgb-c-id], ["shape", 8, 1, rgb-c-shape], ["scope", 16, 1, rgb-c-scope], ["moved", 32, 1, rgb-c-moved], ["offer", 64, 1, rgb-c-offer], ["park", 128, 1, rgb-c-park]]);
 let gone = host_dir_rmdir(rgb-root());
 verdict;
}
