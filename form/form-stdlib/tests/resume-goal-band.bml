; resume-goal-band.bml — a checkpoint names the goal it was opened under, and only a standing checkpoint names one (form-cli-code-memory.bml, fcam-checkpoint-goal).
;
; The contract a checkpoint is held under includes the goal, and a fresh way carries its finding in the goal, so a resume that
; asks with the bare goal is refused as checkpoint-absent-corrupt-or-contract-changed. The turn reads the goal from the packet.
;
; Expected: 31
; Verdict 31 when every claim lands:
;   1   a written checkpoint answers the exact goal of its contract, finding included
;   2   a checkpoint the store does not hold answers nothing()
;   4   an id with bytes no checkpoint id holds answers nothing()
;   8   a contract that is not the five-part contract answers nothing()
;   16  the resume asked with the read goal meets the packet's scope; asked with the bare goal it does not
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/form-cli-code-memory.bml
section [form.bml] {
 class ResumeGoalBand {
  def rgb-root() = temp_dir() ++ "/resume-goal-band-" ++ host_pid().str();
  def rgb-bare() = "the gap's goal";
  def rgb-goal() = rgb-bare() ++ "\nThe native work already observed:\na finding";
  def rgb-scope(goal) = fcam-scope(goal, [], ["a.txt"], "[]");
  def rgb-state() = append(map(i => i, 0 .. 13), [[rgb-root(), "ab12-3", rgb-scope(rgb-goal()), 0]]);
  def rgb-write() {
   let made = fs_mkdir(rgb-root());
   fcam-write(fcam-path(rgb-root(), "ab12-3", "checkpoint"), fcam-packet(rgb-state(), "checkpoint"));
  }
  def rgb-c-goal(ctx) = rgb-write() && (String) fcam-checkpoint-goal(rgb-root(), "ab12-3") == rgb-goal();
  def rgb-c-gone(ctx) = nothing?(fcam-checkpoint-goal(rgb-root(), "cd34-5"));
  def rgb-c-id(ctx) = nothing?(fcam-checkpoint-goal(rgb-root(), "../ab12-3"));
  def rgb-c-shape(ctx) = nothing?(fcam-contract-goal("[\"a\",\"b\"]")) && nothing?(fcam-contract-goal("not json"));
  def rgb-c-scope(ctx) {
   let packet = fcam-read(fcam-path(rgb-root(), "ab12-3", "checkpoint"));
   let read = fcam-checkpoint-goal(rgb-root(), "ab12-3");
   fcam-packet-valid(packet, "checkpoint", rgb-scope(read)) == 1 && fcam-packet-valid(packet, "checkpoint", rgb-scope(rgb-bare())) == 0;
  }
 }
 let verdict = live-claims("resume-goal-band", 0, [["goal", 1, 1, rgb-c-goal], ["gone", 2, 1, rgb-c-gone], ["id", 4, 1, rgb-c-id], ["shape", 8, 1, rgb-c-shape], ["scope", 16, 1, rgb-c-scope]]);
 let gone = host_dir_rmdir(rgb-root());
 verdict;
}
