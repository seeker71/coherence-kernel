; living-world-recipe-tree-revision-prospective-witness.fk -- fresh K/L
; identity-aligned placement of incumbent, first successor, and the
; contradiction-composed successor.  Diagnostic only; no authority moves.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/living-world-recipe-tree-revision-trial.fk form-stdlib/living-world-recipe-tree-revision-hypothesis.fk form-stdlib/living-world-recipe-tree-revision-prospective.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk

(let LWRTRPW-SOURCE-K    (bp "LWRTRPW-SOURCE-K"))
(let LWRTRPW-SOURCE-L    (bp "LWRTRPW-SOURCE-L"))
(let LWRTRPW-EVIDENCE    (bp "LWRTRPW-EVIDENCE"))
(let LWRTRPW-ALTERNATIVE (bp "LWRTRPW-ALTERNATIVE"))
(let LWRTRPW-CASE-KEY    (bp "LWRTRPW-CASE-KEY"))
(let LWRTRPW-SCOPE       (bp "LWRTRPW-SCOPE"))
(let LWRTRPW-ROLE        (bp "LWRTRPW-ROLE"))
(let LWRTRPW-LENS        (bp "LWRTRPW-LENS"))
(let LWRTRPW-REASON      (bp "LWRTRPW-REASON"))
(let LWRTRPW-RESULT      (bp "LWRTRPW-RESULT"))

(defn lwrtrpw-cell (kind) (intern_node kind (empty)))
(defn lwrtrpw-source-k () (lwrtrpw-cell LWRTRPW-SOURCE-K))
(defn lwrtrpw-source-l () (lwrtrpw-cell LWRTRPW-SOURCE-L))
(defn lwrtrpw-evidence () (lwrtrpw-cell LWRTRPW-EVIDENCE))
(defn lwrtrpw-alternative () (lwrtrpw-cell LWRTRPW-ALTERNATIVE))
(defn lwrtrpw-reason () (lwrtrpw-cell LWRTRPW-REASON))
(defn lwrtrpw-alternatives ()
    (lwo-field (list (lwrtrpw-alternative))))
(defn lwrtrpw-unknown () (lwlc-unknown (lwrtrpw-evidence)))
(defn lwrtrpw-entry (source payload)
    (lwphw-entry source (lwrtrpw-evidence) payload))

(defn lwrtrpw-case-key (index)
    (intern_node LWRTRPW-CASE-KEY (list (intern_trivial_int index))))
(defn lwrtrpw-role (index name)
    (intern_node LWRTRPW-ROLE
        (list (lwrtrpw-case-key index) (intern_trivial_string name))))
(defn lwrtrpw-scope (index)
    (intern_node LWRTRPW-SCOPE (list (lwrtrpw-case-key index))))
(defn lwrtrpw-projection (index name value)
    (lwre-projection (lwrtrpw-scope index) (lwrtrpw-role index name)
        (intern_trivial_int value) (lwrtrpw-alternatives)
        (lwrtrpw-unknown) (lwrtrpw-evidence)))
(defn lwrtrpw-binding (index name value)
    (lwre-projected-binding name (lwrtrpw-projection index name value)
        (lwrtrpw-evidence)))
(defn lwrtrpw-bindings (index left right)
    (lwre-bindings
        (list (lwrtrpw-binding index "left" left)
              (lwrtrpw-binding index "right" right))))
(defn lwrtrpw-lens (index)
    (lwlc-lens (lwlc-cell-shape)
        (intern_node LWRTRPW-LENS (list (lwrtrpw-case-key index)))
        (lwrtrpw-evidence)))

(defn lwrtrpw-case-one (index left right expected lens)
    (lwps-case (lwrtrpw-bindings index left right)
        (oac-one (intern_trivial_int expected))
        (lwo-none) (lwo-none) (lwrtrpw-alternatives)
        (lwrtrpw-unknown) lens (lwrtrpw-evidence)))
(defn lwrtrpw-case-pending ()
    (lwps-case (lwrtrpw-bindings 3 6 13) (oac-nothing)
        (oac-timeout (intern_trivial_int 10) (oac-no-default)
            (lwrtrpw-evidence))
        (intern_trivial_int 4) (lwrtrpw-alternatives)
        (lwrtrpw-unknown) (lwo-none) (lwrtrpw-evidence)))
(defn lwrtrpw-case-condensed ()
    (do
        (let alternative
            (oac-alternative-ack (lwrtrpw-case-key 4)
                (lwrtrpw-alternative) (lwrtrpw-evidence)))
        (lwps-case (lwrtrpw-bindings 4 8 3) (oac-nothing)
            (oac-timeout (intern_trivial_int 10) alternative
                (lwrtrpw-evidence))
            (intern_trivial_int 10) (lwrtrpw-alternatives)
            (lwrtrpw-unknown) (lwrtrpw-lens 4) (lwrtrpw-evidence))))

; These resolved observations are offered data, never production vocabulary.
; The third coordinate tests whether the exact 12,5 exception generalized.
(defn lwrtrpw-cases ()
    (lwo-field
        (list
            (lwrtrpw-case-one 0 19 4 23 (lwo-none))
            (lwrtrpw-case-one 1 11 7 18 (lwrtrpw-lens 1))
            (lwrtrpw-case-one 2 14 5 9 (lwo-none))
            (lwrtrpw-case-pending)
            (lwrtrpw-case-condensed))))
(defn lwrtrpw-dataset ()
    (lwps-dataset (lwrtrpw-cases) (lwrtrpw-evidence)))
(defn lwrtrpw-split (candidate)
    (lwps-split (lwrtrp-history-bindings candidate) (lwo-empty-field)
        (lwps-dataset-bindings (lwrtrpw-dataset)) (lwrtrpw-evidence)))
(defn lwrtrpw-contract ()
    (lwps-contract (lwps-exact-identity) (lwo-none)
        (lwrtrpw-alternatives) (lwrtrpw-unknown) (lwrtrpw-evidence)))
(defn lwrtrpw-suite (candidate)
    (lwps-suite (lwrtrpw-dataset) (lwrtrpw-split candidate)
        (lwrtrpw-contract) (lwrtrpw-evidence)))

(defn lwrtrpw-binding-entries (source items entries)
    (if (eq (len items) 0) entries
        (do
            (let binding (head items))
            (let projection (lwre-binding-projection binding))
            (lwrtrpw-binding-entries source (tail items)
                (cons (lwrtrpw-entry source binding)
                    (cons (lwrtrpw-entry source (lwre-binding-source binding))
                        (cons (lwrtrpw-entry source projection)
                            (cons (lwrtrpw-entry source
                                    (lwre-projection-scope projection))
                                entries))))))))
(defn lwrtrpw-case-entries (source items entries)
    (if (eq (len items) 0) entries
        (do
            (let case (head items))
            (lwrtrpw-case-entries source (tail items)
                (lwrtrpw-binding-entries source
                    (lwre-binding-items (lwps-case-bindings case))
                    (cons (lwrtrpw-entry source (lwps-case-bindings case))
                        (cons (lwrtrpw-entry source case) entries)))))))
(defn lwrtrpw-suite-entries (source candidate)
    (lwrtrpw-case-entries source (lwo-field-items (lwrtrpw-cases))
        (list
            (lwrtrpw-entry source (lwrtrpw-evidence))
            (lwrtrpw-entry source (lwrtrpw-alternative))
            (lwrtrpw-entry source (lwrtrpw-unknown))
            (lwrtrpw-entry source (lwrtrpw-dataset))
            (lwrtrpw-entry source (lwrtrpw-split candidate))
            (lwrtrpw-entry source (lwrtrpw-contract))
            (lwrtrpw-entry source (lwrtrpw-suite candidate)))))
(defn lwrtrpw-one-source-world (world candidate)
    (lwt-receive-stream world
        (lwrtrpw-suite-entries (lwrtrpw-source-k) candidate)))
(defn lwrtrpw-two-source-world (world candidate)
    (lwt-receive-stream (lwrtrpw-one-source-world world candidate)
        (lwrtrpw-suite-entries (lwrtrpw-source-l) candidate)))
(defn lwrtrpw-revoke-first-case (world)
    (do
        (let case (head (lwo-field-items (lwrtrpw-cases))))
        (lwt-receive-stream world
            (list
                (lwrtrpw-entry (lwrtrpw-source-k)
                    (lwo-revocation case (lwrtrpw-source-k)
                        (lwrtrpw-reason) (lwrtrpw-evidence)))))))

(defn lwrtrpw-metrics-progress (metrics)
    (lcfb-cat (list
        "exact:" (int_to_str (lwps-metrics-value metrics 2))
        ":plural:" (int_to_str (lwps-metrics-value metrics 3))
        ":contradicted:" (int_to_str (lwps-metrics-value metrics 4)))))

; children: upstream, candidate/target/first/suite, recurrence views, shared
; evaluations/comparisons, revocation view, cached membrane bits, events.
(defn lwrtrpw-result
    (upstream candidate target first suite one-world one-comparison two-world
     suite-sources ready incumbent first-evaluation new-evaluation
     incumbent-first first-new incumbent-new revoked-world revoked-comparison
     revoked-successor-current identity-clean source-clean events)
    (intern_node LWRTRPW-RESULT
        (list upstream candidate target first suite one-world one-comparison
              two-world suite-sources ready incumbent first-evaluation
              new-evaluation incumbent-first first-new incumbent-new
              revoked-world revoked-comparison revoked-successor-current
              identity-clean source-clean events)))

(defn lwrtrpw-run ()
    (do
        (let upstream (lwrtrhw-run))
        (let candidate (nth (node_children upstream) 19))
        (let target (lwrtrp-target-for candidate))
        (let first (lwrtrp-parent-successor candidate))
        (let world (lwt-round-world (nth (node_children upstream) 18)))
        (let suite (lwrtrpw-suite candidate))
        (let started
            (lcfb-open-stream "living-world-recipe-tree-revision-prospective"
                "form-native" "lwrtrpw-run"
                "fresh-K/L-three-way-prospective-placement"
                "form/form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk"
                190 10))

        (let one-world (lwrtrpw-one-source-world world candidate))
        (let one-comparison
            (lwrtrp-compare-first-new one-world candidate suite 2))
        (let one-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-prospective"
                "first-suite-offer" "leave" "form-native"
                "lwps-suite-current?/lwrtrp-compare-first-new"
                "sources:1:comparison:nothing" 1 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk"
                204 10))

        (let two-world (lwrtrpw-two-source-world world candidate))
        (let suite-sources (lwrtep-suite-sources two-world suite))
        (let identity-clean (lwrtrp-identity-clean? candidate suite))
        (let source-clean (lwrtrp-source-clean? two-world candidate suite 2))
        (let membrane-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-prospective"
                "prospective-membrane" "leave" "form-native"
                "lwrtrp-identity-clean?/lwrtrp-source-clean?"
                (lcfb-cat (list
                    "history-bindings:"
                    (int_to_str (lwo-field-size
                        (lwrtrp-history-bindings candidate)))
                    ":prospective-bindings:"
                    (int_to_str (lwo-field-size
                        (lwps-split-prospective (lwps-suite-split suite))))
                    ":sources:" (int_to_str (lwo-field-size suite-sources))
                    ":identity-clean:" (int_to_str identity-clean)
                    ":source-clean:" (int_to_str source-clean)))
                2 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk"
                220 10))

        (let ready-enter
            (lcfb-call-stream "living-world-recipe-tree-revision-prospective"
                "currentness" "enter" "form-native" "lwrtrp-ready?"
                "suite-then-successor-graph" 3 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk"
                240 10))
        (let ready (lwrtrp-ready? two-world candidate suite 2))
        (let ready-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-prospective"
                "currentness" "leave" "form-native" "lwrtrp-ready?"
                (lcfb-cat (list "ready:" (int_to_str ready))) 4 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk"
                247 10))

        (let incumbent (lwrtrp-evaluate-incumbent-ready candidate suite))
        (let first-evaluation (lwrtrp-evaluate-first-ready candidate suite))
        (let new-evaluation (lwrtrp-evaluate-new-ready candidate suite))
        (let incumbent-first (lwps-compare incumbent first-evaluation))
        (let first-new (lwps-compare first-evaluation new-evaluation))
        (let incumbent-new (lwps-compare incumbent new-evaluation))
        (let placement-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-prospective"
                "three-way-placement" "leave" "form-native"
                "same-dataset/split/contract"
                (lcfb-cat (list
                    "incumbent:"
                    (lwrtrpw-metrics-progress
                        (lwps-evaluation-metrics incumbent))
                    ":first:"
                    (lwrtrpw-metrics-progress
                        (lwps-evaluation-metrics first-evaluation))
                    ":new:"
                    (lwrtrpw-metrics-progress
                        (lwps-evaluation-metrics new-evaluation))))
                5 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk"
                259 10))
        (let comparison-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-prospective"
                "first-to-new" "leave" "form-native" "lwps-compare"
                (lwrtrp-progress-target first-new) 6 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk"
                278 10))

        (let revoked-world (lwrtrpw-revoke-first-case two-world))
        (let revoked-comparison
            (lwrtrp-compare-first-new revoked-world candidate suite 2))
        (let revoke-enter
            (lcfb-call-stream "living-world-recipe-tree-revision-prospective"
                "revocation" "enter" "form-native"
                "lwrtrh-integrated-current?"
                "prospective-stale-successor-still-current" 7 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk"
                287 10))
        (let revoked-successor-current
            (lwrtrh-integrated-current? revoked-world candidate))
        (let revoked-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-prospective"
                "revocation" "leave" "form-native"
                "lwo-revocation/lwrtrp-compare-first-new"
                (lcfb-cat (list
                    "suite-current:"
                    (int_to_str (lwps-suite-current? revoked-world suite 2))
                    ":comparison-nothing:"
                    (int_to_str (node_eq revoked-comparison (lwo-none)))
                    ":successor-current:"
                    (int_to_str revoked-successor-current)))
                8 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk"
                296 10))
        (lwrtrpw-result upstream candidate target first suite one-world
            one-comparison two-world suite-sources (intern_trivial_int ready)
            incumbent first-evaluation new-evaluation incumbent-first first-new
            incumbent-new revoked-world revoked-comparison
            (intern_trivial_int revoked-successor-current)
            (intern_trivial_int identity-clean)
            (intern_trivial_int source-clean) (framebuffer-events))))

; Privacy-safe aggregate projection for a live diagnostic run.  It carries no
; binding values, expected outputs, per-case answers, or offered text.
(defn lwrtrpw-observe ()
    (do
        (let result (lwrtrpw-run))
        (let children (node_children result))
        (let candidate (nth children 1))
        (let suite (nth children 4))
        (let incumbent (nth children 10))
        (let first-evaluation (nth children 11))
        (let new-evaluation (nth children 12))
        (let first-new (nth children 14))
        (let revoked-world (nth children 16))
        (let incumbent-metrics (lwps-evaluation-metrics incumbent))
        (let first-metrics (lwps-evaluation-metrics first-evaluation))
        (let new-metrics (lwps-evaluation-metrics new-evaluation))
        (let delta (lwps-delta-values (lwps-comparison-delta first-new)))
        (list
            (lwo-field-size (nth children 8))
            (lwo-field-size (lwrtrp-history-bindings candidate))
            (lwo-field-size
                (lwps-split-prospective (lwps-suite-split suite)))
            (node_value (nth children 9))
            (lwps-metrics-value incumbent-metrics 0)
            (lwps-metrics-value incumbent-metrics 1)
            (lwps-metrics-value incumbent-metrics 2)
            (lwps-metrics-value incumbent-metrics 3)
            (lwps-metrics-value incumbent-metrics 4)
            (lwps-metrics-value first-metrics 0)
            (lwps-metrics-value first-metrics 1)
            (lwps-metrics-value first-metrics 2)
            (lwps-metrics-value first-metrics 3)
            (lwps-metrics-value first-metrics 4)
            (lwps-metrics-value new-metrics 0)
            (lwps-metrics-value new-metrics 1)
            (lwps-metrics-value new-metrics 2)
            (lwps-metrics-value new-metrics 3)
            (lwps-metrics-value new-metrics 4)
            (lwps-comparison-admissible first-new)
            (lwps-comparison-repeated first-new)
            (nth delta 2) (nth delta 3) (nth delta 4)
            (lwps-suite-current? revoked-world suite 2)
            (node_eq (nth children 17) (lwo-none))
            (node_value (nth children 18))
            (node_value (nth children 19))
            (node_value (nth children 20))
            (len (nth children 21)))))

; witnessed: 2026-08-09 -> aggregate placement and revocation observed on fkwu
0
