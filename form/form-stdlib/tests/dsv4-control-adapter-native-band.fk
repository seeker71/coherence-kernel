; dsv4-control-adapter-native-band.fk — fit/evaluate/leakage witness.
; The verdict is 15 only when evaluation covers 150 rows, every class has 30,
; and the adapter refuses sufficiency under dominant template overlap.
; preludes: form-stdlib/dsv4-control-adapter.fk

(do
    (defn dcab-row-sum (m i)
        (add (nth m (mul i 5))
        (add (nth m (add (mul i 5) 1))
        (add (nth m (add (mul i 5) 2))
        (add (nth m (add (mul i 5) 3))
             (nth m (add (mul i 5) 4)))))))
    (let report (dca-report))
    (let m (nth report 0))
    (let a (if (eq (sum m) 150) 1 0))
    (let b (if (if (eq (dcab-row-sum m 0) 30)
                    (if (eq (dcab-row-sum m 1) 30)
                    (if (eq (dcab-row-sum m 2) 30)
                    (if (eq (dcab-row-sum m 3) 30)
                        (eq (dcab-row-sum m 4) 30) 0) 0) 0) 0) 2 0))
    (let c (if (gt (nth report 2) 75) 4 0))
    (let d (if (eq (nth report 3) "insufficient-template-leakage") 8 0))
    (add a (add b (add c d))))
