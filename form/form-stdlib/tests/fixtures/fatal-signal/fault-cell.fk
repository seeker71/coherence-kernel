; fault-cell.fk — raises the fault FK_TEST_FAULT names, three Form functions down: the process ends by that signal, and the
; fatal-signal organ writes its row first (fatal-signal-band). With FK_TEST_FAULT unset the door names no unit and the cell ends on nothing.
(do
    (defn fault-c (n) (cell_run "fk-test-fault" 0 (nothing) (nothing)))
    (defn fault-b (n) (add 1 (fault-c (add n 1))))
    (defn fault-a (n) (add 1 (fault-b (add n 1))))
    (print_str "about to fault")
    (fault-a 0))
