// attend-cell.bml — hands the fatal-signal rows of the file named on its stdin line to the immune system's attention
// (fatal-signal-attend.bml): its stdout is the findings, its stderr the spoken rows and the attention beside them (fatal-signal-band).
// preludes: form/form-stdlib/bml/fatal-signal-attend.bml
import form/form-stdlib/bml/fatal-signal-attend.bml;
section [form.bml] {
 fsga-attend(read_line(), now_unix_ms());
}
