; cyc-probe.fk — loads the cycle of two .bml units that name each other through cell_run and says how the load ended. Run with
; FK_TEST_FAULT=load-base (the freshness check of units a collection just registered is off) the collector's depth law is what ends it:
; stopped "stack-depth" naming fk_src_collect_dep and the units it was entering, in seconds, the process standing (fatal-signal-band).
(do
    (let r (cell_run "form/form-stdlib/tests/fixtures/cell-run/cyc-a.bml" 0 120000 (nothing)))
    (let s (record_get r "stopped"))
    (print_str (if (nothing? s) "answered" (record_get s "kind")))
    (print_str (if (nothing? s) "" (record_get s "message")))
    (print_str (if (nothing? s) "" (value_str (record_get s "frames"))))
    0)
