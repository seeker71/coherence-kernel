; dive-cell.fk — never returns until the stack does: a non-tail recursion with no base case, three Form functions deep in a cycle
; (fatal-signal-band: the walker's depth wall is a stop with a name and a frame chain, never a crash)
(do
    (defn dive-a (n) (add 1 (dive-b (add n 1))))
    (defn dive-b (n) (add 1 (dive-a (add n 1))))
    (print_str "diving")
    (dive-a 0))
