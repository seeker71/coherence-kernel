//////////////////////////////////////////////////////////////////////
//
// Name: bml-branch-assign.bml
// Platform: Form native kernel
//
//////////////////////////////////////////////////////////////////////

/* Canonical sources: an assignment made inside a branch is carried out of it.
   A while body's local and parameter cross the back-edge; an if branch's
   parameter stands after the join; a choose's failing branch rolls back and
   the branch that succeeds carries its assignment out, a parameter's
   included; a try body's and a catch's assignments stand after the try.
   The stream answers 10 + 15 + 15 + 2 + 2 + 7 = 51.
   Answer: 51. */

int Sum(int n) { int x = 0; while (n > 0) { x = x + n; n = n - 1; } return x; }
int Bump(int n) { if (n > 2) { n = n + 10; } return n; }
int Pick(int n) { choose { fail; } , { n = n + 10; } return n; }
int Carry() { int x = 1; choose { x = 9; fail; } , { x = x + 1; } return x; }
int Partial() { int x = 1; int y = 0; choose { y = 5; x = 9; fail; } , { x = x + y + 1; } return x; }
int Caught() { int x = 1; try { x = 5; throw 2; } catch (int e) { x = x + e; } return x; }
return Sum(4) + Bump(5) + Pick(5) + Carry() + Partial() + Caught();
