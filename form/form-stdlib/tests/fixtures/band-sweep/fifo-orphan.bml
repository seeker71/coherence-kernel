// fifo-orphan.bml — a fixture of band-sweep-band: a band that leaves a reader waiting in open() on a fifo of its scratch, then answers 1.
// The reader's pid is written to .hearth/band-sweep-fifo.pid for the band that runs this to read.
section [form.bml] {
 let fifo = temp_dir() ++ "/orphan.fifo";
 let made = host_wait(host_spawn_at(["/usr/bin/mkfifo", fifo], ["/dev/null", "/dev/null", "/dev/null"]));
 let reader = host_spawn_at(["/bin/cat", fifo], ["/dev/null", "/dev/null", "/dev/null"]);
 let noted = write_file(".hearth/band-sweep-fifo.pid", reader.str());
 1;
}
