// fifo-bare.bml — a fixture of band-sweep-band: a band that leaves a fifo in its scratch with no reader on it, then answers 1.
section [form.bml] {
 let fifo = temp_dir() ++ "/bare.fifo";
 let made = host_wait(host_spawn_at(["/usr/bin/mkfifo", fifo], ["/dev/null", "/dev/null", "/dev/null"]));
 1;
}
