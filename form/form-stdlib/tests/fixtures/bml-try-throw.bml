// try/throw/catch from source: a catch binds the thrown value to its
// parameter; a body that does not throw keeps its own value; the statements
// after a throw are skipped; a throw passes out of a loop and out of a called
// method; a catch that throws again reaches the outer catch; a throw inside a
// loop's try is caught there. The unit's own body catches too.
// Answer: 211
// (7, Param() = 42, Body() = 5, Skip() = 5, Caught() = 112, Clean() = -1,
// Rethrow() = 20, Loop() = 21)
int Check(int k) { for (int i = 0; i < 10; i++) { if (i == k) throw i * 3; } return -1; }
int Param() { try { throw 41; } catch (int e) { return e + 1; } }
int Body() { try { return 5; } catch { return 7; } }
int Skip() { try { throw 3; return 4; } catch { return 5; } }
int Caught() { try { return Check(4); } catch (int e) { return e + 100; } }
int Clean() { try { return Check(40); } catch (int e) { return e; } }
int Rethrow() { try { try { throw 1; } catch (int e) { throw e + 1; } } catch (int f) { return f * 10; } }
int Loop() { for (int i = 0; i < 5; i++) { try { if (i == 3) throw i; } catch (int e) { return e * 7; } } return 0; }
try { throw 1; } catch { return 7 + Param() + Body() + Skip() + Caught() + Clean() + Rethrow() + Loop(); }
