//
// Name: bml-loop-two-carried.bml
// Platform: Form native kernel
//
//////////////////////////////////////////////////////////////////////

/* Canonical source: a loop that carries two names out. s and i are both
   declared before the loop and both read after it, so the loop's defn
   answers them together. The sum of the numbers below 5000, plus the
   5000 that ended the loop.
   Answer: 12502500. */

int Tri(int n) { int s = 0; int i = 0; while (i < n) { s = s + i; i = i + 1; } return s + i; }
return Tri(5000);
