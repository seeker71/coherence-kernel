// Statement control from source: if/else with and without else, nested,
// braced and bare; the condition operators BML reads as its own op-* rules;
// loop with break and a labeled outer break; a parameter rebound in a branch.
// The unit's own body branches too.
// Answer: 140
// (A() = 10, B() = 20, C() = 6, D() = 1, E() = 7, F() = 70, G() = 4, H() = 9,
// Clamp(12) = 9, Clamp(4) = 4)
int A() { if (2 < 3) return 10; else return 20; }
int B() { if (3 < 2) { return 10; } else { return 20; } }
int C() { if (1 == 1) { if (2 != 2) return 5; } return 6; }
int D() { if (1 < 2 && !(3 < 2) || 0) return 1; return 0; }
int E() { if (0 || 2 < 1) return 1; return 7; }
int F() { if (4 >= 4 && 5 > 4 && 3 <= 3 && 9 - 2 * 3 == 3) return 70; return 71; }
int G() { loop { break; } return 4; }
int H() { outer: loop { loop { break outer; } } return 9; }
int Clamp(int v) { if (v > 9) { v = 9; } return v; }
if (2 < 3) return A() + B() + C() + D() + E() + F() + G() + H() + Clamp(12) + Clamp(4); else return 0;
