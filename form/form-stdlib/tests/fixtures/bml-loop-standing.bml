//////////////////////////////////////////////////////////////////////
//
// Name: bml-loop-standing.bml
// Platform: Form native kernel
//
//////////////////////////////////////////////////////////////////////

/* Canonical source: a loop in a body that keeps the value it stands on.
   The unit holds a fail (Guard's first branch), and Sum calls Guard, so
   Sum's body can stop and keeps its standing value. The loop itself can
   never fail: it asks FAILED nowhere, and carries its sum and the
   standing value out together. The sum below 5000, plus Guard's 1.
   Answer: 12497501. */

int Guard(int n) { int r = 0; choose { fail; } , { r = n; } return r; }
int Sum(int n) { int s = 0; for (int i = 0; i < n; i++) { s = s + i; } return s + Guard(1); }
return Sum(5000);
