// local-plan-door-flow.bml — a door whose last line runs its flow: the flow consumes its definition's answer and leaves a
// mark. form-stdlib/tests/local-plan-parks-band.bml stands stubs over it and reads that the flow never runs under them.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class LocalPlanDoorFlow {
  def lpdf-rows(x) = [x, x];
  def lpdf-flow() {
   let rows = lpdf-rows(1);
   let counted = reverse-onto(rows, []);
   let marked = write_file_text(".hearth/local-plan-door-flow.mark", "ran");
   len(counted);
  }
 }
 lpdf-flow();
}
