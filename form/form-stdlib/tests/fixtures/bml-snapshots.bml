// save/restore/discard as one state snapshot. `mark;` (and `save;`) takes a
// snapshot of the locals and the value a statement list stands on,
// `restore;` returns to it and `discard;` drops it, keeping what happened
// since. Snapshots stack; a rebinding inside a nested block is inside the
// snapshot too; a called method snapshots its own frame. The unit's own body
// rolls back as well.
// Answer: 20
// (1, Saved() = 1, Rollback() = 1, Kept() = 5, Nested() = 4, Block() = 1, Undo(7) = 7)
int Saved() { int x = 1; save; x = 2; restore; return x; }
int Rollback() { int x = 1; mark; x = 5; restore; return x; }
int Kept() { int x = 1; mark; x = 5; discard; return x; }
int Nested() { int x = 1; int y = 0; mark; x = 2; mark; x = 3; restore; y = x; discard; return x + y; }
int Block() { int x = 1; mark; { x = 9; } restore; return x; }
int Undo(int n) { int x = n; mark; x = x + 100; restore; return x; }
int x = 1;
mark;
x = 5;
restore;
return x + Saved() + Rollback() + Kept() + Nested() + Block() + Undo(7);
