// Canonical source for type-generic-overload-resolution over class types.
// Answer on both lanes: 304. Both lanes read one class layout, so B is an A
// on each and Take(A) wins over Take(int) without a tie.
// Printer's Put overloads resolve on a receiver (200, 101); Take(A) answers a
// B through subtyping (1), Take(int) an int (2).
class Printer : Object { section [public] { int Put(int x) { return x + 100; } int Put(String s) { return 200; } } }
class A : Object { section [public] { int v; } }
class B : A { section [public] { int w; } }
int Take(A a) { return 1; }
int Take(int n) { return 2; }
return new Printer().Put("z") + new Printer().Put(1) + Take(new B()) + Take(5);
