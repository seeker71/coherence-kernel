// walk-renew-readers.bml — the night's and the day turn's own readers of their renewal, each handed the one line
// form-stdlib/tests/host-walk-band.bml (claim "renewal") writes.
//
// It imports both real doors, which walk only as the entry, so here neither walks, and hands each door's reader the renewal
// (observe/scheduled-walk.bml sw-handed, observe/day-turn.bml dt-handed) with a walked function that keeps what it was given in
// the place the door's own steps take it (sw-walked, dt-walked). The band writes the line with hw-renewal-line, a value of its
// own in every pair, so a pair read in another's place or a safe flag read inverted shows in the line this prints.
// Prints "[walk-renew-readers] night began=<n> until=<n> safe=<true|false> branch=<s> day=<s> sync=<s> build=<s> carrier=<s>"
// and "[walk-renew-readers] day until=<n> safe=<true|false> options=<json> branch=<s> day=<s> sync=<s> build=<s> carrier=<s>
// from=<n>".
// stdin: one renewal line, {"renewal":{...}}, whose "from" did not begin this process: a door begun here by mistake refuses it
// and walks nothing.
// preludes: form-stdlib/bml/host-walk.bml observe/form-membrane-runtime-census.fk form-stdlib/bml/disk-steward.bml form-stdlib/bml/kernel-steward.bml
import form-stdlib/bml/form-cli-code-memory.bml;
import observe/day-turn.bml;
import observe/scheduled-walk.bml;
section [form.bml] {
 class WalkRenewReaders {
  def wrr-flag(b) = b ? "true" : "false";
  def wrr-night(began, until, safe, branch, day, sync, build, carrier) = "[walk-renew-readers] night began=" ++ began.str() ++ " until=" ++ until.str() ++ " safe=" ++ wrr-flag(safe) ++ " branch=" ++ branch ++ " day=" ++ day ++ " sync=" ++ sync ++ " build=" ++ build ++ " carrier=" ++ carrier;
  def wrr-day(until, safe, options, branch, day, sync, build, carrier, from) = "[walk-renew-readers] day until=" ++ until.str() ++ " safe=" ++ wrr-flag(safe) ++ " options=" ++ json-emit(options) ++ " branch=" ++ branch ++ " day=" ++ day ++ " sync=" ++ sync ++ " build=" ++ build ++ " carrier=" ++ carrier ++ " from=" ++ from.str();
  def wrr-read(r) {
   let night = print_str(sw-handed(r, wrr-night));
   print_str(dt-handed(r, wrr-day));
  }
 }
 let r = hw-renewal(hw-stdin());
 nothing?(r) ? form_error("[walk-renew-readers] no renewal on stdin") : wrr-read(r);
}
