// Class members named before any table exists: a method the class does not
// have, an overload no arity selects, and a method outside any class that
// reads this, which has no receiver.
// Answer: "BML-HATI-UNSUPPORTED method/not-found,method/arity,field/no-receiver"
class Rule : Object { section [public] { int value;
  int Pick() { return this.value + 1; }
  int Pick(int v) { return v + 2; } } }
int Loose() { this.value = 33; return this.value; }
return new Rule().Missing() + new Rule().Pick(1, 2) + Loose();
