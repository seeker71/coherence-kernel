// Canonical source: a private field without get reads only in its own class's
// methods (thesis lines 685, 729-730); read from outside it is refused.
// Answer: "BML-HATI-UNSUPPORTED access/private"
class P : Object { section [private] { int secret; } section [public] { P() { this.secret = 9; } int Secret() { return this.secret; } } }
P p = new P();
return p.Secret() + p.secret;
