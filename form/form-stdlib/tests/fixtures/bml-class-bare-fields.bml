// Canonical source: a bare field name inside a member reads and assigns the
// field through this: read 4, assign 5, in a constructor 6, in a choose whose
// first branch fails 2. A local or a parameter of the same name shadows the
// field: 3 and 4.
// Answer: 24 (4 + 5 + 6 + 2 + 3 + 4).
class R : Object { section [public] { int v; R(int s) { this.v = s; } int Get() { return v; } } }
class S : Object { section [public] { int v; int Set(int a) { v = a; return this.v; } } }
class K : Object { section [public] { int v; K(int a) { v = a; } int Get() { return v; } } }
class T : Object { section [public] { int v; int Try() { choose { v = 5; fail; } , { v = v + 2; } return v; } } }
class L : Object { section [public] { int v; int F() { int v = 9; v = 3; return v + this.v; } } }
class M : Object { section [public] { int v; M(int v) { this.v = v + 1; } int Get() { return v; } } }
return new R(4).Get() + new S().Set(5) + new K(6).Get() + new T().Try() + new L().F() + new M(3).Get();
