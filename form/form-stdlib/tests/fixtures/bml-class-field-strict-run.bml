// Canonical source: a strict field is checked when a store runs, since a
// declared type does not tell whether the object is of that class or a
// derived one (thesis line 666). Make answers a B by its declared type, but
// its object is a D, so the store is refused and the run answers the trap.
// Answer: "BML-HATI-TRAP field/strict H.b"
class B : Object { section [public] { int v; } }
class D : B { section [public] { } }
class H : Object { section [public] { B b [strict]; } }
B Make() { return new D(); }
H h = new H();
h.b = Make();
return 5;
