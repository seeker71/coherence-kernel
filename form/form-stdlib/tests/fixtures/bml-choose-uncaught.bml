// Canonical sources: a failure no choose catches ends the program on both
// lanes, at the value the program stood on. Fails' choose can only fail.
// Safe calls Bump inside a choose branch, so Bump's failure there is caught
// and the next branch answers 12. The top level then calls Bump outside any
// choose: the failure travels up through Bump and ends the program standing
// on b, and the return after it never runs.
// Answer on BMA and Hati: 13.
int Fails() { choose { fail; } , { fail; } return 5; }
int Bump(int n) { int k = n + 1; int f = Fails(); return k + f; }
int Safe(int n) { int r = n; choose { r = Bump(n); } , { r = n + 10; } return r; }
int a = Safe(2);
int b = a + 1;
int c = Bump(b);
return c + 1000;
