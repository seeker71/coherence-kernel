// Canonical source: one object through two names. A member set through a
// parameter is seen by the caller's read (9); two parameters naming one
// object see one field (4).
// Answer: 13 (9 + 4).
class C : Object { section [public] { int v; int Set(int a) { this.v = a; return a; } } }
int F(C c) { c.Set(9); return c.v; }
int G(C a, C b) { a.v = 4; return b.v; }
C c = new C();
return F(new C()) + G(c, c);
