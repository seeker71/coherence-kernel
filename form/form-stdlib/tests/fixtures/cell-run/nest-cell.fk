; nest-cell.fk — a cell that runs a cell: the inner one stops, the outer one goes on with its own output
(do
    (print_str "outer before")
    (let r (cell_run "form/form-stdlib/tests/fixtures/cell-run/stop-cell.fk" 0 (nothing) (nothing)))
    (print_str "outer after")
    (if (nothing? (record_get r "stopped")) 0 (if (str_eq (record_get (record_get r "stopped") "kind") "stop") 1 2)))
