// Canonical source: a final method takes no override. B marks Locked final
// and C declares its own Locked; the unit is refused.
// Answer: "BML-HATI-UNSUPPORTED method/final-override"
class B : Object { section [public] { int Locked() [final] { return 1; } } }
class C : B { section [public] { int Locked() { return 2; } } }
return new C().Locked();
