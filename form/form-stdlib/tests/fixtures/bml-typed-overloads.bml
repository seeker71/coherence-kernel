// Canonical source for type-generic-overload-resolution, free methods.
// Answer: 136.
// Pick(int) and Pick(String) each answer their own argument (42, 7); the
// exact Show(int) beats the generic Show<T> (41), which takes the String the
// exact one refuses (5); id<T>(int x) answers its argument (41).
int Pick(int x) { return x + 2; }
int Pick(String s) { return 7; }
int Show(int x) { return x + 1; }
int Show<T>(T x) { return 5; }
int id<T>(int x) { return x; }
return Pick(40) + Pick("a") + Show(40) + Show("s") + id(41);
