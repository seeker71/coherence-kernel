; writer-cell.fk — a voice-track worker in miniature: it gives one record into the shared field and ends.
; stdin, one per line: the track directory, the tongue, the seq to give, the state to give. The record's pid is this process's own,
; which for a cell run in-process is the caller's -- the pid a supervisor would be told to end.
; preludes: form/form-stdlib/voice-track-record.bml
(do
    (let dir (read_line))
    (let code (read_line))
    (let seq (str_to_int (read_line)))
    (let state (read_line))
    (let answer (vtq-give dir code (vtq-new (host_pid) seq "render" seq 10 1000 (now_unix_ms) state)))
    (print_str (nth answer 1))
    seq)
