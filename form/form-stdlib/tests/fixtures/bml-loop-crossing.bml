//////////////////////////////////////////////////////////////////////
//
// Name: bml-loop-crossing.bml
// Platform: Form native kernel
//
//////////////////////////////////////////////////////////////////////

/* Canonical source: a return and a throw that leave a loop. Each rides out
   of the loop as a value it answers, and the function returns or throws
   once the loop has answered: no pass reads a mode.
   Find returns from inside its loop: 9999 (9999 * 9999 = 99980001), and
   -1 when no square below 10 reaches 1000. Scan throws its sum when i
   reaches 5000 (the sum below 5000, 12497500), and Safe's catch adds 1.
   9999 - 1 + 12497501 = 12507499.
   Answer: 12507499. */

int Find(int n, int want) { for (int i = 0; i < n; i++) { if (i * i >= want) return i; } return -1; }
int Scan(int n) { int s = 0; for (int i = 0; i < n; i++) { if (i == 5000) throw s; s = s + i; } return s; }
int Safe(int n) { try { return Scan(n); } catch (int e) { return e + 1; } }
return Find(100000, 99980001) + Find(10, 1000) + Safe(100000);
