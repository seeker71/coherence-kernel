// Canonical source: a class constant reads by name in its own class's code
// and in a subclass's; a private one only in its own class, a protected one
// in a subclass by Name, Base.Name or Child.Name; from outside, Class.Name
// reads a public one the class sees, its own or its base's.
// Answer: 416 (99 + 7 + 7, 99 + 2 + 2 + 2, 99, 99).
class Base : Object { section [public] { const int Answer = 99; const int Guarded [protected] = 2; const int Secret [private] = 7;
  int Own() { return Answer + Secret + Base.Secret; } } }
class Child : Base { section [public] { int Inherited() { return Answer + Guarded + Base.Guarded + Child.Guarded; } } }
return new Base().Own() + new Child().Inherited() + Base.Answer + Child.Answer;
