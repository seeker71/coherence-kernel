// walk-renew-door.bml — a walk door in miniature: the door form-stdlib/tests/host-walk-band.bml (claim "renewal") begins in a
// scratch walk whose main moves a rule under it.
//
// It walks as the night and the day turn do (form-stdlib/bml/host-walk-renew.bml hw-walk-door): the launched start claims the
// checkout it stands in and stamps its slot (hw-begin), follows main (hw-sync) and renews; the renewed start takes the walk,
// builds the request a walk lands from the carry list of walk-renew-carry.bml and releases. The band copies this door and
// walk-renew-carry.bml into a scratch origin, moves the list on main after the walk's clone took it, and begins the door in the
// clone with the band's kernel named absolutely: the stdlib resolves from that kernel's checkout, walk-renew-carry.bml from the
// clone, and the lock, the stamp and .hearth/walk-io stand in the clone.
// Prints, from the launched start, its lock line and the request the code it compiled builds after its sync, with the window it
// hands on; from the renewed start, its lock line, the window as it was handed, the request it built and the release; and last
// the launched start's [walk-renew] line.
// stdin: what a walk door reads (hw-stdin): nothing, {"again":1} and {"safe":1}, or the renewal its launched start hands it.
// preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/bml/host-walk.bml walk-renew-carry.bml
section [form.bml] {
 class WalkRenewDoor {
  def wrd-window-ms() = 600000;
  def wrd-request() = json-emit(json-node-object([json-node-pair("paths", json-node-array(map(p => json-node-string(p), wrc-carry())))]));
  def wrd-prologue(opts) {
   let began = hw-hhmm();
   let until = host_monotonic_ms() + wrd-window-ms();
   let lock = hw-begin("walk-renew-door", opts);
   let said = print_str(lock[1]);
   (Comparable) lock[0] == 1 ? wrd-walk(began, until, hw-safe?(opts)) : nothing();
  }
  def wrd-walk(began, until, safe) {
   let branch = hw-branch();
   let day = hw-day();
   let sync = hw-sync(branch);
   let saw = print_str("[walk-renew-door] launched pid=" ++ host_pid().str() ++ " until=" ++ until.str() ++ " day=" ++ day ++ " hhmm=" ++ began.str() ++ " request " ++ wrd-request());
   hw-renewal-pairs(until, day, began, safe, branch, sync, "build=none", "carrier=none");
  }
  def wrd-steps(r) {
   let said = print_str("[walk-renew-door] renewed pid=" ++ host_pid().str() ++ " until=" ++ hw-row-int(r, "until_ms").str() ++ " day=" ++ hw-row-str(r, "day") ++ " hhmm=" ++ hw-row-int(r, "hhmm").str() ++ " safe=" ++ hw-row-int(r, "safe").str() ++ " " ++ hw-row-str(r, "sync"));
   let built = print_str("[walk-renew-door] built " ++ wrd-request());
   print_str(hw-release());
  }
 }
 hw-walk-door("walk-renew-door", hw-stdin(), wrd-prologue, wrd-steps);
}
