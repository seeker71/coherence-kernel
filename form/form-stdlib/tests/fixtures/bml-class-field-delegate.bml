// Canonical source: a field marked delegate takes the calls its class does
// not answer (thesis lines 661, 723): C answers Area itself and hands Name to
// its Shape field.
// Answer: 10 (7 + 3).
class Shape : Object { section [public] { int Name() { return 7; } int Area() { return 100; } } }
class C : Object { section [public] { Shape s [delegate]; C() { this.s = new Shape(); } int Area() { return 3; } } }
C c = new C();
return c.Name() + c.Area();
