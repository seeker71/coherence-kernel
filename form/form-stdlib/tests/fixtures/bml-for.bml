// `for (init; c; u) s` from source: a for-owned variable, update forms (=, ++,
// -=, +=), empty clauses, an early return, nested loops with a labeled
// continue, and a for inside a method reached by calls. The unit's own body
// searches with a for too.
// Answer: 143
// (8, Root(50) = 8, Root(9) = 3, Pair() = 43, Forever() = 7, Sum() = 55,
// Grid() = 18, Down() = 1)
int Root(int k) { for (int i = 0; i < 100; i++) { if (i * i >= k) return i; } return -1; }
int Pair() { outer: for (int i = 0; i < 5; i++) { for (int j = 0; j < 5; j++) { if (j > i) continue outer; if (i + j == 7) return i * 10 + j; } } return -1; }
int Forever() { for (;;) { return 7; } }
int Sum() { int s = 0; for (int i = 1; i <= 10; i++) { s = s + i; } return s; }
int Grid() { int total = 0; for (int i = 0; i < 4; i++) { for (int j = 0; j < 3; j++) { total += i * j; } } return total; }
int Down() { for (int i = 10; i > 0; i -= 3) { if (i < 3) return i; } return 0; }
for (int i = 0; i < 10; i = i + 1) { if (i * i > 50) return i + Root(50) + Root(9) + Pair() + Forever() + Sum() + Grid() + Down(); }
return -1;
