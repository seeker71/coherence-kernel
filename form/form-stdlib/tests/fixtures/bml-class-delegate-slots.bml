// Canonical source: a field a base and a delegate both declare keeps two
// slots. A's code reads A's n and D's code reads D's n; e.n from outside
// resolves depth first as a method does (E, then A, then D), and a D view of
// the same object reads D's.
// Answer: 42 (1 + 20 + 1 + 20).
class A : Object { section [public] { int n; A() { this.n = 1; } int FromA() { return this.n; } } }
class D : Object { section [public] { int n; int FromD() { return this.n; } int SetD(int v) { this.n = v; return v; } } }
class E : A, D { section [public] { E() { super(); this.SetD(20); } } }
int Take(D x) { return x.n; }
E e = new E();
return e.FromA() + e.FromD() + e.n + Take(e);
