// Canonical source: relaxed takes objects of the defined type or derived ones
// (thesis line 664), shared leaves the referenced object reachable from
// several places (line 665), and strict takes its own type (line 666). Here
// r holds a D, and s and t hold the one B that a later set of one.v reaches.
// Answer: 85 (5 + 40 + 40).
class B : Object { section [public] { int v; B() { this.v = 2; } } }
class D : B { section [public] { D() { super(); this.v = 5; } } }
class H : Object { section [public] { B r [relaxed]; B s [shared]; B t [strict]; } }
H h = new H();
B one = new B();
h.r = new D();
h.s = one;
h.t = one;
one.v = 40;
return h.r.v + h.s.v + h.t.v;
