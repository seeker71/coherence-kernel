// Canonical source: flags that hold refuse nothing. A final class runs its
// final method, and a concrete subclass of an abstract class makes a record
// that answers the abstract class's method and its own.
// Answer: 14 (4 + 3 + 7).
class F [final] : Object { section [public] { int V() [final] { return 4; } } }
class A [abstract] : Object { section [public] { int W() { return 3; } } }
class B : A { section [public] { int X() { return 7; } } }
B b = new B();
return new F().V() + b.W() + b.X();
