// A class's fields and methods. A method reads its receiver's field and
// another sets it, and the set stands for the next call; a field no
// constructor sets reads its default; overloads on a receiver are chosen by
// arity.
// Answer: 290
// (a = 42, b = 45 + 49 + 41 + 42 + 0, c = 33, then 38)
class Rule : Object { section [public] { int value; int count;
  Rule(int v) { this.value = v; }
  int Read() { return this.value + 5; }
  int Alt() { return this.value + 9; }
  int Set() { this.value = 33; return this.value; }
  int Pick() { return this.value + 1; }
  int Pick(int v) { return v + 2; }
  int Count() { return this.count; } } }
int Run() { Rule r = new Rule(37); int a = r.Read(); Rule s = new Rule(40); int b = s.Read() + s.Alt() + s.Pick() + s.Pick(40) + s.Count(); int c = r.Set(); return a + b + c + r.Read(); }
return Run();
