// Canonical source: overloads chosen over a call's result. A call's static
// type is the declared return type of the method it resolves to: a free
// method, a class member, and a template member specialized to String and to
// int. Pick(String) answers 2, Pick(int) 1.
// Answer: 45 (3 + 21 + 21).
int Pick(int x) { return 1; }
int Pick(String s) { return 2; }
String Name() { return "n"; }
int Num() { return 5; }
class C : Object { section [public] { String Tag() { return "t"; } int Size() { return 3; } } }
class Box<T> : Object { section [public] { T value;
  Box(T v) { this.value = v; }
  T Get() { return this.value; } } }
int free = Pick(Name()) + Pick(Num());
int member = Pick(new C().Tag()) * 10 + Pick(new C().Size());
int boxed = Pick(new Box<String>("a").Get()) * 10 + Pick(new Box<int>(4).Get());
return free + member + boxed;
