//////////////////////////////////////////////////////////////////////
//
// Name: bml-loop-nested.bml
// Platform: Form native kernel
//
//////////////////////////////////////////////////////////////////////

/* Canonical source: a loop inside a loop, nothing crossing either edge.
   The inner loop is mode-free itself and its passes reach only itself, so
   it lowers as its own defn over s, i and j, called from each pass of the
   outer one. The sum of i * j over i, j below 300 is (299 * 300 / 2)^2.
   Answer: 2011522500. */

int Table(int n) { int s = 0; for (int i = 0; i < n; i++) { for (int j = 0; j < n; j++) { s = s + i * j; } } return s; }
return Table(300);
