; The child stdout is a pipe under host_capture, a terminal under a PTY.
; preludes: form-stdlib/core.fk
(do
    (defn fas-bytes (n acc) (if (eq n 0) acc (fas-bytes (sub n 1) (cons 65 acc))))
    (let first (file_append_bytes "/dev/stdout" (fas-bytes 9000 (list))))
    (let second (file_append_bytes "/dev/stdout" (list 66 66 66)))
    (let empty (file_append_bytes "/dev/stdout" (list)))
    (list first second empty))
