//////////////////////////////////////////////////////////////////////
//
// Name: bml-loop-labeled.bml
// Platform: Form native kernel
//
//////////////////////////////////////////////////////////////////////

/* Canonical source: a labeled continue and a labeled break that leave an
   inner loop for the outer one. Each rides out of the inner loop in its
   answer, and the outer loop takes it: its next pass, or its end. No pass
   reads a mode. The pairs j <= i < 190 with i * j = 3600: j is 20, 24,
   25, 30, 36, 40, 45, 48, 50 or 60.
   Answer: 10. */

int Pairs(int n) { int hits = 0; outer: for (int i = 0; i < n; i++) { for (int j = 0; j < n; j++) { if (j > i) continue outer; if (i == 190) break outer; if (i * j == 3600) { hits = hits + 1; } } } return hits; }
return Pairs(200);
