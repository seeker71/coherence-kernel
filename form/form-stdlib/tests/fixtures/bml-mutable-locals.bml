// Mutable locals. A local is rebound by `x = e;`, also from a nested block,
// and the rebinding is read after it; a parameter rebound in a block keeps
// its new value; an inner declaration shadows and the outer local stays
// itself; a const that read a local keeps the value it read; a called method
// keeps its own locals, a const among them. The unit's own body declares and
// rebinds too.
// Answer: 131
// (6, Run() = 15, Bump(2) = 7, Bump(30) = 35, Deep() = 6, Shadow() = 1,
// Snap() = 12, Twice(4) = 8, F(40) = 41)
int Run() { int x = 1; { x = x + 4; } return x + 10; }
int Bump(int n) { { n = n + 5; } return n; }
int Deep() { int x = 1; { { x = x + 2; } x = x + 3; } return x; }
int Shadow() { int x = 1; { int x = 5; x = x + 1; } return x; }
int Snap() { int x = 1; const int y = x + 1; x = 10; return y + x; }
int Twice(int n) { int x = n; x = x + n; return x; }
int F(int n) { const int one = 1; int acc = n; acc = acc + one; return acc; }
int x = 2;
{
    x = x + 3;
}
return x + 1 + Run() + Bump(2) + Bump(30) + Deep() + Shadow() + Snap() + Twice(4) + F(40);
