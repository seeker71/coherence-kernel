// A unit bml-class-package-access.bml links: in package PkgLib, Box's inner
// has no access attribute, so it is package access (thesis line 731).
package PkgLib;
class Box : Object { int inner; section [public] { int shown; Box() { this.inner = 4; this.shown = 5; } int Inner() { return this.inner; } } }
