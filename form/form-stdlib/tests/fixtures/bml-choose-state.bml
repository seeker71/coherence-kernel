// Canonical sources: a choose over the one snapshot.
// A branch stops at its fail: the assignment after it never runs. A callee
// whose own choose fails fails the branch that called it. An inner choose
// that fails fails the outer branch around it. A choose whose every branch
// is a bare fail stops the body at the value it stood on, and the compiler
// organ says so where it lowers that choose.
// Answer: 12 (2 + 3 + 7), the value the body stood on.
int Fails() { choose { fail; } , { fail; } return 5; }
int Stop() { int x = 1; choose { x = 9; fail; x = 20; } , { x = x + 1; } return x; }
int Callee() { int x = 1; choose { x = Fails(); x = 40; } , { x = x + 2; } return x; }
int Nested() { int x = 1; choose { choose { x = 4; fail; } , { x = 5; fail; } x = 30; } , { x = x + 6; } return x; }
int s = Stop() + Callee() + Nested();
choose { fail; } , { fail; }
return s + 100;
