// Canonical source for full-class-construction-syntax on the BML native lane.
// Rule(x) and Rule(x, y) chain through self(..) to Rule(x, y, z) on one record;
// Named(i, t) runs Base(i) through super(..) before setting its own field.
// Answer: 84 (42 + 42).
class Rule : Object { section [public] { int a; int b; int c;
  Rule(int x, int y, int z) { this.a = x; this.b = y; this.c = z; }
  Rule(int x, int y) { self(x, y, 7); }
  Rule(int x) { self(x, 30); }
  int Sum() { return this.a + this.b + this.c; } } }
class Base : Object { section [public] { int id; Base(int i) { this.id = i; } } }
class Named : Base { section [public] { int tag;
  Named(int i, int t) { super(i); this.tag = t; }
  int Total() { return this.id + this.tag; } } }
return new Rule(5).Sum() + new Named(40, 2).Total();
