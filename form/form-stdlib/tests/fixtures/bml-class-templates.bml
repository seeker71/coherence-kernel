// Canonical source for template-generic-specialization on the BML native lane.
// Box<int> and Box<String> are each their own class: Describe's
// this.Show(this.value) picks Show(int) in one and Show(String) in the other.
// Pair<int, String> specializes two parameters; Source<int> specializes an
// interface that Counter implements.
// Answer on Hati: 133 (49 + 42 + 42). Answer on BMA: BML-HATI-UNSUPPORTED
// bma/class-lane,call/receiver-dispatch (BMA carries no class shapes yet).
class Box<T> : Object { section [public] { T value;
  Box(T v) { this.value = v; }
  T Get() { return this.value; }
  int Show(int x) { return x + 1; }
  int Show(String s) { return 7; }
  int Describe() { return this.Show(this.value); } } }
template <K, V> class Pair : Object { section [public] { K first; V second; Pair(K a, V b) { this.first = a; this.second = b; } K First() { return this.first; } } }
template <T> interface Source { section [public] { T Next(); } }
class Counter : Object, Source<int> { section [public] { int n; Counter(int s) { this.n = s; } int Next() { return this.n + 1; } } }
int Pull(Source<int> s) { return s.Next(); }
return new Box<int>(41).Describe() + new Box<String>("a").Describe() + new Pair<int, String>(40, "x").First() + 2 + Pull(new Counter(41));
