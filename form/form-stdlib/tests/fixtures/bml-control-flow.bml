//////////////////////////////////////////////////////////////////////
//
// Name: bml-control-flow.bml
// Platform: Form native kernel
//
//////////////////////////////////////////////////////////////////////

/* Canonical sources: source control on the native lane.
   A while and a for take their passes in place. A switch runs on from
   the case that matched until a break; a function that recurses from
   inside its own switch keeps its own switch value, so G(2) is 1 and
   G(1) is 2. A select runs only the clause that matched, over value lists
   and lo .. hi ranges. with reads its base once and .self reaches it. A
   throw crosses a call to the catch that takes it. A labeled continue and
   a labeled break reach the outer loop.
   4 + 55 + 11 + 10 + 100 + 1000 + 200 + 4 + 3 + 1 + 0 + 42 + 3 + 21 + 6.
   Answer: 1460. */

int Count(int n) { int i = 0; while (i < n) { i = i + 1; } return i; }
int Sum(int n) { int s = 0; for (int i = 1; i <= n; i++) { s = s + i; } return s; }
int Fall(int k) { int acc = 0; switch (k) { case 1: acc = acc + 1; case 2: acc = acc + 10; break; default: acc = acc + 100; } return acc; }
int G(int n) { if (n == 0) return 7; switch (n) { case G(n - 1): return 1; default: return 2; } }
int Grade(int s) { int g = 0; select (s) { case 90 .. 100: g = 4; case 80 .. 89: g = 3; case 0, 1, 2: g = 1; default: g = 0; } return g; }
int W() { with (6 * 7) { return .self; } }
int Risky(int n) { if (n > 5) throw n * 2; return n; }
int Safe(int n) { try { return Risky(n); } catch (int e) { return e + 1; } }
int Grid() { int cells = 0; outer: for (int i = 0; i < 4; i++) { for (int j = 0; j < 4; j++) { if (j > i) continue outer; if (i == 3) break outer; cells++; } } return cells; }
return Count(4) + Sum(10) + Fall(1) + Fall(2) + Fall(5) + G(2) * 1000 + G(1) * 100 + Grade(95) + Grade(85) + Grade(2) + Grade(50) + W() + Safe(3) + Safe(10) + Grid();
