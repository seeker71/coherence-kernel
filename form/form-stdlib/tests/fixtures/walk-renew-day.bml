// walk-renew-day.bml — the day turn's renewal in miniature: the door form-stdlib/tests/host-walk-band.bml (claim "renewal") begins
// in its scratch walk, where it planted a runtime continuation in the walk's hearth. The walk holds the checkout's own
// observe/day-turn.bml, as the walk checkout does, and this door imports it from beside itself.
//
// Its launched start is the day turn's own (observe/day-turn.bml dt-prologue): it claims the checkout as day-turn, claims the
// continuation for itself (its pid and its kernel's start), heals, syncs, builds and rebuilds the carrier (in the scratch walk the
// two compilers find no source and read 1), and hands its pairs with the continuation's options (hw-walk-door). Its renewed start
// reads its renewal as the day turn's steps do (dt-handed, the options through dt-options), takes the continuation as they do
// (dt-taken), says what it holds,
// ends the continuation's window as they do (dt-window-end: the planted deadline has passed, so the continuation is kept as
// window-expired and archived under this pid) and releases; it takes no turn and opens no model.
// Prints the launched start's lock line; the renewed start's lock line, its line "[walk-renew-day] renewed pid=<pid> taken=<0|1>
// owned=<0|1> started=<own|other> options <json>", the day turn's expiry line and the release; and last the launched start's
// [walk-renew] line.
// stdin: nothing from the band; the renewal its launched start hands it.
// preludes: form-stdlib/bml/host-walk.bml observe/form-membrane-runtime-census.fk
import form-stdlib/bml/form-cli-code-memory.bml;
import observe/day-turn.bml;
section [form.bml] {
 class WalkRenewDay {
  // the renewal read as the day turn's steps read it (dt-handed), into the steps in miniature
  def wry-steps(r) = dt-handed(r, wry-walked);
  def wry-walked(until, safe, options, branch, day, sync, build, carrier, from) {
   let taken = dt-taken(from);
   let packet = file_size(dt-runtime-path()) > 0 ? read_form_binary(dt-runtime-path()) : nothing();
   let said = print_str("[walk-renew-day] renewed pid=" ++ host_pid().str() ++ " taken=" ++ (taken ? "1" : "0") ++ " owned=" ++ (dt-owned-pending?() ? "1" : "0") ++ " started=" ++ ((Comparable) fhn-count(packet, "started") == kernel_live(host_pid())[2] ? "own" : "other") ++ " options " ++ json-emit(options));
   let ended = dt-window-end(until);
   print_str(hw-release());
  }
 }
 hw-walk-door("day-turn", hw-stdin(), dt-prologue, wry-steps);
}
