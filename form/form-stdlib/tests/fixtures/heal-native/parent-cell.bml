// parent-cell.bml — a cell that begins a grandchild and waits: the native process organ's band stops it after readiness and reads
// that the grandchild (a Form sleeper) is stopped with it. It prints the grandchild's pid first.
// preflight-exec: forbidden
section [form.bml] {
 let child = host_spawn_at(["./fkwu", "form/form-stdlib/tests/host-sleeper-run.fk"], ["/dev/null", "/dev/null", "/dev/null"]);
 let said = print_str("grandchild=" ++ child.str());
  let control=read_line();
  if value_kind(control)=="string" && len(control)>0 && child>0 then write_file(control,"stop") else 0;
 let slept = host_sleep_ms(30000);
 0;
}
