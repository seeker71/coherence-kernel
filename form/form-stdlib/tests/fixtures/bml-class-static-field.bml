// Canonical source: a [class] field is one slot for its class, not one per
// record. Its initializer runs once, at the first read; every instance and the
// class's code share it, and from outside it reads and sets as Counter.count.
// Answer: 249 (11 + 12 + 113 + 113).
class Counter : Object { section [public] { int count [class] = 10; int id;
  Counter() { count = count + 1; this.id = count; }
  int Id() { return this.id; } } }
Counter a = new Counter();
Counter b = new Counter();
Counter.count = Counter.count + 100;
Counter c = new Counter();
return a.Id() + b.Id() + c.Id() + Counter.count;
