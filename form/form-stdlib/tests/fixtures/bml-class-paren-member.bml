// Canonical source: a member straight off a parenthesized value reads, and the
// tail keeps stepping: (p).v, (new P()).v, (e.Get()).Plus(10), (p).next.v.
// Answer: 26 (4 + 4 + 14 + 4).
class P : Object { section [public] { int v; P next; P() { this.v = 4; } int Plus(int n) { return n + this.v; } } }
class E : Object { section [public] { P p; E() { this.p = new P(); } P Get() { return this.p; } } }
P p = new P();
p.next = new P();
E e = new E();
return (p).v + (new P()).v + (e.Get()).Plus(10) + (p).next.v;
