// Canonical source: a strict field "can only store references to the objects
// of the defined type (i.e. not to derived objects)" (thesis line 666). The
// relaxed field takes a D; storing a D into the strict B field is refused.
// Answer: "BML-HATI-UNSUPPORTED field/strict"
class B : Object { section [public] { int v; } }
class D : B { section [public] { } }
class H : Object { section [public] { B b [strict]; B r [relaxed]; H() { this.r = new D(); this.b = new D(); } } }
return new H().r.v;
