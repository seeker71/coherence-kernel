// `switch (e) { case v: ... default: ... }` from source: the scrutinee read
// once, fall-through until break, stacked case labels, default in the middle
// (a later case still wins), a labeled switch break, and a switch inside a
// for where break leaves the switch and continue reaches the loop. The unit's
// own body switches too.
// Answer: 2881
// (60, Pick = 10 + 23 + 23 + 99, Fall = 11 + 10 + 1100 + 1000, Mid = 2 + 50 + 1,
// Lab = 77 + 9, Mix() = 406)
int Pick(int k) { switch (k) { case 1: return 10; case 2: case 3: return 23; default: return 99; } }
int Fall(int k) { int acc = 0; switch (k) { case 1: acc = acc + 1; case 2: acc = acc + 10; break; case 3: acc = acc + 100; default: acc = acc + 1000; } return acc; }
int Mid(int k) { switch (k) { case 1: return 1; default: return 50; case 2: return 2; } }
int Lab(int k) { sw: switch (k) { case 1: { if (k == 1) break sw; return 5; } default: return 9; } return 77; }
int Mix() { int acc = 0; for (int i = 0; i < 5; i++) { switch (i) { case 1: continue; case 3: break; default: acc = acc + i; } acc = acc + 100; } return acc; }
switch (2 * 3) { case 6: return 60 + Pick(1) + Pick(2) + Pick(3) + Pick(7) + Fall(1) + Fall(2) + Fall(3) + Fall(5) + Mid(2) + Mid(9) + Mid(1) + Lab(1) + Lab(2) + Mix(); default: return 0; }
