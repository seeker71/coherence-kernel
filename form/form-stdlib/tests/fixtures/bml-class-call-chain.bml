// Canonical source: a field or a member straight off a named call reads, and
// so does a longer chain, each step on what the one before it answers:
// e.Get().v, Make().p.v, e.Get().Next().v, Make().Get().Plus(8),
// e.Get().next.v and e.Get().Next().Plus(13).
// Answer: 60 (3 + 3 + 10 + 11 + 10 + 23).
class P : Object { section [public] { int v; P next; P(int v0) { this.v = v0; } P Next() { return this.next; } int Plus(int n) { return n + this.v; } } }
class E : Object { section [public] { P p; E() { this.p = new P(3); this.p.next = new P(10); } P Get() { return this.p; } } }
E Make() { return new E(); }
E e = new E();
return e.Get().v + Make().p.v + e.Get().Next().v + Make().Get().Plus(8) + e.Get().next.v + e.Get().Next().Plus(13);
