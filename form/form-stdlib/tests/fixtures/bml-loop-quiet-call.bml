//////////////////////////////////////////////////////////////////////
//
// Name: bml-loop-quiet-call.bml
// Platform: Form native kernel
//
//////////////////////////////////////////////////////////////////////

/* Canonical source: a loop that calls a method that can never throw or
   fail. Sq holds no throw, no fail and no call, so nothing can come back
   through it past the loop's edge, and the loop needs no mode: it runs
   as one mode-free defn over s and i. The sum of the squares below 3000
   is 2999 * 3000 * 5999 / 6.
   Answer: 8995500500. */

int Sq(int x) { return x * x; }
int SumSq(int n) { int s = 0; for (int i = 0; i < n; i++) { s = s + Sq(i); } return s; }
return SumSq(3000);
