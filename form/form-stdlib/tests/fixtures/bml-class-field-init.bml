// Canonical source: a field initializer is any expression. a reads a const of
// the unit, b calls a method, p builds a record, c stays a literal; new sets
// each before the constructor runs, read where the class lives.
// Answer: 56 (41 + 6 + 2 + 7).
const int base = 40;
int Twice(int n) { return n + n; }
class P : Object { section [public] { int v = 2; } }
class C : Object { section [public] { int a = base + 1; int b = Twice(3); P p = new P(); int c = 7;
  int Sum() { return this.a + this.b + this.p.v + this.c; } } }
return new C().Sum();
