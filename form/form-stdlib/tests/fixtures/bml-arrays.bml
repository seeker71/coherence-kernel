// Arrays. `#(a, b)` carries any expression as an element (names, sums, nested
// literals) and `a[i]` indexes a literal, a const, a mutable local or another
// index; `a[i] = v` sets one element, also the innermost one of a chain,
// inside a nested block, at an index held in a local, and inside a called
// method.
// Answer: 78
// (Lit() = 5, Local() = 8, c[i] = 9, Nested() = 3, Element() = 6, Rebind() = 8,
// Set() = 10, Grid() = 10, Block() = 7, Walk() = 3, Poke(4) = 9)
int Lit() { return #(3, 5)[1]; }
int Local() { int[] a = #(2, 4, 6); return a[2] + a[0]; }
int Nested() { return #(#(1, 2), #(3, 4))[1][0]; }
int Element() { int x = 5; return #(x, x + 1)[1]; }
int Rebind() { int[] a = #(1, 2); a = #(8, 9); return a[0]; }
int Set() { int[] a = #(1, 2, 3); a[1] = 9; return a[1] + a[0]; }
int Grid() { int[] m = #(#(1, 2), #(3, 4)); m[1][0] = 8; return m[1][0] + m[0][1]; }
int Block() { int[] a = #(5, 6); { a[0] = a[1] + 1; } return a[0]; }
int Walk() { int[] a = #(1, 2, 3, 4); int i = 3; a[i] = 0; return a[3] + a[2]; }
int Poke(int n) { int[] a = #(n, n); a[1] = n + 1; return a[0] + a[1]; }
const int[] c = #(7, 9);
const int i = 1;
return Lit() + Local() + c[i] + Nested() + Element() + Rebind() + Set() + Grid() + Block() + Walk() + Poke(4);
