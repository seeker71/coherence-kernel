// Canonical source: a call through an interface parameter picks each class's
// own member: A answers 1, B answers 20.
// Answer: 21 (1 + 20).
interface T { section [public] { int N(); } }
class A : Object, T { section [public] { int N() { return 1; } } }
class B : Object, T { section [public] { int N() { return 20; } } }
int Call(T t) { return t.N(); }
return Call(new A()) + Call(new B());
