// Canonical source: a second base is a delegation base. The thesis's class
// model reads the first super as the structural base and each later one as
// delegated (bml-class-inheritance-proof): E answers D's messages, D's fields
// ride in E's record for D's own code, and a call on this inside D's code
// dispatches from the object itself, so E's own Who answers. E sets D's d
// through D's own SetD; Take(D) takes an E.
// Answer: 47 (23 + 23 + 1).
class A : Object { section [public] { int a; A() { this.a = 1; } } }
class D : Object { section [public] { int d; int DOnly() { return this.d + this.Who(); } int Who() { return 100; } int SetD(int v) { this.d = v; return v; } } }
class E : A, D { section [public] { E() { super(); this.SetD(20); } int Who() { return 3; } } }
int Take(D x) { return x.DOnly(); }
E e = new E();
return e.DOnly() + Take(new E()) + e.a;
