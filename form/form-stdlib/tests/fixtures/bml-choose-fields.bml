// Canonical sources: a field set inside a failing choose branch rolls back.
// A field is kept in its record, outside every frame. While a snapshot is
// open each field set journals the value it replaces, and a failed branch
// (or a restore) undoes the journal back to its snapshot. Roll's failing
// branch sets v and then fails; After's failing branch stops at its fail;
// Kept sets v between save and restore; Go's failing branch sets another
// record's field through that record's own method.
// Answer on both lanes: 8 (1 + 3 + 3, then 1). On BMA an object lives in
// the floor frame every snapshot carries, so the same sets roll back there.
class Box : Object { section [public] { int v;
  int Set(int a) { this.v = a; return a; }
  int Get() { return this.v; }
  int Roll() { choose { this.v = 5; fail; } , { this.v = this.v + 1; } return this.v; }
  int After() { choose { fail; this.v = 7; } , { this.v = this.v + 2; } return this.v; }
  int Kept() { save; this.v = 50; restore; return this.v; } } }
class Run : Object { section [public] {
  int Chain() { Box c = new Box(); return c.Roll() + c.After() + c.Kept(); }
  int Go() { Box b = new Box(); choose { b.Set(7); fail; } , { b.Set(b.Get() + 1); } return b.Get(); } } }
return new Run().Chain() + new Run().Go();
