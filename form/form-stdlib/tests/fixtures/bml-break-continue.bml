// break and continue from source: continue skips the rest of a pass, break
// leaves the loop, a labeled continue and a labeled break reach the outer
// loop, and continue in a while re-reads its condition.
// Answer: 31
// (Walk() = 4, Grid() = 12, Skip() = 15)
int Walk() { int seen = 0; for (int i = 0; i < 100; i++) { if (i < 5) continue; if (i == 9) break; seen = seen + 1; } return seen; }
int Grid() { int cells = 0; outer: for (int i = 0; i < 10; i++) { for (int j = 0; j < 10; j++) { if (j == 3) continue outer; if (i == 4) break outer; cells = cells + 1; } } return cells; }
int Skip() { int n = 0; int m = 0; while (n < 6) { n = n + 1; if (n == 2 || n == 4) continue; m = m + n; } return m; }
return Walk() + Grid() + Skip();
