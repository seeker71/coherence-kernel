// Canonical source: a field initializer reads this. Fields initialize in
// declaration order after the base's: a reads the base's k, b reads a before
// it, c calls a method on this, d reads this.c; the constructor runs after
// every initializer.
// Answer: 142 (2 + 4 + 7 + 14 + 115).
class B : Object { section [public] { int k = 2; } }
class C : B { section [public] { int a = k + 2; int b = a + 3; int c = this.Twice(b); int d = this.c + 1;
  C() { this.d = this.d + 100; }
  int Twice(int n) { return n + n; }
  int Sum() { return this.k + this.a + this.b + this.c + this.d; } } }
return new C().Sum();
