//////////////////////////////////////////////////////////////////////
//
// Name: bml-control-runaway.bml
// Platform: Form native kernel
//
//////////////////////////////////////////////////////////////////////

/* Canonical source: a loop that never ends. On fkwu the run goes past its
   time; the compiler organ voices how long the unit has run and which
   defn is hot, offers more time or a stop, and with no more time on offer
   stops it. This source declares no budget of its own, so it takes the
   default.
   Answer: "BML-HATI-UNSUPPORTED run/budget" */

int i = 0;
while (1) { i = i + 1; }
return i;
