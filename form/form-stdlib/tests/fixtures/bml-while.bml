// `while (c) s` from source: its condition re-read against changing state
// each pass, a break, a condition false from the start, a labeled continue, a
// run far past the 64-pass cap of the reference while_success loop, and a
// while nested in a for that changes the for's own variable.
// Answer: 101678
// (Down(10) = 398, Brk() = 3, Never() = 2, Local() = 5, Doubling() = 101024,
// Long() = 200, Tally() = 6, Inner() = 40)
int Down(int n) { int steps = 0; while (n > 0) { n = n - 3; steps++; } return steps * 100 + n; }
int Brk() { while (1) { break; } return 3; }
int Never() { while (2 < 1) { return 1; } return 2; }
int Local() { int x = 0; while (x < 5) { x = x + 1; } return x; }
int Doubling() { int x = 1; int steps = 0; while (x < 1000) { x = x * 2; steps++; } return steps * 10000 + x; }
int Long() { int n = 0; while (n < 200) { n = n + 1; } return n; }
int Tally() { int n = 0; int m = 0; outer: while (n < 10) { n = n + 1; if (n < 5) continue outer; m = m + 1; } return m; }
int Inner() { for (int i = 0; i < 10; i = i + 1) { while (i < 4) { i = i + 1; } if (i == 4) return i * 10; } return 0; }
return Down(10) + Brk() + Never() + Local() + Doubling() + Long() + Tally() + Inner();
