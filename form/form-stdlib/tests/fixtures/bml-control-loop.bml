// Name: bml-control-loop.bml
// Platform: Form native kernel
//
//////////////////////////////////////////////////////////////////////

/* Canonical source: a loop of a million passes. It is one LOOP row the
   recipe walker iterates in place, so it answers 1000000 in constant
   stack.
   Answer: 1000000. */

int i = 0;
while (1) { i = i + 1; if (i == 1000000) break; }
return i;
