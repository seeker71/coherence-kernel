// Canonical source: a field set straight off new or a call reads. Each set
// lands in the object the step before it answers; here every E shares one P,
// so q shows each set: 7 through new E(q).p, 12 through Wrap(q).Get(), 42
// through e.Get(). new E(q).a = 5 sets a field on an object nothing keeps.
// Answer: 42 (7, then 7 + 5, then 12 + 30).
class P : Object { section [public] { int v; } }
class E : Object { section [public] { P p; int a; E(P q) { this.p = q; } P Get() { return this.p; } } }
E Wrap(P q) { return new E(q); }
P q = new P();
new E(q).a = 5;
new E(q).p.v = 7;
Wrap(q).Get().v = q.v + 5;
E e = new E(q);
e.Get().v = e.Get().v + 30;
return q.v;
