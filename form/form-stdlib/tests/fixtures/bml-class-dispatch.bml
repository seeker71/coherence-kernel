// Canonical source for full-class-dispatch on the BML native lane.
// Scaled(int k) reads its parameter and calls this.Area() in the same call;
// Area is answered three ways across Shape, Square and Cube, so the call goes
// through the signature's method table; Cube's Area reaches Square's through
// super. Measure takes values of every class through one Shape parameter.
// Answer on Hati: 63. Answer on BMA: BML-HATI-UNSUPPORTED
// call/receiver-dispatch (BMA carries no class shapes yet).
class Shape : Object { section [public] { int size;
  Shape(int s) { this.size = s; }
  int Area() { return this.size; }
  int Scaled(int k) { return this.Area() + k; } } }
class Square : Shape { section [public] {
  Square(int s) { super(s); }
  int Area() { return this.size + this.size; } } }
class Cube : Square { section [public] {
  Cube(int s) { super(s); }
  int Area() { return super.Area() + this.size; } } }
int Measure(Shape s, int k) { return s.Scaled(k); }
return Measure(new Shape(10), 1) + Measure(new Square(10), 1) + Measure(new Cube(10), 1);
