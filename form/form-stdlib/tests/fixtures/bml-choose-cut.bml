//////////////////////////////////////////////////////////////////////
//
// Name: bml-choose-cut.bml
// Platform: Form native kernel
//
//////////////////////////////////////////////////////////////////////

/* Canonical source: a cut commits the choose around it to its branch.
   The meaning is the cut that runs in form/form-stdlib/engine.fk: a fail
   after the cut in the same branch fails the whole choose, and the branches
   after it are never tried; a fail before the cut still falls through to the
   next branch; the cut's scope is its own choose, never the caller's.
   Before fails ahead of its cut and falls through: 2. Kept succeeds past its
   cut: 10. After fails past its cut, so its choose fails without trying
   x = 3, and After fails; Guard's own choose, which After's cut never
   reached, catches that and answers 100.
   2 + 10 + 100 = 112.
   Answer: 112. */

int Before() { int x = 1; choose { fail; cut; x = 10; } , { x = 2; } return x; }
int Kept() { int x = 1; choose { cut; x = 10; } , { x = 4; } return x; }
int After() { int x = 1; choose { cut; x = 10; fail; } , { x = 3; } return x; }
int Guard() { int r = 0; choose { r = After(); } , { r = 100; } return r; }
return Before() + Kept() + Guard();
