// Canonical source: a.b.c = e; stores into the last field of what the path
// before it reads. At top level q.p.v = 5 stores 5; in a member this.p.v = a
// stores 7 and reads this.p.v back link by link; through a parameter 9.
// Answer: 21 (5 + 7 + 9).
class P : Object { section [public] { int v; } }
class Q : Object { section [public] { P p;
  Q() { this.p = new P(); }
  int Set(int a) { this.p.v = a; return this.p.v; } } }
int G(Q q, int a) { q.p.v = a; return q.p.v; }
Q q = new Q();
q.p.v = 5;
int top = q.p.v;
return top + new Q().Set(7) + G(new Q(), 9);
