// Canonical source for interface-method-dispatch-lowering on the BML native lane.
// Units: ../../bml/bmf-bml-compiler-picture.bml
// CompilerTrace comes from its home unit, package BML.compiler, which this
// source names on its Units line and imports; a live run links that unit and
// heals the imports it leaves open (BMF from the thesis grammar, BML.lang from
// form/form-stdlib/bml/bml-lang.bml). Two classes implement it; Describe and
// Count call through a CompilerTrace parameter; Bob takes Greeter's default
// Hello; DeepTrace reaches CompilerTrace through Traced.
// Answer on both lanes: "parse".
import BML.compiler.*;
class LexTrace : Object, CompilerTrace { section [public] { String Name() { return "lex"; } String Summary() { return "tokens"; } bool Verified() { return 1; } } }
class ParseTrace : Object, CompilerTrace { section [public] { String Name() { return "parse"; } String Summary() { return "tree"; } bool Verified() { return 0; } } }
interface Greeter { section [public] { String Hello() { return "hi"; } String Name(); } }
class Bob : Object, Greeter { section [public] { String Name() { return "bob"; } } }
interface Traced : CompilerTrace { section [public] { int Depth(); } }
class DeepTrace : Object, Traced { section [public] { String Name() { return "deep"; } String Summary() { return "d"; } bool Verified() { return 1; } int Depth() { return 3; } } }
String Describe(CompilerTrace t) { return t.Name(); }
int Count(CompilerTrace t) { return t.Verified(); }
return Describe(new ParseTrace());
