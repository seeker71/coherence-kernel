// Loops over a receiver's fields: a while whose condition re-reads a field
// each pass (from zero and from past its bound), a labeled continue that
// skips a field update, and a for that sums into a field.
// Answer: 80
// (Count() from 0 = 5 and then N() = 5, Count() from 9 = 9, Tally() = 6, Sum() = 55)
class Counter : Object { section [public] { int n; int m; int total;
  Counter(int s) { this.n = s; }
  int Count() { while (this.n < 5) { this.n = this.n + 1; } return this.n; }
  int Tally() { outer: while (this.n < 10) { this.n = this.n + 1; if (this.n < 5) continue outer; this.m = this.m + 1; } return this.m; }
  int Sum() { for (int i = 1; i <= 10; i++) { this.total = this.total + i; } return this.total; }
  int N() { return this.n; } } }
int Run() { Counter a = new Counter(0); int c = a.Count(); return c + a.N() + new Counter(9).Count() + new Counter(0).Tally() + new Counter(0).Sum(); }
return Run();
