; trivial-typed-leaf-band.fk — the typed trivial leaves the four kernels carry
; natively, proven in isolation so a primitive regression points here first.
;
; preludes: form-stdlib/core.fk
;
; intern_trivial_bool interns a TrivBool leaf (type 3) whose inst is the bit;
; intern_trivial_float parses its source text into a boxed f64 leaf (type 7).
; node_value reads each leaf's stored value back. int_to_str is int-only by
; design (core.fk:152's header note; its float native was retired
; 2026-07-01) — a bool leaf renders through node_eq identity against the
; well-known (intern_trivial_bool true) node, and a float leaf renders
; through float_to_str, exactly the dispatch json.fk's json-emit-leaf uses
; per node_type. The verdict lights one bit per claim:
;   node_type bool is 3                       → 1
;   node_inst true is 1                       → 10
;   node_inst false is 0                      → 100
;   true leaf identity-dispatches to "true"   → 1000
;   false leaf identity-dispatches to "false" → 10000
;   node_type float is 7                      → 100000
;   float_to_str renders 0.5 as "0.5"         → 1000000
(do
    (let bt (intern_trivial_bool true))
    (let bf (intern_trivial_bool false))
    (let ff (intern_trivial_float "0.5"))
    (defn render-bool (n) (if (node_eq n (intern_trivial_bool true)) "true" "false"))
    (add (mul (if (eq (node_type bt) 3) 1 0) 1)
    (add (mul (if (eq (node_inst bt) 1) 1 0) 10)
    (add (mul (if (eq (node_inst bf) 0) 1 0) 100)
    (add (mul (if (str_eq (render-bool bt) "true") 1 0) 1000)
    (add (mul (if (str_eq (render-bool bf) "false") 1 0) 10000)
    (add (mul (if (eq (node_type ff) 7) 1 0) 100000)
         (mul (if (str_eq (float_to_str (node_value ff)) "0.5") 1 0) 1000000))))))))
