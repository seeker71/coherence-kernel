; loop-lane-hof-band.fk -- the core higher-order recipes crystallize: map, filter, foldl call through a function value.
;
; map, filter, foldl, any?, all? each take a FUNCTION as a parameter and call through it -- (f (head xs) ...),
; (pred (head xs)). That call-through-a-value is the loop lane's tag-244 door, and these loops carry it: a bare defn
; passed as the function (map dbl xs) crystallizes to a native loop that calls the defn's page each step. So the core
; functional floor -- the shape a functional stdlib is built on -- is warm, not just the first-order list loops.
; (This band pins that: an earlier survey mis-read them as declining; they do not.)
;
; Verdict 7
; PROOF LEVEL: FOURTH-ARM ONLY (crystallization is fkwu's MAP_JIT lane; a defn's native state is the 8th hot-row field)
; preludes: form-stdlib/core.fk
;
;   1   the core HOFs -- map-onto, foldl, filter-onto -- each read a crystallized state (2, a native loop through the function param)
;   2   they answer correctly through the passed function: map doubles, filter keeps evens, foldl sums
;   4   a map that calls its function param, warm, runs under a walker twin of the same work
(do
    (defn hof-bit (ok bit) (if ok bit 0))
    (defn hof-state (name rows) (if (eq (len rows) 0) -99 (if (str_eq (nth (head rows) 1) name) (nth (head rows) 7) (hof-state name (tail rows)))))
    (defn dbl (x) (mul x 2))
    (defn evn (x) (eq (mod x 2) 0))
    (defn addup (a b) (add a b))
    ; a map over a function param, and a poisoned twin (a host clock the lane declines) that walks the same work
    (defn mmap (f xs acc) (if (nil? xs) acc (mmap f (tail xs) (cons (f (head xs)) acc))))
    (defn mmapw (f xs acc) (if (lt (host_monotonic_ms) 0) acc (if (nil? xs) acc (mmapw f (tail xs) (cons (f (head xs)) acc)))))
    (defn hm (xs n acc) (if (le n 0) acc (hm xs (sub n 1) (add acc (len (mmap dbl xs (list)))))))
    (defn hmw (xs n acc) (if (le n 0) acc (hmw xs (sub n 1) (add acc (len (mmapw dbl xs (list)))))))
    ; heat the REAL core HOFs too, to pin their state
    (defn hr (xs n acc) (if (le n 0) acc (hr xs (sub n 1) (add acc (add (len (map dbl xs)) (add (foldl addup 0 xs) (len (filter evn xs))))))))
    (let L (range 1 20))
    (let heat (add (hm L 6000 0) (hr L 6000 0)))
    (let rows (kernel_page_hot (host_pid) 400))
    (let cryst-ok (if (eq (hof-state "mmap" rows) 2) (if (eq (hof-state "map-onto" rows) 2) (if (eq (hof-state "foldl" rows) 2) (eq (hof-state "filter-onto" rows) 2) false) false) false))
    ; correct through the passed function (range a b is [a, b-1], end-exclusive)
    (let ans-ok (if (eq (foldl addup 0 (map dbl (range 1 5))) 20)          ; dbl(1,2,3,4)=2,4,6,8 -> 20
                    (if (eq (len (filter evn (range 1 10))) 4)             ; evens of 1..9 -> 2,4,6,8 -> 4
                        (eq (foldl addup 0 (range 1 101)) 5050) false) false))  ; sum 1..100 -> 5050
    ; warm vs walker: the SAME map work, native loop (mmap) vs the poisoned twin (mmapw)
    (let w0 (host_monotonic_ms)) (let warm (hm L 40000 0)) (let w1 (host_monotonic_ms))
    (let k0 (host_monotonic_ms)) (let cold (hmw L 40000 0)) (let k1 (host_monotonic_ms))
    (let fast-ok (if (eq warm cold) (lt (sub w1 w0) (sub k1 k0)) false))
    (let told (print (list "mmap" (hof-state "mmap" rows) "map-onto" (hof-state "map-onto" rows) "foldl" (hof-state "foldl" rows) "filter-onto" (hof-state "filter-onto" rows) "cryst" cryst-ok "ans" ans-ok "fast" fast-ok "ms" (sub w1 w0) (sub k1 k0))))
    (add (hof-bit cryst-ok 1) (add (hof-bit (if cryst-ok ans-ok false) 2) (hof-bit fast-ok 4))))
