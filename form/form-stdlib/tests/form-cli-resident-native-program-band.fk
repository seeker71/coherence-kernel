; form-cli-resident-native-program-band.fk -- high-grammar BML -> scannerless
; BMF module -> one resident NodeID -> repeated native calls. Expected: 255
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-resident-native-program.fk

(do
    (defn fcrnpb-bit (held weight) (if held weight 0))
    (defn form-cli-resident-native-program-band ()
        (do
            (let opened (frpce-empty))
            (let loaded (fcrnp-load opened))
            (let none (fcrnp-invoke loaded 0))
            (let one (fcrnp-invoke loaded 1))
            (let value (fcrnp-invoke loaded 41))
            (add
                (fcrnpb-bit (and
                    (str_eq (fcrnp-loaded-status loaded) "returned")
                    (not (nothing? (fcrnp-loaded-identity loaded)))) 1)
            (add
                (fcrnpb-bit (and
                    (str_eq (fcrnp-compile-status
                        (fcrnp-loaded-compile loaded)) "value")
                    (str_eq (fcrnp-compile-reason
                        (fcrnp-loaded-compile loaded))
                        "bmf-module-lowered-to-resident-source")) 2)
            (add
                (fcrnpb-bit (and (nothing? (fcrnp-invocation-value none))
                    (eq (frpce-receipt-output
                        (fcrnp-invocation-receipt none)) 1)) 4)
            (add
                (fcrnpb-bit (and (str_eq (fcrnp-invocation-signal none) "nothing")
                    (str_eq (fcrnp-invocation-signal one) "one")) 8)
            (add
                (fcrnpb-bit (and (eq (fcrnp-invocation-value one) 1)
                    (eq (fcrnp-invocation-value value) 42)) 16)
            (add
                (fcrnpb-bit (and
                    (node_eq (fcrnp-loaded-identity loaded)
                        (frpce-receipt-identity
                            (fcrnp-invocation-receipt value)))
                    (str_eq (fcrnp-invocation-reason value)
                        "recipe-node-invoked")) 32)
            (add
                (fcrnpb-bit (and
                    (str_eq (fcrnp-invocation-route value)
                        "resident-native-program")
                    (eq (fcrnp-invocation-model-executed value) 0)) 64)
                (fcrnpb-bit (and (eq (fcrnp-invocation-host-crossings value) 0)
                    (not (eq (fcrnp-invocation-value none)
                        (fcrnp-invocation-value one)))) 128))))))))))
    (form-cli-resident-native-program-band))
