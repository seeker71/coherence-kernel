; form-cli-peer-live-framebuffer-band.fk -- BML frame content is lifecycle-only.
; preludes: form-stdlib/bml/form-cli-peer-live-framebuffer.bml

(do
    (framebuffer-clear)
    (let prefill (fcplf-outbound 0 "prefill-ready" "ready"))
    (let setup (fcplf-record 0 "resident-setup" "ready"))
    (let start (fcplf-record 7 "task-begin" "ready"))
    (let end (fcplf-record 7 "task-terminal" "failure"))
    (sum (list
        (if (str_eq (fcplf-rule)
                     "resident-peer-emits-opaque-lifecycle-frames-in-native-framebuffer") 1 0)
        (if (str_eq (fcplf-privacy-rule)
                     "opaque-lifecycle-no-task-or-answer-bytes") 2 0)
        (if (eq (bfc-direction prefill) 0) 4 0)
        (if (eq (bfc-kind prefill) 0) 8 0)
        (if (eq (bfc-exchange prefill) 5) 16 0)
        (if (eq (nth (bfc-payload prefill) 0) 0) 32 0)
        (if (eq (nth (bfc-payload prefill) 1) 5) 64 0)
        (if (str_eq (nth (bfc-payload prefill) 2) "ready") 128 0)
        (if (eq (len (framebuffer-events)) 3) 256 0)
        (if (eq (fcplf-stage-code "resident-setup") 4) 512 0)
        (if (and (eq (fcplf-stage-known? "not-a-stage") 0)
                 (nothing? (fcplf-outbound 0 "not-a-stage" "none"))) 1024 0)
        (if (and (str_eq (fcplf-stage-name 5) "prefill-ready")
                 (nothing? (fcplf-stage-name 0))) 2048 0))))
