; form-cli-peer-live-framebuffer-band.fk -- frame content is lifecycle-only.
; preludes: form-stdlib/form-cli-peer-live-framebuffer.fk

(do
    (framebuffer-clear)
    (let prefill (fcplf-outbound 0 "prefill-ready" "ready"))
    (let start (fcplf-record 7 "task-begin" "ready"))
    (let end (fcplf-record 7 "task-terminal" "failure"))
    (if (and (str_eq (fcplf-rule)
                     "resident-peer-emits-opaque-lifecycle-frames-in-native-framebuffer")
             (and (str_eq (fcplf-privacy-rule)
                          "opaque-lifecycle-no-task-or-answer-bytes")
             (and (eq (bfc-direction prefill) 0)
             (and (eq (bfc-kind prefill) 0)
             (and (eq (bfc-exchange prefill) 1)
             (and (eq (nth (bfc-payload prefill) 0) 0)
             (and (eq (nth (bfc-payload prefill) 1) 1)
             (and (str_eq (nth (bfc-payload prefill) 2) "ready")
                  (eq (len (framebuffer-events)) 2))))))))) 511 0))
