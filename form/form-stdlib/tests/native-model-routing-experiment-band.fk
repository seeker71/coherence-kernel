; native-model-routing-experiment-band.fk — fixed-corpus policy replay and
; separation from physical local-model observations.
;
; preludes: form-stdlib/core.fk form-stdlib/native-model-control-plane.fk form-stdlib/native-model-control-plane-eval.fk form-stdlib/form-teach-layer.fk form-stdlib/native-model-form-token-envelope.bml form-stdlib/native-model-routing-experiment.bml
;
; Verdict 1023: 511 executable + 512 high-BML authority.

(do
    (defn nmreb-has (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let cases (nmre-cases))
    (let baseline-exact (nmre-exact-plans (NMREBaseline) cases))
    (let native-exact (nmre-exact-plans (NMRENativeOnly) cases))
    (let capability-exact (nmre-exact-plans (NMRECapability) cases))
    (let c0 (if (eq (len cases) 7) 1 0))
    (let c1 (if (and (lt baseline-exact capability-exact) (lt native-exact capability-exact)) 2 0))
    (let c2 (if (eq capability-exact 7) 4 0))
    (let c3 (if (and (eq (nmre-threeb-opens (NMRECapability) cases) 2) (eq (nmre-qwen-opens (NMRECapability) cases) 1)) 8 0))
    (let c4 (if (lt (nmre-cost (NMRECapability) cases) (nmre-cost (NMREBaseline) cases)) 16 0))
    (let c5 (if (str_eq (nmre-champion) (NMRECapability)) 32 0))
    (let c6 (if (and (eq (len (nmre-physical-baseline)) 2) (and (eq (len (nmre-physical-after)) 3) (eq (nmre-local-envelope-covered?) 1))) 64 0))
    (let report (nmre-report))
    (let c7 (if (and (eq (nmreb-has report "physical_and_replay_separate=1") 1) (eq (nmreb-has report "champion=capability-aware") 1)) 128 0))
    (let unsafe (nth cases 4))
    (let c8 (if (str_eq (nmre-route (NMRECapability) unsafe) "3b-native-reject") 256 0))
    (let base (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8)))
    (let src (read_file "form/form-stdlib/bml/native-model-routing-experiment.bml"))
    (let authority
        (if (eq (nmreb-has src "const String ReplayRule = \"policy replay uses fixed case facts and never impersonates a model run\"") 1)
            (if (eq (nmreb-has src "const String PhysicalRule = \"physical observations retain model, prompt contract, cap, latency, normalized egress admission, and applied rejection result\"") 1)
                (if (eq (nmreb-has src "const String SelectionRule = \"known deterministic grammar stays native; 3B proposes unknown NL-to-Form; Qwen follows only explicit native inability\"") 1)
                    (if (eq (nmreb-has src "const String TokenRule = \"every selected local lane must be prompt-admitted or native-admitted by the shared Form token envelope\"") 1) 512 0) 0) 0) 0))
    (add base authority))
