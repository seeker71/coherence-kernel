; preludes: form/form-stdlib/bml/number.bml
; Expected: 255
; PROOF LEVEL: FKWU-STAGED — it preludes a .bml. The printer it exercises lives in core.fk and
; IS four-way; the vocabulary around it is BML and lowers.
;
; number-band — the body's numbers, named once and honest at every magnitude.
;
; Two wounds, one family. The kernel names float_to_int and does not name its inverse, so nobody
; wrote down that arithmetic already promotes — add(n, 0.0) has always been a float. Fifteen sites
; across fifteen files each round-trip an int through a DECIMAL STRING instead, under nine private
; names (corpus row 1419 ninenames). And float_to_str scaled by 10^6 before it could round, so it
; overflowed an int64 past 9.223e12 and did not refuse: 9000000000000.0 printed as
; "-223372036854.-775808", a positive number rendered negative with a negative fraction, and 1e20
; as "0.0000-1" (corpus row 1418 printpast). Nine trillion is nine terabytes counted in bytes.
;
; Verdict 255:
;   1   the promotion is a float and not an int — to-float(7)/2 is 3.5 where 7/2 is 3
;   2   it agrees exactly with the decimal round-trip it replaces, positive, negative and large
;   4   to-float and to-int are inverses on whole values, and named beside each other
;   8   the printer is honest at 9e12, where it used to render a positive number negative
;   16  and at 1e20, where it used to answer "0.0000-1"
;   32  the whole-number band renders exactly and the scientific band carries its exponent
;   64  rounding goes half-away-from-zero on both signs, which float_to_int alone does not do
;   128 the units a lens stands on: mib, gb, and the floor a rate puts under a size
(do
    (let n 1270185856)
    (let c0 (if (and (eq (div (to-float 7) 2) 3.5) (eq (div 7 2) 3)) 1 0))
    (let c1 (if (and (eq (to-float n) (str_to_float (int_to_str n)))
                (and (eq (to-float (sub 0 12345)) (str_to_float (int_to_str (sub 0 12345))))
                     (eq (to-float 9007199254740992) (str_to_float (int_to_str 9007199254740992))))) 2 0))
    (let c2 (if (and (eq (to-int (to-float n)) n) (eq (to-int 3.0) 3)) 4 0))
    (let c3 (if (and (str_eq (float_to_str 9000000000000.0) "9000000000000")
                     (str_eq (float_to_str (sub 0.0 9000000000000.0)) "-9000000000000")) 8 0))
    (let c4 (if (and (str_eq (float_to_str 1.0e20) "1e20") (str_eq (float_to_str 1.0e300) "1e300")) 16 0))
    (let c5 (if (and (str_eq (float_to_str 10000000000000.0) "10000000000000")
                     (str_eq (float_to_str 9223372036854775000.0) "9.223372e18")) 32 0))
    (let c6 (if (and (and (eq (to-int-near 2.6) 3) (eq (to-int-near (sub 0.0 2.6)) (sub 0 3)))
                     (and (eq (two-dp 2.345) 2.35) (eq (two-dp (sub 0.0 2.345)) (sub 0.0 2.35)))) 64 0))
    ; the floor turbo's encoder cannot beat at the 388.52 GB/s this Mac measured on 2026-09-09
    (let c7 (if (and (eq (two-dp (mib n)) 1211.34) (eq (two-dp (floor-ms n 388.52)) 3.27)) 128 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
