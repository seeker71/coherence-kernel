; form-token-usage-band.bml — the Form tokens in use read kind by kind, from two evaluation rows the body holds.
;
; preludes: form-stdlib/bml/form-token-usage.bml
; REQUIRES: nothing opened; receipts/form-token-eval.jsonl and learn/form-token-traces.jsonl are read
;
; The two rows are facts of the repository: the 2026-10-02 row (the lora arm after 100 rounds on the first corpus, 64
; questions) and the 2026-10-09 row (the lora arm wearing generation 50 of the rebalanced corpus, 72 questions). The
; meter must read from them what was read by hand: that the second voice wrote recipe-exec not at all where nine were
; expected and node-select three times over, and that it used more kinds, effectively, than the first.
;
; Verdict 31 when every claim lands:
;   1     the newer row: recipe-exec expected 9 and written 0 read under-written; node-select expected 5 and written 15
;         read over-written
;   2     diversity: the newer row writes 8 of 9 kinds effectively 4.40, the older 3.84 (hundredths 440 and 384)
;   4     the older row wrote exactly the kinds its held-out traces expected, in every kind (no advice at all)
;   8     the advice for the newer row names recipe-exec, node-select and recipe-import and nothing else
;   16    taught is the train split: its controls per kind add up to the verbs of the corpus rows that are not held out
section [form.bml] {
 class FormTokenUsageBand {
  def ftub-bit(ok, bit) = ok ? bit : 0;
  def ftub-old() = 1790897633574;
  def ftub-new() = 1791537948224;
  def ftub-got(row, corpus) = fu-written(fu-arm(row, "lora"));
  def ftub-exp(row, corpus) = fu-expected(fu-arm(row, "lora"), corpus);
  def ftub-score() {
   let rows = fu-rows();
   let corpus = fu-corpus();
   let old = fu-row-at(rows, ftub-old());
   let new = fu-row-at(rows, ftub-new());
   let eo = ftub-exp(old, corpus); let go = ftub-got(old, corpus);
   let en = ftub-exp(new, corpus); let gn = ftub-got(new, corpus);
   let advice = fu-advice(en, gn);
   let taught = fu-taught(corpus);
   ftub-bit(fu-count(en, "recipe-exec") == 9 && fu-count(gn, "recipe-exec") == 0 && fu-verdict(9, 0) == "under-written" && fu-count(en, "node-select") == 5 && fu-count(gn, "node-select") == 15 && fu-verdict(5, 15) == "over-written", 1)
     + ftub-bit(fu-kinds-used(gn) == 8 && fu-effective(gn) == 440 && fu-effective(go) == 384, 2)
     + ftub-bit(all?(k => fu-count(eo, k) == fu-count(go, k), ftk-verbs()) && len(fu-advice(eo, go)) == 0, 4)
     + ftub-bit(len(advice) == 3 && any?(l => str_find(l, "advise recipe-exec", 0) >= 0, advice) && any?(l => str_find(l, "advise node-select", 0) >= 0, advice) && any?(l => str_find(l, "advise recipe-import", 0) >= 0, advice), 8)
     + ftub-bit(foldl((acc, k) => acc + fu-count(taught, k), 0, ftk-verbs()) == len(taught), 16);
  }
 }
 ftub-score();
}
