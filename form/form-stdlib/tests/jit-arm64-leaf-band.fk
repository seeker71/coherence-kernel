; jit-arm64-leaf-band.fk — the native ARM64 door, its declared domain, and the
; crystallization that makes it worth taking.
;
; THE DOOR. `(jit_arm64_u32_leaf program root arg)` hands the carrier an SSA
; program as a list of rows and gets back the value of `root` with `arg` bound:
;   (2)        the argument            (1 k)      a literal, k <= 65535
;   (3 a b)    add        (4 a b) sub        (5 a b) mul     — a,b earlier rows
; Anything else is declined, which is the door's whole safety: an uncovered shape
; answers `nothing` and the caller walks instead. Tags 1..5 today; the ladder to
; the rest of the language is coverage, not redesign.
;
; ITS DOMAIN IS IN ITS NAME. u32. `sub` below zero wraps: 0-4 is 4294967292, not
; -4, and a recipe whose value crosses 2^32 diverges from the walker BY DESIGN.
; That boundary is asserted here rather than discovered later — the first bench
; written against this door crossed it and read as a correctness bug for a while,
; and 44 mismatches over 1..299 turned out to be exactly the 44 overflows.
;
; WHY IT IS NOW WORTH TAKING. The door used to mmap a page, run it, and unmap it
; on EVERY call: 400,000 calls of a nine-node recipe cost 1,372 ms against the
; walker's 15 ms. The carrier now keeps what it built, keyed on the PARSED
; program (never on the cons value — the collector moves those), with a value
; hint guarded by a melt generation for the hot repeat. Same machine, same
; recipe, same 400,000 calls: 1,372 -> 18 -> 6 ms, against the walker's 15-16 ms.
; The JIT stopped being a slower interpreter with extra steps.
;
; PROOF LEVEL: FOURTH-ARM ONLY — jit_arm64_u32_leaf is a runtime-fkwu door (pf-arm-mask 8, probed 2026-09-03). The
; Go, Rust and TypeScript siblings do not bind the name, so under them every
; claim here would fold over `nothing` and read green while proving nothing. It
; runs on its home arm and says so, rather than borrowing three arms it has not
; earned.
;
; Verdict 63.
;
; preludes: form-stdlib/core.fk

(do
    (defn jab-score (ok bit) (if ok bit 0))
    (defn jab-add7 () (list (list 2) (list 1 7) (list 3 0 1)))
    (defn jab-poly () (list (list 2) (list 5 0 0) (list 1 3) (list 3 1 2) (list 5 3 0)
                            (list 1 7) (list 4 4 5) (list 5 6 0) (list 1 11) (list 3 7 8)))
    (defn jab-f (x) (add (mul (sub (mul (add (mul x x) 3) x) 7) x) 11))
    (defn jab-agree (i n bad)
        (if (ge i n) bad
            (jab-agree (add i 1) n
                (add bad (if (eq (jit_arm64_u32_leaf (jab-poly) 9 i) (jab-f i)) 0 1)))))
    ; two programs alternating displaces the value hint on every single call, so a
    ; hint that ever answered for the wrong program would show here
    (defn jab-alt (i n bad)
        (if (ge i n) bad
            (jab-alt (add i 1) n
                (add bad (add (if (eq (jit_arm64_u32_leaf (jab-poly) 9 i) (jab-f i)) 0 1)
                              (if (eq (jit_arm64_u32_leaf (jab-add7) 2 i) (add i 7)) 0 1))))))
    (defn jit-arm64-leaf-band ()
        (do
    ; the door is REACHABLE from Form — the row it lost to a manifest regen is back
    (let c0 (jab-score (eq (jit_arm64_u32_leaf (jab-add7) 2 35) 42) 1))
    ; a deeper recipe agrees with the walker on a single point
    (let c1 (jab-score (eq (jit_arm64_u32_leaf (jab-poly) 9 5) 676) 2))
    ; and agrees across its whole declared domain, 1..255 for this recipe
    (let c2 (jab-score (eq (jab-agree 1 256 0) 0) 4))
    ; the u32 boundary is REAL and named: 0-4 wraps rather than going negative
    (let c3 (jab-score (eq (jit_arm64_u32_leaf (list (list 2) (list 1 4) (list 4 0 1)) 2 0)
                           4294967292) 8))
    ; an uncovered shape is DECLINED, not guessed (tag 6 is not in the door)
    (let c4 (jab-score (nothing? (jit_arm64_u32_leaf (list (list 2) (list 6 0 0)) 1 3)) 16))
    ; the cache never answers for the wrong program, however hard the hint is displaced
    (let c5 (jab-score (eq (jab-alt 1 128 0) 0) 32))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
    )
    (jit-arm64-leaf-band))
