; living-world-composite-recipe-field-band.fk -- recurrent behavior composes
; every compatible native Recipe surface without choosing a representative.
; Verdict 32767 proves fifteen field, plurality, evidence, and scope claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk form-stdlib/living-world-operation-field.fk form-stdlib/living-world-composite-recipe.fk form-stdlib/living-world-composite-answer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-structural-recipe-witness.fk form-stdlib/tests/living-world-operation-field-witness.fk form-stdlib/tests/living-world-composite-recipe-witness.fk

(defn lwoecfb-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwoecfb-sum (tail items)))))

(do
    (let evolved (lwoew-build-evolved))
    (let schema (lwoew-base-schema (lwoew-evolved-base evolved)))
    (let component (lwoew-evolved-candidate evolved))
    (let blueprint (lwoecw-blueprint component schema))
    (let other (lwoecw-other-blueprint component schema))
    (let world (lwoecw-blueprint-world evolved))
    (let field (lwoec-field-for world blueprint 2))
    (let profiles (lwoec-field-profiles field))
    (let first (nth (lwo-field-items profiles) 0))
    (let second (nth (lwo-field-items profiles) 1))
    (let first-surface (lwoec-profile-surface first))
    (let second-surface (lwoec-profile-surface second))
    (let first-recipe (lwoec-surface-recipe first-surface))
    (let second-recipe (lwoec-surface-recipe second-surface))
    (let first-trials (lwoec-profile-trials first))
    (let second-trials (lwoec-profile-trials second))
    (let first-trial (head (lwo-field-items first-trials)))
    (let second-trial (head (lwo-field-items second-trials)))
    (let class (head (lwo-field-items (lwoec-field-classes field))))
    (let witnesses (lwoec-field-witness-field field))
    (let sources
        (lwt-sources-from-attributions
            (lwo-field-items witnesses) (lwo-empty-field)))

    (let c1
        (if (and (eq (lwoec-blueprint-valid? blueprint) 1)
                 (eq (lwoec-field? field) 1)) 1 0))
    (let c2
        (if (and (eq (lwo-field-size
                         (lwoec-field-examples field)) 1)
                 (eq (lwoec-field-threshold field) 2)) 2 0))
    (let c3
        (if (and (eq (lwo-field-size profiles) 2)
                 (eq (lwo-field-size
                         (lwoec-field-compatible field)) 2)) 4 0))
    (let c4
        (if (and (eq (lwo-field-size
                         (lwoec-field-contradicted field)) 0)
                 (eq (lwo-field-size
                         (lwoec-field-unresolved field)) 0)) 8 0))
    (let c5
        (if (and (eq (lwo-field-size
                         (lwoec-field-classes field)) 1)
                 (eq (lwo-field-size
                         (lwoec-class-profiles class)) 2)) 16 0))
    (let c6
        (if (eq (lwph-singular? (lwoec-field-status field)) 1) 32 0))
    (let c7
        (if (and (eq (lwoec-surface-valid? first-surface) 1)
                 (and (eq (lwoec-surface-valid? second-surface) 1)
                      (and (eq (lwph-consistent?
                                  (lwoec-profile-state first)) 1)
                           (eq (lwph-consistent?
                                  (lwoec-profile-state second)) 1)))) 64 0))
    (let c8
        (if (or
                (and (str_eq (lwre-recipe-source first-recipe)
                             "(add (add r s) s)")
                     (str_eq (lwre-recipe-source second-recipe)
                             "(add s (add s r))"))
                (and (str_eq (lwre-recipe-source first-recipe)
                             "(add s (add s r))")
                     (str_eq (lwre-recipe-source second-recipe)
                             "(add (add r s) s)"))) 128 0))
    (let c9
        (if (and (eq (lwre-recipe-valid? first-recipe) 1)
                 (and (eq (lwre-recipe-valid? second-recipe) 1)
                      (not (node_eq first-recipe second-recipe)))) 256 0))
    (let c10
        (if (and (eq (lwo-field-size first-trials) 1)
                 (and (eq (lwo-field-size second-trials) 1)
                      (and (eq (node_value
                                  (lwoec-trial-output first-trial)) 11)
                           (eq (node_value
                                  (lwoec-trial-output second-trial)) 11))))
            512 0))
    (let c11
        (if (and (gt (lwo-field-size
                         (lwoec-field-alternatives field)) 0)
                 (gt (lwo-field-size
                         (lwoec-field-unknowns field)) 0)) 1024 0))
    (let c12
        (if (and (gt (lwo-field-size
                         (lwoec-class-alternatives class)) 0)
                 (gt (lwo-field-size
                         (lwoec-class-unknowns class)) 0)) 2048 0))
    (let c13
        (if (and (eq (lwo-field-size witnesses) 181)
                 (eq (lwo-field-size sources) 18)) 4096 0))
    (let c14
        (if (and (eq (lwo-active? world first-recipe) 0)
                 (eq (lwo-active? world second-recipe) 0)) 8192 0))
    (let c15
        (if (and (eq (lwoec-blueprint-valid? other) 1)
                 (and (eq (lwph-active-source-count world other) 1)
                      (eq (lwoec-blueprint-current? world other 2) 0)))
            16384 0))
    (lwoecfb-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
