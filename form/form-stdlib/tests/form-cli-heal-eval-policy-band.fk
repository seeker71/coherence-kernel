; Expected 511. Evaluation contracts without living state writes.
; witnessed: 2026-09-07 -> 511, four kernels
; preludes: form-stdlib/bml/form-cli-heal-eval-policy.bml
(do
 (let rows (fhe-cases))
 (add (if (eq (len rows) 6) 1 0)
 (add (if (and (fhe-request (list "eval")) (fhe-request (list "eval" "native" "qwen" "positive-boundary"))) 2 0)
 (add (if (and (eq (fhe-request (list "eval" "remote" "qwen" "positive-boundary")) 0) (eq (fhe-request (list "eval" "native" "qwen" "missing")) 0)) 4 0)
 (add (if (str_eq (fhe-outcome "repair" 1 1 0) "invalid-case") 8 0)
 (add (if (and (str_eq (fhe-outcome "repair" 0 1 0) "repaired") (str_eq (fhe-outcome "repair" 0 0 1) "unresolved")) 16 0)
 (add (if (and (str_eq (fhe-outcome "control" 1 0 1) "preserved") (str_eq (fhe-outcome "control" 1 1 0) "regression")) 32 0)
 (add (if (and (fhe-memory-allowed 0) (eq (fhe-memory-allowed 1) 0)) 64 0)
 (add (if (eq (json-array-length (json-object-get (parse-json "evaluation" (fhe-manifest)) "cases")) 6) 128 0)
      (if (and (fhe-baseline-admissible "semantic" "0" 1)
           (and (eq (fhe-baseline-admissible "semantic" "1" 1) 0)
                (eq (fhe-baseline-admissible "semantic" "0" 0) 0))) 256 0))))))))))
