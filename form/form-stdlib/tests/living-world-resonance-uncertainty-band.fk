; living-world-resonance-uncertainty-band.fk -- ambiguity stays visible.
;
; Verdict 127 proves seven uncertainty boundaries:
;   1   a duplicate source value produces an ambiguous target term
;   2   the ambiguous signature is not transfer-valid
;   4   ambiguity cannot produce a mapping proposal
;   8   a lossy but unambiguous lens retains its slot and constant
;   16  the lossy lens may become a proposal when its holder is affected
;   32  unused source structure remains explicit uncertainty
;   64  a constant-only coincidence is not structural resonance
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/tests/living-world-resonance-witness.fk

(defn lwrub-round (correspondence)
    (lwr-tend (lwo-empty-world)
        (list (lwrw-entry (lwrw-source-a) correspondence
                          (lwrw-provenance-a)))
        1 (lwo-none)))

(do
    (let source-kind (bp "LWRUB-SOURCE"))
    (let target-kind (bp "LWRUB-TARGET"))
    (let x (intern_trivial_string "lwrub-x"))
    (let y (intern_trivial_string "lwrub-y"))
    (let fixed (intern_trivial_string "lwrub-fixed"))

    (let ambiguous-source (lwo-compose source-kind (list x x)))
    (let ambiguous-target (lwo-compose target-kind (list x)))
    (let ambiguous-correspondence
        (lwr-correspondence ambiguous-source ambiguous-target))
    (let ambiguous-signature
        (lwr-signature-for ambiguous-correspondence))
    (let ambiguous-term
        (head (lwr-template-items
            (lwr-signature-template ambiguous-signature))))
    (let c1 (if (and (eq (lwr-ambiguous? ambiguous-term) 1)
                         (eq (lwo-field-size
                              (nth (node_children ambiguous-term) 1)) 2)) 1 0))
    (let c2 (if (eq (lwr-signature-valid? ambiguous-signature) 0) 2 0))
    (let ambiguous-round (lwrub-round ambiguous-correspondence))
    (let c3 (if (eq (lwo-field-size
                         (lwt-round-proposals ambiguous-round)) 0) 4 0))

    (let lossy-source (lwo-compose source-kind (list x y)))
    (let lossy-target (lwo-compose target-kind (list x fixed)))
    (let lossy-correspondence
        (lwr-correspondence lossy-source lossy-target))
    (let lossy-signature (lwr-signature-for lossy-correspondence))
    (let lossy-terms
        (lwr-template-items (lwr-signature-template lossy-signature)))
    (let c4 (if (and (eq (lwr-slot? (nth lossy-terms 0)) 1)
                         (eq (lwr-constant? (nth lossy-terms 1)) 1)) 8 0))
    (let lossy-round (lwrub-round lossy-correspondence))
    (let lossy-proposal (lwrw-first-proposal lossy-round))
    (let lossy-mapping
        (lwo-emergent-shape (lwrw-candidate lossy-proposal)))
    (let c5 (if (eq (lwo-field-size
                         (lwt-round-proposals lossy-round)) 1) 16 0))
    (let c6 (if (eq (lwr-uncertainty-unused-source
                         (lwr-mapping-uncertainty lossy-mapping)) 1) 32 0))

    (let constant-source
        (lwo-compose source-kind
            (list (intern_trivial_string "lwrub-unshared"))))
    (let constant-target (lwo-compose target-kind (list fixed)))
    (let constant-correspondence
        (lwr-correspondence constant-source constant-target))
    (let constant-round (lwrub-round constant-correspondence))
    (let c7 (if (and (eq (lwr-signature-valid?
                              (lwr-signature-for constant-correspondence)) 0)
                         (eq (lwo-field-size
                              (lwt-round-proposals constant-round)) 0)) 64 0))

    (lwrw-sum (list c1 c2 c3 c4 c5 c6 c7)))
