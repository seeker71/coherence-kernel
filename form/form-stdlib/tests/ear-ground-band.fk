; ear-ground-band.fk — the ground under the ear, proven where it can be proven.
;
; PURE: no microphone, no model, no gift frame. A band that stood a resident would
; measure a world it had disturbed (bandstain, corpus row 1193), so this proves the
; three things the ground DECIDES — which delays it judges furniture, when a line is
; allowed to close, and what word a reader is given when the ground stopped — and
; leaves the room to observe/ear-ground-live.fk and the witness receipt.
;
; It can go red four ways that matter. Let a ledger row lose its verdict and bit 1
; falls. Let the close policy start waiting on the model's own signal again and bits
; 32 and 64 fall together. Let the standing word answer "standing" for a frame whose
; sequence stopped and bit 4096 falls — that is the mutebirth case, the one where a
; dead ground reads exactly like a quiet room. Let the arithmetic of the ledger drift
; from the measurements pinned in the cell and bits 4 and 8 fall.
;
; Expected: 32767
; preludes: form-stdlib/ear-ground.bml
(do
    (defn egb-bit (ok bit) (if ok bit 0))
    ; physics: the window filling (300) + the encoder (5) + the decoder (30)
    (let phys (eg-ms "physics"))
    ; furniture: the granule (100) + the ask (120) + the spool (0) + two forks (15)
    ;          + the silence fallback (500) + two extra hops (270) + a lane's open (2032)
    (let furn (eg-ms "furniture"))
    (let f1 (eg-frame 1788800000000 4242 91 3 -31 "en" "the witness told what stands" "model"))
    (sum (list
        ; every row in the ledger carries one of the two words: an unjudged row is a delay
        ; nobody looked at, and the whole point of the ledger is that each one was looked at
        (egb-bit (eq (eg-judged?) 1) 1)
        (egb-bit (eq phys 335) 2)
        (egb-bit (eq furn 3037) 4)
        ; and the two halves of the furniture never read as one number: 285 ms this ground
        ; actually took out of a hop, 2752 ms it named and left standing for another hand
        (egb-bit (and (eq (eg-moved-ms) 285) (and (eq (eg-named-ms) 2752) (eq (eg-moved-are-furniture?) 1))) 8)
        ; the reading is waiting, not arithmetic — by nearly nine to one
        (egb-bit (gt furn (mul 9 phys)) 16)
        ; the old ground reads the model's own end-of-line signal and refuses to act on it
        ; until three more passes agree: with the signal present and no agreement yet, nothing
        (egb-bit (str_eq (eg-close-old 5 0 0 0) "") 32)
        ; the raw policy — close the instant the model signals — was tried in the room and
        ; refused by it. It is kept here so the band pins what it does, not so it is used.
        (egb-bit (str_eq (eg-close-raw 5 0 0) "model") 64)
        ; the ground that stands: the signal leads, one confirming hop follows. With the signal
        ; and no confirmation yet, it does NOT close; with one hop of agreement, it does.
        (egb-bit (and (str_eq (eg-close-new 5 0 0 0) "") (str_eq (eg-close-new 5 1 0 0) "model")) 128)
        ; a line the model never closed still closes: silence, then a full window
        (egb-bit (str_eq (eg-close-new (sub 0 1) 0 501 0) "silence") 256)
        (egb-bit (str_eq (eg-close-new (sub 0 1) 0 0 1) "window") 512)
        ; and a line still growing, with no signal, no silence and room left, does not close
        (egb-bit (and (str_eq (eg-close-new (sub 0 1) 9 0 0) "") (eq (eg-closed? (eg-close-new (sub 0 1) 9 0 0)) 0)) 1024)
        ; two hops move, not three, and the silence is not added to them: a saving counted
        ; twice is a saving invented
        (egb-bit (and (eq (eg-close-saved-ms) 270) (str_eq (eg-close-old 5 3 0 0) "model-after-three")) 2048)
        ; the standing word. A ground nobody ever stood is absent; a ground that stood and
        ; stopped is SILENT and must never read as standing — absence is indistinguishable
        ; from a quiet room, so the word has to come from a sequence that moved.
        (egb-bit (and (str_eq (eg-standing 0 7 6 10) "absent")
                 (and (str_eq (eg-standing 1 7 6 900) "silent")
                      (str_eq (eg-standing 1 7 7 10) "silent"))) 4096)
        (egb-bit (and (str_eq (eg-standing 1 7 6 10) "standing")
                 (and (eq (eg-alive? (eg-standing 1 7 6 10)) 1)
                      (eq (eg-alive? (eg-standing 1 7 7 10)) 0))) 8192)
        ; the frame crosses as a cell and comes back as the same cell
        (egb-bit (and (eq (eg-frame-valid? f1) 1)
                 (and (str_eq (eg-frame-line f1) "the witness told what stands")
                 (and (str_eq (eg-frame-reason f1) "model")
                 (and (eq (eg-frame-pid f1) 4242)
                      (str_eq (eg-frame-tongue f1) "en"))))) 16384)
        )))
