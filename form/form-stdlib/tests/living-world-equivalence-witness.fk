; living-world-equivalence-witness.fk -- two offered lenses return exactly.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-equivalence.fk

(let LWEQW-X      (bp "LWEQW-X"))
(let LWEQW-Y      (bp "LWEQW-Y"))
(let LWEQW-ACTION (bp "LWEQW-ACTION"))

(defn lweqw-action () LWEQW-ACTION)
(defn lweqw-interface () (lwo-interface (list LWEQW-ACTION)))
(defn lweqw-source-a () (intern_trivial_string "lweqw-source-a"))
(defn lweqw-source-b () (intern_trivial_string "lweqw-source-b"))
(defn lweqw-source-c () (intern_trivial_string "lweqw-source-c"))
(defn lweqw-source-d () (intern_trivial_string "lweqw-source-d"))
(defn lweqw-provenance-a () (intern_trivial_string "lweqw-provenance-a"))
(defn lweqw-provenance-b () (intern_trivial_string "lweqw-provenance-b"))
(defn lweqw-provenance-c () (intern_trivial_string "lweqw-provenance-c"))
(defn lweqw-provenance-d () (intern_trivial_string "lweqw-provenance-d"))
(defn lweqw-response-provenance ()
    (intern_trivial_string "lweqw-response-provenance"))
(defn lweqw-revocation-reason ()
    (intern_trivial_string "lweqw-evidence-released"))

(defn lweqw-x (first second)
    (lwo-compose LWEQW-X (list first second)))
(defn lweqw-y (first second)
    (lwo-compose LWEQW-Y (list first second)))

(defn lweqw-x-a ()
    (lweqw-x (intern_trivial_string "alice")
             (intern_trivial_string "red")))
(defn lweqw-y-a ()
    (lweqw-y (intern_trivial_string "red")
             (intern_trivial_string "alice")))
(defn lweqw-x-b ()
    (lweqw-x (intern_trivial_string "bob")
             (intern_trivial_string "blue")))
(defn lweqw-y-b ()
    (lweqw-y (intern_trivial_string "blue")
             (intern_trivial_string "bob")))
(defn lweqw-y-c ()
    (lweqw-y (intern_trivial_string "green")
             (intern_trivial_string "carol")))
(defn lweqw-x-c ()
    (lweqw-x (intern_trivial_string "carol")
             (intern_trivial_string "green")))
(defn lweqw-y-d ()
    (lweqw-y (intern_trivial_string "orange")
             (intern_trivial_string "dave")))
(defn lweqw-x-d ()
    (lweqw-x (intern_trivial_string "dave")
             (intern_trivial_string "orange")))

(defn lweqw-forward-a ()
    (lwr-correspondence (lweqw-x-a) (lweqw-y-a)))
(defn lweqw-forward-b ()
    (lwr-correspondence (lweqw-x-b) (lweqw-y-b)))
(defn lweqw-inverse-c ()
    (lwr-correspondence (lweqw-y-c) (lweqw-x-c)))
(defn lweqw-inverse-d ()
    (lwr-correspondence (lweqw-y-d) (lweqw-x-d)))
(defn lweqw-wrong-inverse-c ()
    (lwr-correspondence (lweqw-y-c)
        (lweqw-x (intern_trivial_string "green")
                 (intern_trivial_string "carol"))))
(defn lweqw-wrong-inverse-d ()
    (lwr-correspondence (lweqw-y-d)
        (lweqw-x (intern_trivial_string "orange")
                 (intern_trivial_string "dave"))))

(defn lweqw-offer (source payload provenance)
    (lwo-offer source (lweqw-interface) 1 payload provenance 1))
(defn lweqw-entry (source payload provenance)
    (lwt-entry (lweqw-offer source payload provenance) (lweqw-action)))
(defn lweqw-yes-response (proposal)
    (lwt-response proposal (oac-one (lwt-proposal-candidate proposal))
                  (lweqw-response-provenance)))
(defn lweqw-yes-entry (source provenance proposal)
    (lweqw-entry source (lweqw-yes-response proposal) provenance))

(defn lweqw-base-round-with (inverse-c inverse-d)
    (lwrr-tend (lwo-empty-world)
        (list
            (lweqw-entry (lweqw-source-a) (lweqw-forward-a)
                         (lweqw-provenance-a))
            (lweqw-entry (lweqw-source-b) (lweqw-forward-b)
                         (lweqw-provenance-b))
            (lweqw-entry (lweqw-source-c) inverse-c
                         (lweqw-provenance-c))
            (lweqw-entry (lweqw-source-d) inverse-d
                         (lweqw-provenance-d)))
        2 (lwo-none)))
(defn lweqw-base-round ()
    (lweqw-base-round-with
        (lweqw-inverse-c) (lweqw-inverse-d)))
(defn lweqw-wrong-base-round ()
    (lweqw-base-round-with
        (lweqw-wrong-inverse-c) (lweqw-wrong-inverse-d)))

(defn lweqw-proposal-for-source-skeleton (items skeleton)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let proposal (head items))
            (let signature
                (lwrr-mapping-signature
                    (lwo-emergent-shape
                        (lwt-proposal-candidate proposal))))
            (if (node_eq
                    (lwrr-signature-source-skeleton signature) skeleton)
                proposal
                (lweqw-proposal-for-source-skeleton
                    (tail items) skeleton)))))

(defn lweqw-forward-proposal (round)
    (lweqw-proposal-for-source-skeleton
        (lwo-field-items (lwt-round-proposals round))
        (lwrr-skeleton (lweqw-x-a))))
(defn lweqw-inverse-proposal (round)
    (lweqw-proposal-for-source-skeleton
        (lwo-field-items (lwt-round-proposals round))
        (lwrr-skeleton (lweqw-y-c))))

(defn lweqw-forward-yes-round (round proposal)
    (lwt-round-receive round
        (list
            (lweqw-yes-entry (lweqw-source-a)
                             (lweqw-provenance-a) proposal)
            (lweqw-yes-entry (lweqw-source-b)
                             (lweqw-provenance-b) proposal))))
(defn lweqw-inverse-yes-round (round proposal)
    (lwt-round-receive round
        (list
            (lweqw-yes-entry (lweqw-source-c)
                             (lweqw-provenance-c) proposal)
            (lweqw-yes-entry (lweqw-source-d)
                             (lweqw-provenance-d) proposal))))
(defn lweqw-all-yes-round (round proposal)
    (lwt-round-receive round
        (list
            (lweqw-yes-entry (lweqw-source-a)
                             (lweqw-provenance-a) proposal)
            (lweqw-yes-entry (lweqw-source-b)
                             (lweqw-provenance-b) proposal)
            (lweqw-yes-entry (lweqw-source-c)
                             (lweqw-provenance-c) proposal)
            (lweqw-yes-entry (lweqw-source-d)
                             (lweqw-provenance-d) proposal))))

(defn lweqw-mapping-round-from (base)
    (do
        (let forward-proposal (lweqw-forward-proposal base))
        (let inverse-proposal (lweqw-inverse-proposal base))
        (let forward-integrated
            (lwt-integrate
                (lweqw-forward-yes-round base forward-proposal)
                forward-proposal (lweqw-action)))
        (let inverse-round
            (lwt-round (lwt-round-world forward-integrated)
                (lwo-field-add (lwo-empty-field) inverse-proposal)
                (lwo-empty-field) forward-integrated))
        (lwt-integrate
            (lweqw-inverse-yes-round inverse-round inverse-proposal)
            inverse-proposal (lweqw-action))))

(defn lweqw-release-forward-a (world)
    (lwt-receive-stream world
        (list
            (lweqw-entry (lweqw-source-a)
                (lwo-revocation (lweqw-forward-a) (lweqw-source-a)
                    (lweqw-revocation-reason) (lweqw-provenance-a))
                (lweqw-provenance-a)))))

(defn lweqw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lweqw-sum (tail items)))))
