; form-cli-peer-token-receipt-ledger-band.fk -- Expected: 63.
; preludes: form-stdlib/bml/form-cli-peer-token-receipt-ledger.bml

(do
    (defn fcptrlb-bit (held weight) (if held weight 0))
    (defn form-cli-peer-token-receipt-ledger-band ()
        (do
            (let node-a (intern_node_at (intern_trivial_string "goal")
                (list (intern_trivial_string "a")) "ledger-band" 1 1))
            (let node-b (intern_node_at (intern_trivial_string "goal")
                (list (intern_trivial_string "b")) "ledger-band" 2 1))
            (let local-a (frte-receipt node-a 1 (frte-local-direct-source) 0 0))
            (let provider-a (frte-receipt node-a 1 (frte-provider-source) 2 100))
            (let provider-b (frte-receipt node-b 1 (frte-provider-source) 2 100))
            (let provider-canonical (frte-receipt
                (fcpdag-embodied-goal-node) 1 (frte-provider-source) 2 100))
            (let ledger (fcptrl-admit (fcptrl-empty) local-a))
            (let joined (fcptrl-comparison ledger provider-a))
            (let wrong-node (fcptrl-comparison ledger provider-b))
            (let empty-joined (fcptrl-comparison (fcptrl-empty) provider-a))
            (let c0 (fcptrlb-bit (and
                (eq (fcptrl-ledger? ledger) 1)
                (eq (len (fcptrl-entries ledger)) 1)) 1))
            (let c1 (fcptrlb-bit (and
                (eq (fcptrl-comparison? joined) 1)
                (and (eq (fcptrl-ratio-bps joined) 0)
                     (eq (fcptrl-under-ten-percent? joined) 1))) 2))
            (let frame (fcptrl-frame joined))
            (let c2 (fcptrlb-bit (and
                (ge (str_find frame "\nremote-tokens=100" 0) 0)
                (and (ge (str_find frame "\nratio-bps=0" 0) 0)
                     (eq (str_find frame "\nresponse=" 0) -1))) 4))
            (let c3 (fcptrlb-bit (and (nothing? wrong-node)
                (nothing? empty-joined)) 8))
            (let c4 (fcptrlb-bit (and (str_eq (fcptrl-frame wrong-node) "")
                (not (str_eq (fcptrl-frame joined) ""))) 16))
            (let receipt-frame (fcptrl-receipt-frame provider-canonical))
            (let c5 (fcptrlb-bit (and
                (ge (str_find receipt-frame "\nsettled=1" 0) 0)
                (and (ge (str_find receipt-frame "\nsource=provider-last-token-usage" 0) 0)
                     (eq (str_find receipt-frame "\nresponse=" 0) -1))) 32))
            (sum (list c0 c1 c2 c3 c4 c5))))
    (form-cli-peer-token-receipt-ledger-band))
