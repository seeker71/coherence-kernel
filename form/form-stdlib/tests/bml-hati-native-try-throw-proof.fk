; tests/bml-hati-native-try-throw-proof.fk
;
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk
;
; Closes the general-try/throw-catch-source-lowering family on the Hati
; table lane. A throw is a bml-native-source-control effect riding "fail":
; it stores its value in the THROWN cell and sets MODE; statements after it
; are skipped; loops and method returns pass it outward; a catch receives
; the effect bnsc-try-catch turns into a value and binds it to its
; parameter. A try whose body does not throw keeps its body's value (the
; old stub answered the catch value unconditionally).

(do
    (defn score-bool (actual)
        (if actual 1 0))

    (defn score-int (actual expected)
        (if (eq actual expected) 1 0))

    (defn score-str (actual expected)
        (if (str_eq (value_kind actual) "string")
            (if (str_eq actual expected) 1 0)
             0))

    (defn str-contains? (haystack needle)
        (ge (str_find haystack needle 0) 0))

    (defn parse-source (source)
        (bml-source-parse-executable-stream (bml-source-scan-text source)))

    (defn run-source (source)
        (bml-hati-run-value (bml-source-exec-parse-node (parse-source source))))

    (let fixture-path "form-stdlib/tests/fixtures/bml-thesis-forward-backward-demo.bml")
    (let fixture-parsed (bml-source-file-parse-executable fixture-path))
    (let fixture-try (head (tail (bml-source-exec-parse-nodes fixture-parsed))))
    (let fixture-image (bml-hati-compile-image fixture-try))
    (let fixture-table (bml-hati-table-file fixture-image))

    (let param-parsed (parse-source "try { throw 41; } catch (int e) { return e + 1; }\n"))

    (let check-method
        "int Check(int k) { for (int i = 0; i < 10; i++) { if (i == k) throw i * 3; } return -1; }\n")

    (let uncaught-image (bml-hati-compile-image (bml-source-exec-parse-node (parse-source "throw 9;\n"))))

    (sum
        (list
            (score-bool (bml-source-exec-parse-ok? fixture-parsed))
            (score-str (head (tail (bml-source-exec-parse-rules fixture-parsed))) "try-throw-return")
            (score-bool (bml-hati-image-supported? fixture-image))
            (score-bool (not (str-contains? fixture-table "BML-HATI-UNSUPPORTED")))
            (score-bool (str-contains? fixture-table "1 4002 0 0"))
            (score-int (bml-hati-run-value fixture-try) 7)
            (score-str (head (bml-source-exec-parse-rules param-parsed)) "control-try")
            (score-int (bml-hati-run-value (bml-source-exec-parse-node param-parsed)) 42)
            (score-int (run-source "try { return 5; } catch { return 7; }\n") 5)
            (score-int (run-source "try { throw 3; return 4; } catch { return 5; }\n") 5)
            (score-int
                (run-source
                    (str_concat check-method "try { return Check(4); } catch (int e) { return e + 100; }\n"))
                112)
            (score-int
                (run-source
                    (str_concat check-method "try { return Check(40); } catch (int e) { return e; }\n"))
                -1)
            (score-int
                (run-source
                    "try { try { throw 1; } catch (int e) { throw e + 1; } } catch (int f) { return f * 10; }\n")
                20)
            (score-int
                (run-source
                    "for (int i = 0; i < 5; i++) { try { if (i == 3) throw i; } catch (int e) { return e * 7; } } return 0;\n")
                21)
            (score-bool (bml-hati-image-supported? uncaught-image))
            (score-int (fkm-run (bml-hati-image-fns uncaught-image) 0) 9)
            (score-int (bml-ctl-throw-mode 0) 3)
            (score-int (bml-ctl-return-mode 0) 4)
            (score-int (bml-ctl-catch-mode 0) (bml-ctl-throw-mode 0))
            (score-str (bnsc-effect-primitive (bml-ctl-node-effect (bml-ast-throw (bml-ast-int 1)))) "fail")
            (score-str (bnsc-effect-primitive (bml-ctl-node-effect (bml-ast-return (bml-ast-int 1)))) "return"))))
