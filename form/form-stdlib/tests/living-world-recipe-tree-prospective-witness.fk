; living-world-recipe-tree-prospective-witness.fk -- a current Recipe-tree
; successor and its incumbent meet the same source-disjoint prospective field.
; The bounded field contains support, contradiction, NOTHING-now, and a
; timeout-condensed alternative; it is diagnostic and grants no authority.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk

(let LWRTEW-SOURCE-E    (bp "LWRTEW-SOURCE-E"))
(let LWRTEW-SOURCE-F    (bp "LWRTEW-SOURCE-F"))
(let LWRTEW-EVIDENCE    (bp "LWRTEW-EVIDENCE"))
(let LWRTEW-ALTERNATIVE (bp "LWRTEW-ALTERNATIVE"))
(let LWRTEW-CASE-KEY    (bp "LWRTEW-CASE-KEY"))
(let LWRTEW-SCOPE       (bp "LWRTEW-SCOPE"))
(let LWRTEW-ROLE        (bp "LWRTEW-ROLE"))
(let LWRTEW-LENS        (bp "LWRTEW-LENS"))
(let LWRTEW-REASON      (bp "LWRTEW-REASON"))
(let LWRTEW-RESULT      (bp "LWRTEW-RESULT"))

(defn lwrtew-cell (kind) (intern_node kind (empty)))
(defn lwrtew-source-e () (lwrtew-cell LWRTEW-SOURCE-E))
(defn lwrtew-source-f () (lwrtew-cell LWRTEW-SOURCE-F))
(defn lwrtew-evidence () (lwrtew-cell LWRTEW-EVIDENCE))
(defn lwrtew-alternative () (lwrtew-cell LWRTEW-ALTERNATIVE))
(defn lwrtew-reason () (lwrtew-cell LWRTEW-REASON))
(defn lwrtew-alternatives ()
    (lwo-field (list (lwrtew-alternative))))
(defn lwrtew-unknown () (lwlc-unknown (lwrtew-evidence)))
(defn lwrtew-entry (source payload)
    (lwphw-entry source (lwrtew-evidence) payload))

(defn lwrtew-case-key (index)
    (intern_node LWRTEW-CASE-KEY (list (intern_trivial_int index))))
(defn lwrtew-role (index name)
    (intern_node LWRTEW-ROLE
        (list (lwrtew-case-key index) (intern_trivial_string name))))
(defn lwrtew-scope (index)
    (intern_node LWRTEW-SCOPE (list (lwrtew-case-key index))))
(defn lwrtew-projection (index name value)
    (lwre-projection (lwrtew-scope index) (lwrtew-role index name)
        (intern_trivial_int value) (lwrtew-alternatives)
        (lwrtew-unknown) (lwrtew-evidence)))
(defn lwrtew-binding (index name value)
    (lwre-projected-binding name (lwrtew-projection index name value)
        (lwrtew-evidence)))
(defn lwrtew-bindings (index left right)
    (lwre-bindings
        (list (lwrtew-binding index "left" left)
              (lwrtew-binding index "right" right))))
(defn lwrtew-lens (index)
    (lwlc-lens (lwlc-cell-shape)
        (intern_node LWRTEW-LENS (list (lwrtew-case-key index)))
        (lwrtew-evidence)))

(defn lwrtew-case-one (index left right expected lens)
    (lwps-case (lwrtew-bindings index left right)
        (oac-one (intern_trivial_int expected))
        (lwo-none) (lwo-none) (lwrtew-alternatives)
        (lwrtew-unknown) lens (lwrtew-evidence)))
(defn lwrtew-case-pending ()
    (lwps-case (lwrtew-bindings 3 3 8) (oac-nothing)
        (oac-timeout (intern_trivial_int 10) (oac-no-default)
            (lwrtew-evidence))
        (intern_trivial_int 4) (lwrtew-alternatives) (lwrtew-unknown)
        (lwo-none) (lwrtew-evidence)))
(defn lwrtew-case-condensed ()
    (do
        (let alternative
            (oac-alternative-ack (lwrtew-case-key 4)
                (lwrtew-alternative) (lwrtew-evidence)))
        (lwps-case (lwrtew-bindings 4 2 9) (oac-nothing)
            (oac-timeout (intern_trivial_int 10) alternative
                (lwrtew-evidence))
            (intern_trivial_int 10) (lwrtew-alternatives)
            (lwrtew-unknown) (lwrtew-lens 4) (lwrtew-evidence))))

; The resolved observations are offered data, not production answer knowledge.
; Two agree with the successor's broad branch and one exposes that its single
; learned exception does not constitute a general exception mechanism.
(defn lwrtew-cases ()
    (lwo-field
        (list
            (lwrtew-case-one 0 17 4 21 (lwo-none))
            (lwrtew-case-one 1 9 6 15 (lwrtew-lens 1))
            (lwrtew-case-one 2 12 5 7 (lwo-none))
            (lwrtew-case-pending)
            (lwrtew-case-condensed))))
(defn lwrtew-dataset ()
    (lwps-dataset (lwrtew-cases) (lwrtew-evidence)))
(defn lwrtew-split (target)
    (lwps-split (lwrtep-retained-bindings target) (lwo-empty-field)
        (lwps-dataset-bindings (lwrtew-dataset)) (lwrtew-evidence)))
(defn lwrtew-contract ()
    (lwps-contract (lwps-exact-identity) (lwo-none)
        (lwrtew-alternatives) (lwrtew-unknown) (lwrtew-evidence)))
(defn lwrtew-suite (target)
    (lwps-suite (lwrtew-dataset) (lwrtew-split target)
        (lwrtew-contract) (lwrtew-evidence)))

(defn lwrtew-binding-entries (source items entries)
    (if (eq (len items) 0) entries
        (do
            (let binding (head items))
            (let projection (lwre-binding-projection binding))
            (lwrtew-binding-entries source (tail items)
                (cons (lwrtew-entry source binding)
                    (cons (lwrtew-entry source
                            (lwre-binding-source binding))
                        (cons (lwrtew-entry source projection)
                            (cons (lwrtew-entry source
                                    (lwre-projection-scope projection))
                                entries))))))))
(defn lwrtew-case-entries (source items entries)
    (if (eq (len items) 0) entries
        (do
            (let case (head items))
            (lwrtew-case-entries source (tail items)
                (lwrtew-binding-entries source
                    (lwre-binding-items (lwps-case-bindings case))
                    (cons (lwrtew-entry source
                            (lwps-case-bindings case))
                        (cons (lwrtew-entry source case) entries)))))))
(defn lwrtew-suite-entries (source target)
    (lwrtew-case-entries source (lwo-field-items (lwrtew-cases))
        (list
            (lwrtew-entry source (lwrtew-evidence))
            (lwrtew-entry source (lwrtew-alternative))
            (lwrtew-entry source (lwrtew-unknown))
            (lwrtew-entry source (lwrtew-dataset))
            (lwrtew-entry source (lwrtew-split target))
            (lwrtew-entry source (lwrtew-contract))
            (lwrtew-entry source (lwrtew-suite target)))))
(defn lwrtew-one-source-world (world target)
    (lwt-receive-stream world
        (lwrtew-suite-entries (lwrtew-source-e) target)))
(defn lwrtew-two-source-world (world target)
    (lwt-receive-stream (lwrtew-one-source-world world target)
        (lwrtew-suite-entries (lwrtew-source-f) target)))
(defn lwrtew-revoke-first-case (world)
    (do
        (let case (head (lwo-field-items (lwrtew-cases))))
        (lwt-receive-stream world
            (list
                (lwrtew-entry (lwrtew-source-e)
                    (lwo-revocation case (lwrtew-source-e)
                        (lwrtew-reason) (lwrtew-evidence)))))))

; children: upstream result, target/successor/suite, one/two-source worlds,
; incumbent/successor evaluations and comparison, revoked world/comparison,
; source set and framebuffer events.
(defn lwrtew-result
    (upstream target successor suite one-world one-comparison two-world
     incumbent successor-evaluation comparison revoked-world revoked-comparison
     suite-sources events)
    (intern_node LWRTEW-RESULT
        (list upstream target successor suite one-world one-comparison two-world
              incumbent successor-evaluation comparison revoked-world
              revoked-comparison suite-sources events)))

(defn lwrtew-run ()
    (do
        (let upstream (lwrthw-run))
        (let target (nth (node_children upstream) 1))
        (let successor
            (nth (node_children upstream) 18))
        (let world
            (lwt-round-world (nth (node_children upstream) 17)))
        (let suite (lwrtew-suite target))
        (let started
            (lcfb-open-stream "living-world-recipe-tree-prospective"
                "form-native" "lwrtew-run"
                "admitted-successor-to-source-disjoint-prospective-field"
                "form/form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk"
                195 10))

        (let one-world (lwrtew-one-source-world world target))
        (let one-comparison
            (lwrtep-compare one-world successor suite 2))
        (let one-frame
            (lcfb-call-stream "living-world-recipe-tree-prospective"
                "first-suite-offer" "leave" "form-native"
                "lwps-suite-current?/lwrtep-compare"
                "sources:1:comparison:nothing" 1 started
                "form/form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk"
                211 10))

        (let two-world (lwrtew-two-source-world world target))
        (let suite-sources (lwrtep-suite-sources two-world suite))
        (let identity-frame
            (lcfb-call-stream "living-world-recipe-tree-prospective"
                "prospective-membrane" "leave" "form-native"
                "lwrtep-identity-clean?/lwrtep-source-clean?"
                (lcfb-cat (list
                    "retained-bindings:"
                    (int_to_str
                        (lwo-field-size (lwrtep-retained-bindings target)))
                    ":prospective-bindings:"
                    (int_to_str
                        (lwo-field-size
                            (lwps-split-prospective
                                (lwps-suite-split suite))))
                    ":sources:"
                    (int_to_str (lwo-field-size suite-sources))
                    ":identity-clean:"
                    (int_to_str
                        (lwrtep-identity-clean? successor suite))
                    ":source-clean:"
                    (int_to_str
                        (lwrtep-source-clean?
                            two-world successor suite 2))))
                2 started
                "form/form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk"
                228 10))

        (let incumbent-enter
            (lcfb-call-stream "living-world-recipe-tree-prospective"
                "incumbent" "enter" "form-native"
                "lwrtep-evaluate-incumbent" "same-exact-suite" 3 started
                "form/form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk"
                252 10))
        (let incumbent
            (lwrtep-evaluate-incumbent two-world successor suite 2))
        (let incumbent-metrics (lwps-evaluation-metrics incumbent))
        (let incumbent-frame
            (lcfb-call-stream "living-world-recipe-tree-prospective"
                "incumbent" "leave" "form-native" "lwps-metrics-for"
                (lcfb-cat (list
                    "exact:" (int_to_str
                        (lwps-metrics-value incumbent-metrics 2))
                    ":plural:" (int_to_str
                        (lwps-metrics-value incumbent-metrics 3))
                    ":contradicted:" (int_to_str
                        (lwps-metrics-value incumbent-metrics 4))))
                4 started
                "form/form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk"
                261 10))

        (let successor-enter
            (lcfb-call-stream "living-world-recipe-tree-prospective"
                "successor" "enter" "form-native"
                "lwrtep-evaluate-successor" "same-exact-suite" 5 started
                "form/form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk"
                275 10))
        (let successor-evaluation
            (lwrtep-evaluate-successor two-world successor suite 2))
        (let successor-metrics
            (lwps-evaluation-metrics successor-evaluation))
        (let successor-frame
            (lcfb-call-stream "living-world-recipe-tree-prospective"
                "successor" "leave" "form-native" "lwps-metrics-for"
                (lcfb-cat (list
                    "exact:" (int_to_str
                        (lwps-metrics-value successor-metrics 2))
                    ":plural:" (int_to_str
                        (lwps-metrics-value successor-metrics 3))
                    ":contradicted:" (int_to_str
                        (lwps-metrics-value successor-metrics 4))))
                6 started
                "form/form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk"
                284 10))

        (let comparison
            (lwps-compare incumbent successor-evaluation))
        (let compare-frame
            (lcfb-call-stream "living-world-recipe-tree-prospective"
                "comparison" "leave" "form-native" "lwps-compare"
                (lwrtep-progress-target comparison) 7 started
                "form/form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk"
                300 10))

        (let revoked-world (lwrtew-revoke-first-case two-world))
        (let revoked-comparison
            (lwrtep-compare revoked-world successor suite 2))
        (let revoked-frame
            (lcfb-call-stream "living-world-recipe-tree-prospective"
                "revocation" "leave" "form-native"
                "lwo-revocation/lwrtep-compare"
                (lcfb-cat (list
                    "suite-current:"
                    (int_to_str
                        (lwps-suite-current? revoked-world suite 2))
                    ":comparison-nothing:"
                    (int_to_str
                        (node_eq revoked-comparison (lwo-none)))
                    ":successor-current:"
                    (int_to_str
                        (lwrth-integrated-current?
                            revoked-world successor))))
                8 started
                "form/form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk"
                311 10))
        (lwrtew-result upstream target successor suite one-world one-comparison
            two-world incumbent successor-evaluation comparison revoked-world
            revoked-comparison suite-sources (framebuffer-events))))

0
