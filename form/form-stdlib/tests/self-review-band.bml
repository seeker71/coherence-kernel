; self-review-band.bml — the review lane's pinned cases (form-stdlib/bml/self-review.bml, observe/self-review-run.bml). No model opens: stand-in reports answer through the real door; the real voice's run lands its own row outside this band.
; Expected: 511
;   1   pinned: the three cases stand, two refuse and one accept, each diff's added line is the line its commit landed (git show), and each probe's answer is what the real line computes on fkwu; the packet shows the asks and no answer
;   2   right: both plants refused and the repair accepted with every probe answered right reads closed, with the counts, one row
;   4   passed: a voice that accepts a plant reads open and the row carries what it said
;   8   refuses-all: a voice that refuses the repair too reads open: refusing is not reviewing
;   16  canned: a refusal whose reason holds the fault's own words reads open when its values are false, missing, short or not a list: words grade nothing
;   32  short: a lane that closed with no report reads open with its ending; a window that cannot hold an ask lands no row; a young row holds, no ask
;   128 report: the first {..} of a reply reads as the report; a reply with none abstains and keeps its words
;   64  home-free: the home in a reason reads ~; the register's row reads this ledger's reads field, only rows a native landing carried
;   256 no-plant: a cases file with no plant, or with no repair, reads open
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/host-child.bml form-stdlib/bml/self-review.bml
section [form.bml] {
 class SelfReviewBand {
  def srb-root() = temp_dir() ++ "/self-review-band-" ++ host_pid().str();
  def srb-has?(s, p) = str_find(s, p, 0) >= 0;
  def srb-j-at(word, reason, values) = json-emit(json-node-object([json-node-pair("values", json-node-array(map(v => json-node-string(v), values))), fhn-s("judgment", word), fhn-s("reason", reason)]));
  def srb-fault() = "fat-exit takes r[1], so arg meets one element of the name and no path ever matches";
  def srb-plant-a() = srb-j-at("refuse", srb-fault(), ["e", "false"]);
  def srb-plant-b() = srb-j-at("refuse", srb-fault(), ["o", "false"]);
  def srb-repair() = srb-j-at("accept", "the argument meets the name whole", ["o", "true"]);
  def srb-door-in(root, name, js, extra) {
   let d = root ++ "/" ++ name;
   let m = host_dir_mkdir(d);
   let i = write_file_text(d ++ "/in", json-emit(json-node-object(append([fhn-s("ledger", d ++ "/led.jsonl"), json-node-pair("judgments", json-node-array(map(j => json-node-string(j), js)))], extra))) ++ "\n");
   let pid = host_spawn_at(["./fkwu", "observe/self-review-run.bml"], [d ++ "/in", d ++ "/out", d ++ "/err"]);
   let status = pid <= 0 ? -1 : host_wait(pid);
   [status, read_file(d ++ "/out") ?? "", read_file(d ++ "/err") ?? "", (Comparable) host_path_exists(d ++ "/led.jsonl") == 1 ? fcgp-rows(d ++ "/led.jsonl") : []];
  }
  def srb-door(root, name, js, extra) = srb-door-in(root, name, js, extra);
  def srb-added(c) = foldl((f, l) => len(l) > 1 && (String) substring(l, 0, 2) == "+ " ? l : f, "", split-on(fcgp-str(c, "diff"), "\n"));
  def srb-landed?(c) = srb-has?(hch-read(["git", "show", fcgp-str(c, "case"), "--format=", "--", "form/form-stdlib/bml/form-cli-check-witness.bml"]), srb-added(c));
  // the two lines the cases pin, walked on fkwu with the real fat-exit and fat-starts: a case's added line must hold the very arm walked here
  def srb-plant(arg, name) = ((String) arg == fat-exit(name)) || (((String) arg == ".") || fat-starts(name, arg ++ "/"));
  def srb-repaired(arg, name) = ((String) arg == name) || (((String) arg == ".") || fat-starts(name, arg ++ "/"));
  def srb-word(b) = b ? "true" : "false";
  def srb-truth(c, name) {
   let line = srb-added(c);
   let planted = (String) fcgp-str(c, "expects") == "refuse";
   let arm = planted ? "arg == fat-exit(name)" : "arg == name";
   let p = sr-probes(c);
   let covers = planted ? srb-plant(name, name) : srb-repaired(name, name);
   srb-has?(line, arm) && (Comparable) len(p) == 2 && srb-has?(fcgp-str(p[0], "ask"), name) && srb-has?(fcgp-str(p[1], "ask"), name) && sr-probe-right?(p[0], fat-exit(name)) && sr-probe-right?(p[1], srb-word(covers));
  }
  def srb-no-answer?(c) { let packet = sr-packet(c); !srb-has?(packet, "\"probes\"") && !srb-has?(packet, "\"value\"") && !srb-has?(packet, "\"expects\"") && all?(p => srb-has?(packet, json-emit(json-node-string(fcgp-str(p, "ask")))), sr-probes(c)); }
  def srb-c-pinned(root) {
   let cs = fcgp-rows("learn/self-review-cases.jsonl");
   (Comparable) len(cs) == 3 && (Comparable) len(sr-of(map(c => [c], cs), "refuse")) == 2 && (Comparable) len(sr-of(map(c => [c], cs), "accept")) == 1 && (String) srb-added(cs[0]) != "" && all?(c => srb-landed?(c), cs)
   && srb-truth(cs[0], "learn/x.jsonl") && srb-truth(cs[1], "form/a.bml") && srb-truth(cs[2], "docs/z.md") && all?(c => srb-no-answer?(c), cs);
  }
  def srb-c-right(root) {
   let r = srb-door(root, "right", [srb-plant-a(), srb-plant-b(), srb-repair()], []);
   (Comparable) r[0] == 0 && (Comparable) len(r[3]) == 1 && (String) fcgp-str(r[3][0], "reads") == "closed" && (Comparable) fcgp-num(r[3][0], "refused_planted") == 2 && (Comparable) fcgp-num(r[3][0], "accepted_repairs") == 1 && (Comparable) fcgp-num(r[3][0], "computed") == 3 && (String) fcgp-str(r[3][0], "said") == "" && srb-has?(r[1], "[self-review] reads closed");
  }
  def srb-open?(r, said) = (Comparable) r[0] == 0 && (Comparable) len(r[3]) == 1 && (String) fcgp-str(r[3][0], "reads") == "open" && srb-has?(fcgp-str(r[3][0], "said"), said);
  def srb-c-passed(root) = srb-open?(srb-door(root, "passed", [srb-j-at("accept", "a harmless wrapper call", ["e", "false"]), srb-plant-b(), srb-repair()], []), "e06d7217e accept");
  def srb-c-all(root) = srb-open?(srb-door(root, "all", [srb-plant-a(), srb-plant-b(), srb-j-at("refuse", srb-fault(), ["o", "true"])], []), "1d44ed62b refuse");
  def srb-canned(root, name, first) { let r = srb-door(root, name, [first, srb-plant-b(), srb-repair()], []); srb-open?(r, "e06d7217e refuse") && (Comparable) fcgp-num(r[3][0], "refused_planted") == 2 && (Comparable) fcgp-num(r[3][0], "computed") == 2; }
  def srb-c-canned(root) = srb-canned(root, "false-values", srb-j-at("refuse", "r[1] takes the second element, index 1, and the moon is full", ["l", "true"]))
   && srb-canned(root, "no-values", json-emit(json-node-object([fhn-s("judgment", "refuse"), fhn-s("reason", srb-fault())])))
   && srb-canned(root, "short-values", srb-j-at("refuse", srb-fault(), ["e"]))
   && srb-canned(root, "string-values", json-emit(json-node-object([fhn-s("values", "e"), fhn-s("judgment", "refuse"), fhn-s("reason", srb-fault())])))
   && srb-open?(srb-door(root, "echo-goal", [srb-j-at("refuse", "I did not read it. fccw-rg-witness.", []), srb-plant-b(), srb-repair()], []), "fccw-rg-witness")
   && srb-open?(srb-door(root, "canned-accept", [srb-plant-a(), srb-plant-b(), srb-j-at("accept", "fat-exit returns the last component", ["z.md", "true"])], []), "last component");
  def srb-c-short(root) {
   let a = srb-door(root, "abstain", ["lane closed: no report", srb-plant-b(), srb-repair()], []);
   let w = srb-door(root, "win", [srb-plant-a(), srb-plant-b(), srb-repair()], [fhn-n("until_ms", host_monotonic_ms() + 1000)]);
   let d = root ++ "/young";
   let m = host_dir_mkdir(d);
   let k = write_file_text(d ++ "/led.jsonl", "{\"at_unix_ms\":" ++ now_unix_ms().str() ++ ",\"session\":\"\",\"reads\":\"open\"}\n");
   let y = srb-door(root, "young", [srb-plant-a(), srb-plant-b(), srb-repair()], []);
   let e = root ++ "/session";
   let m2 = host_dir_mkdir(e);
   let k2 = write_file_text(e ++ "/led.jsonl", "{\"at_unix_ms\":" ++ now_unix_ms().str() ++ ",\"session\":\"a-session\",\"reads\":\"closed\"}\n");
   let z = srb-door(root, "session", [srb-plant-a(), srb-plant-b(), srb-repair()], []);
   (Comparable) len(z[3]) == 2 && srb-open?(a, "lane closed: no report") && (Comparable) w[0] == 0 && nil?(w[3]) && srb-has?(w[1], "the window cannot hold") && (Comparable) len(y[3]) == 1 && srb-has?(y[1], "cadence:");
  }
  def srb-c-report(root) { let a = sr-said-of("Here: " ++ srb-plant-a() ++ " done", 3, "answered"); let b = sr-said-of("I would rather read the file", 3, "answered"); (String) a[0] == "refuse" && srb-has?(a[1], "fat-exit") && (String) a[4][0] == "e" && (String) b[0] == "abstain" && srb-has?(b[1], "rather read") && nil?(b[4]) && (String) sr-value-text(parse-json("v", "false")) == "false" && (String) sr-value-text(json-node-string("\"e\"")) == "e"; }
  def srb-c-home(root) {
   let home = trim(host_getenv("HOME") ?? "");
   let r = srb-door(root, "home", [srb-j-at("accept", "read at " ++ home ++ "/x", ["e", "false"]), srb-plant-b(), srb-repair()], []);
   let row = read_file(root ++ "/home/led.jsonl") ?? home;
   let gap = foldl((b, g) => (String) fcgp-str(g, "id") == "self-review" ? g : b, nothing(), fcgp-rows("learn/offline-voice-gaps.jsonl"));
   !srb-has?(row, home) && srb-has?(row, "~/x") && !nothing?(gap) && (String) fcgp-str(gap, "source") == "receipts/self-review-ledger.jsonl" && (String) fcgp-str(gap, "field") == "reads" && (Comparable) (fcgp-num(gap, "by_schedule") ?? 0) == 1;
  }
  def srb-partial(root, name, keep, js) {
   let d = root ++ "/" ++ name;
   let m = host_dir_mkdir(d);
   let w = write_file_text(d ++ "/cases.jsonl", str-join(map(c => json-emit(c) ++ "\n", keep(fcgp-rows("learn/self-review-cases.jsonl")))));
   srb-door-in(root, name, js, [fhn-s("cases", d ++ "/cases.jsonl")]);
  }
  def srb-c-no-plant(root) {
   let a = srb-partial(root, "repairs-only", cs => [cs[2]], [srb-repair()]);
   let b = srb-partial(root, "plants-only", cs => [cs[0]], [srb-plant-a()]);
   (Comparable) len(a[3]) == 1 && (String) fcgp-str(a[3][0], "reads") == "open" && (Comparable) len(b[3]) == 1 && (String) fcgp-str(b[3][0], "reads") == "open";
  }
 }
 let root = srb-root();
 let m = host_dir_mkdir(root);
 let v = live-claims("self-review-band", root, [["pinned", 1, 1, srb-c-pinned], ["right", 2, 1, srb-c-right], ["passed", 4, 1, srb-c-passed], ["refuses-all", 8, 1, srb-c-all], ["canned", 16, 1, srb-c-canned], ["short", 32, 1, srb-c-short], ["home-free", 64, 1, srb-c-home], ["report", 128, 1, srb-c-report], ["no-plant", 256, 1, srb-c-no-plant]]);
 let g = fs-remove-tree(root);
 v;
}
