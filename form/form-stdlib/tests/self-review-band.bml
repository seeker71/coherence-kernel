; self-review-band.bml — the review lane's pinned cases (form-stdlib/bml/self-review.bml, observe/self-review-run.bml). No model opens: stand-in reports answer through the real door; the real voice's run lands its own row outside this band.
; Expected: 255
;   1   pinned: the three cases stand, two refuse and one accept, and each diff's added line is the line its commit landed (git show)
;   2   right: both plants refused with a reason naming the fault and the repair accepted reads closed, with the counts, one row
;   4   passed: a voice that accepts a plant reads open and the row carries what it said
;   8   refuses-all: a voice that refuses the repair too reads open: refusing is not reviewing
;   16  off-reason: a refusal for no reason of the case's, or one that only echoes the diff's fat-exit, reads open; a reason that names the goal's untouched target holds, counted apart from one that names the fault
;   32  short: a lane that closed with no report reads open with its ending; a window that cannot hold an ask lands no row; a young row holds, no ask
;   128 report: the first {..} of a reply reads as the report; a reply with none abstains and keeps its words
;   64  home-free: the home in a reason reads ~; the register's row reads this ledger's reads field, only rows a native landing carried
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/host-child.bml form-stdlib/bml/self-review.bml
section [form.bml] {
 class SelfReviewBand {
  def srb-root() = temp_dir() ++ "/self-review-band-" ++ host_pid().str();
  def srb-has?(s, p) = str_find(s, p, 0) >= 0;
  def srb-j(word, reason) = json-emit(json-node-object([fhn-s("judgment", word), fhn-s("reason", reason)]));
  def srb-right() = srb-j("refuse", "fat-exit takes r[1], so arg meets one element of the name and no path ever matches");
  def srb-repair() = srb-j("accept", "the argument meets the name whole");
  def srb-door(root, name, js, extra) {
   let d = root ++ "/" ++ name;
   let m = host_dir_mkdir(d);
   let i = write_file_text(d ++ "/in", json-emit(json-node-object(append([fhn-s("ledger", d ++ "/led.jsonl"), json-node-pair("judgments", json-node-array(map(j => json-node-string(j), js)))], extra))) ++ "\n");
   let pid = host_spawn_at(["./fkwu", "observe/self-review-run.bml"], [d ++ "/in", d ++ "/out", d ++ "/err"]);
   let status = pid <= 0 ? -1 : host_wait(pid);
   [status, read_file(d ++ "/out") ?? "", read_file(d ++ "/err") ?? "", (Comparable) host_path_exists(d ++ "/led.jsonl") == 1 ? fcgp-rows(d ++ "/led.jsonl") : []];
  }
  def srb-added(c) = foldl((f, l) => len(l) > 1 && (String) substring(l, 0, 2) == "+ " ? l : f, "", split-on(fcgp-str(c, "diff"), "\n"));
  def srb-landed?(c) = srb-has?(hch-read(["git", "show", fcgp-str(c, "case"), "--format=", "--", "form/form-stdlib/bml/form-cli-check-witness.bml"]), srb-added(c));
  def srb-c-pinned(root) {
   let cs = fcgp-rows("learn/self-review-cases.jsonl");
   (Comparable) len(cs) == 3 && (Comparable) len(sr-of(map(c => [c], cs), "refuse")) == 2 && (Comparable) len(sr-of(map(c => [c], cs), "accept")) == 1 && (String) srb-added(cs[0]) != "" && all?(c => srb-landed?(c), cs);
  }
  def srb-c-right(root) {
   let r = srb-door(root, "right", [srb-right(), srb-right(), srb-repair()], []);
   (Comparable) r[0] == 0 && (Comparable) len(r[3]) == 1 && (String) fcgp-str(r[3][0], "reads") == "closed" && (Comparable) fcgp-num(r[3][0], "refused_planted") == 2 && (Comparable) fcgp-num(r[3][0], "accepted_repairs") == 1 && (String) fcgp-str(r[3][0], "said") == "" && srb-has?(r[1], "[self-review] reads closed");
  }
  def srb-open?(r, said) = (Comparable) r[0] == 0 && (Comparable) len(r[3]) == 1 && (String) fcgp-str(r[3][0], "reads") == "open" && srb-has?(fcgp-str(r[3][0], "said"), said);
  def srb-c-passed(root) = srb-open?(srb-door(root, "passed", [srb-j("accept", "a harmless wrapper call"), srb-right(), srb-repair()], []), "e06d7217e accept: a harmless wrapper call");
  def srb-c-all(root) = srb-open?(srb-door(root, "all", [srb-right(), srb-right(), srb-right()], []), "1d44ed62b refuse");
  def srb-c-off(root) = srb-open?(srb-door(root, "off", [srb-j("refuse", "the style reads poorly"), srb-right(), srb-repair()], []), "the style reads poorly") && srb-open?(srb-door(root, "echo", [srb-j("refuse", "it uses fat-exit(name) here"), srb-right(), srb-repair()], []), "it uses fat-exit") && srb-graded?(srb-door(root, "goal", [srb-j("refuse", "it leaves fccw-rg-witness untouched"), srb-right(), srb-repair()], []));
  def srb-graded?(r) = (String) fcgp-str(r[3][0], "reads") == "closed" && (Comparable) fcgp-num(r[3][0], "refused_planted") == 2 && (Comparable) fcgp-num(r[3][0], "refused_on_fault") == 1;
  def srb-c-short(root) {
   let a = srb-door(root, "abstain", [srb-j("abstain", "lane closed: no report"), srb-right(), srb-repair()], []);
   let w = srb-door(root, "win", [srb-right(), srb-right(), srb-repair()], [fhn-n("until_ms", host_monotonic_ms() + 1000)]);
   let d = root ++ "/young";
   let m = host_dir_mkdir(d);
   let k = write_file_text(d ++ "/led.jsonl", "{\"at_unix_ms\":" ++ now_unix_ms().str() ++ ",\"session\":\"\",\"reads\":\"open\"}\n");
   let y = srb-door(root, "young", [srb-right(), srb-right(), srb-repair()], []);
   let e = root ++ "/session";
   let m2 = host_dir_mkdir(e);
   let k2 = write_file_text(e ++ "/led.jsonl", "{\"at_unix_ms\":" ++ now_unix_ms().str() ++ ",\"session\":\"a-session\",\"reads\":\"closed\"}\n");
   let z = srb-door(root, "session", [srb-right(), srb-right(), srb-repair()], []);
   (Comparable) len(z[3]) == 2 && srb-open?(a, "lane closed: no report") && (Comparable) w[0] == 0 && nil?(w[3]) && srb-has?(w[1], "the window cannot hold") && (Comparable) len(y[3]) == 1 && srb-has?(y[1], "cadence:");
  }
  def srb-c-report(root) { let a = sr-said-of("Here: " ++ srb-right() ++ " done", 3, "answered"); let b = sr-said-of("I would rather read the file", 3, "answered"); (String) a[0] == "refuse" && srb-has?(a[1], "fat-exit") && (String) b[0] == "abstain" && srb-has?(b[1], "rather read"); }
  def srb-c-home(root) {
   let home = trim(host_getenv("HOME") ?? "");
   let r = srb-door(root, "home", [srb-j("accept", "read at " ++ home ++ "/x"), srb-right(), srb-repair()], []);
   let row = read_file(root ++ "/home/led.jsonl") ?? home;
   let gap = foldl((b, g) => (String) fcgp-str(g, "id") == "self-review" ? g : b, nothing(), fcgp-rows("learn/offline-voice-gaps.jsonl"));
   !srb-has?(row, home) && srb-has?(row, "~/x") && !nothing?(gap) && (String) fcgp-str(gap, "source") == "receipts/self-review-ledger.jsonl" && (String) fcgp-str(gap, "field") == "reads" && (Comparable) (fcgp-num(gap, "by_schedule") ?? 0) == 1;
  }
 }
 let root = srb-root();
 let m = host_dir_mkdir(root);
 let v = live-claims("self-review-band", root, [["pinned", 1, 1, srb-c-pinned], ["right", 2, 1, srb-c-right], ["passed", 4, 1, srb-c-passed], ["refuses-all", 8, 1, srb-c-all], ["off-reason", 16, 1, srb-c-off], ["short", 32, 1, srb-c-short], ["home-free", 64, 1, srb-c-home], ["report", 128, 1, srb-c-report]]);
 let g = fs-remove-tree(root);
 v;
}
