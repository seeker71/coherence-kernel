; twin-census-band.fk — the measure of which door is a private copy of a warm one.
;
; Expected: 65535
; preludes: form/form-stdlib/twin-census.bml
;
; Nothing under test touches the world: every door row, body and op-table byte
; below is written by hand, so the band proves the ARITHMETIC of the census and
; never the machine's mood. The live reading is a different witness
; (observe/twin-census-run.fk); a band that measured a running body would grade
; the weather.
;
; The hand-built floor under test — a shared unit and a private one:
;
;   shared.fk        private.fk
;     app  ────────────  app          same name, two units: a SHADOW
;     app                app-1        same body but for one window: PARTS
;     app                app-all      the same body under another name: a TWIN
;     rev                             warm and alone
;                        idx-rec      no body twin; its stem names a native
;                        loner        no twin at all
;
;   heat:  app 21547 crystal 3   app-1 30191048 crystal 0   app-all 483552 crystal -1
;          rev 6075 crystal 3    idx-rec 76254048 crystal -1   loner unmeasured
;
; Those readings are the ones the body actually gave on 2026-09-07's pre-heal
; tree, kept here because they carry the fact the whole lens turns on: read as
; calls, `app-1` at thirty million looks a thousand times hotter than `app` at
; twenty-one thousand. Heat counts WALKS and a crystallized door stops walking,
; so heat cannot tell a warm door from a cold one. Only crystal can (c9).
;
; The claims the measure exists to make, each with its own bit:
;   - a body match survives renaming, both of the door itself and of its own
;     arguments (c0, c1);
;   - two doors that read alike but part on an edge are NOT twins, and the
;     window that parts them is carried, because the window is the adapter a
;     reroute has to write (c2, c3);
;   - a twin named against a NATIVE is unproven and stays unproven — a native
;     has no body, so no body comparison exists (c6);
;   - a door with no twin says so, and a warm door is never offered as the cold
;     one (c5, c7);
;   - an unmeasured door is no-reading, never cold: the honesty the bearing
;     census keeps, kept for the same reason (c11).

(do
    (defn tcb-bit (ok bit) (if (eq ok 1) bit 0))
    (defn tcb-q () (byte_to_str 34))
    (defn tcb-nl () (byte_to_str 10))

    ; ── the hand unit, in both authoring lanes ────────────────────────────────
    ; `app` and `app-all` are one body under two names, and their arguments are
    ; named differently on purpose: a comparison that could not see through that
    ; would miss every real twin this tree carries.
    (defn tcb-shared-lines ()
        (list "    (defn app (xs ys)"
              "        (if (nil? xs) ys"
              "            (cons (head xs) (app (tail xs) ys))))"
              "    ;; a note naming app-1, which app does not call"
              "    (defn rev (xs acc)"
              "        (if (nil? xs) acc (rev (tail xs) (cons (head xs) acc))))"))
    (defn tcb-private-lines ()
        (list "    (defn app (xs ys)"
              "        (if (nil? xs) ys"
              "            (cons (head xs) (app (tail xs) ys))))"
              "    (defn app-1 (xs x)"
              "        (if (nil? xs) (list x) (cons (head xs) (app-1 (tail xs) x))))"
              "    (defn app-all (as bs)"
              "        (if (nil? as) bs"
              "            (cons (head as) (app-all (tail as) bs))))"
              "    (defn idx-rec (xs i)"
              "        (if (eq i 0) (head xs) (idx-rec (tail xs) (sub i 1))))"
              "    (defn loner (a b) (mul (add a b) (sub a b)))"))

    ; the same doors again in the BML lane, to prove a `.bml` body is read the
    ; same way: opened by `def name(args) =`, closed at its `;`
    (defn tcb-bml-lines ()
        (list "        def app(xs, ys) = if nil?(xs) then ys else cons(head(xs), app(tail(xs), ys));"
              "        def app-all(as, bs) = if nil?(as) then bs else cons(head(as), app-all(tail(as), bs));"))

    ; two op-table rows in the seed's own spelling, so the native lifter is
    ; proven on the exact bytes runtime/fkwu-optable.h carries
    (defn tcb-op-row (name arity tag)
        (str_concat "  { " (str_concat (tcb-q) (str_concat name (str_concat (tcb-q)
            (str_concat ", " (str_concat (int_to_str arity) (str_concat ", " (str_concat (int_to_str tag) " },")))))))))
    (defn tcb-table ()
        (str_concat (tcb-op-row "idx" 2 23) (str_concat (tcb-nl) (tcb-op-row "str_concat" 2 27))))

    ; a hot row as kernel_hot_rows gives it: heat name unit line col boxes unboxes crystal ...
    (defn tcb-row (heat name crystal) (list heat name "shared.fk" 1 9 0 0 crystal 0))
    (defn tcb-rows ()
        (list (tcb-row 76254048 "idx-rec"  -1)
              (tcb-row 30191048 "app-1"     0)
              (tcb-row 21547    "app"       3)
              (tcb-row 483552   "app-all"  -1)
              (tcb-row 6075     "rev"       3)))

    (defn tcb-doors ()
        (append (twc-doors-in "shared.fk" "form" (tcb-shared-lines) (list))
                (twc-doors-in "private.fk" "form" (tcb-private-lines) (list))))
    (defn tcb-body-of (ds unit name)
        (if (eq (len ds) 0) ""
            (if (and (str_eq (twc-d-unit (head ds)) unit) (str_eq (twc-d-name (head ds)) name))
                (twc-d-body (head ds))
                (tcb-body-of (tail ds) unit name))))

    (let doors (tcb-doors))
    (let bml (twc-doors-in "hand.bml" "bml" (tcb-bml-lines) (list)))
    (let rows (tcb-rows))
    (let natives (bcs-native-names (tcb-table)))
    (let pairs (twc-census rows doors natives))

    (let s-app (tcb-body-of doors "shared.fk" "app"))
    (let p-app (tcb-body-of doors "private.fk" "app"))
    (let p-all (tcb-body-of doors "private.fk" "app-all"))
    (let p-one (tcb-body-of doors "private.fk" "app-1"))
    (let s-rev (tcb-body-of doors "shared.fk" "rev"))
    (let b-app (tcb-body-of bml "hand.bml" "app"))
    (let b-all (tcb-body-of bml "hand.bml" "app-all"))

    ; 1 — the normal form. A door's own name becomes @s and each parameter its
    ; position, so `app(xs, ys)` and `app-all(as, bs)` read as ONE body — which
    ; is what they are. Comments are cut before anything is compared, and the
    ; Form lane's own closing paren goes with them.
    (let c0 (tcb-bit (and (str_eq s-app "(if (nil? @0) @1 (cons (head @0) (@s (tail @0) @1)))")
                     (and (str_eq s-app p-all)
                          (str_eq s-rev "(if (nil? @0) @1 (@s (tail @0) (cons (head @0) @1)))"))) 1))

    ; 2 — the BML lane is read the same way: `def name(args) =` opens it, the `;`
    ; closes it, and the same two doors come out as one body there too. A lane's
    ; syntax is not its meaning, but a body IS its bytes, so the two lanes never
    ; match each other — and this bit pins that they match WITHIN their lane.
    (let c1 (tcb-bit (and (str_eq b-app "if nil?(@0) then @1 else cons(head(@0), @s(tail(@0), @1))")
                     (and (str_eq b-app b-all) (eq (str_eq b-app s-app) 0))) 2))

    ; 4 — two doors that read alike but part on an edge are NOT twins. `app-1`
    ; answers `(list @1)` where `app` answers `@1`, and the verdict says
    ; differs-at, never looks-identical.
    (let v-one (twc-part s-app p-one))
    (let c2 (tcb-bit (and (str_eq (twc-p-kind v-one) "differs-at")
                     (and (str_eq (twc-p-win-a v-one) "@1")
                     (and (str_eq (twc-p-win-b v-one) "(list @1)")
                          (eq (str_eq s-app p-one) 0)))) 4))

    ; 8 — and the window is the ADAPTER. The heal this lens was born out of wrote
    ; exactly what the window says: append-1 became (append xs (list x)). A pair
    ; that only said "these differ" would have handed over a question; this hands
    ; over the edit.
    (let c3 (tcb-bit (and (str_eq (twc-p-kind (twc-part s-app p-all)) "looks-identical")
                     (and (eq (twc-p-sim (twc-part s-app p-all)) 10000)
                          (lt (twc-p-sim v-one) 10000))) 8))

    ; 16 — a body match is not a name match: the two `app` doors in two units are
    ; a SHADOW, and the census says so rather than calling one a twin of the
    ; other. The remedy differs too — a shadow asks for a deletion.
    (let sh (twc-of pairs "app" "app"))
    (let c4 (tcb-bit (and (str_eq (twc-c-role sh) "shadow")
                     (and (str_eq (twc-c-kind sh) "looks-identical")
                     (and (eq (str_eq (twc-c-cold-unit sh) (twc-c-warm-unit sh)) 0)
                          (gt (str_len (twc-remedy sh)) 0)))) 16))

    ; 32 — a door with no twin says so. `loner` shares no body with anything and
    ; its stem names no native, so it is in no pair at all, and asking the census
    ; for it answers the empty cell, whose every number is no-reading.
    (let c5 (tcb-bit (and (eq (len (twc-of pairs "loner" "app")) 0)
                     (and (str_eq (twc-c-kind (twc-of pairs "loner" "app")) "no-pair")
                          (eq (twc-c-cold-calls (twc-of pairs "loner" "app")) -1))) 32))

    ; 64 — a twin named against a NATIVE is unproven and STAYS unproven. `idx-rec`
    ; stems to `idx`, which the hand op table carries, and there is no body
    ; anywhere to hold against it — which is exactly how nth-rec reached a band
    ; instead of a reroute.
    (let nat (twc-of pairs "idx-rec" "idx"))
    (let c6 (tcb-bit (and (str_eq (twc-c-kind nat) "unproven")
                     (and (str_eq (twc-c-role nat) "native")
                     (and (str_eq (twc-c-heat nat) "warm-by-construction")
                          (str_eq (twc-c-warm-unit nat) "runtime/fkwu-optable.h")))) 64))

    ; 128 — the warm door is never offered as the cold one. `app` carries crystal
    ; 3 and `app-all` does not, so whichever order the pair was found in, `app-all`
    ; lands on the cold side and `app` on the warm.
    (let tw (twc-of pairs "app-all" "app"))
    (let c7 (tcb-bit (and (str_eq (twc-c-cold tw) "app-all")
                     (and (str_eq (twc-c-warm tw) "app")
                     (and (str_eq (twc-c-heat tw) "cold-and-warm")
                          (eq (len (twc-of pairs "app" "app-all")) 0)))) 128))

    ; 256 — how cold the cold one is, in the three numbers a decision needs:
    ; crystal against crystal, the calls, and the doors that would have to
    ; reroute. app-all is walked 483552 times at crystal -1 against app's 3.
    (let c8 (tcb-bit (and (eq (twc-c-cold-crystal tw) -1)
                     (and (eq (twc-c-warm-crystal tw) 3)
                     (and (eq (twc-c-cold-calls tw) 483552)
                          (eq (twc-c-warm-calls tw) 21547)))) 256))

    ; 512 — the fact the whole lens turns on. Heat counts WALKS, and a door that
    ; crystallizes stops walking, so `app-1` at 30,191,048 walks reads a thousand
    ; times hotter than `app` at 21,547 — and `app` is the warm one. A lens that
    ; ranked by heat would name the warm door as the cold one every time.
    (let c9 (tcb-bit (and (gt (twc-calls rows "app-1") (mul (twc-calls rows "app") 1000))
                     (and (eq (twc-warm? rows "app") 1)
                          (eq (twc-warm? rows "app-1") 0))) 512))

    ; 1024 — and crystal's states are not one thing: 1 and 2 are EARNED (the JIT
    ; compiled that body), 3 is GRANTED (the seed's recipe-twin table binds a few
    ; names at a fixed arity in a few named units). A warm side at 3 is warm
    ; because the seed knows its NAME, and the reader is told so rather than left
    ; to infer that the body's calls pooled there.
    (let c10 (tcb-bit (and (str_eq (twc-crystal-word 3 1) "seed-twinned by name")
                      (and (str_eq (twc-crystal-word 1 1) "jit-compiled from its own body")
                      (and (str_eq (twc-crystal-word 0 1) "held, still walking")
                      (and (str_eq (twc-crystal-word -1 1) "refused")
                           (str_eq (twc-crystal-word 3 0) "no-reading"))))) 1024))

    ; 2048 — an unmeasured door is no-reading, never cold. A zero reads as free,
    ; and reading free is how a door costing the world stays invisible; the same
    ; honesty the bearing census keeps, kept here for the same reason.
    (let c11 (tcb-bit (and (eq (twc-measured? rows "loner") 0)
                      (and (eq (twc-crystal rows "loner") -1)
                      (and (eq (twc-calls rows "loner") -1)
                      (and (eq (twc-warm? rows "loner") 0)
                           (str_eq (twc-crystal-word (twc-crystal rows "loner") (twc-measured? rows "loner")) "no-reading"))))) 2048))

    ; 4096 — when the two doors carry the same NAME, a name-keyed heat ledger
    ; cannot tell them apart, and the pair says so instead of picking one. The
    ; finding stands without the heat: one of two identical bodies under one name
    ; is dead weight whichever one the walker entered.
    (let c12 (tcb-bit (and (str_eq (twc-c-heat sh) "heat-ambiguous")
                     (and (eq (twc-c-chill sh) 21547)
                          (gt (str_len (twc-c-text sh)) 0))) 4096))

    ; 8192 — the standing name, and WHY it stands, because the three reasons are
    ; not one claim. Here a measured cold-against-warm pair exists, so it leads —
    ; and it leads with `app-1`, whose 30,191,048 cold walks outrank `app-all`'s
    ; 483,552 even though app-1 only PARTS from its warm side. That is the right
    ; order: the parting is one window wide and the window is the adapter. With
    ; the heat taken away the same census still stands on a body under two doors,
    ; and says that is why.
    (let cold-pairs (twc-census rows doors natives))
    (let no-heat (twc-census (list) doors natives))
    (let c13 (tcb-bit (and (str_eq (twc-standing-name cold-pairs) "app-1")
                      (and (str_eq (twc-standing-why cold-pairs) "a cold side measured against a crystallized one")
                      (and (str_eq (twc-standing-why no-heat) "one body standing under two doors; no crystallized side was measured")
                           (str_eq (twc-standing-name (list)) "no-twin-found")))) 8192))

    ; 16384 — the cost of closing a pair, and the counts the panel reads. `sites`
    ; is how many OTHER doors mention the cold name; a comment is not a call site,
    ; so the note naming app-1 in shared.fk draws nothing.
    (let c14 (tcb-bit (and (eq (twc-sites doors "app-1" (list "private.fk" "app-1" p-one) 0) 0)
                      (and (eq (twc-count-kind pairs "unproven" 0) 1)
                      (and (gt (twc-count-kind pairs "looks-identical" 0) 0)
                           (gt (twc-count-kind pairs "differs-at" 0) 0)))) 16384))

    ; 32768 — a body match survives the door's own recursion but not a different
    ; SHAPE: `idx-rec` walks an index where `app` walks a list, and no bucket,
    ; prefix or suffix makes them a pair. The lens declines rather than reaching.
    (let idx (tcb-body-of doors "private.fk" "idx-rec"))
    (let c15 (tcb-bit (and (str_eq (twc-p-kind (twc-verdict (list "private.fk" "idx-rec" idx) (list "shared.fk" "app" s-app))) "")
                      (and (eq (len (twc-of pairs "idx-rec" "app")) 0)
                           (str_eq idx "(if (eq @1 0) (head @0) (@s (tail @0) (sub @1 1)))"))) 32768))

    (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
