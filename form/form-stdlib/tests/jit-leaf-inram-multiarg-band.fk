; jit-leaf-inram-multiarg-band.fk — the multi-arg native lane RUNS in-process:
; the door's argument, extended 2026-09-02, is one even int (the standing
; contract, untouched) OR a list of ints handed to the page in x0..x7 per
; AAPCS64 — the convention lo-compile-fn-n banks from. The images carry the
; save/restore prologue that makes callee-saved banking honest to the C
; caller (the latent ABI wound form-lower-multiarg-band now pins healed),
; and the belt to those suspenders is the door's own x19..x28 fence.
;
; This is the first prerequisite of the crystallize course for the string
; worklist (fstr-find-loop wants h/n/hlen/nlen/i/b0 through this door);
; the remaining rungs — string-pointer passing, byte loads, loop lowering —
; stay named, not claimed.
;
; u32 domain (form-lower's w-registers): every case below stays small and
; nonnegative on purpose; the wall is the leaf-inram band's, already named.
;
; PROOF LEVEL: FOURTH-ARM ONLY — jit_leaf_inram binds on go too (pf-arm-mask 9, probed 2026-09-03) but go answers null here (witnessed); the
; siblings fold the name to nothing and every bit would read green blind.
;
; Verdict 63.
;
; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk
(do
    (defn jlm-score (ok bit) (if ok bit 0))
    ; f3(a,b,c) = (a*b)+c — the exact prog form-lower-multiarg-band pins bytes for
    (defn jlm-prog3 () (list
        (list 2 0 0 0) (list 2 1 0 0) (list 5 0 1 0) (list 2 2 0 0) (list 3 2 3 0)))
    (defn jlm-f3 (a b c) (add (mul a b) c))
    ; f2(a,b) = (a-b)*3
    (defn jlm-prog2 () (list
        (list 2 0 0 0) (list 2 1 0 0) (list 4 0 1 0) (list 1 3 0 0) (list 5 2 3 0)))
    (defn jlm-f2 (a b) (mul (sub a b) 3))
    ; 1-arg regression: f(n) = n*3 + 7, the leaf-inram band's own recipe/lane
    (defn jlm-prog1 () (list (list 1 7) (list 2) (list 1 3) (list 5 1 2) (list 3 3 0)))
    (defn jlm-f1 (n) (add (mul n 3) 7))
    ; sweep the 3-arg image against the walker twin (a,b,c derived from i)
    (defn jlm-agree3 (img i n bad)
        (if (ge i n) bad
            (jlm-agree3 img (add i 1) n
                (add bad (if (eq (jit_leaf_inram img (list i (add i 2) (mul i 3)))
                                 (jlm-f3 i (add i 2) (mul i 3))) 0 1)))))
    (defn jlm-agree2 (img i n bad)
        (if (ge i n) bad
            (jlm-agree2 img (add i 1) n
                (add bad (if (eq (jit_leaf_inram img (list (add i 9) i))
                                 (jlm-f2 (add i 9) i)) 0 1)))))
    (let img3 (lo-compile-fn-n (jlm-prog3) 4 3))
    (let img2 (lo-compile-fn-n (jlm-prog2) 4 2))
    (let img1 (lo-compile-fn (jlm-prog1) 4))
    ; the covering case the byte-pin band walks: (7*6)+5 = 47, RUN native
    (let c0 (jlm-score (eq (jit_leaf_inram img3 (list 7 6 5)) 47) 1))
    ; three args agree with the walker across a sweep
    (let c1 (jlm-score (eq (jlm-agree3 img3 0 200 0) 0) 2))
    ; two args bank, run, and agree the same way
    (let c2 (jlm-score (eq (jlm-agree2 img2 0 200 0) 0) 4))
    ; the standing one-int contract is untouched (regression, old lane)
    (let c3 (jlm-score (eq (jit_leaf_inram img1 5) 22) 8))
    ; nil is not an argument: the empty list DECLINES, never runs
    (let c4 (jlm-score (nothing? (jit_leaf_inram img3 (list))) 16))
    ; nine arguments do not fit eight registers: DECLINED, never truncated
    (let c5 (jlm-score (nothing? (jit_leaf_inram img3
        (list 1 2 3 4 5 6 7 8 9))) 32))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
