; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk
; preludes: form-stdlib/form-cli-turn-evidence-live.fk
;
; Pure parser/state band for the Form-native live carrier. Verdict 1023.

(defn fctelb-bit (truth bit) (if truth bit 0))

(do
    (let event
        "{\"timestamp\":\"2026-08-17T05:42:26.655Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"task_complete\",\"turn_id\":\"turn-1\"}}")
    (let output
        "{\"timestamp\":\"2026-08-17T05:42:26.655Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call_output\",\"call_id\":\"call-1\",\"output\":\"ok\\n@form fkwu 0 4 0 4\\n\"}}")
    (let measured (fctel-raw-output-measure output 1))
    (let state0 (fctel-state))
    (let state1 (fctel-set
        (fctel-set
        (fctel-set state0 0 3) 20 (list (list "call-1" 1))) 21 "gpt-test"))
    (let progress (split-on (fctel-progress-row "turn-1" 42 state1) "|"))
    (let state2 (fctel-progress-state progress))
    (sum (list
        (fctelb-bit (str_eq (fctel-source-kind)
            "codex-rollout-jsonl+explicit-form-binding") 1)
        (fctelb-bit (eq (fctel-iso-ms "1970-01-02T00:00:00.000Z") 86400000) 2)
        (fctelb-bit (str_eq (fctel-top-type event) "event_msg") 4)
        (fctelb-bit (str_eq (fctel-payload-type event) "task_complete") 8)
        (fctelb-bit (eq (fctel-line-event? event "task_complete" "turn-1") 1) 16)
        (fctelb-bit (eq (nth measured 1) 1) 32)
        (fctelb-bit (eq (nth measured 6) 1) 64)
        (fctelb-bit (eq (nth measured 5) 4) 128)
        (fctelb-bit (eq (nth measured 2) 0) 256)
        (fctelb-bit (and (eq (nth state2 0) 3)
            (and (str_eq (nth state2 21) "gpt-test")
                 (eq (nth (head (nth state2 20)) 1) 1))) 512))))
