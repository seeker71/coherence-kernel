; qwen4exp-flash-next-state-band.fk — pure ownership, prefix reuse, and
; resident substate handle lookup.  Full evaluation is the token parity band's
; responsibility; this band never allocates the 79 GB model.
;
; preludes: form/native/metal/qwen4exp-flash-next-token-handle.fk form/form-stdlib/qwen4exp-flash-next-state.bml
;
; Verdict 1023: 511 executable + 512 high-BML authority.

(do
    (defn q4sb-has (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (defn q4sb-states (n acc)
        (if (ge n 48) (reverse acc)
            (q4sb-states (add n 1) (cons (list (add 100 n) (add 200 n) (add 300 n) (add 400 n)) acc))))
    (defn q4sb-bufs (n acc)
        (if (ge n 49) (reverse acc) (q4sb-bufs (add n 1) (cons (add 900 n) acc))))
    (let ctx (list 0 0 0 (q4sb-bufs 0 (empty)) 0 0 (q4sb-states 0 (empty)) 16))
    (let slot (q4s-slot "fixture-" ctx 16 3 13 12 (list 10 11 12) 13 "fixture"))
    (let exact (q4s-prefix-lookup slot (list 10 11 12)))
    (let extend (q4s-prefix-lookup slot (list 10 11 12 13 14)))
    (let miss (q4s-prefix-lookup slot (list 10 99)))
    (let c0 (if (and (str_eq (q4s-lookup-status exact) "exact") (eq (q4s-lookup-reused exact) 3)) 1 0))
    (let c1 (if (and (str_eq (q4s-lookup-status extend) "append") (eq (q4s-lookup-reused extend) 3)) 2 0))
    (let c2 (if (and (eq (len (q4s-lookup-delta extend)) 2) (eq (head (q4s-lookup-delta extend)) 13)) 4 0))
    (let c3 (if (and (str_eq (q4s-lookup-status miss) "miss") (eq (q4s-lookup-reused miss) 0)) 8 0))
    (let c4 (if (eq (q4s-substate-handle (q4s-state-lookup slot 7 "gdn")) 207) 16 0))
    (let c5 (if (eq (q4s-substate-handle (q4s-state-lookup slot 7 "key")) 307) 32 0))
    (let c6 (if (eq (q4s-substate-handle (q4s-state-lookup slot 0 "ple-history")) 948) 64 0))
    (let c7 (if (and (eq (q4s-substate-handle (q4s-state-lookup slot 0 "position")) 3) (str_eq (q4s-substate-status (q4s-state-lookup slot 99 "key")) "miss")) 128 0))
    (let executable (read_file "form/form-stdlib/qwen4exp-flash-next-state.bml"))
    (let c8 (if (and (eq (q4sb-has executable "def q4s-prefill-delta(slot, tokens)") 1)
                            (if (eq (q4sb-has executable "let ingested = q4t-ingest(") 1)
                                (if (eq (q4sb-has executable "def q4s-residency-handle(slot)") 1)
                                    (eq (q4sb-has executable "def q4s-resident?(slot)") 1) 0) 0)) 256 0))
    (let base (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 c8)))))))))
    (let src (read_file "form/form-stdlib/bml/qwen4exp-flash-next-state.bml"))
    (let authority
        (if (eq (q4sb-has src "const String LookupRule = \"exact-or-extending-prefix-reuses; divergence-resets\"") 1)
            (if (eq (q4sb-has src "const String Substates = \"position,tokens,ple-history,conv,gdn,key,value\"") 1)
                (if (eq (q4sb-has src "const String PrefillRule = \"ingest-all-but-final; evaluate-final-once\"") 1)
                    (if (eq (q4sb-has src "const int Layers = 48") 1)
                        (if (eq (q4sb-has src "const String ResidencyRule = \"physical residence requires positive mmap-backed embedding and scratch Metal handles\"") 1) 512 0) 0) 0) 0) 0))
    (add base authority))
