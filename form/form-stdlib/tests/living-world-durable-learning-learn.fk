; Second process: restore the seed, meet genuinely new outside observation,
; integrate only a revision proposal, and persist two recurrent predictions
; beside the retained below-threshold alternative, still OPEN with no primary.
; Verdict 65535 proves sixteen restoration, learning, option, and carrier claims.
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk form-stdlib/tests/living-world-durable-learning-witness.fk

(do
    (let loaded (lwdlw-load-image (lwdlw-before-path)))
    (let image (lwcd-result-image loaded))
    (let restored-round (lwdlw-restored-round image))
    (let restored (lwt-round-world restored-round))
    (let executions (lwdlw-current-executions restored))
    (let execution (lwdlw-only executions))
    (let observation (lwdlw-observation-for execution))
    (let learning-round
        (lwdlw-learning-round restored execution restored-round))
    (let learned (lwt-round-world learning-round))
    (let learning-candidates (lwdlw-current-learning learned 2))
    (let learning-candidate (lwdlw-only learning-candidates))
    (let learning (lwo-emergent-shape learning-candidate))
    (let revision (lwac-learning-revision learning))
    (let two-world
        (lwdlw-two-predictions-world learned learning-candidate))
    (let field (lwacw-field-for two-world))
    (let eligible
        (lwac-eligible-items two-world
            (lwo-field-items (lwac-field-candidates field)) 2
            (lwo-empty-field)))
    (let saved (lwdlw-save-image (lwdlw-after-path) two-world))
    (lwdlw-sum
        (list
            (if (eq (lwcd-loaded? loaded) 1) 1 0)
            (if (eq (lwcn-image-valid? image) 1) 2 0)
            (if (eq (lwo-field-size executions) 1) 4 0)
            (if (eq (lwac-execution-integrated-current?
                        restored execution) 1) 8 0)
            (if (node_eq
                    (lwac-execution-prediction
                        (lwo-emergent-shape execution))
                    (lwacw-wrong-delta)) 16 0)
            (if (eq (lwo-active? restored observation) 0) 32 0)
            (if (and (eq (lwo-active-by? learned observation
                              (lwacw-source-h)) 1)
                     (eq (lwo-active-by? learned observation
                              (lwacw-source-i)) 1)) 64 0)
            (if (eq (lwo-field-size learning-candidates) 1) 128 0)
            (if (eq (lwac-revise?
                        (lwac-learning-state learning)) 1) 256 0)
            (if (node_eq (lwac-revision-prior revision)
                         (lwacw-wrong-delta)) 512 0)
            (if (node_eq (lwac-revision-proposed revision)
                         (lwacw-actual-delta)) 1024 0)
            (if (gt (lwo-field-size
                        (lwac-learning-alternative-field learning)) 0)
                2048 0)
            (if (gt (lwo-field-size
                        (lwac-learning-unknowns-field learning)) 0)
                4096 0)
            (if (not (node_eq (lwac-learning-time learning)
                              (lwo-none))) 8192 0)
            (if (and (eq (lwac-open? (lwac-field-status field)) 1)
                     (and (eq (lwo-field-size
                                (lwac-field-candidates field)) 3)
                          (and (eq (lwo-field-size eligible) 2)
                               (node_eq (lwac-field-primary field)
                                        (lwo-none))))) 16384 0)
            (if (and (eq (lwcd-saved? saved) 1)
                     (eq (fs-exists? (lwdlw-after-path)) 1)) 32768 0))))
