; form-cli-plan-memory-band.bml — the planner's ledger read as a memory of each refusal (form-cli-plan-memory.bml),
; retained beside the planner's current way (form-cli-local-plan.bml, flp-remembered, flp-memory-pairs), with no model.
;
; Verdict 16383 when every claim lands:
;   1    a root is the refusal's kind up to its ':'; a kind with none is its own root
;   2    an option that answered a refusal of its request is one attempt: its root, its way and what Form observed;
;        a first option, a recheck and a voice that could not open are none
;   4    the same root with more cases held reads rose, another root reads moved, a landed plan reads verified
;   8    a prediction needs three attempts over two requests: two attempts, or three of one request, read nothing
;   16   an unobserved alternative remains nothing beside an observed historical reading
;   32   unrelated history leaves the present resume intact and retains its reading; a repeated current failure
;        still changes the lens, and an empty current walk still begins first
;   64   an option's row keeps the root it answered, the prediction and what Form observed of it
;   128  the calibration counts the rows that carry a prediction against what they observed
;   256  two checkouts' ledgers are gathered each on its own: a request both walked is not paired across them, and
;        the refusals rank by root
;   512  a failed run is heard as the compiler's words: a warning reading and the line of another build's image leave
;   1024 a name the manifest lists and the reference never writes (a native, a path) leaves the manifest and the plan
;        reads on; a reference that writes none of the names keeps its reading
;   2048 a request whose own stated examples all answer as it says on today's files reads healed with no model; one
;        wrong example, or a single example, leaves it open
;   4096 a definition the request names that the changed definition calls in the reference is kept; one the plan
;        calls nowhere still reads request-definition
;   8192 a witness whose cases name a probe under .hearth/ removes that probe's files before its cases run, so a
;        file an earlier run left is not read; the planner's own directory and a plain case sweep nothing
; preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-local-plan.bml form-stdlib/bml/live.bml
section [form.bml] {
 class FormCliPlanMemoryBand {
  def pmb-line(req, rung, verdict, kind, held) = "{\"request\":\"" ++ req ++ "\",\"rung\":\"" ++ rung ++ "\",\"verdict\":\"" ++ verdict ++ "\",\"kind\":\"" ++ kind ++ "\"" ++ (held < 0 ? "" : ",\"cases_held\":" ++ held.str()) ++ "}";
  def pmb-row(req, rung, verdict, kind, held) = parse-json("row", pmb-line(req, rung, verdict, kind, held));
  // two requests whose resumes left band-no-number standing three times, and a third whose resume moved it
  def pmb-lines() = [pmb-line("a", "first", "refused", "band-no-number:x", -1), pmb-line("a", "resume", "refused", "band-no-number:y", -1), pmb-line("a", "resume", "refused", "band-no-number:z", -1), pmb-line("b", "first", "refused", "band-no-number:x", -1), pmb-line("b", "resume", "refused", "band-no-number:x", -1)];
  def pmb-rows() = map(l => parse-json("row", l), pmb-lines());
  def pmb-entries() = fpm-entries(fpm-attempts(pmb-rows()));
  def pmb-c-root(ctx) = ((String) fpm-root("request-definition:wfp-admit") == "request-definition") && ((String) fpm-root("unreachable") == "unreachable") && ((String) fpm-root("") == "");
  def pmb-c-attempts(ctx) {
   let rows = [pmb-row("a", "first", "refused", "unreachable", -1), pmb-row("a", "recheck", "refused", "unreachable", -1), pmb-row("a", "resume", "refused", "voice-unavailable", -1), pmb-row("a", "lens", "refused", "cases-shape:n", -1), pmb-row("b", "first", "refused", "unreachable", -1), pmb-row("a", "first", "refused", "unreachable", -1)];
   let got = fpm-attempts(rows);
   (len(got) == 1) && ((String) got[0][0] == "unreachable") && ((String) got[0][1] == "lens") && ((String) got[0][2] == "moved") && ((String) got[0][3] == "a");
  }
  def pmb-c-outcome(ctx) = ((String) fpm-outcome("unreachable", 2, "refused", "unreachable", 3) == "rose") && ((String) fpm-outcome("unreachable", 2, "refused", "unreachable", 2) == "same") && ((String) fpm-outcome("unreachable", nothing(), "refused", "unreachable", 3) == "same") && ((String) fpm-outcome("unreachable", 2, "refused", "cases-shape:n", nothing()) == "moved") && ((String) fpm-outcome("unreachable", 2, "verified", "", nothing()) == "verified") && ((String) fpm-outcome("unreachable", 2, "moot", "", nothing()) == "verified");
  def pmb-c-support(ctx) {
   let three = fpm-predict(pmb-entries(), "band-no-number", "resume");
   let two = fpm-predict(fpm-entries(fpm-attempts(take(4, pmb-rows()))), "band-no-number", "resume");
   let one = [pmb-row("a", "first", "refused", "unreachable", -1), pmb-row("a", "resume", "refused", "unreachable", -1), pmb-row("a", "resume", "refused", "unreachable", -1), pmb-row("a", "resume", "refused", "unreachable", -1)];
   !nothing?(three) && (three[0] == 1000) && (three[1] == 3) && nothing?(two) && nothing?(fpm-predict(fpm-entries(fpm-attempts(one)), "unreachable", "resume")) && nothing?(fpm-predict(pmb-entries(), "unreachable", "resume"));
  }
  def pmb-c-unobserved(ctx) {
   let moved = append(pmb-rows(), [pmb-row("c", "first", "refused", "cases-shape:n", -1), pmb-row("c", "resume", "refused", "unreachable", -1), pmb-row("d", "first", "refused", "cases-shape:n", -1), pmb-row("d", "resume", "refused", "unreachable", -1), pmb-row("d", "first", "refused", "cases-shape:n", -1), pmb-row("d", "resume", "refused", "unreachable", -1)]);
   let e = fpm-entries(fpm-attempts(moved));
   fpm-predict(e,"band-no-number","resume")[0]==1000 && fpm-predict(e,"cases-shape","resume")[0]==0 && nothing?(fpm-predict(e,"band-no-number","lens")) && nothing?(fpm-predict(e,"unreachable","resume"));
  }
  def pmb-memory(kind) = [["refused: " ++ kind, kind, "band-first", "voice-a", "a reply", pmb-row("z", "first", "refused", kind, -1), 0, 0]];
  def pmb-ctx(root) = flp-ctx(nothing(), ["voice-a"], 1, root ++ "/queue.jsonl", root ++ "/land", root ++ "/scratch", root ++ "/ledger.jsonl", 120000);
  def pmb-c-way(ctx) {
   let full = ctx ++ "/full"; let made = flp-mkdirs(full);
   let wrote = write_file_text(full ++ "/ledger.jsonl", flp-join(pmb-lines(), "\n") ++ "\n");
   let empty = ctx ++ "/empty"; let also = flp-mkdirs(empty);
   let way = flp-choice(pmb-memory("band-no-number:q"), pmb-ctx(full));
   let plain = flp-choice(pmb-memory("band-no-number:q"), pmb-ctx(empty));
   let first = flp-choice([], pmb-ctx(full));
   let repeated=flp-choice(append(pmb-memory("band-no-number:q"),pmb-memory("band-no-number:q")),pmb-ctx(full));
   ((String) way[2] == "resume") && ((String) way[1] == "band-first") && ((String) way[3] == "band-no-number") && ((String) way[6] == "") && way[5][0]==1000 && way[5][1]==3
    && ((String) plain[2] == "resume") && ((String) plain[6] == "") && nothing?(plain[5]) && (len(first) == 3) && ((String) first[2] == "first") && ((String) repeated[2]=="lens") && ((String) repeated[1]=="narrow");
  }
  def pmb-c-row(ctx) {
   let req = parse-json("req", "{\"id\":\"pmb-fixture\",\"needs\":\"n\"}");
   let way = ["voice-a", "band-first", "resume", "band-no-number", nothing(), [1000, 3], ""];
   let row = flp-option-row(req, 2, way, flp-refused(6, "band-no-number:q", "no number"), [], ["answered", "t", 1, 1], now_unix_ms(), "s");
   let moved = flp-option-row(req, 2, way, flp-refused(6, "cases-shape:n", "shape"), [], ["answered", "t", 1, 1], now_unix_ms(), "s");
   let unheard = flp-option-row(req, 2, way, flp-refused(6, "voice-unavailable", "held"), [], ["unavailable", "", 0, 0], now_unix_ms(), "s");
   let bare = flp-option-row(req, 1, ["voice-a", "band-first", "first"], flp-refused(6, "cases-shape:n", "shape"), [], ["answered", "t", 1, 1], now_unix_ms(), "s");
   ((String) fcgp-str(row, "answers_root") == "band-no-number") && (fcgp-num(row, "predicted_still_pm") == 1000) && (fcgp-num(row, "predicted_support") == 3) && ((String) fcgp-str(row, "observed") == "same")
    && ((String) fcgp-str(moved, "observed") == "moved") && ((String) fcgp-str(unheard, "observed") == "unheard") && !json-object-has?(bare, "answers_root");
  }
  def pmb-c-kin(ctx) {
   let one = ctx ++ "/kin-one.jsonl"; let two = ctx ++ "/kin-two.jsonl";
   let a = write_file_text(one, pmb-line("a", "first", "refused", "band-no-number:x", -1) ++ "\n" ++ pmb-line("a", "resume", "refused", "band-no-number:y", -1) ++ "\n");
   let b = write_file_text(two, pmb-line("a", "resume", "refused", "unreachable", -1) ++ "\n" ++ pmb-line("b", "first", "verified", "", -1) ++ "\n");
   let g = fpm-gathered([one, two], flp-queue-rows);
   let ranked = fpm-ranked(g[1]);
   (len(g[0]) == 1) && ((String) g[0][0][0] == "band-no-number") && ((String) g[0][0][2] == "same") && (g[3] == 4) && (g[4] == 1)
    && (len(ranked) == 2) && ((String) ranked[0][0] == "band-no-number") && (ranked[0][1] == 2) && (ranked[1][1] == 1);
  }
  def pmb-c-heard(ctx) {
   let organ = "form-organ health {\"schema\":\"organ-health-v1\",\"stage\":\"observe\",\"observed\":\"compile-warning\",\"evidence\":{\"reason\":\"image admission failed\"}}";
   let heard = flp-heard-err("fkwu: warning: x.bml: image admission failed (written by a different fkwu build); rebuilding\n" ++ organ ++ "\nfkwu: error: x.bml: [unresolved-call] 'str' matched nothing\n");
   (str_find(heard, "[unresolved-call] 'str'", 0) >= 0) && (str_find(heard, "form-organ", 0) < 0) && (str_find(heard, "image admission", 0) < 0) && ((String) flp-heard-err("") == "");
  }
  def pmb-c-unwritten(ctx) {
   let door = "form/form-stdlib/tests/fixtures/local-plan-door-flow.bml";
   let plan = d => parse-json("plan", "{\"id\":\"pmb-u\",\"writable\":[\"" ++ door ++ "\"],\"definitions\":[" ++ d ++ "]}");
   let ref = "def lpdf-rows(x) = [x, x, x];";
   let pruned = flp-written-only(plan("{\"name\":\"lpdf-rows\",\"params\":[\"x\"]},{\"name\":\"str_find\"},{\"name\":\"docs/a.md\"}"), ref);
   let whole = flp-written-only(plan("{\"name\":\"lpdf-rows\",\"params\":[\"x\"]}"), ref);
   let none = flp-written-only(plan("{\"name\":\"str_find\"}"), ref);
   let names = o => map(d => d[0], flp-defs-of(o, [door]));
   let parsed = flp-cases-parsed(plan("{\"name\":\"lpdf-rows\",\"params\":[\"x\"]},{\"name\":\"str_find\"}"), "lpdf-rows holds three", parse-json("cases", "[{\"function\":\"lpdf-rows\",\"arguments\":[3],\"equals\":[3,3,3]}]"), ref);
   (len(names(pruned)) == 1) && ((String) names(pruned)[0] == "lpdf-rows") && (len(names(whole)) == 1) && (len(names(none)) == 1) && !flp-starts?((String) parsed[0], "reference-missing")
    && flp-starts?((String) flp-cases-parsed(plan("{\"name\":\"str_find\"}"), "g", parse-json("cases", "[{\"function\":\"len\",\"arguments\":[[1]],\"equals\":1}]"), ref)[0], "reference-missing");
  }
  def pmb-c-examples(ctx) {
   let door = "form/form-stdlib/tests/fixtures/local-plan-door-flow.bml";
   let needs = "lpdf-rows holds each value twice when lpdf-rows(x) answers a list: lpdf-rows(3) answers [3, 3], and len([1, (2)]) still answers 2 the way str_find(\"a(b\", \"(\", 0) answers 1.";
   let ex = flp-examples(needs);
   let req = n => parse-json("req", json-emit(json-node-object([fhn-s("id", "pmb-examples"), fhn-s("needs", n), json-node-pair("files", json-node-array([json-node-string(door)]))])));
   let wrong = "lpdf-rows(3) answers [3, 3, 3], and len([1]) answers 1.";
   let nested = flp-examples("len(append([1], [2])) answers 2, and len(xs) answers 3.");
   (len(nested) == 1) && ((String) nested[0][0] == "len(append([1], [2]))") && (len(ex) == 3) && ((String) ex[0][0] == "lpdf-rows(3)") && ((String) ex[0][1] == "[3, 3]") && ((String) ex[1][0] == "len([1, (2)])") && ((String) ex[1][1] == "2") && ((String) ex[2][0] == "str_find(\"a(b\", \"(\", 0)") && ((String) ex[2][1] == "1")
    && flp-starts?(flp-healed-reading(req(needs)), "examples-hold: all 3") && ((String) flp-healed-reading(req(wrong)) == "") && ((String) flp-healed-reading(req("lpdf-rows(3) answers [3, 3].")) == "");
  }
  def pmb-c-called(ctx) {
   let door = "form/form-stdlib/tests/fixtures/local-plan-door-flow.bml";
   let req = parse-json("req", "{\"id\":\"pmb-called\",\"needs\":\"lpdf-rows holds three and lpdf-flow counts them\",\"files\":[\"" ++ door ++ "\"]}");
   let reply = ref => "<plan>{\"id\":\"pmb-called\",\"writable\":[\"" ++ door ++ "\"],\"definitions\":[{\"name\":\"lpdf-rows\",\"params\":[\"x\"]}]}</plan><goal>The change: lpdf-rows.</goal><cases>[{\"function\":\"lpdf-rows\",\"arguments\":[1],\"equals\":[1,1,1]}]</cases><reference>" ++ ref ++ "</reference>";
   let kept = ref => flp-request-kept(flp-parse(reply(ref))[2], req);
   let adds = parse-json("req", "{\"id\":\"pmb-adds\",\"needs\":\"add lpdf-thrice(x), which answers lpdf-rows(x) with x once more\",\"files\":[\"" ++ door ++ "\"]}");
   let added = name => flp-request-kept(flp-parse("<plan>{\"id\":\"pmb-adds\",\"writable\":[\"" ++ door ++ "\"],\"definitions\":[{\"name\":\"" ++ name ++ "\",\"params\":[\"x\"]}]}</plan><goal>The change: " ++ name ++ ".</goal><cases>[{\"function\":\"" ++ name ++ "\",\"arguments\":[1],\"equals\":[1,1,1]}]</cases><reference>def " ++ name ++ "(x) = append(lpdf-rows(x), [x]);</reference>")[2], adds);
   flp-held?(kept("def lpdf-rows(x) { let n = lpdf-flow(x); [x, x, x]; }")) && flp-starts?((String) kept("def lpdf-rows(x) = [x, x, x];")[1], "request-definition:lpdf-flow")
    && flp-held?(added("lpdf-thrice")) && flp-starts?((String) added("lpdf-other")[1], "request-definition:")
    // an addition written beside a standing definition it is only compared with has kept the request
    && flp-held?(flp-request-kept(flp-parse("<plan>{\"id\":\"pmb-styled\",\"writable\":[\"" ++ door ++ "\"],\"definitions\":[{\"name\":\"lpdf-thrice\",\"params\":[\"x\"]}]}</plan><goal>The change: lpdf-thrice.</goal><cases>[{\"function\":\"lpdf-thrice\",\"arguments\":[1],\"equals\":[1,1,1]}]</cases><reference>def lpdf-thrice(x) = [x, x, x];</reference>")[2], parse-json("req", "{\"id\":\"pmb-styled\",\"needs\":\"add lpdf-thrice(x), three of x, written the way lpdf-flow is written\",\"files\":[\"" ++ door ++ "\"]}")));
  }
  def pmb-c-probe(ctx) {
   let obj = parse-json("plan", "{\"id\":\"pmb-probe\",\"writable\":[\"form/form-stdlib/tests/fixtures/local-plan-door-flow.bml\"]}");
   let cases = text => json-array-elements(parse-json("cases", text));
   let name = "pmb-probe-" ++ now_unix_ms().str();
   let left = write_file_text(".hearth/" ++ name ++ ".side", "100");
   let band = flp-cases-band(obj, cases("[{\"function\":\"file_size\",\"arguments\":[\".hearth/" ++ name ++ ".side\"],\"equals\":-1},{\"function\":\"len\",\"arguments\":[\".hearth/local-plans\"],\"equals\":19},{\"function\":\"len\",\"arguments\":[\".hearth/" ++ name ++ "\"],\"equals\":" ++ (len(name) + 8).str() ++ "}]"));
   let path = ctx ++ "/probe-band.bml";
   let put = flp-put(path, band);
   let r = flp-band-run(path, 120000);
   let plain = flp-cases-band(obj, cases("[{\"function\":\"len\",\"arguments\":[[1]],\"equals\":1}]"));
   (len(flp-probe-names(cases("[{\"function\":\"len\",\"arguments\":[\".hearth/" ++ name ++ "\",\".hearth/local-plans\",\".hearth/a/b\",\"x\"],\"equals\":1}]"))) == 1) && (str_find(plain, "host_path_remove", 0) < 0) && (r[0] == 1) && (file_size(".hearth/" ++ name ++ ".side") < 0);
  }
  def pmb-c-calibration(ctx) {
   let p = (pm, observed) => parse-json("row", "{\"request\":\"a\",\"rung\":\"resume\",\"verdict\":\"refused\",\"kind\":\"unreachable\",\"predicted_still_pm\":" ++ pm ++ ",\"observed\":\"" ++ observed ++ "\"}");
   let c = fpm-calibration([p("1000", "same"), p("1000", "moved"), p("400", "same"), p("400", "verified"), p("400", "unheard"), pmb-row("a", "resume", "refused", "unreachable", -1)]);
   (c[0] == 4) && (c[1] == 2) && (c[2] == 1) && (c[3] == 2) && (c[4] == 1);
  }
 }
 let root = ".hearth/plan-memory-band-" ++ now_unix_ms().str();
 let made = flp-mkdirs(root);
 let verdict = live-claims("form-cli-plan-memory-band", root, [["root", 1, 1, pmb-c-root], ["attempts", 2, 1, pmb-c-attempts], ["outcome", 4, 1, pmb-c-outcome], ["support", 8, 1, pmb-c-support], ["unobserved", 16, 1, pmb-c-unobserved], ["way", 32, 1, pmb-c-way], ["row", 64, 1, pmb-c-row], ["calibration", 128, 1, pmb-c-calibration], ["kin", 256, 1, pmb-c-kin], ["heard", 512, 1, pmb-c-heard], ["unwritten", 1024, 1, pmb-c-unwritten], ["examples", 2048, 1, pmb-c-examples], ["called", 4096, 1, pmb-c-called], ["probe", 8192, 1, pmb-c-probe]]);
 host_dir_rmdir(root);
 verdict;
}
