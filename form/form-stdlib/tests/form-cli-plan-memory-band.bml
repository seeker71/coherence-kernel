; form-cli-plan-memory-band.bml — the planner's ledger read as a memory of each refusal (form-cli-plan-memory.bml),
; and the planner choosing its way by it (form-cli-local-plan.bml, flp-remembered, flp-memory-pairs), with no model.
;
; Verdict 255 when every claim lands:
;   1    a root is the refusal's kind up to its ':'; a kind with none is its own root
;   2    an option that answered a refusal of its request is one attempt: its root, its way and what Form observed;
;        a first option, a recheck and a voice that could not open are none
;   4    the same root with more cases held reads rose, another root reads moved, a landed plan reads verified
;   8    a prediction needs three attempts over two requests: two attempts, or three of one request, read nothing
;   16   a resume on record worse than an untried lens swerves; one on record better than the lens keeps the resume
;   32   the planner's way after such a refusal is the lens, noted resume-skipped, and carries the root and the
;        prediction; with an empty ledger the ladder's resume stands
;   64   an option's row keeps the root it answered, the prediction and what Form observed of it
;   128  the calibration counts the rows that carry a prediction against what they observed
; preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-local-plan.bml form-stdlib/bml/live.bml
section [form.bml] {
 class FormCliPlanMemoryBand {
  def pmb-line(req, rung, verdict, kind, held) = "{\"request\":\"" ++ req ++ "\",\"rung\":\"" ++ rung ++ "\",\"verdict\":\"" ++ verdict ++ "\",\"kind\":\"" ++ kind ++ "\"" ++ (held < 0 ? "" : ",\"cases_held\":" ++ held.str()) ++ "}";
  def pmb-row(req, rung, verdict, kind, held) = parse-json("row", pmb-line(req, rung, verdict, kind, held));
  // two requests whose resumes left band-no-number standing three times, and a third whose resume moved it
  def pmb-lines() = [pmb-line("a", "first", "refused", "band-no-number:x", -1), pmb-line("a", "resume", "refused", "band-no-number:y", -1), pmb-line("a", "resume", "refused", "band-no-number:z", -1), pmb-line("b", "first", "refused", "band-no-number:x", -1), pmb-line("b", "resume", "refused", "band-no-number:x", -1)];
  def pmb-rows() = map(l => parse-json("row", l), pmb-lines());
  def pmb-entries() = fpm-entries(fpm-attempts(pmb-rows()));
  def pmb-c-root(ctx) = ((String) fpm-root("request-definition:wfp-admit") == "request-definition") && ((String) fpm-root("unreachable") == "unreachable") && ((String) fpm-root("") == "");
  def pmb-c-attempts(ctx) {
   let rows = [pmb-row("a", "first", "refused", "unreachable", -1), pmb-row("a", "recheck", "refused", "unreachable", -1), pmb-row("a", "resume", "refused", "voice-unavailable", -1), pmb-row("a", "lens", "refused", "cases-shape:n", -1), pmb-row("b", "first", "refused", "unreachable", -1), pmb-row("a", "first", "refused", "unreachable", -1)];
   let got = fpm-attempts(rows);
   (len(got) == 1) && ((String) got[0][0] == "unreachable") && ((String) got[0][1] == "lens") && ((String) got[0][2] == "moved") && ((String) got[0][3] == "a");
  }
  def pmb-c-outcome(ctx) = ((String) fpm-outcome("unreachable", 2, "refused", "unreachable", 3) == "rose") && ((String) fpm-outcome("unreachable", 2, "refused", "unreachable", 2) == "same") && ((String) fpm-outcome("unreachable", nothing(), "refused", "unreachable", 3) == "same") && ((String) fpm-outcome("unreachable", 2, "refused", "cases-shape:n", nothing()) == "moved") && ((String) fpm-outcome("unreachable", 2, "verified", "", nothing()) == "verified") && ((String) fpm-outcome("unreachable", 2, "moot", "", nothing()) == "verified");
  def pmb-c-support(ctx) {
   let three = fpm-predict(pmb-entries(), "band-no-number", "resume");
   let two = fpm-predict(fpm-entries(fpm-attempts(take(4, pmb-rows()))), "band-no-number", "resume");
   let one = [pmb-row("a", "first", "refused", "unreachable", -1), pmb-row("a", "resume", "refused", "unreachable", -1), pmb-row("a", "resume", "refused", "unreachable", -1), pmb-row("a", "resume", "refused", "unreachable", -1)];
   !nothing?(three) && (three[0] == 1000) && (three[1] == 3) && nothing?(two) && nothing?(fpm-predict(fpm-entries(fpm-attempts(one)), "unreachable", "resume")) && nothing?(fpm-predict(pmb-entries(), "unreachable", "resume"));
  }
  def pmb-c-swerve(ctx) {
   let moved = append(pmb-rows(), [pmb-row("c", "first", "refused", "cases-shape:n", -1), pmb-row("c", "resume", "refused", "unreachable", -1), pmb-row("d", "first", "refused", "cases-shape:n", -1), pmb-row("d", "resume", "refused", "unreachable", -1), pmb-row("d", "first", "refused", "cases-shape:n", -1), pmb-row("d", "resume", "refused", "unreachable", -1)]);
   let e = fpm-entries(fpm-attempts(moved));
   fpm-swerve?(e, "band-no-number", "resume", "lens") && !fpm-swerve?(e, "cases-shape", "resume", "lens") && !fpm-swerve?(e, "unreachable", "resume", "lens");
  }
  def pmb-memory(kind) = [["refused: " ++ kind, kind, "band-first", "voice-a", "a reply", pmb-row("z", "first", "refused", kind, -1), 0, 0]];
  def pmb-ctx(root) = flp-ctx(nothing(), ["voice-a"], 1, root ++ "/queue.jsonl", root ++ "/land", root ++ "/scratch", root ++ "/ledger.jsonl", 120000);
  def pmb-c-way(ctx) {
   let full = ctx ++ "/full"; let made = flp-mkdirs(full);
   let wrote = write_file_text(full ++ "/ledger.jsonl", flp-join(pmb-lines(), "\n") ++ "\n");
   let empty = ctx ++ "/empty"; let also = flp-mkdirs(empty);
   let way = flp-choice(pmb-memory("band-no-number:q"), pmb-ctx(full));
   let plain = flp-choice(pmb-memory("band-no-number:q"), pmb-ctx(empty));
   let first = flp-choice([], pmb-ctx(full));
   ((String) way[2] == "lens") && ((String) way[1] == "narrow") && ((String) way[3] == "band-no-number") && ((String) way[6] == "resume-skipped") && nothing?(way[5])
    && ((String) plain[2] == "resume") && ((String) plain[6] == "") && nothing?(plain[5]) && (len(first) == 3) && ((String) first[2] == "first");
  }
  def pmb-c-row(ctx) {
   let req = parse-json("req", "{\"id\":\"pmb-fixture\",\"needs\":\"n\"}");
   let way = ["voice-a", "band-first", "resume", "band-no-number", nothing(), [1000, 3], ""];
   let row = flp-option-row(req, 2, way, flp-refused(6, "band-no-number:q", "no number"), [], ["answered", "t", 1, 1], now_unix_ms(), "s");
   let moved = flp-option-row(req, 2, way, flp-refused(6, "cases-shape:n", "shape"), [], ["answered", "t", 1, 1], now_unix_ms(), "s");
   let unheard = flp-option-row(req, 2, way, flp-refused(6, "voice-unavailable", "held"), [], ["unavailable", "", 0, 0], now_unix_ms(), "s");
   let bare = flp-option-row(req, 1, ["voice-a", "band-first", "first"], flp-refused(6, "cases-shape:n", "shape"), [], ["answered", "t", 1, 1], now_unix_ms(), "s");
   ((String) fcgp-str(row, "answers_root") == "band-no-number") && (fcgp-num(row, "predicted_still_pm") == 1000) && (fcgp-num(row, "predicted_support") == 3) && ((String) fcgp-str(row, "observed") == "same")
    && ((String) fcgp-str(moved, "observed") == "moved") && ((String) fcgp-str(unheard, "observed") == "unheard") && !json-object-has?(bare, "answers_root");
  }
  def pmb-c-calibration(ctx) {
   let p = (pm, observed) => parse-json("row", "{\"request\":\"a\",\"rung\":\"resume\",\"verdict\":\"refused\",\"kind\":\"unreachable\",\"predicted_still_pm\":" ++ pm ++ ",\"observed\":\"" ++ observed ++ "\"}");
   let c = fpm-calibration([p("1000", "same"), p("1000", "moved"), p("400", "same"), p("400", "verified"), p("400", "unheard"), pmb-row("a", "resume", "refused", "unreachable", -1)]);
   (c[0] == 4) && (c[1] == 2) && (c[2] == 1) && (c[3] == 2) && (c[4] == 1);
  }
 }
 let root = ".hearth/plan-memory-band-" ++ now_unix_ms().str();
 let made = flp-mkdirs(root);
 let verdict = live-claims("form-cli-plan-memory-band", root, [["root", 1, 1, pmb-c-root], ["attempts", 2, 1, pmb-c-attempts], ["outcome", 4, 1, pmb-c-outcome], ["support", 8, 1, pmb-c-support], ["swerve", 16, 1, pmb-c-swerve], ["way", 32, 1, pmb-c-way], ["row", 64, 1, pmb-c-row], ["calibration", 128, 1, pmb-c-calibration]]);
 host_dir_rmdir(root);
 verdict;
}
