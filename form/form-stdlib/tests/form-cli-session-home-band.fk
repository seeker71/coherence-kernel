; form-cli-session-home-band.fk — interned session fuel seeds LoRA; no transcript.
;
; Verdict 4095:
;   1..128  fsh-check (interned gifts, no transcript, temp A/B, fqt-lora 0,
;                      no re-encode, one-turn home, remote-present not home,
;                      last census ppm)
;   256     class descriptor FormSessionHome minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;   1024    fuel identities match walk-home offerings
;   2048    local model session carries generated ids; it does not rebuild them
; Overlay dim is 64 so generate Control: can apply the interned A/B.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-router.fk
; preludes: ../form-cli-local-ready.bml
; preludes: ../form-cli-one-turn.bml
; preludes: ../form-cli-session-local.bml
; preludes: form-stdlib/line-grammar.fk form-stdlib/form-fs.fk
; preludes: ../form-cli-lora-writer.bml
; preludes: form-stdlib/walk-home.fk
; preludes: ../form-cli-session-home.bml
; preludes: form-stdlib/form-cli-model-session.fk
; witnessed: 2026-09-10 -> 4095

(do
    (defn fshb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn fshb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (fshb-has-name? (tail xs) name))))
    (defn fshb-bit (ok bit) (if ok bit 0))

    (let bits (fsh-check))
    (let desc (FormSessionHome))
    (let src (read_file "form/form-stdlib/bml/form-cli-session-home.bml"))
    (let fuel (fsh-fuel))
    (let ctx (list "opaque-model-context"))
    (let sts (list "opaque-stream-state"))
    (let s (fcms-session "live" "opened" "m.gguf" "src" ctx sts
        2048 41 0 0 40 3 7 1))
    (let s2 (fcms-with-stream s 44 9 1 6 12 2))
    (let b8 (if (and (str_eq (nth desc 1) "FormSessionHome")
                     (and (eq (fshb-has-name? (nth desc 2) "T") 1)
                          (and (eq (fshb-has-name? (nth desc 3) "fsh-fuel") 1)
                               (eq (fshb-has-name? (nth desc 4) "TrainRule") 1))))
                256 0))
    (let b9 (if (and (eq (fshb-has-str? src "package Form.cli.sessionhome") 1)
                     (and (eq (fshb-has-str? src "interface ISessionHome") 1)
                          (and (eq (fshb-has-str? src "class FormSessionHome") 1)
                               (and (eq (fshb-has-str? src "const int FqtLora") 1)
                                    (eq (fshb-has-str? src "template SessionHomeRow") 1)))))
                512 0))
    (let b10 (if (and (eq (fsh-interned fuel) 1)
                      (eq (wh-all-vital? 1 (wh-gifts-to-ourselves)) 1))
                 1024 0))
    (let b11 (if (and (eq (fcms-generated-ids s2) 6)
                      (and (eq (ReencodeTranscript) 0)
                           (and (ge (str_find (fcms-generated-id-policy) "original" 0) 0)
                                (lt (str_find (fcms-generated-id-policy) "re-encode" 0) 0))))
                 2048 0))
    (add bits (add b8 (add b9 (add b10 b11)))))
