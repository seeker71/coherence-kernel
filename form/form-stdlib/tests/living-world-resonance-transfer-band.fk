; living-world-resonance-transfer-band.fk -- unseen composition asks to cross.
; Verdict 255 proves eight application/transfer properties.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/tests/living-world-resonance-witness.fk

(do
    (let base (lwrw-base-round 2))
    (let mapping-proposal (lwrw-first-proposal base))
    (let mapping-candidate (lwrw-candidate mapping-proposal))
    (let mapping-round
        (lwrw-integrated-mapping-round base mapping-proposal))
    (let input-world
        (lwrw-input-world (lwt-round-world mapping-round)))
    (let application-round
        (lwrw-application-round input-world mapping-candidate mapping-round))
    (let application-proposal (lwrw-first-proposal application-round))
    (let application-candidate (lwrw-candidate application-proposal))
    (let application (lwo-emergent-shape application-candidate))
    (let uncertainty (lwr-application-uncertainty application))
    (let partial
        (lwrw-partial-application-round application-round application-proposal))
    (let partial-outcome
        (lwt-evaluate-proposal (lwt-round-world partial) application-proposal))
    (let unanimous
        (lwrw-unanimous-application-round partial application-proposal))
    (let integrated
        (lwt-integrate unanimous application-proposal (lwrw-action)))
    (let integrated-world (lwt-round-world integrated))
    (let revoked (lwrw-input-revoked-round unanimous))
    (let refused
        (lwt-integrate revoked application-proposal (lwrw-action)))

    (let c1 (if (eq (lwo-active-by? input-world (lwrw-unseen-input)
                                     (lwrw-source-d)) 1) 1 0))
    (let c2 (if (node_eq (lwr-application-output application)
                          (lwrw-expected-output)) 2 0))
    (let c3 (if (and (node_eq (lwr-application-path application)
                               (lwo-local-path))
                         (eq (lwr-uncertainty-counterexamples uncertainty) 1)) 4 0))
    (let c4 (if (and (eq (lwo-field-size
                              (lwt-proposal-participants application-proposal)) 4)
                         (and (eq (lwo-field-size
                              (lwo-emergent-witnesses application-candidate)) 4)
                              (eq (lwo-emergent-ready?
                                  input-world application-candidate) 1))) 8 0))
    (let c5 (if (eq (lwo-world-has?
                         input-world application-candidate) 0) 16 0))
    (let c6 (if (and (node_eq (lwt-outcome-status partial-outcome)
                               (lwt-status-waiting))
                         (and (eq (lwt-outcome-yes partial-outcome) 3)
                              (eq (lwt-outcome-missing partial-outcome) 1))) 32 0))
    (let c7 (if (and (eq (lwo-active?
                              integrated-world application-candidate) 1)
                         (eq (lwo-field-size
                              (lwo-active-attributions-for
                                  integrated-world application-candidate)) 4)) 64 0))
    (let c8 (if (and (eq (lwo-emergent-ready?
                              (lwt-round-world revoked)
                              application-candidate) 0)
                         (and (eq (lwo-world-has?
                              (lwt-round-world refused)
                              application-candidate) 0)
                              (eq (lwo-active?
                                  integrated-world application-candidate) 1))) 128 0))
    (lwrw-sum (list c1 c2 c3 c4 c5 c6 c7 c8)))
