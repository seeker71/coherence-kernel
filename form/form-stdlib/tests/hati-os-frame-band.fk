; The Form walker keeps lexical call frames and shares explicit run memory.
; preludes: form-stdlib/bml/native-table-compile.bml
(do
 (let recursive (flt-src-fns "(do (defn total (n) (do (let held n) (if (eq n 0) held (add (total (sub n 1)) held)))) (total 20))"))
 (let store (fk-store (fk-lit 7) (fk-lit 41)))
 (let load (fk-load (fk-lit 7)))
 (let direct (list (fk-sequence store (fk-call 1 (fk-lit 0))) load))
 (let ref (fk-cons (fk-lit 1) (fk-cons (fk-lit 0) (fk-empty))))
 (let indirect (list (fk-sequence store (fk-icall ref (fk-empty))) load))
 (sum (list
  (if (eq (fkm-run recursive 0) 210) 1 0)
  (if (eq (fkm-run direct 0) 41) 2 0)
  (if (eq (fkm-run (list load) 0) 0) 4 0)
  (if (eq (fkm-run indirect 0) 41) 8 0)
  (if (value_eq (fkm-run (list (fk-arg)) (list 3 5)) (list 3 5)) 16 0)
  (if (eq (fkm-run recursive 0) 210) 32 0))))
