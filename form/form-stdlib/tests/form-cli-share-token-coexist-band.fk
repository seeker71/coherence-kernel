; Both publishers in one compiled unit, as in the live share runner.
; Expected: 255. Pure snapshots; no live telemetry writes.
; preludes: form-stdlib/form-glass-telemetry-membrane.bml
; preludes: form-stdlib/bml/form-cli-share-glass.bml
; preludes: form-stdlib/bml/form-cli-token-glass.bml

(do
    (defn fcstb-bit (ok bit) (if ok bit 0))
    (let share (fgtm-snapshot (fcsg-publisher) 1000
        (fcsg-observed-samples 1000 (list 23 53 24) 241)))
    (let tokens (fgtm-snapshot (fctg-publisher) 1000
        (fctg-read-samples 1000 (list 1 10 5 0 2 0 12) "explicit-binding")))
    (sum (list
        (fcstb-bit (str_eq (fcsg-publisher) "share.completed-turn") 1)
        (fcstb-bit (str_eq (fctg-publisher) "share.token-pressure") 2)
        (fcstb-bit (not (str_eq
            (ggf-name (fgtm-space (fcsg-root) (fcsg-publisher)))
            (ggf-name (fgtm-space (fctg-root) (fctg-publisher))))) 4)
        (fcstb-bit (eq (fgtm-snapshot-valid? share) 1) 8)
        (fcstb-bit (eq (fgtm-snapshot-valid? tokens) 1) 16)
        (fcstb-bit (eq (len (fgtm-snapshot-samples share)) 4) 32)
        (fcstb-bit (eq (len (fgtm-snapshot-samples tokens)) 7) 64)
        (fcstb-bit (and
            (str_eq (fgtm-read-state-status
                (fgtm-read-current-parsed (fcsg-publisher) tokens)) "malformed")
            (str_eq (fgtm-read-state-status
                (fgtm-read-current-parsed (fctg-publisher) share)) "malformed")) 128))))
