; living-world-expression-recursion-application-observation.fk -- causal
; prerequisite checkpoint: one new material crosses one already-admitted
; composed chain before any outcome reflection exists.  No surface payload is
; emitted.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk form-stdlib/living-world-expression-composition.fk form-stdlib/tests/living-world-expression-composition-witness.fk

(let LWXRA-SOURCE (bp "LWXRA-SOURCE"))
(let LWXRA-PROV   (bp "LWXRA-PROV"))

(defn lwxra-source () (lwxbw-cell LWXRA-SOURCE))
(defn lwxra-prov () (lwxbw-cell LWXRA-PROV))
(defn lwxra-material ()
    (lwxb-material
        (list (lwxbw-primary) (lwxbw-right) (lwxbw-left))))
(defn lwxra-material-world-build ()
    (lwt-receive-stream (lwxcbw-application-world)
        (list (lwxbw-entry (lwxra-source) (lwxra-prov)
            (lwxra-material)))))
(let LWXRA-MATERIAL-WORLD-VALUE (lwxra-material-world-build))
(defn lwxra-material-world () LWXRA-MATERIAL-WORLD-VALUE)

(let LWXRA-PROPOSAL-VALUE
    (lwxc-application-proposal (lwxra-material-world)
        (lwxcbw-chain-candidate-c) (lwxra-material)))
(defn lwxra-proposal () LWXRA-PROPOSAL-VALUE)
(defn lwxra-candidate () (lwt-proposal-candidate (lwxra-proposal)))
(defn lwxra-round-build ()
    (lwt-round (lwxra-material-world)
        (lwo-field (list (lwxra-proposal)))
        (lwo-empty-field) (lwxcbw-application-integrated-round)))
(defn lwxra-yes-round-build ()
    (lwt-round-receive (lwxra-round-build)
        (lwxbw-responses (lwxra-proposal)
            (oac-one (lwxra-candidate)))))
(defn lwxra-integrated-round-build ()
    (lwxc-integrate-application (lwxra-yes-round-build)
        (lwxra-proposal) (lwxbw-action)))
(let LWXRA-INTEGRATED-ROUND-VALUE (lwxra-integrated-round-build))
(defn lwxra-integrated-round () LWXRA-INTEGRATED-ROUND-VALUE)
(defn lwxra-world () (lwt-round-world (lwxra-integrated-round)))

(do
    (let outcome
        (lwt-outcome-for (lwxra-integrated-round) (lwxra-proposal)))
    (let derivation
        (lwxc-application-derivation
            (lwo-emergent-shape (lwxra-candidate))))
    (list
        (if (node_eq (lwxra-proposal) (lwo-none)) 0 1)
        (lwo-field-size (lwt-proposal-participants (lwxra-proposal)))
        (lwt-outcome-yes outcome)
        (if (node_eq (lwt-outcome-status outcome)
                (lwt-status-acknowledged)) 1 0)
        (lwo-active? (lwxra-world) (lwxra-candidate))
        (if (node_eq (lwxc-derivation-input derivation)
                (lwxra-material)) 1 0)
        (len (node_children (lwxc-derivation-bridge derivation)))
        (len (lwtv-sequence-items
            (lwxc-derivation-output derivation)))))
