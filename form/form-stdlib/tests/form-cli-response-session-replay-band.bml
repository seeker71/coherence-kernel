// Effectful retained-fixture boundary checks. No case, model, or provider runs.
// The fixture is explicitly synthetic and exercises admission/replay evidence IO.
// preludes: form-stdlib/bml/form-cli-response-session.bml
section [form.bml] {
 def frssrb-need(ok,message) = if ok then 1 else form_error(message);
 def frssrb-write(path,text) = frssrb-need(eq(write_file(path,text),str_len(text)),str_concat("fixture write failed: ",path));
 def frssrb-owner(root) = frssrb-write(frsh-path(root,"owner.json"),json-emit(json-node-object(list(nsm-n("owner_pid",4242),nsm-n("admitted_unix_ms",7),nsm-s("ownership_scope","synthetic retained fixture; not a live process")))));
 def frssrb-manifest(runId) {
  let request = parse-json("fixture-request","{\"mode\":\"review\",\"review_entry\":\"direct\",\"evaluation\":1,\"goal\":\"Read the retained fixture value\",\"documents\":[{\"id\":\"value\",\"path\":\"value.json\",\"text\":\"{\\\"value\\\":7}\"}],\"writable\":[],\"checks\":[{\"tool\":\"jq\",\"arguments\":[\".value\",\"value.json\"],\"stdout\":\"7\\n\"}],\"report_checks\":[{\"tool\":\"jq\",\"arguments\":[\".value\"],\"stdout\":\"7\\n\"}]}");
  let member = json-node-object(list(nsm-s("id","one"),json-node-pair("request",request)));
  json-node-object(list(nsm-s("session","replay-boundary-fixture"),nsm-s("run_id",runId),json-node-pair("cases",json-node-array(list(member)))));
 }
 def frssrb-terminal(root,manifest,text) {
  let request = json-object-get(head(node_children(json-object-get(manifest,"cases"))),"request");
  let requestText = json-emit(request);
  let result = json-node-object(list(nsm-s("status","complete"),nsm-n("release_ok",1),nsm-s("report","{\"value\":7}"),json-node-pair("documents",json-object-get(request,"documents")),json-node-pair("generated_ids",json-node-int(3)),json-node-pair("injected_ids",json-node-int(1))));
  let resultText = json-emit(result);
  let checked = frss-recheck(request,result);
  let assistance = frss-assistance("native-review-passed",json-node-object(list()));
  let dir = frsh-path(root,str_concat("0-",fcam-hash(requestText)));
  frssrb-need(eq(host_dir_mkdir(dir),1),"fixture case directory collision");
  frssrb-write(frsh-path(dir,"request.json"),requestText);
  frssrb-write(frsh-path(dir,"result.json"),resultText);
  frssrb-write(frsh-path(dir,"local-report.json"),"{\"value\":7}");
  let row = json-node-object(list(nsm-s("id","one"),nsm-s("request_sha256",fcam-hash(requestText)),nsm-s("result_sha256",fcam-hash(resultText)),nsm-s("local_report_sha256",fcam-hash("{\"value\":7}")),nsm-s("evidence",dir),nsm-s("status","complete"),nsm-s("native_status","complete"),nsm-s("case_status","native-only-success"),nsm-n("elapsed_ms",9),nsm-n("native_elapsed_ms",9),json-node-pair("generated_ids",json-node-int(3)),json-node-pair("injected_ids",json-node-int(1)),json-node-pair("check",checked),json-node-pair("native_check",checked),json-node-pair("provider_assistance",assistance),json-node-pair("resource_seal",frss-resource-seal(assistance)),nsm-n("provider_processes_new",0),nsm-n("rented_provider_calls",0),nsm-s("attribution_basis","synthetic retained fixture; no live model or provider run")));
  frssrb-write(frsh-path(dir,"receipt.json"),json-emit(row));
  let summary = json-node-object(list(nsm-s("schema","form-response-session-v1"),nsm-s("status","terminal"),nsm-s("session",fcap-string(manifest,"session")),nsm-s("manifest_sha256",fcam-hash(text)),nsm-s("evidence",root),nsm-n("cases",1),nsm-n("native_executions_new",1),nsm-n("native_executions_historical",1),nsm-n("provider_processes_new",0),nsm-n("provider_processes_historical",0),nsm-n("rented_provider_calls",0),json-node-pair("provider_usage_events",json-node-array(list())),json-node-pair("results",json-node-array(list(row))),json-node-pair("overall_session_quality",json-node-null())));
  let summaryText = json-emit(summary);
  frssrb-write(frsh-path(root,"summary.json"),summaryText);
  frssrb-write(frsh-path(root,"summary.sha256"),fcam-hash(summaryText));
  list(row,summaryText);
 }
 let base = str_concat("/tmp/form-response-session-replay-band-",str_concat(int_to_str(host_pid()),str_concat("-",int_to_str(host_monotonic_ms()))));
 frssrb-need(eq(host_dir_mkdir(base),1),"fresh fixture base");
 let manifest = frssrb-manifest("terminal");
 let text = json-emit(manifest);
 let digest = fcam-hash(text);
 let root = frss-root(base,manifest,digest);
 frssrb-need(eq(host_dir_mkdir(root),1),"first atomic keyed admission");
 frssrb-write(frsh-path(root,"manifest.json"),text);
 frssrb-owner(root);
 let terminal = frssrb-terminal(root,manifest,text);
 let replay = frss-remembered(root,text,digest);
 frssrb-need(and(str_eq(fcap-string(replay,"status"),"terminal-replay"),and(eq(nsm-num(replay,"native_executions_new"),0),eq(nsm-num(replay,"native_executions_historical"),1))),"terminal replay accounting or attribution");
 frssrb-need(and(eq(nsm-num(replay,"provider_processes_new"),0),node_eq(json-object-get(replay,"overall_session_quality"),json-node-null())),"replay invented cost or semantic quality");
 let summaryText = nth(terminal,1);
 frssrb-write(frsh-path(root,"summary.json"),"{}");
 frssrb-need(str_eq(fcap-string(frss-remembered(root,text,digest),"status"),"terminal-summary-corrupt;no-restart"),"changed terminal summary replayed");
 let emptySummary = json-emit(oh-set(parse-json("fixture-summary",summaryText),"results",json-node-array(list())));
 frssrb-write(frsh-path(root,"summary.json"),emptySummary);
 frssrb-write(frsh-path(root,"summary.sha256"),fcam-hash(emptySummary));
 frssrb-need(str_eq(fcap-string(frss-remembered(root,text,digest),"status"),"terminal-evidence-corrupt;no-restart"),"self-consistent summary omitted a requested case");
 frssrb-write(frsh-path(root,"summary.json"),summaryText);
 frssrb-write(frsh-path(root,"summary.sha256"),fcam-hash(summaryText));
 let changed = str_concat(text," ");
 let conflict = frss-remembered(root,changed,fcam-hash(changed));
 frssrb-need(str_eq(fcap-string(conflict,"status"),"run-identity-conflict"),"changed bytes under one identity were not refused");
 let row = head(terminal);
 frssrb-write(frsh-path(fcap-string(row,"evidence"),"result.json"),"{}");
 let corruptResult = frss-remembered(root,text,digest);
 frssrb-need(str_eq(fcap-string(corruptResult,"status"),"terminal-evidence-corrupt;no-restart"),"changed required result artifact replayed");
 let interruptedManifest = frssrb-manifest("interrupted");
 let interruptedText = json-emit(interruptedManifest);
 let interruptedRoot = frss-root(base,interruptedManifest,fcam-hash(interruptedText));
 frssrb-need(eq(host_dir_mkdir(interruptedRoot),1),"interrupted fixture admission");
 frssrb-write(frsh-path(interruptedRoot,"manifest.json"),interruptedText);
 frssrb-owner(interruptedRoot);
 frssrb-write(frsh-path(interruptedRoot,"session.lock"),"not-liveness");
 let interrupted = frss-remembered(interruptedRoot,interruptedText,fcam-hash(interruptedText));
 frssrb-need(and(str_eq(fcap-string(interrupted,"status"),"admitted-unresolved;no-restart"),eq(nsm-num(json-object-get(interrupted,"owner_evidence"),"owner_pid"),4242)),"interrupted ownership did not stay unresolved with owner evidence");
 frssrb-need(and(node_eq(json-object-get(interrupted,"provider_processes_historical"),json-node-null()),node_eq(json-object-get(interrupted,"provider_usage_events"),json-node-null())),"interrupted history became known zero");
 let malformedManifest = frssrb-manifest("malformed");
 let malformedText = json-emit(malformedManifest);
 let malformedRoot = frss-root(base,malformedManifest,fcam-hash(malformedText));
 frssrb-need(eq(host_dir_mkdir(malformedRoot),1),"malformed fixture admission");
 frssrb-write(frsh-path(malformedRoot,"manifest.json"),malformedText);
 frssrb-owner(malformedRoot);
 frssrb-write(frsh-path(malformedRoot,"summary.json"),"{");
 frssrb-write(frsh-path(malformedRoot,"summary.sha256"),fcam-hash("{"));
 let malformed = frss-remembered(malformedRoot,malformedText,fcam-hash(malformedText));
 frssrb-need(str_eq(fcap-string(malformed,"status"),"terminal-summary-malformed;no-restart"),"malformed terminal record did not stay unresolved");
 print_str("response-session replay boundary: retained synthetic fixture only; no live model/provider execution\n");
 1;
}
