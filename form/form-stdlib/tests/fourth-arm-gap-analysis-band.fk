; Pure source/ranking cases, including malformed input and BML lowering.
; preludes: form-stdlib/bml/fourth-arm-gap-analysis.bml
; witnessed: 2026-09-09 -> 8191
(do
 (defn fgab-k (ok bit) (if ok bit 0))
 (defn fgab-names (s known) (tb-join (fga-missing (head (fga-lex s)) known) identity ","))
 (let src "; (phantom 0)\n(defn kept (arg) (add arg 1))\n(do (kept 2) (missing-a \"; (ghost \\\" )\") (missing-a 4))")
 (let known (list "defn" "do" "add" "fn"))
 (let lexed (fga-lex src))
 (let rows (list
  (list "first" "single-mismatch" "analyzed" (list "a" "b") (list) (list))
  (list "second" "single-mismatch" "analyzed" (list "a") (list) (list))
  (list "third" "single-mismatch" "analyzed" (list) (list) (list))))
 (let ranked (fga-rank (list "b" "a") rows))
 (let cumulative (fga-cumulative ranked rows (list)))
 (let bml (fga-lower "fixture.bml" "section [form.bml] {\n class Fixture {\n  def double(x) = add(x, x);\n }\n double(2);\n}\n"))
 (sum (list
  (fgab-k (and (str_eq (nth lexed 1) "") (str_eq (fgab-names src known) "missing-a")) 1)
  (fgab-k (str_eq (fgab-names "(defn invoke (callable) (callable 1)) (fn (lambdaArg) (lambdaArg 2))" known) "") 2)
  (fgab-k (and (str_eq (nth (fga-lex "(add 1 2") 1) "unclosed-list") (str_eq (nth (fga-lex ")") 1) "unexpected-close")) 4)
  (fgab-k (str_eq (nth (fga-lex "\"unclosed") 1) "unclosed-string") 8)
  (fgab-k (and (str_eq (head (head ranked)) "a") (eq (nth (head ranked) 1) 2)) 16)
  (fgab-k (and (eq (nth (head cumulative) 1) 2) (eq (nth (nth cumulative 1) 1) 3)) 32)
  (fgab-k (and (fga-selected "bml-flatten-empty") (and (fga-selected "single-mismatch") (not (fga-selected "single-pass")))) 64)
  (fgab-k (and (fga-stem "valid_1-name") (and (not (fga-stem "../escape")) (not (fga-stem "")))) 128)
  (fgab-k (str_eq (tb-join (fga-preludes (lx-lines "; preludes: a.fk\n// preludes: b.bml\n")) identity ",") "a.fk,b.bml") 256)
  (fgab-k (and (str_eq (nth bml 2) "") (str_eq (tb-join (fga-missing (nth bml 1) (list "defn" "add" "list")) identity ",") "")) 512)
  (fgab-k (eq (nth (head (fga-locations (list (list "source.fk" (head lexed) "")) (list "missing-a"))) 1) 3) 1024)
  (fgab-k (str_eq (fga-tsv rows) "first\ta b\nsecond\ta\nthird\t\n") 2048)
  (fgab-k (str_eq (tb-join (fga-specials (head (fga-lex "(if (str_eq op \"live-op\") 1 0) ; (str_eq op \"fake\")\n"))) identity ",") "live-op") 4096))))
