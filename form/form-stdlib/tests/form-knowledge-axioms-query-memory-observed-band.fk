; form-knowledge-axioms-query-memory-observed-band.fk -- persisted witness.
;
; Verdict 1023: current memory, exact answer-free selection, current source,
; evidence and receipt presence, explicit undo, no answer, no model execution,
; no heldout credit, no trained-weight claim, and changed-question dissolution.
;
; preludes: form-stdlib/core.fk form-stdlib/form-knowledge-axioms-query-memory-observed.fk

(do
    (defn fkaqmob-bit (ok bit) (if ok bit 0))
    (let offer (fkaqmo-offer))
    (let memory (fkaqmo-memory))
    (sum (list
        (fkaqmob-bit (eq (fkqm-memory-valid? memory
            (fkaqmo-question)) 1) 1)
        (fkaqmob-bit (str_eq (fkaqmo-select (fkaqmo-question))
            (nth offer 3)) 2)
        (fkaqmob-bit (str_eq (nth memory 6) (nth offer 5)) 4)
        (fkaqmob-bit (and (str_eq (nth memory 9) (fkaqmo-evidence-sha))
                          (gt (file_size (fkaqmo-receipt-path)) 0)) 8)
        (fkaqmob-bit (node_eq (fkqm-undo-node memory)
                              (fkqm-empty-rollback-node)) 16)
        (fkaqmob-bit (eq (nth memory 16) 0) 32)
        (fkaqmob-bit (eq (nth memory 15) 0) 64)
        (fkaqmob-bit (eq (fkaqmo-heldout-credit) 0) 128)
        (fkaqmob-bit (eq (fkaqmo-weights-trained) 0) 256)
        (fkaqmob-bit (nothing? (fkaqmo-select
            (str_concat (fkaqmo-question) " changed"))) 512))))
