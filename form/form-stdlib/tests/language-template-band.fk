; language-template-band.fk — focused template/member value contract.
;
; preludes: form-stdlib/core.fk form-stdlib/language-template.fk
;
; Verdict 255 when construction, tags, access, validation, and malformed
; refusals retain the original language-model template semantics.

(do
    (let member (language-template-member "query" "String"))
    (let template
        (language-template-with-members "HeedRequest" (list "TQuery")
            (list member)))
    (sum (list
        (if (and (eq (len member) 3) (eq (nth member 0) 44003)) 1 0)
        (if (and (str_eq (language-template-member-name member) "query")
                 (str_eq (language-template-member-type member) "String")) 2 0)
        (if (eq (language-template-member-valid? member) 1) 4 0)
        (if (and (eq (nth template 0) 44001)
                 (eq (language-template-kind template) 44101)) 8 0)
        (if (and (str_eq (language-template-name template) "HeedRequest")
                 (eq (len (language-template-parameters template)) 1)) 16 0)
        (if (and (eq (language-template? template) 1)
                 (eq (language-template-valid? template) 1)) 32 0)
        (if (and (eq (len (language-template-members template)) 1)
                 (eq (language-template-members-valid?
                         (language-template-members template)) 1)) 64 0)
        (if (and (eq (language-template-member-valid?
                         (language-template-member "" "String")) 0)
                 (eq (language-template-valid?
                         (language-template-with-members "" (list) (list))) 0))
            128 0))))
