; form-agent-repo-contribution-band.fk — bounded source discovery and guarded
; repository contribution, including observed apply and post-test undo.
; PROOF LEVEL: FOURTH-ARM ONLY (filesystem effects + higher-order callbacks) — Verdict 32767 on fkwu; go/rust/ts agree on 383 (witnessed 2026-09-03; no arm-bound native by name)
; Expected: 32767
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/line-grammar.fk
; preludes: form-stdlib/native-edit.fk form-stdlib/form-agent-repo-contribution.fk

(do
    (defn farcb-bit (ok bit) (if ok bit 0))
    (defn farcb-root ()
        (fs-path-join (fs-temp-dir) "form-agent-repo-contribution-band"))
    (defn farcb-route ()
        (intern_node (intern_trivial_string "form-agent-test-route")
            (list (intern_trivial_string "focused-band"))))
    (defn farcb-cap () (farc-capability (farcb-root) "form/" 4096 (farcb-route)))
    (defn farcb-path () "form/live.fk")
    (defn farcb-full () (fs-path-join (farcb-root) (farcb-path)))
    (defn farcb-source-v1 () "(do (defn pulse () 1) (pulse))\n")
    (defn farcb-source-v2 () "(do (defn pulse () 2) (pulse))\n")
    (defn farcb-source-bad () "(do (defn pulse () 9) (pulse))\n")
    (defn farcb-lookup (ctx name)
        (if (str_eq name "pulse") (list "one" (farcb-path))
            (if (str_eq name "plural")
                (list "choice" (list (farcb-path) "form/other.fk"))
                (nothing))))
    (defn farcb-verify (ctx route candidate)
        (if (not (node_eq route (farcb-route)))
            (farc-test-result "refused" "test-route-refused" 0 0)
            (if (ge (str_find candidate "(pulse)" 0) 0)
                (farc-test-result "value" "candidate-structure" 1 1)
                (farc-test-result "failure" "candidate-structure" 1 0))))
    (defn farcb-test (ctx route path)
        (if (not (node_eq route (farcb-route)))
            (farc-test-result "refused" "test-route-refused" 0 0)
            (if (str_eq (fs-read-text path) (farcb-source-v2))
                (farc-test-result "value" "focused-band" 1 1)
                (farc-test-result "failure" "focused-band" 1 0))))
    (defn farcb-always-fail (ctx route path)
        (farc-test-result "failure" "deliberate-negative-control" 1 0))

    (defn form-agent-repo-contribution-band ()
        (do
            (fs-remove-tree (farcb-root))
            (fs-mkdir (farcb-root))
            (fs-mkdir (fs-path-join (farcb-root) "form"))
            (fs-write-text (farcb-full) (farcb-source-v1))
            (fs-write-text (fs-path-join (farcb-root) "form/other.fk") "0\n")
            (let cap (farcb-cap))
            (let grant (farc-capability-token cap))
            (let found (farc-find cap farcb-lookup 0 "pulse"))
            (let plural (farc-find cap farcb-lookup 0 "plural"))
            (let unborn (farc-find cap farcb-lookup 0 "unborn"))
            (let refused (farc-read cap "docs/outside.fk"))
            (let proposal (farc-proposal cap (farcb-path)
                (farcb-source-v1) (farcb-source-v2)))
            (let denied (farc-apply cap (intern_trivial_string "other-grant")
                farcb-verify farcb-test 0 proposal))
            (let applied (farc-apply cap grant farcb-verify farcb-test 0 proposal))
            (let after-apply (fs-read-text (farcb-full)))
            (let undo-proposal (farc-proposal cap (farcb-path)
                (farcb-source-v2) (farcb-source-bad)))
            (let undone (farc-apply cap grant farcb-verify farcb-always-fail
                0 undo-proposal))
            (let after-undo (fs-read-text (farcb-full)))
            (let absent-proposal (farc-proposal cap (farcb-path)
                "not-present" "x"))
            (let absent (farc-apply cap grant farcb-verify farcb-test
                0 absent-proposal))
            (let score (sum (list
                (farcb-bit (eq (farc-capability? cap) 1) 1)
                (farcb-bit (str_eq (farc-source-status found) "value") 2)
                (farcb-bit (str_eq (farc-source-text found) (farcb-source-v1)) 4)
                (farcb-bit (str_eq (farc-source-status plural) "choice") 8)
                (farcb-bit (eq (len (farc-source-paths plural)) 2) 16)
                (farcb-bit (str_eq (farc-source-status unborn) "nothing") 32)
                (farcb-bit (str_eq (farc-source-status refused) "refused") 64)
                (farcb-bit (eq (farc-proposal-bound? cap proposal) 1) 128)
                (farcb-bit (str_eq (farc-status denied) "refused") 256)
                (farcb-bit (str_eq (farc-status applied) "value") 512)
                (farcb-bit (str_eq after-apply (farcb-source-v2)) 1024)
                (farcb-bit (eq (farc-test-passed? (farc-posttest applied)) 1) 2048)
                (farcb-bit (str_eq (farc-status undone) "failure") 4096)
                (farcb-bit (str_eq (farc-reason undone) "posttest-failed-restored") 8192)
                (farcb-bit (and (str_eq after-undo (farcb-source-v2))
                                (str_eq (farc-status absent) "nothing")) 16384))))
            (fs-remove-tree (farcb-root))
            score))
    (form-agent-repo-contribution-band))
