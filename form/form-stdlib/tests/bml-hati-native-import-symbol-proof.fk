; tests/bml-hati-native-import-symbol-proof.fk
;
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk
;
; Closes import-symbol-resolution. `import BMF.*;` (on demand), `import BMF;`
; (package, qualified access only), `import BMF.Sum3;` (one symbol) and
; `import Num;` (a default-package symbol) resolve against the source units
; handed to the compiler. Reachable units link into one Hati table: their
; methods take function indices after the importing unit's own, transitively
; through the imported units' own imports. A local method shadows an on-demand
; import, units never leak names without an import, and an import that names
; no supplied unit is named before table emission.

(do
    (defn score-bool (actual)
        (if actual 1 0))

    (defn score-int (actual expected)
        (if (eq actual expected) 1 0))

    (defn score-str (actual expected)
        (if (nil? actual)
            0
            (if (str_eq actual expected) 1 0)))

    (defn str-contains? (haystack needle)
        (ge (str_find haystack needle 0) 0))

    (defn is-parse (text)
        (bml-source-parse-executable-stream (bml-source-scan-text text)))

    (defn is-node (text)
        (bml-source-exec-parse-node (is-parse text)))

    (let bmf-parsed
        (is-parse "package BMF;\nint Twice(int n) { return n + n; }\nint Sum3(int a, int b, int c) { return a + b + c; }\n"))
    (let num-parsed (is-parse "int Num() { return 13; }\n"))
    (let deep-parsed
        (is-parse "package Deep;\nimport BMF.*;\nint Quad(int n) { return Twice(Twice(n)); }\n"))
    (let units
        (list
            (bml-source-exec-parse-node bmf-parsed)
            (bml-source-exec-parse-node num-parsed)
            (bml-source-exec-parse-node deep-parsed)))

    (let source "import BMF.*;\nimport Num;\nreturn Twice(Num()) + BMF.Twice(8);\n")
    (let parsed (is-parse source))
    (let source-node (bml-source-exec-parse-node parsed))
    (let star-node (nth (bml-source-exec-parse-nodes parsed) 0))
    (let single-node (nth (bml-source-exec-parse-nodes parsed) 1))
    (let scope (bml-scope-unit-rows source-node))
    (let scope-imports (bnii-unit-imports scope))
    (let source-image (bml-hati-compile-unit-image source-node units))
    (let source-table (bml-hati-table-file source-image))

    (let deep-node (is-node "import Deep.*;\nreturn Quad(10) + 2;\n"))
    (let deep-image (bml-hati-compile-unit-image deep-node units))
    (let shadow-node
        (is-node "import BMF.*;\nint Twice(int n) { return n + 30; }\nreturn Twice(10) + BMF.Twice(1);\n"))
    (let package-node (is-node "import BMF;\nreturn BMF.Sum3(10, 12, 20);\n"))
    (let package-only-image
        (bml-hati-compile-unit-image (is-node "import BMF;\nreturn Sum3(10, 12, 20);\n") units))
    (let symbol-node (is-node "import BMF.Sum3;\nreturn Sum3(10, 12, 20);\n"))
    (let missing-image
        (bml-hati-compile-unit-image (is-node "import Missing.*;\nreturn 42;\n") units))
    (let unimported-image
        (bml-hati-compile-unit-image (is-node "return Twice(21);\n") units))
    (let no-units-image (bml-hati-compile-image source-node))

    (sum
        (list
            (score-bool (bml-source-exec-parse-ok? parsed))
            (score-int (len (bml-source-exec-parse-rest parsed)) 0)
            (score-str (nth (bml-source-exec-parse-rules parsed) 0) "import-star-scope")
            (score-str (nth (bml-source-exec-parse-rules parsed) 1) "import-scope")
            (score-str (nth (bml-source-exec-parse-rules parsed) 2) "return-expr")
            (score-bool (node_eq (node_category star-node) BML-AST-IMPORT))
            (score-str (node_value (bml-node-child star-node 0)) "BMF")
            (score-str (node_value (bml-node-child star-node 1)) ".*")
            (score-str (node_value (bml-node-child single-node 0)) "Num")
            (score-int (bnii-unit-import-count scope) 2)
            (score-int (bnii-import-star? (head scope-imports)) 1)
            (score-int (bnii-import-star? (nth scope-imports 1)) 0)
            (score-str (bnii-import-module (nth scope-imports 1)) "Num")
            (score-bool (bml-source-exec-parse-ok? bmf-parsed))
            (score-bool (bml-source-exec-parse-ok? num-parsed))
            (score-bool (bml-source-exec-parse-ok? deep-parsed))
            (score-bool (bml-hati-image-supported? source-image))
            (score-int (len (bml-hati-image-fns source-image)) 4)
            (score-int (bml-hati-run-unit-value source-node units) 42)
            (score-bool (not (str-contains? source-table "BML-HATI-UNSUPPORTED")))
            (score-int (bma-run-value (bml-compile-unit-program source-node units)) 42)
            (score-bool (bml-hati-image-supported? deep-image))
            (score-int (len (bml-hati-image-fns deep-image)) 4)
            (score-int (bml-hati-run-unit-value deep-node units) 42)
            (score-int (bml-hati-run-unit-value shadow-node units) 42)
            (score-int (bma-run-value (bml-compile-unit-program shadow-node units)) 42)
            (score-int (bml-hati-run-unit-value package-node units) 42)
            (score-int (bma-run-value (bml-compile-unit-program package-node units)) 42)
            (score-str (head (bml-hati-image-unsupported package-only-image)) "call/unbound")
            (score-int (bml-hati-run-unit-value symbol-node units) 42)
            (score-int (bma-run-value (bml-compile-unit-program symbol-node units)) 42)
            (score-bool (not (bml-hati-image-supported? missing-image)))
            (score-str (head (bml-hati-image-unsupported missing-image)) "import/unresolved")
            (score-bool (str-contains? (bml-hati-table-file missing-image) "BML-HATI-UNSUPPORTED import/unresolved"))
            (score-str (head (bml-hati-image-unsupported unimported-image)) "call/unbound")
            (score-str (head (bml-hati-image-unsupported no-units-image)) "import/unresolved"))))
