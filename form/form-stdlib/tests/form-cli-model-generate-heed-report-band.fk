; form-cli-model-generate-heed-report-band.fk — the resident generation report
; names the one-lookup live cursor boundary explicitly, without loading a model.
;
; Pure/scripted: the cursor below is data. No GGUF, GPU, lookup, or source IO is
; touched. The live generator constructs the same cursor fields after decode.
;
; Verdict 32767:
;   1     one lookup is the per-turn budget
;   2     one bounded observation plus its Qwen role crossing is reserved
;   4..16384 attempts, actual searches, forward accounting, bounded provenance,
;            and the explicit body-root witness are present and exact
;
; preludes: form-stdlib/form-cli-model-generate.fk

(do
    (defn fcmghrb-bit (ok bit) (if ok bit 0))
    (defn fcmghrb-has (text needle)
        (if (ge (str_find text needle 0) 0) 1 0))
    (let hit-span
        "<|form:knowledge-observation|>\nstatus=hit\nsource-artifact=sha256:abc123\nsource-path=bootstrap/ground-recursive.fk\nanswer-key=deadbeef\nanswer:55\n<|/form:knowledge-observation|>")
    (let records (list
        (fhc-record "hit" hit-span "current-source-path-hit" "")
        (fhc-record "miss" "" "no-current-source-match" "")
        (fhc-record "nothing" "" "no-query-token"
                    "no-post-observation-output-budget")
        (fhc-record "spent" "" "budget-spent" "")))
    (let c (fhc-state "held" 0 3 7 records 1 1 1))
    ; Pure report door: root evidence is supplied as data. The live wrapper
    ; discovers and verifies the body root before calling this same formatter.
    (let report (fcmg-heed-report-at c "/body" "body-root-anchored-upward-v1"))
    (sum (list
        (fcmghrb-bit (eq (fcmg-heed-budget) 1) 1)
        (fcmghrb-bit (eq (fcmg-heed-context-reserve) 2144) 2)
        (fcmghrb-bit (fcmghrb-has report
            "heed_cursor=bounded-current-source-v1") 4)
        (fcmghrb-bit (fcmghrb-has report "heed_lookup_budget=1") 8)
        (fcmghrb-bit (fcmghrb-has report
            "heed_lookup_budget_remaining=0") 16)
        (fcmghrb-bit (and (fcmghrb-has report "heed_honor_attempts=3")
                      (and (fcmghrb-has report "heed_lookups=2")
                      (and (fcmghrb-has report "heed_source_searches=2")
                           (fcmghrb-has report "heed_honored=4")))) 32)
        (fcmghrb-bit (and (fcmghrb-has report "heed_hits=1")
                          (fcmghrb-has report "heed_misses=1")) 64)
        (fcmghrb-bit (and (fcmghrb-has report "heed_nothings=1")
                          (fcmghrb-has report "heed_spent=1")) 128)
        (fcmghrb-bit (fcmghrb-has report "heed_injected_tokens=7") 256)
        (fcmghrb-bit (and (fcmghrb-has report "heed_window_bytes=4")
                          (fcmghrb-has report "heed_model_executed=0")) 512)
        (fcmghrb-bit (and (fcmghrb-has report "heed_close_commits=1")
                      (and (fcmghrb-has report "heed_terminal_forwards=1")
                           (fcmghrb-has report "heed_injection_refusals=1"))) 1024)
        (fcmghrb-bit (and (fcmghrb-has report "heed_evidence_status=hit")
                          (fcmghrb-has report
                              "heed_evidence_reason=current-source-path-hit")) 2048)
        (fcmghrb-bit (fcmghrb-has report
            "heed_source_path=bootstrap/ground-recursive.fk") 4096)
        (fcmghrb-bit (and (fcmghrb-has report
                              "heed_source_artifact=sha256:abc123")
                          (fcmghrb-has report "heed_answer_key=deadbeef")) 8192)
        (fcmghrb-bit (and (fcmghrb-has report
                              "heed_source_root_status=body-root-anchored-upward-v1")
                          (fcmghrb-has report "heed_source_root=/body")) 16384))))
