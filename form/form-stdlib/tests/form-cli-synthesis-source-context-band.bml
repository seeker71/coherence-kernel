// Selected native observations do not imply full-source visibility or altered checks.
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 class SynthesisSourceContextWitness {
  def sscw-check(name,ok) = if ok then 1 else form_error(str_concat("synthesis source context: ",name));
  def sscw-members(request) = list(json-node-object(list(nsm-s("id","case"),json-node-pair("request",request))));
  def sscw-manifest(request) = json-node-object(list(json-node-pair("cases",json-node-array(sscw-members(request)))));
 }
 let request = parse-json("request","{\"mode\":\"review\",\"evaluation\":1,\"goal\":\"Read value and keep its scope.\",\"documents\":[{\"id\":\"value\",\"path\":\"value.json\",\"text\":\"{\\\"value\\\":7,\\\"unseen\\\":\\\"unseen-source-sentinel\\\"}\"}],\"writable\":[],\"checks\":[{\"tool\":\"jq\",\"arguments\":[\".value\",\"value.json\"],\"stdout\":\"7\\n\"}],\"report_checks\":[{\"tool\":\"jq\",\"arguments\":[\".value\"],\"stdout\":\"7\\n\"}]}");
 let full = head(frsy-packet(sscw-members(request)));
 sscw-check("full documents retained",node_eq(json-object-get(full,"documents"),json-object-get(request,"documents")));
 sscw-check("full packet has no partial fields",not(json-object-has?(full,"source_observations")));
 let queries = parse-json("queries","[{\"tool\":\"jq\",\"arguments\":[\".value\",\"value.json\"]}]");
 let selected = oh-set(oh-set(request,"document_context",json-node-string("catalog")),"source_queries",queries);
 sscw-check("valid selection",frsh-request-valid(selected));
 let packet = head(frsy-packet(sscw-members(selected)));
 let observed = head(node_children(json-object-get(packet,"source_observations")));
 sscw-check("actual native result",and(eq(nsm-num(observed,"exit"),0),str_eq(fcap-string(observed,"stdout"),"7\n")));
 sscw-check("unselected text stays outside packet",lt(str_find(json-emit(packet),"unseen-source-sentinel",0),0));
 sscw-check("no full document claim",and(not(json-object-has?(packet,"documents")),str_eq(fcap-string(packet,"document_context"),"catalog")));
 sscw-check("original source checks unchanged",head(frr-source(selected)));
 sscw-check("original report checks unchanged",and(head(frr-report(selected,"{\"value\":7}")),not(head(frr-report(selected,"{\"value\":8}")))));
 let missing = oh-set(selected,"source_queries",parse-json("missing","[{\"tool\":\"read\",\"arguments\":[\"missing.txt\"]}]"));
 let failed = head(node_children(json-object-get(head(frsy-packet(sscw-members(missing))),"source_observations")));
 sscw-check("query failure retained",and(not(eq(nsm-num(failed,"exit"),0)),not(str_eq(fcap-string(failed,"stderr"),""))));
 let edited = oh-set(selected,"source_queries",parse-json("edit","[{\"tool\":\"write\",\"arguments\":[\"value.json\"]}]"));
 sscw-check("mutation refused before admission",not(frsh-request-valid(edited)));
 let forged = oh-set(selected,"source_queries",parse-json("forged","[{\"tool\":\"jq\",\"arguments\":[\".value\",\"value.json\"],\"stdout\":\"forged\"}]"));
 sscw-check("authored observation refused",not(frsh-request-valid(forged)));
 sscw-check("source manifest is original",str_eq(fcap-string(packet,"request_sha256"),fcam-hash(json-emit(selected))));
 let fullManifest = sscw-manifest(request);
 sscw-check("full source replay key retained",str_eq(frsy-identity(fullManifest,json-emit(fullManifest),"prompt"),fcam-hash(json-emit(fullManifest))));
 let selectedManifest = sscw-manifest(selected);
 let selectedText = json-emit(selectedManifest);
 sscw-check("catalog cannot replay earlier full-source admission",not(str_eq(frsy-identity(selectedManifest,selectedText,"prompt"),fcam-hash(selectedText))));
 sscw-check("changed observed packet has new identity",not(str_eq(frsy-identity(selectedManifest,selectedText,"observed-a"),frsy-identity(selectedManifest,selectedText,"observed-b"))));
 1;
}
