; coherence-band.fk — one coupling recipe, the same across every scale.
;
; Proves three-way (Go/Rust/TS) that coupling strength is computed from the
; reduced frequency ratio (Farey complexity), that simpler ratios couple more
; strongly (the Arnold-tongue ordering), that the heart-brain 1:1 entrainment is
; the strongest coupling in the seeded cross-domain ladder, that a threshold
; separates coherent from weak, and that rhythms locking with a reference form
; an equivalence class (content-addressing over rhythm).
;
; Band verdict: 1111111111 when every claim holds across all three kernels.
;   the reduced ratio is computed (6:4 → 3:2)                       →        1
;   lock order rises as the ratio complexifies (1:1<2:1<3:2)        →       10
;   the heart-brain 1:1 is the strongest lock in the seeded ladder  →      100
;   a threshold separates coherent (3:2) from weak (7:5)            →     1000
;   rhythms that lock with a reference are its NEIGHBOURS           →    10000
;   the seeded ladder reads through the ONE engine (domains as data) →   100000
;   an absent rhythm does not pass, though the raw fold flatters it →  1000000
;   attunability reads ONE body through that same engine            → 10000000
;   the coupling has no asker, and does not carry across            → 100000000
;   a SET is read with no seat, and a hub cannot vouch for it       → 1000000000
;
; 111111 -> 11111111 on 2026-08-17: the last two digits arrived together and
; from one probe. Reading a lone body meant asking what its returning phase is,
; which meant asking what happens when there is none — and the raw fold answered
; 1 for (100, 0), tighter than the 2 that tops the whole seeded ladder, with
; coh-coherent? saying yes at threshold 5. The depleted body scored best. The
; floor at coh-rhythm? closed it; digit 1000000 keeps the trap visible next to
; the door so no later hand re-opens it by reading coh-lock-order raw.
;
; preludes: form-stdlib/core.fk form-stdlib/grammars/coherence.fk
;
(do
    ;; --- the reduced ratio is computed -------------------------------------
    (let reduce-ok (if (str_eq (coh-ratio-str 6 4) "3:2") 1 0))

    ;; --- simpler ratio = stronger coupling (smaller lock order) ------------
    ;; 1:1 → 2, 2:1 → 3, 3:2 → 5 : strictly rising as the ratio complexifies.
    (let order-ok
        (if (lt (coh-lock-order 100 100) (coh-lock-order 440 220))
            (if (lt (coh-lock-order 440 220) (coh-lock-order 6 4)) 10 0) 0))

    ;; --- THE HEART: the 1:1 entrainment is the strongest lock in the ladder -
    ;; computed by folding the seeded cross-domain table, not asserted.
    (let strongest (coh-strongest))
    (let heart-ok
        (if (str_eq (coh-pair-domain strongest) "heart-brain")
            (if (eq (coh-lock-order (coh-pair-p strongest) (coh-pair-q strongest)) 2) 100 0) 0))

    ;; --- a threshold separates coherent from weak --------------------------
    ;; 3:2 (order 5) coheres at threshold 5; 7:5 (order 12) does not.
    (let threshold-ok
        (if (eq (coh-coherent? 3 2 5) 1)
            (if (eq (coh-coherent? 7 5 5) 0) 1000 0) 0))

    ;; --- THE NEIGHBOURS OF A REFERENCE -------------------------------------
    ;; among (220 330 440 660 770) with ref 440 at threshold 3, only those whose
    ;; ratio to 440 has lock order <= 3 are near it: 440:440=1:1(2),
    ;; 220:440=2:1(3).
    ;; (660:440=3:2 is order 5; 330:440=4:3 is 7; 770:440=7:4 is 11 — outside.)
    (let near (coh-neighbors (list 220 330 440 660 770) 440 3))
    (let class-ok
        (if (eq (len near) 2)
            (if (eq (head near) 440)                   ; cons order: 440 then 220
                (if (eq (head (tail near)) 220) 10000 0) 0) 0))

    ;; --- the seeded ladder reads through the ONE engine --------------------
    ;; the weak 7:5 pair has lock order 12 via the same coh-lock-order that
    ;; ordered the heart-brain 1:1 — domains as data, one recipe.
    (let ladder-ok
        (if (eq (coh-lock-order 7 5) 12)
            (if (eq (len (coh-resonances)) 5) 100000 0) 0))

    ;; --- THE ABSENT RHYTHM does not pass, and the trap is kept in sight -----
    ;; the raw Farey fold still answers 1 for (100, 0) — tighter than the 2 that
    ;; tops the ladder — because the missing term divides out. That number is
    ;; asserted here on purpose: the defect is not gone, it is fenced, and the
    ;; fence is coh-rhythm?. The predicate answers no where the fold says best —
    ;; a conditional standing on a domain, which is all it is. (Row 999 of the
    ;; homecoming corpus was written about calling that kind of answer a
    ;; refusal; the word belongs to something that could have acted otherwise.)
    (let absent-ok
        (if (eq (coh-lock-order 100 0) 1)
            (if (lt (coh-lock-order 100 0) (coh-lock-order 100 100))
                (if (eq (coh-coherent? 100 0 5) 0)
                    (if (eq (coh-rhythm? 0) 0) 1000000 0) 0) 0) 0))

    ;; --- ATTUNABILITY: one body, read by the same engine --------------------
    ;; a body whose extending and returning phases balance at 1:1 reads the SAME
    ;; order 2 as the heart-brain pair — one engine, no second recipe. A body
    ;; that extends 3 for every 2 it returns still locks (order 5, inside the
    ;; threshold). A body that never returns gets NO READING (0), not a tight
    ;; one, and is not attunable.
    (let solo-ok
        (if (eq (coh-attune-order 100 100) 2)
            (if (eq (coh-attune-order 100 100)
                    (coh-lock-order (coh-pair-p (coh-strongest))
                                    (coh-pair-q (coh-strongest))))
                (if (eq (coh-attunable? 3 2 5) 1)
                    (if (eq (coh-attune-order 100 0) 0)
                        (if (eq (coh-attunable? 100 0 5) 0) 10000000 0) 0) 0) 0) 0))

    ;; --- NO ASKER, AND NO CARRYING ACROSS ----------------------------------
    ;; two questions asked of this cell on 2026-08-17: who locks whom, and who
    ;; orders whom. Both answered by running it, and kept here as the answer.
    ;;
    ;; No asker: the reading is identical from either side, so the pair is not
    ;; something one rhythm does to another.
    ;;
    ;; No carrying across: at threshold 3, 100 is near 200 and 200 is near 400,
    ;; while 100 and 400 are strangers. Reflexive and symmetric, never
    ;; transitive — so no partition exists and the word "class" was wrong. Asked
    ;; of the same three rhythms, the recipe answers 2 from 100, 3 from 200 and
    ;; 2 from 400: the count moves with where you stand. Content-addressing
    ;; would give one address to one content; this gives a view.
    (let noasker-ok
        (if (eq (coh-lock-order 440 220) (coh-lock-order 220 440))
            (if (eq (coh-lock-order 300 300) 2)
                (if (eq (coh-coherent? 100 200 3) 1)
                    (if (eq (coh-coherent? 200 400 3) 1)
                        (if (eq (coh-coherent? 100 400 3) 0)
                            (if (eq (len (coh-neighbors (list 100 200 400) 100 3)) 2)
                                (if (eq (len (coh-neighbors (list 100 200 400) 200 3)) 3)
                                    (if (eq (len (coh-neighbors (list 100 200 400) 400 3)) 2)
                                        100000000 0) 0) 0) 0) 0) 0) 0) 0))

    ;; --- THE READING WITH NO SEAT ------------------------------------------
    ;; coh-neighbors answers 2 from 100, 3 from 200 and 2 from 400 of the same
    ;; three rhythms. coh-mutual? answers ONE thing about all three, and the
    ;; answer is no: 200 touches both ends, and a set is not held together by a
    ;; member who happens to reach everyone. Being seat-free is the claim, so it
    ;; is proved the only way it can be — the reversed list reads the same.
    ;; Fewer than two is NO READING, never a yes: the empty set passes every
    ;; pair test there is, which is the shape band digit 1000000 already fences
    ;; one level down.
    (let seatless-ok
        (if (eq (coh-mutual? (list 100 200 400) 3) 0)
            (if (eq (coh-mutual? (list 400 200 100) 3) 0)
                (if (eq (len (coh-neighbors (list 100 200 400) 200 3)) 3)
                    (if (eq (coh-mutual? (list 220 440) 3) 1)
                        (if (eq (coh-mutual? (list 440 220) 3) 1)
                            (if (eq (coh-mutual? (list 440) 3) 0)
                                (if (eq (coh-mutual? (empty) 3) 0)
                                    1000000000 0) 0) 0) 0) 0) 0) 0))

    (add reduce-ok
    (add order-ok
    (add heart-ok
    (add threshold-ok
    (add class-ok
    (add ladder-ok
    (add absent-ok
    (add solo-ok
    (add noasker-ok seatless-ok))))))))))
