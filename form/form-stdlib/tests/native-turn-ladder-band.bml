  // claim 64
  def ntb-c64(dir) {
   let native = ntb-row("g", ntb-way("native"), "o0", 0, 0, "cd", 0, "f");
   let rows = ntb-carried(dir, "ladder", [native, ntb-row("g", ntb-way("first"), "o1", 40, 0, "cd", 0, "f"), ntb-row("g", ntb-way("resume"), "o2", 40, 0, "cd", 0, "f"), ntb-row("g", ntb-way("context"), "o3", 40, 0, "cd", 0, "f"), ntb-row("g", ntb-way("lens"), "o4", 40, 0, "cd", 0, "f"), ntb-row("g", ntb-way("voice"), "o5", 40, 0, "cd", 0, "f")]);
   let reading = fcgp-reading(rows);
