  def ntb-mem-row(a, reason, checkpoint) = ntb-row-x("g", a, "o1", 0, 0, "cd", 0, "a finding the lane wrote", append([fhn-s("lane_reason", reason)], (String) checkpoint == "" ? [] : [fhn-s("checkpoint_id", checkpoint)]));
