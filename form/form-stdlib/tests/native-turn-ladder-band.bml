   ntb-claim(((Comparable) fcgp-swervecount(rows) == 5) && ((Comparable) ntb-num(reading, "swervecount") == 5) && ((Comparable) len(json-array-elements(json-object-get(reading, "swerve_kinds"))) == 3) && (!fcgp-spent?(rows[0])) && ((String) fcgp-str(rows[0], "rung") == "native") && ((Comparable) ntb-num(before, "swervecount") == 0), 64);
