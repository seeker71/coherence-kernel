; native-turn-ladder-band.bml — the ladder of one gap's options and the door that walks it, with no model and no GPU.
; preludes: form-stdlib/bml/native-turn-ladder.bml
; Verdict 262143
; PROOF LEVEL: FOURTH-ARM ONLY (claims 2048 to 32768 run observe/native-turn-run.bml in a child through host-exec; no sibling kernel carries it)
;
; Ledger rows are written to a scratch file and read back through the carrier (fcgp-rows), as the walk reads
; them. Claims 1 to 1024 are pure and read scripted rows. Claims 2048 to 32768 run the door itself over scratch
; gaps (a scratch queue, a scratch ledger named by the door's "ledger" option, ways limited to the native rung, so no
; model is opened and no GPU is touched); the writable sources and bands live under temp_dir.
;     1  the approach digests of every way are pairwise distinct; a finding, however different, and the order of an
;        approach's keys do not move a digest; the voice is the chain's next model; the lane's rehearsal budget
;        sits inside the search's own limit
;     2  an approach that already stands in this gap's rows with a non-green outcome is refused with no clinamen
;        and its reason names the digest; the next way is admitted and its clinamen names what differs; rows of
;        another gap, another contract, another band, a dry row, a green row and a row with no digest are not history
;     4  a resume after two equal outcomes is refused and the context way is admitted naming what differs from
;        the resume; a resume whose outcomes move is admitted again, up to its cap; a way with no ground
;        (no form.bml source, no checkpoint, no other voice) is refused with its reason; the native rung and a
;        contract row are no nearest approach (the first model way after them names no difference); a resume takes
;        the checkpoint its own model opened
;     8  the outcome digest ignores the digits of a stamp and the .hearth path in a compiler line or in the lane's
;        reason (two identical failures read the same outcome), and separates a different reading, reason,
;        blocking check or unheld claim
;    16  the coherence check: 7 against a full of 3 is above its full, nothing is coherent, 31 of 31 is coherent,
;        a band head naming another verdict than the full is refused, an absent head is no claim; the head is read
;        as validate.sh reads it (the first "Verdict <digits>" on a ';' line before the first code line)
;    32  rung 0 closes a synthetic form.bml gap whose fix is one wrapper, spending checks and no generated ID; a
;        repaired candidate is never judged twice; an unfixable gap is exhausted inside the budget and keeps its
;        original bytes; a source with no form.bml section is inapplicable
;    64  rows in the new shape, read back through fcgp-rows, give fcgp-swervecount above 0 and name their kinds; the
;        native row spends no ID, so it is never a swerve
;   128  ten scripted rows of the shape the ledger holds for bml-cursor-reads-sections (options 1 to 10 of
;        receipts/native-turn-ledger.jsonl: band 7, full 3) are refused at the contract; with coherence set aside,
;        the gate admits at most one option per distinct way (five, with the native rung spending none), and a
;        second pass over the same ways admits none
;   256  a row the walk stopped (the lane at the deadline, a lane that never launched, the native rung at the
;        window's end, a band stopped) is no history, so its approach is admitted again; a native check that was
;        stopped ends the rung as "interrupted" and spends no check, while a candidate that merely failed its band
;        is exhausted
;   512  the syntax stage of rung 0: a source with a three-argument and() is repaired and judged by the check; a
;        check that rejects it does not land it; a repair the check rejects is still the base of the one-value
;        wrapper search, and the wrapper over it lands when the check accepts both
;  1024  a clip never splits a code point
;  2048  the door, over a scratch queue of an unmeetable band (7 against a full of 3) and a fixable gap: the first
;        gap lands one contract row (rung contract, lane_reason band-above-full, band_digest, 0 generated IDs) and
;        opens no option, and the same turn goes on to the fixable gap, whose native row reads green through the
;        real publish window (band_digest, the native approach's digest, 0 generated IDs) and whose source stands
;        landed; the turn's walk line names the parked gap
;  4096  the next turn finds no open gap, names the parked gap as waiting on its contract, and lands no row
;  8192  an unfixable gap lands one native row that reads exhausted (not green, not a swerve) and leaves its source
;        as it was
; 16384  its next turn finds no open gap and names that gap: every way of the ladder already stands under the
;        contract, so the planner may run; no row lands
; 32768  asked for by name, the walk declines after 0 options, its walk line carries the refusal
;        ("refused: native approach-stands"), and no row lands
; 65536  a lane that gave its memory back (lane_reason host-memory-low, a checkpoint saved) or was refused it
;        (host-memory-held:<why>, nothing opened) judged nothing, through the real ntl-hist-of and ntl-admit: one or five
;        such rows leave one pending row (rung memory, no digest, no finding) as the whole history, so resume and the
;        fresh ways stay admitted (five dips do not burn the ladder or park the gap), the first way waits
;        (memory-pending) for the checkpoint to be resumed, held rows leave no history at all, and the pending ends
;        at the next real row (after it the first way stands again)
; 131072 the resume after a memory ending takes that checkpoint (ntl-last-checkpoint) and hears the continue text
;        (ntl-feedback-text of its blank finding), which carries no failure instruction; a real finding still hears
;        the diagnose text, and a real row after the memory row is the checkpoint the next resume takes
section [form.bml] {
 class NativeTurnLadderBand {
  def ntb-claim(ok, bit) = ok ? bit : 0;
  def ntb-num(doc, key) = fcgp-num(doc, key) ?? (0 - 1);
  def ntb-text(rows) = foldl((acc, r) => mc-cat([acc, json-emit(r), "\n"]), "", rows);
  def ntb-carried(dir, name, rows) {
   let path = mc-cat([dir, "/", name, ".jsonl"]);
   let wrote = write_file_text(path, ntb-text(rows));
   fcgp-rows(path);
  }
  def ntb-row-b(gap, a, outcome, gen, green, digest, bdigest, dry, finding, extras) = json-node-object(append([fhn-s("gap", gap), fhn-n("option", 1), fhn-s("checks_digest", digest), fhn-s("band_digest", bdigest), fhn-n("dry", dry), fhn-n("band_green", green), fhn-n("local_generated_ids", gen), fhn-n("local_injected_ids", 0)], append(extras, ntl-row-pairs(a, [], outcome, finding, "none"))));
  def ntb-row-x(gap, a, outcome, gen, green, digest, dry, finding, extras) = ntb-row-b(gap, a, outcome, gen, green, digest, "bd", dry, finding, extras);
  def ntb-row(gap, a, outcome, gen, green, digest, dry, finding) = ntb-row-x(gap, a, outcome, gen, green, digest, dry, finding, []);
  def ntb-ways() = ntl-ways("qwen38-q8", "qwen38-q4", "catalog");
  def ntb-way(rung) = filter(a => (String) ntl-rung(a) == rung, ntb-ways())[0];
  def ntb-avail() = [1, 1];
  def ntb-distinct?(xs) = (Comparable) len(foldl((acc, d) => fcgp-seen(acc, d), [], xs)) == len(xs);
  def ntb-prefix?(s, p) = ntl-starts?(s, p);
  def ntb-has?(s, part) = str_find(s, part, 0) >= 0;
  // claim 1
  def ntb-c1(dir) {
   let ways = ntb-ways();
   let digests = map(a => ntl-approach-digest(a), ways);
   let a = ntb-way("first");
   let rows = ntb-carried(dir, "digest", [ntb-row("g", a, "o1", 40, 0, "cd", 0, "a finding"), ntb-row("g", a, "o1", 40, 0, "cd", 0, "a quite different finding, with the compiler's words in it")]);
   let reordered = parse-json("approach", "{\"rung\":\"first\",\"feedback_source\":\"none\",\"resume\":0,\"decode\":\"greedy\",\"document_context\":\"catalog\",\"code_entry\":\"direct\",\"model\":\"qwen38-q8\"}");
   let fullWays = ntl-ways("qwen38-q8", "qwen38-q4", "full");
   let chain = ["qwen38-q8", "qwen38-q4", "katcoder"];
   ntb-claim(((Comparable) len(ways) == 6) && ntb-distinct?(digests) && ntb-distinct?(map(w => ntl-approach-digest(w), fullWays)) && ((String) fcgp-str(rows[0], "approach_digest") == fcgp-str(rows[1], "approach_digest")) && ((String) fcgp-str(rows[0], "approach_digest") == ntl-approach-digest(a)) && ((String) ntl-approach-digest(reordered) == ntl-approach-digest(a)) && ((String) ntl-voice("qwen38-q8", chain) == "qwen38-q4") && ((String) ntl-voice("qwen38-q4", chain) == "qwen38-q8") && ((String) ntl-voice("katcoder", []) == "") && ((Comparable) ntl-rehearsal-checks() <= fbvs-limit()) && ((String) fcgp-str(fullWays[4], "document_context") == "catalog"), 1);
  }
  // claim 2
  def ntb-c2(dir) {
   let first = ntb-way("first");
   let rows = ntb-carried(dir, "stands", [ntb-row("g", first, "o1", 40, 0, "cd", 0, "f"), ntb-row("other", ntb-way("lens"), "o2", 40, 0, "cd", 0, "f"), ntb-row("g", ntb-way("lens"), "o3", 40, 0, "other-contract", 0, "f"), ntb-row("g", ntb-way("voice"), "o4", 40, 0, "cd", 1, "f"), ntb-row("g", ntb-way("context"), "o5", 40, 1, "cd", 0, "f"), ntb-row-b("g", ntb-way("lens"), "o6", 40, 0, "cd", "the-band-was-rewritten", 0, "f", []), json-node-object([fhn-s("gap", "g"), fhn-s("checks_digest", "cd"), fhn-s("band_digest", "bd"), fhn-n("dry", 0), fhn-n("band_green", 0)])]);
   let hist = ntl-hist-of(rows, "g", "cd", "bd");
   let again = ntl-admit(first, hist, ntb-avail());
   let ctx = ntl-admit(ntb-way("context"), hist, ntb-avail());
   let lens = ntl-admit(ntb-way("lens"), hist, ntb-avail());
   ntb-claim(((Comparable) len(hist) == 1) && ((Comparable) again[0] == 0) && nil?(again[1]) && ntb-prefix?(again[2], "approach-stands: ") && (str_find(again[2], ntl-approach-digest(first), 0) >= 0) && ((Comparable) ctx[0] == 1) && ((String) ntl-join(ctx[1], ",") == "feedback_source") && ((Comparable) lens[0] == 1) && ((String) ntl-join(lens[1], ",") == "code_entry,feedback_source")&& ((Comparable) ntl-admit(first, [], ntb-avail())[0] == 1) && nil?(ntl-admit(first, [], ntb-avail())[1]), 2);
  }
  // claim 4, the model rows alone: the native rung and a contract row are no nearest approach, so the first model way
  // after them names no difference and the next names only what differs from the model way before it; a resume
  // takes the checkpoint its own model opened
  def ntb-contract-way() = ntl-approach("contract", "", "", "", "", 0, "band");
  def ntb-c4b(dir) {
   let first = ntb-way("first");
   let rows = ntb-carried(dir, "nearest", [ntb-row("g", ntb-way("native"), "o0", 0, 0, "cd", 0, "f"), ntb-row("g", ntb-contract-way(), "o0", 0, 0, "cd", 0, "f")]);
   let hist = ntl-hist-of(rows, "g", "cd", "bd");
   let after = ntb-carried(dir, "nearest-first", [rows[0], rows[1], ntb-row("g", first, "o1", 40, 0, "cd", 0, "f")]);
   let hist2 = ntl-hist-of(after, "g", "cd", "bd");
   let cps = ntb-carried(dir, "checkpoints", [ntb-row-x("g", first, "o1", 40, 0, "cd", 0, "f", [fhn-s("checkpoint_id", "cp-q8")]), ntb-row-x("g", ntb-way("voice"), "o2", 40, 0, "cd", 0, "f", [fhn-s("checkpoint_id", "cp-q4")]), ntb-row("g", ntb-way("lens"), "o3", 40, 0, "cd", 0, "f")]);
   ((Comparable) len(hist) == 2) && ((Comparable) ntl-admit(first, hist, ntb-avail())[0] == 1) && nil?(ntl-admit(first, hist, ntb-avail())[1]) && ((String) ntl-join(ntl-admit(ntb-way("context"), hist2, ntb-avail())[1], ",") == "feedback_source") && ((String) ntl-last-checkpoint(cps, "qwen38-q8") == "cp-q8") && ((String) ntl-last-checkpoint(cps, "qwen38-q4") == "cp-q4") && ((String) ntl-last-checkpoint(cps, "katcoder") == "");
  }
  // claim 4
  def ntb-c4(dir) {
   let first = ntb-way("first");
   let resume = ntb-way("resume");
   let same = ntb-carried(dir, "same", [ntb-row("g", first, "o1", 40, 0, "cd", 0, "f"), ntb-row("g", resume, "o1", 40, 0, "cd", 0, "f")]);
   let hs = ntl-hist-of(same, "g", "cd", "bd");
   let moving = ntb-carried(dir, "moving", [ntb-row("g", first, "o1", 40, 0, "cd", 0, "f"), ntb-row("g", resume, "o2", 40, 0, "cd", 0, "f")]);
   let hm = ntl-hist-of(moving, "g", "cd", "bd");
   let capped = ntb-carried(dir, "capped", [ntb-row("g", first, "o0", 40, 0, "cd", 0, "f"), ntb-row("g", resume, "o1", 40, 0, "cd", 0, "f"), ntb-row("g", resume, "o2", 40, 0, "cd", 0, "f"), ntb-row("g", resume, "o3", 40, 0, "cd", 0, "f")]);
   let hc = ntl-hist-of(capped, "g", "cd", "bd");
   let stuck = ntl-admit(resume, hs, ntb-avail());
   let next = ntl-admit(ntb-way("context"), hs, ntb-avail());
   let free = ntl-admit(resume, hm, ntb-avail());
   let cap = ntl-admit(resume, hc, ntb-avail());
   let noBml = ntl-admit(ntb-way("native"), [], [0, 1]);
   let noCp = ntl-admit(resume, [], [1, 0]);
   let noVoice = ntl-admit(ntl-ways("qwen38-q8", "", "catalog")[5], [], ntb-avail());
   ntb-claim(((Comparable) stuck[0] == 0) && ntb-prefix?(stuck[2], "resume-outcome-repeats") && ((Comparable) next[0] == 1) && ((String) ntl-join(next[1], ",") == "resume,feedback_source") && ((Comparable) free[0] == 1) && ((Comparable) cap[0] == 0) && ntb-prefix?(cap[2], "resume-cap") && ((Comparable) noBml[0] == 0) && ntb-prefix?(noBml[2], "native-inapplicable") && ((Comparable) noCp[0] == 0) && ((String) noCp[2] == "no-checkpoint-to-resume") && ((Comparable) noVoice[0] == 0) && ((String) noVoice[2] == "no-other-voice") && ntb-c4b(dir), 4);
  }
  // claim 8
  def ntb-lane-reason(stamp) = mc-cat(["No complete valid native coding result; exact evidence retained at .hearth/native-turns/g-", stamp, ".out"]);
  def ntb-c8() {
   let none = json-node-null();
   let d1 = ntl-outcome-digest(7, "attention", none, "form/x.bml:3:9: error at .hearth/native-turns/g-1790744397187.candidate stamp 1790744397187 unresolved", ["a"]);
   let d2 = ntl-outcome-digest(7, "attention", none, "form/x.bml:3:9: error at .hearth/native-turns/g-1790832493923.candidate stamp 1790832493923 unresolved", ["a"]);
   let d3 = ntl-outcome-digest(3, "attention", none, "form/x.bml:3:9: error at .hearth/native-turns/g-1790744397187.candidate stamp 1790744397187 unresolved", ["a"]);
   let d4 = ntl-outcome-digest(7, "deadline", none, "form/x.bml:3:9: error at .hearth/native-turns/g-1790744397187.candidate stamp 1790744397187 unresolved", ["a"]);
   let d5 = ntl-outcome-digest(7, "attention", parse-json("check", "{\"tool\":\"rg\",\"expected\":\"1\",\"actual\":\"0\"}"), "form/x.bml:3:9: error at .hearth/native-turns/g-1790744397187.candidate stamp 1790744397187 unresolved", ["a"]);
   let d6 = ntl-outcome-digest(7, "attention", none, "form/x.bml:3:9: error at .hearth/native-turns/g-1790744397187.candidate stamp 1790744397187 unresolved", ["b"]);
   let d7 = ntl-outcome-digest(nothing(), "attention", none, "form/x.bml:3:9: error at .hearth/native-turns/g-1790744397187.candidate stamp 1790744397187 unresolved", ["a"]);
   let d8 = ntl-outcome-digest(7, "attention", none, "form/y.bml:3:9: error at .hearth/native-turns/g-1790744397187.candidate stamp 1790744397187 unresolved", ["a"]);
   let r1 = ntl-outcome-digest(nothing(), ntb-lane-reason("1790744397187"), none, "", []);
   let r2 = ntl-outcome-digest(nothing(), ntb-lane-reason("1790832493923"), none, "", []);
   let r3 = ntl-outcome-digest(nothing(), "No complete valid native coding result", none, "", []);
   ntb-claim(((String) d1 == d2) && (!((String) d1 == d3)) && (!((String) d1 == d4)) && (!((String) d1 == d5)) && (!((String) d1 == d6)) && (!((String) d1 == d7)) && (!((String) d1 == d8)) && ntb-distinct?([d1, d3, d4, d5, d6, d7, d8]) && ((String) ntl-plain("a .hearth/native-turns/x 12345 1234567 b\nsecond line") == "a <path> 12345 # b") && ((String) r1 == r2) && (!((String) r1 == r3)), 8);
  }
  // claim 16
  def ntb-comments(n) = (n <= 0) ? "" : mc-cat(["; a comment line of the head\n", ntb-comments((n - 1))]);
  def ntb-c16() {
   ntb-claim(((String) ntl-band-reason(7, 3, "") == "band-above-full") && ((String) ntl-band-reason(nothing(), 3, "") == "") && ((String) ntl-band-reason(31, 31, "") == "") && ((String) ntl-band-reason(0, 3, "") == "") && ((String) ntl-band-reason(2, 3, "; a band\n; Verdict 7 = 1 | 2 | 4\n") == "band-head-differs") && ((String) ntl-band-reason(2, 3, "; a band\n; Verdict 3 = 1 | 2\n") == "") && ((String) ntl-band-reason(2, 3, "; a band with no head\n") == "") && ((Comparable) ntl-head-verdict("; x\n; Verdict 255\n") == 255) && nothing?(ntl-head-verdict("; Verdict\n")) && (str_find(ntl-band-finding("band-above-full", 7, 3), "7 but its full is 3", 0) >= 0) && ((Comparable) len(ntl-contract-reasons()) == 2) && ((Comparable) ntl-head-verdict("\n\n; Verdict 7\n") == 7) && ((Comparable) ntl-head-verdict("; this band's Verdict 9 is pinned\n") == 9) && ((Comparable) ntl-head-verdict("; Verdict: 131 (P1)\n; Verdict 5\n") == 5) && nothing?(ntl-head-verdict("; Verdict: 131 (P1)\n")) && nothing?(ntl-head-verdict("x = 1;\n; Verdict 7\n")) && nothing?(ntl-head-verdict("; head\nsection [form.bml] {\n \"\n; Verdict 7\n")) && ((Comparable) ntl-head-verdict("; Verdict 2^26-1 = every bit\n") == 2) && ((Comparable) ntl-head-verdict(mc-cat([ntb-comments(80), "; Verdict 11\n"])) == 11), 16);
  }
  // claim 32
  def ntb-wrap() = "section [form.bml] {\n class Syn {\n  def syn-neg(x) = 0 - x;\n  def syn-use() = syn-neg(2);\n  def syn-answer(n) = n;\n }\n 0;\n}\n";
  def ntb-fixed(i, text) = (str_find(text, "def syn-answer(n) = syn-neg(n);", 0) >= 0) ? [1, "3"] : [0, "0"];
  def ntb-never(i, text) = [0, "0"];
