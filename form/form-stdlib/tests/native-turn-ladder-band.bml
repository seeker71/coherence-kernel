; native-turn-ladder-band.bml — the ladder of one gap's options, read from scripted rows with no model and no GPU.
; preludes: form-stdlib/bml/native-turn-ladder.bml
; Verdict 255
;
; Ledger rows are written to a scratch file and read back through the carrier (fcgp-rows), as the walk reads
; them. Claim 128 reads the ledger's own rows of the gap that burned the most local time (bml-cursor-reads-sections,
; options 1 to 10: the band read 7 against a full of 3 every time).
;     1  the approach digests of every way are pairwise distinct; a finding, however different, and the order of an
;        approach's keys do not move a digest; the voice is the chain's next model; the lane's rehearsal budget
;        sits inside the search's own limit
;     2  an approach that already stands in this gap's rows with a non-green outcome is refused with no clinamen
;        and its reason names the digest; the next way is admitted and its clinamen names what differs; rows of
;        another gap, another contract, a dry row, a green row and a row with no digest are not history
;     4  a resume after two equal outcomes is refused and the context way is admitted naming what differs from
;        the resume; a resume whose outcomes move is admitted again, up to its cap; a way with no ground
;        (no form.bml source, no checkpoint, no other voice) is refused with its reason
;     8  the outcome digest ignores the digits of a stamp and the .hearth path in a compiler line, and separates
;        a different reading, reason, blocking check or unheld claim
;    16  the coherence check: 7 against a full of 3 is above its full, nothing is coherent, 31 of 31 is coherent,
;        a band head naming another verdict than the full is refused, an absent head is no claim
;    32  rung 0 closes a synthetic form.bml gap whose fix is one wrapper, spending checks and no generated ID; a
;        repaired candidate is never judged twice; an unfixable gap is exhausted inside the budget and keeps its
;        original bytes; a source with no form.bml section is inapplicable
;    64  rows in the new shape, read back through fcgp-rows, give fcgp-swervecount above 0 and name their kinds; the
;        native row spends no ID, so it is never a swerve
;   128  the ledger's ten bml-cursor options (band 7, full 3) are refused at the contract with 0 options; with
;        coherence set aside, the gate admits at most one option per distinct way (five, with the native rung
;        spending none), and a second pass over the same ways admits none
section [form.bml] {
 class NativeTurnLadderBand {
  def ntb-claim(ok, bit) = ok ? bit : 0;
  def ntb-num(doc, key) = fcgp-num(doc, key) ?? (0 - 1);
  def ntb-text(rows) = foldl((acc, r) => mc-cat([acc, json-emit(r), "\n"]), "", rows);
  def ntb-carried(dir, name, rows) {
   let path = mc-cat([dir, "/", name, ".jsonl"]);
   let wrote = write_file_text(path, ntb-text(rows));
   fcgp-rows(path);
  }
  def ntb-row(gap, a, outcome, gen, green, digest, dry, finding) = json-node-object(append([fhn-s("gap", gap), fhn-n("option", 1), fhn-s("checks_digest", digest), fhn-n("dry", dry), fhn-n("band_green", green), fhn-n("local_generated_ids", gen), fhn-n("local_injected_ids", 0)], ntl-row-pairs(a, [], outcome, finding, "none")));
  def ntb-ways() = ntl-ways("qwen38-q8", "qwen38-q4", "catalog");
  def ntb-way(rung) = filter(a => (String) ntl-rung(a) == rung, ntb-ways())[0];
  def ntb-avail() = [1, 1];
  def ntb-distinct?(xs) = (Comparable) len(foldl((acc, d) => fcgp-seen(acc, d), [], xs)) == len(xs);
  def ntb-prefix?(s, p) = ntl-starts?(s, p);
  // claim 1
  def ntb-c1(dir) {
   let ways = ntb-ways();
   let digests = map(a => ntl-approach-digest(a), ways);
   let a = ntb-way("first");
   let rows = ntb-carried(dir, "digest", [ntb-row("g", a, "o1", 40, 0, "cd", 0, "a finding"), ntb-row("g", a, "o1", 40, 0, "cd", 0, "a quite different finding, with the compiler's words in it")]);
   let reordered = parse-json("approach", "{\"rung\":\"first\",\"feedback_source\":\"none\",\"resume\":0,\"decode\":\"greedy\",\"document_context\":\"catalog\",\"code_entry\":\"direct\",\"model\":\"qwen38-q8\"}");
   let fullWays = ntl-ways("qwen38-q8", "qwen38-q4", "full");
   let chain = ["qwen38-q8", "qwen38-q4", "katcoder"];
   ntb-claim(((Comparable) len(ways) == 6) && ntb-distinct?(digests) && ntb-distinct?(map(w => ntl-approach-digest(w), fullWays)) && ((String) fcgp-str(rows[0], "approach_digest") == fcgp-str(rows[1], "approach_digest")) && ((String) fcgp-str(rows[0], "approach_digest") == ntl-approach-digest(a)) && ((String) ntl-approach-digest(reordered) == ntl-approach-digest(a)) && ((String) ntl-voice("qwen38-q8", chain) == "qwen38-q4") && ((String) ntl-voice("qwen38-q4", chain) == "qwen38-q8") && ((String) ntl-voice("katcoder", []) == "") && ((Comparable) ntl-rehearsal-checks() <= fbvs-limit()) && ((String) fcgp-str(fullWays[4], "document_context") == "catalog"), 1);
  }
  // claim 2
  def ntb-c2(dir) {
   let first = ntb-way("first");
   let rows = ntb-carried(dir, "stands", [ntb-row("g", first, "o1", 40, 0, "cd", 0, "f"), ntb-row("other", ntb-way("lens"), "o2", 40, 0, "cd", 0, "f"), ntb-row("g", ntb-way("lens"), "o3", 40, 0, "other-contract", 0, "f"), ntb-row("g", ntb-way("voice"), "o4", 40, 0, "cd", 1, "f"), ntb-row("g", ntb-way("context"), "o5", 40, 1, "cd", 0, "f"), json-node-object([fhn-s("gap", "g"), fhn-s("checks_digest", "cd"), fhn-n("dry", 0), fhn-n("band_green", 0)])]);
   let hist = ntl-hist-of(rows, "g", "cd");
   let again = ntl-admit(first, hist, ntb-avail());
   let ctx = ntl-admit(ntb-way("context"), hist, ntb-avail());
   let lens = ntl-admit(ntb-way("lens"), hist, ntb-avail());
   ntb-claim(((Comparable) len(hist) == 1) && ((Comparable) again[0] == 0) && nil?(again[1]) && ntb-prefix?(again[2], "approach-stands: ") && (str_find(again[2], ntl-approach-digest(first), 0) >= 0) && ((Comparable) ctx[0] == 1) && ((String) ntl-join(ctx[1], ",") == "feedback_source") && ((Comparable) lens[0] == 1) && ((String) ntl-join(lens[1], ",") == "code_entry,feedback_source")&& ((Comparable) ntl-admit(first, [], ntb-avail())[0] == 1) && nil?(ntl-admit(first, [], ntb-avail())[1]), 2);
  }
  // claim 4
  def ntb-c4(dir) {
   let first = ntb-way("first");
   let resume = ntb-way("resume");
   let same = ntb-carried(dir, "same", [ntb-row("g", first, "o1", 40, 0, "cd", 0, "f"), ntb-row("g", resume, "o1", 40, 0, "cd", 0, "f")]);
   let hs = ntl-hist-of(same, "g", "cd");
   let moving = ntb-carried(dir, "moving", [ntb-row("g", first, "o1", 40, 0, "cd", 0, "f"), ntb-row("g", resume, "o2", 40, 0, "cd", 0, "f")]);
   let hm = ntl-hist-of(moving, "g", "cd");
   let capped = ntb-carried(dir, "capped", [ntb-row("g", first, "o0", 40, 0, "cd", 0, "f"), ntb-row("g", resume, "o1", 40, 0, "cd", 0, "f"), ntb-row("g", resume, "o2", 40, 0, "cd", 0, "f"), ntb-row("g", resume, "o3", 40, 0, "cd", 0, "f")]);
   let hc = ntl-hist-of(capped, "g", "cd");
   let stuck = ntl-admit(resume, hs, ntb-avail());
   let next = ntl-admit(ntb-way("context"), hs, ntb-avail());
   let free = ntl-admit(resume, hm, ntb-avail());
   let cap = ntl-admit(resume, hc, ntb-avail());
   let noBml = ntl-admit(ntb-way("native"), [], [0, 1]);
   let noCp = ntl-admit(resume, [], [1, 0]);
   let noVoice = ntl-admit(ntl-ways("qwen38-q8", "", "catalog")[5], [], ntb-avail());
   ntb-claim(((Comparable) stuck[0] == 0) && ntb-prefix?(stuck[2], "resume-outcome-repeats") && ((Comparable) next[0] == 1) && ((String) ntl-join(next[1], ",") == "resume,feedback_source") && ((Comparable) free[0] == 1) && ((Comparable) cap[0] == 0) && ntb-prefix?(cap[2], "resume-cap") && ((Comparable) noBml[0] == 0) && ntb-prefix?(noBml[2], "native-inapplicable") && ((Comparable) noCp[0] == 0) && ((String) noCp[2] == "no-checkpoint-to-resume") && ((Comparable) noVoice[0] == 0) && ((String) noVoice[2] == "no-other-voice"), 4);
  }
  // claim 8
  def ntb-c8() {
   let none = json-node-null();
   let d1 = ntl-outcome-digest(7, "attention", none, "form/x.bml:3:9: error at .hearth/native-turns/g-1790744397187.candidate stamp 1790744397187 unresolved", ["a"]);
   let d2 = ntl-outcome-digest(7, "attention", none, "form/x.bml:3:9: error at .hearth/native-turns/g-1790832493923.candidate stamp 1790832493923 unresolved", ["a"]);
   let d3 = ntl-outcome-digest(3, "attention", none, "form/x.bml:3:9: error at .hearth/native-turns/g-1790744397187.candidate stamp 1790744397187 unresolved", ["a"]);
   let d4 = ntl-outcome-digest(7, "deadline", none, "form/x.bml:3:9: error at .hearth/native-turns/g-1790744397187.candidate stamp 1790744397187 unresolved", ["a"]);
   let d5 = ntl-outcome-digest(7, "attention", parse-json("check", "{\"tool\":\"rg\",\"expected\":\"1\",\"actual\":\"0\"}"), "form/x.bml:3:9: error at .hearth/native-turns/g-1790744397187.candidate stamp 1790744397187 unresolved", ["a"]);
   let d6 = ntl-outcome-digest(7, "attention", none, "form/x.bml:3:9: error at .hearth/native-turns/g-1790744397187.candidate stamp 1790744397187 unresolved", ["b"]);
   let d7 = ntl-outcome-digest(nothing(), "attention", none, "form/x.bml:3:9: error at .hearth/native-turns/g-1790744397187.candidate stamp 1790744397187 unresolved", ["a"]);
   let d8 = ntl-outcome-digest(7, "attention", none, "form/y.bml:3:9: error at .hearth/native-turns/g-1790744397187.candidate stamp 1790744397187 unresolved", ["a"]);
   ntb-claim(((String) d1 == d2) && (!((String) d1 == d3)) && (!((String) d1 == d4)) && (!((String) d1 == d5)) && (!((String) d1 == d6)) && (!((String) d1 == d7)) && (!((String) d1 == d8)) && ntb-distinct?([d1, d3, d4, d5, d6, d7, d8]) && ((String) ntl-plain("a .hearth/native-turns/x 12345 1234567 b\nsecond line") == "a <path> 12345 # b"), 8);
  }
  // claim 16
  def ntb-c16() {
   ntb-claim(((String) ntl-band-reason(7, 3, "") == "band-above-full") && ((String) ntl-band-reason(nothing(), 3, "") == "") && ((String) ntl-band-reason(31, 31, "") == "") && ((String) ntl-band-reason(0, 3, "") == "") && ((String) ntl-band-reason(2, 3, "; a band\n; Verdict 7 = 1 | 2 | 4\n") == "band-head-differs") && ((String) ntl-band-reason(2, 3, "; a band\n; Verdict 3 = 1 | 2\n") == "") && ((String) ntl-band-reason(2, 3, "; a band with no head\n") == "") && ((Comparable) ntl-head-verdict("; x\n; Verdict 255\n") == 255) && nothing?(ntl-head-verdict("; Verdict\n")) && (str_find(ntl-band-finding("band-above-full", 7, 3), "7 but its full is 3", 0) >= 0) && ((Comparable) len(ntl-contract-reasons()) == 2), 16);
  }
  // claim 32
  def ntb-wrap() = "section [form.bml] {\n class Syn {\n  def syn-neg(x) = 0 - x;\n  def syn-use() = syn-neg(2);\n  def syn-answer(n) = n;\n }\n 0;\n}\n";
  def ntb-fixed(i, text) = (str_find(text, "def syn-answer(n) = syn-neg(n);", 0) >= 0) ? [1, "3"] : [0, "0"];
  def ntb-never(i, text) = [0, "0"];
  def ntb-c32() {
   let source = ntb-wrap();
   let r = ntl-native(["not a form source\n", source], ntb-fixed, ntl-native-checks());
   let x = ntl-native([source], ntb-never, 3);
   let n = ntl-native(["plain text\n"], ntb-never, 3);
   let judged = ntl-native-doc(source, 0, (i, text) => [0, "never"], 4);
   ntb-claim(((String) r[0] == "repaired") && ((String) r[1][0] == "not a form source\n") && (str_find(r[1][1], "def syn-answer(n) = syn-neg(n);", 0) >= 0) && ((Comparable) r[2] >= 1) && ((Comparable) r[2] <= ntl-native-checks()) && ((String) r[3] == "one-value-wrapper") && ((String) x[0] == "exhausted") && ((String) x[1][0] == source) && ((Comparable) x[2] <= 3) && ((String) n[0] == "inapplicable") && ((String) n[1][0] == "plain text\n") && ((Comparable) n[2] == 0) && ((String) judged[0] == "exhausted") && ((String) judged[1] == source) && ((Comparable) judged[2] <= 4) && ntl-native-applies?(["x", source]) && (!ntl-native-applies?(["x"])), 32);
  }
  // claim 64
  def ntb-c64(dir) {
   let native = ntb-row("g", ntb-way("native"), "o0", 0, 0, "cd", 0, "f");
   let rows = ntb-carried(dir, "ladder", [native, ntb-row("g", ntb-way("first"), "o1", 40, 0, "cd", 0, "f"), ntb-row("g", ntb-way("resume"), "o2", 40, 0, "cd", 0, "f"), ntb-row("g", ntb-way("context"), "o3", 40, 0, "cd", 0, "f"), ntb-row("g", ntb-way("lens"), "o4", 40, 0, "cd", 0, "f"), ntb-row("g", ntb-way("voice"), "o5", 40, 0, "cd", 0, "f")]);
   let reading = fcgp-reading(rows);
   let before = fcgp-reading(ntb-carried(dir, "old", [json-node-object([fhn-s("gap", "g"), fhn-n("local_generated_ids", 40), fhn-n("band_green", 0)])]));
   ntb-claim(((Comparable) fcgp-swervecount(rows) == 5) && ((Comparable) ntb-num(reading, "swervecount") == 5) && ((Comparable) len(json-array-elements(json-object-get(reading, "swerve_kinds"))) == 3) && (!fcgp-spent?(rows[0])) && ((String) fcgp-str(rows[0], "rung") == "native") && ((Comparable) ntb-num(before, "swervecount") == 0), 64);
  }
  // claim 128
  def ntb-cursor-rows() = filter(r => (String) fcgp-str(r, "gap") == "bml-cursor-reads-sections", fcgp-rows("receipts/native-turn-ledger.jsonl"));
  def ntb-c128(dir) {
   let seen = ntb-cursor-rows();
   let refused = filter(r => (String) ntl-band-reason(fcgp-num(r, "band_before"), fcgp-num(r, "full") ?? 0, "") == "band-above-full", seen);
   let ways = ntb-ways();
   let pass = ntb-replay(ways, [], ntb-avail(), []);
   let second = ntb-replay(ways, pass[0], ntb-avail(), []);
   ntb-claim(((Comparable) len(seen) >= 10) && ((Comparable) len(refused) == len(seen)) && ((Comparable) len(pass[1]) <= len(ways)) && ((Comparable) len(pass[1]) == 5) && nil?(second[1]), 128);
  }
  // the walk over the ways with every option reading the same outcome: [history, admitted rungs]
  def ntb-replay(ways, hist, avail, got) = nil?(ways) ? [hist, reverse(got)] : {
   let verdict = ntl-admit(ways[0], hist, avail);
   let spent = ((String) ntl-rung(ways[0]) != "native");
   (Comparable) verdict[0] == 1 ? ntb-replay(ways[1:], append(hist, [ntb-row("g", ways[0], "same", spent ? 40 : 0, 0, "cd", 0, "f")]), avail, cons(ntl-rung(ways[0]), got)) : ntb-replay(ways[1:], hist, avail, got);
  };
  def ntb-score(dir) {
   let c1 = ntb-c1(dir);
   let c2 = ntb-c2(dir);
   let c4 = ntb-c4(dir);
   let c8 = ntb-c8();
   let c16 = ntb-c16();
   let c32 = ntb-c32();
   let c64 = ntb-c64(dir);
   let c128 = ntb-c128(dir);
   print_str(mc-cat(["native-turn-ladder-band claims ", c1.str(), " ", c2.str(), " ", c4.str(), " ", c8.str(), " ", c16.str(), " ", c32.str(), " ", c64.str(), " ", c128.str()]));
   c1 + c2 + c4 + c8 + c16 + c32 + c64 + c128;
  }
  def ntb-run() {
   let dir = mc-cat([temp_dir(), "/ntl-band-", host_pid().str(), "-", now_unix_ms().str()]);
   let made = fs_mkdir(dir);
   let score = ntb-score(dir);
   let gone = fs_rmdir(dir);
   score;
  }
 }
 ntb-run();
}
