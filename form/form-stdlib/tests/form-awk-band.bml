; form-awk-band.bml — the body's awk (form-stdlib/bml/form-awk.bml): the language, Form's choice inside it, the wire's awk, form-find's awk over
; the body's own records (recipes -P, blueprints -B, cells -C), and form-path's computed tests, choice and transform (form-path.bml).
;
; The answers below are awk's own: each program's expected output is what POSIX awk specifies for it (fields, numeric comparison of
; number-looking fields, leftmost-longest sub and gsub with the empty-match rule, printf's conversions), written out by hand, with two
; deliberate readings of the body's: numbers print by the body's one float rendering (shortest round-trip digits, not OFMT's %.6g),
; and two values compare as numbers whenever both read wholly as numbers. Form's choice is read against control/offer-ack-core.fk and
; teachings/surprise-is-a-choice-point.md: an option is offered from the same state, one that does not land leaves nothing behind.
;
; Expected: 4095
; Verdict 4095 when every claim lands:
;   1     the language: fields, NR NF, -F, OFS, patterns (regex, numeric, string order), ranges, arrays and for-in in insertion order,
;         delete and in, SUBSEP, unset values reading as 0 and "", a field set past NF, NF set, $0 set and split again
;   2     functions and numbers: substr index length split (string, blanks, regex) sub gsub (& and \&, the empty-match rule: "-a-c-")
;         match RSTART RLENGTH toupper tolower int, 7/2 2^10 -2^2 1e3, printf's %s %d %f %x %X %o %c %e %g %% with width, flags, precision
;   4     control: while do for break continue next if/else, exit with a code running END, exit in BEGIN reading no record, ?: and concatenation
;   8     Form's choice: a failed option undoes its variables, elements, fields and printed lines and its finding reaches the next option; the
;         first that lands wins; cut fails the whole choice; fail at a rule's level is counted in FAILS and the next rule is offered;
;         stop ends without END; try/catch with REASON; timeout running out (TIMEOUTS, the loop's writes undone); store()/undo(k);
;         choice(...) passing unset values and endings; a choice nested in an option that lands
;   16    named endings: getline, system, redirection, user functions, an unknown function, an unsupported function, syntax, a bad regex are
;         refused at compile; 1/0 outside every option ends the run with exit 2, keeping what it printed; the step limit is not caught by
;         a choice; the door's refusals (no program, an unknown option, a bad -v, two record sources, files beside a record source)
;   32    the wire: two resident documents (FILENAME, FNR), -v, held input, and -P refused by name on the wire
;   64    -P over a fixture index: recipes as records with @name @arity @line; @node, @path and @line are path --ids' own; $0 is the node's
;         source; defined() and callers() (a negated call !beta(x) is a use of beta); path() and node()
;   128   -B over a fixture registry: rows with their NodeIDs, bp() by alias, bpname() of a NodeID literal, bpmeaning(), an unknown name ""
;   256   -C over a FORMBIN2 ledger written by fvn-ledger-write: fields by name, numbers as numbers, @node the cell's NodeID; the same rows as
;         .rows text read as the same cells
;   512   form-path: a {computed test}, ?? taking the first set that is not empty, => transforming the selection, and a test that ends read
;         as false and said on stderr
;   1024  help awk reaches the local voice: fcap-guides names fwk-guidance, which teaches choice, fail, cut, stop, try, timeout, store and -P
;   2048  the source begins nothing: no host_spawn, host_capture, host-exec, host_wait or sg-spawn in form-awk.bml
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/form-path.bml form-stdlib/bml/form-value-nodes.bml
section [form.bml] {
 class FormAwkBand {
  // ---- running a program over text: [exit, stdout, stderr] ----
  def fab-run(prog, text) = fab-ran(fwk-compile(prog, []), text);
  def fab-ran(c, text) = !fwk-is?(c[1], "") ? [2, "", c[1]] : fwk-run(c[0], fwk-line-records(text, ""), record_new(0, "vars", [], "ext", record_new(0)));
  def fab-out(prog, text) = fab-run(prog, text)[1];
  def fab-is(prog, text, want) = fab-say(prog, fab-out(prog, text), want);
  def fab-say(prog, got, want) {
   let ok = fwk-is?(got, want);
   let z = ok ? 0 : print(["form-awk-band differs", prog, "got", got, "want", want]);
   ok;
  }
  def fab-all(xs) = nil?(xs) ? true : xs[0] ? fab-all(xs[1:]) : false;
  def fab-starts(s, p) = len(s) >= len(p) && fwk-is?(substring(s, 0, len(p)), p);
  def fab-has(s, p) = str_find(s, p, 0) >= 0;
  def fab-why(prog) = fwk-compile(prog, [])[1];
  def fab-d() = "alpha 3 x\nbeta 10 y\ngamma 9 z\n";

  // ---- the fixture: a tree of one source, a registry, a ledger ----
  def fab-base() = temp_dir() ++ "/form-awk-band-" ++ host_pid().str();
  def fab-src() = "section [form.bml] {\n class Foo {\n  def alpha(a, b) = beta(a) + gamma(b, \"hi\");\n  def beta(x) {\n   let y = !beta(x) ? alpha(1, 2) : 0;\n   y;\n  }\n  def a-very-long-recipe-name(p) = alpha(p, p);\n }\n}\n";
  def fab-registry() = "{\"blueprints\": [{\"pkg\": 1, \"level\": 2, \"type\": 97, \"inst\": 1, \"name\": \"LIST\", \"meaning\": \"an ordered run of cells\", \"aliases\": [\"SEQ\"], \"reuse\": 1, \"defined_in\": [\"a.bml\"]}, {\"pkg\": 1, \"level\": 2, \"type\": 97, \"inst\": 2, \"name\": \"MAP\", \"meaning\": \"pairs by key\", \"aliases\": [], \"reuse\": 1, \"defined_in\": []}]}\n";
  def fab-rows() = [record_new(0, "event", "train", "loss", 2.5, "step", 1), record_new(0, "event", "valid", "loss", 1.25, "step", 2)];
  def fab-fixture() {
   let b = fab-base();
   let z0 = fs_rmdir(b);
   let z1 = fs_mkdir(b);
   let z2 = fs_mkdir(b ++ "/form");
   let z3 = fs_mkdir(b ++ "/form/form-stdlib");
   let z4 = write_file_text(b ++ "/a.bml", fab-src());
   let z5 = write_file_text(b ++ "/form/form-stdlib/blueprint-registry.json", fab-registry());
   let z6 = fvn-ledger-write(b ++ "/cells.fkb", map(r => fvn-of(r), fab-rows()));
   let z7 = write_file_text(b ++ "/cells.rows", fat-join(map(r => fvn-text(fvn-of(r)), fab-rows()), "\n") ++ "\n");
   fpa-install(fnd-build(fnd-new(b)));
  }
  def fab-ask(s, cmd) = fab-decoded(faj-json("form-awk-band", fnd-serve(s, "{\"command\":" ++ json-quote-string(cmd) ++ "}")));
  def fab-decoded(n) = [node_value(json-object-get(n, "exit")), node_value(json-object-get(n, "stdout")), node_value(json-object-get(n, "stderr"))];
  def fab-asks(s, cmd, want) = fab-say(cmd, fab-ask(s, cmd)[1], want);

  // ---- 1 the language ----
  def fab-c-language(ctx) = fab-all([
   fab-is("{print $2}", fab-d(), "3\n10\n9\n"),
   fab-is("$2 > 5 {print $1, NR, NF}", fab-d(), "beta 2 3\ngamma 3 3\n"),
   fab-is("{s += $2} END {print s, NR}", fab-d(), "22 3\n"),
   fab-is("/^g/", fab-d(), "gamma 9 z\n"),
   fab-is("$1 < \"b\" {print $1}", fab-d(), "alpha\n"),
   fab-is("BEGIN {OFS = \"-\"} {$1 = $1; print}", "a b c\n", "a-b-c\n"),
   fab-is("NR == 2, NR == 3 {print $1}", fab-d(), "beta\ngamma\n"),
   fab-is("{n[$3]++} END {for (k in n) print k, n[k]}", "a 1 x\nb 2 y\nc 3 x\n", "x 2\ny 1\n"),
   fab-is("BEGIN {a[1]; a[2]; delete a[1]; print length(a), (1 in a), (2 in a)}", "", "1 0 1\n"),
   fab-is("BEGIN {a[\"k\", \"j\"] = 5; for (q in a) {split(q, w, SUBSEP); print w[1], w[2], a[q]}}", "", "k j 5\n"),
   fab-is("BEGIN {print x + 0, length(x), (x == 0), (x == \"\")}", "", "0 0 1 1\n"),
   fab-is("{$5 = \"e\"; print; print NF}", "a b\n", "a b   e\n5\n"),
   fab-is("{NF = 2; print}", "a b c\n", "a b\n"),
   fab-is("{$0 = \"x y z\"; print NF, $3}", "a\n", "3 z\n"),
   fab-say("-F:", fwk-run(fwk-compile("{print $2}", [])[0], fwk-line-records("a:b\nc:d\n", ""), fwk-env(fwk-door(["-F:", "{print $2}"]), record_new(0)))[1], "b\nd\n")]);

  // ---- 2 functions and numbers ----
  def fab-c-functions(ctx) = fab-all([
   fab-is("BEGIN {print substr(\"hello\", 2, 3), substr(\"hello\", 0), substr(\"hello\", -1, 3), index(\"hello\", \"ll\"), length(\"hello\")}", "", "ell hello h 3 5\n"),
   fab-is("BEGIN {n = split(\"a:b:c\", p, \":\"); m = split(\"  x  y \", q); print n, p[1] p[3], m, q[2]}", "", "3 ac 2 y\n"),
   fab-is("BEGIN {n = split(\"a1b22c\", p, /[0-9]+/); print n, p[1], p[2], p[3]}", "", "3 a b c\n"),
   fab-is("BEGIN {x = \"abc\"; n = gsub(/b*/, \"-\", x); print n, x}", "", "3 -a-c-\n"),
   fab-is("{sub(/o+/, \"[&]\"); print}", "foo boo\n", "f[oo] boo\n"),
   fab-is("{gsub(/o/, \"\\\\&\"); print}", "foo boo\n", "f&& b&&\n"),
   fab-is("BEGIN {print match(\"foobar\", /o+/), RSTART, RLENGTH, match(\"x\", /y/), RLENGTH}", "", "2 2 2 0 -1\n"),
   fab-is("BEGIN {print toupper(\"aBc\"), tolower(\"AbC\"), int(-3.7), int(\"12abc\")}", "", "ABC abc -3 12\n"),
   fab-is("BEGIN {print 7/2, 7%3, 2^10, -2^2, 1e3, 0.1 + 0.2}", "", "3.5 1 1024 -4 1000 0.30000000000000004\n"),
   fab-is("BEGIN {printf \"%5s|%-5s|%05.1f|%x|%X|%o|%c|%e|%g|%d%%|%+d|%.3s\\n\", \"ab\", \"cd\", 3.14159, 255, 255, 8, 65, 12345.678, 0.0001234, 50, 5, \"abcdef\"}", "", "   ab|cd   |003.1|ff|FF|10|A|1.234568e+04|0.0001234|50%|+5|abc\n"),
   fab-is("BEGIN {print sprintf(\"%g %g %g %5.2f\", 100000, 1000000, 0.5, -2.345)}", "", "100000 1e+06 0.5 -2.35\n"),
   fab-is("BEGIN {print kind(u), kind(\"s\"), kind(1), nodeid(1, 2, 97, 1), @1.2.97.3}", "", "unset string number @1.2.97.1 @1.2.97.3\n")]);

  // ---- 4 control ----
  def fab-c-control(ctx) = fab-all([
   fab-is("BEGIN {while (i < 3) {i++; if (i == 2) continue; print i}; do {j++} while (j < 5); print j; for (k = 0; k < 10; k++) if (k == 4) break; print k}", "", "1\n3\n5\n4\n"),
   fab-is("NR == 2 {next} {print $1}", fab-d(), "alpha\ngamma\n"),
   fab-is("{if ($2 > 9) print \"big\"; else if ($2 > 5) print \"mid\"; else print \"small\"}", fab-d(), "small\nbig\nmid\n"),
   fab-is("BEGIN {x = 5; print (x > 3 ? \"yes\" : \"no\") \"-\" x}", "", "yes-5\n"),
   fab-say("exit 3", value_str(fab-run("{print \"x\"; exit 3} END {print \"end\"}", fab-d())), value_str([3, "x\nend\n", ""])),
   fab-say("exit in BEGIN", value_str(fab-run("BEGIN {exit 4} {print \"rec\"} END {print \"end\", NR}", fab-d())), value_str([4, "end 0\n", ""]))]);

  // ---- 8 Form's choice ----
  def fab-c-choice(ctx) = fab-all([
   fab-is("BEGIN {x = 1; choice {x = 2; print \"one\"; fail \"no\"} or {print \"two\", x, FINDINGS[1]}; print \"after\", x}", "", "two 1 no\nafter 1\n"),
   fab-is("BEGIN {choice {y = \"a\"} or {y = \"b\"}; print y}", "", "a\n"),
   fab-is("BEGIN {choice {cut; fail \"hard\"} or {print \"never\"}; print \"not here\"} END {print \"end\", FAILS, REASON}", "q\n", "end 1 hard\n"),
   fab-is("$2 > 5 {fail} {print $1} END {print FAILS}", fab-d(), "alpha\nbeta\ngamma\n2\n"),
   fab-say("stop", value_str(fab-run("{print $1} NR == 2 {stop} END {print \"end\"}", fab-d())), value_str([0, "alpha\nbeta\n", ""])),
   fab-is("BEGIN {try {y = 1 / 0} catch {print \"caught:\", REASON}}", "", "caught: awk-division-by-zero\n"),
   fab-is("BEGIN {timeout 100 {while (1) n++}; print \"no\"} END {print TIMEOUTS, REASON, n + 0}", "x\n", "1 timeout 0\n"),
   fab-is("BEGIN {v = 1; k = store(); v = 5; print \"gone\"; undo(k); print \"v=\" v}", "", "v=1\n"),
   fab-is("BEGIN {print choice(u, \"z\"), choice(1/0, \"safe\"), kind(choice(u, w))}", "", "z safe unset\n"),
   fab-is("BEGIN {choice {choice {fail \"in\"} or {a = 1}; b = 2} or {c = 3}; print a, b, c + 0}", "", "1 2 0\n"),
   fab-is("BEGIN {choice {m[\"k\"] = 1; fail} or {}; print length(m), (\"k\" in m)}", "", "0 0\n"),
   fab-is("{choice {$1 = \"X\"; fail} or {}; print}", "a b\n", "a b\n")]);

  // ---- 16 named endings ----
  def fab-c-endings(ctx) = fab-all([
   fab-say("getline", fab-why("BEGIN {getline}"), "awk-getline-not-supported"),
   fab-say("system", fab-why("BEGIN {system(\"ls\")}"), "awk-system-not-supported: the body begins no child"),
   fab-say("redirect", fab-why("{print > \"f\"}"), "awk-output-redirection-not-supported"),
   fab-say("function", fab-why("function f(x) {return x}"), "awk-user-functions-not-supported"),
   fab-say("unknown", fab-why("BEGIN {foo(1)}"), "awk-unknown-function: foo"),
   fab-say("sin", fab-why("BEGIN {sin(1)}"), "awk-function-not-supported: sin"),
   fab-starts(fab-why("BEGIN {print (1}"), "awk-syntax:") && fab-starts(fab-why("{print $1 print $2}"), "awk-syntax:") && fab-starts(fab-why("/a(/"), "awk-regex:"),
   fab-say("1/0", value_str(fab-run("BEGIN {print \"a\"; print 1/0; print \"b\"}", "")), value_str([2, "a\n", "awk-division-by-zero"])),
   fab-uncaught(fab-run("BEGIN {choice {while (1) {}} or {print \"caught\"}}", "")),
   fab-say("no program", record_get(fwk-door([]), "err"), "awk-needs-a-program"),
   fab-say("option", record_get(fwk-door(["-x", "p"]), "err"), "awk-unknown-option: -x"),
   fab-starts(record_get(fwk-door(["-v", "1x=2", "p"]), "err"), "awk-v-needs-name=value"),
   fab-starts(record_get(fwk-door(["-P", "//def", "-B", "p"]), "err"), "awk-one-record-source"),
   fab-starts(record_get(fwk-door(["-B", "p", "file"]), "err"), "awk-files-and-form-records")]);

  def fab-uncaught(r) = r[0] == 2 && fab-starts(r[2], "awk-step-limit") && fwk-is?(r[1], "");

  // ---- 32 the wire ----
  def fab-docs() = [["d:a", "a.txt", "1\n2\n"], ["d:b", "b.txt", "3\n"]];
  def fab-c-wire(ctx) = fab-all([
   fab-say("documents", fat-out(fat-command(fab-docs(), "awk 'FNR == 1 {print FILENAME} {n++} END {print n}' a.txt b.txt", "")), "a.txt\nb.txt\n3\n"),
   fab-say("-v", fat-out(fat-command(fab-docs(), "awk -v k=7 'BEGIN {print k * 2}'", "")), "14\n"),
   fab-say("input", fat-out(fat-command([], "awk '{print $2}'", "one two\nthree four\n")), "two\nfour\n"),
   fab-starts(fat-error(fat-command([], "awk -P //def '{print}'", "")), "awk-form-records-need-the-index")]);

  // ---- 64 -P: recipes as records ----
  def fab-c-recipes(s) = fab-all([
   fab-asks(s, "awk -P //def '{print @name, @arity, @line}'", "alpha 2 3\nbeta 1 4\na-very-long-recipe-name 1 8\n"),
   fab-say("ids", fab-ask(s, "awk -P //def '{print @node, @path \":\" @line, @name}'")[1], fab-ask(s, "path --ids //def")[1]),
   fab-asks(s, "awk -P //def '{print length($0) == @bytes}'", "1\n1\n1\n"),
   fab-asks(s, "awk 'BEGIN {print defined(\"beta\"), callers(\"beta\"), callers(\"alpha\")}'", "a.bml:4 2 2\n"),
   fab-asks(s, "awk 'BEGIN {n = path(\"//call[@name=\\\"alpha\\\"]\", ids); for (i = 1; i <= n; i++) print node(ids[i], \"line\")}'", "5\n8\n")]);

  // ---- 128 -B: blueprints ----
  def fab-c-blueprints(s) = fab-asks(s, "awk -B '{print @id, @name, @aliases} END {print bp(\"SEQ\"), bpname(@1.2.97.2), bpmeaning(\"LIST\"), bp(\"NOPE\") \"|\"}'", "@1.2.97.1 LIST SEQ\n@1.2.97.2 MAP \n@1.2.97.1 MAP an ordered run of cells |\n");

  // ---- 256 -C: cells ----
  def fab-c-cells(s) {
   let led = fab-base() ++ "/cells.fkb";
   let first = value_str(fvn-ledger(led)[0]);
   let fkb = fab-asks(s, "awk -C " ++ led ++ " '{s += @loss; print @event, @step, kind(@loss)} END {print s, NR}'", "train 1 number\nvalid 2 number\n3.75 2\n");
   let node = fab-say("@node", fab-ask(s, "awk -C " ++ led ++ " 'NR == 1 {print @node}'")[1], first ++ "\n");
   let rows = fab-asks(s, "awk -C " ++ fab-base() ++ "/cells.rows '{print @event, @loss}'", "train 2.5\nvalid 1.25\n");
   fkb && node && rows;
  }

  // ---- 512 form-path: computed tests, choice, transform ----
  def fab-c-path(s) = fab-all([
   fab-has(fab-ask(s, "path --ids '//def[{ length(@name) > 10 }]'")[1], "a-very-long-recipe-name") && !fab-has(fab-ask(s, "path --ids '//def[{ length(@name) > 10 }]'")[1], " beta"),
   fab-starts(fab-ask(s, "path '//def[@name=\"nope\"] ?? //def[@name=\"beta\"]'")[1], "a.bml:4:"),
   fab-asks(s, "path '//def[@arity=1] => { print toupper(@name) }'", "BETA\nA-VERY-LONG-RECIPE-NAME\n"),
   fab-has(fab-ask(s, "path --count '//def[{ 1/0 }]'")[2], "3 computed test(s) ended")]);

  // ---- 1024 help awk reaches the local voice ----
  def fab-c-guide(ctx) = fab-has(read_file("form/form-stdlib/bml/form-cli-code-policy.bml") ?? "", "[\"awk\",fwk-guidance]")
   && fab-all(map(w => fab-has(fwk-guidance(), w), ["choice {", "fail", "cut", "stop", "try {", "timeout", "store()", "awk -P", "without being told the verb"]));

  // ---- 2048 the source begins nothing ----
  def fab-c-quiet(ctx) = fab-all(map(w => !fab-has(read_file("form/form-stdlib/bml/form-awk.bml") ?? "host_spawn", w), ["host_spawn", "host_capture", "host-exec", "host_wait", "sg-spawn"]));
 }
 let s = fab-fixture();
 let verdict = live-claims("form-awk-band", s, [["language", 1, 1, fab-c-language], ["functions", 2, 1, fab-c-functions], ["control", 4, 1, fab-c-control], ["choice", 8, 1, fab-c-choice], ["endings", 16, 1, fab-c-endings], ["wire", 32, 1, fab-c-wire], ["recipes", 64, 1, fab-c-recipes], ["blueprints", 128, 1, fab-c-blueprints], ["cells", 256, 1, fab-c-cells], ["path", 512, 1, fab-c-path], ["guide", 1024, 1, fab-c-guide], ["quiet", 2048, 1, fab-c-quiet]]);
 let gone = fs_rmdir(fab-base());
 verdict;
}
