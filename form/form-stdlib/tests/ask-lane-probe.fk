; tests/ask-lane-probe.fk — put a real question to the ASK verb and print, verbatim,
; what the body says back on this host. Not a band: it returns 0 and its worth is the
; transcript, which is why it prints rather than folding to a verdict.
; observe/tests/ask-lane-floor-band.fk is the verdict for the same lane (31).
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/sha256.fk form-stdlib/hex.fk
; preludes: form-stdlib/text-tokenize.fk form-stdlib/rag-embed.fk
; preludes: form-stdlib/rag-index-codec.fk form-stdlib/rag-retrieve.fk form-stdlib/rag-ask.fk
; preludes: form-stdlib/ask-cost-receipt.fk form-stdlib/ask-native-lane.fk form-stdlib/form-cli-ask.fk
;
; run: ./fkwu --src form/form-stdlib/tests/ask-lane-probe.fk
;
; The committed form/form-cli is a Mach-O arm64 binary and cannot execute on a Linux
; host, so this file is how the ASK verb is reached here: its own cells, straight
; through the source runner. That is the more native route regardless — no prebuilt
; binary in the path, and every line of the answer computed by the verb itself.
;
; witnessed: 2026-07-25 -> lane fkwu-rag-grounded, refusal native-lane:absent,
;            model "", answer a grounded miss carrying its declined: reason
;            (no GPU, no local runner, 0 GGUF on disk, no staged index; rag-heal
;            is fail-closed at refusal 73, so the index cannot be built here either)

(do
    (defn alp-q () "What is BenchBenchBench, and does the recursion terminate?")
    (defn alp-nl () (byte_to_str 10))
    (defn alp-line (label value)
        (do (print_str (str_concat label value)) (print_str (alp-nl)) 0))
    (defn alp-run ()
        (do (alp-line "lane: " (fca-lane-of (alp-q)))
            (alp-line "refusal: " (anl-refusal (alp-q)))
            (alp-line "model: " (anl-model))
            (alp-line "--- fca-ask ---" "")
            (alp-line "" (fca-ask (alp-q)))
            0))
    (alp-run))
