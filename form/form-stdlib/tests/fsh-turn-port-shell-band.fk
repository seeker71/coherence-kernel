; fsh-turn-port-shell-band.fk -- direct Form proof for the closed turn-port seam.
;
; The band runs only the Form parser/evaluator/planner.  It observes the
; canonical one-id capability/refusal envelope and base-shell delegation; it
; does not run a child, discover hardware, access a filesystem, or cross a
; network boundary.
;
; Verdict: 127.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/grammar-loader.fk form-stdlib/shell-grammar.fk form-stdlib/voice-traits.fk form-stdlib/feature-vector.fk form-stdlib/voice-diarize.fk form-stdlib/fsh-turn-process-spec.fk form-stdlib/nearest-shape.fk form-stdlib/shell-exec.fk form-stdlib/fsh-turn-port-shell.fk

(do
    (defn fstps-envelope (exchange-id decision)
        (str_concat "schema=fsh-turn-process-spec-v2\n"
        (str_concat "kind=native-turn-capability-request\n"
        (str_concat "execution=non-executable\n"
        (str_concat "capability_stage=native-pending-discovery\n"
        (str_concat "exchange_id="
        (str_concat exchange-id
        (str_concat "\nexecutable=none\nargv=none\ndecision="
        (str_concat decision "\n")))))))))
    (let id "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    (let valid (str_concat "turn-port " id))
    (let invalid-id (str_concat "A" (substring id 1 64)))
    (let invalid (str_concat "turn-port " invalid-id))
    (let extra (str_concat "turn-port extra " id))
    (let valid-output (sh-out valid))
    (let invalid-output (sh-out invalid))
    (let missing-output (sh-out "turn-port"))
    (let extra-output (sh-out extra))
    (let valid-step (head (sh-plan (sh-parse valid))))
    (let echo-step (head (sh-plan (sh-parse "echo still-form"))))
    (let passthrough-step (head (sh-plan (sh-parse "git status"))))
    (let c0 (if (and (eq (sh-exit valid) 69)
                     (and (str_eq valid-output (fshps-render-plan id))
                          (str_eq valid-output
                                  (fstps-envelope id
                                      "refused-no-form-native-child-executor")))) 1 0))
    (let c1 (if (and (str_eq (sh-step-kind valid-step) "native-unavailable")
                     (and (str_eq (sh-step-name valid-step) "turn-port")
                          (and (eq (len (sh-step-args valid-step)) 1)
                               (str_eq (head (sh-step-args valid-step)) id)))) 2 0))
    (let c2 (if (and (eq (sh-exit invalid) 64)
                     (and (str_eq invalid-output (fshps-render-plan invalid-id))
                          (str_eq invalid-output
                                  (fstps-envelope "" "refused-invalid-exchange-id")))) 4 0))
    (let c3 (if (and (eq (sh-exit "turn-port") 64)
                     (str_eq missing-output
                             (fstps-envelope "" "refused-turn-port-arity"))) 8 0))
    (let c4 (if (and (eq (sh-exit extra) 64)
                     (str_eq extra-output
                             (fstps-envelope "" "refused-turn-port-arity"))) 16 0))
    (let c5 (if (and (eq (sh-exit "echo still-form") 0)
                     (and (str_eq (sh-out "echo still-form") "still-form\n")
                          (str_eq (sh-step-kind echo-step) "native"))) 32 0))
    (let c6 (if (and (eq (sh-exit "git status") 0)
                     (and (str_eq (sh-out "git status") "[passthrough] git status")
                          (str_eq (sh-step-kind passthrough-step) "passthrough"))) 64 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6)))))))
