// Native queries over resident documents; no model, process or state writes.
// preludes: form-stdlib/bml/form-cli-source-report-check.bml
section [form.bml] {
 class FormSourceReportCheckBand {
  def fsrcb-demand(ok,reason) = if ok then 1 else form_error(reason);
  def fsrcb-query(selector,path) = json-node-object(list(nsm-s("tool","jq"),json-node-pair("arguments",json-node-array(if str_eq(path,"") then list(json-node-string(selector)) else list(json-node-string(selector),json-node-string(path))))));
  def fsrcb-run() {
   let docs = list(list("sample","source.json","{\"zero\":0,\"declined\":false,\"absent\":null}"));
   let zero = fsrc-derive(docs,fsrcb-query(".zero","source.json"),fsrcb-query(".quantity",""));
   let declined = fsrc-derive(docs,fsrcb-query(".declined","source.json"),fsrcb-query(".quantity",""));
   let absent = fsrc-derive(docs,fsrcb-query(".absent","source.json"),fsrcb-query(".quantity",""));
   fsrcb-demand(and(head(zero),and(head(declined),head(absent))),"source queries did not produce assertions");
   fsrcb-demand(head(fcaq-report-check(list(nth(zero,1)),"{\"quantity\":0}")),"observed zero did not match");
   fsrcb-demand(not(head(fcaq-report-check(list(nth(zero,1)),"{\"quantity\":false}"))),"zero and false collapsed");
   fsrcb-demand(head(fcaq-report-check(list(nth(declined,1)),"{\"quantity\":false}")),"observed false did not match");
   fsrcb-demand(head(fcaq-report-check(list(nth(absent,1)),"{\"quantity\":null}")),"observed null did not match");
   fsrcb-demand(not(head(fsrc-derive(docs,fsrcb-query(".zero","missing.json"),fsrcb-query(".quantity","")))),"missing source became an expected value");
   fsrcb-demand(not(head(fsrc-derive(docs,oh-set(fsrcb-query(".zero","source.json"),"stdout",json-node-string("9\n")),fsrcb-query(".quantity","")))),"caller supplied expected bytes displaced source execution");
   let changed = fsrc-derive(list(list("sample","source.json","{\"zero\":9}")),fsrcb-query(".zero","source.json"),fsrcb-query(".quantity",""));
   fsrcb-demand(and(head(fcaq-report-check(list(nth(changed,1)),"{\"quantity\":9}")),not(head(fcaq-report-check(list(nth(zero,1)),"{\"quantity\":9}")))),"source change did not produce a distinct frozen assertion");
   1;
  }
 }
 print(fsrcb-run());
}
