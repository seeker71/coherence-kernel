; form-cli-nodeid-answer-bml-band.fk — delayed pointer, risen to BML.
;
; Verdict 31:
;   1   fnidb-check = 1048575
;   2   surface and organ both 1048575 and agree on ask 5 / tree 47
;   4   authority picture names package and class
;   8   executable .bml carries section and recipe def
;   16  the .bml names its core prelude (floor)
;
; preludes: form-stdlib/form-cli-nodeid-answer.fk form-stdlib/form-cli-nodeid-answer.bml
; witnessed: 2026-08-30 -> 31

(do
    (defn fnidbb-bit (ok bit) (if ok bit 0))
    (defn fnidbb-has? (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let exec-text (read_file "form/form-stdlib/form-cli-nodeid-answer.bml"))
    (let pic-text (read_file "form/form-stdlib/bml/form-cli-nodeid-answer.bml"))
    (add
        (fnidbb-bit (eq (fnidb-check) 1048575) 1)
        (add (fnidbb-bit (and (eq (fnid-check) 1048575)
                             (and (eq (fnidb-check) 1048575)
                                  (and (eq (fnid-reply (fnid-ask (fnid-recipe "add" 2 3))) 5)
                                       (eq (fnidb-reply (fnidb-ask (fnidb-recipe "add" 2 3))) 5)))) 2)
        (add (fnidbb-bit (and (eq (fnidbb-has? pic-text "package Form.cli.nodeidanswer") 1)
                             (eq (fnidbb-has? pic-text "class FormNodeidAnswer") 1)) 4)
        (add (fnidbb-bit (and (eq (fnidbb-has? exec-text "section [form.bml]") 1)
                             (eq (fnidbb-has? exec-text "def fnidb-recipe") 1)) 8)
            (fnidbb-bit (eq (fnidbb-has? exec-text "preludes: form-stdlib/core.fk") 1) 16))))))
)
