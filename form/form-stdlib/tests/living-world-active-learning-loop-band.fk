; living-world-active-learning-loop-band.fk -- enquiry-derived evidence closes
; into successor tissue and an identity-aligned prospective movement.
; Twenty-four claims; no accept/reject or promotion bit exists.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-prospective-suite.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk

(do
    (let result (lwhlw-run))
    (let world (nth (node_children result) 0))
    (let incumbent (nth (node_children result) 1))
    (let arriving (nth (node_children result) 2))
    (let enquiry (nth (node_children result) 3))
    (let first-trial (nth (node_children result) 4))
    (let second-trial (nth (node_children result) 5))
    (let first-placement (nth (node_children result) 6))
    (let second-placement (nth (node_children result) 7))
    (let tissue (nth (node_children result) 8))
    (let suite (nth (node_children result) 9))
    (let incumbent-eval (nth (node_children result) 10))
    (let arriving-eval (nth (node_children result) 11))
    (let comparison (nth (node_children result) 12))
    (let incumbent-metrics (lwps-evaluation-metrics incumbent-eval))
    (let arriving-metrics (lwps-evaluation-metrics arriving-eval))
    (let events (framebuffer-events))
    (sum (list
        (if (eq (lwo-field-size (lwhe-enquiry-trials enquiry)) 3) 1 0)
        (if (eq (lwo-field-size (lwhe-enquiry-separating enquiry)) 2) 2 0)
        (if (eq (lwo-field-size (lwhe-enquiry-aligned enquiry)) 1) 4 0)
        (if (and (eq (lwhe-separating? (lwhe-trial-state first-trial)) 1)
                 (eq (lwhe-separating? (lwhe-trial-state second-trial)) 1)) 8 0)
        (if (not (node_eq first-trial second-trial)) 16 0)
        (if (eq (lwph-discriminated?
                  (lwph-placement-status first-placement)) 1) 32 0)
        (if (eq (lwph-discriminated?
                  (lwph-placement-status second-placement)) 1) 64 0)
        (if (and (eq (lwo-field-size
                       (lwph-placement-confirmed first-placement)) 2)
                 (eq (lwo-field-size
                       (lwph-placement-diverged first-placement)) 2)) 128 0)
        (if (and (eq (lwo-field-size
                       (lwph-placement-confirmed second-placement)) 2)
                 (eq (lwo-field-size
                       (lwph-placement-diverged second-placement)) 2)) 256 0)
        (if (eq (lwo-field-size (lwht-tissue-placements tissue)) 2) 512 0)
        (if (eq (lwo-field-size (lwht-tissue-compatible tissue)) 2) 1024 0)
        (if (eq (lwo-field-size (lwht-tissue-contradicted tissue)) 2) 2048 0)
        (if (eq (lwo-field-size (lwps-candidate-hypotheses incumbent)) 4) 4096 0)
        (if (eq (lwo-field-size (lwps-candidate-hypotheses arriving)) 2) 8192 0)
        (if (and (eq (lwps-candidate-current? world incumbent 2) 1)
                 (eq (lwps-candidate-current? world arriving 2) 1)) 16384 0)
        (if (eq (lwps-suite-current? world suite 2) 1) 32768 0)
        (if (and (eq (lwps-evaluation? incumbent-eval) 1)
                 (eq (lwps-evaluation? arriving-eval) 1)) 65536 0)
        (if (eq (lwps-metrics-value incumbent-metrics 3) 3) 131072 0)
        (if (eq (lwps-metrics-value arriving-metrics 2) 3) 262144 0)
        (if (eq (lwps-comparison-admissible comparison) 1) 524288 0)
        (if (and (eq (nth (lwps-delta-values
                            (lwps-comparison-delta comparison)) 2) 3)
                 (eq (nth (lwps-delta-values
                            (lwps-comparison-delta comparison)) 3) -3)) 1048576 0)
        (if (eq (lwps-comparison-repeated comparison) 0) 2097152 0)
        (if (and (node_eq (lwps-evaluation-dataset incumbent-eval)
                          (lwps-evaluation-dataset arriving-eval))
                 (and (node_eq (lwps-evaluation-split incumbent-eval)
                               (lwps-evaluation-split arriving-eval))
                      (node_eq (lwps-evaluation-contract incumbent-eval)
                               (lwps-evaluation-contract arriving-eval)))) 4194304 0)
        (if (eq (len events) 5) 8388608 0))))
