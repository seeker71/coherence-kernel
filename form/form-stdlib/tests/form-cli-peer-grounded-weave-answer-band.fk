; form-cli-peer-grounded-weave-answer-band.fk -- plural current-source
; observation stays local until every named definition has become evidence.
;
; preludes: form-stdlib/form-cli-peer-grounded-weave-answer.fk

(do
    (defn fcpagwb-bit (held weight) (if held weight 0))
    (defn fcpagwb-root ()
        (fs-path-join (fs-temp-dir) "form-cli-peer-grounded-weave-answer-band"))
    (defn fcpagwb-setup ()
        (do
            (let root (fcpagwb-root))
            (let _old (fs-remove-tree root))
            (let _root (fs-mkdir root))
            (let _form (fs-mkdir (fs-path-join root "form")))
            (let _a (fs-write-text (fs-path-join root "form/alpha.fk")
                "(defn alpha () \"alpha is current source knowledge.\")"))
            (let _b (fs-write-text (fs-path-join root "form/beta.fk")
                "(defn beta () \"beta joins alpha as current source knowledge.\")"))
            root))
    (defn fcpagwb-context (root)
        (fcpalsa-source-context root "artifact"
            (sof-snapshot 17 (list "form")
                (list (list "alpha" "form/alpha.fk")
                      (list "beta" "form/beta.fk"))) 17))
    (defn form-cli-peer-grounded-weave-answer-band ()
        (do
            (let root (fcpagwb-setup))
            (let session (fcms-none "model-not-opened-in-weave-band"))
            (let context (fcpagwb-context root))
            (let ready (fcpagw-task "alpha + beta :: What do these two definitions say?"))
            (let malformed (fcpagw-task "alpha :: What does alpha say?"))
            (let result (fcpagw-run session
                "alpha + beta :: What do these two definitions say?" context 1))
            (let evidence (fcpagw-source-evidence result))
            (let direct (fcpagw-direct-result result))
            (let peer (fcpagw-peer result))
            (let partial (fcpagw-run session
                "alpha + unborn :: What do these say?" context 2))
            (let ready-ok
                (and (str_eq (fcpagw-task-status ready) "value")
                    (and (eq (len (fcpagw-task-symbols ready)) 2)
                        (and (str_eq (head (fcpagw-task-symbols ready)) "alpha")
                            (and (str_eq (head (tail (fcpagw-task-symbols ready))) "beta")
                                (str_eq (fcpagw-task-reason ready) "weave-task-ready"))))))
            (let malformed-ok
                (and (str_eq (fcpagw-task-status malformed) "choice")
                    (str_eq (fcpagw-task-reason malformed)
                        "weave-requires-two-or-more-symbols-delimiter-question")))
            (let spans (fcpagw-observation-spans
                (fcpagw-evidence-observations evidence)))
            (let source-ok
                (and (str_eq (fcpagw-evidence-signal evidence) "value")
                    (and (eq (len (fcpagw-evidence-symbol-results evidence)) 2)
                        (and (eq (len (fcpagw-evidence-observations evidence)) 2)
                            (and (ge (str_find spans "(defn alpha" 0) 0)
                                (ge (str_find spans "(defn beta" 0) 0))))))
            (let direct-ok
                (and (str_eq (fcpagw-signal result) "nothing")
                    (and (str_eq (fcpagw-reason result) "model-session-not-live")
                        (and (str_eq (fcpdaa-signal direct) "nothing")
                            (ge (str_find (fcpagw-model-task
                                (fcpagw-task-question ready) evidence)
                                "source-path=form/alpha.fk" 0) 0)))))
            (let partial-evidence (fcpagw-source-evidence partial))
            (let partial-ok
                (and (str_eq (fcpagw-signal partial) "nothing")
                    (and (str_eq (fcpagw-reason partial) "symbol-unborn")
                        (and (eq (len (fcpagw-evidence-symbol-results partial-evidence)) 2)
                            (eq (len (fcpagw-evidence-observations partial-evidence)) 1)))))
            (let peer-ok
                (and (str_eq (fcpa-route peer) "grounded-weave")
                    (and (eq (fcpa-callback-calls peer) 0)
                        (and (eq (fcpa-contribution peer) 0)
                            (and (eq (fcpa-lookup-count peer) 4)
                                (value_eq (fcpa-session peer) session))))))
            (let result-ok
                (and (eq (fcpagw-result? result) 1)
                    (and (str_eq (fcpagw-lifecycle result)
                            "source-symbol,current-source,nothing,release")
                        (str_eq (fcpagw-tool-status result)
                            "symbols=2;current-source=value;model=nothing;lookups=4"))))
            (let score (sum (list
                (fcpagwb-bit ready-ok 1)
                (fcpagwb-bit malformed-ok 2)
                (fcpagwb-bit source-ok 4)
                (fcpagwb-bit direct-ok 8)
                (fcpagwb-bit partial-ok 16)
                (fcpagwb-bit peer-ok 32)
                (fcpagwb-bit result-ok 64))))
            (let _cleanup (fs-remove-tree root))
            score))
    (form-cli-peer-grounded-weave-answer-band))
