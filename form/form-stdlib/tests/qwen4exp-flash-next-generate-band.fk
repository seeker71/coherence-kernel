; qwen4exp-flash-next-generate-band.fk — response schema, stop semantics,
; native tokenizer decode, and high-BML no-server authority.  The real Metal
; evaluator is proven by qwen4exp-flash-next-token-live-run.fk.
;
; preludes: form/form-stdlib/qwen4exp-flash-next-tokenizer.bml form/form-stdlib/qwen4exp-flash-next-state.bml form/form-stdlib/qwen4exp-flash-next-generate.bml form/form-stdlib/model-registry.bml
;
; Verdict 255: 127 executable + 128 high-BML authority.

(do
    (defn q4xb-has (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let path (mr-path (mr-find "qwen38-flash-next-q2")))
    (let src (eqr-of-file path 0 12000000))
    (let slot (q4s-slot "fixture-" 0 16 1 9419 248046 (list 9419) 11 "fixture"))
    (let result (q4x-result slot (list 11 3268 13) (q4tk-decode src (list 11 3268 13)) "budget" 1))
    (let c0 (if (str_eq (q4x-result-text result) ", Form.") 1 0))
    (let c1 (if (and (eq (q4x-result-generated result) 3) (eq (q4x-result-prompt-tokens result) 1)) 2 0))
    (let c2 (if (str_eq (q4x-result-reason result) "budget") 4 0))
    (let c3 (if (str_eq (q4x-stop-reason 248046 8) "eos") 8 0))
    (let c4 (if (str_eq (q4x-stop-reason 11 0) "budget") 16 0))
    (let c5 (if (str_eq (q4x-stop-reason 11 1) "continue") 32 0))
    (let c6 (if (and (eq (q4tk-stop? 248046) 1) (eq (q4tk-stop? 11) 0)) 64 0))
    (let base (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6)))))))
    (let authority-src (read_file "form/form-stdlib/bml/qwen4exp-flash-next-generate.bml"))
    (let authority
        (if (eq (q4xb-has authority-src "const String Runtime = \"fkwu-form-metal-jit\"") 1)
            (if (eq (q4xb-has authority-src "const String ExternalRuntime = \"none\"") 1)
                (if (eq (q4xb-has authority-src "const String Server = \"none\"") 1) 128 0) 0) 0))
    (add base authority))
