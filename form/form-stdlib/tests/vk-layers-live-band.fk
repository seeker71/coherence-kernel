; preludes: form-stdlib/core.fk form-stdlib/transformer-numerics.fk form-stdlib/transformer-block.fk form-stdlib/llama-numerics.fk form/form-stdlib/form-glsl-layers.bml form/form-stdlib/vk-door.bml
; Expected: 127
; REQUIRES: nothing outside the tree (the Vulkan door begins no process; this body carries no Vulkan runner)
;
; vk-layers-live-band — the transformer's layers as a Vulkan plan: the six shaders the recipes emit, the
; nine-dispatch plan laid out one line per word, the nine fp64 recipes the plan's reads would be judged
; by, and the reader that turns a carrier's answer back into floats. This body carries no GLSL compiler and
; no Vulkan runner (form-stdlib/vk-door.bml), so the door answers its absence by name and the band holds
; every part that is Form. Nothing is guessed in place of a device's answer: with none, no recipe agrees.
; The shape of the claims to come, when a runner of the body's own answers: agree to fp32 epsilon (2^-15
; absolute on values of order one) with the recipe each shader twins, not to the bit.
;
; Verdict 127 when every claim lands:
;    1  the door starts nothing and says so by name: vkd-ready? reads 0, all six mints and the plan's exec
;       answer the named absence, no device is named, and vk-door.bml holds no process door
;    2  the six shaders (gelu, softmax, layernorm, rmsnorm, residual, attention) are shaders, and a non-shader
;       is refused
;    4  the plan is the carrier protocol: six spv lines, 28 buffers (buf and zero), nine runs, nine reads
;    8  the nine recipes (tn-gelu, tn-softmax, tb-ln-seq, ln-rmsnorm, tb-vec-add, tb-attn-seq, its causal form,
;       GQA over two key/value heads, a KV-cached decode step) answer the shapes their buffers have
;   16  the judge can fail: each recipe agrees with itself, not with one element moved past epsilon, and not
;       with an empty answer
;   32  the reader holds: a carrier-shaped answer carrying gelu's floats reads back to them and names its device
;   64  the absence is never read as an answer: none of the plan's nine reads finds a float in it
(do
    (defn vlb-bit (ok w) (if (eq ok 1) w 0))
    (defn vlb-map-gelu (xs) (if (eq (len xs) 0) (empty) (cons (tn-gelu (head xs)) (vlb-map-gelu (tail xs)))))
    (defn vlb-softmax-rows (rs) (if (eq (len rs) 0) (empty) (vkd-cat (tn-softmax (head rs)) (vlb-softmax-rows (tail rs)))))
    (defn vlb-rms-rows (rs g eps) (if (eq (len rs) 0) (empty) (vkd-cat (ln-rmsnorm (head rs) g eps) (vlb-rms-rows (tail rs) g eps))))
    (defn vlb-kv-upto (kv j t hk) (if (gt j t) (empty) (cons (nth (nth kv j) hk) (vlb-kv-upto kv (add j 1) t hk))))
    (defn vlb-gqa (gq gk gv gid n nh group scale)
        (if (ge gid n) (empty)
            (vkd-cat (tb-attend-one (nth (nth gq (div gid nh)) (mod gid nh))
                                    (vlb-kv-upto gk 0 (div gid nh) (div (mod gid nh) group))
                                    (vlb-kv-upto gv 0 (div gid nh) (div (mod gid nh) group)) scale)
                     (vlb-gqa gq gk gv (add gid 1) n nh group scale))))
    (defn vlb-flat2 (xss) (if (eq (len xss) 0) (empty) (vkd-cat (vkd-flat (head xss)) (vlb-flat2 (tail xss)))))

    ; --- the numbers: small, dyadic, nothing symmetric ---
    (let GX (list -1.5 -0.5 0.0 0.25 1.0 2.0))
    (let SM (list (list 0.5 -1.0 2.0) (list 1.0 1.0 -0.5)))
    (let LX (list (list 1.0 2.0 3.0 5.0) (list -1.0 0.5 0.25 2.0)))
    (let LG (list 1.0 0.5 -1.0 2.0))
    (let LB (list 0.0 0.25 -0.5 1.0))
    (let RG (list 0.5 1.0 1.5 -1.0))
    (let EPS 0.00001)
    (let RA (list 1.0 -2.0 0.5))
    (let RB (list 0.25 0.75 -1.5))
    (let QS (list (list 1.0 0.5) (list -0.5 1.0) (list 0.25 -0.75)))
    (let KS (list (list 0.5 -1.0) (list 1.0 0.25) (list -0.75 0.5)))
    (let VS (list (list 1.0 2.0) (list -1.0 0.5) (list 0.25 -0.5)))
    (let SCALE 0.7071067811865476)
    (let GQ (list (list (list 1.0 0.5) (list -0.5 1.0) (list 0.25 -0.75) (list 0.75 0.25))
                  (list (list -1.0 0.25) (list 0.5 0.5) (list 1.5 -0.25) (list -0.25 -1.0))))
    (let GK (list (list (list 0.5 -1.0) (list 1.0 0.25)) (list (list -0.75 0.5) (list 0.25 1.25))))
    (let GV (list (list (list 1.0 2.0) (list -1.0 0.5)) (list (list 0.25 -0.5) (list 2.0 -1.5))))
    (let DQ (list 0.75 -0.25))

    ; --- the recipes' own answers ---
    (let e-gelu (vlb-map-gelu GX))
    (let e-sm (vlb-softmax-rows SM))
    (let e-ln (vkd-flat (tb-ln-seq LX EPS LG LB)))
    (let e-rms (vlb-rms-rows LX RG EPS))
    (let e-res (tb-vec-add RA RB))
    (let e-att (vkd-flat (tb-attn-seq QS KS VS SCALE)))
    (let e-caus (vkd-flat (tb-attn-seq-causal QS KS VS SCALE)))
    (let e-gqa (vlb-gqa GQ GK GV 0 8 4 2 SCALE))
    (let e-dec (tb-attend-one DQ KS VS SCALE))

    ; --- mint ---
    (let srcs (list (fgl-gelu) (fgl-softmax) (fgl-layernorm) (fgl-rmsnorm) (fgl-residual) (fgl-attention)))
    (let mints (list (vkd-mint "fgl-gelu" (fgl-gelu)) (vkd-mint "fgl-softmax" (fgl-softmax))
                     (vkd-mint "fgl-layernorm" (fgl-layernorm)) (vkd-mint "fgl-rmsnorm" (fgl-rmsnorm))
                     (vkd-mint "fgl-residual" (fgl-residual)) (vkd-mint "fgl-attention" (fgl-attention))))

    ; --- one plan: kernels 0..5, buffers 0..27, nine dispatches ---
    (let sa (vkd-f SCALE))
    (let ea (vkd-f EPS))
    (let plan (vkd-plan (list
        (vkd-spv "fgl-gelu") (vkd-spv "fgl-softmax") (vkd-spv "fgl-layernorm")
        (vkd-spv "fgl-rmsnorm") (vkd-spv "fgl-residual") (vkd-spv "fgl-attention")
        (vkd-buf GX) (vkd-zero 6)                                                   ;  0  1
        (vkd-buf (vkd-flat SM)) (vkd-zero 6)                                        ;  2  3
        (vkd-buf (vkd-flat LX)) (vkd-buf LG) (vkd-buf LB) (vkd-zero 8)              ;  4  5  6  7
        (vkd-buf RG) (vkd-zero 8)                                                   ;  8  9
        (vkd-buf RA) (vkd-buf RB) (vkd-zero 3)                                      ; 10 11 12
        (vkd-buf (vkd-flat QS)) (vkd-buf (vkd-flat KS)) (vkd-buf (vkd-flat VS))     ; 13 14 15
        (vkd-zero 6) (vkd-zero 9) (vkd-zero 6) (vkd-zero 9)                         ; 16 17 18 19
        (vkd-buf (vlb-flat2 GQ)) (vkd-buf (vlb-flat2 GK)) (vkd-buf (vlb-flat2 GV))  ; 20 21 22
        (vkd-zero 16) (vkd-zero 16)                                                 ; 23 24
        (vkd-buf DQ) (vkd-zero 2) (vkd-zero 3)                                      ; 25 26 27
        (vkd-run 0 (list 0 1) (list 6) 1)
        (vkd-run 1 (list 2 3) (list 2 3) 1)
        (vkd-run 2 (list 4 5 6 7) (list 2 4 ea) 1)
        (vkd-run 3 (list 4 8 9) (list 2 4 ea) 1)
        (vkd-run 4 (list 10 11 12) (list 3) 1)
        (vkd-run 5 (list 13 14 15 16 17) (list 3 3 2 1 1 sa 0) 1)
        (vkd-run 5 (list 13 14 15 18 19) (list 3 3 2 1 1 sa 1) 1)
        (vkd-run 5 (list 20 21 22 23 24) (list 2 2 2 4 2 sa 1) 1)
        (vkd-run 5 (list 25 14 15 26 27) (list 1 3 2 1 1 sa 1) 1)
        (vkd-read 1) (vkd-read 3) (vkd-read 7) (vkd-read 9) (vkd-read 12)
        (vkd-read 16) (vkd-read 18) (vkd-read 23) (vkd-read 26))))
    ; the door has no runner: its answer to the plan is the absence, by name
    (let out (vkd-exec "layers" plan))
    (let none (list))

    (defn vlb-all-absent (xs) (if (eq (len xs) 0) 1 (if (eq (vkd-absent? (head xs)) 1) (vlb-all-absent (tail xs)) 0)))
    (defn vlb-all-sources (xs) (if (eq (len xs) 0) 1 (if (eq (vkd-source-ok? (head xs)) 1) (vlb-all-sources (tail xs)) 0)))
    (defn vlb-bump (xs) (cons (add (head xs) 0.001) (tail xs)))
    (defn vlb-self (xs) (if (and (eq (vkd-agree? xs xs (vkd-eps)) 1) (and (eq (vkd-agree? xs (vlb-bump xs) (vkd-eps)) 0) (eq (vkd-agree? none xs (vkd-eps)) 0))) 1 0))
    (defn vlb-sized (xs n) (if (eq (len xs) n) 1 0))
    (defn vlb-needle (a b) (str_concat a b))
    (let door-text (read_file "form/form-stdlib/vk-door.bml"))
    (let door-clean (if (and (lt (str_find door-text (vlb-needle "host-" "exec(") 0) 0)
                             (and (lt (str_find door-text (vlb-needle "host_" "spawn") 0) 0)
                                  (lt (str_find door-text (vlb-needle "host_" "capture") 0) 0))) 1 0))

    ; 1  the door starts nothing and says so by name
    (let c0 (if (and (eq (vkd-ready?) 0) (and (eq (vlb-all-absent mints) 1) (and (eq (vkd-absent? out) 1) (and (str_eq (vkd-device out) "") (eq door-clean 1))))) 1 0))
    ; 2  the six shaders the recipes emit are shaders, and a non-shader is refused
    (let c1 (vlb-bit (if (and (eq (vlb-all-sources srcs) 1) (and (eq (vkd-source-ok? "x") 0) (eq (vkd-absent? (vkd-mint "x" "x")) 0))) 1 0) 2))
    ; 4  the plan is the carrier protocol: six spv lines, 28 buffers (buf and zero), nine runs, nine reads
    (let c2 (vlb-bit (if (and (eq (vkd-lines-of plan "spv") 6) (and (eq (add (vkd-lines-of plan "buf") (vkd-lines-of plan "zero")) 28) (and (eq (vkd-lines-of plan "run") 9) (eq (vkd-lines-of plan "read") 9)))) 1 0) 4))
    ; 8  the nine recipes the plan's reads would be judged by have the shapes their buffers have
    (let c3 (vlb-bit (if (and (eq (vlb-sized e-gelu 6) 1) (and (eq (vlb-sized e-sm 6) 1) (and (eq (vlb-sized e-ln 8) 1) (and (eq (vlb-sized e-rms 8) 1) (and (eq (vlb-sized e-res 3) 1) (and (eq (vlb-sized e-att 6) 1) (and (eq (vlb-sized e-caus 6) 1) (and (eq (vlb-sized e-gqa 16) 1) (eq (vlb-sized e-dec 2) 1))))))))) 1 0) 8))
    ; 16 the judge can fail: each recipe agrees with itself, not with one element moved past epsilon, and not with an empty answer
    (let c4 (vlb-bit (if (and (eq (vlb-self e-gelu) 1) (and (eq (vlb-self e-sm) 1) (and (eq (vlb-self e-ln) 1) (and (eq (vlb-self e-rms) 1) (and (eq (vlb-self e-res) 1) (and (eq (vlb-self e-att) 1) (and (eq (vlb-self e-caus) 1) (and (eq (vlb-self e-gqa) 1) (eq (vlb-self e-dec) 1))))))))) 1 0) 16))
    ; 32 the reader holds: a carrier-shaped answer carrying gelu's floats reads back to them, and names its device
    (let sample (vkd-sample-answer e-gelu))
    (let c5 (vlb-bit (if (and (eq (vkd-agree? (vkd-read-floats sample 7) e-gelu (vkd-eps)) 1) (str_eq (vkd-device sample) "sample")) 1 0) 32))
    ; 64 the absence is never read as an answer: no read of the plan's nine finds a float in it, so no recipe agrees with it
    (let c6 (vlb-bit (if (and (eq (len (vkd-read-floats out 1)) 0) (and (eq (len (vkd-read-floats out 3)) 0) (and (eq (len (vkd-read-floats out 7)) 0) (and (eq (len (vkd-read-floats out 9)) 0) (and (eq (len (vkd-read-floats out 12)) 0) (and (eq (len (vkd-read-floats out 16)) 0) (and (eq (len (vkd-read-floats out 18)) 0) (and (eq (len (vkd-read-floats out 23)) 0) (and (eq (len (vkd-read-floats out 26)) 0) (eq (vkd-agree? (vkd-read-floats out 1) e-gelu (vkd-eps)) 0)))))))))) 1 0) 64))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6)))))))
