; form-glass-event-loop-band.fk — deadline, wake and double-buffer proof.
;
; Verdict 16777215:
;   1     initial deadline is monotonic origin plus budget
;   2     early telemetry stages without presenting
;   4     deadline presents the staged back frame
;   8     control presents immediately
;   16    deadline advance is anchored, not completion-relative
;   32    one arithmetic step skips all missed slots
;   64    skipped-slot count is retained
;   128   front/back frames swap without overwriting the old front
;   256   no pending buffer does not fabricate a commit
;   512   malformed wake is refused
;   1024  wake vocabulary is closed
;   2048  event sources name telemetry, control and deadline
;   4096  missing monotonic clock door is explicit
;   8192  missing bounded event wait door is explicit
;   16384 authority refuses to claim idle replacement
;   32768 JIT refusal outranks simultaneous control/deadline/telemetry
;   65536 refusal exact evidence survives the hold
;   131072 refusal presents its fault frame immediately without advancing deadline
;   262144 controls and arbitrary healing identities cannot resume the hold
;   524288 newer cause-bound healing resumes the held front frame
;   1048576 live Glass loads the executable event-loop state
;   2097152 live rendering stages and commits the front/back buffer
;   4194304 refusal after four ordinary wakes is still selected
;   8388608 stale same-identity healing is refused
;
; preludes: form-stdlib/form-glass-event-loop.bml

(do
    (defn fgelb-bit (held weight) (if (eq held 1) weight 0))
    (let schedule (fgel-schedule-start 1000 250))
    (let empty (fgel-buffer-empty))
    (let early (fgel-wake "telemetry" 1100 "models.owner" "snapshot-42"))
    (let stagedPlan (fgel-plan-wake schedule empty early (list "frame" 1)))
    (let staged (fgel-plan-buffer stagedPlan))
    (let deadline (fgel-wake "deadline" 1250 "kernel.monotonic" "deadline-1250"))
    (let presentedPlan (fgel-plan-wake schedule staged deadline (list "frame" 2)))
    (let presented (fgel-plan-buffer presentedPlan))
    (let controlled (fgel-plan-wake schedule empty (fgel-wake "control" 1100 "glass-monitor" "offer-7") (list "control-frame")))
    (let refusal (fgel-wake "jit-refusal" 1120 "jit.bml-demand" "fault.1120.install-challenge-disagreed.p100"))
    (let held (fgel-plan-wakes schedule empty (list early deadline (fgel-wake "control" 1110 "glass-monitor" "offer-8") refusal) (list "held-frame")))
    (let denied (fgel-resume-held held (fgel-wake "control" 1130 "glass-monitor" "offer-9")))
    (let wrong (fgel-resume-held held (fgel-wake "jit-healed" 1135 "jit.bml-demand" "fault.999.other.p100")))
    (let resumed (fgel-resume-held held (fgel-wake "jit-healed" 1140 "jit.bml-demand" "fault.1120.install-challenge-disagreed.p100")))
    (let staleHeal (fgel-resume-held held (fgel-wake "jit-healed" 1120 "jit.bml-demand" "fault.1120.install-challenge-disagreed.p100")))
    (let overflow (fgel-plan-wakes schedule empty (list early deadline refusal early deadline) (list "overflow")))
    (let late (fgel-schedule-advance schedule 1900))
    (let gap (fgel-carrier-gap))
    (let authority (read_file "form/form-stdlib/bml/form-glass-event-loop.bml"))
    (let live (read_file "form/form-stdlib/form-glass-live.bml"))
    (sum (list
        (fgelb-bit (and (eq (fgel-schedule-deadline schedule) 1250)
                        (eq (fgel-schedule-budget schedule) 250)) 1)
        (fgelb-bit (and (str_eq (fgel-plan-disposition stagedPlan) "staged")
                        (eq (fgel-buffer-pending? staged) 1)) 2)
        (fgelb-bit (and (str_eq (fgel-plan-disposition presentedPlan) "present")
                        (eq (fgel-buffer-pending? presented) 0)) 4)
        (fgelb-bit (str_eq (fgel-plan-disposition controlled) "present") 8)
        (fgelb-bit (eq (fgel-schedule-deadline (fgel-plan-schedule presentedPlan)) 1500) 16)
        (fgelb-bit (eq (fgel-schedule-deadline late) 2000) 32)
        (fgelb-bit (eq (fgel-schedule-skipped late) 2) 64)
        (fgelb-bit (and (str_eq (head (fgel-buffer-front presented)) "frame")
                        (and (eq (nth (fgel-buffer-front presented) 1) 2)
                             (eq (len (fgel-buffer-back presented)) 0))) 128)
        (fgelb-bit (eq (fgel-buffer-pending? (fgel-buffer-commit empty)) 0) 256)
        (fgelb-bit (str_eq (fgel-plan-disposition (fgel-plan-wake schedule empty (list "bad") (list "frame"))) "refused-wake") 512)
        (fgelb-bit (and (eq (fgel-wake-kind? "jit-refusal") 1)
                        (and (eq (fgel-wake-kind? "telemetry") 1)
                        (and (eq (fgel-wake-kind? "control") 1)
                             (and (eq (fgel-wake-kind? "deadline") 1)
                                  (eq (fgel-wake-kind? "timer-ish") 0))))) 1024)
        (fgelb-bit (eq (len (fgel-event-sources)) 5) 2048)
        (fgelb-bit (ge (str_find (nth gap 3) "kernel.monotonic-ms" 0) 0) 4096)
        (fgelb-bit (ge (str_find (nth gap 5) "kernel.monotonic-wait-until-path-change" 0) 0) 8192)
        (fgelb-bit (ge (str_find authority "idle-polling-remains-unreplaced" 0) 0) 16384)
        (fgelb-bit (str_eq (fgel-wake-kind (fgel-plan-cause held)) "jit-refusal") 32768)
        (fgelb-bit (str_eq (fgel-wake-evidence (fgel-plan-cause held)) "fault.1120.install-challenge-disagreed.p100") 65536)
        (fgelb-bit (and (str_eq (fgel-plan-disposition held) "heal-hold")
                        (and (eq (fgel-schedule-deadline (fgel-plan-schedule held)) 1250)
                             (and (eq (fgel-buffer-pending? (fgel-plan-buffer held)) 0)
                                  (str_eq (head (fgel-buffer-front (fgel-plan-buffer held))) "held-frame")))) 131072)
        (fgelb-bit (and (str_eq (fgel-plan-disposition denied) "refused-resume-kind")
                        (str_eq (fgel-plan-disposition wrong) "refused-resume-fault-identity")) 262144)
        (fgelb-bit (and (str_eq (fgel-plan-disposition resumed) "present")
                        (and (eq (fgel-buffer-pending? (fgel-plan-buffer resumed)) 0)
                             (str_eq (head (fgel-buffer-front (fgel-plan-buffer resumed))) "held-frame"))) 524288)
        (fgelb-bit (ge (str_find live "form/form-stdlib/form-glass-event-loop.bml" 0) 0) 1048576)
        (fgelb-bit (and (ge (str_find live "def fgl-render-buffer" 0) 0)
                        (and (ge (str_find live "fgel-buffer-stage" 0) 0)
                             (ge (str_find live "fgel-buffer-commit" 0) 0))) 2097152)
        (fgelb-bit (str_eq (fgel-wake-kind (fgel-plan-cause overflow)) "jit-refusal") 4194304)
        (fgelb-bit (str_eq (fgel-plan-disposition staleHeal) "refused-resume-fault-identity") 8388608))))
