; form-cli-current-answer-thought-registry-band.fk -- actual image NodeIDs,
; image-owned ABI, and symbol bindings that can grow after reducer compilation.
; Expected 262143.
;
; The fresh symbol and literal program are assembled here.  Neither occurs in
; the reducer source.  The image arrives as recursively interned content and
; executes without a new evaluator function or a symbol branch.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-cli-current-answer-thought-walk.fk

(do
    (defn fcatwrb-bit (held weight) (if held weight 0))
    (defn fcatwrb-values ()
        (do
            (let source (intern_trivial_string "sha256:current-source"))
            (list source source "answer" "answer" "hit" "hit"
                "concept-registry-current-source-hit"
                "concept-registry-current-source-hit"
                1 1 1 1 1 1 "choice,cut,release"
                "choice,cut,release")))
    (defn fcatwrb-kinds () (fcatw-current-kinds))
    (defn fcatwrb-fresh-symbol ()
        (str_concat "fresh/" "after-reducer"))
    (defn fcatwrb-literal-image (value)
        (fcatw-image (empty) (list (fcatw-row 1 value 0 0)) (empty) 0))
    (defn fcatwrb-short-row ()
        (intern_node (fcatw-row-category)
            (list (intern_trivial_int 1))))
    (defn fcatwrb-malformed-image (row)
        (fcatw-image (empty) (list row) (empty) 0))

    (defn form-cli-current-answer-thought-registry-band ()
        (do
            (let current-image (fcatw-current-image))
            (let current-registry (fcatw-current-registry))
            (let current-resolution (fcatw-resolve current-registry
                (fcatw-symbol)))
            (let current-result (fcatw-run-by-symbol current-registry
                (fcatw-symbol) (fcatwrb-values) (fcatwrb-kinds) 93))

            ; New body and new symbol are born after the reducer source.
            (let fresh-symbol (fcatwrb-fresh-symbol))
            (let image7 (fcatwrb-literal-image (add 314000 159)))
            (let image8 (fcatwrb-literal-image (add 314000 160)))
            (let bind7 (fcatw-binding fresh-symbol image7))
            (let registry0 (fcatw-registry (empty)))
            (let registry1 (fcatw-registry-admit registry0 bind7))
            (let registry1-replay (fcatw-registry-admit registry1 bind7))
            (let fresh-resolution (fcatw-resolve registry1 fresh-symbol))
            (let fresh-result (fcatw-run-by-symbol registry1 fresh-symbol
                (empty) (empty) 1))

            ; A second body under the same symbol is visible choice, never
            ; insertion-order dispatch.  A second symbol may alias image7.
            (let bind8 (fcatw-binding fresh-symbol image8))
            (let conflicted (fcatw-registry-admit registry1 bind8))
            (let conflict-resolution (fcatw-resolve conflicted fresh-symbol))
            (let cut (fcatw-cut conflicted fresh-symbol image8))
            (let cut-registry (fcatw-movement-registry cut))
            (let cut-resolution (fcatw-resolve cut-registry fresh-symbol))
            (let cut-result (fcatw-run-by-symbol cut-registry fresh-symbol
                (empty) (empty) 1))
            (let cut-timeout (fcatw-run-by-symbol cut-registry fresh-symbol
                (empty) (empty) 0))
            (let undone (fcatw-undo cut))
            (let alias-binding (fcatw-binding "fresh/alias" image7))
            (let aliased-registry (fcatw-registry-admit registry1 alias-binding))
            (let alias-resolution (fcatw-resolve aliased-registry "fresh/alias"))

            (let absent (fcatw-resolve registry1 "fresh/absent"))
            (let short-image (fcatwrb-malformed-image (fcatwrb-short-row)))
            (let unknown-image (fcatwrb-malformed-image
                (fcatw-row 999 0 0 0)))
            (let dangling-image (fcatwrb-malformed-image
                (fcatw-row 42 1 2 0)))
            (let malformed-binding
                (intern_node (fcatw-binding-category)
                    (list (intern_trivial_string "") image7)))
            (let malformed-admission (fcatw-admit registry1 malformed-binding))
            (let reducer-source (read_file
                "form/form-stdlib/form-cli-current-answer-thought-walk.fk"))

            (sum (list
                ; canonical image is actual interned content and executes
                (fcatwrb-bit (eq (fcatw-image-valid? current-image) 1) 1)
                (fcatwrb-bit (and
                    (str_eq (fcatw-resolution-status current-resolution) "ready")
                    (node_eq (fcatw-resolution-image current-resolution)
                             current-image)) 2)
                (fcatwrb-bit (and (str_eq (fcatw-status current-result) "returned")
                                   (eq (fcatw-value current-result) 1)) 4)

                ; unseen content and ABI=0 arrive entirely as data
                (fcatwrb-bit (and (eq (fcatw-image-valid? image7) 1)
                    (and (not (node_eq image7 image8))
                    (and (lt (str_find reducer-source
                                      "fresh/after-reducer" 0) 0)
                         (lt (str_find reducer-source "314159" 0) 0)))) 8)
                (fcatwrb-bit (and
                    (str_eq (fcatw-resolution-status fresh-resolution) "ready")
                    (node_eq (fcatw-resolution-image fresh-resolution) image7)) 16)
                (fcatwrb-bit (and (str_eq (fcatw-status fresh-result) "returned")
                                   (and (eq (fcatw-value fresh-result) 314159)
                                        (eq (fcatw-steps fresh-result) 1))) 32)
                (fcatwrb-bit (and (eq (len (fcatw-image-kinds image7)) 0)
                    (nothing? (fcatw-run-image image7 (list 1)
                        (list (fcatw-kind-int)) 1))) 64)

                ; replay, ambiguity, alias, and absence stay different
                (fcatwrb-bit (and (node_eq registry1 registry1-replay)
                    (eq (len (fcatw-registry-bindings registry1-replay)) 1)) 128)
                (fcatwrb-bit (and
                    (str_eq (fcatw-resolution-status conflict-resolution) "choice")
                    (and (str_eq (fcatw-resolution-reason conflict-resolution)
                                 "ambiguous-symbol")
                         (eq (fcatw-resolution-choices conflict-resolution) 2))) 256)
                (fcatwrb-bit (and
                    (eq (fcatw-resolution-dispatch conflict-resolution) 0)
                    (nothing? (fcatw-run-by-symbol conflicted fresh-symbol
                        (empty) (empty) 1))) 512)
                (fcatwrb-bit (and
                    (str_eq (fcatw-resolution-status alias-resolution) "ready")
                    (node_eq (fcatw-resolution-image alias-resolution) image7)) 1024)
                (fcatwrb-bit (and
                    (str_eq (fcatw-resolution-status absent) "nothing")
                    (and (str_eq (fcatw-resolution-reason absent)
                                 "symbol-not-found")
                         (eq (fcatw-resolution-dispatch absent) 0))) 2048)

                ; malformed content never reaches execution
                (fcatwrb-bit (and (eq (fcatw-image-valid? short-image) 0)
                    (nothing? (fcatw-run-image short-image (empty) (empty) 4))) 4096)
                (fcatwrb-bit (and (eq (fcatw-image-valid? unknown-image) 0)
                    (nothing? (fcatw-run-image unknown-image (empty) (empty) 4))) 8192)
                (fcatwrb-bit (and (eq (fcatw-image-valid? dangling-image) 0)
                    (nothing? (fcatw-run-image dangling-image (empty) (empty) 4))) 16384)

                ; cut is explicit, timeout is non-mutating, undo restores choice
                (fcatwrb-bit (and
                    (str_eq (fcatw-movement-reason cut) "choice-cut")
                    (and (str_eq (fcatw-resolution-status cut-resolution) "ready")
                    (and (node_eq (fcatw-resolution-image cut-resolution) image8)
                         (eq (fcatw-value cut-result) 314160)))) 32768)
                (fcatwrb-bit (and (str_eq (fcatw-status cut-timeout) "timeout")
                    (and (node_eq (fcatw-movement-registry cut) cut-registry)
                         (eq (fcatw-output-count cut-timeout) 0))) 65536)
                (fcatwrb-bit (and (node_eq undone conflicted)
                    (and (str_eq (fcatw-resolution-status
                            (fcatw-resolve undone fresh-symbol)) "choice")
                    (and (str_eq (fcatw-movement-reason malformed-admission)
                                 "binding-malformed")
                         (eq (fcatw-movement-changed malformed-admission) 0)))) 131072)))))

    (form-cli-current-answer-thought-registry-band))
