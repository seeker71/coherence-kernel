; form-cli-code-lesson-review-band.bml — lessons keyed by exact contract and by family, a local lesson-review
; voice after every rung under code audits, and every rung packet as a verified or failed corpus row.
;
; Verdict 8191
;
; Claims (each a live step; voices are scripted functions, no model opens):
;    1  a lesson learned under contract A is recalled for contract B of the same family (same writable path,
;       same check kinds, another goal) as brief guidance: hits 1, stage implement, B's own documents
;    2  a contract of another family (another writable path) recalls nothing
;    4  the recalled guidance is frozen for the attempt: a resumed checkpoint keeps the brief it was admitted
;       with after the family lesson was patched, while a fresh attempt reads the patch
;    8  a lesson claiming a tool does not work is refused (environment-claim)
;   16  a rule carrying a document digest is refused (lesson-not-general)
;   32  a generalizable rule with one clause of why, from a verified rung, is written
;   64  read before write: a second lesson that does not name the family lesson's digest is refused, and one
;       that names it patches the first (one lesson, patches 1, prior_digest the first)
;  128  a rung that did not verify cannot teach a method; it may teach kind=avoid
;  256  a failed rung becomes a contrast row (contextual-observed-outcome), never a supervised answer
;  512  a verified rung (band full, circle accept) becomes a supervised row whose completion is its documents
; 1024  a family lesson with no recall or write for thirty days moves to cold/; a live one stays
; 2048  a voice that stops leaves the family lesson as it was and reads refused:voice-stopped; a rung whose
;       lane left no continuity packet reads refused:packet-absent after the rung
; 4096  contract A itself still recalls its exact lesson as a verified candidate (complete, hits 1), with
;       no family guidance in its brief
; Fixtures are written through the carrier (FORMBIN2 family records, rows/<id>/record.json) and read back.
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/form-cli-code-lesson-review.bml
section [form.bml] {
 class LessonReviewBand {
  def lrb-root(ctx) = ctx[0];
  def lrb-home(ctx) = ctx[1];
  def lrb-path() = "form/form-stdlib/closure-lines.fk";
  def lrb-original() = "; closure-lines.fk\n\n(do\n    0)\n";
  def lrb-candidate() = "; closure-lines.fk\n\n(do\n    (defn cl-unit-at (text line) (nothing))\n    0)\n";
  def lrb-docs(path, text) = [[path, path, text]];
  def lrb-checks(path) = "[{\"tool\":\"rg\",\"arguments\":[\"-c\",\"-F\",\"(defn cl-unit-at\",\"" ++ path ++ "\"],\"stdout\":\"" ++ path ++ ":1\\n\"},{\"tool\":\"balance\",\"arguments\":[\"" ++ path ++ "\"],\"stdout\":\"0 0\\n\"}]";
  def lrb-goal-a() = "Add (defn cl-unit-at (text line) ...) inside the (do ...) before the final 0.";
  def lrb-goal-b() = "Add (defn cl-unit-at (text line) ...) inside the (do ...) before the final 0, answering (nothing) past the end.";
  def lrb-pass(contract, docs) = [1, "scripted checker"];
  def lrb-change() = "anchor the edit on the unique final 0 line";
  // contract A, worked to completion with one repair, as the lane would leave it
  def lrb-complete-a(ctx) {
   let path = lrb-path();
   let docs = lrb-docs(path, lrb-original());
   let open = fcam-with(fcap-open-direct-code(lrb-goal-a(), docs, [path]), [lrb-root(ctx), "a0a0-1", fcam-scope(lrb-goal-a(), docs, [path], lrb-checks(path)), 0]);
   let done = fcap-inherit(open, fcap-state("complete", open[1], open[2], lrb-docs(path, lrb-candidate()), open[4], [], "", "", "Native verification passed.", 3, 2, 1));
   fcap-with-memory(done, [1, "Failed caller assertion: the edit missed its anchor", [[1, "edit-not-found", "the anchor line had four spaces, not five", lrb-change(), "implement"]], 2, 0]);
  }
  def lrb-prepare(ctx, goal, path, resume) = fcam-prepare(lrb-root(ctx), fcap-open-direct-code(goal, lrb-docs(path, lrb-original()), [path]), lrb-checks(path), resume, [lrb-pass, 0]);
  def lrb-family(ctx) = fcam-family-key(lrb-complete-a(ctx));
  def lrb-packet(ctx) = fcam-packet(lrb-complete-a(ctx), "checkpoint");
  def lrb-rung(ctx, id, reading, accepted) = fclr-rung(id, lrb-packet(ctx), reading, 31, accepted, "the band read " ++ (nothing?(reading) ? "nothing" : reading.str()) ++ " of 31");
  def lrb-lesson(rule, why, kind, read) = json-emit(json-node-object([json-node-pair("lesson", json-node-object([json-node-pair("rule", json-node-string(rule)), json-node-pair("why", json-node-string(why)), json-node-pair("kind", json-node-string(kind)), json-node-pair("read", json-node-string(read))]))]));
  def lrb-voice(reply) = fclr-voice("scripted", "script", prompt => [reply, 9]);
  // a voice that reads the family lesson it is shown and names its digest
  def lrb-shown(prompt) = fat-wire-object?(json-object-get(parse-json("shown", prompt), "family_lesson")) ? fcap-string(json-object-get(parse-json("shown", prompt), "family_lesson"), "digest") : "";
  def lrb-reader(rule, why, kind) = fclr-voice("reader", "script", prompt => [lrb-lesson(rule, why, kind, lrb-shown(prompt)), 11]);
  def lrb-stopper() = fclr-voice("stopper", "script", prompt => form_error("scripted voice stop"));
  def lrb-lesson-of(ctx) = fcam-family-lesson(fcam-family-read(lrb-root(ctx), lrb-family(ctx)));
  def lrb-rule-one() = "Anchor an insertion on the unique final 0 line of the (do ...) block";
  def lrb-rule-two() = "Anchor each insertion on one unique line and keep every other byte";
  def lrb-why() = "a unique anchor lands without rewriting the file";
  def lrb-row(home, ex) = parse-json("row", read_file(nsc-rung-row(home, ex) ++ "/record.json"));
  def lrb-example(row) = json-object-get(row, "example");

  // 1
  def lrb-family-recall(ctx) {
   let learned = fcam-learn(lrb-complete-a(ctx));
   let b = lrb-prepare(ctx, lrb-goal-b(), lrb-path(), "");
   learned && ((fcam-hits(b) == 1) && (((String) fcap-stage(b) == "implement") && (((Value) fcap-docs(b) == lrb-docs(lrb-path(), lrb-original())) && ((str_find(b[6], "Recalled from this contract's family", 0) == 0) && (str_find(b[6], lrb-change(), 0) > 0)))));
  }
  // 2
  def lrb-other-family(ctx) {
   let c = lrb-prepare(ctx, lrb-goal-b(), "form/form-stdlib/sort.fk", "");
   (fcam-hits(c) == 0) && ((String) c[6] == "");
  }
  // 4
  def lrb-frozen(ctx) {
   let b = lrb-prepare(ctx, lrb-goal-b(), lrb-path(), "");
   let saved = fcam-save(b);
   let patched = fclr-review(lrb-root(ctx), lrb-rung(ctx, "rung-frozen", 31, 1), lrb-reader(lrb-rule-one(), lrb-why(), "method"));
   let resumed = lrb-prepare(ctx, lrb-goal-b(), lrb-path(), fcam-id(b));
   let fresh = lrb-prepare(ctx, lrb-goal-b(), lrb-path(), "");
   saved && ((fat-has(["written", "patched"], fclr-status(patched))) && (((String) resumed[6] == b[6]) && ((str_find(b[6], "Technique:", 0) < 0) && (str_find(fresh[6], "Technique: " ++ lrb-rule-one(), 0) > 0))));
  }
  // 8
  def lrb-environment(ctx) = fclr-status(fclr-review(lrb-root(ctx), lrb-rung(ctx, "rung-env", 31, 1), lrb-voice(lrb-lesson("The native rg tool does not work on a single file", "its count carried a path", "avoid", lrb-digest-of(ctx))))) == "refused:environment-claim";
  def lrb-digest-of(ctx) = nothing?(lrb-lesson-of(ctx)) ? "" : fcap-string(lrb-lesson-of(ctx), "digest");
  // 16
  def lrb-not-general(ctx) = fclr-status(fclr-review(lrb-root(ctx), lrb-rung(ctx, "rung-hash", 31, 1), lrb-voice(lrb-lesson("Keep closure-lines.fk at sha e5cbb7b3a9c1d2f40011aa22bb33cc44dd55ee66ff778899aabbccddeeff0011", lrb-why(), "method", lrb-digest-of(ctx))))) == "refused:lesson-not-general";
  // 32: on a fresh family root, so the first lesson is written, not patched
  def lrb-written(ctx) {
   let root = lrb-root(ctx) ++ "/fresh";
   let made = fs-mkdir(root);
   let r = fclr-review(root, lrb-rung(ctx, "rung-first", 31, 1), lrb-voice(lrb-lesson(lrb-rule-one(), lrb-why(), "method", "")));
   ((String) fclr-status(r) == "written") && ((String) fcap-string(fcam-family-lesson(fcam-family-read(root, fclr-family(r))), "rule") == lrb-rule-one());
  }
  // 64
  def lrb-patch(ctx) {
   let first = lrb-digest-of(ctx);
   let unread = fclr-review(lrb-root(ctx), lrb-rung(ctx, "rung-unread", 31, 1), lrb-voice(lrb-lesson(lrb-rule-two(), lrb-why(), "method", "")));
   let read = fclr-review(lrb-root(ctx), lrb-rung(ctx, "rung-read", 31, 1), lrb-reader(lrb-rule-two(), lrb-why(), "method"));
   let lesson = lrb-lesson-of(ctx);
   ((String) fclr-status(unread) == "refused:unread-prior-lesson") && (((String) fclr-status(read) == "patched") && (((String) fcap-string(lesson, "rule") == lrb-rule-two()) && (((String) fcap-string(lesson, "prior_digest") == first) && (fcam-family-int(lesson, "patches") >= 1))));
  }
  // 128
  def lrb-failure-method(ctx) {
   let method = fclr-review(lrb-root(ctx), lrb-rung(ctx, "rung-fail-m", 28, 0), lrb-reader("Return nothing for every line", "the nothing claims then hold", "method"));
   let avoid = fclr-review(lrb-root(ctx), lrb-rung(ctx, "rung-fail-a", 28, 0), lrb-reader("Avoid a stub that answers nothing for every line", "it holds the nothing claims and misses the unit claims", "avoid"));
   ((String) fclr-status(method) == "refused:unresolved-failure-as-method") && (((String) fclr-status(avoid) == "patched") && ((String) fcap-string(lrb-lesson-of(ctx), "source_outcome") == "failed"));
  }
  // 256
  def lrb-contrast(ctx) {
   let row = lrb-row(lrb-home(ctx), nsc-rung-example("rung-failed-row", lrb-packet(ctx), 28, 31, 0, "the band read 28 of 31"));
   ((String) fcap-string(row, "objective") == "contextual-observed-outcome") && (((String) fcap-string(row, "outcome") == "rung-failed") && (str_find(fcap-string(lrb-example(row), "prompt"), nsm-outcome-prefix(), 0) == 0));
  }
  // 512
  def lrb-supervised(ctx) {
   let ex = nsc-rung-example("rung-verified-row", lrb-packet(ctx), 31, 31, 1, "");
   let row = lrb-row(lrb-home(ctx), ex);
   ((String) fcap-string(row, "objective") == "supervised-answer") && (((String) fcap-string(lrb-example(row), "completion") == ex[4]) && (str_find(fcap-string(row, "evidence"), "local_verified=1", 0) == 0));
  }
  // 1024
  def lrb-cold(ctx) {
   let root = lrb-root(ctx) ++ "/sweep";
   let made = fs-mkdir(root);
   let old = fcam-family-put(root, "cold0", fcam-family-with(fcam-family-base("cold0"), "written_ms", json-node-int(now_unix_ms() - 2678400000)));
   let live = fcam-family-put(root, "live0", fcam-family-base("live0"));
   let moved = fcam-family-sweep(root, now_unix_ms());
   old && (live && ((moved == 1) && (fs-exists?(root ++ "/cold/cold0.family.fkb") && (fs-exists?(fcam-family-path(root, "live0")) && !fs-exists?(fcam-family-path(root, "cold0"))))));
  }
  // 2048
  def lrb-stopped(ctx) {
   let before = lrb-lesson-of(ctx);
   let r = fclr-review(lrb-root(ctx), lrb-rung(ctx, "rung-stop", 31, 1), lrb-stopper());
   let absent = fclr-after-rung(lrb-root(ctx), lrb-home(ctx), fclr-rung("rung-absent", nothing(), nothing(), 31, 0, ""), lrb-stopper(), 0);
   ((String) fclr-status(r) == "refused:voice-stopped") && (((Value) lrb-lesson-of(ctx) == before) && ((String) fcap-string(fclr-row(absent), "lesson_review") == "refused:packet-absent"));
  }
  // 4096: the exact contract still hands back its verified candidate, ahead of any family guidance
  def lrb-exact(ctx) {
   let a = lrb-prepare-goal(ctx, lrb-goal-a());
   ((String) fcap-stage(a) == "complete") && ((fcam-hits(a) == 1) && (((Value) fcap-docs(a) == lrb-docs(lrb-path(), lrb-candidate())) && ((String) a[6] == "")));
  }
  def lrb-prepare-goal(ctx, goal) = lrb-prepare(ctx, goal, lrb-path(), "");
  def lrb-fresh() {
   let root = temp_dir() ++ "/form-lesson-review-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str();
   let made = fs-mkdir(root);
   let home = root ++ "/session";
   let homed = fs-mkdir(home);
   let rows = fs-mkdir(home ++ "/rows");
   fs-is-dir?(home ++ "/rows") ? [root, home] : nothing();
  }
 }
 let ctx = lrb-fresh();
 nothing?(ctx) ? form_error("lesson review band needs a fresh directory") : 0;
 let verdict = live-claims("form-cli-code-lesson-review-band", ctx, [["family-recall", 1, 1, lrb-family-recall], ["other-family", 2, 1, lrb-other-family], ["frozen-per-attempt", 4, 1, lrb-frozen], ["environment-claim", 8, 1, lrb-environment], ["not-general", 16, 1, lrb-not-general], ["rule-and-why", 32, 1, lrb-written], ["read-before-write", 64, 1, lrb-patch], ["failure-not-method", 128, 1, lrb-failure-method], ["contrast-row", 256, 1, lrb-contrast], ["supervised-row", 512, 1, lrb-supervised], ["cold-sweep", 1024, 1, lrb-cold], ["voice-stop", 2048, 1, lrb-stopped], ["exact-candidate", 4096, 1, lrb-exact]]);
 host_dir_rmdir(lrb-root(ctx));
 verdict;
}
