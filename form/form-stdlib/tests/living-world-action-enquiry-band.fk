; living-world-action-enquiry-band.fk -- an OPEN plurality may ask without selecting.
; witnessed: 2026-08-08 -> 32767 on fkwu
; Verdict 32767 proves fifteen content identity, optional response, time, lens,
; consent, no-action, outsider-exclusion, and revocation properties.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-action-enquiry.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk form-stdlib/tests/living-world-action-enquiry-witness.fk

(defn lwaeb-evidence-for-stance (items wanted)
    (if (eq (len items) 0) (lwo-none)
        (if (node_eq
                (lwae-stance-evidence-stance (head items)) wanted)
            (head items)
            (lwaeb-evidence-for-stance (tail items) wanted))))

(defn lwaeb-active-selections (world items count)
    (if (eq (len items) 0) count
        (do
            (let candidate (head items))
            (lwaeb-active-selections world (tail items)
                (if (and (eq (lwac-selection-candidate? candidate) 1)
                         (eq (lwac-selection-integrated-current?
                                world candidate) 1))
                    (add count 1) count)))))

(defn lwaeb-active-executions (world items count)
    (if (eq (len items) 0) count
        (do
            (let candidate (head items))
            (lwaeb-active-executions world (tail items)
                (if (and (eq (lwac-execution-candidate? candidate) 1)
                         (and (eq (lwo-active? world candidate) 1)
                              (eq (lwac-execution-candidate-current?
                                     world candidate) 1)))
                    (add count 1) count)))))

(do
    (let world (lwaew-world))
    (let field (lwaew-field))
    (let eligible (lwae-eligible-for-field world field))
    (let proposal (lwaew-question-proposal))
    (let candidate (lwaew-question-candidate))
    (let question (lwo-emergent-shape candidate))
    (let waiting-world
        (lwt-round-world (lwaew-question-waiting-round)))
    (let question-world (lwaew-question-world))
    (let stanced-world (lwaew-stanced-world))
    (let outsider-world (lwaew-outsider-world))
    (let stance-evidence
        (lwae-stance-evidence-for stanced-world candidate))
    (let outsider-evidence
        (lwae-stance-evidence-for outsider-world candidate))
    (let immediate-evidence
        (lwaeb-evidence-for-stance
            (lwo-field-items outsider-evidence)
            (lwaew-immediate-stance)))
    (let stanced-field
        (lwac-field-for stanced-world (lwacw-focus) 2))
    (let layered-stack
        (lwlc-declaration-stack (lwaew-layered-declaration)))
    (let default-outcome
        (lwae-stance-time (lwaew-default-outcome-stance)))
    (let expired-nothing
        (lwaew-expired-nothing-stance))
    (let forged
        (lwo-emergent question
            (lwo-emergent-witnesses candidate)
            (intern_trivial_int 3)
            (intern_trivial_int 2)
            (intern_trivial_int 15)
            (lwae-question-origin question)))
    (let bad-reference
        (lwae-stance candidate
            (oac-alternative-ack (lwacw-action-a)
                (lwacw-action-b) (lwaew-evidence))
            (lwo-none) (lwo-none) (lwo-empty-field)
            (lwo-none) (lwaew-evidence)))
    (let revoked-world (lwaew-revoked-world))
    (let revoked-field
        (lwac-field-for revoked-world (lwacw-focus) 2))
    (let revoked-selection
        (lwac-selection-proposal revoked-world (lwacw-focus) 2))

    (let c1
        (if (and (eq (lwo-field-size
                          (lwac-field-candidates field)) 2)
                 (and (eq (lwo-field-size eligible) 2)
                      (and (eq (lwac-open?
                                   (lwac-field-status field)) 1)
                           (node_eq (lwac-field-primary field)
                               (lwo-none))))) 1 0))
    (let c2
        (if (and (eq (lwo-field-size
                          (lwac-field-alternatives field)) 4)
                 (and (eq (lwo-field-size
                               (lwac-field-unknowns field)) 1)
                      (eq (lwlc-unknown?
                               (lwac-field-derived-unknown field)) 1))) 2 0))
    (let c3
        (if (and (eq (lwo-field-size
                          (lwt-proposal-participants proposal)) 6)
                 (and (eq (lwo-field-size
                               (lwo-emergent-witnesses candidate)) 15)
                      (and (eq (lwae-question-current?
                                   world candidate) 1)
                           (eq (lwo-emergent-ready?
                                   world candidate) 1)))) 4 0))
    (let c4
        (if (eq (lwo-active? waiting-world candidate) 0) 8 0))
    (let c5
        (if (and (eq (lwo-active? question-world candidate) 1)
                 (and (eq (lwo-field-size
                               (lwo-active-attributions-for
                                   question-world candidate)) 6)
                      (eq (lwae-question-steady?
                               question-world candidate) 1))) 16 0))
    (let c6
        (if (and (node_eq (lwae-question-field question) field)
                 (and (node_eq (lwae-question-eligible question) eligible)
                      (eq (lwae-question-current?
                               world forged) 0))) 32 0))
    (let c7
        (if (and (node_eq
                      (lwae-question-proposal question-world
                          (lwacw-focus) 2)
                      (lwo-none))
                 (and (node_eq
                           (lwac-selection-proposal world
                               (lwacw-focus) 2)
                           (lwo-none))
                      (node_eq
                           (lwac-selection-proposal stanced-world
                               (lwacw-focus) 2)
                           (lwo-none)))) 64 0))
    (let c8
        (if (and (eq (lwo-field-size stance-evidence) 4)
                 (and (eq (lwae-stance-valid? stanced-world
                               (lwaew-immediate-stance)) 1)
                      (and (eq (lwae-stance-valid? stanced-world
                                    (lwaew-pending-stance)) 1)
                           (and (eq (lwae-stance-valid? stanced-world
                                         (lwaew-default-outcome-stance)) 1)
                                (and (eq (lwae-stance-valid? stanced-world
                                              expired-nothing) 1)
                                     (eq (lwae-stance-valid? stanced-world
                                              bad-reference) 0)))))) 128 0))
    (let c9
        (if (and (eq (lwae-stance-immediate-nothing?
                          (lwaew-immediate-stance)) 1)
                 (and (node_eq (lwae-stance-declaration
                                    (lwaew-immediate-stance))
                               (lwo-none))
                      (and (eq (lwo-field-size outsider-evidence) 4)
                           (and (eq (lwo-field-size
                                        (lwo-active-attributions-for
                                            outsider-world
                                            (lwaew-immediate-stance))) 2)
                                (eq (lwo-field-size
                                        (lwae-stance-evidence-attributions
                                            immediate-evidence)) 1))))) 256 0))
    (let c10
        (if (and (eq (lwae-stance-time-pending?
                          (lwaew-pending-stance)) 1)
                 (and (eq (lwae-stance-alternative?
                               (lwaew-pending-stance)) 1)
                      (eq (lwlc-declaration-valid?
                               (lwaew-layered-declaration)) 1))) 512 0))
    (let c11
        (if (and (eq (lwlc-lens?
                          (lwlc-stack-default layered-stack)) 1)
                 (and (eq (len (lwlc-layer-items
                                    (lwlc-stack-layers layered-stack))) 2)
                      (and (eq (lwo-field-size
                                    (lwlc-stack-alternatives
                                        layered-stack)) 1)
                           (eq (lwlc-unknown?
                                    (lwlc-stack-unknown
                                        layered-stack)) 1)))) 1024 0))
    (let c12
        (if (and (eq (oac-time-outcome? default-outcome) 1)
                 (and (eq (lwae-stance-alternative?
                               (lwaew-default-outcome-stance)) 1)
                      (node_eq
                          (lwae-stance-ack
                              (lwaew-default-outcome-stance))
                          (oac-timeout-default
                              (oac-time-outcome-timeout
                                  default-outcome))))) 2048 0))
    (let c13
        (if (and (eq (lwae-stance-expired-to-nothing?
                          expired-nothing) 1)
                 (and (not (node_eq
                                (lwaew-immediate-stance)
                                expired-nothing))
                      (not (node_eq
                                (lwae-stance-time
                                    (lwaew-immediate-stance))
                                (lwae-stance-time
                                    expired-nothing))))) 4096 0))
    (let c14
        (if (and (node_eq field stanced-field)
                 (and (eq (lwaeb-active-selections stanced-world
                               (lwo-field-items
                                   (lwo-world-cells stanced-world)) 0) 0)
                      (eq (lwaeb-active-executions stanced-world
                               (lwo-field-items
                                   (lwo-world-cells stanced-world)) 0) 0)))
            8192 0))
    (let c15
        (if (and (eq (lwae-question-current?
                          revoked-world candidate) 0)
                 (and (eq (lwo-field-size
                               (lwae-stance-evidence-for
                                   revoked-world candidate)) 0)
                      (and (eq (lwac-ready?
                                   (lwac-field-status revoked-field)) 1)
                           (and (not (node_eq revoked-selection
                                           (lwo-none)))
                                (eq (lwo-active? revoked-world
                                     (lwt-proposal-candidate
                                         revoked-selection)) 0))))) 16384 0))
    (lwaew-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
