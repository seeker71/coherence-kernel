; kernel-steward-band.bml — the body's awareness of its own kernels, fkwu-witnessed (form-stdlib/bml/kernel-steward.bml).
;
; The steward reads the host's process rows, finds the kernels, reads each one's source and lease, and names the one
; class it stops by itself: a kernel whose source file is gone. These claims are pure over fixture rows and a scratch
; file; no process is signalled.
;
; Expected: 15
; Verdict 15 when every claim lands:
;   1   a ps row reads to pid, parent pid, resident KB, elapsed and the whole command (spaces kept); a short line reads as nothing
;   2   the source a kernel runs is the first file-like word after fkwu: `./fkwu .hearth/x.bml` -> .hearth/x.bml,
;       `/bin/sh form-run ./fkwu observe/y.bml` -> observe/y.bml, a command with no file word -> ""
;   4   kinds: source gone AND parent gone (ppid 1) -> orphan whatever the size; source gone with a parent still waiting
;       -> working (a child of a live flow); leased -> leased even above the cap; above the cap unleased -> heavy;
;       otherwise working
;   8   a reading over a scratch source that stands is "working"; over one that is gone it is "orphan" only when launchd
;       holds the kernel (ppid 1) and "working" while a parent waits; the steward's own door is never a kernel candidate
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/kernel-steward.bml
section [form.bml] {
 class KernelStewardBand {
  def kb-c-parse(ctx) {
   let r = ks-parse-line("  9419 1 27997000 01-04:43:22 ./fkwu /private/tmp/x/kids-after.bml");
   let short = ks-parse-line("12 34");
   !nothing?(r) && ks-pid(r) == 9419 && ks-ppid(r) == 1 && ks-rss(r) == 27997000 && (String) ks-etime(r) == "01-04:43:22" && (String) ks-cmd(r) == "./fkwu /private/tmp/x/kids-after.bml" && nothing?(short);
  }
  def kb-c-source(ctx) = (String) ks-source("./fkwu .hearth/x.bml") == ".hearth/x.bml" && (String) ks-source("/bin/sh /Users/u/.local/bin/form-run ./fkwu observe/y.bml") == "observe/y.bml" && (String) ks-source("./fkwu") == "" && (String) ks-source("/usr/bin/tee /tmp/form-run.X/stdout") == "";
  def kb-c-kinds(ctx) = (String) ks-kind(1, 1, 0, 1000, 1000000) == "orphan" && (String) ks-kind(1, 1, 1, 99999999, 1000000) == "orphan" && (String) ks-kind(1, 0, 0, 1000, 1000000) == "working" && (String) ks-kind(0, 1, 1, 99999999, 1000000) == "leased" && (String) ks-kind(0, 0, 0, 2000000, 1000000) == "heavy" && (String) ks-kind(0, 1, 0, 1000, 1000000) == "working";
  def kb-c-reading(ctx) {
   let root = fs_mkdir(".hearth");
   let d = fs_mkdir(".hearth/kernel-steward-band");
   let w = write_file_text(".hearth/kernel-steward-band/standing.bml", "section [form.bml] { 0; }\n");
   let here = pid => ".";
   let elsewhere = pid => "/nonexistent-cwd-for-the-band";
   let unknown = pid => "";
   // a relative source is read beside the kernel's cwd: standing here -> working; the same path from a cwd where
   // it is not -> orphan; a cwd that cannot be read -> never an orphan; an absolute source needs no cwd
   let standing = ks-read-with([4242, 1, 1000, "00:01", "./fkwu .hearth/kernel-steward-band/standing.bml"], here);
   let gone = ks-read-with([4243, 1, 1000, "00:01", "./fkwu .hearth/kernel-steward-band/gone.bml"], here);
   let held = ks-read-with([4247, 4242, 1000, "00:01", "./fkwu .hearth/kernel-steward-band/gone.bml"], here);
   let moved = ks-read-with([4244, 1, 1000, "00:01", "./fkwu .hearth/kernel-steward-band/standing.bml"], elsewhere);
   let blind = ks-read-with([4245, 1, 1000, "00:01", "./fkwu .hearth/kernel-steward-band/gone.bml"], unknown);
   let absolute = ks-read-with([4246, 1, 1000, "00:01", "./fkwu /nonexistent/scratch/kids-after.bml"], unknown);
   let self = ks-kernel?([ks-self(), 1, 1000, "00:01", "./fkwu observe/kernel-steward-run.bml"]);
   let c = host_path_remove(".hearth/kernel-steward-band/standing.bml");
   let rd = fs_rmdir(".hearth/kernel-steward-band");
   (String) standing[1] == "working" && (String) gone[1] == "orphan" && (String) held[1] == "working" && (String) moved[1] == "orphan" && (String) blind[1] == "working" && (String) absolute[1] == "orphan" && (String) gone[4] == ".hearth/kernel-steward-band/gone.bml" && !self;
  }
 }
 live-claims("kernel-steward-band", 0, [["parse", 1, 1, kb-c-parse], ["source", 2, 1, kb-c-source], ["kinds", 4, 1, kb-c-kinds], ["reading", 8, 1, kb-c-reading]]);
}
