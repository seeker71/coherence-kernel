; corpus-query-offers-band.fk -- corpus-to-local-stream bridge.
;
; Verdict 2047: live corpus scale, valid current source-bound NodeID offer,
; exact scannerless query, source/question identities, no answer in offer or
; prompt, no model/weight claim, and changed-question dissolution.
;
; preludes: form-stdlib/core.fk learn/corpus-query-offers.fk

(do
    (defn cqob-bit (ok bit) (if ok bit 0))
    (let row (cts-row-for "heedmark"))
    (let question (cts-question row))
    ; `carrier` is a question token, not the answer. It occurs in the current
    ; row and is discriminative inside the bound corpus source.
    (let offer (cqo-offer question "carrier"))
    (let prompt (cqo-rehearsal-prompt question "carrier"))
    (let query "<|form:knowledge-query|>carrier<|/form:knowledge-query|>")
    (sum (list
        (cqob-bit (gt (cqo-sample-count) 400) 1)
        (cqob-bit (eq (cqo-offer-valid? offer question) 1) 2)
        (cqob-bit (str_eq (nth offer 3) query) 4)
        (cqob-bit (str_eq (nth offer 4) (cqo-source-path)) 8)
        (cqob-bit (and (eq (str_len (nth offer 5)) 71)
                       (str_eq (substring (nth offer 5) 0 7) "sha256:")) 16)
        (cqob-bit (and (eq (str_len (nth offer 7)) 64)
                       (eq (hex-valid? (nth offer 7)) 1)) 32)
        (cqob-bit (eq (nth offer 8) 0) 64)
        (cqob-bit (lt (str_find (nth offer 3) "heedmark" 0) 0) 128)
        (cqob-bit (ge (str_find prompt query 0) 0) 256)
        (cqob-bit (lt (str_find prompt "heedmark" 0) 0) 512)
        (cqob-bit (and (nothing? (cqo-offer
            (str_concat question " changed") "absent-token"))
            (and (eq (cqo-model-executed) 0)
                 (eq (cqo-weights-trained) 0))) 1024))))
