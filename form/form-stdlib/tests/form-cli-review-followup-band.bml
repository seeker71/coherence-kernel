// Boundary choices are pure; live model retention is observed separately.
// preludes: form-stdlib/bml/form-cli-review-followup.bml
section [form.bml] {
 class ReviewFollowupWitness {
  def rfwb-check(ok) = if ok then 1 else form_error("native review follow-up boundary differs");
 }
 let reviewing = fcap-open-direct-review("Inspect the supplied source",list(list("x","x.txt","kept")));
 let complete = fcap-note-at(fcap-with-report(reviewing,"{\"answer\":true}"),"complete","checked");
 let code = fcap-open-direct-code("Change only the offered document",list(list("x","x.txt","kept")),list("x.txt"));
 rfwb-check(str_eq(fcrf-next(code,"revise",8),"requires-review"));
 rfwb-check(str_eq(fcrf-next(complete,"  ",8),"not-offered"));
 rfwb-check(str_eq(fcrf-next(reviewing,"revise",8),"first-review-incomplete"));
 rfwb-check(str_eq(fcrf-next(complete,"revise",fcap-turns(complete)),"turn-budget-exhausted"));
 rfwb-check(str_eq(fcrf-next(complete,"revise",add(fcap-turns(complete),1)),"continue"));
 let declined = fcrf-admit("unavailable-model",code,list(),8192,8,"revise");
 rfwb-check(and(str_eq(nth(declined,4),"requires-review"),and(str_eq(fcap-stage(head(head(declined))),"attention"),value_eq(fcap-docs(head(head(declined))),fcap-docs(code)))));
 rfwb-check(and(eq(nth(head(declined),1),1),eq(nth(head(declined),2),0)));
 let closed = fcrf-admit("unavailable-model",complete,list(),8192,8,"revise");
 rfwb-check(and(str_eq(fcap-stage(head(head(closed))),"attention"),and(str_eq(nth(closed,1),fcap-report(complete)),eq(nth(closed,3),0))));
 let unchanged = fcrf-admit("unavailable-model",complete,list(),8192,8,"");
 rfwb-check(and(str_eq(fcap-stage(head(head(unchanged))),"complete"),str_eq(nth(unchanged,1),fcap-report(complete))));
 let unavailable = fcrf-admit("unavailable-model",reviewing,list(),8192,8,"revise");
 rfwb-check(and(str_eq(fcap-note(head(head(unavailable))),"followup-native-model-unavailable"),and(eq(nth(unavailable,3),0),eq(nth(head(unavailable),2),0))));
 1;
}
