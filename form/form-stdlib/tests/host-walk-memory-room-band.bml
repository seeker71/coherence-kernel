; host-walk-memory-room-band.bml — the walk asks its own memory room before a turn starts (form-stdlib/bml/host-walk-window.bml hw-memory-room-of), no model and no host reading: the host's statistics are fixtures.
;
; Verdict 31 when every claim lands:
;   1   a walk that holds more than the host has available is refused, and the line names both figures
;   2   a walk that holds less than the host has available is held (no line)
;   4   a host whose statistics did not arrive holds nothing back: nothing is claimed on a number nobody read
;   8   a footprint that did not arrive (an older kernel answers nothing for kernel_stat 91, or 0) holds nothing back
;   16  the refusal is exactly the shape hw-turns reads: [false, "[walk-window] ..."]
//
// REQUIRES: the built ./fkwu and the body root as the working directory.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/host-walk-window.bml
section [form.bml] {
 class HostWalkMemoryRoomBand {
  // host_vm_stat(): [page, memsize, free, active, inactive, wired, speculative, purgeable, compressor, pageins, pageouts, compressions, decompressions, swapins, swapouts, external, internal]
  def hmb-vm(freePages, purgeable, external) = [16384, 137438953472, freePages, 100000, 50000, 2000000, 0, purgeable, 3000000, 0, 0, 0, 0, 0, 0, external, 0];
  def hmb-gib() = 1073741824;
  def hmb-low() = hmb-vm(100000, 50000, 100000);
  def hmb-roomy() = hmb-vm(2000000, 100000, 500000);
  def hmb-1() { let r = hw-memory-room-of(54 * hmb-gib(), hmb-low()); !r[0] && str_find(r[1], "[walk-window] this walk holds 54.0 GiB and the host has ", 0) == 0 && str_find(r[1], " available: no turn starts", 0) > 0; }
  def hmb-2() { let r = hw-memory-room-of(3 * hmb-gib(), hmb-roomy()); r[0] && r[1] == ""; }
  def hmb-4() { let r = hw-memory-room-of(54 * hmb-gib(), nothing()); r[0] && r[1] == ""; }
  def hmb-8() { let a = hw-memory-room-of(nothing(), hmb-low()); let b = hw-memory-room-of(0, hmb-low()); a[0] && b[0] && a[1] == "" && b[1] == ""; }
  def hmb-16() { let r = hw-memory-room-of(54 * hmb-gib(), hmb-low()); (String) value_kind(r) == "list" && len(r) == 2 && !r[0] && (String) value_kind(r[1]) == "string"; }
 }
 print_str("[walk-memory-room] 1 " ++ hmb-1().str() ++ " 2 " ++ hmb-2().str() ++ " 4 " ++ hmb-4().str() ++ " 8 " ++ hmb-8().str() ++ " 16 " ++ hmb-16().str());
 (hmb-1() ? 1 : 0) + (hmb-2() ? 2 : 0) + (hmb-4() ? 4 : 0) + (hmb-8() ? 8 : 0) + (hmb-16() ? 16 : 0);
}
