; host-walk-memory-room-band.bml — the walk asks its own memory room before a turn starts (form-stdlib/bml/host-walk-window.bml hw-memory-room-of), no model and no host reading: the host's statistics are fixtures.
;
; Verdict 63 when every claim lands:
;   1   a walk's large footprint is reported without refusing an unrequested allocation
;   2   a smaller footprint remains an observation too
;   4   missing host statistics remain unobserved
;   8   missing or zero footprint remains unobserved
;   16  the reading remains available while actual session admission owns resources
;   32  compression on either side of the old quarter threshold cannot veto admission
//
// REQUIRES: the built ./fkwu and the body root as the working directory.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/host-walk-window.bml
section [form.bml] {
 class HostWalkMemoryRoomBand {
  // host_vm_stat(): [page, memsize, free, active, inactive, wired, speculative, purgeable, compressor, pageins, pageouts, compressions, decompressions, swapins, swapouts, external, internal]
  def hmb-vm(freePages, purgeable, external) = [16384, 137438953472, freePages, 100000, 50000, 2000000, 0, purgeable, 3000000, 0, 0, 0, 0, 0, 0, external, 0];
  def hmb-gib() = 1073741824;
  def hmb-low() = hmb-vm(100000, 50000, 100000);
  def hmb-roomy() = hmb-vm(2000000, 100000, 500000);
  def hmb-1() { let r = hw-memory-room-of(54 * hmb-gib(), hmb-low()); r[0] && str_find(r[1],"footprint 54.0 GiB",0)>=0 && str_find(r[1],"available " ++ mg-gib-text(mg-available(hmb-low())),0)>=0; }
  def hmb-2() { let r = hw-memory-room-of(3 * hmb-gib(), hmb-roomy()); r[0] && str_find(r[1],"footprint 3.0 GiB",0)>=0; }
  def hmb-4() { let r = hw-memory-room-of(54 * hmb-gib(), nothing()); r[0] && str_find(r[1],"host memory unobserved",0)>=0; }
  def hmb-8() { let a = hw-memory-room-of(nothing(), hmb-low()); let b = hw-memory-room-of(0, hmb-low()); a[0] && b[0] && str_find(a[1],"footprint unobserved",0)>=0 && str_find(b[1],"footprint unobserved",0)>=0; }
  def hmb-16() { let r = hw-memory-room-of(54 * hmb-gib(), hmb-low()); value_kind(r)=="list" && len(r)==2 && r[0] && str_find(r[1],"native admission owns the requested allocation",0)>=0; }
  // Both compressed and quiet host readings retain their actual figures.
  def hmb-compressed(compressor) = [16384, 137438953472, 100000, 100000, 0, 200000, 0, 0, 91641, 0, 0, 0, 0, 0, 0, 500000, 500000, compressor];
  def hmb-32() { let paging = hw-memory-room-of(1073741824, hmb-compressed(2500000)); let calm = hw-memory-room-of(1073741824, hmb-compressed(100000)); paging[0] && str_find(paging[1],"compressed 38.1 GiB",0)>=0 && calm[0] && paging[1]!=calm[1]; }
 }
 print_str("[walk-memory-room] 1 " ++ hmb-1().str() ++ " 2 " ++ hmb-2().str() ++ " 4 " ++ hmb-4().str() ++ " 8 " ++ hmb-8().str() ++ " 16 " ++ hmb-16().str() ++ " 32 " ++ hmb-32().str());
 (hmb-1() ? 1 : 0) + (hmb-2() ? 2 : 0) + (hmb-4() ? 4 : 0) + (hmb-8() ? 8 : 0) + (hmb-16() ? 16 : 0) + (hmb-32() ? 32 : 0);
}
