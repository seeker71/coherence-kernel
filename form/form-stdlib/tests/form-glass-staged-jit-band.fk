; form-glass-staged-jit-band.fk — once-born route selector proof.
; Verdict 255.
; preludes: form-stdlib/form-glass-staged-jit.fk

(do
    (defn fgsjb-bit (held weight) (if (eq held 1) weight 0))
    (let first (fgsj-request (fgsj-registry) "memory"))
    (let second (fgsj-request (fgsj-next-registry first) "memory"))
    (let flow (fgsj-request (fgsj-next-registry second) "flow"))
    (let unknown (fgsj-request (fgsj-next-registry flow) "unknown"))
    (sum (list
        (fgsjb-bit (and (str_eq (fgsj-status first) "selected")
                       (eq (fgsj-code first) 20)) 1)
        (fgsjb-bit (eq (fgsj-born first) 1) 2)
        (fgsjb-bit (eq (fgsj-born second) 0) 4)
        (fgsjb-bit (str_eq (fgsj-execution-route second) "native") 8)
        (fgsjb-bit (eq (fgsj-code flow) 30) 16)
        (fgsjb-bit (eq (fgsj-born flow) 0) 32)
        (fgsjb-bit (str_eq (fgsj-status unknown) "refused") 64)
        (fgsjb-bit (str_eq (nth second 7)
                           "runtime.full-program-image.call") 128))))
