; form-recipe-observation-cross-cell-band.fk — native witness that a typed
; recipe-execution observation crosses as bytes between distinct cell
; identities, is reconstructed by the receiver, and remains attributable
; through simultaneous meaning/vitality lenses and optional persistence.
;
; Verdict 16777215 (24 bits):
;   1        emitter, receiver, and typed channel are distinct/addressed
;   2        envelope identity round-trips through strict wire serialization
;   4        node-exchange delivers the observation NodeID exactly once
;   8        the receiver uses the byte-reconstructed envelope and acks it
;   16       meaning/vitality are simultaneous distinct source-preserving nodes
;   32       both lenses retain status, presence, and exact value 0
;   64       present integer 0 crosses without becoming nothing
;   128      present integer 1 crosses without becoming truth-only metadata
;   256      nothing crosses with presence=0, distinct from integer 0
;   512      carrier failure crosses and keeps failure/undo/refine/release
;   1024     carrier timeout crosses and keeps timeout/cut/undo/refine/release
;   2048     successful crossing keeps choice/send/receive/release observations
;   4096     requested persistence reloads the same received NodeID
;   8192     skipped persistence is typed nothing with no claimed write/reload
;   16384    a seen channel offers nothing and does not transport twice
;   32768    partial and trailing/control-shaped wire frames are refused
;   65536    a mismatched exchange withholds, writes nothing, and cuts/refines
;   131072   explicit elapsed deadline records timeout/cut/undo/refine/release
;   262144   mesh projection preserves payload identity, spends one TTL only,
;            and remains explicitly not the physical transport
;   524288   execution observation, offer, delivery, receipt identities agree
;   1048576  actual channel file byte count is exact and bounded by one message
;   2097152  receiver identity survives envelope, received node, and both lenses
;   4194304  failure observations remain received/lensed, not erased as absence
;   8388608  control-shaped payload text remains data and cannot forge a frame
;
; The frex offers in this band are typed observation data. They do not run a
; model, Metal, generated code, or the affine recipe.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/form-recipe-observation-cross-cell.fk

(do
    (defn frocband-bit (condition bit) (if condition bit 0))

    (defn frocband-result (status value reason carrier)
        (do
            (let request (frex-parse
                (frex-surface (frex-recipe) 5 "auto")))
            (frex-choice request
                (list (frex-offer carrier status value reason)))))
    (defn frocband-zero ()
        (frocband-result "value" 0 "observed-zero" "cpu"))
    (defn frocband-one ()
        (frocband-result "value" 1 "observed-one" "cpu"))
    (defn frocband-nothing ()
        (frocband-result "nothing" 0 "not-present" "metal"))
    (defn frocband-failure ()
        (frocband-result "failure" 0 "carrier-failure" "metal"))
    (defn frocband-timeout ()
        (frocband-result "timeout" 0 "carrier-deadline" "mlx"))

    (defn frocband-frex-all? (trace actions)
        (if (eq (len actions) 0) 1
            (if (eq (frex-trace-has? trace (head actions)) 1)
                (frocband-frex-all? trace (tail actions)) 0)))
    (defn frocband-cross-all? (trace actions)
        (if (eq (len actions) 0) 1
            (if (eq (froc-trace-has? trace (head actions)) 1)
                (frocband-cross-all? trace (tail actions)) 0)))

    (defn frocband-cross (channel-name persistence-name requested result)
        (froc-cross-frex
            (str_concat (temp_dir) (str_concat "/" channel-name))
            (str_concat (temp_dir) (str_concat "/" persistence-name))
            requested result (str_len (frex-render result))))

    (defn form-recipe-observation-cross-cell-band ()
        (do
            (let zero-result (frocband-zero))
            (let one-result (frocband-one))
            (let nothing-result (frocband-nothing))
            (let failure-result (frocband-failure))
            (let timeout-result (frocband-timeout))

            (let zero-x (frocband-cross
                "froc-band-zero.channel"
                "froc-band-zero.persistence" 1 zero-result))
            (let one-x (frocband-cross
                "froc-band-one.channel"
                "froc-band-one.persistence" 0 one-result))
            (let nothing-x (frocband-cross
                "froc-band-nothing.channel"
                "froc-band-nothing.persistence" 0 nothing-result))
            (let failure-x (frocband-cross
                "froc-band-failure.channel"
                "froc-band-failure.persistence" 0 failure-result))
            (let timeout-x (frocband-cross
                "froc-band-timeout.channel"
                "froc-band-timeout.persistence" 0 timeout-result))

            (let zero-e (froc-cross-envelope zero-x))
            (let zero-emit (froc-cross-emit zero-x))
            (let zero-ack (froc-cross-ack zero-x))
            (let zero-channel (froc-envelope-channel zero-e))
            (let zero-path
                (str_concat (temp_dir) "/froc-band-zero.channel"))
            (let zero-read (froc-channel-read zero-path 0))
            (let zero-p (froc-ack-persistence zero-ack))

            (let one-ack (froc-cross-ack one-x))
            (let nothing-ack (froc-cross-ack nothing-x))
            (let failure-ack (froc-cross-ack failure-x))
            (let timeout-ack (froc-cross-ack timeout-x))

            ; The same physical file has already yielded its one message.
            (let seen-ack (froc-receive zero-path 1
                (froc-receiver) zero-channel zero-emit
                (str_concat (temp_dir) "/froc-band-seen.persistence") 0))

            ; A wrong source identity makes node-exchange withhold before the
            ; file carrier can write a byte.
            (let withheld-path
                (str_concat (temp_dir) "/froc-band-withheld.channel"))
            (let removed-withheld (fs_remove withheld-path))
            (let wrong-exchange (hm-open-channel
                "not-the-envelope-emitter"
                (froc-node-text (froc-envelope-receiver zero-e))
                "substrate:node" "offer:recipe-execution-observation"
                "cap.node.deliver" "cell-json" 1 4096))
            (let withheld (froc-emit-with-exchange withheld-path zero-e
                (str_len (frex-render zero-result)) wrong-exchange))

            ; Invalid bytes are observed at the frame boundary, before the
            ; structural cell parser is entered.
            (let partial-path
                (str_concat (temp_dir) "/froc-band-partial.channel"))
            (let removed-partial (fs_remove partial-path))
            (let partial-write (write_file_text partial-path
                (str_concat (froc-wire-open) "partial-json")))
            (let partial-read (froc-channel-read partial-path 0))
            (let trailing-path
                (str_concat (temp_dir) "/froc-band-trailing.channel"))
            (let removed-trailing (fs_remove trailing-path))
            (let trailing-text
                (str_concat (froc-wire-text zero-e) "trailing-control"))
            (let trailing-write (write_file_text trailing-path trailing-text))
            (let trailing-read (froc-channel-read trailing-path 0))

            ; An apparent inner close mark is valid text data. JSON escapes
            ; its leading newline, so it cannot impersonate the outer mark.
            (let control-result (frocband-result "failure" 0
                (str_concat "payload:" (froc-wire-close)) "metal"))
            (let control-x (frocband-cross
                "froc-band-control.channel"
                "froc-band-control.persistence" 0 control-result))
            (let control-ack (froc-cross-ack control-x))

            (let deadline-ack
                (froc-receive-timeout (froc-receiver) zero-channel))
            (let mesh (froc-emit-mesh-forward zero-emit))
            (let zero-meaning (froc-ack-meaning zero-ack))
            (let zero-vitality (froc-ack-vitality zero-ack))

            (sum (list
                (frocband-bit (and
                    (eq (froc-participant-valid? (froc-emitter)) 1)
                    (and (eq (froc-participant-valid? (froc-receiver)) 1)
                    (and (not (node_eq (froc-emitter) (froc-receiver)))
                    (and (eq (froc-channel-valid? zero-channel
                                    (froc-emitter) (froc-receiver)) 1)
                         (str_eq (node_value (nth (node_children zero-channel) 2))
                                 "typed-file-channel"))))) 1)
                (frocband-bit (and
                    (eq (froc-wire-valid? (froc-wire-text zero-e)) 1)
                    (and (node_eq (froc-wire-node (froc-wire-text zero-e)) zero-e)
                         (node_eq (froc-channel-read-node zero-read) zero-e))) 2)
                (frocband-bit (and
                    (str_eq (nx-delivery-status
                                (froc-emit-delivery zero-emit)) "delivered")
                    (and (eq (froc-emit-count zero-emit) 1)
                    (and (str_eq (nth (froc-emit-delivery zero-emit) 2)
                                 (froc-node-text
                                    (froc-envelope-observation zero-e)))
                         (eq (froc-emit-ok? zero-emit) 1)))) 4)
                (frocband-bit (and
                    (node_eq (froc-ack-envelope zero-ack) zero-e)
                    (and (node_eq (froc-ack-observation zero-ack)
                                  (froc-envelope-observation zero-e))
                    (and (str_eq (froc-ack-delivery-status zero-ack)
                                 "delivered")
                         (eq (froc-ack-transported? zero-ack) 1)))) 8)
                (frocband-bit (and
                    (not (node_eq zero-meaning zero-vitality))
                    (and (str_eq (froc-lens-name zero-meaning) "meaning")
                    (and (str_eq (froc-lens-name zero-vitality) "vitality")
                    (and (gt (str_len (froc-lens-carrier zero-meaning)) 0)
                    (and (gt (str_len (froc-lens-carrier zero-vitality)) 0)
                         (eq (froc-lenses-preserve-source?
                            (list zero-meaning zero-vitality) zero-e) 1)))))) 16)
                (frocband-bit (and
                    (str_eq (froc-lens-status zero-meaning) "value")
                    (and (str_eq (froc-lens-status zero-vitality) "value")
                    (and (eq (froc-lens-value-present? zero-meaning) 1)
                    (and (eq (froc-lens-value-present? zero-vitality) 1)
                    (and (eq (froc-lens-value zero-meaning) 0)
                         (eq (froc-lens-value zero-vitality) 0)))))) 32)
                (frocband-bit (and
                    (str_eq (froc-ack-status zero-ack) "value")
                    (and (eq (froc-ack-value-present? zero-ack) 1)
                    (and (eq (froc-ack-value zero-ack) 0)
                         (not (node_eq (froc-ack-observation zero-ack)
                                      (frex-absent-token)))))) 64)
                (frocband-bit (and
                    (str_eq (froc-ack-status one-ack) "value")
                    (and (eq (froc-ack-value-present? one-ack) 1)
                         (eq (froc-ack-value one-ack) 1))) 128)
                (frocband-bit (and
                    (str_eq (froc-ack-status nothing-ack) "nothing")
                    (and (eq (froc-ack-value-present? nothing-ack) 0)
                    (and (eq (froc-ack-value nothing-ack) 0)
                         (not (node_eq (froc-ack-observation nothing-ack)
                                      (froc-ack-observation zero-ack)))))) 256)
                (frocband-bit (and
                    (str_eq (froc-ack-status failure-ack) "failure")
                    (and (eq (froc-ack-value-present? failure-ack) 0)
                         (eq (frocband-frex-all?
                            (froc-trace-events
                                (froc-ack-execution-trace failure-ack))
                            (list "failure" "undo" "refine" "release")) 1))) 512)
                (frocband-bit (and
                    (str_eq (froc-ack-status timeout-ack) "timeout")
                    (and (eq (froc-ack-value-present? timeout-ack) 0)
                         (eq (frocband-frex-all?
                            (froc-trace-events
                                (froc-ack-execution-trace timeout-ack))
                            (list "timeout" "cut" "undo" "refine" "release")) 1))) 1024)
                (frocband-bit (eq (frocband-cross-all?
                    (froc-ack-cross-trace zero-ack)
                    (list "choice" "send" "receive" "release")) 1) 2048)
                (frocband-bit (and
                    (str_eq (froc-persistence-status zero-p) "reloaded")
                    (and (eq (froc-persistence-attempted? zero-p) 1)
                    (and (eq (froc-persistence-persisted? zero-p) 1)
                    (and (eq (froc-persistence-reloaded? zero-p) 1)
                         (node_eq (froc-persistence-received zero-p)
                                  (froc-ack-received zero-ack)))))) 4096)
                (frocband-bit (do
                    (let p (froc-ack-persistence one-ack))
                    (if (and (str_eq (froc-persistence-status p) "nothing")
                        (and (eq (froc-persistence-attempted? p) 0)
                        (and (eq (froc-persistence-persisted? p) 0)
                             (eq (froc-persistence-reloaded? p) 0)))) 1 0)) 8192)
                (frocband-bit (and
                    (str_eq (froc-ack-status seen-ack) "nothing")
                    (and (eq (froc-ack-transported? seen-ack) 0)
                    (and (eq (froc-ack-value-present? seen-ack) 0)
                         (str_eq (froc-ack-reason seen-ack) "already-seen")))) 16384)
                (frocband-bit (and
                    (str_eq (froc-channel-read-status partial-read) "failure")
                    (and (str_eq (froc-channel-read-reason partial-read)
                                 "wire-frame-invalid")
                    (and (str_eq (froc-channel-read-status trailing-read) "failure")
                         (nothing? (froc-channel-read-node trailing-read))))) 32768)
                (frocband-bit (and
                    (str_eq (froc-emit-status withheld) "failure")
                    (and (str_eq (nx-delivery-status
                                (froc-emit-delivery withheld)) "withheld")
                    (and (le (file_size withheld-path) 0)
                         (eq (frocband-cross-all? (froc-emit-trace withheld)
                            (list "choice" "failure" "undo" "refine"
                                  "cut" "release")) 1)))) 65536)
                (frocband-bit (and
                    (str_eq (froc-ack-status deadline-ack) "timeout")
                    (and (eq (froc-ack-value-present? deadline-ack) 0)
                         (eq (frocband-cross-all?
                            (froc-ack-cross-trace deadline-ack)
                            (list "timeout" "cut" "undo" "refine"
                                  "release")) 1))) 131072)
                (frocband-bit (and
                    (eq (len mesh) 4)
                    (and (node_eq (mr-payload mesh) zero-e)
                    (and (eq (mr-ttl mesh) 1)
                    (and (str_eq (mr-origin mesh)
                                 (froc-node-text (froc-emitter)))
                    (and (eq (froc-emit-mesh-transported? zero-emit) 0)
                         (eq (froc-ack-mesh-transported? zero-ack) 0)))))) 262144)
                (frocband-bit (and
                    (node_eq (froc-envelope-observation zero-e)
                             (frex-result-observation zero-result))
                    (and (node_eq (froc-ack-observation zero-ack)
                                  (frex-result-observation zero-result))
                    (and (eq (froc-ack-model-executed? zero-ack) 0)
                    (and (eq (frex-result-model-executed? zero-result) 0)
                         (node_eq (froc-received-observation
                                    (froc-ack-received zero-ack))
                                  (frex-result-observation zero-result)))))) 524288)
                (frocband-bit (do
                    (let wr (froc-emit-write-row zero-emit))
                    (if (and (str_eq (froc-channel-write-status wr) "written")
                        (and (eq (froc-channel-written wr)
                                 (froc-channel-expected wr))
                        (and (eq (file_size zero-path)
                                 (froc-channel-expected wr))
                             (eq (froc-channel-read-bytes zero-read)
                                 (froc-channel-expected wr))))) 1 0)) 1048576)
                (frocband-bit (and
                    (node_eq (froc-envelope-receiver zero-e) (froc-receiver))
                    (and (node_eq (froc-received-receiver
                                    (froc-ack-received zero-ack))
                                  (froc-receiver))
                    (and (node_eq (froc-lens-receiver zero-meaning)
                                  (froc-receiver))
                         (node_eq (froc-lens-receiver zero-vitality)
                                  (froc-receiver))))) 2097152)
                (frocband-bit (and
                    (not (node_eq (froc-ack-received failure-ack)
                                  (frex-absent-token)))
                    (and (node_eq (froc-received-observation
                                    (froc-ack-received failure-ack))
                                  (froc-ack-observation failure-ack))
                    (and (node_eq (froc-lens-observation
                                    (froc-ack-meaning failure-ack))
                                  (froc-ack-observation failure-ack))
                         (node_eq (froc-lens-observation
                                    (froc-ack-vitality failure-ack))
                                  (froc-ack-observation failure-ack))))) 4194304)
                (frocband-bit (and
                    (str_eq (froc-emit-status
                                (froc-cross-emit control-x)) "sent")
                    (and (str_eq (froc-ack-status control-ack) "failure")
                    (and (node_eq (froc-ack-observation control-ack)
                                  (frex-result-observation control-result))
                         (eq (froc-ack-transported? control-ack) 1)))) 8388608)))))

    (form-recipe-observation-cross-cell-band))
