; Expected 8191. Resource coverage and frontier completion, no host effects.
; witnessed: 2026-09-07 -> 8191, four kernels
; preludes: form-stdlib/bml/form-cli-heal-resources.bml
(defn fhrt-row (name path role ready) (fh-cat (list name "\t" path "\t" role "\t" ready)))
(do
    (let ready "artifact=1 native=1 seal=1 tokfast=1")
    (let q8 (fhrt-row "q8" "/q8" "answer review" ready))
    (let q4 (fhrt-row "q4" "/q4" "fast-answer review" ready))
    (let rows (list q8 "" q4 "0"))
    (let plan (fhr-plan rows))
    (let alias (fhr-plan (list q8 q4 (fhrt-row "alias" "/q8" "code" ready))))
    (let first "native-model-0-complete\tmodel=q8;result=0\n")
    (let both (str_concat first "native-model-1-complete\tmodel=q4;result=0\n"))
    (add (if (and (fhr-valid rows) (eq (len (fhr-eligible plan)) 2)) 1 0)
    (add (if (and (str_eq (head (head plan)) "q8") (str_eq (nth (nth plan 1) 3) "native-model-1")) 2 0)
    (add (if (and (eq (len (fhr-eligible alias)) 2) (str_eq (nth (nth alias 2) 2) "duplicate-artifact")) 4 0)
    (add (if (and (str_eq (fhr-readiness "artifact=0 native=0 seal=0 tokfast=0") "artifact-absent")
             (and (str_eq (fhr-readiness "artifact=1 native=0 seal=1 tokfast=1") "lane-unavailable")
             (and (str_eq (fhr-readiness "artifact=1 native=1 seal=0 tokfast=1") "seal-absent")
                  (str_eq (fhr-readiness "artifact=1 native=1 seal=1 tokfast=0") "tokenizer-index-absent")))) 8 0)
    (add (if (and (eq (fhr-token "artifact=10" "artifact=1") 0)
                 (eq (fhr-valid (list (fhrt-row "bad" "/bad" "answer" "artifact=1 native=1 native=0 seal=1 tokfast=1"))) 0)) 16 0)
    (add (if (and (eq (fhr-valid (list "0" "")) 0)
             (and (eq (fhr-valid (list q8 "broken inventory")) 0)
                  (eq (fhr-valid (list "legacy\t/path\tanswer\tartifact=1 seal=1")) 0))) 32 0)
    (add (if (eq (fhr-valid (list q8 (fhrt-row "q8" "/other" "answer" ready))) 0) 64 0)
    (add (if (eq (fhr-pending plan "") 2) 128 0)
    (add (if (eq (fhr-pending plan "native-model-0\texit=0\n") 2) 256 0)
    (add (if (and (eq (fhr-pending plan first) 1)
                 (eq (fhr-pending plan "native-model-0-complete\tmodel=q4;result=0\n") 2)) 512 0)
    (add (if (and (eq (fhr-pending plan both) 0)
                 (and (eq (fh-frontier "repair" (fhr-pending plan first) 1 1 0) 0)
                      (fh-frontier "repair" (fhr-pending plan both) 1 1 0))) 1024 0)
    (add (if (str_eq (fhr-model plan "q4") "q4") 2048 0)
         (if (and (fhr-repair-role "code")
                  (str_eq (fhr-reason (split-on (fhrt-row "speech" "/speech" "speech-stt" ready) "\t")) "role-not-repair")) 4096 0))))))))))))))
