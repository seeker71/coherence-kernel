; living-world-composite-recipe-answer-observation.fk -- one held-out answer.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk form-stdlib/living-world-operation-field.fk form-stdlib/living-world-composite-recipe.fk form-stdlib/living-world-composite-answer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-structural-recipe-witness.fk form-stdlib/tests/living-world-operation-field-witness.fk form-stdlib/tests/living-world-composite-recipe-witness.fk

(do
    (let evolved (lwoew-build-evolved))
    (let schema (lwoew-base-schema (lwoew-evolved-base evolved)))
    (let component (lwoew-evolved-candidate evolved))
    (let blueprint (lwoecw-blueprint component schema))
    (let blueprint-world (lwoecw-blueprint-world evolved))
    (let proposal (lwoec-proposal blueprint-world blueprint 2))
    (let candidate (lwt-proposal-candidate proposal))
    (let field (lwo-emergent-shape candidate))
    (let integrated
        (lwoec-integrate
            (lwphw-answered-round blueprint-world proposal
                (lwoew-evolved-round evolved))
            proposal (lwphw-action)))
    (let rich (lwoecw-rich-query candidate schema))
    (let minimal (lwoecw-minimal-query candidate schema))
    (let world
        (lwt-receive-stream (lwt-round-world integrated)
            (list (lwoecw-entry-s rich) (lwoecw-entry-t rich))))
    (let answer
        (lwoec-answer-for world rich 2 (intern_trivial_int 5)))
    (let expired-time
        (lwoec-answer-time rich (intern_trivial_int 10)))
    (let first-recipe
        (lwoec-surface-recipe
            (lwoec-profile-surface
                (nth (lwo-field-items
                    (lwoec-field-profiles field)) 0))))
    (let second-recipe
        (lwoec-surface-recipe
            (lwoec-profile-surface
                (nth (lwo-field-items
                    (lwoec-field-profiles field)) 1))))
    (list
        (lwoec-answer? answer)
        (lwo-field-size (lwoec-answer-evaluations answer))
        (lwo-field-size (lwoec-answer-outputs answer))
        (oac-one? (lwoec-answer-immediate-ack answer))
        (node_value (oac-payload (lwoec-answer-immediate-ack answer)))
        (oac-time-pending? (lwoec-answer-time-observation answer))
        (gt (lwo-field-size (lwoec-answer-alternatives answer)) 0)
        (gt (lwo-field-size (lwoec-answer-unknowns answer)) 0)
        (lwoec-query-valid? minimal)
        (lwo-field-size (lwoec-query-alternatives minimal))
        (node_eq (lwoec-query-unknown minimal) (lwo-none))
        (node_eq (lwoec-query-choice minimal) (lwo-none))
        (node_eq (lwoec-query-timeout minimal) (lwo-none))
        (oac-time-outcome? expired-time)
        (oac-alternative-ack? (oac-time-outcome-ack expired-time))
        (not (node_eq
                (lwoec-answer-time-observation answer) expired-time))
        (or
            (and (str_eq (lwre-recipe-source first-recipe)
                         "(add (add r s) s)")
                 (str_eq (lwre-recipe-source second-recipe)
                         "(add s (add s r))"))
            (and (str_eq (lwre-recipe-source first-recipe)
                         "(add s (add s r))")
                 (str_eq (lwre-recipe-source second-recipe)
                         "(add (add r s) s)")))
        (lwo-active? world first-recipe)
        (lwo-active? world second-recipe)))
