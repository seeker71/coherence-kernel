; glass-carried-frame-scope-band.bml — a bounded read builds its own frame, in its own body.
;
; PROOF LEVEL: FOURTH-ARM ONLY (body root, gift frames, live kernel pages)
; preludes: form-stdlib/form-glass-live.bml
;
; The lane was probed, not assumed (pf-arm-mask, 2026-09-10): host_cwd 8, node_gift_read 8,
; kernel_live 8, terminal_cols 8 — fkwu alone binds them; now_unix_ms answers 11, so Go and Rust
; carry the clock and TypeScript does not. A body root and a shared-memory frame are exactly what
; this band is about, so its home arm is the runtime, and the three proof walkers answer nothing
; rather than something wrong.
;
; The QUEUE row of observe/form-glass-flow-current-run.fk alternated on consecutive reads, and
; the sensor collision was only half of it. The other half: `glass.last.flow-point` was ONE
; machine-wide cell. Measured 2026-09-10 at shm /fg-467569cf — five reads from a bounded door in
; this worktree returned five different epochs 100–200 ms apart, carrying the queue value and the
; source string of the resident glass running in /Users/ursmuff/source/coherence-kernel. A door
; that starts nothing and writes nothing was painting a frame no process in its own body root had
; ever built, and the row gave a reader nothing to catch it on: `src=` named a live shm frame with
; an advancing sequence, because it WAS live — in another body.
;
; The carried cells are this glass's own frame: its last flow point, its cadence, its
; presentation, its pageins. They are body-local for the reason the ear's frame already was —
; another checkout is another glass, not a newer reading of this one.
;
; Scoping the cell exposed the second thing, which is why the regression is worth a bit of its
; own: the moment the borrowed point stopped arriving, ALL FOUR flow lanes went blank at once.
; The bounded doors had never built a reading of their own. They do now, from the rows they just
; read, and they still never write the cell — a probe that saved its point would stain the
; resident's carried frame with a reading taken at no cadence.
;
; Verdict 63 when every claim lands:
;   1    a carried cell's name carries the body root after an @
;   2    two body roots name two different cells — the collision, closed
;   4    the four carried names stay distinct inside one body
;   8    the same cell under two roots differs only after the @
;   16   the live door asks for exactly the name the scoped door builds, so give and take agree
;   32   a bounded read builds its OWN flow point: the history it hands the renderer ends in a v4
;        point stamped with the epoch of the read that produced it, not with a carried one

section [form.bml] {
    def gcfs-bit(ok, weight) = if ok then weight else 0;
    def gcfs-a() = "/Users/ursmuff/source/coherence-kernel";
    def gcfs-b() = "/Users/ursmuff/source/coherence-kernel/.claude/worktrees/lucid";
    def gcfs-score() {
        let flowA = fgl-last-name-in("flow-point", gcfs-a());
        let flowB = fgl-last-name-in("flow-point", gcfs-b());
        let cadenceA = fgl-last-name-in("cadence", gcfs-a());
        let presentA = fgl-last-name-in("presentation", gcfs-a());
        let pageinsA = fgl-last-name-in("host-pageins", gcfs-a());
        let data = fgl-inspection-snapshot();
        let history = nth(data, 4);
        let point = if eq(len(history), 0) then list() else nth(history, sub(len(history), 1));
        sum(list(
            gcfs-bit(str_eq(flowA, fgd-cat(list("glass.last.flow-point@", gcfs-a()))), 1),
            gcfs-bit(not(str_eq(flowA, flowB)), 2),
            gcfs-bit(and(not(str_eq(flowA, cadenceA)), and(not(str_eq(cadenceA, presentA)), not(str_eq(presentA, pageinsA)))), 4),
            gcfs-bit(and(eq(str_find(flowA, "glass.last.flow-point@", 0), 0), eq(str_find(flowB, "glass.last.flow-point@", 0), 0)), 8),
            gcfs-bit(str_eq(fgl-last-name("flow-point"), fgl-last-name-in("flow-point", host_cwd())), 16),
            gcfs-bit(and(gt(len(history), 0), and(str_eq(head(point), "glass-flow-point-v4"), eq(fgd-flow-value(point, 1), nth(data, 0)))), 32)
        ));
    }
    gcfs-score();
}
