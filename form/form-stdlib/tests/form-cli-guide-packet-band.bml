; form-cli-guide-packet-band.bml — the gate for the one light remote guide, read from rung rows with no model.
; preludes: form-stdlib/bml/form-cli-guide-packet.bml
; Verdict 16383
;
; Rung rows are written to a scratch ledger and read back through the carrier (fcgp-rows), as the review
; reads them. One recorded row is the walk checkout's own ledger row for closure-unit-line option 3, copied
; byte for byte: it carries no ladder fields, so every ladder reading over it must stay unknown, never 0.
;     1  five rungs from one approach to one outcome: swervecount 1, the guide is not earned
;     2  seven distinct failed swerves over four kinds and saturation, but one local guide: not earned
;     4  a second local guide, and the last two rungs repeat earlier outcomes: earned
;     8  a green rung: never earned
;    16  after a remote guide the counts start again and seen approaches stay seen; a resumed local guide
;        is not a fresh rung
;    32  rows with no digests (the recorded row): swervecount 0, never saturated
;    64  the packet carries every rung and the question, read back from disk; an unearned gap and an empty
;        question write nothing
;   128  admission: documents and writing tools are refused; feedback and a pointing enter with the id
;   256  guide-carried-code: a shared run longer than 64 bytes flags; 40 bytes and whitespace do not
;   512  columns over the recorded row: its IDs count, local_verified and the remote work tokens read null;
;        a gap no rung touched reads its remote work tokens null too
;  1024  a rung with no remote suggestion holds zero work tokens; a guided rung without a reading is null
;  2048  success counts verified, unverified and unread gaps apart; dependence names the strongest witness
;  4096  a session with no lane rows reads its remote work tokens null; its drafts come from the rent row
;  8192  guide and review rows written by fcgp-record read back into the columns: a carried guide's tokens
;        are work, the review stays in its own column
section [form.bml] {
 class GuidePacketBand {
  def gpb-claim(ok, bit) = if ok then bit else 0;
  def gpb-row(gap, rung, a, o, gen, green) = json-node-object(append(append([fhn-s("gap", gap), fhn-s("rung", rung)], if ((Comparable) len(a) == 0) then [] else [fhn-s("approach_digest", a)]), append(if ((Comparable) len(o) == 0) then [] else [fhn-s("outcome_digest", o)], [fhn-n("local_generated_ids", gen), fhn-n("local_injected_ids", 0), fhn-n("band_green", green)])));
  def gpb-with(row, pairs) = json-node-object(append(json-object-pairs(row), pairs));
  def gpb-text(rows) = foldl((acc, r) => mc-cat([acc, json-emit(r), "\n"]), "", rows);
  // written to the scratch ledger and read back through the carrier
  def gpb-carried(dir, name, rows) {
   let path = mc-cat([dir, "/", name, ".jsonl"]);
   let wrote = write_file_text(path, gpb-text(rows));
   fcgp-rows(path);
  }
  def gpb-recorded() = "{\"at_unix_ms\":1790848690473,\"gap\":\"closure-unit-line\",\"option\":3,\"band_before\":null,\"band_after\":null,\"full\":31,\"band_green\":0,\"dry\":0,\"test\":0,\"coordinated_by\":\"session\",\"coordinator\":\"/Users/ursmuff/Library/Application Support/Claude/claude-code/2.1.284/claude.app/Contents/MacOS/claude\",\"rented_mind\":1,\"request\":\".hearth/native-turns/closure-unit-line-1790841638464.json\",\"lane\":\"lane-exit=0\",\"lane_status\":\"attention\",\"lane_check_runs\":13,\"lane_turns\":72,\"published\":0,\"wall_ms\":7052008,\"checkpoint_id\":\"c936c6da79f602d2fb28661798fa6ca0756a22f019dd1d44cd4259208fa680b0-21393-1790834940728\",\"local_generated_ids\":8597,\"local_injected_ids\":12341,\"local_repairs\":28,\"rented_tokens\":null,\"usage_scope\":\"local coding counters; coordinator token usage requires its transcript\",\"source_conflict\":0}";
  def gpb-reading-num(reading, key) = fcgp-num(reading, key) ?? (0 - 1);
  def gpb-swerves() = [gpb-row("g", "attempt", "a1", "o1", 40, 0), gpb-row("g", "lens", "a2", "o2", 40, 0), gpb-row("g", "lens", "a3", "o3", 40, 0), gpb-row("g", "voice", "a4", "o4", 40, 0), gpb-row("g", "decode", "a5", "o5", 40, 0), gpb-row("g", "context", "a6", "o6", 40, 0), gpb-row("g", "local-guide", "a7", "o7", 40, 0), gpb-row("g", "lens", "a8", "o2", 40, 0), gpb-row("g", "lens", "a9", "o3", 40, 0)];
  def gpb-earned() = append(gpb-swerves(), [gpb-row("g", "local-guide", "a10", "o4", 40, 0), gpb-row("g", "lens", "a11", "o5", 40, 0)]);
  def gpb-score(dir) {
   let one = gpb-carried(dir, "one", [gpb-row("g", "attempt", "a1", "o1", 40, 0), gpb-row("g", "attempt", "a1", "o1", 40, 0), gpb-row("g", "attempt", "a1", "o1", 40, 0), gpb-row("g", "attempt", "a1", "o1", 40, 0), gpb-row("g", "attempt", "a1", "o1", 40, 0)]);
   let rOne = fcgp-reading(one);
   let c1 = gpb-claim(((Comparable) fcgp-swervecount(one) == 1) && (!fcgp-earned?(one)) && ((Comparable) gpb-reading-num(rOne, "earned") == 0), 1);
   let swerves = gpb-carried(dir, "swerves", gpb-swerves());
   let rSw = fcgp-reading(swerves);
   let c2 = gpb-claim(((Comparable) gpb-reading-num(rSw, "swervecount") == 7) && ((Comparable) len(json-array-elements(json-object-get(rSw, "swerve_kinds"))) == 4) && ((Comparable) gpb-reading-num(rSw, "saturated") == 1) && ((String) fcgp-str(rSw, "why") == "1 local guide(s) of 2") && (!fcgp-earned?(swerves)), 2);
   let earned = gpb-carried(dir, "earned", gpb-earned());
   let rE = fcgp-reading(earned);
   let c3 = gpb-claim(fcgp-earned?(earned) && ((Comparable) gpb-reading-num(rE, "local_guides") == 2) && ((Comparable) gpb-reading-num(rE, "saturated") == 1) && ((String) fcgp-str(rE, "why") == "earned"), 4);
   let green = gpb-carried(dir, "green", append(gpb-earned(), [gpb-row("g", "lens", "a12", "o12", 40, 1)]));
   let c4 = gpb-claim((!fcgp-earned?(green)) && ((String) fcgp-str(fcgp-reading(green), "why") == "the gap reads green: the local path carried it"), 8);
   let after = gpb-carried(dir, "after", append(gpb-earned(), [gpb-row("g", "remote-guide", "a12", "o12", 0, 0), gpb-row("g", "lens", "a13", "o13", 40, 0), gpb-row("g", "lens", "a1", "o14", 40, 0)]));
   let resumed = gpb-carried(dir, "resumed", [gpb-with(gpb-row("g", "local-guide", "a1", "o1", 40, 0), [json-node-pair("approach", json-node-object([json-node-pair("resume", json-node-bool(true))]))])]);
   let c5 = gpb-claim(((Comparable) fcgp-swervecount(after) == 1) && (!fcgp-earned?(after)) && ((Comparable) gpb-reading-num(fcgp-reading(resumed), "local_guides") == 0), 16);
   let old = fcgp-rows-of(mc-cat([gpb-recorded(), "\n", gpb-recorded(), "\n"]));
   let rOld = fcgp-reading(old);
   let c6 = gpb-claim(((Comparable) len(old) == 2) && ((Comparable) gpb-reading-num(rOld, "swervecount") == 0) && ((Comparable) gpb-reading-num(rOld, "saturated") == 0), 32);
   let gap = parse-json("gap", "{\"id\":\"g\",\"goal\":\"add cl-unit-at\",\"checks\":[{\"tool\":\"tail\",\"arguments\":[\"-c\",\"8\",\"x.fk\"],\"stdout\":\"0)\\n\"}]}");
   let packet = fcgp-packet-at(dir, gap, earned, "Which invariant of the band do the rungs keep missing?", 7);
   let back = if ((Comparable) len(packet[0]) == 0) then json-node-object([]) else parse-json("packet", fhn-read(packet[0]));
   let unearned = fcgp-packet-at(dir, gap, swerves, "a question", 8);
   let mute = fcgp-packet-at(dir, gap, earned, "  ", 9);
   let c7 = gpb-claim(((String) packet[0] == mc-cat([dir, "/g-7.json"])) && ((Comparable) len(json-array-elements(json-object-get(back, "rungs"))) == len(earned)) && ((String) fcgp-str(back, "question") == "Which invariant of the band do the rungs keep missing?") && ((String) fcgp-str(back, "schema") == "form-guide-packet-v1") && ((Comparable) len(unearned[0]) == 0) && ((Comparable) file_size(mc-cat([dir, "/g-8.json"])) < 1) && ((Comparable) len(mute[0]) == 0) && ((String) fcgp-str(mute[1], "why") == "one question is required"), 64);
   let docs = fcgp-admit("{\"documents\":[{\"path\":\"x.fk\",\"text\":\"(defn f () 0)\"}]}", "g-1");
   let tool = fcgp-admit("{\"tool\":\"edit\",\"arguments\":[\"x.fk\",\"a\",\"b\"]}", "g-1");
   let plain = fcgp-admit("Read the band's fourth claim before the next edit.", "g-1");
   let point = fcgp-admit("{\"pointing\":\"the base case of cl-walk\"}", "g-2");
   let empty = fcgp-admit("   ", "g-3");
   let c8 = gpb-claim(((String) fcgp-str(docs, "reason") == "guide-carried-documents") && node_eq(json-object-get(docs, "feedback"), json-node-null()) && ((String) fcgp-str(tool, "status") == "refused") && ((String) fcgp-str(plain, "kind") == "feedback") && ((String) fcgp-str(fcgp-obj(plain, "feedback"), "id") == "g-1") && ((String) fcgp-str(fcgp-obj(plain, "feedback"), "text") == "Read the band's fourth claim before the next edit.") && ((String) fcgp-str(point, "kind") == "pointing") && ((String) fcgp-str(fcgp-obj(point, "feedback"), "text") == "the base case of cl-walk") && ((String) fcgp-str(empty, "reason") == "guide-answer-empty"), 128);
   let line = "(defn cl-walk (s at line want unit start) (if (ge at (str_len s)) (nothing) 0))";
   let diff = mc-cat(["--- form/x.fk\n+++ b/form/x.fk\n@@ -3,1 +3,2 @@\n (do\n+", line, "\n"]);
   let blank = "                                                                                ";
   let c9 = gpb-claim(fcgp-carried?(mc-cat(["Write this: ", line]), diff) && (!fcgp-carried?(substring(line, 0, 40), diff)) && (!fcgp-carried?(mc-cat(["x", blank, "y"]), mc-cat(["@@ -1,1 +1,1 @@\n+", blank, "\n"]))) && (!fcgp-carried?("+++ b/form/x.fk", "+++ b/form/x.fk\n")), 256);
   let cOld = fcgp-gap-columns(old, [], []);
   let emitted = json-emit(cOld);
   let c10 = gpb-claim(((Comparable) gpb-reading-num(cOld, "local_generated_ids") == 17194) && ((Comparable) gpb-reading-num(cOld, "local_injected_ids") == 24682) && nothing?(fcgp-num(cOld, "local_verified")) && nothing?(fcgp-num(cOld, "required_remote_tokens")) && (str_find(emitted, "\"required_remote_tokens\":null", 0) >= 0) && (str_find(emitted, "\"local_verified\":null", 0) >= 0) && ((Comparable) gpb-reading-num(cOld, "remote_guide_tokens") == 0) && ((Comparable) gpb-reading-num(cOld, "remote_review_tokens") == 0) && ((String) fcgp-str(cOld, "remote_dependence") == "") && nothing?(fcgp-num(fcgp-gap-columns([], [], []), "required_remote_tokens")), 512);
   let none = gpb-carried(dir, "none", [gpb-with(gpb-row("h", "lens", "b1", "p1", 30, 0), [fhn-s("remote_dependence", "none")]), gpb-with(gpb-row("h", "voice", "b2", "p2", 30, 1), [fhn-s("remote_dependence", "none"), fhn-n("local_verified", 1)])]);
   let guided = gpb-carried(dir, "guided", [gpb-with(gpb-row("h", "remote-guide", "b3", "p3", 0, 0), [fhn-s("remote_dependence", "required-guide")])]);
   let c11 = gpb-claim(((Comparable) gpb-reading-num(fcgp-gap-columns(none, [], []), "required_remote_tokens") == 0) && ((Comparable) gpb-reading-num(fcgp-gap-columns(none, [], []), "local_verified") == 1) && nothing?(fcgp-num(fcgp-gap-columns(append(none, guided), [], []), "required_remote_tokens")) && ((Comparable) gpb-reading-num(fcgp-gap-columns(guided, [], []), "remote_guide_prompts") == 1), 1024);
   let mixed = gpb-carried(dir, "mixed", [gpb-with(gpb-row("g1", "lens", "c1", "q1", 10, 1), [fhn-n("local_verified", 1)]), gpb-with(gpb-row("g2", "lens", "c2", "q2", 10, 0), [fhn-n("local_verified", 0)]), gpb-row("g3", "lens", "c3", "q3", 10, 0), gpb-row("g1", "lens", "c4", "q4", 10, 0)]);
   let s = fcgp-success(mixed);
   let carriedGuide = parse-json("guide", "{\"gap\":\"h\",\"guide_carried_code\":1,\"prompt_tokens\":100,\"output_tokens\":50}");
   let plainGuide = parse-json("guide", "{\"gap\":\"h\",\"guide_carried_code\":0}");
   let review = parse-json("review", "{\"gap\":\"h\",\"verdict\":\"accept\"}");
   let c12 = gpb-claim(((Comparable) s[0] == 3) && ((Comparable) s[1] == 1) && ((Comparable) s[2] == 1) && ((String) fcgp-dependence(none, [carriedGuide], []) == "required-work") && ((String) fcgp-dependence([], [plainGuide], []) == "required-guide") && ((String) fcgp-dependence([], [], [review]) == "optional-review") && ((String) fcgp-dependence(none, [], []) == "none") && ((String) fcgp-dependence(old, [], []) == ""), 2048);
   let rent = parse-json("rent", "{\"session\":\"s1\",\"rented\":{\"output\":5},\"local\":{\"drafts\":6,\"generated\":2239}}");
   let sc = fcgp-session-columns("s1", rent, [], [], []);
   let c13 = gpb-claim(nothing?(fcgp-num(sc, "required_remote_tokens")) && (str_find(json-emit(sc), "\"required_remote_tokens\":null", 0) >= 0) && ((Comparable) gpb-reading-num(sc, "draft_generated_ids") == 2239) && ((Comparable) gpb-reading-num(sc, "lane_options") == 0), 4096);
   let guidePath = mc-cat([dir, "/remote-guide-ledger.jsonl"]);
   let reviewPath = mc-cat([dir, "/remote-review.jsonl"]);
   let g1 = fcgp-record(guidePath, fcgp-guide-row("h", "s1", "h-7.json", plain, true, 100, 50));
   let v1 = fcgp-record(reviewPath, fcgp-review-row("h", 1, "s1", "claude", "accept", nothing()));
   let guides = fcgp-rows(guidePath);
   let reviews = fcgp-rows(reviewPath);
   let cg = fcgp-gap-columns(none, guides, reviews);
   let c14 = gpb-claim(((String) g1 == "appended") && ((String) v1 == "appended") && ((Comparable) gpb-reading-num(cg, "remote_guide_prompts") == 1) && ((Comparable) gpb-reading-num(cg, "remote_guide_tokens") == 150) && ((Comparable) gpb-reading-num(cg, "required_remote_tokens") == 150) && ((Comparable) gpb-reading-num(cg, "remote_review_rows") == 1) && nothing?(fcgp-num(cg, "remote_review_tokens")) && ((Comparable) gpb-reading-num(cg, "remote_review_accept") == 1) && ((String) fcgp-str(cg, "remote_dependence") == "required-work"), 8192);
   print_str(mc-cat(["guide-packet-band claims ", c1.str(), " ", c2.str(), " ", c3.str(), " ", c4.str(), " ", c5.str(), " ", c6.str(), " ", c7.str(), " ", c8.str(), " ", c9.str(), " ", c10.str(), " ", c11.str(), " ", c12.str(), " ", c13.str(), " ", c14.str()]));
   c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13 + c14;
  }
  def gpb-run() {
   let dir = mc-cat([temp_dir(), "/fcgp-band-", host_pid().str(), "-", now_unix_ms().str()]);
   let made = fs_mkdir(dir);
   let score = gpb-score(dir);
   let gone = fs_rmdir(dir);
   score;
  }
 }
 gpb-run();
}
