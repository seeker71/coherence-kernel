; glass-vitals-saturation-settle-band.bml — a state that flips at every read is not a state.
;
; preludes: form-stdlib/form-glass-vitals.bml
;
; 2026-09-10's receipt left rcf-settle proven and unwired, and said the settle door was there when
; a glass reading was found hovering. One was. Every glass current-frame door was read repeatedly
; and diffed; the vitals lane's saturation word was the only reading whose word moved while
; nothing under it did.
;
; Measured over 150 one-second reads of the published vitals frame: 203 changes of the saturation
; word. Eight were a hover — `./fkwu observe/form-cli-heal-eval-case.bml` sitting at nine tenths
; of a core, its word flipping between saturated and labouring while its rate moved by 6, 9, 14,
; 16, 22, 23, 25 and 27 microseconds per millisecond around a line at 937. The other 195 were real
; crossings, a kernel going from nothing to seven or twenty thousand, and a reading with memory
; lets those through untouched. That is what separates hysteresis from smoothing.
;
; The second line is not a number anyone chose either. It is the same sixteenth of a core the
; entering allowance already spends, spent once more on the way out: fourteen sixteenths, 875. The
; band between the lines is 62 and the widest hover witnessed was 27, so every measured flicker is
; damped with room over.
;
; The memory is a ninth cell on a record that already carried eight. A record that has never said
; a word has none, and reads exactly as this door read before it had any memory at all — which is
; why form-glass-vitals-band.fk still answers 1023 over its seven-field fixtures.
;
; Verdict 2047 when every claim lands:
;   1     two lines: entering at fifteen sixteenths of a core, holding at fourteen, one sixteenth apart
;   2     a record with no memory enters exactly where this door always entered: at the line, not below it
;   4     a record that already said saturated is held by the LOWER line
;   8     and loses the word one microsecond-per-millisecond below it
;   16    the lower line never ADMITS: the same rate that holds saturation cannot enter it
;   32    all eight rates witnessed hovering hold their word instead of flipping
;   64    a real crossing still falls through in one reading, in both directions
;   128   the band is wider than the widest hover witnessed, so the memory has margin
;   256   remembering appends the word and disturbs none of the seven fields already carried
;   512   a fresh record has no memory and says the plain word about itself
;   1024  a finding reports the line IN FORCE, so a reader who sees the word sees what would lose it

section [form.bml] {
    def gvss-bit(ok, weight) = if ok then weight else 0;
    // a kernel with a taught rhythm, at one measured rate
    def gvss-at(rate) = fgv-effort(1, 0, 0, 3, 100, 900, rate);
    def gvss-held(rate) = fgv-effort-remember("saturated", gvss-at(rate));
    def gvss-holds?(rates) = if eq(len(rates), 0) then 1 else if not(str_eq(fgv-effort-state(gvss-held(head(rates))), "saturated")) then 0 else gvss-holds?(tail(rates));
    def gvss-score() {
        let hovers = list(910, 923, 928, 931, 934, 936);
        let entering900 = gvss-at(900);
        let held900 = gvss-held(900);
        let fresh = fgv-effort-fresh(9, 100, 5);
        sum(list(
            gvss-bit(and(eq(fgv-saturation(), 937), and(eq(fgv-release(), 875), eq(sub(fgv-saturation(), fgv-release()), 62))), 1),
            gvss-bit(and(str_eq(fgv-effort-state(gvss-at(937)), "saturated"), str_eq(fgv-effort-state(gvss-at(936)), "labouring")), 2),
            gvss-bit(str_eq(fgv-effort-state(held900), "saturated"), 4),
            gvss-bit(str_eq(fgv-effort-state(gvss-held(874)), "labouring"), 8),
            gvss-bit(str_eq(fgv-effort-state(entering900), "labouring"), 16),
            gvss-bit(eq(gvss-holds?(hovers), 1), 32),
            gvss-bit(and(str_eq(fgv-effort-state(gvss-held(0)), "labouring"), str_eq(fgv-effort-state(gvss-at(7873)), "saturated")), 64),
            gvss-bit(gt(sub(fgv-saturation(), fgv-release()), 27), 128),
            gvss-bit(and(eq(len(held900), 9), and(eq(len(entering900), 8), and(eq(fgv-effort-latest(held900), 900), and(eq(fgv-effort-busiest(held900), 900), and(eq(fgv-effort-calmest(held900), 100), and(eq(fgv-effort-samples(held900), 3), eq(fgv-effort-pid(held900), 1))))))), 256),
            gvss-bit(and(eq(str_len(fgv-effort-word(fresh)), 0), str_eq(fgv-effort-state(fresh), "unlearned")), 512),
            gvss-bit(and(eq(fgv-finding-bound(fgv-effort-finding(held900)), 875), eq(fgv-finding-bound(fgv-effort-finding(entering900)), 937)), 1024)
        ));
    }
    gvss-score();
}
