; host-walk-learn-band.bml — the walk's learning steps (form-stdlib/bml/host-walk-learn.bml): the reading, the rows, the lift, the exit proof and the register, wired after the drafts and page.
; No model opens: small stub doors written under temp_dir stand in for each child, and they begin through the same host-child door as the real ones.
;
; Verdict 511 when every claim lands:
;   1   order: in observe/scheduled-walk.bml each step stands after the page and before the movement, in the order drafts, page, reading,
;       rows, lift, rent, proof, gaps, steer, movement; in observe/day-turn.bml after the turns, in the order reading, rows, lift, rent, proof, gaps, steer, and the landing of what they wrote
;   2   request: the reading's stub reads its stdin and hears {"count":<most>,"until_ms":<the window's end less the lift's room>}; the lift's
;       stub hears rows native, valid_source of-record, cadence 8, negatives, until_ms the window's end; the rows' two stubs hear nothing,
;       then readers native-voice; the needles keep the door's reading lines and leave its stream
;   4   exit: a stub that ends in an error reads its exit named, with what it said kept; a door that printed none of its lines reads its exit 0 and where its output stands
;   8   refused: a door that does not stand is refused by name for each of reading, rows, lift, proof and gaps, no child is begun and no out file is written
;   16  deadline: a reading and a lift past their deadline are each stopped: the deadline reaching the child is the window's end plus hw-backstop-ms (a stub
;       whose window ended hw-backstop-ms less 5 s ago is stopped about 5 s after it begins, time for its first line on a loaded machine, and the line names the deadline)
;   32  paths: hw-paths carries the receipts the learning steps wrote: a learned path that stands, and none that does not, and never a row file holding the person's words (hw-words; a list that lands one, the plant, fails), and git tracks none of those files; the two model doors of these steps stand among
;       hw-walk-doors, so another checkout's turn waits for them
;   64  plants: a tail that keeps the value a door ends on, a refusal that begins the child anyway, a skip list without "reading" each fail the checks the real ones keep
;   128 lift-27b: no 27B lift unless a door stands, this walk's 3B lift read better 1, the time left holds it and the governor grants it, each named on the line and no
;       child begun; when all hold the rows, the trainer (hearing wall_s, the time left less the judge's) and the judge (hearing the child) begin in that order, a
;       trainer that ends in an error begins no judge; a gate blind to the 3B's word, one blind to the time and one blind to the governor (plants) each fail
;   256 carried: hw-learned names the local-run and coverage ledgers, the rent meter, the offers and the heal's rows, none of them a file of words (a list missing one, the plant, fails); the day's landing of its
;       receipts stands whether a turn landed or not; the rent and steer doors refuse by name and speak their line; a heal row counts what returned and what would not
;
; REQUIRES: the built ./fkwu and the body root as the working directory (the stub doors run as children of ./fkwu).
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/host-walk.bml
section [form.bml] {
 class HostWalkLearnBand {
  def hlb-fresh() {
   let root = temp_dir() ++ "/host-walk-learn-band-" ++ now_unix_ms().str();
   (Comparable) host_dir_mkdir(root) == 1 ? ["learn", root, 0] : nothing();
  }
  def hlb-root(ctx) = ctx[1];
  def hlb-has(s, part) = str_find(s, part, 0) >= 0;
  def hlb-io(ctx) = hlb-root(ctx) ++ "/io";
  def hlb-far() = host_monotonic_ms() + 7200000;
  // a stub door: prints its stdin back after a mark, then the lines it is given, then the value 0 it ends on as a real door does
  def hlb-stub(ctx, name, body) {
   let path = hlb-root(ctx) ++ "/" ++ name ++ ".bml";
   let w = write_file_text(path, "// preludes: form-stdlib/core.fk form-stdlib/bml/stdin-source.bml\nsection [form.bml] {\n " ++ body ++ "\n}\n");
   path;
  }
  def hlb-printer(ctx, name, lines) = hlb-stub(ctx, name, "let t = stdin-text();\n print_str(\"[stub] stdin=\" ++ t);\n" ++ str-join(map(l => " print_str(\"" ++ l ++ "\");\n", lines)) ++ " 0;");
  def hlb-in(ctx, step) = read_file(hlb-io(ctx) ++ "/" ++ step ++ ".in") ?? "";
  def hlb-pos(source, needle) = str_find(source, needle, 0);
  def hlb-rising?(xs) = nil?(xs) || nil?(xs[1:]) ? true : (xs[0] >= 0) && (xs[0] < xs[1]) && hlb-rising?(xs[1:]);
  def hlb-guard(step) = "hw-safe-skips?(safe, \"" ++ step ++ "\")";
  // ---- 1 order
  def hlb-c-order(ctx) {
   let night = read_file("observe/scheduled-walk.bml") ?? "";
   let day = read_file("observe/day-turn.bml") ?? "";
   hlb-rising?(map(s => hlb-pos(night, hlb-guard(s)), ["turns", "drafts", "page", "reading", "rows", "lift", "rent", "proof", "gaps", "steer", "movement"]))
   && hlb-rising?(map(s => hlb-pos(day, hlb-guard(s)), ["turns", "reading", "rows", "lift", "rent", "proof", "gaps", "steer", "movement"]))
   && hlb-has(night, "hw-reading(until)") && hlb-has(night, "hw-lift(until)") && hlb-has(night, "hw-lift-27b(until, lifted)") && hlb-has(day, "hw-reading(until)") && hlb-has(day, "hw-lift-27b(until, lifted)") && hlb-has(day, "dt-learned-request(day");
  }
  // ---- 2 request
  def hlb-c-request(ctx) {
   let until = hlb-far();
   let reading = hw-reading-at(hlb-io(ctx), hlb-printer(ctx, "reading", ["[native-reading] a stream line", "[native-reading] voice qwen38-q8: [memory] granted", "[native-reading] read 2 of 9 pending: accepted 1"]), until);
   let heard = parse-json("reading", hlb-in(ctx, "reading"));
   let lift = hw-lift-at(hlb-io(ctx), hlb-printer(ctx, "lift", ["[lift] rows x holds 3", "[lift] cadence: x holds 3 rows, 3 beyond the last lift of 0; a lift begins at 8 new rows: no model opened"]), until);
   let hl = parse-json("lift", hlb-in(ctx, "lift"));
   let rows = hw-rows-at(hlb-io(ctx), hlb-printer(ctx, "rows", ["{\\\"rows_written\\\":4}"]));
   (Comparable) fhn-count(heard, "until_ms") == until - hw-lift-room-ms() && (Comparable) fhn-count(heard, "count") == hw-read-most() && (Comparable) fhn-count(heard, "newest") == 1
   && !hlb-has(reading, "a stream line") && hlb-has(reading, "[native-reading] voice qwen38-q8") && hlb-has(reading, "[native-reading] read 2 of 9 pending")
   && (String) fhn-text(hl, "rows") == "learn/draft-readings-native.jsonl" && (String) fhn-text(hl, "valid_source") == "learn/draft-readings.jsonl" && (Comparable) fhn-count(hl, "cadence") == 8 && (String) fhn-text(hl, "negatives") == "learn/draft-readings-heldout.jsonl" && (Comparable) fhn-count(hl, "until_ms") == until
   && hlb-has(lift, "[lift] cadence: x holds 3 rows") && !hlb-has(lift, "[lift] rows x holds")
   && (String) hlb-in(ctx, "rows-record") == "" && hlb-has(hlb-in(ctx, "rows-native"), "\"readers\":[\"native-voice\"]") && hlb-has(rows, "[rows] of-record {\"rows_written\":4}") && hlb-has(rows, "[rows] native-voice {\"rows_written\":4}");
  }
  // ---- 4 exit
  def hlb-c-exit(ctx) {
   let dying = hlb-stub(ctx, "dying", "print_str(\"[native-reading] read 0 of 1 pending\");\n form_error(\"stub ends\");");
   let quiet = hlb-stub(ctx, "quiet", "print_str(\"nothing it reads\");\n 0;");
   let dead = hw-reading-at(hlb-io(ctx), dying, hlb-far());
   let said = hw-reading-at(hlb-io(ctx), quiet, hlb-far());
   hlb-has(dead, "[native-reading] read 0 of 1 pending") && hlb-has(dead, "[reading] exit 1") && hlb-has(dead, "reading.out") && hlb-has(said, "[reading] exit 0") && !hlb-has(said, "nothing it reads");
  }
  // ---- 8 refused
  def hlb-refused(line, step, door) = hlb-has(line, "[" ++ step ++ "] refused: " ++ door ++ " does not stand in this checkout; no child was begun");
  def hlb-c-refused(ctx) {
   let io = hlb-root(ctx) ++ "/io-none";
   let none = hlb-root(ctx) ++ "/no-such-door.bml";
   hlb-refused(hw-reading-at(io, none, hlb-far()), "reading", none) && hlb-refused(hw-rows-at(io, none), "rows-record", none) && hlb-refused(hw-rows-at(io, none), "rows-native", none) && hlb-refused(hw-lift-at(io, none, hlb-far()), "lift", none) && hlb-refused(hw-proof-at(io, none), "proof", none) && hlb-refused(hw-gaps-at(io, none), "gaps", none)
   && (Comparable) host_path_exists(io ++ "/reading.out") == 0 && (Comparable) host_path_exists(io ++ "/lift.out") == 0;
  }
  // ---- 16 deadline
  def hlb-c-deadline(ctx) {
   let hung = hlb-stub(ctx, "hung", "print_str(\"[native-reading] voice q: began\");\n host_sleep_ms(30000);\n 0;");
   let began = host_monotonic_ms();
   let line = hw-reading-at(hlb-io(ctx), hung, began + 5000 - hw-backstop-ms());
   let wall = host_monotonic_ms() - began;
   let hungLift = hlb-stub(ctx, "hung-lift", "print_str(\"[lift] window: began\");\n host_sleep_ms(30000);\n 0;");
   let beganLift = host_monotonic_ms();
   let lifted = hw-lift-at(hlb-io(ctx), hungLift, beganLift + 5000 - hw-backstop-ms());
   let wallLift = host_monotonic_ms() - beganLift;
   (wall < 20000) && hlb-has(line, "[native-reading] voice q: began") && hlb-has(line, "deadline: the child ran past its deadline")
   && (wallLift < 20000) && hlb-has(lifted, "[lift] window: began") && hlb-has(lifted, "deadline: the child ran past its deadline");
  }
  // ---- 32 paths
  def hlb-strings(nodes) = map(n => json-string-value(n), nodes);
  def hlb-no-words?(paths) = !any?(w => any?(q => (String) q == w, paths), hw-words());
  def hlb-c-paths(ctx) {
   let paths = hlb-strings(hw-paths());
   let standing = filter(p => (Comparable) host_path_exists(p) == 1, hw-learned());
   (String) hch-read(append(["git", "ls-files", "--"], hw-words())) == "" && !nil?(standing) && hlb-no-words?(paths) && !hlb-no-words?(append(paths, [hw-words()[0]])) && all?(p => any?(q => (String) q == p, paths), standing) && all?(p => (Comparable) host_path_exists(p) == 1 || !any?(q => (String) q == p, paths), hw-learned())
   && any?(d => (String) d == hw-reading-door(), hw-walk-doors()) && any?(d => (String) d == hw-lift-door(), hw-walk-doors());
  }
  // ---- 64 plants: the checks as functions over the thing they check, each failing over its plant
  def hlb-tail-holds?(read, ctx) {
   let out = hch-run-in(hlb-io(ctx), "tail", ["./fkwu", hlb-printer(ctx, "tail", ["[offline-voice-gaps] 12 closed, 3 open"])], "", hlb-far());
   hlb-has(read("gaps", out), "[offline-voice-gaps] 12 closed") && !((String) read("gaps", out) == "0");
  }
  def hlb-plant-tail(step, run) = hch-tail-line(run[1]);
  def hlb-door-holds?(door, ctx) {
   let io = hlb-root(ctx) ++ "/io-plant";
   let none = hlb-root(ctx) ++ "/no-door-either.bml";
   hlb-has(door(io, "x", none, "", hlb-far(), run => "ran"), "refused") && (Comparable) host_path_exists(io ++ "/x.exit") == 0;
  }
  def hlb-plant-door(io, step, door, input, until, read) = read(hch-run-in(io, step, ["./fkwu", door], input, until));
  def hlb-skips-hold?(skips) = all?(s => skips(true, s), ["reading", "rows", "lift", "proof", "gaps"]);
  def hlb-plant-skips(safe, step) = safe && any?(s => (String) s == step, ["turns", "drafts", "page", "rows", "lift", "proof", "gaps", "movement"]);
  def hlb-c-plants(ctx) = hlb-tail-holds?(hw-learn-tail, ctx) && !hlb-tail-holds?(hlb-plant-tail, ctx)
   && hlb-door-holds?(hw-learn-door, ctx) && !hlb-door-holds?(hlb-plant-door, ctx)
   && hlb-skips-hold?(hw-safe-skips?) && !hlb-skips-hold?(hlb-plant-skips);
  // ---- 128 the 27B's gate
  def hlb-better() = "[lift] judged on x: better 1 parent_loss_milli 2 child_loss_milli 1";
  def hlb-worse() = "[lift] judged on x: better 0 parent_loss_milli 1 child_loss_milli 2";
  def hlb-grant(need) = [1, "room", 1, 1, 1];
  def hlb-refuse(need) = [0, "capacity", 1, 1, 1];
  def hlb-gate-holds?(why, doors) {
   let far = hw-lift-27b-floor-ms();
   (String) why(hlb-better(), far, doors, hlb-grant) == ""
   && hlb-has(why(hlb-worse(), far, doors, hlb-grant), "did not read better 1") && hlb-has(why("[lift] cadence: a lift begins at 8", far, doors, hlb-grant), "did not read better 1")
   && hlb-has(why(hlb-better(), far - 1, doors, hlb-grant), "cannot hold")
   && hlb-has(why(hlb-better(), far, doors, hlb-refuse), "held by the memory governor")
   && hlb-has(why(hlb-better(), far, ["/no/such/door.bml"], hlb-grant), "does not stand");
  }
  def hlb-plant-blind-3b(lifted, left, doors, ask) = hw-lift-27b-why(hlb-better(), left, doors, ask);
  def hlb-plant-blind-time(lifted, left, doors, ask) = hw-lift-27b-why(lifted, hw-lift-27b-floor-ms(), doors, ask);
  def hlb-plant-blind-room(lifted, left, doors, ask) = hw-lift-27b-why(lifted, left, doors, hlb-grant);
  def hlb-c-lift-27b(ctx) {
   let rows = hlb-printer(ctx, "rows27", ["[27b-rows] 44 rows"]);
   let train = hlb-printer(ctx, "train27", ["[27b-train] exported"]);
   let judge = hlb-printer(ctx, "judge27", ["[27b-judge] better 1"]);
   let dying = hlb-stub(ctx, "dying27", "print_str(\"[27b-train] stopped\");\n form_error(\"stub ends\");");
   let io = hlb-root(ctx) ++ "/io-27b";
   let doors = [rows, train, judge];
   let until = host_monotonic_ms() + 7200000;
   let line = hw-lift-27b-at(io, doors, until, hlb-better(), hlb-grant);
   let heard = parse-json("train", read_file(io ++ "/lift-27b-train.in") ?? "{}");
   let heardJudge = parse-json("judge", read_file(io ++ "/lift-27b-judge.in") ?? "{}");
   let io2 = hlb-root(ctx) ++ "/io-27b-2";
   let dead = hw-lift-27b-at(io2, [rows, dying, judge], until, hlb-better(), hlb-grant);
   let io3 = hlb-root(ctx) ++ "/io-27b-3";
   let held = hw-lift-27b-at(io3, doors, until, hlb-worse(), hlb-grant);
   hlb-gate-holds?(hw-lift-27b-why, doors) && !hlb-gate-holds?(hlb-plant-blind-3b, doors) && !hlb-gate-holds?(hlb-plant-blind-time, doors) && !hlb-gate-holds?(hlb-plant-blind-room, doors)
   && hlb-has(line, "[27b-rows] 44 rows") && hlb-has(line, "[27b-train] exported") && hlb-has(line, "[27b-judge] better 1")
   && (str_find(line, "[27b-rows]", 0) < str_find(line, "[27b-train]", 0)) && (str_find(line, "[27b-train]", 0) < str_find(line, "[27b-judge]", 0))
   && fhn-count(heard, "wall_s") > 3000 && fhn-count(heard, "wall_s") <= (7200000 - hw-lift-27b-judge-ms()) / 1000 && (String) fhn-text(heard, "out") == hw-lift-27b-out() && (String) fhn-text(heardJudge, "child") == hw-lift-27b-out()
   && hlb-has(dead, "[27b-train] stopped") && hlb-has(dead, "[lift-27b-train] exit 1") && (Comparable) host_path_exists(io2 ++ "/lift-27b-judge.out") == 0
   && hlb-has(held, "[lift-27b] not this walk: this walk's 3B lift did not read better 1") && (Comparable) host_path_exists(io3 ++ "/lift-27b-rows.out") == 0;
  }
  // ---- 256 carried
  def hlb-carried-names() = ["receipts/local-run-ledger.jsonl", "receipts/query-coverage-ledger.jsonl", "receipts/session-rent-ledger.jsonl", "receipts/self-steer-ledger.jsonl", "receipts/walk-heal-ledger.jsonl"];
  def hlb-carries?(learned) = all?(p => any?(q => (String) q == p, learned), hlb-carried-names()) && !any?(w => any?(q => (String) q == w, learned), hw-words());
  def hlb-c-carried(ctx) {
   let day = read_file("observe/day-turn.bml") ?? "";
   let io = hlb-root(ctx) ++ "/io-carried";
   let none = hlb-root(ctx) ++ "/no-door.bml";
   let rent = hw-rent-at(io, hlb-printer(ctx, "rent", ["[session-rent] this session s; measured 1, kept 2, refused 0", "         day sessions"]));
   let steer = hw-steer-at(io, hlb-printer(ctx, "steer", ["[self-steer] 1 of 2 open row(s) offered"]));
   let healRows = hlb-root(ctx) ++ "/heal.jsonl";
   let healLine = hw-heal-noted-at(healRows, [1, ["a conflict"]]);
   let healRow = parse-json("heal", trim(read_file(healRows) ?? "{}"));
   hlb-carries?(hw-learned()) && !hlb-carries?(filter(p => (String) p != "receipts/local-run-ledger.jsonl", hw-learned())) && !hlb-carries?(append(hw-learned(), [hw-words()[0]]))
   && hlb-has(day, "hw-safe-skips?(safe, \"movement\") ? 0 : hw-say(hw-line(hw-movement(dt-learned-request(")
   && hlb-has(rent, "[session-rent] this session s; measured 1") && !hlb-has(rent, "day sessions") && hlb-has(steer, "[self-steer] 1 of 2 open row(s) offered")
   && hlb-refused(hw-rent-at(io, none), "rent", none) && hlb-refused(hw-steer-at(io, none), "steer", none)   && hlb-has(healLine, "1 killed publish(es) returned") && (Comparable) fhn-count(healRow, "returned") == 1 && (Comparable) fhn-count(healRow, "conflicts") == 1;
  }
 }
 let ctx = hlb-fresh();
 nothing?(ctx) ? form_error("host-walk-learn band needs a fresh directory") : 0;
 live-claims("host-walk-learn-band", ctx, [["order", 1, 1, hlb-c-order], ["request", 2, 1, hlb-c-request], ["exit", 4, 1, hlb-c-exit], ["refused", 8, 1, hlb-c-refused], ["deadline", 16, 1, hlb-c-deadline], ["paths", 32, 1, hlb-c-paths], ["plants", 64, 1, hlb-c-plants], ["lift-27b", 128, 1, hlb-c-lift-27b], ["carried", 256, 1, hlb-c-carried]]);
}
