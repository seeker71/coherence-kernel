; form-cli-resident-multi-skill-school-band.fk -- pure door contract.
;
; The routed query cell is a sibling prelude because the emitted source lane
; supplies it before the school.  Empty selection must return before fs_exists,
; Qwen open, carrier admission, generation, or release can become reachable.
;
; preludes: form-stdlib/form-nodeid-knowledge-routed-query.fk form-stdlib/form-cli-resident-multi-skill-school.fk
;
; Verdict 127: the real door returns compact typed nothing, binds the empty
; selected path by digest, records zero opens/observations/model execution, and
; makes release whole without manufacturing a resident handle.
(do
    (let result (fscs-school "\n"))
    (sum (list
        (if (eq (fscs-result-valid? result) 1) 1 0)
        (if (ge (str_find result "\nstatus=nothing" 0) 0) 2 0)
        (if (ge (str_find result
            "\nreason=no-model-selected-use-models-then-use" 0) 0) 4 0)
        (if (ge (str_find result "\nopen-count=0" 0) 0) 8 0)
        (if (ge (str_find result "\nobservations=0" 0) 0) 16 0)
        (if (ge (str_find result "\nmodel-executed-form=0" 0) 0) 32 0)
        (if (ge (str_find result "\nrelease=1" 0) 0) 64 0))))
