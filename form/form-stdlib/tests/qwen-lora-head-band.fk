; qwen-lora-head-band.fk — Form writes and admits a Qwen-width seed adapter.
;
; Verdict 63:
;   1  the Form-written safetensors header is whole
;   2  it declares one rank-one lora_a/lora_b pair
;   4  A's raw float32 payload is Qwen's complete 5120-wide vector
;   8  B's raw float32 payload is Qwen's complete 5120-wide vector
;  16  q38 admits those exact bytes as device A/B buffers
;  32  every admitted device buffer releases
;
; This is a physical untrained seed.  The voice eval remains separate.
; preludes: form-stdlib/qwen-lora-head.fk

(do
    (defn qlhb-path () (fs-path-join (fs-temp-dir) "qwen-lora-head-band.safetensors"))
    (let path (qlhb-path))
    (let wrote (qlh-write path "observation first local voice corpus seed"))
    (let c (la-census path))
    (let adapter (qlh-admit path))
    (let closed (qlh-close adapter))
    (sum (list
        (if (eq (qlh-whole? path) 1) 1 0)
        (if (if (eq (nth c 1) 1) (eq (nth c 2) 1) 0) 2 0)
        (if (eq (str_len (qlh-tensor-bytes path (qlh-a-name))) (mul (qlh-width) 4)) 4 0)
        (if (eq (str_len (qlh-tensor-bytes path (qlh-b-name))) (mul (qlh-width) 4)) 8 0)
        (if (eq (qlh-admitted? adapter) 1) 16 0)
        (if (eq closed 3) 32 0))))
