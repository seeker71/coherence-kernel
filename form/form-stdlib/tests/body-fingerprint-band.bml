// Exact FNV identity and the witnessed CPU lane. No models or network.
// Expected: 127
// Verdict 127
// preflight-exec: forbidden
// preludes: form-stdlib/bml/body-fingerprint.bml form-stdlib/bml/host-fs.bml
section [form.bml] {
 def bfb-claim(ok, bit) = ok ? bit : 0;
 let binary = nli-bytes(range(0,256));
 let text = binary ++ "a" ++ byte_to_str(0) ++ binary;
 let strings = ["", "a", "hello", byte_to_str(0), binary, text];
 let c1 = bfb-claim(all?(s => bfp-text(s) == bml-source-fingerprint(s),strings) && bfp-text("") == "cbf29ce484222325" && bfp-text("a") == "af63dc4c8601ec8c",1);
 // Digest equality alone could hide the reference fold. Require the image on
 // Linux x86-64 and Darwin ARM64, the two hosts carrying this CPU image door.
 let accelerated = bfp-lane && bfp-witness();
 let c2 = bfb-claim(accelerated && len(bfp-linux-image())%4 == 0 && (nli-platform ? value_kind(bfp-image) != "string" : value_kind(bfp-image) == "string"),2);
 let first = bfp-run(binary,bfp-initial(),len(binary));
 let continued = bfp-run(byte_to_str(0) ++ "tail",first,5);
 let zero = bfp-written(jit_cpu_run([bfp-image,["",[first]],[0]]));
 let c3 = bfb-claim(bfp-hex-of(continued) == bml-source-fingerprint(binary ++ byte_to_str(0) ++ "tail") && bfp-run("",first,0) == first && zero == first,4);
 let dir = host_temp_dir() ++ "/body-fingerprint-band-" ++ host_pid().str();
 let made = fs_mkdir(dir); let path = dir ++ "/bytes";
 let wrote = write_file_text(path,text);
 let c4 = bfb-claim(bfp-file(path) == bml-source-fingerprint(text) && bfp-hex-of(bfp-run(["file",path,256,5],bfp-initial(),5)) == bml-source-fingerprint(substring(text,256,261)),8);
 let empty = write_file_text(path,"");
 let c5 = bfb-claim(bfp-file(path) == "cbf29ce484222325" && nothing?(bfp-file(dir ++ "/absent")),16);
 let c6 = bfb-claim(bfp-valid?(bfp-text(text)) && !bfp-valid?("unknown") && nothing?(bfp-hex-of("short")),32);
 // Cross the 16-bit count boundary, with a differing final byte.
 let many = nli-zero(65536) ++ byte_to_str(255);
 let began = host_monotonic_ms(); let digest = bfp-text(many); let elapsed = host_monotonic_ms()-began;
 let c7 = bfb-claim(digest == bml-source-fingerprint(many),64);
 let gone = fs_rmdir(dir);
 print(["body-fingerprint-band","accelerated",accelerated,"linux",nli-platform,"65537_bytes_ms",elapsed,"claims",[c1,c2,c3,c4,c5,c6,c7]]);
 c1+c2+c3+c4+c5+c6+c7;
}
