; host-cwd-band.fk — the body knows where it is standing, without forking.
;
; Two doors used to ask a spawned `pwd` where they were: a source-cache witness
; and the kernel-conformance gate. A witness that shells out to learn where it
; stands is not standing anywhere it can describe, and the answer came back with
; a trailing newline every caller then had to strip.
;
; `host_cwd` (tag 29 — the tag MLX vacated the same day) answers the process's
; own working directory as its own word. Nothing was minted for it: a lane that
; went home left the room its replacement needed.
;
; Expected: 63
;
;   1   the door answers a non-empty absolute path
;   2   it carries NO trailing newline — the strip every caller wrote disappears
;   4   it agrees with a spawned `pwd` byte for byte once that newline is gone,
;       which is the only claim that makes replacing the fork honest
;   8   it is stable across calls in one process
;   16  it names a directory that exists, asked through the body's own fs door
;   32  the path it reports IS the path relative names resolve against: listing
;       it and listing "." answer the same directory
;
; preludes: form/form-stdlib/core.fk

(do
    (defn xb (ok bit) (if ok bit 0))
    (defn last-byte (s) (str_byte_at s (sub (str_len s) 1)))
    (defn chop-nl (s) (if (eq (last-byte s) 10) (substring s 0 (sub (str_len s) 1)) s))

    (let here (host_cwd))
    (let b1 (xb (and (gt (str_len here) 1) (eq (str_byte_at here 0) 47)) 1))
    (let b2 (xb (not (eq (last-byte here) 10)) 2))

    ; the fork this door replaces, run once here so the claim is a comparison
    ; and not an assertion
    (let shelled (host_capture (list "pwd")))
    (let b3 (xb (and (str_eq (chop-nl shelled) here)
                     (eq (str_len shelled) (add (str_len here) 1))) 4))

    (let b4 (xb (str_eq (host_cwd) here) 8))
    (let b5 (xb (eq (fs_exists here) 1) 16))

    ; the path the door reports IS the path relative names resolve against:
    ; listing it and listing "." answer the same directory
    (let byAbs (fs_list here))
    (let byDot (fs_list "."))
    (let b6 (xb (and (gt (len byAbs) 0)
                (and (eq (len byAbs) (len byDot))
                     (eq (fs_exists (str_concat here "/runtime")) 1))) 32))

    (print (list "host_cwd" here "len" (str_len here) "shelled-len" (str_len shelled)))
    (sum (list b1 b2 b3 b4 b5 b6)))
