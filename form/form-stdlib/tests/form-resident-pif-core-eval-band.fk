; form-resident-pif-core-eval-band.fk -- interpreted functions born, called,
; and replaced as NodeID-addressed resident data. Expected: 4095
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-resident-pif-core-eval.fk

(do
    (defn frpceb-bit (held weight) (if held weight 0))
    (defn form-resident-pif-core-eval-band ()
        (do
            (let opened (frpce-empty))
            (let first (frpce-eval opened
                "(defn unseen-after-start (x) (add x 1))"))
            (let first-id (frpce-identity first))
            (let first-call (frpce-invoke-one first first-id 41))
            (let second (frpce-eval first
                "(defn unseen-after-start (x) (mul x 2))"))
            (let second-id (frpce-identity second))
            (let second-call (frpce-invoke-one second second-id 41))
            (let old-call (frpce-invoke-one second first-id 41))
            (let absent-call (frpce-invoke-one second
                (make_nodeid 31 2 0 999999) 41))
            (let nothing-def (frpce-eval second
                "(defn exact-nothing (x) nothing)"))
            (let nothing-call (frpce-invoke-one nothing-def
                (frpce-identity nothing-def) 0))
            (let zero-def (frpce-eval nothing-def
                "(defn exact-zero (x) 0)"))
            (let zero-call (frpce-invoke-one zero-def
                (frpce-identity zero-def) 1))
            (let one-def (frpce-eval zero-def
                "(defn exact-one (x) 1)"))
            (let one-call (frpce-invoke-one one-def
                (frpce-identity one-def) 0))
            (add
                (frpceb-bit (and (not (nothing? first-id))
                    (not (nothing? second-id))) 1)
            (add
                (frpceb-bit (not (node_eq first-id second-id)) 2)
            (add
                (frpceb-bit (and
                    (str_eq (frpce-receipt-status first-call) "returned")
                    (eq (frpce-receipt-value first-call) 42)) 4)
            (add
                (frpceb-bit (and
                    (str_eq (frpce-receipt-status second-call) "returned")
                    (eq (frpce-receipt-value second-call) 82)) 8)
            (add
                (frpceb-bit (and
                    (eq (frpce-receipt-value old-call) 42)
                    (eq (frpce-receipt-output old-call) 1)) 16)
            (add
                (frpceb-bit (and
                    (str_eq (frpce-receipt-status absent-call) "nothing")
                    (eq (frpce-receipt-output absent-call) 0)) 32)
            (add
                (frpceb-bit (and (nothing?
                    (frpce-receipt-value nothing-call))
                    (eq (frpce-receipt-output nothing-call) 1)) 64)
            (add
                (frpceb-bit (and
                    (str_eq (frpce-signal
                        (frpce-receipt-value nothing-call)) "nothing")
                    (str_eq (frpce-signal
                        (frpce-receipt-value zero-call)) "zero")) 128)
            (add
                (frpceb-bit (and
                    (str_eq (frpce-signal
                        (frpce-receipt-value one-call)) "one")
                    (eq (frpce-receipt-output zero-call) 1)) 256)
            (add
                (frpceb-bit (and
                    (eq (frpce-receipt-output one-call) 1)
                    (str_eq (frpce-receipt-trace second-call)
                        "resolve,call,return,observe,release")) 512)
            (add
                (frpceb-bit (and
                    (gt (len (frpce-env second)) (len (frpce-env opened)))
                    (node_eq (frpce-receipt-identity second-call) second-id)) 1024)
                (frpceb-bit (and
                    (str_eq (frpce-reason second)
                        "source-interpreted-resident")
                    (str_eq (frpce-receipt-reason second-call)
                        "recipe-node-invoked")) 2048))))))))))))))
    (form-resident-pif-core-eval-band))
