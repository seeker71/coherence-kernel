; bml-demand-jit-guard-band.fk -- what bdj-request refuses, what it accepts, and what its native challenge may read.
;
; bml-demand-jit selects a current disk image on first demand, or answers from the Form graph while specialization waits.
; bdj-request refuses what no route can answer honestly; compilation challenges the page once and retains that admission.
; arg-order-lane-parity-band.fk bit 1024 holds the first decline pair; this band holds the whole door.
;
;   1   an uncovered node tag declines: value nothing(), route "refused", status request-refused-uncovered-node-tag
;       (the lowering does not cover tag 99, and no route has an arm for it)
;   2   a host-effect row the root does not reach declines the same way, status request-refused-unreached-effect-row
;       (a write that no route would run is not "answered", it is dropped)
;   4   a program with no rows, and a root outside the rows, decline with request-refused-invalid-program-shape
;   8   the positive control: a pure scalar program (ARG + 2) is accepted; the first answer is the Form graph's (7), route
;       "form", a specialization pending
;  16   the step installs the page and its challenge AGREES (installed, agreement), and the next request is answered by the
;       page: route "native", the same 7. First demand also selects a valid disk image, retains its publication observation,
;       and preserves earlier pending work, publication evidence and cache care. Missing/changed images remain demand;
;       corrupt images publish their exact failure, repair through the owning heal and resume the original native answer.
;  32   a NEGATIVE answer survives the challenge: ARG - 7 at 4 is -3. The page used to answer 4294967293 and the challenge
;       (jit_leaf_inram against jonb-eval) read that as a disagreement -- a latched native-challenge-disagreed fault for a
;       right program. form-lower's epilogue now sign-extends (lo-sign), so the challenge agrees and the page answers -3
;  64   a division the page cannot answer as the walker does never reaches the lowering: a divisor that is not a nonzero
;       literal is on the wider frontier (status wider-frontier, route "form", nothing pending), whose answer is the walker's,
;       and a zero divisor STOPS there as the walker does (attempt reads the stop as nothing())
; 128   a division by a nonzero literal is lowered, challenged and answered natively, truncating toward zero: -9 / 4 is -2
; 256   default identity comes from the admitted builder and closure, without a .sym sibling or disk rehash. Both fields
;       affect identity, missing/malformed admission is unavailable, and the production request/step/request loop reuses
;       its own published image. Idle and publication care do not resolve runtime identity.
;
; The steps run on an explicit runtime identity (bdj-step-with-runtime), so no claim depends on a .fk.sym being on disk.
; Verdict 511 when every claim lands.
; REQUIRES: (jit_leaf_inram is fkwu's own; bits 16, 32 and 128 need the carrier door)
; preflight-exec: forbidden
import form-stdlib/bml/anf-lower.bml;
import form-stdlib/tests/arg-order-shapes-fixture.bml;
import form-stdlib/jit-heat-gate.fk;
import form-stdlib/bml/bml-demand-jit.bml;
import form-stdlib/bml/bml-demand-jit-events.bml;
section [form.bml] {
    def gb-bit(ok, bit) = ok ? bit : 0;
    def gb-state() = bdj-state(1, jonb-registry(1), nothing(), "idle");
    def gb-src() = alb-file(alb-slot("gb-src.txt"));
    def gb-cache() = alb-path("gb-cache-parent") + "/cache";
    // an explicit runtime identity (three content digests), so the step does not depend on a .fk.sym on this disk
    def gb-id64() = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
    def gb-ident() = bdj-runtime-fingerprint-from-identities("sha256:" + gb-id64(), "sha256:" + gb-id64(), "sha256:" + gb-id64());
    // request, step, request again: list(first receipt, step receipt, second receipt)
    def gb-roundtrip(prog, root, arg) {
        let r1 = bdj-request(gb-state(), gb-src(), gb-cache(), prog, root, arg);
        let st = bdj-step-with-runtime-source(r1[4], gb-ident);
        let r2 = bdj-request(bdj-step-state(st), gb-src(), gb-cache(), prog, root, arg);
        [r1, st, r2];
    }
    def gb-agreed?(st) = ((Comparable) bdj-step-installed(st) == 1) && ((Comparable) bdj-step-agreement(st) == 1);
    def gb-native?(rt, v) = gb-agreed?(rt[1]) && ((String) rt[2][3] == "native") && ((Comparable) rt[2][2] == v);
    def gb-program() = [[2], [1, 2], [3, 0, 1]];
    def gb-other() = [[2], [1, 9], [3, 0, 1]];
    def gb-unexpected-identity() = form_error("retained request resolved runtime identity");
    def gb-heat(name) {
        let found = filter(row => ((String) row[1] == name), kernel_hot_rows(kernel_ast(host_pid(), -1)[2]));
        nil?(found) ? 0 : found[0][0];
    }
    // Source-owned emission is retained once; the executing CPU owner supplies
    // the digest. Program-image publication is no longer a SHA prerequisite.
    def gb-initializer-care() {
        let wasReady=saj-resources-ready?();let codeBefore=gb-heat("saj-code");let constantsBefore=gb-heat("saj-round-constant-bytes");
        let first=saj-resources();let again=saj-resources();
        let digest=saj-string-digest("abc");
        let expected=sha256-stream-string("abc");
        let correct=!nothing?(digest) && len(digest)==32 && all?(i=>str_byte_at(digest,i)==expected[i],range(0,32));
        let observed=saj-resource-values?(first) && first==again && saj-resource-reason()=="ready" && correct
            && gb-heat("saj-code")==codeBefore+(wasReady ? 0 : 1) && gb-heat("saj-round-constant-bytes")==constantsBefore+(wasReady ? 0 : 1);
        print(["bml-demand-native-sha-resources",observed]);observed;
    }
    // The unavailable-seal fixture retains evidence from an actual successful
    // challenge. Care fills only that missing result, then retains it across
    // the independently unavailable publication parent.
    def gb-seal-care() {
        let source = alb-path("seal-care-source");
        let parent = alb-path("seal-care-parent");
        let cache = parent + "/cache";
        let wrote = write_file(source, "fixture");
        let first = bdj-request-with-runtime(bdj-empty(113), source, cache, gb-program(), 2, 5, gb-ident());
        let compiled = bdj-step-with-runtime(bdj-receipt-state(first), gb-ident());
        let care = bdj-state-care(bdj-step-state(compiled))[0];
        let admitted = bdj-care-admission(care);
        let partial = bdj-admission-with-seal(admitted[0:7], bdj-admission-payload(admitted), nothing());
        let absent = bdj-publish(cache, partial);
        let retained = bdj-state-with-care(bdj-step-state(compiled), [], nothing());
        let waiting = bdj-step-publish-care(retained, bdj-care-pending(care), bdj-care-image(care), bdj-care-runtime(care), "missing", absent, bdj-step-stage(compiled), partial);
        let waitingCare = bdj-state-care(bdj-step-state(waiting))[0];
        let relevantWatches = nil?(bdje-paths(waitingCare)) && !oh-has(bdje-paths(care), source);
        let minted = gb-heat("bdj-admission");
        let evaluated = gb-heat("jonb-eval");
        let sealed = bdj-care-hear(bdj-step-state(waiting), oh-response(bdj-care-observation(waitingCare), "publish-retained-image"));
        let sealedCare = bdj-state-care(bdj-step-state(sealed))[0];
        let same = ((Value) bdj-care-admission(sealedCare) == admitted);
        let complete = gb-heat("bdj-admission-with-seal");
        let made = fs-mkdir(parent);
        let published = bdj-step-with-runtime-source(bdj-step-state(sealed), gb-unexpected-identity);
        let stayed = ((Comparable) gb-heat("bdj-admission-with-seal") == complete)
            && ((Comparable) gb-heat("bdj-admission") == minted) && ((Comparable) gb-heat("jonb-eval") == evaluated);
        let answer = bdj-request-with-runtime-source(bdj-step-state(published), source, cache, gb-program(), 2, 5, gb-unexpected-identity);
        let observed = relevantWatches && ((String) absent == "admission-seal-unavailable") && same && stayed
            && ((String) bdj-step-status(sealed) == "cache-care-observed") && ((String) bdj-step-status(published) == "cache-repaired")
            && ((String) bdj-receipt-route(answer) == "native") && ((Comparable) bdj-receipt-value(answer) == 7);
        print(["bml-demand-seal-care", absent, bdj-step-status(sealed), bdj-step-status(published), "same-admission", same, "no-repeated-evidence", stayed, observed]);
        let cleaned = [jit_leaf_inram([1, jonb-identity(gb-program(), 2, 113), []], 0), fs_remove(cache), fs-remove-tree(parent), fs_remove(source)];
        observed;
    }
    def gb-prepare(source, cache, program, epoch) {
        let requested = bdj-request-with-runtime(bdj-empty(epoch), source, cache, program, 2, 5, gb-ident());
        bdj-step-with-runtime(bdj-receipt-state(requested), gb-ident());
    }
    def gb-wire-line(lines, index, replacement) = nil?(lines) ? "" : (if ((Comparable) index == 0) then replacement else lines[0])
        + (if ((Comparable) len(lines) == 1) then "" else "\n" + gb-wire-line(lines[1:], index - 1, replacement));
    def gb-disagreed-demand(initial, source, cache, epoch) {
        let requested = bdjo-request-with-runtime(initial, source, cache, gb-program(), 2, 5, gb-ident());
        let owner = bdjo-request-owner(requested);
        let state = bdjo-state(owner);
        let step = bdj-step-install(state, bdj-state-pending(state), lo-compile-fn(gb-other(), 2), now_unix_ms(), "missing", "compile-candidate", 0, 0, 0, 0, 0, 0, "compile", gb-ident());
        bdjo-request-with-runtime(bdjo-stage(owner, step), source, cache, gb-program(), 2, 5, gb-ident());
    }
    // Each case owns its temporary source/cache and a distinct page identity.
    // The owner receives the real request receipt; no progress call prepares a hit.
    def gb-demand-case(kind, epoch, care) {
        let source = alb-path("demand-" + kind);
        let cache = source + ".cache";
        let sourceWrote = write_file(source, "fixture");
        let prepared = if ((String) kind == "missing") || ((String) kind == "disagreed") then nothing() else gb-prepare(source, cache, if ((String) kind == "changed") then gb-other() else gb-program(), epoch);
        let cacheWire = if nothing?(prepared) then "" else read_file(cache);
        let cacheWrote = if ((String) kind == "corrupt") then write_file(cache, "broken")
            else if ((String) kind == "corrupt-image") then write_file(cache, gb-wire-line(split-on(cacheWire, "\n"), 5, split-on(cacheWire, "\n")[5] + ",0"))
            else if ((String) kind == "unchecked") then write_file(cache, bdj-cache-wire-with-runtime(gb-ident(), epoch, bdj-program-wire(gb-program(), 2, epoch), lo-compile-fn(gb-program(), 2)))
            else if ((String) kind == "malformed-admission") then write_file(cache, gb-wire-line(split-on(cacheWire, "\n"), 6, "unrecognized-admission")) else 0;
        let sourceRemoved = if ((String) kind == "source-missing") then fs_remove(source) else 0;
        let identity = if ((String) kind == "identity-absent") then "" else if ((String) kind == "runtime-changed") then gb-ident() + "changed" else gb-ident();
        let initial = bdjo-owner-from-state(bdj-state-with-care(bdj-empty(epoch), care, nothing()));
        let result = if ((String) kind == "disagreed") then gb-disagreed-demand(initial, source, cache, epoch) else bdjo-request-with-runtime(initial, source, cache, gb-program(), 2, 5, identity);
        let first = bdjo-request-first(result);
        let owner = bdjo-request-owner(result);
        let quiet = bdj-request-with-runtime-source(bdjo-state(owner), source, cache, if ((String) kind == "missing") then gb-other() else gb-program(), 2, 6, gb-unexpected-identity);
        let pending = if nothing?(bdj-state-pending(bdjo-state(owner))) then 1 else ((Value) bdj-state-pending(bdjo-state(owner)) == bdj-state-pending(bdj-receipt-state(quiet)));
        let unchangedCare = ((Value) bdj-state-care(bdjo-state(owner)) == care);
        let ordered = if ((String) kind == "current") then gb-owner-order(owner, source, cache, epoch) else 1;
        let healed = if ((String) kind == "corrupt") || ((String) kind == "corrupt-image") || ((String) kind == "unchecked") || ((String) kind == "malformed-admission") || ((String) kind == "identity-absent") then gb-cache-heal(owner, source, cache, epoch) else 1;
        let released = jit_leaf_inram([1, jonb-identity(gb-program(), 2, epoch), []], 0);
        let cleaned = [fs_remove(cache), fs_remove(source)];
        [first, owner, quiet, pending, unchangedCare, released, ordered, healed];
    }
    def gb-demand-miss?(case, status) = ((String) bdj-receipt-route(case[0]) == "form") && ((Comparable) bdj-receipt-value(case[0]) == 7)
        && ((String) bdj-receipt-cache-state(case[0]) == status) && !nothing?(bdj-state-pending(bdjo-state(case[1])))
        && nothing?(bdj-receipt-step(case[0])) && nil?(bdjo-publications(case[1])) && case[3] && case[4];
    def gb-demand-show(case) = [bdj-receipt-cache-state(case[0]), bdj-receipt-route(case[0]), bdj-receipt-value(case[0]), len(bdjo-publications(case[1]))];
    def gb-demand-failed?(case, cause) = ((String) bdj-receipt-route(case[0]) == "attention") && nothing?(bdj-receipt-value(case[0]))
        && nothing?(bdj-receipt-value(case[2])) && ((String) bdj-fault-cause(bdj-state-fault(bdjo-state(case[1]))) == cause)
        && ((Comparable) len(bdjo-publications(case[1])) == 1) && case[3] && case[7];
    def gb-cache-heal(owner, source, cache, epoch) {
        let scope = alb-path("cache-heal-" + epoch.str());
        let fault = bdj-state-fault(bdjo-state(owner));
        let published = bdjo-progress-with-runtime-at(owner, scope, gb-ident());
        let failure = bdjg-find-control(fgtm-snapshot-samples(bdjo-reading-snapshot(bdjo-progress-reading(published))), "diagnostic-control");
        let identityAbsent = ((String) bdj-fault-cause(fault) == "runtime-identity-unavailable");
        let stillAbsent = if identityAbsent then bdjo-progress-with-runtime-at(bdjo-progress-owner(published), scope, "") else nothing();
        let waiting = if identityAbsent then bdjo-progress-owner(stillAbsent) else bdjo-progress-owner(published);
        let waitingState = bdjo-state(waiting);
        let noAnswer = if identityAbsent then bdj-request-with-runtime-source(waitingState, source, cache, gb-program(), 2, 5, gb-unexpected-identity) else nothing();
        let held = !identityAbsent || (bdjo-progress-confirmed?(stillAbsent) && bdj-state-faulted?(waitingState)
            && ((String) bdj-fault-disposition(bdj-state-fault(waitingState)) == "held") && nothing?(bdj-receipt-value(noAnswer)));
        let control = bdj-fault-control(bdj-fault-cause(fault), "healed", "admitted-runtime-identity-available", now_unix_ms());
        let resumed = if identityAbsent then bdjo-owner-queue(bdj-fault-control-state(bdj-fault-apply(waitingState, control)), bdjo-first(waiting), bdjo-first-ms(waiting), bdjo-publications(waiting), bdjo-lifecycle(waiting)) else waiting;
        let repaired = bdjo-progress-with-runtime-at(resumed, scope, gb-ident());
        let healing = bdjg-find-control(fgtm-snapshot-samples(bdjo-reading-snapshot(bdjo-progress-reading(repaired))), "jit-healed");
        let state = bdjo-state(bdjo-progress-owner(repaired));
        let pending = bdj-state-pending(bdjo-state(owner));
        let retainedAnswer = bdj-step-answer(bdjo-progress-step(repaired));
        let answer = bdj-request-with-runtime-source(state, source, cache, bdj-pending-program(pending), bdj-pending-root(pending), bdj-pending-argument(pending) + 1, gb-unexpected-identity);
        let current = bdj-cache-inspection-status(bdj-cache-inspect-with-runtime(source, cache, epoch, bdj-pending-program-wire(pending), gb-ident()));
        let observed = held && bdjo-progress-confirmed?(published) && bdjo-progress-confirmed?(repaired) && !nothing?(failure) && !nothing?(healing)
            && ((String) fgtm-sample-id(failure) == bdj-fault-key(fault)) && bdj-healed-matches-fault?(bdj-state-last-control(state), fault)
            && ((String) current == "current") && ((Comparable) retainedAnswer == 7) && ((String) bdj-receipt-route(answer) == "native") && ((Comparable) bdj-receipt-value(answer) == 8);
        print(["bml-demand-cache-heal", bdj-fault-cause(fault), bdjo-progress-status(published), bdjo-progress-status(repaired), "retained-answer", retainedAnswer, "next-input", bdj-receipt-route(answer), bdj-receipt-value(answer), observed]);
        let retired = fgtm-retire-snapshot(scope, BDJGPublisher(), fgtm-read-root(bdjo-progress-reading(repaired)));
        observed && retired;
    }
    def gb-production-default() {
        let source = alb-path("production-default");
        let cache = source + ".cache";
        let wrote = write_file(source, "fixture");
        let first = bdj-request(bdj-empty(110), source, cache, gb-program(), 2, 5);
        let compiled = bdj-step(bdj-receipt-state(first));
        let demand = bdjo-request(bdjo-owner(110), source, cache, gb-program(), 2, 5);
        let answer = bdjo-request-first(demand);
        let observed = ((String) bdj-step-status(compiled) == "compiled-published-installed")
            && ((String) bdj-receipt-route(answer) == "native") && ((Comparable) bdj-receipt-value(answer) == 7)
            && ((String) bdj-step-status(bdj-receipt-step(answer)) == "disk-installed");
        print(["bml-demand-production-default", bdj-step-status(compiled), bdj-receipt-route(answer), bdj-receipt-value(answer), observed]);
        let cleaned = [jit_leaf_inram([1, jonb-identity(gb-program(), 2, 110), []], 0), fs_remove(cache), fs_remove(source)];
        observed;
    }
    def gb-owner-order(owner, source, cache, epoch) {
        let prepared = gb-prepare(source, cache, gb-other(), epoch);
        let request = bdjo-request-with-runtime(owner, source, cache, gb-other(), 2, 5, gb-ident());
        let later = bdjo-request-owner(request);
        let accepted = bdjo-after-confirmed(later, bdjo-awaiting(owner));
        let observed = ((String) bdj-receipt-route(bdjo-request-first(request)) == "native") && ((Comparable) bdj-receipt-value(bdjo-request-first(request)) == 14)
            && ((Comparable) len(bdjo-publications(later)) == 2) && ((Value) bdjo-publications(later)[0] == bdjo-publications(owner)[0])
            && ((Comparable) len(bdjo-publications(accepted)) == 1) && ((Value) bdjo-state(accepted) == bdjo-state(later))
            && !nothing?(jonb-lookup(bdj-state-registry(bdjo-state(accepted)), gb-other(), 2));
        let released = jit_leaf_inram([1, jonb-identity(gb-other(), 2, epoch), []], 0);
        observed && ((Comparable) released == 1);
    }

    let ginitializerCare = gb-initializer-care();
    let gu = bdj-request(gb-state(), gb-src(), gb-cache(), [[2], [99], [3, 0, 1]], 2, 5);
    let gd = bdj-request(gb-state(), gb-src(), gb-cache(), [[2], [1, 1], [3, 0, 1], [11]], 2, 5);
    let ge = bdj-request(gb-state(), gb-src(), gb-cache(), [], 0, 5);
    let go = bdj-request(gb-state(), gb-src(), gb-cache(), [[2], [1, 2], [3, 0, 1]], 9, 5);
    let gp = gb-roundtrip([[2], [1, 2], [3, 0, 1]], 2, 5);
    let gn = gb-roundtrip([[2], [1, 7], [4, 0, 1]], 2, 4);
    let gw1 = bdj-request(gb-state(), gb-src(), gb-cache(), [[2], [1, 3], [8, 1, 0]], 2, 2);
    let gw2 = attempt(bdj-request(gb-state(), gb-src(), gb-cache(), [[2], [1, 3], [8, 1, 0]], 2, 0));
    let gw3 = attempt(bdj-request(gb-state(), gb-src(), gb-cache(), [[2], [1, 0], [8, 0, 1]], 2, 5));
    let gl = gb-roundtrip([[2], [1, 4], [8, 0, 1]], 2, 0 - 9);
    let shown = print(["bml-demand-jit-guard", "refusals", [gu[0], gu[2], gu[3]], [gd[0], gd[2], gd[3]], [ge[0], ge[3]], [go[0], go[3]],
        "positive", [gp[0][0], gp[0][2], gp[0][3]], [gp[1][0], gp[1][6], gp[1][7]], [gp[2][0], gp[2][2], gp[2][3]],
        "negative", [gn[0][2], gn[1][0], gn[1][6], gn[1][7]], [gn[2][2], gn[2][3]],
        "division", [gw1[0], gw1[2], gw1[3]], [nothing?(gw2), nothing?(gw3)], [gl[0][2], gl[1][0], gl[2][2], gl[2][3]]]);
    let gfp = bdj-runtime-fingerprint();
    let gadmission = ["fkwu-image-v1 builder-one", "fk-unit-v4|n=1|123"];
    let gsourceId = bdj-runtime-fingerprint-from-admission(gadmission);
    let gproduction = gb-production-default();
    let gsealCare = gb-seal-care();
    let gidle = bdj-step-with-runtime-source(gb-state(), () => form_error("idle resolved runtime identity"));
    let gcare = bdj-step-with-runtime-source(bdj-step-state(gp[1]), () => form_error("publication care resolved runtime identity"));
    let ghit = gb-demand-case("current", 101, bdj-state-care(bdj-step-state(gp[1])));
    let gmissing = gb-demand-case("missing", 102, []);
    let gchanged = gb-demand-case("changed", 103, []);
    let gcorrupt = gb-demand-case("corrupt", 104, []);
    let gsourceMissing = gb-demand-case("source-missing", 105, []);
    let gidentityAbsent = gb-demand-case("identity-absent", 106, []);
    let gruntimeChanged = gb-demand-case("runtime-changed", 107, []);
    let gdisagreed = gb-demand-case("disagreed", 108, []);
    let gcorruptImage = gb-demand-case("corrupt-image", 109, []);
    let gunchecked = gb-demand-case("unchecked", 111, []);
    let gmalformed = gb-demand-case("malformed-admission", 112, []);
    let gidentityFault = bdj-step-with-runtime(bdjo-state(gidentityAbsent[1]), "");
    let demandShown = print(["bml-demand-first", gb-demand-show(ghit), gb-demand-show(gmissing), gb-demand-show(gchanged), gb-demand-show(gcorrupt),
        gb-demand-show(gsourceMissing), gb-demand-show(gidentityAbsent), gb-demand-show(gruntimeChanged), gb-demand-show(gdisagreed), gb-demand-show(gcorruptImage), gb-demand-show(gunchecked), gb-demand-show(gmalformed)]);
    let hitSamples = bdjg-samples(1, 0, ghit[0], bdj-receipt-step(ghit[0]), nothing());
    let hitDisk = bdjg-find-sample(hitSamples, "jit.bml-demand.disk");
    let publicationShown = print(["bml-demand-hit-publication", "disk-sample-present", !nothing?(hitDisk)]);
    let demandOk = ((String) bdj-receipt-route(ghit[0]) == "native") && ((Comparable) bdj-receipt-value(ghit[0]) == 7)
        && ((String) bdj-step-status(bdj-receipt-step(ghit[0])) == "disk-installed") && gb-agreed?(bdj-receipt-step(ghit[0]))
        && ((String) bdj-receipt-route(ghit[2]) == "native") && ((Comparable) bdj-receipt-value(ghit[2]) == 8)
        && nothing?(bdj-state-pending(bdjo-state(ghit[1]))) && ghit[4] && ((Comparable) ghit[5] == 1) && ghit[6] && !nothing?(hitDisk)
        && gb-demand-miss?(gmissing, "missing") && gb-demand-miss?(gchanged, "stale-program") && gb-demand-failed?(gcorrupt, "cache-shape")
        && ((String) bdj-receipt-route(gsourceMissing[0]) == "native") && ((Comparable) bdj-receipt-value(gsourceMissing[0]) == 7)
        && ((String) bdj-receipt-cache-state(gsourceMissing[0]) == "current") && gb-demand-failed?(gidentityAbsent, "runtime-identity-unavailable")
        && gb-demand-miss?(gruntimeChanged, "cache-runtime") && gb-demand-failed?(gcorruptImage, "cache-admission-digest")
        && gb-demand-failed?(gunchecked, "cache-admission-missing") && gb-demand-failed?(gmalformed, "cache-admission-contract")
        && ((Comparable) bdj-receipt-value(gmissing[2]) == 15) && bdj-state-faulted?(bdj-step-state(gidentityFault))
        && ((String) bdj-receipt-route(gdisagreed[0]) == "attention") && nothing?(bdj-receipt-value(gdisagreed[0])) && nothing?(bdj-receipt-value(gdisagreed[2]))
