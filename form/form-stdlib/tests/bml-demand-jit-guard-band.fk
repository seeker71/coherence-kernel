; bml-demand-jit-guard-band.fk -- what bdj-request refuses, what it accepts, and what its native challenge may read.
;
; bml-demand-jit answers first from the Form graph and specializes on demand: bdj-request refuses what no route can answer
; honestly, bdj-step lowers, installs, and challenges the page against the Form graph before it is ever the answer.
; arg-order-lane-parity-band.fk bit 1024 holds the first decline pair; this band holds the whole door.
;
;   1   an uncovered node tag declines: value nothing(), route "refused", status request-refused-uncovered-node-tag
;       (the lowering does not cover tag 99, and no route has an arm for it)
;   2   a host-effect row the root does not reach declines the same way, status request-refused-unreached-effect-row
;       (a write that no route would run is not "answered", it is dropped)
;   4   a program with no rows, and a root outside the rows, decline with request-refused-invalid-program-shape
;   8   the positive control: a pure scalar program (ARG + 2) is accepted; the first answer is the Form graph's (7), route
;       "form", a specialization pending
;  16   the step installs the page and its challenge AGREES (installed, agreement), and the next request is answered by the
;       page: route "native", the same 7
;  32   a NEGATIVE answer survives the challenge: ARG - 7 at 4 is -3. The page used to answer 4294967293 and the challenge
;       (jit_leaf_inram against jonb-eval) read that as a disagreement -- a latched native-challenge-disagreed fault for a
;       right program. form-lower's epilogue now sign-extends (lo-sign), so the challenge agrees and the page answers -3
;  64   a division the page cannot answer as the walker does never reaches the lowering: a divisor that is not a nonzero
;       literal is on the wider frontier (status wider-frontier, route "form", nothing pending), whose answer is the walker's,
;       and a zero divisor STOPS there as the walker does (attempt reads the stop as nothing())
; 128   a division by a nonzero literal is lowered, challenged and answered natively, truncating toward zero: -9 / 4 is -2
; 256   the runtime fingerprint is always a string: bdj-source-unit-hash read the retired path `bml-demand-jit.sym` (the
;       file is `bml-demand-jit.fk.sym`) and a missing file made split-on stop on a non-string, so the step lane died with
;       a str_find stop instead of its own "runtime identity unavailable" refusal; an explicit identity is ready
;
; The steps run on an explicit runtime identity (bdj-step-with-runtime), so no claim depends on a .fk.sym being on disk.
; Verdict 511 when every claim lands.
; PROOF LEVEL: FOURTH-ARM ONLY (jit_leaf_inram is fkwu's own; bits 16, 32 and 128 need the carrier door)
; preflight-exec: forbidden
import form-stdlib/bml/anf-lower.bml;
import form-stdlib/tests/arg-order-shapes-fixture.bml;
import form-stdlib/jit-heat-gate.fk;
import form-stdlib/bml/bml-demand-jit.bml;
section [form.bml] {
    def gb-bit(ok, bit) = ok ? bit : 0;
    def gb-state() = bdj-state(1, jonb-registry(1), nothing(), "idle");
    def gb-src() = alb-file(alb-slot("gb-src.txt"));
    def gb-cache() = alb-file(alb-slot("gb-cache.txt"));
    // an explicit runtime identity (three content digests), so the step does not depend on a .fk.sym on this disk
    def gb-id64() = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
    def gb-ident() = bdj-runtime-fingerprint-from-identities("sha256:" + gb-id64(), "sha256:" + gb-id64(), "sha256:" + gb-id64());
    // request, step, request again: list(first receipt, step receipt, second receipt)
    def gb-roundtrip(prog, root, arg) {
        let r1 = bdj-request(gb-state(), gb-src(), gb-cache(), prog, root, arg);
        let st = bdj-step-with-runtime(r1[4], gb-ident());
        let r2 = bdj-request(bdj-step-state(st), gb-src(), gb-cache(), prog, root, arg);
        [r1, st, r2];
    }
    def gb-agreed?(st) = ((Comparable) bdj-step-installed(st) == 1) && ((Comparable) bdj-step-agreement(st) == 1);
    def gb-native?(rt, v) = gb-agreed?(rt[1]) && ((String) rt[2][3] == "native") && ((Comparable) rt[2][2] == v);

    let gu = bdj-request(gb-state(), gb-src(), gb-cache(), [[2], [99], [3, 0, 1]], 2, 5);
    let gd = bdj-request(gb-state(), gb-src(), gb-cache(), [[2], [1, 1], [3, 0, 1], [11]], 2, 5);
    let ge = bdj-request(gb-state(), gb-src(), gb-cache(), [], 0, 5);
    let go = bdj-request(gb-state(), gb-src(), gb-cache(), [[2], [1, 2], [3, 0, 1]], 9, 5);
    let gp = gb-roundtrip([[2], [1, 2], [3, 0, 1]], 2, 5);
    let gn = gb-roundtrip([[2], [1, 7], [4, 0, 1]], 2, 4);
    let gw1 = bdj-request(gb-state(), gb-src(), gb-cache(), [[2], [1, 3], [8, 1, 0]], 2, 2);
    let gw2 = attempt(bdj-request(gb-state(), gb-src(), gb-cache(), [[2], [1, 3], [8, 1, 0]], 2, 0));
    let gw3 = attempt(bdj-request(gb-state(), gb-src(), gb-cache(), [[2], [1, 0], [8, 0, 1]], 2, 5));
    let gl = gb-roundtrip([[2], [1, 4], [8, 0, 1]], 2, 0 - 9);
    let shown = print(["bml-demand-jit-guard", "refusals", [gu[0], gu[2], gu[3]], [gd[0], gd[2], gd[3]], [ge[0], ge[3]], [go[0], go[3]],
        "positive", [gp[0][0], gp[0][2], gp[0][3]], [gp[1][0], gp[1][6], gp[1][7]], [gp[2][0], gp[2][2], gp[2][3]],
        "negative", [gn[0][2], gn[1][0], gn[1][6], gn[1][7]], [gn[2][2], gn[2][3]],
        "division", [gw1[0], gw1[2], gw1[3]], [nothing?(gw2), nothing?(gw3)], [gl[0][2], gl[1][0], gl[2][2], gl[2][3]]]);
    let gfp = bdj-runtime-fingerprint();
    let gz = [alb-reset(gb-src()), alb-reset(gb-cache())];
    let verdict = gb-bit(nothing?(gu[2]) && ((String) gu[3] == "refused") && ((String) gu[0] == "request-refused-uncovered-node-tag"), 1)
        + gb-bit(nothing?(gd[2]) && ((String) gd[3] == "refused") && ((String) gd[0] == "request-refused-unreached-effect-row"), 2)
        + gb-bit(nothing?(ge[2]) && nothing?(go[2]) && ((String) ge[0] == "request-refused-invalid-program-shape") && ((String) go[0] == "request-refused-invalid-program-shape"), 4)
        + gb-bit(((Comparable) gp[0][2] == 7) && ((String) gp[0][3] == "form") && !nothing?(bdj-state-pending(gp[0][4])), 8)
        + gb-bit(gb-native?(gp, 7), 16)
        + gb-bit(((Comparable) gn[0][2] == 0 - 3) && gb-native?(gn, 0 - 3), 32)
        + gb-bit(((String) gw1[0] == "wider-frontier") && ((Comparable) gw1[2] == 1) && ((String) gw1[3] == "form") && nothing?(bdj-state-pending(gw1[4])) && nothing?(gw2) && nothing?(gw3), 64)
        + gb-bit(gb-native?(gl, 0 - 2), 128)
        + gb-bit(((String) value_kind(gfp) == "string") && ((Comparable) bdj-runtime-identity-ready?(gb-ident()) == 1), 256);
    let gend = print(["bml-demand-jit-guard-band", "verdict", verdict]);
    verdict;
}
