; own-word-band.fk — the refusal machinery under the body's first own
; sentence, proven over four hand-written frames. PURE: no microphone, no
; GPU, no model, no host command, no file written. What is under test is
; the checker, not the lane that generates: a generative lane is weather,
; and a band that needed one would be measuring the weather.
;
; The four frames are a small room the body could actually have:
;   f1  a line that closed, in English, under the speech floor
;   f2  a line still growing, in English, quiet
;   f3  the lane opening on silence
;   f4  the lane under the speech floor with no line
;
; The record they make is exact and small enough to state:
;   4 frames, 1 line closed, 15 words, 0 attested, floor -120 dBFS,
;   loudest -48 dBFS, 6 seconds of room, hour 6, 2026-09-08, 4 shapes.
; So the quantities it holds are {4, 1, 0, 15, -120, -48, 120, 48, 6,
; 2026, 9, 8} and NOTHING else — 99, 7 and 5 are absent by construction,
; which is what lets a false claim be built on purpose and watched.
;
; The band is built so that a checker which always says yes and a checker
; which always says no are BOTH red: bit 2 needs an accept, bits 8 through
; 128 need refusals, and bit 64 needs the refusal of a sentence that
; nothing else in the band would catch.
;
; Each bit is a LIST of conditions rather than nested `and`, so a bit reads
; as what it claims and a reader can see its depth.
; Expected: 65535
; preludes: form-stdlib/own-word.bml
(do
    (defn ob-all (xs) (if (eq (len xs) 0) 1 (if (eq (head xs) 1) (ob-all (tail xs)) 0)))
    (defn ob-bit (xs bit) (if (eq (ob-all xs) 1) bit 0))
    (defn ob-in? (hay needle) (if (ge (str_find hay needle 0) 0) 1 0))
    (defn ob-out? (hay needle) (if (lt (str_find hay needle 0) 0) 1 0))

    ; ── the room ───────────────────────────────────────────────────────
    (let f1 "<|ear:frame|>\nt=1788850000000\nkind=heard\ndb=-70\nheard=the ledger closed at seven and the lamp went out\nlang=en\nnsp=0\nheardms=340\n<|/ear:frame|>\n")
    (let f2 "<|ear:frame|>\nt=1788850002000\nkind=live\ndb=-48\nlive=a phrase still growing here\nlivelang=en\nlivems=37\nencms=12\ndecms=24\nntok=22\n<|/ear:frame|>\n")
    (let f3 "<|ear:frame|>\nt=1788850004000\nkind=born\ndb=-120\n<|/ear:frame|>\n")
    (let f4 "<|ear:frame|>\nt=1788850006000\nkind=quiet\ndb=-90\n<|/ear:frame|>\n")
    (let frames (pr-frames (str_concat f1 (str_concat f2 (str_concat f3 f4)))))
    (let r (ow-record frames))
    (let day (ow-r-day r))
    (let ns (ow-numbers r))

    ; ── the sentences: one the record backs, six it must refuse ────────
    (let true1 "Across 4 frames only 1 line closed, and the floor sat at -120 dBFS.")
    (let badnum "Across 99 frames only 1 line closed, and the floor sat at -120 dBFS.")
    (let badtongue "Across 4 frames the room was heard in Persian.")
    (let badstate "Across 4 frames a lane was rendering the line into its tongues.")
    ; the room's OTHER line, chosen because it carries no count and no
    ; tongue: quoting f1 would also trip the number check on "seven", and a
    ; bit that claims to be the only catcher must be the only catcher
    (let leaked "The room said a phrase still growing here.")
    (let vacuous "The room is calm and pleasant.")
    (let mixed "Across 4 frames the room was heard in Persian and 99 lines closed.")
    (let ck-true (ow-check r true1))
    (let ck-bad (ow-check r badnum))
    (let ck-leak (ow-check r leaked))
    (let ck-vac (ow-check r vacuous))
    (let ck-mix (ow-check r mixed))
    (let ask (ow-ask frames))

    (sum (list
        ; ── the record reads its own frames ────────────────────────────
        (ob-bit (list (eq (len frames) 4)
                      (eq (head day) 4)
                      (eq (nth day 5) 1)
                      (eq (nth day 7) 15)
                      (eq (nth day 6) 0)
                      (eq (ow-r-nshapes r) 4)) 1)

        ; ── a sentence the record backs, stands ────────────────────────
        (ob-bit (list (eq (ow-stands? r true1) 1)
                      (eq (ow-n-claims ck-true) 3)
                      (eq (ow-n-backed ck-true) 3)
                      (eq (ow-n-refused ck-true) 0)) 2)

        ; ── the tongues and the kinds are the room's, not a catalog's ──
        (ob-bit (list (eq (len (ow-r-tongues r)) 1)
                      (str_eq (head (ow-r-tongues r)) "en")
                      (eq (len (ow-r-kinds r)) 4)
                      (eq (pr-member? (ow-r-kinds r) "heard") 1)
                      (eq (pr-member? (ow-r-kinds r) "said") 0)) 4)

        ; ── an invented count is refused ───────────────────────────────
        (ob-bit (list (eq (ow-stands? r badnum) 0)
                      (eq (ow-n-refused ck-bad) 1)
                      (eq (ow-n-backed ck-bad) 2)) 8)

        ; ── a tongue this room was never heard in is refused ───────────
        (ob-bit (list (eq (ow-stands? r badtongue) 0)
                      (eq (ow-stands? r "Across 4 frames the room was heard in English.") 1)) 16)

        ; ── a lane state these frames never took is refused ────────────
        (ob-bit (list (eq (ow-stands? r badstate) 0)
                      (eq (ow-stands? r "Across 4 frames a lane was holding a line that closed.") 1)) 32)

        ; ── the room's own speech, quoted back, is refused ─────────────
        ; nothing else in the band catches this: the sentence invents no
        ; number, names no tongue and takes no state
        (ob-bit (list (eq (ow-stands? r leaked) 0)
                      (eq (ow-n-claims ck-leak) 1)
                      (eq (ow-n-backed ck-leak) 0)) 64)

        ; ── a sentence about no room at all is refused ─────────────────
        ; every claim it makes is backed, because it makes none
        (ob-bit (list (eq (ow-stands? r vacuous) 0)
                      (eq (ow-n-claims ck-vac) 0)
                      (eq (ow-n-refused ck-vac) 0)
                      (eq (ow-stands? r "") 0)) 128)

        ; ── the quantities the record holds, and the ones it does not ──
        (ob-bit (list (eq (ow-holds? ns 15) 1)
                      (eq (ow-holds? ns -48) 1)
                      (eq (ow-holds? ns 2026) 1)
                      (eq (ow-holds? ns 6) 1)
                      (eq (ow-holds? ns 99) 0)
                      (eq (ow-holds? ns 5) 0)) 256)

        ; ── a level reading is read with its sign, and by its magnitude ─
        (ob-bit (list (eq (ow-c-value (head (ow-digit-claims "the floor sat at -120 dBFS"))) -120)
                      (eq (ow-c-value (head (ow-digit-claims "120 frames stood"))) 120)
                      (eq (ow-holds? ns 120) 1)
                      (eq (ow-holds? ns -120) 1)) 512)

        ; ── a count written as a word is a claim too ───────────────────
        (ob-bit (list (eq (ow-stands? r "Only one line closed in this room.") 1)
                      (eq (ow-stands? r "Only seven lines closed in this room.") 0)) 1024)

        ; ── and a word that merely contains one is not ─────────────────
        ; nor is a tongue claimed by a bare two-letter code that is also an
        ; ordinary English word — `it`, `he`, `hi` and `id` are four tongues
        ; and four words, and only the shape notation tells them apart
        (ob-bit (list (eq (len (ow-word-claims (ow-low "A stone sat alone in the room."))) 0)
                      (eq (len (ow-word-claims (ow-low "one stone"))) 1)
                      (eq (len (ow-tongue-claims (ow-low "the men went hence"))) 0)
                      (eq (len (ow-tongue-claims (ow-low "no words are carried out of it, and he said hi"))) 0)
                      (eq (len (ow-tongue-claims (ow-low "the shape live|it|phrase|quiet stood"))) 1)
                      (eq (ow-stands? r "Across 4 frames no words are carried out of it.") 1)) 2048)

        ; ── a completion is cut to its first whole sentence ────────────
        ; and one the lane never finished is not offered at all
        (ob-bit (list (str_eq (ow-candidate "Only 1 line closed here. And then it ran on and on") "Only 1 line closed here.")
                      (str_eq (ow-candidate "Only 1 line closed here.\nA second line") "Only 1 line closed here.")
                      (str_eq (ow-candidate "Only 1 line closed here and then the tokens ran out") "")
                      (str_eq (ow-candidate "") "")) 4096)

        ; ── the refusal says what it refused, and where ────────────────
        (ob-bit (list (ob-in? (ow-why r badnum) "refused at number 99")
                      (ob-in? (ow-why r vacuous) "claims nothing of this room")
                      (ob-in? (ow-why r true1) "3 of 3 claims held")) 8192)

        ; ── the ask is the body's own words, and carries no room line ──
        (ob-bit (list (ob-in? ask (pr-day-said frames))
                      (ob-in? ask "Observation:")
                      (ob-out? ask "the ledger closed at seven")
                      (ob-out? ask "a phrase still growing here")) 16384)

        ; ── the tally is whole: what it counted, it counted once ───────
        (ob-bit (list (eq (ow-n-claims ck-mix) (add (ow-n-backed ck-mix) (ow-n-refused ck-mix)))
                      (eq (ow-n-claims ck-mix) 3)
                      (eq (ow-n-refused ck-mix) 2)) 32768))))
