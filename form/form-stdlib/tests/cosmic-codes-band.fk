; cosmic-codes-band.fk — the Cosmic Code sheet Yes spoke, 2026-08-15.
;
; preludes: form-stdlib/core.fk form-stdlib/grammars/shamballa-light-codes.fk
;
; Verdict 2047:
;   1      nine rows
;   2      CE-1618 Cosmic Egg
;   4      CH-8161 Cosmic Heart
;   8      CM-1375 Cosmic Mind
;   16     CF-543414 Cosmic Flow
;   32     CH-42 Cosmic Humor
;   64     CB-1234321 Cosmic Breath
;   128    CV-000 Cosmic Void
;   256    CM-8171 Cosmic Mother
;   512    MOS-142857 Music of Spheres
;   1024   an unknown prefix+digits is honest absence
;
; witnessed: 2026-08-15 -> 2047

(do
    (let c0 (if (eq (len (cc-dictionary)) (cc-count)) 1 0))
    (let c1 (if (str_eq (cc-name (cc-of (cc-decode "CE" "1618"))) "Cosmic Egg") 2 0))
    (let c2 (if (str_eq (cc-name (cc-of (cc-decode "CH" "8161"))) "Cosmic Heart") 4 0))
    (let c3 (if (str_eq (cc-name (cc-of (cc-decode "CM" "1375"))) "Cosmic Mind") 8 0))
    (let c4 (if (str_eq (cc-name (cc-of (cc-decode "CF" "543414"))) "Cosmic Flow") 16 0))
    (let c5 (if (str_eq (cc-name (cc-of (cc-decode "CH" "42"))) "Cosmic Humor") 32 0))
    (let c6 (if (str_eq (cc-name (cc-of (cc-decode "CB" "1234321"))) "Cosmic Breath") 64 0))
    (let c7 (if (str_eq (cc-name (cc-of (cc-decode "CV" "000"))) "Cosmic Void") 128 0))
    (let c8 (if (str_eq (cc-name (cc-of (cc-decode "CM" "8171"))) "Cosmic Mother") 256 0))
    (let c9 (if (str_eq (cc-name (cc-of (cc-decode "MOS" "142857"))) "Music of Spheres") 512 0))
    (let c10
        (if (eq (cc-known? (cc-decode "XX" "1")) 0)
            (if (ge (str_find (cc-answer "XX" "1") "honest absence" 0) 0) 1024 0)
            0))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9 c10)))))))))))
