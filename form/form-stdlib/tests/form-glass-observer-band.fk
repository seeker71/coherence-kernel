; form-glass-observer-band.fk — truth-bearing whole-body observation rows.
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/form-glass-observer.bml
; Verdict 4194303: presence, units, planes, exact-line parsers, bounded heat/catalog,
; process observation and privacy, semantic zeros, exact framebuffer gaps,
; real Glass projection/source NodeIDs, and BML authority.

(do
    (defn fgob-bit (held weight) (if (eq held 1) weight 0))
    (defn fgob-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))
    (defn fgob-descending? (rows)
        (if (le (len rows) 1) 1
            (if (ge (fgo-int-value (head rows)) (fgo-int-value (nth rows 1)))
                (fgob-descending? (tail rows)) 0)))
    (defn fgob-repeat-line (line count)
        (if (le count 0) "" (str_concat line (fgob-repeat-line line (sub count 1)))))

    (let status "linked=1\ndevice=Apple Test\nbuffers=7\nlast_error=none\n")
    (let colliding-status "not_buffers=91\nbuffers=7\nxdevice=Wrong\ndevice=Apple Test\n")
    (let idle-status "linked=1\ndevice=Apple Test\nbuffers=0\nmmap_nocopy_buffers=0\npipelines=0\ntotal_dispatch=0\ntotal_sync=0\ngpu_busy_us_total=0\ncpu_jit_busy_us_total=0\nlast_error=none\n")
    (let unavailable (fgo-unavailable "memory" "bytes" "bytes" "bytes" "unknown" "kernel.fixture-byte-ledger" "cell" "not exposed"))
    (let sized (fgo-sized "memory" "cache" "cache" 40 "bytes" 100 9 "disk-cache" "catalog" "fixture" "stored" "cache" "storage only"))
    (let metal (fgo-metal-rows status))
    (let pressure "The system has 137438953472 bytes\nSystem-wide memory free percentage: 36%\n")
    (let psfixture " 101 2048 12.3 01:02:03 /tmp/fkwu\n 102 0 0.0 00:07 fkwu\n 103 500 3.1 1-02:03:04 /private/secret-worker\n")
    (let processes (fgo-ps-processes psfixture))
    (let processrows (fgo-process-rows psfixture))
    (let boundedrows (fgo-process-rows (fgob-repeat-line " 201 1 0.1 00:01 fkwu\n" 40)))
    (let pidcandidates (fgo-pid-candidates "123\n045\nnope\n2147483648\n456\n"))
    (let cappedpids (fgo-pid-candidates (fgob-repeat-line "123\n" 40)))
    (let oversizedpids (fgo-pid-candidates (fgob-repeat-line "1234567890\n" 200)))
    (let heat (fgo-primitive-heat))
    (let storage (fgo-storage "form/form-stdlib/bml"))
    (let source-candidate (fgo-dispatch-candidate-at 20 -1))
    (let image-candidate (fgo-dispatch-candidate-at 20 20))
    (let artifact-present (fgo-artifact-presence-at 10))
    (let root-stale (fgo-root-compatibility-at 20 10))
    (let snapshot (fgo-snapshot "/tmp/form-glass-observer-missing-root"))
    (let empty-framebuffer (fgo-framebuffer-rows (list)))
    (let idle-metal (fgo-metal-rows idle-status))
    (let empty-catalog (fgo-flat-kind (list "/tmp/form-glass-observer-missing-root") ".never" "never" "never" "disk-cache"))
    (framebuffer-clear)
    (let written (fgo-write snapshot))
    (let written-event-count (len (framebuffer-events)))
    (let projected-events (fgo-event-rows (framebuffer-events)))
    (let authority (read_file "form/form-stdlib/bml/form-glass-observer.bml"))
    (let executable (read_file "form/form-stdlib/form-glass-observer.bml"))

    (let b0 (fgob-bit (and (eq (fgo-present? unavailable) 0)
                            (and (str_eq (fgo-value-kind unavailable) "absent")
                             (and (str_eq (fgo-evidence unavailable) "unavailable")
                              (and (str_eq (fgo-source unavailable) "kernel.fixture-byte-ledger")
                                   (str_eq (fgo-note unavailable) "not exposed"))))) 1))
    (let b1 (fgob-bit (and (eq (fgo-present? sized) 1)
                            (and (eq (fgo-capacity-present? sized) 1)
                                 (and (eq (fgo-capacity sized) 100)
                                      (str_eq (fgo-plane sized) "disk-cache")))) 2))
    (let b2 (fgob-bit (and (str_eq (fgo-status-text status "device") "Apple Test")
                            (and (eq (fgo-status-int status "buffers") 7)
                                 (eq (fgo-status-int status "missing") -1))) 4))
    (let b3 (fgob-bit (and (eq (fgo-host-total-bytes pressure) 137438953472)
                            (eq (fgo-host-free-percent pressure) 36)) 8))
    (let b4 (fgob-bit (and (eq (len metal) 11)
                            (and (str_eq (fgo-text-value (head metal)) "Apple Test")
                                 (eq (fgo-int-value (nth metal 1)) 7))) 16))
    (let b5 (fgob-bit (and (le (len heat) 12)
                            (and (fgob-descending? heat)
                                 (and (str_eq (fgo-tag-name 1) "int-literal")
                                      (and (str_eq (fgo-tag-name 110) "frame-slot-read")
                                           (and (str_eq (fgo-tag-name 241) "variadic-call")
                                                (eq (fgob-has authority "known evaluator tags project their runtime names") 1)))))) 32))
    (let b6 (fgob-bit (and (gt (len storage) 0)
                            (and (str_eq (fgo-domain (head storage)) "storage")
                                 (or (str_eq (fgo-plane (head storage)) "disk-cache")
                                     (str_eq (fgo-plane (head storage)) "mapped-file")))) 64))
    (let b7 (fgob-bit (and (str_eq (head snapshot) "form-glass-observer-v1")
                            (and (str_eq (nth snapshot 3) "current-process-plus-host-ports")
                                 (str_eq (nth snapshot 4) "cross-process-metrics-bounded-no-argv"))) 128))
    (let b8 (fgob-bit (and (str_eq (head written) "form-glass-observation-frame")
                            (eq (len (nth written 2)) (len (fgo-snapshot-rows snapshot)))) 256))
    (let b9 (fgob-bit (and (eq written-event-count (len (nth written 2)))
                            (gt written-event-count 0)) 512))
    (let b10a (and (eq (fgob-has authority "physical-live") 1)
                    (eq (fgob-has authority "storage catalog") 1)))
    (let b10b (and (eq (fgob-has authority "SpecializationRule") 1)
                    (eq (fgob-has authority "SpecializationEvidenceRule") 1)))
    (let b10c (and (str_eq source-candidate "source")
                    (and (str_eq image-candidate "image")
                         (and (str_eq artifact-present "present")
                              (str_eq root-stale "stale")))))
    (let b10d (and (eq (fgob-has executable "Form specialization image") 1)
                    (and (eq (fgob-has executable "native Form cache") 0)
                         (eq (fgob-has authority "never prompt or answer bytes") 1))))
    (let b10 (fgob-bit (and b10a (and b10b (and b10c b10d))) 1024))
    (let b11 (fgob-bit (and (eq (fgob-has authority "ProcessScopeRule") 1)
                             (and (eq (fgob-has authority "PresenceRule") 1)
                                  (eq (fgob-has authority "MissingDoorRule") 1))) 2048))
    (let b12 (fgob-bit (and (str_eq (fgo-unit sized) "bytes")
                             (and (eq (fgo-int-value sized) 40)
                                  (str_eq (fgo-channel sized) "cache"))) 4096))
    (let b13 (fgob-bit (and (eq (fgo-present? (fgo-text-or-unavailable "host" "x" "x" "" "cpu" "observed" "fixture" "live" "cpu" "missing")) 0)
                             (eq (fgob-has authority "missing text field never becomes a present empty string") 1)) 8192))
    (let b14 (fgob-bit (and (eq (len processes) 2)
                             (and (eq (fgo-ps-rss-bytes (head processes)) 2097152)
                                  (and (eq (fgo-ps-cpu (head processes)) 123)
                                       (eq (fgo-ps-elapsed (head processes)) 3723)))) 16384))
    (let b15 (fgob-bit (and (eq (len processrows) 6)
                             (and (eq (fgo-int-value (head processrows)) 2097152)
                                  (and (eq (fgo-int-value (nth processrows 1)) 123)
                                       (and (eq (fgo-int-value (nth processrows 2)) 3723)
                                            (and (eq (fgo-int-value (nth processrows 3)) 0)
                                                 (eq (len boundedrows) 96)))))) 32768))
    (let b16 (fgob-bit (and (eq (len pidcandidates) 2)
                             (and (str_eq (head pidcandidates) "123")
                                  (and (str_eq (nth pidcandidates 1) "456")
                                       (and (eq (len cappedpids) 32)
                                            (eq (len oversizedpids) 0))))) 65536))
    (let b17 (fgob-bit (and (str_eq (fgo-pid-ps-command "123") "/bin/ps -p 123 -o pid=,rss=,pcpu=,etime=,comm=")
                             (and (str_eq (fgo-pid-ps-command "12;cat") "")
                                  (and (eq (fgob-has executable "/bin/ps -axo") 0)
                                       (and (eq (fgob-has executable "/usr/bin/pgrep -x fkwu") 1)
                                            (and (eq (fgob-has executable "def fgo-live-process-rows()") 1)
                                                 (and (eq (fgob-has authority "never acquires a whole process table") 1)
                                                      (and (eq (fgob-has authority "no shell substitution") 1)
                                                           (eq (fgob-has authority "MaxPidListBytes = 2048") 1)))))))) 131072))
    (let b18 (fgob-bit (and (str_eq (fgo-lifecycle (head empty-framebuffer)) "empty")
                             (and (eq (fgo-int-value (head empty-framebuffer)) 0)
                              (and (eq (fgo-present? (nth empty-framebuffer 1)) 0)
                               (and (str_eq (fgo-source (nth empty-framebuffer 1)) "fkc-table-serialize.kernel_stat:9")
                                (and (str_eq (fgo-lifecycle (nth idle-metal 1)) "empty")
                                 (and (str_eq (fgo-lifecycle (nth idle-metal 4)) "idle")
                                      (str_eq (fgo-text-value (nth empty-catalog 2)) "none(empty catalog)"))))))) 262144))
    (let b19 (fgob-bit (and (eq (fgo-nodeid-bound? sized) 1)
                             (and (eq (fgob-has (fgo-nodeid-value sized) "@") 1)
                              (and (str_eq (fgo-nodeid-state sized) "bound-glass-projection")
                               (and (gt (len projected-events) 0)
                                (and (eq (fgo-source-nodeid-bound? (head projected-events)) 1)
                                     (eq (fgob-has (fgo-source-nodeid-value (head projected-events)) "@") 1)))))) 524288))
    (let b20 (fgob-bit (and (eq (fgob-has authority "SemanticZeroRule") 1)
                             (and (eq (fgob-has authority "FramebufferCounterRule") 1)
                              (and (eq (fgob-has authority "NodeIDRule") 1)
                                   (eq (fgob-has executable "telemetry.nodeid-owner-binding") 1)))) 1048576))
    (let b21 (fgob-bit (and (eq (fgo-status-int colliding-status "buffers") 7)
                             (and (str_eq (fgo-status-text colliding-status "device") "Apple Test")
                              (and (eq (fgo-status-int colliding-status "not_buffers") 91)
                                   (eq (fgob-has authority "immediately after newline") 1)))) 2097152))
    (sum (list b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 b16 b17 b18 b19 b20 b21)))
