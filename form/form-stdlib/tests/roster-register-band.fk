; preludes: form-stdlib/core.fk
; Expected: 15
; PROOF LEVEL: FKWU-STAGED / FOURTH-ARM ONLY (host_spawn and the kernel roster)
;
; roster-register-band — every kernel that starts is seen by the roster, even when a parent starts
; them in the same instant.
;
; The roster (/fg-kernels) is how this host knows which kernels are alive: each fkwu writes its pid
; into a slot when it opens its live page, and kernel_live_pids reads the slots back. On 2026-09-11 it
; named eleven of fifteen running kernels. Three of the missing four had live pages that said alive;
; each had started in the same second as a sibling (the glass fleet starts its organs together), and
; the registration read a free slot and then stored into it, so the last of a burst erased the rest.
; The claim is a compare-and-swap now. Eight sleepers started back to back are the burst.
;
; Verdict 15:
;   1  eight sleepers spawn (host_spawn answers eight pids), after one warm run fills the cache
;   2  while they rest, kernel_live_pids names all eight
;   4  each exits 0
;   8  once they have exited, none of the eight is still named alive
(do
    (defn rrb-cmd () (list "./fkwu" "observe/tests/roster-sleeper.fk"))
    (defn rrb-spawn (n acc) (if (le n 0) acc (rrb-spawn (sub n 1) (cons (host_spawn_quiet (rrb-cmd)) acc))))
    (defn rrb-in? (x xs) (if (eq (len xs) 0) 0 (if (eq (head xs) x) 1 (rrb-in? x (tail xs)))))
    (defn rrb-all-in? (ps live) (if (eq (len ps) 0) 1 (if (eq (rrb-in? (head ps) live) 1) (rrb-all-in? (tail ps) live) 0)))
    (defn rrb-none-in? (ps live) (if (eq (len ps) 0) 1 (if (eq (rrb-in? (head ps) live) 1) 0 (rrb-none-in? (tail ps) live))))
    (defn rrb-all-pos? (ps) (if (eq (len ps) 0) 1 (if (gt (head ps) 0) (rrb-all-pos? (tail ps)) 0)))
    (defn rrb-seen (ps live) (if (eq (len ps) 0) 0 (add (rrb-in? (head ps) live) (rrb-seen (tail ps) live))))
    (defn rrb-wait-all (ps acc) (if (eq (len ps) 0) acc (rrb-wait-all (tail ps) (add acc (if (eq (host_wait (head ps)) 0) 1 0)))))

    (let warm (host_wait (host_spawn_quiet (rrb-cmd))))
    (let pids (rrb-spawn 8 (empty)))
    (let rest (host_sleep_ms 1500))
    (let live (kernel_live_pids))
    (let told (print (list "spawned" (len pids) "seen-while-alive" (rrb-seen pids live))))
    (let waited (rrb-wait-all pids 0))
    (let after (kernel_live_pids))

    (let c0 (if (and (eq (len pids) 8) (eq (rrb-all-pos? pids) 1)) 1 0))
    (let c1 (if (eq (rrb-all-in? pids live) 1) 2 0))
    (let c2 (if (eq waited 8) 4 0))
    (let c3 (if (eq (rrb-none-in? pids after) 1) 8 0))
    (add c0 (add c1 (add c2 c3))))
