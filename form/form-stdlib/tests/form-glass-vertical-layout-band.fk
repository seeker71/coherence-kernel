; All twelve views retain their header and footer coordinates across sizes.
; Expected final verdict: 4095. Pure scene fixtures; no living state writes.
; preludes: form-stdlib/form-glass-live-ui.bml
(do
    (defn fgvb-lines (view width height open)
        (fgd-segment-frame-lines (fgd-live-segment-frame width height 1000 4 1
            view "all" "all" "fixture.selection" open
            (list) (list) (list) "fixture" (list) (list) "fixture-seam")))
    (defn fgvb-id (line) (if (eq (len line) 0) "" (ftc-segment-node-id (head line))))
    (defn fgvb-line-width (line)
        (if (eq (len line) 0) 0
            (add (ftc-text-width (ftc-segment-text (head line))) (fgvb-line-width (tail line)))))
    (defn fgvb-fit (lines width)
        (if (eq (len lines) 0) 1
            (and (le (fgvb-line-width (head lines)) width) (fgvb-fit (tail lines) width))))
    (defn fgvb-frame (view width height open)
        (do (let lines (fgvb-lines view width height open))
            (and (eq (len lines) height)
                (and (str_eq (fgvb-id (head lines)) "glass.header")
                    (and (if (gt height 1) (str_eq (fgvb-id (nth lines (sub height 1))) "glass.footer") 1)
                        (fgvb-fit lines width))))))
    (defn fgvb-evidence (view width)
        (do (let lines (fgvb-lines view width 24 0))
            (str_eq (fgvb-id (nth lines 22)) "evidence.closed")))
    (defn fgvb-view (view)
        (and (fgvb-frame view 80 24 0)
            (and (fgvb-frame view 132 40 1)
                (and (fgvb-frame view 40 10 0)
                    (and (fgvb-frame view 1 1 0)
                        (and (fgvb-frame view 20 2 0) (fgvb-frame view 20 3 0)))))))
    (defn fgvb-check (view evidence)
        (and (fgvb-view view)
            (if evidence (and (fgvb-evidence view 80) (fgvb-evidence view 132)) 1)))
    (defn fgvb-fold (views bit)
        (if (eq (len views) 0) 0
            (add (if (fgvb-check (head (head views)) (nth (head views) 1)) bit 0)
                (fgvb-fold (tail views) (mul bit 2)))))
    (fgvb-fold (list (list "help" 1) (list "atlas" 1) (list "raster" 1)
        (list "overview" 1) (list "memory" 1) (list "flow" 1) (list "recipes" 1)
        (list "meaning" 0) (list "kernel" 0) (list "events" 0)
        (list "channels" 0) (list "choice" 0)) 1))
