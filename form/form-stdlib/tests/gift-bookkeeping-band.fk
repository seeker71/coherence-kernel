; Map/unmap ledger matches actual mapping lifecycle, including kernel readers.
; A private shared-memory name; no live sensor publication. Expected 1023.
; preludes: form-stdlib/core.fk
(do
 (defn gbb-bit (ok bit) (if ok bit 0))
 (let self (kernel_live (host_pid)))
 (let count (kernel_stat 41))
 (let bytes (kernel_stat 42))
 (let name (str_concat "/fg-ledger-" (int_to_str (host_pid))))
 ; 16368 payload + 16 header is a whole host page on both 4K and 16K hosts.
 (let offer (shm_offer name 16368))
 (let grown (list (kernel_stat 41) (kernel_stat 42)))
 (let receiver (shm_receive name))
 (let paired (list (kernel_stat 41) (kernel_stat 42)))
 (let closed (shm_release receiver))
 (let after (list (kernel_stat 41) (kernel_stat 42)))
 (let twice (shm_release receiver))
 (let pages (kernel_live_pids))
 (let hot (kernel_page_hot (host_pid) 3))
 (let boxes (kernel_page_box (host_pid) 3))
 (let released (shm_release offer))
 (let end (list (kernel_stat 41) (kernel_stat 42)))
 (let absent (shm_receive "/fg-ledger-absent-0910"))
 (let live (kernel_live (host_pid)))
 (print (list "gift-ledger" "baseline" (list count bytes) "one" grown "two" paired "after" after "end" end))
 (sum (list
  (gbb-bit (eq (head grown) (add count 1)) 1)
  (gbb-bit (eq (nth grown 1) (add bytes 16384)) 2)
  (gbb-bit (eq (head paired) (add count 2)) 4)
  (gbb-bit (eq (nth paired 1) (add bytes 32768)) 8)
  (gbb-bit (value_eq after grown) 16)
  (gbb-bit (nothing? twice) 32)
  (gbb-bit (value_eq end (list count bytes)) 64)
  (gbb-bit (nothing? absent) 128)
  (gbb-bit (eq (nth live 10) count) 256)
  (gbb-bit (eq (nth live 11) bytes) 512))))
