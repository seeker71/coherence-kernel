; manifest-words-space-band.bml — a gap's manifest line names each definition, by comma or by space (native-turn-manifest.bml, ntl-manifest-of).
;
; The first of two band-first steps split from manifest-words-band.bml (31), which stays the whole witness. This band asks
; one thing: the manifest's one line is cut at commas and at spaces, so "a-1 b?" reads two names as "a-1, b?" does, and a
; single name reads alone. Trimming each name and dropping empty names stay as they are.
;
; Expected: 3
; Verdict 3 when every claim lands:
;   1   a comma line reads each name
;   2   a space line reads each name, and a single name reads alone
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/native-turn-ladder.bml
section [form.bml] {
 class ManifestWordsSpaceBand {
  def mws-is?(goal, want) = (String) ntl-manifest-of(goal).str() == want.str();
  def mws-c-comma(ctx) = mws-is?("g\nDefinition manifest: a-1, b?", ["a-1", "b?"]);
  def mws-c-space(ctx) = mws-is?("g\nDefinition manifest: a-1 b?", ["a-1", "b?"]) && mws-is?("g\nDefinition manifest: one", ["one"]);
 }
 live-claims("manifest-words-space-band", 0, [["comma", 1, 1, mws-c-comma], ["space", 2, 1, mws-c-space]]);
}
