; Failed predictions apply pressure until new learning changes the serving generation.
; preludes: form-stdlib/native-session-memory.bml
(do
 (defn nsrb-state (home adapter skills)
  (nsm-write (nsm-at home "state.json") (json-node-object (list (nsm-s "serving" adapter)
   (json-node-pair "skills" (json-node-array (nsm-string-nodes skills)))))))
 (let home (str_concat "/tmp/session-routing-" (nsm-id)))
 (nsm-init home)
 (let absent (not (nsm-attemptable home "code" "fix")))
 (nsrb-state home "generation-1" (list "dialogue"))
 (let scope (and (nsm-can home "dialogue") (not (nsm-can home "code"))))
 (nsrb-state home "generation-2" (list "code"))
 (let fresh (nsm-attemptable home "code" "fix"))
 (nsm-prediction home "code" "fix" "generation-2" 0 3)
 (let suppressed (not (nsm-attemptable home "code" "fix")))
 (let different (nsm-attemptable home "code" "another contract"))
 (nsrb-state home "generation-3" (list "code"))
 (let retry (nsm-attemptable home "code" "fix"))
 (let private (lt (str_find (nsm-text (nsm-prediction-path home "code" "fix")) "fix" 0) 0))
 (let checks (list absent scope fresh suppressed different retry private))
 (print checks) (fs-remove-tree home)
 (if (value_eq checks (list 1 1 1 1 1 1 1)) 127 (form_error "session prediction pressure failed")))
