; ear-tongue-band.fk — the tongue lane's index and its prefix reuse, pinned against the body's own
; attestants: the record tokenizer against dtk-encode (the vocabulary walked per position) on an
; English, a Persian and a Portuguese prompt; the piece file against l3d-text on a generated line; a
; line said through a shared KV prefix against the same line said through a cold cache; a said
; Portuguese line non-empty and cut at its line break; the streaming step: what two renderings of a
; growing line agree on is a prefix of both, and a step from that committed prefix renders text that
; begins with the committed text (255 -> 1023 on 2026-09-06: two bits for the streaming step). The
; model file is the registry's llama32-1b blob (a model file read); the index lives under .hearth and
; is built on the first run.
; Expected: 1023
; PROOF LEVEL: FOURTH-ARM ONLY (metal handle door)
; preludes: form/form-stdlib/ear-tongue.fk
(do
    (defn etb-bit (ok v) (if ok v 0))
    (defn etb-same? (a b) (if (and (eq (len a) 0) (eq (len b) 0)) 1 (if (or (eq (len a) 0) (eq (len b) 0)) 0 (if (eq (head a) (head b)) (etb-same? (tail a) (tail b)) 0))))
    (let lane (et-lane-open))
    (let src (nth (et-lane-st lane) 10))
    (let dir (nth lane 4))
    (let bos (nth lane 1))
    (let n (nth lane 7))
    (let p1 (et-prompt "Okay, let's try it." "en" "pt"))
    (let p2 (et-prompt "سلام دنیا، حال شما چطور است؟" "fa" "en"))
    (let p3 (et-prompt "Não acredito, vamos tentar já!" "pt" "fa"))
    (let b1 (etb-bit (et-index-ready? src) 1))
    (let b2 (etb-bit (eq (file_size (nth lane 6)) (mul n 8)) 2))
    (let b3 (etb-bit (eq (etb-same? (et-encode dir bos p1) (dtk-encode src p1)) 1) 4))
    (let b4 (etb-bit (eq (etb-same? (et-encode dir bos p2) (dtk-encode src p2)) 1) 8))
    (let b5 (etb-bit (eq (etb-same? (et-encode dir bos p3) (dtk-encode src p3)) 1) 16))
    (let s1 (et-say lane "Okay, let's try it." "en" "pt" 20))
    (let s2 (et-say (nth s1 1) "Now the second line arrives." "en" "pt" 20))
    (let cold (et-say (et-lane-with-loaded (nth s2 1) (list)) "Now the second line arrives." "en" "pt" 20))
    (let gen (et-drop (nth (nth cold 1) 3) (len (et-encode dir bos (et-prompt "Now the second line arrives." "en" "pt")))))
    (let b6 (etb-bit (str_eq (et-detok (nth lane 5) (nth lane 6) n gen "") (l3d-text src gen)) 32))
    (let b7 (etb-bit (str_eq (head s2) (head cold)) 64))
    (let b8 (etb-bit (and (gt (str_len (head s1)) 0) (lt (str_find (head s1) (byte_to_str 10) 0) 0)) 128))
    ; the streaming step: a two-word line, then the line grown to six words from what the two agreed on
    (let st1 (et-say-step (nth cold 1) "The meeting" "en" "pt" (list) (list) 10))
    (let st2 (et-say-step (nth st1 2) "The meeting starts at nine tomorrow" "en" "pt" (list) (head st1) 10))
    (let agreed (nth st2 1))
    (let st3 (et-say-step (nth st2 2) "The meeting starts at nine tomorrow and everyone" "en" "pt" agreed (head st2) 10))
    (let b9 (etb-bit (and (eq (etb-same? agreed (et-take (head st1) (len agreed))) 1) (eq (etb-same? agreed (et-take (head st2) (len agreed))) 1)) 256))
    (let ctext (et-ids-text (nth st3 2) agreed))
    (let stext (et-ids-text (nth st3 2) (head st3)))
    (let b10 (etb-bit (and (eq (etb-same? agreed (et-take (head st3) (len agreed))) 1) (and (ge (str_len stext) (str_len ctext)) (str_eq (substring stext 0 (str_len ctext)) ctext))) 512))
    (let v (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 (add b9 b10))))))))))
    (print_str (int_to_str v))
    v)
