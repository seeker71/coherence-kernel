; ear-tongue-band.fk — the tongue lane's index and its prefix reuse, pinned against the body's own
; attestants: the record tokenizer against dtk-encode (the vocabulary walked per position) on an
; English, a Persian and a Portuguese prompt; the piece file against l3d-text on a generated line; a
; line said through a shared KV prefix against the same line said through a cold cache; a said
; Portuguese line non-empty and cut at its line break; the streaming step: what two renderings of a
; growing line agree on is a prefix of both, and a step from that committed prefix renders text that
; begins with the committed text (255 -> 1023 on 2026-09-06: two bits for the streaming step); the
; batched round (dense-multi, one sequence a tongue): a sequence's ids equal to the single lane's, and
; a grown line through warm banks equal to the same round through cold banks (1023 -> 4095, the same
; day). The model file is the registry's llama32-1b blob (a model file read); the index lives under
; .hearth and is built on the first run — including in a checkout where no hearth stands yet, which
; is what bit 1 was dark for on main (4095 -> 16383 on 2026-09-07: the round's own word on which
; sequences ENDED, and the claim a closed line rests on when it pays nothing — a rendering that
; ended, fed its own prompt again with itself forced, answers nothing new). 16383 -> 65535 on
; 2026-09-08: a rendering cut at its own cycle, and whisper's mark for what is not speech told from a
; line that merely opens and closes with one — both wounds read off a real room's frames. 65535 ->
; 131071 the same day: a rendering the line-cut has already reached has ended, which is what a real
; sentence's last 208 ms were being spent against.
; Verdict 131071 when every claim lands.
; PROOF LEVEL: FOURTH-ARM ONLY (metal handle door)
; preludes: form/form-stdlib/ear-tongue.fk
(do
    (defn etb-bit (ok v) (if ok v 0))
    (defn etb-same? (a b) (if (and (eq (len a) 0) (eq (len b) 0)) 1 (if (or (eq (len a) 0) (eq (len b) 0)) 0 (if (eq (head a) (head b)) (etb-same? (tail a) (tail b)) 0))))
    (let lane (et-lane-open))
    (let src (nth (et-lane-st lane) 10))
    (let dir (nth lane 4))
    (let bos (nth lane 1))
    (let n (nth lane 7))
    (let p1 (et-prompt "Okay, let's try it." "en" "pt"))
    (let p2 (et-prompt "سلام دنیا، حال شما چطور است؟" "fa" "en"))
    (let p3 (et-prompt "Não acredito, vamos tentar já!" "pt" "fa"))
    (let b1 (etb-bit (et-index-ready? src) 1))
    (let b2 (etb-bit (eq (file_size (nth lane 6)) (mul n 8)) 2))
    (let b3 (etb-bit (eq (etb-same? (et-encode dir bos p1) (dtk-encode src p1)) 1) 4))
    (let b4 (etb-bit (eq (etb-same? (et-encode dir bos p2) (dtk-encode src p2)) 1) 8))
    (let b5 (etb-bit (eq (etb-same? (et-encode dir bos p3) (dtk-encode src p3)) 1) 16))
    (let s1 (et-say lane "Okay, let's try it." "en" "pt" 20))
    (let s2 (et-say (nth s1 1) "Now the second line arrives." "en" "pt" 20))
    (let cold (et-say (et-lane-with-loaded (nth s2 1) (list)) "Now the second line arrives." "en" "pt" 20))
    (let gen (et-drop (nth (nth cold 1) 3) (len (et-encode dir bos (et-prompt "Now the second line arrives." "en" "pt")))))
    (let b6 (etb-bit (str_eq (et-detok (nth lane 5) (nth lane 6) n gen "") (l3d-text src gen)) 32))
    (let b7 (etb-bit (str_eq (head s2) (head cold)) 64))
    (let b8 (etb-bit (and (gt (str_len (head s1)) 0) (lt (str_find (head s1) (byte_to_str 10) 0) 0)) 128))
    ; the streaming step: a two-word line, then the line grown to six words from what the two agreed on
    (let st1 (et-say-step (nth cold 1) "The meeting" "en" "pt" (list) (list) 10))
    (let st2 (et-say-step (nth st1 2) "The meeting starts at nine tomorrow" "en" "pt" (list) (head st1) 10))
    (let agreed (nth st2 1))
    (let st3 (et-say-step (nth st2 2) "The meeting starts at nine tomorrow and everyone" "en" "pt" agreed (head st2) 10))
    (let b9 (etb-bit (and (eq (etb-same? agreed (et-take (head st1) (len agreed))) 1) (eq (etb-same? agreed (et-take (head st2) (len agreed))) 1)) 256))
    (let ctext (et-ids-text (nth st3 2) agreed))
    (let stext (et-ids-text (nth st3 2) (head st3)))
    (let b10 (etb-bit (and (eq (etb-same? agreed (et-take (head st3) (len agreed))) 1) (and (ge (str_len stext) (str_len ctext)) (str_eq (substring stext 0 (str_len ctext)) ctext))) 512))
    ; the batched round: the two-word line as three sequences (en sits out; pt, fa, id), pt's ids equal to the
    ; single lane's (bit 1024); the grown line through the same banks equal to the same round through cold
    ; banks (bit 2048). Both bits are 0 when the file sits outside dense-multi's radius (et-mlane-ok? false).
    (let ml (et-mlane-open 4))
    (let mok (et-mlane-ok? ml))
    (defn etb-idss (ml text forceds) (list (list) (append (et-encode (nth ml 4) (nth ml 1) (et-prompt text "en" "pt")) (nth forceds 1)) (append (et-encode (nth ml 4) (nth ml 1) (et-prompt text "en" "fa")) (nth forceds 2)) (append (et-encode (nth ml 4) (nth ml 1) (et-prompt text "en" "id")) (nth forceds 3))))
    (let none (list (list) (list) (list) (list)))
    (let m1 (if mok (et-mround ml (etb-idss ml "The meeting" none) 10) (list none ml)))
    (let b11 (etb-bit (and mok (eq (etb-same? (nth (head m1) 1) (head st1)) 1)) 1024))
    (let forceds (list (list) (nth (head m1) 1) (list) (nth (head m1) 3)))
    (let m2 (if mok (et-mround (nth m1 1) (etb-idss (nth m1 1) "The meeting starts at nine tomorrow" forceds) 10) (list none ml)))
    (let m3 (if mok (et-mround (et-mlane-with-loaded (nth m2 1) none) (etb-idss (nth m2 1) "The meeting starts at nine tomorrow" forceds) 10) (list none ml)))
    (let b12 (etb-bit (and mok (and (eq (etb-same? (nth (head m2) 1) (nth (head m3) 1)) 1) (and (eq (etb-same? (nth (head m2) 2) (nth (head m3) 2)) 1) (eq (etb-same? (nth (head m2) 3) (nth (head m3) 3)) 1)))) 2048))
    ; the round's own word on which sequences ended, and what a caller may do with it. A sequence
    ; that SAT OUT — no ids at all — carries the same born `ended` bit as one that reached an end id,
    ; so `et-mends` says 0 for it (bit 4096): a refusal never reads as an answer.
    (let e1 (if mok (et-mround-go ml (et-mround-open ml (etb-idss ml "The meeting" none)) 0 100000 40) (list (list) 0 1)))
    (let ends1 (if mok (et-mends (head e1)) (list 0 0 0 0)))
    (let b13 (etb-bit (and mok (and (eq (nth ends1 0) 0) (eq (nth ends1 1) 1))) 4096))
    ; the claim a closed line pays nothing on: a rendering that ENDED, offered the same prompt again
    ; with itself forced, generates nothing and ends at once — greedy decoding is one answer to one
    ; prompt, so the line is already said and the frame can land from what is in hand.
    (let ml4 (if mok (et-mround-close ml (head e1) (nth e1 1)) ml))
    (let forced1 (if mok (list (list) (nth (et-mgens (head e1)) 1) (nth (et-mgens (head e1)) 2) (nth (et-mgens (head e1)) 3)) none))
    (let e2 (if mok (et-mround-go ml4 (et-mround-open ml4 (etb-idss ml4 "The meeting" forced1)) 0 100000 40) (list (list) 0 1)))
    (let b14 (etb-bit (and mok (and (eq (len (nth (et-mgens (head e2)) 1)) 0) (eq (nth (et-mends (head e2)) 1) 1))) 8192))
    ; a rendering that has begun to repeat itself, cut at its own cycle (bit 16384). Three copies of
    ; a block are one loop: the first copy is kept and the rest dropped, whatever the block's length;
    ; a line that merely says a word twice is left whole; the cut is its own fixed point.
    (let clean (list 5 9 13 9 21 9))
    (let loop1 (list 5 9 7 7 7 7 7))
    (let loop3 (list 5 40 41 42 40 41 42 40 41 42))
    (let loop2 (list 5 8 6 7 6 7 6 7))
    (let b15 (etb-bit (and (eq (etb-same? (et-loopcut clean) clean) 1)
                      (and (eq (etb-same? (et-loopcut (list 5 9 9)) (list 5 9 9)) 1)
                      (and (eq (etb-same? (et-loopcut loop1) (list 5 9 7)) 1)
                      (and (eq (etb-same? (et-loopcut loop3) (list 5 40 41 42)) 1)
                      (and (eq (etb-same? (et-loopcut loop2) (list 5 8 6 7)) 1)
                      (and (eq (et-looped? clean) 0)
                      (and (eq (et-looped? loop3) 1)
                           (eq (etb-same? (et-loopcut (et-loopcut loop3)) (et-loopcut loop3)) 1)))))))) 16384))
    ; whisper's mark for what is not speech, against a line that merely opens and closes with one
    ; (bit 32768). The second of these stood untranslated in a real room on 2026-09-08.
    (let b16 (etb-bit (and (eq (et-tag? "[Music]") 1)
                      (and (eq (et-tag? "(mouse clicking)") 1)
                      (and (eq (et-tag? "[Music] …") 1)
                      (and (eq (et-tag? "[INAUDIBLE] Like Jill, actually, will go over her. [INAUDIBLE]") 0)
                      (and (eq (et-tag? "[INAUDIBLE] Like Jill, actually, will go over her. [INAUDIBLE] …") 0)
                      (and (eq (et-tag? "The body observed the glass.") 0)
                           (eq (et-tag? "") 0))))))) 32768))
    ; a rendering the line-cut has already reached has ended, whatever the model's own end ids say
    ; (bit 65536): the break arrives inside a PIECE far more often than as one of the four ids
    ; `et-ends?` knows, and a round that does not notice writes a paragraph the cut then discards.
    (let cutids (tail (et-encode dir bos (str_concat "abc" (str_concat (byte_to_str 10) "def")))))
    (let plainids (tail (et-encode dir bos "abc def")))
    (let b17 (etb-bit (and (eq (et-ids-cut? lane cutids) 1)
                      (and (eq (et-ids-cut? lane plainids) 0)
                      (and (str_eq (et-ids-text lane cutids) "abc")
                           (str_eq (et-ids-text lane plainids) "abc def")))) 65536))
    (let v (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 (add b9 (add b10 (add b11 (add b12 (add b13 (add b14 (add b15 (add b16 b17)))))))))))))))))
    (print_str (int_to_str v))
    v)
