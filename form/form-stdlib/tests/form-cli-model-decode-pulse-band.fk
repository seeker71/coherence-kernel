; form-cli-model-decode-pulse-band.fk -- opaque progress is a kernel frame.
; preludes: form-stdlib/form-cli-model-session.fk

(do
    (framebuffer-clear)
    (let pulse (fcms-decode-pulse 1))
    (if (and (eq pulse 0)
             (and (eq (len (framebuffer-events)) 1)
             (and (eq (fcms-decode-checkpoint? 1) 1)
             (and (eq (fcms-decode-checkpoint? 2) 0)
             (and (eq (fcms-decode-next-left 1 1) 1)
             (and (eq (fcms-decode-next-width 1 1) 2)
             (and (eq (fcms-decode-next-left 2 2) 1)
                  (eq (fcms-decode-next-width 2 2) 2)))))))) 127 0))
