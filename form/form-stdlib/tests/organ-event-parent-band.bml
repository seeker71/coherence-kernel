; organ-event-parent-band.bml — an organ's event reaches a checkout that has no event directory yet (organ-health.bml, oh-emit-valid).
;
; A fresh checkout holds no .form-heal, so its first organ event stops a movement with "organ health event transport is
; incomplete". The event's own directory is made as the event is written; a transport that truly refuses keeps its stop.
;
; Expected: 15
; Verdict 15 when every claim lands:
;   1   an event to a path whose directory does not stand answers its row
;   2   that file then holds the event's one line
;   4   a second event to the same path appends: two lines
;   8   a path whose parent is a file still stops: the row is not answered and nothing stands there
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/organ-health.bml
section [form.bml] {
 class OrganEventParentBand {
  def oep-dir() = ".hearth/oep-band-" + host_pid().str();
  def oep-file() = oep-dir() + "/events.jsonl";
  def oep-row() = oh-reading("oep","flow","a",json-node-string("x"),json-node-string("x"),json-node-int(1),[],[],json-node-null());
  def oep-lines() = len(filter(l => (Comparable) len(l) > 0, split-on(read_file(oep-file()) ?? "", "\n")));
  def oep-row?(r) = !nothing?(r) && ((String) value_kind(r) != "string") && ((String) value_kind(r) != "int") && ((String) oh-str(r, "organ") == "oep");
  def oep-c-row(ctx) {
   let root = fs_mkdir(".hearth");
   oep-row?(oh-emit-valid(oep-file(), oep-row()));
  }
  def oep-c-file(ctx) = (Comparable) oep-lines() == 1;
  def oep-c-append(ctx) = oep-row?(oh-emit-valid(oep-file(), oep-row())) && (Comparable) oep-lines() == 2;
  def oep-c-refused(ctx) {
   let r = try oh-emit-valid("MANIFEST.md/events.jsonl", oep-row()) else "stopped";
   (String) value_kind(r) == "string" && (String) r == "stopped" && nothing?(read_file("MANIFEST.md/events.jsonl"));
  }
 }
 let verdict = live-claims("organ-event-parent-band", 0, [["row", 1, 1, oep-c-row], ["file", 2, 1, oep-c-file], ["append", 4, 1, oep-c-append], ["refused", 8, 1, oep-c-refused]]);
 let gone = fs_remove(oep-file());
 let empty = host_dir_rmdir(oep-dir());
 verdict;
}
