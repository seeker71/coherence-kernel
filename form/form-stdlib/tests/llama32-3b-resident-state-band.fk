; llama32-3b-resident-state-band.fk — reusable-open ownership surface.
; The physical dual-model runner owns the 2 GB effectful witness.
;
; preludes: form-stdlib/core.fk
;
; Verdict 255: 127 executable-source + 128 high-BML authority.

(do
    (defn l3rsb-has (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let executable (read_file "form/form-stdlib/llama32-3b-resident-state.bml"))
    (let c0 (if (eq (l3rsb-has executable "def l3rs-open(path, maxpos)") 1) 1 0))
    (let c1 (if (eq (l3rsb-has executable "def l3rs-residency-handle(slot)") 1) 2 0))
    (let c2 (if (eq (l3rsb-has executable "def l3rs-prefill(slot, ids)") 1) 4 0))
    (let c3 (if (eq (l3rsb-has executable "def l3rs-step(slot)") 1) 8 0))
    (let c4 (if (eq (l3rsb-has executable "def l3rs-close(slot)") 1) 16 0))
    (let c5 (if (eq (l3rsb-has executable "l3rs-free-layers(l3rs-layers(slot))") 1) 32 0))
    (let c6 (if (eq (l3rsb-has executable "l3rs-pending-text") 1) 64 0))
    (let base (sum (list c0 c1 c2 c3 c4 c5 c6)))
    (let authority (read_file "form/form-stdlib/bml/llama32-3b-resident-state.bml"))
    (let high (if (eq (l3rsb-has authority "const String RetainRule = \"close is explicit; a completed turn does not imply release\"") 1)
        (if (eq (l3rsb-has authority "const String PhysicalRule = \"residence requires a positive mmap-backed embedding Metal handle\"") 1)
            (if (and (eq (l3rsb-has authority "LifecycleRule") 1)
                     (eq (l3rsb-has executable "\"warm\"") 0)) 128 0) 0) 0))
    (add base high))
