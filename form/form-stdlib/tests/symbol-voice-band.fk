; symbol-voice-band.fk — the body speaks its own symbols back as words.
; Expected: 63
;   1 fixed words   2 key:value   4 evidence mark suffix   8 a hex id is a node
;   16 an unknown word is an offer, a number is itself   32 a corpus word carries its sentence
; preludes: form/form-stdlib/symbol-voice.bml
(do
    (defn svb-bit (ok bit) (if ok bit 0))
    (sum (list
        (svb-bit (str_eq (sv-say "us DO admit") "this sitting, did, admitted") 1)
        (svb-bit (str_eq (sv-say "heard:42 grammar:x1") "[heard?] = 42, [grammar?] = [x1?]") 2)
        (svb-bit (str_eq (sv-say "admit* refuse~") "admitted (physically live), refused (declared)") 4)
        (svb-bit (str_eq (sv-say "58b22cae") "node 58b22cae") 8)
        (svb-bit (and (str_eq (sv-say "zorble 7") "[zorble?], 7") (str_eq (sv-say "a | b") "[a?]. [b?]")) 16)
        (svb-bit (ge (str_find (sv-say "farside") "farside, the word for: where does a symbol that never returns die" 0) 0) 32))))
