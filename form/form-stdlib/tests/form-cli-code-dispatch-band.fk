; The real form-cli command door; no model request is admitted. Expected 7.
; preludes: form-stdlib/form-cli.fk
(do
 (if (not (str_eq (fc-respond "response-repair help") (frr-help))) (form_error "response repair help is not routed through the public command") 0)
 (if (lt (str_find (fc-respond "response-repair @") "resource-request-file-unavailable-or-oversized" 0) 0) (form_error "response repair file boundary is not routed through the public command") 0)
 (add (if (ge (str_find (fc-respond "code help") "local Qwen" 0) 0) 1 0)
  (add (if (ge (str_find (fc-respond "code invalid") "invalid-or-oversized-request-json" 0) 0) 2 0)
   (if (ge (str_find (fc-respond "help") "code <JSON>" 0) 0) 4 0))))
