; framebuffer-value-cache-band.fk -- repeated access reuses one witnessed
; content-addressed value without reconstructing its builder.
; Verdict 255 proves eight identity, one-build, presence, source, and bounded
; lifetime properties.
; preludes: form-stdlib/core.fk form-stdlib/framebuffer-value-cache.fk observe/live-call-framebuffer.fk

(do
    (framebuffer-clear)
    (let value-category (bp "FBVC-TEST-VALUE"))

    (defn fbvc-test-build ()
        (do
            (let observed
                (lcfb-call-stream-elapsed
                    "fbvc-band" "fixture-build" "enter" "form-native"
                    "fbvc-test-build" "offered-fixture" 1 0
                    "form/form-stdlib/tests/framebuffer-value-cache-band.fk"
                    14 17))
            (intern_node value-category (list (intern_trivial_int 42)))))

    (defn fbvc-test-value ()
        (do
            (let found (fbvc-find (fbvc-key "offered-fixture")))
            (if (eq (fbvc-hit? found) 1)
                (fbvc-value found)
                (do
                    (let value (fbvc-test-build))
                    (let stored
                        (fbvc-store (fbvc-key "offered-fixture") value
                            "form/form-stdlib/tests/framebuffer-value-cache-band.fk"
                            29 25))
                    value))))

    (let first (fbvc-test-value))
    (let second (fbvc-test-value))
    (let found (fbvc-find (fbvc-key "offered-fixture")))
    (let events (framebuffer-events))
    (let entry-source (node_source (nth events 1)))

    (sum (list
        (if (node_eq first second) 1 0)
        (if (eq (len events) 2) 2 0)
        (if (eq (fbvc-hit? found) 1) 4 0)
        (if (node_eq (fbvc-value found) first) 8 0)
        (if (eq (lcfb-call? (nth events 0)) 1) 16 0)
        (if (eq (fbvc-entry? (nth events 1)) 1) 32 0)
        (if (str_eq (nth entry-source 0)
                "form/form-stdlib/tests/framebuffer-value-cache-band.fk")
            64 0)
        (if (and (eq (nth entry-source 1) 29)
                 (eq (nth entry-source 2) 25))
            128 0))))
