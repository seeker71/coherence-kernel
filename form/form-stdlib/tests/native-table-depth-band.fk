; Large generated literals and row sets keep their bytes without linear stack use.
; preludes: form-stdlib/bml/native-table-compile.bml
(do
 (defn ntd-double (s n)
  (if (eq n 0) s (ntd-double (str_concat s s) (sub n 1))))
 (defn ntd-rows (n rows)
  (if (eq n 0) rows (ntd-rows (sub n 1) (cons (list 1 0 0 0) rows))))
 (let large (ntd-double "x" 16))
 (let escaped (ntd-double "\\n" 15))
 (let mixed (str_concat "Ω" (str_concat "\\\\" (str_concat "\\\"" "尾"))))
 (let rows (ntd-rows 32768 (list)))
 (sum (list
  (if (str_eq (flt-unescape large) large) 1 0)
  (if (str_eq (flt-unescape escaped) (ntd-double (byte_to_str 10) 15)) 2 0)
  (if (str_eq (flt-unescape mixed) (str_concat "Ω\\\"" "尾")) 4 0)
  (if (str_eq (fks-lit-sp large 0) (ntd-double " 120" 16)) 8 0)
  (if (str_eq (form_table_text (list 1 0) rows)
       (str_concat "2 0 1 32768" (ntd-double " 1 0 0 0" 15))) 16 0)
  (if (str_eq (flt-unescape "tail\\") "tail\\") 32 0)
  (if (str_eq (form_table_text (list) (list)) "0 0") 64 0))))
