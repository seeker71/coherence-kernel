; Third process: restore the plural prediction field, follow only the active
; successor whose evidence names the retained learning cell, explicitly retire
; the old prediction, and separately consent to selection and execution.
; The below-threshold alternative and offered unknown remain present.
; Verdict 65535 proves sixteen adoption, execution, and carrier claims.
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk form-stdlib/tests/living-world-durable-learning-witness.fk

(do
    (let loaded (lwdlw-load-image (lwdlw-after-path)))
    (let image (lwcd-result-image loaded))
    (let restored-round (lwdlw-restored-round image))
    (let restored (lwt-round-world restored-round))
    (let open-field (lwacw-field-for restored))
    (let eligible
        (lwac-eligible-items restored
            (lwo-field-items (lwac-field-candidates open-field)) 2
            (lwo-empty-field)))
    (let active-learning (lwdlw-active-learning restored))
    (let learning-candidate (lwdlw-only active-learning))
    (let current-learning (lwdlw-current-learning restored 2))
    (let successors
        (lwdlw-successor-offers restored learning-candidate))
    (let successor (lwdlw-only successors))
    (let adopted-round
        (lwdlw-adopted-round restored successor restored-round))
    (let adopted (lwt-round-world adopted-round))
    (let ready-field (lwacw-field-for adopted))
    (let selections (lwdlw-current-selections adopted))
    (let executions (lwdlw-current-executions adopted))
    (let execution-candidate (lwdlw-only executions))
    (let execution (lwo-emergent-shape execution-candidate))
    (let saved (lwdlw-save-image (lwdlw-final-path) adopted))
    (lwdlw-sum
        (list
            (if (eq (lwcd-loaded? loaded) 1) 1 0)
            (if (eq (lwcn-image-valid? image) 1) 2 0)
            (if (and (eq (lwac-open? (lwac-field-status open-field)) 1)
                     (and (eq (lwo-field-size
                                (lwac-field-candidates open-field)) 3)
                          (and (eq (lwo-field-size eligible) 2)
                               (node_eq (lwac-field-primary open-field)
                                        (lwo-none))))) 4 0)
            (if (and (eq (lwo-field-size active-learning) 1)
                     (eq (lwo-field-size current-learning) 0)) 8 0)
            (if (eq (lwo-field-size successors) 1) 16 0)
            (if (eq (lwdlw-successor-reoffered?
                        restored successor) 1) 32 0)
            (if (and (eq (lwo-active-by? adopted (lwacw-offer-a)
                              (lwacw-source-c)) 0)
                     (eq (lwo-active-by? adopted (lwacw-offer-a)
                              (lwacw-source-d)) 0)) 64 0)
            (if (and (eq (lwo-active-by? adopted successor
                              (lwacw-source-c)) 1)
                     (eq (lwo-active-by? adopted successor
                              (lwacw-source-d)) 1)) 128 0)
            (if (and (eq (lwac-ready?
                              (lwac-field-status ready-field)) 1)
                     (node_eq
                        (lwac-intention-prediction
                            (lwac-intention-evidence-intention
                                (lwac-field-primary ready-field)))
                        (lwacw-actual-delta))) 256 0)
            (if (and (eq (lwo-field-size selections) 1)
                     (eq (lwo-field-size executions) 1)) 512 0)
            (if (node_eq (lwac-execution-prediction execution)
                         (lwacw-actual-delta)) 1024 0)
            (if (node_eq (lwac-execution-actual execution)
                         (lwacw-actual-delta)) 2048 0)
            (if (eq (oac-one?
                        (lwac-execution-comparison execution)) 1) 4096 0)
            (if (gt (lwo-field-size
                        (lwac-execution-alternatives execution)) 0) 8192 0)
            (if (gt (lwo-field-size
                        (lwac-execution-unknowns execution)) 0) 16384 0)
            (if (and (eq (lwcd-saved? saved) 1)
                     (eq (fs-exists? (lwdlw-final-path)) 1)) 32768 0))))
