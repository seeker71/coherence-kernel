; form-cli-lora-cover-band.fk — coverage curve; remaining is counted, not guessed.
;
; Verdict 1023:
;   1..128  fco-check (lens 72/72, most=0, 990k=0, session ppm, need 95 events, fqt-lora=0)
;   256     class descriptor FormLoraCover minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-lens-mint.bml
; preludes: form-stdlib/form-cli-lane-mint.bml
; preludes: form-stdlib/form-cli-lora-cover.bml
; witnessed: 2026-08-26 -> 1023; lens 72/72 at tn=1; session need 95 events; more mill N does not climb 990k; fqt-lora=0

(do
    (defn fcob-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn fcob-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (fcob-has-name? (tail xs) name))))

    (let bits (fco-check))
    (let desc (FormLoraCover))
    (let src (read_file "form/form-stdlib/bml/form-cli-lora-cover.bml"))
    (let exe (read_file "form/form-stdlib/form-cli-lora-cover.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormLoraCover")
                     (and (eq (fcob-has-name? (nth desc 2) "T") 1)
                          (and (eq (fcob-has-name? (nth desc 3) "fco-ppm") 1)
                               (eq (fcob-has-name? (nth desc 4) "TargetMostPpm") 1))))
                256 0))
    (let b9 (if (and (eq (fcob-has-str? src "package Form.cli.loracover") 1)
                     (and (eq (fcob-has-str? src "interface ILoraCover") 1)
                          (and (eq (fcob-has-str? src "class FormLoraCover") 1)
                               (and (eq (fcob-has-str? src "const int TargetMostPpm") 1)
                                    (and (eq (fcob-has-str? src "template CoverRow") 1)
                                         (and (eq (fcob-has-str? exe "heldout-v3") 0)
                                              (eq (fcob-has-str? exe "turn_started") 0)))))))
                512 0))
    (add bits (add b8 b9)))
