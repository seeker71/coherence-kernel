; form-program-image-call-protocol-band.fk -- unseen resident images call
; through exact content-addressed CALL_BINDING / OFFER / ACK data.
; Expected 2097151.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-cli-current-answer-thought-walk.fk
; preludes: form-stdlib/form-program-image-call-protocol.fk

(do
    (defn fpcpb-bit (held weight) (if held weight 0))
    (defn fpcpb-literal-image (value)
        (fcatw-image (empty) (list (fcatw-row 1 value 0 0)) (empty) 0))
    (defn fpcpb-one-arg-image (value)
        (fcatw-image (list (fcatw-kind-int))
            (list (fcatw-row 1 value 0 0)) (empty) 0))
    (defn fpcpb-images (bindings) (fcatw-registry bindings))
    (defn fpcpb-category-sequence? (categories expected)
        (if (nil? categories) (if (eq expected 137) 1 0)
            (if (and (eq (node_pkg (head categories)) 31)
                (and (eq (node_level (head categories)) 2)
                (and (eq (node_type (head categories)) 0)
                     (eq (node_inst (head categories)) expected))))
                (fpcpb-category-sequence? (tail categories)
                    (add expected 1)) 0)))

    (defn form-program-image-call-protocol-band ()
        (do
            ; Both symbols and both bodies are born after the reducer source.
            (let caller-symbol (str_concat "pulse/" "caller-after-protocol"))
            (let callee-symbol (str_concat "pulse/" "callee-after-protocol"))
            (let caller-image (fpcpb-literal-image (add 700000 1)))
            (let callee-image (fpcpb-literal-image (add 271000 828)))
            (let caller (fcatw-binding caller-symbol caller-image))
            (let callee (fcatw-binding callee-symbol callee-image))
            (let capability (intern_trivial_string
                (str_concat "capability/" "fresh-content")))
            (let correlation (intern_trivial_string
                (str_concat "correlation/" "whole-node")))
            (let call (fpcp-call-binding caller "invoke" callee capability))
            (let images (fpcpb-images (list caller callee)))
            (let protocol (fpcp-registry images (list capability) (list call)))
            (let offer (fpcp-offer call correlation (empty) 1))
            (let ack (fpcp-execute protocol offer))

            ; Capability is content and the exact relation must be admitted.
            (let other-capability (intern_trivial_string
                (str_concat "capability/" "not-admitted")))
            (let other-call (fpcp-call-binding caller "invoke" callee
                other-capability))
            (let other-offer (fpcp-offer other-call correlation (empty) 1))
            (let other-ack (fpcp-execute protocol other-offer))
            (let denied-protocol (fpcp-registry images (empty) (list call)))
            (let denied-ack (fpcp-execute denied-protocol offer))

            ; Exact absence and malformed presence remain different.
            (let absent-offer (fpcp-execute protocol (nothing)))
            (let malformed-offer (intern_node (fpcp-category 134)
                (list call)))
            (let malformed-ack (fpcp-execute protocol malformed-offer))
            (let malformed-protocol (intern_node (fpcp-category 133)
                (empty)))
            (let malformed-protocol-ack
                (fpcp-execute malformed-protocol offer))

            ; Fuel and ABI refusal do not fabricate an output.
            (let timeout-offer (fpcp-offer call correlation (empty) 0))
            (let timeout-ack (fpcp-execute protocol timeout-offer))
            (let arg-image (fpcpb-one-arg-image 9))
            (let arg-callee (fcatw-binding "pulse/arg-callee" arg-image))
            (let arg-call (fpcp-call-binding caller "invoke-arg" arg-callee
                capability))
            (let arg-protocol (fpcp-registry
                (fpcpb-images (list caller arg-callee)) (list capability)
                (list arg-call)))
            (let abi-refused (fpcp-execute arg-protocol
                (fpcp-offer arg-call correlation (empty) 1)))

            ; Ambiguity is choice.  Explicit cut selects an offered image;
            ; undo restores the prior registry and the same offer sees choice.
            (let callee-image2 (fpcpb-literal-image (add 271000 829)))
            (let callee2 (fcatw-binding callee-symbol callee-image2))
            (let conflicted-images (fpcpb-images (list caller callee callee2)))
            (let conflicted (fpcp-registry conflicted-images
                (list capability) (list call)))
            (let choice-ack (fpcp-execute conflicted offer))
            (let cut (fcatw-cut conflicted-images callee-symbol callee-image))
            (let cut-protocol (fpcp-registry-with-images conflicted
                (fcatw-movement-registry cut)))
            (let cut-ack (fpcp-execute cut-protocol offer))
            (let undo-protocol (fpcp-registry-with-images conflicted
                (fcatw-undo cut)))
            (let undo-ack (fpcp-execute undo-protocol offer))

            ; Present 0, present 1, an executed typed argument list, and
            ; nothing cross as distinct value nodes.
            (let zero-image (fpcpb-literal-image 0))
            (let one-image (fpcpb-literal-image 1))
            (let zero-binding (fcatw-binding "pulse/zero" zero-image))
            (let one-binding (fcatw-binding "pulse/one" one-image))
            (let zero-call (fpcp-call-binding caller "zero" zero-binding
                capability))
            (let one-call (fpcp-call-binding caller "one" one-binding
                capability))
            (let value-protocol (fpcp-registry
                (fpcpb-images (list caller zero-binding one-binding))
                (list capability)
                (list zero-call one-call)))
            (let zero-offer (fpcp-offer zero-call correlation (empty) 1))
            (let one-offer (fpcp-offer one-call correlation (empty) 1))
            (let zero-ack (fpcp-execute value-protocol zero-offer))
            (let one-ack (fpcp-execute value-protocol one-offer))
            (let nothing-value (fpcp-value (fcatw-kind-nothing) (nothing)))
            (let list-value (fpcp-value (fcatw-kind-list)
                (list (fpcp-value (fcatw-kind-int) 0)
                      (fpcp-value (fcatw-kind-string) ""))))
            (let list-image (fcatw-image
                (list (fcatw-kind-int) (fcatw-kind-string))
                (list (fcatw-row 2 0 0 0)) (empty) 0))
            (let list-binding (fcatw-binding "pulse/list" list-image))
            (let list-call (fpcp-call-binding caller "list" list-binding
                capability))
            (let list-protocol (fpcp-registry
                (fpcpb-images (list caller list-binding)) (list capability)
                (list list-call)))
            (let list-offer (fpcp-offer list-call correlation
                (list (fpcp-value (fcatw-kind-int) 0)
                      (fpcp-value (fcatw-kind-string) "")) 1))
            (let list-ack (fpcp-execute list-protocol list-offer))
            ; A non-tag2 list return has no recursive element-kind tree in the
            ; compact walker. It is refused after three observed reducer steps
            ; rather than being mislabeled or having its consumed fuel erased.
            (let nested-list-image (fcatw-image
                (list (fcatw-kind-list))
                (list (fcatw-row 2 0 0 0)
                      (fcatw-row 1 0 0 0)
                      (fcatw-row 23 0 1 0)) (empty) 2))
            (let nested-list-binding
                (fcatw-binding "pulse/nested-list" nested-list-image))
            (let nested-list-call (fpcp-call-binding caller "nested-list"
                nested-list-binding capability))
            (let nested-list-protocol (fpcp-registry
                (fpcpb-images (list caller nested-list-binding))
                (list capability) (list nested-list-call)))
            (let nested-list-offer (fpcp-offer nested-list-call correlation
                (list (fpcp-value (fcatw-kind-list)
                    (list (fpcp-value (fcatw-kind-int) 0)
                          (fpcp-value (fcatw-kind-int) 1)))) 3))
            (let nested-list-ack
                (fpcp-execute nested-list-protocol nested-list-offer))
            (let forged-absence (intern_node (fpcp-category 136)
                (list (intern_trivial_string "not-nothing"))))
            (let forged-ack (fpcp-ack offer "returned"
                "resident-thought-returned"
                (fpcp-value (fcatw-kind-int) 99) 1 1
                "offer,resolve,call,return,ack,release"))

            (let protocol-source (read_file
                "form/form-stdlib/form-program-image-call-protocol.fk"))
            (let categories (list
                (fpcp-category 131) (fpcp-category 132)
                (fpcp-category 133) (fpcp-category 134)
                (fpcp-category 135) (fpcp-category 136)))

            (sum (list
                (fpcpb-bit (and (eq (len categories) 6)
                    (eq (fpcpb-category-sequence? categories 131) 1)) 1)
                (fpcpb-bit (and (eq (fpcp-value-valid? nothing-value) 1)
                    (and (nothing? (fpcp-value-raw nothing-value))
                    (and (eq (fpcp-value-valid?
                        (intern_node (fpcp-category 131)
                            (list (intern_trivial_int (fcatw-kind-nothing))
                                  forged-absence))) 0)
                         (not (node_eq nothing-value
                            (fpcp-ack-value zero-ack)))))) 2)
                (fpcpb-bit (and (eq (fpcp-value-valid? list-value) 1)
                    (and (eq (len (fpcp-value-raw list-value)) 2)
                    (and (str_eq (nth (fpcp-value-raw list-value) 1) "")
                    (and (str_eq (fpcp-ack-status list-ack) "returned")
                    (and (eq (fpcp-value-kind (fpcp-ack-value list-ack))
                             (fcatw-kind-list))
                    (and (eq (len (fpcp-value-raw
                            (fpcp-ack-value list-ack))) 2)
                    (and (eq (fpcp-ack-valid? list-ack) 1)
                    (and (eq (fpcp-ack-observed?
                                list-protocol list-offer list-ack) 1)
                    (and (str_eq (fpcp-ack-status nested-list-ack) "refused")
                    (and (str_eq (fpcp-ack-reason nested-list-ack)
                                "return-list-kind-unavailable")
                    (and (eq (fpcp-ack-steps nested-list-ack) 3)
                         (eq (fpcp-ack-observed? nested-list-protocol
                            nested-list-offer nested-list-ack) 1)))))))))))) 4)
                (fpcpb-bit (and (eq (fpcp-call-valid? call) 1)
                    (and (eq (fpcp-registry-valid? protocol) 1)
                    (and (eq (fpcp-offer-valid? offer) 1)
                    (and (eq (fpcp-ack-valid? ack) 1)
                    (and (eq (fpcp-ack-observed? protocol offer ack) 1)
                    (and (eq (fpcp-ack-valid? forged-ack) 1)
                    (and (eq (fpcp-ack-observed?
                                protocol offer forged-ack) 0)
                         (eq (fpcp-ack-observed?
                                value-protocol zero-offer one-ack) 0)))))))) 8)
                (fpcpb-bit (and (str_eq (fpcp-ack-status ack) "returned")
                    (and (eq (fpcp-value-raw (fpcp-ack-value ack)) 271828)
                    (and (eq (fpcp-ack-steps ack) 1)
                         (eq (fpcp-ack-output ack) 1)))) 16)
                (fpcpb-bit (node_eq (fpcp-ack-correlation ack) correlation) 32)
                (fpcpb-bit (and (eq (fcatw-image-valid? caller-image) 1)
                    (and (eq (fcatw-image-valid? callee-image) 1)
                    (and (lt (str_find protocol-source
                              "pulse/callee-after-protocol" 0) 0)
                         (lt (str_find protocol-source "271828" 0) 0)))) 64)
                (fpcpb-bit (and (str_eq (fpcp-ack-status other-ack) "nothing")
                    (and (str_eq (fpcp-ack-reason other-ack)
                                 "call-binding-not-admitted")
                    (and (eq (fpcp-ack-output other-ack) 0)
                    (and (str_eq (fpcp-ack-status denied-ack) "refused")
                         (str_eq (fpcp-ack-reason denied-ack)
                            "capability-refused"))))) 128)
                (fpcpb-bit (and (str_eq (fpcp-ack-status malformed-ack) "refused")
                    (and (str_eq (fpcp-ack-reason malformed-ack)
                        "offer-malformed")
                    (and (eq (fpcp-ack-valid? malformed-ack) 1)
                         (eq (fpcp-ack-observed? protocol malformed-offer
                            malformed-ack) 1)))) 256)
                (fpcpb-bit (nothing? absent-offer) 512)
                (fpcpb-bit (and (str_eq (fpcp-ack-status timeout-ack) "timeout")
                    (and (eq (fpcp-ack-output timeout-ack) 0)
                    (and (ge (str_find (fpcp-ack-trace timeout-ack)
                                      "timeout" 0) 0)
                         (eq (fpcp-ack-observed? protocol timeout-offer
                            timeout-ack) 1)))) 1024)
                (fpcpb-bit (and (str_eq (fpcp-ack-status abi-refused) "refused")
                    (and (str_eq (fpcp-ack-reason abi-refused)
                                 "offer-abi-refused")
                         (eq (fpcp-ack-output abi-refused) 0))) 2048)
                (fpcpb-bit (and (str_eq (fpcp-ack-status choice-ack) "choice")
                    (and (eq (fpcp-ack-output choice-ack) 0)
                         (str_eq (fpcp-ack-trace choice-ack)
                            "offer,choice,ack,release"))) 4096)
                (fpcpb-bit (and (str_eq (fcatw-movement-reason cut) "choice-cut")
                    (and (str_eq (fpcp-ack-status cut-ack) "returned")
                         (eq (fpcp-value-raw (fpcp-ack-value cut-ack))
                             271828))) 8192)
                (fpcpb-bit (and (node_eq (fcatw-undo cut) conflicted-images)
                    (str_eq (fpcp-ack-status undo-ack) "choice")) 16384)
                (fpcpb-bit (and (str_eq (fpcp-ack-status zero-ack) "returned")
                    (and (eq (fpcp-value-kind (fpcp-ack-value zero-ack))
                             (fcatw-kind-int))
                    (and (eq (fpcp-value-raw (fpcp-ack-value zero-ack)) 0)
                         (eq (fpcp-ack-output zero-ack) 1)))) 32768)
                (fpcpb-bit (and (str_eq (fpcp-ack-status one-ack) "returned")
                    (and (eq (fpcp-value-raw (fpcp-ack-value one-ack)) 1)
                         (not (node_eq (fpcp-ack-value zero-ack)
                                       (fpcp-ack-value one-ack))))) 65536)
                (fpcpb-bit (and (not (node_eq call other-call))
                    (and (node_eq (fpcp-child call 0) caller)
                         (node_eq (fpcp-child call 2) callee))) 131072)
                (fpcpb-bit (and
                    (str_eq (fpcp-ack-status malformed-protocol-ack) "refused")
                    (and (str_eq (fpcp-ack-reason malformed-protocol-ack)
                        "protocol-registry-malformed")
                    (and (eq (fpcp-ack-valid? malformed-protocol-ack) 1)
                         (eq (fpcp-ack-observed? malformed-protocol offer
                            malformed-protocol-ack) 1)))) 262144)
                (fpcpb-bit (and (eq (fpcp-value-kind (fpcp-ack-value ack))
                                         (fcatw-kind-int))
                    (and (eq (fpcp-value-kind nothing-value)
                             (fcatw-kind-nothing))
                         (not (node_eq (fpcp-ack-value ack) nothing-value)))) 524288)
                (fpcpb-bit (and (lt (str_find protocol-source "(host-exec " 0) 0)
                    (and (lt (str_find protocol-source "jit_leaf" 0) 0)
                    (and (lt (str_find protocol-source "fcnkr-stage" 0) 0)
                         (lt (str_find protocol-source "fcnkr-query" 0) 0)))) 1048576)))))

    (form-program-image-call-protocol-band))
