; dsv4-validation-tokenizer-live.fk -- the exact production validation prompt
; through the model's own tokenizer, without entering tensor execution.
;
; This is a live integration witness, not a fixture tokenizer: it opens the
; selected DS4 GGUF, builds the same payload/schema as `form-cli validate`,
; encodes it, decodes it in one vocabulary walk, and prints every token id.
; Verdict 7 means: a non-empty token stream, byte-identical ASCII round trip,
; and the model-specific chat/control envelope in the right positions.
;
; preludes: form-stdlib/dsv4-tokenizer.fk form-stdlib/dsv4-validation-protocol.fk

(do
  (defn dvt-model ()
    "/Users/ursmuff/models/ds4-engine/gguf/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf")
  (defn dvt-ids-tail (ids acc)
    (if (eq (len ids) 0) acc
      (dvt-ids-tail (tail ids)
        (str_concat acc (str_concat " " (int_to_str (head ids)))))))
  (defn dvt-ids-text (ids)
    (if (eq (len ids) 0) "" (dvt-ids-tail (tail ids) (int_to_str (head ids)))))
  (defn dvt-score (ok bit) (if ok bit 0))

  (let payload (dvp-payload
    "What is the capital of France?"
    "Paris is the capital of France."
    "France has its national capital at Paris."
    "answer directly from the supplied evidence"))
  (let prompt (dvp-prompt payload))
  (let src (tkz-src (dvt-model)))
  (let body-ids (tkz-encode src prompt))
  (let chat-ids (dvp-chat-ids body-ids))
  (let roundtrip (tkz-decode-text src body-ids))
  (print_str (str_concat "prompt_bytes=" (int_to_str (str_len prompt))))
  (print_str (str_concat "body_token_count=" (int_to_str (len body-ids))))
  (print_str (str_concat "chat_token_count=" (int_to_str (len chat-ids))))
  (print_str (str_concat "body_token_ids=" (dvt-ids-text body-ids)))
  (let c1 (dvt-score (gt (len body-ids) 0) 1))
  (let c2 (dvt-score (str_eq roundtrip prompt) 2))
  (let c3 (dvt-score
    (and (eq (nth chat-ids 0) (dvp-bos))
      (and (eq (nth chat-ids 1) (dvp-user))
        (and (eq (nth chat-ids (sub (len chat-ids) 2)) (dvp-assistant))
             (eq (nth chat-ids (sub (len chat-ids) 1)) (dvp-no-think))))) 4))
  (let verdict (add c1 (add c2 c3)))
  (print_str (str_concat "Verdict " (int_to_str verdict)))
  verdict)
