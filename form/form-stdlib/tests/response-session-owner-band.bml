; response-session-owner-band.bml — the retained session's owner reading: is the recorded owner pid a process the host holds now.
; The reading ran `/bin/ps -p PID -o stat=` through an argv child; it is host_alive now (a zombie is not alive). The reading is still
; "current PID presence only; a present PID may belong to another lifetime" and the band holds exactly that much: presence, absence and the unrecorded case.
; No session is admitted and nothing is written: the root named does not exist, so no manifest is read.
;
;   1     present: the owner is this process's own pid: pid_observation "present", process_state "alive", the recorded pid echoed
;   2     absent: the owner is a pid no process holds: pid_observation "absent", process_state "" (the pid is still echoed)
;   4     unrecorded: an owner with no pid (0) is "unavailable", its recorded_pid null, and the scope sentence is carried in every case
;
; Expected: 7
; Verdict 7
; REQUIRES: the host door host_alive (a seed door; the sibling kernels carry no host doors)
; preflight-exec: forbidden
; preludes: form-stdlib/bml/form-cli-response-session.bml
section [form.bml] {
 class ResponseSessionOwnerBand {
  def rsb-owner(pid) = parse-json("owner", "{\"owner_pid\":" ++ pid.str() ++ "}");
  def rsb-reading(pid) = frss-retained-reading("/no/such/response-session-root", rsb-owner(pid));
  def rsb-owner-of(reading) = json-object-get(reading, "owner");
  def rsb-text(node, key) = json-string-value(json-object-get(node, key));
  def rsb-scope?(node) = str_find(rsb-text(node, "scope"), "Current PID presence only", 0) >= 0;
  def rsb-c-present() {
   let o = rsb-owner-of(rsb-reading(host_pid()));
   (String) rsb-text(o, "pid_observation") == "present" && (String) rsb-text(o, "process_state") == "alive" && json-int-value(json-object-get(o, "recorded_pid")) == host_pid() && rsb-scope?(o);
  }
  def rsb-c-absent() {
   let o = rsb-owner-of(rsb-reading(2147483646));
   (String) rsb-text(o, "pid_observation") == "absent" && (String) rsb-text(o, "process_state") == "" && json-int-value(json-object-get(o, "recorded_pid")) == 2147483646 && rsb-scope?(o);
  }
  def rsb-c-unrecorded() {
   let o = rsb-owner-of(rsb-reading(0));
   (String) rsb-text(o, "pid_observation") == "unavailable" && (String) rsb-text(o, "process_state") == "" && rsb-scope?(o);
  }
  def rsb-run() {
   let b1 = rsb-c-present() ? 1 : 0;
   let b2 = rsb-c-absent() ? 2 : 0;
   let b4 = rsb-c-unrecorded() ? 4 : 0;
   let verdict = b1 + b2 + b4;
   let shown = print(["response-session-owner-band", "verdict", verdict]);
   verdict;
  }
 }
 rsb-run();
}
