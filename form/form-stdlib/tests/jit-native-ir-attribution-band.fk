; Verdict 7: validate the source of each actual instruction, including a
; malformed source inserted into an otherwise admitted program.
; preludes: observe/jit-native-ir.fk
(do
    (let good (jnir-instr (jnir-op-return) 1 (jnir-sample-source)))
    (let bad (jnir-instr (jnir-op-return) 1 (jnir-bad-source)))
    (add
        (if (eq (jnir-ops-attributed? (list good)) 1) 1 0)
        (add
            (if (eq (jnir-ops-attributed? (list bad)) 0) 2 0)
            (if (eq (jnir-ops-attributed? (list good bad)) 0) 4 0))))
