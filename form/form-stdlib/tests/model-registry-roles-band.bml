; model-registry-roles-band.bml — voices by role, admitted by behavior, cooled by their own failures.
; preludes: form-stdlib/model-registry.bml
; Verdict 255
;
; The fixture voice is a scratch artifact with its seal, codec index and crystal, and a scratch admission
; ledger read back through the carrier. Its architecture wiring is passed in, so no model header is opened.
;     1  mr-chain resolves ordered rows per role; an unknown role holds no voice
;     2  readiness is not a name: katcoder reads 0 (no admission row), the chain is the role table
;     4  a fresh passing admission row for (voice, role) with sealed sidecars and a wired arch reads 1
;     8  no row, another role's row, or a failed row reads 0; katcoder's recorded gap row (its header reads
;        qwen35moe, the unwired qsx lane) reads 0 even where the arch is passed in as wired
;    16  a row older than the artifact reads 0
;    32  a missing sidecar or an unwired arch reads 0 even with a fresh row
;    64  backoff steps one, two, four; a probe after the third rest; unavailable after a failed probe;
;        a success resets the voice
;   128  the context fit: prompt plus the minimum completion replies within the context
section [form.bml] {
 class ModelRegistryRolesBand {
  def mrb-claim(ok, bit) = if ok then bit else 0;
  def mrb-row-line(voice, role, passed, at) = "{\"at_unix_ms\":" + (at.str() + (",\"voice\":\"" + (voice + ("\",\"role\":\"" + (role + ("\",\"passed\":" + (passed.str() + ",\"generated_ids\":120,\"wall_ms\":90000}\n")))))));
  def mrb-names(rows) = map(r => mr-name(r), rows);
  // katcoder's gap row as observe/voice-admission-run.bml wrote it (receipts/voice-admission.jsonl), its time
  // moved past the fixture artifact: the header read qwen35moe, no lane ran, passed 0
  def mrb-katcoder-gap(at) = "{\"at_unix_ms\":" + (at.str() + ",\"voice\":\"katcoder\",\"role\":\"write-code\",\"passed\":0,\"task\":\"guarded-edit-then-done\",\"lane\":\"not-run\",\"status\":\"refused\",\"reason\":\"architecture-not-wired\",\"gap\":\"architecture qwen35moe rides lane qsx, which is not wired\",\"arch\":\"qwen35moe\",\"arch_lane\":\"qsx\",\"wired\":0,\"readiness\":\"artifact=1 seal=0 tokfast=0 crystal=0\",\"artifact_mtime_s\":1785197903}");
  def mrb-score(dir) {
   let chain = mr-chain("write-code");
   let c1 = mrb-claim(((Value) mrb-names(chain) == ["qwen38-q8", "qwen38-q4", "katcoder"]) && ((String) mr-path(chain[1]) == mr-path(mr-find("qwen38-q4"))) && ((Value) mrb-names(mr-chain("diagnose")) == ["qwen38-q8"]) && ((Value) mrb-names(mr-chain("triage")) == ["qwen38-q4"]) && nil?(mr-chain("paint")), 1);
   let c2 = mrb-claim(((Comparable) mr-session-ready?("katcoder", "write-code") == 0) && mr-in-chain?("katcoder", "write-code") && (!mr-in-chain?("qwen38-q8", "triage")) && ((String) mr-name(mr-first-ready("paint")) == ""), 2);
   let art = dir + "/voice.gguf";
   let w1 = write_file_text(art, "GGUF fixture");
   let w2 = write_file_text(art + mr-suffix-seal(), "seal");
   let w3 = write_file_text(art + mr-suffix-tokfast(), "tokfast");
   let w4 = write_file_text(art + mr-suffix-crystal(), "crystal");
   let voice = mr-row("qwen38-q4", art, "fast-answer review");
   let fresh = (file_mtime(art) * 1000) + 1000;
   let adm = dir + "/voice-admission.jsonl";
   let a1 = write_file_text(adm, mrb-row-line("qwen38-q8", "write-code", 1, fresh) + mrb-row-line("qwen38-q4", "write-code", 1, fresh));
   let c3 = mrb-claim(((Comparable) mr-sides-ready?(voice) == 1) && ((Comparable) mr-row-ready-with(voice, "write-code", adm, r => 1) == 1), 4);
   let none = dir + "/none.jsonl";
   let other = dir + "/other.jsonl";
   let failed = dir + "/failed.jsonl";
   let a2 = write_file_text(other, mrb-row-line("qwen38-q4", "triage", 1, fresh));
   let a3 = write_file_text(failed, mrb-row-line("qwen38-q4", "write-code", 0, fresh));
   let gapped = dir + "/gap.jsonl";
   let kat = mr-row("katcoder", art, "code");
   let a5 = write_file_text(gapped, mrb-katcoder-gap(fresh) + "\n");
   let c4 = mrb-claim(((Comparable) mr-row-ready-with(voice, "write-code", none, r => 1) == 0) && ((Comparable) mr-row-ready-with(voice, "write-code", other, r => 1) == 0) && ((Comparable) mr-row-ready-with(voice, "triage", other, r => 1) == 1) && ((Comparable) mr-row-ready-with(voice, "write-code", failed, r => 1) == 0) && ((Comparable) mr-row-ready-with(kat, "write-code", gapped, r => 1) == 0) && ((Comparable) mr-wired?("qwen35moe") == 0) && ((String) mr-lane-for("qwen35moe") == "qsx"), 8);
   let stale = dir + "/stale.jsonl";
   let a4 = write_file_text(stale, mrb-row-line("qwen38-q4", "write-code", 1, 1000));
   let c5 = mrb-claim((Comparable) mr-row-ready-with(voice, "write-code", stale, r => 1) == 0, 16);
   let unwired = mr-row-ready-with(voice, "write-code", adm, r => 0);
   let gone = fs_remove(art + mr-suffix-crystal());
   let c6 = mrb-claim(((Comparable) unwired == 0) && ((Comparable) mr-sides-ready?(voice) == 0) && ((Comparable) mr-row-ready-with(voice, "write-code", adm, r => 1) == 0), 32);
   let cooled = [mr-backoff(1), mr-backoff(2), mr-backoff(3)];
   let s1 = mr-cooldown([[5, 0]], 6);
   let s2 = mr-cooldown([[5, 0]], 7);
   let s3 = mr-cooldown([[5, 0], [7, 0]], 8);
   let s4 = mr-cooldown([[5, 0], [7, 0], [10, 0]], 12);
   let s5 = mr-cooldown([[5, 0], [7, 0], [10, 0]], 15);
   let s6 = mr-cooldown([[5, 0], [7, 0], [10, 0], [15, 0]], 16);
   let s7 = mr-cooldown([[5, 0], [7, 0], [8, 1]], 9);
   let c7 = mrb-claim(((Value) cooled == [1, 2, 4]) && ((String) s1[0] == "cooling") && ((Comparable) s1[1] == 1) && ((String) s2[0] == "ready") && ((String) s3[0] == "cooling") && ((Comparable) s3[1] == 2) && ((String) s4[0] == "cooling") && ((Comparable) s4[1] == 3) && ((String) s5[0] == "probe") && ((String) s6[0] == "unavailable") && ((String) s7[0] == "ready") && ((Comparable) s7[2] == 0), 64);
   let c8 = mrb-claim(mr-context-fits?(12000, 1024, 3, 16384) && (!mr-context-fits?(15000, 1024, 3, 16384)), 128);
   print_str("model-registry-roles-band claims " + (c1.str() + (" " + (c2.str() + (" " + (c3.str() + (" " + (c4.str() + (" " + (c5.str() + (" " + (c6.str() + (" " + (c7.str() + (" " + c8.str())))))))))))))));
   c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8;
  }
  def mrb-run() {
   let dir = temp_dir() + ("/mr-roles-band-" + (host_pid().str() + ("-" + now_unix_ms().str())));
   let made = fs_mkdir(dir);
   let score = mrb-score(dir);
   let gone = fs_rmdir(dir);
   score;
  }
 }
 mrb-run();
}
