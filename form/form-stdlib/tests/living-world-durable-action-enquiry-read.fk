; Second process: load inertly, wait without consent, then freshly restore the
; exact unresolved question and its plural stance history before revocation.
; Verdict 65535 proves sixteen inert-load, fresh-consent, identity, and no-action bits.
; witnessed: 2026-08-08 -> 65535 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-action-enquiry.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk form-stdlib/tests/living-world-action-enquiry-witness.fk form-stdlib/tests/living-world-durable-action-enquiry-witness.fk

(do
    (let loaded (lwdaeq-load))
    (let image (lwcd-result-image loaded))
    (let stored (lwcn-image-world image))
    (let stored-questions (lwdaeq-questions stored))
    (let stored-question (lwdaeq-only stored-questions))
    (let stored-evidence
        (lwae-stance-evidence-for stored stored-question))
    (let admission (lwdaeq-admission-world image))
    (let proposal (lwcn-restore-proposal admission image))
    (let candidate (lwt-proposal-candidate proposal))
    (let waiting-round (lwdaeq-waiting-round image))
    (let waiting (lwt-round-world waiting-round))
    (let restored-round (lwdaeq-restored-round image))
    (let restored (lwt-round-world restored-round))
    (let restored-questions (lwdaeq-questions restored))
    (let restored-question (lwdaeq-only restored-questions))
    (let restored-evidence
        (lwae-stance-evidence-for restored restored-question))
    (let evidence-items (lwo-field-items restored-evidence))
    (let immediate-evidence (lwdaeq-evidence-immediate evidence-items))
    (let immediate
        (lwae-stance-evidence-stance immediate-evidence))
    (let pending
        (lwae-stance-evidence-stance
            (lwdaeq-evidence-pending evidence-items)))
    (let timed-alternative
        (lwae-stance-evidence-stance
            (lwdaeq-evidence-timed-alternative evidence-items)))
    (let expired-nothing
        (lwae-stance-evidence-stance
            (lwdaeq-evidence-expired-nothing evidence-items)))
    (let stack
        (lwlc-declaration-stack (lwae-stance-declaration pending)))
    (let restored-field
        (lwae-question-field (lwo-emergent-shape restored-question)))
    (let revoked (lwdaeq-revoked-world restored))
    (let score
        (lwdaeq-sum
            (list
                (if (eq (lwcd-loaded? loaded) 1) 1 0)
                (if (eq (lwcn-image-valid? image) 1) 2 0)
                (if (and (eq (lwo-field-size stored-questions) 1)
                         (eq (lwo-field-size stored-evidence) 4)) 4 0)
                (if (and (eq (lwo-field-size
                                  (lwdaeq-questions admission)) 0)
                         (and (eq (lwo-field-size
                                      (lwae-stance-evidence-for
                                          admission stored-question)) 0)
                              (and (eq (lwo-field-size
                                          (lwdaeq-current-selections
                                              admission)) 0)
                                   (eq (lwo-field-size
                                          (lwdaeq-current-executions
                                              admission)) 0)))) 8 0)
                (if (eq (lwcn-restored? waiting candidate) 0) 16 0)
                (if (node_eq (lwt-proposal-participants proposal)
                        (lwcn-active-sources stored)) 32 0)
                (if (eq (lwcn-restored? restored candidate) 1) 64 0)
                (if (and (eq (lwo-field-size restored-questions) 1)
                         (and (node_eq restored-question stored-question)
                              (eq (lwae-question-steady?
                                    restored restored-question) 1))) 128 0)
                (if (eq (lwo-field-size restored-evidence) 4) 256 0)
                (if (and (eq (lwo-field-size
                                  (lwo-active-attributions-for
                                      restored immediate)) 2)
                         (eq (lwo-field-size
                                  (lwae-stance-evidence-attributions
                                      immediate-evidence)) 1)) 512 0)
                (if (and (not (node_eq pending (lwo-none)))
                         (and (not (node_eq timed-alternative (lwo-none)))
                              (not (node_eq expired-nothing
                                        (lwo-none))))) 1024 0)
                (if (and (eq (lwlc-lens?
                                  (lwlc-stack-default stack)) 1)
                         (and (eq (len (lwlc-layer-items
                                          (lwlc-stack-layers stack))) 2)
                              (and (eq (lwo-field-size
                                          (lwlc-stack-alternatives stack)) 1)
                                   (eq (lwlc-unknown?
                                          (lwlc-stack-unknown stack)) 1))))
                    2048 0)
                (if (and (eq (lwae-stance-alternative?
                                  timed-alternative) 1)
                         (and (eq (lwae-stance-expired-to-nothing?
                                      expired-nothing) 1)
                              (not (node_eq immediate
                                        expired-nothing)))) 4096 0)
                (if (node_eq restored-field
                        (lwac-field-for restored (lwacw-focus) 2)) 8192 0)
                (if (and (eq (lwo-field-size
                                  (lwdaeq-current-selections restored)) 0)
                         (eq (lwo-field-size
                                  (lwdaeq-current-executions restored)) 0))
                    16384 0)
                (if (and (eq (lwae-question-current?
                                  revoked restored-question) 0)
                         (eq (lwo-field-size
                                  (lwae-stance-evidence-for
                                      revoked restored-question)) 0))
                    32768 0))))
    (lwdaeq-clean)
    score)
