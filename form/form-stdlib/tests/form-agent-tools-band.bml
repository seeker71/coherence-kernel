; form-agent-tools-band.bml — the copyable commands of docs/form-native-agent-tools.md, sent as JSON.
;
; preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/bml/form-agent-tool-wire.bml
;
; Every request is the JSON an agent pastes into form-cli's text face. It goes to fat-wire-call, the
; function that face hands a raw JSON object to (fc-tool-wire in form/form-stdlib/form-cli.fk), over
; the doc's three-document corpus, and the response is read back through the wire's own JSON reader.
; A row holds when the response carries the wire schema, the exit, an empty stderr, the doc's stdout
; and no host crossing.
;
; grep is the sixteenth row, and the second half of this band is its proof. Its rows run over the three-document
; corpus widened by two documents (notes.txt, src/code.txt) or over held input, always through the same wire; a
; row holds when exit and stdout are exact and stderr is empty, or names the error it is meant to name.
;
; Verdict 4294967295 when every claim lands:
;   1 rg · 2 jq · 4 read · 8 cat · 16 head · 32 tail · 64 wc · 128 sort · 256 uniq · 512 tr
;   1024 cut · 2048 awk · 4096 sed · 8192 edit · 16384 write   the table's first fifteen rows, one each
;   32768   the handoff: edit, then write with the edit's documents, then read with the write's: the
;           read answers the held note and the edited text stands in the returned corpus
;   65536   a pipeline: the rg response's stdout is the next request's input to head -n 1
;   131072  a pipe spelled in the command is a structured refusal (exit 2,
;           shell-syntax-not-supported), and the corpus comes back unchanged
;   262144  jq -nr --arg x 'a b' '$x' answers a b
;   524288     grep -n beta alpha.txt: the table's sixteenth row, 2:beta 2
;   1048576    selection: -n -c -v -i -m, and -c printing 0 with exit 1
;   2097152    output shape: -o (one match a line, -n numbered, leftmost-longest), -w (a retry past a word that
;              is part of a longer one), -x
;   4194304    context: -A -B -C -NUM, the -- between groups that do not touch, none between ones that do
;   8388608    patterns: ERE alternation, intervals and groups, BRE \( \) \{ \} \| \+ and backreferences,
;              [[:class:]], \< \>, a plus that is only a plus in BRE
;   16777216   -F with . ( [ $ in the needle, -e given twice, a pattern holding a newline as two patterns
;   33554432   several documents: the file prefix, -h, -H, -l, -L, -c per file, -r over a directory, over
;              "." and over the corpus, a -- between groups of two files
;   67108864   exit codes and stderr: 1 for no line, 2 with a named error for a bad pattern, flag or
;              absent document, -q 0 with a line though another operand errored, -s quiet
;   134217728  held input: no file reads it, - names it, -H calls it (standard input), no final newline
;   268435456  the old pipeline of symbol-voice, grep -m1 -B2 | head -2 | grep -o | tr -d | tr, as five
;              calls whose stdout feeds the next input, answers the sentence the shell produced
;   536870912  the library door: grep-text, grep-lines and grep-text-error answer what the wire answers, and
;              the same sentence comes out of the library calls
;   1073741824 grep refuses a pipe as shell-syntax-not-supported and leaves the corpus as it came
;   2147483648 the catalog: sixteen resident names, grep a native kernel:call row, fat-call answers it
section [form.bml] {
 class FormAgentToolsBand {
  def fatb-bit(ok, bit) = ok ? bit : 0;
  def fatb-docs() = [["source:alpha", "alpha.txt", "alpha 1\nbeta 2\n"], ["source:table", "table.txt", "left:right\nup:down\n"], ["source:package", "package.json", "{\"name\":\"demo\",\"version\":1}"]];
  def fatb-doc-json(d) = "{\"id\":" + json-quote-string(d[0]) + ",\"path\":" + json-quote-string(d[1]) + ",\"text\":" + json-quote-string(d[2]) + "}";
  def fatb-docs-json(docs) = "[" + foldl((acc, d) => acc == "" ? fatb-doc-json(d) : acc + "," + fatb-doc-json(d), "", docs) + "]";
  def fatb-request(command, input, docs-json) = "{\"command\":" + json-quote-string(command) + ",\"input\":" + json-quote-string(input) + ",\"documents\":" + docs-json + "}";
  def fatb-send(command, input, docs-json) = faj-json("form-agent-tools-band", fat-wire-call(fatb-request(command, input, docs-json)));
  def fatb-field(r, key) = node_value(json-object-get(r, key));
  def fatb-docs-of(r) = json-emit(json-object-get(r, "documents"));
  def fatb-text-of(r, path) {
   let hits = filter(d => fatb-field(d, "path") == path, node_children(json-object-get(r, "documents")));
   nil?(hits) ? nothing() : fatb-field(hits[0], "text");
  }
  def fatb-held?(r, exit, stdout) = fatb-field(r, "schema") == "form-agent-tool-wire-v1" && fatb-field(r, "exit") == exit && fatb-field(r, "stderr") == "" && fatb-field(r, "stdout") == stdout && fatb-field(r, "crossings") == 0;
  def fatb-row(command, input, stdout) = fatb-held?(fatb-send(command, input, fatb-docs-json(fatb-docs())), 0, stdout);
  def fatb-edit() = fatb-send("edit alpha.txt 'beta 2' 'gamma 3'", "", fatb-docs-json(fatb-docs()));
  def fatb-edited?() = fatb-held?(fatb-edit(), 0, "edited\n") && fatb-text-of(fatb-edit(), "alpha.txt") == "alpha 1\ngamma 3\n";
  def fatb-handoff() {
   let written = fatb-send("write notes.md", "held note\n", fatb-docs-of(fatb-edit()));
   let read = fatb-send("read notes.md", "", fatb-docs-of(written));
   fatb-held?(written, 0, "created\n") && fatb-held?(read, 0, "held note\n") && fatb-text-of(read, "alpha.txt") == "alpha 1\ngamma 3\n";
  }
  def fatb-pipeline() {
   let found = fatb-send("rg -nF 'alpha 1'", "", fatb-docs-json(fatb-docs()));
   let first = fatb-send("head -n 1", fatb-field(found, "stdout"), fatb-docs-of(found));
   fatb-held?(first, 0, "alpha.txt:1:alpha 1\n");
  }
   def fatb-paged() {
   let docs=[["unicode","unicode.txt","é\nx"]];
   let split=fat-call(docs,"read",["unicode.txt","2","1","bytes"],"");
   let guarded=["unicode.txt","1","2","bytes",fat-document-sha(docs[0])];
   let stale=fat-call([["unicode","unicode.txt","a\nx"]],"read",guarded,"");
   fatb-row("read alpha.txt 2 1","","beta 2\n") && fatb-row("read alpha.txt 2 3 bytes","","lph") && fatb-row("read alpha.txt 50 1","","") && fatb-row("read alpha.txt 1 0","","") && fat-exit(fat-call(docs,"read",["unicode.txt","0","1"],""))==2 && fat-out(fat-call(docs,"read",["unicode.txt","2","1"],""))=="x" && fat-out(fat-call(docs,"read",guarded,""))=="é" && fat-exit(split)==2 && fat-documents(split)==docs && fat-crossings(split)==0 && fat-exit(stale)==2 && fat-starts(fat-error(stale),"read-source-changed");
   }
   def fatb-match(pattern, text, ic, whole, expected) = (Value) fap-search(fap-compile(pattern)[0], text, ic, whole) == expected;
   def fatb-patterns() = fatb-match("a*ab", "aaaab", 0, 0, [0, 5])
    && fatb-match("a+ab", "aaaab", 0, 0, [0, 5]) && fatb-match("a?ab", "ab", 0, 0, [0, 2])
    && fatb-match("a?ab", "aab", 0, 0, [0, 3]) && fatb-match("a*ac", "aaaab", 0, 0, [-1, -1])
    && fatb-match("^a.*b$", "a xy b", 0, 0, [0, 6]) && fatb-match("a|ab", "ab", 0, 0, [0, 1])
    && fatb-match("b|a", "ab", 0, 0, [0, 1]) && fatb-match("cat", "scatter cat!", 0, 1, [8, 11])
    && fatb-match("foo", "xxFOO", 1, 0, [2, 5]) && fatb-match("aa$", "aaa", 0, 0, [1, 3])
    && fatb-match("[a-c]+\\d?", "xxabc7!", 0, 0, [2, 6])
    && fatb-match("a*a*a*a*Z", fat-join(range(0, 1000) |> map(i => "a"), ""), 0, 0, [-1, -1])
    && fatb-match(fat-join(append(range(0, 40) |> map(i => "unused-symbol-" + i.str()), ["native-symbol"]), "|"), "native-symbol", 0, 0, [0, 13])
    && fap-glob("**/*.bml", "x.bml") && fap-glob("**/*.bml", "a/b/x.bml")
    && fap-glob("*/*.bml", "a/x.bml") && !fap-glob("*/*.bml", "a/b/x.bml");
  def fatb-refusal() {
   let r = fatb-send("rg alpha | head -n 1", "", fatb-docs-json(fatb-docs()));
   fatb-field(r, "exit") == 2 && fatb-field(r, "stdout") == "" && str_find(fatb-field(r, "stderr"), "shell-syntax-not-supported", 0) >= 0
   && fatb-text-of(r, "alpha.txt") == "alpha 1\nbeta 2\n";
  }

  // ---- grep ----
  // the corpus widened by two documents, and one request over it
  def fatb-gdocs() = append(fatb-docs(), [["source:notes", "notes.txt", "Alpha one\nbeta two\nalpha three\n\nlast Alpha\n"], ["source:code", "src/code.txt", "int alpha;\nint beta;\n"]]);
  def fatb-gsend(command, input) = fatb-send(command, input, fatb-docs-json(fatb-gdocs()));
  // a row is [command, held input, exit, stdout, a fragment stderr must hold; "" means stderr is empty]
  def fatb-grow?(row) {
   let r = fatb-gsend(row[0], row[1]);
   fatb-field(r, "schema") == "form-agent-tool-wire-v1" && fatb-field(r, "exit") == row[2] && fatb-field(r, "stdout") == row[3]
   && (row[4] == "" ? fatb-field(r, "stderr") == "" : str_find(fatb-field(r, "stderr"), row[4], 0) >= 0)
   && fatb-field(r, "crossings") == 0;
  }
  def fatb-gall?(rows) = all?(row => fatb-grow?(row), rows);
  def fatb-abc() = "a\nb\nc\nd\ne\nf\ng\nh\n";
  def fatb-needles() = "a.b\naxb\nf(x)\n[y]\n$HOME\n";
  def fatb-g-select() = fatb-gall?([
   ["grep -n beta alpha.txt", "", 0, "2:beta 2\n", ""],
   ["grep -n alpha notes.txt", "", 0, "3:alpha three\n", ""],
   ["grep -c alpha notes.txt", "", 0, "1\n", ""],
   ["grep -ic alpha notes.txt", "", 0, "3\n", ""],
   ["grep -v -n -i alpha notes.txt", "", 0, "2:beta two\n4:\n", ""],
   ["grep -m1 -i alpha notes.txt", "", 0, "Alpha one\n", ""],
   ["grep -w -c alph notes.txt", "", 1, "0\n", ""],
   ["grep -c -v -e a -e b", "a\nb\nc\nd\n", 0, "2\n", ""],
   ["grep -m 0 a", "a\n", 1, "", ""]]);
  def fatb-g-shape() = fatb-gall?([
   ["grep -o -i alpha notes.txt", "", 0, "Alpha\nalpha\nAlpha\n", ""],
   ["grep -on -i alpha notes.txt", "", 0, "1:Alpha\n3:alpha\n5:Alpha\n", ""],
   ["grep -o -E 'a|al|alp|alpha' notes.txt", "", 0, "a\na\nalpha\na\na\n", ""],
   ["grep -w beta notes.txt", "", 0, "beta two\n", ""],
   ["grep -w foo", "foobar foo\n", 0, "foobar foo\n", ""],
   ["grep -w foo", "foobar\nxfoo\nfoo-bar\n", 0, "foo-bar\n", ""],
   ["grep -ow 'fo*'", "fooo foo fob\n", 0, "fooo\nfoo\n", ""],
   ["grep -x 'last Alpha' notes.txt", "", 0, "last Alpha\n", ""],
   ["grep -x last notes.txt", "", 1, "", ""],
   ["grep -ov a", "a\nb\n", 0, "", ""],
   ["grep -o 'x*'", "aaa\n", 0, "", ""]]);
  def fatb-g-context() = fatb-gall?([
   ["grep -n -A1 c", fatb-abc(), 0, "3:c\n4-d\n", ""],
   ["grep -B1 c", fatb-abc(), 0, "b\nc\n", ""],
   ["grep -C1 -n -E 'c|g'", fatb-abc(), 0, "2-b\n3:c\n4-d\n--\n6-f\n7:g\n8-h\n", ""],
   ["grep -A1 -E 'b|d'", fatb-abc(), 0, "b\nc\nd\ne\n", ""],
   ["grep -A1 -E 'a|g'", fatb-abc(), 0, "a\nb\n--\ng\nh\n", ""],
   ["grep -2 e", fatb-abc(), 0, "c\nd\ne\nf\ng\n", ""],
   ["grep -n -m 2 -A 1 a", "a\na\na\nb\n", 0, "1:a\n2:a\n3-a\n", ""],
   ["grep -o -A1 a", "a\n", 2, "", "context-with-only-matching-not-supported"]]);
  def fatb-g-regex() = fatb-gall?([
   ["grep -E 'alpha|beta' notes.txt", "", 0, "beta two\nalpha three\n", ""],
   ["grep -E '^[a-z]{4} [Aa]lpha$' notes.txt", "", 0, "last Alpha\n", ""],
   ["grep -E '(al|be)[a-z]{2,4} ' notes.txt", "", 0, "beta two\nalpha three\n", ""],
   ["grep -E '^(a|b)$'", "a\nb\nab\n", 0, "a\nb\n", ""],
   ["grep -E '(a*)*'", "b\n", 0, "b\n", ""],
   ["grep '\\(ab\\)\\1'", "abab\nabba\nxx\n", 0, "abab\n", ""],
   ["grep '\\(.\\)\\1'", "abab\nabba\nxx\n", 0, "abba\nxx\n", ""],
   ["grep -E '(a)\\1'", "aa\nab\n", 0, "aa\n", ""],
   ["grep -i '\\(a\\)\\1'", "aA\nab\n", 0, "aA\n", ""],
   ["grep '\\(a\\|b\\)*c'", "abac\nc\nd\n", 0, "abac\nc\n", ""],
   ["grep 'a\\{2,\\}'", "a\naa\naaa\n", 0, "aa\naaa\n", ""],
   ["grep 'a+b'", "a+b\naab\n", 0, "a+b\n", ""],
   ["grep -E 'a+b'", "a+b\naab\n", 0, "aab\n", ""],
   ["grep 'a\\+b'", "a+b\naab\n", 0, "aab\n", ""],
   ["grep '^*a'", "*a\nba\n", 0, "*a\n", ""],
   ["grep 'a$b'", "a$b\nab\n", 0, "a$b\n", ""],
   ["grep -E '^[[:upper:]][[:lower:]]+ [[:alpha:]]+$' notes.txt", "", 0, "Alpha one\n", ""],
   ["grep -E '[^[:space:]]+@[[:alnum:].]+'", "me@x.org\nnope\n", 0, "me@x.org\n", ""],
   ["grep -i '[a-c]x'", "Bx\nDx\n", 0, "Bx\n", ""],
   ["grep '\\<one\\>' notes.txt", "", 0, "Alpha one\n", ""]]);
  def fatb-g-fixed() = fatb-gall?([
   ["grep -F 'a.b'", fatb-needles(), 0, "a.b\n", ""],
   ["grep 'a.b'", fatb-needles(), 0, "a.b\naxb\n", ""],
   ["grep -F 'f(x)'", fatb-needles(), 0, "f(x)\n", ""],
   ["grep -F '[y]'", fatb-needles(), 0, "[y]\n", ""],
   ["grep -F '$HOME'", fatb-needles(), 0, "$HOME\n", ""],
   ["grep -e 'f(x)' -e '\\[y\\]'", fatb-needles(), 0, "f(x)\n[y]\n", ""],
   ["grep -F -e 'a.b' -e 'HOME'", fatb-needles(), 0, "a.b\n$HOME\n", ""],
   ["grep -F 'a.b\nHOME'", fatb-needles(), 0, "a.b\n$HOME\n", ""],
   ["grep -Fx 'a.b'", "a.b\na.bc\n", 0, "a.b\n", ""],
   ["grep -Fw 'a.b'", "a.b c\na.bc\n", 0, "a.b c\n", ""],
   ["grep --regexp=a --count", "a\na\n", 0, "2\n", ""],
   ["grep -e -x", "-x\ny\n", 0, "-x\n", ""],
   ["grep -- -x", "-x\ny\n", 0, "-x\n", ""]]);
  def fatb-g-files() = fatb-gall?([
   ["grep -l alpha alpha.txt notes.txt table.txt", "", 0, "alpha.txt\nnotes.txt\n", ""],
   ["grep -L alpha alpha.txt notes.txt table.txt", "", 0, "table.txt\n", ""],
   ["grep -c alpha alpha.txt notes.txt table.txt", "", 0, "alpha.txt:1\nnotes.txt:1\ntable.txt:0\n", ""],
   ["grep -n beta alpha.txt notes.txt", "", 0, "alpha.txt:2:beta 2\nnotes.txt:2:beta two\n", ""],
   ["grep -h beta alpha.txt notes.txt", "", 0, "beta 2\nbeta two\n", ""],
   ["grep -H beta alpha.txt", "", 0, "alpha.txt:beta 2\n", ""],
   ["grep -r int src", "", 0, "src/code.txt:int alpha;\nsrc/code.txt:int beta;\n", ""],
   ["grep -r beta", "", 0, "alpha.txt:beta 2\nnotes.txt:beta two\nsrc/code.txt:int beta;\n", ""],
   ["grep -r int .", "", 0, "./src/code.txt:int alpha;\n./src/code.txt:int beta;\n", ""],
   ["grep -A0 -n beta alpha.txt notes.txt", "", 0, "alpha.txt:2:beta 2\n--\nnotes.txt:2:beta two\n", ""]]);
  def fatb-g-exit() = fatb-gall?([
   ["grep zzz alpha.txt", "", 1, "", ""],
   ["grep -E 'a(' alpha.txt", "", 2, "", "unmatched-group-open"],
   ["grep '\\d' alpha.txt", "", 2, "", "unsupported-pattern-escape"],
   ["grep -E 'a**' alpha.txt", "", 2, "", "stacked-repetition"],
   ["grep '[a' alpha.txt", "", 2, "", "unclosed-character-class"],
   ["grep '\\(a' alpha.txt", "", 2, "", "unmatched-group-open"],
   ["grep '\\1' alpha.txt", "", 2, "", "invalid-back-reference"],
   ["grep -E 'a{2' alpha.txt", "", 2, "", "invalid-interval-expression"],
   ["grep '[[.a.]]' alpha.txt", "", 2, "", "collating-element-not-supported"],
   ["grep -P x alpha.txt", "", 2, "", "perl-regexp-not-supported"],
   ["grep --bogus x alpha.txt", "", 2, "", "unsupported-grep-option"],
   ["grep -A x a alpha.txt", "", 2, "", "invalid-context-length-argument"],
   ["grep", "", 2, "", "grep-needs-pattern"],
   ["grep alpha nope.txt", "", 2, "", "grep: nope.txt: No such file or directory"],
   ["grep alpha alpha.txt nope.txt", "", 2, "alpha.txt:alpha 1\n", "nope.txt"],
   ["grep -q alpha alpha.txt nope.txt", "", 0, "", ""],
   ["grep -s alpha nope.txt", "", 2, "", ""],
   ["grep alpha src", "", 2, "", "src: Is a directory"],
   ["grep -q beta alpha.txt", "", 0, "", ""],
   ["grep -q zzz alpha.txt", "", 1, "", ""],
   ["grep -f pats alpha.txt", "", 2, "", "pats: No such file or directory"]]);
  def fatb-g-input() = fatb-gall?([
   ["grep t", "one\ntwo\nthree\n", 0, "two\nthree\n", ""],
   ["grep -c o", "one\ntwo\nthree\n", 0, "2\n", ""],
   ["grep -H t", "one\ntwo\nthree\n", 0, "(standard input):two\n(standard input):three\n", ""],
   ["grep t -", "one\ntwo\nthree\n", 0, "two\nthree\n", ""],
   ["grep -lc a", "a\n", 0, "(standard input)\n", ""],
   ["grep b", "a\nb", 0, "b\n", ""],
   ["grep x", "", 1, "", ""],
   ["grep ''", "a\n\nb\n", 0, "a\n\nb\n", ""],
   ["grep -v ''", "a\nb\n", 1, "", ""]]);

  // symbol-voice found a corpus word's sentence with
  //   grep -m1 -B2 '^ *"w"$' corpus | head -2 | grep -o '"[a-z]*"' | tr -d '"' | tr '\n' ' '
  // over rows laid out as below (learn/homecoming-distillation-corpus.fk before its rows became one line each; the
  // second row is the real row 1596, the first stands before it)
  def fatb-sv-corpus() = "            (hdc-row 1595 20260929\n                (list \"what\" \"is\" \"a\" \"stone\")\n                \"turnstone\"\n                \"turnstone\"\n                \"rented-oracle\")\n            (hdc-row 1596 20260929\n                (list \"what\" \"one\" \"word\" \"names\" \"a\" \"landing\" \"that\" \"stands\" \"on\" \"its\" \"own\" \"branch\" \"because\" \"main\" \"moved\" \"while\" \"it\" \"was\" \"made\" \"and\" \"waits\" \"for\" \"the\" \"next\" \"walk\" \"to\" \"carry\" \"it\")\n                \"tidewait\"\n                \"tidewait\"\n                \"rented-oracle\")\n";
  def fatb-sv-tide() = "what one word names a landing that stands on its own branch because main moved while it was made and waits for the next walk to carry it ";
  def fatb-sv-stone() = "what is a stone ";
  def fatb-sv-step(command, input) = fatb-field(fatb-gsend(command, input), "stdout");
  // five calls; each response's stdout is the next request's input, nothing is spelled as a pipe
  def fatb-sv-wire(word) {
   let found = fatb-sv-step("grep -m1 -B2 '^ *\"" + word + "\"$'", fatb-sv-corpus());
   let rows = fatb-sv-step("head -2", found);
   let quoted = fatb-sv-step("grep -o '\"[a-z]*\"'", rows);
   let bare = fatb-sv-step("tr -d '\"'", quoted);
   fatb-sv-step("tr '\\n' ' '", bare);
  }
  def fatb-sv-library(word) {
   let found = grep-text(["-m1", "-B2", "^ *\"" + word + "\"$"], fatb-sv-corpus());
   let rows = fat-out(fat-call([], "head", ["-n", "2"], found[1]));
   let quoted = grep-text(["-o", "\"[a-z]*\""], rows);
   let bare = fat-out(fat-call([], "tr", ["-d", "\""], quoted[1]));
   fat-out(fat-call([], "tr", ["\\n", " "], bare));
  }
  def fatb-sv-found() = fatb-sv-step("grep -m1 -B2 '^ *\"tidewait\"$'", fatb-sv-corpus());
  def fatb-sv-pipeline?() = fatb-sv-found() == "            (hdc-row 1596 20260929\n                (list \"what\" \"one\" \"word\" \"names\" \"a\" \"landing\" \"that\" \"stands\" \"on\" \"its\" \"own\" \"branch\" \"because\" \"main\" \"moved\" \"while\" \"it\" \"was\" \"made\" \"and\" \"waits\" \"for\" \"the\" \"next\" \"walk\" \"to\" \"carry\" \"it\")\n                \"tidewait\"\n"
   && fatb-sv-wire("tidewait") == fatb-sv-tide() && fatb-sv-wire("turnstone") == fatb-sv-stone();

  def fatb-g-library() {
   let wire = fatb-gsend("grep -n alpha notes.txt", "");
   let held = fatb-gsend("grep -n alpha", fatb-field(fatb-gsend("cat notes.txt", ""), "stdout"));
   let direct = grep-text(["-n", "alpha"], "Alpha one\nbeta two\nalpha three\n\nlast Alpha\n");
   let none = grep-text(["-q", "x"], "y\n");
   let bad = grep-text-error(["-E", "a("], "");
   fatb-field(held, "exit") == direct[0] && fatb-field(held, "stdout") == direct[1] && direct[1] == "3:alpha three\n" && fatb-field(wire, "stdout") == direct[1]
   && none[0] == 1 && none[1] == "" && str_find(bad, "unmatched-group-open", 0) >= 0
   && grep-lines(["-v", "b"], ["a", "b", "c"]) == [0, ["a", "c"]]
   && grep-lines(["-c", "x"], ["a"]) == [1, ["0"]]
   && grep-lines(["x"], []) == [1, []]
   && fatb-sv-library("tidewait") == fatb-sv-tide() && fatb-sv-library("turnstone") == fatb-sv-stone();
  }
  def fatb-g-refusal() {
   let r = fatb-gsend("grep alpha alpha.txt | head -n 1", "");
   let ok = fatb-gsend("grep -r alpha", "");
   fatb-field(r, "exit") == 2 && fatb-field(r, "stdout") == "" && str_find(fatb-field(r, "stderr"), "shell-syntax-not-supported", 0) >= 0
   && fatb-docs-of(r) == fatb-docs-of(ok) && fatb-text-of(r, "notes.txt") == "Alpha one\nbeta two\nalpha three\n\nlast Alpha\n" && len(node_children(json-object-get(r, "documents"))) == 5;
  }
  def fatb-g-catalog() {
   let docs = [["source:app", "src/app.py", "def hello():\n    return 1\n"]];
   let named = fat-call(docs, "grep", ["-n", "^def", "src/app.py"], "");
   let labelled = fat-call(docs, "grep", ["-nH", "^def", "src/app.py"], "");
   let native = fat-call(docs, "bml-api", ["hello"], "");
   let catalog=[["api.bml","api.bml","import form-stdlib/json.fk;\nsection [form.bml] { def api-probe(x)=x; }\n"]];
   let imported=fat-call(catalog,"bml-api",["api-probe","json-object-has?","json-int-value"],"");
   let symbols=json-array-elements(json-object-get(fat-value(imported),"symbols"));
   let definitions=foldl((all,symbol)=>append(all,json-array-elements(json-object-get(symbol,"declarations"))),[],symbols);
   let complete=all?(symbol=>len(json-array-elements(json-object-get(symbol,"declarations")))>0,symbols)
    && all?(d=>{ let definition=json-string-value(json-object-get(d,"definition")); let declaration=json-string-value(json-object-get(d,"declaration"));
     let path=json-string-value(json-object-get(d,"path")); let resident=fat-find-doc(catalog,path);
     len(definition)>len(declaration) && str_find(nil?(resident) ? read_file(path) : resident[2],definition,0)>=0;
    },definitions) && fat-documents(imported)==catalog;
   let revised=[[catalog[0][0],catalog[0][1],"import form-stdlib/json.fk;\nsection [form.bml] { def api-probe(x)=x+1; }\n"]];
   let fresh=fat-call(revised,"bml-api",["api-probe"],"");
   let changed=json-array-elements(json-object-get(json-array-elements(json-object-get(fat-value(fresh),"symbols"))[0],"declarations"));
   let renewed=len(changed)==1 && json-string-value(json-object-get(changed[0],"source_sha256"))!=json-string-value(json-object-get(definitions[0],"source_sha256"))
    && str_find(revised[0][2],json-string-value(json-object-get(changed[0],"definition")),0)>=0 && fat-documents(fresh)==revised;
   let missing=fat-call(catalog,"bml-api",["json-node-is-int"],"");
   let absent=json-array-elements(json-object-get(fat-value(missing),"symbols"))[0];
   let discoverable=nil?(json-array-elements(json-object-get(absent,"declarations"))) && fat-has(json-array-elements(json-object-get(absent,"related_names")) |> map(n=>json-string-value(n)),"json-node-int") && fat-documents(missing)==catalog;
   let held=record_get(sa-census-held,"current");
   let old=sa-source-row(catalog[0][1],catalog[0][2],[],"");
   let files=record_set(record_new(0),catalog[0][1],old);
   let texts=record_set(record_new(0),catalog[0][1],[catalog[0][1],revised[0][2],bml-source-fingerprint(revised[0][2])]);
   record_set(sa-census-held,"current",[files,texts]);
   let coherent=sa-cached-file(catalog[0][1],revised[0][2]);
   record_set(sa-census-held,"current",held);
   let refreshed=coherent[1]==bml-source-fingerprint(revised[0][2]) && coherent[1]!=old[1];
   let handed = fat-with-docs(native, fatb-docs());
   let bad = fat-checked(fat-with-value(fat-result(0, [[fat-value(native)], 2, ""], "", docs), fat-value(native)), docs);
   let parsed = text => faj-json("native-equality", text);
   let equality = faj-equal(parsed("\"a\\u0062\""), parsed("\"ab\"")) && !faj-equal(parsed("\"ab\""), parsed("\"ac\"")) && !faj-equal(parsed("true"), parsed("false")) && faj-equal(parsed("null"), parsed("null")) && !faj-equal(parsed("null"), parsed("false")) && faj-equal(parsed("1"), parsed("1.0")) && !faj-equal(parsed("1"), parsed("\"1\"")) && faj-equal(parsed("{\"a\":[true,null,\"ab\"],\"b\":1}"), parsed("{\"b\":1.0,\"a\":[true,null,\"a\\u0062\"]}"));
   len(tc-agent-tool-names()) == 16 && fat-tool?("grep") && fat-has(tc-agent-tool-names(), "grep") && !fat-has(["edit", "write"], "grep") && fat-readonly("grep")
   && tc-tool-projection(tc-which("grep")) == "native" && tc-tool-protocol(tc-which("grep")) == "kernel:call" && tc-tool-capability(tc-which("grep")) == "cap.kernel.call"
   && fat-exit(named) == 0 && fat-out(named) == "1:def hello():\n" && fat-documents(named) == docs && fat-crossings(named) == 0
   && fat-out(labelled) == "src/app.py:1:def hello():\n" && complete && renewed && discoverable && refreshed
   && !fat-text?(native[2]) && fat-output?(native[2]) && fat-has-value?(handed) && fat-value(handed) == fat-value(native) && handed[2] == native[2] && fat-crossings(native) > 0 && fat-crossings(handed) == fat-crossings(native) && fat-documents(handed) == fatb-docs() && fat-out(handed) == json-emit(fat-value(native)) + "\n" && fat-exit(bad) == 2 && fat-error(bad) == "invalid-resident-output" && equality;
  }
 }
  fatb-bit(fatb-row("rg -nF 'alpha 1'", "", "alpha.txt:1:alpha 1\n") && fatb-patterns(), 1)
 + fatb-bit(fatb-row("jq -r .name package.json", "", "demo\n"), 2)
 + fatb-bit(fatb-row("read alpha.txt", "", "alpha 1\nbeta 2\n") && fatb-paged(), 4)
 + fatb-bit(fatb-row("cat alpha.txt table.txt", "", "alpha 1\nbeta 2\nleft:right\nup:down\n"), 8)
 + fatb-bit(fatb-row("head -n 1 alpha.txt", "", "alpha 1\n"), 16)
 + fatb-bit(fatb-row("tail -n 1 alpha.txt", "", "beta 2\n"), 32)
 + fatb-bit(fatb-row("wc -lwc", "one two\n", "1 2 8\n"), 64)
 + fatb-bit(fatb-row("sort -nu", "10\n2\n2\n", "2\n10\n"), 128)
 + fatb-bit(fatb-row("uniq -c", "a\na\nb\n", "2 a\n1 b\n"), 256)
 + fatb-bit(fatb-row("tr -d '\\n'", "one\ntwo\n", "onetwo"), 512)
 + fatb-bit(fatb-row("cut -d : -f 2", "left:right\nup:down\n", "right\ndown\n"), 1024)
 + fatb-bit(fatb-row("awk '{print $2}'", "one two\nthree four\n", "two\nfour\n"), 2048)
 + fatb-bit(fatb-row("sed -n 2p alpha.txt", "", "beta 2\n"), 4096)
 + fatb-bit(fatb-edited?(), 8192)
 + fatb-bit(fatb-row("write notes.md", "held note\n", "created\n"), 16384)
 + fatb-bit(fatb-handoff(), 32768)
 + fatb-bit(fatb-pipeline(), 65536)
 + fatb-bit(fatb-refusal(), 131072)
 + fatb-bit(fatb-row("jq -nr --arg x 'a b' '$x'", "", "a b\n"), 262144)
 + fatb-bit(fatb-row("grep -n beta alpha.txt", "", "2:beta 2\n"), 524288)
 + fatb-bit(fatb-g-select(), 1048576)
 + fatb-bit(fatb-g-shape(), 2097152)
 + fatb-bit(fatb-g-context(), 4194304)
 + fatb-bit(fatb-g-regex(), 8388608)
 + fatb-bit(fatb-g-fixed(), 16777216)
 + fatb-bit(fatb-g-files(), 33554432)
 + fatb-bit(fatb-g-exit(), 67108864)
 + fatb-bit(fatb-g-input(), 134217728)
 + fatb-bit(fatb-sv-pipeline?(), 268435456)
 + fatb-bit(fatb-g-library(), 536870912)
 + fatb-bit(fatb-g-refusal(), 1073741824)
 + fatb-bit(fatb-g-catalog(), 2147483648);
}
