; dsv4-token-run-plan-band.bml -- the token door's plan on the real headers: the landed ledger's arithmetic over a bare header, the bytes a token reads, the ceilings, the hold rules and the plan's own lines, with nothing opened.
;
; WHAT THIS PINS. native/metal/dsv4-ledger.fk prices a token from its MODEL alone (dll-token-count-m: attention 22, the compressor's 3 plus 6 for ratio 4 or 5 for any other ratio at a boundary position, the FFN 18 or 19 by the
; routing, the embedding 2, the head and scan 8; dll-token-bytes-m: the header's rows, a routed stack at the experts used of its stride), and form-stdlib/bml/dsv4-token-run.bml adds the commits a token makes (a hand-off every second
; block and the wait's own) and the ceilings a row is held to. native/metal/tests/dsv4-token-run-band.bml holds that arithmetic EQUAL to the opened context's at every position of both fixtures; this band reads it on the two real headers
; (8,388,608-byte windows, no weight byte) and on the first fixture's, pins the figures the dry plan prints, and exercises the hold rules on scripted machine readings and the plan's lines under scripted options. Nothing is
; opened, mapped, leased or compiled; no device is touched.
;
; Verdict 63 when every claim lands:
;   1     the IQ2XXS header: 1,856 dispatches at position 0 (1,848 without the head and scan), 1,982 at position 3, 2,082 at position 127 (every compressor emits), 1,856 at position 14 (the first decode); the quietest position
;         of a period reads 1,856 and the loudest 2,082; 21 submits and 22 command buffers (43 layers); the bytes a token reads are the sum of the layers, the head and one embedding row, and 16.6 ms at 546 GB/s
;   2     the reap25 header: the same dispatches and commits (it is the same 43-layer shape) and its own bytes (layers 3 to 42 store 192 experts, whose stride differs)
;   4     the first fixture's header: 137 dispatches at position 0 (129 without the head), 142 at position 1, 148 at position 3, 1 submit and 2 command buffers (3 layers)
;   8     the plan's lines under scripted organs. THE DEFAULT IS THE ARENA (64 slots a layer): the first line says DRY and that nothing is opened; the run is 14 pinned prompt ids and 24 decode tokens through a slot arena; the
;         command structure names two planned stages a block with ONE sync between them, 44 waits, 45 host reads, 65 command buffers; the ceiling line reads the formula's 1,856 to 2,082 dispatches plus the copies, syncs 44, reads 45 (43
;         without a head); the DEVICE bytes a token (9,107,652,444 B, 16.6 ms at the stated 546 GB/s, hit or miss alike) and the FILE bytes cold (the dense tensors faulted in on the FIRST TOKEN: 7,281,557,340 B the token reads plus
;         1,059,053,568 B of token_embd's other rows, a bound view being read whole; the first decode token at most 1,826,095,104 B; the 14-id prefill at most 25,565,331,456 B = 84 lookups x 43 layers x 7,077,888 B, the WORST CASE: the
;         slots do not bound it, they size the arena, a separate 19,478,347,776 B; the file is not read whole) and warm (a miss costs 7,077,888 B at layer 0, a hit nothing); the Swift reference (38.17 ms, 1,510 barriers) and the hold rules (60 percent, the reserve,
;         20 minutes) are named; under {"steps":5,"watch":1,"pct":50,"bw_gbs":273,"arena_slots":24} the lines say 5 tokens, the first 1 tokens, 50 percent, 273 GB/s and 24 slots; under {"arena_slots":0} the whole-stack
;         control: WHOLE MAPPED STACKS, 21 submits, 22 command buffers, ONE wait, the whole-stack ceilings and no file-bytes lines; the last line is DRY ends
;   16    the hold rules on scripted readings, in their order: a quiet reading holds nothing; unreadable is memory-unreadable, low (available under half the reserve) host-memory-low, wired past pct percent of memory wired-cap
;         (60 percent of 128 GiB is 76.8 GiB: 76 GiB holds, 77 does not; at 50 percent 63 GiB holds and 64 does not: the governor's percent is (memory / 100) x pct), available under the reserve (12.8 GiB: 13 holds, 12 does not) reserve,
;         20 minutes and one millisecond budget; low is named before the cap and the cap before the reserve; and the ceilings: a ledger row of exactly the formula's dispatches, one wait, the derived commits and nothing made
;         passes dtr-row-ok?, and the same row with one more dispatch, a second wait, one more command buffer, a buffer made, a host read too many or a plan short fails it, and a row with fewer dispatches fails it too
;
;   32    the arena's arithmetic: the routed bytes a token reads are 1,826,095,104 B on the IQ2XXS header and the dense part is the rest of the ledger's bytes; the arena's allocation is the lease's expert term (19,478,347,776 B at 64
;         slots) and the prefill's cold fill bound is the TRUE MAXIMUM, positions x used lookups a layer each able to miss (6 for one position, 12 for two, 84 at 14 ids whatever the slots: 25,565,331,456 B, above the arena's
;         own term; capped at the layer's stored experts only when the arena holds them all: 256 slots over 100 ids is every expert); the token_embd rest 1,059,053,568 B and the cold dense bytes that include it; the ledger's arena counts (44 waits, 45
;         reads, 43 without a head, 65 command buffers); an arena row of exactly the formula's dispatches plus its copies, the derived waits, reads and command buffers, no buffer made, copies = 3 x the experts missed passes
;         dtr-row-ok? and the same row with one dispatch short, a sync more, a read more, a command buffer more, a buffer made, an odd copy count or a miss count not a third of the copies fails it
;
; PROOF LEVEL: FOURTH-ARM ONLY -- bits 1 and 2 read host-local model files' headers (paths outside the tree; 8 MB windows) and bit 4 writes the fixture through write_file and reads it back. No weight byte is read and no device
; is touched. The band writes only under temp_dir and removes what it made.
// preludes: form-stdlib/core.fk form-stdlib/dsv4-fixture-gguf.fk form-stdlib/bml/dsv4-token-run.bml
section [form.bml] {
 class Dsv4TokenRunPlanBand {
  def dtp-bit(held, bit) = held ? bit : 0;
  def dtp-reap() = "/Users/ursmuff/models/ds4/ds4flash-v5mx-reap25-type40-mxfp8lt-dspark-v1.gguf";
  def dtp-gib(n) = n * 1073741824;
  def dtp-has?(s, part) = str_find(s, part, 0) >= 0;
  def dtp-pages(b) = b / 16384;
  // a reading in the governor's shape (the validation band's own): [page, mem, free, active, inactive, wired, speculative, purgeable, compressor, pageins, pageouts, compressions, decompressions, swapins, swapouts, external, internal]
  def dtp-vm(mem, free, wired, comp) = [16384, dtp-gib(mem), dtp-pages(dtp-gib(free)), 0, 0, dtp-pages(dtp-gib(wired)), 0, 0, dtp-pages(dtp-gib(comp)), 0, 0, 0, 0, 0, 0, 0, 0];
  def dtp-minute() = 60000;
  // ---- 1 and 2: the real headers ---------------------------------------------------------------------------------------------
  def dtp-iq2(m) {
   let said = print_str("  iq2 bytes " ++ dtr-bytes(m, true).str() ++ " layers " ++ dll-layers-bytes-m(m, 0, 43).str() ++ " head " ++ dll-head-bytes-m(m).str() ++ " no-head " ++ dtr-bytes(m, false).str());
   dtr-dispatches(m, 0, true) == 1856 && dtr-dispatches(m, 0, false) == 1848 && dtr-dispatches(m, 3, true) == 1982 && dtr-dispatches(m, 127, true) == 2082 && dtr-dispatches(m, 14, true) == 1856
    && dtr-min-go(m, 0, 1000000, 256) == 1856 && dtr-max-go(m, 0, 0, 256) == 2082 && dtr-submits(m) == 21 && dtr-cbs(m) == 22
    && dtr-bytes(m, true) == 2 * record_get(m, "e") + dll-layers-bytes-m(m, 0, 43) + dll-head-bytes-m(m) && dtr-bytes(m, false) == dtr-bytes(m, true) - dll-head-bytes-m(m) && dll-layers-bytes-m(m, 0, 43) > dls-dense(m)
    && dtr-tenths-ms(dtr-bytes(m, true), 546) == 166 && dtr-tenths-ms(dtr-bytes(m, true), 273) == 333;
  }
  def dtp-reap-ok(m) {
   let said = print_str("  reap bytes " ++ dtr-bytes(m, true).str());
   dtr-dispatches(m, 0, true) == 1856 && dtr-dispatches(m, 127, true) == 2082 && dtr-submits(m) == 21 && dtr-cbs(m) == 22 && dtr-bytes(m, true) > 0;
  }
  def dtp-fixture(m) = dtr-dispatches(m, 0, true) == 137 && dtr-dispatches(m, 0, false) == 129 && dtr-dispatches(m, 1, true) == 142 && dtr-dispatches(m, 3, true) == 148 && dtr-submits(m) == 1 && dtr-cbs(m) == 2;
  // ---- 8: the plan's lines ---------------------------------------------------------------------------------------------------
  def dtp-organs() = [[10911, dtp-gib(2), "./fkwu observe/form-glass-live-run.fk"]];
  def dtp-plan(m, size, optsText) = dtr-plan-lines(m, size, parse-json("opts", optsText), dtp-organs());
  def dtp-join(lines) = len(lines) == 0 ? "" : lines[0] ++ "\n" ++ dtp-join(lines[1:]);
  def dtp-lines(m, size) {
   let a = dtp-plan(m, size, "{}");
   let b = dtp-plan(m, size, "{\"steps\":5,\"watch\":1,\"pct\":50,\"bw_gbs\":273,\"arena_slots\":24}");
   let w = dtp-plan(m, size, "{\"arena_slots\":0}");
   let ta = dtp-join(a);
   let tb = dtp-join(b);
   let tw = dtp-join(w);
   let said = print_str("  plan: " ++ len(a).str() ++ " lines; first '" ++ a[0] ++ "'");
   dtp-has?(a[0], "DRY: the plan and the op ledger arithmetic; nothing is opened, mapped, leased, compiled or written") && dtp-has?(a[len(a) - 1], "DRY ends")
    && dtp-has?(ta, "the prefill of 14 prompt ids [0,3476,477,260,11502,22896,128803,671,6102,294,8760,344,128804,128821] (a wait between positions, the head and the one drain at the last), then 24 greedy decode tokens")
    && dtp-has?(ta, "the routed experts through a slot arena of 64 slots a layer (the stacks are not mapped)") && !dtp-has?(ta, "WHOLE MAPPED STACKS")
    && dtp-has?(ta, "a block is two planned stages (dkr-hz) with ONE sync between them: the router's ids are read on the host (one counted read of 6 words)") && dtp-has?(ta, "a token waits 44 times (43 blocks and its close), reads the device 45 times (a block's ids and the head's two), commits 65 command buffers")
    && dtp-has?(ta, "1856 at the quietest position, 2082 at a position where every compressor emits") && dtp-has?(ta, "the arena adds a copy dispatch for each fill that takes the view road (the fill door makes none)")
    && dtp-has?(ta, "the arena ceilings a row is held to") && dtp-has?(ta, "plus the copy dispatches (none through the fill door), syncs 44, host reads 45 at a head (43 without), command buffers 65, buffers made 0, plans short or long 0")
    && dtp-has?(ta, "bytes the DEVICE reads a token (dll-token-bytes-m): 9107652444 B") && dtp-has?(ta, "at 546 GB/s (stated, not measured) that is 16.6 ms a token, hit or miss alike")
    && dtp-has?(ta, "bytes the FILE gives, cold: the dense tensors, FAULTED IN ON THE FIRST TOKEN (the open maps them and reads no byte of them") && !dtp-has?(ta, "once at the open")
    && dtp-has?(ta, "= 7281557340 the token reads + 1059053568 the rest of token_embd (1059061760 B whole: the embedding is a bound view and a bound view is read whole, the floor's theory)")
    && dtp-has?(ta, "allocated once and filled by span; the first decode token fills at most 1826095104 B (1.7 GiB")
    && dtp-has?(ta, "the prefill of 14 prompt ids at most 25565331456 B (23.8 GiB: the WORST CASE, 84 lookups a layer, each of which can miss, so 64 slots do not bound it; the arena's size is the separate 19478347776 B above)") && !dtp-has?(ta, "a layer holds no more than")
    && dtp-has?(ta, "and is not read whole") && dtp-has?(ta, "bytes the FILE gives, warm: nothing of the dense tensors, and 7077888 B (layer 0's one expert's three stacks) for each expert the cache misses")
    && dtp-has?(ta, "38.17 ms a token, about 1,510 barriers, 28 tokens a second warm") && dtp-has?(ta, "wired memory is read after every layer of the first 3 tokens") && dtp-has?(ta, "wired above 60 percent of memory (76.7 GiB on 128 GiB), available under the reserve, 20 minutes")
    && dtp-has?(ta, "organs of ours resident: 1 holding 2.0 GiB") && dtp-has?(ta, "receipts/dsv4-token-runs.jsonl") && dtp-has?(ta, "layer prices (the token door's expected curve; no layer is staged here): 43 layers") && dtp-has?(ta, "[dsv4-validate] back off: an ask denied for reserve or compressor")
    && dtp-has?(tb, "then 5 greedy decode tokens") && dtp-has?(tb, "after every layer of the first 1 tokens") && dtp-has?(tb, "wired above 50 percent of memory (63.9 GiB on 128 GiB)") && dtp-has?(tb, "the routed experts through a slot arena of 24 slots a layer")
    && dtp-has?(tb, "at 273 GB/s (stated, not measured) that is 33.3 ms a token, hit or miss alike")
    && dtp-has?(tw, "WHOLE MAPPED STACKS (the control: arena_slots 0; a cold token reads the whole file)") && dtp-has?(tw, "handed to the queue every 2 blocks (21 submits and the wait's own commit: 22 command buffers a token), ONE wait a decode token")
    && dtp-has?(tw, "command buffers 22, syncs 1, host reads 2 at a head and 0 without, buffers made 0, plans short or long 0") && dtp-has?(tw, "bytes a token reads (dll-token-bytes-m, the ledger's sum over the header's rows): 9107652444 B") && !dtp-has?(tw, "the FILE gives");
  }
  // ---- 32: the arena's arithmetic, from the header and from scripted rows ------------------------------------------------------------------------------
  // an arena row at position pos: the formula's dispatches plus `fdisp` copy dispatches plus `xd` (a plant: dispatches short or over), the waits, reads and command buffers the ledger derives plus the plants' differences
  // (xs, xr, xc), buffers made, span fills, copy dispatches and experts missed (of 258 lookups)
  def dtp-ar(m, pos, headed, xd, xs, xr, xc, allocs, fills, fdisp, emiss) = record_new(0, "dispatches", dtr-dispatches(m, pos, headed) + fdisp + xd, "barriers", 900, "cbs", dll-arena-cbs(m) + xc, "syncs", dll-arena-syncs(m) + xs, "readbacks", dll-arena-reads(m, headed) + xr,
    "allocs", allocs, "bytes", dtr-bytes(m, headed), "gpu_us", 5000, "wall_ms", 40, "miss", 0, "fills", fills, "fdisp", fdisp, "emiss", emiss, "ehit", 258 - emiss, "ebytes", fills * 2000000, "arena", 1);
  def dtp-arena(m) {
   let slots = 64;
   let said = print_str("  arena arithmetic: routed " ++ dtr-routed-bytes(m).str() ++ " dense " ++ dtr-dense-bytes(m).str() ++ " prefill fill " ++ dtr-prefill-fill-bytes(m, 14, slots).str() ++ " arena " ++ dtr-arena-bytes(m, slots).str());
   dtr-routed-bytes(m) == 1826095104 && dtr-dense-bytes(m) == dtr-bytes(m, true) - 1826095104 && dtr-dense-bytes(m) == 7281557340 && dtr-arena-bytes(m, slots) == 19478347776 && dtr-prefill-fill-bytes(m, 14, slots) == 25565331456
    && dtr-prefill-fill-bytes(m, 14, slots) == 84 * 43 * 7077888 && dtr-prefill-fill-bytes(m, 14, slots) > dtr-arena-bytes(m, slots) && dtr-prefill-fill-bytes(m, 1, slots) == 6 * dls-cache(m, 1) && dtr-prefill-fill-bytes(m, 2, slots) == 12 * dls-cache(m, 1)
    && dtr-prefill-fill-bytes(m, 14, 4) == 84 * dls-cache(m, 1) && dtr-prefill-fill-bytes(m, 100, 256) == dls-cache(m, 256) && dtr-prefill-fill-bytes(m, 100, 128) == 600 * dls-cache(m, 1)
    && dtr-embd-rest(m) == 1059061760 - 2 * record_get(m, "e") && dtr-cold-dense(m) == dtr-dense-bytes(m) + dtr-embd-rest(m) && dtr-cold-dense(m) > dtr-dense-bytes(m)
    && dll-arena-syncs(m) == 44 && dll-arena-reads(m, true) == 45 && dll-arena-reads(m, false) == 43 && dll-arena-cbs(m) == 65
    && dtr-row-ok?(m, dtp-ar(m, 14, true, 0, 0, 0, 0, 0, 12, 0, 4), 14, true) && dtr-row-ok?(m, dtp-ar(m, 14, true, 0, 0, 0, 0, 0, 12, 12, 4), 14, true) && dtr-row-ok?(m, dtp-ar(m, 14, true, 0, 0, 0, 0, 0, 0, 0, 0), 14, true)
    && dtr-row-ok?(m, dtp-ar(m, 14, true, 0, 0, 0, 0, 0, 12, 7, 4), 14, true) && dtr-row-ok?(m, dtp-ar(m, 3, false, 0, 0, 0, 0, 0, 6, 6, 2), 3, false)
    && !dtr-row-ok?(m, dtp-ar(m, 14, true, 1, 0, 0, 0, 0, 12, 0, 4), 14, true) && !dtr-row-ok?(m, dtp-ar(m, 14, true, 0 - 1, 0, 0, 0, 0, 12, 12, 4), 14, true)
    && !dtr-row-ok?(m, dtp-ar(m, 14, true, 0, 1, 0, 0, 0, 12, 0, 4), 14, true) && !dtr-row-ok?(m, dtp-ar(m, 14, true, 0, 0, 1, 0, 0, 12, 0, 4), 14, true)
    && !dtr-row-ok?(m, dtp-ar(m, 14, true, 0, 0, 0, 1, 0, 12, 0, 4), 14, true) && !dtr-row-ok?(m, dtp-ar(m, 14, true, 0, 0, 0, 0, 1, 12, 0, 4), 14, true)
    && !dtr-row-ok?(m, dtp-ar(m, 14, true, 0, 0, 0, 0, 0, 13, 0, 4), 14, true) && !dtr-row-ok?(m, dtp-ar(m, 14, true, 0, 0, 0, 0, 0, 12, 0, 3), 14, true) && !dtr-row-ok?(m, dtp-ar(m, 14, true, 0, 0, 0, 0, 0, 12, 13, 4), 14, true)
    && !dtr-row-ok?(m, dtp-ar(m, 14, true, 0, 0, 0, 0, 0, 12, 0, 4), 14, false)
    && dtp-has?(dtr-row-over(m, dtp-ar(m, 14, true, 0, 0, 0, 0, 0, 12, 0, 3), 14, true), "arena counts not exact") && dtp-has?(dtr-row-over(m, dtp-ar(m, 14, true, 0, 1, 0, 0, 0, 12, 0, 4), 14, true), "syncs 45>44");
  }
  // ---- 16: the hold rules and the ceilings -----------------------------------------------------------------------------------------
  def dtp-hold() {
   let quiet = dtp-vm(128, 100, 10, 1);
   dtr-hold-reason(quiet, 60, 0) == "" && dtr-hold-reason([], 60, 0) == "memory-unreadable" && dtr-hold-reason(dtp-vm(128, 5, 10, 1), 60, 0) == "host-memory-low" && dtr-hold-reason(dtp-vm(128, 100, 10, 60), 60, 0) == "host-memory-low"
    && dtr-hold-reason(dtp-vm(128, 100, 76, 1), 60, 0) == "" && dtr-hold-reason(dtp-vm(128, 100, 77, 1), 60, 0) == "wired-cap" && dtr-hold-reason(dtp-vm(128, 100, 63, 1), 50, 0) == "" && dtr-hold-reason(dtp-vm(128, 100, 64, 1), 50, 0) == "wired-cap"
    && dtr-hold-reason(dtp-vm(128, 13, 10, 1), 60, 0) == "" && dtr-hold-reason(dtp-vm(128, 12, 10, 1), 60, 0) == "reserve" && dtr-hold-reason(dtp-vm(128, 100, 10, 1), 60, 20 * dtp-minute()) == "" && dtr-hold-reason(quiet, 60, 20 * dtp-minute() + 1) == "budget"
    && dtr-hold-reason(dtp-vm(128, 5, 77, 1), 60, 0) == "host-memory-low" && dtr-hold-reason(dtp-vm(128, 12, 77, 1), 60, 0) == "wired-cap" && dtr-hold-reason(dtp-vm(128, 12, 10, 1), 60, 21 * dtp-minute()) == "reserve";
  }
  // a ledger row in the shape dll-row answers, with the fields a ceiling reads
  def dtp-row(m, pos, headed, dispatches, barriers, cbs, syncs, readbacks, allocs, miss) = record_new(0, "dispatches", dispatches, "barriers", barriers, "cbs", cbs, "syncs", syncs, "readbacks", readbacks, "allocs", allocs, "bytes", dtr-bytes(m, headed), "gpu_us", 5000, "wall_ms", 40, "miss", miss, "fills", 0, "emiss", 0, "ehit", 0, "ebytes", 0, "arena", 0);
  def dtp-good(m, pos) = dtp-row(m, pos, true, dtr-dispatches(m, pos, true), 900, dtr-cbs(m), 1, 2, 0, 0);
  def dtp-ceilings(m) {
   let d = dtr-dispatches(m, 14, true);
   dtr-row-ok?(m, dtp-good(m, 14), 14, true) && dtr-row-ok?(m, dtp-row(m, 3, false, dtr-dispatches(m, 3, false), 800, dtr-cbs(m), 1, 0, 0, 0), 3, false)
    && !dtr-row-ok?(m, dtp-row(m, 14, true, d + 1, 900, dtr-cbs(m), 1, 2, 0, 0), 14, true) && !dtr-row-ok?(m, dtp-row(m, 14, true, d - 1, 900, dtr-cbs(m), 1, 2, 0, 0), 14, true)
    && !dtr-row-ok?(m, dtp-row(m, 14, true, d, 900, dtr-cbs(m), 2, 2, 0, 0), 14, true) && !dtr-row-ok?(m, dtp-row(m, 14, true, d, 900, dtr-cbs(m) + 1, 1, 2, 0, 0), 14, true)
    && !dtr-row-ok?(m, dtp-row(m, 14, true, d, 900, dtr-cbs(m), 1, 2, 1, 0), 14, true) && !dtr-row-ok?(m, dtp-row(m, 14, true, d, 900, dtr-cbs(m), 1, 3, 0, 0), 14, true) && !dtr-row-ok?(m, dtp-row(m, 14, true, d, 900, dtr-cbs(m), 1, 2, 0, 1), 14, true)
    && !dtr-row-ok?(m, dtp-row(m, 14, true, d, d + 1, dtr-cbs(m), 1, 2, 0, 0), 14, true) && !dtr-row-ok?(m, dtp-good(m, 14), 127, true) && dtr-row-ok?(m, dtp-good(m, 127), 127, true)
    && dtp-has?(dtr-row-over(m, dtp-row(m, 14, true, d, 900, dtr-cbs(m), 2, 2, 0, 0), 14, true), "syncs 2>1") && dtp-has?(dtr-row-over(m, dtp-row(m, 14, true, d - 1, 900, dtr-cbs(m), 1, 2, 0, 0), 14, true), "dispatches " ++ (d - 1).str() ++ "!=" ++ d.str());
  }
 }
 let iq2Path = dvr-file();
 let reapPath = dtp-reap();
 let fixPath = temp_dir() ++ "/dsv4-token-run-plan-band-" ++ now_unix_ms().str() ++ ".gguf";
 let wrote = dfx-write(fixPath);
 let mIq2 = dvl-open(dvl-src(iq2Path));
 let mReap = dvl-open(dvl-src(reapPath));
 let mFix = dvl-open(eqr-of-file(fixPath, 0, file_size(fixPath)));
 let c1 = dtp-bit(try dtp-iq2(mIq2) catch false, 1);
 let c2 = dtp-bit(try dtp-reap-ok(mReap) catch false, 2);
 let c4 = dtp-bit(try dtp-fixture(mFix) catch false, 4);
 let c8 = dtp-bit(try dtp-lines(mIq2, file_size(iq2Path)) catch false, 8);
 let c16 = dtp-bit(try dtp-hold() && dtp-ceilings(mIq2) catch false, 16);
 let c32 = dtp-bit(try dtp-arena(mIq2) catch false, 32);
 let removed = host_path_remove(fixPath);
 print_str("dsv4-token-run-plan-band claims " ++ c1.str() ++ " " ++ c2.str() ++ " " ++ c4.str() ++ " " ++ c8.str() ++ " " ++ c16.str() ++ " " ++ c32.str() ++ " removed " ++ removed.str());
 c1 + c2 + c4 + c8 + c16 + c32;
}
