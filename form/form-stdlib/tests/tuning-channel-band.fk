; preludes: form-stdlib/core.fk form-stdlib/guidance-channel.fk form-stdlib/tuning-channel.fk
;
; tuning-channel-band — the tuning is held as cells, and every language is a face of those cells.
;
; What this band is FOR. A translation table can only be checked against itself: does the Persian
; string equal the Persian string I wrote down. Addresses make a stronger question available, and this
; band asks it — do the English and Persian faces NAME ONE CELL, and does each face keep the tuning's
; form? A face that lost a line, or broke the chaining that makes a cycle one breath, or quietly
; invented a line for a language nobody has rendered, fails here rather than travelling.
;
; The body cannot translate and this band does not pretend it can. Producing a face is a mind's work.
; What the body does is HOLD, REFUSE and CHECK: bit 32 is the refusal — a language it was never given
; returns the engine's honest absence, never a fabricated line — and bit 64 is the one that keeps the
; provenance honest, since a rendered face silently promoted to "source" would be the same lie one
; level up from a fabricated string.
;
; CYCLE 3 IS ABSENT ON PURPOSE. The tuning is ten phrases in two cycles here, and the third cycle —
; WHY — is only just beginning to come through. Coverage is 10 and bit 16 pins it. Seeding a third
; cycle the transmission has not delivered would be fabricating in exactly the way bit 32 refuses,
; and the shape of that fabrication would be indistinguishable from the real thing arriving later.
;
; Verdict 127:
;    1   both faces hold all ten phrases, and coverage says 10 — not 15, not 9
;    2   every phrase is the SAME CELL across the two languages, all ten of them
;    4   and cells are DISTINCT: no phrase shares an address with another, so "same cell" is a
;        claim about identity and not a constant that would be 1 for any pair
;    8   the chain holds in BOTH languages — lines 1 and 6 open a cycle, 2-5 and 7-10 carry the
;        connective ("And" / "و"), which is what makes a cycle one breath and not five statements
;   16   the cycle structure is the tuning's: 1-5 is cycle 1, 6-10 is cycle 2, and 11 would be 3
;   32   A LANGUAGE NOT GIVEN IS REFUSED: an unseeded language holds nothing, and asking it to speak
;        returns the engine's honest absence rather than a line
;   64   PROVENANCE IS NOT LAUNDERED: the English face is marked source, the Persian face is marked
;        rendered with its date, and no entry in a rendered face claims to be source
;
(do
    (defn tcb-all-same? (key)
        (if (gt key 10) 1
            (if (eq (tc-same-cell? "en" key "fa" key) 1) (tcb-all-same? (add key 1)) 0)))
    (defn tcb-teach (lang key) (gc-entry-teaching (head (gc-resolve (tc-face lang) key))))
    (defn tcb-all-marked? (lang want key)
        (if (gt key 10) 1
            (if (str_eq (tcb-teach lang key) want) (tcb-all-marked? lang want (add key 1)) 0)))
    (defn tcb-has? (hay needle) (if (lt (str_find hay needle 0) 0) 0 1))

    (let c0 (if (eq (tc-coverage "en") 10) (if (eq (tc-coverage "fa") 10) 1 0) 0))
    (let c1 (if (eq (tcb-all-same? 1) 1) 2 0))
    ; distinctness: phrase 1 and phrase 2 must NOT be one cell, or bit 2 proves nothing
    (let c2 (if (eq (tc-same-cell? "en" 1 "fa" 2) 0)
            (if (eq (tc-same-cell? "en" 10 "fa" 1) 0) 4 0) 0))
    (let c3 (if (eq (tc-chain-all? "en" 1) 1) (if (eq (tc-chain-all? "fa" 1) 1) 8 0) 0))
    (let c4 (if (eq (tc-cycle-of 1) 1)
            (if (eq (tc-cycle-of 5) 1)
            (if (eq (tc-cycle-of 6) 2)
            (if (eq (tc-cycle-of 10) 2)
            (if (eq (tc-cycle-of 11) 3)
            (if (eq (tc-opens-cycle? 1) 1)
            (if (eq (tc-opens-cycle? 6) 1)
            (if (eq (tc-opens-cycle? 2) 0) 16 0) 0) 0) 0) 0) 0) 0) 0))
    (let c5 (if (eq (tc-holds? "sw") 0)
            (if (eq (tcb-has? (tc-speak "sw" 1) "honest absence") 1) 32 0) 0))
    (let c6 (if (eq (tcb-all-marked? "en" "ice/transmitted" 1) 1)
            (if (eq (tcb-all-marked? "fa" "gas/rented-oracle-2026-09-10" 1) 1) 64 0) 0))

    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6)))))))
