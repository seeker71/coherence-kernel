; tests/hd-bodygraph-band.fk — the nine centres, the 36 channels, and the
; derivations read exactly. Synthetic activation sets only: no birth data
; enters the tree.
;
; preludes: form-stdlib/core.fk form-stdlib/hd-bodygraph.fk
;
; Verdict 1023:
;   all 64 gates placed exactly once                                  1
;   36 channels                                                       2
;   THE CROSS-CHECK: every channel joins two DIFFERENT placed centres 4
;   a channel is defined only when BOTH its gates are activated        8
;   a centre is defined when it sits at either end of one            16
;   no activation at all -> reflector, lunar, definition none        32
;   sacral + motor reaching throat -> manifesting-generator           64
;   authority order: solar plexus outranks sacral                   128
;   reaching the throat is CONNECTIVITY, not adjacency              256
;   definition counts the pieces the defined centres fall into      512
(do
    (defn hbb-bit (ok w) (if ok w 0))
    (defn hbb-count-loop (rs c n)
        (if (eq (len rs) 0) n
            (hbb-count-loop (tail rs) c
                (add n (if (eq (nth (head rs) 1) c) 1 0)))))

    (defn hd-bodygraph-band ()
        (do
            (let c0 (hbb-bit (and (eq (hdb-gate-count) 64)
                                  (and (eq (hdb-centre-of 34) (hdb-sacral))
                                       (eq (hdb-centre-of 20) (hdb-throat)))) 1))
            (let c1 (hbb-bit (eq (hdb-channel-count) 36) 2))
            (let c2 (hbb-bit (eq (hdb-cross-check?) 1) 4))
            ; 34 alone defines nothing; 34+20 defines the channel
            (let one (list 34))
            (let two (list 34 20))
            (let c3 (hbb-bit (and (eq (len (hdb-defined-channels one)) 0)
                                  (gt (len (hdb-defined-channels two)) 0)) 8))
            (let c4 (hbb-bit (and (eq (hdb-centre-defined? two (hdb-sacral)) 1)
                             (and (eq (hdb-centre-defined? two (hdb-throat)) 1)
                                  (eq (hdb-centre-defined? two (hdb-ajna)) 0))) 16))
            (let none (list))
            (let c5 (hbb-bit (and (str_eq (hdb-type none) "reflector")
                             (and (str_eq (hdb-authority none) "lunar")
                                  (str_eq (hdb-definition-name none) "none"))) 32))
            (let c6 (hbb-bit (str_eq (hdb-type two) "manifesting-generator") 64))
            ; 19-49 defines root+solar plexus; with sacral also defined the
            ; solar plexus must still win the authority
            (let both (list 34 20 19 49))
            (let c7 (hbb-bit (and (str_eq (hdb-authority two) "sacral")
                                  (str_eq (hdb-authority both) "emotional")) 128))
            ; INDIRECT reach: 48-16 puts spleen on the throat; spleen is not a
            ; motor, so a lone 48-16 gives a projector, and the root reaching
            ; the throat only through another centre still counts as a motor
            (let spl (list 48 16))
            (let c8 (hbb-bit (and (str_eq (hdb-type spl) "projector")
                             (and (eq (hdb-reaches? spl (hdb-spleen) (hdb-throat)) 1)
                                  (eq (hdb-reaches? spl (hdb-root) (hdb-throat)) 0))) 256))
            ; two disjoint pieces -> split; one piece -> single
            (let c9 (hbb-bit (and (eq (hdb-definition-count two) 1)
                             (and (eq (hdb-definition-count both) 2)
                                  (str_eq (hdb-definition-name both) "split"))) 512))
            (add c0 (add c1 (add c2 (add c3 (add c4
              (add c5 (add c6 (add c7 (add c8 c9)))))))))))
    (hd-bodygraph-band))
