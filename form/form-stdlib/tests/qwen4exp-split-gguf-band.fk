; qwen4exp-split-gguf-band.fk — pure record-selection and authority band.
;
; preludes: form-stdlib/core.fk form-stdlib/qwen4exp-split-gguf.bml
;
; Verdict 255: 127 executable checks, 128 from the high-BML authority.

(do
    (defn q4sgb-has (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let base (q4s-check))
    (let src (read_file "form/form-stdlib/bml/qwen4exp-split-gguf.bml"))
    (let authority
        (if (eq (q4sgb-has src "const int MetadataTensorCount = 0") 1)
            (if (eq (q4sgb-has src "const int TotalTensorCount = 1224") 1)
                (if (eq (q4sgb-has src "const String MappingDoor = \"metal_buf_from_file\"") 1)
                    (if (eq (q4sgb-has src "const String RuntimeDependency = \"none\"") 1)
                        128 0) 0) 0) 0))
    (add base authority))
