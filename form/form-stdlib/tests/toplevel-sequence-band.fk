; toplevel-sequence-band.fk — every top-level statement of a unit runs, in
; order, and the last one's value is the answer.
;
; Before 2026-09-02 the parser kept only the LAST top-level form as the root
; (`fk_root = fk_sparse()` per form): every earlier statement was parsed,
; then dropped. A (print_str "x") followed by 0 printed nothing and answered
; 0; a write_file before a trailing value never touched the disk. The Go arm
; wraps multiple top-level forms in an implicit do (readRootFromSource) and
; runs them all — the drop was a live four-way divergence. Its loudest
; victim was the direct-.bml lane: a .bml section lowers to exactly such a
; statement sequence, so every observe/*.bml organ reporting through
; print_str ran voiceless (observe/source-counsel.bml the witnessed one).
;
; This band's own file is the in-process witness: it is deliberately MANY
; top-level forms (let, statement, do), not the usual single (do ...) — the
; shape under proof. The child legs spawn the direct-.bml lane whole.
;
; Authored in .fk (below the BML+ altitude floor): the validate sweep and
; the fourth-arm lane walk form-stdlib/tests/*.fk, and the multi-form
; surface under proof is the .fk top level itself.
;
; PROOF LEVEL: FOURTH-ARM ONLY — go answers 1 of 15 (witnessed 2026-09-03; host-exec pf-arm-mask 9). host-exec spawns the fkwu binary on a
; child .bml, which only this arm carries. Run from the repo root:
;   ./fkwu form/form-stdlib/tests/toplevel-sequence-band.fk
;
; Bits (power-of-two weights):
;    1  an earlier top-level statement of THIS unit ran (its spool exists)
;    2  direct .bml child: print_str's line crossed the child's stdout
;    4  direct .bml child: the trailing value crossed stdout after the voice
;    8  direct .bml child: an earlier write_file statement touched the disk
; Verdict 15
; witnessed: 2026-09-02 -> 15
; preludes: form-stdlib/core.fk

(let tsb-stamp (int_to_str (now_unix_ms)))
(let tsb-parent-spool (str_concat (temp_dir) (str_concat "/toplevel-seq-parent." tsb-stamp)))
(let tsb-child-spool (str_concat (temp_dir) (str_concat "/toplevel-seq-child." tsb-stamp)))
(let tsb-child-bml (str_concat (temp_dir) (str_concat "/toplevel-seq-child." (str_concat tsb-stamp ".bml"))))

(write_file tsb-parent-spool "parent-first-ran")

(do
    (defn tsb-q () (byte_to_str 34))
    (defn tsb-nl () (byte_to_str 10))
    (defn tsb-line (head tail) (str_concat head (str_concat tail (tsb-nl))))
    (defn tsb-quoted (s) (str_concat (tsb-q) (str_concat s (tsb-q))))
    (defn tsb-child-text ()
        (str_concat (tsb-line "section [form.bml] {" "")
        (str_concat (tsb-line "    write_file(" (str_concat (tsb-quoted tsb-child-spool)
                                                (str_concat ", " (str_concat (tsb-quoted "child-first-ran") ");"))))
        (str_concat (tsb-line "    print_str(" (str_concat (tsb-quoted "seq-child-voice") ");"))
        (str_concat (tsb-line "    46;" "")
                    (tsb-line "}" ""))))))
    (let wrote (write_file tsb-child-bml (tsb-child-text)))
    (let child-out (host-exec (str_concat "./fkwu " tsb-child-bml) ""))

    (let parent-mark (read_file tsb-parent-spool))
    (let c0 (if (nothing? parent-mark) 0
                (if (str_eq parent-mark "parent-first-ran") 1 0)))

    (let voice-at (str_find child-out "seq-child-voice" 0))
    (let c1 (if (ge voice-at 0) 2 0))

    (let value-at (str_find child-out "46" 0))
    (let c2 (if (and (ge value-at 0) (gt value-at voice-at)) 4 0))

    (let child-mark (read_file tsb-child-spool))
    (let c3 (if (nothing? child-mark) 0
                (if (str_eq child-mark "child-first-ran") 8 0)))

    (let swept (host-exec (str_concat "rm -f "
        (str_concat tsb-parent-spool (str_concat " " (str_concat tsb-child-spool
        (str_concat " " (str_concat tsb-child-bml ".*")))))) ""))
    (let swept2 (host-exec (str_concat "rm -f " tsb-child-bml) ""))

    (add c0 (add c1 (add c2 c3))))
