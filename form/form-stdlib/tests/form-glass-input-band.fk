; Pure controller/decoder proof; no terminal acquisition or living-state write.
; preludes: form/form-stdlib/form-glass-live.bml observe/bidirectional-framebuffer-channel.fk
; witnessed: 2026-09-07 -> 131071
(do
  (defn gki-bit (name value weight) (if (eq value 1) weight (do (print name) 0)))
  (defn gki-sum (xs) (if (eq (len xs) 0) 0 (add (head xs) (gki-sum (tail xs)))))
  (defn gki-feed (c text) (fgl-input-feed c (list) text 0 1000))
  (defn gki-views (keys views c) (if (eq (len keys) 0) 1
    (and (str_eq (fgl-control-view (gki-feed c (head keys))) (head views))
      (gki-views (tail keys) (tail views) c))))
  (let start (fgl-control-state "all" "none" 0 "held"))
  (let meaning (gki-feed start "s"))
  (let clear (gki-feed meaning "0"))
  (let py (gki-feed clear "2"))
  (let both (gki-feed py "1"))
  (let esc (byte_to_str 27))
  (let paste (str_concat esc (str_concat "[200~q01234h" (str_concat esc "[201~"))))
  (let pasted (gki-feed meaning paste))
  (let split1 (gki-feed meaning esc))
  (let split2 (gki-feed split1 "["))
  (let split3 (gki-feed split2 "B"))
  (let unknown (gki-feed meaning (str_concat esc "[99q")))
  (let prompt (gki-feed start "i"))
  (let pasteSubmit (gki-feed prompt (fgtm-cat (list esc "[200~q\n" esc "[201~"))))
  (let typed (gki-feed prompt "sample.onex"))
  (let edited (gki-feed typed (byte_to_str 127)))
  (let submitted (gki-feed edited "\r"))
  (let sample (fgl-monitor-sample 1000))
  (let selected (fgl-input-feed start (list sample) "\t" 0 1000))
  (let inspected (fgl-input-feed selected (list sample) "e" 0 1000))
  (let refused (fgl-control-proposed both (fgtm-control-offer "glass-monitor" "bad" 1000 "focus" (fgtm-present "nonexistent-selector") "declared" "test") (list)))
  (let zeroOffer (fgtm-control-offer "glass-monitor" "clear" 1000 "focus" (fgtm-present "none") "declared" "test"))
  ; Bounded diagnostic exchange: offer the current selection, correlate the
  ; requested clear, apply the actual production transition, re-observe it.
  (let out (bfc-envelope 0 907 0 (list "transcript languages" (fgl-control-filter meaning)) meaning))
  (let outRecorded (bfc-record-out out 0))
  (let inbound (bfc-control out 5))
  (let inRecorded (bfc-record-in inbound 1))
  (let healed (bfc-apply out inbound meaning (gki-feed meaning "0")))
  (let reobserved (bfc-record-out (bfc-envelope 0 907 0 (list "transcript languages" (fgl-control-filter healed)) meaning) 2))
  (print (gki-sum (list
    (gki-bit "all view keys" (and (gki-views (list "h" "a" "t" "o" "m" "f" "j" "s" "k" "v" "n" "d") (list "help" "atlas" "raster" "overview" "memory" "flow" "recipes" "meaning" "kernel" "events" "channels" "choice") start) (str_eq (fgl-control-focus (gki-feed start "r")) (FGLEarDomain))) 1)
    (gki-bit "zero clears without changing focus" (and (str_eq (fgl-control-filter healed) "none") (and (str_eq (fgl-control-filter clear) "none") (str_eq (fgl-control-focus clear) "all"))) 2)
    (gki-bit "select Portuguese" (str_eq (fgl-control-filter py) "pt") 4)
    (gki-bit "toggle multiple and repeat" (and (str_eq (fgl-control-filter both) "en+pt") (str_eq (fgl-control-filter (gki-feed both "1")) "pt")) 8)
    (gki-bit "all transcript languages" (eq (fglm-selected-count (fgl-control-filter (gki-feed clear "1234"))) 4) 16)
    (gki-bit "paste never commands" (and (eq (fgl-control-quit? pasted) 0) (str_eq (fgl-control-view pasted) "meaning")) 32)
    (gki-bit "split arrow and no-sample navigation" (and (eq (str_len (fgki-escape (fgl-input-state split3))) 0) (str_eq (fgl-control-view split3) "meaning")) 64)
    (gki-bit "unknown CSI cannot quit" (eq (fgl-control-quit? unknown) 0) 128)
    (gki-bit "prompt editing and submission" (and (str_eq (fgki-text (fgl-input-state edited)) "sample.one") (str_eq (fgl-control-selected submitted) "sample.one")) 256)
    (gki-bit "escape cancels" (str_eq (fgki-mode (fgki-expire (fgl-input-state (gki-feed prompt esc)) 1200)) "") 512)
    (gki-bit "paste cannot submit a prompt" (str_eq (fgki-mode (fgl-input-state pasteSubmit)) "inspect") 1024)
    (gki-bit "tab then evidence without Enter" (and (str_eq (fgl-control-selected selected) (fglui-sample-selection-id sample)) (eq (fgl-control-evidence-open? inspected) 1)) 2048)
    (gki-bit "refusal preserves filter" (and (str_eq (fgl-control-status refused) "refused") (str_eq (fgl-control-filter refused) (fgl-control-filter both))) 4096)
    (gki-bit "remote zero applies" (and (eq (fgl-control-offer-applicable? (list) zeroOffer) 1) (str_eq (fgl-control-filter (fgl-control-proposed both zeroOffer (list))) "none")) 8192)
    (gki-bit "continue quit and choice cursor" (and (str_eq (fgl-control-selected (gki-feed start "dgg")) "choice.1") (and (str_eq (fgl-control-status (gki-feed start "dy")) "refused") (and (str_eq (fgl-control-filter (gki-feed py "c")) "all") (and (str_eq (fgl-control-selected (gki-feed inspected "c")) "none") (eq (fgl-control-quit? (gki-feed py "q")) 1))))) 16384)
    (gki-bit "keypress wait is a control wake" (str_eq (fgel-wake-kind (fgl-wait-wake (list 1 -2 1000 (list)) (list) (list) 1001 (fgel-schedule-start 1000 50))) "control") 32768)
    (gki-bit "natural language prompt and room return" (and (str_eq (fgl-control-filter (gki-feed start "len+de\r")) "en+de") (and (str_eq (fgl-control-status (gki-feed both "lpy\r")) "refused") (and (str_eq (fgki-mode (fgl-input-state (gki-feed start "len+de"))) "languages") (str_eq (fgl-control-focus (gki-feed meaning "r")) (FGLEarDomain))))) 65536))))
)
