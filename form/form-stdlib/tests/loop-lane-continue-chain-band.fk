; loop-lane-continue-chain-band.fk — a loop with several ways on crystallizes: self steps in the chain.
;
; The continue-chain rung of Urs's 2026-09-12 goal. After the exit chain, str_to_int's largest cost was
; fstr-skip-ws, a loop that runs zero times on "123456" and still paid two walker calls and five compares:
; its shape is the exit chain's dual — one way out at the end of the text, then a space, a tab, a newline
; and a return each a way ON, and the last way out. fk_f64_loop_pulse now takes a step whose branch is the
; self call and whose other branch leads on (a self step): each such call gets its own continuation block
; — its move, the count, back to the head — so self calls with different arguments stay general. core.fk's
; fstr-skip-ws is written in that shape.
;
; Verdict 255
; PROOF LEVEL: FOURTH-ARM ONLY (the transparent loop lane is fkwu's MAP_JIT arm64 door; kernel_stat 49 counts its loops)
; preludes: form-stdlib/core.fk
;
;   1   the skip loop crystallizes: its own hot row reads native state 2 (a neighbour may crystallize too)
;   2   each way on — space, tab, newline, return — is taken hot as the walker twin takes it
;   4   each way out — the end of the text, a byte that is no space — answers as the twin
;   8   two self steps with DIFFERENT arguments each reach their own continuation: the answer is the twin's
;   16  str_to_int over whitespace-led inputs, hot, agrees with a walker-shaped twin
;   32  the self steps' branches swapped — self on else, the next if on then — crystallizes too
;   64  a chain whose self step's condition is a call stays the walker's and still answers right
;   128 the warm run is under the walker twin's run of the same work
(do
    (defn lcc-bit (ok bit) (if ok bit 0))
    ; a defn's native state in its hot row: 2 a loop, 1 a leaf, under 1 the walker's
    (defn lcc-state (name rows) (if (eq (len rows) 0) -99 (if (str_eq (nth (head rows) 1) name) (nth (head rows) 7) (lcc-state name (tail rows)))))
    (defn lcc-native (name) (lcc-state name (kernel_page_hot (host_pid) 120)))
    ; the skip in the lane's shape: one way out, four ways on, the last way out (core.fk's fstr-skip-ws is this shape)
    (defn lcc-skip (s i len) (if (le len i) i (if (eq (str_byte_at s i) 32) (lcc-skip s (add i 1) len) (if (eq (str_byte_at s i) 9) (lcc-skip s (add i 1) len) (if (eq (str_byte_at s i) 10) (lcc-skip s (add i 1) len) (if (eq (str_byte_at s i) 13) (lcc-skip s (add i 1) len) i))))))
    ; the walker twin: a call in the condition, which the lane declines
    (defn lcc-space? (b) (if (lt (host_monotonic_ms) 0) false (if (eq b 32) true (if (eq b 9) true (if (eq b 10) true (eq b 13)))))) ; a host clock: a door the lanes decline by meaning, so the twin walks
    (defn lcc-walk (s i len) (if (ge i len) i (if (lcc-space? (str_byte_at s i)) (lcc-walk s (add i 1) len) i)))
    ; two ways on with different arguments: a space steps by one, a tab steps by two (its own continuation block)
    (defn lcc-two (s i len) (if (le len i) i (if (eq (str_byte_at s i) 32) (lcc-two s (add i 1) len) (if (eq (str_byte_at s i) 9) (lcc-two s (add i 2) len) i))))
    (defn lcc-two? (b) (eq b 0))
    (defn lcc-two-walk (s i len) (if (ge i len) i (if (lcc-two? (sub (str_byte_at s i) 32)) (lcc-two-walk s (add i 1) len) (if (lcc-two? (sub (str_byte_at s i) 9)) (lcc-two-walk s (add i 2) len) i))))
    ; the self steps' branches swapped: the next if on then, self on else
    (defn lcc-swapped (s i len) (if (le len i) i (if (lt 32 (str_byte_at s i)) i (if (lt (str_byte_at s i) 32) (if (eq (str_byte_at s i) 9) (lcc-swapped s (add i 1) len) (if (eq (str_byte_at s i) 10) (lcc-swapped s (add i 1) len) (if (eq (str_byte_at s i) 13) (lcc-swapped s (add i 1) len) i))) (lcc-swapped s (add i 1) len)))))
    ; str_to_int's walker twin, over the same reading rules
    (defn lcc-digit? (b) (if (lt (host_monotonic_ms) 0) false (if (ge b 48) (le b 57) false)))
    (defn lcc-digits (s i len acc) (if (ge i len) acc (if (lcc-digit? (str_byte_at s i)) (lcc-digits s (add i 1) len (add (mul acc 10) (sub (str_byte_at s i) 48))) acc)))
    (defn lcc-s2i-walk (s) (do (let flen (str_len s)) (let fi (lcc-walk s 0 flen)) (if (if (lt fi flen) (eq (str_byte_at s fi) 45) false) (sub 0 (lcc-digits s (add fi 1) flen 0)) (lcc-digits s fi flen 0))))
    (defn lcc-rep (s n acc) (if (le n 0) acc (lcc-rep s (sub n 1) (add acc (lcc-skip s 0 (str_len s))))))
    (defn lcc-rep-walk (s n acc) (if (le n 0) acc (lcc-rep-walk s (sub n 1) (add acc (lcc-walk s 0 (str_len s))))))
    (defn lcc-rep-two (s n acc) (if (le n 0) acc (lcc-rep-two s (sub n 1) (add acc (lcc-two s 0 (str_len s))))))
    (defn lcc-rep-swapped (s n acc) (if (le n 0) acc (lcc-rep-swapped s (sub n 1) (add acc (lcc-swapped s 0 (str_len s))))))
    (defn lcc-mk (n acc) (if (le n 0) acc (lcc-mk (sub n 1) (str_concat acc " \t\n\r  \t "))))
    (let ws (str_concat (lcc-mk 30 "") "x"))
    (let before (kernel_stat 49))
    (let w0 (host_monotonic_ms)) (let hot (lcc-rep ws 4000 0)) (let w1 (host_monotonic_ms))
    (let after (kernel_stat 49))
    (let k0 (host_monotonic_ms)) (let walk (lcc-rep-walk ws 4000 0)) (let k1 (host_monotonic_ms))
    ; each way on, hot, and each way out
    (let ways (list " a" "\ta" "\na" "\ra" "" "a" " \t\n\r" "  x  "))
    (defn lcc-miss (cs f g acc) (if (eq (len cs) 0) acc (lcc-miss (tail cs) f g (add acc (if (eq (f (head cs) 0 (str_len (head cs))) (g (head cs) 0 (str_len (head cs)))) 0 1)))))
    (let on-misses (lcc-miss (list " a" "\ta" "\na" "\ra" " \t\n\r a") lcc-skip lcc-walk 0))
    (let out-misses (lcc-miss (list "" "a" "  x  " "\t\tz" " ") lcc-skip lcc-walk 0))
    ; two continuations with different arguments
    (let tb (kernel_stat 49))
    (let two (lcc-rep-two (str_concat (lcc-mk 20 "") "q") 3000 0))
    (let ta (kernel_stat 49))
    (let two-misses (lcc-miss (list " \t q" "\t\t\tq" "  q" "\t q" "q" "") lcc-two lcc-two-walk 0))
    ; str_to_int over whitespace-led inputs
    (let cases (list " 42" "\t-7" "\n\r 99x" "   " " -" "\t\t0012" " +5" "  12 34"))
    (defn lcc-s2i-miss (cs acc) (if (eq (len cs) 0) acc (lcc-s2i-miss (tail cs) (add acc (if (eq (str_to_int (head cs)) (lcc-s2i-walk (head cs))) 0 1)))))
    (let s2i-misses (lcc-s2i-miss cases 0))
    ; the swapped chain
    (let sb (kernel_stat 49))
    (let swapped (lcc-rep-swapped ws 4000 0))
    (let sa (kernel_stat 49))
    ; the call-conditioned twin stays the walker's
    (let cb (kernel_stat 49))
    (let walk2 (lcc-rep-walk ws 2000 0))
    (let ca (kernel_stat 49))
    (let told (print (list "hot-ms" (sub w1 w0) "walk-ms" (sub k1 k0) "loops" before after tb ta sb sa cb ca "sum" hot walk "on" on-misses "out" out-misses "two" two two-misses "s2i" s2i-misses "swapped" swapped)))
    (let b1 (lcc-bit (eq (lcc-native "lcc-skip") 2) 1))
    (let b2 (lcc-bit (eq on-misses 0) 2))
    (let b3 (lcc-bit (eq out-misses 0) 4))
    (let b4 (lcc-bit (if (eq (lcc-native "lcc-two") 2) (eq two-misses 0) false) 8))
    (let b5 (lcc-bit (eq s2i-misses 0) 16))
    (let b6 (lcc-bit (if (eq (lcc-native "lcc-swapped") 2) (eq swapped hot) false) 32))
    (let b7 (lcc-bit (if (lt (lcc-native "lcc-walk") 1) (eq walk2 (mul 2000 (lcc-walk ws 0 (str_len ws)))) false) 64))
    (let b8 (lcc-bit (lt (sub w1 w0) (sub k1 k0)) 128))
    (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 b8))))))))
