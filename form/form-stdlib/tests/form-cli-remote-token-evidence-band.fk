; form-cli-remote-token-evidence-band.fk — BML authority stays executable and
; names the remote-token denominator without carrying remote prose.  The
; comparison remains absent until a settled same-task provider receipt exists.
;
; preludes: form-stdlib/core.fk form-stdlib/language-template.fk
; preludes: form-stdlib/bml/form-cli-remote-token-evidence.bml

(do
    (let src (read_file "form/form-stdlib/bml/form-cli-remote-token-evidence.bml"))
    (let c0 (if (str_eq (frte-event-name) "token_count") 1 0))
    (let c1 (if (str_eq (frte-last-usage-name) "last_token_usage") 2 0))
    (let c2 (if (str_eq (frte-cumulative-usage-name) "total_token_usage") 4 0))
    (let c3 (if (str_eq (frte-quantity-rule)
                         "sum-last-call-quantity-per-completed-call") 8 0))
    (let c4 (if (str_eq (frte-boundary-rule)
                         "event-count-is-not-token-volume") 16 0))
    (let c5 (if (eq (frte-separate-quantity-from-event?) 1) 32 0))
    (let c6 (if (eq (frte-last-not-cumulative?) 1) 64 0))
    (let c7 (if (and (ge (str_find src "section [form.bml]" 0) 0)
                     (and (ge (str_find src "template RemoteTokenTotals" 0) 0)
                          (ge (str_find src "class FormRemoteTokenEvidence" 0) 0)))
                128 0))
    (let c8 (if (str_eq (frte-discovery-rule)
                         "retain-native-backward-cursor-across-bound-rollout-appends") 256 0))
    (let c9 (if (str_eq (frte-active-rule)
                         "last-completed-provider-call-is-pressure-not-settled-share") 512 0))
    (let task (intern_node_at (intern_trivial_string "form-cli-token-band")
        (list (intern_trivial_int 7)) "form-cli-remote-token-evidence-band.fk" 30 1))
    (let other-task (intern_node_at (intern_trivial_string "form-cli-token-band")
        (list (intern_trivial_int 8)) "form-cli-remote-token-evidence-band.fk" 31 1))
    (let baseline (frte-receipt task 1 (frte-provider-source) 1 1000))
    (let direct (frte-receipt task 1 (frte-local-direct-source) 0 0))
    (let tenth (frte-receipt task 1 "local-measured" 0 100))
    (let mismatch (frte-receipt other-task 1 (frte-local-direct-source) 0 0))
    (let empty-baseline nothing)
    (let zero-baseline (frte-receipt task 1 (frte-provider-source) 1 0))
    (let c10 (if (and (eq (frte-receipt? baseline) 1)
                      (node_eq (frte-receipt-task-node baseline) task)) 1024 0))
    (let c11 (if (and (eq (frte-provider-baseline? baseline) 1)
                      (eq (frte-local-direct? direct) 1)) 2048 0))
    (let c12 (if (and (eq (frte-comparable? baseline direct) 1)
                      (and (eq (frte-ratio-bps baseline direct) 0)
                           (eq (frte-local-direct-under-ten-percent? baseline direct) 1))) 4096 0))
    (let c13 (if (and (eq (frte-ratio-bps baseline tenth) 1000)
                      (eq (frte-under-ten-percent? baseline tenth) 1)) 8192 0))
    (let c14 (if (and (nothing? (frte-ratio-bps baseline mismatch))
                      (nothing? (frte-ratio-bps empty-baseline direct))) 16384 0))
    (let c15 (if (and (eq (frte-provider-baseline? zero-baseline) 0)
                      (nothing? (frte-local-direct-under-ten-percent? zero-baseline direct))) 32768 0))
    (let c16 (if (and (str_eq (frte-comparison-rule)
                            "same-task-node-settled-provider-baseline-vs-local-direct")
                      (ge (str_find src "ComparableRemoteTokenReceipt" 0) 0)) 65536 0))
    (let c17 (if (and (str_eq (frte-last-usage-marker) "\"last_token_usage\":")
                       (eq (frte-call-local-usage-line?
                           "{\"payload\":{\"type\":\"provider_usage\",\"last_token_usage\":{\"output_tokens\":1}}}") 1)) 131072 0))
    (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17)))
