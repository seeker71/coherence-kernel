; loop-lane-self-recursion-band.fk -- non-tail (tree) self-recursion crystallizes: the lane calls its own page.
;
; The loop lane turns a TAIL self-call into a loop. A NON-TAIL self-call -- one nested in an expression, so the
; walk must recurse and then continue -- used to decline (-1241): the lane is a loop, not a stack machine, and a
; page cannot call itself while it is being compiled (its address is 0 until install). Now it can: a non-tail
; self-call emits a real recursive call to the page, its address a placeholder the install patches once the page
; exists (like the overflow-block branch patching, but at install), on the C stack. Before each such call the leaf
; checks the walker's own stack wall: past it, the run stops exactly as the walker's does ("eval too deep", exit 1),
; so a deep recursion ends honestly instead of crashing. This first cut takes a self-recipe that answers an int and
; passes no string to itself -- the shape value_eq's nested comparison and every tree fold wear.
;
; The witness here is a pure-INT tree fold: `dsum` is a loop (its outer self-call is tail) whose accumulator folds
; in the recursion's OWN nested (non-tail) self-call `(dsum (sub n 2) 0)`. That nested call is exactly the -1241
; shape this rung admits. A list-tree fold would need to tell a list element from an atom inside the leaf, and
; value_kind (the kind's name as a string) declines in the lane (-1201), so the int fold is the witness.
;
; Verdict 15
; PROOF LEVEL: FOURTH-ARM ONLY (crystallization is fkwu's MAP_JIT lane; a defn's native state is the 8th hot-row field)
; preludes: form-stdlib/core.fk
;
;   1   a loop-shaped recipe with a non-tail self-call (recurse into a sub-problem, then continue the outer walk) reads state 2
;   2   it answers correctly (a fold where each step adds the recursion's own nested sum of a smaller sub-problem)
;   4   the warm run is under a walker twin's run of the same work
;   8   two million deep, the compiled recursion stops the run as the walker's wall does (a child exits 1, not 138)
(do
    (defn sr-bit (ok bit) (if ok bit 0))
    (defn sr-state (name rows) (if (eq (len rows) 0) -99 (if (str_eq (nth (head rows) 1) name) (nth (head rows) 7) (sr-state name (tail rows)))))
    (defn sr-lt? (a b) (if (lt (host_monotonic_ms) 0) false (lt a b))) ; a host clock the lane declines, so the twin walks
    ; a fold: the outer self-call is the loop (tail); each step adds the recursion's own nested sum of a smaller
    ; sub-problem -- (dsum (sub n 2) 0), a NON-TAIL self-call nested inside the (add acc ...).
    (defn dsum (n acc) (if (le n 0) acc (dsum (sub n 1) (add acc (if (le n 2) n (dsum (sub n 2) 0))))))
    (defn dsum-w (m n acc) (if (sr-lt? 0 n) (dsum-w m (sub n 1) (add acc (dsum m 0))) acc)) ; twin: guard holds a host clock -> walks
    (defn hot (m n acc) (if (le n 0) acc (hot m (sub n 1) (add acc (dsum m 0)))))
    (let heat (hot 8 6000 0))
    (let st (sr-state "dsum" (kernel_page_hot (host_pid) 300)))
    (let cryst-ok (eq st 2))
    (let ans-ok (if (eq (dsum 6 0) 18) (if (eq (dsum 8 0) 47) (eq (dsum 10 0) 123) false) false)) ; g(6)=18, g(8)=47, g(10)=123
    (let w0 (host_monotonic_ms)) (let warm (hot 8 20000 0)) (let w1 (host_monotonic_ms))
    (let k0 (host_monotonic_ms)) (let cold (dsum-w 8 20000 0)) (let k1 (host_monotonic_ms))
    (let fast-ok (if (eq warm cold) (lt (sub w1 w0) (sub k1 k0)) false))
    ; 8: a child heats the recursion, then nests it two million deep; past the wall it stops as the walker does
    (let deep-child (host_spawn_quiet (list "./fkwu" "form/form-stdlib/tests/self-recursion-deep-child.fk")))
    (let deep-rc (if (gt deep-child 0) (host_wait deep-child) -1))
    (let deep-ok (eq deep-rc 1))
    (let told (print (list "state" st "cryst" cryst-ok "ans" ans-ok "fast" fast-ok "deep-rc" deep-rc "ms" (sub w1 w0) (sub k1 k0))))
    (add (sr-bit cryst-ok 1) (add (sr-bit (if cryst-ok ans-ok false) 2) (add (sr-bit fast-ok 4) (sr-bit deep-ok 8)))))
