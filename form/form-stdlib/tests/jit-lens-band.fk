; jit-lens-band.fk — the JIT's boxing and unboxing, seen per defn while it runs.
;
; One defn adds floats twenty thousand times, one adds ints. The kernel charges every
; float box minted and every float box read to the defn running; the glass rows carry
; both ledgers on the hot defns, the boxing worklist names the minter first, the totals
; stand in kernel_stat 45/46/47 and on the live page, and loop unrolling is named absent
; by its door -- the arm64 u32 leaf does not claim the loop -- rather than invented.
;
; Expected: 255
; preludes: form/form-stdlib/form-glass-live.bml

(do
    (defn jlb-bit (ok bit) (if ok bit 0))
    (defn jlb-find (rows id) (if (eq (len rows) 0) (list) (if (str_eq (fgo-id (head rows)) id) (head rows) (jlb-find (tail rows) id))))
    (defn jlb-hot (cells name) (if (eq (len cells) 0) (list) (if (str_eq (nth (head cells) 1) name) (head cells) (jlb-hot (tail cells) name))))
    (defn jlb-floaty (n acc) (if (eq n 0) acc (jlb-floaty (sub n 1) (add acc 0.5))))
    (defn jlb-inty (n acc) (if (eq n 0) acc (jlb-inty (sub n 1) (add acc 1))))
    (let f (jlb-floaty 20000 0.0))
    (let g (jlb-inty 20000 0))
    (let hot (kernel_hot_rows 8))
    (let floaty (jlb-hot hot "jlb-floaty"))
    (let inty (jlb-hot hot "jlb-inty"))
    (let worklist (kernel_box_rows 2))
    (let rows (fgl-kernel-rows))
    (let boxes (jlb-find rows "jit-boxes"))
    (let unboxes (jlb-find rows "jit-unboxes"))
    (let native (jlb-find rows "jit-native-calls"))
    (let unroll (jlb-find rows "jit-unroll"))
    (let boxRow (jlb-find rows "box.jlb-floaty"))
    (let live (kernel_live (host_pid)))
    (let b0 (jlb-bit (and (ge (kernel_stat 45) 20000) (ge (kernel_stat 46) 40000)) 1))
    (let b1 (jlb-bit (and (eq (len floaty) 7) (and (ge (nth floaty 5) 20000) (ge (nth floaty 6) 40000))) 2))
    (let b2 (jlb-bit (and (eq (len inty) 7) (and (eq (nth inty 5) 0) (eq (nth inty 6) 0))) 4))
    (let b3 (jlb-bit (and (gt (len worklist) 0) (str_eq (nth (head worklist) 1) "jlb-floaty")) 8))
    (let b4 (jlb-bit (and (gt (len boxes) 0) (and (ge (fgo-int-value boxes) 20000) (and (gt (len unboxes) 0) (ge (fgo-int-value unboxes) 40000)))) 16))
    (let b5 (jlb-bit (and (gt (len native) 0) (and (eq (fgo-present? native) 1) (ge (fgo-int-value native) 0))) 32))
    (let b6 (jlb-bit (and (gt (len unroll) 0) (and (eq (fgo-present? unroll) 0) (ge (str_find (fgo-source unroll) "does not claim the loop" 0) 0))) 64))
    (let b7 (jlb-bit (and (gt (len boxRow) 0) (and (ge (fgo-int-value boxRow) 20000) (and (ge (len live) 27) (ge (nth live 24) 20000)))) 128))
    (print (list "jit-lens" "boxes" (kernel_stat 45) "unboxes" (kernel_stat 46) "native" (kernel_stat 47) "floaty" (if (eq (len floaty) 7) (list (nth floaty 5) (nth floaty 6)) "absent") "inty" (if (eq (len inty) 7) (list (nth inty 5) (nth inty 6)) "absent")))
    (add b0 (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 b7))))))))
