; jit-lens-band.fk — the JIT's boxing, unboxing and crystallization, seen per defn while it runs.
;
; Two twin loops add floats and ints twenty thousand times; both are self-tail-call bodies, so
; once their heat crosses 1024 dispatches the kernel reads the type signature off the live frame
; and crystallizes each as a native arm64 loop (parameters in registers, compare and branch, the
; body emitted twice per pass): the same value as the walker, boxes per twenty thousand
; iterations falling from twenty thousand to the one result box, the hot row wearing native=2,
; jit-unroll a real count on the glass. A third loop boxes once per iteration and cannot
; crystallize (a call inside its tail arguments): it is the boxing witness and the worklist head.
; A pure float polynomial crystallizes on its box ledger as an f64 leaf, one box per call
; instead of four, native=1; a call with an int argument walks the original body and answers
; what the walker did. Attribution: a non-tail call restores the caller when the callee returns,
; so a float minted after an int defn returned is not charged to that defn.
;
; Expected: 16383
; preludes: form/form-stdlib/form-glass-live.bml

(do
    (defn jlb-bit (ok bit) (if ok bit 0))
    (defn jlb-find (rows id) (if (eq (len rows) 0) (list) (if (str_eq (fgo-id (head rows)) id) (head rows) (jlb-find (tail rows) id))))
    (defn jlb-hot (cells name) (if (eq (len cells) 0) (list) (if (str_eq (nth (head cells) 1) name) (head cells) (jlb-hot (tail cells) name))))
    (defn jlb-floaty (n acc) (if (eq n 0) acc (jlb-floaty (sub n 1) (add acc 0.5))))
    (defn jlb-inty (n acc) (if (eq n 0) acc (jlb-inty (sub n 1) (add acc 1))))
    (defn jlb-tick (x) (add x 1))
    (defn jlb-boxy (n acc) (if (eq n 0) acc (jlb-boxy (sub n 1) (add acc (jlb-tick 0)))))
    (defn jlb-poly (x y) (add (mul x x) (add (mul 2.0 y) 1.5)))
    (defn jlb-rep (n acc) (if (eq n 0) acc (jlb-rep (sub n 1) (jlb-poly 1.5 acc))))
    (let f (jlb-floaty 20000 0.0))
    (let g (jlb-inty 20000 0))
    (let boxesBeforeF (kernel_stat 45))
    (let f2 (jlb-floaty 20000 0.0))
    (let boxesSecondF (sub (kernel_stat 45) boxesBeforeF))
    (let g2 (jlb-inty 20000 0))
    (let bx (jlb-boxy 20000 0.5))
    (let w0 (jlb-poly 1.5 2.5))
    (let mixed0 (jlb-poly 2 2.5))
    (let warm (jlb-rep 600 0.5))
    (let boxesBefore (kernel_stat 45))
    (let warm2 (jlb-rep 1000 0.5))
    (let boxesPer1000 (sub (kernel_stat 45) boxesBefore))
    (let tickBefore (nth (jlb-hot (kernel_hot_rows 12) "jlb-tick") 5))
    (let t0 (jlb-tick 1))
    (let lit0 3.25)
    (let lit1 (add 4.75 lit0))
    (let hot (kernel_hot_rows 12))
    (let poly (jlb-hot hot "jlb-poly"))
    (let floaty (jlb-hot hot "jlb-floaty"))
    (let inty (jlb-hot hot "jlb-inty"))
    (let boxy (jlb-hot hot "jlb-boxy"))
    (let tick (jlb-hot hot "jlb-tick"))
    (let worklist (kernel_box_rows 2))
    (let rows (fgl-kernel-rows))
    (let boxes (jlb-find rows "jit-boxes"))
    (let unboxes (jlb-find rows "jit-unboxes"))
    (let native (jlb-find rows "jit-native-calls"))
    (let unroll (jlb-find rows "jit-unroll"))
    (let loopIters (jlb-find rows "jit-loop-iterations"))
    (let boxRow (jlb-find rows "box.jlb-boxy"))
    (let crystal (jlb-find rows "jit-crystallized"))
    (let live (kernel_live (host_pid)))
    (let b0 (jlb-bit (and (ge (kernel_stat 45) 20000) (ge (kernel_stat 46) 20000)) 1))
    (let b1 (jlb-bit (and (ge (len floaty) 8) (and (ge (nth floaty 5) 1000) (and (lt (nth floaty 5) 20000) (eq (nth floaty 7) 2)))) 2))
    (let b2 (jlb-bit (and (ge (len inty) 8) (and (eq (nth inty 5) 0) (and (eq (nth inty 6) 0) (eq (nth inty 7) 2)))) 4))
    (let b3 (jlb-bit (and (gt (len worklist) 0) (and (str_eq (nth (head worklist) 1) "jlb-boxy") (and (ge (len boxy) 8) (and (ge (nth boxy 5) 20000) (and (ge (len tick) 8) (eq (nth tick 5) 0)))))) 8))
    (let b4 (jlb-bit (and (gt (len boxes) 0) (and (ge (fgo-int-value boxes) 20000) (and (gt (len unboxes) 0) (ge (fgo-int-value unboxes) 20000)))) 16))
    (let b5 (jlb-bit (and (gt (len native) 0) (and (eq (fgo-present? native) 1) (ge (fgo-int-value native) 1))) 32))
    (let b6 (jlb-bit (and (gt (len unroll) 0) (and (eq (fgo-present? unroll) 1) (and (ge (fgo-int-value unroll) 2) (and (gt (len loopIters) 0) (ge (fgo-int-value loopIters) 20000))))) 64))
    (let b7 (jlb-bit (and (gt (len boxRow) 0) (and (ge (fgo-int-value boxRow) 20000) (and (ge (len live) 33) (and (ge (nth live 24) 20000) (ge (nth live 31) 2))))) 128))
    (print (list "jit-lens" "boxes" (kernel_stat 45) "unboxes" (kernel_stat 46) "native" (kernel_stat 47) "crystallized" (kernel_stat 48) "loops" (kernel_stat 49) "loop-iters" (kernel_stat 50) "floaty" (if (ge (len floaty) 8) (list (nth floaty 5) (nth floaty 6) (nth floaty 7)) "absent") "inty" (if (ge (len inty) 8) (list (nth inty 5) (nth inty 6) (nth inty 7)) "absent") "second-floaty-boxes" boxesSecondF "tick-boxes" tickBefore (if (ge (len tick) 8) (nth tick 5) "absent")))
    (let b8 (jlb-bit (and (eq (jlb-poly 1.5 2.5) w0) (and (eq (jlb-poly 2 2.5) mixed0) (and (eq w0 8.75) (eq mixed0 10.5)))) 256))
    (let b9 (jlb-bit (and (ge (len poly) 8) (and (eq (nth poly 7) 1) (and (ge boxesPer1000 1000) (le boxesPer1000 1001)))) 512))
    (let b10 (jlb-bit (and (ge (kernel_stat 48) 3) (and (ge (kernel_stat 47) 1000) (and (gt (len crystal) 0) (ge (fgo-int-value crystal) 3)))) 1024))
    (let b11 (jlb-bit (and (eq f 10000.0) (and (eq f2 10000.0) (and (le boxesSecondF 2) (ge (kernel_stat 50) 20000)))) 2048))
    (let b12 (jlb-bit (and (eq g 20000) (and (eq g2 20000) (and (ge (kernel_stat 49) 2) (eq bx 20000.5)))) 4096))
    (let b13 (jlb-bit (and (ge (len tick) 8) (and (eq (nth tick 5) tickBefore) (and (eq (nth tick 5) 0) (eq lit1 8.0)))) 8192))
    (add b0 (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 (add b9 (add b10 (add b11 (add b12 b13))))))))))))))
