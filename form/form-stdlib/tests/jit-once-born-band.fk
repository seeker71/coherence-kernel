; jit-once-born-band.fk — one birth per shape through a live flow, on the
; real door: lo-compile-fn arm64 images executed by jit_leaf_inram.
;
; Verdict 2047 (11 bits):
;   1     f(n)=3n+7 compiles and answers 22 at n=5 through the registry
;   2     the SAME shape re-requested: right answer, born=0 — no rebirth
;   4     a different shape births separately and answers (n*n form: 6*6+1=37)
;   8     a six-job flow (three shapes, each twice) births EXACTLY three
;   16    results survive threading: all six answers right, in order
;   32    keys are structural: same prog+root -> same key; differing root
;         or any node int -> different key
;   64    lookup on an absent key is NOTHING — not 0, not a handle
;   128   the bare-nothing trap: retaining an absent image is REFUSED, the
;         registry is unchanged, and no key answers for the failed birth
;   256   an empty image is refused the same way
;   512   a refused birth surfaces as (nothing) result with born=0 — the
;         caller sees the absence, never a fabricated number
;   1024  the registry is data: its size equals its births, and threading
;         never mutates a prior entry (first key still answers after all six)
;
; preludes: form-stdlib/jit-once-born.fk

(do
    (defn job-bit (ok bit) (if ok bit 0))
    ; f(n) = n*3 + 7   root 4
    (defn job-p1 () (list (list 1 7) (list 2) (list 1 3) (list 5 1 2) (list 3 3 0)))
    ; g(n) = n*n + 1   root 3
    (defn job-p2 () (list (list 1 1) (list 2) (list 5 1 1) (list 3 2 0)))
    ; h(n) = n + 100   root 2
    (defn job-p3 () (list (list 1 100) (list 2) (list 3 1 0)))

    (defn jit-once-born-band ()
        (do
            (let r1 (jonb-request (jonb-empty) (job-p1) 4 5))
            (let r2 (jonb-request (nth r1 1) (job-p1) 4 10))
            (let r3 (jonb-request (nth r2 1) (job-p2) 3 6))

            (let flow (jonb-run-all (jonb-empty)
                (list (list (job-p1) 4 1) (list (job-p2) 3 2)
                      (list (job-p3) 2 3) (list (job-p1) 4 4)
                      (list (job-p2) 3 5) (list (job-p3) 2 6))
                (list) 0))
            (let res (nth flow 0))
            (let reg (nth flow 1))

            (let bad (jonb-retain (jonb-empty) 42 (nothing)))
            (let bad2 (jonb-retain (jonb-empty) 42 (list)))
            (let dead (jonb-request-refused))

            (sum (list
                (job-bit (and (eq (nth r1 0) 22) (eq (nth r1 2) 1)) 1)
                (job-bit (and (eq (nth r2 0) 37) (eq (nth r2 2) 0)) 2)
                (job-bit (and (eq (nth r3 0) 37) (eq (nth r3 2) 1)) 4)
                (job-bit (eq (nth flow 2) 3) 8)
                (job-bit (and (eq (nth res 0) 10)
                         (and (eq (nth res 1) 5)
                         (and (eq (nth res 2) 103)
                         (and (eq (nth res 3) 19)
                         (and (eq (nth res 4) 26)
                              (eq (nth res 5) 106)))))) 16)
                (job-bit (and (eq (jonb-key (job-p1) 4) (jonb-key (job-p1) 4))
                         (and (not (eq (jonb-key (job-p1) 4) (jonb-key (job-p1) 3)))
                              (not (eq (jonb-key (job-p1) 4) (jonb-key (job-p2) 3))))) 32)
                (job-bit (nothing? (jonb-lookup (jonb-empty) 7)) 64)
                (job-bit (nothing? bad) 128)
                (job-bit (nothing? bad2) 256)
                (job-bit (and (nothing? (nth dead 0)) (eq (nth dead 2) 0)) 512)
                (job-bit (and (eq (jonb-size reg) 3)
                              (eq (jonb-lookup reg (jonb-key (job-p1) 4))
                                  (jonb-lookup reg (jonb-key (job-p1) 4)))) 1024)))))

    ; a request whose birth is refused: an empty program compiles to an
    ; empty-ish image? No — refusal is driven directly: retain nothing.
    (defn jonb-request-refused ()
        (do (let reg (jonb-empty))
            (let reg2 (jonb-retain reg 9 (nothing)))
            (if (nothing? reg2) (list (nothing) reg 0) (list 1 reg2 1))))

    (jit-once-born-band))
