; living-world-recursive-enquiry-profile-band.fk -- recursive successor enquiry
; and finite observed-profile classes. Twenty-five claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-prospective-suite.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk

(do
    (let result (lwrpw-run))
    (let active (nth (node_children result) 0))
    (let blueprint (nth (node_children result) 1))
    (let bindings (nth (node_children result) 2))
    (let world (nth (node_children result) 3))
    (let space (nth (node_children result) 4))
    (let enquiry (nth (node_children result) 5))
    (let profiles (nth (node_children result) 6))
    (let classes (nth (node_children result) 7))
    (let class (nth (node_children result) 8))
    (let revoked (nth (node_children result) 9))
    (let stale (nth (node_children result) 10))
    (let arriving (nth (node_children active) 2))
    (let tissue (lwps-candidate-model arriving))
    (let hypotheses
        (lwo-field-items
            (lwht-tissue-hypotheses (lwo-emergent-shape tissue))))
    (let slots (lwbb-slot-items (lwbb-blueprint-slots blueprint)))
    (let events (framebuffer-events))
    (sum (list
        (if (eq (lwbb-blueprint-valid? blueprint) 1) 1 0)
        (if (eq (len slots) 2) 2 0)
        (if (and (eq (lwo-field-size
                        (lwbb-slot-values (head slots))) 10)
                 (eq (lwo-field-size
                        (lwbb-slot-values (head (tail slots)))) 10)) 4 0)
        (if (eq (lwo-field-size bindings) 100) 8 0)
        (if (eq (lwhe-bindings-items-valid?
                    (lwo-field-items bindings)) 1) 16 0)
        (if (eq (lwhe-space-valid? space) 1) 32 0)
        (if (eq (lwhe-candidate-current? world tissue) 1) 64 0)
        (if (eq (lwhe-bindings-items-current? world
                    (lwo-field-items bindings)) 1) 128 0)
        (if (eq (lwhe-space-current? world space 2) 1) 256 0)
        (if (eq (lwhe-enquiry-current? world enquiry) 1) 512 0)
        (if (eq (lwo-field-size (lwhe-enquiry-trials enquiry)) 100) 1024 0)
        (if (eq (lwo-field-size
                    (lwhe-enquiry-separating enquiry)) 0) 2048 0)
        (if (eq (lwo-field-size
                    (lwhe-enquiry-aligned enquiry)) 100) 4096 0)
        (if (eq (lwo-field-size profiles) 2) 8192 0)
        (if (eq (lwo-field-size classes) 1) 16384 0)
        (if (eq (lwo-field-size
                    (lwep-class-hypothesis-field class)) 2) 32768 0)
        (if (eq (lwo-field-size (lwep-class-points class)) 100) 65536 0)
        (if (eq (lwlc-unknown? (lwep-class-unknown class)) 1) 131072 0)
        (if (eq (lwep-class-current? world class) 1) 262144 0)
        (if (node_eq (lwep-class-hypothesis-field class)
                (lwht-tissue-hypotheses
                    (lwo-emergent-shape tissue))) 524288 0)
        (if (eq (lwo-field-size
                    (lwht-tissue-hypotheses
                        (lwo-emergent-shape tissue))) 2) 1048576 0)
        (if (eq (lwep-class-current? revoked class) 0) 2097152 0)
        (if (node_eq stale (lwo-none)) 4194304 0)
        (if (eq (len events) 5) 8388608 0)
        (if (not (str_eq
                    (lwre-recipe-source
                        (lwph-hypothesis-recipe (head hypotheses)))
                    (lwre-recipe-source
                        (lwph-hypothesis-recipe
                            (head (tail hypotheses)))))) 16777216 0))))
