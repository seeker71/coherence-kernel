; cell-store-band.fk — another kernel's cell, read where it lives.
;
; A child process interns a composite cell -- category "cell-store-band" over the ints
; 2 and 3 -- and hands over only its pid and two raw store words. This process maps the
; child's value tables (/fg-c<pid>-<letter>) and reads the cell's kind, its category
; (kind, text, NodeID subtype), its kids one cons at a time, and its source line, from the
; child's own columns: no gift of the cell, no wire, no re-interning. The same doors read
; the field the same way, and an unmapped handle answers nothing. Every kernel on this
; host shares one field (/fg-field-<letter>): the child's word IS this process's word.
;
; Expected: 255
; preludes: form/form-stdlib/form-glass-gift-frame.bml

(do
    (defn csb-bit (ok bit) (if ok bit 0))
    (defn csb-take (tries)
        (if (le tries 0) (list)
            (do (let handle (ggf-receive "cell-store-band.child"))
                (let frame (if (nothing? handle) (nothing) (node_gift_read handle)))
                (let released (ggf-release handle))
                (if (nothing? frame) (do (host_sleep_ms 100) (csb-take (sub tries 1)))
                    (if (eq (len frame) 3) frame (do (host_sleep_ms 100) (csb-take (sub tries 1))))))))
    (let stale (ggf-offer "cell-store-band.child" 4096))
    (let cleared (node_gift_write stale (list)))
    (let releasedStale (ggf-release stale))
    (let child (host_spawn_quiet (list "./fkwu" "form/form-stdlib/tests/cell-store-child.fk")))
    (let frame (csb-take 60))
    (let pid (if (eq (len frame) 3) (nth frame 0) -1))
    (let cellRef (if (eq (len frame) 3) (nth frame 1) 0))
    (let catRef (if (eq (len frame) 3) (nth frame 2) 0))
    (let h (if (gt pid 0) (cell_map pid) (nothing)))
    (let mapped (if (nothing? h) 0 1))
    (let kind (if (eq mapped 1) (cell_field h cellRef 0) -1))
    (let catField (if (eq mapped 1) (cell_field h cellRef 1) 0))
    (let catKind (if (eq mapped 1) (cell_field h catRef 0) -1))
    (let catText (if (eq mapped 1) (cell_value h (cell_field h catRef 3)) ""))
    (let catSubtype (if (eq mapped 1) (cell_field h catRef 6) -1))
    (let kids (if (eq mapped 1) (cell_field h cellRef 2) 0))
    (let kid0 (if (eq mapped 1) (cell_value h (cell_field h (cell_field h kids 0) 3)) -1))
    (let kid1 (if (eq mapped 1) (cell_value h (cell_field h (cell_field h (cell_field h kids 1) 0) 3)) -1))
    (let line (if (eq mapped 1) (cell_field h cellRef 9) -1))
    (let live (if (gt pid 0) (kernel_live pid) (list)))
    (let me (cell_map (host_pid)))
    (let b0 (csb-bit (and (eq (len frame) 3) (eq mapped 1)) 1))
    (let b1 (csb-bit (eq kind 2) 2))
    (let b2 (csb-bit (and (eq catKind 1) (and (str_eq catText "cell-store-band") (eq catSubtype 2))) 4))
    (let b3 (csb-bit (and (eq kid0 2) (eq kid1 3)) 8))
    (let b4 (csb-bit (and (eq catField catRef) (ge line 0)) 16))
    (let b5 (csb-bit (and (ge (len live) 24) (and (eq (nth live 22) 2) (eq (nth live 19) 1))) 32))
    (let ownText (cell_ref (intern_trivial_string "own-text")))
    (let ownFloat (cell_ref (intern_trivial_float "2.5")))
    (let b6 (csb-bit (and (eq (cell_value me (cell_ref 42)) 42) (and (str_eq (cell_value me (cell_field me ownText 3)) "own-text") (and (eq (cell_value me (cell_field me ownFloat 3)) 2.5) (nothing? (cell_value me (cell_ref (nothing))))))) 64))
    (let unmapped (if (eq mapped 1) (cell_unmap h) 0))
    (let b7 (csb-bit (and (nothing? (if (eq mapped 1) (cell_field h cellRef 0) (nothing))) (nothing? (cell_field 15 cellRef 0))) 128))
    (let ended (if (gt child 0) (host_kill child) 0))
    (let waited (if (gt child 0) (host_wait child) 0))
    (print (list "cell-store-band" "pid" pid "kind" kind "cat" catText "kids" (list kid0 kid1) "line" line "store-shared" (if (ge (len live) 24) (nth live 22) -1)))
    (add b0 (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 b7))))))))
