; native-model-route-table-band.fk — the route table answers purely: every
; route name form/scripts/native_model_route.sh accepts resolves to its
; right door, kind, step threshold and model identity; an unknown name
; comes back typed, never silent; the table itself holds exactly the four
; rows this pass witnessed.
; Expected: 255
; preludes: form-stdlib/native-model-route-table.bml
(do
    (defn nrtb-bit (ok bit) (if ok bit 0))
    (sum (list
        (nrtb-bit (and (str_eq (nmrt-kind (nmrt-find "form-metal")) "direct-metal")
                       (and (str_eq (nmrt-door (nmrt-find "form-metal")) "form/native/metal/metal_ask.sh")
                            (eq (nmrt-steps (nmrt-find "form-metal")) 12))) 1)
        (nrtb-bit (str_eq (nmrt-door (nmrt-find "llama32.form-metal")) (nmrt-door (nmrt-find "form-metal"))) 2)
        (nrtb-bit (and (str_eq (nmrt-kind (nmrt-find "ollama-llama32")) "ollama-compare")
                       (and (str_eq (nmrt-model (nmrt-find "ollama-llama32")) "llama3.2:3b")
                            (str_eq (nmrt-registered-model (nmrt-find "ollama-llama32")) "base.llama32-3b-local"))) 4)
        (nrtb-bit (and (str_eq (nmrt-kind (nmrt-find "nanbeige42")) "challenger-carrier")
                       (and (str_eq (nmrt-door (nmrt-find "nanbeige42")) "form/scripts/nanbeige_gguf_verify.sh")
                            (and (str_eq (nmrt-model (nmrt-find "nanbeige42")) "nanbeige42-local:Q4_K_M")
                                 (str_eq (nmrt-registered-model (nmrt-find "nanbeige42")) "challenger.nanbeige42-3b-local")))) 8)
        (nrtb-bit (eq (nmrt-known? "bogus-route") 0) 16)
        (nrtb-bit (eq (nmrt-known? "nanbeige42") 1) 32)
        (nrtb-bit (eq (len (nmrt-table)) 4) 64)
        (nrtb-bit (str_eq (nmrt-known-names) "form-metal, llama32.form-metal, ollama-llama32, nanbeige42") 128))))
