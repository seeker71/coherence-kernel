; native-model-route-table-band.fk — the route table answers purely: every
; route name the table holds resolves to the
; native Metal door, its step threshold and model identity; a name that
; would reach a model server is not a row and comes back typed unknown,
; never silent; the table holds exactly the two native rows.
; Expected: 255
; preludes: form-stdlib/native-model-route-table.bml
(do
    (defn nrtb-bit (ok bit) (if ok bit 0))
    (defn nrtb-native? (name)
        (and (str_eq (nmrt-kind (nmrt-find name)) "direct-metal")
             (and (str_eq (nmrt-model (nmrt-find name)) "llama3.2:3b")
                  (str_eq (nmrt-registered-model (nmrt-find name)) "base.llama32-3b-metal"))))
    (sum (list
        (nrtb-bit (and (str_eq (nmrt-kind (nmrt-find "form-metal")) "direct-metal")
                       (and (str_eq (nmrt-door (nmrt-find "form-metal")) "observe/metal-ask-files-run.bml")
                            (eq (nmrt-steps (nmrt-find "form-metal")) 12))) 1)
        (nrtb-bit (str_eq (nmrt-door (nmrt-find "llama32.form-metal")) (nmrt-door (nmrt-find "form-metal"))) 2)
        (nrtb-bit (and (nrtb-native? "form-metal") (nrtb-native? "llama32.form-metal")) 4)
        (nrtb-bit (and (str_eq (nmrt-kind (nmrt-find "ollama-llama32")) "unknown")
                       (str_eq (nmrt-kind (nmrt-find "nanbeige42")) "unknown")) 8)
        (nrtb-bit (eq (nmrt-known? "bogus-route") 0) 16)
        (nrtb-bit (eq (nmrt-known? "llama32.form-metal") 1) 32)
        (nrtb-bit (eq (len (nmrt-table)) 2) 64)
        (nrtb-bit (str_eq (nmrt-known-names) "form-metal, llama32.form-metal") 128))))
