; form-knowledge-axioms-one-family-crossing-band.fk -- pure one-family gate.
;
; Synthetic executable fixtures exercise the same parsers/verifiers as the
; dormant local-Qwen door.  No model, Metal carrier, remote lane, private
; evaluator, registry or generated binary runs here.
;
; Expected: 134217727 (27 bits)
; preludes: form-stdlib/form-knowledge-axioms-one-family-crossing.fk
; preludes: form-stdlib/form-knowledge-axioms-public-curriculum.fk
; PROOF BAND (fkwu): 134217727

(do
    (defn fka1b-bit (held weight) (if held weight 0))
    (defn fka1b-model () "synthetic-axioms-local-qwen")
    (defn fka1b-run () (nmfe-sha256 "synthetic-axioms-one-family-run"))
    (defn fka1b-alt-run () (nmfe-sha256 "synthetic-axioms-other-run"))

    ; ---- heldout lanes a/b ------------------------------------------
    (defn fka1b-row () (fkhe-find-row "h01" (fkhe-rows)))
    (defn fka1b-prefix ()
        "choice-task=knowledge\nchoice-match=1\nbackend=form-native-metal-jit\ngenerated_tokens=20\nforward_passes=20\ntext:\n")
    (defn fka1b-raw (p answer)
        (str_concat (fka1b-prefix)
            (str_concat (fkqt-open)
            (str_concat (str_concat "axioms one-family fixture:"
                                    (fkp30-presentation-trial-id p))
            (str_concat (fkqt-close) answer)))))
    (defn fka1b-trial-with-raw (p raw)
        (do
            (let row (fka1b-row))
            (let score (fkhe-score row
                (fqt-knowledge-prompt (fkhe-prompt row))
                (fkhe-parse-resident-output raw) 7))
            (let observation (fkhe-score-observation score))
            (let present (if (eq (nmfe-obs-error observation) 0) 1 0))
            (let zero (if (and (eq present 1)
                (str_eq (nth score 8) (nmfe-sha256 "0"))) 1 0))
            (let one (if (and (eq present 1)
                (str_eq (nth score 8) (nmfe-sha256 "1"))) 1 0))
            (let session (fkp30-session-id-for (fka1b-run) (fka1b-model)))
            (let nonce (fkp30-trial-nonce-for (fka1b-run) session p))
            (fkp30-trial p score (fka1b-model) (fka1b-run) session raw
                (nmfe-sha256 raw) nonce (fkp30-content-sha-for nonce raw)
                1 0 1 1 1 (if (eq present 1) "value" "nothing")
                present zero one 12 8 20 1 0 0 0 0 7)))
    (defn fka1b-trial (lane)
        (do
            (let p (fkp30-presentation (fka1b-row) lane))
            (fka1b-trial-with-raw p
                (fka1b-raw p (fkhe-expected (fka1b-row))))))

    ; ---- public-generative axioms row -------------------------------
    (defn fka1b-bml ()
        "int Lift(int n) { return n + 1; }\nreturn Lift(65);")
    (defn fka1b-bmf ()
        "grammar {\n  rule atmark { lit @ }\n  rule vowel { class ae }\n  rule markedvowel { seq atmark vowel }\n  rule entrance { alt vowel markedvowel }\n  top entrance\n  probe @a\n}")
    (defn fka1b-form ()
        (do
            (let challenge (fkpfm-family-exec-challenge (fka1-family)))
            (fgsg-control-canonical
                (fgsg-cat (list "<|form:recipe-exec|>"
                    (frex-node-coordinate (frex-recipe))
                    ";input=" (int_to_str (fgsg-challenge-input challenge))
                    ";carrier=auto<|/form:recipe-exec|>"))
                "nothing,timeout,zero" "one"
                (int_to_str (fgsg-challenge-checkpoint challenge))
                (int_to_str (fgsg-challenge-timeout-budget challenge))
                (fgsg-challenge-plane challenge)
                (int_to_str (fgsg-challenge-heat challenge))
                (int_to_str (fgsg-challenge-pure challenge)))))
    (defn fka1b-candidate ()
        (fgsg-candidate (fka1b-bml) (fka1b-bmf) (fka1b-form)))
    (defn fka1b-candidate-raw ()
        (do
            (let c (fka1b-candidate))
            (fgsg-cat (list "<BML>" (fgsg-candidate-bml c) "</BML>"
                "<BMF>" (fgsg-candidate-bmf c) "</BMF>"
                "<FORM>" (fgsg-candidate-form c) "</FORM>"))))
    (defn fka1b-generative-row-for (run-id)
        (do
            (let plan (fkg15-plan-for (fka1-family)))
            (let raw (fka1b-candidate-raw))
            (let session (fkg15-session-id-for run-id (fka1b-model)))
            (let report (str_concat
                "\nstate_released=1\nstate_handles_closed=1\nstate_handles_expected=1\ngenerated_tokens=80\nforward_passes=80\ntext:\n"
                raw))
            (let attempt (fkg15-attempt plan 1 "candidate"
                (fkg15-independent-lane) (fkg15-plan-nonce plan)
                (fkg15-plan-prompt plan) raw (fka1b-model) run-id session
                1 0 1 1 1 7 report 80 80))
            (fkg15-row plan attempt (nothing) (fkg15-independent-lane) 1)))

    ; ---- native execution check ------------------------------------
    (defn fka1b-native-result (request)
        (do
            (let input (fkpfm-family-native-input (fka1-family)))
            (let value (add (mul 3 input) 7))
            (let base (frex-choice request
                (list (frex-offer "metal" "value" value
                    "fixture-axioms-one-family-native"))))
            (frex-result-with-flags "value" (frex-result-reason base)
                request "metal" value 1 (frex-result-trace base)
                (frex-result-attempts base) 1 0 1)))
    (defn fka1b-native-for (run-id)
        (do
            (let binding (fkfne-binding-for-family (fka1-family) "metal"))
            (let prep (fkfne-prepare binding (fkfne-binding-query binding)))
            (let result (fka1b-native-result (fkfne-prep-request prep)))
            (fkfne-check binding prep result (fka1b-model) run-id 0 1)))

    (defn fka1b-diagnostics ()
        (fka1-diag-summary 11 11 0 0 11 0))
    (defn fka1b-residence ()
        (fka1-residence-witness (fka1b-model) (fka1b-run)
            (list
                (fka1-residence-transition "heldout-a" 1 1 1)
                (fka1-residence-transition "heldout-b" 1 1 1)
                (fka1-residence-transition "generative-attempt" 1 1 1)
                (fka1-residence-transition "native-request" 1 1 1))
            1 0 1))
    (defn fka1b-crossing-for (run-id)
        (do
            (let held (fka1-heldout-input (fka1b-trial "a")
                                          (fka1b-trial "b")))
            (let row (fka1b-generative-row-for run-id))
            (let gen (fkg15-evidence-for-row row 1))
            (let native (fka1b-native-for run-id))
            (let vertical (fkav-result (list (fka1-heldout-a held)
                (fka1-heldout-b held)) gen (fkfne-check-evidence native)))
            (fka1-crossing held row gen native
                (fkfne-check-evidence native) (fka1b-model) run-id
                1 0 0 1 (fka1b-diagnostics) (fka1b-residence)
                (fka1-census-snapshot) vertical)))
    (defn fka1b-crossing () (fka1b-crossing-for (fka1b-run)))

    (defn form-knowledge-axioms-one-family-crossing-band ()
        (do
            (let a (fka1b-trial "a"))
            (let b (fka1b-trial "b"))
            (let held (fka1-heldout-input a b))
            (let miss-a (fka1b-trial-with-raw
                (fkp30-trial-presentation a)
                (fka1b-raw (fkp30-trial-presentation a)
                    "an-observed-but-incorrect-baseline")))
            (let miss-held (fka1-heldout-input miss-a b))
            (let crossing (fka1b-crossing))
            (let inputs (fka1-three-inputs crossing))
            (let duplicate-b (fka1b-trial-with-raw
                (fkp30-trial-presentation b) (fkp30-trial-raw-output a)))
            (let duplicate-held (fka1-heldout-input a duplicate-b))
            (let swapped-held (fka1-heldout-input b a))
            (let false-held (list (nth held 0) (nth held 1) (nth held 2)
                (nth held 3) (nth held 4) (list "fabricated") (nth held 6)))
            (let other-row (fka1b-generative-row-for (fka1b-alt-run)))
            (let other-gen (fkg15-evidence-for-row other-row 1))
            (let replayed-gen-crossing (fka1-crossing held other-row other-gen
                (fka1b-native-for (fka1b-run))
                (fkfne-check-evidence (fka1b-native-for (fka1b-run)))
                (fka1b-model) (fka1b-run) 1 0 0 1 (fka1b-diagnostics)
                (fka1b-residence) (fka1-census-snapshot)
                (fkav-result (list a b) other-gen
                    (fkfne-check-evidence (fka1b-native-for (fka1b-run))))))
            (let bad-diag (fka1-diag-summary 11 11 1 0 13 0))
            (let private-diag (fka1-diag-summary 11 11 0 0 11 1))
            (let out (fka1-diag-out 901 "generative-attempt" 4
                (fkhe-source-sha (fka1b-row)) (nmfe-sha256 "observed")
                0 1 "release"))
            (let revise (fka1-diag-in out "generative-attempt" 4))
            (let request-out (fka1-diag-out 902 "native-parse" 2
                (fkhe-source-sha (fka1b-row)) (nmfe-sha256 "nothing")
                1 0 "release"))
            (let request-in (fka1-diag-in request-out "native-parse" 2))
            (let stale (bfc-envelope 1 999 1 2 "release"))
            (sum (list
                (fka1b-bit (and (eq (fkp30-trial-valid? a) 1)
                    (eq (fkp30-trial-valid? b) 1)) 1)
                (fka1b-bit (eq (fka1-heldout-input-valid? held) 1) 2)
                (fka1b-bit (and (eq (fka1-trial-score95? a) 1)
                    (eq (fka1-trial-score95? b) 1)) 4)
                (fka1b-bit (and (not (str_eq
                    (fkp30-trial-output-sha a) (fkp30-trial-output-sha b)))
                    (not (str_eq (fkp30-trial-family-nonce a)
                                 (fkp30-trial-family-nonce b)))) 8)
                (fka1b-bit (eq (fkg15-row-valid?
                    (fka1b-generative-row-for (fka1b-run))) 1) 16)
                (fka1b-bit (eq (fkpfm-generative-valid? (nth inputs 1)) 1) 32)
                (fka1b-bit (eq (fkfne-check-valid?
                    (fka1b-native-for (fka1b-run))) 1) 64)
                (fka1b-bit (eq (fkpfm-execution-valid? (nth inputs 2)) 1) 128)
                (fka1b-bit (eq (fka1-crossing-valid? crossing) 1) 256)
                (fka1b-bit (and (eq (len inputs) 3)
                    (eq (fka1-heldout-input-valid? (head inputs)) 1)) 512)
                (fka1b-bit (and (nothing?
                    (fka1-heldout-canonical-evidence held))
                    (eq (fka1-canonical-finalizer-ready? crossing) 0)) 1024)
                (fka1b-bit (and (eq (fka1-heldout-input-valid?
                    duplicate-held) 0)
                    (eq (fka1-heldout-input-valid? swapped-held) 0)) 2048)
                (fka1b-bit (eq (fka1-heldout-input-valid? false-held) 0) 4096)
                (fka1b-bit (eq (fka1-crossing-valid?
                    replayed-gen-crossing) 0) 8192)
                (fka1b-bit (and (eq (fka1-diag-summary-valid? bad-diag) 0)
                    (eq (fka1-diag-summary-valid? private-diag) 0)) 16384)
                (fka1b-bit (and (eq (bfc-payload revise) 2)
                    (str_eq (fka1-diag-next out revise
                        "generative-attempt" "continue" "release")
                        "repair")) 32768)
                (fka1b-bit (and (eq (bfc-payload request-in) 4)
                    (str_eq (fka1-diag-next request-out request-in
                        "native-parse" "continue" "release")
                        "request-evidence")) 65536)
                (fka1b-bit (str_eq (fka1-diag-next out stale
                    "generative-attempt" "continue" "release") "release")
                    131072)
                (fka1b-bit (and (eq (fka1-local-complete? crossing) 1)
                    (eq (nth crossing 17) 1)) 262144)
                (fka1b-bit (and (str_eq (fka1-family) "axioms")
                    (ge (str_find (fka1-heldout-seam) "current-census" 0) 0))
                    524288)
                (fka1b-bit (and
                    (eq (fka1-heldout-input-valid? 7) 0)
                    (and (eq (fka1-heldout-input-valid? (list "short")) 0)
                    (and (eq (fka1-crossing-valid? 7) 0)
                         (eq (fka1-crossing-valid? (list "short")) 0))))
                    1048576)
                (fka1b-bit (and (eq (fka1-residence-witness-valid?
                    (fka1b-residence)) 1)
                    (and (eq (nth (fka1b-residence) 7) 0)
                         (ge (str_find (nth (fka1b-residence) 8)
                             "not cryptographically" 0) 0))) 2097152)
                (fka1b-bit (and (eq (fka1-census-snapshot-valid?
                    (fka1-census-snapshot)) 1)
                    (eq (nth (fka1-census-snapshot) 2)
                        (len (fkpfm-family-ids)))) 4194304)
                (fka1b-bit (and (eq (fka1-residence-witness-valid?
                    (list "short")) 0)
                    (and (eq (fka1-residence-witness-valid? 7) 0)
                    (and (eq (fka1-census-snapshot-valid?
                        (list "short")) 0)
                    (and (eq (fka1-census-snapshot-valid? 7) 0)
                    (and (eq (fka1-residence-witness-valid?
                        (fka1-residence-witness (fka1b-model) (fka1b-run)
                            (list
                                (fka1-residence-transition "heldout-a" 1 1 1)
                                (fka1-residence-transition "heldout-b" 1 1 1)
                                (fka1-residence-transition "native-request" 1 1 1)
                                (fka1-residence-transition "generative-attempt" 1 1 1))
                            1 0 1)) 0)
                         (eq (fka1-census-snapshot-valid?
                            (list "axioms-post-crossing-census-v1"
                                (fkpfm-family-ids) (len (fkpfm-family-ids))
                                (fka1-census-source)
                                (fka1-census-source-freshness)
                                (nmfe-sha256 "wrong-digest"))) 0))))))
                    8388608)
                (fka1b-bit (do
                    (let packet (fkap-source-bound-hook "states" 0))
                    (and (eq (fkap-packet-valid? packet) 1)
                    (and (str_eq (nth packet 14) "states")
                    (and (str_eq (nth packet 15) "direct")
                    (and (str_eq (nth packet 16) "public-source-derived")
                         (and (eq (nth packet 17) 0)
                              (eq (nth packet 18) 0))))))) 16777216)
                (fka1b-bit (and
                    (eq (fka1-heldout-input-observed? miss-held) 1)
                    (and (eq (fka1-heldout-input-valid? miss-held) 0)
                         (eq (fka1-trial-score95? miss-a) 0))) 33554432)
                (fka1b-bit (and
                    (str_eq (fka1-heldout-learning-route
                        "heldout-a" 1 1) "heldout-b+curriculum")
                    (and (str_eq (fka1-heldout-learning-route
                        "heldout-b" 1 1) "curriculum")
                    (and (str_eq (fka1-heldout-learning-route
                        "heldout-a" 2 1) "heldout-b+curriculum")
                    (and (str_eq (fka1-heldout-learning-route
                        "heldout-b" 3 1) "curriculum")
                    (and (str_eq (fka1-heldout-learning-route
                        "heldout-b" 3 0) "release")
                         (str_eq (fka1-heldout-learning-route
                            "heldout-b" 4 1) "release"))))))
                    67108864)))))

    (form-knowledge-axioms-one-family-crossing-band))
