; manifest-words-band.bml — a gap's manifest line names each definition, by comma or by space (native-turn-manifest.bml, ntl-manifest-of).
;
; The queue holds both spellings ("Definition manifest: a, b" and "Definition manifest: a b"). ntl-manifest-of cuts at commas alone,
; so a space-parted line reads one name that no definition holds, and every rung-0 candidate of that gap reads outside its manifest.
;
; Expected: 31
; Verdict 31 when every claim lands:
;   1   a comma line reads each name
;   2   a space line reads each name
;   4   commas and spaces mixed, doubled or trailing read each name once, with no empty name
;   8   a goal with no manifest line reads [], and only the manifest's own line is read
;   16  a green candidate moving the second space-parted name is not refused as outside the manifest
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/native-turn-ladder.bml
section [form.bml] {
 class ManifestWordsBand {
  def mwb-is?(goal, want) = (String) ntl-manifest-of(goal).str() == want.str();
  def mwb-c-comma(ctx) = mwb-is?("g\nDefinition manifest: a-1, b?", ["a-1", "b?"]);
  def mwb-c-space(ctx) = mwb-is?("g\nDefinition manifest: a-1 b?", ["a-1", "b?"]) && mwb-is?("g\nDefinition manifest: one", ["one"]);
  def mwb-c-mixed(ctx) = mwb-is?("g\nDefinition manifest: a, b  c ,d, ", ["a", "b", "c", "d"]);
  def mwb-c-line(ctx) = mwb-is?("g with no line", []) && mwb-is?("g\nDefinition manifest: a b\nGuide: c d", ["a", "b"]);
  def mwb-src(body) = "section [form.bml] {\n class C {\n  def one(x) = x;\n  def two(x) = " + body + ";\n }\n 0;\n}\n";
  def mwb-c-green(ctx) {
   let m = ntl-manifest-of("g\nDefinition manifest: one two");
   (String) value_kind(m) == "list" && (String) ntl-outside-why(m, mwb-src("x"), mwb-src("[x]")) == "";
  }
 }
 live-claims("manifest-words-band", 0, [["comma", 1, 1, mwb-c-comma], ["space", 2, 1, mwb-c-space], ["mixed", 4, 1, mwb-c-mixed], ["line", 8, 1, mwb-c-line], ["green", 16, 1, mwb-c-green]]);
}
