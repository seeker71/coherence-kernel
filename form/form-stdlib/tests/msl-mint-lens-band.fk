; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/tensor-ir.fk form-stdlib/jit-tensor-emit.fk form-stdlib/msl-mint-lens.bml
; Expected: 31
; PROOF LEVEL: FKWU-STAGED — metal_pipeline and metal_status are carrier natives (fkwu only).
;
; msl-mint-lens-band — the lens, not the roster. Whether every family mints is the GATE's question
; (msl-families-mint-band.fk); this band asks whether the LENS that reads the compiler tells the truth
; about what it heard, in the three states and no others.
;
; Form native does not refuse; it heals and integrates, or it releases (Urs, 2026-09-09; corpus row 1415
; heldno). A compiler answering `did you mean 'metal::mem_flags'?` has refused nothing — it handed over
; the missing word, and the lens's work is to carry that word beside the wound rather than print a no.
; Where the compiler names nothing, the honest state is released, not refused.
;
; This band was once a second census of every family, and so was a sibling's probe: two organs and a
; gate asking one question. At the 2026-09-10 reunion the census went to the gate, the probe folded
; into observe/msl-mint-run.fk, and this band kept only what no other organ proves.
;
; Verdict 31:
;   1   a family the compiler takes reads WHOLE
;   2   a bare `mem_flags::` barrier reads UNHEALED, with a non-positive handle — never a plausible one
;   4   and its healing is the compiler's own word, `metal::mem_flags`, lifted out of its sentence
;   8   a source the compiler names no repair for reads RELEASED, with no healing invented for it
;   16  every row lands in exactly one of the three states
(do
    (let whole (mm-try "matvec f32" (jte-matvec-msl-fmt "ml_whole" "f32") "ml_whole"))
    (let bare (mm-try "bare barrier" "kernel void ml_bare(device float* y [[buffer(0)]], uint g [[thread_position_in_grid]]) { threadgroup_barrier(mem_flags::mem_device); y[g] = 1.0f; }" "ml_bare"))
    (let lost (mm-try "no repair" "kernel void ml_lost(device float* y [[buffer(0)]], uint g [[thread_position_in_grid]]) { y[g] = ; }" "ml_lost"))
    (let rows (list whole bare lost))
    (let c0 (if (str_eq (mm-state whole) "whole") 1 0))
    (let c1 (if (and (str_eq (mm-state bare) "unhealed") (le (nth bare 1) 0)) 2 0))
    (let c2 (if (str_eq (nth bare 3) "metal::mem_flags") 4 0))
    (let c3 (if (and (str_eq (mm-state lost) "released") (eq (str_len (nth lost 3)) 0)) 8 0))
    (let c4 (if (eq (add (mm-whole rows) (add (mm-unhealed rows) (mm-released rows))) (len rows)) 16 0))
    (add c0 (add c1 (add c2 (add c3 c4)))))
