; living-world-composite-nursery-witness.fk -- generated behavior is re-offered,
; never promoted.  Two already-consented histories are joined only inside this
; witness; their exact attributions, revocations, and boundary events remain.
; witnessed: 2026-08-08 -> composite-to-nursery re-offer band 32767 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk form-stdlib/living-world-operation-field.fk form-stdlib/living-world-composite-recipe.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-active-index.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-structural-recipe-witness.fk form-stdlib/tests/living-world-operation-field-witness.fk form-stdlib/tests/living-world-composite-recipe-witness.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk

(let LWOCNW-CORE          (bp "LWOCNW-CORE"))
(let LWOCNW-LINEAGE       (bp "LWOCNW-LINEAGE"))
(let LWOCNW-SELECTION     (bp "LWOCNW-SELECTION"))
(let LWOCNW-SOURCE-A      (bp "LWOCNW-SOURCE-A"))
(let LWOCNW-SOURCE-B      (bp "LWOCNW-SOURCE-B"))
(let LWOCNW-PROV-A        (bp "LWOCNW-PROV-A"))
(let LWOCNW-PROV-B        (bp "LWOCNW-PROV-B"))
(let LWOCNW-ACTION        (bp "LWOCNW-ACTION"))
(let LWOCNW-DIRECTION     (bp "LWOCNW-DIRECTION"))
(let LWOCNW-SCOPE         (bp "LWOCNW-SCOPE"))
(let LWOCNW-FIRST-SOURCE  (bp "LWOCNW-FIRST-SOURCE"))
(let LWOCNW-SECOND-SOURCE (bp "LWOCNW-SECOND-SOURCE"))
(let LWOCNW-EVIDENCE      (bp "LWOCNW-EVIDENCE"))
(let LWOCNW-ALTERNATIVE   (bp "LWOCNW-ALTERNATIVE"))
(let LWOCNW-REASON        (bp "LWOCNW-REASON"))

(defn lwocnw-cell (kind) (intern_node kind (empty)))
(defn lwocnw-source-a () (lwocnw-cell LWOCNW-SOURCE-A))
(defn lwocnw-source-b () (lwocnw-cell LWOCNW-SOURCE-B))
(defn lwocnw-prov-a () (lwocnw-cell LWOCNW-PROV-A))
(defn lwocnw-prov-b () (lwocnw-cell LWOCNW-PROV-B))
(defn lwocnw-action () (lwocnw-cell LWOCNW-ACTION))
(defn lwocnw-direction () (lwocnw-cell LWOCNW-DIRECTION))
(defn lwocnw-scope () (lwocnw-cell LWOCNW-SCOPE))
(defn lwocnw-first-source () (lwocnw-cell LWOCNW-FIRST-SOURCE))
(defn lwocnw-second-source () (lwocnw-cell LWOCNW-SECOND-SOURCE))
(defn lwocnw-evidence () (lwocnw-cell LWOCNW-EVIDENCE))
(defn lwocnw-alternative () (lwocnw-cell LWOCNW-ALTERNATIVE))
(defn lwocnw-reason () (lwocnw-cell LWOCNW-REASON))

; Preserve both journal orders when independently consented worlds meet.
(defn lwocnw-unique-append (items acc)
    (if (eq (len items) 0) acc
        (lwocnw-unique-append (tail items)
            (if (eq (lwo-member? acc (head items)) 1) acc
                (append acc (list (head items)))))))
(defn lwocnw-merge-field (left right)
    (lwo-field
        (lwocnw-unique-append (lwo-field-items right)
            (lwo-field-items left))))
(defn lwocnw-merge-world (left right)
    (lwo-world
        (lwocnw-merge-field
            (lwo-world-cells left) (lwo-world-cells right))
        (lwocnw-merge-field
            (lwo-world-relations left) (lwo-world-relations right))
        (lwocnw-merge-field
            (lwo-world-attributions left) (lwo-world-attributions right))
        (lwocnw-merge-field
            (lwo-world-revocations left) (lwo-world-revocations right))
        (lwocnw-merge-field
            (lwo-world-events left) (lwo-world-events right))))

; children: merged world, composite candidate, blueprint, first and second
; compatible profiles, transformation target and its prior round, schema.
(defn lwocnw-core
    (world composite blueprint first second target target-round schema)
    (intern_node LWOCNW-CORE
        (list world composite blueprint first second target target-round schema)))
(defn lwocnw-core-world (core) (nth (node_children core) 0))
(defn lwocnw-core-composite (core) (nth (node_children core) 1))
(defn lwocnw-core-blueprint (core) (nth (node_children core) 2))
(defn lwocnw-core-first (core) (nth (node_children core) 3))
(defn lwocnw-core-second (core) (nth (node_children core) 4))
(defn lwocnw-core-target (core) (nth (node_children core) 5))
(defn lwocnw-core-target-round (core) (nth (node_children core) 6))
(defn lwocnw-core-schema (core) (nth (node_children core) 7))

(defn lwocnw-build-core ()
    (do
        (let evolved (lwoew-build-evolved))
        (let schema (lwoew-base-schema (lwoew-evolved-base evolved)))
        (let component (lwoew-evolved-candidate evolved))
        (let blueprint (lwoecw-blueprint component schema))
        (let blueprint-world (lwoecw-blueprint-world evolved))
        (let proposal (lwoec-proposal blueprint-world blueprint 2))
        (let composite (lwt-proposal-candidate proposal))
        (let integrated
            (lwoec-integrate
                (lwphw-answered-round blueprint-world proposal
                    (lwoew-evolved-round evolved))
                proposal (lwphw-action)))
        (let field (lwo-emergent-shape composite))
        (let profiles (lwo-field-items (lwoec-field-compatible field)))
        (let target-fixture (lwtnw-build-target))
        (let world
            (lwocnw-merge-world (lwt-round-world integrated)
                (lwtnw-target-world target-fixture)))
        (lwocnw-core world composite blueprint
            (nth profiles 0) (nth profiles 1)
            (lwtnw-target target-fixture)
            (lwtnw-target-round target-fixture) schema)))

; The caller, not this witness or the composite field, names an exact profile.
(defn lwocnw-recipe (profile)
    (lwoec-surface-recipe (lwoec-profile-surface profile)))
(defn lwocnw-other-recipe (core profile)
    (if (node_eq profile (lwocnw-core-first core))
        (lwocnw-recipe (lwocnw-core-second core))
        (lwocnw-recipe (lwocnw-core-first core))))
(defn lwocnw-carrier (profile)
    (lwoe-profile-carrier
        (lwoec-surface-component-profile
            (lwoec-profile-surface profile))))

; The offered values are scoped tissue. Alternatives and unknowability may
; accompany one projection without becoming its numeric view.
(defn lwocnw-first-projection ()
    (lwre-projection (lwocnw-scope) (lwocnw-first-source)
        (intern_trivial_int 2) (lwo-empty-field) (lwo-none)
        (lwocnw-evidence)))
(defn lwocnw-second-projection ()
    (lwre-projection (lwocnw-scope) (lwocnw-second-source)
        (intern_trivial_int 1)
        (lwo-field (list (lwocnw-alternative)))
        (lwlc-unknown (lwocnw-evidence)) (lwocnw-evidence)))
(defn lwocnw-first-value (core)
    (lwsr-value (lwoew-first-role (lwocnw-core-schema core))
        (lwocnw-first-projection) (lwo-empty-field) (lwo-none)
        (lwocnw-evidence)))
(defn lwocnw-second-value (core)
    (lwsr-value (lwoew-second-role (lwocnw-core-schema core))
        (lwocnw-second-projection)
        (lwo-field (list (lwocnw-alternative)))
        (lwlc-unknown (lwocnw-evidence)) (lwocnw-evidence)))
(defn lwocnw-values (core)
    (lwo-field
        (list (lwocnw-first-value core) (lwocnw-second-value core))))
(defn lwocnw-bindings (core profile)
    (lwoe-bindings-for (lwocnw-carrier profile)
        (lwoec-blueprint-codecs (lwocnw-core-blueprint core))
        (lwocnw-values core)))

; Lineage names the exact integrated field, sender-selected profile, and values.
(defn lwocnw-lineage (core profile)
    (intern_node LWOCNW-LINEAGE
        (list (lwocnw-core-composite core) profile (lwocnw-values core)
              (lwo-local-path))))
(defn lwocnw-lineage-composite (lineage) (nth (node_children lineage) 0))
(defn lwocnw-lineage-profile (lineage) (nth (node_children lineage) 1))
(defn lwocnw-lineage-values (lineage) (nth (node_children lineage) 2))

(defn lwocnw-lens (core profile)
    (lwlc-lens (lwlc-recipe-shape) (lwocnw-recipe profile)
        (lwocnw-lineage core profile)))
(defn lwocnw-declaration (core profile)
    (do
        (let lens (lwocnw-lens core profile))
        (lwlc-declaration (lwocnw-direction)
            (lwlc-stack lens (lwlc-layers (list))
                (lwo-empty-field) (lwo-none)
                (lwocnw-lineage core profile))
            (lwocnw-lineage core profile))))
(defn lwocnw-choice (core profile)
    (lwlc-choice (lwo-none)
        (lwoec-field-alternatives
            (lwo-emergent-shape (lwocnw-core-composite core)))
        (lwlc-unknown (lwocnw-lineage core profile))
        (lwocnw-lineage core profile)))
(defn lwocnw-timeout (core profile)
    (oac-timeout (intern_trivial_int 10)
        (oac-alternative-ack (lwocnw-recipe profile)
            (lwocnw-other-recipe core profile)
            (lwocnw-lineage core profile))
        (lwocnw-lineage core profile)))

(defn lwocnw-before (core)
    (lwrx-overall-before
        (lwrx-transformation-overall
            (lwo-emergent-shape (lwocnw-core-target core)))))
(defn lwocnw-rich-offer (core profile)
    (lwtn-bound-offer (lwocnw-core-target core)
        (lwocnw-recipe profile) (lwocnw-declaration core profile)
        (lwocnw-lens core profile) (lwocnw-before core)
        (lwoec-field-alternatives
            (lwo-emergent-shape (lwocnw-core-composite core)))
        (lwlc-unknown (lwocnw-lineage core profile))
        (lwocnw-choice core profile) (lwocnw-timeout core profile)
        (lwocnw-lineage core profile) (lwocnw-bindings core profile)))
(defn lwocnw-minimal-offer (core profile)
    (lwtn-bound-offer (lwocnw-core-target core)
        (lwocnw-recipe profile) (lwocnw-declaration core profile)
        (lwocnw-lens core profile) (lwocnw-before core)
        (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none)
        (lwocnw-lineage core profile) (lwocnw-bindings core profile)))

(defn lwocnw-common-payloads (core profile)
    (do
        (let bindings (lwocnw-bindings core profile))
        (append
            (list
                (lwocnw-recipe profile)
                (lwocnw-lens core profile)
                (lwocnw-declaration core profile)
                (lwocnw-lineage core profile)
                (lwocnw-scope)
                (lwocnw-first-source)
                (lwocnw-second-source)
                (lwocnw-first-projection)
                (lwocnw-second-projection)
                (lwocnw-first-value core)
                (lwocnw-second-value core))
            (lwre-binding-items bindings))))
(defn lwocnw-rich-payloads (core profile)
    (append (lwocnw-common-payloads core profile)
        (list (lwocnw-rich-offer core profile))))
(defn lwocnw-minimal-payloads (core profile)
    (append (lwocnw-common-payloads core profile)
        (list (lwocnw-minimal-offer core profile))))

(defn lwocnw-entry (source provenance payload)
    (lwt-entry
        (lwo-offer source (lwo-interface (list (lwocnw-action)))
            1 payload provenance 1)
        (lwocnw-action)))
(defn lwocnw-entries (source provenance items)
    (if (eq (len items) 0) (list)
        (cons (lwocnw-entry source provenance (head items))
            (lwocnw-entries source provenance (tail items)))))
(defn lwocnw-add-a (world payloads)
    (lwt-receive-stream world
        (lwocnw-entries (lwocnw-source-a) (lwocnw-prov-a) payloads)))
(defn lwocnw-add-b (world payloads)
    (lwt-receive-stream world
        (lwocnw-entries (lwocnw-source-b) (lwocnw-prov-b) payloads)))

(defn lwocnw-one-rich-world (core profile)
    (lwocnw-add-a (lwocnw-core-world core)
        (lwocnw-rich-payloads core profile)))
(defn lwocnw-two-rich-world (core profile)
    (lwocnw-add-b (lwocnw-one-rich-world core profile)
        (lwocnw-rich-payloads core profile)))
(defn lwocnw-two-minimal-world (core profile)
    (lwocnw-add-b
        (lwocnw-add-a (lwocnw-core-world core)
            (lwocnw-minimal-payloads core profile))
        (lwocnw-minimal-payloads core profile)))
(defn lwocnw-optionality-ambiguous-world (core profile)
    (do
        (let both
            (append (lwocnw-rich-payloads core profile)
                (lwocnw-minimal-payloads core profile)))
        (lwocnw-add-b (lwocnw-add-a (lwocnw-core-world core) both) both)))
(defn lwocnw-profile-ambiguous-world (core)
    (do
        (let both
            (append (lwocnw-rich-payloads core (lwocnw-core-first core))
                (lwocnw-rich-payloads core (lwocnw-core-second core))))
        (lwocnw-add-b (lwocnw-add-a (lwocnw-core-world core) both) both)))

(defn lwocnw-revoke (world source provenance recipe)
    (lwt-receive-stream world
        (list
            (lwocnw-entry source provenance
                (lwo-revocation recipe source
                    (lwocnw-reason) provenance)))))
(defn lwocnw-revoked-one-world (core profile)
    (lwocnw-revoke (lwocnw-two-rich-world core profile)
        (lwocnw-source-a) (lwocnw-prov-a) (lwocnw-recipe profile)))
(defn lwocnw-revoked-all-world (core profile)
    (lwocnw-revoke (lwocnw-revoked-one-world core profile)
        (lwocnw-source-b) (lwocnw-prov-b) (lwocnw-recipe profile)))

(defn lwocnw-all-indexed? (index items)
    (if (eq (len items) 0) 1
        (if (eq (lwai-active? index (head items)) 1)
            (lwocnw-all-indexed? index (tail items)) 0)))
(defn lwocnw-materials-indexed? (world core profile)
    (lwocnw-all-indexed? (lwai-index world)
        (lwocnw-common-payloads core profile)))

(defn lwocnw-response (source provenance proposal)
    (lwocnw-entry source provenance
        (lwt-response proposal (oac-one proposal) provenance)))
(defn lwocnw-selection-responses (proposal)
    (list
        (lwocnw-response
            (lwocnw-source-a) (lwocnw-prov-a) proposal)
        (lwocnw-response
            (lwocnw-source-b) (lwocnw-prov-b) proposal)
        (lwocnw-response
            (lwigw-source-p) (lwigw-prov-p) proposal)
        (lwocnw-response
            (lwigw-source-q) (lwigw-prov-q) proposal)
        (lwocnw-response
            (lwigw-source-r) (lwigw-prov-r) proposal)
        (lwocnw-response
            (lwigw-source-s) (lwigw-prov-s) proposal)
        (lwocnw-response
            (lwigw-source-t) (lwigw-prov-t) proposal)
        (lwocnw-response
            (lwigw-source-u) (lwigw-prov-u) proposal)))

; children: integrated round, exact selection candidate and proposal.
(defn lwocnw-selection (round candidate proposal)
    (intern_node LWOCNW-SELECTION (list round candidate proposal)))
(defn lwocnw-selection-round (selection) (nth (node_children selection) 0))
(defn lwocnw-selection-candidate (selection)
    (nth (node_children selection) 1))
(defn lwocnw-selection-proposal (selection)
    (nth (node_children selection) 2))
(defn lwocnw-integrate-selection (core profile)
    (do
        (let world (lwocnw-two-rich-world core profile))
        (let proposal
            (lwtn-selection-proposal world (lwocnw-core-target core) 2))
        (let round
            (lwt-round world (lwo-field (list proposal))
                (lwo-empty-field) (lwocnw-core-target-round core)))
        (let answered
            (lwt-round-receive round
                (lwocnw-selection-responses proposal)))
        (let integrated
            (lwtn-selection-integrate answered proposal (lwocnw-action)))
        (lwocnw-selection integrated
            (lwt-proposal-candidate proposal) proposal)))
