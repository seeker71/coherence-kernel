; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk
;
; emitted-table-capacity-band — source proof for the bounded table-image seam.
; It inspects the source-authored emitted entry texts only; the companion
; form_cli_table_capacity_diagnostic.sh performs the disposable compiled-C
; canary, overflow, and truncation observations without publishing artifacts.
;
; `fkc-table-serialize.fk` now imports form-table-text.fk: direct fkwu source
; evaluates the same canonical table text through that Form binding, while the
; emitted walker keeps tag 207 as its native fast path.  This band calls the
; binding directly; it does not install a local stub or claim that inspecting
; emitted source alone exercises the compiled carrier.
;
; Verdict 63 when every runtime table entry is explicit:
;   1 capacity/limit and the direct-source table serializer are the named contract
;   2 shared loader is bounded and detects EOF while scanning
;   4 universal and REPL file entry use the shared loader/parser
;   8 server entry uses the shared loader/parser
;  16 uwire entry uses the shared loader/parser
;  32 baked entry has the same bounded copy and shared parser
(do
    (let loader (fkc-table-loader-text))
    (let parser (fkc-main-parse-text))
    (let file-main (fkc-main-load-text))
    (let server-main (fkc-main-server-universal-text))
    (let uwire-main (fkc-main-uwire-text))
    (let baked-main (fkc-main-baked-repl-text ""))

    (let c0 (if (and (eq (fkc-table-image-buffer-capacity) 16777216)
                     (and (eq (fkc-table-image-buffer-limit) 16777215)
                          (str_eq
                              (form_table_text
                                  (list 8 3)
                                  (list (list 4 5 6 7) (list 1 2 3 4)))
                              "2 3 8 2 1 2 3 4 4 5 6 7"))) 1 0))
    (let c1 (if (and (ge (str_find loader "static char fk_buf[16777216]" 0) 0)
                     (and (ge (str_find loader "fk_table_load" 0) 0)
                          (ge (str_find loader "fk_parse_bad" 0) 0))) 2 0))
    (let c2 (if (and (ge (str_find file-main "fk_table_load(fd)" 0) 0)
                     (ge (str_find parser "malformed or truncated form table" 0) 0)) 4 0))
    (let c3 (if (and (ge (str_find server-main "fk_table_load(fd)" 0) 0)
                     (ge (str_find server-main "malformed or truncated form table" 0) 0)) 8 0))
    (let c4 (if (and (ge (str_find uwire-main "fk_table_load(fd)" 0) 0)
                     (ge (str_find uwire-main "malformed or truncated form table" 0) 0)) 16 0))
    (let c5 (if (and (ge (str_find baked-main "baked form table exceeds emitted buffer capacity" 0) 0)
                     (and (ge (str_find baked-main "fk_buf_len = ci" 0) 0)
                          (ge (str_find baked-main "malformed or truncated form table" 0) 0))) 32 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
