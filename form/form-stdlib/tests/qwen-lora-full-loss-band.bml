// Full-vocabulary CE and quantized transpose against independent CPU arithmetic.
// Includes a partial final row chunk. No model, corpus or checkpoint is modified.
// preludes: form-stdlib/bml/qwen-lora-full-loss.bml form-stdlib/lora-step-live.bml
section [form.bml] {
 class QwenFullLossBand {
  def qfgb-assert(name,ok) = if ok then 1 else form_error(str_concat("Qwen full loss: ",name));
  def qfgb-q(i) = ((((i * 7) + ((i / 32) * 3)) % 15) - 7);
  def qfgb-scale(i) = (0.25 + (0.125 * (((i / 32) % 3) + 0.0)));
  def qfgb-values(n,i,out) = if (i >= n) then reverse(out) else qfgb-values(n,(i + 1),cons((qfgb-scale(i) * qfgb-q(i)),out));
  def qfgb-block(i,left,out) = if (left <= 0) then out else qfgb-block((i + 1),(left - 1),str_concat(out,byte_to_str(((qfgb-q(i) + 256) % 256))));
  def qfgb-packed(n,i,out) = if (i >= n) then out else {
   let bits = (13312 + (((i / 32) % 3) * 512));
   let scale = str_concat(byte_to_str((bits % 256)),byte_to_str((bits / 256)));
   qfgb-packed(n,(i + 32),str_concat(out,str_concat(scale,qfgb-block(i,32,""))));
  };
  def qfgb-hidden(n,i,out) = if (i >= n) then reverse(out) else qfgb-hidden(n,(i + 1),cons((((((i * 13) % 17) - 8) + 0.0) / 128.0),out));
  def qfgb-run(rows,cols,target) {
   let weights = qfgb-values((rows * cols),0,list());
   let hidden = qfgb-hidden(cols,0,list());
   let logits = lbw-mv(weights,rows,cols,hidden);
   let reference = lbw-tmv(weights,rows,cols,lbw-dce(logits,target));
   let owner = qlfg-open(rows,cols);
   let wh = metal_buf_alloc(q80-bytes((rows * cols)));
   let zh = metal_buf_alloc((rows * 4));
   let wroteWeights = metal_buf_write(wh,0,qfgb-packed((rows * cols),0,""));
   let wroteLogits = metal_buf_write(zh,0,lsl-bytes(logits));
   let observed = qlfg-gradient(owner,wh,zh,target);
   let targetRefused = nothing?(qlfg-loss(owner,zh,rows));
   let before = lbw-ce(logits,target);
   let lossError = if head(observed) then tn-abs((nth(observed,1) - before)) else 1.0;
   let gradientError = if head(observed) then lbw-reldiff(reference,nth(observed,2)) else 1.0;
   let badWrite = metal_buf_write(zh,0,md-le32(2139095040));
   let nonfiniteRefused = nothing?(qlfg-loss(owner,zh,target));
   let expected = (qlfg-owned(owner) + 2);
   let closed = (qlfg-close(owner) + q38-free-handles(list(wh,zh)));
   print(list("qwen-full-loss",rows,cols,"loss-error",lossError,"gradient-relative-error",gradientError,"owned",expected,"closed",closed));
   qfgb-assert("complete fixture writes",(((Comparable) wroteWeights == q80-bytes((rows * cols))) && ((Comparable) wroteLogits == (rows * 4))));
   qfgb-assert("whole vocabulary loss",(lossError < 0.00001));
   qfgb-assert("Q8 transpose matches CPU derivative",(gradientError < 0.00001));
   qfgb-assert("invalid target and nonfinite loss refused",(targetRefused && nonfiniteRefused));
   qfgb-assert("all scratch and fixture buffers released",(((Comparable) expected == 8) && ((Comparable) closed == expected)));
   1;
  }
 }
 qfgb-assert("geometry rejects fractional and non-block widths",((!qlfg-geometry(3.5,32)) && (!qlfg-geometry(3,31))));
 qfgb-assert("geometry rejects zero and overflowing flat index",((!qlfg-geometry(0,32)) && (!qlfg-geometry(134217728,32))));
 qfgb-assert("geometry multiplication cannot wrap into admission",(!qlfg-geometry(4294967296,4294967296)));
 qfgb-assert("packed byte offset also fits uint",(!qlfg-geometry(126322568,32)));
 qfgb-assert("invalid owner holds no buffers",(nil?(qlfg-open(0,32)) && ((Comparable) qlfg-close(list()) == 0)));
 qfgb-run(37,64,36);
 qfgb-run(1025,32,1024);
 1;
}
