; Witness the Form CLI native membrane's content identity, framebuffer offer,
; and open inquiry interface without invoking a model generation session.
;
; preludes: form-stdlib/form-cli-dsv4-local.fk

(do
    (let crossing (fdl-crossing
        "20,21"
        "native generated token ids"
        "in-process model organ to Form CLI body"
        "after native output selection"
        "form-cli native DS4 route"
        "native token values returned as a Form list"
        "selected full-vocabulary ids"
        "the rendered response needs replayable numeric ground"
        "native output head and GGUF vocabulary"
        "retain ids and allow another present-ground re-witness"
        17 "success"))
    (let offered (camf-offer crossing
        "form-stdlib/tests/form-cli-native-membrane-inquiry-band.fk"
        10 1 (intern_trivial_int 0)))
    (let answers (fdl-inquire-basic offered 20))
    (print_str (str_concat "crossing-id=" (cam-id crossing)))
    (print_str (str_concat "live=" (int_to_str (camf-live? offered))))
    (print_str answers)
    (if (if (eq (cam-witnessed? crossing) 1)
            (if (eq (camf-live? offered) 1)
                (if (ge (str_find answers "what.ack=node" 0) 0)
                    (if (ge (str_find answers "freedom.ack=node" 0) 0)
                        1 0)
                    0)
                0)
            0)
        0
        1))
