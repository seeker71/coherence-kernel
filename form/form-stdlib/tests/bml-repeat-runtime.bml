// Runtime observation for compiler-produced repeat receivers.
// preludes: form-stdlib/bml/native-events-darwin.bml
// preflight-exec: forbidden
section [form.bml] {
 class BmlRepeatRuntimeWitness {
  def brw-check(name,got,want) { print(list(name,got,want)); (Value) got == want ? 1 : form_error(name); }
  def brw-release(owner,watch) = oac-one?(nve-hear(owner,watch,oh-response(nve-care-reading(watch),"release-event"),list()));
  def brw-repeat(watch) = record_get(watch,"repeat");
  def brw-timer(context,event) { record_set(context,"wake",1); nothing(); }
  def brw-observe(offered) {
   let args = oac-option-args(offered); let watch = nve-event-watch(args[2]);
   record_set(args[1],"interruption",oh-get(nve-care-reading(watch),"observed"));
   oac-node(intern_trivial_string("compiled repeat retained its interrupted checkpoint"));
  }
  def brw-repair(offered) {
   let args = oac-option-args(offered); let context = args[1]; let state = brw-repeat(nve-event-watch(args[2]));
   record_set(context,"findings",len(oac-option-memory(offered)));
   // This method's only mutable local is its remaining need. Care observes
   // that the need has been served and offers that changed input, keeping PC.
   nve-repeat-again(offered,list(head(record_get(state,"cursor")),0,0));
  }
  def brw-run(start,args,expected,budget,held) {
   let owner = nve-open(); let context = record_new(0,"findings",0);
   let a = start(owner,context,held ? list(brw-observe,brw-repair) : list(),args);
   let b = start(owner,record_new(0),list(),args);
   brw-check("registration has no completed effects",record_get(brw-repeat(a),"attempts"),0);
   brw-check("both peers enter",nve-run(owner,2),2);
   brw-check("compiler checkpoints are fair",list(record_get(brw-repeat(a),"attempts"),record_get(brw-repeat(b),"attempts")),list(1,1));
   brw-check("original context retained",(Value) record_get(brw-repeat(a),"context") == context,1);
   (Comparable) expected == 200010000 ? {
    let timer = nve-timer(owner,1); nve-bind(owner,timer,brw-timer,context); host_sleep_ms(2); nve-turn-slices(owner,1000,2);
    brw-check("resource event progresses during compiled work",list(record_get(context,"wake"),record_get(brw-repeat(a),"done")),list(1,0));
    nve-unwatch(owner,timer);
   } : 0;
   let before = record_get(owner,"calls");
   nve-run(owner,budget);
   brw-check("compiled answer",list(record_get(brw-repeat(a),"done"),record_get(brw-repeat(a),"value")),list(1,expected));
   held ? {
    brw-check("care reads the live interruption",json-string-value(record_get(context,"interruption")),"interrupted");
    brw-check("earlier care finding accompanies repair",record_get(context,"findings"),1);
    brw-check("unchanged peer rests without spin",list(record_get(brw-repeat(b),"done"),nve-run(owner,100)),list(0,0));
    brw-check("held peer releases",brw-release(owner,b),1);
   } : brw-check("independent peer answer",list(record_get(brw-repeat(b),"done"),record_get(brw-repeat(b),"value")),list(1,expected));
   let cancelled = start(owner,context,list(),args); brw-release(owner,cancelled);
   brw-check("cancelled source never executes",list(nve-run(owner,10),record_get(brw-repeat(cancelled),"attempts")),list(0,0));
   brw-check("repeat makes no event-image calls",record_get(owner,"calls") - before,0);
   brw-check("all work released",list(len(nve-pending(owner)),len(record_get(owner,"watches"))),list(0,0));
   brw-check("owner release",nve-close(owner),1); "@bfk int\t0\t1";
  }
 }
 0;
}
