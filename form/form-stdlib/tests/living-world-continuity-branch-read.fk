; Second process: load inertly, restore A while B abstains, then let B move to
; ONE independently.  Verdict 65535 proves sixteen fresh-process scope bits.
; witnessed: 2026-08-08 -> 65535 on a fresh direct-source fkwu process
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-continuity-branch.fk form-stdlib/tests/living-world-continuity-branch-witness.fk form-stdlib/tests/living-world-continuity-branch-durable-witness.fk

(do
    (let loaded (lwcd-load (lwcbwd-path) (lwo-none)))
    (let image (lwcd-result-image loaded))
    (let branch-a (lwcbwd-branch-a image))
    (let branch-b (lwcbwd-branch-b image))
    (let admission (lwcbwd-admission branch-a branch-b))
    (let proposal-a (lwcb-restore-proposal admission branch-a))
    (let proposal-b (lwcb-restore-proposal admission branch-b))
    (let candidate-a (lwt-proposal-candidate proposal-a))
    (let candidate-b (lwt-proposal-candidate proposal-b))
    (let response-world
        (lwt-receive-stream admission
            (list
                (lwcbw-response-entry
                    (lwcbw-source-a) (lwcbw-provenance-a)
                    proposal-a (oac-one proposal-a))
                (lwcbw-response-entry
                    (lwcbw-source-b) (lwcbw-provenance-b)
                    proposal-b (oac-nothing)))))
    (let outcome-a (lwt-evaluate-proposal response-world proposal-a))
    (let outcome-b (lwt-evaluate-proposal response-world proposal-b))
    (let after-a-round
        (lwcb-integrate-restore
            (lwcbwd-round response-world proposal-a proposal-b)
            proposal-a (lwcbw-action)))
    (let after-a (lwt-round-world after-a-round))
    (let revised-world
        (lwt-receive-stream after-a
            (list
                (lwcbw-response-entry
                    (lwcbw-source-b) (lwcbw-provenance-b)
                    proposal-b (oac-one proposal-b)))))
    (let revised-outcome
        (lwt-evaluate-proposal revised-world proposal-b))
    (let after-b-round
        (lwcb-integrate-restore
            (lwcbwd-round revised-world proposal-a proposal-b)
            proposal-b (lwcbw-action)))
    (let after-b (lwt-round-world after-b-round))
    (let score
        (lwcbw-sum
            (list
                (if (eq (lwcd-loaded? loaded) 1) 1 0)
                (if (eq (lwcn-image-valid? image) 1) 2 0)
                (if (and (eq (lwcb-branch-valid? branch-a) 1)
                         (eq (lwcb-branch-valid? branch-b) 1)) 4 0)
                (if (and (eq (lwo-active? (lwo-empty-world) image) 0)
                         (and (eq (lwo-active? admission
                                      (lwcbw-payload-a)) 0)
                              (eq (lwo-active? admission
                                      (lwcbw-payload-b)) 0))) 8 0)
                (if (and (eq (lwo-field-size
                                  (lwcb-branch-participants branch-a)) 1)
                         (eq (lwo-field-size
                                  (lwcb-branch-participants branch-b)) 1)) 16 0)
                (if (and (eq (node_eq proposal-a (lwo-none)) 0)
                         (and (eq (node_eq proposal-b (lwo-none)) 0)
                              (eq (node_eq candidate-a candidate-b) 0))) 32 0)
                (if (and (node_eq (lwt-outcome-status outcome-a)
                                  (lwt-status-acknowledged))
                         (and (eq (lwt-outcome-yes outcome-a) 1)
                              (and (node_eq (lwt-outcome-status outcome-b)
                                            (lwt-status-waiting))
                                   (eq (lwt-outcome-silence outcome-b) 1))))
                    64 0)
                (if (and (eq (lwo-active? after-a
                                  (lwcbw-payload-a)) 1)
                         (and (eq (lwo-active? after-a
                                      (lwcbw-payload-b)) 0)
                              (eq (lwcb-restored? after-a candidate-a) 1)))
                    128 0)
                (if (eq (lwcb-restore-current? after-a candidate-b) 1)
                    256 0)
                (if (and (eq (lwo-world-has? after-a
                                  (lwcbw-capability-a)) 0)
                         (and (eq (lwo-world-has? after-a
                                      (lwcbw-capability-b)) 0)
                              (and (eq (lwo-world-has? after-a
                                           (lwcbw-grant-a)) 0)
                                   (eq (lwo-world-has? after-a
                                           (lwcbw-grant-b)) 0)))) 512 0)
                (if (and (node_eq (lwt-outcome-status revised-outcome)
                                  (lwt-status-acknowledged))
                         (and (eq (lwt-outcome-yes revised-outcome) 1)
                              (eq (lwt-outcome-silence revised-outcome) 0)))
                    1024 0)
                (if (and (eq (lwo-active? after-b
                                  (lwcbw-payload-a)) 1)
                         (eq (lwo-active? after-b
                                  (lwcbw-payload-b)) 1)) 2048 0)
                (if (and (eq (lwcb-restored? after-b candidate-a) 1)
                         (eq (lwcb-restored? after-b candidate-b) 1)) 4096 0)
                (if (and (eq (lwo-active-by? after-b
                                  (lwcbw-payload-a) (lwcbw-source-a)) 1)
                         (eq (lwo-active-by? after-b
                                  (lwcbw-payload-b) (lwcbw-source-b)) 1))
                    8192 0)
                (if (and (node_eq (lwcb-branch-declaration branch-b)
                                  (lwcbw-declaration-b))
                         (and (node_eq (lwcb-branch-lens branch-b)
                                      (lwcbw-lens-b))
                              (and (eq (lwo-field-size
                                        (lwcb-branch-alternatives branch-b)) 1)
                                   (node_eq
                                    (lwcb-branch-unknowable branch-b)
                                    (lwcbw-unknown-b))))) 16384 0))))
    (lwcbwd-clean)
    (add score
        (if (and (eq (fs-exists? (lwcbwd-path)) 0)
                 (eq (fs-exists?
                        (lwcd-pending-path (lwcbwd-path))) 0)) 32768 0)))
