; nodeid-one-cell-band.fk -- the same four coordinates make the same cell: make_nodeid no longer mints a fresh one.
;
; A NodeID is identity by content: eq compares its four coordinates (nodeid-interning-band). Yet make_nodeid took a
; new node cell on every call, in the host field and in private tables alike, and the field keeps every cell until
; it is reset. A glass observer that asked for its metric category once a sample minted the same NodeID about ten
; thousand times a second, and the field's 2^26 node columns filled in hours. Now make_nodeid looks its coordinates up
; in the intern hash, as every other intern does, and a repeat answers the cell already there.
;
; Verdict 7
; PROOF LEVEL: FOURTH-ARM ONLY (a defn's mint count is the 9th field of fkwu's hot rows)
;
;   1   a defn making the same NodeID three thousand times mints at most one cell
;   2   distinct coordinates still make distinct NodeIDs, and each reads back its own instance
;   4   two makes of the same coordinates are eq, node_eq and value_eq, and read back all four coordinates
(do
    (defn noc-bit (ok bit) (if ok bit 0))
    (defn noc-row (name rows) (if (eq (len rows) 0) (list) (if (str_eq (nth (head rows) 1) name) (head rows) (noc-row name (tail rows)))))
    (defn noc-mints (name) (do (let row (noc-row name (kernel_page_hot (host_pid) 400))) (if (eq (len row) 0) -1 (nth row 8))))
    (defn noc-same (k) (make_nodeid 7 7 7 90210))
    (defn noc-drive (n acc) (if (lt (host_monotonic_ms) 0) 0 (if (le n 0) acc (noc-drive (sub n 1) (add acc (node_inst (noc-same n)))))))
    (let driven (noc-drive 3000 0))
    (let same-mints (noc-mints "noc-same"))
    (let one-ok (if (eq driven 270630000) (if (ge same-mints 0) (le same-mints 1) false) false))
    (let a (make_nodeid 7 7 8 1))
    (let b (make_nodeid 7 7 8 2))
    (let distinct-ok (if (eq (eq a b) 0) (if (eq (node_inst a) 1) (eq (node_inst b) 2) false) false))
    (let c (make_nodeid 3 4 5 6))
    (let d (make_nodeid 3 4 5 6))
    (let same-ok (if (eq (eq c d) 1) (if (eq (node_eq c d) 1) (if (eq (value_eq c d) 1) (if (eq (node_pkg c) 3) (if (eq (node_level c) 4) (if (eq (node_type c) 5) (eq (node_inst d) 6) false) false) false) false) false) false))
    (add (noc-bit one-ok 1) (add (noc-bit distinct-ok 2) (noc-bit same-ok 4))))
