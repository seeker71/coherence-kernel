; nodeid-interning-band.fk — a NodeID is identity-by-content: eq of two mints
; of the same four coordinates answers 1, whichever value node carried them;
; any differing coordinate answers 0; a nodeid never equals an int, a list,
; or nothing. value_eq agrees with eq on both sides.
;
; Witnessed into the kernel 2026-08-30 (the tag-102 heal): before it, equal
; coordinates compared by value-node handle and answered 0 — eq never asked
; fk_neq, which had carried the kind-3 coordinate law all along. The same
; heal lit the turnwheel band's held-out equivalence gate (4194303 ->
; 8388607, its own declared Expected) from a distance. fkwu carries
; make_nodeid and the one eq law, and witnesses this band.
;
; Bit 128: the 1.1.1 coordinate is the trivial int leaf, not a second node carrying the same value.
; Verdict 255
; preludes: form-stdlib/core.fk
(do
    (let a (make_nodeid 7 3 2 91))
    (let b (make_nodeid 7 3 2 91))
    (let c (make_nodeid 7 3 2 92))
    (sum (list
        (if (eq a b) 1 0)
        (if (eq a c) 0 2)
        (if (eq a 42) 0 4)
        (if (eq a (list 7 3 2 91)) 0 8)
        (if (eq a (nothing)) 0 16)
        (if (value_eq a b) 32 0)
        (if (value_eq a c) 0 64)
        ; the 1.1.1 coordinate is the trivial int leaf: make_nodeid answers the word intern_trivial_int answers, for a negative, zero
        ; and positive value, and a leaf rebuilt from its own four coordinates is the leaf
        (if (and (eq (make_nodeid 1 1 1 (sub 0 5)) (intern_trivial_int (sub 0 5)))
            (and (eq (make_nodeid 1 1 1 0) (intern_trivial_int 0))
            (and (eq (make_nodeid 1 1 1 7) (intern_trivial_int 7))
                 (let n (intern_trivial_int 7)
                      (eq (make_nodeid (node_pkg n) (node_level n) (node_type n) (node_inst n)) n))))) 128 0))))
