; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk
;
; jit-native-run-band — the keystone join. form-lower's OWN emitted bytes, for a
; recipe built as a Form-native object, executed on real hardware via (nat_run),
; reproduce the walker. This closes the per-recipe JIT slice END TO END inside
; fkwu — code flows into a Form recipe, the JIT lowers ONE recipe to ASM, the
; native door runs it — with no clang / ld / dlopen / Go anywhere in the loop.
;
; Two halves were each proven before, never joined: form-lower emits correct
; bytes (byte-identity to clang + fsim semantic parity), and fk_native_call runs
; bytes (native_call_test). (nat_run BYTES ARG) is the join — it hands a lowered
; recipe image straight to fk_native_call. Requires the arm64 MAP_JIT door live
; (Apple Silicon); on x86-64 the same door runs form-lower-x64's bytes.
;
; recipe tags (lo-compile-fn): 1 LIT · 2 ARG · 3 ADD · 4 SUB · 5 MUL — operands
; are indices into the flat prog; the second list field is the LIT value.
;
; Verdict 15 when native == walker for every recipe and arg:
;   1  f(n) = n*3 + 7   at n = 0, 10, 100
;   2  f(n) = n - 1     at n = 1, 50
;   4  f(n) = n + n     at n = 7, 21
;   8  the door itself: native_call_test n == n + 1
(do
    (defn nr-f1 (n) (nat_run (lo-compile-fn (list (list 1 7) (list 2) (list 1 3) (list 5 1 2) (list 3 3 0)) 4) n))
    (defn wk-f1 (n) (add (mul n 3) 7))
    (defn nr-f2 (n) (nat_run (lo-compile-fn (list (list 2) (list 1 1) (list 4 0 1)) 2) n))
    (defn wk-f2 (n) (sub n 1))
    (defn nr-f3 (n) (nat_run (lo-compile-fn (list (list 2) (list 3 0 0)) 1) n))
    (defn wk-f3 (n) (add n n))

    (let c0 (if (and (eq (nr-f1 0) (wk-f1 0)) (and (eq (nr-f1 10) (wk-f1 10)) (eq (nr-f1 100) (wk-f1 100)))) 1 0))
    (let c1 (if (and (eq (nr-f2 1) (wk-f2 1)) (eq (nr-f2 50) (wk-f2 50))) 2 0))
    (let c2 (if (and (eq (nr-f3 7) (wk-f3 7)) (eq (nr-f3 21) (wk-f3 21))) 4 0))
    (let c3 (if (eq (native_call_test 5) 6) 8 0))

    (add c0 (add c1 (add c2 c3))))
