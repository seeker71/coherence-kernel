; Pure stream/learning contracts. Expected 31.
; preludes: observe/form-cli-heal-flow-live.bml form-stdlib/bml/form-cli-heal-learning.bml
(sum (list
 (if (str_eq (json-emit (json-node-object (list (fhf-number "output_tokens" 3)))) "{\"output_tokens\":3}") 1 0)
 (if (str_eq (fhl-state 1 1) "evaluation-excluded") 2 0)
 (if (str_eq (fhl-state 0 1) "training-required") 4 0)
 (if (str_eq (fhl-outcome 0) "unresolved") 8 0)
 (if (ge (str_find (fhl-row "native" "unresolved" "No patch passed.") "No patch passed." 0) 0) 16 0)))
