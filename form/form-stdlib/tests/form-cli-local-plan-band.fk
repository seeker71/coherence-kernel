; form-cli-local-plan-band.fk — the recurring next-tool speaker has a compact
; resident local-Qwen door; no frontier lane is offered by its grammar.
;
; preludes: form-stdlib/form-cli-model-generate.fk
;
; Verdict 255:
;   1   prompt asks for one exact next line
;   2   local action grammar carries the body-observation loop
;   4   no provider/network action exists in the offered move list
;   8   nothing, 0 and 1 distinction travels in the local prompt
;   16  missing selected model returns typed nothing
;   32  missing model does not invent a residence
;   64  empty task is refused without altering the held residence
;   128 projection becomes a typed offered move; malformed speech is nothing

(do
    (let prompt (fcmg-local-plan-prompt "repair the observed parser signal"))
    (let absent (fcmg-local-plan-resident (fcmr-none) ""
                    "repair the observed parser signal"))
    (let held (fcmr "/m/qwen.gguf" 128 (list 1) "src" "qwen35"))
    (let empty-task (fcmg-local-plan-resident held "/m/qwen.gguf" ""))
    (let report "backend=form-native-metal-jit\ngenerated_tokens=2\ntext:\nNEXT:observe")
    (let c0 (if (ge (str_find prompt "Reply with exactly one line: NEXT:<move>" 0) 0) 1 0))
    (let c1 (if (and (ge (str_find prompt "ground-first" 0) 0)
                     (and (ge (str_find prompt "preflight" 0) 0)
                          (and (ge (str_find prompt "changed or uncompiled source -> preflight" 0) 0)
                               (ge (str_find prompt "error -> observe" 0) 0)))) 2 0))
    (let c2 (if (and (lt (str_find prompt "remote" 0) 0)
                     (and (lt (str_find prompt "frontier" 0) 0)
                          (lt (str_find prompt "HTTP" 0) 0))) 4 0))
    (let c3 (if (ge (str_find prompt "nothing, 0, and 1" 0) 0) 8 0))
    (let c4 (if (eq (str_find (nth absent 0) "local-plan=nothing" 0) 0) 16 0))
    (let c5 (if (eq (fcmr-live? (nth absent 1)) 0) 32 0))
    (let c6 (if (and (str_eq (nth empty-task 0) "usage: local-plan <task>")
                     (str_eq (fcmr-path (nth empty-task 1)) "/m/qwen.gguf")) 64 0))
    (let offered (fcmg-local-plan-offer
        (str_concat (fcmg-local-plan-text report) "\n")))
    (let refused (fcmg-local-plan-offer "I think you should observe"))
    (let c7 (if (and (str_eq (nth offered 0) "ready")
                     (and (str_eq (nth offered 1) "observe")
                          (str_eq (nth refused 0) "nothing"))) 128 0))
    (sum (list c0 c1 c2 c3 c4 c5 c6 c7)))
