; care-floor-quiet-band.fk — the care floor stays quiet on everyday Spanish and French that only sounds like danger
; ("I can't anymore", "I'm drowning in work"), and still hears the danger itself in both tongues. 6 bits -> 63.
; A gap in learn/native-turn-queue.jsonl: the native code lane is asked to turn it green.
; preludes: form-stdlib/bml/care-floor.bml
(do
    (defn cfq-bit (ok n) (if (eq ok 1) n 0))
    (let quiet-fr (cf-quiet (list "je ne peux plus attendre la sortie" "je ne peux plus voir ce bug" "on ne peut plus rien faire ce soir")))
    (let quiet-es (cf-quiet (list "no puedo más con este código" "no puedo más de la risa" "me ahogo en papeles esta semana")))
    (let es (mul (cf-is "no quiero vivir" "self-harm") (cf-is "no puedo respirar" "medical")))
    (let fr (mul (cf-is "je veux mourir" "self-harm") (cf-is "douleur à la poitrine" "medical")))
    (let before (if (eq (cf-self-check) 255) 1 0))
    (let mixed (mul (cf-is "no puedo más, quiero morir" "self-harm") (cf-is "je ne peux plus, je veux me tuer" "self-harm")))
    (add (cfq-bit quiet-fr 1) (add (cfq-bit quiet-es 2) (add (cfq-bit es 4) (add (cfq-bit fr 8) (add (cfq-bit before 16) (cfq-bit mixed 32)))))))
