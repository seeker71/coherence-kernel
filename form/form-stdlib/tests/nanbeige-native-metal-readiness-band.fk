; preludes: form-stdlib/core.fk form-stdlib/nanbeige-native-metal-readiness.fk

(do
    (let stages (nbnm-stages))
    (let receipt (nbnm-receipt))
    (let c0 (if (eq (len stages) 13) 1 0))
    (let c1 (if (eq (nbnm-count-observed stages) 7) 2 0))
    (let c2 (if (eq (nbnm-count-native stages) 2) 4 0))
    (let c3 (if (eq (nbnm-count-ready stages) 2) 8 0))
    (let c4 (if (eq (nbnm-generation-ready?) 0) 16 0))
    (let c5 (if (str_eq (nth receipt 5)
        "pending:native-quantized-metal-execution-port") 32 0))
    (sum (list c0 c1 c2 c3 c4 c5)))
