; living-world-hypothesis-transfer-continuity-write.fk -- process one grows
; held-out native voice and persists the exact world as inert evidence.
; Verdict 31 proves image validity, append-new save, path/size, and identity.
; preludes: form-stdlib/core.fk form-stdlib/tests/living-world-hypothesis-transfer-continuity-witness.fk

(do
    (let started
        (lcfb-open-stream "living-world-hypothesis-transfer-continuity-write"
            "form-native" "lwcd-save-new" "voiced-world-image"
            "form/form-stdlib/tests/living-world-hypothesis-transfer-continuity-write.fk"
            8 9))
    (let result (lwhtrw-run started))
    (let world (nth result 18))
    (let image (lwcn-image world))
    (let save-enter
        (lcfb-call-stream "living-world-hypothesis-transfer-continuity-write"
            "persist" "enter" "form-native" "lwcd-save-new"
            "append-new-inert-image" 15 started
            "form/form-stdlib/tests/living-world-hypothesis-transfer-continuity-write.fk"
            16 9))
    (let saved (lwcd-save-new (lwhtrcw-path) image LWHTRCW-PROVENANCE))
    (let save-leave
        (lcfb-call-stream "living-world-hypothesis-transfer-continuity-write"
            "persist" "leave" "form-native" "lwcd-save-new"
            (lcfb-cat (list "saved:" (int_to_str (lwcd-saved? saved))
                ":bytes:" (int_to_str (fs-stat-size (lwhtrcw-path)))))
            16 started
            "form/form-stdlib/tests/living-world-hypothesis-transfer-continuity-write.fk"
            23 9))
    (sum (list
        (if (eq (lwcn-image-valid? image) 1) 1 0)
        (if (eq (lwcd-saved? saved) 1) 2 0)
        (if (eq (fs-exists? (lwhtrcw-path)) 1) 4 0)
        (if (gt (fs-stat-size (lwhtrcw-path)) 0) 8 0)
        (if (node_eq (lwcd-result-image saved) image) 16 0))))
