; living-world-transformation-nursery-trial-band.fk -- a candidate is observed.
; Verdict 32767 proves fifteen native execution, comparison, and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk

(do
    (let fixture (lwtnw-build-target))
    (let target (lwtnw-target fixture))
    (let selection (lwtnw-exact-selection fixture))
    (let selection-world
        (lwt-round-world (lwtnw-selection-round selection)))
    (let selected (lwtnw-selection-candidate selection))
    (let proposal
        (lwtn-trial-proposal selection-world selected
            (intern_trivial_int 5) (lwtnw-evidence)))
    (let trial-candidate (lwt-proposal-candidate proposal))
    (let trial (lwo-emergent-shape trial-candidate))
    (let waiting-round
        (lwt-round selection-world (lwo-field (list proposal))
            (lwo-empty-field) (lwtnw-selection-round selection)))
    (let waiting
        (lwtn-trial-integrate waiting-round proposal (lwigw-action)))
    (let integrated (lwtnw-exact-trial fixture))
    (let integrated-world
        (lwt-round-world (lwtnw-trial-round integrated)))
    (let integrated-candidate (lwtnw-trial-candidate integrated))
    (let integrated-trial (lwtnw-trial-shape integrated))
    (let trace (lwtn-trial-trace integrated-trial))
    (let expected (lwtn-trial-expected integrated-trial))
    (let actual (lwtn-trial-actual integrated-trial))
    (let mismatch (lwtnw-mismatch-trial fixture))
    (let mismatch-world
        (lwt-round-world (lwtnw-trial-round mismatch)))
    (let mismatch-candidate (lwtnw-trial-candidate mismatch))
    (let mismatch-trial (lwtnw-trial-shape mismatch))
    (let mismatch-comparison (lwtn-trial-comparison mismatch-trial))
    (let mismatch-alternative (oac-payload mismatch-comparison))
    (let ambiguous-world
        (lwtnw-ambiguous-world fixture (lwtnw-exact-world fixture)))
    (let revocation
        (lwo-revocation (lwtnw-recipe-e) (lwtnw-source-v)
            (lwtnw-reason) (lwtnw-prov-v)))
    (let revoked-world
        (lwt-receive-stream integrated-world
            (list (lwtnw-entry-v revocation))))

    (let c1
        (if (and (eq (lwre-recipe-valid? (lwtnw-recipe-e)) 1)
                 (and (le (str_len (lwre-recipe-source
                                      (lwtnw-recipe-e)))
                          (lwre-contract-budget
                            (lwre-recipe-contract
                              (lwtnw-recipe-e))))
                      (node_eq (lwre-contract-evaluator
                                  (lwre-recipe-contract
                                    (lwtnw-recipe-e)))
                               (lwre-form-evaluator)))) 1 0))
    (let c2
        (if (and (eq (lwtn-trial-current? selection-world trial) 1)
                 (node_eq (lwre-trace-recipe
                              (lwtn-trial-trace trial))
                          (lwtnw-recipe-e))) 2 0))
    (let c3
        (if (and (node_eq (lwrx-overall-before actual)
                          (intern_trivial_int 1))
                 (node_eq (lwrx-overall-after actual)
                          (intern_trivial_int 4))) 4 0))
    (let c4
        (if (and (eq (len (lwrx-lens-sequence-items
                              (lwrx-overall-lenses expected))) 3)
                 (and (eq (len (lwrx-lens-sequence-items
                                   (lwrx-overall-lenses actual))) 1)
                      (not (node_eq expected actual)))) 8 0))
    (let c5
        (if (and (eq (lwtn-boundary-agrees? expected actual) 1)
                 (and (eq (oac-one?
                              (lwtn-trial-comparison integrated-trial)) 1)
                      (node_eq (oac-payload
                                  (lwtn-trial-comparison integrated-trial))
                               actual))) 16 0))
    (let c6
        (if (and (eq (oac-time-pending?
                         (lwtn-trial-time-observation integrated-trial)) 1)
                 (not (node_eq
                         (lwtn-trial-time-observation integrated-trial)
                         (lwtn-trial-comparison integrated-trial)))) 32 0))
    (let c7
        (if (and (eq (lwo-field-size
                         (lwtn-trial-alternatives integrated-trial)) 3)
                 (eq (lwo-field-has?
                         (lwtn-trial-unknowns integrated-trial)
                         (lwlc-unknown (lwtnw-evidence))) 1)) 64 0))
    (let c8
        (if (and (eq (lwo-field-size
                         (lwt-proposal-participants proposal)) 9)
                 (eq (lwtn-trial-proposal-current?
                         selection-world proposal) 1)) 128 0))
    (let c9
        (if (eq (lwo-active?
                    (lwt-round-world waiting) trial-candidate) 0) 256 0))
    (let c10
        (if (and (eq (lwtn-trial-integrated-current?
                         integrated-world integrated-candidate) 1)
                 (eq (lwre-trace-current? integrated-world trace) 1)) 512 0))
    (let c11
        (if (node_eq
                (lwtn-trial-proposal ambiguous-world selected
                    (intern_trivial_int 5) (lwtnw-evidence))
                (lwo-none)) 1024 0))
    (let c12
        (if (and (node_eq (lwrx-overall-after
                              (lwtn-trial-actual mismatch-trial))
                          (intern_trivial_int 3))
                 (eq (lwtn-boundary-agrees?
                         (lwtn-trial-expected mismatch-trial)
                         (lwtn-trial-actual mismatch-trial)) 0)) 2048 0))
    (let c13
        (if (and (eq (oac-alternative-ack? mismatch-comparison) 1)
                 (and (node_eq
                          (oac-alternative-reference mismatch-alternative)
                          (lwtn-trial-expected mismatch-trial))
                      (node_eq
                          (oac-alternative-offered mismatch-alternative)
                          (lwtn-trial-actual mismatch-trial)))) 4096 0))
    (let c14
        (if (eq (lwtn-trial-integrated-current?
                    mismatch-world mismatch-candidate) 1) 8192 0))
    (let c15
        (if (and (eq (lwtn-selection-candidate-current?
                         revoked-world selected) 0)
                 (eq (lwtn-trial-integrated-current?
                         revoked-world integrated-candidate) 0)) 16384 0))
    (lwtnw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
