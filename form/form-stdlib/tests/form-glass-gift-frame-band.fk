; form-glass-gift-frame-band.fk — a frame in process shared memory, offered as a gift.
;
; Every bit stands on a real shared-memory frame on this host: offered here,
; received here and by a CHILD PROCESS, never torn, absent named absent. The
; membrane bits publish a real snapshot and read it back through the gift
; carrier before the file. The gift name used here is this band's own; a
; failed run leaves the frame standing, and the next run offers into it again.
;
; Expected: 4095
; preludes: form-stdlib/form-glass-gift-frame.bml form-stdlib/form-glass-telemetry-membrane.bml

(do
    (defn gfb-bit (ok bit) (if ok bit 0))
    (let pub "gift-frame-band.witness")
    (let h (ggf-offer pub 4096))

    ; offer answers a handle; the first give answers an even sequence
    (let b1 (gfb-bit (and (not (nothing? h)) (ge h 0)) 1))
    (let s1 (ggf-give h "first gift"))
    (let b2 (gfb-bit (and (not (nothing? s1)) (eq (sub s1 (mul (div s1 2) 2)) 0)) 2))

    ; what was given is what is taken, byte for byte
    (let b3 (gfb-bit (str_eq (ggf-taken h) "first gift") 4))

    ; a second give replaces the frame and advances the sequence by two
    (let s2 (ggf-give h "second, longer gift text"))
    (let b4 (gfb-bit (and (str_eq (ggf-taken h) "second, longer gift text") (eq s2 (add s1 2))) 8))
    (let b5 (gfb-bit (eq (ggf-seq h) s2) 16))

    ; a gift that was never offered is absent by name, never invented
    (let absent (ggf-reading "gift-frame-band.never-offered"))
    (let b6 (gfb-bit (and (str_eq (ggf-reading-carrier absent) "absent")
                          (and (nothing? (ggf-reading-text absent))
                               (eq (ggf-reading-received? absent) 0))) 32))

    ; a second receiver in THIS process sees the same frame
    (let r (ggf-receive pub))
    (let b7 (gfb-bit (str_eq (ggf-taken r) "second, longer gift text") 64))

    ; a CHILD PROCESS receives what this process gave -- shared memory, not a file
    (let child (host-exec "./fkwu form/form-stdlib/tests/form-glass-gift-frame-child.fk 2>/dev/null" ""))
    (let b8 (gfb-bit (and (not (nothing? child)) (ge (str_find child "second, longer gift text" 0) 0)) 128))

    ; the reading carries the sovereignty-as-gift shape and is proven when received
    (let taken (ggf-reading pub))
    (let b9 (gfb-bit (and (str_eq (ggf-reading-carrier taken) "gift")
                          (and (eq (ggf-reading-received? taken) 1)
                               (eq (ggf-reading-proven? taken) 1))) 256))

    ; release answers 1 and never unlinks: a fresh receiver still finds the frame
    (let rel (ggf-release h))
    (let again (ggf-receive pub))
    (let b10 (gfb-bit (and (eq rel 1) (str_eq (ggf-taken again) "second, longer gift text")) 512))

    ; the membrane: a real snapshot published here is read back through the gift carrier
    (let root (str_concat (temp_dir) "/fk-gift-frame-band-root"))
    (let sample (fgtm-sample "gift-frame-band.sample" (fgtm-absent) "witness" "cpu" "gift-frame-band" "band" "witness"
        (fgtm-present 1) (fgtm-present 1) "active" (fgtm-present 1) (fgtm-present 1) (fgtm-present 0)
        (fgtm-absent) "never" "physical-live" "gift-frame-band" (list "gift" "witness")))
    (let published (fgtm-publish-snapshot root "gift-frame-band.membrane" 1234567 (list sample)))
    (let reading (fgtm-read-current root "gift-frame-band.membrane"))
    (let b11 (gfb-bit (and (str_eq (nth published 1) "published")
                           (and (str_eq (fgtm-read-state-status reading) "current")
                                (str_eq (fgtm-read-current-carrier root "gift-frame-band.membrane") "gift"))) 1024))

    ; the gift name stays within the host bound for any publisher id
    (let b12 (gfb-bit (and (eq (str_len (ggf-name "models.dual-resident.i1788484971859.some-very-long-instance-name")) 12)
                           (eq (ggf-name-within-bound? (ggf-name pub)) 1)) 2048))

    (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 (add b9 (add b10 (add b11 b12))))))))))))
