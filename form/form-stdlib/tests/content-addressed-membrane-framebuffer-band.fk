; preludes: form-stdlib/core.fk form-stdlib/sha256.fk form-stdlib/native-model-evidence.fk form-stdlib/content-addressed-membrane.fk form-stdlib/content-addressed-membrane-framebuffer.fk

(do
    (framebuffer-clear)
    (let payload (nmfe-sha256 "tokens:344"))
    (let receipt (cam-crossing
        payload
        "selected token id"
        "metal result to Form decode"
        "request epoch 8"
        "Form DS4 cell"
        "shared result"
        "greedy token 344"
        "decode needs the selected id"
        "GGUF output head"
        "return a Form value directly"
        1 7558029
        "Form-native command encoder"
        "this request"
        "success"))
    (let alternative (intern_trivial_int 0))
    (let offered
        (camf-offer receipt
            "form-stdlib/tests/content-addressed-membrane-framebuffer-band.fk"
            9 1 alternative))
    (let why-answer
        (camf-inquire offered (cam-id receipt) "why"
            "form-stdlib/tests/content-addressed-membrane-framebuffer-band.fk"
            12 1))
    (let unknown-answer
        (camf-inquire offered (cam-id receipt) "beyond-current-lanes"
            "form-stdlib/tests/content-addressed-membrane-framebuffer-band.fk"
            15 1))
    (let alternative-answer
        (camf-inquire offered (nmfe-sha256 "different") "root"
            "form-stdlib/tests/content-addressed-membrane-framebuffer-band.fk"
            18 1))
    (if (eq (cam-witnessed? receipt) 1)
    (if (eq (camf-live? offered) 1)
    (if (eq (len (framebuffer-events)) 5)
    (if (str_eq (head why-answer) "node")
    (if (str_eq (nth why-answer 1) "decode needs the selected id")
    (if (str_eq (head unknown-answer) "nothing")
    (if (str_eq (head alternative-answer) "node")
    (if (eq (nth alternative-answer 1) alternative)
        255 0) 0) 0) 0) 0) 0) 0) 0))
