; form-glass-atlas-said-band.fk — the atlas holds still, and says what is lit.
;
; Two readings a person asked for, on 2026-09-10, looking at a running glass:
; the streaming rows under SEAM were "not width justified and are bouncing
; around", and the m/s/o tiles "could be selectable and the highlighted
; translated to human understandable line".
;
; The bounce: a flow half was FITTED to its width and never PADDED. fgd-fit
; truncates and returns short text unchanged, so a half whose gauge rendered
; narrow left the divider at whatever column that frame's value happened to end
; at — and the value changes every frame, so the divider and the whole right
; half walked. A column that moves cannot be compared across frames.
;
; The sentence: a tile is five columns (`k*80M`) and five columns cannot say
; what they mean. Every fact a sentence needs was already on the row the tile
; was folded from. Selection already stood, and it is KEYED, not indexed —
; which bit 32 is about.
;
; Expected: 63
;
;   1   a flow half occupies exactly its width, whatever it rendered
;   2   two halves of the same width put the divider on one column, and a
;       narrow reading and a wide one land it in the same place
;   4   a metric says itself: what it measures, the value with its unit, its
;       state, how it was witnessed, and which door read it
;   8   a membrane sample says itself in ITS grammar, not a metric's
;   16  no selection renders no line — silence, not an empty frame
;   32  selection is by KEY: reorder the rows and the same key still describes
;       the same tile. An index would name a different row every time a metric
;       arrives or goes silent.
;
; preludes: form/form-stdlib/form-glass-layout-ui.bml

(do
    (defn xb (ok bit) (if ok bit 0))
    (defn m (id label value unit ev src life note)
        (fgo-int "machine" id label value unit 0 "cpu" ev src life "glass" note))
    (defn s (id kind purpose)
        (fgtm-sample id (fgtm-absent) kind "membrane" "owner" "lane" purpose
            (fgtm-absent) (fgtm-absent) "active" (fgtm-present 1) (fgtm-present 1)
            (fgtm-absent) (fgtm-absent) "never" "physical-live" "band" (list "atlas")))

    ; ---- 1, 2: the halves hold their columns
    (let narrow (fgd-pad-right "G*=1" 20))
    (let wide (fgd-pad-right "G*?+======@#*==3M/319G" 20))
    (let b1 (xb (and (eq (str_len narrow) 20)
                     (eq (str_len wide) 20)) 1))
    (let b2 (xb (and (eq (str_len (str_concat narrow "|")) (str_len (str_concat wide "|")))
                (and (eq (str_len (fgd-pad-right "" 20)) 20)
                     (eq (str_len (fgd-pad-right "0123456789012345678901234" 20)) 20))) 2))

    ; ---- 4: a metric says itself
    (let gpu (m "gpu-busy" "GPU busy" 80000000 "microseconds" "physical-live" "metal_live.gpu-busy-us" "live" "measured by the process itself"))
    (let said (fglat-say-tile gpu))
    (let b3 (xb (and (gt (str_len said) 40)
                (and (eq (fglat-tile-metric? gpu) 1)
                (and (gt (str_len (fglat-say-metric gpu)) 0)
                     (str_eq said (fglat-say-metric gpu))))) 4))

    ; ---- 8: a sample says itself in its own grammar
    (let frame (s "frame.glass" "gift" "successful local publication"))
    (let saidS (fglat-say-tile frame))
    (let b4 (xb (and (eq (fglat-tile-metric? frame) 0)
                (and (str_eq saidS (fglat-say-sample frame))
                     (not (str_eq saidS said)))) 8))

    ; ---- 16: no selection, no line
    (let ms (list gpu))
    (let b5 (xb (and (eq (len (fglui-said-line "all" ms (list) (list) 80)) 0)
                (and (eq (len (fglui-said-line "none" ms (list) (list) 80)) 0)
                     (gt (len (fglui-said-line "gpu-busy" ms (list) (list) 80)) 0))) 16))

    ; ---- 32: keyed, not indexed — reordering does not move the meaning
    (let other (m "arena" "kernel arena cells" 2969655 "cells" "physical-live" "kernel_stat" "live" ""))
    (let orderA (list gpu other))
    (let orderB (list other gpu))
    (let b6 (xb (and (str_eq (fglat-say-tile (fglui-selected-row "gpu-busy" orderA (list) (list)))
                             (fglat-say-tile (fglui-selected-row "gpu-busy" orderB (list) (list))))
                (and (not (str_eq (fglat-say-tile (fglui-selected-row "gpu-busy" orderA (list) (list)))
                                  (fglat-say-tile (fglui-selected-row "arena" orderA (list) (list)))))
                     (eq (len (fglui-selected-row "no-such-key" orderA (list) (list))) 0))) 32))

    (print (list "said" said))
    (print (list "sample" saidS))
    (sum (list b1 b2 b3 b4 b5 b6)))
