; living-world-continuity-witness.fk -- one learned world becomes an inert image.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-enquiry.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-capability-context.fk form-stdlib/tests/living-world-recursive-witness.fk

(let LWCNW-QUERY   (bp "LWCNW-QUERY"))
(let LWCNW-LEARN   (bp "LWCNW-LEARN"))
(let LWCNW-VOICE   (bp "LWCNW-VOICE"))
(let LWCNW-SHARED  (bp "LWCNW-SHARED"))
(let LWCNW-PRIVATE (bp "LWCNW-PRIVATE"))
(let LWCNW-RETIRED (bp "LWCNW-RETIRED"))

(defn lwcnw-query-capability ()
    (intern_node LWCNW-QUERY (empty)))
(defn lwcnw-learn-capability ()
    (intern_node LWCNW-LEARN (empty)))
(defn lwcnw-voice-capability ()
    (intern_node LWCNW-VOICE (empty)))
(defn lwcnw-shared ()
    (intern_node LWCNW-SHARED
        (list (intern_trivial_string "shared-consented-tissue"))))
(defn lwcnw-private ()
    (intern_node LWCNW-PRIVATE
        (list (intern_trivial_string "source-a-private-tissue"))))
(defn lwcnw-retired ()
    (intern_node LWCNW-RETIRED
        (list (intern_trivial_string "released-before-continuity"))))
(defn lwcnw-focus ()
    (lwen-focus (lwrrw-unseen-input)
        (intern_trivial_string "lwcnw-query-focus")))
(defn lwcnw-grant-evidence (capability)
    (intern_node (bp "LWCNW-GRANT-EVIDENCE") (list capability)))
(defn lwcnw-release-reason ()
    (intern_trivial_string "lwcnw-release"))

(defn lwcnw-mapping-candidate ()
    (do
        (let base (lwrrw-base-round 2))
        (lwt-proposal-candidate (lwrrw-first-proposal base))))

(defn lwcnw-snapshot-world ()
    (do
        (let base (lwrrw-base-round 2))
        (let proposal (lwrrw-first-proposal base))
        (let integrated
            (lwrrw-integrated-mapping-round base proposal))
        (let with-tissue
            (lwt-receive-stream (lwt-round-world integrated)
                (list
                    (lwrrw-entry (lwrrw-source-d) (lwcnw-focus)
                                 (lwrrw-provenance-d))
                    (lwrrw-entry (lwrrw-source-a) (lwcnw-shared)
                                 (lwrrw-provenance-a))
                    (lwrrw-entry (lwrrw-source-b) (lwcnw-shared)
                                 (lwrrw-provenance-b))
                    (lwrrw-entry (lwrrw-source-a) (lwcnw-private)
                                 (lwrrw-provenance-a))
                    (lwrrw-entry (lwrrw-source-c) (lwcnw-retired)
                                 (lwrrw-provenance-c)))))
        (lwt-receive-stream with-tissue
            (list
                (lwrrw-entry (lwrrw-source-c)
                    (lwo-revocation (lwcnw-retired) (lwrrw-source-c)
                        (lwcnw-release-reason) (lwrrw-provenance-c))
                    (lwrrw-provenance-c))))))

(defn lwcnw-image () (lwcn-image (lwcnw-snapshot-world)))
(defn lwcnw-admission-world (image)
    (lwt-receive-stream (lwo-empty-world)
        (list
            (lwrrw-entry (lwrrw-source-e) image
                         (lwrrw-provenance-e)))))

(defn lwcnw-restore-proposal (admission-world image)
    (lwcn-restore-proposal admission-world image))

(defn lwcnw-restore-round (admission-world proposal)
    (lwt-round admission-world
        (lwo-field-add (lwo-empty-field) proposal)
        (lwo-empty-field) (lwo-none)))

(defn lwcnw-restore-yes-round (round proposal)
    (lwt-round-receive round
        (list
            (lwrrw-yes-entry (lwrrw-source-a)
                             (lwrrw-provenance-a) proposal)
            (lwrrw-yes-entry (lwrrw-source-b)
                             (lwrrw-provenance-b) proposal)
            (lwrrw-yes-entry (lwrrw-source-c)
                             (lwrrw-provenance-c) proposal)
            (lwrrw-yes-entry (lwrrw-source-d)
                             (lwrrw-provenance-d) proposal))))

(defn lwcnw-restored-round-from-image (image)
    (do
        (let admission (lwcnw-admission-world image))
        (let proposal (lwcnw-restore-proposal admission image))
        (let round (lwcnw-restore-round admission proposal))
        (lwcn-integrate-restore
            (lwcnw-restore-yes-round round proposal)
            proposal (lwrrw-action))))

(defn lwcnw-tampered-image ()
    (intern_node LWCN-IMAGE
        (list (lwcnw-snapshot-world)
              (lwcn-manifest (lwo-empty-world))
              (lwo-local-path))))

(defn lwcnw-offer-purpose-world (world)
    (lwt-receive-stream world
        (list
            (lwrrw-entry (lwrrw-source-d) (lwcnw-query-capability)
                         (lwrrw-provenance-d))
            (lwrrw-entry (lwrrw-source-d) (lwcnw-learn-capability)
                         (lwrrw-provenance-d))
            (lwrrw-entry (lwrrw-source-d) (lwcnw-voice-capability)
                         (lwrrw-provenance-d)))))

(defn lwcnw-grant-entry (source provenance payload capability)
    (lwrrw-entry source
        (lwcp-grant payload capability
            (lwcnw-grant-evidence capability)) provenance))

(defn lwcnw-full-capability-world (restored-world)
    (do
        (let world (lwcnw-offer-purpose-world restored-world))
        (let query (lwcnw-query-capability))
        (let learn (lwcnw-learn-capability))
        (let voice (lwcnw-voice-capability))
        (let candidate (lwcnw-mapping-candidate))
        (lwt-receive-stream world
            (list
                ; Learning sees the complete current evidence field.
                (lwcnw-grant-entry (lwrrw-source-a) (lwrrw-provenance-a)
                    (lwrrw-correspondence-a) learn)
                (lwcnw-grant-entry (lwrrw-source-b) (lwrrw-provenance-b)
                    (lwrrw-correspondence-b) learn)
                (lwcnw-grant-entry (lwrrw-source-c) (lwrrw-provenance-c)
                    (lwrrw-correspondence-c) learn)
                ; Enquiry sees evidence, admitted mapping, and explicit focus.
                (lwcnw-grant-entry (lwrrw-source-a) (lwrrw-provenance-a)
                    (lwrrw-correspondence-a) query)
                (lwcnw-grant-entry (lwrrw-source-b) (lwrrw-provenance-b)
                    (lwrrw-correspondence-b) query)
                (lwcnw-grant-entry (lwrrw-source-c) (lwrrw-provenance-c)
                    (lwrrw-correspondence-c) query)
                (lwcnw-grant-entry (lwrrw-source-a) (lwrrw-provenance-a)
                    candidate query)
                (lwcnw-grant-entry (lwrrw-source-b) (lwrrw-provenance-b)
                    candidate query)
                (lwcnw-grant-entry (lwrrw-source-c) (lwrrw-provenance-c)
                    candidate query)
                (lwcnw-grant-entry (lwrrw-source-d) (lwrrw-provenance-d)
                    (lwcnw-focus) query)
                ; Shared voice-context tissue requires both active holders.
                (lwcnw-grant-entry (lwrrw-source-a) (lwrrw-provenance-a)
                    (lwcnw-shared) voice)
                (lwcnw-grant-entry (lwrrw-source-b) (lwrrw-provenance-b)
                    (lwcnw-shared) voice)))))

(defn lwcnw-release-grant (world source provenance payload capability)
    (do
        (let grant
            (lwcp-grant payload capability
                (lwcnw-grant-evidence capability)))
        (lwt-receive-stream world
            (list
                (lwrrw-entry source
                    (lwo-revocation grant source
                        (lwcnw-release-reason) provenance)
                    provenance)))))

(defn lwcnw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwcnw-sum (tail items)))))
