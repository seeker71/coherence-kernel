; living-world-shared-field-live-encoder.fk -- public separate-process sender
; for the direct interactive carrier.
;
; The primary path is not a restored world read in full.  It opens an empty
; field and emits the exact chronological entry stream that grows three
; transitions and three learned surfaces, followed by one projected request
; and the exact offered close cell.  Each independently canonical message is
; admitted before the next.  A message larger than the temporary host line
; window uses bounded atomic chunk cells as an explicit special case.
;
; Raw canonical lines are followed by a privacy-safe message boundary carrying
; only the message ordinal and carrier-frame count.
;
; preludes: form-stdlib/core.fk observe/live-call-framebuffer.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-session-observation.fk form-stdlib/living-world-session-learning.fk form-stdlib/living-world-shared-field-channel.fk form-stdlib/living-world-shared-field-continuity.fk form-stdlib/living-world-generative-continuation.fk form-stdlib/living-world-shared-field-live.fk form-stdlib/tests/living-world-generative-continuation-witness.fk form-stdlib/tests/living-world-shared-field-live-witness.fk

(let LWSFLE-TRANSFER (bp "LWSFLE-TRANSFER"))

(defn lwsfle-transfer (ordinal)
    (intern_node LWSFLE-TRANSFER
        (list (intern_trivial_int ordinal) (lwo-local-path))))

; Result: successor state, four chronological input entries, derivation.
(defn lwsfle-transition-batch (state context next)
    (do
        (let observation (lwtf-observation context next (lwo-none)))
        (let entry-a
            (lwsgw-entry (lwsgw-source-a) observation (lwsgw-prov-a)))
        (let step-a (lwsf-apply state entry-a))
        (let entry-b
            (lwsgw-entry (lwsgw-source-b) observation (lwsgw-prov-b)))
        (let step-b (lwsf-apply (lwsgw-next-state step-a) entry-b))
        (let proposal
            (lwtf-proposal-for
                (lwsgw-state-world (lwsgw-next-state step-b))
                observation 2))
        (let response-a
            (lwsgw-response-entry (lwsgw-source-a) (lwsgw-prov-a)
                proposal (oac-one (lwt-proposal-candidate proposal))))
        (let step-response-a
            (lwsf-apply (lwsgw-next-state step-b) response-a))
        (let response-b
            (lwsgw-response-entry (lwsgw-source-b) (lwsgw-prov-b)
                proposal (oac-one (lwt-proposal-candidate proposal))))
        (let step-response-b
            (lwsf-apply (lwsgw-next-state step-response-a) response-b))
        (let next-state (lwsgw-next-state step-response-b))
        (let derivation
            (lwtf-derivation (lwsgw-state-world next-state)
                (lwt-proposal-candidate proposal)))
        (list next-state
            (list entry-a entry-b response-a response-b) derivation)))

; Result: successor state, four chronological input entries.
(defn lwsfle-symbol-batch (state derivation surface)
    (do
        (let observation
            (lwsl-observation derivation 0 surface (lwo-none)
                (oac-one derivation) (lwsgw-evidence)))
        (let entry-c
            (lwsgw-entry (lwsgw-source-c) observation (lwsgw-prov-c)))
        (let step-c (lwsf-apply state entry-c))
        (let entry-d
            (lwsgw-entry (lwsgw-source-d) observation (lwsgw-prov-d)))
        (let step-d (lwsf-apply (lwsgw-next-state step-c) entry-d))
        (let proposal
            (lwsl-proposal-for
                (lwsgw-state-world (lwsgw-next-state step-d))
                observation 2))
        (let response-c
            (lwsgw-response-entry (lwsgw-source-c) (lwsgw-prov-c)
                proposal (oac-one (lwt-proposal-candidate proposal))))
        (let step-response-c
            (lwsf-apply (lwsgw-next-state step-d) response-c))
        (let response-d
            (lwsgw-response-entry (lwsgw-source-d) (lwsgw-prov-d)
                proposal (oac-one (lwt-proposal-candidate proposal))))
        (let step-response-d
            (lwsf-apply (lwsgw-next-state step-response-c) response-d))
        (list (lwsgw-next-state step-response-d)
            (list entry-c entry-d response-c response-d))))

; Result: successor state, twelve transition entries, three derivations.
(defn lwsfle-transition-stream ()
    (do
        (let state-0 (lwsf-open 2 (lwsgw-action)))
        (let link-a
            (lwsg-link (lwsgw-output-a) (lwsgw-context-b)
                (lwo-none) (lwsgw-evidence)))
        (let link-b
            (lwsg-link (lwsgw-output-b) (lwsgw-context-c)
                (lwsgw-lens) (lwsgw-evidence)))
        (let link-c
            (lwsg-link (lwsgw-output-c) (lwo-none)
                (lwo-none) (lwsgw-evidence)))
        (let batch-a
            (lwsfle-transition-batch state-0 (lwsgw-context-a) link-a))
        (let batch-b
            (lwsfle-transition-batch (nth batch-a 0)
                (lwsgw-context-b) link-b))
        (let batch-c
            (lwsfle-transition-batch (nth batch-b 0)
                (lwsgw-context-c) link-c))
        (list (nth batch-c 0)
            (append (nth batch-a 1)
                (append (nth batch-b 1) (nth batch-c 1)))
            (list (nth batch-a 2) (nth batch-b 2) (nth batch-c 2)))))

; Result: successor state, twelve symbol entries.
(defn lwsfle-symbol-stream (state derivations)
    (do
        (let batch-a
            (lwsfle-symbol-batch state (nth derivations 0) "seed"))
        (let batch-b
            (lwsfle-symbol-batch (nth batch-a 0)
                (nth derivations 1) " grows"))
        (let batch-c
            (lwsfle-symbol-batch (nth batch-b 0)
                (nth derivations 2) "."))
        (list (nth batch-c 0)
            (append (nth batch-a 1)
                (append (nth batch-b 1) (nth batch-c 1))))))

; Result: successor state, twenty-four chronological input entries.
(defn lwsfle-world-stream ()
    (do
        (let transitions (lwsfle-transition-stream))
        (let symbols
            (lwsfle-symbol-stream (nth transitions 0)
                (nth transitions 2)))
        (list (nth symbols 0)
            (append (nth transitions 1) (nth symbols 1)))))

(defn lwsfle-open ()
    (lwsfl-open 2 (lwsgw-action) (lwo-none) (lwo-none)
        (lwo-empty-field) (lwo-none) (lwsflw-close)
        (lwsgw-evidence)))

(defn lwsfle-request-entry ()
    (lwsgw-entry (lwsgw-source-a)
        (lwsflw-projected-request) (lwsgw-prov-a)))

(defn lwsfle-boundary (ordinal frames)
    (print_str
        (lcfb-cat (list
            "sender-boundary|schema=v1|message:"
            (int_to_str ordinal)
            ":frames:" (int_to_str frames)))))

(defn lwsfle-message-target (ordinal frames)
    (lcfb-cat (list
        "message:" (int_to_str ordinal)
        ":frames:" (int_to_str frames))))

(defn lwsfle-emit-message (cell ordinal started)
    (do
        (let entered
            (lcfb-call-stream "living-world-shared-field-live-encoder"
                "send" "enter" "form-native" "lwsfle-emit-message"
                (lwsfle-message-target ordinal 0) (mul ordinal 2) started
                "form/form-stdlib/tests/living-world-shared-field-live-encoder.fk"
                157 13))
        (let frames
            (lwsfl-emit-cell cell (lwsfle-transfer ordinal)))
        (let boundary (lwsfle-boundary ordinal frames))
        (let left
            (lcfb-call-stream "living-world-shared-field-live-encoder"
                "send" "leave" "form-native" "lwsfle-emit-message"
                (lwsfle-message-target ordinal frames)
                (add (mul ordinal 2) 1) started
                "form/form-stdlib/tests/living-world-shared-field-live-encoder.fk"
                166 13))
        frames))

; Result: next message ordinal, aggregate carrier-frame count.
(defn lwsfle-emit-items (items ordinal frames started)
    (if (eq (len items) 0) (list ordinal frames)
        (do
            (let current
                (lwsfle-emit-message (head items) ordinal started))
            (lwsfle-emit-items (tail items) (add ordinal 1)
                (add frames current) started))))

(do
    (let started
        (lcfb-open-stream "living-world-shared-field-live-encoder"
            "form-native" "lwsfle-world-stream"
            "chronological-canonical-cell-stream"
            "form/form-stdlib/tests/living-world-shared-field-live-encoder.fk"
            185 9))
    (let stream (lwsfle-world-stream))
    (let open-frames (lwsfle-emit-message (lwsfle-open) 0 started))
    (let entries
        (lwsfle-emit-items (nth stream 1) 1 open-frames started))
    (let request-ordinal (nth entries 0))
    (let request-frames
        (lwsfle-emit-message
            (lwsfle-request-entry) request-ordinal started))
    (let close-ordinal (add request-ordinal 1))
    (let close-frames
        (lwsfle-emit-message (lwsflw-close) close-ordinal started))
    (print_str
        (lcfb-cat (list
            "sender-complete|schema=v1|messages:"
            (int_to_str (add close-ordinal 1))
            ":frames:" (int_to_str
                (add (nth entries 1)
                    (add request-frames close-frames))))))
    (add close-ordinal 1))
