; preludes: form-stdlib/native-lora-checkpoint.bml form-stdlib/tests/native-llama-fixture.bml
(do
 (defn nlcb-compare (rows index)
  (if (nil? rows) 1
   (do (let row (head rows))
    (let mapped (nam-floats (sti-map index (head row))))
    (let expected (metal_buf_read (nth row 1) 0 (nlc-bytes row)))
    (let actual (metal_buf_read mapped 0 (nlc-bytes row)))
    (let same (str_eq expected actual))
    (nam-free (list mapped))
    (and same (nlcb-compare (tail rows) index)))))
 (let m (nlf-model)) (let ctx (nll-context m 8)) (let state (nlb-state m))
 (let r (nll-forward m ctx (list 1 5 9 12) 0 1))
 (let loss (nlb-backward m r (list 5 9 12 17) state 1.0))
 (nll-forward-close r)
 (nlb-adam state 0.0001 1 1.0)
 (nam-sync)
 (let path (str_concat "/tmp/native-lora-checkpoint-" (int_to_str (host_pid))))
 (let rows (append (nlc-adapter-rows (nlb-pairs (nth m 1))) (nlc-optimizer-rows state)))
 (let saved (nlc-save path rows "fixture" 1))
 (let index (sti-open path))
 (let matched (nlcb-compare rows index))
 (nlb-state-close state) (nll-context-close ctx) (nll-close m)
 (fs-remove-file path)
 (print (list "saved" saved "reload-equal" matched "live" (nth (metal_live) 2)))
 (if (and matched (eq (nth (metal_live) 2) 0)) 3 (form_error "native checkpoint roundtrip refused")))
