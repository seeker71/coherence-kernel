; form-glass-recipes-band.fk — where a kernel's dispatches actually go.
;
; The crossing lens folds what goes over the membrane; this one folds what
; happens inside a kernel, over the same histogram doors. It became possible an
; hour before it was written: every profiling door answered at most sixty-four
; rows and said nothing about the cut, so the distribution could not be seen —
; only its head, mistaken for the whole.
;
; The bit that matters most is 64. A reading that says "no single door will move
; this" is as useful as one that names a door, and a lens that can only find
; hotspots will invent them.
;
; Expected: 255
;
;   1    a page row carries heat, name, unit, line, column, boxes, unboxes, the
;        JIT lane, mints and folds, and the lane number reads as its own name
;   2    mass is the total heat, and a prefix of the rows is a prefix of it
;   4    share is parts per thousand, and a whole of nothing answers 0 rather
;        than dividing by it
;   8    concentration reads the curve at 1, 8, 64 and 256, and those shares
;        never decrease — a prefix cannot carry less than a shorter prefix
;   16   BY UNIT: dispatch mass per file, so a reading names a door and not a
;        symbol, and the units partition the total
;   32   BY LANE: walking, leaf, loop, twin, declined — the only histogram that
;        names leverage, since heat in a crystallized body is already spent
;   64   a FLAT body reads flat: eight recipes of equal heat carry eight parts
;        in a thousand of a thousand-recipe kernel, and nothing here calls that
;        a hotspot. The lens must be able to say there is nothing to optimise.
;   128  a REAL kernel: this process reads its own page whole, and the recipes
;        it just dispatched are in it with their real units
;
; preludes: form/form-stdlib/form-glass-recipes.bml

(do
    (defn xb (ok bit) (if ok bit 0))
    (defn row (heat name unit native boxes folds) (list heat name unit 1 1 boxes 0 native 0 folds))
    (defn flat (n acc) (if (eq n 0) acc (flat (sub n 1) (cons (row 1 "even" "u.fk" 0 0 0) acc))))

    (let a (row 800 "hot.one" "a.bml" 0 5 0))
    (let b (row 100 "hot.two" "a.bml" 2 0 7))
    (let c (row 60 "hot.three" "b.fk" -1 0 0))
    (let d (row 40 "hot.four" "b.fk" 3 0 0))
    (let rs (list a b c d))

    (let b1 (xb (and (eq (fgr-heat a) 800)
              (and (str_eq (fgr-name a) "hot.one")
              (and (str_eq (fgr-unit a) "a.bml")
              (and (eq (fgr-boxes a) 5)
              (and (eq (fgr-folds b) 7)
              (and (eq (fgr-row? a) 1)
              (and (eq (fgr-row? (list 1 2)) 0)
              (and (str_eq (fgr-lane a) "walking")
              (and (str_eq (fgr-lane b) "loop")
              (and (str_eq (fgr-lane c) "declined")
              (and (str_eq (fgr-lane d) "twin")
              (and (eq (fgr-crystallized? a) 0)
                   (eq (fgr-crystallized? d) 1))))))))))))) 1))

    (let b2 (xb (and (eq (fgr-mass rs) 1000)
              (and (eq (fgr-mass (fgr-take rs 2)) 900)
              (and (eq (fgr-mass (list)) 0)
              (and (eq (len (fgr-take rs 99)) 4)
                   (eq (len (fgr-take rs 0)) 0))))) 2))

    (let b3 (xb (and (eq (fgr-share 800 1000) 800)
              (and (eq (fgr-share 1 1000) 1)
              (and (eq (fgr-share 5 0) 0)
                   (eq (fgr-share 0 1000) 0)))) 4))

    (let conc (fgr-concentration rs))
    (let b4 (xb (and (eq (fgr-conc-recipes conc) 4)
              (and (eq (fgr-conc-mass conc) 1000)
              (and (eq (fgr-conc-top1 conc) 800)
              (and (eq (fgr-conc-top8 conc) 1000)
              (and (eq (fgr-head-share conc) 1000)
              (and (le (fgr-conc-top1 conc) (fgr-conc-top8 conc))
              (and (le (fgr-conc-top8 conc) (fgr-conc-top64 conc))
                   (le (fgr-conc-top64 conc) (fgr-conc-top256 conc)))))))))  8))

    (let byUnit (fgr-by-unit rs (list)))
    (let b5 (xb (and (eq (fgx-bin-of byUnit "a.bml") 900)
              (and (eq (fgx-bin-of byUnit "b.fk") 100)
              (and (eq (fgx-total byUnit) (fgr-mass rs))
              (and (eq (len byUnit) 2)
                   (str_eq (fgx-bin-label (fgx-largest byUnit (list))) "a.bml")))))  16))

    (let byLane (fgr-by-lane rs (list)))
    (let b6 (xb (and (eq (fgx-bin-of byLane "walking") 800)
              (and (eq (fgx-bin-of byLane "loop") 100)
              (and (eq (fgx-bin-of byLane "declined") 60)
              (and (eq (fgx-bin-of byLane "twin") 40)
              (and (eq (fgx-total byLane) (fgr-mass rs))
              (and (eq (fgr-walking-mass rs) 860)
              (and (eq (fgr-walking-share rs) 860)
              (and (str_eq (fgr-name (fgr-attention rs)) "hot.one")
                   (eq (fgr-box-mass rs) 5)))))))))  32))

    ; a body with no head reads as one: a thousand recipes of equal heat
    (let even (flat 1000 (list)))
    (let flatConc (fgr-concentration even))
    (let b7 (xb (and (eq (fgr-conc-mass flatConc) 1000)
              (and (eq (fgr-conc-top1 flatConc) 1)
              (and (eq (fgr-head-share flatConc) 8)
              (and (eq (fgr-conc-top64 flatConc) 64)
                   (eq (fgr-conc-top256 flatConc) 256))))) 64))

    ; ---- this process reads its own page whole
    (defn spin (n acc) (if (eq n 0) acc (spin (sub n 1) (add acc n))))
    (let burn (spin 4000 0))
    (let mine (fgr-of-self))
    (let mineConc (fgr-concentration mine))
    (let b8 (xb (and (gt (len mine) 0)
              (and (eq (fgr-conc-recipes mineConc) (len mine))
              (and (gt (fgr-conc-mass mineConc) 0)
              (and (gt (fgr-heat (head mine)) 0)
              (and (gt (str_len (fgr-unit (head mine))) 0)
                   (le (fgr-conc-top1 mineConc) 1000)))))) 128))

    (print (list "recipes" (fgr-conc-recipes mineConc) "mass" (fgr-conc-mass mineConc)
                 "top1" (fgr-conc-top1 mineConc) "head-share" (fgr-head-share mineConc)
                 "walking-share" (fgr-walking-share mine)))
    (sum (list b1 b2 b3 b4 b5 b6 b7 b8)))
