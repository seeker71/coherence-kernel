; kernel-http-header-band.fk — the focused runtime HTTP header row/lookup.
;
; The artifact fetch door consumes exactly these rows from `http_get`.  This
; band keeps tag 43001, name/value positions, ASCII-only case folding, recursive
; first-match selection, absence/default, and presence observations distinct.
;
; preludes: form-stdlib/core.fk form-stdlib/kernel-http-header.fk
;
; Verdict 255 when the focused surface preserves the kernel-http contract.

(do
    (let first (kh-header "Location" "first"))
    (let headers
        (list first
              (kh-header "location" "second")
              (kh-header "X-Linked-Size" "123")))
    (sum (list
        (if (and (eq (len first) 3)
                 (eq (nth first 0) 43001)) 1 0)
        (if (and (str_eq (kh-header-name first) "Location")
                 (str_eq (kh-header-value first) "first")) 2 0)
        (if (and (eq (kh-header? first) 1)
                 (eq (kh-headers-valid? headers) 1)) 4 0)
        (if (str_eq (kh-header-value-or headers "LOCATION" "missing")
                    "first") 8 0)
        (if (str_eq (kh-header-value-or headers "x-linked-size" "missing")
                    "123") 16 0)
        (if (str_eq (kh-header-value-or headers "ETag" "missing")
                    "missing") 32 0)
        (if (and (eq (kh-header-present? headers "location") 1)
                 (eq (kh-header-present? headers "etag") 0)) 64 0)
        (if (and (str_eq (kh-header-observation headers "") "not-required")
                 (and (str_eq (kh-header-observation headers "LOCATION") "present")
                      (str_eq (kh-header-observation headers "ETag") "missing")))
            128 0))))
