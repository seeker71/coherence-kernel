; ds4-paris-probe-band.fk — the probe's verdict, and the two exits recorded so
; neither is inherited again.
;
; preludes: form-stdlib/core.fk form-stdlib/ds4-paris-probe.fk
;
; run: ./fkwu --src form/form-stdlib/tests/ds4-paris-probe-band.fk   ; -> 127
;
; Verdict 127. This band goes GREEN on a WITHDRAWN finding — it records that the
; that is deliberate: the band's job is to record a witnessed observation, not to
; be happy about it. A band that could only pass on good news would have to be
; edited before bad news could be stated, which is how bad news gets deferred.

(do
    (defn dpb-score (ok bit) (if ok bit 0))
    (defn ds4-paris-probe-band ()
        (do
    ; the prompt is five tokens and they are the ones the tokenizer produced
    (let c0 (dpb-score (eq (len (dpp-prompt-ids)) 5) 1))
    ; four emissions were observed
    (let c1 (dpb-score (eq (len (dpp-observed)) 4) 2))
    ; THE FINDING: a placeholder special token appears among them
    (let c2 (dpb-score (eq (dpp-emitted-placeholder?) 1) 4))
    ; the OBSERVATION stands and the INFERENCE does not — both asserted, because
    ; a probe that recorded only the observation would keep reading as a verdict
    ; the finding, RE-established: the confound was removed rather than argued
    ; away — a correct prompt was assembled by id and run, and the output did not
    ; improve. Both halves asserted, because "defect established" without
    ; "confound removed" is the claim I had to withdraw once already.
    (let c3 (dpb-score (if (eq (dpp-observation-stands?) 1)
                           (if (eq (dpp-forward-defect-established?) 1)
                               (if (eq (dpp-confounded-by-prompt-form?) 0)
                                   (eq (dpp-correct-prompt-run?) 1) 0) 0) 0) 8))
    ; EXIT ONE, tested: the engine exists and refuses this file. Both halves are
    ; asserted, because "it is built" and "it cannot run this" are different
    ; facts and the receipt that conflated them cost a week of unfalsifiability.
    (let c4 (dpb-score (if (eq (dpp-ds4-engine-built?) 1)
                           (eq (dpp-ds4-engine-runs-file?) 0) 0) 16))
    ; EXIT TWO: a behavioural oracle needs no implementation
    (let c5 (dpb-score (eq (dpp-behavioural-oracle-available?) 1) 32))
    ; OUR OWN defects, recorded beside the model's: the encoder cannot emit
    ; specials, the renderer drops 3-byte UTF-8, and a round trip cannot catch
    ; either because both halves share the mapping.
    (let c6 (dpb-score (if (eq (dpp-tokenizer-handles-specials?) 0)
                           (if (eq (dpp-renderer-utf8-3byte-ok?) 0)
                               (eq (dpp-roundtrip-can-validate-codec?) 0) 0) 0) 64))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6))))))))
    (ds4-paris-probe-band))
