; host-exec-launch-honesty-band.fk — a host-exec whose sh NEVER LAUNCHED
; answers the axiom-1 nothing; "" is reserved for a command that RAN and spoke
; zero bytes; and MEASURING that nothing without asking nothing? first dies
; loud. Before 2026-08-27 both absences answered "" (the silent-partial family
; on the exec side): under ulimit -u 100 with 485 live user procs, ten
; (host-exec "date +%s%N" "") calls answered ten empty strings rc 0, and
; observe/hot-crossing-run.fk's 10s await window silently closed in 0.008s
; (PR #542 diagnosis). Later the same day the second layer healed: str_len
; over nothing had answered a counterfeit 0, dressing a vanished launch as
; "empty" one door up — silent error hides illness — so measuring an absence
; now dies naming it, on fkwu and Go alike.
;
; This band starves fork for real — ulimit -u 1 in the door shell, exec so no
; fork stands between the limit and the probe — and reads both truths from
; inside the starved kernel: observe/host-exec-starved-probe.fk names the
; nothing; observe/host-exec-starved-measure-probe.fk measures it unguarded
; and dies, and the death's own words cross back through the captured stderr
; (rc cannot travel through popen, the spoken illness can).
;
; PROOF LEVEL: FOURTH-ARM ONLY — Verdict 15; go answers 3 (witnessed 2026-09-03). host-exec binds on go and fkwu (pf-arm-mask
; 9), and the starvation legs drive the repo-root fkwu binary itself, so this
; band runs on its home arm:
;   ./fkwu form/form-stdlib/tests/host-exec-launch-honesty-band.fk
; The Go arm's twin witnesses are TestHostExecLaunchFailureAnswersNothing and
; TestStrLenOfNothingDiesLoud (form/form-kernel-go/hostexec_test.go). jitabi
; carries no host-exec seat — the Go JIT leaves natives to the interpreter
; ("Natives we don't support in the compiled body", jit.go) — so these heals
; cover every seat.
;
; Bits (power-of-two weights):
;   1  empty speech stays a string: (host-exec "printf ''") is NOT nothing, len 0
;   2  real speech crosses: (host-exec "printf hx-tok") answers "hx-tok"
;   4  starved launch answers nothing (probe answers 1)
;   8  unguarded measurement of the starved answer dies loud: the captured
;      death message carries "no length"
; witnessed: 2026-08-27 -> 15
(do
    (defn hxb-digit? (b) (if (and (ge b 48) (le b 57)) 1 0))
    (defn hxb-int (s i n acc)
        (if (ge i n) acc
            (do (let b (str_byte_at s i))
                (if (eq (hxb-digit? b) 1)
                    (hxb-int s (add i 1) n (add (mul acc 10) (sub b 48)))
                    acc))))
    (defn hxb-match (s i pat j n m)
        (if (ge j m) 1
            (if (ge (add i j) n) 0
                (if (eq (str_byte_at s (add i j)) (str_byte_at pat j))
                    (hxb-match s i pat (add j 1) n m)
                    0))))
    (defn hxb-find (s pat i n m)
        (if (gt (add i m) n) 0
            (if (eq (hxb-match s i pat 0 n m) 1) 1
                (hxb-find s pat (add i 1) n m))))
    (defn hxb-has (s pat)
        (if (nothing? s) 0
            (hxb-find s pat 0 (str_len s) (str_len pat))))

    (let r0 (host-exec "printf ''" ""))
    (let c0 (if (nothing? r0) 0
                (if (and (eq (nothing? r0) 0) (eq (str_len r0) 0)) 1 0)))

    (let r1 (host-exec "printf hx-tok" ""))
    (let c1 (if (nothing? r1) 0
                (if (eq (str_eq r1 "hx-tok") 1) 2 0)))

    (let tok (host-exec
        "ulimit -u 1; exec ./fkwu observe/host-exec-starved-probe.fk 2>/dev/null" ""))
    (let n (if (nothing? tok) 0 (hxb-int tok 0 (str_len tok) 0)))
    (let c2 (if (eq n 1) 4 0))

    (let tok2 (host-exec
        "ulimit -u 1; exec ./fkwu observe/host-exec-starved-measure-probe.fk 2>&1" ""))
    (let c3 (if (eq (hxb-has tok2 "no length") 1) 8 0))

    (add c0 (add c1 (add c2 c3))))
