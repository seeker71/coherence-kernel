; living-world-recipe-tree-relation-prospective-band.fk -- 31 checks for a
; fresh, identity-aligned, relation-aware quality movement with local revocation.
; target: 2147483647
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/living-world-recipe-tree-revision-trial.fk form-stdlib/living-world-recipe-tree-revision-hypothesis.fk form-stdlib/living-world-recipe-tree-revision-prospective.fk form-stdlib/living-world-recipe-tree-relation-nursery.fk form-stdlib/living-world-recipe-tree-relation-offer.fk form-stdlib/living-world-recipe-tree-relation-prospective.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk form-stdlib/tests/living-world-recipe-tree-relation-prospective-witness.fk

(defn lwrrpb-bit (ok bit) (if ok bit 0))

(defn lwrrpb-run ()
    (do
        (let result (lwrrpw-run))
        (let children (node_children result))
        (let parent (nth children 1))
        (let relation (nth children 2))
        (let relations (nth children 3))
        (let suite (nth children 4))
        (let one-world (nth children 5))
        (let one-evaluation (nth children 6))
        (let two-world (nth children 7))
        (let suite-sources (nth children 8))
        (let baseline (nth children 12))
        (let related (nth children 13))
        (let comparison (nth children 14))
        (let revoked-world (nth children 15))
        (let revoked-evaluation (nth children 16))
        (let events (nth children 20))
        (let baseline-metrics (lwps-evaluation-metrics baseline))
        (let related-metrics (lwps-evaluation-metrics related))
        (let delta (lwps-delta-values (lwps-comparison-delta comparison)))
        (let composition (lwps-evaluation-candidate related))
        (let cases (lwo-field-items (lwrrpw-cases)))
        (let pending-case (nth cases 3))
        (let condensed-case (nth cases 4))
        (let related-placements
            (lwo-field-items (lwps-evaluation-placements related)))
        (let relation-placement (nth related-placements 2))
        (let recipe
            (lwrrn-trial-recipe
                (lwrro-choice-trial (lwo-emergent-shape relation))))
        (sum (list
            (lwrrpb-bit
                (eq (lwo-category? composition LWRRP-COMPOSITION) 1) 1)
            (lwrrpb-bit
                (and (node_eq
                        (lwrrp-composition-candidate composition) parent)
                     (node_eq
                        (lwrrp-composition-relations composition) relations)) 2)
            (lwrrpb-bit (eq (lwps-suite-shape-valid? suite) 1) 4)
            (lwrrpb-bit
                (eq (lwps-split-shape-valid? (lwps-suite-split suite)) 1) 8)
            (lwrrpb-bit
                (and (eq (lwps-suite-current? one-world suite 2) 0)
                     (node_eq one-evaluation (lwo-none))) 16)
            (lwrrpb-bit (eq (lwo-field-size suite-sources) 2) 32)
            (lwrrpb-bit (eq (node_value (nth children 9)) 1) 64)
            (lwrrpb-bit
                (eq (lwo-field-size
                    (lwrrp-history-bindings parent relations)) 13) 128)
            (lwrrpb-bit
                (eq (lwo-field-size
                    (lwps-split-prospective (lwps-suite-split suite))) 5) 256)
            (lwrrpb-bit (eq (node_value (nth children 10)) 1) 512)
            (lwrrpb-bit (eq (node_value (nth children 11)) 1) 1024)
            (lwrrpb-bit
                (and (eq (lwps-evaluation? baseline) 1)
                     (eq (lwps-evaluation? related) 1)) 2048)
            (lwrrpb-bit
                (node_eq (lwps-evaluation-dataset baseline)
                    (lwps-evaluation-dataset related)) 4096)
            (lwrrpb-bit
                (node_eq (lwps-evaluation-split baseline)
                    (lwps-evaluation-split related)) 8192)
            (lwrrpb-bit
                (node_eq (lwps-evaluation-contract baseline)
                    (lwps-evaluation-contract related)) 16384)
            (lwrrpb-bit
                (eq (lwps-comparison-admissible comparison) 1) 32768)
            (lwrrpb-bit
                (eq (lwps-comparison-repeated comparison) 0) 65536)
            (lwrrpb-bit
                (and (eq (lwps-metrics-value baseline-metrics 0) 5)
                     (eq (lwps-metrics-value baseline-metrics 1) 3)) 131072)
            (lwrrpb-bit
                (and (eq (lwps-metrics-value baseline-metrics 2) 2)
                     (and (eq (lwps-metrics-value baseline-metrics 3) 0)
                          (eq (lwps-metrics-value baseline-metrics 4) 1)))
                262144)
            (lwrrpb-bit
                (and (eq (lwps-metrics-value related-metrics 0) 5)
                     (eq (lwps-metrics-value related-metrics 1) 3)) 524288)
            (lwrrpb-bit
                (and (eq (lwps-metrics-value related-metrics 2) 3)
                     (and (eq (lwps-metrics-value related-metrics 3) 0)
                          (eq (lwps-metrics-value related-metrics 4) 0)))
                1048576)
            (lwrrpb-bit
                (and (eq (nth delta 2) 1)
                     (and (eq (nth delta 3) 0)
                          (eq (nth delta 4) (sub 0 1)))) 2097152)
            (lwrrpb-bit
                (not (node_eq (lwps-evaluation-candidate baseline)
                        (lwps-evaluation-candidate related))) 4194304)
            (lwrrpb-bit
                (and (eq (oac-nothing?
                            (lwps-case-immediate pending-case)) 1)
                     (eq (oac-time-pending?
                            (lwps-case-time pending-case)) 1)) 8388608)
            (lwrrpb-bit
                (and (eq (oac-time-outcome?
                            (lwps-case-time condensed-case)) 1)
                     (eq (oac-alternative-ack?
                            (oac-time-outcome-ack
                                (lwps-case-time condensed-case))) 1))
                16777216)
            (lwrrpb-bit
                (and (eq (lwrrp-relation-applies? relation (nth cases 0)) 0)
                     (and (eq (lwrrp-relation-applies?
                                relation (nth cases 1)) 0)
                          (eq (lwrrp-relation-applies?
                                relation (nth cases 2)) 1))) 33554432)
            (lwrrpb-bit
                (and (eq (lwo-field-size
                            (lwps-placement-derivations
                                relation-placement)) 1)
                     (and (eq (lwo-field-size
                                (lwps-placement-outputs
                                    relation-placement)) 1)
                          (eq (lwo-field-size
                                (lwps-placement-matches
                                    relation-placement)) 1))) 67108864)
            (lwrrpb-bit
                (and (eq (lwo-active? two-world relation) 1)
                     (and (eq (lwo-active? two-world recipe) 0)
                          (eq (node_value (nth children 19)) 0))) 134217728)
            (lwrrpb-bit
                (and (node_eq revoked-evaluation (lwo-none))
                     (eq (lwo-active? revoked-world relation) 0)) 268435456)
            (lwrrpb-bit
                (and (eq (node_value (nth children 17)) 1)
                     (eq (node_value (nth children 18)) 1)) 536870912)
            (lwrrpb-bit
                (and (eq (len events) 10)
                     (and (eq (lwps-metrics-value related-metrics 6) 2)
                          (and (eq (lwps-metrics-value related-metrics 7) 1)
                               (eq (lwps-metrics-value related-metrics 8) 1))))
                1073741824)))))

; witnessed: 2026-08-09 -> 2147483647 (31/31) on fkwu
(lwrrpb-run)
