; Exact CPU-native frame fold, explicit subdivision and resident lifecycle.
; Expected 65535 on the ARM64 fkwu RAM leaf carrier.
; preludes: form-stdlib/bml/frame-cpu.bml form-stdlib/tests/frame-luma-fixture.fk
(do
 (defn fcb-equal (a b)
  (if (or (nothing? a) (nothing? b)) 0
   (if (not (eq (len a) (len b))) 0
    (if (nil? a) 1 (and (eq (head a) (head b)) (fcb-equal (tail a) (tail b)))))))
 (defn fcb-case (version width height policy)
  (do (let bytes (flmb-colored width height))
      (fcb-equal (fc-stat version (fc-capture bytes) policy) (flm-stat-policy bytes policy))))
 (defn fcb-cases (version widths)
  (if (nil? widths) 1
   (and (fcb-case version (head widths) 3 (flm-default-policy))
    (and (fcb-case version (head widths) -3 (list 128 0 100 0))
         (fcb-cases version (tail widths))))))
 (defn fcb-le8 (value n)
  (if (eq n 0) (list) (cons (mod value 256) (fcb-le8 (div value 256) (sub n 1)))))
 (let version (fc-open "frame-cpu-band-main-v1" (fc-max-pixels)))
 (let split (fc-open "frame-cpu-band-split-v1" 5))
 (let bytes (flmb-bmp -1))
 (let capture (fc-capture bytes))
 (let old (fc-stat version capture (flm-default-policy)))
 (let calls-before (kernel_stat 47))
 (let repeated (fc-stat version capture (flm-default-policy)))
 (let calls-after (kernel_stat 47))
 (let dark-bytes (flmb-uniform 6 3 0))
 (let dark-rectangle (fc-rect version dark-bytes 54 20 0 6 3 60))
 (let boundary-image (fa-image (list (fa-mov-imm64 0 (fcb-le8 (fc-packed-bound) 8)) (fa-ret))))
 (let boundary-return (jit_leaf_inram boundary-image 0))
 (let refused (and (nothing? (fc-capture (nothing)))
    (and (nothing? (fc-capture ""))
     (and (nothing? (fc-capture (substring bytes 0 73)))
          (nothing? (fc-capture (flmb-header 2147483647 -2147483648 0 0)))))))
 (let policy-refused (and (nothing? (fc-stat version capture (list 60 -1 75 12)))
     (nothing? (fc-stat version capture (list 60.5 8 75 12)))))
 (let capture-checked (and (nothing? (fc-stat version 7 (flm-default-policy)))
   (and (nothing? (fc-stat version (list "" (list 0 0 999 999 999)) (flm-default-policy)))
    (fcb-equal (fc-stat version (list bytes (list 0 0 999 999 999)) (flm-default-policy)) old))))
 (let base-cases (fcb-cases version (list 1 2 3 4 5 6)))
 (let split-cases (fcb-cases split (list 1 2 3 4 5 6)))
 (let boundary-cases (and (fcb-case version 1023 2 (flm-default-policy))
   (and (fcb-case version 1024 -2 (flm-default-policy))
        (fcb-case version 1025 2 (list 255 0 100 0)))))
 (let large (flmb-uniform 1024 342 120))
 (let large-result (fc-stat version (fc-capture large) (flm-default-policy)))
 (let retained (fc-stat version capture (flm-default-policy)))
 (let released (fc-release version))
 (let double-release (fc-release version))
 (let stale (fc-stat version capture (flm-default-policy)))
 (let dead-request (jit_leaf_inram (record_get version "request") 0))
 (let split-still-live (fc-stat split capture (flm-default-policy)))
 (let fresh (fc-open "frame-cpu-band-fresh-v1" (fc-max-pixels)))
 (let fresh-result (fc-stat fresh capture (flm-default-policy)))
 (let release-fresh (fc-release fresh))
 (let release-split (fc-release split))
 (sum (list
  (if (and (record? version) (record? split)) 1 0)
  (if (eq (len (fc-image)) 144) 2 0)
  (if base-cases 4 0)
  (if split-cases 8 0)
  (if boundary-cases 16 0)
  (if (and (fcb-equal old (flm-stat bytes)) (fcb-equal repeated old)) 32 0)
  (if (eq (sub calls-after calls-before) 3) 64 0)
  (if (fcb-equal dark-rectangle (list 0 18)) 128 0)
  (if (and (eq boundary-return (fc-packed-bound))
           (lt boundary-return 4611686018427387903)) 256 0)
  (if (and refused capture-checked) 512 0)
  (if policy-refused 1024 0)
  (if (and (eq released 1) (and (eq double-release 0)
           (and (nothing? stale) (nothing? dead-request)))) 2048 0)
  (if (and (fcb-equal split-still-live old) (eq release-split 1)) 4096 0)
  (if (and (fcb-equal fresh-result old) (eq release-fresh 1)) 8192 0)
  (if (and (nothing? (fc-open "invalid-cap-zero" 0))
       (and (nothing? (fc-open "invalid-cap-wide" (add (fc-max-pixels) 1)))
            (and (nothing? (fc-open "invalid-cap-float" 2.5))
                 (nothing? (fc-open 123 5))))) 16384 0)
  (if (and (fcb-equal large-result (list 0 0 120 0 120 120 120 1024 342))
           (fcb-equal retained old)) 32768 0))))
