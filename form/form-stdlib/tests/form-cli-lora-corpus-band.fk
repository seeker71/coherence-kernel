; form-cli-lora-corpus-band.fk — enough lens-lane samples; fqt-lora? stays 0.
;
; Verdict 1023:
;   1..128  flc-check (n=1152, train/heldout, dim 64, fqt-lora=0, path, scale-20-5, adapter path)
;   256     class descriptor FormLoraCorpus minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-lens-mint-xtal.fk
; preludes: form-stdlib/form-cli-lora-corpus-xtal.fk
; witnessed: 2026-08-26 -> 1023; n=1152 unique-2-1=216 leakage 0; corpus gitignored; fqt-lora=0

(do
    (defn flcb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn flcb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (flcb-has-name? (tail xs) name))))

    (let bits (flc-check))
    (let probe (fls-corpus 2 1))
    (let probe-ok (and (eq (fls-n 12 4) 1152)
                       (and (eq (fls-unique probe) 216)
                            (eq (fls-leakage probe) 0))))
    (let desc (FormLoraCorpus))
    (let src (read_file "form/form-stdlib/bml/form-cli-lora-corpus.bml"))
    (let exe (read_file "form/form-stdlib/form-cli-lora-corpus.bml"))
    (let b8 (if (and probe-ok
                     (and (str_eq (nth desc 1) "FormLoraCorpus")
                          (and (eq (flcb-has-name? (nth desc 2) "T") 1)
                               (and (eq (flcb-has-name? (nth desc 3) "flc-n") 1)
                                    (eq (flcb-has-name? (nth desc 4) "TrainN") 1)))))
                256 0))
    (let b9 (if (and (eq (flcb-has-str? src "package Form.cli.loracorpus") 1)
                     (and (eq (flcb-has-str? src "interface ILoraCorpus") 1)
                          (and (eq (flcb-has-str? src "class FormLoraCorpus") 1)
                               (and (eq (flcb-has-str? src "const int TrainN") 1)
                                    (and (eq (flcb-has-str? src "template SampleRow") 1)
                                         (and (eq (flcb-has-str? exe "heldout-v3") 0)
                                              (eq (flcb-has-str? exe "turn_started") 0)))))))
                512 0))
    (add bits (add b8 b9)))
