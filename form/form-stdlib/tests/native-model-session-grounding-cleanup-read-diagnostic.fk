; Public three-process filesystem diagnostic, phase 3: a fresh evaluator
; observes existence, directory kind, and immediate entry count.
; preludes: form-stdlib/form-fs.fk

(do
    (let root
        (fs-path-join (fs-temp-dir)
            "native-model-session-grounding-cleanup-diagnostic-1786205299000"))
    (list (fs-exists? root) (fs-is-dir? root) (len (fs-list root))))
