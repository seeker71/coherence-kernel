; form-cli-lane-mint-band.fk — every skill on every query lane; overlay fits the lane.
;
; Verdict 1023:
;   1..128  fln-check (n=738, mix, leakage, unique, split, heldout>=328, lora-writer=0, covers-all)
;   256     class descriptor FormLaneMint minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-lane-mint-xtal.fk
; witnessed: 2026-08-26 -> 1023; cartesian 41x9, n=738 unique leakage 0, heldout 356/369, covers-all; lora-writer 0

(do
    (defn flnb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn flnb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (flnb-has-name? (tail xs) name))))

    (let bits (fln-check))
    (let desc (FormLaneMint))
    (let src (read_file "form/form-stdlib/bml/form-cli-lane-mint.bml"))
    (let exe (read_file "form/form-stdlib/form-cli-lane-mint.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormLaneMint")
                     (and (eq (flnb-has-name? (nth desc 2) "T") 1)
                          (and (eq (flnb-has-name? (nth desc 3) "fln-corpus") 1)
                               (eq (flnb-has-name? (nth desc 4) "MixA") 1))))
                256 0))
    (let b9 (if (and (eq (flnb-has-str? src "package Form.cli.lanemint") 1)
                     (and (eq (flnb-has-str? src "interface ILaneMint") 1)
                          (and (eq (flnb-has-str? src "class FormLaneMint") 1)
                               (and (eq (flnb-has-str? src "const int MixA") 1)
                                    (and (eq (flnb-has-str? src "template SampleRow") 1)
                                         (and (eq (flnb-has-str? exe "heldout-v3") 0)
                                              (eq (flnb-has-str? exe "turn_started") 0)))))))
                512 0))
    (add bits (add b8 b9)))
