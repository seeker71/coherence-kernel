; tests/source-compiler-runtime.fk - source sections compile inside Form runtime
;
; A BMF section compiles to executable Form text: the dialect's rule table
; and its section registration, as the top-level forms fkwu compiles. The
; compiled text is the program itself; no recipe image is loaded.
;
; preludes: form-stdlib/form-ontology-bp.fk form-stdlib/source-compiler.fk

section [form.action] {
    let quote = "\"";
    let rule-source = str_concat("[bml.bmf] {\n      field ::= $type:name $name:name ", str_concat(quote, str_concat(";", str_concat(quote, " => bml-emit-field;\n    }\n"))));
    let sample = str_concat("section ", rule-source);
    let out-path = str_concat(temp_dir(), "/form-test-source-compiler-runtime");
    let compiled = form-source-compile-text(sample, out-path);

    let rules-score = add(if fsc-contains?(compiled, str_concat("(let bml-bmf-rules (list (list ", str_concat(quote, str_concat("field", quote)))) then 10 else 0, if fsc-contains?(compiled, "bml-emit-field") then 20 else 0);
    let section-score = add(if fsc-contains?(compiled, str_concat("(let bml-bmf-second (form-bmf-second ", str_concat(quote, str_concat("bml", quote)))) then 30 else 0, if fsc-contains?(compiled, "read_form_binary") then 0 else 40);
    add(rules-score, section-score);
}
