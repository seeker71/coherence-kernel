; train-loop-rules-band.fk — every rule fires on the day it came from.
;
; The fixtures are 2026-08-26's own measured evaluations, as permille. A rule
; that cannot reproduce the decision actually taken that day is wrong about
; where it came from.
;
; Verdict 255 (8 bits):
;   1    the base model's state (fabricating) -> emit-nothing-rows
;   2    the 0.55-epoch state (format 1000, facts 0) -> train-more-epochs
;   4    the 9-epoch heldout state (facts 750) -> mint-coverage-rows
;   8    the post-nothing state (abstain 333) -> emit-calibration-rows
;   16   a healthy state (facts 917, abstain low) -> rest-and-fuse
;   32   an unmatched observation is NOTHING — the loop's own edge, and it is
;        a state no directive string could honestly name
;   64   fabrication outranks everything: a fabricating format-poor model
;        gets nothing-rows, not epochs
;   128  plateau: two liftless rounds say stop; one does not
;
; preludes: learn/train-loop-rules.fk

(do
    (defn tlrb-bit (ok bit) (if ok bit 0))
    (defn tlrb-is (o want) (if (str_eq (tlr-decide o) want) 1 0))
    (defn train-loop-rules-band ()
        (do
            (let base     (tlr-obs 200 0 667 0))
            (let halfep   (tlr-obs 1000 0 0 0))
            (let nineep   (tlr-obs 1000 750 0 0))
            (let postnoth (tlr-obs 1000 917 0 333))
            (let healthy  (tlr-obs 1000 917 0 100))
            (let weird    (tlr-obs 100 500 0 0))
            (sum (list
                (tlrb-bit (tlrb-is base (tlr-d-nothing-rows)) 1)
                (tlrb-bit (tlrb-is halfep (tlr-d-more-epochs)) 2)
                (tlrb-bit (tlrb-is nineep (tlr-d-coverage-rows)) 4)
                (tlrb-bit (tlrb-is postnoth (tlr-d-calibration-rows)) 8)
                (tlrb-bit (tlrb-is healthy (tlr-d-rest)) 16)
                (tlrb-bit (nothing? (tlr-decide weird)) 32)
                (tlrb-bit (tlrb-is (tlr-obs 100 0 667 0) (tlr-d-nothing-rows)) 64)
                (tlrb-bit (and (eq (tlr-plateau? halfep nineep postnoth) 0)
                               (eq (tlr-plateau? nineep (tlr-obs 1000 750 0 0)
                                                 (tlr-obs 1000 700 0 0)) 1)) 128)))))
    (train-loop-rules-band))
