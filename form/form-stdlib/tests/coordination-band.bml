; coordination-band.bml — who began a movement or a turn (form-stdlib/bml/coordination.bml): the one rule the movement
; door and the native turn both read their rows through.
;
; On 2026-10-29 a session began the movement "walk-here 2026-10-29" under nohup; its launcher ended, the kernel was
; reparented to launchd, and the movement, which took no "session" key, wrote coordinated_by host-schedule, coordinator
; /sbin/launchd, rented_mind 0, coordinating_rent 0 (receipts/crossings-ledger.jsonl, at_unix_ms 1793261028971): a rented coordination
; read as the host's own schedule, a row the goal's exit proof (docs/rent-to-zero-goal.form E1, E3: rented_mind in the
; crossings rows) would count as a movement no rented mind coordinated, its rent undercounted. The door now takes the
; caller's "session" and reads its coordination through the shared rule, the coordinator once, as it starts. No movement
; runs here (its voice takes about ninety minutes): the climb walks tables the band writes, the door's own row and line
; are built from them, and the doors are read through the compile-only door.
;
; Expected: 16383
; Verdict 16383 when every claim lands:
;   1     named + launchd: a session that names itself reads session and rented_mind 1 under launchd (a detached
;         launch), dependence unmeasured, and the coordinator stays what the table read (/sbin/launchd)
;   2     bare + launchd: the keeper that began a job the body names, with no session named, reads host-schedule,
;         rented_mind 0, dependence none; the keeper under no job named reads detached, rented_mind unknown (nothing,
;         null in the row), dependence unmeasured; bare + a terminal (Terminal, login, tmux: no rented agent in the line) is the person: person, rented_mind 0, dependence
;         none; a shell the climb stopped in reads unread with rented_mind 1
;   4     named + a session's parent: session, rented_mind 1
;   8     bare + a session's parent: session, rented_mind 1 (the table names the session's own binary)
;   16    the word only adds rent: a named session reads session and rented_mind 1 whatever the table read (launchd, a
;         session's binary, a shell, nothing), and the session pair is the one the caller gave
;   32    a table that did not answer: bare reads unread with rented_mind 1, named reads session
;   64    native-turn-run calls the shared rule: its source imports it, keeps no copy of it, reads crd-coordinator() once, as
;         it starts, before its request, and the door itself, run here over a scratch gap whose band reads full, lands rows
;         whose coordinated_by, coordinator, rented_mind, remote_dependence and session are what the rule answers for the
;         same request on this process's own table, bare and with a session named
;   128   the climb passes over fkwu, sh, zsh, bash and form-run: launchd -> fkwu -> sh -> fkwu reads /sbin/launchd, a
;         session's zsh -> bash -> fkwu reads the session's binary, a kernel reparented to pid 1 reads /sbin/launchd, a
;         chain of ten shells stops at the eighth hop, a parent the table does not hold reads "", and a rented agent
;         stands as the coordinator through what is not glue (claude -> zsh -> timeout -> fkwu reads claude)
;   256   the door's own coordination: named + launchd builds a crossings row of session, rented_mind 1, the session
;         id and a coordinating rent nobody read (null) and the line's node the same; bare + the walk's launcher builds
;         host-schedule, 0, 0 with no session; bare + launchd under no job builds detached with rented_mind and
;         coordinating rent null; the door reads crd-coordinator() once, before its request, and keeps no climb of its own
;   512   the coordinating rent: a named session's transcript reads its last turn's uncached tokens (input, cache
;         write, output); a transcript not given, or one that does not read, is nothing (null), never 0 and never -1;
;         the schedule's job spends 0 and a detached line spends what nobody read (null)
;   1024  both doors lower: observe/movement-run.bml and observe/native-turn-run.bml compile clean through the
;         compile-only door (cell_run(path, 0, "check", nothing()))
;   2048  ancestries, each read as coordinated_by / rented_mind / the session word lrun-session writes:
;           the walk launcher (launchd -> launch/fkwu launch/walk-launch.fk <door> -> ./fkwu <door> -> sh -> fkwu)
;                                                                  host-schedule  0        ""
;           sandbox-exec under the walk (... -> ./fkwu <door> -> sandbox-exec -> fkwu)
;                                                                  host-schedule  0        ""   (offline-exam when the exam's door began it)
;           a terminal (Terminal -> login -> zsh -> fkwu)          person         0        ""
;           a terminal running claude (... -> zsh -> claude -> zsh -> fkwu)
;                                                                  session        1        rented:claude   (its --resume id when it carries one)
;           claude -p (claude -p -> zsh -> bash -> fkwu)           session        1        rented:claude
;           timeout under a rented agent (claude --resume s -> zsh -> timeout -> fkwu)
;                                                                  session        1        s
;           nohup-detached to launchd (launchd -> ./fkwu <probe>), the walk's own door begun so, and the launcher's pair
;           named from a cwd it does not stand in                 detached       unknown  detached
;           a table that did not answer                           unread         1        unread
;   4096  every plist under docs/launchd names a job the rule reads: its ProgramArguments, begun by launchd in its
;         WorkingDirectory, read as the row the keeper began, name a job (crd-job-name), and a kernel under it reads
;         host-schedule; at least the four walk plists stand among them
;   8192  the landing the movement asks for (mv-land-request) carries the bands its caller named, as named, the queued gaps' bands the walk
;         hands every movement (host-walk-carry.bml hw-with-bands), and names none when the caller named none
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/coordination.bml observe/movement-run.bml observe/native-turn-run.bml
section [form.bml] {
 class CoordinationBand {
  def cdb-named() = parse-json("coordination-band", "{\"movement\":\"walk-here 2026-10-29\",\"session\":\"s-walk-here\",\"transcript\":\"\",\"land\":0}");
  def cdb-bare() = parse-json("coordination-band", "{\"movement\":\"walk-here 2026-10-29\",\"transcript\":\"\",\"land\":0}");
  def cdb-launchd() = "/sbin/launchd";
  def cdb-claude() = "/Applications/Claude.app/Contents/MacOS/claude";
  def cdb-emit(pairs) = json-emit(json-node-object(pairs));
  def cdb-str(node, key) = json-object-has?(node, key) ? json-string-value(json-object-get(node, key)) : "";
  def cdb-null?(node, key) = json-object-has?(node, key) && node_eq(json-object-get(node, key), json-node-null());
  def cdb-int(node, key) = json-object-has?(node, key) && !cdb-null?(node, key) ? json-int-value(json-object-get(node, key)) : nothing();
  // rented is 0, 1, or nothing() for unknown; the row's rented_mind is the same, null for unknown
  def cdb-rented-is?(x, want) = nothing?(want) ? nothing?(x) : !nothing?(x) && ((Comparable) x == want);
  def cdb-is?(opts, c, by, rented, dependence) {
   let who = json-node-object(crd-who(opts, c));
   ((String) crd-by(opts, c) == by) && cdb-rented-is?(crd-rented(opts, c), rented) && ((String) crd-dependence(opts, c) == dependence) && ((String) cdb-str(who, "coordinator") == crd-exe-of(c)) && (nothing?(rented) ? cdb-null?(who, "rented_mind") : (Comparable) cdb-int(who, "rented_mind") == rented);
  }
  def cdb-walk() = crd-reading(cdb-launchd(), "walk-launch");
  def cdb-c-named-launchd(ctx) = cdb-is?(cdb-named(), cdb-launchd(), "session", 1, "") && !crd-kept?(cdb-named(), cdb-launchd()) && cdb-is?(cdb-named(), cdb-walk(), "session", 1, "");
  def cdb-c-bare-launchd(ctx) = cdb-is?(cdb-bare(), cdb-walk(), "host-schedule", 0, "none") && crd-kept?(cdb-bare(), cdb-walk())
   && cdb-is?(cdb-bare(), cdb-launchd(), "detached", nothing(), "") && !crd-kept?(cdb-bare(), cdb-launchd()) && cdb-is?(cdb-bare(), crd-reading(cdb-launchd(), ""), "detached", nothing(), "")
   && all?(exe => cdb-is?(cdb-bare(), exe, "person", 0, "none"), ["/System/Applications/Utilities/Terminal.app/Contents/MacOS/Terminal", "/usr/bin/login", "/opt/homebrew/bin/tmux"])
   && cdb-is?(cdb-named(), "/usr/bin/login", "session", 1, "") && cdb-is?(cdb-bare(), "/bin/sh", "unread", 1, "");
  def cdb-c-named-session(ctx) = cdb-is?(cdb-named(), cdb-claude(), "session", 1, "");
  def cdb-c-bare-session(ctx) = cdb-is?(cdb-bare(), cdb-claude(), "session", 1, "");
  def cdb-c-word-adds(ctx) = all?(exe => cdb-is?(cdb-named(), exe, "session", 1, ""), [cdb-launchd(), cdb-claude(), "/bin/zsh", ""]) && ((String) cdb-emit(crd-session(cdb-named())) == "{\"session\":\"s-walk-here\"}") && nil?(crd-session(cdb-bare()));
  def cdb-c-unread(ctx) = cdb-is?(cdb-bare(), "", "unread", 1, "") && cdb-is?(cdb-named(), "", "session", 1, "");
  // the turn's own source: the rule imported, no copy of it kept, the coordinator read once, before the request
  def cdb-turn-copies() = ["nt-row-of", "nt-self", "nt-parent", "nt-exe", "nt-tail", "nt-base", "nt-glue?", "nt-climb", "nt-coordinator", "nt-keeper?", "nt-kept?", "nt-who", "nt-dependence", "nt-session"];
  def cdb-turn-calls?() {
   let src = read_file("observe/native-turn-run.bml") ?? "";
   let at = str_find(src, "let coordinator = crd-coordinator();", 0);
   (str_find(src, "import form-stdlib/bml/coordination.bml;", 0) >= 0) && (cdb-count(src, "crd-coordinator()", 0) == 1) && (at >= 0) && (at < str_find(src, "let input = cell_input();", 0)) && all?(name => str_find(src, "def " ++ name ++ "(", 0) < 0, cdb-turn-copies());
  }
  // the door run in this process over a scratch gap whose band reads full: the row it lands, read back from its ledger
  def cdb-turn-row(dir, name, pairs) {
   let band = dir ++ "/b.bml";
   let writable = dir ++ "/w.bml";
   let queue = dir ++ "/q.jsonl";
   let ledger = dir ++ "/" ++ name ++ ".jsonl";
   let w1 = write_file_text(writable, "section [form.bml] {\n class CdbWritableZz {\n  def cwz-x() = 1;\n }\n 0;\n}\n");
   let w2 = write_file_text(band, "; Verdict 3\nsection [form.bml] {\n class CdbBandZz {\n  def cbz-go() = 3;\n }\n cbz-go();\n}\n");
   let w3 = write_file_text(queue, cdb-emit([fhn-s("id", "cdb-gap"), fhn-s("goal", "read three"), json-node-pair("writable", json-node-array([json-node-string(writable)])), fhn-s("band", band), fhn-n("full", 3)]) ++ "\n");
   let opts = append([fhn-s("queue", queue), fhn-s("ledger", ledger), json-node-pair("ways", json-node-array([json-node-string("native")]))], pairs);
   let rec = cell_run("observe/native-turn-run.bml", 0, nothing(), [cdb-emit(opts)]);
   nt-rows(ledger);
  }
  def cdb-row-reads?(rows, opts) {
   let exe = crd-coordinator();
   ((Comparable) len(rows) == 1) && ((String) cdb-str(rows[0], "coordinated_by") == crd-by(opts, exe)) && ((String) cdb-str(rows[0], "coordinator") == lrun-home-free(crd-exe-of(exe))) && cdb-rented-is?(cdb-int(rows[0], "rented_mind"), crd-rented(opts, exe)) && ((String) cdb-str(rows[0], "remote_dependence") == crd-dependence(opts, exe)) && ((String) cdb-str(rows[0], "session") == cdb-str(opts, "session")) && (cdb-bit(json-object-has?(rows[0], "session")) == cdb-bit(json-object-has?(opts, "session")));
  }
  def cdb-bit(b) = b ? 1 : 0;
  def cdb-c-native-turn(ctx) {
   let dir = temp_dir() ++ "/cdb-turn-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str();
   let made = fs_mkdir(dir);
   let bare = cdb-turn-row(dir, "bare", []);
   let named = cdb-turn-row(dir, "named", [fhn-s("session", "s-walk-here")]);
   let swept = fs_rmdir(dir);
   cdb-turn-calls?() && cdb-row-reads?(bare, json-node-object([])) && cdb-row-reads?(named, json-node-object([fhn-s("session", "s-walk-here")]));
  }
  // a table the band writes: a pid's row, or [] for a pid it does not hold
  def cdb-find(rows, pid) = nil?(rows) ? [] : (Comparable) rows[0][0] == pid ? rows[0] : cdb-find(rows[1:], pid);
  def cdb-read(rows) = crd-exe-of(crd-coordinator-in(pid => cdb-find(rows, pid), rows[0]));
  def cdb-shells(pid, n) = n <= 0 ? [[pid, 1, cdb-launchd()]] : cons([pid, pid - 1, "/bin/sh"], cdb-shells(pid - 1, n - 1));
  def cdb-c-climb(ctx) =
   ((String) cdb-read([[10, 9, "/w/form/fkwu"], [9, 8, "/bin/sh"], [8, 1, "/w/form/fkwu"], [1, 0, cdb-launchd()]]) == cdb-launchd()) &&
   ((String) cdb-read([[20, 19, "/w/form/fkwu"], [19, 18, "/bin/bash"], [18, 17, "/bin/zsh"], [17, 16, cdb-claude()], [16, 1, cdb-launchd()]]) == cdb-claude()) &&
   ((String) cdb-read([[30, 1, "/w/form/fkwu"], [1, 0, cdb-launchd()]]) == cdb-launchd()) &&
   ((String) cdb-read([[50, 49, "/w/form/fkwu"], [49, 48, "/Users/u/.local/bin/form-run"], [48, 47, "/bin/zsh"], [47, 1, "/opt/node/bin/node"]]) == "/opt/node/bin/node") &&
   ((String) cdb-read(cons([60, 59, "/w/form/fkwu"], cdb-shells(59, 10))) == "/bin/sh") &&
   ((String) cdb-read([[70, 69, "/w/form/fkwu"]]) == "") &&
   ((String) cdb-read([[80, 79, "/w/form/fkwu"], [79, 78, "/usr/bin/timeout"], [78, 77, "/bin/zsh"], [77, 1, cdb-claude()], [1, 0, cdb-launchd()]]) == cdb-claude());
  def cdb-count(s, mark, from) { let at = str_find(s, mark, from); at < 0 ? 0 : 1 + cdb-count(s, mark, at + len(mark)); }
  def cdb-door-reads-once?() {
   let src = read_file("observe/movement-run.bml") ?? "";
   let at = str_find(src, "let coordinator = crd-coordinator();", 0);
   (cdb-count(src, "crd-coordinator()", 0) == 1) && (at >= 0) && (at < str_find(src, "let line0 = read_line();", 0)) && (str_find(src, "def mv-climb(", 0) < 0) && (str_find(src, "def mv-keeper?(", 0) < 0);
  }
  def cdb-c-door(ctx) {
   let named = mv-coordination(cdb-named(), cdb-launchd());
   let bare = mv-coordination(cdb-bare(), cdb-walk());
   let n = mv-crossings-row("walk-here 2026-10-29", [], named);
   let b = mv-crossings-row("walk-here 2026-10-29", [], bare);
   let d = mv-crossings-row("walk-here 2026-10-29", [], mv-coordination(cdb-bare(), cdb-launchd()));
   ((String) cdb-str(n, "coordinated_by") == "session") && ((String) cdb-str(n, "coordinator") == cdb-launchd()) && ((Comparable) cdb-int(n, "rented_mind") == 1) && ((String) cdb-str(n, "session") == "s-walk-here") && cdb-null?(n, "coordinating_rent") &&
   ((String) cdb-str(named[2], "by") == "session") && ((String) cdb-str(named[2], "parent") == cdb-launchd()) && ((Comparable) cdb-int(named[2], "rented_mind") == 1) && cdb-null?(named[2], "coordinating_rent") &&
   ((String) cdb-str(b, "coordinated_by") == "host-schedule") && ((Comparable) cdb-int(b, "rented_mind") == 0) && ((Comparable) cdb-int(b, "coordinating_rent") == 0) && !json-object-has?(b, "session") && ((Comparable) cdb-int(b, "movement_dispatches") == 0) &&
   ((String) cdb-str(d, "coordinated_by") == "detached") && ((String) cdb-str(d, "coordinator") == cdb-launchd()) && cdb-null?(d, "rented_mind") && cdb-null?(d, "coordinating_rent") && !json-object-has?(d, "session") &&
   cdb-door-reads-once?();
  }
  def cdb-user(content, ts) = "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":\"" ++ content ++ "\"},\"timestamp\":\"" ++ ts ++ "\"}\n";
  def cdb-assistant(id, req, inp, cw, cr, out, ts) = "{\"message\":{\"id\":\"" ++ id ++ "\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":" ++ inp.str() ++ ",\"cache_creation_input_tokens\":" ++ cw.str() ++ ",\"cache_read_input_tokens\":" ++ cr.str() ++ ",\"output_tokens\":" ++ out.str() ++ "}},\"requestId\":\"" ++ req ++ "\",\"type\":\"assistant\",\"timestamp\":\"" ++ ts ++ "\"}\n";
  def cdb-transcript() = cdb-user("first asking", "2026-10-29T14:20:00.000Z") ++ cdb-assistant("msg_a1", "req_a1", 3, 100, 1000, 50, "2026-10-29T14:20:05.000Z") ++ cdb-user("walk here, then begin the movement", "2026-10-29T14:21:00.000Z") ++ cdb-assistant("msg_b1", "req_b1", 7, 20, 5000, 9, "2026-10-29T14:21:05.000Z");
  def cdb-c-rent(ctx) {
   let unread = parse-json("coordination-band", "{\"session\":\"s-walk-here\",\"transcript\":\"receipts/coordination-band-no-such-transcript.jsonl\"}");
   ((Comparable) mv-rent-in(cdb-transcript()) == 36) && nothing?(mv-rent-in("")) && nothing?(mv-coordinating-rent(cdb-named(), cdb-launchd())) && nothing?(mv-coordinating-rent(unread, cdb-claude())) && ((Comparable) mv-coordinating-rent(cdb-bare(), cdb-walk()) == 0) && nothing?(mv-coordinating-rent(cdb-bare(), cdb-launchd()));
  }
  // ancestries: rows [pid ppid exe cwd argv], the first the kernel itself; each reads [coordinated_by, rented_mind, session word]
  def cdb-line(rows) {
   let table = pid => cdb-find(rows, pid);
   let c = crd-coordinator-in(table, rows[0]);
   [crd-by(json-node-object([]), c), crd-rented(json-node-object([]), c), lrun-session-in(table, rows[0])];
  }
  def cdb-line-is?(name, rows, by, rented, word) {
   let r = cdb-line(rows);
   let ok = ((String) r[0] == by) && cdb-rented-is?(r[1], rented) && ((String) r[2] == word);
   let said = ok ? 0 : print(["ancestry short", name, r[0], nothing?(r[1]) ? "unknown" : r[1].str(), r[2]]);
   ok;
  }
  def cdb-ld() = [1, 0, cdb-launchd(), "", []];
  def cdb-term() = "/System/Applications/Utilities/Terminal.app/Contents/MacOS/Terminal";
  def cdb-launcher(pid, cwd) = [pid, 1, "/w/launch/fkwu", cwd, ["/w/launch/fkwu", "/w/launch/walk-launch.fk", "observe/day-turn.bml"]];
  def cdb-walk-line(door) = [[14, 13, "/w/fkwu", "/w", ["./fkwu", door]], [13, 12, "/bin/sh", "/w", ["/bin/sh", "-c", "./fkwu " ++ door]], [12, 11, "/w/fkwu", "/w", ["./fkwu", "observe/day-turn.bml"]], cdb-launcher(11, "/w"), cdb-ld()];
  def cdb-sandboxed(door) = append([[16, 15, "/w/fkwu", "/w", ["./fkwu", "q.bml"]], [15, 14, "/usr/bin/sandbox-exec", "/w", ["sandbox-exec", "-f", "p.sb", "./fkwu", "q.bml"]]], cdb-walk-line(door));
  def cdb-terminal(rest) = append(rest, [[28, 27, "/bin/zsh", "/r", ["-zsh"]], [27, 26, "/usr/bin/login", "/", ["login", "-pf", "u"]], [26, 1, cdb-term(), "/", [cdb-term()]], cdb-ld()]);
  def cdb-claude-in(argv) = cdb-terminal([[32, 31, "/r/fkwu", "/r", ["./fkwu", "p.bml"]], [31, 30, "/bin/zsh", "/r", ["/bin/zsh", "-c", "./fkwu p.bml"]], [30, 28, cdb-claude(), "/r", argv]]);
  def cdb-c-ancestries(ctx) =
   cdb-line-is?("walk launcher", cdb-walk-line("observe/movement-run.bml"), "host-schedule", 0, "") &&
   cdb-line-is?("sandbox-exec under the walk", cdb-sandboxed("observe/movement-run.bml"), "host-schedule", 0, "") &&
   cdb-line-is?("sandbox-exec under the walk's exam", cdb-sandboxed("observe/offline-exam-run.bml"), "host-schedule", 0, "offline-exam") &&
   cdb-line-is?("terminal", cdb-terminal([[29, 28, "/r/fkwu", "/r", ["./fkwu", "p.bml"]]]), "person", 0, "") &&
   cdb-line-is?("terminal running claude", cdb-claude-in([cdb-claude()]), "session", 1, "rented:claude") &&
   cdb-line-is?("terminal running claude --resume", cdb-claude-in([cdb-claude(), "--resume", "abc-1"]), "session", 1, "abc-1") &&
   cdb-line-is?("claude -p", [[35, 34, "/r/fkwu", "/r", ["./fkwu", "p.bml"]], [34, 33, "/bin/bash", "/r", ["bash"]], [33, 32, "/bin/zsh", "/r", ["/bin/zsh", "-c", "bash"]], [32, 31, cdb-claude(), "/r", [cdb-claude(), "-p", "--model", "m"]], [31, 30, "/bin/bash", "/r", ["/bin/bash", "s.sh"]], [30, 1, "/bin/zsh", "/r", ["/bin/zsh"]], cdb-ld()], "session", 1, "rented:claude") &&
   cdb-line-is?("timeout under a rented agent", [[45, 44, "/r/fkwu", "/r", ["./fkwu", "p.bml"]], [44, 43, "/usr/bin/timeout", "/r", ["timeout", "60", "./fkwu", "p.bml"]], [43, 42, "/bin/zsh", "/r", ["/bin/zsh"]], [42, 1, cdb-claude(), "/r", [cdb-claude(), "--resume", "s-1"]], cdb-ld()], "session", 1, "s-1") &&
   cdb-line-is?("nohup-detached", [[52, 1, "/r/fkwu", "/r", ["./fkwu", ".hearth/probe/p.bml"]], cdb-ld()], "detached", nothing(), "detached") &&
   cdb-line-is?("the walk's door begun under nohup", [[53, 1, "/w/fkwu", "/w", ["./fkwu", "observe/day-turn.bml"]], cdb-ld()], "detached", nothing(), "detached") &&
   cdb-line-is?("the launcher's pair from a cwd it does not stand in", [[55, 54, "/r/fkwu", "/r", ["./fkwu", "observe/day-turn.bml"]], cdb-launcher(54, "/r"), cdb-ld()], "detached", nothing(), "detached") &&
   cdb-line-is?("a table that did not answer", [[70, 69, "/w/fkwu", "/w", ["./fkwu", "p.bml"]]], "unread", 1, "unread");
  // the plists: each names its program's arguments and its WorkingDirectory; launchd begins the program there
  def cdb-between(s, open, close, from) {
   let a = str_find(s, open, from);
   let b = a < 0 ? -1 : str_find(s, close, a + len(open));
   b < 0 ? nothing() : [substring(s, a + len(open), b), b + len(close)];
  }
  def cdb-strings(s, from, end) {
   let x = cdb-between(s, "<string>", "</string>", from);
   nothing?(x) || (x[1] > end) ? [] : cons(x[0], cdb-strings(s, x[1], end));
  }
  def cdb-plist-row(text) {
   let at = str_find(text, "<key>ProgramArguments</key>", 0);
   let end = at < 0 ? -1 : str_find(text, "</array>", at);
   let args = end < 0 ? [] : cdb-strings(text, at, end);
   let wd = cdb-between(text, "<key>WorkingDirectory</key><string>", "</string>", 0);
   let cwd = nothing?(wd) ? "" : wd[0];
   nil?(args) ? [] : [100, 1, (String) substring(args[0], 0, 2) == "./" ? cwd ++ substring(args[0], 1, len(args[0])) : args[0], cwd, args];
  }
  def cdb-plist-job(name) {
   let job = cdb-plist-row(fhn-read("docs/launchd/" ++ name));
   let kid = [101, 100, crd-cwd(job) ++ "/fkwu", crd-cwd(job), ["./fkwu", "observe/movement-run.bml"]];
   let rows = [kid, job, cdb-ld()];
   let read = cdb-line(rows);
   let ok = (len(job) >= 5) && ((String) crd-job-name(job) != "") && ((String) read[0] == "host-schedule") && ((String) read[2] == "");
   let said = ok ? 0 : print(["plist short", name, read[0], read[2]]);
   ok ? crd-job-name(job) : "";
  }
  def cdb-c-plists(ctx) {
   let names = filter(n => (len(n) > 6) && ((String) substring(n, len(n) - 6, len(n)) == ".plist"), fs_list("docs/launchd") ?? []);
   let jobs = map(n => cdb-plist-job(n), names);
   let said = print(["plists", len(names), jobs]);
   !nil?(names) && all?(j => (String) j != "", jobs) && (len(filter(j => (String) j == "walk-launch", jobs)) >= 4);
  }
  def cdb-lowers?(path) {
   let rec = cell_run(path, 0, "check", nothing());
   !nothing?(rec) && nothing?(record_get(rec, "stopped")) && ((Comparable) record_get(rec, "errors") == 0);
  }
  def cdb-c-lower(ctx) = cdb-lowers?("observe/movement-run.bml") && cdb-lowers?("observe/native-turn-run.bml");
  // the landing the movement asks for carries the bands the caller named, as named, and names none when the caller named none
  def cdb-c-land-bands(ctx) {
   let band = json-node-object([fhn-s("band", "form/form-stdlib/tests/p-gap-band.bml"), fhn-n("full", 31), json-node-pair("writable", json-node-array([json-node-string("form/form-stdlib/bml/p.bml")]))]);
   let named = mv-land-request(json-node-object([fhn-s("subject", "s"), json-node-pair("bands", json-node-array([band]))]), "m");
   let bare = mv-land-request(json-node-object([fhn-s("subject", "s")]), "m");
   let carried = json-object-has?(named, "bands") ? json-array-elements(json-object-get(named, "bands")) : [];
   ((Comparable) len(carried) == 1) && node_eq(carried[0], band) && (String) cdb-str(named, "subject") == "s" && !json-object-has?(bare, "bands");
  }
 }
 live-claims("coordination-band", 0, [["named-launchd", 1, 1, cdb-c-named-launchd], ["bare-launchd", 2, 1, cdb-c-bare-launchd], ["named-session", 4, 1, cdb-c-named-session], ["bare-session", 8, 1, cdb-c-bare-session], ["word-adds", 16, 1, cdb-c-word-adds], ["unread", 32, 1, cdb-c-unread], ["native-turn", 64, 1, cdb-c-native-turn], ["climb", 128, 1, cdb-c-climb], ["door", 256, 1, cdb-c-door], ["rent", 512, 1, cdb-c-rent], ["lower", 1024, 1, cdb-c-lower], ["ancestries", 2048, 1, cdb-c-ancestries], ["plists", 4096, 1, cdb-c-plists], ["land-bands", 8192, 1, cdb-c-land-bands]]);
}
