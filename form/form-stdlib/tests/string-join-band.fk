; preludes: form-stdlib/core.fk
; string-join-band — str-join answers the right fold's bytes in linear passes, four-way.
;
; str-join lives in form-stdlib/bml/string-join.bml and reaches this band by name through
; form-stdlib/home-index.txt; no prelude line names it. The band holds the join against a
; right fold on a thousand numbered chunks, and asks for 100k chunks whole, which the right
; fold cannot answer in the band's time.
;
; Verdict 255 when every claim lands:
;   1   the empty list joins to ""
;   2   one part joins to itself
;   4   an odd count keeps its order: ab cd ef -> abcdef
;   8   an even count keeps its order: ab cd ef gh -> abcdefgh
;   16  a thousand numbered chunks join byte for byte as the right fold joins them
;   32  100k chunks of abcd join to 400000 bytes, a first and d last
;   64  str-join-with puts the separator between parts and nowhere else
;   128 str-join-reversed reads consed chunks in the order they were made
;
; Expected: 255
(do
    (defn sjb-fill (n s acc) (if (eq n 0) acc (sjb-fill (sub n 1) s (cons s acc))))
    (defn sjb-num (n acc) (if (eq n 0) acc (sjb-num (sub n 1) (cons (str_concat (int_to_str n) ",") acc))))
    (defn sjb-right (xs) (if (nil? xs) "" (str_concat (head xs) (sjb-right (tail xs)))))
    (defn sjb-consed (n acc) (if (eq n 0) acc (sjb-consed (sub n 1) (cons (int_to_str (sub 4 n)) acc))))
    (let nums (sjb-num 1000 (empty)))
    (let big (str-join (sjb-fill 100000 "abcd" (empty))))
    (let c0 (if (str_eq (str-join (list)) "") 1 0))
    (let c1 (if (str_eq (str-join (list "one")) "one") 2 0))
    (let c2 (if (str_eq (str-join (list "ab" "cd" "ef")) "abcdef") 4 0))
    (let c3 (if (str_eq (str-join (list "ab" "cd" "ef" "gh")) "abcdefgh") 8 0))
    (let c4 (if (str_eq (str-join nums) (sjb-right nums)) 16 0))
    (let c5 (if (and (eq (str_len big) 400000) (and (eq (str_byte_at big 0) 97) (eq (str_byte_at big 399999) 100))) 32 0))
    (let c6 (if (and (str_eq (str-join-with (list "a" "b" "c") ", ") "a, b, c") (and (str_eq (str-join-with (list) "-") "") (str_eq (str-join-with (list "x") "-") "x"))) 64 0))
    (let c7 (if (str_eq (str-join-reversed (sjb-consed 3 (empty))) "123") 128 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
