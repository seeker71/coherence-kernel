; attuned-inquiry-band.fk — frequency arrives before topology, and inquiry
; braids living possibilities without making protection or economy sovereign.
;
; preludes: form-stdlib/core.fk form-stdlib/form-freq-check.fk form-stdlib/attuned-inquiry.fk
;
; Verdict 8191:
;   1     witnessed human fear routes to re-tuning
;   2     unknown frequency holds rather than passing silently
;   4     witnessed human clear may be received
;   8     the named imported axes become edge / breath / living-unknown / braid
;   16    an unrelated axis survives unchanged (narrow, content-bound retuning)
;   32    a grounded, open, carried, vital inquiry moves
;   64    the edge organ may hold without the inquiry discarding the signal
;   128   breath may rest an uncarried weight without calling it low-value
;   256   play remains admissible at vitality zero
;   512   the braid retains every signal in arrival order; weight does not rank
;   1024  an executed movement that changed nothing still becomes learning
;   2048  held signals are tended and ungrounded proposals compost
;   4096  "with-care" tends through its specialized edge reading

(do
    (defn atib-fear () (fc-human-reading 0 1))
    (defn atib-clear () (fc-human-reading 1 1))
    (defn atib-unknown () (fc-unmeasured-reading))

    (defn atib-edge-open () (ati-edge "open" "consent-reversibility-organ" 1))
    (defn atib-edge-care () (ati-edge "with-care" "consent-reversibility-organ" 1))
    (defn atib-edge-hold () (ati-edge "hold" "consent-reversibility-organ" 1))
    (defn atib-breath-light () (ati-breath 100 5 1))
    (defn atib-breath-heavy () (ati-breath 100 90 1))
    (defn atib-breath-too-heavy () (ati-breath 100 101 1))

    (defn atib-move ()
        (ati-inquiry "move" "receipt:living-unknown" 7 "move"
                     (atib-edge-open) (atib-breath-light)))
    (defn atib-heavy-move ()
        (ati-inquiry "heavy" "receipt:living-unknown" 7 "move"
                     (atib-edge-open) (atib-breath-heavy)))
    (defn atib-held ()
        (ati-inquiry "held" "receipt:edge-reading" 9 "move"
                     (atib-edge-hold) (atib-breath-light)))
    (defn atib-resting ()
        (ati-inquiry "resting" "receipt:breath-reading" 9 "move"
                     (atib-edge-open) (atib-breath-too-heavy)))
    (defn atib-play ()
        (ati-inquiry "play" "receipt:play" 0 "play"
                     (atib-edge-open) (atib-breath-light)))
    (defn atib-care ()
        (ati-inquiry "care" "receipt:edge-reading" 9 "wander"
                     (atib-edge-care) (atib-breath-light)))
    (defn atib-ungrounded ()
        (ati-inquiry "ungrounded" "" 9 "move"
                     (atib-edge-open) (atib-breath-light)))
    (defn atib-braid ()
        (ati-braid
            (list (atib-move) (atib-heavy-move) (atib-held)
                  (atib-resting) (atib-play))))

    (defn atib-axes ()
        (ati-retune-axes
            (list "risk" "cost" "information-gain" "ranking")))

    (defn atib-c0 ()
        (if (str_eq (ati-frequency-route (atib-fear)) "retune") 1 0))
    (defn atib-c1 ()
        (if (str_eq (ati-frequency-route (atib-unknown)) "hold") 2 0))
    (defn atib-c2 ()
        (if (str_eq (ati-frequency-route (atib-clear)) "receive") 4 0))
    (defn atib-c3 ()
        (if
            (and
                (and
                    (str_eq (nth (atib-axes) 0) "edge-reading")
                    (str_eq (nth (atib-axes) 1) "breath-weight"))
                (and
                    (str_eq (nth (atib-axes) 2) "living-unknown")
                    (str_eq (nth (atib-axes) 3) "braid")))
            8 0))
    (defn atib-c4 ()
        (if (str_eq (ati-retune-axis "relationship") "relationship") 16 0))
    (defn atib-c5 ()
        (if (str_eq (ati-movement-state (atib-move)) "move") 32 0))
    (defn atib-c6 ()
        (if (str_eq (ati-movement-state (atib-held)) "hold") 64 0))
    (defn atib-c7 ()
        (if (str_eq (ati-movement-state (atib-resting)) "rest") 128 0))
    (defn atib-c8 ()
        (if (str_eq (ati-movement-state (atib-play)) "play") 256 0))
    (defn atib-c9 ()
        (if
            (and
                (and
                    (eq (len (atib-braid)) 5)
                    (str_eq (ati-movement-id (nth (atib-braid) 0)) "move"))
                (and
                    (str_eq (ati-movement-id (nth (atib-braid) 1)) "heavy")
                    (str_eq
                        (ati-movement-state-read (nth (atib-braid) 1))
                        "move")))
            512 0))
    (defn atib-c10 ()
        (if
            (and
                (eq
                    (ati-witness-changed
                        (ati-witness (ati-movement (atib-move)) 0))
                    0)
                (str_eq
                    (ati-witness-after
                        (ati-witness (ati-movement (atib-move)) 0))
                    "learn"))
            1024 0))
    (defn atib-c11 ()
        (if
            (and
                (str_eq
                    (ati-witness-after
                        (ati-witness (ati-movement (atib-held)) 0))
                    "tend")
                (str_eq (ati-movement-state (atib-ungrounded)) "compost"))
            2048 0))
    (defn atib-c12 ()
        (if (str_eq (ati-movement-state (atib-care)) "tend") 4096 0))

    (defn attuned-inquiry-band ()
        (add (atib-c0)
        (add (atib-c1)
        (add (atib-c2)
        (add (atib-c3)
        (add (atib-c4)
        (add (atib-c5)
        (add (atib-c6)
        (add (atib-c7)
        (add (atib-c8)
        (add (atib-c9)
        (add (atib-c10)
        (add (atib-c11) (atib-c12))))))))))))))

    (attuned-inquiry-band))
