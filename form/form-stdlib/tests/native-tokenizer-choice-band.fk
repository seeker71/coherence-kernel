; Added tokens decode literally; absent alternatives cannot abort a valid choice.
; preludes: form-stdlib/native-llama-voice.bml
(do
 (let special (noi-put (noi-put (list) "<|eot_id|>" 128009) "<|end_of_text|>" 128001))
 (let added (nlt-added-decoder (json-array-elements (parse-json "added" "[{\"id\":128000,\"content\":\"<|begin_of_text|>\"},{\"id\":128006,\"content\":\"<|start_header_id|>\"}]")) (list)))
 (let tk (list (list) (noi-put (list) (md-le32 1) "Hello") (list) special (list) "fixture" added))
 (let checks (list (str_eq (nlt-decode-id tk 128006) "<|start_header_id|>")
  (str_eq (nlt-decode-id tk 1) "Hello") (not (nlt-known-id tk 129000))
  (value_eq (nlg-pick-id tk "" 1 129000 -1) (list 1 ""))
  (value_eq (nlg-pick-id tk "" 129000 1 -1) (list 1 "adapted-choice"))
  (value_eq (nlg-pick-id tk "" 129000 -1 -1) (list -2 "tokenizer-candidates-absent"))
  (value_eq (nlg-pick-id tk "" 128009 1 -1) (list 128009 ""))))
 (print checks)
 (if (value_eq checks (list 1 1 1 1 1 1 1)) 127 (form_error "native added-token choice failed")))
