; tests/iching-channel-band.fk — one cell, three tongues, all 64 seated.
;
; Gate 25 is the headline: Human Design's "Spirit of the Self", Gene Key 25's
; Constriction->Acceptance->Universal Love, and I Ching hexagram 25's Innocence are
; three DIFFERENT surfaces of ONE cell.
;
; Verdict 4095 when every claim holds.
;   1      I Ching 25 speaks Innocence
;   2      Human Design 25 speaks Spirit of the Self
;   4      Gene Keys 25 speaks Universal Love
;   8      the three faces are ONE cell at 25
;   16     the cross-modal class at 25 has all three faces
;   32     a key outside 1..64 is honest absence
;   64     coverage is 64 seated on every face
;   128    every gate 1..64 is found
;   256    gate 40 now speaks (Deliverance / Aloneness / Exhaustion)
;   512    Urs key 48 carries Wisdom; 21 Valor; 34 Majesty
;   1024   shadow/gift/siddhi extractors agree with the speak line
;   2048   HD name of 10 is Behavior of the Self
;
; preludes: form-stdlib/core.fk form-stdlib/guidance-channel.fk form-stdlib/iching-channel.fk

(do
    (defn icb (ok bit) (if ok bit 0))
    (let ic-ok (ge (str_find (ic-hexagram-speak 25) "Innocence" 0) 0))
    (let hd-ok (ge (str_find (hd-gate-speak 25) "Spirit of the Self" 0) 0))
    (let gk-ok (ge (str_find (gk-key-speak 25) "Universal Love" 0) 0))
    (let one-ok (eq (ic64-one-cell? 25) 1))
    (let class-ok (eq (len (ic64-equivalents 25)) 3))
    (let absent-ok
        (and (ge (str_find (ic-hexagram-speak 0) "honest absence" 0) 0)
             (and (ge (str_find (hd-gate-speak 99) "honest absence" 0) 0)
                  (ge (str_find (gk-key-speak 65) "honest absence" 0) 0))))
    (let cov-ok (and (eq (ic64-total) 64)
                     (and (eq (ic64-seeded) 64)
                          (eq (gc-coverage (gk-keys)) 64))))
    (let all-ok (eq (ic64-all-found?) 1))
    (let forty-ok
        (and (ge (str_find (ic-hexagram-speak 40) "Deliverance" 0) 0)
             (and (ge (str_find (hd-gate-speak 40) "Aloneness" 0) 0)
                  (ge (str_find (gk-key-speak 40) "Exhaustion" 0) 0))))
    (let urs-ok
        (and (str_eq (gk-siddhi 48) "Wisdom")
             (and (str_eq (gk-siddhi 21) "Valor")
                  (str_eq (gk-siddhi 34) "Majesty"))))
    (let extract-ok
        (and (str_eq (gk-shadow 25) "Constriction")
             (and (str_eq (gk-gift 25) "Acceptance")
                  (ge (str_find (gk-key-speak 25) (gk-siddhi 25) 0) 0))))
    (let hd10-ok (str_eq (hd-name 10) "Behavior of the Self"))
    (add (add (add (add (add (add (add (add (add (add (add
        (icb ic-ok 1)
        (icb hd-ok 2))
        (icb gk-ok 4))
        (icb one-ok 8))
        (icb class-ok 16))
        (icb absent-ok 32))
        (icb cov-ok 64))
        (icb all-ok 128))
        (icb forty-ok 256))
        (icb urs-ok 512))
        (icb extract-ok 1024))
        (icb hd10-ok 2048)))
