; Recompute score margins from the raw top-eight scores retained by an actual
; 64-token native generation trajectory.  This is intentionally a derived,
; content-addressed receipt: the earlier observer's faulty margin field remains
; immutable lineage, while the preserved raw scores are re-read and corrected.
; witnessed: 2026-07-29 -> 255 (64 corrected score margins)
;
; preludes: form-stdlib/form-cli-dsv4-local.fk

(defn dma-key (sequence suffix)
        (str_concat "token."
            (str_concat (int_to_str sequence)
                (str_concat "." suffix))))

    (defn dma-raw-scores (receipt sequence)
        (fdl-line-value receipt
            (dma-key sequence "top-scores=")))

    (defn dma-margin (receipt sequence)
        (do
            (let scores (dma-raw-scores receipt sequence))
            (let comma1 (str_find scores "," 0))
            (if (lt comma1 0) (nothing)
                (do
                    (let start2 (add comma1 1))
                    (let comma2 (str_find scores "," start2))
                    (if (lt comma2 0) (nothing)
                        (sub
                            (str_to_float
                                (substring scores 0 comma1))
                            (str_to_float
                                (substring scores start2 comma2))))))))

    (defn dma-margins (receipt sequence end)
        (if (eq sequence end) (list)
            (cons
                (dma-margin receipt sequence)
                (dma-margins receipt (add sequence 1) end))))

    (defn dma-sum (values)
        (if (eq (len values) 0) 0.0
            (add (head values) (dma-sum (tail values)))))

    (defn dma-min (values current)
        (if (eq (len values) 0) current
            (dma-min (tail values)
                (if (lt (head values) current)
                    (head values) current))))

    (defn dma-max (values current)
        (if (eq (len values) 0) current
            (dma-max (tail values)
                (if (gt (head values) current)
                    (head values) current))))

    (defn dma-count-below (values threshold)
        (if (eq (len values) 0) 0
            (add
                (if (lt (head values) threshold) 1 0)
                (dma-count-below (tail values) threshold))))

    (defn dma-index-of-min (values current index best-index)
        (if (eq (len values) 0) best-index
            (if (lt (head values) current)
                (dma-index-of-min
                    (tail values) (head values)
                    (add index 1) index)
                (dma-index-of-min
                    (tail values) current
                    (add index 1) best-index))))

    (defn dma-drop (values n)
        (if (or (lt n 1) (eq (len values) 0)) values
            (dma-drop (tail values) (sub n 1))))

    (defn dma-take (values n)
        (if (or (lt n 1) (eq (len values) 0)) (list)
            (cons (head values)
                (dma-take (tail values) (sub n 1)))))

    (defn dma-mean (values)
        (if (eq (len values) 0) 0.0
            (div (dma-sum values) (len values))))

    (defn dma-run ()
        (do
            (let source-run
                "9ae318d43524685886143689ec88012731f80047e83f4f47290439f85961e9a5")
            (let source-path
                (str_concat
                    ".coherence-network/form-cli/receipts/"
                    (str_concat source-run
                        ".trajectory.receipt.txt")))
            (let receipt (read_file source-path))
            (let margins (dma-margins receipt 0 64))
            (let minimum (dma-min (tail margins) (head margins)))
            (let maximum (dma-max (tail margins) (head margins)))
            (let minimum-index
                (dma-index-of-min
                    (tail margins) (head margins) 1 0))
            (let setup (dma-take margins 19))
            (let unsupported
                (dma-take (dma-drop margins 19) 21))
            (let prescription
                (dma-drop margins 41))
            (let a0
                (str_concat
                    "form-cli-native-trajectory-analysis-version=1\nsource-run-id="
                    source-run))
            (let a1
                (str_concat a0
                    (str_concat "\ncount="
                        (int_to_str (len margins)))))
            (let a2
                (str_concat a1
                    (str_concat "\nminimum-margin="
                        (float_to_str minimum))))
            (let a3
                (str_concat a2
                    (str_concat "\nminimum-index="
                        (int_to_str minimum-index))))
            (let a4
                (str_concat a3
                    (str_concat "\nmaximum-margin="
                        (float_to_str maximum))))
            (let a5
                (str_concat a4
                    (str_concat "\nmean-margin="
                        (float_to_str (dma-mean margins)))))
            (let a6
                (str_concat a5
                    (str_concat "\nsetup-0-18-mean-margin="
                        (float_to_str (dma-mean setup)))))
            (let a7
                (str_concat a6
                    (str_concat "\nunsupported-19-39-mean-margin="
                        (float_to_str (dma-mean unsupported)))))
            (let a8
                (str_concat a7
                    (str_concat "\nprescription-41-63-mean-margin="
                        (float_to_str (dma-mean prescription)))))
            (let a9
                (str_concat a8
                    (str_concat "\nmargin-below-0.05-count="
                        (int_to_str
                            (dma-count-below margins 0.05)))))
            (let a10
                (str_concat a9
                    (str_concat "\nmargin-below-0.1-count="
                        (int_to_str
                            (dma-count-below margins 0.1)))))
            (let a11
                (str_concat a10
                    (str_concat "\nmargin-below-0.25-count="
                        (int_to_str
                            (dma-count-below margins 0.25)))))
            (let a12
                (str_concat a11
                    (str_concat "\nmargin-below-0.5-count="
                        (int_to_str
                            (dma-count-below margins 0.5)))))
            (let a13
                (str_concat a12
                    "\nobserver-fault=leading-score-digit-dropped"))
            (let a14
                (str_concat a13
                    "\nobserver-repair=raw-top-scores-reparsed-from-index-zero"))
            (let a15
                (str_concat a14
                    "\nsemantic-claim=correlation-candidate-not-proof"))
            (let a16
                (str_concat a15
                    "\nnetwork=0\nremote=0"))
            (let analysis-id
                (nmfe-sha256
                    (nmfe-fields (list source-run a16))))
            (let receipt-dir
                (fdl-ensure-receipt-dir ".coherence-network"))
            (let analysis-path
                (str_concat receipt-dir
                    (str_concat "/"
                        (str_concat analysis-id
                            ".trajectory-analysis.receipt.txt"))))
            (let complete
                (str_concat a16
                    (str_concat "\nanalysis-run-id="
                        analysis-id)))
            (let wrote (write_file analysis-path complete))
            (print_str complete)
            (print_str (str_concat
                "analysis-receipt-path=" analysis-path))
            (print_str (str_concat
                "analysis-receipt-written="
                (if (gt wrote 0) "1" "0")))
            (let verdict
                (if (and
                        (eq (len margins) 64)
                        (and
                            (gt wrote 0)
                            (gt minimum 0.0)))
                    255 0))
            verdict))

(dma-run)
