; living-world-structural-recipe-band.fk -- two replaceable codecs execute the
; same noncommutative structural carrier; contradicted behavior cannot cross.
; Verdict 32767 proves fifteen codec, execution, time, and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-structural-recipe-witness.fk

(defn lwsrxb-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwsrxb-sum (tail items)))))

(do
    (let fixture (lwsrw-build-applications))
    (let schema-fixture (lwsrw-application-schema fixture))
    (let schema-candidate (lwsrw-schema-candidate schema-fixture))
    (let world (lwsrw-application-world-cell fixture))
    (let first (lwsrw-application-first fixture))
    (let second (lwsrw-application-second fixture))
    (let contradicted (lwsrw-application-contradicted fixture))
    (let first-execution (lwsrw-application-first-execution fixture))
    (let second-pending (lwsrw-application-second-execution fixture))
    (let second-expired
        (lwsr-execution-for world second 2 (intern_trivial_int 10)))
    (let revoked (lwsrw-revoked-codec-world fixture))
    (let first-bindings (lwsr-execution-bindings first-execution))
    (let second-bindings (lwsr-execution-bindings second-pending))
    (let contradicted-carrier
        (lwsr-application-carrier contradicted))

    (let c1
        (if (and (eq (lwsr-application-shape-valid? first) 1)
                 (and (eq (lwsr-application-shape-valid? second) 1)
                      (eq (lwsr-application-shape-valid?
                              contradicted) 1))) 1 0))
    (let c2
        (if (and (eq (lwsr-application-current? world first 2) 1)
                 (and (eq (lwsr-application-current? world second 2) 1)
                      (eq (lwsr-application-current?
                              world contradicted 2) 0))) 2 0))
    (let c3
        (if (and (str_eq
                     (lwre-recipe-source
                         (lwsr-execution-recipe first-execution))
                     "(sub u v)")
                 (str_eq
                     (lwre-recipe-source
                         (lwsr-execution-recipe second-pending))
                     "(sub p q)")) 4 0))
    (let c4
        (if (and (str_eq
                     (lwre-binding-name
                         (nth (lwre-binding-items first-bindings) 0)) "u")
                 (and (str_eq
                          (lwre-binding-name
                            (nth (lwre-binding-items first-bindings) 1)) "v")
                      (and (str_eq
                              (lwre-binding-name
                                (nth (lwre-binding-items second-bindings) 0))
                              "p")
                           (str_eq
                              (lwre-binding-name
                                (nth (lwre-binding-items second-bindings) 1))
                              "q")))) 8 0))
    (let c5
        (if (and (node_eq
                     (lwsr-execution-output first-execution)
                     (intern_trivial_int 14))
                 (and (node_eq
                          (lwsr-execution-output second-pending)
                          (intern_trivial_int 14))
                      (and (eq (oac-one?
                                  (lwsr-execution-immediate
                                    first-execution)) 1)
                           (eq (oac-one?
                                  (lwsr-execution-immediate
                                    second-pending)) 1)))) 16 0))
    (let c6
        (if (and (not (node_eq
                         (lwsr-execution-recipe first-execution)
                         (lwsr-execution-recipe second-pending)))
                 (and (node_eq
                          (lwsr-application-carrier first)
                          (lwsr-application-carrier second))
                      (node_eq
                          (lwsr-application-schema first)
                          (lwsr-application-schema second)))) 32 0))
    (let c7
        (if (and (gt (lwo-field-size
                         (lwsr-codec-alternatives
                            (head (lwo-field-items
                                (lwsr-application-codecs first))))) 0)
                 (and (eq (lwlc-unknown?
                              (lwsr-codec-unknown
                                (head (lwo-field-items
                                    (lwsr-application-codecs second))))) 1)
                      (not (node_eq
                              (lwsr-application-codecs first)
                              (lwsr-application-codecs second))))) 64 0))
    (let c8
        (if (and (eq (lwo-field-size
                         (lwsr-application-alternatives second)) 1)
                 (and (eq (lwlc-unknown?
                              (lwsr-application-unknown second)) 1)
                      (and (eq (lwlc-choice-valid?
                                  (lwsr-application-choice second)) 1)
                           (eq (oac-time-pending?
                                  (lwsr-execution-time second-pending)) 1))))
            128 0))
    (let c9
        (if (and (eq (oac-time-outcome?
                         (lwsr-execution-time second-expired)) 1)
                 (and (eq (oac-alternative-ack?
                              (oac-time-outcome-ack
                                (lwsr-execution-time second-expired))) 1)
                      (and (eq (oac-one?
                                  (lwsr-execution-immediate
                                    second-expired)) 1)
                           (not (node_eq
                                  (lwsr-execution-time second-pending)
                                  (lwsr-execution-time second-expired))))))
            256 0))
    (let c10
        (if (and (eq (lwsr-application-current? world first 3) 0)
                 (eq (lwsr-application-current? world second 3) 0)) 512 0))
    (let c11
        (if (and (eq (lwsr-execution-current?
                         world first-execution) 1)
                 (eq (lwsr-execution-current?
                         world second-pending) 1)) 1024 0))
    (let c12
        (if (and (gt (lwo-field-size
                         (lwsr-execution-witnesses first-execution)) 0)
                 (gt (lwo-field-size
                        (lwt-sources-from-attributions
                            (lwo-field-items
                                (lwsr-execution-witnesses first-execution))
                            (lwo-empty-field))) 0)) 2048 0))
    (let c13
        (if (and (node_eq
                     (lwsr-execution-for world contradicted 2 (lwo-none))
                     (lwo-none))
                 (eq (lwph-divergent?
                         (lwht-receipt-state
                            (lwsr-carrier-receipt
                                contradicted-carrier))) 1)) 4096 0))
    (let c14
        (if (and (eq (lwo-active? revoked
                         (head (lwo-field-items
                            (lwsr-application-codecs first)))) 0)
                 (and (eq (lwsr-application-current?
                              revoked first 2) 0)
                      (and (eq (lwsr-execution-current?
                                  revoked first-execution) 0)
                           (eq (lwsr-application-current?
                                  revoked second 2) 1)))) 8192 0))
    (let c15
        (if (and (eq (lwsr-schema-integrated-current?
                         revoked schema-candidate) 1)
                 (and (eq (lwsr-execution-current?
                              revoked second-pending) 1)
                      (and (eq (lwre-projection-current? revoked
                                  (lwsr-value-projection
                                    (head (lwo-field-items
                                      (lwsr-application-values second))))) 1)
                           (eq (lwlc-unknown?
                                  (lwsr-value-unknown
                                    (head (lwo-field-items
                                      (lwsr-application-values second))))) 1))))
            16384 0))
    (lwsrxb-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
