ipe-tree-revision-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk form-stdlib/tests/living-world-recipe-tree-relation-nursery-witness.fk

(defn lwrrnb-bit (ok bit) (if ok bit 0))
(defn lwrrnb-derivations-exact? (items)
    (if (eq (len items) 0) 1
        (if (eq (node_value (nth (node_children (head items)) 5)) 1)
            (lwrrnb-derivations-exact? (tail items)) 0)))
(defn lwrrnb-trial-has-operator? (items operator)
    (if (eq (len items) 0) 0
        (if (node_eq (lwrrn-trial-operator (head items)) operator) 1
            (lwrrnb-trial-has-operator? (tail items) operator))))
(defn lwrrnb-all-operators-tried? (operator-items trial-items)
    (if (eq (len operator-items) 0) 1
        (if (eq (lwrrnb-trial-has-operator?
                    trial-items (head operator-items)) 1)
            (lwrrnb-all-operators-tried?
                (tail operator-items) trial-items) 0)))

(defn lwrrnb-run ()
    (do
        (let result (lwrrnw-run))
        (let children (node_children result))
        (let upstream (nth children 0))
        (let upstream-children (node_children upstream))
        (let candidate (nth upstream-children 1))
        (let suite (nth upstream-children 4))
        (let world (nth upstream-children 7))
        (let revoked-world (nth upstream-children 16))
        (let field (nth children 1))
        (let invariant (nth children 2))
        (let trial (nth children 3))
        (let revoked-field (nth children 4))
        (let events (nth children 6))
        (let contradictions (lwrrn-field-contradictions field))
        (let earlier (lwrrn-earlier-contradictions candidate))
        (let current (lwrrn-current-contradictions candidate suite))
        (let contradiction-items (lwo-field-items contradictions))
        (let first-case (head contradiction-items))
        (let first-bindings
            (lwre-binding-items (lwps-case-bindings first-case)))
        (let invariant-binding
            (lwrrn-binding-by-name first-bindings
                (lwrrn-invariant-name invariant)))
        (let operators (lwrrn-original-operator-field candidate))
        (let trials (lwrrn-field-trials field))
        (let viable (lwrrn-field-viable field))
        (let recipe
            (lwph-recipe-for (lwrrn-trial-operator trial)
                (lwre-binding-name (nth first-bindings 0))
                (lwre-binding-name (nth first-bindings 1))))
        (let pending-case (nth (lwo-field-items (lwrtrpw-cases)) 3))
        (let condensed-case (nth (lwo-field-items (lwrtrpw-cases)) 4))
        (sum (list
            (lwrrnb-bit (eq (lwrrn-field? field) 1) 1)
            (lwrrnb-bit (node_eq (lwrrn-field-candidate field) candidate) 2)
            (lwrrnb-bit (node_eq (lwrrn-field-suite field) suite) 4)
            (lwrrnb-bit (eq (lwo-field-size contradictions) 2) 8)
            (lwrrnb-bit (eq (lwo-field-size earlier) 1) 16)
            (lwrrnb-bit (eq (lwo-field-size current) 1) 32)
            (lwrrnb-bit
                (and (eq (lwo-field-has? contradictions
                            (head (lwo-field-items earlier))) 1)
                     (and (eq (lwo-field-has? contradictions
                                (head (lwo-field-items current))) 1)
                          (not (node_eq (head (lwo-field-items earlier))
                                (head (lwo-field-items current)))))) 64)
            (lwrrnb-bit
                (eq (lwo-field-size (lwrrn-field-invariants field)) 1) 128)
            (lwrrnb-bit (eq (lwrrn-invariant? invariant) 1) 256)
            (lwrrnb-bit
                (node_eq (lwrrn-invariant-support invariant) contradictions) 512)
            (lwrrnb-bit
                (eq (lwrrn-binding-repeats-items? contradiction-items
                        (lwrrn-invariant-name invariant)
                        (lwrrn-invariant-value invariant)) 1) 1024)
            (lwrrnb-bit
                (lt (lwo-field-size (lwrrn-field-invariants field))
                    (len first-bindings)) 2048)
            (lwrrnb-bit (eq (lwo-field-size operators) 3) 4096)
            (lwrrnb-bit (eq (lwo-field-size trials) 3) 8192)
            (lwrrnb-bit (eq (lwo-field-size viable) 1) 16384)
            (lwrrnb-bit
                (and (eq (lwhrn-ready? (lwrrn-field-status field)) 1)
                     (eq (lwhrn-plural? (lwrrn-field-status field)) 0)) 32768)
            (lwrrnb-bit (eq (lwrrn-trial? trial) 1) 65536)
            (lwrrnb-bit
                (and (eq (lwrrn-trial-total trial) 2)
                     (eq (lwrrn-trial-exact trial) 2)) 131072)
            (lwrrnb-bit
                (eq (lwph-consistent? (lwrrn-trial-state trial)) 1) 262144)
            (lwrrnb-bit
                (eq (lwo-field-size (lwrrn-trial-derivations trial)) 2)
                524288)
            (lwrrnb-bit
                (eq (lwo-field-has? operators
                        (lwrrn-trial-operator trial)) 1) 1048576)
            (lwrrnb-bit (node_eq (lwrrn-trial-recipe trial) recipe) 2097152)
            (lwrrnb-bit
                (eq (lwrrnb-derivations-exact?
                        (lwo-field-items
                            (lwrrn-trial-derivations trial))) 1) 4194304)
            (lwrrnb-bit
                (and (not (node_eq invariant-binding (lwo-none)))
                     (node_eq (lwre-binding-value invariant-binding)
                        (lwrrn-invariant-value invariant))) 8388608)
            (lwrrnb-bit
                (lwrrnb-all-operators-tried?
                    (lwo-field-items operators) (lwo-field-items trials))
                16777216)
            (lwrrnb-bit
                (eq (sub (lwo-field-size trials)
                        (lwo-field-size viable)) 2) 33554432)
            (lwrrnb-bit
                (and (eq (node_value (nth children 5)) 0)
                     (eq (lwo-active? world field) 0)) 67108864)
            (lwrrnb-bit (node_eq revoked-field (lwo-none)) 134217728)
            (lwrrnb-bit
                (eq (lwps-suite-current? revoked-world suite 2) 0) 268435456)
            (lwrrnb-bit
                (and (eq (oac-time-pending?
                            (lwps-case-time pending-case)) 1)
                     (eq (oac-time-outcome?
                            (lwps-case-time condensed-case)) 1)) 536870912)
            (lwrrnb-bit
                (and (eq (len events) 4)
                     (and (eq (lwo-active? world
                                (lwrrn-trial-recipe trial)) 0)
                          (eq (lwo-active? world trial) 0))) 1073741824)))))

; witnessed: 2026-08-09 -> 2147483647 (31/31) on fkwu
(lwrrnb-run)
