; substrate-write.fk — exercise the substrate-write natives from Form.
;
; The kernel exposes natives that let Form code construct AND observe
; recipes — closing gaps W1-W3 from form-runtime-in-form. A recipe is
; content-addressed identity: the same category and children intern to
; the same NodeID on every kernel. This file builds recipes, reads them
; back, and returns the count of observations that hold, which every
; kernel must agree on.
;
; Surfaces under test:
;   make_nodeid            — construct a raw NodeID
;   intern_trivial_int     — int → trivial NodeID
;   intern_node            — (category, children-list) → composite NodeID
;   node_eq                — NodeID identity
;   node_category          — read a composite's category
;   node_children          — read a composite's children
;   node_value             — decode a trivial leaf
;
; Verdict: 8 when every observation holds.

(do
    (defn claim-bit (holds)
        (if holds 1 0))

    ;; --- Category constants (from kernel substrate numbering) ---------
    ;; Level=2 (BASIC), Type=12 (MATH)
    (let math-plus  (make_nodeid 1 2 12 1))   ; MATH.PLUS
    (let math-mul   (make_nodeid 1 2 12 3))   ; MATH.MULTIPLY

    ;; --- Test 1: build (1 + 2) from Form; its category reads back ----
    (let one   (intern_trivial_int 1))
    (let two   (intern_trivial_int 2))
    (let plus-recipe (intern_node math-plus (list one two)))
    (let o1    (claim-bit (node_eq (node_category plus-recipe) math-plus)))

    ;; --- Test 2: build (3 * 4) from Form; its category reads back ----
    (let three (intern_trivial_int 3))
    (let four  (intern_trivial_int 4))
    (let mul-recipe (intern_node math-mul (list three four)))
    (let o2    (claim-bit (node_eq (node_category mul-recipe) math-mul)))

    ;; --- Test 3: content-addressing — building (1 + 2) again from
    ;;     fresh leaves yields the SAME NodeID. ----------------------
    (let plus-recipe-2 (intern_node math-plus (list (intern_trivial_int 1)
                                                     (intern_trivial_int 2))))
    (let o3    (claim-bit (node_eq plus-recipe plus-recipe-2)))

    ;; --- Test 4: introspect — plus-recipe has two children and
    ;;     their leaves read 1 and 2. --------------------------------
    (let kids  (node_children plus-recipe))
    (let o4    (add (claim-bit (eq (len kids) 2))
               (add (claim-bit (eq (node_value (head kids)) 1))
                    (claim-bit (eq (node_value (head (tail kids))) 2)))))

    ;; --- Test 5: deeper composition — ((1 + 2) * 3) holds plus-recipe
    ;;     itself as its first child (a shared subrecipe is one node),
    ;;     and is a different NodeID from (3 * 4). ---------------------
    (let nested (intern_node math-mul (list plus-recipe three)))
    (let o5    (add (claim-bit (node_eq (head (node_children nested)) plus-recipe))
                    (if (node_eq nested mul-recipe) 0 1)))

    ;; --- Aggregate: 1 + 1 + 1 + 3 + 2 = 8 ---------------------------
    (add o1 (add o2 (add o3 (add o4 o5)))))
