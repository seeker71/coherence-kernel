; meaning-codes-table-band.fk — the rows are read once, and reading them once
; answers exactly what reading them every time answered.
;
; meaning-codes-band proves the MEANING: every code round-trips, collisions are
; listed, an unknown token says so. This band proves the SHAPE that carries it.
; Form holds no mutable state, so "read once" is a table an argument carries, and
; a table carried is a table that can drift from the door that built it. Every bit
; here is that drift, asked as a question. The band mints its own pairs by its own
; recursion, so the codebook it checks is never the codebook it checked with.
;
; Every comparison here walks to the bytes with str_eq. That is not style: on this
; kernel today `value_eq` answers false for two freshly built strings that str_eq
; calls the same, about 1 in 700 on sha256 output, so a band resting on it would
; go red at random. Comparing the bytes is also the stronger question — a code is
; what it says, not which node happens to carry it.
;
; Expected: 255 on fkwu, 195 on the three proof walkers, which agree with each
; other. The walkers' surface carries no file reading, so the table they build is
; empty and the four bits that need a row — 4, 8, 16, 32 — cannot be asked there;
; the four that ask about shape alone still answer. The divergence is stated, not
; discovered later: 255 - 195 is exactly those four bits.
;
;    1 the carried path answers the door's answer, for every meaning
;    2 the codebook is the band's own pairs, meaning for meaning, in roster order
;    4 resolving through the book answers the band's own scan, for every present code
;    8 no file, no row and no cell is lost in the one read
;   16 a tongue with a cell speaks it, a tongue without one says nothing, an unknown token asks
;   32 collisions are still listed, and each listed one really carries more than one meaning
;   64 the whole roster round-trips, and each meaning round-trips alone
;  128 the table is the same table twice: reading is a reading, not a state
; preludes: form/form-stdlib/meaning-codes.bml
(do
    (defn mct-bit (ok bit) (if ok bit 0))

    ; --- comparison, all the way to the bytes ---
    (defn mct-strs-eq (a b)
        (if (nil? a) (if (nil? b) 1 0)
            (if (nil? b) 0
                (if (str_eq (head a) (head b)) (mct-strs-eq (tail a) (tail b)) 0))))
    (defn mct-codes-eq (a b)
        (if (nil? a) (if (nil? b) 1 0)
            (if (nil? b) 0
                (if (and (str_eq (head (head a)) (head (head b))) (str_eq (nth (head a) 1) (nth (head b) 1)))
                    (mct-codes-eq (tail a) (tail b)) 0))))
    (defn mct-book-eq (a b)
        (if (nil? a) (if (nil? b) 1 0)
            (if (nil? b) 0
                (if (and (str_eq (head (head a)) (head (head b)))
                         (eq (mct-codes-eq (nth (head a) 1) (nth (head b) 1)) 1))
                    (mct-book-eq (tail a) (tail b)) 0))))
    (defn mct-rows-eq (a b)
        (if (nil? a) (if (nil? b) 1 0)
            (if (nil? b) 0
                (if (eq (mct-strs-eq (head a) (head b)) 1) (mct-rows-eq (tail a) (tail b)) 0))))
    (defn mct-tbl-eq (a b)
        (if (nil? a) (if (nil? b) 1 0)
            (if (nil? b) 0
                (if (and (eq (mct-strs-eq (head (head a)) (head (head b))) 1)
                         (eq (mct-rows-eq (nth (head a) 1) (nth (head b) 1)) 1))
                    (mct-tbl-eq (tail a) (tail b)) 0))))

    ; --- the band's own codebook, minted by the band's own walk ---
    (defn mct-pairs (syms tbl)
        (if (nil? syms) (list)
            (cons (list (head syms) (mc-codes-in tbl (head syms))) (mct-pairs (tail syms) tbl))))
    ; the band's own resolve: a scan over its own pairs, owing nothing to mc-book
    (defn mct-scan (pairs code)
        (if (nil? pairs) (list)
            (if (eq (mc-has-code? (nth (head pairs) 1) code) 1)
                (cons (head (head pairs)) (mct-scan (tail pairs) code))
                (mct-scan (tail pairs) code))))

    ; 1 — the carried path and the door path are one answer
    (defn mct-carried (syms tbl)
        (if (nil? syms) 1
            (if (eq (mct-codes-eq (mc-codes-in tbl (head syms)) (mc-codes (head syms))) 1)
                (mct-carried (tail syms) tbl) 0)))

    ; 4 — every present code resolves the same through the book and through the band's scan
    (defn mct-codes-agree (book pairs codes)
        (if (nil? codes) 1
            (if (eq (str_len (nth (head codes) 1)) 0)
                (mct-codes-agree book pairs (tail codes))
                (if (eq (mct-strs-eq (mc-resolve-in book (nth (head codes) 1)) (mct-scan pairs (nth (head codes) 1))) 1)
                    (mct-codes-agree book pairs (tail codes)) 0))))
    (defn mct-all-agree (book pairs rest)
        (if (nil? rest) 1
            (if (eq (mct-codes-agree book pairs (nth (head rest) 1)) 1)
                (mct-all-agree book pairs (tail rest)) 0)))

    ; 8 — a row's cells are its separators plus one, counted off the raw line, not off the split
    (defn mct-pipes (s i n)
        (if (ge i (str_len s)) n
            (mct-pipes s (add i 1) (if (str_eq (substring s i (add i 1)) "|") (add n 1) n))))
    (defn mct-rows-ok (rows lines)
        (if (nil? rows) (if (nil? lines) 1 0)
            (if (nil? lines) 0
                (if (eq (len (head rows)) (add (mct-pipes (head lines) 0 0) 1))
                    (mct-rows-ok (tail rows) (tail lines)) 0))))
    (defn mct-files-ok (paths tbl)
        (if (nil? paths) (if (nil? tbl) 1 0)
            (if (nil? tbl) 0
                (do (let lines (mc-lines (head paths)))
                    (let entry (head tbl))
                    (if (and (eq (len (head entry)) (mct-pipes (head lines) 0 0))
                             (eq (mct-rows-ok (nth entry 1) (tail lines)) 1))
                        (mct-files-ok (tail paths) (tail tbl)) 0)))))

    ; 32 — a listed collision really carries more than one meaning
    (defn mct-coll-ok (cs)
        (if (nil? cs) 1
            (if (gt (len (mc-resolve-all (head (head cs)))) 1) (mct-coll-ok (tail cs)) 0)))

    ; 64 — each meaning round-trips on its own, the way the roster says it does
    (defn mct-each-round (syms)
        (if (nil? syms) 1
            (if (eq (mc-round-trip? (head syms)) 1) (mct-each-round (tail syms)) 0)))

    (let tbl (mc-table))
    (let pairs (mct-pairs (mc-meanings) tbl))
    (let book (mc-book))
    (let coll (mc-collisions (mc-meanings) (list)))

    (sum (list
        (mct-bit (eq (mct-carried (mc-meanings) tbl) 1) 1)
        (mct-bit (eq (mct-book-eq book pairs) 1) 2)
        (mct-bit (and (eq (mct-all-agree book pairs pairs) 1)
                      (and (eq (mct-strs-eq (mc-resolve-all "گفت") (list "say" "tell")) 1)
                           (and (eq (mct-strs-eq (mc-resolve-all "sagte") (list "say")) 1)
                                (eq (len (mc-resolve-all "zorble-nothing")) 0)))) 4)
        (mct-bit (and (gt (len (mc-files)) 0) (eq (mct-files-ok (mc-files) tbl) 1)) 8)
        (mct-bit (and (str_eq (mc-say-in "release" "german") "freigab")
                      (and (eq (str_len (mc-say-in "release" "portuguese")) 0)
                           (str_eq (mc-line-in (list "zorble") "german") "[zorble?]"))) 16)
        (mct-bit (and (gt (len coll) 0) (eq (mct-coll-ok coll) 1)) 32)
        (mct-bit (and (eq (mc-all-round? (mc-meanings)) 1) (eq (mct-each-round (mc-meanings)) 1)) 64)
        (mct-bit (eq (mct-tbl-eq (mc-table) (mc-table)) 1) 128))))
