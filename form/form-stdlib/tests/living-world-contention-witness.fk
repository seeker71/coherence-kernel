; living-world-contention-witness.fk -- two consented paths disagree locally.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-enquiry.fk form-stdlib/living-world-enquiry-answer.fk

(let LWCT-X      (bp "LWCT-X"))
(let LWCT-Y      (bp "LWCT-Y"))
(let LWCT-ACTION (bp "LWCT-ACTION"))

(defn lwct-action () LWCT-ACTION)
(defn lwct-interface () (lwo-interface (list LWCT-ACTION)))
(defn lwct-source-a () (intern_trivial_string "lwct-source-a"))
(defn lwct-source-b () (intern_trivial_string "lwct-source-b"))
(defn lwct-source-c () (intern_trivial_string "lwct-source-c"))
(defn lwct-source-d () (intern_trivial_string "lwct-source-d"))
(defn lwct-source-e () (intern_trivial_string "lwct-source-e"))
(defn lwct-provenance-a () (intern_trivial_string "lwct-provenance-a"))
(defn lwct-provenance-b () (intern_trivial_string "lwct-provenance-b"))
(defn lwct-provenance-c () (intern_trivial_string "lwct-provenance-c"))
(defn lwct-provenance-d () (intern_trivial_string "lwct-provenance-d"))
(defn lwct-provenance-e () (intern_trivial_string "lwct-provenance-e"))
(defn lwct-response-provenance ()
    (intern_trivial_string "lwct-response-provenance"))

(defn lwct-x (first second) (lwo-compose LWCT-X (list first second)))
(defn lwct-y (first second) (lwo-compose LWCT-Y (list first second)))
(defn lwct-x-a ()
    (lwct-x (intern_trivial_string "alice")
            (intern_trivial_string "red")))
(defn lwct-y-a ()
    (lwct-y (intern_trivial_string "alice")
            (intern_trivial_string "red")))
(defn lwct-x-b ()
    (lwct-x (intern_trivial_string "bob")
            (intern_trivial_string "blue")))
(defn lwct-y-b ()
    (lwct-y (intern_trivial_string "bob")
            (intern_trivial_string "blue")))
(defn lwct-x-c ()
    (lwct-x (intern_trivial_string "carol")
            (intern_trivial_string "green")))
(defn lwct-y-c ()
    (lwct-y (intern_trivial_string "green")
            (intern_trivial_string "carol")))
(defn lwct-x-d ()
    (lwct-x (intern_trivial_string "dave")
            (intern_trivial_string "orange")))
(defn lwct-y-d ()
    (lwct-y (intern_trivial_string "orange")
            (intern_trivial_string "dave")))
(defn lwct-unseen-input ()
    (lwct-x (intern_trivial_string "erin")
            (intern_trivial_string "violet")))
(defn lwct-identity-output ()
    (lwct-y (intern_trivial_string "erin")
            (intern_trivial_string "violet")))
(defn lwct-swap-output ()
    (lwct-y (intern_trivial_string "violet")
            (intern_trivial_string "erin")))

(defn lwct-correspondence-a ()
    (lwr-correspondence (lwct-x-a) (lwct-y-a)))
(defn lwct-correspondence-b ()
    (lwr-correspondence (lwct-x-b) (lwct-y-b)))
(defn lwct-correspondence-c ()
    (lwr-correspondence (lwct-x-c) (lwct-y-c)))
(defn lwct-correspondence-d ()
    (lwr-correspondence (lwct-x-d) (lwct-y-d)))

(defn lwct-offer (source payload provenance)
    (lwo-offer source (lwct-interface) 1 payload provenance 1))
(defn lwct-entry (source payload provenance)
    (lwt-entry (lwct-offer source payload provenance) (lwct-action)))
(defn lwct-yes-response (proposal)
    (lwt-response proposal (oac-one (lwt-proposal-candidate proposal))
                  (lwct-response-provenance)))
(defn lwct-yes-entry (source provenance proposal)
    (lwct-entry source (lwct-yes-response proposal) provenance))

(defn lwct-base-round ()
    (lwrr-tend (lwo-empty-world)
        (list
            (lwct-entry (lwct-source-a) (lwct-correspondence-a)
                        (lwct-provenance-a))
            (lwct-entry (lwct-source-b) (lwct-correspondence-b)
                        (lwct-provenance-b))
            (lwct-entry (lwct-source-c) (lwct-correspondence-c)
                        (lwct-provenance-c))
            (lwct-entry (lwct-source-d) (lwct-correspondence-d)
                        (lwct-provenance-d)))
        2 (lwo-none)))

(defn lwct-proposal-for-signature (items signature)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let proposal (head items))
            (let candidate (lwt-proposal-candidate proposal))
            (if (node_eq
                    (lwrr-mapping-signature
                        (lwo-emergent-shape candidate)) signature)
                proposal
                (lwct-proposal-for-signature (tail items) signature)))))

(defn lwct-identity-proposal (round)
    (lwct-proposal-for-signature
        (lwo-field-items (lwt-round-proposals round))
        (lwrr-signature-for (lwct-correspondence-a))))
(defn lwct-swap-proposal (round)
    (lwct-proposal-for-signature
        (lwo-field-items (lwt-round-proposals round))
        (lwrr-signature-for (lwct-correspondence-c))))

(defn lwct-four-yes-round (round proposal)
    (lwt-round-receive round
        (list
            (lwct-yes-entry (lwct-source-a) (lwct-provenance-a) proposal)
            (lwct-yes-entry (lwct-source-b) (lwct-provenance-b) proposal)
            (lwct-yes-entry (lwct-source-c) (lwct-provenance-c) proposal)
            (lwct-yes-entry (lwct-source-d) (lwct-provenance-d) proposal))))
(defn lwct-five-yes-round (round proposal)
    (lwt-round-receive (lwct-four-yes-round round proposal)
        (list (lwct-yes-entry
            (lwct-source-e) (lwct-provenance-e) proposal))))

(defn lwct-mapping-world ()
    (do
        (let base (lwct-base-round))
        (let identity-proposal (lwct-identity-proposal base))
        (let swap-proposal (lwct-swap-proposal base))
        (let identity-integrated
            (lwt-integrate (lwct-four-yes-round base identity-proposal)
                           identity-proposal (lwct-action)))
        (let swap-round
            (lwt-round (lwt-round-world identity-integrated)
                (lwo-field-add (lwo-empty-field) swap-proposal)
                (lwo-empty-field) identity-integrated))
        (let swap-integrated
            (lwt-integrate (lwct-four-yes-round swap-round swap-proposal)
                           swap-proposal (lwct-action)))
        (let focus
            (lwen-focus (lwct-unseen-input)
                (intern_trivial_string "lwct-enquiry-consent")))
        (lwt-receive-stream (lwt-round-world swap-integrated)
            (list (lwct-entry (lwct-source-e) focus
                              (lwct-provenance-e))))))

(defn lwct-contention-proposal (proposals)
    (lwct-contention-proposal-items (lwo-field-items proposals)))
(defn lwct-contention-proposal-items (items)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let proposal (head items))
            (let question
                (lwo-emergent-shape
                    (lwt-proposal-candidate proposal)))
            (if (node_eq (lwen-question-kind question)
                         (lwen-contention)) proposal
                (lwct-contention-proposal-items (tail items))))))

(defn lwct-routes-have-output? (items wanted)
    (if (eq (len items) 0) 0
        (if (node_eq (lwen-route-output (head items)) wanted) 1
            (lwct-routes-have-output? (tail items) wanted))))

(defn lwct-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwct-sum (tail items)))))
