// Scheduling boundaries preserve order, stop on refusal and finish the tap once.
// Pure observation; the live encounter verifies the same walk on Metal.
import native/metal/qwen35-dense-token-handle.fk;
section [form.bml] {
 class QwenPrefillTurnsBand {
  def qpt-bit(ok,bit) = ok ? bit : 0;
  def qpt-run(n,width,refuse) {
   let seen=record_new(0,"ranges",[]);
   let done=q38-prefill-turns(0,n,width,(l,end) => {
    record_set(seen,"ranges",append(record_get(seen,"ranges"),[[l,end]]));
    l != refuse;
   });
   [done,record_get(seen,"ranges")];
  }
 }
 let normal=qpt-run(64,4,0 - 1);
 let c1=qpt-bit(normal[0] == 1 && normal[1] == map(i=>[i*4,i*4+4],range(0,16)),1);
 let c2=qpt-bit(qpt-run(9,4,0 - 1) == [1,[[0,4],[4,8],[8,9]]],2);
 let c4=qpt-bit(qpt-run(9,4,4) == [0,[[0,4],[4,8]]],4);
 let c8=qpt-bit(qpt-run(0,4,0 - 1) == [1,[]] && qpt-run(9,0,0 - 1) == [0,[]],8);
 let taps=record_new(0,"calls",[]);
 let tap=(phase,l,n,pos) => { record_set(taps,"calls",append(record_get(taps,"calls"),[[phase,l,n,pos]])); 1; };
 let intermediate=q38-lm-layers-range-t([],[],[],[],[],4,4,9,7,3,1,tap);
 let c16=qpt-bit(intermediate == 1 && nil?(record_get(taps,"calls")),16);
 let final=q38-lm-layers-range-t([],[],[],[],[],9,9,9,7,3,1,tap);
 let c32=qpt-bit(final == 1 && record_get(taps,"calls") == [[1,9,7,3]],32);
 let unchanged=q38-lm-layers-span-t([],[],[],[],[],9,9,7,3,1,tap);
 let c64=qpt-bit(unchanged == 1 && record_get(taps,"calls") == [[1,9,7,3],[1,9,7,3]],64);
 let defaults=qpt-run(64,q38-prefill-turn-layers(),0 - 1);
 let c128=qpt-bit(defaults[0] == 1 && len(defaults[1]) >= 8 && all?(r => r[1] - r[0] <= 8,defaults[1]),128);
 let verdict=c1+c2+c4+c8+c16+c32+c64+c128;
 print(["prefill-turns",verdict]);
 verdict == 255 ? verdict : form_error("prefill turn boundary failed");
}
