; tests/bml-hati-native-unresolved-names-proof.fk
;
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk
;
; Closes unresolved-names at the lowering itself. A name or call the scope
; cannot resolve lowers to a named refusal literal in the table's string pool,
; never to a zero: walked directly it answers "BML-HATI-UNSUPPORTED <reason>",
; and an image assembled with an empty refusal-pass list still reads the reason
; out of its pool and stays unsupported. Names resolve through the unit's own
; package and through imports first; a receiver that is a value is named for
; the class-dispatch wave rather than guessed.

(do
    (defn score-bool (actual)
        (if actual 1 0))

    (defn score-int (actual expected)
        (if (eq actual expected) 1 0))

    (defn score-str (actual expected)
        (if (nil? actual)
            0
            (if (str_eq actual expected) 1 0)))

    (defn str-contains? (haystack needle)
        (ge (str_find haystack needle 0) 0))

    ; the canonical sources live in tests/fixtures, one program to a file
    (defn un-parse (name)
        (bml-source-parse-executable-stream
            (bml-source-scan-file (str_concat "form-stdlib/tests/fixtures/" name))))

    (defn un-node (name)
        (bml-source-exec-parse-node (un-parse name)))

    (defn un-image (name)
        (bml-hati-compile-image (un-node name)))

    (let lone
        (bml-hati-lower-node-in-env
            (bml-ast-return (bml-ast-name "missing"))
            (empty)
            (empty)))
    (let lone-image
        (bml-hati-image
            (list (bml-hati-lower-expr lone))
            (bml-hati-lower-pool lone)
            (bml-ast-name "missing")
            (empty)))
    (let lone-call
        (bml-hati-lower-node-in-env
            (bml-ast-return (bml-ast-call "Missing" (bml-ast-int 1)))
            (empty)
            (empty)))

    (let inc-node (head (bml-source-exec-parse-nodes (un-parse "bml-names-inc-method.bml"))))
    (let inc-env (bml-hati-bind-methods (list inc-node) (empty) 1))
    (let lone-arity
        (bml-hati-lower-node-in-env
            (bml-ast-call-args "Inc" (list (bml-ast-int 1) (bml-ast-int 2)))
            (empty)
            inc-env))
    (let lone-method-name
        (bml-hati-lower-node-in-env (bml-ast-name "Inc") (empty) inc-env))

    (let passed-image (bml-hati-compile-image (bml-ast-return (bml-ast-name "missing"))))
    (let not-method-image (un-image "bml-names-const-called.bml"))
    (let method-name-image (un-image "bml-names-method-as-value.bml"))
    (let receiver-image
        (un-image "bml-names-value-receiver.bml"))
    (let scoped-node (un-node "bml-names-own-package-const.bml"))
    (let foreign-image (un-image "bml-names-foreign-package-const.bml"))
    (let bmf-unit (un-node "bml-calls-unit-bmf.bml"))
    (let imported-node (un-node "bml-names-star-qualified.bml"))

    (sum
        (list
            (score-str (head (bml-hati-lower-pool lone)) "BML-HATI-UNSUPPORTED name/unbound")
            (score-str (fkm-run (list (bml-hati-lower-expr lone)) 0) "BML-HATI-UNSUPPORTED name/unbound")
            (score-bool (not (bml-hati-image-supported? lone-image)))
            (score-str (head (bml-hati-image-unsupported lone-image)) "name/unbound")
            (score-bool (str-contains? (bml-hati-table-file lone-image) "BML-HATI-UNSUPPORTED name/unbound"))
            (score-str (fkm-run (list (bml-hati-lower-expr lone-call)) 0) "BML-HATI-UNSUPPORTED call/unbound")
            (score-str (head (bml-hati-lower-pool lone-arity)) "BML-HATI-UNSUPPORTED call/arity")
            (score-str (head (bml-hati-lower-pool lone-method-name)) "BML-HATI-UNSUPPORTED name/method")
            (score-int (len (bml-hati-image-unsupported passed-image)) 1)
            (score-str (head (bml-hati-image-unsupported not-method-image)) "call/not-method")
            (score-str (fkm-run (bml-hati-image-fns not-method-image) 0) "BML-HATI-UNSUPPORTED call/not-method")
            (score-str (head (bml-hati-image-unsupported method-name-image)) "name/method")
            (score-str (head (bml-hati-image-unsupported receiver-image)) "call/receiver-dispatch")
            (score-str (fkm-run (bml-hati-image-fns receiver-image) 0) "BML-HATI-UNSUPPORTED call/receiver-dispatch")
            (score-int (bml-hati-run-value scoped-node) 42)
            (score-int (bma-run-value (bml-compile-unit-program scoped-node (empty))) 42)
            (score-str (head (bml-hati-image-unsupported foreign-image)) "name/unbound")
            (score-str (fkm-run (bml-hati-image-fns foreign-image) 0) "BML-HATI-UNSUPPORTED name/unbound")
            (score-bool (bml-hati-image-supported? (bml-hati-compile-unit-image imported-node (list bmf-unit))))
            (score-int (bml-hati-run-unit-value imported-node (list bmf-unit)) 42))))
