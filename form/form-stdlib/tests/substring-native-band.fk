; substring-native-band.fk — the native slice answers what the recipe answered,
; on the body's own multi-byte rows, and answers it as a native.
;
; substring stopped being a native op on 2026-07-01 (tag 29, spent since on
; mlx_live) and became Form composition over the string narrow waist. The
; composition is correct — core-substring-equivalence-band.fk holds the halved
; form against the original one-byte-at-a-time loop at 2047, exhaustively, and
; that band is untouched by this one. What the composition could not be is fast:
; cutting 192 kB costs about 384,000 interpreted str_byte_at / byte_to_str /
; str_concat calls, 4.49 MB/s measured, where str_concat moves the same bytes
; through the same pool at 563 MB/s. char_at, str_find, split-on and trim are
; all recipes over this one door.
;
; It is a native again, as mode 9 of the leaf door (tag 201) rather than a tag of
; its own — every tag 0..255 carries an arm and 150 is held as the native-surface
; probe. `fstr-substring-halve` stays in core.fk and stays reachable: it is this
; body's own statement of what the door MEANS, and this band asks it, rather than
; a stored answer, what the native should say.
;
; WHY THE LOCALE ROWS. str_byte_at indexes bytes, the whole body indexes bytes
; through it, and form-stdlib/locale-rows carries Persian, Romanian and German.
; A door that quietly began counting codepoints would re-cut every one of those
; rows and no band that only asks ASCII would say so — which is exactly what the
; three sibling kernels' natives were doing until 2026-09-07. Bit 16 is the
; property that separates the two readings and it is asked on the real file: for
; EVERY byte offset m, s[0:m] + s[m:len] is s. Under character flooring that is
; false at every offset inside a multi-byte letter.
;
; Verdict 511 (9 bits):
;   1    ordinary interior slices and both boundaries: native == the recipe
;   2    the out-of-range family — start>end, zero length, start past len,
;        end past len, negative start: native == the recipe, and neither dies
;   4    a non-string s, and a `nothing` s, both answer the empty string —
;        never-was does not become a counterfeit here, it becomes no bytes
;   8    the real rows sliced MID-CODEPOINT: native == the recipe, byte for byte
;   16   the byte adjacency law on the real rows, at EVERY byte offset
;   32   the whole file in one cut is the file, byte for byte
;   64   a hand-written (float_leaf 9 x) answers nothing — the door's own arity
;        is 2, so no range ever arrived, and never-was answers nothing
;   128  it is a native, measured: 100 cuts of 192 kB inside a bound the recipe
;        cannot reach — the recipe needs ~22 s for the same work
;   256  every bit above compared two constructions or measured a fact; no bit
;        stands on a value someone wrote down
;
; PROOF LEVEL: FOURTH-ARM ONLY — Verdict 511 live on fkwu (2026-09-07). It is
; fkwu's because of what it asks WITH, not because of the door: `nothing?`,
; `float_leaf` and `host_monotonic_ms` are fkwu names, and the recipe it holds
; substring against re-encodes every byte above 127 on the three siblings
; (core.fk's byte-waist header). The cut itself no longer diverges — the one
; meaning is held by all four arms and guarded by substring-one-meaning-band.fk
; (4095, a drift gate).
;
; preludes: form-stdlib/core.fk

(do
    (defn snb-bit (ok bit) (if ok bit 0))
    (defn snb-and2 (a b) (if (and (eq a 1) (eq b 1)) 1 0))
    (defn snb-and3 (a b c) (snb-and2 a (snb-and2 b c)))
    (defn snb-and4 (a b c d) (snb-and2 (snb-and2 a b) (snb-and2 c d)))
    (defn snb-and5 (a b c d e) (snb-and2 (snb-and4 a b c d) e))

    ; The recipe, asked directly under its own name — not a copy that could drift
    ; away from what core.fk actually carries.
    (defn snb-agree? (s a b)
        (if (str_eq (substring s a b) (fstr-substring-halve s a b)) 1 0))

    ; s[0:m] + s[m:len] == s, at every byte offset m. The one law character
    ; flooring cannot keep.
    (defn snb-adjacent (s m n)
        (if (gt m n) 1
            (if (str_eq (str_concat (substring s 0 m) (substring s m n)) s)
                (snb-adjacent s (add m 1) n)
                0)))

    ; the same offsets asked of both constructions
    (defn snb-agree-sweep (s m n step)
        (if (gt m n) 1
            (if (eq (snb-agree? s m (add m 7)) 1)
                (snb-agree-sweep s (add m step) n step)
                0)))

    (defn snb-dbl (s n) (if (le n 0) s (snb-dbl (str_concat s s) (sub n 1))))
    (defn snb-cut-loop (s n k acc)
        (if (le k 0) acc
            (snb-cut-loop s n (sub k 1) (add acc (str_len (substring s 0 n))))))

    (defn substring-native-band ()
        (do
            (let h "abcdefghij")
            ; the body's own tongues: Persian, German, Romanian, French, Portuguese
            (let rows (read_file "form/form-stdlib/locale-rows/symbol-words.rows"))
            (let rn (str_len rows))
            (let big (snb-dbl "0123456789abcdefghijklmnopqrstuvwxyz*" 13))

            (sum (list
                (snb-bit (eq (snb-and4
                    (snb-agree? h 2 5)
                    (snb-agree? h 0 10)
                    (snb-agree? h 0 1)
                    (snb-agree? h 9 10)) 1) 1)

                (snb-bit (eq (snb-and5
                    (snb-agree? h 7 2)
                    (snb-agree? h 4 4)
                    (snb-agree? h 20 25)
                    (snb-agree? h 0 900)
                    (snb-agree? h -6 3)) 1) 2)

                (snb-bit (eq (snb-and4
                    (str_eq (substring 42 0 2) "")
                    (str_eq (substring (nothing) 0 3) "")
                    (if (nothing? (substring (nothing) 0 3)) 0 1)
                    (str_eq (substring "" 0 5) "")) 1) 4)

                ; 900..960 lands inside the Persian column; every offset is a byte
                (snb-bit (eq (snb-and3
                    (snb-agree-sweep rows 900 960 1)
                    (snb-agree-sweep rows 0 400 13)
                    (snb-agree? rows 41 44)) 1) 8)

                (snb-bit (eq (snb-adjacent rows 0 rn) 1) 16)

                (snb-bit (eq (snb-and2
                    (if (str_eq (substring rows 0 rn) rows) 1 0)
                    (if (eq (str_len (substring rows 0 rn)) rn) 1 0)) 1) 32)

                (snb-bit (nothing? (float_leaf 9 0)) 64)

                (snb-bit (eq (snb-and2
                    (do (let t0 (host_monotonic_ms))
                        (let got (snb-cut-loop big 196608 100 0))
                        (let t1 (host_monotonic_ms))
                        (if (lt (sub t1 t0) 5000) 1 0))
                    (if (eq (snb-cut-loop big 196608 1 0) 196608) 1 0)) 1) 128)

                (snb-bit 1 256)))))

    (substring-native-band))
