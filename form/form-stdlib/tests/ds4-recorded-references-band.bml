; ds4-recorded-references-band.bml — what the Form-native DeepSeek V4 lane is validated against with NO ds4 process.
;
; THE REFERENCES WERE EARNED ON THE IQ2XXS FILE, NOT ON REAP25. ds4 ran against ds4flash.gguf, the symlink to
; DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf (86,720,111,488 bytes); it refuses the reap25 file
; (types 40 and 41, "unsupported GGUF type"), which is the file the registry row "ds4flash" now names. A native lane that
; reads the IQ2XXS file (Q2_K experts, Q8_0 projections: the mixes q2k-dequant, iq2xxs-dequant and q8-0-msl carve) is what
; these numbers can judge; a native lane on reap25 is judged by the Form reference (tests/dsv4-oracle-recipes-band.bml and the
; oracle) and not by these. Bit 128 holds that distinction in the open.
;
; WHAT IS RECORDED (read from the recording, never recomputed here):
;   the stream: `ds4 -m ds4flash.gguf --raw-prompt --temp 0 -n 25 -p "The capital of France is"` gave, for the raw prompt ids
;     [671 6102 294 8760 344], the greedy continuation of 24 tokens
;       [11111 16 455 6102 294 8760 344] three times and then [11111 16 455]: " Paris. The capital of France is", a cycle of
;     period 7 (receipts/2026-07-30-order-match.md:63 at 93154a720, where the Form lane matched all 24, 190 gates, 3m15s)
;   the logits: `ds4 --dump-logits` on the 14-token chat-templated prompt: tests/oracles/ds4-logits-capital-of-france.json,
;     1,588,387 bytes (git blob 695d9c5dc), 129,280 logits, argmax 2581 "We" at 36.7579117
;   the logits' prompt: the recording carries only "prompt_tokens":14 and ctx 32768; its 14 ids are the row beside it,
;     tests/oracles/ds4-logits-capital-of-france-prompt.json: BOS 0, the default system "You are a helpful assistant" [3476 477 260 11502 22896],
;     User 128803, the prompt [671 6102 294 8760 344], Assistant 128804, <think> 128821 (ds4's own template: ds4.c:36195, ds4_cli.c:1767 and :1774)
;
; THE RADIUS, declared. One prompt; a cycle (the easy case: the same states recur, so few distinct ties are exercised); never
; past position 127 (the ratio-128 layers' compressed rows have never run on a device). 24 matched tokens on this prompt is the
; claim, not 1000 on any prompt. An off-cycle witness needs a recording the tree does not hold.
;
; Verdict 8191 when every claim lands:
;   1     the recorded stream is pinned: 24 ids, the first seven [11111 16 455 6102 294 8760 344], period 7 over the whole stream,
;         and its tail from 6102 on repeats the raw prompt's own tail [6102 294 8760 344]
;   2     the raw prompt ids [671 6102 294 8760 344] are what the Form tokenizer encodes "The capital of France is" to, and decode
;         back to its bytes
;   4     the 7-token cycle decodes, through the Form tokenizer, to the bytes of " Paris. The capital of France is"
;   8     and that text encodes back to the cycle
;   16    the recorded logits file is the one recorded: 1,588,387 bytes, source ds4, model ds4flash.gguf, 14 prompt tokens, vocab
;         129,280, quant_bits 2, argmax_token id 2581 "We" (bytes 87 101)
;   32    it holds 129,280 logits and the scan finds the argmax at 2581 with 36.7579117 (to 1e-6) and its first, 2581st and last
;         values as recorded
;   64    the recorded argmax id decodes, through the Form tokenizer, to the bytes the recording names ("We")
;   128   the distinction is held: the recording says ds4flash.gguf (the IQ2XXS build) while the registry row "ds4flash" names the
;         reap25 file, so these references do not judge a reap25 lane
;   256   the recorded logits are pinned by value: the SHA-256 of the whole 1,588,387 bytes, taken by the body's own door (the
;         Form-emitted CPU SHA admission, bml/sha256-owned.bml, 0.5 s on this file) equals
;         3898af1731936bf0a59d0c0ce01a60df62f54b9b64552673c7f93df3b7c79d27, so a same-length edit of one logit reads
;   512   the door that took that digest answers the FIPS 180-4 vectors: "abc" is ba7816bf..f20015ad and the empty file e3b0c442..b855
;         (a pin by a hash is only as good as the hash)
;   1024  the logits' 14 prompt ids are DERIVED, not typed: bml/dsv4-chat-template.bml (BOS, the default system, User, the prompt, Assistant, <think>) over the IQ2XXS header's own
;         tokenizer gives exactly the row's ids, 14 of them, the number the recording says ("prompt_tokens":14); the system is 5 ids and the prompt's 5 are the raw prompt of claim 2
;   2048  the markers come from the file: BOS read by its bytes equals the header's tokenizer.ggml.bos_token_id (0) and the row's first id; User, Assistant and <think> read by their bytes equal
;         the row's; and detokenizing the 14 ids gives, byte for byte, the template's text built from the template alone. A missing marker reads nothing, never a guess
;   4096  the template is not fitted to this one recording: the same code over the same tokenizer gives the token counts the official DeepSeek API reported for three prompts with no system
;         text and thinking disabled (tests/test-vectors/official/*.official.json of the ds4 checkout, usage.prompt_tokens 21, 18, 27); and four plants each read a different list from the pin: the
;         system dropped (9 ids), the system with a closing full stop, thinking off (</think> 128822 last), the BOS dropped (13 ids), a different prompt
;
; The scan of bit 32 reads the argmax and three values; only bit 256 reads every byte. A digest of strided samples would
; leave an edit between the samples unread, so the whole file is hashed.
;
; PROOF LEVEL: FOURTH-ARM ONLY -- bits 2, 4, 8, 64 and 128 read the model file's header (8 MB window; a host-local path outside the tree,
; reap25's, which shares the vocabulary and merges with the IQ2XXS file) and the recorded logits are 1.5 MB read through
; read_file_slice; bits 1024, 2048 and 4096 read the IQ2XXS file's header (the same 8 MB window) for the chat template. No weight is read; no ds4 and no model process runs.
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/dsv4-tokenizer.fk form-stdlib/model-registry.bml form-stdlib/bml/sha256-owned.bml form-stdlib/bml/dsv4-chat-template.bml
section [form.bml] {
 class Ds4RecordedReferencesBand {
  def drr-hex(d, i) = i == len(d) ? "" : (substring("0123456789abcdef", str_byte_at(d, i) / 16, (str_byte_at(d, i) / 16) + 1) ++ substring("0123456789abcdef", str_byte_at(d, i) % 16, (str_byte_at(d, i) % 16) + 1) ++ drr-hex(d, i + 1));
  // the SHA-256 of a whole file by the body's own door, as hex ("" when the door refuses)
  def drr-sha(path) { let d = record_get(sho-file(path), "digest"); len(d) == 32 ? drr-hex(d, 0) : ""; }
  def drr-digest-ok() = drr-sha(drr-path()) == "3898af1731936bf0a59d0c0ce01a60df62f54b9b64552673c7f93df3b7c79d27";
  def drr-vectors-ok() {
   let abc = temp_dir() ++ "/drr-abc-" ++ now_unix_ms().str() ++ ".txt";
   let none = temp_dir() ++ "/drr-empty-" ++ now_unix_ms().str() ++ ".txt";
   let w1 = write_file(abc, "abc");
   let w2 = write_file(none, "");
   let ok = drr-sha(abc) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" && drr-sha(none) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
   let r1 = host_path_remove(abc);
   let r2 = host_path_remove(none);
   ok;
  }
  def drr-bit(held, bit) = held ? bit : 0;
  def drr-has?(s, part) = str_find(s, part, 0) >= 0;
  def drr-path() = "form/form-stdlib/tests/oracles/ds4-logits-capital-of-france.json";
  def drr-stream() = [11111, 16, 455, 6102, 294, 8760, 344, 11111, 16, 455, 6102, 294, 8760, 344, 11111, 16, 455, 6102, 294, 8760, 344, 11111, 16, 455];
  def drr-cycle() = [11111, 16, 455, 6102, 294, 8760, 344];
  def drr-prompt() = [671, 6102, 294, 8760, 344];
  def drr-period(xs, i) = i + 7 >= len(xs) ? true : (xs[i] == xs[i + 7] && drr-period(xs, i + 1));
  def drr-bytes(s, i) = i == len(s) ? [] : cons(str_byte_at(s, i), drr-bytes(s, i + 1));
  def drr-tkz() = tkz-src(mr-path(mr-find("ds4flash")));

  // ---- 1
  def drr-stream-ok() = len(drr-stream()) == 24 && drr-stream()[0:7] == drr-cycle() && drr-period(drr-stream(), 0) && drr-stream()[3:7] == drr-prompt()[1:5] && drr-stream()[10:14] == drr-prompt()[1:5];

  // ---- 2, 4, 8
  def drr-prompt-ok() {
   let src = drr-tkz();
   tkz-encode(src, "The capital of France is") == drr-prompt() && tkz-decode-bytes(src, drr-prompt()) == drr-bytes("The capital of France is", 0);
  }
  def drr-decode-ok() = tkz-decode-bytes(drr-tkz(), drr-cycle()) == drr-bytes(" Paris. The capital of France is", 0);
  def drr-encode-ok() = tkz-encode(drr-tkz(), " Paris. The capital of France is") == drr-cycle();

  // ---- 16
  def drr-file-ok(text) = len(text) == 1588387 && drr-has?(text, "\"source\":\"ds4\"") && drr-has?(text, "\"model\":\"ds4flash.gguf\"") && drr-has?(text, "\"prompt_tokens\":14,")
   && drr-has?(text, "\"vocab\":129280,") && drr-has?(text, "\"quant_bits\":2,") && drr-has?(text, "\"argmax_token\":{\"id\":2581,\"text\":\"We\",\"bytes\":[87,101]}");

  // ---- 32: the logits, scanned
  def drr-pieces(text) {
   let at = str_find(text, "\"logits\":[", 0);
   let end = str_find(text, "]", at);
   split-on(substring(text, at + 10, end), ",");
  }
  def drr-value(piece) = str_to_float(trim(piece));
  def drr-scan(pieces, i, bestAt, best) = i == len(pieces) ? [bestAt, best] : (drr-value(pieces[i]) > best ? drr-scan(pieces, i + 1, i, drr-value(pieces[i])) : drr-scan(pieces, i + 1, bestAt, best));
  def drr-near(a, b, tol) = (a - b) <= tol && (b - a) <= tol;
  def drr-logits-ok(text) {
   let pieces = drr-pieces(text);
   let top = drr-scan(pieces, 0, -1, -1000000.0);
   len(pieces) == 129280 && top[0] == 2581 && drr-near(top[1], 36.7579117, 0.000001) && drr-near(drr-value(pieces[0]), -9.25880527, 0.000001)
    && drr-near(drr-value(pieces[2581]), 36.7579117, 0.000001) && drr-near(drr-value(pieces[129279]), -39.012825, 0.000001);
  }

  // ---- 64
  def drr-argmax-ok() = tkz-decode-id-bytes(drr-tkz(), 2581) == [87, 101];

  // ---- 128
  def drr-held-apart(text) = drr-has?(text, "\"model\":\"ds4flash.gguf\"") && drr-has?(mr-path(mr-find("ds4flash")), "reap25") && !drr-has?(mr-path(mr-find("ds4flash")), "IQ2XXS");

  // ---- 1024, 2048, 4096: the logits' prompt ids, derived from the IQ2XXS header and held to the row beside the recording
  def drr-iq2() = "/Users/ursmuff/models/ds4-engine/gguf/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf";
  def drr-row-path() = "form/form-stdlib/tests/oracles/ds4-logits-capital-of-france-prompt.json";
  def drr-row() = parse-json("ds4-recorded-prompt", read_file_slice(drr-row-path(), 0, 8192));
  def drr-row-ints(row, key) = map(n => json-int-value(n), json-array-elements(json-object-get(row, key)));
  def drr-row-int(row, key) = json-int-value(json-object-get(row, key));
  def drr-row-text(row, key) = json-string-value(json-object-get(row, key));
  def drr-count(src, system, prompt, thinking) = len(dct-ids(src, system, prompt, thinking));
  def drr-derive-ok(text) {
   let src = tkz-src(drr-iq2());
   let row = drr-row();
   let pin = drr-row-ints(row, "ids");
   let system = drr-row-text(row, "system");
   let prompt = drr-row-text(row, "prompt");
   let ids = dct-ids(src, system, prompt, drr-row-int(row, "thinking") == 1);
   let sys = dct-system-ids(src, system);
   system == dct-system-default() && prompt == "The capital of France is" && ids == pin && len(ids) == 14 && drr-has?(text, "\"prompt_tokens\":14,") && drr-row-int(row, "prompt_tokens") == 14
    && len(sys) == 5 && sys == drr-row-ints(row, "system_ids") && ids[7:12] == drr-prompt() && drr-row-ints(row, "prompt_ids") == drr-prompt();
  }
  def drr-markers-ok() {
   let src = tkz-src(drr-iq2());
   let row = drr-row();
   let ids = drr-row-ints(row, "ids");
   let broken = dct-assemble(0 - 1, 1, 2, 3, [], []);
   dct-bos(src) == dct-bos-meta(src) && dct-bos(src) == ids[0] && dct-bos(src) == drr-row-int(row, "bos") && dct-user(src) == drr-row-int(row, "user") && dct-assistant(src) == drr-row-int(row, "assistant")
    && dct-think(src, true) == drr-row-int(row, "think") && ids[6] == dct-user(src) && ids[12] == dct-assistant(src) && ids[13] == dct-think(src, true)
    && dct-decode(src, ids, true) == dct-text-bytes(drr-row-text(row, "system"), drr-row-text(row, "prompt"), true) && nothing?(broken) && dct-id-of(src, dct-ascii("<nosuchmarker>")) == 0 - 1;
  }
  def drr-official-ok() {
   let src = tkz-src(drr-iq2());
   drr-count(src, "", "Rispondi in italiano con una frase: chi era Ada Lovelace?", false) == 21 && drr-count(src, "", "Answer with only the number: 2048 divided by 128 is", false) == 18
    && drr-count(src, "", "Complete the C statement with the next exact token only:\nreturn snprintf(buf, sizeof(buf), \"%d\", value", false) == 27;
  }
  def drr-plants-ok() {
   let src = tkz-src(drr-iq2());
   let row = drr-row();
   let pin = drr-row-ints(row, "ids");
   let system = drr-row-text(row, "system");
   let prompt = drr-row-text(row, "prompt");
   let bare = dct-ids(src, "", prompt, true);
   let stopped = dct-ids(src, system ++ ".", prompt, true);
   let nothink = dct-ids(src, system, prompt, false);
   let nobos = pin[1:len(pin)];
   let other = dct-ids(src, system, "The capital of Spain is", true);
   len(bare) == 9 && !(bare == pin) && !(stopped == pin) && !(nothink == pin) && nothink[13] == 128822 && len(nobos) == 13 && !(nobos == pin) && !(other == pin);
  }
 }
 let text = read_file_slice("form/form-stdlib/tests/oracles/ds4-logits-capital-of-france.json", 0, 1600000);
 // a claim that stops reads as a dark bit, not as a stopped band
 let c1 = drr-bit(try drr-stream-ok() catch false, 1);
 let c2 = drr-bit(try drr-prompt-ok() catch false, 2);
 let c4 = drr-bit(try drr-decode-ok() catch false, 4);
 let c8 = drr-bit(try drr-encode-ok() catch false, 8);
 let c16 = drr-bit(try drr-file-ok(text) catch false, 16);
 let c32 = drr-bit(try drr-logits-ok(text) catch false, 32);
 let c64 = drr-bit(try drr-argmax-ok() catch false, 64);
 let c128 = drr-bit(try drr-held-apart(text) catch false, 128);
 let c256 = drr-bit(try drr-digest-ok() catch false, 256);
 let c512 = drr-bit(try drr-vectors-ok() catch false, 512);
 let c1024 = drr-bit(try drr-derive-ok(text) catch false, 1024);
 let c2048 = drr-bit(try drr-markers-ok() catch false, 2048);
 let c4096 = drr-bit(try drr-official-ok() && drr-plants-ok() catch false, 4096);
 print_str("ds4-recorded-references-band claims " ++ c1.str() ++ " " ++ c2.str() ++ " " ++ c4.str() ++ " " ++ c8.str() ++ " " ++ c16.str() ++ " " ++ c32.str() ++ " " ++ c64.str() ++ " " ++ c128.str() ++ " " ++ c256.str() ++ " " ++ c512.str() ++ " " ++ c1024.str() ++ " " ++ c2048.str() ++ " " ++ c4096.str());
 c1 + c2 + c4 + c8 + c16 + c32 + c64 + c128 + c256 + c512 + c1024 + c2048 + c4096;
}
