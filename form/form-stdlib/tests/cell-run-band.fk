; cell-run-band.fk — cell_run: a unit of Form run in THIS process answers a record, and the record is what a spawned ./fkwu said.
;
; The body used to run its own cells as children and read a text protocol back: the last line of stdout as the value, the lines
; of stderr as diagnostics, the exit as the verdict. cell_run(path, arg, deadline_ms, stdin) answers {value, out, diag, stopped,
; errors, resident, ms, cpu_us} as a value, with nothing begun (docs/in-process-cells.md). The oracle here is the thing being
; replaced: each case runs the same unit as a child (this band is the one place that still spawns a cell, on purpose) and the
; record is held to it. A unit of the tree and a unit of the fixtures alike:
;
;   1      pure text: voice-chunk-band answers its 4095, prints what it printed, has no source diagnostic, exits 0 spawned and in process
;   2      a band that reads the kernel's own AST (kernel_ast): anf-shadow-band
;   4      a band that reads and writes files: file-bytes-band
;   8      substring-one-meaning-band        16   str-find-one-meaning-band
;   32     a cell that prints 20000 lines: out is all of them, value is the 5 the spawned run printed last
;   64     a cell that stops (the length of nothing): stopped names the recipe and the unit, the spawned stderr says the same
;          line and exits 1, the value is nothing and what it printed before the stop is out
;   128    a cell that calls a name nothing defines: errors is 1 as the spawned exit is, diag is the spawned organ-health row
;          (observed binding-missing), the value is the 7 it runs on to
;   256    stdin is a value: two lines and the end of input read back as the spawned run reads them from a file
;   512    a high-grammar cell (.bml) with a top-level let and a statement
;   1024   a resident call (the unit already parsed) answers what the first call answered, resident 1, diag replayed
;   2048   scope: two cells define crs-pick differently and prelude one library; each answers its own, in any order, and a third
;          that defines neither is told the names are unbound (errors 1) although both are resident. A library change
;          drops a retained binding: the same root answers the new body, its admission identity moves, a fresh load
;          counts 2 source units and 3 source functions, and the resident call parses nothing
;   4096   a budget: a cell that never ends comes back stopped "deadline" within 250 ms of its 300 ms, with what it printed
;   8192   freshness: a cell rewritten to the same length inside the same second is the new cell
;   16384  nesting: a cell that runs a cell that stops goes on, its own output intact, and reads the stop as a value
;   32768  500 resident calls grow the process by less than 8 MB, every one resident
;   65536  a call that cannot be made (the unit is not a path; the deadline is not a number; stdin is not lines) is a stopped
;          record "refused", never a crash
;   131072 nothing was begun: no fkwu child of this process stands when the calls are done
;   262144 the spawned oracle ran and agreed with itself (a unit run twice as a child answers the same twice)
;   524288 stdin is a value for file_read(0, n) too: a cell that reads its input as bytes gets the two lines the call passed (7 bytes), then ""
;   1048576 isolation: after a gate cell has been loaded (gate/op-manifest.bml), a cell loaded next resolves its own names (fact.fk answers 3628800
;          with no unresolved-call): reused rows resolve their owner and every same-named nil? definition retains its own body
;
;   2097152 a sequence of bands in one process, after a gate and again resident: boot-band answers 9 and base64-band 12 each time, no stop (the
;          sweep shards that died with SIGBUS after ~50 minutes did not reproduce on this sequence, nor with arg-order-lane-parity-band in it
;          three times, 2026-10-04; that band is a hundred seconds, so the claim keeps the two quick ones)
;
;   4194304 a cold load of two .bml units that name each other ends in seconds and answers (cyc-a.bml + cyc-b.bml, memos removed first): a
;          collection asked whether a unit it had just registered was fresh, found its lowered text unlike its file, set it aside and collected it
;          again until the thread's stack ended -- SIGBUS after the stack guard, in every sweep shard that met a cycle (2026-10-04)
;
;   8388608 a unit that closes its JIT pages answers the same the second time it runs in one process (anf-shadow-band: 31 then 31; it read 31
;          then 3, because the node a cell released at its close is the node the next run mints, and the release held the second run's pages shut)
;
; A binary without the cell_run door says "door absent" by name and answers 0.
;
; Expected: 16777215
; Verdict 16777215
; REQUIRES: (cell_run is a seed door, leaf-door mode 35; the sibling kernels carry no host doors)
; preflight-exec: forbidden
; preludes: form/form-stdlib/core.fk form/form-stdlib/line-grammar.fk form/form-stdlib/organ-health.bml
section [form.bml] {
  def crb-bit(ok, bit) = ok ? bit : 0;
  def crb-say(label, v) = print([label, v]);
  def crb-dir() = temp_dir() ++ "/cell-run-band." ++ host_pid().str();
  def crb-fx(name) = "form/form-stdlib/tests/fixtures/cell-run/" ++ name;
  def crb-join(xs, sep) = nil?(xs) ? "" : nil?(xs[1:]) ? xs[0] : xs[0] ++ sep ++ crb-join(xs[1:], sep);
  def crb-starts?(s, p) = len(s) >= len(p) && (String) substring(s, 0, len(p)) == p;
  def crb-bound-nil() = all?(j=>{
    let d=kernel_ast(host_pid(),["defn",j]);
    let name=kernel_ast(host_pid(),["src",d[0],d[1]]);
    name != "nil?" ? true : {
      let body=kernel_ast(host_pid(),d[3]);
      d[3] != 0 && (body[0] != 194 || body[2] != 0);
    };
  },range(0,kernel_ast(host_pid(),-1)[2]));
  // ---- the oracle: the same unit as a child, its streams read back as text
  // a fixture's image is dropped before the child runs: a child that reads its image back does not compile, and it is the
  // compile that voices a diagnostic. A raw cell whose current image matches is admitted and not parsed; these fixtures
  // are dropped first, so the in-process cell of this band still parses once
  def crb-stem(p) = len(p) > 3 && (String) substring(p, len(p) - 3, len(p)) == ".fk" ? substring(p, 0, len(p) - 3) : p;
  def crb-uncache(cell) = str_find(cell, "fixtures/cell-run/", 0) >= 0 ? host_path_remove(crb-stem(cell) ++ ".fkb") + host_path_remove(crb-stem(cell) ++ ".sym") + host_path_remove(cell ++ ".fkb") + host_path_remove(cell ++ ".sym") : 0;
  def crb-oracle(cell, stdin-path, n) {
    let uncached = crb-uncache(cell);
    let out = crb-dir() ++ "/" ++ n.str() ++ ".out";
    let err = crb-dir() ++ "/" ++ n.str() ++ ".err";
    let gone = host_path_remove(out) + host_path_remove(err);
    let pid = host_spawn_at(["./fkwu", cell], [stdin-path, out, err]);
    let rc = host_wait(pid);
    [rc, read_file(out) ?? "", read_file(err) ?? ""];
  }
  def crb-field(line, key) {
    let at = str_find(line, "\"" ++ key ++ "\":\"", 0);
    let from = at + len(key) + 4;
    at < 0 ? "" : substring(line, from, str_find(line, "\"", from));
  }
  // the organ-health rows a spawned run voiced, less the image rebuilds a cold cache adds
  def crb-health(err) = split-on(err, "\n") |> filter(l => crb-starts?(l, "form-organ health {") && !crb-starts?(crb-field(l, "aspect"), "image:"));
  def crb-observed-oracle(err) = crb-join(map(l => crb-field(l, "observed"), crb-health(err)), "|");
  def crb-observed(r) = crb-join(map(g => (String) record_get(g, "observed"), filter(g => !crb-starts?((String) record_get(g,"aspect"),"image:"),record_get(r,"diag"))), "|");
  def crb-last-line(text) {
    let lines = split-on(trim(text), "\n");
    nil?(lines) ? "" : lines[len(lines) - 1];
  }
  def crb-render(v) = (String) value_kind(v) == "int" ? v.str() : (String) value_kind(v) == "string" ? v : value_str(v);
  def crb-stopped(r) = record_get(r, "stopped");
  def crb-said(r) {
    let s = crb-stopped(r);
    (String) record_get(s, "message") ++ " -- in " ++ (String) record_get(s, "recipe") ++ " (" ++ (String) record_get(s, "unit") ++ ")";
  }
  // the record held to the child: a unit that ran to its end printed its value last; a unit that stopped died with its line
  def crb-same(r, o) {
    nothing?(crb-stopped(r))
      ? ((Comparable) o[0] == ((Comparable) record_get(r, "errors") > 0 ? 1 : 0))
        && ((String) o[1] == (String) record_get(r, "out") ++ crb-render(record_get(r, "value")) ++ "\n")
        && ((String) crb-observed-oracle(o[2]) == (String) crb-observed(r))
      : ((Comparable) o[0] == 1)
        && ((String) o[1] == (String) record_get(r, "out"))
        && ((String) crb-last-line(o[2]) == (String) crb-said(r));
  }
  def crb-case(cell, n) {
    let first = crb-oracle(cell, "/dev/null", n);
    let again = crb-oracle(cell, "/dev/null", n + 1000);
    let r = cell_run(cell, 0, nothing(), nothing());
    let shown = crb-say(cell, [first[0], record_get(r, "errors"), record_get(r, "ms"), crb-render(record_get(r, "value"))]);
    let same = crb-same(r, again);
    same ? 0 : print(["cell-run-oracle-mismatch",cell,"oracle",again,"actual",record_get(r,"value"),record_get(r,"diag"),record_get(r,"out"),record_get(r,"stopped")]);
    [same, (Comparable) first[0] == again[0] && (String) first[1] == (String) again[1], r];
  }
  def crb-rss() {
    let rows = host_processes("fkwu*");
    let mine = filter(x => (Comparable) x[0] == host_pid(), rows);
    nil?(mine) ? 0 : mine[0][1];
  }
  def crb-children() = len(filter(x => (Comparable) x[5] == host_pid(), host_processes("fkwu*")));
  def crb-door?() = nothing?(cell_run(0, 0, nothing(), nothing())) ? 0 : 1;
  def crb-absent() {
    let shown = print(["cell-run-band", "door absent: this fkwu has no cell_run; rebuild it (cc -O2 -o fkwu.new runtime/fkwu-uni.c)"]);
    let verdict = print(["cell-run-band", "verdict", 0]);
    0;
  }
  def crb-repeat(n, cell) = n <= 0 ? 0 : crb-repeat-one(n, cell, cell_run(cell, 0, nothing(), nothing()));
  def crb-repeat-one(n, cell, r) = (Comparable) record_get(r, "resident") == 1 ? crb-repeat(n - 1, cell) : 1000000;
  def crb-image-count(path) = { let bytes = read_file(path); nothing?(bytes) ? 0 : len(bytes); };
  def crb-image-fixtures(directory) {
    host_dir_mkdir(directory);
    let library = directory + "/library.fk"; let a = directory + "/a.fk"; let b = directory + "/b.fk";
    let libraryEffects = directory + "/library-effects"; let rootEffects = directory + "/root-effects";
    write_file(library,"(defn crb-img-f () 1)\n(let crb-img-saved crb-img-f)\n(let crb-img-held (record_new 0 \"n\" 7))\n(defn crb-img-owner () crb-img-held)\n"
      + "(defn crb-img-same (s) (str_eq s \" \"))\n(defn crb-img-strings (n s acc) (if (le n 0) acc (crb-img-strings (sub n 1) s (add acc (crb-img-same s)))))\n"
      + "(do (let before (read_file \"" + libraryEffects + "\")) (write_file \"" + libraryEffects + "\" (if (nothing? before) \"L\" (str_concat before \"L\"))) 0)\n");
    let source = "; preludes: " + library + "\n(defn crb-img-answer () (record_new 0 \"n\" (record_get (crb-img-owner) \"n\") \"owner\" (crb-img-owner) \"same\" (eq crb-img-saved crb-img-f) \"fn\" crb-img-f \"matches\" crb-img-strings))\n"
      + "(do (let before (read_file \"" + rootEffects + "\")) (write_file \"" + rootEffects + "\" (if (nothing? before) \"R\" (str_concat before \"R\"))) (crb-img-answer))\n";
    write_file(a,source); write_file(b,source); [a,b,libraryEffects,rootEffects];
  }
  def crb-image-disk-reuse() {
    let directory = crb-dir() + "/disk-reuse"; let paths = crb-image-fixtures(directory); let driver = directory + "/driver.fk";
    let builder = kernel_ast(host_pid(),["identity"])[0];
    let source = "(do\n(defn crb-img-good (r) (and (eq (record_get r \"errors\") 0) (nothing? (record_get r \"stopped\"))))\n"
      + "(defn crb-img-zero (r) (and (eq (record_get r \"source_units\") 0) (eq (record_get r \"source_functions\") 0)))\n"
      + "(defn crb-img-count (p) (do (let s (read_file p)) (if (nothing? s) 0 (len s))))\n"
      + "(defn crb-img-diag (rows path) (if (eq (len rows) 0) (list) (if (str_eq (record_get (head rows) \"aspect\") (str_concat \"image:\" path)) (cons (head rows) (crb-img-diag (tail rows) path)) (crb-img-diag (tail rows) path))))\n"
      + "(defn crb-img-healed (rows path) (if (eq (len rows) 2) (do (let failed (head rows)) (let applied (head (tail rows))) (and (str_eq (record_get failed \"observed\") \"image-admission-failed\") (and (str_eq (record_get failed \"stage\") \"observe\") (and (eq (record_get failed \"health\") 0) (and (str_eq (record_get failed \"path\") path) (and (str_eq (record_get applied \"observed\") \"image-admitted\") (and (str_eq (record_get applied \"stage\") \"applied\") (and (eq (record_get applied \"health\") 1) (str_eq (record_get applied \"path\") path))))))))) 0))\n"
      + "(let l0 (crb-img-count \"" + paths[2] + "\")) (let r0 (crb-img-count \"" + paths[3] + "\"))\n"
      + "(let a (cell_call \"" + paths[0] + "\" (nothing) (nothing))) (let av (record_get a \"value\"))\n"
      + "(let matcher (record_get av \"matches\")) (let strings (eq (matcher 10000 \" \" 0) 10000))\n"
      + "(let changed (record_set (record_get av \"owner\") \"n\" 9))\n"
      + "(let ar (cell_call \"" + paths[0] + "\" (nothing) (nothing))) (let b (cell_call \"" + paths[1] + "\" (nothing) (nothing)))\n"
      + "(let bv (record_get b \"value\")) (let br (cell_call \"" + paths[1] + "\" (nothing) (nothing)))\n"
      + "(let good (and strings (and (crb-img-good a) (and (crb-img-good ar) (and (crb-img-good b) (crb-img-good br))))))\n"
      + "(let state (and (eq (record_get av \"n\") 7) (and (eq (record_get (record_get ar \"value\") \"n\") 9) (and (eq (record_get bv \"n\") 9) (eq (record_get (record_get br \"value\") \"n\") 9)))))\n"
      + "(let identity (and (eq (record_get av \"same\") 1) (and (eq (record_get bv \"same\") 1) (and (eq (record_get av \"fn\") (record_get bv \"fn\")) (eq (record_get av \"owner\") (record_get bv \"owner\"))))))\n"
      + "(let effects (and (eq (crb-img-count \"" + paths[2] + "\") (add l0 1)) (eq (crb-img-count \"" + paths[3] + "\") (add r0 4))))\n"
      + "(let resident (and (eq (record_get ar \"resident\") 1) (and (eq (record_get br \"resident\") 1) (and (crb-img-zero ar) (crb-img-zero br)))))\n"
      + "(let disk (and (crb-img-zero a) (crb-img-zero b))) (let cold (and (gt (record_get a \"source_units\") 0) (gt (record_get b \"source_units\") 0)))\n"
      + "(let ad (crb-img-diag (record_get a \"diag\") \"" + paths[0] + ".cell.fkb\")) (let bd (crb-img-diag (record_get b \"diag\") \"" + paths[1] + ".cell.fkb\"))\n"
      + "(let clean (and (eq (len ad) 0) (eq (len bd) 0))) (let repaired (and (gt (record_get a \"source_units\") 0) (and (crb-img-zero b) (and (crb-img-healed ad \"" + paths[0] + ".cell.fkb\") (eq (len bd) 0)))))\n"
      + "(print (list \"cell-image-source-work\" (record_get a \"source_units\") (record_get a \"source_functions\") (record_get b \"source_units\") (record_get b \"source_functions\") good state identity effects resident ad bd))\n"
      + "(if (and (str_eq (head (kernel_ast (host_pid) (list \"identity\"))) \"" + builder + "\") (and good (and state (and identity (and effects resident))))) (if repaired 3 (if clean (if disk 2 (if cold 1 0)) 0)) 0))\n";
    write_file(driver,source);
    let cold = crb-oracle(driver,"/dev/null",910); let warm = crb-oracle(driver,"/dev/null",911);
    let artifact = paths[0] + ".cell.fkb"; let bytes = read_file(artifact);
    let damaged = write_file(artifact,substring(bytes,0,len(bytes) - 8) + "broken!!");
    let repaired = crb-oracle(driver,"/dev/null",912); let reused = crb-oracle(driver,"/dev/null",913);
    let okay = cold[0] == 0 && warm[0] == 0 && repaired[0] == 0 && reused[0] == 0 && crb-last-line(cold[1]) == "1" && crb-last-line(warm[1]) == "2"
      && crb-last-line(repaired[1]) == "3" && crb-last-line(reused[1]) == "2" && damaged == len(bytes);
    print(["cell-image-disk-reuse",cold,warm,repaired,reused,okay]);
    host_dir_rmdir(directory); okay && nothing?(fs_list(directory));
  }
  def crb-image-publication() {
    let directory = crb-dir() + "/publication"; let paths = crb-image-fixtures(directory); let target = paths[0];
    let blocked = host_dir_mkdir(target + ".cell.fkb");
    let first = cell_call(target,nothing(),nothing()); let firstPublication = record_get(first,"publication");
    let firstEffects = [crb-image-count(paths[2]),crb-image-count(paths[3])];
    let repeated = cell_call(target,nothing(),nothing()); let publication = record_get(repeated,"publication");
    let pendingEffects = [crb-image-count(paths[2]),crb-image-count(paths[3])];
    let resume = record_get(publication,"resume");
    value_kind(resume) != "closure" ? form_error("cell publication continuation unavailable: " + [crb-stopped(first),publication].str()) : 0;
    host_dir_rmdir(target + ".cell.fkb");
    let healed = resume(publication,oh-response(record_get(publication,"event"),"retry-publication"));
    let healedEffects = [crb-image-count(paths[2]),crb-image-count(paths[3])];
    let answer = cell_call(target,nothing(),nothing()); let value = record_get(answer,"value"); let answerEffects = [crb-image-count(paths[2]),crb-image-count(paths[3])];
    let completedResume = record_get(healed,"resume"); let completed = completedResume(healed,nothing());
    let completedEffects = [crb-image-count(paths[2]),crb-image-count(paths[3])];
    record_set(record_get(value,"owner"),"n",9);
    let resident = cell_call(target,nothing(),nothing());
    let checks = [record_get(crb-stopped(first),"kind") == "image-publication" && nothing?(record_get(first,"value")) && firstEffects == [0,0],
      record_get(crb-stopped(repeated),"kind") == "image-publication" && record_get(repeated,"source_units") == 0 && record_get(repeated,"source_functions") == 0 && pendingEffects == [0,0],
      record_get(firstPublication,"bytes") == record_get(publication,"bytes"),
      record_get(healed,"status") == "image-published" && healedEffects == [0,0],
      nothing?(crb-stopped(answer)) && record_get(answer,"errors") == 0 && record_get(value,"n") == 7 && answerEffects == [1,1],
      record_get(completed,"status") == "image-published" && completedEffects == [1,1],
      record_get(resident,"resident") == 1 && record_get(record_get(resident,"value"),"n") == 9 && [crb-image-count(paths[2]),crb-image-count(paths[3])] == [1,2]];
    host_dir_rmdir(directory); let clean = nothing?(fs_list(directory));
    print(["cell-image-publication-care",checks,clean]); clean && all?(check => check,checks);
  }
  def crb-native() {
    // the band's own argument: nothing when it runs as a program, the leg's value when a sweep runs it as a cell; the nested
    // calls below must give it back unchanged
    let own = cell_input();
    let echo = crb-dir() + "/native-input.bml";
    let nested = crb-dir() + "/native-nested.bml";
    let identity = crb-dir() + "/native-identity.bml";
    write_file(identity,"import form-stdlib/bml/cell-said.bml;\nsection [form.bml] { [cell_path(),cs-entry?(\""+identity+"\"),cs-entry?(\"different-unit.bml\")]; }\n");
    let wrote = write_file(echo, "section [form.bml] { print_str(\"terminal-only\"); cell_input(); }\n");
    let outer = intern_node(bp("cell-argument"), [17, "owned"]);
    let arguments = [outer, 0, nothing(), 3.5, "native text", [1, 2]];
    let calls = arguments |> map(argument => [argument,cell_call(echo, argument, nothing())]);
    let same = !any?(pair => record_get(pair[1], "value") != pair[0] || record_get(pair[1], "errors") != 0 || !nothing?(crb-stopped(pair[1])) || record_get(pair[1], "out") != "" || record_get(pair[1], "err") != "", calls);
    let body = "section [form.bml] { let before=cell_input(); let inner=cell_call(\"" + echo + "\",7,nothing()); let stopped=cell_call(\"" + crb-fx("stop-cell.fk") + "\",9,nothing()); let identity=cell_call(\""+identity+"\",nothing(),nothing()); [before,record_get(inner,\"value\"),cell_input(),record_get(stopped,\"stopped\"),cell_path(),record_get(identity,\"value\")]; }\n";
    let installed = write_file(nested, body);
    let result = cell_call(nested, outer, nothing());
    let values = record_get(result, "value");
    let warning = cell_call(crb-fx("warn-cell.fk"), nothing(), nothing());
    same && record_get(calls[-1][1], "resident") == 1 && (nothing?(own) ? nothing?(cell_input()) : value_eq(cell_input(), own)) && nothing?(crb-stopped(result)) && node_eq(values[0],outer) && values[1] == 7 && node_eq(values[2],outer) && record_get(values[3],"kind") == "stop" && values[4]==nested && values[5]==[identity,1,0] && record_get(warning,"errors") == 1 && crb-observed(warning) == "binding-missing" && record_get(warning,"err") == "";
  }
  def crb-dependency-admission() {
    let dep = crb-dir() + "/admission-dependency.fk";
    let owner = crb-dir() + "/admission-owner.fk";
    write_file(dep,"(do (defn crb-bad-dependency () (crb-unbound-call 1)) 7)\n");
    write_file(owner,"; preludes: " + dep + "\n(kernel_ast (host_pid) (list \"identity\"))\n");
    let bad = cell_run(dep,0,nothing(),nothing());
    let first = cell_run(owner,0,nothing(),nothing());
    let again = cell_run(owner,0,nothing(),nothing());
    write_file(dep,"(do (defn crb-bad-dependency () 7) 7)\n");
    let healed = cell_run(owner,0,nothing(),nothing());
    let checked = record_get(bad,"errors") == 1 && record_get(first,"errors") == 1
      && record_get(again,"errors") == 1 && nothing?(record_get(first,"value"))
      && nothing?(record_get(again,"value")) && crb-observed(first) == crb-observed(bad)
      && record_get(healed,"errors") == 0 && !nothing?(record_get(healed,"value"));
    let other = crb-dir() + "/admission-other.fk";
    let outer = crb-dir() + "/admission-outer.fk";
    write_file(dep,"(do crb-missing-value)\n");
    write_file(other,"; preludes: " + dep + "\n42\n");
    write_file(outer,"; preludes: " + owner + "\n9\n");
    let refused = cell_run(outer,0,nothing(),nothing());
    let middle = cell_run(owner,0,nothing(),nothing());
    let reused = cell_run(other,0,nothing(),nothing());
    write_file(dep,"(do 7)\n");
    let restored = cell_run(other,0,nothing(),nothing());
    let stops = !nothing?(crb-stopped(refused)) && !nothing?(crb-stopped(reused))
      && !nothing?(crb-stopped(middle)) && nothing?(record_get(middle,"value"))
      && record_get(reused,"errors") == 1 && nothing?(record_get(reused,"value"))
      && nothing?(crb-stopped(restored)) && record_get(restored,"value") == 42
      && record_get(restored,"errors") == 0;
    print(["cell-dependency-admission", "diagnostics-retained-and-source-repaired", checked]);
    print(["cell-dependency-admission", "refusal-retained-and-source-repaired", stops]);
    checked && stops;
  }
  def crb-unparsed-sibling() {
    let bad = crb-dir() + "/unbalanced.fk";
    let clean = crb-dir() + "/unparsed-sibling.fk";
    let owner = crb-dir() + "/unbalanced-owner.fk";
    write_file(bad,"(do 5\n");
    write_file(clean,"42\n");
    write_file(owner,"; preludes: " + clean + " " + bad + "\n7\n");
    let refused = cell_run(owner,0,nothing(),nothing());
    let first = cell_run(clean,0,nothing(),nothing());
    let again = cell_run(clean,0,nothing(),nothing());
    write_file(bad,"(do 5)\n");
    let healed = cell_run(owner,0,nothing(),nothing());
    let checked = !nothing?(crb-stopped(refused)) && record_get(first,"resident") == 0
      && record_get(first,"value") == 42 && record_get(first,"errors") == 0
      && record_get(again,"value") == 42 && record_get(again,"resident") == 1
      && record_get(healed,"value") == 7 && record_get(healed,"errors") == 0;
    print(["cell-dependency-admission", "unparsed-sibling-admitted-on-demand", checked]);
    checked;
  }
  def crb-retained-bindings() {
    let dir = crb-dir();
    let library = dir + "/retained-binding-library.fk";
    let a = dir + "/retained-binding-a.fk";
    let b = dir + "/retained-binding-b.fk";
    let source = "(defn crb-retained-f () (crb-retained-g))\n";
    let root = "; preludes: " + library + "\n(do (defn crb-retained-g () ";
    let end = ") (defn crb-retained-answer () (crb-retained-f)) (list (crb-retained-answer) (kernel_ast (host_pid) (list \"identity\" crb-retained-answer))))\n";
    write_file(library,source); write_file(a,root + "1" + end); write_file(b,root + "2" + end);
    let prior = cell_call(a,nothing(),nothing());
    let inherited = cell_call(b,nothing(),nothing());
    write_file(library,source + "\n");
    let changed = cell_call(b,nothing(),nothing());
    write_file(library,source);
    let fresh = cell_call(b,nothing(),nothing());
    let resident = cell_call(b,nothing(),nothing());
    let before = record_get(inherited,"value"); let after = record_get(fresh,"value");
    let okay = record_get(prior,"value")[0] == 1 && before[0] == 1 && after[0] == 2
      && before[1] != after[1] && after == record_get(resident,"value")
      && all?(r => record_get(r,"errors") == 0 && nothing?(crb-stopped(r)),[prior,inherited,changed,fresh,resident])
      && record_get(fresh,"source_units") == 2 && record_get(fresh,"source_functions") == 3
      && record_get(resident,"source_units") == 0 && record_get(resident,"source_functions") == 0;
    print(["cell-retained-binding-identity",before[0],after[0],before[1] != after[1],okay]);
    okay;
  }
  def crb-constant-incarnation() {
    let library = crb-dir() + "/constant-incarnation.fk";
    let root = crb-dir() + "/constant-reader.fk";
    let getter = "\n(defn crb-constant-get () crb-constant-record)\n(do crb-constant-get)\n";
    let initial = "(let crb-constant-record (record_new 0 \"n\" 1))" + getter;
    write_file(library,initial);
    let oldRun = cell_call(library,nothing(),nothing()); let old = record_get(oldRun,"value");
    record_set(old(),"n",42);
    write_file(library,"(let crb-constant-record (record_new 0 \"n\" 100))" + getter);
    let newRun = cell_call(library,nothing(),nothing()); let fresh = record_get(newRun,"value");
    let separated = record_get(old(),"n") == 42 && record_get(fresh(),"n") == 100;
    write_file(root,"; preludes: " + library + "\n(do crb-constant-record)\n");
    write_file(library,"(defn crb-constant-present () 1)\n");
    let removed = cell_call(root,nothing(),nothing());
    write_file(library,initial);
    let repaired = cell_call(root,nothing(),nothing());
    let okay = separated && record_get(oldRun,"errors") == 0 && record_get(newRun,"errors") == 0
      && record_get(removed,"errors") > 0 && !nothing?(crb-stopped(removed))
      && record_get(repaired,"errors") == 0 && record_get(record_get(repaired,"value"),"n") == 1
      && record_get(old(),"n") == 42;
    print(["cell-constant-incarnation",separated,record_get(removed,"errors"),record_get(repaired,"errors"),okay]);
    okay;
  }
  def crb-content-change(path,before,after) {
    let stamp = now_unix_ms() - 60000;
    write_file(path,before);
    host_utimes(path,stamp);
    let first = cell_run(path,0,nothing(),nothing());
    write_file(path,after);
    host_utimes(path,stamp);
    let changed = cell_run(path,0,nothing(),nothing());
    let again = cell_run(path,0,nothing(),nothing());
    print(["resident-content",path,record_get(first,"value"),record_get(changed,"value"),record_get(changed,"resident"),record_get(again,"resident")]);
    record_get(first,"value") == 111 && record_get(changed,"value") == 222
      && record_get(changed,"resident") == 0 && record_get(changed,"errors") == 0
      && record_get(again,"resident") == 1 && record_get(again,"value") == 222;
  }
  def crb-import-change(extension,source) {
    let base = crb-dir() + "/shadow-" + extension;
    host_dir_mkdir(base); host_dir_mkdir(base + "/form"); host_dir_mkdir(base + "/form/leaf");
    let target = base + "/form/leaf/target." + extension;
    let preferred = base + "/form/leaf/dep.fk";
    write_file(base + "/form/dep.fk","(defn crb-shadow-value () 41)\n(do 0)\n");
    write_file(target,source);
    let first = cell_run(target,0,nothing(),nothing());
    let resident = cell_run(target,0,nothing(),nothing());
    write_file(preferred,"(defn crb-shadow-value () 42)\n(do 0)\n");
    let appeared = cell_run(target,0,nothing(),nothing());
    let again = cell_run(target,0,nothing(),nothing());
    host_path_remove(preferred);
    let removed = cell_run(target,0,nothing(),nothing());
    let restored = cell_run(target,0,nothing(),nothing());
    let readings = [first,resident,appeared,again,removed,restored];
    let values = map(r => record_get(r,"value"),readings);
    let reuse = map(r => record_get(r,"resident"),readings);
    let events = map(r => map(g => record_get(g,"observed"),
      filter(g => (String) record_get(g,"path") == target + ".cell.fkb",record_get(r,"diag"))),[appeared,removed]);
    let okay = value_eq(values,[41,41,42,42,41,41]) && value_eq(reuse,[0,1,0,1,0,1])
      && value_eq(events,[["image-admission-failed","image-admitted"],["image-admission-failed","image-admitted"]])
      && nil?(filter(r => record_get(r,"errors") != 0 || !nothing?(record_get(r,"stopped")),readings));
    print(["resident-import-selection",extension,values,reuse,events,okay]);
    okay;
  }
  def crb-run() {
    let made = host_dir_mkdir(crb-dir());
    let bands = "form/form-stdlib/tests/";
    let c1 = crb-case(bands ++ "voice-chunk-band.fk", 1);
    let c2 = crb-case(bands ++ "anf-shadow-band.fk", 2);
    let c4 = crb-case(bands ++ "file-bytes-band.fk", 3);
    let c8 = crb-case(bands ++ "substring-one-meaning-band.fk", 4);
    let c16 = crb-case(bands ++ "str-find-one-meaning-band.fk", 5);
    let c32 = crb-case(crb-fx("print-cell.fk"), 6);
    let c64 = crb-case(crb-fx("stop-cell.fk"), 7);
    let c128 = crb-case(crb-fx("warn-cell.fk"), 8);
    let c512 = crb-case(crb-fx("bml-cell.bml"), 10);
    let b1 = crb-bit(c1[0] && (Comparable) record_get(c1[2], "value") == 4095 && (Comparable) record_get(c1[2], "errors") == 0 && (String) crb-observed(c1[2]) == "", 1);
    let b2 = crb-bit(c2[0], 2);
    let b4 = crb-bit(c4[0], 4);
    let b8 = crb-bit(c8[0], 8);
    let b16 = crb-bit(c16[0], 16);
    let b32 = crb-bit(c32[0] && (Comparable) record_get(c32[2], "value") == 5 && len((String) record_get(c32[2], "out")) == 20000 * 31, 32);
    let b64 = crb-bit(c64[0] && !nothing?(crb-stopped(c64[2])) && nothing?(record_get(c64[2], "value")) && (String) record_get(crb-stopped(c64[2]), "kind") == "stop" && (String) record_get(crb-stopped(c64[2]), "unit") == crb-fx("stop-cell.fk") && (String) record_get(c64[2], "out") == "before the stop\n", 64);
    let b128 = crb-bit(c128[0] && (Comparable) record_get(c128[2], "errors") == 1 && (Comparable) record_get(c128[2], "value") == 7 && (String) crb-observed(c128[2]) == "binding-missing", 128);
    let ins = "form/form-stdlib/tests/fixtures/cell-run/stdin-cell.fk";
    let inpath = crb-dir() ++ "/stdin.txt";
    let wrote = write_file(inpath, "first line\nsecond line\n");
    let o256 = crb-oracle(ins, inpath, 20);
    let r256 = cell_run(ins, 0, nothing(), ["first line", "second line"]);
    let r256e = cell_run(ins, 0, nothing(), nothing());
    let o256e = crb-oracle(ins, "/dev/null", 21);
    let b256 = crb-bit(crb-same(r256, o256) && crb-same(r256e, o256e) && (Comparable) record_get(r256, "value") == 99 && (String) record_get(r256, "out") == "first line\nsecond line\n", 256);
    let b512 = crb-bit(c512[0] && (Comparable) record_get(c512[2], "value") == 42 && crb-native(), 512);
    // residency: the same unit again, parsed already
    let a1 = cell_run(bands ++ "voice-chunk-band.fk", 0, nothing(), nothing());
    let w1 = cell_run(crb-fx("warn-cell.fk"), 0, nothing(), nothing());
    let b1024 = crb-bit((Comparable) record_get(a1, "resident") == 1 && (Comparable) record_get(a1, "value") == 4095 && (String) record_get(a1, "out") == (String) record_get(c1[2], "out") && (Comparable) record_get(w1, "resident") == 1 && (String) crb-observed(w1) == "binding-missing" && (Comparable) record_get(w1, "errors") == 1 && crb-dependency-admission() && crb-unparsed-sibling() && crb-image-disk-reuse() && crb-image-publication(), 1024);
    let sa = cell_run(crb-fx("scope-a.fk"), 0, nothing(), nothing());
    let sb = cell_run(crb-fx("scope-b.fk"), 0, nothing(), nothing());
    let sa2 = cell_run(crb-fx("scope-a.fk"), 0, nothing(), nothing());
    let sc = cell_run(crb-fx("scope-c.fk"), 0, nothing(), nothing());
    let shown2 = crb-say("scope", [record_get(sa, "value"), record_get(sb, "value"), record_get(sa2, "value"), record_get(sc, "errors"), record_get(sc, "resident")]);
    let b2048 = crb-bit((Comparable) record_get(sa, "value") == 11 && (Comparable) record_get(sb, "value") == 12 && (Comparable) record_get(sa2, "value") == 11 && (Comparable) record_get(sa2, "resident") == 1 && (Comparable) record_get(sc, "errors") > 0 && crb-retained-bindings() && crb-constant-incarnation(), 2048);
    let sp = cell_run(crb-fx("spin-cell.fk"), 0, 300, nothing());
    let b4096 = crb-bit(!nothing?(crb-stopped(sp)) && (String) record_get(crb-stopped(sp), "kind") == "deadline" && (Comparable) record_get(sp, "ms") >= 300 && (Comparable) record_get(sp, "ms") < 550 && (String) record_get(sp, "out") == "spinning\n", 4096);
    let rawFresh = crb-content-change(crb-dir() + "/live.fk","(do 111)\n","(do 222)\n");
    let bmlFresh = crb-content-change(crb-dir() + "/live.bml","section [form.bml] {111;}\n","section [form.bml] {222;}\n");
    let rawImports = crb-import-change("fk","; preludes: dep.fk\n(do (crb-shadow-value))\n");
    let bmlImports = crb-import-change("bml","import dep.fk;\nsection [form.bml] { crb-shadow-value(); }\n");
    let b8192 = crb-bit(rawFresh && bmlFresh && rawImports && bmlImports,8192);
    let ne = cell_run(crb-fx("nest-cell.fk"), 0, nothing(), nothing());
    let b16384 = crb-bit((Comparable) record_get(ne, "value") == 1 && (String) record_get(ne, "out") == "outer before\nouter after\n" && nothing?(crb-stopped(ne)), 16384);
    // the heap fills to its first collection before it is steady (about 1000 calls of this band); growth is read after that
    let warmed = crb-repeat(1200, bands ++ "voice-chunk-band.fk");
    let rss0 = crb-rss();
    let grown = crb-repeat(500, bands ++ "voice-chunk-band.fk");
    let rss1 = crb-rss();
    let shown4 = crb-say("500 resident calls after 1200: rss before, after, not-resident", [rss0, rss1, grown]);
    let b32768 = crb-bit((Comparable) warmed == 0 && (Comparable) grown == 0 && rss1 - rss0 < 2097152, 32768);
    let x1 = cell_run(0, 0, nothing(), nothing());
    let x2 = cell_run(crb-fx("scope-a.fk"), 0, "soon", nothing());
    let x3 = cell_run(crb-fx("scope-a.fk"), 0, nothing(), 5);
    let b65536 = crb-bit(!nothing?(crb-stopped(x1)) && (String) record_get(crb-stopped(x1), "kind") == "refused" && (String) record_get(crb-stopped(x2), "kind") == "refused" && (String) record_get(crb-stopped(x3), "kind") == "refused", 65536);
    let b131072 = crb-bit((Comparable) crb-children() == 0, 131072);
    let b262144 = crb-bit(c1[1] && c2[1] && c4[1] && c8[1] && c16[1] && c32[1] && c64[1] && c128[1], 262144);
    let rb = cell_run(crb-fx("stdin-bytes-cell.fk"), 0, nothing(), ["abc", "de"]);
    let b524288 = crb-bit(nothing?(crb-stopped(rb)) && (Comparable) record_get(rb, "value") == 7 && (String) record_get(rb, "out") == "abc\nde\n\n" && (Comparable) record_get(rb, "errors") == 0, 524288);
    let gate = cell_run("gate/op-manifest.bml", 0, nothing(), nothing());
    let fact = cell_run("form/form-samples/fact.fk", 0, nothing(), nothing());
    let b1048576 = crb-bit((Comparable) record_get(fact, "value") == 3628800 && (Comparable) record_get(fact, "errors") == 0 && nothing?(crb-stopped(fact)) && crb-bound-nil(), 1048576);
    let q1 = cell_run("form/form-stdlib/tests/boot-band.fk", 0, nothing(), nothing());
    let q2 = cell_run("form/form-stdlib/tests/base64-band.fk", 0, nothing(), nothing());
    let q3 = cell_run("form/form-stdlib/tests/boot-band.fk", 0, nothing(), nothing());
    let q4 = cell_run("form/form-stdlib/tests/base64-band.fk", 0, nothing(), nothing());
    let b2097152 = crb-bit((Comparable) record_get(q1, "value") == 9 && (Comparable) record_get(q3, "value") == 9 && (Comparable) record_get(q2, "value") == 12 && (Comparable) record_get(q4, "value") == 12 && nothing?(crb-stopped(q3)) && nothing?(crb-stopped(q4)) && (Comparable) record_get(q3, "resident") == 1 && (Comparable) record_get(q4, "resident") == 1, 2097152);
    let cycGone = host_path_remove(crb-fx("cyc-a.bml.lowfk")) + host_path_remove(crb-fx("cyc-b.bml.lowfk"));
    let cycT0 = host_monotonic_ms();
    let cyc = cell_run(crb-fx("cyc-a.bml"), 0, nothing(), nothing());
    let cycMs = host_monotonic_ms() - cycT0;
    let b4194304 = crb-bit(nothing?(crb-stopped(cyc)) && (Comparable) record_get(cyc, "value") == 3 && (Comparable) record_get(cyc, "errors") == 0 && (Comparable) cycMs < 60000, 4194304);
    let again1 = cell_run("form/form-stdlib/tests/anf-shadow-band.fk", 0, nothing(), nothing());
    let again2 = cell_run("form/form-stdlib/tests/anf-shadow-band.fk", 0, nothing(), nothing());
    let b8388608 = crb-bit(nothing?(crb-stopped(again1)) && nothing?(crb-stopped(again2)) && (Comparable) record_get(again1, "value") == 31 && (Comparable) record_get(again2, "value") == 31, 8388608);
    let verdict = b1 + b2 + b4 + b8 + b16 + b32 + b64 + b128 + b256 + b512 + b1024 + b2048 + b4096 + b8192 + b16384 + b32768 + b65536 + b131072 + b262144 + b524288 + b1048576 + b2097152 + b4194304 + b8388608;
    let shown5 = print(["cell-run-band", "verdict", verdict]);
    verdict;
  }
  (Comparable) crb-door?() == 1 ? crb-run() : crb-absent();
}
