; living-world-trace-relation-witness.fk -- a native trace may be reflected,
; but neither one execution nor its own holders may grant relation authority.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-trace-relation.fk form-stdlib/tests/living-world-recipe-execution-witness.fk

(let LWTRW-SOURCE-C    (bp "LWTRW-SOURCE-C"))
(let LWTRW-SOURCE-D    (bp "LWTRW-SOURCE-D"))
(let LWTRW-SOURCE-E    (bp "LWTRW-SOURCE-E"))
(let LWTRW-SOURCE-F    (bp "LWTRW-SOURCE-F"))
(let LWTRW-SOURCE-G    (bp "LWTRW-SOURCE-G"))
(let LWTRW-SOURCE-H    (bp "LWTRW-SOURCE-H"))
(let LWTRW-SOURCE-I    (bp "LWTRW-SOURCE-I"))
(let LWTRW-PROV-C      (bp "LWTRW-PROV-C"))
(let LWTRW-PROV-D      (bp "LWTRW-PROV-D"))
(let LWTRW-PROV-E      (bp "LWTRW-PROV-E"))
(let LWTRW-PROV-F      (bp "LWTRW-PROV-F"))
(let LWTRW-PROV-G      (bp "LWTRW-PROV-G"))
(let LWTRW-PROV-H      (bp "LWTRW-PROV-H"))
(let LWTRW-PROV-I      (bp "LWTRW-PROV-I"))
(let LWTRW-ACTION      (bp "LWTRW-ACTION"))
(let LWTRW-LEFT-COORD  (bp "LWTRW-LEFT-COORD"))
(let LWTRW-RIGHT-COORD (bp "LWTRW-RIGHT-COORD"))
(let LWTRW-OTHER-VIEW  (bp "LWTRW-OTHER-VIEW"))
(let LWTRW-EVIDENCE    (bp "LWTRW-EVIDENCE"))
(let LWTRW-ALTERNATIVE (bp "LWTRW-ALTERNATIVE"))
(let LWTRW-REASON      (bp "LWTRW-REASON"))

(defn lwtrw-cell (kind) (intern_node kind (empty)))
(defn lwtrw-source-c () (lwtrw-cell LWTRW-SOURCE-C))
(defn lwtrw-source-d () (lwtrw-cell LWTRW-SOURCE-D))
(defn lwtrw-source-e () (lwtrw-cell LWTRW-SOURCE-E))
(defn lwtrw-source-f () (lwtrw-cell LWTRW-SOURCE-F))
(defn lwtrw-source-g () (lwtrw-cell LWTRW-SOURCE-G))
(defn lwtrw-source-h () (lwtrw-cell LWTRW-SOURCE-H))
(defn lwtrw-source-i () (lwtrw-cell LWTRW-SOURCE-I))
(defn lwtrw-prov-c () (lwtrw-cell LWTRW-PROV-C))
(defn lwtrw-prov-d () (lwtrw-cell LWTRW-PROV-D))
(defn lwtrw-prov-e () (lwtrw-cell LWTRW-PROV-E))
(defn lwtrw-prov-f () (lwtrw-cell LWTRW-PROV-F))
(defn lwtrw-prov-g () (lwtrw-cell LWTRW-PROV-G))
(defn lwtrw-prov-h () (lwtrw-cell LWTRW-PROV-H))
(defn lwtrw-prov-i () (lwtrw-cell LWTRW-PROV-I))
(defn lwtrw-action () (lwtrw-cell LWTRW-ACTION))
(defn lwtrw-left-coordinate () (lwtrw-cell LWTRW-LEFT-COORD))
(defn lwtrw-right-coordinate () (lwtrw-cell LWTRW-RIGHT-COORD))
(defn lwtrw-other-view () (lwtrw-cell LWTRW-OTHER-VIEW))
(defn lwtrw-evidence () (lwtrw-cell LWTRW-EVIDENCE))
(defn lwtrw-alternative () (lwtrw-cell LWTRW-ALTERNATIVE))
(defn lwtrw-reason () (lwtrw-cell LWTRW-REASON))

(defn lwtrw-entry-for (source provenance payload)
    (lwt-entry
        (lwo-offer source (lwo-interface (list (lwtrw-action)))
            1 payload provenance 1)
        (lwtrw-action)))
(defn lwtrw-entry-c (payload)
    (lwtrw-entry-for (lwtrw-source-c) (lwtrw-prov-c) payload))
(defn lwtrw-entry-d (payload)
    (lwtrw-entry-for (lwtrw-source-d) (lwtrw-prov-d) payload))
(defn lwtrw-entry-e (payload)
    (lwtrw-entry-for (lwtrw-source-e) (lwtrw-prov-e) payload))
(defn lwtrw-entry-f (payload)
    (lwtrw-entry-for (lwtrw-source-f) (lwtrw-prov-f) payload))
(defn lwtrw-entry-g (payload)
    (lwtrw-entry-for (lwtrw-source-g) (lwtrw-prov-g) payload))
(defn lwtrw-entry-h (payload)
    (lwtrw-entry-for (lwtrw-source-h) (lwtrw-prov-h) payload))
(defn lwtrw-entry-i (payload)
    (lwtrw-entry-for (lwtrw-source-i) (lwtrw-prov-i) payload))

; --- the already-integrated native execution ---------------------------

(defn lwtrw-execution-round-build () (lwrew-integrated-round))
(let LWTRW-EXECUTION-ROUND-VALUE (lwtrw-execution-round-build))
(defn lwtrw-execution-round () LWTRW-EXECUTION-ROUND-VALUE)
(defn lwtrw-execution-world ()
    (lwt-round-world (lwtrw-execution-round)))
(defn lwtrw-basis ()
    (lwt-proposal-candidate
        (lwrew-proposal-for-world (lwrew-world))))
(defn lwtrw-trace () (lwo-emergent-shape (lwtrw-basis)))
(defn lwtrw-before () (lwre-trace-before (lwtrw-trace)))
(defn lwtrw-after ()
    (lwre-result-primary (lwre-trace-result (lwtrw-trace))))

; --- endpoint surfaces recur separately from the trace -----------------

(defn lwtrw-left-observation ()
    (lwsl-observation-at (lwtrw-before) (lwtrw-left-coordinate) "seed"
        (lwo-none) (oac-one (lwtrw-before)) (lwtrw-evidence)))
(defn lwtrw-right-observation ()
    (lwsl-observation-at (lwtrw-after) (lwtrw-right-coordinate) "forty-nine"
        (lwo-none) (oac-one (lwtrw-after)) (lwtrw-evidence)))

(defn lwtrw-symbol-observation-world ()
    (lwt-receive-stream (lwtrw-execution-world)
        (list
            (lwtrw-entry-c (lwtrw-left-observation))
            (lwtrw-entry-d (lwtrw-left-observation))
            (lwtrw-entry-c (lwtrw-right-observation))
            (lwtrw-entry-d (lwtrw-right-observation)))))
(defn lwtrw-symbol-proposal-for-referent-items (items referent)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let proposal (head items))
            (let symbol
                (lwo-emergent-shape (lwt-proposal-candidate proposal)))
            (if (node_eq (lwnv-symbol-referent symbol) referent)
                proposal
                (lwtrw-symbol-proposal-for-referent-items
                    (tail items) referent)))))
(defn lwtrw-symbol-proposal-for-referent (proposals referent)
    (lwtrw-symbol-proposal-for-referent-items
        (lwo-field-items proposals) referent))
(defn lwtrw-symbol-round-build ()
    (do
        (let world (lwtrw-symbol-observation-world))
        (lwt-round world (lwsl-proposals world 2)
            (lwo-empty-field) (lwtrw-execution-round))))
(let LWTRW-SYMBOL-ROUND-VALUE (lwtrw-symbol-round-build))
(defn lwtrw-symbol-round () LWTRW-SYMBOL-ROUND-VALUE)
(defn lwtrw-left-symbol-proposal ()
    (lwtrw-symbol-proposal-for-referent
        (lwt-round-proposals (lwtrw-symbol-round)) (lwtrw-before)))
(defn lwtrw-right-symbol-proposal ()
    (lwtrw-symbol-proposal-for-referent
        (lwt-round-proposals (lwtrw-symbol-round)) (lwtrw-after)))
(defn lwtrw-left-symbol ()
    (lwt-proposal-candidate (lwtrw-left-symbol-proposal)))
(defn lwtrw-right-symbol ()
    (lwt-proposal-candidate (lwtrw-right-symbol-proposal)))

(defn lwtrw-response (source provenance proposal)
    (lwtrw-entry-for source provenance
        (lwt-response proposal (oac-one proposal) provenance)))
(defn lwtrw-symbol-yes-round-build ()
    (do
        (let round (lwtrw-symbol-round))
        (let left (lwtrw-left-symbol-proposal))
        (let right (lwtrw-right-symbol-proposal))
        (lwt-round-receive round
            (list
                (lwtrw-response
                    (lwtrw-source-c) (lwtrw-prov-c) left)
                (lwtrw-response
                    (lwtrw-source-d) (lwtrw-prov-d) left)
                (lwtrw-response
                    (lwtrw-source-c) (lwtrw-prov-c) right)
                (lwtrw-response
                    (lwtrw-source-d) (lwtrw-prov-d) right)))))
(defn lwtrw-symbol-integrated-round-build ()
    (do
        (let round (lwtrw-symbol-yes-round-build))
        (let left
            (lwsl-integrate round (lwtrw-left-symbol-proposal)
                (lwtrw-action)))
        (lwsl-integrate left (lwtrw-right-symbol-proposal)
            (lwtrw-action))))
(let LWTRW-SYMBOL-INTEGRATED-ROUND-VALUE
    (lwtrw-symbol-integrated-round-build))
(defn lwtrw-symbol-integrated-round ()
    LWTRW-SYMBOL-INTEGRATED-ROUND-VALUE)
(defn lwtrw-symbol-world ()
    (lwt-round-world (lwtrw-symbol-integrated-round)))

; --- optional trace reflections ----------------------------------------

(defn lwtrw-choice ()
    (lwlc-choice (lwo-none)
        (lwo-field (list (lwtrw-alternative)))
        (lwlc-unknown (lwtrw-evidence)) (lwtrw-evidence)))
(defn lwtrw-timeout ()
    (oac-timeout (intern_trivial_int 10)
        (oac-alternative-ack (lwtrw-basis)
            (lwtrw-alternative) (lwtrw-evidence))
        (lwtrw-evidence)))
(defn lwtrw-minimal-offer ()
    (lwtr-offer (lwtrw-basis)
        (lwtrw-left-symbol) (lwtrw-right-symbol) (lwo-none)
        (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none)
        (lwtrw-evidence)))
(defn lwtrw-rich-offer ()
    (lwtr-offer (lwtrw-basis)
        (lwtrw-left-symbol) (lwtrw-right-symbol) (lwo-none)
        (lwo-field (list (lwtrw-alternative)))
        (lwlc-unknown (lwtrw-evidence)) (lwtrw-choice)
        (lwtrw-timeout) (lwtrw-evidence)))
(defn lwtrw-other-view-minimal-offer ()
    (lwtr-offer (lwtrw-basis)
        (lwtrw-left-symbol) (lwtrw-right-symbol) (lwtrw-other-view)
        (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none)
        (lwtrw-evidence)))
(defn lwtrw-other-view-rich-offer ()
    (lwtr-offer (lwtrw-basis)
        (lwtrw-left-symbol) (lwtrw-right-symbol) (lwtrw-other-view)
        (lwo-field (list (lwtrw-alternative)))
        (lwlc-unknown (lwtrw-evidence)) (lwtrw-choice)
        (lwtrw-timeout) (lwtrw-evidence)))
(defn lwtrw-incomplete-offer ()
    (lwtr-offer (lwtrw-basis) (lwo-none) (lwo-none) (lwo-none)
        (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none)
        (lwtrw-evidence)))

(defn lwtrw-one-world ()
    (lwt-receive-stream (lwtrw-symbol-world)
        (list (lwtrw-entry-e (lwtrw-minimal-offer)))))
(defn lwtrw-two-world ()
    (lwt-receive-stream (lwtrw-one-world)
        (list (lwtrw-entry-f (lwtrw-rich-offer)))))
(defn lwtrw-ambiguous-world ()
    (lwt-receive-stream (lwtrw-two-world)
        (list
            (lwtrw-entry-e (lwtrw-other-view))
            (lwtrw-entry-f (lwtrw-other-view))
            (lwtrw-entry-e (lwtrw-other-view-minimal-offer))
            (lwtrw-entry-f (lwtrw-other-view-rich-offer)))))

(defn lwtrw-find-hypothesis-proposal-items (items view)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let proposal (head items))
            (let hypothesis
                (lwo-emergent-shape (lwt-proposal-candidate proposal)))
            (if (node_eq
                    (lwtr-relation-view
                        (lwtr-hypothesis-relation hypothesis)) view)
                proposal
                (lwtrw-find-hypothesis-proposal-items
                    (tail items) view)))))
(defn lwtrw-find-hypothesis-proposal (proposals view)
    (lwtrw-find-hypothesis-proposal-items
        (lwo-field-items proposals) view))

(defn lwtrw-hypothesis-round-build ()
    (do
        (let world (lwtrw-two-world))
        (lwt-round world (lwtr-hypothesis-proposals world 2)
            (lwo-empty-field) (lwtrw-symbol-integrated-round))))
(let LWTRW-HYPOTHESIS-ROUND-VALUE (lwtrw-hypothesis-round-build))
(defn lwtrw-hypothesis-round () LWTRW-HYPOTHESIS-ROUND-VALUE)
(defn lwtrw-hypothesis-proposal ()
    (lwtrw-find-hypothesis-proposal
        (lwt-round-proposals (lwtrw-hypothesis-round)) (lwo-none)))
(defn lwtrw-hypothesis-candidate ()
    (lwt-proposal-candidate (lwtrw-hypothesis-proposal)))
(defn lwtrw-hypothesis ()
    (lwo-emergent-shape (lwtrw-hypothesis-candidate)))

(defn lwtrw-hypothesis-responses (proposal)
    (list
        (lwtrw-response (lwrew-source-a) (lwrew-prov-a) proposal)
        (lwtrw-response (lwrew-source-b) (lwrew-prov-b) proposal)
        (lwtrw-response (lwtrw-source-c) (lwtrw-prov-c) proposal)
        (lwtrw-response (lwtrw-source-d) (lwtrw-prov-d) proposal)
        (lwtrw-response (lwtrw-source-e) (lwtrw-prov-e) proposal)
        (lwtrw-response (lwtrw-source-f) (lwtrw-prov-f) proposal)))
(defn lwtrw-hypothesis-yes-round-build ()
    (do
        (let round (lwtrw-hypothesis-round))
        (let proposal (lwtrw-hypothesis-proposal))
        (lwt-round-receive round
            (lwtrw-hypothesis-responses proposal))))
(defn lwtrw-hypothesis-integrated-round-build ()
    (do
        (let round (lwtrw-hypothesis-yes-round-build))
        (lwtr-hypothesis-integrate round (lwtrw-hypothesis-proposal)
            (lwtrw-action))))
(let LWTRW-HYPOTHESIS-INTEGRATED-ROUND-VALUE
    (lwtrw-hypothesis-integrated-round-build))
(defn lwtrw-hypothesis-integrated-round ()
    LWTRW-HYPOTHESIS-INTEGRATED-ROUND-VALUE)
(defn lwtrw-hypothesis-world ()
    (lwt-round-world (lwtrw-hypothesis-integrated-round)))

; --- independent re-observation and the second membrane ----------------

(defn lwtrw-support-attestation ()
    (lwtr-attestation (lwtrw-hypothesis-candidate)
        (oac-one (lwtr-hypothesis-relation (lwtrw-hypothesis)))
        (lwo-empty-field) (lwo-none) (lwtrw-evidence)))
(defn lwtrw-silence-attestation ()
    (lwtr-attestation (lwtrw-hypothesis-candidate) (oac-nothing)
        (lwo-empty-field) (lwlc-unknown (lwtrw-evidence))
        (lwtrw-evidence)))
(defn lwtrw-dissent-attestation ()
    (lwtr-attestation (lwtrw-hypothesis-candidate) (oac-zero)
        (lwo-field (list (lwtrw-alternative)))
        (lwlc-unknown (lwtrw-evidence)) (lwtrw-evidence)))
(defn lwtrw-alternative-attestation ()
    (lwtr-attestation (lwtrw-hypothesis-candidate)
        (oac-alternative-ack
            (lwtr-hypothesis-relation (lwtrw-hypothesis))
            (lwtrw-alternative) (lwtrw-evidence))
        (lwo-field (list (lwtrw-alternative)))
        (lwlc-unknown (lwtrw-evidence)) (lwtrw-evidence)))
(defn lwtrw-self-attestation () (lwtrw-support-attestation))

(defn lwtrw-self-world ()
    (lwt-receive-stream (lwtrw-hypothesis-world)
        (list (lwtrw-entry-e (lwtrw-self-attestation)))))
(defn lwtrw-one-attestation-world ()
    (lwt-receive-stream (lwtrw-hypothesis-world)
        (list (lwtrw-entry-g (lwtrw-support-attestation)))))
(defn lwtrw-two-attestation-world ()
    (lwt-receive-stream (lwtrw-one-attestation-world)
        (list (lwtrw-entry-h (lwtrw-support-attestation)))))
(defn lwtrw-silence-world ()
    (lwt-receive-stream (lwtrw-two-attestation-world)
        (list (lwtrw-entry-i (lwtrw-silence-attestation)))))
(defn lwtrw-dissent-world ()
    (lwt-receive-stream (lwtrw-two-attestation-world)
        (list (lwtrw-entry-i (lwtrw-dissent-attestation)))))
(defn lwtrw-alternative-world ()
    (lwt-receive-stream (lwtrw-two-attestation-world)
        (list (lwtrw-entry-i (lwtrw-alternative-attestation)))))

(defn lwtrw-edge-proposal-for (world)
    (lwtr-edge-proposal world (lwtrw-hypothesis-candidate) 2))
(defn lwtrw-edge-round-build ()
    (do
        (let world (lwtrw-two-attestation-world))
        (let proposal (lwtrw-edge-proposal-for world))
        (lwt-round world (lwo-field (list proposal))
            (lwo-empty-field) (lwtrw-hypothesis-integrated-round))))
(let LWTRW-EDGE-ROUND-VALUE (lwtrw-edge-round-build))
(defn lwtrw-edge-round () LWTRW-EDGE-ROUND-VALUE)
(defn lwtrw-edge-proposal ()
    (head (lwo-field-items (lwt-round-proposals (lwtrw-edge-round)))))
(defn lwtrw-edge-candidate ()
    (lwt-proposal-candidate (lwtrw-edge-proposal)))

(defn lwtrw-edge-responses (proposal)
    (list
        (lwtrw-response (lwrew-source-a) (lwrew-prov-a) proposal)
        (lwtrw-response (lwrew-source-b) (lwrew-prov-b) proposal)
        (lwtrw-response (lwtrw-source-c) (lwtrw-prov-c) proposal)
        (lwtrw-response (lwtrw-source-d) (lwtrw-prov-d) proposal)
        (lwtrw-response (lwtrw-source-e) (lwtrw-prov-e) proposal)
        (lwtrw-response (lwtrw-source-f) (lwtrw-prov-f) proposal)
        (lwtrw-response (lwtrw-source-g) (lwtrw-prov-g) proposal)
        (lwtrw-response (lwtrw-source-h) (lwtrw-prov-h) proposal)))
(defn lwtrw-edge-yes-round-build ()
    (do
        (let round (lwtrw-edge-round))
        (lwt-round-receive round
            (lwtrw-edge-responses (lwtrw-edge-proposal)))))
(defn lwtrw-edge-integrated-round-build ()
    (do
        (let round (lwtrw-edge-yes-round-build))
        (lwtr-edge-integrate round (lwtrw-edge-proposal)
            (lwtrw-action))))
(let LWTRW-EDGE-INTEGRATED-ROUND-VALUE
    (lwtrw-edge-integrated-round-build))
(defn lwtrw-edge-integrated-round () LWTRW-EDGE-INTEGRATED-ROUND-VALUE)
(defn lwtrw-edge-world ()
    (lwt-round-world (lwtrw-edge-integrated-round)))

(defn lwtrw-revoked-world ()
    (lwt-receive-stream (lwtrw-edge-world)
        (list
            (lwtrw-entry-e
                (lwo-revocation (lwtrw-minimal-offer)
                    (lwtrw-source-e) (lwtrw-reason) (lwtrw-prov-e))))))

(defn lwtrw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwtrw-sum (tail items)))))

0
