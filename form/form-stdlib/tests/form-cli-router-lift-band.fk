; form-cli-router-lift-band.fk — crystallized lift of fcr-* is used.
;
; Same verdict 255 as form-cli-router-band. Authority is the lift section.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-router-lift.bml
; witnessed: 2026-08-20 -> 255

(do
    (let fn-strong (fcr-backend "form-native" 100 80 80 80))
    (let fn-blind  (fcr-backend "form-native" 100 100 0 100))
    (let fn-weak   (fcr-backend "form-native" 100 20 50 20))
    (let cli       (fcr-backend "agent-cli"   50 90 100 100))
    (let cli-barely(fcr-backend "agent-cli"   0  0  10  0))
    (let c0 (if (str_eq (fcr-route fn-strong cli) "form-native") 1 0))
    (let c1 (if (str_eq (fcr-route fn-blind cli) "agent-cli") 2 0))
    (let c2 (if (eq (fcr-flips-local? fn-blind fn-strong cli) 1) 4 0))
    (let c3 (if (str_eq (fcr-route fn-weak cli) "agent-cli") 8 0))
    (let c4 (if (str_eq (fcr-route fn-blind cli-barely) "agent-cli") 16 0))
    (let c5 (if (eq (fcr-walk 1 1) (fcr-lane-native)) 32 0))
    (let c6 (if (eq (fcr-walk 0 1) (fcr-lane-local)) 64 0))
    (let c7 (if (eq (fcr-walk 0 0) (fcr-lane-remote)) 128 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
