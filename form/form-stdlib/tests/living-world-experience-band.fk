; living-world-experience-band.fk -- interaction changes recursive evidence.
; Verdict 4095 proves twelve outcome-fed learning and governance properties.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-recursive-application.fk form-stdlib/tests/living-world-recursive-witness.fk

(do
    (let base (lwrrw-base-round 2))
    (let mapping-proposal (lwrrw-first-proposal base))
    (let old-candidate (lwrrw-candidate mapping-proposal))
    (let mapping-round
        (lwrrw-integrated-mapping-round base mapping-proposal))
    (let mapping-world (lwt-round-world mapping-round))
    (let signature
        (lwrr-mapping-signature (lwo-emergent-shape old-candidate)))
    (let confirming (lwrrw-confirming-experience signature))
    (let correcting (lwrrw-correcting-experience signature))
    (let silent (lwrrw-silent-experience signature))
    (let false-confirmation
        (lwx-experience signature (lwrrw-unseen-input) (lwrrw-right-e)
            (oac-one (lwrrw-right-e))
            (intern_trivial_string "lwrrw-false-confirmation")))
    (let false-dissent
        (lwx-experience signature (lwrrw-unseen-input)
            (lwrrw-expected-output) (oac-zero)
            (intern_trivial_string "lwrrw-false-dissent")))

    (let experienced-world
        (lwrrw-world-with-experiences mapping-world signature))
    (let evidence-set
        (lwrr-evidence-set-for experienced-world signature))
    (let current-mapping (lwrr-mapping-for signature evidence-set))
    (let uncertainty (lwrr-mapping-uncertainty current-mapping))
    (let state (lwrl-state experienced-world old-candidate))
    (let blocked-application
        (lwrr-application-proposal experienced-world old-candidate
                                   (lwrrw-unseen-input)))
    (let reopen-proposal
        (lwrl-reopen-proposal experienced-world old-candidate 2))
    (let new-candidate (lwrrw-candidate reopen-proposal))
    (let reopen-round
        (lwt-round experienced-world
            (lwo-field-add (lwo-empty-field) reopen-proposal)
            (lwo-empty-field) mapping-round))
    (let yes-round
        (lwrrw-experience-reopen-yes-round reopen-round reopen-proposal))
    (let integrated
        (lwt-integrate yes-round reopen-proposal (lwrrw-action)))
    (let final-world (lwt-round-world integrated))

    (let c1 (if (eq (lwx-experience-valid? confirming) 1) 1 0))
    (let c2 (if (eq (lwx-experience-valid? correcting) 1) 2 0))
    (let c3 (if (and (eq (lwx-experience-valid? silent) 1)
                         (eq (lwx-experience-bearing? silent) 0)) 4 0))
    (let c4 (if (and (eq (lwx-experience-valid? false-confirmation) 0)
                         (eq (lwx-experience-valid? false-dissent) 0)) 8 0))
    (let c5 (if (eq (lwo-field-size
                         (lwrr-evidence-observations evidence-set)) 3) 16 0))
    (let c6 (if (and (eq (lwo-field-size
                              (lwrr-mapping-supports current-mapping)) 3)
                         (eq (lwo-field-size
                              (lwrr-mapping-counterexamples current-mapping)) 2)) 32 0))
    (let c7 (if (and (eq (lwrr-uncertainty-confirmations uncertainty) 1)
                         (and (eq (lwrr-uncertainty-dissents uncertainty) 1)
                              (eq (lwrr-uncertainty-silences uncertainty) 1))) 64 0))
    (let c8 (if (and (node_eq (lwrl-state-status state) (lwrl-reopen))
                         (and (eq (lwrl-state-support-delta state) 1)
                              (eq (lwrl-state-counterexample-delta state) 1))) 128 0))
    (let c9 (if (node_eq blocked-application (lwo-none)) 256 0))
    (let c10 (if (and (eq (lwo-field-size
                               (lwt-proposal-participants reopen-proposal)) 6)
                          (eq (lwo-field-size
                               (lwo-emergent-witnesses new-candidate)) 6)) 512 0))
    (let c11 (if (and (eq (lwo-active? final-world new-candidate) 1)
                          (eq (lwo-field-size
                               (lwo-active-attributions-for
                                   final-world new-candidate)) 6)) 1024 0))
    (let c12 (if (and (eq (lwrl-steady? final-world new-candidate) 1)
                          (eq (lwo-active? final-world old-candidate) 1)) 2048 0))
    (lwrrw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12)))
