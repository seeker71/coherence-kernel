; float-repr-edges-band.fk -- core.fk's float-repr at the edges of the double, each rendering byte-identical to the
; native value_str: every power of two, the odd multiples beside them, the subnormals down to the floor, powers of ten
; at both ends, the halfgap and the largest double. float-repr-band keeps its four-way sweep to modest exponents,
; because the siblings walk the bignum recipe; these edges ride the fourth arm, where its leaves are compiled.
;
; Verdict 63
; PROOF LEVEL: FOURTH-ARM ONLY (at these exponents a sibling leg walks the bignum recipe for minutes)
; preludes: form-stdlib/core.fk
;
;   1  every power of two 2^k, k in [-1074, 1023], prints as value_str does
;   2  3, 5 and 7 times 2^k, k in [-1074, 1020], print as value_str does
;   4  the smallest subnormal and its first sixty doublings, each alone and one unit up, print as value_str does
;   8  10^k for k in [-323, -1] and [0, 308], stepped by tenths and by tens, print as value_str does
;  16  the halfgap 2^-1017 prints "7.120236347223045e-307", the largest double "1.7976931348623157e+308", and the
;      smallest subnormal "5e-324"
;  32  the machine-word path runs compiled: after 2000 renderings of the tie, d4w-run and d4w-scale read state 2
(do
    (defn fre-miss (x) (if (str_eq (float-repr x) (value_str x)) 0 1))
    (defn fre-bit (ok b) (if ok b 0))
    (defn fre-up (x k n acc) (if (gt k n) acc (fre-up (mul x 2.0) (add k 1) n (add acc (fre-miss x)))))
    (defn fre-dn (x k n acc) (if (lt k n) acc (fre-dn (div x 2.0) (sub k 1) n (add acc (fre-miss x)))))
    (defn fre-odd (x) (add (fre-miss (mul x 3.0)) (add (fre-miss (mul x 5.0)) (fre-miss (mul x 7.0)))))
    (defn fre-up-odd (x k n acc) (if (gt k n) acc (fre-up-odd (mul x 2.0) (add k 1) n (add acc (fre-odd x)))))
    (defn fre-dn-odd (x k n acc) (if (lt k n) acc (fre-dn-odd (div x 2.0) (sub k 1) n (add acc (fre-odd x)))))
    (defn fre-sub (x j n acc) (if (gt j n) acc (fre-sub (mul x 2.0) (add j 1) n (add acc (add (fre-miss x) (fre-miss (add x 5e-324)))))))
    (defn fre-ten-up (x k n acc) (if (gt k n) acc (fre-ten-up (mul x 10.0) (add k 1) n (add acc (fre-miss x)))))
    (defn fre-ten-dn (x k n acc) (if (lt k n) acc (fre-ten-dn (div x 10.0) (sub k 1) n (add acc (fre-miss x)))))
    (let pow2 (add (fre-up 1.0 0 1023 0) (fre-dn 0.5 -1 -1074 0)))
    (let odd (add (fre-up-odd 1.0 0 1020 0) (fre-dn-odd 0.5 -1 -1074 0)))
    (let subs (fre-sub 5e-324 0 60 0))
    (let tens (add (fre-ten-up 1.0 0 308 0) (fre-ten-dn 0.1 -1 -323 0)))
    (let named (if (str_eq (float-repr 7.120236347223045e-307) "7.120236347223045e-307") (if (str_eq (float-repr 1.7976931348623157e308) "1.7976931348623157e+308") (str_eq (float-repr 5e-324) "5e-324") false) false))
    (defn fre-heat (n acc) (if (le n 0) acc (fre-heat (sub n 1) (add acc (str_len (float-repr 147142857142857.125))))))
    (let heated (fre-heat 2000 0))
    (defn fre-state (name rows) (if (nil? rows) -99 (if (str_eq (nth (head rows) 1) name) (nth (head rows) 7) (fre-state name (tail rows)))))
    (let rows (kernel_page_hot (host_pid) 300))
    (let word-ok (if (eq (fre-state "d4w-run" rows) 2) (eq (fre-state "d4w-scale" rows) 2) false))
    (add (fre-bit (eq pow2 0) 1) (add (fre-bit (eq odd 0) 2) (add (fre-bit (eq subs 0) 4) (add (fre-bit (eq tens 0) 8) (add (fre-bit named 16) (fre-bit word-ok 32)))))))
