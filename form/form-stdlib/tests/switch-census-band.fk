; switch-census-band.fk — the ratchet has teeth, and the arithmetic is not wishful.
;
; What a band can prove here and what it cannot. It CANNOT count the switches in the tree — that is a
; grep over *.sh, and this body has no shell. What it CAN do is make the recorded census internally
; honest and the ratchet real: the three categories must exhaust the total (no switch quietly
; unclassified), the experiment count must be a consequence rather than a second opinion, and the
; ceiling must actually reject a census above it. A ratchet that cannot fail is a wish with a number.
;
; Verdict 63 = 1 categories-exhaust-total | 2 experiment-is-derived | 4 ceiling-admits-today
;            | 8 ceiling-rejects-more | 16 law-is-stated | 32 no-category-named-limit
;
; preludes: form-stdlib/core.fk, form-stdlib/switch-census.fk

(do
    (defn scb-score (ok bit) (if ok bit 0))

    ; the three buckets must account for every switch — an unclassified switch is one nobody decided
    (let b1 (scb-score (eq (add (sc-input) (add (sc-instrument) (sc-experiment))) (sc-measured)) 1))

    ; and the ds4 + cli split must equal the same total, so the two ways of counting agree
    (let b2 (scb-score (eq (add (sc-measured-ds4) (sc-measured-cli)) (sc-measured)) 2))

    ; the ceiling admits today's census...
    (let b3 (scb-score (eq (sc-within-ratchet? (sc-measured)) 1) 4))
    ; ...and rejects one more than today. This is the bit that makes it a ratchet and not a label.
    (let b4 (scb-score (eq (sc-within-ratchet? (add (sc-measured) 1)) 0) 8))

    (let b5 (scb-score (ge (len (sc-law)) 5) 16))

    ; The law must actually CARRY the principle, not merely be five sentences long. My first attempt
    ; at this bit asked that no sentence contain the word "limit" — which the law violates on purpose,
    ; twice, because "the only limits are the physical hardware" and "never a limit" are the point.
    ; The band was wrong and the cell was right. Ask instead for the two phrases that mean it.
    (defn scb-any-says (xs sub)
        (if (eq (len xs) 0) 0
            (if (ge (str_find (head xs) sub 0) 0) 1 (scb-any-says (tail xs) sub))))
    (let b6 (scb-score (and (eq (scb-any-says (sc-law) "unfinished work") 1)
                            (eq (scb-any-says (sc-law) "physical hardware") 1)) 32))

    (print_str (str_concat "measured " (str_concat (int_to_str (sc-measured))
               (str_concat "  experiments-to-delete " (int_to_str (sc-experiment))))))
    (add b1 (add b2 (add b3 (add b4 (add b5 b6))))))
