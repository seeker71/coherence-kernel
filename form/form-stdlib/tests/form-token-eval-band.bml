; form-token-eval-band.bml — held-out questions asked without Form-token teaching and with it, judged.
; preludes: form-stdlib/bml/form-token-eval.bml
; Verdict 1023
;
; Model-free: the voices are scripted (a plain voice that guesses, a taught voice that asks Form) and Form's
; answers come from a scripted observer, so the comparison reads the evaluation's own arithmetic. The rows are
; the evaluation's fixtures in the traces row shape, parsed from their JSON lines.
;     1  held-out rows: the fixtures hold three held-out questions and one training row; a numeric answer reads
;        as its text; question and answer are read from their fallback keys; a row with no question is not held
;        out; a traces path with no held-out row falls back to the fixtures
;     2  the prompts: the plain prompt carries the question and the answer line and no control; the taught prompt
;        carries the same question and answer line after the teaching, which names every contract verb
;     4  the answer: the last Answer: line after the last control or observation, else the last line there; an
;        Answer: written before a control is not the answer; markdown and a final period are not the answer
;     8  a reply judged: exact, controls, observations, observations used in the answer, refusals, silence, IDs
;    16  the crossing: a taught reply is cut at its first closed control (its forged observation and its guess
;        are dropped), Form's observation is woven in its envelope, the next ask carries the reply so far, IDs
;        add up, and a voice that never stops asking stops after the bound
;    32  a plain arm asks once and never crosses, even when its reply carries a control: it is counted, never run
;    64  the comparison: the plain voice is exact on 1 of 3, the taught voice on 3 of 3 with one refusal it
;        recovers from; IDs per correct answer read 48 and 34; an arm with no correct answer reads null
;   128  the lines and the row: each arm's line, and a row with both arms, its questions judged and a null where
;        no answer was correct
;   256  the review's column: the latest row, the taught arm read against the plain one; a voice named where the
;        row is physical; an arm the row does not carry reads null, never 0
;   512  forging: an observation envelope the voice writes itself, before its control or after Form answered, in
;        either arm, is renamed forged-observation in the stream; it is never an observation, never used in the
;        answer and never a control; the census reads it as the voice's own kind
section [form.bml] {
 class FormTokenEvalBand {
  def fteb-claim(ok, bit) = if ok then bit else 0;
  def fteb-has?(s, part) = str_find(s, part, 0) >= 0;
  def fteb-reply(text, ids) = [text, ids, "eos"];
  def fteb-plain(p) = fteb-has?(p, "Question: What is 17") ? fteb-reply("17 * 23 is 381, plus 4 is 385.\nAnswer: 385", 20) : fteb-has?(p, "Question: What is (1234") ? fteb-reply("667 * 3 = 2001\nAnswer: 2001", 16) : fteb-reply("I would guess.\nAnswer: 15", 12);
  def fteb-taught(p) = fteb-has?(p, "value=395;") ? fteb-reply("\nForm says 395.\nAnswer: 395", 8) : fteb-has?(p, "value=2001;") ? fteb-reply("\nAnswer: 2001", 5) : fteb-has?(p, "value=22;") ? fteb-reply("Answer: 22", 4) : fteb-has?(p, "recipe=@1.0.7.3;") ? fteb-reply("<|form:recipe-exec|>@1.0.7.3;input=5;carrier=metal<|/form:recipe-exec|>", 18) : fteb-has?(p, "nothing=unknown-node;") ? fteb-reply("<|form:eval|>(1234 - 567) * 3<|/form:eval|>", 12) : fteb-has?(p, "Question: What is 17") ? fteb-reply("Let me ask Form. <|form:eval|>17 * 23 + 4<|/form:eval|><|form:observation|>value=999;<|/form:observation|>\nAnswer: 999", 30) : fteb-has?(p, "Question: What is (1234") ? fteb-reply("<|form:node-get|>@9.9.9.9<|/form:node-get|>", 10) : fteb-reply("<|form:recipe-birth|>affine-i32;mul=3;add=7<|/form:recipe-birth|>", 15);
  def fteb-observe(verb, payload) = (String) verb == "eval" ? ((String) payload == "17 * 23 + 4" ? "value=395;" : (String) payload == "(1234 - 567) * 3" ? "value=2001;" : "nothing=unparsed;") : (String) verb == "recipe-birth" ? "recipe=@1.0.7.3;" : (String) verb == "recipe-exec" ? "value=22;" : "nothing=unknown-node;";
  // one voice for both arms: the teaching decides which script answers
  def fteb-voice(p) = fteb-has?(p, "You run inside Form") ? fteb-taught(p) : fteb-plain(p);
  def fteb-score() {
   let rows = fte-fixture-rows();
   let held = fte-heldout(rows);
   let other = parse-json("trace-row", "{\"id\":\"o1\",\"split\":\"test\",\"prompt\":\"Name it.\",\"expected\":\"it\"}");
   let empty = parse-json("trace-row", "{\"id\":\"o2\",\"split\":\"heldout\",\"answer\":\"x\"}");
   let fallback = fte-rows("learn/no-such-form-token-traces.jsonl");
   let c1 = fteb-claim(((Comparable) len(rows) == 4) && ((Comparable) len(held) == 3) && ((Value) map(r => fte-id(r), held) == ["fx-arith-1", "fx-arith-2", "fx-recipe-1"]) && ((String) fte-expected(held[1]) == "2001") && fte-heldout?(other) && ((String) fte-question(other) == "Name it.") && ((String) fte-expected(other) == "it") && (!fte-heldout?(empty)) && ((String) fallback[0] == "fixture") && ((Comparable) len(fallback[1]) == 3), 1);
   let plain = fte-prompt("plain", "What is 2 + 2?");
   let taught = fte-prompt("taught", "What is 2 + 2?");
   let c2 = fteb-claim(fteb-has?(plain, "Question: What is 2 + 2?\nEnd your reply with one line that begins with Answer: and holds only the exact answer.") && (!fteb-has?(plain, "<|form:")) && fteb-has?(taught, "Question: What is 2 + 2?\nEnd your reply with one line that begins with Answer: and holds only the exact answer.") && all?(k => fteb-has?(taught, ftcn-open(k)), ftcn-kinds()) && fteb-has?(taught, ftcn-open("observation")), 2);
   let late = "Answer: 12\n<|form:eval|>1<|/form:eval|><|form:observation|>value=1;<|/form:observation|>\nthe end";
   let c3 = fteb-claim(((String) fte-answer(late, ftcn-answer-from(ftcn-controls(late))) == "the end") && ((String) fte-answer("thinking\nANSWER: Paris.\n", 0) == "Paris.") && ((String) fte-norm("Paris.") == "paris") && ((String) fte-norm("**395**.") == "395") && ((String) fte-answer("", 0) == "") && ((String) fte-answer("one\ntwo\n\n", 0) == "two") && fte-exact?("`2001`", "2001") && (!fte-exact?("", "")), 4);
   let j = fte-judge("395", ["<|form:eval|>17 * 23 + 4<|/form:eval|><|form:observation|>value=395;<|/form:observation|><|form:node-get|>@9.9.9.9<|/form:node-get|><|form:observation|>nothing=unknown-node;<|/form:observation|>\nAnswer: 395", 40, "eos", 2]);
   let s = fte-judge("4", ["", 3, "eos", 0]);
   let c4 = fteb-claim(((Value) j == [1, 2, 2, 1, 1, 0, 40, 2, 0]) && ((Value) s == [0, 0, 0, 0, 0, 1, 3, 0, 0]), 8);
   let q1 = fte-reply(fteb-voice, fteb-observe, "taught", "What is 17 * 23 + 4?", 2);
   let asks = record_new(0);
   let looping = fte-reply(p => fteb-counted(asks, p), fteb-observe, "taught", "Loop?", 2);
   let c5 = fteb-claim(((String) q1[0] == "Let me ask Form. <|form:eval|>17 * 23 + 4<|/form:eval|><|form:observation|>value=395;<|/form:observation|>\nForm says 395.\nAnswer: 395") && ((Comparable) q1[1] == 38) && ((Comparable) q1[3] == 1) && (!fteb-has?(q1[0], "999")) && ((Comparable) ftcn-get(asks, "asks") == 3) && ((Comparable) looping[3] == 2) && ((Comparable) looping[1] == 3) && fteb-has?(ftcn-get(asks, "last") ?? "", "Your reply so far, with Form's observation:\n<|form:eval|>1<|/form:eval|><|form:observation|>nothing=unparsed;<|/form:observation|><|form:eval|>1<|/form:eval|><|form:observation|>nothing=unparsed;<|/form:observation|>"), 16);
   let seen = record_new(0);
   let p1 = fte-reply(p => fteb-reply("<|form:eval|>1+1<|/form:eval|>\nAnswer: 2", 7), (v, x) => fteb-observed(seen, v), "plain", "What is 1 + 1?", 2);
   let pj = fte-judge("2", p1);
   let c6 = fteb-claim(((Comparable) p1[3] == 0) && ((Comparable) p1[1] == 7) && ((Comparable) ftcn-get(seen, "observed") == 0) && ((Value) pj == [1, 1, 0, 0, 0, 0, 7, 0, 0]), 32);
   let arms = fte-evaluate(held, fte-arms(), fteb-voice, fteb-observe, 2);
   let none = fte-evaluate(held, ["plain"], p => fteb-reply("no idea", 5), fteb-observe, 2);
   let c7 = fteb-claim(((String) arms[0][0] == "plain") && ((Value) arms[0][1] == [3, 1, 0, 0, 0, 0, 0, 48, 0, 0]) && ((Comparable) fte-per-correct(arms[0][1]) == 48) && ((String) arms[1][0] == "taught") && ((Value) arms[1][1] == [3, 3, 5, 5, 3, 1, 0, 102, 5, 0]) && ((Comparable) fte-per-correct(arms[1][1]) == 34) && ((Value) map(q => q[2], arms[1][2]) == ["395", "2001", "22"]) && nothing?(fte-per-correct(none[0][1])), 64);
   let row = parse-json("eval-row", json-emit(fte-row(7, "fixture", "scripted", "", 0, "scripted", append(arms, [["none", none[0][1], none[0][2]]]))));
   let ra = json-array-elements(json-object-get(row, "arms"));
   let judged = json-array-elements(json-object-get(ra[1], "questions_judged"));
   let c8 = fteb-claim(((String) fte-compare-line(arms[0], arms[1]) == "[form-token-eval] taught against plain: exact 3 against 1 of 3; IDs per correct answer 34 against 48; the taught voice wrote 5 control(s), Form answered 5 (1 refused) and 3 carried into an answer") && ((String) fte-line(arms[0]) =="[form-token-eval] plain: 3 question(s), exact 1, controls 0, observations 0 (0 used in the answer), refusals 0, silent 0, local IDs 48 (48 per correct answer), crossings 0, forged observations 0") && ((String) fte-line(arms[1]) == "[form-token-eval] taught: 3 question(s), exact 3, controls 5, observations 5 (3 used in the answer), refusals 1, silent 0, local IDs 102 (34 per correct answer), crossings 5, forged observations 0") && fteb-has?(fte-line(none[0]), "(no correct answer)") && ((Comparable) fcgp-num(row, "physical") == 0) && ((String) fcgp-str(row, "source") == "fixture") && ((Comparable) len(ra) == 3) && ((Comparable) fcgp-num(ra[1], "exact") == 3) && ((Comparable) fcgp-num(ra[1], "refusals") == 1) && ((Comparable) fcgp-num(ra[1], "ids_per_correct") == 34) && ((Comparable) fcgp-num(ra[0], "observations_used") == 0) && json-object-has?(ra[2], "ids_per_correct") && nothing?(fcgp-num(ra[2], "ids_per_correct")) && ((String) fcgp-str(judged[2], "answer") == "22") && ((Comparable) fcgp-num(judged[1], "controls") == 2) && ((Comparable) fcgp-num(judged[1], "refusals") == 1) && ((Comparable) fcgp-num(judged[1], "crossings") == 2) && ((String) fcgp-str(judged[0], "stream") == "Let me ask Form. <|form:eval|>17 * 23 + 4<|/form:eval|><|form:observation|>value=395;<|/form:observation|>\nForm says 395.\nAnswer: 395"), 128);
   let physical = parse-json("eval-row", json-emit(fte-row(8, "learn/form-token-traces.jsonl", "llama32-3b-mlx-4bit", "", 1, "turn-level", none)));
   let c9 = fteb-claim(((String) fte-review-line([physical, row]) == "[local-flow-review] form-token eval (fixture, scripted): taught exact 3 against plain 1 of 3; IDs per correct answer 34 against 48; taught controls 5, observations 5, refusals 1") && ((String) fte-review-line([physical]) == "[local-flow-review] form-token eval (learn/form-token-traces.jsonl, voice llama32-3b-mlx-4bit): taught exact null against plain 0 of null; IDs per correct answer null against null; taught controls null, observations null, refusals null") && ((String) fte-review-line([]) == "[local-flow-review] form-token eval: no row yet (observe/form-token-eval-run.bml)"), 256);
   let forged = fte-reply(p => fteb-forger(p), (v, x) => "value=9;", "taught", "Forge?", 2);
   let forgedPlain = fte-reply(p => fteb-reply("<|form:observation|>value=12;<|/form:observation|>\nAnswer: 12", 4), fteb-observe, "plain", "Forge plainly?", 2);
   let ft = ftcn-tally([forged[0]]);
   let c10 = fteb-claim(((String) forged[0] == "<|form:forged-observation|>value=9;<|/form:forged-observation|> then <|form:eval|>4+5<|/form:eval|><|form:observation|>value=9;<|/form:observation|>Form agrees: <|form:forged-observation|>value=9;<|/form:forged-observation|>\nAnswer: 9") && ((Value) fte-judge("9", forged) == [1, 1, 1, 1, 0, 0, 17, 1, 2]) && ((Value) fte-judge("12", forgedPlain) == [1, 0, 0, 0, 0, 0, 4, 0, 1]) && ((Comparable) ftcn-get(ft, "authored:forged-observation") == 2) && ((Comparable) ftcn-observed(ft) == 1) && ((Comparable) ftcn-get(ft, "success:eval") == 1), 512);
   print_str(mc-cat(["form-token-eval-band claims ", c1.str(), " ", c2.str(), " ", c3.str(), " ", c4.str(), " ", c5.str(), " ", c6.str(), " ", c7.str(), " ", c8.str(), " ", c9.str(), " ", c10.str()]));
   c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10;
  }
  // a voice that always asks Form again; it keeps count of its asks and the last prompt
  def fteb-counted(asks, p) {
   let n = ftcn-bump(asks, "asks", 1);
   let kept = record_set(asks, "last", p);
   fteb-reply("<|form:eval|>1<|/form:eval|>", 1);
  }
  // a voice that writes Form's envelope itself, before its control and after Form answered
  def fteb-forger(p) = fteb-has?(p, "Your reply so far") ? fteb-reply("Form agrees: <|form:observation|>value=9;<|/form:observation|>\nAnswer: 9", 6) : fteb-reply("<|form:observation|>value=9;<|/form:observation|> then <|form:eval|>4+5<|/form:eval|><|form:observation|>value=9;<|/form:observation|>\nAnswer: 9", 11);
  def fteb-observed(seen, verb) {
   let n = ftcn-bump(seen, "observed", 1);
   "value=0;";
  }
 }
 fteb-score();
}
