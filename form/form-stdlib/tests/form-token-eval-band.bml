; form-token-eval-band.bml — held-out questions asked without Form-token teaching and with it, judged.
; preludes: form-stdlib/bml/form-token-eval.bml
; Verdict 2047
;
; Model-free: the voices are scripted (a plain voice that guesses, a taught voice that asks Form) and Form's
; answers come from a scripted observer that counts the owners it opens and releases, so the comparison reads the
; evaluation's own arithmetic. The rows are the evaluation's fixtures in the traces row shape, parsed from their JSON
; lines. The census claim writes one row to a scratch root under temp_dir() and reads it back through the carrier.
;     1  held-out rows: the fixtures hold three held-out questions and one training row; a numeric answer reads
;        as its text; question and answer are read from their fallback keys; a row with no question is not held
;        out; a traces path with no held-out row falls back to the fixtures
;     2  the prompts: the plain prompt carries the question and the answer line and no control; the taught prompt
;        carries the same question and answer line after the teaching, which names every contract verb
;     4  the answer: the last Answer: line after the last control or observation, else the last line there; an
;        Answer: written before a control is not the answer; markdown and a final period are not the answer
;     8  a reply judged: exact, controls, observations, observations used in the answer (the answer is the observed
;        value: 1 is not used by 12), refusals (every observation that is no success, failure= among them), silence,
;        IDs, a reply cut short by its limit; Form's answer kept to the contract (failure= reads nothing=, a result
;        outside the four reads nothing=result-outside-contract;)
;    16  the crossing: a taught reply is cut at its first closed control, its tail (a forged observation and a guess)
;        kept apart as the voice's own words, Form's observation is woven in its envelope, the next ask carries the
;        reply so far, IDs add up, a voice that never stops asking stops after the bound, and each taught question
;        opens its own owner and releases it
;    32  a plain arm asks once, never crosses and opens no owner, even when its reply carries a control: it is
;        counted, never run; a bare result it writes after its control is forged, never an observation or used; so
;        is one a taught voice writes once its crossings are spent
;    64  the comparison: the plain voice is exact on 1 of 3, the taught voice on 3 of 3 with one refusal it
;        recovers from and one forged envelope in a cut tail; IDs per correct answer read 48 and 34; three owners
;        opened and released clean; an arm with no correct answer reads null
;   128  the lines and the row: each arm's line, and a row with both arms, its questions judged with their stop
;        reasons and cut tails, its owners, and a null where no answer was correct; an owner released incomplete is
;        read as such
;   256  the review's column: the latest row, the taught arm read against the plain one; a voice named where the
;        row is physical; an arm the row does not carry reads null, never 0
;   512  forging: an observation envelope or a runtime marker the voice writes itself, before its control, in its cut
;        tail or after Form answered, in either arm, is renamed forged-<kind>; it is never an observation, never a
;        runtime marker, never used in the answer and never a control; the census reads the judged row alike: the
;        same controls, observations and forged words over the same IDs
;  1024  the GPU gate reads argv: a door that holds a model named in any word of an fkwu's argv (another
;        form-token-eval-run among them), a form-cli verb that asks a local model, and nothing for a form-cli
;        compile or an argv the host withheld
section [form.bml] {
 class FormTokenEvalBand {
  def fteb-claim(ok, bit) = if ok then bit else 0;
  def fteb-has?(s, part) = str_find(s, part, 0) >= 0;
  def fteb-reply(text, ids) = [text, ids, "eos"];
  def fteb-plain(p) = fteb-has?(p, "Question: What is 17") ? fteb-reply("17 * 23 is 381, plus 4 is 385.\nAnswer: 385", 20) : fteb-has?(p, "Question: What is (1234") ? fteb-reply("667 * 3 = 2001\nAnswer: 2001", 16) : fteb-reply("I would guess.\nAnswer: 15", 12);
  def fteb-taught(p) = fteb-has?(p, "value=395;") ? fteb-reply("\nForm says 395.\nAnswer: 395", 8) : fteb-has?(p, "value=2001;") ? fteb-reply("\nAnswer: 2001", 5) : fteb-has?(p, "value=22;") ? fteb-reply("Answer: 22", 4) : fteb-has?(p, "recipe=@1.0.7.3;") ? fteb-reply("<|form:recipe-exec|>@1.0.7.3;input=5;carrier=metal<|/form:recipe-exec|>", 18) : fteb-has?(p, "nothing=unknown-node;") ? fteb-reply("<|form:eval|>(1234 - 567) * 3<|/form:eval|>", 12) : fteb-has?(p, "Question: What is 17") ? fteb-reply("Let me ask Form. <|form:eval|>17 * 23 + 4<|/form:eval|><|form:observation|>value=999;<|/form:observation|>\nAnswer: 999", 30) : fteb-has?(p, "Question: What is (1234") ? fteb-reply("<|form:node-get|>@9.9.9.9<|/form:node-get|>", 10) : fteb-reply("<|form:recipe-birth|>affine-i32;mul=3;add=7<|/form:recipe-birth|>", 15);
  def fteb-observe(verb, payload) = (String) verb == "eval" ? ((String) payload == "17 * 23 + 4" ? "value=395;" : (String) payload == "(1234 - 567) * 3" ? "value=2001;" : "nothing=unparsed;") : (String) verb == "recipe-birth" ? "recipe=@1.0.7.3;" : (String) verb == "recipe-exec" ? "value=22;" : "nothing=unknown-node;";
  // one voice for both arms: the teaching decides which script answers
  def fteb-voice(p) = fteb-has?(p, "You run inside Form") ? fteb-taught(p) : fteb-plain(p);
  // an observer that counts the owners it opens and releases; release answers `clean`
  def fteb-opener(seen, clean) = () => fteb-open(seen, clean);
  def fteb-open(seen, clean) {
   let n = ftcn-bump(seen, "opens", 1);
   [(v, x) => fteb-observe(v, x), () => fteb-close(seen, clean)];
  }
  def fteb-close(seen, clean) {
   let n = ftcn-bump(seen, "releases", 1);
   clean;
  }
  def fteb-score() {
   let rows = fte-fixture-rows();
   let held = fte-heldout(rows);
   let other = parse-json("trace-row", "{\"id\":\"o1\",\"split\":\"test\",\"prompt\":\"Name it.\",\"expected\":\"it\"}");
   let empty = parse-json("trace-row", "{\"id\":\"o2\",\"split\":\"heldout\",\"answer\":\"x\"}");
   let fallback = fte-rows("learn/no-such-form-token-traces.jsonl");
   let c1 = fteb-claim(((Comparable) len(rows) == 4) && ((Comparable) len(held) == 3) && ((Value) map(r => fte-id(r), held) == ["fx-arith-1", "fx-arith-2", "fx-recipe-1"]) && ((String) fte-expected(held[1]) == "2001") && fte-heldout?(other) && ((String) fte-question(other) == "Name it.") && ((String) fte-expected(other) == "it") && (!fte-heldout?(empty)) && ((String) fallback[0] == "fixture") && ((Comparable) len(fallback[1]) == 3), 1);
   let plain = fte-prompt("plain", "What is 2 + 2?");
   let taught = fte-prompt("taught", "What is 2 + 2?");
   let c2 = fteb-claim(fteb-has?(plain, "Question: What is 2 + 2?\nEnd your reply with one line that begins with Answer: and holds only the exact answer.") && (!fteb-has?(plain, "<|form:")) && fteb-has?(taught, "Question: What is 2 + 2?\nEnd your reply with one line that begins with Answer: and holds only the exact answer.") && all?(k => fteb-has?(taught, ftcn-open(k)), ftcn-kinds()) && fteb-has?(taught, ftcn-open("observation")), 2);
   let late = "Answer: 12\n<|form:eval|>1<|/form:eval|><|form:observation|>value=1;<|/form:observation|>\nthe end";
   let c3 = fteb-claim(((String) fte-answer(late, ftcn-answer-from(ftcn-controls(late))) == "the end") && ((String) fte-answer("thinking\nANSWER: Paris.\n", 0) == "Paris.") && ((String) fte-norm("Paris.") == "paris") && ((String) fte-norm("**395**.") == "395") && ((String) fte-answer("", 0) == "") && ((String) fte-answer("one\ntwo\n\n", 0) == "two") && fte-exact?("`2001`", "2001") && (!fte-exact?("", "")), 4);
   let j = fte-judge("395", ["<|form:eval|>17 * 23 + 4<|/form:eval|><|form:observation|>value=395;<|/form:observation|><|form:node-get|>@9.9.9.9<|/form:node-get|><|form:observation|>nothing=unknown-node;<|/form:observation|>\nAnswer: 395.", 40, "eos", 2]);
   let s = fte-judge("4", ["", 3, "eos", 0]);
   let loose = fte-judge("12", ["<|form:eval|>1<|/form:eval|><|form:observation|>value=1;<|/form:observation|>\nAnswer: 12", 9, "eos", 1]);
   let failed = fte-judge("x", ["<|form:recipe-birth|>affine-i32;mul=abc;add=7<|/form:recipe-birth|><|form:observation|>failure=mul-integer;<|/form:observation|>\nAnswer: x", 5, "eos", 1]);
   let cut = fte-judge("3", ["17 is prime, so the answer must be", 160, "token-limit", 0]);
   let c4 = fteb-claim(((Value) j == [1, 2, 2, 1, 1, 0, 40, 2, 0, 0, 0, 0]) && ((Value) s == [0, 0, 0, 0, 0, 1, 3, 0, 0, 0, 0, 0]) && ((Value) loose == [1, 1, 1, 0, 0, 0, 9, 1, 0, 0, 0, 0]) && ((Value) failed == [1, 1, 1, 0, 1, 0, 5, 1, 0, 0, 0, 0]) && ((Value) cut == [0, 0, 0, 0, 0, 0, 160, 0, 0, 1, 0, 0]) && ((String) fte-contract("failure=mul-integer;") == "nothing=mul-integer;") && ((String) fte-contract("value=22;") == "value=22;") && ((String) fte-contract("node=@1.2.3.4;") == "node=@1.2.3.4;") && ((String) fte-contract("") == "nothing=result-outside-contract;") && ((String) fte-contract("garbage") == "nothing=result-outside-contract;"), 8);
   let opened = record_new(0);
   let q1 = fte-reply(fteb-voice, fteb-opener(opened, 1), "taught", "What is 17 * 23 + 4?", 2);
   let asks = record_new(0);
   let looping = fte-reply(p => fteb-counted(asks, p), fte-scripted(fteb-observe), "taught", "Loop?", 2);
   let c5 = fteb-claim(((String) q1[0] == "Let me ask Form. <|form:eval|>17 * 23 + 4<|/form:eval|><|form:observation|>value=395;<|/form:observation|>\nForm says 395.\nAnswer: 395") && ((Value) q1[4] == ["<|form:forged-observation|>value=999;<|/form:forged-observation|>\nAnswer: 999"]) && ((Comparable) q1[1] == 38) && ((Comparable) q1[3] == 1) && ((Comparable) q1[5] == 1) && (!fteb-has?(q1[0], "999")) && ((Comparable) ftcn-get(opened, "opens") == 1) && ((Comparable) ftcn-get(opened, "releases") == 1) && ((Comparable) ftcn-get(asks, "asks") == 3) && ((Comparable) looping[3] == 2) && ((Comparable) looping[1] == 3) && nil?(looping[4]) && fteb-has?(ftcn-get(asks, "last") ?? "", "Your reply so far, with Form's observation:\n<|form:eval|>1<|/form:eval|><|form:observation|>nothing=unparsed;<|/form:observation|><|form:eval|>1<|/form:eval|><|form:observation|>nothing=unparsed;<|/form:observation|>"), 16);
   let seen = record_new(0);
   let p1 = fte-reply(p => fteb-reply("<|form:eval|>1+1<|/form:eval|>\nAnswer: 2", 7), fteb-opener(seen, 1), "plain", "What is 1 + 1?", 2);
   let pj = fte-judge("2", p1);
   let pb = fte-judge("2", fte-reply(p => fteb-reply("<|form:eval|>1+1<|/form:eval|> value=2;\nAnswer: 2", 7), fteb-opener(seen, 1), "plain", "What is 1 + 1?", 2));
   let tb = fte-judge("9", fte-reply(p => fteb-reply("<|form:eval|>4+5<|/form:eval|> value=9;\nAnswer: 9", 5), fte-scripted((v, x) => "nothing=never-asked;"), "taught", "What is 4 + 5?", 0));
   let c6 = fteb-claim(((Comparable) p1[3] == 0) && ((Comparable) p1[1] == 7) && nothing?(p1[5]) && ((Comparable) ftcn-get(seen, "opens") == 0) && ((Value) pj == [1, 1, 0, 0, 0, 0, 7, 0, 0, 0, 0, 0]) && ((Value) pb == [1, 1, 0, 0, 0, 0, 7, 0, 1, 0, 0, 0]) && ((Value) tb == [1, 1, 0, 0, 0, 0, 5, 0, 1, 0, 1, 1]), 32);
   let owners = record_new(0);
   let arms = fte-evaluate(held, fte-arms(), fteb-voice, fteb-opener(owners, 1), 2);
   let none = fte-evaluate(held, ["plain"], p => fteb-reply("no idea", 5), fte-scripted(fteb-observe), 2);
   let c7 = fteb-claim(((String) arms[0][0] == "plain") && ((Value) arms[0][1] == [3, 1, 0, 0, 0, 0, 0, 48, 0, 0, 0, 0, 0]) && ((Comparable) fte-per-correct(arms[0][1]) == 48) && ((String) arms[1][0] == "taught") && ((Value) arms[1][1] == [3, 3, 5, 5, 3, 1, 0, 102, 5, 1, 0, 3, 3]) && ((Comparable) fte-per-correct(arms[1][1]) == 34) && ((Value) map(q => q[2], arms[1][2]) == ["395", "2001", "22"]) && ((Comparable) ftcn-get(owners, "opens") == 3) && ((Comparable) ftcn-get(owners, "releases") == 3) && nothing?(fte-per-correct(none[0][1])), 64);
   let row = parse-json("eval-row", json-emit(fte-row(7, "fixture", "scripted", "", 0, "scripted", append(arms, [["none", none[0][1], none[0][2]]]))));
   let ra = json-array-elements(json-object-get(row, "arms"));
   let judged = json-array-elements(json-object-get(ra[1], "questions_judged"));
   let dirty = fte-evaluate([held[0]], ["taught"], fteb-voice, fteb-opener(record_new(0), 0), 2);
   let c8 = fteb-claim(((String) fte-compare-line(arms[0], arms[1]) == "[form-token-eval] taught against plain: exact 3 against 1 of 3; IDs per correct answer 34 against 48; the taught voice wrote 5 control(s), Form answered 5 (1 refused) and 3 carried into an answer") && ((String) fte-line(arms[0]) == "[form-token-eval] plain: 3 question(s), exact 1, controls 0, observations 0 (0 used in the answer), refusals 0, silent 0, local IDs 48 (48 per correct answer), crossings 0, forged 0, truncated 0, owners released clean 0 of 0") && ((String) fte-line(arms[1]) == "[form-token-eval] taught: 3 question(s), exact 3, controls 5, observations 5 (3 used in the answer), refusals 1, silent 0, local IDs 102 (34 per correct answer), crossings 5, forged 1, truncated 0, owners released clean 3 of 3") && fteb-has?(fte-line(dirty[0]), "owners released clean 0 of 1") && fteb-has?(fte-line(none[0]), "(no correct answer)") && ((Comparable) fcgp-num(row, "physical") == 0) && ((String) fcgp-str(row, "source") == "fixture") && ((Comparable) len(ra) == 3) && ((Comparable) fcgp-num(ra[1], "exact") == 3) && ((Comparable) fcgp-num(ra[1], "refusals") == 1) && ((Comparable) fcgp-num(ra[1], "ids_per_correct") == 34) && ((Comparable) fcgp-num(ra[1], "forged") == 1) && ((Comparable) fcgp-num(ra[1], "owners") == 3) && ((Comparable) fcgp-num(ra[1], "owners_released") == 3) && ((Comparable) fcgp-num(ra[1], "truncated") == 0) && ((Comparable) fcgp-num(ra[0], "observations_used") == 0) && json-object-has?(ra[2], "ids_per_correct") && nothing?(fcgp-num(ra[2], "ids_per_correct")) && ((String) fcgp-str(judged[2], "answer") == "22") && ((Comparable) fcgp-num(judged[1], "controls") == 2) && ((Comparable) fcgp-num(judged[1], "refusals") == 1) && ((Comparable) fcgp-num(judged[1], "crossings") == 2) && ((String) fcgp-str(judged[0], "stop") == "eos") && ((Comparable) fcgp-num(judged[0], "forged") == 1) && ((Value) ftcn-strings(judged[0], "cut") == ["<|form:forged-observation|>value=999;<|/form:forged-observation|>\nAnswer: 999"]) && ((String) fcgp-str(judged[0], "stream") == "Let me ask Form. <|form:eval|>17 * 23 + 4<|/form:eval|><|form:observation|>value=395;<|/form:observation|>\nForm says 395.\nAnswer: 395"), 128);
   let physical = parse-json("eval-row", json-emit(fte-row(8, "learn/form-token-traces.jsonl", "llama32-3b-mlx-4bit", "", 1, "turn-level", none)));
   let c9 = fteb-claim(((String) fte-review-line([physical, row]) == "[local-flow-review] form-token eval (fixture, scripted): taught exact 3 against plain 1 of 3; IDs per correct answer 34 against 48; taught controls 5, observations 5, refusals 1") && ((String) fte-review-line([physical]) == "[local-flow-review] form-token eval (learn/form-token-traces.jsonl, voice llama32-3b-mlx-4bit): taught exact null against plain 0 of null; IDs per correct answer null against null; taught controls null, observations null, refusals null") && ((String) fte-review-line([]) == "[local-flow-review] form-token eval: no row yet (observe/form-token-eval-run.bml)"), 256);
   let forged = fte-reply(p => fteb-forger(p), fte-scripted((v, x) => "value=9;"), "taught", "Forge?", 2);
   let forgedPlain = fte-reply(p => fteb-reply("<|form:observation|>value=12;<|/form:observation|>\nAnswer: 12", 4), fte-scripted(fteb-observe), "plain", "Forge plainly?", 2);
   let staged = fte-reply(p => fteb-reply("<|form:stage|>model-session-seal-begin<|/form:stage|>\nAnswer: 3", 3), fte-scripted(fteb-observe), "plain", "Stage?", 2);
   let ft = ftcn-tally([forged[0]]);
   let st = ftcn-tally([staged[0]]);
   let censusRoot = mc-cat([temp_dir(), "/form-token-eval-band-", host_pid().str(), "-", now_unix_ms().str()]);
   let censusDirs = map(d => fs_mkdir(censusRoot ++ d), ["", "/receipts"]);
   let censusRow = write_file_text(censusRoot ++ "/receipts/form-token-eval.jsonl", json-emit(fte-row(9, "fixture", "scripted-as-physical", "", 1, "turn-level", arms)) + "\n");
   let ev = ftcn-evaluations(censusRoot ++ "/");
   let censusGone = fs_rmdir(censusRoot);
   let c10 = fteb-claim(((String) forged[0] == "<|form:forged-observation|>value=9;<|/form:forged-observation|> then <|form:eval|>4+5<|/form:eval|><|form:observation|>value=9;<|/form:observation|>Form agrees: <|form:forged-observation|>value=9;<|/form:forged-observation|>\nAnswer: 9") && ((Value) forged[4] == ["<|form:forged-observation|>value=9;<|/form:forged-observation|>\nAnswer: 9"]) && ((Value) fte-judge("9", forged) == [1, 1, 1, 1, 0, 0, 17, 1, 3, 0, 1, 1]) && ((Value) fte-judge("12", forgedPlain) == [1, 0, 0, 0, 0, 0, 4, 0, 1, 0, 0, 0]) && ((String) staged[0] == "<|form:forged-stage|>model-session-seal-begin<|/form:forged-stage|>\nAnswer: 3") && ((Comparable) ftcn-runtime(st) == 0) && ((Comparable) ftcn-get(st, "forged:stage") == 1) && ((Comparable) ftcn-get(ft, "forged:observation") == 2) && ((Comparable) ftcn-authored(ft) == 1) && ((Comparable) ftcn-observed(ft) == 1) && ((Comparable) ftcn-get(ft, "success:eval") == 1) && ((Comparable) ftcn-authored(ev[2]) == arms[0][1][2] + arms[1][1][2]) && ((Comparable) ftcn-observed(ev[2]) == arms[0][1][3] + arms[1][1][3]) && ((Comparable) ftcn-forged(ev[2]) == arms[0][1][9] + arms[1][1][9]) && ((Comparable) ev[3] == arms[0][1][7] + arms[1][1][7]) && ((Comparable) ftcn-authored(ev[6]) == 5), 512);
   let c11 = fteb-claim(((String) fte-holding(["./fkwu", "observe/form-token-eval-run.bml"], false) == "form-token-eval-run") && ((String) fte-holding(["/opt/fkwu-20260911", "-x", "observe/native-turn-run.bml"], false) == "native-turn-run") && ((String) fte-holding(["./fkwu", "observe/form-token-census.bml"], false) == "") && ((String) fte-holding(["/tmp/x/form-cli", "--compile-source", "/tmp/y/body/form/form-stdlib/a.fk"], true) == "") && ((String) fte-holding(["/tmp/x/form-cli", "generate", "--reasoning", "64", "why"], true) == "form-cli generate") && ((String) fte-holding(["./fkwu", "generate"], false) == "") && ((String) fte-holding([], true) == "") && ((String) fte-holding(-1, true) == ""), 1024);
   print_str(mc-cat(["form-token-eval-band claims ", c1.str(), " ", c2.str(), " ", c3.str(), " ", c4.str(), " ", c5.str(), " ", c6.str(), " ", c7.str(), " ", c8.str(), " ", c9.str(), " ", c10.str(), " ", c11.str()]));
   c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11;
  }
  // a voice that always asks Form again; it keeps count of its asks and the last prompt
  def fteb-counted(asks, p) {
   let n = ftcn-bump(asks, "asks", 1);
   let kept = record_set(asks, "last", p);
   fteb-reply("<|form:eval|>1<|/form:eval|>", 1);
  }
  // a voice that writes Form's envelope itself, before its control, past it and after Form answered
  def fteb-forger(p) = fteb-has?(p, "Your reply so far") ? fteb-reply("Form agrees: <|form:observation|>value=9;<|/form:observation|>\nAnswer: 9", 6) : fteb-reply("<|form:observation|>value=9;<|/form:observation|> then <|form:eval|>4+5<|/form:eval|><|form:observation|>value=9;<|/form:observation|>\nAnswer: 9", 11);
 }
 fteb-score();
}
