; form-cli-embodied-goal-grammar-band.fk -- one BML-owned goal literal lowers
; to a compact local observation and retains its byte/token relation as data.
; Expected: 511
; preludes: form-stdlib/bml/form-cli-embodied-goal-grammar.bml

(do
    (defn fcpeggb-bit (ok bit) (if ok bit 0))
    (let prompt (fcpdag-embodied-goal-prompt))
    (let lowered (fcpdag-observation prompt))
    (let receipt (fcpdag-compression prompt lowered 50 8))
    (let absence (fcpdag-compression prompt lowered (nothing) (nothing)))
    (sum (list
        (fcpeggb-bit (and (eq (fcpdag-embodied-goal? prompt) 1)
            (str_eq (fcpdag-lane prompt) "embodied-goal-bml-direct-user")) 1)
        (fcpeggb-bit (and (lt (str_len lowered) (str_len prompt))
            (ge (str_find lowered "five compact clauses" 0) 0)) 2)
        (fcpeggb-bit (and (eq (fcpdag-compression? receipt) 1)
            (str_eq (fcpdag-compression-lane receipt)
                "embodied-goal-bml-direct-user")) 4)
        (fcpeggb-bit (and (eq (fcpdag-original-bytes receipt) (str_len prompt))
            (eq (fcpdag-lowered-bytes receipt) (str_len lowered))) 8)
        (fcpeggb-bit (eq (fcpdag-bytes-saved receipt)
            (sub (str_len prompt) (str_len lowered))) 16)
        (fcpeggb-bit (and (eq (fcpdag-original-ids receipt) 50)
            (and (eq (fcpdag-lowered-ids receipt) 8)
                (eq (fcpdag-ids-saved receipt) 42))) 32)
        (fcpeggb-bit (eq (fcpdag-id-reduction-bps receipt) 8400) 64)
        (fcpeggb-bit (and (nothing? (fcpdag-ids-saved absence))
            (and (nothing? (fcpdag-id-reduction-bps absence))
                (gt (fcpdag-byte-reduction-bps receipt) 0))) 128)
        (fcpeggb-bit (and (eq (fcpdag-exact-embodied-goal? prompt) 1)
            (and (eq (fcpdag-exact-embodied-goal? (str_concat prompt " ")) 0)
                (node_eq (fcpdag-embodied-goal-node)
                    (fcpdag-embodied-goal-node)))) 256))))
