; zvec-grep-band.fk — Form-native zg vertical slice.
;
; Verdict 16383 when exhaustive fixed search, BM25, semantic recall, RRF
; fusion, source coordinates, bounded results, hidden-state exclusion, native
; tool planning, and local/no-network execution all hold.
;
; PROOF LEVEL: FOURTH-ARM ONLY — source_inventory, host_path_is_dir,
; math_log, and round_ndigits each probe mask 8 (fkwu) on 2026-09-03.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/tool-channel.fk form-stdlib/bml/zvec-grep.bml

(do
    (defn zgb-bit (ok bit) (if ok bit 0))
    (defn zgb-has-name? (names wanted)
        (if (nil? names) 0
            (if (str_eq (head names) wanted) 1
                (zgb-has-name? (tail names) wanted))))
    (defn zgb-root () (fs-path-join (fs-temp-dir) "zvec-grep-band"))
    (defn zgb-setup ()
        (do
            (let root (zgb-root))
            (let _old (fs-remove-tree root))
            (let _mk (fs-mkdir root))
            (let _docs (fs-mkdir (fs-path-join root "docs")))
            (let _git (fs-mkdir (fs-path-join root ".git")))
            (let _a (fs-write-text (fs-path-join root "docs/a.md")
                "heading\nThe kernel lives here. Deploy proof deploy evidence.\n"))
            (let _b (fs-write-text (fs-path-join root "docs/b.md")
                "A deployment guide with unrelated filler.\n"))
            (let _c (fs-write-text (fs-path-join root "docs/c.md")
                "quantum banana xylophone aardvark\n"))
            (let _hidden (fs-write-text (fs-path-join root ".git/hidden.md")
                "inside git only phrase\n"))
            0))
    (defn zgb-cleanup () (fs-remove-tree (zgb-root)))
    (defn zvec-grep-band ()
        (do
            (let _setup (zgb-setup))
            (let root (zgb-root))
            (let exact (zg-query-at root (ZgRouteRg) "kernel lives" 7))
            (let exact-hit (head (zg-hits exact)))
            (let fts (zg-query-at root (ZgRouteFts) "deploy evidence" 7))
            (let fts-hit (head (zg-hits fts)))
            (let vector (zg-query-at root (ZgRouteVector) "deployment proof" 7))
            (let vector-hit (head (zg-hits vector)))
            (let hybrid (zg-query-at root (ZgRouteHybrid) "deploy evidence" 7))
            (let hybrid-hit (head (zg-hits hybrid)))
            (let limited (zg-query-at root (ZgRouteRg) "deploy" 1))
            (let hidden (zg-query-at root (ZgRouteRg) "inside git only phrase" 7))
            (let invalid (zg-query-at root "ambient" "deploy" 7))
            (let exact-scan (zg-scan-at root (ZgRouteRg) "deploy" (zg-unique-words "deploy")))
            (let plan (tc-plan-tool "zg" "cap.store.query"))
            (let descriptor (FormNativeZvecGrep))
            (let source (fs-read-text "form/form-stdlib/bml/zvec-grep.bml"))
            (let score (sum (list
                (zgb-bit (and (str_eq (zg-status exact) (ZgStatusHit))
                              (str_eq (zg-hit-path exact-hit) "docs/a.md")) 1)
                (zgb-bit (and (eq (zg-hit-line exact-hit) 2)
                              (eq (zg-hit-column exact-hit) 5)) 2)
                (zgb-bit (str_eq (zg-hit-path fts-hit) "docs/a.md") 4)
                (zgb-bit (and (gt (zg-hit-score fts-hit) 0)
                              (str_eq (zg-hit-matched-by fts-hit) (ZgRouteFts))) 8)
                (zgb-bit (and (str_eq (zg-hit-path vector-hit) "docs/a.md")
                              (str_eq (zg-hit-matched-by vector-hit) (ZgRouteVector))) 16)
                (zgb-bit (and (str_eq (zg-hit-matched-by hybrid-hit) (ZgMatchedBoth))
                              (and (gt (zg-hit-fts-rank hybrid-hit) 0)
                                   (gt (zg-hit-vector-rank hybrid-hit) 0))) 32)
                (zgb-bit (and (gt (zg-hit-score hybrid-hit) 0)
                              (str_eq (zg-hit-status hybrid-hit) (ZgFresh))) 64)
                (zgb-bit (eq (len (zg-hits limited)) 1) 128)
                (zgb-bit (and (str_eq (zg-status hidden) (ZgStatusMiss))
                              (eq (zg-accessible-count exact) 3)) 256)
                (zgb-bit (and (str_eq (zg-status invalid) (ZgStatusNothing))
                              (str_eq (zg-reason invalid) "invalid-route")) 512)
                (zgb-bit (and (str_eq (tc-plan-status plan) "tool/plan")
                              (and (str_eq (tc-plan-op plan) "hybrid-workspace-search")
                                   (eq (tc-native-option? "zg") 1))) 1024)
                (zgb-bit (and (eq (zg-local-model-runs hybrid) 0)
                              (and (eq (zg-network-crossings hybrid) 0)
                                   (and (eq (zg-scan-total-words exact-scan) 0)
                                        (eq (zg-doc-vector-score (head (zg-scan-docs exact-scan))) 0)))) 2048)
                (zgb-bit (and (ge (str_find source (ZgUpstream) 0) 0)
                              (and (ge (str_find source (ZgUpstreamCommit) 0) 0)
                                   (lt (str_find source "(host-exec " 0) 0))) 4096)
                (zgb-bit (and (str_eq (zg-result-schema hybrid) (ZgSchema))
                              (and (le (len (zg-hits hybrid)) (ZgDefaultLimit))
                                   (and (ge (str_find (zg-render exact) "docs/a.md:2:5" 0) 0)
                                        (and (str_eq (nth descriptor 1) "FormNativeZvecGrep")
                                             (eq (zgb-has-name? (nth descriptor 3) "zg-query-at") 1))))) 8192))))
            (let _cleanup (zgb-cleanup))
            score))
    (zvec-grep-band))
