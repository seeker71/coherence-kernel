; zvec-grep-band.fk — Form-native zg over resident Form values.
;
; Verdict 16383 when exact search, BM25, semantic recall, RRF fusion,
; source coordinates, bounded results, malformed-row exclusion, native tool
; planning, and zero-membrane execution all hold over an in-memory corpus.
;
; PROOF LEVEL: FOURTH-ARM ONLY — math_log probes mask 8 (fkwu) on
; 2026-09-03. The corpus and every retrieval operation remain Form values.
;
; preludes: form-stdlib/core.fk form-stdlib/tool-channel.fk form-stdlib/bml/zvec-grep.bml

(do
    (defn zgb-bit (ok bit) (if ok bit 0))
    (defn zgb-has-name? (names wanted)
        (if (nil? names) 0
            (if (str_eq (head names) wanted) 1
                (zgb-has-name? (tail names) wanted))))
    (defn zgb-docs ()
        (list
            (zg-memory-doc "@31.2.0.1" "cell/a" "heading\nThe kernel lives here. Deploy proof deploy evidence.\n")
            (zg-memory-doc "@31.2.0.2" "cell/b" "A deployment guide with unrelated filler.\n")
            (zg-memory-doc "@31.2.0.3" "cell/c" "quantum banana xylophone aardvark\n")
            (list "malformed")))
    (defn zvec-grep-band ()
        (do
            (let docs (zgb-docs))
            (let exact (zg-query-memory docs (ZgRouteRg) "kernel lives" 7))
            (let exact-hit (head (zg-hits exact)))
            (let fts (zg-query-memory docs (ZgRouteFts) "deploy evidence" 7))
            (let fts-hit (head (zg-hits fts)))
            (let vector (zg-query-memory docs (ZgRouteVector) "deploy proof" 7))
            (let vector-hit (head (zg-hits vector)))
            (let hybrid (zg-query-memory docs (ZgRouteHybrid) "deploy evidence" 7))
            (let hybrid-hit (head (zg-hits hybrid)))
            (let limited (zg-query-memory docs (ZgRouteRg) "deploy" 1))
            (let miss (zg-query-memory docs (ZgRouteRg) "inside git only phrase" 7))
            (let invalid (zg-query-memory docs "ambient" "deploy" 7))
            (let exact-scan (zg-scan-memory docs (ZgRouteRg) "deploy" (zg-unique-words "deploy")))
            (let plan (tc-plan-tool "zg" "cap.kernel.call"))
            (let descriptor (FormNativeZvecGrep))
            (sum (list
                (zgb-bit (and (str_eq (zg-status exact) (ZgStatusHit))
                              (str_eq (zg-hit-node exact-hit) "@31.2.0.1")) 1)
                (zgb-bit (and (eq (zg-hit-line exact-hit) 2)
                              (eq (zg-hit-column exact-hit) 5)) 2)
                (zgb-bit (str_eq (zg-hit-node fts-hit) "@31.2.0.1") 4)
                (zgb-bit (and (gt (zg-hit-score fts-hit) 0)
                              (str_eq (zg-hit-matched-by fts-hit) (ZgRouteFts))) 8)
                (zgb-bit (and (str_eq (zg-hit-node vector-hit) "@31.2.0.1")
                              (str_eq (zg-hit-matched-by vector-hit) (ZgRouteVector))) 16)
                (zgb-bit (and (str_eq (zg-hit-matched-by hybrid-hit) (ZgMatchedBoth))
                              (and (gt (zg-hit-fts-rank hybrid-hit) 0)
                                   (gt (zg-hit-vector-rank hybrid-hit) 0))) 32)
                (zgb-bit (and (gt (zg-hit-score hybrid-hit) 0)
                              (str_eq (zg-hit-status hybrid-hit) (ZgResident))) 64)
                (zgb-bit (eq (len (zg-hits limited)) 1) 128)
                (zgb-bit (and (str_eq (zg-status miss) (ZgStatusMiss))
                              (and (eq (zg-offered-count exact) 4)
                                   (and (eq (zg-admitted-count exact) 3)
                                        (eq (zg-skipped-count exact) 1)))) 256)
                (zgb-bit (and (str_eq (zg-status invalid) (ZgStatusNothing))
                              (str_eq (zg-reason invalid) "invalid-route")) 512)
                (zgb-bit (and (str_eq (tc-plan-status plan) "tool/plan")
                              (and (str_eq (tc-plan-protocol plan) "kernel:call")
                              (and (str_eq (tc-plan-op plan) "zvec-grep")
                                   (eq (tc-native-option? "zg") 1)))) 1024)
                (zgb-bit (and (eq (zg-local-model-runs hybrid) 0)
                              (and (eq (zg-membrane-crossings hybrid) 0)
                                   (and (eq (zg-scan-total-words exact-scan) 0)
                                        (eq (zg-doc-vector-score (head (zg-scan-docs exact-scan))) 0)))) 2048)
                (zgb-bit (and (str_eq (ZgUpstream) "https://github.com/zvec-ai/zvec-grep")
                              (and (str_eq (ZgUpstreamCommit) "81a80f478f2d3ec76556cd3c993d0d064cc9580a")
                                   (eq (ZgRrfK) 60))) 4096)
                (zgb-bit (and (str_eq (zg-result-schema hybrid) (ZgSchema))
                              (and (le (len (zg-hits hybrid)) (ZgDefaultLimit))
                                   (and (ge (str_find (zg-render exact) "cell/a:2:5" 0) 0)
                                        (and (str_eq (nth descriptor 1) "FormNativeZvecGrep")
                                             (eq (zgb-has-name? (nth descriptor 3) "zg-query-memory") 1))))) 8192)))))
    (zvec-grep-band))
