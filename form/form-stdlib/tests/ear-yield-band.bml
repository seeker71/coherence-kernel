; Native case observations; the final reading is their conjunction.
; Verdict 1
; preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/bml/ear-yield.bml form-stdlib/line-grammar.fk
section [form.bml] {
 class PlanCaseWitness {
  def flpc-show(v) = nothing?(v) ? "nothing" : (String) value_kind(v)=="string" ? json-emit(json-node-string(v)) : (String) value_kind(v)=="list" ? "[" + foldl((t,x)=>(len(t)==0 ? "" : t+",")+flpc-show(x),"",v) + "]" : v.str();
  def flpc-bound(s) = len(s)>400 ? substring(s,0,400)+"..." : s;
  def flpc-failed(id,call,ran,actual,expected) = "[plan-case-failed] "+json-emit(json-node-array([json-node-int(id),json-node-string(call),json-node-string(ran ? flpc-bound(flpc-show(actual)) : "(the call raised and gave no value)"),json-node-string(flpc-bound(flpc-show(expected)))]));
 }
 let all=true;
 let counted=0;
 let result0=try [{
el-yield-why(0,0,1234,1);
}] catch [];
 let actual0=nil?(result0) ? nothing() : result0[0];
 let expected0="no-flag";
 let held0=len(result0)==1 && actual0==expected0;
 let observation0=["el-yield-why(0,0,1234,1)",value_kind(actual0),actual0,expected0,held0,len(result0)==1];
 fb_record(observation0,"native-plan-case",0);
 print(observation0);
 let all=all && held0;
 let counted=counted+(held0 ? 1 : 0);
 let said0=held0 ? 0 : print_str(flpc-failed(0,"el-yield-why(0,0,1234,1)",len(result0)==1,actual0,expected0));
 let result1=try [{
el-yield-why(1,0,1234,1);
}] catch [];
 let actual1=nil?(result1) ? nothing() : result1[0];
 let expected1="lease-free";
 let held1=len(result1)==1 && actual1==expected1;
 let observation1=["el-yield-why(1,0,1234,1)",value_kind(actual1),actual1,expected1,held1,len(result1)==1];
 fb_record(observation1,"native-plan-case",1);
 print(observation1);
 let all=all && held1;
 let counted=counted+(held1 ? 1 : 0);
 let said1=held1 ? 0 : print_str(flpc-failed(1,"el-yield-why(1,0,1234,1)",len(result1)==1,actual1,expected1));
 let result2=try [{
el-yield-why(1,5678,1234,0);
}] catch [];
 let actual2=nil?(result2) ? nothing() : result2[0];
 let expected2="lease-free";
 let held2=len(result2)==1 && actual2==expected2;
 let observation2=["el-yield-why(1,5678,1234,0)",value_kind(actual2),actual2,expected2,held2,len(result2)==1];
 fb_record(observation2,"native-plan-case",2);
 print(observation2);
 let all=all && held2;
 let counted=counted+(held2 ? 1 : 0);
 let said2=held2 ? 0 : print_str(flpc-failed(2,"el-yield-why(1,5678,1234,0)",len(result2)==1,actual2,expected2));
 let result3=try [{
el-yield-why(1,1234,1234,1);
}] catch [];
 let actual3=nil?(result3) ? nothing() : result3[0];
 let expected3="lease-mine";
 let held3=len(result3)==1 && actual3==expected3;
 let observation3=["el-yield-why(1,1234,1234,1)",value_kind(actual3),actual3,expected3,held3,len(result3)==1];
 fb_record(observation3,"native-plan-case",3);
 print(observation3);
 let all=all && held3;
 let counted=counted+(held3 ? 1 : 0);
 let said3=held3 ? 0 : print_str(flpc-failed(3,"el-yield-why(1,1234,1234,1)",len(result3)==1,actual3,expected3));
 let result4=try [{
el-yield-why(1,5678,1234,1);
}] catch [];
 let actual4=nil?(result4) ? nothing() : result4[0];
 let expected4="yielding";
 let held4=len(result4)==1 && actual4==expected4;
 let observation4=["el-yield-why(1,5678,1234,1)",value_kind(actual4),actual4,expected4,held4,len(result4)==1];
 fb_record(observation4,"native-plan-case",4);
 print(observation4);
 let all=all && held4;
 let counted=counted+(held4 ? 1 : 0);
 let said4=held4 ? 0 : print_str(flpc-failed(4,"el-yield-why(1,5678,1234,1)",len(result4)==1,actual4,expected4));
 let result5=try [{
el-yield-why(0,5678,1234,1);
}] catch [];
 let actual5=nil?(result5) ? nothing() : result5[0];
 let expected5="no-flag";
 let held5=len(result5)==1 && actual5==expected5;
 let observation5=["el-yield-why(0,5678,1234,1)",value_kind(actual5),actual5,expected5,held5,len(result5)==1];
 fb_record(observation5,"native-plan-case",5);
 print(observation5);
 let all=all && held5;
 let counted=counted+(held5 ? 1 : 0);
 let said5=held5 ? 0 : print_str(flpc-failed(5,"el-yield-why(0,5678,1234,1)",len(result5)==1,actual5,expected5));
 let result6=try [{
el-yield-why(1,0,0,0);
}] catch [];
 let actual6=nil?(result6) ? nothing() : result6[0];
 let expected6="lease-free";
 let held6=len(result6)==1 && actual6==expected6;
 let observation6=["el-yield-why(1,0,0,0)",value_kind(actual6),actual6,expected6,held6,len(result6)==1];
 fb_record(observation6,"native-plan-case",6);
 print(observation6);
 let all=all && held6;
 let counted=counted+(held6 ? 1 : 0);
 let said6=held6 ? 0 : print_str(flpc-failed(6,"el-yield-why(1,0,0,0)",len(result6)==1,actual6,expected6));
 let result7=try [{
el-yield-why(1,999,999,1);
}] catch [];
 let actual7=nil?(result7) ? nothing() : result7[0];
 let expected7="lease-mine";
 let held7=len(result7)==1 && actual7==expected7;
 let observation7=["el-yield-why(1,999,999,1)",value_kind(actual7),actual7,expected7,held7,len(result7)==1];
 fb_record(observation7,"native-plan-case",7);
 print(observation7);
 let all=all && held7;
 let counted=counted+(held7 ? 1 : 0);
 let said7=held7 ? 0 : print_str(flpc-failed(7,"el-yield-why(1,999,999,1)",len(result7)==1,actual7,expected7));
 print_str("[plan-cases] held="+counted.str()+" total=8");
 all ? 1 : 0;
}
