; form-glass-deadline-cadence-band.fk — complete-frame deadline and truth proof.
;
; Verdict 4095:
;   1    active and quiet budgets are 250ms and 500ms
;   2    active wait subtracts 60ms of observation work
;   4    quiet wait subtracts 60ms of observation work
;   8    target overrun waits zero rather than another full interval
;   16   a backwards clock cannot create an oversized wait
;   32   subsecond sleep commands retain three millisecond digits
;   64   commands also represent a seconds component
;   128  first-frame timing is omitted rather than painted as unavailable wallpaper
;   256  completed-frame zero wait remains a measured value
;   512  work, wait, budget, and cycle remain distinct physical rows
;   1024 cadence rows lead the metric stream so constrained Atlas frames retain them
;   2048 acknowledgement time cannot precede its correlated offer
;
; preludes: form-stdlib/form-glass-live.bml
; witnessed: 2026-09-02 -> 4095

(do
    (defn fgdb-bit (held weight) (if (eq held 1) weight 0))
    (let first (fgl-cadence-rows 0 -1 -1 -1))
    (let completed (fgl-cadence-rows 1 260 0 250))
    (let waitRow (nth completed 1))
    (let ordered (fgl-frame-fast-rows 1 260 0 250 (list "changing-observer-row")))
    (sum (list
        (fgdb-bit (and (eq (fgl-frame-budget-ms 4) 250)
                        (eq (fgl-frame-budget-ms 2) 500)) 1)
        (fgdb-bit (eq (fgl-frame-wait-ms 4 1000 1060) 190) 2)
        (fgdb-bit (eq (fgl-frame-wait-ms 2 1000 1060) 440) 4)
        (fgdb-bit (eq (fgl-frame-wait-ms 4 1000 1260) 0) 8)
        (fgdb-bit (eq (fgl-frame-wait-ms 4 1000 999) 250) 16)
        (fgdb-bit (str_eq (fgl-sleep-ms-command 7) "/bin/sleep 0.007") 32)
        (fgdb-bit (str_eq (fgl-sleep-ms-command 1005) "/bin/sleep 1.005") 64)
        (fgdb-bit (eq (len first) 0) 128)
        (fgdb-bit (and (eq (fgo-present? waitRow) 1)
                        (and (eq (fgo-int-value waitRow) 0)
                             (str_eq (fgo-evidence waitRow) "physical-live"))) 256)
        (fgdb-bit (and (eq (len completed) 4)
                        (and (str_eq (fgo-id (nth completed 0)) "frame-work-ms")
                         (and (str_eq (fgo-id (nth completed 1)) "frame-wait-ms")
                          (and (str_eq (fgo-id (nth completed 2)) "frame-budget-ms")
                               (and (str_eq (fgo-id (nth completed 3)) "frame-cycle-ms")
                                    (eq (fgo-int-value (nth completed 3)) 260)))))) 512)
        (fgdb-bit (and (str_eq (fgo-id (head ordered)) "frame-work-ms")
                        (str_eq (nth ordered 4) "changing-observer-row")) 1024)
        (fgdb-bit (and (eq (fgl-control-ack-epoch 101 100) 101)
                        (eq (fgl-control-ack-epoch 101 102) 102)) 2048))))
