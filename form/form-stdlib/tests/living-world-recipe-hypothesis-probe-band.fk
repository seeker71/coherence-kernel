; living-world-recipe-hypothesis-probe-band.fk -- reality differentiates.
; Verdict 32767 proves fifteen held-out, uncertainty, and revocation claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk

(do
    (let field-fixture (lwphw-integrated-field))
    (let field-candidate (lwphw-field-candidate field-fixture))
    (let field-world (lwt-round-world (lwphw-field-round field-fixture)))
    (let open-fixture (lwphw-open-placement field-fixture))
    (let open (lwphw-probe-placement open-fixture))
    (let open-world (lwt-round-world (lwphw-probe-round open-fixture)))
    (let observed-fixture (lwphw-observed-placement field-fixture))
    (let observed (lwphw-probe-placement observed-fixture))
    (let observed-candidate (lwphw-probe-candidate observed-fixture))
    (let observed-world
        (lwt-round-world (lwphw-probe-round observed-fixture)))
    (let wrong-world (lwphw-wrong-probe-world field-fixture))
    (let wrong-probe (lwphw-wrong-probe field-candidate))
    (let wrong (lwph-placement-for wrong-world wrong-probe 2))
    (let alternative-world
        (lwphw-alternative-probe-world field-fixture))
    (let alternative-probe (lwphw-alternative-probe field-candidate))
    (let alternative
        (lwph-placement-for alternative-world alternative-probe 2))
    (let revoked (lwphw-revoked-observed-world field-fixture))

    (let c1
        (if (and (eq (lwph-probe-current?
                         (lwphw-open-probe-world field-fixture)
                         (lwphw-open-probe field-candidate) 2) 1)
                 (eq (lwph-branch?
                         (lwph-placement-status open)) 1)) 1 0))
    (let c2
        (if (and (eq (lwo-field-size
                         (lwph-placement-evaluations open)) 4)
                 (and (eq (lwo-field-size
                              (lwph-placement-outputs open)) 2)
                      (node_eq (lwph-placement-predicted open)
                               (lwo-none)))) 2 0))
    (let c3
        (if (and (eq (lwo-field-has?
                         (lwph-placement-outputs open)
                         (intern_trivial_int 7)) 1)
                 (eq (lwo-field-has?
                         (lwph-placement-outputs open)
                         (intern_trivial_int 12)) 1)) 4 0))
    (let c4
        (if (and (eq (lwo-field-size
                         (lwph-placement-confirmed open)) 0)
                 (and (eq (lwo-field-size
                              (lwph-placement-diverged open)) 0)
                      (eq (lwo-field-size
                              (lwph-placement-unresolved open)) 0))) 8 0))
    (let c5
        (if (and (gt (lwo-field-size
                         (lwph-placement-unknowns open)) 0)
                 (and (eq (lwo-field-has?
                              (lwph-placement-alternatives open)
                              (lwphw-alternative)) 1)
                      (gt (lwo-field-size
                              (lwph-placement-alternatives open)) 4))) 16 0))
    (let c6
        (if (and (eq (lwph-discriminated?
                         (lwph-placement-status observed)) 1)
                 (and (eq (lwo-field-size
                              (lwph-placement-confirmed observed)) 2)
                      (eq (lwo-field-size
                              (lwph-placement-diverged observed)) 2))) 32 0))
    (let c7
        (if (and (eq (lwo-field-size
                         (lwph-placement-outputs observed)) 2)
                 (and (node_eq (lwph-placement-predicted observed)
                               (lwo-none))
                      (not (node_eq open observed)))) 64 0))
    (let c8
        (if (and (eq (lwph-contradicted?
                         (lwph-placement-status wrong)) 1)
                 (and (eq (lwo-field-size
                              (lwph-placement-confirmed wrong)) 0)
                      (eq (lwo-field-size
                              (lwph-placement-diverged wrong)) 4))) 128 0))
    (let c9
        (if (and (eq (lwph-open?
                         (lwph-placement-status alternative)) 1)
                 (eq (lwo-field-size
                         (lwph-placement-unresolved alternative)) 4)) 256 0))
    (let c10
        (if (and (eq (lwph-probe-integrated-current?
                         open-world (lwphw-probe-candidate open-fixture)) 1)
                 (eq (lwph-probe-integrated-current?
                         observed-world observed-candidate) 1)) 512 0))
    (let c11
        (if (and (eq (lwo-field-size
                         (lwt-proposal-participants
                            (lwphw-probe-proposal open-fixture))) 12)
                 (and (eq (lwo-field-size
                              (lwt-proposal-participants
                                (lwphw-probe-proposal observed-fixture))) 14)
                      (and (eq (lwo-field-size
                                  (lwph-placement-witnesses open)) 52)
                           (eq (lwo-field-size
                                  (lwph-placement-witnesses observed)) 52))))
            1024 0))
    (let c12
        (if (and (eq (lwo-active? open-world
                         (intern_trivial_int 3)) 0)
                 (and (eq (lwo-active? open-world
                              (intern_trivial_int 4)) 0)
                      (eq (lwre-bindings-current? open-world
                              (lwphw-probe-bindings)) 1))) 2048 0))
    (let c13
        (if (and (node_eq
                    (lwph-probe-proposal revoked
                        (lwphw-observed-probe field-candidate) 2)
                    (lwo-none))
                 (eq (lwph-probe-integrated-current?
                         revoked observed-candidate) 0)) 4096 0))
    (let c14
        (if (and (eq (lwph-integrated-current?
                         revoked field-candidate) 1)
                 (and (eq (lwo-active? revoked observed-candidate) 1)
                      (eq (lwo-active? observed-world observed-candidate) 1)))
            8192 0))
    (let c15
        (if (and (eq (lwo-field-size
                         (lwph-field-consistent
                            (lwo-emergent-shape field-candidate))) 4)
                 (and (eq (lwo-field-size
                              (lwph-field-refuted
                                (lwo-emergent-shape field-candidate))) 2)
                      (not (node_eq
                              (lwphw-open-probe field-candidate)
                              (lwphw-observed-probe field-candidate)))))
            16384 0))
    (add c1 (add c2 (add c3 (add c4 (add c5
      (add c6 (add c7 (add c8 (add c9 (add c10
        (add c11 (add c12 (add c13 (add c14 c15)))))))))))))))
