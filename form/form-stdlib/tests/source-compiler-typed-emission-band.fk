; source-compiler-typed-emission-band.fk -- scannerless source reaches a
; typed Program Image before its one executor projection.
;
; preludes: form-stdlib/core.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/defdata.fk form-stdlib/form-definition-language.fk form-stdlib/source-compiler-emission.fk form-stdlib/bml/program-image-typed-emission.bml form-stdlib/bml/source-compiler-typed-emission.bml
;
; Expected: 16383

(do
    (defn scteb-score (ok bit) (if ok bit 0))
    (defn scteb-has? (text needle) (ge (str_find text needle 0) 0))
    (defn scteb-surface ()
        "module calc { data rows = [40,2]; fn answer() = add(40,2); }")
    (defn scteb-lowered ()
        "(let rows (list 40 2))\n(defn answer () (add 40 2))")
    (defn scteb-bad-surface () (str_concat (scteb-surface) " trailing"))
    (defn scteb-source-descriptor () (sad-source "src/calc.fdl" "sha:calc-fdl" 100))
    (defn scteb-output () (sac-compile-output 0 0))
    (defn scteb-table ()
        (pitte-table
            (pitte-roots (list 0))
            (pitte-rows (list (pitte-row 1 42 0 0)))
            (pitte-strings (empty))))
    (defn scteb-image ()
        (pitte-envelope "src/calc.fdl" "sha:calc-fdl" 100
                        "src/calc.fkb" "sha:calc-fkb" 101
                        1 (scteb-table)))
    (defn scteb-bad-image ()
        (pitte-envelope "src/calc.fdl" "sha:calc-fdl" 100
                        "src/calc.fkb" "sha:calc-fkb" 101
                        0 (scteb-table)))
    (defn scteb-compile-selection ()
        (ras-selection-from-plan
            (rap-plan-from-descriptors
                (scteb-source-descriptor)
                (sad-no-artifact)
                (sad-no-artifact))))
    (defn scteb-compile-envelope ()
        (rale-envelope-from-selection
            (scteb-source-descriptor)
            (sad-no-artifact)
            (sad-no-artifact)
            (scteb-compile-selection)))
    (defn scteb-ready ()
        (scte-from-form-definition-source
            (scteb-surface)
            (scteb-compile-envelope)
            (scteb-output)
            (scteb-image)
            (sce-no-dylib)))
    (defn scteb-bad-image-row ()
        (scte-from-form-definition-source
            (scteb-surface)
            (scteb-compile-envelope)
            (scteb-output)
            (scteb-bad-image)
            (sce-no-dylib)))
    (defn scteb-bad-parse-row ()
        (scte-from-form-definition-source
            (scteb-bad-surface)
            (scteb-compile-envelope)
            (scteb-output)
            (scteb-image)
            (sce-no-dylib)))
    (defn scteb-source ()
        (read_file "form/form-stdlib/bml/source-compiler-typed-emission.bml"))

    (defn source-compiler-typed-emission-band ()
        (do
            (let ready (scteb-ready))
            (let lowering (scte-row-lowering ready))
            (let emission (scte-row-emission ready))
            (let bad-image (scteb-bad-image-row))
            (let bad-parse (scteb-bad-parse-row))
            (sum (list
                (scteb-score (str_eq (scte-version) "source-compiler-typed-emission-v1") 1)
                (scteb-score (scte-row? ready) 2)
                (scteb-score (scte-ready? ready) 4)
                (scteb-score (str_eq (fdl-lowering-name lowering) "calc") 8)
                (scteb-score (str_eq (fdl-lowering-source lowering) (scteb-lowered)) 16)
                (scteb-score (sce-emitted? emission) 32)
                (scteb-score (pif-envelope-valid? (scte-row-raw-pif ready)) 64)
                (scteb-score (str_eq (scte-row-table-text ready) (pitte-envelope-table-text (scteb-image))) 128)
                (scteb-score (str_eq (sad-artifact-path (sce-emission-fkb-descriptor emission)) "src/calc.fkb") 256)
                (scteb-score
                    (and (scte-refused? bad-image)
                         (and (str_eq (scte-row-reason bad-image) "typed-program-image-rejected")
                              (and (nothing? (scte-row-raw-pif bad-image))
                                   (and (nothing? (scte-row-table-text bad-image))
                                        (nothing? (scte-row-emission bad-image))))))
                    512)
                (scteb-score
                    (and (scte-refused? bad-parse)
                         (and (str_eq (scte-row-reason bad-parse) "form-definition-parse-failed")
                              (nothing? (scte-row-emission bad-parse))))
                    1024)
                (scteb-score
                    (and (nothing? (scte-row-raw-pif bad-image))
                         (not (eq (scte-row-raw-pif bad-image) 0)))
                    2048)
                (scteb-score (not (scteb-has? (scteb-source) "value_kind")) 4096)
                (scteb-score
                    (and (scteb-has? (scteb-source) "section [form.bml]")
                         (scteb-has? (scteb-source) "pitte-envelope-valid?"))
                    8192)))))

    (source-compiler-typed-emission-band))
