; Executed caller checks govern learned proposals; isolated paused journal keeps bands out of living state.
; preludes: form-stdlib/bml/form-cli-code-request.bml
(do
 (let home (str_concat "/tmp/session-code-band-" (nsm-id)))
 (nsm-pause home 1)
 (let docs (list (list "config" "config.json" "{\"enabled\":false}") (list "keep" "keep.txt" "untouched")))
 (let good (list (list "config" "config.json" "{\"enabled\":true}") (list "keep" "keep.txt" "untouched")))
 (let bad (list (list "config" "config.json" "{\"enabled\":true}") (list "keep" "keep.txt" "changed")))
 (let initial (fcap-open "Enable the option." docs (list "config.json")))
 (let checks (json-array-elements (parse-json "check" "[{\"tool\":\"jq\",\"arguments\":[\".enabled\",\"config.json\"],\"stdout\":\"true\\n\"}]")))
 (let checker (list fcaq-check checks))
 (let state (fcam-prepare home initial (json-emit (json-node-array checks)) "" checker))
 (let response (json-emit (json-node-object (list (json-node-pair "documents" (fat-wire-documents-node good))))))
 (let generated (nsc-generated home state checker (json-node-object (list (nsm-s "text" response) (nsm-s "reason" "") (nsm-n "generated_tokens" 11)))))
 (let next (head generated))
 (let result (nsc-finish generated))
 (let resumed (fcam-prepare home initial (json-emit (json-node-array checks)) (fcam-id next) checker))
 (let offered (nsc-observe home result checker 0))
 (let record (nsm-json (nsm-at (head offered) "record.json")))
 (let excluded (nsc-observe home result checker 1))
 (let assertions (list (nsc-valid state good checker) (not (nsc-valid state bad checker)) (not (nsc-valid state docs checker))
  (str_eq (fcap-stage next) "complete") (str_eq (nsm-str record "outcome") "verified-answer")
  (str_eq (nsm-str (json-object-get record "example") "completion") response)
  (str_eq (nth offered 1) "paused") (eq (nsm-num (nsm-json (nsm-at (head excluded) "record.json")) "evaluation") 1)
  (and (str_eq (fcap-stage resumed) "complete") (value_eq (fcap-docs resumed) good))))
 (print assertions) (fs-remove-tree home)
 (if (value_eq assertions (list 1 1 1 1 1 1 1 1 1)) 511 (form_error "learned code integration failed")))
