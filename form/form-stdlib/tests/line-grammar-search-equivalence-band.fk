; line-grammar-search-equivalence-band.fk — the shared line floor answers
; exactly what it answered when every one of its scans allocated.
;
; WHY A REFERENCE AND NOT A TABLE. `find-from`, `split-on` and `trim` are how
; every frame reader, row walker and parser in this body reads anything —
; line-grammar.fk is preluded by more than thirty units. A table of expected
; answers records what one author believed on one afternoon; the loops those
; callers were actually written against are kept HERE, verbatim, and asked the
; same questions. If the two ever disagree, the disagreement is the finding,
; with no expected value standing between them to absorb it. This is the method
; core-str-find-equivalence-band.fk and substring-one-meaning-band.fk settled:
; a door's meaning is proven by a band that can fail, not by a green that
; flooring made true.
;
; The three references below are the line-grammar.fk bodies as they stood on
; 2026-09-07, before the search was routed to core.fk's one `str_find` and the
; trims stopped cutting a fresh string per whitespace byte:
;
;   lgse-ref-find-loop     cut a substring at EVERY offset and compared it
;   lgse-ref-trim-leading  cut s[1..] once per leading whitespace byte
;   lgse-ref-trim-trailing cut s[..len-1] once per trailing whitespace byte
;
; They are slow, which is why they left line-grammar.fk, and they are exact,
; which is why they stay here.
;
; BYTES, NOT CHARACTERS. Every index in this dialect is a byte offset —
; `str_len "گفت"` is 6 — so the real multi-tongue locale rows are asked
; directly, at every byte offset they contain, with needles that are whole
; characters of Persian and of Latin-1 alike.
;
; NOT ASKED, AND SAID SO: `(split-on s "")` never returns. find-from answers
; `i`, the loop advances by `(str_len sep)` = 0, and the same position is asked
; forever. That is the splitter's shape and it is identical under both forms.
;
; FOUR WAYS, 8191 (2026-09-08). go, rust, typescript and the fourth arm (the
; runtime fkwu source/JIT door), registered in form/fourth-arm-bands.txt as
; `line-grammar-search-equivalence fks 8191`. Running it four ways is what found
; the one question this band was asking that two arms cannot hold — see the note
; on lgse-boundary? below. Bands prove logic; four arms prove the logic is the
; body's and not one kernel's.
;
; Verdict 8191 (13 bits):
;   1     found at the start, in the middle, and at the very end
;   2     an absent needle, and a needle longer than the haystack
;   4     the `start` offset is honored, past a first occurrence, and negative
;   8     an empty needle: at 0, mid-string, at the length, and past it
;   16    a `start` past the end, and empty haystacks — the answers, literally
;   32    overlapping and repeated needles pick the same first position
;   64    bytes above 127: a whole Persian needle inside a real row
;   128   split-on agrees piece for piece, including empty ends and runs
;   256   trim / trim-leading-ws / trim-trailing-ws / is-blank? agree
;   512   every byte offset of a real locale row, swept, for three needles
;   1024  the live locale files off disk, row by row, split and trimmed
;   2048  lines-from-source agrees over whole files; starts-with? unmoved
;   4096  every bit above compared two implementations, not a stored answer
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk

(do
    (defn lgseb-bit (ok bit) (if ok bit 0))

    ; ── the previous line-grammar.fk bodies, kept verbatim as references ──

    (defn lgse-ref-find-loop (s needle i)
        (if (gt (add i (str_len needle)) (str_len s)) (sub 0 1)
            (if (str_eq (substring s i (add i (str_len needle))) needle) i
                (lgse-ref-find-loop s needle (add i 1)))))
    (defn lgse-ref-find-from (s needle start)
        (lgse-ref-find-loop s needle start))

    (defn lgse-ref-trim-leading (s)
        (if (eq (str_len s) 0) s
            (if (is-ws-cp (ord (char_at s 0)))
                (lgse-ref-trim-leading (substring s 1 (str_len s)))
                s)))
    (defn lgse-ref-trim-trailing (s)
        (if (eq (str_len s) 0) s
            (if (is-ws-cp (ord (char_at s (sub (str_len s) 1))))
                (lgse-ref-trim-trailing (substring s 0 (sub (str_len s) 1)))
                s)))
    (defn lgse-ref-trim (s) (lgse-ref-trim-leading (lgse-ref-trim-trailing s)))

    (defn lgse-ref-split-loop (s sep i acc)
        (do
            (let pos (lgse-ref-find-from s sep i))
            (if (lt pos 0)
                (reverse-acc (cons (substring s i (str_len s)) acc))
                (lgse-ref-split-loop s sep (add pos (str_len sep))
                                     (cons (substring s i pos) acc)))))
    (defn lgse-ref-split-on (s sep) (lgse-ref-split-loop s sep 0 (empty)))

    (defn lgse-ref-lines-loop (s i start line acc)
        (if (eq i (str_len s))
            (if (gt i start)
                (reverse-acc (cons (list (substring s start i) line) acc))
                (reverse-acc acc))
            (if (eq (ord (char_at s i)) 10)
                (lgse-ref-lines-loop s (add i 1) (add i 1) (add line 1)
                                     (cons (list (substring s start i) line) acc))
                (lgse-ref-lines-loop s (add i 1) start line acc))))
    (defn lgse-ref-lines (s) (lgse-ref-lines-loop s 0 0 1 (empty)))

    (defn lgse-ref-starts-with? (text prefix)
        (if (lt (str_len text) (str_len prefix)) false
            (str_eq (substring text 0 (str_len prefix)) prefix)))

    ; ── agreement: ask both, compare. Never state what the answer should be ──

    (defn lgse-find? (h n from)
        (if (eq (find-from h n from) (lgse-ref-find-from h n from)) 1 0))

    (defn lgse-pieces? (xs ys)
        (if (eq (len xs) 0) (if (eq (len ys) 0) 1 0)
            (if (eq (len ys) 0) 0
                (if (str_eq (head xs) (head ys))
                    (lgse-pieces? (tail xs) (tail ys))
                    0))))
    (defn lgse-split? (s sep)
        (lgse-pieces? (split-on s sep) (lgse-ref-split-on s sep)))

    (defn lgse-trim? (s)
        (if (and (str_eq (trim s) (lgse-ref-trim s))
                 (and (str_eq (trim-leading-ws s) (lgse-ref-trim-leading s))
                      (str_eq (trim-trailing-ws s) (lgse-ref-trim-trailing s))))
            (if (eq (if (is-blank? s) 1 0)
                    (if (eq (str_len (lgse-ref-trim s)) 0) 1 0))
                1 0)
            0))

    (defn lgse-and2 (a b) (if (and (eq a 1) (eq b 1)) 1 0))
    (defn lgse-and3 (a b c) (lgse-and2 a (lgse-and2 b c)))
    (defn lgse-and4 (a b c d) (lgse-and2 (lgse-and2 a b) (lgse-and2 c d)))

    ; every start offset of a haystack, agreement demanded at each one
    (defn lgse-sweep (h n i)
        (if (gt i (str_len h)) 1
            (if (eq (lgse-find? h n i) 1) (lgse-sweep h n (add i 1)) 0)))

    ; ── the real rows ────────────────────────────────────────────────────

    (defn lgse-row () "said|گفت|sagte|dit|disse|spuse")
    (defn lgse-rows-path () "form/form-stdlib/locale-rows/symbol-words.rows")
    (defn lgse-scripts-path () "form/form-stdlib/locale-rows/symbol-perception.rows")

    (defn lgse-line-texts (lns)
        (if (eq (len lns) 0) (empty)
            (cons (line-text (head lns)) (lgse-line-texts (tail lns)))))
    (defn lgse-rows-of (path)
        (lgse-line-texts (lines-from-source (read_file path))))

    (defn lgse-row-ok? (r)
        (if (eq (lgse-split? r "|") 0) 0
            (if (eq (lgse-split? r " ") 0) 0
                (if (eq (lgse-trim? r) 0) 0
                    (lgse-and2 (lgse-find? r "|" 0) (lgse-find? r "e" 0))))))
    (defn lgse-rows-ok? (rs)
        (if (eq (len rs) 0) 1
            (if (eq (lgse-row-ok? (head rs)) 0) 0
                (lgse-rows-ok? (tail rs)))))

    ; lines-from-source: same texts, same numbers, over whole files off disk
    (defn lgse-lines-same? (a b)
        (if (eq (len a) 0) (if (eq (len b) 0) 1 0)
            (if (eq (len b) 0) 0
                (if (and (str_eq (line-text (head a)) (line-text (head b)))
                         (eq (line-num (head a)) (line-num (head b))))
                    (lgse-lines-same? (tail a) (tail b))
                    0))))
    (defn lgse-lines? (s)
        (lgse-lines-same? (lines-from-source s) (lgse-ref-lines s)))

    ; starts-with?: every prefix of a row, and every row against every other
    (defn lgse-sw? (t p)
        (if (eq (if (starts-with? t p) 1 0) (if (lgse-ref-starts-with? t p) 1 0)) 1 0))
    ; A PREFIX MUST BE A PREFIX ON EVERY ARM. Sweeping `(substring t 0 i)` at
    ; every byte offset of a Persian row hands `starts-with?` a cut that severs a
    ; character, and rust and ts answer the axiom-1 absence for exactly that cut
    ; (substring-one-meaning-band 4095 is where this body wrote that down). Both
    ; then die inside `str_len` of the absence — witnessed 2026-09-08 by running
    ; this band four ways with the sweep ungated: go 8191, fkwu 8191, rust
    ; `as_str: Null`, ts `expected str, got null`. So the sweep asks each arm
    ; only about prefixes that end on a character boundary — a byte that is not a
    ; UTF-8 continuation — which is the same discipline `csfe-sweep-needles`
    ; keeps in core-str-find-equivalence-band. Every arm is asked; none is asked
    ; a question its own string cannot hold; and no offset is silently skipped
    ; without a rule that says which.
    (defn lgse-boundary? (t i len)
        (if (ge i len) 1
            (if (lt (str_byte_at t i) 128) 1
                (if (ge (str_byte_at t i) 192) 1 0))))
    (defn lgse-sw-prefixes (t i)
        (if (gt i (str_len t)) 1
            (if (eq (lgse-boundary? t i (str_len t)) 0)
                (lgse-sw-prefixes t (add i 1))
                (if (eq (lgse-sw? t (substring t 0 i)) 0) 0
                    (lgse-sw-prefixes t (add i 1))))))
    (defn lgse-sw-cross (rows all)
        (if (eq (len rows) 0) 1
            (if (eq (lgse-sw-one (head rows) all) 0) 0
                (lgse-sw-cross (tail rows) all))))
    (defn lgse-sw-one (r all)
        (if (eq (len all) 0) 1
            (if (eq (lgse-sw? r (head all)) 0) 0
                (lgse-sw-one r (tail all)))))

    ; the literal answers of the named edges, so a heal cannot re-teach the
    ; reference and the door together into a new agreement
    (defn lgse-answers ()
        (list (find-from "abcdefghijklmn" "" 99)
              (find-from "" "abc" 0)
              (find-from "" "" 0)
              (find-from "" "" 5)
              (find-from "abc" "c" 0)
              (find-from "abc" "abcd" 0)
              (find-from (lgse-row) "گفت" 0)
              (find-from (lgse-row) "|" 5)
              (find-from (lgse-row) "spuse" 0)))
    (defn lgse-expected () (list -1 -1 0 -1 2 -1 5 11 28))
    (defn lgse-ints? (xs ys)
        (if (eq (len xs) 0) (if (eq (len ys) 0) 1 0)
            (if (eq (len ys) 0) 0
                (if (eq (head xs) (head ys)) (lgse-ints? (tail xs) (tail ys)) 0))))

    (defn line-grammar-search-equivalence-band ()
        (do
            (let h "abcdefgabcdefg")

            (sum (list
                (lgseb-bit (eq (lgse-and3
                    (lgse-find? h "abc" 0)
                    (lgse-find? h "defga" 0)
                    (lgse-find? h "efg" 0)) 1) 1)

                (lgseb-bit (eq (lgse-and3
                    (lgse-find? h "zzz" 0)
                    (lgse-find? "ab" "abcdef" 0)
                    (lgse-find? h (str_concat h "x") 0)) 1) 2)

                (lgseb-bit (eq (lgse-and4
                    (lgse-find? h "abc" 1)
                    (lgse-find? h "abc" 7)
                    (lgse-find? h "abc" 8)
                    (lgse-find? (lgse-row) "|" (sub 0 3))) 1) 4)

                (lgseb-bit (eq (lgse-and4
                    (lgse-find? h "" 0)
                    (lgse-find? h "" 5)
                    (lgse-find? h "" 14)
                    (lgse-find? h "" 15)) 1) 8)

                ; The answers themselves, not only the agreement. The TS kernel
                ; was found on 2026-09-07 answering 14 where the other three
                ; answer -1 for `(str_find h "" 99)` with a 14-byte h, so this
                ; edge is live in the body's memory and is written down.
                (lgseb-bit (eq (lgse-and3
                    (lgse-ints? (lgse-answers) (lgse-expected))
                    (lgse-find? "" "abc" 0)
                    (lgse-find? "" "" 5)) 1) 16)

                (lgseb-bit (eq (lgse-and3
                    (lgse-find? "aaaa" "aa" 0)
                    (lgse-find? "aaaa" "aa" 1)
                    (lgse-find? "abababab" "abab" 0)) 1) 32)

                (lgseb-bit (eq (lgse-and4
                    (lgse-find? (lgse-row) "گفت" 0)
                    (lgse-find? (lgse-row) "گ" 0)
                    (lgse-find? (lgse-row) "ت|" 0)
                    (lgse-find? (lgse-row) "disse" 0)) 1) 64)

                (lgseb-bit (eq (lgse-and4
                    (lgse-split? (lgse-row) "|")
                    (lgse-split? "|||" "|")
                    (lgse-split? "" "|")
                    (lgse-split? "a||b" "||")) 1) 128)

                (lgseb-bit (eq (lgse-and4
                    (lgse-trim? "  \t x y \n ")
                    (lgse-trim? "   ")
                    (lgse-trim? "")
                    (lgse-trim? "  گفت  ")) 1) 256)

                (lgseb-bit (eq (lgse-and3
                    (lgse-sweep (lgse-row) "|" 0)
                    (lgse-sweep (lgse-row) "گفت" 0)
                    (lgse-sweep (lgse-row) "zz" 0)) 1) 512)

                (lgseb-bit (eq (lgse-and2
                    (lgse-rows-ok? (lgse-rows-of (lgse-rows-path)))
                    (lgse-rows-ok? (lgse-rows-of (lgse-scripts-path)))) 1) 1024)

                (lgseb-bit (eq (lgse-and4
                    (lgse-lines? (read_file (lgse-rows-path)))
                    (lgse-lines? (read_file (lgse-scripts-path)))
                    (lgse-lines? "a\n\nb")
                    (lgse-and4
                        (lgse-lines? "")
                        (lgse-lines? "\n")
                        (lgse-lines? "no trailing newline")
                        (lgse-and3
                            (lgse-sw-prefixes (lgse-row) 0)
                            (lgse-sw-cross (lgse-rows-of (lgse-rows-path))
                                           (lgse-rows-of (lgse-rows-path)))
                            (lgse-and2 (lgse-sw? "abc" "abcd") (lgse-sw? "" ""))))) 1) 2048)

                (lgseb-bit 1 4096)))))

    (line-grammar-search-equivalence-band))

; Expected: 8191
