; form-query-memory-cell-rotation-band.fk -- on-demand data-cell adversaries.
;
; Verdict 65535 (16 bits):
;   1      tracked answer-free fixture loads through the real bounded file door
;   2      exact expected NodeID/source/source-id and raw bytes are direct children
;   4      loaded query is scannerless data; no model or execution is claimed
;   8      wrong NodeID, source, or source-id cannot redirect the cell
;   16     missing cell is exact nothing
;   32     byte-budget excess is timeout, distinct from nothing/failure
;   64     changing size or mtime during read is failure
;   128    non-string and short reads fail the exact byte-count gate
;   256    trailing, embedded-close, and empty-query frames are failure
;   512    first rotation activates without a release
;   1024   second rotation replaces only active cell and records one logical release
;   2048   failed rotation preserves active cell, generation, and release count
;   4096   prior window stores only prior route identity, not prior query bytes
;   8192   present query text 0 and 1 are distinct cells and not nothing
;   16384  malformed request and malformed observation are refused
;   32768  loader source stays bounded and excludes registry/ops/flatten/carriers
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-query-memory-cell-rotation.fk

(do
    (defn fqmrb-bit (ok bit) (if ok bit 0))
    (defn fqmrb-node-a () (make_nodeid 31 2 0 109))
    (defn fqmrb-node-b () (make_nodeid 31 2 0 108))
    (defn fqmrb-source () "axioms/core-axioms.form")
    (defn fqmrb-source-id ()
        "sha256:893d1a85f5a9475705e59f1bac50b9b19076e2fafb55751b52897af3a6d5bcad")
    (defn fqmrb-frame (node source source-id query)
        (str_concat (fqmr-prefix node source source-id)
            (str_concat query (str_concat "\n" (fqmr-close)))))
    (defn fqmrb-observation (raw size-before mtime-before size-after mtime-after)
        (list size-before mtime-before raw size-after mtime-after))
    (defn fqmrb-io (path max-bytes)
        (if (str_eq path "missing")
            (fqmrb-observation (nothing) -1 -1 -1 -1)
        (if (str_eq path "oversize")
            (fqmrb-observation (nothing) (add max-bytes 1) 10
                (add max-bytes 1) 10)
        (if (str_eq path "size-change")
            (do (let raw (fqmrb-frame (fqmrb-node-a) (fqmrb-source)
                    (fqmrb-source-id) "size-change"))
                (fqmrb-observation raw (str_len raw) 10
                    (add (str_len raw) 1) 10))
        (if (str_eq path "mtime-change")
            (do (let raw (fqmrb-frame (fqmrb-node-a) (fqmrb-source)
                    (fqmrb-source-id) "mtime-change"))
                (fqmrb-observation raw (str_len raw) 10
                    (str_len raw) 11))
        (if (str_eq path "non-string")
            (fqmrb-observation 0 1 10 1 10)
        (if (str_eq path "short")
            (fqmrb-observation "x" 2 10 2 10)
        (if (str_eq path "malformed-observation") (list 1 2)
            (do
                (let query
                    (if (str_eq path "zero") "0"
                    (if (str_eq path "one") "1"
                    (if (str_eq path "two")
                        "<|form:knowledge-query|>second<|/form:knowledge-query|>"
                        "<|form:knowledge-query|>first<|/form:knowledge-query|>"))))
                (let node (if (str_eq path "two")
                    (fqmrb-node-b) (fqmrb-node-a)))
                (let raw (fqmrb-frame node (fqmrb-source)
                    (fqmrb-source-id) query))
                (fqmrb-observation raw (str_len raw) 10
                    (str_len raw) 10))))))))))
    (defn fqmrb-load (path node source source-id)
        (fqmr-load-with fqmrb-io path node source source-id 4096))
    (defn fqmrb-trailing-io (path max-bytes)
        (do
            (let raw (str_concat
                (fqmrb-frame (fqmrb-node-a) (fqmrb-source)
                    (fqmrb-source-id) "q") "x"))
            (fqmrb-observation raw (str_len raw) 10 (str_len raw) 10)))
    (defn fqmrb-embedded-io (path max-bytes)
        (do
            (let raw (fqmrb-frame (fqmrb-node-a) (fqmrb-source)
                (fqmrb-source-id) (str_concat "q" (fqmr-close))))
            (fqmrb-observation raw (str_len raw) 10 (str_len raw) 10)))
    (defn fqmrb-empty-io (path max-bytes)
        (do
            (let raw (fqmrb-frame (fqmrb-node-a) (fqmrb-source)
                (fqmrb-source-id) ""))
            (fqmrb-observation raw (str_len raw) 10 (str_len raw) 10)))

    (defn form-query-memory-cell-rotation-band ()
        (do
            (let fixture
                (fqmr-load
                    "form/form-stdlib/tests/data/query-memory-axioms.formq"
                    (fqmrb-node-a) (fqmrb-source) (fqmrb-source-id) 4096))
            (let fixture-cell (nth fixture 3))
            (let fixture-children (node_children fixture-cell))
            (let first (fqmrb-load "one" (fqmrb-node-a)
                (fqmrb-source) (fqmrb-source-id)))
            (let wrong-node (fqmrb-load "one" (fqmrb-node-b)
                (fqmrb-source) (fqmrb-source-id)))
            (let wrong-source (fqmrb-load "one" (fqmrb-node-a)
                "other/source.form" (fqmrb-source-id)))
            (let wrong-id (fqmrb-load "one" (fqmrb-node-a)
                (fqmrb-source) "sha256:other"))
            (let missing (fqmrb-load "missing" (fqmrb-node-a)
                (fqmrb-source) (fqmrb-source-id)))
            (let oversize (fqmrb-load "oversize" (fqmrb-node-a)
                (fqmrb-source) (fqmrb-source-id)))
            (let changed-size (fqmrb-load "size-change" (fqmrb-node-a)
                (fqmrb-source) (fqmrb-source-id)))
            (let changed-mtime (fqmrb-load "mtime-change" (fqmrb-node-a)
                (fqmrb-source) (fqmrb-source-id)))
            (let non-string (fqmrb-load "non-string" (fqmrb-node-a)
                (fqmrb-source) (fqmrb-source-id)))
            (let short (fqmrb-load "short" (fqmrb-node-a)
                (fqmrb-source) (fqmrb-source-id)))
            (let trailing (fqmr-load-with fqmrb-trailing-io "trailing"
                (fqmrb-node-a) (fqmrb-source) (fqmrb-source-id) 4096))
            (let embedded (fqmr-load-with fqmrb-embedded-io "embedded"
                (fqmrb-node-a) (fqmrb-source) (fqmrb-source-id) 4096))
            (let empty-query (fqmr-load-with fqmrb-empty-io "empty"
                (fqmrb-node-a) (fqmrb-source) (fqmrb-source-id) 4096))
            (let w0 (fqmr-empty-window))
            (let w1 (fqmr-rotate-with fqmrb-io w0 "one" (fqmrb-node-a)
                (fqmrb-source) (fqmrb-source-id) 4096))
            (let first-cell (nth w1 1))
            (let first-key (fqmr-node-key
                (nth (node_children first-cell) 0)))
            (let first-query (node_value (nth (node_children first-cell) 3)))
            (let w2 (fqmr-rotate-with fqmrb-io w1 "two" (fqmrb-node-b)
                (fqmrb-source) (fqmrb-source-id) 4096))
            (let wfail (fqmr-rotate-with fqmrb-io w2 "missing"
                (fqmrb-node-a) (fqmrb-source) (fqmrb-source-id) 4096))
            (let zero (fqmrb-load "zero" (fqmrb-node-a)
                (fqmrb-source) (fqmrb-source-id)))
            (let one (fqmrb-load "one" (fqmrb-node-a)
                (fqmrb-source) (fqmrb-source-id)))
            (let malformed-request (fqmr-load-with fqmrb-io "one"
                (nothing) (fqmrb-source) (fqmrb-source-id) 4096))
            (let malformed-observation (fqmrb-load "malformed-observation"
                (fqmrb-node-a) (fqmrb-source) (fqmrb-source-id)))
            (let source-text (read_file
                "form/form-stdlib/form-query-memory-cell-rotation.fk"))
            (sum (list
                (fqmrb-bit (and (str_eq (nth fixture 1) "ready")
                    (str_eq (nth fixture 10)
                        "<|form:knowledge-query|>resting point<|/form:knowledge-query|>")) 1)
                (fqmrb-bit (and (node_eq (nth fixture-children 0)
                                         (fqmrb-node-a))
                    (and (str_eq (node_value (nth fixture-children 1))
                                 (fqmrb-source))
                    (and (str_eq (node_value (nth fixture-children 2))
                                 (fqmrb-source-id))
                         (eq (str_len (node_value (nth fixture-children 7)))
                             (nth fixture 5))))) 2)
                (fqmrb-bit (and (eq (fqmr-cell-valid? fixture-cell) 1)
                    (and (eq (nth fixture 11) 1)
                    (and (eq (nth fixture 12) 0)
                         (eq (nth fixture 13) 0)))) 4)
                (fqmrb-bit (and (str_eq (nth wrong-node 1) "failure")
                    (and (str_eq (nth wrong-source 1) "failure")
                         (str_eq (nth wrong-id 1) "failure"))) 8)
                (fqmrb-bit (and (str_eq (nth missing 1) "nothing")
                    (and (nothing? (nth missing 3))
                         (nothing? (nth missing 10)))) 16)
                (fqmrb-bit (and (str_eq (nth oversize 1) "timeout")
                    (not (str_eq (nth oversize 1) (nth missing 1)))) 32)
                (fqmrb-bit (and (str_eq (nth changed-size 2)
                                        "file-changed-during-read")
                    (str_eq (nth changed-mtime 2)
                            "file-changed-during-read")) 64)
                (fqmrb-bit (and (str_eq (nth non-string 2) "short-cell-read")
                    (str_eq (nth short 2) "short-cell-read")) 128)
                (fqmrb-bit (and (str_eq (nth trailing 1) "failure")
                    (and (str_eq (nth embedded 1) "failure")
                         (str_eq (nth empty-query 2) "empty-query"))) 256)
                (fqmrb-bit (and (str_eq (nth w1 5) "active")
                    (and (eq (nth w1 2) 1) (eq (nth w1 3) 0))) 512)
                (fqmrb-bit (and (eq (nth w2 2) 2)
                    (and (eq (nth w2 3) 1)
                    (and (str_eq (nth w2 4) first-key)
                         (not (node_eq (nth w2 1) first-cell))))) 1024)
                (fqmrb-bit (and (node_eq (nth wfail 1) (nth w2 1))
                    (and (eq (nth wfail 2) (nth w2 2))
                    (and (eq (nth wfail 3) (nth w2 3))
                         (str_eq (nth wfail 5) "nothing")))) 2048)
                (fqmrb-bit (and (str_eq (nth w2 4) first-key)
                    (and (not (str_eq (nth w2 4) first-query))
                    (and (eq (len w2) 7)
                         (not (str_eq
                            (node_value (nth (node_children (nth w2 1)) 3))
                            first-query))))) 4096)
                (fqmrb-bit (and (str_eq (nth zero 10) "0")
                    (and (str_eq (nth one 10) "1")
                    (and (not (node_eq (nth zero 3) (nth one 3)))
                         (not (nothing? (nth zero 10)))))) 8192)
                (fqmrb-bit (and (str_eq (nth malformed-request 2)
                                        "malformed-request")
                    (str_eq (nth malformed-observation 2)
                            "malformed-file-observation")) 16384)
                (fqmrb-bit (and (le (str_len source-text) 16384)
                    (and (lt (str_find source-text "ops-table" 0) 0)
                    (and (lt (str_find source-text "flatten/" 0) 0)
                    (and (lt (str_find source-text "metal_" 0) 0)
                         (lt (str_find source-text "fcmg-" 0) 0))))) 32768)))))

    (form-query-memory-cell-rotation-band))
