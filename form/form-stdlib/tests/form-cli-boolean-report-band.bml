// Source decisions stay model/caller-owned; native code only normalizes literals.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 class FormBooleanReportBand {
  def fcbrb-check(expected) = parse-json("check",str_concat("{\"tool\":\"jq\",\"arguments\":[\".flag\"],\"stdout\":",str_concat(json-emit(json-node-string(expected)),"}")));
  def fcbrb-assert(name,value) = if value then 1 else form_error(name);
  def fcbrb-report(checks,subject) = fcaq-report-check(checks,nth(subject,1));
 }
 let falseCheck = fcbrb-check("false\n");
 let trueCheck = fcbrb-check("true\n");
 let source = "{\"flag\":\"no\",\"answer\":\"keep these exact words\",\"other\":\"yes\"}";
 let normalized = fcbr-propose(list(falseCheck),source);
 let same = fcbr-propose(list(trueCheck),source);
 fcbrb-assert("normalization offered",head(normalized));
 fcbrb-assert("expected truth value cannot alter normalization",str_eq(nth(normalized,1),nth(same,1)));
 fcbrb-assert("original negative checker accepts",head(fcaq-report-check(list(falseCheck),nth(normalized,1))));
 fcbrb-assert("opposite checker still rejects",not(head(fcaq-report-check(list(trueCheck),nth(normalized,1)))));
 let parsed = parse-json("normalized",nth(normalized,1));
 fcbrb-assert("answer unchanged",str_eq(fcap-string(parsed,"answer"),"keep these exact words"));
 fcbrb-assert("undeclared string unchanged",str_eq(fcap-string(parsed,"other"),"yes"));
 fcbrb-assert("yes is positive",node_eq(nth(fcbr-literal(json-node-string("yes")),1),intern_trivial_bool(true)));
 fcbrb-assert("already boolean unchanged",not(head(fcbr-literal(intern_trivial_bool(false)))));
 fcbrb-assert("zero stays distinct",not(head(fcbr-literal(json-node-int(0)))));
 fcbrb-assert("null stays distinct",not(head(fcbr-literal(json-node-null()))));
 fcbrb-assert("uncertain wording declined",not(head(fcbr-literal(json-node-string("probably no")))));
 fcbrb-assert("absent field not manufactured",not(head(fcbr-propose(list(falseCheck),"{}"))));
 fcbrb-assert("duplicate fields declined",not(head(fcbr-propose(list(falseCheck),"{\"flag\":\"no\",\"flag\":\"yes\"}"))));
 fcbrb-assert("nonboolean expected type declined",not(head(fcbr-propose(list(fcbrb-check("7\n")),source))));
 let hinted = fcaq-report-type-hint("false\n","\"no\"\n");
 fcbrb-assert("type hint names boolean",ge(str_find(hinted,"boolean",0),0));
 fcbrb-assert("type hint does not leak expected truth",str_eq(hinted,fcaq-report-type-hint("true\n","\"no\"\n")));
 fcbrb-assert("same type has no type error",str_eq(fcaq-report-type-hint("false\n","true\n"),""));
 fcbrb-assert("raw text not guessed as JSON",str_eq(fcaq-report-type-hint("false\n","no\n"),""));
 fcbrb-assert("malformed report declined",not(head(fcbr-propose(list(falseCheck),"unfinished"))));
 let docs = list(list("source","decision.txt","The observed answer is no."));
 let state = fcap-open-direct-review("Return the observed decision as a boolean flag.",docs);
 let checker = list(fcbrb-report,list(falseCheck),fcaq-check,list(),fcbr-repair,list(falseCheck));
 let reply = json-emit(json-node-object(list(json-node-pair("report",parse-json("candidate",source)))));
 let complete = fcap-step(state,reply,checker);
 let contrary = fcap-step(state,"{\"report\":{\"flag\":\"yes\"}}",checker);
 fcbrb-assert("native repair completes the same turn",str_eq(fcap-stage(complete),"complete"));
 fcbrb-assert("original and repaired report both checked",eq(fcap-checks(complete),2));
 fcbrb-assert("no additional model turn",eq(fcap-turns(complete),1));
 fcbrb-assert("source documents unchanged",value_eq(fcap-docs(complete),docs));
 fcbrb-assert("native repair attributed",str_eq(nth(head(fcap-native-repairs(complete)),1),"accepted"));
 fcbrb-assert("contrary meaning remains a failed check",str_eq(fcap-stage(contrary),"repair"));
 let request = json-node-object(list(nsm-s("mode","review"),json-node-pair("checks",json-node-array(list())),json-node-pair("report_checks",json-node-array(list(falseCheck)))));
 let ordinary = fcap-step(state,reply,fcaq-live-checker(request));
 fcbrb-assert("ordinary review installs native literal repair",str_eq(fcap-stage(ordinary),"complete"));
 fcbrb-assert("embedding checker retains its four-element contract",eq(len(fcaq-checker(request)),4));
 print(list("boolean-report-boundaries",27));
 1;
}
