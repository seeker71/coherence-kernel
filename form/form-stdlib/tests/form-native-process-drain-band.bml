// A large retained stream exceeds one final-drain slice. Resume from the
// persisted byte cursor and observe its final non-newline health row once.
// No process completion or model result is fabricated by this reader witness.
// preludes: form-stdlib/bml/form-cli-heal-native-process.bml
section [form.bml] {
 class NativeProcessDrainBand {
  def fpdb-need(ok,name) = if ok then 1 else form_error(str_concat("process drain: ",name));
  def fpdb-double(text,n) = if (n <= 0) then text else fpdb-double(str_concat(text,text),(n - 1));
  def fpdb-finish(job,started,left) = if ((Comparable) fhn-number(fhn-drain-reading(job,"read",".out"),"complete") == 1) then 1 else if (left <= 0) then form_error("process drain did not converge") else {
   fhn-drain-final(job,"read",".out",fhn-retained-reader(job,"read",".out"),started);
   fpdb-finish(job,started,(left - 1));
  };
 }
 let root = str_concat("/tmp/form-process-drain-",int_to_str(now_unix_ms()));
 fpdb-need(((Comparable) host_dir_mkdir(root) == 1),"fresh temporary directory");
 let started = host_monotonic_ms();
 write_file(fhn-stage-path(root,"read",".clock"),int_to_str(started));
 write_file(fhn-stage-path(root,"read",".events.jsonl"),"");
 let observation = oh-reading-with-id("bounded-drain-last-line","drain-witness","fixture","last-line",json-node-string("seen"),json-node-string("seen"),json-node-int(1),list(),list(),json-node-object(list()));
 let text = str_concat(fpdb-double("quiet\n",16),str_concat("form-organ health ",json-emit(observation)));
 let path = fhn-stage-path(root,"read",".out"); write_file(path,text);
 let first = fhn-drain-final(root,"read",".out",list(0,""),started);
 let pending = fhn-drain-reading(root,"read",".out");
 fpdb-need((((Comparable) fhn-number(pending,"complete") == 0) && (fhn-number(pending,"remaining_bytes") > 0)),"unfinished traversal stays explicit");
 fpdb-need(((Comparable) (fhn-number(pending,"offset") + fhn-number(pending,"remaining_bytes")) == str_len(text)),"byte accounting reconciles");
 fpdb-need(((Value) first == fhn-retained-reader(root,"read",".out")),"persisted offset reconstructs partial line exactly");
 fpdb-finish(root,started,16);
 let done = fhn-drain-reading(root,"read",".out");
 fpdb-need((((Comparable) fhn-number(done,"offset") == str_len(text)) && ((Comparable) fhn-number(done,"pending_bytes") == 0)),"all bytes consumed and final line cleared");
 fpdb-need(((String) read_file(path) == text),"raw output remains byte-identical");
 let readings = oh-read(fhn-stage-path(root,"read",".events.jsonl"));
 fpdb-need((((Comparable) len(readings) == 1) && ((String) oh-str(head(readings),"id") == "bounded-drain-last-line")),"last non-newline health row observed");
 let eventBytes = file_size(fhn-stage-path(root,"read",".events.jsonl"));
 fhn-drain-final(root,"read",".out",fhn-retained-reader(root,"read",".out"),started);
 fpdb-need(((Comparable) file_size(fhn-stage-path(root,"read",".events.jsonl")) == eventBytes),"resuming a completed cursor duplicates no event");
 1;
}
