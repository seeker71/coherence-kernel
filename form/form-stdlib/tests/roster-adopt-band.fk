; preludes: form-stdlib/core.fk form/form-stdlib/roster-census.bml
; Expected: 63
; PROOF LEVEL: FOURTH-ARM ONLY (host_spawn, the kernel roster and its adopt and forget doors: fkwu doors)
;
; roster-adopt-band — a kernel the roster lost is taken back without being restarted.
;
; A binary that claims its roster slot with a plain store loses kernels started in the same instant as
; a sibling: on 2026-09-11 the main checkout's glass and a Codex worktree's glass each ran such kernels,
; alive, with pages that said so, and absent from the roster; a burst of eight on that binary lost one
; or two every time. Their binary has no tick that puts them back. kernel_roster_adopt gives a slot to a
; pid whose page says it is a living kernel; kernel_roster_forget empties a pid's slot, which is how this
; band makes the lost kernel it then adopts.
;
; Verdict 63:
;   1  a sleeper it starts is in the roster; forgotten (answer 1), it is not
;   2  the census names the forgotten sleeper untracked
;   4  adopting it answers 1: it is in the roster again and no longer untracked
;   8  adopting it a second time answers 0, since it already holds a slot
;  16  a pid with no kernel page (pid 1) is not adopted: -1
;  32  once the sleeper has ended, adopting it answers -1 and neither count holds it
(do
    (defn rab-cmd () (list "./fkwu" "observe/tests/roster-sleeper.fk"))
    (let warm (host_wait (host_spawn_quiet (rab-cmd))))
    (let child (host_spawn_quiet (rab-cmd)))
    (let rest (host_sleep_ms 1200))
    (let held (rce-in? child (rce-roster)))
    (let forgot (kernel_roster_forget child))
    (let absent (rce-in? child (rce-roster)))
    (let t1 (rce-take))
    (let adopted (kernel_roster_adopt child))
    (let back (rce-in? child (rce-roster)))
    (let t2 (rce-take))
    (let again (kernel_roster_adopt child))
    (let init (kernel_roster_adopt 1))
    (let status (host_wait child))
    (let late (kernel_roster_adopt child))
    (let host3 (rce-host))
    (let roster3 (rce-roster))

    (let told (print (list "held" held "forgot" forgot "adopted" adopted "again" again "pid-1" init "late" late)))
    (let c0 (if (and (eq held 1) (and (eq forgot 1) (eq absent 0))) 1 0))
    (let c1 (if (eq (rce-in? child (nth t1 2)) 1) 2 0))
    (let c2 (if (and (eq adopted 1) (and (eq back 1) (eq (rce-in? child (nth t2 2)) 0))) 4 0))
    (let c3 (if (eq again 0) 8 0))
    (let c4 (if (eq init (sub 0 1)) 16 0))
    (let c5 (if (and (eq late (sub 0 1)) (and (eq (rce-in? child host3) 0) (eq (rce-in? child roster3) 0))) 32 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
