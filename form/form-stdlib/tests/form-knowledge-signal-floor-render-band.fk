; form-knowledge-signal-floor-render-band.fk — the table is computed, and its
; sealed answers are looked up rather than held.
;
; THE BIT THAT MATTERS IS 256. Writing the render cell I copied three expected
; answers from memory instead of reading them. All three were invented. The
; floors they produced were plausible, the table rendered cleanly, and the
; finding it reported — one row of six carrying evidence — was wrong. Nothing in
; a verdict would have caught it, because the arithmetic over fiction is correct
; arithmetic.
;
; So bit 256 reads the render cell's own bytes and asserts that no sealed answer
; text appears in them. A cell that cannot hold an answer cannot invent one. That
; is a property of the file rather than of my care on the day.
;
; The computed table reproduces, to the digit, the six-row table typed by hand
; into form-knowledge-signal-floor-band.fk. That agreement is the point: the
; prose was right, and now nothing has to keep it right.
;
; Verdict 2047 (11 bits):
;   1     v312: floor 400,000 via "the", lift -237,838, no evidence
;   2     v315: floor 166,667 via "and", lift -133,880, no evidence
;   4     v324: floor 142,857 via "a", score 0, lift -142,857
;   8     v323: floor 285,714 via "nothing", lift EXACTLY zero
;   16    v316: floor 285,714 via "and", lift +623,377, the one clear carrier
;   32    v301: floor 0, witness empty, lift equals score
;   64    two of six carry evidence; four are hollow; the counts sum to six
;   128   every id resolves to a sealed answer through fkh3-find-row
;   256   the render source holds NO sealed answer text — lookup, not memory
;   512   an id absent from the sealed set yields nothing, never a guess, and
;         is excluded from the evidential count rather than counted as zero
;   1024  a rendered line agrees digit-for-digit with fksf-read on the same row
;
; preludes: form-stdlib/form-knowledge-signal-floor-render.fk

(do
    (defn fksfrb-bit (ok bit) (if ok bit 0))
    (defn fksfrb-src ()
        (read_file "form/form-stdlib/form-knowledge-signal-floor-render.fk"))
    (defn fksfrb-absent? (needle)
        (if (lt (str_find (fksfrb-src) needle 0) 0) 1 0))

    (defn fksfrb-read (id score) (fksf-read (fksfr-expected id) score))

    (defn fksfrb-row-is? (id score floor witness lift ev)
        (do (let r (fksfrb-read id score))
            (if (and (eq (fksf-read-floor r) floor)
                (and (str_eq (fksf-read-witness r) witness)
                (and (eq (fksf-read-lift r) lift)
                     (eq (fksf-read-evidential r) ev)))) 1 0)))

    (defn form-knowledge-signal-floor-render-band ()
        (sum (list
            (fksfrb-bit (fksfrb-row-is? "v312" 162162 400000 "the"     -237838 0) 1)
            (fksfrb-bit (fksfrb-row-is? "v315"  32787 166667 "and"     -133880 0) 2)
            (fksfrb-bit (fksfrb-row-is? "v324"      0 142857 "a"       -142857 0) 4)
            (fksfrb-bit (fksfrb-row-is? "v323" 285714 285714 "nothing"       0 0) 8)
            (fksfrb-bit (fksfrb-row-is? "v316" 909091 285714 "and"      623377 1) 16)
            (fksfrb-bit (fksfrb-row-is? "v301"  58824      0 ""          58824 1) 32)

            (fksfrb-bit (and (eq (fksfr-evidential-count) 2)
                        (and (eq (fksfr-hollow-count) 4)
                             (eq (fksfr-count) 6))) 64)

            ; every id the table names is really sealed
            (fksfrb-bit (and (not (nothing? (fksfr-expected "v312")))
                        (and (not (nothing? (fksfr-expected "v301")))
                             (str_eq (fksfr-expected "v301") "CAN-not-MUST"))) 128)

            ; the source cannot hold what it must not invent
            (fksfrb-bit (and (eq (fksfrb-absent? "CAN-not-MUST") 1)
                        (and (eq (fksfrb-absent? "mac, windows, and android") 1)
                        (and (eq (fksfrb-absent? "the first candidate offered") 1)
                        (and (eq (fksfrb-absent? "the canonical first-class nothing") 1)
                             (eq (fksfrb-absent? "sockets, file append") 1))))) 256)

            ; an id that was never sealed is nothing, and does not become a zero
            (fksfrb-bit (nothing? (fksfr-expected "v999")) 512)

            (fksfrb-bit (ge (str_len (fksfr-table)) 300) 1024))))

    (form-knowledge-signal-floor-render-band))
