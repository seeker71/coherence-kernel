; form-knowledge-signal-floor-render-band.fk — the reading is the value; the
; table is a projection; neither holds a sealed answer nor a fixed set.
;
; THREE BITS CARRY THE ARCHITECTURE.
;
; 256 reads the cell's own bytes and asserts no sealed answer appears in them.
; The first draft held three answers written from memory. All three were
; invented, their floors were plausible, the table rendered cleanly, and the
; finding it reported was false. Correct arithmetic over fiction is still
; correct arithmetic, so no verdict catches it. A cell that cannot hold an
; answer cannot invent one.
;
; 1024 hands the same functions a set they have never seen and a set of size
; zero. The first version could not have passed it: it held six rows chosen
; because a comment had chosen six, out of thirty sealed.
;
; 2048 asserts the projection follows its argument. A cell whose output is a
; padded string is unwired BY CONSTRUCTION rather than by forgetfulness — no
; gate branches on text, no fold accumulates it. So the readings are the value
; and the table is one optional view over them, and folds take READINGS rather
; than observations: a count that takes observations hides a re-derivation of
; the whole sealed set behind what looks like a fold. That was not a
; performance detail. It was the same mistake as the table, one layer down.
;
; Verdict 4095 (12 bits):
;   1     v312: floor 400,000 via "the", lift -237,838, no evidence
;   2     v315: floor 166,667 via "and", lift -133,880, no evidence
;   4     v324: floor 142,857 via "a", score 0 MEASURED, lift -142,857
;   8     v323: floor 285,714 via "nothing", lift EXACTLY zero
;   16    v316: floor 285,714 via "and", lift +623,377, the one clear carrier
;   32    v301: floor 0, witness empty, lift equals score
;   64    over the banked readings: 2 evidential, 4 hollow, partitioning all 6
;   128   ids resolve to sealed text through fkh3-find-row, not from this file
;   256   the source holds NO sealed answer text — lookup, not memory
;   512   an unsealed id reads nothing, is ABSENT from readings, and shrinks
;         the reading count rather than folding in as a zero against the model
;   1024  total over sets never seen: one row, and the empty set
;   2048  the projection follows its argument; the empty set renders a header
;
; preludes: form-stdlib/form-knowledge-signal-floor-render.fk

(do
    (defn fksfrb-bit (ok bit) (if ok bit 0))
    (defn fksfrb-absent? (src needle)
        (if (lt (str_find src needle 0) 0) 1 0))

    (defn fksfrb-read1 (id score)
        (fksfr-reading-read
            (head (fksfr-readings (list (fksfr-obs id score))))))

    (defn fksfrb-row-is? (id score floor witness lift ev)
        (do (let r (fksfrb-read1 id score))
            (if (and (eq (fksf-read-floor r) floor)
                (and (str_eq (fksf-read-witness r) witness)
                (and (eq (fksf-read-lift r) lift)
                     (eq (fksf-read-evidential r) ev)))) 1 0)))

    (defn form-knowledge-signal-floor-render-band ()
        (do
            (let src (read_file
                "form/form-stdlib/form-knowledge-signal-floor-render.fk"))
            (let banked (fksfr-readings (fksfr-banked-2026-08-26)))
            (let none   (fksfr-readings (list)))
            (let one    (fksfr-readings (list (fksfr-obs "v311" 1000000))))
            (let mixed  (fksfr-readings (list (fksfr-obs "v316" 909091)
                                              (fksfr-obs "v999" 500000))))

            (sum (list
                (fksfrb-bit (fksfrb-row-is? "v312" 162162 400000 "the"     -237838 0) 1)
                (fksfrb-bit (fksfrb-row-is? "v315"  32787 166667 "and"     -133880 0) 2)
                (fksfrb-bit (fksfrb-row-is? "v324"      0 142857 "a"       -142857 0) 4)
                (fksfrb-bit (fksfrb-row-is? "v323" 285714 285714 "nothing"       0 0) 8)
                (fksfrb-bit (fksfrb-row-is? "v316" 909091 285714 "and"      623377 1) 16)
                (fksfrb-bit (fksfrb-row-is? "v301"  58824      0 ""          58824 1) 32)

                (fksfrb-bit (and (eq (fksfr-evidential-count banked) 2)
                            (and (eq (fksfr-hollow-count banked) 4)
                                 (eq (len banked) 6))) 64)

                (fksfrb-bit (and (not (nothing? (fksfr-expected "v312")))
                                 (str_eq (fksfr-expected "v301") "CAN-not-MUST")) 128)

                (fksfrb-bit (and (eq (fksfrb-absent? src "CAN-not-MUST") 1)
                            (and (eq (fksfrb-absent? src "mac, windows, and android") 1)
                            (and (eq (fksfrb-absent? src "the first candidate offered") 1)
                            (and (eq (fksfrb-absent? src "the canonical first-class nothing") 1)
                                 (eq (fksfrb-absent? src "sockets, file append") 1))))) 256)

                ; unsealed: nothing, absent, never a zero against the model
                (fksfrb-bit (and (nothing? (fksfr-expected "v999"))
                            (and (nothing? (fksfr-reading (fksfr-obs "v999" 500000)))
                            (and (eq (len mixed) 1)
                                 (eq (fksfr-hollow-count mixed) 0)))) 512)

                (fksfrb-bit (and (eq (len none) 0)
                            (and (eq (fksfr-evidential-count none) 0)
                            (and (eq (len one) 1)
                                 (eq (fksfr-evidential-count one) 1)))) 1024)

                (fksfrb-bit (and (eq (str_len (fksfr-table none))
                                     (str_len (fksfr-header)))
                            (and (gt (str_len (fksfr-table banked))
                                     (str_len (fksfr-table one)))
                                 (gt (str_len (fksfr-table one))
                                     (str_len (fksfr-header))))) 2048)))))

    (form-knowledge-signal-floor-render-band))
