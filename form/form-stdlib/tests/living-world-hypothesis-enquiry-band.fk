; living-world-hypothesis-enquiry-band.fk -- twenty-two independent claims for
; selection-free active differentiation, optional choices, and revocation.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-enquiry.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk

(do
    (let result (lwhew-run))
    (let fixture (lwhew-result-fixture result))
    (let world (lwhew-space-world fixture))
    (let space (lwhew-space-cell fixture))
    (let enquiry (lwhew-result-enquiry result))
    (let separating (lwhew-result-separating result))
    (let aligned (lwhew-result-aligned result))
    (let open (lwhew-result-open result))
    (let chosen (lwhew-result-chosen result))
    (let alternative (lwhew-result-alternative result))
    (let invalid (lwhew-result-invalid result))
    (let probe (lwhew-result-probe result))
    (let placement (lwhew-result-placement result))
    (let events (framebuffer-events))
    (sum (list
        (if (eq (lwhe-space-valid? space) 1) 1 0)
        (if (eq (lwhe-space-current? world space 2) 1) 2 0)
        (if (eq (lwhe-enquiry? enquiry) 1) 4 0)
        (if (eq (lwhe-enquiry-current? world enquiry) 1) 8 0)
        (if (eq (lwo-field-size (lwhe-enquiry-trials enquiry)) 2) 16 0)
        (if (eq (lwo-field-size (lwhe-enquiry-separating enquiry)) 1) 32 0)
        (if (eq (lwo-field-size (lwhe-enquiry-aligned enquiry)) 1) 64 0)
        (if (and (eq (lwo-field-size (lwhe-trial-outputs separating)) 2)
                 (eq (lwhe-separating? (lwhe-trial-state separating)) 1)) 128 0)
        (if (and (eq (lwo-field-size (lwhe-trial-outputs aligned)) 1)
                 (eq (lwhe-aligned? (lwhe-trial-state aligned)) 1)) 256 0)
        (if (eq (lwhe-request-valid? open) 1) 512 0)
        (if (node_eq (lwhe-request-selected-trial open) (lwo-none)) 1024 0)
        (if (eq (lwhe-request-valid? chosen) 1) 2048 0)
        (if (node_eq (lwhe-request-selected-trial chosen) separating) 4096 0)
        (if (and (eq (lwhe-request-valid? alternative) 1)
                 (node_eq (lwhe-request-selected-trial alternative)
                          (lwo-none))) 8192 0)
        (if (eq (lwhe-request-valid? invalid) 0) 16384 0)
        (if (eq (lwph-probe-shape-valid? probe) 1) 32768 0)
        (if (eq (lwph-discriminated?
                  (lwph-placement-status placement)) 1) 65536 0)
        (if (and (eq (lwo-field-size
                       (lwph-placement-confirmed placement)) 2)
                 (eq (lwo-field-size
                       (lwph-placement-diverged placement)) 2)) 131072 0)
        (if (node_eq (lwhew-result-stale result) (lwo-none)) 262144 0)
        (if (eq (lwhe-enquiry-current?
                  (lwhew-result-revoked result) enquiry) 0) 524288 0)
        (if (eq (lwph-integrated-current?
                  (lwhew-result-revoked result)
                  (lwhe-space-candidate space)) 1) 1048576 0)
        (if (eq (len events) 8) 2097152 0))))
