; living-world-durable-action-enquiry-witness.fk -- an unresolved question and
; plural non-answers cross a process without carrying authority through load.
;
; The writer alone constructs the historical question fixture. Reader helpers
; consume only the loaded image. The image enters an empty admission world as
; inert evidence; every active historical source must freshly acknowledge the
; exact restore proposal before the stored world returns as a successor.
; witnessed: 2026-08-08 -> 32767/65535 across fresh fkwu processes
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-action-enquiry.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk form-stdlib/tests/living-world-action-enquiry-witness.fk

(let LWDAEQ-SOURCE-CUSTODIAN   (bp "LWDAEQ-SOURCE-CUSTODIAN"))
(let LWDAEQ-PROV-CUSTODIAN     (bp "LWDAEQ-PROV-CUSTODIAN"))
(let LWDAEQ-CONSENT-PROVENANCE (bp "LWDAEQ-CONSENT-PROVENANCE"))

(defn lwdaeq-cell (kind) (intern_node kind (empty)))
(defn lwdaeq-source-custodian ()
    (lwdaeq-cell LWDAEQ-SOURCE-CUSTODIAN))
(defn lwdaeq-prov-custodian ()
    (lwdaeq-cell LWDAEQ-PROV-CUSTODIAN))

(defn lwdaeq-path ()
    "/tmp/coherence-living-world-durable-action-enquiry-v1.ccs")

(defn lwdaeq-remove-path (path)
    (if (eq (fs-exists? path) 1) (fs-remove-file path) 0))

(defn lwdaeq-clean ()
    (do
        (lwdaeq-remove-path (lwdaeq-path))
        (lwdaeq-remove-path (lwcd-pending-path (lwdaeq-path)))))

(defn lwdaeq-entry-for (source provenance payload)
    (lwacw-entry-for source provenance payload))

(defn lwdaeq-consent-provenance (proposal source)
    (intern_node LWDAEQ-CONSENT-PROVENANCE
        (list proposal source (lwo-local-path))))

(defn lwdaeq-response-entry (proposal source)
    (do
        (let provenance (lwdaeq-consent-provenance proposal source))
        (lwdaeq-entry-for source provenance
            (lwt-response proposal (oac-one proposal) provenance))))

(defn lwdaeq-response-entries-items (proposal items)
    (if (eq (len items) 0) (list)
        (cons (lwdaeq-response-entry proposal (head items))
            (lwdaeq-response-entries-items proposal (tail items)))))

(defn lwdaeq-response-entries (proposal)
    (lwdaeq-response-entries-items proposal
        (lwo-field-items (lwt-proposal-participants proposal))))

(defn lwdaeq-admission-world (image)
    (lwt-receive-stream (lwo-empty-world)
        (list
            (lwdaeq-entry-for
                (lwdaeq-source-custodian)
                (lwdaeq-prov-custodian) image))))

(defn lwdaeq-restore-proposal (image)
    (lwcn-restore-proposal (lwdaeq-admission-world image) image))

(defn lwdaeq-waiting-round (image)
    (do
        (let admission (lwdaeq-admission-world image))
        (let proposal (lwcn-restore-proposal admission image))
        (let round
            (lwt-round admission (lwo-field (list proposal))
                (lwo-empty-field) (lwo-none)))
        (lwcn-integrate-restore round proposal (lwrew-action))))

(defn lwdaeq-restored-round (image)
    (do
        (let admission (lwdaeq-admission-world image))
        (let proposal (lwcn-restore-proposal admission image))
        (let round
            (lwt-round-receive
                (lwt-round admission (lwo-field (list proposal))
                    (lwo-empty-field) (lwo-none))
                (lwdaeq-response-entries proposal)))
        (lwcn-integrate-restore round proposal (lwrew-action))))

(defn lwdaeq-question-items (world items field)
    (if (eq (len items) 0) field
        (do
            (let candidate (head items))
            (lwdaeq-question-items world (tail items)
                (if (and (eq (lwae-question-candidate? candidate) 1)
                         (eq (lwae-question-steady? world candidate) 1))
                    (lwo-field-add field candidate) field)))))

(defn lwdaeq-questions (world)
    (lwdaeq-question-items world
        (lwo-field-items (lwo-world-cells world)) (lwo-empty-field)))

(defn lwdaeq-only (field)
    (if (eq (lwo-field-size field) 1)
        (head (lwo-field-items field)) (lwo-none)))

(defn lwdaeq-evidence-immediate (items)
    (if (eq (len items) 0) (lwo-none)
        (if (eq (lwae-stance-immediate-nothing?
                    (lwae-stance-evidence-stance (head items))) 1)
            (head items)
            (lwdaeq-evidence-immediate (tail items)))))

(defn lwdaeq-evidence-pending (items)
    (if (eq (len items) 0) (lwo-none)
        (if (eq (lwae-stance-time-pending?
                    (lwae-stance-evidence-stance (head items))) 1)
            (head items)
            (lwdaeq-evidence-pending (tail items)))))

(defn lwdaeq-evidence-timed-alternative (items)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let stance (lwae-stance-evidence-stance (head items)))
            (if (and (eq (lwae-stance-timed? stance) 1)
                     (eq (lwae-stance-alternative? stance) 1))
                (head items)
                (lwdaeq-evidence-timed-alternative (tail items))))))

(defn lwdaeq-evidence-expired-nothing (items)
    (if (eq (len items) 0) (lwo-none)
        (if (eq (lwae-stance-expired-to-nothing?
                    (lwae-stance-evidence-stance (head items))) 1)
            (head items)
            (lwdaeq-evidence-expired-nothing (tail items)))))

(defn lwdaeq-current-selections-items (world items field)
    (if (eq (len items) 0) field
        (do
            (let candidate (head items))
            (lwdaeq-current-selections-items world (tail items)
                (if (eq (lwac-selection-integrated-current?
                            world candidate) 1)
                    (lwo-field-add field candidate) field)))))

(defn lwdaeq-current-selections (world)
    (lwdaeq-current-selections-items world
        (lwo-field-items (lwo-world-cells world)) (lwo-empty-field)))

(defn lwdaeq-current-executions-items (world items field)
    (if (eq (len items) 0) field
        (do
            (let candidate (head items))
            (lwdaeq-current-executions-items world (tail items)
                (if (eq (lwac-execution-integrated-current?
                            world candidate) 1)
                    (lwo-field-add field candidate) field)))))

(defn lwdaeq-current-executions (world)
    (lwdaeq-current-executions-items world
        (lwo-field-items (lwo-world-cells world)) (lwo-empty-field)))

(defn lwdaeq-revoked-world (world)
    (lwt-receive-stream world
        (list
            (lwacw-entry-h
                (lwo-revocation (lwacw-offer-b) (lwacw-source-h)
                    (lwrew-action) (lwacw-prov-h))))))

(defn lwdaeq-save-world (world)
    (lwcd-save-new (lwdaeq-path) (lwcn-image world) (lwo-none)))

(defn lwdaeq-load () (lwcd-load (lwdaeq-path) (lwo-none)))

(defn lwdaeq-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwdaeq-sum (tail items)))))
