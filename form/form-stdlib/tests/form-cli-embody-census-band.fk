;
; Verdict 1023:
;   1..128  fem-check (proof 1214, organs 57, kinds 513, body 164, corpus 1152, need 95, session ppm, pairs 45)
;   256     class descriptor FormEmbodyCensus minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-embody-census.bml
; witnessed: 2026-08-26 -> 1023; proof 1214, organs 57, kinds 513, corpus 1152, need 95, fqt-lora 0

(do
    (defn femb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn femb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (femb-has-name? (tail xs) name))))

    (let bits (fem-check))
    (let desc (FormEmbodyCensus))
    (let src (read_file "form/form-stdlib/bml/form-cli-embody-census.bml"))
    (let exe (read_file "form/form-stdlib/form-cli-embody-census.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormEmbodyCensus")
                     (and (eq (femb-has-name? (nth desc 2) "T") 1)
                          (and (eq (femb-has-name? (nth desc 3) "fem-proof-n") 1)
                               (eq (femb-has-name? (nth desc 4) "KnowledgeN") 1))))
                256 0))
    (let b9 (if (and (eq (femb-has-str? src "package Form.cli.embodycensus") 1)
                     (and (eq (femb-has-str? src "interface IEmbodyCensus") 1)
                          (and (eq (femb-has-str? src "class FormEmbodyCensus") 1)
                               (and (eq (femb-has-str? src "const int KnowledgeN") 1)
                                    (and (eq (femb-has-str? src "template CensusRow") 1)
                                         (and (eq (femb-has-str? exe "heldout-v3") 0)
                                              (eq (femb-has-str? exe "turn_started") 0)))))))
                512 0))
    (add bits (add b8 b9)))
