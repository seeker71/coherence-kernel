; preludes: form-stdlib/core.fk form-stdlib/trig.fk form-stdlib/endpointing.fk form-stdlib/voice-formant.fk form-stdlib/voiced-reading.fk
;
; voiced-reading-band — periodicity, not energy, proven four-way. Every number below was PROBED from
; the body before it was written here, never computed beside it.
;
; The two fixtures that carry the weight are a square wave of period 8 and a verified-aperiodic noise
; at the SAME amplitude, so their R(0) — their total energy, sample for sample — is identical. A
; feature that merely tracked loudness would give them the same answer. The noise is the HIGH bit of an
; LCG, and that word "verified" is load-bearing: the first draft used the LOW bit, which alternates
; with period 2, so the "noise" read 1.000 perfectly periodic and the band would have passed while
; proving nothing. That is corpus row 932 tamefixture happening one prompt after the row was written,
; caught this time by checking the fixture's own autocorrelation before trusting it.
;
; Verdict 2047 when every claim lands:
;   1     f0 becomes a lag range: 16000Hz with f0max 400 → 40, f0min 100 → 160 (long lag = low pitch)
;   2     the frame-ok boundary is EXACT, not approximate: 144 samples → 0, 145 → 1. A frame needs its
;         window, the longest lag to shift against, and one more for the difference to look back at.
;   4     R(0) is the sum of squares, by definition: (1 2 3) → 14
;   8     vr-diff is the first difference: (1 4 9) → (3 5)
;   16    a square wave of period 8 finds lag 8 — the analyser finds the period it was given
;   32    NOT ENERGY IN DISGUISE. Square and noise carry IDENTICAL R(0) (128000000 both) and read
;         1.000 and 0.200. This is the bit that says the cell is an advance and not a rename.
;   64    SCALE-INVARIANT: multiply every sample by 3 and the reading does not move (0.200 → 0.200).
;         So there is no floor to measure and no contrast to require — a clip of unbroken speech, which
;         pause-reading.fk honestly declines, reads fine here.
;   128   PRE-EMPHASIS is what makes it a discriminator. Brown noise (the running sum of the white
;         above, so 1/f²-weighted like room tone) reads 0.896 RAW — nearly as periodic as a vowel —
;         and 0.078 pre-emphasized, an 11.5x drop. Raw autocorrelation's worst case is exactly the
;         noise a room makes, and on a rendered clip with a pink bed the same change moved a real
;         speech/quiet pair from 0.934/0.698 to 0.798/0.097.
;   256   ANALYSIS BY SYNTHESIS, no outside oracle in the loop: voice-formant.fk has synthesized Sema's
;         chosen voice at f0 = 165 Hz since it was written, and nothing in the body could hear it back.
;         The body's own ear now recovers the body's own voice — f0 165 Hz, periodicity 0.999.
;   512   it composes downstream UNCHANGED: a clip of 3 voiced frames then 3 noise frames yields 6
;         readings that fold through endpointing.fk to ep-pause-run 0.375 s — exactly the three noise
;         frames at 0.125 s each. Voice, not loudness, reached the turn decision.
;   1024  the unanalysable tail is DROPPED, not called a pause: 800 samples at width 128 give 6 frames,
;         and a clip shorter than one window gives 0. A frame that could not be analysed is not
;         evidence of silence, and defaulting it to "pause" would lengthen every clip's trailing quiet.
(do
    ; period-8 square at amplitude a
    (defn vrb-sq (n a) (if (le n 0) (list) (cons (if (lt (mod n 8) 4) a (sub 0 a)) (vrb-sq (sub n 1) a))))
    ; the LCG's HIGH bit — aperiodic. Its LOW bit alternates with period 2 (see the header), and the
    ; multiplier is MINSTD's 48271 rather than glibc's 1103515245 for a second reason, also measured:
    ; 2147483648 × 1103515245 ≈ 2^61, past the 2^53 where an IEEE double stops counting integers, so
    ; the TypeScript arm computed a DIFFERENT noise sequence and this band read 1823 there against
    ; 2047 on the other three. 2147483647 × 48271 ≈ 1.04e14 fits, and all four arms now generate the
    ; same fixture. A band's fixture has to be portable before its claim can be.
    (defn vrb-nz (n s out)
        (if (le n 0) out
            (do (let s2 (mod (mul s 48271) 2147483647))
                (vrb-nz (sub n 1) s2 (cons (if (eq (mod (div s2 536870912) 2) 1) 1000 -1000) out)))))
    ; brown noise: the running sum of white, so its power leans low the way a room's does
    (defn vrb-cum (xs acc out)
        (if (nil? xs) (reverse out) (do (let a2 (add acc (head xs))) (vrb-cum (tail xs) a2 (cons a2 out)))))
    (defn vrb-scale (xs k) (if (nil? xs) (list) (cons (mul (head xs) k) (vrb-scale (tail xs) k))))
    (defn vrb-cat (a b) (if (nil? a) b (cons (head a) (vrb-cat (tail a) b))))
    (defn vrb-sema (i n out) (if (ge i n) (reverse out) (vrb-sema (add i 1) n (cons (sema-sample i) out))))

    (let sq (vrb-sq 300 1000))
    (let nz (vrb-nz 300 7 (list)))
    (let br (vrb-cum (vrb-nz 300 7 (list)) 0 (list)))
    (let voice (vrb-sema 0 481 (list)))

    (let c0 (if (eq (vr-lag-lo 16000 400) 40) (if (eq (vr-lag-hi 16000 100) 160) 1 0) 0))
    (let c1 (if (eq (vr-frame-ok? (vrb-nz 144 7 (list)) 128 1024 64) 0)
               (if (eq (vr-frame-ok? (vrb-nz 145 7 (list)) 128 1024 64) 1) 2 0) 0))
    (let c2 (if (eq (vr-r (list 1 2 3) 0 3) 14) 4 0))
    (let c3 (if (eq (sum (vr-diff (list 1 4 9) 2)) 8)
               (if (eq (head (vr-diff (list 1 4 9) 2)) 3) 8 0) 0))
    (let c4 (if (eq (vr-best-lag (vr-window sq 128 1024 64) 128 1024 64 256) 8) 16 0))

    ; identical energy, different answers — the claim of the whole cell
    (let c5 (if (eq (vr-r sq 0 128) (vr-r nz 0 128))
               (if (eq (round (mul (vr-periodicity sq 128 1024 64 256) 1000)) 1000)
                   (if (eq (round (mul (vr-periodicity nz 128 1024 64 256) 1000)) 200) 32 0) 0) 0))
    (let c6 (if (eq (round (mul (vr-periodicity (vrb-scale nz 3) 128 1024 64 256) 1000)) 200) 64 0))
    (let c7 (if (eq (round (mul (vr-periodicity-raw br 128 1024 64 256) 1000)) 896)
               (if (eq (round (mul (vr-periodicity br 128 1024 64 256) 1000)) 78) 128 0) 0))

    ; the body's ear on the body's voice
    (let c8 (if (eq (round (vr-f0 voice 320 16000 100 400)) 165)
               (if (eq (round (mul (vr-periodicity voice 320 16000 100 400) 1000)) 999) 256 0) 0))

    ; 3 voiced frames then 3 noise frames, folded through endpointing
    (let clip (vrb-cat (vrb-sq 384 1000) (vrb-nz 416 7 (list))))
    (let rd (vr-readings clip 800 128 1024 64 256))
    (let c9 (if (eq (len rd) 6)
               (if (eq (round (mul (ep-pause-run rd 0.125) 1000)) 375) 512 0) 0))
    (let c10 (if (eq (vr-frame-count 800 128 1024 64) 6)
                (if (eq (vr-frame-count 100 128 1024 64) 0) 1024 0) 0))

    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9 c10)))))))))))
