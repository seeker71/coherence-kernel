  // yesterday's stamp, and one from the future, read no recent start
  def hwb-bg-old?(begin, ctx, tag, t0) {
   let q = hwb-bg-paths(ctx, tag ++ "-old");
   let r = hwb-bg-paths(ctx, tag ++ "-future");
   let placed = write_file_text(q[1], hw-owner-text("scheduled-walk", 1, t0 - 86400000) ++ "\n");
   let placed2 = write_file_text(r[1], hw-owner-text("scheduled-walk", 1, t0 + 3600000) ++ "\n");
   let old = hwb-bg-begin(begin, q, "scheduled-walk", hwb-self(), t0, false);
   let future = hwb-bg-begin(begin, r, "scheduled-walk", hwb-self(), t0, false);
   let freed = hw-release-at(q[0], hwb-self());
   let freed2 = hw-release-at(r[0], hwb-self());
   ((Comparable) old[0] == 1) && ((Comparable) future[0] == 1) && ((Comparable) hwb-bg-at(q[1], "scheduled-walk") == t0) && ((Comparable) hwb-bg-at(r[1], "scheduled-walk") == t0);
  }
  // the lock still excludes: a second door while the first holds is refused as before and writes no stamp
  def hwb-bg-excludes?(begin, ctx, tag) {
   let p = hwb-bg-paths(ctx, tag ++ "-busy");
   let n = now_unix_ms();
   let held = hwb-bg-begin(begin, p, "scheduled-walk", hwb-self(), n, false);
   let busy = hwb-bg-begin(begin, p, "day-turn", 1, n + 1000, false);
   let refused = ((Comparable) held[0] == 1) && ((Comparable) busy[0] == 0) && hwb-has?(busy[1], "day-turn does not start: scheduled-walk (pid " ++ hwb-self().str() ++ ")") && ((String) hw-slot-row(p[1], "day-turn") == "");
   let freed = hw-release-at(p[0], hwb-self());
   refused;
  }
  def hwb-bg-checks(begin, ctx, tag) {
   let p = hwb-bg-paths(ctx, tag);
   let t0 = hwb-bg-t0();
   hwb-bg-stamped?(begin, p, t0) && hwb-bg-retry?(begin, p, t0) && hwb-bg-other?(begin, p, t0) && hwb-bg-again?(begin, p, t0) && hwb-bg-edge?(begin, p, t0) && hwb-bg-old?(begin, ctx, tag, t0) && hwb-bg-excludes?(begin, ctx, tag);
  }
  // 1099511627776: the real begin keeps every check
  def hwb-began(ctx) = hwb-bit(hwb-bg-checks(hw-begin-at, ctx, "real"));
  // the plants: each flaw a begin could have, built from the real pieces; each fails the checks that name it
  def hwb-plant-recent(lock, path, door, pid, now, again, zone, row, recent) = recent && !again ? [0, hw-slot-line(door, row, zone)] : hw-begun(path, door, pid, now, again, hw-claim-at(lock, door, pid, now));
  // the stamp never written: a retry finds nothing
  def hwb-plant-nostamp(lock, path, door, pid, now, again, zone) {
   let row = hw-slot-row(path, door);
   hw-slot-recent?(row, now) && !again ? [0, hw-slot-line(door, row, zone)] : hw-claim-at(lock, door, pid, now);
  }
  // the window compared with the wrong inequality: a start exactly the window later is still refused
  def hwb-plant-le(lock, path, door, pid, now, again, zone) {
   let row = hw-slot-row(path, door);
   let age = hw-slot-age(row, now);
   hwb-plant-recent(lock, path, door, pid, now, again, zone, row, nothing?(age) ? false : (age >= 0) && (age <= hw-slot-window-ms()));
  }
  // the door name ignored: the first row of the file is every door's own
  def hwb-plant-anydoor(lock, path, door, pid, now, again, zone) {
   let rows = hw-slot-rows(path);
   let row = nil?(rows) ? "" : rows[0];
   hwb-plant-recent(lock, path, door, pid, now, again, zone, row, hw-slot-recent?(row, now));
  }
  // the age ignored: any stamp, however old, refuses
  def hwb-plant-ageless(lock, path, door, pid, now, again, zone) {
   let row = hw-slot-row(path, door);
   hwb-plant-recent(lock, path, door, pid, now, again, zone, row, (Comparable) len(row) > 0);
  }
  // 2199023255552: each planted flaw fails the checks the real begin keeps
  def hwb-began-plants(ctx) = hwb-bit(!hwb-bg-checks(hwb-plant-nostamp, ctx, "p1") && !hwb-bg-checks(hwb-plant-le, ctx, "p2") && !hwb-bg-checks(hwb-plant-anydoor, ctx, "p3") && !hwb-bg-checks(hwb-plant-ageless, ctx, "p4"));
  // ── the lens: hours since a walk began, over synthetic stamps ──
  def hwb-gp-row(door, at) = hw-owner-text(door, 1, at);
  def hwb-gp-note(row, now) = hw-gap-lines(row, now, hwb-bg-zone(), "");
  def hwb-gp-hours(row, now) = hw-gap-code(row, now);
  def hwb-gp-gap?(row, now) = hwb-has?(hwb-gp-note(row, now)[0], "[walk-gap]");
  def hwb-gp-door(ctx, text) {
   let io = hwb-io(ctx);
   let made = host_dir_mkdir(io);
   let run = hch-run-quiet-in(io, "lens", ["./fkwu", "observe/walk-began-run.bml"], text, nothing());
   trim(run[1] ?? "");
  }
  def hwb-gap(ctx) {
   let t0 = hwb-bg-t0();
   let hr = hwb-hour(1);
   let dusk = hwb-gp-row("day-turn", t0 + 15 * hr + 1800000);
   let night = hwb-gp-row("scheduled-walk", t0);
   let after14 = t0 + 29 * hr + 1800000;
   let a = hwb-root(ctx) ++ "/gp-a.began";
   let b = hwb-root(ctx) ++ "/gp-b.began";
   let written = write_file_text(a, night ++ "\nnot a row\n" ++ hwb-gp-row("day-turn", t0 - hwb-hour(5)) ++ "\n");
   let written2 = write_file_text(b, hwb-gp-row("day-turn", t0 + 9 * hr) ++ "\n");
   let latest = hw-slot-latest-of([hwb-root(ctx) ++ "/gp-none.began", a, b]);
   let stamp = hwb-root(ctx) ++ "/gp-door.began";
   let placed = write_file_text(stamp, night ++ "\n" ++ dusk ++ "\n");
   let seen = hwb-gp-door(ctx, "{\"stamp\":\"" ++ stamp ++ "\",\"now_ms\":" ++ after14.str() ++ ",\"zone_ms\":28800000}\n");
   let lone = hwb-gp-door(ctx, "{\"stamp\":\"" ++ hwb-root(ctx) ++ "/gp-missing.began\",\"now_ms\":" ++ after14.str() ++ ",\"zone_ms\":28800000}\n");
   hwb-bit(((String) hwb-gp-note(dusk, after14)[0] == "note: hours since a walk began: 14 (day-turn began 19:00 yesterday, 840 min ago); [walk-gap] no walk began since 19:00 yesterday")
    && ((Comparable) hwb-gp-hours(dusk, after14) == 14)
    && ((String) hwb-gp-note(night, t0 + 6 * hr + 1800000)[0] == "note: hours since a walk began: 7 (scheduled-walk began 03:30 today, 390 min ago)")
    && ((Comparable) hwb-gp-hours(night, t0) == 1) && ((Comparable) hwb-gp-hours(night, t0 + 300000) == 1) && ((Comparable) hwb-gp-hours(night, t0 + hr) == 1) && ((Comparable) hwb-gp-hours(night, t0 + hr + 1) == 2)
    && !hwb-gp-gap?(night, t0 + hwb-hour(10)) && ((Comparable) hwb-gp-hours(night, t0 + hwb-hour(10)) == 10) && hwb-gp-gap?(night, t0 + hwb-hour(10) + 60000) && ((Comparable) hwb-gp-hours(night, t0 + hwb-hour(10) + 60000) == 11)
    && nil?(hwb-gp-note(night, t0 - 1)) && ((Comparable) hwb-gp-hours(night, t0 - 1) == 0) && nil?(hwb-gp-note(nothing(), t0)) && ((Comparable) hwb-gp-hours(nothing(), t0) == 0) && nil?(hwb-gp-note("garbage", t0)) && ((Comparable) hwb-gp-hours("garbage", t0) == 0)
    && ((String) latest == hwb-gp-row("day-turn", t0 + 9 * hr)) && nothing?(hw-slot-latest-of([hwb-root(ctx) ++ "/gp-none.began"])) && ((String) hw-clock-text(hwb-bg-zone(), t0) == "03:30") && ((String) hw-clock-text(hwb-bg-zone(), nothing()) == "an unread hour")
    && ((String) seen == "note: hours since a walk began: 14 (day-turn began 19:00 yesterday, 840 min ago); [walk-gap] no walk began since 19:00 yesterday\n14") && ((String) lone == "0"));
  }
  // ── the split: the parts hold the walk's definitions, and each part is a file the local lane can read whole ──
  // The aggregator (host-walk.bml) imports the parts (`import form-stdlib/bml/host-walk-<seam>.bml;`), holds no definition,
  // and every part stays under hwb-sp-limit bytes: the local lane's window is 16384 positions, and a file it cannot read
  // whole is a file it cannot edit (a day turn once read host-walk.bml six times, each read filling the window); the
  // limit leaves room for two reads of a part (header above).
  def hwb-sp-aggregator() = "form/form-stdlib/bml/host-walk.bml";
  def hwb-sp-pins() = "form/form-stdlib/tests/fixtures/host-walk-defs.txt";
  def hwb-sp-limit() = 12000;
  def hwb-sp-starts?(s, p) = (len(s) >= len(p)) && ((String) substring(s, 0, len(p)) == p);
  // the part files the aggregator imports, as paths from the repo root
  def hwb-sp-part-paths(lines) = nil?(lines) ? [] : hwb-sp-starts?(lines[0], "import form-stdlib/bml/host-walk-") ? cons("form/" ++ substring(trim(lines[0]), 7, len(trim(lines[0])) - 1), hwb-sp-part-paths(lines[1:])) : hwb-sp-part-paths(lines[1:]);
  def hwb-sp-parts() = hwb-sp-part-paths(split-on(read_file(hwb-sp-aggregator()) ?? "", "\n"));
  // the definitions of a text: [name, text] for each `  def name(` line, its text running to the next definition, comment or close
  def hwb-sp-name(line) = substring(line, 6, str_find(line, "(", 6));
  def hwb-sp-ends?(l) = hwb-sp-starts?(l, "  //") || hwb-sp-starts?(l, " }") || hwb-sp-starts?(l, "}") || hwb-sp-starts?(l, "section") || hwb-sp-starts?(l, "import") || hwb-sp-starts?(l, "//") || hwb-sp-starts?(l, " class");
  def hwb-sp-close(cur, out) = nothing?(cur) ? out : cons(cur, out);
  def hwb-sp-scan(lines, cur, out) = nil?(lines) ? hwb-sp-close(cur, out)
   : hwb-sp-starts?(lines[0], "  def ") ? hwb-sp-scan(lines[1:], [hwb-sp-name(lines[0]), lines[0]], hwb-sp-close(cur, out))
   : hwb-sp-ends?(lines[0]) ? hwb-sp-scan(lines[1:], nothing(), hwb-sp-close(cur, out))
   : hwb-sp-scan(lines[1:], nothing?(cur) ? nothing() : [cur[0], cur[1] ++ "\n" ++ lines[0]], out);
  def hwb-sp-defs-of(text) = hwb-sp-scan(split-on(text, "\n"), nothing(), []);
  def hwb-sp-defs(paths) = nil?(paths) ? [] : append(hwb-sp-defs-of(read_file(paths[0]) ?? ""), hwb-sp-defs(paths[1:]));
  // the pinned names: one per line in the fixture, comment lines begin with #
  def hwb-sp-pins-of(lines) = nil?(lines) ? [] : ((Comparable) len(trim(lines[0])) == 0) || hwb-sp-starts?(lines[0], "#") ? hwb-sp-pins-of(lines[1:]) : cons(trim(lines[0]), hwb-sp-pins-of(lines[1:]));
  def hwb-sp-held?(defs, name) = nil?(defs) ? false : ((String) defs[0][0] == name) || hwb-sp-held?(defs[1:], name);
  // the pinned names no part holds, and the names held twice (a duplicate definition name hangs the compiler)
  def hwb-sp-gone(pins, defs) = nil?(pins) ? [] : hwb-sp-held?(defs, pins[0]) ? hwb-sp-gone(pins[1:], defs) : cons(pins[0], hwb-sp-gone(pins[1:], defs));
  def hwb-sp-twice(defs) = nil?(defs) ? [] : hwb-sp-held?(defs[1:], defs[0][0]) ? cons(defs[0][0], hwb-sp-twice(defs[1:])) : hwb-sp-twice(defs[1:]);
  def hwb-sp-said(lines) = nil?(lines) ? 0 : hwb-sp-said-next(print_str(lines[0]), lines[1:]);
  def hwb-sp-said-next(said, rest) = hwb-sp-said(rest);
  def hwb-sp-names-said(what, names) = nil?(names) ? [] : cons("[host-walk-band] split: " ++ what ++ " " ++ names[0], hwb-sp-names-said(what, names[1:]));
  // 2147483648: the parts hold every pinned definition name and hold none twice; a definition added or edited is free (a body
  // is held by the claims of the walk's behaviour), a name dropped or renamed says "gone" until its fixture row is edited
  def hwb-split(ctx) {
   let parts = hwb-sp-parts();
   let defs = hwb-sp-defs(parts);
   let pins = hwb-sp-pins-of(split-on(read_file(hwb-sp-pins()) ?? "", "\n"));
   let gone = hwb-sp-gone(pins, defs);
   let twice = hwb-sp-twice(defs);
   let said = hwb-sp-said(append(hwb-sp-names-said("gone", gone), hwb-sp-names-said("twice", twice)));
   hwb-bit((!nil?(parts)) && (!nil?(defs)) && (!nil?(pins)) && nil?(gone) && nil?(twice));
  }
  def hwb-sp-listed?(path, paths) = nil?(paths) ? false : ((String) paths[0] == path) || hwb-sp-listed?(path, paths[1:]);
  def hwb-sp-oversize(paths) = nil?(paths) ? [] : (file_size(paths[0]) > 0) && (file_size(paths[0]) < hwb-sp-limit()) ? hwb-sp-oversize(paths[1:]) : cons("[host-walk-band] part-size: " ++ paths[0] ++ " reads " ++ file_size(paths[0]).str() ++ " bytes (the limit is " ++ hwb-sp-limit().str() ++ ")", hwb-sp-oversize(paths[1:]));
  def hwb-sp-outside(names, parts) = filter(n => hwb-sp-starts?(n, "host-walk-") && hw-ends?(n, ".bml") && !hwb-sp-listed?("form/form-stdlib/bml/" ++ n, parts), names);
  // 4294967296: every part the aggregator imports reads and is under the limit, the aggregator holds no definition, and no
  // host-walk-*.bml file stands beside it unimported (a part the claim above and this one do not see)
  def hwb-part-size(ctx) {
   let parts = hwb-sp-parts();
   let outside = hwb-sp-outside(fs_list("form/form-stdlib/bml") ?? [], parts);
   let said = hwb-sp-said(append(hwb-sp-oversize(parts), hwb-sp-names-said("unimported", outside)));
   hwb-bit((!nil?(parts)) && nil?(hwb-sp-oversize(parts)) && (file_size(hwb-sp-aggregator()) > 0) && (file_size(hwb-sp-aggregator()) < hwb-sp-limit()) && nil?(hwb-sp-defs-of(read_file(hwb-sp-aggregator()) ?? "")) && nil?(outside));
  }
 }
 let ctx = hwb-fresh();
 nothing?(ctx) ? form_error("host-walk band needs a fresh directory under temp_dir") : 0;
 let verdict = live-claims("host-walk-band", ctx, [["options", 1, 1, hwb-options], ["claims", 2, 1, hwb-claims], ["refuses", 4, 1, hwb-refuses], ["takes-gone", 8, 1, hwb-takes-gone], ["takes-reused", 16, 1, hwb-takes-reused], ["one-taker", 32, 1, hwb-one-taker], ["unowned", 64, 1, hwb-unowned], ["releases", 128, 1, hwb-releases], ["floor", 256, 1, hwb-floor], ["unmeasured", 512, 1, hwb-unmeasured], ["room", 1024, 1, hwb-room], ["turn-lines", 2048, 1, hwb-turn-lines], ["turns", 4096, 1, hwb-turns], ["elsewhere", 8192, 1, hwb-elsewhere], ["yield", 16384, 1, hwb-yield], ["sync", 32768, 1, hwb-sync], ["reviewed", 65536, 1, hwb-reviewed], ["idle", 131072, 1, hwb-idle], ["stale-mark", 262144, 1, hwb-stale-mark], ["publish", 524288, 1, hwb-publish], ["heal", 1048576, 1, hwb-heal], ["sync-rows", 2097152, 1, hwb-sync-rows], ["publish-absent", 4194304, 1, hwb-publish-absent], ["band-after", 8388608, 1, hwb-band-after], ["planned", 16777216, 1, hwb-planned], ["queue-paths", 33554432, 1, hwb-queue-paths], ["spawn", 67108864, 1, hwb-spawn], ["clock", 134217728, 1, hwb-clock], ["sync-lease", 268435456, 1, hwb-sync-lease], ["replanned", 536870912, 1, hwb-replanned], ["memory", 1073741824, 1, hwb-memory], ["split", 2147483648, 1, hwb-split], ["part-size", 4294967296, 1, hwb-part-size], ["sync-drawn", 8589934592, 1, hwb-sync-drawn], ["sync-river", 17179869184, 1, hwb-sync-river], ["sync-wall", 34359738368, 1, hwb-sync-wall], ["sync-rounds", 68719476736, 1, hwb-sync-rounds], ["sync-side", 137438953472, 1, hwb-sync-side], ["sync-gone-bank", 274877906944, 1, hwb-sync-gone-bank], ["sync-loop", 549755813888, 1, hwb-sync-loop], ["began", 1099511627776, 1, hwb-began], ["began-plants", 2199023255552, 1, hwb-began-plants], ["gap", 4398046511104, 1, hwb-gap]]);
 host_dir_rmdir(hwb-root(ctx));
 verdict;
}
