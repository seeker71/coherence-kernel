; host-walk-band.bml — the walk's window, its lock, its turns, its sync, its children, its clock and its publish
; window, with no model; git runs only over a scratch origin under temp_dir.
;
; Verdict 8796093022207 = 1 options | 2 claims | 4 refuses | 8 takes-gone | 16 takes-reused | 32 one-taker | 64 unowned
;   | 128 releases | 256 floor | 512 unmeasured | 1024 room | 2048 turn-lines | 4096 turns | 8192 elsewhere
;   | 16384 yield | 32768 sync | 65536 reviewed | 131072 idle | 262144 stale-mark | 524288 publish
;   | 1048576 heal | 2097152 sync-rows | 4194304 publish-absent | 8388608 band-after | 16777216 planned
;   | 33554432 queue-paths | 67108864 spawn | 134217728 clock | 268435456 sync-lease | 536870912 replanned
;   | 1073741824 memory | 2147483648 split | 4294967296 part-size | 8589934592 sync-drawn | 17179869184 sync-river
;   | 34359738368 sync-wall | 68719476736 sync-rounds | 137438953472 sync-side | 274877906944 sync-gone-bank
;   | 549755813888 sync-loop | 1099511627776 began | 2199023255552 began-plants | 4398046511104 gap
;
; began, began-plants and gap: the slot stamp of form-stdlib/bml/host-walk-began.bml. Each schedule has a retry slot a few
; minutes after its first, so a first start the machine killed at launch is tried again, and the retry must start nothing
; when the first slot began. A door's claim writes its row into .hearth/walk.began (the door, the pid, the unix ms) under
; the lock it holds; a later start of the same door that finds its own row less than 25 minutes old ends with the
; [walk-lock] line "<door> already began at <hh:mm> (a retry slot finds the night begun; ...)", claims no lock and leaves the
; stamp as it was. The checks (began, over synthetic instants and a scratch lock and stamp under temp_dir, no launchctl):
; the claim stamps its slot; the retry ten minutes later is refused with the named line and one millisecond short of the
; window still is, while at exactly the window it runs and stamps; the day turn is another slot (the night's stamp does not
; block it, both rows stand); {"again":1} starts inside the window and stamps the new start; a stamp from yesterday and one
; from the future read no recent start; the lock still excludes a second door while the first holds, and that refused start
; writes no stamp (the stamp marks began, not success). began-plants runs the same checks over four planted begins and holds
; only when each fails them: a begin that never writes the stamp, one that compares the window with the wrong inequality (a
; start exactly the window later is still refused), one that ignores the door name (the night's stamp blocks the day
; turn) and one that ignores the stamp's age (yesterday's blocks). gap is the lens "hours since a walk began" of the land
; cadence (observe/walk-began-run.bml over the same rows): the latest row across the stamp files gives hours counted up (a
; walk that began this hour reads 1, so the cadence's 0 stays no reading), the note names the door and the hour, past ten
; hours it adds "[walk-gap] no walk began since <hh:mm> yesterday", a stamp that did not read says no note and reads 0, a
; row with no time or one from the future is no start, and the door itself, run over a synthetic stamp file, prints the note
; and the hours as its last line (a missing stamp prints 0 alone).
;
; split and part-size: form-stdlib/bml/host-walk.bml is an aggregator that imports its parts (host-walk-<seam>.bml) and holds
; no definition. Each part is a file the local lane can read whole inside its window, so the claim "part-size" holds
; every part the aggregator imports under 12000 bytes, the aggregator free of definitions, and no host-walk-*.bml file in
; form-stdlib/bml standing unimported. The limit is derived: the day option's 13411-ID read of the 38058-byte file read
; 0.352 IDs per byte (waveF critic), so 12000 bytes are about 4.2k IDs and two reads of a part, or one re-read, take about
; 8.5k of the 16384 positions, which leaves the lane's prompt of about 2.4k IDs and its answer room. The claim "split"
; reads the definitions of those parts and holds the names of form-stdlib/tests/fixtures/host-walk-defs.txt: a name
; no part holds ("gone") or one held twice turns it red and the band prints the name. It pins names only: a definition
; the local lane edits or adds changes no fixture row, and its behaviour is held by the other claims of this band.
;
; memory: before a turn the walk asks for the fast-answer weight file when it can be read, else 26 GiB, plus the KV margin (memory-governor.bml),
; waits no later than the window's last moment a turn could begin (until minus the option floor), and a held answer
; says the held line with its reason and ends the window: it takes no turn.
;
; The children (form-stdlib/bml/host-child.bml): a stdin file reaches the child, its stdout and stderr share one file
; (or stderr goes nowhere), the exit is the host's own (a child that exits 3 reads 3), the step's last out file is
; replaced and never appended to, a binary that is not there is nothing at birth (never -1) and leaves its reason in
; the out file, and a child past its deadline is stopped (SIGTERM, then SIGKILL after its grace for one that ignores
; it) and reads nothing with what it had printed kept. The SIGKILL escalation is pinned by time: a child that ignores
; TERM and would sleep a minute is gone within its grace plus a few seconds. A child that ends is noticed within about a
; second of its end (a four second child under a ten minute deadline returns near four seconds). A child's
; descendants among the fkwu kernels are stopped with it (a grandchild kernel the child began is not alive after the
; deadline). The wiring of the walk's turn and plan is pinned: hw-turn-run-of and hw-plan-run-of begin a stub in the
; child's place and the deadline reaching the door is the window's end plus hw-backstop-ms (a stub whose window
; ended hw-backstop-ms less 0.3 s ago is stopped 0.3 s after it begins; a turn passed no deadline would run its
; whole 30 s, one passed the window's end without the backstop would be stopped at once); a plan the door stopped
; answers [local-plan:stopped], and one that queued its gap before it hung answers its result. The readers
; that replaced grep and tail answer the lines they did. The build and the carrier read "fresh" while the product
; is newer than its source, else run the compiler through the child door and put the product in place (a failing
; compiler reads its exit, one never born reads nothing); the push answers its rejection's own line, so a main that
; moved reads as moved. The clock: a POSIX zone footer ("WITA-8", "<+08>-8", "IST-5:30", "UTC0") reads its offset
; east of UTC, a footer with a daylight rule reads nothing (so does one whose hours pass 24, whose minutes or
; seconds pass 59, or whose angle name is empty, and the host_localtime offset is the fallback for all of them), and fixed instants name the day and the hhmm the zone
; puts them on (the 03:30 night and the 12:30 day turn, the midnight rollover, a leap day, a zone west of UTC); the
; host's own reading agrees with `date`.
;
; A turn reads {"turns":24,"deadline_ms":<the window's end on host_monotonic_ms>} on stdin. One walk holds a
; checkout's lock: a fresh claim holds it, a living holder refuses a later start and is named, a gone holder (a
; pid that ended, or a pid the host handed out again after the stamp) is taken over by one start only, a lock that
; names no holder yet refuses for its first minute, and only the holder releases it. A take's mark names its maker:
; a mark whose maker is gone, or one a minute old that names none, is cleared once and the lock taken; a fresh mark
; with no maker yet, and one whose maker lives, refuse and name it. The window's option is the
; median real option of recorded ledger rows (form-stdlib/tests/fixtures/host-walk-ledger.jsonl: ten rows of the
; walk checkout's receipts/native-turn-ledger.jsonl, one of them dry), copied under temp_dir and read back from
; there; with none measured it is half an hour. A turn's lines keep its last row and its walk's verdict, and a turn
; that printed neither is named by its last line that is not an organ-health reading. The turns loop hands each
; turn the window's end, stops at a turn that ran no gap, after an idle turn lands (the band where it was and a
; known 0 local IDs, or no count from a lane refused at rung 0 or never launched, or a row that does not read), at
; its count bound, and when the window is not ready; a lane that crashed wrote no count, its spend is named
; unknown, and the turns go on. Only a turn that ran a gap is reviewed. A turn that found no open gap is planned
; (the planner hears the window's end as until_ms): a plan whose result is queued is turned once more and its line
; follows that turn's, a moot result (the request was already healed) is said and the planner asked for the next
; request, at most four planner walks for a turn that ran no gap (queued after two moots is turned; four moots leave
; "no open gap" standing; a declined result stops at once), any other leaves "no open gap" standing, and a turn that
; ran a gap plans nothing. The planner's last "[host-child]" line (a plan stopped at its backstop, or never born)
; is kept with its row, so a plan that queued its gap and hung is turned and the walk's log says it was stopped. A turn that
; ran no gap but carries a queued plan lands it and ends the turns; one without lands nothing. A queued row lands
; its writable files and its band. Walk doors (and the session learner) in other checkouts are read from host_process rows, never
; this checkout's own, and the yield neither waits when none walks nor when the window holds no option. The sync,
; over a scratch origin whose ledgers merge as a union: a dirty ledger row with main moved follows main and keeps
; the row; a real conflict names its file, holds, and leaves the tree as it was; a rebase refused by an untracked
; file reads dirty, never conflict; a dirty source while main changed the same line reads dirty, and the tree keeps
; its bytes with no stash entry and no unmerged path. Rows that would not merge as a union (a row in a ledger main
; deleted, a row in a ledger git reads as binary) read dirty the same way. The sync's push is a lease: when origin's
; branch moved after the walk last read it, the push is refused (a nonzero exit) and origin keeps the other commit;
; after the walk reads and follows it, the same push goes. The sync settles what the body knows (sync-drawn, sync-river,
; sync-wall, sync-rounds; the reunion's rounds, form-stdlib/bml/form-cli-reunion.bml, are the one settling): a rebase
; that stops on the drawn page (docs/rent-ladder.html) takes main's side, finishes, remakes the page through the redraw
; door (a stub argv here: the page becomes the ledger the rebase joined) and records it as one new commit, with the walk's
; dirty ledger row returned once and the push going under its lease, and says "healed: <paths>" then "redrawn: <pages>"
; before "sync=0"; a river of at_unix_ms rows git does not union (learn/queue.jsonl) is joined by union, each row once in
; the order the rows happened; a conflict in a file the body does not know (mod.bml), even after an earlier round settled
; the page, aborts the rebase, leaves the branch and origin where they stood and names that file alone. A branch of any
; length heals (sync-rounds: two, nine and twenty commits that each conflict on the page): each round is a replayed
; commit, and only a round that comes back with the rebase no further on (same REBASE_HEAD, same files) is held and
; named (sync-loop, over a rebase stopped on the page). The redraw runs in the walk's directory (its stub's paths are
; relative); the side taken for a conflicting page is main's (sync-side: with a redraw that changes nothing the page
; that stands is main's bytes, and a page main deleted, where there is no side to take, is held and named); a river
; main deleted and the walk modified is not raised by the union but held (sync-gone-bank); a row on both banks of a
; river stands once (sync-river). The publish window restores the
; checkpoint when its run answers and when it stops, clears its marker, refuses a moved tree and a marker this pid
; already holds; with the tree as it stands as its checkpoint, a path not there yet publishes, its run sees it, and
; it is gone again after the window, while a candidate that names no text for it leaves it absent. A window reads
; as the band: an answered run its reading, a stopped run nothing, and a refused or empty publish the reading the
; band had before. A killed publish's marker heals its own bytes back, keeps a later writer's bytes and its marker,
; and an unreadable marker goes.
;
; REQUIRES: host_alive, host_process and host_processes, fkwu doors.
; The band writes only under temp_dir and removes what it made.
// preludes: form-stdlib/core.fk form-stdlib/bml/host-walk.bml form-stdlib/model-registry.bml form-stdlib/bml/host-fs.bml
section [form.bml] {
 class HostWalkBand {
  def hwb-root(ctx) = ctx[1];
  def hwb-fixture() = "form/form-stdlib/tests/fixtures/host-walk-ledger.jsonl";
  def hwb-fresh() {
   let root = temp_dir() ++ "/host-walk-band-" ++ now_unix_ms().str();
   (Comparable) host_dir_mkdir(root) == 1 ? ["host-walk", root] : nothing();
  }
  def hwb-lock(ctx, id) = hwb-root(ctx) ++ "/" ++ id ++ ".lock";
  def hwb-has?(s, part) = str_find(s, part, 0) >= 0;
  def hwb-bit(held) = held ? 1 : 0;
  def hwb-self() = host_pid();
  // a pid that ended: a child spawned and waited
  def hwb-gone-pid() {
   let pid = host_spawn_at(["/usr/bin/true"], ["/dev/null", "/dev/null", "/dev/null"]);
   let ended = pid > 0 ? host_wait(pid) : -1;
   (Comparable) host_alive(pid) == 0 ? pid : nothing();
  }
  def hwb-placed(ctx, id, text) {
   let lock = hwb-lock(ctx, id);
   let made = host_dir_mkdir(lock);
   let wrote = write_file_text(hw-owner-path(lock), text);
   lock;
  }
  def hwb-options(ctx) {
   let doc = parse-json("turn-options", hw-turn-options(24, 987654321));
   hwb-bit(((Comparable) json-int-value(json-object-get(doc, "turns")) == 24) && ((Comparable) json-int-value(json-object-get(doc, "deadline_ms")) == 987654321));
  }
  def hwb-claims(ctx) {
   let lock = hwb-lock(ctx, "fresh");
   let claim = hw-claim-at(lock, "scheduled-walk", hwb-self(), now_unix_ms());
   let owner = hw-owner(lock);
   hwb-bit(((Comparable) claim[0] == 1) && hwb-has?(claim[1], "scheduled-walk holds this checkout, pid " ++ hwb-self().str()) && ((Comparable) hw-field(owner, "pid=") == hwb-self()) && ((String) hw-owner-door(owner) == "scheduled-walk"));
  }
  def hwb-refuses(ctx) {
   let lock = hwb-lock(ctx, "held");
   let first = hw-claim-at(lock, "scheduled-walk", hwb-self(), now_unix_ms());
   let before = hw-owner(lock);
   let second = hw-claim-at(lock, "day-turn", 1, now_unix_ms());
   hwb-bit(((Comparable) first[0] == 1) && ((Comparable) second[0] == 0) && hwb-has?(second[1], "day-turn does not start: scheduled-walk (pid " ++ hwb-self().str() ++ ")") && hwb-has?(second[1], "one walk at a time") && ((String) hw-owner(lock) == before));
  }
  def hwb-takes-gone(ctx) {
   let gone = hwb-gone-pid();
   let lock = nothing?(gone) ? "" : hwb-placed(ctx, "gone", hw-owner-text("scheduled-walk", gone, now_unix_ms()));
   let claim = nothing?(gone) ? [0, ""] : hw-claim-at(lock, "day-turn", hwb-self(), now_unix_ms());
   hwb-bit(((Comparable) claim[0] == 1) && hwb-has?(claim[1], "taken over from scheduled-walk pid " ++ gone.str() ++ ", gone") && ((Comparable) hw-field(hw-owner(lock), "pid=") == hwb-self()));
  }
  def hwb-takes-reused(ctx) {
   let lock = hwb-placed(ctx, "reused", hw-owner-text("scheduled-walk", hwb-self(), 1000));
   let claim = hw-claim-at(lock, "day-turn", hwb-self(), now_unix_ms());
   hwb-bit(((Comparable) claim[0] == 1) && hwb-has?(claim[1], "taken over from scheduled-walk pid " ++ hwb-self().str()) && ((String) hw-owner-door(hw-owner(lock)) == "day-turn"));
  }
  def hwb-one-taker(ctx) {
   let gone = hwb-gone-pid();
   let text = nothing?(gone) ? "" : hw-owner-text("scheduled-walk", gone, now_unix_ms());
   let lock = hwb-placed(ctx, "taken", text);
   let mark = nothing?(gone) ? 0 : host_dir_mkdir(lock ++ "/took-" ++ gone.str());
   let claim = hw-claim-at(lock, "day-turn", hwb-self(), now_unix_ms());
   hwb-bit(((Comparable) mark == 1) && ((Comparable) claim[0] == 0) && hwb-has?(claim[1], "another start is taking over the lock") && ((String) hw-owner(lock) == text));
  }
  def hwb-unowned(ctx) {
   let lock = hwb-lock(ctx, "unowned");
   let made = host_dir_mkdir(lock);
   let claim = hw-claim-at(lock, "day-turn", hwb-self(), now_unix_ms());
   hwb-bit(((Comparable) made == 1) && ((Comparable) claim[0] == 0) && hwb-has?(claim[1], "has not named itself yet") && ((String) hw-owner(lock) == ""));
  }
  def hwb-releases(ctx) {
   let lock = hwb-lock(ctx, "release");
   let claim = hw-claim-at(lock, "day-turn", hwb-self(), now_unix_ms());
   let kept = hw-release-at(lock, 1);
   let stood = host_path_is_dir(lock);
   let released = hw-release-at(lock, hwb-self());
   hwb-bit(((Comparable) claim[0] == 1) && hwb-has?(kept, "[walk-lock] kept") && ((Comparable) stood == 1) && ((String) released == "[walk-lock] released") && ((Comparable) host_path_is_dir(lock) == 0));
  }
  // the recorded rows cross the file carrier: copied under temp_dir and read back from there
  def hwb-floor(ctx) {
   let path = hwb-root(ctx) ++ "/native-turn-ledger.jsonl";
   let wrote = write_file_text(path, read_file(hwb-fixture()) ?? "");
   let floor = hw-option-floor-at(path);
   hwb-bit(((Comparable) floor[0] == 1412860) && ((String) floor[1] == "the median of 9 measured"));
  }
  def hwb-unmeasured(ctx) {
   let dry = hwb-root(ctx) ++ "/dry-ledger.jsonl";
   let wrote = write_file_text(dry, split-on(read_file(hwb-fixture()) ?? "", "\n")[0] ++ "\n");
   let none = hw-option-floor-at(hwb-root(ctx) ++ "/no-ledger.jsonl");
   let onlyDry = hw-option-floor-at(dry);
   hwb-bit(((Comparable) none[0] == 1800000) && ((String) none[1] == "no option measured yet") && ((Comparable) onlyDry[0] == 1800000));
  }
  def hwb-room(ctx) {
   let floor = [1412860, "the median of 9 measured"];
   let holds = hw-room-at(5000000 + 1412860, 5000000, floor);
   let short = hw-room-at(5000000 + 1412859, 5000000, floor);
   let past = hw-room-at(4000000, 5000000, floor);
   hwb-bit(holds[0] && (!short[0]) && hwb-has?(short[1], "23 min left cannot hold an option of 23 min (the median of 9 measured): no turn starts") && (!past[0]) && hwb-has?(past[1], "[walk-window] 0 min left"));
  }
  def hwb-rows() = split-on(read_file(hwb-fixture()) ?? "", "\n");
  def hwb-walk-line() = "[native-turn:walk] closure-unit-line declined after 3 option(s); findings carried forward: 3";
  def hwb-turn-out() {
   let rows = hwb-rows();
   "form-organ health {\"organ\":\"live\",\"flow\":\"native-turn\"}\n[native-turn] " ++ rows[8] ++ "\nform-organ health {\"organ\":\"live\"}\n[native-turn] " ++ rows[9] ++ "\n" ++ hwb-walk-line() ++ "\n";
  }
  def hwb-turn-lines(ctx) {
   let kept = hw-turn-lines(hwb-turn-out());
   let none = hw-turn-lines("[native-turn] no open gap\n");
   let silent = hw-turn-lines("fkwu: error: observe/native-turn-run.bml: no such unit\nform-organ health {\"organ\":\"fkwu-compiler\"}\n\n");
   hwb-bit(((String) kept == "[native-turn] " ++ hwb-rows()[9] ++ "\n" ++ hwb-walk-line()) && hw-turned?(kept) && ((String) none == "[native-turn] no open gap") && (!hw-turned?(none)) && ((String) silent == "[native-turn:silent] the turn printed no row; its last line: fkwu: error: observe/native-turn-run.bml: no such unit") && (!hw-turned?(silent)) && ((String) hw-turn-lines(nothing()) == ""));
  }
  // a scripted turn: it ran a gap only when it was handed the window's end, twice, and then found none open
  def hwb-take(until) = (deadline, n) => (Comparable) deadline != until ? "[native-turn] handed the wrong deadline" : n < 2 ? "[native-turn] " ++ hwb-rows()[8] : "[native-turn] no open gap";
  def hwb-ready(until) = [true, "[walk-window] scripted: the window holds an option"];
  def hwb-closed(until) = [false, "[walk-window] scripted: no turn starts"];
  def hwb-turns(ctx) {
   let until = 77777;
   let all = hw-turns(until, nothing(), hwb-ready, hwb-take(until), turn => "[landed] " ++ len(turn).str());
   let bounded = hw-turns(until, 1, hwb-ready, hwb-take(until), turn => "");
   let closed = hw-turns(until, nothing(), hwb-closed, hwb-take(until), turn => "");
   let wrong = hw-turns(until, nothing(), hwb-ready, hwb-take(until + 1), turn => "");
   hwb-bit(((Comparable) all == 2) && ((Comparable) bounded == 1) && ((Comparable) closed == 0) && ((Comparable) wrong == 0));
  }
  def hwb-proc(pid, cwd, argv) = [pid, 1, "/x/fkwu", cwd, argv, 1000, 0];
  def hwb-elsewhere(ctx) {
   let rows = [hwb-proc(11, "/elsewhere", ["./fkwu", "observe/movement-run.bml"]), hwb-proc(12, "/here", ["./fkwu", "observe/native-turn-run.bml"]), hwb-proc(13, "/elsewhere", ["./fkwu", "observe/ear-live-native.fk"]), 3, [14, 1, "/x/fkwu", "/elsewhere"], hwb-proc(15, "", ["./fkwu", "observe/day-turn.bml"]), hwb-proc(16, "/walk", ["/walk/fkwu", "/walk/observe/scheduled-walk.bml"]), hwb-proc(17, "/live", ["./fkwu", "observe/native-session-learning-run.fk"]), hwb-proc(18, "/timing", ["./fkwu", "observe/prompt-lookup-run.bml"])];
   let found = hw-elsewhere-of(rows, "/here");
   let live = hw-elsewhere(hw-here());
   hwb-bit(((Comparable) len(found) == 4) && ((Comparable) found[0][0] == 11) && ((Comparable) found[1][0] == 16) && ((Comparable) found[2][0] == 17) && ((Comparable) found[3][0] == 18) && ((String) hw-door-of(["./fkwu", "observe/prompt-lookup-run.bml"]) == "observe/prompt-lookup-run.bml") &&((String) hw-walk-names([found[0]]) == "observe/movement-run.bml (pid 11) in /elsewhere") && ((Comparable) len(hw-elsewhere-of(live, hw-here())) == len(live)) && ((Comparable) len(hw-elsewhere-of(live, "")) == len(live)));
  }
  def hwb-yield(ctx) {
   let floor = [1412860, "the median of 9 measured"];
   let began = host_monotonic_ms();
   let quiet = hw-yield-with(began + 9000000, here => [], floor);
   let walking = hw-yield-with(began, here => [hwb-proc(11, "/elsewhere", ["./fkwu", "observe/movement-run.bml"])], floor);
   let spent = host_monotonic_ms() - began;
   hwb-bit(((String) quiet == "") && ((String) walking == "[walk-yield] observe/movement-run.bml (pid 11) in /elsewhere still walks, and the window no longer holds an option") && (spent < hw-yield-poll-ms()));
  }
  // ── the sync, over a scratch origin under temp_dir ──
  // A scenario is a list of steps over a base directory, none of them a shell line: ["git", dir, args] runs git there
  // (git -C), ["write", path, text] and ["append", path, text] put bytes in a file, ["mkdir", path] and
  // ["remove", path] make and remove. hwb-steps answers "ready", or the step that failed.
  def hwb-io(ctx) = hwb-root(ctx) ++ "/io";
  def hwb-g(dir, args) = ["git", dir, args];
  def hwb-done(x) = true;
  def hwb-step(ctx, base, step) {
   let kind = (String) step[0];
   let path = base ++ "/" ++ step[1];
   kind == "git" ? hch-ok?(hch-git-in(hwb-io(ctx), path, "band", step[2]))
   : kind == "write" ? hwb-done(write_file_text(path, step[2]))
   : kind == "append" ? hwb-done(fhn-append(path, step[2]))
   : kind == "mkdir" ? ((Comparable) host_dir_mkdir(path) == 1)
   : hwb-done(host_path_remove(path));
  }
  def hwb-steps(ctx, base, steps) = hwb-steps-from(ctx, base, steps, 0);
  def hwb-steps-from(ctx, base, steps, n) = nil?(steps) ? "ready" : hwb-step(ctx, base, steps[0]) ? hwb-steps-from(ctx, base, steps[1:], n + 1) : "failed at step " ++ n.str() ++ ": " ++ steps[0][0] ++ " " ++ steps[0][1];
  def hwb-who(dir, name) = [hwb-g(dir, ["config", "user.email", name ++ "@host"]), hwb-g(dir, ["config", "user.name", name])];
  // the origin, a clone that plays main, and a clone on its own branch "walk"; `files` are written before the base commit
  def hwb-origin(files) = append([hwb-g(".", ["init", "-q", "--bare", "origin.git"]), hwb-g(".", ["clone", "-q", "origin.git", "main"])], append(hwb-who("main", "band"), append([["mkdir", "main/receipts"], ["write", "main/.gitattributes", "receipts/*.jsonl merge=union\n"]], append(files, [hwb-g("main", ["add", "-A"]), hwb-g("main", ["commit", "-q", "-m", "base"]), hwb-g("main", ["branch", "-M", "main"]), hwb-g("main", ["push", "-q", "origin", "main"]), hwb-g(".", ["clone", "-q", "origin.git", "walk"])]))));
