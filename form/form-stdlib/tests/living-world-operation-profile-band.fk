; living-world-operation-profile-band.fk -- opaque evaluator surfaces form
; behavior classes, narrow with experience, and reopen after revocation.
; Verdict 32767 proves fifteen plural-field and lifecycle claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk form-stdlib/living-world-operation-field.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-structural-recipe-witness.fk form-stdlib/tests/living-world-operation-field-witness.fk

(defn lwoepb-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwoepb-sum (tail items)))))

(defn lwoepb-has-carrier? (items carrier)
    (if (eq (len items) 0) 0
        (if (node_eq
                (lwoe-profile-carrier (head items)) carrier) 1
            (lwoepb-has-carrier? (tail items) carrier))))

(do
    (let evolved (lwoew-build-evolved))
    (let base (lwoew-evolved-base evolved))
    (let schema (lwoew-base-schema base))
    (let base-world (lwoew-base-world-cell base))
    (let base-candidate (lwoew-base-candidate base))
    (let base-field (lwoew-base-field base))
    (let base-class
        (head (lwo-field-items (lwoe-field-classes base-field))))
    (let base-members (lwoe-class-profiles base-class))
    (let evolved-world (lwoew-evolved-world evolved))
    (let evolved-candidate (lwoew-evolved-candidate evolved))
    (let evolved-field (lwoew-evolved-field evolved))
    (let evolved-class
        (head (lwo-field-items (lwoe-field-classes evolved-field))))
    (let evolved-members (lwoe-class-profiles evolved-class))
    (let revoked (lwoew-revoked-example-world evolved))
    (let silence-world (lwoew-silence-world base))
    (let silence-field
        (lwoe-field-for silence-world (lwoew-enquiry)
            (lwoew-codecs schema) 2))

    (let c1
        (if (and (eq (lwoe-candidate? base-candidate) 1)
                 (and (eq (lwoe-candidate-current?
                              base-world base-candidate) 1)
                      (eq (lwoe-integrated-current?
                              base-world base-candidate) 1))) 1 0))
    (let c2
        (if (and (eq (lwo-field-size
                         (lwoe-field-examples base-field)) 1)
                 (eq (lwo-field-size
                         (lwoe-field-profiles base-field)) 6)) 2 0))
    (let c3
        (if (and (eq (lwo-field-size
                         (lwoe-field-compatible base-field)) 4)
                 (and (eq (lwo-field-size
                              (lwoe-field-contradicted base-field)) 2)
                      (eq (lwo-field-size
                              (lwoe-field-unresolved base-field)) 0))) 4 0))
    (let c4
        (if (and (eq (lwo-field-size
                         (lwoe-field-classes base-field)) 1)
                 (eq (lwo-field-size base-members) 4)) 8 0))
    (let c5
        (if (and (eq (lwoepb-has-carrier?
                         (lwo-field-items base-members)
                         (lwoew-add-forward schema)) 1)
                 (and (eq (lwoepb-has-carrier?
                              (lwo-field-items base-members)
                              (lwoew-add-reverse schema)) 1)
                      (and (eq (lwoepb-has-carrier?
                                  (lwo-field-items base-members)
                                  (lwoew-mul-forward schema)) 1)
                           (eq (lwoepb-has-carrier?
                                  (lwo-field-items base-members)
                                  (lwoew-mul-reverse schema)) 1)))) 16 0))
    (let c6
        (if (and (eq (len (node_children base-class)) 5)
                 (and (node_eq
                          (lwoe-class-signature base-class)
                          (lwoe-profile-signature
                              (head (lwo-field-items base-members))))
                      (eq (lwph-singular?
                              (lwoe-field-status base-field)) 1))) 32 0))
    (let c7
        (if (and (gt (lwo-field-size
                         (lwoe-field-alternatives base-field)) 0)
                 (and (gt (lwo-field-size
                              (lwoe-field-unknowns base-field)) 0)
                      (and (node_eq
                              (lwoe-field-for base-world (lwoew-enquiry)
                                  (lwoew-codecs schema) 0)
                              (lwo-none))
                           (node_eq
                              (lwoe-proposal base-world (lwoew-enquiry)
                                  (lwoew-codecs schema) 0)
                              (lwo-none))))) 64 0))
    (let c8
        (if (and (eq (lwo-field-size
                         (lwoe-field-examples evolved-field)) 2)
                 (eq (lwo-field-size
                         (lwoe-field-profiles evolved-field)) 6)) 128 0))
    (let c9
        (if (and (eq (lwo-field-size
                         (lwoe-field-compatible evolved-field)) 2)
                 (and (eq (lwo-field-size
                              (lwoe-field-contradicted evolved-field)) 4)
                      (eq (lwo-field-size
                              (lwoe-field-unresolved evolved-field)) 0)))
            256 0))
    (let c10
        (if (and (eq (lwo-field-size
                         (lwoe-field-classes evolved-field)) 1)
                 (and (eq (lwo-field-size evolved-members) 2)
                      (eq (len (node_children
                              (lwoe-class-signature evolved-class))) 2)))
            512 0))
    (let c11
        (if (and (eq (lwoepb-has-carrier?
                         (lwo-field-items evolved-members)
                         (lwoew-add-forward schema)) 1)
                 (and (eq (lwoepb-has-carrier?
                              (lwo-field-items evolved-members)
                              (lwoew-add-reverse schema)) 1)
                      (and (eq (lwph-singular?
                                  (lwoe-field-status evolved-field)) 1)
                           (not (node_eq
                                  base-candidate evolved-candidate)))))
            1024 0))
    (let c12
        (if (and (eq (lwoe-candidate-current?
                         evolved-world evolved-candidate) 1)
                 (and (eq (lwoe-integrated-current?
                              evolved-world evolved-candidate) 1)
                      (eq (lwoe-candidate-current?
                              evolved-world base-candidate) 0))) 2048 0))
    (let c13
        (if (and (eq (lwoe-candidate-current?
                         revoked evolved-candidate) 0)
                 (and (eq (lwoe-candidate-current?
                              revoked base-candidate) 1)
                      (eq (lwoe-answer-current? revoked
                              (lwoew-base-answer base)) 1))) 4096 0))
    (let c14
        (if (and (eq (lwo-field-size
                         (lwoe-field-compatible silence-field)) 0)
                 (and (eq (lwo-field-size
                              (lwoe-field-contradicted silence-field)) 2)
                      (and (eq (lwo-field-size
                                  (lwoe-field-unresolved silence-field)) 4)
                           (and (eq (lwo-field-size
                                      (lwoe-field-classes silence-field)) 0)
                                (eq (lwph-open?
                                      (lwoe-field-status silence-field)) 1)))))
            8192 0))
    (let c15
        (if (and (eq (lwoe-example-valid?
                         (lwoew-silence-example schema)) 1)
                 (and (eq (lwoe-example-valid?
                              (lwoew-zero-example schema)) 1)
                      (and (not (node_eq
                                  (lwoew-silence-example schema)
                                  (lwoew-zero-example schema)))
                           (and (eq (oac-nothing?
                                      (lwoe-example-ack
                                        (lwoew-silence-example schema))) 1)
                                (eq (oac-zero?
                                      (lwoe-example-ack
                                        (lwoew-zero-example schema))) 1)))))
            16384 0))
    (lwoepb-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
