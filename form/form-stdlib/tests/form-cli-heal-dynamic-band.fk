; Expected 63. Cadence adapts; it is not a lifetime bound.
; preludes: form-stdlib/bml/form-cli-heal-dynamic.bml
(sum (list
 (if (str_eq (fhd-action "" 10 100) "continue") 1 0)
 (if (str_eq (fhd-action "" 500 100) "inspect") 2 0)
 (if (str_eq (fhd-action "stop" 0 100) "stop") 4 0)
 (if (gt (fhd-next 0 5000) (fhd-next 0 50)) 8 0)
 (if (str_eq (fhd-action "" 500000 300000) "continue") 16 0)
 (if (eq (fhd-next 500000 300000) 30000) 32 0)))
