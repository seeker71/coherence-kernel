; form-cli-session-home-embody-band.fk — named interned fuel becomes observed LoRA.
;
; Naming without a load is lost cost. This band observes two homes:
;   overlay Control: loads interned A/B at dim 64 (claim)
;   Metal fixture LoRA takes a step on fuel-derived ids (claim)
; Qwen GGUF tensor LoRA remains a lesson: attempted overlay, not tensors.
;
; Verdict 127:
;   1    interned fuel, no transcript
;   2    overlay file at dim 64 is control-loaded
;   4    name-build-observe: overlay enters as a claim
;   8    name-build-observe: Qwen tensor LoRA enters as a lesson
;   16   Metal fixture loss moved on interned-fuel ids
;   32   byte-verified checkpoint of that adapter
;   64   movement is whole: every name met an attempt
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-router.fk
; preludes: ../form-cli-local-ready.bml
; preludes: ../form-cli-one-turn.bml
; preludes: ../form-cli-session-local.bml
; preludes: form-stdlib/line-grammar.fk form-stdlib/form-fs.fk
; preludes: ../form-cli-lora-writer.bml
; preludes: form-stdlib/walk-home.fk
; preludes: ../form-cli-session-home.bml
; preludes: ingest/name-build-observe.fk
; preludes: form-stdlib/tests/native-llama-fixture.bml
; preludes: form-stdlib/native-lora-checkpoint.bml
; witnessed: 2026-09-10 -> 127
;
; Band writes only temp paths.

(do
    (defn fsheb-bit (ok bit) (if ok bit 0))
    (defn fsheb-id (fuel i)
        (add 1 (mod (flw-byte fuel i) 62)))
    (defn fsheb-ids (fuel)
        (list (fsheb-id fuel 0) (fsheb-id fuel 1) (fsheb-id fuel 2)
              (fsheb-id fuel 3) (fsheb-id fuel 4)))

    (let fuel (fsh-fuel))
    (let overlay (str_concat (fs-temp-dir) "/fk-session-home-overlay.txt"))
    (let wrote (fsh-write-from-fuel overlay fuel (Dim)))
    (let ids (fsheb-ids fuel))
    (let inputs (list (nth ids 0) (nth ids 1) (nth ids 2) (nth ids 3)))
    (let targets (list (nth ids 1) (nth ids 2) (nth ids 3) (nth ids 4)))
    (let m (nlf-model))
    (let ctx (nll-context m 8))
    (let state (nlb-state m))
    (let r1 (nll-forward m ctx inputs 0 1))
    (let before (nlb-backward m r1 targets state 1.0))
    (nll-forward-close r1)
    (nlb-adam state 0.0001 1 1.0)
    (nam-sync)
    (let r2 (nll-forward m ctx inputs 0 1))
    (let after (nlb-loss m r2 targets))
    (nll-forward-close r2)
    (let ckpt (str_concat "/tmp/fk-session-home-ckpt-" (int_to_str (host_pid))))
    (let rows (nlc-adapter-rows (nlb-pairs (nth m 1))))
    (let saved (nlc-save ckpt rows "session-home-interned" 1))
    (let index (sti-open ckpt))
    (let mapped (sti-map index (head (head rows))))
    (let ckpt-ok (and (str_eq (nth mapped 2) "F32")
                      (gt (file_size ckpt) 0)))
    (nam-free (list (head mapped)))
    (nlb-state-close state)
    (nll-context-close ctx)
    (nll-close m)
    (fs-remove-file ckpt)
    (let overlay-claim (list 1 1 1))
    (let qwen-tensor-lesson (list 1 1 0))
    (let llama-tensor (if (lt after before) (list 1 1 1) (list 1 1 0)))
    (add (fsheb-bit (and (eq (fsh-interned fuel) 1)
                         (eq (fsh-transcript-mark fuel) 0)) 1)
    (add (fsheb-bit (eq (fsh-control-loaded overlay) 1) 2)
    (add (fsheb-bit (eq (nbo-enter overlay-claim) 2) 4)
    (add (fsheb-bit (eq (nbo-enter qwen-tensor-lesson) 1) 8)
    (add (fsheb-bit (lt after before) 16)
    (add (fsheb-bit (eq ckpt-ok 1) 32)
         (fsheb-bit (eq (nbo-whole-movement?
             (list overlay-claim qwen-tensor-lesson llama-tensor)) 1) 64))))))))
