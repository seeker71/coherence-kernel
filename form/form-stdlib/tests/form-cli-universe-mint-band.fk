; form-cli-universe-mint-band.fk — universe skills mint diverse samples; overlay fits.
;
; Verdict 1023:
;   1..128  fum-check (n, mix, leakage, unique, split, heldout>=6, lora-writer=0, scales)
;   256     class descriptor FormUniverseMint minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-universe-mint-xtal.fk
; witnessed: 2026-08-26 -> 1023; minted heldout 8/8 leakage 0; lora-writer 0

(do
    (defn fumb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn fumb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (fumb-has-name? (tail xs) name))))

    (let bits (fum-check))
    (let desc (FormUniverseMint))
    (let src (read_file "form/form-stdlib/bml/form-cli-universe-mint.bml"))
    (let exe (read_file "form/form-stdlib/form-cli-universe-mint.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormUniverseMint")
                     (and (eq (fumb-has-name? (nth desc 2) "T") 1)
                          (and (eq (fumb-has-name? (nth desc 3) "fum-corpus") 1)
                               (eq (fumb-has-name? (nth desc 4) "MixA") 1))))
                256 0))
    (let b9 (if (and (eq (fumb-has-str? src "package Form.cli.universemint") 1)
                     (and (eq (fumb-has-str? src "interface IUniverseMint") 1)
                          (and (eq (fumb-has-str? src "class FormUniverseMint") 1)
                               (and (eq (fumb-has-str? src "const int MixA") 1)
                                    (and (eq (fumb-has-str? src "template SampleRow") 1)
                                         (and (eq (fumb-has-str? exe "heldout-v3") 0)
                                              (eq (fumb-has-str? exe "turn_started") 0)))))))
                512 0))
    (add bits (add b8 b9)))
