; living-world-scoped-projection-witness.fk -- local numeric views do not
; disturb globally interned scalar attribution histories.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk form-stdlib/living-world-contextual-species.fk form-stdlib/living-world-tissue-prediction.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk form-stdlib/tests/living-world-parameter-tissue-witness.fk

(let LWSCP-SOURCE-A     (bp "LWSCP-SOURCE-A"))
(let LWSCP-SOURCE-B     (bp "LWSCP-SOURCE-B"))
(let LWSCP-PROV-A       (bp "LWSCP-PROV-A"))
(let LWSCP-PROV-B       (bp "LWSCP-PROV-B"))
(let LWSCP-SCOPE        (bp "LWSCP-SCOPE"))
(let LWSCP-ORIGIN       (bp "LWSCP-ORIGIN"))
(let LWSCP-FIELD        (bp "LWSCP-FIELD"))
(let LWSCP-EVIDENCE     (bp "LWSCP-EVIDENCE"))
(let LWSCP-ALTERNATIVE  (bp "LWSCP-ALTERNATIVE"))
(let LWSCP-FLOW         (bp "LWSCP-FLOW"))
(let LWSCP-REASON       (bp "LWSCP-REASON"))

(defn lwscp-cell (kind) (intern_node kind (empty)))
(defn lwscp-source-a () (lwscp-cell LWSCP-SOURCE-A))
(defn lwscp-source-b () (lwscp-cell LWSCP-SOURCE-B))
(defn lwscp-prov-a () (lwscp-cell LWSCP-PROV-A))
(defn lwscp-prov-b () (lwscp-cell LWSCP-PROV-B))
(defn lwscp-scope () (lwscp-cell LWSCP-SCOPE))
(defn lwscp-origin () (lwscp-cell LWSCP-ORIGIN))
(defn lwscp-field () (lwscp-cell LWSCP-FIELD))
(defn lwscp-evidence () (lwscp-cell LWSCP-EVIDENCE))
(defn lwscp-alternative () (lwscp-cell LWSCP-ALTERNATIVE))
(defn lwscp-flow () (lwscp-cell LWSCP-FLOW))
(defn lwscp-reason () (lwscp-cell LWSCP-REASON))

(defn lwscp-entry (source provenance payload)
    (lwtnw-entry source provenance payload))
(defn lwscp-entry-a (payload)
    (lwscp-entry (lwscp-source-a) (lwscp-prov-a) payload))
(defn lwscp-entry-b (payload)
    (lwscp-entry (lwscp-source-b) (lwscp-prov-b) payload))

(defn lwscp-origin-projection ()
    (lwre-projection (lwscp-scope) (lwscp-origin)
        (intern_trivial_int 1)
        (lwo-field (list (lwscp-alternative)))
        (lwlc-unknown (lwscp-evidence)) (lwscp-evidence)))
(defn lwscp-field-projection ()
    (lwre-projection (lwscp-scope) (lwscp-field)
        (intern_trivial_int 3) (lwo-empty-field)
        (lwo-none) (lwscp-evidence)))
(defn lwscp-origin-binding ()
    (lwre-projected-binding "origin"
        (lwscp-origin-projection) (lwscp-evidence)))
(defn lwscp-field-binding ()
    (lwre-projected-binding "field"
        (lwscp-field-projection) (lwscp-evidence)))
(defn lwscp-bindings ()
    (lwre-bindings
        (list (lwscp-origin-binding) (lwscp-field-binding))))

(defn lwscp-world (history)
    (lwt-receive-stream (lwptw-history-world history)
        (list
            (lwscp-entry-a (lwscp-scope))
            (lwscp-entry-b (lwscp-scope))
            (lwscp-entry-a (lwscp-origin))
            (lwscp-entry-b (lwscp-origin))
            (lwscp-entry-a (lwscp-field))
            (lwscp-entry-b (lwscp-field))
            (lwscp-entry-a (lwscp-origin-projection))
            (lwscp-entry-b (lwscp-origin-projection))
            (lwscp-entry-a (lwscp-field-projection))
            (lwscp-entry-b (lwscp-field-projection))
            (lwscp-entry-a (lwscp-origin-binding))
            (lwscp-entry-b (lwscp-origin-binding))
            (lwscp-entry-a (lwscp-field-binding))
            (lwscp-entry-b (lwscp-field-binding)))))

(defn lwscp-trace (world)
    (lwre-execute-bound world (lwptw-declaration-p) (lwptw-lens-p)
        (intern_trivial_int 1) (lwscp-bindings)
        (lwo-field (list (lwscp-alternative)))
        (lwlc-unknown (lwscp-evidence)) (lwo-none)
        (lwscp-flow) (lwo-none) (lwscp-evidence)))

; Adding a new attribution to the raw scalar demonstrates the old global
; coupling.  The scoped trace does not witness that scalar attribution.
(defn lwscp-naive-world (world)
    (lwt-receive-stream world
        (list (lwscp-entry-a (intern_trivial_int 3)))))
(defn lwscp-moved-world (world)
    (lwt-receive-stream world
        (list
            (lwscp-entry-a
                (lwo-revocation (lwscp-field-projection)
                    (lwscp-source-a) (lwscp-reason) (lwscp-prov-a))))))
