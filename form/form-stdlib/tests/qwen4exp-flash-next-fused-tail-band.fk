; qwen4exp-flash-next-fused-tail-band.fk — fusion shape, not adoption.
;
; Verdict 511:
;   1    reference reduction kernel is emitted
;   2    reference shared-gate kernel is emitted
;   4    reference HC-combine kernel is emitted
;   8    fused kernel is emitted
;   16   three dependent dispatches become one
;   32   the measured graph projects 1879 -> 1783 dispatches/token
;   64   recipe composition retains its three abstract operators
;   128  operator family and operation accessors remain structural
;   256  shared-expert gate is scalar in reference and fused kernels
;
; preludes: form-stdlib/core.fk form-stdlib/operator-type-id.bml form-stdlib/qwen4exp-flash-next-fused-tail.bml
; witnessed: 2026-09-02 -> 511; varied physical differential accepted

(do
    (defn qfftb-bit (ok bit) (if ok bit 0))
    (let msl (qfft-msl))
    (let tail-family (oti-family 31 2 10))
    (let recipe (qfft-recipe tail-family 7))
    (let first-op (head (node_children recipe)))
    (sum (list
        (qfftb-bit (ge (str_find msl "kernel void qfft_reference_reduce" 0) 0) 1)
        (qfftb-bit (ge (str_find msl "kernel void qfft_reference_shared" 0) 0) 2)
        (qfftb-bit (ge (str_find msl "kernel void qfft_reference_combine" 0) 0) 4)
        (qfftb-bit (ge (str_find msl "kernel void qfft_fused_tail" 0) 0) 8)
        (qfftb-bit (and (eq (qfft-reference-dispatches) 3)
                         (and (eq (qfft-fused-dispatches) 1)
                              (eq (qfft-saved-dispatches) 2))) 16)
        (qfftb-bit (eq (qfft-project-dispatches 1879 48) 1783) 32)
        (qfftb-bit (and (eq (node_level (node_category recipe)) 2)
                         (and (eq (len (node_children recipe)) 3)
                              (and (node_eq (oti-operator-family recipe) tail-family)
                                   (eq (oti-operation recipe) 7)))) 64)
        (qfftb-bit (and (node_eq (oti-operator-family first-op) tail-family)
                         (eq (oti-operation first-op) 1)) 128)
        (qfftb-bit (and (ge (str_find msl "fexp(-gate[0])" 0) 0)
                         (lt (str_find msl "fexp(-gate[i])" 0) 0)) 256))))
