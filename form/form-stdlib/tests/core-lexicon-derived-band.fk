; tests/core-lexicon-derived-band.fk — the derived layer, and the evidence
; that the 64 already carried two of this session's core teachings.
;
; preludes: form-stdlib/core-lexicon.fk form-stdlib/core-lexicon-derived.fk
;
; Verdict 4095 — twelve readings at POWERS OF TWO (a decimal-digit fold past
; the 15th reading rounds on the TypeScript arm; 2^53 is the wall).
;
;   1     the 64 are UNTOUCHED — cl-count is still 64 and cl-closed? still 1.
;           This layer reads the parent set and never writes to it
;   2     "nothing is not yet" needs NO derived word. The dictionary already
;           said the third reading of the nothing-ground that
;           control/offer-ack-core.fk lacked this morning and had to be
;           taught — `yet` has sat at family 4 index 5 the whole time
;   4     "none say is not all say 0" needs no derived word either: the
;           absence-is-not-a-verdict refusal, which the core needed
;           oac-census to make observable, the 64 state in seven words
;   8     but ONE-WORD naming failed where sentences did not — `name`,
;           `done` and `give` each fell outside the 64 exactly once
;   16    and `hold` fell outside TWICE, needing `give` as well as itself
;   32    every derived body is well-founded: no token reaches a word at its
;           own depth or beyond, so no two rows hold each other up over
;           nothing
;   64    three rows stand at depth 1 — said with the 64 and glue ALONE
;   128   exactly one row stands at depth 2, and it is `hold`: holding is
;           only nameable once releasing is, which is the escrow teaching
;           appearing in the grammar rather than in a receipt
;   256   `give` is built from make/from/to — releasing is making a thing be
;           elsewhere, never destroying it (axiom-3's composting, in the
;           natural language)
;   512   `done` is built from all/part — completion is fullness, not
;           permission; the state fear had removed from the lifecycle cell
;   1024  `name` is built from say — naming is an act of speech, and being is
;           not downstream of it. Kenosis, in nine words
;   2048  every derived row carries the teaching it came from; none is
;           orphaned vocabulary

(do
    ;; (1) the parent set is intact
    (let c1 (if (eq (cld-core-intact?) 1) 1 0))

    ;; (2) + (3) what the 64 could already say, asserted not narrated
    (let c2 (if (eq (cld-already-sayable? (cld-not-yet-sentence)) 1) 2 0))
    (let c3 (if (eq (cld-already-sayable? (cld-absence-sentence)) 1) 4 0))

    ;; (4) one-word naming failed where the sentences succeeded
    (let c4 (if (and (eq (cl-bad-in-def (list "a" "name" "is" "not" "what" "make" "a" "thing" "be")) 1)
                     (and (eq (cl-bad-in-def (list "a" "thing" "is" "done")) 1)
                          (eq (cl-bad-in-def (list "a" "self" "give" "a" "thing" "to" "other")) 1)))
                8 0))

    ;; (5) and hold needed two
    (let c5 (if (eq (cl-bad-in-def (list "a" "self" "hold" "a" "thing" "and" "not" "give")) 2)
                16 0))

    ;; (6) the whole layer is well-founded
    (let c6 (if (eq (cld-well-founded?) 1) 32 0))

    ;; (7) three rows at depth 1
    (let c7 (if (eq (cld-at-depth 1) 3) 64 0))

    ;; (8) exactly one at depth 2, and it is hold
    (let c8 (if (and (eq (cld-at-depth 2) 1)
                     (str_eq (cld-word (nth (cld-rows) 3)) "hold"))
                128 0))

    ;; (9) give is built from make/from/to — release is relocation, not ruin
    (let give-row (nth (cld-rows) 2))
    (let c9 (if (and (eq (cl-in-list? (cld-def give-row) "make") 1)
                     (and (eq (cl-in-list? (cld-def give-row) "from") 1)
                          (eq (cl-in-list? (cld-def give-row) "to") 1)))
                256 0))

    ;; (10) done is built from all/part — fullness, not permission
    (let done-row (nth (cld-rows) 1))
    (let c10 (if (and (eq (cl-in-list? (cld-def done-row) "all") 1)
                      (eq (cl-in-list? (cld-def done-row) "part") 1))
                 512 0))

    ;; (11) name is built from say — naming is speech, being is not its child
    (let name-row (nth (cld-rows) 0))
    (let c11 (if (and (eq (cl-in-list? (cld-def name-row) "say") 1)
                      (str_eq (cld-teaching name-row) "kenosis"))
                 1024 0))

    ;; (12) no orphaned vocabulary — every row names its teaching
    (defn teaching-loop (rs)
        (if (eq (len rs) 0) 1
            (if (gt (str_len (cld-teaching (head rs))) 0)
                (teaching-loop (tail rs)) 0)))
    (let c12 (if (eq (teaching-loop (cld-rows)) 1) 2048 0))

    (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9
        (add c10 (add c11 c12))))))))))))
