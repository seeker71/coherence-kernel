; public-source-concept-shards-band.fk -- pure-small filesystem witness for the
; streamed, resumable public-source concept shard registry.
;
; This band deliberately uses three synthetic public sources.  It observes a
; one-row pause/resume boundary, scannerless title/defn keys, independent typed
; record reconstruction, ambiguity, exact nothing, stale refusal, incremental
; refresh, a streamed 64 KiB source, and the explicit over-budget predicate.
; The live repository percentage is witnessed separately by the live runner.
;
; PROOF LEVEL: FOURTH-ARM ONLY (host filesystem + bounded source SHA-256)
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-fs.fk form-stdlib/file-byte-window.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/form-knowledge-source-search.fk form-stdlib/public-source-concept-index.fk form-stdlib/public-source-concept-shards.fk
;
; Verdict 262143.

(do
    (defn pscishb-root ()
        (fs-path-join (fs-temp-dir) "public-source-concept-shards-band-root"))
    (defn pscishb-artifact ()
        (fs-path-join (fs-temp-dir) "public-source-concept-shards-band-artifact"))
    (defn pscishb-bit (ok bit) (if ok bit 0))
    (defn pscishb-grow (s n)
        (if (le n 0) s (pscishb-grow (str_concat s s) (sub n 1))))
    (defn pscishb-write-sources (root)
        (do
            (let _b (fs-mkdir (fs-path-join root "bootstrap")))
            (let _d (fs-mkdir (fs-path-join root "docs")))
            (let _a (fs-write-text (fs-path-join root "bootstrap/alpha.fk")
                "; Shared Stream Title\n(do (defn alpha-thought () 0) 0)\n"))
            (let _c (fs-write-text (fs-path-join root "bootstrap/beta.fk")
                "; Shared Stream Title\n(do (defn beta-thought () 1) 1)\n"))
            (let _o (fs-write-text (fs-path-join root "docs/streamed-large.md")
                (pscishb-grow "x" 16)))
            1))
    (defn pscishb-validate-to-done (root artifact family fuel)
        (do
            (let state (pscish-validate-batch-at root artifact family fuel))
            (if (eq (nth state 7) 1) state
                (pscishb-validate-to-done root artifact family fuel))))

    (defn public-source-concept-shards-band ()
        (do
            (let root (pscishb-root))
            (let artifact (pscishb-artifact))
            (let _old-root (fs-remove-tree root))
            (let _old-artifact (fs-remove-tree artifact))
            (let _root (fs-mkdir root))
            (let _artifact (fs-mkdir artifact))
            (let _sources (pscishb-write-sources root))

            (let planned-bootstrap
                (pscish-init-family-at root artifact "bootstrap"))
            (let held (pscish-build-batch-at root artifact "bootstrap" 1))
            (let resumed (pscish-build-batch-at root artifact "bootstrap" 32))
            (let planned-docs (pscish-init-family-at root artifact "docs"))
            (let docs-built (pscish-build-batch-at root artifact "docs" 32))

            (let _reset-bootstrap
                (pscish-reset-validation-at artifact "bootstrap"))
            (let validated-bootstrap
                (pscishb-validate-to-done root artifact "bootstrap" 1))
            (let _reset-docs (pscish-reset-validation-at artifact "docs"))
            (let validated-docs
                (pscishb-validate-to-done root artifact "docs" 1))

            (let alpha-path "bootstrap/alpha.fk")
            (let alpha-artifact (pscish-entry-artifact-path artifact
                "bootstrap" alpha-path))
            (let alpha-record
                (pscish-parse-entry (fs-read-text alpha-artifact)))
            (let alpha-hit
                (pscish-lookup-at root artifact "defn-alpha-thought"))
            (let beta-hit
                (pscish-lookup-at root artifact "defn-beta-thought"))
            (let shared
                (pscish-lookup-at root artifact "title-shared-stream-title"))
            (let unknown
                (pscish-lookup-at root artifact "concept-not-born-here"))
            (let report (pscish-report-at root artifact))

            ; Mutation ages exactly one content address.  Lookup withholds the
            ; held record until the same source coordinate is incrementally
            ; refreshed; no second row is appended.
            (let _mutate (fs-write-text (fs-path-join root alpha-path)
                "; Alpha Refined Title\n(do (defn alpha-thought () 0) 0)\n"))
            (let stale
                (pscish-lookup-at root artifact "defn-alpha-thought"))
            (let refreshed
                (pscish-upsert-source-at root artifact "bootstrap" alpha-path))
            (let current
                (pscish-lookup-at root artifact "defn-alpha-thought"))
            (let refreshed-record
                (pscish-parse-entry (fs-read-text alpha-artifact)))

            ; A removed-path artifact cannot survive a family replan.  The
            ; replacement build must then reconstruct both legitimate rows.
            (let ghost-path "bootstrap/removed.fk")
            (let _ghost-dirs (pscish-ensure-artifact-dirs artifact
                "bootstrap" ghost-path))
            (let ghost-artifact (pscish-entry-artifact-path artifact
                "bootstrap" ghost-path))
            (let _ghost-write (fs-write-text ghost-artifact
                (pscish-render-entry (psci-entry
                    (psci-source-node "bootstrap" ghost-path
                        (pscish-record-source-id refreshed-record)
                        (pscish-record-size refreshed-record))
                    (list (pscish-unique-key "bootstrap" ghost-path))))))
            (let ghost-count (pscish-entry-artifact-count-at
                artifact "bootstrap"))
            (let replanned (pscish-init-family-at root artifact "bootstrap"))
            (let ghost-gone (if (lt (fs-stat-size ghost-artifact) 0) 1 0))
            (let rebuilt (pscish-build-batch-at root artifact "bootstrap" 32))
            (let rebuilt-count (pscish-entry-artifact-count-at
                artifact "bootstrap"))

            (let score (sum (list
                (pscishb-bit (and (eq planned-bootstrap 2)
                    (and (eq planned-docs 1)
                    (and (eq replanned 2)
                    (and (eq ghost-count 3)
                    (and (eq ghost-gone 1)
                    (and (eq rebuilt-count 2)
                         (eq (nth rebuilt 3) 2))))))) 1)
                (pscishb-bit (and (eq (nth held 3) 1)
                    (eq (nth held 7) 0)) 2)
                (pscishb-bit (and (eq (nth resumed 3) 2)
                    (eq (nth resumed 7) 1)) 4)
                (pscishb-bit (and (eq (nth docs-built 3) 1)
                    (and (eq (nth docs-built 4) 0)
                         (eq (nth docs-built 7) 1))) 8)
                (pscishb-bit (and (eq (nth validated-bootstrap 2) 2)
                    (and (eq (nth validated-bootstrap 3) 2)
                         (eq (nth validated-bootstrap 7) 1))) 16)
                (pscishb-bit (and (eq (nth validated-docs 2) 1)
                    (and (eq (nth validated-docs 3) 1)
                         (eq (nth validated-docs 7) 1))) 32)
                (pscishb-bit (and (eq (len alpha-record) 13)
                    (and (str_eq (pscish-record-path alpha-record) alpha-path)
                         (eq (psci-source-id-valid?
                            (pscish-record-source-id alpha-record)) 1))) 64)
                (pscishb-bit (and
                    (eq (str_len (pscish-record-source-content-key alpha-record)) 64)
                    (eq (str_len (pscish-record-entry-content-key alpha-record)) 64)) 128)
                (pscishb-bit (and (str_eq (pscish-lookup-status alpha-hit) "hit")
                    (str_eq (pscish-lookup-path alpha-hit) alpha-path)) 256)
                (pscishb-bit (and (str_eq (pscish-lookup-status beta-hit) "hit")
                    (str_eq (pscish-lookup-family beta-hit) "bootstrap")) 512)
                (pscishb-bit (and (str_eq (pscish-lookup-status shared) "nothing")
                    (and (str_eq (pscish-lookup-reason shared)
                            "ambiguous-concept-key")
                         (eq (pscish-lookup-match-count shared) 2))) 1024)
                (pscishb-bit (and (str_eq (pscish-lookup-status unknown) "nothing")
                    (str_eq (pscish-lookup-reason unknown)
                        "concept-not-registered")) 2048)
                (pscishb-bit (and (eq (pscish-report-denominator report) 3)
                    (and (eq (pscish-report-indexed report) 3)
                    (and (eq (pscish-report-current report) 3)
                         (eq (pscish-report-over-budget report) 0)))) 4096)
                (pscishb-bit (and (eq (pscish-report-retrieval-percent report) 100)
                    (and (eq (pscish-report-threshold95? report) 1)
                    (and (eq (pscish-source-over-budget?
                                (add (pscish-max-source-bytes) 1)) 1)
                         (eq (pscish-report-model-executed? report) 0)))) 8192)
                (pscishb-bit (and (str_eq (pscish-lookup-status stale) "nothing")
                    (and (str_eq (pscish-lookup-reason stale)
                            "source-rebuild-needed")
                         (eq (pscish-lookup-rebuild? stale) 1))) 16384)
                (pscishb-bit (and (eq (nth refreshed 0) 1)
                    (eq (nth refreshed 1) 0)) 32768)
                (pscishb-bit (and (str_eq (pscish-lookup-status current) "hit")
                    (and (eq (pscish-lookup-fresh? current) 1)
                         (eq (pscish-lookup-rebuild? current) 0))) 65536)
                (pscishb-bit (and (eq (len refreshed-record) 13)
                    (and (not (str_eq (pscish-record-source-id alpha-record)
                                      (pscish-record-source-id refreshed-record)))
                         (str_eq (pscish-record-path refreshed-record)
                                 alpha-path))) 131072))))
            (let _clean-artifact (fs-remove-tree artifact))
            (let _clean-root (fs-remove-tree root))
            score))
    (public-source-concept-shards-band))
