; form-cli-one-door-band.bml — an ordinary form-cli enquiry through S1: receipts ranked by what they hold, keys that stay honest, a reply bound, one report row, a way out.
;
; A fixture corpus in a scratch directory; no model is asked (the enquiry is held by a named lane, or asked with oracle 0).
;
; Expected: 255
; Verdict 255 when every claim lands:
;   1   content ranks: a receipt whose name carries no term and whose text holds them comes before one holding fewer, a capitalized term counts, and a receipt holding none is not offered
;   2   weight: a term few receipts hold outranks one all of them hold, whatever the date
;   4   keys: each key the answer used is written back as its path, the floor counts those that exist, and a key the packet never gave is counted apart and never counted cited
;   8   the packet offers a key beside each opening and asks for citation by key
;   16  terms are the enquiry's own words of four letters or more, once each, capped; the bound grows with the enquiry and stops at its most
;   32  one report row per enquiry: door S1, via form-cli-ask, a pinned enquiry by its path and any other by its digest, its words nowhere in the row
;   64  a held answer comes through fgs-answer with its lane, asking no model, and lands one coverage row
;   128 form-cli's ordinary ask names fgs-answer and fgs-land in code, and ask-lanes is the named way out to fc-session-ask-at
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/form-cli-grounded-synthesis.bml form-stdlib/form-fs.fk form-stdlib/bml/exit-proof.bml
section [form.bml] {
 class OneDoorBand {
  def odb-dir() = ".hearth/one-door-band";
  def odb-has?(hay, needle) = str_find(hay, needle, 0) >= 0;
  def odb-write(name, text) { let w = write_file_text(odb-dir() ++ "/" ++ name, text); odb-dir() ++ "/" ++ name; }
  def odb-corpus() {
   let a = odb-write("2026-01-01-plain.md", "The ledger keeps Sovereignty and trust and a rare gemstone word.\n");
   let b = odb-write("2026-09-09-trust.md", "Only the one word here: trust.\n");
   let c = odb-write("2026-10-10-none.md", "Nothing of the kind.\n");
   ["2026-01-01-plain.md", "2026-09-09-trust.md", "2026-10-10-none.md"];
  }
  def odb-rows(terms) = fgs-rank(map(n => odb-dir() ++ "/" ++ n, odb-corpus()), terms);
  def odb-top(rows) = fgs-top(rows, 8);
  def odb-c-content(ctx) {
   let top = odb-top(odb-rows(["sovereignty", "trust"]));
   (Comparable) len(top) == 2 && odb-has?(top[0][1], "2026-01-01-plain.md") && (Comparable) top[0][2] == 2 && odb-has?(top[1][1], "2026-09-09-trust.md");
  }
  def odb-c-weight(ctx) {
   let top = odb-top(odb-rows(["trust", "gemstone"]));
   odb-has?(top[0][1], "2026-01-01-plain.md") && (fgs-weight(map(n => [n, fgs-hay(odb-dir() ++ "/" ++ n)], odb-corpus()), "gemstone")[1] > fgs-weight(map(n => [n, fgs-hay(odb-dir() ++ "/" ++ n)], odb-corpus()), "trust")[1]);
  }
  def odb-c-keys(ctx) {
   let real = "receipts/2026-09-18-direct-vs-guided-form-cli.md";
   let keyed = fgs-keyed([[0, real, 1], [0, "receipts/2026-01-01-gone.md", 1]]);
   let text = "A point [R1] and a point [R2], and an invented one [R9].";
   let expanded = fgs-expand(text, keyed);
   let floor = apc-floor(expanded);
   (Comparable) fgs-keys-used(text, keyed) == 2 && (Comparable) fgs-keys-unknown(expanded) == 1 && odb-has?(expanded, real) && (Comparable) floor[1] == 2 && (Comparable) floor[2] == 1;
  }
  def odb-c-packet(ctx) {
   let packet = fgs-packet("Q", "e", "--- [R1] receipts/x.md (terms matched: 1)\nopening\n");
   odb-has?(packet, "--- [R1] receipts/x.md") && odb-has?(packet, "Cite by key, as [R1]") && odb-has?(packet, "opening");
  }
  def odb-c-terms(ctx) {
   let terms = fgs-terms-of("How is the Trust, and the trust of an ox and sovereignty?");
   (String) terms == "trust sovereignty" && (Comparable) fgs-bound-of("short") == fgs-bound-least() + 15 && (Comparable) fgs-bound-of(substring(read_file("docs/rent-to-zero-goal.form"), 0, 4000)) == fgs-bound-most() && (Comparable) len(split-on(fgs-terms-of("aaaa bbbb cccc dddd eeee ffff gggg hhhh iiii jjjj kkkk llll mmmm nnnn oooo pppp qqqq rrrr ssss tttt uuuu vvvv wwww xxxx yyyy zzzz"), " ")) == fgs-term-most();
  }
  def odb-report() = json-node-object([fhn-s("source", "fkwu-model-session"), fhn-s("oracle", "answered"), fhn-s("answer", odb-dir() ++ "/answer.md"), fhn-s("evidence", "x"), fhn-n("citation_keys_offered", 8), fhn-n("citation_keys_used", 6), fhn-n("citation_keys_unknown", 1)]);
  def odb-c-row(ctx) {
   let words = "a sentence the row must not hold";
   let w = odb-write("answer.md", "text\n");
   let plain = fgs-ask-request(words, "", "");
   let pinned = fgs-ask-request(fgs-one-line(read_file(fgs-pinned())), "", "");
   let a = fgs-land-at(odb-dir() ++ "/rent.jsonl", plain, odb-report());
   let b = fgs-land-at(odb-dir() ++ "/rent.jsonl", pinned, odb-report());
   let text = read_file(odb-dir() ++ "/rent.jsonl") ?? "";
   let rows = fcgp-rows-of(text);
   (Comparable) len(rows) == 2 && !odb-has?(text, words) && ep-starts?(fcgp-str(rows[0], "enquiry"), "sha256:") && (String) fcgp-str(rows[1], "enquiry") == fgs-pinned() && ep-starts?(fcgp-str(rows[1], "movement"), "S1 pinned ") && (String) fcgp-str(rows[0], "door") == "S1" && (String) fcgp-str(rows[0], "via") == "form-cli-ask" && (Comparable) fcgp-num(rows[0], "citation_keys_offered") == 8 && (Comparable) fcgp-num(rows[0], "citation_keys_unknown") == 1;
  }
  def odb-c-held(ctx) {
   let coverage = odb-dir() ++ "/coverage.jsonl";
   let report = fgs-answer(json-node-object(append(json-object-pairs(fgs-ask-request("What is held here?", "a held answer", "fkwu-rag-grounded")), [fhn-s("coverage_ledger", coverage)])));
   let text = fgs-ask-text(report);
   let rows = fcgp-rows(coverage);
   let swept = fs-remove-tree(fhn-text(report, "evidence"));
   (String) fhn-text(report, "source") == "form-cli-ask" && (String) fhn-text(report, "oracle") == "answered" && (Comparable) fhn-count(report, "oracle_tokens_predicted") == 0 && odb-has?(text, "a held answer") && odb-has?(text, "local-lane:fkwu-rag-grounded") && (Comparable) len(rows) == 1 && (String) fcgp-str(rows[0], "lane") == "fkwu-rag-grounded";
  }
  def odb-c-door(ctx) {
   let code = ep-code-of(read_file("form/form-stdlib/form-cli.fk"));
   let repl = ep-code-of(read_file("form/form-stdlib/form-cli-repl.fk"));
   odb-has?(code, "let report = fgs-answer(request);") && odb-has?(code, "fgs-land(request, report)") && odb-has?(code, "\"ask-lanes\" ? fc-ask-lanes(fc-arg(cmd))") && odb-has?(code, "def fc-ask-lanes(question) = fc-session-ask-at(") && odb-has?(repl, "(String) fc-verb(line) == \"ask\" ? fc-repl-ask(query, asked)") && odb-has?(repl, "fc-s1-ask(asked, held,");
  }
  def odb-run() {
   let swept = fs-remove-tree(odb-dir());
   let m = hch-mkdirs(odb-dir());
   let verdict = live-claims("form-cli-one-door-band", [], [["content", 1, 1, odb-c-content], ["weight", 2, 1, odb-c-weight], ["keys", 4, 1, odb-c-keys], ["packet", 8, 1, odb-c-packet], ["terms", 16, 1, odb-c-terms], ["row", 32, 1, odb-c-row], ["held", 64, 1, odb-c-held], ["door", 128, 1, odb-c-door]]);
   let cleaned = fs-remove-tree(odb-dir());
   verdict;
  }
 }
 odb-run();
}
