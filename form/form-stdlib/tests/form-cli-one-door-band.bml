; form-cli-one-door-band.bml — an ordinary form-cli enquiry through S1: receipts ranked by what they hold, keys that stay honest, a reply bound, one report row, a way out.
;
; A fixture corpus in a scratch directory; no model is asked (the enquiry is held by a named lane, or asked with oracle 0).
;
; Expected: 2047
; Verdict 2047 when every claim lands:
;   1   content ranks: a receipt whose name carries no term and whose text holds them comes before one holding fewer, a capitalized term counts, and a receipt holding none is not offered
;   2   weight: a term few receipts hold outranks one all of them hold, whatever the date
;   4   keys: each key the answer used is written back as its path, the floor counts those that exist, and a key the packet never gave is counted apart and never counted cited
;   8   the packet offers a key beside each opening and asks for citation by key
;   16  retrieval terms are the enquiry's own normalized words of four bytes or more, once each, with no count cutoff; ordinary asks invent no reply cutoff
;   32  one report row per enquiry: door S1, via form-cli-ask, a pinned enquiry by its path and any other by its digest, its words nowhere in the row
;   64  a held answer comes through fgs-answer with its lane, asking no model, and lands one coverage row
;   128 form-cli's ordinary ask names fgs-answer and fgs-land in code, and ask-lanes is the named way out, to fc-session-ask-at at the verb and the token-eval lane at the session
;   256 a lane's hit stops an enquiry of any shape up to the short bound, and neither door asks for a question's shape: the canonical lookup is no question, the pinned enquiry stays past the bound
;   512 short and non-Latin enquiries keep their exact bytes and reach ask without lexical shape or retrieval admission rules; a caller selecting no oracle is honored and lands its coverage row
;   1024 a matching resident can answer; its failure or an incompatible model offers unchanged context to native admission even while it stands; served partial text and provenance remain truthful; ranked receipts carry their densest lines
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/form-cli-grounded-synthesis.bml form-stdlib/form-fs.fk form-stdlib/bml/exit-proof.bml form-stdlib/form-cli.fk
section [form.bml] {
 class OneDoorBand {
  def odb-dir() = ".hearth/one-door-band";
  def odb-has?(hay, needle) = str_find(hay, needle, 0) >= 0;
  def odb-write(name, text) { let w = write_file_text(odb-dir() ++ "/" ++ name, text); odb-dir() ++ "/" ++ name; }
  def odb-corpus() {
   let a = odb-write("2026-01-01-plain.md", "The ledger keeps Sovereignty and trust and a rare gemstone word.\n");
   let b = odb-write("2026-09-09-trust.md", "Only the one word here: trust.\n");
   let c = odb-write("2026-10-10-none.md", "Nothing of the kind.\n");
   ["2026-01-01-plain.md", "2026-09-09-trust.md", "2026-10-10-none.md"];
  }
  def odb-rows(terms) = fgs-rank(map(n => odb-dir() ++ "/" ++ n, odb-corpus()), terms);
  def odb-top(rows) = fgs-top(rows, 8);
  def odb-c-content(ctx) {
   let top = odb-top(odb-rows(["sovereignty", "trust"]));
   (Comparable) len(top) == 2 && odb-has?(top[0][1], "2026-01-01-plain.md") && (Comparable) top[0][2] == 2 && odb-has?(top[1][1], "2026-09-09-trust.md");
  }
  def odb-c-weight(ctx) {
   let top = odb-top(odb-rows(["trust", "gemstone"]));
   odb-has?(top[0][1], "2026-01-01-plain.md") && (fgs-weight(map(n => [n, fgs-hay(odb-dir() ++ "/" ++ n)], odb-corpus()), "gemstone")[1] > fgs-weight(map(n => [n, fgs-hay(odb-dir() ++ "/" ++ n)], odb-corpus()), "trust")[1]);
  }
  def odb-c-keys(ctx) {
   let real = "receipts/2026-09-18-direct-vs-guided-form-cli.md";
   let keyed = fgs-keyed([[0, real, 1], [0, "receipts/2026-01-01-gone.md", 1]]);
   let text = "A point [R1] and a point [R2], and an invented one [R9].";
   let expanded = fgs-expand(text, keyed);
   let floor = apc-floor(expanded);
   (Comparable) fgs-keys-used(text, keyed) == 2 && (Comparable) fgs-keys-unknown(expanded) == 1 && odb-has?(expanded, real) && (Comparable) floor[1] == 2 && (Comparable) floor[2] == 1;
  }
  def odb-c-packet(ctx) {
   let packet = fgs-packet("Q", "e", "--- [R1] receipts/x.md (terms matched: 1)\nopening\n");
   let provider=fgs-provider-packet("Q","e","opening");
   let empty=fgs-packet("Q","e","");
   odb-has?(packet, "--- [R1] receipts/x.md") && odb-has?(packet, "Cite only an offered key") && !odb-has?(packet,"No receipt keys are offered") && odb-has?(empty,"No receipt keys are offered") && !odb-has?(empty,"[R1]") && odb-has?(packet, "opening") && odb-has?(packet,ftg-teaching()) && odb-has?(packet,"read_file") && !odb-has?(packet,"This turn has no tools") && odb-has?(provider,"This turn has no tools and no file access") && !odb-has?(provider,"<|form:eval|>");
  }
  def odb-c-terms(ctx) {
   let terms = fgs-terms-of("How is the Trust, and the trust of an ox and sovereignty?");
   (String) terms == "trust sovereignty" && !json-object-has?(fgs-ask-request("short","",""),"reply_budget") && !json-object-has?(fgs-ask-request(substring(read_file("docs/rent-to-zero-goal.form"),0,4000),"",""),"reply_budget") && (Comparable) len(split-on(fgs-terms-of("aaaa bbbb cccc dddd eeee ffff gggg hhhh iiii jjjj kkkk llll mmmm nnnn oooo pppp qqqq rrrr ssss tttt uuuu vvvv wwww xxxx yyyy zzzz"), " ")) == 26;
  }
  def odb-report() = json-node-object([fhn-s("source", "fkwu-model-session"), fhn-s("oracle", "answered"), fhn-s("answer", odb-dir() ++ "/answer.md"), fhn-s("evidence", "x"), fhn-n("citation_keys_offered", 8), fhn-n("citation_keys_used", 6), fhn-n("citation_keys_unknown", 1)]);
  def odb-c-row(ctx) {
   let words = "a sentence the row must not hold";
   let w = odb-write("answer.md", "text\n");
   let plain = fgs-ask-request(words, "", "");
   let pinned = fgs-ask-request(fgs-one-line(read_file(fgs-pinned())), "", "");
   let a = fgs-land-at(odb-dir() ++ "/rent.jsonl", plain, odb-report());
   let b = fgs-land-at(odb-dir() ++ "/rent.jsonl", pinned, odb-report());
   let text = read_file(odb-dir() ++ "/rent.jsonl") ?? "";
   let rows = fcgp-rows-of(text);
   (Comparable) len(rows) == 2 && !odb-has?(text, words) && ep-starts?(fcgp-str(rows[0], "enquiry"), "sha256:") && (String) fcgp-str(rows[1], "enquiry") == fgs-pinned() && ep-starts?(fcgp-str(rows[1], "movement"), "S1 pinned ") && (String) fcgp-str(rows[0], "door") == "S1" && (String) fcgp-str(rows[0], "via") == "form-cli-ask" && (Comparable) fcgp-num(rows[0], "citation_keys_offered") == 8 && (Comparable) fcgp-num(rows[0], "citation_keys_unknown") == 1;
  }
  def odb-c-held(ctx) {
   let coverage = odb-dir() ++ "/coverage.jsonl";
   let report = fgs-answer(json-node-object(append(json-object-pairs(fgs-ask-request("What is held here?", "a held answer", "fkwu-rag-grounded")), [fhn-s("coverage_ledger", coverage)])));
   let text = fgs-ask-text(report);
   let rows = fcgp-rows(coverage);
   let swept = fs-remove-tree(fhn-text(report, "evidence"));
   (String) fhn-text(report, "source") == "form-cli-ask" && (String) fhn-text(report, "oracle") == "answered" && (Comparable) fhn-count(report, "oracle_tokens_predicted") == 0 && odb-has?(text, "a held answer") && odb-has?(text, "local-lane:fkwu-rag-grounded") && (Comparable) len(rows) == 1 && (String) fcgp-str(rows[0], "lane") == "fkwu-rag-grounded";
  }
  def odb-c-door(ctx) {
   let code = ep-code-of(read_file("form/form-stdlib/form-cli.fk"));
   let repl = ep-code-of(read_file("form/form-stdlib/form-cli-repl.fk"));
   odb-has?(code, "let report = fgs-answer(request);") && odb-has?(code, "fgs-land(request, report)") && odb-has?(code, "\"ask-lanes\" ? fc-ask-lanes(fc-arg(cmd))") && odb-has?(code, "def fc-ask-lanes(question) = fc-session-ask-at(") && odb-has?(repl, "(String) fc-verb(line) == \"ask\" ? fc-repl-ask(query, asked)") && odb-has?(repl, "fc-s1-ask(asked, held,");
  }
  def odb-c-shape(ctx) {
   let code = ep-code-of(read_file("form/form-stdlib/form-cli.fk"));
   let repl = ep-code-of(read_file("form/form-stdlib/form-cli-repl.fk"));
   fgs-short?("agent operating canon") && !fgs-short?(fgs-one-line(read_file(fgs-pinned()))) && (Comparable) fgs-question?("agent operating canon") == 0
   && odb-has?(code, "def fc-held-lane(question) = !fgs-short?(question)") && odb-has?(repl, "|| !fgs-short?(asked) ? \"\" : answer") && odb-has?(repl, "(String) v == \"ask\" || (String) v == \"ask-lanes\"") && !odb-has?(code ++ repl, "fgs-question?");
  }
  def odb-asked(words, extra, ledger) {
   let request = fgs-ask-request(words, "", "");
   let report = fgs-answer(json-node-object(append(json-object-pairs(request), append([fhn-s("coverage_ledger", odb-dir() ++ "/" ++ ledger)], extra))));
   [report, fgs-ask-text(report), fcgp-rows(odb-dir() ++ "/" ++ ledger)];
  }
  def odb-c-unterm(ctx) {
   let questions = ["你好", "是", "こんにちは？", "مرحبا", "hello", "2+2", "no", "trust"];
   let admitted = all?(question => {
    let request = fgs-ask-request(question,"","");
    fc-free?(question) && fhn-text(request,"enquiry") == question && !json-object-has?(request,"voice_state");
   },questions);
   let got = odb-asked("2+2", [fhn-n("oracle",0)], "unterm.jsonl");
   let swept = fs-remove-tree(fhn-text(got[0], "evidence"));
   ep-starts?(fgs-spool(temp_dir() ++ "/no-such-body"), temp_dir()) && odb-has?(fgs-spool(fhn-root()), ".form-heal")
   && admitted && !fc-free?(" \t") && fc-respond("ping") == "pong" && (String) fhn-text(got[0], "oracle") == "not-asked" && (String) fhn-text(got[0], "source") == "none" && odb-has?(got[1], "caller-selected-no-local-generation") && (Comparable) len(got[2]) == 1;
  }
  def odb-native(state,packet,request) {
   record_set(state,"called",record_get(state,"called") + 1);
   record_set(state,"packet",packet); record_set(state,"request",request);
   ["answered","owned fixture answer",0,0,"fixture-native",1,1,"","owned fixture answer",[],""];
  }
  def odb-server-source(dir,mode) = str-join-with([
   "import form-stdlib/bml/serve-client.bml;",
   "import form-stdlib/bml/retry.bml;",
   "section [form.bml] {",
   " let dir=" ++ json-emit(json-node-string(dir)) ++ ";",
   " let mode=" ++ json-emit(json-node-string(mode)) ++ ";",
   " host_dir_mkdir(dir ++ \"/req\"); host_dir_mkdir(dir ++ \"/reply\");",
   " write_file(dir ++ \"/status.json\",json-emit(json-node-object([svs-n(\"pid\",host_pid()),svs-n(\"start\",host_process(host_pid())[5]),svs-s(\"label\",\"fixture qwen-test\")])));",
   " let ready=wait-until(()=>len(host_dir_list(dir ++ \"/req\") ?? [])>0,host_monotonic_ms()+15000,10);",
   " let files=host_dir_list(dir ++ \"/req\") ?? [];",
   " if ready && len(files)>0 then {",
   "  let raw=read_file(dir ++ \"/req/\" ++ files[0]);write_file(dir ++ \"/seen.json\",raw);",
   "  let model=svc-str(parse-json(\"request\",raw),\"model\");",
   "  if mode != \"gone\" then write_file(dir ++ \"/reply/\" ++ files[0],json-emit(json-node-object([svs-s(\"status\",mode),svs-s(\"model\",model),svs-s(\"text\",\"resident fixture answer\"),svs-n(\"prompt_ids\",7),svs-n(\"generated_ids\",3)]))) else 0;",
   " } else 0;",
   " host_path_remove(dir ++ \"/status.json\");",
   " 0;",
   "}"],"\n");
  def odb-resident(mode) {
   let dir = odb-dir() ++ "/resident-" ++ mode;
   hch-mkdirs(dir);
   let unit = dir ++ "/server.bml";
   write_file(unit,odb-server-source(dir,mode));
   let child = host_spawn_at(["./fkwu",unit],["/dev/null",dir ++ "/out",dir ++ "/err"]);
   let ready = wait-until(()=>svc-standing(dir)[0] == "standing",host_monotonic_ms()+10000,10);
   !ready ? {host_kill(child);host_wait(child);form_error("fixture resident did not stand: " ++ (read_file(dir ++ "/err") ?? ""));} : 0;
   let state = record_new(0,"called",0,"packet","","request",nothing());
   let request = json-node-object(append(json-object-pairs(fgs-ask-request("你好", "", "")),[fhn-s("model","qwen-test-on-demand"),fhn-s("coverage_ledger",dir ++ "/coverage.jsonl")]));
   let report = fgs-answer-with-voice(request,(packet,served,req)=>fgs-local-voice-at(dir,packet,served,req,(p,r)=>odb-native(state,p,r)));
   let ended = host_wait(child);
   let seen = parse-json("fixture-request",read_file(dir ++ "/seen.json") ?? "{}");
   [report,state,seen,ended,request];
  }
  def odb-c-busy(ctx) {
   let dir = odb-dir() ++ "/held-resource";
   hch-mkdirs(dir);
   write_file(dir ++ "/status.json",json-emit(json-node-object([svs-n("pid",host_pid()),svs-n("start",host_process(host_pid())[5]),svs-s("label","fixture qwen-test")])));
   write_file(dir ++ "/req","fixture makes request publication unavailable");
   let state = record_new(0,"called",0,"packet","","request",nothing());
   let request = json-node-object([fhn-s("model","qwen-test")]);
   let failed = fgs-local-voice-at(dir,"original packet","served packet",request,(p,r)=>odb-native(state,p,r));
   let failedExact = record_get(state,"packet") == "original packet" && json-emit(record_get(state,"request")) == json-emit(request);
   let other = json-node-object([fhn-s("model","qwen-test-other")]);
   let mismatch = fgs-local-voice-at(dir,"other packet","served packet",other,(p,r)=>odb-native(state,p,r));
   let honored = json-emit(record_get(state,"request")) == json-emit(other) && record_get(state,"packet") == "other packet";
   let served = odb-resident("stop");
   let partial = odb-resident("length");
   let gone = odb-resident("gone");
   let metadata = json-object-get(served[0],"native_generation");
   let modelLabel = fcnv-metadata(fcnv-none("answered","serve:a-label-is-not-a-transport",""));
   let route = parse-json("route",read_file(fhn-text(gone[0],"evidence") ++ "/native-route.json"));
   let written = odb-write("deep.md", "opening only\none trust\ntrust and sovereignty stand here\nnothing\n");
   let dense = fgs-dense(written, ["trust", "sovereignty"]);
   let deep = fgs-deepen([[0, written, 2, "a"], [0, written, 2, "b"], [0, written, 2, "c"]], ["trust", "sovereignty"]);
   let okay = failed[0][0] == "answered" && failed[1] && failed[3] == 1 && failedExact && len(failed[2]) > 0 && svc-standing(dir)[0] == "standing"
    && mismatch[1] && mismatch[3] == 1 && honored && !svc-holds?(dir,"qwen") && record_get(state,"called") == 2
    && served[3] == 0 && record_get(served[1],"called") == 0 && fhn-text(served[0],"answer_status") == "answered" && fhn-text(served[0],"lane") == "resident-service" && fhn-count(served[0],"rent_tokens") == 0
    && fhn-count(metadata,"model_server_calls") == 1 && fhn-count(metadata,"provider_calls") == 0 && fhn-text(metadata,"ownership") == "resident-service" && fhn-count(modelLabel,"model_server_calls") == 0
    && svc-str(served[2],"model") == "qwen-test-on-demand" && fhn-text(served[0],"oracle_model") == "serve:qwen-test-on-demand" && odb-has?(svc-str(served[2],"prompt"),"This turn has no tools and no file access") && read_file(fhn-text(served[0],"packet")) == svc-str(served[2],"prompt")
    && partial[3] == 0 && fhn-text(partial[0],"answer_status") == "incomplete" && odb-has?(fgs-ask-text(partial[0]),"resident fixture answer") && odb-has?(fgs-ask-text(partial[0]),"serve-length")
    && gone[3] == 0 && record_get(gone[1],"called") == 1 && fhn-count(gone[0],"resident_attempts") == 1 && json-emit(record_get(gone[1],"request")) == json-emit(gone[4]) && len(json-array-elements(json-object-get(route,"findings"))) > 0
    && (String) dense == "trust and sovereignty stand here" && (String) deep[0][3] == dense && (String) deep[2][3] == "c";
   okay ? map(got => fs-remove-tree(fhn-text(got[0],"evidence")),[served,partial,gone]) : print(["resident-route-evidence",map(got=>fhn-text(got[0],"evidence"),[served,partial,gone])]);
   okay;
  }
  def odb-run() {
   let swept = fs-remove-tree(odb-dir());
   let m = hch-mkdirs(odb-dir());
   let verdict = live-claims("form-cli-one-door-band", [], [["content", 1, 1, odb-c-content], ["weight", 2, 1, odb-c-weight], ["keys", 4, 1, odb-c-keys], ["packet", 8, 1, odb-c-packet], ["terms", 16, 1, odb-c-terms], ["row", 32, 1, odb-c-row], ["held", 64, 1, odb-c-held], ["door", 128, 1, odb-c-door], ["shape", 256, 1, odb-c-shape], ["unterm", 512, 1, odb-c-unterm], ["busy", 1024, 1, odb-c-busy]]);
   let cleaned = fs-remove-tree(odb-dir());
   verdict;
  }
 }
 odb-run();
}
