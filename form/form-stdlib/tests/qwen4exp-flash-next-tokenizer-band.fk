; qwen4exp-flash-next-tokenizer-band.fk — exact artifact-native encode,
; decode, special ids, stop token, and pinned llama.cpp tokenizer agreement.
;
; preludes: form-stdlib/core.fk form-stdlib/dsv4-tokenizer.fk form-stdlib/qwen35-tokenizer.fk form-stdlib/qwen4exp-flash-next-tokenizer.bml
;
; Verdict 255: 127 executable + 128 high-BML authority.

(do
    (defn q4tkb-list-eq (a b)
        (if (eq (len a) 0) (if (eq (len b) 0) 1 0)
            (if (eq (len b) 0) 0
                (if (eq (head a) (head b))
                    (q4tkb-list-eq (tail a) (tail b)) 0))))
    (defn q4tkb-has (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let path "/Users/ursmuff/models/qwen38-flash-next/UD-Q2_K_XL/Qwen3.8-Flash-Next-UD-Q2_K_XL-00001-of-00003.gguf")
    (let src (eqr-of-file path 0 12000000))
    (let ids (q4tk-encode src "Hello, Form."))
    (let c0 (if (q4tkb-list-eq ids (list 9419 11 3268 13)) 1 0))
    (let c1 (if (str_eq (q4tk-decode src ids) "Hello, Form.") 2 0))
    (let c2 (if (eq (q4tk-metadata-agrees? src) 1) 4 0))
    (let c3 (if (and (eq (q4tk-stop? 248046) 1) (eq (q4tk-stop? 248044) 0)) 8 0))
    (let c4 (if (eq (q4tk-special-id src "<|endoftext|>") 248044) 16 0))
    (let c5 (if (eq (q4tk-special-id src "<|im_end|>") 248046) 32 0))
    (let c6 (if (gt (len (q4tk-chat-ids src "Hello")) (len ids)) 64 0))
    (let base (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6)))))))
    (let authority-src (read_file "form/form-stdlib/bml/qwen4exp-flash-next-tokenizer.bml"))
    (let authority
        (if (eq (q4tkb-has authority-src "const String Algorithm = \"gpt2-byte-bpe-from-gguf\"") 1)
            (if (eq (q4tkb-has authority-src "const String ExternalRuntime = \"none\"") 1)
                (if (eq (q4tkb-has authority-src "const String OracleIds = \"9419,11,3268,13\"") 1) 128 0) 0) 0))
    (add base authority))
