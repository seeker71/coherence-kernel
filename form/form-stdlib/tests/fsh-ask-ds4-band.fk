; fsh-ask-ds4-band.fk — the form-shell ask door's decisions, fixture-free: the
; parsers, the command composition, and the hook-aware verdict wording, held to
; without loading a model or crossing the host.
;
; Verdict 255:
;   1    a keyed request line splits into key and rest-of-line value
;   2    request lookup answers the last-staged value, and the default otherwise
;   4    the emitted id list text parses to ints and renders back
;   8    ids, answer, speed, and blob are read from a lane transcript by name
;   16   the TOKEN HOOK line's keyed counters cross by name
;   32   the lane command carries every membrane by name, the prompt and
;        situation as $(cat file) crossings, and the rc marker tail
;   64   a sane unswapped stream reads sane, all three readings consulted
;   128  a head verdict token is excluded OUT LOUD, and a degenerate tail
;        still trips the reading it should
;
; preludes: form-stdlib/dsv4-token-recipe-swap.fk native/metal/ask-ds4.fk form-stdlib/ds4-stream-sanity.fk form-stdlib/fsh-ask-ds4.fk

(do
    (defn fadsb-score (ok bit) (if ok bit 0))
    (defn fadsb-nl () (byte_to_str 10))
    (defn fadsb-out ()
        (str_concat "ds4 blob: mainline-chat-v2.gguf — 86720111488 bytes"
        (str_concat (fadsb-nl)
        (str_concat "      SPEED: prefill 10.00 t/s (3 tokens in 0.30s), generation 28.04 t/s (8 tokens in 0.29s)"
        (str_concat (fadsb-nl)
        (str_concat "      TOKEN HOOK: offered=8 swapped=1 quiet=7 late=0 invalid=0 door=form-stdlib/dsv4-hook-door-control.fk"
        (str_concat (fadsb-nl)
        (str_concat "PASS  BOUNDED AUTOREGRESSIVE TOKEN FEEDBACK (11 steps, no EOS claim): [128003, 51, 52, 53]; each emitted token"
        (str_concat (fadsb-nl)
        (str_concat "NATIVE DECODED CONTINUATION"
        (str_concat (fadsb-nl)
                    " Paris.")))))))))))

    (let out (fadsb-out))
    (let cmd (fads-command 8 "0" "/t/p.txt" "/t/s.txt" "form-stdlib/dsv4-hook-door-quiet.fk" "/t/o.txt"))
    (let sane-ids (list 3 5 7 11 13 17 19 23))
    (let swapped-ids (cons 128003 sane-ids))
    ; the tail must reach dss-min-len (8) or the repetition readings are
    ; silent by design — a shorter fixture here tested nothing, and did.
    (let degenerate-tail (cons 128003 (list 5 5 5 5 5 5 5 5)))

    (sum (list
        (fadsb-score (and (str_eq (fads-key "prompt The capital of France is") "prompt")
                          (str_eq (fads-val "prompt The capital of France is") "The capital of France is")) 1)
        (fadsb-score (do (let req (list (list "steps" "8")))
                         (and (str_eq (fads-req req "steps" "40") "8")
                              (str_eq (fads-req req "situation" "") ""))) 2)
        (fadsb-score (do (let ids (fads-ids "128003, 51, 52, 53"))
                         (and (eq (len ids) 4)
                         (and (eq (head ids) 128003)
                         (and (eq (nth ids 3) 53)
                              (str_eq (fads-ids-text ids "") "128003, 51, 52, 53"))))) 4)
        (fadsb-score (and (str_eq (fads-out-ids-text out) "128003, 51, 52, 53")
                     (and (str_eq (fads-out-answer out) " Paris.")
                     (and (str_eq (fads-out-speed out) "generation 28.04 t/s")
                          (str_eq (fads-out-blob out) "mainline-chat-v2.gguf")))) 8)
        (fadsb-score (do (let hook (fads-out-hook-line out))
                         (and (eq (fads-hook-field-int hook "swapped=") 1)
                         (and (eq (fads-hook-field-int hook "offered=") 8)
                              (eq (fads-hook-field-int hook "late=") 0)))) 16)
        (fadsb-score (and (ge (str_find cmd "FORM_DS4_KV_STEPS=8 " 0) 0)
                     (and (ge (str_find cmd "FORM_DS4_KV_CAP=16 " 0) 0)
                     (and (ge (str_find cmd "FORM_DS4_PROMPT=\"$(cat /t/p.txt)\" " 0) 0)
                     (and (ge (str_find cmd "FORM_DS4_SITUATION=\"$(cat /t/s.txt)\" " 0) 0)
                     (and (ge (str_find cmd "FORM_DS4_TOKEN_HOOK_DOOR=form-stdlib/dsv4-hook-door-quiet.fk " 0) 0)
                     (and (ge (str_find cmd "FORM_DS4_TOKEN_BUDGET_MS=34 " 0) 0)
                     (and (ge (str_find cmd (ad-lane) 0) 0)
                          (ge (str_find cmd "2>&1; printf 'lane_rc=%d' $?" 0) 0)))))))) 32)
        (fadsb-score (str_eq (fads-verdict sane-ids 0) "stream sane (0 of 3 readings tripped)") 64)
        (fadsb-score (and (ge (str_find (fads-verdict swapped-ids 1) "stream sane" 0) 0)
                     (and (ge (str_find (fads-verdict swapped-ids 1) "over the model's own 8 tokens" 0) 0)
                     (and (ge (str_find (fads-verdict swapped-ids 1) "excluded from the reserved reading" 0) 0)
                          (ge (str_find (fads-verdict degenerate-tail 1) "STREAM DEGENERATE" 0) 0)))) 128))))
