; form-cli-peer-provider-receipt-band.fk — settled provider scalars enter
; the Form turnwheel without a model, transcript, path, or caller NodeID.
; Expected: 4095
;
; preludes: form-stdlib/bml/form-cli-peer-provider-receipt.bml

(do
    (defn fcprrb-bit (ok bit) (if ok bit 0))
    (let session (list "non-model-session" 71))
    (let text (fcprr-envelope 2 100))
    (let parsed (fcprr-parse text))
    (let admitted (fcprr-run session "provider-receipt" text))
    (let peer (fcprr-peer admitted))
    (let malformed (fcprr-run session "provider-receipt"
        (fcprr-envelope 2 0)))
    (let wrong-kind (fcprr-run session "direct-answer" text))
    (let receipt (fcprr-receipt-of admitted))
    (let frame (fcprr-frame receipt))
    (let src (read_file "form/form-stdlib/bml/form-cli-peer-provider-receipt.bml"))
    (sum (list
        (fcprrb-bit (and (eq (len parsed) 2)
            (and (eq (fcprr-calls parsed) 2)
                (eq (fcprr-tokens parsed) 100))) 1)
        (fcprrb-bit (and (eq (fcprr-result? admitted) 1)
            (and (str_eq (fcprr-signal admitted) "value")
                (str_eq (fcprr-reason admitted)
                    "settled-provider-receipt-admitted"))) 2)
        (fcprrb-bit (and (eq (frte-provider-baseline? receipt) 1)
            (and (eq (frte-receipt-provider-calls receipt) 2)
                (eq (frte-receipt-remote-tokens receipt) 100))) 4)
        (fcprrb-bit (node_eq (frte-receipt-task-node receipt)
            (fcpdag-embodied-goal-node)) 8)
        (fcprrb-bit (and (value_eq (fcprr-session admitted) session)
            (and (str_eq (fcpa-route peer) "provider-receipt")
                (and (eq (fcpa-callback-calls peer) 0)
                    (and (eq (fcpa-value-present? peer) 1)
                        (and (eq (fcpa-value peer) 100)
                            (str_eq (fcpa-carrier peer)
                                "form-provider-receipt")))))) 16)
        (fcprrb-bit (str_eq (fcprr-signal malformed) "choice") 32)
        (fcprrb-bit (and (str_eq (fcprr-signal wrong-kind) "choice")
            (value_eq (fcprr-session wrong-kind) session)) 64)
        (fcprrb-bit (and (ge (str_find frame "goal=embodied-v1" 0) 0)
            (and (ge (str_find frame "provider-calls=2" 0) 0)
                (and (ge (str_find frame "remote-tokens=100" 0) 0)
                    (and (eq (str_find frame text 0) -1)
                        (and (ge (str_find src "section [form.bml]" 0) 0)
                            (eq (str_find src "xtal" 0) -1)))))) 128)
        (fcprrb-bit (nothing? (fcprr-receipt-of malformed)) 256)
        (fcprrb-bit (eq (fcprr-value-present? malformed) 0) 512)
        (fcprrb-bit (nothing? (fcprr-value malformed)) 1024)
        (fcprrb-bit (and (eq (fcprr-canonical-positive? "2") 1)
            (and (eq (fcprr-canonical-positive? "0") 0)
                (eq (fcprr-canonical-positive? "02") 0))) 2048))))
