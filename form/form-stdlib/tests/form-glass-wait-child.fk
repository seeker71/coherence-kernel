; form-glass-wait-child.fk — the other process of form-glass-wait-band: says it is here, rests 200 ms,
; gives again (the word the parent is resting on moves), then stays alive so the band can read this
; process's program surface -- its defn table and source text -- where they live.
;
; preludes: form/form-stdlib/form-glass-gift-frame.bml

(do
    (defn wc-tick (x) (add x 1))
    (let handle (ggf-offer "form-glass-wait-band.child" 4096))
    (let first (node_gift_write handle (list (host_pid) (wc-tick 0))))
    (let rested (host_sleep_ms 200))
    (let second (node_gift_write handle (list (host_pid) (wc-tick 1))))
    (let released (ggf-release handle))
    (host_sleep_ms 6000))
