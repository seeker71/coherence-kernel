; source-compiler-native-text-boundary-band.fk -- compiler effects stay named.
;
; Verdict 1023 proves pure ontology categories and Form text lowering no longer
; inherit caller-frame walking, recipe-image persistence, or legacy byte-at.
; The optional runtime-image carrier still names its three real sibling ops.
; File-prefix scanning uses the existing bounded read_file_slice window.
;
; preludes: form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk
; preludes: form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk
; preludes: form-stdlib/bml.fk form-stdlib/bml-source.fk
; preludes: form-stdlib/source-compiler.fk
; witnessed: 2026-08-26 -> pending

(do
    (defn scntbb-has? (text needle)
        (if (ge (str_find text needle 0) 0) 1 0))
    (defn scntbb-bit (ok bit) (if ok bit 0))

    (let compiler-path "form/form-stdlib/source-compiler.fk")
    (let compiler-text (read_file compiler-path))
    (let carrier-text
        (read_file "form/form-stdlib/source-compiler-runtime-image.fk"))
    (let category-text
        (read_file "form/form-stdlib/form-ontology-source-categories.fk"))
    (let loader-text
        (read_file "form/form-stdlib/form-ontology-loader.fk"))
    (let cursor (fsc-file-source-cursor compiler-path 0 1 0 (file_size compiler-path)))
    (let source
        (str_concat "section "
            "[form.bml] {\n def five() = 5;\n five();\n}\n"))
    (let compiled (form-source-compile-text source "/tmp/unused-native-text.fk"))

    (add
        (scntbb-bit (fsc-source-cursor-file-prefix? cursor "; source-compiler.fk" 0) 1)
        (add
        (scntbb-bit (fsc-source-cursor-file-prefix? cursor "; source-compiler.fk" 2) 2)
        (add
        (scntbb-bit (not (fsc-source-cursor-file-prefix? cursor "; source-compiler.fx" 0)) 4)
        (add
        (scntbb-bit (str_eq compiled "(defn five () 5)\n(five)\n") 8)
        (add
        (scntbb-bit (and (eq (scntbb-has? compiler-text "(write_form_binary") 0)
                             (eq (scntbb-has? compiler-text "(file_byte_at") 0)) 16)
        (add
        (scntbb-bit (eq (scntbb-has? compiler-text "(walk_recipe_here") 0) 32)
        (add
        (scntbb-bit (and (eq (scntbb-has? carrier-text "(write_form_binary") 1)
                         (and (eq (scntbb-has? carrier-text "walk_recipe_here") 1)
                              (eq (scntbb-has? carrier-text "read_form_binary") 1))) 64)
        (add
        (scntbb-bit (and (eq (scntbb-has? category-text "walk_recipe_here") 0)
                             (eq (scntbb-has? loader-text "(walk_recipe_here") 1)) 128)
        (add
        (scntbb-bit (node_eq (fol-cat "do") (form-cat-node "do")) 256)
        (scntbb-bit (and (eq (scntbb-has? compiler-text "read_file_slice") 1)
                         (eq (scntbb-has? compiler-text "form-ontology-source-categories.fk") 1)) 512))))))))))
)
