; living-world-hypothesis-transfer-continuity-read.fk -- process two restores
; only after every historical holder responds, speaks without fixture rebuild,
; grows a fresh context from the restored execution, and persists the successor.
; Verdict 33554431 proves twenty-five load, consent, identity, voice, growth,
; successor-persistence, and cleanup claims.
; preludes: form-stdlib/core.fk form-stdlib/tests/living-world-hypothesis-transfer-continuity-witness.fk

(do
    (let started
        (lcfb-open-stream "living-world-hypothesis-transfer-continuity-read"
            "form-native" "lwhtrcw-restore-image" "inert-loaded-world"
            "form/form-stdlib/tests/living-world-hypothesis-transfer-continuity-read.fk"
            10 9))
    (let load-enter
        (lcfb-call-stream "living-world-hypothesis-transfer-continuity-read"
            "load" "enter" "form-native" "lwcd-load"
            "inert-carrier" 1 started
            "form/form-stdlib/tests/living-world-hypothesis-transfer-continuity-read.fk"
            15 9))
    (let loaded (lwcd-load (lwhtrcw-path) LWHTRCW-PROVENANCE))
    (let image (lwcd-result-image loaded))
    (let snapshot (lwcn-image-world image))
    (let load-leave
        (lcfb-call-stream "living-world-hypothesis-transfer-continuity-read"
            "load" "leave" "form-native" "lwcd-load"
            (lcfb-cat (list "loaded:" (int_to_str (lwcd-loaded? loaded))
                ":bytes:" (int_to_str (fs-stat-size (lwhtrcw-path)))))
            2 started
            "form/form-stdlib/tests/living-world-hypothesis-transfer-continuity-read.fk"
            24 9))

    (let restore-enter
        (lcfb-call-stream "living-world-hypothesis-transfer-continuity-read"
            "restore" "enter" "form-native" "lwcn-integrate-restore"
            "fresh-all-holder-responses" 3 started
            "form/form-stdlib/tests/living-world-hypothesis-transfer-continuity-read.fk"
            33 9))
    (let restored (lwhtrcw-restore-image image))
    (let restore-proposal (nth restored 0))
    (let restore-answered (nth restored 1))
    (let restored-world (nth restored 2))
    (let restore-outcome
        (lwt-evaluate-proposal
            (lwt-round-world restore-answered) restore-proposal))
    (let restore-leave
        (lcfb-call-stream "living-world-hypothesis-transfer-continuity-read"
            "restore" "leave" "form-native" "lwcn-integrate-restore"
            (lcfb-cat (list
                "participants:" (int_to_str (lwo-field-size
                    (lwt-proposal-participants restore-proposal)))
                ":yes:" (int_to_str (lwt-outcome-yes restore-outcome))
                ":ack:" (int_to_str (oac-kind
                    (if (node_eq (lwt-outcome-status restore-outcome)
                            (lwt-status-acknowledged))
                        (oac-one restore-proposal) (oac-nothing)))))
            4 started
            "form/form-stdlib/tests/living-world-hypothesis-transfer-continuity-read.fk"
            46 9))

    ; Discover the exact transfer from restored cells; do not rerun the fixture.
    (let transfer-candidate (lwhtrcw-find-transfer restored-world))
    (let transfer-plan (lwo-emergent-shape transfer-candidate))
    (let transfer-offer (lwhtr-plan-offer transfer-plan))
    (let execution (lwhtr-offer-execution transfer-offer))
    (let base-request (lwhtrcw-request-for-plan transfer-plan))
    (let base-trace (lwsg-generate restored-world base-request))
    (let recovered
        (lcfb-call-stream "living-world-hypothesis-transfer-continuity-read"
            "answer-restored" "leave" "form-native" "lwsg-generate"
            (lcfb-cat (list
                "turns:" (int_to_str (len (lwsg-turn-items
                    (lwsg-trace-turns base-trace))))
                ":voice-bytes:" (int_to_str
                    (str_len (lwsg-trace-rendered base-trace)))))
            5 started
            "form/form-stdlib/tests/living-world-hypothesis-transfer-continuity-read.fk"
            68 9))

    ; New sources grow a new target context from the restored execution.
    (let new-offer
        (lwhtrcw-offer-for-execution execution
            (lwhtr-plan-alternatives transfer-plan)
            (lwhtr-plan-unknown transfer-plan)))
    (let grow-enter
        (lcfb-call-stream "living-world-hypothesis-transfer-continuity-read"
            "grow-after-restore" "enter" "form-native"
            "lwhtr-integrate" "new-context-from-restored-execution" 6 started
            "form/form-stdlib/tests/living-world-hypothesis-transfer-continuity-read.fk"
            85 9))
    (let new-observed
        (lwt-receive-stream restored-world
            (list
                (lwhtrcw-entry LWHTRCW-SOURCE-G LWHTRCW-CONTEXT-A)
                (lwhtrcw-entry LWHTRCW-SOURCE-H LWHTRCW-CONTEXT-A)
                (lwhtrcw-entry LWHTRCW-SOURCE-G LWHTRCW-CONTEXT-B)
                (lwhtrcw-entry LWHTRCW-SOURCE-H LWHTRCW-CONTEXT-B)
                (lwhtrcw-entry LWHTRCW-SOURCE-G (lwhtrcw-context))
                (lwhtrcw-entry LWHTRCW-SOURCE-H (lwhtrcw-context))
                (lwhtrcw-entry LWHTRCW-SOURCE-G new-offer)
                (lwhtrcw-entry LWHTRCW-SOURCE-H new-offer))))
    (let new-proposal (lwhtr-proposal-for new-observed new-offer 2))
    (let new-round
        (lwt-round new-observed (lwo-field (list new-proposal))
            (lwo-empty-field) (lwo-none)))
    (let new-answered
        (lwt-round-receive new-round
            (list
                (lwhtrcw-response-entry LWHTRCW-SOURCE-G new-proposal)
                (lwhtrcw-response-entry LWHTRCW-SOURCE-H new-proposal))))
    (let new-integrated
        (lwhtr-integrate new-answered new-proposal LWHTRCW-ACTION))
    (let transfer-world (lwt-round-world new-integrated))
    (let new-candidate (lwt-proposal-candidate new-proposal))
    (let new-transition
        (lwhtr-transition-successor transfer-world new-candidate))

    (let transition-observed
        (lwt-receive-stream transfer-world
            (list
                (lwhtrcw-entry LWHTRCW-SOURCE-I new-transition)
                (lwhtrcw-entry LWHTRCW-SOURCE-J new-transition))))
    (let transition-proposal
        (lwtf-proposal-for transition-observed new-transition 2))
    (let transition-round
        (lwt-round transition-observed
            (lwo-field (list transition-proposal))
            (lwo-empty-field) new-integrated))
    (let transition-answered
        (lwt-round-receive transition-round
            (list
                (lwhtrcw-response-entry LWHTRCW-SOURCE-I transition-proposal)
                (lwhtrcw-response-entry LWHTRCW-SOURCE-J transition-proposal))))
    (let transition-integrated
        (lwtf-integrate transition-answered transition-proposal
            LWHTRCW-ACTION))
    (let grown-world (lwt-round-world transition-integrated))
    (let transition-candidate
        (lwt-proposal-candidate transition-proposal))
    (let grown-request (lwhtrcw-request-for-offer new-offer))
    (let grown-trace
        (lwsg-generate-observed grown-world grown-request started 7))
    (let grow-leave
        (lcfb-call-stream "living-world-hypothesis-transfer-continuity-read"
            "grow-after-restore" "leave" "form-native"
            "lwsg-generate-observed"
            (lcfb-cat (list
                "turns:" (int_to_str (len (lwsg-turn-items
                    (lwsg-trace-turns grown-trace))))
                ":voice-bytes:" (int_to_str
                    (str_len (lwsg-trace-rendered grown-trace)))))
            11 started
            "form/form-stdlib/tests/living-world-hypothesis-transfer-continuity-read.fk"
            143 9))

    ; Persist and read back the grown successor before releasing transients.
    (let successor-image (lwcn-image grown-world))
    (let successor-enter
        (lcfb-call-stream "living-world-hypothesis-transfer-continuity-read"
            "persist-successor" "enter" "form-native" "lwcd-save-new"
            "grown-world-image" 12 started
            "form/form-stdlib/tests/living-world-hypothesis-transfer-continuity-read.fk"
            158 9))
    (let successor-save
        (lwcd-save-new (lwhtrcw-grown-path) successor-image
            LWHTRCW-PROVENANCE))
    (let successor-load
        (lwcd-load (lwhtrcw-grown-path) LWHTRCW-PROVENANCE))
    (let successor-leave
        (lcfb-call-stream "living-world-hypothesis-transfer-continuity-read"
            "persist-successor" "leave" "form-native" "lwcd-load"
            (lcfb-cat (list
                "saved:" (int_to_str (lwcd-saved? successor-save))
                ":loaded:" (int_to_str (lwcd-loaded? successor-load))
                ":bytes:" (int_to_str
                    (fs-stat-size (lwhtrcw-grown-path)))))
            13 started
            "form/form-stdlib/tests/living-world-hypothesis-transfer-continuity-read.fk"
            169 9))

    (let original-removed (fs-remove-file (lwhtrcw-path)))
    (let grown-removed (fs-remove-file (lwhtrcw-grown-path)))

    (sum (list
        (if (eq (lwcd-loaded? loaded) 1) 1 0)
        (if (eq (lwcn-image-valid? image) 1) 2 0)
        (if (node_eq snapshot (lwcn-image-world image)) 4 0)
        (if (not (node_eq restore-proposal (lwo-none))) 8 0)
        (if (gt (lwo-field-size
                    (lwt-proposal-participants restore-proposal)) 0) 16 0)
        (if (eq (lwt-outcome-yes restore-outcome)
                (lwo-field-size
                    (lwt-proposal-participants restore-proposal))) 32 0)
        (if (node_eq (lwt-outcome-status restore-outcome)
                (lwt-status-acknowledged)) 64 0)
        (if (eq (lwcn-restored? restored-world
                    (lwt-proposal-candidate restore-proposal)) 1) 128 0)
        (if (not (node_eq transfer-candidate (lwo-none))) 256 0)
        (if (eq (lwhtr-candidate-active?
                    restored-world transfer-candidate) 1) 512 0)
        (if (eq (lwht-execution-current? restored-world execution) 1) 1024 0)
        (if (eq (lwsg-trace-current? restored-world base-trace) 1) 2048 0)
        (if (eq (len (lwsg-turn-items
                    (lwsg-trace-turns base-trace))) 1) 4096 0)
        (if (gt (str_len (lwsg-trace-rendered base-trace)) 0) 8192 0)
        (if (eq (lwhtr-candidate-active?
                    transfer-world new-candidate) 1) 16384 0)
        (if (and (node_eq (lwtf-observation-context new-transition)
                            (lwhtrcw-context))
                 (node_eq (lwtf-observation-next new-transition)
                    (lwht-execution-output execution))) 32768 0)
        (if (eq (lwtf-integrated-current?
                    grown-world transition-candidate) 1) 65536 0)
        (if (eq (lwsg-trace-current? grown-world grown-trace) 1) 131072 0)
        (if (eq (len (lwsg-turn-items
                    (lwsg-trace-turns grown-trace))) 1) 262144 0)
        (if (str_eq (lwsg-trace-rendered base-trace)
                    (lwsg-trace-rendered grown-trace)) 524288 0)
        (if (eq (lwcd-saved? successor-save) 1) 1048576 0)
        (if (eq (lwcd-loaded? successor-load) 1) 2097152 0)
        (if (node_eq (lwcd-result-image successor-load)
                    successor-image) 4194304 0)
        (if (and (eq original-removed 0)
                 (eq grown-removed 0)) 8388608 0)
        (if (and (eq (fs-exists? (lwhtrcw-path)) 0)
                 (eq (fs-exists? (lwhtrcw-grown-path)) 0)) 16777216 0))))
