; dclf-perclass-probe.fk — per-class held-out breakdown of the leak-free split (honesty check).
; preludes: form-stdlib/dsv4-control-leakfree.fk
(do
    (let r (dclf-report))
    (let m (nth r 0))
    (defn pc-diag (m a) (nth m (add (mul a 5) a)))
    (defn pc-tot (m a p) (if (eq p 5) 0 (add (nth m (add (mul a 5) p)) (pc-tot m a (add p 1)))))
    (defn pc-walk (m names a)
        (if (eq a 5) 0
            (do (print (str_concat (nth names a)
                    (str_concat "  correct " (str_concat (int_to_str (pc-diag m a))
                    (str_concat " / " (int_to_str (pc-tot m a 0)))))))
                (pc-walk m names (add a 1)))))
    (pc-walk m (dct-names) 0)
    (nth r 1))
