; preludes: form-stdlib/core.fk form-stdlib/nanbeige-looped-lane.fk
;
; Verdict 4095: released shape, shared-weight execution, isolated cache, and
; fail-closed local admission are executable rather than prose.
(do
    (let a (nbll-nanbeige42))
    (let weights (list (list 2 1) (list 3 1)))
    (let ready (nbll-observation 1 1 1 32 10001 1 1 1 1 1))
    (let absent (nbll-observation 0 1 1 32 10001 1 1 1 1 1))
    (let weak (nbll-observation 1 1 1 32 10000 1 1 1 1 1))
    (add
        (if (eq (nbll-layers a) 22) 1 0)
        (add (if (eq (nbll-loops a) 2) 2 0)
        (add (if (eq (nbll-effective-layer-applications a) 44) 4 0)
        (add (if (eq (nbll-unique-layer-count a) 22) 8 0)
        (add (if (eq (nbll-weight-reuse-factor a) 2) 16 0)
        (add (if (eq (nbll-gqa-groups a) 6) 32 0)
        (add (if (eq (nbll-cache-slot a 0 21) 21) 64 0)
        (add (if (eq (nbll-cache-slot a 1 0) 22) 128 0)
        (add (if (eq (nbll-execute-loops weights 1 1) 10) 256 0)
        (add (if (eq (nbll-execute-loops weights 2 1) 64) 512 0)
        (add (if (str_eq (nbll-route ready "llama32-3b-local" 32 10000)
                         "nanbeige42-3b-local") 1024 0)
             (if (and (str_eq (nbll-route absent "llama32-3b-local" 32 10000)
                              "llama32-3b-local")
                      (str_eq (nbll-route weak "llama32-3b-local" 32 10000)
                              "llama32-3b-local")) 2048 0)))))))))))))
