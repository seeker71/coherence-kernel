import "../offline-recovery-inventory.fk"

(do
    (defn orib-bit (held weight) (if held weight 0))
    (let rows (list
        (ori-row "repository" "reachable-objects" 1 2026082502
            "fsck-with-commit-graph-disabled" "exit-0" "re-run-fsck")
        (ori-row "repository" "commit-graph" 0 2026082502
            "commit-graph-verify" "exit-1" "rewrite-reachable-graph")
        (ori-row "model" "current-whole-file-seal" (nothing) 2026082502
            "bounded-run-did-not-rehash" "unobserved" "run-seal-check")
        (ori-row "toolchain" "cc" 1 2026082502
            "command-v" "/usr/bin/cc" "install-command-line-tools")
        (list "short" 0 1)
        (ori-row "bad" "state" 2 2026082502 "bad" "bad" "repair")))
    (let steps (list
        (ori-step 1 "protect-movement" "commit-current-public-work" "git-status")
        (ori-step 2 "rewrite-graph" "git-commit-graph-write" "git-commit-graph-verify")
        (list "short" 3)))
    (let report (ori-report 2026082502 rows steps))
    (let all-unknown (ori-report 2026082503
        (list (ori-row "model" "seal" (nothing) 2026082503
            "not-run" "unobserved" "run-seal-check")) (list)))
    (add
        (orib-bit (eq (ori-valid-count report) 4) 1)
        (add (orib-bit (eq (ori-observed-denominator report) 3) 2)
        (add (orib-bit (eq (ori-healthy-count report) 2) 4)
        (add (orib-bit (eq (ori-gap-count report) 1) 8)
        (add (orib-bit (eq (ori-unknown-count report) 1) 16)
        (add (orib-bit (eq (ori-invalid-count report) 2) 32)
        (add (orib-bit (eq (ori-health-permille report) 666) 64)
        (add (orib-bit (str_eq (ori-first-gap-identity report) "commit-graph") 128)
        (add (orib-bit (eq (ori-valid-step-count report) 2) 256)
        (add (orib-bit (eq (ori-invalid-step-count report) 1) 512)
        (add (orib-bit (nothing? (ori-health-permille all-unknown)) 1024)
        (add (orib-bit (eq (ori-observed-denominator all-unknown) 0) 2048)
        (add (orib-bit (eq (ori-unknown-count all-unknown) 1) 4096)
        (add (orib-bit (eq (ori-row-valid? 7) 0) 8192)
             (orib-bit (eq (ori-step-valid? 9) 0) 16384))))))))))))))))
