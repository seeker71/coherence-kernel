; iq4xs-dequant-band.fk — exact type-23 carver against pinned ggml b10686.
;
; preludes: form-stdlib/core.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/iq4xs-layout.bml form-stdlib/iq4xs-dequant.fk
;
; The independent C oracle is tests/iq4xs-ggml-oracle.c. Verdict 127.

(do
    (defn iq4xb-scale (ib) (iq4x-mod (add (mul 7 ib) 3) 64))
    (defn iq4xb-scales-h (ib acc)
        (if (eq ib 8) acc
            (iq4xb-scales-h (add ib 1)
                (add acc (mul (div (iq4xb-scale ib) 16) (iq4x-pow2 (mul 2 ib)))))))
    (defn iq4xb-byte (i)
        (if (eq i 0) 0
        (if (eq i 1) 60
        (if (eq i 2) (iq4x-mod (iq4xb-scales-h 0 0) 256)
        (if (eq i 3) (div (iq4xb-scales-h 0 0) 256)
        (if (lt i 8)
            (do (let g (mul 2 (sub i 4)))
                (add (iq4x-mod (iq4xb-scale g) 16)
                     (mul 16 (iq4x-mod (iq4xb-scale (add g 1)) 16))))
            (do (let q (sub i 8))
                (let n (iq4x-mod q 16))
                (add n (mul 16 (sub 15 n))))))))))
    (defn iq4xb-build (i acc)
        (if (eq i (IQ4XSBlockBytes)) (reverse acc)
            (iq4xb-build (add i 1) (cons (iq4xb-byte i) acc))))
    (defn iq4xb-samples () (list 0 15 16 31 32 63 64 95 96 127 128 159 160 191 192 223 224 255))
    (defn iq4xb-expected () (list 3683000000 -3277000000 -3277000000 3683000000 2794000000 2794000000 1905000000 1905000000 1016000000 1016000000 127000000 127000000 -762000000 -762000000 -1651000000 -1651000000 -2540000000 -2540000000))
    (defn iq4xb-scaled (bytes ids acc)
        (if (eq (len ids) 0) (reverse acc)
            (iq4xb-scaled bytes (tail ids)
                (cons (float_to_int (mul 1000000.0 (iq4x-at-flat bytes 0 (head ids)))) acc))))
    (defn iq4xb-eq (a b)
        (if (eq (len a) (len b))
            (if (eq (len a) 0) 1
                (if (eq (head a) (head b)) (iq4xb-eq (tail a) (tail b)) 0)) 0))
    (defn iq4xb-sum (bytes i acc)
        (if (eq i 256) acc
            (iq4xb-sum bytes (add i 1)
                (add acc (float_to_int (mul 1000000.0 (iq4x-at-flat bytes 0 i)))))))
    (defn iq4xb-bit (ok bit) (if ok bit 0))
    (let bytes (iq4xb-build 0 (empty)))
    (let c0 (iq4xb-bit (if (eq (IQ4XSGGMLType) 23) (if (eq (IQ4XSBlockElements) 256) (eq (IQ4XSBlockBytes) 136) 0) 0) 1))
    (let c1 (iq4xb-bit (iq4xb-eq (iq4xb-scaled bytes (iq4xb-samples) (empty)) (iq4xb-expected)) 2))
    (let c2 (iq4xb-bit (eq (iq4xb-sum bytes 0 0) 6768000000) 4))
    (let c3 (iq4xb-bit (if (eq (iq4x-within-block 255) 1) (if (eq (iq4x-within-block 256) 0) (nothing? (iq4x-at-flat bytes 0 -1)) 0) 0) 8))
    (let c4 (iq4xb-bit (if (eq (iq4x-scale-code bytes 0 0) 3) (eq (iq4x-scale-code bytes 0 7) 52) 0) 16))
    (let c5 (iq4xb-bit (if (eq (len bytes) 136) (if (eq (iq4x-slot-threads 641) 5152) (eq (iq4x-slot-admissible 640 2560) 1) 0) 0) 32))
    (let authority (read_file "form/form-stdlib/bml/iq4xs-layout.bml"))
    (let c6 (iq4xb-bit (if (ge (str_find authority "const int GGMLType = 23" 0) 0) (ge (str_find authority "const int BlockBytes = 136" 0) 0) 0) 64))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6)))))))
