; corpus-train-door-band.fk — no open decisions: everything is a constant with
; a reason or a value derived from the corpus itself.
;
; Verdict 255 (8 bits):
;   1    rows counted from the live train file (435 today; any positive count
;        passes so a grown corpus does not redden this)
;   2    iters == ceil(epochs*rows/batch) exactly — derived, never passed
;   4    the command carries --mask-prompt unconditionally
;   8    the command carries the lineage layer count
;   16   the command's iters equals the derived iters
;   32   a missing corpus reads nothing, and the command is then nothing too —
;        a door with no corpus does not emit a runnable half-command
;   64   resume path and out dir pass through verbatim
;   128  the command calls the INSTALLED entry point — no `uv run --with`
;        capability re-declaration — and every flag in it is one this cell states
;
; preludes: learn/corpus-train-door.fk

(do
    (defn ctdb-bit (ok bit) (if ok bit 0))
    (defn ctdb-has (s sub) (if (ge (str_find s sub 0) 0) 1 0))
    (defn corpus-train-door-band ()
        (do
            (let r (ctd-rows))
            (let it (ctd-iters))
            (let c (ctd-command "/tmp/prev-adapter" "/tmp/out-adapter"))
            (sum (list
                (ctdb-bit (and (not (nothing? r)) (gt r 0)) 1)
                (ctdb-bit (eq it (div (add (mul (ctd-epochs) r) (sub (ctd-batch) 1)) (ctd-batch))) 2)
                (ctdb-bit (eq (ctdb-has c "--mask-prompt") 1) 4)
                (ctdb-bit (eq (ctdb-has c "--num-layers 16") 1) 8)
                (ctdb-bit (eq (ctdb-has c (str_concat "--iters " (int_to_str it))) 1) 16)
                (ctdb-bit (nothing? (ctd-rows-at "/no-such-dir-anywhere")) 32)
                (ctdb-bit (and (eq (ctdb-has c "/tmp/prev-adapter") 1)
                               (eq (ctdb-has c "/tmp/out-adapter") 1)) 64)
                (ctdb-bit (and (eq (ctdb-has c "mlx_lm.lora") 1)
                          (and (eq (ctdb-has c "--with") 0)
                          (and (eq (ctdb-has c "--train") 1)
                          (and (eq (ctdb-has c "--model") 1)
                          (and (eq (ctdb-has c "--data") 1)
                          (and (eq (ctdb-has c "--learning-rate 2e-5") 1)
                               (eq (ctdb-has c "--batch-size 2") 1))))))) 128)))))
    (corpus-train-door-band))
