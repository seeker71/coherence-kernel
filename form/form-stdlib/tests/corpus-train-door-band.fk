; Isolated corpus: blank lines and a missing final newline retain all three rows.
; The native request carries the historical layer, masking and learning-rate recipe.
; preludes: learn/corpus-train-door.fk
(do
 (let dir (str_concat "/tmp/native-corpus-door-" (int_to_str (host_pid))))
 (fs-mkdir dir)
 (nag-write (str_concat dir "/train.jsonl") "{\"text\":\"A\"}\n\n{\"text\":\"B\"}\n{\"text\":\"C\"}")
 (let r (ctd-request-at dir "/tmp/previous adapter/adapters.safetensors" "/tmp/output adapter"))
 (let b1 (eq (ctd-rows-at dir) 3))
 (let b2 (eq (ntr-get r "steps") 14))
 (let b4 (eq (ntr-get r "mask_prompt") 1))
 (let b8 (eq (ntr-get r "layers") 16))
 (let b16 (eq (ntr-get r "batch") 2))
 (let b32 (eq (ntr-get r "learning_rate") 0.00002))
 (let b64 (and (str_eq (ntr-get r "adapter") "/tmp/previous adapter") (str_eq (ntr-get r "output") "/tmp/output adapter")))
 (let b128 (value_eq (nlw-argv) (list "./fkwu" "observe/native-lora-train-run.fk")))
 (let b256 (and (nothing? (ctd-request-at "/no/such/native-corpus" "a" "b")) (str_eq (ntr-get r "model") (tlp-base-model))))
 (fs-remove-tree dir)
 (let result (sum (list (if b1 1 0) (if b2 2 0) (if b4 4 0) (if b8 8 0) (if b16 16 0) (if b32 32 0) (if b64 64 0) (if b128 128 0) (if b256 256 0))))
 (if (eq result 511) result (form_error "native corpus request evidence refused")))
