; form-knowledge-public-query-offer-batch-observed-band.fk -- physical summary.
;
; Expected: 65535
; preludes: form-stdlib/form-knowledge-public-query-offer-batch-observed.fk

(do
    (defn fkpqoob-bit (ok bit) (if ok bit 0))
    (defn fkpqoob-row (family)
        (fkpqoo-family-row family (fkpqoo-rows)))
    (defn form-knowledge-public-query-offer-batch-observed-band ()
        (do
            (let summary (fkpqoo-summary))
            (let rows (fkpqoo-rows))
            (sum (list
                (fkpqoob-bit (and (str_eq (nth summary 0) (fkpqoo-schema))
                                  (eq (len summary) 18)) 1)
                (fkpqoob-bit (and (str_eq (nth summary 1) (fkpqo-plan-sha))
                                  (eq (nmfe-sha256? (nth summary 2)) 1)) 2)
                (fkpqoob-bit (and (eq (nmfe-sha256? (nth summary 3)) 1)
                                  (eq (len rows) 15)) 4)
                (fkpqoob-bit (eq (nth summary 6) 1) 8)
                (fkpqoob-bit (eq (nth summary 7) 14) 16)
                (fkpqoob-bit (eq (nth summary 8) 10) 32)
                (fkpqoob-bit (and (eq (nth summary 9) 0)
                                  (eq (nth summary 10) 14)) 64)
                (fkpqoob-bit (and (eq (nth summary 11) 15)
                                  (eq (nth summary 12) 0)) 128)
                (fkpqoob-bit (and (eq (nth summary 13) 1)
                                  (eq (nth summary 14) 0)) 256)
                (fkpqoob-bit (and (eq (nth summary 15) 1)
                                  (eq (nth summary 16) 1)) 512)
                (fkpqoob-bit (eq (nth summary 17) 0) 1024)
                (fkpqoob-bit (and (eq (fkpqoo-transport
                                           (fkpqoob-row "grammars")) 0)
                                  (eq (fkpqoo-answer95
                                           (fkpqoob-row "grammars")) 0)) 2048)
                (fkpqoob-bit (and (eq (fkpqoo-transport
                                           (fkpqoob-row "teachings")) 1)
                                  (eq (fkpqoo-answer95
                                           (fkpqoob-row "teachings")) 0)) 4096)
                (fkpqoob-bit (and (eq (fkpqoo-answer95
                                           (fkpqoob-row "form-stdlib")) 0)
                                  (eq (fkpqoo-answer95
                                           (fkpqoob-row "ingest")) 0)) 8192)
                (fkpqoob-bit (and (eq (fkpqoo-answer95
                                           (fkpqoob-row "cognition")) 0)
                                  (eq (fkpqoo-answer95
                                           (fkpqoob-row "axioms")) 1)) 16384)
                (fkpqoob-bit (and (eq (fkpqoo-all-valid? rows) 1)
                                  (eq (fkpqoo-every-family-once?
                                       (fkpfm-family-ids) rows) 1)) 32768)))))
    (form-knowledge-public-query-offer-batch-observed-band))
