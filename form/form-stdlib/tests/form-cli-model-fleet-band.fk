; form-cli-model-fleet-band.fk -- BML model-fleet ownership and fair-token
; contract.  It opens no model: the physical `fcmf-open` door is separately
; named in BML and only a caller with model/Metal authority invokes it.
; Expected: 1023
;
; preludes: form-stdlib/bml/form-cli-model-fleet.bml

(do
    (defn fcmfb-bit (held weight) (if held weight 0))
    (defn fcmfb-session (path pending)
        (fcms-session "live" "test-native-seat" path "source" (empty) (empty)
            128 7 pending 0 3 4 0 0))
    (defn form-cli-model-fleet-band ()
        (do
            (let zero-seat (fcmfb-session "qwen-a.gguf" 0))
            (let one-seat (fcmfb-session "qwen-b.gguf" 1))
            (let empty-fleet (fcmf-empty))
            (let first (fcmf-adopt empty-fleet "reasoner" zero-seat))
            (let second (fcmf-adopt (fcmf-admission-fleet first) "writer" one-seat))
            (let fleet (fcmf-admission-fleet second))
            (let duplicate-name (fcmf-adopt fleet "reasoner"
                (fcmfb-session "qwen-c.gguf" 2)))
            (let duplicate-path (fcmf-adopt fleet "critic"
                (fcmfb-session "qwen-a.gguf" 3)))
            (let dead (fcmf-adopt fleet "absent" (fcms-none "not-opened")))
            (let no-fleet (fcmf-adopt (nothing) "x" zero-seat))
            (let token-zero (fcmf-token "reasoner"
                (fcms-generation "" (list 0) zero-seat)))
            (let token-one (fcmf-token "writer"
                (fcms-generation "" (list 1) one-seat)))
            (let manual-revolution (list "form-cli-model-fleet-revolution-v1" 41
                fleet (list token-zero token-one)))
            (let c0 (fcmfb-bit (and (eq (fcmf-fleet? empty-fleet) 1)
                (eq (fcmf-seat-count empty-fleet) 0)) 1))
            (let c1 (fcmfb-bit (and (str_eq (fcmf-admission-signal first) "value")
                (and (str_eq (fcmf-admission-signal second) "value")
                    (and (eq (fcmf-seat-count fleet) 2)
                        (and (str_eq (fcmf-seat-name (fcmf-find-name (fcmf-seats fleet) "reasoner")) "reasoner")
                            (str_eq (fcmf-seat-name (fcmf-find-name (fcmf-seats fleet) "writer")) "writer"))))) 2))
            (let c2 (fcmfb-bit (and (str_eq (fcmf-admission-signal duplicate-name) "choice")
                (and (str_eq (fcmf-admission-reason duplicate-name) "seat-name-already-admitted")
                    (eq (fcmf-seat-count (fcmf-admission-fleet duplicate-name)) 2))) 4))
            (let c3 (fcmfb-bit (and (str_eq (fcmf-admission-signal duplicate-path) "choice")
                (and (str_eq (fcmf-admission-reason duplicate-path) "model-path-already-admitted")
                    (eq (fcmf-seat-count (fcmf-admission-fleet duplicate-path)) 2))) 8))
            (let c4 (fcmfb-bit (and (str_eq (fcmf-admission-signal dead) "choice")
                (str_eq (fcmf-admission-reason dead) "native-session-not-live:not-opened")) 16))
            (let c5 (fcmfb-bit (and (str_eq (fcmf-admission-signal no-fleet) "nothing")
                (nothing? (fcmf-admission-seat no-fleet))) 32))
            (let c6 (fcmfb-bit (and (eq (fcmf-token-present? token-zero) 1)
                (and (eq (fcmf-token-id token-zero) 0)
                    (and (eq (fcmf-token-present? token-one) 1)
                        (eq (fcmf-token-id token-one) 1)))) 64))
            (let c7 (fcmfb-bit (and (eq (fcmf-revolution-epoch manual-revolution) 41)
                (and (eq (fcmf-revolution-token-count manual-revolution) 2)
                    (and (str_eq (fcmf-token-name (head (fcmf-revolution-tokens manual-revolution))) "reasoner")
                        (str_eq (fcmf-token-name (head (tail (fcmf-revolution-tokens manual-revolution)))) "writer")))) 128))
            (let c8 (fcmfb-bit (and (str_eq (fcmf-seat-path (fcmf-find-name (fcmf-seats fleet) "reasoner")) "qwen-a.gguf")
                (str_eq (fcmf-seat-path (fcmf-find-name (fcmf-seats fleet) "writer")) "qwen-b.gguf")) 256))
            (let source (read_file "form/form-stdlib/bml/form-cli-model-fleet.bml"))
            (let c9 (fcmfb-bit (and (ge (str_find source "fcms-open(path, prompt, maxpos)" 0) 0)
                (and (ge (str_find source "fcms-generate(fcmf-seat-session(seat), 1)" 0) 0)
                    (ge (str_find source "fcms-release-ok?" 0) 0))) 512))
            (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9))))
    (form-cli-model-fleet-band))
