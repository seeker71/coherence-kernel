; resident-ingress-turnwheel-join-band.fk — yielded async ingress actually
; publishes and accepts work into the already-living resident turnwheel.
; Expected: 131071
;
; No model, Metal, HTTP, C, flatten, or static arriving symbol participates.
;
; preludes: form-stdlib/resident-ingress-turnwheel-join.fk

(do
    (defn ritjb-bit (held weight) (if held weight 0))
    (defn ritjb-v1 ()
        (list (list 2) (list 1 17) (list 3 0 1)))
    (defn ritjb-v2 ()
        (list (list 2) (list 1 5) (list 5 0 1)
              (list 1 1) (list 3 2 3)))
    (defn ritjb-route (symbol program root epoch)
        (fcrt-route symbol (jonb-identity program root epoch) program root))
    (defn ritjb-envelope (channel sequence exchange kind payload alternative deadline)
        (rai-envelope channel sequence exchange kind payload alternative deadline))
    (defn ritjb-row (state id)
        (wt-find (wt-rows (le-w (fcrt-lw (ritj-host state)))) id))
    (defn ritjb-offer-step (state envelope now)
        (do
            (let offered (ritj-offer state envelope))
            (ritj-step (ritj-result-state offered) now)))

    (defn resident-ingress-turnwheel-join-band ()
        (do
            (let channel "@0.2.0.920")
            (let shared (fcrt-shared "" "" (empty) (empty) 256 8
                (jonb-registry 1)))
            (let host0 (fcrt-host-from-shared shared 0 1
                (fcrt-unbound-route)))
            (let ingress0 (rai-organ (list (rai-channel channel 16 32 0)) 6))
            (let state0 (ritj-new host0 ingress0 channel 6))

            ; The session/residence exists before any external offer.  Before
            ; ready, an offer is absence and cannot enter water.
            (let premature (ritj-offer state0
                (ritjb-envelope channel 1 91 "publish" (list) "wait" -1)))
            (let c0 (ritjb-bit (and
                (str_eq (ritj-result-signal premature) "nothing")
                (and (eq (len (fcrt-events host0)) 1)
                     (eq (nth (rai-inspect-channel ingress0 channel) 8) 0))) 1))

            (let ready1 (ritj-ready state0 91))
            (let state1 (nth ready1 0))
            (let ready-receipt1 (nth ready1 1))
            (let c1 (ritjb-bit (and (eq (nth ready-receipt1 1) 91)
                (and (eq (nth ready-receipt1 3) 0)
                     (str_eq (nth (head (ritj-events state1)) 1) "ready"))) 2))

            ; A stale exchange becomes an explicit choice of its alternative.
            (let stale (ritj-offer state1
                (ritjb-envelope channel 2 90 "publish" (list) "pause" -1)))
            (let c2 (ritjb-bit (and
                (str_eq (ritj-result-signal stale) "choice")
                (and (eq (ritj-result-present? stale) 1)
                     (str_eq (ritj-result-value stale) "pause"))) 4))

            (let symbol "arriving/join-shape-not-in-parent")
            (let route1 (ritjb-route symbol (ritjb-v1) 2 1))
            (let pub1 (ritjb-offer-step state1
                (ritjb-envelope channel 3 91 "publish"
                    (list 1 1 route1) "revise" -1) 10))
            (let state2 (ritj-result-state pub1))
            (let c3 (ritjb-bit (and (str_eq (ritj-result-signal pub1) "value")
                (and (node_eq (ritj-result-value pub1) (fcrt-route-identity route1))
                     (node_eq (ritj-current-id state2)
                        (fcrt-route-identity route1)))) 8))

            ; Accept carries the same ready exchange and published NodeID.
            (let acc1 (ritjb-offer-step state2
                (ritjb-envelope channel 4 91 "accept-program"
                    (list 11 5 4 "release/11")
                    (fcrt-route-identity route1) -1) 10))
            (let state3 (ritj-result-state acc1))
            (let row11 (ritjb-row state3 11))
            (let c4 (ritjb-bit (and (str_eq (ritj-result-signal acc1) "value")
                (le-eid-eq? (le-pin-of row11) (le-eid 1 1))) 16))

            ; Version two publishes while row 11 is still live.  Row 12 pins
            ; the replacement; the old lease remains exact.
            (let ready2 (ritj-ready state3 92))
            (let state4 (nth ready2 0))
            (let route2 (ritjb-route symbol (ritjb-v2) 4 1))
            (let pub2 (ritjb-offer-step state4
                (ritjb-envelope channel 5 92 "publish"
                    (list 2 1 route2) "revise" -1) 10))
            (let state5 (ritj-result-state pub2))
            (let acc2 (ritjb-offer-step state5
                (ritjb-envelope channel 6 92 "accept-program"
                    (list 12 5 4 "release/12")
                    (fcrt-route-identity route2) -1) 10))
            (let state6 (ritj-result-state acc2))
            (let c5 (ritjb-bit (and
                (le-eid-eq? (le-pin-of (ritjb-row state6 11)) (le-eid 1 1))
                (le-eid-eq? (le-pin-of (ritjb-row state6 12)) (le-eid 2 1))) 32))

            (let host-run (fcrt-run (ritj-host state6) 1))
            (let state7 (ritj-with state6 host-run (ritj-ingress state6)
                (ritj-ready-exchange state6) (ritj-current-id state6)
                (ritj-events state6)))
            (let old (ritjb-row state7 11))
            (let fresh (ritjb-row state7 12))
            (let c6 (ritjb-bit (and (eq (head (wt-toks old)) 22)
                (eq (head (wt-toks fresh)) 26)) 64))
            (let c7 (ritjb-bit (and
                (eq (nth (fcrt-flow-receipt (wt-rstate old)) 3) 1)
                (eq (nth (fcrt-flow-receipt (wt-rstate fresh)) 3) 1)) 128))

            ; Reusing v2's retained identity returns through JIT-once-born
            ; with born=0, while preserving the same registry in residence.
            (let warm (fcrt-route-invoke route2
                (wt-sctx (le-w (fcrt-lw host-run))) 6))
            (let c8 (ritjb-bit (and (eq (fcrt-route-value warm) 31)
                (and (eq (nth (fcrt-route-receipt warm) 3) 0)
                     (eq (jonb-size (fcrt-shared-registry
                        (fcrt-route-shared warm))) 2))) 256))

            ; A timed-out publication never reaches fcrt-publish and retains
            ; its alternative as the reason to steer/observe.
            (let ready3 (ritj-ready state7 93))
            (let timed (ritjb-offer-step (nth ready3 0)
                (ritjb-envelope channel 7 93 "publish"
                    (list 3 1 route1) "pause-and-observe" 9) 10))
            (let c9 (ritjb-bit (and (str_eq (ritj-result-signal timed) "timeout")
                (and (nothing? (ritj-result-value timed))
                     (node_eq (ritj-current-id (ritj-result-state timed))
                        (fcrt-route-identity route2)))) 512))

            ; Exact returned 0 and 1 are present.  Unbound is absence.
            (let zprog (list (list 1 0)))
            (let oprog (list (list 1 1)))
            (let z (fcrt-route-invoke (ritjb-route "arriving/zero" zprog 0 1)
                (fcrt-route-shared warm) 7))
            (let o (fcrt-route-invoke (ritjb-route "arriving/one" oprog 0 1)
                (fcrt-route-shared z) 7))
            (let absent (fcrt-route-invoke (fcrt-unbound-route)
                (fcrt-route-shared o) 7))
            (let c10 (ritjb-bit (and (eq (fcrt-route-present? z) 1)
                (and (eq (fcrt-route-value z) 0)
                (and (eq (fcrt-route-present? o) 1)
                (and (eq (fcrt-route-value o) 1)
                     (nothing? (fcrt-route-value absent)))))) 1024))

            ; A wrong accept NodeID becomes choice, not a borrowed current
            ; route and not integer zero.
            (let ready4 (ritj-ready (ritj-result-state timed) 94))
            (let wrong (ritjb-offer-step (nth ready4 0)
                (ritjb-envelope channel 8 94 "accept-program"
                    (list 13 5 3 "release/13") (make_nodeid 9 9 9 9) -1) 10))
            (let c11 (ritjb-bit (and (str_eq (ritj-result-signal wrong) "choice")
                (and (eq (ritj-result-present? wrong) 1)
                     (not (eq (ritj-result-value wrong) 0)))) 2048))

            ; Accept then cut through the same ingress.  Cut returns releaser
            ; and the exact flow; undo exposes replay tokens plus pinned seam.
            (let good13 (ritjb-offer-step (ritj-result-state wrong)
                (ritjb-envelope channel 9 94 "accept-program"
                    (list 13 7 3 "release/13")
                    (fcrt-route-identity route2) -1) 10))
            (let cut13 (ritjb-offer-step (ritj-result-state good13)
                (ritjb-envelope channel 10 94 "cut-flow" 13 "abstain" -1) 10))
            (let c12 (ritjb-bit (and (str_eq (ritj-result-signal cut13) "cut")
                (and (eq (ritj-result-present? cut13) 1)
                     (str_eq (nth (ritj-result-value cut13) 0) "release/13"))) 4096))
            (let undo13 (ritjb-offer-step (ritj-result-state cut13)
                (ritjb-envelope channel 11 94 "undo" 13 "abstain" -1) 10))
            (let c13 (ritjb-bit (and (str_eq (ritj-result-signal undo13) "value")
                (le-eid-eq? (nth (ritj-result-value undo13) 1)
                    (le-eid 2 1))) 8192))

            ; Unknown movement is a choice of the offered alternative.
            (let unknown (ritjb-offer-step (ritj-result-state undo13)
                (ritjb-envelope channel 12 94 "invent" 42 "release" -1) 10))
            (let c14 (ritjb-bit (and (str_eq (ritj-result-signal unknown) "choice")
                (str_eq (ritj-result-value unknown) "release")) 16384))

            ; Both diagnostic organs remain bounded and retain newest causal
            ; movement without recording any recipe bytes.
            (let final (ritj-result-state unknown))
            (let c15 (ritjb-bit (and (eq (len (ritj-events final)) 6)
                (and (le (len (rai-events (ritj-ingress final))) 6)
                     (eq (nth (nth (ritj-events final) 5) 0) 94))) 32768))

            ; The arriving symbol is data in this band only, absent from both
            ; resident organs.  No fixed route table was extended.
            (let ingress-source (read_file
                "form/form-stdlib/resident-async-ingress.fk"))
            (let wheel-source (read_file
                "form/form-stdlib/form-cli-resident-turnwheel.fk"))
            (let join-source (read_file
                "form/form-stdlib/resident-ingress-turnwheel-join.fk"))
            (let c16 (ritjb-bit (and (eq (str_find ingress-source symbol 0) -1)
                (and (eq (str_find wheel-source symbol 0) -1)
                     (eq (str_find join-source symbol 0) -1))) 65536))

            (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16))))

    (resident-ingress-turnwheel-join-band))
