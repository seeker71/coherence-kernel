; form-cli-nodeid-knowledge-on-demand-carrier-band.fk — pure carrier shape and
; refusal proof.  It deliberately does not open host-exec; the live crossing is
; exercised by form-cli-nodeid-knowledge-on-demand-live-band.fk.
;
; Verdict 4095.
; preludes: form-stdlib/form-cli-nodeid-knowledge-on-demand-carrier.fk

(do
    (let bad (fcnkc-query "bad key;touch"))
    (sum (list
        (if (eq (fcnkc-surface-admitted? "query:defn-psci-schema") 1) 1 0)
        (if (eq (fcnkc-surface-admitted? "query:@1.2.3.4") 1) 2 0)
        (if (eq (fcnkc-surface-admitted? "stage:current:defn-psci-schema") 1) 4 0)
        (if (eq (fcnkc-surface-admitted? "bad key") 0) 8 0)
        (if (eq (fcnkc-surface-admitted? "bad;key") 0) 16 0)
        (if (eq (fcnkc-surface-admitted? "bad'key") 0) 32 0)
        (if (ge (str_find bad "status=nothing" 0) 0) 64 0)
        (if (ge (str_find bad "reason=carrier-surface-not-admitted" 0) 0) 128 0)
        (if (ge (str_find bad "carrier=on-demand-fkwu-source-unit" 0) 0) 256 0)
        (if (ge (str_find bad "carrier-boundary=host-exec-stdout-v1" 0) 0) 512 0)
        (if (ge (str_find bad "child-exit=unobserved" 0) 0) 1024 0)
        (if (and (str_eq (fcnkc-query "")
                    (fcnkc-refuse "nodeid-knowledge"
                        "carrier-surface-not-admitted"))
                 (eq (str_find (fcnkc-stage "current" "bad key")
                        "nodeid-stage\nstatus=nothing" 0) 0)) 2048 0))))
