; bml-import-ref-resolution-band.bml — a `ref` target resolves at COMPILE time
; against the section's classes and its declared imports; the resolved refs are
; usable abstractions at runtime, four-way.
;
; import NAME;        declares an external abstraction available to refs
; ref X = Target();   must resolve to a same-section class OR a declared import,
;                     else the source-compiler errors at the ref site (proven
;                     separately by a direct compile that fails).
;
; Widget refs Num (allowed because `import Num;` is declared) and Seed (a
; same-section class). Both refs compile and their descriptor preserves order.
; The imported abstraction is supplied by a real prelude. Both target values
; are read at runtime; an unresolved target cannot hide in an uncalled method.
; Computed inside the one section form so it reads identically on every kernel.
;
; preludes: form-stdlib/core.fk form-stdlib/tests/bml-import-ref-fixture.bml

section [form.bml] {
    import Num;

    class Seed<T> {
        field val = 41;
    }

    class Widget<E> {
        ref base = Num();
        ref seed = Seed();
        field k = 7;
    }

    // the descriptor records both refs in declaration order (index 5 = refs)
    let refs = Widget()[5];
    let nrefs = len(refs);
    let r0 = (String) refs[0] == "base" ? 1 : 0;
    let r1 = (String) refs[1] == "seed" ? 1 : 0;
    // the same-section ref is usable at runtime as the Seed abstraction
    let ns = (String) seed()[1] == "Seed" ? 1 : 0;
    let imported = base();
    ((String) imported[1] == "Num") && ((Comparable) imported-value() == 13) ? 0 : form_error("imported abstraction did not arrive through its prelude");
    // 1 + 1*10 + 1*100 + 2*1000 = 2111
    (ns + ((r0 * 10) + ((r1 * 100) + (nrefs * 1000))));
}
