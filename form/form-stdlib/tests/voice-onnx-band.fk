; voice-onnx-band.fk — the voice model, read by the body and held against the crossing.
;
; Every number pinned below was produced twice on 2026-09-08: once by the body
; (`voice-onnx.bml`, `voice-phoneme.bml`, `voice-native.bml`) and once by the named
; crossing that `voice-say.bml` still speaks through — piper's own phonemizer and id
; lane, onnxruntime's view of the graph's doors, and numpy reading the same file bytes
; at the offsets the body's own walk computed. Where the two disagreed, the FILE was
; opened by hand and the winner recorded; that happened once and is bit 256's comment.
;
; The band is silent: it opens no audio device, calls nothing in voice-say's speaking
; half, and reads only bytes already on this disk.
;
;   1     the voice file is a model by the structural check (its fields tile it exactly)
;   2     the voice's own .onnx.json is NOT a model and answers an EMPTY table
;   4     the model names its producer and ir version
;   8     401 initializers
;   16    all 401 rows account for their own bytes (dims x element width == raw bytes)
;   32    15,650,556 parameters in 62,602,544 bytes
;   64    2755 nodes over 50 distinct operators
;   128   the three doors the model eats through, exactly as onnxruntime names them
;   256   the door it answers through, exactly as the FILE holds it
;   512   the phoneme embedding is 256x192 and its 256 is the json's num_symbols
;   1024  eight weights decoded from IEEE-754 by the body == numpy at the same bytes
;   2048  the voice's own configuration, read natively
;   4096  the body's phoneme->id row == piper's own row, digit for digit
;   8192  a phoneme this voice has no id for is dropped and COUNTED, row unchanged
;   16384 the first encoder stage computed by the body == the reference fold, exactly
;   32768 all 29 tongues voice-say names are on disk AND are models by the same check
;
; Expected: 65535
; Verdict 65535
; PROOF LEVEL: FOURTH-ARM ONLY (host file reads over the voice store)
; preludes: form/form-stdlib/voice-native.bml form/form-stdlib/voice-say.bml
(do
    (defn vb-bit (ok v) (if ok v 0))
    (defn vb-voice () "en_GB-jenny_dioco-medium")
    (defn vb-path () (vp-model-path (vb-voice)))
    (defn vb-nl () (byte_to_str 10))
    (defn vb-lines (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (str_concat (vb-nl) (vb-lines (tail xs))))))

    ; piper's phonemes for "the body is learning to speak." in this voice, one to an entry,
    ; taken from the crossing itself so the body's id lane is fed exactly what piper feeds its own
    (defn vb-phonemes () (list "ð" "ə" " " "b" "ˈ" "ɒ" "d" "ɪ" "ʲ" " " "ɪ" "z" " " "l" "ˈ" "ɜ" "ː" "n" "ɪ" "ŋ" " " "t" "ə" " " "s" "p" "ˈ" "i" "ː" "k" "."))
    ; and the ids piper answered for exactly those phonemes
    (defn vb-ids-ref () "1 0 41 0 59 0 3 0 15 0 120 0 52 0 17 0 74 0 119 0 3 0 74 0 38 0 3 0 24 0 120 0 62 0 122 0 26 0 74 0 44 0 3 0 32 0 59 0 3 0 31 0 28 0 120 0 21 0 122 0 23 0 10 0 2")
    ; numpy's reading of the eight float32 at the body's own offset for embedding row 14
    (defn vb-weights-ref () "0.005034 -0.057903 -0.029965 0.009466 -0.019774 0.096737 0.028926 0.011609")
    ; the reference's first six scaled channels print as -0.274000 where the body prints -0.274;
    ; same number, and the body trims a trailing zero rather than padding one
    (defn vb-stage-ref () "0.069748 -0.802331 -0.415201 0.131159 -0.274 1.340433")

    (let p (vb-path))
    (let cfg (vp-cfg (vb-voice)))
    (let rows (vo-inits p))
    (let phs (vb-phonemes))
    (let ids (vp-ids cfg phs))
    (let emb (vo-find rows "sid"))

    (let b1 (vb-bit (eq (vo-model? p) 1) 1))
    ; a JSON text is not a protobuf; the door must answer an empty table rather than
    ; rows of nothing — this is ear-npz's 7720-confident-rows wound, refused in advance
    (let b2 (vb-bit (if (eq (vo-model? (str_concat p ".json")) 0) (eq (len (vo-inits (str_concat p ".json"))) 0) 0) 2))
    (let b4 (vb-bit (if (str_eq (vo-producer p) "pytorch") (eq (vo-ir p) 8) 0) 4))
    (let b8 (vb-bit (eq (len rows) 401) 8))
    (let b16 (vb-bit (eq (vo-sound-count rows) 401) 16))
    (let b32 (vb-bit (if (eq (vo-param-sum rows) 15650556) (eq (vo-byte-sum rows) 62602544) 0) 32))
    (let census (vo-op-census p))
    (let b64 (vb-bit (if (eq (vo-node-count p) 2755) (eq (len census) 50) 0) 64))
    (let b128 (vb-bit (str_eq (vo-io-text (vo-inputs p)) (vb-lines (list "input int64 [batch_size,phonemes]" "input_lengths int64 [batch_size]" "scales float [3]"))) 128))
    ; onnxruntime reports this shape as [batch_size,1,1,...]; its own inference replaced the
    ; symbol. The bytes at 63060012 read `0a 06 12 04 "time"` — a dim_param, not a dim_value —
    ; so the body reports what the file holds and the reference reports what it inferred.
    (let b256 (vb-bit (str_eq (vo-io-text (vo-outputs p)) (vb-lines (list "output float [batch_size,time,1,Unsqueezeoutput_dim_3]"))) 256))
    (let b512 (vb-bit (if (str_eq (vo-dims-text (vo-dims emb)) "256x192") (eq (head (vo-dims emb)) (vp-num-symbols cfg)) 0) 512))
    (let b1024 (vb-bit (str_eq (vo-floats-text (vo-floats p emb (mul 14 192) 8)) (vb-weights-ref)) 1024))
    (let b2048 (vb-bit (if (eq (vp-sample-rate cfg) 22050)
                          (if (eq (vp-num-speakers cfg) 1)
                              (if (eq (vp-num-symbols cfg) 256)
                                  (if (str_eq (vp-phoneme-type cfg) "espeak")
                                      (if (str_eq (vp-espeak-voice cfg) "en-gb-x-rp")
                                          (eq (vp-table-size (vp-map cfg)) 154) 0) 0) 0) 0) 0) 2048))
    (let b4096 (vb-bit (if (eq (len ids) 65) (str_eq (vp-ints-text ids) (vb-ids-ref)) 0) 4096))
    ; this voice's table stops at 153 and carries no "g" at all; piper's default map has one at 154.
    ; A phoneme with no id must fall out of the row and be counted falling.
    (let mute (append phs (list "g")))
    (let b8192 (vb-bit (if (eq (vp-dropped cfg mute) 1)
                          (if (eq (vp-dropped cfg phs) 0)
                              (vp-ints-eq? (vp-ids cfg mute) ids) 0) 0) 8192))
    (let stage (vn-stage-sum p rows ids))
    (let b16384 (vb-bit (if (eq (vn-channels rows) 192)
                           (if (str_eq (float_to_str (vn-scale p rows)) "13.856406")
                               (if (eq (vn-stage-values rows ids) 12480)
                                   (if (str_eq (float_to_str stage) "-108.150229")
                                       (str_eq (vn-floats-text (vn-row p rows 14 6)) (vb-stage-ref)) 0) 0) 0) 0) 16384))
    ; the mouth must not get worse: every tongue voice-say names still has its model here,
    ; and every one of those models still reads as a model through the body's own door
    (defn vb-all-models? (rs) (if (eq (len rs) 0) 1 (if (eq (vo-model? (vs-model (head (head rs)))) 1) (vb-all-models? (tail rs)) 0)))
    (let b32768 (vb-bit (if (eq (vs-mouth-count) 29) (eq (vb-all-models? (vs-voices)) 1) 0) 32768))

    (add b1 (add b2 (add b4 (add b8 (add b16 (add b32 (add b64 (add b128 (add b256 (add b512 (add b1024 (add b2048 (add b4096 (add b8192 (add b16384 b32768)))))))))))))))
)
