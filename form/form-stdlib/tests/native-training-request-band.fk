; A sub-micro learning rate must survive request creation and worker serialization.
; preludes: form-stdlib/native-lora-train.bml
(do
 (let rate (str_to_float "1.25e-7"))
 (let request (ntr-request "model" "adapter" "data" "out" 1 2 rate 1 8))
 (let written (json-emit-precise request))
 (let parsed (parse-json "training-request" written))
 (let okay (and (eq (ntr-get request "learning_rate") rate) (eq (ntr-get parsed "learning_rate") rate)))
 (print (list "learning-rate" (float-precise-str (ntr-get parsed "learning_rate")) "preserved" okay))
 (if okay 3 (form_error "training request changed the learning rate")))
