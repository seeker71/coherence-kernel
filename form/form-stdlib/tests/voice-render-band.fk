; preludes: form-stdlib/core.fk form-stdlib/trig.fk form-stdlib/voice-formant.fk form-stdlib/voice-render.fk form-stdlib/voiced-reading.fk
;
; voice-render-band — the body's voice becomes a real WAV, and the body hears it back. Four-way.
;
; Every number here was PROBED from the body before it was written down. The file WRITE is a host
; carrier and is not exercised in this band — a band that wrote a file would prove the carrier, not
; the composition. What is proven is the composition and the loop, both pure: samples → wire bytes →
; samples → f0. On disk it has been witnessed too, and separately: 6444 bytes written at 16 kHz,
; 3200 samples read back, f0 heard 165 against f0 spoken 165, `ffprobe` confirming pcm_s16le/8000/mono
; on the 8 kHz twin — recorded in the receipt, not asserted here, because reading a binary file back
; is exactly the door that does NOT cross four-way.
;
; Verdict 511 when every claim lands (the f64 wire's claims live in f64-wire-band.fk — split out
; because the pre-flattened fourth-arm lane miscomputes them there; see that band's header):
;   1    the header is the canonical 44 bytes
;   2    its sizes are computed, not stamped: 4 samples → RIFF size 44 (36+8), data length 8
;   4    the fmt block says what the ear expects — rate 16000 (byte 24 = 128), byte-rate 32000
;        (byte 28 = 0), block align 2, 16 bits. A header that lied here would be read at the wrong
;        speed and every f0 would come back wrong by exactly that ratio.
;   8    a positive sample is little-endian: 1000 → (232, 3)
;   16   a negative sample is TWO'S COMPLEMENT, not a sign flag: −1000 → (24, 252)
;   32   the rail CLAMPS, it does not wrap: 40000 → (255, 127) = 32767, and −40000 → (0, 128) =
;        −32768. A wrap would turn a loud peak into a loud peak of the opposite sign — audible as a
;        click, and read by the ear as a discontinuity. Clipping is honest distortion; wrapping is a
;        quiet lie about the waveform.
;   64   the file is 44 + 2n bytes, from the samples themselves
;   128  DETERMINISM: the same samples give the same bytes, twice
;   256  THE LOOP. voice-formant.fk speaks Sema's chosen voice at f0 = 165 Hz; voice-render.fk turns
;        those samples into the 16-bit wire bytes a WAV carries; the band decodes those same bytes
;        back to samples; and voiced-reading.fk hears 165 Hz out of them. Mouth to wire to ear, with
;        no oracle anywhere in the circuit and nothing rented — the body's own two halves meeting.
(do
    (defn vwb-eq (a b)
        (if (nil? a) (if (nil? b) 1 0)
            (if (nil? b) 0
                (if (eq (head a) (head b)) (vwb-eq (tail a) (tail b)) 0))))
    ; the wire bytes back to signed samples — the ear's side of the same format
    (defn vwb-dec (bs out)
        (if (nil? bs) (reverse out)
            (do (let u (add (head bs) (mul (head (tail bs)) 256)))
                (vwb-dec (tail (tail bs)) (cons (if (ge u 32768) (sub u 65536) u) out)))))
    (defn vwb-vowel (i n out)
        (if (ge i n) (reverse out) (vwb-vowel (add i 1) n (cons (sema-sample i) out))))

    (let h (vrn-header 16000 4))
    (let c0 (if (eq (len h) 44) 1 0))
    (let c1 (if (eq (nth h 4) 44) (if (eq (nth h 40) 8) 2 0) 0))
    (let c2 (if (eq (nth h 24) 128)
               (if (eq (nth h 28) 0)
                   (if (eq (nth h 32) 2) (if (eq (nth h 34) 16) 4 0) 0) 0) 0))
    (let c3 (if (vwb-eq (vrn-sample-bytes 1000) (list 232 3)) 8 0))
    (let c4 (if (vwb-eq (vrn-sample-bytes -1000) (list 24 252)) 16 0))
    (let c5 (if (vwb-eq (vrn-sample-bytes 40000) (list 255 127))
               (if (vwb-eq (vrn-sample-bytes -40000) (list 0 128)) 32 0) 0))
    (let c6 (if (eq (len (vrn-wav-bytes (list 0.0 0.0 0.0) 16000 100)) 50) 64 0))
    (let c7 (if (vwb-eq (vrn-wav-bytes (list 0.5 -0.5) 16000 1000)
                        (vrn-wav-bytes (list 0.5 -0.5) 16000 1000)) 128 0))

    ; the loop
    (let xs (vwb-vowel 0 900 (list)))
    (let back (vwb-dec (vrn-body xs 40000) (list)))
    (let c8 (if (eq (len back) 900)
               (if (eq (round (vr-f0 back 640 16000 100 400)) 165) 256 0) 0))

    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 c8)))))))))
