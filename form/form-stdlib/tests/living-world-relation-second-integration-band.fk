; living-world-relation-second-integration-band.fk -- both adjacent edges settle.
; Verdict 32767 proves fifteen two-edge consent, independence, and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-active-index.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/living-world-multilens-plan.fk form-stdlib/living-world-composition-outcome.fk form-stdlib/living-world-composition-voice.fk form-stdlib/living-world-relation-hypothesis.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk form-stdlib/tests/living-world-relational-voice-witness.fk form-stdlib/tests/living-world-multilens-witness.fk form-stdlib/tests/living-world-composition-outcome-witness.fk form-stdlib/tests/living-world-relation-hypothesis-witness.fk form-stdlib/tests/living-world-relation-attestation-witness.fk

(do
    (let world LWRHA-WORLD)
    (let index (lwai-index world))
    (let first
        (lwai-relation-proposal-for
            world index LWRHA-OBSERVATION-FIRST 2))
    (let second
        (lwai-relation-proposal-for
            world index LWRHA-OBSERVATION-SECOND 2))
    (let first-candidate (lwt-proposal-candidate first))
    (let second-candidate (lwt-proposal-candidate second))
    (let proposals (lwo-field (list first second)))
    (let round
        (lwt-round world proposals (lwo-empty-field)
            (lwrhw-integrated-round)))
    (let yes-round
        (lwt-round-receive round
            (list
                (lwrvw-relation-response
                    (lwrhw-source-h) (lwrhw-prov-h) first)
                (lwrvw-relation-response
                    (lwrhw-source-i) (lwrhw-prov-i) first)
                (lwrvw-relation-response
                    (lwrhw-source-h) (lwrhw-prov-h) second)
                (lwrvw-relation-response
                    (lwrhw-source-i) (lwrhw-prov-i) second))))
    (let response-world (lwt-round-world yes-round))
    (let response-index (lwai-index response-world))
    (let first-integrated
        (lwai-integrate-relation yes-round first (lwrew-action)))
    (let first-world (lwt-round-world first-integrated))
    (let second-integrated
        (lwai-integrate-relation first-integrated second (lwrew-action)))
    (let integrated-world (lwt-round-world second-integrated))
    (let integrated-index (lwai-index integrated-world))
    (let first-outcome (lwt-outcome-for first-integrated first))
    (let second-outcome (lwt-outcome-for second-integrated second))
    (let first-attributions
        (lwo-active-attributions-for integrated-world first-candidate))
    (let second-attributions
        (lwo-active-attributions-for integrated-world second-candidate))

    (let c1 (if (and (not (node_eq first (lwo-none)))
                         (not (node_eq second (lwo-none)))) 1 0))
    (let c2 (if (and (eq (lwai-relation-candidate-current?
                              response-world response-index
                              first-candidate) 1)
                         (eq (lwai-relation-candidate-current?
                              response-world response-index
                              second-candidate) 1)) 2 0))
    (let c3 (if (and (node_eq (lwt-outcome-status first-outcome)
                              (lwt-status-acknowledged))
                         (node_eq (lwt-outcome-status second-outcome)
                              (lwt-status-acknowledged))) 4 0))
    (let c4 (if (and (eq (lwo-active? first-world first-candidate) 1)
                         (eq (lwo-active? first-world second-candidate) 0)) 8 0))
    (let c5 (if (and (eq (lwo-active? integrated-world
                              first-candidate) 1)
                         (eq (lwo-active? integrated-world
                              second-candidate) 1)) 16 0))
    (let c6 (if (and (eq (lwo-field-size first-attributions) 2)
                         (eq (lwo-field-size second-attributions) 2)) 32 0))
    (let c7 (if (and (eq (lwrh-source-in-attributions?
                              (lwo-field-items first-attributions)
                              (lwcow-source-g)) 0)
                         (eq (lwrh-source-in-attributions?
                              (lwo-field-items second-attributions)
                              (lwcow-source-g)) 0)) 64 0))
    (let c8 (if (and (eq (lwo-field-has?
                              (lwt-proposal-participants first)
                              (lwrhw-source-h)) 1)
                         (eq (lwo-field-has?
                              (lwt-proposal-participants second)
                              (lwrhw-source-i)) 1)) 128 0))
    (let c9 (if (and (eq (lwai-relation-candidate-current?
                              integrated-world integrated-index
                              first-candidate) 1)
                         (eq (lwai-relation-candidate-current?
                              integrated-world integrated-index
                              second-candidate) 1)) 256 0))
    (let c10 (if (and (eq (lwai-emergent-ready?
                               integrated-index first-candidate) 1)
                          (eq (lwai-emergent-ready?
                               integrated-index second-candidate) 1)) 512 0))
    (let c11 (if (and (eq (lwt-outcome-yes first-outcome) 2)
                          (eq (lwt-outcome-yes second-outcome) 2)) 1024 0))
    (let c12 (if (and (eq (lwt-outcome-no first-outcome) 0)
                          (eq (lwt-outcome-no second-outcome) 0)) 2048 0))
    (let c13 (if (node_eq (lwrl-observation-evidence
                               LWRHA-OBSERVATION-SECOND)
                              LWRHA-ATTESTATION-SECOND) 4096 0))
    (let c14 (if (eq (lwo-field-size
                          (lwt-round-outcomes second-integrated)) 1) 8192 0))
    (let c15 (if (node_eq (lwt-round-prior second-integrated)
                          first-integrated) 16384 0))
    (lwrhw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
