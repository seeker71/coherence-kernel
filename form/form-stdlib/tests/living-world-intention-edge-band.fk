; living-world-intention-edge-band.fk -- observed delta seams cross consent.
; Verdict 32767 proves fifteen continuity, evidence, admission, and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/tests/living-world-intention-graph-witness.fk

(do
    (let fixture (lwigw-build-fixture))
    (let base (lwigw-fixture-world fixture))
    (let a (lwigw-a fixture))
    (let b (lwigw-b fixture))
    (let c (lwigw-c fixture))
    (let d (lwigw-d fixture))
    (let observed (lwigw-linear-observed-world fixture))
    (let ab-observation (lwigw-support-with-unknown a b d))
    (let bc-observation (lwigw-support b c))
    (let ab-evidence (lwig-evidence-for observed a b))
    (let bc-evidence (lwig-evidence-for observed b c))
    (let ab-proposal (lwig-edge-proposal observed ab-observation 2))
    (let bc-proposal (lwig-edge-proposal observed bc-observation 2))
    (let ab-candidate (lwt-proposal-candidate ab-proposal))
    (let edge-round
        (lwt-round observed (lwo-field (list ab-proposal))
            (lwo-empty-field) (lwigw-fixture-round fixture)))
    (let waiting
        (lwig-edge-integrate edge-round ab-proposal (lwigw-action)))
    (let linear (lwigw-linear-worlds fixture))
    (let stop-world (nth linear 0))
    (let linear-world (nth linear 1))
    (let integrated-ab (nth linear 2))
    (let integrated-bc (nth linear 3))
    (let late-dissent
        (lwig-observation a b (oac-zero)
            (lwo-empty-field) (lwo-none) (lwigw-evidence)))
    (let moved-world
        (lwt-receive-stream linear-world
            (list (lwigw-entry-u late-dissent))))

    (let c1 (if (and (eq (lwac-execution-integrated-current? base a) 1)
                         (and (eq (lwac-execution-integrated-current?
                                   base b) 1)
                              (and (eq (lwac-execution-integrated-current?
                                       base c) 1)
                                   (eq (lwac-execution-integrated-current?
                                       base d) 1)))) 1 0))
    (let c2 (if (and (node_eq (lwig-execution-delta a)
                               (lwigw-delta-a))
                         (and (node_eq (lwig-execution-delta b)
                                      (lwigw-delta-b))
                              (node_eq (lwig-execution-delta d)
                                   (lwigw-delta-d)))) 2 0))
    (let c3 (if (and (eq (lwig-continuous? a b) 1)
                         (and (eq (lwig-continuous? b c) 1)
                              (and (eq (lwig-continuous? a d) 1)
                                   (eq (lwig-continuous? d a) 1)))) 4 0))
    (let c4 (if (and (eq (lwig-continuous? a c) 0)
                         (node_eq
                           (lwig-edge-proposal observed
                             (lwigw-support a c) 2)
                           (lwo-none))) 8 0))
    (let c5 (if (and (eq (lwig-observation-valid? ab-observation) 1)
                         (eq (lwig-observation-valid?
                              (lwigw-silence b c)) 1)) 16 0))
    (let c6 (if (and (eq (lwig-support-count ab-evidence) 2)
                         (eq (lwo-field-size
                              (lwig-evidence-alternatives ab-evidence)) 1))
                    32 0))
    (let c7 (if (and (eq (lwig-support-count bc-evidence) 2)
                         (eq (lwo-field-size
                              (lwig-evidence-silences bc-evidence)) 1))
                    64 0))
    (let c8 (if (and (eq (lwo-field-size
                              (lwo-emergent-witnesses ab-candidate)) 7)
                         (eq (lwo-field-size
                              (lwt-proposal-participants ab-proposal)) 5))
                    128 0))
    (let c9 (if (and (not (node_eq ab-proposal (lwo-none)))
                         (not (node_eq bc-proposal (lwo-none)))) 256 0))
    (let c10 (if (eq (lwo-active?
                          (lwt-round-world waiting) ab-candidate) 0) 512 0))
    (let c11 (if (and (eq (lwig-edge-integrated-current?
                               stop-world integrated-ab) 1)
                          (eq (lwig-edge-integrated-current?
                               stop-world integrated-bc) 0)) 1024 0))
    (let c12 (if (and (eq (lwig-edge-integrated-current?
                               linear-world integrated-ab) 1)
                          (eq (lwig-edge-integrated-current?
                               linear-world integrated-bc) 1)) 2048 0))
    (let c13 (if (and (node_eq (lwig-edge-left
                                 (lwo-emergent-shape integrated-ab)) a)
                          (node_eq (lwig-edge-right
                                 (lwo-emergent-shape integrated-ab)) b))
                     4096 0))
    (let c14 (if (and (eq (lwig-edge-candidate-current?
                               moved-world integrated-ab) 0)
                          (eq (lwig-edge-candidate-current?
                               moved-world integrated-bc) 1)) 8192 0))
    (let c15 (if (and (node_eq (lwig-edge-path
                                 (lwo-emergent-shape integrated-ab))
                               (lwo-local-path))
                          (eq (lwig-edge-proposal-current?
                               observed ab-proposal) 1)) 16384 0))
    (lwigw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
