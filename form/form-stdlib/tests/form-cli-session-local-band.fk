; form-cli-session-local-band.fk — log counts without transcripts.
;
; Verdict 1023:
;   1..128  fsl-check (fresh census, leak 104/390, event-local 894153ppm, drop, unresolved)
;   256     class descriptor FormSessionLocal minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-router.fk
; preludes: ../form-cli-local-ready.bml
; preludes: ../form-cli-one-turn.bml
; preludes: ../form-cli-session-local.bml
; witnessed: 2026-08-26 -> 1023; leak 104/390; event-local 894153ppm; no fixed target

(do
    (defn fslb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn fslb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (fslb-has-name? (tail xs) name))))

    (let bits (fsl-check))
    (let desc (FormSessionLocal))
    (let src (read_file "form/form-stdlib/bml/form-cli-session-local.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormSessionLocal")
                     (and (eq (fslb-has-name? (nth desc 2) "T") 1)
                          (and (eq (fslb-has-name? (nth desc 3) "fsl-leak") 1)
                               (eq (fslb-has-name? (nth desc 4) "CensusRule") 1))))
                256 0))
    (let b9 (if (and (eq (fslb-has-str? src "package Form.cli.sessionlocal") 1)
                     (and (eq (fslb-has-str? src "interface ISessionLocal") 1)
                          (and (eq (fslb-has-str? src "class FormSessionLocal") 1)
                               (and (eq (fslb-has-str? src "const String CensusRule") 1)
                                    (eq (fslb-has-str? src "template SessionRow") 1)))))
                512 0))
    (add bits (add b8 b9)))
