; living-world-branch-overlap-band.fk -- overlap remains plural and scoped
; compost retires one view without erasing shared tissue.
; Verdict 65535 proves sixteen overlap, optionality, consent, release, history,
; and authority properties.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-continuity-branch.fk form-stdlib/living-world-branch-overlap.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-compost.fk form-stdlib/tests/living-world-branch-overlap-witness.fk

(do
    (let branch-a (lwbow-branch-a))
    (let branch-b (lwbow-branch-b))
    (let world-a (lwcb-branch-world branch-a))
    (let world-b (lwcb-branch-world branch-b))
    (let overlap (lwbow-overlap))
    (let minimal (lwbow-minimal-contention))
    (let layered (lwbow-layered-contention))
    (let proposal-a (lwbow-proposal-a))
    (let proposal-b (lwbow-proposal-b))
    (let candidate-a (lwbow-candidate-a))
    (let candidate-b (lwbow-candidate-b))
    (let after-a (lwbow-after-a-world))
    (let restored (lwbow-restored-world))
    (let after-a-leaves-b (lwbow-after-a-leaves-b))
    (let compost-proposal (lwbow-compost-proposal-a))
    (let compost-plan (lwt-proposal-candidate compost-proposal))
    (let partial-world (lwbow-partial-compost-world))
    (let partial-outcome
        (lwt-evaluate-proposal partial-world compost-proposal))
    (let partial-transition (lwbow-partial-transition))
    (let unanimous-world (lwbow-unanimous-compost-world))
    (let transition (lwbow-compost-transition))
    (let successor (lwbow-successor-world))
    (let receipt (lwbow-compost-receipt))
    (lwbow-sum
        (list
            ; Both exact capability projections are valid and distinct.
            (if (and (eq (lwcb-branch-valid? branch-a) 1)
                     (and (eq (lwcb-branch-valid? branch-b) 1)
                          (not (node_eq branch-a branch-b)))) 1 0)
            ; Each projection carries the same cell plus only its local route.
            (if (and (eq (lwo-field-size (lwo-world-cells world-a)) 2)
                     (and (eq (lwo-field-size
                                (lwo-world-cells world-b)) 2)
                          (and (eq (lwo-active? world-a
                                    (lwbow-relation-a)) 1)
                               (and (eq (lwo-active? world-a
                                        (lwbow-relation-b)) 0)
                                    (and (eq (lwo-active? world-b
                                            (lwbow-relation-a)) 0)
                                         (eq (lwo-active? world-b
                                            (lwbow-relation-b)) 1)))))) 2 0)
            ; Both shared-cell holders participate in either projection.
            (if (and (eq (lwo-field-size
                                (lwcb-branch-participants branch-a)) 2)
                     (eq (lwo-field-size
                                (lwcb-branch-participants branch-b)) 2)) 4 0)
            ; Exact overlap contains one cell, both shared attributions, one
            ; cross-branch conflict, and the two unranked routes.
            (if (and (eq (lwbo-overlap-valid? overlap) 1)
                     (and (eq (lwo-field-size
                                (lwbo-overlap-cells overlap)) 1)
                          (and (eq (lwo-field-size
                                    (lwbo-overlap-attributions overlap)) 2)
                               (and (eq (lwo-field-size
                                        (lwbo-overlap-conflicts overlap)) 1)
                                    (eq (lwo-field-size
                                        (lwbo-overlap-routes overlap)) 2))))) 8 0)
            ; A contention can leave every descriptive option absent.
            (if (and (eq (lwbo-contention-valid? minimal) 1)
                     (and (node_eq (lwbo-contention-declaration minimal)
                                (lwo-none))
                          (and (node_eq (lwbo-contention-lens minimal)
                                    (lwo-none))
                               (and (eq (lwo-field-size
                                        (lwbo-contention-alternatives minimal)) 0)
                                    (node_eq
                                        (lwbo-contention-unknowable minimal)
                                        (lwo-none)))))) 16 0)
            ; Or it can retain offered declaration, lens, additional
            ; alternative, and unknowable tissue without choosing a route.
            (if (and (eq (lwbo-contention-valid? layered) 1)
                     (and (node_eq (lwbo-contention-declaration layered)
                                (lwbow-declaration))
                          (and (node_eq (lwbo-contention-lens layered)
                                    (lwbow-lens))
                               (and (eq (lwo-field-size
                                        (lwbo-contention-alternatives layered)) 1)
                                    (node_eq
                                        (lwbo-contention-unknowable layered)
                                        (lwbow-unknown)))))) 32 0)
            ; There is no selected route slot: the complete contention shape
            ; has only overlap plus four optional surfaces and local path.
            (if (and (eq (len (node_children minimal)) 6)
                     (eq (lwo-field-size
                            (lwbo-overlap-routes
                                (lwbo-contention-overlap minimal))) 2)) 64 0)
            ; Restore proposals are distinct, current, and need both holders.
            (if (and (not (node_eq proposal-a proposal-b))
                     (and (eq (lwcb-restore-current?
                                (lwbow-admission-world) candidate-a) 1)
                          (and (eq (lwcb-restore-current?
                                    (lwbow-admission-world) candidate-b) 1)
                               (and (eq (lwo-field-size
                                        (lwt-proposal-participants proposal-a)) 2)
                                    (eq (lwo-field-size
                                        (lwt-proposal-participants proposal-b)) 2))))) 128 0)
            ; Restoring A imports the shared cell and A route, not B's route.
            (if (and (eq (lwo-active? after-a (lwbow-shared)) 1)
                     (and (eq (lwo-active? after-a
                                (lwbow-relation-a)) 1)
                          (and (eq (lwo-active? after-a
                                    (lwbow-relation-b)) 0)
                               (eq (lwcb-restored? after-a candidate-b) 0)))) 256 0)
            ; Restoring B preserves two shared provenance paths and both
            ; incompatible relations instead of overwriting either.
            (if (and (eq (lwo-active-by? restored
                                (lwbow-shared) (lwbow-source-a)) 1)
                     (and (eq (lwo-active-by? restored
                                (lwbow-shared) (lwbow-source-b)) 1)
                          (and (eq (lwo-active? restored
                                    (lwbow-relation-a)) 1)
                               (eq (lwo-active? restored
                                    (lwbow-relation-b)) 1)))) 512 0)
            ; Each restored candidate is held by both exact participants.
            (if (and (eq (lwcb-restored? restored candidate-a) 1)
                     (and (eq (lwcb-restored? restored candidate-b) 1)
                          (and (eq (lwo-field-size
                                (lwo-active-attributions-for
                                    restored candidate-a)) 2)
                               (eq (lwo-field-size
                                (lwo-active-attributions-for
                                    restored candidate-b)) 2)))) 1024 0)
            ; A can leave only A's attribution to B.  B's attribution keeps
            ; B's restore active and A cannot write B's revocation edge.
            (if (and (eq (lwo-attribution-revoked?
                                after-a-leaves-b candidate-b
                                (lwbow-source-a)) 1)
                     (and (eq (lwo-attribution-revoked?
                                after-a-leaves-b candidate-b
                                (lwbow-source-b)) 0)
                          (eq (lwcb-restored?
                                after-a-leaves-b candidate-b) 1))) 2048 0)
            ; Scoped compost binds the exact A restore and both holders while
            ; leaving every descriptive option absent.
            (if (and (eq (lwbo-compost-plan? compost-plan) 1)
                     (and (node_eq (lwbo-compost-candidate compost-plan)
                                candidate-a)
                          (and (node_eq (lwbo-compost-branch compost-plan)
                                    branch-a)
                               (and (eq (lwo-field-size
                                    (lwbo-compost-participants compost-plan)) 2)
                                    (and (node_eq
                                        (lwbo-compost-declaration compost-plan)
                                        (lwo-none))
                                         (eq (lwo-field-size
                                            (lwbo-compost-alternatives
                                                compost-plan)) 0)))))) 4096 0)
            ; One holder cannot retire a jointly held restore.
            (if (and (node_eq (lwt-outcome-status partial-outcome)
                                (lwt-status-waiting))
                     (and (eq (lwt-outcome-yes partial-outcome) 1)
                          (and (eq (lwt-outcome-missing partial-outcome) 1)
                               (and (eq (oac-zero?
                                    (lwo-transition-ack partial-transition)) 1)
                                    (node_eq
                                        (lwo-transition-world partial-transition)
                                        partial-world))))) 8192 0)
            ; Unanimity retires only A's restore candidate; B remains active.
            (if (and (eq (oac-node? (lwo-transition-ack transition)) 1)
                     (and (eq (lwbo-compost-receipt? receipt) 1)
                          (and (eq (lwcb-restored? successor candidate-a) 0)
                               (eq (lwcb-restored? successor candidate-b) 1)))) 16384 0)
            ; Scoped compost deletes no shared or route tissue.  The prior and
            ; successor roots stay exact, and global shared-cell compost is
            ; still refused while its source attributions are active.
            (if (and (eq (lwo-active? successor (lwbow-shared)) 1)
                     (and (eq (lwo-active? successor
                                (lwbow-relation-a)) 1)
                          (and (eq (lwo-active? successor
                                    (lwbow-relation-b)) 1)
                               (and (node_eq
                                    (lwbo-receipt-prior-world receipt)
                                    unanimous-world)
                                    (and (node_eq
                                        (lwbo-receipt-successor-world receipt)
                                        successor)
                                         (node_eq
                                            (lwc-compost-proposal
                                                successor (lwbow-shared))
                                            (lwo-none))))))) 32768 0))))
