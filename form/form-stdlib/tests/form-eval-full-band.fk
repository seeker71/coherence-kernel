; tests/form-eval-full-band.fk — the source tree-walk extended to full Form, evaluated directly by the cursor,
; no flatten, four-way. The first three source strings are the P1 floor (do/let/defn/calls + mul) — their sum
; stays 131 so a regression there is loud. The Phase-2 strings exercise the data-driven op table and the
; literal-keyword table grown in P2:
;   P1 floor (unchanged):
;     (let x 6 (mul x 7))                               -> 42   (let + mul)
;     (do (defn sq (x) (mul x x)) (sq 7))               -> 49   (do + defn + user call)
;     (do (defn dbl (n) (add n n)) (dbl (dbl 10)))      -> 40   (nested user call)  [P1 sum = 131]
;   P2 new ops (table-driven): div/mod/lt/gt/ge/ne/and/or/not — each contributes, summed below:
;     (div 85 2)                                        -> 42   (div)
;     (mod 142 100)                                     -> 42   (mod)
;     (if (lt 3 5) 42 0)                                -> 42   (lt)
;     (if (gt 5 3) 42 0)                                -> 42   (gt)
;     (if (ge 5 5) 42 0)                                -> 42   (ge)
;     (if (ne 1 2) 42 0)                                -> 42   (ne)
;     (if (and 1 1) 42 0)                               -> 42   (and)
;     (if (or 0 1) 42 0)                                -> 42   (or)
;     (if (not 0) 42 0)                                 -> 42   (not + literal absence)
;   P2 literal keywords (table-driven):
;     (if true 42 0)                                    -> 42   (true)
;     (if false 0 42)                                   -> 42   (false)
;     (if (eq nothing 0) 0 42)                          -> 42   (nothing is NOT 0)
;   P3 value kinds (2026-08-27 — strings, floats, lists, and the eval-native prim table, each -> 42):
;     string literal + str_len; str_concat + str_eq; str_find; the escape set \n \" \\ ;
;     cons/list/nth; append/len; int_to_str; str_to_int; float arithmetic promoting against int;
;     float_to_str self-consistency (format is the arm's own — never pinned across arms);
;     a string crossing a defn body and a user call; strings holding parens inside a SKIPPED
;     defn body and a SKIPPED if arm (the string-aware skip walk); nothing? as a prim.
;   P4 fleet-healed covenants (2026-08-27 adversarial fleet, each -> 42):
;     a missing name answers ABSENCE, never a spin (the old assume-presence lookup hung the fkwu
;     floor forever); calling a non-function (a let-bound var) answers absence; a digit-led
;     malformed literal (123abc) answers absence for the whole token instead of silently splitting;
;     a lone trailing backslash at source end is a literal backslash, never a minted '?';
;     exponent float literals (1e2) and str_to_float; the last unexercised prim rows
;     (str_byte_at, substring, head, tail, empty) in one witnessed sum.
; Verdict: 131 (P1) + 12*42 (P2) + 13*42 (P3) + 6*42 (P4) = 1433. If 1433 crosses four-way
; (incl fkwu, our c-bootstrap), the data-driven op/literal/prim tables evaluate off the cursor with
; no flatten, and P1/P2/P3 still hold.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk
(do
    (add
        ; P1 floor — unchanged, sums to 131
        (add (fef-eval "(let x 6 (mul x 7))")
            (add (fef-eval "(do (defn sq (x) (mul x x)) (sq 7))")
                 (fef-eval "(do (defn dbl (n) (add n n)) (dbl (dbl 10)))")))
        ; P2 — nine new ops + three literals, each yielding 42
        (add (fef-eval "(div 85 2)")
        (add (fef-eval "(mod 142 100)")
        (add (fef-eval "(if (lt 3 5) 42 0)")
        (add (fef-eval "(if (gt 5 3) 42 0)")
        (add (fef-eval "(if (ge 5 5) 42 0)")
        (add (fef-eval "(if (ne 1 2) 42 0)")
        (add (fef-eval "(if (and 1 1) 42 0)")
        (add (fef-eval "(if (or 0 1) 42 0)")
        (add (fef-eval "(if (not 0) 42 0)")
        (add (fef-eval "(if true 42 0)")
        (add (fef-eval "(if false 0 42)")
        (add (fef-eval "(if (eq nothing 0) 0 42)")
        ; P3 — value kinds through the same fragment-crossing evaluator
        (add (fef-eval "(if (eq (str_len \"hello\") 5) 42 0)")
        (add (fef-eval "(if (str_eq (str_concat \"for\" \"ty-two\") \"forty-two\") 42 0)")
        (add (fef-eval "(if (eq (str_find \"coherence\" \"here\" 0) 2) 42 0)")
        (add (fef-eval "(if (eq (str_len \"a\\nb\\\"c\\\\d\") 7) 42 0)")
        (add (fef-eval "(if (eq (nth (cons 40 (list 41 42 43)) 3) 43) 42 0)")
        (add (fef-eval "(if (eq (len (append (list 1 2) (list 3))) 3) 42 0)")
        (add (fef-eval "(if (str_eq (int_to_str 42) \"42\") 42 0)")
        (add (fef-eval "(if (eq (str_to_int \"1042\") 1042) 42 0)")
        (add (fef-eval "(if (eq (mul 2.5 4) 10) 42 0)")
        (add (fef-eval "(if (str_eq (float_to_str 2.5) (float_to_str 2.5)) 42 0)")
        (add (fef-eval "(do (defn greet (w) (str_concat \"hi \" w)) (if (str_eq (greet \"sema\") \"hi sema\") 42 0))")
        (add (fef-eval "(do (defn ghostly () \"a(b c)\") (if 1 42 (str_len \"un(reached\")))")
        (add (fef-eval "(if (nothing? nothing) 42 0)")
        ; P4 — fleet-healed covenants
        (add (if (nothing? (fef-eval "zzz")) 42 0)
        (add (if (nothing? (fef-eval "(let f 5 (f 1))")) 42 0)
        (add (if (nothing? (fef-eval "123abc")) 42 0)
        (add (if (str_eq (fef-eval "\"ab\\") "ab\\") 42 0)
        (add (fef-eval "(if (eq (mul 1e2 (str_to_float \"1\")) 100) 42 0)")
             (fef-eval "(if (eq (add (str_byte_at (substring \"xhello\" 1 6) 0) (add (len (tail (list 1 2 3))) (add (head (list 30 9)) (len (empty))))) 136) 42 0)")))))))))))))))))))))))))))))))))
