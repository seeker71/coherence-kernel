; situated-evidence-authority-band.fk — prove exact, fresh, independent,
; distinct, non-equivocating admission under caller-declared authority.
; preludes: form-stdlib/core.fk form-stdlib/core-word-inquiry.fk form-stdlib/situated-lens-conclusion.fk form-stdlib/situated-evidence-authority.fk

(do
    (defn seab-bit (condition bit) (if condition bit 0))
    (defn seab-sum (values)
        (if (eq (len values) 0) 0
            (add (head values) (seab-sum (tail values)))))

    (let lens (cwi-lens 1 2 3 4))
    (let offered (slc-observation 10 lens 1 6 9001))
    (let policy (sea-policy (list 7001 7002 7003) 2 3))
    (let a (sea-endorsement 7001 9001 10 lens 1 6 11))
    (let b (sea-endorsement 7002 9001 10 lens 1 6 12))
    (let admitted (sea-admit offered (list a b) policy 13))
    (let duplicate (sea-admit offered (list a a) policy 13))
    (let unauthorized
        (sea-admit offered
            (list a (sea-endorsement 7999 9001 10 lens 1 6 12))
            policy 13))
    (let stale
        (sea-admit offered
            (list a (sea-endorsement 7002 9001 10 lens 1 6 8))
            policy 13))
    (let future
        (sea-admit offered
            (list a (sea-endorsement 7002 9001 10 lens 1 6 14))
            policy 13))
    (let wrong-lens
        (sea-admit offered
            (list a (sea-endorsement
                7002 9001 10 (cwi-lens 1 2 3 5) 1 6 12))
            policy 13))
    (let wrong-time
        (sea-admit offered
            (list a (sea-endorsement 7002 9001 11 lens 1 6 12))
            policy 13))
    (let wrong-source
        (sea-admit offered
            (list a (sea-endorsement 7002 9002 10 lens 1 6 12))
            policy 13))
    (let wrong-push
        (sea-admit offered
            (list a (sea-endorsement 7002 9001 10 lens 1 5 12))
            policy 13))
    (let equivocation
        (sea-admit offered
            (list a b (sea-endorsement 7001 9001 10 lens 0 6 13))
            policy 13))
    (let self-source
        (sea-admit offered
            (list a (sea-endorsement 9001 9001 10 lens 1 6 12))
            (sea-policy (list 7001 9001) 2 3) 13))
    (let invalid-policy
        (sea-admit offered (list a b)
            (sea-policy (list 7001 7001) 2 3) 13))
    (let invalid-endorsement
        (sea-admit offered (list a (list 7002 9001))
            policy 13))
    (let stale-contradiction
        (sea-admit offered
            (list a b (sea-endorsement 7001 9001 10 lens 0 6 8))
            policy 13))
    (let unauthorized-contradiction
        (sea-admit offered
            (list a b (sea-endorsement 7999 9001 10 lens 0 6 13))
            policy 13))

    ; 2097151 means all 21 observations held.
    (seab-sum
        (list
            (seab-bit (eq (sea-o-admitted admitted) 1) 1)
            (seab-bit (eq (sea-o-reason admitted) 0) 2)
            (seab-bit (eq (sea-o-fresh-distinct admitted) 2) 4)
            (seab-bit (eq (sea-o-required admitted) 2) 8)
            (seab-bit (eq (sea-o-exact admitted) 2) 16)
            (seab-bit (eq (sea-o-admitted duplicate) 0) 32)
            (seab-bit
                (and (eq (sea-o-fresh-distinct duplicate) 1)
                     (eq (sea-o-reason duplicate) 2)) 64)
            (seab-bit (eq (sea-o-admitted unauthorized) 0) 128)
            (seab-bit
                (and (eq (sea-o-admitted stale) 0)
                     (eq (sea-o-stale-exact stale) 1)) 256)
            (seab-bit (eq (sea-o-admitted future) 0) 512)
            (seab-bit (eq (sea-o-admitted wrong-lens) 0) 1024)
            (seab-bit (eq (sea-o-admitted wrong-time) 0) 2048)
            (seab-bit (eq (sea-o-admitted wrong-source) 0) 4096)
            (seab-bit
                (and (eq (sea-o-admitted wrong-push) 0)
                     (eq (sea-o-reason wrong-push) 3)) 8192)
            (seab-bit
                (and (eq (sea-o-admitted equivocation) 0)
                     (eq (sea-o-equivocator equivocation) 7001)) 16384)
            (seab-bit (eq (sea-o-admitted self-source) 0) 32768)
            (seab-bit (eq (sea-o-reason invalid-policy) 1) 65536)
            (seab-bit (eq (sea-o-reason invalid-endorsement) 1) 131072)
            (seab-bit (eq (sea-o-admitted stale-contradiction) 1) 262144)
            (seab-bit
                (and (eq (sea-policy-valid? policy) 1)
                     (eq (sea-o-admitted
                            (sea-admit offered (list a)
                                (sea-policy (list 7001) 1 3) 13)) 1))
                524288)
            (seab-bit
                (eq (sea-o-admitted unauthorized-contradiction) 1)
                1048576))))
