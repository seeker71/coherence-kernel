; tests/sha256-list-floor-band.fk — the private list floor held against the shared one.
;
; PROOF LEVEL: FOURTH-ARM ONLY (fkwu) — `nothing?` binds on fkwu alone. The
; edge bits read fkwu's `nothing` where Go, Rust and TS answer null: one
; contract on four kernels since a61bdbb90 (see EDGES). The recipe itself
; agrees across the kernels — the same three FIPS digests come back byte for
; byte.
;
; preludes: form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/str-byte-at.fk
;
; THE QUESTION
;   `bearing-census` named `nth-rec` (sha256.fk) the door the body leans on
;   hardest — 76,254,048 calls on the locale walk, 39.0% of the walking — while
;   `nth` stands native at tag 23. The census offered `check against the native
;   nth` as a lead and refused to call it a proof: a stem match is not a
;   meaning. A private floor sometimes exists precisely because the shared one
;   refused what its caller needed. This band asks instead of assuming.
;
;   `s2lf-nth-walked` below IS the walked body that stood in sha256.fk. It is
;   kept here, under its own name, so both meanings stay readable side by side
;   and any future divergence has something to be caught against.
;
; WHERE THEY ARE ONE
;   Every index inside the list: same element, whatever the element is — an
;   int, or a list. That is the whole of what sha256 asks of an index, and
;   every `nth` call site in sha256.fk is in range by construction: state and
;   h8 are 8-lists read at 0..7, k-list and w-list are 64-lists read at 0..63,
;   a block is 64 bytes read at 0..63, and build-schedule's i-15, i-2, i-16,
;   i-7 for i in 16..63 land in 0..61 of a list already i long.
;
; WHERE THEY PART — and it is the walked form that is the weaker one
;   At a NEGATIVE index the walked form does not answer at all. Its base case
;   is an equality with 0 and its step is (sub i 1), so from -1 the index moves
;   strictly further from the only value that stops it: measured 2026-09-07 at
;   `(nth-rec (list 10 20 30) -1)`, exit 124 under a 30-second bound, no output.
;   The native answers immediately. Bit 32 witnesses that descent finitely,
;   without running it — a band may not hang to make a point.
;
; EDGES
;   `eq` on two lists meets them by their items, as value_eq does. The band
;   still compares sublists with `s2lf-list-eq`, elementwise, so the reading
;   names the element that differs rather than one bit for the whole.
;
;   An element that is not there answers `nothing`: past the end, on an empty
;   list, and at a NEGATIVE index alike (a61bdbb90: head, tail and nth read
;   the tag bit, and a receiver or element that is not there is nothing on
;   fkwu, null on Go, Rust and TS). The walked form answers `nothing` past the
;   end and on the empty list too, through `head` of the empty list. There
;   they are one. At a negative index the walked form still does not return
;   (bit 32).
;
;   No caller in this tree stands at a negative index — every `nth-rec` site
;   in the body indexes in range (merkle.fk's sibling-at guards its idx+1 and
;   reaches idx-1 only on an odd idx; bloom.fk's p/8 of a 32-byte filter and
;   off/off+1 of a 32-byte digest; file-byte-digest.fk's 0..7 of an 8-state),
;   so the digests do not stand on the walked form's descent.
;
; THE DIGESTS
;   sha256.fk is this body's content addressing: every node id, every
;   mc-anchor, the substrate registry, the jungle's voice identities. Bits 1024
;   through 16384 are the pin — FIPS 180-4's own vectors and the two sides of
;   the 56/64-byte padding boundary, written out in hex rather than summed, so
;   a digest cannot move without this band saying which one and how.
;
; Verdict 32767 when every claim lands.

(do
    (defn s2lf-bit (ok w) (if (eq ok 1) w 0))

    ;; Structural, elementwise. Its boundary: `len` of an int is 0, so it reads
    ;; ANY non-list as the empty list. Used only where both sides are lists by
    ;; construction; the edges are asserted with `nothing?` instead.
    (defn s2lf-list-eq (a b)
        (if (eq (len a) (len b))
            (if (eq (len a) 0) 1
                (if (eq (head a) (head b)) (s2lf-list-eq (tail a) (tail b)) 0))
            0))
    (defn s2lf-same (a b) (if (eq a b) 1 0))

    ;; the walked body, kept as the reference meaning
    (defn s2lf-nth-walked (xs i)
        (if (eq i 0) (head xs) (s2lf-nth-walked (tail xs) (sub i 1))))

    ;; the walked appends, likewise
    (defn s2lf-append-1-walked (xs x)
        (if (nil? xs) (list x) (cons (head xs) (s2lf-append-1-walked (tail xs) x))))
    (defn s2lf-append-list-walked (xs ys)
        (if (nil? xs) ys (cons (head xs) (s2lf-append-list-walked (tail xs) ys))))
    (defn s2lf-nil?-walked (xs) (eq (len xs) 0))

    (defn s2lf-str-bytes-loop (s i n acc)
        (if (ge i n) acc
            (s2lf-str-bytes-loop s (add i 1) n (append-1 acc (str_byte_at s i)))))
    (defn s2lf-str-bytes (s)
        (s2lf-str-bytes-loop s 0 (str_len s) (list)))

    (defn s2lf-digest-is (bytes want)
        (if (str_eq (hex-encode (sha256 bytes)) want) 1 0))
    (defn s2lf-stream-is (s want)
        (if (str_eq (hex-encode (sha256-stream-string s)) want) 1 0))

    (let xs (list 10 20 30))
    (let ys (list (list 1 2) (list 3 4)))

    ;; ---- 1: one meaning at every index inside the list ----
    (let in-range
        (if (and (eq (s2lf-same (nth xs 0) (s2lf-nth-walked xs 0)) 1)
            (and (eq (s2lf-same (nth xs 1) (s2lf-nth-walked xs 1)) 1)
                 (eq (s2lf-same (nth xs 2) (s2lf-nth-walked xs 2)) 1))) 1 0))

    ;; ---- 2: an element that is itself a list travels whole ----
    (let nested
        (if (and (eq (s2lf-list-eq (nth ys 0) (s2lf-nth-walked ys 0)) 1)
            (and (eq (s2lf-list-eq (nth ys 1) (s2lf-nth-walked ys 1)) 1)
                 (eq (len (nth ys 1)) 2))) 1 0))

    ;; ---- 4: past the end — one meaning, and it is `nothing` ----
    (let past
        (if (and (eq (nothing? (nth xs 3)) 1)
            (and (eq (nothing? (s2lf-nth-walked xs 3)) 1)
            (and (eq (nothing? (nth xs 99)) 1)
                 (eq (nothing? (s2lf-nth-walked xs 99)) 1)))) 1 0))

    ;; ---- 8: an empty list at 0 — one meaning, and it is `nothing` ----
    (let on-empty
        (if (and (eq (nothing? (nth (empty) 0)) 1)
                 (eq (nothing? (s2lf-nth-walked (empty) 0)) 1)) 1 0))

    ;; ---- 16: at a negative index the native answers `nothing` ----
    ;; No element stands there, at -1 and at -4 alike, and the first element
    ;; does not stand in for one: `nothing?` says so, where a comparison with
    ;; `(head xs)` would have to be read as its absence.
    (let neg-native
        (if (and (eq (nothing? (nth xs (sub 0 1))) 1)
                 (eq (nothing? (nth xs (sub 0 4))) 1)) 1 0))

    ;; ---- 32: the walked form's descent never reaches its base case ----
    ;; asserted finitely: at -1 the guard is false and the step moves further away
    (let neg-walked-descends
        (if (and (eq (eq (sub 0 1) 0) 0)
            (and (eq (lt (sub (sub 0 1) 1) (sub 0 1)) 1)
                 (eq (lt (sub (sub 0 1) 1) 0) 1))) 1 0))

    ;; ---- 64: sha256.fk's own indices are in range by construction ----
    (let sites-in-range
        (if (and (eq (len (sha256-h-init)) 8)
            (and (eq (len (sha256-k)) 64)
                 (eq (len (sha256-stream-initial)) 4))) 1 0))

    ;; ---- 128: nil? — the private copy and core's are one ----
    (let nil-one
        (if (and (eq (s2lf-same (nil? (empty)) (s2lf-nil?-walked (empty))) 1)
            (and (eq (s2lf-same (nil? (list 1)) (s2lf-nil?-walked (list 1))) 1)
            (and (eq (nil? (empty)) 1)
                 (eq (nil? (list 1 2 3)) 0)))) 1 0))

    ;; ---- 256: append-1 means (append xs (list x)) ----
    (let append1-one
        (if (and (eq (s2lf-list-eq (append-1 (empty) 7) (append (empty) (list 7))) 1)
            (and (eq (s2lf-list-eq (append-1 (list 1) 7) (append (list 1) (list 7))) 1)
            (and (eq (s2lf-list-eq (append-1 xs 7) (append xs (list 7))) 1)
                 (eq (s2lf-list-eq (append-1 xs 7) (s2lf-append-1-walked xs 7)) 1)))) 1 0))

    ;; ---- 512: append-list means core's append ----
    (let appendlist-one
        (if (and (eq (s2lf-list-eq (append-list (empty) xs) (append (empty) xs)) 1)
            (and (eq (s2lf-list-eq (append-list xs (empty)) (append xs (empty))) 1)
            (and (eq (s2lf-list-eq (append-list xs xs) (append xs xs)) 1)
                 (eq (s2lf-list-eq (append-list xs xs) (s2lf-append-list-walked xs xs)) 1)))) 1 0))

    ;; ---- 1024 / 2048 / 4096: FIPS 180-4, written out ----
    (let d-empty
        (s2lf-digest-is (empty)
            "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))
    (let d-abc
        (s2lf-digest-is (list 97 98 99)
            "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))
    (let d-two-block
        (s2lf-digest-is
            (s2lf-str-bytes "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
            "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"))

    ;; ---- 8192: the streaming entry answers the same as the byte-list entry ----
    (let d-stream
        (if (and (eq (s2lf-stream-is ""
                        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") 1)
            (and (eq (s2lf-stream-is "abc"
                        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") 1)
                 (eq (s2lf-stream-is "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
                        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1") 1))) 1 0))

    ;; ---- 16384: both sides of the 56/64-byte padding boundary ----
    (let d-boundary
        (if (and (eq (s2lf-digest-is
                        (s2lf-str-bytes "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz1234")
                        "8cbfb4d9886d0f70a2a1f53014059795e9fdcbfdea0f4d675b0f1e85b2168fc9") 1)
                 (eq (s2lf-digest-is
                        (s2lf-str-bytes "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz12345678")
                        "65c8d8ba5bd0d9fb502812ccdc68070e1ba8d5cba50e96a03ab1663cfa82354d") 1)) 1 0))

    (add (s2lf-bit in-range 1)
    (add (s2lf-bit nested 2)
    (add (s2lf-bit past 4)
    (add (s2lf-bit on-empty 8)
    (add (s2lf-bit neg-native 16)
    (add (s2lf-bit neg-walked-descends 32)
    (add (s2lf-bit sites-in-range 64)
    (add (s2lf-bit nil-one 128)
    (add (s2lf-bit append1-one 256)
    (add (s2lf-bit appendlist-one 512)
    (add (s2lf-bit d-empty 1024)
    (add (s2lf-bit d-abc 2048)
    (add (s2lf-bit d-two-block 4096)
    (add (s2lf-bit d-stream 8192)
         (s2lf-bit d-boundary 16384))))))))))))))))
