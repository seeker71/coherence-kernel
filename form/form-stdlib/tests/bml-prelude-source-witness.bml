// Source descriptions remain text; actual indented directives load in order.
// A quoted directive in this comment has no dependency meaning:
// "// preludes: observe/missing-prelude-example.bml"
  // preludes: form-stdlib/core.fk
	// preludes: form-stdlib/scale.bml
section [form.bml] {
 class BmlPreludeSourceWitness {
  def bpsw-example() = "// preludes: observe/missing-prelude-example.bml";
  def bpsw-quoted() = "text \\\"// preludes: observe/missing-quoted-example.bml\\\" remains text";
  def bpsw-multiline() = "description begins
// preludes: observe/missing-multiline-example.bml
description ends";
  def bpsw-semicolon() = "; preludes: observe/missing-quoted-only.fk ";
  def bpsw-semicolons() = ";first;;last;";
  def bpsw-run() {
   let literal = ((String) bpsw-example() == "// preludes: observe/missing-prelude-example.bml");
   let quoted = (str_find(bpsw-quoted(),"missing-quoted-example",0) >= 0);
   let multiline = (str_find(bpsw-multiline(),"missing-multiline-example",0) >= 0);
   let semicolon = ((String) bpsw-semicolon() == str_concat(byte_to_str(59)," preludes: observe/missing-quoted-only.fk "));
   let repeated = (((Comparable) str_len(bpsw-semicolons()) == 13) && (((Comparable) str_byte_at(bpsw-semicolons(),6) == 59) && ((Comparable) str_byte_at(bpsw-semicolons(),7) == 59)));
   if (literal && (quoted && (multiline && (semicolon && repeated)))) then (ppm-scale() + 7) else 0;
  }
 }
 bpsw-run();
}
