// Source descriptions remain text; actual indented directives load in order.
// A quoted directive in this comment has no dependency meaning:
// "// preludes: observe/missing-prelude-example.bml"
  // preludes: form-stdlib/core.fk
	// preludes: form-stdlib/scale.bml
section [form.bml] {
 class BmlPreludeSourceWitness {
  def bpsw-example() = "// preludes: observe/missing-prelude-example.bml";
  def bpsw-quoted() = "text \\\"// preludes: observe/missing-quoted-example.bml\\\" remains text";
  def bpsw-multiline() = "description begins
// preludes: observe/missing-multiline-example.bml
description ends";
  def bpsw-semicolon() = "; preludes: observe/missing-quoted-only.fk ";
  def bpsw-semicolons() = ";first;;last;";
  def bpsw-run() {
   let literal = str_eq(bpsw-example(),"// preludes: observe/missing-prelude-example.bml");
   let quoted = ge(str_find(bpsw-quoted(),"missing-quoted-example",0),0);
   let multiline = ge(str_find(bpsw-multiline(),"missing-multiline-example",0),0);
   let semicolon = str_eq(bpsw-semicolon(),str_concat(byte_to_str(59)," preludes: observe/missing-quoted-only.fk "));
   let repeated = and(eq(str_len(bpsw-semicolons()),13),and(eq(str_byte_at(bpsw-semicolons(),6),59),eq(str_byte_at(bpsw-semicolons(),7),59)));
   if and(literal,and(quoted,and(multiline,and(semicolon,repeated)))) then add(ppm-scale(),7) else 0;
  }
 }
 bpsw-run();
}
