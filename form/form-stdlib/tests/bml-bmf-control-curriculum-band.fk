; bml-bmf-control-curriculum-band.fk -- held-out control execution witness.
;
; Expected: 1048575
; witnessed: 2026-08-24 -> direct fkwu
; preludes: form-stdlib/core.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml-bmf-stream-curriculum.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk control/offer-ack-core.fk control/choice-lane-core.fk form-stdlib/jit-decision.fk observe/inquiry-planes.fk form-stdlib/bml-bmf-control-curriculum.fk form-stdlib/bml-bmf-control-curriculum.bml

(do
    (defn bbccb-bit (ok bit) (if ok bit 0))
    (defn bbccb-run ()
        (do
            (let manifest (bbcc-manifest))
            (let tie (bbcc-evidence-choice 7 bbcc-cell-twelve 7 bbcc-cell-thirty-four (list)))
            (let left (bbcc-evidence-choice 9 bbcc-cell-twelve 7 bbcc-cell-thirty-four (list)))
            (let right (bbcc-evidence-choice 7 bbcc-cell-twelve 9 bbcc-cell-thirty-four (list)))
            (let fallback (bbcc-evidence-choice 9 bbcc-cell-silent 7 bbcc-cell-thirty-four (list)))
            (let cut (oac-cut-with-receipt (list bbcc-cell-silent bbcc-cell-thirty-four) (list)))
            (let good (bbsc-finish
                (bbsc-feed-chunk (bbsc-open (bbsc-heldout-grammar) 8) "signal=12;")))
            (let checkpoint (oac-store good))
            (let bad (bbsc-feed-chunk (bbsc-open (bbsc-heldout-grammar) 8) "signal=x;"))
            (let restored (oac-undo (oac-nothing) checkpoint bad))
            (let kept (oac-undo (bbcc-cell-twelve (list)) checkpoint bad))
            (let timed (oac-timeout-walk
                (list bbcc-cell-silent bbcc-cell-silent bbcc-cell-thirty-four) (list) 2))
            (let exhausted (oac-timeout-walk
                (list bbcc-cell-silent bbcc-cell-silent) (list) 5))
            (let nv (bbcc-nothing-vector))
            (let which-route (bbcc-thought-route "which" 6000 300))
            (let why-route (bbcc-thought-route "why" 6000 300))
            (let unknown-route (bbcc-thought-route "whence" 6000 300))
            (let hot (bbcc-auto-jit-plan 6 1 8000 2000 20))
            (let warm (bbcc-auto-jit-plan 3 1 8000 2000 20))
            (let impure (bbcc-auto-jit-plan 6 0 8000 2000 20))
            (let cool (bbcc-auto-jit-plan 1 1 8000 2000 20))
            (sum (list
                (bbccb-bit (eq (bbcc-manifest-has?
                    "choice-executes-first-evidenced-winner" manifest) 1) 1)
                (bbccb-bit (nothing? tie) 2)
                (bbccb-bit (eq (bbcc-ack-int left) 12) 4)
                (bbccb-bit (eq (bbcc-ack-int right) 34) 8)
                (bbccb-bit (eq (bbcc-ack-int fallback) 34) 16)
                (bbccb-bit
                    (and (oac-nothing? (oac-cut-receipt-ack cut))
                         (eq (oac-cut-receipt-pruned cut) 1))
                    32)
                (bbccb-bit (bbsc-state-equivalent? restored checkpoint) 64)
                (bbccb-bit (bbsc-state-equivalent? kept bad) 128)
                (bbccb-bit
                    (and (eq (oac-timed-out? timed) 1)
                         (and (oac-nothing? (oac-timeout-ack timed))
                              (eq (oac-timeout-alts-left timed) 1)))
                    256)
                (bbccb-bit
                    (and (eq (oac-timed-out? exhausted) 0)
                         (and (oac-nothing? (oac-timeout-ack exhausted))
                              (eq (oac-timeout-alts-left exhausted) 0)))
                    512)
                (bbccb-bit
                    (and (nothing? (nth nv 0))
                         (and (eq (nth nv 1) 1)
                         (and (eq (nth nv 2) 0)
                         (and (eq (nth nv 3) 0)
                         (and (eq (nth nv 4) 0)
                              (eq (nth nv 5) 0))))))
                    1024)
                (bbccb-bit
                    (and (str_eq (nth which-route 2) "computable")
                         (eq (nth which-route 3) 0))
                    2048)
                (bbccb-bit
                    (and (str_eq (nth why-route 2) "learned")
                         (eq (nth why-route 3) 20))
                    4096)
                (bbccb-bit (nothing? unknown-route) 8192)
                (bbccb-bit
                    (and (str_eq (bbcc-jit-plan-route hot) "crystallize-plan")
                         (and (eq (bbcc-jit-plan-value hot) 300)
                              (eq (bbcc-jit-plan-live-native? hot) 0)))
                    16384)
                (bbccb-bit (str_eq (bbcc-jit-plan-route warm) "form-walk") 32768)
                (bbccb-bit (str_eq (bbcc-jit-plan-route impure) "form-walk") 65536)
                (bbccb-bit (str_eq (bbcc-jit-plan-route cool) "melt-to-form") 131072)
                (bbccb-bit (eq (bbcc-bml-check) 15) 262144)
                (bbccb-bit
                    (and (eq (len (bbcc-training-rows)) 3)
                         (and (eq (len (bbcc-heldout-rows)) 3)
                         (and (eq (bbcc-exact-leakage) 0)
                              (eq (bbcc-manifest-has?
                                  "live-native-jit-needs-carrier-proof" manifest) 1))))
                    524288)))))
    (bbccb-run))
