// host-napper-run.fk — a Form child that waits one second and leaves by itself: the worker that is not wedged.
//
// voice-track-reap-band spawns it to see a supervisor only wait for a child that ends on its own.
//
// preflight-exec: forbidden
section [form.bml] {
  let slept = host_sleep_ms(1000);
  0;
}
