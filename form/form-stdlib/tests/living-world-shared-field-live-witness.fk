; living-world-shared-field-live-witness.fk -- public hex lines exercise the
; live carrier without embedding their fixture vocabulary in the carrier.
;
; preludes: form-stdlib/core.fk observe/live-call-framebuffer.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-session-observation.fk form-stdlib/living-world-session-learning.fk form-stdlib/living-world-shared-field-channel.fk form-stdlib/living-world-shared-field-continuity.fk form-stdlib/living-world-generative-continuation.fk form-stdlib/living-world-shared-field-live.fk form-stdlib/tests/living-world-generative-continuation-witness.fk

(let LWSFLW-CLOSE (bp "LWSFLW-CLOSE"))

(defn lwsflw-close () (intern_node LWSFLW-CLOSE (empty)))
(defn lwsflw-prefix () "/tmp/coherence-living-world-live-band")
(defn lwsflw-path (ordinal)
    (str_concat (lwsflw-prefix)
        (str_concat "." (str_concat (int_to_str ordinal) ".ccs"))))
(defn lwsflw-clean (ordinal)
    (do
        (let path (lwsflw-path ordinal))
        (let removed (if (eq (fs-exists? path) 1)
            (fs-remove-file path) 0))
        (let pending (lwcd-pending-path path))
        (if (eq (fs-exists? pending) 1)
            (fs-remove-file pending) 0)))
(defn lwsflw-config (persist)
    (lwsfl-open 2 (lwsgw-action) (lwo-none) (lwo-none)
        (lwo-empty-field) persist (lwsflw-close) (lwsgw-evidence)))
(defn lwsflw-projected-request ()
    (lwsg-request (lwsgw-context-a) (lwo-none) (lwo-none)
        (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none) 0
        (lwsgw-projection)))

(defn lwsflw-run ()
    (do
        (let clean-1 (lwsflw-clean 1))
        (let clean-2 (lwsflw-clean 2))
        (let clean-3 (lwsflw-clean 3))

        ; Reuse only the public world identity; the live carrier still receives
        ; its request as a dynamically decoded canonical line.
        (let generated (lwsgw-run))
        (let full-world (nth generated 10))
        (let state (lwsf-state full-world 2 (lwsgw-action) (lwo-none)))
        (let config
            (lwsflw-config (intern_trivial_string (lwsflw-prefix))))
        (let config-line (lwsfl-hex-cell config))
        (let opened-new
            (lwsfl-open-line
                (lwsfl-hex-cell (lwsflw-config (lwo-none)))))
        (let opened
            (lwsfl-session state config (oac-one state) (lwo-none)))

        (let malformed (lwsfl-decode-line "00"))
        (let uppercase
            (lwsfl-decode-line
                (str_concat "D" (substring config-line 1
                    (str_len config-line)))))
        (let roundtrip (lwsfl-decode-line config-line))

        (let started
            (lcfb-open-stream "living-world-shared-field-live-witness"
                "form-native" "lwsflw-run" "dynamic-hex-cells"
                "form/form-stdlib/tests/living-world-shared-field-live-witness.fk"
                57 13))
        (let unknown-receipt
            (lwsfl-accept-line opened
                (lwsfl-hex-cell (lwsgw-evidence)) started 1))
        (let after-unknown (lwsfl-receipt-session unknown-receipt))
        (let request (lwsflw-projected-request))
        (let request-entry
            (lwsgw-entry (lwsgw-source-a) request (lwsgw-prov-a)))
        (let request-line (lwsfl-hex-cell request-entry))
        (let request-receipt
            (lwsfl-accept-line after-unknown request-line started 2))
        (let trace (lwsfl-receipt-trace request-receipt))
        (let persistence-1 (lwsfl-receipt-persistence unknown-receipt))
        (let persistence-2 (lwsfl-receipt-persistence request-receipt))
        (let loaded-2
            (lwcd-load (lwsflw-path 2) (lwsgw-evidence)))
        (let repeated
            (lwsfl-accept-line after-unknown request-line started 2))
        (let repeated-persistence
            (lwsfl-receipt-persistence repeated))
        (let events (framebuffer-events))

        (let result
            (list config config-line opened-new opened malformed uppercase
                roundtrip unknown-receipt request request-entry request-line
                request-receipt trace persistence-1 persistence-2 loaded-2
                repeated repeated-persistence events))
        (let cleanup-1 (lwsflw-clean 1))
        (let cleanup-2 (lwsflw-clean 2))
        (let cleanup-3 (lwsflw-clean 3))
        result))

(defn lwsflw-bit (condition bit) (if condition bit 0))
(defn lwsflw-verdict (result)
    (do
        (let config (nth result 0))
        (let config-line (nth result 1))
        (let opened-new (nth result 2))
        (let opened (nth result 3))
        (let malformed (nth result 4))
        (let uppercase (nth result 5))
        (let roundtrip (nth result 6))
        (let unknown-receipt (nth result 7))
        (let request (nth result 8))
        (let request-entry (nth result 9))
        (let request-line (nth result 10))
        (let request-receipt (nth result 11))
        (let trace (nth result 12))
        (let persistence-1 (nth result 13))
        (let persistence-2 (nth result 14))
        (let loaded-2 (nth result 15))
        (let repeated (nth result 16))
        (let repeated-persistence (nth result 17))
        (let events (nth result 18))
        (let before-unknown-world
            (lwsf-state-world (lwsfl-session-state opened)))
        (let after-unknown-world
            (lwsf-state-world
                (lwsfl-session-state
                    (lwsfl-receipt-session unknown-receipt))))
        (let before-unknown-trace
            (lwsg-generate before-unknown-world
                (lwsgw-open-request (lwsgw-context-a))))
        (add
            (lwsflw-bit (and (eq (lwsfl-hex-valid? config-line) 1)
                (eq (lwsfl-decoded-canonical? roundtrip) 1)) 1)
        (add (lwsflw-bit (node_eq (lwsfl-decoded-cell roundtrip) config) 2)
        (add (lwsflw-bit (eq (lwsfl-decoded-canonical? malformed) 0) 4)
        (add (lwsflw-bit (eq (lwsfl-decoded-canonical? uppercase) 0) 8)
        (add (lwsflw-bit (and (eq (oac-one?
                (lwsfl-session-ack opened-new)) 1)
                (eq (lwsf-state? (lwsfl-session-state opened-new)) 1)) 16)
        (add (lwsflw-bit (and (eq (lwsfl-receipt-canonical?
                unknown-receipt) 1)
                (eq (oac-zero? (lwsfl-receipt-ack unknown-receipt)) 1)) 32)
        (add (lwsflw-bit (and (eq (lwo-field-size
                (lwo-world-cells before-unknown-world))
                (lwo-field-size (lwo-world-cells after-unknown-world)))
                (and (eq (lwo-field-size
                    (lwo-world-attributions before-unknown-world))
                    (lwo-field-size
                        (lwo-world-attributions after-unknown-world)))
                     (eq (lwsg-trace-current?
                        after-unknown-world before-unknown-trace) 1))) 64)
        (add (lwsflw-bit (and (eq (lwsfl-hex-valid? request-line) 1)
                (node_eq (lwsfl-decoded-cell
                    (lwsfl-decode-line request-line)) request-entry)) 128)
        (add (lwsflw-bit (eq (oac-one?
                (lwsfl-receipt-ack request-receipt)) 1) 256)
        (add (lwsflw-bit (and (eq (lwsg-trace? trace) 1)
                (eq (len (lwsg-turn-items (lwsg-trace-turns trace))) 3)) 512)
        (add (lwsflw-bit (str_eq (lwsg-trace-rendered trace)
                "seed grows.") 1024)
        (add (lwsflw-bit (node_eq
                (lwsg-request-projection (lwsg-trace-request trace))
                (lwsgw-projection)) 2048)
        (add (lwsflw-bit (and (eq (lwcd-saved? persistence-1) 1)
                (str_eq (lwcd-result-path persistence-1)
                    (lwsflw-path 1))) 4096)
        (add (lwsflw-bit (and (eq (lwcd-saved? persistence-2) 1)
                (str_eq (lwcd-result-path persistence-2)
                    (lwsflw-path 2))) 8192)
        (add (lwsflw-bit (and (eq (lwcd-loaded? loaded-2) 1)
                (node_eq (lwcd-result-image loaded-2)
                    (lwsfc-image (lwsfl-session-state
                        (lwsfl-receipt-session request-receipt))))) 16384)
        (add (lwsflw-bit (and (eq (lwcd-refused? repeated-persistence) 1)
                (node_eq (lwsfl-receipt-trace repeated) trace)) 32768)
        (add (lwsflw-bit (and (eq (lwsfl-close-offered?
                (lwsfl-receipt-session request-receipt) (lwsflw-close)) 1)
                (eq (lwsfl-close-offered?
                    (lwsfl-receipt-session request-receipt) request) 0)) 65536)
        (add (lwsflw-bit (node_eq
                (lwsfl-receipt-prior request-receipt)
                (lwsfl-receipt-session unknown-receipt)) 131072)
        (add (lwsflw-bit (eq (lwsg-trace-current?
                (lwsf-state-world (lwsfl-session-state
                    (lwsfl-receipt-session request-receipt))) trace) 1) 262144)
        (add (lwsflw-bit (ge (len events) 10) 524288)
        (lwsflw-bit (and (eq (fs-exists? (lwsflw-path 1)) 0)
                             (eq (fs-exists? (lwsflw-path 2)) 0))
            1048576)))))))))))))))))))))))

0
