; situated-lens-conclusion-control-band.fk — carrier-free proof of the policy
; and real field actuation used by the framebuffer-bound cycle.
; preludes: form-stdlib/core.fk form-stdlib/core-word-inquiry.fk form-stdlib/situated-lens-conclusion.fk form-stdlib/situated-lens-conclusion-control.fk

(do
    (defn slccb-bit (condition bit) (if condition bit 0))
    (defn slccb-sum (values)
        (if (eq (len values) 0) 0
            (add (head values) (slccb-sum (tail values)))))

    (let lens (cwi-lens 1 2 3 4))
    (let offered (slc-observation 10 lens 1 6 9001))
    (let missing (slc-settle-situated
        "WE" "we" "what" 0 5 (list) 10 lens 1))
    (let repaired (slcc-apply-action
        (slcc-action missing) (list) offered 10 lens
        (slc-o-node missing) 9901))
    (let after-repair (slc-settle-situated
        "WE" "we" "what" 0 5 (slcc-s-field repaired) 10 lens 1))

    (let ambiguous-field
        (list offered (slc-observation 10 lens 0 7 9002)))
    (let ambiguous (slc-settle-situated
        "WE" "we" "what" 0 5 ambiguous-field 10 lens 1))
    (let abstained (slcc-apply-action
        (slcc-action ambiguous) ambiguous-field offered 10 lens
        (slc-o-node ambiguous) 9902))

    (let wrong-offer
        (slc-observation 10 (cwi-lens 2 2 3 4) 1 6 9003))
    (let rejected (slcc-apply-action
        (slcc-action missing) (list) wrong-offer 10 lens
        (slc-o-node missing) 9903))

    (let settled (slc-settle-situated
        "WE" "we" "what" 0 5 (list offered) 10 lens 1))
    (let invalid-field (list (slc-observation 10 lens 1 -1 9004)))
    (let invalid (slc-settle-situated
        "WE" "we" "what" 0 5 invalid-field 10 lens 1))
    (let revised (slcc-apply-action
        (slcc-action invalid) invalid-field offered 10 lens
        (slc-o-node invalid) 9904))
    (let after-revise (slc-settle-situated
        "WE" "we" "what" 0 5 (slcc-s-field revised) 10 lens 1))
    (let payload (slcc-payload missing (list) 10 lens))

    ; 65535 means all 16 observations held.
    (slccb-sum
        (list
            (slccb-bit (eq (slc-o-reason missing) 2) 1)
            (slccb-bit (eq (slcc-action missing) 4) 2)
            (slccb-bit (eq (slcc-s-accepted repaired) 1) 4)
            (slccb-bit (eq (slcc-s-selected repaired) 9001) 8)
            (slccb-bit
                (and (eq (slc-o-kind after-repair) (slc-tag-value))
                     (eq (slc-o-conclusion after-repair) 1)) 16)
            (slccb-bit (eq (slcc-action ambiguous) 3) 32)
            (slccb-bit
                (and (eq (slcc-s-accepted abstained) 1)
                     (eq (slcc-s-selected abstained) 9902)) 64)
            (slccb-bit (eq (len (slcc-s-field abstained)) 2) 128)
            (slccb-bit (eq (slcc-s-accepted rejected) 0) 256)
            (slccb-bit (eq (slcc-s-selected rejected) 9903) 512)
            (slccb-bit (eq (slcc-action settled) 0) 1024)
            (slccb-bit
                (and (eq (nth payload 3) (cwi-lens-rank lens))
                     (eq (nth payload 4) 0)) 2048)
            (slccb-bit (eq (slcc-action invalid) 2) 4096)
            (slccb-bit
                (and (eq (slcc-s-accepted revised) 1)
                     (eq (slcc-s-selected revised) 9001)) 8192)
            (slccb-bit
                (and (eq (slc-o-kind after-revise) (slc-tag-value))
                     (eq (slc-o-source after-revise) 9001)) 16384)
            (slccb-bit (eq (slcc-match-count
                (slcc-s-field repaired) 10 lens) 1) 32768))))
