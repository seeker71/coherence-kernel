; living-world-recipe-binding-band.fk -- offered cells bind native Recipes.
; Verdict 32767 proves fifteen parameter, identity, consent, and revocation claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/tests/living-world-recipe-binding-witness.fk

(do
    (let world-a (lwrbw-world-a))
    (let world-b (lwrbw-world-b))
    (let bindings-a (lwrbw-bindings-a))
    (let bindings-b (lwrbw-bindings-b))
    (let trace-a (lwrbw-trace-a))
    (let trace-b (lwrbw-trace-b))
    (let proposal-a (lwrbw-proposal-a))
    (let duplicate
        (lwre-bindings (list (lwrbw-origin-a) (lwrbw-origin-a))))
    (let unsafe
        (lwre-binding "bad name" (intern_trivial_int 2)
            (intern_trivial_int 2) (lwrbw-evidence)))
    (let old-contract (lwre-form-contract 128 (lwrbw-evidence)))
    (let bound-empty
        (lwre-execute-bound world-a (lwrbw-declaration) (lwrbw-lens)
            (intern_trivial_int 2) (lwre-empty-bindings)
            (lwo-empty-field) (lwo-none) (lwo-none)
            (lwrbw-flow-a) (lwo-none) (lwrbw-evidence)))
    (let revoked (lwrbw-revoked-world-a))

    (let c1
        (if (and (eq (lwre-contract-valid? (lwrbw-contract)) 1)
                 (eq (lwre-bound-contract? (lwrbw-contract)) 1)) 1 0))
    (let c2
        (if (and (eq (lwre-bindings-valid? bindings-a) 1)
                 (eq (lwre-bindings-current? world-a bindings-a) 1)) 2 0))
    (let c3
        (if (and (eq (len (lwre-binding-items bindings-a)) 2)
                 (and (str_eq
                        (lwre-binding-name
                          (head (lwre-binding-items bindings-a))) "origin")
                      (str_eq
                        (lwre-binding-name
                          (head (tail (lwre-binding-items bindings-a))))
                        "field"))) 4 0))
    (let c4
        (if (and (eq (lwre-bindings-valid? duplicate) 0)
                 (eq (lwre-binding-valid? unsafe) 0)) 8 0))
    (let c5
        (if (node_eq
                (lwre-result-primary (lwre-trace-result trace-a))
                (intern_trivial_int 5)) 16 0))
    (let c6
        (if (node_eq
                (lwre-result-primary (lwre-trace-result trace-b))
                (intern_trivial_int 11)) 32 0))
    (let c7
        (if (and (node_eq (lwre-trace-bindings trace-a) bindings-a)
                 (node_eq (lwre-trace-bindings trace-b) bindings-b)) 64 0))
    (let c8
        (if (and (not (node_eq trace-a trace-b))
                 (node_eq (lwre-trace-recipe trace-a)
                          (lwre-trace-recipe trace-b))) 128 0))
    (let c9
        (if (and (eq (lwre-trace-current? world-a trace-a) 1)
                 (eq (lwre-trace-current? world-b trace-b) 1)) 256 0))
    (let c10
        (if (and (eq (lwo-field-size
                         (lwre-trace-witnesses trace-a)) 7)
                 (eq (lwo-field-size
                         (lwt-proposal-participants proposal-a)) 2)) 512 0))
    (let c11
        (if (and (eq (lwre-proposal-current? world-a proposal-a) 1)
                 (node_eq
                    (lwo-emergent-shape
                      (lwt-proposal-candidate proposal-a)) trace-a)) 1024 0))
    (let c12
        (if (and (node_eq bound-empty (lwo-none))
                 (and (eq (lwre-unbound-contract? old-contract) 1)
                      (eq (lwre-bound-contract? old-contract) 0))) 2048 0))
    (let c13
        (if (and (eq (lwre-bindings-current? revoked bindings-a) 0)
                 (eq (lwre-trace-current? revoked trace-a) 0)) 4096 0))
    (let c14
        (if (and (eq (node_type
                         (lwre-binding-value (lwrbw-origin-a))) 1)
                 (node_eq (lwre-binding-source (lwrbw-origin-a))
                          (intern_trivial_int 2))) 8192 0))
    (let c15
        (if (and (node_eq bindings-a (lwrbw-bindings-a))
                 (not (node_eq bindings-a bindings-b))) 16384 0))
    (lwrbw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
