; qwen35-tokenizer-resident-breaths-band.fk -- pure resident-fold proof.
;
; No filesystem, GGUF, tokenizer artifact, model tensor, or forward pass is
; touched.  Effectful residence is observed only by the live driver.
;
; preludes: form-stdlib/qwen35-tokenizer-resident-breaths.fk

(do
    (defn q35trmb-bit (ok bit) (if ok bit 0))
    (let manifest (q35trm-manifest))
    (let p0 (q35tbb-progress 1 29047086048 1786966439 0 0 1200 0 0 0 0 64))
    (let p1 (q35tbb-progress 1 29047086048 1786966439 0 64 2400 64 0 900 15 64))
    (let p2 (q35tbb-progress 1 29047086048 1786966439 0 128 3700 128 0 1830 15 64))
    (let b1 (q35tbb-breath-result "progress" p1 64 64 900 15
                                  64 1 0 0 0 0 64 "breath-complete"))
    (let b2 (q35tbb-breath-result "progress" p2 64 64 930 14
                                  64 1 0 0 0 0 64 "breath-complete"))
    (let badp (q35tbb-progress 1 29047086048 1786966439 0 127 3700 128 0 1830 15 64))
    (let bad (q35tbb-breath-result "progress" badp 64 64 930 14
                                   64 1 0 0 0 0 64 "breath-complete"))
    (let a1 (q35trm-acc-add (q35trm-acc-empty) p0 b1 1))
    (let a2 (q35trm-acc-add a1 p1 b2 0))
    (sum (list
        (q35trmb-bit (eq (q35trm-manifest-has?
                          "single-source-window-many-breaths" manifest) 1) 1)
        (q35trmb-bit (eq (q35trm-manifest-has? "progress-loaded-once" manifest) 1) 2)
        (q35trmb-bit (eq (q35trm-manifest-has? "state-carried-directly" manifest) 1) 4)
        (q35trmb-bit (and (eq (q35tba-max-breath-rows) 64)
                             (eq (q35trm-max-breaths-per-residence) 16)) 8)
        (q35trmb-bit (eq (q35trm-breath-forward? p0 b1) 1) 16)
        (q35trmb-bit (eq (q35trm-breath-forward? p1 b2) 1) 32)
        (q35trmb-bit (eq (q35trm-breath-forward? p1 bad) 0) 64)
        (q35trmb-bit (and (eq (q35trm-acc-breaths a2) 2)
                             (eq (q35trm-acc-processed a2) 128)) 128)
        (q35trmb-bit (and (eq (q35trm-acc-appended a2) 1830)
                             (eq (q35trm-acc-max-row a2) 15)) 256)
        (q35trmb-bit (and (eq (q35trm-acc-choices a2) 128)
                             (eq (q35trm-acc-cuts a2) 2)) 512)
        (q35trmb-bit (and (eq (q35trm-acc-undos a2) 0)
                             (eq (q35trm-acc-timeouts a2) 0)) 1024)
        (q35trmb-bit (and (eq (q35trm-acc-failures a2) 0)
                             (eq (q35trm-acc-refinements a2) 0)) 2048)
        (q35trmb-bit (eq (q35trm-acc-releases a2) 128) 4096)
        (q35trmb-bit (eq (q35trm-acc-state-handoffs a2) 1) 8192)
        (q35trmb-bit (eq (q35trm-acc-monotonic? a2) 1) 16384)
        (q35trmb-bit (and
            (eq (q35trm-manifest-has? "no-whole-vocab-list" manifest) 1)
            (and (eq (q35trm-manifest-has? "no-whole-merge-list" manifest) 1)
                 (and (eq (q35trm-manifest-has? "no-tokenizer-monolith" manifest) 1)
                      (eq (q35trm-manifest-has? "no-model-tensor-forward" manifest) 1))))
            32768))))
