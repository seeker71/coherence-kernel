; Extreme magnitudes and subnormals must retain their numeric value in JSON.
; preludes: form-stdlib/json-precise.bml
(do
 (defn jpb-check (texts) (if (nil? texts) 1
  (do (let value (str_to_float (head texts))) (let emitted (json-emit-precise (json-precise-float value)))
   (let roundtrip (node_value (parse-json "precise-roundtrip" emitted)))
   (if (not (eq value roundtrip)) (do (print (list (head texts) emitted value roundtrip)) 0) (jpb-check (tail texts))))))
 (let same (jpb-check (list "0" "0.1" "3.14" "2.9999999" "4.625082608566977e-11" "-0.44666204452514646" "1e-300" "5e-324" "1.7976931348623157e308" "-1.7976931348623157e308" "9007199254740991")))
 (let tiny (not (str_eq (json-emit-precise (json-precise-float (str_to_float "4.625082608566977e-11"))) "0")))
 (print (list "numeric-roundtrips" same "tiny-nonzero" tiny))
 (if (and same tiny) 3 (form_error "precise JSON numeric witness failed")))
