; corpus-teach-samples-band.fk — the corpus reaches the teacher.
;
; Verdict 1023:
;   1     the corpus renders, and its ids are meanings not row indices
;   2     a sample carries both the question and the answer
;   4     cts-since is an invariant over growth, not a count of today
;   8     the twenty words won on 2026-08-24 are all present
;   16    each of them renders a sample containing its own word
;   32    a word the body has not won is honestly absent
;   64    the sample count equals the row count — nothing dropped, nothing minted
;   128   the max meaning-id is the corpus's own, not a guess
;   256   the questions are real questions, not bare tokens
;   512   the words carry their source, so a reader can find what won them
;
; preludes: form-stdlib/core.fk learn/corpus-teach-samples.fk
; witnessed: 2026-08-25 -> 1023 on fkwu

(do
    (defn ctb-has? (s n) (if (ge (str_find s n 0) 0) 1 0))
    (defn ctb-bit (ok bit) (if ok bit 0))
    (defn ctb-all-known (ws)
        (if (eq (len ws) 0) 1
            (if (eq (cts-knows? (head ws)) 1) (ctb-all-known (tail ws)) 0)))
    (defn ctb-all-render (ws)
        (if (eq (len ws) 0) 1
            (if (eq (ctb-has? (cts-sample (cts-row-for (head ws))) (head ws)) 1)
                (ctb-all-render (tail ws)) 0)))

    ; the twenty won on 2026-08-24, in order
    (defn ctb-yesterday ()
        (list "heedmark" "overvouch" "cuckoomark" "seedslip" "fuelbleed"
              "carrierspan" "falseserial" "bystandlaw" "maskedconstant"
              "decoyreason" "phantomstall" "proofnadir" "earlysettle"
              "nullswap" "namewidth" "streamdebt" "borrowedceiling"
              "lostaxis" "loopanchor" "pitchgap"))

    (let heed (cts-row-for "heedmark"))
    (let s0 (cts-sample heed))

    ; 470 rows carrying meaning-ids up to 1078: the ids are MEANINGS, minted
    ; max+1 by whoever won one, not row indices. A reader that sizes the corpus
    ; by its largest id overcounts it by more than half.
    (let b0 (ctb-bit (and (and (gt (cts-count) 400) (lt (cts-count) (cts-max-mid)))
                          (gt (str_len s0) 0)) 1))
    (let b1 (ctb-bit (and (eq (ctb-has? s0 "Q: ") 1)
                     (and (eq (ctb-has? s0 "A: heedmark") 1)
                          (eq (ctb-has? s0 "?") 1))) 2))
    ; the INVARIANT, not a snapshot: a band that counts today's rows goes red the
    ; next time the body wins a word, which is the one event it should survive.
    ; since(0) is everything, since(max) is nothing, and since(1058) holds at
    ; least the twenty won on 2026-08-24.
    (let b2 (ctb-bit (and (eq (len (cts-since 0)) (cts-count))
                     (and (eq (len (cts-since (cts-max-mid))) 0)
                          (ge (len (cts-since 1058)) 20))) 4))
    (let b3 (ctb-bit (eq (ctb-all-known (ctb-yesterday)) 1) 8))
    (let b4 (ctb-bit (eq (ctb-all-render (ctb-yesterday)) 1) 16))
    (let b5 (ctb-bit (and (eq (cts-knows? "zzznotaword") 0)
                          (eq (len (cts-row-for "zzznotaword")) 0)) 32))
    (let b6 (ctb-bit (eq (len (cts-samples)) (cts-count)) 64))
    (let b7 (ctb-bit (and (ge (cts-max-mid) 1078)
                          (eq (cts-mid heed) 1059)) 128))
    (let b8 (ctb-bit (and (ge (str_len (cts-question heed)) 20)
                          (eq (ctb-has? (cts-question heed) "what one word") 1)) 256))
    (let b9 (ctb-bit (and (gt (str_len (cts-source heed)) 0)
                          (str_eq (cts-source heed) "rented-oracle")) 512))

    (add b0 (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 b9))))))))))
