; living-world-recipe-tree-revision-witness.fk -- one source-disjoint offered
; wrapper grows the prior Recipe tree around an exact prospective contradiction.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk

(let LWRTRW-SOURCE-G (bp "LWRTRW-SOURCE-G"))
(let LWRTRW-SOURCE-H (bp "LWRTRW-SOURCE-H"))
(let LWRTRW-EVIDENCE (bp "LWRTRW-EVIDENCE"))
(let LWRTRW-REASON   (bp "LWRTRW-REASON"))
(let LWRTRW-TREE     (bp "LWRTRW-TREE"))
(let LWRTRW-RESULT   (bp "LWRTRW-RESULT"))

(defn lwrtrw-cell (kind) (intern_node kind (empty)))
(defn lwrtrw-source-g () (lwrtrw-cell LWRTRW-SOURCE-G))
(defn lwrtrw-source-h () (lwrtrw-cell LWRTRW-SOURCE-H))
(defn lwrtrw-evidence () (lwrtrw-cell LWRTRW-EVIDENCE))
(defn lwrtrw-reason () (lwrtrw-cell LWRTRW-REASON))
(defn lwrtrw-entry (source payload)
    (lwphw-entry source (lwrtrw-evidence) payload))

(defn lwrtrw-binding-for-name (items name)
    (if (eq (len items) 0) (lwo-none)
        (if (str_eq (lwre-binding-name (head items)) name) (head items)
            (lwrtrw-binding-for-name (tail items) name))))
(defn lwrtrw-case-binding (case name)
    (lwrtrw-binding-for-name
        (lwre-binding-items (lwps-case-bindings case)) name))

(defn lwrtrw-if (successor case)
    (lwrt-operator successor "if" case))
(defn lwrtrw-and (successor case)
    (lwrt-operator successor "and" case))
(defn lwrtrw-eq (successor case)
    (lwrt-operator successor "eq" case))
(defn lwrtrw-left (case) (lwrt-reference "left" case))
(defn lwrtrw-right (case) (lwrt-reference "right" case))
(defn lwrtrw-left-literal (case)
    (lwrt-literal
        (lwre-binding-value (lwrtrw-case-binding case "left")) case))
(defn lwrtrw-right-literal (case)
    (lwrt-literal
        (lwre-binding-value (lwrtrw-case-binding case "right")) case))
(defn lwrtrw-observed-literal (case)
    (lwrt-literal (oac-payload (lwps-case-immediate case)) case))

(defn lwrtrw-left-match-args (successor case)
    (lwrt-arguments
        (list (lwrtrw-left case) (lwrtrw-left-literal case))))
(defn lwrtrw-left-match (successor case)
    (lwrt-application (lwrtrw-eq successor case)
        (lwrtrw-left-match-args successor case) case))
(defn lwrtrw-right-match-args (successor case)
    (lwrt-arguments
        (list (lwrtrw-right case) (lwrtrw-right-literal case))))
(defn lwrtrw-right-match (successor case)
    (lwrt-application (lwrtrw-eq successor case)
        (lwrtrw-right-match-args successor case) case))
(defn lwrtrw-condition-args (successor case)
    (lwrt-arguments
        (list (lwrtrw-left-match successor case)
              (lwrtrw-right-match successor case))))
(defn lwrtrw-condition (successor case)
    (lwrt-application (lwrtrw-and successor case)
        (lwrtrw-condition-args successor case) case))
(defn lwrtrw-root-args (successor match case)
    (lwrt-arguments
        (list (lwrtrw-condition successor case)
              (lwrtrw-observed-literal case)
              (lwrtr-prior-root match))))
(defn lwrtrw-root (successor match case)
    (lwrt-application (lwrtrw-if successor case)
        (lwrtrw-root-args successor match case) case))
(defn lwrtrw-blueprint (successor match suite case)
    (lwrtr-blueprint successor match suite
        (lwrtrw-root successor match case)
        (lwo-none) (lwo-none) (lwo-empty-field) (lwo-none) (lwo-none)
        (lwo-none) case))

; Build every new wrapper cell once.  The prior root remains an exact child but
; does not cross the new offer membrane again.
(defn lwrtrw-tree (blueprint parts root case)
    (intern_node LWRTRW-TREE (list blueprint parts root case)))
(defn lwrtrw-tree-blueprint (tree) (nth (node_children tree) 0))
(defn lwrtrw-tree-parts (tree) (nth (node_children tree) 1))
(defn lwrtrw-tree-root (tree) (nth (node_children tree) 2))
(defn lwrtrw-tree-case (tree) (nth (node_children tree) 3))
(defn lwrtrw-build-tree (successor match suite case)
    (do
        (let if-op (lwrt-operator successor "if" case))
        (let and-op (lwrt-operator successor "and" case))
        (let eq-op (lwrt-operator successor "eq" case))
        (let left (lwrt-reference "left" case))
        (let right (lwrt-reference "right" case))
        (let left-literal
            (lwrt-literal
                (lwre-binding-value
                    (lwrtrw-case-binding case "left")) case))
        (let right-literal
            (lwrt-literal
                (lwre-binding-value
                    (lwrtrw-case-binding case "right")) case))
        (let observed-literal
            (lwrt-literal (oac-payload (lwps-case-immediate case)) case))
        (let left-match-args (lwrt-arguments (list left left-literal)))
        (let left-match (lwrt-application eq-op left-match-args case))
        (let right-match-args (lwrt-arguments (list right right-literal)))
        (let right-match (lwrt-application eq-op right-match-args case))
        (let condition-args
            (lwrt-arguments (list left-match right-match)))
        (let condition (lwrt-application and-op condition-args case))
        (let root-args
            (lwrt-arguments
                (list condition observed-literal (lwrtr-prior-root match))))
        (let root (lwrt-application if-op root-args case))
        (let blueprint
            (lwrtr-blueprint successor match suite root
                (lwo-none) (lwo-none) (lwo-empty-field) (lwo-none)
                (lwo-none) (lwo-none) case))
        (let parts
            (list if-op and-op eq-op left right left-literal right-literal
                  observed-literal left-match-args left-match right-match-args
                  right-match condition-args condition root-args root
                  blueprint))
        (lwrtrw-tree blueprint parts root case)))

(defn lwrtrw-entries (source items)
    (if (eq (len items) 0) (list)
        (cons (lwrtrw-entry source (head items))
            (lwrtrw-entries source (tail items)))))
(defn lwrtrw-one-source-world (world tree)
    (lwt-receive-stream world
        (lwrtrw-entries (lwrtrw-source-g) (lwrtrw-tree-parts tree))))
(defn lwrtrw-two-source-world (world tree)
    (lwt-receive-stream (lwrtrw-one-source-world world tree)
        (lwrtrw-entries (lwrtrw-source-h) (lwrtrw-tree-parts tree))))
(defn lwrtrw-revoke-blueprint (world tree)
    (lwt-receive-stream world
        (list
            (lwrtrw-entry (lwrtrw-source-g)
                (lwo-revocation (lwrtrw-tree-blueprint tree)
                    (lwrtrw-source-g) (lwrtrw-reason)
                    (lwrtrw-evidence))))))

; children: upstream, successor/match/suite/case/tree, base/open/one/two worlds
; and fields, proposal/candidate/waiting/admitted, composition/Recipe,
; revoked world/field, framebuffer events.
(defn lwrtrw-result
    (upstream successor match suite case tree base-world open-field one-world
     one-field two-world field proposal candidate waiting admitted composition
     recipe revoked-world revoked-field admitted-current
     admitted-successor-current revoked-candidate-current
     revoked-successor-current revoked-suite-current events)
    (intern_node LWRTRW-RESULT
        (list upstream successor match suite case tree base-world open-field
              one-world one-field two-world field proposal candidate waiting
              admitted composition recipe revoked-world revoked-field
              admitted-current admitted-successor-current
              revoked-candidate-current revoked-successor-current
              revoked-suite-current events)))

(defn lwrtrw-run ()
    (do
        (let upstream (lwrtew-run))
        (let successor (nth (node_children upstream) 2))
        (let suite (nth (node_children upstream) 3))
        (let base-world (nth (node_children upstream) 6))
        (let successor-evaluation (nth (node_children upstream) 8))
        (let match
            (head (lwo-field-items
                    (lwrth-field-matches
                        (lwo-emergent-shape successor)))))
        (let contradicted
            (lwrtr-successor-contradicted-case-items
                (lwo-field-items
                    (lwps-evaluation-placements successor-evaluation))
                (lwo-empty-field)))
        (let case (head (lwo-field-items contradicted)))
        (let tree (lwrtrw-build-tree successor match suite case))
        (let started
            (lcfb-open-stream "living-world-recipe-tree-revision"
                "form-native" "lwrtrw-run"
                "prospective-contradiction-to-grown-wrapper-tree"
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                190 10))

        (let contradiction-frame
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "contradiction" "leave" "form-native"
                "lwrtr-successor-contradicted-cases"
                (lcfb-cat (list
                    "resolved-contradictions:"
                    (int_to_str (lwo-field-size contradicted))))
                1 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                212 10))
        (let open-field (lwrtr-field-for base-world successor suite 2))
        (let open-frame
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "open" "leave" "form-native" "lwrtr-field-for"
                (lwrtr-progress-target open-field) 2 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                223 10))

        (let one-world (lwrtrw-one-source-world base-world tree))
        (let one-field (lwrtr-field-for one-world successor suite 2))
        (let one-frame
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "first-offer" "leave" "form-native" "lwrtr-field-for"
                (lwrtr-progress-target one-field) 3 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                232 10))

        (let two-world (lwrtrw-two-source-world base-world tree))
        (let field-enter
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "composition" "enter" "form-native" "lwrtr-field-for"
                "new-wrapper-plus-exact-prior-root" 4 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                242 10))
        (let field (lwrtr-field-for two-world successor suite 2))
        (let field-frame
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "composition" "leave" "form-native" "lwrtr-field-for"
                (lwrtr-progress-target field) 5 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                249 10))
        (let composition
            (head (lwo-field-items (lwrtr-field-compatible field))))
        (let recipe (lwrtr-composition-recipe composition))
        (let proposal (lwrtr-proposal-from-field field))
        (let candidate (lwt-proposal-candidate proposal))
        (let proposal-frame
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "proposal" "leave" "form-native" "lwrtr-proposal-for"
                (lcfb-cat (list
                    "present:" (int_to_str
                        (not (node_eq proposal (lwo-none))))
                    ":recipe-active:"
                    (int_to_str (lwo-active? two-world recipe))))
                6 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                263 10))

        (let waiting-enter
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "pre-response" "enter" "form-native" "lwrtr-integrate"
                "candidate-currentness" 7 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                273 20))
        (let waiting
            (lwrtr-integrate
                (lwpow-round-for two-world proposal (lwo-none))
                proposal (lwphw-action)))
        (let waiting-frame
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "pre-response" "leave" "form-native" "lwrtr-integrate"
                (lcfb-cat (list
                    "candidate-active:"
                    (int_to_str
                        (lwo-active? (lwt-round-world waiting) candidate))))
                8 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                286 20))
        (let responded (lwpow-respond-all two-world proposal))
        (let response-frame
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "responses" "leave" "form-native" "lwpow-respond-all"
                (lcfb-cat (list
                    "participants:"
                    (int_to_str
                        (lwo-field-size
                            (lwt-proposal-participants proposal)))))
                9 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                294 20))
        (let admission-enter
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "admission" "enter" "form-native" "lwrtr-integrate"
                "freshness-and-unanimous-boundary" 10 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                305 20))
        (let admitted
            (lwrtr-integrate
                (lwpow-round-for responded proposal waiting)
                proposal (lwphw-action)))
        (let admitted-world (lwt-round-world admitted))
        (let admission-applied-frame
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "admission" "leave" "form-native" "lwrtr-integrate"
                (lcfb-cat (list
                    "candidate-active:"
                    (int_to_str (lwo-active? admitted-world candidate))
                    ":recipe-active:"
                    (int_to_str (lwo-active? admitted-world recipe))))
                11 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                317 20))
        (let admitted-current-enter
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "admitted-currentness" "enter" "form-native"
                "lwrtr-integrated-current?" "exact-field-reconstruction"
                12 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                329 20))
        (let admitted-current
            (lwrtr-integrated-current? admitted-world candidate))
        (let admitted-candidate-frame
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "admitted-candidate-currentness" "leave" "form-native"
                "lwrtr-integrated-current?"
                (lcfb-cat (list
                    "current:" (int_to_str admitted-current)
                    ":next:parent-successor-currentness"))
                13 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                341 20))
        (let admitted-successor-current
            (lwrth-integrated-current? admitted-world successor))
        (let admitted-frame
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "composition-field" "leave" "form-native" "lwrtr-integrate"
                (lcfb-cat (list
                    "current:"
                    (int_to_str admitted-current)
                    ":recipe-active:"
                    (int_to_str (lwo-active? admitted-world recipe))))
                14 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                339 20))

        (let revoked-world (lwrtrw-revoke-blueprint admitted-world tree))
        (let revocation-enter
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "revocation-field" "enter" "form-native"
                "lwrtr-field-for" "revoked-blueprint-recurrence" 15 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                350 20))
        (let revoked-field
            (lwrtr-field-for revoked-world successor suite 2))
        (let revoked-field-frame
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "revocation-field" "leave" "form-native"
                "lwrtr-field-for"
                (lcfb-cat (list
                    "blueprints-now:"
                    (int_to_str
                        (lwo-field-size
                            (lwrtr-field-blueprints revoked-field)))))
                16 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                357 20))
        (let revoked-candidate-enter
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "revoked-candidate" "enter" "form-native"
                "lwrtr-candidate-current?" "exact-field-reconstruction"
                17 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                370 20))
        (let revoked-candidate-current
            (lwrtr-candidate-current? revoked-world candidate))
        (let revoked-candidate-frame
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "revoked-candidate" "leave" "form-native"
                "lwrtr-candidate-current?"
                (lcfb-cat (list
                    "current:" (int_to_str revoked-candidate-current)))
                18 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                378 20))
        (let parent-current-enter
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "parent-currentness" "enter" "form-native"
                "lwrth-integrated-current?/lwps-suite-current?"
                "revocation-locality" 19 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                388 20))
        (let revoked-successor-current
            (lwrth-integrated-current? revoked-world successor))
        (let revoked-suite-current
            (lwps-suite-current? revoked-world suite 2))
        (let revoked-frame
            (lcfb-call-stream "living-world-recipe-tree-revision"
                "revocation" "leave" "form-native"
                "lwo-revocation/lwrtr-field-for"
                (lcfb-cat (list
                    "prior-current:1->"
                    (int_to_str revoked-candidate-current)
                    ":blueprints-now:"
                    (int_to_str
                        (lwo-field-size
                            (lwrtr-field-blueprints revoked-field)))
                    ":successor-current:"
                    (int_to_str revoked-successor-current)))
                20 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-witness.fk"
                400 20))
        (lwrtrw-result upstream successor match suite case tree base-world
            open-field one-world one-field two-world field proposal candidate
            waiting admitted composition recipe revoked-world revoked-field
            (intern_trivial_int admitted-current)
            (intern_trivial_int admitted-successor-current)
            (intern_trivial_int revoked-candidate-current)
            (intern_trivial_int revoked-successor-current)
            (intern_trivial_int revoked-suite-current)
            (framebuffer-events))))

0
