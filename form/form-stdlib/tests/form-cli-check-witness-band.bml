; form-cli-check-witness-band.bml — rung 0 of the local lane: every caller check meets a witness
; before any model opens, and the lane's rg speaks ripgrep's filename rule. No model is opened: the
; one lane call is refused at rung 0, ahead of fcac-admit.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-code-request.bml
;
; Verdict 1023 when every claim lands:
;   1     one explicit file prints no path: -c "2\n", -n "2:(do\n3:b (do\n"; -l still prints the
;         path, and a file with no match prints nothing with exit 1 (ripgrep 15.2.0's bytes)
;   2     several paths, a directory prefix and the whole resident corpus print path:count, and the
;         documented example rg -nF 'alpha 1' over the corpus prints "alpha.txt:1:alpha 1\n"
;   4     -H, -I, --with-filename and --no-filename choose, the last one given wins; the held input
;         prints no path ("2\n", "1:x\n", through "-" too) and -l over it prints "<stdin>"
;   8     the committed queue checks (rg "1\n", the header by head, the final 0 by tail) all read
;         meetable on the empty target: rg on its rg-literal-count witness, head and tail on their
;         expected-text witness
;   16    the rows as they stood before the heal ("<path>:1\n") read unmeetable, shape_only 1, with the
;         pair ["<path>:1\n", "1\n"]; the same row asking -H reads meetable
;   32    grep's dialect ("0\n" for no match) reads unmeetable and not shape_only (actual "", exit 1);
;         "2\n" reads meetable, since two pattern lines can be written; a wrong path is not shape_only;
;         head -n 1 asking for two lines reads unmeetable on its expected-text witness
;   64    a balance check on the original reads meetable, and one the original fails reads open, never
;         refused; a tail asking for bytes the writable file lacks reads meetable (the lane can write
;         them); a failing check over a read-only document, and an input-only jq check that cannot
;         hold, read unmeetable (fixed); a word range on a writable path meets its target
;   128   the lane door refuses the pre-heal row before any model opens: form-native-code-v1, status
;         attention, reason caller-check-unmeetable, generated_ids 0, injected_ids 0, no checkpoint,
;         release_ok 1, its documents unchanged, blocking_check carrying the pair and shape_only 1
;   256   blocking_check on delivered documents: the empty target is blocked by the rg row (actual "",
;         exit 1); a stub keeping the header and the final 0 blocks on nothing (null); a stub that moved
;         the final 0 to three spaces is blocked by the tail row with actual "))\n   0)"
;   512   every row of learn/native-turn-queue.jsonl, read with its writable and source files from
;         disk, carries no unmeetable check
section [form.bml] {
 class CheckWitnessBand {
  def cwb-bit(ok, bit) = ok ? bit : 0;
  def cwb-target() = "form/form-stdlib/closure-lines.fk";
  def cwb-header() = "; closure-lines.fk — read a line of an fkwu closure back to the unit that wrote it.\n;\n; `./fkwu --closure <unit> <out>` joins every unit of a closure into one plain-Form\n; file and heads each unit's text with a line \"; unit: <path>\". A sibling kernel\n; reports a stop at a line of that file; this unit names the authored unit and\n; the line within it.\n";
  def cwb-empty() = cwb-header() ++ "\n(do\n    0)\n";
  def cwb-stub() = cwb-header() ++ "\n(do\n    (defn cl-unit-at (text line) (nothing))\n    0)\n";
  def cwb-drift() = cwb-header() ++ "\n(do\n    (defn cl-unit-at (text line) (nothing))\n   0)";
  def cwb-docs(text) = [[cwb-target(), cwb-target(), text]];
  def cwb-strings(xs) = json-node-array(map(json-node-string, xs));
  def cwb-row(tool, args, stdout) = json-node-object([oh-s("tool", tool), json-node-pair("arguments", cwb-strings(args)), oh-s("stdout", stdout)]);
  def cwb-row-in(tool, args, input, stdout) = json-node-object([oh-s("tool", tool), json-node-pair("arguments", cwb-strings(args)), oh-s("input", input), oh-s("stdout", stdout)]);
  def cwb-row-exit(tool, args, stdout, code) = json-node-object([oh-s("tool", tool), json-node-pair("arguments", cwb-strings(args)), oh-s("stdout", stdout), oh-n("exit", code)]);
  def cwb-req(rows, writable) = json-node-object([json-node-pair("checks", json-node-array(rows)), json-node-pair("writable", cwb-strings(writable))]);
  def cwb-one(row, docs, writable) = fccw-rehearse(cwb-req([row], writable), docs)[0];
  // rg over a small corpus: [exit, stdout, stderr]
  def cwb-corpus() = [["one", "src/one.fk", "a\n(do\nb (do\n"], ["two", "src/d/two.fk", "(do\n"], ["alpha", "alpha.txt", "alpha 1\nbeta 2\n"]];
  def cwb-rg(args, input) {
   let r = fat-call(cwb-corpus(), "rg", args, input);
   [fat-exit(r), fat-out(r), fat-error(r)];
  }
  def cwb-says(args, input, code, out) {
   let r = cwb-rg(args, input);
   r[0] == code && r[1] == out && r[2] == "";
  }
  def cwb-one-file() = cwb-says(["-c", "-F", "(do", "src/one.fk"], "", 0, "2\n") && cwb-says(["-n", "-F", "(do", "src/one.fk"], "", 0, "2:(do\n3:b (do\n")
   && cwb-says(["-l", "-F", "(do", "src/one.fk"], "", 0, "src/one.fk\n") && cwb-says(["-c", "-F", "zz", "src/one.fk"], "", 1, "");
  def cwb-many-files() = cwb-says(["-c", "-F", "(do", "src/one.fk", "src/d/two.fk"], "", 0, "src/one.fk:2\nsrc/d/two.fk:1\n") && cwb-says(["-c", "-F", "(do", "src/d"], "", 0, "src/d/two.fk:1\n")
   && cwb-says(["-c", "-F", "(do"], "", 0, "src/one.fk:2\nsrc/d/two.fk:1\n") && cwb-says(["-nF", "alpha 1"], "", 0, "alpha.txt:1:alpha 1\n");
  def cwb-chosen() = cwb-says(["-H", "-c", "-F", "(do", "src/one.fk"], "", 0, "src/one.fk:2\n") && cwb-says(["-I", "-c", "-F", "(do", "src/one.fk", "src/d/two.fk"], "", 0, "2\n1\n")
   && cwb-says(["--with-filename", "-c", "-F", "(do", "src/one.fk"], "", 0, "src/one.fk:2\n") && cwb-says(["--no-filename", "-n", "-F", "(do", "src/d"], "", 0, "1:(do\n")
   && cwb-says(["-H", "-I", "-c", "-F", "(do", "src/one.fk"], "", 0, "2\n") && cwb-says(["-c", "x"], "x\nx\n", 0, "2\n")
   && cwb-says(["-n", "x"], "x\n", 0, "1:x\n") && cwb-says(["-c", "x", "-"], "x\n", 0, "1\n") && cwb-says(["-l", "x"], "x\n", 0, "<stdin>\n");
  // the committed queue checks of closure-unit-line
  def cwb-rg-row(stdout) = cwb-row("rg", ["-c", "-F", "(defn cl-unit-at", cwb-target()], stdout);
  def cwb-head-row() = cwb-row("head", ["-n", "6", cwb-target()], cwb-header());
  def cwb-tail-row() = cwb-row("tail", ["-c", "8", cwb-target()], "\n    0)\n");
  def cwb-queue-rows() = [cwb-rg-row("1\n"), cwb-head-row(), cwb-tail-row()];
  def cwb-committed() {
   let records = fccw-rehearse(cwb-req(cwb-queue-rows(), [cwb-target()]), cwb-docs(cwb-empty()));
   map(r => r[0], records) == ["meetable", "meetable", "meetable"] && map(r => r[1], records) == ["rg-literal-count", "expected-text", "expected-text"] && !fccw-refused?(records);
  }
  def cwb-pre-heal() {
   let r = cwb-one(cwb-rg-row(cwb-target() ++ ":1\n"), cwb-docs(cwb-empty()), [cwb-target()]);
   let h = cwb-one(cwb-row("rg", ["-H", "-c", "-F", "(defn cl-unit-at", cwb-target()], cwb-target() ++ ":1\n"), cwb-docs(cwb-empty()), [cwb-target()]);
   r[0] == "unmeetable" && r[1] == "rg-literal-count" && r[3] == cwb-target() ++ ":1\n" && r[4] == "1\n" && r[8] == 1 && h[0] == "meetable";
  }
  def cwb-unsound() {
   let zero = cwb-one(cwb-rg-row("0\n"), cwb-docs(cwb-empty()), [cwb-target()]);
   let two = cwb-one(cwb-rg-row("2\n"), cwb-docs(cwb-empty()), [cwb-target()]);
   let elsewhere = cwb-one(cwb-rg-row("x.fk:1\n"), cwb-docs(cwb-empty()), [cwb-target()]);
   let wide = cwb-one(cwb-row("head", ["-n", "1", cwb-target()], "(do\n    0)\n"), cwb-docs(cwb-empty()), [cwb-target()]);
   zero[0] == "unmeetable" && zero[8] == 0 && zero[4] == "" && zero[6] == 1 && two[0] == "meetable" && elsewhere[0] == "unmeetable" && elsewhere[8] == 0
   && wide[0] == "unmeetable" && wide[1] == "expected-text" && wide[4] == "(do\n";
  }
  def cwb-reach() {
   let docs = append(cwb-docs(cwb-empty()), [["notes", "notes.txt", "seen\n"]]);
   let balance = cwb-one(cwb-row("balance", [cwb-target()], "0 0\n"), docs, [cwb-target()]);
   let unbalanced = cwb-one(cwb-row("balance", [cwb-target()], "1 0\n"), docs, [cwb-target()]);
   let lacking = cwb-one(cwb-row("tail", ["-c", "3", cwb-target()], "0)!"), docs, [cwb-target()]);
   let readonly = cwb-one(cwb-row("read", ["notes.txt"], "unseen\n"), docs, [cwb-target()]);
   let inputOnly = cwb-one(cwb-row-in("jq", ["-r", ".a"], "{\"a\":1}", "2\n"), docs, [cwb-target()]);
   let words = cwb-one(json-node-object([oh-s("kind", "word-range"), oh-s("path", "form/form-stdlib/fresh.md"), oh-n("minimum", 3), oh-n("maximum", 5)]), docs, [cwb-target(), "form/form-stdlib/fresh.md"]);
   balance[0] == "meetable" && balance[1] == "original" && unbalanced[0] == "open" && lacking[0] == "meetable" && lacking[1] == "expected-text"
   && readonly[0] == "unmeetable" && readonly[1] == "fixed"
   && inputOnly[0] == "unmeetable" && inputOnly[1] == "fixed" && words[0] == "meetable" && words[1] == "word-range-target";
  }
  def cwb-request() = json-emit(json-node-object([oh-s("goal", "Add cl-unit-at inside the (do ...), before the final 0."), json-node-pair("documents", fat-wire-documents-node(cwb-docs(cwb-empty()))), json-node-pair("writable", cwb-strings([cwb-target()])), json-node-pair("checks", json-node-array([cwb-rg-row(cwb-target() ++ ":1\n"), cwb-tail-row()])), oh-n("turns", 8)]));
  def cwb-int(r, key) = json-int-value(json-object-get(r, key));
  def cwb-door() {
   let r = parse-json("rung-0", fcaq-call(cwb-request()));
   let b = json-object-get(r, "blocking_check");
   fcap-string(r, "schema") == "form-native-code-v1" && fcap-string(r, "status") == "attention" && fcap-string(r, "reason") == "caller-check-unmeetable"
   && cwb-int(r, "generated_ids") == 0 && cwb-int(r, "injected_ids") == 0 && fcap-string(r, "checkpoint_id") == "" && cwb-int(r, "release_ok") == 1
   && json-emit(json-object-get(r, "documents")) == json-emit(fat-wire-documents-node(cwb-docs(cwb-empty())))
   && fcap-string(b, "expected") == cwb-target() ++ ":1\n" && fcap-string(b, "actual") == "1\n" && cwb-int(b, "shape_only") == 1 && fcap-string(b, "witness_kind") == "rg-literal-count";
  }
  def cwb-blocking() {
   let req = cwb-req(cwb-queue-rows(), [cwb-target()]);
   let empty = fccw-blocking(req, cwb-docs(cwb-empty()));
   let drift = fccw-blocking(req, cwb-docs(cwb-drift()));
   fcap-string(empty, "actual") == "" && cwb-int(empty, "exit_actual") == 1 && fcap-string(json-object-get(empty, "row"), "tool") == "rg"
   && node_eq(fccw-blocking(req, cwb-docs(cwb-stub())), json-node-null())
   && fcap-string(json-object-get(drift, "row"), "tool") == "tail" && fcap-string(drift, "actual") == "))\n   0)" && cwb-int(drift, "shape_only") == 0;
  }
  // the live queue: each gap's documents as the walk hands them to the lane
  def cwb-read(path) = file_size(path) < 1 ? "" : read_file(path);
  def cwb-gap-docs(gap) = map(p => [p, p, cwb-read(p)], append(fcap-array(gap, "writable"), if json-object-has?(gap, "sources") then fcap-array(gap, "sources") else []));
  def cwb-gap-meetable(line) {
   let gap = parse-json("queue-row", line);
   !fccw-refused?(fccw-rehearse(gap, cwb-gap-docs(gap)));
  }
  def cwb-live-queue() = all?(cwb-gap-meetable, filter(l => len(trim(l)) > 0, split-on(cwb-read("learn/native-turn-queue.jsonl"), "\n")));
 }
 cwb-bit(cwb-one-file(), 1) + cwb-bit(cwb-many-files(), 2) + cwb-bit(cwb-chosen(), 4) + cwb-bit(cwb-committed(), 8)
 + cwb-bit(cwb-pre-heal(), 16) + cwb-bit(cwb-unsound(), 32) + cwb-bit(cwb-reach(), 64) + cwb-bit(cwb-door(), 128)
 + cwb-bit(cwb-blocking(), 256) + cwb-bit(cwb-live-queue(), 512);
}
