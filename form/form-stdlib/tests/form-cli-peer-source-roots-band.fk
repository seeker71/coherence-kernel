; form-cli-peer-source-roots-band.fk -- the retained source index names both
; the resident session body and the Form-emitted SHA JIT body.
;
; Effectful: builds/releases short-lived source-scan leases. Do not preflight.
; preludes: form-stdlib/bml/form-cli-peer-source-roots.bml

(do
    (let roots (fcpsr-resident-source-roots "."))
    (let snapshot (sof-snapshot-build 71 roots))
    (let session (sof-snapshot-query snapshot 71 "fcms-open"))
    (let digest (sof-snapshot-query snapshot 71 "saj-file-digest"))
    (let seal (sof-snapshot-query snapshot 71 "qaf-seal-verdict"))
    (sum (list
        (if (eq (len roots) 2) 1 0)
        (if (str_eq (head roots) "./form/form-stdlib") 2 0)
        (if (str_eq (nth roots 1) "./form/native/metal") 4 0)
        (if (and (str_eq (sof-query-signal session) "value")
                 (str_eq (head (sof-query-raw session)) "one")) 8 0)
        (if (and (str_eq (sof-query-signal digest) "value")
                 (str_eq (head (sof-query-raw digest)) "one")) 16 0)
        (if (str_eq (sof-query-signal seal) "choice") 32 0))))
