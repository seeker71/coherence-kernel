; native-model-memory-glass-band.fk — the glass makes residence, purpose,
; access age, packed grains, and the physical eviction frontier visible.
;
; preludes: form-stdlib/core.fk form-stdlib/native-model-glass.bml form-stdlib/native-model-resident-fleet.bml form-stdlib/native-model-memory-glass.bml
;
; Verdict 262143: logical artifact scaling, callable/mapped/materialized split,
; quiet cadence snapshot, explicit status rendering, and high-BML authority.

(do
    (defn nmmgt-has (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let s0 (nmg-initial))
    (let s1 (nmg-qwen-loading s0))
    (let s2 (nmg-qwen-loaded s1))
    (let s3 (nmg-qwen-prefilling s2 0))
    (let s4 (nmg-qwen-reasoning s3 18))
    (let s5 (nmg-qwen-finished s4 19))
    (let s6 (nmg-threeb-loading s5))
    (let s7 (nmg-threeb-loaded s6))
    (let s8 (nmg-threeb-prefilling s7 0))
    (let s9 (nmg-threeb-finished s8 6))
    (let s10 (nmg-qwen-reasoning s9 19))
    (let session (nmg-qwen-finished s10 20))
    (let qwen (nmrf-model (NMGQwen) "moe-packed-experts" 1 1 0 (NMRFQwenBytes) 2 3 1262 0 "resident-packed-experts"))
    (let threeb (nmrf-model (NMGThreeB) "dense" 1 1 0 (NMRFThreeBBytes) 1 2 1695 0 "resident-dense"))
    (let fleet (nmrf-fleet (NMRFDefaultBudget) 0 4 (list qwen threeb)))
    (let segments (nmmg-project fleet session 20 6))
    (let native (nth segments 0))
    (let qweights (nth segments 1))
    (let experts (nth segments 2))
    (let qstate (nth segments 3))
    (let tweights (nth segments 4))
    (let headroom (nth segments 6))
    (let c0 (if (eq (len segments) 7) 1 0))
    (let c1 (if (and (str_eq (nmmg-colour native) "native-green") (str_eq (nmmg-purpose native) "validate Form, evaluate world state, store and route")) 2 0))
    (let c2 (if (and (str_eq (nmmg-colour qweights) "reason-purple") (eq (nmmg-bytes qweights) (NMRFQwenBytes))) 4 0))
    (let c3 (if (and (str_eq (nmmg-colour experts) "expert-orange") (eq (nmmg-evictable? experts) 0)) 8 0))
    (let c4 (if (and (str_eq (nmmg-colour qstate) "state-cyan") (eq (nmmg-scaled? qstate) 0)) 16 0))
    (let c5 (if (and (eq (nmmg-read-age qweights) 1) (eq (nmmg-fill-alpha qweights) 216)) 32 0))
    (let c6 (if (and (eq (nmmg-write-age qweights) -1) (eq (nmmg-edge-alpha qweights) 48)) 64 0))
    (let c7 (if (and (eq (nmmg-frontier? tweights) 1) (str_eq (nmmg-eviction-symbol tweights) "⇣")) 128 0))
    (let c8 (if (eq (nmmg-frontier? qweights) 0) 256 0))
    (let c9 (if (eq (nmmg-bytes headroom) (sub (NMRFDefaultBudget) (add (NMRFQwenBytes) (NMRFThreeBBytes)))) 512 0))
    (let render (nmmg-render fleet session segments))
    (let c10 (if (and (eq (nmmgt-has render "FLOW 🟢 native Form/world → 🔵 3B NL→Form → 🟢 validate/eval → 🟣 Qwen fallback") 1) (eq (nmmgt-has render "pressure=unobserved") 1)) 1024 0))
    (let c11 (if (and (eq (nmmgt-has render "EVICT ⇣ next") 1)
                       (and (eq (nmmgt-has render "░ older") 1)
                            (and (eq (nmmgt-has render "cold") 0)
                                 (eq (nmmgt-has render "⊘ pinned") 1)))) 2048 0))
    (framebuffer-clear)
    (let written (nmmg-write-quiet fleet session 20 6))
    (let c12 (if (and (str_eq (nth written 0) "native-model-memory-glass-frame") (eq (len (framebuffer-events)) 7)) 4096 0))
    (let c13 (if (eq (nmg-session-valid? session) 1) 8192 0))
    (let base (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13)))
    (let src (read_file "form/form-stdlib/bml/native-model-memory-glass.bml"))
    (let executable (read_file "form/form-stdlib/native-model-memory-glass.bml"))
    (let ownerSource (read_file "observe/native-model-dual-resident-live-run.fk"))
    (let authority (if (eq (nmmgt-has src "const String ReadAgeRule = \"fill alpha carries read age: recent is opaque and older is increasingly transparent\"") 1)
        (if (eq (nmmgt-has src "const String WriteAgeRule = \"edge alpha carries write age: recent mutable state is opaque while immutable weights carry a quiet edge\"") 1)
            (if (eq (nmmgt-has src "const String EvictionRule = \"the frontier marks the next policy-ranked physically evictable unit; desired but unavailable split grains are shown pinned rather than promised\"") 1)
                (if (eq (nmmgt-has src "const String PageRule = \"logical fleet-clock access age never claims OS or Metal page residency; that requires a separate physical-live carrier\"") 1) 16384 0) 0) 0) 0))
    (let c15 (if (and (eq (nmmgt-has render "logical_artifacts=") 1)
        (and (eq (nmmgt-has render "mapped_bytes=unavailable:model.carrier-per-model-mapped-bytes") 1)
            (and (eq (nmmgt-has render "materialized_bytes=unavailable:model.carrier-per-model-materialized-bytes") 1)
                (and (str_eq (nmmg-concept qweights) "model-weight-artifact")
                    (eq (nmmgt-has (nmmg-note qweights) "callability only") 1))))) 32768 0))
    (let c16 (if (and (eq (nmmgt-has executable "def nmmg-write-quiet") 1)
        (and (eq (nmmgt-has ownerSource "(nmmg-write-quiet fleet session") 1)
            (and (eq (nmmgt-has ownerSource "(let _memory-map (nmmg-write fleet session") 1)
                (lt (str_find ownerSource "(let _memory-frame (nmmg-write fleet session" 0) 0)))) 65536 0))
    (let c17 (if (and (eq (nmmgt-has src "const String CarrierSplitRule") 1)
        (and (eq (nmmgt-has src "const String QuietSnapshotRule") 1)
            (and (eq (nmmgt-has src
                    "idle quarter-second command polls neither intern nor render a snapshot") 1)
                (eq (nmmgt-has src
                    "it never claims mapped or materialized memory") 1)))) 131072 0))
    (sum (list base authority c15 c16 c17)))
