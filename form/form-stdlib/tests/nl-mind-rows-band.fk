; preludes: form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-loader.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/string-case.fk form-stdlib/nl-lexicon-data.fk form-stdlib/nl-translate.fk form-stdlib/nl-tongues.fk form-stdlib/nl-wisdom-row.fk form-stdlib/nl-mind-rows.fk
;
; nl-mind-rows-band.fk — four sentences of the mind, fourteen doors each,
; four distinct nodes:
;
;   THINKING IS WALKED       property(n9,  n13)
;   KNOWING IS WITNESSED     property(n10, n14)
;   BELIEVING IS STAMPED     property(n11, n15)
;   SPELLING IS CACHED       property(n12, n16)
;
; PROOF LEVEL: FOUR-WAY on 2026-08-04 — 8191 on fkwu (--src, fresh compile,
; preflight chain clean, the four already-named numb-op seams riding in the
; prelude chain as on every band of this shelf) and 8191 on the three heavy
; kernels (go, rust, ts), each on the concatenated closure + band (they do
; not read this preludes line; ts through the esbuild bundle, its tsx-worker
; seam being pre-existing and named in nl-wisdom-row-band). The minimal
; walkers cannot bind `bp` — that set boundary carries over unchanged.
; 100% local: every arm is built from this checkout; no oracle, no network.
;
; Bits, three per sentence:
;   doors  — all thirteen non-en doors intern to the en pivot (fold, one bit)
;   chain  — es -> ja -> hi round-trip holds the node fixed
;   sym    — the pivot's kids are the neutral symbols themselves, so a
;            lexicon miss passing a surface through cannot ride a green
;            round-trip in silence
; sentence bit triples: thinking 1/2/4, knowing 8/16/32, believing
; 64/128/256, spelling 512/1024/2048. One bit more (4096): the four pivots
; are PAIRWISE DISTINCT nodes — thinking is not knowing is not believing is
; not the spell, held as content-address inequality.
;
; Verdict 8191 when every door speaks, every pivot speaks symbols, and the
; four movements of the mind are four addresses.
(do
    (defn mnb-all (pv ns) (if (nil? ns) 1 (if (node_eq (head ns) pv) (mnb-all pv (tail ns)) 0)))
    (defn mnb-chain (pv) (if (node_eq (mn-enc-hi (mn-dec-hi (mn-enc-ja (mn-dec-ja (mn-enc-es (mn-dec-es pv)))))) pv) 1 0))
    (defn mnb-sym (pv s a) (if (str_eq (nlt-kidv pv 0) s) (if (str_eq (nlt-kidv pv 1) a) 1 0) 0))
    (defn mnb-tri (pv doors s a lo)
        (add (mul (mnb-all pv doors) lo)
             (add (mul (mnb-chain pv) (mul lo 2))
                  (mul (mnb-sym pv s a) (mul lo 4)))))

    (let p-think (mn-enc-en "the thinking is walked"))
    (let d-think (list
        (mn-enc-id "berpikir adalah dijalani")
        (mn-enc-es "el pensar es andado")
        (mn-enc-de "der denken ist begangen")
        (mn-enc-fr "le penser est parcouru")
        (mn-enc-pt "o pensar e percorrido")
        (mn-enc-ru "мышление есть пройдено")
        (mn-enc-sw "kufikiri ni kupitiwa")
        (mn-enc-zh "思考 是 行走")
        (mn-enc-ar "تفكير هو مسلوك")
        (mn-enc-hi "चिंतन चला है")
        (mn-enc-tr "düşünce yürünen dir")
        (mn-enc-ja "しこう は たどられる です")
        (mn-enc-sa "चिन्तनम् गतम् अस्ति")))

    (let p-know (mn-enc-en "the knowing is witnessed"))
    (let d-know (list
        (mn-enc-id "mengetahui adalah disaksikan")
        (mn-enc-es "el conocer es atestiguado")
        (mn-enc-de "der wissen ist bezeugt")
        (mn-enc-fr "le connaitre est atteste")
        (mn-enc-pt "o conhecer e testemunhado")
        (mn-enc-ru "знание есть засвидетельствовано")
        (mn-enc-sw "kujua ni kushuhudiwa")
        (mn-enc-zh "知晓 是 被见证")
        (mn-enc-ar "معرفة هو مشهود")
        (mn-enc-hi "जानना साक्षीकृत है")
        (mn-enc-tr "bilme tanıklanan dir")
        (mn-enc-ja "しる は しょうげんされる です")
        (mn-enc-sa "ज्ञानम् साक्षितम् अस्ति")))

    (let p-believe (mn-enc-en "the believing is stamped"))
    (let d-believe (list
        (mn-enc-id "percaya adalah dicap")
        (mn-enc-es "el creer es sellado")
        (mn-enc-de "der glauben ist gestempelt")
        (mn-enc-fr "le croire est scelle")
        (mn-enc-pt "o crer e carimbado")
        (mn-enc-ru "вера есть датировано")
        (mn-enc-sw "kuamini ni muhuri")
        (mn-enc-zh "相信 是 盖章")
        (mn-enc-ar "اعتقاد هو مختوم")
        (mn-enc-hi "विश्वास अंकित है")
        (mn-enc-tr "inanç damgalı dir")
        (mn-enc-ja "しんじる は しるされる です")
        (mn-enc-sa "श्रद्धा अङ्कितम् अस्ति")))

    (let p-spell (mn-enc-en "the spelling is cached"))
    (let d-spell (list
        (mn-enc-id "mantra adalah tersimpan")
        (mn-enc-es "el hechizo es guardado")
        (mn-enc-de "der zauber ist gespeichert")
        (mn-enc-fr "le sortilege est cache")
        (mn-enc-pt "o feitico e armazenado")
        (mn-enc-ru "заклинание есть сохранено")
        (mn-enc-sw "uchawi ni kuhifadhiwa")
        (mn-enc-zh "咒语 是 缓存")
        (mn-enc-ar "تعويذة هو مخزن")
        (mn-enc-hi "मंत्र संचित है")
        (mn-enc-tr "büyü saklanan dir")
        (mn-enc-ja "じゅもん は キャッシュ です")
        (mn-enc-sa "मन्त्रः सञ्चितम् अस्ति")))

    (let c-think   (mnb-tri p-think   d-think   "n9"  "n13" 1))
    (let c-know    (mnb-tri p-know    d-know    "n10" "n14" 8))
    (let c-believe (mnb-tri p-believe d-believe "n11" "n15" 64))
    (let c-spell   (mnb-tri p-spell   d-spell   "n12" "n16" 512))

    ; the four movements are four addresses — pairwise distinct nodes
    (let c-distinct (if (node_eq p-think p-know) 0
        (if (node_eq p-think p-believe) 0
        (if (node_eq p-think p-spell) 0
        (if (node_eq p-know p-believe) 0
        (if (node_eq p-know p-spell) 0
        (if (node_eq p-believe p-spell) 0 4096)))))))

    (add c-think (add c-know (add c-believe (add c-spell c-distinct)))))
