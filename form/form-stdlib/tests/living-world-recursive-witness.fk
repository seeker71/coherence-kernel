; living-world-recursive-witness.fk -- offered nested tissue for focused bands.
;
; Fixture vocabulary stays outside the organ.  The witnessed mapping reaches
; through a nested context, reverses two leaves, preserves a sibling, and adds
; one observed constant.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-recursive-application.fk

(let LWRRW-SOURCE  (bp "LWRRW-SOURCE"))
(let LWRRW-CONTEXT (bp "LWRRW-CONTEXT"))
(let LWRRW-TARGET  (bp "LWRRW-TARGET"))
(let LWRRW-WRAP    (bp "LWRRW-WRAP"))
(let LWRRW-ACTION  (bp "LWRRW-ACTION"))

(defn lwrrw-action () LWRRW-ACTION)
(defn lwrrw-interface () (lwo-interface (list LWRRW-ACTION)))
(defn lwrrw-source-a () (intern_trivial_string "lwrrw-source-a"))
(defn lwrrw-source-b () (intern_trivial_string "lwrrw-source-b"))
(defn lwrrw-source-c () (intern_trivial_string "lwrrw-source-c"))
(defn lwrrw-source-d () (intern_trivial_string "lwrrw-source-d"))
(defn lwrrw-source-e () (intern_trivial_string "lwrrw-source-e"))
(defn lwrrw-source-f () (intern_trivial_string "lwrrw-source-f"))
(defn lwrrw-provenance-a () (intern_trivial_string "lwrrw-provenance-a"))
(defn lwrrw-provenance-b () (intern_trivial_string "lwrrw-provenance-b"))
(defn lwrrw-provenance-c () (intern_trivial_string "lwrrw-provenance-c"))
(defn lwrrw-provenance-d () (intern_trivial_string "lwrrw-provenance-d"))
(defn lwrrw-provenance-e () (intern_trivial_string "lwrrw-provenance-e"))
(defn lwrrw-provenance-f () (intern_trivial_string "lwrrw-provenance-f"))
(defn lwrrw-response-provenance ()
    (intern_trivial_string "lwrrw-response-provenance"))
(defn lwrrw-marker () (intern_trivial_string "lwrrw-marker"))

(defn lwrrw-context (person color)
    (lwo-compose LWRRW-CONTEXT (list person color)))
(defn lwrrw-wrap (first second)
    (lwo-compose LWRRW-WRAP (list first second)))
(defn lwrrw-left (person color time)
    (lwo-compose LWRRW-SOURCE
        (list (lwrrw-context person color) time)))
(defn lwrrw-right (first second time)
    (lwo-compose LWRRW-TARGET
        (list (lwrrw-wrap first second) time (lwrrw-marker))))

(defn lwrrw-left-a ()
    (lwrrw-left (intern_trivial_string "alice")
                (intern_trivial_string "red")
                (intern_trivial_string "morning")))
(defn lwrrw-right-a ()
    (lwrrw-right (intern_trivial_string "red")
                 (intern_trivial_string "alice")
                 (intern_trivial_string "morning")))
(defn lwrrw-left-b ()
    (lwrrw-left (intern_trivial_string "bob")
                (intern_trivial_string "blue")
                (intern_trivial_string "evening")))
(defn lwrrw-right-b ()
    (lwrrw-right (intern_trivial_string "blue")
                 (intern_trivial_string "bob")
                 (intern_trivial_string "evening")))
(defn lwrrw-left-c ()
    (lwrrw-left (intern_trivial_string "carol")
                (intern_trivial_string "green")
                (intern_trivial_string "noon")))
(defn lwrrw-right-c ()
    (lwrrw-right (intern_trivial_string "carol")
                 (intern_trivial_string "green")
                 (intern_trivial_string "noon")))
(defn lwrrw-unseen-input ()
    (lwrrw-left (intern_trivial_string "dana")
                (intern_trivial_string "yellow")
                (intern_trivial_string "night")))
(defn lwrrw-expected-output ()
    (lwrrw-right (intern_trivial_string "yellow")
                 (intern_trivial_string "dana")
                 (intern_trivial_string "night")))
(defn lwrrw-left-e ()
    (lwrrw-left (intern_trivial_string "erin")
                (intern_trivial_string "violet")
                (intern_trivial_string "dawn")))
(defn lwrrw-right-e ()
    (lwrrw-right (intern_trivial_string "erin")
                 (intern_trivial_string "violet")
                 (intern_trivial_string "dawn")))
(defn lwrrw-left-f ()
    (lwrrw-left (intern_trivial_string "fran")
                (intern_trivial_string "orange")
                (intern_trivial_string "still")))

(defn lwrrw-correspondence-a ()
    (lwr-correspondence (lwrrw-left-a) (lwrrw-right-a)))
(defn lwrrw-correspondence-b ()
    (lwr-correspondence (lwrrw-left-b) (lwrrw-right-b)))
(defn lwrrw-correspondence-c ()
    (lwr-correspondence (lwrrw-left-c) (lwrrw-right-c)))
(defn lwrrw-correspondence-e ()
    (lwr-correspondence (lwrrw-left-e) (lwrrw-right-e)))

(defn lwrrw-offer (source payload provenance)
    (lwo-offer source (lwrrw-interface) 1 payload provenance 1))
(defn lwrrw-entry (source payload provenance)
    (lwt-entry (lwrrw-offer source payload provenance) (lwrrw-action)))
(defn lwrrw-response-entry (source provenance response)
    (lwrrw-entry source response provenance))

(defn lwrrw-correspondence-entries ()
    (list
        (lwrrw-entry (lwrrw-source-a) (lwrrw-correspondence-a)
                     (lwrrw-provenance-a))
        (lwrrw-entry (lwrrw-source-b) (lwrrw-correspondence-b)
                     (lwrrw-provenance-b))
        (lwrrw-entry (lwrrw-source-c) (lwrrw-correspondence-c)
                     (lwrrw-provenance-c))))

(defn lwrrw-base-round (threshold)
    (lwrr-tend (lwo-empty-world) (lwrrw-correspondence-entries)
               threshold (lwo-none)))
(defn lwrrw-first-proposal (round)
    (head (lwo-field-items (lwt-round-proposals round))))
(defn lwrrw-candidate (proposal) (lwt-proposal-candidate proposal))
(defn lwrrw-yes-response (proposal)
    (lwt-response proposal (oac-one (lwrrw-candidate proposal))
                  (lwrrw-response-provenance)))
(defn lwrrw-yes-entry (source provenance proposal)
    (lwrrw-response-entry source provenance (lwrrw-yes-response proposal)))

(defn lwrrw-mapping-yes-round (round proposal)
    (lwt-round-receive round
        (list
            (lwrrw-yes-entry (lwrrw-source-a) (lwrrw-provenance-a) proposal)
            (lwrrw-yes-entry (lwrrw-source-b) (lwrrw-provenance-b) proposal)
            (lwrrw-yes-entry (lwrrw-source-c) (lwrrw-provenance-c) proposal))))
(defn lwrrw-integrated-mapping-round (base proposal)
    (lwt-integrate (lwrrw-mapping-yes-round base proposal)
                   proposal (lwrrw-action)))

(defn lwrrw-input-world (world)
    (lwt-receive-stream world
        (list (lwrrw-entry (lwrrw-source-d) (lwrrw-unseen-input)
                           (lwrrw-provenance-d)))))
(defn lwrrw-application-yes-round (round proposal)
    (lwt-round-receive round
        (list
            (lwrrw-yes-entry (lwrrw-source-a) (lwrrw-provenance-a) proposal)
            (lwrrw-yes-entry (lwrrw-source-b) (lwrrw-provenance-b) proposal)
            (lwrrw-yes-entry (lwrrw-source-c) (lwrrw-provenance-c) proposal)
            (lwrrw-yes-entry (lwrrw-source-d) (lwrrw-provenance-d) proposal))))

(defn lwrrw-world-with-new-counterexample (world)
    (lwt-receive-stream world
        (list (lwrrw-entry (lwrrw-source-e) (lwrrw-correspondence-e)
                           (lwrrw-provenance-e)))))
(defn lwrrw-reopen-yes-round (round proposal)
    (lwt-round-receive round
        (list
            (lwrrw-yes-entry (lwrrw-source-a) (lwrrw-provenance-a) proposal)
            (lwrrw-yes-entry (lwrrw-source-b) (lwrrw-provenance-b) proposal)
            (lwrrw-yes-entry (lwrrw-source-c) (lwrrw-provenance-c) proposal)
            (lwrrw-yes-entry (lwrrw-source-e) (lwrrw-provenance-e) proposal))))

(defn lwrrw-confirming-experience (signature)
    (lwx-experience signature (lwrrw-unseen-input) (lwrrw-expected-output)
        (oac-one (lwrrw-expected-output))
        (intern_trivial_string "lwrrw-confirmed-locally")))
(defn lwrrw-correcting-experience (signature)
    (lwx-experience signature (lwrrw-left-e) (lwrrw-right-e)
        (oac-zero)
        (intern_trivial_string "lwrrw-correction-observed")))
(defn lwrrw-silent-experience (signature)
    (lwx-experience signature (lwrrw-left-f) (lwo-none)
        (oac-nothing)
        (intern_trivial_string "lwrrw-silence-observed")))

(defn lwrrw-world-with-experiences (world signature)
    (lwt-receive-stream world
        (list
            (lwrrw-entry (lwrrw-source-d)
                (lwrrw-confirming-experience signature)
                (lwrrw-provenance-d))
            (lwrrw-entry (lwrrw-source-e)
                (lwrrw-correcting-experience signature)
                (lwrrw-provenance-e))
            (lwrrw-entry (lwrrw-source-f)
                (lwrrw-silent-experience signature)
                (lwrrw-provenance-f)))))

(defn lwrrw-experience-reopen-yes-round (round proposal)
    (lwt-round-receive round
        (list
            (lwrrw-yes-entry (lwrrw-source-a) (lwrrw-provenance-a) proposal)
            (lwrrw-yes-entry (lwrrw-source-b) (lwrrw-provenance-b) proposal)
            (lwrrw-yes-entry (lwrrw-source-c) (lwrrw-provenance-c) proposal)
            (lwrrw-yes-entry (lwrrw-source-d) (lwrrw-provenance-d) proposal)
            (lwrrw-yes-entry (lwrrw-source-e) (lwrrw-provenance-e) proposal)
            (lwrrw-yes-entry (lwrrw-source-f) (lwrrw-provenance-f) proposal))))

(defn lwrrw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwrrw-sum (tail items)))))
