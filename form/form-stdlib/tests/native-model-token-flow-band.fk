; native-model-token-flow-band.fk — typed/absent/privacy/atomic flow proof.
;
; The fixture publishes only synthetic token metadata and a 16-byte buffer
; shape.  No prompt or generated text is present in the record type or wire.
;
; Verdict 2097151.
; preludes: form/form-stdlib/native-model-token-flow.bml

(do
    (defn nmtfb-has (rows value) (if (eq (len rows) 0) 0 (if (str_eq (head rows) value) 1 (nmtfb-has (tail rows) value))))
    (defn nmtfb-fields (token-pos token-id layer tensor bytes expert weight pipeline handle fb start end duration)
        (list token-pos token-id layer tensor bytes expert weight pipeline handle fb start end duration))
    (defn nmtfb-blank-fields ()
        (nmtfb-fields (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent)))
    (defn nmtfb-flow () "token-flow-band.flow-1")
    (defn nmtfb-publisher () "token-flow-band")
    (defn nmtfb-raw-model (node-id parent flow-id stage seq model fields evidence)
        (nmtf-event node-id parent (nmtfb-publisher) flow-id stage seq
            "fixture-owner" model
            (nth fields 0) (nth fields 1) (nth fields 2) (nth fields 3)
            (nth fields 4) (nth fields 5) (nth fields 6) (nth fields 7)
            (nth fields 8) (nth fields 9) (nth fields 10) (nth fields 11)
            (nth fields 12) 1234 "active" evidence "token-flow-band"))
    (defn nmtfb-raw (node-id parent flow-id stage seq fields evidence)
        (nmtfb-raw-model node-id parent flow-id stage seq
            "bounded-metal-fixture" fields evidence))
    (defn nmtfb-event (stage seq parent fields evidence)
        (nmtfb-raw (nmtf-form-event-node-id (nmtfb-publisher) (nmtfb-flow) stage seq) parent (nmtfb-flow) stage seq fields evidence))
    (let absent (fgtm-absent))
    (let q (nmtfb-event "request" 1 absent (nmtfb-blank-fields) "physical-live"))
    (let t (nmtfb-event "token" 2 (fgtm-present (nmtf-event-node-id q)) (nmtfb-fields (fgtm-present 41) (fgtm-present 7) absent absent absent absent absent absent absent absent absent absent absent) "physical-live"))
    (let l (nmtfb-event "layer" 3 (fgtm-present (nmtf-event-node-id t)) (nmtfb-fields absent absent (fgtm-present 0) absent absent absent absent absent absent absent absent absent absent) "physical-live"))
    (let x (nmtfb-event "tensor" 4 (fgtm-present (nmtf-event-node-id l)) (nmtfb-fields absent absent (fgtm-present 0) (fgtm-present "fixture.input.u32") (fgtm-present 16) absent absent absent absent absent absent absent absent) "physical-live"))
    (let e0 (nmtfb-event "expert" 5 (fgtm-present (nmtf-event-node-id x)) (nmtfb-fields absent absent (fgtm-present 0) absent absent absent absent absent absent absent absent absent absent) "declared"))
    (let ep (nmtfb-event "expert" 15 (fgtm-present (nmtf-event-node-id x)) (nmtfb-fields absent absent (fgtm-present 0) absent absent (fgtm-present 7) (fgtm-present 625000) absent absent absent absent absent absent) "physical-live"))
    (let m (nmtfb-event "metal" 6 (fgtm-present (nmtf-event-node-id e0)) (nmtfb-fields absent absent (fgtm-present 0) absent absent absent absent (fgtm-present "form_flow_copy_u32") (fgtm-present 99) absent (fgtm-present 1000) (fgtm-present 1250) (fgtm-present 250)) "physical-live"))
    (let f (nmtfb-event "framebuffer" 7 (fgtm-present (nmtf-event-node-id m)) (nmtfb-fields absent absent absent absent absent absent absent absent absent (fgtm-present 71) absent absent absent) "physical-live"))
    (let g (nmtfb-event "glass" 8 (fgtm-present (nmtf-event-node-id f)) (nmtfb-blank-fields) "physical-live"))
    (let events (list q t l x e0 m f g))
    (let snapshot (nmtf-snapshot "token-flow-band" 1234 events))
    (let wire (nmtf-snapshot-wire snapshot))
    (let parsed (nmtf-parse-snapshot-wire wire))
    (let other-flow "token-flow-band.flow-2")
    (let bad-next (nmtfb-raw (nmtf-form-event-node-id (nmtfb-publisher) other-flow "token" 2)
        (fgtm-present (nmtf-event-node-id q)) other-flow "token" 2
        (nmtfb-blank-fields) "declared"))
    (let bad-chain (nmtf-snapshot "token-flow-band" 1234 (list q bad-next)))
    (let bad-model-next (nmtfb-raw-model
        (nmtf-form-event-node-id (nmtfb-publisher) (nmtfb-flow) "token" 19)
        (fgtm-present (nmtf-event-node-id q)) (nmtfb-flow) "token" 19
        "other-model" (nmtfb-blank-fields) "declared"))
    (let bad-model-chain (nmtf-snapshot "token-flow-band" 1234
        (list q bad-model-next)))
    (let published (nmtf-publish-events "/tmp/form-native-token-flow-band" "token-flow-band" 1234 events))
    (let reread (nmtf-read-typed "/tmp/form-native-token-flow-band" "token-flow-band"))
    (let generic (fgtm-read-current "/tmp/form-native-token-flow-band" "token-flow-band"))
    (let es (nmtf-event-sample e0))
    (let eps (nmtf-event-sample ep))
    (let xs (nmtf-event-sample x))
    (let ms (nmtf-event-sample m))
    (sum (list
        (if (eq (nmtf-node-id? (nmtf-event-node-id t)) 1) 1 0)
        (if (and (eq (node_level (nmtf-form-event-node (nmtfb-publisher) (nmtfb-flow) "token" 2)) 2) (eq (node_type (nmtf-form-event-node (nmtfb-publisher) (nmtfb-flow) "token" 2)) 99)) 2 0)
        (if (and (eq (oti-family-capacity) 65536)
                 (eq (oti-operation-capacity) (mul 65536 65536))) 4 0)
        (if (eq (nmtf-event-valid? t) 1) 8 0)
        (if (eq (nmtf-snapshot-valid? bad-chain) 0) 16 0)
        (if (and (eq (fgtm-field-present? (nmtf-event-expert-index e0)) 0) (eq (fgtm-field-present? (nmtf-event-expert-weight-ppm e0)) 0)) 32 0)
        (if (and (eq (fgtm-field-present? (fgtm-sample-capacity es)) 0) (eq (fgtm-field-present? (fgtm-sample-heat es)) 0)) 64 0)
        (if (and (eq (fgtm-field-value (fgtm-sample-capacity eps)) 7) (eq (fgtm-field-value (fgtm-sample-heat eps)) 625)) 128 0)
        (if (and (eq (nmtf-snapshot-valid? parsed) 1) (str_eq (nmtf-snapshot-wire parsed) wire)) 256 0)
        (if (eq (nmtf-snapshot-valid? snapshot) 1) 512 0)
        (if (str_eq (nth published 1) "published") 1024 0)
        (if (and (eq (nmtf-snapshot-valid? reread) 1) (eq (len (nmtf-snapshot-events reread)) 8)) 2048 0)
        (if (str_eq (fgtm-read-state-status generic) "current") 4096 0)
        (if (eq (len (fgtm-snapshot-samples (fgtm-field-value (fgtm-read-state-value generic)))) 8) 8192 0)
        (if (lt (str_find wire "prompt" 0) 0) 16384 0)
        (if (and (eq (fgtm-field-value (fgtm-sample-bytes xs)) 16) (str_eq (fgtm-sample-purpose xs) "fixture.input.u32")) 32768 0)
        (if (and (eq (fgtm-field-value (fgtm-sample-handle ms)) 99) (eq (fgtm-field-value (fgtm-sample-capacity ms)) 250)) 65536 0)
        (if (and (eq (nmtfb-has (fgtm-sample-channels (nmtf-event-sample t)) "producer-runtime-id") 1)
                 (and (str_eq (fgtm-sample-source (nmtf-event-sample t)) (nmtfb-publisher))
                      (and (str_eq (fgtm-sample-owner (nmtf-event-sample t)) "fixture-owner")
                           (str_eq (fgtm-sample-lane (nmtf-event-sample t)) (nmtfb-flow))))) 131072 0)
        (if (and (eq (nmtf-events-chain? events) 1)
                 (not (str_eq (nmtf-form-event-node-id (nmtfb-publisher) (nmtfb-flow) "token" 2)
                              (nmtf-form-event-node-id (nmtfb-publisher) other-flow "token" 2)))) 262144 0)
        (if (and (eq (nmtf-snapshot-valid? bad-model-chain) 0)
                 (eq (nmtf-snapshot-valid? (nmtf-snapshot "other-publisher" 1234 events)) 0)) 524288 0)
        (if (str_eq (nth (nmtf-read-typed-parsed "other-publisher" parsed) 1)
                         "publisher-mismatch") 1048576 0))))
