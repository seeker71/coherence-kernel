; ear-judge-band.bml — tiny judges turbo's windows: turbo cannot say that nobody is speaking, tiny can
; (ear-acoustic-review.bml eac-judge, observe/ear-live-native.fk).
;
; On 2026-11-07 one night of the live ear on whisper-large-v3-turbo closed 5476 lines, 2257 of them only
; "So", "Okay." or "Thank you."; 5645 of 5650 turbo lines in the spool read no-speech 0. Over 8 s of digital
; silence turbo's sot step puts <|nospeech|> at 0.00000 and writes " Thank you.", where tiny answers 0.877.
; The speech is this room's own 2 s (fixtures/ear-okay-2s.wav), laid at the END of an 8 s window in the
; mic's 3200-byte pieces: the window where tiny's doubt runs highest on real words (0.61).
;
; Expected: 63
; Verdict 63 when every claim lands:
;   1   turbo over digital silence reads no-speech under one per-mille and still writes words: the defect
;   2   tiny judges that silence quiet (past enw-doubt-line)
;   4   tiny judges the room's own speech at the window's end as speaking
;   8   turbo's silent pass, judged: no words, not credible, its words kept as unheard for the spool
;   16  turbo's pass over the speech, judged: its words kept, nothing unheard, credible
;   32  the witness: a speaking window and a lane with no judge always ask turbo; quiet windows ask every
;       4th in a row; a pass not asked carries no words, the judge's reading and the window's gain
; REQUIRES: a live Metal device, whisper-tiny and whisper-large-v3-turbo in the reference's cache
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/ear-acoustic-review.bml form-stdlib/native-whisper.bml
section [form.bml] {
 class EarJudgeBand {
  def ejb-chunks(s, i, acc) = i >= len(s) ? reverse(acc) : ejb-chunks(s, i + 3200, cons(substring(s, i, elp-min(len(s), i + 3200)), acc));
  def ejb-c-mute(ctx) = ctx[0][7] < 1 && eac-words?(ctx[0]);
  def ejb-c-silence(ctx) = eac-quiet?(ctx[1][0]) && ctx[1][0] > 870;
  def ejb-c-speech(ctx) = !eac-quiet?(ctx[2][0]) && ctx[2][0] > 0;
  def ejb-c-away(ctx) {
   let j = eac-judged(ctx[0], ctx[1][0]);
   !eac-words?(j) && !eac-credible?(j) && len(eac-unheard(j)) > 0 && (String) eac-unheard(j) == ctx[0][1];
  }
  def ejb-c-kept(ctx) {
   let j = eac-judged(ctx[3], ctx[2][0]);
   eac-words?(j) && (String) j[1] == ctx[3][1] && (Comparable) len(eac-unheard(j)) == 0 && eac-credible?(j) && (Comparable) j[7] == ctx[2][0];
  }
  def ejb-c-witness(ctx) {
   let held = record_new(0, "quiet", 0);
   let asks = foldl((acc, i) => append(acc, [eac-ask?(held, [900, 1000]) ? 1 : 0]), [], [1, 2, 3, 4, 5, 6, 7, 8]);
   let speaking = eac-ask?(held, [400, 1000]);
   let after = record_get(held, "quiet");
   let lone = eac-ask?(held, [0 - 1, 0]);
   let u = eac-unasked([900, 1234]);
   foldl((n, a) => n + a, 0, asks) == 2 && asks[3] == 1 && asks[7] == 1 && speaking && (Comparable) after == 0 && lone
    && !eac-words?(u) && (Comparable) u[7] == 900 && (Comparable) u[10] == 1234 && (Comparable) len(eac-unheard(u)) == 0;
  }
 }
 let snap = "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/snapshots/" + trim(en-text(read_file("/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/refs/main")));
 let tiny = enw-open(snap + "/weights.npz", enw-tokenizer-path());
 let turbo = nws-open(nws-base(), nws-tokenizer());
 let bytes = en-text(read_file("form/form-stdlib/tests/fixtures/ear-okay-2s.wav"));
 let pcm = substring(bytes, 44, len(bytes));
 let speech = ejb-chunks(pcm, 0, []);
 let born = elp-born();
 let ctx = [eac-open-plain(turbo, [], 0, 0, 8, born), eac-judge(tiny, [], 0, 0, born), eac-judge(tiny, speech, len(pcm), 0, born), eac-open-plain(turbo, speech, len(pcm), 0, 8 + (len(pcm) / 2000), born)];
 print_str("ear-judge: turbo over silence nsp=" + ctx[0][7].str() + " lp=" + ctx[0][9].str() + " says \"" + ctx[0][1] + "\"; tiny over silence " + ctx[1][0].str() + ", over speech " + ctx[2][0].str() + "; turbo over speech \"" + ctx[3][1] + "\" lp=" + ctx[3][9].str() + "\n");
 live-claims("ear-judge-band", ctx, [["mute", 1, 1, ejb-c-mute], ["silence", 2, 1, ejb-c-silence], ["speech", 4, 1, ejb-c-speech], ["away", 8, 1, ejb-c-away], ["kept", 16, 1, ejb-c-kept], ["witness", 32, 1, ejb-c-witness]]);
}
