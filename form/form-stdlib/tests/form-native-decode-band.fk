; form-native-decode-band.fk — the witness for form-native-decode.fk's fnd-run: the whole
; open-bytes -> bind -> enqueue -> sync -> read -> decode -> compare sequence, against the real GPU.
;
; TWO PROOF LEVELS, NAMED SEPARATELY, same discipline metal-door-band.fk and
; metal-handle-door-timing-probe.fk each hold — and split across two FILES here rather than two
; sections of one, so the manifest row can name exactly what it proves:
;
;   FOUR-WAY: form-native-decode-encoding-band.fk (fourth-arm-bands.txt row
;   `form-native-decode-encoding`) — the synthetic input, its IEEE-754 encoding (md-le32/
;   md-f32-bits), its round-trip through the door's own f32 decoder (ewl-gain), and fnd-maxdiff.
;   None of it touches Metal, so it is exactly as four-way-provable as any other Form recipe.
;
;   WITNESSED ONLY, NOT A FOUR-WAY CLAIM (this file): fnd-run and everything it does — Metal is a
;   host organ, not a fourth walker, so there is no GPU on the Go/Rust/TS walkers to agree or
;   disagree with. On plain fkwu (carrier not linked) every bit below reads 0, and that 0 is
;   correct, not a divergence — the same "3-kernel only — Metal host organ" honest floor
;   metal-door-band.fk and metal-handle-door-band.fk both name in their own headers.
;
; RUN (needs the carrier linked; plain ./fkwu answers metal_linked=false and every bit is 0):
;   cc -O2 -o fkwu-metal runtime/fkwu-uni.c form/native/metal/fk-metal-carrier.m \
;      -framework Metal -framework Foundation -fobjc-arc
;   ./fkwu-metal --src form/form-stdlib/tests/form-native-decode-band.fk
;
; Verdict bits, powers of two so a dark one is readable on sight:
;    1  md-door-live? holds (metal_linked=true AND metal_door=handle) — the canary every bit past
;       here depends on; dark here means every bit past here is a verdict about nothing
;    2  all three buffers opened (handle > 0 for gain/input/output) and metal_status names the
;       resident set mmap_nocopy — the real attn_norm.weight bytes, not a copy
;    4  ONE dispatch enqueued, ONE sync drained exactly 1 — the shape the whole task exists to
;       prove: bind, enqueue, ONE wait, nothing in between decided by a host
;    8  the GPU's own RMSNorm output equals Form's independent ln-rmsnorm on the same real gain
;       tensor, within a stated float tolerance (max|Δ| printed either way — this bit is not a
;       pass/fail hidden inside a sum, the number is on the page)
;
; preludes: form-stdlib/core.fk form-stdlib/format-arith.fk form-stdlib/metal-door.fk form-stdlib/equireach.fk form-stdlib/equireach-gguf.fk form-stdlib/gguf-meta.fk native/metal/whole-tensor-residency.fk form-stdlib/llama-decode-msl.fk form-stdlib/llama-numerics.fk form-stdlib/form-native-decode.fk

(do
    (let r (fnd-run))
    (let live (nth r 0))
    (let d (nth r 1))
    (let eps (nth r 2))
    (let gnabs (nth r 3))
    (let hg (nth r 4))
    (let hx (nth r 5))
    (let hy (nth r 6))
    (let pipe (nth r 7))
    (let e1 (nth r 8))
    (let synced (nth r 9))
    (let maxdiff (nth r 10))
    (let st (metal_status))

    (print_str (str_concat "metal_status " st))
    (print_str (str_concat "door-live " (if live "true" "false")))
    (print_str (str_concat "d_model " (int_to_str d)))
    (print_str (str_concat "eps " (float_to_str eps)))
    (print_str (str_concat "attn_norm.weight-abs-offset " (int_to_str gnabs)))
    (print_str (str_concat "handles g/x/y/pipe "
        (str_concat (int_to_str hg) (str_concat " " (str_concat (int_to_str hx)
        (str_concat " " (str_concat (int_to_str hy) (str_concat " " (int_to_str pipe)))))))))
    (print_str (str_concat "enqueue-ok " (int_to_str e1)))
    (print_str (str_concat "synced-dispatches " (int_to_str synced)))
    (print_str (str_concat "max-abs-delta form-vs-gpu " (float_to_str maxdiff)))

    (let door-ok (if live 1 0))
    (let bufs-ok (if (gt hg 0) (if (gt hx 0) (if (gt hy 0) 1 0) 0) 0))
    (let mmap-ok (if (gt hg 0) (if (ge (str_find st "mmap_nocopy_buffers=1" 0) 0) 1 0) 0))
    (let bufs-mmap-ok (if (eq bufs-ok 1) (if (eq mmap-ok 1) 1 0) 0))
    (let dispatch-ok (if (eq e1 1) (if (eq synced 1) 1 0) 0))
    ; float compares tolerate rounding between fkwu's Newton-50 sqrt and libm's exp/sqrt inside
    ; tn-sqrt's own fixed-count Newton — llama-numerics.fk's header pins that gap at 1e-6 against
    ; libm; the GPU kernel's OWN Newton-50 (transcribed verbatim from the same recipe) is judged
    ; against that same order of magnitude, not bit-exactness, and the number is printed above
    ; either way so a reader checks the bit against the evidence, not the other way around.
    (let numeric-ok (if (lt maxdiff 0.001) 1 0))

    (add (mul door-ok 1)
    (add (mul (if (eq door-ok 1) bufs-mmap-ok 0) 2)
    (add (mul (if (eq door-ok 1) dispatch-ok 0) 4)
         (mul (if (eq door-ok 1) numeric-ok 0) 8)))))
