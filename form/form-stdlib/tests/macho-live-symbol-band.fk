; A live artifact-owned lookup. The expected value is intentionally not stored:
; the symbol delta is allowed to move whenever the carrier is relinked.
;
; witnessed: 2026-07-28 -> 166028
;
; preludes: native/metal/macho-live-symbol.fk

(do
    (let delta
        (mls-symbol-delta
            "fkwu-metal-transaction"
            "_fk_metal_model_transaction_external"))
    (if (gt delta 0) delta 0))
