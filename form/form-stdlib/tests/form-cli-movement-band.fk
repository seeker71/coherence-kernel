; form-cli-movement-band.fk — the movement grammar: three declared
; witnesses walked by the body, one knowing back. Expected: 15
;   1..4  three real bands answer their declarations through fmv-whole
;   8     an absent band answers -1, never a false agreement
; preludes: form-stdlib/form-cli-movement.bml
(do
    (let rows (list
        (fmv-row "gate/tests/structural-gate-band.fk" 8191)
        (fmv-row "form/form-stdlib/tests/nodeid-interning-band.fk" 127)
        (fmv-row "form/form-stdlib/tests/form-cli-rest-answer-bml-band.fk" 15)))
    (sum (list
        (fmv-whole rows)
        (if (eq (fmv-ask "no/such/band.fk") (sub 0 1)) 8 0))))
