; living-world-behavioral-species-enquiry-band.fk -- the field answers natively.
; Verdict 32767 proves fifteen offered-question, derivation, and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk form-stdlib/tests/living-world-behavioral-species-witness.fk

(do
    (let equivalent (lwbsw-build-equivalent))
    (let species-fixture (lwbsw-integrated-species equivalent))
    (let species (lwbsw-species-candidate species-fixture))
    (let species-field (lwo-emergent-shape species))
    (let question (lwbsw-question species))
    (let question-world (lwbsw-question-world species-fixture))
    (let answer (lwbs-answer-for question-world question 2))
    (let proposal (lwbs-answer-proposal question-world question 2))
    (let candidate (lwt-proposal-candidate proposal))
    (let waiting-round
        (lwt-round question-world (lwo-field (list proposal))
            (lwo-empty-field) (lwbsw-species-round species-fixture)))
    (let waiting
        (lwbs-answer-integrate waiting-round proposal (lwigw-action)))
    (let integrated (lwbsw-integrated-answer species-fixture))
    (let integrated-world (lwt-round-world (lwbsw-answer-round integrated)))
    (let integrated-candidate (lwbsw-answer-candidate integrated))
    (let derivation (lwbs-answer-derivation answer))
    (let revoked-world
        (lwt-receive-stream integrated-world
            (list
                (lwbsw-entry-q2
                    (lwo-revocation question (lwbsw-source-q2)
                        (lwbsw-reason) (lwbsw-prov-q2))))))

    (let c1
        (if (eq (lwbs-integrated-current? question-world species) 1) 1 0))
    (let c2
        (if (and (eq (lwbs-question-valid? question) 1)
                 (node_eq (lwbs-question-lens question)
                          (lwbsw-lens-g))) 2 0))
    (let c3
        (if (eq (lwo-field-size
                    (lwo-active-attributions-for
                        question-world question)) 2) 4 0))
    (let c4
        (if (and (not (node_eq answer (lwo-none)))
                 (eq (lwbs-answer? answer) 1)) 8 0))
    (let c5
        (if (and (node_eq (lwbs-answer-species answer) species)
                 (node_eq (lwbs-answer-members answer)
                          (lwbs-field-members species-field))) 16 0))
    (let c6
        (if (node_eq (lwbs-answer-receipts answer)
                     (lwbs-field-receipts species-field)) 32 0))
    (let c7
        (if (node_eq (lwbs-answer-signature answer)
                     (oac-payload
                        (lwbs-field-comparison species-field))) 64 0))
    (let c8
        (if (and (eq (oac-node? (lwbs-answer-ack answer)) 1)
                 (node_eq (oac-payload (lwbs-answer-ack answer))
                          (lwbs-answer-members answer))) 128 0))
    (let c9
        (if (eq (lwo-field-has?
                    (lwbs-answer-alternatives answer)
                    (lwbsw-alternative)) 1) 256 0))
    (let c10
        (if (eq (lwo-field-has?
                    (lwbs-answer-unknowns answer)
                    (lwlc-unknown (lwbsw-question-evidence))) 1) 512 0))
    (let c11
        (if (and (eq (lwbs-derivation? derivation) 1)
                 (and (node_eq (lwbs-derivation-field derivation)
                               species-field)
                      (eq (lwo-field-size
                              (lwbs-derivation-question-attributions
                                  derivation)) 2))) 1024 0))
    (let c12
        (if (and (eq (lwo-field-size
                         (lwt-proposal-participants proposal)) 18)
                 (eq (lwbs-answer-proposal-current?
                         question-world proposal) 1)) 2048 0))
    (let c13
        (if (eq (lwo-active?
                    (lwt-round-world waiting) candidate) 0) 4096 0))
    (let c14
        (if (and (eq (lwbs-answer-integrated-current?
                         integrated-world integrated-candidate 2) 1)
                 (node_eq (lwbsw-answer-shape integrated) answer)) 8192 0))
    (let c15
        (if (and (node_eq
                    (lwbs-answer-for question-world question 0)
                    (lwo-none))
                 (and (node_eq
                        (lwbs-answer-for revoked-world question 2)
                        (lwo-none))
                      (eq (lwbs-answer-candidate-current?
                              revoked-world integrated-candidate 2) 0)))
            16384 0))
    (lwtnw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
