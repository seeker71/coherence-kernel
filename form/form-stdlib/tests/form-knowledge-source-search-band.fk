; form-knowledge-source-search-band.fk — live source retrieval stays bounded,
; sees matches split across byte-window boundaries, and never fabricates a
; substrate REF for a plain source artifact.
;
; Four-way: 262143 on fkwu, go, rust and ts (witnessed 2026-09-03; source_inventory pf-arm-mask 15).
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-fs.fk form-stdlib/file-byte-window.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/form-knowledge-source-search.fk
;
; Verdict 262143.

(do
    (defn fkssb-bit (ok bit) (if ok bit 0))
    (defn fkssb-root () (fs-path-join (fs-temp-dir) "form-knowledge-source-search-band"))
    (defn fkssb-repeat-loop (s n acc)
        (if (le n 0) acc (fkssb-repeat-loop s (sub n 1) (str_concat acc s))))
    (defn fkssb-repeat (s n) (fkssb-repeat-loop s n ""))
    (defn fkssb-setup ()
        (do
            (let root (fkssb-root))
            (let _old (fs-remove-tree root))
            (let _mk (fs-mkdir root))
            (let _docs (fs-mkdir (fs-path-join root "docs")))
            (let _form (fs-mkdir (fs-path-join root "form")))
            (let _git (fs-mkdir (fs-path-join root ".git")))
            (let _a (fs-write-text (fs-path-join root "docs/bridge.md")
                "The HeedMark lets the carrier honor a bounded knowledge request."))
            (let _b (fs-write-text (fs-path-join root "form/cursor.fk")
                (str_concat (fkssb-repeat "a" 4094) "HeEdMaRk crosses the live cursor boundary.")))
            (let _c (fs-write-text (fs-path-join root "form/grammar.bml")
                "section [query.bmf] { request ::= cursor grammar; }"))
            (let _d (fs-write-text (fs-path-join root "form/capture.bmf")
                "signal ::= streaming transducer capture"))
            (let _ignored (fs-write-text (fs-path-join root "notes.txt")
                "heedmark carrier should be ignored by extension"))
            (let _hidden (fs-write-text (fs-path-join root ".git/hidden.md")
                "heedmark carrier should be ignored by directory"))
            0))
    (defn fkssb-cleanup () (fs-remove-tree (fkssb-root)))

    (defn form-knowledge-source-search-band ()
        (do
            (let _setup (fkssb-setup))
            (let root (fkssb-root))
            (let hit (fkss-search-at root (list "heedmark" "carrier")))
            (let cross (fkss-search-at root (list "heedmark" "cursor")))
            (let miss (fkss-search-at root (list "unfindable-concept-xyz")))
            (let bmf (fkss-search-at root (list "streaming" "transducer")))
            (let nothing (fkss-search-at root (list)))
            (let too-long (fkss-search-at root (list (fkssb-repeat "x" 129))))
            (let expected-id (str_concat "sha256:"
                (hex-encode (sha256-stream-string
                    "The HeedMark lets the carrier honor a bounded knowledge request."))))
            (let score (sum (list
                (fkssb-bit (str_eq (fkss-status hit) "hit") 1)
                (fkssb-bit (str_eq (fkss-source-path hit) "docs/bridge.md") 2)
                (fkssb-bit (str_eq (fkss-source-id-of hit) expected-id) 4)
                (fkssb-bit (eq (fkss-matched hit) 2) 8)
                (fkssb-bit (and (ge (fkss-find-ci (fkss-answer hit) "heedmark") 0)
                                (ge (fkss-find-ci (fkss-answer hit) "carrier") 0)) 16)
                (fkssb-bit (and (eq (fkss-eligible-count hit) 4)
                                (eq (fkss-accessible-count hit) 4)) 32)
                (fkssb-bit (eq (fkss-coverage-percent hit) 100) 64)
                (fkssb-bit (and (str_eq (fkss-status cross) "hit")
                                (str_eq (fkss-source-path cross) "form/cursor.fk")) 128)
                (fkssb-bit (eq (fkss-first-offset cross) 4094) 256)
                (fkssb-bit (ge (fkss-find-ci (fkss-answer cross) "heedmark") 0) 512)
                (fkssb-bit (and (str_eq (fkss-status miss) "miss")
                                (str_eq (fkss-reason miss) "no-current-source-match")) 1024)
                (fkssb-bit (and (str_eq (fkss-status nothing) "nothing")
                                (str_eq (fkss-reason nothing) "invalid-query-atoms")) 2048)
                (fkssb-bit (str_eq (fkss-status too-long) "nothing") 4096)
                (fkssb-bit (and (str_eq (nth hit 3) "source-artifact-stream-v1")
                                (str_eq (fkss-result-route hit)
                                    "source_inventory+bounded-byte-window+form-sha256-stream")) 8192)
                (fkssb-bit (eq (fkss-model-executed hit) 0) 16384)
                (fkssb-bit (and (le (str_len (fkss-answer hit)) (fkss-answer-limit))
                                (le (str_len (fkss-answer cross)) (fkss-answer-limit))) 32768)
                (fkssb-bit (and (str_eq (fkss-status bmf) "hit")
                                (str_eq (fkss-source-path bmf) "form/capture.bmf")) 65536)
                (fkssb-bit (and (eq (fkss-answer-cut? hit) 0)
                                (and (eq (fkss-answer-cut? cross) 1)
                                     (gt (fkss-source-size cross)
                                         (str_len (fkss-answer cross))))) 131072))))
            (let _cleanup (fkssb-cleanup))
            score))
    (form-knowledge-source-search-band))
