; living-world-contextual-species-split-band.fk -- divergence does not choose.
; Verdict 32767 proves fifteen split, staleness, ambiguity, and reopen claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk form-stdlib/living-world-contextual-species.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk form-stdlib/tests/living-world-behavioral-species-witness.fk form-stdlib/tests/living-world-contextual-species-witness.fk

(do
    (let multi (lwcsw-build-multi))
    (let coherent-world (lwcsw-coherent-world multi))
    (let coherent (lwcsw-integrated-coherent-tissue multi))
    (let coherent-world-integrated
        (lwt-round-world (lwcsw-tissue-round coherent)))
    (let old-candidate (lwcsw-tissue-candidate coherent))
    (let split (lwcsw-build-split multi coherent))
    (let world (lwcsw-split-world-cell split))
    (let f (lwtnw-trial-candidate (lwcsw-split-f-trial split)))
    (let eg (lwbsw-species-candidate (lwcsw-eg-species multi)))
    (let gh (lwbsw-species-candidate (lwcsw-gh-species multi)))
    (let shared-kernel (lwcs-kernel-for-anchor world eg))
    (let other-kernel (lwcs-kernel-for-anchor world f))
    (let field (lwcs-field-for world (lwcsw-focus) 2))
    (let components (lwcs-field-components field))
    (let shared
        (lwcs-component-for-kernel components shared-kernel))
    (let other
        (lwcs-component-for-kernel components other-kernel))
    (let shared-proposal
        (lwcs-tissue-proposal world (lwcsw-focus) shared-kernel 2))
    (let other-proposal
        (lwcs-tissue-proposal world (lwcsw-focus) other-kernel 2))
    (let split-tissue (lwcsw-split-tissue split))
    (let split-candidate (lwcsw-tissue-candidate split-tissue))
    (let ambiguous-world
        (lwcsw-ambiguous-world coherent-world eg f))
    (let ambiguous-field
        (lwcs-field-for ambiguous-world (lwcsw-focus) 2))
    (let open-world
        (lwcsw-revoked-context-world
            coherent-world gh (lwcsw-context-b)))
    (let open-field (lwcs-field-for open-world (lwcsw-focus) 2))
    (let open-component
        (head (lwo-field-items (lwcs-field-components open-field))))

    (let c1
        (if (eq (lwcs-tissue-integrated-current?
                    coherent-world-integrated old-candidate) 1) 1 0))
    (let c2
        (if (and (eq (lwbs-historical-trial-valid? world f) 1)
                 (node_eq
                    (lwrx-overall-after
                        (lwtn-trial-actual (lwo-emergent-shape f)))
                    (intern_trivial_int 3))) 2 0))
    (let c3
        (if (and (not (node_eq shared-kernel other-kernel))
                 (and (node_eq (lwcs-kernel-after shared-kernel)
                               (intern_trivial_int 4))
                      (node_eq (lwcs-kernel-after other-kernel)
                               (intern_trivial_int 3)))) 4 0))
    (let c4
        (if (and (eq (lwcs-split? (lwcs-field-status field)) 1)
                 (eq (lwo-field-size components) 2)) 8 0))
    (let c5
        (if (and (eq (lwo-field-size
                         (lwcs-component-members shared)) 3)
                 (eq (lwo-field-size
                         (lwcs-component-anchors shared)) 2)) 16 0))
    (let c6
        (if (and (eq (lwo-field-size
                         (lwcs-component-members other)) 1)
                 (eq (lwo-field-size
                         (lwcs-component-receipts other)) 1)) 32 0))
    (let c7
        (if (and (eq (lwo-field-has?
                         (lwcs-field-alternatives field) shared) 1)
                 (and (eq (lwo-field-has?
                              (lwcs-field-alternatives field) other) 1)
                      (gt (lwo-field-size
                              (lwcs-field-unknowns field)) 0))) 64 0))
    (let c8
        (if (and (eq (lwo-active? world old-candidate) 1)
                 (eq (lwcs-tissue-candidate-current?
                         world old-candidate) 0)) 128 0))
    (let c9
        (if (and (not (node_eq shared-proposal (lwo-none)))
                 (and (eq (lwo-field-size
                              (lwt-proposal-participants
                                shared-proposal)) 30)
                      (eq (lwcs-tissue-proposal-current?
                              world shared-proposal) 1))) 256 0))
    (let c10
        (if (node_eq other-proposal (lwo-none)) 512 0))
    (let c11
        (if (and (eq (lwcs-tissue-integrated-current?
                         world split-candidate) 1)
                 (eq (lwcs-split?
                         (lwcs-field-status
                           (lwcs-tissue-field
                             (lwo-emergent-shape split-candidate)))) 1))
            1024 0))
    (let c12
        (if (and (eq (lwcs-ambiguous?
                         (lwcs-field-status ambiguous-field)) 1)
                 (node_eq
                    (lwcs-tissue-proposal
                        ambiguous-world (lwcsw-focus) shared-kernel 2)
                    (lwo-none))) 2048 0))
    (let c13
        (if (and (eq (lwcs-open?
                         (lwcs-field-status open-field)) 1)
                 (and (eq (lwo-field-size
                              (lwcs-set-provisional
                                (lwcs-field-evidence open-field))) 1)
                      (eq (lwo-field-size
                              (lwcs-component-members open-component)) 2)))
            4096 0))
    (let c14
        (if (and (node_eq
                    (lwcs-tissue-proposal
                        open-world (lwcsw-focus) shared-kernel 2)
                    (lwo-none))
                 (eq (lwcs-tissue-candidate-current?
                         open-world old-candidate) 0)) 8192 0))
    (let c15
        (if (and (eq (lwo-field-size
                         (lwcs-set-silences
                           (lwcs-field-evidence open-field))) 1)
                 (and (eq (lwo-field-has?
                              (lwcs-field-alternatives open-field)
                              (lwcsw-option)) 1)
                      (gt (lwo-field-size
                              (lwcs-field-unknowns open-field)) 0)))
            16384 0))
    (lwtnw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
