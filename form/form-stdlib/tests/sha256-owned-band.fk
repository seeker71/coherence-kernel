; The same bytes meet independent Form SHA and the owned native CPU program.
; Padding, refused/short reads, changed extents and independent lifetimes are real.
; preludes: form-stdlib/bml/sha256-owned.bml form-stdlib/hex.fk
; Verdict: 16383
(do
 (defn shob-string (n) (if (le n 0) "" (str_concat "x" (shob-string (sub n 1)))))
 (defn shob-hex (s i) (if (ge i (str_len s)) "" (str_concat (hex-byte-to-pair (str_byte_at s i)) (shob-hex s (add i 1)))))
 (defn shob-check (path text)
  (do (let wrote (write_file path text))
      (let got (sho-file path))
      (and (str_eq (shob-hex (record_get got "digest") 0) (hex-encode (sha256-stream-string text)))
           (and (eq (record_get got "pipeline") 0) (nil? (record_get got "buffers"))))))
 (defn shob-refused (owner reason)
  (and (str_eq (record_get owner "reason") reason)
    (and (eq (str_len (record_get owner "digest")) 0)
      (and (eq (record_get owner "pipeline") 0) (nil? (record_get owner "buffers"))))))
 (defn shob-short (path)
  (do (let wrote (write_file path "abc"))
      (let size (file_size path))
      (let shortened (fs_truncate path 2))
      (shob-refused (sho-open (sho-owner) path size) "tail-read-short")))
 (defn shob-missing-read (path)
  (do (let wrote (write_file path "abc"))
      (let size (file_size path))
      (let removed (fs_remove path))
      (shob-refused (sho-open (sho-owner) path size) "tail-read-refused")))
 (defn shob-empty-removed (path)
  (do (let wrote (write_file path ""))
      (let size (file_size path))
      (let removed (fs_remove path))
      (shob-refused (sho-open (sho-owner) path size) "file-size-changed")))
 (defn shob-changed-at-settle (path)
  (do (let wrote (write_file path "abc"))
      (let size (file_size path))
      (let hashed (sho-file path))
      (let owner (sho-owner))
      (let buffer (metal_buf_alloc 32))
      (let pipeline (mj-handle (mj-memory (saj-code) "form_cpu_jit")))
      (let ownb (record_set owner "buffers" (list buffer)))
      (let ownp (record_set owner "pipeline" pipeline))
      (let changed (write_file path "abcd"))
      (let settled (sho-settle owner path size (record_get hashed "digest")))
      (and (gt buffer 0) (and (gt pipeline 0)
        (and (eq (str_len (record_get hashed "digest")) 32)
          (shob-refused settled "file-size-changed"))))))
 (let path (str_concat (temp_dir) (str_concat "/sha-owned-" (int_to_str (host_pid)))))
 (let before (metal_live))
 (let shared (metal_pipeline (saj-code) "form_cpu_jit"))
 (let result (sum (list
  (if (shob-check path "") 1 0)
  (if (shob-check path "abc") 2 0)
  (if (shob-check path (shob-string 55)) 4 0)
  (if (shob-check path (shob-string 56)) 8 0)
  (if (shob-check path (shob-string 63)) 16 0)
  (if (shob-check path (shob-string 64)) 32 0)
  (if (shob-check path (shob-string 65)) 64 0)
  (if (shob-check path (shob-string 128)) 128 0))))
 (let after (metal_live))
 (let release (mj-release-handle shared))
 (let gone (fs_remove path))
 (let absent (sho-file path))
 (let boundaries (sum (list
  (if (shob-short path) 1024 0)
  (if (shob-missing-read path) 2048 0)
  (if (shob-empty-removed path) 4096 0)
  (if (shob-changed-at-settle path) 8192 0))))
 (let final (metal_live))
 (let cleaned (fs_remove path))
 (if (and (eq (nth final 2) (nth before 2)) (eq (nth final 3) (nth before 3)))
 (add boundaries (add result (add
  (if (and (eq (nth after 2) (nth before 2)) (and (eq (nth after 3) (add (nth before 3) 1)) (eq release 1))) 256 0)
  (if (and (eq gone 0) (eq (str_len (record_get absent "digest")) 0)) 512 0)))) 0))
