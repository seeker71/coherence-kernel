; form-cli-rest-force-bml-band.fk — the rest-force surface, risen: the
; authored BML crystallizes to its xtal, the xtal's behavior matches the
; law (cold walks, fifth births, unlowerable answers visibly), and the
; earlier .fk organ agrees with the risen surface value-for-value.
;
; Verdict 31:
;   1   rfb-check  = 255 — the crystallized surface carries the whole law
;   2   rfb-agree  = 15  — surface and organ lower and force as one
;   4   the authority binding names the restanswer lawface exactly
;   8   the executable .bml text carries its section and force def
;   16  the authority .bml text carries its package and class
;
; preludes: form-stdlib/core.fk form-stdlib/substrate-phase.fk form-stdlib/source-resonance-stream.fk form-stdlib/learning-loop.fk form-stdlib/local-generate-organ.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk form-stdlib/jit-decision.fk form-stdlib/jit-once-born.fk form-stdlib/jit-heat-gate.fk form-stdlib/rest-force-jit.fk form-stdlib/form-cli-rest-force.bml
; witnessed: 2026-08-30 -> 31 on fkwu

(do
    (defn rfbb-bit (ok bit) (if ok bit 0))
    (defn rfbb-has? (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let exec-text (read_file "form/form-stdlib/form-cli-rest-force.bml"))
    (let law-text (read_file "form/form-stdlib/bml/form-cli-restanswer.bml"))
    (sum (list
        (rfbb-bit (eq (rfb-check) 255) 1)
        (rfbb-bit (eq (rfb-agree) 15) 2)
        (rfbb-bit (and (str_eq (RestForceAuthorityPath)
                           "form/form-stdlib/bml/form-cli-restanswer.bml")
                       (str_eq (RestForceAuthorityKind)
                           "high-bml-class-template-field")) 4)
        (rfbb-bit (and (eq (rfbb-has? exec-text "section [form.bml]") 1)
                       (eq (rfbb-has? exec-text "def rfb-force") 1)) 8)
        (rfbb-bit (and (eq (rfbb-has? law-text "package Form.cli.restanswer") 1)
                       (eq (rfbb-has? law-text "class FormRestAnswer") 1)) 16))))
