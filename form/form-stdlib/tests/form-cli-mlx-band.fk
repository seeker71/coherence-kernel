; form-cli-mlx-band.fk — MLX linked, GPU present, BML 2+3 is 5.
;
; Verdict 63:
;   1    mlx_linked=true
;   2    mlx_metal_available=true
;   4    mlx_add 2 3 is 5
;   8    that 5 is the BML birth
;   16   mlx_dispatch=1 after the add
;   32   mlx_version is spoken
;
; fkwu-only organ (same seat as Metal). Weak stubs answer linked=false
; when the carrier is not linked.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-allowance-birth.bml
; witnessed: 2026-08-20 -> 63

(do
    (let before (mlx_status))
    (let sum (mlx_add (alb-lhs) (alb-rhs)))
    (let after (mlx_status))
    (add (if (ge (str_find before "mlx_linked=true" 0) 0) 1 0)
    (add (if (ge (str_find before "mlx_metal_available=true" 0) 0) 2 0)
    (add (if (eq sum 5) 4 0)
    (add (if (eq sum (alb-bml)) 8 0)
    (add (if (ge (str_find after "mlx_dispatch=1" 0) 0) 16 0)
         (if (ge (str_find before "mlx_version=" 0) 0) 32 0))))))
)
