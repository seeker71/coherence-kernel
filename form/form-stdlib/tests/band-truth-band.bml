; band-truth-band.bml — the band-truth audit reads a head against its claims: one planted band of each flaw class,
; a clean one, the formats it can and cannot read, prose shaped like rows, the second copies and the ledger, the
; door's exit, and this band's own head.
;
; Verdict 1048575 when every claim lands:
;   1      a clean band (a table of 1, 2, 4 under pin 7, a wrapped row) reads head-table and flags nothing
;   2      head-unmet: pin 15 over rows 1, 2, 4 is flagged and names pin bit 8, the claim no row carries
;   4      claims-over: pin 3 over rows 1, 2, 4 is flagged and names the weight 4 the pin lacks
;   8      bad-bits: rows 1, 3, 4 (not powers of two) and rows 1, 2, 2 (a weight repeats) are each flagged
;   16     head-too-big: a pin of 18014398509481983 (2^54-1) is flagged
;   32     unreadable is named, never fine: a pin over prose only, a non-mask pin over prose, and a band with no pin
;   64     a code list of 1, 2, 4 under pin 3 is flagged claims-over, and a head table that disagrees with it list-drift
;   128    the inline list (`= 1 a | 2 b` carried on by a `|` line, and `= 1+2+4`) reads head-inline and flags nothing
;   256    copy-drift in the queue: a row whose full is 3 over a band that pins 7 is flagged, one that agrees is not,
;          a row with no band is named unreadable, and a row whose band is absent is flagged
;   512    copy-drift in the manifest: a registered verdict that differs from the head pin is flagged, an orphan row
;          is flagged, an agreeing row and a comment line are not, and a band with no pin is held to the sum of
;          its code list (read from the file; an absent file reads nothing)
;   1024   a decimal fold and a count of ones are flagged bad-bits and the line names the remedy, a row numbered by
;          digit position under a repunit pin reads as a decimal fold, and `; FOLD: decimal` / `; FOLD: count`
;          silences only that kind
;   2048   layouts: `1..4`, a compact row (`1 a   2 b   4 c`), a bit named only by a range in prose, and a
;          right-aligned table all read clean
;   4096   the head ends at its first code line, and the first Verdict in it is the pin (a later one is not)
;   8192   the door over planted bands: a flagged tree prints its flaw line and the summary and exits 1, a clean one
;          prints flaws=0 and exits 0
;   16384  the door over the real tree reads every band validate.sh sweeps (200 or more), prints its summary line,
;          and exits 0 exactly when that line reads flaws=0
;   32768  this band's own head and its claim list agree: the audit reads it code-list, 20 claims, no flaw
;   65536  the ledger: planted rows feed the history path. A row whose band_before or band_after is above its full
;          is a `seen` row, one equal to it or below it is not, a row with no gap or no full is skipped, and the
;          rows of one gap group into one `seen` line with rows=<n> and the highest read
;   131072 a sweep that lists no band is a flaw: a child door given an empty list prints flaw empty-sweep and
;          bands=0 flaws=1 and exits 1, never 0
;   262144 prose shaped like rows: a second numbered list that restarts at 1 (adjacent, or under a heading) and
;          a year line are no claims; a pin bit that only a row-shaped line outside the table names makes the
;          band unreadable (off-table), never counted fine
;   524288 a half-written row: a queue row whose band or id never closed is named unreadable half-written (the id
;          when it closed, `?` when it did not), and a ledger row whose gap never closed is skipped
;
; REQUIRES: ./fkwu children -- claims 8192, 16384 and 131072 spawn them (host_spawn_at) and read
; their exit and stdout.
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/bml/live.bml form-stdlib/bml/band-truth.bml
section [form.bml] {
 class BandTruthBand {
  def btb-join(xs, sep) = nil?(xs) ? "" : nil?(xs[1:]) ? xs[0] : xs[0] ++ sep ++ btb-join(xs[1:], sep);
  // a planted band: head lines, then a code line that ends the head
  def btb-src(head) = btb-join(head, "\n") ++ "\n\n(do 0)\n";
  def btb-audit(head) = bt-audit("planted/x-band.fk", btb-src(head));
  def btb-fmt(head) = btb-audit(head)[0];
  def btb-lines(head) = btb-audit(head)[1];
  def btb-has(s, part) = str_find(s, part, 0) >= 0;
  def btb-any(lines, part) = nil?(lines) ? false : btb-has(lines[0], part) || btb-any(lines[1:], part);
  def btb-flaws(lines) = len(filter(l => bt-starts?(l, "flaw "), lines));
  def btb-one(lines, cls, part) = btb-flaws(lines) == 1 && btb-any(lines, "flaw " ++ cls ++ " ") && btb-any(lines, part);

  def btb-clean() = [";", "; Verdict 7 when every claim lands:", ";   1     first claim", ";   2     second claim,", ";           wrapped under it", ";   4     third claim"];

  def btb-c-clean(ctx) = btb-fmt(btb-clean()) == "head-table" && nil?(btb-lines(btb-clean()));
  def btb-c-unmet(ctx) = btb-one(btb-lines(["; Verdict 15 when all land:", ";   1   a", ";   2   b", ";   4   c"]), "head-unmet", "pin bit(s) 8");
  def btb-c-over(ctx) = btb-one(btb-lines(["; Verdict 3 when all land:", ";   1   a", ";   2   b", ";   4   c"]), "claims-over", "claims weigh 4");
  def btb-c-bits(ctx) {
   let mixed = btb-lines(["; Verdict 8 when all land:", ";   1   a", ";   3   b", ";   4   c"]);
   let dup = btb-lines(["; Verdict 5 when all land:", ";   1   a", ";   2   b", ";   2   c"]);
   btb-flaws(mixed) == 1 && btb-any(mixed, "flaw bad-bits ") && btb-any(mixed, "not distinct powers of two")
   && btb-flaws(dup) == 1 && btb-any(dup, "flaw bad-bits ") && btb-any(dup, "a weight repeats");
  }
  def btb-c-big(ctx) {
   let lines = btb-lines(["; Verdict 18014398509481983"]);
   btb-flaws(lines) == 1 && btb-any(lines, "flaw head-too-big ") && btb-any(lines, "2^53");
  }
  def btb-c-unreadable(ctx) {
   let mask = btb-audit(["; Verdict 255 when every claim lands, said in prose only."]);
   let odd = btb-audit(["; Verdict 26 is a count the body does not list."]);
   let none = btb-audit(["; no pin here"]);
   (String) mask[0] == "mask-only" && btb-flaws(mask[1]) == 0 && btb-any(mask[1], "unreadable planted/x-band.fk reason=mask-only pin=255")
   && (String) odd[0] == "no-table" && btb-flaws(odd[1]) == 0 && btb-any(odd[1], "reason=no-table pin=26")
   && (String) none[0] == "unpinned" && btb-flaws(none[1]) == 0 && btb-any(none[1], "reason=no-pin");
  }
  // the call is spelled in two pieces so this band's own source holds exactly one
  def btb-call() = "live-" ++ "claims";
  def btb-code(bits) = "(do " ++ btb-call() ++ "(\"p\", 0, [" ++ btb-join(map(b => "[\"c" ++ b.str() ++ "\", " ++ b.str() ++ ", 1, f]", bits), ", ") ++ "]))";
  def btb-c-code(ctx) {
   let src = btb-join([";", "; Verdict 3 when all land:", ";   1   a", ";   2   b", "", btb-code([1, 2, 4])], "\n") ++ "\n";
   let got = bt-audit("planted/x-band.fk", src);
   (String) got[0] == "code-list" && btb-flaws(got[1]) == 2 && btb-any(got[1], "flaw claims-over ") && btb-any(got[1], "flaw list-drift ");
  }
  def btb-c-inline(ctx) {
   let barred = [";", "; Verdict 7 = 1 runs | 2 refuses", ";   | 4 collections; the rest is prose."];
   let summed = ["; Verdict 7 = 1+2+4, power-of-two weights so a reader can subtract."];
   (String) btb-fmt(barred) == "head-inline" && nil?(btb-lines(barred)) && (String) btb-fmt(summed) == "head-inline" && nil?(btb-lines(summed));
  }
  def btb-pins(table) = (path) => nil?(filter(row => (String) row[0] == path, table)) ? nothing() : bt-pin-of(filter(row => (String) row[0] == path, table)[0][1]);
  def btb-c-queue(ctx) {
   let table = [["b/stale-band.fk", btb-src(["; Verdict 7 when all land:", ";   1   a", ";   2   b", ";   4   c"])]];
   let stale = bt-queue(["{\"full\":3,\"id\":\"stale\",\"band\":\"b/stale-band.fk\"}"], btb-pins(table));
   let fresh = bt-queue(["{\"full\":7,\"id\":\"fresh\",\"band\":\"b/stale-band.fk\"}"], btb-pins(table));
   let unlinked = bt-queue(["{\"full\":7,\"id\":\"loose\"}"], btb-pins(table));
   let gone = bt-queue(["{\"full\":7,\"id\":\"gone\",\"band\":\"b/missing-band.fk\"}"], btb-pins(table));
   btb-one(stale, "copy-drift", "holds full 3 and the band's head pins 7") && nil?(fresh)
   && btb-flaws(unlinked) == 0 && btb-any(unlinked, "unreadable queue-row:loose reason=no-band")
   && btb-one(gone, "copy-drift", "which is absent");
  }
  def btb-c-manifest(ctx) {
   let table = [["form/form-stdlib/tests/stem-band.fk", btb-src(["; Verdict 7 when all land:", ";   1   a", ";   2   b", ";   4   c"])]];
   let reads = btb-pins(table);
   let listed = btb-root(ctx) ++ "/listed-band.fk";
   write_file(listed, btb-code([1, 2, 4]) ++ "\n");
   bt-code-sum-of(listed) == 7 && nothing?(bt-code-sum-of(btb-root(ctx) ++ "/none-band.fk"))
   && btb-one(bt-manifest(["stem fks 3"], reads), "copy-drift", "registers 3 and the head of form/form-stdlib/tests/stem-band.fk pins 7")
   && nil?(bt-manifest(["stem fks 7", "# a comment line", ""], reads))
   && btb-one(bt-manifest(["ghost fks 3"], reads), "copy-drift", "stands at none of its four spellings");
  }
  def btb-c-folds(ctx) {
   let positions = [";", "; Verdict 111 when all land:", ";   1   a", ";   2   b", ";   3   c"];
   let tens = [";", "; Verdict 111 when all land:", ";   1     a", ";   10    b", ";   100   c"];
   let ones = [";", "; Verdict 3 when all land:", ";   1   a", ";   1   b", ";   1   c"];
   btb-one(btb-lines(positions), "bad-bits", "numbered by decimal-digit position")
   && btb-one(btb-lines(tens), "bad-bits", "decimal weights")
   && btb-one(btb-lines(ones), "bad-bits", "every claim weighs 1")
   && btb-any(btb-lines(tens), "`; FOLD: decimal` in the head") && btb-any(btb-lines(ones), "`; FOLD: count` in the head")
   && nil?(btb-lines(cons("; FOLD: decimal", tens))) && nil?(btb-lines(cons("; FOLD: count", ones)))
   && btb-one(btb-lines(cons("; FOLD: count", tens)), "bad-bits", "decimal weights");
  }
  def btb-c-layouts(ctx) {
   let ranged = [";", "; Verdict 15 when all land:", ";   1..8   four claims, each a bit"];
   let compact = [";", "; Verdict 7 when all land:", ";   1 a   2 b   4 c"];
   let named = [";", "; Verdict 7 when all land:", ";   1   a", ";   2   b", ";   claim 4 is stated in a sentence 4 .. 4 only"];
   let right = [";", "; Verdict 1023 when all land:", ";      1  a", ";      2  b,", ";           8 children are spawned, so this wrapped line opens on a number", ";      4  c", ";     16  d", ";      8  e", ";     32  f", ";     64  g", ";    128  h", ";    256  i", ";    512  j"];
   nil?(btb-lines(ranged)) && (String) btb-fmt(ranged) == "head-table" && nil?(btb-lines(compact)) && nil?(btb-lines(named)) && nil?(btb-lines(right));
  }
  def btb-c-head(ctx) {
   let later = bt-audit("planted/x-band.fk", "; Verdict 7\n;   1 a\n;   2 b\n;   4 c\n(do 1)\n; Verdict 99 later, after the code\n");
   let first = bt-audit("planted/x-band.fk", "; the prose says Verdict 7 first\n; Verdict 15 later\n;   1 a\n;   2 b\n;   4 c\n\n(do 1)\n");
   nil?(later[1]) && (String) later[0] == "head-table" && nil?(first[1]) && (String) first[0] == "head-table";
  }

  // ---- the ledger: rows are `{"gap":..,"band_before":..,"band_after":..,"full":..}` as the native turn writes them
  def btb-row(gap, before, after, full) = "{\"gap\":\"" ++ gap ++ "\",\"band_before\":" ++ before.str() ++ ",\"band_after\":" ++ after.str() ++ ",\"full\":" ++ full.str() ++ "}";
  def btb-c-ledger(ctx) {
   let rows = bt-above-rows([btb-row("g-up", 2, 9, 5), btb-row("g-eq", 5, 5, 5), btb-row("g-low", 1, 2, 5), "{\"band_before\":7,\"full\":3}", "{\"gap\":\"g-nofull\",\"band_before\":7}", btb-row("g-up", 7, 3, 5), btb-row("g-two", 6, 6, 3)]);
   let seen = bt-seen(rows);
   len(rows) == 3
   && len(seen) == 2
   && (String) seen[0] == "seen read-above-full g-up rows=2 full=5 read=9 (receipts/native-turn-ledger.jsonl: a turn read this gap's band above the full its queue row held)"
   && bt-starts?(seen[1], "seen read-above-full g-two rows=1 full=3 read=6 ")
   && nil?(bt-seen(bt-above-rows([btb-row("g-eq", 5, 5, 5), btb-row("g-low", 1, 2, 5)])));
  }
  def btb-c-empty(ctx) {
   let r = btb-child(btb-root(ctx), "empty", []);
   r[0] == 1 && btb-has(r[1], "flaw empty-sweep - pin=? max=? ") && btb-last(r[1]) == "band-truth bands=0 readable=0 unreadable=0 absent=0 seen=0 flaws=1"
   && btb-has(r[2], "band-truth: 1 flaw(s) flagged");
  }
  def btb-c-prose(ctx) {
   let claims = ["; Verdict 7 when all land:", ";   1   a", ";   2   b", ";   4   c"];
   let adjacent = append(claims, [";   1   added x", ";   2   added y"]);
   let headed = append(claims, [";", "; Changes in this version:", ";   1   added x", ";   2   added y"]);
   let year = [";", "; Verdict 3 when all land:", ";   1   a", ";   2   b", ";   2026 was the year"];
   let off = btb-audit(["; Verdict 15 when all land:", ";   1   a", ";   2   b", ";   4   c", "; some prose", ";   8 times each ran"]);
   nil?(btb-lines(adjacent)) && (String) btb-fmt(adjacent) == "head-table"
   && nil?(btb-lines(headed)) && (String) btb-fmt(headed) == "head-table"
   && nil?(btb-lines(year)) && (String) btb-fmt(year) == "head-table"
   && (String) off[0] == "off-table" && btb-flaws(off[1]) == 0 && btb-any(off[1], "unreadable planted/x-band.fk reason=off-table pin=15 bits=8");
  }
  def btb-c-halfwritten(ctx) {
   let table = [["b/stale-band.fk", btb-src(["; Verdict 7 when all land:", ";   1   a", ";   2   b", ";   4   c"])]];
   let cut_band = bt-queue(["{\"full\":3,\"id\":\"x\",\"band\":\"b/stale-ba"], btb-pins(table));
   let cut_id = bt-queue(["{\"full\":3,\"band\":\"b/stale-band.fk\",\"id\":\"ab"], btb-pins(table));
   btb-flaws(cut_band) == 0 && btb-any(cut_band, "unreadable queue-row:x reason=half-written")
   && btb-flaws(cut_id) == 0 && btb-any(cut_id, "unreadable queue-row:? reason=half-written")
   && nil?(bt-above-rows(["{\"full\":3,\"band_before\":7,\"gap\":\"abc"]));
  }

  // ---- the door, in a child fkwu
  def btb-fresh() {
   let root = temp_dir() ++ "/band-truth-band-" ++ now_unix_ms().str();
   (Comparable) host_dir_mkdir(root) == 1 ? ["door", root] : nothing();
  }
  def btb-root(ctx) = ctx[1];
  // the child's streams are written under `base`, which is always inside the band's temp directory
  def btb-run(path, base) {
   let pid = host_spawn_at(["./fkwu", path], ["/dev/null", base ++ ".stdout", base ++ ".stderr"]);
   let status = pid <= 0 ? -1 : host_wait(pid);
   [status, read_file(base ++ ".stdout") ?? "", read_file(base ++ ".stderr") ?? ""];
  }
  // the summary line: the last line of the door's stdout that opens `band-truth bands=` (a clean run then
  // prints its answer, 0, as fkwu prints every program's value)
  def btb-last(text) {
   let lines = filter(l => bt-starts?(l, "band-truth bands="), split-on(text, "\n"));
   nil?(lines) ? "" : reverse(lines)[0];
  }
  def btb-after(s, key) {
   let k = str_find(s, key, 0);
   k < 0 ? nothing() : str_to_int(substring(s, k + len(key), bt-digits-end(s, k + len(key))));
  }
  def btb-child(root, name, paths) {
   let path = root ++ "/" ++ name ++ ".bml";
   let quoted = btb-join(map(p => "\"" ++ p ++ "\"", paths), ", ");
   write_file(path, "// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/bml/band-truth.bml\nsection [form.bml] {\n class Child {\n  def child() = bt-finish(bt-report([" ++ quoted ++ "], []));\n }\n child();\n}\n");
   btb-run(path, path);
  }
  def btb-c-door(ctx) {
   let root = btb-root(ctx);
   let good = root ++ "/good-band.fk";
   let bad = root ++ "/bad-band.fk";
   write_file(good, btb-src(btb-clean()));
   write_file(bad, btb-src(["; Verdict 15 when all land:", ";   1   a", ";   2   b", ";   4   c"]));
   let flagged = btb-child(root, "flagged", [good, bad]);
   let clean = btb-child(root, "clean", [good]);
   flagged[0] == 1 && btb-has(flagged[1], "flaw head-unmet " ++ bad ++ " pin=15 max=7")
   && btb-last(flagged[1]) == "band-truth bands=2 readable=2 unreadable=0 absent=0 seen=0 flaws=1"
   && btb-has(flagged[2], "band-truth: 1 flaw(s) flagged")
   && clean[0] == 0 && btb-last(clean[1]) == "band-truth bands=1 readable=1 unreadable=0 absent=0 seen=0 flaws=0";
  }
  def btb-c-tree(ctx) {
   let r = btb-run("observe/band-truth-run.bml", btb-root(ctx) ++ "/tree");
   let last = btb-last(r[1]);
   let flaws = btb-after(last, "flaws=");
   let bands = btb-after(last, "bands=");
   !nothing?(flaws) && !nothing?(bands) && bt-starts?(last, "band-truth bands=") && bands >= 200 && (r[0] == 0) == (flaws == 0) && (r[0] == 0 || r[0] == 1);
  }
  def btb-c-self(ctx) {
   let path = "form/form-stdlib/tests/band-truth-band.bml";
   let got = bt-audit(path, read_file(path) ?? "");
   (String) got[0] == "code-list" && nil?(got[1]);
  }
 }
 let ctx = btb-fresh();
 nothing?(ctx) ? form_error("band-truth band needs a fresh directory") : 0;
 let verdict = live-claims("band-truth-band", ctx, [["clean", 1, 1, btb-c-clean], ["head-unmet", 2, 1, btb-c-unmet], ["claims-over", 4, 1, btb-c-over], ["bad-bits", 8, 1, btb-c-bits], ["head-too-big", 16, 1, btb-c-big], ["unreadable", 32, 1, btb-c-unreadable], ["code-list", 64, 1, btb-c-code], ["inline", 128, 1, btb-c-inline], ["queue", 256, 1, btb-c-queue], ["manifest", 512, 1, btb-c-manifest], ["folds", 1024, 1, btb-c-folds], ["layouts", 2048, 1, btb-c-layouts], ["head", 4096, 1, btb-c-head], ["door", 8192, 1, btb-c-door], ["tree", 16384, 1, btb-c-tree], ["self", 32768, 1, btb-c-self], ["ledger", 65536, 1, btb-c-ledger], ["empty", 131072, 1, btb-c-empty], ["prose", 262144, 1, btb-c-prose], ["halfwritten", 524288, 1, btb-c-halfwritten]]);
 host_dir_rmdir(btb-root(ctx));
 verdict;
}
