; living-world-continuity-durable-witness.fk -- small settled world fixture.
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk

(let LWCDW-SOURCE     (bp "LWCDW-SOURCE"))
(let LWCDW-PAYLOAD    (bp "LWCDW-PAYLOAD"))
(let LWCDW-PROVENANCE (bp "LWCDW-PROVENANCE"))
(let LWCDW-EVIDENCE   (bp "LWCDW-EVIDENCE"))
(let LWCDW-ALTERNATIVE (bp "LWCDW-ALTERNATIVE"))
(let LWCDW-UNKNOWN     (bp "LWCDW-UNKNOWN"))

(defn lwcdw-source () (intern_node LWCDW-SOURCE (empty)))
(defn lwcdw-payload ()
    (intern_node LWCDW-PAYLOAD
        (list (intern_trivial_string "settled tissue; names are optional"))))
(defn lwcdw-provenance () (intern_node LWCDW-PROVENANCE (empty)))
(defn lwcdw-evidence () (intern_node LWCDW-EVIDENCE (empty)))
(defn lwcdw-alternative () (intern_node LWCDW-ALTERNATIVE (empty)))
(defn lwcdw-unknown () (intern_node LWCDW-UNKNOWN (empty)))

(defn lwcdw-world ()
    (do
        (let payload (lwcdw-payload))
        (let attribution
            (lwo-attribution payload (lwcdw-source) (lwcdw-provenance)))
        (lwo-world
            (lwo-field (list payload))
            (lwo-empty-field)
            (lwo-field (list attribution))
            (lwo-empty-field)
            (lwo-empty-field))))

(defn lwcdw-image () (lwcn-image (lwcdw-world)))
(defn lwcdw-path () "/tmp/coherence-living-world-continuity-v1.ccs")

(defn lwcdw-clean ()
    (do
        (if (eq (fs-exists? (lwcdw-path)) 1)
            (fs-remove-file (lwcdw-path)) 0)
        (if (eq (fs-exists? (lwcd-pending-path (lwcdw-path))) 1)
            (fs-remove-file (lwcd-pending-path (lwcdw-path))) 0)))

(defn lwcdw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwcdw-sum (tail items)))))
