; form-program-image-symbolic-linker-band.fk -- labels, not caller offsets.
;
; preludes: form-stdlib/core.fk form-stdlib/program-image-fkb.fk form-stdlib/form-program-image-symbolic-linker.fk

(do
    (defn fpisb-base-nodes ()
        (list
            (fpis-node-def "return" 4 (fpis-string-ref "payload") (fpis-imm 0) (fpis-imm 0))
            (fpis-node-def "call" 12 (fpis-function-ref "emit") (fpis-node-ref "return") (fpis-imm 0))))
    (defn fpisb-base-ir ()
        (fpis-ir
            (list (fpis-function-def "emit" "call"))
            (fpisb-base-nodes)
            (list (fpis-string-def "payload" (list 65 66 67)))))
    (defn fpisb-link-with-nodes (nodes)
        (fpis-link (fpis-ir
            (list (fpis-function-def "emit" "call")) nodes
            (list (fpis-string-def "payload" (list 65 66 67))))))
    (defn fpisb-refusal-no-table? (result reason)
        (and (not (fpis-linked? result))
             (and (str_eq (fpis-reason result) reason)
                  (nothing? (fpis-table result)))))
    (defn fpisb-sum (values)
        (if (nil? values) 0 (add (head values) (fpisb-sum (tail values)))))

    (defn form-program-image-symbolic-linker-band ()
        (do
            (let linked (fpis-link (fpisb-base-ir)))
            (let table (fpis-table linked))
            (let rows (pif-table-node-rows table))
            (let same (fpis-link (fpisb-base-ir)))
            (let changed (fpis-link
                (fpis-ir
                    (list (fpis-function-def "emit" "call"))
                    (fpisb-base-nodes)
                    (list (fpis-string-def "payload" (list 65 66 68))))))
            (let duplicate-node (fpisb-link-with-nodes
                (append (fpisb-base-nodes)
                        (list (fpis-node-def "return" 1 (fpis-imm 0) (fpis-imm 0) (fpis-imm 0))))))
            (let duplicate-string (fpis-link
                (fpis-ir (list) (list)
                    (list (fpis-string-def "s" (list 1)) (fpis-string-def "s" (list 2))))))
            (let duplicate-function (fpis-link
                (fpis-ir
                    (list (fpis-function-def "f" "return") (fpis-function-def "f" "call"))
                    (fpisb-base-nodes) (list))))
            (let unresolved-node (fpisb-link-with-nodes
                (list (fpis-node-def "call" 12 (fpis-node-ref "absent") (fpis-imm 0) (fpis-imm 0)))))
            (let unresolved-string (fpisb-link-with-nodes
                (list (fpis-node-def "call" 4 (fpis-string-ref "absent") (fpis-imm 0) (fpis-imm 0)))))
            (let unresolved-function (fpisb-link-with-nodes
                (list (fpis-node-def "call" 12 (fpis-function-ref "absent") (fpis-imm 0) (fpis-imm 0)))))
            (let unresolved-root (fpis-link
                (fpis-ir (list (fpis-function-def "emit" "absent")) (fpisb-base-nodes) (list))))
            (let unsupported-ref (fpisb-link-with-nodes
                (list (fpis-node-def "call" 12 (list "seat" 9) (fpis-imm 0) (fpis-imm 0)))))
            (let bad-bytes (fpis-link
                (fpis-ir (list) (list) (list (fpis-string-def "bad" (list 256))))))
            (let variable-shape (fpis-link
                (fpis-ir
                    (list (fpis-function-def "decide" "choice")
                          (fpis-function-def "allow" "one"))
                    (list
                        (fpis-node-def "zero" 1 (fpis-imm 0) (fpis-imm 0) (fpis-imm 0))
                        (fpis-node-def "one" 1 (fpis-imm 1) (fpis-imm 0) (fpis-imm 0))
                        (fpis-node-def "choice" 6 (fpis-node-ref "one") (fpis-node-ref "zero") (fpis-string-ref "allow")))
                    (list (fpis-string-def "allow" (list 97 108 108 111 119))))))
            (let vr (pif-table-node-rows (fpis-table variable-shape)))
            (fpisb-sum (list
                (if (and (fpis-linked? linked) (pif-table-valid? table)) 1 0)
                (if (and (eq (pif-table-nf table) 1) (eq (head (pif-table-fn-roots table)) 1)) 2 0)
                (if (and (eq (nth (head rows) 1) 0) (eq (nth (nth rows 1) 1) 0)) 4 0)
                (if (and (eq (nth (nth rows 1) 2) 0) (eq (pif-table-ns table) 1)) 8 0)
                (if (and (fpis-linked? same)
                         (value_eq (pif-table-numeric-stream table)
                                   (pif-table-numeric-stream (fpis-table same)))) 16 0)
                (if (and (fpis-linked? changed)
                         (not (value_eq (pif-table-numeric-stream table)
                                        (pif-table-numeric-stream (fpis-table changed))))) 32 0)
                (if (fpisb-refusal-no-table? duplicate-node "duplicate-node-label") 64 0)
                (if (fpisb-refusal-no-table? duplicate-string "duplicate-string-label") 128 0)
                (if (fpisb-refusal-no-table? duplicate-function "duplicate-function-label") 256 0)
                (if (fpisb-refusal-no-table? unresolved-node "unresolved-node") 512 0)
                (if (fpisb-refusal-no-table? unresolved-string "unresolved-string") 1024 0)
                (if (fpisb-refusal-no-table? unresolved-function "unresolved-function") 2048 0)
                (if (fpisb-refusal-no-table? unresolved-root "unresolved-function-root") 4096 0)
                (if (fpisb-refusal-no-table? unsupported-ref "unsupported-reference-kind") 8192 0)
                (if (fpisb-refusal-no-table? bad-bytes "invalid-pif-table") 16384 0)
                (if (and (fpis-linked? variable-shape)
                         (and (eq (pif-table-nf (fpis-table variable-shape)) 2)
                              (and (eq (pif-table-nr (fpis-table variable-shape)) 3)
                                   (and (eq (nth (nth vr 2) 1) 1)
                                        (and (eq (nth (nth vr 2) 2) 0)
                                             (eq (nth (nth vr 2) 3) 0)))))) 32768 0))))
)
)

(form-program-image-symbolic-linker-band)
; expect 65535
