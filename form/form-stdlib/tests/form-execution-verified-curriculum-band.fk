; form-execution-verified-curriculum-band.fk -- adversarial witness that
; varied coldjudge failures survive as revision context while every assistant
; source is an independently re-executed green endpoint.
;
; Expected: 1048575 (20 bits)
;
; preludes: form-stdlib/form-execution-verified-curriculum.fk

(do
    (defn evfcb-bit (ok bit) (if ok bit 0))
    (defn evfcb-clean-observation (c signal diagnostic provenance)
        (evfc-observation (evfc-candidate-id c) "clean" signal
            (fef-eval (evfc-c-source c))
            (evfc-execution 0 0 diagnostic)
            (evfc-evidence "form-eval-full+preflight-v1" provenance)))
    (defn evfcb-refusal-observation
        (c preflight signal value execution provenance)
        (evfc-observation (evfc-candidate-id c) preflight signal value
            execution (evfc-evidence "bounded-coldjudge-v1" provenance)))
    (defn evfcb-c (family source expected step)
        (evfc-candidate family
            "Produce a small Form source whose observed result is integer 1."
            source expected
            (str_concat "form-source-adapter-d/" step)))

    (defn evfcb-main-candidates ()
        (append
            (list
                (evfcb-c "river" "(do (add 1 2)" 1 "proposal")
                (evfcb-c "river" "(do 2)" 1 "semantic-revision")
                (evfcb-c "river"
                    "(do (defn amber-spin (n) (amber-spin n)) (amber-spin 1))"
                    1 "bounded-revision"))
            (append
                (list
                    (evfcb-c "river" "(do nothing)" 1 "nothing-revision")
                    (evfcb-c "river" "(do (div 1 0))" 1 "failure-revision")
                    (evfcb-c "river" "(do 0)" 1 "choice-revision"))
                (list
                    (evfcb-c "river" "(do 4)" 1 "cut-revision")
                    (evfcb-c "river" "(do 3)" 1 "undo-revision")
                    (evfcb-c "river" "(do 1)" 1 "green-endpoint")))))

    (defn evfcb-main-steps-a (cs)
        (list
            (evfc-step (nth cs 0) (evfcb-refusal-observation
                (nth cs 0) "diagnostic" "failure" (nothing)
                (evfc-execution 1 2
                    "[input-ended-mid-form] source ended before close")
                "coldjudge/river/0"))
            (evfc-step (nth cs 1) (evfcb-clean-observation
                (nth cs 1) "return" "returned integer 2; expected integer 1"
                "coldjudge/river/1"))
            (evfc-step (nth cs 2) (evfcb-refusal-observation
                (nth cs 2) "clean" "timeout" (nothing)
                (evfc-execution 0 124 "bounded execution reached timeout")
                "coldjudge/river/2"))))

    (defn evfcb-main-steps-b (cs)
        (list
            (evfc-step (nth cs 3) (evfcb-refusal-observation
                (nth cs 3) "clean" "nothing" (nothing)
                (evfc-execution 0 0 "execution returned no result signal")
                "coldjudge/river/3"))
            (evfc-step (nth cs 4) (evfcb-refusal-observation
                (nth cs 4) "clean" "failure" (nothing)
                (evfc-execution 0 2 "runtime failure was retained")
                "coldjudge/river/4"))
            (evfc-step (nth cs 5) (evfcb-clean-observation
                (nth cs 5) "choice"
                "choice retained integer 0; expected integer 1"
                "coldjudge/river/5"))))

    (defn evfcb-main-steps-c (cs)
        (list
            (evfc-step (nth cs 6) (evfcb-clean-observation
                (nth cs 6) "cut" "cut retained integer 4; expected integer 1"
                "coldjudge/river/6"))
            (evfc-step (nth cs 7) (evfcb-clean-observation
                (nth cs 7) "undo" "undo restored integer 3; expected integer 1"
                "coldjudge/river/7"))
            (evfc-step (nth cs 8) (evfcb-clean-observation
                (nth cs 8) "undo" "undo endpoint returned expected integer 1"
                "coldjudge/river/8"))))

    (defn evfcb-main-trajectory ()
        (do
            (let cs (evfcb-main-candidates))
            (let steps (append (evfcb-main-steps-a cs)
                (append (evfcb-main-steps-b cs) (evfcb-main-steps-c cs))))
            (evfc-trajectory "river" steps
                "form-source-adapter-d/river/trajectory-v1")))

    (defn evfcb-endpoint (family source expected name)
        (do
            (let c (evfc-candidate family
                (str_concat "Return the exact Form value "
                    (str_concat name "."))
                source expected
                (str_concat "form-source-adapter-d/endpoint/" name)))
            (evfc-trajectory family
                (list (evfc-step c (evfcb-clean-observation c "return"
                    (str_concat "returned exact " name)
                    (str_concat "coldjudge/endpoint/" name))))
                (str_concat "form-source-adapter-d/trajectory/" name))))

    (defn evfcb-trajectories ()
        (list
            (evfcb-main-trajectory)
            (evfcb-endpoint "birch" "(do nothing)" (nothing) "nothing")
            (evfcb-endpoint "cedar" "(do 0)" 0 "integer-zero")
            (evfcb-endpoint "dune" "(do 1)" 1 "integer-one")))

    (defn evfcb-has-kind? (rows kind)
        (if (nil? rows) 0
            (if (str_eq (evfc-r-kind (head rows)) kind) 1
                (evfcb-has-kind? (tail rows) kind))))
    (defn evfcb-all-answers-green? (rows trajectories)
        ; The fixture has one green endpoint per family.  Answer equality to
        ; that endpoint proves failed candidates stayed input-side.
        (if (nil? rows) 1
            (if (str_eq (evfc-r-family (head rows)) "river")
                (if (str_eq (evfc-r-answer (head rows)) "(do 1)")
                    (evfcb-all-answers-green? (tail rows) trajectories) 0)
                (if (or (str_eq (evfc-r-answer (head rows)) "(do nothing)")
                        (or (str_eq (evfc-r-answer (head rows)) "(do 0)")
                            (str_eq (evfc-r-answer (head rows)) "(do 1)")))
                    (evfcb-all-answers-green? (tail rows) trajectories) 0))))
    (defn evfcb-text-has-denial? (text denials)
        (if (nil? denials) 0
            (if (ge (str_find text (head denials) 0) 0) 1
                (evfcb-text-has-denial? text (tail denials)))))

    (defn evfcb-plateau ()
        (do
            (let a (evfcb-c "grove" "(do 2)" 1 "plateau-a"))
            (let b (evfcb-c "grove" "(do 3)" 1 "plateau-b"))
            (let c (evfcb-c "grove" "(do 4)" 1 "plateau-c"))
            (let g (evfcb-c "grove" "(do 1)" 1 "plateau-green"))
            (evfc-trajectory "grove" (list
                (evfc-step a (evfcb-clean-observation a "return" "miss-a"
                    "coldjudge/plateau/a"))
                (evfc-step b (evfcb-clean-observation b "return" "miss-b"
                    "coldjudge/plateau/b"))
                (evfc-step c (evfcb-clean-observation c "return" "miss-c"
                    "coldjudge/plateau/c"))
                (evfc-step g (evfcb-clean-observation g "return" "green"
                    "coldjudge/plateau/green")))
                "form-source-adapter-d/plateau")))

    (defn evfcb-same-source-fake-revision ()
        (do
            (let a (evfcb-c "harbor" "(do 0)" 1 "same-a"))
            (let b (evfcb-c "harbor" "(do 0)" 1 "same-b"))
            (let g (evfcb-c "harbor" "(do 1)" 1 "same-green"))
            (evfc-trajectory "harbor" (list
                (evfc-step a (evfcb-clean-observation a "return" "miss"
                    "coldjudge/same/a"))
                (evfc-step b (evfcb-clean-observation b "return" "still"
                    "coldjudge/same/b"))
                (evfc-step g (evfcb-clean-observation g "return" "green"
                    "coldjudge/same/g")))
                "form-source-adapter-d/same-source")))

    (defn evfcb-run ()
        (do
            (let ts (evfcb-trajectories))
            (let rows (evfc-build ts))
            (let train (evfc-jsonl ts "train"))
            (let valid (evfc-jsonl ts "valid"))
            (let main (evfcb-main-trajectory))
            (let main-steps (evfc-t-steps main))
            (let mismatch-step (nth main-steps 1))
            (let mismatch-c (evfc-step-candidate mismatch-step))
            (let mismatch-o (evfc-step-observation mismatch-step))
            (let leak-c (evfc-candidate "leak" (fked-challenge-id)
                "(do 1)" 1 "form-source-adapter-d/leak"))
            (let leak-e (evfc-candidate "leak" "denied artifact"
                "(do 1)" 1 (fkceo-expected-sha)))
            (let bad-signal-c (evfcb-c "inlet" "(do 1)" 1 "bad-signal"))
            (let bad-signal-o (evfc-observation
                (evfc-candidate-id bad-signal-c) "clean" "success" 1
                (evfc-execution 0 0 "invented status")
                (evfc-evidence "coldjudge" "coldjudge/bad-signal")))

            (sum (list
                (evfcb-bit (and (not (nothing? rows)) (eq (len rows) 12)) 1)
                (evfcb-bit (and (evfcb-has-kind? rows "syntax-failure")
                    (evfcb-has-kind? rows "semantic-failure")) 2)
                (evfcb-bit (and (evfcb-has-kind? rows "timeout")
                    (evfcb-has-kind? rows "nothing")) 4)
                (evfcb-bit (and (evfcb-has-kind? rows "failure")
                    (evfcb-has-kind? rows "choice")) 8)
                (evfcb-bit (and (evfcb-has-kind? rows "cut")
                    (evfcb-has-kind? rows "undo")) 16)
                (evfcb-bit (evfcb-all-answers-green? rows ts) 32)
                (evfcb-bit (and (eq (evfc-green? mismatch-c mismatch-o) 0)
                    (str_eq (evfc-observed-kind mismatch-c mismatch-o)
                            "semantic-failure")) 64)
                (evfcb-bit (and (not (nothing? train))
                    (and (not (nothing? valid))
                         (and (gt (str_len train) 0) (gt (str_len valid) 0)))) 128)
                (evfcb-bit (and (str_eq train (evfc-jsonl ts "train"))
                    (str_eq valid (evfc-jsonl ts "valid"))) 256)
                (evfcb-bit (and (ge (str_find train "\"provenance\"" 0) 0)
                    (ge (str_find valid "form-source-adapter-d" 0) 0)) 512)
                (evfcb-bit (and (eq (evfcb-text-has-denial? train
                        (evfc-denials)) 0)
                    (eq (evfcb-text-has-denial? valid (evfc-denials)) 0)) 1024)
                (evfcb-bit (and (eq (evfc-candidate-denied? leak-c) 1)
                    (eq (evfc-candidate-denied? leak-e) 1)) 2048)
                (evfcb-bit (and (str_eq (evfc-trajectory-status
                        (evfcb-plateau)) "plateau")
                    (nothing? (evfc-build (list (evfcb-plateau))))) 4096)
                (evfcb-bit (and (str_eq (evfc-trajectory-status
                        (evfcb-same-source-fake-revision)) "failure")
                    (nothing? (evfc-build
                        (list (evfcb-same-source-fake-revision))))) 8192)
                (evfcb-bit (eq (evfc-observation-valid? bad-signal-c
                    bad-signal-o) 0) 16384)
                (evfcb-bit (and (value_eq
                        (fef-eval (evfc-c-source (evfc-step-candidate
                            (head (evfc-t-steps (nth ts 1)))))) (nothing))
                    (and (eq (fef-eval (evfc-c-source (evfc-step-candidate
                            (head (evfc-t-steps (nth ts 2)))))) 0)
                         (eq (fef-eval (evfc-c-source (evfc-step-candidate
                            (head (evfc-t-steps (nth ts 3)))))) 1))) 32768)
                (evfcb-bit (and (ge (str_find train "signal=choice" 0) 0)
                    (and (ge (str_find train "signal=cut" 0) 0)
                         (ge (str_find train "signal=undo" 0) 0))) 65536)
                (evfcb-bit (and (ge (str_find train "signal=timeout" 0) 0)
                    (and (ge (str_find train "signal=nothing" 0) 0)
                         (ge (str_find train "signal=failure" 0) 0))) 131072)
                (evfcb-bit (and (eq (evfc-family-split "river") "train")
                    (eq (evfc-family-split "birch") "valid")) 262144)
                (evfcb-bit (and (eq (evfc-trajectory-valid? main) 1)
                    (eq (evfc-trajectory-valid? (nth ts 1)) 1)) 524288)))))
    (evfcb-run))
