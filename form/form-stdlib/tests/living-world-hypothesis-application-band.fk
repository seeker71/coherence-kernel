; living-world-hypothesis-application-band.fk -- compatible generated Recipes
; execute only through exact re-offered applications; every option stays optional.
; Verdict 32767 proves fifteen consent, plurality, time, and revocation claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk

(defn lwhtab-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwhtab-sum (tail items)))))

(do
    (let fixture (lwhtw-build-application))
    (let tissue-fixture
        (lwhtw-application-tissue-fixture fixture))
    (let tissue (lwhtw-tissue-candidate tissue-fixture))
    (let world (lwhtw-application-world-cell fixture))
    (let minimal (lwhtw-application-minimal fixture))
    (let rich (lwhtw-application-rich fixture))
    (let reverse (lwhtw-application-reverse fixture))
    (let minimal-execution
        (lwhtw-application-minimal-execution fixture))
    (let rich-pending
        (lwhtw-application-rich-execution fixture))
    (let rich-expired
        (lwht-execution-for world rich 2 (intern_trivial_int 10)))
    (let before-offers
        (lwhtw-application-dependencies
            (lwt-round-world (lwhtw-tissue-round tissue-fixture))
            tissue-fixture))
    (let revoked (lwhtw-revoked-application-world fixture))

    (let c1
        (if (and (node_eq (lwht-execution-for before-offers minimal 2
                              (lwo-none)) (lwo-none))
                 (eq (lwo-field-size
                         (lwht-applications-for
                            before-offers tissue 2)) 0)) 1 0))
    (let c2
        (if (and (eq (lwht-application-shape-valid? minimal) 1)
                 (and (eq (lwht-application-current?
                              world minimal 2) 1)
                      (eq (lwht-application-current?
                              world minimal 3) 0))) 2 0))
    (let c3
        (if (and (eq (lwht-application-shape-valid? rich) 1)
                 (and (eq (lwht-application-current? world rich 2) 1)
                      (eq (lwo-field-size
                              (lwht-applications-for world tissue 2)) 2))) 4 0))
    (let c4
        (if (and (eq (lwht-application-shape-valid? reverse) 1)
                 (and (eq (lwht-application-current?
                              world reverse 2) 0)
                      (node_eq (lwht-execution-for world reverse 2
                                  (lwo-none)) (lwo-none)))) 8 0))
    (let c5
        (if (and (node_eq
                     (lwht-execution-output minimal-execution)
                     (intern_trivial_int 7))
                 (and (eq (oac-one?
                              (lwht-execution-immediate
                                  minimal-execution)) 1)
                      (node_eq
                        (oac-payload
                            (lwht-execution-immediate minimal-execution))
                        (intern_trivial_int 7)))) 16 0))
    (let c6
        (if (and (node_eq
                     (lwht-application-declaration minimal) (lwo-none))
                 (and (eq (len (lwlc-layer-items
                                  (lwht-application-layers minimal))) 0)
                      (and (eq (lwo-field-size
                                  (lwht-application-alternatives minimal)) 0)
                           (and (node_eq
                                  (lwht-application-unknown minimal)
                                  (lwo-none))
                                (and (node_eq
                                      (lwht-application-choice minimal)
                                      (lwo-none))
                                     (node_eq
                                      (lwht-application-timeout minimal)
                                      (lwo-none))))))) 32 0))
    (let c7
        (if (and (eq (lwlc-declaration-current? world
                         (lwht-application-declaration rich)) 1)
                 (and (eq (len (lwlc-layer-items
                                  (lwht-application-layers rich))) 2)
                      (eq (lwlc-lens?
                              (lwlc-stack-default
                                (lwlc-declaration-stack
                                  (lwht-application-declaration rich)))) 1)))
            64 0))
    (let c8
        (if (and (eq (lwlc-recipe-lens?
                         (nth (lwlc-layer-items
                                  (lwht-application-layers rich)) 0)) 1)
                 (node_eq
                    (lwlc-lens-shape
                        (nth (lwlc-layer-items
                                (lwht-application-layers rich)) 1))
                    (lwlc-cell-shape))) 128 0))
    (let c9
        (if (and (eq (lwo-field-size
                         (lwht-execution-alternatives rich-pending)) 1)
                 (and (eq (lwlc-unknown?
                              (lwht-execution-unknown rich-pending)) 1)
                      (eq (lwlc-choice-valid?
                              (lwht-execution-choice rich-pending)) 1))) 256 0))
    (let c10
        (if (and (eq (oac-time-pending?
                         (lwht-execution-time rich-pending)) 1)
                 (and (node_eq
                          (oac-time-pending-observed
                              (lwht-execution-time rich-pending))
                          (intern_trivial_int 5))
                      (eq (oac-one?
                              (lwht-execution-immediate rich-pending)) 1))) 512 0))
    (let c11
        (if (and (eq (oac-time-outcome?
                         (lwht-execution-time rich-expired)) 1)
                 (and (eq (oac-alternative-ack?
                              (oac-time-outcome-ack
                                (lwht-execution-time rich-expired))) 1)
                      (not (node_eq
                              (lwht-execution-time rich-pending)
                              (lwht-execution-time rich-expired))))) 1024 0))
    (let c12
        (if (and (node_eq
                     (lwht-execution-output rich-expired)
                     (intern_trivial_int 7))
                 (and (eq (oac-one?
                              (lwht-execution-immediate rich-expired)) 1)
                      (not (node_eq
                              (lwht-execution-immediate rich-expired)
                              (oac-time-outcome-ack
                                (lwht-execution-time rich-expired)))))) 2048 0))
    (let c13
        (if (and (eq (lwht-execution-current?
                         world minimal-execution) 1)
                 (and (eq (lwht-execution-current?
                              world rich-pending) 1)
                      (gt (lwo-field-size
                              (lwht-execution-witnesses
                                  minimal-execution)) 0))) 4096 0))
    (let c14
        (if (and (eq (lwo-active? revoked minimal) 1)
                 (and (eq (lwht-application-current?
                              revoked minimal 2) 0)
                      (and (eq (lwht-execution-current?
                                  revoked minimal-execution) 0)
                           (eq (lwht-application-current?
                                  revoked rich 2) 1)))) 8192 0))
    (let c15
        (if (and (eq (lwht-integrated-current? revoked tissue) 1)
                 (and (eq (lwo-field-size
                              (lwht-applications-for revoked tissue 2)) 1)
                      (eq (lwht-execution-current?
                              revoked rich-pending) 1))) 16384 0))
    (lwhtab-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
