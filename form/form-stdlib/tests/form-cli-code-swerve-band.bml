; form-cli-code-swerve-band.bml — a reply whose content was already decoded decodes seeded; the lane's phases speak
; on the stage bus; the last replies are reserved for the deliverable. No model runs in the verdict.
;
; REQUIRES: fkwu's shared memory -- the stage bus lives there; isatty and the physical check are fkwu doors
;
; preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-code-live.bml
;
; The sequence is option 1's retained replies of closure-unit-line (walk .hearth/code-memory/replies/21393-*):
; read A, then the guarded edit E twice, over the pre-turn closure-lines.fk without its final newline, so each E
; fails as the witnessed E did. Before each reply the lane decides, records and steps, as fcac-loop does.
;
; Verdict 4095 when every claim lands:
;   1    the four decodes of bootstrap, A, E, E read greedy, greedy, greedy, seeded: the second E's observation
;        is the first's again, and its seed is 1 + the first 7 hex digits of sha256(content + "1")
;   2    a replay from the same start gives the same seed
;   4    the repeated content differs only in counters (repair_attempts, turns, tool calls) and the reply
;        budget, which the content leaves out
;   8    a changed document makes new content
;   16   renewal (fcap-begin-context) keeps the record: the same content still reads seeded with the same seed
;   32   a third decode of one content takes a new seed (count 2)
;   64   an unmanaged run (evaluation) writes no .swerve file; a managed run appends one line per decode, and a
;        fresh state of the same contract (another checkpoint id, an empty record) reads its bootstrap as seen
;   128  the form-code pairs read greedy_replies 3, seeded_replies 1 and seeds [that seed]
;   256  fcsw-reply over a scripted decode decodes greedy with no sampler attached, hands the recorded state to
;        its continuation, and its code.decode stage closes on the bus with the reply's ID count (on a kernel
;        without the bus every stage answers nothing and the reply is the same)
;   512  a read opens and closes code.tool "read"; a verify's caller check opens and closes code.check "source"
;        inside code.tool "verify", outcome ok
;   1024 the deliverable reserve: with remaining replies equal to the completion minimum, outside review, the
;        budget instruction says finish now; one more reply, or review, keeps the ordinary instruction
;   2048 repeated content tries sampler admission, retains a refused owner and cause without decoding;
;        an unsighted observation remains unsighted when recording a reply
;
; The physical check needs the local GPU on a quiet machine, never while LoRA trains:
;   printf 'physical\n' | ./fkwu form/form-stdlib/tests/form-cli-code-swerve-band.bml
; prints swerve-physical with greedy, seeded and seeded-again quanta from qwen38-q8 on one fixture prompt (seed
; 1729), each [ids owned owned-after released pending], and one seeded coding reply on the closure-unit-line
; state through fcsw-reply and the lane's own decode, [seeded-replies stopped native-cell ids detached
; released]; then swerve-physical-verdict ok when seeded IDs differ from greedy, the same seed reproduces them,
; the sampler owns 0 handles after close, every session releases, and the seeded reply submits a native cell.
; A terminal stdin skips it; the band sweep's /dev/null skips it. Admission is observed live, never source-gated.
section [form.bml] {
 class FormCliCodeSwerveBand {
  def swb-bit(ok, bit) = ok ? bit : 0;
  def swb-path() = "form/form-stdlib/closure-lines.fk";
  def swb-u(last) = byte_to_str(226) ++ byte_to_str(128) ++ byte_to_str(last);
  def swb-moved() = str-join-with(["; closure-lines.fk " ++ swb-u(148) ++ " read a line of an fkwu closure back to the unit that wrote it.", ";",
   "; `./fkwu --closure <unit> <out>` joins every unit of a closure into one plain-Form",
   "; file and heads each unit's text with a line \"; unit: <path>\". A sibling kernel",
   "; reports a stop at a line of that file; this unit names the authored unit and", "; the line within it.", "", "(do", "    0)"], "\n");
  def swb-read() = "{\"tool\":\"read\",\"arguments\":[\"form/form-stdlib/closure-lines.fk\"],\"input\":\"\"}";
  // reply 2's guarded edit; its new text is shortened here, since the guard fails before any text is read
  def swb-edit() = "{\"tool\":\"edit\",\"arguments\":[\"form/form-stdlib/closure-lines.fk\",\"e5cbb7b3ed16cba2730c41b7137c048bee6ca527637c06eff2adbc2f4934c6dd\",\"(do\\n     0)\",\"(do\\n  (defn cl-unit-at (text line) (cl-walk text 0 1 line (nothing) 0))\\n  0)\"]}";
  def swb-carried(name, text) {
   let path = temp_dir() ++ "/form-cli-code-swerve-band-" ++ host_pid().str() ++ "-" ++ name;
   let wrote = write_file(path, text);
   let back = read_file(path);
   let gone = fs_remove(path);
   back ?? "";
  }
  def swb-checker() = [(contract, docs) => [1, "stub caller check"], []];
  def swb-open(docs, writable) = fcap-begin-context(fcap-with-document-context(fcap-open-direct-code("closure-unit-line: add four definitions inside the (do ...), before the final 0.", docs, writable), "catalog"));
  def swb-start() = swb-open([[swb-path(), swb-path(), swb-moved()]], [swb-path()]);
  // as fcac-loop does: decide and record before each reply, then step on the reply; [decisions states]
  def swb-walk(s, replies) = foldl((acc, raw) => swb-turn(acc, fcsw-decision(acc[1][-1]), raw), [[], [s]], replies);
  def swb-turn(acc, decided, raw) {
   let recorded = fcsw-record(acc[1][-1], decided[0], decided[2], 0);
   [append(acc[0], [decided]), append(acc[1], [fcsw-step(recorded, raw, swb-checker())])];
  }
  def swb-hex(t, i, acc) = i >= 7 ? acc : swb-hex(t, i + 1, acc * 16 + str_find("0123456789abcdef", substring(t, i, i + 1), 0));
  def swb-expected-seed(content, count) = 1 + swb-hex(hex-encode(sha256-stream-string(content ++ count.str())), 0, 0);
  def swb-seeds(walk) = walk[0] |> map(d => d[2]);

  def swb-sequence(walk) {
   let d = walk[0];
   take(3, swb-seeds(walk)) == [0, 0, 0] && d[3][1] == 1 && d[3][2] > 0 && d[3][2] == swb-expected-seed(d[3][0], 1) && d[3][0] == d[2][0];
  }
  def swb-counters(walk) {
   let s = walk[1];
   fcsw-content(s[2]) == fcsw-content(s[3]) && fcap-failures(s[2]) != fcap-failures(s[3]) && fcap-turns(s[2]) != fcap-turns(s[3]) && fcap-calls(s[2]) != fcap-calls(s[3])
   && fcac-observation-budget(s[2], 24) != fcac-observation-budget(s[3], 24);
  }
  def swb-docs-change(s) = fcsw-content(s) != fcsw-content(fcap-inherit(s, fcap-state(fcap-stage(s), s[1], s[2], [[swb-path(), swb-path(), swb-moved() ++ "\n"]], s[4], s[5], s[6], s[7], fcap-note(s), fcap-turns(s), fcap-calls(s), s[11])));
  def swb-renewal(walk) {
   let last = walk[1][3];
   let recorded = fcsw-record(last, walk[0][3][0], walk[0][3][2], 0);
   let renewed = fcap-begin-context(last);
   fcsw-decision(renewed) == walk[0][3] && fcsw-decision(fcap-begin-context(recorded))[1] == 2;
  }
  def swb-third(walk) {
   let last = walk[1][3];
   let twice = fcsw-record(last, walk[0][3][0], walk[0][3][2], 0);
   let third = fcsw-decision(twice);
   third[1] == 2 && third[2] == swb-expected-seed(third[0], 2) && third[2] != walk[0][3][2];
  }
  def swb-managed(s, id) = fcam-with(s, [temp_dir(), id, swb-contract-once(), 0]);
  def swb-contract-once() = "swerve-band-contract-" ++ host_pid().str();
  def swb-files() {
   let s = swb-start();
   let unmanaged = fcsw-record(s, fcsw-content(s), 0, 0);
   let managed = swb-managed(s, "swerve-band-a");
   let path = fcsw-path(managed);
   let cleared = fs_remove(path);
   let none = nothing?(read_file(path));
   let once = fcsw-record(managed, fcsw-content(managed), 0, 0);
   let lines = split-on(read_file(path) ?? "", "\n") |> filter(l => len(l) > 0);
   let fresh = swb-managed(swb-start(), "swerve-band-b");
   let seen = fcsw-decision(fresh);
   let gone = fs_remove(path);
   none && fcsw-slot(unmanaged)[3] == 1 && len(lines) == 1 && lines[0] == fcsw-content(managed) ++ " 0" && seen[1] == 1 && seen[2] > 0 && fcsw-slot(fresh)[3] == 0;
  }
  def swb-pair(pairs, key) = foldl((acc, p) => json-pair-key(p) == key ? json-pair-value(p) : acc, nothing(), pairs);
  def swb-telemetry(walk) {
   let last = walk[1][3];
   let seeded = fcsw-record(last, walk[0][3][0], walk[0][3][2], 0);
   let pairs = fcsw-telemetry-pairs(seeded);
   node_value(swb-pair(pairs, "greedy_replies")) == 3 && node_value(swb-pair(pairs, "seeded_replies")) == 1 && json-emit(swb-pair(pairs, "seeds")) == "[" ++ walk[0][3][2].str() ++ "]";
  }
  // ── the bus ──
  def swb-bus?() = !nothing?(float_leaf(31, cons(0 - 1, 0)));
  def swb-head() = float_leaf(31, cons(0 - 1, 0))[0];
  def swb-mine(cursor) {
   let answer = float_leaf(31, cons(cursor, 0));
   nothing?(answer) ? [] : filter(r => r[1] == host_pid(), answer[4:]);
  }
  def swb-name(id) = float_leaf(32, id) ?? "";
  def swb-staged(rows, stage, key) = filter(r => swb-name(r[3]) == stage && swb-name(r[4]) == key, rows);
  def swb-pair-closed(rows, outcome) = len(rows) == 2 && rows[0][5] == 1 && rows[1][5] == 2 && rows[1][7] == rows[0][0] && swb-name(rows[1][9]) == outcome;
  def swb-reply() {
   let session = fcms-session("live", "band", "", "", [], [], 64, 10, 7, 0, 0, 0, 0, 0);
   let s = swb-start();
   let cursor = swb-bus?() ? swb-head() : 0;
   let out = fcsw-reply(session, s, swb-checker(), 24, now_unix_ms(), [0, 1], (sess, state, started, stops, ids) => fcms-generation("", [5, 6, 7], fcms-with-stream(sess, 13, 9, 1, 3, 0, 0)), (g, state, checker, turns, started) => [g, state]);
   let rows = swb-staged(swb-mine(cursor), "code.decode", "greedy");
   let shaped = fcms-generation-ids(out[0]) == [5, 6, 7] && nil?(fcsam-owner(fcms-generation-session(out[0]))) && fcsw-slot(out[1])[3] == 1 && fcsw-slot(out[1])[4] == 0;
   shaped && (swb-bus?() ? swb-pair-closed(rows, "ok") && rows[1][10] == 3 : nothing?(fcacs-stage-open("code.decode", "greedy")));
  }
  def swb-tool-check() {
   let s = swb-start();
   let cursor = swb-bus?() ? swb-head() : 0;
   let read = fcsw-step(s, swb-read(), swb-checker());
   let verified = fcsw-step(read, "{\"tool\":\"verify\",\"arguments\":[],\"input\":\"\"}", swb-checker());
   let rows = swb-mine(cursor);
   let tool = swb-staged(rows, "code.tool", "read");
   let verify = swb-staged(rows, "code.tool", "verify");
   let check = swb-staged(rows, "code.check", "source");
   let ran = fcap-calls(verified) == 2 && fcap-checks(verified) == 1;
   ran && (!swb-bus?() || (swb-pair-closed(tool, "ok") && swb-pair-closed(verify, "ok") && swb-pair-closed(check, "ok") && check[0][7] == verify[0][0]));
  }
  def swb-reserve() {
   let s = swb-start();
   let review = fcap-open-direct-review("review goal", [[swb-path(), swb-path(), swb-moved()]]);
   fcsw-coding-instruction(s, 2, 2, "ordinary") == fcsw-finish-now() && fcsw-coding-instruction(s, 3, 2, "ordinary") == "ordinary"
   && fcsw-coding-instruction(review, 1, 1, "ordinary") == "ordinary" && str_find(fcac-budget-instruction(s, fcap-turns(s) + fcac-finish-minimum(s)), "Finish now", 0) > 0;
  }
  def swb-session(observed) = fcms-session("live", "band", "", "", [], [], 64, 10, 7, 0, 0, 0, 0, observed);
  def swb-decode() = (sess, state, started, stops, ids) => fcms-generation("", [5, 6, 7], fcms-with-stream(sess, 13, 9, 1, 3, 0, 0));
  def swb-kept() = (g, state, checker, turns, started) => [g, state];
  def swb-refused() {
   let s = swb-start();
   let seen = fcsw-record(s, fcsw-content(s), 0, 0);
   let cursor = swb-bus?() ? swb-head() : 0;
   let out = fcsw-reply-with(swb-session(0), seen, swb-checker(), 24, now_unix_ms(), [0, 1], (sess,state,started,stops,ids) => fail(), swb-kept(), (sess,seed) => []);
   let slot = fcsw-slot(out[1]);
   let pairs = fcsw-telemetry-pairs(out[1]);
   let rows = swb-staged(swb-mine(cursor), "code.decode", "greedy");
   let unsighted = fcsw-mark-unsighted(seen);
   let kept = fcsw-record(unsighted,fcsw-content(unsighted),0,0);
   fcsw-decision(seen)[1] == 1 && !fcms-live?(fcms-generation-session(out[0])) && fcms-reason(fcms-generation-session(out[0])) == "sampling-admission-failed" && nil?(fcms-generation-ids(out[0])) && slot[3] == 1 && slot[4] == 0 && slot[8] == 1
   && nil?(fcsam-open(nothing(),1729)) && nil?(fcsam-open("missing geometry",1729)) && fcsw-unsighted(kept) == 1 && node_value(swb-pair(pairs,"seeds_held")) == 0 && (!swb-bus?() || swb-pair-closed(rows,"sampling-admission-failed"));
  }
  // ── the physical check ──
  // The quantum witness uses the live reply's own admission, reset and release.
  def swb-physical-quanta(model,prompt,n,seed) {
   let path=mr-path(mr-find(model));
   [swb-physical-quantum(path,prompt,n,0),swb-physical-quantum(path,prompt,n,seed),swb-physical-quantum(path,prompt,n,seed)];
  }
  def swb-physical-quantum(path,prompt,n,seed) {
   let s=swb-start();
   let session=fcms-open-with-profile(path,prompt,4096,"knowledge-query");
   let seen=seed>0 ? fcsw-record(s,fcsw-content(s),0,0) : s;
   let held=record_new(0,"owned",0,"pending",0);
   let decoded=(sess,state,started,stops,ids)=>{ let generation=fcacs-quantum(sess,stops,n); record_set(held,"owned",fcsam-owned(fcsam-owner(fcms-generation-session(generation)))); record_set(held,"pending",fcms-pending(fcms-generation-session(generation))>=0 ? 1 : 0); generation; };
   let out=fcms-live?(session) ? fcsw-reply-with(session,seen,swb-checker(),24,now_unix_ms(),fcacs-stops(session,qsx-load(path)),decoded,swb-kept(),(sess,chosen)=>fcsw-sampler(sess,seed)) : [fcms-generation("",[],session),seen];
   let after=fcms-generation-session(out[0]);
   [fcms-generation-ids(out[0]),record_get(held,"owned"),fcsam-owned(fcsam-owner(after)),fcms-release-ok?(after),record_get(held,"pending")];
  }
  // one seeded coding reply on metal: content already decoded once, seeding open for this reply only
  def swb-physical-reply(model) {
   let s = swb-start();
   let seen = fcsw-record(s, fcsw-content(s), 0, 0);
   let session = fcac-model-ready(model) ? fcac-open-budget(model, seen, 16384, 24) : fcms-session("refused", "model-not-ready", "", "", [], [], 0, 0, 0 - 1, 1, 0, 0, 0, 0);
   let out = fcms-live?(session) ? fcsw-reply(session, seen, swb-checker(), 24, now_unix_ms(), fcacs-stops(session, qsx-load(fcms-path(session))), fcac-decode, swb-kept()) : [fcms-generation("", [], session), seen];
   let after = fcms-generation-session(out[0]);
   let cells = fcac-control-submissions();
   let submitted = len(cells)==1 && !nothing?(fcap-node-object(cells[0]));
   let detached = nil?(fcsam-owner(after)) ? 1 : 0;
   let released = fcms-live?(session) ? fcms-release-ok?(after) : 0;
   [fcsw-slot(out[1])[4], fcms-stopped?(after) || submitted ? 1 : 0, submitted ? 1 : 0, len(fcms-generation-ids(out[0])), detached, released];
  }
  def swb-physical-ok(q, r) = !((Value) q[0][0] == q[1][0]) && (Value) q[1][0] == q[2][0] && len(q[1][0]) > 0 && q[1][2] == 0 && q[2][2] == 0
   && q[0][3] == 1 && q[1][3] == 1 && q[2][3] == 1 && r[0] == 1 && r[1] == 1 && r[2] == 1 && r[4] == 1 && r[5] == 1;
  def swb-physical() {
   let ask = isatty() == 1 ? nothing() : read_line();
   !nothing?(ask) && ask == "physical" ? swb-physical-said(swb-physical-quanta("qwen38-q8", "Read the current source through a native Form action.", 64, 1729), swb-physical-reply("qwen38-q8")) : 0;
  }
  def swb-physical-said(q, r) {
   let said = print_str("swerve-physical " ++ json-emit(fcam-pack([q, r])));
   print_str("swerve-physical-verdict " ++ (swb-physical-ok(q, r) ? "ok" : "differs"));
  }
 }
 let a = swb-carried("reply-1-read.json", swb-read());
 let e = swb-carried("reply-2-edit.json", swb-edit());
 let walk = swb-walk(swb-start(), [a, e, e, a]);
 let again = swb-walk(swb-start(), [a, e, e, a]);
 let verdict = swb-bit(swb-sequence(walk), 1) + swb-bit(swb-seeds(walk) == swb-seeds(again) && swb-seeds(walk)[3] > 0, 2) + swb-bit(swb-counters(walk), 4)
  + swb-bit(swb-docs-change(walk[1][3]), 8) + swb-bit(swb-renewal(walk), 16) + swb-bit(swb-third(walk), 32) + swb-bit(swb-files(), 64)
  + swb-bit(swb-telemetry(walk), 128) + swb-bit(swb-reply(), 256) + swb-bit(swb-tool-check(), 512) + swb-bit(swb-reserve(), 1024)
   + swb-bit(swb-refused(), 2048);
 let physical = swb-physical();
 print_str("form-cli-code-swerve-band " ++ verdict.str() ++ " seeds=" ++ json-emit(json-node-array(swb-seeds(walk) |> map(json-node-int))));
 verdict;
}
