   let e = ovb-write(w, "receipts/draft-readings-ledger.jsonl", "{\"at_unix_ms\":" ++ (ovb-now() - 9 * ovb-day()).str() ++ ",\"rows_written\":6,\"readers\":\"native-voice\",\"voice_both_read\":42}\n{\"at_unix_ms\":" ++ ovb-ago(1).str() ++ ",\"rows_written\":6,\"readers\":\"native-voice\",\"voice_both_read\":42}\n");
