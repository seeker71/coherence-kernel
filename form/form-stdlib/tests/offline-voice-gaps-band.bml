   let p = ovb-write(w, "receipts/exit-proof-ledger.jsonl", ovb-exit(ovb-ago(1), "holds"));
   let q = foldl((acc, d2) => ovb-write(w, d2, "// a door\n"), 0, ovb-doors());
   let r = ovb-write(w, "observe/scheduled-walk.bml", "def steps() = [" ++ ovb-door-names(ovb-doors()) ++ "];\n");
   let s = ovb-write(w, "observe/day-turn.bml", "// the day\n");
   let t = ovb-write(w, "form/x.bml", "// the gap's edit\n");
   // a gate runs the band of every code file the world's one landing touched
   let tg = ovb-write(w, "gate/drift-gates.bml", foldl((acc, d2) => acc ++ "dg-row(\"x\", \"form/form-stdlib/tests/" ++ ep-stem(d2) ++ "-band.bml\", nothing(), 1),\n", "", append(["form/x.bml", "form/old.bml", "gate/drift-gates.bml", "learn/homecoming-distillation-corpus.fk", "observe/scheduled-walk.bml", "observe/day-turn.bml"], ovb-doors())));
   let stamped = ovb-write(w, ".hearth/walk.began", "");
   let init = ovb-init(w);
   // a native landing nine days old whose line still stands; the world's other landing is young and waits
   let toldOld = ovb-write(w, "form/old.bml", "// a line that stands\n");
   let oldCommit = ovb-commit-at(w, ovb-old-subject(old), "", ["form/old.bml"], old[0] + 120000);
   let commit =ovb-commit(w, "Native turn " ++ hw-day-in(ovb-zone(), last[0]) ++ " " ++ ovb-hhmm(last) ++ ": the body's own loop, no rented mind", "", ["."]);
   ovb-publish(w);
  }
  // the living gaps' world, false: each thing is false, and looks true to a reading that does not ask
  def ovb-write-false() {
   let w = ovb-false();
   let due = ovb-due();
   // every slot holds a row: named walk-here, or named well and coordinated by a rented mind, or naming a session
   let wrong = ovb-old-slot(9);
   let unread = ovb-old-slot(10);
   let crossings = foldl((acc, s) => acc ++ ovb-crossing(s[0] + 60000, "walk-here " ++ hw-day-in(ovb-zone(), s[0]), "host-schedule", "/sbin/launchd", 0, "") ++ ovb-crossing(s[0] + 70000, ovb-slot-movement(s), "session", "/bin/zsh", 1, "") ++ ovb-crossing(s[0] + 80000, ovb-slot-movement(s), "host-schedule", "/sbin/launchd", 0, ",\"session\":\"s\""), ovb-kept(wrong[0] + 60000, ovb-slot-movement(wrong)) ++ ovb-kept(unread[0] + 60000, ovb-slot-movement(unread)), due);
   let last = due[-1];
   let lastDay = hw-day-in(ovb-zone(), last[0]);
   let a = ovb-write(w, "receipts/crossings-ledger.jsonl", crossings);
   let b = ovb-write(w, "learn/native-turn-queue.jsonl", "{\"id\":\"g1\",\"writable\":[\"form/x.bml\"]}\n{\"id\":\"g2\"}\n");
   // g1 read green once, then its last real row is not; a green dry row, a green test row, a session's green row and an option-0 full row come after it.
   // g5 is the last real option that ended green on the schedule, and a remote guide row names it
   // Last of all, a no-model rung's green row, which looks like the voice's and is not
   let c = ovb-write(w, "receipts/native-turn-ledger.jsonl", ovb-turn-row("g1", ovb-ago(9), 1, 1, ovb-voice()) ++ ovb-turn-row("g5", ovb-ago(7), 1, 1, ovb-voice()) ++ ovb-turn-row("g1", ovb-ago(5), 2, 0, ovb-voice()) ++ "{\"at_unix_ms\":" ++ ovb-ago(4).str() ++ ",\"gap\":\"g1\",\"option\":3,\"band_green\":1,\"dry\":1,\"test\":0}\n{\"at_unix_ms\":" ++ ovb-ago(4).str() ++ ",\"gap\":\"g1\",\"option\":3,\"band_green\":1,\"dry\":0,\"test\":1}\n" ++ ovb-turn-row("g3", ovb-ago(3), 1, 1, ",\"session\":\"s\"" ++ ovb-voice()) ++ ovb-turn-row("g4", ovb-ago(2), 0, 1, ovb-voice()) ++ ovb-turn-row("g5", ovb-ago(1), 1, 1, ovb-no-model()));
   // the heal and the offers read well, under a co-author's landing: the schedule did not write them
   let c2 = ovb-write(w, "receipts/walk-heal-ledger.jsonl", "{\"at_unix_ms\":" ++ ovb-ago(1).str() ++ ",\"returned\":1,\"conflicts\":0}\n");
   let c3 = ovb-write(w, "receipts/self-steer-ledger.jsonl", "{\"at_unix_ms\":" ++ ovb-ago(1).str() ++ ",\"open\":2,\"offered\":2,\"queue\":1,\"finding\":1,\"share_pm\":1000}\n");
   // a session measured before the window and grown inside it
   let c4 = ovb-write(w, "receipts/session-rent-ledger.jsonl", ovb-meter(ovb-now() - 9 * ovb-day(), "s", 1000) ++ ovb-meter(ovb-ago(1), "s", 1500));
   // the last green real option's gap stands in the guide ledger
   let d = ovb-write(w, "receipts/remote-guide-ledger.jsonl", "{\"gap\":\"g5\",\"remote_dependence\":\"required-work\"}\n");
   // one set full in an older reading and short in its last; a set never read. After them a reading with no role prompt and a reading with an adapter on, both full,
   // which are not the voice as it speaks. Core values read in full over the set that was read and tagged in the set that was not; protocols tagged nowhere
   let e = ovb-write(w, "model/fixtures/alignment/scenarios.jsonl", ovb-scenario("s1") ++ ovb-scenario("s2"));
   let e2 = ovb-write(w, "model/fixtures/alignment/scenarios-3.jsonl", ovb-scenario("s3"));
   let e3 = ovb-write(w, "model/fixtures/alignment/axes.jsonl", ovb-tagged("s1", ["core values", "capabilities", "tone of voice", "core features", "core principles"]) ++ ovb-tagged("s2", ["interfaces"]) ++ ovb-tagged("s3", ["core values"]));
   let one = ovb-set("scenarios.jsonl");
   let full = ["capabilities", "tone of voice", "core features", "core principles", "interfaces"];
   // the held-out set short in its first reading, full in a later one under the same prompt; the exam's rows full, session empty, and no native landing added them
   let fx = ovb-write(w, "receipts/offline-exam-ledger.jsonl", foldl((acc, k) => acc ++ ovb-exam-row(ovb-now() - 60000, k, "", 1, 1, 1, 0), "", ovb-exam-kinds()));
   let f = ovb-write(w, "receipts/alignment-ledger.jsonl", ovb-held-reading(ovb-ago(10), 3, 9) ++ ovb-held-reading(ovb-ago(9), 9, 9) ++ ovb-reading(ovb-ago(9), one, 2, 6, 6, "live", "") ++ ovb-reading(ovb-ago(3), one, 2, 6, 5, "live", "") ++ ovb-reading(ovb-ago(2), one, 2, 6, 6, "none", "") ++ ovb-reading(ovb-ago(1), one, 2, 6, 6, "live", "form/form-stdlib/adapters/x"));
   let f2 = ovb-write(w, "receipts/alignment-axis-ledger.jsonl", ovb-axis-rows(ovb-ago(9), one, full, 1, 1, "live", "") ++ ovb-axis-row(ovb-ago(9), one, "core values", 1, 1, "live", "") ++ ovb-axis-rows(ovb-ago(3), one, full, 1, 0, "live", "") ++ ovb-axis-row(ovb-ago(3), one, "core values", 1, 1, "live", "") ++ ovb-axis-rows(ovb-ago(2), one, ovb-all-axes(), 1, 1, "none", "") ++ ovb-axis-rows(ovb-ago(1), one, ovb-all-axes(), 1, 1, "live", "form/form-stdlib/adapters/x"));
   // history full, the window's rows not: rent, a provider at rent 0, unanswered, a seam that landed nothing, a seam row unanswered
   let g = ovb-write(w, "receipts/query-coverage-ledger.jsonl", foldl((acc, k) => acc ++ ovb-cov(1000, k, "substrate", 1, 0), "", ["prose", "lookup", "code", "plan", "structural"]) ++ ovb-cov(ovb-now() - 60000, "prose", "provider", 1, 0) ++ ovb-cov(ovb-now() - 60000, "lookup", "substrate", 1, 13) ++ ovb-cov(ovb-now() - 60000, "code", "fkwu-model-session", 1, 0) ++ ovb-cov(ovb-now() - 60000, "plan", "none", 0, 0) ++ ovb-cov(ovb-now() - 60000, "structural", "form-find", 0, 0));
   // answered with nothing generated; a lane that wore an adapter for a session, not the schedule
   // and Q4 went quiet: its schedule rows are older than the window, its fresh row a session's at a rate that would pass
   let h = ovb-write(w, "receipts/local-run-ledger.jsonl", "{\"at_unix_ms\":" ++ ovb-ago(1).str() ++ ",\"session\":\"s\",\"lane\":\"native-metal-lora\",\"status\":\"answered\",\"generated_ids\":0}\n" ++ ovb-run-row(ovb-now() - 9 * ovb-day(), "", "Q4_K_M", "9.00", "") ++ ovb-run-row(ovb-ago(3), "s", "Q4_K_M", "9.00", "") ++ ovb-run-row(ovb-ago(3), "s", "Q8_0", "2.79", ""));
   // the accepted reading short, a later rejected row under; the 27B better once and then not; every row spent rent; no row judged
   let j = ovb-write(w, "receipts/lora-promotion-ledger.jsonl", ovb-lora(ovb-ago(9), "llama-3.2-3b-voice", "accepted", 3000, 2900, 1, 7, "") ++ ovb-lora(ovb-ago(8), "llama-3.2-3b-voice", "accepted", 3000, 3100, 0, 7, "") ++ ovb-lora(ovb-ago(7), "llama-3.2-3b-voice", "rejected", 3000, 2000, 1, 7, "") ++ ovb-lora(ovb-ago(6), "qwen38-last-block", "accepted", 2779, 2769, 1, 7, "") ++ ovb-lora(ovb-ago(5), "qwen38-last-block", "accepted", 2779, 2790, 0, 7, "") ++ ovb-lora(ovb-ago(1), "a-session-child", "rejected", 3000, 2900, 1, 0, ",\"judged_on\":\"held-out\""));
   // of record wrote nothing while the native reader did; the native reader wrote nothing while of record did: each reads its own rows, and here both are false
   let k = ovb-write(w, "receipts/draft-readings-ledger.jsonl", "{\"at_unix_ms\":" ++ ovb-ago(6).str() ++ ",\"rows_written\":0,\"readers\":\"of-record\"}\n{\"at_unix_ms\":" ++ ovb-ago(5).str() ++ ",\"rows_written\":0,\"readers\":\"native-voice\"}\n");
   // a session's draft, answered, inside a slot's window, as its child and its judgment above: the first commit below is a co-author's, so no native landing added them
   let l = ovb-write(w, "receipts/draft-ledger.jsonl", "{\"at_unix_ms\":" ++ ovb-ago(7).str() ++ ",\"voice\":\"answered\",\"generated\":0}\n{\"at_unix_ms\":" ++ ovb-ago(1).str() ++ ",\"voice\":\"answered\",\"generated\":431}\n");
   // verified long ago, refused since; the exam's fixture request verified on a slot, which is no gap of the body's
   let m = ovb-write(w, ".hearth/local-plans/ledger.jsonl", "{\"at_unix_ms\":" ++ (ovb-now() - 20 * ovb-day()).str() ++ ",\"verdict\":\"verified\",\"option\":1}\n{\"at_unix_ms\":" ++ ovb-ago(8).str() ++ ",\"verdict\":\"refused\",\"option\":2}\n{\"at_unix_ms\":" ++ ovb-ago(1).str() ++ ",\"verdict\":\"verified\",\"option\":1,\"request\":\"offline-exam-plan\"}\n");
   let n = ovb-write(w, "learn/homecoming-distillation-corpus.fk", "hdc-row(1, 2, [], [], \"w\", \"rented-oracle\")\n");
   // a session's candidate and a session's closed review: they stand, and no native landing added them
   let n2 = ovb-write(w, "learn/distillation-native-candidates.jsonl", "{\"at_unix_ms\":" ++ ovb-ago(1).str() ++ ",\"src\":\"native-voice\",\"verdict\":\"admitted\",\"fresh\":\"w\",\"generated_ids\":12}\n");
   let n3 = ovb-write(w, "receipts/self-review-ledger.jsonl", "{\"at_unix_ms\":" ++ ovb-ago(1).str() ++ ",\"reads\":\"closed\"}\n");
   let n4 = ovb-write(w, "docs/rent-to-zero-goal.form", "(query-scope \"deployed-host\" \"open\" \"no voice\")\n(query-scope \"all-queries\" \"open\" \"this Mac only\")\n");
   // the review ran, eight days ago
   let o = ovb-write(w, "receipts/local-flow-review.jsonl", "{\"at_unix_ms\":" ++ (ovb-now() - 8 * ovb-day()).str() ++ ",\"options\":3}\n");
   // a proof that held, four days ago
   let p = ovb-write(w, "receipts/exit-proof-ledger.jsonl", ovb-exit(ovb-now() - 4 * ovb-day(), "holds"));
   // doors: the turn's and the review's stand in comments only; the reader's does not stand at all; the exam's stands and no step begins it
   let doors = filter(d2 => (String) d2 != "observe/draft-native-reading-run.bml", ovb-doors());
   let q = foldl((acc, d2) => ovb-write(w, d2, "// a door\n"), 0, doors);
   let r = ovb-write(w, "observe/scheduled-walk.bml", "// \"observe/native-turn-run.bml\" \"observe/local-flow-review.bml\"\ndef steps() = [" ++ ovb-door-names(filter(d2 => (String) d2 != "observe/native-turn-run.bml" && (String) d2 != "observe/local-flow-review.bml" && (String) d2 != "observe/offline-exam-run.bml", ovb-doors())) ++ "];\n");
   let s = ovb-write(w, "observe/day-turn.bml", "// the day\n");
   let t = ovb-write(w, "form/x.bml", "// an edit\n");
   let t2 = ovb-write(w, "form/y.bml", "// an edit\n");
   let t3 = ovb-write(w, "form/z.bml", "// an edit\n");
   // a gate reads form/w.bml and no gate reads form/v.bml
   let gatesWrote = ovb-write(w, "gate/drift-gates.bml", "dg-row(\"w\", \"form/form-stdlib/tests/w-band.bml\", nothing(), 1),\n");
   let stamped = ovb-write(w, ".hearth/walk.began", "");
   let init = ovb-init(w);
   // every landing here is older than seven days, so each is judged and none waits. Two are native by every other test: one's line a later commit repaired, one's code no gate reads
   let ripe = ovb-now() - 8 * ovb-day();
   let tw = ovb-write(w, "form/w.bml", "// the wrong line\n// a twin\n// the wrong line\n");
   let cw = ovb-commit-at(w, ovb-old-subject(wrong), "", ["form/w.bml"], wrong[0] + 120000);
   let tv = ovb-write(w, "form/v.bml", "// a line no gate reads\n");
   let cv = ovb-commit-at(w, ovb-old-subject(unread), "", ["form/v.bml"], unread[0] + 120000);
   // a co-author signed it; its crossings row is on the ref and on the schedule, had any row been kept
   let c1 = ovb-commit-at(w, "Native turn " ++ lastDay ++ " " ++ ovb-hhmm(last) ++ ": the body's own loop, no rented mind", "Co-Authored-By: Claude <noreply@anthropic.com>", ["."], ripe);
   // a subject with no crossings row
   let t4 = ovb-write(w, "form/y.bml", "// an edit, again\n");
   let c2 = ovb-commit-at(w, "Native turn " ++ lastDay ++ " 2359: the body's own loop, no rented mind", "", ["form/y.bml"], ripe);
   // a crossings row a rented mind coordinated
   let t5 = ovb-write(w, "form/z.bml", "// an edit, again\n");
   let c3 = ovb-commit-at(w, "Scheduled movement " ++ hw-day-in(ovb-zone(), due[0][0]) ++ ": the body walks with no rented mind", "", ["form/z.bml"], ripe);
   // the repair of the wrong line, its twin left standing: a line stands by its count, not by a line alike anywhere in the file
   let t6 = ovb-write(w, "form/w.bml", "// the right line\n// a twin\n// the wrong line\n");
   let c4b = ovb-commit-at(w, "A session repairs a line", "", ["form/w.bml"], ripe);
   ovb-publish(w);
  }
  // ---- the door, spawned over the fixtures -------------------------------------------------------------------------------
  def ovb-door-at(path, name, request) {
   let base = ovb-dir() ++ "/" ++ name;
   let w = write_file_text(base ++ ".in", request);
   let pid = host_spawn_at(["./fkwu", path], [base ++ ".in", base ++ ".out", base ++ ".err"]);
   let status = pid <= 0 ? -1 : host_wait(pid);
   [status, read_file(base ++ ".out") ?? "", read_file(base ++ ".err") ?? ""];
  }
  def ovb-door(name, request) = ovb-door-at("observe/offline-voice-gaps-run.bml", name, request);
  def ovb-clock() = ",\"now_ms\":" ++ ovb-now().str() ++ ",\"zone_ms\":" ++ ovb-zone().str();
  def ovb-request(walk) = "{\"gaps\":\"" ++ ovb-fx() ++ "/gaps.jsonl\",\"root\":\"" ++ ovb-fx() ++ "\",\"walk\":\"" ++ walk ++ "\",\"register\":\"" ++ ovb-register() ++ "\"" ++ ovb-clock() ++ "}";
  def ovb-world(root) = "{\"root\":\"" ++ root ++ "\",\"walk\":\"" ++ root ++ "\",\"register\":\"" ++ ovb-dir() ++ "/world-register.jsonl\"" ++ ovb-clock() ++ "}";
  def ovb-world-late(root) = "{\"root\":\"" ++ root ++ "\",\"walk\":\"" ++ root ++ "\",\"register\":\"" ++ ovb-dir() ++ "/world-register.jsonl\",\"now_ms\":" ++ (ovb-now() + 8 * ovb-day()).str() ++ ",\"zone_ms\":" ++ ovb-zone().str() ++ "}";
  // what a stopped body may still read closed: a record of what once was so, and the windows of thirty days
  def ovb-records() = ["band-first-open", "rent-landings-native", "rent-gaps-native", "lift-3b", "lora-27b-last-block", "draft-readings-rows", "drafts-read-natively", "offline-exam-heldout", "query-host-deployed", "query-scope-all"];
  // run A reads the walk fixture as the walk checkout; run B names no walk checkout; run C names a gaps file that is not there
  def ovb-a() = ovb-door("a", ovb-request(ovb-walk()));
  def ovb-b() = ovb-door("b", ovb-request(""));
  def ovb-c() = ovb-door("c", "{\"gaps\":\"" ++ ovb-fx() ++ "/no-such-gaps.jsonl\",\"register\":\"" ++ ovb-register() ++ "\"}");
  def ovb-line(id, verdict, rest) = "[offline-voice-gaps] " ++ id ++ ": " ++ verdict ++ " — t-" ++ id ++ "; " ++ rest;
  def ovb-c-last(ctx) {
   let out = ctx[0][1];
   (Comparable) ctx[0][0] == 0
   && ovb-has?(out, ovb-line("g-closed", "closed", "open_gaps 0 == 0 (the last of 2 row(s), at 2); gap \"g9\" (turn-ledger " ++ ovb-fx() ++ "/flow.jsonl; serves: g-g-closed)"))
   && ovb-has?(out, ovb-line("g-open", "open", "predicates_passed 87 == predicates_total 93 (the last of 1 row(s), at 3) (readings "))
   && ovb-has?(out, ovb-line("g-also", "open", "open_gaps 0 == 0 (the last of 2 row(s), at 2); gaps_unread 8 == 0 (turn-ledger "));
  }
  def ovb-c-unread(ctx) {
   let out = ctx[0][1];
   ovb-has?(out, ovb-line("g-nofield", "unread", "field open_gaps absent (the last of 1 row(s), at 4) (readings "))
   && ovb-has?(out, ovb-line("g-nowhere", "unread", "no row where dry 0 among 1 row(s) (turn-ledger "))
   && ovb-has?(out, ovb-line("g-absent", "unread", "absent: " ++ ovb-fx() ++ "/absent.jsonl (lora "))
   && ovb-has?(out, ovb-line("g-kind", "unread", "kind \"moon\" has no reader (the kinds: "))
   && ovb-has?(out, ovb-line("g-strop", "unread", "class \"begun\" >= \"begun\" (the last of 1 row(s), at 8); comparison \">=\" unknown (lora "))
   && !ovb-has?(out, "g-nofield: closed") && !ovb-has?(out, "g-nowhere: closed") && !ovb-has?(out, "g-absent: closed") && !ovb-has?(out, "g-kind: closed") && !ovb-has?(out, "g-strop: closed");
  }
  def ovb-c-tests(ctx) {
   let out = ctx[0][1];
   ovb-has?(out, "g-test-gt: closed") && ovb-has?(out, "g-test-in: closed") && ovb-has?(out, "g-test-absent: closed") && ovb-has?(out, "g-test-ne: closed") && ovb-has?(out, "g-test-present: closed")
   && ovb-has?(out, ovb-line("g-within", "open", "the row is older than 0 hours (the last of 2 row(s), at 2)"))
   && ovb-has?(out, ovb-line("g-off-slot", "open", "the row stands outside every slot of the schedule, so the schedule did not write it (the last of 1 row(s), at "))
   && ovb-has?(out, "g-on-slot: closed")
   && ovb-has?(out, ovb-line("g-none-open", "open", "no row where dry 0 among 1 row(s) (turn-ledger "))
   && ovb-has?(out, ovb-line("g-not-in", "open", "band_green 1 == 1 (the last of 1 row(s), at 9); gap \"g7\" stands in guide.jsonl (turn-ledger "));
  }
  def ovb-c-share(ctx) {
   let out = ctx[0][1];
   ovb-has?(out, ovb-line("g-share-open", "open", "2 of 4 row(s) where kind \"lookup\" hold answered 1, rent_tokens 0: 500 pm >= 1000 (coverage "))
   && ovb-has?(out, ovb-line("g-share-closed", "closed", "2 of 2 row(s) where kind \"plan\" hold answered 1, rent_tokens 0: 1000 pm >= 1000 (voice-availability "))
   && ovb-has?(out, ovb-line("g-share-since", "closed", "2 of 2 row(s) where kind \"lookup\" since 10 hold answered 1, rent_tokens 0: 1000 pm >= 1000 (voice-availability "))
   && ovb-has?(out, ovb-line("g-seam", "unread", "the seam landed no row: none of 2 row(s) where kind \"plan\" holds source \"form-find\" (coverage "))
   && ovb-has?(out, ovb-line("g-share-stale", "open", "no row where kind \"plan\" inside the last 0 hours among 3 row(s) (coverage "))
   && ovb-has?(out, ovb-line("g-share-window", "closed", "1 of 1 row(s) where kind \"lookup\" inside the last 0 hours hold answered 1, rent_tokens 0: 1000 pm >= 1000 (coverage "));
  }
  def ovb-c-table(ctx) {
   let out = ctx[0][1];
   ovb-has?(out, ovb-line("g-table-open", "open", "Q4_K_M column 9 reads 0.61 against Q8_0 2.79: 610 >= 2790 in milli (the last table row of each key) (plan-doc "))
   && ovb-has?(out, ovb-line("g-table-closed", "closed", "Q8_0 column 9 reads 2.79 against Q4_K_M 0.61: 2790 >= 610 in milli (the last table row of each key) (plan-doc "))
   && ovb-has?(out, ovb-line("g-table-nokey", "unread", "no table row keyed Q2_K among 6 table row(s) (plan-doc "));
  }
  // at 2026-10-31 15:25 at +08:00: 21 slots due, 2026-10-24 19:00 first and 2026-10-31 12:30 last. The night's row and the last stamp read; a stamp of another door, a
  // walk-here row, a session's row, a rented row, a row with the wrong coordinator and a row only in the working tree read nothing; the retry row is a note
  def ovb-c-slots(ctx) {
   let out = ctx[0][1];
   let due = ovb-due();
   (Comparable) len(due) == 21 && ((String) ep-slot-name(due[0], ovb-zone()) == "2026-10-24 19:00") && ((String) ep-slot-name(due[-1], ovb-zone()) == "2026-10-31 12:30")
   && ovb-has?(out, "g-slots: open — t-g-slots; 2 of 21 slot(s) due in the last 7 days read a stamp or a landed row: 1 landed, 1 began only (2026-10-31 12:30: a stamp says began, never finished); 19 unread (" ++ ep-slot-name(due[0], ovb-zone()))
   && ovb-has?(out, ep-slot-name(due[6], ovb-zone()) ++ " (retry begun)")
   && ovb-has?(out, ": 95 pm >= 1000 (walk-schedule " ++ ovb-walk() ++ "/.hearth/walk.began; serves: g-g-slots)")
   && (Comparable) ctx[1][0] == 0
   && ovb-has?(ctx[1][1], ovb-line("g-slots", "unread", "no walk checkout: the day-turn plist names none (walk-schedule walk:.hearth/walk.began; serves: g-g-slots)"));
  }
  def ovb-c-summary(ctx) {
   let reg = read_file(ovb-register()) ?? "";
   ovb-has?(ctx[0][1], "[offline-voice-gaps] summary: 28 gap(s): closed 11, open 10, unread 7; register " ++ ovb-register() ++ " appended\n")
   && ovb-has?(ctx[1][1], "[offline-voice-gaps] summary: 28 gap(s): closed 11, open 9, unread 8; register " ++ ovb-register() ++ " appended\n")
   && (Comparable) len(filter(l => len(l) > 0, split-on(reg, "\n"))) == 2
   && ovb-has?(reg, "\"gaps_file\":\"" ++ ovb-fx() ++ "/gaps.jsonl\",\"gaps\":28,\"closed\":11,\"open\":10,\"unread\":7,\"verdicts\":[{\"id\":\"g-closed\",\"kind\":\"turn-ledger\",\"verdict\":\"closed\",\"observation\":\"open_gaps 0 == 0 (the last of 2 row(s), at 2); gap \\\"g9\\\"\",\"source\":\"" ++ ovb-fx() ++ "/flow.jsonl\",\"goal\":\"g-g-closed\"}")
   && ovb-has?(reg, "\"gaps\":28,\"closed\":11,\"open\":9,\"unread\":8,")
   && ovb-has?(reg, "{\"id\":\"g-slots\",\"kind\":\"walk-schedule\",\"verdict\":\"unread\",\"observation\":\"no walk checkout: the day-turn plist names none\",\"source\":\"walk:.hearth/walk.began\"");
  }
  def ovb-c-refusal(ctx) {
   let before = read_file(ovb-register()) ?? "";
   let r = ovb-c();
   let after = read_file(ovb-register()) ?? "";
   (Comparable) r[0] != 0 && ovb-has?(r[1], "offline-voice-gaps: no gaps file at " ++ ovb-fx() ++ "/no-such-gaps.jsonl") && (Comparable) len(before) == len(after);
  }
  // ---- the living rows ------------------------------------------------------------------------------------------------
  def ovb-living-count() = len(fcgp-rows("learn/offline-voice-gaps.jsonl"));
  def ovb-t() = ovb-door("t", ovb-world(ovb-true()));
  def ovb-f() = ovb-door("f", ovb-world(ovb-false()));
  def ovb-late() = ovb-door("late", ovb-world-late(ovb-true()));
  def ovb-verdict-lines(out, word) = filter(l => ovb-has?(l, ": " ++ word ++ " — "), split-on(out, "\n"));
  def ovb-say-lines(flow, lines) = map(l => print_str(flow ++ ": " ++ substring(l, 0, len(l) < 300 ? len(l) : 300)), lines);
  def ovb-c-true(ctx) {
   let t = ctx[2];
   let n = ovb-living-count();
   let short = append(ovb-verdict-lines(t[1], "open"), ovb-verdict-lines(t[1], "unread"));
   let said = ovb-say-lines("true world, short of closed", short);
   (Comparable) t[0] == 0 && nil?(short) && ovb-has?(t[1], "summary: " ++ n.str() ++ " gap(s): closed " ++ n.str() ++ ", open 0, unread 0;");
  }
  def ovb-c-false(ctx) {
   let f = ctx[3];
   let closed = ovb-verdict-lines(f[1], "closed");
   let said = ovb-say-lines("false world, read closed", closed);
   let late = ctx[4];
   let lateClosed = filter(l => ovb-has?(l, "[offline-voice-gaps] ") && !any?(id => ovb-has?(l, "[offline-voice-gaps] " ++ id ++ ":"), ovb-records()), ovb-verdict-lines(late[1], "closed"));
   let saidLate = ovb-say-lines("eight days after every door stopped, read closed", lateClosed);
   (Comparable) f[0] == 0 && nil?(closed) && ovb-has?(f[1], "gap(s): closed 0,") && all?(id => ovb-has?(ovb-line-of(f[1], id), id ++ ": open") && ovb-has?(ovb-line-of(f[1], id), "no native landing on origin/main"), ["self-draft", "self-lift", "self-judge"]) && (Comparable) late[0] == 0 && nil?(lateClosed);
  }
  def ovb-c-scope(ctx) {
   let d = ovb-dir() ++ "/scope";
   let m = host_dir_mkdir(d);
   let doc = ovb-write(d, "doc.form", "(query-scope \"a\" \"open\" \"a rented provider answers\")\n(query-scope \"b\" \"person-said\" \"this Mac is the reach\")\n(query-scope \"c\" \"closed\" \"no state of the person's\")\n");
   let rows = foldl((acc, s) => acc ++ "{\"id\":\"s-" ++ s ++ "\",\"title\":\"t\",\"kind\":\"host-scope\",\"source\":\"doc.form\",\"scope\":\"" ++ s ++ "\",\"goal\":\"g\"}\n", "", ["a", "b", "c", "d"]);
   let g = ovb-write(d, "gaps.jsonl", rows);
   let r = ovb-door("scope", "{\"gaps\":\"" ++ d ++ "/gaps.jsonl\",\"root\":\"" ++ d ++ "\",\"walk\":\"\",\"register\":\"" ++ d ++ "/reg.jsonl\"" ++ ovb-clock() ++ "}");
   (Comparable) r[0] == 0 && ovb-has?(ovb-line-of(r[1], "s-a"), "s-a: open") && ovb-has?(ovb-line-of(r[1], "s-a"), "a rented provider answers") && ovb-has?(ovb-line-of(r[1], "s-b"), "s-b: closed") && ovb-has?(ovb-line-of(r[1], "s-c"), "s-c: unread") && ovb-has?(ovb-line-of(r[1], "s-d"), "s-d: unread");
  }
  def ovb-line-of(out, id) = foldl((best, l) => ovb-has?(l, "[offline-voice-gaps] " ++ id ++ ":") ? l : best, "", split-on(out, "\n"));
  def ovb-c-landings(ctx) = ovb-has?(ctx[2][1], "rent-landings-native: closed") && ovb-has?(ctx[2][1], "1 of 1 source-changing landing(s)") && ovb-has?(ctx[3][1], "0 of 6 source-changing landing(s)");
  def ovb-c-gaps(ctx) = ovb-has?(ctx[2][1], "1 of 1 gap(s) of the queue and the last 30 days' turns closed by the native lane") && ovb-has?(ctx[3][1], "0 of 5 gap(s) of the queue and the last 30 days' turns closed by the native lane");
  def ovb-c-session-share(ctx) {
   let t = ctx[2][1];
   all?(k => ovb-has?(ovb-line-of(t, "queries-native-" ++ k), k ++ ": closed") && ovb-has?(ovb-line-of(t, "queries-native-" ++ k), "1 of 1 row(s) where kind \"" ++ k ++ "\", session \"\""), ["prose", "lookup", "code", "plan", "structural"])
   && ovb-has?(ovb-line-of(t, "voice-answers"), "voice-answers: closed") && ovb-has?(ovb-line-of(t, "voice-answers"), "3 of 3 row(s) where session \"\", enquiry_kind");
  }
  def ovb-c-stood(ctx) {
   let t = ovb-line-of(ctx[2][1], "rent-landings-native");
   let f = ovb-line-of(ctx[3][1], "rent-landings-native");
   let late = ovb-line-of(ctx[4][1], "rent-landings-native");
   ovb-has?(t, "1 younger than 7 days wait") && ovb-has?(f, "held out:") && ovb-has?(f, "a line no longer stands in form/w.bml") && ovb-has?(f, "no gate's band reads form/v.bml") && ovb-has?(late, "2 of 2 source-changing landing(s)");
  }
  def ovb-c-thin(ctx) {
   let t = ctx[2][1];
   let f = ctx[3][1];
   ovb-has?(ovb-line-of(t, "q4-decode-vs-q8"), "1 row(s), holding model {\"has\":\"Q8_0\"} 1 row(s): 3580 >= 2790 in milli")
   && ovb-has?(ovb-line-of(f, "q4-decode-vs-q8"), "q4-decode-vs-q8: open") && ovb-has?(ovb-line-of(f, "q4-decode-vs-q8"), "a side has no row")
   && ovb-has?(ovb-line-of(ctx[4][1], "q4-decode-vs-q8"), "q4-decode-vs-q8: open")
   && ovb-has?(ovb-line-of(f, "queries-native-plan"), "no row") && ovb-has?(ovb-line-of(f, "guided-gap-dependence"), "gap \"g5\" stands in receipts/remote-guide-ledger.jsonl")
   && ovb-has?(ovb-line-of(f, "last-option-green"), "band_green 0 == 1")
   && ovb-has?(ovb-line-of(t, "self-turn"), "self-turn: closed") && ovb-has?(ovb-line-of(t, "self-rung"), "self-rung: closed") && ovb-has?(ovb-line-of(f, "self-rung"), "self-rung: open");
  }
  def ovb-rent-read(name, rows) {
   let g = write_file_text(ovb-dir() ++ "/rent-gaps.jsonl", "{\"id\":\"r\",\"title\":\"t\",\"goal\":\"g\",\"kind\":\"rent-week\",\"source\":\"" ++ ovb-dir() ++ "/rent-rows.jsonl\",\"days\":7,\"within_ms\":172800000,\"none_reads\":\"open\",\"compare\":\"<=\",\"threshold\":0}\n");
   let r = write_file_text(ovb-dir() ++ "/rent-rows.jsonl", rows);
   ovb-line-of(ovb-door(name, "{\"gaps\":\"" ++ ovb-dir() ++ "/rent-gaps.jsonl\",\"register\":\"" ++ ovb-dir() ++ "/rent-reg.jsonl\",\"now_ms\":" ++ ovb-now().str() ++ "}")[1], "r");
  }
  def ovb-unmetered-row() = "{\"at_unix_ms\":" ++ ovb-ago(1).str() ++ ",\"session\":\"s\",\"meter_basis\":\"usage-unavailable\",\"rented\":{\"requests\":null,\"input\":null,\"cache_write\":null,\"cache_read\":null,\"output\":null,\"transcripts\":1}}\n";
  def ovb-c-rent(ctx) = ovb-has?(ovb-rent-read("rent-unmetered", ovb-unmetered-row()), "r: unread") && ovb-has?(ovb-rent-read("rent-unmetered", ovb-unmetered-row()), "1 meter row(s) in the window read no usage") && ovb-has?(ovb-rent-read("rent-both", ovb-unmetered-row() ++ ovb-meter(ovb-ago(1), "t", 5)), "r: open") && ovb-has?(ovb-rent-read("rent-zero", ovb-meter(ovb-ago(1), "t", 0)), "r: closed") && ovb-has?(ovb-line-of(ctx[2][1], "rent-week"), "; 0 rented token(s) in the last 7 days (the 7 before: 1000)") && ovb-has?(ovb-line-of(ctx[3][1], "rent-week"), "; 500 rented token(s) in the last 7 days") && ovb-has?(ovb-line-of(ctx[3][1], "rent-week"), "rent-week: open") && ovb-has?(ovb-line-of(ctx[4][1], "rent-week"), "the meter is quiet");
  // ---- the steer, over a register of four rows ----------------------------------------------------------------------------
  def ovb-steer-gap(id, next) = "{\"id\":\"" ++ id ++ "\",\"title\":\"t\",\"kind\":\"lora\"" ++ next ++ ",\"goal\":\"g\"}\n";
  def ovb-steer-next(band) = ",\"next\":{\"band\":\"" ++ band ++ "\",\"step\":\"s-" ++ band ++ "\"}";
  def ovb-steer-row(verdicts) = "{\"at_unix_ms\":5,\"verdicts\":[" ++ str-join-with(map(v => "{\"id\":\"" ++ v[0] ++ "\",\"verdict\":\"" ++ v[1] ++ "\"}", verdicts), ",") ++ "]}\n";
  def ovb-steer-request(reg, ledger) = "{\"gaps\":\"" ++ ovb-dir() ++ "/steer-gaps.jsonl\",\"register\":\"" ++ ovb-dir() ++ "/" ++ reg ++ "\",\"ledger\":\"" ++ ovb-dir() ++ "/" ++ ledger ++ "\"}";
  def ovb-c-steer(ctx) {
   let queueBefore = file_size("learn/native-turn-queue.jsonl");
   let g = write_file_text(ovb-dir() ++ "/steer-gaps.jsonl", ovb-steer-gap("s-queue", ovb-steer-next("form/form-stdlib/tests/offline-voice-gaps-band.bml")) ++ ovb-steer-gap("s-finding", ovb-steer-next("form/form-stdlib/tests/no-such-band.bml")) ++ ovb-steer-gap("s-nothing", "") ++ ovb-steer-gap("s-closed", ovb-steer-next("form/form-stdlib/tests/offline-voice-gaps-band.bml")) ++ ovb-steer-gap("s-prose", ",\"next\":{\"band\":\"a sentence\",\"step\":\"s\"}"));
   let r = write_file_text(ovb-dir() ++ "/steer-reg.jsonl", ovb-steer-row([["s-queue", "open"], ["s-finding", "unread"], ["s-nothing", "open"], ["s-closed", "closed"], ["s-prose", "open"]]));
   let run = ovb-door-at("observe/self-steer-run.bml", "steer", ovb-steer-request("steer-reg.jsonl", "steer.jsonl"));
   let rows = fcgp-rows(ovb-dir() ++ "/steer.jsonl");
   let empty = write_file_text(ovb-dir() ++ "/steer-none.jsonl", ovb-steer-row([["s-closed", "closed"]]));
   let none = ovb-door-at("observe/self-steer-run.bml", "steer-none", ovb-steer-request("steer-none.jsonl", "steer2.jsonl"));
   let absent = ovb-door-at("observe/self-steer-run.bml", "steer-absent", ovb-steer-request("no-register.jsonl", "steer3.jsonl"));
   (Comparable) run[0] == 0 && ovb-has?(run[1], "[self-steer] offer queue s-queue (open)") && ovb-has?(run[1], "[self-steer] offer finding s-finding (unread)") && !ovb-has?(run[1], "s-nothing") && !ovb-has?(run[1], "offer queue s-closed") && !ovb-has?(run[1], "s-prose")
   && ovb-has?(run[1], "2 of 4 open row(s) offered: 1 queue, 1 finding, 500 pm")
   && (Comparable) len(rows) == 1 && (Comparable) fcgp-num(rows[0], "share_pm") == 500 && (Comparable) fcgp-num(rows[0], "queue") == 1 && (Comparable) fcgp-num(rows[0], "register_at") == 5
   && (Comparable) file_size("learn/native-turn-queue.jsonl") == queueBefore
   && ovb-has?(none[1], "0 of 0 open row(s) offered: 0 queue, 0 finding, 1000 pm")
   && (Comparable) absent[0] != 0 && ovb-has?(absent[1], "no register row in ") && (Comparable) host_path_exists(ovb-dir() ++ "/steer3.jsonl") == 0;
  }
  def ovb-make() {
   let a = hch-mkdirs(ovb-dir() ++ "/io");
   let b = hch-mkdirs(ovb-fx());
   let c = hch-mkdirs(ovb-walk() ++ "/.hearth");
   let d = hch-mkdirs(ovb-true());
   hch-mkdirs(ovb-false());
  }
  def ovb-run() {
   let swept = ovb-clean();
   let made = ovb-make();
   let written = ovb-write-fixtures();
   let w1 = ovb-write-true();
   let w2 = ovb-write-false();
   let w3 = ovb-write-exam-false();
   let w4 = ovb-write-truth();
   let ctx = [ovb-a(), ovb-b(), ovb-t(), ovb-f(), ovb-late(), ovb-exam-world(), ovb-truth-world()];
   let verdict = live-claims("offline-voice-gaps-band", ctx, [["last", 1, 1, ovb-c-last], ["unread", 2, 1, ovb-c-unread], ["tests", 4, 1, ovb-c-tests], ["share", 8, 1, ovb-c-share], ["table", 16, 1, ovb-c-table], ["slots", 32, 1, ovb-c-slots], ["summary", 64, 1, ovb-c-summary], ["refusal", 128, 1, ovb-c-refusal], ["true-world", 256, 1, ovb-c-true], ["false-world", 512, 1, ovb-c-false], ["landings", 1024, 1, ovb-c-landings], ["gaps", 2048, 1, ovb-c-gaps], ["session-share", 4096, 1, ovb-c-session-share], ["stood", 8192, 1, ovb-c-stood], ["thin", 16384, 1, ovb-c-thin], ["rent", 32768, 1, ovb-c-rent], ["steer", 65536, 1, ovb-c-steer], ["exam", 131072, 1, ovb-c-exam], ["scope", 262144, 1, ovb-c-scope], ["truth", 524288, 1, ovb-c-truth], ["held-out", 1048576, 1, ovb-c-held]]);
   let cleaned = ovb-clean();
   verdict;
  }
  // the scratch tree leaves whole: a band's worlds are git repositories
  def ovb-clean() = fs-remove-tree(ovb-dir());
 }
 ovb-run();
}
