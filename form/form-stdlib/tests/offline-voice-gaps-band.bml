  def ovb-exam-world() = ovb-door("exam", "{\"gaps\":\"" ++ ovb-exam-false() ++ "/gaps.jsonl\",\"root\":\"" ++ ovb-exam-false() ++ "\",\"walk\":\"" ++ ovb-exam-false() ++ "\",\"register\":\"" ++ ovb-dir() ++ "/exam-register.jsonl\"" ++ ovb-clock() ++ "}");
  // of four rows the schedule added, the session's reads past `where` and the undenied row too, so two count and neither answered and graded; a row of a session's alone reads no row
  def ovb-c-exam(ctx) {
