; offline-voice-gaps-band.bml — the gap register's grader, fkwu-witnessed (observe/offline-voice-gaps-run.bml).
;
; The door is spawned over a gaps file and fixture ledgers this band writes under a scratch directory it makes and removes
; (stdin: gaps, root, walk, register), so no live ledger is read and no live register row lands. Every reader shape is
; proven over fixture rows that read closed, open and unread.
;
; Expected: 255
; Verdict 255 when every claim lands:
;   1   last: the last row's field against a threshold reads closed; against another field of the row reads open
;   2   unread, never closed: a field absent, no row holding `where`, a source absent, a kind with no reader, and a
;       comparison strings do not know
;   4   share: the permille of rows holding `match` among the rows holding `where`: 500 pm reads open, 1000 pm closed;
;       a gap row with since_ms reads only the rows at or after it, and its text names the window
;   8   trend: the last `window` rows print as a series with their direction; the latest decides
;   16  table: two cells of a markdown table compared as decimals in milli, the last row of each key; a missing key is unread
;   32  walk: a source in the walk checkout reads there; with no walk checkout it reads unread
;   64  the summary counts, one register row per run with the counts and each gap's verdict, exit 0
;   128 a missing gaps file is refused by name, exit non-zero, no register row
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/host-child.bml
section [form.bml] {
 class OfflineVoiceGapsBand {
  def ovb-dir() = ".hearth/offline-voice-gaps-band";
  def ovb-fx() = ovb-dir() ++ "/fx";
  def ovb-walk() = ovb-fx() ++ "/walk";
  def ovb-register() = ovb-dir() ++ "/register.jsonl";
  def ovb-has?(hay, needle) = str_find(hay, needle, 0) >= 0;
  // ---- the fixtures: one ledger per shape, each with rows that read closed, open and unread ----------------------------
  def ovb-gap(id, kind, rest) = "{\"id\":\"" ++ id ++ "\",\"title\":\"t-" ++ id ++ "\",\"kind\":\"" ++ kind ++ "\",\"goal\":\"g-" ++ id ++ "\"," ++ rest ++ "}\n";
  def ovb-gaps() = ovb-gap("g-closed", "flow-review", "\"source\":\"flow.jsonl\",\"field\":\"open_gaps\",\"compare\":\"==\",\"threshold\":0")
   ++ ovb-gap("g-open", "alignment", "\"source\":\"align.jsonl\",\"field\":\"predicates_passed\",\"compare\":\"==\",\"against\":\"predicates_total\"")
   ++ ovb-gap("g-nofield", "readings", "\"source\":\"nofield.jsonl\",\"field\":\"open_gaps\",\"compare\":\"==\",\"threshold\":0")
   ++ ovb-gap("g-nowhere", "turn-ledger", "\"source\":\"turn.jsonl\",\"where\":{\"dry\":0},\"field\":\"band_green\",\"compare\":\"==\",\"threshold\":1")
   ++ ovb-gap("g-absent", "guide", "\"source\":\"absent.jsonl\",\"field\":\"remote_dependence\",\"compare\":\"==\",\"threshold\":\"none\"")
   ++ ovb-gap("g-share-open", "coverage", "\"source\":\"cov.jsonl\",\"where\":{\"kind\":\"lookup\"},\"match\":{\"answered\":1,\"rent_tokens\":0},\"compare\":\">=\",\"threshold\":1000")
   ++ ovb-gap("g-share-closed", "voice-availability", "\"source\":\"cov.jsonl\",\"where\":{\"kind\":\"plan\"},\"match\":{\"answered\":1,\"rent_tokens\":0},\"compare\":\">=\",\"threshold\":1000")
   ++ ovb-gap("g-trend", "rent", "\"source\":\"rent.jsonl\",\"field\":\"total_share_ppm\",\"window\":5,\"compare\":\">=\",\"threshold\":1000000")
   ++ ovb-gap("g-table-open", "plan-doc", "\"source\":\"plan.md\",\"row_key\":\"Q4_K_M\",\"against_key\":\"Q8_0\",\"column\":9,\"compare\":\">=\"")
   ++ ovb-gap("g-table-closed", "plan-doc", "\"source\":\"plan.md\",\"row_key\":\"Q8_0\",\"against_key\":\"Q4_K_M\",\"column\":9,\"compare\":\">=\"")
   ++ ovb-gap("g-table-nokey", "plan-doc", "\"source\":\"plan.md\",\"row_key\":\"Q2_K\",\"against_key\":\"Q8_0\",\"column\":9,\"compare\":\">=\"")
   ++ ovb-gap("g-walk", "walk", "\"source\":\".hearth/walk-retry.jsonl\",\"checkout\":\"walk\",\"field\":\"class\",\"compare\":\"==\",\"threshold\":\"begun\"")
   ++ ovb-gap("g-kind", "moon", "\"source\":\"flow.jsonl\",\"field\":\"open_gaps\",\"compare\":\"==\",\"threshold\":0")
   ++ ovb-gap("g-strop", "lora", "\"source\":\"walk/.hearth/walk-retry.jsonl\",\"field\":\"class\",\"compare\":\">=\",\"threshold\":\"begun\"")
   ++ ovb-gap("g-share-since", "voice-availability", "\"source\":\"cov.jsonl\",\"where\":{\"kind\":\"lookup\"},\"since_ms\":10,\"match\":{\"answered\":1,\"rent_tokens\":0},\"compare\":\">=\",\"threshold\":1000");
  def ovb-plan() = "# a plan\n\n| quant | run | wall ms | a | b | c | d | e | f | decode tok/s | g |\n|---|---|---|---|---|---|---|---|---|---|---|\n| Q4_K_M | 1 | 1 | 1 | 1 | 1 | 1 | 1 | 1 | 0.55 | 1 |\n| Q4_K_M | 2 | 1 | 1 | 1 | 1 | 1 | 1 | 1 | 0.61 | 1 |\n| Q8_0 | 1 | 1 | 1 | 1 | 1 | 1 | 1 | 1 | 2.13 | 1 |\n| Q8_0 | 2 | 1 | 1 | 1 | 1 | 1 | 1 | 1 | 2.79 | 1 |\n\nprose after the table\n";
  def ovb-write-fixtures() {
   let a = write_file_text(ovb-fx() ++ "/gaps.jsonl", ovb-gaps());
   let b = write_file_text(ovb-fx() ++ "/flow.jsonl", "{\"at_unix_ms\":1,\"open_gaps\":2}\n{\"at_unix_ms\":2,\"open_gaps\":0}\n");
   let c = write_file_text(ovb-fx() ++ "/align.jsonl", "{\"at_unix_ms\":3,\"predicates_passed\":87,\"predicates_total\":93}\n");
   let d = write_file_text(ovb-fx() ++ "/nofield.jsonl", "{\"at_unix_ms\":4,\"other\":1}\n");
   let e = write_file_text(ovb-fx() ++ "/turn.jsonl", "{\"at_unix_ms\":5,\"dry\":1,\"band_green\":1}\n");
   let f = write_file_text(ovb-fx() ++ "/cov.jsonl", "{\"at_unix_ms\":11,\"kind\":\"lookup\",\"answered\":1,\"rent_tokens\":0}\n{\"at_unix_ms\":12,\"kind\":\"lookup\",\"answered\":1,\"rent_tokens\":0}\n{\"at_unix_ms\":1,\"kind\":\"lookup\",\"answered\":1,\"rent_tokens\":5}\n{\"at_unix_ms\":2,\"kind\":\"lookup\",\"answered\":0,\"rent_tokens\":0}\n{\"kind\":\"plan\",\"answered\":1,\"rent_tokens\":0}\n{\"kind\":\"plan\",\"answered\":1,\"rent_tokens\":0}\n");
   let g = write_file_text(ovb-fx() ++ "/rent.jsonl", "{\"at_unix_ms\":1,\"total_share_ppm\":1}\n{\"at_unix_ms\":2,\"total_share_ppm\":2}\n{\"at_unix_ms\":3,\"total_share_ppm\":3}\n{\"at_unix_ms\":4,\"total_share_ppm\":4}\n{\"at_unix_ms\":5,\"total_share_ppm\":5}\n{\"at_unix_ms\":6,\"total_share_ppm\":1000000}\n");
   let h = write_file_text(ovb-fx() ++ "/plan.md", ovb-plan());
   write_file_text(ovb-walk() ++ "/.hearth/walk-retry.jsonl", "{\"at_unix_ms\":7,\"class\":\"began-then-silent\"}\n{\"at_unix_ms\":8,\"class\":\"begun\"}\n");
  }
  // ---- the door, spawned over the fixtures -------------------------------------------------------------------------------
  def ovb-door(name, request) {
   let base = ovb-dir() ++ "/" ++ name;
   let w = write_file_text(base ++ ".in", request);
   let pid = host_spawn_at(["./fkwu", "observe/offline-voice-gaps-run.bml"], [base ++ ".in", base ++ ".out", base ++ ".err"]);
   let status = pid <= 0 ? -1 : host_wait(pid);
   [status, read_file(base ++ ".out") ?? "", read_file(base ++ ".err") ?? ""];
  }
  def ovb-request(walk) = "{\"gaps\":\"" ++ ovb-fx() ++ "/gaps.jsonl\",\"root\":\"" ++ ovb-fx() ++ "\",\"walk\":\"" ++ walk ++ "\",\"register\":\"" ++ ovb-register() ++ "\"}";
  // run A reads the walk fixture as the walk checkout; run B names no walk checkout; run C names a gaps file that is not there
  def ovb-a() = ovb-door("a", ovb-request(ovb-walk()));
  def ovb-b() = ovb-door("b", ovb-request(""));
  def ovb-c() = ovb-door("c", "{\"gaps\":\"" ++ ovb-fx() ++ "/no-such-gaps.jsonl\",\"register\":\"" ++ ovb-register() ++ "\"}");
  def ovb-line(id, verdict, rest) = "[offline-voice-gaps] " ++ id ++ ": " ++ verdict ++ " — t-" ++ id ++ "; " ++ rest;
  def ovb-c-last(ctx) {
   let out = ctx[0][1];
   (Comparable) ctx[0][0] == 0
   && ovb-has?(out, ovb-line("g-closed", "closed", "open_gaps 0 == 0 (the last of 2 row(s), at 2) (flow-review " ++ ovb-fx() ++ "/flow.jsonl; serves: g-g-closed)"))
   && ovb-has?(out, ovb-line("g-open", "open", "predicates_passed 87 == predicates_total 93 (the last of 1 row(s), at 3) (alignment "));
  }
  def ovb-c-unread(ctx) {
   let out = ctx[0][1];
   ovb-has?(out, ovb-line("g-nofield", "unread", "field open_gaps absent (the last of 1 row(s), at 4) (readings "))
   && ovb-has?(out, ovb-line("g-nowhere", "unread", "no row where dry 0 among 1 row(s) (turn-ledger "))
   && ovb-has?(out, ovb-line("g-absent", "unread", "absent: " ++ ovb-fx() ++ "/absent.jsonl (guide "))
   && ovb-has?(out, ovb-line("g-kind", "unread", "kind \"moon\" has no reader (the kinds: flow-review, turn-ledger, alignment, coverage, voice-availability, rent, guide, lora, readings, walk, plan-doc) (moon "))
   && ovb-has?(out, ovb-line("g-strop", "unread", "class \"begun\" >= \"begun\" (the last of 2 row(s), at 8); comparison \">=\" unknown (lora "))
   && !ovb-has?(out, "g-nofield: closed") && !ovb-has?(out, "g-nowhere: closed") && !ovb-has?(out, "g-absent: closed") && !ovb-has?(out, "g-kind: closed") && !ovb-has?(out, "g-strop: closed");
  }
  def ovb-c-share(ctx) {
   let out = ctx[0][1];
   ovb-has?(out, ovb-line("g-share-open", "open", "2 of 4 row(s) where kind \"lookup\" hold answered 1, rent_tokens 0: 500 pm >= 1000 (coverage "))
   && ovb-has?(out, ovb-line("g-share-closed", "closed", "2 of 2 row(s) where kind \"plan\" hold answered 1, rent_tokens 0: 1000 pm >= 1000 (voice-availability "))
   && ovb-has?(out, ovb-line("g-share-since", "closed", "2 of 2 row(s) where kind \"lookup\" since 10 hold answered 1, rent_tokens 0: 1000 pm >= 1000 (voice-availability "));
  }
  def ovb-c-trend(ctx) = ovb-has?(ctx[0][1], ovb-line("g-trend", "closed", "total_share_ppm over the last 5 of 6 row(s): 2, 3, 4, 5, 1000000 (rising); latest 1000000 >= 1000000, at 6 (rent "));
  def ovb-c-table(ctx) {
   let out = ctx[0][1];
   ovb-has?(out, ovb-line("g-table-open", "open", "Q4_K_M column 9 reads 0.61 against Q8_0 2.79: 610 >= 2790 in milli (the last table row of each key) (plan-doc "))
   && ovb-has?(out, ovb-line("g-table-closed", "closed", "Q8_0 column 9 reads 2.79 against Q4_K_M 0.61: 2790 >= 610 in milli (the last table row of each key) (plan-doc "))
   && ovb-has?(out, ovb-line("g-table-nokey", "unread", "no table row keyed Q2_K among 6 table row(s) (plan-doc "));
  }
  def ovb-c-walk(ctx) {
   ovb-has?(ctx[0][1], ovb-line("g-walk", "closed", "class \"begun\" == \"begun\" (the last of 2 row(s), at 8) (walk " ++ ovb-walk() ++ "/.hearth/walk-retry.jsonl; serves: g-g-walk)"))
   && (Comparable) ctx[1][0] == 0
   && ovb-has?(ctx[1][1], ovb-line("g-walk", "unread", "no walk checkout: the day-turn plist names none (walk walk:.hearth/walk-retry.jsonl; serves: g-g-walk)"));
  }
  def ovb-c-summary(ctx) {
   let reg = read_file(ovb-register()) ?? "";
   ovb-has?(ctx[0][1], "[offline-voice-gaps] summary: 15 gap(s): closed 6, open 3, unread 6; register " ++ ovb-register() ++ " appended\n")
   && ovb-has?(ctx[1][1], "[offline-voice-gaps] summary: 15 gap(s): closed 5, open 3, unread 7; register " ++ ovb-register() ++ " appended\n")
   && (Comparable) len(filter(l => len(l) > 0, split-on(reg, "\n"))) == 2
   && ovb-has?(reg, "\"gaps_file\":\"" ++ ovb-fx() ++ "/gaps.jsonl\",\"gaps\":15,\"closed\":6,\"open\":3,\"unread\":6,\"verdicts\":[{\"id\":\"g-closed\",\"kind\":\"flow-review\",\"verdict\":\"closed\",\"observation\":\"open_gaps 0 == 0 (the last of 2 row(s), at 2)\",\"source\":\"" ++ ovb-fx() ++ "/flow.jsonl\",\"goal\":\"g-g-closed\"}")
   && ovb-has?(reg, "\"gaps\":15,\"closed\":5,\"open\":3,\"unread\":7,")
   && ovb-has?(reg, "{\"id\":\"g-walk\",\"kind\":\"walk\",\"verdict\":\"unread\",\"observation\":\"no walk checkout: the day-turn plist names none\",\"source\":\"walk:.hearth/walk-retry.jsonl\"");
  }
  def ovb-c-refusal(ctx) {
   let before = read_file(ovb-register()) ?? "";
   let r = ovb-c();
   let after = read_file(ovb-register()) ?? "";
   (Comparable) r[0] != 0 && ovb-has?(r[1], "offline-voice-gaps: no gaps file at " ++ ovb-fx() ++ "/no-such-gaps.jsonl") && (Comparable) len(before) == len(after);
  }
  def ovb-make() {
   let a = fs_mkdir(ovb-dir());
   let b = fs_mkdir(ovb-fx());
   let c = fs_mkdir(ovb-walk());
   fs_mkdir(ovb-walk() ++ "/.hearth");
  }
  def ovb-clean() {
   let fx = ["gaps.jsonl", "flow.jsonl", "align.jsonl", "nofield.jsonl", "turn.jsonl", "cov.jsonl", "rent.jsonl", "plan.md"] |> map(n => host_path_remove(ovb-fx() ++ "/" ++ n));
   let w = host_path_remove(ovb-walk() ++ "/.hearth/walk-retry.jsonl");
   let runs = ["a.in", "a.out", "a.err", "b.in", "b.out", "b.err", "c.in", "c.out", "c.err", "register.jsonl"] |> map(n => host_path_remove(ovb-dir() ++ "/" ++ n));
   let d1 = fs_rmdir(ovb-walk() ++ "/.hearth");
   let d2 = fs_rmdir(ovb-walk());
   let d3 = fs_rmdir(ovb-fx());
   fs_rmdir(ovb-dir());
  }
  def ovb-run() {
   let made = ovb-make();
   let written = ovb-write-fixtures();
   let ctx = [ovb-a(), ovb-b()];
   let verdict = live-claims("offline-voice-gaps-band", ctx, [["last", 1, 1, ovb-c-last], ["unread", 2, 1, ovb-c-unread], ["share", 4, 1, ovb-c-share], ["trend", 8, 1, ovb-c-trend], ["table", 16, 1, ovb-c-table], ["walk", 32, 1, ovb-c-walk], ["summary", 64, 1, ovb-c-summary], ["refusal", 128, 1, ovb-c-refusal]]);
   let cleaned = ovb-clean();
   verdict;
  }
 }
 ovb-run();
}
