  def ovb-held-row(at, digest, scenarios, passed, role, adapter, ground) = "{\"at_unix_ms\":" ++ at.str() ++ ",\"model\":\"qwen38-q8\",\"prompt_digest\":\"" ++ digest ++ "\",\"fixtures\":\"" ++ fcgp-str(ovb-held(), "fixtures") ++ "\",\"scenarios\":" ++ scenarios.str() ++ ",\"predicates_total\":56,\"predicates_passed\":" ++ passed.str() ++ ",\"role\":\"" ++ role ++ "\",\"adapter\":\"" ++ adapter ++ "\"" ++ ((String) ground == "" ? "" : ",\"ground\":\"" ++ ground ++ "\"") ++ "}\n";
