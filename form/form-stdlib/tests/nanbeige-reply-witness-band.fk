; preludes: form-stdlib/core.fk form-stdlib/nanbeige-gguf-admission.fk form-stdlib/nanbeige-reply-witness.fk

(do
    (let exact
        (nbrw-verify?
            (nbga-revision) (nbga-size) (nbga-sha)
            (nbga-runtime-revision) "exact-42-v1" "42"))
    (let wrong-reply
        (nbrw-verify?
            (nbga-revision) (nbga-size) (nbga-sha)
            (nbga-runtime-revision) "exact-42-v1" "41"))
    (let wrong-runtime
        (nbrw-verify?
            (nbga-revision) (nbga-size) (nbga-sha)
            "drift" "exact-42-v1" "42"))
    (add
        (if (eq exact 1) 1 0)
        (add
            (if (eq wrong-reply 0) 2 0)
            (if (eq wrong-runtime 0) 4 0))))
