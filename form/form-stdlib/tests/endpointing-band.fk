; preludes: form-stdlib/core.fk form-stdlib/trig.fk form-stdlib/endpointing.fk form-stdlib/nearest-shape.fk form-stdlib/turn-taking.fk
;
; endpointing-band — the organ that makes turn-taking.fk's `pause`, proven four-way.
;
; Floats reduce to integers via round (×1000 / ×10000 where the decimals carry the claim), the trig-band
; posture, so last-bit display never touches the proof. Every pin is a value that only the right
; arithmetic produces: no assertion lands on 0, and the release claim is chosen so the attack path would
; give a visibly different number.
;
; The frame run is a real shape: 20 frames of speech then 40 frames of silence at 80ms each, half-lives
; 0.24s (three frames), warmup 12 — unmute's own drop count.
;
; Verdict 65535 when every claim lands:
;   1     one half-life of step moves the estimate exactly halfway      (alpha at dt = hl → 0.500)
;   2     ATTACK path: a rising reading blends at the attack half-life  (0.25 → 0.625 in one step)
;   4     RELEASE path is a DIFFERENT path, not the same constant twice (1.0 → 0.8409; attack → 0.5000)
;   8     warmup DROPS readings rather than blending them              (three 1.0s leave 0.25 at 0.25)
;   16    the seconds inversion is exact at one half-life              (held 0.5, attack 0.01 → 0.0100 s)
;   32    …and at two                                                  (held 0.75          → 0.0200 s)
;   64    a saturated estimate reports a CEILING, never an infinity    (held 1.0 → 64 half-lives = 0.64 s)
;   128   turn-over reads 1 above the upper floor                      (0.7 > 0.6)
;   256   turn-over reads 0 INSIDE the band — not merely below it      (0.5 is above 0.4 and still "no")
;   512   barge-in reads 1 below the lower floor while speaking        (0.3 < 0.4)
;   1024  barge-in reads 0 inside the band while speaking              (0.5: the band is what stops chopping)
;   2048  barge-in reads 0 when the agent is NOT speaking              (nothing to interrupt)
;   4096  the readout is EXACT: 40 frames × 80ms of silence adds 3.200 s to the reported pause, to the
;         millisecond — the inversion recovers real time, it does not approximate it
;   8192  THE COMPOSITION: the organ's pause turns turn-taking.fk's answer from stay to speak, on the
;         same learned context that said stay one frame-run earlier. This is the hole closing —
;         tt-speak? asked for a number nothing in the body made, and now something makes it.
;   16384 ep-pause-run counts only the run STILL OPEN: readings [1 1 0 1] are one quiet frame, not
;         three. A pause already answered cannot decide whether it is the agent's turn now.
;   32768 the two estimators on ONE input, and the seam between them pinned rather than papered over.
;         Real audio never reads a clean 1.0 — a quiet room reads 0.96 — and an EMA fed a constant r
;         converges to r, not to 1. So on 3 speech frames + 41 quiet frames at 0.97: ep-pause-run says
;         3.280 s, which is the truth, and ep-pause-seconds says 1.214 s, which is the inversion
;         believing its own assumption. Both numbers are asserted here. Bit 4096 above is exact
;         BECAUSE its readings are a clean 1.0; this bit is why that exactness is not the general case,
;         and it was found by pointing the organ at a rendered clip instead of at its own band.
(do
    ; a run of `n` identical readings, and concatenation — the band's own small helpers.
    (defn epb-rep (v n) (if (le n 0) (list) (cons v (epb-rep v (sub n 1)))))
    (defn epb-cat (a b) (if (eq (len a) 0) b (cons (head a) (epb-cat (tail a) b))))

    (let dt 0.08)
    (let hl 0.24)
    (let speech (epb-rep 0.0 20))
    (let silence (epb-rep 1.0 40))

    (let c0 (if (eq (round (mul (ep-alpha 0.01 0.01) 1000)) 500) 1 0))
    (let c1 (if (eq (round (mul (ep-step 0.25 1.0 0.01 0.01 0.04) 1000)) 625) 2 0))
    (let c2 (if (eq (round (mul (ep-step 1.0 0.0 0.01 0.01 0.04) 10000)) 8409) 4 0))
    (let c3 (if (eq (round (mul (ep-fold 0.25 (epb-rep 1.0 3) 0.01 0.01 0.04 3) 1000)) 250) 8 0))
    (let c4 (if (eq (round (mul (ep-pause-seconds 0.5 0.01) 10000)) 100) 16 0))
    (let c5 (if (eq (round (mul (ep-pause-seconds 0.75 0.01) 10000)) 200) 32 0))
    (let c6 (if (eq (round (mul (ep-pause-seconds 1.0 0.01) 100)) 64) 64 0))
    (let c7 (if (eq (ep-turn-over? 0.7) 1) 128 0))
    (let c8 (if (eq (ep-turn-over? 0.5) 0) 256 0))
    (let c9 (if (eq (ep-barge-in? 0.3 1) 1) 512 0))
    (let c10 (if (eq (ep-barge-in? 0.5 1) 0) 1024 0))
    (let c11 (if (eq (ep-barge-in? 0.3 0) 0) 2048 0))

    ; the held estimate the speech run leaves behind, and what 40 frames of silence add to it.
    (let held-after-speech (ep-fold 1.0 speech dt hl hl 12))
    (let held-after-silence (ep-fold held-after-speech silence dt hl hl 0))
    (let pause-before (ep-pause-seconds held-after-speech hl))
    (let pause-after (ep-pause-seconds held-after-silence hl))
    (let c12 (if (eq (round (mul (sub pause-after pause-before) 1000)) 3200) 4096 0))

    ; the composition — the same learned context and the same floors turn-taking-band uses.
    (let ctx-speak (list 3 5 4))
    (let learned (list (list "speak" (list 3 5 4)) (list "stay" (list 0 0 0))))
    (let c13 (if (eq (tt-speak? 0 0 ctx-speak learned 2 pause-before 3.0) 0)
                 (if (eq (tt-speak? 0 0 ctx-speak learned 2 pause-after 3.0) 1) 8192 0)
                 0))

    ; the duration estimator, and the seam between it and the inversion.
    (let c14 (if (eq (round (mul (ep-pause-run (list 1.0 1.0 0.0 1.0) 0.08) 1000)) 80) 16384 0))
    (let frac (ep-fold 1.0 (epb-cat (epb-rep 0.0 3) (epb-rep 0.97 41)) 0.08 0.24 0.24 0))
    (let c15 (if (eq (round (mul (ep-pause-run (epb-cat (epb-rep 0.0 3) (epb-rep 0.97 41)) 0.08) 1000)) 3280)
                (if (eq (round (mul (ep-pause-seconds frac 0.24) 1000)) 1214) 32768 0)
                0))

    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7
    (add c8 (add c9 (add c10 (add c11 (add c12 (add c13 (add c14 c15))))))))))))))))
