; lora-numbers-band.fk — the body decodes and encodes float32 exactly, computes
; a low-rank delta, and writes an adapter file it reads back whole (LoraWriter).
; Expected: 63
;   1 decode known bit patterns   2 encode is the inverse   4 a delta B(A x)
;   8 a written adapter reads back: census pairs/rank/dtype/whole
;   16 its floats read back exactly   32 a wrong offset answers nothing/empty
; preludes: form/form-stdlib/lora-adapter.bml
(do
    (defn lnb-bit (ok bit) (if ok bit 0))
    (defn lnb-close? (a b) (lt (abs (sub a b)) 0.000001))
    (defn lnb-path () (fs-path-join (fs-temp-dir) "lora-numbers-band.safetensors"))
    (defn lnb-ts () (list (list "model.layers.0.self_attn.q_proj.lora_a" (list 2 2) (list 1.0 0.5 -2.0 3.0)) (list "model.layers.0.self_attn.q_proj.lora_b" (list 2 2) (list 0.25 0.0 1.5 -1.0))))
    (let size (ln-write (lnb-path) (lnb-ts)))
    (let census (la-census (lnb-path)))
    (let h (la-header (lnb-path)))
    (let a (ln-floats (lnb-path) (la-header-len (lnb-path)) (ln-tensor-begin h "model.layers.0.self_attn.q_proj.lora_a") 4))
    (let b (ln-floats (lnb-path) (la-header-len (lnb-path)) (ln-tensor-begin h "model.layers.0.self_attn.q_proj.lora_b") 4))
    (sum (list
        (lnb-bit (and (lnb-close? (ln-f32-decode 1065353216) 1.0) (and (lnb-close? (ln-f32-decode 3221225472) -2.0) (and (lnb-close? (ln-f32-decode 1056964608) 0.5) (lnb-close? (ln-f32-decode 0) 0.0)))) 1)
        (lnb-bit (and (eq (ln-f32-encode 1.0) 1065353216) (and (eq (ln-f32-encode -2.0) 3221225472) (and (eq (ln-f32-encode 0.5) 1056964608) (eq (ln-f32-encode 3.0) 1077936128)))) 2)
        (lnb-bit (lnb-close? (ln-dot (list 1.0 0.5) (list 2.0 4.0)) 4.0) 4)
        (lnb-bit (and (eq (nth census 1) 1) (and (eq (nth census 2) 2) (and (str_eq (nth census 3) "f32") (eq (nth census 7) 1)))) 8)
        (lnb-bit (and (eq (len a) 4) (and (lnb-close? (nth a 2) -2.0) (and (lnb-close? (nth a 3) 3.0) (lnb-close? (nth b 3) -1.0)))) 16)
        (lnb-bit (eq (len (ln-floats (lnb-path) (la-header-len (lnb-path)) 999999 4)) 0) 32))))
