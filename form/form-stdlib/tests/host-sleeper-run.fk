// host-sleeper-run.fk — a Form child that only waits: the live process the host-door bands signal.
//
// It touches nothing and prints nothing. It sleeps thirty seconds and leaves, so a band that forgets it costs
// thirty seconds, not a process that outlives the run. voice-track-reap-band, gpu-lease-band and host-signal-band
// spawn it (host_spawn_at ["./fkwu", this cell]); host-napper-run.fk is the one that leaves on its own in a second.
//
// preflight-exec: forbidden
section [form.bml] {
  let slept = host_sleep_ms(30000);
  0;
}
