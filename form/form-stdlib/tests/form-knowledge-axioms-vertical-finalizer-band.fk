; form-knowledge-axioms-vertical-finalizer-band.fk -- bounded vertical proof.
;
; Expected: 2147483647
; These are synthetic executable fixtures.  They open no model or carrier and
; create no physical mastery credit.  They prove only that the one-family
; finalizer admits the exact four-axis shape and refuses replay/relabeling.
;
; preludes: form-stdlib/form-knowledge-axioms-vertical-finalizer.fk

(do
    (defn fkavb-bit (ok bit) (if ok bit 0))
    (defn fkavb-model-id () "synthetic-local-axioms-fixture")
    (defn fkavb-run-id () (nmfe-sha256 "synthetic-axioms-vertical-run"))
    (defn fkavb-session-id ()
        (fkp30-session-id-for (fkavb-run-id) (fkavb-model-id)))
    (defn fkavb-row ()
        (fkpfm-heldout-row-for-family (fkav-family) (fkhe-rows)))
    (defn fkavb-presentation (lane) (fkp30-presentation (fkavb-row) lane))
    (defn fkavb-raw (presentation)
        (fgsg-cat (list
            "choice-task=knowledge\nchoice-match=1\n"
            "backend=synthetic-fixture-no-carrier\n"
            "generated_tokens=20\nforward_passes=21\ntext:\n"
            (fkqt-open) "public axioms fixture:"
            (fkp30-presentation-trial-id presentation) (fkqt-close)
            (fkhe-expected (fkavb-row)))))
    (defn fkavb-trial-with
        (presentation raw model-id run-id remote executed released same generated)
        (do
            (let score (fkhe-score (fkavb-row)
                (fqt-knowledge-prompt (fkhe-prompt (fkavb-row)))
                (fkhe-parse-resident-output raw) 7))
            (let observation (fkhe-score-observation score))
            (let error (nmfe-obs-error observation))
            (let present (if (eq error 0) 1 0))
            (let zero (if (and (eq present 1)
                (str_eq (nth score 8) (nmfe-sha256 "0"))) 1 0))
            (let one (if (and (eq present 1)
                (str_eq (nth score 8) (nmfe-sha256 "1"))) 1 0))
            (let session-id (fkp30-session-id-for run-id model-id))
            (let nonce (fkp30-trial-nonce-for run-id session-id presentation))
            (fkp30-trial presentation score model-id run-id session-id raw
                (nmfe-sha256 raw) nonce (fkp30-content-sha-for nonce raw)
                1 remote executed released same
                (if (eq present 1) "value" "nothing") present zero one
                12 8 generated 1 0 0 0 0 7)))
    (defn fkavb-trial (lane)
        (do
            (let presentation (fkavb-presentation lane))
            (fkavb-trial-with presentation (fkavb-raw presentation)
                (fkavb-model-id) (fkavb-run-id) 0 1 1 1 20)))

    (defn fkavb-bml (family)
        (fgsg-cat (list "int Lift(int n) { return n + "
            (int_to_str (fkpfm-family-ordinal family))
            "; }\nreturn Lift(65);")))
    (defn fkavb-bmf ()
        "grammar {\n  rule atmark { lit @ }\n  rule vowel { class ae }\n  rule markedvowel { seq atmark vowel }\n  rule entrance { alt vowel markedvowel }\n  top entrance\n  probe @a\n}")
    (defn fkavb-form (family)
        (do
            (let c (fkpfm-family-exec-challenge family))
            (fgsg-control-canonical
                (fgsg-cat (list "<|form:recipe-exec|>"
                    (frex-node-coordinate (frex-recipe)) ";input="
                    (int_to_str (fgsg-challenge-input c))
                    ";carrier=auto<|/form:recipe-exec|>"))
                "nothing,timeout,zero" "one"
                (int_to_str (fgsg-challenge-checkpoint c))
                (int_to_str (fgsg-challenge-timeout-budget c))
                (fgsg-challenge-plane c)
                (int_to_str (fgsg-challenge-heat c))
                (int_to_str (fgsg-challenge-pure c)))))
    (defn fkavb-candidate (family)
        (fgsg-candidate (fkavb-bml family) (fkavb-bmf) (fkavb-form family)))
    (defn fkavb-raw-candidate (candidate)
        (fgsg-cat (list
            "<BML>" (fgsg-candidate-bml candidate) "</BML>"
            "<BMF>" (fgsg-candidate-bmf candidate) "</BMF>"
            "<FORM>" (fgsg-candidate-form candidate) "</FORM>")))
    (defn fkavb-generative-with (family model-id run-id)
        (do
            (let candidate (fkavb-candidate family))
            (let raw (fkavb-raw-candidate candidate))
            (let receipt (fkpfm-generative-receipt family
                model-id run-id raw candidate))
            (fkpfm-generative-evidence family model-id receipt raw
                candidate 1 0 1)))
    (defn fkavb-generative (family)
        (fkavb-generative-with family (fkavb-model-id) (fkavb-run-id)))

    (defn fkavb-native-result (family)
        (do
            (let request (frex-parse (frex-surface (frex-recipe)
                (fkpfm-family-native-input family) "metal")))
            (let input (fkpfm-family-native-input family))
            (let value (add (mul 3 input) 7))
            (let base (frex-choice request
                (list (frex-offer "metal" "value" value
                    "synthetic-native-fixture"))))
            (frex-result-with-flags "value" (frex-result-reason base)
                request "metal" value 1 (frex-result-trace base)
                (frex-result-attempts base) 1 0 1)))
    (defn fkavb-execution-with (family model-id run-id)
        (do
            (let result (fkavb-native-result family))
            (let raw (fkpfm-native-request-bytes family result))
            (let receipt (fkpfm-execution-receipt family
                model-id run-id raw result))
            (fkpfm-execution-evidence family model-id receipt raw
                1 0 1 result)))
    (defn fkavb-execution (family)
        (fkavb-execution-with family (fkavb-model-id) (fkavb-run-id)))
    (defn fkavb-set-nth (xs index value)
        (if (eq (len xs) 0) (list)
            (if (eq index 0) (cons value (tail xs))
                (cons (head xs)
                    (fkavb-set-nth (tail xs) (sub index 1) value)))))

    (defn fkavb-run ()
        (do
            (let a (fkavb-trial "a"))
            (let b (fkavb-trial "b"))
            (let trials (list a b))
            (let generative (fkavb-generative (fkav-family)))
            (let execution (fkavb-execution (fkav-family)))
            (let result (fkav-result trials generative execution))
            (let missing (fkav-result (nothing) generative execution))
            (let present-invalid (fkav-result trials (list "invalid") execution))
            (let replay-b (fkavb-trial-with (fkavb-presentation "b")
                (fkp30-trial-raw-output a) (fkavb-model-id) (fkavb-run-id)
                0 1 1 1 20))
            (let remote-b (fkavb-trial-with (fkavb-presentation "b")
                (fkavb-raw (fkavb-presentation "b"))
                (fkavb-model-id) (fkavb-run-id) 1 1 1 1 20))
            (let unexecuted-b (fkavb-trial-with (fkavb-presentation "b")
                (fkavb-raw (fkavb-presentation "b"))
                (fkavb-model-id) (fkavb-run-id) 0 0 1 1 20))
            (let unreleased-b (fkavb-trial-with (fkavb-presentation "b")
                (fkavb-raw (fkavb-presentation "b"))
                (fkavb-model-id) (fkavb-run-id) 0 1 0 1 20))
            (let no-tokens-b (fkavb-trial-with (fkavb-presentation "b")
                (fkavb-raw (fkavb-presentation "b"))
                (fkavb-model-id) (fkavb-run-id) 0 1 1 1 0))
            (let other-run (nmfe-sha256 "other-synthetic-axioms-run"))
            (let other-run-b (fkavb-trial-with (fkavb-presentation "b")
                (fkavb-raw (fkavb-presentation "b"))
                (fkavb-model-id) other-run 0 1 1 1 20))
            (let wrong-family-gen (fkavb-generative "bootstrap"))
            (let wrong-family-exec (fkavb-execution "bootstrap"))
            (let changed-raw-gen (fkavb-set-nth generative 14
                (str_concat (nth generative 14) "changed")))
            (let other-model-gen (fkavb-generative-with (fkav-family)
                "other-valid-local-model" (fkavb-run-id)))
            (let other-model-result
                (fkav-result trials other-model-gen execution))
            (let other-run-exec (fkavb-execution-with (fkav-family)
                (fkavb-model-id) other-run))
            (let other-run-result
                (fkav-result trials generative other-run-exec))
            (let tampered-result (fkavb-set-nth result 18
                (nmfe-sha256 "tampered-result")))
            (let scalar-trials (list 0 1))
            (let short-trials (list (list "short-trial") b))
            (let scalar-trials-result
                (fkav-result scalar-trials generative execution))
            (let malformed-nested-result
                (fkavb-set-nth result 4 short-trials))
            (sum (list
                (fkavb-bit (str_eq (fkav-family) "axioms") 1)
                (fkavb-bit (and (eq (fkp30-trial-valid? a) 1)
                    (eq (fkp30-trial-valid? b) 1)) 2)
                (fkavb-bit (eq (fkav-resident-valid? trials) 1) 4)
                (fkavb-bit (eq (fkpfm-generative-valid? generative) 1) 8)
                (fkavb-bit (eq (fkpfm-execution-valid? execution) 1) 16)
                (fkavb-bit (eq (fkav-result-valid? result) 1) 32)
                (fkavb-bit (eq (fkav-result-present? result) 1) 64)
                (fkavb-bit (eq (fkav-result-complete? result) 1) 128)
                (fkavb-bit (eq (fkav-result-ready? result) 1) 256)
                (fkavb-bit (and (nothing? (nth missing 7))
                    (and (nothing? (fkav-result-complete? missing))
                         (nothing? (fkav-result-ready? missing)))) 512)
                (fkavb-bit (and (eq (fkav-result-present? present-invalid) 1)
                    (and (eq (fkav-result-complete? present-invalid) 0)
                         (eq (fkav-result-ready? present-invalid) 0))) 1024)
                (fkavb-bit (eq (fkav-resident-valid? (list a replay-b)) 0) 2048)
                (fkavb-bit (eq (fkav-resident-valid? (list a remote-b)) 0) 4096)
                (fkavb-bit (eq (fkav-resident-valid? (list a unexecuted-b)) 0)
                    8192)
                (fkavb-bit (eq (fkav-resident-valid? (list a unreleased-b)) 0)
                    16384)
                (fkavb-bit (eq (fkav-resident-valid? (list a no-tokens-b)) 0)
                    32768)
                (fkavb-bit (eq (fkav-resident-valid? (list a other-run-b)) 0)
                    65536)
                (fkavb-bit (eq (fkav-resident-valid? (list a a)) 0) 131072)
                (fkavb-bit (eq (fkav-generative-valid? wrong-family-gen) 0)
                    262144)
                (fkavb-bit (eq (fkav-execution-valid? wrong-family-exec) 0)
                    524288)
                (fkavb-bit (eq (fkav-generative-valid? changed-raw-gen) 0)
                    1048576)
                (fkavb-bit (eq (fkav-result-valid? tampered-result) 0) 2097152)
                (fkavb-bit (and (str_eq (nth result 15)
                    (fkpfm-family-source-sha (fkav-family)))
                    (and (str_eq (nth result 16)
                        (fkpfm-family-challenge-sha (fkav-family)))
                         (str_eq (nth result 17)
                            (fkpfm-family-exec-challenge-sha
                                (fkav-family))))) 4194304)
                (fkavb-bit (and (eq (fkpfm-family-total)
                                    (len (fkpfm-family-ids)))
                    (not (str_eq (fkav-basis) (fkpfm-basis)))) 8388608)
                (fkavb-bit (eq (fkav-result-correlated? result) 1) 16777216)
                (fkavb-bit (and (eq (fkpfm-generative-valid?
                                        other-model-gen) 1)
                    (and (eq (fkav-result-present? other-model-result) 1)
                    (and (eq (fkav-result-correlated? other-model-result) 0)
                    (and (eq (fkav-result-complete? other-model-result) 0)
                         (eq (fkav-result-ready? other-model-result) 0)))))
                    33554432)
                (fkavb-bit (and (eq (fkpfm-execution-valid?
                                        other-run-exec) 1)
                    (and (eq (fkav-result-present? other-run-result) 1)
                    (and (eq (fkav-result-correlated? other-run-result) 0)
                    (and (eq (fkav-result-complete? other-run-result) 0)
                         (eq (fkav-result-ready? other-run-result) 0)))))
                    67108864)
                (fkavb-bit (and
                    (eq (fkav-trial-strong-valid? 0 "a") 0)
                    (and (eq (fkav-trial-strong-valid?
                                (list "short-trial") "a") 0)
                         (eq (fkav-resident-valid? scalar-trials) 0)))
                    134217728)
                (fkavb-bit (and (eq (fkav-resident-valid? short-trials) 0)
                    (and (eq (fkav-result-present? scalar-trials-result) 1)
                    (and (eq (fkav-result-complete? scalar-trials-result) 0)
                         (eq (fkav-result-ready? scalar-trials-result) 0))))
                    268435456)
                (fkavb-bit (and
                    (eq (fkav-result-valid? (list "short-result")) 0)
                    (eq (fkav-result-valid? malformed-nested-result) 0))
                    536870912)
                (fkavb-bit (and
                    (lt (str_find (fkp30-trial-raw-output unreleased-b)
                                  "state handle close mismatch" 0) 0)
                    (and (eq (fkp30-trial-state-released unreleased-b) 0)
                         (eq (fkav-trial-strong-valid? unreleased-b "b") 0)))
                    1073741824)))))
    (fkavb-run))
