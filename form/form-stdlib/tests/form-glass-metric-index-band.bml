// Frame-local metric index: exact keys, first-row precedence, immutable snapshots.
// No live state, sensor publication, or renderer is opened by this band.
// preludes: form/form-stdlib/form-glass-dashboard.bml
section [form.bml] {
    class FormGlassMetricIndexBand {
        def fgmi-row(id, value) = list("metric", "kernel", id, value);
        def fgmi-value(index, id) = nth(fgd-index-find(index, id), 3);
        def fgmi-rows(i, n) = if (i >= n) then list() else cons(fgmi-row(str_concat("dynamic.metric.", int_to_str(i)), i), fgmi-rows((i + 1), n));
        def fgmi-agree(index, rows, rest) = if ((Comparable) len(rest) == 0) then 1 else if ((Comparable) fgmi-value(index, fgo-id(head(rest))) == nth(fgd-find-metric(rows, fgo-id(head(rest))), 3)) then fgmi-agree(index, rows, tail(rest)) else 0;
        def fgmi-score(ok, bit) = if ok then bit else 0;
        def fgmi-total(scores) = if ((Comparable) len(scores) == 0) then 0 else (head(scores) + fgmi-total(tail(scores)));
        def fgmi-band() {
            let emptyIndex = fgd-metric-index(list());
            let rows = list(fgmi-row("first", 1), fgmi-row("guabx", 11), fgmi-row("naaeaa", 22), fgmi-row("first", 99), fgmi-row("", 7), fgmi-row("صدا.日本語", 8));
            let index = fgd-metric-index(rows);
            let next = fgd-metric-index(list(fgmi-row("first", 2)));
            let extended = fgd-metric-index-put(index, fgmi-row("new", 3));
            let replaced = fgd-metric-index-put(index, fgmi-row("first", 4));
            let manyRows = fgmi-rows(0, 1024);
            let many = fgd-metric-index(manyRows);
            let malformed = fgd-metric-index(list(list(), list("short"), list("short", "row"), fgmi-row("valid", 5)));
            let removed = fgd-metric-index(list(fgmi-row("new", 6)));
            fgmi-total(list(
                fgmi-score((((Comparable) len(emptyIndex) == 3) && ((Comparable) len(fgd-index-find(emptyIndex, "absent")) == 0)), 1),
                fgmi-score(((Comparable) len(index) == 3), 2),
                fgmi-score(((Comparable) fgmi-value(index, "first") == 1), 4),
                fgmi-score(((Comparable) len(fgd-index-find(index, "absent")) == 0), 8),
                fgmi-score((((Comparable) km-hash-string("guabx") == km-hash-string("naaeaa")) && (((Comparable) fgmi-value(index, "guabx") == 11) && ((Comparable) fgmi-value(index, "naaeaa") == 22))), 16),
                fgmi-score(((Comparable) fgmi-value(index, "") == 7), 32),
                fgmi-score(((Comparable) fgmi-value(index, "صدا.日本語") == 8), 64),
                fgmi-score(fgmi-agree(index, rows, rows), 128),
                fgmi-score((((Comparable) fgmi-value(next, "first") == 2) && ((Comparable) fgmi-value(index, "first") == 1)), 256),
                fgmi-score((((Comparable) fgmi-value(extended, "new") == 3) && ((Comparable) len(fgd-index-find(index, "new")) == 0)), 512),
                fgmi-score(((Comparable) fgmi-value(replaced, "first") == 1), 1024),
                fgmi-score((((Comparable) km-size(malformed) == 1) && ((Comparable) fgmi-value(malformed, "valid") == 5)), 2048),
                fgmi-score(fgmi-agree(many, manyRows, manyRows), 4096),
                fgmi-score((((Comparable) km-size(many) == 1024) && (km-maxbucket(many) <= 8)), 8192),
                fgmi-score((((Comparable) len(fgd-index-find(removed, "first")) == 0) && ((Comparable) fgmi-value(removed, "new") == 6)), 16384),
                fgmi-score((((Comparable) km-size(index) == 5) && ((Comparable) km-size(emptyIndex) == 0)), 32768)));
        }
    }
}
