; iq3xxs-dequant-band.fk — exact type-18 carver against pinned ggml b10686.
;
; preludes: form-stdlib/core.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/iq2xxs-dequant.fk form-stdlib/iq3xxs-layout.bml form-stdlib/iq3xxs-dequant.fk
; Independent oracle: tests/iq3xxs-ggml-oracle.c. Verdict 127.

(do
    (defn iq3xb-aux (ib)
        (add (mul (iq3x-mod (add (mul 3 ib) 1) 16) (iq3x-pow2 28))
        (add (mul (iq3x-mod (mul 11 ib) 128) (iq3x-pow2 0))
        (add (mul (iq3x-mod (add (mul 11 ib) 17) 128) (iq3x-pow2 7))
        (add (mul (iq3x-mod (add (mul 11 ib) 34) 128) (iq3x-pow2 14))
             (mul (iq3x-mod (add (mul 11 ib) 51) 128) (iq3x-pow2 21)))))))
    (defn iq3xb-byte (i)
        (if (eq i 0) 0
        (if (eq i 1) 60
        (if (lt i 66) (iq3x-mod (add (mul 13 (sub i 2)) 7) 256)
            (do (let q (sub i 66))
                (iq3x-mod (div (iq3xb-aux (div q 4)) (iq3x-pow2 (mul 8 (iq3x-mod q 4)))) 256))))))
    (defn iq3xb-build (i acc)
        (if (eq i (IQ3XXSBlockBytes)) (reverse acc)
            (iq3xb-build (add i 1) (cons (iq3xb-byte i) acc))))
    (defn iq3xb-samples () (list 0 3 4 7 8 31 32 63 64 95 96 127 128 159 160 191 192 223 224 255))
    (defn iq3xb-expected () (list 15000000 3000000 9000000 3000000 -46500000 15000000 -27000000 -99000000 45000000 -15000000 -147000000 -147000000 135000000 27000000 -5000000 5000000 108500000 -77000000 -39000000 39000000))
    (defn iq3xb-scaled (bytes ids acc)
        (if (eq (len ids) 0) (reverse acc)
            (iq3xb-scaled bytes (tail ids)
                (cons (float_to_int (mul 1000000.0 (iq3x-at-flat bytes 0 (head ids)))) acc))))
    (defn iq3xb-eq (a b)
        (if (eq (len a) (len b))
            (if (eq (len a) 0) 1
                (if (eq (head a) (head b)) (iq3xb-eq (tail a) (tail b)) 0)) 0))
    (defn iq3xb-sum (bytes i acc)
        (if (eq i 256) acc
            (iq3xb-sum bytes (add i 1)
                (add acc (float_to_int (mul 1000000.0 (iq3x-at-flat bytes 0 i)))))))
    (defn iq3xb-bit (ok bit) (if ok bit 0))
    (let bytes (iq3xb-build 0 (empty)))
    (let c0 (iq3xb-bit (if (eq (IQ3XXSGGMLType) 18) (if (eq (IQ3XXSBlockElements) 256) (eq (IQ3XXSBlockBytes) 98) 0) 0) 1))
    (let c1 (iq3xb-bit (iq3xb-eq (iq3xb-scaled bytes (iq3xb-samples) (empty)) (iq3xb-expected)) 2))
    (let c2 (iq3xb-bit (eq (iq3xb-sum bytes 0 0) -2386500000) 4))
    (let c3 (iq3xb-bit (if (eq (iq3x-within-block 255) 1) (if (eq (iq3x-within-block 256) 0) (nothing? (iq3x-at-flat bytes 0 -1)) 0) 0) 8))
    (let c4 (iq3xb-bit (if (eq (iq3x-scale-code bytes 0 0) 1) (eq (iq3x-scale-code bytes 0 255) 6) 0) 16))
    (let c5 (iq3xb-bit (if (eq (len (iq3x-grid)) 256) (if (eq (iq3x-slot-threads 641) 5152) (eq (iq3x-slot-admissible 640 2560) 1) 0) 0) 32))
    (let authority (read_file "form/form-stdlib/bml/iq3xxs-layout.bml"))
    (let c6 (iq3xb-bit (if (ge (str_find authority "const int GGMLType = 18" 0) 0) (ge (str_find authority "const int BlockBytes = 98" 0) 0) 0) 64))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6)))))))
