; living-world-action-learning-band.fk -- correction becomes a re-offered cycle.
; Verdict 32767 proves fifteen independence, revision, and next-cycle claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk

(do
    (let observed-world (lwacw-observed-world))
    (let observation (lwacw-observation))
    (let proposal (lwacw-learning-proposal-for observed-world))
    (let candidate (lwt-proposal-candidate proposal))
    (let learning (lwo-emergent-shape candidate))
    (let revision (lwac-learning-revision learning))
    (let round (lwacw-learning-round))
    (let waiting
        (lwac-learning-integrate round proposal (lwrew-action)))
    (let integrated (lwacw-learning-integrated-round))
    (let integrated-world (lwt-round-world integrated))
    (let successor (lwacw-successor-offer))
    (let two-world (lwacw-two-predictions-world))
    (let two-field (lwacw-field-for two-world))
    (let revised-world (lwacw-revised-world))
    (let revised-field (lwacw-field-for revised-world))
    (let revised-primary (lwac-field-primary revised-field))
    (let revised-intention
        (lwac-intention-evidence-intention revised-primary))
    (let revised-selection-proposal
        (lwacw-selection-proposal-for revised-world))
    (let revised-selection-world (lwacw-revised-selection-world))
    (let revised-execution-proposal (lwacw-revised-execution-proposal))
    (let revised-execution
        (lwo-emergent-shape
            (lwt-proposal-candidate revised-execution-proposal)))
    (let self-world
        (lwt-receive-stream (lwacw-execution-world)
            (list (lwacw-entry-c observation))))
    (let observer-revoked-world
        (lwt-receive-stream integrated-world
            (list
                (lwacw-entry-h
                    (lwo-revocation observation (lwacw-source-h)
                        (lwrew-action) (lwacw-prov-h))))))

    (let c1 (if (and (eq (lwac-observation-valid? observation) 1)
                         (eq (lwo-field-size
                              (lwo-active-attributions-for
                                observed-world observation)) 2)) 1 0))
    (let c2 (if (and (eq (lwo-field-size
                              (lwac-independent-observation-attributions
                                observed-world observation)) 2)
                         (node_eq
                           (lwac-learning-proposal self-world observation 1)
                           (lwo-none))) 2 0))
    (let c3 (if (and (not (node_eq proposal (lwo-none)))
                         (eq (lwac-learning-proposal-current?
                              observed-world proposal) 1)) 4 0))
    (let c4 (if (and (eq (lwac-revise?
                              (lwac-learning-state learning)) 1)
                         (eq (lwac-revision? revision) 1)) 8 0))
    (let c5 (if (and (node_eq (lwac-revision-prior revision)
                               (lwacw-wrong-delta))
                         (node_eq (lwac-revision-proposed revision)
                              (lwacw-actual-delta))) 16 0))
    (let c6 (if (and (eq (lwo-field-size
                              (lwo-emergent-witnesses candidate)) 7)
                         (eq (lwo-field-size
                              (lwt-proposal-participants proposal)) 7)) 32 0))
    (let c7 (if (and (eq (lwo-field-size
                              (lwac-learning-alternative-field learning)) 3)
                         (and (eq (lwo-field-size
                                  (lwac-learning-unknowns-field learning)) 1)
                              (eq (oac-time-pending?
                                   (lwac-learning-time learning)) 1))) 64 0))
    (let c8 (if (eq (lwo-active?
                         (lwt-round-world waiting) candidate) 0) 128 0))
    (let c9 (if (and (eq (lwo-active?
                              integrated-world candidate) 1)
                         (eq (lwo-field-size
                              (lwo-active-attributions-for
                                integrated-world candidate)) 7)) 256 0))
    (let c10 (if (and (eq (lwac-offer-valid? successor) 1)
                          (and (node_eq
                                (lwac-offer-prediction successor)
                                (lwacw-actual-delta))
                               (eq (lwo-active?
                                    integrated-world successor) 0))) 512 0))
    (let c11 (if (and (eq (lwac-open?
                               (lwac-field-status two-field)) 1)
                          (node_eq
                            (lwacw-selection-proposal-for two-world)
                            (lwo-none))) 1024 0))
    (let c12 (if (and (eq (lwac-selection-candidate-current?
                               two-world (lwacw-selection-candidate)) 0)
                          (eq (lwac-execution-candidate-current?
                               two-world (lwacw-execution-candidate)) 0))
                     2048 0))
    (let c13 (if (and (eq (lwac-ready?
                               (lwac-field-status revised-field)) 1)
                          (node_eq
                            (lwac-intention-prediction revised-intention)
                            (lwacw-actual-delta))) 4096 0))
    (let c14 (if (and (not (node_eq revised-selection-proposal
                                    (lwo-none)))
                          (and (eq (lwac-selection-proposal-current?
                                    revised-world
                                    revised-selection-proposal) 1)
                               (eq (lwac-selection-integrated-current?
                                    revised-selection-world
                                    (lwacw-revised-selection-candidate)) 1)))
                     8192 0))
    (let c15 (if (and (eq (oac-one?
                               (lwac-execution-comparison
                                 revised-execution)) 1)
                          (and (node_eq
                                (oac-payload
                                  (lwac-execution-comparison
                                    revised-execution))
                                (lwacw-actual-delta))
                               (eq (lwac-learning-candidate-current?
                                    observer-revoked-world candidate 2) 0)))
                     16384 0))
    (lwacw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
