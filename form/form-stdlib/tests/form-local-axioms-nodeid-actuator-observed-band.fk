; form-local-axioms-nodeid-actuator-observed-band.fk -- physical truth surface.
;
; preludes: form-stdlib/form-local-axioms-nodeid-actuator-observed.fk

import "../form-local-axioms-nodeid-actuator-observed.fk"

(do
    (let observed (flanao-observation))
    (let bits (sum (list
        (if (eq (flanao-actuation-observed? observed) 1) 1 0)
        (if (eq (flanao-crossing-observed? observed) 0) 2 0)
        (if (str_eq (flanao-phase observed) "not-yet") 4 0)
        (if (eq (flanao-actuation-observed?
            (flanao-record-with 1 0 1 1 0 0 0 0)) 0) 8 0)
        (if (eq (flanao-actuation-observed?
            (flanao-record-with 0 1 1 1 0 0 0 0)) 0) 16 0)
        (if (eq (flanao-actuation-observed?
            (flanao-record-with 0 0 0 1 0 0 0 0)) 0) 32 0)
        (if (eq (flanao-actuation-observed?
            (flanao-record-with 0 0 1 0 0 0 0 0)) 0) 64 0)
        (if (eq (flanao-actuation-observed?
            (flanao-record-with 0 0 1 1 1 0 0 0)) 0) 128 0)
        (if (eq (flanao-actuation-observed?
            (flanao-record-with 0 0 1 1 0 1 0 0)) 0) 256 0)
        (if (eq (flanao-actuation-observed?
            (flanao-record-with 0 0 1 1 0 0 1 0)) 0) 512 0)
        (if (eq (flanao-actuation-observed?
            (flanao-record-with 0 0 1 1 0 0 0 1)) 0) 1024 0)
        (if (nothing? (flanao-phase (list 0 1))) 2048 0))))
    bits)
