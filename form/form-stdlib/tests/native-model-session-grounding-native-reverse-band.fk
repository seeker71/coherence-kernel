; native-model-session-grounding-native-reverse-band.fk -- public latest-pair
; parity, bounded tail traversal, live continuation, and privacy witness.
; preludes: form-stdlib/native-model-session-grounding-native-reverse.fk

(do
    (defn nmsgnrb-score (condition bit) (if condition bit 0))
    (defn nmsgnrb-double (text remaining)
        (if (le remaining 0) text
            (nmsgnrb-double (str_concat text text) (sub remaining 1))))
    (defn nmsgnrb-field (frame index)
        (node_value (nth (node_children frame) index)))
    (defn nmsgnrb-event-has (events call modifier)
        (if (eq (len events) 0) 0
            (if (and (str_eq (nmsgnrb-field (head events) 2) call)
                     (str_eq (nmsgnrb-field (head events) 5) modifier)) 1
                (nmsgnrb-event-has (tail events) call modifier))))
    (defn nmsgnrb-target-has (events marker)
        (if (eq (len events) 0) 0
            (if (ge (str_find (nmsgnrb-field (head events) 6) marker 0) 0) 1
                (nmsgnrb-target-has (tail events) marker))))
    (defn nmsgnrb-safe-targets (events)
        (if (eq (len events) 0) 1
            (do
                (let target (nmsgnrb-field (head events) 6))
                (if (or (ge (str_find target "latest public inquiry" 0) 0)
                        (ge (str_find target "latest public completion" 0) 0)) 0
                    (nmsgnrb-safe-targets (tail events))))))
    (defn nmsgnrb-accepted-phases (events)
        (if (eq (len events) 0) 1
            (do
                (let phase (nmsgnrb-field (head events) 3))
                (if (or (str_eq phase "enter")
                        (or (str_eq phase "modify")
                            (or (str_eq phase "leave")
                                (str_eq phase "abstain"))))
                    (nmsgnrb-accepted-phases (tail events)) 0))))
    (defn native-model-session-grounding-native-reverse-band ()
        (do
            (let root
                (fs-path-join (fs-temp-dir)
                    (str_concat "native-session-reverse-band-"
                        (int_to_str (now_unix_ms)))))
            (let made (fs-mkdir root))
            (let path (fs-path-join root "session.jsonl"))
            (let user1
                "{\"timestamp\":\"2026-08-09T00:00:01Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"earlier public inquiry\"}}")
            (let done1
                "{\"timestamp\":\"2026-08-09T00:00:02Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"task_complete\",\"last_agent_message\":\"earlier public completion\"}}")
            (let user2
                "{\"timestamp\":\"2026-08-09T00:00:03Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"latest public inquiry\"}}")
            (let done2
                "{\"timestamp\":\"2026-08-09T00:00:04Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"task_complete\",\"last_agent_message\":\"latest public completion\"}}")
            (let padding (nmsgnrb-double "x" 17))
            (let trailing
                (nmsgn-cat (list
                    "{\"type\":\"event_msg\",\"payload\":{\"type\":\"noop\",\"padding\":\""
                    padding "\"}}")))
            (let text
                (nmsgn-cat (list user1 "\n" done1 "\n" user2 "\n"
                    done2 "\n" trailing "\n")))
            (let wrote (fs-write-text path text))
            (let expected1
                (nmsgn-session-event done1
                    (nmsgn-session-event user1 (nmsgn-empty-pairs))))
            (let expected2
                (nmsgn-session-event done2
                    (nmsgn-session-event user2 expected1)))
            (let started
                (lcfb-open-stream "native-session-reverse-band" "form-native"
                    "reverse-latest-pair" "public-fixture"
                    "form/form-stdlib/tests/native-model-session-grounding-native-reverse-band.fk"
                    68 17))
            (let session
                (nmsgn-session path "2026-08-09T00:00:00Z"
                    (fs-stat-mtime path)))
            (let observed (nmsgn-scan-sessions-reverse (list session) started))
            (let events (framebuffer-events))
            (let cleaned (fs-remove-tree root))
            (sum (list
                (nmsgnrb-score (eq (nmsgn-pairs-completed expected2) 2) 1)
                (nmsgnrb-score (eq (nmsgn-pairs-completed observed) 1) 2)
                (nmsgnrb-score
                    (str_eq (nmsgn-pairs-latest-query observed)
                        (nmsgn-pairs-latest-query expected2)) 4)
                (nmsgnrb-score
                    (str_eq (nmsgn-pairs-latest-completion observed)
                        (nmsgn-pairs-latest-completion expected2)) 8)
                (nmsgnrb-score
                    (str_eq (nmsgn-pairs-latest-when observed)
                        (nmsgn-pairs-latest-when expected2)) 16)
                (nmsgnrb-score (ge (len events) 12) 32)
                (nmsgnrb-score
                    (eq (nmsgnrb-event-has events "session-pair-row"
                        "newline-search") 1) 64)
                (nmsgnrb-score
                    (eq (nmsgnrb-event-has events "session-pair-reverse"
                        "latest-pair-from-unchanged-tail") 1) 128)
                (nmsgnrb-score
                    (eq (nmsgnrb-event-has (tail (nmsgn-reverse events))
                        "session-pair-reverse"
                        "latest-pair-from-unchanged-tail") 1) 256)
                (nmsgnrb-score (eq (nmsgnrb-safe-targets events) 1) 512)
                (nmsgnrb-score
                    (eq (nmsgnrb-event-has events "session-pair-row"
                        "cursor-advance") 1) 1024)
                (nmsgnrb-score
                    (eq (nmsgnrb-event-has events "session-pair-row"
                        "event-decode") 1) 2048)
                (nmsgnrb-score
                    (eq (nmsgnrb-event-has events "session-pair-row"
                        "line-read") 1) 4096)
                (nmsgnrb-score (eq (nmsgnrb-accepted-phases events) 1) 8192)
                (nmsgnrb-score (eq cleaned 0) 16384)
                (nmsgnrb-score (eq (nmsgnrb-target-has events ":o") 1) 32768)
                (nmsgnrb-score (gt wrote 131072) 65536)))))
    (native-model-session-grounding-native-reverse-band))
