; tests/bml-hati-native-restore-proof.fk
;
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk
;
; source-restore-spelling. `restore;` has its rule, emitter and inverse:
; source reads to a BML-AST-RESTORE node, the inverse spells the same two
; tokens back, and the node round-trips. On the BMA reference lane a
; `mark;` ... `restore;` pair returns the value stack to the mark, and the
; Hati lane returns its frame and standing value to the same place
; (tests/bml-hati-native-state-snapshot-proof.fk carries the snapshot family).

(do
    (defn score-bool (actual)
        (if actual 1 0))

    (defn score-int (actual expected)
        (if (eq actual expected) 1 0))

    (defn score-str (actual expected)
        (if (nil? actual)
            0
            (if (str_eq actual expected) 1 0)))

    (defn str-contains? (haystack needle)
        (ge (str_find haystack needle 0) 0))

    (defn parse (source)
        (bml-source-parse-executable-stream (bml-source-scan-text source)))

    (let restore-parsed (parse "restore;\n"))
    (let restore-node (head (bml-source-exec-parse-nodes restore-parsed)))

    (let roundtrip
        (bmf-roundtrip
            (bml-bmf-find-rule "restore-simple" bml-bmf-rules)
            (list (bml-src-keyword "restore") (bml-src-op ";"))))
    (let reverse-values (bml-source-token-values (bmf-roundtrip-source roundtrip)))

    (let program-parsed (parse "const int x = 2;\nmark;\nconst int y = 7;\nrestore;\n"))
    (let program-node (bml-source-exec-parse-node program-parsed))
    (let program-state (bma-run-program (bml-compile-program program-node)))
    (let kept-node (bml-source-exec-parse-node (parse "const int x = 2;\nmark;\nconst int y = 7;\n")))
    (let program-image (bml-hati-compile-image program-node))

    (sum
        (list
            (score-bool (bml-source-exec-parse-ok? restore-parsed))
            (score-int (len (bml-source-exec-parse-rest restore-parsed)) 0)
            (score-str (head (bml-source-exec-parse-rules restore-parsed)) "restore-simple")
            (score-bool (node_eq (node_category restore-node) BML-AST-RESTORE))
            (score-bool (fsc-string-list-contains? (bml-source-executable-rules 0) "restore-simple"))
            (score-bool (bmf-roundtrip-node-eq? roundtrip))
            (score-int (len reverse-values) 2)
            (score-str (head reverse-values) "restore")
            (score-str (nth reverse-values 1) ";")
            (score-bool (bml-source-exec-parse-ok? program-parsed))
            (score-str (nth (bml-source-exec-parse-rules program-parsed) 1) "mark-simple")
            (score-str (nth (bml-source-exec-parse-rules program-parsed) 3) "restore-simple")
            (score-int (bma-run-value (bml-compile-program kept-node)) 7)
            (score-int (comp-vm-pop-value program-state) 2)
            (score-int (len (comp-vm-snapshots program-state)) 0)
            (score-bool (bml-hati-image-supported? program-image))
            (score-int (bml-hati-run-value program-node) 2))))
