; First process: persist a current execution before any outside observation.
; Verdict 31 proves five seed/carrier claims.
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk form-stdlib/tests/living-world-durable-learning-witness.fk

(do
    (let world (lwacw-execution-world))
    (let executions (lwdlw-current-executions world))
    (let execution (lwdlw-only executions))
    (let image (lwcn-image world))
    (let saved (lwdlw-save-image (lwdlw-before-path) world))
    (lwdlw-sum
        (list
            (if (eq (lwo-field-size executions) 1) 1 0)
            (if (eq (lwac-execution-integrated-current?
                        world execution) 1) 2 0)
            (if (node_eq
                    (lwac-execution-prediction
                        (lwo-emergent-shape execution))
                    (lwacw-wrong-delta)) 4 0)
            (if (eq (lwcn-image-valid? image) 1) 8 0)
            (if (and (eq (lwcd-saved? saved) 1)
                     (eq (fs-exists? (lwdlw-before-path)) 1)) 16 0))))
