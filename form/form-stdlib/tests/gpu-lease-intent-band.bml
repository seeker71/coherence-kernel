// Intent is scoped; queue aging bounds its advantage without another state file.
import form-stdlib/gpu-lease.bml;
import native/metal/qwen35-dense-token-handle.fk;
section [form.bml] {
 class GpuLeaseIntentBand {
  def gli-bit(ok,bit) = ok ? bit : 0;
 }
 let c1=gli-bit(!gpu-lease-interactive?() && gpl-order-stamp(1000) == 1000,1);
 let inner=gpu-lease-with-interactive(() => {
  let first=gpl-order-stamp(1100);
  let nested=gpu-lease-with-interactive(() => [gpu-lease-interactive?(),gpl-order-stamp(1200)]);
  [first,nested,gpu-lease-interactive?(),q38-prefill-turn-layers()];
 });
 let c2=gli-bit(inner == [600,[1,700],1,32],2);
 let c4=gli-bit(!gpu-lease-interactive?() && q38-prefill-turn-layers() == 8,4);
 let refused=try gpu-lease-with-interactive(() => form_error("intent unwind fixture")) catch 1;
 let c8=gli-bit(refused == 1 && !gpu-lease-interactive?(),8);
 let fresh=[2,1,gpu-lease-with-interactive(() => gpl-order-stamp(1100))];
 let ordinary=[1,1,1000];
 let c16=gli-bit(gpl-before?(fresh,ordinary),16);
 let later=[2,1,gpu-lease-with-interactive(() => gpl-order-stamp(1501))];
 let c32=gli-bit(gpl-before?(ordinary,later),32);
 let c64=gli-bit(gpu-lease-with-interactive(() => gpl-order-stamp(100)) == 0,64);
 let c128=gli-bit(gpl-before?([1,1,1000],[2,1,1000]) && !gpl-before?([2,1,1000],[1,1,1000]),128);
 let verdict=c1+c2+c4+c8+c16+c32+c64+c128;
 print(["gpu-intent",verdict]);
 verdict == 255 ? verdict : form_error("GPU intent scope or aging failed");
}
