; tests/core-lexicon-domains-band.fk — eleven domains reached from the 64.
;
; preludes: form-stdlib/core-lexicon.fk form-stdlib/core-lexicon-derived.fk form-stdlib/core-lexicon-domains.fk
;
; Verdict 4095 — twelve readings at POWERS OF TWO (a decimal-digit fold past
; the 15th reading rounds on the TypeScript arm; 2^53 is the wall).
;
;   1     both parent sets are UNTOUCHED — cl-count 64, cl-closed? 1, and the
;           first expansion layer still well-founded. This cell reads them
;   2     36 domain words entered
;   4     all ELEVEN named domains actually contributed — a domain the 64
;           could not reach would read 0 here, never pass as silence
;   8     every body is GROUNDED: it reaches only core, glue, and strictly
;           shallower words. Nothing in a domain explains itself with its own
;           jargon, which is the circularity the parent cell exists to refuse
;   16    every DECLARED depth equals the depth recomputed from the body, so a
;           hand-written number cannot drift from what the words require
;   32    the ladder has exactly three rungs occupied
;   64    most words sit at depth 1 — said with the 64 and glue alone
;   128   `field`, `line`, `center`, `gate`, `gift` and `feel` sit at depth 2:
;           each needs exactly one earlier expansion word
;   256   exactly two words sit at depth 3, the deepest in the set
;   512   and they are `bond` and `angle` — NOT the most technical words, but
;           the ones standing on the longest chain. `bond` is deep because
;           holding is deep, and holding is deep because giving had to be
;           named first. Chemistry's bond rests on the escrow teaching
;   1024  `gift` reaches `give`: the Gene Keys gift is not a thing held but a
;           self given, and the ladder derived that rather than being told it
;  2048   `siddhi` sits at depth 1 — the highest frequency in Gene Keys is
;           sayable with the plainest words this body has. "siddhi is when a
;           self is same as all" borrows nothing

(do
    ;; (1) the parents are intact
    (let c1 (if (eq (cldx-parents-intact?) 1) 1 0))

    ;; (2) the size of the expansion
    (let c2 (if (eq (cldx-count) 36) 2 0))

    ;; (3) every named domain reached
    (let c3 (if (and (eq (cldx-all-domains-reached?) 1)
                     (eq (cldx-domain-count) 11)) 4 0))

    ;; (4) grounded — nothing reaches sideways or outward
    (let c4 (if (eq (cldx-grounded?) 1) 8 0))

    ;; (5) declared depth equals computed depth, everywhere
    (let c5 (if (eq (cldx-depth-honest?) 1) 16 0))

    ;; (6) three rungs occupied, and no fourth
    (let c6 (if (and (gt (cldx-at-depth 1) 0)
                     (and (gt (cldx-at-depth 2) 0)
                          (and (gt (cldx-at-depth 3) 0)
                               (eq (cldx-at-depth 4) 0)))) 32 0))

    ;; (7) the bulk sit at depth 1 — reachable from the 64 directly
    (let c7 (if (eq (cldx-at-depth 1) 28) 64 0))

    ;; (8) six at depth 2
    (let c8 (if (eq (cldx-at-depth 2) 6) 128 0))

    ;; (9) two at depth 3
    (let c9 (if (eq (cldx-at-depth 3) 2) 256 0))

    ;; (10) and they are bond and angle — depth is earned by chain length,
    ;; not by how technical a word sounds
    (let c10 (if (and (eq (cldx-token-depth "bond") 3)
                      (and (eq (cldx-token-depth "angle") 3)
                           (eq (cldx-token-depth "hold") 2))) 512 0))

    ;; (11) the gift reaches give
    (let c11 (if (and (eq (cldx-token-depth "gift") 2)
                      (eq (cldx-token-depth "give") 1)) 1024 0))

    ;; (12) siddhi is depth 1 — the highest frequency, the plainest words
    (let c12 (if (and (eq (cldx-token-depth "siddhi") 1)
                      (eq (cldx-token-depth "shadow") 1)) 2048 0))

    (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9
        (add c10 (add c11 c12))))))))))))
