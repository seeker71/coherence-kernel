; preludes: form-stdlib/session-evidence.fk
;
; session-evidence-band — a session becomes embodied evidence
; only when its consent, local boundary, hashes, timeline, sources, and observed
; ASR travel together. Unknown speakers pass honestly; invented known labels fail.
;
; Verdict 16383:
;   1     explicit consent is admitted; absence is rejected
;   2     local storage is admitted
;   4     the private local boundary is admitted
;   8     only complete bundles are admitted
;   16    a transcript has at least one segment
;   32    known + unknown is an exact partition
;   64    overlap count stays in the observed range
;   128   every segment has a source link
;   256   every draft excerpt can be source grounded
;   512   audio contains more than an empty WAV header
;   1024  the observed timeline moves forward
;   2048  artifact hashes recomputed cleanly
;   4096  ASR is observed, not declared
;   8192  every known speaker label is human reviewed
(do
    (defn session-evidence-band ()
        (do
            (let c0  (if (and (eq (ses-consent? 1) 1) (eq (ses-consent? 0) 0)) 1 0))
            (let c1  (if (and (eq (ses-local? 1) 1) (eq (ses-local? 0) 0)) 2 0))
            (let c2  (if (and (eq (ses-private? 1) 1) (eq (ses-private? 0) 0)) 4 0))
            (let c3  (if (and (eq (ses-complete? 1) 1) (eq (ses-complete? 0) 0)) 8 0))
            (let c4  (if (and (eq (ses-has-segments? 5) 1) (eq (ses-has-segments? 0) 0)) 16 0))
            (let c5  (if (and (eq (ses-speaker-partition? 5 2 3) 1)
                              (eq (ses-speaker-partition? 5 2 2) 0)) 32 0))
            (let c6  (if (and (eq (ses-overlap-honest? 5 1) 1)
                              (eq (ses-overlap-honest? 5 6) 0)) 64 0))
            (let c7  (if (and (eq (ses-all-source-linked? 5 5) 1)
                              (eq (ses-all-source-linked? 5 4) 0)) 128 0))
            (let c8  (if (and (eq (ses-quotes-grounded? 5 3) 1)
                              (eq (ses-quotes-grounded? 2 3) 0)) 256 0))
            (let c9  (if (and (eq (ses-audio-present? 1000) 1)
                              (eq (ses-audio-present? 44) 0)) 512 0))
            (let c10 (if (and (eq (ses-timeline-sane? 0 6000) 1)
                              (eq (ses-timeline-sane? 6000 6000) 0)) 1024 0))
            (let c11 (if (and (eq (ses-integrity? 1) 1) (eq (ses-integrity? 0) 0)) 2048 0))
            (let c12 (if (and (eq (ses-asr-observed? 1) 1) (eq (ses-asr-observed? 0) 0)) 4096 0))
            (let c13 (if (and (eq (ses-known-labels-reviewed? 2 2) 1)
                              (eq (ses-known-labels-reviewed? 2 1) 0)) 8192 0))
            (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6
                (add c7 (add c8 (add c9 (add c10 (add c11 (add c12 c13)))))))))))))))
    (session-evidence-band))
