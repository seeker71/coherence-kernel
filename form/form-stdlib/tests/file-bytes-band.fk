; tests/file-bytes-band.fk — the raw byte file doors, one meaning on all four arms.
;
; write_file_bytes puts an int list on disk byte for byte (creating or truncating) and
; answers how many bytes it wrote, or -1 when the path does not open. read_file_bytes
; gives the whole file back as the same list; an empty file is the empty list, and a path
; that does not open is nothing (never-was), not an empty list.
;
; Verdict 127:
;   1    six bytes, 0 and 255 included, write as 6
;   2    and read back as the same six ints
;   4    a second write truncates: one byte written, one byte read
;   8    an empty list writes 0 and reads back as the empty list, not nothing
;   16   a path that does not open reads as nothing
;   32   a path that does not open writes as -1
;   64   the same bytes read as a string through read_file_slice keep 206 169 65

(do
    (defn fbb-same? (xs ys)
        (if (eq (len xs) 0) (if (eq (len ys) 0) 1 0)
            (if (eq (len ys) 0) 0
                (if (eq (head xs) (head ys)) (fbb-same? (tail xs) (tail ys)) 0))))
    (defn fbb-bit (ok bit) (if ok bit 0))

    (let p (str_concat (temp_dir) "/file-bytes-band.bin"))
    (let missing "/no/such/dir/file-bytes-band.bin")

    (let w1 (write_file_bytes p (list 0 206 169 65 255 10)))
    (let r1 (read_file_bytes p))
    (let w2 (write_file_bytes p (list 7)))
    (let r2 (read_file_bytes p))
    (let w3 (write_file_bytes p (list)))
    (let r3 (read_file_bytes p))
    (let r4 (read_file_bytes missing))
    (let w4 (write_file_bytes missing (list 1)))
    (let w5 (write_file_bytes p (list 206 169 65)))
    (let s5 (read_file_slice p 0 3))

    (add (fbb-bit (eq w1 6) 1)
    (add (fbb-bit (fbb-same? r1 (list 0 206 169 65 255 10)) 2)
    (add (fbb-bit (and (eq w2 1) (fbb-same? r2 (list 7))) 4)
    (add (fbb-bit (and (eq w3 0) (and (not (nothing? r3)) (eq (len r3) 0))) 8)
    (add (fbb-bit (nothing? r4) 16)
    (add (fbb-bit (eq w4 -1) 32)
         (fbb-bit (and (eq w5 3)
                  (and (eq (str_len s5) 3)
                  (and (eq (str_byte_at s5 0) 206)
                  (and (eq (str_byte_at s5 1) 169) (eq (str_byte_at s5 2) 65)))))
                  64))))))))
