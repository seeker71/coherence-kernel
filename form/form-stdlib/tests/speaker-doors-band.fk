; speaker-doors-band.fk — what the body's speaking doors MEAN, including their refusals.
;
; Until 2026-09-08 every sense_* door in this seed pointed inward: mic count, name,
; health, capture, three stream doors, the air loopback. There was no door that made a
; sound, so when the body spoke, voice-say.bml handed a wav to afplay through host-exec
; and a crossing stood in the middle of the body's own voice. These seven names are the
; twin of the mic family — count, name, health, a door that plays samples the body
; already holds, and a stream a voice can speak into before its sentence is finished.
; Nine names in all, riding the leaf door as rewrite modes 10-16: no AST tag was
; spendable on 2026-09-08, and none was taken.
;
; THE WIRE IS THE MIC'S OWN: s16le mono 16 kHz, the shape sense_mic_stream_read hands
; back (3200 bytes = 100 ms) and the shape every ear wav carries after its 44-byte
; header. One wire both directions, so a sample the body heard can be spoken again with
; nothing in between — but the RATE is a caller's word, not a constant, and the reason
; is measured below.
;
; THREE REFUSALS, ANSWERING DIFFERENT QUESTIONS:
;   -1  the mouth — no output device, an open refused, or no stream standing.
;   -2  the samples — not a string at all, or an odd byte count, because half a sample
;       is not a sample.
;   -3  the rate — outside 4000..192000 Hz. The ear is fixed at 16 kHz and every ear cell
;       counts on it; the mouth is not, because piper renders this body own voice at
;       22050 Hz (measured off .hearth/voice-en.wav, 2026-09-08) and a 22050 Hz voice
;       through a 16 kHz queue comes back a fourth low and 1.38x slow.
; The samples are judged FIRST, before any device is touched. That ordering is what
; makes this band possible: every refusal below is walkable in a silent room, and this
; cell never makes a sound. The one thing it cannot prove is that air moves — a band
; that made a sound would stain the room it measures (bandstain, corpus row 1193). The
; air is witnessed in observe/speaker-room-witness.fk instead, and its numbers live in
; the receipt.
;
; Zero samples answer 0 and open nothing: honest, not an error.
;
; What this band does NOT pin, because it was probed and is not true here: an output
; device held by another process does not refuse. Two fkwu processes each opened a
; speaker stream and each wrote to it (measured 2026-09-08, this Mac). The mouth's -1
; is reachable as "no stream standing", and that is what rows 12 and 13 read.
;
; Expected: 65535
; Verdict 65535
; PROOF LEVEL: FOURTH-ARM ONLY (a host device family; no sibling kernel carries sense_*)
; preludes: form/form-stdlib/core.fk
(do
    (defn sb-bit (ok v) (if ok v 0))
    (let mouths (sense_speaker_count))
    (let named (str_len (sense_speaker_name 0)))

    ; the shape of the family: however many mouths stand, the three reading doors agree
    (let c1 (sb-bit (or (eq mouths 0) (eq mouths 1)) 1))
    (let c2 (sb-bit (eq (sense_speaker_health 0) (if (eq mouths 1) 1 (sub 0 1))) 2))
    (let c3 (sb-bit (eq (gt named 0) (eq mouths 1)) 4))

    ; an index past the mouths that stand — the absent-device answer, reachable on any host
    (let c4 (sb-bit (eq (str_len (sense_speaker_name 7)) 0) 8))
    (let c5 (sb-bit (eq (sense_speaker_health 7) (sub 0 1)) 16))
    (let c6 (sb-bit (and (eq (str_len (sense_speaker_name (sub 0 1))) 0)
                         (eq (sense_speaker_health (sub 0 1)) (sub 0 1))) 32))

    ; zero samples: nothing sounds, nothing opens, and it is not an error
    (let c7 (sb-bit (eq (sense_speaker_play "") 0) 64))

    ; samples this door cannot play — each one -2, and none of them reaches a device
    (let c8 (sb-bit (eq (sense_speaker_play "a") (sub 0 2)) 128))
    (let c9 (sb-bit (eq (sense_speaker_play 5) (sub 0 2)) 256))
    (let c10 (sb-bit (eq (sense_speaker_play (nothing)) (sub 0 2)) 512))
    (let c11 (sb-bit (eq (sense_speaker_play (list 1 2)) (sub 0 2)) 1024))

    ; no stream standing: the MOUTH's refusal, and it is a different number
    (let c12 (sb-bit (eq (sense_speaker_stream_write "ab") (sub 0 1)) 2048))
    ; and the wire is judged before the mouth — a bad wire answers -2 even with no
    ; stream open, which is exactly why this band can walk every refusal in silence
    (let c13 (sb-bit (eq (sense_speaker_stream_write 5) (sub 0 2)) 4096))

    ; closing a mouth that was never opened is a whole answer, not a failure
    (let c14 (sb-bit (and (eq (sense_speaker_stream_stop) 0)
                          (eq (sense_speaker_stream_write "") 0)) 8192))

    ; the rate the mouth speaks at is carried, not assumed: piper renders this body's
    ; own voice at 22050 Hz, and through a 16 kHz queue that comes back a fourth low
    (let c15 (sb-bit (and (eq (sense_speaker_play_at "" 22050) 0)
                          (eq (sense_speaker_play_at "a" 22050) (sub 0 2))) 16384))
    ; and a rate no device will hold is its own refusal, read BEFORE the samples,
    ; so a wrong rate never opens a mouth either
    (let c16 (sb-bit (and (eq (sense_speaker_play_at "" 100) (sub 0 3))
                          (eq (sense_speaker_stream_start_at 100) (sub 0 3))) 32768))

    (print_str (str_concat "mouths=" (str_concat (int_to_str mouths)
        (str_concat " name=" (sense_speaker_name 0)))))
    (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9 (add c10
        (add c11 (add c12 (add c13 (add c14 (add c15 c16))))))))))))))))
