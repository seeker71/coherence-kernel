; form-cli-knowledge-mint-band.fk — Form mints diverse samples; overlay fits.
;
; Verdict 1023:
;   1..128  fkm-check (n, mix, leakage, unique, split, heldout>=4, lora-writer=0, scales)
;   256     class descriptor FormKnowledgeMint minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-knowledge-mint.bml
; witnessed: 2026-08-24 -> 1023; minted heldout 6/6 leakage 0; lora-writer 0

(do
    (defn fkmb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn fkmb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (fkmb-has-name? (tail xs) name))))

    (let bits (fkm-check))
    (let desc (FormKnowledgeMint))
    (let src (read_file "form/form-stdlib/bml/form-cli-knowledge-mint.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormKnowledgeMint")
                     (and (eq (fkmb-has-name? (nth desc 2) "T") 1)
                          (and (eq (fkmb-has-name? (nth desc 3) "fkm-corpus") 1)
                               (eq (fkmb-has-name? (nth desc 4) "MixA") 1))))
                256 0))
    (let b9 (if (and (eq (fkmb-has-str? src "package Form.cli.knowledgemint") 1)
                     (and (eq (fkmb-has-str? src "interface IKnowledgeMint") 1)
                          (and (eq (fkmb-has-str? src "class FormKnowledgeMint") 1)
                               (and (eq (fkmb-has-str? src "const int MixA") 1)
                                    (eq (fkmb-has-str? src "template SampleRow") 1)))))
                512 0))
    (add bits (add b8 b9)))
