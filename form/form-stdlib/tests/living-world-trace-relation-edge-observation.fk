; living-world-trace-relation-edge-observation.fk -- privacy-safe causal
; observation for a valid incomplete edge band.  It carries only predicate
; flags and aggregate counts through a correlated request-evidence exchange.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-trace-relation.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-trace-relation-witness.fk observe/bidirectional-framebuffer-channel.fk

(do
    (framebuffer-clear)
    (let candidate (lwtrw-hypothesis-candidate))
    (let attestation (lwtrw-support-attestation))
    (let one-world (lwtrw-one-attestation-world))
    (let two-world (lwtrw-two-attestation-world))
    (let one-attributions
        (lwo-active-attributions-for one-world attestation))
    (let excluded (lwo-emergent-witnesses candidate))
    (let first
        (bfc-envelope 0 71 0 (list 12 3) 7100))
    (let outbound-event (bfc-record-out first 1))
    (let request (bfc-control first 4))
    (let inbound-event (bfc-record-in request 2))
    (let selected (bfc-apply first request 6145 0))
    (let one-set (lwtr-attestations-for one-world candidate))
    (let two-set (lwtr-attestations-for two-world candidate))
    (let evidence
        (list
            (lwtr-attestation? attestation)
            (lwtr-attestation-shape-valid? attestation)
            (lwo-active? one-world attestation)
            (lwtr-attestation-ack-coherent? attestation)
            (lwtr-hypothesis-integrated-current? one-world candidate)
            (lwo-field-size one-attributions)
            (lwtr-distinct-source-count one-attributions)
            (lwtr-attribution-sources-outside?
                (lwo-field-items one-attributions)
                (lwo-field-items excluded))
            (lwtr-attestation-current? one-world attestation)
            (lwtr-support-count one-set)
            (lwtr-support-count two-set)
            (lwo-field-size (lwtr-attestation-supports one-set))
            (lwo-field-size (lwtr-attestation-supports two-set))
            (if (node_eq (lwtrw-edge-proposal-for one-world)
                         (lwo-none)) 1 0)
            (lwtr-edge-candidate?
                (lwtr-edge-candidate-for two-world candidate 2))))
    (list selected (bfc-payload request) evidence
          (len (framebuffer-events))))
