; form-knowledge-exec-grammar-transport-band.fk -- source-bound full form.bml
; parse/lower/direct-Form transport, with absence distinct from invalidity.
;
; Verdict 32767 (15 bits).
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/sha256.fk form-stdlib/hex.fk
; preludes: form-stdlib/native-model-evidence.fk form-stdlib/bmf-core.fk
; preludes: form-stdlib/bmf-grammar.fk form-stdlib/grammars/form-bml.fk
; preludes: form-stdlib/form-knowledge-query-token.fk
; preludes: form-stdlib/form-knowledge-exec-diagnostic.fk
; preludes: form-stdlib/form-knowledge-exec-grammar-transport.fk

(do
    (defn fkegtb-bit (ok bit) (if ok bit 0))
    (defn fkegtb-fixture ()
        (fked-cat (list
            "def lane-a(args) = nothing();\n"
            "def zero-arg() = list(lane-a,empty,nothing(),0,1);\n"
            "def ask?(x) = if eq(x,0) then nothing() else add(x,1);\n"
            "def bang!() = zero-arg();\n"
            "def blocky(x) { let y = add(x,1); list(y,\"q\"); }\n"
            "0;")))
    (defn fkegtb-expected-body ()
        (fked-cat (list
            "(defn lane-a (args) (nothing))\n"
            "(defn zero-arg () (list lane-a (empty) (nothing) 0 1))\n"
            "(defn ask? (x) (if (eq x 0) (nothing) (add x 1)))\n"
            "(defn bang! () (zero-arg))\n"
            "(defn blocky (x) (do (let y (add x 1)) (list y \"q\")))\n"
            "0\n")))
    (defn fkegtb-run ()
        (do
            (let observation (fkegt-observation))
            (let fixture (fkegtb-fixture))
            (let body-a (fkegt-form-body fixture (fkegt-max-bytes)))
            (let body-b (fkegt-form-body fixture (fkegt-max-bytes)))
            (let source (fkegt-form-source fixture (fkegt-max-bytes)))
            (let prompt (fkegt-prompt))
            (let prompt-sha (nmfe-sha256 prompt))
            (sum (list
                (fkegtb-bit (and (str_eq (fkegt-challenge-id) (fked-challenge-id))
                                  (str_eq (fkegt-harness-sha) (fked-harness-sha))) 1)
                (fkegtb-bit (and (eq (len (fkegt-source-paths)) 4)
                                  (eq (len (fkegt-source-shas)) 4)) 2)
                (fkegtb-bit (and (str_eq (fkegt-observation-status observation) "hit")
                    (and (eq (fkegt-observation-executed? observation) 1)
                    (and (eq (fkegt-observation-model-executed? observation) 0)
                         (eq (fkegt-observation-answer-present? observation) 0)))) 4)
                (fkegtb-bit (and (eq (fkegt-observation-supervised? observation) 1)
                    (and (eq (fkegt-observation-heldout-credit? observation) 0)
                    (and (eq (fkegt-observation-scannerless? observation) 1)
                    (and (eq (fkegt-observation-bounded-full-string? observation) 1)
                         (eq (fkegt-observation-neural-tokenizer-free? observation) 0))))) 8)
                (fkegtb-bit (and (lt (str_find (fkegt-card) "fkecc-" 0) 0)
                    (and (lt (str_find (fkegt-card) "511" 0) 0)
                    (and (lt (str_find (fkegt-card) "41" 0) 0)
                         (lt (str_find (fkegt-card) "99" 0) 0)))) 16)
                (fkegtb-bit (and (ge (str_find (fkegt-card) "nothing()" 0) 0)
                    (and (ge (str_find (fkegt-card) "zero-argument" 0) 0)
                    (and (ge (str_find (fkegt-card) "bare name" 0) 0)
                         (eq (fkegt-card-version) 2)))) 32)
                (fkegtb-bit (nothing? (fkegt-parse-signal "" (fkegt-max-bytes))) 64)
                (fkegtb-bit (nothing? (fkegt-parse-signal
                    (fked-cat (list fixture fixture fixture fixture fixture fixture fixture fixture
                        fixture fixture fixture fixture fixture fixture fixture fixture
                        fixture fixture fixture fixture fixture fixture fixture fixture
                        fixture fixture fixture fixture fixture fixture fixture fixture)) 64)) 128)
                (fkegtb-bit (and (eq (fkegt-parse-signal "def bad(): return 1;" (fkegt-max-bytes)) 0)
                    (and (str_eq (fkegt-parse-reason "def bad(): return 1;" (fkegt-max-bytes)) "present-invalid")
                         (nothing? (fkegt-form-source "def bad(): return 1;" (fkegt-max-bytes))))) 256)
                (fkegtb-bit (eq (fkegt-parse-signal fixture (fkegt-max-bytes)) 1) 512)
                (fkegtb-bit (and (str_eq body-a (fkegtb-expected-body))
                                  (str_eq body-a body-b)) 1024)
                (fkegtb-bit (and (ge (str_find source (fkegt-import-envelope) 0) 0)
                    (and (eq (str_find source "import" 0) 0)
                         (lt (str_find body-a "import" 0) 0))) 2048)
                (fkegtb-bit (and (ge (str_find prompt (fked-query-surface) 0) 0)
                    (and (ge (str_find prompt (fked-lesson-sha) 0) 0)
                         (ge (str_find prompt (fkegt-card-sha) 0) 0))) 4096)
                (fkegtb-bit (and (not (str_eq prompt-sha ""))
                    (and (not (str_eq prompt-sha
                        "1654c2521a4cc4125c32b1a6abdc223cc60096f194e647c0bbd34e3ab8b9ec35"))
                         (not (str_eq prompt-sha
                        "c3870f18ea91f1bde46b52509c52ad2a67ff145ce165049539d3173f23481119")))) 8192)
                (fkegtb-bit (and (eq (fkegt-parse-signal "```form\ndef x() = 1;\n```" (fkegt-max-bytes)) 0)
                    (and (eq (fkegt-parse-signal "def x() = [0,1];" (fkegt-max-bytes)) 0)
                    (and (eq (fkegt-parse-signal "def x() = None;" (fkegt-max-bytes)) 0)
                         (eq (fkegt-parse-signal "def x() = 1; trailing" (fkegt-max-bytes)) 0)))) 16384)))))

    (fkegtb-run))
