; living-world-generative-continuation-witness.fk -- a public field grows an
; arbitrary three-context continuation and its own three-segment vocabulary.
; Fixture cells and surfaces live here, never in the continuation organ.
;
; preludes: form-stdlib/core.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-shared-field-channel.fk form-stdlib/living-world-generative-continuation.fk

(let LWSGW-ACTION      (bp "LWSGW-ACTION"))
(let LWSGW-SOURCE-A    (bp "LWSGW-SOURCE-A"))
(let LWSGW-SOURCE-B    (bp "LWSGW-SOURCE-B"))
(let LWSGW-SOURCE-C    (bp "LWSGW-SOURCE-C"))
(let LWSGW-SOURCE-D    (bp "LWSGW-SOURCE-D"))
(let LWSGW-PROV-A      (bp "LWSGW-PROV-A"))
(let LWSGW-PROV-B      (bp "LWSGW-PROV-B"))
(let LWSGW-PROV-C      (bp "LWSGW-PROV-C"))
(let LWSGW-PROV-D      (bp "LWSGW-PROV-D"))
(let LWSGW-REASON      (bp "LWSGW-REASON"))
(let LWSGW-EVIDENCE    (bp "LWSGW-EVIDENCE"))
(let LWSGW-CONTEXT-A   (bp "LWSGW-CONTEXT-A"))
(let LWSGW-CONTEXT-B   (bp "LWSGW-CONTEXT-B"))
(let LWSGW-CONTEXT-C   (bp "LWSGW-CONTEXT-C"))
(let LWSGW-OUTPUT-A    (bp "LWSGW-OUTPUT-A"))
(let LWSGW-OUTPUT-B    (bp "LWSGW-OUTPUT-B"))
(let LWSGW-OUTPUT-C    (bp "LWSGW-OUTPUT-C"))
(let LWSGW-OUTPUT-ALT  (bp "LWSGW-OUTPUT-ALT"))
(let LWSGW-LENS        (bp "LWSGW-LENS"))
(let LWSGW-DIRECTION   (bp "LWSGW-DIRECTION"))
(let LWSGW-PROJECTION  (bp "LWSGW-PROJECTION"))

(defn lwsgw-cell (kind) (intern_node kind (empty)))
(defn lwsgw-action () (lwsgw-cell LWSGW-ACTION))
(defn lwsgw-source-a () (lwsgw-cell LWSGW-SOURCE-A))
(defn lwsgw-source-b () (lwsgw-cell LWSGW-SOURCE-B))
(defn lwsgw-source-c () (lwsgw-cell LWSGW-SOURCE-C))
(defn lwsgw-source-d () (lwsgw-cell LWSGW-SOURCE-D))
(defn lwsgw-prov-a () (lwsgw-cell LWSGW-PROV-A))
(defn lwsgw-prov-b () (lwsgw-cell LWSGW-PROV-B))
(defn lwsgw-prov-c () (lwsgw-cell LWSGW-PROV-C))
(defn lwsgw-prov-d () (lwsgw-cell LWSGW-PROV-D))
(defn lwsgw-reason () (lwsgw-cell LWSGW-REASON))
(defn lwsgw-evidence () (lwsgw-cell LWSGW-EVIDENCE))
(defn lwsgw-output-a () (lwsgw-cell LWSGW-OUTPUT-A))
(defn lwsgw-output-b () (lwsgw-cell LWSGW-OUTPUT-B))
(defn lwsgw-output-c () (lwsgw-cell LWSGW-OUTPUT-C))
(defn lwsgw-output-alt () (lwsgw-cell LWSGW-OUTPUT-ALT))
(defn lwsgw-projection () (lwsgw-cell LWSGW-PROJECTION))
(defn lwsgw-context-a ()
    (lwtf-context (list (lwsgw-cell LWSGW-CONTEXT-A))))
(defn lwsgw-context-b ()
    (lwtf-context (list (lwsgw-cell LWSGW-CONTEXT-B))))
(defn lwsgw-context-c ()
    (lwtf-context (list (lwsgw-cell LWSGW-CONTEXT-C))))
(defn lwsgw-interface () (lwo-interface (list (lwsgw-action))))

(defn lwsgw-entry (source payload provenance)
    (lwt-entry
        (lwo-offer source (lwsgw-interface) 1 payload provenance 1)
        (lwsgw-action)))
(defn lwsgw-response-entry (source provenance proposal ack)
    (lwsgw-entry source
        (lwt-response proposal ack provenance) provenance))
(defn lwsgw-revocation-entry (source provenance target)
    (lwsgw-entry source
        (lwo-revocation target source (lwsgw-reason) provenance)
        provenance))
(defn lwsgw-state-world (state) (lwsf-state-world state))
(defn lwsgw-next-state (step) (lwsf-step-state step))

; Result: state, observation, proposal, candidate, current derivation.
(defn lwsgw-add-transition (state context next)
    (do
        (let observation (lwtf-observation context next (lwo-none)))
        (let offered-a
            (lwsf-apply state
                (lwsgw-entry (lwsgw-source-a) observation (lwsgw-prov-a))))
        (let offered-b
            (lwsf-apply (lwsgw-next-state offered-a)
                (lwsgw-entry (lwsgw-source-b) observation (lwsgw-prov-b))))
        (let proposal
            (lwtf-proposal-for
                (lwsgw-state-world (lwsgw-next-state offered-b))
                observation 2))
        (let response-a
            (lwsf-apply (lwsgw-next-state offered-b)
                (lwsgw-response-entry (lwsgw-source-a) (lwsgw-prov-a)
                    proposal (oac-one (lwt-proposal-candidate proposal)))))
        (let response-b
            (lwsf-apply (lwsgw-next-state response-a)
                (lwsgw-response-entry (lwsgw-source-b) (lwsgw-prov-b)
                    proposal (oac-one (lwt-proposal-candidate proposal)))))
        (let next-state (lwsgw-next-state response-b))
        (let candidate (lwt-proposal-candidate proposal))
        (let derivation
            (lwtf-derivation (lwsgw-state-world next-state) candidate))
        (list next-state observation proposal candidate derivation)))

; Result: state, observation, proposal, candidate.
(defn lwsgw-add-symbol (state derivation surface)
    (do
        (let observation
            (lwsl-observation derivation 0 surface (lwo-none)
                (oac-one derivation) (lwsgw-evidence)))
        (let offered-c
            (lwsf-apply state
                (lwsgw-entry (lwsgw-source-c) observation (lwsgw-prov-c))))
        (let offered-d
            (lwsf-apply (lwsgw-next-state offered-c)
                (lwsgw-entry (lwsgw-source-d) observation (lwsgw-prov-d))))
        (let proposal
            (lwsl-proposal-for
                (lwsgw-state-world (lwsgw-next-state offered-d))
                observation 2))
        (let response-c
            (lwsf-apply (lwsgw-next-state offered-d)
                (lwsgw-response-entry (lwsgw-source-c) (lwsgw-prov-c)
                    proposal (oac-one (lwt-proposal-candidate proposal)))))
        (let response-d
            (lwsf-apply (lwsgw-next-state response-c)
                (lwsgw-response-entry (lwsgw-source-d) (lwsgw-prov-d)
                    proposal (oac-one (lwt-proposal-candidate proposal)))))
        (list (lwsgw-next-state response-d) observation proposal
              (lwt-proposal-candidate proposal))))

(defn lwsgw-revoke-two (state target)
    (do
        (let first
            (lwsf-apply state
                (lwsgw-revocation-entry
                    (lwsgw-source-a) (lwsgw-prov-a) target)))
        (let second
            (lwsf-apply (lwsgw-next-state first)
                (lwsgw-revocation-entry
                    (lwsgw-source-b) (lwsgw-prov-b) target)))
        (lwsgw-next-state second)))

(defn lwsgw-alternatives ()
    (lwo-field (list (lwsgw-output-alt))))
(defn lwsgw-unknown () (lwlc-unknown (lwsgw-evidence)))
(defn lwsgw-lens ()
    (lwlc-lens (lwlc-cell-shape) (lwsgw-cell LWSGW-LENS)
        (lwsgw-evidence)))
(defn lwsgw-declaration ()
    (lwlc-declaration (lwsgw-cell LWSGW-DIRECTION)
        (lwlc-stack (lwsgw-lens) (lwlc-layers (empty))
            (lwo-empty-field) (lwsgw-unknown) (lwsgw-evidence))
        (lwsgw-evidence)))
(defn lwsgw-choice ()
    (lwlc-choice (lwo-none) (lwsgw-alternatives)
        (lwsgw-unknown) (lwsgw-evidence)))
(defn lwsgw-request (context horizon timeout now)
    (lwsg-request context horizon (lwsgw-declaration)
        (lwsgw-alternatives) (lwsgw-unknown) (lwsgw-choice) timeout now
        (lwsgw-projection)))
(defn lwsgw-open-request (context)
    (lwsg-request context (lwo-none) (lwo-none) (lwo-empty-field)
        (lwo-none) (lwo-none) (lwo-none) 0 (lwo-none)))

(defn lwsgw-turns-current? (world turns)
    (if (eq (len turns) 0) 1
        (do
            (let turn (head turns))
            (let surface (lwsg-turn-surface turn))
            (if (and (eq (lwtx-plan-current?
                              world (lwsg-turn-plan turn)) 1)
                     (or (node_eq surface (lwo-none))
                         (eq (lwtx-surface-current? world surface) 1)))
                (lwsgw-turns-current? world (tail turns)) 0))))

(defn lwsgw-emitted-exact? (turns)
    (if (not (eq (len turns) 3)) 0
        (if (and (node_eq (lwsg-turn-emitted (nth turns 0))
                          (lwsgw-output-a))
             (and (node_eq (lwsg-turn-emitted (nth turns 1))
                           (lwsgw-output-b))
                  (node_eq (lwsg-turn-emitted (nth turns 2))
                           (lwsgw-output-c)))) 1 0)))

(defn lwsgw-run ()
    (do
        (let state-0 (lwsf-open 2 (lwsgw-action)))
        (let link-a
            (lwsg-link (lwsgw-output-a) (lwsgw-context-b)
                (lwo-none) (lwsgw-evidence)))
        (let link-b
            (lwsg-link (lwsgw-output-b) (lwsgw-context-c)
                (lwsgw-lens) (lwsgw-evidence)))
        (let link-c
            (lwsg-link (lwsgw-output-c) (lwo-none)
                (lwo-none) (lwsgw-evidence)))
        (let transition-a
            (lwsgw-add-transition state-0 (lwsgw-context-a) link-a))
        (let transition-b
            (lwsgw-add-transition (nth transition-a 0)
                (lwsgw-context-b) link-b))
        (let transition-c
            (lwsgw-add-transition (nth transition-b 0)
                (lwsgw-context-c) link-c))
        (let transitions-state (nth transition-c 0))

        (let symbol-a
            (lwsgw-add-symbol transitions-state (nth transition-a 4) "seed"))
        (let symbol-b
            (lwsgw-add-symbol (nth symbol-a 0) (nth transition-b 4) " grows"))
        (let unvoiced-state (nth symbol-b 0))
        (let open-request (lwsgw-open-request (lwsgw-context-a)))
        (let unvoiced
            (lwsg-generate (lwsgw-state-world unvoiced-state) open-request))
        (let symbol-c
            (lwsgw-add-symbol unvoiced-state (nth transition-c 4) "."))
        (let full-state (nth symbol-c 0))
        (let full-world (lwsgw-state-world full-state))
        (let full (lwsg-generate full-world open-request))
        (let horizon
            (lwsg-generate full-world
                (lwsgw-request (lwsgw-context-a)
                    (intern_trivial_int 2) (lwo-none) 0)))
        (let optional-request
            (lwsgw-request (lwsgw-context-a) (lwo-none)
                (oac-timeout (intern_trivial_int 10)
                    (oac-no-default) (lwsgw-evidence)) 9))
        (let pending (lwsg-generate full-world optional-request))
        (let timed-request
            (lwsgw-request (lwsgw-context-a) (lwo-none)
                (oac-timeout (intern_trivial_int 10)
                    (oac-alternative-ack (lwsgw-context-a)
                        (lwsgw-output-alt) (lwsgw-evidence))
                    (lwsgw-evidence)) 10))
        (let timed (lwsg-generate full-world timed-request))
        (let empty-trace
            (lwsg-generate full-world
                (lwsgw-open-request
                    (lwtf-context (list (lwsgw-output-alt))))))
        (let invalid
            (lwsg-generate full-world
                (lwsg-request (lwsgw-context-a)
                    (intern_trivial_string "not-a-horizon")
                    (lwo-none) (lwo-empty-field) (lwo-none) (lwo-none)
                    (lwo-none) 0 (lwo-none))))

        ; A second current next at B remains plural; no surface or NodeID
        ; ordering is allowed to choose it.
        (let alternate-link
            (lwsg-link (lwsgw-output-alt) (lwo-none)
                (lwo-none) (lwsgw-evidence)))
        (let alternate-transition
            (lwsgw-add-transition full-state
                (lwsgw-context-b) alternate-link))
        (let plural-state (nth alternate-transition 0))
        (let plural
            (lwsg-generate (lwsgw-state-world plural-state) open-request))
        (let after-alternate-revocation
            (lwsgw-revoke-two plural-state (nth alternate-transition 1)))
        (let restored-world
            (lwsgw-state-world after-alternate-revocation))
        (let restored (lwsg-generate restored-world open-request))

        ; Replace only the terminal edge with a link back to A.  The walker
        ; voices the third turn, then observes the repeated context and stops.
        (let without-terminal
            (lwsgw-revoke-two after-alternate-revocation
                (nth transition-c 1)))
        (let cycle-link
            (lwsg-link (lwsgw-output-c) (lwsgw-context-a)
                (lwo-none) (lwsgw-evidence)))
        (let cycle-transition
            (lwsgw-add-transition without-terminal
                (lwsgw-context-c) cycle-link))
        (let cycle-symbol
            (lwsgw-add-symbol (nth cycle-transition 0)
                (nth cycle-transition 4) "."))
        (let cycle-state (nth cycle-symbol 0))
        (let cycle-world (lwsgw-state-world cycle-state))
        (let cycle (lwsg-generate cycle-world open-request))

        ; The observed run is identity-equal to the pure run.  Only aggregate
        ; call cells enter the framebuffer.
        (let started
            (lcfb-open-stream "living-world-generative-continuation-witness"
                "form-native" "lwsgw-run" "field-grown-continuation"
                "form/form-stdlib/tests/living-world-generative-continuation-witness.fk"
                277 13))
        (let observed (lwsg-generate-observed full-world open-request started 1))
        (let events (framebuffer-events))

        (list empty-trace unvoiced full horizon pending timed invalid plural
              restored cycle full-world restored-world cycle-world
              open-request optional-request timed-request observed events)))

(defn lwsgw-bit (condition bit) (if condition bit 0))
(defn lwsgw-verdict (result)
    (do
        (let empty-trace (nth result 0))
        (let unvoiced (nth result 1))
        (let full (nth result 2))
        (let horizon (nth result 3))
        (let pending (nth result 4))
        (let timed (nth result 5))
        (let invalid (nth result 6))
        (let plural (nth result 7))
        (let restored (nth result 8))
        (let cycle (nth result 9))
        (let full-world (nth result 10))
        (let restored-world (nth result 11))
        (let cycle-world (nth result 12))
        (let open-request (nth result 13))
        (let optional-request (nth result 14))
        (let timed-request (nth result 15))
        (let observed (nth result 16))
        (let events (nth result 17))
        (let full-turns (lwsg-turn-items (lwsg-trace-turns full)))
        (let unvoiced-turns (lwsg-turn-items (lwsg-trace-turns unvoiced)))
        (let horizon-turns (lwsg-turn-items (lwsg-trace-turns horizon)))
        (let plural-turns (lwsg-turn-items (lwsg-trace-turns plural)))
        (let cycle-turns (lwsg-turn-items (lwsg-trace-turns cycle)))
        (add
            (lwsgw-bit (and (eq (oac-nothing? (lwsg-trace-ack empty-trace)) 1)
                (eq (len (lwsg-turn-items (lwsg-trace-turns empty-trace))) 0)) 1)
        (add (lwsgw-bit (and (eq (lwsg-completion?
                (lwsg-trace-completion unvoiced) LWSG-UNVOICED) 1)
                (and (eq (len unvoiced-turns) 3)
                     (str_eq (lwsg-trace-rendered unvoiced) "seed grows"))) 2)
        (add (lwsgw-bit (and (eq (lwsg-completion?
                (lwsg-trace-completion full) LWSG-TERMINAL) 1)
                (and (eq (len full-turns) 3)
                     (str_eq (lwsg-trace-rendered full) "seed grows."))) 4)
        (add (lwsgw-bit (and (eq (oac-one? (lwsg-trace-ack full)) 1)
                (node_eq (oac-payload (lwsg-trace-ack full))
                    (lwsgw-output-c))) 8)
        (add (lwsgw-bit (eq (lwsgw-emitted-exact? full-turns) 1) 16)
        (add (lwsgw-bit (and (eq (len horizon-turns) 2)
                (eq (lwsg-completion? (lwsg-trace-completion horizon)
                    LWSG-HORIZON) 1)) 32)
        (add (lwsgw-bit (and (eq (oac-time-pending?
                (lwsg-trace-time-state pending)) 1)
                (str_eq (lwsg-trace-rendered pending) "seed grows.")) 64)
        (add (lwsgw-bit (and (eq (oac-time-outcome?
                (lwsg-trace-time-state timed)) 1)
                (and (eq (len (lwsg-turn-items (lwsg-trace-turns timed))) 0)
                     (eq (oac-alternative?
                        (oac-payload (lwsg-trace-ack timed))) 1))) 128)
        (add (lwsgw-bit (and (eq (lwsg-request-valid? optional-request) 1)
                (and (node_eq (lwsg-trace-request pending) optional-request)
                     (not (node_eq (lwsg-request-projection optional-request)
                        (lwo-none))))) 256)
        (add (lwsgw-bit (node_eq invalid (lwo-none)) 512)
        (add (lwsgw-bit (and (eq (len plural-turns) 1)
                (and (eq (oac-node? (lwsg-trace-ack plural)) 1)
                     (eq (lwsg-completion? (lwsg-trace-completion plural)
                        LWSG-PLURAL) 1))) 1024)
        (add (lwsgw-bit (node_eq restored full) 2048)
        (add (lwsgw-bit (and (eq (len cycle-turns) 3)
                (and (eq (lwsg-completion? (lwsg-trace-completion cycle)
                    LWSG-CYCLE) 1)
                     (str_eq (lwsg-trace-rendered cycle) "seed grows."))) 4096)
        (add (lwsgw-bit (eq (lwsg-trace-current? full-world full) 1) 8192)
        (add (lwsgw-bit (eq (lwsg-trace-current? restored-world full) 1) 16384)
        (add (lwsgw-bit (eq (lwsg-trace-current? cycle-world full) 0) 32768)
        (add (lwsgw-bit (eq (lwsg-trace-current? cycle-world cycle) 1) 65536)
        (add (lwsgw-bit (eq (lwsgw-turns-current? full-world full-turns) 1) 131072)
        (add (lwsgw-bit (and (node_eq observed full) (ge (len events) 8)) 262144)
        (lwsgw-bit (and (node_eq (lwsg-trace-request full) open-request)
                        (node_eq (lwsg-trace-request timed) timed-request))
            524288))))))))))))))))))))))

0
