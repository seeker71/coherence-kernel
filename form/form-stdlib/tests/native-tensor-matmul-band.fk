; Form tensor recipes on native Metal. Behavior and refusals travel together.
; preludes: form-stdlib/native-tensor.bml
; Verdict 63.
; preludes: form-stdlib/core.fk

(do
    (defn mmb-score (ok bit) (if ok bit 0))
    (defn mmb-has (hay needle) (if (lt (str_find hay needle 0) 0) 0 1))
    (defn mmb-live? () (mmb-has (nt-status) "metal_linked=true"))
    (defn native-tensor-matmul-band ()
        (do
    (let c0 (mmb-score (eq (mmb-live?) 1) 1))
    (let c1 (mmb-score (if (eq (mmb-live?) 1)
                           (eq (nt-eval "v3 1 2 3 r2 1 3 f32 v3 4 5 6 r2 3 1 f32 matmul i32") 32) 0) 2))
    (let c2 (mmb-score (if (eq (mmb-live?) 1)
                           (eq (nt-eval "v4 1 2 3 4 r2 2 2 f32 v4 5 6 7 8 r2 2 2 f32 matmul sum i32") 134) 0) 4))
    (let c3 (mmb-score (if (eq (mmb-live?) 1)
                           (nt-refused "v3 1 2 3 r2 1 3 f32 v3 4 5 6 r2 3 1 f32 matmul"
                               "program did not land an int32; emit i32") 0) 8))
    (let c4 (mmb-score (if (eq (mmb-live?) 1)
                           (if (eq (nt-eval "v2 10 20 v2 1 2 add sum") 33)
                               (if (eq (nt-eval "2 3 add") 5) 1 0) 0) 0) 16))
    (let c5 (mmb-score (if (eq (mmb-live?) 1)
                           (nt-refused "v3 1 2 3 r2 1 3 f32 v4 1 2 3 4 r2 2 2 f32 matmul i32"
                               "matmul last dimension must match second to last dimension") 0) 32))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
    )
    (native-tensor-matmul-band))
