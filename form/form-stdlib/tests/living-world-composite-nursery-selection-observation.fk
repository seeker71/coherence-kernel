; Causal selection observation for the composite-to-nursery bridge.
; The aggregate band deliberately does not decide which participant is absent.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk form-stdlib/living-world-operation-field.fk form-stdlib/living-world-composite-recipe.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-active-index.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-structural-recipe-witness.fk form-stdlib/tests/living-world-operation-field-witness.fk form-stdlib/tests/living-world-composite-recipe-witness.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk form-stdlib/tests/living-world-composite-nursery-witness.fk

(do
    (framebuffer-clear)
    (let core (lwocnw-build-core))
    (let profile (lwocnw-core-first core))
    (let world (lwocnw-two-rich-world core profile))
    (let target (lwocnw-core-target core))
    (let proposal (lwtn-selection-proposal world target 2))
    (let participants (lwt-proposal-participants proposal))
    (let round
        (lwt-round world (lwo-field (list proposal))
            (lwo-empty-field) (lwocnw-core-target-round core)))
    (let answered
        (lwt-round-receive round (lwocnw-selection-responses proposal)))
    (let before-outcome
        (lwt-evaluate-proposal (lwt-round-world answered) proposal))
    (let integrated
        (lwtn-selection-integrate answered proposal (lwocnw-action)))
    (let next-world (lwt-round-world integrated))
    (let candidate (lwt-proposal-candidate proposal))
    (let observation
        (list
            (lwo-field-size participants)
            (lwo-field-has? participants (lwocnw-source-a))
            (lwo-field-has? participants (lwocnw-source-b))
            (lwo-field-has? participants (lwigw-source-p))
            (lwo-field-has? participants (lwigw-source-q))
            (lwo-field-has? participants (lwigw-source-r))
            (lwt-outcome-yes before-outcome)
            (lwt-outcome-no before-outcome)
            (lwt-outcome-silence before-outcome)
            (lwt-outcome-missing before-outcome)
            (if (node_eq (lwt-outcome-status before-outcome)
                    (lwt-status-acknowledged)) 1 0)
            (lwo-field-size (lwt-round-outcomes integrated))
            (lwo-active? next-world candidate)
            (lwtn-selection-candidate-current? next-world candidate)
            (lwtn-selection-integrated-current? next-world candidate)))
    (fb_record (intern_node (bp "LWOCNW-SELECTION-DIAGNOSTIC")
            (list (intern_trivial_int (nth observation 0))))
        "living-world-composite-nursery-selection-observation.fk" 1)
    (list observation (len (framebuffer-events))))
