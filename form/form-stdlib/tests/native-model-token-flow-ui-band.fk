; native-model-token-flow-ui-band.fk — compact exact-flow Glass projection.
;
; Verdict 16383.
; preludes: form/form-stdlib/native-model-token-flow.bml form/form-stdlib/form-glass-live.bml

(do
    (defn nmtfu-fields (tp ti li tn tb ei ew mp mh fb start end duration)
        (list tp ti li tn tb ei ew mp mh fb start end duration))
    (defn nmtfu-blank ()
        (nmtfu-fields (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent)))
    (defn nmtfu-event-at (publisher flow-id model stage seq parent fields evidence epoch)
        (nmtf-event (nmtf-form-event-node-id publisher flow-id stage seq) parent
            publisher flow-id stage seq
            "ui-fixture" model
            (nth fields 0) (nth fields 1) (nth fields 2) (nth fields 3)
            (nth fields 4) (nth fields 5) (nth fields 6) (nth fields 7)
            (nth fields 8) (nth fields 9) (nth fields 10) (nth fields 11)
            (nth fields 12) epoch "active" evidence "token-flow-ui-band"))
    (defn nmtfu-event (stage seq parent fields evidence)
        (nmtfu-event-at "ui-fixture" "ui-fixture.flow-1"
            "bounded-metal-fixture" stage seq parent fields evidence 5000))
    (defn nmtfu-line-width (line) (if (eq (len line) 0) 0 (add (str_len (ftc-segment-text (head line))) (nmtfu-line-width (tail line)))))
    (defn nmtfu-lines-fit (lines width) (if (eq (len lines) 0) 1 (if (le (nmtfu-line-width (head lines)) width) (nmtfu-lines-fit (tail lines) width) 0)))
    (defn nmtfu-line-text (line) (if (eq (len line) 0) "" (str_concat (ftc-segment-text (head line)) (nmtfu-line-text (tail line)))))
    (defn nmtfu-lines-text (lines) (if (eq (len lines) 0) "" (str_concat (nmtfu-line-text (head lines)) (nmtfu-lines-text (tail lines)))))
    (let a (fgtm-absent))
    (let q (nmtfu-event "request" 1 a (nmtfu-blank) "physical-live"))
    (let t (nmtfu-event "token" 2 (fgtm-present (nmtf-event-node-id q)) (nmtfu-fields (fgtm-present 9) (fgtm-present 42) a a a a a a a a a a a) "physical-live"))
    (let l (nmtfu-event "layer" 3 (fgtm-present (nmtf-event-node-id t)) (nmtfu-fields a a (fgtm-present 17) a a a a a a a a a a) "physical-live"))
    (let x (nmtfu-event "tensor" 4 (fgtm-present (nmtf-event-node-id l)) (nmtfu-fields a a (fgtm-present 17) (fgtm-present "blk.17.ffn_gate_inp.weight") (fgtm-present 4096) a a a a a a a a) "catalog"))
    (let e (nmtfu-event "expert" 5 (fgtm-present (nmtf-event-node-id x)) (nmtfu-fields a a (fgtm-present 17) a a a a a a a a a a) "declared"))
    (let m (nmtfu-event "metal" 6 (fgtm-present (nmtf-event-node-id e)) (nmtfu-fields a a (fgtm-present 17) a a a a (fgtm-present "q4_moe_route_tg") (fgtm-present 5) a (fgtm-present 1000) (fgtm-present 1200) (fgtm-present 200)) "catalog"))
    (let f (nmtfu-event "framebuffer" 7 (fgtm-present (nmtf-event-node-id m)) (nmtfu-fields a a a a a a a a a (fgtm-present 77) a a a) "physical-live"))
    (let g (nmtfu-event "glass" 8 (fgtm-present (nmtf-event-node-id f)) (nmtfu-blank) "physical-live"))
    (let samples (nmtf-events-samples (list q t l x e m f g)))
    (let pipeline (fglat-live-pipeline-line samples))
    (let pipeline-text (nmtfu-line-text pipeline))
    (let detail-lines (fglui-token-flow-lines samples 5000 80))
    ; Exact identifiers remain available on a wide surface; the separate
    ; fit assertion below proves that the 80-column projection stays bounded.
    (let detail-text (nmtfu-lines-text (fglui-token-flow-lines samples 5000 256)))
    (let frame (fgd-live-segment-frame 80 24 5000 4 1 "flow" "all" "all" "none" 0 (list) samples (list "ui-fixture") "held" (list) (list) "fixture-seam"))
    (let frame-text (fgd-segment-project frame))
    ; A newer publisher has only reached token. The chosen pipeline must show
    ; its later stages as absent rather than borrowing the old complete flow.
    (let q2 (nmtfu-event-at "ui-fixture-new" "ui-fixture.flow-2"
        "qwen3.8-flash-next" "request" 1 a (nmtfu-blank) "physical-live" 6000))
    (let t2 (nmtfu-event-at "ui-fixture-new" "ui-fixture.flow-2"
        "qwen3.8-flash-next" "token" 2 (fgtm-present (nmtf-event-node-id q2))
        (nmtfu-fields (fgtm-present 3) (fgtm-present 71) a a a a a a a a a a a)
        "physical-live" 6000))
    (let mixed (append samples (nmtf-events-samples (list q2 t2))))
    (let mixed-text (nmtfu-line-text (fglat-live-pipeline-line mixed)))
    ; Two processes may allocate the same raw occurrence id. Glass interaction
    ; therefore selects by publisher + flow + raw id, while displaying the raw
    ; producer node independently.
    (let collision-a (fgtm-sample "0.2.99.42" a "token-position" "cpu"
        "owner-a" "flow-a" "collision-a" a (fgtm-present 1) "active"
        (fgtm-present 5000) a a a "later" "physical-live" "publisher-a"
        (list "query-lane" "model.a")))
    (let collision-b (fgtm-sample "0.2.99.42" a "token-position" "cpu"
        "owner-b" "flow-b" "collision-b" a (fgtm-present 2) "active"
        (fgtm-present 5000) a a a "later" "physical-live" "publisher-b"
        (list "query-lane" "model.b")))
    (let collision-key-a (fglui-sample-selection-id collision-a))
    (let collision-key-b (fglui-sample-selection-id collision-b))
    (let collision-picked (fglui-find-sample (list collision-a collision-b)
        collision-key-b))
    (let collision-offer (fgtm-control-offer "glass-monitor" "offer.collision"
        5000 "request-evidence" (fgtm-present collision-key-b)
        "declared" "fixture.operator"))
    (let collision-parsed (fgtm-parse-offer-wire
        (fgtm-offer-wire collision-offer)))
    (let collision-state (fgl-control-proposed
        (fgl-control-state-full "all" "none" 0 "held" "flow" "all" "none" 0)
        collision-parsed (list collision-a collision-b)))
    (let collision-evidence (nmtfu-lines-text (fglui-evidence-lines
        (fgl-control-selected collision-state)
        (fgl-control-evidence-open? collision-state)
        (list) (list collision-a collision-b) (list) 5000 256)))
    (sum (list
        (if (eq (fglui-token-flow-present? samples) 1) 1 0)
        (if (and (ge (str_find pipeline-text "MIXED" 0) 0)
                 (str_eq (ftc-segment-evidence (head pipeline)) "declared")) 2 0)
        (if (and (ge (str_find pipeline-text "T*p9" 0) 0) (and (ge (str_find pipeline-text "L*l17" 0) 0) (ge (str_find pipeline-text "E~abs" 0) 0))) 4 0)
        (if (lt (str_find pipeline-text "SCHEMA" 0) 0) 8 0)
        (if (eq (len detail-lines) 8) 16 0)
        (if (str_eq (ftc-segment-node-id (nth pipeline 3))
                    (fglui-sample-selection-id
                        (fglui-flow-stage-sample samples "token"))) 32 0)
        (if (eq (nmtfu-lines-fit detail-lines 80) 1) 64 0)
        (if (str_eq (ftc-segment-evidence (nth pipeline 3)) "physical-live") 128 0)
        (if (and (eq (fgd-has-channel (ftc-segment-channels (nth pipeline 3)) "producer-runtime-id") 1)
                 (and (str_eq (fgtm-sample-lane (fglui-flow-stage-sample samples "token")) "ui-fixture.flow-1")
                      (and (not (str_eq collision-key-a collision-key-b))
                           (and (str_eq (fgtm-sample-purpose collision-picked) "collision-b")
                                (and (eq (fgtm-offer-valid? collision-parsed) 1)
                                     (and (str_eq (fgl-control-selected collision-state) collision-key-b)
                                          (ge (str_find collision-evidence "impact=collision-b" 0) 0))))))) 256 0)
        (if (and (ge (str_find pipeline-text "E~abs" 0) 0) (lt (str_find pipeline-text "E~0" 0) 0)) 512 0)
        (if (ge (str_find frame-text "TOKEN FLOW >LAYER>TENSOR>EXPERT>METAL>FRAME>GLASS" 0) 0) 1024 0)
        (if (and (ge (str_find detail-text "node=" 0) 0)
                 (ge (str_find detail-text "model=bounded-metal-fixture" 0) 0)) 2048 0)
        (if (le (nmtfu-line-width pipeline) 80) 4096 0)
        (if (and (ge (str_find mixed-text "T*p3" 0) 0)
                 (and (ge (str_find mixed-text "L?--" 0) 0)
                      (lt (str_find mixed-text "L*17" 0) 0))) 8192 0))))
