; Executable refusal boundary for multi-cell transaction lists.  The separate
; metal-model-transaction-shape-live band witnesses one immediate cell; two
; complete cells do not arrive exactly in the present carrier and fail closed
; without opening a model.
;
; preludes: native/metal/dsv4-layer-walk.fk

(do
    (let parts
        (list
            "state_save\ttransaction-list-exact\n"
            "state_load\tone\n"))
    (let expected
        "state_save\ttransaction-list-exact\nstate_load\tone\n")
    (let two-receipt
        (metal_model_transaction
            (list
                "state_save\ttransaction-list-exact\n"
                "state_load\tone\n")))
    (if (and
            (eq (len parts) 2)
            (and
                (eq (dlw-join-parts parts) expected)
                (and
                    (lt (str_find two-receipt
                            "operation=state_save\nFAIL metal_model_state_save" 0)
                        0)
                    (and
                        (eq (dlw-transaction-status two-receipt) 0)
                        (and
                            (eq
                                (dlw-transaction-status
                                    "PASS metal_model_transaction\noutcome=success\n")
                                1)
                            (nothing?
                                (dlw-transaction-status
                                    "NOTHING metal_model_transaction\n")))))))
        255
        0))
