; vector-ops-band.fk — dot_product, magnitude and vector_cosine answer the same from their Form home
; on fkwu as from the natives Go, Rust and TS still carry.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/vector-ops.bml
;
; Verdict 255 when every value holds:
;   1   dot_product of int vectors is the float sum of products: (1 2 3).(4 5 6) = 32.0
;   2   dot_product of float vectors: (0.5 1.5).(2.0 4.0) = 7.0
;   4   dot_product stops at the shorter vector: (1 2 3).(10 20) = 50.0
;   8   magnitude of the 3-4-5 triangle is 5.0, of an int vector too
;   16  magnitude of the empty vector is 0.0
;   32  vector_cosine of a vector with itself reads 1 to six places, of orthogonal units 0.0
;   64  vector_cosine with a zero vector answers 0.0
;   128 vector_cosine of (1 2 3) and (4 5 6) reads 974631 in millionths, truncated
; witnessed: 2026-09-13 -> 255 on fkwu, Go, Rust and TS

(defn vob-bit (hit bit) (if hit bit 0))

(add (vob-bit (eq (dot_product (list 1 2 3) (list 4 5 6)) 32.0) 1)
(add (vob-bit (eq (dot_product (list 0.5 1.5) (list 2.0 4.0)) 7.0) 2)
(add (vob-bit (eq (dot_product (list 1 2 3) (list 10 20)) 50.0) 4)
(add (vob-bit (and (eq (magnitude (list 3.0 4.0)) 5.0) (eq (magnitude (list 3 4)) 5.0)) 8)
(add (vob-bit (eq (magnitude (list)) 0.0) 16)
(add (vob-bit (and (eq (trunc (mul (vector_cosine (list 1 2 3) (list 1 2 3)) 1000000)) 1000000)
                   (eq (vector_cosine (list 1 0) (list 0 1)) 0.0)) 32)
(add (vob-bit (eq (vector_cosine (list 0 0) (list 1 2)) 0.0) 64)
     (vob-bit (eq (trunc (mul (vector_cosine (list 1 2 3) (list 4 5 6)) 1000000)) 974631) 128))))))))
