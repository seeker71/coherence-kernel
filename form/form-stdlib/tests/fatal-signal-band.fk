; fatal-signal-band.fk — a process of the body that dies by a signal says so: one organ-health row, with its frames, in the file the immune
; system reads; and a stack that ends is a stop with a name before it is ever a crash.
;
; Urs, 2026-10-04: "crashes for hours, and no compile error, and no stack traces, and no frame-buffer analysis and no signals on errors that
; were handled by the immune system to send out attention to heal?" A SIGBUS (a stack past its guard page) ended a band-sweep shard silently for
; fifty minutes; the cause was read from the operating system's crash reports. The seed now installs a handler per thread on an alternate stack
; (runtime/fkwu-uni.c, "THE FATAL-SIGNAL ORGAN"): at the moment of death it writes one organ-health row to stderr and appends it to
; .hearth/fatal-signal.jsonl, then dies by the same signal (the exit stays 128 + n). Form's side (form/form-stdlib/bml/fatal-signal.bml, and
; -attend.bml) reads that file as findings and as the immune system's attention.
;
; THIS BAND BEGINS CHILDREN ON PURPOSE (docs/in-process-cells.md, class D: the child is the thing under test). A fault ends the process that raises it,
; and nothing in a cell_run can contain a SIGSEGV; so a faulting seed is begun through host-child.bml's one door (hch-run-in) with the environment
; word FK_TEST_FAULT (absent in every product run; cell_run("fk-test-fault") raises the fault it names, three Form functions deep in
; fixtures/fatal-signal/fault-cell.fk). The stack-depth claims run in this process through cell_run. The band leaves .hearth/fatal-signal.jsonl as it
; found it (the rows its own faults added are taken out at the end).
;
;   1      a non-tail recursion with no base case (dive-cell.fk) run by cell_run answers `stopped` kind "stack-depth", never "stop" and never a crash
;   2      its message is "stack-depth: <unit> <fn> ..." and names the fixture and dive-a or dive-b; recipe and unit say the same
;   4      stopped.frames is the walker's chain, innermost first: 24 frames, alternating dive-a and dive-b, a depth of more than a thousand
;   8      the process stands: a cell_run afterwards answers 7
;   16     the collector's depth law: a child with FK_TEST_FAULT=load-base loads the cycle of two .bml units (cyc-a, cyc-b) and the cell answers
;          stopped "stack-depth" naming fk_src_collect_dep and the units it was entering; the child exits 0 (before the law it was a SIGBUS)
;   32     a child that faults (SIGSEGV) ends with exit 139, the host's own reading, and its stderr holds the `form-organ health` row
;   64     .hearth/fatal-signal.jsonl gained exactly that row: organ-health-v1, valid, organ fkwu-seed, aspect fatal-signal, health 0, surprise 1,
;          the need fatal-signal, the offers request-evidence and revise, observed "SIGSEGV at 0x..."
;   128    its evidence names what the process knew: the frames fault-c, fault-b, fault-a, (top) innermost first with their unit, the cell_run in flight
;          (fk-test-fault), a resident size, the C chain through fk_cell_run_door and fk_walk
;   256    host-child reads that exit as a finding, not the number: [139, text, why] with the text ending "died by SIGSEGV (rc 139)" and the frames, and
;          <io>/<step>.finding holding the same
;   512    a real stack overflow (FK_TEST_FAULT=cstack: C recursion past the guard page, the sweep shards' very death) ends with exit 138; the
;          handler ran on its alternate stack and wrote a SIGBUS row whose C chain names fk_test_recurse
;   1024   the file is read as findings, bounded: a row older than 24 hours is not read, rows with one signal and innermost frame are one group
;          counting its rows, and past fsg-cap() groups the rest are counted in one line, never listed
;   2048   the immune system hears it: attend-cell.bml, run by cell_run on the faults' file, speaks the original rows and an attention row (state
;          "unclaimed": no provider claims a fatal signal, the repair is code) and answers how many groups were heard
;   4096   the band sweep reads a stopped leg as its stop with its frames (bsw-stop-line, bsw-stop-why), never "exit 1"
;   8192   the drift gates read a stack-depth row as that stop with its frames (dg-last-of) and count it as a row that ran
;
; A seed without the cell_run door says "door absent" by name and answers 0. The band must run from the repository root with ./fkwu being the seed
; it judges.
;
; Expected: 16383
; Verdict 16383
; REQUIRES: (cell_run, host_spawn_at, host_cwd; the fatal-signal organ of runtime/fkwu-uni.c; the sibling kernels carry no host doors)
; preflight-exec: forbidden
; preludes: form/form-stdlib/core.fk form/form-stdlib/line-grammar.fk form/form-stdlib/bml/host-child.bml form/form-stdlib/bml/fatal-signal-attend.bml form/form-stdlib/bml/band-sweep.bml gate/drift-gates.bml
import form/form-stdlib/bml/host-child.bml;
import form/form-stdlib/bml/fatal-signal-attend.bml;
import form/form-stdlib/bml/band-sweep.bml;
import gate/drift-gates.bml;
section [form.bml] {
  def fsb-bit(ok, bit) = ok ? bit : 0;
  def fsb-say(label, v) = print([label, v]);
  def fsb-has(text, token) = (Comparable) str_find((String) text, token, 0) >= 0;
  def fsb-text(path) = nothing?(read_file(path)) ? "" : (String) read_file(path);
  def fsb-fixture(name) = "form/form-stdlib/tests/fixtures/fatal-signal/" ++ name;
  def fsb-io() = temp_dir() ++ "/fatal-signal-band-" ++ host_pid().str();
  def fsb-door?() = nothing?(cell_run(0, 0, nothing(), nothing())) ? 0 : 1;
  def fsb-seed() = "./fkwu";
  def fsb-file() = ".hearth/fatal-signal.jsonl";
  // a child: the seed in use, the fault named, through host-child's one door; [status, text, why]
  def fsb-child(step, fault, cell) = hch-run-in(fsb-io(), step, ["env", "FK_TEST_FAULT=" ++ fault, fsb-seed(), cell], "", hch-by(240000));
  def fsb-last-row(text) = (String) fsb-last-line-with(text, "\"aspect\":\"fatal-signal\"");
  def fsb-last-line-with(text, needle) = hch-last(text, needle);
  def fsb-row-of(line) = fsga-row-of(line);
  def fsb-valid?(line) = oh-valid(fsb-row-of(line));
  def fsb-offers(line) = fsg-join(oh-values(json-array-elements(oh-get(fsb-row-of(line), "offers"))), ",");
  def fsb-need(line) = oh-str(json-array-elements(oh-get(fsb-row-of(line), "needs"))[0], "resource");
  def fsb-frame-fn(frames, k) = nil?(frames) || (Comparable) len(frames) <= k ? "" : (String) split-on((String) frames[k], " (")[0];
  def fsb-frames-start?(frames, names) = nil?(names) ? true : fsb-frame-fn(frames, 0) == (String) names[0] && fsb-frames-start?(frames[1:], names[1:]);
  // synthetic rows, in the shape the seed writes (the fields the reader takes), to prove the bounds
  def fsb-line(name, fn, at) = "{\"schema\":\"organ-health-v1\",\"id\":\"1:" ++ at.str() ++ ":fatal:1\",\"organ\":\"fkwu-seed\",\"flow\":\"1\",\"aspect\":\"fatal-signal\",\"stage\":\"observe\",\"expected\":\"clean\",\"observed\":\"" ++ name ++ " at 0x1\",\"health\":0,\"surprise\":1,\"needs\":[{\"resource\":\"fatal-signal\",\"detail\":\"" ++ name ++ " at 0x1\"}],\"offers\":[\"request-evidence\",\"revise\"],\"selected\":\"\",\"evidence\":{\"signal\":11,\"name\":\"" ++ name ++ "\",\"addr\":\"0x1\",\"resident_bytes\":1048576,\"pid\":1,\"cell\":\"c\",\"depth\":1,\"frames\":[{\"fn\":\"" ++ fn ++ "\",\"unit\":\"u\"}],\"collector\":{\"depth\":0,\"entering\":[]},\"c\":[]},\"observed_at_ms\":" ++ at.str() ++ ",\"at_ms\":" ++ at.str() ++ "}\n";
  def fsb-many(k, now) = (Comparable) k <= 0 ? "" : fsb-line("SIGSEGV", "distinct-" ++ k.str(), now - k) ++ fsb-many(k - 1, now);
  def fsb-restore(prior) = nothing?(prior) ? host_path_remove(fsb-file()) : write_file_text(fsb-file(), (String) prior);
  def fsb-absent() {
    print(["fatal-signal-band", "door absent: this seed has no cell_run"]);
    0;
  }
  def fsb-run() {
    let prior = read_file(fsb-file());
    let prior-len = nothing?(prior) ? 0 : len((String) prior);
    // 1..8: the walker's depth wall, in this process
    let r = cell_run(fsb-fixture("dive-cell.fk"), 0, 120000, nothing());
    let s = record_get(r, "stopped");
    let kind = nothing?(s) ? "none" : (String) record_get(s, "kind");
    let msg = nothing?(s) ? "" : (String) record_get(s, "message");
    let frames = nothing?(s) ? [] : fsg-stopped-frames(s);
    let t1 = fsb-say("dive", [kind, len(frames)]);
    let b1 = fsb-bit(kind == "stack-depth" && nothing?(record_get(r, "value")), 1);
    let b2 = fsb-bit(fsb-has(msg, "stack-depth: ") && fsb-has(msg, "dive-cell.fk") && (fsb-has(msg, " dive-a ") || fsb-has(msg, " dive-b ")) && fsb-has((String) record_get(s, "unit"), "dive-cell.fk") && (fsb-has((String) record_get(s, "recipe"), "dive-a") || fsb-has((String) record_get(s, "recipe"), "dive-b")), 2);
    let b4 = fsb-bit((Comparable) len(frames) == 24 && (Comparable) record_get(s, "depth") > 1000 && (String) fsb-frame-fn(frames, 0) != (String) fsb-frame-fn(frames, 1) && (String) fsb-frame-fn(frames, 0) == (String) fsb-frame-fn(frames, 2) && (fsb-frame-fn(frames, 0) == "dive-a" || fsb-frame-fn(frames, 0) == "dive-b"), 4);
    let after = cell_run("form/form-stdlib/tests/fixtures/cell-run/seven-cell.fk", 0, 30000, nothing());
    let b8 = fsb-bit(nothing?(record_get(after, "stopped")) && (Comparable) record_get(after, "value") == 7, 8);
    // 16: the collector's depth law, in a child with the freshness repair switched off
    let cyc = fsb-child("cyc", "load-base", fsb-fixture("cyc-probe.fk"));
    let t16 = fsb-say("cyc", [cyc[0], hch-tail-line(cyc[1])]);
    let b16 = fsb-bit((Comparable) cyc[0] == 0 && fsb-has(cyc[1], "stack-depth") && fsb-has(cyc[1], "fk_src_collect_dep") && fsb-has(cyc[1], "cyc-a.bml") && fsb-has(cyc[1], "cyc-b.bml"), 16);
    // 32..256: a child that faults, read through host-child
    let seg = fsb-child("segv", "segv", fsb-fixture("fault-cell.fk"));
    let segtext = (String) seg[1];
    let line = fsb-last-row(segtext);
    let t32 = fsb-say("segv", [seg[0], len(segtext), len(line)]);
    let b32 = fsb-bit((Comparable) seg[0] == 139 && fsb-has(segtext, "form-organ health {\"schema\":\"organ-health-v1\"") && fsb-has(segtext, "\"observed\":\"SIGSEGV at 0x"), 32);
    let file1 = fsb-text(fsb-file());
    let added1 = substring(file1, prior-len, len(file1));
    let rows1 = filter(l => len(l) > 0, split-on(added1, "\n"));
    let frow = len(rows1) == 1 ? rows1[0] : "";
    let b64 = fsb-bit((Comparable) len(rows1) == 1 && fsb-valid?(frow) && (String) oh-str(fsb-row-of(frow), "organ") == "fkwu-seed" && (String) oh-str(fsb-row-of(frow), "aspect") == "fatal-signal" && node_eq(oh-get(fsb-row-of(frow), "health"), json-node-int(0)) && node_eq(oh-get(fsb-row-of(frow), "surprise"), json-node-int(1)) && (String) fsb-need(frow) == "fatal-signal" && (String) fsb-offers(frow) == "request-evidence,revise" && fsb-has(oh-str(fsb-row-of(frow), "observed"), "SIGSEGV at 0x"), 64);
    let row = fsg-row(frow);
    let b128 = fsb-bit(fsb-frames-start?(row[7], ["fault-c", "fault-b", "fault-a", "(top)"]) && fsb-has((String) split-on((String) row[7][0], " (")[1], "fault-cell.fk") && fsb-has(frow, "\"cells\":[\"fk-test-fault\"]") && (Comparable) row[11] > 0 && fsb-has(frow, "\"sym\":\"fk_cell_run_door\"") && fsb-has(frow, "\"sym\":\"fk_walk\""), 128);
    let found = fsb-text(fsb-io() ++ "/segv.finding");
    let b256 = fsb-bit(fsb-has(segtext, "died by SIGSEGV (rc 139)") && fsb-has(segtext, "frame: fault-c (") && fsb-has(found, "died by SIGSEGV (rc 139)") && fsb-has(found, "frame: fault-b (") && (String) seg[2] == "", 256);
    // 512: a real stack overflow, the sweep shards' very death
    let cst = fsb-child("cstack", "cstack", fsb-fixture("fault-cell.fk"));
    let file2 = fsb-text(fsb-file());
    let crow = fsb-last-row(substring(file2, len(file1), len(file2)));
    let t512 = fsb-say("cstack", [cst[0], len(crow)]);
    let b512 = fsb-bit((Comparable) cst[0] == 138 && fsb-has(crow, "\"observed\":\"SIGBUS at 0x") && fsb-has(crow, "\"sym\":\"fk_test_recurse\"") && fsb-has(cst[1], "died by SIGBUS (rc 138)") && fsb-valid?(crow), 512);
    // 1024: the file read as findings, bounded
    let now = now_unix_ms();
    let synth = fsb-io() ++ "/synthetic.jsonl";
    let w1 = write_file_text(synth, fsb-line("SIGSEGV", "alpha", now - 2000) ++ fsb-line("SIGSEGV", "alpha", now - 1000) ++ fsb-line("SIGBUS", "alpha", now - 500) ++ fsb-line("SIGSEGV", "alpha", now - 172800000) ++ fsb-line("SIGSEGV", "beta", now - 100));
    let groups = fsg-groups(synth, now);
    let w2 = write_file_text(synth ++ ".many", fsb-many(9, now));
    let lines9 = fsg-review-lines(synth ++ ".many", now);
    let t1024 = fsb-say("groups", [len(groups), len(lines9)]);
    let b1024 = fsb-bit((Comparable) len(groups) == 3 && (Comparable) fsg-row-count(groups) == 4 && (String) groups[0][0][2] == "beta" && (String) groups[1][0][0] == "SIGBUS" && (Comparable) groups[1][1] == 1 && (String) groups[2][0][0] == "SIGSEGV" && (Comparable) groups[2][1] == 2 && (Comparable) len(filter(l => fsb-has(l, "fatal-signal: SIG"), lines9)) == 6 && fsb-has(lines9[len(lines9) - 1], "3 more row(s)"), 1024);
    // 2048: the immune system hears the faults' own rows
    let heard = cell_run(fsb-fixture("attend-cell.bml"), 0, 120000, [fsb-file()]);
    let said = (String) (record_get(heard, "err") ?? "");
    let t2048 = fsb-say("attend", [record_get(heard, "value"), len(said)]);
    let b2048 = fsb-bit(nothing?(record_get(heard, "stopped")) && (Comparable) record_get(heard, "value") >= 2 && fsb-has(said, "\"organ\":\"fkwu-seed\"") && fsb-has(said, "\"state\":\"unclaimed\"") && fsb-has(said, "\"attention\":") && fsb-has((String) record_get(heard, "out"), "fatal-signal: SIGSEGV at 0x") && fsb-has((String) record_get(heard, "out"), "fatal-signal: SIGBUS at 0x"), 2048);
    // 4096 and 8192: the sweep and the gates read a stack-depth leg as its stop with frames
    let sweep-lines = bsw-stop-line(r);
    let b4096 = fsb-bit((Comparable) len(sweep-lines) == 7 && fsb-has(sweep-lines[0], "stopped stack-depth: stack-depth: ") && fsb-has(sweep-lines[1], "    frame: dive-") && fsb-has(bsw-stop-why(r), "stopped stack-depth: stack-depth: ") && !fsb-has(bsw-stop-why(r), "exit 1"), 4096);
    let gate-last = dg-last-of(r);
    let b8192 = fsb-bit(fsb-has(gate-last, "stack-depth: stack-depth: ") && fsb-has(gate-last, "  frames: dive-") && dg-ran?(s), 8192);
    // the file as the band found it
    let restored = fsb-restore(prior);
    let verdict = b1 + b2 + b4 + b8 + b16 + b32 + b64 + b128 + b256 + b512 + b1024 + b2048 + b4096 + b8192;
    let shown = print(["fatal-signal-band", "verdict", verdict]);
    verdict;
  }
  (Comparable) fsb-door?() == 1 ? fsb-run() : fsb-absent();
}
