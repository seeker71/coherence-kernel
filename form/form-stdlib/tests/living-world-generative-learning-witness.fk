; living-world-generative-learning-witness.fk -- an empty native answer receives
; consented outcome feedback, crosses four separate membranes, and becomes a
; locally voiced transition.  Fixture identities and the one offered surface
; live here, never in the learning organ.
;
; preludes: form-stdlib/core.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-shared-field-channel.fk form-stdlib/living-world-generative-continuation.fk form-stdlib/living-world-generative-learning.fk

(let LWGLW-ACTION     (bp "LWGLW-ACTION"))
(let LWGLW-SOURCE-A   (bp "LWGLW-SOURCE-A"))
(let LWGLW-SOURCE-B   (bp "LWGLW-SOURCE-B"))
(let LWGLW-PROV-A     (bp "LWGLW-PROV-A"))
(let LWGLW-PROV-B     (bp "LWGLW-PROV-B"))
(let LWGLW-CONTEXT    (bp "LWGLW-CONTEXT"))
(let LWGLW-OUTPUT     (bp "LWGLW-OUTPUT"))
(let LWGLW-ALTERNATE  (bp "LWGLW-ALTERNATE"))
(let LWGLW-EVIDENCE   (bp "LWGLW-EVIDENCE"))
(let LWGLW-REASON     (bp "LWGLW-REASON"))
(let LWGLW-LENS       (bp "LWGLW-LENS"))
(let LWGLW-DIRECTION  (bp "LWGLW-DIRECTION"))
(let LWGLW-COORDINATE (bp "LWGLW-COORDINATE"))

(defn lwglw-cell (kind) (intern_node kind (empty)))
(defn lwglw-action () (lwglw-cell LWGLW-ACTION))
(defn lwglw-source-a () (lwglw-cell LWGLW-SOURCE-A))
(defn lwglw-source-b () (lwglw-cell LWGLW-SOURCE-B))
(defn lwglw-prov-a () (lwglw-cell LWGLW-PROV-A))
(defn lwglw-prov-b () (lwglw-cell LWGLW-PROV-B))
(defn lwglw-output () (lwglw-cell LWGLW-OUTPUT))
(defn lwglw-alternate () (lwglw-cell LWGLW-ALTERNATE))
(defn lwglw-evidence () (lwglw-cell LWGLW-EVIDENCE))
(defn lwglw-reason () (lwglw-cell LWGLW-REASON))
(defn lwglw-coordinate () (lwglw-cell LWGLW-COORDINATE))
(defn lwglw-context ()
    (lwtf-context (list (lwglw-cell LWGLW-CONTEXT))))
(defn lwglw-interface () (lwo-interface (list (lwglw-action))))
(defn lwglw-lens ()
    (lwlc-lens (lwlc-cell-shape) (lwglw-cell LWGLW-LENS)
        (lwglw-evidence)))
(defn lwglw-unknown () (lwlc-unknown (lwglw-evidence)))
(defn lwglw-alternatives ()
    (lwo-field (list (lwglw-alternate))))
(defn lwglw-declaration ()
    (lwlc-declaration (lwglw-cell LWGLW-DIRECTION)
        (lwlc-stack (lwglw-lens) (lwlc-layers (empty))
            (lwo-empty-field) (lwglw-unknown) (lwglw-evidence))
        (lwglw-evidence)))
(defn lwglw-link ()
    (lwsg-link (lwglw-output) (lwo-none)
        (lwglw-lens) (lwglw-evidence)))
(defn lwglw-request ()
    (lwsg-request (lwglw-context) (lwo-none) (lwo-none)
        (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none) 0
        (lwo-none)))

(defn lwglw-entry (source payload provenance)
    (lwt-entry
        (lwo-offer source (lwglw-interface) 1 payload provenance 1)
        (lwglw-action)))
(defn lwglw-response-entry (source provenance proposal)
    (lwglw-entry source
        (lwt-response proposal
            (oac-one (lwt-proposal-candidate proposal)) provenance)
        provenance))
(defn lwglw-revocation-entry (source provenance target)
    (lwglw-entry source
        (lwo-revocation target source (lwglw-reason) provenance)
        provenance))
(defn lwglw-next-state (step) (lwsf-step-state step))
(defn lwglw-world (state) (lwsf-state-world state))
(defn lwglw-apply (state source payload provenance)
    (lwglw-next-state
        (lwsf-apply state (lwglw-entry source payload provenance))))
(defn lwglw-respond (state source provenance proposal)
    (lwglw-next-state
        (lwsf-apply state
            (lwglw-response-entry source provenance proposal))))
(defn lwglw-revoke (state source provenance target)
    (lwglw-next-state
        (lwsf-apply state
            (lwglw-revocation-entry source provenance target))))

(defn lwglw-two-offers (state payload)
    (do
        (let first
            (lwglw-apply state (lwglw-source-a) payload (lwglw-prov-a)))
        (lwglw-apply first (lwglw-source-b) payload (lwglw-prov-b))))
(defn lwglw-two-responses (state proposal)
    (do
        (let first
            (lwglw-respond state (lwglw-source-a) (lwglw-prov-a) proposal))
        (lwglw-respond first (lwglw-source-b) (lwglw-prov-b) proposal)))
(defn lwglw-two-revocations (state target)
    (do
        (let first
            (lwglw-revoke state (lwglw-source-a) (lwglw-prov-a) target))
        (lwglw-revoke first (lwglw-source-b) (lwglw-prov-b) target)))

(defn lwglw-state-for-world (prior world)
    (lwsf-state world (lwsf-state-threshold prior)
        (lwsf-state-action prior) prior))

; Result: successor state, proposal, candidate.
(defn lwglw-teach-transition (state transition)
    (do
        (let offered (lwglw-two-offers state transition))
        (let proposal (lwtf-proposal-for (lwglw-world offered) transition 2))
        (let responded (lwglw-two-responses offered proposal))
        (list responded proposal (lwt-proposal-candidate proposal))))

; Result: successor state, proposal, candidate.
(defn lwglw-teach-expression (state observation)
    (do
        (let offered (lwglw-two-offers state observation))
        (let proposal (lwsl-proposal-for
            (lwglw-world offered) observation 2))
        (let responded (lwglw-two-responses offered proposal))
        (list responded proposal (lwt-proposal-candidate proposal))))

(defn lwglw-feedback (trace)
    (lwgl-outcome trace (lwo-none) (lwglw-link)
        (lwglw-coordinate) (intern_trivial_string "new")
        (oac-alternative-ack trace (lwglw-link) (lwglw-evidence))
        (lwglw-declaration) (lwglw-alternatives)
        (lwglw-unknown) (lwglw-evidence)))
(defn lwglw-silence (trace)
    (lwgl-outcome trace (lwglw-link) (lwo-none)
        (lwo-none) (lwo-none) (oac-nothing) (lwo-none)
        (lwo-empty-field) (lwo-none) (lwglw-evidence)))
(defn lwglw-invalid (trace)
    (lwgl-outcome trace (lwglw-link) (lwglw-link)
        (lwglw-coordinate) (intern_trivial_string "invalid")
        (oac-one (lwglw-alternate)) (lwo-none)
        (lwo-empty-field) (lwo-none) (lwglw-evidence)))

(defn lwglw-run ()
    (do
        (let state-0 (lwsf-open 2 (lwglw-action)))
        (let request (lwglw-request))
        (let before (lwsg-generate (lwglw-world state-0) request))
        (let feedback (lwglw-feedback before))
        (let silence (lwglw-silence before))
        (let invalid (lwglw-invalid before))

        (let one-feedback
            (lwglw-apply state-0 (lwglw-source-a) feedback (lwglw-prov-a)))
        (let one-proposal
            (lwgl-proposal-for (lwglw-world one-feedback) feedback 2))
        (let feedback-state
            (lwglw-apply one-feedback
                (lwglw-source-b) feedback (lwglw-prov-b)))
        (let feedback-world (lwglw-world feedback-state))

        (let started
            (lcfb-open-stream "living-world-generative-learning-witness"
                "form-native" "lwglw-run" "outcome-to-native-voice"
                "form/form-stdlib/tests/living-world-generative-learning-witness.fk"
                154 13))
        (let proposal
            (lwgl-proposal-for-observed
                feedback-world feedback 2 started 1))
        (let candidate (lwt-proposal-candidate proposal))

        ; A plan cannot cross on recurrence alone.
        (let waiting-round
            (lwgl-integrate
                (lwt-round feedback-world (lwo-field (list proposal))
                    (lwo-empty-field) (lwo-none))
                proposal (lwglw-action)))

        (let response-state (lwglw-two-responses feedback-state proposal))
        (let admitted-round
            (lwgl-integrate-observed
                (lwt-round (lwglw-world response-state)
                    (lwo-field (list proposal))
                    (lwo-empty-field) (lwo-none))
                proposal (lwglw-action) started 2))
        (let plan-state
            (lwglw-state-for-world response-state
                (lwt-round-world admitted-round)))
        (let plan-world (lwglw-world plan-state))
        (let transition
            (lwgl-transition-successor plan-world candidate))
        (let premature-expression
            (lwgl-expression-successor plan-world candidate))

        (let transition-result
            (lwglw-teach-transition plan-state transition))
        (let transition-state (nth transition-result 0))
        (let transition-proposal (nth transition-result 1))
        (let transition-candidate (nth transition-result 2))
        (let transition-world (lwglw-world transition-state))
        (let expression
            (lwgl-expression-successor transition-world candidate))

        (let expression-result
            (lwglw-teach-expression transition-state expression))
        (let final-state (nth expression-result 0))
        (let symbol-proposal (nth expression-result 1))
        (let symbol-candidate (nth expression-result 2))
        (let final-world (lwglw-world final-state))
        (let after (lwsg-generate final-world request))

        ; Feedback release stales only its plan.  The separately re-offered
        ; transition and expression remain current until their own holders act.
        (let feedback-released
            (lwglw-revoke final-state
                (lwglw-source-a) (lwglw-prov-a) feedback))
        (let feedback-released-world (lwglw-world feedback-released))
        (let after-feedback-release
            (lwsg-generate feedback-released-world request))

        (let transition-released
            (lwglw-two-revocations feedback-released transition))
        (let transition-released-world (lwglw-world transition-released))
        (let after-transition-release
            (lwsg-generate transition-released-world request))
        (let events (framebuffer-events))

        (list before after after-feedback-release after-transition-release
            feedback silence invalid one-proposal proposal candidate
            waiting-round admitted-round transition premature-expression
            transition-proposal transition-candidate expression symbol-proposal
            symbol-candidate plan-world transition-world final-world
            feedback-released-world transition-released-world events request)))

(defn lwglw-bit (condition bit) (if condition bit 0))
(defn lwglw-verdict (result)
    (do
        (let before (nth result 0))
        (let after (nth result 1))
        (let after-feedback-release (nth result 2))
        (let after-transition-release (nth result 3))
        (let feedback (nth result 4))
        (let silence (nth result 5))
        (let invalid (nth result 6))
        (let one-proposal (nth result 7))
        (let proposal (nth result 8))
        (let candidate (nth result 9))
        (let waiting-round (nth result 10))
        (let admitted-round (nth result 11))
        (let transition (nth result 12))
        (let premature-expression (nth result 13))
        (let transition-proposal (nth result 14))
        (let transition-candidate (nth result 15))
        (let expression (nth result 16))
        (let symbol-proposal (nth result 17))
        (let symbol-candidate (nth result 18))
        (let plan-world (nth result 19))
        (let transition-world (nth result 20))
        (let final-world (nth result 21))
        (let feedback-released-world (nth result 22))
        (let transition-released-world (nth result 23))
        (let events (nth result 24))
        (let request (nth result 25))
        (let plan (lwo-emergent-shape candidate))
        (let after-turns (lwsg-turn-items (lwsg-trace-turns after)))
        (add
            (lwglw-bit (and (eq (oac-nothing? (lwsg-trace-ack before)) 1)
                (eq (len (lwsg-turn-items (lwsg-trace-turns before))) 0)) 1)
        (add (lwglw-bit (and (eq (lwgl-outcome-valid? feedback) 1)
                (eq (lwgl-outcome-valid? invalid) 0)) 2)
        (add (lwglw-bit (and (node_eq one-proposal (lwo-none))
                (not (node_eq proposal (lwo-none)))) 4)
        (add (lwglw-bit (and (eq (oac-alternative-ack?
                    (lwgl-plan-ack plan)) 1)
                (and (node_eq (lwgl-plan-declaration plan)
                              (lwglw-declaration))
                     (and (node_eq (lwgl-plan-alternatives plan)
                                   (lwglw-alternatives))
                          (node_eq (lwgl-plan-unknown plan)
                                   (lwglw-unknown))))) 8)
        (add (lwglw-bit (and (eq (lwo-field-size
                    (lwgl-plan-witnesses plan)) 2)
                (eq (lwo-field-size
                    (lwt-proposal-participants proposal)) 2)) 16)
        (add (lwglw-bit (eq (lwo-active?
                (lwt-round-world waiting-round) candidate) 0) 32)
        (add (lwglw-bit (and (eq (lwo-active?
                    (lwt-round-world admitted-round) candidate) 1)
                (eq (lwgl-candidate-active? plan-world candidate) 1)) 64)
        (add (lwglw-bit (and (node_eq transition
                    (lwgl-transition-for-outcome feedback))
                (eq (lwo-active? plan-world transition) 0)) 128)
        (add (lwglw-bit (and (eq (lwtf-integrated-current?
                    transition-world transition-candidate) 1)
                (node_eq transition-candidate
                    (lwt-proposal-candidate transition-proposal))) 256)
        (add (lwglw-bit (and (node_eq premature-expression (lwo-none))
                (not (node_eq expression (lwo-none)))) 512)
        (add (lwglw-bit (and (node_eq
                    (lwsl-observation-coordinate expression)
                    (lwglw-coordinate))
                (and (str_eq (lwsl-observation-surface expression) "new")
                     (and (node_eq (lwsl-observation-lens expression)
                                   (lwglw-declaration))
                          (eq (oac-one?
                                (lwsl-observation-ack expression)) 1)))) 1024)
        (add (lwglw-bit (and (eq (lwsl-integrated-current?
                    final-world symbol-candidate) 1)
                (node_eq symbol-candidate
                    (lwt-proposal-candidate symbol-proposal))) 2048)
        (add (lwglw-bit (and (eq (len after-turns) 1)
                (and (str_eq (lwsg-trace-rendered after) "new")
                     (eq (lwsg-completion?
                        (lwsg-trace-completion after) LWSG-TERMINAL) 1))) 4096)
        (add (lwglw-bit (and (node_eq (lwsg-trace-request before) request)
                (node_eq (lwsg-trace-request after) request)) 8192)
        (add (lwglw-bit (and (eq (lwsg-trace-current? final-world before) 0)
                (eq (lwsg-trace-current? final-world after) 1)) 16384)
        (add (lwglw-bit (and (eq (lwgl-candidate-active?
                    feedback-released-world candidate) 0)
                (node_eq after-feedback-release after)) 32768)
        (add (lwglw-bit (and (eq (lwsg-trace-current?
                    transition-released-world after) 0)
                (and (eq (oac-nothing?
                    (lwsg-trace-ack after-transition-release)) 1)
                     (eq (len (lwsg-turn-items
                        (lwsg-trace-turns after-transition-release))) 0))) 65536)
        (add (lwglw-bit (and (eq (lwgl-outcome-valid? silence) 1)
                (node_eq (lwgl-transition-for-outcome silence)
                    (lwo-none))) 131072)
        (add (lwglw-bit (and (eq (lwgl-one-coherent? invalid) 0)
                (eq (lwgl-ack-coherent? invalid) 0)) 262144)
        (lwglw-bit (ge (len events) 5) 524288))))))))))))))))))))))
