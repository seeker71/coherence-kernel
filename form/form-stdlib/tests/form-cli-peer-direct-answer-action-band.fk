; form-cli-peer-direct-answer-action-band.fk -- direct answer is an effect
; born beside recipe/source effects, not a prompt-level special case.
;
; PROOF BAND (fkwu): 4095
; preludes: form-stdlib/form-cli-peer-direct-answer-action.fk

(do
    (defn fcpdaab-bit (ok bit) (if ok bit 0))
    (defn fcpdaab-live ()
        (fcms-session "live" "held" "local.gguf" "src"
            (list "ctx") (list "state") 128 7 11 0 5 3 2 1))
    (defn fcpdaab-generated (session text ids)
        (fcms-generation text ids session))
    (defn fcpdaab-embodied-prompt ()
        "show me that you can use 10% of normal token to get the same prompt done through form-cli. use BML for new code, use cache, use metal, use JIT, dissolve limits, place missing stones, use framebuffer, measure observe optimize, avoid external tools, minimize membrane crossing, use substrate knowledge of hyper fast knowing, prefer embodied knowing over thinking and reasoning, invent new grammar, lift low level to high level knowing")
    (defn fcpdaab-control-retry? (control stopped-failure)
        (and (eq (fcpdaa-control-response? "<FAIL>") 1)
        (and (eq (fcpdaa-control-response? "<STOP>") 1)
        (and (eq (fcpdaa-control-response? "answer") 0)
        (and (str_eq (fcpdaa-signal control) "failure")
        (and (str_eq (fcpdaa-reason control) "direct-answer-model-control")
        (and (str_eq (fcpdaa-lifecycle control) "failure,release")
             (and (eq (fcpdaa-retryable? control) 1)
                  (eq (fcpdaa-retryable? stopped-failure) 0)))))))))
    (defn form-cli-peer-direct-answer-action-band ()
        (do
            (let live (fcpdaab-live))
            (let malformed (fcpdaa-run live "research" "answer" 8))
            (let unavailable (fcpdaa-run (fcms-none "absent")
                "direct-answer" "answer" 8))
            (let finished (fcpdaa-finish live
                (fcpdaab-generated live "(add 40 2)" (list 7 8)) 9))
            (let empty (fcpdaa-finish live
                (fcpdaab-generated live "" (list)) 10))
            (let control (fcpdaa-finish live
                (fcpdaab-generated live "<FAIL>" (list 9)) 11))
            (let completed (fcpdaa-finish live
                (fcpdaab-generated live
                    "<think>\n\n</think>\n\n<CHOICE>\nroute: local Form-cli first; BML: authority; cache/JIT: warm; evidence: observed; next gap: none.\n<STOP>"
                    (list 1 2 3)) 12))
            (let stopped (fcms-session "live" "held" "local.gguf" "src"
                (list "ctx") (list "state") 128 7 11 1 5 3 2 1))
            (let stopped-failure (fcpdaa-result stopped "<FAIL>" 11
                "failure" "direct-answer-model-control" 1))
            (let peer (fcpdaa-peer finished))
            (let stage (fcpdaa-stage-node "run" "value" 2 11))
            (let line (fcpdaa-stage-line "run" "value" 2 11))
            (sum (list
                (fcpdaab-bit (and (eq (fcpdaa-kind? "direct-answer") 1)
                    (and (eq (fcpdaa-task-shape? "direct-answer" "answer") 1)
                         (eq (fcpdaa-task-shape? "direct-answer" "") 0))) 1)
                (fcpdaab-bit (and (str_eq (fcpdaa-signal malformed) "choice")
                    (and (str_eq (fcpdaa-reason malformed)
                            "direct-answer-requires-nonempty-direct-answer-task")
                         (value_eq (fcpdaa-session malformed) live))) 2)
                (fcpdaab-bit (and (str_eq (fcpdaa-signal unavailable) "nothing")
                    (and (str_eq (fcpdaa-reason unavailable) "model-session-not-live")
                         (not (eq (fcms-live? (fcpdaa-session unavailable)) 1)))) 4)
                (fcpdaab-bit (and (eq (fcpdaa-result? finished) 1)
                    (and (str_eq (fcpdaa-signal finished) "value")
                    (and (str_eq (fcpdaa-response finished) "(add 40 2)")
                    (and (eq (fcpdaa-generated-tokens finished) 2)
                         (value_eq (fcpdaa-session finished) live))))) 8)
                (fcpdaab-bit (and (str_eq (fcpdaa-signal empty) "nothing")
                    (and (str_eq (fcpdaa-reason empty) "direct-answer-empty-or-stop")
                         (eq (fcpdaa-generated-tokens empty) 0))) 16)
                (fcpdaab-bit (and (str_eq (fcpa-route peer) "direct-answer")
                    (and (eq (fcpa-contribution peer) 0)
                    (and (eq (fcpa-callback-calls peer) 0)
                    (and (eq (fcpa-native-code-generated? peer) 0)
                    (and (eq (fcpa-injected-bytes peer) 0)
                    (and (eq (fcpa-lookup-count peer) 0)
                    (and (str_eq (fcpa-tool-status peer)
                            "value;tokens=2;pos=7;pending=11;stopped=0;observations=1")
                         (str_eq (fcpa-carrier peer) "form-native-metal-jit")))))))) 32)
                (fcpdaab-bit (and (node_eq (node_category stage)
                            (fcpdaa-stage-category))
                    (and (eq (len (node_children stage)) 5)
                    (and (ge (str_find line
                        "route=direct-answer phase=run status=value generated=2" 0) 0)
                         (lt (str_find line "(add 40 2)" 0) 0)))) 64)
                (fcpdaab-bit (and (str_eq (fcpdaa-lifecycle malformed)
                            "choice,release")
                    (and (str_eq (fcpdaa-lifecycle empty) "nothing,release")
                         (str_eq (fcpdaa-lifecycle finished) "generate,release"))) 128)
                (fcpdaab-bit (and (fcpdaab-control-retry? control stopped-failure)
                    (and (eq (fcpdaa-control-response?
                        "<think>\\n\\n</think>\\n\\n<FAIL>") 1)
                         (eq (fcpdaa-control-response?
                            "answer mentioning <FAIL> is reserved") 1))) 256)
                (fcpdaab-bit (and (str_eq (fcpdaa-observation-lane) "direct-user")
                    (and (str_eq (fcpdaa-observation-lane-for
                        (fcpdaab-embodied-prompt))
                        "embodied-goal-bml-direct-user")
                         (str_eq (fcms-direct-user-role) "user"))) 512)
                (fcpdaab-bit (and (eq (fcpdag-embodied-goal?
                    (fcpdaab-embodied-prompt)) 1)
                    (and (lt (str_len (fcpdag-observation
                        (fcpdaab-embodied-prompt)))
                        (str_len (fcpdaab-embodied-prompt)))
                    (and (ge (str_find (fcpdag-observation
                        (fcpdaab-embodied-prompt))
                        "five compact clauses" 0) 0)
                         (eq (fcpdag-embodied-goal? "ordinary question") 0)))) 1024)
                (fcpdaab-bit (and (str_eq (fcpdaa-signal completed) "value")
                    (and (str_eq (fcpdaa-response completed)
                        "route: local Form-cli first; BML: authority; cache/JIT: warm; evidence: observed; next gap: none.\n")
                    (and (eq (fcpdaa-generated-tokens completed) 3)
                    (and (eq (fcpdag-failure-control? (fcpdaa-response control)) 1)
                    (and (eq (fcpdag-stop-control? "<STOP>") 1)
                         (eq (fcpdag-answer-shaped?
                            "route: r; BML: b; cache/JIT: c; evidence: e; next gap: n") 1)))))) 2048)))))

    (form-cli-peer-direct-answer-action-band))
