; living-world-trace-voice-witness.fk -- participants teach the admitted
; execution predicate its own optional surfaces; the organ contains none.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-trace-relation.fk form-stdlib/living-world-trace-voice.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-trace-relation-witness.fk

(let LWTRVW-RELATION-COORD     (bp "LWTRVW-RELATION-COORD"))
(let LWTRVW-ALTERNATE-COORD    (bp "LWTRVW-ALTERNATE-COORD"))

(defn lwtrvw-cell (kind) (intern_node kind (empty)))
(defn lwtrvw-relation-coordinate ()
    (lwtrvw-cell LWTRVW-RELATION-COORD))
(defn lwtrvw-alternate-coordinate ()
    (lwtrvw-cell LWTRVW-ALTERNATE-COORD))
(defn lwtrvw-relation ()
    (lwo-relation-predicate
        (lwo-emergent-shape (lwtrw-edge-candidate))))

(defn lwtrvw-primary-observation ()
    (lwsl-observation-at (lwtrvw-relation)
        (lwtrvw-relation-coordinate) " becomes " (lwo-none)
        (oac-one (lwtrvw-relation)) (lwtrw-evidence)))
(defn lwtrvw-alternate-observation ()
    (lwsl-observation-at (lwtrvw-relation)
        (lwtrvw-alternate-coordinate) " yields " (lwo-none)
        (oac-one (lwtrvw-relation)) (lwtrw-evidence)))

(defn lwtrvw-observation-world ()
    (lwt-receive-stream (lwtrw-edge-world)
        (list
            (lwtrw-entry-c (lwtrvw-primary-observation))
            (lwtrw-entry-d (lwtrvw-primary-observation))
            (lwtrw-entry-c (lwtrvw-alternate-observation))
            (lwtrw-entry-d (lwtrvw-alternate-observation)))))

(defn lwtrvw-proposal-for-surface-items (items surface)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let proposal (head items))
            (let candidate (lwt-proposal-candidate proposal))
            (if (and (eq (lwsl-symbol-candidate? candidate) 1)
                     (str_eq
                        (lwnv-symbol-surface
                            (lwo-emergent-shape candidate)) surface))
                proposal
                (lwtrvw-proposal-for-surface-items
                    (tail items) surface)))))
(defn lwtrvw-proposal-for-surface (proposals surface)
    (lwtrvw-proposal-for-surface-items
        (lwo-field-items proposals) surface))

(defn lwtrvw-symbol-round-build ()
    (do
        (let world (lwtrvw-observation-world))
        (lwt-round world (lwsl-proposals world 2)
            (lwo-empty-field) (lwtrw-edge-integrated-round))))
(let LWTRVW-SYMBOL-ROUND-VALUE (lwtrvw-symbol-round-build))
(defn lwtrvw-symbol-round () LWTRVW-SYMBOL-ROUND-VALUE)
(defn lwtrvw-primary-proposal ()
    (lwtrvw-proposal-for-surface
        (lwt-round-proposals (lwtrvw-symbol-round)) " becomes "))
(defn lwtrvw-alternate-proposal ()
    (lwtrvw-proposal-for-surface
        (lwt-round-proposals (lwtrvw-symbol-round)) " yields "))
(defn lwtrvw-primary-symbol ()
    (lwt-proposal-candidate (lwtrvw-primary-proposal)))
(defn lwtrvw-alternate-symbol ()
    (lwt-proposal-candidate (lwtrvw-alternate-proposal)))

(defn lwtrvw-symbol-responses (proposal)
    (list
        (lwtrw-response (lwtrw-source-c) (lwtrw-prov-c) proposal)
        (lwtrw-response (lwtrw-source-d) (lwtrw-prov-d) proposal)))
(defn lwtrvw-symbol-yes-round-build ()
    (do
        (let round (lwtrvw-symbol-round))
        (let primary (lwtrvw-primary-proposal))
        (let alternate (lwtrvw-alternate-proposal))
        (lwt-round-receive round
            (append (lwtrvw-symbol-responses primary)
                (lwtrvw-symbol-responses alternate)))))
(defn lwtrvw-symbol-integrated-round-build ()
    (do
        (let round (lwtrvw-symbol-yes-round-build))
        (let primary
            (lwsl-integrate round (lwtrvw-primary-proposal)
                (lwtrw-action)))
        (lwsl-integrate primary (lwtrvw-alternate-proposal)
            (lwtrw-action))))
(let LWTRVW-SYMBOL-INTEGRATED-ROUND-VALUE
    (lwtrvw-symbol-integrated-round-build))
(defn lwtrvw-symbol-integrated-round ()
    LWTRVW-SYMBOL-INTEGRATED-ROUND-VALUE)
(defn lwtrvw-world ()
    (lwt-round-world (lwtrvw-symbol-integrated-round)))

(defn lwtrvw-primary-symbols ()
    (lwo-field (list (lwtrvw-primary-symbol))))
(defn lwtrvw-alternate-symbols ()
    (lwo-field (list (lwtrvw-alternate-symbol))))
(defn lwtrvw-ambiguous-symbols ()
    (lwo-field
        (list (lwtrvw-primary-symbol) (lwtrvw-alternate-symbol))))

(defn lwtrvw-proposal-for (world)
    (lwtv-proposal world (lwtrw-edge-candidate)
        (lwtrvw-primary-symbols) (lwo-empty-field)
        (lwo-none) (lwo-none) (lwtrw-evidence)))
(defn lwtrvw-proposal () (lwtrvw-proposal-for (lwtrvw-world)))
(defn lwtrvw-utterance ()
    (lwo-emergent-shape
        (lwt-proposal-candidate (lwtrvw-proposal))))
(defn lwtrvw-rich-utterance ()
    (lwtv-emit (lwtrvw-world) (lwtrw-edge-candidate)
        (lwtrvw-primary-symbols)
        (lwo-field (list (lwtrw-alternative)))
        (lwlc-unknown (lwtrw-evidence)) (lwtrw-choice)
        (lwtrw-evidence)))

(defn lwtrvw-round-build ()
    (do
        (let world (lwtrvw-world))
        (let proposal (lwtrvw-proposal-for world))
        (lwt-round world (lwo-field (list proposal))
            (lwo-empty-field) (lwtrvw-symbol-integrated-round))))
(let LWTRVW-ROUND-VALUE (lwtrvw-round-build))
(defn lwtrvw-round () LWTRVW-ROUND-VALUE)
(defn lwtrvw-yes-round-build ()
    (do
        (let round (lwtrvw-round))
        (lwt-round-receive round
            (lwtrw-edge-responses (lwtrvw-proposal)))))
(defn lwtrvw-integrated-round-build ()
    (do
        (let round (lwtrvw-yes-round-build))
        (lwtv-integrate round (lwtrvw-proposal) (lwtrw-action))))
(let LWTRVW-INTEGRATED-ROUND-VALUE
    (lwtrvw-integrated-round-build))
(defn lwtrvw-integrated-round () LWTRVW-INTEGRATED-ROUND-VALUE)
(defn lwtrvw-integrated-world ()
    (lwt-round-world (lwtrvw-integrated-round)))

(defn lwtrvw-revoked-world ()
    (lwt-receive-stream (lwtrvw-integrated-world)
        (list
            (lwtrw-entry-e
                (lwo-revocation (lwtrw-minimal-offer)
                    (lwtrw-source-e) (lwtrw-reason)
                    (lwtrw-prov-e))))))

0
