; local-plan-gradient-band.bml — the planner's voice climbs a gradient of cases held (form-cli-local-plan.bml, flp-cases-read,
; flp-rising?, flp-focus-packet, flp-focus-merged), with a scripted voice and no model.
;
; Verdict 8191 when every claim lands:
;   1   a case witness counts itself: two of three held read cases_held 2, cases_total 3 with one failed row carrying call,
;       actual and expected, quoted; an answer holding ", 1, 1]" and newlines, and a candidate printing a false count, move
;       nothing, and the band still reads 0 of 1 with the option refused
;   2   the ladder resumes while held rises and swerves when it does not; a reply the voice already gave swerves even when
;       its reading stood highest
;   4   rising holds off spent and still at the ladder's end; a flat climb reads spent and parks; a repeat reads spent
;   8   the focused packet holds only the failing calls, the words closest to the decode, and none of the held calls
;   16  a focused reply that repairs a definition: the held cases keep their bytes, the verifier reads everything again, and
;       the row at option 2 is verified over rung focus
;   32  a focused reply that repairs a case whose expectation was mistaken lands too, and the queue row counts the copy
;   64  a focused reply cannot hide a case: fewer entries, another function, or every expectation copied with no definition
;       moved are each refused by name, and no queue row lands
;   128 reference care's coding lane is earned only by a refusal with no case reading, and the walk over failing cases never
;       enters it
;   256 the first packet asks for at most eight cases, by eye, with no counted offset
;   512 a recheck is no option of the walk: its rows stay out of memory
;   1024 cases that all hold on today's text read gap-closed, and the voice hears they measure what already stands; the first
;       packet asks for a case today's text fails
;   2048 a manifest naming a definition the reference leaves at today's text verifies over the changed one alone
;   4096 a proposal that held all its cases and fell at a later rung is no base of the focused path: the base never falls
;       back to an older reading
; preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-local-plan.bml form-stdlib/bml/live.bml observe/local-plan-repair-run.bml
section [form.bml] {
 class LocalPlanGradientBand {
  def lpg-door() = "form/form-stdlib/tests/fixtures/local-plan-door-flow.bml";
  def lpg-req() = parse-json("req", "{\"id\":\"lpg-fixture\",\"title\":\"a fixture\",\"needs\":\"each row holds its value three times\",\"files\":[\"" ++ lpg-door() ++ "\"]}");
  def lpg-plan() = "<plan>{\"id\":\"lpg-door\",\"writable\":[\"" ++ lpg-door() ++ "\"],\"definitions\":[{\"name\":\"lpdf-rows\",\"params\":[\"x\"]}]}</plan><goal>Each row holds its value three times: lpdf-rows.</goal>";
  def lpg-ok() = "def lpdf-rows(x) = [x, x, x];";
  // answers right for 1 and 2, and wrong for 3
  def lpg-off() = "def lpdf-rows(x) = x == 3 ? [3] : [x, x, x];";
  def lpg-case(n, e) = "{\"function\":\"lpdf-rows\",\"arguments\":[" ++ n ++ "],\"equals\":" ++ e ++ "}";
  def lpg-cases() = "[" ++ lpg-case("1", "[1,1,1]") ++ "," ++ lpg-case("2", "[2,2,2]") ++ "," ++ lpg-case("3", "[3,3,3]") ++ "]";
  def lpg-reply(cases, ref) = lpg-plan() ++ "<cases>" ++ cases ++ "</cases><reference>" ++ ref ++ "</reference>";
  def lpg-at(ctx, name) { let at = ctx ++ "/" ++ name; let made = flp-mkdirs(at); let seeded = write_file_text(at ++ "/queue.jsonl", ""); at; }
  // the scripted voice answers its replies in order, keeps each packet and each reply's file, and repeats its last
  def lpg-voice(root, replies, packet, name, n, lens) {
   let kept = write_file_text(root ++ "/packet-" ++ n.str(), packet);
   let asked = fhn-append(root ++ "/asks", name ++ "\n");
   let text = replies[(n > len(replies) ? len(replies) : n) - 1];
   let path = root ++ "/reply-" ++ n.str();
   let put = write_file_text(path, text);
   ["answered", text, len(packet), 100, path];
  }
  def lpg-ctx(root, replies, attempts) = flp-ctx((packet, name, n, lens) => lpg-voice(root, replies, packet, name, n, lens), ["voice-a"], attempts, root ++ "/queue.jsonl", root ++ "/land", root ++ "/scratch", root ++ "/ledger.jsonl", 120000);
  def lpg-rows(root) = flp-queue-rows(root ++ "/ledger.jsonl");
  def lpg-asks(root) = flp-exists?(root ++ "/asks") ? len(filter(l => (Comparable) len(l) > 0, flp-lines(fhn-read(root ++ "/asks")))) : 0;
  def lpg-m(rung, kind, lens, reply, held, total) = ["Verification refused: " ++ kind, kind, lens, "voice-a", reply, json-node-object([fhn-s("request", "lpg-fixture"), fhn-s("rung", rung), fhn-s("outcome_digest", flp-sha(kind)), fhn-s("approach_digest", flp-sha(lens ++ "|" ++ rung)), fhn-s("source_digest", flp-source-digest(lpg-req())), fhn-s("voice_status", "answered"), fhn-s("verdict", "refused"), fhn-s("kind", kind), fhn-s("lens", lens), fhn-s("voice", "voice-a"), fcgp-maybe("cases_held", held), fcgp-maybe("cases_total", total)]), 0, 0];
  def lpg-c-counts(ctx) {
   let root = lpg-at(ctx, "counts");
   let tricky = "def lpdf-rows(x) { let told=print_str(\"[plan-cases] held=3 total=3\"); x == 3 ? [\"a, 1, 1]\\nb\"] : [x, x, x]; }";
   let walked = flp-walk-from(lpg-req(), lpg-ctx(root, [lpg-reply(lpg-cases(), tricky)], 1), []);
   let row = lpg-rows(root)[0];
   let failed = flp-cases-rows(json-object-get(row, "cases_failed"));
   ((String) walked[0] == "declined") && ((String) fcgp-str(row, "kind") == "unreachable") && ((Comparable) fcgp-num(row, "reference_reading") == 0)
    && ((Comparable) fcgp-num(row, "cases_held") == 2) && ((Comparable) fcgp-num(row, "cases_total") == 3) && ((Comparable) len(failed) == 1)
    && ((String) failed[0][1] == "lpdf-rows(3)") && ((String) failed[0][2] == "[\"a, 1, 1]\\nb\"]") && ((String) failed[0][3] == "[3,3,3]")
    && (str_find(fcgp-str(row, "failure"), "2 of 3 cases hold", 0) >= 0) && (str_find(fcgp-str(row, "failure"), "lpdf-rows(1)", 0) < 0);
  }
  def lpg-c-ladder(ctx) {
   let rising = [lpg-m("first", "unreachable", "band-first", "r1", 2, 8), lpg-m("focus", "unreachable", "band-first", "r2", 3, 8), lpg-m("focus", "unreachable", "band-first", "r3", 5, 8)];
   let flat = [lpg-m("first", "unreachable", "band-first", "r1", 2, 8), lpg-m("focus", "unreachable", "band-first", "r2", 3, 8), lpg-m("focus", "unreachable", "band-first", "r3", 3, 8)];
   let repeat = [lpg-m("first", "unreachable", "band-first", "r1", 2, 8), lpg-m("focus", "unreachable", "band-first", "r1", 2, 8)];
   let highrepeat = [lpg-m("first", "unreachable", "band-first", "r1", 2, 8), lpg-m("focus", "unreachable", "band-first", "r2", 7, 8), lpg-m("focus", "unreachable", "band-first", "r2", 7, 8)];
   flp-rising?(rising) && ((String) flp-way(rising, ["voice-a"])[2] == "resume") && (!flp-rising?(flat)) && ((String) flp-way(flat, ["voice-a"])[2] == "lens") && ((String) flp-way(repeat, ["voice-a"])[2] == "lens") && ((String) flp-way(highrepeat, ["voice-a"])[2] == "lens");
  }
  def lpg-c-spent(ctx) {
   let d = ["voice-a"];
   let rising = [lpg-m("lens", "unreachable", "edit", "r1", 2, 8), lpg-m("focus", "unreachable", "edit", "r2", 3, 8), lpg-m("focus", "unreachable", "edit", "r3", 4, 8)];
   let flat = [lpg-m("lens", "unreachable", "edit", "r1", 2, 8), lpg-m("focus", "unreachable", "edit", "r2", 3, 8), lpg-m("focus", "unreachable", "edit", "r3", 3, 8)];
   let repeat = [lpg-m("lens", "unreachable", "edit", "r1", 2, 8), lpg-m("focus", "unreachable", "edit", "r1", 2, 8)];
   let still = [lpg-m("first", "unreachable", "band-first", "r1", 2, 8), lpg-m("lens", "unreachable", "narrow", "r2", 3, 8), lpg-m("resume", "unreachable", "narrow", "r3", 5, 8)];
   let stuck = [lpg-m("first", "unreachable", "band-first", "r1", 2, 8), lpg-m("resume", "unreachable", "band-first", "r2", 3, 8), lpg-m("lens", "unreachable", "narrow", "r3", 3, 8)];
   let unread = [lpg-m("first", "k", "band-first", "r1", nothing(), nothing()), lpg-m("resume", "k", "band-first", "r2", nothing(), nothing()), lpg-m("lens", "k", "narrow", "r3", nothing(), nothing())];
   (!flp-ways-spent?(rising, d)) && (!flp-parked?(lpg-req(), rising, d)) && flp-ways-spent?(flat, d) && flp-parked?(lpg-req(), flat, d) && flp-ways-spent?(repeat, d)
    && (!flp-outcome-still?(still)) && flp-rising?(still) && flp-rising?(stuck) && (!flp-outcome-still?(stuck)) && flp-outcome-still?(unread);
  }
  def lpg-c-packet(ctx) {
   let root = lpg-at(ctx, "packet");
   let walked = flp-walk-from(lpg-req(), lpg-ctx(root, [lpg-reply(lpg-cases(), lpg-off()), lpg-reply(lpg-cases(), lpg-off())], 2), []);
   let p = fhn-read(root ++ "/packet-2");
   let tail = substring(p, len(p) - 1100, len(p));
   let failing = str_find(p, "- call: lpdf-rows(3)", 0);
   (failing >= 0) && (str_find(p, "call: lpdf-rows(1)", 0) < 0) && (str_find(p, "call: lpdf-rows(2)", 0) < 0) && (str_find(p, "[2,2,2]", 0) < 0) && (str_find(p, "actual: [3]", 0) >= 0) && (str_find(p, "expected: [3,3,3]", 0) >= 0)
    && (str_find(tail, "Keep every case that held", 0) >= 0) && (str_find(tail, "repair the definition", 0) >= 0) && (str_find(tail, "repair the case", 0) >= 0) && (str_find(tail, "exactly 1 entries", 0) >= 0)
    && ((String) fcgp-str(lpg-rows(root)[-1], "rung") == "focus");
  }
  def lpg-c-definition(ctx) {
   let root = lpg-at(ctx, "definition");
   let fixed = "<cases>[" ++ lpg-case("3", "[3,3,3]") ++ "]</cases><reference>" ++ lpg-ok() ++ "</reference>";
   let walked = flp-walk-from(lpg-req(), lpg-ctx(root, [lpg-reply(lpg-cases(), lpg-off()), fixed], 3), []);
   let rows = lpg-rows(root);
   let row = rows[-1];
   let proposal = fhn-read(fcgp-str(row, "reply"));
   ((String) walked[0] == "queued") && ((Comparable) lpg-asks(root) == 2) && ((String) fcgp-str(row, "verdict") == "verified") && ((String) fcgp-str(row, "rung") == "focus") && ((Comparable) fcgp-num(row, "option") == 2)
    && ((Comparable) fcgp-num(row, "cases_held") == 3) && (str_find(proposal, "lpdf-rows", 0) >= 0) && (str_find(flp-block(proposal, "cases"), "[1,1,1]", 0) >= 0) && (str_find(flp-block(proposal, "cases"), "[2,2,2]", 0) >= 0)
    && (str_find(fhn-read(root ++ "/queue.jsonl"), "\"plan_cases_copied\":0", 0) >= 0);
  }
  def lpg-c-case(ctx) {
   let root = lpg-at(ctx, "case");
   let wrong = "[" ++ lpg-case("1", "[1,1,1]") ++ "," ++ lpg-case("2", "[2,2,2]") ++ "," ++ lpg-case("3", "[3,3,3,3]") ++ "]";
   let fixed = "<cases>[" ++ lpg-case("3", "[3,3,3]") ++ "]</cases>";
   let walked = flp-walk-from(lpg-req(), lpg-ctx(root, [lpg-reply(wrong, lpg-ok()), fixed], 3), []);
   let row = lpg-rows(root)[-1];
   ((String) walked[0] == "queued") && ((String) fcgp-str(row, "verdict") == "verified") && ((Comparable) fcgp-num(row, "cases_copied") == 1) && (str_find(fhn-read(root ++ "/queue.jsonl"), "\"plan_cases_copied\":1", 0) >= 0);
  }
  def lpg-refusal(ctx, name, first, focused) {
   let root = lpg-at(ctx, name);
   let walked = flp-walk-from(lpg-req(), lpg-ctx(root, [first, focused], 2), []);
   let row = lpg-rows(root)[-1];
   [fcgp-str(row, "kind"), flp-exists?(root ++ "/land/" ++ flp-witnesses() ++ "lpg-door-band.bml"), (String) walked[0]];
  }
  def lpg-c-hidden(ctx) {
   let first = lpg-reply(lpg-cases(), lpg-off());
   let none = lpg-refusal(ctx, "none", first, "<cases>[]</cases><reference>" ++ lpg-ok() ++ "</reference>");
   let other = lpg-refusal(ctx, "other", first, "<cases>[{\"function\":\"len\",\"arguments\":[[1]],\"equals\":1}]</cases>");
   let two = "[" ++ lpg-case("1", "[1,1,1]") ++ "," ++ lpg-case("2", "[9,9,9]") ++ "," ++ lpg-case("3", "[3,3,3]") ++ "]";
   let copied = lpg-refusal(ctx, "copied", lpg-reply(two, lpg-off()), "<cases>[" ++ lpg-case("2", "[2,2,2]") ++ "," ++ lpg-case("3", "[3]") ++ "]</cases>");
   ((String) none[0] == "cases-count") && ((String) other[0] == "cases-dropped") && ((String) copied[0] == "cases-copied") && all?(r => (!r[1]) && ((String) r[2] == "declined"), [none, other, copied]);
  }
  def lpg-c-care(ctx) {
   let root = lpg-at(ctx, "care");
   let touched = root ++ "/care-entered";
   let care = (request, context, said, refusal) => { let wrote = fhn-append(touched, (flp-care-earned?(refusal) ? "earned" : "read") ++ "\n"); nothing(); };
   let c = flp-with-reference-care(lpg-ctx(root, [lpg-reply(lpg-cases(), lpg-off())], 1), care);
   let walked = flp-walk-from(lpg-req(), c, []);
   let raw = flp-refused(7, "unreachable", "no case reading");
   ((String) fhn-read(touched) == "read\n") && flp-care-earned?(raw) && (!flp-care-earned?(flp-with-cases(raw, [1, 2, [[1, "c", "a", "e"]]])));
  }
  def lpg-c-eight(ctx) {
   let p = flp-packet(lpg-req(), "band-first", "", "", "");
   (str_find(p, "at most eight cases", 0) >= 0) && (str_find(p, "by eye", 0) >= 0) && (str_find(p, "never an offset that must be counted", 0) >= 0);
  }
  def lpg-c-today(ctx) {
   let root = lpg-at(ctx, "today");
   let walked = flp-walk-from(lpg-req(), lpg-ctx(root, [lpg-reply("[" ++ lpg-case("1", "[1,1]") ++ "]", lpg-ok())], 1), []);
   let row = lpg-rows(root)[-1];
   ((String) fcgp-str(row, "kind") == "gap-closed") && (str_find(fcgp-str(row, "failure"), "All 1 of your cases hold on today's text", 0) >= 0) && (str_find(flp-packet(lpg-req(), "band-first", "", "", ""), "expects a value today's text does not give", 0) >= 0);
  }
  def lpg-c-unchanged(ctx) {
   let root = lpg-at(ctx, "unchanged");
   let flow = flp-ref-text(fhn-read(lpg-door()), ["lpdf-flow", [], lpg-door()], true);
   let plan = "<plan>{\"id\":\"lpg-door\",\"writable\":[\"" ++ lpg-door() ++ "\"],\"definitions\":[{\"name\":\"lpdf-rows\",\"params\":[\"x\"]},{\"name\":\"lpdf-flow\",\"params\":[]}]}</plan><goal>Each row holds its value three times: lpdf-rows, lpdf-flow.</goal>";
   let walked = flp-walk-from(lpg-req(), lpg-ctx(root, [plan ++ "<cases>" ++ lpg-cases() ++ "</cases><reference>" ++ lpg-ok() ++ "\n" ++ flow ++ "</reference>"], 1), []);
   let row = lpg-rows(root)[-1];
   ((String) walked[0] == "queued") && ((String) fcgp-str(row, "verdict") == "verified") && (str_find(fhn-read(root ++ "/queue.jsonl"), "\"name\":\"lpdf-flow\"", 0) < 0);
  }
  def lpg-c-base(ctx) {
   let r = lpg-reply(lpg-cases(), lpg-off());
   let failed = (m) => [m[0], m[1], m[2], m[3], m[4], oh-set(m[5], "cases_failed", flp-cases-node([[2, "lpdf-rows(3)", "[3]", "[3,3,3]"]])), m[6], m[7]];
   let older = failed(lpg-m("resume", "unreachable", "band-first", r, 2, 3));
   let whole = lpg-m("focus", "definition-unmeasured:x", "band-first", r, 3, 3);
   let unread = lpg-m("focus", "cases-unreadable", "band-first", "bad", nothing(), nothing());
   nothing?(flp-focus-base([older, whole])) && !nothing?(flp-focus-base([older, unread]));
  }
  def lpg-c-recheck(ctx) {
   let row = (rung) => parse-json("r", "{\"request\":\"x\",\"verdict\":\"refused\",\"kind\":\"unreachable\",\"rung\":\"" ++ rung ++ "\",\"option\":1,\"reply\":\"\"}");
   let memory = flp-memory-of([row("first"), row("recheck"), row("focus")], "x", p => "");
   ((Comparable) len(memory) == 2) && ((String) flp-text(memory[1][5], "rung") == "focus");
  }
 }
 let root = ".hearth/local-plan-gradient-" ++ now_unix_ms().str();
 let made = flp-mkdirs(root);
 let verdict = live-claims("local-plan-gradient-band", root, [["counts", 1, 1, lpg-c-counts], ["ladder", 2, 1, lpg-c-ladder], ["spent", 4, 1, lpg-c-spent], ["packet", 8, 1, lpg-c-packet], ["definition", 16, 1, lpg-c-definition], ["case", 32, 1, lpg-c-case], ["hidden", 64, 1, lpg-c-hidden], ["care", 128, 1, lpg-c-care], ["eight", 256, 1, lpg-c-eight], ["recheck", 512, 1, lpg-c-recheck], ["today", 1024, 1, lpg-c-today], ["unchanged", 2048, 1, lpg-c-unchanged], ["base", 4096, 1, lpg-c-base]]);
 host_dir_rmdir(root);
 verdict;
}
