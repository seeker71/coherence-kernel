// Pure fixtures; no provider calls or state writes.
// preludes: form-stdlib/bml/form-cli-provider-notification.bml
section [form.bml] {
 class FormProviderNotificationBand {
  def fpnb-usage(input,cached,output,reasoning,total) = json-node-object(list(json-node-pair("inputTokens",json-node-int(input)),json-node-pair("cachedInputTokens",json-node-int(cached)),json-node-pair("outputTokens",json-node-int(output)),json-node-pair("reasoningOutputTokens",json-node-int(reasoning)),json-node-pair("totalTokens",json-node-int(total))));
  def fpnb-event(thread,turn,total) {
   let usage = json-node-object(list(json-node-pair("total",total),json-node-pair("last",total)));
   let params = json-node-object(list(json-node-pair("threadId",json-node-string(thread)),json-node-pair("turnId",json-node-string(turn)),json-node-pair("tokenUsage",usage)));
   json-node-object(list(json-node-pair("method",json-node-string("thread/tokenUsage/updated")),json-node-pair("params",params)));
  }
  def fpnb-demand(yes,reason) = if yes then 1 else form_error(reason);
  def fpnb-run() {
   let initialState = fpn-empty("owned-thread","owned-turn");
   let total = fpnb-usage(100,60,20,7,125);
   let event = fpnb-event("owned-thread","owned-turn",total);
   let first = fpn-event(initialState,event);
   let replay = fpn-event(first,event);
   let report = fpn-report(replay);
   let wire = str_concat(json-emit(event),"\n");
   let split = fpn-lines(initialState,substring(wire,0,17),0);
   let joined = fpn-lines(head(split),str_concat(nth(split,1),substring(wire,17,str_len(wire))),0);
   fpnb-demand(and(value_eq(head(joined),first),str_eq(nth(joined,1),"")),"split notification lost bytes or changed its meaning");
   fpnb-demand(and(eq(fpn-num(report,"total_tokens"),125),eq(fpn-num(report,"usage_notifications"),2)),"duplicate cumulative notifications were added or hidden");
   fpnb-demand(and(eq(fpn-num(report,"uncached_input_tokens"),40),eq(fpn-num(report,"unattributed_tokens"),5)),"snapshot quantities lost their distinct scopes");
   fpnb-demand(and(str_eq(json-emit(json-object-get(report,"whole_session_tokens")),"null"),str_eq(json-emit(json-object-get(report,"model_calls")),"null")),"notification count became model calls or partial usage became full cost");
   fpnb-demand(str_eq(json-emit(json-object-get(report,"cache_write_input_tokens")),"null"),"missing optional quantity became zero");
   fpnb-demand(value_eq(fpn-event(first,fpnb-event("other","owned-turn",total)),first),"another thread contaminated owned usage");
   fpnb-demand(value_eq(fpn-event(first,fpnb-event("owned-thread","other",total)),first),"another turn contaminated owned usage");
   let nested = json-node-object(list(json-node-pair("method",json-node-string("item/completed")),json-node-pair("params",event)));
   fpnb-demand(value_eq(fpn-event(first,nested),first),"nested tool data became usage");
   let decreased = fpn-event(first,fpnb-event("owned-thread","owned-turn",fpnb-usage(90,60,20,7,115)));
   fpnb-demand(str_eq(nth(decreased,4),"cumulative-usage-regressed"),"regression was accepted");
   let after = fpn-event(decreased,fpnb-event("owned-thread","owned-turn",fpnb-usage(200,120,40,14,250)));
   fpnb-demand(and(eq(nth(after,2),1),eq(fpn-num(nth(after,3),"totalTokens"),125)),"invalid stream resumed silently");
   fpnb-demand(not(fpn-valid-usage(fpnb-usage(3,4,2,1,5))),"cached input exceeded input");
   fpnb-demand(not(fpn-valid-usage(fpnb-usage(3,0,2,3,5))),"reasoning exceeded output");
   fpnb-demand(not(fpn-valid-usage(fpnb-usage(3,0,2,1,4))),"reported total did not cover input and output");
   fpnb-demand(str_eq(nth(fpn-line(first,"{bad}"),4),"invalid-json"),"malformed row was accepted");
   fpnb-demand(str_eq(nth(fpn-event(fpn-empty("",""),event),4),"missing-correlation"),"uncorrelated usage became observed");
   fpnb-demand(str_eq(json-emit(json-object-get(fpn-report(initialState),"total_tokens")),"null"),"missing usage became zero");
   let grown = fpn-event(first,fpnb-event("owned-thread","owned-turn",fpnb-usage(200,120,40,14,250)));
   fpnb-demand(eq(fpn-num(fpn-report(grown),"total_tokens"),250),"new cumulative snapshot was not selected");
   1;
  }
 }
 fpnb-run();
}
