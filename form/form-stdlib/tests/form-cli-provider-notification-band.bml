// Pure fixtures; no provider calls or state writes.
// preludes: form-stdlib/bml/form-cli-provider-usage-replay.bml
section [form.bml] {
 class FormProviderNotificationBand {
  def fpnb-usage(input,cached,output,reasoning,total) = json-node-object(list(json-node-pair("inputTokens",json-node-int(input)),json-node-pair("cachedInputTokens",json-node-int(cached)),json-node-pair("outputTokens",json-node-int(output)),json-node-pair("reasoningOutputTokens",json-node-int(reasoning)),json-node-pair("totalTokens",json-node-int(total))));
  def fpnb-event-last(thread,turn,total,last) {
   let usage = json-node-object(list(json-node-pair("total",total),json-node-pair("last",last)));
   let params = json-node-object(list(json-node-pair("threadId",json-node-string(thread)),json-node-pair("turnId",json-node-string(turn)),json-node-pair("tokenUsage",usage)));
   json-node-object(list(json-node-pair("method",json-node-string("thread/tokenUsage/updated")),json-node-pair("params",params)));
  }
  def fpnb-event(thread,turn,total) = fpnb-event-last(thread,turn,total,total);
  def fpnb-demand(yes,reason) = if yes then 1 else form_error(reason);
  def fpnb-writes(total,writes) = json-node-object(append(json-object-pairs(total),list(json-node-pair("cacheWriteInputTokens",json-node-int(writes)))));
  def fpnb-run() {
   let initialState = fpn-empty("owned-thread","owned-turn");
   let total = fpnb-usage(100,60,20,7,125);
   let event = fpnb-event("owned-thread","owned-turn",total);
   let first = fpn-event(initialState,event);
   let replay = fpn-event(first,event);
   let report = fpn-report(replay);
   let wire = str_concat(json-emit(event),"\n");
   let split = fpn-lines(initialState,substring(wire,0,17),0);
   let joined = fpn-lines(head(split),str_concat(nth(split,1),substring(wire,17,str_len(wire))),0);
   fpnb-demand(and(value_eq(head(joined),first),str_eq(nth(joined,1),"")),"split notification lost bytes or changed its meaning");
   fpnb-demand(and(eq(fpn-num(report,"total_tokens"),125),eq(fpn-num(report,"usage_notifications"),2)),"duplicate cumulative notifications were added or hidden");
   fpnb-demand(and(eq(fpn-num(report,"uncached_input_tokens"),40),eq(fpn-num(report,"unattributed_tokens"),5)),"snapshot quantities lost their distinct scopes");
   fpnb-demand(and(str_eq(json-emit(json-object-get(report,"whole_session_tokens")),"null"),str_eq(json-emit(json-object-get(report,"model_calls")),"null")),"notification count became model calls or partial usage became full cost");
   fpnb-demand(str_eq(json-emit(json-object-get(report,"cache_write_input_tokens")),"null"),"missing optional quantity became zero");
   fpnb-demand(value_eq(fpn-event(first,fpnb-event("other","owned-turn",total)),first),"another thread contaminated owned usage");
   fpnb-demand(value_eq(fpn-event(first,fpnb-event("owned-thread","other",total)),first),"another turn contaminated owned usage");
   let nested = json-node-object(list(json-node-pair("method",json-node-string("item/completed")),json-node-pair("params",event)));
   fpnb-demand(value_eq(fpn-event(first,nested),first),"nested tool data became usage");
   let decreased = fpn-event(first,fpnb-event("owned-thread","owned-turn",fpnb-usage(90,60,20,7,115)));
   fpnb-demand(str_eq(nth(decreased,4),"cumulative-usage-regressed"),"regression was accepted");
   let after = fpn-event(decreased,fpnb-event("owned-thread","owned-turn",fpnb-usage(200,120,40,14,250)));
   fpnb-demand(and(eq(nth(after,2),1),eq(fpn-num(nth(after,3),"totalTokens"),125)),"invalid stream resumed silently");
   fpnb-demand(not(fpn-valid-usage(fpnb-usage(3,4,2,1,5))),"cached input exceeded input");
   fpnb-demand(not(fpn-valid-usage(fpnb-usage(3,0,2,3,5))),"reasoning exceeded output");
   fpnb-demand(not(fpn-valid-usage(fpnb-usage(3,0,2,1,4))),"reported total did not cover input and output");
   fpnb-demand(str_eq(nth(fpn-line(first,"{bad}"),4),"invalid-json"),"malformed row was accepted");
   fpnb-demand(str_eq(nth(fpn-event(fpn-empty("",""),event),4),"missing-correlation"),"uncorrelated usage became observed");
   fpnb-demand(str_eq(json-emit(json-object-get(fpn-report(initialState),"total_tokens")),"null"),"missing usage became zero");
   let grown = fpn-event(first,fpnb-event("owned-thread","owned-turn",fpnb-usage(200,120,40,14,250)));
   fpnb-demand(eq(fpn-num(fpn-report(grown),"total_tokens"),250),"new cumulative snapshot was not selected");
   let written = fpn-event(initialState,fpnb-event("owned-thread","owned-turn",fpnb-writes(total,5)));
   let writeRegression = fpnb-event("owned-thread","owned-turn",fpnb-writes(fpnb-usage(200,120,40,14,250),3));
   let rejectedWrite = fpn-event(written,writeRegression);
   fpnb-demand(and(str_eq(nth(rejectedWrite,4),"cumulative-usage-regressed"),eq(fpn-num(fpn-report(rejectedWrite),"cache_write_input_tokens"),5)),"optional cumulative cache writes regressed silently");
   let omittedWrite = fpn-event(written,fpnb-event("owned-thread","owned-turn",fpnb-usage(150,90,30,10,190)));
   fpnb-demand(str_eq(json-emit(json-object-get(fpn-report(omittedWrite),"cache_write_input_tokens")),"null"),"missing cache writes became an invented quantity");
   fpnb-demand(str_eq(nth(fpn-event(omittedWrite,writeRegression),4),"cumulative-usage-regressed"),"a missing optional field erased its known cumulative floor");
   let writeGrowth = fpn-event(omittedWrite,fpnb-event("owned-thread","owned-turn",fpnb-writes(fpnb-usage(200,120,40,14,250),7)));
   fpnb-demand(eq(fpn-num(fpn-report(writeGrowth),"cache_write_input_tokens"),7),"cache-write growth after missing data was rejected");
   let smallerLast = fpn-event(first,fpnb-event-last("owned-thread","owned-turn",fpnb-usage(200,120,40,14,250),fpnb-usage(50,20,10,3,60)));
   fpnb-demand(and(str_eq(nth(smallerLast,4),"observed-prefix"),eq(fpn-num(fpn-report(smallerLast),"total_tokens"),250)),"a smaller per-call snapshot was mistaken for cumulative regression");
   let writesSeparate = fpn-report(fpn-event(initialState,fpnb-event("owned-thread","owned-turn",fpnb-writes(fpnb-usage(100,50,10,2,110),10))));
   fpnb-demand(and(eq(fpn-num(writesSeparate,"uncached_input_tokens"),50),eq(fpn-num(writesSeparate,"cache_write_input_tokens"),10)),"cache writes changed the defined input-minus-cache-hit quantity");
   let wideWire = json-emit(fpnb-event("owned-thread","owned-turn",fpnb-usage(4294967296,0,0,0,4294967296)));
   let wide = fpn-report(fpn-line(initialState,wideWire));
   fpnb-demand(and(str_eq(fpn-str(wide,"status"),"observed-prefix"),eq(fpn-num(wide,"total_tokens"),4294967296)),"wide JSON integer lost its native quantity");
   let proposal = json-node-object(list(fpur-s("thread_id","owned-thread"),fpur-s("turn_id","owned-turn"),json-node-pair("events",json-node-array(list(event,fpnb-event("owned-thread","owned-turn",fpnb-usage(90,60,20,7,115))))),fpur-s("claimed_status","observed-prefix")));
   let replayed = fpur-run(proposal);
   fpnb-demand(and(eq(fpn-num(replayed,"claim_matches"),0),str_eq(fpn-str(frte-json-object-field(replayed,"actual"),"status"),"cumulative-usage-regressed")),"replay accepted a model claim contradicted by the actual reader");
   fpnb-demand(eq(len(json-array-elements(json-object-get(replayed,"steps"))),2),"replay lost a per-event transition");
   let noClaim = json-node-object(list(fpur-s("thread_id","owned-thread"),fpur-s("turn_id","owned-turn"),json-node-pair("events",json-node-array(list(event)))));
   fpnb-demand(str_eq(json-emit(json-object-get(fpur-run(noClaim),"claim_matches")),"null"),"absent replay claim became a verdict");
   let reviewed = json-emit(json-node-object(list(json-node-pair("findings",json-node-array(list(json-node-object(list(json-node-pair("sequence",proposal)))))))));
   fpnb-demand(eq(head(fpur-check-text(reviewed)),0),"native review callback accepted a contradicted sequence");
   fpnb-demand(str_eq(fpn-str(fpur-run(json-node-object(list())),"status"),"proposal-invalid"),"unselected replay became observed");
   1;
  }
 }
 fpnb-run();
}
