; form-cli-bml-prefix-session-band.fk -- pure caller and signal shape.
;
; Expected: 8388607 (23 bits)
;
; preludes: form-stdlib/form-cli-bml-prefix-session.fk

(do
    (defn fcbpsb-bit (ok bit) (if ok bit 0))
    (defn fcbpsb-one (raw) (oac-one (intern_trivial_int (str_len raw))))
    (defn fcbpsb-zero (raw) (oac-zero))
    (defn fcbpsb-nothing (raw) (oac-nothing))
    (defn fcbpsb-run ()
        (do
            (let ctx (list "opaque-context"))
            (let sts (list "opaque-state"))
            (let session (fcms-session "live" "opened" "local.gguf" "src"
                ctx sts 2048 41 0 0 40 7 5 2))
            (let event0 (fcbps-event "accept" "viable-prefix" 0 1))
            (let event1 (fcbps-event-traced "undo" "malformed" 1 7
                (list (gsp-frame "rule" "section" 0 7 "no"))))
            (let complete-cursor (blc-result-cursor (blc-feed
                (blc-fresh 32 256) "def x() = 1;\n0;" 4096)))
            (let open-cursor (blc-result-cursor (blc-feed
                (blc-fresh 32 256) "def x(" 4096)))
            (let result (fcbps-result "complete" "semantic-one" session
                "def x() = 1;\n0;" (list 0 1) 8 1 2 0 3 2 1
                (oac-tag-one) (list event0 event1) complete-cursor))
            (let timeout-result (fcbps-result "timeout" "fuel-exhausted"
                session "def x(" (list 0) 2 0 0 1 0 0 0
                (oac-tag-nothing) (list event0) open-cursor))
            (let bounded-result (fcbps-result "bounded"
                "prediction-budget-exhausted" session "def x(" (list 0)
                2 0 0 0 0 0 0 (oac-tag-nothing) (list event0) open-cursor))
            (let capacity-result (fcbps-result "capacity"
                "material-capacity-needed" session "" (empty)
                1 0 0 0 0 0 0 (oac-tag-nothing) (list event0)
                (blc-fresh 8 4)))
            (let obs0 (fcbps-observation "failure" "malformed" 7 0
                "continue-from-checkpoint"))
            (let obs1 (fcbps-observation "nothing" "semantic-nothing" 19 1
                "replace-complete-module"))
            (sum (list
                (fcbpsb-bit (and (str_eq (fcbps-status result) "complete")
                    (str_eq (fcbps-reason result) "semantic-one")) 1)
                (fcbpsb-bit (and (eq (fcbps-offers result) 8)
                    (eq (fcbps-cuts result) 1)) 2)
                (fcbpsb-bit (and (eq (fcbps-undos result) 2)
                    (eq (fcbps-timeouts result) 0)) 4)
                (fcbpsb-bit (and (eq (fcbps-failures result) 3)
                    (eq (fcbps-refinements result) 2)) 8)
                (fcbpsb-bit (and (eq (fcbps-releases result) 1)
                    (eq (fcbps-semantic-kind result) (oac-tag-one))) 16)
                (fcbpsb-bit (and (eq (len (fcbps-attempt-ids result)) 2)
                    (eq (nth (fcbps-attempt-ids result) 0) 0)) 32)
                (fcbpsb-bit (and (eq (fcbps-event-token event0) 0)
                    (eq (fcbps-event-token event1) 1)) 64)
                (fcbpsb-bit (and (eq (fcms-pending session) 0)
                    (eq (fcms-pending? session) 1)) 128)
                (fcbpsb-bit (and (ge (str_find obs0
                        "accepted-prefix-bytes=7" 0) 0)
                    (ge (str_find obs0 "candidate-token-id=0" 0) 0)) 256)
                (fcbpsb-bit (and (ge (str_find obs1 "status=nothing" 0) 0)
                    (ge (str_find obs1 "replace-complete-module" 0) 0)) 512)
                (fcbpsb-bit (str_eq (fcbps-semantic-status
                    (fcbpsb-one "x")) "one") 1024)
                (fcbpsb-bit (str_eq (fcbps-semantic-status
                    (fcbpsb-zero "x")) "zero") 2048)
                (fcbpsb-bit (and (str_eq (fcbps-semantic-status
                        (fcbpsb-nothing "x")) "nothing")
                    (and (str_eq (fcbps-semantic-move
                            (fcbpsb-one "x")) "cut")
                    (and (str_eq (fcbps-semantic-move
                            (fcbpsb-zero "x")) "refine")
                         (str_eq (fcbps-semantic-move
                            (fcbpsb-nothing "x")) "hold")))) 4096)
                (fcbpsb-bit (and (str_eq (fcbps-event-kind event1) "undo")
                    (eq (fcbps-event-prefix-bytes event1) 7)) 8192)
                (fcbpsb-bit (and (eq (fcms-generated-ids
                        (fcbps-session result)) 7)
                    (eq (fcms-injected-ids (fcbps-session result)) 5)) 16384)
                (fcbpsb-bit (and (eq (fcms-model-executed-form?) 0)
                    (str_eq (fcms-rejection-pending-policy)
                        "discard-uncommitted-pending-id-before-typed-observation"))
                    32768)
                (fcbpsb-bit (and (str_eq (fcbps-semantic-move
                        (fcbpsb-one "x")) "cut")
                    (eq (fcbps-cuts result) 1)) 65536)
                (fcbpsb-bit (and (eq (fcbps-retryable? timeout-result) 1)
                    (and (eq (fcbps-retryable? result) 0)
                         (str_eq (fcbps-status (fcbps-retry-timeout result
                            9 2 4096 65536 fcbpsb-one)) "complete"))) 131072)
                (fcbpsb-bit (and (eq (fcbps-expandable? bounded-result) 1)
                    (and (eq (fcbps-expandable? result) 0)
                         (str_eq (fcbps-status (fcbps-expand result
                            9 2 4096 65536 fcbpsb-one)) "complete"))) 262144)
                (fcbpsb-bit (and (eq (len (fcbps-event-trace event1)) 1)
                    (and (str_eq (gsp-frame-kind
                            (head (fcbps-event-trace event1))) "rule")
                         (str_eq (gsp-frame-name
                            (head (fcbps-event-trace event1))) "section")))
                    524288)
                (fcbpsb-bit (and (str_eq (blc-status
                        (fcbps-cursor result)) "candidate")
                    (str_eq (blc-material (fcbps-cursor result))
                        (fcbps-prefix result))) 1048576)
                (fcbpsb-bit (and (eq
                        (fcbps-capacity-expandable? capacity-result) 1)
                    (eq (fcbps-capacity-expandable? result) 0)) 2097152)
                (fcbpsb-bit (and (eq (blc-material-cap
                        (blc-with-material-cap
                            (fcbps-cursor capacity-result) 64)) 64)
                    (node_eq (fcbps-retry-timeout result
                        9 2 4096 65536 fcbpsb-one) result)) 4194304)))))
    (fcbpsb-run))
