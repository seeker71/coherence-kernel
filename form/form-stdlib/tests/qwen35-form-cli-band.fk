; qwen35-form-cli-band.fk — keep the ordinary form-cli voice alive when the
; data-discovered Qwen3.8 model lane and the Form teaching layer join it.
;
; The band calls the stateful turn directly.  This separates a voice-graph
; defect from stdin/carrier effects before any model bytes are touched.
;
; preludes: form-stdlib/form-cli-repl.fk
;
; Verdict 255 when ping still answers, form-layer reports off / 8 / 11,
; and choose names a form task, a selected-model, and a local mode.
(do
    (let said (fc-turn "ping" "" "" (fcmr-none)))
    (let voice (nth said 0))
    (let layer-said (fc-turn "form-layer" "" "" (nth said 1)))
    (let layer (nth layer-said 0))
    (let choice-said (fc-turn "choose How does a Recipe differ from a Cell?" "" "" (nth layer-said 1)))
    (let choice (nth choice-said 0))
    (sum (list
        (if (str_eq voice "pong") 1 0)
        (if (ge (str_find layer "form-layer=off" 0) 0) 2 0)
        (if (ge (str_find layer "controls=8" 0) 0) 4 0)
        (if (ge (str_find layer "concepts=11" 0) 0) 8 0)
        (if (ge (str_find choice "choice-task=form" 0) 0) 16 0)
        (if (ge (str_find choice "choice-arch=" 0) 0) 32 0)
        (if (ge (str_find choice "selected-model=none" 0) 0) 64 0)
        (if (ge (str_find choice "choice-mode=form-native-generate" 0) 0) 128 0))))
