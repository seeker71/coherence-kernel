; glass-awareness-door-fit-band.bml — a door's bound is its surface's, not a number someone typed.
;
; preludes: form-stdlib/bml/form-glass-awareness.bml
;
; observe/form-glass-awareness-current-run.fk showed eight findings. The eight was honest about
; being a bound after 2026-09-10's heal, but nobody had ever asked whether eight was the right
; number. Measured on this checkout: the state held 24 — which is FGAMaxEvents, the shard's own
; declared ceiling, not an accident of arrival — every finding was at most 94 characters and so
; cost one row at the glass's own width of 100, the door's two chrome lines cost 4 rows of a
; 30-row surface, and all 24 fit in the remaining 26 with two rows to spare. The door was showing
; a third of what its surface could hold, and saying so precisely.
;
; So the bound follows the surface now, the same shape sparkWidth already takes from its width:
; rows the terminal has, less the door's own chrome, spent on the findings' own widths. The old
; eight is not thrown away — bit 128 pins where it was right. At 40 columns a 94-character
; finding costs three rows and exactly eight of them fit the same budget. Eight was one
; terminal's answer written down as every terminal's.
;
; Verdict 2047 when every claim lands:
;   1     a row cost is a ceiling: under the width is one row, exactly the width is one, one past it is two
;   2     a surface with no width still costs one row per line and never divides by nothing
;   4     the fit spends its budget in ROWS, not in line count
;   8     a line wider than the surface takes its several rows from the budget, or does not fit at all
;   16    the fit stops at the first line that does not fit; it never skips ahead to a shorter one
;   32    a surface smaller than the door's own chrome still shows one finding
;   64    the measured case: 24 findings of 94 characters, width 100, height 30, chrome 4 -> all 24
;   128   the same 24 at width 40, where each costs three rows -> exactly 8; eight was a 40-column answer
;   256   chrome is paid before findings: the same surface with more chrome shows fewer
;   512   the lengths a door measures are the lines' own, including an empty one
;   1024  the shard's ceiling is 24, and no surface however large makes the door claim more than is held

section [form.bml] {
    def gadf-bit(ok, weight) = if ok then weight else 0;
    def gadf-ns(n, v) = if le(n, 0) then list() else cons(v, gadf-ns(sub(n, 1), v));
    def gadf-score() {
        let wide = gadf-ns(24, 94);
        sum(list(
            gadf-bit(and(eq(fga-rows-for(94, 100), 1), and(eq(fga-rows-for(100, 100), 1), eq(fga-rows-for(101, 100), 2))), 1),
            gadf-bit(and(eq(fga-rows-for(50, 0), 1), eq(fga-rows-for(50, -1), 1)), 2),
            gadf-bit(and(eq(fga-fits(list(10, 10, 10), 100, 3, 0), 3), eq(fga-fits(list(10, 10, 10), 100, 2, 0), 2)), 4),
            gadf-bit(and(eq(fga-fits(list(150), 100, 1, 0), 0), eq(fga-fits(list(150), 100, 2, 0), 1)), 8),
            gadf-bit(and(eq(fga-fits(list(150, 10), 100, 2, 0), 1), eq(fga-fits(list(150, 10), 100, 1, 0), 0)), 16),
            gadf-bit(eq(fga-shown(list(10), 100, 2, 5), 1), 32),
            gadf-bit(eq(fga-shown(wide, 100, 30, 4), 24), 64),
            gadf-bit(and(eq(fga-rows-for(94, 40), 3), eq(fga-shown(wide, 40, 30, 4), 8)), 128),
            gadf-bit(and(eq(fga-shown(wide, 100, 30, 4), 24), eq(fga-shown(wide, 100, 30, 28), 2)), 256),
            gadf-bit(and(eq(nth(fga-lengths(list("abc", "de", "")), 0), 3), and(eq(nth(fga-lengths(list("abc", "de", "")), 1), 2), eq(nth(fga-lengths(list("abc", "de", "")), 2), 0))), 512),
            gadf-bit(and(eq(FGAMaxEvents(), 24), eq(fga-shown(wide, 500, 300, 0), 24)), 1024)
        ));
    }
    gadf-score();
}
