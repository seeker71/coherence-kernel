; Form emits two programs in RAM, compares real GPU outputs, selects a version,
; and calls the first version again after the new version has been admitted.
; preludes: form-stdlib/bml/metal-jit.bml
(do
 (defn mjlb-source (expression)
  (mj-source (str_concat "kernel void transform(device const uint *x [[buffer(0)]], device uint *y [[buffer(1)]], uint i [[thread_position_in_grid]]) { y[i] = " (str_concat expression "; }"))))
 (let a (mj-memory (mjlb-source "x[i] * 2u") "transform"))
 (let same (mj-memory (mjlb-source "x[i] * 2u") "transform"))
 (let input (metal_buf_alloc 16))
 (let out-a (metal_buf_alloc 16))
 (let out-b (metal_buf_alloc 16))
 (metal_buf_write input 0 (md-le32-list (list 1 7 13 101) ""))
 (let ea (mj-enqueue a (md-bind (list input out-a) (list)) 4))
 (let fence-a (metal_submit))
 (let b (mj-memory (mjlb-source "x[i] + x[i]") "transform"))
 (let eb (mj-enqueue b (md-bind (list input out-b) (list)) 4))
 (let fence-b (metal_submit))
 (let waited-b (metal_fence_wait fence-b))
 (let waited-a (metal_fence_wait fence-a))
 (let ra (metal_buf_read out-a 0 16))
 (let rb (metal_buf_read out-b 0 16))
 (let expected (md-le32-list (list 2 14 26 202) ""))
 (let selected (mj-select b expected rb))
 (let rejected (mj-select b expected "mismatch"))
 (let old-again (mj-enqueue a (md-bind (list input out-a) (list)) 4))
 (let new-again (mj-enqueue selected (md-bind (list input out-b) (list)) 4))
 (let finished (metal_sync))
 (let ra-again (metal_buf_read out-a 0 16))
 (let rb-again (metal_buf_read out-b 0 16))
 (let status (metal_status))
 (let freed (add (metal_buf_free input) (add (metal_buf_free out-a) (metal_buf_free out-b))))
 (let retired (add (mj-release a) (add (mj-release same) (mj-release b))))
 (sum (list
  (if (and (gt (mj-handle a) 0) (gt (mj-handle b) 0)) 1 0)
  (if (and (str_eq (nth a 1) (nth same 1)) (not (eq (mj-handle a) (mj-handle same)))) 2 0)
  (if (not (eq (mj-handle a) (mj-handle b))) 4 0)
  (if (and (eq ea 1) (eq eb 1)) 8 0)
  (if (and (gt fence-a 0) (gt fence-b 0)) 16 0)
  (if (and (str_eq ra expected) (str_eq rb expected)) 32 0)
  (if (eq (mj-handle selected) (mj-handle b)) 64 0)
  (if (nothing? rejected) 128 0)
  (if (and (eq old-again 1) (eq new-again 1)) 256 0)
  (if (and (str_eq ra-again expected) (str_eq rb-again expected)) 512 0)
  (if (and (ge (str_find status "metal_jit_archive_reads=0" 0) 0) (ge (str_find status "metal_jit_archive_writes=0" 0) 0)) 1024 0)
  (if (and (eq freed 3) (eq retired 3)) 2048 0))))
