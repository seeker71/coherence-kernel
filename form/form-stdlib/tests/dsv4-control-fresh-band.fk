; tests/dsv4-control-fresh-band.fk — the leakage-free held-out evaluation's MACHINERY holds;
; the outcome is printed, never gated.
;
; PREREGISTERED 2026-08-18, predicted verdict 31. This band gates only what must be true for
; the evaluation to MEAN something: the fresh set's shape, its zero overlap with train under
; the cell's own audit, the standing corpus untouched, every fresh row judged exactly once.
; Whether the adapter beats the majority baseline (30 of 150) is the trial's OUTCOME — both
; "beats-majority-leakage-free" and "fails-majority-honestly" are honest; only leakage or a
; dropped row fails this band. The rented worker's point estimate, written before the first
; run: 100 of 150 (the gold-ledger holds the miss, whatever it is).
;
;   bit  1  THE FRESH SET HAS ITS SHAPE: 30 rows per class witnessed on two classes (NIL,
;           CHOICE), 150 total by the matrix fold below.
;   bit  2  THE FRESH SET IS FRESH: post-sanitization overlap with train = 0, by the same
;           dca-seen-train? instrument that honestly refused the boundary rows at 150.
;   bit  4  THE STANDING CORPUS IS UNTOUCHED: 750 original rows (train NIL still 120,
;           heldout-boundary NIL still 30) — the fresh rows extend, never edit. (First
;           witness answered 27: this pin was written as 900 — the adder counted the fresh
;           rows into the standing corpus in his head — and the band caught the adder, not
;           the corpus. Probed then pinned: 750.)
;   bit  8  EVERY FRESH ROW IS JUDGED: the 5x5 confusion matrix sums to 150.
;   bit 16  NO CLASS IS LOST: each actual-class row of the matrix sums to exactly 30.
;
; preludes: form-stdlib/dsv4-control-adapter.fk

(do
    (defn dfb-score (ok bit) (if ok bit 0))
    (defn dfb-sum (xs) (if (eq (len xs) 0) 0 (add (head xs) (dfb-sum (tail xs)))))
    (defn dfb-row-sum (m i j)
        (if (eq j 5) 0 (add (nth m (add (mul i 5) j)) (dfb-row-sum m i (add j 1)))))
    (defn dfb-rows-30? (m i)
        (if (eq i 5) 1
            (if (eq (dfb-row-sum m i 0) 30) (dfb-rows-30? m (add i 1)) 0)))

    (let all (dcc-corpus-with-fresh))
    (let report (dca-fresh-report))
    (let matrix (nth report 0))
    (let correct (nth report 1))
    (let leak (nth report 2))
    (let word (nth report 3))

    (let _p1 (print_str (str_concat "fresh_correct=" (int_to_str correct))))
    (let _p2 (print_str "baseline_majority=30"))
    (let _p3 (print_str (str_concat "fresh_leakage=" (int_to_str leak))))
    (let _p4 (print_str (str_concat "outcome=" word)))

    (let c0 (dfb-score (and (eq (dcc-count-class all "NIL" "heldout-fresh") 30)
                            (eq (dcc-count-class all "CHOICE" "heldout-fresh") 30)) 1))
    (let c1 (dfb-score (eq leak 0) 2))
    (let c2 (dfb-score (and (eq (len (dcc-corpus)) 750)
                       (and (eq (dcc-count-class all "NIL" "train") 120)
                            (eq (dcc-count-class all "NIL" "heldout-boundary") 30))) 4))
    (let c3 (dfb-score (eq (dfb-sum matrix) 150) 8))
    (let c4 (dfb-score (eq (dfb-rows-30? matrix 0) 1) 16))

    (add c0 (add c1 (add c2 (add c3 c4)))))
