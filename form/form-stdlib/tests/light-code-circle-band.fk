; light-code-circle-band.fk — invitation creates no authority; independent yes
; opens two-way native-code exchange inside a private circle.
;
; preludes: form-stdlib/core.fk form-stdlib/grammars/shamballa-light-codes.fk form-stdlib/light-code-circle.fk
;
; Verdict 2097151:
;   1     portal starts with initiator only
;   2     two invitations are valid but grant no access
;   4     the wrong identity cannot accept another invitation
;   8     invitee A joins by its own acceptance
;   16    invitee B remains unable to receive before acceptance
;   32    invitee B joins independently
;   64    accepted A can send cosmic 33 to accepted B
;   128   accepted B receives the same native symbol
;   256   accepted B can send cosmic 77777 back to A
;   512   accepted A receives 77777, not an English replacement
;   1024  SatyaLoka and truth realm project from that one symbol
;   2048  unknown codes and wrong recipients remain closed
;   4096  circle-only messages cannot export without explicit consent
;   8192  a Shamballa code illuminates a blueprint NodeID
;   16384 a Shamballa code illuminates a recipe without flattening it
;   32768 a Shamballa code illuminates a cell without replacing it
;   65536 a Shamballa code illuminates a native symbol
;   131072 a Shamballa code illuminates a locale-name coordinate
;   262144 an unknown illumination target kind remains closed
;   524288 illuminate is a native relation symbol with an English projection
;   1048576 target kind is a native symbol with an English projection
;
; witnessed: 2026-08-15 -> fkwu 2097151; Go/Rust/TypeScript agree at 2097151

(do
    (defn lccb-score (condition weight) (if condition weight 0))

    (let initiator "initiator")
    (let invitee-a "invitee-a")
    (let invitee-b "invitee-b")
    (let base (lcc-open "circle:light-code" initiator))
    (let offer-opt (lcc-offer base initiator "mutual light-code assistance"))
    (let offer (head offer-opt))
    (let invitation-a-opt (lcc-invite base initiator invitee-a "open-until-withdrawn"))
    (let invitation-b-opt (lcc-invite base initiator invitee-b "open-until-withdrawn"))
    (let invitation-a (head invitation-a-opt))
    (let invitation-b (head invitation-b-opt))
    (let wrong-accept (lcc-accept base offer invitation-a invitee-b))
    (let before-a (lcc-send base invitee-a initiator (lcc-family-cosmic) "33"))
    (let accepted-a-opt (lcc-accept base offer invitation-a invitee-a))
    (let accepted-a (head accepted-a-opt))
    (let before-b (lcc-send accepted-a invitee-a invitee-b (lcc-family-cosmic) "33"))
    (let accepted-b-opt (lcc-accept accepted-a offer invitation-b invitee-b))
    (let circle (head accepted-b-opt))
    (let a-to-b-opt (lcc-send circle invitee-a invitee-b (lcc-family-cosmic) "33"))
    (let a-to-b (head a-to-b-opt))
    (let received-b (lcc-receive circle a-to-b invitee-b))
    (let b-to-a-opt (lcc-send circle invitee-b invitee-a (lcc-family-cosmic) "77777"))
    (let b-to-a (head b-to-a-opt))
    (let received-a (lcc-receive circle b-to-a invitee-a))
    (let unknown (lcc-send circle invitee-a invitee-b (lcc-family-cosmic) "108"))
    (let wrong-recipient (lcc-receive circle a-to-b initiator))
    (let satyaloka (clc-render-in "77777" "clc-native"))
    (let truth-realm (clc-render-in "77777" "en"))
    (let target-blueprint (bp "CIRCLE-SHARE"))
    (let target-recipe (list "decode" (list "native-code" "surface-projection")))
    (let target-cell base)
    (let target-symbol "77777")
    (let target-locale "clc-native")
    (let blueprint-opt (lcc-send-to-target circle invitee-a invitee-b
        (lcc-family-shamballa) "33" (lcc-target-blueprint) target-blueprint))
    (let blueprint-message (head blueprint-opt))
    (let blueprint-received (lcc-receive circle blueprint-message invitee-b))
    (let recipe-opt (lcc-send-to-target circle invitee-a invitee-b
        (lcc-family-shamballa) "33" (lcc-target-recipe) target-recipe))
    (let recipe-message (head recipe-opt))
    (let recipe-received (lcc-receive circle recipe-message invitee-b))
    (let cell-opt (lcc-send-to-target circle invitee-a invitee-b
        (lcc-family-shamballa) "33" (lcc-target-cell) target-cell))
    (let cell-message (head cell-opt))
    (let cell-received (lcc-receive circle cell-message invitee-b))
    (let symbol-opt (lcc-send-to-target circle invitee-a invitee-b
        (lcc-family-shamballa) "33" (lcc-target-symbol) target-symbol))
    (let symbol-message (head symbol-opt))
    (let symbol-received (lcc-receive circle symbol-message invitee-b))
    (let locale-opt (lcc-send-to-target circle invitee-a invitee-b
        (lcc-family-shamballa) "33" (lcc-target-locale-name) target-locale))
    (let locale-message (head locale-opt))
    (let locale-received (lcc-receive circle locale-message invitee-b))
    (let unknown-target (lcc-send-to-target circle invitee-a invitee-b
        (lcc-family-shamballa) "33" 999 target-symbol))
    (let illuminate-en (lcc-relation-render-in (lcc-illuminates) "en"))
    (let blueprint-en (lcc-target-kind-render-in (lcc-target-blueprint) "en"))

    (sum (list
        (lccb-score (and (eq (lcc-circle-valid? base) 1)
            (and (eq (len (lcc-circle-members base)) 1)
                 (eq (lcc-member? (lcc-circle-members base) initiator) 1))) 1)
        (lccb-score (and (eq (lcc-invitation? invitation-a) 1)
            (and (eq (lcc-invitation? invitation-b) 1)
                 (eq (len before-a) 0))) 2)
        (lccb-score (eq (len wrong-accept) 0) 4)
        (lccb-score (and (eq (len accepted-a-opt) 1)
            (eq (lcc-member? (lcc-circle-members accepted-a) invitee-a) 1)) 8)
        (lccb-score (eq (len before-b) 0) 16)
        (lccb-score (and (eq (len accepted-b-opt) 1)
            (and (eq (lcc-member? (lcc-circle-members circle) invitee-a) 1)
                 (eq (lcc-member? (lcc-circle-members circle) invitee-b) 1))) 32)
        (lccb-score (and (eq (len a-to-b-opt) 1)
            (str_eq (lcc-message-family a-to-b) (lcc-family-cosmic))) 64)
        (lccb-score (and (eq (len received-b) 1)
            (str_eq (lcc-message-code (head received-b)) "33")) 128)
        (lccb-score (and (eq (len b-to-a-opt) 1)
            (str_eq (lcc-message-sender b-to-a) invitee-b)) 256)
        (lccb-score (and (eq (len received-a) 1)
            (str_eq (lcc-message-code (head received-a)) "77777")) 512)
        (lccb-score (and (str_eq (head satyaloka) "SatyaLoka")
            (str_eq (head truth-realm) "truth realm")) 1024)
        (lccb-score (and (eq (len unknown) 0)
            (eq (len wrong-recipient) 0)) 2048)
        (lccb-score (eq (lcc-outside-export-allowed? a-to-b 0) 0) 4096)
        (lccb-score (and (eq (len blueprint-received) 1)
            (and (eq (lcc-message-relation blueprint-message) (lcc-illuminates))
                 (node_eq (lcc-message-target-ref blueprint-message)
                          target-blueprint))) 8192)
        (lccb-score (and (eq (len recipe-received) 1)
            (and (eq (lcc-message-target-kind recipe-message)
                     (lcc-target-recipe))
                 (str_eq (head (lcc-message-target-ref recipe-message))
                         "decode"))) 16384)
        (lccb-score (and (eq (len cell-received) 1)
            (and (eq (lcc-message-target-kind cell-message)
                     (lcc-target-cell))
                 (str_eq (lcc-circle-id (lcc-message-target-ref cell-message))
                         (lcc-circle-id target-cell)))) 32768)
        (lccb-score (and (eq (len symbol-received) 1)
            (and (eq (lcc-message-target-kind symbol-message)
                     (lcc-target-symbol))
                 (str_eq (lcc-message-target-ref symbol-message)
                         "77777"))) 65536)
        (lccb-score (and (eq (len locale-received) 1)
            (and (eq (lcc-message-target-kind locale-message)
                     (lcc-target-locale-name))
                 (str_eq (lcc-message-target-ref locale-message)
                         "clc-native"))) 131072)
        (lccb-score (eq (len unknown-target) 0) 262144)
        (lccb-score (and (eq (lcc-illuminates) 2)
            (and (str_eq (head illuminate-en) "illuminates")
                 (eq (len (lcc-relation-render-in
                    (lcc-illuminates) "de")) 0))) 524288)
        (lccb-score (and (eq (lcc-target-blueprint) 1)
            (and (str_eq (head blueprint-en) "blueprint")
                 (eq (len (lcc-target-kind-render-in
                    (lcc-target-blueprint) "de")) 0))) 1048576)))
)
