// Immutable first guided answer, comparable output units and visible absence.
// preludes: form-stdlib/bml/form-cli-native-compare.bml
section [form.bml] {
 class ComparisonSourceBand {
  def csb-need(ok,why) = if ok then 1 else form_error(why);
 }
 let original = read_file(fnc-guided-answer());
 csb-need(fnc-reference-valid?(original,fnc-guided-sha256()),"guided snapshot differs from its original committed bytes");
 csb-need((!fnc-reference-valid?(str_concat(original,"\nlater addition"),fnc-guided-sha256())),"appended material entered the pinned baseline");
 csb-need(((!fnc-reference-valid?(nothing(),fnc-guided-sha256())) && (!fnc-reference-valid?("",fnc-guided-sha256()))),"absent reference was admitted");
 csb-need(((Comparable) str_len(original) == file_size(fnc-guided-answer())),"output text length differs from artifact byte size");
 csb-need((!((String) fnc-guided-answer() == fnc-receipt())),"guided baseline points at the accumulating receipt");
 csb-need(((Value) fnc-guided-floor() == list(9,0,0,1,12520)),"guided floor changed from original answer");
 let outputs = fnc-output-rows();
 csb-need((((Comparable) fnc-int(head(outputs),"bytes") == 5837) && (((Comparable) fnc-int(nth(outputs,1),"bytes") == 5561) && ((Comparable) fnc-int(nth(outputs,2),"bytes") == 12520))),"original output volumes differ");
 csb-need(node_eq(json-object-get(fnc-output-row("absent","","unobserved"),"bytes"),json-node-null()),"absent artifact became a zero-byte answer");
 csb-need(node_eq(json-object-get(fnc-output-artifact("unreadable","example","read failed",nothing()),"bytes"),json-node-null()),"unreadable artifact became a zero-byte answer");
 csb-need(node_eq(json-object-get(fnc-output-artifact("empty","example","observed empty",""),"bytes"),json-node-int(0)),"observed empty artifact became absence");
 let row = fnc-self-row(list(9,0,0,1,100),fnc-guided-floor(),fnc-rows(fnc-route-ledger()));
 csb-need(((String) fnc-str(row,"guided_answer") == fnc-guided-answer()),"comparison row names a different baseline than it measured");
 csb-need(((String) fnc-str(row,"reading") == "pending"),"structural comparison filled a qualitative judgment");
 print_str("original answer reference and output units verified; semantic reading remains pending");
 1;
}
