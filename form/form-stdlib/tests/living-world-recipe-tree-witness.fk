; living-world-recipe-tree-witness.fk -- offered tree composition creates a
; genuinely new Recipe attempt across one fully contradicted tissue.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk

(let LWRTW-SOURCE-A (bp "LWRTW-SOURCE-A"))
(let LWRTW-SOURCE-B (bp "LWRTW-SOURCE-B"))
(let LWRTW-EVIDENCE (bp "LWRTW-EVIDENCE"))
(let LWRTW-REASON   (bp "LWRTW-REASON"))
(let LWRTW-TREE     (bp "LWRTW-TREE"))
(let LWRTW-RESULT   (bp "LWRTW-RESULT"))

(defn lwrtw-cell (kind) (intern_node kind (empty)))
(defn lwrtw-source-a () (lwrtw-cell LWRTW-SOURCE-A))
(defn lwrtw-source-b () (lwrtw-cell LWRTW-SOURCE-B))
(defn lwrtw-evidence () (lwrtw-cell LWRTW-EVIDENCE))
(defn lwrtw-reason () (lwrtw-cell LWRTW-REASON))
(defn lwrtw-entry (source payload)
    (lwphw-entry source (lwrtw-evidence) payload))
(defn lwrtw-entries (source items)
    (if (eq (len items) 0) (list)
        (cons (lwrtw-entry source (head items))
            (lwrtw-entries source (tail items)))))

(defn lwrtw-if (target)
    (lwrt-operator target "if" (lwrtw-evidence)))
(defn lwrtw-and (target)
    (lwrt-operator target "and" (lwrtw-evidence)))
(defn lwrtw-eq (target)
    (lwrt-operator target "eq" (lwrtw-evidence)))
(defn lwrtw-add (target)
    (lwrt-operator target "add" (lwrtw-evidence)))
(defn lwrtw-left () (lwrt-reference "left" (lwrtw-evidence)))
(defn lwrtw-right () (lwrt-reference "right" (lwrtw-evidence)))

; Discover the correction by its exact aggregate placement state.  No raw
; coordinate or observed value is embedded in production or this witness.
(defn lwrtw-fully-divergent-placement? (candidate)
    (do
        (let placement (lwo-emergent-shape candidate))
        (if (and (eq (lwo-field-size
                        (lwph-placement-confirmed placement)) 0)
                 (and (gt (lwo-field-size
                            (lwph-placement-diverged placement)) 0)
                      (eq (lwo-field-size
                            (lwph-placement-diverged placement))
                          (lwo-field-size
                            (lwph-placement-evaluations placement))))) 1 0)))
(defn lwrtw-correction-placement-items (items)
    (if (eq (len items) 0) (lwo-none)
        (if (eq (lwrtw-fully-divergent-placement? (head items)) 1)
            (head items)
            (lwrtw-correction-placement-items (tail items)))))
(defn lwrtw-correction-placement (target)
    (lwrtw-correction-placement-items
        (lwo-field-items
            (lwht-tissue-placements (lwo-emergent-shape target)))))
(defn lwrtw-correction-probe (target)
    (lwph-placement-probe
        (lwo-emergent-shape (lwrtw-correction-placement target))))
(defn lwrtw-binding-for-name (items name)
    (if (eq (len items) 0) (lwo-none)
        (if (eq (lwre-binding-name (head items)) name) (head items)
            (lwrtw-binding-for-name (tail items) name))))
(defn lwrtw-correction-binding (target name)
    (lwrtw-binding-for-name
        (lwre-binding-items
            (lwph-probe-bindings (lwrtw-correction-probe target))) name))
(defn lwrtw-correction-left-value (target)
    (lwre-binding-value (lwrtw-correction-binding target "left")))
(defn lwrtw-correction-right-value (target)
    (lwre-binding-value (lwrtw-correction-binding target "right")))
(defn lwrtw-correction-observed (target)
    (lwph-probe-observed (lwrtw-correction-probe target)))
(defn lwrtw-left-literal (target)
    (lwrt-literal (lwrtw-correction-left-value target) (lwrtw-evidence)))
(defn lwrtw-right-literal (target)
    (lwrt-literal (lwrtw-correction-right-value target) (lwrtw-evidence)))
(defn lwrtw-observed-literal (target)
    (lwrt-literal (lwrtw-correction-observed target) (lwrtw-evidence)))

(defn lwrtw-sum-arguments ()
    (lwrt-arguments (list (lwrtw-left) (lwrtw-right))))
(defn lwrtw-sum (target)
    (lwrt-application (lwrtw-add target) (lwrtw-sum-arguments)
        (lwrtw-evidence)))
(defn lwrtw-left-match-arguments (target)
    (lwrt-arguments (list (lwrtw-left) (lwrtw-left-literal target))))
(defn lwrtw-left-match (target)
    (lwrt-application (lwrtw-eq target)
        (lwrtw-left-match-arguments target) (lwrtw-evidence)))
(defn lwrtw-right-match-arguments (target)
    (lwrt-arguments (list (lwrtw-right) (lwrtw-right-literal target))))
(defn lwrtw-right-match (target)
    (lwrt-application (lwrtw-eq target)
        (lwrtw-right-match-arguments target) (lwrtw-evidence)))
(defn lwrtw-condition-arguments (target)
    (lwrt-arguments
        (list (lwrtw-left-match target) (lwrtw-right-match target))))
(defn lwrtw-condition (target)
    (lwrt-application (lwrtw-and target) (lwrtw-condition-arguments target)
        (lwrtw-evidence)))
(defn lwrtw-root-arguments (target)
    (lwrt-arguments
        (list (lwrtw-condition target) (lwrtw-observed-literal target)
              (lwrtw-sum target))))
(defn lwrtw-root (target)
    (lwrt-application (lwrtw-if target) (lwrtw-root-arguments target)
        (lwrtw-evidence)))
(defn lwrtw-blueprint (target)
    (lwrt-blueprint target (lwrtw-root target)
        (lwo-none) (lwo-none) (lwo-empty-field) (lwo-none) (lwo-none)
        (lwo-none) (lwrtw-evidence)))

; Build every exact tree cell once.  Reuse is identity preservation as well as
; bounded work; it does not cache an answer outside the content-addressed DAG.
(defn lwrtw-tree (blueprint parts root correction)
    (intern_node LWRTW-TREE (list blueprint parts root correction)))
(defn lwrtw-tree-blueprint (tree) (nth (node_children tree) 0))
(defn lwrtw-tree-parts (tree) (nth (node_children tree) 1))
(defn lwrtw-tree-root (tree) (nth (node_children tree) 2))
(defn lwrtw-tree-correction (tree) (nth (node_children tree) 3))
(defn lwrtw-build-tree (target)
    (do
        (let correction (lwrtw-correction-placement target))
        (let probe (lwph-placement-probe (lwo-emergent-shape correction)))
        (let bindings (lwph-probe-bindings probe))
        (let left-value
            (lwre-binding-value
                (lwrtw-binding-for-name
                    (lwre-binding-items bindings) "left")))
        (let right-value
            (lwre-binding-value
                (lwrtw-binding-for-name
                    (lwre-binding-items bindings) "right")))
        (let observed (lwph-probe-observed probe))
        (let if-op (lwrt-operator target "if" (lwrtw-evidence)))
        (let and-op (lwrt-operator target "and" (lwrtw-evidence)))
        (let eq-op (lwrt-operator target "eq" (lwrtw-evidence)))
        (let add-op (lwrt-operator target "add" (lwrtw-evidence)))
        (let left (lwrt-reference "left" (lwrtw-evidence)))
        (let right (lwrt-reference "right" (lwrtw-evidence)))
        (let left-literal (lwrt-literal left-value (lwrtw-evidence)))
        (let right-literal (lwrt-literal right-value (lwrtw-evidence)))
        (let observed-literal (lwrt-literal observed (lwrtw-evidence)))
        (let sum-arguments (lwrt-arguments (list left right)))
        (let sum (lwrt-application add-op sum-arguments (lwrtw-evidence)))
        (let left-match-arguments
            (lwrt-arguments (list left left-literal)))
        (let left-match
            (lwrt-application eq-op left-match-arguments (lwrtw-evidence)))
        (let right-match-arguments
            (lwrt-arguments (list right right-literal)))
        (let right-match
            (lwrt-application eq-op right-match-arguments (lwrtw-evidence)))
        (let condition-arguments
            (lwrt-arguments (list left-match right-match)))
        (let condition
            (lwrt-application and-op condition-arguments (lwrtw-evidence)))
        (let root-arguments
            (lwrt-arguments (list condition observed-literal sum)))
        (let root (lwrt-application if-op root-arguments (lwrtw-evidence)))
        (let blueprint
            (lwrt-blueprint target root (lwo-none) (lwo-none)
                (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none)
                (lwrtw-evidence)))
        (let parts
            (list (lwrtw-evidence) left-value right-value observed
                  if-op and-op eq-op add-op left right left-literal
                  right-literal observed-literal sum-arguments sum
                  left-match-arguments left-match right-match-arguments
                  right-match condition-arguments condition root-arguments
                  root blueprint))
        (lwrtw-tree blueprint parts root correction)))

; Every node and internal argument sequence crosses the offer membrane.
(defn lwrtw-parts (target)
    (list
        (lwrtw-evidence)
        (lwrtw-correction-left-value target)
        (lwrtw-correction-right-value target)
        (lwrtw-correction-observed target)
        (lwrtw-if target) (lwrtw-and target) (lwrtw-eq target)
        (lwrtw-add target)
        (lwrtw-left) (lwrtw-right)
        (lwrtw-left-literal target) (lwrtw-right-literal target)
        (lwrtw-observed-literal target)
        (lwrtw-sum-arguments) (lwrtw-sum target)
        (lwrtw-left-match-arguments target) (lwrtw-left-match target)
        (lwrtw-right-match-arguments target) (lwrtw-right-match target)
        (lwrtw-condition-arguments target) (lwrtw-condition target)
        (lwrtw-root-arguments target) (lwrtw-root target)
        (lwrtw-blueprint target)))
(defn lwrtw-one-source-world (world tree)
    (lwt-receive-stream world
        (lwrtw-entries (lwrtw-source-a) (lwrtw-tree-parts tree))))
(defn lwrtw-two-source-world (world tree)
    (lwt-receive-stream (lwrtw-one-source-world world tree)
        (lwrtw-entries (lwrtw-source-b) (lwrtw-tree-parts tree))))
(defn lwrtw-revoke-blueprint (world tree)
    (lwt-receive-stream world
        (list
            (lwrtw-entry (lwrtw-source-a)
                (lwo-revocation (lwrtw-tree-blueprint tree)
                    (lwrtw-source-a) (lwrtw-reason)
                    (lwrtw-evidence))))))

(defn lwrtw-evaluation-state-target (evaluation)
    (if (eq (lwph-consistent?
                (lwhrn-evaluation-state evaluation)) 1) "consistent"
        (if (eq (lwph-divergent?
                    (lwhrn-evaluation-state evaluation)) 1) "divergent"
            "unresolved")))
(defn lwrtw-evaluations-stream
    (recipe items field index started)
    (if (eq (len items) 0) field
        (do
            (let enter
                (lcfb-call-stream "living-world-recipe-tree" "trial" "enter"
                    "form-native" "lwhrn-evaluate-placement"
                    (lcfb-cat (list "placement-index:" (int_to_str index)))
                    (add 6 (mul index 2)) started
                    "form/form-stdlib/tests/living-world-recipe-tree-witness.fk"
                    205 14))
            (let evaluation
                (lwhrn-evaluate-placement recipe (head items)))
            (let leave
                (lcfb-call-stream "living-world-recipe-tree" "trial" "leave"
                    "form-native" "lwhrn-evaluate-placement"
                    (lcfb-cat (list
                        "placement-index:" (int_to_str index)
                        ":state:"
                        (lwrtw-evaluation-state-target evaluation)))
                    (add 7 (mul index 2)) started
                    "form/form-stdlib/tests/living-world-recipe-tree-witness.fk"
                    215 14))
            (lwrtw-evaluations-stream recipe (tail items)
                (lwo-field-add field evaluation) (add index 1) started))))

; children: upstream result, target, base/open/one/two worlds and fields,
; proposal/candidate/waiting/admitted, exact composition/Recipe, revocation,
; framebuffer events
(defn lwrtw-result
    (upstream target tree base-world open-field one-world one-field two-world field
     proposal candidate waiting admitted composition recipe revoked-world
     revoked-field events)
    (intern_node LWRTW-RESULT
        (list upstream target tree base-world open-field one-world one-field
              two-world field proposal candidate waiting admitted composition
              recipe revoked-world revoked-field events)))

(defn lwrtw-run ()
    (do
        (let upstream (lwpow-run))
        (let target (nth (node_children upstream) 18))
        (let base-world (nth (node_children upstream) 19))
        (let tree (lwrtw-build-tree target))
        (let started
            (lcfb-open-stream "living-world-recipe-tree" "form-native"
                "lwrtw-run" "contradiction-to-offered-expression-tree"
                "form/form-stdlib/tests/living-world-recipe-tree-witness.fk"
                115 14))

        (let open-field (lwrt-field-for base-world target 2))
        (let open-frame
            (lcfb-call-stream "living-world-recipe-tree" "open" "leave"
                "form-native" "lwrt-field-for"
                "blueprints:0:compatible:0:open:1" 1 started
                "form/form-stdlib/tests/living-world-recipe-tree-witness.fk"
                123 14))
        (let one-world (lwrtw-one-source-world base-world tree))
        (let one-field (lwrt-field-for one-world target 2))
        (let one-frame
            (lcfb-call-stream "living-world-recipe-tree" "first-offer"
                "leave" "form-native" "lwrt-field-for"
                "sources:1:blueprints:0:no-recurrence" 2 started
                "form/form-stdlib/tests/living-world-recipe-tree-witness.fk"
                132 14))
        (let two-world (lwrtw-two-source-world base-world tree))
        (let enter-frame
            (lcfb-call-stream "living-world-recipe-tree" "composition"
                "enter" "form-native" "lwrt-field-for"
                (lcfb-cat (list
                    "parts:"
                    (int_to_str (len (lwrtw-tree-parts tree)))
                    ":sources:2:placements:"
                    (int_to_str
                        (lwo-field-size
                            (lwht-tissue-placements
                                (lwo-emergent-shape target))))))
                3 started
                "form/form-stdlib/tests/living-world-recipe-tree-witness.fk"
                141 14))
        (let blueprint (lwrtw-tree-blueprint tree))
        (let blueprints (lwrt-blueprints-for two-world target 2))
        (let blueprint-frame
            (lcfb-call-stream "living-world-recipe-tree" "blueprints" "leave"
                "form-native" "lwrt-blueprints-for"
                (lcfb-cat (list
                    "current:"
                    (int_to_str (lwo-field-size blueprints))))
                4 started
                "form/form-stdlib/tests/living-world-recipe-tree-witness.fk"
                250 14))
        (let recipe (lwrt-recipe-for blueprint))
        (let recipe-frame
            (lcfb-call-stream "living-world-recipe-tree" "source" "leave"
                "form-native" "lwrt-source-for/lwrt-recipe-for"
                (lcfb-cat (list
                    "bytes:" (int_to_str (str_len (lwre-recipe-source recipe)))
                    ":valid:" (int_to_str (lwre-recipe-valid? recipe))))
                5 started
                "form/form-stdlib/tests/living-world-recipe-tree-witness.fk"
                260 14))
        (let placements
            (lwht-tissue-placements (lwo-emergent-shape target)))
        (let evaluations
            (lwrtw-evaluations-stream recipe
                (lwo-field-items placements) (lwo-empty-field) 0 started))
        (let composition
            (lwrt-composition blueprint recipe evaluations
                (lwhrn-evaluation-state-items
                    (lwo-field-items evaluations) 0 0 0)
                (lwo-empty-field) (lwo-empty-field)))
        (let compositions (lwo-field (list composition)))
        (let compatible
            (lwrt-filter-compositions (lwo-field-items compositions)
                (lwph-consistent) (lwo-empty-field)))
        (let divergent
            (lwrt-filter-compositions (lwo-field-items compositions)
                (lwph-divergent) (lwo-empty-field)))
        (let unresolved
            (lwrt-filter-compositions (lwo-field-items compositions)
                (lwph-unresolved) (lwo-empty-field)))
        (let compatible-count (lwo-field-size compatible))
        (let status
            (if (eq compatible-count 1) (lwhrn-ready)
                (if (gt compatible-count 1) (lwhrn-plural) (lwhrn-open))))
        (let witnesses
            (lwrt-blueprints-witnesses two-world
                (lwo-field-items blueprints)
                (lwph-field-union-items
                    (lwo-field-items
                        (lwo-active-attributions-for two-world target))
                    (lwo-emergent-witnesses target))))
        (let field
            (lwrt-field-cell target blueprints compositions compatible divergent
                unresolved status (lwht-tissue-alternatives
                    (lwo-emergent-shape target))
                (lwo-field-add
                    (lwht-tissue-unknowns (lwo-emergent-shape target))
                    (lwlc-unknown compositions)) witnesses 2))
        (let field-ordinal
            (add 6 (mul (lwo-field-size placements) 2)))
        (let field-frame
            (lcfb-call-stream "living-world-recipe-tree" "composition"
                "leave" "form-native" "lwrt-field-for"
                (lwrt-progress-target field) field-ordinal started
                "form/form-stdlib/tests/living-world-recipe-tree-witness.fk"
                141 14))
        (let proposal (lwrt-proposal-from-field field))
        (let candidate (lwt-proposal-candidate proposal))
        (let integration-enter
            (lcfb-call-stream "living-world-recipe-tree" "integration"
                "enter" "form-native" "lwrt-integrate"
                "candidate-currentness-and-unanimous-boundary"
                (add field-ordinal 1) started
                "form/form-stdlib/tests/living-world-recipe-tree-witness.fk"
                330 14))
        (let waiting
            (lwrt-integrate
                (lwpow-round-for two-world proposal (lwo-none))
                proposal (lwphw-action)))
        (let responded-world (lwpow-respond-all two-world proposal))
        (let admitted
            (lwrt-integrate
                (lwpow-round-for responded-world proposal waiting)
                proposal (lwphw-action)))
        (let admitted-world (lwt-round-world admitted))
        (let admitted-frame
            (lcfb-call-stream "living-world-recipe-tree" "field" "leave"
                "form-native" "lwrt-integrate"
                (lcfb-cat (list
                    "field-current:"
                    (int_to_str
                        (lwrt-integrated-current? admitted-world candidate))
                    ":recipe-active:"
                    (int_to_str (lwo-active? admitted-world recipe))))
                (add field-ordinal 2) started
                "form/form-stdlib/tests/living-world-recipe-tree-witness.fk"
                163 14))

        (let revoked-world (lwrtw-revoke-blueprint admitted-world tree))
        (let revoked-field (lwrt-field-for revoked-world target 2))
        (let revoked-frame
            (lcfb-call-stream "living-world-recipe-tree" "revocation" "leave"
                "form-native" "lwrt-field-for"
                (lcfb-cat (list
                    "prior-current:"
                    (int_to_str
                        (lwrt-integrated-current? admitted-world candidate))
                    "->"
                    (int_to_str
                        (lwrt-candidate-current? revoked-world candidate))
                    ":blueprints-now:"
                    (int_to_str
                        (lwo-field-size
                            (lwrt-field-blueprints revoked-field)))
                    ":history-retained:"
                    (int_to_str
                        (lwo-member?
                            (lwo-field-items
                                (lwo-world-cells revoked-world))
                            (lwrtw-tree-blueprint tree)))))
                (add field-ordinal 3) started
                "form/form-stdlib/tests/living-world-recipe-tree-witness.fk"
                174 14))
        (lwrtw-result upstream target tree base-world open-field one-world
            one-field two-world field proposal candidate waiting admitted
            composition recipe revoked-world revoked-field
            (framebuffer-events))))

0
