; Two real prompt positions through the first two uncompressed DS4 layers.
; This witnesses layer-major scheduling, positional RoPE, and persistent
; per-layer cache growth before admitting the compression transition.
;
; preludes: native/metal/dsv4-embed.fk native/metal/dsv4-f16-matvec.fk native/metal/dsv4-rmsnorm.fk native/metal/dsv4-mx8-matvec.fk native/metal/dsv4-rope.fk native/metal/dsv4-hash-route.fk native/metal/dsv4-moe-exec.fk native/metal/dsv4-kv-round.fk native/metal/dsv4-layer-walk.fk form-stdlib/dsv4-hc-msl.fk form-stdlib/dsv4-kv-cache.fk

(do
    (print_str (metal_model_open
        (dlp-model-path)
        (dlw-nums (list (dlp-view-step) (dlp-view-limit) 2))))
    (print_str (metal_model_library "dsv4-embed" (dsv4-embed-source)))
    (print_str (metal_model_library "dsv4-hc" (hc-msl-unit)))
    (print_str (metal_model_library "dsv4-f16" (dsv4-f16-matvec-source)))
    (print_str (metal_model_library "dsv4-rms" (dsv4-rmsnorm-source)))
    (print_str (metal_model_library "dsv4-mx8" (dsv4-mx8-matvec-source)))
    (print_str (metal_model_library "dsv4-rope" (dsv4-rope-source)))
    (print_str (metal_model_library "dsv4-route" (dsv4-hash-route-source)))
    (print_str (metal_model_library "dsv4-mx4" (dsv4-mx4-expert-source)))
    (print_str (metal_model_library "dsv4-iq2" (dsv4-iq2-expert-source)))
    (print_str (metal_model_library "dsv4-moe" (dsv4-moe-fold-source)))
    (print_str (metal_model_library "dsv4-topk" (dsv4-topk-route-source)))
    (print_str (metal_model_library "dsv4-kv-round" (dsv4-kv-round-source)))
    (print_str (metal_model_library "dsv4-kv-cache" (dkv-msl-source)))
    (dlw-live-two-position-two-layer 0 3476)
    (print_str (metal_model_close))
    0)
