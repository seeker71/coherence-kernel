; lora-lanes-band.fk — every registry model has an unpromoted lane.
; Verdict 255 (witnessed 2026-10-01, and again 2026-10-11 once the lane owned its rank-one fit and loss)
;   1 every registry name has a lane
;   2 the mouth is the one lane beyond the registry
;   4 no lane is promoted
;   8 both Qwen 27B lanes use the Qwen head width
;   16 kat-coder uses its embedding width
;   32 whisper-tiny uses the ear's tiny width
;   64 a rank-one fit reconstructs its target, and the 3B school stays the session trainer
;   128 each lane has its own prompt, and an unknown role wears nothing
; preludes: form/form-stdlib/lora-lanes.bml form/form-stdlib/model-registry.bml
(do
    (defn llb-reg (rows) (if (nil? rows) 1 (and (eq (ll-has? (head (head rows))) 1) (llb-reg (tail rows)))))
    (defn llb-prom (rows) (if (nil? rows) 1 (and (eq (ll-promoted (head (head rows))) 0) (llb-prom (tail rows)))))
    (defn llb-bit (ok bit) (if ok bit 0))
    (defn llb-prompted (rows) (if (nil? rows) 1 (and (gt (len (ll-prompt (head (head rows)))) 0) (llb-prompted (tail rows)))))
    (let q8 (ll-find (ll-rows) "qwen38-q8"))
    (let q4 (ll-find (ll-rows) "qwen38-q4"))
    (let kat (ll-find (ll-rows) "katcoder"))
    (let tiny (ll-find (ll-rows) "whisper-tiny-fixture"))
    (let school (ll-find (ll-rows) "llama32-3b-mlx-4bit"))
    (let h (list 1.0 1.0 1.0 1.0))
    (let target (list 4.0 0.0 0.0 0.0))
    (let fit (ll-fit h target))
    (sum (list
        (llb-bit (eq (llb-reg (mr-registry)) 1) 1)
        (llb-bit (eq (len (ll-rows)) (add (len (mr-registry)) 1)) 2)
        (llb-bit (eq (llb-prom (ll-rows)) 1) 4)
        (llb-bit (and (eq (nth q8 2) (qlh-width)) (eq (nth q4 2) (qlh-width))) 8)
        (llb-bit (eq (nth kat 2) (kce-embed-ne0)) 16)
        (llb-bit (eq (nth tiny 2) (eng-D (eng-state (eng-tiny)))) 32)
        (llb-bit (and (eq (ll-loss target (nth fit 1) (nth fit 2)) 0) (str_eq (nth school 1) "llama-session")) 64)
        (llb-bit (and (eq (llb-prompted (ll-rows)) 1)
            (and (eq (rp-distinct?) 1)
            (and (not (str_eq (ll-prompt "qwen38-q8") (ll-prompt "katcoder")))
            (and (str_eq (rp-wrap "no-such" "body") "body")
                 (eq (str_find (rp-wrap "katcoder" "body") "Edit the named source" 0) 0))))) 128))))
