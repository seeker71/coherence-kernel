; Native failure -> diagnosis -> changed approach -> actual behavioral recheck.
; No model or persistent file publication. Expected 262143.
; preludes: form-stdlib/bml/form-cli-code-repair-fixture.bml
(do
 (defn fcrb-bit (ok bit) (if ok bit 0))
 (let checker (fcrf-checker))
 (let failed (fcrf-failure))
 (let evidence (fcap-evidence failed))
 (let readback (fcap-step failed "{\"tool\":\"read\",\"arguments\":[\"calc.form\"]}" checker))
 (let forbidden (fcap-step failed "{\"tool\":\"write\",\"arguments\":[\"calc.form\"],\"input\":\"oops\"}" checker))
 (let skip (fcap-step failed "{\"diagnosis\":\"bad constant\",\"change\":\"fix expression\",\"next\":\"complete\"}" checker))
 (let repair (fcap-step readback "{\"diagnosis\":\"At zero, 2 differs from 1; the quadratic is also absent.\",\"change\":\"Compute x*x+x+1 and verify zero and negatives.\",\"next\":\"plan\"}" checker))
 (let planned (fcap-step repair "{\"plan\":\"Use add(add(mul(x,x),x),1), then review and native checks.\"}" checker))
 (let split (fcap-step planned "{\"tasks\":[\"Replace the incorrect expression\"]}" checker))
 (let edited (fcap-step split "{\"tool\":\"edit\",\"arguments\":[\"calc.form\",\"add(x,2)\",\"add(add(mul(x,x),x),1)\"]}" checker))
 (let reviewed (fcap-step edited "{\"task\":\"done\"}" checker))
 (let done (fcap-step reviewed "{\"verdict\":\"accept\",\"reason\":\"Expression includes square, input and one.\"}" checker))
 (let wrongagain (fcap-step failed "{\"diagnosis\":\"Constant wrong\",\"change\":\"Try a new approach\",\"next\":\"implement\"}" checker))
 (let repeat-review (fcap-step wrongagain "{\"task\":\"done\"}" checker))
 (let repeated (fcap-step repeat-review "{\"verdict\":\"accept\"}" checker))
 (let blind (fcap-step repeated "{\"diagnosis\":\"Try again\",\"change\":\"Try again\",\"next\":\"implement\"}" checker))
 (let redirected (fcap-step repeated "{\"diagnosis\":\"The same case still fails\",\"change\":\"Derive the full expression before editing\",\"next\":\"plan\"}" checker))
 (let toolfail (fcap-step (fcrf-implementation) "{\"tool\":\"edit\",\"arguments\":[\"calc.form\",\"not-present\",\"new\"]}" checker))
 (let miss (fcap-step (fcrf-implementation) "{\"tool\":\"rg\",\"arguments\":[\"absent-pattern\",\"calc.form\"]}" checker))
 (sum (list
  (fcrb-bit (and (str_eq (fcap-stage failed) "repair") (eq (fcap-checks failed) 1)) 1)
  (fcrb-bit (ge (str_find evidence "input=0 expected=1 actual=2" 0) 0) 2)
  (fcrb-bit (and (str_eq (fcap-evidence readback) evidence) (not (str_eq (fcap-note readback) evidence))) 4)
  (fcrb-bit (and (str_eq (fcap-stage forbidden) "repair") (value_eq (fcap-docs forbidden) (fcap-docs failed))) 8)
  (fcrb-bit (str_eq (fcap-stage skip) "repair") 16)
  (fcrb-bit (and (str_eq (fcap-stage repair) "plan") (eq (len (fcap-reflections repair)) 1)) 32)
  (fcrb-bit (and (str_eq (nth repair 1) (fcrf-goal)) (value_eq (nth repair 2) (fcrf-docs))) 64)
  (fcrb-bit (and (str_eq (fcap-stage split) "implement") (eq (nth split 11) 1)) 128)
  (fcrb-bit (and (str_eq (fcap-stage done) "complete") (eq (fcap-checks done) 2)) 256)
  (fcrb-bit (and (eq (fcap-failures done) 1) (eq (head (fcaq-check (fcrf-contract) (fcap-docs done))) 1)) 512)
  (fcrb-bit (and (eq (fcap-failures repeated) 2) (eq (fcap-checks repeated) 2)) 1024)
  (fcrb-bit (and (str_eq (fcap-stage toolfail) "repair") (eq (fcap-turns toolfail) 4)) 2048)
  (fcrb-bit (and (str_eq (fcap-stage miss) "implement") (eq (fcap-failures miss) 0)) 4096)
  (fcrb-bit (and (value_eq (fcap-step done "bad" checker) done) (eq (fcap-failures (fcap-terminal repeated "budget")) 2)) 8192)
  (fcrb-bit (and (fat-wire-object? (fcap-observation-node failed)) (ge (str_find (fcap-bootstrap failed) "\"current\":{\"role\":\"repair\"" 0) 0)) 16384)
  (fcrb-bit (and (value_eq (fat-find-doc (fcap-docs done) "locked.txt") (nth (fcrf-docs) 1)) (ge (str_find (fcaq-result (list done 1 0 0 0)) "\"check_runs\":2" 0) 0)) 32768)
  (fcrb-bit (and (eq (fcap-repeat repeated) 1) (str_eq (fcap-stage blind) "repair")) 65536)
  (fcrb-bit (and (str_eq (fcap-stage redirected) "plan") (eq (len (fcap-reflections redirected)) 2)) 131072))))
