; native-llama-voice-adapt-band.fk — a cap is a signal, not a ceiling.
;
; Verdict 65535:
;   1    token cap doubles when room remains
;   2    token cap does not grow past remaining positions
;   4    a unique short answer is not a loop
;   8    a repeated tail at the cap is a loop
;   16   one interned sentence is not a loop; the first repeat is
;   32   admission clamps want to maxpos instead of refusing the prompt
;   64   a zero caller cap still admits a small KV room, not nothing
;   128  first-best that would loop yields to a second-best that would not
;   256  a new sentence with the same lowered prefix is a frame cap
;   512  a 12-character span from an earlier sentence echoing mid-phrase is a cap
;   1024 the live 3B near-echo ("the first gift we") is stuck at 12, not at 16
;   2048 an unfinished last sentence is dropped on adapted-repeat
;   4096 first two stuck choices yield to a third that would not
;   8192 a full KV want shrinks toward prompt+1 instead of a hard stop
;   16384 a long id list slides to its last half instead of a hard stop
;   32768 two ids slide to one; one id is the remaining physical floor
;
; Pure shape. Opens no model.
; preludes: form-stdlib/native-llama-voice.bml
; witnessed: 2026-09-10 -> 65535

(do
    (defn nlgab-bit (ok bit) (if ok bit 0))
    (defn nlgab-once ()
        "the first gift to ourselves is the gift of self-awareness.")
    (defn nlgab-looped ()
        "the first gift to ourselves is the gift of self-awareness. The first gift to ourselves is the gift of self-awareness, and the first gift to ourselves is the gift of self-awareness.")
    (defn nlgab-live ()
        "the first gift to ourselves is the gift of self-awareness. The body's own internal clock is the first gift we can give to ourselves. The")
    (add (nlgab-bit (eq (nlg-grown-limit 40 8192 100) 80) 1)
    (add (nlgab-bit (eq (nlg-grown-limit 40 120 100) 40) 2)
    (add (nlgab-bit (eq (nlg-looping "Hello.") 0) 4)
    (add (nlgab-bit (eq (nlg-looping "aaaaaaaabbbbbbbbccccccccaaaaaaaabbbbbbbbcccccccc") 1) 8)
    (add (nlgab-bit (and (eq (nlg-looping (nlgab-once)) 0)
                        (eq (nlg-looping (nlgab-looped)) 1)) 16)
    (add (nlgab-bit (and (eq (nlg-want-capacity 30 40) 70)
                        (eq (nlg-admit-capacity 70 64) 64)) 32)
    (add (nlgab-bit (eq (nlg-want-capacity 30 0) 46) 64)
    (add (nlgab-bit (and (eq (head (nlg-pick (nlgab-once) " The first gift to ourselves is the gift of self-awareness." " Enough." 1 2)) 2)
                        (str_eq (nth (nlg-pick (nlgab-once) " The first gift to ourselves is the gift of self-awareness." " Enough." 1 2) 1) "adapted-choice")) 128)
    (add (nlgab-bit (and (eq (nlg-framing (nlgab-once)) 0)
                        (and (eq (nlg-framing (str_concat (nlgab-once) " The first gift to our children is the gift of self-discipline.")) 1)
                             (eq (nlg-framing (str_concat (nlgab-once) " Enough.")) 0))) 256)
    (add (nlgab-bit (and (eq (nlg-echoing (nlgab-once)) 0)
                        (and (eq (nlg-echoing (str_concat (nlgab-once) " The body's own internal clock is the first gift to our own internal clock.")) 1)
                             (eq (nlg-echoing (str_concat (nlgab-once) " Enough.")) 0))) 512)
    (add (nlgab-bit (and (eq (nlg-echo-n) 12)
                        (eq (nlg-echoing (nlgab-live)) 1)) 1024)
    (add (nlgab-bit (and (str_eq (nlg-complete (nlgab-live)) "the first gift to ourselves is the gift of self-awareness. The body's own internal clock is the first gift we can give to ourselves.")
                        (str_eq (nlg-complete "hello") "hello")) 2048)
    (add (nlgab-bit (and (eq (head (nlg-pick3 (nlgab-once) " The first gift we can give to ourselves." " The first gift to our children." " Enough." 1 2 3)) 3)
                        (str_eq (nth (nlg-pick3 (nlgab-once) " The first gift we can give to ourselves." " The first gift to our children." " Enough." 1 2 3) 1) "adapted-choice")) 4096)
    (add (nlgab-bit (and (eq (nlg-shrink-capacity 70 30) 35)
                        (and (eq (nlg-floor-capacity 30) 31)
                             (eq (nlg-shrink-capacity 31 30) 31))) 8192)
    (add (nlgab-bit (and (eq (len (nlg-take-last (list 1 2 3 4 5) 3)) 3)
                        (and (eq (head (nlg-take-last (list 1 2 3 4 5) 3)) 3)
                             (eq (nlg-slide-n (list 1 2 3 4)) 2))) 16384)
         (nlgab-bit (and (eq (nlg-slide-n (list 1 2)) 1)
                        (eq (nlg-slide-n (list 1)) 1)) 32768)))))))))))))))))
