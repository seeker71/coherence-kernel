; native-model-owner-cadence-band.bml — the owner observer's reads of a process, from the host's own row, with no program.
; The observer asked `/bin/ps -p PID -o command=` and `-o lstart=,command=` through a shell for a pid's command and lifetime signature, and the
; request flow rested a quarter second by `/bin/sleep 0.25`; they are host_process (pid, parent, exe, cwd, argv, start-ms, withheld) and host_sleep_ms now.
; No owner is started and nothing is published: the process asked about is the band itself.
;
;   1     the command: nmdoc-pid-command-text of this process is its argv joined by single spaces (argv[0] as the host runs it, then the
;         band's own path), and a pid no process holds reads ""
;   2     the signature: this process's is its start in ms, a space, then that command; two reads are equal (a lifetime does not drift); the start
;         is a real instant (after 2020, not after now); a pid no process holds reads ""
;   4     a lifetime is told from another: a row with a later start, or one with the same start and another command, signs differently; a nothing(),
;         a short list and a non-list row sign ""
;   8     the quarter second: nmof-sleep-quarter rests between a quarter and two seconds on the monotonic clock
;   16    the owner's elapsed seconds are read from the host's row by pid (nmdoc-elapsed-in): a scripted table answers the matching row's slot 3
;         and nothing() for a pid it does not hold; the live read for this process is a small non-negative number or nothing()
;
; Expected: 31
; Verdict 31
; REQUIRES: the host doors host_process host_processes host_sleep_ms (seed doors; the sibling kernels carry no host doors)
; preflight-exec: forbidden
; preludes: form-stdlib/native-model-owner-cadence.bml form-stdlib/native-model-owner-request-flow.bml
section [form.bml] {
 class NativeModelOwnerCadenceBand {
  def nmb-say(label, v) = print([label, v]);
  def nmb-argv(row) = row[4];
  def nmb-join(xs) = nil?(xs) ? "" : nil?(xs[1:]) ? xs[0] : xs[0] ++ " " ++ nmb-join(xs[1:]);
  def nmb-c-command() {
   let me = host_pid();
   let row = host_process(me);
   let text = nmdoc-pid-command-text(me);
   let said = nmb-say("command", [text, nmdoc-pid-command-text(2147483646)]);
   (String) value_kind(row) == "list" && len(nmb-argv(row)) >= 2 && (String) text == nmb-join(nmb-argv(row)) && str_find(text, nmb-argv(row)[0], 0) == 0 && (String) nmdoc-pid-command-text(2147483646) == "";
  }
  def nmb-c-signature() {
   let me = host_pid();
   let row = host_process(me);
   let a = nmdoc-pid-signature(me);
   let b = nmdoc-pid-signature(me);
   let gap = str_find(a, " ", 0);
   let start = gap > 0 ? parse-int(substring(a, 0, gap)) : nothing();
   let said = nmb-say("signature", [a, start]);
   (String) a != "" && (String) a == (String) b && !nothing?(start) && start == row[5] && start > 1577836800000 && start <= now_unix_ms() && (String) substring(a, gap + 1, len(a)) == nmdoc-pid-command-text(me) && (String) nmdoc-pid-signature(2147483646) == "";
  }
  def nmb-c-lifetimes() {
   let r1 = [10, 1, "/x/fkwu", "/w", ["./fkwu", "a.fk"], 1700000000000, 0];
   let r2 = [10, 1, "/x/fkwu", "/w", ["./fkwu", "a.fk"], 1700000009000, 0];
   let r3 = [10, 1, "/x/fkwu", "/w", ["./fkwu", "b.fk"], 1700000000000, 0];
   (String) nmdoc-pid-signature-of(r1) == "1700000000000 ./fkwu a.fk" && (String) nmdoc-pid-signature-of(r1) != (String) nmdoc-pid-signature-of(r2) && (String) nmdoc-pid-signature-of(r1) != (String) nmdoc-pid-signature-of(r3)
    && (String) nmdoc-pid-signature-of(nothing()) == "" && (String) nmdoc-pid-signature-of([10, 1]) == "" && (String) nmdoc-pid-signature-of(0 - 2) == "";
  }
  def nmb-c-quarter() {
   let t0 = host_monotonic_ms();
   let r = nmof-sleep-quarter();
   let dt = host_monotonic_ms() - t0;
   let said = nmb-say("quarter", [r, dt]);
   dt >= 240 && dt <= 2000;
  }
  def nmb-c-elapsed() {
   let table = [[11, 5000, 10, 7, 0, 1], [12, 5000, 10, 9, 0, 1]];
   let live = nmdoc-pid-elapsed(host_pid());
   let said = nmb-say("elapsed", [live]);
   (Comparable) nmdoc-elapsed-in(table, 12) == 9 && (Comparable) nmdoc-elapsed-in(table, 11) == 7 && nothing?(nmdoc-elapsed-in(table, 13)) && nothing?(nmdoc-elapsed-in([], 11)) && (nothing?(live) || ((String) value_kind(live) == "int" && live >= 0 && live < 86400));
  }
  def nmb-run() {
   let b1 = nmb-c-command() ? 1 : 0;
   let b2 = nmb-c-signature() ? 2 : 0;
   let b4 = nmb-c-lifetimes() ? 4 : 0;
   let b8 = nmb-c-quarter() ? 8 : 0;
   let b16 = nmb-c-elapsed() ? 16 : 0;
   let verdict = b1 + b2 + b4 + b8 + b16;
   let shown = print(["native-model-owner-cadence-band", "verdict", verdict]);
   verdict;
  }
 }
 nmb-run();
}
