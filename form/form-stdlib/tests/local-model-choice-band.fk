; local-model-choice-band.fk — side-by-side local arches; learning updates the pick.
;
; preludes: form-stdlib/local-model-choice.fk
;
; Four-way: no GGUF, no ledger file. Verdict 1023 when every claim holds.

(do
    (defn lmcb-all (xs)
        (if (eq (len xs) 0) 1
            (if (head xs) (lmcb-all (tail xs)) 0)))
    (defn lmcb (weight claims) (if (eq (lmcb-all claims) 1) weight 0))
    (let pair (lmc-pair))
    (let empty (empty))
    (let after-qwen-control (lmc-observe empty "control" "qwen35" 1))
    (let after-llama-gen (lmc-observe empty "generate" "llama" 1))
    (let after-qwen-gen-loss (lmc-observe empty "generate" "qwen35" 0))
    (let branch-local (lmc-branch empty "form" pair 0 1))
    (let branch-native (lmc-branch empty "form" pair 1 1))
    (sum (list
        (lmcb 1 (list
            (str_eq (lmc-home "control") "deepseek4")
            (str_eq (lmc-home "form") "qwen35")
            (str_eq (lmc-mode "qwen35") "form-native-generate")
            (str_eq (lmc-mode "deepseek4") "ds4-control-stack")
            (str_eq (lmc-mode "llama") "llama-metal-ask")
            (str_eq (lmc-mode "mistral") "local-generic")))
        (lmcb 2 (list
            (str_eq (lmc-predict empty "control" pair) "deepseek4")
            (str_eq (lmc-predict empty "form" pair) "qwen35")))
        (lmcb 4 (list
            (str_eq (lmc-task-of "<TIMEOUT> hold") "control")
            (str_eq (lmc-task-of "How does a Recipe differ from a Cell?") "form")))
        (lmcb 8 (list
            (str_eq (lmc-predict after-qwen-control "control" pair) "qwen35")))
        (lmcb 16 (list
            (eq (lmc-in? "llama" (lmc-present-with "llama")) 1)
            (eq (lmc-in? "qwen35" (lmc-present-with "llama")) 1)))
        (lmcb 32 (list
            (str_eq (lmc-predict after-llama-gen "generate" (lmc-present-with "llama")) "llama")))
        (lmcb 64 (list
            (str_eq (lmc-predict after-qwen-gen-loss "generate" pair) "deepseek4")))
        (lmcb 128 (list
            (eq (nth branch-local 0) (alt-local))
            (str_eq (nth branch-local 1) "qwen35")))
        (lmcb 256 (list
            (eq (nth branch-native 0) (alt-native))
            (str_eq (nth branch-native 1) "")))
        (lmcb 512 (list
            (eq (lmc-score-of empty "qwen35" "form") 50)
            (eq (lmc-score-of after-qwen-control "qwen35" "control") 66))))))
