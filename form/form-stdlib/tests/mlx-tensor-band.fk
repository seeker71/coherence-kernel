; mlx-tensor-band.fk — a tensor arrives by REFERENCE, and the GPU lane becomes a
; generation lane.
;
; THE STONE THIS IS. Without it the only way data reaches this GPU is as literal
; lanes in the program text, capped at 256 of them — fine for proving a matmul,
; useless for a forward pass. A program is a string, and a string is not how
; gigabytes of weights should ever travel. `tf32 <path> <off> <r> <c>` names a
; file, a byte offset and a shape; the carrier reads r*c float32 from where they
; already lie. That is the difference between a calculator and a lane a model
; can run in.
;
; WITNESSED ON THE REAL MODEL, not only on this fixture. Qwen3.8-27B-Q8_0.gguf,
; 29,047,086,048 bytes: `output_norm.weight` is 5120 floats of type 0 (F32) at
; absolute offset 1,361,857,504, and `blk.0.attn_norm.weight` is 5120 more at
; 2,746,162,144 — both read out of the tensor table by the body's own
; equireach-gguf. On the GPU their sums are 9953 and 4949, and their matmul —
; (1x5120) x (5120x1), a real dot product of two real weight vectors — is 9626.
; An independent reader of the same bytes says 9953.986, 4949.170 and 9626.986.
; Those runs are in the receipt; this band carries the LAW on a fixture it writes
; itself, so it needs no 29 GB file to be honest.
;
; A SHORT READ IS A REFUSAL. Padding a tensor whose tail the file does not hold
; would hand the GPU whatever malloc last carried, and every number downstream
; would be confidently wrong with nothing saying so. Bit 16 stands there.
;
; fkwu-only organ (same seat as Metal). Every claim is guarded by bit 1, and bit
; 1 is guarded by a lane that PROVED it can compute — an unlinked host reads 0
; and a linked-but-mute one reads 0 too, neither of them a false green.
;
; Verdict 127.
;
; WHAT THIS BAND LEARNED ABOUT ITSELF, 2026-09-09. The door it tests landed in #470 and was taken out
; on 2026-08-25 by a consolidation that cut the carrier from 942 lines to 195 — not by the carrier's
; minimum law, which `tf32` passes (no graph over the other tokens can name a byte offset in a file),
; but as collateral, with nothing anywhere saying so. For the two weeks that followed, this band ran
; and read 49 of 63.
;
; It could do that because two of its bits accepted ANY 0 as a refusal, and 0 is what the carrier
; returns for a program it cannot parse — which is what every one of these programs became the moment
; the token vanished. The same 0 wore three meanings: a refusal, a parse error, and a deleted feature.
; A capability can be removed, its band can keep running, and the band can keep scoring most of the way
; to green; that is the whole failure, and it survived a session that had just written a receipt about
; exactly this shape. It closed because a person asked why the red was still there.
;
; Both repairs are in the band now and neither is about MLX. Bit 1 runs `3 4 add` and demands 7, so a
; lane that answers 0 to everything cannot pass anything — `mlx_linked=true` says a library is
; attached, never that it computes. And `mtb-refused-as?` demands the door's SPECIFIC words, so a short
; read cannot pass as a missing file, neither can pass as a parse error, and none of the three can pass
; as a deleted feature. A 0 is not a refusal; a refusal is a 0 the door can explain.
;
; The programs also say `i32` before they end and build their column vector as `v3 … r2 3 1` rather
; than the retired `m3x1` — the carrier's law cuts both ways, and a band that outlives a vocabulary
; change has to be re-read against the vocabulary that is, not the one it was written for.
;
; preludes: form-stdlib/core.fk form-stdlib/metal-door.fk form-stdlib/form-fs.fk

(do
    (defn mtb-score (ok bit) (if ok bit 0))
    (defn mtb-has (hay needle) (if (lt (str_find hay needle 0) 0) 0 1))
    (defn mtb-live? () (mtb-has (mlx_status) "mlx_linked=true"))
    (defn mtb-path () "/tmp/fk-mlx-tensor-band-fixture.bin")
    ; eight float32 little-endian: two of padding, then [[1,2,3],[4,5,6]]
    (defn mtb-f32 (x) (md-le32 (md-f32-bits x)))
    (defn mtb-bytes ()
        (str_concat (mtb-f32 99.0) (str_concat (mtb-f32 98.0)
        (str_concat (mtb-f32 1.0) (str_concat (mtb-f32 2.0)
        (str_concat (mtb-f32 3.0) (str_concat (mtb-f32 4.0)
        (str_concat (mtb-f32 5.0) (mtb-f32 6.0)))))))))
    ; every program lands ONE int32 — the carrier owns no float return path — so `i32` closes each one.
    (defn mtb-prog (off r c tail)
        (str_concat "tf32 " (str_concat (mtb-path)
        (str_concat " " (str_concat (int_to_str off)
        (str_concat " " (str_concat (int_to_str r)
        (str_concat " " (str_concat (int_to_str c)
        (str_concat " " (str_concat tail " i32")))))))))))
    (defn mlx-tensor-band ()
        (do
    (let wrote (fs-write-text (mtb-path) (mtb-bytes)))
    ; --- the POSITIVE CONTROL, and bit 1 will not move without it. `mlx_linked=true` says a library
    ; is attached, never that it computes; a lane that answers 0 to everything reports linked, reports
    ; no error until asked after the fact, and passes any bit whose whole test is "returns 0". So the
    ; band first makes the lane produce a number it could not produce by failing: 3 4 add = 7. ---
    (let ctl (eq (mlx_run "3 4 add") 7))
    (let c0 (mtb-score (and (eq wrote 32) (and (eq (mtb-live?) 1) ctl)) 1))
    ; the matrix at byte offset 8 is [[1,2,3],[4,5,6]] and sums to 21
    (let c1 (mtb-score (if ctl (eq (mlx_run (mtb-prog 8 2 3 "sum")) 21) 0) 2))
    ; the OFFSET is real: from byte 0 the same shape reads 99+98+1+2+3+4 = 207
    (let c2 (mtb-score (if ctl (eq (mlx_run (mtb-prog 0 2 3 "sum")) 207) 0) 4))
    ; and it multiplies: [[1,2,3],[4,5,6]] x [[1],[10],[100]] = [321,654], sum 975
    (let c3 (mtb-score (if ctl (eq (mlx_run (mtb-prog 8 2 3 "v3 1 10 100 r2 3 1 f32 matmul sum")) 975) 0) 8))
    ; --- A REFUSAL MUST SAY ITS OWN NAME, and these two bits are the reason that sentence is in the
    ; body at all. They used to accept ANY 0 — and 0 is what this carrier returns for a program it
    ; cannot parse, and what it returned every time for the whole month `tf32` was missing from the
    ; carrier entirely. So they scored green for the absence of the very thing they exist to guard,
    ; and the band read 49 of 63 with the door gone. A 0 is not a refusal; a refusal is a 0 the door
    ; can EXPLAIN. Each bit now demands the specific words, so a short read cannot pass as a missing
    ; file, neither can pass as a parse error, and none of the three can pass as a deleted feature. ---
    (defn mtb-refused-as? (prog words)
        (if (eq (mlx_run prog) 0) (mtb-has (mlx_status) words) 0))
    ; a shape longer than the file is REFUSED, never padded
    (let c4 (mtb-score (if ctl (eq (mtb-refused-as? (mtb-prog 8 100 100 "sum")
                                     "last_error=tf32 file is shorter than the shape asked for") 1) 0) 16))
    ; and a path that is not there is refused rather than guessed
    (let c5 (mtb-score (if ctl (eq (mtb-refused-as? "tf32 /tmp/fk-mlx-no-such-fixture.bin 0 2 3 sum i32"
                                     "last_error=tf32 cannot open path") 1) 0) 32))
    ; and the BOUND is a refusal too, not a silent truncation. The door caps at FK_MLX_TENSOR_CAP
    ; elements; a shape past it must be declined by name before a single byte is read, because the
    ; alternative — reading what fits — is the padding wound wearing a different hat.
    (let c6 (mtb-score (if ctl (eq (mtb-refused-as? (mtb-prog 0 4000 1001 "sum")
                                     "last_error=tf32 shape out of range") 1) 0) 64))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6)))))))
    )
    (mlx-tensor-band))
