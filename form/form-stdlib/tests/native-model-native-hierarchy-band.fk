; preludes: form-stdlib/core.fk form-stdlib/native-model-native-hierarchy.fk

(do
    (let rows (nmnh-observed-local-rows))
    (let c0 (if (str_eq (nmnh-default-id) "llama32.form-metal") 1 0))
    (let c1 (if (str_eq (nmnh-comparator-id) "llama32.form-metal") 2 0))
    (let ds4 (nth rows 0))
    (let c2 (if (and (eq (nmnh-direct-metal? ds4) 1)
                     (eq (nmnh-execution-ready? ds4) 0)) 4 0))
    (let c3 (if (str_eq (nmnh-status ds4)
        "layout-native:1406-of-1406;arithmetic-native:898-of-1406;type40-type41-pending") 8 0))
    (let nb-metal (nth rows 2))
    (let c4 (if (and (eq (nmnh-artifact-ready? nb-metal) 1)
                     (eq (nmnh-engine-ready? nb-metal) 0)) 16 0))
    (let nb-carrier (nth rows 3))
    (let c5 (if (and (eq (nmnh-membrane? nb-carrier) 1)
                     (eq (nmnh-ready? nb-carrier 0) false)) 32 0))
    (let native-broken (nmnh-row "broken" "metal" "model" 1 1 0 1 0 999 "broken"))
    (let c6 (if (str_eq
        (nmnh-id (nmnh-select (list native-broken nb-carrier) 1))
        "nanbeige42.llamacpp-comparator") 64 0))
    (sum (list c0 c1 c2 c3 c4 c5 c6)))
