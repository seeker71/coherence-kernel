; form-cli-mlx-ir-band.fk — generic mlx_run: mul and compose have no C opcode.
;
; Verdict 1023:
;   1    Form emit of add is "2 3 add"
;   2    Form emit of mul is "2 3 mul"
;   4    Form emit of (2+3)*4 is "2 3 add 4 mul"
;   8    seed book does not yet know mul
;   16   after learn, mul is home
;   32   learned book has three names
;   64   mlx_run of add emit is 5
;   128  mlx_run of mul emit is 6 (no mlx_mul opcode)
;   256  mlx_run of max emit is 9 (carrier row, not a kernel opcode)
;   512  v2 add then sum is 33 (1-d shape)
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-mlx-ir-xtal.fk
; witnessed: 2026-08-20 -> 1023

(do
    (add (mlg-check)
        (add (if (eq (mlx_run (mlg-emit (mlg-add2))) 5) 64 0)
        (add (if (eq (mlx_run (mlg-emit (mlg-mul2))) 6) 128 0)
        (add (if (eq (mlx_run (mlg-emit (mlg-max2))) 9) 256 0)
             (if (eq (mlx_run (mlg-emit (mlg-vadd-sum))) 33) 512 0))))))
