; care-floor-capitals-band.fk — the care floor hears danger typed in capitals, accented capitals too: someone in
; distress may write NÃO CONSIGO RESPIRAR or DOULEUR À LA POITRINE, and a fold of A..Z alone leaves Ã and À
; uppercase so the phrase never matches. 6 bits -> 63.
; A gap in learn/native-turn-queue.jsonl: the native code lane is asked to turn it green.
; preludes: form-stdlib/bml/care-floor.bml
(do
    (defn cfc-bit (ok n) (if (eq ok 1) n 0))
    (let pt (cf-is "NÃO CONSIGO RESPIRAR" "medical"))
    (let fr (cf-is "DOULEUR À LA POITRINE" "medical"))
    (let fr-choke (cf-is "JE M'ÉTOUFFE" "medical"))
    (let ascii (mul (cf-is "QUIERO MORIR" "self-harm") (cf-is "I WANT TO DIE" "self-harm")))
    (let before (if (eq (cf-self-check) 255) 1 0))
    (let quiet (cf-quiet (list "NÃO SEI ONDE ESTÁ O ARQUIVO" "À BIENTÔT" "ÉTÉ CHAUD ET LONG")))
    (add (cfc-bit pt 1) (add (cfc-bit fr 2) (add (cfc-bit fr-choke 4) (add (cfc-bit ascii 8) (add (cfc-bit before 16) (cfc-bit quiet 32)))))))
