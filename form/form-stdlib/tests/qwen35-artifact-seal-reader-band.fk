; qwen35-artifact-seal-reader-band.fk -- the resident admission organ reads
; the writer's public seal shape, verifies current bytes, and refutes mutation.
;
; preludes: form-stdlib/qwen35-artifact-seal-reader.fk

(do
    (let path "/tmp/qwen35-artifact-seal-reader-band.gguf")
    (let seal-path (qaf-seal-path-for path))
    (let expected
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    (let w0 (fs-write-text path "abc"))
    (let ws (fs-write-text seal-path
        (str_concat "qaf-seal1:3:" expected)))
    (let valid (qaf-seal-valid? path))
    (let verified (qaf-seal-verdict path))
    (let w1 (fs-write-text path "abd"))
    (let refuted (qaf-seal-verdict path))
    (let f0 (fs-remove-file path))
    (let f1 (fs-remove-file seal-path))
    (sum (list
        (if (eq w0 3) 1 0)
        (if (gt ws 0) 2 0)
        (if (eq valid 1) 4 0)
        (if (eq verified 1) 8 0)
        (if (and (eq w1 3) (eq refuted 0)) 16 0)
        (if (and (eq f0 0) (eq f1 0)) 32 0))))
