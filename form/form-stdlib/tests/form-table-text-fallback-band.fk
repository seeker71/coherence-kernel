; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk
;
; form-table-text-fallback-band — direct-source proof that fkc-table-file no
; longer depends on emitted tag 207.  The Form binding is pinned against the
; same canonical text image the emitted carrier uses.
;
; Verdict 15 when:
;   1 fkc-table-file serializes the simple ADD carrier exactly;
;   2 reverse-built roots/rows and negative row values keep their exact order;
;   4 fks-table-file appends raw UTF-8 pool bytes after the same table image;
;   8 empty root/row lists retain the canonical two-token image.
(do
    (let c0 (if (str_eq
                    (fkc-table-file (list (fk-add (fk-lit 40) (fk-lit 2))))
                    "1 2 3 1 40 0 0 1 2 0 0 3 0 1 0")
                1 0))
    (let c1 (if (str_eq
                    (form_table_text
                        (list -7 4)
                        (list (list 2 -3 0 8) (list -1 9)))
                    "2 4 -7 2 -1 9 2 -3 0 8")
                2 0))
    (let c2 (if (str_eq
                    (fks-table-file (list (fk-lit -7)) (list "A" "λ" ""))
                    "1 0 1 1 -7 0 0 3 1 65 2 206 187 0")
                4 0))
    (let c3 (if (str_eq (form_table_text (empty) (empty)) "0 0") 8 0))
    (add c0 (add c1 (add c2 c3))))
