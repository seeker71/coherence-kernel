; glass-view-kept-band.bml — the view a hand chose outlives a molt (form-glass-live.bml, fgl-view-kept, fgl-view-keep).
;
; A molt restarts the live window; it is born in the view kept in .hearth/glass.view, as the ear is born asleep when a
; hand chose sleep. A committed change of view is kept; help is a passing look and is never kept; a word that is no view
; is no choice, and the window is born in meaning.
;
; Expected: 15
; Verdict 15 when every claim lands:
;   1   no kept view: the window is born in meaning
;   2   a kept atlas: the window is born in atlas
;   4   a kept help, or a word that is no view: born in meaning
;   8   a committed change of view is kept, and a change to help leaves the kept view standing
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/form-glass-live.bml
section [form.bml] {
 class GlassViewKeptBand {
  def gvk-state(view) = fgl-control-state-full("all", 0, 0, "absent", view, "all", "none", 0);
  def gvk-put(text) = write_file_text(fgl-view-path(), text);
  def gvk-clear() = host_path_remove(fgl-view-path());
  def gvk-c-none(ctx) {
   let z = gvk-clear();
   (String) fgl-view-kept() == "meaning";
  }
  def gvk-c-atlas(ctx) {
   let w = gvk-put("atlas\n");
   (String) fgl-view-kept() == "atlas";
  }
  def gvk-c-refused(ctx) {
   let w = gvk-put("help");
   let a = fgl-view-kept();
   let w2 = gvk-put("bogus");
   (String) a == "meaning" && (String) fgl-view-kept() == "meaning";
  }
  def gvk-c-keep(ctx) {
   let z = gvk-clear();
   let k = fgl-view-keep(gvk-state("atlas"), gvk-state("raster"));
   let a = fgl-view-kept();
   let h = fgl-view-keep(gvk-state("raster"), gvk-state("help"));
   (String) a == "raster" && (String) fgl-view-kept() == "raster";
  }
 }
 let saved = file_size(".hearth/glass.view") < 0 ? nothing() : read_file(".hearth/glass.view");
 let made = fs-mkdir(".hearth");
 let verdict = live-claims("glass-view-kept-band", 0, [["none", 1, 1, gvk-c-none], ["atlas", 2, 1, gvk-c-atlas], ["refused", 4, 1, gvk-c-refused], ["keep", 8, 1, gvk-c-keep]]);
 let back = nothing?(saved) ? host_path_remove(".hearth/glass.view") : write_file_text(".hearth/glass.view", saved);
 verdict;
}
