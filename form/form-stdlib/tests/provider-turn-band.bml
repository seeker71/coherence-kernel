; provider-turn-band.bml — a provider turn's kind, read by the share meter from its own transcript (form-stdlib/bml/provider-turn.bml, observe/provider-turn-kind-run.bml).
;
; Fixture transcripts in a scratch directory, the meter a real child. No provider and no model is asked.
;
; Expected: 63
; Verdict 63 when every claim lands:
;   1   a headless transcript (a claude -p session file's shape) reads kind=unknown, never observed, and its row lands saying so with no rent read from it beyond what the provider reported
;   2   a turn with no transcript (codex exec --ephemeral) reads kind=unknown reason=no-transcript, and with no reported usage its row carries no rent column: unknown, never 0
;   4   a codex rollout in the shape codex-cli writes today, its task_started id under turn_attribution, reads kind=observed with the meter's total
;   8   measured-twice: the provider's total disagreeing with the meter's reads unknown, by name; agreeing reads observed
;   16  a row holds the kind and the door and none of the turn's words
;   32  the transcripts are found: a claude session file under its home, a rollout by the run directory its opening line names
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/provider-turn.bml form-stdlib/form-fs.fk
section [form.bml] {
 class ProviderTurnBand {
  def ptb-rel() = ".hearth/provider-turn-band";
  def ptb-dir() = fhn-root() ++ "/" ++ ptb-rel();
  def ptb-has?(hay, needle) = str_find(hay, needle, 0) >= 0;
  def ptb-words() = "a public sentence the row must not repeat";
  def ptb-headless() = "{\"type\":\"user\",\"sessionId\":\"s\",\"message\":{\"role\":\"user\",\"content\":\"" ++ ptb-words() ++ "\"},\"timestamp\":\"2026-11-02T00:00:00.000Z\"}\n{\"type\":\"assistant\",\"sessionId\":\"s\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"hi\"}],\"usage\":{\"input_tokens\":3,\"output_tokens\":1}},\"timestamp\":\"2026-11-02T00:00:01.000Z\"}\n";
  def ptb-env(ordinal, stamp, payload) = "{\"timestamp\":\"2026-11-02T00:00:" ++ stamp ++ ".000Z\",\"ordinal\":" ++ ordinal.str() ++ ",\"type\":\"event_msg\",\"payload\":" ++ payload ++ "}\n";
  def ptb-turn() = "01a15d84-f3fd-7e83-a505-502caefc5a98";
  def ptb-usage(i, c, o, r, t) = "{\"input_tokens\":" ++ i.str() ++ ",\"cached_input_tokens\":" ++ c.str() ++ ",\"output_tokens\":" ++ o.str() ++ ",\"reasoning_output_tokens\":" ++ r.str() ++ ",\"total_tokens\":" ++ t.str() ++ "}";
  def ptb-rollout() =
   "{\"timestamp\":\"2026-11-02T00:00:00.000Z\",\"ordinal\":0,\"type\":\"session_meta\",\"payload\":{\"session_id\":\"01a15d30-eba2-7121-a9b4-65e2f5f561e2\",\"id\":\"01a15d30-eba2-7121-a9b4-65e2f5f561e2\",\"model_provider\":\"openai\",\"cwd\":\"/tmp/review-panel/1793/work\"}}\n"
   ++ ptb-env(1, "01", "{\"type\":\"task_started\",\"turn_attribution\":{\"turn_id\":\"" ++ ptb-turn() ++ "\",\"turn_trigger\":\"composer\"},\"started_at\":1793561001}")
   ++ "{\"timestamp\":\"2026-11-02T00:00:01.000Z\",\"ordinal\":2,\"type\":\"turn_context\",\"payload\":{\"turn_id\":\"" ++ ptb-turn() ++ "\",\"model\":\"gpt-fixture\"}}\n"
   ++ "{\"timestamp\":\"2026-11-02T00:00:02.000Z\",\"ordinal\":3,\"type\":\"token_usage_record\",\"payload\":{\"thread_id\":\"t\",\"turn_id\":\"" ++ ptb-turn() ++ "\",\"session_id\":\"01a15d30-eba2-7121-a9b4-65e2f5f561e2\",\"response_id\":\"r\",\"usage\":" ++ ptb-usage(100, 40, 20, 5, 120) ++ "}}\n"
   ++ ptb-env(4, "02", "{\"type\":\"token_count\",\"info\":{\"total_token_usage\":" ++ ptb-usage(100, 40, 20, 5, 120) ++ ",\"last_token_usage\":" ++ ptb-usage(100, 40, 20, 5, 120) ++ "}}")
   ++ ptb-env(5, "03", "{\"type\":\"task_complete\",\"turn_id\":\"" ++ ptb-turn() ++ "\",\"last_agent_message\":\"done\",\"started_at\":1793561001,\"completed_at\":1793561003,\"duration_ms\":2000,\"time_to_first_token_ms\":500}");
  def ptb-write(name, text) { let w = write_file_text(ptb-dir() ++ "/" ++ name, text); ptb-dir() ++ "/" ++ name; }
  def ptb-c-headless(ctx) = (String) ctx[0][0] == "unknown" && ptb-has?(ctx[0][1], "kind=unknown reason=") && !ptb-has?(ctx[3], "\"kind\":\"observed\"") && ptb-has?(ctx[3], "\"door\":\"fixture-headless\",\"source\":\"provider\",\"provider\":\"claude\",\"status\":\"0\",\"kind\":\"unknown\"") && ptb-has?(ctx[3], "\"rent_tokens\":4");
  def ptb-c-none(ctx) = (String) ctx[1][0] == "unknown" && (String) ctx[1][1] == "kind=unknown reason=no-transcript" && ptb-has?(ctx[3], "fixture-none") && !ptb-has?(ptb-line(ctx[3], "fixture-none"), "rent_tokens");
  def ptb-line(text, needle) = foldl((best, l) => ptb-has?(l, needle) ? l : best, "", split-on(text, "\n"));
  def ptb-c-rollout(ctx) = (String) ctx[2][0] == "observed" && ptb-has?(ctx[2][1], "kind=observed scope=previous-completed-turn") && ptb-has?(ctx[2][1], "turn=" ++ ptb-turn());
  def ptb-c-twice(ctx) {
   let total = pt-word(ctx[2][1], "total");
   let no = pt-read-line(ctx[2][1], str_to_int(total) + 1);
   let yes = pt-read-line(ctx[2][1], str_to_int(total));
   (String) no[0] == "unknown" && ptb-has?(no[1], "reason=measured-twice-disagrees") && (String) yes[0] == "observed";
  }
  def ptb-c-words(ctx) = !ptb-has?(ctx[3], ptb-words());
  def ptb-c-found(ctx) = (String) ctx[4] == ptb-dir() ++ "/home/projects/-x/s1.jsonl" && (String) pt-claude-transcript(ptb-dir() ++ "/home", "absent") == "" && (String) ctx[5] == ptb-dir() ++ "/codex/sessions/2026/11/02/rollout-a.jsonl" && (String) pt-codex-rollout(ptb-dir() ++ "/codex", "2026-11-02", "review-panel/9999/work") == "";
  def ptb-run() {
   let swept = fs-remove-tree(ptb-dir());
   let m = hch-mkdirs(ptb-dir());
   let ledger = ptb-dir() ++ "/ledger.jsonl";
   let root = fhn-root();
   let headless = ptb-write("headless.jsonl", ptb-headless());
   let rollout = ptb-write("rollout.jsonl", ptb-rollout());
   let h = pt-land-at(ledger, root, ptb-dir() ++ "/m1", "fixture-headless", "claude", headless, 4, "0");
   let n = pt-land-at(ledger, root, ptb-dir() ++ "/m2", "fixture-none", "codex", "", nothing(), "0");
   let r = pt-read(root, ptb-dir() ++ "/m3", rollout, nothing());
   let a = hch-mkdirs(ptb-dir() ++ "/home/projects/-x");
   let a2 = ptb-write("home/projects/-x/s1.jsonl", "{}\n");
   let b = hch-mkdirs(ptb-dir() ++ "/codex/sessions/2026/11/02");
   let b2 = ptb-write("codex/sessions/2026/11/02/rollout-a.jsonl", ptb-rollout());
   let ctx = [h, n, r, read_file(ledger) ?? "", pt-claude-transcript(ptb-dir() ++ "/home", "s1"), pt-codex-rollout(ptb-dir() ++ "/codex", "2026-11-02", "review-panel/1793/work")];
   let verdict = live-claims("provider-turn-band", ctx, [["headless", 1, 1, ptb-c-headless], ["none", 2, 1, ptb-c-none], ["rollout", 4, 1, ptb-c-rollout], ["twice", 8, 1, ptb-c-twice], ["words", 16, 1, ptb-c-words], ["found", 32, 1, ptb-c-found]]);
   let cleaned = fs-remove-tree(ptb-dir());
   verdict;
  }
 }
 ptb-run();
}
