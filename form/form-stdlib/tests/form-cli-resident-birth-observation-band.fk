; form-cli-resident-birth-observation-band.fk -- public birth lines become
; one BML typed record; missing fields remain nothing, never a forged zero.
; Expected: 255
; preludes: form-stdlib/bml/form-cli-resident-birth-observation.bml

(do
    (defn fcrbob-bit (ok bit) (if ok bit 0))
    (let observed "form-peer program-image-cache=ready\nform-peer source-context-ms=0\nform-peer native-program-ms=7\nform-peer resident-setup-ms=7\nform-peer admit-prefill-ms=11\n")
    (let birth (fcrbo-snapshot observed))
    (let absent (fcrbo-snapshot ""))
    (sum (list
        (fcrbob-bit (eq (fcrbo-snapshot? birth) 1) 1)
        (fcrbob-bit (and (str_eq (fcrbo-cache birth) "ready")
            (and (eq (fcrbo-source-context-ms birth) 0)
                (and (eq (fcrbo-native-program-ms birth) 7)
                    (and (eq (fcrbo-resident-setup-ms birth) 7)
                         (eq (fcrbo-prefill-ms birth) 11))))) 2)
        (fcrbob-bit (and (nothing? (fcrbo-cache absent))
            (and (nothing? (fcrbo-source-context-ms absent))
                (and (nothing? (fcrbo-native-program-ms absent))
                    (and (nothing? (fcrbo-resident-setup-ms absent))
                         (nothing? (fcrbo-prefill-ms absent)))))) 4)
        (fcrbob-bit (str_eq (fcrbo-display-text(fcrbo-cache absent)) "nothing") 8)
        (fcrbob-bit (str_eq (fcrbo-display-int(fcrbo-source-context-ms absent)) "nothing") 16)
        (fcrbob-bit (str_eq (fcrbo-display-int(fcrbo-source-context-ms birth)) "0") 32)
        (fcrbob-bit (str_eq (fcrbo-cache-key) "program-image-cache") 64)
        (fcrbob-bit (and (str_eq (fcrbo-source-context-key) "source-context-ms")
            (and (str_eq (fcrbo-native-program-key) "native-program-ms")
                (and (str_eq (fcrbo-resident-setup-key) "resident-setup-ms")
                     (str_eq (fcrbo-prefill-key) "admit-prefill-ms")))) 128))))
