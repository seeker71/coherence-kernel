; preludes: form-stdlib/core.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/safetensors-bf16-slice.fk
;
; Verdict 255: native byte-range arithmetic and bf16 decoding.
(do
    ; LE bf16 patterns: 1.0, -3.0, 0.25, 2.0.
    (let bytes (list 128 63 64 192 128 62 0 64))
    (let v (sbfs-decode-bytes bytes 4))
    (add
        (if (eq (len v) 4) 1 0)
        (add (if (eq (round (nth v 0)) 1) 2 0)
        (add (if (eq (round (nth v 1)) -3) 4 0)
        (add (if (eq (round (mul (nth v 2) 100.0)) 25) 8 0)
        (add (if (eq (round (nth v 3)) 2) 16 0)
        (add (if (eq (sbfs-file-start 10672 0) 10680) 32 0)
        (add (if (eq (sbfs-range-valid? 4973547960 10672 0 1024) 1) 64 0)
             (if (and (eq (sbfs-bf16-shape-bytes 3072 0) 6144)
                      (eq (len (sbfs-decode-bytes bytes 3)) 0)) 128 0)))))))))
