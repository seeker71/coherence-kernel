; dsv4-tokenizer-native-band.fk — native-image encode/decode witness.
;
; Plain invocation selects the compiled .fkb:
;   ./fkwu form/form-stdlib/tests/dsv4-tokenizer-native-band.fk </dev/null  # -> 15
;
; No external tokenizer participates; the model file's header (an 8 MB window) is the only thing read.
;
; Verdict 15 = 1 encode of "The capital of France is" is [671 6102 294 8760 344]
;            | 2 decode of those ids is the exact bytes of the text
;            | 4 id 19129 decodes to the bytes of a BOM and "using"
;            | 8 the vocabulary counts 129280
;
; PROOF LEVEL: FOURTH-ARM ONLY -- reads the model file's header (8 MB window); the file is a host-local path outside the tree
;
; preludes: form-stdlib/dsv4-tokenizer.fk form-stdlib/model-registry.bml

(do
    (defn dtn-file ()
        (mr-path (mr-find "ds4flash")))
    (defn dtn-eq (a b)
        (if (eq (len a) (len b))
            (if (eq (len a) 0) 1
                (if (eq (head a) (head b)) (dtn-eq (tail a) (tail b)) 0))
            0))

    (let src (tkz-src (dtn-file)))
    (let ids (tkz-encode src "The capital of France is"))
    (let a (if (dtn-eq ids (list 671 6102 294 8760 344)) 1 0))
    (let b (if (dtn-eq (tkz-decode-bytes src ids)
        (list 84 104 101 32 99 97 112 105 116 97 108 32 111 102 32
              70 114 97 110 99 101 32 105 115)) 2 0))
    (let c (if (dtn-eq (tkz-decode-id-bytes src 19129)
        (list 239 187 191 117 115 105 110 103)) 4 0))
    (let d (if (eq (tkz-vocab-n src) 129280) 8 0))
    (add a (add b (add c d))))
