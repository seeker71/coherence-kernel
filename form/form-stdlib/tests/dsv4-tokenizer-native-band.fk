; dsv4-tokenizer-native-band.fk — native-image encode/decode witness.
;
; Plain invocation selects the compiled .fkb:
;   ./fkwu form/form-stdlib/tests/dsv4-tokenizer-native-band.fk  # -> 15
;
; No `--src`, proof-sibling runtime, or external tokenizer participates.
; preludes: form-stdlib/dsv4-tokenizer.fk

(do
    (defn dtn-file ()
        "/Users/ursmuff/models/ds4/ds4flash-v5mx-reap25-type40-mxfp8lt-dspark-v1.gguf")
    (defn dtn-eq (a b)
        (if (eq (len a) (len b))
            (if (eq (len a) 0) 1
                (if (eq (head a) (head b)) (dtn-eq (tail a) (tail b)) 0))
            0))

    (let src (tkz-src (dtn-file)))
    (let ids (tkz-encode src "The capital of France is"))
    (let a (if (dtn-eq ids (list 671 6102 294 8760 344)) 1 0))
    (let b (if (dtn-eq (tkz-decode-bytes src ids)
        (list 84 104 101 32 99 97 112 105 116 97 108 32 111 102 32
              70 114 97 110 99 101 32 105 115)) 2 0))
    (let c (if (dtn-eq (tkz-decode-id-bytes src 19129)
        (list 239 187 191 117 115 105 110 103)) 4 0))
    (let d (if (eq (tkz-vocab-n src) 129280) 8 0))
    (add a (add b (add c d))))
