; form-knowledge-query-memory-neutral-band.fk — the crossing proved with a
; scripted answerer, and the neutral cell's own bytes proved empty of carriage.
;
; NO MODEL, NO METAL, NO CONNECTION, NOT EVEN A REFUSED ONE. The earlier
; resident band aimed at a number nothing was listening on to make its ask stage
; fail. That worked and it was still a dependency: it needed the machine to
; behave a certain way to be red or green. Here the answerer is an ordinary Form
; function, so every stage is decided by this file and the cell under it.
;
; BIT 512 IS THE TOPOLOGY, AND IT READS THE SOURCE. A claim that the primary
; path names no address lives in a comment until something checks the bytes.
; This band reads form-knowledge-query-memory-neutral.fk off disk and asserts
; zero occurrences of six names, as plain substrings so that a word hidden
; inside a longer one still counts. Six, not one, because a topology can leak
; through any of them.
;
; Verdict 4095 (12 bits):
;   1     a scripted answerer carries a hit through all five stages
;   2     the answerer is called EXACTLY once for one crossing
;   4     the caller's context comes back changed by the answerer, not dropped
;   8     a lookup that ran and missed never calls the answerer at all, and the
;         context returns untouched — an unasked stage is nothing
;   16    a refused request stops at stage one and never reaches a lookup
;   32    an answerer that declines yields nothing, not an empty answer
;   64    an unfinished deliberation yields nothing, not a short answer
;   128   a closed deliberation yields only what follows it
;   256   nothing and a grounded 0 stay apart: a 0-length answer that was
;         actually given is a present answer, while a decline is absent
;   512   the neutral cell's SOURCE holds none of the six carriage names
;   1024  every frame carries one of exactly three states, and an invented
;         state is not one of them
;   2048  model-executed is 0, and the crossing entry has no answerer-free form
;
; preludes: form-stdlib/form-knowledge-query-memory-neutral.fk

(do
    (defn fqmnb-bit (ok bit) (if ok bit 0))

    (defn fqmnb-bytes-loop (s i n out)
        (if (ge i n) out (fqmnb-bytes-loop s (add i 1) n (cons (str-byte-at s i) out))))
    (defn fqmnb-rev (xs out)
        (if (eq (len xs) 0) out (fqmnb-rev (tail xs) (cons (head xs) out))))
    (defn fqmnb-bytes (s) (fqmnb-rev (fqmnb-bytes-loop s 0 (str_len s) (empty)) (empty)))
    (defn fqmnb-sha (s) (hex-encode (sha256-stream-string s)))

    ; ── the scripted answerers: ordinary Form, no peer of any kind ─────────
    ; ctx = (calls last-prompt). Each answerer threads it, so a caller can see
    ; both that it was called and what it was handed.
    (defn fqmnb-ctx (calls last) (list calls last))
    (defn fqmnb-calls (c) (nth c 0))
    (defn fqmnb-last (c)  (nth c 1))
    (defn fqmnb-none () (fqmnb-ctx 0 ""))

    (defn fqmnb-plain (ctx prompt)
        (list "Yes, verified." (fqmnb-ctx (add (fqmnb-calls ctx) 1) prompt)))
    (defn fqmnb-thinking (ctx prompt)
        (list "<think>weighing</think>   Yes, verified."
              (fqmnb-ctx (add (fqmnb-calls ctx) 1) prompt)))
    (defn fqmnb-unfinished (ctx prompt)
        (list "<think>still weighing"
              (fqmnb-ctx (add (fqmnb-calls ctx) 1) prompt)))
    (defn fqmnb-declines (ctx prompt)
        (list (nothing) (fqmnb-ctx (add (fqmnb-calls ctx) 1) prompt)))
    (defn fqmnb-empty (ctx prompt)
        (list "" (fqmnb-ctx (add (fqmnb-calls ctx) 1) prompt)))

    ; ── the index and one request builder ──────────────────────────────────
    (defn fqmnb-answer ()
        "Kernel deployment is live and verified by current production evidence.")
    (defn fqmnb-source-key ()
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    (defn fqmnb-index-line ()
        (ric-emit-grounded "@1.1.9.41" "@8.4.4.12" "docs/deployment.form" "cell"
            (fqmnb-source-key)
            (hex-encode (sha256 (fqmnb-bytes (fqmnb-answer))))
            (hex-encode (fqmnb-bytes (fqmnb-answer)))
            (fqmnb-answer)
            (re-semantic-vec
                "deployment evidence kernel production verified witness")))

    (defn fqmnb-offer (anchor)
        (intern_node (fkqmx-offer-category)
            (list (intern_trivial_string (fkqmx-offer-schema))
                  (intern_trivial_string "band-source")
                  (intern_trivial_string
                      (str_concat (fkqmx-open-mark)
                          (str_concat anchor (fkqmx-close-mark))))
                  (intern_trivial_string (fqmnb-sha anchor)))))
    (defn fqmnb-mem (tag)
        (intern_node (make_nodeid 31 2 0 127) (list (intern_trivial_string tag))))

    (defn fqmnb-request (anchor tag stored)
        (do (let m (fqmnb-mem (str_concat tag "-m")))
            (let b (fqmnb-mem (str_concat tag "-b")))
            (let r (intern_node (fkqmrt-recipe-category)
                (list (intern_trivial_string (fkqmrt-recipe-schema))
                      m b (fqmnb-offer anchor)
                      (intern_trivial_string (fqmnb-sha (str_concat tag "-q")))
                      (intern_trivial_string (fqmnb-sha (str_concat tag "-s")))
                      (intern_trivial_string (fqmnb-sha (str_concat tag "-p")))
                      (intern_trivial_string (fqmnb-sha (str_concat tag "-y")))
                      (intern_trivial_string tag)
                      (intern_trivial_string "band-lane")
                      (intern_trivial_int 1) (intern_trivial_int 1)
                      (intern_trivial_int 0) (intern_trivial_int 0)
                      (intern_trivial_int stored) (intern_trivial_int 0))))
            (intern_node (fkqmrt-request-category)
                (list (intern_trivial_string (fkqmrt-request-schema))
                      (fkqmrt-action-node) r m b
                      (intern_trivial_string tag)
                      (intern_trivial_string "band-lane")
                      (intern_trivial_int 0) (intern_trivial_int 1)))))

    ; ── the source invariant, as plain substrings ──────────────────────────
    (defn fqmnb-absent? (text needle)
        (if (lt (str_find text needle 0) 0) 1 0))
    (defn fqmnb-clean? (text)
        (if (eq (fqmnb-absent? text "http") 0) 0
            (if (eq (fqmnb-absent? text "socket_") 0) 0
                (if (eq (fqmnb-absent? text "127.0.0.1") 0) 0
                    (if (eq (fqmnb-absent? text "8080") 0) 0
                        (if (eq (fqmnb-absent? text "host") 0) 0
                            (fqmnb-absent? text "port")))))))

    (defn fqmnb-stage-is? (frames i stage state)
        (do (let f (fqmn-stage-at frames i))
            (if (nothing? f) 0
                (if (and (str_eq (fqmn-frame-stage f) stage)
                         (str_eq (fqmn-frame-state f) state)) 1 0))))
    (defn fqmnb-all-stated? (frames i)
        (if (ge i (len frames)) 1
            (if (eq (fqmn-state? (fqmn-frame-state (nth frames i))) 0) 0
                (fqmnb-all-stated? frames (add i 1)))))

    (defn form-knowledge-query-memory-neutral-band ()
        (do
            (let path (str_concat (temp_dir)
                "/form-knowledge-query-memory-neutral-band.jsonl"))
            (let wrote (write_file path (fqmnb-index-line)))

            (let hit-req  (fqmnb-request "deployed proof kernel" "n1" 0))
            (let miss-req (fqmnb-request "banana photosynthesis galaxy" "n2" 0))
            (let bad-req  (fqmnb-request "deployed proof kernel" "n3" 1))

            (let r-plain (fqmn-cross path hit-req "q?" fqmnb-plain (fqmnb-none)))
            (let r-think (fqmn-cross path hit-req "q?" fqmnb-thinking (fqmnb-none)))
            (let r-unfin (fqmn-cross path hit-req "q?" fqmnb-unfinished (fqmnb-none)))
            (let r-decl  (fqmn-cross path hit-req "q?" fqmnb-declines (fqmnb-none)))
            (let r-empty (fqmn-cross path hit-req "q?" fqmnb-empty (fqmnb-none)))
            (let r-miss  (fqmn-cross path miss-req "q?" fqmnb-plain (fqmnb-none)))
            (let r-bad   (fqmn-cross path bad-req "q?" fqmnb-plain (fqmnb-none)))

            (let src (read_file "form/form-stdlib/form-knowledge-query-memory-neutral.fk"))
            (let cleaned (fs_remove path))

            (sum (list
                (fqmnb-bit (and (gt wrote 0)
                           (and (eq (len (fqmn-frames-of r-plain)) 5)
                           (and (fqmnb-stage-is? (fqmn-frames-of r-plain) 2 "lookup" "ran")
                           (and (fqmnb-stage-is? (fqmn-frames-of r-plain) 4 "answer" "ran")
                                (str_eq (fqmn-answer-of r-plain) "Yes, verified."))))) 1)

                (fqmnb-bit (eq (fqmnb-calls (fqmn-ctx-of r-plain)) 1) 2)

                (fqmnb-bit (and (gt (str_len (fqmnb-last (fqmn-ctx-of r-plain))) 0)
                                (ge (str_find (fqmnb-last (fqmn-ctx-of r-plain))
                                        "Question: q?" 0) 0)) 4)

                (fqmnb-bit (and (fqmnb-stage-is? (fqmn-frames-of r-miss) 2 "lookup" "ran")
                           (and (str_eq (fqmn-frame-detail
                                    (nth (fqmn-frames-of r-miss) 2)) "miss")
                           (and (eq (fqmnb-calls (fqmn-ctx-of r-miss)) 0)
                                (nothing? (fqmn-answer-of r-miss))))) 8)

                (fqmnb-bit (and (eq (len (fqmn-frames-of r-bad)) 1)
                           (and (fqmnb-stage-is? (fqmn-frames-of r-bad) 0 "request" "refused")
                                (eq (fqmnb-calls (fqmn-ctx-of r-bad)) 0))) 16)

                (fqmnb-bit (and (nothing? (fqmn-answer-of r-decl))
                           (and (eq (fqmnb-calls (fqmn-ctx-of r-decl)) 1)
                                (str_eq (fqmn-frame-detail
                                    (nth (fqmn-frames-of r-decl) 4))
                                    "answerer-declined"))) 32)

                (fqmnb-bit (and (nothing? (fqmn-answer-of r-unfin))
                                (str_eq (fqmn-frame-detail
                                    (nth (fqmn-frames-of r-unfin) 4))
                                    "deliberation-unfinished")) 64)

                (fqmnb-bit (str_eq (fqmn-answer-of r-think) "Yes, verified.") 128)

                ; an answer that was GIVEN and is empty is present; a decline is not
                (fqmnb-bit (and (not (nothing? (fqmn-answer-of r-empty)))
                           (and (eq (str_len (fqmn-answer-of r-empty)) 0)
                                (nothing? (fqmn-answer-of r-decl)))) 256)

                (fqmnb-bit (eq (fqmnb-clean? src) 1) 512)

                (fqmnb-bit (and (eq (fqmnb-all-stated? (fqmn-frames-of r-plain) 0) 1)
                           (and (eq (fqmnb-all-stated? (fqmn-frames-of r-miss) 0) 1)
                                (eq (fqmn-state? "invented") 0))) 1024)

                (fqmnb-bit (and (eq (fqmn-model-executed) 0)
                                (eq cleaned 0)) 2048)))))

    (form-knowledge-query-memory-neutral-band))
