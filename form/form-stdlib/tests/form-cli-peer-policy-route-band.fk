; form-cli-peer-policy-route-band.fk -- one scannerless policy image replaces
; the peer action route without reopening a model context. Expected: 16383.
;
; The test holds an empty shared context: JIT policy selection is proven here,
; while the live Qwen session remains outside this route host.
;
; PROOF LEVEL: FOURTH-ARM ONLY — `jonb-request` reaches the resident
; `jit_leaf_inram` carrier. Go has this on the current Darwin host, while the
; Rust/TypeScript siblings intentionally do not bind that runtime page carrier;
; asking them for this verdict would fold a missing crossing into a false test.
; Verdict 8191.
;
; preludes: form-stdlib/form-cli-peer-contribution-turnwheel.fk

(do
    (defn fcprb-bit (held weight) (if held weight 0))
    (defn fcprb-shared ()
        (fcrt-shared "local-qwen" "qwen-resident-source"
            (list "held-qwen-context") (list "held-tokenizer-crystal")
            256 8 (jonb-registry 1)))
    (defn fcprb-host ()
        (fcrt-host-from-shared (fcprb-shared) 0 1 (fcpr-default-route 1)))
    (defn fcprb-session ()
        (fcms-session "live" "held-model" "local-qwen"
            "qwen-resident-source" (list "held-qwen-context")
            (list "held-kv-state") 256 7 11 0 13 17 19 23))
    (defn fcprb-organ (channel)
        (rai-organ (list (rai-channel channel 16 16 0)) 8))
    (defn fcprb-transport (channel egress)
        (do
            (let join (nth (ritj-ready
                (ritj-new (fcprb-host) (fcprb-organ channel) channel 8) 1) 0))
            (fcpat-new join (fcpsi-new (fcprb-organ channel) 8)
                (fcpat-reader "policy-band" channel "/tmp/form-policy-no-input"
                    1 "wait" -1 64 0)
                egress 8 4)))
    (defn fcprb-task (channel turn kind text)
        (fcpsi-frame-parse channel turn 1
            (fcpa-task-frame turn kind text) (add 100 turn)))
    (defn fcprb-image (symbol root program)
        (str_concat (fcpr-open)
        (str_concat "symbol="
        (str_concat symbol
        (str_concat "\nroot="
        (str_concat (int_to_str root)
        (str_concat "\nprogram="
        (str_concat program (fcpr-close)))))))))
    (defn fcprb-host-of (transport)
        (ritj-host (fcpat-join transport)))
    (defn fcprb-shared-of (transport)
        (wt-sctx (le-w (fcrt-lw (fcprb-host-of transport)))))
    (defn fcprb-reg-size (transport)
        (jonb-size (fcrt-shared-registry
            (wt-sctx (le-w (fcrt-lw (fcprb-host-of transport)))))))
    (defn fcprb-table-size (transport)
        (len (le-tbl (fcrt-lw (fcprb-host-of transport)))))
    (defn fcprb-with-pending (transport task)
        (do
            (let peer0 (fcpat-peer transport))
            (let peer (fcpsi-with peer0 (fcpsi-ingress peer0)
                (fcpsi-cursors peer0)
                (append (fcpsi-tasks peer0) (list task))
                (fcpsi-candidates peer0) (fcpsi-events peer0)))
            (fcpat-with transport (fcpat-join transport) peer
                (fcpat-reader-row transport)
                (append (fcpat-pending transport) (list task))
                (fcpat-acks transport) (fcpat-events transport)
                (fcpat-released? transport))))

    (defn form-cli-peer-policy-route-band ()
        (do
            (let channel "@0.2.0.994")
            (let transport0 (fcprb-transport channel "/tmp/form-policy-no-output"))
            (let knowledge (fcprb-task channel 1 "source-concept" "ignored"))
            (let default (fcpr-select transport0 knowledge))
            (let c0 (fcprb-bit (and
                (str_eq (fcpr-selection-signal default) "returned")
                (and (eq (fcpr-selection-value default) 2)
                     (str_eq (fcpr-selection-action default)
                         "source-knowledge"))) 1))
            (let symbol-task (fcprb-task channel 0 "source-symbol"
                "fcpct-task-key"))
            (let symbol-selected (fcpr-select transport0 symbol-task))
            (let c12 (fcprb-bit (and
                (str_eq (fcpr-selection-signal symbol-selected) "returned")
                (and (eq (fcpr-selection-value symbol-selected) 4)
                     (str_eq (fcpr-selection-action symbol-selected)
                         "source-symbol"))) 4096))
            (let c1 (fcprb-bit (and
                (not (nothing? (fcpr-selection-route-node default)))
                (eq (fcprb-reg-size
                    (fcpr-selection-transport default)) 1)) 2))

            ; The image is raw task text. No NodeID is supplied by the task;
            ; publication recomputes it from image rows and the live epoch.
            (let publish-task (fcprb-task channel 2 "publish"
                (fcprb-image "arriving/policy/model" 0 "1,1")))
            (let published (fcpr-publish
                (fcpr-selection-transport default) publish-task 7))
            (let c2 (fcprb-bit (and
                (str_eq (fcpr-selection-signal published) "value")
                (and (eq (fcpr-selection-present? published) 1)
                     (not (nothing? (fcpr-selection-route-node published))))) 4))
            (let selected (fcpr-select
                (fcpr-selection-transport published) knowledge))
            (let c3 (fcprb-bit (and
                (str_eq (fcpr-selection-signal selected) "returned")
                (and (eq (fcpr-selection-value selected) 1)
                     (str_eq (fcpr-selection-action selected) "model"))) 8))
            (let c4 (fcprb-bit (and
                (eq (fcprb-table-size
                    (fcpr-selection-transport selected)) 2)
                (eq (fcprb-reg-size
                    (fcpr-selection-transport selected)) 2)) 16))
            ; The policy's JIT registry grows as it learns the arriving image,
            ; while the long-lived Qwen/KV and tokenizer seats stay exact.
            ; This is the no-restart proof for an action epoch change, not a
            ; claim that the model executed during policy selection.
            (let shared0 (fcprb-shared-of transport0))
            (let shared2 (fcprb-shared-of (fcpr-selection-transport selected)))
            (let c10 (fcprb-bit (and
                (eq (fcpr-residence-retained? shared0 shared2) 1)
                (not (eq (value_eq (fcrt-shared-registry shared0)
                    (fcrt-shared-registry shared2)) 1))) 1024))
            ; The live peer uses this non-owning form: policy JIT sees the
            ; exact open model context, while its wheel has no model row or KV
            ; state to advance/release. A non-live seed is absence, not a host.
            (let seed (fcprb-session))
            (let policy-host (fcrt-policy-host-from-session seed 0 1
                (fcpr-default-route 1) 8))
            (let absent-policy-host (fcrt-policy-host-from-session
                (fcms-none "absent") 0 1 (fcpr-default-route 1) 8))
            (let c11 (fcprb-bit (and
                (eq (fcrt-policy-host-shares-session? policy-host seed) 1)
                (nothing? absent-policy-host)) 2048))

            ; A present but unadmitted zero remains present and becomes choice;
            ; it never turns into `nothing` or silently picks a source action.
            (let zero-task (fcprb-task channel 3 "publish"
                (fcprb-image "arriving/policy/zero" 0 "1,0")))
            (let zero-published (fcpr-publish
                (fcpr-selection-transport selected) zero-task 8))
            (let zero-selected (fcpr-select
                (fcpr-selection-transport zero-published) knowledge))
            (let c5 (fcprb-bit (and
                (str_eq (fcpr-selection-signal zero-selected) "choice")
                (and (eq (fcpr-selection-present? zero-selected) 1)
                     (and (eq (fcpr-selection-value zero-selected) 0)
                          (nothing? (fcpr-selection-action zero-selected))))) 32))

            (let malformed (fcpr-route-from-text
                (ritj-host (fcpat-join (fcpr-selection-transport zero-selected)))
                (fcprb-image "bad" 9 "1,1")))
            (let c6 (fcprb-bit (nothing? malformed) 64))
            (let frame (fcpr-frame knowledge selected "select"))
            (let c7 (fcprb-bit (and
                (ge (str_find frame "<|form:peer-policy|>" 0) 0)
                (and (ge (str_find frame "\naction=model" 0) 0)
                     (lt (str_find frame "\ntask=ignored" 0) 0))) 128))

            ; The same raw image crosses the full peer contribution wheel.
            ; It first publishes a zero-returning policy and then chooses no
            ; action for a model task. Both policy frames become durable before
            ; their tasks become seen; no model forward is requested.
            (let egress (str_concat (temp_dir) "/form-policy-route.reply"))
            (fs_remove egress)
            (let publish0 (fcprb-task channel 20 "publish"
                (fcprb-image "arriving/policy/zero-durable" 0 "1,0")))
            (let state0 (fcpct-new
                (fcprb-with-pending (fcprb-transport channel egress) publish0)
                (list "held-qwen-session")))
            (let moved0 (fcpct-turn state0 1 8))
            (let state1 (fcpct-result-state moved0))
            (let durable0 (read_file egress))
            (let c8 (fcprb-bit (and
                (eq (fcpct-completed state1) 1)
                (and (eq (fcpct-contributions state1) 0)
                     (and (eq (fcpct-task-durable? state1 publish0) 1)
                          (ge (str_find durable0 "\nphase=publish" 0) 0)))) 256))
            (let model-task (fcprb-task channel 21 "research" "not-run"))
            (let state2 (fcpct-with state1
                (fcprb-with-pending (fcpct-transport state1) model-task)
                (fcpct-session state1) (fcpct-staged state1)
                (fcpct-completed state1) (fcpct-contributions state1)))
            (let moved1 (fcpct-turn state2 2 8))
            (let state3 (fcpct-result-state moved1))
            (let durable1 (read_file egress))
            (let c9 (fcprb-bit (and
                (eq (fcpct-completed state3) 2)
                (and (eq (fcpct-contributions state3) 0)
                     (and (eq (fcpct-task-durable? state3 model-task) 1)
                          (and (ge (str_find durable1 "\nphase=select" 0) 0)
                               (ge (str_find durable1 "\nsignal=choice" 0) 0))))) 512))

            ; A successor keeps caller-born effect authority while a new
            ; policy epoch arrives. The policy returns source-symbol (4); the
            ; source context and non-fcms sentinel remain exactly held across
            ; publish, selection, durable append, and seen promotion. This is
            ; the process-image path a newly born resident takes, without
            ; opening a model or making the policy image choose source bytes.
            (let source-egress (str_concat (temp_dir)
                "/form-policy-route-source-symbol.reply"))
            (fs_remove source-egress)
            (let source-context (fcpct-source-context-with-index
                "/caller-root" "artifact" 0 768
                (sof-snapshot 1 (list "form")
                    (list (list "fcpct-task-key"
                        "form/form-stdlib/form-cli-peer-contribution-turnwheel.fk")))))
            (let successor-session (list "successor-non-model-session" 29))
            (let source-publish (fcprb-task channel 22 "publish"
                (fcprb-image "arriving/policy/source-symbol" 0 "1,4")))
            (let source-task (fcprb-task channel 23 "source-symbol"
                "fcpct-task-key"))
            (let successor0 (fcpct-new-with-source
                (fcprb-with-pending (fcprb-transport channel source-egress)
                    source-publish)
                successor-session source-context))
            (let successor1 (fcpct-result-state
                (fcpct-turn successor0 3 8)))
            (let successor2 (fcpct-with successor1
                (fcprb-with-pending (fcpct-transport successor1) source-task)
                (fcpct-session successor1) (fcpct-staged successor1)
                (fcpct-completed successor1) (fcpct-contributions successor1)))
            (let successor3 (fcpct-result-state
                (fcpct-turn successor2 4 8)))
            (let successor-durable (read_file source-egress))
            (let successor-host (fcprb-host-of (fcpct-transport successor3)))
            (let successor-route (le-recipes
                (le-tbl (fcrt-lw successor-host))
                (le-cur (fcrt-lw successor-host))))
            (let c13 (fcprb-bit (and
                (and (eq (fcpct-completed successor3) 2)
                (and (eq (fcpct-contributions successor3) 0)
                (and (value_eq (fcpct-session successor3) successor-session)
                     (value_eq (fcpct-source-context successor3)
                         source-context))))
                (and (not (node_eq (fcrt-route-identity successor-route)
                                   (fcrt-route-identity (fcpr-default-route 1))))
                (and (ge (str_find successor-durable "\nphase=publish" 0) 0)
                (and (ge (str_find successor-durable "\naction=source-symbol" 0) 0)
                (and (ge (str_find successor-durable "\nroute=source-symbol" 0) 0)
                (and (ge (str_find successor-durable "\ncallback-calls=0" 0) 0)
                (and (ge (str_find successor-durable "\nlookup-count=1" 0) 0)
                     (eq (str_find successor-durable "q38-forward" 0) -1))))))))
                8192))
            (fs_remove source-egress)
            (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13))))

    (form-cli-peer-policy-route-band))
