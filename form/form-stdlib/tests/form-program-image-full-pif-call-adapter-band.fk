; form-program-image-full-pif-call-adapter-band.fk -- one real full-PIF
; symbol walk through content-addressed CALL_BINDING / OFFER / ACK data.
; Expected: 262143
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-program-image-full-pif-call-adapter.fk

(do
    (defn fpcpfb-bit (held weight) (if held weight 0))
    (defn fpcpfb-all? (values)
        (if (nil? values) 1
            (if (head values) (fpcpfb-all? (tail values)) 0)))
    (defn fpcpfb-key-echo () "adapter/echo")
    (defn fpcpfb-key-nothing () "adapter/nothing")
    (defn fpcpfb-key-zero () "adapter/zero")
    (defn fpcpfb-key-one () "adapter/one")
    (defn fpcpfb-key-failure () "adapter/failure")
    (defn fpcpfb-nodes ()
        (list
            (pif-node-row 2 0 0 0)
            (pif-node-row 137 0 0 0)
            (pif-node-row 1 0 0 0)
            (pif-node-row 1 1 0 0)
            (pif-node-row 99 0 0 0)))
    (defn fpcpfb-symbols ()
        (pif-symbol-image 5
            (list
                (pif-symbol-row 0 (fpcpfb-key-echo))
                (pif-symbol-row 1 (fpcpfb-key-nothing))
                (pif-symbol-row 2 (fpcpfb-key-zero))
                (pif-symbol-row 3 (fpcpfb-key-one))
                (pif-symbol-row 4 (fpcpfb-key-failure)))
            5
            (list
                (pif-node-symbol-row 0 0 (empty))
                (pif-node-symbol-row 1 1 (empty))
                (pif-node-symbol-row 2 2 (empty))
                (pif-node-symbol-row 3 3 (empty))
                (pif-node-symbol-row 4 4 (empty)))))
    (defn fpcpfb-pif ()
        (pif-envelope-with-symbols
            "form/form-stdlib/tests/full-pif-call-adapter-synthetic.fk"
            "sha:full-pif-call-adapter-source" 1
            "resident:full-pif-call-adapter"
            "sha:full-pif-call-adapter-content" 1 1
            (pif-table-image 5 (list 0 1 2 3 4) 5
                (fpcpfb-nodes) 0 (empty))
            (fpcpfb-symbols)))
    (defn fpcpfb-envelope ()
        (do
            (let pif (fpcpfb-pif))
            (let source (pif-source-from-envelope pif))
            (let fkb (pif-descriptor-from-envelope pif))
            (rale-envelope-from-selection source fkb (sad-no-artifact)
                (ras-selection-from-plan
                    (rap-plan-from-descriptors
                        source fkb (sad-no-artifact))))))
    (defn fpcpfb-admission ()
        (do
            (let pif (fpcpfb-pif))
            (let payload (pifbd-payload
                (pif-envelope-source-path pif)
                (pif-envelope-source-hash pif)
                (pif-envelope-source-mtime pif)
                (pif-envelope-artifact-path pif)
                (pif-envelope-seal-ok pif)
                (pif-envelope-table pif)
                (pif-envelope-symbol-image pif)))
            (pifbd-admission
                (list "full-pif-call-adapter-synthetic-admission")
                (pifbd-decoded-row payload 1)
                pif (pifbd-status-admitted) (pifbd-reason-admitted))))
    (defn fpcpfb-binding (symbol)
        (fpcpf-binding symbol (fpcpf-pirc-envelope (fpcpfb-pif))))
    (defn fpcpfb-request (symbol)
        (pise-request-by-canonical-key symbol))
    (defn fpcpfb-receiver (binding symbol)
        (fpcpf-receiver binding (fpcpfb-envelope) (fpcpfb-admission)
            (fpcpfb-request symbol)))
    (defn fpcpfb-status? (receipt status)
        (if (fpcpf-receipt? receipt)
            (str_eq (fpcp-ack-status (fpcpf-receipt-ack receipt)) status)
            0))

    (defn form-program-image-full-pif-call-adapter-band ()
        (do
            (let recipe (fpcpf-pirc-envelope (fpcpfb-pif)))
            (let caller (fpcpf-binding "adapter/caller" recipe))
            (let echo (fpcpfb-binding (fpcpfb-key-echo)))
            (let nothing-binding (fpcpfb-binding (fpcpfb-key-nothing)))
            (let zero-binding (fpcpfb-binding (fpcpfb-key-zero)))
            (let one-binding (fpcpfb-binding (fpcpfb-key-one)))
            (let failure-binding (fpcpfb-binding (fpcpfb-key-failure)))
            (let capability (intern_trivial_string "capability/full-pif-call"))
            (let correlation (intern_trivial_string "correlation/full-pif-call"))
            (let echo-call (fpcpf-call-binding caller "invoke" echo capability))
            (let nothing-call (fpcpf-call-binding caller "invoke" nothing-binding capability))
            (let zero-call (fpcpf-call-binding caller "invoke" zero-binding capability))
            (let one-call (fpcpf-call-binding caller "invoke" one-binding capability))
            (let failure-call (fpcpf-call-binding caller "invoke" failure-binding capability))
            (let bindings (list caller echo nothing-binding zero-binding
                                one-binding failure-binding))
            (let calls (list echo-call nothing-call zero-call one-call failure-call))
            (let protocol (fpcpf-registry bindings (list capability) calls))
            (let echo-receiver (fpcpfb-receiver echo (fpcpfb-key-echo)))
            (let nothing-receiver
                (fpcpfb-receiver nothing-binding (fpcpfb-key-nothing)))
            (let zero-receiver
                (fpcpfb-receiver zero-binding (fpcpfb-key-zero)))
            (let one-receiver
                (fpcpfb-receiver one-binding (fpcpfb-key-one)))
            (let failure-receiver
                (fpcpfb-receiver failure-binding (fpcpfb-key-failure)))

            (let zero-arg (fpcpf-value (rpmw-kind-int) 0))
            (let one-arg (fpcpf-value (rpmw-kind-int) 1))
            (let echo-offer (fpcpf-offer echo-call correlation
                (list zero-arg) 1))
            (let echo-result (fpcpf-execute protocol echo-offer echo-receiver))
            (let echo-ack (fpcpf-receipt-ack echo-result))
            (let echo-value (fpcp-ack-value echo-ack))

            (let one-offer (fpcpf-offer one-call correlation
                (list zero-arg) 1))
            (let one-result (fpcpf-execute protocol one-offer one-receiver))
            (let one-value (fpcp-ack-value (fpcpf-receipt-ack one-result)))

            (let nothing-offer (fpcpf-offer nothing-call correlation
                (list one-arg) 1))
            (let nothing-result
                (fpcpf-execute protocol nothing-offer nothing-receiver))
            (let nothing-ack (fpcpf-receipt-ack nothing-result))
            (let nothing-value (fpcp-ack-value nothing-ack))

            (let list-kind (rpmw-kind-list
                (list (rpmw-kind-nothing) (rpmw-kind-int)
                      (rpmw-kind-int) (rpmw-kind-string))))
            (let list-arg (fpcpf-value list-kind (list (nothing) 0 1 "")))
            (let list-offer (fpcpf-offer echo-call correlation
                (list list-arg) 1))
            (let list-result (fpcpf-execute protocol list-offer echo-receiver))
            (let list-value
                (fpcp-ack-value (fpcpf-receipt-ack list-result)))

            (let string-arg (fpcpf-value (rpmw-kind-string) "typed-string"))
            (let string-offer (fpcpf-offer echo-call correlation
                (list string-arg) 1))
            (let string-result
                (fpcpf-execute protocol string-offer echo-receiver))
            (let string-value
                (fpcp-ack-value (fpcpf-receipt-ack string-result)))
            (let native-node (intern_node (make_nodeid 31 2 0 129)
                (list (intern_trivial_string "native")
                      (intern_trivial_int 7))))
            (let native-kind (rpmw-kind-composite-node
                (list (rpmw-kind-trivial-string-node)
                      (rpmw-kind-trivial-int-node))))
            (let native-arg (fpcpf-value native-kind native-node))
            (let native-offer (fpcpf-offer echo-call correlation
                (list native-arg) 1))
            (let native-result
                (fpcpf-execute protocol native-offer echo-receiver))
            (let native-value
                (fpcp-ack-value (fpcpf-receipt-ack native-result)))
            (let nodeid-arg (fpcpf-value (rpmw-kind-nodeid)
                (make_nodeid 9 0 0 7)))
            (let trivial-int-arg (fpcpf-value
                (rpmw-kind-trivial-int-node) (intern_trivial_int 7)))
            (let trivial-string-arg (fpcpf-value
                (rpmw-kind-trivial-string-node)
                (intern_trivial_string "seven")))

            (let timeout-offer (fpcpf-offer echo-call correlation
                (list zero-arg) 0))
            (let timeout-result
                (fpcpf-execute protocol timeout-offer echo-receiver))
            (let failure-offer (fpcpf-offer failure-call correlation
                (list zero-arg) 1))
            (let failure-result
                (fpcpf-execute protocol failure-offer failure-receiver))

            (let denied (fpcpf-registry bindings (empty) calls))
            (let denied-result
                (fpcpf-execute denied echo-offer echo-receiver))
            (let unknown-call (fpcpf-call-binding caller "other" echo capability))
            (let unknown-offer (fpcpf-offer unknown-call correlation
                (list zero-arg) 1))
            (let unknown-result
                (fpcpf-execute protocol unknown-offer echo-receiver))

            ; Same symbol, different actual content is choice before execution.
            (let other-recipe (intern_trivial_string "other-program-recipe"))
            (let echo-other (fpcpf-binding (fpcpfb-key-echo) other-recipe))
            (let choice-protocol (fpcpf-registry
                (cons echo-other bindings) (list capability) calls))
            (let choice-result
                (fpcpf-execute choice-protocol echo-offer echo-receiver))

            ; Receiver and request swaps cannot borrow a valid grant/call.
            (let swapped-result
                (fpcpf-execute protocol echo-offer one-receiver))
            (let swapped-request (fpcpf-receiver echo
                (fpcpfb-envelope) (fpcpfb-admission)
                (fpcpfb-request (fpcpfb-key-one))))
            (let request-swap-result
                (fpcpf-execute protocol echo-offer swapped-request))

            ; A noncanonical kind node is still an ordinary fpcp value, but
            ; the adapter ABI refuses it before the full walker is invoked.
            (let forged-kind-node (fcatw-sequence (fpcpf-kind-role)
                (list (intern_trivial_string "int")
                      (fpcpf-kind-node (rpmw-kind-int)))))
            (let forged-value (fpcp-value (fcatw-kind-list)
                (list (fpcp-value (fcatw-kind-node) forged-kind-node)
                      (fpcp-value (fcatw-kind-int) 0))))
            (let forged-offer (fpcpf-offer echo-call correlation
                (list forged-value) 1))
            (let forged-result
                (fpcpf-execute protocol forged-offer echo-receiver))

            ; Structurally plausible but wrong returned value cannot cross the
            ; deterministic observation door.
            (let forged-ack (fpcp-ack echo-offer "returned"
                "resident-thought-returned" one-arg 1 1
                "offer,resolve,call,return,ack,release"))
            (let forged-receipt (fpcpf-receipt protocol echo-offer
                forged-ack (fpcpf-receipt-symbol-walk echo-result)))

            (add
                (fpcpfb-bit (and (fpcpfb-status? echo-result "returned")
                    (and (rpmw-kind-equal? (fpcpf-value-kind echo-value)
                                           (rpmw-kind-int))
                         (eq (fpcpf-value-raw echo-value) 0))) 1)
            (add
                (fpcpfb-bit (and (fpcpfb-status? one-result "returned")
                    (eq (fpcpf-value-raw one-value) 1)) 2)
            (add
                (fpcpfb-bit (and (fpcpfb-status? nothing-result "returned")
                    (and (eq (fpcp-ack-output nothing-ack) 1)
                    (and (rpmw-kind-equal?
                            (fpcpf-value-kind nothing-value)
                            (rpmw-kind-nothing))
                         (nothing? (fpcpf-value-raw nothing-value))))) 4)
            (add
                (fpcpfb-bit (and (fpcpfb-status? list-result "returned")
                    (and (rpmw-kind-equal?
                            (fpcpf-value-kind list-value) list-kind)
                         (fpcpf-raw-value-equal? list-kind
                            (fpcpf-value-raw list-value)
                            (list (nothing) 0 1 "")))) 8)
            (add
                (fpcpfb-bit (and (fpcpfb-status? timeout-result "timeout")
                    (and (eq (fpcp-ack-output
                            (fpcpf-receipt-ack timeout-result)) 0)
                         (fpcpf-ack-valid?
                            (fpcpf-receipt-ack timeout-result)))) 16)
            (add
                (fpcpfb-bit (and (fpcpfb-status? failure-result "failure")
                    (and (eq (fpcp-ack-output
                            (fpcpf-receipt-ack failure-result)) 0)
                         (fpcpf-ack-valid?
                            (fpcpf-receipt-ack failure-result)))) 32)
            (add
                (fpcpfb-bit (and (fpcpfb-status? denied-result "refused")
                    (fpcpf-ack-valid?
                        (fpcpf-receipt-ack denied-result))) 64)
            (add
                (fpcpfb-bit (and (fpcpfb-status? unknown-result "nothing")
                    (fpcpf-ack-valid?
                        (fpcpf-receipt-ack unknown-result))) 128)
            (add
                (fpcpfb-bit (and (fpcpfb-status? choice-result "choice")
                    (fpcpf-ack-valid?
                        (fpcpf-receipt-ack choice-result))) 256)
            (add
                (fpcpfb-bit (and (fpcpfb-status? swapped-result "failure")
                    (fpcpf-ack-valid?
                        (fpcpf-receipt-ack swapped-result))) 512)
            (add
                (fpcpfb-bit (and
                    (fpcpfb-status? request-swap-result "failure")
                    (fpcpf-ack-valid?
                        (fpcpf-receipt-ack request-swap-result))) 1024)
            (add
                (fpcpfb-bit (and (fpcpfb-status? forged-result "refused")
                    (fpcpf-no-walk?
                        (fpcpf-receipt-symbol-walk forged-result))) 2048)
            (add
                (fpcpfb-bit (fpcpf-receipt-observed?
                    protocol echo-offer echo-receiver echo-result) 4096)
            (add
                (fpcpfb-bit (not (fpcpf-receipt-observed?
                    protocol echo-offer echo-receiver forged-receipt)) 8192)
            (add
                (fpcpfb-bit (fpcpf-ack-valid? nothing-ack) 16384)
            (add
                (fpcpfb-bit (and (nothing?
                    (fpcpf-execute protocol (nothing) echo-receiver))
                    (node_eq (fpcp-ack-correlation echo-ack) correlation)) 32768)
            (add
                (fpcpfb-bit (and (fpcpf-receiver-valid? echo-receiver)
                    (node_eq (fpcpf-binding-recipe echo) recipe)) 65536)
                (fpcpfb-bit (fpcpfb-all? (list
                    (fpcpf-registry-valid? protocol)
                    (fpcpf-offer-valid? list-offer)
                    (fpcpf-ack-valid? (fpcpf-receipt-ack list-result))
                    (fpcpfb-status? string-result "returned")
                    (str_eq (fpcpf-value-raw string-value) "typed-string")
                    (fpcpfb-status? native-result "returned")
                    (rpmw-kind-equal?
                        (fpcpf-value-kind native-value) native-kind)
                    (node_eq (fpcpf-value-raw native-value) native-node)
                    (fpcpf-value-valid? nodeid-arg)
                    (fpcpf-value-valid? trivial-int-arg)
                    (fpcpf-value-valid? trivial-string-arg)))
                    131072))))))))))))))))))))

    (form-program-image-full-pif-call-adapter-band))
