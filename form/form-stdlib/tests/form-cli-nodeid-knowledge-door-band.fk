; form-cli-nodeid-knowledge-door-band.fk — pure witness for the form-cli
; scannerless NodeID/current-source door. No registry or source file is opened.
;
; Verdict 131071 (17 bits): concept/NodeID envelopes, empty refusal, typed result
; rendering, strict one-bucket admission, present 0/1 signals, and no
; model-executed claim all remain exact.
;
; preludes: form-stdlib/form-cli-nodeid-knowledge-door.fk

(do
    (defn fcnkdb-bit (ok bit) (if ok bit 0))
    (defn fcnkdb-result ()
        (list "hit" "one-route-bucket" (fknq-absent) (fknq-absent)
              (fknq-absent) (fknq-absent) (fknq-absent) (fknq-absent)
              (fknq-absent) (fknq-absent)
              "form/form-stdlib/core.fk" "bounded answer" (fknq-trace-for "hit")
              1 0 1 1 1 1 0 0 1))

    (defn form-cli-nodeid-knowledge-door-band ()
        (do
            (let concept (fcnkd-surface "defn-psci-schema"))
            (let nodeid (fcnkd-surface "@31.2.0.96"))
            (let rendered (fcnkd-render (fcnkdb-result)))
            (let concept-request (fknq-scan-request
                (fknq-bmf-consume-default concept)))
            (let nodeid-request (fknq-scan-request
                (fknq-bmf-consume-default nodeid)))
            (sum (list
                (fcnkdb-bit (str_eq concept
                    "<|form:nodeid-knowledge-query|>concept=defn-psci-schema<|/form:nodeid-knowledge-query|>") 1)
                (fcnkdb-bit (str_eq nodeid
                    "<|form:nodeid-knowledge-query|>nodeid=@31.2.0.96<|/form:nodeid-knowledge-query|>") 2)
                (fcnkdb-bit (and
                    (eq (fcnkd-input-valid? "") 0)
                    (str_eq (fcnkd-surface "") "")) 4)
                (fcnkdb-bit (str_eq (fcnkd-query "")
                    "usage: nodeid-knowledge <concept-key|@p.l.t.i>") 8)
                (fcnkdb-bit (ge (str_find rendered "status=hit" 0) 0) 16)
                (fcnkdb-bit (ge (str_find rendered "reason=one-route-bucket" 0) 0) 32)
                (fcnkdb-bit (and
                    (ge (str_find rendered "source=@" 0) 0)
                    (ge (str_find rendered "entry=@" 0) 0)) 64)
                (fcnkdb-bit (ge (str_find rendered
                    "path=form/form-stdlib/core.fk" 0) 0) 128)
                (fcnkdb-bit (ge (str_find rendered "answer=bounded answer" 0) 0) 256)
                (fcnkdb-bit (ge (str_find rendered "lookup-count=1" 0) 0) 512)
                (fcnkdb-bit (ge (str_find rendered "scannerless=1" 0) 0) 1024)
                (fcnkdb-bit (ge (str_find rendered "model-executed=0" 0) 0) 2048)
                (fcnkdb-bit (ge (str_find rendered
                    "route-mode=strict-one-bucket" 0) 0) 4096)
                (fcnkdb-bit (str_eq (fknqr-strict-lane concept-request 0)
                    (fknqr-strict-absent-route-refusal-lane)) 8192)
                (fcnkdb-bit (str_eq (fknqr-strict-lane nodeid-request 1)
                    (fknqr-strict-nodeid-refusal-lane)) 16384)
                (fcnkdb-bit (ge (str_find
                    (fcnkd-stage "surface" "defn-psci-schema")
                    "stage=surface" 0) 0) 32768)
                (fcnkdb-bit (and
                    (ge (str_find (fcnkd-stage "scan" "defn-psci-schema")
                        "status=ready" 0) 0)
                    (ge (str_find (fcnkd-stage "scan" "defn-psci-schema")
                        "scannerless=1" 0) 0)) 65536)))))

    (form-cli-nodeid-knowledge-door-band))
