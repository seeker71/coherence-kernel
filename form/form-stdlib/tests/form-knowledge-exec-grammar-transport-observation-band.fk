; form-knowledge-exec-grammar-transport-observation-band.fk -- exact retained
; grammar-assisted generations remain syntax-refused and earn no semantics.
;
; Verdict 8191 (13 bits).
;
; preludes: form-stdlib/form-knowledge-exec-grammar-transport.fk
; preludes: form-stdlib/form-knowledge-exec-grammar-transport-observation.fk

(do
    (defn fkegtob-bit (ok bit) (if ok bit 0))
    (defn fkegtob-run ()
        (do
            (let rows (fkegto-observations))
            (let e1 (nth rows 0))
            (let f1 (nth rows 1))
            (let g1 (nth rows 2))
            (let e2 (nth rows 3))
            (sum (list
                (fkegtob-bit (eq (len rows) 4) 1)
                (fkegtob-bit (str_eq (nmfe-sha256 (fkegto-e1-raw))
                    (fkegto-response-sha e1)) 2)
                (fkegtob-bit (str_eq (nmfe-sha256 (fkegto-f1-raw))
                    (fkegto-response-sha f1)) 4)
                (fkegtob-bit (str_eq (nmfe-sha256 (fkegto-e2-raw))
                    (fkegto-response-sha e2)) 8)
                (fkegtob-bit (eq (fkegt-parse-signal
                    (fkegto-e1-raw) (fkegt-max-bytes)) 0) 16)
                (fkegtob-bit (eq (fkegt-parse-signal
                    (fkegto-f1-raw) (fkegt-max-bytes)) 0) 32)
                (fkegtob-bit (eq (fkegt-parse-signal
                    (fkegto-e2-raw) (fkegt-max-bytes)) 0) 64)
                (fkegtob-bit (and (str_eq (fkegto-parse-reason e1) "present-invalid")
                    (and (str_eq (fkegto-parse-reason f1) "present-invalid")
                         (str_eq (fkegto-parse-reason e2) "present-invalid"))) 128)
                (fkegtob-bit (and (nothing? (fkegt-form-body
                    (fkegto-f1-raw) (fkegt-max-bytes)))
                    (nothing? (fkegt-form-source
                        (fkegto-e2-raw) (fkegt-max-bytes)))) 256)
                (fkegtob-bit (and (str_eq (fkegto-response-sha f1)
                                          (fkegto-response-sha g1))
                    (not (str_eq (nth f1 5) (nth g1 5)))) 512)
                (fkegtob-bit (not (str_eq (fkegto-response-sha e1)
                                          (fkegto-response-sha f1))) 1024)
                (fkegtob-bit (fkegto-all-released-local? rows) 2048)
                (fkegtob-bit (and (eq (fkegto-card-version e2) 2)
                    (and (eq (fkegto-parse-signal e2) 0)
                    (and (eq (fkegto-lowered? e2) 0)
                    (and (eq (fkegto-harness-ran? e2) 0)
                    (and (eq (fkegto-semantic e2) 0)
                    (and (eq (fkegto-supervised? e2) 1)
                         (eq (fkegto-heldout-credit? e2) 0))))))) 4096)))))
    (fkegtob-run))
