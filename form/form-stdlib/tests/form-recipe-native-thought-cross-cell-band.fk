; form-recipe-native-thought-cross-cell-band.fk — pure/edge and native-file
; witness for the BMF-cursor -> typed live observation -> distinct receiver
; composition. No model, Metal pipeline, recipe execution, or native code runs.
;
; Verdict 1048575 (20 bits):
;   1        BMF manifest says scannerless/raw cursor/no token stream
;   2        exact recipe surface is consumed byte-for-byte with pretokenized=0
;   4        request NodeID addresses exactly the one recipe NodeID
;   8        ready cursor records choice/cut/release
;   16       malformed surface records failure/undo/refine/cut/release
;   32       budget exhaustion records timeout/cut/undo/refine/release
;   64       generated source/code NodeID retains request recipe identity
;   128      typed execution observation crosses the serialized channel
;   256      meaning/vitality remain distinct and retain every source identity
;   512      rich ack retains request/recipe/code/execution/observation/channel
;   1024     present 0 remains status=value,present=1,value=0
;   2048     present 1 remains status=value,present=1,value=1
;   4096     nothing remains status=nothing,present=0
;   8192     failure lifecycle remains received and attributed
;   16384    timeout lifecycle remains received and attributed
;   32768    physical flags remain source=1,native=0,recipe=0,model=0,release=0
;   65536    actual file delivery is once and mesh remains unclaimed
;   131072   persistence reloads the same received NodeID
;   262144   last-error is explicit pure-boundary data, never inferred
;   524288   framebuffer stage NodeID retains the observed live/cross state
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/form-recipe-native-thought-cross-cell.fk

(do
    (defn frntband-bit (condition bit) (if condition bit 0))
    (defn frntband-all-frnt? (trace actions)
        (if (eq (len actions) 0) 1
            (if (eq (frnt-trace-has? trace (head actions)) 1)
                (frntband-all-frnt? trace (tail actions)) 0)))
    (defn frntband-all-frex? (trace actions)
        (if (eq (len actions) 0) 1
            (if (eq (frex-trace-has? trace (head actions)) 1)
                (frntband-all-frex? trace (tail actions)) 0)))

    ; This composes MSL source and its content-addressed code/execution/
    ; observation data but supplies all physical flags as zero.
    (defn frntband-live (scan status value reason)
        (do
            (let request (frnt-scan-request-row scan))
            (let code (frexl-code-node (frex-request-recipe request)))
            (frexl-result-from-offer request
                (frex-offer "metal" status value reason)
                code (frnt-scan-bytes scan) 1 0 0 0 0 0 0 0 0)))
    (defn frntband-cross (scan status value reason suffix persist)
        (do
            (let live (frntband-live scan status value reason))
            (frnt-cross-live-result scan live
                (str_concat (temp_dir)
                    (str_concat "/frnt-band-" (str_concat suffix ".channel")))
                (str_concat (temp_dir)
                    (str_concat "/frnt-band-" (str_concat suffix ".persist")))
                persist "pure-no-metal-call")))

    (defn form-recipe-native-thought-cross-cell-band ()
        (do
            (let surface (frex-surface (frex-recipe) 5 "metal"))
            (let scan (frnt-bmf-consume-default surface))
            (let malformed (frnt-bmf-consume-default
                (str_concat surface "trailing")))
            (let timed (frnt-bmf-consume surface 3))

            (let zero-result
                (frntband-cross scan "value" 0 "edge-zero" "zero" 1))
            (let one-result
                (frntband-cross scan "value" 1 "edge-one" "one" 0))
            (let nothing-result
                (frntband-cross scan "nothing" 0 "edge-nothing" "nothing" 0))
            (let failure-result
                (frntband-cross scan "failure" 0 "edge-failure" "failure" 0))
            (let timeout-result
                (frntband-cross scan "timeout" 0 "edge-timeout" "timeout" 0))

            (let zero-live (frnt-result-live zero-result))
            (let zero-rich (frnt-result-ack zero-result))
            (let zero-cross (frnt-result-crossing zero-result))
            (let zero-froc (froc-cross-ack zero-cross))
            (let meaning (frnt-ack-meaning zero-rich))
            (let vitality (frnt-ack-vitality zero-rich))
            (let one-rich (frnt-result-ack one-result))
            (let nothing-rich (frnt-result-ack nothing-result))
            (let failure-rich (frnt-result-ack failure-result))
            (let timeout-rich (frnt-result-ack timeout-result))
            (let stage (frnt-stage 4 "receiver-lenses-observed" zero-rich
                scan zero-live zero-froc))

            (sum (list
                (frntband-bit (and
                    (eq (bmf-manifest-has? "scannerless"
                            (bmf-cursor-language-manifest)) 1)
                    (and (eq (bmf-manifest-has? "streaming-cursor"
                            (bmf-cursor-language-manifest)) 1)
                    (and (eq (bmf-manifest-has? "no-token-stream"
                            (bmf-cursor-language-manifest)) 1)
                         (eq (bmf-manifest-has? "immutable-cursor"
                            (bmf-cursor-language-manifest)) 1)))) 1)
                (frntband-bit (and
                    (str_eq (frnt-scan-status scan) "ready")
                    (and (str_eq (frnt-scan-consumed scan) surface)
                    (and (eq (frnt-scan-bytes scan) (str_len surface))
                    (and (eq (frnt-scan-position scan) (str_len surface))
                         (eq (frnt-scan-pretokenized? scan) 0))))) 2)
                (frntband-bit (and
                    (eq (frnt-addressed-request? scan) 1)
                    (and (node_eq (frnt-scan-recipe scan) (frex-recipe))
                         (node_eq (nth (node_children
                                        (frnt-scan-request scan)) 0)
                                  (frex-recipe)))) 4)
                (frntband-bit (eq (frntband-all-frnt?
                    (frnt-scan-trace scan)
                    (list "choice" "cut" "release")) 1) 8)
                (frntband-bit (and
                    (str_eq (frnt-scan-status malformed) "failure")
                    (eq (frntband-all-frnt? (frnt-scan-trace malformed)
                        (list "choice" "failure" "undo" "refine"
                              "cut" "release")) 1)) 16)
                (frntband-bit (and
                    (str_eq (frnt-scan-status timed) "timeout")
                    (eq (frntband-all-frnt? (frnt-scan-trace timed)
                        (list "choice" "timeout" "cut" "undo" "refine"
                              "release")) 1)) 32)
                (frntband-bit (and
                    (node_eq (frnt-ack-request zero-rich)
                             (frnt-scan-request scan))
                    (and (node_eq (frnt-ack-recipe zero-rich)
                                  (frnt-scan-recipe scan))
                    (and (node_eq (nth (node_children
                                        (frnt-ack-code zero-rich)) 0)
                                  (frnt-ack-recipe zero-rich))
                         (eq (frnt-ack-source-generated? zero-rich) 1)))) 64)
                (frntband-bit (and
                    (node_eq (frnt-ack-observation zero-rich)
                             (frexl-result-observation zero-live))
                    (and (node_eq (froc-ack-observation zero-froc)
                                  (frexl-result-observation zero-live))
                    (and (eq (froc-ack-transported? zero-froc) 1)
                         (str_eq (froc-ack-delivery-status zero-froc)
                                 "delivered")))) 128)
                (frntband-bit (and
                    (not (node_eq meaning vitality))
                    (and (str_eq (frnt-lens-name meaning) "meaning")
                    (and (str_eq (frnt-lens-name vitality) "vitality")
                    (and (eq (frnt-lens-retains? meaning scan zero-live
                                    zero-froc) 1)
                         (eq (frnt-lens-retains? vitality scan zero-live
                                    zero-froc) 1))))) 256)
                (frntband-bit (eq (frnt-ack-retains? zero-rich zero-live) 1) 512)
                (frntband-bit (and
                    (str_eq (frnt-ack-status zero-rich) "value")
                    (and (eq (frnt-ack-value-present? zero-rich) 1)
                         (eq (frnt-ack-value zero-rich) 0))) 1024)
                (frntband-bit (and
                    (str_eq (frnt-ack-status one-rich) "value")
                    (and (eq (frnt-ack-value-present? one-rich) 1)
                         (eq (frnt-ack-value one-rich) 1))) 2048)
                (frntband-bit (and
                    (str_eq (frnt-ack-status nothing-rich) "nothing")
                    (and (eq (frnt-ack-value-present? nothing-rich) 0)
                         (not (node_eq (frnt-ack-observation nothing-rich)
                                      (frnt-ack-observation zero-rich))))) 4096)
                (frntband-bit (and
                    (str_eq (frnt-ack-status failure-rich) "failure")
                    (and (eq (frntband-all-frex?
                        (frexl-result-lifecycle
                            (frnt-result-live failure-result))
                        (list "failure" "undo" "refine" "release")) 1)
                         (eq (frnt-ack-retains? failure-rich
                            (frnt-result-live failure-result)) 1))) 8192)
                (frntband-bit (and
                    (str_eq (frnt-ack-status timeout-rich) "timeout")
                    (and (eq (frntband-all-frex?
                        (frexl-result-lifecycle
                            (frnt-result-live timeout-result))
                        (list "timeout" "cut" "undo" "refine" "release")) 1)
                         (eq (frnt-ack-retains? timeout-rich
                            (frnt-result-live timeout-result)) 1))) 16384)
                (frntband-bit (and
                    (eq (frnt-ack-source-generated? zero-rich) 1)
                    (and (eq (frnt-ack-native-generated? zero-rich) 0)
                    (and (eq (frnt-ack-recipe-executed? zero-rich) 0)
                    (and (eq (frnt-ack-model-executed? zero-rich) 0)
                         (eq (frnt-ack-buffer-released? zero-rich) 0))))) 32768)
                (frntband-bit (and
                    (eq (froc-emit-count (froc-cross-emit zero-cross)) 1)
                    (and (eq (froc-ack-transported? zero-froc) 1)
                         (eq (froc-ack-mesh-transported? zero-froc) 0))) 65536)
                (frntband-bit (do
                    (let p (froc-ack-persistence zero-froc))
                    (if (and (str_eq (froc-persistence-status p) "reloaded")
                        (and (eq (froc-persistence-reloaded? p) 1)
                             (node_eq (froc-persistence-received p)
                                      (froc-ack-received zero-froc)))) 1 0)) 131072)
                (frntband-bit
                    (str_eq (frnt-ack-last-error zero-rich)
                            "pure-no-metal-call") 262144)
                (frntband-bit (and
                    (node_eq (node_category stage) (frnt-stage-category))
                    (and (eq (frnt-stage-index stage) 4)
                    (and (str_eq (frnt-stage-name stage)
                                 "receiver-lenses-observed")
                         (node_eq (nth (node_children stage) 4)
                                  (frexl-result-observation zero-live))))) 524288)))))

    (form-recipe-native-thought-cross-cell-band))
