; integer-power-band.fk -- BML exact integer power preserves zero/nothing
; and reduces even exponents by halving rather than one linear recurrence.
; Expected: 127
; preludes: form-stdlib/bml/integer-power.bml

(do
    (defn fipb-bit (ok bit) (if ok bit 0))
    (sum (list
        (fipb-bit (and (eq (fip-pow 2 0) 1) (eq (fip-pow 0 0) 1)) 1)
        (fipb-bit (and (eq (fip-pow 2 1) 2) (eq (fip-pow 2 8) 256)) 2)
        (fipb-bit (and (eq (fip-pow 3 5) 243) (eq (fip-pow 5 4) 625)) 4)
        (fipb-bit (and (eq (fip-supported? 0) 1) (eq (fip-supported? (sub 0 1)) 0)) 8)
        (fipb-bit (nothing? (fip-pow 2 (sub 0 1))) 16)
        (fipb-bit (and (eq (fip-depth 0) 0) (eq (fip-depth 1024) 11)) 32)
        (fipb-bit (and (not (nothing? (fip-pow 2 8))) (nothing? (fip-depth (sub 0 1)))) 64))))
