; prompt-ab-band.fk — a prompt arm earns a point only when the reply carries the word.
; witnessed: 2026-10-02 -> 255
;   1 an exact word scores higher than a mention
;   2 a miss scores nothing
;   4 the higher score wins, and a tie keeps the shorter reply
;   8 the role arm wears that model's prompt
;   16 an unknown model keeps the task bare
;   32 the answer prompts carry the three missed facts, and the open task does not give the word
;   64 the failure word is miss, and one plus two is written 1+2
;  128 the full answer model gives the word or the number the question asks for
; preludes: form/form-stdlib/prompt-ab.bml
(do
    (defn pabb-bit (ok bit) (if ok bit 0))
    (let exact (pab-points "Paris." "paris"))
    (let mention (pab-points "the capital is paris today" "paris"))
    (let miss (pab-points "london" "paris"))
    (let best (pab-best (list (pab-row "bare" 4 40) (pab-row "role" 4 12) (pab-row "tight" 3 8))))
    (let place (head (pab-open-tasks)))
    (sum (list
        (pabb-bit (and (eq exact 2) (eq mention 1)) 1)
        (pabb-bit (eq miss 0) 2)
        (pabb-bit (str_eq (head best) "role") 4)
        (pabb-bit (eq (str_find (pab-arm-text "qwen38-q8" "role" "TASK") "Answer the question in front of you" 0) 0) 8)
        (pabb-bit (str_eq (pab-arm-text "no-such" "role" "TASK") "TASK") 16)
        (pabb-bit (and (ge (str_find (rp-prompt "qwen38-q8") "neither zero nor one" 0) 0)
            (and (ge (str_find (rp-prompt "qwen38-q4") "live token count a position" 0) 0)
            (and (lt (str_find (nth place 1) "paris" 0) 0)
                 (eq (rp-distinct?) 1)))) 32)
        (pabb-bit (and (ge (str_find (rp-prompt "qwen38-q8") "one word for that failure is miss" 0) 0)
            (and (ge (str_find (rp-prompt "qwen38-q4") "written 1+2" 0) 0)
                 (gt (str_find (rp-prompt "qwen38-q8") "When the question is a review" 0) 0))) 64)
        (pabb-bit (eq (str_find (rp-prompt "qwen38-q8") "Give the word or the number it asks for" 0) 37) 128))))
