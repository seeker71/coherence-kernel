; living-world-recipe-tree-revision-prospective-band.fk -- 31 checks for
; fresh K/L three-way placement and honest structural quality stasis.
; target: 2147483647
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/living-world-recipe-tree-revision-trial.fk form-stdlib/living-world-recipe-tree-revision-hypothesis.fk form-stdlib/living-world-recipe-tree-revision-prospective.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk

(defn lwrtrpb-bit (ok bit) (if ok bit 0))

(defn lwrtrpb-run ()
    (do
        (let result (lwrtrpw-run))
        (let children (node_children result))
        (let candidate (nth children 1))
        (let first (nth children 3))
        (let suite (nth children 4))
        (let one-world (nth children 5))
        (let one-comparison (nth children 6))
        (let two-world (nth children 7))
        (let suite-sources (nth children 8))
        (let incumbent (nth children 10))
        (let first-evaluation (nth children 11))
        (let new-evaluation (nth children 12))
        (let incumbent-first (nth children 13))
        (let first-new (nth children 14))
        (let incumbent-new (nth children 15))
        (let revoked-world (nth children 16))
        (let revoked-comparison (nth children 17))
        (let events (nth children 21))
        (let incumbent-metrics (lwps-evaluation-metrics incumbent))
        (let first-metrics (lwps-evaluation-metrics first-evaluation))
        (let new-metrics (lwps-evaluation-metrics new-evaluation))
        (let incumbent-first-delta
            (lwps-delta-values
                (lwps-comparison-delta incumbent-first)))
        (let first-new-delta
            (lwps-delta-values (lwps-comparison-delta first-new)))
        (let field (lwo-emergent-shape candidate))
        (let composition-candidate
            (lwrtrh-field-composition-candidate field))
        (let prior-suite
            (lwrtr-field-suite (lwo-emergent-shape composition-candidate)))
        (let match (head (lwo-field-items (lwrtrh-field-matches field))))
        (let recipe (lwrtrh-match-recipe match))
        (let cases (lwo-field-items (lwrtrpw-cases)))
        (let first-case (head cases))
        (let pending-case (nth cases 3))
        (let condensed-case (nth cases 4))
        (let pending-time (lwps-case-time pending-case))
        (let condensed-time (lwps-case-time condensed-case))
        (sum (list
            (lwrtrpb-bit (eq (lwrtrh-candidate? candidate) 1) 1)
            (lwrtrpb-bit (eq (lwrth-candidate? first) 1) 2)
            (lwrtrpb-bit (eq (lwps-suite-shape-valid? suite) 1) 4)
            (lwrtrpb-bit
                (eq (lwps-split-shape-valid? (lwps-suite-split suite)) 1) 8)
            (lwrtrpb-bit
                (and (eq (lwps-suite-current? one-world suite 2) 0)
                     (node_eq one-comparison (lwo-none))) 16)
            (lwrtrpb-bit (eq (lwo-field-size suite-sources) 2) 32)
            (lwrtrpb-bit (eq (node_value (nth children 9)) 1) 64)
            (lwrtrpb-bit
                (eq (lwo-field-size (lwrtrp-history-bindings candidate)) 8)
                128)
            (lwrtrpb-bit
                (eq (lwo-field-size
                        (lwps-split-prospective (lwps-suite-split suite))) 5)
                256)
            (lwrtrpb-bit (eq (node_value (nth children 19)) 1) 512)
            (lwrtrpb-bit (eq (node_value (nth children 20)) 1) 1024)
            (lwrtrpb-bit
                (and (eq (lwps-evaluation? incumbent) 1)
                     (and (eq (lwps-evaluation? first-evaluation) 1)
                          (eq (lwps-evaluation? new-evaluation) 1))) 2048)
            (lwrtrpb-bit
                (and (node_eq (lwps-evaluation-dataset incumbent)
                            (lwps-evaluation-dataset first-evaluation))
                     (node_eq (lwps-evaluation-dataset first-evaluation)
                            (lwps-evaluation-dataset new-evaluation))) 4096)
            (lwrtrpb-bit
                (and (node_eq (lwps-evaluation-split incumbent)
                            (lwps-evaluation-split first-evaluation))
                     (node_eq (lwps-evaluation-split first-evaluation)
                            (lwps-evaluation-split new-evaluation))) 8192)
            (lwrtrpb-bit
                (and (node_eq (lwps-evaluation-contract incumbent)
                            (lwps-evaluation-contract first-evaluation))
                     (node_eq (lwps-evaluation-contract first-evaluation)
                            (lwps-evaluation-contract new-evaluation))) 16384)
            (lwrtrpb-bit
                (and (eq (lwps-comparison-admissible incumbent-first) 1)
                     (and (eq (lwps-comparison-admissible first-new) 1)
                          (eq (lwps-comparison-admissible incumbent-new) 1)))
                32768)
            (lwrtrpb-bit (eq (lwps-comparison-repeated first-new) 0) 65536)
            (lwrtrpb-bit
                (and (eq (lwps-metrics-value incumbent-metrics 0) 5)
                     (eq (lwps-metrics-value incumbent-metrics 1) 3)) 131072)
            (lwrtrpb-bit
                (and (eq (lwps-metrics-value incumbent-metrics 2) 0)
                     (and (eq (lwps-metrics-value incumbent-metrics 3) 2)
                          (eq (lwps-metrics-value incumbent-metrics 4) 1)))
                262144)
            (lwrtrpb-bit
                (and (eq (lwps-metrics-value first-metrics 0) 5)
                     (eq (lwps-metrics-value first-metrics 1) 3)) 524288)
            (lwrtrpb-bit
                (and (eq (lwps-metrics-value first-metrics 2) 2)
                     (and (eq (lwps-metrics-value first-metrics 3) 0)
                          (eq (lwps-metrics-value first-metrics 4) 1)))
                1048576)
            (lwrtrpb-bit
                (and (eq (lwps-metrics-value new-metrics 0) 5)
                     (eq (lwps-metrics-value new-metrics 1) 3)) 2097152)
            (lwrtrpb-bit
                (and (eq (lwps-metrics-value new-metrics 2) 2)
                     (and (eq (lwps-metrics-value new-metrics 3) 0)
                          (eq (lwps-metrics-value new-metrics 4) 1)))
                4194304)
            (lwrtrpb-bit
                (and (eq (nth incumbent-first-delta 2) 2)
                     (and (eq (nth incumbent-first-delta 3) (sub 0 2))
                          (eq (nth incumbent-first-delta 4) 0))) 8388608)
            (lwrtrpb-bit
                (and (eq (nth first-new-delta 2) 0)
                     (and (eq (nth first-new-delta 3) 0)
                          (eq (nth first-new-delta 4) 0))) 16777216)
            (lwrtrpb-bit
                (not (node_eq (lwps-suite-dataset prior-suite)
                        (lwps-suite-dataset suite))) 33554432)
            (lwrtrpb-bit
                (and (eq (oac-nothing? (lwps-case-immediate pending-case)) 1)
                     (eq (oac-time-pending? pending-time) 1)) 67108864)
            (lwrtrpb-bit
                (and (eq (oac-time-outcome? condensed-time) 1)
                     (eq (oac-alternative-ack?
                            (oac-time-outcome-ack condensed-time)) 1))
                134217728)
            (lwrtrpb-bit
                (and (eq (lwps-suite-current? revoked-world suite 2) 0)
                     (and (node_eq revoked-comparison (lwo-none))
                          (eq (node_value (nth children 18)) 1))) 268435456)
            (lwrtrpb-bit
                (and (eq (lwo-member?
                            (lwo-field-items (lwo-world-cells revoked-world))
                            first-case) 1)
                     (eq (lwo-active? two-world recipe) 0)) 536870912)
            (lwrtrpb-bit
                (and (eq (len events) 9)
                     (and (eq (lwps-metrics-value new-metrics 6) 2)
                          (and (eq (lwps-metrics-value new-metrics 7) 1)
                               (eq (lwps-metrics-value new-metrics 8) 1))))
                1073741824)))))

; witnessed: 2026-08-09 -> 2147483647 (31/31) on fkwu
(lwrtrpb-run)
