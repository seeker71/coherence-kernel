; voice-g2p-band.fk — letters to phonemes at home, pinned on tables built here so the answer is by construction.
; A line the body was taught answers from its line table whole; a line it was not taught walks its words, keeps the
; punctuation the voice's table holds as phonemes (the two-byte Persian marks speak as their Latin twins), puts the
; space phoneme between words, and answers NOTHING when any word is unknown — never a guess, never a crossing.
; The last rows read the real tables the teaching door left on disk: they stand, and they answer the lines taught.
; Expected: 8191
; Verdict 8191
; PROOF LEVEL: FKWU-STAGED (reads form/form-stdlib/data/g2p-*.tsv)
; preludes: form/form-stdlib/voice-g2p.bml
(do
    (defn vb-bit (ok v) (if ok v 0))
    (let us (byte_to_str 31))
    (let tb (byte_to_str 9))
    (defn row (k phs) (str_concat k (str_concat tb phs)))
    (let wtab (vg-rows-add (record_new 0) (list (row "hello" (str_concat "h" (str_concat us (str_concat "e" (str_concat us "o")))))
                                               (row "world" (str_concat "w" (str_concat us "d"))))))
    (let ltab (vg-rows-add (record_new 0) (list (row "hello world" (str_concat "T" (str_concat us "A"))))))
    (defn eqs (xs ys) (if (eq (len xs) 0) (eq (len ys) 0) (if (eq (len ys) 0) 0 (if (str_eq (head xs) (head ys)) (eqs (tail xs) (tail ys)) 0))))
    (let a (vg-phonemes ltab wtab "hello world"))
    (let b (vg-phonemes (record_new 0) wtab "hello world"))
    (let c (vg-phonemes (record_new 0) wtab "(hello, world."))
    (let d (vg-phonemes (record_new 0) wtab "hello nowhere"))
    (let p (vg-phonemes (record_new 0) wtab "hello، world؟"))
    (let el (vg-load "en" "line"))
    (let ew (vg-load "en" "word"))
    (let ghost (vg-load "zz" "line"))
    (let c1 (vb-bit (eqs a (list "T" "A")) 1))
    (let c2 (vb-bit (eqs b (list "h" "e" "o" " " "w" "d")) 2))
    (let c3 (vb-bit (eqs c (list "(" "h" "e" "o" "," " " "w" "d" ".")) 4))
    (let c4 (vb-bit (nothing? d) 8))
    (let c5 (vb-bit (eqs p (list "h" "e" "o" "," " " "w" "d" "?")) 16))
    (let c6 (vb-bit (eq (vg-count ghost) 0) 32))
    (let c7 (vb-bit (nothing? (vg-phonemes ghost ghost "anything at all")) 64))
    (let c8 (vb-bit (gt (vg-count el) 300) 128))
    (let c9 (vb-bit (gt (vg-count ew) 1000) 256))
    (let c10 (vb-bit (gt (len (vg-phonemes el ew "So, let us begin.")) 5) 512))
    (let c11 (vb-bit (gt (len (vg-phonemes (vg-load "id" "line") (vg-load "id" "word") "Baiklah, mari kita mulai.")) 5) 1024))
    (defn first-taught (code) (do (let t (vg-load code "line")) (len (vg-phonemes t (vg-load code "word") (head (record_keys t))))))
    (let c12 (vb-bit (gt (first-taught "fa") 5) 2048))
    (let c13 (vb-bit (gt (first-taught "pt") 5) 4096))
    (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9 (add c10 (add c11 (add c12 c13)))))))))))))
