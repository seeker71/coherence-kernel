; form-cli-model-generate-plain-reserve-band.fk — the ordinary local door
; preserves a direct answer while reserving a post-observation answer phase.
;
; Pure cursor proof: no model, Metal, source IO, server, or tokenizer process.
; The live door supplies the same ledger to fcmg-generate-with-at-budgeted.
; Expected: 63
;
; preludes: form-stdlib/form-cli-model-generate.fk

(do
    (defn fcmgprb-bit (ok bit) (if ok bit 0))
    (defn fcmgprb-piece (id)
        (if (eq id 9) (HeedOpen)
        (if (eq id 10) "ground"
        (if (eq id 11) (HeedClose)
        (if (eq id 30) " answer"
        (if (eq id 40) " direct" ""))))))
    (defn fcmgprb-decode (ids out)
        (if (eq (len ids) 0) out
            (fcmgprb-decode (tail ids)
                (str_concat out (fcmgprb-piece (head ids))))))
    (defn fcmgprb-decodef (ctx ids) (fcmgprb-decode ids ""))
    (defn fcmgprb-query-step (ctx id pos)
        (if (eq id 8) 9
        (if (eq id 9) 10
        (if (eq id 10) 11
        (if (eq id 30) 999 999)))))
    (defn fcmgprb-direct-step (ctx id pos)
        (if (eq id 39) 40 999))
    (defn fcmgprb-prefill (ctx ids pos)
        (list 30 (add pos (len ids))))
    (defn fcmgprb-encode (ctx text)
        (if (eq (str_len text) 0) (empty) (list 901)))
    (defn fcmgprb-hit (ctx surface local-ready)
        (list "hit"
            "<|form:knowledge-observation|>\nstatus=hit\nanswer:42\n<|/form:knowledge-observation|>"
            "grounded-hit"))
    (defn fcmgprb-run-query ()
        (fhc-run-2p 0 fcmgprb-query-step fcmgprb-prefill fcmgprb-decodef
            fcmgprb-encode fcmgprb-hit 1 8 0 (list 999) 2 3 4 (empty)))
    (defn fcmgprb-run-direct ()
        (fhc-run-2p 0 fcmgprb-direct-step fcmgprb-prefill fcmgprb-decodef
            fcmgprb-encode fcmgprb-hit 1 39 0 (list 999) 2 1 4 (empty)))
    (defn form-cli-model-generate-plain-reserve-band ()
        (do
            (let ledger (fcmg-plain-ledger 24))
            (let invalid (fcmg-plain-ledger 0))
            (let query (fcmgprb-run-query))
            (let direct (fcmgprb-run-direct))
            (let qcur (fhc-cursor-of query))
            (let dcur (fhc-cursor-of direct))
            (sum (list
                (fcmgprb-bit (and
                    (str_eq (nth ledger 0) (fcmg-plain-ledger-mark))
                    (and (eq (fcmg-plain-ledger-query ledger) 24)
                         (eq (fcmg-plain-ledger-reserve ledger) 32))) 1)
                (fcmgprb-bit (and (eq (fcmg-plain-ledger-valid? ledger) 1)
                    (eq (fcmg-plain-ledger-valid? invalid) 0)) 2)
                (fcmgprb-bit (and
                    (eq (fcmg-context-tail-reserve 0
                        (fcmg-plain-ledger-query ledger)
                        (fcmg-plain-ledger-reserve ledger)) 4376)
                    (eq (fcmg-context-need 10 0 0 0
                        (fcmg-plain-ledger-query ledger)
                        (fcmg-plain-ledger-reserve ledger)) 4386)) 4)
                ; Direct prose spends only the caller's ordinary phase; it
                ; neither invents a lookup nor consumes the held reserve.
                (fcmgprb-bit (and (eq (fhc-phase dcur) (PhaseQuery))
                    (and (eq (fhc-lookups dcur) 0)
                    (and (eq (fhc-query-tokens dcur) 1)
                    (and (eq (fhc-answer-tokens dcur) 0)
                    (and (eq (fhc-answer-left dcur) 4)
                         (eq (fhc-timeout? dcur) 0)))))) 8)
                ; A completed query, including one that closes on its final
                ; ordinary slot, opens and spends the separate answer phase.
                (fcmgprb-bit (and (eq (fhc-phase qcur) (PhaseAnswer))
                    (and (eq (fhc-lookups qcur) 1)
                    (and (eq (fhc-query-tokens qcur) 3)
                    (and (eq (fhc-answer-tokens qcur) 1)
                    (and (eq (fhc-answer-left qcur) 3)
                         (eq (fhc-timeout? qcur) 0)))))) 16)
                (fcmgprb-bit (and (ge (str_find
                    (fcmgprb-decodef 0 (fhc-out direct)) " direct" 0) 0)
                    (and (ge (str_find
                        (fcmgprb-decodef 0 (fhc-out query)) " answer" 0) 0)
                         (eq (fhc-stopped? qcur) 1))) 32)))))

    (form-cli-model-generate-plain-reserve-band))
