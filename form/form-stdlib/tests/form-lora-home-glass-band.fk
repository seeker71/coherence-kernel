; preludes: form/form-stdlib/form-fs.fk form/form-stdlib/form-cli-qwen-teach-layer.fk form/form-stdlib/form-cli-lora-writer.bml form/form-stdlib/qwen-lora-head.fk form/form-stdlib/symbol-voice.bml
(do
    (let p (flw-from-sample "home adapter receipt" (fqt-dim)))
    (let w (flw-write (flw-path) (nth p 0) (nth p 1)))
    (let words (sv-say "us DO admit* | glass G* T:64"))
    (sum (list (if (eq (flw-written (flw-path)) 1) 1 0) (if (eq (fqt-adapter-applied?) 1) 2 0) (if (and (gt (str_find words "this sitting" 0) -1) (gt (str_find words "physically live" 0) -1)) 4 0))))
