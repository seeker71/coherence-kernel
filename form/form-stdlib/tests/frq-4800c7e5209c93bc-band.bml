let memory=[["finding","cp1",false,0,"option","first",1,first]];
let resumed=nt-prior-totals(memory,"cp1");
let fresh=nt-prior-totals([],"");
let earlier=nt-prior-totals([],"cp9");
let other=nt-prior-totals(memory,"cp2");
[nt-share(48,resumed,"checkpoint_turns"), nt-share(9,resumed,"checkpoint_checks"), nt-share(19,resumed,"checkpoint_repairs"), nt-share(24,fresh,"checkpoint_turns"), nothing?(nt-share(24,earlier,"checkpoint_turns")) ? 1 : 0, nothing?(nt-share(24,other,"checkpoint_turns")) ? 1 : 0, nothing?(nt-share(nothing(),resumed,"checkpoint_turns")) ? 1 : 0];
