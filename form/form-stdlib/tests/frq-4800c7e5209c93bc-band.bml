 let expected4=[24,4,9,24,1,1,1];
 let held4=len(result4)==1 && actual4==expected4;
 let observation4=["an option's share is its checkpoint total less the previous option's: resumed, fresh, resumed from an earlier walk, another checkpoint, an unread total",value_kind(actual4),actual4,expected4,held4,len(result4)==1];
 fb_record(observation4,"native-plan-case",4);
 print(observation4);
