json-object-has?(nt-measured(json-node-object([fhn-s("gap","test-gap-2")]), json-node-object([fhn-s("status","failed")]), json-node-object([fhn-n("dry",0), fhn-n("test",0)]), "lane-exit=1", 0, 0, 0, json-node-object([fhn-n("plan_local_generated_ids",0), fhn-n("plan_local_injected_ids",0)])), "blocking_check");
}] catch [];
 let actual1=nil?(result1) ? nothing() : result1[0];
 let expected1=1;
 let held1=len(result1)==1 && actual1==expected1;
 let observation1=["json-object-has?(nt-measured(json-node-object([fhn-s(\"gap\",\"test-gap-2\")]), json-node-object([fhn-s(\"status\",\"failed\")]), json-node-object([fhn-n(\"dry\",0), fhn-n(\"test\",0)]), \"lane-exit=1\", 0, 0, 0, json-node-object([fhn-n(\"plan_local_generated_ids\",0), fhn-n(\"plan_local_injected_ids\",0)])), \"blocking_check\")",value_kind(actual1),actual1,expected1,held1,len(result1)==1];
