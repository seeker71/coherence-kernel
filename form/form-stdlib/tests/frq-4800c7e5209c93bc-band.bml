; Native case observations; the final reading is their conjunction.
; Verdict 1
; preludes: form-stdlib/core.fk form-stdlib/json.fk observe/native-turn-run.bml
section [form.bml] {
 let all=true;
 let result0=try [{
json-string-value(json-object-get(nt-measured(json-node-object([fhn-s("gap","test-gap")]), json-node-object([fhn-s("blocking_check","check-1"), fhn-s("status","complete"), fhn-n("release_ok",1)]), json-node-object([fhn-n("dry",0), fhn-n("test",0)]), "lane-exit=0", 1, 0, 0, json-node-object([fhn-n("plan_local_generated_ids",0), fhn-n("plan_local_injected_ids",0)])), "blocking_check"));
