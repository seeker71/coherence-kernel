; living-world-continuity-branch-witness.fk -- two granted branches restore
; independently from one inert image.
; witnessed: 2026-08-08 -> 65535 on direct-source fkwu
;
; The fixture vocabulary is local and opaque.  It exists only to distinguish
; sources, payloads, capabilities, optional lens material, and provenance.
; The branch organ sees none of these names.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-continuity-branch.fk

(let LWCBW-SOURCE-A      (bp "LWCBW-SOURCE-A"))
(let LWCBW-SOURCE-B      (bp "LWCBW-SOURCE-B"))
(let LWCBW-CUSTODIAN     (bp "LWCBW-CUSTODIAN"))
(let LWCBW-PROVENANCE-A  (bp "LWCBW-PROVENANCE-A"))
(let LWCBW-PROVENANCE-B  (bp "LWCBW-PROVENANCE-B"))
(let LWCBW-PROVENANCE-C  (bp "LWCBW-PROVENANCE-C"))
(let LWCBW-PAYLOAD-A     (bp "LWCBW-PAYLOAD-A"))
(let LWCBW-PAYLOAD-B     (bp "LWCBW-PAYLOAD-B"))
(let LWCBW-CAPABILITY-A  (bp "LWCBW-CAPABILITY-A"))
(let LWCBW-CAPABILITY-B  (bp "LWCBW-CAPABILITY-B"))
(let LWCBW-EVIDENCE-A    (bp "LWCBW-EVIDENCE-A"))
(let LWCBW-EVIDENCE-B    (bp "LWCBW-EVIDENCE-B"))
(let LWCBW-DECLARATION-B (bp "LWCBW-DECLARATION-B"))
(let LWCBW-LENS-B        (bp "LWCBW-LENS-B"))
(let LWCBW-ALTERNATIVE-B (bp "LWCBW-ALTERNATIVE-B"))
(let LWCBW-UNKNOWN-B     (bp "LWCBW-UNKNOWN-B"))
(let LWCBW-ACTION        (bp "LWCBW-ACTION"))
(let LWCBW-REASON        (bp "LWCBW-REASON"))

(defn lwcbw-cell (kind) (intern_node kind (empty)))
(defn lwcbw-source-a () (lwcbw-cell LWCBW-SOURCE-A))
(defn lwcbw-source-b () (lwcbw-cell LWCBW-SOURCE-B))
(defn lwcbw-custodian () (lwcbw-cell LWCBW-CUSTODIAN))
(defn lwcbw-provenance-a () (lwcbw-cell LWCBW-PROVENANCE-A))
(defn lwcbw-provenance-b () (lwcbw-cell LWCBW-PROVENANCE-B))
(defn lwcbw-provenance-c () (lwcbw-cell LWCBW-PROVENANCE-C))
(defn lwcbw-payload-a () (lwcbw-cell LWCBW-PAYLOAD-A))
(defn lwcbw-payload-b () (lwcbw-cell LWCBW-PAYLOAD-B))
(defn lwcbw-capability-a () (lwcbw-cell LWCBW-CAPABILITY-A))
(defn lwcbw-capability-b () (lwcbw-cell LWCBW-CAPABILITY-B))
(defn lwcbw-evidence-a () (lwcbw-cell LWCBW-EVIDENCE-A))
(defn lwcbw-evidence-b () (lwcbw-cell LWCBW-EVIDENCE-B))
(defn lwcbw-declaration-b () (lwcbw-cell LWCBW-DECLARATION-B))
(defn lwcbw-lens-b () (lwcbw-cell LWCBW-LENS-B))
(defn lwcbw-alternative-b () (lwcbw-cell LWCBW-ALTERNATIVE-B))
(defn lwcbw-unknown-b () (lwcbw-cell LWCBW-UNKNOWN-B))
(defn lwcbw-action () (lwcbw-cell LWCBW-ACTION))
(defn lwcbw-reason () (lwcbw-cell LWCBW-REASON))

(defn lwcbw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwcbw-sum (tail items)))))

(defn lwcbw-interface ()
    (lwo-interface (list (lwcbw-action))))

(defn lwcbw-entry (source provenance payload)
    (lwt-entry
        (lwo-offer source (lwcbw-interface) 1 payload provenance 1)
        (lwcbw-action)))

(defn lwcbw-revocation-entry (source provenance target)
    (lwcbw-entry source provenance
        (lwo-revocation target source (lwcbw-reason) provenance)))

(defn lwcbw-grant-a ()
    (lwcp-grant (lwcbw-payload-a) (lwcbw-capability-a)
        (lwcbw-evidence-a)))

(defn lwcbw-grant-b ()
    (lwcp-grant (lwcbw-payload-b) (lwcbw-capability-b)
        (lwcbw-evidence-b)))

(defn lwcbw-historical-world ()
    (lwt-receive-stream (lwo-empty-world)
        (list
            (lwcbw-entry (lwcbw-source-a) (lwcbw-provenance-a)
                (lwcbw-payload-a))
            (lwcbw-entry (lwcbw-source-a) (lwcbw-provenance-a)
                (lwcbw-capability-a))
            (lwcbw-entry (lwcbw-source-a) (lwcbw-provenance-a)
                (lwcbw-grant-a))
            (lwcbw-entry (lwcbw-source-b) (lwcbw-provenance-b)
                (lwcbw-payload-b))
            (lwcbw-entry (lwcbw-source-b) (lwcbw-provenance-b)
                (lwcbw-capability-b))
            (lwcbw-entry (lwcbw-source-b) (lwcbw-provenance-b)
                (lwcbw-grant-b)))))

(defn lwcbw-image ()
    (lwcn-image (lwcbw-historical-world)))

; Branch A demonstrates that every descriptive option may be absent.
(defn lwcbw-branch-a ()
    (lwcb-branch (lwcbw-image) (lwcbw-capability-a)
        (lwo-none) (lwo-none) (lwo-empty-field) (lwo-none)))

; Branch B demonstrates independently offered declaration, lens, alternative,
; and unknowable remainder.  None becomes a default decision.
(defn lwcbw-branch-b ()
    (lwcb-branch (lwcbw-image) (lwcbw-capability-b)
        (lwcbw-declaration-b) (lwcbw-lens-b)
        (lwo-field (list (lwcbw-alternative-b)))
        (lwcbw-unknown-b)))

(defn lwcbw-admission-world ()
    (lwt-receive-stream (lwo-empty-world)
        (list
            (lwcbw-entry (lwcbw-custodian) (lwcbw-provenance-c)
                (lwcbw-branch-a))
            (lwcbw-entry (lwcbw-custodian) (lwcbw-provenance-c)
                (lwcbw-branch-b)))))

(defn lwcbw-proposal-a ()
    (lwcb-restore-proposal (lwcbw-admission-world) (lwcbw-branch-a)))

(defn lwcbw-proposal-b ()
    (lwcb-restore-proposal (lwcbw-admission-world) (lwcbw-branch-b)))

(defn lwcbw-response-entry (source provenance proposal ack)
    (lwcbw-entry source provenance
        (lwt-response proposal ack provenance)))

; Both proposals receive one response from the unrelated source.  A also
; receives its participant's ONE.  B receives its participant's explicit
; NOTHING, which is history and waiting rather than absence or permission.
(defn lwcbw-response-world ()
    (do
        (let admission (lwcbw-admission-world))
        (let proposal-a (lwcbw-proposal-a))
        (let proposal-b (lwcbw-proposal-b))
        (lwt-receive-stream admission
            (list
                (lwcbw-response-entry
                    (lwcbw-source-a) (lwcbw-provenance-a)
                    proposal-a (oac-one proposal-a))
                (lwcbw-response-entry
                    (lwcbw-source-b) (lwcbw-provenance-b)
                    proposal-a (oac-one proposal-a))
                (lwcbw-response-entry
                    (lwcbw-source-a) (lwcbw-provenance-a)
                    proposal-b (oac-one proposal-b))
                (lwcbw-response-entry
                    (lwcbw-source-b) (lwcbw-provenance-b)
                    proposal-b (oac-nothing))))))

(defn lwcbw-round (world)
    (lwt-round world
        (lwo-field (list (lwcbw-proposal-a) (lwcbw-proposal-b)))
        (lwo-empty-field) (lwo-none)))

(defn lwcbw-after-a-round ()
    (lwcb-integrate-restore
        (lwcbw-round (lwcbw-response-world))
        (lwcbw-proposal-a) (lwcbw-action)))

(defn lwcbw-after-a-world ()
    (lwt-round-world (lwcbw-after-a-round)))

(defn lwcbw-after-waiting-b-round ()
    (lwcb-integrate-restore
        (lwcbw-round (lwcbw-after-a-world))
        (lwcbw-proposal-b) (lwcbw-action)))

(defn lwcbw-after-waiting-b-world ()
    (lwt-round-world (lwcbw-after-waiting-b-round)))

(defn lwcbw-b-dissent ()
    (lwt-response (lwcbw-proposal-b) (oac-zero)
        (lwcbw-provenance-b)))

(defn lwcbw-dissent-world ()
    (lwt-receive-stream (lwcbw-after-waiting-b-world)
        (list (lwcbw-entry (lwcbw-source-b) (lwcbw-provenance-b)
                    (lwcbw-b-dissent)))))

(defn lwcbw-after-dissent-b-round ()
    (lwcb-integrate-restore
        (lwcbw-round (lwcbw-dissent-world))
        (lwcbw-proposal-b) (lwcbw-action)))

(defn lwcbw-after-dissent-b-world ()
    (lwt-round-world (lwcbw-after-dissent-b-round)))

; B revokes only its dissent response, retains the earlier explicit NOTHING as
; history, and adds ONE.  ONE then authorizes B's branch without revising A.
(defn lwcbw-revised-b-world ()
    (lwt-receive-stream (lwcbw-after-dissent-b-world)
        (list
            (lwcbw-revocation-entry
                (lwcbw-source-b) (lwcbw-provenance-b)
                (lwcbw-b-dissent))
            (lwcbw-response-entry
                (lwcbw-source-b) (lwcbw-provenance-b)
                (lwcbw-proposal-b) (oac-one (lwcbw-proposal-b))))))

(defn lwcbw-after-b-round ()
    (lwcb-integrate-restore
        (lwcbw-round (lwcbw-revised-b-world))
        (lwcbw-proposal-b) (lwcbw-action)))

(defn lwcbw-restored-world ()
    (lwt-round-world (lwcbw-after-b-round)))

; A cannot revoke B's restored attribution.  The normal membrane refuses the
; revocation because A does not own B's payload attribution.
(defn lwcbw-after-cross-revocation ()
    (lwt-receive-stream (lwcbw-restored-world)
        (list
            (lwcbw-revocation-entry
                (lwcbw-source-a) (lwcbw-provenance-a)
                (lwcbw-payload-b)))))

; B may revoke only B's own restored payload attribution.
(defn lwcbw-after-local-revocation ()
    (lwt-receive-stream (lwcbw-after-cross-revocation)
        (list
            (lwcbw-revocation-entry
                (lwcbw-source-b) (lwcbw-provenance-b)
                (lwcbw-payload-b)))))
