// Native repair is caller-owned, attributed, and checked again before acceptance.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 class FormCliNativeReviewRepairBand {
  def fnrrb-check(docs,subject) = list(and(value_eq(head(subject),docs),str_eq(nth(subject,1),"correct")),"actual caller report check");
  def fnrrb-source(docs,actual) = list(value_eq(docs,actual),"original source check");
  def fnrrb-repair(contract,subject) = if not(and(str_eq(nth(subject,1),"wrong"),str_eq(nth(subject,2),"actual caller report check"))) then form_error("native callback lost actual failure") else list(1,"correct","native-fixture","candidate generated from caller data");
  def fnrrb-still-wrong(contract,subject) = list(1,"still wrong","native-fixture","candidate remains unverified");
  def fnrrb-decline(contract,subject) = list(0,"","native-fixture","no candidate");
  def fnrrb-same(contract,subject) = list(1,nth(subject,1),"native-fixture","same candidate");
  def fnrrb-malformed(contract,subject) = list(1,"correct");
  def fnrrb-continue(contract,subject) = append(fnrrb-repair(contract,subject),list("review"));
  def fnrrb-continue-failed(contract,subject) = append(fnrrb-still-wrong(contract,subject),list("review"));
  def fnrrb-continue-declined(contract,subject) = append(fnrrb-decline(contract,subject),list("review"));
  def fnrrb-continue-same(contract,subject) = append(fnrrb-same(contract,subject),list("review"));
  def fnrrb-bad-route(contract,subject) = append(fnrrb-repair(contract,subject),list("complete"));
  def fnrrb-bomb(contract,subject) = form_error("unauthorized native repair invocation");
  def fnrrb-never(contract,subject) = list(0,"source check refuses");
  def fnrrb-bad-check(contract,subject) = 1;
  def fnrrb-assert(name,ok) = if ok then 1 else form_error(str_concat("native report repair: ",name));
  def fnrrb-amend-message(text,edits) = str_concat("{\"report_amend\":{\"base\":\"",str_concat(fcra-id(text),str_concat("\",\"replacements\":",str_concat(edits,"}}"))));
  def fnrrb-amend-check(docs,subject) = list(and(value_eq(docs,head(subject)),str_eq(fcap-string(parse-json("candidate",nth(subject,1)),"answer"),"supported")),"answer must be supported; all documents unchanged");
  def fnrrb-amend-refused(text,edits) = not(head(fcra-apply(text,parse-json("message",fnrrb-amend-message(text,edits)))));
  def fnrrb-amend-cases(text,cases) = if nil?(cases) then 1 else and(fnrrb-amend-refused(text,head(cases)),fnrrb-amend-cases(text,tail(cases)));
  def fnrrb-text-message(text,edits) = ne-replace-first(fnrrb-amend-message(text,edits),"\"replacements\":","\"text_edits\":");
  def fnrrb-text-apply(text,edits) = fcra-apply(text,parse-json("text-message",fnrrb-text-message(text,edits)));
  def fnrrb-amend-test() {
   let text = "{\"answer\":\"wrong\",\"rows\":[{\"quote\":\"old\"}],\"kept\":false}";
   let edits = "[{\"path\":[\"answer\"],\"value\":\"supported\"},{\"path\":[\"rows\",0,\"quote\"],\"value\":\"exact\"}]";
   let message = fnrrb-amend-message(text,edits);
   let applied = fcra-apply(text,parse-json("message",message));
   fnrrb-assert("nested replacements preserve unselected values",and(head(applied),faj-equal(nth(applied,1),parse-json("expected","{\"answer\":\"supported\",\"rows\":[{\"quote\":\"exact\"}],\"kept\":false}"))));
   fnrrb-assert("invalid paths and ambiguous edits refuse atomically",fnrrb-amend-cases(text,list("[]","[{\"path\":[],\"value\":{}}]","[{\"path\":[\"absent\"],\"value\":0}]","[{\"path\":[\"answer\",0],\"value\":0}]","[{\"path\":[\"rows\",1],\"value\":0}]","[{\"path\":[\"rows\",-1],\"value\":0}]","[{\"path\":[\"rows\",0.5],\"value\":0}]","[{\"path\":[\"rows\",\"0\"],\"value\":0}]","[{\"path\":[true],\"value\":0}]","[{\"path\":[\"answer\"],\"value\":0},{\"path\":[\"answer\"],\"value\":1}]","[{\"path\":[\"rows\"],\"value\":[]},{\"path\":[\"rows\",0],\"value\":1}]","[{\"path\":[\"rows\",0],\"value\":1},{\"path\":[\"rows\"],\"value\":[]}]","[{\"path\":[\"answer\"],\"value\":0,\"value\":1}]","[{\"path\":[\"answer\"],\"value\":{\"x\":0,\"x\":1}}]","[{\"path\":[\"answer\"],\"extra\":0,\"value\":1}]","[{\"path\":[\"answer\"],\"value\":1},{\"path\":[\"missing\"],\"value\":0}]")));
   fnrrb-assert("stale exact byte identity is refused",not(head(fcra-apply(str_concat(text," "),parse-json("stale",message)))));
   let ambiguous = "{\"answer\":\"wrong\",\"answer\":\"other\"}";
   fnrrb-assert("duplicate retained keys refused",fnrrb-amend-refused(ambiguous,"[{\"path\":[\"answer\"],\"value\":1}]"));
   let docs = list(list("source","source.txt","immutable"));
   let checker = list(fnrrb-amend-check,docs);
   let initial = fcap-open-direct-review("review sources",docs);
   let failed = fcap-step(initial,str_concat("{\"report\":",str_concat(text,"}")),checker);
   let unchanged = fcap-step(failed,fnrrb-amend-message(text,"[{\"path\":[\"answer\"],\"value\":\"wrong\"}]"),checker);
   fnrrb-assert("unchanged amendment keeps the failed report without new checks or amendment history",and(str_eq(fcap-report(unchanged),text),and(eq(fcap-checks(unchanged),fcap-checks(failed)),and(nil?(fcap-amendments(unchanged)),ge(str_find(fcap-note(unchanged),"report values unchanged",0),0)))));
   fnrrb-assert("JSON key order alone is not a report repair",fnrrb-amend-refused("{\"answer\":{\"a\":1,\"b\":2}}","[{\"path\":[\"answer\"],\"value\":{\"b\":2,\"a\":1}}]"));
   fnrrb-assert("a mixed amendment with a concrete change remains available",head(fcra-apply(text,parse-json("mixed",fnrrb-amend-message(text,"[{\"path\":[\"answer\"],\"value\":\"wrong\"},{\"path\":[\"rows\",0,\"quote\"],\"value\":\"new\"}]")))));
   let packet = parse-json("observation",fcap-observation(failed));
   fnrrb-assert("repair exposes exact retained identity",str_eq(fcap-string(json-object-get(packet,"report_amend"),"base"),fcra-id(fcap-report(failed))));
   let fixed = fcap-step(failed,message,checker);
   fnrrb-assert("amendment reruns full checks and preserves sources",and(str_eq(fcap-stage(fixed),"complete"),and(eq(fcap-checks(fixed),2),value_eq(fcap-docs(fixed),docs))));
   fnrrb-assert("model authorship stays separate from native repair",and(str_eq(fcap-report-source(fixed),"model-amendment"),and(eq(len(fcap-amendments(fixed)),1),nil?(fcap-native-repairs(fixed)))));
   let history = head(fcap-amendments(fixed));
   fnrrb-assert("before amendment candidate and checker remain paired",and(str_eq(head(history),text),and(str_eq(nth(history,1),message),and(str_eq(nth(history,2),fcap-report(fixed)),eq(head(nth(history,3)),1)))));
   fnrrb-assert("amendment history survives native checkpoint",value_eq(fcap-amendments(fcam-unpack(bytes_to_recipe(recipe_to_bytes(fcam-pack(fixed))))),fcap-amendments(fixed)));
   let encoded = parse-json("result",fcaq-result-core(list(fixed,1,0,0,0)));
   fnrrb-assert("caller result exposes actual amendment evidence",eq(len(node_children(json-object-get(encoded,"model_amendments"))),1));
   fnrrb-assert("new context receives retained report bytes",ge(str_find(fcap-bootstrap(fcap-begin-context(failed)),json-emit(json-node-string(text)),0),0));
   let still = fcap-step(failed,fnrrb-amend-message(text,"[{\"path\":[\"rows\",0,\"quote\"],\"value\":\"new\"}]"),checker);
   fnrrb-assert("addressed edit is not semantic acceptance",and(str_eq(fcap-stage(still),"repair"),and(eq(fcap-checks(still),2),eq(head(nth(head(fcap-amendments(still)),3)),0))));
   let atomic = fcap-step(failed,fnrrb-amend-message(text,"[{\"path\":[\"answer\"],\"value\":\"supported\"},{\"path\":[\"absent\"],\"value\":0}]"),checker);
   fnrrb-assert("refusal retains original bytes and check count",and(str_eq(fcap-report(atomic),text),and(eq(fcap-checks(atomic),1),nil?(fcap-amendments(atomic)))));
   let textMessage = fnrrb-text-message(text,"[{\"path\":[\"answer\"],\"old\":\"wrong\",\"new\":\"supported\"}]");
   let textFixed = fcap-step(failed,textMessage,checker);
   fnrrb-assert("literal report edit reruns the same checks and preserves sources",and(str_eq(fcap-stage(textFixed),"complete"),and(eq(fcap-checks(textFixed),2),value_eq(fcap-docs(textFixed),docs))));
   fnrrb-assert("literal report edits keep model authorship and exact action evidence",and(str_eq(fcap-report-source(textFixed),"model-amendment"),str_eq(nth(head(fcap-amendments(textFixed)),1),textMessage)));
   let textStill = fcap-step(failed,fnrrb-text-message(text,"[{\"path\":[\"answer\"],\"old\":\"wr\",\"new\":\"\"}]"),checker);
   fnrrb-assert("deletion changes only selected text and leaves failed content in repair",and(str_eq(fcap-string(parse-json("deleted",fcap-report(textStill)),"answer"),"ong"),and(str_eq(fcap-stage(textStill),"repair"),eq(fcap-checks(textStill),2))));
   let textAtomic = fcap-step(failed,fnrrb-text-message(text,"[{\"path\":[\"answer\"],\"old\":\"wrong\",\"new\":\"supported\"},{\"path\":[\"rows\",0,\"quote\"],\"old\":\"missing\",\"new\":\"x\"}]"),checker);
   fnrrb-assert("a later refused text edit retains the full original report and check count",and(str_eq(fcap-report(textAtomic),text),and(eq(fcap-checks(textAtomic),1),nil?(fcap-amendments(textAtomic)))));
   let utf = "{\"answer\":\"été\\nآری\",\"rows\":[{\"quote\":\"one word\"}],\"kept\":false}";
   let utfEdit = fnrrb-text-apply(utf,"[{\"path\":[\"answer\"],\"old\":\"été\\n\",\"new\":\"yes \\\"quoted\\\" \"},{\"path\":[\"rows\",0,\"quote\"],\"old\":\"one \",\"new\":\"\"}]");
   fnrrb-assert("literal edits retain UTF-8 escaping nested arrays and unselected values",and(head(utfEdit),faj-equal(nth(utfEdit,1),parse-json("utf-expected","{\"answer\":\"yes \\\"quoted\\\" آری\",\"rows\":[{\"quote\":\"word\"}],\"kept\":false}"))));
   fnrrb-assert("overlapping literal occurrences remain ambiguous",not(head(fnrrb-text-apply("{\"answer\":\"aaaa\"}","[{\"path\":[\"answer\"],\"old\":\"aaa\",\"new\":\"b\"}]"))));
   fnrrb-assert("empty old text is refused",not(head(fnrrb-text-apply(text,"[{\"path\":[\"answer\"],\"old\":\"\",\"new\":\"x\"}]"))));
   fnrrb-assert("unchanged text is refused",not(head(fnrrb-text-apply(text,"[{\"path\":[\"answer\"],\"old\":\"wrong\",\"new\":\"wrong\"}]"))));
   fnrrb-assert("text edit cannot turn a non-string value into text",not(head(fnrrb-text-apply(text,"[{\"path\":[\"kept\"],\"old\":\"false\",\"new\":\"true\"}]"))));
   fnrrb-assert("text edit operands are strings",not(head(fnrrb-text-apply(text,"[{\"path\":[\"answer\"],\"old\":\"wrong\",\"new\":null}]"))));
   fnrrb-assert("text edit paths cannot overlap",not(head(fnrrb-text-apply(text,"[{\"path\":[\"answer\"],\"old\":\"wr\",\"new\":\"\"},{\"path\":[\"answer\"],\"old\":\"ong\",\"new\":\"\"}]"))));
   fnrrb-assert("text edit retains the exact base requirement",not(head(fcra-apply(str_concat(text," "),parse-json("stale-text",textMessage)))));
   let duplicate = str_concat("{\"report_amend\":null,",substring(message,1,str_len(message)));
   let refusedDuplicate = fcap-step(failed,duplicate,checker);
   fnrrb-assert("controller refuses duplicate keys before normalization",and(str_eq(fcap-report(refusedDuplicate),text),eq(fcap-checks(refusedDuplicate),1)));
   let awaiting = fcap-note-at(failed,"review","native continuation needs a complete report");
   let refusedContinuation = fcap-step(awaiting,message,checker);
   fnrrb-assert("amendment cannot shortcut native review continuation",and(eq(fcap-checks(refusedContinuation),1),nil?(fcap-amendments(refusedContinuation))));
   fnrrb-assert("initial report required",eq(fcap-checks(fcap-step(initial,message,checker)),0));
   1;
  }
  def fnrrb-run() {
   fnrrb-amend-test();
   let docs = list(list("source","source.txt","immutable"));
   let initial = fcap-open-direct-review("review caller source",docs);
   let base = list(fnrrb-check,docs,fnrrb-source,docs);
   let checked = fcap-step(initial,"{\"report\":\"wrong\"}",append(base,list(fnrrb-repair,list())));
   fnrrb-assert("native candidate is independently rechecked",and(str_eq(fcap-stage(checked),"complete"),and(eq(fcap-checks(checked),2),eq(fcap-failures(checked),1))));
   fnrrb-assert("native source and original documents are preserved",and(str_eq(fcap-report-source(checked),"caller-native-repair"),and(str_eq(fcap-report(checked),"correct"),value_eq(fcap-docs(checked),docs))));
   fnrrb-assert("accepted event and actual check count are retained",and(eq(len(fcap-native-repairs(checked)),1),and(str_eq(nth(head(fcap-native-repairs(checked)),1),"accepted"),eq(nth(head(fcap-native-repairs(checked)),3),2))));
   let failed = fcap-step(initial,"{\"report\":\"wrong\"}",append(base,list(fnrrb-still-wrong,list())));
   fnrrb-assert("failed native candidate returns to ordinary repair exactly once",and(str_eq(fcap-stage(failed),"repair"),and(eq(fcap-checks(failed),2),and(eq(fcap-failures(failed),2),eq(len(fcap-native-repairs(failed)),1)))));
   let declined = fcap-step(initial,"{\"report\":\"wrong\"}",append(base,list(fnrrb-decline,list())));
   fnrrb-assert("decline preserves failed report and checker count",and(str_eq(fcap-stage(declined),"repair"),and(eq(fcap-checks(declined),1),str_eq(fcap-report(declined),"wrong"))));
   let same = fcap-step(initial,"{\"report\":\"wrong\"}",append(base,list(fnrrb-same,list())));
   fnrrb-assert("unchanged proposal does not buy another checker call",and(eq(fcap-checks(same),1),str_eq(nth(head(fcap-native-repairs(same)),1),"unchanged")));
   let malformed = fcap-step(initial,"{\"report\":\"wrong\"}",append(base,list(fnrrb-malformed,list())));
   fnrrb-assert("malformed proposal cannot complete",and(str_eq(fcap-stage(malformed),"attention"),str_eq(fcap-report(malformed),"wrong")));
   let passed = fcap-step(initial,"{\"report\":\"correct\"}",append(base,list(fnrrb-bomb,list())));
   fnrrb-assert("passing reports never invoke repair",and(str_eq(fcap-stage(passed),"complete"),nil?(fcap-native-repairs(passed))));
   let unconfigured = fcap-step(initial,"{\"report\":\"wrong\",\"native_repair\":\"invented\"}",base);
   fnrrb-assert("model fields cannot install a callback",and(str_eq(fcap-stage(unconfigured),"repair"),nil?(fcap-native-repairs(unconfigured))));
   fnrrb-assert("native work does not consume an extra submitted turn",and(eq(fcap-turns(checked),fcap-turns(unconfigured)),eq(fcap-turns(failed),fcap-turns(unconfigured))));
   let sourceFailure = fcap-step(initial,"{\"report\":\"wrong\"}",list(fnrrb-never,docs,fnrrb-source,docs,fnrrb-still-wrong,list()));
   fnrrb-assert("native proposal cannot bypass a refusing complete checker",and(str_eq(fcap-stage(sourceFailure),"repair"),eq(fcap-checks(sourceFailure),2)));
   let invalidCheck = fcap-step(initial,"{\"report\":\"wrong\"}",list(fnrrb-bad-check,docs,fnrrb-source,docs,fnrrb-bomb,list()));
   fnrrb-assert("malformed original checker does not invoke repair",str_eq(fcap-stage(invalidCheck),"attention"));
   let later = fcap-step(failed,"{\"report\":\"correct\"}",base);
   fnrrb-assert("later submitted report has its own attribution",and(str_eq(fcap-report-source(later),"submitted"),eq(len(fcap-native-repairs(later)),1)));
   let resumed = fcap-begin-context(checked);
   fnrrb-assert("context renewal preserves provenance",and(str_eq(fcap-report-source(resumed),"caller-native-repair"),value_eq(fcap-native-repairs(resumed),fcap-native-repairs(checked))));
   let roundtrip = fcam-unpack(bytes_to_recipe(recipe_to_bytes(fcam-pack(checked))));
   fnrrb-assert("binary continuity preserves native attribution",and(str_eq(fcap-report-source(roundtrip),"caller-native-repair"),value_eq(fcap-native-repairs(roundtrip),fcap-native-repairs(checked))));
   let output = parse-json("result",fcaq-result-core(list(checked,1,0,0,0)));
   fnrrb-assert("agent result exposes native provenance",and(str_eq(fcap-string(output,"report_source"),"caller-native-repair"),eq(len(node_children(json-object-get(output,"native_repairs"))),1)));
   let event = head(node_children(json-object-get(output,"native_repairs")));
   let before = json-object-get(event,"before");
   let after = json-object-get(event,"after");
   fnrrb-assert("each checker result stays with its exact report",and(str_eq(fcap-string(before,"report"),"wrong"),and(eq(json-int-value(json-object-get(json-object-get(before,"check"),"passed")),0),and(str_eq(fcap-string(after,"report"),"correct"),eq(json-int-value(json-object-get(json-object-get(after,"check"),"passed")),1)))));
   let rejectedAfter = json-object-get(head(fcap-native-repairs-json(fcap-native-repairs(failed))),"after");
   fnrrb-assert("rejected native candidate keeps its own failing check",and(str_eq(fcap-string(rejectedAfter,"report"),"still wrong"),eq(json-int-value(json-object-get(json-object-get(rejectedAfter,"check"),"passed")),0)));
   let declineEvent = head(fcap-native-repairs-json(fcap-native-repairs(declined)));
   fnrrb-assert("decline does not invent an after check",and(str_eq(fcap-string(json-object-get(declineEvent,"before"),"report"),"wrong"),str_eq(faj-type(json-object-get(declineEvent,"after")),"null")));
   let legacy = fcap-record-native(initial,"old-method","declined","old observation","submitted");
   let legacyEvent = head(fcap-native-repairs-json(fcap-native-repairs(legacy)));
   fnrrb-assert("older history stays explicitly without report evidence",and(str_eq(faj-type(json-object-get(legacyEvent,"before")),"null"),str_eq(faj-type(json-object-get(legacyEvent,"after")),"null")));
   let invalidEvidence = fcap-native-evidence-json(list(0,0,0,0,fcap-report-check-evidence("candidate",1)),4);
   fnrrb-assert("malformed checker output cannot become an observed check",and(str_eq(fcap-string(invalidEvidence,"check_status"),"malformed"),str_eq(faj-type(json-object-get(invalidEvidence,"check")),"null")));
   let code = fcap-with-report(fcap-open("code",docs,list("source.txt")),"wrong");
   fnrrb-assert("coding does not invoke a review repair hook",str_eq(fcap-stage(fcap-submit(code,list(fnrrb-never,docs,fnrrb-source,docs,fnrrb-bomb,list()))),"repair"));
   let stopped = fcap-terminal(initial,"diagnostic-control-unavailable");
   fnrrb-assert("native repair cannot bypass a terminal refusal",value_eq(fcap-native-attempt(stopped,append(base,list(fnrrb-bomb,list())),list(0,"failed")),stopped));
   let pending = fcap-step(fcap-begin-context(initial),"{\"report\":\"wrong\"}",append(base,list(fnrrb-continue,list())));
   fnrrb-assert("verified continuation remains unfinished in the submitted turn",and(fcap-awaiting-native-review(pending),and(not(fcap-done(pending)),and(eq(fcap-turns(pending),fcap-turns(checked)),and(eq(fcap-checks(pending),2),eq(fcap-failures(pending),1))))));
   let packet = parse-json("pending",fcap-observation(pending));
   let pair = json-object-get(packet,"native_review");
   let known = fcap-native-submission-admitted(pending,"{\"report\":\"wrong\"}");
   let knownBefore = json-object-get(json-object-get(parse-json("known",fcap-observation(known)),"native_review"),"before");
   fnrrb-assert("only an exact resident submission permits a report reference",and(str_eq(fcap-string(knownBefore,"report_reference"),"preceding-submission"),and(value_eq(json-object-get(knownBefore,"check"),json-object-get(json-object-get(pair,"before"),"check")),value_eq(fcap-native-submission-admitted(pending,"{\"report\":\"different\"}"),pending))));
   let knownResume = fcap-begin-context(fcam-unpack(bytes_to_recipe(recipe_to_bytes(fcam-pack(known)))));
   fnrrb-assert("bootstrap and resumed contexts carry the complete rejected report",and(value_eq(json-object-get(fcap-observation-node(known),"native_review"),pair),and(value_eq(json-object-get(fcap-observation-node(knownResume),"native_review"),pair),eq(fcap-context-native-submission(knownResume),0))));
   fnrrb-assert("continuation carries paired evidence instead of a stale current failure",and(not(json-object-has?(packet,"failure_evidence")),and(str_eq(fcap-string(json-object-get(pair,"before"),"report"),"wrong"),str_eq(fcap-string(json-object-get(pair,"after"),"report"),"correct"))));
   fnrrb-assert("failed observation keeps the evidence owed",and(value_eq(fcap-observation-admitted(pending,0,0,1),pending),value_eq(fcap-observation-admitted(pending,0,1,0),pending)));
   let admitted = fcap-observation-admitted(pending,0,1,1);
   let compact = parse-json("admitted",fcap-observation(admitted));
   fnrrb-assert("successful admission references retained evidence and instruction",and(not(json-object-has?(compact,"native_review")),and(eq(json-int-value(json-object-get(compact,"native_review_reference")),1),lt(str_len(fcap-string(compact,"instruction")),str_len(fcap-work-instruction(admitted))))));
   let another = fcap-step(admitted,"{\"report\":\"wrong\"}",append(base,list(fnrrb-continue,list())));
   fnrrb-assert("a later native repair owes a new evidence packet",and(eq(len(fcap-native-repairs(another)),2),and(eq(fcap-context-native-review(another),1),json-object-has?(parse-json("another",fcap-observation(another)),"native_review"))));
   let restored = fcap-begin-context(fcam-unpack(bytes_to_recipe(recipe_to_bytes(fcam-pack(admitted)))));
   let bootstrap = fcap-observation-node(restored);
   fnrrb-assert("renewed context restores full evidence and continuation instruction",and(value_eq(json-object-get(bootstrap,"native_review"),pair),and(str_eq(fcap-string(bootstrap,"instruction"),fcap-native-review-instruction()),value_eq(fcap-native-repairs(restored),fcap-native-repairs(pending)))));
   let finished = fcap-step(admitted,"{\"report\":\"correct\"}",append(base,list(fnrrb-bomb,list())));
   fnrrb-assert("resident final report reruns the same checker with distinct attribution",and(str_eq(fcap-stage(finished),"complete"),and(eq(fcap-checks(finished),3),and(str_eq(fcap-report-source(finished),"submitted"),value_eq(fcap-native-repairs(finished),fcap-native-repairs(pending))))));
   let continuationFailed = fcap-step(initial,"{\"report\":\"wrong\"}",append(base,list(fnrrb-continue-failed,list())));
   fnrrb-assert("failed continuation candidate returns to ordinary repair",and(str_eq(fcap-stage(continuationFailed),"repair"),and(not(fcap-awaiting-native-review(continuationFailed)),eq(fcap-checks(continuationFailed),2))));
   let continuationDeclined = fcap-step(initial,"{\"report\":\"wrong\"}",append(base,list(fnrrb-continue-declined,list())));
   let continuationSame = fcap-step(initial,"{\"report\":\"wrong\"}",append(base,list(fnrrb-continue-same,list())));
   fnrrb-assert("declined or unchanged continuation cannot claim verified readiness",and(not(fcap-awaiting-native-review(continuationDeclined)),and(not(fcap-awaiting-native-review(continuationSame)),and(eq(fcap-checks(continuationDeclined),1),eq(fcap-checks(continuationSame),1)))));
   let badRoute = fcap-step(initial,"{\"report\":\"wrong\"}",append(base,list(fnrrb-bad-route,list())));
   fnrrb-assert("unknown continuation route cannot complete",and(str_eq(fcap-stage(badRoute),"attention"),eq(fcap-checks(badRoute),1)));
   print(list("native-review-repair-checks",35));
   34359738367;
  }
 }
 fnrrb-run();
}
