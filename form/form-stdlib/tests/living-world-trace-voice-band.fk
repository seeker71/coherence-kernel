; living-world-trace-voice-band.fk -- an experienced relation speaks only
; through independently learned surfaces and never resolves ambiguity itself.
; Verdict 32767 proves fifteen native voice, optionality, and revocation claims.
; witnessed: 2026-08-08 -> 32767 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-trace-relation.fk form-stdlib/living-world-trace-voice.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-trace-relation-witness.fk form-stdlib/tests/living-world-trace-voice-witness.fk

(do
    (let world (lwtrvw-world))
    (let edge (lwtrw-edge-candidate))
    (let relation (lwo-emergent-shape edge))
    (let primary-plan
        (lwtv-plan-for world edge (lwtrvw-primary-symbols)))
    (let alternate-plan
        (lwtv-plan-for world edge (lwtrvw-alternate-symbols)))
    (let missing-plan
        (lwtv-plan-for world edge (lwo-empty-field)))
    (let ambiguous-plan
        (lwtv-plan-for world edge (lwtrvw-ambiguous-symbols)))
    (let proposal (lwtrvw-proposal))
    (let candidate (lwt-proposal-candidate proposal))
    (let utterance (lwtrvw-utterance))
    (let rich (lwtrvw-rich-utterance))
    (let waiting
        (lwtv-integrate (lwtrvw-round) proposal (lwtrw-action)))
    (let integrated-world (lwtrvw-integrated-world))
    (let revoked (lwtrvw-revoked-world))
    (let primary-items
        (lwtv-sequence-items (lwtv-plan-sequence primary-plan)))

    (let c1
        (if (and (eq (lwtr-edge-integrated-current? world edge) 1)
                 (and (eq (lwsl-integrated-current? world
                            (lwo-relation-subject relation)) 1)
                      (eq (lwsl-integrated-current? world
                            (lwo-relation-object relation)) 1))) 1 0))
    (let c2
        (if (and (eq (lwsl-integrated-current?
                         world (lwtrvw-primary-symbol)) 1)
                 (and (eq (lwsl-integrated-current?
                              world (lwtrvw-alternate-symbol)) 1)
                      (and (eq (lwnv-symbol-positioned?
                                  (lwo-emergent-shape
                                    (lwtrvw-primary-symbol))) 0)
                           (node_eq
                              (lwnv-symbol-referent
                                (lwo-emergent-shape
                                  (lwtrvw-primary-symbol)))
                              (lwo-relation-predicate relation))))) 2 0))
    (let c3
        (if (and (eq (lwtv-ready?
                         (lwtv-plan-status primary-plan)) 1)
                 (and (eq (len primary-items) 3)
                      (and (node_eq (nth primary-items 0)
                              (lwo-relation-subject relation))
                           (and (node_eq (nth primary-items 1)
                                  (lwtrvw-primary-symbol))
                                (node_eq (nth primary-items 2)
                                  (lwo-relation-object relation)))))) 4 0))
    (let c4
        (if (str_eq (lwtv-utterance-surface utterance)
                     "seed becomes forty-nine") 8 0))
    (let c5
        (if (and (eq (lwtv-ready?
                         (lwtv-plan-status alternate-plan)) 1)
                 (str_eq (lwtv-render alternate-plan)
                          "seed yields forty-nine")) 16 0))
    (let c6
        (if (and (eq (lwtv-incomplete?
                         (lwtv-plan-status missing-plan)) 1)
                 (and (eq (lwo-field-size
                              (lwtv-plan-alternatives missing-plan)) 0)
                      (and (eq (lwlc-unknown?
                                  (lwtv-plan-unknown missing-plan)) 1)
                           (node_eq
                              (lwtv-emit world edge (lwo-empty-field)
                                (lwo-empty-field) (lwo-none) (lwo-none)
                                (lwtrw-evidence))
                              (lwo-none))))) 32 0))
    (let c7
        (if (and (eq (lwtv-ambiguous?
                         (lwtv-plan-status ambiguous-plan)) 1)
                 (and (eq (lwo-field-size
                              (lwtv-plan-alternatives ambiguous-plan)) 2)
                      (and (node_eq
                              (lwtv-plan-unknown ambiguous-plan)
                              (lwo-none))
                           (node_eq
                              (lwtv-emit world edge
                                (lwtrvw-ambiguous-symbols)
                                (lwo-empty-field) (lwo-none) (lwo-none)
                                (lwtrw-evidence))
                              (lwo-none))))) 64 0))
    (let c8
        (if (and (node_eq (lwtv-plan-view primary-plan) (lwo-none))
                 (node_eq
                    (lwtv-plan-relation-uncertainty primary-plan)
                    (lwtr-edge-uncertainty relation))) 128 0))
    (let c9
        (if (and (eq (lwo-field-size
                         (lwtv-utterance-alternatives rich)) 1)
                 (and (eq (lwlc-unknown?
                              (lwtv-utterance-unknown rich)) 1)
                      (node_eq (lwtv-utterance-choice rich)
                               (lwtrw-choice)))) 256 0))
    (let c10
        (if (and (eq (lwo-field-size
                         (lwtv-utterance-witnesses utterance)) 14)
                 (eq (lwo-field-size
                         (lwt-proposal-participants proposal)) 8)) 512 0))
    (let c11
        (if (and (eq (lwtv-plan-current? world primary-plan) 1)
                 (and (eq (lwtv-utterance-current? world utterance) 1)
                      (eq (lwtv-proposal-current? world proposal) 1)))
            1024 0))
    (let c12
        (if (eq (lwo-world-has?
                    (lwt-round-world waiting) candidate) 0) 2048 0))
    (let c13
        (if (and (eq (lwo-active? integrated-world candidate) 1)
                 (eq (lwo-field-size
                         (lwo-active-attributions-for
                            integrated-world candidate)) 8)) 4096 0))
    (let c14
        (if (and (eq (lwtv-utterance-current?
                         integrated-world utterance) 1)
                 (eq (lwtv-proposal-current?
                         integrated-world proposal) 1)) 8192 0))
    (let c15
        (if (and (eq (lwtr-edge-integrated-current? revoked edge) 0)
                 (and (eq (lwtv-utterance-current? revoked utterance) 0)
                      (and (eq (lwtv-proposal-current?
                                  revoked proposal) 0)
                           (node_eq
                              (lwtv-plan-for revoked edge
                                (lwtrvw-primary-symbols))
                              (lwo-none))))) 16384 0))

    (lwtrw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
