; jit-leaf-inram-band.fk — the Form lane closes: the body lowers its own arm64
; and the body runs it.
;
; WHAT WAS MISSING. form-lower.fk emits arm64 leaf images. The EXECUTOR lived only on the Go
; sibling (jit_inram_darwin_arm64.go's `jit_leaf_inram`), so fkwu could compile
; its own native code and had nowhere to put it. This door is that half, with the
; contract Go states: (image arg) -> int64, image a list of bytes.
;
; WHY IT MATTERS MORE THAN THE u32 DOOR. jit_arm64_u32_leaf is a C emitter over
; five tags and 32-bit values — a wall in its design. Here the EMITTER IS FORM:
; growing coverage is growing a Form recipe, and the ABI is int64 f(int64). The
; 32-bit ceiling that remains is form-lower's w-register choice, which is a Form
; change, not a kernel one — measured and named, not assumed: f(2000000000)
; answers 1705032711 where the walker says 6000000007, and the difference is
; exactly 2^32. The bottom of the domain no longer bites: form-lower's epilogue
; sign-extends (lo-sign), so g(0) = (0-4)*5 answers -20, the walker's number
; (it answered 4294967276, the same word zero-extended, until 2026-10-04). The
; wall that remains is the top and the bottom of a signed 32-bit word, and every
; claim below stays inside it on purpose, so nobody meets the wall as a cache
; fault the way this band's first run did.
;
; The carrier keeps its page, keyed on the image BYTES — content, not the cons
; value the collector moves — so two callers that lower the same recipe share one
; crystallization. The Go door mmaps and unmaps per call; this one does not.
;
; PROOF LEVEL: FOURTH-ARM ONLY — jit_leaf_inram binds on go too (pf-arm-mask 9, probed 2026-09-03) and go dies SIGILL on this band (witnessed). Under the
; three siblings the name folds to `nothing` and every claim below would read
; green while proving nothing.
;
; Verdict 63.
;
; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk

(do
    (defn jli-score (ok bit) (if ok bit 0))
    ; f(n) = n*3 + 7 — the prog whose arm64 image is lowered below
    (defn jli-prog () (list (list 1 7) (list 2) (list 1 3) (list 5 1 2) (list 3 3 0)))
    (defn jli-f (n) (add (mul n 3) 7))
    ; g(n) = (n - 4) * 5
    (defn jli-prog2 () (list (list 2) (list 1 4) (list 4 0 1) (list 1 5) (list 5 2 3)))
    (defn jli-g (n) (mul (sub n 4) 5))
    (defn jli-agree (img i n bad)
        (if (ge i n) bad
            (jli-agree img (add i 1) n
                (add bad (if (eq (jit_leaf_inram img i) (jli-f i)) 0 1)))))
    ; alternating two images displaces any single-entry shortcut on every call
    (defn jli-alt (a b i n bad)
        (if (ge i n) bad
            (jli-alt a b (add i 1) n
                (add bad (add (if (eq (jit_leaf_inram a i) (jli-f i)) 0 1)
                              (if (eq (jit_leaf_inram b i) (jli-g i)) 0 1))))))
    (defn jit-leaf-inram-band ()
        (do
    (let img (lo-compile-fn (jli-prog) 4))
    (let img2 (lo-compile-fn (jli-prog2) 4))
    ; Form lowered a leaf image — twenty-four bytes: the mov that banks the argument, movz + mul + add, the
    ; sign-extend of the answer (lo-sign) and a ret
    (let c0 (jli-score (eq (len img) 24) 1))
    ; and the body RAN it
    (let c1 (jli-score (eq (jit_leaf_inram img 5) 22) 2))
    ; agreeing with the walker across a range
    (let c2 (jli-score (eq (jli-agree img 0 400 0) 0) 4))
    ; a second, differently-shaped recipe lowers and runs from the same door
    (let c3 (jli-score (eq (jit_leaf_inram img2 9) 25) 8))
    ; and the crystallization never answers for the wrong image, however hard
    ; the two are interleaved
    ; from 0: g(n) = (n-4)*5 goes NEGATIVE below 4, and the page answers the walker's
    ; negative number (lo-sign), so the interleaving now crosses zero too
    (let c4 (jli-score (eq (jli-alt img img2 0 204 0) 0) 16))
    ; a malformed image is DECLINED, not run — three bytes is not an instruction
    (let c5 (jli-score (nothing? (jit_leaf_inram (list 1 2 3) 0)) 32))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
    )
    (jit-leaf-inram-band))
