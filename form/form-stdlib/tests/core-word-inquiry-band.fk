; core-word-inquiry-band.fk — lower/UPPER deictic scope and the complete
; nothing/0/1/node request acknowledgement.
; import "form-stdlib/core-word-inquiry.fk"

(do
    (defn cwi-band-bit (condition bit) (if condition bit 0))
    (defn cwi-band-sum (values)
        (if (eq (len values) 0) 0
            (add (head values) (cwi-band-sum (tail values)))))

    (let lens (cwi-lens 3 4 5 6))
    (let changed-lens (cwi-lens 4 4 5 6))
    (let request (cwi-request-node "WE" "we" "WHY" 17 lens 1))
    (let changed-time (cwi-request-node "WE" "we" "WHY" 18 lens 1))
    (let changed-point
        (cwi-request-node "WE" "we" "WHY" 17 changed-lens 1))
    (let changed-case (cwi-request-node "we" "we" "WHY" 17 lens 1))
    (let timed (cwi-settle "I" "i" "when" 7 lens 0 1))
    (let excluded (cwi-settle "i" "I" "when" 7 lens 1 1))
    (let declined (cwi-settle "I" "i" "when" 7 lens 1 0))
    (let when-proof (cwi-settle "I" "i" "when" 7 lens 1 1))
    (let where-proof (cwi-settle "YOU" "you" "WHERE" 8 lens 1 1))
    (let what-proof (cwi-settle "WE" "we" "what" 9 lens 1 1))
    (let how-proof (cwi-settle "DO" "do" "how" 10 lens 1 1))
    (let why-proof (cwi-settle "EXIST" "exist" "WHY" 11 lens 1 1))
    (let invalid (cwi-settle "maybe" "i" "when" 7 lens 1 1))

    ; 2147483647 means all 31 observations held.
    (cwi-band-sum
        (list
            (cwi-band-bit (eq (len (cwi-core-words)) 8) 1)
            (cwi-band-bit (eq (len (cwi-inquiry-words)) 5) 2)
            (cwi-band-bit (eq (cwi-word-nodes-geometric?) 1) 4)
            (cwi-band-bit (eq (cwi-word-node "i") 2) 8)
            (cwi-band-bit (eq (cwi-word-node "WHY") 25769803779) 16)
            (cwi-band-bit (eq (cwi-scope-allows? "i" "I") 0) 32)
            (cwi-band-bit (eq (cwi-scope-allows? "I" "i") 1) 64)
            (cwi-band-bit (eq (cwi-scope-allows? "I" "I") 1) 128)
            (cwi-band-bit (eq (cwi-scope-allows? "WE" "us") 0) 256)
            (cwi-band-bit (eq (cwi-request-node? request) 1) 512)
            (cwi-band-bit (eq (cwi-r-scope-slot request) 7) 1024)
            (cwi-band-bit (eq (cwi-r-offered-slot request) 6) 2048)
            (cwi-band-bit (eq (cwi-r-inquiry-slot request) 9) 4096)
            (cwi-band-bit (eq (cwi-r-time request) 17) 8192)
            (cwi-band-bit (eq (cwi-r-point request) 3) 16384)
            (cwi-band-bit (eq (cwi-r-inner request) 1) 32768)
            (cwi-band-bit
                (and (not (eq request changed-time))
                    (and (not (eq request changed-point))
                         (not (eq request changed-case)))) 65536)
            (cwi-band-bit
                (and (eq (cwi-o-kind timed) (cwi-tag-nothing))
                     (eq (cwi-o-reason timed) 2)) 131072)
            (cwi-band-bit
                (and (eq (cwi-o-kind excluded) (cwi-tag-zero))
                     (eq (cwi-o-reason excluded) 3)) 262144)
            (cwi-band-bit
                (and (eq (cwi-o-kind declined) (cwi-tag-zero))
                     (eq (cwi-o-reason declined) 4)) 524288)
            (cwi-band-bit
                (eq (cwi-o-kind when-proof) (cwi-tag-one)) 1048576)
            (cwi-band-bit
                (eq (cwi-o-kind where-proof) (cwi-tag-one)) 2097152)
            (cwi-band-bit
                (eq (cwi-o-kind what-proof) (cwi-tag-node)) 4194304)
            (cwi-band-bit
                (eq (cwi-o-kind how-proof) (cwi-tag-node)) 8388608)
            (cwi-band-bit
                (eq (cwi-o-kind why-proof) (cwi-tag-node)) 16777216)
            (cwi-band-bit
                (and (eq (cwi-kind? (cwi-o-kind timed)) 1)
                    (and (eq (cwi-kind? (cwi-o-kind excluded)) 1)
                    (and (eq (cwi-kind? (cwi-o-kind when-proof)) 1)
                    (and (eq (cwi-kind? (cwi-o-kind what-proof)) 1)
                         (eq (cwi-o-node what-proof)
                             (cwi-request-node
                                "WE" "we" "what" 9 lens 1)))))) 33554432)
            (cwi-band-bit
                (and (eq (cwi-o-kind invalid) (cwi-tag-nothing))
                     (eq (cwi-o-reason invalid) 1)) 67108864)
            (cwi-band-bit
                (eq (cwi-request-node
                        "i" "i" "when" 0 (cwi-lens 0 0 0 0) 0)
                    644) 134217728)
            (cwi-band-bit
                (eq (sub (cwi-word-node "you") (cwi-word-node "i"))
                    (cwi-root-stride)) 268435456)
            (cwi-band-bit
                (eq (sub (cwi-word-node "I") (cwi-word-node "i")) 1) 536870912)
            (cwi-band-bit
                (gt (cwi-cross-root-distance-min)
                    (cwi-request-detail-max)) 1073741824))))
