; grok-host-learn-band.fk — a host turn can enter the learner.
; Verdict 15:
;   1   it can
;   2   public pair records as supervised-answer
;   4   route is grok-host
;   8   replay of the same pair is the same directory
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/json.fk
; preludes: form-stdlib/native-session-memory.bml
; preludes: form-stdlib/grok-host-learn.fk
; witnessed: 2026-09-10 -> 15
; Band writes only a temp home.

(do
    (defn ghlb-bit (ok bit) (if ok bit 0))
    (let home (str_concat (fs-temp-dir) (str_concat "/fk-grok-host-learn-" (int_to_str (host_pid)))))
    (let path "form/form-stdlib/tests/fixtures/grok-host-pair.json")
    (let dir (ghl-record home path))
    (let again (ghl-record home path))
    (add (ghlb-bit (eq (ghl-can) 1) 1)
    (add (ghlb-bit (str_eq (ghl-objective home dir) "supervised-answer") 2)
    (add (ghlb-bit (str_eq (nsm-str (nsm-json (nsm-at dir "record.json")) "route") "grok-host") 4)
         (ghlb-bit (str_eq dir again) 8)))))
