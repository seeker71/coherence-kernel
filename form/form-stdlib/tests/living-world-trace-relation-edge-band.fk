; living-world-trace-relation-edge-band.fk -- outside witnesses may admit an
; exact trace-derived relation while dissent and revocation remain effective.
; Verdict 32767 proves fifteen attestation/edge/currentness claims.
; witnessed: 2026-08-08 -> 32767 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-trace-relation.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-trace-relation-witness.fk

(do
    (let candidate (lwtrw-hypothesis-candidate))
    (let hypothesis (lwtrw-hypothesis))
    (let two-world (lwtrw-two-attestation-world))
    (let two-set (lwtr-attestations-for two-world candidate))
    (let edge-proposal (lwtrw-edge-proposal))
    (let edge-candidate (lwtrw-edge-candidate))
    (let edge (lwo-emergent-shape edge-candidate))
    (let silence-world (lwtrw-silence-world))
    (let silence-candidate
        (lwtr-edge-candidate-for silence-world candidate 2))
    (let silence-uncertainty
        (lwtr-edge-uncertainty
            (lwo-emergent-shape silence-candidate)))
    (let alternative-world (lwtrw-alternative-world))
    (let alternative-candidate
        (lwtr-edge-candidate-for alternative-world candidate 2))
    (let alternative-uncertainty
        (lwtr-edge-uncertainty
            (lwo-emergent-shape alternative-candidate)))
    (let dissent-set
        (lwtr-attestations-for (lwtrw-dissent-world) candidate))
    (let revoked (lwtrw-revoked-world))

    (let c1
        (if (eq (lwtr-attestation-current?
                    (lwtrw-self-world) (lwtrw-self-attestation)) 0) 1 0))
    (let c2
        (if (and (eq (lwtr-support-count
                         (lwtr-attestations-for
                            (lwtrw-one-attestation-world) candidate)) 1)
                 (node_eq
                    (lwtrw-edge-proposal-for
                        (lwtrw-one-attestation-world))
                    (lwo-none))) 2 0))
    (let c3
        (if (and (eq (lwtr-support-count two-set) 2)
                 (and (eq (lwtr-dissent-count two-set) 0)
                      (eq (lwtr-edge-candidate? edge-candidate) 1))) 4 0))
    (let c4
        (if (and (node_eq (lwo-relation-subject edge)
                          (lwtrw-left-symbol))
                 (and (node_eq (lwo-relation-predicate edge)
                               (lwtr-hypothesis-relation hypothesis))
                      (node_eq (lwo-relation-object edge)
                               (lwtrw-right-symbol)))) 8 0))
    (let c5
        (if (and (node_eq (lwtr-edge-provenance edge) candidate)
                 (and (node_eq (lwtr-edge-evidence edge) two-set)
                      (eq (lwtr-attestation-set?
                            (lwtr-edge-evidence edge)) 1))) 16 0))
    (let c6
        (if (and (eq (lwo-emergent-coherence edge-candidate) 2)
                 (and (eq (lwo-emergent-threshold edge-candidate) 2)
                      (eq (lwtr-edge-candidate-current?
                            two-world edge-candidate) 1))) 32 0))
    (let c7
        (if (eq (lwo-field-size
                    (lwt-proposal-participants edge-proposal)) 8) 64 0))
    (let c8
        (if (and (eq (lwtr-edge-integrated-current?
                         (lwtrw-edge-world) edge-candidate) 1)
                 (eq (lwo-active?
                         (lwtrw-edge-world) edge-candidate) 1)) 128 0))
    (let c9
        (if (and (eq (lwtr-edge-candidate? silence-candidate) 1)
                 (and (eq (lwtr-attestation-source-count
                              (lwtr-attestation-silences
                                (lwtr-edge-evidence
                                  (lwo-emergent-shape silence-candidate)))) 1)
                      (eq (lwo-field-size
                             (lwtr-uncertainty-attestation-unknowns
                               silence-uncertainty)) 1))) 256 0))
    (let c10
        (if (and (eq (lwtr-edge-candidate? alternative-candidate) 1)
                 (and (eq (lwo-field-size
                              (lwtr-uncertainty-attestation-alternatives
                                alternative-uncertainty)) 1)
                      (eq (lwo-field-size
                             (lwtr-uncertainty-attestation-unknowns
                               alternative-uncertainty)) 1))) 512 0))
    (let c11
        (if (and (eq (lwtr-dissent-count dissent-set) 1)
                 (node_eq
                    (lwtrw-edge-proposal-for (lwtrw-dissent-world))
                    (lwo-none))) 1024 0))
    (let c12
        (if (and (node_eq
                    (lwtrw-edge-proposal-for
                        (lwtrw-hypothesis-world))
                    (lwo-none))
                 (eq (lwo-field-size
                         (lwtr-attestation-supports
                            (lwtr-attestations-for
                                (lwtrw-hypothesis-world) candidate))) 0))
            2048 0))
    (let c13
        (if (and (eq (lwtr-hypothesis-integrated-current?
                         revoked candidate) 0)
                 (eq (lwtr-edge-integrated-current?
                         revoked edge-candidate) 0)) 4096 0))
    (let c14
        (if (and (eq (lwo-active? revoked edge-candidate) 1)
                 (and (eq (lwo-active? revoked candidate) 1)
                      (and (eq (lwo-world-has?
                                 revoked (lwtrw-minimal-offer)) 1)
                           (eq (lwo-active?
                                 revoked (lwtrw-minimal-offer)) 0))))
            8192 0))
    (let c15
        (if (and (eq (lwo-relation? edge) 1)
                 (and (eq (lwtr-relation?
                              (lwo-relation-predicate edge)) 1)
                      (eq (lwtr-uncertainty?
                            (lwtr-edge-uncertainty edge)) 1)))
            16384 0))
    (lwtrw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
