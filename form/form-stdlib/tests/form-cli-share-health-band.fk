; form-cli-share-health-band — typed share states and exact failed checks.
; Expected: 16383
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk
; preludes: form-stdlib/form-cli-turn-evidence.fk
; preludes: form-stdlib/form-cli-turn-evidence-live.fk
; preludes: form-stdlib/bml/form-cli-share-health.bml

(do
    (defn fcshb-bit (ok bit) (if ok bit 0))
    (let valid-row
        "turn-evidence-v1|thread-1|turn-1|openai|gpt-test|1000|2000|1000|100|128|2|1000|600|400|0|200|50|1200|3|3|400|2048|2|1|100|20|120|1|0|2|2|5|1|codex-rollout-jsonl+explicit-form-binding|1")
    (let invalid-row
        "turn-evidence-v1|thread-1|turn-1|openai|gpt-test|1000|2000|999|100|128|2|1000|600|400|0|200|50|1200|3|2|400|2048|2|1|100|20|120|1|0|2|2|5|1|codex-rollout-jsonl+explicit-form-binding|1")
    (let progress-row (fctel-progress-row
        100 "turn-7" 10 80 42 (fctel-state)))
    (let progress (fcsh-progress (split-on progress-row "|") 100))
    (let start-row
        "turn-evidence-start-discovery-v1|100|turn-7|80|40|-1|thread-7|openai")
    (let validation-row
        "turn-evidence-latest-validation-v1|thread-7|turn-7|80|70|120|90|openai|gpt-test")
    (let validation-v2-row
        "turn-evidence-latest-validation-v2|thread-7|turn-7|80|70|140|130|openai|gpt-test|120")
    (let failure (fcsh-candidate valid-row))
    (let bad (fcsh-candidate invalid-row))
    (let src (read_file "form/form-stdlib/bml/form-cli-share-health.bml"))
    ; A stale start row and a current discovery row can coexist after an
    ; interrupted older implementation.  Only the row whose carrier identity
    ; and task coordinates still exist may own the displayed phase.
    (let phase-path "/tmp/form-cli-share-health-phase-band.jsonl")
    (let phase-meta "{\"session_id\":\"root-decoy\",\"model_provider\":\"root-decoy\",\"type\":\"session_meta\",\"payload\":{\"session_id\":\"thread-7\",\"model_provider\":\"openai\"}}\n")
    (let phase-start "{\"timestamp\":\"2026-08-17T05:42:26.000Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"task_started\",\"turn_id\":\"turn-7\"}}\n")
    (let phase-complete "{\"timestamp\":\"2026-08-17T05:42:27.000Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"turn_finished\",\"turn_id\":\"turn-7\",\"last_agent_message\":\"done\"}}\n")
    (let phase-write (write_file_text phase-path
        (fctel-join (list phase-meta phase-start phase-complete))))
    (let phase-size (file_size phase-path))
    (let phase-start-at (str_len phase-meta))
    (let phase-complete-at (add phase-start-at (str_len phase-start)))
    (let current-start (fctel-start-discovery-row phase-path phase-size
        "turn-7" phase-complete-at phase-complete-at phase-start-at))
    (let stale-start
        "turn-evidence-start-discovery-v1|100|turn-stale|80|40|-1|thread-stale|openai")
    (let current-discovery (fctel-discovery-row phase-path phase-size
        phase-complete-at))
    (let reconciled-current (fcsh-health-state-reconciled phase-path ""
        current-start "" current-discovery ""))
    (let reconciled-stale (fcsh-health-state-reconciled phase-path ""
        stale-start "" current-discovery ""))
    (sum (list
        (fcshb-bit (str_eq (fcsh-rule)
            "absent-measuring-error-and-observed-are-distinct-share-states") 1)
        (fcshb-bit (ge (str_find progress "measurement-health=Measuring" 0) 0) 2)
        (fcshb-bit (ge (str_find progress "cursor-byte=42" 0) 0) 4)
        (fcshb-bit (ge (str_find progress "stream-bytes=100" 0) 0) 8)
        (fcshb-bit (ge (str_find failure "shape=1 numeric=1" 0) 0) 16)
        (fcshb-bit (and (ge (str_find bad "time=0" 0) 0)
            (ge (str_find bad "tools=0" 0) 0)) 32)
        (fcshb-bit (ge (str_find (fcsh-discovery (list
            "turn-evidence-discovery-v2" "100" "40" "thread-7" "openai"))
            "phase=discovering" 0) 0) 64)
        (fcshb-bit (and (ge (str_find src "section [form.bml]" 0) 0)
            (eq (str_find src "xtal" 0) -1)) 128)
        (fcshb-bit (ge (str_find (fcsh-health-state "/tmp/fcsh-absent"
            progress-row "" "" "" invalid-row) "phase=collecting" 0) 0) 256)
        (fcshb-bit (ge (str_find (fcsh-health-state "/tmp/fcsh-absent"
            "" start-row "" "" invalid-row) "phase=locating-start" 0) 0) 512)
        (fcshb-bit (ge (str_find (fcsh-health-state "/tmp/fcsh-absent"
            "" "" validation-row "" invalid-row)
            "phase=validating-latest" 0) 0) 1024)
        (fcshb-bit (and (ge (str_find (fcsh-validation
            (split-on validation-row "|"))
            "append-bytes=40 checked-bytes=30 remaining-bytes=10" 0) 0)
            (and (ge (str_find (fcsh-after-refresh
                    "turn-evidence-refresh=observed\n")
                    "phase=validating-latest" 0) 0)
                (ge (str_find (fcsh-after-refresh
                    "turn-evidence-refresh=observed\n")
                    "reason=append-range-not-yet-checked" 0) 0))) 2048)
        (fcshb-bit (and (eq (fcsh-validation-shape?
                (split-on validation-v2-row "|")) 1)
            (ge (str_find (fcsh-validation (split-on validation-v2-row "|"))
                "append-bytes=60 checked-bytes=50 remaining-bytes=10" 0) 0))
            4096)
        (fcshb-bit (and (ge (str_find reconciled-current
                "phase=locating-start" 0) 0)
            (ge (str_find reconciled-stale "phase=discovering" 0) 0))
            8192))))
