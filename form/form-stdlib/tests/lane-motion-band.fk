; lane-motion-band.fk — the glass's substrate census and sibling count, read in Form from the tree and the host's own process table.
; The census once ran `find | wc | tr` three times through a shell and the sibling count `pgrep -fl fkwu`; both are Form now
; (lms-census-dir over fs_list / fs_is_dir / file_mtime / host_realpath, lms-siblings over host_processes). Nothing foreign runs here.
;
;   1     the census of a tree the band makes: .fkb files counted (ice), those written within the hour counted again (water; one is set a
;         year back with host_utimes), .fk and .bml counted (src), a nested directory and a nested .git walked, the checkout's own top-level
;         .git left out, other suffixes and an empty directory counting nothing: ice=4 water=3 src=3 by hand
;   2     lms-census-text spells "ice=I water=W src=S" (the glass reads the three by name), and the live census of this checkout reads
;         the same three keys with ice at least water
;   4     a symlink is not followed: a directory linked back to the tree's root, and a directory linked to another tree, leave the counts exactly as
;         they were (find does not follow either)
;   8     suffixes: lms-ends? tells ".fkb" from "x.fkb.bak", ".fk" from ".fkx", and a name shorter than its suffix
;   16    siblings: lms-siblings-of is the images beside this one (0 for none or for one, n-1 beyond); the live count is one less than the
;         number of fkwu images the host lists, and this process is one of them
;   32    the depth bound stands as a number and a deeper-than-bound chain of directories the band makes is not entered past it
;
; The band's scratch tree is made under host_temp_dir() and removed (recursively) at the end, whatever failed.
; Expected: 63
; Verdict 63
; REQUIRES: the host doors host_realpath host_utimes host_symlink host_processes (seed doors; the sibling kernels carry no host doors)
; preflight-exec: forbidden
; preludes: form-stdlib/lane-motion.bml
(do
    (defn lb-bit (ok bit) (if ok bit 0))
    (defn lb-dir () (str_concat (host_temp_dir) (str_concat "/lane-motion-band-" (int_to_str (host_pid)))))
    (defn lb-sub (d name) (str_concat d (str_concat "/" name)))
    (defn lb-file (d name) (write_file (lb-sub d name) "x"))
    (defn lb-make (d)
        (do
            (let c0 (host_dir_rmdir d))
            (let c1 (host_dir_mkdir d))
            (let c2 (host_dir_mkdir (lb-sub d "sub")))
            (let c3 (host_dir_mkdir (lb-sub d (str_concat "sub" "/deeper"))))
            (let c4 (host_dir_mkdir (lb-sub d ".git")))
            (let c5 (host_dir_mkdir (lb-sub d (str_concat "sub" "/.git"))))
            (let c6 (host_dir_mkdir (lb-sub d "emptydir")))
            (let f1 (lb-file d "a.fkb"))
            (let f2 (lb-file d "b.fkb"))
            (let f3 (lb-file d "c.fk"))
            (let f4 (lb-file d "d.bml"))
            (let f5 (lb-file d "e.txt"))
            (let f6 (lb-file d "sub/f.fkb"))
            (let f7 (lb-file d "sub/deeper/g.bml"))
            (let f8 (lb-file d ".git/h.fkb"))
            (let f9 (lb-file d "sub/.git/i.fkb"))
            (let old (host_utimes (lb-sub d "b.fkb") 1700000000123))
            old))
    (defn lb-census (d) (lms-census-dir d 0 (div (now_unix_ms) 1000)))
    (defn lb-same3 (a b) (and (eq (nth a 0) (nth b 0)) (and (eq (nth a 1) (nth b 1)) (eq (nth a 2) (nth b 2)))))
    ; this process is one of the fkwu images the host lists
    (defn lb-listed? (rows)
        (if (eq (len rows) 0) false
            (if (eq (head (head rows)) (host_pid)) true (lb-listed? (tail rows)))))
    ; a chain of directories one deeper than the bound, a .bml file at every level: the walk stops at the bound
    (defn lb-chain (d depth)
        (if (le depth 0) 0
            (do
                (let f (lb-file d "k.bml"))
                (let m (host_dir_mkdir (lb-sub d "n")))
                (lb-chain (lb-sub d "n") (sub depth 1)))))
    (defn lb-deep (d)
        (do
            (let root (lb-sub d "chain"))
            (let m (host_dir_mkdir root))
            (let built (lb-chain root 45))
            (let sub (lms-census-dir root 0 (div (now_unix_ms) 1000)))
            ; src counts one .bml a level; the walk enters at most the bound's levels, so it stays under the 45 built
            (list (nth sub 0) (nth sub 1) (if (and (ge (nth sub 2) 1) (le (nth sub 2) (add (lms-census-depth) 1))) 2 0))))
    (defn lb-claims (d)
        (do
            (let made (lb-make d))
            (let base (lb-census d))
            (let other (str_concat d "-other"))
            (let o1 (host_dir_mkdir other))
            (let o2 (lb-file other "z.fkb"))
            (let l1 (host_symlink d (lb-sub d "sub/backlink")))
            (let l2 (host_symlink other (lb-sub d "outside")))
            (let linked (lb-census d))
            (let live (lms-census))
            (let deep (lb-deep d))
            (let rows (hearth-fkwu-rows))
            (let c1 (lb-bit (and (eq made 0) (and (eq (nth base 0) 4) (and (eq (nth base 1) 3) (eq (nth base 2) 3)))) 1))
            (let c2 (lb-bit (and (str_eq (lms-census-text base) "ice=4 water=3 src=3")
                    (and (str_eq (lms-census-text (list 0 0 0)) "ice=0 water=0 src=0")
                    (and (ge (str_find live "ice=" 0) 0)
                    (and (ge (str_find live " water=" 0) 0)
                    (and (ge (str_find live " src=" 0) 0)
                         (ge (fmv-field live "ice") (fmv-field live "water"))))))) 2))
            (let c4 (lb-bit (and (eq l1 0) (and (eq l2 0) (lb-same3 base linked))) 4))
            (let c8 (lb-bit (and (lms-ends? "a.fkb" ".fkb")
                    (and (not (lms-ends? "x.fkb.bak" ".fkb"))
                    (and (lms-ends? "m.fk" ".fk")
                    (and (not (lms-ends? "m.fkx" ".fk"))
                    (and (not (lms-ends? "k" ".fkb"))
                         (lms-ends? ".bml" ".bml")))))) 8))
            (let c16 (lb-bit (and (eq (lms-siblings-of 0) 0)
                    (and (eq (lms-siblings-of 1) 0)
                    (and (eq (lms-siblings-of 5) 4)
                    (and (ge (len rows) 1)
                    (and (eq (lms-siblings) (sub (len rows) 1))
                         (lb-listed? rows)))))) 16))
            (let c32 (lb-bit (and (eq (lms-census-depth) 40) (eq (nth deep 2) 2)) 32))
            (let gone (host_dir_rmdir d))
            (let gone2 (host_dir_rmdir other))
            (sum (list c1 c2 c4 c8 c16 c32))))
    (lb-claims (lb-dir)))
