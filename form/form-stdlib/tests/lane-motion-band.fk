; lane-motion-band.fk — the witness diffs honestly: motion detected,
; stillness reported with its value, tally over the declared names,
; turn arithmetic asked from the text, waiting turns as one csv datum.
; Expected: 255
; preludes: form-stdlib/lane-motion.bml
(do
    (defn lmb-bit (ok bit) (if ok bit 0))
    (let a "pid=5\nserved=3\nsig=returned\n")
    (let b "pid=5\nserved=4\nsig=refused\n")
    (let born "form-peer program-image-cache=ready\nform-peer source-context-ms=0\nform-peer native-program-ms=7\nform-peer resident-setup-ms=7\nform-peer admit-prefill-ms=11\n")
    (sum (list
        (lmb-bit (eq (lms-moved a b "pid") 0) 1)
        (lmb-bit (eq (lms-moved a b "served") 1) 2)
        (lmb-bit (eq (lms-tpot-of 19273 22) 876) 4)
        (lmb-bit (ge (str_find (lms-line a b "sig") "MOVED" 0) 0) 8)
        (lmb-bit (eq (lms-max-turn "turn=5 x turn=9 y") 9) 16)
        (lmb-bit (str_eq (lms-turns-csv (list 7 9)) "7,9") 32)
        (lmb-bit (and (str_eq (gl-word-field (lms-birth-part (fcrbo-snapshot born)) "bootcache") "ready")
            (and (eq (fmv-field (lms-birth-part (fcrbo-snapshot born)) "bootctx") 0)
                (and (eq (fmv-field (lms-birth-part (fcrbo-snapshot born)) "bootprog") 7)
                    (and (eq (fmv-field (lms-birth-part (fcrbo-snapshot born)) "bootsetup") 7)
                         (eq (fmv-field (lms-birth-part (fcrbo-snapshot born)) "bootprefill") 11))))) 64)
        (lmb-bit (and (str_eq (gl-word-field (lms-birth-part (fcrbo-snapshot "")) "bootcache") "nothing")
            (and (str_eq (gl-word-field (lms-birth-part (fcrbo-snapshot "")) "bootctx") "nothing")
                 (str_eq (gl-word-field (lms-birth-part (fcrbo-snapshot "")) "bootprefill") "nothing"))) 128))))
