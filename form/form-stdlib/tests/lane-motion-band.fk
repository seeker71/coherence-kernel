; lane-motion-band.fk — the witness diffs honestly: motion detected,
; stillness reported with its value, tally over the declared names,
; turn arithmetic asked from the text, waiting turns as one csv datum.
; Expected: 63
; preludes: form-stdlib/lane-motion.bml
(do
    (defn lmb-bit (ok bit) (if ok bit 0))
    (let a "pid=5\nserved=3\nsig=returned\n")
    (let b "pid=5\nserved=4\nsig=refused\n")
    (sum (list
        (lmb-bit (eq (lms-moved a b "pid") 0) 1)
        (lmb-bit (eq (lms-moved a b "served") 1) 2)
        (lmb-bit (eq (lms-tpot-of 19273 22) 876) 4)
        (lmb-bit (ge (str_find (lms-line a b "sig") "MOVED" 0) 0) 8)
        (lmb-bit (eq (lms-max-turn "turn=5 x turn=9 y") 9) 16)
        (lmb-bit (str_eq (lms-turns-csv (list 7 9)) "7,9") 32))))
