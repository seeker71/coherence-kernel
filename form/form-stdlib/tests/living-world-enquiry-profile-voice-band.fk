; living-world-enquiry-profile-voice-band.fk -- shared native voice without a
; representative hypothesis. Thirty-one claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-prospective-suite.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk

(do
    (let result (lwrpv-run))
    (let profile-result (nth (node_children result) 0))
    (let world (nth (node_children result) 1))
    (let symbol (nth (node_children result) 2))
    (let exact-request (nth (node_children result) 3))
    (let exact-answer (nth (node_children result) 4))
    (let exact-plan (nth (node_children result) 5))
    (let utterance (nth (node_children result) 6))
    (let open-request (nth (node_children result) 7))
    (let open-answer (nth (node_children result) 8))
    (let open-plan (nth (node_children result) 9))
    (let expired-request (nth (node_children result) 10))
    (let expired-answer (nth (node_children result) 11))
    (let expired-plan (nth (node_children result) 12))
    (let revoked (nth (node_children result) 13))
    (let class (nth (node_children profile-result) 8))
    (let events (framebuffer-events))
    (sum (list
        (if (eq (lwep-class-current? world class) 1) 1 0)
        (if (eq (lwo-field-size
                    (lwep-class-hypothesis-field class)) 2) 2 0)
        (if (eq (lwsl-integrated-current? world symbol) 1) 4 0)
        (if (eq (lwepv-request-current? world exact-request) 1) 8 0)
        (if (eq (lwepv-answer-current? world exact-answer) 1) 16 0)
        (if (eq (oac-one? (lwepv-answer-immediate exact-answer)) 1) 32 0)
        (if (eq (oac-time-pending?
                    (lwepv-answer-time-state exact-answer)) 1) 64 0)
        (if (eq (oac-one? (lwepv-answer-effective exact-answer)) 1) 128 0)
        (if (node_eq (lwepv-answer-hypotheses exact-answer)
                (lwep-class-hypothesis-field class)) 256 0)
        (if (eq (lwepv-plan-current? world exact-plan) 1) 512 0)
        (if (eq (lwo-field-size
                    (lwepv-plan-matching-symbols exact-plan)) 1) 1024 0)
        (if (eq (oac-one? (lwepv-plan-voice-ack exact-plan)) 1) 2048 0)
        (if (eq (lwepv-utterance? utterance) 1) 4096 0)
        (if (eq (lwepv-utterance-current? world utterance) 1) 8192 0)
        (if (node_eq (lwepv-utterance-output utterance)
                (oac-payload (lwepv-answer-immediate exact-answer))) 16384 0)
        (if (eq (lwo-field-size
                    (lwepv-utterance-hypotheses utterance)) 2) 32768 0)
        (if (str_eq (lwepv-utterance-surface utterance)
                (lwnv-symbol-surface
                    (lwo-emergent-shape symbol))) 65536 0)
        (if (gt (lwo-field-size
                    (lwepv-utterance-witnesses utterance)) 0) 131072 0)
        (if (node_eq (lwepv-utterance-hypotheses utterance)
                (lwep-class-hypothesis-field class)) 262144 0)
        (if (eq (lwepv-request-current? world open-request) 1) 524288 0)
        (if (eq (oac-nothing?
                    (lwepv-answer-immediate open-answer)) 1) 1048576 0)
        (if (eq (oac-time-pending?
                    (lwepv-answer-time-state open-answer)) 1) 2097152 0)
        (if (eq (oac-nothing?
                    (lwepv-answer-effective open-answer)) 1) 4194304 0)
        (if (node_eq (lwepv-utterance-for world open-plan)
                (lwo-none)) 8388608 0)
        (if (eq (lwepv-request-current? world expired-request) 1) 16777216 0)
        (if (eq (oac-nothing?
                    (lwepv-answer-immediate expired-answer)) 1) 33554432 0)
        (if (eq (oac-time-outcome?
                    (lwepv-answer-time-state expired-answer)) 1) 67108864 0)
        (if (eq (oac-alternative-ack?
                    (lwepv-answer-effective expired-answer)) 1) 134217728 0)
        (if (node_eq (lwepv-utterance-for world expired-plan)
                (lwo-none)) 268435456 0)
        (if (and (eq (lwep-class-current? revoked class) 0)
                 (eq (lwepv-utterance-current? revoked utterance) 0))
            536870912 0)
        (if (eq (len events) 6) 1073741824 0))))
