; nine-fold-band.fk — the doubling circuit is arithmetic, not cosmology.
; Verdict 255:
;   1   24 folds to 6
;   2   9 and 18 fold to 9
;   4   doubling from 1 is 1 2 4 8 7 5
;   8   doubling from 3 is 3 6 3 6
;   16  doubling from 9 stays 9
;   32  3, 6, 9 sit on the axis; 1 does not
;   64  complements to 9: 1↔8, 2↔7, 4↔5, 3↔6, 9↔9
;   128 a living triple folds without becoming a law
; preludes: form-stdlib/core.fk form-stdlib/nine-fold.fk
; witnessed: 2026-09-10 -> 255

(do
    (defn nfb-bit (ok bit) (if ok bit 0))
    (defn nfb-eq-list (a b)
        (if (and (eq (len a) 0) (eq (len b) 0)) 1
            (if (or (eq (len a) 0) (eq (len b) 0)) 0
                (if (eq (head a) (head b))
                    (nfb-eq-list (tail a) (tail b)) 0))))
    (add (nfb-bit (eq (nf-fold 24) 6) 1)
    (add (nfb-bit (and (eq (nf-fold 9) 9) (eq (nf-fold 18) 9)) 2)
    (add (nfb-bit (eq (nfb-eq-list (nf-circuit) (list 1 2 4 8 7 5)) 1) 4)
    (add (nfb-bit (eq (nfb-eq-list (nf-threes) (list 3 6 3 6)) 1) 8)
    (add (nfb-bit (eq (nfb-eq-list (nf-nines) (list 9 9 9)) 1) 16)
    (add (nfb-bit (and (eq (nf-axis? 3) 1)
                      (and (eq (nf-axis? 12) 1)
                           (eq (nf-axis? 1) 0))) 32)
    (add (nfb-bit (and (eq (nf-opp 1) 8)
                      (and (eq (nf-opp 2) 7)
                           (and (eq (nf-opp 4) 5)
                                (and (eq (nf-opp 3) 6)
                                     (and (eq (nf-opp 9) 9)
                                          (eq (nf-pair-nine? 1) 1)))))) 64)
         (nfb-bit (eq (nfb-eq-list (nf-read 24 18 9) (list 6 9 9 6)) 1) 128)))))))))
