; living-world-behavioral-species-witness.fk -- distinct Recipes can relate
; through repeated local behavior without choosing a representative.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk

(let LWBSW-EQUIVALENT-FIXTURE (bp "LWBSW-EQUIVALENT-FIXTURE"))
(let LWBSW-DIVERGENT-FIXTURE  (bp "LWBSW-DIVERGENT-FIXTURE"))
(let LWBSW-SPECIES-FIXTURE    (bp "LWBSW-SPECIES-FIXTURE"))
(let LWBSW-ANSWER-FIXTURE     (bp "LWBSW-ANSWER-FIXTURE"))
(let LWBSW-SOURCE-K           (bp "LWBSW-SOURCE-K"))
(let LWBSW-SOURCE-L           (bp "LWBSW-SOURCE-L"))
(let LWBSW-SOURCE-M           (bp "LWBSW-SOURCE-M"))
(let LWBSW-SOURCE-N           (bp "LWBSW-SOURCE-N"))
(let LWBSW-SOURCE-O           (bp "LWBSW-SOURCE-O"))
(let LWBSW-SOURCE-J           (bp "LWBSW-SOURCE-J"))
(let LWBSW-SOURCE-R           (bp "LWBSW-SOURCE-R"))
(let LWBSW-SOURCE-S           (bp "LWBSW-SOURCE-S"))
(let LWBSW-SOURCE-T           (bp "LWBSW-SOURCE-T"))
(let LWBSW-SOURCE-Q1          (bp "LWBSW-SOURCE-Q1"))
(let LWBSW-SOURCE-Q2          (bp "LWBSW-SOURCE-Q2"))
(let LWBSW-PROV-K             (bp "LWBSW-PROV-K"))
(let LWBSW-PROV-L             (bp "LWBSW-PROV-L"))
(let LWBSW-PROV-M             (bp "LWBSW-PROV-M"))
(let LWBSW-PROV-N             (bp "LWBSW-PROV-N"))
(let LWBSW-PROV-O             (bp "LWBSW-PROV-O"))
(let LWBSW-PROV-J             (bp "LWBSW-PROV-J"))
(let LWBSW-PROV-R             (bp "LWBSW-PROV-R"))
(let LWBSW-PROV-S             (bp "LWBSW-PROV-S"))
(let LWBSW-PROV-T             (bp "LWBSW-PROV-T"))
(let LWBSW-PROV-Q1            (bp "LWBSW-PROV-Q1"))
(let LWBSW-PROV-Q2            (bp "LWBSW-PROV-Q2"))
(let LWBSW-DIRECTION-G        (bp "LWBSW-DIRECTION-G"))
(let LWBSW-OPTION-G           (bp "LWBSW-OPTION-G"))
(let LWBSW-ALTERNATIVE        (bp "LWBSW-ALTERNATIVE"))
(let LWBSW-EVIDENCE           (bp "LWBSW-EVIDENCE"))
(let LWBSW-REASON             (bp "LWBSW-REASON"))
(let LWBSW-QUESTION-EVIDENCE  (bp "LWBSW-QUESTION-EVIDENCE"))

(defn lwbsw-cell (kind) (intern_node kind (empty)))
(defn lwbsw-source-k () (lwbsw-cell LWBSW-SOURCE-K))
(defn lwbsw-source-l () (lwbsw-cell LWBSW-SOURCE-L))
(defn lwbsw-source-m () (lwbsw-cell LWBSW-SOURCE-M))
(defn lwbsw-source-n () (lwbsw-cell LWBSW-SOURCE-N))
(defn lwbsw-source-o () (lwbsw-cell LWBSW-SOURCE-O))
(defn lwbsw-source-j () (lwbsw-cell LWBSW-SOURCE-J))
(defn lwbsw-source-r () (lwbsw-cell LWBSW-SOURCE-R))
(defn lwbsw-source-s () (lwbsw-cell LWBSW-SOURCE-S))
(defn lwbsw-source-t () (lwbsw-cell LWBSW-SOURCE-T))
(defn lwbsw-source-q1 () (lwbsw-cell LWBSW-SOURCE-Q1))
(defn lwbsw-source-q2 () (lwbsw-cell LWBSW-SOURCE-Q2))
(defn lwbsw-prov-k () (lwbsw-cell LWBSW-PROV-K))
(defn lwbsw-prov-l () (lwbsw-cell LWBSW-PROV-L))
(defn lwbsw-prov-m () (lwbsw-cell LWBSW-PROV-M))
(defn lwbsw-prov-n () (lwbsw-cell LWBSW-PROV-N))
(defn lwbsw-prov-o () (lwbsw-cell LWBSW-PROV-O))
(defn lwbsw-prov-j () (lwbsw-cell LWBSW-PROV-J))
(defn lwbsw-prov-r () (lwbsw-cell LWBSW-PROV-R))
(defn lwbsw-prov-s () (lwbsw-cell LWBSW-PROV-S))
(defn lwbsw-prov-t () (lwbsw-cell LWBSW-PROV-T))
(defn lwbsw-prov-q1 () (lwbsw-cell LWBSW-PROV-Q1))
(defn lwbsw-prov-q2 () (lwbsw-cell LWBSW-PROV-Q2))
(defn lwbsw-direction-g () (lwbsw-cell LWBSW-DIRECTION-G))
(defn lwbsw-option-g () (lwbsw-cell LWBSW-OPTION-G))
(defn lwbsw-alternative () (lwbsw-cell LWBSW-ALTERNATIVE))
(defn lwbsw-evidence () (lwbsw-cell LWBSW-EVIDENCE))
(defn lwbsw-reason () (lwbsw-cell LWBSW-REASON))
(defn lwbsw-question-evidence () (lwbsw-cell LWBSW-QUESTION-EVIDENCE))

(defn lwbsw-entry (source provenance payload)
    (lwtnw-entry source provenance payload))
(defn lwbsw-entry-k (payload)
    (lwbsw-entry (lwbsw-source-k) (lwbsw-prov-k) payload))
(defn lwbsw-entry-l (payload)
    (lwbsw-entry (lwbsw-source-l) (lwbsw-prov-l) payload))
(defn lwbsw-entry-m (payload)
    (lwbsw-entry (lwbsw-source-m) (lwbsw-prov-m) payload))
(defn lwbsw-entry-n (payload)
    (lwbsw-entry (lwbsw-source-n) (lwbsw-prov-n) payload))
(defn lwbsw-entry-o (payload)
    (lwbsw-entry (lwbsw-source-o) (lwbsw-prov-o) payload))
(defn lwbsw-entry-j (payload)
    (lwbsw-entry (lwbsw-source-j) (lwbsw-prov-j) payload))
(defn lwbsw-entry-r (payload)
    (lwbsw-entry (lwbsw-source-r) (lwbsw-prov-r) payload))
(defn lwbsw-entry-s (payload)
    (lwbsw-entry (lwbsw-source-s) (lwbsw-prov-s) payload))
(defn lwbsw-entry-t (payload)
    (lwbsw-entry (lwbsw-source-t) (lwbsw-prov-t) payload))
(defn lwbsw-entry-q1 (payload)
    (lwbsw-entry (lwbsw-source-q1) (lwbsw-prov-q1) payload))
(defn lwbsw-entry-q2 (payload)
    (lwbsw-entry (lwbsw-source-q2) (lwbsw-prov-q2) payload))

(defn lwbsw-pair (source provenance) (list source provenance))
(defn lwbsw-kl ()
    (list
        (lwbsw-pair (lwbsw-source-k) (lwbsw-prov-k))
        (lwbsw-pair (lwbsw-source-l) (lwbsw-prov-l))))
(defn lwbsw-mnojr ()
    (list
        (lwbsw-pair (lwbsw-source-m) (lwbsw-prov-m))
        (lwbsw-pair (lwbsw-source-n) (lwbsw-prov-n))
        (lwbsw-pair (lwbsw-source-o) (lwbsw-prov-o))
        (lwbsw-pair (lwbsw-source-j) (lwbsw-prov-j))
        (lwbsw-pair (lwbsw-source-r) (lwbsw-prov-r))))
(defn lwbsw-q12 ()
    (list
        (lwbsw-pair (lwbsw-source-q1) (lwbsw-prov-q1))
        (lwbsw-pair (lwbsw-source-q2) (lwbsw-prov-q2))))
(defn lwbsw-g-participants ()
    (append (lwtnw-pqrstu)
        (cons (lwbsw-pair (lwtnw-source-x) (lwtnw-prov-x))
              (lwbsw-kl))))
(defn lwbsw-f-participants ()
    (append (lwtnw-pqrstu)
        (list
            (lwbsw-pair (lwtnw-source-x) (lwtnw-prov-x))
            (lwbsw-pair (lwtnw-source-y) (lwtnw-prov-y)))))
(defn lwbsw-species-participants ()
    (append (lwtnw-pqrstu)
        (append
            (list
                (lwbsw-pair (lwtnw-source-v) (lwtnw-prov-v))
                (lwbsw-pair (lwtnw-source-w) (lwtnw-prov-w))
                (lwbsw-pair (lwtnw-source-x) (lwtnw-prov-x)))
            (append (lwbsw-kl) (lwbsw-mnojr)))))
(defn lwbsw-answer-participants ()
    (append (lwbsw-species-participants) (lwbsw-q12)))

; G is source-distinct from E but produces the same local 4 boundary.
(defn lwbsw-recipe-g ()
    (lwre-recipe "(add 2 2)" (lwtnw-contract) (lwbsw-evidence)))
(defn lwbsw-lens-g () (lwtnw-lens-for (lwbsw-recipe-g)))
(defn lwbsw-declaration-g ()
    (lwtnw-declaration-for (lwbsw-direction-g) (lwbsw-lens-g)))
(defn lwbsw-offer-g (target)
    (lwtn-offer target (lwbsw-recipe-g) (lwbsw-declaration-g)
        (lwbsw-lens-g) (intern_trivial_int 1)
        (lwo-field (list (lwbsw-option-g)))
        (lwlc-unknown (lwbsw-evidence))
        (lwo-none) (lwo-none) (lwbsw-evidence)))

(defn lwbsw-revoke-e-offers (world target)
    (lwt-receive-stream world
        (list
            (lwtnw-entry-v
                (lwo-revocation (lwtnw-offer-e target) (lwtnw-source-v)
                    (lwbsw-reason) (lwtnw-prov-v)))
            (lwtnw-entry-w
                (lwo-revocation (lwtnw-offer-e target) (lwtnw-source-w)
                    (lwbsw-reason) (lwtnw-prov-w))))))
(defn lwbsw-world-with-g (world target)
    (lwt-receive-stream world
        (list
            (lwbsw-entry-k (lwbsw-recipe-g))
            (lwbsw-entry-k (lwbsw-declaration-g))
            (lwbsw-entry-k (lwbsw-offer-g target))
            (lwbsw-entry-l (lwbsw-offer-g target)))))
(defn lwbsw-world-with-f-second (world target)
    (lwt-receive-stream world
        (list (lwtnw-entry-y (lwtnw-offer-f target)))))

; children: final world, target fixture, E trial, G selection, G trial
(defn lwbsw-equivalent-fixture
    (world target-fixture e-trial g-selection g-trial)
    (intern_node LWBSW-EQUIVALENT-FIXTURE
        (list world target-fixture e-trial g-selection g-trial)))
(defn lwbsw-equivalent-world (fixture) (nth (node_children fixture) 0))
(defn lwbsw-equivalent-target (fixture) (nth (node_children fixture) 1))
(defn lwbsw-equivalent-e-trial (fixture) (nth (node_children fixture) 2))
(defn lwbsw-equivalent-g-selection (fixture) (nth (node_children fixture) 3))
(defn lwbsw-equivalent-g-trial (fixture) (nth (node_children fixture) 4))
(defn lwbsw-build-equivalent ()
    (do
        (let target-fixture (lwtnw-build-target))
        (let e-fixture (lwtnw-exact-trial target-fixture))
        (let e-world (lwt-round-world (lwtnw-trial-round e-fixture)))
        (let target (lwtnw-target target-fixture))
        (let reopened (lwbsw-revoke-e-offers e-world target))
        (let g-world (lwbsw-world-with-g reopened target))
        (let g-selection
            (lwtnw-integrate-selection g-world target
                (lwtnw-trial-round e-fixture)
                (lwbsw-g-participants)))
        (let g-trial
            (lwtnw-integrate-trial g-selection (lwbsw-g-participants)))
        (lwbsw-equivalent-fixture
            (lwt-round-world (lwtnw-trial-round g-trial))
            target-fixture e-fixture g-selection g-trial)))

; children: final world, target fixture, E trial, F selection, F trial
(defn lwbsw-divergent-fixture
    (world target-fixture e-trial f-selection f-trial)
    (intern_node LWBSW-DIVERGENT-FIXTURE
        (list world target-fixture e-trial f-selection f-trial)))
(defn lwbsw-divergent-world (fixture) (nth (node_children fixture) 0))
(defn lwbsw-divergent-target (fixture) (nth (node_children fixture) 1))
(defn lwbsw-divergent-e-trial (fixture) (nth (node_children fixture) 2))
(defn lwbsw-divergent-f-selection (fixture) (nth (node_children fixture) 3))
(defn lwbsw-divergent-f-trial (fixture) (nth (node_children fixture) 4))
(defn lwbsw-build-divergent ()
    (do
        (let target-fixture (lwtnw-build-target))
        (let e-fixture (lwtnw-exact-trial target-fixture))
        (let e-world (lwt-round-world (lwtnw-trial-round e-fixture)))
        (let target (lwtnw-target target-fixture))
        (let reopened (lwbsw-revoke-e-offers e-world target))
        (let f-world (lwbsw-world-with-f-second reopened target))
        (let f-selection
            (lwtnw-integrate-selection f-world target
                (lwtnw-trial-round e-fixture)
                (lwbsw-f-participants)))
        (let f-trial
            (lwtnw-integrate-trial f-selection (lwbsw-f-participants)))
        (lwbsw-divergent-fixture
            (lwt-round-world (lwtnw-trial-round f-trial))
            target-fixture e-fixture f-selection f-trial)))

(defn lwbsw-first-signature (world first)
    (lwbs-signature-for (lwbs-receipt-for world first)))
(defn lwbsw-support-observation (world first second)
    (lwbs-observation first second
        (oac-one (lwbsw-first-signature world first))
        (lwo-field (list (lwbsw-alternative)))
        (lwlc-unknown (lwbsw-evidence)) (lwbsw-evidence)))
(defn lwbsw-silence-observation (first second)
    (lwbs-observation first second (oac-nothing)
        (lwo-empty-field) (lwlc-unknown (lwbsw-evidence))
        (lwbsw-evidence)))
(defn lwbsw-dissent-observation (first second)
    (lwbs-observation first second (oac-zero)
        (lwo-field (list (lwbsw-alternative)))
        (lwlc-unknown (lwbsw-evidence)) (lwbsw-evidence)))
(defn lwbsw-alternative-observation (world first second offered)
    (lwbs-observation first second
        (oac-alternative-ack (lwbsw-first-signature world first)
            offered (lwbsw-evidence))
        (lwo-field (list offered)) (lwlc-unknown (lwbsw-evidence))
        (lwbsw-evidence)))
(defn lwbsw-observed-world-for (world first second)
    (do
        (let direct (lwbsw-support-observation world first second))
        (let inverse (lwbsw-support-observation world second first))
        (let silence (lwbsw-silence-observation first second))
        (lwt-receive-stream world
            (list
                (lwbsw-entry-m direct)
                (lwbsw-entry-n direct)
                (lwbsw-entry-o inverse)
                (lwbsw-entry-j inverse)
                (lwbsw-entry-r silence)))))
(defn lwbsw-aligned-world (fixture)
    (lwbsw-observed-world-for (lwbsw-equivalent-world fixture)
        (lwtnw-trial-candidate (lwbsw-equivalent-e-trial fixture))
        (lwtnw-trial-candidate (lwbsw-equivalent-g-trial fixture))))
(defn lwbsw-divergent-observed-world (fixture)
    (lwbsw-observed-world-for (lwbsw-divergent-world fixture)
        (lwtnw-trial-candidate (lwbsw-divergent-e-trial fixture))
        (lwtnw-trial-candidate (lwbsw-divergent-f-trial fixture))))

(defn lwbsw-ambiguous-world (world first second offered)
    (lwt-receive-stream world
        (list
            (lwbsw-entry-s
                (lwbsw-alternative-observation
                    world first second offered)))))
(defn lwbsw-dissent-world (world first second)
    (lwt-receive-stream world
        (list
            (lwbsw-entry-t (lwbsw-dissent-observation first second)))))
(defn lwbsw-revoked-support-world (world first second)
    (lwt-receive-stream world
        (list
            (lwbsw-entry-n
                (lwo-revocation
                    (lwbsw-support-observation world first second)
                    (lwbsw-source-n) (lwbsw-reason) (lwbsw-prov-n))))))

; children: integrated round, species candidate, proposal, pre-admission field
(defn lwbsw-species-fixture (round candidate proposal field)
    (intern_node LWBSW-SPECIES-FIXTURE
        (list round candidate proposal field)))
(defn lwbsw-species-round (fixture) (nth (node_children fixture) 0))
(defn lwbsw-species-candidate (fixture) (nth (node_children fixture) 1))
(defn lwbsw-species-proposal (fixture) (nth (node_children fixture) 2))
(defn lwbsw-species-field (fixture) (nth (node_children fixture) 3))
(defn lwbsw-integrated-species (fixture)
    (do
        (let world (lwbsw-aligned-world fixture))
        (let first
            (lwtnw-trial-candidate (lwbsw-equivalent-e-trial fixture)))
        (let second
            (lwtnw-trial-candidate (lwbsw-equivalent-g-trial fixture)))
        (let field (lwbs-field-for world first second 2))
        (let proposal (lwbs-proposal world first second 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let round
            (lwt-round world (lwo-field (list proposal))
                (lwo-empty-field)
                (lwtnw-trial-round (lwbsw-equivalent-g-trial fixture))))
        (let yes
            (lwt-round-receive round
                (lwtnw-response-entries proposal
                    (lwbsw-species-participants))))
        (let integrated (lwbs-integrate yes proposal (lwigw-action)))
        (lwbsw-species-fixture integrated candidate proposal field)))

(defn lwbsw-question (species)
    (lwbs-question species (lwbsw-lens-g)
        (lwo-field (list (lwbsw-alternative)))
        (lwlc-unknown (lwbsw-question-evidence))
        (lwbsw-question-evidence)))
(defn lwbsw-question-world (species-fixture)
    (do
        (let world (lwt-round-world (lwbsw-species-round species-fixture)))
        (let question
            (lwbsw-question (lwbsw-species-candidate species-fixture)))
        (lwt-receive-stream world
            (list (lwbsw-entry-q1 question) (lwbsw-entry-q2 question)))))

; children: integrated round, answer candidate, proposal, exact answer, question
(defn lwbsw-answer-fixture (round candidate proposal answer question)
    (intern_node LWBSW-ANSWER-FIXTURE
        (list round candidate proposal answer question)))
(defn lwbsw-answer-round (fixture) (nth (node_children fixture) 0))
(defn lwbsw-answer-candidate (fixture) (nth (node_children fixture) 1))
(defn lwbsw-answer-proposal-cell (fixture) (nth (node_children fixture) 2))
(defn lwbsw-answer-shape (fixture) (nth (node_children fixture) 3))
(defn lwbsw-answer-question (fixture) (nth (node_children fixture) 4))
(defn lwbsw-integrated-answer (species-fixture)
    (do
        (let world (lwbsw-question-world species-fixture))
        (let species (lwbsw-species-candidate species-fixture))
        (let question (lwbsw-question species))
        (let proposal (lwbs-answer-proposal world question 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let answer (lwo-emergent-shape candidate))
        (let round
            (lwt-round world (lwo-field (list proposal))
                (lwo-empty-field) (lwbsw-species-round species-fixture)))
        (let yes
            (lwt-round-receive round
                (lwtnw-response-entries proposal
                    (lwbsw-answer-participants))))
        (let integrated
            (lwbs-answer-integrate yes proposal (lwigw-action)))
        (lwbsw-answer-fixture integrated candidate proposal answer question)))

0
