; form-token-workspace-band.bml — the living workspace the in-stream verbs build in: four scopes read through one chain,
; every making kept as a named cell by composition identity, requests that build on one another, model-free.
; preludes: form-stdlib/bml/form-token-grammar.bml
; Verdict 4095
; PROOF LEVEL: FOURTH-ARM ONLY — eval reaches every door the runtime carries (the band reads the runtime's own op table
; to prove it), node_at reads the host field, and another process is a child fkwu born by host_spawn_at; the siblings
; carry none of them
;
; Every store lives in a scratch directory under temp_dir, written and read back through the carrier, and removed at the
; end. Controls run through ftg-observe-with, as a lane runs them: each is numbered and its touch is marked.
;     1  a value is its own recipe tree: ints, floats, text, nested lists holding nothing, a record, a node held as a
;        value and a walker function round-trip through ftw-encode and ftw-decode; the same value is the same tree; a
;        function that came back still runs
;     2  one chain, nearest first: a name written to global, lineage, request and local reads local; the next reply of
;        the request reads its request scope; another request of the lineage reads the lineage's newest; a request in
;        another lineage reads global; names(scope) lists what a scope sees; a request with no lineage starts its own
;     4  on disk: the stores are persistence.fk's own CELL recipes under the root (lookup-cell finds one); a workspace
;        opened afresh on the same root, lineage and request (a later process) reads every name back, and a node binding
;        re-collapses to the same NodeID; the local scope (it, it<n>) lives with its reply and never reaches the disk
;     8  requests build on one another: request A names a value, a node, a recipe and a function and writes one name to
;        global; request B of the same lineage reads them by name, runs the recipe and the function on them, extends the
;        node into a new one and reads it back; request C of another lineage does not see A's names, sees what A wrote
;        to global, and still reaches A's node by its address (the host field is global substrate)
;    16  reuse is marked per control: a control reading what an earlier control of its request made marks control, one
;        reading what an earlier request made marks request, one touching nothing made earlier marks nothing; the marks
;        ride the crossing ledger row as touched
;    32  an address a voice copied stays good after the field moves: a cell spoken at an address the field no longer
;        holds still answers its value, in node-get and in eval; and where a reset field holds another composition at
;        the spoken address, the composition the voice spoke answers first
;    64  the whole environment: every native in the runtime's own op table (runtime/fkwu-optable.h) is a door or a word
;        the walker carries, attempt aside (a form of its own)
;   128  a lane's lineage spans processes: another process (a child fkwu running ftg-lane-observe as a body function)
;        names a value and a node in the code lane under the root; this process, a later request of the same lane,
;        builds on both by name; the voice lane does not see them
;   256  the voice's own names come first: a name it made that matches a walker word (max, count, sum) is reached by
;        name in the next control and in the next request, as a value, a number to compute with and a node to read
;   512  one writer at a time: two processes (this one and a child fkwu, released together at a gate) each write 40 names
;        to one lineage store and all 80 are kept, with no lock left behind; a lock whose holder is gone is taken over at
;        once, and a stop inside the write releases the lock
;  1024  a name the voice made that holds no function is read as its value (max + 1 = 11) and its call goes on to the
;        walker's word of that name (max(3, 9) = 9, count(f, xs), sum([4, 9, 2]) with sum a node), in the next control
;        and in the next request; a name that holds a function is still called
;  2048  door units are evicted by use, not by write time: three written a second apart, the first used again, one to
;        go, and the second goes (with its image); a unit is written whole to a fresh name and renamed into place
section [form.bml] {
 class FormTokenWorkspaceBand {
  def ftwb-claim(ok, bit) = ok ? bit : 0;
  def ftwb-body(result) = substring(result, str_find(result, "=", 0) + 1, len(result) - 1);
  def ftwb-same?(v) = node_eq(ftw-encode(v), ftw-encode(v)) && (value_str(ftw-decode(ftw-encode(v))) == value_str(v));
  def ftwb-codec() {
   let node = intern_node(FTV-CATEGORY-ROOT, [intern_trivial_string("ftwb-pair"), intern_trivial_int(1)]);
   let back = ftw-decode(ftw-encode([1, "two", 3.25, [4, nothing()], node]));
   let rec = ftw-decode(ftw-encode(record_new(0, "a", 1, "b", [2, 3])));
   let s = ftv-session();
   let made = ftv-eval(s, "def inc(x) = x + 1");
   let f = ftw-decode(ftw-encode(ftw-lookup(ftv-ws(s), "inc")[0]));
   let runs = ftv-eval(ftv-session(), "let g = 1; g") == "value=1;";
   all?(v => ftwb-same?(v), [7, -3, 2.5, "text", [1, [2, [3]]], []]) && (back[0] == 1) && (back[1] == "two") && (back[2] == 3.25) && nothing?(back[3][1]) && node_eq(back[4], node) && (record_get(rec, "a") == 1) && (record_get(rec, "b")[1] == 3) && ftv-starts?(made, "recipe=@") && (record_get(f, "ftv") == "closure") && (ftv-call-fn(s, f, [41], 0) == 42) && runs;
  }
  def ftwb-chain(root) {
   let a = ftw-open(root, "chain", "first");
   let puts = [ftw-put(a, "global", "x", "value", 1), ftw-put(a, "lineage", "x", "value", 2), ftw-put(a, "request", "x", "value", 3), ftw-put(a, "local", "x", "value", 4)];
   let here = ftw-lookup(a, "x");
   let names = ftw-names(a, "local");
   let next = ftw-lookup(ftw-next-reply(a), "x");
   let sibling = ftw-lookup(ftw-open(root, "chain", "second"), "x");
   let stranger = ftw-lookup(ftw-open(root, "elsewhere", "third"), "x");
   let own = ftw-open(root, "", "alone");
   (here[0] == 4) && (here[2] == "local") && (names == ["x"]) && (next[0] == 3) && (next[2] == "request") && (sibling[0] == 3) && (sibling[2] == "lineage") && (stranger[0] == 1) && (stranger[2] == "global") && (ftw-lineage(own) == "alone") && (ftw-names(ftw-open(root, "elsewhere", "third"), "global") == ["x"]);
  }
  def ftwb-disk(root) {
   let ws = ftw-open(root, "disk", "one");
   let s = ftv-session-in(ws);
   let made = ftg-observe-with(s, "node-make", "keep = pair;8,9");
   let val = ftg-observe-with(s, "eval", "let kept = [1, 2, 3]; len(kept)");
   let later = ftw-open(root, "disk", "one");
   let node = ftw-lookup(later, "keep");
   let list = ftw-lookup(later, "kept");
   let cell = lookup-cell(root ++ "/lineage-disk.fkb", "form-token/request/one", "keep");
   let domains = map(m => cell-domain(channel-msg-payload(m)), channel-read(root ++ "/lineage-disk.fkb"));
   let localOff = (len(domains) >= 2) && !any?(d => ftv-starts?(d, "form-token/local/"), domains) && (ftw-lookup(ws, "it")[0] == 3);
   localOff && (val == "value=3;") &&(file_size(root ++ "/lineage-disk.fkb") > 0) && (cell-found?(cell) == 1) && (ftw-coord(cell-blueprint(cell-of(cell))) != "") && node_eq(node[0], ftw-node-at(ws, ftwb-body(made))) && (ftw-coord(node[0]) == ftwb-body(made)) && (value_str(list[0]) == "[1, 2, 3]") && (node[1] == "node");
  }
  // A, B and C, as a lane runs them: one session per request, each a workspace on the same root
  def ftwb-requests(root) {
   let a = ftv-session-in(ftw-open(root, "talk", "a"));
   let a1 = ftg-observe-with(a, "eval", "let total = 6 * 7");
   let a2 = ftg-observe-with(a, "node-make", "p = pair;3,4");
   let a3 = ftg-observe-with(a, "recipe-birth", "sq = bml;x => x * x");
   let a4 = ftg-observe-with(a, "eval", "def twice(x) = x * 2");
   let a5 = ftg-observe-with(a, "eval", "global: let shared = \"everyone\"");
   let p = ftwb-body(a2);
   let b = ftv-session-in(ftw-open(root, "talk", "b"));
   let b1 = ftg-observe-with(b, "eval", "total + 1");
   let b2 = ftg-observe-with(b, "eval", "kids(p)");
   let b3 = ftg-observe-with(b, "recipe-exec", "sq;input=total;carrier=auto");
   let b4 = ftg-observe-with(b, "eval", "sq(kids(p)[0]) + twice(5)");
   let b5 = ftg-observe-with(b, "node-make", "q = pair;p,5");
   let b6 = ftg-observe-with(b, "node-get", "q");
   let c = ftv-session-in(ftw-open(root, "other", "c"));
   let c1 = ftg-observe-with(c, "eval", "total");
   let c2 = ftg-observe-with(c, "recipe-exec", "sq;input=2;carrier=auto");
   let c3 = ftg-observe-with(c, "node-get", "p");
   let c4 = ftg-observe-with(c, "eval", "shared");
   let c5 = ftg-observe-with(c, "node-get", p);
   let pairCat = ftv-coord(intern_node(FTV-CATEGORY-ROOT, [intern_trivial_string("pair")]));
   let aMade = (a1 == "value=42;") && ftv-starts?(a2, "node=@") && ftv-starts?(a3, "recipe=@") && ftv-starts?(a4, "recipe=@") && (a5 == "value=everyone;");
   let bBuilt = (b1 == "value=43;") && (b2 == "value=[3, 4];") && (b3 == "value=1764;") && (b4 == "value=19;") && ftv-starts?(b5, "node=@") && (b6 == "value=[pair, " ++ pairCat ++ ", [" ++ p ++ ", 5]];");
   let cApart = (c1 == "nothing=unknown-name:total;") && (c2 == "nothing=unknown-recipe;") && (c3 == "nothing=unknown-node;") && (c4 == "value=everyone;") && (c5 == "value=[pair, " ++ pairCat ++ ", [3, 4]];");
   aMade && bBuilt && cApart;
  }
  def ftwb-reuse(root) {
   let a = ftv-session-in(ftw-open(root, "marks", "a"));
   let a1 = ftg-observe-with(a, "eval", "let base = 10");
   let fresh = record_get(a, "touched");
   let a2 = ftg-observe-with(a, "eval", "base * 2");
   let again = record_get(a, "touched");
   let a3 = ftg-observe-with(a, "eval", "3 + 4");
   let none = record_get(a, "touched");
   let b = ftv-session-in(ftw-open(root, "marks", "b"));
   let b1 = ftg-observe-with(b, "eval", "base + 1");
   let across = record_get(b, "touched");
   let row = json-emit(ftg-crossing-row-with("voice", ["<|form:eval|>base * 2<|/form:eval|>", "<|form:eval|>base + 1<|/form:eval|>"], [a2, b1], [1, 1], [again, across]));
   (a1 == "value=10;") && (fresh == "") && (a2 == "value=20;") && (again == "control") && (a3 == "value=7;") && (none == "") && (b1 == "value=11;") && (across == "request") && (str_find(row, "\"touched\":[\"control\",\"request\"]", 0) >= 0) && (str_find(json-emit(ftg-crossing-row("voice", ["x"], ["value=1;"], [0])), "touched", 0) < 0);
  }
  // a cell spoken at @7.7.7.7, an address the field does not hold for it, still answers its value
  def ftwb-spoken-cell(ws, name, spoken, node) = make-cell-recipe(name, ftw-domain(ws, "request"), intern_node(ftw-cat("ftw-made"), [intern_trivial_string("node"), intern_trivial_string(ftw-request(ws)), intern_trivial_string("rp-old"), intern_trivial_int(1), intern_trivial_string(spoken)]), intern_node(ftw-cat("ftw-node"), [node]));
  def ftwb-spoken(root) {
   let ws = ftw-open(root, "moved", "r");
   let cat = intern_node(FTV-CATEGORY-ROOT, [intern_trivial_string("ftwb-moved")]);
   let node = intern_node(cat, [intern_trivial_int(8), intern_trivial_int(9)]);
   let kept = ftw-store-write(ws, ftw-store-key(ws, "request"), ftwb-spoken-cell(ws, "moved", "@7.7.7.7", node));
   let s = ftv-session-in(ws);
   let field = ftw-field-node("@7.7.7.7", [7, 7, 7, 7]);
   let moved = nothing?(field) && node_eq(ftw-node-at(ws, "@7.7.7.7"), node) && (ftv-eval(s, "kids(@7.7.7.7)") == "value=[8, 9];") && ftv-starts?(ftv-node-get(s, "@7.7.7.7"), "value=[ftwb-moved, ");
   let other = intern_node(cat, [intern_trivial_int(1), intern_trivial_int(2)]);
   let reused = ftw-coord(other);
   let ws2 = ftw-open(root, "reset", "r2");
   let kept2 = ftw-store-write(ws2, ftw-store-key(ws2, "request"), ftwb-spoken-cell(ws2, "spoke", reused, node));
   let first = node_eq(ftw-node-at(ws2, reused), node) && node_eq(ftw-node-at(ftw-open(root, "unspoken", "r3"), reused), other) && (ftv-eval(ftv-session-in(ws2), "kids(" ++ reused ++ ")") == "value=[8, 9];");
   moved && first;
  }
  def ftwb-optab-names(text) = map(p => substring(p, 0, str_find(p, "\"", 0)), filter(p => str_find(p, "\"", 0) > 0, split-on(text, "{ \"")[1:]));
  def ftwb-environment() {
   let names = ftwb-optab-names(read_file("runtime/fkwu-optable.h") ?? "");
   let missing = filter(n => !ftw-door?(n) && !ftv-builtin?(n) && (n != "attempt"), names);
   if nil?(missing) then 0 else print_str("form-token-workspace-band natives the walk cannot reach: " ++ ftv-join(missing, ", "));
   (len(names) > 200) && nil?(missing);
  }
  // the child writes as the code lane does; this process reads as the lane's next request
  def ftwb-lane(root) {
   let quoted = "\"" ++ root ++ "\"";
   let there = ftv-session();
   let named = ftv-eval(there, "ftg-lane-observe(" ++ quoted ++ ", \"code\", \"eval\", \"let carried = 41\")");
   let child = ftw-last-child();
   let made = ftv-eval(there, "ftg-lane-observe(" ++ quoted ++ ", \"code\", \"node-make\", \"kept = pair;carried,2\")");
   let here = ftv-session-in(ftg-lane-ws(root, "code"));
   let built = ftg-observe-with(here, "eval", "carried + 1");
   let read = ftg-observe-with(here, "node-get", "kept");
   let touched = record_get(here, "touched");
   let voice = ftg-observe-with(ftv-session-in(ftg-lane-ws(root, "voice")), "eval", "carried");
   let pairCat = ftv-coord(intern_node(FTV-CATEGORY-ROOT, [intern_trivial_string("pair")]));
   (named == "value=value=41;;") && ftv-starts?(made, "value=node=@") && (child > 0) && (child != host_pid()) && (host_alive(child) == 0) && (built == "value=42;") && (read == "value=[pair, " ++ pairCat ++ ", [41, 2]];") && (touched == "request") && (voice == "nothing=unknown-name:carried;");
  }
  def ftwb-words(root) {
   let a = ftv-session-in(ftw-open(root, "words", "a"));
   let a1 = ftg-observe-with(a, "eval", "let max = 10");
   let a2 = ftg-observe-with(a, "eval", "max + 1");
   let a3 = ftg-observe-with(a, "eval", "let count = 3");
   let a4 = ftg-observe-with(a, "eval", "count * 2");
   let a5 = ftg-observe-with(a, "node-make", "sum = pair;1,2");
   let a6 = ftg-observe-with(a, "eval", "kids(sum)");
   let b = ftv-session-in(ftw-open(root, "words", "b"));
   let b1 = ftg-observe-with(b, "eval", "max * count + len(kids(sum))");
   let b2 = ftg-observe-with(b, "eval", "[4, 9, 2] |> sum");
   (a1 == "value=10;") && (a2 == "value=11;") && (a4 == "value=6;") && ftv-starts?(a5, "node=@") && (a6 == "value=[1, 2];") && (b1 == "value=32;") && (b2 == "value=15;") && any?(n => n == "max", ftw-names(ftv-ws(b), ""));
  }
  // two processes write one lineage store in the same moment: the child waits at a gate (go) the parent opens
  // after the child says it is ready, then each writes 40 names; all 80 are kept, and no lock is left behind
  def ftwb-child-text(root) = "import form-stdlib/bml/form-token-workspace.bml;\nsection [form.bml] {\n let ws = ftw-open(\"" ++ root ++ "\", \"lin\", \"child\");\n let ready = write_file(\"" ++ root ++ "/ready\", \"1\");\n let gate = ftw-wait-file(\"" ++ root ++ "/go\", host_monotonic_ms() + 30000);\n map(i => ftw-put(ws, \"lineage\", \"c\" ++ i.str(), \"value\", i), range(0, 40));\n 0;\n}\n";
  def ftwb-names-held(root, tags) = all?(t => all?(i => !nothing?(ftw-lookup(ftw-open(root, "lin", "reader"), t ++ i.str())), range(0, 40)), tags);
  def ftwb-writers(root) {
   let made = fs_mkdir(root);
   let wrote = write_file(root ++ "/child.bml", ftwb-child-text(root));
   let child = host_spawn_at([ftw-fkwu(), root ++ "/child.bml"], ["/dev/null", root ++ "/child.out", root ++ "/child.err"]);
   let ws = ftw-open(root, "lin", "parent");
   let ready = ftw-wait-file(root ++ "/ready", host_monotonic_ms() + 30000);
   let go = write_file(root ++ "/go", "1");
   let mine = map(i => ftw-put(ws, "lineage", "p" ++ i.str(), "value", i), range(0, 40));
   let status = host_wait(child);
   let cells = len(channel-read(root ++ "/lineage-lin.fkb"));
   (ready == 1) && (status == 0) && (cells == 80) && ftwb-names-held(root, ["p", "c"]) && (fs_exists(root ++ "/lineage-lin.fkb.lock") == 0);
  }
  // a lock whose holder is gone is taken over at once, and a stop inside the write releases the lock
  def ftwb-stale(root) {
   let made = fs_mkdir(root);
   let dead = host_spawn_quiet(["/usr/bin/true"]);
   let reaped = host_wait(dead);
   let ws = ftw-open(root, "stale", "r");
   let lock = ftw-store-path(ws, ftw-store-key(ws, "lineage")) ++ ".lock";
   let held = fs_mkdir(lock);
   let named = write_file_text(lock ++ "/owner", "pid=" ++ dead.str() ++ " at=" ++ now_unix_ms().str());
   let t0 = host_monotonic_ms();
   let put = ftw-put(ws, "lineage", "after", "value", 1);
   let took = host_monotonic_ms() - t0;
   let stopped = try ftw-file-write(ws, ftw-store-key(ws, "lineage"), nothing()) catch 7;
   (held == 1) && (host_alive(dead) != 1) && !nothing?(ftw-lookup(ftw-open(root, "stale", "r2"), "after")) && (took < 2000) && (fs_exists(lock) == 0);
  }
  // a name the voice made that holds no function is read as its value, and its call goes on to the word of that name,
  // in the next control and in every later request of the lineage
  def ftwb-calls(root) {
   let a = ftv-session-in(ftw-open(root, "calls", "a"));
   let a1 = ftg-observe-with(a, "eval", "let max = 10");
   let a2 = ftg-observe-with(a, "eval", "max(3, 9)");
   let a3 = ftg-observe-with(a, "eval", "max + 1");
   let a4 = ftg-observe-with(a, "eval", "let count = 3");
   let a5 = ftg-observe-with(a, "eval", "count(x => x > 1, [1, 2, 3]) + count");
   let a6 = ftg-observe-with(a, "node-make", "sum = pair;1,2");
   let b = ftv-session-in(ftw-open(root, "calls", "b"));
   let b1 = ftg-observe-with(b, "eval", "max(3, 9) * max + count(x => x > 1, [1, 2, 3])");
   let b2 = ftg-observe-with(b, "eval", "sum([4, 9, 2])");
   let b3 = ftg-observe-with(b, "eval", "let inc = x => x + 1; let max = inc; max(5)");
   (a1 == "value=10;") && (a2 == "value=9;") && (a3 == "value=11;") && (a5 == "value=5;") && ftv-starts?(a6, "node=@") && (b1 == "value=92;") && (b2 == "value=15;") && (b3 == "value=6;");
  }
  // door units are evicted by use: three written a second apart, the first used again, one to go: the second goes
  def ftwb-evict(root) {
   let made = fs_mkdir(root);
   let a = ftw-door-unit(root, "section [form.bml] { 1; }\n");
   let s1 = host_sleep_ms(1100);
   let b = ftw-door-unit(root, "section [form.bml] { 2; }\n");
   let s2 = host_sleep_ms(1100);
   let c = ftw-door-unit(root, "section [form.bml] { 3; }\n");
   let again = ftw-door-unit(root, "section [form.bml] { 1; }\n");
   let companion = write_file(b ++ ".fkb", "x");
   let before = fs_list(root);
   let pruned = ftw-doors-prune([a, b, c], 1);
   let after = fs_list(root);
   (again == a) && (len(before) == 4) && (file_size(a) > 0) && (file_size(b) < 0) && (file_size(b ++ ".fkb") < 0) && (file_size(c) > 0) && (len(after) == 2) && !any?(n => str_find(n, ".w", 0) >= 0, after);
  }
  def ftwb-run() {
   let root = temp_dir() ++ "/form-token-workspace-band-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str();
   let made = fs_mkdir(root);
   let c1 = ftwb-claim(ftwb-codec(), 1);
   let c2 = ftwb-claim(ftwb-chain(root ++ "/chain"), 2);
   let c3 = ftwb-claim(ftwb-disk(root ++ "/disk"), 4);
   let c4 = ftwb-claim(ftwb-requests(root ++ "/requests"), 8);
   let c5 = ftwb-claim(ftwb-reuse(root ++ "/reuse"), 16);
   let c6 = ftwb-claim(ftwb-spoken(root ++ "/spoken"), 32);
   let c7 = ftwb-claim(ftwb-environment(), 64);
   let c8 = ftwb-claim(ftwb-lane(root ++ "/lane"), 128);
   let c9 = ftwb-claim(ftwb-words(root ++ "/words"), 256);
   let c10 = ftwb-claim(ftwb-writers(root ++ "/writers") && ftwb-stale(root ++ "/stale"), 512);
   let c11 = ftwb-claim(ftwb-calls(root ++ "/calls"), 1024);
   let c12 = ftwb-claim(ftwb-evict(root ++ "/evict"), 2048);
   let gone = fs_rmdir(root);
   print_str("form-token-workspace-band claims " ++ c1.str() ++ " " ++ c2.str() ++ " " ++ c3.str() ++ " " ++ c4.str() ++ " " ++ c5.str() ++ " " ++ c6.str() ++ " " ++ c7.str() ++ " " ++ c8.str() ++ " " ++ c9.str() ++ " " ++ c10.str() ++ " " ++ c11.str() ++ " " ++ c12.str());
   c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12;
  }
 }
 ftwb-run();
}
