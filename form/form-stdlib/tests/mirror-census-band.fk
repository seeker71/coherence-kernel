; mirror-census-band.fk — the judgement that tells a wall from a name that fell
; off a standing arm.
;
; Expected: 65535
; preludes: form/form-stdlib/mirror-census.bml
;
; PURE. Every mirror row below is written by hand, so this band proves the
; JUDGEMENT and never the tree's mood. The live reading is a different witness
; (observe/mirror-census-run.fk); a band that read runtime/fkwu-optable.h would
; go red the next time someone adds a native, which is not a wound.
;
; The hand-built body under test, one name per shape the lens must tell apart:
;
;   whole_op      every mirror stands                       -> whole
;   hushed_op     arm at 205, NO row, 205 belongs to another -> armhush + tagclash
;   clashed_op    manifest says 77, its own row says 78      -> tagclash
;   alias_a/b     two names on tag 3, both with rows         -> NOT a clash
;   dead_route    row at 250, no arm answers 250             -> rowhush
;   fkc_owed      arity 1, arm, no serializer arm            -> fkcgap
;   fkc_free      arity 2, arm, no serializer arm            -> NOT fkcgap
;   sib_split     seed row + arm, go and ts, no rust         -> siblinggap
;   seed_only     all three siblings, no seed route at all   -> seedgap
;   jit_only_emit an emitter arm and no value-ABI row        -> jitsplit
;   jit_only_abi  a value-ABI row and no emitter arm         -> jitsplit
;   rewritten_op  reached through fk_rwtab, no arm owed      -> rewrite
;   nobody_op     in no mirror at all                        -> no-native-here
;
; The three claims this band exists for, each with its own bit:
;
;   - an arm with no row is its OWN kind of wound (b2), told apart from a door
;     with no native anywhere (b14). That distinction is the whole cell: on
;     2026-09-08 the second reading was given where the first was true, and the
;     answer was to mint a native that had been standing since before it was
;     named.
;   - seed_only (b10) is str_find's exact pre-restoration shape: three sibling
;     registrations, no row, no rewrite, and NO TAG left anywhere to find the
;     arm by. The lens must still name it, and must NOT claim to see the arm.
;   - an unasked mirror says unread and never 0 (b15). A tag-keyed mirror asked
;     about a name with no tag has not looked; reporting that as "missing" is
;     how a lens invents a wound, and reporting it as "present" is how one hides.

(do
    (defn mcb-bit (ok bit) (if (eq ok 1) bit 0))
    (defn mcb-has? (ws w) (mcs-in? ws w))

    ; --- the hand-built mirrors -------------------------------------------------
    ; manifest rows: (name arity tag class)
    (defn mcb-manifest ()
        (list (list "whole_op" 3 30 "tri")
              (list "hushed_op" 1 205 "host-pool")
              (list "clashed_op" 2 77 "host-pool")
              (list "alias_a" 2 3 "binary")
              (list "alias_b" 2 3 "binary")
              (list "fkc_owed" 1 40 "host-pool")
              (list "fkc_free" 2 41 "host-pool")
              (list "sib_split" 2 60 "host-pool")
              (list "jit_only_emit" 2 70 "binary")
              (list "jit_only_abi" 2 71 "binary")
              (list "dead_route" 1 250 "host-pool")))
    ; op table rows: (name arity tag), class always ""
    (defn mcb-rows ()
        (list (list "whole_op" 3 30 "")
              (list "other_op" 0 205 "")
              (list "clashed_op" 2 78 "")
              (list "alias_a" 2 3 "")
              (list "alias_b" 2 3 "")
              (list "fkc_owed" 1 40 "")
              (list "fkc_free" 2 41 "")
              (list "sib_split" 2 60 "")
              (list "jit_only_emit" 2 70 "")
              (list "jit_only_abi" 2 71 "")
              (list "dead_route" 1 250 "")))
    ; tag 31 is an arm no row and no manifest row claims: the shape str_find's
    ; tag-30 arm wore for ten weeks, and the reading no name can reach.
    (defn mcb-armtags () (list 30 205 78 3 40 41 60 70 71 31))
    (defn mcb-fkctags () (list 30 205 78 3 60 250))
    (defn mcb-fltops () (list "whole_op" "other_op" "clashed_op" "alias_a" "alias_b" "fkc_owed" "fkc_free" "dead_route" "sib_split" "jit_only_emit" "jit_only_abi"))
    (defn mcb-rw () (list "rewritten_op"))
    (defn mcb-sibs ()
        (list "whole_op" "other_op" "clashed_op" "alias_a" "alias_b" "fkc_owed" "fkc_free"
              "dead_route" "hushed_op" "seed_only" "rewritten_op" "jit_only_emit" "jit_only_abi"))
    (defn mcb-go () (cons "sib_split" (mcb-sibs)))
    (defn mcb-rust () (mcb-sibs))
    (defn mcb-ts () (cons "sib_split" (mcb-sibs)))
    (defn mcb-jit () (list "whole_op" "jit_only_emit"))
    (defn mcb-abi () (list "whole_op" "jit_only_abi"))
    (defn mcb-b ()
        (mcs-bundle (mcb-manifest) (mcb-fltops) (mcb-rows) (mcb-armtags) (mcb-fkctags)
                    (mcb-go) (mcb-rust) (mcb-ts) (mcb-jit) (mcb-rw) (mcb-abi)))

    (defn mcb-verdict (n) (mcs-verdict (mcb-b) n))
    (defn mcb-wounds (n) (mcs-wounds (mcb-b) n))

    ; --- the claims ---------------------------------------------------------------
    ; b1  a complete name reads complete: every mirror standing is "whole", and the
    ;     lens says so plainly rather than staying silent about what is well
    (defn mcb-b1 () (mcb-bit (if (str_eq (mcb-verdict "whole_op") "whole") 1 0) 1))
    ; b2  an arm with no row is named as its own wound
    (defn mcb-b2 () (mcb-bit (if (str_eq (mcb-verdict "hushed_op") "armhush") 1 0) 2))
    ; b3  and the occupied coordinate travels with it: repairing hushed_op from the
    ;     manifest's tag would route it into other_op's arm
    (defn mcb-b3 () (mcb-bit (mcb-has? (mcb-wounds "hushed_op") "tagclash") 4))
    ; b4  a name whose own row disagrees with its declared tag
    (defn mcb-b4 () (mcb-bit (if (str_eq (mcb-verdict "clashed_op") "tagclash") 1 0) 8))
    ; b5  two names on one tag, both with rows, are an ALIAS and not a clash —
    ;     add/_plus and write_file/host_file_write_text live this way on purpose
    (defn mcb-b5 () (mcb-bit (if (eq (mcs-tagclash? (mcb-b) "alias_a") 0) 1 0) 16))
    ; b6  a row whose tag no arm answers: a call that resolves and finds nothing
    (defn mcb-b6 () (mcb-bit (if (str_eq (mcb-verdict "dead_route") "rowhush") 1 0) 32))
    ; b7  a unary arm with no serializer arm flattens at the wrong arity
    (defn mcb-b7 () (mcb-bit (mcb-has? (mcb-wounds "fkc_owed") "fkcgap") 64))
    ; b8  a BINARY one does not: only binary rides the fallback safely, so calling
    ;     it a wound would be the lens inventing work
    (defn mcb-b8 () (mcb-bit (if (eq (mcs-fkcgap? (mcb-b) "fkc_free") 0) 1 0) 128))
    ; b9  a seed native two siblings hold and one does not: the four-way proof
    ;     cannot close over a door the body actually runs
    (defn mcb-b9 () (mcb-bit (if (str_eq (mcb-verdict "sib_split") "siblinggap") 1 0) 256))
    ; b10 str_find's exact pre-restoration shape: three sibling registrations, no
    ;     row, no rewrite. Named, and ranked above every gap but a proven armhush.
    (defn mcb-b10 () (mcb-bit (if (str_eq (mcb-verdict "seed_only") "seedgap") 1 0) 512))
    ; b11 the JIT deciding twice and disagreeing, caught from the emitter's side
    (defn mcb-b11 () (mcb-bit (if (str_eq (mcb-verdict "jit_only_emit") "jitsplit") 1 0) 1024))
    ; b12 and from the value-ABI's side: a primitive that lives twice reverts
    ;     silently in hot code when only one copy is healed
    (defn mcb-b12 () (mcb-bit (if (str_eq (mcb-verdict "jit_only_abi") "jitsplit") 1 0) 2048))
    ; b13 a name reached through the rewrite table is REACHED — substring has lived
    ;     there the whole time, and owes no arm
    (defn mcb-b13 () (mcb-bit (if (str_eq (mcb-verdict "rewritten_op") "rewrite") 1 0) 4096))
    ; b14 a name in no mirror at all says so, rather than reading as broken
    (defn mcb-b14 () (mcb-bit (if (str_eq (mcb-verdict "nobody_op") "no-native-here") 1 0) 8192))
    ; b15 a tag-keyed mirror asked about a name with no tag answers unread, not 0
    (defn mcb-b15 () (mcb-bit (if (lt (mcs-m-arm (mcb-b) "seed_only") 0) 1 0) 16384))
    ; b16 the arms nobody names: tag 31 is one, and tag 30 — named by a row — is not
    (defn mcb-b16 ()
        (mcb-bit (if (eq (mcs-tag-in? (mcs-orphan-tags (mcb-b)) 31) 1)
                     (if (eq (mcs-tag-in? (mcs-orphan-tags (mcb-b)) 30) 0) 1 0)
                     0)
                 32768))

    ; the bits are folded one at a time down a list, so the verdict cannot be a
    ; nest of parens the reader has to balance in their head to trust the number
    (defn mcb-bits ()
        (list (mcb-b1) (mcb-b2) (mcb-b3) (mcb-b4)
              (mcb-b5) (mcb-b6) (mcb-b7) (mcb-b8)
              (mcb-b9) (mcb-b10) (mcb-b11) (mcb-b12)
              (mcb-b13) (mcb-b14) (mcb-b15) (mcb-b16)))
    (defn mcb-sum (bs) (if (eq (len bs) 0) 0 (add (head bs) (mcb-sum (tail bs)))))
    (defn mirror-census-band () (mcb-sum (mcb-bits)))
    (mirror-census-band))
