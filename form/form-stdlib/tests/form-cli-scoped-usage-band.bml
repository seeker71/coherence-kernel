// Real retained quantities and counterexamples for scope, zero and malformed totals.
// preludes: form-stdlib/bml/form-cli-comparison-review.bml
section [form.bml] {
 let domain = parse-json("retained-source",read_file("receipts/artifacts/2026-09-20-source-restored-provider-source.json"));
 let fresh = fcr-fresh-domain(domain); let scoped = fcr-scoped-domain(domain);
 let original = node_children(json-object-get(json-object-get(fresh,"evidence"),"route_usage"));
 let rows = node_children(json-object-get(json-object-get(scoped,"evidence"),"route_usage"));
 let guide = json-object-get(head(rows),"token_usage"); let direct = json-object-get(nth(rows,1),"token_usage");
 fcr-need(and(eq(pmu-number(guide,"tokens"),2544568),str_eq(fsu-text(guide,"basis"),"recorded-scope")),"partial guided quantity lost its recorded scope");
 fcr-need(and(ge(str_find(fsu-text(guide,"scope"),"partial",0),0),node_eq(json-object-get(guide,"input_tokens"),json-node-null())),"guided missing breakdown became known");
 fcr-need(and(eq(pmu-number(direct,"tokens"),649462),str_eq(fsu-text(direct,"basis"),"all-reported-models")),"direct did not select its broader native total");
 fcr-need(and(eq(pmu-number(json-object-get(nth(rows,2),"token_usage"),"tokens"),45966),eq(pmu-number(json-object-get(nth(rows,3),"token_usage"),"tokens"),27747)),"bounded or relay total changed");
 fcr-need(ge(str_find(fsu-text(json-object-get(nth(rows,1),"calls"),"scope"),"auxiliary-model call count unobserved",0),0),"usage coverage was incorrectly granted to crossing counts");
 let recorded = json-object-get(nth(original,1),"recorded_route"); let reported = json-object-get(nth(original,1),"all_reported_model_usage");
 let absent = fsu-select(json-node-object(list()),json-node-object(list()));
 fcr-need(node_eq(json-object-get(absent,"tokens"),json-node-null()),"absent quantity became zero");
 let zero = fsu-select(oh-set(recorded,"rent_tokens",json-node-int(0)),json-node-object(list()));
 fcr-need(and(eq(pmu-number(zero,"tokens"),0),str_eq(fsu-text(zero,"status"),"observed")),"observed zero became absence");
 let scopeless = fsu-select(oh-set(recorded,"usage_scope",json-node-string("")),json-node-object(list()));
 fcr-need(node_eq(json-object-get(scopeless,"tokens"),json-node-null()),"unscoped quantity was presented as comparable");
 let broken = fsu-select(recorded,oh-set(reported,"total_tokens",json-node-int(1)));
 fcr-need(and(eq(pmu-number(broken,"tokens"),648411),and(str_eq(fsu-text(broken,"basis"),"recorded-scope"),str_eq(fsu-text(broken,"broader_usage"),"reported-counters-invalid"))),"inconsistent broader totals hid the scoped fallback");
 fcr-need(node_eq(fsu-number(parse-json("bad","{\"v\":true}"),"v"),json-node-null()),"boolean became a token count");
 fcr-need(node_eq(json-object-get(fresh,"original_enquiry"),json-object-get(scoped,"original_enquiry")),"scope normalization changed the enquiry");
 let before = json-object-get(fresh,"evidence"); let after = json-object-get(scoped,"evidence");
 fcr-need(and(node_eq(json-object-get(before,"output_artifacts"),json-object-get(after,"output_artifacts")),node_eq(json-object-get(before,"historical_author_observations"),json-object-get(after,"historical_author_observations"))),"scope normalization changed other source evidence");
 print_str("one scoped quantity per route; absent, zero, partial coverage and invalid broader totals remain distinct");
 1;
}
