// Model-free witness of source availability versus model visibility.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 class DocumentContextWitness {
  def dcb-observe(name,ok) = if ok then 1 else form_error(str_concat("document context: ",name));
  def dcb-query-check(row,expected) = dcb-observe("source query contract",eq(fcap-source-query-valid(parse-json("query",row)),expected));
 }
 let docs = list(list("evidence","evidence.txt","unseen-source-sentinel\nobserved=yes"));
 let request = parse-json("review","{\"mode\":\"review\",\"review_entry\":\"direct\",\"goal\":\"Read evidence before reporting\",\"writable\":[],\"checks\":[{\"tool\":\"cat\",\"arguments\":[\"evidence.txt\"],\"stdout\":\"unseen-source-sentinel\\nobserved=yes\"}],\"report_checks\":[{\"tool\":\"jq\",\"arguments\":[\".found\"],\"stdout\":\"true\\n\"}],\"evaluation\":1}");
 let catalogRequest = oh-set(request,"document_context",json-node-string("catalog"));
 let full = fcap-begin-context(fcaq-initial(request,docs));
 let catalog = fcap-begin-context(fcaq-initial(catalogRequest,docs));
 dcb-observe("default remains full",and(str_eq(fcap-document-context(full),"full"),value_eq(fcap-context-docs(full),docs)));
 dcb-observe("catalog review admitted",fcaq-request-valid(catalogRequest));
 dcb-observe("unknown mode refused",not(fcaq-request-valid(oh-set(request,"document_context",json-node-string("summary")))));
 dcb-observe("untyped mode refused",not(fcaq-request-valid(oh-set(request,"document_context",json-node-int(1)))));
 dcb-observe("null mode refused",not(fcaq-request-valid(oh-set(request,"document_context",json-node-null()))));
 dcb-observe("catalog code context admitted",fcaq-context-valid(oh-set(catalogRequest,"mode",json-node-string("code"))));
 dcb-observe("held sources preserved",value_eq(fcap-docs(catalog),docs));
 dcb-observe("original sources preserved",value_eq(nth(catalog,2),docs));
 dcb-observe("no unseen text claimed present",nil?(fcap-context-docs(catalog)));
 dcb-observe("full bootstrap includes text",ge(str_find(fcap-bootstrap(full),"unseen-source-sentinel",0),0));
 dcb-observe("catalog bootstrap excludes text",lt(str_find(fcap-bootstrap(catalog),"unseen-source-sentinel",0),0));
 dcb-observe("catalog contains path and byte count",and(ge(str_find(fcap-bootstrap(catalog),"evidence.txt",0),0),eq(json-int-value(json-object-get(head(fcap-document-catalog(docs)),"bytes")),str_len(nth(head(docs),2)))));
 let read = fat-call(docs,"read",list("evidence.txt"),"");
 let fullNote = parse-json("full",fcap-tool-note(full,"read",list("evidence.txt"),read));
 let catalogNote = parse-json("catalog",fcap-tool-note(catalog,"read",list("evidence.txt"),read));
 dcb-observe("full read may reference admitted bytes",json-object-has?(fullNote,"stdout_reference"));
 dcb-observe("catalog read returns exact source",str_eq(fcap-string(catalogNote,"stdout"),nth(head(docs),2)));
 dcb-observe("catalog read emits no unseen reference",not(json-object-has?(catalogNote,"stdout_reference")));
 let queried = fcap-step(catalog,"{\"tool\":\"rg\",\"arguments\":[\"observed\",\"evidence.txt\"]}",fcaq-checker(catalogRequest));
 dcb-observe("focused query reaches held source",ge(str_find(fcap-note(queried),"observed=yes",0),0));
 dcb-observe("transition preserves catalog",fcap-catalog?(queried));
 let resumed = fcap-begin-context(fcam-unpack(fcam-pack(queried)));
 dcb-observe("resumed catalog does not claim sources admitted",and(fcap-catalog?(resumed),nil?(fcap-context-docs(resumed))));
 dcb-observe("catalog remains read-only",not(fcap-tool-allowed(catalog,"write",list("evidence.txt"))));
 let accepted = fcap-step(catalog,"{\"found\":true}",fcaq-live-checker(catalogRequest));
 dcb-observe("unchanged checks can complete",and(str_eq(fcap-stage(accepted),"complete"),value_eq(fcap-docs(accepted),docs)));
 dcb-observe("returned receipt names admission mode",str_eq(fcap-string(parse-json("result",fcaq-result-core(list(accepted,1,0,0,0))),"document_context"),"catalog"));
 dcb-observe("wrong report still fails",str_eq(fcap-stage(fcap-step(catalog,"{\"found\":false}",fcaq-live-checker(catalogRequest))),"repair"));
 let wrongSource = oh-set(catalogRequest,"checks",parse-json("bad-source","[{\"tool\":\"cat\",\"arguments\":[\"evidence.txt\"],\"stdout\":\"different\"}]"));
 dcb-observe("source assertions still run",str_eq(fcap-stage(fcap-step(catalog,"{\"found\":true}",fcaq-live-checker(wrongSource))),"repair"));
 dcb-query-check("{\"tool\":\"rg\",\"arguments\":[\"observed\",\"evidence.txt\"]}",1);
 dcb-query-check("{\"tool\":\"read\",\"arguments\":[],\"note\":\"caller metadata\"}",1);
 dcb-query-check("{\"tool\":\"write\",\"arguments\":[\"evidence.txt\"]}",0);
 dcb-query-check("{\"tool\":\"verify\",\"arguments\":[]}",0);
 dcb-query-check("{\"tool\":\"rg\",\"arguments\":[1]}",0);
 dcb-query-check("{\"tool\":\"rg\",\"arguments\":[] ,\"input\":\"\"}",0);
 dcb-query-check("{\"tool\":\"rg\",\"arguments\":[],\"input\":null}",0);
 dcb-query-check("{\"tool\":\"rg\",\"arguments\":[],\"stdout\":\"invented\"}",0);
 dcb-query-check("{\"tool\":\"rg\",\"arguments\":[],\"stdout\":null}",0);
 dcb-query-check("null",0);
 let sourceQueries = parse-json("queries","[{\"tool\":\"rg\",\"arguments\":[\"observed\",\"evidence.txt\"]}]");
 let focusedRequest = oh-set(catalogRequest,"source_queries",sourceQueries);
 dcb-observe("source query request admitted",fcaq-request-valid(focusedRequest));
 dcb-observe("source queries need catalog",not(fcaq-request-valid(oh-set(request,"source_queries",sourceQueries))));
 dcb-observe("source queries need array",not(fcaq-request-valid(oh-set(catalogRequest,"source_queries",json-node-null()))));
 dcb-observe("source query injection rejected before model",not(fcaq-request-valid(oh-set(catalogRequest,"source_queries",parse-json("injected","[{\"tool\":\"cat\",\"arguments\":[\"evidence.txt\"],\"stdout\":\"invented\"}]")))));
 let focused = fcap-begin-context(fcaq-initial(focusedRequest,docs));
 let focusedPrompt = fcap-bootstrap(focused);
 dcb-observe("actual excerpt admitted",and(ge(str_find(focusedPrompt,"observed=yes",0),0),lt(str_find(focusedPrompt,"unseen-source-sentinel",0),0)));
 dcb-observe("partial excerpt does not attest full document",nil?(fcap-context-docs(focused)));
 dcb-observe("queries preserve originals",value_eq(fcap-docs(focused),docs));
 let focusedResume = fcap-begin-context(fcam-unpack(fcam-pack(focused)));
 dcb-observe("checkpoint preserves source query commands",value_eq(fcap-source-queries(focused),fcap-source-queries(focusedResume)));
 dcb-observe("new caller can clear old queries",nil?(fcap-source-queries(fcaq-context-state(catalogRequest,focusedResume))));
 let absent = head(fcap-source-observations(docs,list(list("cat",list("absent.txt")))));
 dcb-observe("query failure keeps diagnostics",and(not(eq(json-int-value(json-object-get(absent,"exit")),0)),gt(str_len(fcap-string(absent,"stderr")),0)));
 let focusedRead = fcap-step(focused,"{\"tool\":\"read\",\"arguments\":[\"evidence.txt\"]}",fcaq-checker(focusedRequest));
 dcb-observe("full source remains available",ge(str_find(fcap-note(focusedRead),"unseen-source-sentinel",0),0));
 let focusedAccepted = fcap-step(focusedRead,"{\"found\":true}",fcaq-live-checker(focusedRequest));
 dcb-observe("focused report passes original checks",and(str_eq(fcap-stage(focusedAccepted),"complete"),value_eq(fcap-docs(focusedAccepted),docs)));
 dcb-observe("focused wrong report keeps original failure",str_eq(fcap-stage(fcap-step(focused,"{\"found\":false}",fcaq-live-checker(focusedRequest))),"repair"));
 dcb-observe("absent queries preserve bootstrap",str_eq(fcap-bootstrap(catalog),fcap-bootstrap(fcap-with-source-queries(catalog,list()))));
 let codeRequest = parse-json("code","{\"mode\":\"code\",\"code_entry\":\"direct\",\"document_context\":\"catalog\",\"goal\":\"Change observed to no and preserve the other line\",\"writable\":[\"evidence.txt\"],\"checks\":[{\"tool\":\"cat\",\"arguments\":[\"evidence.txt\"],\"stdout\":\"unseen-source-sentinel\\nobserved=no\"}]}");
 let code = fcap-begin-context(fcaq-initial(codeRequest,docs));
 let codeChecker = fcaq-checker(codeRequest);
 dcb-observe("catalog coding request admitted",fcaq-request-valid(codeRequest));
 dcb-observe("coding prompt preserves unseen distinction",and(nil?(fcap-context-docs(code)),lt(str_find(fcap-bootstrap(code),"unseen-source-sentinel",0),0)));
 dcb-observe("coding retains original documents",value_eq(nth(code,2),docs));
 dcb-observe("coding only permits declared writable path",and(fcap-tool-allowed(code,"edit",list("evidence.txt")),not(fcap-tool-allowed(code,"write",list("elsewhere.txt")))));
 let codeRead = fcap-step(code,"{\"tool\":\"read\",\"arguments\":[\"evidence.txt\"]}",codeChecker);
 dcb-observe("coding read supplies actual source",ge(str_find(fcap-note(codeRead),"unseen-source-sentinel",0),0));
 dcb-observe("coding original checks reject unchanged source",not(head(fcaq-check(node_children(oh-get(codeRequest,"checks")),fcap-docs(codeRead)))));
 let edited = fcap-step(codeRead,"{\"tool\":\"edit\",\"arguments\":[\"evidence.txt\",\"observed=yes\",\"observed=no\"]}",codeChecker);
 dcb-observe("catalog edit preserves unrelated source",str_eq(nth(head(fcap-docs(edited)),2),"unseen-source-sentinel\nobserved=no"));
 dcb-observe("catalog edit passes unchanged caller checks",head(fcaq-check(node_children(oh-get(codeRequest,"checks")),fcap-docs(edited))));
 let codeResume = fcap-begin-context(fcam-unpack(fcam-pack(edited)));
 dcb-observe("coding resume preserves edits and catalog",and(fcap-catalog?(codeResume),and(nil?(fcap-context-docs(codeResume)),value_eq(fcap-docs(codeResume),fcap-docs(edited)))));
 let codeFocused = oh-set(codeRequest,"source_queries",sourceQueries);
 dcb-observe("coding admits native source queries",fcaq-request-valid(codeFocused));
 let codeFocusedPrompt = fcap-bootstrap(fcap-begin-context(fcaq-initial(codeFocused,docs)));
 dcb-observe("coding query supplies only actual excerpt",and(ge(str_find(codeFocusedPrompt,"observed=yes",0),0),lt(str_find(codeFocusedPrompt,"unseen-source-sentinel",0),0)));
 1;
}
