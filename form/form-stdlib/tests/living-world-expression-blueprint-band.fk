; living-world-expression-blueprint-band.fk -- learned order stays plural,
; optional, consented, locally voiced, and revocable.
; Verdict 32767 proves fifteen expression-blueprint and voice properties.
; witnessed: 2026-08-08 -> 32767 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk form-stdlib/tests/living-world-expression-blueprint-witness.fk

(do
    (let mapping-round (lwxbw-mapping-round))
    (let mapping-proposals (lwt-round-proposals mapping-round))
    (let mapping-a
        (lwo-emergent-shape (lwxbw-mapping-candidate-a)))
    (let uncertainty-a (lwr-mapping-uncertainty mapping-a))
    (let application-world (lwxbw-application-world))
    (let application-a
        (lwo-emergent-shape (lwxbw-application-candidate-a)))
    (let application-b
        (lwo-emergent-shape (lwxbw-application-candidate-b)))
    (let zero (lwxbw-zero-plan))
    (let one (lwxbw-one-plan))
    (let many (lwxbw-many-plan))
    (let rich (lwxbw-rich-plan))
    (let utterance (lwxbw-utterance))
    (let proposal (lwxbw-voice-proposal))
    (let dissent (lwxbw-dissent-round-build))
    (let dissent-outcome
        (lwt-evaluate-proposal (lwt-round-world dissent) proposal))
    (let refused
        (lwxb-integrate dissent proposal (lwxbw-action)))
    (let voice-world (lwxbw-voice-world))
    (let revoked (lwxbw-revoked-world))
    (let expected-surface
        (str_concat
            (lwnv-symbol-surface
                (lwo-emergent-shape (lwxbw-left)))
            (str_concat
                (lwnv-symbol-surface
                    (lwo-emergent-shape (lwxbw-alternate)))
                (lwnv-symbol-surface
                    (lwo-emergent-shape (lwxbw-right))))))
    (let pending
        (lwxb-time-observation rich (intern_trivial_int 9)))
    (let expired
        (lwxb-time-observation rich (intern_trivial_int 10)))

    (let c1
        (if (and (eq (lwo-field-size
                         (lwr-proposals (lwxbw-zero-world) 2)) 0)
                 (eq (lwo-field-size
                         (lwr-proposals (lwxbw-one-world) 2)) 0)) 1 0))
    (let c2
        (if (and (eq (lwo-field-size mapping-proposals) 2)
                 (and (not (node_eq
                            (lwxbw-mapping-candidate-a)
                            (lwxbw-mapping-candidate-b)))
                      (and (eq (lwo-field-size
                                  (lwr-mapping-supports mapping-a)) 2)
                           (eq (lwo-field-size
                                  (lwr-mapping-counterexamples mapping-a))
                               2)))) 2 0))
    (let c3
        (if (and (eq (lwr-uncertainty-counterexamples uncertainty-a) 2)
                 (and (eq (lwr-uncertainty-ambiguous uncertainty-a) 0)
                      (eq (lwr-uncertainty-unused-source uncertainty-a) 0)))
            4 0))
    (let c4
        (if (and (eq (lwo-active? (lwxbw-mapping-world)
                         (lwxbw-mapping-candidate-a)) 1)
                 (eq (lwo-active? (lwxbw-mapping-world)
                         (lwxbw-mapping-candidate-b)) 1)) 8 0))
    (let c5
        (if (and (node_eq (lwr-application-output application-a)
                           (lwxbw-expected-a))
                 (node_eq (lwr-application-output application-b)
                           (lwxbw-expected-b))) 16 0))
    (let c6
        (if (and (eq (lwxb-application-current? application-world
                         (lwxbw-application-candidate-a)) 1)
                 (eq (lwxb-application-current? application-world
                         (lwxbw-application-candidate-b)) 1)) 32 0))
    (let c7
        (if (and (eq (lwxb-incomplete? (lwxb-plan-status zero)) 1)
                 (and (eq (len (lwtv-sequence-items
                                  (lwxb-plan-sequence zero))) 0)
                      (and (node_eq (lwxb-plan-unknown zero) (lwo-none))
                           (node_eq (lwxb-plan-timeout zero) (lwo-none)))))
            64 0))
    (let c8
        (if (and (eq (lwxb-ready? (lwxb-plan-status one)) 1)
                 (node_eq (lwxb-plan-sequence one) (lwxbw-expected-a)))
            128 0))
    (let c9
        (if (and (str_eq (lwxb-utterance-surface utterance)
                          expected-surface)
                 (eq (oac-one? (lwxb-utterance-immediate utterance)) 1))
            256 0))
    (let c10
        (if (and (eq (lwxb-ambiguous? (lwxb-plan-status many)) 1)
                 (and (eq (lwo-field-size (lwxb-plan-options many)) 2)
                      (node_eq
                        (lwxb-emit-from-plan application-world many)
                        (lwo-none)))) 512 0))
    (let c11
        (if (and (node_eq (lwlc-stack-default
                              (lwlc-declaration-stack
                                (lwxb-plan-declaration rich)))
                           (lwxbw-default-lens))
                 (and (eq (len (lwlc-layer-items
                                   (lwlc-stack-layers
                                     (lwlc-declaration-stack
                                       (lwxb-plan-declaration rich))))) 1)
                      (and (eq (lwo-field-size
                                  (lwxb-plan-alternatives rich)) 1)
                           (and (eq (lwlc-unknown?
                                      (lwxb-plan-unknown rich)) 1)
                                (and (eq (lwlc-choice?
                                           (lwxb-plan-choice rich)) 1)
                                     (eq (oac-timeout-valid?
                                           (lwxb-plan-timeout rich)) 1))))))
            1024 0))
    (let c12
        (if (and (eq (oac-time-pending? pending) 1)
                 (and (eq (oac-time-outcome? expired) 1)
                      (and (eq (oac-alternative-ack?
                                  (oac-time-outcome-ack expired)) 1)
                           (not (node_eq
                                  (lwxb-utterance-immediate utterance)
                                  (oac-time-outcome-ack expired))))))
            2048 0))
    (let c13
        (if (and (node_eq (lwt-outcome-status dissent-outcome)
                           (lwt-status-dissented))
                 (eq (lwo-world-has? (lwt-round-world refused)
                         (lwt-proposal-candidate proposal)) 0)) 4096 0))
    (let c14
        (if (and (eq (lwo-active? voice-world
                         (lwt-proposal-candidate proposal)) 1)
                 (and (eq (lwxb-plan-current? voice-world rich) 1)
                      (eq (lwxb-utterance-current?
                            voice-world utterance) 1))) 8192 0))
    (let c15
        (if (and (eq (lwxb-material-current? revoked
                         (lwxbw-heldout-material)) 0)
                 (and (eq (lwxb-application-current? revoked
                            (lwxbw-application-candidate-a)) 0)
                      (and (eq (lwxb-plan-current? revoked rich) 0)
                           (eq (lwxb-utterance-current?
                                 revoked utterance) 0)))) 16384 0))

    (lwxbw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
