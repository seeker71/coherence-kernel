; preludes: form-stdlib/core.fk form/form-stdlib/roster-census.bml
; Expected: 63
; PROOF LEVEL: FKWU-STAGED / FOURTH-ARM ONLY (host_process, host_spawn and the host's process table)
;
; host-process-band — the body can say what a process runs, where, and for whom, with no shell.
;
; On 2026-09-11 the census counted every kernel the host ran and still could not say what one of them
; was doing: the host's process rows carried a pid, a size and a parent, and the glass learned a kernel's
; cell by running ps through a shell. host_process answers (pid ppid exe cwd argv) — -1 once the pid has
; ended, "" or an empty list for a field the host will not tell — and roster-census.bml walks a kernel's
; ancestors to the first one that is neither a kernel, a shell nor login: the one it runs for.
;
; Verdict 63:
;   1  host_process names this kernel: its own pid, a binary whose last segment is fkwu, this band among its words
;   2  a sleeper it starts: its parent is this kernel, its cell is observe/tests/roster-sleeper.fk, and its
;      binary and working directory are this kernel's
;   4  once the sleeper has ended and been waited for, its pid answers -1
;   8  pid 1 answers a row — pid 1, parent 0 — whatever the host will or will not tell about it
;  16  the census row for the sleeper names its cell and an owner beyond this kernel and its shells; a kernel
;      left running by a parent that ended (observe/tests/orphan-maker.fk) is owned by launchd
;  32  rce-base takes a path's last segment: "/a/b/fkwu" gives "fkwu", "fkwu" gives "fkwu", "" gives ""
(do
    (defn hpb-cmd () (list "./fkwu" "observe/tests/roster-sleeper.fk"))
    (defn hpb-has? (xs w) (if (eq (len xs) 0) 0 (if (ge (str_find (head xs) w 0) 0) 1 (hpb-has? (tail xs) w))))
    (let me (host_pid))
    (let self (host_process me))
    (let warm (host_wait (host_spawn_quiet (hpb-cmd))))
    (let child (host_spawn_quiet (hpb-cmd)))
    (let rest (host_sleep_ms 1000))
    (let kid (host_process child))
    (let kidK (rce-kernel-of kid))
    (let said (host_capture (list "./fkwu" "observe/tests/orphan-maker.fk")))
    (let orphan (str_to_int (substring said 0 (str_find said "\n" 0))))
    (let settle (host_sleep_ms 500))
    (let orphanK (rce-kernel-of (host_process orphan)))
    (let waited (host_wait child))
    (let gone (host_process child))
    (let init (host_process 1))

    (let told (print (list "self" self "kid" kidK "orphan" orphanK "gone" gone "init" init)))
    (let c0 (if (and (eq (nth self 0) me) (and (str_eq (rce-base (nth self 2)) "fkwu") (eq (hpb-has? (nth self 4) "host-process-band") 1))) 1 0))
    (let c1 (if (and (eq (nth kid 1) me) (and (str_eq (rce-cell (nth kid 4)) "observe/tests/roster-sleeper.fk")
                (and (str_eq (nth kid 2) (nth self 2)) (str_eq (nth kid 3) (nth self 3))))) 2 0))
    (let c2 (if (eq gone (sub 0 1)) 4 0))
    (let c3 (if (and (eq (nth init 0) 1) (eq (nth init 1) 0)) 8 0))
    (let c4 (if (and (str_eq (nth kidK 1) "observe/tests/roster-sleeper.fk")
                (and (gt (str_len (nth kidK 4)) 0) (and (eq (str_eq (nth kidK 4) "fkwu") 0) (str_eq (nth orphanK 4) "launchd")))) 16 0))
    (let c5 (if (and (str_eq (rce-base "/a/b/fkwu") "fkwu") (and (str_eq (rce-base "fkwu") "fkwu") (str_eq (rce-base "") ""))) 32 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
