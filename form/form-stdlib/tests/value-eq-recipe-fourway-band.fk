; value-eq-recipe-fourway-band.fk -- value_eq (structural content equality) as a BML recipe, byte-exact four-way.
;
; The goal names value_eq among the recipes that "shall not reside in the kernel." Unlike value_str's float, it
; needs no dtoa: it is a structural walk over the core value primitive eq. value_kind must match (so 1 and 1.0 are
; unequal, as the native says); a string compares by str_eq, an atom by eq, a list element by element, a nested
; list by the same recipe. veq below is that walk in pure BML; this band proves it answers exactly what the native
; value_eq answers across ints, floats, strings, null, flat and nested lists, kind mismatches and length
; mismatches, on all four kernels (validate.sh compares the whole output). eq itself stays native -- it IS the
; core value primitive the recipe stands on. closure/record/node_id identity is the native's residual, untested.
;
; Verdict 15
; preludes: form-stdlib/core.fk
;
;   1   scalars: int/float/string/null equal and unequal pairs answer as the native, and a kind mismatch (1 vs 1.0) is 0
;   2   flat lists: equal, element-differing, length-differing, and element-kind-differing answer as the native
;   4   nested lists and lists of strings answer as the native
;   8   a checksum over a generated sweep of pairs is printed (compared four-way byte-for-byte) and every pair agrees
(do
    (defn ve-bit (ok bit) (if ok bit 0))
    (defn veq-list (a b)
        (if (nil? a) (if (nil? b) 1 0)
            (if (nil? b) 0
                (if (eq (veq (head a) (head b)) 1) (veq-list (tail a) (tail b)) 0))))
    (defn veq (a b)
        (do (let ka (value_kind a)) (let kb (value_kind b))
            (if (not (str_eq ka kb)) 0
                (if (str_eq ka "list") (veq-list a b)
                    (if (str_eq ka "string") (if (str_eq a b) 1 0)
                        (if (str_eq ka "null") 1
                            (if (eq a b) 1 0)))))))
    ; agree? -- veq matches the native value_eq for this pair
    (defn one (a b bad) (if (eq (veq a b) (value_eq a b)) bad (do (let t (print (list "MISMATCH" "veq" (veq a b) "native" (value_eq a b)))) (add bad 1))))
    ; 1: scalars
    (let s1 (one 5 5 0)) (let s2 (one 5 6 s1)) (let s3 (one (sub 0 3) (sub 0 2) s2))
    (let s4 (one 2.5 2.5 s3)) (let s5 (one 2.5 2.6 s4)) (let s6 (one 1 1.0 s5))
    (let s7 (one "ab" "ab" s6)) (let s8 (one "ab" "ac" s7))
    (let s9 (one (nothing) (nothing) s8)) (let s10 (one (nothing) 0 s9))
    (let scal-ok (eq s10 0))
    ; 2: flat lists
    (let f1 (one (list 1 2 3) (list 1 2 3) 0)) (let f2 (one (list 1 2 3) (list 1 2 4) f1))
    (let f3 (one (list 1 2) (list 1 2 3) f2)) (let f4 (one (list 1) (list "1") f3))
    (let f5 (one (list) (list) f4)) (let f6 (one (list) (list 1) f5))
    (let flat-ok (eq f6 0))
    ; 4: nested + strings
    (let n1 (one (list 1 (list 2 3)) (list 1 (list 2 3)) 0)) (let n2 (one (list 1 (list 2 3)) (list 1 (list 2 4)) n1))
    (let n3 (one (list "a" "b") (list "a" "b") n2)) (let n4 (one (list "a" "b") (list "a" "c") n3))
    (let n5 (one (list 1 (list (nothing) 2.5)) (list 1 (list (nothing) 2.5)) n4))
    (let nested-ok (eq n5 0))
    ; 8: sweep of generated pairs, with a printed checksum compared four-way
    (defn cs (v acc) (mod (add (mul acc 131) (add v 1)) 1000000007))
    (defn sweep (i n acc bad)
        (if (gt i n) (list acc bad)
            (do (let a (list i (mul i 2) (str_concat "s" (int_to_str i))))
                (let b (list i (mul i 2) (str_concat "s" (int_to_str (mod (add i 1) 7)))))   ; differs when i mod 7 != i, i.e. i>=7 boundary
                (let c (list i (mul i 2) (str_concat "s" (int_to_str i))))                   ; equal to a
                (let r1 (veq a b)) (let r2 (veq a c))
                (let bad2 (if (eq r1 (value_eq a b)) (if (eq r2 (value_eq a c)) bad (add bad 1)) (add bad 1)))
                (sweep (add i 1) n (cs r1 (cs r2 acc)) bad2))))
    (let res (sweep 1 300 0 0))
    (let sweep-ok (eq (nth res 1) 0))
    (let told (print (list "scal" scal-ok "flat" flat-ok "nested" nested-ok "sweep" sweep-ok "checksum" (head res))))
    (add (ve-bit scal-ok 1) (add (ve-bit flat-ok 2) (add (ve-bit nested-ok 4) (ve-bit sweep-ok 8)))))
