; lora-adapter-band.fk — the body reads an adapter header as data.
; Expected: 31
;   1 header census: pairs, rank, dtype   2 layers touched lo..hi   4 byte span end
;   8 the last training iteration line   16 a header with no tensors answers absent
; preludes: form/form-stdlib/lora-adapter.bml
(do
    (defn lab-bit (ok bit) (if ok bit 0))
    (defn lab-q () (byte_to_str 34))
    (defn lab-h () (la-cat (list "{" (lab-q) "model.layers.20.self_attn.q_proj.lora_a" (lab-q) ":{" (lab-q) "dtype" (lab-q) ":" (lab-q) "F16" (lab-q) "," (lab-q) "shape" (lab-q) ":[8,3072]," (lab-q) "data_offsets" (lab-q) ":[0,49152]}," (lab-q) "model.layers.27.self_attn.q_proj.lora_b" (lab-q) ":{" (lab-q) "dtype" (lab-q) ":" (lab-q) "F16" (lab-q) "," (lab-q) "shape" (lab-q) ":[3072,8]," (lab-q) "data_offsets" (lab-q) ":[49152,98304]}}")))
    (defn lab-log () "Iter 1: Val loss 5.153\nIter 10: Train loss 4.183, Learning Rate 1.000e-04, It/sec 0.554, Tokens/sec 604.899, Trained Tokens 10911\nIter 20: Train loss 3.9, Learning Rate 1.000e-04, It/sec 0.5, Tokens/sec 500.1, Trained Tokens 2\n")
    (sum (list
        (lab-bit (and (eq (la-pairs (lab-h)) 1) (and (eq (la-rank-of (lab-h)) 8) (str_eq (la-dtype (lab-h)) "F16"))) 1)
        (lab-bit (and (eq (head (la-layers (lab-h))) 20) (eq (nth (la-layers (lab-h)) 1) 27)) 2)
        (lab-bit (eq (la-max-end (lab-h)) 98304) 4)
        (lab-bit (and (eq (la-iter (la-last-iter-line (lab-log))) 20) (and (str_eq (la-loss (la-last-iter-line (lab-log))) "3.9") (eq (la-tokens-sec (la-last-iter-line (lab-log))) 500))) 8)
        (lab-bit (and (eq (la-pairs "{}") 0) (and (eq (la-rank-of "{}") (sub 0 1)) (eq (str_len (la-last-iter-line "")) 0))) 16))))
