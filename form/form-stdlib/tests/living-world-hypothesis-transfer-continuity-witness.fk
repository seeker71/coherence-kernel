; living-world-hypothesis-transfer-continuity-witness.fk -- exact learned
; hypothesis/transition/symbol tissue can be found from a loaded world, restored
; only by fresh holders, and extended without rebuilding its fixture.
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-shared-field-channel.fk form-stdlib/living-world-generative-continuation.fk form-stdlib/living-world-hypothesis-transfer.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-transfer-witness.fk

(let LWHTRCW-CUSTODIAN (bp "LWHTRCW-CUSTODIAN"))
(let LWHTRCW-SOURCE-G (bp "LWHTRCW-SOURCE-G"))
(let LWHTRCW-SOURCE-H (bp "LWHTRCW-SOURCE-H"))
(let LWHTRCW-SOURCE-I (bp "LWHTRCW-SOURCE-I"))
(let LWHTRCW-SOURCE-J (bp "LWHTRCW-SOURCE-J"))
(let LWHTRCW-CONTEXT-A (bp "LWHTRCW-CONTEXT-A"))
(let LWHTRCW-CONTEXT-B (bp "LWHTRCW-CONTEXT-B"))
(let LWHTRCW-PROVENANCE (bp "LWHTRCW-PROVENANCE"))
(let LWHTRCW-RESPONSE-PROVENANCE (bp "LWHTRCW-RESPONSE-PROVENANCE"))
(let LWHTRCW-ACTION (bp "LWHTRCW-ACTION"))

(defn lwhtrcw-path ()
    "/tmp/coherence-living-world-hypothesis-transfer-20260809.ccs")
(defn lwhtrcw-grown-path ()
    "/tmp/coherence-living-world-hypothesis-transfer-20260809-grown.ccs")

(defn lwhtrcw-entry (source payload)
    (lwt-entry
        (lwo-offer source (lwo-interface (list LWHTRCW-ACTION)) 1
            payload LWHTRCW-PROVENANCE 1)
        LWHTRCW-ACTION))

(defn lwhtrcw-response-entry (source proposal)
    (lwhtrcw-entry source
        (lwt-response proposal
            (oac-one (lwt-proposal-candidate proposal))
            LWHTRCW-RESPONSE-PROVENANCE)))

(defn lwhtrcw-response-entries (items proposal entries)
    (if (eq (len items) 0) entries
        (lwhtrcw-response-entries (tail items) proposal
            (cons (lwhtrcw-response-entry (head items) proposal) entries))))

; Returns proposal, answered round, restored world.
(defn lwhtrcw-restore-image (image)
    (do
        (let admission
            (lwt-receive-stream (lwo-empty-world)
                (list (lwhtrcw-entry LWHTRCW-CUSTODIAN image))))
        (let proposal (lwcn-restore-proposal admission image))
        (let responses
            (lwhtrcw-response-entries
                (lwo-field-items (lwt-proposal-participants proposal))
                proposal (empty)))
        (let answered
            (lwt-round-receive
                (lwt-round admission (lwo-field (list proposal))
                    (lwo-empty-field) (lwo-none))
                responses))
        (let restored
            (lwcn-integrate-restore answered proposal LWHTRCW-ACTION))
        (list proposal answered (lwt-round-world restored))))

(defn lwhtrcw-find-transfer-items (world items)
    (if (eq (len items) 0) (lwo-none)
        (if (eq (lwhtr-candidate-active? world (head items)) 1)
            (head items)
            (lwhtrcw-find-transfer-items world (tail items)))))

(defn lwhtrcw-find-transfer (world)
    (lwhtrcw-find-transfer-items world
        (lwo-field-items (lwo-world-cells world))))

(defn lwhtrcw-request-for-plan (plan)
    (do
        (let offer (lwhtr-plan-offer plan))
        (lwsg-request (lwhtr-offer-context offer)
            (lwo-none) (lwo-none)
            (lwhtr-plan-alternatives plan) (lwhtr-plan-unknown plan)
            (lwo-none) (lwo-none) 0 (lwo-none))))

(defn lwhtrcw-context ()
    (lwtf-context (list LWHTRCW-CONTEXT-A LWHTRCW-CONTEXT-B)))

(defn lwhtrcw-offer-for-execution (execution alternatives unknown)
    (lwhtr-offer execution (lwhtrcw-context) (lwo-none)
        (oac-one (lwht-execution-output execution))
        alternatives unknown LWHTRCW-PROVENANCE))

(defn lwhtrcw-request-for-offer (offer)
    (lwsg-request (lwhtr-offer-context offer)
        (lwo-none) (lwo-none) (lwhtr-offer-alternatives offer)
        (lwhtr-offer-unknown offer) (lwo-none) (lwo-none) 0 (lwo-none)))
