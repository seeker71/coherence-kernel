; living-world-capability-context-band.fk -- no purpose inherits the whole body.
; Verdict 32767 proves fifteen enquiry, learning, voice, sharing, and revocation claims.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-enquiry.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-capability-context.fk form-stdlib/tests/living-world-recursive-witness.fk form-stdlib/tests/living-world-continuity-witness.fk

(do
    (let image (lwcnw-image))
    (let admission (lwcnw-admission-world image))
    (let restore-proposal (lwcnw-restore-proposal admission image))
    (let restore-candidate (lwt-proposal-candidate restore-proposal))
    (let restored-round (lwcnw-restored-round-from-image image))
    (let restored-world (lwt-round-world restored-round))
    (let world (lwcnw-full-capability-world restored-world))

    (let learn-context
        (lwcp-context world (lwcnw-learn-capability)))
    (let query-context
        (lwcp-context world (lwcnw-query-capability)))
    (let voice-context
        (lwcp-context world (lwcnw-voice-capability)))
    (let learn-world (lwcp-context-world learn-context))
    (let query-world (lwcp-context-world query-context))
    (let voice-world (lwcp-context-world voice-context))
    (let mapping (lwcnw-mapping-candidate))

    (let voice-revoked
        (lwcnw-release-grant world
            (lwrrw-source-b) (lwrrw-provenance-b)
            (lwcnw-shared) (lwcnw-voice-capability)))
    (let voice-after
        (lwcp-context voice-revoked (lwcnw-voice-capability)))

    (let query-revoked
        (lwcnw-release-grant world
            (lwrrw-source-a) (lwrrw-provenance-a)
            mapping (lwcnw-query-capability)))
    (let query-after
        (lwcp-context query-revoked (lwcnw-query-capability)))

    (let learn-revoked
        (lwcnw-release-grant world
            (lwrrw-source-b) (lwrrw-provenance-b)
            (lwrrw-correspondence-b) (lwcnw-learn-capability)))
    (let learn-after
        (lwcp-context learn-revoked (lwcnw-learn-capability)))

    ; A non-holder may offer a syntactically exact grant, but its attribution
    ; cannot authorize source A's private payload.
    (let forged-world
        (lwt-receive-stream world
            (list
                (lwcnw-grant-entry
                    (lwrrw-source-e) (lwrrw-provenance-e)
                    (lwcnw-private) (lwcnw-voice-capability)))))
    (let forged-context
        (lwcp-context forged-world (lwcnw-voice-capability)))

    (let c1 (lwcn-restored? restored-world restore-candidate))
    ; Learning receives exact correspondence evidence, not the raw world.
    (let c2 (if (eq (lwo-field-size
                         (lwrr-proposals learn-world 2)) 1) 2 0))
    (let c3 (if (and (eq (lwo-active? learn-world
                              (lwrrw-correspondence-a)) 1)
                         (eq (lwo-active? learn-world mapping) 0)) 4 0))
    ; Enquiry receives the steady mapping and explicit focus only when every
    ; underlying holder has granted this purpose.
    (let c4 (if (eq (lwo-field-size
                         (lwen-question-proposals query-world)) 1) 8 0))
    (let c5 (if (and (eq (lwrl-steady? query-world mapping) 1)
                         (eq (lwo-active?
                              query-world (lwcnw-focus)) 1)) 16 0))
    (let c6 (if (eq (lwo-active?
                         voice-world (lwcnw-shared)) 1) 32 0))
    (let c7 (if (eq (lwo-active?
                         voice-world (lwcnw-private)) 0) 64 0))
    (let c8 (if (eq (lwo-active? voice-world
                         (lwcp-grant (lwcnw-shared)
                            (lwcnw-voice-capability)
                            (lwcnw-grant-evidence
                                (lwcnw-voice-capability)))) 0) 128 0))
    (let c9 (if (and (eq (lwo-field-size
                              (lwcp-context-grant-evidence
                                learn-context)) 3)
                         (and (eq (lwo-field-size
                                   (lwcp-context-grant-evidence
                                    query-context)) 5)
                              (eq (lwo-field-size
                                   (lwcp-context-grant-evidence
                                    voice-context)) 1))) 256 0))
    (let c10 (if (and (eq (lwo-active?
                               (lwcp-context-world voice-after)
                               (lwcnw-shared)) 0)
                          (eq (lwcp-context-current?
                               voice-revoked voice-context) 0)) 512 0))
    (let c11 (if (and (eq (lwo-active?
                               (lwcp-context-world query-after)
                               mapping) 0)
                          (eq (lwo-field-size
                               (lwen-question-proposals
                                (lwcp-context-world query-after))) 0)) 1024 0))
    (let c12 (if (and (eq (lwo-active?
                               (lwcp-context-world learn-after)
                               (lwrrw-correspondence-b)) 0)
                          (eq (lwo-field-size
                               (lwrr-proposals
                                (lwcp-context-world learn-after) 2)) 0)) 2048 0))
    (let c13 (if (eq (lwo-active?
                          (lwcp-context-world forged-context)
                          (lwcnw-private)) 0) 4096 0))
    (let c14 (if (and (node_eq
                           (lwcp-context-capability query-context)
                           (lwcnw-query-capability))
                          (node_eq (lwcp-context-path query-context)
                                   (lwo-local-path))) 8192 0))
    (let c15 (if (and (eq (lwcp-context-current?
                               world learn-context) 1)
                          (and (eq (lwcp-context-current?
                                    world query-context) 1)
                               (eq (lwcp-context-current?
                                    world voice-context) 1))) 16384 0))
    (lwcnw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
