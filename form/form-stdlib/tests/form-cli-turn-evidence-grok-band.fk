; form-cli-turn-evidence-grok-band.fk — BML grok meter is used.
;
; Verdict 1023:
;   1..128  fctg-check fixture receipts (same 255 as the s-expr landing)
;   256     class descriptor FormGrokEvidence minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk
; preludes: form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-turn-evidence.fk
; preludes: form-stdlib/form-cli-turn-evidence-live.fk
; preludes: form-stdlib/form-cli-turn-evidence-grok-xtal.fk
; witnessed: 2026-08-24 -> 1023 on fkwu, exit 0; BML class/template/const

(do
    (defn fctg-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn fctg-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (fctg-has-name? (tail xs) name))))

    (let bits (fctg-check))
    (let desc (FormGrokEvidence))
    (let src (read_file "form/form-stdlib/bml/form-cli-turn-evidence-grok.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormGrokEvidence")
                     (and (eq (fctg-has-name? (nth desc 2) "T") 1)
                          (and (eq (fctg-has-name? (nth desc 3) "fctg-row") 1)
                               (eq (fctg-has-name? (nth desc 4) "ReceiptMark") 1))))
                256 0))
    (let b9 (if (and (eq (fctg-has-str? src "package Form.cli.evidence.grok") 1)
                     (and (eq (fctg-has-str? src "interface IGrokMeter") 1)
                          (and (eq (fctg-has-str? src "class FormGrokEvidence") 1)
                               (and (eq (fctg-has-str? src "const String ReceiptMark") 1)
                                    (eq (fctg-has-str? src "template ReceiptAcc") 1)))))
                512 0))
    (add bits (add b8 b9)))
