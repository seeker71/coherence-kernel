; form-cli-turn-evidence-grok-band.fk — real @form receipts become a valid row.
;
; Verdict 255:
;   1  two fixture logs count 2 fkwu + 1 git
;   2  grok source is accepted
;   4  that row is valid and kind=observed
;   8  native/local/remote are 2/1/1
;  16  shown bytes = stdout+stderr
;  32  share sums to 100
;  64  unmeasured stays declared
; 128  Codex fixture still observed
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk
; preludes: form-stdlib/form-cli-turn-evidence.fk
; preludes: form-stdlib/form-cli-turn-evidence-live.fk
; preludes: form-stdlib/form-cli-turn-evidence-grok.fk
; witnessed: 2026-08-24 -> 255 on fkwu, exit 0; live refresh then
;   observed native=405 local=461 remote=104 share 42/47/11

(do
    (defn fctgb (ok bit) (if ok bit 0))
    (let p1 (str_concat (fs-temp-dir) "/fk-grok-a.log"))
    (let p2 (str_concat (fs-temp-dir) "/fk-grok-b.log"))
    (let w1 (fs-write-text p1 "@form fkwu 0 10 2 12\n@form git 1 3 1 4\n"))
    (let w2 (fs-write-text p2 "@form fkwu 0 5 0 5\nnot a receipt\n"))
    (let acc (fctg-add6 (fctg-file p1) (fctg-file p2)))
    (let row (fctg-row "thread-g" "turn-g" (nth acc 0) (nth acc 2)
                       (nth acc 1) (nth acc 3) 1
                       (nth acc 4) (nth acc 5) (nth acc 6)
                       2 1000 2000))
    (let e (fcte-parse row))
    (let share (fcte-boundary-share e))
    (let c0 (fctgb (and (eq (nth acc 0) 2) (eq (nth acc 1) 1)) 1))
    (let c1 (fctgb (str_eq (fcte-source e) (fcte-source-kind-grok)) 2))
    (let c2 (fctgb (and (eq (fcte-valid? e) 1)
                        (str_eq (fcte-kind-name e) "observed")) 4))
    (let c3 (fctgb (and (eq (fcte-native-commands e) 2)
                        (and (eq (fcte-local-events e) 1)
                             (eq (fcte-remote-events e) 1))) 8))
    (let c4 (fctgb (eq (fcte-form-shown-bytes e)
                       (add (fcte-form-stdout-bytes e) (fcte-form-stderr-bytes e))) 16))
    (let c5 (fctgb (eq (sum share) 100) 32))
    (let c6 (fctgb (str_eq (fcte-kind-name (fcte-parse "unmeasured")) "declared") 64))
    (let c7 (fctgb (str_eq (fcte-kind-name (fcte-parse
        "turn-evidence-v1|thread-1|turn-1|openai|gpt-test|1000|2000|1000|100|128|2|1000|600|400|0|200|50|1200|3|3|400|2048|2|1|100|20|120|1|0|2|2|5|1|codex-rollout-jsonl+explicit-form-binding|1"))
        "observed") 128))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))
)
