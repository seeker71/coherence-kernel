; Fourth process: load the adopted carrier as inert evidence, require fresh
; unanimous restoration, and prove that the revised execution, alternatives,
; unknowns, and still-pending timeout survive an independent native process.
; Verdict 65535 proves sixteen reload and semantic-continuity claims.
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk form-stdlib/tests/living-world-durable-learning-witness.fk

(do
    (let loaded (lwdlw-load-image (lwdlw-final-path)))
    (let image (lwcd-result-image loaded))
    (let admission (lwdlw-admission-world image))
    (let admission-selections (lwdlw-current-selections admission))
    (let admission-executions (lwdlw-current-executions admission))
    (let restored-round (lwdlw-restored-round image))
    (let restored (lwt-round-world restored-round))
    (let restore-proposal
        (head (lwo-field-items (lwt-round-proposals restored-round))))
    (let restore-candidate (lwt-proposal-candidate restore-proposal))
    (let field (lwacw-field-for restored))
    (let eligible
        (lwac-eligible-items restored
            (lwo-field-items (lwac-field-candidates field)) 2
            (lwo-empty-field)))
    (let active-learning (lwdlw-active-learning restored))
    (let learning-candidate (lwdlw-only active-learning))
    (let successors
        (lwdlw-successor-offers restored learning-candidate))
    (let successor (lwdlw-only successors))
    (let selections (lwdlw-current-selections restored))
    (let executions (lwdlw-current-executions restored))
    (let execution-candidate (lwdlw-only executions))
    (let execution (lwo-emergent-shape execution-candidate))
    (let time-observation (lwac-execution-time-observation execution))
    (let timeout
        (lwac-intention-timeout (lwac-execution-intention execution)))
    (lwdlw-sum
        (list
            (if (eq (lwcd-loaded? loaded) 1) 1 0)
            (if (eq (lwcn-image-valid? image) 1) 2 0)
            (if (and (eq (lwo-field-size admission-selections) 0)
                     (eq (lwo-field-size admission-executions) 0)) 4 0)
            (if (eq (lwcn-restored? restored restore-candidate) 1) 8 0)
            (if (and (eq (lwac-ready? (lwac-field-status field)) 1)
                     (and (eq (lwo-field-size
                                (lwac-field-candidates field)) 2)
                          (and (eq (lwo-field-size eligible) 1)
                               (not (node_eq (lwac-field-primary field)
                                             (lwo-none)))))) 16 0)
            (if (eq (lwo-field-size active-learning) 1) 32 0)
            (if (and (eq (lwo-field-size successors) 1)
                     (node_eq
                        (lwac-intention-prediction
                            (lwac-intention-evidence-intention
                                (lwac-field-primary field)))
                        (lwacw-actual-delta))) 64 0)
            (if (and (eq (lwo-active-by? restored successor
                              (lwacw-source-c)) 1)
                     (eq (lwo-active-by? restored successor
                              (lwacw-source-d)) 1)) 128 0)
            (if (and (eq (lwo-active-by? restored (lwacw-offer-a)
                              (lwacw-source-c)) 0)
                     (eq (lwo-active-by? restored (lwacw-offer-a)
                              (lwacw-source-d)) 0)) 256 0)
            (if (eq (lwo-field-size selections) 1) 512 0)
            (if (eq (lwo-field-size executions) 1) 1024 0)
            (if (and (node_eq (lwac-execution-prediction execution)
                              (lwacw-actual-delta))
                     (node_eq (lwac-execution-actual execution)
                              (lwacw-actual-delta))) 2048 0)
            (if (eq (oac-one?
                        (lwac-execution-comparison execution)) 1) 4096 0)
            (if (and (gt (lwo-field-size
                            (lwac-execution-alternatives execution)) 0)
                     (gt (lwo-field-size
                            (lwac-execution-unknowns execution)) 0)) 8192 0)
            (if (and (eq (oac-time-pending? time-observation) 1)
                     (and (not (node_eq time-observation (oac-nothing)))
                          (eq (oac-time-outcome? time-observation) 0)))
                16384 0)
            (if (and (eq (oac-timeout? timeout) 1)
                     (eq (oac-alternative-ack?
                            (oac-timeout-default timeout)) 1)) 32768 0))))
