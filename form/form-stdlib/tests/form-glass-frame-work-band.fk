; form-glass-frame-work-band.fk — the live glass loop's frame work rests inside its budget.
;
; The loop behind observe/form-glass-run.fk (observe/form-glass-live-run.fk) is spawned here as a
; quiet child and left to tick. Its own cadence rows, given into a child-PID-private gift frame every tick,
; are the witness: frame-work-ms includes collection, control and acknowledged terminal output;
; frame-wait-ms is the wait between collection and presentation. The child's live page carries its hottest
; defn rows (kernel_page_hot) and its dispatch word (kernel_live). Every projection node names a
; field once (fgo-field-node), so the kernel's framebuffer root list stays the count of distinct
; fields instead of growing by one root per row per frame; the framebuffer/events row on the frame
; carries that count. The child is killed by pid at the end, never by name.
; Test output never replaces live Glass frames, supervisor marks, or owner controls.
;
; preludes: form/form-stdlib/form-glass-sensor-rows.bml
;
; The frames stay open: the loop keeps one handle per gift frame it meets (ggf-kept-*), so the
; child's own gift-frames row (kernel_stat 41) stands in the tens and neither crc32-fold8 (the
; name hash) nor fgd-find-metric (the row scan; the loop reads through one keyed index a frame)
; appears among its sixteen hottest defns; the keyed index answers what the scan answers.
;
; One pass a line: every changed line's bytes are consed once from the end (ftcb-onto-*), never
; copied through an append chain; the atlas tokens are strings, the state is classified once a
; cell, the flow lanes walk only the points their spark shows, and the per-kernel rows join
; through str_concat -- so fgd-cat leaves the child's eight hottest defns and a tick costs under
; 1,500,000 dispatches (1.20-1.31M witnessed, the spread being sibling publishers moving).
;
; Verdict 32767: child spawned; the glass frame moved with rows; at least 20 ticks; frame work under
; 30 ms; a nonzero rest; framebuffer roots bounded under 2000; fgd-cat under a quarter of the
; hottest defn's heat; the child ended on its pid; the keyed index agrees with the scan on every
; row and on a miss; crc32-fold8 off the top sixteen; fgd-find-metric off the top sixteen; the
; child holds at least ten gift frames open; under 3,000,000 dispatches a tick over the rest;
; under 1,500,000 dispatches a tick; fgd-cat off the top eight.

(do
    (defn fgfw-bit (ok weight) (if ok weight 0))
    (defn fgfw-find (rows domain id)
        (if (eq (len rows) 0) (list)
            (if (and (str_eq (fgo-domain (head rows)) domain) (str_eq (fgo-id (head rows)) id)) (head rows) (fgfw-find (tail rows) domain id))))
    (defn fgfw-value (rows domain id) (if (eq (len (fgfw-find rows domain id)) 0) -1 (fgo-int-value (fgfw-find rows domain id))))
    (defn fgfw-sequence (rows domain id) (if (eq (len (fgfw-find rows domain id)) 0) -1 (fgo-observation-sequence (fgfw-find rows domain id))))
    (defn fgfw-heat-of (page name held)
        (if (eq (len page) 0) held
            (if (str_eq (nth (head page) 1) name) (nth (head page) 0) (fgfw-heat-of (tail page) name held))))
    (defn fgfw-hottest (page held)
        (if (eq (len page) 0) held (fgfw-hottest (tail page) (if (gt (nth (head page) 0) (nth held 0)) (head page) held))))
    ; Warm the child's caches and hot leaves for 200 ticks before measuring.
    ; The four-second measured interval excludes cold admission, not live work.
    (defn fgfw-held (child)
        (do (let name (str_concat (str_concat "glass.band.frame-work." (int_to_str child)) ".sensor"))
            (let handle (ggf-receive name))
            (let held (fgsr-take-held handle (ggf-name name) (list)))
            (let released (ggf-release handle))
            held))
    (defn fgfw-await (child seq0 patience)
        (do (let rested (host_sleep_ms 1000))
            (let held (fgfw-held child))
            (if (and (not (eq (fgsr-held-seq held) seq0)) (ge (fgfw-sequence (fgsr-held-rows held) "glass" "frame-work-ms") 200)) held
                (if (or (le patience 0) (le (host_alive child) 0)) held (fgfw-await child seq0 (sub patience 1))))))
    (defn fgfw-word (live k) (if (lt (len live) (add k 1)) -1 (nth live k)))
    (defn fgfw-take (page n) (if (or (le n 0) (eq (len page) 0)) (list) (cons (head page) (fgfw-take (tail page) (sub n 1)))))
    ; the keyed index answers what the scan answers: the same row (by id and value) for every id the rows carry
    (defn fgfw-index-agrees (index rows all)
        (if (eq (len rows) 0) 1
            (if (and (str_eq (fgo-id (fgd-index-find index (fgo-id (head rows)))) (fgo-id (fgd-find-metric all (fgo-id (head rows)))))
                     (eq (fgo-int-value (fgd-index-find index (fgo-id (head rows)))) (fgo-int-value (fgd-find-metric all (fgo-id (head rows))))))
                (fgfw-index-agrees index (tail rows) all)
                0)))
    (defn main ()
        (do
            (let seq0 -1)
            (let child (host_spawn_quiet (list "./fkwu" "form/form-stdlib/tests/form-glass-frame-work-child.fk")))
            (let settled (fgfw-await child seq0 150))
            (let ticks0 (fgfw-sequence (fgsr-held-rows settled) "glass" "frame-work-ms"))
            (let dispatches0 (fgfw-word (kernel_live child) 4))
            (let rested (host_sleep_ms 4000))
            (let held (fgfw-held child))
            (let rows (fgsr-held-rows held))
            (let ticks (fgfw-sequence rows "glass" "frame-work-ms"))
            (let work (fgfw-value rows "glass" "frame-work-ms"))
            (let wait (fgfw-value rows "glass" "frame-wait-ms"))
            (let budget (fgfw-value rows "glass" "frame-budget-ms"))
            (let events (fgfw-value rows "framebuffer" "events"))
            (let giftFrames (fgfw-value rows "kernel" "gift-frames"))
            (let page16 (kernel_page_hot child 16))
            (let page (fgfw-take page16 8))
            (let live (kernel_live child))
            (let dispatches (fgfw-word live 4))
            (let restTicks (sub ticks ticks0))
            (let perTick (if (and (gt restTicks 0) (and (ge dispatches0 0) (ge dispatches dispatches0))) (div (sub dispatches dispatches0) restTicks) -1))
            (let hottest (fgfw-hottest page (list 0 "none")))
            (let catHeat (fgfw-heat-of page "fgd-cat" 0))
            (let crcHeat (fgfw-heat-of page16 "crc32-fold8" 0))
            (let findHeat (fgfw-heat-of page16 "fgd-find-metric" 0))
            (let index (fgd-metric-index rows))
            (let agrees (if (eq (len rows) 0) 0 (if (eq (fgfw-index-agrees index rows rows) 1) (if (eq (len (fgd-index-find index "fgfw.no-such-metric")) 0) 1 0) 0)))
            (let ended (if (gt child 0) (host_kill child) -1))
            (let waited (if (gt child 0) (host_wait child) 0))
            (let shown (print (list "frame-work-ms" work "frame-wait-ms" wait "budget" budget "ticks" ticks "framebuffer-events" events "hottest" (nth hottest 1) (nth hottest 0) "fgd-cat" catHeat "crc32-fold8" crcHeat "fgd-find-metric" findHeat "gift-frames" giftFrames "dispatches-per-tick" perTick "rest-ticks" restTicks "index-agrees" agrees)))
            (add (fgfw-bit (gt child 0) 1)
            (add (fgfw-bit (and (not (eq (fgsr-held-seq held) seq0)) (gt (len rows) 0)) 2)
            (add (fgfw-bit (ge ticks 20) 4)
            (add (fgfw-bit (and (ge work 0) (lt work 30)) 8)
            (add (fgfw-bit (gt wait 0) 16)
            (add (fgfw-bit (and (ge events 0) (lt events 2000)) 32)
            (add (fgfw-bit (and (gt (nth hottest 0) 0) (lt (mul catHeat 4) (nth hottest 0))) 64)
            (add (fgfw-bit (ge ended 0) 128)
            (add (fgfw-bit (eq agrees 1) 256)
            (add (fgfw-bit (eq crcHeat 0) 512)
            (add (fgfw-bit (eq findHeat 0) 1024)
            (add (fgfw-bit (ge giftFrames 10) 2048)
            (add (fgfw-bit (and (gt perTick 0) (lt perTick 3000000)) 4096)
            (add (fgfw-bit (and (gt perTick 0) (lt perTick 1500000)) 8192)
                 (fgfw-bit (eq catHeat 0) 16384)))))))))))))))))
    (print (main)))
