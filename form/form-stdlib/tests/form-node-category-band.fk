; form-node-category-band.fk — role is explicit beside, never inferred from, p.l.t.i.
; Verdict 8388607.
; preludes: form/form-stdlib/core.fk form/form-stdlib/form-node-category.bml

(do
    (defn fncb-bit (condition weight) (if (eq condition 1) weight 0))
    (let node (oti-apply (oti-operator (oti-family 1 2 99) 1703) (list 7 8 9)))
    (let cellBinding (fnc-from-node node "cell" "request"))
    (let blueprintBinding (fnc-binding (fnc-binding-cell cellBinding) (fnc-binding-category cellBinding) (fnc-binding-family cellBinding) "blueprint" "request"))
    (let recipeBinding (fnc-binding (fnc-binding-cell cellBinding) (fnc-binding-category cellBinding) (fnc-binding-family cellBinding) "recipe" "request"))
    (let falseFamily (fnc-binding (fnc-binding-cell cellBinding) (fnc-binding-category cellBinding) "1.2.98" "cell" "request"))
    (let packed32 (fnc-pack-values 15 15 255 65535))
    (let packed64 (fnc-pack-values 255 255 65535 (oti-u32-max)))
    (let packedNode (fnc-pack-node node))
    (let parsed32 (fnc-packed-from-key (fnc-packed-key packed32)))
    (let parsed64 (fnc-packed-from-key (fnc-packed-key packed64)))
    (let overflow64 (fnc-pack-values 256 1 1 1))
    (let invalid80 (fnc-pack-values 65536 1 1 1))
    (let transitionPackage (fnc-pack-values 16 0 0 0))
    (let transitionLevel (fnc-pack-values 0 16 0 0))
    (let transitionType (fnc-pack-values 0 0 256 0))
    (let transitionInstance (fnc-pack-values 0 0 0 65536))
    (let invalidPacked32 (fnc-packed (FNCPackedStatus) 32 1 0 "p4.l4.t8.i16"))
    (sum (list
        (fncb-bit (fnc-binding-valid? cellBinding) 1)
        (fncb-bit (str_eq (fnc-binding-category cellBinding) "1.2.99.1703") 2)
        (fncb-bit (str_eq (fnc-binding-family cellBinding) "1.2.99") 4)
        (fncb-bit (str_eq (fnc-binding-role cellBinding) "cell") 8)
        (fncb-bit (fnc-binding-valid? blueprintBinding) 16)
        (fncb-bit (fnc-binding-valid? recipeBinding) 32)
        (fncb-bit (and (str_eq (fnc-binding-cell blueprintBinding) (fnc-binding-cell recipeBinding)) (not (str_eq (fnc-binding-role blueprintBinding) (fnc-binding-role recipeBinding)))) 64)
        (fncb-bit (eq (fnc-binding-valid? falseFamily) 0) 128)
        (fncb-bit (and (eq (fnc-packed-width packed32) 32)
                       (fnc-packed-roundtrip? packed32 15 15 255 65535)) 256)
        (fncb-bit (and (eq (fnc-packed-low packed32) (oti-u32-max))
                       (str_eq (fnc-packed-key packed32) "n32.1z141z3")) 512)
        (fncb-bit (and (eq (fnc-packed-width packed64) 64)
                       (fnc-packed-roundtrip? packed64 255 255 65535 (oti-u32-max))) 1024)
        (fncb-bit (and (eq (fnc-packed-high packed64) (oti-u32-max))
                       (and (eq (value_eq (fnc-unpack parsed32) (fnc-unpack packed32)) 1)
                            (eq (value_eq (fnc-unpack parsed64) (fnc-unpack packed64)) 1))) 2048)
        (fncb-bit (and (eq (fnc-packed-ok? packedNode) 1)
                       (fnc-packed-roundtrip? packedNode (node_pkg node) (node_level node) (node_type node) (node_inst node))) 4096)
        (fncb-bit (and (str_eq (fnc-packed-status overflow64) "overflow")
                       (and (str_eq (fnc-packed-reason overflow64) "coordinate-exceeds-p8.l8.t16.i32")
                            (str_eq (fnc-packed-reason invalid80) "coordinate-outside-u16.u16.u16.u32"))) 8192)
        (fncb-bit (and (eq (fnc-packed-width transitionPackage) 64)
                       (fnc-packed-roundtrip? transitionPackage 16 0 0 0)) 16384)
        (fncb-bit (and (eq (fnc-packed-width transitionLevel) 64)
                       (fnc-packed-roundtrip? transitionLevel 0 16 0 0)) 32768)
        (fncb-bit (and (eq (fnc-packed-width transitionType) 64)
                       (fnc-packed-roundtrip? transitionType 0 0 256 0)) 65536)
        (fncb-bit (and (eq (fnc-packed-width transitionInstance) 64)
                       (fnc-packed-roundtrip? transitionInstance 0 0 0 65536)) 131072)
        (fncb-bit (and (eq (fnc-packed-ok? invalidPacked32) 0)
                       (nothing? (fnc-packed-key invalidPacked32))) 262144)
        (fncb-bit (and (str_eq (fnc-packed-status (fnc-packed-from-key "n32.01")) "overflow")
                       (and (str_eq (fnc-packed-status (fnc-packed-from-key "n64.0.01")) "overflow")
                            (str_eq (fnc-packed-reason (fnc-packed-from-key "n64.0.1")) "packed-key-nonadaptive"))) 524288)
        (fncb-bit (and (str_eq (fnc-packed-status (fnc-packed-from-key "n32.A")) "overflow")
                       (str_eq (fnc-packed-status (fnc-packed-from-key "n32.1.extra")) "overflow")) 1048576)
        (fncb-bit (and (str_eq (fnc-packed-status (fnc-packed-from-key "n32.1z141z4")) "overflow")
                       (nothing? (fnc-packed-key overflow64))) 2097152)
        (fncb-bit (and (str_eq (fnc-packed-status (fnc-pack-values -1 0 0 0)) "overflow")
                       (and (str_eq (fnc-packed-status (fnc-pack-values 0 256 0 0)) "overflow")
                            (and (str_eq (fnc-packed-status (fnc-pack-values 0 0 65536 0)) "overflow")
                                 (str_eq (fnc-packed-status (fnc-pack-values 0 0 0 (add (oti-u32-max) 1))) "overflow")))) 4194304))))
