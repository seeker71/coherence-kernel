; tests/vedic-chat-band.fk — a Vedic chart cast natively and answered in words, four-way.
;
; The chart under test is the one the body attests: Urs, 1971-10-06 08:15 UT, Luzern.
; Every placement below was confirmed by an independent ephemeris (pyephem, epoch-of-date,
; 2026-09-18): nine of nine grahas land the same rashi, the same nakshatra and the same
; pada; the lagna lands Tula 18.2 deg (witness 18.236); the Rahu mahadasha runs in 2026.
;
; Verdict 1111111 (127) when every claim holds across all four kernels.
;   the dated Lahiri ayanamsa: 23.85 at J2000, 23.46 at the birth       -> 1
;   the tables: 27 nakshatras, Revati's lord Budha; Surya = Sun one cell -> 10
;   the Moon: Mesha, Bharani pada 1 (janma nakshatra); Sun: Kanya, Hasta -> 100
;   the lagna: Tula, Swati; the Moon sits in the 7th bhava               -> 1000
;   the outer grahas: Mars Makara/Shravana, Jupiter Vrishchika/Anuradha,
;     Saturn Vrishabha/Rohini, Rahu Makara, Ketu Karka                    -> 10000
;   the dasha: born in the Venus period, Rahu running in 2026,
;     the cycle sums to 120                                              -> 100000
;   the chat: "moon" names Bharani; "dasha 2026" names Rahu; an unknown
;     question answers the door's honest listing; and the chart as JSON
;     carries the Moon's star, pada and house, the lagna, the Rahu row   -> 1000000
;
; preludes: form-stdlib/core.fk form-stdlib/guidance-channel.fk form-stdlib/celestial-pole-channel.fk form-stdlib/trig.fk form-stdlib/ephemeris-sun.fk form-stdlib/ephemeris-moon.fk form-stdlib/ephemeris-nodes.fk form-stdlib/ephemeris-planets.fk form-stdlib/iching-channel.fk form-stdlib/hd-mandala-wheel.fk form-stdlib/genekey-profile.fk form-stdlib/zodiac-channel.fk form-stdlib/vedic-chat.fk
;

(do
    (let mo (urs-birth-moment))

    ;; --- 1. the ayanamsa is dated -------------------------------------
    (let ayan-ok
        (if (eq (floor (mul (vc-lahiri 0.0) 100.0)) 2385)
            (if (eq (floor (mul (vc-lahiri (vc-nf mo)) 100.0)) 2345) 1 0) 0))

    ;; --- 2. the tables ------------------------------------------------
    (let tables-ok
        (if (eq (nakshatra-coverage) 27)
            (if (eq (dasha-lord-of-nakshatra 26) 3)
                (if (eq (graha-one-cell? 0) 1)
                    (if (str_eq (graha-name 0) "Surya") 10 0) 0) 0) 0))

    ;; --- 3. the luminaries --------------------------------------------
    (let moon (vc-graha mo 1))
    (let sun  (vc-graha mo 0))
    (let lum-ok
        (if (eq (pl-rashi moon) 0)
            (if (eq (pl-nak moon) 1)
                (if (eq (pl-pada moon) 1)
                    (if (eq (pl-rashi sun) 5)
                        (if (eq (pl-nak sun) 12) 100 0) 0) 0) 0) 0))

    ;; --- 4. the lagna and a bhava -------------------------------------
    (let lagna (vc-lagna mo))
    (let lagna-ok
        (if (eq (vc-rashi lagna) 6)
            (if (eq (vc-nakshatra lagna) 14)
                (if (eq (vc-house (pl-rashi moon) (vc-lagna-rashi mo)) 7) 1000 0) 0) 0))

    ;; --- 5. the outer grahas ------------------------------------------
    (let mars (vc-graha mo 2))
    (let jup  (vc-graha mo 4))
    (let sat  (vc-graha mo 6))
    (let rahu (vc-graha mo 7))
    (let ketu (vc-graha mo 8))
    (let outer-ok
        (if (eq (pl-rashi mars) 9) (if (eq (pl-nak mars) 21)
        (if (eq (pl-rashi jup) 7)  (if (eq (pl-nak jup) 16)
        (if (eq (pl-rashi sat) 1)  (if (eq (pl-nak sat) 3)
        (if (eq (pl-rashi rahu) 9) (if (eq (pl-rashi ketu) 3) 10000 0) 0) 0) 0) 0) 0) 0) 0))

    ;; --- 6. the dasha -------------------------------------------------
    (let dashas (vc-dashas mo))
    (let dasha-ok
        (if (eq (ds-lord (head dashas)) 5)
            (if (eq (vc-dasha-lord-at mo 2026.7) 7)
                (if (eq (dasha-cycle-years) 120)
                    (if (eq (len dashas) 9) 100000 0) 0) 0) 0))

    ;; --- 7. the chat --------------------------------------------------
    (let chart-json (urs-chart-json 2026.7))
    (let chat-ok
        (if (ge (str_find (vedic-respond "where is my moon?") "Bharani" 0) 0)
            (if (ge (str_find (vedic-respond "which dasha runs in 2026") "the Rahu mahadasha" 0) 0)
                (if (ge (str_find (vedic-respond "hello there") "Ask about" 0) 0)
                    (if (ge (str_find chart-json "\"nakshatra_name\":\"Bharani\",\"pada\":1,\"house\":7" 0) 0)
                        (if (ge (str_find chart-json "\"lagna\":{\"longitude\":198." 0) 0)
                            (if (ge (str_find chart-json "\"name\":\"Rahu\",\"english\":\"Rahu\",\"start\":2012." 0) 0) 1000000 0) 0) 0) 0) 0) 0))

    (sum (list ayan-ok tables-ok lum-ok lagna-ok outer-ok dasha-ok chat-ok)))
