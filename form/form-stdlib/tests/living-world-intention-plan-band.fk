; living-world-intention-plan-band.fk -- consented edges derive, never dictate.
; Verdict 32767 proves fifteen READY, STOP, BRANCH, CYCLE, and openness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/tests/living-world-intention-graph-witness.fk

(do
    (let fixture (lwigw-build-fixture))
    (let a (lwigw-a fixture))
    (let b (lwigw-b fixture))
    (let c (lwigw-c fixture))
    (let d (lwigw-d fixture))
    (let linear (lwigw-linear-worlds fixture))
    (let stop-world (nth linear 0))
    (let linear-world (nth linear 1))
    (let ab-candidate (nth linear 2))
    (let linear-round (nth linear 4))
    (let stop-plan
        (lwig-plan-for stop-world a (lwigw-nodes-abc fixture)))
    (let ready-plan
        (lwig-plan-for linear-world a (lwigw-nodes-abc fixture)))
    (let branch-built
        (lwigw-branch-world fixture linear-world linear-round))
    (let branch-world (nth branch-built 0))
    (let ad-candidate (nth branch-built 1))
    (let branch-round (nth branch-built 2))
    (let branch-plan
        (lwig-plan-for branch-world a (lwigw-nodes-abcd fixture)))
    (let cycle-built
        (lwigw-cycle-world fixture branch-world branch-round))
    (let cycle-world (nth cycle-built 0))
    (let cycle-ad-candidate (nth cycle-built 3))
    (let cycle-plan
        (lwig-plan-for cycle-world a (lwigw-nodes-ad fixture)))
    (let stop-items
        (lwig-sequence-items (lwig-plan-sequence stop-plan)))
    (let ready-items
        (lwig-sequence-items (lwig-plan-sequence ready-plan)))
    (let branch-items
        (lwig-sequence-items (lwig-plan-sequence branch-plan)))
    (let cycle-items
        (lwig-sequence-items (lwig-plan-sequence cycle-plan)))

    (let c1
        (if (and (eq (lwig-plan-current? stop-world stop-plan) 1)
                 (and (eq (lwig-plan-current? linear-world ready-plan) 1)
                      (and (eq (lwig-plan-current?
                                  branch-world branch-plan) 1)
                           (eq (lwig-plan-current?
                                  cycle-world cycle-plan) 1)))) 1 0))
    (let c2
        (if (and (node_eq (lwig-plan-status stop-plan) (lwig-stop))
                 (and (eq (len stop-items) 2)
                      (and (node_eq (nth stop-items 0) a)
                           (node_eq (nth stop-items 1) b)))) 2 0))
    (let c3
        (if (and (eq (lwo-field-size
                         (lwig-plan-remaining stop-plan)) 1)
                 (and (eq (lwo-field-has?
                              (lwig-plan-remaining stop-plan) c) 1)
                      (eq (lwo-field-size
                              (lwig-plan-stops stop-plan)) 1))) 4 0))
    (let c4
        (if (and (not (node_eq (lwig-plan-unknown stop-plan)
                               (lwo-none)))
                 (eq (lwo-field-has?
                         (lwig-plan-alternatives stop-plan) d) 1)) 8 0))
    (let c5
        (if (and (node_eq (lwig-plan-status ready-plan) (lwig-ready))
                 (and (eq (len ready-items) 3)
                      (and (node_eq (nth ready-items 0) a)
                           (and (node_eq (nth ready-items 1) b)
                                (node_eq (nth ready-items 2) c))))) 16 0))
    (let c6
        (if (and (eq (lwo-field-size
                         (lwig-plan-remaining ready-plan)) 0)
                 (node_eq (lwig-plan-unknown ready-plan)
                          (lwo-none))) 32 0))
    (let c7
        (if (and (gt (lwo-field-size
                         (lwig-group-unknowns
                            (lwig-plan-group ready-plan))) 0)
                 (eq (lwo-field-has?
                         (lwig-plan-alternatives ready-plan) d) 1)) 64 0))
    (let c8
        (if (and (node_eq (lwig-plan-status branch-plan) (lwig-branch))
                 (and (eq (len branch-items) 1)
                      (node_eq (head branch-items) a))) 128 0))
    (let c9
        (if (and (eq (lwo-field-size
                         (lwig-plan-remaining branch-plan)) 3)
                 (and (eq (lwo-field-has?
                              (lwig-plan-remaining branch-plan) b) 1)
                      (and (eq (lwo-field-has?
                                   (lwig-plan-remaining branch-plan) c) 1)
                           (eq (lwo-field-has?
                                   (lwig-plan-remaining branch-plan) d) 1))))
            256 0))
    (let c10
        (if (and (eq (lwo-field-has?
                         (lwig-plan-alternatives branch-plan)
                         ab-candidate) 1)
                 (eq (lwo-field-has?
                         (lwig-plan-alternatives branch-plan)
                         ad-candidate) 1)) 512 0))
    (let c11
        (if (not (node_eq (lwig-plan-unknown branch-plan)
                          (lwo-none))) 1024 0))
    (let c12
        (if (and (node_eq (lwig-plan-status cycle-plan) (lwig-cycle))
                 (and (eq (len cycle-items) 2)
                      (and (node_eq (nth cycle-items 0) a)
                           (node_eq (nth cycle-items 1) d)))) 2048 0))
    (let c13
        (if (and (eq (lwo-field-size
                         (lwig-plan-remaining cycle-plan)) 0)
                 (not (node_eq (lwig-plan-unknown cycle-plan)
                               (lwo-none)))) 4096 0))
    (let c14
        (if (and (eq (lwo-field-size
                         (lwig-plan-alternatives branch-plan)) 3)
                 (node_eq (lwig-plan-status branch-plan)
                          (lwig-branch))) 8192 0))
    (let c15
        (if (and (node_eq (lwig-plan-path ready-plan)
                          (lwo-local-path))
                 (and (node_eq (lwig-plan-evidence ready-plan)
                               (lwig-plan-group ready-plan))
                      (eq (lwo-field-has?
                              (lwig-group-edges
                                 (lwig-plan-group cycle-plan))
                              cycle-ad-candidate) 1))) 16384 0))
    (lwigw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
