// A different two-argument repair task; no model or assessment answers.
// preludes: form-stdlib/bml/form-cli-review-search.bml
section [form.bml] {
 class FormCliReviewSearchBand {
  def frsb-broken(a) = fcre-ok(0);
  def frsb-sum(a) = fcre-ok(add(head(a),nth(a,1)));
  def frsb-positive(a) = fcre-ok(gt(head(a),0));
  def frsb-keep(a) = fcre-ok(head(a));
  def frsb-bindings() = list(list("broken",2,frsb-broken),list("sum",2,frsb-sum),list("positive",1,frsb-positive),list("keep",1,frsb-keep));
  def frsb-roles() = list(list("broken","value"),list("sum","value"),list("positive","condition"),list("keep","value"));
  def frsb-check(contract,prepared) = frsb-cases(contract,prepared);
  def frsb-cases(rows,prepared) = if nil?(rows) then list(1,"all supplied cases passed") else {
   let actual = fcre-run(prepared,head(head(rows)),frsb-bindings());
   if and(head(actual),value_eq(nth(actual,1),nth(head(rows),1))) then frsb-cases(tail(rows),prepared) else list(0,"supplied behavior differs");
  };
  def frsb-bad-check(contract,prepared) = 1;
  def frsb-never(contract,prepared) = list(0,"unresolved");
  def frsb-assert(name,ok) = if ok then 1 else form_error(str_concat("review search: ",name));
  def frsb-run() {
   let source = "def candidate(a,b) = if positive(a) then broken(a,b) else keep(b);";
   let cases = list(list(list(1,2),3),list(list(-1,4),4),list(list(0,7),7),list(list(8,-3),5));
   let repaired = fcrs-search(source,"candidate",2,frsb-bindings(),frsb-roles(),frsb-check,cases,8);
   frsb-assert("changed function passes original and held-out values",and(str_eq(head(repaired),"repaired"),head(frsb-cases(append(cases,list(list(list(100,17),117),list(list(-10,3),3))),fcre-prepare(nth(repaired,1),"candidate",2,frsb-bindings())))));
   frsb-assert("search records actual checker runs",eq(nth(repaired,2),2));
   let stable = fcrs-search(nth(repaired,1),"candidate",2,frsb-bindings(),frsb-roles(),frsb-check,cases,8);
   frsb-assert("already correct source stays exact",and(str_eq(head(stable),"unchanged"),and(str_eq(nth(stable,1),nth(repaired,1)),eq(nth(stable,2),1))));
   let bounded = fcrs-search(source,"candidate",2,frsb-bindings(),frsb-roles(),frsb-check,cases,1);
   frsb-assert("budget exhaustion retains the original",and(str_eq(head(bounded),"exhausted"),and(str_eq(nth(bounded,1),source),eq(nth(bounded,2),1))));
   let untyped = fcrs-search(source,"candidate",2,frsb-bindings(),list(),frsb-check,cases,8);
   frsb-assert("absent roles do not invent compatibility",and(str_eq(head(untyped),"exhausted"),eq(nth(untyped,2),1)));
   let malformed = fcrs-search(source,"candidate",2,frsb-bindings(),frsb-roles(),frsb-bad-check,cases,8);
   frsb-assert("malformed checker cannot approve",str_eq(head(malformed),"refused"));
   let failed = fcrs-search(source,"candidate",2,frsb-bindings(),frsb-roles(),frsb-never,cases,2);
   frsb-assert("failed candidates are not returned as repair",and(str_eq(head(failed),"exhausted"),and(eq(nth(failed,2),2),str_eq(nth(failed,1),source))));
   let refused = fcrs-search(source,"wrong",2,frsb-bindings(),frsb-roles(),frsb-check,cases,8);
   frsb-assert("invalid admission performs no checks",and(str_eq(head(refused),"refused"),eq(nth(refused,2),0)));
   let stringSource = "def candidate(a,b) = if positive(a) then broken(a,b) else \"λ\\n\\\"kept\\\"\";";
   let stringCases = list(list(list(2,3),5),list(list(0,3),"λ\n\"kept\""));
   let strings = fcrs-search(stringSource,"candidate",2,frsb-bindings(),frsb-roles(),frsb-check,stringCases,8);
   frsb-assert("source rendering preserves escaped and unicode literals",and(str_eq(head(strings),"repaired"),head(frsb-check(stringCases,fcre-prepare(nth(strings,1),"candidate",2,frsb-bindings())))));
   print(list("native-search-checks",9,"repaired-candidate-checks",nth(repaired,2)));
   511;
  }
 }
 frsb-run();
}
