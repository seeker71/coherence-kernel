; source-compiler-multi-dialect-band.fk - one source carries several DSL sections
;
; Each section compiles to executable Form text in section order: a BMF
; dialect to its rule table and section registration, the form.bml section
; to its statements. The compiled text is the program fkwu runs; no recipe
; image is loaded. Verdict 450.
;
; preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml.fk form-stdlib/source-compiler.fk

(do
    (let source
        (str_concat
        (str_concat "section " "[python.bmf] {
  assign-int ::= $name:name \"=\" $value:int => pybmf-emit-assign-int <= pybmf-source-assign-int;
}
")
        (str_concat
        (str_concat "section " "[go.bmf] {
  var-int ::= \"var\" $name:name \"=\" $value:int => go-emit-var-int <= go-source-var-int;
}
")
        (str_concat
        (str_concat "section " "[form.bml] {
  let score = add(40, 2);
  score;
}
")
        (str_concat "section " "[natural.bmf] {
  fact-is ::= $subject:name \"is\" $value:int \".\" => natural-emit-fact-int <= natural-source-fact-is;
  fact-id-adalah ::= $subject:name \"adalah\" $value:int \".\" => natural-emit-fact-int <= natural-source-fact-id-adalah;
}
")))))

    (let out-path (str_concat (temp_dir) "/form-test-multi-dialect"))
    (let compiled (form-source-compile-text source out-path))

    (sum
        (list
            (if (fsc-contains? compiled "(let python-bmf-rules (list (list \"assign-int\"") 10 0)
            (if (fsc-contains? compiled "pybmf-emit-assign-int") 20 0)
            (if (fsc-contains? compiled "(let go-bmf-rules (list (list \"var-int\"") 30 0)
            (if (fsc-contains? compiled "go-emit-var-int") 40 0)
            (if (fsc-contains? compiled "(let score (add 40 2))\nscore\n") 50 0)
            (if (fsc-contains? compiled "(let natural-bmf-rules (list (list \"fact-is\"") 60 0)
            (if (fsc-contains? compiled "natural-emit-fact-int") 70 0)
            (if (fsc-contains? compiled "(let natural-bmf-second (form-bmf-second \"natural\"") 80 0)
            (if (fsc-contains? compiled "read_form_binary") 0 90))))
