// Precise failures and bounded native syntax recovery at the coding boundary.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 class CodeSyntaxWitness {
  def csw-assert(name,ok) = if ok then 1 else form_error(str_concat("code syntax: ",name));
  def csw-cases(cases) = if nil?(cases) then 1 else {
   let row = head(cases); let end = faj-complete(head(row));
   csw-assert(head(row),((end < 0) && (((Comparable) faj-error-at(end) == nth(row,1)) && ((Comparable) faj-error-reason(end) == nth(row,2)))));
   csw-assert("diagnostic is valid JSON",faj-valid(json-emit(faj-diagnostic(head(row),end))));
   csw-cases(tail(cases));
  };
  def csw-valid(cases) = if nil?(cases) then 1 else (faj-valid(head(cases)) && csw-valid(tail(cases)));
  def csw-repeat(text,n) = if (n <= 0) then "" else str_concat(text,csw-repeat(text,(n - 1)));
  def csw-never(contract,docs) = form_error("malformed JSON invoked caller verification");
  def csw-refuse(contract,docs) = list(0,"original caller checks still refuse this partial edit");
  def csw-pass(contract,docs) = list(1,"source check callback reached before review");
  def csw-report-check(expected,subject) = list(((String) nth(subject,1) == expected),"original report assertion");
  def csw-unrepaired(cases) = if nil?(cases) then 1 else (nothing?(faj-closer-candidate(head(cases),faj-complete(head(cases)))) && csw-unrepaired(tail(cases)));
 }
 csw-cases(list(list(" \n",2,0),list("\"unfinished",11,1),list("\"a\n\"",2,2),list("\"bad\\q\"",5,3),list("\"\\u12x4\"",5,4),list("-",1,5),list("1.",2,6),list("1e+",3,7),list("{x:1}",1,9),list("{\"a\" 1}",5,10),list("[1}",2,11),list("{\"a\":1]",6,12),list("truefalse",4,13),list("01",1,13),list("[1,]",3,0),list("{\"a\":1,}",7,9),list("{\"é\":1]",7,12)));
 csw-assert("valid scalar string and nested values preserved",csw-valid(list("false","null","0","-12.5e+2","\"café\"","\"\\u1234\\n\"","{\"x\":[true,{},[],null]}")));
 let nested = str_concat(csw-repeat("[",65),str_concat("0",csw-repeat("]",65)));
 csw-assert("existing nesting boundary retained",(((Comparable) faj-error-at(faj-complete(nested)) == 65) && ((Comparable) faj-error-reason(faj-complete(nested)) == 8)));
 let retained = parse-json("native-reply-evidence",read_file("receipts/artifacts/2026-09-22-landing-process-status/native-reply-bytes.json"));
 let raw = json-string-value(json-object-get(retained,"malformed_edit"));
 let broken = faj-complete(raw);
 csw-assert("actual reply names an unexpected brace inside arguments",((broken < 0) && (((Comparable) faj-error-reason(broken) == 11) && ((Comparable) fat-char(raw,faj-error-at(broken)) == 125))));
 let source = read_file("form/form-stdlib/bml/form-cli-landing.bml");
 let docs = list(list("landing","form/form-stdlib/bml/form-cli-landing.bml",source));
 let state = fcap-open-direct-code("Repair landing gates",docs,list("form/form-stdlib/bml/form-cli-landing.bml"));
 let checker = list(csw-never,0);
 let unrecoverable = substring(raw,0,(str_len(raw) - 1));
 let once = fcap-step(state,unrecoverable,checker);
 let twice = fcap-step(once,unrecoverable,checker);
 csw-assert("invalid replies preserve all documents and write authority",(((Value) fcap-docs(twice) == docs) && ((Value) nth(twice,4) == nth(state,4))));
 csw-assert("syntax failures count separately from tools and checks",(((Comparable) fcap-turns(twice) == 2) && (((Comparable) fcap-failures(twice) == 2) && (((Comparable) fcap-calls(twice) == 0) && ((Comparable) fcap-checks(twice) == 0)))));
 csw-assert("original role continues with precise correction evidence",(((String) fcap-stage(twice) == "implement") && ((str_find(fcap-note(twice),"comma or closing array bracket",0) >= 0) && (str_find(fcap-note(twice),"same syntax failure repeated",0) >= 0))));
 let read = fcap-step(twice,"{\"tool\":\"read\",\"arguments\":[\"form/form-stdlib/bml/form-cli-landing.bml\"]}",checker);
 csw-assert("next valid message resumes real tool work",(((Comparable) fcap-calls(read) == 1) && (((Comparable) fcap-checks(read) == 0) && ((Value) fcap-docs(read) == docs))));
 let candidate = faj-closer-candidate(raw,broken);
 csw-assert("native correction removes only the parser-named byte",((String) candidate == str_concat(substring(raw,0,faj-error-at(broken)),substring(raw,(faj-error-at(broken) + 1),str_len(raw)))));
 let healed = fcap-step(state,raw,checker);
 let health = fcac-syntax-reading(state,raw,"retained-native-reply");
 csw-assert("syntax failure asks for a valid response",(oh-valid(health) && (oh-pain(health) && ((Comparable) len(json-array-elements(oh-get(health,"needs"))) == 1))));
 let recovered = fcac-syntax-reobserved(raw,health,parse-json("repair",head(fcap-json-repairs(healed))));
 csw-assert("native syntax recovery has a correlated fresh observation",(oh-valid(recovered) && (node_eq(oh-get(recovered,"health"),json-node-int(1)) && node_eq(oh-get(recovered,"care_of"),oh-get(health,"id")))));
 csw-assert("ordinary valid replies emit no syntax reading",nothing?(fcac-syntax-reading(state,"{}","valid-reply")));
 let laterValid = fcac-syntax-reading(twice,"{}","corrected-reply");
 csw-assert("a later valid model reply clears the syntax need",(node_eq(oh-get(laterValid,"health"),json-node-int(1)) && nil?(json-array-elements(oh-get(laterValid,"needs")))));
 csw-assert("actual malformed edit reaches the guarded tool once",(((Comparable) fcap-calls(healed) == 1) && (((Comparable) fcap-turns(healed) == 1) && (((Comparable) fcap-failures(healed) == 1) && (!((Value) fcap-docs(healed) == docs))))));
 csw-assert("native syntax repair is attributed and remains unverified",(((Comparable) len(fcap-json-repairs(healed)) == 1) && (((Comparable) fcap-checks(healed) == 0) && (((String) fcap-stage(healed) == "implement") && (str_find(fcap-note(healed),"native_json_repair",0) >= 0)))));
 let packet = fcam-unpack(fcam-pack(healed));
 csw-assert("checkpoint retains syntax repair evidence",((Value) fcap-json-repairs(packet) == fcap-json-repairs(healed)));
 let result = parse-json("result",fcaq-result-core(list(healed,1,0,0,0)));
 csw-assert("caller result exposes the native correction",((Comparable) len(json-array-elements(json-object-get(result,"native_json_repairs"))) == 1));
 let review = fcap-step(healed,"{\"task\":\"done\"}",list(csw-pass,0));
 csw-assert("implementation checks run before native review",(((String) fcap-stage(review) == "review") && ((Comparable) fcap-checks(review) == 1)));
 let refused = fcap-step(review,"{\"verdict\":\"accept\",\"reason\":\"The actual edited candidate is submitted to the original caller checker.\"}",list(csw-refuse,0));
 csw-assert("completion still depends on the original caller checks",(((String) fcap-stage(refused) == "repair") && ((Comparable) fcap-checks(refused) == 2)));
 let readOnly = fcap-step(fcap-open-direct-review("Review only",docs),raw,checker);
 csw-assert("native syntax repair grants no write authority",(((Value) fcap-docs(readOnly) == docs) && ((Comparable) fcap-calls(readOnly) == 0)));
 let report = fcap-step(state,"{\"report\":[\"text\"}]}",checker);
 csw-assert("non-tool reports require the model to correct syntax",(nil?(fcap-json-repairs(report)) && ((Comparable) fcap-calls(report) == 0)));
 csw-assert("escaped data and malformed values are never rewritten",nothing?(faj-closer-candidate("[\"bad\\q\"]",faj-complete("[\"bad\\q\"]"))));
 let opposite = "{\"tool\":\"read\",\"arguments\":[\"form/form-stdlib/bml/form-cli-landing.bml\"] ]}";
 let readHealed = fcap-step(state,opposite,checker);
 csw-assert("extra array closer at an object boundary recovers a real read",(((Comparable) fcap-calls(readHealed) == 1) && (((Value) fcap-docs(readHealed) == docs) && ((Comparable) len(fcap-json-repairs(readHealed)) == 1))));
 let missing = "{\"tool\":\"read\",\"arguments\":[\"form/form-stdlib/bml/form-cli-landing.bml\"}";
 let missingEnd = faj-complete(missing);
 let inserted = faj-closer-candidate(missing,missingEnd);
 csw-assert("missing closer repair preserves all original bytes",((String) inserted == str_concat(substring(missing,0,faj-error-at(missingEnd)),"]}")));
 let missingHealed = fcap-step(state,missing,checker);
 let missingRow = parse-json("repair",head(fcap-json-repairs(missingHealed)));
 csw-assert("missing closer reaches the ordinary read boundary",(((Comparable) fcap-calls(missingHealed) == 1) && ((Value) fcap-docs(missingHealed) == docs)));
 csw-assert("insertion receipt identifies its actual byte operation",(((String) fcap-string(missingRow,"method") == "native-json-missing-closer-insertion") && (((Comparable) node_value(json-object-get(missingRow,"inserted_byte")) == 93) && (!json-object-has?(missingRow,"removed_byte")))));
 let missingHealth = fcac-syntax-reading(state,missing,"retained-missing-closer");
 let missingRecovered = fcac-syntax-reobserved(missing,missingHealth,missingRow);
 csw-assert("insertion reobserves correlated syntax health",(node_eq(oh-get(missingRecovered,"health"),json-node-int(1)) && node_eq(oh-get(missingRecovered,"care_of"),oh-get(missingHealth,"id"))));
 csw-assert("missing object closer also retains its parent",((String) faj-closer-candidate("[{\"x\":1]",faj-complete("[{\"x\":1]")) == "[{\"x\":1}]"));
 let unfinished = substring(missing,0,(str_len(missing) - 1));
 csw-assert("unfinished generation is never completed",nothing?(faj-closer-candidate(unfinished,faj-complete(unfinished))));
 let missingReport = fcap-step(state,"{\"report\":[\"text\"}",checker);
 csw-assert("missing closer grants no report repair",(nil?(fcap-json-repairs(missingReport)) && ((Comparable) fcap-calls(missingReport) == 0)));
 let premature = " {\"tool\":\"read\",\"arguments\":[\"form/form-stdlib/bml/form-cli-landing.bml\"]} \n,\"input\":\"a } , \\\" quote\"}";
 let prematureError = faj-complete(premature);
 let prematureCandidate = faj-closer-candidate(premature,prematureError);
 let prematureAt = faj-closer-offset(premature,prematureError);
 csw-assert("root repair removes the closing brace before whitespace and comma",((prematureAt < faj-error-at(prematureError)) && ((String) prematureCandidate == str_concat(substring(premature,0,prematureAt),substring(premature,(prematureAt + 1),str_len(premature))))));
 let prematureHealed = fcap-step(state,premature,checker);
 let prematureRow = parse-json("root-repair",head(fcap-json-repairs(prematureHealed)));
 csw-assert("root repair enters the ordinary tool boundary",(((Comparable) fcap-calls(prematureHealed) == 1) && ((Value) fcap-docs(prematureHealed) == docs)));
 csw-assert("root repair attributes the actual removed brace",(((String) fcap-string(prematureRow,"method") == "native-json-premature-root-closer-removal") && (((Comparable) node_value(json-object-get(prematureRow,"byte_offset")) == prematureAt) && ((Comparable) node_value(json-object-get(prematureRow,"removed_byte")) == 125))));
 let prematureHealth = fcac-syntax-reading(state,premature,"premature-root-closer");
 let prematureRecovered = fcac-syntax-reobserved(premature,prematureHealth,prematureRow);
 csw-assert("root repair clears the correlated syntax need",(node_eq(oh-get(prematureRecovered,"health"),json-node-int(1)) && node_eq(oh-get(prematureRecovered,"care_of"),oh-get(prematureHealth,"id"))));
 csw-assert("root repair refuses duplicate keys, separate values and unfinished input",csw-unrepaired(list("{\"tool\":\"read\"},\"tool\":\"edit\"}","{\"tool\":\"read\"},\"\\u0074ool\":\"edit\"}","{\"a\":1,\"a\":2},\"b\":3}","{\"a\":1},{\"b\":2}","[1],2]","{\"a\":1},\"b\":2","{\"a\":1} true")));
 let prematureReport = fcap-step(state,"{\"report\":\"done\"},\"input\":\"\"}",checker);
 csw-assert("root repair grants no report acceptance",(nil?(fcap-json-repairs(prematureReport)) && ((Comparable) fcap-calls(prematureReport) == 0)));
 let reportState = fcap-open-direct-review("Return the requested report",docs);
 let reportOpen = "{\"report\":{\"answer\":\"done\"}";
 let reportCandidate = fcap-report-closer(reportState,reportOpen,faj-complete(reportOpen));
 csw-assert("read-only report repair adds only its final outer brace",((String) reportCandidate == str_concat(reportOpen,"}")));
 let reportClosed = fcap-step(reportState,reportOpen,list(csw-report-check,"{\"answer\":\"done\"}"));
 csw-assert("closed report runs the original checker without a tool or source change",(((String) fcap-stage(reportClosed) == "complete") && (((Comparable) fcap-checks(reportClosed) == 1) && (((Comparable) fcap-calls(reportClosed) == 0) && ((Value) fcap-docs(reportClosed) == docs)))));
 csw-assert("report closure retains its syntax failure and attributed repair",(((Comparable) fcap-failures(reportClosed) == 1) && (((Comparable) fcap-turns(reportClosed) == 1) && ((Comparable) len(fcap-json-repairs(reportClosed)) == 1))));
 let reportFailed = fcap-step(reportState,reportOpen,list(csw-report-check,"different required report"));
 csw-assert("syntax recovery exposes the actual failed report for amendment",(((String) fcap-stage(reportFailed) == "repair") && (((Comparable) fcap-checks(reportFailed) == 1) && (fcap-amendable(reportFailed) && ((String) fcap-report(reportFailed) == "{\"answer\":\"done\"}")))));
 let reportHealth = fcac-syntax-reading(reportState,reportOpen,"retained-public-report");
 let reportRow = parse-json("report-closure",head(fcap-json-repairs(reportFailed)));
 let reportReobserved = fcac-syntax-reobserved(reportOpen,reportHealth,reportRow);
 csw-assert("report closure reobserves syntax health independently of failed content checks",(((String) fcap-string(reportRow,"method") == "native-json-report-envelope-closure") && (node_eq(oh-get(reportReobserved,"health"),json-node-int(1)) && node_eq(oh-get(reportReobserved,"care_of"),oh-get(reportHealth,"id")))));
 let reportRetried = fcap-step(reportFailed,reportOpen,list(csw-report-check,"{\"answer\":\"done\"}"));
 csw-assert("read-only repair role still checks the recovered report",(((String) fcap-stage(reportRetried) == "complete") && ((Comparable) fcap-checks(reportRetried) == 2)));
 let textOpen = "{\"report\":\"complete text\"";
 let textClosed = fcap-step(reportState,textOpen,list(csw-report-check,"complete text"));
 csw-assert("a complete string report keeps its exact contents",(((String) fcap-stage(textClosed) == "complete") && ((String) fcap-report(textClosed) == "complete text")));
 let reportPlanning = fcap-step(fcap-note-at(reportState,"plan","plan inspection"),reportOpen,checker);
 csw-assert("EOF repair cannot skip planning",(((String) fcap-stage(reportPlanning) == "plan") && (((Comparable) fcap-checks(reportPlanning) == 0) && nil?(fcap-json-repairs(reportPlanning)))));
 let reportCoding = fcap-step(state,reportOpen,checker);
 csw-assert("EOF report repair stays outside coding authority",(((Comparable) fcap-checks(reportCoding) == 0) && nil?(fcap-json-repairs(reportCoding))));
 let unfinishedReport = "{\"report\":{\"answer\":\"unfinished";
 csw-assert("EOF repair never supplies report text",nothing?(fcap-report-closer(reportState,unfinishedReport,faj-complete(unfinishedReport))));
 let unfinishedValue = "{\"report\":{\"answer\":\"done\"";
 csw-assert("EOF repair never completes an unfinished inner object",nothing?(fcap-report-closer(reportState,unfinishedValue,faj-complete(unfinishedValue))));
 let mixedReport = "{\"report\":\"done\",\"tool\":\"write\",\"arguments\":[\"candidate\"]";
 let mixedRefused = fcap-step(reportState,mixedReport,checker);
 csw-assert("EOF repair cannot complete a mixed report and tool envelope",(((Comparable) fcap-calls(mixedRefused) == 0) && (((Comparable) fcap-checks(mixedRefused) == 0) && nil?(fcap-json-repairs(mixedRefused)))));
 1;
}
