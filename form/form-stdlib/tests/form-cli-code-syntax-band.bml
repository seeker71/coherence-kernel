// Precise failures and bounded native syntax recovery at the coding boundary.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 class CodeSyntaxWitness {
  def csw-assert(name,ok) = if ok then 1 else form_error(str_concat("code syntax: ",name));
  def csw-cases(cases) = if nil?(cases) then 1 else {
   let row = head(cases); let end = faj-complete(head(row));
   csw-assert(head(row),and(lt(end,0),and(eq(faj-error-at(end),nth(row,1)),eq(faj-error-reason(end),nth(row,2)))));
   csw-assert("diagnostic is valid JSON",faj-valid(json-emit(faj-diagnostic(head(row),end))));
   csw-cases(tail(cases));
  };
  def csw-valid(cases) = if nil?(cases) then 1 else and(faj-valid(head(cases)),csw-valid(tail(cases)));
  def csw-repeat(text,n) = if le(n,0) then "" else str_concat(text,csw-repeat(text,sub(n,1)));
  def csw-never(contract,docs) = form_error("malformed JSON invoked caller verification");
  def csw-refuse(contract,docs) = list(0,"original caller checks still refuse this partial edit");
 }
 csw-cases(list(list(" \n",2,0),list("\"unfinished",11,1),list("\"a\n\"",2,2),list("\"bad\\q\"",5,3),list("\"\\u12x4\"",5,4),list("-",1,5),list("1.",2,6),list("1e+",3,7),list("{x:1}",1,9),list("{\"a\" 1}",5,10),list("[1}",2,11),list("{\"a\":1]",6,12),list("truefalse",4,13),list("01",1,13),list("[1,]",3,0),list("{\"a\":1,}",7,9),list("{\"é\":1]",7,12)));
 csw-assert("valid scalar string and nested values preserved",csw-valid(list("false","null","0","-12.5e+2","\"café\"","\"\\u1234\\n\"","{\"x\":[true,{},[],null]}")));
 let nested = str_concat(csw-repeat("[",65),str_concat("0",csw-repeat("]",65)));
 csw-assert("existing nesting boundary retained",and(eq(faj-error-at(faj-complete(nested)),65),eq(faj-error-reason(faj-complete(nested)),8)));
 let retained = parse-json("native-reply-evidence",read_file("receipts/artifacts/2026-09-22-landing-process-status/native-reply-bytes.json"));
 let raw = json-string-value(json-object-get(retained,"malformed_edit"));
 let broken = faj-complete(raw);
 csw-assert("actual reply names an unexpected brace inside arguments",and(lt(broken,0),and(eq(faj-error-reason(broken),11),eq(fat-char(raw,faj-error-at(broken)),125))));
 let source = read_file("form/form-stdlib/bml/form-cli-landing.bml");
 let docs = list(list("landing","form/form-stdlib/bml/form-cli-landing.bml",source));
 let state = fcap-open-direct-code("Repair landing gates",docs,list("form/form-stdlib/bml/form-cli-landing.bml"));
 let checker = list(csw-never,0);
 let unrecoverable = substring(raw,0,sub(str_len(raw),1));
 let once = fcap-step(state,unrecoverable,checker);
 let twice = fcap-step(once,unrecoverable,checker);
 csw-assert("invalid replies preserve all documents and write authority",and(value_eq(fcap-docs(twice),docs),value_eq(nth(twice,4),nth(state,4))));
 csw-assert("syntax failures count separately from tools and checks",and(eq(fcap-turns(twice),2),and(eq(fcap-failures(twice),2),and(eq(fcap-calls(twice),0),eq(fcap-checks(twice),0)))));
 csw-assert("original role continues with precise correction evidence",and(str_eq(fcap-stage(twice),"implement"),and(ge(str_find(fcap-note(twice),"comma or closing array bracket",0),0),ge(str_find(fcap-note(twice),"same syntax failure repeated",0),0))));
 let read = fcap-step(twice,"{\"tool\":\"read\",\"arguments\":[\"form/form-stdlib/bml/form-cli-landing.bml\"]}",checker);
 csw-assert("next valid message resumes real tool work",and(eq(fcap-calls(read),1),and(eq(fcap-checks(read),0),value_eq(fcap-docs(read),docs))));
 let candidate = faj-closer-candidate(raw,broken);
 csw-assert("native correction removes only the parser-named byte",str_eq(candidate,str_concat(substring(raw,0,faj-error-at(broken)),substring(raw,add(faj-error-at(broken),1),str_len(raw)))));
 let healed = fcap-step(state,raw,checker);
 let health = fcac-syntax-reading(state,raw,"retained-native-reply");
 csw-assert("syntax failure asks for a valid response",and(oh-valid(health),and(oh-pain(health),eq(len(json-array-elements(oh-get(health,"needs"))),1))));
 let recovered = fcac-syntax-reobserved(raw,health,parse-json("repair",head(fcap-json-repairs(healed))));
 csw-assert("native syntax recovery has a correlated fresh observation",and(oh-valid(recovered),and(node_eq(oh-get(recovered,"health"),json-node-int(1)),node_eq(oh-get(recovered,"care_of"),oh-get(health,"id")))));
 csw-assert("ordinary valid replies emit no syntax reading",nothing?(fcac-syntax-reading(state,"{}","valid-reply")));
 let laterValid = fcac-syntax-reading(twice,"{}","corrected-reply");
 csw-assert("a later valid model reply clears the syntax need",and(node_eq(oh-get(laterValid,"health"),json-node-int(1)),nil?(json-array-elements(oh-get(laterValid,"needs")))));
 csw-assert("actual malformed edit reaches the guarded tool once",and(eq(fcap-calls(healed),1),and(eq(fcap-turns(healed),1),and(eq(fcap-failures(healed),1),not(value_eq(fcap-docs(healed),docs))))));
 csw-assert("native syntax repair is attributed and remains unverified",and(eq(len(fcap-json-repairs(healed)),1),and(eq(fcap-checks(healed),0),and(str_eq(fcap-stage(healed),"implement"),ge(str_find(fcap-note(healed),"native_json_repair",0),0)))));
 let packet = fcam-unpack(fcam-pack(healed));
 csw-assert("checkpoint retains syntax repair evidence",value_eq(fcap-json-repairs(packet),fcap-json-repairs(healed)));
 let result = parse-json("result",fcaq-result-core(list(healed,1,0,0,0)));
 csw-assert("caller result exposes the native correction",eq(len(json-array-elements(json-object-get(result,"native_json_repairs"))),1));
 let review = fcap-step(healed,"{\"task\":\"done\"}",checker);
 let refused = fcap-step(review,"{\"verdict\":\"accept\"}",list(csw-refuse,0));
 csw-assert("completion still depends on the original caller checks",and(str_eq(fcap-stage(refused),"repair"),eq(fcap-checks(refused),1)));
 let readOnly = fcap-step(fcap-open-direct-review("Review only",docs),raw,checker);
 csw-assert("native syntax repair grants no write authority",and(value_eq(fcap-docs(readOnly),docs),eq(fcap-calls(readOnly),0)));
 let report = fcap-step(state,"{\"report\":[\"text\"}]}",checker);
 csw-assert("non-tool reports require the model to correct syntax",and(nil?(fcap-json-repairs(report)),eq(fcap-calls(report),0)));
 csw-assert("escaped data and malformed values are never rewritten",nothing?(faj-closer-candidate("[\"bad\\q\"]",faj-complete("[\"bad\\q\"]"))));
 let opposite = "{\"tool\":\"read\",\"arguments\":[\"form/form-stdlib/bml/form-cli-landing.bml\"] ]}";
 let readHealed = fcap-step(state,opposite,checker);
 csw-assert("extra array closer at an object boundary recovers a real read",and(eq(fcap-calls(readHealed),1),and(value_eq(fcap-docs(readHealed),docs),eq(len(fcap-json-repairs(readHealed)),1))));
 let missing = "{\"tool\":\"read\",\"arguments\":[\"form/form-stdlib/bml/form-cli-landing.bml\"}";
 let missingEnd = faj-complete(missing);
 let inserted = faj-closer-candidate(missing,missingEnd);
 csw-assert("missing closer repair preserves all original bytes",str_eq(inserted,str_concat(substring(missing,0,faj-error-at(missingEnd)),"]}")));
 let missingHealed = fcap-step(state,missing,checker);
 let missingRow = parse-json("repair",head(fcap-json-repairs(missingHealed)));
 csw-assert("missing closer reaches the ordinary read boundary",and(eq(fcap-calls(missingHealed),1),value_eq(fcap-docs(missingHealed),docs)));
 csw-assert("insertion receipt identifies its actual byte operation",and(str_eq(fcap-string(missingRow,"method"),"native-json-missing-closer-insertion"),and(eq(node_value(json-object-get(missingRow,"inserted_byte")),93),not(json-object-has?(missingRow,"removed_byte")))));
 let missingHealth = fcac-syntax-reading(state,missing,"retained-missing-closer");
 let missingRecovered = fcac-syntax-reobserved(missing,missingHealth,missingRow);
 csw-assert("insertion reobserves correlated syntax health",and(node_eq(oh-get(missingRecovered,"health"),json-node-int(1)),node_eq(oh-get(missingRecovered,"care_of"),oh-get(missingHealth,"id"))));
 csw-assert("missing object closer also retains its parent",str_eq(faj-closer-candidate("[{\"x\":1]",faj-complete("[{\"x\":1]")),"[{\"x\":1}]"));
 let unfinished = substring(missing,0,sub(str_len(missing),1));
 csw-assert("unfinished generation is never completed",nothing?(faj-closer-candidate(unfinished,faj-complete(unfinished))));
 let missingReport = fcap-step(state,"{\"report\":[\"text\"}",checker);
 csw-assert("missing closer grants no report repair",and(nil?(fcap-json-repairs(missingReport)),eq(fcap-calls(missingReport),0)));
 1;
}
