; living-world-lifecycle-band.fk -- evidence movement pauses old authority.
; Verdict 1023 proves ten reopen/re-consent properties.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-recursive-application.fk form-stdlib/tests/living-world-recursive-witness.fk

(do
    (let base (lwrrw-base-round 2))
    (let mapping-proposal (lwrrw-first-proposal base))
    (let old-candidate (lwrrw-candidate mapping-proposal))
    (let mapping-round
        (lwrrw-integrated-mapping-round base mapping-proposal))
    (let mapping-world (lwt-round-world mapping-round))
    (let before-state (lwrl-state mapping-world old-candidate))

    ; Form an application while the evidence is steady, then let a new
    ; counterexample arrive before its acknowledgments are integrated.
    (let input-world (lwrrw-input-world mapping-world))
    (let app-round
        (lwrr-application-round input-world old-candidate
                                (lwrrw-unseen-input) mapping-round))
    (let app-proposal (lwrrw-first-proposal app-round))
    (let app-candidate (lwrrw-candidate app-proposal))
    (let app-yes (lwrrw-application-yes-round app-round app-proposal))
    (let changed-round
        (lwt-round-receive app-yes
            (list (lwrrw-entry (lwrrw-source-e)
                               (lwrrw-correspondence-e)
                               (lwrrw-provenance-e)))))
    (let changed-world (lwt-round-world changed-round))
    (let after-state (lwrl-state changed-world old-candidate))
    (let refused
        (lwrr-integrate-application changed-round app-proposal
                                    (lwrrw-action)))

    ; Reopening creates a new mapping identity and includes the newly affected
    ; source in the next offer/ack field.
    (let reopen-proposal
        (lwrl-reopen-proposal changed-world old-candidate 2))
    (let new-candidate (lwrrw-candidate reopen-proposal))
    (let reopen-round
        (lwt-round changed-world
            (lwo-field-add (lwo-empty-field) reopen-proposal)
            (lwo-empty-field) changed-round))
    (let reopen-yes
        (lwrrw-reopen-yes-round reopen-round reopen-proposal))
    (let reintegrated
        (lwt-integrate reopen-yes reopen-proposal (lwrrw-action)))
    (let final-world (lwt-round-world reintegrated))
    (let new-state (lwrl-state final-world new-candidate))

    (let c1 (if (node_eq (lwrl-state-status before-state)
                          (lwrl-steady)) 1 0))
    (let c2 (if (and (node_eq (lwrl-state-status after-state)
                               (lwrl-reopen))
                         (eq (lwrl-state-counterexample-delta after-state) 1)) 2 0))
    (let c3 (if (eq (lwrl-state-support-delta after-state) 0) 4 0))
    (let c4 (if (eq (lwo-world-has?
                         (lwt-round-world refused) app-candidate) 0) 8 0))
    (let c5 (if (and (not (node_eq reopen-proposal (lwo-none)))
                         (eq (lwo-field-size
                              (lwt-proposal-participants reopen-proposal)) 4)) 16 0))
    (let c6 (if (and (eq (lwo-category?
                              (lwt-proposal-origin reopen-proposal)
                              LWRL-REOPEN-ORIGIN) 1)
                         (not (node_eq old-candidate new-candidate))) 32 0))
    (let c7 (if (and (eq (lwo-field-size
                              (lwrr-mapping-counterexamples
                                  (lwo-emergent-shape new-candidate))) 2)
                         (eq (lwo-field-size
                              (lwrr-mapping-supports
                                  (lwo-emergent-shape new-candidate))) 2)) 64 0))
    (let c8 (if (and (eq (lwo-active? final-world new-candidate) 1)
                         (eq (lwo-field-size
                              (lwo-active-attributions-for
                                  final-world new-candidate)) 4)) 128 0))
    (let c9 (if (node_eq (lwrl-state-status new-state)
                          (lwrl-steady)) 256 0))
    (let c10 (if (eq (lwo-active? final-world old-candidate) 1) 512 0))
    (lwrrw-sum (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10)))
