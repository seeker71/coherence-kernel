; model-admission-band.bml — the queue's reads of the host, held against the host itself: the environment and who holds a file open.
; The queue once ran `printenv HOME`, `printenv FORM_MODEL_ADMISSION_WAIT_MS` and `lsof -t <path>` through a shell; they are the seed's
; host_getenv and host_file_holders now (host-fs.bml). Nothing foreign runs here, and no model is opened: the file the band holds open is its own scratch file.
;
;   1     env: adm-home is the host's HOME (a directory) and the root is its .cache/form-model; an omitted wait stays absent,
;         explicit values retain their meaning and malformed allowances are refused before queuing
;   2     peers, on scripted holders: this process and a pid that cannot exist are held, and only a live pid other than the asker is a peer
;         ([me, gone] asked by 0 is [me]; asked by me it is []); a nothing() and a non-list are no peers
;   4     peers, on the host: the band opens its own scratch file with file_open and asks as another pid (1): the band's pid is the peer; asked as
;         itself there is none; once the file is closed there is none; a path that is not there has none
;   8     held-elsewhere: with the file open, another asker's ask finds it held, this process's own ask does not (it is the holder), and
;         after the close no asker finds it held; the residency notes of an empty root name no one
;
; The band's scratch directory is made under host_temp_dir() and removed (recursively) at the end, whatever failed.
; Expected: 15
; Verdict 15
; REQUIRES: the host doors host_getenv host_file_holders (Darwin) and file_open (seed doors; the sibling kernels carry no host doors)
; preflight-exec: forbidden
; preludes: form-stdlib/bml/model-admission.bml form-stdlib/bml/host-fs.bml
section [form.bml] {
 class ModelAdmissionBand {
  def mab-dir() = host_temp_dir() ++ "/model-admission-band-" ++ host_pid().str();
  def mab-say(label, v) = print([label, v]);
  def mab-darwin?() = (String) host_os() == "Darwin";
  def mab-c-env() {
   let home = host_getenv("HOME");
   let wait = host_getenv("FORM_MODEL_ADMISSION_WAIT_MS");
    let want = adm-wait-value(wait);
   let said = mab-say("env", [home, adm-root(), adm-wait-ms(), nothing?(wait)]);
   (String) value_kind(home) == "string" && (String) adm-home() == (String) trim(home) && (Comparable) host_path_is_dir(adm-home()) == 1 && (String) adm-root() == adm-home() ++ "/.cache/form-model"
     && adm-wait-ms() == want && nothing?(adm-wait-value(nothing())) && adm-wait-value("0")==0 && adm-wait-value("17")==17
     && all?(adm-wait-valid,[nothing(),0,17,4611686018427387903]) && !any?(adm-wait-valid,[-1,"no",1.5])
     && adm-admit-for("invalid allowance","absent",-1,0)[0]==0 && !adm-wait-expired([host_monotonic_ms(),nothing()])
     && !adm-wait-expired([host_monotonic_ms(),4611686018427387903]) && adm-wait-expired([host_monotonic_ms() - 50,1])
     && (Comparable) hfs-env-int("MODEL_ADMISSION_BAND_SURELY_UNSET_NAME", 7) == 7;
  }
  def mab-c-scripted() {
   let me = host_pid();
   let gone = 2147483646;
   let a = adm-peers-of([me, gone], 0);
   let b = adm-peers-of([me, gone], me);
   let c = adm-peers-of(nothing(), me);
   let d = adm-peers-of(5, me);
   let e = adm-peers-of([], me);
   let said = mab-say("scripted peers", [a, b, c, d, e]);
   len(a) == 1 && a[0] == me && nil?(b) && nil?(c) && nil?(d) && nil?(e);
  }
  def mab-c-live() {
   let dir = mab-dir();
   let made = host_dir_mkdir(dir);
   let path = dir ++ "/held";
   let w = write_file(path, "x");
   let before = adm-peers(path, 1);
   let h = file_open(path);
   let during = adm-peers(path, 1);
   let own = adm-peers(path, host_pid());
   let elsewhere = adm-held-elsewhere?(dir ++ "/no-notes", 1, path);
   let mine = adm-held-elsewhere?(dir ++ "/no-notes", host_pid(), path);
   let closed = file_close(h);
   let after = adm-peers(path, 1);
   let late = adm-held-elsewhere?(dir ++ "/no-notes", 1, path);
   let none = adm-peers(dir ++ "/no-such-file", 1);
   let said = mab-say("live peers", [before, during, own, elsewhere, mine, after, late, none]);
   let cleaned = host_dir_rmdir(dir);
   mab-darwin?() ? ([before, during, own, after, none] == [[], [host_pid()], [], [], []] && elsewhere && !mine && !late)
    : (nil?(before) && nil?(during) && nil?(own) && nil?(after));
  }
  def mab-c-held() {
   let dir = mab-dir() ++ "-held";
   let made = host_dir_mkdir(dir);
   let path = dir ++ "/f";
   let w = write_file(path, "x");
   let h = file_open(path);
   let theirs = adm-held-elsewhere?(dir ++ "/root", 1, path);
   let ours = adm-held-elsewhere?(dir ++ "/root", host_pid(), path);
   let closed = file_close(h);
   let after = adm-held-elsewhere?(dir ++ "/root", 1, path);
    let notes = adm-residents(dir ++ "/root");
    let root=dir+"/queue-root"; let now=now_unix_ms();
    let first=adm-enter-at(root,host_pid(),now); let next=adm-enter-at(root,host_pid(),now+1);
    let noted=adm-note-add(root,host_pid(),path);
    let lease=[host_pid(),"model session",path,1,1,now,0,0];
    let waiting=adm-position-with(root,next,[])==1;
    let reserved=adm-position-with(root,next,[lease])==0 && host_path_is_dir(adm-queue(root)+"/"+first)==1 && adm-note-lines(root,host_pid())==[path];
    let unrelated=append(lease[0:2],cons("different model",lease[3:]));
    let preserved=adm-position-with(root,next,[unrelated])==1 && adm-position-with(root,next,[])==1 && nothing?(adm-position-with(root,"missing",[lease]));
     let shared=adm-admit-file(root,"shared session",host_pid(),path,1,0,1);
      let both=shared[0]==1 && shared[2]=="" && shared[3]==1 && adm-note-lines(root,host_pid())==[path,path];
      let release=record_new(0);
      let dropped=adm-drop-owned-at(root,host_pid(),path,release);
      let retained=dropped && adm-note-lines(root,host_pid())==[path];
      adm-note-add(root,host_pid(),path);
      let repeated=adm-drop-owned-at(root,host_pid(),path,release) && adm-note-lines(root,host_pid())==[path,path];
      let absent=adm-admit-file(root,"no file",host_pid(),path,0,0,1);
      let noNote=absent[0]==1 && absent[3]==0 && adm-note-lines(root,host_pid())==[path,path];
      let uncertain=record_new(0,"residency-before",[path],"residency-after",[]);
      let unchanged=!adm-drop-owned-at(root,host_pid(),path,uncertain) && adm-note-lines(root,host_pid())==[path,path];
    let cleaned = host_dir_rmdir(dir);
      waiting && reserved && preserved && both && retained && repeated && noNote && unchanged && (mab-darwin?() ? (theirs && !ours && !after && nil?(notes)) : (!theirs && !ours && !after && nil?(notes)));
  }
  def mab-c-scoped() {
   let root=mab-dir()+"-scoped";let me=host_pid();let stamp=now_unix_ms();
   let owned=adm-enter-owned(root,me,stamp);
   let live=!nothing?(owned) && adm-ticket-live?(root,owned)==1 && adm-tickets(root)==[owned];
   let lease=record_get(ADM-TICKET-LEASES,adm-queue(root)+"/"+owned);
   nps-file-settle(lease);
   let inert=adm-ticket-live?(root,owned)==0 && nil?(adm-tickets(root)) && host_alive(me)==1;
   adm-loaded-at(root,owned);
   let failed=try {
    let ticket=adm-enter-owned(root,me,stamp+1);
    defer adm-loaded-at(root,ticket);
    form_error("scoped admission release probe");
   } catch 1;
   let ordinary=failed==1 && nil?(adm-tickets(root));
   let legacy=adm-enter-at(root,me,stamp+2);let unknown=adm-enter-at(root,me,stamp+3);
   host_dir_mkdir(adm-ticket-owner(root,unknown));
   let conservative=adm-ticket-live?(root,legacy)==1 && nothing?(adm-ticket-live?(root,unknown)) && adm-tickets(root)==[legacy,unknown];
   host_dir_rmdir(root);
   mab-say("scoped queue",[live,inert,ordinary,conservative]);
   live && inert && ordinary && conservative;
  }
  def mab-run() {
   let b1 = mab-c-env() ? 1 : 0;
   let b2 = mab-c-scripted() ? 2 : 0;
   let b4 = mab-c-live() ? 4 : 0;
   let b8 = mab-c-held() && mab-c-scoped() ? 8 : 0;
   let verdict = b1 + b2 + b4 + b8;
   let shown = print(["model-admission-band", "verdict", verdict]);
   verdict;
  }
 }
 mab-run();
}
