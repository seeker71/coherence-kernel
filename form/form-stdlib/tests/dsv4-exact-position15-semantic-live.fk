; Exact-query prefix semantic checkpoint through layers 0..2. It catches
; cached-attention drift while keeping the re-witness small.
;
; preludes: form-stdlib/form-cli-dsv4-local.fk

(do
    (defn dep15-take (xs n)
        (if (if (eq n 0) 1 (eq (len xs) 0)) (list)
            (cons (head xs) (dep15-take (tail xs) (sub n 1)))))

    (let question
        "goal is to have this response 100% w/o remote orcale w/o network to show the answer from a generalized local resource and all native membrane crossings are obserable on any query lane and all gaps are observed and attempted to close with a rewitness request offer to show we can natively observe the tokens and result using DeepSeek-V4-Flash-REAP25-DSpark-ds4-GGUF")
    (let tokenizer (tkz-src (dsv4-local-model-resource)))
    (let ids (dep15-take (fdl-chat-ids tokenizer question) 16))
    (dns-open)
    (let src (eqr-of-file (dlp-model-path) 0 (gm-window)))
    (let base (egg-data-base src (gm-alignment)))
    (let descs (dlp-collect src base
        (egg-tinfo-start src) (egg-tensor-count src)))
    (dlw-init-prompt descs ids 0)
    (dlw-prefill-layers src descs ids 0 3)
    (print_str (metal_model_close))
    0)
