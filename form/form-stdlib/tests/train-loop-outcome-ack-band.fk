; train-loop-outcome-ack-band.fk — pure structural proof for the local carrier
; ACK.  No model, Metal, process, network, or filesystem effect is opened.
;
; preludes: learn/train-loop-outcome-ack.fk

(do
    (defn tloab-bit (ok bit) (if ok bit 0))
    (defn tloab-sha-a ()
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    (defn tloab-sha-b ()
        "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
    (defn tloab-observation (role n sha)
        (tloa-file-observation role (str_concat "/local/" role) 0 n n sha
            (tloab-sha-b)))
    (defn tloab-observations (last-sha)
        (list
            (tloab-observation "config" 1 (tloab-sha-a))
            (tloab-observation "weights" 2 (tloab-sha-a))
            (tloab-observation "weights-index" 3 (tloab-sha-a))
            (tloab-observation "tokenizer" 4 (tloab-sha-a))
            (tloab-observation "tokenizer-config" 5 (tloab-sha-a))
            (tloab-observation "chat-template" 6 last-sha)))

    (defn train-loop-outcome-ack-band ()
        (do
            (let observations (tloab-observations (tloab-sha-a)))
            (let changed-observations (tloab-observations (tloab-sha-b)))
            (let manifest (tloa-manifest observations))
            (let changed-manifest (tloa-manifest changed-observations))
            (let adapter-observation
                (tloab-observation "input-adapter" 7 (tloab-sha-a)))
            (let adapter (tloa-file-node adapter-observation))
            (let seal (tloa-manifest-seal observations))
            (let returned
                (tloa-ack "cycle-1" "rest-and-fuse" (tloa-status-returned)
                    "artifact-admitted" 0 adapter manifest 2 3 1 1
                    "/local/fused" 21 seal))
            (let duplicate
                (tloa-duplicate-ack "cycle-1" "rest-and-fuse" 3 adapter
                    "/local/fused"))
            (let failed
                (tloa-ack "cycle-2" "rest-and-fuse" (tloa-status-failure)
                    "carrier-unobserved" 1 adapter manifest 3 4 1 1
                    "/local/fused" 0 seal))
            (let silent
                (tloa-ack "cycle-3" "NOTHING" (tloa-status-nothing)
                    "no-directive" -1 adapter manifest 4 5 1 1
                    "/local/fused" 0 seal))
            (add
                (tloab-bit (eq (tloa-status? "returned") 1) 1)
            (add
                (tloab-bit (and (eq (tloa-status? "refused") 1)
                    (and (eq (tloa-status? "nothing") 1)
                    (and (eq (tloa-status? "choice") 1)
                    (and (eq (tloa-status? "failure") 1)
                         (eq (tloa-status? "timeout") 1))))) 2)
            (add
                (tloab-bit (eq (tloa-observations-valid? observations) 1) 4)
            (add
                (tloab-bit (eq (tloa-file-observation-valid?
                    (tloa-file-observation "weights" "/local/weights" 0 2 3
                        (tloab-sha-a) (tloab-sha-b))) 0) 8)
            (add
                (tloab-bit (eq (tloa-manifest-valid? manifest) 1) 16)
            (add
                (tloab-bit (eq (tloa-total-size (node_children manifest)) 21) 32)
            (add
                (tloab-bit (eq (tloa-ack-valid? returned) 1) 64)
            (add
                (tloab-bit (eq (tloa-ack-valid? duplicate) 1) 128)
            (add
                (tloab-bit (and (eq (tloa-ack-appended duplicate) 0)
                                 (str_eq (tloa-ack-reason duplicate)
                                         "duplicate-invocation")) 256)
            (add
                (tloab-bit (eq (tloa-ack-valid? failed) 1) 512)
            (add
                (tloab-bit (eq (tloa-ack-valid? silent) 1) 1024)
            (add
                (tloab-bit (and (not (str_eq (tloa-ack-status failed)
                                             (tloa-ack-status silent)))
                                 (and (eq (nothing? 0) 0)
                                      (eq (nothing? (nothing)) 1))) 2048)
            (add
                (tloab-bit (not (node_eq manifest changed-manifest)) 4096)
            (add
                (tloab-bit (and (ge (str_find (tloa-row returned)
                    "|exit=0|" 0) 0)
                    (and (ge (str_find (tloa-row returned)
                        "|artifact_size=21|" 0) 0)
                         (ge (str_find (tloa-row returned)
                            "|offline=1|" 0) 0))) 8192)
            (add
                (tloab-bit (and (lt (str_find (tlp-base-model) "http" 0) 0)
                                 (lt (str_find (tlp-base-model)
                                              "mlx-community/" 0) 0)) 16384)
                (tloab-bit (and (not (node_eq returned failed))
                                 (not (node_eq failed silent))) 32768))))))))))))))))))

    (train-loop-outcome-ack-band))
