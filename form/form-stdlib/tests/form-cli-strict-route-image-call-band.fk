; form-cli-strict-route-image-call-band.fk -- pure proof that one strict route
; admission decision executes through exact CALL_BINDING / OFFER / ACK data.
;
; Verdict 2047.
; preludes: form-stdlib/form-cli-strict-route-image-call.fk

(do
    (defn fcsrib-bit (held weight) (if held weight 0))
    (defn fcsrib-ack (receipt) (nth receipt 2))
    (defn fcsrib-value (receipt)
        (fpcp-value-raw (fpcp-ack-value (fcsrib-ack receipt))))

    (defn form-cli-strict-route-image-call-band ()
        (do
            (let correlation
                (intern_trivial_string "strict-route-correlation-71"))
            (let admitted (fcsri-receipt 1 "concept" 1 correlation 17))
            (let absent (fcsri-receipt 1 "concept" 0 correlation 17))
            (let invalid (fcsri-receipt 0 "concept" 1 correlation 17))
            (let nodeid (fcsri-receipt 1 "nodeid" 1 correlation 17))
            (let request-two (fcsri-receipt 2 "concept" 1 correlation 17))
            (let route-two (fcsri-receipt 1 "concept" 2 correlation 17))
            (let timed (fcsri-receipt 1 "concept" 1 correlation 16))
            (let protocol (nth admitted 0))
            (let offer (nth admitted 1))
            (let ack (fcsrib-ack admitted))
            (let call (fpcp-child offer 0))
            (let values (fpcp-offer-values offer))
            (let unadmitted-call (fpcp-call-binding
                (fpcp-child call 0) "unadmitted-strict-route"
                (fpcp-child call 2) (fpcp-child call 3)))
            (let unadmitted-offer (fpcp-offer unadmitted-call correlation
                values 17))
            (let unadmitted-ack
                (fpcp-execute protocol unadmitted-offer))
            (let denied-protocol (fpcp-registry
                (fpcp-registry-images protocol) (empty) (list call)))
            (let denied-ack (fpcp-execute denied-protocol offer))
            (sum (list
                (fcsrib-bit (and (eq (fcatw-image-valid? (fcsri-image)) 1)
                    (and (eq (fcatw-image-root (fcsri-image)) 12)
                         (eq (len (fcatw-image-kinds (fcsri-image))) 3))) 1)
                (fcsrib-bit (and (str_eq (fpcp-ack-status ack) "returned")
                    (and (eq (fcsrib-value admitted) 1)
                    (and (eq (fpcp-ack-steps ack) 17)
                    (and (eq (fpcp-ack-output ack) 1)
                         (eq (nth admitted 3) 1))))) 2)
                (fcsrib-bit (and (str_eq
                        (fpcp-ack-status (fcsrib-ack absent)) "returned")
                    (and (eq (fcsrib-value absent) 0)
                    (and (eq (fpcp-value-kind
                            (fpcp-ack-value (fcsrib-ack absent)))
                            (fcatw-kind-int))
                         (eq (fpcp-ack-output (fcsrib-ack absent)) 1)))) 4)
                (fcsrib-bit (and (eq (fcsrib-value invalid) 0)
                    (and (eq (fpcp-ack-steps (fcsrib-ack invalid)) 17)
                         (eq (nth invalid 3) 1))) 8)
                (fcsrib-bit (and (eq (fcsrib-value nodeid) 0)
                    (and (eq (fpcp-ack-output (fcsrib-ack nodeid)) 1)
                         (eq (nth nodeid 3) 1))) 16)
                (fcsrib-bit (and (eq (fcsrib-value request-two) 0)
                    (and (eq (fcsrib-value route-two) 0)
                    (and (eq (nth request-two 3) 1)
                         (eq (nth route-two 3) 1)))) 32)
                (fcsrib-bit (and (str_eq
                        (fpcp-ack-status (fcsrib-ack timed)) "timeout")
                    (and (eq (fpcp-ack-output (fcsrib-ack timed)) 0)
                    (and (eq (fpcp-value-kind
                            (fpcp-ack-value (fcsrib-ack timed)))
                            (fcatw-kind-nothing))
                         (eq (nth timed 3) 1)))) 64)
                (fcsrib-bit (and (str_eq
                        (fpcp-ack-status unadmitted-ack) "nothing")
                    (and (eq (fpcp-value-kind
                            (fpcp-ack-value unadmitted-ack))
                            (fcatw-kind-nothing))
                    (and (eq (fpcp-ack-output unadmitted-ack) 0)
                         (eq (fpcp-ack-observed? protocol unadmitted-offer
                                unadmitted-ack) 1)))) 128)
                (fcsrib-bit (and (str_eq
                        (fpcp-ack-status denied-ack) "refused")
                    (and (str_eq (fpcp-ack-reason denied-ack)
                            "capability-refused")
                    (and (eq (fpcp-ack-output denied-ack) 0)
                         (eq (fpcp-ack-observed? denied-protocol offer
                                denied-ack) 1)))) 256)
                (fcsrib-bit (and (node_eq
                        (fpcp-ack-correlation ack) correlation)
                    (and (eq (fpcp-call-valid? call) 1)
                    (and (node_eq (fcatw-binding-image (fpcp-child call 2))
                                  (fcsri-image))
                         (not (node_eq (fpcp-child call 0)
                                       (fpcp-child call 2)))))) 512)
                (fcsrib-bit (and (eq (fpcp-ack-valid? ack) 1)
                    (and (eq (nth absent 3) 1)
                    (and (eq (nth invalid 3) 1)
                    (and (eq (nth nodeid 3) 1)
                    (and (eq (nth request-two 3) 1)
                    (and (eq (nth route-two 3) 1)
                         (eq (nth timed 3) 1))))))) 1024)))))

    (form-cli-strict-route-image-call-band))
