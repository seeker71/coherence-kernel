; band-sweep-band.bml — the sweep that walks every band on fkwu (form-stdlib/bml/band-sweep.bml, the door gate/band-sweep-run.bml)
; enumerates, runs legs in a pool with a deadline each, judges by exit, stderr and pins, releases what a band left, and says what it saw.
; The legs here are fixture bands (tests/fixtures/band-sweep/) that answer, fail, hang, rest or leave a reader waiting on a fifo.
;
; Verdict 1048575 when every claim lands:
;   1      enumeration: the workloads are samples, then form-stdlib/tests (core.fk, a module of the band's own name between when one
;          stands, the band), then every other home's *-band.fk and *-band.bml; no -child, -fixture or -run door is a workload, no
;          path starts with `.`, every file stands; a match of alternatives picks by label; one explicit workload names its files
;   2      the heads: a band's head pin, its manifest stem (the exact name, else without -band, only under form-stdlib/tests) and its
;          registered verdict read as the list shows them; a band with a row and no pin, a pin and no row, neither
;   4      judgment: the first reason that holds wins, in order: the deadline, a nonzero exit, a diagnostic line on stderr, the head
;          pin, the registered verdict; no reason when each holds; stderr lines counted by what they say (unresolved-call, error:,
;          compiled with errors)
;   8      the unit: one file runs as itself, several through a root `; preludes:` line of the files in order, written once by a name
;          of the text and rewritten when the file there holds other text
;   16     the pool: six fixtures (answers its pin, hangs, runs clean unpinned, answers 8 against a pin of 7, stops with an error, names
;          a carrier that is absent) tally 1 pinned, 1 unpinned, 1 staged, 3 failed, the deadline named, and print in the order given
;          though the hang ends last
;   32     the lines: `  ✓  <label padded to 30>  → 7 (its pin)`, the unpinned `·` line, the `✗` lines with why (`answered 8, its head pins 7`,
;          `exit 1`, `ended at the deadline: ended after`) and `evidence=` naming a directory that holds the band's stdout, and the staged
;          `⧗` line naming the door that builds the carrier; a passing workload leaves no legs behind
;   64     the deadline: a leg that outlives a 3 s ceiling is ended with its lineage (the child is gone) and its band fails naming it
;   128    parallel: six legs of a second and a half under a pool of six finish in under five seconds, each answers 1, none shares a scratch
;   256    the fifo: a band that leaves a reader waiting in open() on a fifo of its scratch leaves no reader after the sweep; the same band
;          run with nothing to release it leaves the reader standing (the plant that shows the release is what ended it); a band that
;          leaves a fifo with no reader on it never holds the sweep (the release is a child that waits, with a brief deadline, not this door)
;   512    the list: `label<TAB>files<TAB>staged=<yes|no><TAB>pin=<n|-><TAB>row=<n|->` for a band with both pins and a band with a row only
;   1024   the summary: the pinned and unpinned counts, the staged line only when some are pending, the deadlines line only when some
;          were met, `N ok, 0 failed` or `N ok, F failed`
;   2048   the seal: a void reading names both stamps and says it is neither a pass nor a failure; the stamp is HEAD then git's status
;   4096   the door as a child: `{"files":[a passing fixture]}` prints the gates, the build words and a ✓ line and exits 0; a failing one
;          prints the ✗ line, `1 failed` and exits 1; a missing file names itself and exits 1 before any gate; `{"list":1,"match":...}`
;          lists and runs nothing
;   8192   plant: judged with the pin ignored, the mismatched answer is no failure: claim 4 holds because the pin is read
;   16384  plant: with no ceiling reached (a 600 s ceiling) the hang fixture is still alive after 3 s: claim 64 holds because the deadline ended it
;   32768  scale: the real enumeration (over 300 workloads) and every list line (each reads its band's head and the manifest) take under 20 s
;   65536  strict: the door as a child on `{bad json`, a typo'd key, a key of the wrong kind, and a `match` (with or without list) that selects
;          no workload ends in exit 1 with a named refusal before any gate or leg runs
;   131072 unread: the registered verdicts absent, empty or mode 000, and a band file of mode 000, are each a named refusal (`<path> does not
;          read`, `is empty`, `every pin would be dropped`), never the silent "answered every pin"
;   262144 plant: with the real manifest and a real workload the preflight is silent and a selection of one is not refused: claims 65536 and
;          131072 refuse because of what they read, not always
;   524288 the sort: each leg is asked once whether it is done and lands in the ended list or the kept list, never both and never neither, over sixty
;          rounds of six children that stop while it asks (asked twice, a leg that stopped between the questions was never judged: a flaky
;          3-of-6 sweep with `0 failed`, 2026-10-04); a leg never born and a leg past its ceiling are ended, a live one kept
;
; REQUIRES: the built ./fkwu, the body root as the working directory and a git checkout.
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/parse.bml form-stdlib/bml/band-sweep.bml
section [form.bml] {
 class BandSweepBand {
  def bsb-fx() = "form/form-stdlib/tests/fixtures/band-sweep/";
  def bsb-w(name) = bsw-explicit([bsb-fx() ++ name]);
  def bsb-opts(jobs, ceiling) = [jobs, "./fkwu", ceiling];
  def bsb-spaces(k) = k <= 0 ? "" : " " ++ bsb-spaces(k - 1);
  def bsb-label(l) = l ++ bsb-spaces(30 - len(l));
  // ---- 1 enumeration
  def bsb-c-enum(ctx) {
   let all = bsw-all();
   let labels = map(w => w[0], all);
   let three = filter(w => len(w[1]) == 3, all);
   let two = filter(w => len(w[1]) == 2, all);
   len(all) > 300 && bsw-starts?(all[0][1][0], "form/form-samples/")
   && any?(w => bsw-starts?(w[0], "stdlib/"), all) && any?(w => bsw-starts?(w[1][0], "observe/tests/"), all)
   && all?(w => (String) w[1][0] == "form/form-stdlib/core.fk", filter(w => bsw-starts?(w[0], "stdlib/"), all))
   && all?(w => (String) w[1][1] == "form/form-stdlib/" ++ bsw-stem(w[1][2]) ++ ".fk", three)
   && !any?(w => bsw-door-stem?(bsw-stem(bsw-band-of(w))) && bsw-starts?(w[0], "stdlib/"), all)
   && !any?(w => str_byte_at(w[1][0], 0) == 46, all) && all?(w => all?(f => (Comparable) file_size(f) >= 0, w[1]), all)
   && len(bsw-select(all, "adler32|text-tokenize")) == 2 && len(bsw-select(all, "no-such-band-anywhere")) == 0 && len(bsw-select(all, "")) == len(all)
   && (String) bsw-explicit(["form-stdlib/core.fk", "x/y.fk"])[0] == "core.fk+y.fk" && (String) bsw-explicit(["form-stdlib/core.fk"])[1][0] == "form/form-stdlib/core.fk"
   && (String) bsw-explicit(["observe/band-head.bml"])[1][0] == "observe/band-head.bml" && len(bsw-missing(["form-stdlib/core.fk", "no/such.fk"])) == 1;
  }
  // ---- 2 the heads
  def bsb-w-of(label) = filter(w => (String) w[0] == label, bsw-all())[0];
  def bsb-c-heads(ctx) {
   let land = bsb-w-of("stdlib/land-cadence-band.fk");
   let adler = bsb-w-of("stdlib/adler32-band.fk");
   let guard = bsb-w-of("stdlib/spawn-guard-band.bml");
   bsw-digits?(bsw-head-pin(land)) && (String) bsw-reg-pin(land) == (String) bsw-head-pin(land) && (String) bsw-stem-of(land) == "land-cadence"
   && (String) bsw-head-pin(adler) == "" && (String) bsw-reg-pin(adler) == "5" && (String) bsw-stem-of(adler) == "adler32"
   && bsw-digits?(bsw-head-pin(guard)) && (String) bsw-reg-pin(guard) == "" && (String) bsw-stem-of(guard) == ""
   && (String) bsw-stem-of(["observe/tests/band-head-band.fk", ["observe/tests/band-head-band.fk"]]) == ""
   && (String) bsw-level(land) == "" && (String) bsw-level(bsb-w("staged-absent.fk")) == "FKWU-STAGED"
   && (String) bsw-carrier(bsb-w("staged-absent.fk")) == ".hearth/no-such-carrier" && (String) bsw-door(bsb-w("staged-absent.fk")) == "./fkwu observe/build-no-such-carrier.bml";
  }
  // ---- 4 judgment
  def bsb-c-judge(ctx) {
   (String) bsw-why(true, nothing(), 0, "7", "7", "7", "ended after 3s") == "ended at the deadline: ended after 3s"
   && (String) bsw-why(false, 1, 5, "8", "7", "7", "") == "exit 1" && (String) bsw-why(false, 0, 2, "8", "7", "7", "") == "2 diagnostic line(s) on stderr"
   && (String) bsw-why(false, 0, 0, "8", "7", "9", "") == "answered 8, its head pins 7" && (String) bsw-why(false, 0, 0, "9", "", "7", "") == "answered 9, the manifest registers 7"
   && (String) bsw-why(false, 0, 0, "", "7", "", "") == "answered <nothing>, its head pins 7" && (String) bsw-why(false, 0, 0, "7", "7", "7", "") == ""
   && (String) bsw-why(false, 0, 0, "3", "", "", "") == "" && (String) bsw-why(false, nothing(), 0, "7", "7", "7", "") == "birth refused: no exit arrived"
   && bsw-diags("a\nfkwu: x: error: y\nb [unresolved-call] z\ncompiled with errors\n") == 3 && bsw-diags("warning: only\n") == 0 && bsw-diags("") == 0;
  }
  // ---- 8 the unit
  def bsb-c-unit(ctx) {
   let one = bsw-unit(["x", ["form/form-stdlib/core.fk"]]);
   let two = bsw-unit(["y", ["form/form-stdlib/core.fk", "form/form-stdlib/tests/adler32-band.fk"]]);
   let again = bsw-unit(["y", ["form/form-stdlib/core.fk", "form/form-stdlib/tests/adler32-band.fk"]]);
   let spoiled = write_file(two, "garbage\n");
   let healed = bsw-unit(["y", ["form/form-stdlib/core.fk", "form/form-stdlib/tests/adler32-band.fk"]]);
   (String) one == "form/form-stdlib/core.fk" && (String) two == (String) again && bsw-starts?(two, "form/form-stdlib/.cache/workloads/") && bsw-ends?(two, "-adler32-band.fk")
   && (String) healed == (String) two && (String) read_file(two) == "; preludes: form/form-stdlib/core.fk form/form-stdlib/tests/adler32-band.fk\n"
   && (String) bsw-unit(["z", ["form/form-stdlib/core.fk", "form/form-stdlib/tests/adler32-band.fk", "form/form-stdlib/tests/text-tokenize-band.fk"]]) != (String) two;
  }
  // ---- 16 32 64 the pool, the lines, the deadline
  def bsb-six() = [bsb-w("pass-pinned.fk"), bsb-w("hang.fk"), bsb-w("pass-unpinned.fk"), bsb-w("fail-pin.fk"), bsb-w("fail-exit.fk"), bsb-w("staged-absent.fk")];
  def bsb-run-six(ctx) {
   let got = bsw-run(bsb-six(), bsb-opts(3, 3));
   got;
  }
  def bsb-lines(got) = reverse(got[5]);
  def bsb-evidence-of(line) {
   let at = str_find(line, "evidence=", 0);
   at < 0 ? "" : substring(line, at + 9, len(line));
  }
  def bsb-c-pool(ctx) {
   let t0 = host_monotonic_ms();
   let got = bsb-run-six(ctx);
   let lines = bsb-lines(got);
   len(lines) == 6 && got[0] == 1 && got[1] == 1 && got[2] == 1 && got[3] == 3 && (String) got[4] == "hang.fk"
   && bsw-has?(lines[0], "pass-pinned.fk") && bsw-has?(lines[1], "hang.fk") && bsw-has?(lines[2], "pass-unpinned.fk")
   && bsw-has?(lines[3], "fail-pin.fk") && bsw-has?(lines[4], "fail-exit.fk") && bsw-has?(lines[5], "staged-absent.fk")
   && host_monotonic_ms() - t0 < 30000;
  }
  def bsb-c-lines(ctx) {
   let got = bsb-run-six(ctx);
   let lines = bsb-lines(got);
   let ev3 = bsb-evidence-of(lines[3]);
   let ev4 = bsb-evidence-of(lines[4]);
   let ev1 = bsb-evidence-of(lines[1]);
   let held = (String) lines[0] == "  ✓  " ++ bsb-label("pass-pinned.fk") ++ "  → 7 (its pin)"
    && (String) lines[2] == "  ·  " ++ bsb-label("pass-unpinned.fk") ++ "  → 3 (ran clean; no pin to answer)"
    && bsw-starts?(lines[3], "  ✗  " ++ bsb-label("fail-pin.fk") ++ "  fkwu: answered 8, its head pins 7\n      evidence=")
    && bsw-starts?(lines[4], "  ✗  " ++ bsb-label("fail-exit.fk") ++ "  fkwu: exit 1\n      evidence=")
    && bsw-starts?(lines[1], "  ✗  " ++ bsb-label("hang.fk") ++ "  fkwu: ended at the deadline: ended after ")
    && (String) lines[5] == "  ⧗  " ++ bsb-label("staged-absent.fk") ++ "  staged — carrier absent in this checkout (./fkwu observe/build-no-such-carrier.bml builds it); pending, not witnessed"
    && (String) read_file(ev3 ++ "/fk") == "8\n" && (Comparable) host_path_exists(ev1 ++ "/fk.deadline") == 1
    && bsw-has?(read_file(ev4 ++ "/fk.err") ?? "", "planted stop");
   let cleaned = host_dir_rmdir(ev1) + host_dir_rmdir(ev3) + host_dir_rmdir(ev4);
   held && (Comparable) host_path_exists(ev3) != 1 && (Comparable) host_path_exists(bsw-legs-path(0)) != 1 && (Comparable) host_path_exists(bsw-scratch-path(0)) != 1;
  }
  def bsb-c-deadline(ctx) {
   let t0 = host_monotonic_ms();
   let got = bsw-run([bsb-w("hang.fk")], bsb-opts(1, 3));
   let took = host_monotonic_ms() - t0;
   let ev = bsb-evidence-of(bsb-lines(got)[0]);
   let said = read_file(ev ++ "/fk.deadline") ?? "";
   let gone = host_dir_rmdir(ev);
   got[3] == 1 && (String) got[4] == "hang.fk" && took >= 3000 && took < 15000 && bsw-starts?(said, "ended after 3s: deadline 3s (the ceiling)");
  }
  // ---- 128 parallel
  def bsb-c-parallel(ctx) {
   let t0 = host_monotonic_ms();
   let got = bsw-run(map(i => bsb-w("nap.fk"), [1, 2, 3, 4, 5, 6]), bsb-opts(6, 60));
   got[1] == 6 && got[3] == 0 && host_monotonic_ms() - t0 < 5000 && all?(l => bsw-has?(l, "→ 1 (ran clean"), bsb-lines(got));
  }
  // ---- 256 the fifo
  def bsb-reader-pid() = parse-int(trim(read_file(".hearth/band-sweep-fifo.pid") ?? ""));
  def bsb-alive-soon?(pid, until) = (Comparable) host_alive(pid) == 1 && host_monotonic_ms() < until ? bsb-alive-soon-again(pid, until) : (Comparable) host_alive(pid) == 1;
  def bsb-alive-soon-again(pid, until) {
   let rested = host_sleep_ms(50);
   bsb-alive-soon?(pid, until);
  }
  def bsb-c-fifo(ctx) {
   let fx = bsb-fx() ++ "fifo-orphan.bml";
   let swept = bsw-run([bsw-explicit([fx])], bsb-opts(1, 60));
   let pid = bsb-reader-pid();
   let gone = !nothing?(pid) && !bsb-alive-soon?(pid, host_monotonic_ms() + 3000);
   let bare = hch-run-in(".hearth/validation", "fifo-bare", ["./fkwu", fx], "", hch-by(60000));
   let pid2 = bsb-reader-pid();
   let standing = !nothing?(pid2) && (Comparable) host_alive(pid2) == 1;
   let freed = standing ? host_kill(pid2) : 0;
   let rested = host_sleep_ms(200);
   let removed = host_path_remove(temp_dir() ++ "/orphan.fifo");
   let t0 = host_monotonic_ms();
   let none = bsw-run([bsw-explicit([bsb-fx() ++ "fifo-bare.bml"])], bsb-opts(1, 60));
   let waited = host_monotonic_ms() - t0;
   swept[1] == 1 && gone && hch-ok?(bare) && standing && (Comparable) host_alive(pid2) != 1 && none[1] == 1 && waited < 20000;
  }
  // ---- 512 the list
  def bsb-c-list(ctx) {
   let land = bsb-w-of("stdlib/land-cadence-band.fk");
   let adler = bsb-w-of("stdlib/adler32-band.fk");
   (String) bsw-list-line(land) == "stdlib/land-cadence-band.fk\tform/form-stdlib/core.fk form/form-stdlib/tests/land-cadence-band.fk\tstaged=no\tpin=" ++ bsw-head-pin(land) ++ "\trow=" ++ bsw-reg-pin(land)
   && (String) bsw-list-line(adler) == "stdlib/adler32-band.fk\tform/form-stdlib/core.fk form/form-stdlib/tests/adler32-band.fk\tstaged=no\tpin=-\trow=5"
   && bsw-has?(bsw-list-line(bsb-w("staged-absent.fk")), "\tstaged=yes\tpin=-\trow=-");
  }
  // ---- 1024 the summary
  def bsb-c-summary(ctx) {
   let clean = bsw-summary([3, 2, 0, 0, "", []]);
   let busy = bsw-summary([3, 2, 1, 2, "hang.fk slow-band.fk", []]);
   len(clean) == 3 && (String) clean[0] == "" && (String) clean[1] == "  fkwu: 3 band(s) answered their pins; 2 ran clean with no pin to answer" && (String) clean[2] == "  5 ok, 0 failed — fkwu answered every pin it was asked."
   && len(busy) == 5 && (String) busy[2] == "  staged lanes pending: 1 band(s) need an absent host carrier — not witnessed"
   && (String) busy[3] == "  deadlines met: hang.fk slow-band.fk — each leg named was ended with its process tree; its streams are kept"
   && (String) busy[4] == "  5 ok, 2 failed — inspect exit statuses and retained streams.";
  }
  // ---- 2048 the seal
  def bsb-c-seal(ctx) {
   let stamp = bsw-stamp();
   let void = bsw-void-lines("abc:x", "abc:y");
   len(void) == 4 && bsw-has?(void[0], "VOID READING") && bsw-has?(void[1], "start abc:x") && bsw-has?(void[2], "end   abc:y") && bsw-has?(void[3], "neither a pass nor a failure")
   && str_byte_at(stamp, 40) == 58 && scan_run(stamp, 0, 6) >= 0 && len(stamp) >= 41;
  }
  // ---- 4096 the door as a child
  def bsb-door(ctx, name, input) {
   let base = ctx[1] ++ "/" ++ name;
   let w = write_file(base ++ ".in", input);
   let pid = host_spawn_at(["./fkwu", "gate/band-sweep-run.bml"], [base ++ ".in", base ++ ".out", base ++ ".err"]);
   let status = pid <= 0 ? -1 : host_wait(pid);
   [status, read_file(base ++ ".out") ?? "", read_file(base ++ ".err") ?? ""];
  }
  def bsb-c-door(ctx) {
   let ok = bsb-door(ctx, "ok", "{\"files\":[\"form-stdlib/tests/fixtures/band-sweep/pass-pinned.fk\"]}");
   let bad = bsb-door(ctx, "bad", "{\"files\":[\"form-stdlib/tests/fixtures/band-sweep/fail-pin.fk\"]}");
   let gone = bsb-door(ctx, "gone", "{\"files\":[\"no/such.fk\"]}");
   let list = bsb-door(ctx, "list", "{\"list\":1,\"match\":\"adler32\"}");
   let kept = host_dir_rmdir(trim(bsb-evidence-of(bad[1])));
   ok[0] == 0 && bsw-has?(ok[1], "structural-gate-v6") && bsw-has?(ok[1], "  runtime fkwu: build=") && bsw-has?(ok[1], "  ✓  pass-pinned.fk") && bsw-has?(ok[1], "  1 ok, 0 failed — fkwu answered every pin it was asked.")
   && (Comparable) bad[0] != 0 && bsw-has?(bad[1], "  ✗  fail-pin.fk") && bsw-has?(bad[1], "  0 ok, 1 failed — inspect exit statuses and retained streams.") && bsw-has?(bad[2], "band-sweep: 1 workload(s) failed")
   && (Comparable) gone[0] != 0 && bsw-has?(gone[1], "input file(s) not found") && bsw-has?(gone[1], "no/such.fk") && !bsw-has?(gone[1], "structural-gate-v6")
   && list[0] == 0 && bsw-has?(list[1], "stdlib/adler32-band.fk\tform/form-stdlib/core.fk form/form-stdlib/tests/adler32-band.fk\tstaged=no\tpin=-\trow=5") && !bsw-has?(list[1], "structural-gate-v6");
  }
  // ---- 65536 strict: a request that does not read, and a selection of nothing, are refused by name before any gate or leg
  def bsb-refused?(run, word) = (Comparable) run[0] == 1 && bsw-has?(run[1], "band-sweep: " ++ word) && !bsw-has?(run[1], "structural-gate-v6") && !bsw-has?(run[1], "runtime fkwu");
  def bsb-c-strict(ctx) {
   let bad = bsb-door(ctx, "s-bad", "{bad json");
   let typo = bsb-door(ctx, "s-typo", "{\"lst\":1}");
   let kind = bsb-door(ctx, "s-kind", "{\"jobs\":\"4\"}");
   let none = bsb-door(ctx, "s-none", "{\"match\":\"no-such-band-anywhere\"}");
   let nonelist = bsb-door(ctx, "s-nonelist", "{\"list\":1,\"match\":\"no-such-band-anywhere\"}");
   bsb-refused?(bad, "stdin is not well-formed JSON") && bsb-refused?(typo, "unknown key \"lst\"") && bsb-refused?(kind, "key \"jobs\" must be an integer")
   && bsb-refused?(none, "the selection holds no workload") && bsb-has-match?(none) && bsb-refused?(nonelist, "the selection holds no workload");
  }
  def bsb-has-match?(run) = bsw-has?(run[1], "match \"no-such-band-anywhere\"");
  // ---- 131072 unread: the registered verdicts or a band that does not read, or is empty, is a named refusal (its pins would be dropped silently)
  def bsb-chmod(mode, path) = (Comparable) hch-run-in(".hearth/validation", "chmod", ["/bin/chmod", mode, path], "", hch-by(20000))[0] == 0;
  def bsb-c-unread(ctx) {
   let absent = ctx[1] ++ "/no-such-manifest.txt";
   let empty = ctx[1] ++ "/empty-manifest.txt";
   let closed = ctx[1] ++ "/closed-manifest.txt";
   let band = ctx[1] ++ "/closed-band.fk";
   let made = write_file(empty, "") + write_file(closed, "x 1 1\n") + write_file(band, "; Verdict 1\n1\n");
   let shut = bsb-chmod("000", closed) && bsb-chmod("000", band);
   let real = [bsb-w("pass-pinned.fk")];
   let shut-band = [bsw-explicit([band])];
   let a = bsw-preflight-why(absent, real);
   let e = bsw-preflight-why(empty, real);
   let c = bsw-preflight-why(closed, real);
   let b = bsw-preflight-why(bsw-manifest(), shut-band);
   let opened = bsb-chmod("600", closed) && bsb-chmod("600", band);
   shut && bsw-has?(a, "no-such-manifest.txt does not read") && bsw-has?(e, "empty-manifest.txt is empty") && bsw-has?(c, "closed-manifest.txt does not read")
   && bsw-has?(c, "every pin would be dropped") && bsw-has?(b, "closed-band.fk does not read") && opened;
  }
  // ---- 524288 the sort: every leg is in the ended list or the kept list, never both and never neither, though legs stop while it asks
  def bsb-round(i) {
   let pids = map(k => host_spawn_at(["/usr/bin/true"], ["/dev/null", "/dev/null", "/dev/null"]), [1, 2, 3, 4, 5, 6]);
   let jobs = map(k => [k, pids[k], host_monotonic_ms()], [0, 1, 2, 3, 4, 5]);
   let sorted = bsw-sort(jobs, 3600000);
   let reaped = map(p => p > 0 ? host_wait(p) : 0, pids);
   len(sorted[0]) + len(sorted[1]) == 6 && all?(k => any?(j => j[0] == k, sorted[0]) != any?(j => j[0] == k, sorted[1]), [0, 1, 2, 3, 4, 5]);
  }
  def bsb-c-sort(ctx) {
   let never = bsw-sort([[0, 0, host_monotonic_ms()]], 3600000);
   let late = bsw-sort([[1, host_pid(), host_monotonic_ms() - 7200000]], 3600000);
   let live = bsw-sort([[2, host_pid(), host_monotonic_ms()]], 3600000);
   len(never[0]) == 1 && nil?(never[1]) && len(late[0]) == 1 && nil?(late[1]) && nil?(live[0]) && len(live[1]) == 1
   && all?(i => bsb-round(i), range(0, 60));
  }
  // ---- the plants
  def bsb-c-plant-reads(ctx) {
   let real = [bsb-w("pass-pinned.fk")];
   (String) bsw-preflight-why(bsw-manifest(), real) == "" && (String) bsw-selection-why(real, json-node-object([])) == "" && len(bsw-selection-why([], json-node-object([]))) > 0
   && (String) bsw-first-why(["", ""]) == "" && (String) bsw-first-why(["", "a", "b"]) == "a";
  }
  def bsb-c-plant-pin(ctx) = (String) bsw-why(false, 0, 0, "8", "", "", "") == "" && (String) bsw-why(false, 0, 0, "8", "7", "", "") != "";
  def bsb-c-plant-deadline(ctx) {
   let io = ".hearth/validation";
   let t0 = host_monotonic_ms();
   let got = bsw-run([bsb-w("nap.fk")], bsb-opts(1, 600));
   let slow = bsw-begin(bsb-w("hang.fk"), 90, "./fkwu");
   let rested = host_sleep_ms(3000);
   let standing = bsw-alive?(slow);
   let ended = standing ? bsw-end(slow, 3) : "";
   let released = bsw-release(slow);
   let cleaned = host_dir_rmdir(slow[3]) + host_dir_rmdir(slow[4]);
   got[1] == 1 && standing && !bsw-alive?(slow) && bsw-has?(ended, "deadline");
  }
  // ---- 32768 scale
  def bsb-c-scale(ctx) {
   let t0 = host_monotonic_ms();
   let all = bsw-all();
   let took = host_monotonic_ms() - t0;
   let lines = map(w => bsw-list-line(w), all);
   len(all) > 300 && len(lines) == len(all) && host_monotonic_ms() - t0 < 20000 && took < 20000;
  }
 }
 let ctx = ["sweep", temp_dir() ++ "/band-sweep-band-" ++ now_unix_ms().str(), 0];
 let made = host_dir_mkdir(ctx[1]);
 made != 1 ? form_error("band-sweep band needs a fresh directory") : 0;
 let verdict = live-claims("band-sweep-band", ctx, [["enumeration", 1, 1, bsb-c-enum], ["heads", 2, 1, bsb-c-heads], ["judgment", 4, 1, bsb-c-judge], ["unit", 8, 1, bsb-c-unit], ["pool", 16, 1, bsb-c-pool], ["lines", 32, 1, bsb-c-lines], ["deadline", 64, 1, bsb-c-deadline], ["parallel", 128, 1, bsb-c-parallel], ["fifo", 256, 1, bsb-c-fifo], ["list", 512, 1, bsb-c-list], ["summary", 1024, 1, bsb-c-summary], ["seal", 2048, 1, bsb-c-seal], ["door", 4096, 1, bsb-c-door], ["plant-pin", 8192, 1, bsb-c-plant-pin], ["plant-deadline", 16384, 1, bsb-c-plant-deadline], ["scale", 32768, 1, bsb-c-scale], ["strict", 65536, 1, bsb-c-strict], ["unread", 131072, 1, bsb-c-unread], ["plant-reads", 262144, 1, bsb-c-plant-reads], ["sort", 524288, 1, bsb-c-sort]]);
 host_dir_rmdir(ctx[1]);
 verdict;
}
