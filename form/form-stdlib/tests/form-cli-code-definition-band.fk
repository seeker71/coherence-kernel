; Actual source -> native module -> resident NodeID -> behavioral assertions.
; No model, subprocess, disk mutation or foreign kernel. Expected 127.
; preludes: form-stdlib/bml/form-cli-code-definition.bml
(do
 (defn fcadb-doc (source) (list (list "calc" "calc.form" source)))
 (defn fcadb-bit (ok bit) (if ok bit 0))
 (let row (faj-json "contract" "{\"kind\":\"definition\",\"path\":\"calc.form\",\"function\":\"bump\",\"cases\":[[0,1],[1,3],[21,43],[-2,-3]]}"))
 (sum (list
  (fcadb-bit (fcad-check-valid row) 1)
  (fcadb-bit (eq (head (fcad-check row (fcadb-doc "module calc { fn bump(x) = add(mul(x,2),1); }"))) 1) 2)
  (fcadb-bit (eq (head (fcad-check row (fcadb-doc "module calc { fn bump(x) = add(x,1); }"))) 0) 4)
  (fcadb-bit (eq (head (fcad-check row (fcadb-doc "module calc { fn bump(x) = host_exec(x); }"))) 0) 8)
  (fcadb-bit (eq (head (fcad-check row (fcadb-doc "module calc { fn bump(x) = bump(x); }"))) 0) 16)
  (fcadb-bit (eq (head (fcad-check row (fcadb-doc "module calc { fn bump(x) = add(x,y); }"))) 0) 32)
  (fcadb-bit (eq (head (fcad-check row (fcadb-doc "module calc { fn bump(x) = add(x,1); } trailing"))) 0) 64))))
