; One complete compressed DS4 layer through the 64 KiB Form-emitted controller.
; The model and Form-emitted libraries are live; PASS requires every indexed
; transaction step plus the summary to fit the expanded receipt window.
; witnessed: 2026-07-28 -> PASS layer-2, 39 steps, 44.309 ms
;
; preludes: native/metal/dsv4-native-session.fk native/metal/dsv4-jit-metal-abi.fk

(do
    (let admitted (dns-open))
    ; Only the explicit PASS arm may proceed. A busy/absent resident is
    ; `nothing`, not false, and must not cascade into embed/layer operations.
    (if (not (eq admitted 1)) 0
        (do
            (let src (eqr-of-file (dlp-model-path) 0 (gm-window)))
            (let base (egg-data-base src (gm-alignment)))
            (let descs
                (dlp-collect
                    src base
                    (egg-tinfo-start src)
                    (egg-tensor-count src)))
            ; Layer 2 exercises the compressed KV path rather than the smaller
            ; direct-KV branch at layers 0 and 1.
            (let plan (dlw-layer-plan src descs 2))
            (let route
                (dsv4-jit-metal-transaction-route
                    "fkwu-metal-transaction"))
            (dlw-embed-token descs 17)
            (let status
                (dlw-direct-layer-plan-jit route plan 17 0))
            (print_str
                (str_concat "JIT full-layer-status="
                    (if (nothing? status)
                        "nothing"
                        (int_to_str status))))
            (print_str (metal_model_close))
            (if (eq status 1) 255 0))))
