; Pure dynamic index reuse: current values, exact identities, no live publication.
; Expected 65535. Old snapshots and filtered rendering remain independent.
; preludes: form/form-stdlib/form-glass-live.bml
(do
 (defn fgci-row (id value) (fgo-int "kernel" id id value "calls" 0 "cpu-arena" "physical-live" "fixture" "live" "kernel" ""))
 (defn fgci-value (index id) (fgo-int-value (fgd-index-find index id)))
 (defn fgci-rows (i n) (if (ge i n) (list) (cons (fgci-row (int_to_str i) i) (fgci-rows (add i 1) n))))
 (defn fgci-hashes (i) (if (gt i 255) 1 (if (eq (fgd-key-hash (list i -1 4294967296 0 2147483648 -2 1 255 98765)) (km-hash (list i -1 4294967296 0 2147483648 -2 1 255 98765))) (fgci-hashes (add i 1)) 0)))
 (defn fgci-frame (rows filter index)
  (fgd-live-segment-frame-in 120 28 1000 25 1 "atlas" "all" filter "none" 0 rows (list) (list) "absent" (list) (list) "fixture" index))
 (let rows (list (fgci-row "guabx" 1) (fgci-row "naaeaa" 2) (fgci-row "guabx" 9) (fgci-row "صدا.日本語" 3)))
 (let first (fgd-metric-index-cached rows (list)))
 (let updated (list (fgci-row "guabx" 11) (fgci-row "naaeaa" 22) (fgci-row "guabx" 99) (fgci-row "صدا.日本語" 33)))
 (let next (fgd-metric-index-cached updated first))
 (let reordered (fgd-metric-index-cached (reverse updated) next))
 (let fewer (fgd-metric-index-cached (tail updated) next))
 (let more (fgd-metric-index-cached (cons (fgci-row "new" 77) updated) next))
 (let invalid (fgd-metric-index-cached (list (list) (fgci-row "" 8)) (list)))
 (let wideRows (append (fgci-rows 0 70) (list (fgci-row "0" 999))))
 (let wide (fgd-metric-index-cached wideRows (list)))
 (let shifted (fgd-metric-index-cached (tail wideRows) wide))
 (let different (fgd-metric-index-cached (cons (fgci-row "changed" 88) (tail wideRows)) wide))
 (let samples (list (list "sample" "guabx" 1) (list "sample" "naaeaa" 2) (list "sample" "guabx" 3) (list "sample" "صدا.日本語" 4)))
 (sum (list
  (if (and (eq (fgci-value first "guabx") 1) (eq (fgci-value next "guabx") 11)) 1 0)
  (if (value_eq (nth (head (nth first 2)) 1) (nth (head (nth next 2)) 1)) 2 0)
  (if (and (eq (fgci-value next "naaeaa") 22) (eq (fgci-value next "صدا.日本語") 33)) 4 0)
  (if (and (eq (fgci-value reordered "guabx") 99) (eq (fgci-value fewer "guabx") 99)) 8 0)
  (if (and (eq (fgci-value more "new") 77) (nil? (fgd-index-find next "new"))) 16 0)
  (if (and (eq (fgci-value invalid "") 8) (nil? (fgd-index-find invalid "missing"))) 32 0)
  (if (value_eq (fgci-frame updated "all" next) (fgci-frame updated "all" (list))) 64 0)
  (if (value_eq (fgci-frame updated "missing-filter" next) (fgci-frame updated "missing-filter" (list))) 128 0)
  (if (nil? (fgd-index-find (fgd-metric-index-cached (list) next) "guabx")) 256 0)
  (if (not (fgd-same-row-keys (list (list) (fgci-row "" 8)) (list (fgci-row "" 8) (list)))) 512 0)
  (if (and (eq (fgci-value wide "0") 0) (eq (fgci-value wide "69") 69)) 1024 0)
  (if (and (eq (fgci-value shifted "0") 999) (eq (fgci-value different "changed") 88)) 2048 0)
  (if (value_eq (nth (nth (nth wide 2) 1) 1) (nth (nth (nth different 2) 1) 1)) 4096 0)
  (if (value_eq (fgl-dedupe-samples samples) (fgl-dedupe-samples-go samples (list))) 8192 0)
  (if (nil? (fgl-dedupe-samples (list))) 16384 0)
  (if (and (fgci-hashes 0) (eq (fgd-key-hash (km-key-of-string "صدا.日本語guabx")) (km-hash-string "صدا.日本語guabx"))) 32768 0))))
