// Physical renderer, private output frames. Existing producer frames are read only.
// preludes: form/form-stdlib/form-glass-live.bml
section [form.bml] {
    class GlassFrameWorkChild {
        def fgfw-space() = str_concat("glass.band.frame-work.", int_to_str(host_pid()));
        def fgsr-publisher(sensor) = if str_eq(sensor, "glass") then str_concat(fgfw-space(), ".sensor") else fgsr-publisher-in(sensor, if fgsr-body-local?(sensor) then host_cwd() else "");
        def fgl-last-name(name) = str_concat(str_concat(fgfw-space(), ".last."), name);
        def FGLControlChannel() = fgfw-space();
        def fglu-supervisor-mark(state) = state;
        def fgl-poke-owner-status(samples, epoch) = 0;
        def main() = fgl-live();
    }
}
