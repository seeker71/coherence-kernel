  // ── 32768 ──
  def bnb-rg-line(i) = bnb-path() ++ ":" ++ (i + 1).str() ++ ":" ++ bnb-line(i) ++ "\n";
  def bnb-rg-lines(i, n, out) = i >= n ? reverse(out) : bnb-rg-lines(i + 1, n, cons(bnb-rg-line(i), out));
  def bnb-queried(tool, args, out) {
