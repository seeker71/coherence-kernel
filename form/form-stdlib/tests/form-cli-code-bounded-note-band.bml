  // ── 16384 ──
  // a failing tool result: exit 2 with stderr and a huge stdout (the probe's 37580-byte read), and a tiny stdout with a huge stderr
  def bnb-failed(doc, out, err) = fcap-tool-observed(bnb-open(doc), "read", [bnb-path()], "", fat-result(2, out, err, bnb-docs(doc)));
  def bnb-pending-bytes(st) = len(str-join(fcsw-pending(st)));
  def bnb-failure-bounded(session, failed) {
