; form-cli-code-bounded-note-band.bml — the coding lane does not feed a context what it cannot hold, does not renew into the
; overflow that stopped it, and does not read a refused read as fresh sight in every new context. No model runs: the lane's
; two ports (the decoder's prefill of an observation, the turn it takes next) and the renewer are scripted, tokens are
; counted at 0.352 IDs per byte (host-walk.bml's whole read at the day's turn, before f-split cut that file: 13411 IDs for
; 38058 bytes), and every step in between is the lane's own code (fcsw-step, fcac-advance-with, fcac-focus-observation,
; fcac-renew-with, fcac-finish-contexts-with, fcac-renewal-fits). The band generates its own documents at the measured sizes,
; so it does not read host-walk.bml.
;
; The finding it answers: the 12:30 day option on gap hw-conflict-named spent its whole 2.5 h window (wall_ms 8987068,
; band unmoved) reading host-walk.bml six times with the identical 77-byte reply. Each read filled the 16384-position
; window, a capacity stop renewed the stream, the renewal prompt re-embedded the read (prompts 16376, 15981, 16187 x3, 8 to
; 403 positions free), and the next reply was the same read: 5968 s of renewal, 1395 s of injection, 908 s of decode.
; The fixture (fixtures/form-cli-code-day-option.jsonl) holds that option's 14 retained replies and the nine form-code-context
; rows (context_prompt_ids, remaining_positions); the document is generated at the measured sizes.
;
; Verdict 524287 when every claim lands:
;   1    an observation under the cap passes through byte-identical: the decoder's port is handed exactly
;        fcac-observation-budget(next), the state is the stepped state unchanged, and nothing is bounded
;   2    a tool result over the cap (the day's 38 KB read, a fifth of the window being 3276 IDs) does not enter the
;        decoder whole though it would fit: the port is handed the bounded state's observation, which is under the cap and
;        carries cause observation-exceeds-note-cap, the exit, byte and line counts and sha256 of the read, its first
;        12 and last 6 lines, and the sed window to read next; the stage, turns and repair count are not moved (a read
;        that worked is no failure); a 30 KB read that the unmodified path takes whole (over 8000 IDs spent) costs the
;        bounded note under 2000
;   4    nothing is lost: the private evidence the note names holds the exact observation that was bounded, and no
;        checkpoint holds the whole read: what a managed lane saves after the capped turn, read back, carries the bounded
;        note, a tool history whose stdout is its sha256 and byte count, and no failure evidence or pending row that
;        repeats the read (the document itself stays whole in the checkpoint's documents)
;   8    any window is one native read away: the windows read_window names, run through the real sed tool, reassemble the
;        document byte for byte, each under the cap
;   16   the sibling's window refusal (afe428075) stands and carries the excerpt: a read that cannot fit the room is
;        refused as capacity before KV changes, the focus note is taken instead, the stage is repair with one repair, and a
;        second identical read invites the new plan (replan_required)
;   32   fcac-renewal-fits holds the room a renewal must leave (an eighth of the window, 1024 to a quarter): with no reply
;        ceiling it refuses the day's prompts of 16376, 15981 and 16187 IDs and the boundary 14336, admits 14335 and the
;        day's small prompts, and the reply arm still refuses where a ceiling does not fit
;   64   a renewal that cannot hold its trigger is a choice point: refused at 16187-ish IDs (the old guard passed it), asked
;        again once with the trigger bounded, and renewed small; a trigger that cannot be bounded is refused and ends the
;        lane with the named reason native-context-renewal-prompt-caller-capacity-refused after one attempt; a resumed
;        checkpoint that still holds a whole read is bounded when the lane opens, a small state passes unchanged
;   128  a refused read is not fresh sight: five contexts, each opening on the same read the previous one never took,
;        reach the policy's no-progress route at the third, the swerve at the third, the replan at the fourth and the end
;        at the fifth (stillstreak;candidate-retained), where the context counter never moved. This is the cross-context
;        path (a context that ends before it decodes another reply: an unadmitted note or a reply-capacity stop); a lane
;        whose focus note is admitted decodes its next reply in the same context, which claim 262144 reads
;   256  why the day's guards stayed silent: the same replay with every context taken as fresh sight (the rule before this
;        wave) never crosses in eight contexts (policy count 1, stillstreak 0, contexts 8), and an admitted read still
;        restarts both in a fresh context (the design kept)
;   512  the bounded note's edges: a verification note is never bounded (failed-check evidence stays complete), a note with
;        no tool result is not bounded, a repaired call's wrapped observation is, and a clip never splits a UTF-8 sequence
;   1024 the day option's record: 14 replies of which 8 are the same 77-byte read, and the nine contexts' prompts
;        2394 3181 16376 2722 2721 15981 2968 16187 16187
;   2048 the mirrors: docs/form-native-coding.md names the cap, the renewal room, the retry and the unsighted carry, and
;        the live source keeps the seams the claims stand on
;   4096 the lane's loop is unchanged where memory is concerned: fcac-loop is still the wrapper over fcac-loop-with and
;        fcac-observed, fcac-advance and the focus continue through the loop port, whose default is fcac-loop
;   8192 the renewal's result is used where the lane continues: fcac-finish-contexts-with, driven with a scripted loop port
;        and renewer, continues with the state the renewal built its prompt from (the bounded note, not the whole read),
;        and a refusal that stands ends the lane with its named reason: native-context-renewal-prompt-caller-capacity-refused,
;        or ...-prompt-context-window-refused once a read follows the unboundable goal
;   16384 a failing tool result cannot carry the whole read past the cap: exit 2 with stderr and a huge stdout, or a tiny
;        stdout with a huge stderr, is bounded, and what the decoder is handed (the observation, the failure evidence and the
;        pending rows) is under the cap, carries the stderr, holds no whole read, and counts one repair, not two
;   32768 the window is offered only where it is true: after a whole read or cat of a lane document the note names read_window
;        (sed -n over the path); after rg, sed or any other query its lines count the result, not the document, so it
;        names no window and says to run a narrower query
;   65536 same-call detection runs on a digest: the tool history holds a stdout over 2048 bytes as its sha256 and byte count
;        (a stderr as its first 200 bytes and digest), three identical big results reach the policy's no-progress route,
;        a result that differs by one byte counts afresh, a small result stays text, and a state written before the digest
;        (a whole stdout in its history) is digested when the lane opens on it
;   131072 the note is honest about what it holds, and a refusal of either kind is a choice point: a note with no retained
;        evidence says the bytes were not retained and names no evidence field; a renewal prompt over the whole window
;        (prompt-context-window-refused, a 54 KB read) is retried once with the trigger bounded as the room refusal is;
;        a bounded read that worked is a healthy organ reading with no need (the live source says so)
;   262144 the lane whose focus note is admitted decodes its next reply in the same context: the same read three replies in a
;        row there counts 1, 2, 3 (the context counter does not move), clears the unsighted mark at the second, reaches the
;        policy's no-progress route at the third with the swerve's still-streak at 2
;
; PROOF LEVEL: FOURTH-ARM ONLY -- fcsw-step opens stages on fkwu's stage bus, and the band writes under the hearth's private
; evidence directory (removed after) and reads the fixture and the docs from the worktree.
// preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-code-live.bml
section [form.bml] {
 class FormCliCodeBoundedNoteBand {
  def bnb-bit(ok, bit) = ok ? bit : 0;
  def bnb-has?(s, part) = str_find(s, part, 0) >= 0;
  def bnb-sha(text) = hex-encode(sha256-stream-string(text));
  def bnb-path() = "form/form-stdlib/bml/host-walk.bml";
  // a line of the generated document that no bounded note holds (the first 12 and last 6 lines are shown, and 300 is neither)
  def bnb-marker() = "hw-fixture-line-300(";
  def bnb-fixture() = "form/form-stdlib/tests/fixtures/form-cli-code-day-option.jsonl";
  // tokens at the measured 0.352 IDs per byte
  def bnb-ids(bytes) = ((bytes * 352) / 1000);
  def bnb-line(i) = "  def hw-fixture-line-" ++ i.str() ++ "(sync) = hw-note(sync, " ++ i.str() ++ ");";
  def bnb-lines(i, n, out) = i >= n ? reverse(out) : bnb-lines(i + 1, n, cons(bnb-line(i) ++ "\n", out));
  def bnb-doc(n) = str-join(bnb-lines(0, n, []));
  // sizes: 60 lines is a small read, 700 the day option's 38 KB, 1050 today's 54 KB host-walk.bml, 560 the read whose
  // renewal prompt fits the window and leaves it no room to act
  def bnb-small-lines() = 60;
  def bnb-day-lines() = 700;
  def bnb-today-lines() = 1050;
  def bnb-near-lines() = 560;
  def bnb-goal-lines() = 610;
  // what the band measured, for the receipt: the read's observation and its bounded note in scripted IDs, and the renewal
  // prompts (a renewal after the day's read, a goal no note can bound)
  def bnb-measure() {
   let session = bnb-session(2394, 0);
   let day = bnb-step(session, bnb-open(bnb-doc(bnb-day-lines())), bnb-read());
   let today = bnb-step(session, bnb-open(bnb-doc(bnb-today-lines())), bnb-read());
   let near = bnb-step(session, bnb-open(bnb-doc(bnb-near-lines())), bnb-read());
   let bounded = fcac-observation-capacity-state(day, "", fcap-cause-cap(), fcac-observation-cap-bytes(session));
   let huge = bnb-open-goal(str-join(bnb-lines(0, bnb-goal-lines(), [])), bnb-doc(bnb-small-lines()));
   "bytes day " ++ len(bnb-doc(bnb-day-lines())).str() ++ " today " ++ len(bnb-doc(bnb-today-lines())).str() ++ " near " ++ len(bnb-doc(bnb-near-lines())).str() ++ " cap " ++ fcac-observation-cap-bytes(session).str() ++ " | observation ids day " ++ bnb-ids(len(fcac-observation-budget(day, 24))).str() ++ " today " ++ bnb-ids(len(fcac-observation-budget(today, 24))).str() ++ " bounded " ++ bnb-ids(len(fcac-observation-budget(bounded, 24))).str() ++ " | prompt ids bare " ++ bnb-prompt-ids(bnb-open(bnb-doc(bnb-small-lines()))).str() ++ " near " ++ bnb-prompt-ids(fcap-begin-context(near)).str() ++ " near-bounded " ++ bnb-prompt-ids(fcap-begin-context(bounded)).str() ++ " huge-goal " ++ bnb-prompt-ids(huge).str() ++ " | win " ++ bnb-ids(len(fcac-observation-budget(bnb-step(session, bnb-open(bnb-doc(bnb-win-lines())), bnb-read()), 24))).str();
  }
  def bnb-goal() = "hw-conflict-named: make hw-conflicted? and hw-held-turns name the conflicting option.";
  def bnb-docs(doc) = [[bnb-path(), bnb-path(), doc]];
  def bnb-open-goal(goal, doc) = fcap-begin-context(fcap-with-document-context(fcap-open-direct-code(goal, bnb-docs(doc), [bnb-path()]), "catalog"));
  def bnb-open(doc) = bnb-open-goal(bnb-goal(), doc);
  def bnb-checker() = [(contract, docs) => [1, "stub caller check"], []];
  def bnb-session(pos, observed) = fcms-session("live", "band", "/scripted.gguf", "", [], [], 16384, pos, 7, 0, pos, 0, 0, observed);
  def bnb-read() = "{\"tool\":\"read\",\"arguments\":[\"" ++ bnb-path() ++ "\"],\"input\":\"\"}";
  def bnb-rows() = split-on(read_file(bnb-fixture()) ?? "", "\n") |> filter(l => len(l) > 0) |> map(l => parse-json("day-row", l));
  def bnb-kind(row) = node_value(json-object-get(row, "kind"));
  def bnb-replies() = bnb-rows() |> filter(r => bnb-kind(r) == "reply") |> map(r => node_value(json-object-get(r, "reply")));
  def bnb-reads() = bnb-replies() |> filter(raw => bnb-has?(raw, "\"tool\":\"read\""));
  def bnb-prompts() = bnb-rows() |> filter(r => bnb-kind(r) == "context") |> map(r => node_value(json-object-get(r, "context_prompt_ids")));
  // the decoder's port, scripted: a text that does not fit the room is refused as capacity before KV changes (fcms-observe-ids),
  // else it is taken at bnb-ids per byte
  def bnb-take() = (session, text, reasoning) => bnb-ids(len(text)) > (fcms-maxpos(session) - fcms-pos(session)) ? fcms-refuse(session, "coding-observation-context-capacity") : fcms-with-stream(session, fcms-pos(session) + bnb-ids(len(text)), 7, 0, fcms-generated-ids(session), fcms-injected-ids(session) + bnb-ids(len(text)), fcms-observations(session) + 1);
  // the decoder's port, scripted to read: it refuses with the digest of the text it was handed
  def bnb-seen() = (session, text, reasoning) => fcms-refuse(session, "seen:" ++ bnb-sha(text));
  def bnb-loop() = (session, state, checker, turns, started) => [session, state];
  def bnb-seams(observe) = [observe, bnb-loop()];
  // one turn as fcac-replied and fcac-advance take it: the context's sight, the reply's step, the observation
  def bnb-step(session, state, raw) = fcap-native-submission-admitted(fcsw-step(fcsw-in-context(session, state), raw, bnb-checker()), raw);
  def bnb-turn(session, state, raw, observe) {
   let next = bnb-step(session, state, raw);
   [next, fcap-done(next) ? [session, next] : fcac-advance-with(session, next, bnb-checker(), 24, now_unix_ms(), bnb-seams(observe))];
  }
  def bnb-detail(state) {
   let note = fcap-note(state);
   parse-json("bounded-note", substring(note, str_find(note, "{", 0), len(note)));
  }
  def bnb-field(node, key) = node_value(json-object-get(node, key));
  def bnb-gone(path) = ((String) path == "") ? 0 : fs_remove(path);

  // ── 1 ──
  def bnb-c-pass() {
   let state = bnb-open(bnb-doc(bnb-small-lines()));
   let session = bnb-session(2394, 0);
   let turn = bnb-turn(session, state, bnb-read(), bnb-seen());
   let next = turn[0]; let out = turn[1];
   bnb-bit(((String) fcms-reason(out[0]) == "seen:" ++ bnb-sha(fcac-observation-budget(next, 24))) && ((Value) out[1] == next) && (fcac-observation-over-cap?(session, next) == 0) && (!bnb-has?(fcap-note(out[1]), "observation_excerpt")), 1);
  }
  // ── 2, 4, 8 ──
  def bnb-c-bounded() {
   let doc = bnb-doc(bnb-day-lines());
   let session = bnb-session(2394, 0);
   let turn = bnb-turn(session, bnb-open(doc), bnb-read(), bnb-seen());
   let next = turn[0]; let st = turn[1][1];
   let shown = fcac-observation-budget(st, 24);
   let detail = bnb-detail(st);
   let ex = json-object-get(detail, "observation_excerpt");
   let head = node_children(json-object-get(ex, "head"));
   let tail = node_children(json-object-get(ex, "tail"));
   let lines = split-on(doc, "\n");
   let kept = bnb-field(detail, "private_observation_evidence");
   let c2 = (fcac-observation-over-cap?(session, next) == 1) && ((String) fcms-reason(turn[1][0]) == "seen:" ++ bnb-sha(shown)) && (len(shown) < fcac-observation-cap-bytes(session)) && (bnb-ids(len(shown)) < fcac-observation-cap-ids(session)) && ((String) bnb-field(detail, "cause") == "observation-exceeds-note-cap") && (bnb-field(ex, "stdout_bytes") == len(doc)) && (bnb-field(ex, "stdout_lines") == bnb-day-lines()) && ((String) bnb-field(ex, "stdout_sha256") == bnb-sha(doc)) && (len(head) == 12) && ((String) node_value(head[0]) == lines[0]) && (len(tail) == 6) && ((String) node_value(tail[5]) == lines[bnb-day-lines() - 1]) && (bnb-field(ex, "tail_from_line") == bnb-day-lines() - 5) && ((String) bnb-field(json-object-get(ex, "read_window"), "tool") == "sed") && (fcap-stage(st) == fcap-stage(next)) && (fcap-turns(st) == fcap-turns(next)) && (fcap-failures(st) == fcap-failures(next));
   let c4 = ((read_file(kept) ?? "") == fcac-observation-budget(next, 24)) && (len(kept) > 0);
   let whole = bnb-fits-whole();
   let c8 = json-object-has?(detail, "observation_excerpt") ? bnb-reach(ex, doc, session) : 0;
   let removed = bnb-gone(kept);
   let saved = bnb-checkpoint-bounded();
   bnb-bit(c2 && whole, 2) + bnb-bit(c4 && saved, 4) + bnb-bit(c8, 8);
  }
  // no checkpoint holds the whole read: a managed lane's checkpoint, read back after the capped turn, carries the bounded note
  def bnb-managed(state, root, doc) = fcam-with(state, [root, "bounded-note-band", fcam-scope(bnb-goal(), bnb-docs(doc), [bnb-path()], "[]"), 0]);
  def bnb-checkpoint-bounded() {
   let root = temp_dir() ++ "/form-cli-code-bounded-note-band-" ++ now_unix_ms().str();
   let made = host_dir_mkdir(root);
   let doc = bnb-doc(bnb-day-lines());
   let turn = bnb-turn(bnb-session(2394, 0), bnb-managed(bnb-open(doc), root, doc), bnb-read(), bnb-seen());
   let saved = fcam-read(fcam-path(root, "bounded-note-band", "checkpoint"));
   let held = nothing?(saved) ? nothing() : fcam-state-from(saved);
   let kept = nothing?(held) ? "" : bnb-field(bnb-detail(held), "private_observation_evidence");
   let sig = nothing?(held) ? [] : fcap-tool-history(held)[0];
   let digest = ((Comparable) len(sig) == 6) && (!((String) value_kind(sig[4]) == "string")) && ((Comparable) sig[4][1] == len(doc)) && ((String) sig[4][0] == bnb-sha(doc));
   let slots = (!nothing?(held)) && (!bnb-has?(fcap-evidence(held), bnb-marker())) && (!bnb-has?(str-join(fcsw-pending(held)), bnb-marker()));
   let ok = (!nothing?(held)) && fat-starts(fcap-note(held), fcap-observation-capacity-prefix()) && (len(fcap-note(held)) < fcac-observation-cap-bytes(bnb-session(2394, 0))) && (!bnb-has?(fcap-note(held), bnb-marker())) && digest && slots && ((Value) fcap-stage(held) == fcap-stage(turn[1][1]));
   let removed = bnb-gone(kept);
   let swept = host_dir_rmdir(root);
   ok;
  }
  // The read the unmodified path takes whole: 30 KB (the near read, about 10.6k scripted IDs) fits the 13990 positions free
  // at the first context, so the decoder's port admits it and spends every ID (the day's turn 1: 13411 IDs, 774 s); the
  // bounded note costs under 2000.
  def bnb-fits-whole() {
   let session = bnb-session(2394, 0);
   let near = bnb-step(session, bnb-open(bnb-doc(bnb-near-lines())), bnb-read());
   let take = bnb-take();
   let taken = take(session, fcac-observation-budget(near, 24), 0);
   let bounded = bnb-turn(session, bnb-open(bnb-doc(bnb-near-lines())), bnb-read(), bnb-take());
   let kept = bnb-field(bnb-detail(bounded[1][1]), "private_observation_evidence");
   let removed = bnb-gone(kept);
   fcms-live?(taken) && (fcms-injected-ids(taken) > 8000) && fcms-live?(bounded[1][0]) && (fcms-injected-ids(bounded[1][0]) < 2000) && (fcac-observation-over-cap?(session, near) == 1);
  }
  // every window the note names, run through the real sed tool, in order
  def bnb-windows(docs, path, from, count, w, acc) = from > count ? acc : bnb-windows(docs, path, from + w, count, w, append(acc, [fat-out(fat-call(docs, "sed", ["-n", from.str() ++ "," ++ fat-min(count, from + w - 1).str() ++ "p", path], ""))]));
  def bnb-reach(ex, doc, session) {
   let window = bnb-field(ex, "window_lines");
   let args = node_children(json-object-get(json-object-get(ex, "read_window"), "arguments"));
   let outs = bnb-windows(bnb-docs(doc), bnb-path(), 1, bnb-field(ex, "stdout_lines"), window, []);
   (window > 0) && ((String) node_value(args[0]) == "-n") && ((String) node_value(args[2]) == bnb-path()) && ((String) str-join(outs) == doc) && (len(filter(o => len(o) > fcac-observation-cap-bytes(session), outs)) == 0) && (len(outs) < 60);
  }
  // ── 16 ──
  // The cap does not meet this read (under it), the room does: a context with 3000 positions left is refused a read of about
  // 3800 IDs by the decoder's capacity check, as the day's contexts were (13411 IDs, 13181 free), and takes the focus note.
  def bnb-win-lines() = 170;
  def bnb-win-pos() = 13384;
  def bnb-c-window() {
   let doc = bnb-doc(bnb-win-lines());
   let session = bnb-session(bnb-win-pos(), 0);
   let first = bnb-turn(session, bnb-open(doc), bnb-read(), bnb-take());
   let second = bnb-turn(first[1][0], first[1][1], bnb-read(), bnb-take());
   let after = first[1][0]; let st = first[1][1];
   let detail = bnb-detail(st);
   let raw = fcac-observation-budget(first[0], 24);
   let kept = bnb-field(detail, "private_observation_evidence");
   let c = (fcac-observation-over-cap?(session, first[0]) == 0) && (bnb-ids(len(raw)) > (fcms-maxpos(session) - bnb-win-pos())) && fcms-live?(after) && (fcms-observations(after) == 1) && (fcms-injected-ids(after) < 2000) && ((String) bnb-field(detail, "cause") == "observation-exceeds-live-context") && (!nothing?(json-object-get(detail, "observation_excerpt"))) && ((String) fcap-stage(st) == "repair") && (fcap-failures(st) == 1) && (!fcap-repeat(st)) && (fcap-failures(second[1][1]) == 2) && fcap-repeat(second[1][1]) && fcms-live?(second[1][0]) && ((read_file(kept) ?? "") == raw);
   let removed = bnb-gone(kept);
   let removed2 = bnb-gone(bnb-field(bnb-detail(second[1][1]), "private_observation_evidence"));
   bnb-bit(c, 16);
  }
  // ── 32 ──
  def bnb-fits(ids, contract) = fcac-renewal-fits(bnb-session(ids, 0), ids, contract) ? 1 : 0;
  def bnb-fits-in(maxpos, ids, contract) = fcac-renewal-fits(fcms-session("live", "band", "/scripted.gguf", "", [], [], maxpos, ids, 7, 0, ids, 0, 0, 0), ids, contract) ? 1 : 0;
  def bnb-c-fits() {
   let contract = [bnb-open(bnb-doc(bnb-small-lines())), 24];
   let ceiling = [fcap-with-reply-token-limit(bnb-open(bnb-doc(bnb-small-lines())), 5000), 24];
   let big = [16376, 15981, 16187, 14336, 16383, 16384];
   let small = [14335, 3000, 3181, 2722, 2721, 2968, 2394];
   let prompts = bnb-prompts();
   let c = (len(filter(i => bnb-fits(i, contract) == 1, big)) == 0) && (len(filter(i => bnb-fits(i, contract) == 0, small)) == 0) && (len(filter(p => (bnb-fits(p, contract) == 0) != (p > 14335), prompts)) == 0) && (fcac-renewal-reserve(bnb-session(0, 0)) == 2048) && (fcac-renewal-reserve(fcms-session("live", "band", "", "", [], [], 4096, 0, 7, 0, 0, 0, 0, 0)) == 1024) && (fcac-renewal-reserve(fcms-session("live", "band", "", "", [], [], 65536, 0, 7, 0, 0, 0, 0, 0)) == 8192) && (bnb-fits(14335, ceiling) == 0) && (bnb-fits(11000, ceiling) == 1) && (bnb-fits-in(4096, 3000, contract) == 1) && (bnb-fits-in(4096, 3071, contract) == 1) && (bnb-fits-in(4096, 3072, contract) == 0);
   bnb-bit(c, 32);
  }
  // ── 64 ──
  def bnb-renew(session, prompt, profile, check, contract) = bnb-ids(len(prompt)) >= fcms-maxpos(session) ? fcmr-result(0, "prompt-context-window-refused", session) : check(session, bnb-ids(len(prompt)), contract) ? fcmr-result(1, "fresh-stream-same-weights", fcms-with-stream(session, bnb-ids(len(prompt)), 7, 0, 0, 0, 0)) : fcmr-result(0, "prompt-caller-capacity-refused", session);
  def bnb-prompt-ids(state) = bnb-ids(len(fcac-bootstrap-budget(state, 24)));
  def bnb-c-renew() {
   let session = bnb-session(15000, 1);
   let trigger = bnb-step(bnb-session(2394, 0), bnb-open(bnb-doc(bnb-near-lines())), bnb-read());
   let unbounded = fcap-begin-context(trigger);
   let first = bnb-prompt-ids(unbounded);
   let renewal = fcac-renew-with(session, trigger, 24, bnb-renew);
   let kept = bnb-field(bnb-detail(renewal[1]), "private_observation_evidence");
   let again = bnb-prompt-ids(renewal[1]);
   let a = (first < fcms-maxpos(session) - 1) && (bnb-fits(first, [unbounded, 24]) == 0) && (fcac-renewal-reserve(session) > 0) && fcac-room-refused?(bnb-renew(session, fcac-bootstrap-budget(unbounded, 24), "knowledge-query", fcac-renewal-fits, [unbounded, 24])) && (renewal[2] == 2) && fcmr-changed(renewal[0]) && ((String) fcmr-reason(renewal[0]) == "fresh-stream-same-weights") && (again < 6000) && bnb-has?(fcap-note(renewal[1]), "observation_excerpt") && (!bnb-has?(fcap-note(renewal[1]), "hw-fixture-line-300(")) && ((read_file(kept) ?? "") == fcap-note(trigger));
