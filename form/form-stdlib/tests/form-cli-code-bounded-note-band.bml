// Current observation, source continuity, growth and renewal contracts. No model
// or device is admitted. Scripted ports isolate KV ownership and fit decisions;
// the production sealed cursor supplies the actual token count in live runs.
// preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-code-live.bml
section [form.bml] {
 class FormCliCodeBoundedNoteBand {
  def bnb-path() = "source.bml";
  def bnb-doc() = str-join(range(0,1200) |> map(i=>"def source" + i.str() + "() = " + i.str() + ";\n"));
  def bnb-docs() = [[bnb-path(),bnb-path(),bnb-doc()]];
  def bnb-open() = fcap-begin-context(fcap-with-document-context(fcap-open-direct-code("Edit the named source",bnb-docs(),[bnb-path()]),"catalog"));
  def bnb-session(maxpos,pos,injected,observations) = fcms-session("live","band","/scripted.gguf","",[],[],maxpos,pos,7,0,pos - injected,0,injected,observations);
  def bnb-room(pos) = bnb-session(16384,pos,0,0);
  def bnb-checker() = [(contract,docs)=>[1,"native caller check"],[]];
  def bnb-read() = "{\"tool\":\"read\",\"arguments\":[\"source.bml\"],\"input\":\"\"}";
  def bnb-step(session,state) = fcap-native-submission-admitted(fcsw-step(fcsw-in-context(session,state),bnb-read(),bnb-checker()),bnb-read());
  def bnb-loop() = (session,state,checker,turns,started)=>[session,state];
  def bnb-ids(text) = len(text) / 4;
  def bnb-take() = (session,text,reasoning)=>bnb-ids(text)>fcac-reply-room(session) ? fcms-refuse(session,"coding-observation-context-capacity") : fcms-with-stream(session,fcms-pos(session)+bnb-ids(text),7,0,fcms-generated-ids(session),fcms-injected-ids(session)+bnb-ids(text),fcms-observations(session)+1);
  def bnb-turn(session,state,observe) = fcac-advance-with(session,state,bnb-checker(),64,now_unix_ms(),[observe,bnb-loop()]);
  def bnb-value(node,key) = node_value(json-object-get(node,key));
  def bnb-pages(ex,held) {
   let joined=held + bnb-value(ex,"stdout"); let next=json-object-get(ex,"next");
   if faj-type(next)=="null" then joined else {
    let result=fat-call(bnb-docs(),bnb-value(next,"tool"),node_children(json-object-get(next,"arguments")) |> map(arg=>node_value(arg)),"");
    let span=[bnb-docs()[0],bnb-value(ex,"end_byte"),bnb-value(ex,"requested_end_byte")];
    fat-exit(result)!=0 || span[1]<=bnb-value(ex,"start_byte") ? "invalid continuation" : bnb-pages(fcap-source-page(span,json-node-object([oh-n("exit",0),oh-s("stdout",fat-out(result))]),6000),joined);
   };
  }
  def bnb-renew(session,prompt,profile,check,contract) = bnb-ids(prompt)>=fcms-maxpos(session) ? fcmr-result(0,"prompt-context-window-refused",session) : check(session,bnb-ids(prompt),contract) ? fcmr-result(1,"fresh-stream-same-weights",fcms-with-stream(session,bnb-ids(prompt),7,0,0,0,0)) : fcmr-result(0,"prompt-caller-capacity-refused",session);
  def bnb-readonly() {
   let review=fcap-open-direct-review("Read source",bnb-docs());
   let helped=fcsw-step(review,"{\"tool\":\"functions.help\",\"arguments\":[\"repair-bml\"],\"input\":\"\"}",bnb-checker());
   fcap-calls(helped)==1 && fcap-failures(helped)==0 && fcap-reviewing(helped) && fcap-docs(helped)==bnb-docs() && !fcap-tool-allowed(helped,"repair-bml",[bnb-path()]);
  }
  def bnb-has(text,part) = str_find(text,part,0)>=0;
  def bnb-observation-admission() {
   let lane=ftv-session(); let text=bnb-doc();
   record_set(lane,"render-room",16384);
   let rendered=ftv-render(lane,text);
   let calls=record_get(lane,"calls");
   let answered=[[rendered,"",text]];
   let encode=body=>range(0,len(body));
   let whole=ftg-admit-observations(bnb-session(100000,1000,0,0),lane,answered,encode);
   let focused=ftg-admit-observations(bnb-room(1000),lane,answered,encode);
   let full=bnb-session(80,79,0,0);
   let exhausted=ftg-admit-observations(full,lane,answered,encode);
   record_set(lane,"render-room",nothing());
   let page=fcsw-node-step(bnb-open(),fcap-native-tool("read",[bnb-path(),"1","100"],""),bnb-checker());
   let selected=node_value(json-object-get(page[8],"stdout"));
   let query=json-node-object([oh-n("exit",0),oh-s("stdout",selected),oh-s("stderr","")]);
   let guidance=json-node-object([oh-s("message",selected)]);
   let structured=json-node-object([oh-s("stdout",text),json-node-pair("value",json-node-array([json-node-int(7)]))]);
    rendered=="value="+text+";" && whole[0]==[rendered] && ftg-observation-fits(bnb-session(100000,1000,0,0),whole[1]) && focused[0]==[ftv-large(lane,text)] && ftg-observation-fits(bnb-room(1000),focused[1]) && !ftg-observation-fits(full,exhausted[1]) && ftv-render(lane,42)=="value=42;" && ftg-result-kind(ftv-render(lane,text))=="node" && record_get(lane,"calls")==calls && answered[0][2]==text && len(selected)>ftv-max-render() && bnb-has(fcap-model-visible(page[8]),selected) && bnb-has(fcap-model-visible(page[8]),"path: "+bnb-path()) && bnb-has(fcap-model-visible(page[8]),"resident_sha256: "+hex-encode(sha256-stream-string(bnb-doc()))) && bnb-has(fcap-model-visible(query),selected) && bnb-has(fcap-model-visible(guidance),selected) && !bnb-has(fcap-model-visible(structured),text);
  }
  def bnb-control-care() {
   let lane=ftg-lane-session("code");
   let root=json-node-object([oh-s("source",bnb-doc()),oh-s("scalar","actual")]);
   let failed=fcap-context-field(root,["scalar","missing","needed"]);
   let large=fcap-context-field(root,"source");
   ftv-hold(lane,large);
   let focused=ftg-observe-with(lane,"eval","substring("+ftv-coord(large)+",0,20)");
   let signal=ftw-decode(failed);
   let reads=[["eval","fcap-context-field(code_context,\"role\")","value=implement;","",nothing()],["eval","fcap-context-field(code_context,\"pending\")","node=data;","",root],["eval","fcap-context-field(code_context,[\"scalar\",\"missing\"])",ftv-node-result(failed),"",failed]];
   fcac-control-begin();
   fcac-control-returned(lane,reads);
   let first=nothing?(fcac-control-care());
   fcac-control-returned(lane,[reads[-1]]);
   let state=bnb-open(); let cared=fcac-control-cared(state,"");
   let missing=fcsw-node-step(state,fcap-native-tool("read",["/tmp/fcap/source.bml"],""),bnb-checker());
   let offer=json-object-get(json-object-get(missing[8],"guard_evidence"),"offers");
   let same=fcam-cell-shape(cared[8]) && fcap-docs(cared)==fcap-docs(state) && fcap-stage(cared)==fcap-stage(state) && fcap-calls(cared)==0 && fcap-turns(cared)==1 && bnb-has(fcap-model-packet(fcap-observation-node(cared)),"Attention: The repeated control");
   fcac-control-begin();
   let action=fcap-native-tool("read",[bnb-path()],"");
   fcac-control-returned(lane,[["eval","changed choice",ftv-node-result(action),"",action]]);
   first && same && fcap-context-field(offer,[0,"path"])==bnb-path() && fcap-docs(missing)==fcap-docs(state) && nothing?(fcac-control-care()) && fcac-control-submissions()==[action] && fcap-context-unease?(failed) && record_get(signal,"needed")=="record or list" && record_get(signal,"path")==["scalar","missing","needed"] && bnb-has(ftv-node-result(failed),"Do not traverse this diagnostic") && value_kind(large)=="node_id" && node_value(large)==bnb-doc() && focused=="value="+substring(bnb-doc(),0,20)+";" && bnb-has(ftv-node-result(large),"text of") && !bnb-has(ftv-node-result(large),"value-exceeds-observation");
  }
  def bnb-cells(state) {
   let note=state[8]; let body=fcap-observation-node(state);
   let packet=fcap-model-packet(body);
   let lane=ftg-lane-session("code");
   let observed=ftg-observe-with(lane,"eval","fcap-context-field(code_context,\"observation\")");
   let returned=record_get(lane,"returned");
   fcac-control-begin();
   let items=json-node-array([json-node-string("first"),json-node-string("last")]);
   let fields=json-node-object([json-node-pair("items",items),json-node-pair("items.0",json-node-string("literal")),json-node-pair("absent",json-node-null())]);
   let paths=fcap-context-field(fields,"items")==items && fcap-context-field(fields,["items",-1])=="last" && fcap-context-field(fields,"items.0")=="literal" && nothing?(fcap-context-field(fields,"absent"));
   let queried=fcsw-node-step(fcap-open-direct-review("Inspect resident data",[["facts","facts.json","{\"depth\":{\"value\":7,\"evidence\":\"[1,2]\"}}"]]),fcap-native-tool("jq",[".depth","facts.json"],""),bnb-checker());
   let value=json-object-get(queried[8],"value");
   let structured=fcap-calls(queried)==1 && fcap-context-field(value,[0,"value"])==7 && fcap-context-field(value,[0,"evidence"])=="[1,2]" && json-object-get(fcap-model-cell(fcap-observation-node(queried)),"observation")==queried[8];
   let owned=fcam-with(queried,[host_temp_dir(),host_pid().str(),"typed-cell-contract",0]);
   let unsupported=fcsw-with-note(owned,intern_node(intern_trivial_string("unsupported-checkpoint-cell"),[]));
   let refused=!fcam-cell-shape(unsupported[8]) && !fcam-save(unsupported) && fcam-retain(unsupported)==[0,0];
   let path=host_temp_dir()+"/code-cell-band-"+host_pid().str()+".fkb";
   let saved=fcam-write(path,fcam-packet(owned,"checkpoint"));
   let retained=fcam-read(path); let restored=fcam-state-from(retained);
   let removed=fs-remove-file(path);
   let changed=oh-set(retained,"payload",fcam-pack(["typed-cell-contract",fcsw-with-note(owned,json-node-object([oh-n("exit",9),oh-s("stdout","changed")]))]));
   saved && paths && structured && refused && !fs-exists?(path) && fcam-packet-valid(retained,"checkpoint","typed-cell-contract") && !fcam-packet-valid(changed,"checkpoint","typed-cell-contract") && node_eq(restored[8],queried[8]) && fcap-note-cell(state)==note && json-object-get(body,"observation")==note && returned==note && fcap-context-field(returned,"exit")==0 && bnb-has(observed,"keys: exit, stdout, stderr") && !bnb-has(packet,"resident_sha256\":");
  }
  def bnb-native() {
   let docs=[["unit","unit.bml","def value() = 1;"]];
   let checker=[(contract,candidate)=>[candidate[0][2]=="def value() = 2;","exact caller source"],[]];
   let state=fcap-open-direct-code("Change the value to two",docs,["unit.bml"]);
   let lane=fcap-model-organs(ftg-lane-session("code"));
   let child=ftw-last-child();
    fcac-control-begin();
    let result=ftg-observe-with(lane,"eval","let change = fcap-native-tool; change(\"edit\",[\"unit.bml\",\"= 1;\",\"= 2;\"],\"\")");
    let returned=record_get(lane,"events")[0];
    fcac-control-returned(lane,[[returned[0],returned[1],"value=display-only;",returned[3],returned[4]]]);
    let action=fcac-control-submissions()[0];
   let edited=fcsw-node-step(state,action,checker);
   let done=fcsw-node-step(edited,fcap-native-reply([["task","done"]]),checker);
   let reviewed=fcsw-node-step(done,fcap-native-reply([["verdict","accept"],["reason","The actual complete source returns two and its caller check passed."]]),checker);
    let readonly=fcsw-node-step(fcap-open-direct-review("Inspect",docs),action,checker);
    let unrelated=fcsw-node-step(state,intern_trivial_int(7),checker);
    fcac-control-begin();
    let unused=ftg-observe-with(lane,"eval","let unused = fcap-native-tool(\"read\",[\"unit.bml\"],\"\"); 7");
    fcac-control-returned(lane,take(1,record_get(lane,"events")));
    let dataOnly=nil?(fcac-control-submissions());
    let refused=ftg-observe-with(lane,"eval","unknown_native_action");
    fcac-control-returned(lane,take(1,record_get(lane,"events")));
    let spoof=["eval","","node="+ftv-coord(action)+";","",nothing()];
    fcac-control-returned(lane,[spoof]);
    let summary=ftv-node-result(ftw-encode(record_new(0,"goal","Edit the named source","documents",docs)));
    let nested=ftw-encode(record_new(0,"current",record_new(0,"pending",["first","last"],"observation","actual"),"current.observation","literal"));
    let subtree=fcap-context-field(nested,"current");
    let paths=fcap-context-field(nested,"current.observation")=="literal" && fcap-context-field(subtree,"pending.0")=="first" && fcap-context-field(nested,["current","pending",-1])=="last" && fcap-context-field(subtree,"pending")==node_children(subtree)[1] && record_get(ftw-decode(fcap-context-field(nested,"current.missing")),"needed")=="existing field or index";
    let admitted=ftg-observe-with(lane,"eval","let unadmitted_native_effect = 99; fcap-context-field(task_context,\"current\",0)");
    let untouched=ftg-observe-with(lane,"eval","unadmitted_native_effect");
    let separate=fcap-model-organs(ftv-session());
    let lexical=ftv-eval(separate,"def fcap-context-field(a,b,c) = a + b + c; fcap-context-field(1,2,3)");
    let compiler=admitted=="nothing=compile-arity:fcap-context-field expected=2 received=3;" && untouched=="nothing=unknown-name:unadmitted_native_effect;" && lexical=="value=6;";
    ftw-last-child()==child && compiler && paths && action==returned[4] && ftg-result-kind(result)=="node" && bnb-has(summary,"keys: goal, documents") && dataOnly && nil?(fcac-control-submissions()) && nothing?(record_get(lane,"returned")) && ftg-result-kind(refused)=="nothing" && fcap-stage(reviewed)=="complete" && fcap-checks(reviewed)>=2 && fcap-docs(reviewed)[0][2]=="def value() = 2;" && nil?(fcap-json-repairs(edited)) && fcap-docs(readonly)==docs && fcap-calls(unrelated)==0 && fcap-docs(unrelated)==docs && bnb-cells(edited);
  }
 }
 let session=bnb-room(1000); let original=bnb-step(session,bnb-open());
 let roomy=bnb-turn(session,original,bnb-take());
 let tight=bnb-room(14500); let refused=bnb-step(tight,bnb-open());
 let focused=bnb-turn(tight,refused,bnb-take()); let state=focused[1];
  let excerpt=fcap-observation-excerpt(refused,6000);
  let context=fcap-observation-node(refused);
  let observation=fcap-context-field(context,"observation");
  let result=observation;
 let ceiling=fcap-with-reply-token-limit(bnb-open(),4000);
 let trigger=fcap-with-reply-token-limit(original,12000);
 let renewal=fcac-renew-with(session,trigger,64,bnb-renew);
 let blocked=fcap-with-reasoning(bnb-open(),[8192,8192]);
 let irreducible=fcac-renew-with(session,blocked,64,bnb-renew);
 let distinct=fcac-renew-with(session,original,64,(s,p,profile,check,c)=>fcmr-result(0,"candidate-stream-release-incomplete",s));
 let partial=bnb-turn(tight,refused,(s,text,reasoning)=>fcms-refuse(s,"native-prefill-failed"));
 let fresh=fcacs-observation-reading(session,["done",nothing(),[1,2,3]]);
 let history=bnb-session(16384,2000,100,2);
 let growth=fcacs-observation-reading(history,["done",nothing(),range(0,80)]);
 let capacity=fcacs-observation-reading(history,["capacity",nothing(),range(0,14384)]);
 let admit=fcacs-observed-by(history,["done",nothing(),range(0,80)],(s,ids,reason)=>fcms-with-stream(s,fcms-pos(s)+len(ids),7,0,0,fcms-injected-ids(s)+len(ids),fcms-observations(s)+1));
 let bml=fcap-open-direct-code("Edit BML",[["unit","unit.bml","section [form.bml] { def value() = 1; }"]],["unit.bml"]);
  let prompt=fcap-bootstrap(bml);
  let admitted=fcap-model-lane(bml);
  let bound=ftg-observe("eval","fcap-context-field(task_context,\"goal\")");
  let index=nothing?(result) ? nothing() : fcap-context-field(fcap-context-field(context,"pending"),"0");
  let prior=fcap-model-cell(json-node-object([json-node-pair("evidence",json-node-string("[2,\"\",\"caller refused\"]"))]));
 let query=fcap-source-observations(bnb-docs(),[["help",["edit"]]])[0];
  let verify=fcsw-with-note(bnb-open(),fcap-verification-node(bnb-open(),fat-result(2,bnb-doc(),"caller refused",bnb-docs())));
 let utf=byte_to_str(195)+byte_to_str(169); let clipped=fcap-clip(str-join(range(0,200) |> map(i=>utf)),201);
 let checks=[
  ["large fitting observation remains whole",fcms-live?(roomy[0]) && roomy[1]==original && fcms-injected-ids(roomy[0])==bnb-ids(fcac-observation-budget(original,64))],
   ["native source context fits without copying or repair",fcms-live?(focused[0]) && fcms-observations(focused[0])==1 && state==refused && fcms-injected-ids(focused[0])==bnb-ids(fcac-observation-budget(refused,64))],
  ["exact result and typed context remain native",node_value(fcap-context-field(ftw-coord(result),"stdout"))==bnb-doc() && !bnb-has(fcac-observation-budget(refused,64),bnb-doc()) && bound=="value=Edit BML;" && record_get(ftw-decode(index),"needed")=="integer list index" && node_eq(json-object-get(prior,"evidence"),json-node-array([json-node-int(2),json-node-string(""),json-node-string("caller refused")]))],
  ["native continuations reassemble source",bnb-pages(excerpt,"")==bnb-doc() && bnb-value(excerpt,"resident_sha256")==hex-encode(sha256-stream-string(bnb-doc()))],
  ["partial prefill retains refused owner",!fcms-live?(partial[0]) && fcms-reason(partial[0])=="native-prefill-failed" && partial[1]==refused],
  ["reply ceiling preserves available context; reasoning reserves its stages",fcac-renewal-fits(session,16382,[bnb-open(),64]) && !fcac-renewal-fits(session,16383,[bnb-open(),64]) && fcac-renewal-fits(session,13000,[ceiling,64]) && fcac-token-allowance(ceiling,5000)==4000 && !fcac-renewal-fits(session,1000,[blocked,64])],
   ["renewal references whole native context without copying it",fcmr-changed(renewal[0]) && renewal[2]==1 && fcap-note(renewal[1])==fcap-note(original) && fcap-docs(renewal[1])==fcap-docs(original)],
  ["irreducible caller contract retains its owner",!fcmr-changed(irreducible[0]) && irreducible[2]==1 && fcmr-session(irreducible[0])==session && fcac-room-refused?(irreducible[0])],
  ["noncapacity refusal is not retried",distinct[2]==1 && fcmr-reason(distinct[0])=="candidate-stream-release-incomplete" && fcmr-session(distinct[0])==session],
    ["native actions and wire help preserve ownership",bnb-readonly() && bnb-native() && bnb-control-care() && bnb-observation-admission()],
  ["source query uses the guide carrier",fcap-string(query,"stdout")==fat-edit-guidance() && bnb-value(query,"exit")==0],
  ["bootstrap defers full guide bodies",all?(row=>!bnb-has(prompt,(row[1])()),fcap-guides()) && all?(row=>fat-exit(fcap-help(bnb-docs(),[row[0]]))==0,fcap-guides())],
  ["first observation has no invented baseline",faj-type(oh-get(fresh,"expected"))=="null" && nil?(node_children(oh-get(fresh,"needs")))],
  ["growth uses observed average",node_value(oh-get(growth,"expected"))==50 && node_value(oh-get(growth,"observed"))==80 && len(node_children(oh-get(growth,"needs")))==1 && node_value(oh-get(growth,"health"))==1],
  ["overflow count is a lower bound",bnb-value(oh-get(capacity,"evidence"),"count_is_lower_bound")==1 && len(node_children(oh-get(capacity,"needs")))==1],
  ["growth admits every fitting ID",fcms-live?(admit) && fcms-injected-ids(admit)==180 && fcms-pos(admit)==2080 && fcms-observations(admit)==3],
  ["restoring context retains its observation",fcap-note(fcac-held-state(original,8192))==fcap-note(original) && fcap-docs(fcac-held-state(original,8192))==bnb-docs()],
  ["UTF8 focus and guide validation",len(clipped)==200 && substring(clipped,0,2)==utf && fat-exit(fcap-help(bnb-docs(),[]))==2],
   ["verification evidence has no tool projection",nothing?(fcap-observation-result(verify)) && bnb-value(parse-json("verification",fcap-note(verify)),"stdout")==bnb-doc() && fcsw-unsighted(state)==0]
 ];
 let weights=[1,2,4,8,16,32,64,128,256,512,1024,2048,4096,8192,16384,32768,65536,131072,262144];
 let bits=range(0,len(checks)) |> map(i=>{
  print_str(checks[i][0]+"="+checks[i][1].str()+"\n");
  checks[i][1] ? weights[i] : 0;
 });
 sum(bits);
}
