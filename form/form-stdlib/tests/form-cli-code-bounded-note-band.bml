  def bnb-hand-off(session, state, firstTurn) = fcac-finish-contexts-with([session, fcap-terminal(state, "context-capacity"), state], bnb-checker(), 24, now_unix_ms(), firstTurn, [0, 0, 0], 1, bnb-loop(), bnb-renewer());
  def bnb-c-handoff() {
