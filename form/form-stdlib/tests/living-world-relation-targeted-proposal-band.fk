; living-world-relation-targeted-proposal-band.fk -- isolate two indexed offers.
; Verdict 32767 proves fifteen targeted proposal identity and non-promotion claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-active-index.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/living-world-multilens-plan.fk form-stdlib/living-world-composition-outcome.fk form-stdlib/living-world-composition-voice.fk form-stdlib/living-world-relation-hypothesis.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk form-stdlib/tests/living-world-relational-voice-witness.fk form-stdlib/tests/living-world-multilens-witness.fk form-stdlib/tests/living-world-composition-outcome-witness.fk form-stdlib/tests/living-world-relation-hypothesis-witness.fk form-stdlib/tests/living-world-relation-attestation-witness.fk

(do
    (let world LWRHA-WORLD)
    (let index (lwai-index world))
    (let first
        (lwai-relation-proposal-for
            world index LWRHA-OBSERVATION-FIRST 2))
    (let second
        (lwai-relation-proposal-for
            world index LWRHA-OBSERVATION-SECOND 2))
    (let first-candidate (lwt-proposal-candidate first))
    (let second-candidate (lwt-proposal-candidate second))
    (let first-edge (lwo-emergent-shape first-candidate))
    (let second-edge (lwo-emergent-shape second-candidate))
    (let first-participants (lwt-proposal-participants first))

    (let c1 (if (not (node_eq first (lwo-none))) 1 0))
    (let c2 (if (not (node_eq second (lwo-none))) 2 0))
    (let c3 (if (and (eq (lwrl-candidate? first-candidate) 1)
                         (eq (lwrl-candidate? second-candidate) 1)) 4 0))
    (let c4 (if (and (node_eq (lwrl-edge-relation first-edge)
                              (lwrhw-relation-zeta))
                         (node_eq (lwrl-edge-relation second-edge)
                              (lwrhw-relation-zeta))) 8 0))
    (let c5 (if (and (node_eq (lwrl-edge-left first-edge) (lwrvw-left))
                         (node_eq (lwrl-edge-right first-edge)
                              (lwmpw-third))) 16 0))
    (let c6 (if (and (node_eq (lwrl-edge-left second-edge) (lwmpw-third))
                         (node_eq (lwrl-edge-right second-edge)
                              (lwrvw-right))) 32 0))
    (let c7 (if (and (eq (lwrl-support-count
                              (lwrl-edge-evidence first-edge)) 2)
                         (eq (lwrl-support-count
                              (lwrl-edge-evidence second-edge)) 2)) 64 0))
    (let c8 (if (eq (lwo-field-size first-participants) 2) 128 0))
    (let c9 (if (and (eq (lwo-field-has? first-participants
                              (lwrhw-source-h)) 1)
                         (eq (lwo-field-has? first-participants
                              (lwrhw-source-i)) 1)) 256 0))
    (let c10 (if (eq (lwo-field-has? first-participants
                          (lwcow-source-g)) 0) 512 0))
    (let c11 (if (and (eq (lwo-emergent-threshold first-candidate) 2)
                          (eq (lwo-emergent-threshold second-candidate) 2))
                       1024 0))
    (let c12 (if (and (eq (lwo-emergent-coherence first-candidate) 2)
                          (eq (lwo-emergent-resonance first-candidate) 2))
                       2048 0))
    (let c13 (if (and (eq (lwo-active? world first-candidate) 0)
                          (eq (lwo-active? world second-candidate) 0)) 4096 0))
    (let c14 (if (node_eq (lwrl-observation-evidence
                               LWRHA-OBSERVATION-FIRST)
                              LWRHA-ATTESTATION-FIRST) 8192 0))
    (let c15 (if (eq (lwrh-integrated-current?
                          world (lwrhw-candidate)) 1) 16384 0))
    (lwrhw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
