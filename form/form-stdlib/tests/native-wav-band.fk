; RIFF chunk traversal, exact PCM, extensible float, and 48-kHz stereo resampling.
; Temporary test audio only; no microphone or living training state is touched.
; preludes: form-stdlib/native-wav.bml form-stdlib/native-adapter-generation.bml
(do
 (defn nwb-u16 (n) (enw-bytes-str (list (mod n 256) (mod (div n 256) 256))))
 (defn nwb-u32 (n) (enw-bytes-str (ln-u32-bytes n)))
 (defn nwb-chunk (name bytes) (str_concat name (str_concat (nwb-u32 (str_len bytes)) (str_concat bytes (if (eq (mod (str_len bytes) 2) 0) "" (byte_to_str 0))))))
 (defn nwb-fmt (tag rate channels bits) (enw-cat (list (nwb-u16 tag) (nwb-u16 channels) (nwb-u32 rate) (nwb-u32 (mul rate (mul channels (div bits 8)))) (nwb-u16 (mul channels (div bits 8))) (nwb-u16 bits))))
 (defn nwb-wav (path fmt pcm) (do (let body (enw-cat (list "WAVE" (nwb-chunk "JUNK" "odd") (nwb-chunk "fmt " fmt) (nwb-chunk "data" pcm)))) (nag-write path (str_concat "RIFF" (str_concat (nwb-u32 (str_len body)) body)))))
 (defn nwb-pcm (xs) (if (nil? xs) "" (str_concat (nwb-u16 (mod (add (head xs) 65536) 65536)) (nwb-pcm (tail xs)))))
 (defn nwb-ramp (i end acc) (if (ge i end) acc (nwb-ramp (add i 1) end (str_concat acc (nwb-pcm (list i (div i 2)))))))
 (defn nwb-sample (b i) (do (let v (en-u16 b (mul 2 i))) (if (ge v 32768) (sub v 65536) v)))
 (defn nwb-error (b i end worst) (if (ge i end) worst (do (let e (abs (sub (nwb-sample b i) (mul i 2.25)))) (nwb-error b (add i 1) end (if (gt e worst) e worst)))))
 (defn nwb-read (path n) (do (let wav (nwa-open path)) (let dst (nam-held (metal_buf_alloc (mul 2 n)))) (nwa-window wav dst 0 n) (let b (metal_buf_read dst 0 (mul 2 n))) (nwa-close wav) (nam-free (list dst)) b))
 (defn nwb-refused (dir path mode message) (do
  (let request (str_concat dir "/request")) (nag-write request (str_concat path (str_concat "\n" mode)))
  (let out (str_concat dir "/out")) (let err (str_concat dir "/err"))
  (let pid (host_spawn_at (list "./fkwu" "form/form-stdlib/tests/native-wav-refusal.fk") (list request out err)))
  (let rc (host_wait pid)) (let okay (and (eq rc 1) (ge (str_find (read_file err) message 0) 0)))
  (if okay 1 (do (print (list "refusal" mode rc (read_file err))) 0))))
 (let dir (str_concat "/tmp/native-wav-band-" (int_to_str (host_pid)))) (fs-mkdir dir)
 (let path (str_concat dir "/audio.wav"))
 (let pcm (nwb-pcm (list -32768 -12345 -1 0 1 12345 32767)))
 (nwb-wav path (nwb-fmt 1 16000 1 16) pcm)
 (let exact (str_eq (nwb-read path 9) (str_concat pcm (nwb-pcm (list 0 0)))))
 (nwb-wav path (nwb-fmt 1 16000 1 24) (enw-bytes-str (list 0 0 128 0 0 192 0 0 0 0 0 64 255 255 127)))
 (let pcm24 (str_eq (nwb-read path 5) (nwb-pcm (list -32768 -16384 0 16384 32767))))
 (let extension (enw-cat (list (nwb-fmt 65534 16000 1 32) (nwb-u16 22) (nwb-u16 32) (nwb-u32 4) (nwb-u32 3) (enw-bytes-str (list 0 0 16 0 128 0 0 170 0 56 155 113)))))
 (nwb-wav path extension (enw-cat (list (nwb-u32 3204448256) (nwb-u32 0) (nwb-u32 1056964608))))
 (let extensible (str_eq (nwb-read path 3) (nwb-pcm (list -16384 0 16384))))
 (nwb-wav path (nwb-fmt 1 48000 2 16) (nwb-ramp 0 4800 ""))
 (let ramp (nwb-read path 1600)) (let error (nwb-error ramp 32 1568 0.0))
 (let resample (le error 2.0))
 (nwb-wav path (nwb-fmt 3 16000 1 32) (nwb-u32 2143289344))
 (let nan (nwb-refused dir path "level" "non-finite audio"))
 (nag-write path "RIFF")
 (let cut (nwb-refused dir path "open" "header absent"))
 (fs-remove-tree dir)
 (let released (eq (nth (metal_live) 2) 0))
 (print (list "pcm16-exact-and-pad" exact "pcm24" pcm24 "extensible-float" extensible "48k-stereo-max-LSB-error" error "NaN-refused" nan "truncated-refused" cut "released" released))
 (if (and exact (and pcm24 (and extensible (and resample (and nan (and cut released)))))) 127 (form_error "native WAV witness failed")))
