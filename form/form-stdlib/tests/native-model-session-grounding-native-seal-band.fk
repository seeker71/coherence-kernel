; native-model-session-grounding-native-seal-band.fk -- changing private-tail
; identities abstain before payload traversal while unchanged tails remain
; eligible.  The public fixture proves the decision without raw target text.
; preludes: form-stdlib/native-model-session-grounding-native-reverse.fk

(do
    (defn nmsgsb-score (condition bit) (if condition bit 0))
    (defn nmsgsb-field (frame index)
        (node_value (nth (node_children frame) index)))
    (defn nmsgsb-has (events phase modifier)
        (if (eq (len events) 0) 0
            (if (and (str_eq (nmsgsb-field (head events) 3) phase)
                     (str_eq (nmsgsb-field (head events) 5) modifier)) 1
                (nmsgsb-has (tail events) phase modifier))))
    (defn nmsgsb-safe-targets (events)
        (if (eq (len events) 0) 1
            (if (ge (str_find (nmsgsb-field (head events) 6)
                        "public seal inquiry" 0) 0) 0
                (nmsgsb-safe-targets (tail events)))))
    (defn native-model-session-grounding-native-seal-band ()
        (do
            (let root
                (fs-path-join (fs-temp-dir)
                    (str_concat "native-session-seal-band-"
                        (int_to_str (now_unix_ms)))))
            (let made (fs-mkdir root))
            (let path (fs-path-join root "session.jsonl"))
            (let text
                (str_concat
                    "{\"timestamp\":\"2026-08-09T00:00:01Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"public seal inquiry\"}}\n"
                    "{\"timestamp\":\"2026-08-09T00:00:02Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"task_complete\",\"last_agent_message\":\"public seal completion\"}}\n"))
            (let wrote (fs-write-text path text))
            (let mtime (fs-stat-mtime path))
            (let changed (nmsgn-session path "2026-08-09T00:00:00Z"
                (sub mtime 1)))
            (let unchanged (nmsgn-session path "2026-08-09T00:00:00Z" mtime))
            (let sessions (list changed unchanged))
            (let started
                (lcfb-open-stream "native-session-seal-band" "form-native"
                    "mtime-identity-admission" "public-fixture"
                    "form/form-stdlib/tests/native-model-session-grounding-native-seal-band.fk"
                    39 17))
            (let observed (nmsgn-scan-sessions-reverse sessions started))
            (let events (framebuffer-events))
            (let unchanged-count (nmsgn-count-unchanged-sessions sessions))
            (let changed-count (nmsgn-count-changed-sessions sessions))
            (let cleaned (fs-remove-tree root))
            (sum (list
                (nmsgsb-score (eq (nmsgn-pairs-completed observed) 1) 1)
                (nmsgsb-score (eq unchanged-count 1) 2)
                (nmsgsb-score (eq changed-count 1) 4)
                (nmsgsb-score
                    (eq (nmsgsb-has events "abstain"
                        "tail-identity-changed-before-scan") 1) 8)
                (nmsgsb-score
                    (eq (nmsgsb-has events "enter"
                        "latest-pair-from-unchanged-tail") 1) 16)
                (nmsgsb-score
                    (eq (nmsgsb-has events "leave"
                        "latest-pair-from-unchanged-tail") 1) 32)
                (nmsgsb-score (eq (nmsgsb-safe-targets events) 1) 64)
                (nmsgsb-score (gt wrote 0) 128)
                (nmsgsb-score (eq cleaned 0) 256)
                (nmsgsb-score (ge (len events) 9) 512)
                (nmsgsb-score
                    (str_eq (nmsgn-pairs-latest-query observed)
                        "public seal inquiry") 1024)
                (nmsgsb-score
                    (str_eq (nmsgn-pairs-latest-completion observed)
                        "public seal completion") 2048)
                (nmsgsb-score
                    (and (eq (nmsgsb-has events "modify" "line-read") 1)
                         (eq (nmsgsb-has events "modify" "event-decode") 1))
                    4096)))))
    (native-model-session-grounding-native-seal-band))
