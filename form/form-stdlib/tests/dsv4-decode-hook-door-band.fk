; dsv4-decode-hook-door-band.fk — the decode-hook door's decisions, fixture-free.
;
; Verdict 4095:
;   1     keyed request parsing: step, default, deadline cross by name
;   2     context and a free-text situation cross; situation takes the rest of the line
;   4     an empty situation parses empty, and a missing key answers empty/-1
;   8     a line without the offer verb, or without a default, is refused
;   16    the door's window is valid and carries the default's bytes
;   32    the default candidate's vitality is 0 with its witness named
;   64    the quiet recipe acknowledges nothing and the default stands by law
;   128   the control fit is leakage-free at prepare (the adapter's own instrument)
;   256   the TIMEOUT class's held-out-fresh vitality is its own diagonal, 26/30 -> 86
;   512   the control recipe offers 128003 on the latch stone's held-out sentence
;   1024  no situation, a later step, and a 0-evidence class each cross as nothing
;   2048  the composed choice: recipe-more-vital inside the window; a deadline
;         already passed at receipt is timeout-nothing without running the recipe
;
; The vitality literal 86 is pinned the way the decode-form band pins geometry:
; a literal cannot drift with the code that made it. If the corpus moves, this
; band says so out loud instead of following it silently.
;
; preludes: form-stdlib/dsv4-token-recipe-swap.fk form-stdlib/dsv4-decode-hook-door.fk form-stdlib/dsv4-hook-recipe-quiet.fk form-stdlib/dsv4-hook-recipe-control.fk

(do
    (defn dhdb-score (ok bit) (if ok bit 0))
    (defn dhdb-sentence () "backup restore ran out of its window before anything settled")
    (defn dhdb-line (deadline situation)
        (str_concat "offer step=0 default=201 deadline_ms="
        (str_concat (int_to_str deadline)
        (str_concat " context=3,17 situation=" situation))))

    (let now (now_unix_ms))
    (let future (add now 600000))
    (let line (dhdb-line future (dhdb-sentence)))
    (let empty-line (dhdb-line future ""))
    (let state (dhrc-prepare))
    (let w (dhd-window now future))
    (let offer (dhrc-offer state (dhdb-sentence) "3,17" 201 0 future))
    (let live-choice (dhd-choose dhrc-id dhrc-offer state line now))
    (let late-choice (dhd-choose dhrc-id dhrc-offer state (dhdb-line (sub now 1000) (dhdb-sentence)) now))
    (let quiet-choice (dhd-choose dhrq-id dhrq-offer (dhrq-prepare) line now))

    (sum (list
        (dhdb-score (and (eq (dhd-req-step line) 0)
                     (and (eq (dhd-req-default line) 201)
                          (eq (dhd-req-deadline line) future))) 1)
        (dhdb-score (and (str_eq (dhd-req-context line) "3,17")
                         (str_eq (dhd-req-situation line) (dhdb-sentence))) 2)
        (dhdb-score (and (eq (str_len (dhd-req-situation empty-line)) 0)
                         (eq (dhd-req-default "offer step=0 deadline_ms=5") -1)) 4)
        (dhdb-score (and (not (dhd-req-valid? "step=0 default=1 deadline_ms=5"))
                         (not (dhd-req-valid? "offer step=0 deadline_ms=5 context= situation="))) 8)
        (dhdb-score (and (dtrs-window-valid? w)
                         (ge (dtrs-window-byte-cap w) (dtrs-dsv4-default-bytes))) 16)
        (dhdb-score (and (eq (dtrs-candidate-vitality (dhd-default-cand w 201)) 0)
                         (ge (str_find (dhd-default-witness) "gate-93" 0) 0)) 32)
        (dhdb-score (and (str_eq (dtrs-offer-ack (dhrq-offer 0 (dhdb-sentence) "3" 201 0 future)) "nothing")
                     (and (str_eq (dtrs-choice-reason quiet-choice) "ack-nothing")
                          (eq (dtrs-choice-token quiet-choice) 201))) 64)
        (dhdb-score (eq (dhrc-leak state) 0) 128)
        (dhdb-score (and (eq (dhrc-diag (dhrc-matrix state) 3) 26)
                     (and (eq (dhrc-row-total (dhrc-matrix state) 3 0 0) 30)
                          (eq (dhrc-class-vitality state 3) 86))) 256)
        (dhdb-score (and (str_eq (dtrs-offer-ack offer) "node")
                     (and (eq (dtrs-offer-token offer) 128003)
                     (and (eq (dtrs-offer-vitality offer) 86)
                          (ge (str_find (dtrs-offer-witness offer) "heldout-fresh=26/30" 0) 0)))) 512)
        (dhdb-score (and (str_eq (dtrs-offer-ack (dhrc-offer state "" "3" 201 0 future)) "nothing")
                     (and (str_eq (dtrs-offer-ack (dhrc-offer state (dhdb-sentence) "3" 88 1 future)) "nothing")
                          (eq (dhrc-class-vitality (list (dhrc-models state) (dca-zero-n 25) 0) 3) 0))) 1024)
        (dhdb-score (and (eq (dtrs-choice-token live-choice) 128003)
                     (and (str_eq (dtrs-choice-reason live-choice) "recipe-more-vital")
                     (and (str_eq (dtrs-choice-alternative-state live-choice) "admissible")
                     (and (eq (dtrs-choice-token late-choice) 201)
                          (str_eq (dtrs-choice-alternative-state late-choice) "timeout-nothing"))))) 2048))))
