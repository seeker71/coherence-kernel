; Synthetic BMP bytes for independent decoder checks. No device acquisition.
; preludes: form-stdlib/core.fk
(do
    (defn flmb-b (n) (byte_to_str (mod (if (lt n 0) (add n 4294967296) n) 256)))
    (defn flmb-u16 (n) (str_concat (flmb-b n) (flmb-b (div n 256))))
    (defn flmb-u32 (n)
        (do (let u (if (lt n 0) (add n 4294967296) n))
            (str_concat (flmb-u16 (mod u 65536)) (flmb-u16 (div u 65536)))))
    (defn flmb-join (xs)
        (if (eq (len xs) 0) ""
            (if (eq (len xs) 1) (head xs)
                (str_concat (head xs) (flmb-join (tail xs))))))
    (defn flmb-header (width height data-bytes compression)
        (flmb-join (list "BM" (flmb-u32 (add 54 data-bytes)) (flmb-u32 0) (flmb-u32 54)
            (flmb-u32 40) (flmb-u32 width) (flmb-u32 height) (flmb-u16 1) (flmb-u16 24)
            (flmb-u32 compression) (flmb-u32 data-bytes) (flmb-u32 0) (flmb-u32 0)
            (flmb-u32 0) (flmb-u32 0))))
    (defn flmb-pixel (v) (str_concat (flmb-b v) (str_concat (flmb-b v) (flmb-b v))))
    (defn flmb-six-pixels ()
        (flmb-join (list (flmb-pixel 10) (flmb-pixel 20) (flmb-pixel 100)
                         (flmb-pixel 120) (flmb-pixel 200) (flmb-pixel 220)
                         (flmb-b 0) (flmb-b 0))))
    (defn flmb-bmp (height)
        (str_concat (flmb-header 6 height 20 0) (flmb-six-pixels)))
    (defn flmb-repeat (piece n acc)
        (if (le n 0) acc
            (flmb-repeat (str_concat piece piece) (div n 2)
                (if (eq (mod n 2) 1) (str_concat acc piece) acc))))
    (defn flmb-uniform (width height value)
        (do (let row (mul (div (add (mul width 3) 3) 4) 4))
            (let bytes (mul row height))
            (str_concat (flmb-header width height bytes 0)
                (flmb-repeat (flmb-b value) bytes ""))))
    (defn flmb-color-byte (width at)
        (do (let row (mul (div (add (mul width 3) 3) 4) 4))
            (let x (mod at row))
            (if (ge x (mul width 3)) (flmb-b 251)
                (flmb-b (mod (add (mul at 73) 19) 256)))))
    (defn flmb-colors (width first after)
        (if (ge first after) ""
            (if (eq (add first 1) after) (flmb-color-byte width first)
                (str_concat (flmb-colors width first (div (add first after) 2))
                    (flmb-colors width (div (add first after) 2) after)))))
    (defn flmb-colored (width signed-height)
        (do (let h (if (lt signed-height 0) (sub 0 signed-height) signed-height))
            (let row (mul (div (add (mul width 3) 3) 4) 4))
            (let count (mul row h))
            (str_concat (flmb-header width signed-height count 0)
                (flmb-colors width 0 count))))
    0)
