; preludes: form-stdlib/core.fk form-stdlib/language-model.fk form-stdlib/form-pe-coff.bml
;
; form-pe-coff-band - Windows x86_64 native recipe object floor.
; Verdict 16383 when Form emits a minimal x64 COFF object for a loadable recipe
; DLL through the high-grammar WindowsX64RecipeEmitter class: AMD64 machine
; header, .text section, Windows-x64 machine-code bytes, external recipe symbol,
; empty string table, swappable recipe bodies, and a generic template/class
; contract around the native object emitter.

section [form.bml] {
    def pe_score(ok, bit) {
        ok ? bit : 0;
    }

    def form_pe_coff_band_score() {
        let code = WindowsX64RecipeEmitter_code_mul3_add7();
        let obj = WindowsX64RecipeEmitter_object_for(code);
        let code2 = WindowsX64RecipeEmitter_code_mul5_add1();
        let obj2 = WindowsX64RecipeEmitter_object_for(code2);
        let code3 = WindowsX64RecipeEmitter_code_add42();
        let obj3 = WindowsX64RecipeEmitter_object_for(code3);
        let raw_obj = pe-recipe-object(code);
        let object_member = language-class-member-named(language-class-members(WindowsX64RecipeEmitter), "object_for");
        let symbol_member = language-class-member-named(language-class-members(WindowsX64RecipeEmitter), "symbol");
        sum(list(
            pe_score((Comparable) len(obj) == 88, 1),
            pe_score(((Comparable) obj[0] == 100) && (((Comparable) obj[1] == 134) && ((Comparable) obj[2] == 1)), 2),
            pe_score(((Comparable) obj[8] == 66) && ((Comparable) obj[12] == 1), 4),
            pe_score(((Comparable) obj[20] == 46) && (((Comparable) obj[21] == 116) && (((Comparable) obj[36] == 6) && ((Comparable) obj[40] == 60))), 8),
            pe_score(((Comparable) obj[60] == 72) && (((Comparable) obj[61] == 141) && (((Comparable) obj[64] == 7) && ((Comparable) obj[65] == 195))), 16),
            pe_score(((Comparable) obj[66] == 114) && (((Comparable) obj[67] == 101) && ((Comparable) obj[70] == 112)), 32),
            pe_score(((Comparable) obj[78] == 1) && (((Comparable) obj[80] == 32) && ((Comparable) obj[82] == 2)), 64),
            pe_score(((Comparable) obj[84] == 4) && (((Comparable) len(obj2) == 88) && (((Comparable) obj2[63] == 137) && ((Comparable) obj2[64] == 1))), 128),
            pe_score(((Comparable) len(obj3) == 87) && (((Comparable) obj3[60] == 72) && (((Comparable) obj3[61] == 141) && (((Comparable) obj3[62] == 65) && (((Comparable) obj3[63] == 42) && ((Comparable) obj3[64] == 195))))), 256),
            pe_score(language-template-valid?(NativeObjectEmitter), 512),
            pe_score(language-class-valid?(WindowsX64RecipeEmitter), 1024),
            pe_score((Comparable) len(language-template-members(NativeObjectEmitter)) == 3, 2048),
            pe_score((Comparable) language-class-member-kind(object_member) == LANGUAGE-CLASS-MEMBER-KIND-METHOD, 4096),
            pe_score(((Comparable) language-class-member-kind(symbol_member) == LANGUAGE-CLASS-MEMBER-KIND-METHOD) && (((Comparable) len(WindowsX64RecipeEmitter_symbol()) == 6) && (((Comparable) len(obj) == len(raw_obj)) && (((Comparable) obj[60] == raw_obj[60]) && ((Comparable) obj[84] == raw_obj[84])))), 8192)));
    }

    form_pe_coff_band_score();
}
