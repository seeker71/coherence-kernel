; form-agent-world-model-band.fk -- execution evidence, not candidate prose,
; becomes the Form agent's native world state.
;
; PROOF LEVEL: FOURTH-ARM ONLY -- the execution-verified curriculum currently
; reaches bp("FORM-EXECUTION-CANDIDATE"), whose reviewed sibling-kernel
; registry path is absent from this checkout.  The runtime fkwu lane is probed,
; not inferred.  See the 2026-08-28 receipt for the exact divergence.
;
; Verdict 8191 (13 bits)
;   1     an empty/candidate-only trajectory is honest nothing
;   2     two observed attempts enter one world-model plane
;   4     wrong value is semantic failure and surprise
;   8     corrected value is green and not surprise
;   16    expected and actual values remain in the world position
;   32    a green endpoint offers crystallize
;   64    wrong-value-only evidence offers value contrast
;   128   signal=nothing remains a surprised request for evidence
;   256   returned first-class nothing can be green, distinct from signal=nothing
;   512   the guide re-enters the existing Form-agent tool-result protocol
;   1024  syntax failure keeps its diagnostic-directed action
;   2048  mismatched candidate identity cannot enter the world
;   4096  three repeated observed misses remain three world events, not absence
;
; preludes: form-stdlib/form-agent-world-model.fk

import "../form-agent-world-model.fk"

(do
    (defn fawmb-bit (ok bit) (if ok bit 0))
    (defn fawmb-candidate (source expected provenance)
        (evfc-candidate "square-plus-one"
            "Return n squared plus one for n=6." source expected provenance))
    (defn fawmb-observation (candidate preflight signal value compile-exit run-exit diagnostic provenance)
        (evfc-observation (evfc-candidate-id candidate) preflight signal value
            (evfc-execution compile-exit run-exit diagnostic)
            (evfc-evidence "form-eval-full+preflight-v1" provenance)))
    (defn fawmb-trajectory (steps provenance)
        (evfc-trajectory "square-plus-one" steps provenance))

    (let wrong-c (fawmb-candidate "(do (add 6 6))" 37 "candidate/wrong"))
    (let wrong-o (fawmb-observation wrong-c "clean" "return" 12 0 0 "" "observation/wrong"))
    (let wrong-s (evfc-step wrong-c wrong-o))
    (let green-c (fawmb-candidate "(do (add (mul 6 6) 1))" 37 "candidate/green"))
    (let green-o (fawmb-observation green-c "clean" "return" 37 0 0 "" "observation/green"))
    (let green-s (evfc-step green-c green-o))
    (let repaired (fawmb-trajectory (list wrong-s green-s) "trajectory/repaired"))
    (let repaired-world (fawm-world repaired))
    (let repaired-image (fawm-world-image repaired))

    (let empty-t (fawmb-trajectory (empty) "trajectory/empty"))
    (let c1 (fawmb-bit (nothing? (fawm-world empty-t)) 1))
    (let c2 (fawmb-bit
        (and (eq (len repaired-world) 2)
             (eq (fawm-attempt-count repaired) 2)) 2))
    (let c4 (fawmb-bit
        (and (str_eq (fawm-last-kind (fawmb-trajectory (list wrong-s) "trajectory/wrong"))
                    "semantic-failure")
             (eq (nth (wm-ent-embedding (head repaired-world)) 1) 1)) 4))
    (let c8 (fawmb-bit
        (and (str_eq (fawm-last-kind repaired) "green")
             (eq (nth (wm-ent-embedding (nth repaired-world 1)) 1) 0)) 8))
    (let wrong-position (wm-ent-position (head repaired-world)))
    (let green-position (wm-ent-position (nth repaired-world 1)))
    (let c16 (fawmb-bit
        (and (eq (nth wrong-position 1) 37)
        (and (eq (nth wrong-position 2) 12)
        (and (eq (nth green-position 1) 37)
             (eq (nth green-position 2) 37)))) 16))
    (let c32 (fawmb-bit (str_eq (fawm-next-action repaired) "crystallize") 32))
    (let wrong-t (fawmb-trajectory (list wrong-s) "trajectory/wrong-only"))
    (let c64 (fawmb-bit
        (and (eq (fawm-surprise-count wrong-t) 1)
             (str_eq (fawm-next-action wrong-t) "revise-with-value-contrast")) 64))

    (let silence-o (fawmb-observation wrong-c "clean" "nothing" (nothing)
        0 0 "deadline-no-value" "observation/nothing"))
    (let silence-t (fawmb-trajectory (list (evfc-step wrong-c silence-o))
        "trajectory/nothing"))
    (let c128 (fawmb-bit
        (and (str_eq (fawm-last-kind silence-t) "nothing")
        (and (eq (fawm-surprise-count silence-t) 1)
             (str_eq (fawm-next-action silence-t) "request-evidence"))) 128))

    (let nothing-c (fawmb-candidate "(do nothing)" (nothing) "candidate/return-nothing"))
    (let nothing-o (fawmb-observation nothing-c "clean" "return" (nothing)
        0 0 "" "observation/return-nothing"))
    (let nothing-t (fawmb-trajectory (list (evfc-step nothing-c nothing-o))
        "trajectory/return-nothing"))
    (let c256 (fawmb-bit
        (and (str_eq (fawm-last-kind nothing-t) "green")
        (and (eq (fawm-surprise-count nothing-t) 0)
             (str_eq (fawm-next-action nothing-t) "crystallize"))) 256))

    (let msg (fawm-agent-message "call-world-1" repaired))
    (let msg-part (head (ap-msg-parts msg)))
    (let c512 (fawmb-bit
        (and (str_eq (ap-msg-role msg) "tool")
        (and (str_eq (ap-part-kind msg-part) "tool_result")
        (and (str_eq (ap-tr-id msg-part) "call-world-1")
        (and (str_eq (ap-tr-name msg-part) "world-model-observe")
             (str_eq (fawm-guide-action (ap-tr-content msg-part)) "crystallize"))))) 512))

    (let syntax-c (fawmb-candidate "(do (add 1" 1 "candidate/syntax"))
    (let syntax-o (fawmb-observation syntax-c "unbalanced-source" "failure" (nothing)
        1 1 "error: input-ended-mid-form" "observation/syntax"))
    (let syntax-t (fawmb-trajectory (list (evfc-step syntax-c syntax-o))
        "trajectory/syntax"))
    (let c1024 (fawmb-bit
        (and (str_eq (fawm-last-kind syntax-t) "syntax-failure")
             (str_eq (fawm-next-action syntax-t) "revise-with-diagnostic")) 1024))

    (let other-c (fawmb-candidate "(do 37)" 37 "candidate/other"))
    (let mismatch-o (evfc-observation (evfc-candidate-id other-c) "clean" "return" 12
        (evfc-execution 0 0 "")
        (evfc-evidence "form-eval-full+preflight-v1" "observation/mismatch")))
    (let mismatch-t (fawmb-trajectory (list (evfc-step wrong-c mismatch-o))
        "trajectory/mismatch"))
    (let c2048 (fawmb-bit
        (and (nothing? (fawm-world mismatch-t))
             (nothing? (fawm-agent-message "call-invalid" mismatch-t))) 2048))

    (let plateau-t (fawmb-trajectory (list wrong-s wrong-s wrong-s) "trajectory/plateau"))
    (let c4096 (fawmb-bit
        (and (eq (len (fawm-world-image plateau-t)) 3)
        (and (eq (fawm-surprise-count plateau-t) 3)
             (str_eq (fawm-next-action plateau-t) "revise-with-value-contrast"))) 4096))

    (sum (list c1 c2 c4 c8 c16 c32 c64 c128 c256 c512 c1024 c2048 c4096)))
