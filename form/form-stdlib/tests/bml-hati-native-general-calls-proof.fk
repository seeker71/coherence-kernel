; tests/bml-hati-native-general-calls-proof.fk
;
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk
;
; Closes general-calls. Call arguments are expressions: nested calls, bound
; names, sums, parentheses and zero-argument calls, in returns and in method
; bodies. A receiver that names a package (the unit's own or an imported one)
; resolves through scope; a receiver that is a value is named for the class
; dispatch wave. Both lanes agree: BMA inlines a callee's final return as the
; call's value, Hati lowers the same source into CALL/ICALL rows.

(do
    (defn score-bool (actual)
        (if actual 1 0))

    (defn score-int (actual expected)
        (if (eq actual expected) 1 0))

    (defn score-str (actual expected)
        (if (str_eq (value_kind actual) "string")
            (if (str_eq actual expected) 1 0)
             0))

    (defn str-contains? (haystack needle)
        (ge (str_find haystack needle 0) 0))

    ; the canonical sources live in tests/fixtures, one program to a file
    (defn gc-parse (name)
        (bml-source-parse-executable-stream
            (bml-source-scan-file (str_concat "form-stdlib/tests/fixtures/" name))))

    (defn gc-node (name)
        (bml-source-exec-parse-node (gc-parse name)))

    (defn gc-both (node)
        (if (eq (bma-run-value (bml-compile-unit-program node (empty))) 42)
            (if (eq (bml-hati-run-value node) 42) 1 0)
            0))

    (let source
        "bml-calls-nested-args.bml")
    (let parsed (gc-parse source))
    (let source-node (bml-source-exec-parse-node parsed))
    (let source-image (bml-hati-compile-image source-node))
    (let source-table (bml-hati-table-file source-image))

    (let answer-parsed (gc-parse "bml-calls-no-args.bml"))
    (let paren-node (gc-node "bml-calls-in-parens.bml"))
    (let body-call-node
        (gc-node "bml-calls-in-method-body.bml"))
    (let namespace-node
        (gc-node "bml-calls-qualified-nested.bml"))
    (let bmf-unit (gc-node "bml-calls-unit-bmf.bml"))
    (let imported-node (gc-node "bml-calls-imported-qualified.bml"))

    (let receiver-image
        (bml-hati-compile-image
            (gc-node "bml-names-value-receiver.bml")))
    (let arity-image
        (bml-hati-compile-image
            (gc-node "bml-calls-arity-mismatch.bml")))
    (let unbound-image
        (bml-hati-compile-image
            (gc-node "bml-calls-unbound-arg.bml")))

    (sum
        (list
            (score-bool (bml-source-exec-parse-ok? parsed))
            (score-int (len (bml-source-exec-parse-rest parsed)) 0)
            (score-str (nth (bml-source-exec-parse-rules parsed) 3) "return-expr")
            (score-int (len (bml-call-args (bml-node-child (nth (bml-source-exec-parse-nodes parsed) 3) 0))) 2)
            (score-int (bma-run-value (bml-compile-unit-program source-node (empty))) 42)
            (score-bool (bml-hati-image-supported? source-image))
            (score-int (len (bml-hati-image-fns source-image)) 3)
            (score-int (bml-hati-run-value source-node) 42)
            (score-bool (str-contains? source-table "44"))
            (score-bool (not (str-contains? source-table "BML-HATI-UNSUPPORTED")))
            (score-str (nth (bml-source-exec-parse-rules answer-parsed) 0) "method-body")
            (score-int (len (bml-method-node-parameters (head (bml-source-exec-parse-nodes answer-parsed)))) 0)
            (gc-both (bml-source-exec-parse-node answer-parsed))
            (gc-both paren-node)
            (gc-both body-call-node)
            (gc-both namespace-node)
            (score-int (bml-hati-run-unit-value imported-node (list bmf-unit)) 42)
            (score-int (bma-run-value (bml-compile-unit-program imported-node (list bmf-unit))) 42)
            (score-str (head (bml-hati-image-unsupported receiver-image)) "call/receiver-dispatch")
            (score-bool (str-contains? (bml-hati-table-file receiver-image) "BML-HATI-UNSUPPORTED call/receiver-dispatch"))
            (score-str (head (bml-hati-image-unsupported arity-image)) "call/arity")
            (score-str (head (bml-hati-image-unsupported unbound-image)) "call/unbound"))))
