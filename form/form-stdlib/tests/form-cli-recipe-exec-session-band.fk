; form-cli-recipe-exec-session-band.fk — pure joined-loop shape witness.
;
; Verdict 4095:
;   1    three authorship lanes remain separate values
;   2    model-byte total excludes injected bytes
;   4    before/after ID ledgers remain separate
;   8    cursor crossing and once-only callback are explicit
;   16   physical carrier execution is read from typed callback evidence
;   32   native generation is independent of model execution
;   64   generated and injected session counters remain independent
;   128  zero is a pending model ID, not absence
;   256  operation status can be nothing while residence remains owned
;   512  exact observation identity retains physical flags
;   1024 no transcript-reencode policy is named by the session
;   2048 this pure witness runs neither model nor carrier
;
; preludes: form-stdlib/form-cli-recipe-exec-session.fk

(do
    (defn frxsb-bit (ok bit) (if ok bit 0))
    (let ctx (list "opaque-context"))
    (let sts (list "opaque-state"))
    (let s (fcms-session "live" "opened" "model.gguf" "src" ctx sts
        2048 50 0 0 49 4 3 1))
    (let req (frex-parse (frex-surface (frex-recipe) 0 "metal")))
    (let trace (frex-result-trace (frex-choice req
        (list (frex-offer "metal" "value" 0 "metal-value")))))
    (let flagged (frex-result-with-flags "value" "metal-value" req "metal"
        0 1 trace 1 1 0 1))
    (let c (frxc-cursor "" (frxc-state-complete) "complete" 1 0 1
        321 71 6 req flagged trace "value" "metal-value" "metal" 0 1
        (frex-render flagged)))
    (let r (frxs-result s c "request-bytes" "answer-bytes"
        "observation-bytes" (list 10 11) (list 12 13 14)))
    (let refused (fcms-session "nothing" "window-refused" "model.gguf" "src"
        ctx sts 2048 50 0 0 49 4 3 1))
    (sum (list
        (frxsb-bit (and (str_eq (frxs-before-text r) "request-bytes")
            (and (str_eq (frxs-after-text r) "answer-bytes")
                 (str_eq (frxs-injected-text r) "observation-bytes"))) 1)
        (frxsb-bit (and (eq (frxs-model-bytes r)
            (add (str_len "request-bytes") (str_len "answer-bytes")))
            (eq (frxs-injected-bytes r) (str_len "observation-bytes"))) 2)
        (frxsb-bit (and (eq (len (frxs-before-ids r)) 2)
                         (eq (len (frxs-after-ids r)) 3)) 4)
        (frxsb-bit (and (eq (frxs-crossed? r) 1)
                         (eq (frxs-callback-calls r) 1)) 8)
        (frxsb-bit (eq (frxs-carrier-executed? r) 1) 16)
        (frxsb-bit (and (eq (frxs-native-code-generated? r) 1)
                         (eq (frxs-model-executed-form? r) 0)) 32)
        (frxsb-bit (and (eq (fcms-generated-ids (frxs-session r)) 4)
                         (eq (fcms-injected-ids (frxs-session r)) 3)) 64)
        (frxsb-bit (and (eq (fcms-pending (frxs-session r)) 0)
                         (eq (fcms-pending? (frxs-session r)) 1)) 128)
        (frxsb-bit (and (eq (fcms-live? refused) 0)
                         (eq (fcms-resident? refused) 1)) 256)
        (frxsb-bit (node_eq (frex-result-observation flagged)
            (frex-observation-token-with-flags "value" "metal-value" req
                "metal" 0 1 trace 1 0 1)) 512)
        (frxsb-bit (and (ge (str_find (fcms-generated-id-policy) "original" 0) 0)
            (lt (str_find (fcms-generated-id-policy) "re-encode" 0) 0)) 1024)
        (frxsb-bit 1 2048))))
