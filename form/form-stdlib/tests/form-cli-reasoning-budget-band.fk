; Scripted stage boundaries; no model, GPU, file writes or learning.
; preludes: form-stdlib/bml/form-cli-generate-command.bml
(do
 (defn frbgb-need (ok why) (if ok 1 (form_error why)))
 (defn frbgb-session (mode maxpos)
  (fcms-session "live" mode "synthetic" "" (list "ctx") (list "state") maxpos 10 0 0 10 0 0 0))
 (defn frbgb-generate (s limit)
  (if (eq (fcms-observations s) 0)
   (if (str_eq (fcms-reason s) "natural")
    (fcms-generation "private-thought-and-final" (list 5 99 0 1) (fcms-with-stream s 14 77 1 4 0 0))
    (if (str_eq (fcms-reason s) "failure")
     (fcms-generation "private-partial" (list 5) (fcms-with-stream s 11 -1 1 1 0 0))
     (fcms-generation "private-partial" (list 5 6) (fcms-with-stream s 11 6 0 2 0 0))))
   (fcms-generation "final" (list 0 1) (fcms-with-stream s (add (fcms-pos s) 1) 77
    (if (str_eq (fcms-reason s) "final-cut") 0 1) (add (fcms-generated-ids s) 2) (fcms-injected-ids s) (fcms-observations s)))))
 (defn frbgb-bridge (s text reserve)
  (if (str_eq (fcms-reason s) "bridge-refuse") (fcms-refuse s "final-response-reserve-does-not-fit")
   (fcms-with-stream s (add (fcms-pos s) 3) 0 0 (fcms-generated-ids s) 3 (add (fcms-observations s) 1))))
 (defn frbgb-decode (s ids) (if (value_eq ids (list 0 1)) "final" (form_error "wrong final ID slice")))
 (defn frbgb-run (mode maxpos) (frbg-with (frbgb-session mode maxpos) (if (str_eq mode "natural") 4 2) 4 99 frbgb-generate frbgb-bridge frbgb-decode))
 (frbgb-need (and (not (frbg-reserve-fits (frbgb-session "budget" 17) 3 4))
                 (frbg-reserve-fits (frbgb-session "budget" 18) 3 4)) "observation omitted from final reserve")
 (let natural (frbgb-run "natural" 100))
 (frbgb-need (and (frbg-complete natural) (and (str_eq (frbg-answer natural) "final") (eq (fcms-observations (frbg-session natural)) 0))) "natural final was replaced")
 (frbgb-need (str_eq (frbg-origin natural) "model-final") "natural origin lost")
 (let bridged (frbgb-run "budget" 100))
 (frbgb-need (and (frbg-complete bridged) (and (str_eq (frbg-origin bridged) "controller-final-stage") (eq (fcms-observations (frbg-session bridged)) 1))) "budget stage was not explicit and singular")
 (frbgb-need (and (str_eq (fcms-generation-text (frbg-first bridged)) "private-partial") (str_eq (frbg-answer bridged) "final")) "private generation replaced or exposed as answer")
 (frbgb-need (and (eq (fcms-generated-ids (frbg-session bridged)) 4) (eq (fcms-injected-ids (frbg-session bridged)) 3)) "stage counters lost")
 (let failed (frbgb-run "failure" 100))
 (frbgb-need (and (not (frbg-complete failed)) (eq (fcms-observations (frbg-session failed)) 0)) "failed generation resumed")
 (let small (frbgb-run "budget" 16))
 (frbgb-need (and (not (frbg-complete small)) (nil? (fcms-generation-ids (frbg-first small)))) "reserve refusal still generated")
 (let refused (frbgb-run "bridge-refuse" 100))
 (frbgb-need (and (not (frbg-complete refused)) (nil? (fcms-generation-ids (frbg-final refused)))) "refused bridge generated")
 (let cut (frbgb-run "final-cut" 100))
 (frbgb-need (and (not (frbg-complete cut)) (str_eq (frbg-answer cut) "final")) "partial final lost or declared complete")
 (frbgb-need (eq (fal-count " one\ttwo\nthree-four\r\nfive ") 4) "word count did not follow whitespace")
 (frbgb-need (eq (fal-count "") 0) "empty answer acquired a word")
 (frbgb-need (str_eq (fcmo-tool-content "  measured 510\n") "<tool_response>\n  measured 510\n\n</tool_response>") "tool envelope changed observation bytes")
 (let unchanged (fal-with natural 1 1 4 frbgb-generate frbgb-bridge))
 (frbgb-need (and (eq (nth unchanged 7) 0) (eq (nth unchanged 6) 1)) "in-range answer was revised")
 (let stillShort (fal-with natural 2 3 4 frbgb-generate frbgb-bridge))
 (frbgb-need (and (eq (nth stillShort 7) 1) (and (eq (nth stillShort 6) 0) (eq (fcms-observations (head stillShort)) 1))) "failed length correction retried or passed")
 (frbgb-need (and (eq (nth stillShort 8) 1) (str_eq (nth stillShort 1) "final")) "completion was confused with requested length")
 (let partial (fal-with cut 2 3 4 frbgb-generate frbgb-bridge))
 (frbgb-need (eq (nth partial 7) 0) "unfinished answer entered length correction")
 (frbgb-need (str_eq (fgcr-result-reason failed (fal-with failed 0 0 4 frbgb-generate frbgb-bridge)) (frbg-reason failed)) "generation failure reason was hidden")
 (frbgb-need (str_eq (frbg-reason (fgcr-initial (fcms-none "source-admission-refused") 0 4)) "source-admission-refused") "direct generation hid admission failure")
 (let responsePrefix (fgcr-response-prompt ""))
 (frbgb-need (eq (str_find responsePrefix (fqt-meaning-prefix) 0) 0) "response lost shared Form meaning")
 (frbgb-need (and (eq (str_find responsePrefix (fqt-query-shape) 0) -1)
                 (eq (str_find responsePrefix (fqt-two-phase-contract) 0) -1)) "response advertised an unbound query protocol")
 (let callerBytes "  caller quotes <|form:knowledge-query|> without dispatch\n  ")
 (frbgb-need (str_eq (fgcr-response-prompt callerBytes) (str_concat responsePrefix callerBytes)) "response changed caller bytes")
 (frbgb-need (ge (str_find (fqt-overlay-prefix) (fqt-two-phase-contract) 0) 0) "query-capable overlay lost its contract")
 (let request (fgc-request "--words 350:450 --tokens 2048 --reasoning 100  exact prompt  "))
 (frbgb-need (value_eq request (list 2048 " exact prompt  " "" 100 350 450)) "word option changed prompt bytes or other options")
 (frbgb-need (value_eq (fgc-request "--tokens 2048 --words 350:450 prompt") (list 2048 "prompt" "" 0 350 450)) "word option order failed")
 (frbgb-need (gt (str_len (nth (fgc-request "--words 450:350 prompt") 2)) 0) "inverted word range admitted")
 (frbgb-need (gt (str_len (nth (fgc-request "--words 0:450 prompt") 2)) 0) "zero word lower bound admitted")
 (frbgb-need (gt (str_len (nth (fgc-request "--words 350:450 --words 350:450 prompt") 2)) 0) "repeated word option admitted")
 (frbgb-need (gt (str_len (nth (fgc-request "--words 350:450") 2)) 0) "missing word-range prompt admitted")
 1)
