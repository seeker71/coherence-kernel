; living-world-trace-relation-hypothesis-band.fk -- experience may propose,
; but one trace reflection cannot name a relation or borrow authority.
; Verdict 32767 proves fifteen trace/reflection/option/time claims.
; witnessed: 2026-08-08 -> 32767 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-trace-relation.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-trace-relation-witness.fk

(do
    (let symbol-world (lwtrw-symbol-world))
    (let two-world (lwtrw-two-world))
    (let proposal (lwtrw-hypothesis-proposal))
    (let candidate (lwtrw-hypothesis-candidate))
    (let hypothesis (lwtrw-hypothesis))
    (let ambiguous-proposals
        (lwtr-hypothesis-proposals (lwtrw-ambiguous-world) 2))
    (let other-proposal
        (lwtrw-find-hypothesis-proposal
            ambiguous-proposals (lwtrw-other-view)))
    (let pending
        (lwtr-time-observation
            (lwtrw-rich-offer) (intern_trivial_int 5)))
    (let expired
        (lwtr-time-observation
            (lwtrw-rich-offer) (intern_trivial_int 12)))

    (let c1
        (if (and (eq (lwtr-execution-basis-current?
                         (lwtrw-execution-world) (lwtrw-basis)) 1)
                 (and (node_eq (lwtrw-before) (lwrew-before))
                      (eq (node_value (lwtrw-after)) 49))) 1 0))
    (let c2
        (if (and (eq (lwo-field-size
                         (lwt-round-proposals (lwtrw-symbol-round))) 2)
                 (and (eq (lwsl-integrated-current?
                              symbol-world (lwtrw-left-symbol)) 1)
                      (eq (lwsl-integrated-current?
                              symbol-world (lwtrw-right-symbol)) 1))) 2 0))
    (let c3
        (if (and (eq (lwtr-offer-shape-valid?
                         (lwtrw-incomplete-offer)) 1)
                 (and (eq (lwtr-offer-complete?
                              (lwtrw-incomplete-offer)) 0)
                      (node_eq
                        (lwtr-hypothesis-proposal-for
                            symbol-world (lwtrw-incomplete-offer) 2)
                        (lwo-none)))) 4 0))
    (let c4
        (if (eq (lwo-field-size
                    (lwtr-hypothesis-proposals symbol-world 2)) 0) 8 0))
    (let c5
        (if (eq (lwo-field-size
                    (lwtr-hypothesis-proposals (lwtrw-one-world) 2)) 0)
            16 0))
    (let c6
        (if (and (eq (lwo-field-size
                         (lwtr-hypothesis-proposals two-world 2)) 1)
                 (and (eq (lwtr-hypothesis-candidate? candidate) 1)
                      (eq (lwtr-distinct-source-count
                             (lwtr-offer-attributions
                               (lwtr-hypothesis-offers hypothesis))) 2)))
            32 0))
    (let c7
        (if (and (eq (lwo-field-size
                         (lwtr-hypothesis-offers hypothesis)) 2)
                 (and (eq (lwo-field-size
                              (lwtr-hypothesis-alternatives hypothesis)) 1)
                      (and (eq (lwo-field-size
                                 (lwtr-hypothesis-unknowns hypothesis)) 1)
                           (and (eq (lwo-field-size
                                      (lwtr-hypothesis-choices hypothesis)) 1)
                                (eq (lwo-field-size
                                      (lwtr-hypothesis-timeouts hypothesis))
                                    1))))) 64 0))
    (let c8
        (if (and (node_eq
                    (lwtr-relation-recipe
                        (lwtr-hypothesis-relation hypothesis))
                    (lwre-trace-recipe (lwtrw-trace)))
                 (and (node_eq
                        (lwtr-relation-declaration
                            (lwtr-hypothesis-relation hypothesis))
                        (lwre-trace-declaration (lwtrw-trace)))
                      (and (node_eq
                            (lwtr-relation-trace-lens
                                (lwtr-hypothesis-relation hypothesis))
                            (lwre-trace-lens (lwtrw-trace)))
                           (node_eq
                            (lwtr-relation-view
                                (lwtr-hypothesis-relation hypothesis))
                            (lwo-none))))) 128 0))
    (let c9
        (if (and (eq (lwo-field-size
                         (lwt-proposal-participants proposal)) 6)
                 (eq (lwtr-hypothesis-candidate-current?
                         two-world candidate) 1)) 256 0))
    (let c10
        (if (and (eq (lwtr-hypothesis-integrated-current?
                         (lwtrw-hypothesis-world) candidate) 1)
                 (eq (lwo-active?
                         (lwtrw-hypothesis-world) candidate) 1)) 512 0))
    (let c11
        (if (and (eq (lwo-field-size ambiguous-proposals) 2)
                 (and (not (node_eq other-proposal (lwo-none)))
                      (not (node_eq
                            (lwt-proposal-candidate other-proposal)
                            candidate)))) 1024 0))
    (let c12
        (if (and (node_eq
                    (lwtr-time-observation
                        (lwtrw-rich-offer) (lwo-none))
                    (lwo-none))
                 (and (eq (oac-time-pending? pending) 1)
                      (not (node_eq pending (oac-nothing))))) 2048 0))
    (let c13
        (if (and (eq (oac-time-outcome? expired) 1)
                 (and (eq (oac-alternative-ack?
                              (oac-time-outcome-ack expired)) 1)
                      (and (eq (oac-nothing?
                                 (oac-time-outcome-ack expired)) 0)
                           (not (node_eq expired pending))))) 4096 0))
    (let c14
        (if (and (eq (lwtr-attestation-current?
                         (lwtrw-self-world)
                         (lwtrw-self-attestation)) 0)
                 (node_eq
                    (lwtrw-edge-proposal-for
                        (lwtrw-hypothesis-world))
                    (lwo-none))) 8192 0))
    (let c15
        (if (and (eq (lwo-field-size
                         (lwtr-offer-alternatives
                            (lwtrw-minimal-offer))) 0)
                 (and (node_eq
                        (lwtr-offer-unknown (lwtrw-minimal-offer))
                        (lwo-none))
                      (and (node_eq
                            (lwtr-offer-choice (lwtrw-minimal-offer))
                            (lwo-none))
                           (node_eq
                            (lwtr-offer-timeout (lwtrw-minimal-offer))
                            (lwo-none))))) 16384 0))
    (lwtrw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
