; living-world-composition-outcome-band.fk -- feedback reopens without seizing edges.
; Verdict 32767 proves fifteen confirmation, correction, and reopening claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/living-world-multilens-plan.fk form-stdlib/living-world-composition-outcome.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk form-stdlib/tests/living-world-relational-voice-witness.fk form-stdlib/tests/living-world-multilens-witness.fk form-stdlib/tests/living-world-composition-outcome-witness.fk

(do
    (let initial-proposal (lwcow-initial-proposal))
    (let initial-candidate (lwt-proposal-candidate initial-proposal))
    (let initial-composition (lwo-emergent-shape initial-candidate))
    (let waiting
        (lwco-integrate (lwcow-initial-round)
            initial-proposal (lwrew-action)))
    (let initial-integrated (lwcow-initial-integrated-round))
    (let initial-world (lwt-round-world initial-integrated))
    (let observed-world (lwcow-observed-world))
    (let observed-set
        (lwco-evidence-for observed-world (lwcow-bundle)))
    (let confirmed-proposal (lwcow-confirmed-proposal))
    (let confirmed-candidate
        (lwt-proposal-candidate confirmed-proposal))
    (let confirmed-composition
        (lwo-emergent-shape confirmed-candidate))
    (let confirmed-world (lwcow-confirmed-integrated-world))
    (let late (lwcow-late-world))
    (let late-set (lwco-evidence-for late (lwcow-bundle)))
    (let contested-proposal (lwcow-contested-proposal))
    (let contested-composition
        (lwo-emergent-shape
            (lwt-proposal-candidate contested-proposal)))

    (let c1 (if (and (eq (lwco-unobserved?
                              (lwco-composition-state
                                initial-composition)) 1)
                         (eq (lwlc-unknown?
                              (lwco-composition-unknown
                                initial-composition)) 1)) 1 0))
    (let c2 (if (and (eq (lwo-field-size
                              (lwco-composition-witnesses
                                initial-composition)) 16)
                         (eq (lwo-field-size
                              (lwt-proposal-participants
                                initial-proposal)) 4)) 2 0))
    (let c3 (if (and (eq (lwo-world-has?
                              (lwt-round-world waiting)
                              initial-candidate) 0)
                         (eq (lwo-active?
                              initial-world initial-candidate) 1)) 4 0))
    (let c4 (if (eq (lwco-integrated-current?
                         initial-world initial-candidate) 1) 8 0))
    (let c5 (if (and (eq (lwco-observation-valid?
                              (lwcow-confirmation)) 1)
                         (eq (lwco-observation-valid?
                              (lwcow-silence)) 1)) 16 0))
    (let c6 (if (and (eq (lwco-confirmation-count observed-set) 1)
                         (and (eq (lwco-silence-count observed-set) 1)
                              (eq (lwco-correction-count observed-set) 0)))
                     32 0))
    (let c7 (if (eq (lwco-candidate-current?
                         observed-world initial-candidate) 0) 64 0))
    (let c8 (if (and (eq (lwco-confirmed?
                              (lwco-composition-state
                                confirmed-composition)) 1)
                         (and (node_eq
                               (lwco-composition-unknown
                                 confirmed-composition) (lwo-none))
                              (eq (lwo-field-size
                                   (lwco-composition-alternatives
                                     confirmed-composition)) 0))) 128 0))
    (let c9 (if (and (eq (lwo-field-size
                              (lwco-composition-witnesses
                                confirmed-composition)) 18)
                         (eq (lwo-field-size
                              (lwt-proposal-participants
                                confirmed-proposal)) 6)) 256 0))
    (let c10 (if (eq (lwco-integrated-current?
                          confirmed-world confirmed-candidate) 1) 512 0))
    (let c11 (if (and (eq (lwco-observation-valid?
                               (lwcow-correction)) 1)
                          (and (eq (lwco-observation-valid?
                                    (lwcow-alternative-offer)) 1)
                               (and (eq (lwco-observation-valid?
                                         (lwcow-false-confirmation)) 0)
                                    (eq (lwco-observation-valid?
                                         (lwcow-false-correction)) 0))))
                      1024 0))
    (let c12 (if (and (eq (lwco-confirmation-count late-set) 1)
                          (and (eq (lwco-silence-count late-set) 1)
                               (and (eq (lwco-correction-count late-set) 1)
                                    (eq (lwco-alternative-count late-set) 1))))
                      2048 0))
    (let c13 (if (eq (lwco-candidate-current?
                          late confirmed-candidate) 0) 4096 0))
    (let c14 (if (and (eq (lwco-contested?
                               (lwco-composition-state
                                 contested-composition)) 1)
                          (and (eq (lwo-field-size
                                    (lwco-composition-alternatives
                                      contested-composition)) 2)
                               (and (eq (lwlc-unknown?
                                         (lwco-composition-unknown
                                           contested-composition)) 1)
                                    (and (eq (lwo-field-size
                                              (lwco-composition-witnesses
                                                contested-composition)) 20)
                                         (eq (lwo-field-size
                                              (lwt-proposal-participants
                                                contested-proposal)) 8)))))
                      8192 0))
    (let c15 (if (and (eq (lwmp-bundle-current?
                               late (lwcow-bundle)) 1)
                          (eq (lwrl-integrated-current?
                               late (lwcow-alpha-first-candidate)) 1))
                      16384 0))
    (lwcow-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
