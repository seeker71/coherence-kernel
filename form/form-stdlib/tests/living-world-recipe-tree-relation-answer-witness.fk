; living-world-recipe-tree-relation-answer-witness.fk -- fresh O/P holders ask
; an unresolved binding question and receive a consented native composed answer.
; No expected answer is present in the query or answer path.
; witnessed: 2026-08-09 -> 24-field privacy-safe aggregate; 25 call cells
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/living-world-recipe-tree-revision-trial.fk form-stdlib/living-world-recipe-tree-revision-hypothesis.fk form-stdlib/living-world-recipe-tree-revision-prospective.fk form-stdlib/living-world-recipe-tree-relation-nursery.fk form-stdlib/living-world-recipe-tree-relation-offer.fk form-stdlib/living-world-recipe-tree-relation-prospective.fk form-stdlib/living-world-recipe-tree-relation-answer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk

(let LWRRPAW-SOURCE-O    (bp "LWRRPAW-SOURCE-O"))
(let LWRRPAW-SOURCE-P    (bp "LWRRPAW-SOURCE-P"))
(let LWRRPAW-EVIDENCE    (bp "LWRRPAW-EVIDENCE"))
(let LWRRPAW-ALTERNATIVE (bp "LWRRPAW-ALTERNATIVE"))
(let LWRRPAW-QUERY-KEY   (bp "LWRRPAW-QUERY-KEY"))
(let LWRRPAW-SCOPE       (bp "LWRRPAW-SCOPE"))
(let LWRRPAW-ROLE        (bp "LWRRPAW-ROLE"))
(let LWRRPAW-RESULT      (bp "LWRRPAW-RESULT"))

(defn lwrrpaw-cell (kind) (intern_node kind (empty)))
(defn lwrrpaw-source-o () (lwrrpaw-cell LWRRPAW-SOURCE-O))
(defn lwrrpaw-source-p () (lwrrpaw-cell LWRRPAW-SOURCE-P))
(defn lwrrpaw-evidence () (lwrrpaw-cell LWRRPAW-EVIDENCE))
(defn lwrrpaw-alternative () (lwrrpaw-cell LWRRPAW-ALTERNATIVE))
(defn lwrrpaw-query-key () (lwrrpaw-cell LWRRPAW-QUERY-KEY))
(defn lwrrpaw-alternatives ()
    (lwo-field (list (lwrrpaw-alternative))))
(defn lwrrpaw-unknown () (lwlc-unknown (lwrrpaw-evidence)))
(defn lwrrpaw-reason ()
    (intern_node LWRRPAW-EVIDENCE
        (list (lwrrpaw-query-key))))
(defn lwrrpaw-entry (source payload)
    (lwphw-entry source (lwrrpaw-evidence) payload))

(defn lwrrpaw-trial (relation)
    (lwrro-choice-trial (lwo-emergent-shape relation)))
(defn lwrrpaw-support-case (relation)
    (do
        (let derivation
            (head (lwo-field-items
                (lwrrn-trial-derivations (lwrrpaw-trial relation)))))
        (nth (node_children derivation) 0)))
(defn lwrrpaw-support-binding-items (relation)
    (lwre-binding-items
        (lwps-case-bindings (lwrrpaw-support-case relation))))

(defn lwrrpaw-scope (name)
    (intern_node LWRRPAW-SCOPE
        (list (lwrrpaw-query-key) (intern_trivial_string name))))
(defn lwrrpaw-role (name)
    (intern_node LWRRPAW-ROLE
        (list (lwrrpaw-query-key) (intern_trivial_string name))))
(defn lwrrpaw-value-for (relation name)
    (do
        (let invariant
            (lwrro-choice-invariant (lwo-emergent-shape relation)))
        (let value (node_value (lwrrn-invariant-value invariant)))
        (if (str_eq name (lwrrn-invariant-name invariant))
            value (add value 9))))
(defn lwrrpaw-projection (relation name)
    (lwre-projection (lwrrpaw-scope name) (lwrrpaw-role name)
        (intern_trivial_int (lwrrpaw-value-for relation name))
        (lwrrpaw-alternatives) (lwrrpaw-unknown) (lwrrpaw-evidence)))
(defn lwrrpaw-binding (relation name)
    (lwre-projected-binding name (lwrrpaw-projection relation name)
        (lwrrpaw-evidence)))
(defn lwrrpaw-bindings-items (relation items acc)
    (if (eq (len items) 0) (lwre-bindings acc)
        (do
            (let name (lwre-binding-name (head items)))
            (lwrrpaw-bindings-items relation (tail items)
                (append acc (list (lwrrpaw-binding relation name)))))))
(defn lwrrpaw-bindings (relation)
    (lwrrpaw-bindings-items relation
        (lwrrpaw-support-binding-items relation) (list)))

(defn lwrrpaw-default-lens (relation)
    (lwlc-lens (lwlc-recipe-shape)
        (lwrrn-trial-recipe (lwrrpaw-trial relation))
        (lwrrpaw-evidence)))
(defn lwrrpaw-additional-lens (relation)
    (lwlc-lens (lwlc-cell-shape)
        (lwrro-choice-invariant (lwo-emergent-shape relation))
        (lwrrpaw-evidence)))
(defn lwrrpaw-layers (relation)
    (lwlc-layers (list (lwrrpaw-additional-lens relation))))
(defn lwrrpaw-stack (relation)
    (lwlc-stack (lwrrpaw-default-lens relation)
        (lwrrpaw-layers relation) (lwo-empty-field)
        (lwrrpaw-unknown) (lwrrpaw-evidence)))
(defn lwrrpaw-declaration (parent relation)
    (lwlc-declaration parent (lwrrpaw-stack relation)
        (lwrrpaw-evidence)))
(defn lwrrpaw-timeout ()
    (oac-timeout (intern_trivial_int 10)
        (oac-alternative-ack (lwrrpaw-query-key)
            (lwrrpaw-alternative) (lwrrpaw-evidence))
        (lwrrpaw-evidence)))
(defn lwrrpaw-query (parent relations relation)
    (lwrrpa-query parent relations (lwrrpaw-bindings relation)
        (lwrrpaw-alternatives) (lwrrpaw-unknown)
        (lwrrpaw-declaration parent relation)
        (lwrrpaw-timeout) (lwrrpaw-evidence)))

(defn lwrrpaw-binding-entries (source relation items entries)
    (if (eq (len items) 0) entries
        (do
            (let binding (head items))
            (let name (lwre-binding-name binding))
            (let projection (lwre-binding-projection binding))
            (lwrrpaw-binding-entries source relation (tail items)
                (cons (lwrrpaw-entry source binding)
                    (cons (lwrrpaw-entry source (lwrrpaw-role name))
                        (cons (lwrrpaw-entry source projection)
                            (cons (lwrrpaw-entry source
                                    (lwrrpaw-scope name)) entries))))))))
(defn lwrrpaw-query-entries (source parent relations relation)
    (do
        (let bindings (lwrrpaw-bindings relation))
        (lwrrpaw-binding-entries source relation
            (lwre-binding-items bindings)
            (list
                (lwrrpaw-entry source (lwrrpaw-evidence))
                (lwrrpaw-entry source (lwrrpaw-alternative))
                (lwrrpaw-entry source (lwrrpaw-query-key))
                (lwrrpaw-entry source (lwrrpaw-unknown))
                (lwrrpaw-entry source (lwrrpaw-default-lens relation))
                (lwrrpaw-entry source (lwrrpaw-additional-lens relation))
                (lwrrpaw-entry source (lwrrpaw-layers relation))
                (lwrrpaw-entry source (lwrrpaw-stack relation))
                (lwrrpaw-entry source
                    (lwrrpaw-declaration parent relation))
                (lwrrpaw-entry source (lwrrpaw-timeout))
                (lwrrpaw-entry source bindings)
                (lwrrpaw-entry source
                    (lwrrpaw-query parent relations relation))))))
(defn lwrrpaw-one-source-world (world parent relations relation)
    (lwt-receive-stream world
        (lwrrpaw-query-entries
            (lwrrpaw-source-o) parent relations relation)))
(defn lwrrpaw-two-source-world (world parent relations relation)
    (lwt-receive-stream
        (lwrrpaw-one-source-world world parent relations relation)
        (lwrrpaw-query-entries
            (lwrrpaw-source-p) parent relations relation)))
(defn lwrrpaw-withdraw-query (world query)
    (lwt-receive-stream world
        (list (lwrrpaw-entry (lwrrpaw-source-o)
            (lwo-revocation query (lwrrpaw-source-o)
                (lwrrpaw-reason) (lwrrpaw-evidence))))))

; children: upstream, parent/relation/relations/query, one/two-source views,
; pending/expired answers and proposal, waiting/admitted rounds, separate query
; withdrawal and answer release views, cached authority/currentness bits, events.
(defn lwrrpaw-result
    (upstream parent relation relations query one-world one-answer two-world
     pending-answer expired-answer proposal waiting admitted withdrawn-world
     released-world query-current proposal-current admitted-current recipe-active
     withdrawn-current withdrawn-relation-current released-current
     released-query-current released-relation-current events)
    (intern_node LWRRPAW-RESULT
        (list upstream parent relation relations query one-world one-answer
              two-world pending-answer expired-answer proposal waiting admitted
              withdrawn-world released-world
              (intern_trivial_int query-current)
              (intern_trivial_int proposal-current)
              (intern_trivial_int admitted-current)
              (intern_trivial_int recipe-active)
              (intern_trivial_int withdrawn-current)
              (intern_trivial_int withdrawn-relation-current)
              (intern_trivial_int released-current)
              (intern_trivial_int released-query-current)
              (intern_trivial_int released-relation-current) events)))

(defn lwrrpaw-run ()
    (do
        (let upstream (lwrrow-run))
        (let upstream-children (node_children upstream))
        (let prior (nth upstream-children 0))
        (let parent (nth (node_children prior) 1))
        (let relation (nth upstream-children 4))
        (let relations (lwo-field (list relation)))
        (let admitted-relation-world
            (lwt-round-world (nth upstream-children 11)))
        (let query (lwrrpaw-query parent relations relation))
        (let started
            (lcfb-open-stream "living-world-recipe-tree-relation-answer"
                "form-native" "lwrrpaw-run"
                "fresh-O/P-unresolved-query-to-consented-native-answer"
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                241 10))

        (let one-world
            (lwrrpaw-one-source-world admitted-relation-world
                parent relations relation))
        (let one-answer
            (lwrrpa-answer-for one-world query 2 (intern_trivial_int 5)))
        (let one-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "first-query-offer" "leave" "form-native"
                "lwrrpa-answer-for" "sources:1:answer:nothing" 1 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                258 10))

        (let two-world
            (lwrrpaw-two-source-world admitted-relation-world
                parent relations relation))
        (let query-active (lwrrpa-query-active? two-world query 2))
        (let query-active-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "query-recurrence" "leave" "form-native"
                "lwrrpa-query-active?"
                (lcfb-cat (list "current:" (int_to_str query-active)))
                2 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                268 10))
        (let parent-current-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "query-parent-currentness" "enter" "form-native"
                "lwrrpa-query-parent-current?" "exact-parent" 3 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                276 10))
        (let parent-current
            (if (eq (lcfb-call? parent-current-enter) 1)
                (lwrrpa-query-parent-current? two-world query) 0))
        (let parent-current-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "query-parent-currentness" "leave" "form-native"
                "lwrrpa-query-parent-current?"
                (lcfb-cat (list "current:" (int_to_str parent-current)))
                4 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                285 10))
        (let relations-current-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "query-relation-currentness" "enter" "form-native"
                "lwrrpa-query-relations-current?" "all-exact-relations" 5 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                293 10))
        (let relations-current
            (if (and (eq (lcfb-call? parent-current-frame) 1)
                     (eq (lcfb-call? relations-current-enter) 1))
                (lwrrpa-query-relations-current? two-world query) 0))
        (let relations-current-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "query-relation-currentness" "leave" "form-native"
                "lwrrpa-query-relations-current?"
                (lcfb-cat (list "current:" (int_to_str relations-current)))
                6 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                302 10))
        (let bindings-current
            (lwrrpa-query-bindings-current? two-world query))
        (let declaration-current
            (lwrrpa-query-declaration-current? two-world query))
        (let query-current
            (if (and (eq query-active 1)
                     (and (eq parent-current 1)
                     (and (eq relations-current 1)
                     (and (eq bindings-current 1)
                          (eq declaration-current 1))))) 1 0))
        (let query-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "query-membrane" "leave" "form-native"
                "lwrrpa-query-current?"
                (lcfb-cat (list
                    "sources:"
                    (int_to_str (lwph-active-source-count two-world query))
                    ":bindings:"
                    (int_to_str (len
                        (lwre-binding-items
                            (lwrrpa-query-bindings query))))
                    ":declaration-current:"
                    (int_to_str declaration-current)
                    ":query-current:" (int_to_str query-current)))
                7 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                270 10))

        ; query-current above is the exact immutable two-world/query snapshot.
        ; Compose from that observed snapshot instead of silently repeating the
        ; same expensive currentness traversal for every time/lens view.
        (let pending-answer
            (if (eq (lcfb-call? query-frame) 1)
                (lwrrpa-answer-for-current
                    two-world query 2 (intern_trivial_int 5))
                (lwo-none)))
        (let answer-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "native-composition" "leave" "form-native"
                "lwrrpa-answer-for" (lwrrpa-progress-target pending-answer)
                8 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                287 10))
        (let expired-answer
            (if (eq (lcfb-call? answer-frame) 1)
                (lwrrpa-answer-for-current
                    two-world query 2 (intern_trivial_int 10))
                (lwo-none)))
        (let timeout-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "timeout-observation" "leave" "form-native"
                "oac-timeout-condense"
                (lcfb-cat (list
                    "immediate:"
                    (if (oac-one? (lwrrpa-answer-immediate expired-answer))
                        "ONE" "OTHER")
                    ":time:OUTCOME:alternative:"
                    (int_to_str (oac-alternative-ack?
                        (oac-time-outcome-ack
                            (lwrrpa-answer-time expired-answer))))))
                9 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                296 10))

        (let proposal
            (if (eq (lcfb-call? timeout-frame) 1)
                (lwrrpa-proposal-from-answer pending-answer) (lwo-none)))
        (let candidate (lwt-proposal-candidate proposal))
        (let proposal-current
            (lwrrpa-candidate-current-after-query? two-world candidate))
        (let proposal-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "answer-proposal" "leave" "form-native"
                "lwrrpa-proposal/lwrrpa-candidate-current?"
                (lcfb-cat (list
                    "participants:"
                    (int_to_str (lwo-field-size
                        (lwt-proposal-participants proposal)))
                    ":current:" (int_to_str proposal-current)))
                10 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                312 10))

        (let waiting-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "pre-response" "enter" "form-native" "lwrrpa-integrate"
                "answer-currentness-before-response" 11 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                326 10))
        (let waiting
            (if (and (eq (lcfb-call? proposal-frame) 1)
                     (eq (lcfb-call? waiting-enter) 1))
                (lwrrpa-integrate-after-query-current
                    (lwpow-round-for two-world proposal (lwo-none))
                    proposal (lwphw-action))
                (lwt-round two-world (lwo-empty-field)
                    (lwo-empty-field) (lwo-none))))
        (let waiting-active
            (lwo-active? (lwt-round-world waiting) candidate))
        (let waiting-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "pre-response" "leave" "form-native" "lwrrpa-integrate"
                (lcfb-cat (list "answer-active:"
                    (int_to_str waiting-active) ":state:waiting"))
                12 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                334 10))

        (let responded
            (if (eq (lcfb-call? waiting-frame) 1)
                (lwpow-respond-all two-world proposal) two-world))
        (let response-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "responses" "leave" "form-native" "lwpow-respond-all"
                "all-active-answer-participants:ONE" 13 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                346 10))
        (let admission-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "admission" "enter" "form-native" "lwrrpa-integrate"
                "answer-currentness-and-unanimous-boundary" 14 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                351 10))
        (let admitted
            (if (and (eq (lcfb-call? response-frame) 1)
                     (eq (lcfb-call? admission-enter) 1))
                (lwrrpa-integrate-after-query-current
                    (lwpow-round-for responded proposal waiting)
                    proposal (lwphw-action))
                (lwt-round responded (lwo-empty-field)
                    (lwo-empty-field) waiting)))
        (let admitted-world (lwt-round-world admitted))
        (let admission-integrated-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "admission-integration" "leave" "form-native"
                "lwrrpa-integrate"
                (lcfb-cat (list "answer-active:"
                    (int_to_str (lwo-active? admitted-world candidate))))
                15 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                360 10))
        (let admitted-current-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "admission-currentness" "enter" "form-native"
                "lwrrpa-integrated-current?" "exact-answer-revalidation"
                16 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                369 10))
        (let admitted-current
            (if (and (eq (lcfb-call? admission-integrated-frame) 1)
                     (eq (lcfb-call? admitted-current-enter) 1))
                (if (eq (lwo-active? admitted-world candidate) 0) 0
                    (lwrrpa-candidate-current-after-query?
                        admitted-world candidate)) 0))
        (let admitted-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "admission-currentness" "leave" "form-native"
                "lwrrpa-integrated-current?"
                (lcfb-cat (list
                    "answer-active:"
                    (int_to_str (lwo-active? admitted-world candidate))
                    ":answer-current:" (int_to_str admitted-current)))
                17 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                360 10))

        (let recipe
            (lwrrn-trial-recipe (lwrrpaw-trial relation)))
        (let recipe-active (lwo-active? admitted-world recipe))
        (let authority-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "authority" "leave" "form-native" "lwo-active?"
                (lcfb-cat (list
                    "answer:1:relation:1:recipe:"
                    (int_to_str recipe-active)
                    ":voice:0:promotion:0")) 18 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                375 10))

        ; Branch one: a query holder withdraws.  The admitted answer becomes
        ; stale, but the separately admitted relation remains current.
        (let withdrawn-world
            (if (eq (lcfb-call? authority-frame) 1)
                (lwrrpaw-withdraw-query admitted-world query)
                admitted-world))
        (let withdrawn-current
            (lwrrpa-integrated-current? withdrawn-world candidate))
        (let withdrawn-relation-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "withdrawn-relation-currentness" "enter" "form-native"
                "lwrro-integrated-current?" "query-revocation-locality"
                19 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                425 10))
        (let withdrawn-relation-current
            (if (eq (lcfb-call? withdrawn-relation-enter) 1)
                (lwrro-integrated-current? withdrawn-world relation) 0))
        (let withdrawal-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "query-withdrawal" "leave" "form-native"
                "lwo-revocation/lwrrpa-integrated-current?"
                (lcfb-cat (list
                    "query-sources:"
                    (int_to_str (lwph-active-source-count
                        withdrawn-world query))
                    ":answer-current:"
                    (int_to_str withdrawn-current)
                    ":relation-current:"
                    (int_to_str withdrawn-relation-current)))
                20 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                384 10))

        ; Branch two: release only the exact answer attributions.  Query and
        ; relation remain current and may support a later re-offer.
        (let released-world
            (if (eq (lcfb-call? withdrawal-frame) 1)
                (lwrrow-release-candidate admitted-world candidate)
                admitted-world))
        (let released-current
            (lwrrpa-integrated-current? released-world candidate))
        (let released-query-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "released-query-currentness" "enter" "form-native"
                "lwrrpa-query-current?" "answer-release-locality"
                21 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                450 10))
        (let released-query-current
            (if (eq (lcfb-call? released-query-enter) 1)
                (lwrrpa-query-current? released-world query 2) 0))
        (let released-query-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "released-query-currentness" "leave" "form-native"
                "lwrrpa-query-current?"
                (lcfb-cat (list "current:"
                    (int_to_str released-query-current))) 22 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                460 10))
        (let released-relation-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "released-relation-currentness" "enter" "form-native"
                "lwrro-integrated-current?" "answer-release-locality"
                23 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                468 10))
        (let released-relation-current
            (if (and (eq (lcfb-call? released-query-frame) 1)
                     (eq (lcfb-call? released-relation-enter) 1))
                (lwrro-integrated-current? released-world relation) 0))
        (let release-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-answer"
                "answer-release" "leave" "form-native"
                "exact-answer-attribution-release"
                (lcfb-cat (list
                    "answer-current:" (int_to_str released-current)
                    ":query-current:"
                    (int_to_str released-query-current)
                    ":relation-current:"
                    (int_to_str released-relation-current)))
                24 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-answer-witness.fk"
                404 10))

        (lwrrpaw-result upstream parent relation relations query one-world
            one-answer two-world pending-answer expired-answer proposal waiting
            admitted withdrawn-world released-world query-current proposal-current
            admitted-current recipe-active withdrawn-current
            withdrawn-relation-current released-current released-query-current
            released-relation-current (framebuffer-events))))

; Privacy-safe aggregate: no binding values, outputs, surface text, or offered
; payloads leave the witness.
(defn lwrrpaw-observe ()
    (do
        (let result (lwrrpaw-run))
        (let children (node_children result))
        (let query (nth children 4))
        (let pending-answer (nth children 8))
        (let expired-answer (nth children 9))
        (let proposal (nth children 10))
        (let waiting (nth children 11))
        (let admitted (nth children 12))
        (list
            (lwrrpa-query-valid? query)
            (lwph-active-source-count (nth children 7) query)
            (len (lwre-binding-items (lwrrpa-query-bindings query)))
            (node_value (nth children 15))
            (node_eq (nth children 6) (lwo-none))
            (lwo-field-size
                (lwrrpa-answer-derivations pending-answer))
            (lwo-field-size (lwrrpa-answer-outputs pending-answer))
            (oac-one? (lwrrpa-answer-immediate pending-answer))
            (oac-time-pending? (lwrrpa-answer-time pending-answer))
            (oac-one? (lwrrpa-answer-immediate expired-answer))
            (oac-time-outcome? (lwrrpa-answer-time expired-answer))
            (oac-alternative-ack?
                (oac-time-outcome-ack
                    (lwrrpa-answer-time expired-answer)))
            (lwo-field-size (lwt-proposal-participants proposal))
            (node_value (nth children 16))
            (lwo-active? (lwt-round-world waiting)
                (lwt-proposal-candidate proposal))
            (lwo-active? (lwt-round-world admitted)
                (lwt-proposal-candidate proposal))
            (node_value (nth children 17))
            (node_value (nth children 18))
            (node_value (nth children 19))
            (node_value (nth children 20))
            (node_value (nth children 21))
            (node_value (nth children 22))
            (node_value (nth children 23))
            (len (nth children 24)))))

0
