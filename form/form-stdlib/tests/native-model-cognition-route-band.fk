; native-model-cognition-route-band.fk — the witnessed native cognition
; response shape directly controls whether Qwen may be selected.
;
; preludes: form-stdlib/core.fk form-stdlib/native-model-glass.bml
;
; Verdict 31.

(do
    (let base (nmg-begin-native (nmg-initial)))
    (let native-response (list (nothing) 0 1 9001 42 0 0))
    (let evidence-response (list (nothing) 0 1 9002 (nothing) 4 1))
    (let malformed-response (list 0 1 2))
    (let native (nmg-finish-native-response base native-response))
    (let evidence (nmg-finish-native-response base evidence-response))
    (let malformed (nmg-finish-native-response base malformed-response))
    (let c0 (if (str_eq (nmg-native-response-outcome native-response) "answer") 1 0))
    (let c1 (if (str_eq (nmg-route native) (NMGNative)) 2 0))
    (let c2 (if (str_eq (nmg-native-response-outcome evidence-response) "request-evidence") 4 0))
    (let selected (nmg-find (NMGQwen) (nmg-models evidence)))
    (let c3 (if (and (str_eq (nmg-route evidence) (NMGQwen))
                     (and (eq (nmg-loaded? selected) 0)
                          (eq (nmg-active? selected) 0))) 8 0))
    (let c4 (if (and (str_eq (nmg-native-response-outcome malformed-response) "invalid-response")
                     (str_eq (nmg-route malformed) "none")) 16 0))
    (sum (list c0 c1 c2 c3 c4)))
