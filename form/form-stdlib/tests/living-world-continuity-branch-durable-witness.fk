; Durable helpers for branch-scoped continuity across fresh fkwu processes.
; witnessed: 2026-08-08 -> 32767/65535 across two fresh fkwu processes
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-continuity-branch.fk form-stdlib/tests/living-world-continuity-branch-witness.fk

(defn lwcbwd-path ()
    "/tmp/coherence-living-world-continuity-branch-v1.ccs")

(defn lwcbwd-remove (path)
    (if (eq (fs-exists? path) 1) (fs-remove-file path) 0))

(defn lwcbwd-clean ()
    (do
        (lwcbwd-remove (lwcbwd-path))
        (lwcbwd-remove (lwcd-pending-path (lwcbwd-path)))))

(defn lwcbwd-branch-a (image)
    (lwcb-branch image (lwcbw-capability-a)
        (lwo-none) (lwo-none) (lwo-empty-field) (lwo-none)))

(defn lwcbwd-branch-b (image)
    (lwcb-branch image (lwcbw-capability-b)
        (lwcbw-declaration-b) (lwcbw-lens-b)
        (lwo-field (list (lwcbw-alternative-b)))
        (lwcbw-unknown-b)))

(defn lwcbwd-admission (branch-a branch-b)
    (lwt-receive-stream (lwo-empty-world)
        (list
            (lwcbw-entry (lwcbw-custodian) (lwcbw-provenance-c) branch-a)
            (lwcbw-entry (lwcbw-custodian) (lwcbw-provenance-c) branch-b))))

(defn lwcbwd-round (world proposal-a proposal-b)
    (lwt-round world
        (lwo-field (list proposal-a proposal-b))
        (lwo-empty-field) (lwo-none)))
