// Only an explicit JSON boolean asks for interactive GPU scheduling.
// No model, GPU, or ledger is opened by this boundary observation.
// Expected: 63
// Verdict 63
import form/form-stdlib/bml/form-cli-native-voice.bml;
section [form.bml] {
 class NativeVoiceIntentBand {
 def nvi-request(value) = json-node-object([json-node-pair("interactive",value)]);
 def nvi-observe() =
  (!fcnv-interactive?(json-node-object([])) ? 1 : 0) +
  (!fcnv-interactive?(nvi-request(json-node-bool(false))) ? 2 : 0) +
  (!fcnv-interactive?(nvi-request(json-node-int(1))) ? 4 : 0) +
  (!fcnv-interactive?(nvi-request(json-node-string("true"))) ? 8 : 0) +
  (!fcnv-interactive?(nvi-request(json-node-null())) ? 16 : 0) +
  (fcnv-interactive?(nvi-request(json-node-bool(true))) ? 32 : 0);
 }
 let verdict=nvi-observe();
 print(["native-voice-intent",verdict]);
 verdict == 63 ? verdict : form_error("native voice intent must be explicit JSON true");
}
