; First process: seal the two-holder image without activating either branch.
; Verdict 32767 proves fifteen image, scope, carrier, and optionality bits.
; witnessed: 2026-08-08 -> 32767 on a fresh direct-source fkwu process
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-continuity-branch.fk form-stdlib/tests/living-world-continuity-branch-witness.fk form-stdlib/tests/living-world-continuity-branch-durable-witness.fk

(do
    (lwcbwd-clean)
    (let image (lwcbw-image))
    (let branch-a (lwcbwd-branch-a image))
    (let branch-b (lwcbwd-branch-b image))
    (let saved (lwcd-save-new (lwcbwd-path) image (lwo-none)))
    (lwcbw-sum
        (list
            (if (eq (lwcn-image-valid? image) 1) 1 0)
            (if (eq (lwcb-branch-valid? branch-a) 1) 2 0)
            (if (eq (lwcb-branch-valid? branch-b) 1) 4 0)
            (if (eq (lwo-field-size
                        (lwcn-active-sources (lwcn-image-world image))) 2)
                8 0)
            (if (eq (lwo-field-size
                        (lwcb-branch-participants branch-a)) 1) 16 0)
            (if (eq (lwo-field-size
                        (lwcb-branch-participants branch-b)) 1) 32 0)
            (if (eq (ccs-supported? image) 1) 64 0)
            (if (eq (lwcd-saved? saved) 1) 128 0)
            (if (eq (fs-exists? (lwcbwd-path)) 1) 256 0)
            (if (eq (fs-exists?
                        (lwcd-pending-path (lwcbwd-path))) 0) 512 0)
            (if (node_eq (lwcd-result-image saved) image) 1024 0)
            (if (node_eq (lwcd-result-evidence saved) (lwo-none)) 2048 0)
            (if (node_eq (lwcd-result-alternatives saved)
                         (lwo-none)) 4096 0)
            (if (node_eq (lwcd-result-unknowable saved)
                         (lwo-none)) 8192 0)
            (if (gt (str_len (fs-read-text (lwcbwd-path))) 0) 16384 0))))
