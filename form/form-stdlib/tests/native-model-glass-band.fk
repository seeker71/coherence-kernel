; native-model-glass-band.fk — route ordering, honest residency, and
; framebuffer projection for the native model glass.
;
; preludes: form-stdlib/core.fk form-stdlib/native-model-glass.bml
;
; Verdict 16383: 8191 executable + 8192 high-BML authority.

(do
    (defn nmgb-has (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let s0 (nmg-initial))
    (let s1 (nmg-begin-routed-input s0 "nl" "nl-form" 0))
    (let s2 (nmg-finish-ingress s1 1 17))
    (let s3 (nmg-begin-native s2))
    (let native-answer (nmg-finish-native s3 "answer"))
    (let fallback-selected (nmg-finish-native s3 "request-evidence"))
    (let q0 (nmg-qwen-loading fallback-selected))
    (let q1 (nmg-qwen-loaded q0))
    (let q2 (nmg-qwen-prefilling q1 0))
    (let q3 (nmg-qwen-reasoning q2 105000))
    (let q4 (nmg-qwen-finished q3 105032))
    (let rejected (nmg-finish-ingress s1 0 9))
    (let c0 (if (eq (nmg-session-valid? s0) 1) 1 0))
    (let c1 (if (str_eq (nmg-active-id s1) (NMGThreeB)) 2 0))
    (let threeb (nmg-find (NMGThreeB) (nmg-models s2)))
    (let c2 (if (and (eq (nmg-loaded? threeb) 1) (and (eq (nmg-prefilled? threeb) 1) (eq (nmg-active? threeb) 0))) 4 0))
    (let c3 (if (str_eq (nmg-active-id s3) (NMGNative)) 8 0))
    (let native-qwen (nmg-find (NMGQwen) (nmg-models native-answer)))
    (let c4 (if (and (str_eq (nmg-route native-answer) (NMGNative)) (eq (nmg-loaded? native-qwen) 0)) 16 0))
    (let selected-qwen (nmg-find (NMGQwen) (nmg-models fallback-selected)))
    (let c5 (if (and (str_eq (nmg-route fallback-selected) (NMGQwen)) (and (eq (nmg-loaded? selected-qwen) 0) (eq (nmg-active? selected-qwen) 0))) 32 0))
    (let qreason (nmg-find (NMGQwen) (nmg-models q3)))
    (let c6 (if (and (eq (nmg-loaded? qreason) 1) (and (eq (nmg-prefilled? qreason) 1) (eq (nmg-active? qreason) 1))) 64 0))
    (let qdone (nmg-find (NMGQwen) (nmg-models q4)))
    (let c7 (if (and (eq (nmg-session-valid? q4) 1) (and (eq (nmg-active? qdone) 0) (str_eq (nmg-phase qdone) "resident"))) 128 0))
    (let c8 (if (str_eq (nmg-decision rejected) "native-deterministic-translation-repair") 256 0))
    (framebuffer-clear)
    (let frame (nmg-glass-write q3))
    (let c9 (if (and (eq (len (nth frame 2)) 3) (eq (len (framebuffer-events)) 3)) 512 0))
    (let rendered (nmg-render q3))
    (let c10 (if (and (eq (nmgb-has rendered "loaded=1 prefilled=1 active=1") 1) (eq (nmgb-has rendered "selected=challenger.qwen38-flash-next-q2-metal") 1)) 1024 0))
    (let known (nmg-begin-routed-input s0 "nl" "nl-form" 1))
    (let reasoning (nmg-begin-routed-input s0 "nl" "reason" 0))
    (let c11 (if (and (str_eq (nmg-active-id known) (NMGNative)) (str_eq (nmg-active-id reasoning) (NMGNative))) 2048 0))
    (framebuffer-clear)
    (let refused (nmg-glass-write-physical q3 (NMGQwen) 0 "fabricated-handle"))
    (let c12 (if (and (str_eq (nth refused 0) "native-model-carrier-refused") (eq (len (framebuffer-events)) 0)) 4096 0))
    (let base (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12)))
    (let authority-src (read_file "form/form-stdlib/bml/native-model-glass.bml"))
    (let authority
        (if (eq (nmgb-has authority-src "const String LoadedRule = \"artifact presence never implies loaded\"") 1)
            (if (eq (nmgb-has authority-src "const String RouteRule = \"known Form grammar -> native; unknown NL-to-Form -> 3B proposal then native; reasoning -> native; Qwen only after explicit native inability\"") 1)
                (if (eq (nmgb-has authority-src "const String PrivacyRule = \"frames contain ids,state,counters,reasons; never prompt or answer bytes\"") 1)
                    (if (eq (nmgb-has authority-src "const String PhysicalRule = \"physical frames require a positive live carrier handle; release requires the same prior handle and a successful close return\"") 1)
                        (if (eq (nmgb-has authority-src "const String ReplayRule = \"route rehearsals never emit FORM-MODEL-CARRIER-V1\"") 1)
                            (if (and (eq (nmgb-has authority-src "LifecycleRule") 1)
                                     (eq (nmgb-has (read_file "form/form-stdlib/native-model-glass.bml") "\"warm\"") 0)) 8192 0) 0) 0) 0) 0) 0))
    (add base authority))
