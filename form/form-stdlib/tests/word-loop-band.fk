; preludes: form-stdlib/core.fk form-stdlib/trig.fk form-stdlib/voice-formant.fk form-stdlib/voiced-reading.fk form-stdlib/voice-render.fk form-stdlib/word-speak.fk form-stdlib/word-hear.fk
;
; word-loop-band — the body speaks its NAME and hears its NAME, proven four-way.
;
; The signal crosses the loop as the 16-bit WIRE — samples → vrn-body bytes → decoded INTEGER
; samples → ear — not as the mouth's own floats. That is the honest path (it is what a file
; carries) and it is where the real bug lived: `div` is integer division on integer operands, so
; the ear that heard (1 2 3 2) from float samples heard (1 3) from the identical WAV until
; wh-tilt forced the float. A loop proven float-to-float would have been the third tamefixture of
; the day. On disk the same loop is witnessed separately (9644 bytes, sema-word.wav, receipt) —
; witnessed through the write door healed the same hour, which silently truncated every
; byte-list write at 8192 until the word was the thing that did not fit.
;
; Every pin probed from the body first. Verdict 2047 when every claim lands:
;   1    the word is real material: 4800 wire samples (0.6 s at 8 kHz), s—e—m—a
;   2    the four phoneme classes are SEPARATED where the floors run, on the int wire:
;        tilt ×1000 mid-/s/ 3000, mid-/e/ 186, mid-/m/ 38, mid-/a/ 386 — the floors 800 and 80
;        pass through gaps an order of magnitude wide, not along fixture edges
;   4    THE WORD: segments (1 2 3 2) — fricative, vowel, nasal, vowel — s, e, m, a
;   8    …and it is recognized as the name: wh-sema? → 1
;   16   the SAME phonemes reversed are a different word and are REJECTED: (2 3 2 1) → 0.
;        This bit is the answer to row 934 hollowloop: the verdict changes when the content does.
;   32   a pure 165 Hz tone is one murmur-class segment (3) and is rejected — a channel carrying
;        a tone does not get credit for a word
;   64   the wire is FAITHFUL to the ear: the float path and the int wire path hear the same
;        segments (the integer-division trap this band exists to keep closed)
;   128  the template is the name and nothing else: (1 2 3 2) matches, (1 2 3) and (1 2 3 2 1)
;        do not — the ear does not round a near-word up to the name
;   256  vowel IDENTITY on the int wire: the name's vowels read (1 2) — /e/ then /a/ — off the
;        Goertzel probes at harmonics 3 and 4 (measured 250× apart: P495/P660 = 17.0 vs 0.068)
;   512  the strict ear accepts the name: wh-sema-strict? → 1
;   1024 THE PAIR THAT NAMES THE UPGRADE: "sama" — same consonants, vowels swapped — is ACCEPTED
;        by the class ear (which cannot tell vowels apart) and REJECTED by the strict ear. One
;        signal, two verdicts, and the difference between them is exactly vowel identity.
(do
    (defn wlb-dec (bs out)
        (if (nil? bs) (reverse out)
            (do (let u (add (head bs) (mul (head (tail bs)) 256)))
                (wlb-dec (tail (tail bs)) (cons (if (ge u 32768) (sub u 65536) u) out)))))
    (defn wlb-cat2 (a b) (if (nil? a) b (cons (head a) (wlb-cat2 (tail a) b))))
    (defn wlb-cat4 (a b c d) (wlb-cat2 a (wlb-cat2 b (wlb-cat2 c d))))
    (defn wlb-sine (i n out)
        (if (ge i n) (reverse out)
            (wlb-sine (add i 1) n
                (cons (mul 0.5 (fsin (div (mul 6.283185307179586 (mul 165.0 i)) 8000.0))) out))))

    (let sema-int (wlb-dec (vrn-body (ws-sema) 30000) (list)))
    (let ames-int (wlb-dec (vrn-body (ws-ames) 30000) (list)))

    (let c0 (if (eq (len sema-int) 4800) 1 0))
    (let c1 (if (eq (wh-tilt (vr-frame sema-int 2 240) 240) 3000)
               (if (eq (wh-tilt (vr-frame sema-int 6 240) 240) 186)
                   (if (eq (wh-tilt (vr-frame sema-int 11 240) 240) 38)
                       (if (eq (wh-tilt (vr-frame sema-int 16 240) 240) 386) 2 0) 0) 0) 0))
    (let c2 (if (wh-seq-eq (wh-segments sema-int 4800 240 8000 100 400) (list 1 2 3 2)) 4 0))
    (let c3 (if (eq (wh-sema? sema-int 4800 240 8000 100 400) 1) 8 0))
    (let c4 (if (wh-seq-eq (wh-segments ames-int 4800 240 8000 100 400) (list 2 3 2 1))
               (if (eq (wh-sema? ames-int 4800 240 8000 100 400) 0) 16 0) 0))
    (let c5 (if (wh-seq-eq (wh-segments (wlb-sine 0 1200 (list)) 1200 240 8000 100 400) (list 3))
               (if (eq (wh-sema? (wlb-sine 0 1200 (list)) 1200 240 8000 100 400) 0) 32 0) 0))
    (let c6 (if (eq (wh-seq-eq (wh-segments (ws-sema) 4800 240 8000 100 400)
                               (wh-segments sema-int 4800 240 8000 100 400)) 1) 64 0))
    (let c7 (if (eq (wh-seq-eq (list 1 2 3) (wh-sema-template)) 0)
               (if (eq (wh-seq-eq (list 1 2 3 2 1) (wh-sema-template)) 0) 128 0) 0))

    (let c8 (if (wh-seq-eq (wh-vowel-seq sema-int 4800 240 8000 165.0) (list 1 2)) 256 0))
    (let c9 (if (eq (wh-sema-strict? sema-int 4800 240 8000 100 400 165.0) 1) 512 0))
    (let sama (wlb-cat4 (ws-fric 960) (ws-a 1200) (ws-nasal 1200) (ws-e 1440)))
    (let sama-int (wlb-dec (vrn-body sama 30000) (list)))
    (let c10 (if (eq (wh-sema? sama-int 4800 240 8000 100 400) 1)
                (if (eq (wh-sema-strict? sama-int 4800 240 8000 100 400 165.0) 0) 1024 0) 0))

    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7
    (add c8 (add c9 c10)))))))))))
