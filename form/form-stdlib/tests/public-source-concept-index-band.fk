; public-source-concept-index-band.fk -- content-addressed concept lookup over
; two live public sources from each of the repository's fifteen source families.
;
; The lookup cases carry only (concept-key expected-family): no source path is
; supplied to psci-lookup-at.  The returned path is an observation, not an
; input.  This proves a 30-source sample and its live denominator; it does not
; claim repository-wide or model-weight integration.
;
; PROOF LEVEL: FOURTH-ARM ONLY (host filesystem + bounded source SHA-256; go/rust/ts die on a null before the fold — witnessed 2026-09-03)
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-fs.fk form-stdlib/file-byte-window.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/form-knowledge-source-search.fk form-stdlib/public-source-concept-index.fk
;
; Verdict 33554431.

(do
    (defn pscib-bit (ok bit) (if ok bit 0))
    (defn pscib-repeat (s n)
        (if (le n 0) "" (str_concat s (pscib-repeat s (sub n 1)))))
    (defn pscib-fake-id ()
        (str_concat "sha256:" (pscib-repeat "0" 64)))

    ; No case contains a path.  Every family has two distinct concept keys.
    (defn pscib-cases ()
        (list
            (list "axiom-nothing-whole" "axioms")
            (list "axiom-host-resources" "axioms")
            (list "bootstrap-direct-source" "bootstrap")
            (list "bootstrap-recursion" "bootstrap")
            (list "form-core-primitives" "form-stdlib")
            (list "form-query-token" "form-stdlib")
            (list "grammar-loader-bmf" "grammars")
            (list "grammar-source-eval" "grammars")
            (list "cognition-frequency-sense" "cognition")
            (list "cognition-dialogue-covenant" "cognition")
            (list "learn-homecoming-distillation" "learn")
            (list "learn-multistep-reasoning" "learn")
            (list "observe-preflight-verdict" "observe")
            (list "observe-belief-freshness" "observe")
            (list "teaching-uplifting-dialogue" "teachings")
            (list "teaching-trust-over-fear" "teachings")
            (list "receipt-share-computed" "receipts")
            (list "receipt-jit-closure-parity" "receipts")
            (list "model-neutral-token-space" "model")
            (list "model-language-world" "model")
            (list "proof-four-way-recipe" "proof")
            (list "proof-recipe-forty-two" "proof")
            (list "control-choice-lane" "control")
            (list "control-recording-lifecycle" "control")
            (list "ingest-name-build-observe" "ingest")
            (list "ingest-satsang-transmute" "ingest")
            (list "presence-inquiry-planes" "presence")
            (list "presence-device-identity" "presence")
            (list "docs-reasoning-homecoming" "docs")
            (list "docs-dynamic-diagnostics" "docs")))

    (defn pscib-all-cases-hit? (root index cases)
        (if (nil? cases) 1
            (do
                (let case (head cases))
                ; Only the concept key crosses into the lookup.
                (let result (psci-lookup-at root index (nth case 0)))
                (if (and
                        (str_eq (psci-result-status result) "hit")
                    (and
                        (str_eq (psci-result-family result) (nth case 1))
                    (and
                        (gt (str_len (psci-result-path result)) 0)
                    (and
                        (eq (psci-result-fresh? result) 1)
                        (eq (psci-result-rebuild-needed? result) 0)))))
                    (pscib-all-cases-hit? root index (tail cases)) 0))))
    (defn pscib-case-family-count (cases family)
        (if (nil? cases) 0
            (add (if (str_eq (nth (head cases) 1) family) 1 0)
                 (pscib-case-family-count (tail cases) family))))
    (defn pscib-each-family-two-cases? (families cases)
        (if (nil? families) 1
            (if (eq (pscib-case-family-count cases
                        (psci-family-id (head families))) 2)
                (pscib-each-family-two-cases? (tail families) cases) 0)))
    (defn pscib-family-rows-current? (rows)
        (if (nil? rows) 1
            (if (and (eq (nth (head rows) 2) 2)
                (and (eq (nth (head rows) 3) 2)
                     (ge (nth (head rows) 4) 2)))
                (pscib-family-rows-current? (tail rows)) 0)))

    (defn public-source-concept-index-band ()
        (do
            (let root ".")
            (let index (psci-public-sample-index-at root))
            (let cases (pscib-cases))
            (let coverage (psci-coverage-at root index))

            ; Content address and incremental idempotence.
            (let direct-a (psci-register-at root "bootstrap" "bootstrap/ground.fk"
                (list "incremental-ground")))
            (let direct-b (psci-register-at root "bootstrap" "bootstrap/ground.fk"
                (list "incremental-ground")))
            (let one-index (psci-add-entry (psci-index-empty) direct-a))
            (let same-index (psci-add-entry one-index direct-b))

            ; A held digest may age.  Lookup refuses it, and rebuilding replaces
            ; the same coordinate instead of growing a duplicate source row.
            (let stale (psci-entry-from-observed "bootstrap" "bootstrap/ground.fk"
                (pscib-fake-id) (fs-stat-size "bootstrap/ground.fk")
                (list "stale-ground")))
            (let stale-index (psci-add-entry (psci-index-empty) stale))
            (let stale-result (psci-lookup-at root stale-index "stale-ground"))
            (let rebuilt-index
                (psci-rebuild-index-entry-at root stale-index stale))
            (let rebuilt-result (psci-lookup-at root rebuilt-index "stale-ground"))

            (let unavailable (psci-entry-from-observed "bootstrap"
                "bootstrap/not-present-public-source.fk" (pscib-fake-id) 1
                (list "unavailable-ground")))
            (let unavailable-result (psci-lookup-at root
                (psci-add-entry (psci-index-empty) unavailable)
                "unavailable-ground"))

            ; Ambiguity is observation, never an arbitrary first-source choice.
            (let shared-a (psci-register-at root "bootstrap" "bootstrap/ground.fk"
                (list "shared-concept")))
            (let shared-b (psci-register-at root "bootstrap"
                "bootstrap/ground-recursive.fk" (list "shared-concept")))
            (let shared-index (psci-add-entry
                (psci-add-entry (psci-index-empty) shared-a) shared-b))
            (let shared-result (psci-lookup-at root shared-index "shared-concept"))

            ; Exact valid zero and one concept coordinates stay hits and never
            ; collapse into the `nothing` result used by unknown coordinates.
            (let zero-entry (psci-register-at root "bootstrap" "bootstrap/ground.fk"
                (list "zero")))
            (let one-entry (psci-register-at root "bootstrap"
                "bootstrap/ground-recursive.fk" (list "one")))
            (let numeric-index (psci-add-entry
                (psci-add-entry (psci-index-empty) zero-entry) one-entry))
            (let zero-result (psci-lookup-at root numeric-index "zero"))
            (let one-result (psci-lookup-at root numeric-index "one"))

            (let first-result (psci-lookup-at root index "form-query-token"))
            (let first-again (psci-lookup-at root index "form-query-token"))
            (let unknown (psci-lookup-at root index "unknown-public-concept"))
            (let empty-key (psci-lookup-at root index ""))
            (let uppercase-key (psci-lookup-at root index "Not-Canonical"))
            (let long-key (psci-lookup-at root index (pscib-repeat "x" 65)))
            (let malformed (psci-entry-from-observed "bootstrap"
                "bootstrap/ground.fk" "sha256:0" 1 (list "malformed")))
            (let score (sum (list
                (pscib-bit (and (eq (psci-index-valid? index) 1)
                                (eq (len (psci-index-entries index)) 30)) 1)
                (pscib-bit (node_eq direct-a direct-b) 2)
                (pscib-bit (and (not (node_eq (psci-index-empty) one-index))
                                (node_eq one-index same-index)) 4)
                (pscib-bit (eq (pscib-all-cases-hit? root index cases) 1) 8)
                (pscib-bit (and (eq (len cases) 30)
                    (eq (pscib-each-family-two-cases? (psci-families) cases) 1)) 16)
                (pscib-bit (and (eq (psci-coverage-family-count coverage) 15)
                    (eq (psci-coverage-families-at-least-two coverage) 15)) 32)
                (pscib-bit (and (eq (psci-coverage-registered coverage) 30)
                    (eq (psci-coverage-index-integrated coverage) 30)) 64)
                (pscib-bit (gt (psci-coverage-repository coverage) 30) 128)
                (pscib-bit (and (lt (psci-coverage-registered-percent coverage) 95)
                    (lt (psci-coverage-index-integrated-percent coverage) 95)) 256)
                (pscib-bit (and (eq (psci-coverage-model-integrated coverage) 0)
                    (eq (psci-coverage-model-integrated-percent coverage) 0)) 512)
                (pscib-bit (eq (psci-coverage-concept-keys coverage) 33) 1024)
                (pscib-bit (eq (pscib-family-rows-current?
                    (psci-coverage-family-rows coverage)) 1) 2048)
                (pscib-bit (and (str_eq (psci-result-status unknown) "nothing")
                    (str_eq (psci-result-reason unknown) "concept-not-registered")) 4096)
                (pscib-bit (and (str_eq (psci-result-status empty-key) "nothing")
                    (and (str_eq (psci-result-status uppercase-key) "nothing")
                         (str_eq (psci-result-status long-key) "nothing"))) 8192)
                (pscib-bit (and (str_eq (psci-result-status stale-result) "nothing")
                    (and (str_eq (psci-result-reason stale-result)
                            "source-rebuild-needed")
                         (eq (psci-result-rebuild-needed? stale-result) 1))) 16384)
                (pscib-bit (and (str_eq (psci-result-status rebuilt-result) "hit")
                    (and (eq (len (psci-index-entries rebuilt-index)) 1)
                         (eq (psci-result-fresh? rebuilt-result) 1))) 32768)
                (pscib-bit (and (str_eq (psci-result-status unavailable-result) "nothing")
                    (and (str_eq (psci-result-reason unavailable-result)
                            "source-unavailable")
                         (eq (psci-result-rebuild-needed? unavailable-result) 1))) 65536)
                (pscib-bit (and (str_eq (psci-result-status shared-result) "nothing")
                    (and (str_eq (psci-result-reason shared-result)
                            "ambiguous-concept-key")
                         (eq (psci-result-match-count shared-result) 2))) 131072)
                (pscib-bit (and (str_eq (psci-result-status zero-result) "hit")
                    (and (str_eq (psci-result-status one-result) "hit")
                         (not (str_eq (psci-result-path zero-result)
                                     (psci-result-path one-result))))) 262144)
                (pscib-bit (and (eq (psci-source-id-valid?
                        (psci-result-held-id first-result)) 1)
                    (node_eq (psci-result-held-source first-result)
                             (psci-result-current-source first-result))) 524288)
                (pscib-bit (node_eq (psci-result-observation first-result)
                                    (psci-result-observation first-again)) 1048576)
                (pscib-bit (and (eq (psci-result-lookup-count first-result) 1)
                    (and (eq (psci-result-hit-count first-result) 1)
                         (eq (psci-result-model-executed? first-result) 0))) 2097152)
                (pscib-bit (nothing? malformed) 4194304)
                (pscib-bit (and (eq (psci-path-valid-for-family?
                        "../bootstrap/ground.fk" "bootstrap") 0)
                    (eq (psci-path-valid-for-family?
                        "bootstrap/ground.fk" "docs") 0)) 8388608)
                (pscib-bit (not (node_eq (psci-absent-node)
                                         (psci-result-held-source first-result))) 16777216))))
            score))
    (public-source-concept-index-band))
