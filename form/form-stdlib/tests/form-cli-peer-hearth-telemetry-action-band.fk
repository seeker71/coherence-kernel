; form-cli-peer-hearth-telemetry-action-band.fk -- caller-born monitor
; topology is a Form answer floor, not a hidden model request.
;
; Expected: 127
; preludes: form-stdlib/bml/form-cli-peer-hearth-telemetry-action.bml

(do
    (defn fcphtab-bit (held weight) (if held weight 0))
    (defn form-cli-peer-hearth-telemetry-action-band ()
        (do
            (let session (list "non-model-sentinel" 73))
            (let value (fcphta-run session "hearth-telemetry" "show topology"))
            (let peer (fcphta-peer value))
            (let wrong-kind (fcphta-run session "direct-answer" "show topology"))
            (let absent-text (fcphta-run session "hearth-telemetry" (nothing)))
            (sum (list
                (fcphtab-bit (and (eq (fcphta-result? value) 1)
                    (and (str_eq (fcphta-signal value) "value")
                         (value_eq (fcphta-session value) session))) 1)
                (fcphtab-bit (and (ge (str_find (fcphta-response-of value)
                        "route: caller-born hearth-telemetry" 0) 0)
                    (and (ge (str_find (fcphta-response-of value)
                        "task bytes choose neither a root nor a model session." 0) 0)
                    (and (ge (str_find (fcphta-response-of value)
                        "the glass projects them as live flight data." 0) 0)
                    (and (ge (str_find (fcphta-response-of value)
                        "durable result:" 0) 0)
                         (ge (str_find (fcphta-response-of value)
                            "next stone:" 0) 0))))) 2)
                (fcphtab-bit (and (str_eq (fcpa-route peer) "hearth-telemetry")
                    (and (value_eq (fcpa-session peer) session)
                    (and (eq (fcpa-callback-calls peer) 0)
                    (and (eq (fcpa-lookup-count peer) 0)
                    (and (eq (fcpa-injected-bytes peer) 0)
                    (and (eq (fcpa-native-code-generated? peer) 0)
                    (and (eq (fcpa-value-present? peer) 0)
                         (str_eq (fcpa-carrier peer) "form-native-hearth")))))))) 4)
                (fcphtab-bit (and (str_eq (fcphta-signal wrong-kind) "choice")
                    (and (str_eq (fcphta-reason wrong-kind)
                        "hearth-telemetry-requires-hearth-telemetry-task")
                         (value_eq (fcphta-session wrong-kind) session))) 8)
                (fcphtab-bit (and (str_eq (fcphta-signal absent-text) "choice")
                    (and (str_eq (fcphta-reason absent-text)
                        "hearth-telemetry-requires-nonempty-task")
                         (value_eq (fcphta-session absent-text) session))) 16)
                (fcphtab-bit (str_eq (fcpa-tool-status peer)
                    "value;model=0;lookup=0;event-stream=1") 32)
                (fcphtab-bit (str_eq (fcpa-lifecycle peer) "observe,release") 64)))))
    (form-cli-peer-hearth-telemetry-action-band))
