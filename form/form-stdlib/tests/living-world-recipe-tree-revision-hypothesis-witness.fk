; living-world-recipe-tree-revision-hypothesis-witness.fk -- scoped I/J
; reoffers cannot perturb the historical C/D nursery.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/living-world-recipe-tree-revision-trial.fk form-stdlib/living-world-recipe-tree-revision-hypothesis.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-witness.fk

(let LWRTRHW-SOURCE-I (bp "LWRTRHW-SOURCE-I"))
(let LWRTRHW-SOURCE-J (bp "LWRTRHW-SOURCE-J"))
(let LWRTRHW-EVIDENCE (bp "LWRTRHW-EVIDENCE"))
(let LWRTRHW-REASON   (bp "LWRTRHW-REASON"))
(let LWRTRHW-RESULT   (bp "LWRTRHW-RESULT"))

(defn lwrtrhw-cell (kind) (intern_node kind (empty)))
(defn lwrtrhw-source-i () (lwrtrhw-cell LWRTRHW-SOURCE-I))
(defn lwrtrhw-source-j () (lwrtrhw-cell LWRTRHW-SOURCE-J))
(defn lwrtrhw-evidence () (lwrtrhw-cell LWRTRHW-EVIDENCE))
(defn lwrtrhw-reason () (lwrtrhw-cell LWRTRHW-REASON))
(defn lwrtrhw-entry (source payload)
    (lwphw-entry source (lwrtrhw-evidence) payload))
(defn lwrtrhw-offer (composition-candidate composition)
    (do
        (let blueprint (lwrtr-composition-blueprint composition))
        (lwrtrt-offer composition-candidate composition
            (lwrtr-composition-recipe composition)
            (lwrtr-blueprint-declaration blueprint)
            (lwrtr-blueprint-lens blueprint)
            (lwrtr-blueprint-alternatives blueprint)
            (lwrtr-blueprint-unknown blueprint)
            (lwrtr-blueprint-choice blueprint)
            (lwrtr-blueprint-timeout blueprint)
            (lwrtrhw-evidence))))
(defn lwrtrhw-one-world (world offer)
    (lwt-receive-stream world
        (list (lwrtrhw-entry (lwrtrhw-source-i) offer))))
(defn lwrtrhw-two-world (world offer)
    (lwt-receive-stream (lwrtrhw-one-world world offer)
        (list (lwrtrhw-entry (lwrtrhw-source-j) offer))))
(defn lwrtrhw-revoke-first (world offer)
    (lwt-receive-stream world
        (list
            (lwrtrhw-entry (lwrtrhw-source-i)
                (lwo-revocation offer (lwrtrhw-source-i)
                    (lwrtrhw-reason) (lwrtrhw-evidence))))))

; children: upstream, exact parent/composition/Recipe, scoped offer/trial
; membrane, successor membrane, revocation views, cached bits, events.
(defn lwrtrhw-result
    (upstream composition-candidate composition recipe base-world offer
     one-world one-field two-world trial-field trial-proposal trial-waiting
     trial-admitted trial-candidate successor-field match successor-proposal
     successor-waiting successor-admitted successor-candidate revoked-world
     revoked-trial-field revoked-successor-field composition-after-offers
     trial-current admitted-successor-current revoked-trial-current
     revoked-successor-current revoked-composition-current events)
    (intern_node LWRTRHW-RESULT
        (list upstream composition-candidate composition recipe base-world offer
              one-world one-field two-world trial-field trial-proposal
              trial-waiting trial-admitted trial-candidate successor-field match
              successor-proposal successor-waiting successor-admitted
              successor-candidate revoked-world revoked-trial-field
              revoked-successor-field composition-after-offers trial-current
              admitted-successor-current revoked-trial-current
              revoked-successor-current revoked-composition-current events)))

(defn lwrtrhw-run ()
    (do
        (let upstream (lwrtrw-run))
        (let composition-candidate (nth (node_children upstream) 13))
        (let parent-admitted (nth (node_children upstream) 15))
        (let composition (nth (node_children upstream) 16))
        (let recipe (nth (node_children upstream) 17))
        (let base-world (lwt-round-world parent-admitted))
        (let offer (lwrtrhw-offer composition-candidate composition))
        (let one-world (lwrtrhw-one-world base-world offer))
        (let two-world (lwrtrhw-two-world base-world offer))
        (let started
            (lcfb-open-stream "living-world-recipe-tree-revision-hypothesis"
                "form-native" "lwrtrhw-run"
                "scoped-composition-retrial-to-successor-hypothesis"
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                104 20))

        (let composition-enter
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "parent-after-scoped-offers" "enter" "form-native"
                "lwrtr-integrated-current?" "I/J-must-not-perturb-parent"
                1 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                115 20))
        (let composition-after-offers
            (lwrtr-integrated-current? two-world composition-candidate))
        (let composition-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "parent-after-scoped-offers" "leave" "form-native"
                "lwrtr-integrated-current?"
                (lcfb-cat (list "current:"
                    (int_to_str composition-after-offers))) 2 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                125 20))

        (let one-field
            (if (eq composition-after-offers 1)
                (lwrtrt-field-for-ready one-world composition-candidate
                    composition 2) (lwo-none)))
        (let one-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "first-scoped-offer" "leave" "form-native"
                "lwrtrt-field-for-ready" (lwrtrt-progress-target one-field)
                3 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                137 20))
        (let trial-field
            (if (eq composition-after-offers 1)
                (lwrtrt-field-for-ready two-world composition-candidate
                    composition 2) (lwo-none)))
        (let trial-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "independent-scoped-trial" "leave" "form-native"
                "lwrtrt-field-for-ready" (lwrtrt-progress-target trial-field)
                4 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                148 20))
        (let trial-proposal (lwrtrt-proposal-from-field trial-field))
        (let trial-candidate (lwt-proposal-candidate trial-proposal))
        (let trial-enter
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "trial-pre-response" "enter" "form-native"
                "lwt-integrate" "observed-field-currentness-and-consent" 5 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                158 20))
        (let trial-waiting
            (lwt-integrate
                (lwpow-round-for two-world trial-proposal (lwo-none))
                trial-proposal (lwphw-action)))
        (let trial-waiting-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "trial-pre-response" "leave" "form-native"
                "lwt-integrate"
                (lcfb-cat (list "candidate-active:"
                    (int_to_str
                        (lwo-active? (lwt-round-world trial-waiting)
                            trial-candidate)))) 6 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                169 20))
        (let trial-responded (lwpow-respond-all two-world trial-proposal))
        (let trial-response-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "trial-responses" "leave" "form-native" "lwpow-respond-all"
                (lcfb-cat (list "participants:"
                    (int_to_str
                        (lwo-field-size
                            (lwt-proposal-participants trial-proposal)))))
                7 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                181 20))
        (let trial-admission-enter
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "trial-admission" "enter" "form-native" "lwt-integrate"
                "freshness-and-unanimous-boundary" 8 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                189 20))
        (let trial-admitted
            (lwt-integrate
                (lwpow-round-for trial-responded trial-proposal trial-waiting)
                trial-proposal (lwphw-action)))
        (let trial-world (lwt-round-world trial-admitted))
        (let trial-current-enter
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "trial-currentness" "enter" "form-native"
                "lwrtrt-integrated-current?" "exact-field-reconstruction"
                9 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                201 20))
        (let trial-current
            (lwrtrt-integrated-current? trial-world trial-candidate))
        (let trial-admitted-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "trial-currentness" "leave" "form-native"
                "lwrtrt-integrated-current?"
                (lcfb-cat (list
                    "current:" (int_to_str trial-current)
                    ":recipe-active:"
                    (int_to_str (lwo-active? trial-world recipe))))
                10 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                213 20))

        (let successor-field
            (if (and (eq composition-after-offers 1) (eq trial-current 1))
                (lwrtrh-field-for-ready trial-world composition-candidate
                    trial-candidate) (lwo-none)))
        (let successor-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "successor" "leave" "form-native" "lwrtrh-field-for-ready"
                (lwrtrh-progress-target successor-field) 11 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                226 20))
        (let match (head (lwo-field-items
                            (lwrtrh-field-matches successor-field))))
        (let successor-proposal (lwrtrh-proposal-from-field successor-field))
        (let successor-candidate
            (lwt-proposal-candidate successor-proposal))
        (let proposal-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "successor-proposal" "leave" "form-native"
                "lwrtrh-proposal-from-field"
                (lcfb-cat (list "present:"
                    (int_to_str
                        (not (node_eq successor-proposal (lwo-none))))))
                12 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                239 20))
        (let waiting-enter
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "successor-pre-response" "enter" "form-native"
                "lwt-integrate" "observed-parent-and-local-currentness" 13 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                247 20))
        (let successor-waiting
            (lwt-integrate
                (lwpow-round-for trial-world successor-proposal trial-admitted)
                successor-proposal (lwphw-action)))
        (let waiting-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "successor-pre-response" "leave" "form-native"
                "lwt-integrate"
                (lcfb-cat (list "candidate-active:"
                    (int_to_str
                        (lwo-active? (lwt-round-world successor-waiting)
                            successor-candidate)))) 14 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                258 20))
        (let successor-responded
            (lwpow-respond-all trial-world successor-proposal))
        (let response-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "successor-responses" "leave" "form-native"
                "lwpow-respond-all"
                (lcfb-cat (list "participants:"
                    (int_to_str
                        (lwo-field-size
                            (lwt-proposal-participants successor-proposal)))))
                15 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                270 20))
        (let successor-admission-enter
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "successor-admission" "enter" "form-native"
                "lwt-integrate" "observed-currentness-and-unanimous-boundary"
                16 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                278 20))
        (let successor-admitted
            (lwt-integrate
                (lwpow-round-for successor-responded successor-proposal
                    successor-waiting)
                successor-proposal (lwphw-action)))
        (let successor-world (lwt-round-world successor-admitted))
        (let admitted-current-enter
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "successor-currentness" "enter" "form-native"
                "lwrtrh-integrated-current?" "exact-field-reconstruction"
                17 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                291 20))
        (let admitted-local-current
            (lwrtrh-local-current-ready? successor-world successor-candidate))
        (let admitted-local-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "successor-local-currentness" "leave" "form-native"
                "lwrtrh-local-current-ready?"
                (lcfb-cat (list
                    "current:" (int_to_str admitted-local-current)
                    ":next:trial-parent-currentness")) 18 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                301 20))
        (let admitted-trial-parent-current
            (lwrtrh-trial-local-current-for-parent? successor-world
                trial-candidate composition-candidate))
        (let admitted-trial-parent-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "successor-trial-local-currentness" "leave" "form-native"
                "lwrtrh-trial-local-current-for-parent?"
                (lcfb-cat (list
                    "current:" (int_to_str admitted-trial-parent-current)
                    ":next:composition-parent-currentness")) 19 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                312 20))
        (let admitted-composition-parent-current
            (lwrtr-integrated-current? successor-world composition-candidate))
        (let admitted-successor-current
            (if (and (eq (lwo-active? successor-world successor-candidate) 1)
                     (and (eq admitted-local-current 1)
                          (and (eq admitted-trial-parent-current 1)
                               (eq admitted-composition-parent-current 1))))
                1 0))
        (let admitted-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "successor-currentness" "leave" "form-native"
                "lwrtrh-integrated-current?"
                (lcfb-cat (list
                    "current:" (int_to_str admitted-successor-current)
                    ":recipe-active:"
                    (int_to_str (lwo-active? successor-world recipe))))
                20 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                303 20))

        (let revoked-world (lwrtrhw-revoke-first successor-world offer))
        (let revoked-trial-field
            (lwrtrt-field-for-ready revoked-world composition-candidate
                composition 2))
        (let revoked-trial-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "revoked-trial-field" "leave" "form-native"
                "lwrtrt-field-for-ready"
                (lwrtrt-progress-target revoked-trial-field) 21 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                314 20))
        (let revoked-current-enter
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "revoked-currentness" "enter" "form-native"
                "lwrtrt-candidate-current?/lwrtrh-candidate-current?"
                "scoped-trial-revocation" 22 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                322 20))
        (let revoked-trial-current
            (lwrtrt-candidate-current? revoked-world trial-candidate))
        (let revoked-successor-current
            (lwrtrh-candidate-current? revoked-world successor-candidate))
        (let revoked-successor-field
            (lwrtrh-field-for revoked-world composition-candidate
                trial-candidate))
        (let revoked-current-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "revoked-currentness" "leave" "form-native"
                "lwrtrt-candidate-current?/lwrtrh-candidate-current?"
                (lcfb-cat (list
                    "trial:" (int_to_str revoked-trial-current)
                    ":successor:" (int_to_str revoked-successor-current)))
                23 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                337 20))
        (let parent-enter
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "parent-currentness" "enter" "form-native"
                "lwrtr-integrated-current?" "revocation-locality" 24 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                345 20))
        (let revoked-composition-current
            (lwrtr-integrated-current? revoked-world composition-candidate))
        (let revoked-frame
            (lcfb-call-stream "living-world-recipe-tree-revision-hypothesis"
                "revocation" "leave" "form-native"
                "lwo-revocation/lwrtr-integrated-current?"
                (lcfb-cat (list
                    "trial-current:1->" (int_to_str revoked-trial-current)
                    ":successor-current:1->"
                    (int_to_str revoked-successor-current)
                    ":composition-current:"
                    (int_to_str revoked-composition-current)))
                25 started
                "form/form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk"
                358 20))

        (lwrtrhw-result upstream composition-candidate composition recipe
            base-world offer one-world one-field two-world trial-field
            trial-proposal trial-waiting trial-admitted trial-candidate
            successor-field match successor-proposal successor-waiting
            successor-admitted successor-candidate revoked-world
            revoked-trial-field revoked-successor-field
            (intern_trivial_int composition-after-offers)
            (intern_trivial_int trial-current)
            (intern_trivial_int admitted-successor-current)
            (intern_trivial_int revoked-trial-current)
            (intern_trivial_int revoked-successor-current)
            (intern_trivial_int revoked-composition-current)
            (framebuffer-events))))

0
