; voice-chunk-band.fk — a text cut for a mouth that breathes, pinned on text whose cut is known by construction.
; Every row below is a line built from words whose count and punctuation are chosen here, so the expected cut is
; arithmetic, not a reading: a short line stays whole, a long one breaks after punctuation once 10 words are held,
; is forced at 22, and a hyphen is two words. The two-tongue source is read into English lines, translated lines
; and one paragraph flag per line. The fkwu band proves the cut; the shell script it replaced is gone.
; Expected: 4095
; Verdict 4095
; PROOF LEVEL: FKWU-STAGED
; preludes: form/form-stdlib/voice-chunk.bml
(do
    (defn vb-bit (ok v) (if ok v 0))
    (defn vb-rep (w n) (if (le n 0) "" (str_concat w (str_concat " " (vb-rep w (sub n 1))))))
    (defn vb-n (r) (len r))
    (defn vb-text (r i) (nth (nth r i) 0))
    (defn vb-rest (r i) (nth (nth r i) 1))
    (let w5 (vc-line "one two three four five" 0))
    (let w5p (vc-line "one two three four five" 1))
    ; 30 words, a comma on word 12 -> a break after 12 words, then 18 left (<= 22, so no forced break)
    (let l30 (str_concat (vb-rep "a" 11) (str_concat "b, " (vb-rep "c" 18))))
    (let r30 (vc-line l30 0))
    ; a comma on word 9 comes before 10 words are held, so it does not break; the 29-word line is forced at 22
    ; and a trailing newline after the last paragraph is a blank line, so that paragraph ends with its own rest
    (let l9 (str_concat (vb-rep "x" 8) (str_concat "y, " (vb-rep "z" 20))))
    (let r9 (vc-line l9 0))
    ; 50 words and no punctuation: forced at 22, 22, then 6
    (let l50 (vb-rep "m" 50))
    (let r50 (vc-line l50 1))
    ; 44 words, no punctuation: forced at 22 and the line ends exactly on a break -> the last piece carries the line's rest
    (let r44 (vc-line (vb-rep "q" 44) 0))
    (let hy (vc-words "bridge-connected creators, now"))
    (let src (vc-source "Alpha one.\n    Um.\nAlpha two.\n    Dois.\n\nBeta.\n    Be.\n"))
    (let c1 (vb-bit (eq (vb-n w5) 1) 1))
    (let c2 (vb-bit (and (eq (vb-rest w5 0) 1) (eq (vb-rest w5p 0) 2)) 2))
    (let c3 (vb-bit (eq (vb-n r30) 2) 4))
    (let c4 (vb-bit (and (eq (vb-rest r30 0) 0) (eq (vb-rest r30 1) 1)) 8))
    (let c5 (vb-bit (and (eq (vb-n r9) 2) (eq (len (vc-words (vb-text r9 0))) 22)) 16))
    (let c6 (vb-bit (eq (vb-n r50) 3) 32))
    (let c7 (vb-bit (and (eq (vb-rest r50 0) 0) (and (eq (vb-rest r50 1) 0) (eq (vb-rest r50 2) 2))) 64))
    (let c8 (vb-bit (and (eq (vb-n r44) 2) (and (eq (vb-rest r44 0) 0) (eq (vb-rest r44 1) 1))) 128))
    (let c9 (vb-bit (eq (len hy) 4) 256))
    (let c10 (vb-bit (and (eq (len (nth src 0)) 3) (and (eq (len (nth src 1)) 3) (eq (len (nth src 2)) 3))) 512))
    (let c11 (vb-bit (and (str_eq (nth (nth src 0) 1) "Alpha two.") (str_eq (nth (nth src 1) 2) "Be.")) 1024))
    (let c12 (vb-bit (and (eq (nth (nth src 2) 0) 0) (and (eq (nth (nth src 2) 1) 1) (eq (nth (nth src 2) 2) 1))) 2048))
    (print_str (str_concat "pieces=" (int_to_str (add (vb-n r30) (add (vb-n r50) (vb-n r44))))))
    (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9 (add c10 (add c11 c12))))))))))))
