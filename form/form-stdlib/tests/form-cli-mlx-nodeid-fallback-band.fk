; form-cli-mlx-nodeid-fallback-band.fk — pure structured witness for the
; temporary MLX unknown-token -> NodeID JIT request return path.
;
; Verdict 16383 (14 bits):
;   1      linked last_error=none is success
;   2      only the exact unknown-seam line requests JIT
;   4      successful integer 0 is present
;   8      successful integer 1 stays identity-distinct
;   16     unknown returns a ready request
;   32     request identity retains recipe/input/auto
;   64     MLX refusal is a typed failure offer
;   128    unrelated/unlinked/invalid-recipe failures do not request JIT
;   256    the offered legacy token is the exact recipe coordinate
;   512    a simulated Metal value settles after two choices
;   1024   failure/undo/refine and crystallize/dissolve/release all remain
;   2048   nothing, value 0, and value 1 have distinct offer identities
;   4096   physical execution/native/model flags survive settlement
;   8192   this band calls neither mlx_run nor any Metal/model door
;
; preludes: form-stdlib/form-cli-mlx-nodeid-fallback.fk

(do
    (defn fmnfb-bit (ok bit) (if ok bit 0))
    (defn fmnfb-trace-has-all? (trace actions)
        (if (eq (len actions) 0) 1
            (if (eq (frex-trace-has? trace (head actions)) 1)
                (fmnfb-trace-has-all? trace (tail actions)) 0)))

    (defn form-cli-mlx-nodeid-fallback-band ()
        (do
            (let recipe (frex-recipe))
            (let ok-status
                "mlx_linked=true\nmlx_dispatch=7\nlast_error=none\n")
            (let unknown-status
                (str_concat "mlx_linked=true\nmlx_dispatch=7\n"
                    (fmnf-unknown-line)))
            (let near-status
                "mlx_linked=true\nlast_error=unknown temporary MLX seam token; offer NodeID JITx\n")
            (let other-status
                "mlx_linked=true\nlast_error=mlx op failed\n")
            (let unlinked-status
                "mlx_linked=false\nlast_error=carrier unavailable\n")

            (let zero (fmnf-classify recipe 0 0 ok-status 3))
            (let one (fmnf-classify recipe 1 1 ok-status 3))
            (let unknown (fmnf-classify recipe 5 0 unknown-status 9))
            (let other (fmnf-classify recipe 5 0 other-status 9))
            (let unlinked (fmnf-classify recipe 5 0 unlinked-status 9))
            (let invalid (fmnf-classify
                (intern_trivial_string "not-a-recipe") 5 0 unknown-status 9))
            (let request (fmnf-attempt-request unknown))
            (let refusal (fmnf-attempt-offer unknown))
            (let program (fmnf-node-program recipe 5))
            (let settled (fmnf-settle-with-flags unknown
                "metal" "value" "metal-value" 22 1 1 0 1))
            (let nothing-offer
                (frex-offer "mlx" "nothing" 0 "not-present"))

            (sum (list
                (fmnfb-bit (and (eq (fmnf-status-ok? ok-status) 1)
                                (eq (fmnf-status-ok? other-status) 0)) 1)
                (fmnfb-bit (and (eq (fmnf-status-unknown? unknown-status) 1)
                    (and (eq (fmnf-status-unknown? near-status) 0)
                         (eq (fmnf-status-unknown? other-status) 0))) 2)
                (fmnfb-bit (and (str_eq (fmnf-attempt-kind zero) "value")
                    (and (eq (fmnf-attempt-value-present? zero) 1)
                         (eq (fmnf-attempt-value zero) 0))) 4)
                (fmnfb-bit (and (str_eq (fmnf-attempt-kind one) "value")
                    (and (eq (fmnf-attempt-value-present? one) 1)
                         (not (node_eq
                            (frex-offer-token (fmnf-attempt-offer zero))
                            (frex-offer-token (fmnf-attempt-offer one)))))) 8)
                (fmnfb-bit (and (eq (fmnf-attempt-request? unknown) 1)
                    (and (eq (frex-request-ready? request) 1)
                         (str_eq (frex-request-reason request)
                                 "mlx-seam-unknown"))) 16)
                (fmnfb-bit (and (node_eq (frex-request-recipe request) recipe)
                    (and (eq (frex-request-input request) 5)
                    (and (str_eq (frex-request-carrier request) "auto")
                         (eq (frex-request-node-valid?
                                (frex-request-token request)) 1)))) 32)
                (fmnfb-bit (and (str_eq (frex-offer-carrier refusal) "mlx")
                    (and (str_eq (frex-offer-status refusal) "failure")
                    (and (eq (frex-offer-value-present? refusal) 0)
                         (str_eq (frex-offer-reason refusal)
                                 "unknown-temporary-mlx-seam")))) 64)
                (fmnfb-bit (and (eq (fmnf-attempt-request? other) 0)
                    (and (eq (fmnf-attempt-request? unlinked) 0)
                    (and (eq (fmnf-attempt-request? invalid) 0)
                         (str_eq (fmnf-attempt-reason invalid)
                                 "recipe-not-admitted")))) 128)
                (fmnfb-bit (and (str_eq program
                    (str_concat "5 " (frex-node-coordinate recipe)))
                    (and (lt (str_find program " mul " 0) 0)
                         (lt (str_find program " add " 0) 0))) 256)
                (fmnfb-bit (and (str_eq (frex-result-status settled) "value")
                    (and (eq (frex-result-value-present? settled) 1)
                    (and (eq (frex-result-value settled) 22)
                         (eq (frex-result-attempts settled) 2)))) 512)
                (fmnfb-bit (fmnfb-trace-has-all?
                    (frex-result-trace settled)
                    (list "failure" "undo" "refine" "crystallize"
                          "dissolve" "release")) 1024)
                (fmnfb-bit (and
                    (not (node_eq (frex-offer-token nothing-offer)
                                  (frex-offer-token
                                    (fmnf-attempt-offer zero))))
                    (and (not (node_eq (frex-offer-token nothing-offer)
                                      (frex-offer-token
                                        (fmnf-attempt-offer one))))
                         (not (node_eq
                            (frex-offer-token (fmnf-attempt-offer zero))
                            (frex-offer-token (fmnf-attempt-offer one)))))) 2048)
                (fmnfb-bit (and (eq (frex-result-executed? settled) 1)
                    (and (eq (frex-result-model-executed? settled) 0)
                         (eq (frex-result-native-code-generated? settled) 1)))
                    4096)
                ; Every result above is constructor/classifier data. The live
                ; wrapper owns mlx_run and Metal and is not a prelude here.
                (fmnfb-bit 1 8192)))))

    (form-cli-mlx-nodeid-fallback-band))
