; Native attention grammar growth, settled reuse, and honest carrier boundaries.
; Expected: 4095. Fixture-only; no publisher or model is changed.
; preludes: form/form-stdlib/bml/form-glass-awareness.bml
(do
  (defn gae-bit (ok bit) (if ok bit 0))
  (defn gae-rows (n frame) (if (le n 0) (list) (cons (fga-record frame "cell" "recipe" (str_concat "unit." (int_to_str n)) 1 1 1 n 0 "live" (nothing)) (gae-rows (sub n 1) frame))))
  (let frame (fga-frame "band" "metric" (FGSRSchema) 2 1000 500 "read" (list)))
  (let rows (gae-rows 45 frame))
  (let evolved (fga-evolve-recipes rows (list) 32 1))
  (let recipes (fga-get evolved "recipes"))
  (let settled (fga-evolve-recipes rows recipes (fga-get evolved "limit") 2))
  (let b1 (gae-bit (and (eq (fga-get evolved "before") 32) (eq (fga-get evolved "after") 45)) 1))
  (let b2 (gae-bit (and (eq (fga-get evolved "gift") 1) (eq (fga-get evolved "limit") 64)) 2))
  (let b3 (gae-bit (and (eq (fga-get settled "gift") 0) (eq (len (fga-get settled "recipes")) 45)) 4))
  (let lens (fga-lens-find recipes (fga-lens-key (head rows))))
  (let b4 (gae-bit (str_eq (fga-eval lens (head rows)) "observed") 8))
  (let b5 (gae-bit (eq (fga-get lens "node") (fga-get (fga-recipe (fga-lens-key (head rows))) "node")) 16))
  (let blocked (cons (fga-pair "lifecycle" "blocked") (head rows)))
  (let b6 (gae-bit (str_eq (fga-eval lens blocked) "restricted-flow") 32))
  (let decoded (fga-sensor-frame "band" 2 (fgsr-frame "another" 1000 (list))))
  (let b7 (gae-bit (str_eq (fga-get decoded "status") "identity-mismatch") 64))
  (let wrong (fga-sensor-frame "band" 2 (list "unshared-grammar" "band" 1000 (list))))
  (let b8 (gae-bit (str_eq (fga-get wrong "status") "decode-gap") 128))
  (let missing (fga-frame "band" "metric" "unknown" -1 -1 0 "absent" (list)))
  (let b9 (gae-bit (str_eq (fga-classify (fga-channel-record missing 1001)) "observation-gap") 256))
  (let src (intern_trivial_string "fixture-native-symbol"))
  (let raw (append (fgo-int "recipe" "symbol" "symbol" 1 "count" 0 "unified" "physical-live" "band" "live" "recipe" "") (list src)))
  (let record (fga-metric frame raw 1001))
  (let b10 (gae-bit (eq (fga-get record "source-node") src) 512))
  (let p (fgtm-sample "buffer" (fgtm-absent) "buffer" "membrane" "band" "band" "band" (fgtm-present 500) (fgtm-present 10) "active" (fgtm-present 1000) (fgtm-present 1000) (fgtm-present 0) (fgtm-present 2) "never" "physical-live" "band" (list)))
  ; Snapshot capacity has no unit contract: 500 bytes and capacity 10 is NOT pressure evidence.
  (let b11 (gae-bit (str_eq (fga-classify (fga-sample frame p 1001)) "observed") 1024))
  (let out (bfc-envelope 0 50 0 (list 16 32) 16))
  (let unrelated (bfc-envelope 1 51 1 5 32))
  (let b12 (gae-bit (eq (bfc-apply out unrelated 16 32) 16) 2048))
  (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 (add b9 (add b10 (add b11 b12))))))))))))
