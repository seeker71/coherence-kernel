; form-cli-current-answer-thought-walk-band.fk -- compact resident execution.
; Expected: 8191
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-cli-current-answer-thought-walk.fk

(do
    (defn fcatwb-bit (held weight) (if held weight 0))
    (defn fcatwb-source (name)
        (intern_trivial_string name))
    (defn fcatwb-values ()
        (do
            (let source (fcatwb-source "sha256:current-source"))
            (list source source "answer" "answer" "hit" "hit"
                "concept-registry-current-source-hit"
                "concept-registry-current-source-hit"
                1 1 1 1 1 1 "choice,cut,release"
                "choice,cut,release")))
    (defn fcatwb-kinds ()
        (list (fcatw-kind-node) (fcatw-kind-node)
              (fcatw-kind-string) (fcatw-kind-string)
              (fcatw-kind-string) (fcatw-kind-string)
              (fcatw-kind-string) (fcatw-kind-string)
              (fcatw-kind-int) (fcatw-kind-int)
              (fcatw-kind-int) (fcatw-kind-int)
              (fcatw-kind-int) (fcatw-kind-int)
              (fcatw-kind-string) (fcatw-kind-string)))
    (defn fcatwb-replace (xs at value)
        (if (nil? xs) (empty)
            (cons (if (eq at 0) value (head xs))
                (fcatwb-replace (tail xs) (sub at 1) value))))
    (defn form-cli-current-answer-thought-walk-band ()
        (do
            (let values (fcatwb-values))
            (let kinds (fcatwb-kinds))
            (let agreed (fcatw-run values kinds 93))
            (let disagreed (fcatw-run
                (fcatwb-replace values 3 "different") kinds 93))
            (let timed (fcatw-run values kinds 92))
            (sum (list
                (fcatwb-bit (and (eq (len (fcatw-nodes)) 60)
                    (and (eq (fcatw-root) 59)
                         (str_eq (fcatw-symbol)
                            "knowledge/current-answer-outcome-bound"))) 1)
                (fcatwb-bit (and (str_eq (fcatw-status agreed) "returned")
                    (and (eq (fcatw-value agreed) 1)
                    (and (eq (fcatw-kind agreed) (fcatw-kind-int))
                         (eq (fcatw-output-count agreed) 1)))) 2)
                (fcatwb-bit (eq (fcatw-steps agreed) 93) 4)
                (fcatwb-bit (and (str_eq (fcatw-status disagreed) "returned")
                    (and (eq (fcatw-value disagreed) 0)
                         (eq (fcatw-output-count disagreed) 1))) 8)
                (fcatwb-bit (and (str_eq (fcatw-status timed) "timeout")
                    (and (nothing? (fcatw-value timed))
                         (eq (fcatw-output-count timed) 0))) 16)
                (fcatwb-bit (nothing? (fcatw-run (empty) kinds 93)) 32)
                (fcatwb-bit (nothing? (fcatw-run values
                    (fcatwb-replace kinds 0 (fcatw-kind-string)) 93)) 64)
                (fcatwb-bit (and (not (nothing? (fcatw-run values kinds 93)))
                    (and (not (nothing? (fcatw-value disagreed)))
                         (nothing? (fcatw-value timed)))) 128)
                (fcatwb-bit (and (eq (fcatw-output-count agreed) 1)
                    (and (eq (fcatw-output-count disagreed) 1)
                         (eq (fcatw-output-count timed) 0))) 256)
                (fcatwb-bit (and (eq (fcatw-kind-node) 3)
                    (and (eq (fcatw-kind-list) 4)
                         (eq (fcatw-kind-nothing) 0))) 512)
                (fcatwb-bit (and (eq (fcatw-tag
                        (fcatw-node-at (fcatw-current-image) 35)) 80)
                    (and (eq (fcatw-tag
                        (fcatw-node-at (fcatw-current-image) 36)) 26)
                         (eq (fcatw-tag
                            (fcatw-node-at (fcatw-current-image) 48)) 42))) 1024)
                (fcatwb-bit (and (eq (fcatw-tag
                        (fcatw-node-at (fcatw-current-image) 40)) 102)
                    (and (eq (fcatw-tag
                        (fcatw-node-at (fcatw-current-image) 17)) 23)
                         (eq (fcatw-tag
                            (fcatw-node-at (fcatw-current-image) 33)) 24))) 2048)
                (fcatwb-bit (and (str_eq (fcatw-version)
                    "form-cli-current-answer-thought-walk-v2")
                    (str_eq (fcatw-reason agreed)
                        "resident-thought-returned")) 4096)))))

    (form-cli-current-answer-thought-walk-band))
