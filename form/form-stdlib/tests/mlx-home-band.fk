; mlx-home-band.fk — K-quants, rope, and fused attention walked home.
;
; #471 named Q4_K/Q6_K. The softmax sitting named rope and fused attention.
; New tokens on mlx_run. fkwu-uni.c did not change.
;
; Fixtures the band writes itself:
;   Q4_K 144 bytes, d=1, dmin=0, scales=1, nibble=1  → 256 ones
;   Q6_K 210 bytes, d=1, scale=1, q=1                 → 256 ones
; Rope at offset 0 is identity: (3,4) sums to 7.
; Fused attn: Q=K=(1,0), V=(4,5), scale 1 → 9.
;
; Verdict 255.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk
; witnessed: 2026-08-22 -> 255

(do
    (defn mhb-score (ok bit) (if ok bit 0))
    (defn mhb-has (hay needle) (if (lt (str_find hay needle 0) 0) 0 1))
    (defn mhb-live? () (mhb-has (mlx_status) "mlx_linked=true"))
    (defn mhb-b (n) (byte_to_str n))
    (defn mhb-rep (b n acc)
        (if (le n 0) acc (mhb-rep b (sub n 1) (str_concat acc (mhb-b b)))))
    (defn mhb-q4k ()
        (str_concat (mhb-b 0) (str_concat (mhb-b 60)
        (str_concat (mhb-b 0) (str_concat (mhb-b 0)
        (str_concat (mhb-rep 1 4 "")
        (str_concat (mhb-rep 0 4 "")
        (str_concat (mhb-rep 1 4 "")
                    (mhb-rep 17 128 "")))))))))
    (defn mhb-q6k ()
        (str_concat (mhb-rep 17 128 "")
        (str_concat (mhb-rep 170 64 "")
        (str_concat (mhb-rep 1 16 "")
        (str_concat (mhb-b 0) (mhb-b 60))))))
    (defn mhb-q4k-path () "/tmp/fk-mlx-home-q4k.bin")
    (defn mhb-q6k-path () "/tmp/fk-mlx-home-q6k.bin")
    (defn mhb-prog (tok path off r c tail)
        (str_concat tok (str_concat " " (str_concat path
        (str_concat " " (str_concat (int_to_str off)
        (str_concat " " (str_concat (int_to_str r)
        (str_concat " " (str_concat (int_to_str c)
        (str_concat " " tail)))))))))))
    (defn mlx-home-band ()
        (do
    (let w4 (fs-write-text (mhb-q4k-path) (mhb-q4k)))
    (let w6 (fs-write-text (mhb-q6k-path) (mhb-q6k)))
    (let live (mhb-live?))
    (let c0 (mhb-score (if (eq live 1) (if (eq w4 144) (eq w6 210) 0) 0) 1))
    (let c1 (mhb-score (if (eq live 1)
                           (eq (mlx_run (mhb-prog "q4k" (mhb-q4k-path) 0 1 256 "sum")) 256) 0) 2))
    (let c2 (mhb-score (if (eq live 1)
                           (eq (mlx_run (mhb-prog "q6k" (mhb-q6k-path) 0 1 256 "sum")) 256) 0) 4))
    (let c3 (mhb-score (if (eq live 1)
                           (eq (mlx_run (mhb-prog "q4k" (mhb-q4k-path) 0 1 255 "sum")) 0) 0) 8))
    (let c4 (mhb-score (if (eq live 1)
                           (eq (mlx_run "m1x2 3 4 rope sum") 7) 0) 16))
    (let c5 (mhb-score (if (eq live 1)
                           (eq (mlx_run "m1x2 1 0 m1x2 1 0 m1x2 4 5 attn sum") 9) 0) 32))
    (let c6 (mhb-score (if (eq live 1)
                           (eq (mlx_run "m1x3 1 2 3 softmax sum") 1) 0) 64))
    (let c7 (mhb-score (if (eq live 1)
                           (eq (mlx_run "2 3 add") 5) 0) 128))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
    )
    (mlx-home-band))
