; living-world-recipe-tree-relation-offer-witness.fk -- the recurrent relation
; crosses an ordinary unanimous offer/ack boundary without activating its Recipe.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/living-world-recipe-tree-revision-trial.fk form-stdlib/living-world-recipe-tree-revision-hypothesis.fk form-stdlib/living-world-recipe-tree-revision-prospective.fk form-stdlib/living-world-recipe-tree-relation-nursery.fk form-stdlib/living-world-recipe-tree-relation-offer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk

(let LWRROW-RESULT (bp "LWRROW-RESULT"))

; Revoke only the exact active attribution edges for this relation candidate.
; No structural containment scan is needed or wanted for a local withdrawal.
(defn lwrrow-release-candidate (world candidate)
    (lwt-receive-stream world
        (lwpow-release-entries
            (lwo-field-items
                (lwo-active-attributions-for world candidate))
            (empty))))

; children: upstream, exact field/proposal/candidate/choice, optional channel
; observation, pending and expired timeout histories, waiting/admitted views,
; local revocation view, cached currentness/authority bits, events.
(defn lwrrow-result
    (upstream field proposals proposal candidate choice optional-choice
     optional-proposal pending expired waiting admitted revoked-world
     pre-active waiting-active optional-active admitted-current recipe-active
     revoked-current parent-current events)
    (intern_node LWRROW-RESULT
        (list upstream field proposals proposal candidate choice optional-choice
              optional-proposal pending expired waiting admitted revoked-world
              (intern_trivial_int pre-active)
              (intern_trivial_int waiting-active)
              (intern_trivial_int optional-active)
              (intern_trivial_int admitted-current)
              (intern_trivial_int recipe-active)
              (intern_trivial_int revoked-current)
              (intern_trivial_int parent-current) events)))

(defn lwrrow-run ()
    (do
        (let upstream (lwrtrpw-run))
        (let upstream-children (node_children upstream))
        (let parent (nth upstream-children 1))
        (let suite (nth upstream-children 4))
        (let world (nth upstream-children 7))
        (let field (lwrrn-field-for world parent suite 2))
        (let started
            (lcfb-open-stream "living-world-recipe-tree-relation-offer"
                "form-native" "lwrrow-run"
                "optional-relation-offer-acknowledgment-and-local-revocation"
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                31 10))

        (let proposals (lwrro-proposals-for world parent suite 2))
        (let proposal (lwrro-ready-proposal proposals))
        (let candidate
            (if (node_eq proposal (lwo-none)) (lwo-none)
                (lwt-proposal-candidate proposal)))
        (let choice
            (if (node_eq candidate (lwo-none)) (lwo-none)
                (lwo-emergent-shape candidate)))
        (let proposal-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "proposal-field" "leave" "form-native"
                "lwrro-proposals-for"
                (lwrro-progress-target proposals) 1 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                58 10))
        (let pre-active
            (if (node_eq candidate (lwo-none)) 0
                (lwo-active? world candidate)))

        ; Exercise optional real-time lens and timeout positions without
        ; integrating this alternative proposal.
        (let invariant (lwrro-choice-invariant choice))
        (let trial (lwrro-choice-trial choice))
        (let unknown
            (head (lwo-field-items (lwrrn-field-unknowns field))))
        (let default-lens
            (lwlc-lens (lwlc-recipe-shape)
                (lwrrn-trial-recipe trial) field))
        (let additional-lens
            (lwlc-lens (lwlc-cell-shape) invariant field))
        (let stack
            (lwlc-stack default-lens (lwlc-layers (list additional-lens))
                (lwo-empty-field) unknown field))
        (let declaration (lwlc-declaration parent stack field))
        (let timeout
            (oac-timeout (intern_trivial_int 10)
                (oac-alternative-ack choice trial field) field))
        (let optional-choice
            (lwrro-choice field invariant trial declaration
                (lwrrn-field-trials field) (lwrrn-field-unknowns field)
                timeout field))
        (let optional-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "optional-channel" "enter" "form-native"
                "lwrro-proposal-from-choice"
                "current-field-with-optional-lenses-and-timeout" 2 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                87 10))
        (let optional-proposal
            (lwrro-proposal-from-choice world parent suite 2 optional-choice))
        (let optional-candidate
            (if (node_eq optional-proposal (lwo-none)) (lwo-none)
                (lwt-proposal-candidate optional-proposal)))
        (let optional-active
            (if (node_eq optional-candidate (lwo-none)) 0
                (lwo-active? world optional-candidate)))
        (let pending
            (oac-timeout-condense timeout (intern_trivial_int 5)))
        (let expired
            (oac-timeout-condense timeout (intern_trivial_int 10)))
        (let optional-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "optional-channel" "leave" "form-native"
                "lwlc-declaration/oac-timeout-condense"
                (lcfb-cat (list
                    "declaration-valid:"
                    (int_to_str (lwlc-declaration-valid? declaration))
                    ":pending:"
                    (int_to_str (oac-time-pending? pending))
                    ":expired-alternative:"
                    (int_to_str (if (eq (oac-time-outcome? expired) 0) 0
                        (oac-alternative-ack?
                            (oac-time-outcome-ack expired))))))
                3 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                102 10))

        (let waiting-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "pre-response" "enter" "form-native" "lwrro-integrate"
                "currentness-before-response" 4 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                111 10))
        (let waiting
            (lwrro-integrate
                (lwpow-round-for world proposal (lwo-none))
                proposal (lwphw-action)))
        (let waiting-active
            (lwo-active? (lwt-round-world waiting) candidate))
        (let waiting-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "pre-response" "leave" "form-native" "lwrro-integrate"
                (lcfb-cat (list "candidate-active:"
                    (int_to_str waiting-active) ":state:waiting"))
                5 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                119 10))

        (let response-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "responses" "enter" "form-native" "lwpow-respond-all"
                "active-participant-acknowledgments" 6 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                127 10))
        (let responded (lwpow-respond-all world proposal))
        (let response-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "responses" "leave" "form-native" "lwpow-respond-all"
                (lcfb-cat (list "participants:"
                    (int_to_str (lwo-field-size
                        (lwt-proposal-participants proposal)))
                    ":ack:one")) 7 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                131 10))
        (let admission-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "admission" "enter" "form-native" "lwrro-integrate"
                "currentness-and-unanimous-boundary" 8 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                141 10))
        (let admitted
            (lwrro-integrate
                (lwpow-round-for responded proposal waiting)
                proposal (lwphw-action)))
        (let admitted-world (lwt-round-world admitted))
        (let admitted-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "admission" "leave" "form-native" "lwrro-integrate"
                (lcfb-cat (list "candidate-active:"
                    (int_to_str (lwo-active? admitted-world candidate))))
                9 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                145 10))
        (let current-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "currentness" "enter" "form-native"
                "lwrro-integrated-current?"
                "single-field-reconstruction" 10 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                153 10))
        (let admitted-current
            (lwrro-integrated-current? admitted-world candidate))
        (let recipe-active
            (lwo-active? admitted-world (lwrrn-trial-recipe trial)))
        (let current-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "currentness" "leave" "form-native"
                "lwrro-integrated-current?/lwo-active?"
                (lcfb-cat (list
                    "relation-current:" (int_to_str admitted-current)
                    ":recipe-active:" (int_to_str recipe-active)
                    ":authority:relation-only")) 11 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                159 10))

        (let revocation-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "local-revocation" "enter" "form-native"
                "lwrrow-release-candidate"
                "exact-active-relation-attributions" 12 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                168 10))
        (let revoked-world
            (lwrrow-release-candidate admitted-world candidate))
        (let release-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "local-revocation" "leave" "form-native"
                "lwrrow-release-candidate"
                (lcfb-cat (list "candidate-active:"
                    (int_to_str (lwo-active? revoked-world candidate))))
                13 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                176 10))
        (let revoked-current-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "revoked-currentness" "enter" "form-native"
                "lwrro-integrated-current?"
                "active-edge-first" 14 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                184 10))
        (let revoked-current
            (lwrro-integrated-current? revoked-world candidate))
        (let revoked-current-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "revoked-currentness" "leave" "form-native"
                "lwrro-integrated-current?"
                (lcfb-cat (list "relation-current:"
                    (int_to_str revoked-current))) 15 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                193 10))
        (let parent-current-enter
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "parent-currentness" "enter" "form-native"
                "lwrtrp-ready?" "locality-check" 16 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                200 10))
        (let parent-current
            (lwrtrp-ready? revoked-world parent suite 2))
        (let revoked-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-offer"
                "local-revocation" "leave" "form-native"
                "lwo-revocation/lwrro-integrated-current?"
                (lcfb-cat (list
                    "relation-current:1->" (int_to_str revoked-current)
                    ":parent-current:" (int_to_str parent-current)))
                17 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-offer-witness.fk"
                176 10))

        (lwrrow-result upstream field proposals proposal candidate choice
            optional-choice optional-proposal pending expired waiting admitted
            revoked-world pre-active waiting-active optional-active
            admitted-current recipe-active revoked-current parent-current
            (framebuffer-events))))

(defn lwrrow-observe ()
    (do
        (let result (lwrrow-run))
        (let children (node_children result))
        (let proposals (nth children 2))
        (let proposal (nth children 3))
        (let choice (nth children 5))
        (let optional-choice (nth children 6))
        (let optional-proposal (nth children 7))
        (let pending (nth children 8))
        (let expired (nth children 9))
        (list
            (lwo-field-size proposals)
            (not (node_eq proposal (lwo-none)))
            (lwrro-choice-valid? choice)
            (lwrro-choice-valid? optional-choice)
            (not (node_eq optional-proposal (lwo-none)))
            (oac-time-pending? pending)
            (oac-time-outcome? expired)
            (if (eq (oac-time-outcome? expired) 0) 0
                (oac-alternative-ack? (oac-time-outcome-ack expired)))
            (node_value (nth children 13))
            (node_value (nth children 14))
            (node_value (nth children 15))
            (node_value (nth children 16))
            (node_value (nth children 17))
            (node_value (nth children 18))
            (node_value (nth children 19))
            (len (nth children 20)))))

; witnessed: 2026-08-09 -> aggregate consent, timeout, authority, and locality observed on fkwu
0
