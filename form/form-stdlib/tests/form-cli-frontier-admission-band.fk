; form-cli-frontier-admission-band.fk — frontier use is an observed exception,
; never a posterior score side effect.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-router.fk
; preludes: form-stdlib/form-cli-judge.fk form-stdlib/form-cli-sufficiency.fk
;
; Verdict 32767:
;   1     exact terminal local observation is valid
;   2     a quality signal is not a witnessed inability
;   4     another local alternative blocks frontier
;   8     absent teach-back capture blocks frontier
;   16    unavailable/exhausted provider blocks frontier
;   32    a second frontier turn is a leak and is refused
;   64    provider capability must match the exact local gap
;   128   exact exhausted local nothing admits one matching teacher turn
;   256   a refused crossing produces the empty packet
;   512   admitted packet carries identities only, not prompt/answer content
;   1024  nothing remains distinct from explicit 0 and 1
;   2048  a posterior local gap cannot open the legacy escalation helper
;   4096  observed return with a lesson NodeID closes the learning loop
;   8192  absent lesson or absent observation cannot close the learning loop
;   16384 malformed/ambiguous unsigned fields cannot coerce into zero

(do
    (let exact (fsuf-local-observation
        "attempt-7" "@1.1.9.7" "qwen35" "nothing" "@1.1.9.99"
        "fresh-world-knowledge" 0 1))
    (let quality (fsuf-local-observation
        "attempt-8" "@1.1.9.8" "qwen35" "quality-signal" "@1.1.9.98"
        "frontier-review" 0 1))
    (let local-left (fsuf-local-observation
        "attempt-9" "@1.1.9.9" "qwen35" "timeout" "@1.1.9.97"
        "frontier-synthesis" 1 1))
    (let no-capture (fsuf-local-observation
        "attempt-10" "@1.1.9.10" "qwen35" "unsupported" "@1.1.9.96"
        "fresh-world-knowledge" 0 0))
    (let grok (fsuf-frontier-profile "grok" "fresh-world-knowledge" 1 0))
    (let grok-down (fsuf-frontier-profile "grok" "fresh-world-knowledge" 0 0))
    (let grok-spent (fsuf-frontier-profile "grok" "fresh-world-knowledge" 1 1))
    (let wrong (fsuf-frontier-profile "grok" "frontier-review" 1 0))
    (let weak (fsuf-signals 1 1 20 80 80 0))
    (let packet (fsuf-frontier-packet exact grok))

    (let c0 (if (eq (fsuf-local-observation-valid? exact) 1) 1 0))
    (let c1 (if (eq (fsuf-local-observation-valid? quality) 0) 2 0))
    (let c2 (if (eq (fsuf-frontier-admit? local-left
                         (fsuf-frontier-profile "codex" "frontier-synthesis" 1 0)) 0) 4 0))
    (let c3 (if (eq (fsuf-frontier-admit? no-capture grok) 0) 8 0))
    (let c4 (if (eq (fsuf-frontier-admit? exact grok-down) 0) 16 0))
    (let c5 (if (eq (fsuf-frontier-admit? exact grok-spent) 0) 32 0))
    (let c6 (if (eq (fsuf-frontier-admit? exact wrong) 0) 64 0))
    (let c7 (if (eq (fsuf-frontier-admit? exact grok) 1) 128 0))
    (let c8 (if (str_eq (fsuf-frontier-packet local-left grok) "") 256 0))
    (let c9 (if (and (gt (str_len packet) 0)
                     (and (ge (str_find packet "@1.1.9.99" 0) 0)
                          (and (lt (str_find packet "prompt" 0) 0)
                               (lt (str_find packet "answer" 0) 0)))) 512 0))
    (let c10 (if (and (eq (fsuf-status-hard-gap? "nothing") 1)
                      (and (eq (fsuf-status-hard-gap? "0") 0)
                           (eq (fsuf-status-hard-gap? "1") 0))) 1024 0))
    (let c11 (if (and (eq (fsuf-local-gap? weak) 1)
                      (eq (fsuf-escalate? weak) 0)) 2048 0))
    (let c12 (if (eq (fsuf-frontier-return-valid?
        (fsuf-frontier-return "@1.1.9.7" "attempt-7" "grok"
            "@1.1.9.100" "learned" 1)) 1) 4096 0))
    (let c13 (if (and (eq (fsuf-frontier-return-valid?
        (fsuf-frontier-return "@1.1.9.7" "attempt-7" "grok"
            "" "learned" 1)) 0)
        (eq (fsuf-frontier-return-valid?
        (fsuf-frontier-return "@1.1.9.7" "attempt-7" "grok"
            "@1.1.9.100" "learned" 0)) 0)) 8192 0))
    (let c14 (if (and (eq (fsuf-uint? "") 0)
                 (and (eq (fsuf-uint? "words") 0)
                 (and (eq (fsuf-uint? "00") 0)
                 (and (eq (fsuf-uint? "0") 1)
                      (eq (fsuf-uint? "17") 1))))) 16384 0))

    (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14)))
