; voice-door-ground-band.bml — the voice's grounded door, read before any voice is asked (observe/companion-ground.bml, cp-door-ground; docs/grounded-voice-door.md).
;
; Model-free. Expected: 255
;   1   an ask that names a door carries that door's path and its own head, and the packet keeps the role prompt first and whole
;   2   an ask that names no door costs what it cost: empty ground, no file read (an index that cannot be read still answers), the packet byte for byte the bare one
;   4   an ask about the body that meets no door keeps the honest miss and offers no path
;   8   a planted path that does not stand is no door, and a planted door whose head lies is offered only as what its head says: the door adds nothing of its own
;  16   the placebo hands another ask's ground: no path shared with the true ground, and an ask naming no door stays bare under it too
;  32   a person's words never enter what the door hands on or the door's own corpus: a sentinel in the ask stays out of the ground, and no path is under learn/ or .hearth/
;  64   the fifth set's asks are fixture prompts: none stands in any of the person's word files, read here and never printed
; 128   a ruled opening line spends none of a door's head (the axioms' names reach the voice), and the companion's packet carries the door by default, bare for an ask naming none
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/ledger.bml observe/companion-packet.bml
section [form.bml] {
 blueprint VdgScenario { id: string, tongue: string, person_says: string, context: string, predicates: list<string> }
 class VoiceDoorGroundBand {
  def vdg-has?(hay, needle) = str_find(hay, needle, 0) >= 0;
  def vdg-role() = "the pinned role prompt";
  def vdg-frame() = "The person says: x\n\nCompanion:";
  def vdg-door(ctx) {
   let g = cp-door-ground("Which door lands a change in one call?");
   let p = cp-door-packet(vdg-role(), g, vdg-frame());
   vdg-has?(g, "observe/land-run.bml\n") && vdg-has?(g, "land-run.bml — a movement") && (String) substring(p, 0, len(vdg-role())) == vdg-role() && vdg-has?(p, g);
  }
  def vdg-bare(ctx) {
   let said = "The river is carrying leaves past my door tonight.";
   (String) cp-door-ground(said) == "" && (String) cp-door-ground-in([], said) == "" && (String) cp-door-packet(vdg-role(), "", vdg-frame()) == vdg-role() ++ "\n---\n" ++ vdg-frame() && (String) cp-door-packet("", "", vdg-frame()) == vdg-frame();
  }
  def vdg-miss(ctx) {
   let g = cp-door-ground("Which door zzqqxplugh wvvkkjj?");
   (String) g == cp-door-miss() && !vdg-has?(g, "observe/");
  }
  def vdg-planted(ctx) {
   let absent = cp-door-index-of(["observe/never-a-door-run.bml", "observe/land-run.bml"]);
   let lie = cons(["observe/land-run.bml", "wrongword names this door"], cp-door-index());
   let rows = cp-door-rows(lie, "Which door wrongword?");
   let empty = cp-door-ground-in([], "Which door lands a change?");
   len(absent) == 1 && (String) absent[0][0] == "observe/land-run.bml" && len(rows) == 1 && (String) rows[0][1] == "observe/land-run.bml" && (String) empty == cp-door-miss();
  }
  def vdg-placebo(ctx) {
   let index = cp-door-index();
   let saids = ["Which door lands a change in one call?", "Which door lists the gaps on the way to a fully offline voice?", "The river is carrying leaves past my door tonight."];
   let wrong = cp-door-permuted(index, saids, 0);
   !vdg-has?(wrong, "observe/land-run.bml") && vdg-has?(wrong, "observe/offline-voice-gaps-run.bml") && (String) cp-door-permuted(index, saids, 2) == "";
  }
  def vdg-words(ctx) {
   let g = cp-door-ground("Which door lands zzsentinelword change?");
   let paths = map(e => e[0], cp-door-index());
   !vdg-has?(g, "zzsentinelword") && !any?(p => vdg-has?(p, "learn/") || vdg-has?(p, ".hearth/"), paths);
  }
  def vdg-files() = ["learn/draft-readings.jsonl", "learn/draft-readings-heldout.jsonl", "learn/draft-readings-native.jsonl", "learn/last-block-train-rows.jsonl"];
  def vdg-fixture(ctx) {
   let says = map(r => row-get(r, "person_says"), ledger-rows("model/fixtures/alignment/scenarios-5.jsonl", "VdgScenario"));
   let held = map(f => read_file(f) ?? "", vdg-files());
   len(says) == 24 && !any?(s => any?(h => vdg-has?(h, s), held), says);
  }
  def vdg-head(ctx) {
   let g = cp-door-ground("Name the five axioms the core stands on.");
   vdg-has?(g, "axioms/core-axioms.form\n") && vdg-has?(g, "boundary, offer");
  }
  def vdg-default(ctx) {
   let named = cp-packet("Which door lands a change in one call?", "en", "");
   let bare = cp-packet("The river is carrying leaves past my door tonight.", "en", "");
   vdg-has?(named, "observe/land-run.bml\n") && !vdg-has?(bare, "Doors of this body") && !vdg-has?(bare, "Door lookup");
  }
  def vdg-go() = (vdg-door(0) ? 1 : 0) + (vdg-bare(0) ? 2 : 0) + (vdg-miss(0) ? 4 : 0) + (vdg-planted(0) ? 8 : 0) + (vdg-placebo(0) ? 16 : 0) + (vdg-words(0) ? 32 : 0) + (vdg-fixture(0) ? 64 : 0) + (vdg-head(0) && vdg-default(0) ? 128 : 0);
 }
 vdg-go();
}
