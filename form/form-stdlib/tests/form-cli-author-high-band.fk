; form-cli-author-high-band.fk — floor is high-grammar BML + cached native.
;
; Verdict 4095:
;   1..512  fah-check (high/native/wrong-xtal/band/organ/seed/offers/fkb/dylib)
;   1024    class descriptor FormAuthorHigh minted (generic T)
;   2048    high-grammar authority has package/interface/class/GrainNative/wrong-shape
;
; Floor: .bml runs as itself (gitignored .bml.fk cache). xtal is wrong shape.
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-author-high.bml
; witnessed: 2026-08-30 -> 4095 floor=cached-native xtal=wrong-shape; .bml prelude

(do
    (defn fahb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn fahb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (fahb-has-name? (tail xs) name))))

    (let bits (fah-check))
    (let desc (FormAuthorHigh))
    (let src (read_file "form/form-stdlib/bml/form-cli-author-high.bml"))
    (let speak (fah-speak))
    (let b10 (if (and (str_eq (nth desc 1) "FormAuthorHigh")
                      (and (eq (fahb-has-name? (nth desc 2) "T") 1)
                           (and (eq (fahb-has-name? (nth desc 3) "fah-grain") 1)
                                (eq (fahb-has-name? (nth desc 4) "GrainHigh") 1))))
                 1024 0))
    (let b11 (if (and (eq (fahb-has-str? src "package Form.cli.authorhigh") 1)
                      (and (eq (fahb-has-str? src "interface IAuthorHigh") 1)
                           (and (eq (fahb-has-str? src "class FormAuthorHigh") 1)
                                (and (eq (fahb-has-str? src "const int GrainNative") 1)
                                     (and (eq (fahb-has-str? src "xtal=wrong-shape") 1)
                                          (eq (fahb-has-str? speak "cached-native") 1))))))
                 2048 0))
    (add bits (add b10 b11)))
