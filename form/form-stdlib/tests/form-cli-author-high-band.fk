; form-cli-author-high-band.fk — new meaning authors BML or higher.
;
; Verdict 1023:
;   1..128  fah-check (bml/bmf/form high; xtal lower; band; organ; seed;
;                     new meaning offers .bml not .fk)
;   256     class descriptor FormAuthorHigh minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-author-high.bml
; witnessed: 2026-08-30 -> 1023

(do
    (defn fahb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn fahb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (fahb-has-name? (tail xs) name))))

    (let bits (fah-check))
    (let desc (FormAuthorHigh))
    (let src (read_file "form/form-stdlib/bml/form-cli-author-high.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormAuthorHigh")
                     (and (eq (fahb-has-name? (nth desc 2) "T") 1)
                          (and (eq (fahb-has-name? (nth desc 3) "fah-grain") 1)
                               (eq (fahb-has-name? (nth desc 4) "GrainHigh") 1))))
                256 0))
    (let b9 (if (and (eq (fahb-has-str? src "package Form.cli.authorhigh") 1)
                     (and (eq (fahb-has-str? src "interface IAuthorHigh") 1)
                          (and (eq (fahb-has-str? src "class FormAuthorHigh") 1)
                               (and (eq (fahb-has-str? src "const int GrainHigh") 1)
                                    (eq (fahb-has-str? src "template GrainCell") 1)))))
                512 0))
    (add bits (add b8 b9)))
