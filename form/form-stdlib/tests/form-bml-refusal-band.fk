; form-bml-refusal-band.fk — a section the cursor does not read names the line and the first word where it stops.
;
; Verdict 63 when every claim lands:
;   1   the first byte of a text is on line 1
;   2   a byte after two newlines is on line 3
;   4   the word at a byte is the run of name bytes that begins there
;   8   a byte that begins no name is its own one-byte word
;   16  a section the cursor reads whole has no refusal: nothing
;   32  a section that stops at a class it cannot read names line 2 and the word class
;
; preludes: form-stdlib/form-bml-refusal.fk

(do
    (defn fbrb-bit (ok bit) (if ok bit 0))
    (defn fbrb-refused (text line word)
        (do (let r (fbr-refusal text))
            (if (nothing? r) 0 (and (eq (head r) line) (str_eq (nth r 1) word)))))
    (add (fbrb-bit (eq (fbr-line-at "a\nb\nc" 0) 1) 1)
    (add (fbrb-bit (eq (fbr-line-at "a\nb\nc" 4) 3) 2)
    (add (fbrb-bit (str_eq (fbr-word-at "x  class K {" 3) "class") 4)
    (add (fbrb-bit (str_eq (fbr-word-at "x;" 1) ";") 8)
    (add (fbrb-bit (nothing? (fbr-refusal "def f(x) = 1;\n")) 16)
         (fbrb-bit (fbrb-refused "def f(x) = 1;\nclass K { bogus }" 2 "class") 32)))))))
