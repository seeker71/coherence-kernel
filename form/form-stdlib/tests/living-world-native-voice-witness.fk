; living-world-native-voice-witness.fk -- offered symbols voice an executed cell.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-native-voice.fk form-stdlib/tests/living-world-recipe-execution-witness.fk

(let LWNVW-SOURCE-C  (bp "LWNVW-SOURCE-C"))
(let LWNVW-SOURCE-D  (bp "LWNVW-SOURCE-D"))
(let LWNVW-SOURCE-E  (bp "LWNVW-SOURCE-E"))
(let LWNVW-PROV-C    (bp "LWNVW-PROV-C"))
(let LWNVW-PROV-D    (bp "LWNVW-PROV-D"))
(let LWNVW-PROV-E    (bp "LWNVW-PROV-E"))
(let LWNVW-CAPABILITY (bp "LWNVW-CAPABILITY"))
(let LWNVW-EVIDENCE  (bp "LWNVW-EVIDENCE"))
(let LWNVW-ALTERNATE (bp "LWNVW-ALTERNATE"))

(defn lwnvw-cell (kind) (intern_node kind (empty)))
(defn lwnvw-source-c () (lwnvw-cell LWNVW-SOURCE-C))
(defn lwnvw-source-d () (lwnvw-cell LWNVW-SOURCE-D))
(defn lwnvw-source-e () (lwnvw-cell LWNVW-SOURCE-E))
(defn lwnvw-prov-c () (lwnvw-cell LWNVW-PROV-C))
(defn lwnvw-prov-d () (lwnvw-cell LWNVW-PROV-D))
(defn lwnvw-prov-e () (lwnvw-cell LWNVW-PROV-E))
(defn lwnvw-capability () (lwnvw-cell LWNVW-CAPABILITY))
(defn lwnvw-evidence () (lwnvw-cell LWNVW-EVIDENCE))
(defn lwnvw-alternate () (lwnvw-cell LWNVW-ALTERNATE))

(defn lwnvw-basis ()
    (lwt-proposal-candidate
        (lwrew-proposal-for-world (lwrew-world))))
(defn lwnvw-referent () (intern_trivial_int 49))
(defn lwnvw-symbol-forty ()
    (lwnv-symbol (lwnvw-referent) 0 "forty" (lwnvw-evidence)))
(defn lwnvw-symbol-nine ()
    (lwnv-symbol (lwnvw-referent) 1 "-nine" (lwnvw-evidence)))

(defn lwnvw-entry-for (source provenance payload)
    (lwt-entry
        (lwo-offer source
            (lwo-interface (list (lwrew-action))) 1 payload provenance 1)
        (lwrew-action)))
(defn lwnvw-entry-c (payload)
    (lwnvw-entry-for (lwnvw-source-c) (lwnvw-prov-c) payload))
(defn lwnvw-entry-d (payload)
    (lwnvw-entry-for (lwnvw-source-d) (lwnvw-prov-d) payload))
(defn lwnvw-entry-e (payload)
    (lwnvw-entry-for (lwnvw-source-e) (lwnvw-prov-e) payload))

(defn lwnvw-grant-entry (source provenance payload)
    (lwnvw-entry-for source provenance
        (lwcp-grant payload (lwnvw-capability) (lwnvw-evidence))))

(defn lwnvw-world ()
    (do
        (let base (lwt-round-world (lwrew-integrated-round)))
        (lwt-receive-stream base
            (list
                (lwnvw-entry-e (lwnvw-capability))
                (lwnvw-entry-c (lwnvw-symbol-forty))
                (lwnvw-entry-d (lwnvw-symbol-nine))
                ; Every holder grants exactly the tissue the voice needs.
                (lwnvw-grant-entry (lwrew-source-a) (lwrew-prov-a)
                    (lwnvw-basis))
                (lwnvw-grant-entry (lwrew-source-b) (lwrew-prov-b)
                    (lwnvw-basis))
                (lwnvw-grant-entry (lwrew-source-a) (lwrew-prov-a)
                    (lwrew-recipe))
                (lwnvw-grant-entry (lwrew-source-a) (lwrew-prov-a)
                    (lwrew-declaration))
                (lwnvw-grant-entry (lwrew-source-b) (lwrew-prov-b)
                    (lwrew-before))
                (lwnvw-grant-entry (lwnvw-source-c) (lwnvw-prov-c)
                    (lwnvw-symbol-forty))
                (lwnvw-grant-entry (lwnvw-source-d) (lwnvw-prov-d)
                    (lwnvw-symbol-nine))))))

(defn lwnvw-context-for-world (world)
    (lwcp-context world (lwnvw-capability)))
(defn lwnvw-context () (lwnvw-context-for-world (lwnvw-world)))

(defn lwnvw-choice ()
    (lwlc-choice (lwrew-action)
        (lwo-field (list (lwnvw-alternate)))
        (lwlc-unknown (lwnvw-evidence))
        (lwnvw-evidence)))

(defn lwnvw-proposal-for (world)
    (lwnv-proposal (lwnvw-context-for-world world)
        (lwnvw-basis) (lwnvw-referent)
        (lwo-field
            (list
                (oac-alternative (lwnvw-basis)
                    (lwnvw-alternate) (lwnvw-evidence))))
        (lwlc-unknown (lwnvw-evidence))
        (lwnvw-choice) (lwnvw-evidence)))

(defn lwnvw-round ()
    (do
        (let world (lwnvw-world))
        (let proposal (lwnvw-proposal-for world))
        (lwt-round world
            (lwo-field-add (lwo-empty-field) proposal)
            (lwo-empty-field) (lwo-none))))

(defn lwnvw-response (source provenance proposal)
    (lwnvw-entry-for source provenance
        (lwt-response proposal (oac-one proposal) provenance)))

(defn lwnvw-yes-round ()
    (do
        (let round (lwnvw-round))
        (let proposal
            (head (lwo-field-items (lwt-round-proposals round))))
        (lwt-round-receive round
            (list
                (lwnvw-response (lwrew-source-a) (lwrew-prov-a) proposal)
                (lwnvw-response (lwrew-source-b) (lwrew-prov-b) proposal)
                (lwnvw-response (lwnvw-source-c) (lwnvw-prov-c) proposal)
                (lwnvw-response (lwnvw-source-d) (lwnvw-prov-d) proposal)
                (lwnvw-response (lwnvw-source-e) (lwnvw-prov-e) proposal)))))

(defn lwnvw-integrated-round ()
    (do
        (let round (lwnvw-yes-round))
        (let proposal
            (head (lwo-field-items (lwt-round-proposals round))))
        (lwnv-integrate round proposal (lwrew-action))))

(defn lwnvw-revoked-world ()
    (do
        (let world (lwnvw-world))
        (let grant
            (lwcp-grant (lwnvw-symbol-nine)
                (lwnvw-capability) (lwnvw-evidence)))
        (lwt-receive-stream world
            (list
                (lwnvw-entry-d
                    (lwo-revocation grant (lwnvw-source-d)
                        (lwrew-action) (lwnvw-prov-d)))))))

(defn lwnvw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwnvw-sum (tail items)))))
