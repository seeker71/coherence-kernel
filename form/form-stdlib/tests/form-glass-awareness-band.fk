; Pure fixture transitions; no living frame, model, corpus or file is changed.
; witnessed: 2026-09-07 -> 1048575
; Expected: 1048575. Pre-register the assertions before the live reading.
; preludes: form/form-stdlib/bml/form-glass-awareness.bml form/form-stdlib/form-glass-observation-ui.bml
(do
  (defn gab-bit (ok bit) (if ok bit 0))
  (defn gab-frame (rows seq epoch) (fga-frame "band" "metric" (FGSRSchema) seq epoch 500 "read" rows))
  (defn gab-row (id value capacity) (fgo-sized "memory" id id value "bytes" capacity 0 "unified" "physical-live" "band" "live" "memory" "PRIVATE-NOTE-NOT-CARRIED"))
  (defn gab-many (count) (if (le count 0) (list) (cons (gab-row (str_concat "metric." (int_to_str count)) count 1000) (gab-many (sub count 1)))))
  (let frame (gab-frame (list) 10 1000))
  (let row (fga-metric frame (gab-row "used" 99 100) 1001))
  (let lens (fga-recipe (fga-lens-key row)))
  ; Keyed grammar accepts reordered and additional fields, no text parser.
  (let b1 (gab-bit (str_eq (fga-eval lens (cons (fga-pair "new-field" (list 1 2)) (reverse row))) "observed") 1))
  (let at (fga-metric frame (gab-row "used" 100 100) 1001))
  (let b2 (gab-bit (str_eq (fga-eval lens at) "capacity-edge") 2))
  (let zero (fga-metric frame (gab-row "idle" 0 0) 1001))
  (let b3 (gab-bit (str_eq (fga-eval lens zero) "observed") 4))
  (let absent (fga-metric frame (fgo-unavailable "memory" "missing" "missing" "bytes" "unified" "needed-organ" "memory" "private") 1001))
  (let b4 (gab-bit (str_eq (fga-eval lens absent) "observation-gap") 8))
  (let stale (fga-metric frame (gab-row "used" 100 100) 2501))
  (let b5 (gab-bit (str_eq (fga-eval lens stale) "stale-source") 16))
  (let b6 (gab-bit (and (eq (fga-fresh frame 999) -1) (eq (fga-fresh frame 2500) 1)) 32))
  (let unknown (fga-frame "band" "sample" "new-schema" 10 1000 0 "read" (list)))
  (let b7 (gab-bit (and (eq (fga-fresh unknown 6001) -1) (eq (fga-fresh unknown 1001) 1)) 64))
  (let mismatch (cons (fga-pair "unit" "slots") row))
  (let b8 (gab-bit (str_eq (fga-eval lens mismatch) "binding-mismatch") 128))
  (let badRecipe (cons (fga-pair "op" "host-exec") lens))
  (let b9 (gab-bit (str_eq (fga-eval badRecipe row) "recipe-refused") 256))
  (let many (gab-frame (gab-many 50) 10 1000))
  (let s1 (fga-step (list many) 0 1001 (fga-state-empty)))
  (let s2 (fga-step (list many) 0 1002 s1))
  (let s3 (fga-step (list many) 0 1003 s2))
  ; Physical selected rows, not a claimed benefit: 16 -> 32 -> 50 then settled.
  (let b10 (gab-bit (and (eq (fga-get s1 "before") 16) (and (eq (fga-get s1 "after") 32) (eq (fga-get s1 "gifts") 1))) 512))
  (let b11 (gab-bit (and (eq (fga-get s2 "after") 50) (and (eq (fga-get s3 "gifts") 2) (eq (fga-get s3 "new-events") 0))) 1024))
  (let stage (head (fga-get s1 "stages")))
  (let b12 (gab-bit (and (str_eq (fga-get stage "source") "band") (and (eq (fga-get stage "before") 16) (eq (fga-get stage "after") 32))) 2048))
  ; Rejected expansion leaves the part in place, including an over-limit candidate.
  (let b13 (gab-bit (and (eq (fga-window-choice (list frame) 16 32) 16) (eq (fga-window-choice (list many) 16 128) 16)) 4096))
  (let before (fga-assess-one row (list) lens 1001))
  (let same (fga-assess-one row before lens 1002))
  (let failed (fga-assess-one (cons (fga-pair "lifecycle" "failed") row) before lens 1003))
  (let restored (fga-assess-one row failed lens 1004))
  (let b14 (gab-bit (and (eq (fga-get same "changed") 0) (and (str_eq (fga-get failed "verdict") "organ-failed") (str_eq (fga-get (fga-get restored "event") "reason") "flow-restored"))) 8192))
  (let restart (fga-assess-one (cons (fga-pair "seq" 2) row) before lens 1005))
  (let b15 (gab-bit (str_eq (fga-get (fga-get restart "event") "reason") "channel-restarted") 16384))
  (let newlens (fga-recipe (fga-lens-key mismatch)))
  (let changed (fga-assess-one mismatch before newlens 1005))
  (let b16 (gab-bit (and (str_eq (fga-get (fga-get changed "event") "reason") "grammar-changed") (not (eq (fga-get lens "node") (fga-get newlens "node")))) 32768))
  (let b17 (gab-bit (and (nothing? (fga-get row "note")) (and (nothing? (fga-get row "text")) (nothing? (fga-get row "source-node")))) 65536))
  (let b18 (gab-bit (and (eq (len (fga-external (list "organs" "model"))) 1) (and (eq (len (fga-window (list 1 2 3 4) 3 3)) 3) (eq (nth (fga-window (list 1 2 3 4) 3 3) 1) 1))) 131072))
  (let samples (fga-samples s2 1002 12 "fg-band"))
  (let b19 (gab-bit (and (eq (fgtm-samples-valid? samples) 1) (and (le (len (fga-get s2 "events")) (FGAMaxEvents)) (nothing? (fga-get (fga-details s2) "rows")))) 262144))
  (let eventSample (head (fga-event-samples (list (fga-get failed "event")) 0 1003 12 "fg-band")))
  (let text (fglui-organs-text eventSample 240 1003))
  (let b20 (gab-bit (and (ge (str_find text "band/used" 0) 0) (ge (str_find text "healing actuator" 0) 0)) 524288))
  (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 (add b9 (add b10 (add b11 (add b12 (add b13 (add b14 (add b15 (add b16 (add b17 (add b18 (add b19 b20))))))))))))))))))))
