; glass-sensor-body-scope-band.bml — a sensor's frame is scoped by what it measures.
;
; preludes: form-stdlib/form-glass-sensor-rows.bml
;
; The QUEUE row of observe/form-glass-flow-current-run.fk alternated between two values on
; consecutive reads, and 2026-09-10's receipt named the observer inside the reading as the cause:
; the probe putting its own request on the hearth queue. Measured, that is not what happened. Ten
; runs of the bounded door left the task spool's size and modification time untouched and created
; no spool in this body root at all; the door writes nothing.
;
; What was happening: three sensor fleets stood on this Mac from three checkouts, and all three
; published `glass.sensor.queue` into ONE machine-wide gift frame. The queue sensor counts
; `.hearth/task.spool` — a relative path, so each fleet was counting ITS OWN body's hearth and
; overwriting the others. A reader got whichever wrote last. The rows carried the discriminator
; the whole time: a 1 arrived beside `inactive(no standing hearth; durable spools only)` — a
; six-day-old task frame in the main checkout — and a 0 beside `no durable spools`, a Codex
; worktree with no hearth files at all. Forty ticks of a read-only watch counted 39 word changes
; on the queue rows and 17–18 on each storage catalog row; the storage sensor scans relative
; cache and source roots and had the same collision.
;
; The shard already carried the rule and applied it to one sensor: "another checkout is another
; speaker, not a newer publication of this speaker". The rule is about what a sensor MEASURES, and
; the queue and the storage catalog measure this body. They are scoped now the way the ear is.
;
; Verdict 1023 when every claim lands:
;   1     the ear stays body-local — the sensor this rule was first written for
;   2     the queue is body-local: it counts THIS body's hearth spools
;   4     the storage catalog is body-local: it scans THIS body's cache and source roots
;   8     the machine, host and process sensors stay shared, because the machine is what they measure
;   16    a body-local publisher carries the body root in its name
;   32    a shared publisher carries no body root, so every fleet reads the one machine frame
;   64    two different body roots give a body-local sensor two different publishers
;   128   two different body roots give a SHARED sensor the same publisher — the collision, on purpose
;   256   every publisher, scoped or not, still begins with the one prefix a reader looks for
;   512   the queue and the ear are scoped by the same rule, so their names differ only in the sensor

section [form.bml] {
    def gsbs-bit(ok, weight) = if ok then weight else 0;
    def gsbs-root-a() = "/Users/ursmuff/source/coherence-kernel";
    def gsbs-root-b() = "/Users/ursmuff/source/coherence-kernel/.claude/worktrees/lucid";
    def gsbs-has?(text, needle) = ge(str_find(text, needle, 0), 0);
    def gsbs-score() {
        let queueA = fgsr-publisher-in("queue", gsbs-root-a());
        let queueB = fgsr-publisher-in("queue", gsbs-root-b());
        let earA = fgsr-publisher-in("ear", gsbs-root-a());
        let machineA = fgsr-publisher-in("machine", gsbs-root-a());
        let machineB = fgsr-publisher-in("machine", gsbs-root-b());
        sum(list(
            gsbs-bit(eq(fgsr-body-local?("ear"), 1), 1),
            gsbs-bit(eq(fgsr-body-local?("queue"), 1), 2),
            gsbs-bit(eq(fgsr-body-local?("storage"), 1), 4),
            gsbs-bit(and(eq(fgsr-body-local?("machine"), 0), and(eq(fgsr-body-local?("host"), 0), eq(fgsr-body-local?("process"), 0))), 8),
            gsbs-bit(and(gsbs-has?(queueA, gsbs-root-a()), gsbs-has?(queueA, "@")), 16),
            gsbs-bit(and(not(gsbs-has?(machineA, gsbs-root-a())), not(gsbs-has?(machineA, "@"))), 32),
            gsbs-bit(not(str_eq(queueA, queueB)), 64),
            gsbs-bit(str_eq(machineA, machineB), 128),
            gsbs-bit(and(eq(str_find(queueA, FGSRPublisherPrefix(), 0), 0), eq(str_find(machineA, FGSRPublisherPrefix(), 0), 0)), 256),
            gsbs-bit(and(str_eq(queueA, fgtm-cat(list(FGSRPublisherPrefix(), "queue@", gsbs-root-a()))), str_eq(earA, fgtm-cat(list(FGSRPublisherPrefix(), "ear@", gsbs-root-a())))), 512)
        ));
    }
    gsbs-score();
}
