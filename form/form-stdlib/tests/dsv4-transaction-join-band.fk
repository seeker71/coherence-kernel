; Cached DS4 transaction chunks use the balanced Form join.  Prove byte order,
; uneven-tail preservation, empty identity, and the compact position splice.
;
; preludes: native/metal/dsv4-layer-walk.fk

(if (and
        (eq (dlw-join-parts (list "a" "b" "c" "d" "e")) "abcde")
        (and
            (eq (dlw-join-parts (list)) "")
            (eq
                (dlw-join-parts
                    (list "rope " (int_to_str 17) " cache " (int_to_str 17)))
                "rope 17 cache 17")))
    255
    0)
