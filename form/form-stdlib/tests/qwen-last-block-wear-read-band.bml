// qwen-last-block-wear-read-band.bml — what the wear reads, with no model: the adapter's naming, the refusals, the dispatch lists, the voice door's request, the decision.
//   1   la-layers reads blk.N: a header naming blk.63 reads layers [63, 63], one naming blk.60 and blk.63 reads [60, 63], the 3B's model.layers.N still reads
//   2   an adapter directory that does not stand is refused by name: the file absent, the config absent, a layer the head does not read next, a wrong shape, an F16 tensor;
//       a whole one reads ""; qlwe-own-bytes counts the file and u at the span
//   4   the dispatch lists: a bare layer's FFN, full-attention and linear-attention records are the same whether or not a table carries an empty entry; a record on ffn_down adds
//       exactly its two dispatches after the residual add on the FFN alone, one on attn_output on the full block alone, one on ssm_out on the linear block alone; the walkers
//       read 11 and 14 tensors from an adapted layer; a planar table keeps the wear entry; q38-ctx-wear reads the 12th slot and [] from an opened context
//   8   the voice door: an absent adapter answers unavailable and names it with no model opened; a request naming none, with no registry row, reads the bare lane; "adapter":"" is
//       the bare lane named out loud; a named one is [directory, scale]; the registry's last row for the model decides, wear 0 is the bare lane; a row that says wear 1 passes the wear's
//       stand only when the directory's bytes read the row's adapter_sha256, and a row naming other bytes or no adapter refuses by name
//  16   the decision door over fixture ledgers (run as a child): a candidate that meets the rule reads wear, with the registry row wear 1; one whose answers lose a
//       predicate reads hold and names the rule; one whose answers fall to half the words reads hold by W6; an absent arm is refused by name, exit 1, and no decision row lands
// Verdict 31. No model, no device: every list here is data.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/memory-governor.bml form-stdlib/form-cli-model-session.fk form-stdlib/bml/qwen-last-block-wear.bml form-stdlib/bml/form-cli-native-voice.bml form-stdlib/bml/host-child.bml form-stdlib/bml/ledger.bml
section [form.bml] {
 class QwenLastBlockWearReadBand {
  def qlwr-home() = ".hearth/qwen-last-block-wear-read-band";
  def qlwr-say(s) = print_str("[qwen-last-block-wear-read-band] " ++ s);
  def qlwr-at(leaf) = qlwr-home() ++ "/" ++ leaf;
  // ---- bit 1: the naming ----
  def qlwr-hdr(names) = "{" ++ str-join-with(map(n => "\"" ++ n ++ "\":{\"dtype\":\"F32\",\"shape\":[4,2],\"data_offsets\":[0,32]}", names), ",") ++ "}";
  def qlwr-bit1() {
   let one = la-layers(qlwr-hdr(["blk.63.ffn_down.weight.lora_a", "blk.63.ffn_down.weight.lora_b"]));
   let two = la-layers(qlwr-hdr(["blk.60.ffn_down.weight.lora_a", "blk.63.ffn_down.weight.lora_b"]));
   let old = la-layers(qlwr-hdr(["base_model.model.layers.20.self_attn.q_proj.lora_a", "base_model.model.layers.27.self_attn.q_proj.lora_b"]));
   let none = la-layers(qlwr-hdr(["output.weight.lora_a"]));
   qlwr-say("la-layers: " ++ one.str() ++ " " ++ two.str() ++ " " ++ old.str() ++ " " ++ none.str());
   (Value) one == [63, 63] && (Value) two == [60, 63] && (Value) old == [20, 27] && (Value) none == [-1, -1];
  }
  // ---- bit 2: the refusals, on a fixture block: d 3, ff 4, rank 2, 4 layers ----
  def qlwr-geo() = map(i => (Comparable) i == 0 ? 3 : (Comparable) i == 10 ? 4 : (Comparable) i == 21 ? 4 : (Comparable) i == 22 ? 4 : 1, range(0, 24));
  def qlwr-a() = [0.5, -0.5, 0.25, -0.25, 0.125, -0.125, 1.0, -1.0];
  def qlwr-b() = [0.1, 0.2, 0.3, -0.1, -0.2, -0.3];
  def qlwr-cfg(layer, target) = "{\"model\":\"fixture\",\"lora_parameters\":{\"rank\":2,\"alpha\":4.0,\"scale\":2.0,\"dropout\":0.0},\"layers\":[" ++ layer.str() ++ "],\"targets\":[\"" ++ target ++ "\"],\"data\":\"fixture\",\"rows\":[1],\"ids_cap\":16,\"mask_prompt\":1,\"trained_native_steps\":1,\"batch_size\":1,\"mean_loss_step0\":1.0,\"mean_loss_step20\":0.5,\"worn\":0}\n";
  def qlwr-an(L) = qlh-rr-name(L, "ffn_down", "a");
  def qlwr-bn(L) = qlh-rr-name(L, "ffn_down", "b");
  def qlwr-dir(leaf) = (Comparable) host_dir_mkdir(qlwr-at(leaf)) == 1 || (Comparable) host_path_is_dir(qlwr-at(leaf)) == 1 ? qlwr-at(leaf) : form_error("wear read band: " ++ qlwr-at(leaf) ++ " did not make");
  def qlwr-fixture(leaf, L, aShape, target) {
   let dir = qlwr-dir(leaf);
   let p = ln-write(qlbj-st(dir), [[qlwr-an(L), aShape, qlwr-a()], [qlwr-bn(L), [2, 3], qlwr-b()]]);
   let c = write_file_text(qlbj-cfg(dir), qlwr-cfg(L, target));
   dir;
  }
  def qlwr-has?(hay, needle) = str_find(hay, needle, 0) >= 0;
  def qlwr-bit2() {
   let geo = qlwr-geo();
   let good = qlwr-fixture("good", 3, [4, 2], "ffn_down");
   let wrongLayer = qlwr-fixture("layer", 2, [4, 2], "ffn_down");
   let wrongShape = qlwr-fixture("shape", 3, [2, 4], "ffn_down");
   let wrongTarget = qlwr-fixture("target", 3, [4, 2], "attn_output");
   let empty = qlwr-dir("nofile");
   let noCfg = qlwr-dir("nocfg");
   let noCfgP = ln-write(qlbj-st(noCfg), [[qlwr-an(3), [4, 2], qlwr-a()], [qlwr-bn(3), [2, 3], qlwr-b()]]);
   let w0 = qlwe-why(good, geo);
   let w1 = qlwe-why(empty, geo);
   let w2 = qlwe-why(noCfg, geo);
   let w3 = qlwe-why(wrongLayer, geo);
   let w4 = qlwe-why(wrongShape, geo);
   let w5 = qlwe-why(wrongTarget, geo);
   let said = map(w => qlwr-say("reads: " ++ (len(w) == 0 ? "stands" : w)), [w0, w1, w2, w3, w4, w5]);
   let own = qlwe-own-bytes([good, nothing()], 8);
   (String) w0 == "" && qlwr-has?(w1, "is absent") && qlwr-has?(w1, "adapters.safetensors") && qlwr-has?(w2, "adapter_config.json") && qlwr-has?(w2, "is absent") && qlwr-has?(w3, "the lane wears the block the head reads next, 3") && qlwr-has?(w4, "has shape [2, 4]; the block's pair wants [4, 2]") && qlwr-has?(w5, "the one slot the judge carries") && (Comparable) own == file_size(qlbj-st(good)) + 2 * 8 * 4;
  }
  // ---- bit 4: the dispatch lists, on fake handles ----
  def qlwr-ps() = range(1000, 1090);
  def qlwr-bs() = range(2000, 2040);
  def qlwr-gg() = map(i => 16 + i, range(0, 24));
  def qlwr-tv(h) = [h, 16, 16, 8];
  def qlwr-tvs(n) = map(i => qlwr-tv(3000 + i), range(0, n));
  def qlwr-rec(slot) = [slot, 7001, 7002, 7003, 7004, 7005, 16, 2, 16, 1065353216, 8];
  def qlwr-st() = [1, 2, 3, 4];
  def qlwr-bit4() {
   let ps = qlwr-ps();
   let bs = qlwr-bs();
   let geo = qlwr-gg();
   let full = qlwr-tvs(11);
   let lin = qlwr-tvs(14);
   let fullEmpty = append(full, [[]]);
   let linEmpty = append(lin, [[]]);
   let ffnWorn = append(full, [[qlwr-rec(4)]]);
   let attnWorn = append(full, [[qlwr-rec(10)]]);
   let ssmWorn = append(lin, [[qlwr-rec(13)]]);
   let bareFfn = q38-ffn-recs(ps, bs, geo, full);
   let barePost = q38-full-attn-post-recs(ps, bs, geo, full);
   let bareLin = q38-linear-attn-recs(ps, bs, geo, lin, qlwr-st());
   let emptySame = (Value) q38-ffn-recs(ps, bs, geo, fullEmpty) == bareFfn && (Value) q38-full-attn-post-recs(ps, bs, geo, fullEmpty) == barePost && (Value) q38-linear-attn-recs(ps, bs, geo, linEmpty, qlwr-st()) == bareLin;
   let ffn = q38-ffn-recs(ps, bs, geo, ffnWorn);
   let post = q38-full-attn-post-recs(ps, bs, geo, attnWorn);
   let ssm = q38-linear-attn-recs(ps, bs, geo, ssmWorn, qlwr-st());
   let added = len(ffn) == len(bareFfn) + 2 && (Value) take(len(bareFfn), ffn) == bareFfn && len(post) == len(barePost) + 2 && (Value) take(len(barePost), post) == barePost && len(ssm) == len(bareLin) + 2 && (Value) take(len(bareLin), ssm) == bareLin;
   let elsewhere = (Value) q38-full-attn-post-recs(ps, bs, geo, ffnWorn) == barePost && (Value) q38-ffn-recs(ps, bs, geo, attnWorn) == bareFfn;
   let pipes = (Comparable) ffn[len(bareFfn)][0] == 7001 && (Comparable) ffn[len(bareFfn) + 1][0] == 7002;
   let tvs = (Comparable) len(q38-lay-tvs(ffnWorn)) == 11 && (Comparable) len(q38-lay-tvs(ssmWorn)) == 14 && (Comparable) len(q38-lay-tvs(full)) == 11 && (Comparable) len(q38-lay-wear(full)) == 0 && (Comparable) len(q38-lay-wear(ffnWorn)) == 1;
   let counts = (Comparable) q38-layer-handle-count([ffnWorn, ssmWorn]) == 25 && (Comparable) q38-layers-storage-bytes([ffnWorn]) == q38-layers-storage-bytes([full]);
   let ctxWear = (Comparable) len(q38-ctx-wear(range(0, 11))) == 0 && (Comparable) q38-ctx-wear(append(range(0, 11), [[1, 2]]))[1] == 2 && (Comparable) len(q38-ctx-wear(range(0, 13))) == 0;
   qlwr-say("dispatch lists: bare FFN " ++ len(bareFfn).str() ++ ", attention post " ++ len(barePost).str() ++ ", linear " ++ len(bareLin).str() ++ "; an empty entry changes nothing " ++ emptySame.str() ++ "; a record adds two after the residual add " ++ added.str() ++ ", on its own slot alone " ++ elsewhere.str() ++ ", the record's pipelines " ++ pipes.str() ++ "; walkers " ++ tvs.str() ++ ", counts " ++ counts.str() ++ ", the context's wear " ++ ctxWear.str());
   emptySame && added && elsewhere && pipes && tvs && counts && ctxWear;
  }
  // ---- bit 8: the voice door's request ----
  def qlwr-req(text) = parse-json("wear-request", text);
  def qlwr-bit8() {
   let refused = fcnv-run-wearing("a packet", "/absent/model.gguf", nothing(), 8, ["/absent/adapter", nothing()]);
   let bare = fcnv-wear(qlwr-req("{\"model\":\"qwen38-q8\"}"), "qwen38-q8");
   let empty = fcnv-wear(qlwr-req("{\"model\":\"qwen38-q8\",\"adapter\":\"\"}"), "qwen38-q8");
   let named = fcnv-wear(qlwr-req("{\"adapter\":\"a/dir\",\"adapter_scale\":0}"), "qwen38-q8");
   let plain = fcnv-wear(qlwr-req("{\"adapter\":\"a/dir\"}"), "qwen38-q8");
   let w = write_file_text(qlwr-at("registry.jsonl"), "{\"model\":\"qwen38-q8\",\"adapter\":\"old\",\"adapter_sha256\":\"x\",\"wear\":1}\n{\"model\":\"qwen38-q4\",\"adapter\":\"other\",\"adapter_sha256\":\"x\",\"wear\":1}\n{\"model\":\"qwen38-q8\",\"adapter\":\"new\",\"adapter_sha256\":\"y\",\"wear\":1}\n");
   let reg = fcnv-wear-registered(qlwr-at("registry.jsonl"), "qwen38-q8");
   let w0 = write_file_text(qlwr-at("registry-off.jsonl"), "{\"model\":\"qwen38-q8\",\"adapter\":\"new\",\"adapter_sha256\":\"y\",\"wear\":1}\n{\"model\":\"qwen38-q8\",\"adapter\":\"new\",\"adapter_sha256\":\"y\",\"wear\":0}\n");
   let off = fcnv-wear-registered(qlwr-at("registry-off.jsonl"), "qwen38-q8");
   let absent = fcnv-wear-registered(qlwr-at("no-registry.jsonl"), "qwen38-q8");
   let good = qlwr-at("good");
   let goodSha = hex-encode(sha256-stream-string(read_file(qlbj-st(good)) ?? ""));
   let wWit = write_file_text(qlwr-at("registry-witnessed.jsonl"), "{\"model\":\"qwen38-q8\",\"adapter\":\"" ++ good ++ "\",\"adapter_sha256\":\"" ++ goodSha ++ "\",\"wear\":1}\n");
   let wOther = write_file_text(qlwr-at("registry-other.jsonl"), "{\"model\":\"qwen38-q8\",\"adapter\":\"" ++ good ++ "\",\"adapter_sha256\":\"0000\",\"wear\":1}\n");
   let wNone = write_file_text(qlwr-at("registry-unnamed.jsonl"), "{\"model\":\"qwen38-q8\",\"wear\":1}\n");
   let witnessed = fcnv-run-wearing("a packet", "/absent/model.gguf", nothing(), 8, fcnv-wear-registered(qlwr-at("registry-witnessed.jsonl"), "qwen38-q8"));
   let otherBytes = fcnv-run-wearing("a packet", "/absent/model.gguf", nothing(), 8, fcnv-wear-registered(qlwr-at("registry-other.jsonl"), "qwen38-q8"));
   let unnamed = fcnv-run-wearing("a packet", "/absent/model.gguf", nothing(), 8, fcnv-wear-registered(qlwr-at("registry-unnamed.jsonl"), "qwen38-q8"));
   qlwr-say("registry row, the bytes it witnessed: " ++ witnessed[7] ++ "; other bytes: " ++ otherBytes[7] ++ "; no adapter: " ++ unnamed[7]);
   qlwr-say("absent adapter: " ++ refused[0] ++ ", " ++ refused[7]);
   (String) refused[0] == "unavailable" && str_find(refused[7], "adapter-wear-refused: worn adapter /absent/adapter/adapters.safetensors is absent", 0) == 0 && (nothing?(bare) || file_size(fcnv-wear-registry()) > 0) && nothing?(empty) && (String) named[0] == "a/dir" && named[1] == 0.0 && (String) plain[0] == "a/dir" && nothing?(plain[1]) && (String) reg[0] == "new" && nothing?(reg[1]) && nothing?(off) && nothing?(absent) && (String) witnessed[7] == "registry-model-artifact-absent" && str_find(otherBytes[7], "the registry row witnessed \"0000\"", 0) >= 0 && str_find(otherBytes[7], "adapter-wear-refused: ", 0) == 0 && str_find(unnamed[7], "adapter-wear-refused: worn adapter /adapters.safetensors is absent", 0) == 0;
  }
  // ---- bit 16: the decision door over fixture ledgers ----
  def qlwr-axes() = ["core values", "protocols", "interfaces", "capabilities", "tone of voice", "core features", "core principles"];
  def qlwr-scen(id, words, passed, total, failed) = "{\"id\":\"" ++ id ++ "\",\"status\":\"answered\",\"words\":" ++ words.str() ++ ",\"passed\":" ++ passed.str() ++ ",\"total\":" ++ total.str() ++ ",\"failed\":[" ++ str-join-with(map(f => "\"" ++ f ++ "\"", failed), ",") ++ "]}";
  def qlwr-arm(label, role, adapter, sha, passed, total, scen) = "{\"at_unix_ms\":1000000,\"model\":\"qwen38-q8\",\"prompt_variant\":\"" ++ label ++ "\",\"prompt_digest\":\"d\",\"fixtures\":\"" ++ qlwr-at("sets.jsonl") ++ "\",\"scenarios\":1,\"predicates_total\":" ++ total.str() ++ ",\"predicates_passed\":" ++ passed.str() ++ ",\"per_scenario\":[" ++ scen ++ "],\"wall_ms\":1,\"rent_tokens\":0,\"role\":\"" ++ role ++ "\",\"adapter\":\"" ++ adapter ++ "\",\"adapter_sha256\":\"" ++ sha ++ "\",\"adapter_scale\":\"config\"}\n";
  // the fixture scenario: 20 predicates, the first a lacks, the rest named; their axes turn through the seven
  def qlwr-preds() = cons("lacks:perl", map(i => "contains:p" ++ i.str(), range(1, 20)));
  def qlwr-quoted(xs) = str-join-with(map(x => "\"" ++ x ++ "\"", xs), ",");
  def qlwr-fails(lo, hi) = map(i => "contains:p" ++ i.str(), range(lo, hi));
  def qlwr-door(name, request) {
   let base = qlwr-at(name);
   let w = write_file_text(base ++ ".in", request);
   let pid = host_spawn_at(["./fkwu", "observe/qwen-last-block-wear-run.bml"], [base ++ ".in", base ++ ".out", base ++ ".err"]);
   let status = pid <= 0 ? -1 : host_wait(pid);
   [status, read_file(base ++ ".out") ?? "", read_file(base ++ ".err") ?? ""];
  }
  def qlwr-req-of(dir, name, liveLabel) = "{\"adapter\":\"" ++ dir ++ "\",\"fixtures\":\"" ++ qlwr-at("sets.jsonl") ++ "\",\"bare_live\":\"bl\",\"bare_none\":\"bn\",\"worn_live\":\"" ++ liveLabel ++ "\",\"worn_none\":\"wn\",\"ledger\":\"" ++ qlwr-at("ledger.jsonl") ++ "\",\"axes\":\"" ++ qlwr-at("axes.jsonl") ++ "\",\"promotion\":\"" ++ qlwr-at("promotion.jsonl") ++ "\",\"band_receipt\":\"" ++ qlwr-at("receipt.json") ++ "\",\"decisions\":\"" ++ qlwr-at("decisions-" ++ name ++ ".jsonl") ++ "\",\"answers\":\"\"}\n";
  def qlwr-bit16() {
   let dir = qlwr-at("good");
   let sha = hex-encode(sha256-stream-string(read_file(qlbj-st(dir)) ?? ""));
   let ok = qlwr-scen("a", 20, 20, 20, []);
   let bad = qlwr-scen("a", 20, 19, 20, ["lacks:perl"]);
   let s = write_file_text(qlwr-at("sets.jsonl"), "{\"id\":\"a\",\"tongue\":\"en\",\"person_says\":\"say\",\"context\":\"\",\"predicates\":[" ++ qlwr-quoted(qlwr-preds()) ++ "]}\n");
   let l = write_file_text(qlwr-at("ledger.jsonl"), qlwr-arm("bl", "live", "", "", 20, 20, ok) ++ qlwr-arm("bn", "none", "", "", 10, 20, qlwr-scen("a", 30, 10, 20, qlwr-fails(1, 11))) ++ qlwr-arm("wl", "live", dir, sha, 20, 20, ok) ++ qlwr-arm("wbad", "live", dir, sha, 19, 20, bad) ++ qlwr-arm("wshort", "live", dir, sha, 20, 20, qlwr-scen("a", 10, 20, 20, [])) ++ qlwr-arm("wn", "none", dir, sha, 14, 20, qlwr-scen("a", 30, 14, 20, qlwr-fails(1, 7))));
   let a = write_file_text(qlwr-at("axes.jsonl"), "{\"id\":\"a\",\"axes\":[" ++ qlwr-quoted(map(i => nth(qlwr-axes(), i % 7), range(0, 20))) ++ "]}\n");
   let p = write_file_text(qlwr-at("promotion.jsonl"), "{\"child_sha256\":\"" ++ sha ++ "\",\"better\":1,\"parent_loss\":2.5,\"child_loss\":2.0,\"rejected_heldout_parent_loss\":2.0,\"rejected_heldout_child_loss\":2.1}\n");
   let r = write_file_text(qlwr-at("receipt.json"), "{\"speed_ratio\":1.01}\n");
   let wear = qlwr-door("wear", qlwr-req-of(dir, "wear", "wl"));
   let hold = qlwr-door("hold", qlwr-req-of(dir, "hold", "wbad"));
   let short = qlwr-door("short", qlwr-req-of(dir, "short", "wshort"));
   let miss = qlwr-door("miss", qlwr-req-of(dir, "miss", "no-such-label"));
   let said = map(x => qlwr-say(x), [wear[1], hold[1], miss[1] ++ miss[2]]);
   (Comparable) wear[0] == 0 && qlwr-has?(wear[1], "decision: wear") && qlwr-has?(wear[1], "\"wear\":1") && (Comparable) hold[0] == 0 && qlwr-has?(hold[1], "decision: hold, refused by W2 W6") && qlwr-has?(hold[1], "\"wear\":0") && qlwr-has?(hold[1], "a: lacks:perl") && (Comparable) short[0] == 0 && qlwr-has?(short[1], "decision: hold, refused by W6") && (Comparable) miss[0] != 0 && qlwr-has?(miss[1] ++ miss[2], "no-such-label") && file_size(qlwr-at("decisions-miss.jsonl")) < 1 && file_size(qlwr-at("decisions-wear.jsonl")) > 0;
  }
  def qlwr-run() {
   let gone = host_dir_rmdir(qlwr-home());
   let made = host_dir_mkdir(qlwr-home());
   let b1 = qlwr-bit1() ? 1 : 0;
   let b2 = qlwr-bit2() ? 2 : 0;
   let b4 = qlwr-bit4() ? 4 : 0;
   let b8 = qlwr-bit8() ? 8 : 0;
   let b16 = qlwr-bit16() ? 16 : 0;
   qlwr-say("bits " ++ b1.str() ++ " " ++ b2.str() ++ " " ++ b4.str() ++ " " ++ b8.str() ++ " " ++ b16.str());
   let cleaned = host_dir_rmdir(qlwr-home());
   b1 + b2 + b4 + b8 + b16;
  }
 }
 qlwr-run();
}
