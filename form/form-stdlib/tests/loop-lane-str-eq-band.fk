; loop-lane-str-eq-band.fk -- str_eq of two string PARAMETERS crystallizes (kind 35): interned strings make
; content equality a compare of the two frame words. A FIELD-STRING GUARD (emit): when the words differ and
; either is a field string (word <= T, i.e. si >= FK_STR_BASE), the leaf leaves for the overflow block and the
; walker does the byte walk -- only two differing LOCAL words answer 0. This band pins the LOCAL behaviour and
; crystallization; the field-string leg (a string read back across the carrier, compared to a local copy of the
; same bytes, answering 1 warm) needs a multi-process carrier fixture (see loop-lane-str-eq-field-band).
;
; Verdict 15
; PROOF LEVEL: FOURTH-ARM ONLY (crystallization is fkwu's MAP_JIT lane; native state is the 8th hot-row field)
; preludes: form-stdlib/core.fk
;
;   1  a str_eq fold over two string params crystallizes (state 2)
;   2  it answers correctly: equal params -> the count, unequal -> 0, warm
;   4  the warm result matches a poisoned-walker twin over a swept range
;   8  str_eq reached THROUGH THE CALL ARM (a caller leaf hands its params down) answers as the walker for
;      equal words, differing words and a literal argument -- the call arm copies the string words to 24+k
;      (sig bit 31); before that fix a caller leaf compared stale words (a witnessed miscompile)
(do
    (defn se-bit (ok b) (if ok b 0))
    (defn se-state (name rows) (if (eq (len rows) 0) -99 (if (str_eq (nth (head rows) 1) name) (nth (head rows) 7) (se-state name (tail rows)))))
    (defn seq (n a b acc) (if (le n 0) acc (seq (sub n 1) a b (if (str_eq a b) (add acc 1) acc))))
    (defn seqw (n a b acc) (if (lt (host_monotonic_ms) 0) acc (if (le n 0) acc (seqw (sub n 1) a b (if (str_eq a b) (add acc 1) acc)))))
    (defn seqv (a b) (seq 5 a b 0))          ; a caller leaf: str_eq reached through the call arm, params handed down
    (defn seqlit (a) (seq 5 a "lit" 0))      ; a caller leaf passing a LITERAL argument to str_eq
    (defn heatv (n acc) (if (le n 0) acc (heatv (sub n 1) (add acc (add (seqv "xy" "xy") (add (seqv "xy" "yz") (add (seqlit "lit") (seqlit "no"))))))))
    (let heat (add (seq 40000 "hello" "hello" 0) (add (seq 40000 "hello" "world" 0) (heatv 20000 0))))
    (let rows (kernel_page_hot (host_pid) 900))
    (let cryst-ok (eq (se-state "seq" rows) 2))
    (let ans-ok (if (eq (seq 5 "ab" "ab" 0) 5) (if (eq (seq 5 "ab" "cd" 0) 0) (eq (seq 3 "" "" 0) 3) false) false))
    (defn sweep (i n bad) (if (ge i n) bad (sweep (add i 1) n (if (eq (seq 7 (int_to_str i) (int_to_str (mul i 1)) 0) (seqw 7 (int_to_str i) (int_to_str i) 0)) bad (add bad 1)))))
    (let equiv-ok (eq (sweep 0 2000 0) 0))
    ; bit 8: through the call arm -- equal, differing, and a literal argument, warm, as the walker answers
    (let via-ok (if (eq (se-state "seqv" rows) 1)
                (if (eq (seqv "xy" "xy") 5) (if (eq (seqv "xy" "yz") 0)
                (if (eq (seqlit "lit") 5) (eq (seqlit "no") 0) false) false) false) false))
    (add (se-bit cryst-ok 1) (add (se-bit ans-ok 2) (add (se-bit equiv-ok 4) (se-bit via-ok 8))))
)
