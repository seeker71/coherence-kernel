; form-terminal-columns-band.fk — columns measured from their content.
;
; The glass had fgd-pad-right and fgd-fit and no notion of a COLUMN: a width
; measured from the cells that will sit in it, fitted to the space actually
; available, with each cell justified inside its own column. Without that,
; alignment is bought with whitespace instead of with measurement — a half
; padded to thirty-nine leaves a gutter whenever the reading is short.
;
; Bit 8 is the one this door was written for. Slack goes ONLY to a column that
; asked for it. The first version of this model handed the remainder to the last
; column and put thirty-one blanks between "gpu" and "80M" — the exact gutter it
; existed to remove.
;
; Expected: 127
;
;   1    a column carries what it asks for, how it justifies, and whether it may
;        give way; auto asks to be measured, fixed does not, fill may grow
;   2    a cell justifies left, right and centre inside its own width, and a
;        cell wider than its column is CUT rather than allowed to shove its
;        neighbours onto different columns on that row alone
;   4    a column's natural width is its widest cell; a declared want overrides
;        measurement and an absent cell measures nothing
;   8    NOBODY IS INFLATED PAST CONTENT. With no fill column the widths stay
;        natural; with one, that column and only that column takes the slack
;   16   when it does not fit, the FLEXIBLE columns give way in proportion and a
;        fixed column keeps its width — shrinking all equally kills the small
;        columns first
;   32   a line rendered to a width is EXACTLY that width, padded at its tail
;        where blank separates nothing, and empty cells do not change it
;   64   a whole table renders at once and every row of it is the same width
;
; preludes: form/form-stdlib/form-terminal-columns.bml

(do
    (defn xb (ok bit) (if ok bit 0))
    (defn bar () "|")

    (let a (ftb-auto "left"))
    (let r (ftb-auto "right"))
    (let f (ftb-fixed 6 "centre"))
    (let g (ftb-fill "right"))
    (let b1 (xb (and (eq (ftb-col-want a) -1)
                (and (eq (ftb-col-want f) 6)
                (and (str_eq (ftb-col-justify r) "right")
                (and (eq (ftb-col-flex a) 1)
                (and (eq (ftb-col-flex f) 0)
                (and (eq (ftb-col-flex g) 2)
                (and (eq (ftb-col? a) 1)
                     (eq (ftb-col? (list "no")) 0)))))))) 1))

    (let b2 (xb (and (str_eq (ftb-cell "ab" 5 "left") "ab   ")
                (and (str_eq (ftb-cell "ab" 5 "right") "   ab")
                (and (str_eq (ftb-cell "ab" 6 "centre") "  ab  ")
                (and (str_eq (ftb-cell "abcdefgh" 3 "left") "abc")
                (and (str_eq (ftb-cell "" 3 "left") "   ")
                     (str_eq (ftb-cell "x" 0 "left") "")))))) 2))

    (let rows (list (list "gpu" "80M") (list "arena" "2M") (list "q" "0")))
    (let cols (list a r))
    (let nat (ftb-natural cols rows 0 (list)))
    (let b3 (xb (and (eq (nth nat 0) 5)
                (and (eq (nth nat 1) 3)
                (and (eq (nth (ftb-natural (list f) rows 0 (list)) 0) 6)
                     (eq (ftb-widest (list (list "a")) 1 0) 0)))) 4))

    ; ---- nobody is inflated past content unless they asked
    (let wide (ftb-fit cols rows 40 1))
    (let filled (ftb-fit (list a g) rows 40 1))
    (let b4 (xb (and (eq (nth wide 0) 5)
                (and (eq (nth wide 1) 3)
                (and (eq (nth filled 0) 5)
                     (eq (add (add (nth filled 0) (nth filled 1)) 1) 40)))) 8))

    ; ---- does not fit: flexible give way, fixed holds
    (let mixed (list (ftb-fixed 6 "left") (ftb-auto "left") (ftb-auto "left")))
    (let mrows (list (list "fixed6" "aaaaaaaaaa" "bbbbbbbbbb")))
    (let tight (ftb-fit mixed mrows 20 1))
    (let b5 (xb (and (eq (nth tight 0) 6)
                (and (lt (nth tight 1) 10)
                (and (lt (nth tight 2) 10)
                     (ge (nth tight 1) 1)))) 16))

    ; ---- a line rendered to a width is exactly that width
    (let lineWide (ftb-line-to cols wide (list "gpu" "80M") (bar) 40))
    (let lineTight (ftb-line-to mixed tight (list "fixed6" "aaaaaaaaaa" "bbbbbbbbbb") (bar) 20))
    (let b6 (xb (and (eq (str_len lineWide) 40)
                (and (eq (str_len lineTight) 20)
                (and (eq (str_len (ftb-line-to cols wide (list "q" "0") (bar) 40)) 40)
                     (eq (str_len (ftb-line-to cols wide (list "" "") (bar) 40)) 40)))) 32))

    ; ---- the whole table, one separator of whitespace between columns
    (let table (ftb-table cols rows 40 (bar)))
    (let b7 (xb (and (eq (len table) 3)
                (and (eq (str_len (head table)) 40)
                (and (eq (str_len (nth table 2)) 40)
                     (eq (str_len (nth table 1)) (str_len (head table)))))) 64))

    (print (list "natural" nat "no-fill" wide "with-fill" filled "tight" tight))
    (print (head table))
    (print lineTight)
    (sum (list b1 b2 b3 b4 b5 b6 b7)))
