; preludes: form-stdlib/core.fk
;
; no-fixed-tables-band.fk — the seed's tables GROW; none is a wall
; (2026-08-27: the function table; 2026-09-03: the last fixed arrays), and
; the proof that it mattered is the body's own voice.
;
; FK_FN_CAP (4096 function seats) is the wall that made the flatten table look
; necessary. form-cli's preludes closure needs 4101 seats, so `repl` itself was
; never registered: `printf 'ping\n' | ./form/form-cli` answered `nothing`,
; rc 1, with five [fn-cap] errors above it. The seed's own comments had already
; written this receipt twice — 256 -> 4096 on 2026-07-02 after a 258-defn chain
; returned garbage. Growth ends the series. The fn-value sentinel band tracks
; the live capacity (fk_is_fnval), so the encoding stays collision-proof.
;
; 2026-09-03: the four arrays still fixed after the wallshed/shedwave wave
; became birth sizes that double, each with its pulse in kernel_stat:
;   socket handles        31/32   (was a fixed 1024: the 1025th answered -1, no word)
;   parse-save stack      33/34   (was a fixed 128 AND a single buffer: overran
;                                  silently past 128, and nested defns clobbered
;                                  each other's saved scope)
;   list-print nesting    35/36   (was a chosen 1024-level die in the printer)
;   conf entries / bytes  37..40  (keys and values were cut at 64 / 4096, silently)
;
; The record store (FK_RECORD_CAP 256 / FK_RECORD_MAX_KEYS 128) grew in the
; same sitting — the literal died loud at both caps while record_set silently
; dropped key 129. That heal is NOT asserted here: fkwu's parser mints no
; record-literal node (grep: no tag-64 mint), so records reach this arm only
; through images and a source band cannot honestly exercise it. Named pending
; rather than claimed.
;
; PROOF LEVEL: FOURTH-ARM ONLY — Verdict 63; go answers 0 (witnessed 2026-09-03). An fkwu seed capacity; the sibling kernels
; carry no such table. Run from the repo root (host-exec runs there):
;   ./fkwu form/form-stdlib/tests/no-fixed-tables-band.fk
; Bits 4 and 8..32 need the host to grant 1100 open sockets (ulimit -n) and a
; writable form/form-stdlib/.cache; a host that cannot reads 0 on that bit,
; honestly.
;
; Bits (power-of-two weights):
;   1  a 4600-defn program registers past the old 4096 seat wall and its LAST
;      defn answers 4600 (= 1 + 4599) — the seat that used to be refused
;   2  the body SPEAKS through the source runner: printf 'ping' into
;      ./form/form-cli answers a line `pong`, no flatten table anywhere in the path
;   4  socket handles: 1100 live listeners in one run — every handle >= 1, every
;      close 0, kernel_stat 31/32 = 2048/1 (doubled once past the old 1024)
;   8  parse-save stack: 1100 bindings in scope around a nested defn still
;      resolve (1101) with kernel_stat 33/34 = 2048/1, and a defn nested inside
;      a defn's do hands the outer scope back whole (9)
;  16  list printer: a list nested 1100 deep prints whole — 2204 bytes on the
;      wire, where the old recursion died at 1024 levels
;  32  conf: 70 entries holding a 100-byte key and a 20000-byte value pulse
;      [128, 1, 32768, 3] through kernel_stat 37..40 — a value cut at the old
;      4096 width could not have doubled the byte pool three times
; witnessed: 2026-08-28 -> 3; 2026-09-03 -> 63
(do
    (defn nft-line-go (s i n)
        (if (ge i n) (substring s 0 n)
            (if (eq (str_byte_at s i) 10) (substring s 0 i)
                (nft-line-go s (add i 1) n))))
    (defn nft-line (s) (if (nothing? s) "" (nft-line-go s 0 (str_len s))))
    (defn nft-has-line-go (s i start n t)
        (if (ge i n) (str_eq (substring s start n) t)
            (if (eq (str_byte_at s i) 10)
                (if (str_eq (substring s start i) t) 1 (nft-has-line-go s (add i 1) (add i 1) n t))
                (nft-has-line-go s (add i 1) start n t))))
    (defn nft-has-line (s t) (if (nothing? s) 0 (nft-has-line-go s 0 0 (str_len s) t)))

    (let seats (host-exec "mkdir -p form/form-stdlib/.cache && awk 'BEGIN{printf \"(do \"; for(i=0;i<4600;i++) printf \"(defn nftq%d (x) (add x %d))\", i, i; printf \"(nftq4599 1))\"}' > form/form-stdlib/.cache/nft-seats.fk && ./fkwu form/form-stdlib/.cache/nft-seats.fk 2>/dev/null; rm -f form/form-stdlib/.cache/nft-seats.fk form/form-stdlib/.cache/nft-seats.fkb form/form-stdlib/.cache/nft-seats.sym" ""))
    (let c0 (if (eq (str_to_int (nft-line seats)) 4600) 1 0))

    (let voice (host-exec "printf 'ping\n' | ./form/form-cli 2>/dev/null" ""))
    (let c1 (if (eq (nft-has-line voice "pong") 1) 2 0))

    (defn nft-open-n (n acc) (if (eq n 0) acc (nft-open-n (sub n 1) (cons (socket_listen 0) acc))))
    (defn nft-min (xs m) (if (eq (len xs) 0) m (nft-min (tail xs) (if (lt (head xs) m) (head xs) m))))
    (defn nft-close-all (xs c) (if (eq (len xs) 0) c (nft-close-all (tail xs) (if (eq (socket_close (head xs)) 0) (add c 1) c))))
    (let handles (nft-open-n 1100 (list)))
    (let lowest (nft-min handles 1000000))
    (let closed (nft-close-all handles 0))
    (let c2 (if (and (ge lowest 1) (and (eq closed 1100) (and (eq (kernel_stat 31) 2048) (eq (kernel_stat 32) 1)))) 4 0))

    (let scope (host-exec "mkdir -p form/form-stdlib/.cache && awk 'BEGIN{printf \"(do (defn nftouter (p) (do \"; for(i=0;i<1100;i++) printf \"(let v%d %d) \", i, i; printf \"(defn nftin (a) (add a 1)) (add v0 (add v1099 p)))) (defn nftnest (p) (do (let x 7) (defn nftf (a) (do (defn nftg (b) b) a)) (add x p))) (list (nftouter 2) (kernel_stat 33) (kernel_stat 34) (nftnest 2)))\"}' > form/form-stdlib/.cache/nft-scope.fk && ./fkwu form/form-stdlib/.cache/nft-scope.fk 2>/dev/null; rm -f form/form-stdlib/.cache/nft-scope.fk form/form-stdlib/.cache/nft-scope.fkb form/form-stdlib/.cache/nft-scope.sym" ""))
    (let c3 (if (str_eq (nft-line scope) "[1101, 2048, 1, 9]") 8 0))

    (let deep (host-exec "mkdir -p form/form-stdlib/.cache && printf '(do (defn nftdeep (n) (if (eq n 0) (list 1) (list (nftdeep (sub n 1))))) (nftdeep 1100))' > form/form-stdlib/.cache/nft-deep.fk && ./fkwu form/form-stdlib/.cache/nft-deep.fk 2>/dev/null | wc -c | tr -d ' '; rm -f form/form-stdlib/.cache/nft-deep.fk form/form-stdlib/.cache/nft-deep.fkb form/form-stdlib/.cache/nft-deep.sym" ""))
    (let c4 (if (eq (str_to_int (nft-line deep)) 2204) 16 0))

    (let conf (host-exec "mkdir -p form/form-stdlib/.cache/nft-conf && awk 'BEGIN{for(i=0;i<68;i++) print \"KEY\" i \" \" i; k=\"\"; for(i=0;i<100;i++) k=k \"K\"; print k \" 7\"; v=\"\"; for(i=0;i<20000;i++) v=v \"v\"; print \"BIGVALUE \" v}' > form/form-stdlib/.cache/nft-conf/fkwu.conf && printf '(list (kernel_stat 37) (kernel_stat 38) (kernel_stat 39) (kernel_stat 40))' > form/form-stdlib/.cache/nft-conf/pulse.fk && (cd form/form-stdlib/.cache/nft-conf && ../../../../fkwu pulse.fk 2>/dev/null); rm -rf form/form-stdlib/.cache/nft-conf" ""))
    (let c5 (if (str_eq (nft-line conf) "[128, 1, 32768, 3]") 32 0))

    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
