; form-value-nodes-band.bml — a Form value is a node, and a ledger of nodes keeps its ids across the disk.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/form-value-nodes.bml
;
; Verdict 127 when every claim lands:
;   1   every shape of value goes to a node and comes back equal (ints, a float that keeps its point, strings with quotes,
;       newlines and UTF-8, nothing, empty and nested lists and records), and a record keeps its keys in order
;   2   the same row built twice is the same node, and rows that differ are different nodes
;   4   a ledger written whole and read back holds the same node ids, row for row (the rows were never decoded)
;   8   fvn-field / fvn-int / fvn-num / fvn-str read a record node's fields without decoding it, with the fallback for an
;       absent field or a field of another kind
;   16  fvn-ledger-append adds one row at the end, the earlier rows keep their ids, an absent file is the empty ledger
;   32  fvn-text of a node is the form-rows text of its value (the derived view), and parsing that text gives the node again
;   64  the swap leaves no half file: after many appends only the ledger exists beside its directory's other files
section [form.bml] {
 class FormValueNodesBand {
  def fvb-bit(ok, bit) = ok ? bit : 0;
  def fvb-dir() = ".hearth/form-value-nodes-band";
  def fvb-path(name) = fvb-dir() ++ "/" ++ name;
  def fvb-sample() = frw-rec([["stage", "round"], ["round", 17], ["loss", 0.1], ["one", 1.0], ["none", nothing()], ["text", "a \"quote\"\nline two\ttab \\ slash caf" ++ byte_to_str(195) ++ byte_to_str(169)], ["tags", [1, "x", [], frw-rec([])]], ["nested", frw-rec([["z", 1], ["a", "q"]])]]);
  def fvb-row(i) = frw-rec([["stage", "round"], ["round", i], ["loss", (i + 1.0) / 7.0], ["note", "row " ++ i.str()]]);
  def fvb-same?(v) = (String) value_str(fvn-to(fvn-of(v))) == (String) value_str(v);
  def fvb-shapes?() {
   let s = fvb-sample();
   fvb-same?(s) && fvb-same?(nothing()) && fvb-same?([]) && fvb-same?(frw-rec([])) && fvb-same?(0) && fvb-same?(-7) && fvb-same?(1.0) && fvb-same?(0.30000000000000004)
   && (String) value_kind(record_get(fvn-to(fvn-of(s)), "one")) == "float" && (String) value_kind(record_get(fvn-to(fvn-of(s)), "round")) == "int"
   && (String) value_str(record_keys(fvn-to(fvn-of(s)))) == (String) value_str(["stage", "round", "loss", "one", "none", "text", "tags", "nested"]);
  }
  def fvb-content-addressed?() = fvn-of(fvb-row(5)) == fvn-of(fvb-row(5)) && fvn-of(fvb-row(5)) != fvn-of(fvb-row(6));
  def fvb-ids-kept?() {
   let rows = map(i => fvn-of(fvb-row(i)), range(0, 200));
   let w = fvn-ledger-write(fvb-path("whole.fkb"), rows);
   let back = fvn-ledger(fvb-path("whole.fkb"));
   w > 0 && len(back) == 200 && back == rows;
  }
  def fvb-fields?() {
   let n = fvn-of(fvb-row(9));
   fvn-int(n, "round", -1) == 9 && fvn-str(n, "note", "") == "row 9" && fvn-num(n, "loss", -1.0) == 10.0 / 7.0
   && fvn-int(n, "absent", -1) == -1 && fvn-int(n, "note", -1) == -1 && fvn-str(n, "round", "no") == "no" && nothing?(fvn-field(n, "absent"));
  }
  def fvb-append?() {
   let p = fvb-path("appended.fkb");
   let gone = nothing?(read_form_binary(p)) && len(fvn-ledger(p)) == 0;
   let a = fvn-ledger-append(p, fvb-row(1));
   let first = fvn-ledger(p);
   let b = fvn-ledger-append(p, fvb-row(2));
   let c = fvn-ledger-append(p, fvb-row(3));
   let all = fvn-ledger(p);
   gone && len(first) == 1 && len(all) == 3 && all[0] == first[0] && all[2] == fvn-of(fvb-row(3)) && (String) value_str(fvn-ledger-values(p)[1]) == (String) value_str(fvb-row(2));
  }
  def fvb-text?() {
   let n = fvn-of(fvb-sample());
   let t = fvn-text(n);
   let back = frw-parse(t);
   (String) back[0] == "ok" && fvn-of(back[1]) == n && (String) t == (String) frw-emit(fvb-sample());
  }
  def fvb-no-half-file?() {
   let p = fvb-path("many.fkb");
   let rounds = map(i => fvn-ledger-append(p, fvb-row(i)), range(0, 20));
   len(fvn-ledger(p)) == 20 && host_path_exists(p ++ ".tmp") == 0;
  }
  // the band's three ledgers are cleared before it begins and after it ends: a run reads the same however many ran before it
  def fvb-clear() = map(name => host_path_remove(fvb-path(name)), ["whole.fkb", "appended.fkb", "many.fkb", "many.fkb.tmp"]);
  def fvb-score() {
   let made = host_dir_mkdir(".hearth");
   let made2 = host_dir_mkdir(fvb-dir());
   let cleared = fvb-clear();
   let score = fvb-bit(fvb-shapes?(), 1) + fvb-bit(fvb-content-addressed?(), 2) + fvb-bit(fvb-ids-kept?(), 4) + fvb-bit(fvb-fields?(), 8)
   + fvb-bit(fvb-append?(), 16) + fvb-bit(fvb-text?(), 32) + fvb-bit(fvb-no-half-file?(), 64);
   let after = fvb-clear();
   score;
  }
 }
 fvb-score();
}
