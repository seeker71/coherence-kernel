; form-cli-planner-mint-band.fk — remote planner shape, no chat bytes.
;
; Verdict 1023:
;   1..128  fpl-check (n=144, mix, leakage, unique, split, heldout>=54, need 95, covers-all)
;   256     class descriptor FormPlannerMint minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-planner-mint.bml
; witnessed: 2026-08-26 -> 1023; planner 8x9 n=144 unique leakage 0 heldout 72/72 covers-all need-events 95; no chat bytes

(do
    (defn fplb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn fplb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (fplb-has-name? (tail xs) name))))

    (let bits (fpl-check))
    (let desc (FormPlannerMint))
    (let src (read_file "form/form-stdlib/bml/form-cli-planner-mint.bml"))
    (let exe (read_file "form/form-stdlib/form-cli-planner-mint.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormPlannerMint")
                     (and (eq (fplb-has-name? (nth desc 2) "T") 1)
                          (and (eq (fplb-has-name? (nth desc 3) "fpl-corpus") 1)
                               (eq (fplb-has-name? (nth desc 4) "NeedEvents") 1))))
                256 0))
    (let b9 (if (and (eq (fplb-has-str? src "package Form.cli.plannermint") 1)
                     (and (eq (fplb-has-str? src "interface IPlannerMint") 1)
                          (and (eq (fplb-has-str? src "class FormPlannerMint") 1)
                               (and (eq (fplb-has-str? src "const int MixA") 1)
                                    (and (eq (fplb-has-str? src "template SampleRow") 1)
                                         (and (eq (fplb-has-str? exe "heldout-v3") 0)
                                              (eq (fplb-has-str? exe "turn_started") 0)))))))
                512 0))
    (add bits (add b8 b9)))
