; tests/io-bridge.fk — a recipe observed in Form reaches the world
; through kernel I/O natives
;
; The goal names "any I/O or hosting resource feature that the kernel
; exposes to the form runtime." This test proves the bridge:
;
;   (print "...") at the CALL category (UE-FNCALL with name "print")
;       ↓
;   resolved as registered native "print"
;       ↓
;   stdout (the I/O surface)
;
; print, str_len and str_concat are kernel natives; int_to_str is a
; core.fk function on fkwu and a native on the siblings. The Form runtime
; reaches both through the universal CALL Blueprint the same way it
; reaches any user-defined function.
;
; A recipe built from Form — (3 + 4) * 2 — is observed rather than
; evaluated: its category reads MATH.MULTIPLY, its first child is the
; very (3 + 4) NodeID built from the same parts, and its second child's
; leaf reads 2. The count of observations that hold crosses the bridge
; to stdout.
;
; Verdict: 3 when every observation holds.
;
; preludes: form-stdlib/core.fk
;
; This is the story walking out into the world: the substrate has been
; running on cells (the parse phase); now the runtime invokes the
; outside world through the same Blueprint vocabulary.

(do
    ;; Direct test: call print via the Form runtime.
    ;; (print "hello") is parsed by the bootstrap reader to a recipe
    ;; at the CALL category — exactly the same shape a universal
    ;; parser would emit for `print("hello")` in source.
    (print "I/O bridge verified: stdout reached through kernel native")

    ;; Compose with construct → observe chain:
    ;; A small arithmetic recipe built from Form, observed by identity
    ;; and read-back; the observation is printed via the I/O bridge.
    (let math-plus (make_nodeid 1 2 12 1))   ; UE-MATH-PLUS
    (let math-mul  (make_nodeid 1 2 12 3))   ; UE-MATH-MUL
    (let recipe (intern_node math-mul
                              (list (intern_node math-plus
                                                  (list (intern_trivial_int 3)
                                                        (intern_trivial_int 4)))
                                    (intern_trivial_int 2))))
    (let sum-3-4 (intern_node math-plus (list (intern_trivial_int 3)
                                               (intern_trivial_int 4))))
    (let kids (node_children recipe))
    (let result
        (add (if (node_eq (node_category recipe) math-mul) 1 0)
        (add (if (node_eq (head kids) sum-3-4) 1 0)
             (if (eq (node_value (head (tail kids))) 2) 1 0))))
    ;; result = 3 when every observation holds, printed via I/O bridge
    (print (str_concat "(3 + 4) * 2 observations holding = " (int_to_str result)))

    ;; The recipe is observed → I/O native fires → stdout receives
    ;; bytes. The form runtime IS bridged to the host.
    result)
