; let-composite-effect-once-band.fk — an effect nested below a pure list
; constructor is still evaluated exactly once by lexical let binding.
;
; preludes: form-stdlib/core.fk
;
; A root-operator-only flattener sees `list`, inlines the whole expression at
; both uses of pair, and appends twice. Correct evaluate-once semantics append
; one byte, retain the returned length 1 in pair, and read it twice.
(do
    (let dir (temp_dir))
    (let path (str_concat dir "/fk-let-composite-effect-once.txt"))
    (fs_remove path)
    (do
        (let pair (list (file_append_bytes path (list 65)) 7))
        (add (if (eq (head pair) 1) 10 0)
             (add (if (eq (head pair) 1) 100 0)
                  (str_len (read_file path))))))
