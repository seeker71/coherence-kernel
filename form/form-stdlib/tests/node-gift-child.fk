; node-gift-child.fk — the node-gift band's child: reads the cell the parent gave and witnesses its category.
; preludes: form-stdlib/form-glass-gift-frame.bml form-stdlib/core.fk form-stdlib/form-ontology-bp.fk
(do
    (let r (shm_receive "/fk-node-gift-band"))
    (let cell (ggf-cell r))
    (print (if (eq (node_eq (node_category cell) (bp "CHANNEL-V0")) 1) "same-category-across-processes" "different-category"))
    0)
