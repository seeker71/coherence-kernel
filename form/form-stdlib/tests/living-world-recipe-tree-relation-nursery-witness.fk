; living-world-recipe-tree-relation-nursery-witness.fk -- the E/F and K/L
; contradiction pressures meet without importing a relation name or operator.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/living-world-recipe-tree-revision-trial.fk form-stdlib/living-world-recipe-tree-revision-hypothesis.fk form-stdlib/living-world-recipe-tree-revision-prospective.fk form-stdlib/living-world-recipe-tree-relation-nursery.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-recipe-tree-witness.fk form-stdlib/tests/living-world-recipe-tree-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-prospective-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-hypothesis-witness.fk form-stdlib/tests/living-world-recipe-tree-revision-prospective-witness.fk

(let LWRRNW-RESULT (bp "LWRRNW-RESULT"))

; children: upstream K/L result, relation field, exact invariant and viable
; trial, revoked field, cached Recipe-active bit, framebuffer events.
(defn lwrrnw-result
    (upstream field invariant trial revoked-field recipe-active events)
    (intern_node LWRRNW-RESULT
        (list upstream field invariant trial revoked-field
              (intern_trivial_int recipe-active) events)))

(defn lwrrnw-run ()
    (do
        (let upstream (lwrtrpw-run))
        (let children (node_children upstream))
        (let candidate (nth children 1))
        (let suite (nth children 4))
        (let world (nth children 7))
        (let revoked-world (nth children 16))
        (let started
            (lcfb-open-stream "living-world-recipe-tree-relation-nursery"
                "form-native" "lwrrnw-run"
                "intersect-contradictions-and-test-consented-operators"
                "form/form-stdlib/tests/living-world-recipe-tree-relation-nursery-witness.fk"
                31 10))
        (let field (lwrrn-field-for-ready candidate suite))
        (let invariant
            (if (eq (lwo-field-size (lwrrn-field-invariants field)) 1)
                (head (lwo-field-items (lwrrn-field-invariants field)))
                (lwo-none)))
        (let trial
            (if (eq (lwo-field-size (lwrrn-field-viable field)) 1)
                (head (lwo-field-items (lwrrn-field-viable field)))
                (lwo-none)))
        (let field-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-nursery"
                "relation-field" "leave" "form-native"
                "lwrrn-field-for-ready" (lwrrn-progress-target field)
                1 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-nursery-witness.fk"
                45 10))
        (let recipe-active
            (if (node_eq trial (lwo-none)) 0
                (lwo-active? world (lwrrn-trial-recipe trial))))
        (let authority-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-nursery"
                "authority" "leave" "form-native"
                "lwo-active?" (lcfb-cat (list
                    "derived-recipe-active:" (int_to_str recipe-active)
                    ":proposal:none:promotion:none")) 2 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-nursery-witness.fk"
                56 10))
        (let revoked-field
            (lwrrn-field-for revoked-world candidate suite 2))
        (let revoked-frame
            (lcfb-call-stream "living-world-recipe-tree-relation-nursery"
                "revocation" "leave" "form-native"
                "lwrrn-field-for"
                (lcfb-cat (list "relation-field-nothing:"
                    (int_to_str (node_eq revoked-field (lwo-none)))))
                3 started
                "form/form-stdlib/tests/living-world-recipe-tree-relation-nursery-witness.fk"
                65 10))
        (lwrrnw-result upstream field invariant trial revoked-field
            recipe-active (framebuffer-events))))

(defn lwrrnw-observe ()
    (do
        (let result (lwrrnw-run))
        (let children (node_children result))
        (let field (nth children 1))
        (let invariant (nth children 2))
        (let trial (nth children 3))
        (list
            (lwo-field-size (lwrrn-field-contradictions field))
            (lwo-field-size (lwrrn-field-invariants field))
            (lwo-field-size (lwrrn-field-trials field))
            (lwo-field-size (lwrrn-field-viable field))
            (lwhrn-ready? (lwrrn-field-status field))
            (lwhrn-plural? (lwrrn-field-status field))
            (if (node_eq invariant (lwo-none)) 0
                (lwo-field-size (lwrrn-invariant-support invariant)))
            (if (node_eq trial (lwo-none)) 0 (lwrrn-trial-exact trial))
            (if (node_eq trial (lwo-none)) 0 (lwrrn-trial-total trial))
            (node_value (nth children 5))
            (node_eq (nth children 4) (lwo-none))
            (len (nth children 6)))))

; witnessed: 2026-08-09 -> aggregate relation and revocation observed on fkwu
0
