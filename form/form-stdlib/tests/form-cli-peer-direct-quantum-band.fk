; form-cli-peer-direct-quantum-band.fk -- exact one-token state boundary.
; It opens no model: the native `q38-forward` crossing is named in BML and
; the tested combiner carries its already-returned step/session unchanged.
; Expected: 1023
;
; preludes: form-stdlib/bml/form-cli-peer-direct-quantum.bml

(do
    (defn fcdqb-bit (held weight) (if held weight 0))
    (defn fcdqb-session (pending stopped)
        (fcms-session "live" "quantum-test" "qwen.gguf" "source" (empty)
            (empty) 128 11 pending stopped 3 4 0 0))
    (defn form-cli-peer-direct-quantum-band ()
        (do
            (let initial (fcdq-state "run" (fcdqb-session 0 0) "" (list) 3 50 "opened"))
            (let zero-step (fcdq-step "value" (fcdqb-session 7 0) "A" (list 0) "native-token-committed"))
            (let one-step (fcdq-step "value" (fcdqb-session 9 0) "B" (list 1) "native-token-committed"))
            (let after-zero (fcdq-advance-from-step initial zero-step))
            (let after-one (fcdq-advance-from-step after-zero one-step))
            (let stopped (fcdq-advance-from-step after-one
                (fcdq-step "done" (fcdqb-session 9 1) "" (list) "model-stop-token")))
            (let timed (fcdq-advance (fcdq-state "run" (fcdqb-session 7 0) "" (list) 0 50 "opened")))
            (let malformed (fcdq-begin (fcdqb-session 7 0) "recipe" "x" 4))
            (let absent (fcdq-begin (fcms-none "absent") "direct-answer" "x" 4))
            (let source (read_file "form/form-stdlib/bml/form-cli-peer-direct-quantum.bml"))
            (sum (list
                (fcdqb-bit (and (eq (fcdq-state? initial) 1)
                    (str_eq (fcdq-phase initial) "run")) 1)
                (fcdqb-bit (and (eq (fcdq-remaining after-zero) 2)
                    (and (str_eq (fcdq-text after-zero) "A")
                    (and (eq (len (fcdq-ids after-zero)) 1)
                        (eq (head (fcdq-ids after-zero)) 0)))) 2)
                (fcdqb-bit (and (eq (fcdq-remaining after-one) 1)
                    (and (str_eq (fcdq-text after-one) "AB")
                    (and (eq (len (fcdq-ids after-one)) 2)
                        (eq (head (tail (fcdq-ids after-one))) 1)))) 4)
                (fcdqb-bit (and (str_eq (fcdq-phase stopped) "done")
                    (and (str_eq (fcdq-reason stopped) "model-stop-token")
                        (eq (fcms-stopped? (fcdq-session stopped)) 1))) 8)
                (fcdqb-bit (and (str_eq (fcdq-phase timed) "timeout")
                    (eq (fcdq-remaining timed) 0)) 16)
                (fcdqb-bit (and (str_eq (fcdq-phase malformed) "choice")
                    (str_eq (fcdq-reason malformed) "direct-answer-requires-nonempty-direct-answer-task")) 32)
                (fcdqb-bit (and (str_eq (fcdq-phase absent) "nothing")
                    (str_eq (fcdq-reason absent) "model-session-not-live")) 64)
                (fcdqb-bit (and (ge (str_find source "q38-forward" 0) 0)
                    (and (ge (str_find source "fcms-observe-direct-answer" 0) 0)
                        (ge (str_find source "direct-answer-token-budget-exhausted" 0) 0))) 128)
                (fcdqb-bit (and (not (nothing? (fcdq-final stopped)))
                    (str_eq (fcpdaa-signal (fcdq-final stopped)) "value")) 256)
                (fcdqb-bit (nothing? (fcdq-final timed)) 512)))))
    (form-cli-peer-direct-quantum-band))
