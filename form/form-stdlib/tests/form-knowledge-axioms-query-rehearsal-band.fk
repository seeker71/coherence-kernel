import "../form-knowledge-axioms-public-curriculum.fk"

(do
    (defn fkaqrb-bit (ok bit) (if ok bit 0))
    (defn fkaqrb-count (hay needle at)
        (do
            (let found (str_find hay needle at))
            (if (lt found 0) 0
                (add 1 (fkaqrb-count hay needle
                    (add found (str_len needle)))))))

    (let question "How many axioms are held as the resting point?")
    (let offer (fkap-rag-query-offer
        "axioms/core-axioms.form" "resting point" question))
    (let prompt (fkap-query-rehearsal-prompt offer question))
    (sum (list
        (fkaqrb-bit (eq (fkap-rag-query-offer-valid? offer question) 1) 1)
        (fkaqrb-bit (not (nothing? prompt)) 2)
        (fkaqrb-bit (eq (fkaqrb-count prompt (nth offer 3) 0) 1) 4)
        (fkaqrb-bit (ge (str_find prompt question 0) 0) 8)
        (fkaqrb-bit (lt (str_find prompt "The resting point is five" 0) 0) 16)
        (fkaqrb-bit (nothing?
            (fkap-query-rehearsal-prompt offer "")) 32)
        (fkaqrb-bit (nothing?
            (fkap-query-rehearsal-prompt (list) question)) 64)
        (fkaqrb-bit (lt (str_find prompt "five" 0) 0) 128)
        (fkaqrb-bit (str_eq (nth offer 4)
            "axioms/core-axioms.form") 256))))
