; Multi-fragment Form -> emitted ARM64 -> linked transaction dispatcher.
; No model opens.  An empty split recipe must PASS; a state_save operation
; split across fragments must reach the dispatcher exactly and fail closed.
;
; witnessed: 2026-07-28 -> PASS=1, indexed state_save FAIL=0
;
; preludes: native/metal/dsv4-jit-metal-abi.fk

(do
    (let carrier "fkwu-metal-transaction")
    (let route (dsv4-jit-metal-transaction-route carrier))
    (let passed
        (dsv4-jit-metal-transaction-routed-parts
            route (list "" "" "")))
    (let failed
        (dsv4-jit-metal-transaction-routed-parts
            route
            (list
                "state_"
                "save\t"
                "jit-fragment-door"
                "\n")))
    (if (and (eq passed 1) (eq failed 0)) 255 0))
