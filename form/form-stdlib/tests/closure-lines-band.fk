; closure-lines-band.fk — a closure line reads back to its unit and the line within it. 5 bits -> 31.
; A gap in learn/native-turn-queue.jsonl: the native code lane is asked to turn it green.
; Verdict 31
; preludes: form-stdlib/core.fk form-stdlib/closure-lines.fk
(do
    (defn clb-bit (ok n) (if ok n 0))
    (defn clb-nl () (byte_to_str 10))
    (let text (str_concat "; unit: a.fk" (str_concat (clb-nl)
              (str_concat "(defn a () 1)" (str_concat (clb-nl)
              (str_concat "(defn a2 () 2)" (str_concat (clb-nl)
              (str_concat "; unit: b/c.bml" (str_concat (clb-nl)
              (str_concat "(defn c () 3)" (str_concat (clb-nl)
              (str_concat "(defn c2 () 4)" (str_concat (clb-nl)
              (str_concat "(defn c3 () 5)" (clb-nl)))))))))))))))
    ; line 6 of the closure is the second line under "; unit: b/c.bml"
    (let r6 (cl-unit-at text 6))
    (let in-b (and (str_eq (head r6) "b/c.bml") (eq (nth r6 1) 2)))
    ; line 2 is the first line under "; unit: a.fk"
    (let r2 (cl-unit-at text 2))
    (let in-a (and (str_eq (head r2) "a.fk") (eq (nth r2 1) 1)))
    ; a marker line itself, a line past the end, and a text with no marker name no unit
    (let marker (nothing? (cl-unit-at text 4)))
    (let past (nothing? (cl-unit-at text 40)))
    (let bare (nothing? (cl-unit-at (str_concat "(defn x () 1)" (clb-nl)) 1)))
    (add (clb-bit in-b 1) (add (clb-bit in-a 2) (add (clb-bit marker 4) (add (clb-bit past 8) (clb-bit bare 16))))))
