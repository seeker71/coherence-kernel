; closure-lines-band.fk — a closure line reads back to its unit and the line within it. 5 bits -> 31.
; A gap in learn/native-turn-queue.jsonl: the native code lane is asked to turn it green.
; Each claim that a line names no unit is paired with a line beside it that must name one, so a
; stub answering (nothing) reads 0; every answer's kind is read before its parts, so any candidate ends.
; Verdict 31
; preludes: form-stdlib/core.fk form-stdlib/closure-lines.fk
(do
    (defn clb-bit (ok n) (if ok n 0))
    (defn clb-nl () (byte_to_str 10))
    ; r names unit and the line n below its marker, whatever value r is
    (defn clb-names? (r unit n)
        (if (not (str_eq (value_kind r) "list")) false
            (if (nil? r) false
                (if (nil? (tail r)) false
                    (if (not (str_eq (value_kind (head r)) "string")) false
                        (if (not (str_eq (value_kind (nth r 1)) "int")) false
                            (and (str_eq (head r) unit) (eq (nth r 1) n))))))))
    (let text (str_concat "; unit: a.fk" (str_concat (clb-nl)
              (str_concat "(defn a () 1)" (str_concat (clb-nl)
              (str_concat "(defn a2 () 2)" (str_concat (clb-nl)
              (str_concat "; unit: b/c.bml" (str_concat (clb-nl)
              (str_concat "(defn c () 3)" (str_concat (clb-nl)
              (str_concat "(defn c2 () 4)" (str_concat (clb-nl)
              (str_concat "(defn c3 () 5)" (clb-nl)))))))))))))))
    ; line 6 of the closure is the second line under "; unit: b/c.bml"
    (let in-b (clb-names? (cl-unit-at text 6) "b/c.bml" 2))
    ; line 2 is the first line under "; unit: a.fk", line 3 the second
    (let in-a (and (clb-names? (cl-unit-at text 2) "a.fk" 1) (clb-names? (cl-unit-at text 3) "a.fk" 2)))
    ; a marker line itself names no unit, and the line after it is the first of the new unit
    (let marker (and (nothing? (cl-unit-at text 4)) (clb-names? (cl-unit-at text 5) "b/c.bml" 1)))
    ; a line past the end names no unit, and the last line still does
    (let past (and (nothing? (cl-unit-at text 40)) (clb-names? (cl-unit-at text 7) "b/c.bml" 3)))
    ; lines above the first marker name no unit, and the lines under it do
    (let late (str_concat "(defn x () 1)" (str_concat (clb-nl)
              (str_concat "; unit: z.fk" (str_concat (clb-nl)
              (str_concat "(defn z () 0)" (clb-nl)))))))
    (let bare (and (nothing? (cl-unit-at (str_concat "(defn x () 1)" (clb-nl)) 1))
              (and (nothing? (cl-unit-at late 1)) (clb-names? (cl-unit-at late 3) "z.fk" 1))))
    (add (clb-bit in-b 1) (add (clb-bit in-a 2) (add (clb-bit marker 4) (add (clb-bit past 8) (clb-bit bare 16))))))
