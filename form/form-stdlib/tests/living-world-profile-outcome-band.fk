; living-world-profile-outcome-band.fk -- answer feedback becomes reversible
; native model movement. Thirty-one claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk

(do
    (let result (lwpow-run))
    (let answer (nth (node_children result) 1))
    (let declaration (nth (node_children result) 2))
    (let confirmation (nth (node_children result) 3))
    (let correction (nth (node_children result) 4))
    (let alternative (nth (node_children result) 5))
    (let silence (nth (node_children result) 6))
    (let outcome-world (nth (node_children result) 7))
    (let proposal (nth (node_children result) 8))
    (let candidate (nth (node_children result) 9))
    (let waiting (nth (node_children result) 10))
    (let admitted (nth (node_children result) 11))
    (let admitted-world (lwt-round-world admitted))
    (let probes (nth (node_children result) 12))
    (let correction-probe (nth (node_children result) 13))
    (let placement-candidate (nth (node_children result) 14))
    (let placement-world (nth (node_children result) 15))
    (let prior-tissue (nth (node_children result) 16))
    (let successor-tissue (nth (node_children result) 18))
    (let tissue-world (nth (node_children result) 19))
    (let released-world (nth (node_children result) 20))
    (let compost-proposal (nth (node_children result) 21))
    (let compost-transition (nth (node_children result) 22))
    (let compost-world (lwo-transition-world compost-transition))
    (let compost-receipt (oac-payload (lwo-transition-ack compost-transition)))
    (let events (nth (node_children result) 23))
    (let cycle (lwo-emergent-shape candidate))
    (let set (lwpo-cycle-evidence cycle))
    (let placement (lwo-emergent-shape placement-candidate))
    (let successor (lwo-emergent-shape successor-tissue))
    (sum (list
        (if (eq (lwepv-answer-current? outcome-world answer) 1) 1 0)
        (if (eq (lwlc-declaration-current? outcome-world declaration) 1) 2 0)
        (if (and (eq (lwpo-outcome-current? outcome-world confirmation) 1)
                 (and (eq (lwpo-outcome-current? outcome-world correction) 1)
                      (and (eq (lwpo-outcome-current?
                                  outcome-world alternative) 1)
                           (eq (lwpo-outcome-current?
                                  outcome-world silence) 1)))) 4 0)
        (if (and (eq (lwpo-outcome-valid? confirmation) 1)
                 (and (eq (lwpo-outcome-valid? correction) 1)
                      (and (eq (lwpo-outcome-valid? alternative) 1)
                           (eq (lwpo-outcome-valid? silence) 1)))) 8 0)
        (if (eq (lwo-field-size
                    (lwpo-evidence-confirmations set)) 1) 16 0)
        (if (eq (lwo-field-size
                    (lwpo-evidence-corrections set)) 1) 32 0)
        (if (eq (lwo-field-size
                    (lwpo-evidence-silences set)) 1) 64 0)
        (if (eq (lwo-field-size
                    (lwpo-evidence-alternatives set)) 1) 128 0)
        (if (eq (lwo-field-size
                    (lwpo-evidence-unresolved set)) 0) 256 0)
        (if (eq (lwpo-contested? (lwpo-cycle-state cycle)) 1) 512 0)
        (if (eq (oac-alternative-ack?
                    (lwpo-effective-ack silence)) 1) 1024 0)
        (if (eq (oac-nothing? (lwpo-outcome-ack silence)) 1) 2048 0)
        (if (eq (oac-time-outcome?
                    (lwpo-time-state silence)) 1) 4096 0)
        (if (gt (lwo-field-size
                    (lwt-proposal-participants proposal)) 1) 8192 0)
        (if (eq (lwpo-integrated-current?
                    (lwt-round-world waiting) candidate) 0) 16384 0)
        (if (eq (lwpo-integrated-current?
                    admitted-world candidate) 1) 32768 0)
        (if (eq (lwo-field-size probes) 4) 65536 0)
        (if (eq (oac-zero? (lwpo-outcome-ack correction)) 1) 131072 0)
        (if (and (eq (oac-one? (lwph-probe-ack correction-probe)) 1)
                 (node_eq (oac-payload (lwph-probe-ack correction-probe))
                    (lwpo-outcome-observed correction))) 262144 0)
        (if (node_eq (lwph-probe-evidence correction-probe)
                correction) 524288 0)
        (if (eq (lwph-probe-integrated-current?
                    placement-world placement-candidate) 1) 1048576 0)
        (if (and (eq (lwo-field-size
                        (lwph-placement-confirmed placement)) 0)
                 (eq (lwo-field-size
                        (lwph-placement-diverged placement)) 4)) 2097152 0)
        (if (eq (lwht-integrated-current?
                    placement-world prior-tissue) 0) 4194304 0)
        (if (eq (lwht-integrated-current?
                    tissue-world successor-tissue) 1) 8388608 0)
        (if (eq (lwo-field-size
                    (lwht-tissue-compatible successor)) 0) 16777216 0)
        (if (eq (lwo-field-size
                    (lwht-tissue-contradicted successor)) 4) 33554432 0)
        (if (eq (lwht-contradicted?
                    (lwht-tissue-status successor)) 1) 67108864 0)
        (if (eq (lwepv-answer-current? tissue-world answer) 0) 134217728 0)
        (if (and (not (node_eq compost-proposal (lwo-none)))
                 (eq (lwc-world-contains? released-world silence) 1))
            268435456 0)
        (if (and (eq (oac-node?
                        (lwo-transition-ack compost-transition)) 1)
                 (and (eq (lwc-receipt? compost-receipt) 1)
                      (and (eq (lwc-world-contains?
                                  compost-world silence) 0)
                           (eq (lwc-world-contains?
                                  (lwc-receipt-prior-world compost-receipt)
                                  silence) 1)))) 536870912 0)
        (if (eq (len events) 9) 1073741824 0))))
