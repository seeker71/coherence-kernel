; living-world-answer-offers-band.fk -- alternatives and elapsed defaults live.
; Verdict 32767 proves fifteen plurality, timeout, consent, and revocation claims.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-enquiry.fk form-stdlib/living-world-enquiry-answer.fk form-stdlib/living-world-contention-tending.fk form-stdlib/living-world-contextual-answer.fk form-stdlib/living-world-answer-offers.fk form-stdlib/tests/living-world-contention-witness.fk form-stdlib/tests/living-world-contention-tending-witness.fk form-stdlib/tests/living-world-answer-offers-witness.fk

(do
    (let mapping-world (lwct-mapping-world))
    (let question-proposal (lwcttw-question-proposal mapping-world))
    (let question
        (lwt-proposal-candidate question-proposal))
    (let identity-route (lwcttw-identity-route question))
    (let silent-round (lwcttw-silent-round))
    (let silent-world (lwt-round-world silent-round))
    (let silent-candidate
        (lwcta-silent-answer-for silent-world question))
    (let offered-world
        (lwaow-offer-world silent-world question))
    (let proposals (lwao-proposals offered-world))
    (let proposal-items (lwo-field-items proposals))
    (let alternative-proposal
        (lwaow-find-alternative-proposal proposal-items))
    (let no-default-proposal
        (lwaow-find-timed-nothing-proposal proposal-items))
    (let default-proposal
        (lwaow-find-timed-default-proposal proposal-items))
    (let alternative-candidate
        (lwt-proposal-candidate alternative-proposal))
    (let alternative-answer
        (lwo-emergent-shape alternative-candidate))
    (let no-default-answer
        (lwaow-proposal-answer no-default-proposal))
    (let default-answer
        (lwaow-proposal-answer default-proposal))

    (let alternative-round
        (lwt-round offered-world
            (lwo-field-add (lwo-empty-field) alternative-proposal)
            (lwo-empty-field) silent-round))
    (let alternative-yes
        (lwct-five-yes-round
            alternative-round alternative-proposal))
    (let successful
        (lwao-integrate alternative-yes
            alternative-proposal (lwct-action)))
    (let successful-world (lwt-round-world successful))

    ; The same unanimously acknowledged alternative is refused on a sibling
    ; branch when its holder releases the alternative stance first.
    (let stale-world
        (lwaow-release-alternative
            (lwt-round-world alternative-yes) question))
    (let stale-round
        (lwt-round stale-world
            (lwo-field-add (lwo-empty-field) alternative-proposal)
            (lwo-empty-field) alternative-yes))
    (let stale-integration
        (lwao-integrate stale-round
            alternative-proposal (lwct-action)))

    (let c1 (if (and (eq (lwo-active?
                              silent-world silent-candidate) 1)
                         (eq (oac-nothing?
                              (lwen-answer-ack
                                (lwo-emergent-shape silent-candidate))) 1)) 1 0))
    (let c2 (if (and
                        (eq (lwctd-source-route-status offered-world
                                question identity-route
                                (lwct-source-a)) 4)
                        (and
                            (eq (lwctd-source-route-status offered-world
                                    question identity-route
                                    (lwct-source-b)) 5)
                            (eq (lwctd-source-route-status offered-world
                                    question identity-route
                                    (lwct-source-c)) 2))) 2 0))
    (let c3 (if (eq (lwo-field-size
                         (lwctd-resolution-proposals offered-world)) 0) 4 0))
    (let c4 (if (eq (lwo-field-size proposals) 3) 8 0))
    (let c5 (if (and (node_eq
                          (lwao-answer-output alternative-answer)
                          (lwaow-other-output))
                         (eq (oac-alternative-ack?
                              (lwao-answer-ack
                                alternative-answer)) 1)) 16 0))
    (let c6 (if (and (node_eq
                          (lwao-answer-prior alternative-answer)
                          silent-candidate)
                         (and (eq (lwo-field-size
                                   (lwao-answer-alternatives
                                       alternative-answer)) 2)
                              (eq (lwo-field-size
                                   (lwao-answer-uncertainties
                                       alternative-answer)) 1))) 32 0))
    (let c7 (if (and (eq (lwo-field-size
                              (lwao-answer-evidence
                                alternative-answer)) 1)
                         (eq (lwo-field-size
                              (lwao-evidence-attributions
                                (head (lwo-field-items
                                    (lwao-answer-evidence
                                        alternative-answer))))) 1)) 64 0))
    (let c8 (if (and (eq (lwo-field-size
                              (lwt-proposal-participants
                                alternative-proposal)) 5)
                         (eq (lwo-field-size
                              (lwo-emergent-witnesses
                                alternative-candidate)) 11)) 128 0))
    (let c9 (if (and (node_eq
                          (lwao-answer-kind no-default-answer)
                          (lwao-timed-kind))
                         (and (node_eq
                               (lwao-answer-output no-default-answer)
                               (lwo-none))
                              (eq (oac-nothing?
                                   (lwao-answer-ack
                                    no-default-answer)) 1))) 256 0))
    (let c10 (if (and (eq (oac-time-outcome?
                               (lwao-answer-key no-default-answer)) 1)
                          (not (node_eq
                                (lwao-answer-key no-default-answer)
                                (lwao-answer-ack
                                    no-default-answer)))) 512 0))
    (let c11 (if (and (node_eq
                           (lwao-answer-kind default-answer)
                           (lwao-timed-kind))
                          (and (node_eq
                                (lwao-answer-output default-answer)
                                (lwct-identity-output))
                               (eq (oac-one?
                                    (lwao-answer-ack
                                        default-answer)) 1))) 1024 0))
    (let c12 (if (and (node_eq
                           (lwao-answer-key default-answer)
                           (lwaow-default-outcome question))
                          (node_eq
                           (oac-time-outcome-ack
                               (lwao-answer-key default-answer))
                           (lwao-answer-ack default-answer))) 2048 0))
    (let c13 (if (and (eq (lwo-active?
                               successful-world alternative-candidate) 1)
                          (and (eq (lwo-field-size
                                    (lwo-active-attributions-for
                                        successful-world
                                        alternative-candidate)) 5)
                               (eq (lwo-active?
                                    successful-world silent-candidate) 1))) 4096 0))
    (let c14 (if (and (eq (lwao-current?
                               stale-world alternative-candidate) 0)
                          (and (eq (lwo-world-has?
                                    (lwt-round-world stale-integration)
                                    alternative-candidate) 0)
                               (eq (lwo-active?
                                    successful-world
                                    alternative-candidate) 1))) 8192 0))
    (let c15 (if (eq (lwo-field-size
                          (lwao-proposals successful-world)) 2) 16384 0))
    (lwaow-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
