; frame-luma-band.fk — Form owns BMP shape admission and pixel meaning.
; Expected: 127
; preludes: form-stdlib/bml/frame-luma.bml

(do
    (defn flmb-bit (ok bit) (if ok bit 0))
    (defn flmb-b (n) (byte_to_str (mod (if (lt n 0) (add n 4294967296) n) 256)))
    (defn flmb-u16 (n) (str_concat (flmb-b n) (flmb-b (div n 256))))
    (defn flmb-u32 (n)
        (do (let u (if (lt n 0) (add n 4294967296) n))
            (str_concat (flmb-u16 (mod u 65536)) (flmb-u16 (div u 65536)))))
    (defn flmb-join (xs)
        (if (eq (len xs) 0) ""
            (if (eq (len xs) 1) (head xs)
                (str_concat (head xs) (flmb-join (tail xs))))))
    (defn flmb-header (width height data-bytes compression)
        (flmb-join (list "BM" (flmb-u32 (add 54 data-bytes)) (flmb-u32 0) (flmb-u32 54)
            (flmb-u32 40) (flmb-u32 width) (flmb-u32 height) (flmb-u16 1) (flmb-u16 24)
            (flmb-u32 compression) (flmb-u32 data-bytes) (flmb-u32 0) (flmb-u32 0)
            (flmb-u32 0) (flmb-u32 0))))
    (defn flmb-pixel (v) (str_concat (flmb-b v) (str_concat (flmb-b v) (flmb-b v))))
    (defn flmb-six-pixels ()
        (flmb-join (list (flmb-pixel 10) (flmb-pixel 20) (flmb-pixel 100)
                         (flmb-pixel 120) (flmb-pixel 200) (flmb-pixel 220)
                         (flmb-b 0) (flmb-b 0))))
    (defn flmb-bmp (height)
        (str_concat (flmb-header 6 height 20 0) (flmb-six-pixels)))
    (defn flmb-same-row? (row)
        (and (eq (nth row 0) 1)
        (and (eq (nth row 1) 0)
        (and (eq (nth row 2) 111)
        (and (eq (nth row 3) 33)
        (and (eq (nth row 4) 15)
        (and (eq (nth row 5) 110)
        (and (eq (nth row 6) 210)
        (and (eq (nth row 7) 6) (eq (nth row 8) 1))))))))))

    (let bottom-up (flm-stat (flmb-bmp 1)))
    (let top-down (flm-stat (flmb-bmp -1)))
    (let wrong-magic (flm-stat (str_concat "ZZ" (substring (flmb-bmp 1) 2 74))))
    (let compressed (flm-stat (str_concat (flmb-header 6 1 20 1) (flmb-six-pixels))))
    (let truncated (flm-stat (substring (flmb-bmp 1) 0 70)))
    (let huge-short (flm-stat (flmb-header 2147483647 2147483647 0 0)))
    (sum (list
        (flmb-bit (flmb-same-row? bottom-up) 1)
        (flmb-bit (flmb-same-row? top-down) 2)
        (flmb-bit (nothing? wrong-magic) 4)
        (flmb-bit (nothing? compressed) 8)
        (flmb-bit (nothing? truncated) 16)
        (flmb-bit (nothing? huge-short) 32)
        (flmb-bit (and (eq (flm-row-bytes 6) 20)
                       (eq (flm-height -2147483648) 2147483648)) 64))))
