; kat-coder-embed-band.fk — a real KAT-Coder embedding row decodes, and the two
; reaches into the Q3_K spine agree on real weights.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/equireach-gguf.fk form-stdlib/f16-decode.fk form-stdlib/q3k-dequant.fk form-stdlib/q3k-equireach.fk form-stdlib/kat-coder-embed.fk
;
; run: ./fkwu form/form-stdlib/tests/kat-coder-embed-band.fk   ; -> 255 with the file, 0 without
;
; Verdict 255 when the sha256-verified 17.39 GB file is readable. Without it
; every bit is dark: every claim here is about real bytes and none can be made
; from a record.
;
; BIT 64 IS THE ONE THAT EARNS THE CELL. q3k-dequant.fk (list) and
; q3k-equireach.fk (in place) are two reaches into one spine, and this sets them
; against each other over 256 REAL weights — not the synthetic fixture both were
; born on. They must agree EXACTLY: the arithmetic is identical and only the
; reach differs, so any tolerance here would be admitting a difference that
; cannot exist for a reason.

(do
    (defn kceb-score (ok bit) (if ok bit 0))

    (defn kat-coder-embed-band ()
        (do
    (let h (kce-hdr))
    (let ok (kce-present?))
    ; the header says what the record says: type, shape, and where the data lives
    (let c0 (kceb-score (if (eq ok 1)
                            (if (eq (kce-live-type h) (kce-embed-type))
                                (if (eq (kce-live-ne0 h) (kce-embed-ne0))
                                    (eq (kce-live-ne1 h) (kce-embed-ne1)) 0) 0) 0) 1))
    ; the data base is the aligned end of the tensor table, and the embedding
    ; sits where base + dataoff puts it
    (let c1 (kceb-score (if (eq ok 1)
                            (if (eq (kce-live-base h) (kce-data-base))
                                (eq (kce-live-abs h) (kce-embed-abs)) 0) 0) 2))
    ; the row stride follows from the file's own dim0, not from a constant here
    (let c2 (kceb-score (if (eq ok 1)
                            (eq (eq3k-row-bytes (kce-live-ne0 h)) (kce-row-bytes)) 0) 4))
    ; a row can actually be read, and it is the length the stride predicts
    (let r (kce-row-src 100))
    (let c3 (kceb-score (eq (str_len r) (kce-row-bytes)) 8))
    ; the super-scale decodes to something a weight scale can be — nonzero and
    ; small. A dead read returns zeros and dies here.
    (let d0 (eq3k-d r 0))
    (let c4 (kceb-score (if (gt (kce-abs d0) 0.0) (lt (kce-abs d0) 1.0) 0) 16))
    ; the row is NOT degenerate: most of 256 weights nonzero, and the largest is
    ; in the range an embedding lives in rather than an overflow
    (let nz (kce-nonzero r 256))
    (let mx (kce-maxabs r 256))
    (let c5 (kceb-score (if (gt nz 128) (if (gt mx 0.0) (lt mx 1.0) 0) 0) 32))
    ; THE TWO REACHES AGREE, EXACTLY, on 256 real weights
    (let c6 (kceb-score (eq (kce-two-reach-agree? r 0) 1) 64))
    ; and again on the LAST superblock of the row, so the agreement is not an
    ; artefact of block 0's offsets being all zero
    (let c7 (kceb-score (eq (kce-two-reach-agree? r (mul 7 (eq3k-stride))) 1) 128))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
    )
    (kat-coder-embed-band))
