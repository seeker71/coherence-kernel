; living-world-intention-graph-witness.fk -- four native deltas form paths.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk

(let LWIGW-FIXTURE    (bp "LWIGW-FIXTURE"))
(let LWIGW-SOURCE-P   (bp "LWIGW-SOURCE-P"))
(let LWIGW-SOURCE-Q   (bp "LWIGW-SOURCE-Q"))
(let LWIGW-SOURCE-R   (bp "LWIGW-SOURCE-R"))
(let LWIGW-SOURCE-S   (bp "LWIGW-SOURCE-S"))
(let LWIGW-SOURCE-T   (bp "LWIGW-SOURCE-T"))
(let LWIGW-SOURCE-U   (bp "LWIGW-SOURCE-U"))
(let LWIGW-PROV-P     (bp "LWIGW-PROV-P"))
(let LWIGW-PROV-Q     (bp "LWIGW-PROV-Q"))
(let LWIGW-PROV-R     (bp "LWIGW-PROV-R"))
(let LWIGW-PROV-S     (bp "LWIGW-PROV-S"))
(let LWIGW-PROV-T     (bp "LWIGW-PROV-T"))
(let LWIGW-PROV-U     (bp "LWIGW-PROV-U"))
(let LWIGW-ACTION     (bp "LWIGW-ACTION"))
(let LWIGW-EVIDENCE   (bp "LWIGW-EVIDENCE"))
(let LWIGW-DIRECTION-A (bp "LWIGW-DIRECTION-A"))
(let LWIGW-DIRECTION-B (bp "LWIGW-DIRECTION-B"))
(let LWIGW-DIRECTION-C (bp "LWIGW-DIRECTION-C"))
(let LWIGW-DIRECTION-D (bp "LWIGW-DIRECTION-D"))
(let LWIGW-FOCUS-A    (bp "LWIGW-FOCUS-A"))
(let LWIGW-FOCUS-B    (bp "LWIGW-FOCUS-B"))
(let LWIGW-FOCUS-C    (bp "LWIGW-FOCUS-C"))
(let LWIGW-FOCUS-D    (bp "LWIGW-FOCUS-D"))
(let LWIGW-OPAQUE-A   (bp "LWIGW-OPAQUE-A"))
(let LWIGW-OPAQUE-B   (bp "LWIGW-OPAQUE-B"))
(let LWIGW-OPAQUE-C   (bp "LWIGW-OPAQUE-C"))
(let LWIGW-OPAQUE-D   (bp "LWIGW-OPAQUE-D"))

(defn lwigw-cell (kind) (intern_node kind (empty)))
(defn lwigw-source-p () (lwigw-cell LWIGW-SOURCE-P))
(defn lwigw-source-q () (lwigw-cell LWIGW-SOURCE-Q))
(defn lwigw-source-r () (lwigw-cell LWIGW-SOURCE-R))
(defn lwigw-source-s () (lwigw-cell LWIGW-SOURCE-S))
(defn lwigw-source-t () (lwigw-cell LWIGW-SOURCE-T))
(defn lwigw-source-u () (lwigw-cell LWIGW-SOURCE-U))
(defn lwigw-prov-p () (lwigw-cell LWIGW-PROV-P))
(defn lwigw-prov-q () (lwigw-cell LWIGW-PROV-Q))
(defn lwigw-prov-r () (lwigw-cell LWIGW-PROV-R))
(defn lwigw-prov-s () (lwigw-cell LWIGW-PROV-S))
(defn lwigw-prov-t () (lwigw-cell LWIGW-PROV-T))
(defn lwigw-prov-u () (lwigw-cell LWIGW-PROV-U))
(defn lwigw-action () (lwigw-cell LWIGW-ACTION))
(defn lwigw-evidence () (lwigw-cell LWIGW-EVIDENCE))

(defn lwigw-focus-a () (lwigw-cell LWIGW-FOCUS-A))
(defn lwigw-focus-b () (lwigw-cell LWIGW-FOCUS-B))
(defn lwigw-focus-c () (lwigw-cell LWIGW-FOCUS-C))
(defn lwigw-focus-d () (lwigw-cell LWIGW-FOCUS-D))
(defn lwigw-opaque-a () (lwigw-cell LWIGW-OPAQUE-A))
(defn lwigw-opaque-b () (lwigw-cell LWIGW-OPAQUE-B))
(defn lwigw-opaque-c () (lwigw-cell LWIGW-OPAQUE-C))
(defn lwigw-opaque-d () (lwigw-cell LWIGW-OPAQUE-D))
(defn lwigw-direction-a () (lwigw-cell LWIGW-DIRECTION-A))
(defn lwigw-direction-b () (lwigw-cell LWIGW-DIRECTION-B))
(defn lwigw-direction-c () (lwigw-cell LWIGW-DIRECTION-C))
(defn lwigw-direction-d () (lwigw-cell LWIGW-DIRECTION-D))

(defn lwigw-contract () (lwre-form-contract 64 (lwigw-evidence)))
(defn lwigw-recipe-a ()
    (lwre-recipe "(add 1 1)" (lwigw-contract) (lwigw-evidence)))
(defn lwigw-recipe-b ()
    (lwre-recipe "(add 2 1)" (lwigw-contract) (lwigw-evidence)))
(defn lwigw-recipe-c ()
    (lwre-recipe "(add 3 1)" (lwigw-contract) (lwigw-evidence)))
(defn lwigw-recipe-d ()
    (lwre-recipe "(sub 2 1)" (lwigw-contract) (lwigw-evidence)))

(defn lwigw-lens-for (recipe)
    (lwlc-lens (lwlc-recipe-shape) recipe (lwigw-evidence)))
(defn lwigw-lens-a () (lwigw-lens-for (lwigw-recipe-a)))
(defn lwigw-lens-b () (lwigw-lens-for (lwigw-recipe-b)))
(defn lwigw-lens-c () (lwigw-lens-for (lwigw-recipe-c)))
(defn lwigw-lens-d () (lwigw-lens-for (lwigw-recipe-d)))
(defn lwigw-declaration-for (direction lens)
    (lwlc-declaration direction
        (lwlc-stack lens (lwlc-layers (list))
            (lwo-empty-field) (lwo-none) (lwigw-evidence))
        (lwigw-evidence)))
(defn lwigw-declaration-a ()
    (lwigw-declaration-for (lwigw-direction-a) (lwigw-lens-a)))
(defn lwigw-declaration-b ()
    (lwigw-declaration-for (lwigw-direction-b) (lwigw-lens-b)))
(defn lwigw-declaration-c ()
    (lwigw-declaration-for (lwigw-direction-c) (lwigw-lens-c)))
(defn lwigw-declaration-d ()
    (lwigw-declaration-for (lwigw-direction-d) (lwigw-lens-d)))

(defn lwigw-before-a () (intern_trivial_int 1))
(defn lwigw-before-b () (intern_trivial_int 2))
(defn lwigw-before-c () (intern_trivial_int 3))
(defn lwigw-before-d () (intern_trivial_int 2))
(defn lwigw-delta-for (before after lens)
    (lwac-delta before (intern_trivial_int after) lens))
(defn lwigw-delta-a ()
    (lwigw-delta-for (lwigw-before-a) 2 (lwigw-lens-a)))
(defn lwigw-delta-b ()
    (lwigw-delta-for (lwigw-before-b) 3 (lwigw-lens-b)))
(defn lwigw-delta-c ()
    (lwigw-delta-for (lwigw-before-c) 4 (lwigw-lens-c)))
(defn lwigw-delta-d ()
    (lwigw-delta-for (lwigw-before-d) 1 (lwigw-lens-d)))

(defn lwigw-offer-for
    (focus action declaration lens before prediction)
    (lwac-offer focus action declaration lens before prediction
        (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none)
        (lwigw-evidence)))
(defn lwigw-offer-a ()
    (lwigw-offer-for (lwigw-focus-a) (lwigw-opaque-a)
        (lwigw-declaration-a) (lwigw-lens-a)
        (lwigw-before-a) (lwigw-delta-a)))
(defn lwigw-offer-b ()
    (lwigw-offer-for (lwigw-focus-b) (lwigw-opaque-b)
        (lwigw-declaration-b) (lwigw-lens-b)
        (lwigw-before-b) (lwigw-delta-b)))
(defn lwigw-offer-c ()
    (lwigw-offer-for (lwigw-focus-c) (lwigw-opaque-c)
        (lwigw-declaration-c) (lwigw-lens-c)
        (lwigw-before-c) (lwigw-delta-c)))
(defn lwigw-offer-d ()
    (lwigw-offer-for (lwigw-focus-d) (lwigw-opaque-d)
        (lwigw-declaration-d) (lwigw-lens-d)
        (lwigw-before-d) (lwigw-delta-d)))

(defn lwigw-entry (source provenance payload)
    (lwt-entry
        (lwo-offer source (lwo-interface (list (lwigw-action)))
            1 payload provenance 1)
        (lwigw-action)))
(defn lwigw-entry-p (payload)
    (lwigw-entry (lwigw-source-p) (lwigw-prov-p) payload))
(defn lwigw-entry-q (payload)
    (lwigw-entry (lwigw-source-q) (lwigw-prov-q) payload))
(defn lwigw-entry-r (payload)
    (lwigw-entry (lwigw-source-r) (lwigw-prov-r) payload))
(defn lwigw-entry-s (payload)
    (lwigw-entry (lwigw-source-s) (lwigw-prov-s) payload))
(defn lwigw-entry-t (payload)
    (lwigw-entry (lwigw-source-t) (lwigw-prov-t) payload))
(defn lwigw-entry-u (payload)
    (lwigw-entry (lwigw-source-u) (lwigw-prov-u) payload))

(defn lwigw-add-step
    (world recipe declaration before focus action offer)
    (lwt-receive-stream world
        (list
            (lwigw-entry-p recipe)
            (lwigw-entry-p declaration)
            (lwigw-entry-q before)
            (lwigw-entry-p focus)
            (lwigw-entry-p action)
            (lwigw-entry-p offer))))

(defn lwigw-response (source provenance proposal)
    (lwigw-entry source provenance
        (lwt-response proposal (oac-one proposal) provenance)))
(defn lwigw-pq-responses (proposal)
    (list
        (lwigw-response (lwigw-source-p) (lwigw-prov-p) proposal)
        (lwigw-response (lwigw-source-q) (lwigw-prov-q) proposal)))

; Returns [integrated execution round, exact execution candidate].
(defn lwigw-build-step (world focus previous)
    (do
        (let selection-proposal
            (lwac-selection-proposal world focus 1))
        (let selection-candidate
            (lwt-proposal-candidate selection-proposal))
        (let selection-round
            (lwt-round world (lwo-field (list selection-proposal))
                (lwo-empty-field) previous))
        (let selection-yes
            (lwt-round-receive selection-round
                (lwigw-pq-responses selection-proposal)))
        (let selection-integrated
            (lwac-selection-integrate selection-yes selection-proposal
                (lwigw-action)))
        (let selection-world (lwt-round-world selection-integrated))
        (let execution-proposal
            (lwac-execution-proposal selection-world selection-candidate
                (lwo-none) (lwigw-evidence)))
        (let execution-candidate
            (lwt-proposal-candidate execution-proposal))
        (let execution-round
            (lwt-round selection-world (lwo-field (list execution-proposal))
                (lwo-empty-field) selection-integrated))
        (let execution-yes
            (lwt-round-receive execution-round
                (lwigw-pq-responses execution-proposal)))
        (let execution-integrated
            (lwac-execution-integrate execution-yes execution-proposal
                (lwigw-action)))
        (list execution-integrated execution-candidate)))

; children: final world, A/B/C/D execution candidates, final round
(defn lwigw-fixture-cell (world a b c d round)
    (intern_node LWIGW-FIXTURE (list world a b c d round)))
(defn lwigw-fixture-world (fixture) (nth (node_children fixture) 0))
(defn lwigw-a (fixture) (nth (node_children fixture) 1))
(defn lwigw-b (fixture) (nth (node_children fixture) 2))
(defn lwigw-c (fixture) (nth (node_children fixture) 3))
(defn lwigw-d (fixture) (nth (node_children fixture) 4))
(defn lwigw-fixture-round (fixture) (nth (node_children fixture) 5))

(defn lwigw-build-fixture ()
    (do
        (let world-a
            (lwigw-add-step (lwo-empty-world)
                (lwigw-recipe-a) (lwigw-declaration-a)
                (lwigw-before-a) (lwigw-focus-a)
                (lwigw-opaque-a) (lwigw-offer-a)))
        (let built-a (lwigw-build-step world-a (lwigw-focus-a) (lwo-none)))
        (let round-a (nth built-a 0))
        (let candidate-a (nth built-a 1))
        (let world-b
            (lwigw-add-step (lwt-round-world round-a)
                (lwigw-recipe-b) (lwigw-declaration-b)
                (lwigw-before-b) (lwigw-focus-b)
                (lwigw-opaque-b) (lwigw-offer-b)))
        (let built-b (lwigw-build-step world-b (lwigw-focus-b) round-a))
        (let round-b (nth built-b 0))
        (let candidate-b (nth built-b 1))
        (let world-c
            (lwigw-add-step (lwt-round-world round-b)
                (lwigw-recipe-c) (lwigw-declaration-c)
                (lwigw-before-c) (lwigw-focus-c)
                (lwigw-opaque-c) (lwigw-offer-c)))
        (let built-c (lwigw-build-step world-c (lwigw-focus-c) round-b))
        (let round-c (nth built-c 0))
        (let candidate-c (nth built-c 1))
        (let world-d
            (lwigw-add-step (lwt-round-world round-c)
                (lwigw-recipe-d) (lwigw-declaration-d)
                (lwigw-before-d) (lwigw-focus-d)
                (lwigw-opaque-d) (lwigw-offer-d)))
        (let built-d (lwigw-build-step world-d (lwigw-focus-d) round-c))
        (let round-d (nth built-d 0))
        (let candidate-d (nth built-d 1))
        (lwigw-fixture-cell (lwt-round-world round-d)
            candidate-a candidate-b candidate-c candidate-d round-d)))

(defn lwigw-support (left right)
    (lwig-observation left right (oac-one right)
        (lwo-empty-field) (lwo-none) (lwigw-evidence)))
(defn lwigw-support-with-unknown (left right alternative)
    (lwig-observation left right (oac-one right)
        (lwo-field (list alternative))
        (lwlc-unknown (lwigw-evidence)) (lwigw-evidence)))
(defn lwigw-silence (left right)
    (lwig-observation left right (oac-nothing)
        (lwo-empty-field) (lwo-none) (lwigw-evidence)))
(defn lwigw-alternative (left right offered)
    (lwig-observation left right
        (oac-alternative-ack right offered (lwigw-evidence))
        (lwo-field (list offered))
        (lwlc-unknown (lwigw-evidence)) (lwigw-evidence)))

(defn lwigw-linear-observed-world (fixture)
    (do
        (let a (lwigw-a fixture))
        (let b (lwigw-b fixture))
        (let c (lwigw-c fixture))
        (let d (lwigw-d fixture))
        (let ab (lwigw-support-with-unknown a b d))
        (let bc (lwigw-support b c))
        (lwt-receive-stream (lwigw-fixture-world fixture)
            (list
                (lwigw-entry-r ab) (lwigw-entry-s ab)
                (lwigw-entry-u (lwigw-alternative a b d))
                (lwigw-entry-r bc) (lwigw-entry-s bc)
                (lwigw-entry-t (lwigw-silence b c))))))

(defn lwigw-edge-response-entries (proposal sources)
    (if (eq (len sources) 0) (list)
        (do
            (let pair (head sources))
            (cons (lwigw-response (nth pair 0) (nth pair 1) proposal)
                (lwigw-edge-response-entries proposal (tail sources))))))
(defn lwigw-pqrsu ()
    (list
        (list (lwigw-source-p) (lwigw-prov-p))
        (list (lwigw-source-q) (lwigw-prov-q))
        (list (lwigw-source-r) (lwigw-prov-r))
        (list (lwigw-source-s) (lwigw-prov-s))
        (list (lwigw-source-u) (lwigw-prov-u))))
(defn lwigw-pqrst ()
    (list
        (list (lwigw-source-p) (lwigw-prov-p))
        (list (lwigw-source-q) (lwigw-prov-q))
        (list (lwigw-source-r) (lwigw-prov-r))
        (list (lwigw-source-s) (lwigw-prov-s))
        (list (lwigw-source-t) (lwigw-prov-t))))
(defn lwigw-pqrs ()
    (list
        (list (lwigw-source-p) (lwigw-prov-p))
        (list (lwigw-source-q) (lwigw-prov-q))
        (list (lwigw-source-r) (lwigw-prov-r))
        (list (lwigw-source-s) (lwigw-prov-s))))

(defn lwigw-integrate-edge
    (world previous observation sources)
    (do
        (let proposal (lwig-edge-proposal world observation 2))
        (let round
            (lwt-round world (lwo-field (list proposal))
                (lwo-empty-field) previous))
        (let yes-round
            (lwt-round-receive round
                (lwigw-edge-response-entries proposal sources)))
        (let integrated
            (lwig-edge-integrate yes-round proposal (lwigw-action)))
        (list integrated (lwt-proposal-candidate proposal))))

(defn lwigw-linear-worlds (fixture)
    (do
        (let observed (lwigw-linear-observed-world fixture))
        (let ab-observation
            (lwigw-support-with-unknown
                (lwigw-a fixture) (lwigw-b fixture) (lwigw-d fixture)))
        (let built-ab
            (lwigw-integrate-edge observed (lwigw-fixture-round fixture)
                ab-observation (lwigw-pqrsu)))
        (let ab-round (nth built-ab 0))
        (let ab-candidate (nth built-ab 1))
        (let stop-world (lwt-round-world ab-round))
        (let bc-observation
            (lwigw-support (lwigw-b fixture) (lwigw-c fixture)))
        (let built-bc
            (lwigw-integrate-edge stop-world ab-round
                bc-observation (lwigw-pqrst)))
        (let bc-round (nth built-bc 0))
        (let bc-candidate (nth built-bc 1))
        (list stop-world (lwt-round-world bc-round) ab-candidate
            bc-candidate bc-round)))

(defn lwigw-branch-world (fixture linear-world linear-round)
    (do
        (let observation
            (lwigw-support (lwigw-a fixture) (lwigw-d fixture)))
        (let observed
            (lwt-receive-stream linear-world
                (list (lwigw-entry-r observation)
                      (lwigw-entry-s observation))))
        (let built
            (lwigw-integrate-edge observed linear-round observation
                (lwigw-pqrs)))
        (list (lwt-round-world (nth built 0)) (nth built 1) (nth built 0))))

(defn lwigw-cycle-world (fixture branch-world branch-round)
    (do
        (let da-observation
            (lwigw-support (lwigw-d fixture) (lwigw-a fixture)))
        (let observed
            (lwt-receive-stream branch-world
                (list (lwigw-entry-r da-observation)
                      (lwigw-entry-s da-observation))))
        (let built-da
            (lwigw-integrate-edge observed branch-round da-observation
                (lwigw-pqrs)))
        (let da-round (nth built-da 0))
        (let da-candidate (nth built-da 1))
        ; The inverse observation changes AD's evidence identity. Re-admit AD
        ; against the complete pair rather than keeping a stale first edge.
        (let ad-observation
            (lwigw-support (lwigw-a fixture) (lwigw-d fixture)))
        (let built-ad
            (lwigw-integrate-edge (lwt-round-world da-round) da-round
                ad-observation (lwigw-pqrs)))
        (list (lwt-round-world (nth built-ad 0)) da-candidate
            (nth built-ad 0) (nth built-ad 1))))

(defn lwigw-nodes-abc (fixture)
    (lwo-field (list (lwigw-a fixture) (lwigw-b fixture) (lwigw-c fixture))))
(defn lwigw-nodes-abcd (fixture)
    (lwo-field (list (lwigw-a fixture) (lwigw-b fixture)
        (lwigw-c fixture) (lwigw-d fixture))))
(defn lwigw-nodes-ad (fixture)
    (lwo-field (list (lwigw-a fixture) (lwigw-d fixture))))

(defn lwigw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwigw-sum (tail items)))))
