; draft-readings-rows-band.bml — our readings of the body's drafts become trainer rows (observe/draft-readings-to-rows.bml), fkwu-witnessed.
; A scratch ledger stands in for receipts/draft-ledger.jsonl: three drafts read (A accepted after an earlier revised reading, B revised
; with its revised text beside the draft, C rejected with a note), one still pending (D) and one accepted whose draft file is not there (E).
; The draft files are written the way observe/prompt-draft-run.bml writes them, with a turn-before section and a files section after
; the draft, so the reading is held to the shape it meets. The door runs as a child over the scratch; nothing outside it is touched.
;
; Verdict 63 when every claim lands:
;   1    counts: the door exits 0 and prints one JSON line accepted 2, revised 1, rejected 1, rows_written 2, heldout_written 1,
;        skipped_no_text 1 (the latest reading of a draft is its reading; a pending draft adds nothing; E has no text here)
;   2    rows: draft-readings.jsonl holds A then B in the trainer's `messages` shape: A's user is the prompt and its assistant the draft with
;        the context sections cut; B's assistant is the revised text; each line passes the native dataset reader's parse stage
;        (nld-node-of-line: an object with messages whose last role is assistant, what a prompt-masked row needs)
;   4    heldout: draft-readings-heldout.jsonl holds C alone with its session, prompt_t, reading rejected, the reading's note and the
;        messages (the rejected draft's prompt and text)
;   8    receipt: one row with the fixture ledger's sha256 as source_digest, source_rows 10, drafts_present 1, the same counts, both row
;        paths, retention local-only and authorization "our own readings of our own drafts"
;   16   absent: run with a drafts dir that is not there, the door says so, exits 0, writes no trainer row (skipped_no_text 3), and C still
;        lands in the held-out file with its note and no messages (the ledger's own fields); the receipt gains a row with drafts_present 0
;   32   refusal: a key outside ledger, drafts, out, receipt is refused by name (exit 1) and no row file is written
;
; REQUIRES: the built ./fkwu and the body root as the working directory (the door runs as a child).
// preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/bml/live.bml form-stdlib/bml/host-child.bml form-stdlib/qwen35-artifact-seal-reader.fk form-stdlib/native-lora-dataset.bml
section [form.bml] {
 class DraftReadingsRowsBand {
  def drb-has(s, part) = str_find(s, part, 0) >= 0;
  def drb-fresh() {
   let root = temp_dir() ++ "/draft-readings-rows-band-" ++ now_unix_ms().str();
   (Comparable) host_dir_mkdir(root) == 1 ? ["readings", root, 0] : nothing();
  }
  def drb-root(ctx) = ctx[1];
  def drb-drafts(ctx) = drb-root(ctx) ++ "/drafts";
  def drb-out(ctx) = drb-root(ctx) ++ "/out";
  def drb-receipt(ctx) = drb-root(ctx) ++ "/receipt.jsonl";
  def drb-ledger(ctx) = drb-root(ctx) ++ "/ledger.jsonl";
  // ---- the ledger as prompt-draft-run and draft-reading-run write it
  def drb-draft-row(t, id, session, pt) = "{\"at_unix_ms\":" ++ t.str() ++ ",\"draft\":\"" ++ id ++ "\",\"prompt_t\":" ++ pt.str() ++ ",\"session\":\"" ++ session ++ "\",\"path\":\"/elsewhere/" ++ id ++ ".md\",\"voice\":\"answered\",\"generated\":10,\"wall_ms\":1,\"reading\":\"pending\"}\n";
  def drb-reading-row(t, id, reading, note) = "{\"at_unix_ms\":" ++ t.str() ++ ",\"draft\":\"" ++ id ++ "\",\"reading\":\"" ++ reading ++ "\",\"note\":\"" ++ json-escape-string(note) ++ "\"}\n";
  def drb-ledger-text() = drb-draft-row(1, "A-1", "A", 1) ++ drb-draft-row(2, "B-2", "B", 2) ++ drb-draft-row(3, "C-3", "C", 3) ++ drb-draft-row(4, "D-4", "D", 4) ++ drb-draft-row(5, "E-5", "E", 5)
   ++ drb-reading-row(6, "A-1", "revised", "first a miss") ++ drb-reading-row(7, "A-1", "accepted", "") ++ drb-reading-row(8, "B-2", "revised", "right idea, wrong door") ++ drb-reading-row(9, "C-3", "rejected", "stayed inside a \"safety\" wall") ++ drb-reading-row(10, "E-5", "accepted", "");
  def drb-a-prompt() = "What does fkwu own?";
  def drb-a-draft() = "fkwu is the only kernel.\nIt runs Form source directly.";
  def drb-b-prompt() = "Which door lands?";
  def drb-b-revised() = "observe/land-run.bml lands: edits, witness, commit, push.";
  def drb-c-prompt() = "Remove the wall.";
  def drb-c-draft() = "I cannot do that.";
  def drb-draft-file(prompt, draft, tail) = "# The person asked\n\n" ++ prompt ++ "\n\n# The body's draft\n\n" ++ draft ++ "\n" ++ tail;
  def drb-tree(ctx) {
   let d = host_dir_mkdir(drb-drafts(ctx));
   let l = write_file(drb-ledger(ctx), drb-ledger-text());
   let a = write_file(drb-drafts(ctx) ++ "/A-1.md", drb-draft-file(drb-a-prompt(), drb-a-draft(), "\n# The turn before (what the voice was given)\n\nthe turn before, never taught\n"));
   let b = write_file(drb-drafts(ctx) ++ "/B-2.md", drb-draft-file(drb-b-prompt(), "land-run maybe", "\n# Files the voice read\n\nAGENTS.md\n"));
   let br = write_file(drb-drafts(ctx) ++ "/B-2.revised.md", drb-b-revised() ++ "\n");
   let c = write_file(drb-drafts(ctx) ++ "/C-3.md", drb-draft-file(drb-c-prompt(), drb-c-draft(), ""));
   (Comparable) d == 1 ? drb-root(ctx) : nothing();
  }
  // ---- the door as a child
  def drb-request(ctx, drafts, out) = "{\"ledger\":\"" ++ drb-ledger(ctx) ++ "\",\"drafts\":\"" ++ drafts ++ "\",\"out\":\"" ++ out ++ "\",\"receipt\":\"" ++ drb-receipt(ctx) ++ "\"}";
  def drb-door(ctx, name, request) {
   let base = drb-root(ctx) ++ "/" ++ name;
   let w = write_file(base ++ ".in", request);
   let pid = host_spawn_at(["./fkwu", "observe/draft-readings-to-rows.bml"], [base ++ ".in", base ++ ".out", base ++ ".err"]);
   let status = pid <= 0 ? -1 : host_wait(pid);
   [status, read_file(base ++ ".out") ?? "", read_file(base ++ ".err") ?? ""];
  }
  def drb-lines(text) = filter(l => len(trim(l)) > 0, split-on(text, "\n"));
  def drb-last-json(text) = foldl((acc, l) => (len(l) > 0) && ((Comparable) str_byte_at(l, 0) == 123) ? l : acc, "", drb-lines(text));
  def drb-int(doc, key) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : -1;
  def drb-str(doc, key) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : "";
  def drb-counts?(doc, acc, rev, rej, rows, held, skipped) = drb-int(doc, "accepted") == acc && drb-int(doc, "revised") == rev && drb-int(doc, "rejected") == rej && drb-int(doc, "rows_written") == rows && drb-int(doc, "heldout_written") == held && drb-int(doc, "skipped_no_text") == skipped;
  def drb-messages(doc) = json-array-elements(json-object-get(doc, "messages"));
  def drb-content(doc, i) = drb-str(drb-messages(doc)[i], "content");
  def drb-role(doc, i) = drb-str(drb-messages(doc)[i], "role");
  // the reader's parse stage over one line: an object carrying messages whose last role is assistant
  def drb-reads?(line, i) {
   let node = nld-node-of-line(line, i);
   let ms = json-object-has?(node, "messages") ? json-array-elements(json-object-get(node, "messages")) : [];
   !nil?(ms) && (String) drb-str(ms[len(ms) - 1], "role") == "assistant";
  }
  def drb-rows-path(ctx) = drb-out(ctx) ++ "/draft-readings.jsonl";
  def drb-held-path(ctx) = drb-out(ctx) ++ "/draft-readings-heldout.jsonl";
  // ---- 1 counts
  def drb-c-counts(ctx) {
   let made = drb-tree(ctx);
   let r = drb-door(ctx, "run1", drb-request(ctx, drb-drafts(ctx), drb-out(ctx)));
   let doc = parse-json("counts", drb-last-json(r[1]));
   !nothing?(made) && (Comparable) r[0] == 0 && len(filter(l => (Comparable) str_byte_at(l, 0) == 123, drb-lines(r[1]))) == 1 && drb-counts?(doc, 2, 1, 1, 2, 1, 1);
  }
  // ---- 2 rows
  def drb-c-rows(ctx) {
   let lines = drb-lines(read_file(drb-rows-path(ctx)) ?? "");
   let a = parse-json("a", lines[0]);
   let b = parse-json("b", lines[1]);
   len(lines) == 2 && (String) drb-str(a, "draft") == "A-1" && (String) drb-str(a, "reading") == "accepted" && len(drb-messages(a)) == 2
   && (String) drb-role(a, 0) == "user" && (String) drb-content(a, 0) == drb-a-prompt() && (String) drb-role(a, 1) == "assistant" && (String) drb-content(a, 1) == drb-a-draft()
   && (String) drb-str(b, "draft") == "B-2" && (String) drb-str(b, "reading") == "revised" && (String) drb-content(b, 0) == drb-b-prompt() && (String) drb-content(b, 1) == drb-b-revised()
   && drb-reads?(lines[0], 1) && drb-reads?(lines[1], 2);
  }
  // ---- 4 heldout
  def drb-c-heldout(ctx) {
   let lines = drb-lines(read_file(drb-held-path(ctx)) ?? "");
   let c = parse-json("c", lines[0]);
   len(lines) == 1 && (String) drb-str(c, "draft") == "C-3" && (String) drb-str(c, "session") == "C" && drb-int(c, "prompt_t") == 3 && (String) drb-str(c, "reading") == "rejected"
   && (String) drb-str(c, "note") == "stayed inside a \"safety\" wall" && len(drb-messages(c)) == 2 && (String) drb-content(c, 0) == drb-c-prompt() && (String) drb-content(c, 1) == drb-c-draft();
  }
  // ---- 8 receipt
  def drb-digest(path) = qaf-string-hex(saj-file-digest-any-tail(path, file_size(path)));
  def drb-c-receipt(ctx) {
   let lines = drb-lines(read_file(drb-receipt(ctx)) ?? "");
   let r = parse-json("receipt", lines[0]);
   len(lines) == 1 && (String) drb-str(r, "source") == drb-ledger(ctx) && len(drb-str(r, "source_digest")) == 64 && (String) drb-str(r, "source_digest") == drb-digest(drb-ledger(ctx))
   && drb-int(r, "source_rows") == 10 && drb-int(r, "drafts_present") == 1 && drb-counts?(r, 2, 1, 1, 2, 1, 1) && (String) drb-str(r, "rows") == drb-rows-path(ctx) && (String) drb-str(r, "heldout") == drb-held-path(ctx)
   && (String) drb-str(r, "retention") == "local-only" && (String) drb-str(r, "authorization") == "our own readings of our own drafts" && drb-int(r, "at_unix_ms") > 0;
  }
  // ---- 16 absent
  def drb-c-absent(ctx) {
   let out = drb-root(ctx) ++ "/out-absent";
   let r = drb-door(ctx, "run2", drb-request(ctx, drb-root(ctx) ++ "/no-drafts-here", out));
   let doc = parse-json("counts", drb-last-json(r[1]));
   let rows = read_file(out ++ "/draft-readings.jsonl") ?? "";
   let held = drb-lines(read_file(out ++ "/draft-readings-heldout.jsonl") ?? "");
   let c = nil?(held) ? json-node-object([]) : parse-json("c", held[0]);
   let receipts = drb-lines(read_file(drb-receipt(ctx)) ?? "");
   (Comparable) r[0] == 0 && drb-has(r[1], "drafts dir absent here") && drb-counts?(doc, 2, 1, 1, 0, 1, 3) && (Comparable) host_path_exists(out ++ "/draft-readings.jsonl") == 1 && (Comparable) len(rows) == 0
   && len(held) == 1 && (String) drb-str(c, "draft") == "C-3" && (String) drb-str(c, "note") == "stayed inside a \"safety\" wall" && !json-object-has?(c, "messages")
   && len(receipts) == 2 && drb-int(parse-json("r2", receipts[1]), "drafts_present") == 0;
  }
  // ---- 32 refusal
  def drb-c-refusal(ctx) {
   let out = drb-root(ctx) ++ "/out-refused";
   let r = drb-door(ctx, "run3", "{\"ledger\":\"" ++ drb-ledger(ctx) ++ "\",\"drafs\":\"x\",\"out\":\"" ++ out ++ "\"}");
   (Comparable) r[0] == 1 && drb-has(r[1], "unknown key \"drafs\"") && (Comparable) host_path_exists(out ++ "/draft-readings.jsonl") == 0 && len(drb-lines(read_file(drb-receipt(ctx)) ?? "")) == 2;
  }
 }
 let ctx = drb-fresh();
 nothing?(ctx) ? form_error("draft-readings-rows band needs a fresh directory") : 0;
 let verdict = live-claims("draft-readings-rows-band", ctx, [["counts", 1, 1, drb-c-counts], ["rows", 2, 1, drb-c-rows], ["heldout", 4, 1, drb-c-heldout], ["receipt", 8, 1, drb-c-receipt], ["absent", 16, 1, drb-c-absent], ["refusal", 32, 1, drb-c-refusal]]);
 host_dir_rmdir(drb-root(ctx));
 verdict;
}
