; form-cli-share-glass-band.fk — percentages enter Glass only after an
; observed completed-turn reconciliation. Expected: 65535
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/line-grammar.fk
; preludes: form-stdlib/form-glass-telemetry-membrane.bml
; preludes: form-stdlib/bml/form-cli-share-glass.bml

(do
    (defn fcsgb-bit (ok bit) (if ok bit 0))
    (defn fcsgb-member-id (samples wanted)
        (if (eq (len samples) 0) 0
            (if (str_eq (fgtm-sample-id (head samples)) wanted) 1
                (fcsgb-member-id (tail samples) wanted))))
    (let root "/tmp/form-cli-share-glass-band")
    (let publisher "share.test")
    (let evidence (fcte-parse
        "turn-evidence-v3|thread-3|turn-3|openai|gpt-test|1000|2000|1000|100|128|2|1000|600|400|0|200|50|1225|3|3|400|2048|2|1|100|20|120|1|0|2|2|5|1|codex-rollout-jsonl+explicit-form-binding|1|25|3000|0|2000"))
    (let invalid (fcte-parse "unmeasured"))
    (let observed (fcsg-observed-samples 1000 (list 10 41 49) 2028))
    (let withheld (fcsg-withheld-samples 1001))
    (let snapshot (fgtm-snapshot (fcsg-publisher) 1000 observed))
    (let observed-published (fcsg-publish-evidence-at root publisher 1002 evidence))
    (let observed-reading (fgtm-read-current root publisher))
    (let observed-current (fgtm-field-value
        (fgtm-read-state-value observed-reading)))
    (let observed-current-samples (fgtm-snapshot-samples observed-current))
    ; The same publisher must atomically replace percentages with a single
    ; withheld node when the next evidence tuple does not reconcile.
    (let withheld-published (fcsg-publish-evidence-at root publisher 1003 invalid))
    (let withheld-reading (fgtm-read-current root publisher))
    (let withheld-current (fgtm-field-value
        (fgtm-read-state-value withheld-reading)))
    (let withheld-current-samples (fgtm-snapshot-samples withheld-current))
    (sum (list
        (fcsgb-bit (eq (len observed) 4) 1)
        (fcsgb-bit (eq (fgtm-samples-valid? observed) 1) 2)
        (fcsgb-bit (eq (fgtm-snapshot-valid? snapshot) 1) 4)
        (fcsgb-bit (str_eq (fgtm-sample-id (nth observed 0))
            "share.previous.completed") 8)
        (fcsgb-bit (eq (fgtm-field-value
            (fgtm-sample-capacity (nth observed 1))) 10) 16)
        (fcsgb-bit (eq (fgtm-field-value
            (fgtm-sample-capacity (nth observed 2))) 41) 32)
        (fcsgb-bit (eq (fgtm-field-value
            (fgtm-sample-capacity (nth observed 3))) 49) 64)
        (fcsgb-bit (eq (add (fgtm-field-value
            (fgtm-sample-capacity (nth observed 1)))
            (add (fgtm-field-value (fgtm-sample-capacity (nth observed 2)))
                (fgtm-field-value (fgtm-sample-capacity (nth observed 3))))) 100) 128)
        (fcsgb-bit (eq (len withheld) 1) 256)
        (fcsgb-bit (str_eq (fgtm-sample-id (head withheld))
            "share.previous.withheld") 512)
        (fcsgb-bit (eq (fgtm-field-present?
            (fgtm-sample-capacity (head withheld))) 0) 1024)
        (fcsgb-bit (and (str_eq (fgtm-sample-purpose (head withheld))
            "measurement-withheld")
            (eq (fgtm-samples-valid? withheld) 1)) 2048)
        (fcsgb-bit (and (eq (fcte-valid? evidence) 1)
            (eq (len (fcsg-samples-for-evidence 1002 evidence)) 4)) 4096)
        (fcsgb-bit (and (str_eq (fcsg-publish-status observed-published)
            "published") (and (str_eq (fgtm-read-state-status observed-reading)
                "current") (eq (len observed-current-samples) 4))) 8192)
        (fcsgb-bit (and (eq (fgtm-field-value (fgtm-sample-capacity
            (nth observed-current-samples 1))) 20)
            (and (eq (fgtm-field-value (fgtm-sample-capacity
                (nth observed-current-samples 2))) 40)
                (eq (fgtm-field-value (fgtm-sample-capacity
                    (nth observed-current-samples 3))) 40))) 16384)
        (fcsgb-bit (and (str_eq (fcsg-publish-status withheld-published)
            "published") (and (str_eq (fgtm-read-state-status withheld-reading)
                "current") (and (eq (len withheld-current-samples) 1)
                    (and (str_eq (fgtm-sample-id (head withheld-current-samples))
                        "share.previous.withheld")
                        (and (eq (fgtm-field-present? (fgtm-sample-capacity
                            (head withheld-current-samples))) 0)
                            (and (eq (fcsgb-member-id withheld-current-samples
                                "share.previous.native") 0)
                                (eq (fcsgb-member-id withheld-current-samples
                                    "share.previous.remote") 0))))))) 32768))))
