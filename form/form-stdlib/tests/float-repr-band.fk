; float-repr-band.fk -- float-repr (the BML Dragon4 recipe in core.fk) renders a finite double
; byte-identically to the native value_str (Go strconv 'g') on all four kernels. The digits come from
; arbitrary-precision integer work (bn-*) over the exact m*2^e, no dtoa primitive, so this pins that the
; recipe reaches the same shortest-round-trip layout the native does on every platform -- including the
; power-of-two halfgap class, the round-to-even tie, and negative zero. Verdict-only (no print_str, which
; is fkwu-only); each bit compares float-repr to THIS kernel's value_str, so a sibling that rendered a
; class differently drops its bit. The exponent range is kept modest so the BML recipe, which WALKS on the
; sibling interpreters (it is JIT-warm only on fkwu), finishes on all four; the extreme subnormals and the
; 2^-1017 halfgap are witnessed by fkwu here and by the offline 10180-double sweep against Go strconv in
; receipts/2026-09-13-the-float-path-needs-no-dtoa-native.md.
;
; Verdict 63
; preludes: form-stdlib/core.fk
;
;   1  powers of two 2^k and 3/5/7*2^k over k in [-40,40] print as value_str does (the halfgap/bdy path)
;   2  powers of ten 10^k over k in [-12,12] print as value_str does (fixed and scientific layout)
;   4  the round-to-even tie 147142857142857.125 == "1.4714285714285712e+14"
;   8  negative zero prints "-0" and positive zero "0", recipe and native agree
;  16  named exact cases print exactly (0.1, 1e23, 100000, 999999, 1e6, 0.000123, 2^-24)
;  32  a deterministic pseudo-random set of doubles (moderate exponents) prints as value_str does
(do
    (defn eqv (x) (if (str_eq (float-repr x) (value_str x)) 1 0))
    (defn bit (ok b) (if (eq ok 1) b 0))
    (defn p2up (x k n acc) (if (gt k n) acc (p2up (mul x 2.0) (add k 1) n (add acc (add (eqv x) (add (eqv (mul x 3.0)) (add (eqv (mul x 5.0)) (eqv (mul x 7.0)))))))))
    (defn p2dn (x k n acc) (if (lt k n) acc (p2dn (div x 2.0) (sub k 1) n (add acc (add (eqv x) (add (eqv (mul x 3.0)) (add (eqv (mul x 5.0)) (eqv (mul x 7.0)))))))))
    (defn p10up (x k n acc) (if (gt k n) acc (p10up (mul x 10.0) (add k 1) n (add acc (eqv x)))))
    (defn p10dn (x k n acc) (if (lt k n) acc (p10dn (div x 10.0) (sub k 1) n (add acc (eqv x)))))
    (let two-ok (eq (add (p2up 1.0 0 40 0) (p2dn 0.5 -1 -40 0)) (add (mul 41 4) (mul 40 4))))
    (let ten-ok (eq (add (p10up 1.0 0 12 0) (p10dn 0.1 -1 -12 0)) (add 13 12)))
    (let tie-ok (if (eq (eqv 147142857142857.125) 1) (str_eq (float-repr 147142857142857.125) "1.4714285714285712e+14") 0))
    (let nzero (mul -1.0 0.0))
    (let zero-ok (if (str_eq (float-repr nzero) "-0") (if (str_eq (float-repr 0.0) "0") (if (str_eq (float-repr nzero) (value_str nzero)) (str_eq (float-repr 0.0) (value_str 0.0)) 0) 0) 0))
    (let named-ok (if (str_eq (float-repr 0.1) "0.1") (if (str_eq (float-repr 1e23) "1e+23") (if (str_eq (float-repr 100000.0) "100000") (if (str_eq (float-repr 999999.0) "999999") (if (str_eq (float-repr 1e6) "1e+06") (if (str_eq (float-repr 0.000123) "0.000123") (str_eq (float-repr 5.9604644775390625e-08) "5.960464477539063e-08") 0) 0) 0) 0) 0) 0))
    (defn rnd (s i n acc) (if (ge i n) acc (do (let s2 (add (mul s 6364136223846793005) 1442695040888963407)) (let m (mod (div s2 4096) 9007199254740992)) (let x (div (add 4503599627370496.0 (mul m 1.0)) 4503599627370496.0)) (rnd s2 (add i 1) n (add acc (add (eqv (mul x 1e-6)) (add (eqv x) (eqv (mul x 1e6)))))))))
    (let rnd-ok (eq (rnd 88172645463325252 0 40 0) 120))
    (add (bit (if two-ok 1 0) 1) (add (bit (if ten-ok 1 0) 2) (add (bit tie-ok 4) (add (bit zero-ok 8) (add (bit named-ok 16) (bit (if rnd-ok 1 0) 32))))))
)
