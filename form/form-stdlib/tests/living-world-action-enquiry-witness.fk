; living-world-action-enquiry-witness.fk -- plurality can ask and receive without choosing.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-action-enquiry.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk

(let LWAEW-PROVENANCE (bp "LWAEW-PROVENANCE"))
(let LWAEW-EVIDENCE   (bp "LWAEW-EVIDENCE"))
(let LWAEW-DIRECTION  (bp "LWAEW-DIRECTION"))

(defn lwaew-cell (kind) (intern_node kind (empty)))
(defn lwaew-provenance () (lwaew-cell LWAEW-PROVENANCE))
(defn lwaew-evidence () (lwaew-cell LWAEW-EVIDENCE))
(defn lwaew-direction () (lwaew-cell LWAEW-DIRECTION))

(defn lwaew-world () (lwacw-ambiguous-world))
(defn lwaew-field ()
    (lwac-field-for (lwaew-world) (lwacw-focus) 2))
(defn lwaew-question-proposal ()
    (lwae-question-proposal (lwaew-world) (lwacw-focus) 2))
(defn lwaew-question-candidate ()
    (lwt-proposal-candidate (lwaew-question-proposal)))

(defn lwaew-response-entry (source proposal)
    (lwrew-entry-for source (lwaew-provenance)
        (lwt-response proposal (oac-one proposal)
            (lwaew-provenance))))

(defn lwaew-response-entries (sources proposal)
    (if (eq (len sources) 0) (list)
        (append
            (list (lwaew-response-entry (head sources) proposal))
            (lwaew-response-entries (tail sources) proposal))))

(defn lwaew-question-round ()
    (do
        (let proposal (lwaew-question-proposal))
        (lwt-round (lwaew-world)
            (lwo-field (list proposal)) (lwo-empty-field) (lwo-none))))

(defn lwaew-question-waiting-round ()
    (do
        (let round (lwaew-question-round))
        (lwae-integrate-question round
            (lwaew-question-proposal) (lwrew-action))))

(defn lwaew-question-yes-round ()
    (do
        (let round (lwaew-question-round))
        (let proposal (lwaew-question-proposal))
        (lwt-round-receive round
            (lwaew-response-entries
                (lwo-field-items
                    (lwt-proposal-participants proposal))
                proposal))))

(defn lwaew-question-integrated-round ()
    (do
        (let round (lwaew-question-yes-round))
        (lwae-integrate-question round
            (lwaew-question-proposal) (lwrew-action))))

(defn lwaew-question-world ()
    (lwt-round-world (lwaew-question-integrated-round)))

(defn lwaew-blueprint-lens ()
    (lwlc-lens (lwlc-blueprint-shape)
        (lwacw-focus) (lwaew-evidence)))
(defn lwaew-cell-lens ()
    (lwlc-lens (lwlc-cell-shape)
        (lwacw-action-a) (lwaew-evidence)))
(defn lwaew-alternative-lens ()
    (lwlc-lens (lwlc-cell-shape)
        (lwacw-action-b) (lwaew-evidence)))

(defn lwaew-layered-declaration ()
    (lwlc-declaration (lwaew-direction)
        (lwlc-stack
            (lwaew-blueprint-lens)
            (lwlc-layers
                (list (lwrew-recipe-lens) (lwaew-cell-lens)))
            (lwo-field (list (lwaew-alternative-lens)))
            (lwlc-unknown (lwaew-evidence))
            (lwaew-evidence))
        (lwaew-evidence)))

(defn lwaew-default-timeout (question)
    (oac-timeout (intern_trivial_int 10)
        (oac-alternative-ack question
            (lwacw-action-a) (lwaew-evidence))
        (lwaew-evidence)))

(defn lwaew-no-default-timeout ()
    (oac-timeout (intern_trivial_int 10)
        (oac-no-default) (lwaew-evidence)))

(defn lwaew-immediate-stance ()
    (lwae-stance (lwaew-question-candidate)
        (oac-nothing) (lwo-none) (lwo-none)
        (lwo-empty-field) (lwo-none) (lwaew-evidence)))

(defn lwaew-pending-stance ()
    (do
        (let question (lwaew-question-candidate))
        (lwae-stance question
            (oac-alternative-ack question
                (lwacw-action-a) (lwaew-evidence))
            (oac-timeout-condense
                (lwaew-default-timeout question)
                (intern_trivial_int 5))
            (lwaew-layered-declaration)
            (lwo-field (list (lwacw-action-b)))
            (lwlc-unknown (lwaew-evidence))
            (lwaew-evidence))))

(defn lwaew-default-outcome-stance ()
    (do
        (let question (lwaew-question-candidate))
        (let outcome
            (oac-timeout-condense
                (lwaew-default-timeout question)
                (intern_trivial_int 10)))
        (lwae-stance question
            (oac-time-outcome-ack outcome) outcome
            (lwrew-declaration)
            (lwo-field (list (lwacw-action-a) (lwacw-action-b)))
            (lwo-none) (lwaew-evidence))))

(defn lwaew-expired-nothing-stance ()
    (do
        (let outcome
            (oac-timeout-condense
                (lwaew-no-default-timeout)
                (intern_trivial_int 10)))
        (lwae-stance (lwaew-question-candidate)
            (oac-time-outcome-ack outcome) outcome
            (lwo-none) (lwo-empty-field) (lwo-none)
            (lwaew-evidence))))

(defn lwaew-stanced-world ()
    (lwt-receive-stream (lwaew-question-world)
        (list
            (lwacw-entry-c (lwaew-immediate-stance))
            (lwacw-entry-d (lwaew-pending-stance))
            (lwacw-entry-e (lwaew-default-outcome-stance))
            (lwacw-entry-h (lwaew-expired-nothing-stance)))))

; I did not govern the question. Its attribution may carry the same stance
; identity into the world, but it cannot enter question-scoped evidence.
(defn lwaew-outsider-world ()
    (lwt-receive-stream (lwaew-stanced-world)
        (list (lwacw-entry-i (lwaew-immediate-stance)))))

(defn lwaew-stance-evidence ()
    (lwae-stance-evidence-for
        (lwaew-stanced-world) (lwaew-question-candidate)))

(defn lwaew-revoked-world ()
    (lwt-receive-stream (lwaew-stanced-world)
        (list
            (lwacw-entry-h
                (lwo-revocation (lwacw-offer-b) (lwacw-source-h)
                    (lwrew-action) (lwacw-prov-h))))))

(defn lwaew-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwaew-sum (tail items)))))

0
