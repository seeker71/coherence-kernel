// Retained provider results and missing/zero/adversarial counter boundaries.
// preludes: form-stdlib/bml/form-cli-native-compare.bml
section [form.bml] {
 class ProviderModelUsageBand {
  def pmub-need(ok,why) = if ok then 1 else form_error(why);
  def pmub-read(path) = pmu-report(parse-json(path,read_file(path)));
  def pmub-total(report,total,cached,uncached,output) = and(str_eq(fnc-str(report,"status"),"observed"),and(eq(fnc-int(report,"total_tokens"),total),and(eq(fnc-int(report,"cached_input_tokens"),cached),and(eq(fnc-int(report,"uncached_input_tokens"),uncached),eq(fnc-int(report,"output_tokens"),output)))));
  def pmub-invalid(text) {
   let report = pmu-report(parse-json("counter-case",text));
   and(str_eq(fnc-str(report,"status"),"unobserved"),node_eq(json-object-get(report,"total_tokens"),json-node-null()));
  }
  def pmub-value(value) = mc-cat(list("{\"modelUsage\":{\"main\":{\"inputTokens\":",value,",\"cacheReadInputTokens\":0,\"cacheCreationInputTokens\":0,\"outputTokens\":0}}}"));
  def pmub-invalid-values(xs) = if nil?(xs) then 1 else and(pmub-invalid(pmub-value(head(xs))),pmub-invalid-values(tail(xs)));
 }
 let direct = pmub-read("receipts/artifacts/2026-09-18-direct-form-cli-result.json");
 let bounded = pmub-read("receipts/artifacts/2026-09-18-bounded-form-cli-result.json");
 let relay = pmub-read("receipts/artifacts/2026-09-18-fresh-session-native-call-result.json");
 pmub-need(pmub-total(direct,649462,577522,60953,10987),"direct auxiliary usage omitted or double-counted");
 pmub-need(pmub-total(bounded,45966,32461,8970,4535),"bounded auxiliary usage omitted or double-counted");
 pmub-need(pmub-total(relay,27747,19691,5729,2327),"relay auxiliary usage omitted or double-counted");
 let two = pmu-report(parse-json("two-models","{\"usage\":{\"input_tokens\":9999},\"modelUsage\":{\"main\":{\"inputTokens\":100,\"cacheReadInputTokens\":20,\"cacheCreationInputTokens\":30,\"outputTokens\":40},\"aux\":{\"inputTokens\":1,\"cacheReadInputTokens\":2,\"cacheCreationInputTokens\":3,\"outputTokens\":4}}}"));
 pmub-need(and(pmub-total(two,200,22,134,44),eq(fnc-int(two,"model_count"),2)),"reported models did not sum independently of summary usage");
 pmub-need(pmub-total(pmu-report(parse-json("zero",pmub-value("0"))),0,0,0,0),"observed zero became absence");
 pmub-need(pmub-invalid-values(list("-1","true","null","1.5","\"2\"")),"invalid counter became a measured number");
 pmub-need(pmub-invalid("{\"modelUsage\":{\"main\":{\"inputTokens\":1,\"cacheReadInputTokens\":2,\"cacheCreationInputTokens\":3}}}"),"missing output counter became zero");
 pmub-need(pmub-invalid("{\"modelUsage\":{\"main\":{\"inputTokens\":1,\"cacheReadInputTokens\":2,\"cacheCreationInputTokens\":3,\"outputTokens\":4},\"aux\":{}}}"),"partial reported-model total became complete");
 pmub-need(and(pmub-invalid("{}"),and(pmub-invalid("{\"modelUsage\":{}}"),pmub-invalid("{\"modelUsage\":[]}"))),"absent model usage became zero");
 let routes = fnc-rows(fnc-route-ledger());
 pmub-need(str_eq(fnc-str(fnc-route-usage(head(routes)),"status"),"unobserved"),"partial guided turn became an all-model total");
 pmub-need(eq(fnc-int(fnc-route-usage(nth(routes,3)),"total_tokens"),27747),"relay result link does not resolve to its usage");
 let directLine = fnc-route-line(nth(routes,1)); let guidedLine = fnc-route-line(head(routes));
 pmub-need(and(ge(str_find(directLine,"selected rent 649462",0),0),lt(str_find(directLine,"648411",0),0)),"native comparison presents competing token quantities");
 pmub-need(and(ge(str_find(directLine,"auxiliary-model call count unobserved",0),0),ge(str_find(directLine,"all-reported-models",0),0)),"native comparison grants token coverage to call counts");
 pmub-need(and(ge(str_find(guidedLine,"selected rent 2544568",0),0),and(ge(str_find(guidedLine,"partial turn",0),0),ge(str_find(guidedLine,"cached input null",0),0))),"native comparison loses the guided partial scope or invents a breakdown");
 print_str(json-emit(json-node-object(list(json-node-pair("direct",direct),json-node-pair("bounded",bounded),json-node-pair("relay",relay),fhn-n("boundary_checks",1)))));
 1;
}
