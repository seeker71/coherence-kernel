; form-cli-peer-live-dispatch-band.fk -- expected: 255
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-peer-native-dispatch.bml

(do
    (defn fcpaldb-bit (held weight) (if held weight 0))
    (defn form-cli-peer-live-dispatch-band ()
        (do
            ; A Qwen-shaped session is unnecessary to this route. If the
            ; dispatcher touched a model action first, this sentinel would be
            ; rejected rather than returning the native program result.
            (let sentinel (list "non-fcms-sentinel" 17))
            (let native-program (fcrnp-load (frpce-empty)))
            (let result (fcpn-run-task sentinel (nothing) native-program 1
                "native 41"))
            (let none (fcpn-run-task sentinel (nothing) native-program 2
                "native 0"))
            (let refused (fcpn-run-task sentinel (nothing) native-program 3
                "native not-a-number"))
            (add
                (fcpaldb-bit (and (value_eq (fcpa-session result) sentinel)
                    (str_eq (fcpa-route result) "resident-native-program")) 1)
            (add
                (fcpaldb-bit (and (eq (fcpa-value-present? result) 1)
                    (eq (fcpa-value result) 42)) 2)
            (add
                (fcpaldb-bit (and (eq (fcpa-callback-calls result) 0)
                    (eq (fcpa-injected-bytes result) 0)) 4)
            (add
                (fcpaldb-bit (str_eq (fcpa-carrier result)
                    "form-native-bml-bmf-resident-nodeid") 8)
            (add
                (fcpaldb-bit (and (eq (fcpa-value-present? none) 1)
                    (nothing? (fcpa-value none))) 16)
            (add
                (fcpaldb-bit (and (value_eq (fcpa-session refused) sentinel)
                    (str_eq (fcrnp-invocation-signal
                        (fcpa-cursor refused)) "choice")) 32)
            (add
                (fcpaldb-bit (str_eq (fcpa-lifecycle result)
                    "resident-nodeid,call,return,observe,release") 64)
                (fcpaldb-bit (and (eq (fcpa-callback-calls refused) 0)
                    (str_eq (fcpa-response refused)
                        "resident-native-program signal=choice")) 128))))))))))
    (form-cli-peer-live-dispatch-band))
