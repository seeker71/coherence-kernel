; form-knowledge-query-memory-band.fk -- answer-free adaptive memory proof.
;
; Verdict 4095:
;   1     valid source-bound offer promotes after a >=95 physical witness
;   2     memory reconstructs from current source and independent question
;   4     exact query bytes are selected
;   8     no answer and no model-executed claim are stored
;   16    evidence hash, score and both releases remain visible
;   32    first rollback points to an explicit nothing alternative
;   64    a changed question dissolves selection to exact nothing
;   128   a below-95 candidate is not promoted
;   256   a missing release is not promoted
;   512   malformed evidence is not promoted
;   1024  a successor points back to the prior immutable memory NodeID
;   2048  source, question and offer identities are content-bound
;
; preludes: form-stdlib/core.fk form-stdlib/form-knowledge-query-memory.fk

(do
    (defn fkqmb-bit (ok bit) (if ok bit 0))
    (let path "axioms/core-axioms.form")
    (let question
        "How many axioms are held as the resting point in core-axioms.form? Reply with only the English number.")
    (let offer (fkap-rag-query-offer path "resting point" question))
    (let evidence
        "4d7db831fdb44d9a7dbc7cc934c1177e94117f3f94852219bdc51153a2d0ac50")
    (let memory (fkqm-promote offer question evidence 1000000 1 1
        (nothing)))
    (let selected (fkqm-select memory question))
    (let changed (str_concat question " changed"))
    (let successor (fkqm-promote offer question
        "e21308762343a4f548f67bda9c8f184b5cfdb8bb093099f2b8d3e46e065d9e74"
        950000 1 1 memory))
    (sum (list
        (fkqmb-bit (not (nothing? memory)) 1)
        (fkqmb-bit (eq (fkqm-memory-valid? memory question) 1) 2)
        (fkqmb-bit (str_eq selected (nth offer 3)) 4)
        (fkqmb-bit (and (eq (nth memory 15) 0)
                        (eq (nth memory 16) 0)) 8)
        (fkqmb-bit (and (str_eq (nth memory 9) evidence)
                    (and (eq (nth memory 10) 1000000)
                    (and (eq (nth memory 11) 1)
                         (eq (nth memory 12) 1)))) 16)
        (fkqmb-bit (node_eq (fkqm-undo-node memory)
                            (fkqm-empty-rollback-node)) 32)
        (fkqmb-bit (nothing? (fkqm-select memory changed)) 64)
        (fkqmb-bit (nothing? (fkqm-promote offer question evidence
            949999 1 1 (nothing))) 128)
        (fkqmb-bit (nothing? (fkqm-promote offer question evidence
            1000000 1 0 (nothing))) 256)
        (fkqmb-bit (nothing? (fkqm-promote offer question "bad"
            1000000 1 1 (nothing))) 512)
        (fkqmb-bit (and (not (nothing? successor))
                        (node_eq (fkqm-undo-node successor)
                                 (nth memory 1))) 1024)
        (fkqmb-bit (and (str_eq (nth memory 6) (nth offer 5))
                    (and (str_eq (nth memory 8) (nth offer 7))
                         (str_eq (nth memory 3) (nth offer 2)))) 2048))))
