; preludes: form-stdlib/core.fk
;
; byte-waist-band.fk — what the string narrow waist actually agrees on, measured
; rather than declared.
;
; core.fk's header calls str_len / str_byte_at / byte_to_str / str_concat the
; native composition floor — "measure, decompose (one raw byte, 0-255),
; construct (the exact dual), join" — and says it is byte-identical on fkwu, Go,
; Rust and TS. Three of those four names are. `byte_to_str` is not, and nothing
; in the tree said so until this band, because everything that exercised it
; passed ASCII through it. Measured 2026-07-26:
;
;   (str_byte_at (byte_to_str n) 0)   n=65  127  128  169  206  255
;     fkwu                              65  127  128  169  206  255
;     go / rust / ts                    65  127  194  194  195  195
;
; Above 127 the walkers read n as a codepoint and hand back its two-byte UTF-8
; encoding, so decompose-then-construct is the identity for half the range there
; and all of it on fkwu. This band does NOT assert a number above 127 — a band
; that did would be red on three arms forever and teach nothing. It asserts the
; floor that is genuinely four-way, plus the INVARIANT that links the two halves:
; the construct is the exact dual exactly when it produces one byte. That claim
; is true on fkwu because both sides hold, true on the walkers because both sides
; fail, and it goes red on any arm where they come apart — which is the only
; honest way to pin a divergence in a four-way band.
;
; Bits 64 and 128, added 2026-07-26, pin the rule that came out of counting the
; 191 `(ord (char_at …))` sites in this tree and RUNNING a sample of them rather
; than reading them. Three cells that looked like the next `cur-peek` — json.fk,
; llama3-pretokenize.fk, escape-reader.fk — turned out clean when run on real
; multilingual text, and grammar-chars.fk's `cm-string` matches a literal with a
; glyph in it on all four arms even though its `cs-peek-cp` is `cur-peek`'s twin
; body for body. The reason is the same in every case:
;
;   **the fault bites at an ASYMMETRY, not at the accessor.**
;
; Where both sides of a comparison go through `char_at`, every arm agrees — even
; where `char_at` answers -1 inside a glyph, because it answers -1 on both sides.
; Where one side reads a TRUE byte and the other reads through `char_at`, the arms
; come apart. That is why 83 of the 87 comparison sites cannot bite: their other
; side is a literal ASCII constant, which -1 never equals on any arm. And it is
; why `bmf-core`'s `match-lit` broke — it walked the pattern with `str_byte_at`
; and the source with `cur-peek`, one true byte against one floored read.
;
; Measured at offset 1 of "Ωb", strictly inside the two-byte glyph:
;
;                                          fkwu   go   rust   ts
;   (eq (ord (char_at s 1)) (ord (char_at s 1)))   1     1     1    1   symmetric
;   (eq (str_byte_at s 1)   (ord (char_at s 1)))   1     0     0    0   asymmetric
;
; And `char_at` itself has THREE semantics across the seven evaluators, which is
; why the mixed form is asserted nowhere below. Over "Ωb", (len · ord · true byte):
;
;                        offset 0                offset 1 (inside the glyph)
;   fkwu                 1 · 206 · 206           1 · 169 · 169   one raw byte
;   go / rust heavy      2 · 206 · 206           0 ·  -1 · 169   whole char, first byte
;   ts heavy             2 · 937 · 206           0 ·  -1 · 169   whole char, codepoint
;   the three walkers    1 · 206 · 206           1 · 169 · 169   one raw byte
;
; The heavy go and rust kernels agree with fkwu on `ord` at a character start and
; disagree on `str_len` of the same read — so "does char_at give the true byte"
; and "does char_at give one byte" are NOT the same question there, which is why
; the first draft of bit 128 asked the second and went red on two arms. Recorded
; rather than smoothed: `str_byte_at` is the only one of the three that answers
; the same on all seven.
;
; Verdict 255 when every claim lands:
;   1   DECOMPOSE   — str_byte_at reads both bytes of a two-byte glyph
;   2   MEASURE     — str_len counts bytes, not characters
;   4   ASCII DUAL  — byte_to_str is the exact dual for every n in 0..127
;   8   JOIN        — str_concat joins byte-exactly across a character boundary
;   16  LINKED      — dual-holds?(n) equals one-byte?(n) at 128, 169, 206, 255
;   32  LITERAL     — every byte offset of a mixed-script literal reads back
;   64  SYMMETRY    — a comparison of char_at against itself holds inside a glyph
;   128 JOIN OFFSET — str_byte_at is offset-stable across a concatenation seam,
;                     read from inside the glyphs on either side of it
(do
    ;; the exact dual, asked one byte at a time
    (defn bw-dual? (n) (if (eq (str_byte_at (byte_to_str n) 0) n) 1 0))
    (defn bw-one-byte? (n) (if (eq (str_len (byte_to_str n)) 1) 1 0))

    ;; sweep 0..127: the dual holds AND each is one byte, for every value
    (defn bw-ascii-sweep (n acc)
        (if (gt n 127) acc
            (bw-ascii-sweep (add n 1)
                (and acc (and (bw-dual? n) (bw-one-byte? n))))))

    ;; the invariant: exact-dual and one-byte are the same question
    (defn bw-linked? (n) (if (eq (bw-dual? n) (bw-one-byte? n)) 1 0))

    ;; 1 — decompose: the two bytes of a lambda, 0xCE 0xBB
    (let c0 (if (and (eq (str_byte_at "λ" 0) 206) (eq (str_byte_at "λ" 1) 187)) 1 0))

    ;; 2 — measure: bytes, not characters
    (let c1 (if (and (eq (str_len "λ") 2)
                     (and (eq (str_len "€") 3) (eq (str_len "λ€") 5))) 2 0))

    ;; 4 — the dual over the whole ASCII range, all 128 values
    (let c2 (if (eq (bw-ascii-sweep 0 1) 1) 4 0))

    ;; 8 — join: the euro's first byte still sits at offset 2 after concatenation
    (let j (str_concat "λ" "€"))
    (let c3 (if (and (eq (str_byte_at j 1) 187) (eq (str_byte_at j 2) 226)) 8 0))

    ;; 16 — the linked invariant, at four values above 127
    (let c4 (if (and (bw-linked? 128)
                     (and (bw-linked? 169)
                          (and (bw-linked? 206) (bw-linked? 255)))) 16 0))

    ;; 32 — a literal carrying two scripts reads back byte by byte: Ω is CE A9
    (let s "Ω+1")
    (let c5 (if (and (eq (str_len s) 4)
                     (and (eq (str_byte_at s 0) 206)
                          (and (eq (str_byte_at s 1) 169)
                               (and (eq (str_byte_at s 2) 43)
                                    (eq (str_byte_at s 3) 49))))) 32 0))

    ;; 64 — symmetry: char_at read against itself, strictly inside the glyph.
    ;;      True on every arm, including the three where the read is -1.
    (let g "Ωb")
    (let c6 (if (eq (ord (char_at g 1)) (ord (char_at g 1))) 64 0))

    ;; 128 — offset stability under join, across a character boundary. Every
    ;;       byte-walking scanner in this tree depends on it: the byte at
    ;;       offset i of (str_concat a b) is a's byte i while i < len a, and
    ;;       b's byte (i - len a) after. Checked at the two offsets INSIDE the
    ;;       glyphs on either side of the seam, which is where it could fail.
    (defn bw-join-at? (a b i)
        (if (lt i (str_len a))
            (if (eq (str_byte_at (str_concat a b) i) (str_byte_at a i)) 1 0)
            (if (eq (str_byte_at (str_concat a b) i) (str_byte_at b (sub i (str_len a)))) 1 0)))
    (let c7 (if (and (and (bw-join-at? "Ω" "€" 1) (bw-join-at? "Ω" "€" 2))
                     (and (bw-join-at? "Ω" "€" 4) (bw-join-at? "Ω" "€" 0))) 128 0))

    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
