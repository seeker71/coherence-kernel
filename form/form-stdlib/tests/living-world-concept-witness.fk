; living-world-concept-witness.fk -- two independently offered nested lenses.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk

(let LWCXW-X      (bp "LWCXW-X"))
(let LWCXW-X-INNER (bp "LWCXW-X-INNER"))
(let LWCXW-Y      (bp "LWCXW-Y"))
(let LWCXW-Y-INNER (bp "LWCXW-Y-INNER"))
(let LWCXW-Z      (bp "LWCXW-Z"))
(let LWCXW-Z-INNER (bp "LWCXW-Z-INNER"))
(let LWCXW-ACTION (bp "LWCXW-ACTION"))

(defn lwcxw-action () LWCXW-ACTION)
(defn lwcxw-interface () (lwo-interface (list LWCXW-ACTION)))
(defn lwcxw-source-a () (intern_trivial_string "lwcxw-source-a"))
(defn lwcxw-source-b () (intern_trivial_string "lwcxw-source-b"))
(defn lwcxw-source-c () (intern_trivial_string "lwcxw-source-c"))
(defn lwcxw-source-d () (intern_trivial_string "lwcxw-source-d"))
(defn lwcxw-source-e () (intern_trivial_string "lwcxw-source-e"))
(defn lwcxw-provenance-a () (intern_trivial_string "lwcxw-provenance-a"))
(defn lwcxw-provenance-b () (intern_trivial_string "lwcxw-provenance-b"))
(defn lwcxw-provenance-c () (intern_trivial_string "lwcxw-provenance-c"))
(defn lwcxw-provenance-d () (intern_trivial_string "lwcxw-provenance-d"))
(defn lwcxw-provenance-e () (intern_trivial_string "lwcxw-provenance-e"))
(defn lwcxw-response-provenance ()
    (intern_trivial_string "lwcxw-response-provenance"))
(defn lwcxw-marker () (intern_trivial_string "lwcxw-marker"))

(defn lwcxw-x (first second time)
    (lwo-compose LWCXW-X
        (list (lwo-compose LWCXW-X-INNER (list first second)) time)))
(defn lwcxw-y (first second time)
    (lwo-compose LWCXW-Y
        (list (lwo-compose LWCXW-Y-INNER (list first second)) time)))
(defn lwcxw-z (first second time)
    (lwo-compose LWCXW-Z
        (list (lwo-compose LWCXW-Z-INNER (list first second))
              time (lwcxw-marker))))

(defn lwcxw-x-a ()
    (lwcxw-x (intern_trivial_string "alice")
             (intern_trivial_string "red")
             (intern_trivial_string "morning")))
(defn lwcxw-y-a ()
    (lwcxw-y (intern_trivial_string "red")
             (intern_trivial_string "alice")
             (intern_trivial_string "morning")))
(defn lwcxw-z-a ()
    (lwcxw-z (intern_trivial_string "alice")
             (intern_trivial_string "red")
             (intern_trivial_string "morning")))
(defn lwcxw-x-b ()
    (lwcxw-x (intern_trivial_string "bob")
             (intern_trivial_string "blue")
             (intern_trivial_string "evening")))
(defn lwcxw-y-b ()
    (lwcxw-y (intern_trivial_string "blue")
             (intern_trivial_string "bob")
             (intern_trivial_string "evening")))
(defn lwcxw-z-b ()
    (lwcxw-z (intern_trivial_string "bob")
             (intern_trivial_string "blue")
             (intern_trivial_string "evening")))
(defn lwcxw-unseen-input ()
    (lwcxw-x (intern_trivial_string "dana")
             (intern_trivial_string "yellow")
             (intern_trivial_string "night")))
(defn lwcxw-expected-bridge ()
    (lwcxw-y (intern_trivial_string "yellow")
             (intern_trivial_string "dana")
             (intern_trivial_string "night")))
(defn lwcxw-expected-output ()
    (lwcxw-z (intern_trivial_string "dana")
             (intern_trivial_string "yellow")
             (intern_trivial_string "night")))

(defn lwcxw-correspondence-x-a ()
    (lwr-correspondence (lwcxw-x-a) (lwcxw-y-a)))
(defn lwcxw-correspondence-x-b ()
    (lwr-correspondence (lwcxw-x-b) (lwcxw-y-b)))
(defn lwcxw-correspondence-y-a ()
    (lwr-correspondence (lwcxw-y-a) (lwcxw-z-a)))
(defn lwcxw-correspondence-y-b ()
    (lwr-correspondence (lwcxw-y-b) (lwcxw-z-b)))

(defn lwcxw-offer (source payload provenance)
    (lwo-offer source (lwcxw-interface) 1 payload provenance 1))
(defn lwcxw-entry (source payload provenance)
    (lwt-entry (lwcxw-offer source payload provenance) (lwcxw-action)))
(defn lwcxw-yes-response (proposal)
    (lwt-response proposal (oac-one (lwt-proposal-candidate proposal))
                  (lwcxw-response-provenance)))
(defn lwcxw-yes-entry (source provenance proposal)
    (lwcxw-entry source (lwcxw-yes-response proposal) provenance))

(defn lwcxw-base-round ()
    (lwrr-tend (lwo-empty-world)
        (list
            (lwcxw-entry (lwcxw-source-a) (lwcxw-correspondence-x-a)
                         (lwcxw-provenance-a))
            (lwcxw-entry (lwcxw-source-b) (lwcxw-correspondence-x-b)
                         (lwcxw-provenance-b))
            (lwcxw-entry (lwcxw-source-c) (lwcxw-correspondence-y-a)
                         (lwcxw-provenance-c))
            (lwcxw-entry (lwcxw-source-d) (lwcxw-correspondence-y-b)
                         (lwcxw-provenance-d)))
        2 (lwo-none)))

(defn lwcxw-proposal-for-skeleton (items skeleton)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let proposal (head items))
            (let signature
                (lwrr-mapping-signature
                    (lwo-emergent-shape
                        (lwt-proposal-candidate proposal))))
            (if (node_eq (lwrr-signature-source-skeleton signature) skeleton)
                proposal
                (lwcxw-proposal-for-skeleton (tail items) skeleton)))))

(defn lwcxw-first-proposal (round)
    (lwcxw-proposal-for-skeleton
        (lwo-field-items (lwt-round-proposals round))
        (lwrr-skeleton (lwcxw-x-a))))
(defn lwcxw-second-proposal (round)
    (lwcxw-proposal-for-skeleton
        (lwo-field-items (lwt-round-proposals round))
        (lwrr-skeleton (lwcxw-y-a))))

(defn lwcxw-first-yes-round (round proposal)
    (lwt-round-receive round
        (list
            (lwcxw-yes-entry (lwcxw-source-a) (lwcxw-provenance-a) proposal)
            (lwcxw-yes-entry (lwcxw-source-b) (lwcxw-provenance-b) proposal))))
(defn lwcxw-second-yes-round (round proposal)
    (lwt-round-receive round
        (list
            (lwcxw-yes-entry (lwcxw-source-c) (lwcxw-provenance-c) proposal)
            (lwcxw-yes-entry (lwcxw-source-d) (lwcxw-provenance-d) proposal))))
(defn lwcxw-chain-yes-round (round proposal)
    (lwt-round-receive round
        (list
            (lwcxw-yes-entry (lwcxw-source-a) (lwcxw-provenance-a) proposal)
            (lwcxw-yes-entry (lwcxw-source-b) (lwcxw-provenance-b) proposal)
            (lwcxw-yes-entry (lwcxw-source-c) (lwcxw-provenance-c) proposal)
            (lwcxw-yes-entry (lwcxw-source-d) (lwcxw-provenance-d) proposal))))
(defn lwcxw-application-yes-round (round proposal)
    (lwt-round-receive round
        (list
            (lwcxw-yes-entry (lwcxw-source-a) (lwcxw-provenance-a) proposal)
            (lwcxw-yes-entry (lwcxw-source-b) (lwcxw-provenance-b) proposal)
            (lwcxw-yes-entry (lwcxw-source-c) (lwcxw-provenance-c) proposal)
            (lwcxw-yes-entry (lwcxw-source-d) (lwcxw-provenance-d) proposal)
            (lwcxw-yes-entry (lwcxw-source-e) (lwcxw-provenance-e) proposal))))

(defn lwcxw-input-world (world)
    (lwt-receive-stream world
        (list (lwcxw-entry (lwcxw-source-e) (lwcxw-unseen-input)
                           (lwcxw-provenance-e)))))
(defn lwcxw-confirming-experience (signature)
    (lwx-experience signature (lwcxw-unseen-input)
        (lwcxw-expected-bridge) (oac-one (lwcxw-expected-bridge))
        (intern_trivial_string "lwcxw-confirmed-bridge")))

(defn lwcxw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwcxw-sum (tail items)))))
