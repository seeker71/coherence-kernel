; living-world-relation-hypothesis-voice-band.fk -- settled correction speaks locally.
; Verdict 32767 proves fifteen refusal, readiness, optionality, and authority claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-active-index.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/living-world-multilens-plan.fk form-stdlib/living-world-composition-outcome.fk form-stdlib/living-world-composition-voice.fk form-stdlib/living-world-relation-hypothesis.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk form-stdlib/tests/living-world-relational-voice-witness.fk form-stdlib/tests/living-world-multilens-witness.fk form-stdlib/tests/living-world-composition-outcome-witness.fk form-stdlib/tests/living-world-relation-hypothesis-witness.fk form-stdlib/tests/living-world-relation-attestation-witness.fk

(let LWRHV-CAPABILITY (bp "LWRHV-CAPABILITY"))
(let LWRHV-EVIDENCE (bp "LWRHV-EVIDENCE"))

(defn lwrhv-cell (kind) (intern_node kind (empty)))
(defn lwrhv-capability () (lwrhv-cell LWRHV-CAPABILITY))
(defn lwrhv-evidence () (lwrhv-cell LWRHV-EVIDENCE))

(defn lwrhv-grant-entry (source provenance payload)
    (lwrvw-entry-for source provenance
        (lwcp-grant payload (lwrhv-capability) (lwrhv-evidence))))

(defn lwrhv-authorized-world (world first second)
    (lwt-receive-stream world
        (list
            ; The capability is itself an optional offered cell.
            (lwrhw-entry-j (lwrhv-capability))
            ; Exact execution ground.
            (lwrhv-grant-entry (lwrew-source-a) (lwrew-prov-a)
                (lwrvw-basis))
            (lwrhv-grant-entry (lwrew-source-b) (lwrew-prov-b)
                (lwrvw-basis))
            (lwrhv-grant-entry (lwrew-source-a) (lwrew-prov-a)
                (lwrew-recipe))
            (lwrhv-grant-entry (lwrew-source-a) (lwrew-prov-a)
                (lwrew-declaration))
            (lwrhv-grant-entry (lwrew-source-b) (lwrew-prov-b)
                (lwrew-before))
            ; Three learned surface cells and the observations that ground them.
            (lwrhv-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwrvw-left))
            (lwrhv-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwrvw-left))
            (lwrhv-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwrvw-right))
            (lwrhv-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwrvw-right))
            (lwrhv-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwmpw-third))
            (lwrhv-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwmpw-third))
            (lwrhv-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwrvw-forty-observation))
            (lwrhv-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwrvw-forty-observation))
            (lwrhv-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwrvw-nine-observation))
            (lwrhv-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwrvw-nine-observation))
            (lwrhv-grant-entry (lwslw-source-a) (lwslw-prov-a)
                (lwmpw-third-observation))
            (lwrhv-grant-entry (lwslw-source-b) (lwslw-prov-b)
                (lwmpw-third-observation))
            ; Both independently witnessed relation cells and their observations.
            (lwrhv-grant-entry (lwrhw-source-h) (lwrhw-prov-h) first)
            (lwrhv-grant-entry (lwrhw-source-i) (lwrhw-prov-i) first)
            (lwrhv-grant-entry (lwrhw-source-h) (lwrhw-prov-h) second)
            (lwrhv-grant-entry (lwrhw-source-i) (lwrhw-prov-i) second)
            (lwrhv-grant-entry (lwrhw-source-h) (lwrhw-prov-h)
                LWRHA-OBSERVATION-FIRST)
            (lwrhv-grant-entry (lwrhw-source-i) (lwrhw-prov-i)
                LWRHA-OBSERVATION-FIRST)
            (lwrhv-grant-entry (lwrhw-source-h) (lwrhw-prov-h)
                LWRHA-OBSERVATION-SECOND)
            (lwrhv-grant-entry (lwrhw-source-i) (lwrhw-prov-i)
                LWRHA-OBSERVATION-SECOND))))

(defn lwrhv-emit (world first second alternatives unknown)
    (lwrv-emit (lwcp-context world (lwrhv-capability))
        (lwrvw-basis) (lwrvw-referent) (lwrhw-relation-zeta)
        (lwmpw-nodes) alternatives unknown (lwo-none) (lwrhv-evidence)))

(defn lwrhv-proposal (world first second)
    (lwrv-proposal (lwcp-context world (lwrhv-capability))
        (lwrvw-basis) (lwrvw-referent) (lwrhw-relation-zeta)
        (lwmpw-nodes) (lwo-empty-field) (lwo-none) (lwo-none)
        (lwrhv-evidence)))

(do
    (let world LWRHA-WORLD)
    (let index (lwai-index world))
    (let first-proposal
        (lwai-relation-proposal-for
            world index LWRHA-OBSERVATION-FIRST 2))
    (let second-proposal
        (lwai-relation-proposal-for
            world index LWRHA-OBSERVATION-SECOND 2))
    (let first (lwt-proposal-candidate first-proposal))
    (let second (lwt-proposal-candidate second-proposal))
    (let round
        (lwt-round world (lwo-field (list first-proposal second-proposal))
            (lwo-empty-field) (lwrhw-integrated-round)))
    (let yes-round
        (lwt-round-receive round
            (list
                (lwrvw-relation-response
                    (lwrhw-source-h) (lwrhw-prov-h) first-proposal)
                (lwrvw-relation-response
                    (lwrhw-source-i) (lwrhw-prov-i) first-proposal)
                (lwrvw-relation-response
                    (lwrhw-source-h) (lwrhw-prov-h) second-proposal)
                (lwrvw-relation-response
                    (lwrhw-source-i) (lwrhw-prov-i) second-proposal))))
    (let one-round
        (lwai-integrate-relation yes-round first-proposal (lwrew-action)))
    (let two-round
        (lwai-integrate-relation one-round second-proposal (lwrew-action)))
    (let zero-world
        (lwrhv-authorized-world world first second))
    (let one-world
        (lwrhv-authorized-world (lwt-round-world one-round) first second))
    (let two-world
        (lwrhv-authorized-world (lwt-round-world two-round) first second))
    (let zero-utterance
        (lwrhv-emit zero-world first second
            (lwo-empty-field) (lwo-none)))
    (let one-utterance
        (lwrhv-emit one-world first second
            (lwo-empty-field) (lwo-none)))
    (let utterance
        (lwrhv-emit two-world first second
            (lwo-empty-field) (lwo-none)))
    (let context (lwcp-context two-world (lwrhv-capability)))
    (let context-world (lwcp-context-world context))
    (let plan (lwrv-utterance-plan utterance))
    (let plan-items
        (lwrp-sequence-items (lwrp-plan-sequence plan)))
    (let proposal (lwrhv-proposal two-world first second))
    (let participants (lwt-proposal-participants proposal))
    (let offered-alternatives (lwo-field (list (lwrhw-offer))))
    (let offered-unknown (lwlc-unknown (lwrhv-evidence)))
    (let optional-utterance
        (lwrhv-emit two-world first second
            offered-alternatives offered-unknown))

    ; No relation, no voice; one relation, still no voice.
    (let c1 (if (node_eq zero-utterance (lwo-none)) 1 0))
    (let c2 (if (node_eq one-utterance (lwo-none)) 2 0))
    (let c3 (if (eq (lwrv-utterance? utterance) 1) 4 0))
    (let c4 (if (str_eq
                     (lwrv-utterance-surface utterance) "forty!-nine") 8 0))
    (let c5 (if (and (eq (lwrp-ready? (lwrp-plan-status plan)) 1)
                         (eq (len plan-items) 3)) 16 0))
    (let c6 (if (and (node_eq (nth plan-items 0) (lwrvw-left))
                         (and (node_eq (nth plan-items 1) (lwmpw-third))
                              (node_eq (nth plan-items 2)
                                  (lwrvw-right)))) 32 0))
    (let c7 (if (and (eq (lwo-field-size
                              (lwrv-utterance-alternatives utterance)) 0)
                         (and (node_eq
                                  (lwrv-utterance-unknown utterance)
                                  (lwo-none))
                              (node_eq
                                  (lwrv-utterance-choice utterance)
                                  (lwo-none)))) 64 0))
    (let c8 (if (and (eq (lwo-field-size
                              (lwrv-utterance-alternatives
                                  optional-utterance)) 1)
                         (node_eq
                             (lwrv-utterance-unknown optional-utterance)
                             offered-unknown)) 128 0))
    (let c9 (if (eq (lwo-field-size
                         (lwrv-utterance-witnesses utterance)) 13) 256 0))
    (let c10 (if (eq (lwo-field-size participants) 7) 512 0))
    (let c11 (if (and (eq (lwo-field-has? participants
                                (lwrhw-source-h)) 1)
                          (and (eq (lwo-field-has? participants
                                      (lwrhw-source-i)) 1)
                               (eq (lwo-field-has? participants
                                      (lwrhw-source-j)) 1))) 1024 0))
    (let c12 (if (eq (lwo-field-has? participants
                          (lwcow-source-g)) 0) 2048 0))
    (let c13 (if (and (eq (lwo-active? context-world
                               (lwrhw-correction)) 0)
                          (eq (lwo-active? context-world
                               (lwrhw-candidate)) 0)) 4096 0))
    (let c14 (if (and (eq (lwrv-utterance-current?
                               two-world utterance) 1)
                          (eq (lwrv-proposal-current?
                               two-world proposal) 1)) 8192 0))
    (let c15 (if (and (eq (lwo-field-size
                               (lwrp-group-edges
                                 (lwrp-plan-group plan))) 2)
                          (node_eq (lwrv-utterance-path utterance)
                              (lwo-local-path))) 16384 0))
    (lwrhw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
