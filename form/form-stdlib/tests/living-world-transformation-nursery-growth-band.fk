; living-world-transformation-nursery-growth-band.fk -- recurrence may mature.
; Verdict 32767 proves fifteen independent evidence and non-promotion claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk

(do
    (let fixture (lwtnw-build-target))
    (let target (lwtnw-target fixture))
    (let trial-fixture (lwtnw-exact-trial fixture))
    (let trial (lwtnw-trial-candidate trial-fixture))
    (let trial-world
        (lwt-round-world (lwtnw-trial-round trial-fixture)))
    (let confirmation (lwtnw-confirmation trial))
    (let silence (lwtnw-silence trial))
    (let correction (lwtnw-correction trial))
    (let observed-world (lwtnw-observed-world trial-fixture))
    (let set (lwtn-evidence-for observed-world trial))
    (let growth (lwtn-growth-for observed-world trial 2))
    (let proposal (lwtn-growth-proposal observed-world trial 2))
    (let candidate (lwt-proposal-candidate proposal))
    (let waiting-round
        (lwt-round observed-world (lwo-field (list proposal))
            (lwo-empty-field) (lwtnw-trial-round trial-fixture)))
    (let waiting
        (lwtn-growth-integrate waiting-round proposal (lwigw-action)))
    (let integrated (lwtnw-integrated-growth fixture))
    (let integrated-world
        (lwt-round-world (lwtnw-growth-round integrated)))
    (let integrated-candidate (lwtnw-growth-candidate integrated))
    (let integrated-growth (lwtnw-growth-shape integrated))
    (let successor
        (lwtn-successor-offer integrated-world integrated-candidate))
    (let one-observer-world
        (lwt-receive-stream trial-world
            (list
                (lwtnw-entry-v confirmation)
                (lwtnw-entry-y confirmation))))
    (let one-observer-growth
        (lwtn-growth-for one-observer-world trial 2))
    (let reoffered-world
        (lwt-receive-stream integrated-world
            (list
                (lwtnw-entry-y successor)
                (lwtnw-entry-z successor))))
    (let action-field (lwac-field-for reoffered-world target 2))
    (let action-proposal
        (lwac-selection-proposal reoffered-world target 2))
    (let corrected-world (lwtnw-corrected-world integrated))
    (let corrected-growth
        (lwtn-growth-for corrected-world
            (lwtn-growth-trial integrated-growth) 2))
    (let revoked-observation
        (lwo-revocation (lwtnw-growth-observation integrated)
            (lwtnw-source-y) (lwtnw-reason) (lwtnw-prov-y)))
    (let revoked-world
        (lwt-receive-stream integrated-world
            (list (lwtnw-entry-y revoked-observation))))
    (let revoked-set (lwtn-evidence-for revoked-world trial))
    (let revoked-growth (lwtn-growth-for revoked-world trial 2))

    (let c1
        (if (and (eq (lwtn-observation-valid? confirmation) 1)
                 (and (eq (lwtn-observation-valid? silence) 1)
                      (eq (lwtn-observation-valid? correction) 1))) 1 0))
    (let c2
        (if (and (eq (lwo-field-size
                         (lwtn-independent-attributions
                            observed-world confirmation)) 2)
                 (eq (lwo-active-by?
                         observed-world confirmation
                         (lwtnw-source-v)) 1)) 2 0))
    (let c3
        (if (and (eq (lwtn-confirmation-count set) 2)
                 (and (eq (lwtn-evidence-count
                              (lwtn-evidence-silences set)) 1)
                      (eq (lwtn-contention-count set) 0))) 4 0))
    (let c4
        (if (eq (lwtn-ready? (lwtn-growth-status growth)) 1) 8 0))
    (let c5
        (if (and (eq (lwo-field-size
                         (lwtn-growth-alternative-field growth)) 3)
                 (eq (lwo-field-size
                         (lwtn-growth-unknown-field growth)) 1)) 16 0))
    (let c6
        (if (and (eq (lwo-field-size
                         (lwt-proposal-participants proposal)) 12)
                 (eq (lwtn-growth-proposal-current?
                         observed-world proposal) 1)) 32 0))
    (let c7
        (if (and (eq (lwtn-open?
                         (lwtn-growth-status one-observer-growth)) 1)
                 (node_eq
                    (lwtn-growth-proposal one-observer-world trial 2)
                    (lwo-none))) 64 0))
    (let c8
        (if (eq (lwo-active?
                    (lwt-round-world waiting) candidate) 0) 128 0))
    (let c9
        (if (eq (lwtn-growth-integrated-current?
                    integrated-world integrated-candidate) 1) 256 0))
    (let c10
        (if (and (eq (lwac-offer-valid? successor) 1)
                 (and (node_eq (lwac-offer-focus successor) target)
                      (node_eq (lwac-offer-action successor)
                               (lwtnw-recipe-e)))) 512 0))
    (let c11
        (if (and (node_eq
                    (lwac-delta-before (lwac-offer-prediction successor))
                    (intern_trivial_int 1))
                 (and (node_eq
                          (lwac-delta-after
                            (lwac-offer-prediction successor))
                          (intern_trivial_int 4))
                      (and (eq (lwo-field-size
                                   (lwac-offer-alternatives successor)) 3)
                           (eq (lwlc-unknown?
                                   (lwac-offer-unknown successor)) 1))))
            1024 0))
    (let c12
        (if (and (eq (lwo-active? integrated-world successor) 0)
                 (eq (lwac-ready? (lwac-field-status action-field)) 1))
            2048 0))
    (let c13
        (if (and (not (node_eq action-proposal (lwo-none)))
                 (eq (lwo-field-size
                         (lwt-proposal-participants action-proposal)) 9))
            4096 0))
    (let c14
        (if (and (eq (lwtn-open?
                         (lwtn-growth-status corrected-growth)) 1)
                 (and (eq (lwtn-growth-integrated-current?
                              corrected-world integrated-candidate) 0)
                      (and (node_eq
                              (lwtn-growth-proposal corrected-world
                                  (lwtn-growth-trial integrated-growth) 2)
                              (lwo-none))
                           (node_eq
                              (lwtn-successor-offer
                                  corrected-world integrated-candidate)
                              (lwo-none))))) 8192 0))
    (let c15
        (if (and (eq (lwtn-confirmation-count revoked-set) 1)
                 (and (eq (lwtn-open?
                              (lwtn-growth-status revoked-growth)) 1)
                      (eq (lwtn-growth-integrated-current?
                              revoked-world integrated-candidate) 0)))
            16384 0))
    (lwtnw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
