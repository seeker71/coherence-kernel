; frq-d693d86c154bc71d-band.bml — a publish marker that does not parse is cleared by the heal (form-cli-code-circle.bml, fccc-heal).
;
; A publish begins only after its marker reads back as written (fccc-refused waits on fccc-marked?), so a marker that does not parse
; is a publish that never began: its paths were never touched, and fccc-heal removes it and counts it cleared. host_path_remove answers
; 0 when it removed a path; the heal reads that answer, never its truth value (a marker that could not be removed is a named
; heal-conflict). Real files in a fresh directory, read on disk after the heal.
;
; Expected: 15
; Verdict 15 when every claim lands:
;   1   a marker of text that is not JSON is removed from disk and counted as cleared
;   2   an empty marker is removed and counted as cleared
;   4   a marker that cannot be removed (a directory under a marker's name, holding a file) stays and is named a heal-conflict
;   8   a file that is not a publish marker is neither read nor touched
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/form-cli-code-memory.bml form-stdlib/bml/form-cli-code-circle.bml
section [form.bml] {
 class FrqD693Band {
  def fdb-root() = temp_dir() ++ "/frq-d693-band-" ++ host_pid().str();
  def fdb-fresh(name) {
   let dir = fdb-root() ++ "/" ++ name;
   let z0 = fs_rmdir(dir);
   let z1 = fs_mkdir(fdb-root());
   let z2 = fs_mkdir(dir);
   dir;
  }
  def fdb-has(xs, s) = any?(x => str_find(x, s, 0) >= 0, xs);
  def fdb-c-garbled(ctx) {
   let dir = fdb-fresh("garbled");
   let w = write_file(dir ++ "/publish-1.marker", "not-valid-json{{{");
   let r = fccc-heal(dir);
   r[0] == 1 && nil?(r[1]) && !fs-exists?(dir ++ "/publish-1.marker");
  }
  def fdb-c-empty(ctx) {
   let dir = fdb-fresh("empty");
   let w = write_file(dir ++ "/publish-2.marker", "");
   let r = fccc-heal(dir);
   r[0] == 1 && nil?(r[1]) && !fs-exists?(dir ++ "/publish-2.marker");
  }
  def fdb-c-held(ctx) {
   let dir = fdb-fresh("held");
   let m = fs_mkdir(dir ++ "/publish-3.marker");
   let w = write_file(dir ++ "/publish-3.marker/inside.txt", "kept");
   let r = fccc-heal(dir);
   r[0] == 0 && len(r[1]) == 1 && fdb-has(r[1], "heal-conflict:") && fdb-has(r[1], "publish-3.marker") && fs-exists?(dir ++ "/publish-3.marker/inside.txt");
  }
  def fdb-c-other(ctx) {
   let dir = fdb-fresh("other");
   let w = write_file(dir ++ "/notes.txt", "not-valid-json{{{");
   let r = fccc-heal(dir);
   r[0] == 0 && nil?(r[1]) && (String) (read_file(dir ++ "/notes.txt") ?? "") == "not-valid-json{{{";
  }
 }
 let verdict = live-claims("frq-d693d86c154bc71d-band", 0, [["garbled", 1, 1, fdb-c-garbled], ["empty", 2, 1, fdb-c-empty], ["held", 4, 1, fdb-c-held], ["other", 8, 1, fdb-c-other]]);
 let gone = fs_rmdir(fdb-root());
 verdict;
}
