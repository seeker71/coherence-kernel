; tests/q4k-halfdecode-band.fk — is the hardware half load EQUAL to the body's f16 transcription,
; on real Q4_K bytes?
;
; PROOF LEVEL: FOURTH-ARM ONLY (a live Metal device behind the handle door). This band exists
; because qsl-q4k-slot4c-msl reads d/dmin as `device const half*` where the law had been fd-value
; transcription (q4k-msl.fk:31). IEEE f16->f32 conversion is exact for every finite f16 and
; q4k_f16 transcribes exactly that map, so the two must agree BIT FOR BIT — an equality, not an
; epsilon — on every superblock whose d/dmin are finite, which real GGUF scale headers are. The
; probe kernel computes BOTH decodes on the GPU side by side and this band compares the four
; bytes of each answer, superblock by superblock, over the first 64 superblocks of the real
; blk.0.attn_q.weight of the pinned llama3.2:3b blob.
;
; PREREGISTERED 2026-08-18, predicted verdict 15 = 1+2+4+8:
;   bit 1  THE DOOR IS REAL      metal_status: linked, handle door.
;   bit 2  THE PROBE COMPILED    its pipeline answers a nonzero handle.
;   bit 4  THE DISPATCH WAS ACCEPTED  metal_enqueue answers 1 — a refusal cannot certify.
;   bit 8  THE EQUALITY HOLDS    all 64 superblocks: hardware d == transcribed d and
;                                hardware dmin == transcribed dmin, compared as raw f32 bytes.
;
; preludes: native/metal/llama-token-slot.fk

(do
    (defn qhb-blob () "/Users/ursmuff/.ollama/models/blobs/sha256-dde5aa3fc5ffc17176b5e8bdc82f587b24b2678c6c66101bf7da77af9f7ccdff")
    (defn qhb-nsb () 64)

    ; four bytes of readback word i equal four bytes of readback word j?
    (defn qhb-word-eq (s i j)
        (if (eq (str_byte_at s (mul i 4)) (str_byte_at s (mul j 4)))
            (if (eq (str_byte_at s (add (mul i 4) 1)) (str_byte_at s (add (mul j 4) 1)))
                (if (eq (str_byte_at s (add (mul i 4) 2)) (str_byte_at s (add (mul j 4) 2)))
                    (eq (str_byte_at s (add (mul i 4) 3)) (str_byte_at s (add (mul j 4) 3)))
                    false)
                false)
            false))
    (defn qhb-all-eq (s sb n)
        (if (ge sb n) true
            (if (qhb-word-eq s (mul sb 4) (add (mul sb 4) 1))
                (if (qhb-word-eq s (add (mul sb 4) 2) (add (mul sb 4) 3))
                    (qhb-all-eq s (add sb 1) n)
                    false)
                false)))

    (let live (md-door-live?))

    (let src (lth-src (qhb-blob)))
    (let base (egg-data-base src (wtr-alignment)))
    (let tv (lth-tv src base (qhb-blob) "blk.0.attn_q.weight"))

    (let msl (str_concat (qml-msl-header)
             (str_concat (q4m-msl-unit "qhb_dq_unused" "qhb_mv_unused")
                         (qsl-halfdecode-msl "form_q4k_halfdecode_probe"))))
    (let pipe (metal_pipeline msl "form_q4k_halfdecode_probe"))
    (let outb (metal_buf_alloc (mul (qhb-nsb) 16)))
    (let sd (metal_enqueue pipe
                (md-bind16 (list (lth-tv-h tv) outb) (list (qhb-nsb)) 64 0 0 0)
                (qhb-nsb)))
    (let s (metal_buf_read outb 0 (mul (qhb-nsb) 16)))
    (let equal (qhb-all-eq s 0 (qhb-nsb)))

    (add (if live 1 0)
    (add (if live (if (gt pipe 0) 2 0) 0)
    (add (if live (if (eq sd 1) 4 0) 0)
         (if live (if equal 8 0) 0)))))
