; living-world-continuity-durable-band.fk -- append-new verified persistence.
; Verdict 32767 proves fifteen carrier, identity, optionality, and cleanup bits.
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/tests/living-world-continuity-durable-witness.fk

(do
    (lwcdw-clean)
    (let image (lwcdw-image))
    (let saved
        (lwcd-save-new-with-options (lwcdw-path) image (lwcdw-evidence)
            (lwcdw-alternative) (lwcdw-unknown)))
    (let first-text (fs-read-text (lwcdw-path)))
    (let repeated
        (lwcd-save-new (lwcdw-path) image (lwcdw-evidence)))
    (let after-repeat (fs-read-text (lwcdw-path)))
    (let loaded
        (lwcd-load-with-options (lwcdw-path) (lwcdw-evidence)
            (lwcdw-alternative) (lwcdw-unknown)))
    (let loaded-image (lwcd-result-image loaded))
    (let loaded-world (lwcn-image-world loaded-image))
    (let absent
        (lwcd-load "/tmp/coherence-living-world-continuity-absent.ccs"
                   (lwo-none)))
    (let score
        (lwcdw-sum
            (list
                (if (eq (lwcd-saved? saved) 1) 1 0)
                (if (eq (fs-exists? (lwcdw-path)) 1) 2 0)
                (if (eq (fs-exists?
                            (lwcd-pending-path (lwcdw-path))) 0) 4 0)
                (if (node_eq (lwcd-result-image saved) image) 8 0)
                (if (node_eq (lwcd-result-alternatives saved)
                             (lwcdw-alternative)) 16 0)
                (if (node_eq (lwcd-result-unknowable saved)
                             (lwcdw-unknown)) 32 0)
                (if (eq (lwcd-refused? repeated) 1) 64 0)
                (if (str_eq first-text after-repeat) 128 0)
                (if (eq (lwcd-loaded? loaded) 1) 256 0)
                (if (node_eq loaded-image image) 512 0)
                (if (eq (lwcn-image-valid? loaded-image) 1) 1024 0)
                (if (eq (lwo-active? loaded-world (lwcdw-payload)) 1)
                    2048 0)
                (if (node_eq (lwcd-result-evidence loaded)
                             (lwcdw-evidence)) 4096 0)
                (if (eq (lwcd-absent? absent) 1) 8192 0)
                (if (node_eq (lwcd-result-image absent) (lwo-none))
                    16384 0))))
    (lwcdw-clean)
    score)
