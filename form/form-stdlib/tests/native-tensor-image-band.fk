; Resident commands execute again, share their buffers, and refuse after close.
; Verdict 127. The output is overwritten before replay to detect stale answers.
; preludes: form-stdlib/native-tensor.bml
(do
 (defn ntib-bit (ok bit) (if ok bit 0))
 (let before (metal_live))
 (let image (nt-image-open "100000 iota sum i32"))
 (let s (nt-image-state image))
 (let changed (metal_buf_write (nt-h (head (nt-stack s))) 0 (md-le32 999)))
 (let replay (nt-image-replay image))
 (let retained (metal_live))
 (let shut (nt-image-close image))
 (let after (metal_live))
 (let closed (nt-image-replay image))
 (sum (list
  (ntib-bit (nt-check-result (nt-image-result image) 704982704) 1)
  (ntib-bit (and (eq changed 4) (nt-check-result replay 704982704)) 2)
  (ntib-bit (eq (nth (nt-before replay) 3) (nth (nt-after replay) 3)) 4)
  (ntib-bit (eq (nth (nt-before replay) 2) (nth (nt-after replay) 2)) 8)
  (ntib-bit (gt (sub (nth (nt-after replay) 7) (nth (nt-before replay) 7)) 0) 16)
  (ntib-bit (and (gt (nth retained 2) (nth before 2)) (eq (nth before 2) (nth after 2))) 32)
  (ntib-bit (nt-refused-result closed "tensor image is closed") 64))))
