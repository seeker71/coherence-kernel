; form-glass-meaning-ui-band.fk — live symbol and code-to-meaning sampling.
;
; PURE: reads the tree, writes nothing.  Every bit stands on a real grammar,
; a real source file of that language in this tree, and the reviewed category
; table — never on a fixture.  The NodeID bit compares the glass's answer with
; form-ontology-bp.fk, the reviewed authority, so a drifted mirror cannot pass.
;
; Expected: 8191
; preludes: form-stdlib/form-glass-meaning-ui.bml

(do
    (defn gmb-bit (ok bit) (if ok bit 0))
    (defn gmb-has? (text needle) (if (ge (str_find text needle 0) 0) 1 0))
    (let langs (fglm-langs))
    (let py (nth langs 1))

    ; the roster is the four dialects that carry BMF categories
    (let b1 (gmb-bit (and (eq (len langs) 4)
        (and (str_eq (fglm-key (nth langs 0)) "go")
        (and (str_eq (fglm-key py) "py")
        (and (str_eq (fglm-key (nth langs 2)) "rs")
             (str_eq (fglm-key (nth langs 3)) "ts"))))) 1))

    ; zero to four selected, and each size answers its own count
    (let b2 (gmb-bit (and (eq (fglm-selected-count "none") 0)
                          (eq (len (fglm-lines "none" 3 100)) 3)) 2))
    (let b3 (gmb-bit (eq (fglm-selected-count "go") 1) 4))
    (let b4 (gmb-bit (eq (fglm-selected-count "go+ts") 2) 8))
    (let b5 (gmb-bit (eq (fglm-selected-count "py+rs+ts") 3) 16))
    (let b6 (gmb-bit (eq (fglm-selected-count "all") 4) 32))

    ; the toggle both removes and adds, and never leaves a fifth key standing
    (let b7 (gmb-bit (and (str_eq (fglm-toggle "all" "py") "go+rs+ts")
                          (str_eq (fglm-toggle "go" "go") "none")) 64))
    (let b8 (gmb-bit (and (str_eq (fglm-toggle "none" "ts") "ts")
                          (str_eq (fglm-toggle "go+ts" "py") "go+py+ts")) 128))

    ; the symbol side is a real rule line of the real grammar
    (let rule (fglm-rule-sample py 7))
    (let b9 (gmb-bit (and (eq (gmb-has? rule "::=") 1) (gt (str_len rule) 12)) 256))

    ; the meaning side is a category the grammar's own emitter interns
    (let cat (fglm-category-sample py 7))
    (let b10 (gmb-bit (eq (gmb-has? cat "PY-BMF-") 1) 512))

    ; the NodeID the glass shows equals the reviewed authority's row
    (let authority (read_file "form/form-stdlib/form-ontology-bp.fk"))
    (let b11 (gmb-bit (and (eq (fglm-inst-of "PY-BMF-IMPORT") 501)
        (and (eq (gmb-has? authority "\"PY-BMF-IMPORT\" 1 2 99 501") 1)
             (str_eq (fglm-nodeid-text "PY-BMF-IMPORT") "@1.2.99.501"))) 1024))

    ; a category with no row says so by name; it never invents a coordinate
    (let b12 (gmb-bit (and (str_eq (fglm-nodeid-text "PY-BMF-NO-SUCH-ROW") "no-row")
                           (eq (fglm-inst-of "PY-BMF-NO-SUCH-ROW") -1)) 2048))

    ; the body grows exactly two rows per selected dialect
    (let b13 (gmb-bit (and (eq (len (fglm-lines "go" 5 100)) 4)
        (and (eq (len (fglm-lines "go+ts" 5 100)) 6)
             (eq (len (fglm-lines "all" 5 100)) 10))) 4096))

    (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 (add b9 (add b10 (add b11 (add b12 b13))))))))))))
)
