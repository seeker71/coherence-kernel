; Pure natural-language transcript projection. Fixtures never reach a live gift.
; witnessed: 2026-09-07 -> 8191
; preludes: form/form-stdlib/form-glass-meaning-ui.bml form/form-stdlib/ear-axes.bml
(do
  (defn gmb-bit (name ok weight) (if ok weight (do (print name) 0)))
  (defn gmb-text (lines) (if (eq (len lines) 0) "" (str_concat (ftc-segment-text (head (head lines))) (gmb-text (tail lines)))))
  (defn gmb-has (lines text) (ge (str_find (gmb-text lines) text 0) 0))
  (defn gmb-fit (lines width) (if (eq (len lines) 0) 1 (and (le (str_len (ftc-segment-text (head (head lines)))) width) (gmb-fit (tail lines) width))))
  (let heard "\nkind=heard\nt=1000\nlang=en\nheard=The door is open.\n")
  (let said "\nkind=said\nt=1300\ntend=900\nlang=en\nheard=The door is open.\ntongues=en pt fa\nt_en=The door is open.\nt_pt=A porta está aberta.\nt_fa=در باز است\n")
  (let rows (ea-transcript-rows "" heard said ""))
  (let pt (fglm-lines rows "pt" 1400 100))
  (let en (fglm-lines rows "en" 1400 100))
  (let both (fglm-lines rows "en+pt" 1400 100))
  (let none (fglm-lines rows "none" 1400 100))
  (let missing (fglm-lines rows "de" 1400 100))
  (let dark (fglm-lines (ea-asleep-rows) "all" 1400 100))
  (let utf (fglm-wrap "در باز است" 5 "fixture" "declared" 9))
  (let source (read_file "form/form-stdlib/form-glass-meaning-ui.bml"))
  (print (sum (list
    (gmb-bit "natural language catalog" (and (eq (len (tln-rows)) 32) (and (str_eq (tln-name "en") "English") (eq (tln-known? "py") 0))) 1)
    (gmb-bit "selection input" (and (tln-valid-selection? "en+de+fa") (and (eq (tln-valid-selection? "en+py") 0) (eq (tln-valid-selection? "en++de") 0))) 2)
    (gmb-bit "exact membership" (and (tln-selected? "en+de" "de") (eq (tln-selected? "french" "en") 0)) 4)
    (gmb-bit "natural defaults" (str_eq (tln-join (tln-keys (tln-defaults))) "en+pt+fa+id") 8)
    (gmb-bit "toggle" (and (str_eq (fglm-toggle "en" "pt") "en+pt") (and (str_eq (fglm-toggle "en" "en") "none") (str_eq (fglm-toggle "all" "de") "de"))) 16)
    (gmb-bit "empty selection" (and (gmb-has none "No transcript languages") (eq (gmb-has none "The door is open.") 0)) 32)
    (gmb-bit "sleep is not speech" (and (gmb-has dark "No live transcript") (gmb-has dark "asleep")) 64)
    (gmb-bit "producer projects originals and translations" (and (eq (len rows) 3) (and (str_eq (etr-kind (head rows)) "original-closed") (str_eq (etr-kind (nth rows 1)) "translation-closed"))) 128)
    (gmb-bit "selection filters actual text" (and (gmb-has pt "A porta está aberta.") (and (eq (gmb-has pt "The door is open.") 0) (and (gmb-has en "The door is open.") (eq (gmb-has en "A porta") 0)))) 256)
    (gmb-bit "multiple and missing" (and (and (gmb-has both "The door is open.") (gmb-has both "A porta")) (and (gmb-has missing "no transcript/translation published") (eq (gmb-has missing "The door is open.") 0))) 512)
    (gmb-bit "source stamp and evidence" (and (gmb-has pt "translation-closed @900") (gmb-has (fglm-lines (fgo-rows-with-truth rows "silent" "stale") "en" 1400 100) "silent")) 1024)
    (gmb-bit "unicode wrap and terminal controls" (and (str_eq (gmb-text utf) "در باز است") (and (gmb-fit utf 5) (str_eq (fglm-clean (str_concat "a" (str_concat (byte_to_str 27) "b")) 0 "") "a b"))) 2048)
    (gmb-bit "no source sampling runtime" (and (lt (str_find source "read_file(" 0) 0) (and (lt (str_find source "fs_list(" 0) 0) (and (lt (str_find source "host-exec(" 0) 0) (lt (str_find source "dialect-categories" 0) 0)))) 4096)
  )))
)
