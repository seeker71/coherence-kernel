; form-knowledge-public-family-mastery-band.fk -- adversarial pure convergence.
;
; Every live-looking row below is synthetic executable fixture data. The band
; calls no model or carrier and creates no public mastery credit. It proves that
; raw bytes, structured receipts, family execution semantics and native request
; identity cannot be relabeled across the fifteen-family denominator.
;
; Expected: 1073741823 (30 bits).
; preludes: form-stdlib/form-knowledge-public-family-mastery.fk
; PROOF BAND (fkwu): 1073741823

(do
    (defn fkpfmb-bit (ok bit) (if ok bit 0))
    (defn fkpfmb-model-id () "synthetic-local-model")
    (defn fkpfmb-run-id ()
        (nmfe-sha256 "synthetic-public-family-mastery-run"))
    (defn fkpfmb-raw-prefix ()
        "choice-task=knowledge\nchoice-match=1\nbackend=form-native-metal-jit\ntext:\n")
    (defn fkpfmb-raw-query-answer (answer)
        (str_concat (fkpfmb-raw-prefix)
            (str_concat (fkqt-open)
            (str_concat "look up the heldout fact"
            (str_concat (fkqt-close) answer)))))
    (defn fkpfmb-heldout-raw-for (family)
        (do
            (let row (fkpfm-heldout-row-for-family family (fkhe-rows)))
            (fkpfmb-raw-query-answer (fkhe-expected row))))
    (defn fkpfmb-perfect-score (row)
        (fkhe-score row (fqt-knowledge-prompt (fkhe-prompt row))
            (fkhe-parse-resident-output
                (fkpfmb-raw-query-answer (fkhe-expected row))) 1))
    (defn fkpfmb-perfect-scores (rows)
        (if (eq (len rows) 0) (list)
            (cons (fkpfmb-perfect-score (head rows))
                  (fkpfmb-perfect-scores (tail rows)))))
    (defn fkpfmb-live-heldout-report ()
        (fkhe-report (fkhe-live-scope) (fkpfmb-model-id) 1 1
            (fkpfmb-perfect-scores (fkhe-rows))))

    (defn fkpfmb-bml (family)
        (str_concat "int Lift(int n) { return n + "
            (str_concat (int_to_str (fkpfm-family-ordinal family))
                "; }\nreturn Lift(65);")))
    (defn fkpfmb-bmf ()
        "grammar {\n  rule atmark { lit @ }\n  rule vowel { class ae }\n  rule markedvowel { seq atmark vowel }\n  rule entrance { alt vowel markedvowel }\n  top entrance\n  probe @a\n}")
    (defn fkpfmb-form (family)
        (do
            (let c (fkpfm-family-exec-challenge family))
            (fgsg-control-canonical
                (fgsg-cat (list "<|form:recipe-exec|>"
                    (frex-node-coordinate (frex-recipe))
                    ";input=" (int_to_str (fgsg-challenge-input c))
                    ";carrier=auto<|/form:recipe-exec|>"))
                "nothing,timeout,zero" "one"
                (int_to_str (fgsg-challenge-checkpoint c))
                (int_to_str (fgsg-challenge-timeout-budget c))
                (fgsg-challenge-plane c)
                (int_to_str (fgsg-challenge-heat c))
                (int_to_str (fgsg-challenge-pure c)))))
    (defn fkpfmb-candidate (family)
        (fgsg-candidate (fkpfmb-bml family) (fkpfmb-bmf)
            (fkpfmb-form family)))
    (defn fkpfmb-candidate-output (candidate)
        (fgsg-cat (list "<BML>" (fgsg-candidate-bml candidate) "</BML>"
            "<BMF>" (fgsg-candidate-bmf candidate) "</BMF>"
            "<FORM>" (fgsg-candidate-form candidate) "</FORM>")))

    (defn fkpfmb-request-for (family)
        (frex-parse (frex-surface (frex-recipe)
            (fkpfm-family-native-input family) "metal")))
    (defn fkpfmb-result-for (family)
        (do
            (let request (fkpfmb-request-for family))
            (let input (fkpfm-family-native-input family))
            (let value (add (mul 3 input) 7))
            (let base (frex-choice request
                (list (frex-offer "metal" "value" value "fixture-native"))))
            (frex-result-with-flags "value" (frex-result-reason base)
                request "metal" value 1 (frex-result-trace base)
                (frex-result-attempts base) 1 0 1)))
    (defn fkpfmb-generic-result (value present)
        (do
            (let request (frex-parse
                (frex-surface (frex-recipe) 0 "metal")))
            (let base (frex-choice request
                (list (frex-offer "metal" "value" value "fixture-signal"))))
            (frex-result-with-flags "value" (frex-result-reason base)
                request "metal" value present (frex-result-trace base)
                (frex-result-attempts base) 1 0 1)))

    (defn fkpfmb-tamper-heldout-report (report)
        (list (nth report 0) (nth report 1) (nth report 2)
              "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
              (nth report 4) (nth report 5) (nth report 6) (nth report 7)
              (nth report 8) (nth report 9) (nth report 10) (nth report 11)
              (nth report 12)))
    (defn fkpfmb-tamper-receipt-sha (r)
        (append (list (nth r 0) (nth r 1) (nth r 2) (nth r 3) (nth r 4)
            (nth r 5) (nth r 6) (nth r 7) (nth r 8) (nth r 9) (nth r 10)
            (nth r 11) (nth r 12) (nth r 13) (nth r 14) (nth r 15)
            (nth r 16) (nth r 17) (nth r 18))
            (list "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")))
    (defn fkpfmb-tamper-gen-output-sha (e)
        (list (nth e 0) (nth e 1) (nth e 2) (nth e 3) (nth e 4)
            "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
            (nth e 6) (nth e 7) (nth e 8) (nth e 9) (nth e 10)
            (nth e 11) (nth e 12) (nth e 13) (nth e 14) (nth e 15)))
    (defn fkpfmb-tamper-gen-raw (e)
        (list (nth e 0) (nth e 1) (nth e 2) (nth e 3) (nth e 4)
            (nth e 5) (nth e 6) (nth e 7) (nth e 8) (nth e 9) (nth e 10)
            (nth e 11) (nth e 12) (nth e 13) "different raw output"
            (nth e 15)))
    (defn fkpfmb-tamper-gen-run (e)
        (list (nth e 0) (nth e 1) (nth e 2) (nth e 3) (nth e 4)
            (nth e 5) (nth e 6) (nth e 7) (nth e 8) (nth e 9) (nth e 10)
            (nth e 11) (nth e 12) (nth e 13) (nth e 14)
            "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"))
    (defn fkpfmb-tamper-exec-result-sha (e)
        (list (nth e 0) (nth e 1) (nth e 2) (nth e 3) (nth e 4)
            "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
            (nth e 6) (nth e 7) (nth e 8) (nth e 9) (nth e 10)
            (nth e 11) (nth e 12) (nth e 13) (nth e 14)))

    (defn form-knowledge-public-family-mastery-band ()
        (do
            (let families (fkpfm-family-ids))
            (let first-family (head families))
            (let second-family (nth families 1))
            (let heldout-report (fkpfmb-live-heldout-report))
            (let heldout-raw (fkpfmb-heldout-raw-for first-family))
            (let heldout-receipt (fkpfm-heldout-receipt first-family
                (fkpfmb-model-id) (fkpfmb-run-id) heldout-raw heldout-report))
            (let heldout-one (fkpfm-heldout-evidence first-family
                heldout-receipt heldout-report))

            (let candidate-one (fkpfmb-candidate first-family))
            (let raw-one (fkpfmb-candidate-output candidate-one))
            (let gen-receipt-one (fkpfm-generative-receipt first-family
                (fkpfmb-model-id) (fkpfmb-run-id) raw-one candidate-one))
            (let gen-one (fkpfm-generative-evidence first-family
                (fkpfmb-model-id) gen-receipt-one raw-one candidate-one 1 0 1))
            (let candidate-two (fkpfmb-candidate second-family))
            (let raw-two (fkpfmb-candidate-output candidate-two))
            (let gen-receipt-two (fkpfm-generative-receipt second-family
                (fkpfmb-model-id) (fkpfmb-run-id) raw-two candidate-two))
            (let gen-two (fkpfm-generative-evidence second-family
                (fkpfmb-model-id) gen-receipt-two raw-two candidate-two 1 0 1))

            (let result-one (fkpfmb-result-for first-family))
            (let request-one (fkpfm-native-request-bytes first-family result-one))
            (let exec-receipt-one (fkpfm-execution-receipt first-family
                (fkpfmb-model-id) (fkpfmb-run-id) request-one result-one))
            (let exec-one (fkpfm-execution-evidence first-family
                (fkpfmb-model-id) exec-receipt-one request-one 1 0 1 result-one))
            (let result-two (fkpfmb-result-for second-family))
            (let request-two (fkpfm-native-request-bytes second-family result-two))
            (let exec-receipt-two (fkpfm-execution-receipt second-family
                (fkpfmb-model-id) (fkpfmb-run-id) request-two result-two))
            (let exec-two (fkpfm-execution-evidence second-family
                (fkpfmb-model-id) exec-receipt-two request-two 1 0 1 result-two))

            (let replay-gen-receipt (fkpfm-generative-receipt second-family
                (fkpfmb-model-id) (fkpfmb-run-id) raw-one candidate-one))
            (let replay-gen (fkpfm-generative-evidence second-family
                (fkpfmb-model-id) replay-gen-receipt raw-one candidate-one 1 0 1))
            (let replay-exec-receipt (fkpfm-receipt "execution" second-family
                (fkpfmb-model-id) (fkpfmb-run-id) request-one
                (frex-render result-one) 1 0 1 1 1))
            (let replay-exec (fkpfm-execution-evidence second-family
                (fkpfmb-model-id) replay-exec-receipt request-one 1 0 1
                result-one))

            (let wrong-heldout-receipt (fkpfmb-tamper-receipt-sha
                heldout-receipt))
            (let wrong-heldout (fkpfm-heldout-evidence first-family
                wrong-heldout-receipt heldout-report))
            (let wrong-heldout-raw-receipt (fkpfm-heldout-receipt first-family
                (fkpfmb-model-id) (fkpfmb-run-id) "wrong raw output"
                heldout-report))
            (let wrong-heldout-raw (fkpfm-heldout-evidence first-family
                wrong-heldout-raw-receipt heldout-report))
            (let wrong-report (fkpfm-heldout-evidence first-family
                heldout-receipt (fkpfmb-tamper-heldout-report heldout-report)))
            (let wrong-gen-digest (fkpfmb-tamper-gen-output-sha gen-one))
            (let wrong-gen-raw (fkpfmb-tamper-gen-raw gen-one))
            (let wrong-gen-run (fkpfmb-tamper-gen-run gen-one))
            (let wrong-result-digest
                (fkpfmb-tamper-exec-result-sha exec-one))
            (let forged-gen-flag (fkpfm-generative-evidence first-family
                (fkpfmb-model-id) gen-receipt-one raw-one candidate-one 0 0 1))
            (let forged-gen-model (fkpfm-generative-evidence first-family
                "other-local-model" gen-receipt-one raw-one candidate-one 1 0 1))
            (let forged-gen-release (fkpfm-generative-evidence first-family
                (fkpfmb-model-id) gen-receipt-one raw-one candidate-one 1 0 0))
            (let forged-request-flag (fkpfm-execution-evidence first-family
                (fkpfmb-model-id) exec-receipt-one request-one 0 0 1 result-one))
            (let forged-remote-flag (fkpfm-execution-evidence first-family
                (fkpfmb-model-id) exec-receipt-one request-one 1 1 1 result-one))
            (let remote-receipt (fkpfm-receipt "generative" first-family
                (fkpfmb-model-id) (fkpfmb-run-id) raw-one
                (fkpfm-candidate-message first-family
                    (fkpfm-family-source-sha first-family)
                    (fkpfm-family-challenge-sha first-family)
                    (fkpfm-family-exec-challenge-sha first-family)
                    candidate-one) 1 1 1 0 1))

            (let zero-result (fkpfmb-generic-result 0 1))
            (let one-result (fkpfmb-generic-result 1 1))
            (let absent-result (fkpfmb-generic-result 0 0))
            (let one-triple (list heldout-one gen-one exec-one))
            (let empty-report (fkpfm-report (list)))
            (let heldout-only-report (fkpfm-report (list heldout-one)))
            (let one-report (fkpfm-report one-triple))
            (let duplicate-report (fkpfm-report (cons heldout-one one-triple)))
            (let prose-report (fkpfm-report (list "mastered=15")))
            (let noexec-report (fkpfm-report (list heldout-one gen-one)))

            (sum (list
                (fkpfmb-bit (eq (fkpfm-family-total) 15) 1)
                (fkpfmb-bit (eq (fkpfm-equal? families (fkhe-families)) 1) 2)
                (fkpfmb-bit (and
                    (not (str_eq (fkpfm-family-exec-challenge-sha first-family)
                                 (fkpfm-family-exec-challenge-sha second-family)))
                    (eq (fkpfm-family-native-input "bootstrap") -2)) 4)
                (fkpfmb-bit (and (nothing? (fkpfm-report (nothing)))
                    (and (nothing? (fkpfm-report 0))
                         (nothing? (fkpfm-report 1)))) 8)
                (fkpfmb-bit (and (eq (fkpfm-report-mastered
                                        heldout-only-report) 0)
                    (eq (fkpfm-report-route-addressability-credit
                            heldout-only-report) 0)) 16)
                (fkpfmb-bit (and (eq (fkpfm-receipt-valid?
                                        heldout-receipt) 1)
                    (and (eq (fkpfm-receipt-valid? gen-receipt-one) 1)
                         (eq (fkpfm-receipt-valid? exec-receipt-one) 1))) 32)
                (fkpfmb-bit (eq (fkpfm-heldout-valid? heldout-one) 1) 64)
                (fkpfmb-bit (eq (fkpfm-generative-valid? gen-one) 1) 128)
                (fkpfmb-bit (eq (fkpfm-execution-valid? exec-one) 1) 256)
                (fkpfmb-bit (and (eq (fgsg-verdict-overall
                    (fgsg-verify candidate-one
                        (fkpfm-family-exec-challenge first-family))) 1)
                    (eq (fgsg-verdict-overall
                    (fgsg-verify candidate-one
                        (fkpfm-family-exec-challenge second-family))) 0)) 512)
                (fkpfmb-bit (eq (fkpfm-generative-valid? replay-gen) 0) 1024)
                (fkpfmb-bit (eq (fkpfm-execution-valid? replay-exec) 0) 2048)
                (fkpfmb-bit (and (eq (fkpfm-receipt-valid?
                                        wrong-heldout-receipt) 0)
                    (eq (fkpfm-heldout-valid? wrong-heldout) 0)) 4096)
                (fkpfmb-bit (eq (fkpfm-heldout-valid? wrong-heldout-raw) 0)
                    8192)
                (fkpfmb-bit (eq (fkpfm-heldout-valid? wrong-report) 0) 16384)
                (fkpfmb-bit (and (eq (fkpfm-generative-valid?
                                        wrong-gen-digest) 0)
                    (eq (fkpfm-generative-valid? wrong-gen-raw) 0)) 32768)
                (fkpfmb-bit (eq (fkpfm-execution-valid?
                                    wrong-result-digest) 0) 65536)
                (fkpfmb-bit (and
                    (eq (fkpfm-generative-valid? forged-gen-flag) 0)
                    (and (eq (fkpfm-generative-valid? forged-gen-model) 0)
                    (and (eq (fkpfm-generative-valid? forged-gen-release) 0)
                         (eq (fkpfm-generative-valid? wrong-gen-run) 0))))
                    131072)
                (fkpfmb-bit (and (eq (fkpfm-execution-valid?
                                        forged-request-flag) 0)
                    (eq (fkpfm-execution-valid? forged-remote-flag) 0)) 262144)
                (fkpfmb-bit (eq (fkpfm-receipt-valid? remote-receipt) 0) 524288)
                (fkpfmb-bit (and (eq (fkpfm-native-result-valid? zero-result) 1)
                    (and (eq (frex-result-value-present? zero-result) 1)
                    (and (eq (fkpfm-native-result-valid? one-result) 1)
                         (eq (fkpfm-native-result-valid? absent-result) 0))))
                    1048576)
                (fkpfmb-bit (and (eq (fkpfm-report-mastered one-report) 1)
                    (and (eq (fkpfm-report-percent one-report) 6)
                         (eq (fkpfm-report-ready95? one-report) 0))) 2097152)
                (fkpfmb-bit (and (eq (fkpfm-percent 14 15) 93)
                    (and (eq (fkpfm-ready95? 14 15 0) 0)
                         (eq (fkpfm-ready95? 15 15 0) 1))) 4194304)
                (fkpfmb-bit (and (eq (fkpfm-report-mastered
                                        duplicate-report) 1)
                    (eq (fkpfm-report-invalid-evidence duplicate-report) 0))
                    8388608)
                (fkpfmb-bit (and (eq (fkpfm-report-invalid-evidence
                                        prose-report) 1)
                    (eq (fkpfm-report-ready95? prose-report) 0)) 16777216)
                (fkpfmb-bit (and (eq (fkpfm-report-heldout-families
                                        noexec-report) 1)
                    (and (eq (fkpfm-report-generative-families noexec-report) 1)
                         (eq (fkpfm-report-execution-families noexec-report) 0)))
                    33554432)
                (fkpfmb-bit (and (eq (len (fkpfm-report-missing-families
                                            empty-report)) 15)
                    (eq (len (fkpfm-report-missing-families one-report)) 14))
                    67108864)
                (fkpfmb-bit (and (eq (fkpfm-family? "bootstrap") 1)
                    (and (eq (fkpfm-family? "unknown") 0)
                         (eq (fkpfm-family? (nothing)) 0))) 134217728)
                (fkpfmb-bit (and (eq (fkpfm-evidence-valid? heldout-one) 1)
                    (and (eq (fkpfm-evidence-valid? gen-one) 1)
                    (and (eq (fkpfm-evidence-valid? exec-one) 1)
                         (eq (nmfe-sha256? (fkpfm-receipt-sha
                            gen-receipt-one)) 1)))) 268435456)
                (fkpfmb-bit (and (eq (fkpfm-generative-valid? gen-two) 1)
                    (and (eq (fkpfm-execution-valid? exec-two) 1)
                    (and (eq (frex-result-value result-two) 1)
                         (not (str_eq (nth gen-one 5) (nth gen-two 5))))))
                    536870912)))))

    (form-knowledge-public-family-mastery-band))
