// Decoder boundary checks: unchanged prefix, original allowance, state and
// stop ownership. No model admission or answer-quality claim.
// preludes: form-stdlib/bml/form-cli-json-completion.bml
section [form.bml] {
 def jc-need(ok,why) = if ok then 1 else form_error(why);
 def jc-never(s,stops) = form_error("unexpected continuation");
 def jc-pick(s,stops) = 2;
 def jc-none(s,stops) = -1;
 def jc-decode(s,ids) = if ((Value) ids == list(0,1,2,3)) then "{\"answer\":\"kept and completed\"}" else if ((Value) ids == list(0,1,2)) then "{\"answer\":\"kept and" else form_error("original token sequence changed");
 def jc-generate(s,left) {
  jc-need((((Comparable) fcms-pos(s) == 12) && (((Comparable) fcms-pending(s) == 2) && ((!fcms-stopped?(s)) && (((Comparable) fcms-generated-ids(s) == 7) && (((Comparable) fcms-injected-ids(s) == 3) && ((Comparable) fcms-observations(s) == 1)))))),"stop entered KV or stream counters changed before continuation");
  if ((Comparable) left == 1) then fcms-generation(" and",list(2),fcms-with-stream(s,12,2,0,8,3,1)) else {
   jc-need(((Comparable) left == 2),"original final allowance changed");
   fcms-generation(" and completed\"}",list(2,3),fcms-with-stream(s,14,9,1,9,3,1));
  };
 }
 let session = fcms-session("live","","test","",list("ctx"),list("state"),20,12,9,1,5,7,3,1);
 let final = fcms-generation("{\"answer\":\"kept",list(0,1),session);
 let first = fcms-generation("private",list(7,7,7,7,7),session);
 let before = frbg-result(session,first,final,fcms-generation-text(final),"controller-final-stage","notice",1,"complete");
 jc-need(fcjc-open-string("{\"answer\":\"kept"),"unfinished string was missed");
 jc-need((!fcjc-open-string("{\"answer\":\"done\"}")),"complete answer resumed");
 jc-need((!fcjc-open-string("{\"answer\":\"bad\n")),"malformed prefix resumed");
 jc-need((!fcjc-open-string("{\"answer\":1")),"non-string boundary resumed");
 let done = fcjc-with(before,4,list(9),jc-pick,jc-generate,jc-decode);
 jc-need((((Comparable) len(nth(done,1)) == 1) && (frbg-complete(head(done)) && faj-valid(frbg-answer(head(done))))),"model completion not retained");
 jc-need((((Value) frbg-first(head(done)) == first) && (((String) frbg-notice(head(done)) == "notice") && ((Comparable) fcms-generated-ids(frbg-session(head(done))) == 9))),"reasoning, notice or accounting changed");
 jc-need((((Comparable) fcms-pos(frbg-session(head(done))) == 14) && (((Comparable) fcms-pending(frbg-session(head(done))) == 9) && ((Comparable) fcms-injected-ids(frbg-session(head(done))) == 3))),"completion replayed context or consumed stop");
 let cut = head(fcjc-with(before,3,list(9),jc-pick,jc-generate,jc-decode));
 jc-need(((!frbg-complete(cut)) && (((Comparable) len(fcms-generation-ids(frbg-final(cut))) == 3) && ((String) frbg-reason(cut) == "final-generation-incomplete"))),"exhausted answer was extended or accepted");
 jc-need(((Value) head(fcjc-with(before,2,list(9),jc-never,jc-generate,jc-decode)) == before),"zero remaining allowance resumed");
 jc-need(((Value) head(fcjc-with(before,4,list(8),jc-never,jc-generate,jc-decode)) == before),"unrecognized stop resumed");
 jc-need(((Value) head(fcjc-with(before,4,list(9),jc-none,jc-generate,jc-decode)) == before),"refused head changed original evidence");
 let natural = frbg-result(session,first,final,fcms-generation-text(final),"model-final","",1,"complete");
 jc-need(((Value) head(fcjc-with(natural,4,list(9),jc-never,jc-generate,jc-decode)) == natural),"private first stage entered final continuation");
 let complete = frbg-result(session,first,fcms-generation("{}",list(0,1),session),"{}","controller-final-stage","",1,"complete");
 jc-need(((Value) head(fcjc-with(complete,4,list(9),jc-never,jc-generate,jc-decode)) == complete),"complete JSON changed");
 let raw = str_concat(md-le32(md-f32-bits(-2.0)),str_concat(md-le32(md-f32-bits(-1.0)),str_concat(md-le32(md-f32-bits(-1.0)),md-le32(md-f32-bits(9.0)))));
 jc-need(((Comparable) fcjc-select(raw,4,list(3)) == 1),"non-stop argmax or first-index tie changed");
 jc-need(((Comparable) fcjc-select(raw,4,list(1,3)) == 2),"multiple stop IDs not excluded");
 jc-need(((Comparable) fcjc-select(raw,4,list(0,1,2,3)) == -1),"all-excluded head fabricated a token");
 jc-need(((Comparable) fcjc-select(substring(raw,0,15),4,list()) == -1),"short head was read");
 jc-need(((Comparable) fcjc-select(str_concat(substring(raw,0,12),md-le32(2139095040)),4,list(3)) == -1),"non-finite excluded head was admitted");
 print_str("JSON completion boundary checks passed; model quality remains a live observation");
 1;
}
