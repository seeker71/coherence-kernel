// Decoder boundary checks: unchanged prefix, original allowance, state and
// stop ownership. No model admission or answer-quality claim.
// preludes: form-stdlib/bml/form-cli-json-completion.bml
section [form.bml] {
 def jc-need(ok,why) = if ok then 1 else form_error(why);
 def jc-never(s,stops) = form_error("unexpected continuation");
 def jc-pick(s,stops) = 2;
 def jc-none(s,stops) = -1;
 def jc-decode(s,ids) = if value_eq(ids,list(0,1,2,3)) then "{\"answer\":\"kept and completed\"}" else if value_eq(ids,list(0,1,2)) then "{\"answer\":\"kept and" else form_error("original token sequence changed");
 def jc-generate(s,left) {
  jc-need(and(eq(fcms-pos(s),12),and(eq(fcms-pending(s),2),and(not(fcms-stopped?(s)),and(eq(fcms-generated-ids(s),7),and(eq(fcms-injected-ids(s),3),eq(fcms-observations(s),1)))))),"stop entered KV or stream counters changed before continuation");
  if eq(left,1) then fcms-generation(" and",list(2),fcms-with-stream(s,12,2,0,8,3,1)) else {
   jc-need(eq(left,2),"original final allowance changed");
   fcms-generation(" and completed\"}",list(2,3),fcms-with-stream(s,14,9,1,9,3,1));
  };
 }
 let session = fcms-session("live","","test","",list("ctx"),list("state"),20,12,9,1,5,7,3,1);
 let final = fcms-generation("{\"answer\":\"kept",list(0,1),session);
 let first = fcms-generation("private",list(7,7,7,7,7),session);
 let before = frbg-result(session,first,final,fcms-generation-text(final),"controller-final-stage","notice",1,"complete");
 jc-need(fcjc-open-string("{\"answer\":\"kept"),"unfinished string was missed");
 jc-need(not(fcjc-open-string("{\"answer\":\"done\"}")),"complete answer resumed");
 jc-need(not(fcjc-open-string("{\"answer\":\"bad\n")),"malformed prefix resumed");
 jc-need(not(fcjc-open-string("{\"answer\":1")),"non-string boundary resumed");
 let done = fcjc-with(before,4,list(9),jc-pick,jc-generate,jc-decode);
 jc-need(and(eq(len(nth(done,1)),1),and(frbg-complete(head(done)),faj-valid(frbg-answer(head(done))))),"model completion not retained");
 jc-need(and(value_eq(frbg-first(head(done)),first),and(str_eq(frbg-notice(head(done)),"notice"),eq(fcms-generated-ids(frbg-session(head(done))),9))),"reasoning, notice or accounting changed");
 jc-need(and(eq(fcms-pos(frbg-session(head(done))),14),and(eq(fcms-pending(frbg-session(head(done))),9),eq(fcms-injected-ids(frbg-session(head(done))),3))),"completion replayed context or consumed stop");
 let cut = head(fcjc-with(before,3,list(9),jc-pick,jc-generate,jc-decode));
 jc-need(and(not(frbg-complete(cut)),and(eq(len(fcms-generation-ids(frbg-final(cut))),3),str_eq(frbg-reason(cut),"final-generation-incomplete"))),"exhausted answer was extended or accepted");
 jc-need(value_eq(head(fcjc-with(before,2,list(9),jc-never,jc-generate,jc-decode)),before),"zero remaining allowance resumed");
 jc-need(value_eq(head(fcjc-with(before,4,list(8),jc-never,jc-generate,jc-decode)),before),"unrecognized stop resumed");
 jc-need(value_eq(head(fcjc-with(before,4,list(9),jc-none,jc-generate,jc-decode)),before),"refused head changed original evidence");
 let natural = frbg-result(session,first,final,fcms-generation-text(final),"model-final","",1,"complete");
 jc-need(value_eq(head(fcjc-with(natural,4,list(9),jc-never,jc-generate,jc-decode)),natural),"private first stage entered final continuation");
 let complete = frbg-result(session,first,fcms-generation("{}",list(0,1),session),"{}","controller-final-stage","",1,"complete");
 jc-need(value_eq(head(fcjc-with(complete,4,list(9),jc-never,jc-generate,jc-decode)),complete),"complete JSON changed");
 let raw = str_concat(md-le32(md-f32-bits(-2.0)),str_concat(md-le32(md-f32-bits(-1.0)),str_concat(md-le32(md-f32-bits(-1.0)),md-le32(md-f32-bits(9.0)))));
 jc-need(eq(fcjc-select(raw,4,list(3)),1),"non-stop argmax or first-index tie changed");
 jc-need(eq(fcjc-select(raw,4,list(1,3)),2),"multiple stop IDs not excluded");
 jc-need(eq(fcjc-select(raw,4,list(0,1,2,3)),-1),"all-excluded head fabricated a token");
 jc-need(eq(fcjc-select(substring(raw,0,15),4,list()),-1),"short head was read");
 jc-need(eq(fcjc-select(str_concat(substring(raw,0,12),md-le32(2139095040)),4,list(3)),-1),"non-finite excluded head was admitted");
 print_str("JSON completion boundary checks passed; model quality remains a live observation");
 1;
}
