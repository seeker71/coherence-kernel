; preludes: form-stdlib/core.fk form-stdlib/metal-door.fk form-stdlib/f16-decode.fk form-stdlib/qk-matvec-lane.fk form-stdlib/qk-matmul-batch.fk form-stdlib/lora-adapter.bml
; Expected: 63
; PROOF LEVEL: FOURTH-ARM ONLY (metal handle door)
;
; q8-0-mma-prefix-band — span-split invariance at the matmul: the matrix-unit twin (qmb-q80-mma, the kernel the
; lane dispatches for every Q8_0 matrix, q38-mv-batch-y) gives an output row the same BYTES whatever span it
; was computed in. This is the claim prompt-lookup drafting stands on (form-cli-model-draft.bml): a drafted
; reply and an undrafted one go through the same kernels with different spans (a verify of k+1 rows against
; k+1 spans of one), and are the same reply only if row t does not depend on the other rows in its tile.
; tests/q8-0-matmul-mma-band.fk holds the twin to a bound ("the hardware picks the association and bytes are not
; the claim" across the batched kernel); this band holds it to ITSELF, byte for byte, across splits.
;
; The weights are one 77-row x 320-column Q8_0 matrix (77 ends partway through a 32-row tile, as the lane's
; matrices end partway through theirs). The activations are fractions of 13 that make order show, as in the
; bound band; x(t, j) is a function of the token's index t, so runs that shift t carry their rows with them:
;   A  45 tokens (a 32-token tile and a ragged second one)
;   B  21 tokens                       C  1 token                      F  33 tokens (one past a tile)
;   D  45 tokens of x(t + 3)           E  45 tokens of x(t + 35)       (a row moves within a tile, and across)
;
; Verdict 63:
;   1   the twin mints and every dispatch comes back clean
;   2   the 1-token run's row is byte-equal to row 0 of the 45-token and 21-token runs
;   4   the 21-token run's 21 rows are byte-equal to the first 21 rows of the 45-token run
;   8   the 33-token run's 33 rows are byte-equal to the first 33 rows of the 45-token run
;   16  the shifted runs: D's row t is A's row t+3 (t < 42) and E's row t is A's row t+35 (t < 10), byte for byte
;   32  not degenerate: the outputs are not all zeros, and A's rows differ from one another
;
; If it reads short, span-split invariance fails at the matmul and the drafted lane cannot claim it. Backtrack
; options, in order: pin the Q8_0 span route to the byte-exact batched twin (qmb-q80-batch-tg, "byte-identical to
; the batched kernel", slower but exact); pad every verify to a full 32-token tile with zeros so that the tile a
; row sits in does not change with k. The Q4_K, Q6_K and F32 batched kernels are not run here: the qwen38-q8 lane
; dispatches none of them for a matmul.
(do
    (defn qmp-d (r b) (nth (list 0.0123 -0.0457 0.0311 0.0089 -0.0205 0.0662 -0.0149 0.0278) (mod (add (mul r 3) b) 8)))
    (defn qmp-q (r j) (sub (mod (add (mul r 37) (mul j 11)) 255) 127))
    (defn qmp-u8 (q) (if (lt q 0) (add q 256) q))
    (defn qmp-qs (r b i acc) (if (ge i 32) acc (qmp-qs r b (add i 1) (str_concat acc (byte_to_str (qmp-u8 (qmp-q r (add (mul b 32) i))))))))
    (defn qmp-block (r b)
        (str_concat (str_concat (byte_to_str (mod (md-f16-bits (qmp-d r b)) 256)) (byte_to_str (div (md-f16-bits (qmp-d r b)) 256)))
                    (qmp-qs r b 0 "")))
    (defn qmp-put-w (h r rows nb b)
        (if (ge r rows) h
            (if (ge b nb) (qmp-put-w h (add r 1) rows nb 0)
                (do (let w (metal_buf_write h (mul 34 (add (mul r nb) b)) (qmp-block r b)))
                    (qmp-put-w h r rows nb (add b 1))))))
    (defn qmp-x (t j) (div (add (sub (mod (add (mul t 29) (mul j 7)) 97) 48) 0.0) 13.0))
    (defn qmp-xrow (t j cols acc) (if (ge j cols) acc (qmp-xrow t (add j 1) cols (str_concat acc (md-le32 (md-f32-bits (qmp-x t j)))))))
    ; token i of the run holds the activations of token (i + shift)
    (defn qmp-put-x (h t ntok cols shift)
        (if (ge t ntok) h
            (do (let w (metal_buf_write h (mul 4 (mul t cols)) (qmp-xrow (add t shift) 0 cols "")))
                (qmp-put-x h (add t 1) ntok cols shift))))
    ; (bytes clean) of one twin dispatch over ntok tokens of x(t + shift), token-major with ystride = rows
    (defn qmp-run (pm qh rows cols ntok shift)
        (do (let xh (qmp-put-x (metal_buf_alloc (mul 4 (mul ntok cols))) 0 ntok cols shift))
            (let ym (metal_buf_alloc (mul 4 (mul ntok rows))))
            (let e (metal_enqueue pm (md-bind16 (list qh xh ym) (list rows cols ntok rows) 256 0 1 0)
                        (qmb-mma-groups rows ntok)))
            (let s (metal_sync))
            (list (metal_buf_read ym 0 (mul 4 (mul ntok rows)))
                  (if (and (eq e 1) (ge s 0)) 1 0))))
    (defn qmp-row (y t rows) (substring y (mul t (mul rows 4)) (mul (add t 1) (mul rows 4))))
    ; rows 0 .. n-1 of a equal rows off .. off+n-1 of b, byte for byte
    (defn qmp-same (a b off n t rows)
        (if (ge t n) 1
            (if (str_eq (qmp-row a t rows) (qmp-row b (add t off) rows)) (qmp-same a b off n (add t 1) rows) 0)))
    (defn qmp-zero? (s i n) (if (ge i n) 1 (if (eq (str_byte_at s i) 0) (qmp-zero? s (add i 1) n) 0)))
    (defn qmp-distinct (y t rows n)
        (if (ge t (sub n 1)) 1
            (if (str_eq (qmp-row y t rows) (qmp-row y (add t 1) rows)) 0 (qmp-distinct y (add t 1) rows n))))

    (let rows 77)
    (let cols 320)
    (let nb (div cols 32))
    (let unit (str_concat "#include <metal_stdlib>\n" (str_concat (qmb-q80-batch) (qmb-q80-mma))))
    (let pm (metal_pipeline unit "form_q8_0_matmul_mma_f32"))
    (let qh (qmp-put-w (metal_buf_alloc (mul 34 (mul rows nb))) 0 rows nb 0))
    (let a (qmp-run pm qh rows cols 45 0))
    (let b (qmp-run pm qh rows cols 21 0))
    (let c (qmp-run pm qh rows cols 1 0))
    (let f (qmp-run pm qh rows cols 33 0))
    (let d (qmp-run pm qh rows cols 45 3))
    (let e (qmp-run pm qh rows cols 45 35))

    (let c0 (if (and (gt pm 0) (and (eq (nth a 1) 1) (and (eq (nth b 1) 1) (and (eq (nth c 1) 1) (and (eq (nth f 1) 1) (and (eq (nth d 1) 1) (eq (nth e 1) 1))))))) 1 0))
    (let c1 (if (and (eq (qmp-same (nth c 0) (nth a 0) 0 1 0 rows) 1) (eq (qmp-same (nth c 0) (nth b 0) 0 1 0 rows) 1)) 2 0))
    (let c2 (if (eq (qmp-same (nth b 0) (nth a 0) 0 21 0 rows) 1) 4 0))
    (let c3 (if (eq (qmp-same (nth f 0) (nth a 0) 0 33 0 rows) 1) 8 0))
    (let c4 (if (and (eq (qmp-same (nth d 0) (nth a 0) 3 42 0 rows) 1) (eq (qmp-same (nth e 0) (nth a 0) 35 10 0 rows) 1)) 16 0))
    (let c5 (if (and (eq (qmp-zero? (nth a 0) 0 (str_len (nth a 0))) 0) (eq (qmp-distinct (nth a 0) 0 rows 45) 1)) 32 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
