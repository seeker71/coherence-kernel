; lane-fact-mint-band.fk — the lanes' facts extract, phrase thrice, and the
; live yield is witnessed, not assumed.
;
; Verdict 255 (8 bits):
;   1    defn-constant: string and number literals extract; a parameterized
;        defn and a computed body are NOTHING
;   2    #define NAME 4096 extracts exactly
;   4    an optable row yields name/arity with the arity as value
;   8    every fact emits THREE phrasings — the #551 paraphrase floor
;   16   rows are escaped JSONL shape (role markers present)
;   32   LIVE: the seed yields 80+ defines; the optable yields 150+ arities
;   64   LIVE: the peer-agent marks extract (task-open's value is the
;        actual <| mark)
;   128  a missing file contributes zero facts, counted not erred
;
; preludes: learn/lane-fact-mint.fk

(do
    (defn lfb-bit (ok bit) (if ok bit 0))
    (defn lane-fact-mint-band ()
        (do
            (let f1 (lfm-defn-const "    (defn jd-hot () 5)"))
            (let f2 (lfm-defn-const "    (defn mark () \"<|x|>\")"))
            (let f3 (lfm-defn-const "    (defn f (a b) (add a b))"))
            (let f4 (lfm-defn-const "    (defn g () (mul 2 3))"))
            (let d1 (lfm-define "#define FK_FN_CAP 4096"))
            (let o1 (lfm-optable "  { \"jit_leaf_hot\", 3, 29 },"))
            (let rows (lfm-rows-for "src.fk" (list "n" "v") (list)))
            (let live (lfm-mint-all))
            (let counts (nth live 1))

            (sum (list
                (lfb-bit (and (str_eq (nth f1 1) "5")
                         (and (str_eq (nth f2 1) "<|x|>")
                         (and (nothing? f3) (nothing? f4)))) 1)
                (lfb-bit (and (str_eq (nth d1 0) "FK_FN_CAP")
                              (str_eq (nth d1 1) "4096")) 2)
                (lfb-bit (and (str_eq (nth o1 0) "jit_leaf_hot/arity")
                              (str_eq (nth o1 1) "3")) 4)
                (lfb-bit (eq (len rows) 3) 8)
                (lfb-bit (and (ge (str_find (head rows) "\"role\":\"user\"" 0) 0)
                              (ge (str_find (head rows) "\"role\":\"assistant\"" 0) 0)) 16)
                (lfb-bit (and (ge (lfb-count-of counts "fkwu-uni.c") 80)
                              (ge (lfb-count-of counts "fkwu-optable.h") 150)) 32)
                (lfb-bit (eq (lfb-count-of counts "form-cli-peer-agent.fk") 2) 64)
                (lfb-bit (eq (len (lfm-extract "/no/such/file.c" lfm-define)) 0) 128)))))

    (defn lfb-count-of (cs name)
        (if (eq (len cs) 0) -1
            (if (str_eq (nth (head cs) 0) name) (nth (head cs) 1)
                (lfb-count-of (tail cs) name))))

    (lane-fact-mint-band))
