; loop-lane-closure-band.fk — a defn held as a value crosses into the loop lane, and map, filter and foldl crystallize.
;
; The tenth rung of Urs's 2026-09-12 goal. A defn named in value position is a word (a plain defn's index, no captures);
; the door admits a parameter of that kind as its raw word, and a call through it -- (f (head xs)) -- is checked when
; the leaf runs, since the callee is known only then: a plain defn under the page table's cap, with a page, this arity,
; and a signature that agrees with the arguments (ints, lists and defns exactly where the arguments are, no floats or
; strings on either side, no scratch); a consing callee draws on the caller's run of pairs. Anything else leaves for the
; overflow block and the walker answers -- the callee is heated by those very walks, and the next run of the leaf
; finds it. An int argument goes untagged, a word is taken for an int, a list or a defn as its word; the answer comes
; back as a word. A defn named as a value inside a leaf is a constant word. core.fk's map and filter are a loop onto an
; accumulator and one reversal; foldl, any? and all? crystallize as they stand.
;
; Verdict 255
; PROOF LEVEL: FOURTH-ARM ONLY (the transparent lanes are fkwu's MAP_JIT arm64 door; a defn's native state is the 8th field of its hot row)
; preludes: form-stdlib/core.fk
;
;   1   map-onto reads state 2 and map state 1 with its defn called through its word; map answers as the walker, the empty list too
;   2   foldl reads state 2 and folds as the walker over a hundred ints
;   4   filter-onto reads state 2 and keeps what the walker keeps; any? and all? read state 2 and answer as the walker
;   8   a float element is answered through the walker (the callee's signature holds ints: the leaf leaves, the walker answers)
;   16  a callee of another arity, and a callee that conses (drawing on the caller's run), answer as the walker
;   32  a leaf naming a defn as a value holds its word as a constant: the driver crystallizes (state 2) and answers as the walker
;   64  a defn reached only through a word, cold when the leaf crystallizes, is answered by the walker until it is hot, then natively -- the leaf never waits (state 2 from the first run, right both times)
;   128 the warm fold is under the walker twin's run of the same work
(do
    (defn lcl-bit (ok bit) (if ok bit 0))
    (defn lcl-state (name rows) (if (eq (len rows) 0) -99 (if (str_eq (nth (head rows) 1) name) (nth (head rows) 7) (lcl-state name (tail rows)))))
    (defn lcl-native (name) (lcl-state name (kernel_page_hot (host_pid) 240)))
    (defn lcl-lt? (a b) (if (lt (host_monotonic_ms) 0) false (lt a b))) ; a host clock: a door the lanes decline by meaning, so the twins walk
    (defn lcl-same (xs ys) (if (nil? xs) (nil? ys) (if (nil? ys) false (if (eq (head xs) (head ys)) (lcl-same (tail xs) (tail ys)) false))))
    (defn lcl-mk (n acc) (if (le n 0) acc (lcl-mk (sub n 1) (cons n acc))))
    (defn lcl-dbl (x) (mul x 2))
    (defn lcl-plus (a b) (add a b))
    (defn lcl-pos? (x) (if (lt 0 x) 1 0))
    (defn lcl-wrap (x) (cons x (empty)))
    (defn lcl-two (a b) (add a b))
    (let xs (lcl-mk 100 (list)))
    ; the callees heated by the walker first, so a call through their word finds a page
    (defn lcl-hw (n acc) (if (lcl-lt? 0 n) (lcl-hw (sub n 1) (add acc (add (lcl-dbl n) (add (lcl-plus n 1) (lcl-pos? n))))) acc))
    (let hw (lcl-hw 2200 0))
    ; the walker twins
    (defn lcl-map-walk (f xs) (if (lcl-lt? 0 (len xs)) (cons (f (head xs)) (lcl-map-walk f (tail xs))) (empty)))
    (defn lcl-foldl-walk (f init xs) (if (lcl-lt? 0 (len xs)) (lcl-foldl-walk f (f init (head xs)) (tail xs)) init))
    (defn lcl-filter-walk (p xs) (if (lcl-lt? 0 (len xs)) (if (p (head xs)) (cons (head xs) (lcl-filter-walk p (tail xs))) (lcl-filter-walk p (tail xs))) (empty)))
    ; 1, 2, 4: the recipes hot
    (defn lcl-h (xs n acc) (if (lcl-lt? 0 n) (lcl-h xs (sub n 1) (add acc (add (len (map lcl-dbl xs)) (add (foldl lcl-plus 0 xs) (add (len (filter lcl-pos? xs)) (add (any? lcl-pos? xs) (all? lcl-pos? xs))))))) acc))
    (let h (lcl-h xs 1100 0))
    (let mo-state (lcl-native "map-onto"))
    (let map-state (lcl-native "map"))
    (let foldl-state (lcl-native "foldl"))
    (let fo-state (lcl-native "filter-onto"))
    (let any-state (lcl-native "any?"))
    (let all-state (lcl-native "all?"))
    (let map-ok (if (lcl-same (map lcl-dbl xs) (lcl-map-walk lcl-dbl xs)) (lcl-same (map lcl-dbl (list)) (list)) false))
    (let foldl-ok (if (eq (foldl lcl-plus 0 xs) (lcl-foldl-walk lcl-plus 0 xs)) (eq (foldl lcl-plus 7 (list)) 7) false))
    (let mixed (lcl-mk 50 (list -3 -2 -1 0)))
    (let filter-ok (if (lcl-same (filter lcl-pos? mixed) (lcl-filter-walk lcl-pos? mixed)) (if (eq (any? lcl-pos? (list 0 -1 2)) 1) (if (eq (any? lcl-pos? (list 0 -1)) 0) (if (eq (all? lcl-pos? (list 1 2)) 1) (eq (all? lcl-pos? (list 1 -2)) 0) false) false) false) false))
    ; 8: a float element
    (let fl-ok (if (lcl-same (map lcl-dbl (list 1 2.5 3)) (list 2 5.0 6)) (eq (foldl lcl-plus 0 (list 1 2.5)) 3.5) false))
    ; 16: another arity, and a consing callee
    (defn lcl-h16 (xs n acc) (if (lcl-lt? 0 n) (lcl-h16 xs (sub n 1) (add acc (len (map lcl-wrap xs)))) acc))
    (let h16 (lcl-h16 xs 1100 0))
    (let ar-ok (if (eq (len (map lcl-two (list 1 2))) 2) (if (lcl-same (head (map lcl-wrap (list 1 2))) (list 1)) (eq (len (map lcl-wrap xs)) 100) false) false))
    ; 32: a defn named as a value inside a leaf
    (defn lcl-rep (xs n acc) (if (le n 0) acc (lcl-rep xs (sub n 1) (add acc (foldl lcl-plus 0 xs)))))
    (let r32 (lcl-rep xs 1100 0))
    (let rep-state (lcl-native "lcl-rep"))
    (let rep-ok (eq (lcl-rep xs 3 0) (mul 3 5050)))
    ; 64: a reducer reached only through foldl's word, cold when the leaf crystallizes -- the leaf is state 2 from its
    ; first run, the walker fills in each foldl call until the reducer is heated by those very walks, then it too reads
    ; state 1 (a leaf) and the call runs native. lcl-red takes two arguments, as foldl calls its reducer.
    (defn lcl-red (a x) (add a (mul x 2)))
    (defn lcl-h64 (n acc) (if (le n 0) acc (lcl-h64 (sub n 1) (add acc (foldl lcl-red 0 (list 1 2 3))))))
    (let a64 (lcl-h64 1100 0))
    (let h64-first (lcl-native "lcl-h64"))
    (let b64 (lcl-h64 2200 0))
    (let red-then (lcl-native "lcl-red"))
    (let late-ok (if (eq (lcl-h64 2 0) 24) (eq red-then 1) false))
    ; 128: the warm fold against the twin's
    (defn lcl-rep-walk (xs n acc) (if (lcl-lt? 0 n) (lcl-rep-walk xs (sub n 1) (add acc (lcl-foldl-walk lcl-plus 0 xs))) acc))
    (let w0 (host_monotonic_ms)) (let warm (lcl-rep xs 5000 0)) (let w1 (host_monotonic_ms))
    (let k0 (host_monotonic_ms)) (let cold (lcl-rep-walk xs 5000 0)) (let k1 (host_monotonic_ms))
    (let told (print (list "states" mo-state map-state foldl-state fo-state any-state all-state rep-state h64-first red-then "map" map-ok "foldl" foldl-ok "filter" filter-ok "fl" fl-ok "ar" ar-ok "rep" rep-ok "late" late-ok "ms" (sub w1 w0) (sub k1 k0))))
    (let b1 (lcl-bit (if (eq mo-state 2) (if (eq map-state 1) map-ok false) false) 1))
    (let b2 (lcl-bit (if (eq foldl-state 2) foldl-ok false) 2))
    (let b3 (lcl-bit (if (eq fo-state 2) (if (eq any-state 2) (if (eq all-state 2) filter-ok false) false) false) 4))
    (let b4 (lcl-bit fl-ok 8))
    (let b5 (lcl-bit ar-ok 16))
    (let b6 (lcl-bit (if (eq rep-state 2) rep-ok false) 32))
    (let b7 (lcl-bit (if (eq h64-first 2) (if (eq red-then 1) late-ok false) false) 64))
    (let b8 (lcl-bit (if (eq warm cold) (lt (sub w1 w0) (sub k1 k0)) false) 128))
    (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 b8))))))))
