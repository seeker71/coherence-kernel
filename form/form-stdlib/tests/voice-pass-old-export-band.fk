; voice-pass-old-export-band.fk — the mouth's pass opens the OLDER exporter's files, and speaks through them.
;
; Two voices of this body's store come from the torch exporter that numbers its nodes serially
; (`Conv_816`, `Gather_1`, inputs like `onnx::Mul_661`) instead of naming them for the module that
; holds them (`/enc_p/encoder/attn_layers.2/conv_q/Conv`), and that has no `Constant` op at all: its
; constants are initializers with serial names. id_ID-news_tts-medium (Indonesian) and
; pt_BR-cadu-medium are those. The architecture is the same VITS; only the names differ.
; `voice-pass.bml`'s name-resolution layer asks each node instead of reading its name:
;   - a Conv's name is spelled from the module path on its own weight (or, for a fused weight-norm
;     kernel that has no name, on the bias beside it): dots to slashes, a number clinging to the
;     segment before it, the op closing it;
;   - the layernorm epsilon is what the Add before the first Sqrt adds; the embedding scale is
;     what the Mul after the embedding Gather multiplies by; the vocoder's divisor is the Div
;     behind the second upsample's LeakyRelu; the duration affine's Mul is the one that eats the
;     Sub of `dp.flows.0.m`; the spline's tail bounds are the first GreaterOrEqual and LessOrEqual,
;     its minimum width the Add after the first Softplus, its search epsilon the Add of a Gather
;     that an Expand reads; the feed-forward's padding is the Conv's own, because this exporter
;     folded the Pad into it.
;
; Every number below was produced twice on 2026-10-02: by the body (`voice-pass.bml` on this Mac's
; metal, weights read off the model file by `voice-onnx.bml`) and by onnxruntime on the SAME phoneme
; row with the noise scales at zero (`[0, length, 0]`), as `voice-pass-band.fk` does. onnxruntime
; was a one-off reference oracle for proof; nothing here calls it. The rows are espeak's phonemes
; for "Baiklah, mari kita mulai." (id) and "Bom dia, tudo bem?" (pt-br), already turned into ids.
; Witnessed: the Indonesian line renders 65024 samples at length 1.6 and the pcm agrees with
; onnxruntime's float output to 2.8e-5 at the worst sample (that is the 16-bit step), correlation
; 0.99999999.
;
; The band is silent: it opens no audio device and plays nothing.
;
;   1     id_ID-news_tts-medium opens: every kernel compiled, every scalar resolved
;   2     pt_BR-cadu-medium opens
;   4     the Indonesian constants read out of the file: epsilon 1e-5, embedding scale 13.856406,
;         vocoder divisor 3, feed-forward padding 1, spline bounds -5 5, minimum 0.001, epsilon 1e-6
;   8     the names resolve by structure: 132 convolutions, six encoder layers, coupling flows
;         6 4 2 0, duration flows 7 5 3, three upsamples, nine residual blocks; and the first
;         coupling flow's FUSED weight is `onnx::Conv_8694`, read through the node that consumes it
;   16    the Indonesian line answers 65024 samples, and six probed samples agree with onnxruntime
;         inside 1e-5
;   32    the whole line's absolute sum agrees inside 0.01
;   64    the samples leave as signed 16-bit, two bytes each (130048)
;   128   the Portuguese line answers 46848 samples and its six probed samples agree inside 1e-5
;
; Expected: 255
; Verdict 255
; PROOF LEVEL: FOURTH-ARM ONLY (Metal dispatches and host file reads over the voice store)
; preflight-exec: forbidden
; preludes: form/form-stdlib/voice-pass.bml form/form-stdlib/voice-say.bml
(do
    (defn ob-bit (ok v) (if ok v 0))
    (defn ob-id-ids () (list 1 0 15 0 120 0 14 0 74 0 23 0 24 0 14 0 20 0 8 0 3 0 25 0 120 0 14 0 30 0 21 0 3 0 23 0 120 0 21 0 32 0 14 0 3 0 25 0 120 0 33 0 24 0 14 0 74 0 10 0 2))
    (defn ob-pt-ids () (list 1 0 15 0 120 0 27 0 141 0 26 0 3 0 17 0 108 0 120 0 21 0 119 0 50 0 8 0 3 0 32 0 120 0 33 0 17 0 100 0 3 0 15 0 120 0 18 0 74 0 25 0 13 0 2))
    (defn ob-at () (list 0 1000 5000 10000 20000 30000))
    (defn ob-near? (a b) (le (vv-abs (sub a b)) 0.00001))
    (defn ob-probe (o idx) (if (eq (len idx) 0) (list) (cons (head (vv-read o (head idx) 1)) (ob-probe o (tail idx)))))
    (defn ob-all-near? (xs ys) (if (eq (len xs) 0) 1 (if (eq (len ys) 0) 0 (if (ob-near? (head xs) (head ys)) (ob-all-near? (tail xs) (tail ys)) 0))))
    (defn ob-fabs-go (xs acc) (if (eq (len xs) 0) acc (ob-fabs-go (tail xs) (add acc (vv-abs (head xs))))))
    (defn ob-itext (xs) (if (eq (len xs) 0) "" (str_concat (int_to_str (head xs)) (str_concat (if (eq (len (tail xs)) 0) "" " ") (ob-itext (tail xs))))))

    ; ---- Indonesian ----
    (let st (vv-open (vp-model-path "id_ID-news_tts-medium")))
    (let b1 (ob-bit (eq (vv-open-ok? st) 1) 1))
    (let sp (vv-spline st))
    (let b4 (ob-bit (if (str_eq (float_to_str (vv-eps st)) "0.00001")
                       (if (str_eq (float_to_str (vv-escale st)) "13.856406")
                           (if (eq (vv-ffnpad st) 1)
                               (if (str_eq (float_to_str (vv-decdiv st)) "3")
                                   (if (str_eq (vo-floats-text sp) "-5 5 0.001 0.000001 10 13.856406") 1 0) 0) 0) 0) 0) 4))
    (let b8 (ob-bit (if (eq (len (vv-ctab st)) 132)
                       (if (eq (vv-nlayers st 0) 6)
                           (if (str_eq (ob-itext (vv-rcl-list st)) "6 4 2 0")
                               (if (str_eq (ob-itext (vv-cf-list st)) "7 5 3")
                                   (if (eq (vv-nups st 0) 3)
                                       (if (eq (vv-nres st 0) 9)
                                           (str_eq (vv-cw (vv-crow st "/flow/flows.0/enc/in_layers.0/Conv")) "onnx::Conv_8694") 0) 0) 0) 0) 0) 0) 8))
    (let o (vv-render st (ob-id-ids) 1.6))
    (let sy0 (metal_sync))
    (let b16 (ob-bit (if (eq (vv-tn o) 65024)
                        (ob-all-near? (ob-probe o (ob-at)) (list 0.000306 0.000055 0.017806 -0.219359 0.051233 0.028072)) 0) 16))
    (let b32 (ob-bit (le (vv-abs (sub (ob-fabs-go (vv-read o 0 (vv-tn o)) 0.0) 2598.606689)) 0.01) 32))
    (let b64 (ob-bit (eq (str_len (vv-pcm st o)) 130048) 64))

    ; ---- Portuguese ----
    (let pst (vv-open (vp-model-path "pt_BR-cadu-medium")))
    (let b2 (ob-bit (eq (vv-open-ok? pst) 1) 2))
    (let po (vv-render pst (ob-pt-ids) 1.0))
    (let b128 (ob-bit (if (eq (vv-tn po) 46848)
                         (ob-all-near? (ob-probe po (ob-at)) (list -0.000014 -0.000047 0.000007 -0.000028 -0.028838 0.000007)) 0) 128))

    (add b1 (add b2 (add b4 (add b8 (add b16 (add b32 (add b64 b128)))))))
)
