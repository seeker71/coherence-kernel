; native-model-owner-request-flow-band.fk — pure shape/evidence/privacy proof.
;
; No owner command is offered here.  The physical witness is the separate
; observe/native-model-owner-request-flow-run.fk door.
;
; Verdict 65535.
; preludes: form/form-stdlib/native-model-owner-request-flow.bml

(do
    (defn nmofb-bit (ok bit) (if ok bit 0))
    (defn nmofb-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))
    (let owner "models.dual-resident.fixture")
    (let epoch 1700000000000)
    (let model (nmdt-callable-sample (NMOFModelId) owner "ready" 1262 epoch epoch))
    (let token (nmdt-token-position (NMOFTokenId) (NMOFModelId) 22 "ready" 1262 epoch))
    (let rows (list model token))
    (let flow "model-flow-owner-client.fixture")
    (let blank (nmof-blank))
    (let request (nmof-event flow owner "request" 1 (fgtm-absent) blank epoch "physical-live" "form-cli.model-flow"))
    (let completedRequest (nmof-request-event flow owner epoch "completed" "physical-live" "form-cli.model-flow"))
    (let tensor-fields (nmof-fields (fgtm-absent) (fgtm-absent) (fgtm-present 47)
        (fgtm-present "qwen38.scratch-state")
        (fgtm-present (nmtl-qwen-allocated-bytes 128 (NMOFLayers) 4))
        (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent)
        (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent)))
    (let tensor (nmof-event flow owner "tensor" 4
        (fgtm-present (nmtf-event-node-id request)) tensor-fields epoch
        "derived-window" "native-model-tensor-ledger"))
    (let metal-fields (nmof-fields (fgtm-absent) (fgtm-absent) (fgtm-present 47)
        (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent)
        (fgtm-present "owner-command.position-window") (fgtm-present 1262)
        (fgtm-absent) (fgtm-present 1000000) (fgtm-present 2661000)
        (fgtm-present 1661000)))
    (let metal (nmof-event flow owner "metal" 6
        (fgtm-present (nmtf-event-node-id tensor)) metal-fields epoch
        "derived-window" "owner-command.physical-position-window"))
    (let authority (read_file "form/form-stdlib/bml/native-model-owner-request-flow.bml"))
    (let repl (read_file "form/form-stdlib/form-cli-repl.fk"))
    (sum (list
        (nmofb-bit (eq (nmof-position rows) 22) 1)
        (nmofb-bit (eq (fgtm-field-value (nmof-model-handle rows)) 1262) 2)
        (nmofb-bit (eq (NMOFLayers) 48) 4)
        (nmofb-bit (eq (nmtl-qwen-allocated-bytes 128 (NMOFLayers) 4) 124435036) 8)
        (nmofb-bit (eq (len blank) 13) 16)
        (nmofb-bit (and (eq (nmtf-event-valid? request) 1)
                        (and (str_eq (nmtf-event-lifecycle request) "active")
                             (str_eq (nmtf-event-lifecycle completedRequest) "completed"))) 32)
        (nmofb-bit (eq (nmtf-event-root? request) 1) 64)
        (nmofb-bit (and (eq (nmtf-event-valid? tensor) 1)
                        (eq (fgtm-field-value (nmtf-event-tensor-bytes tensor)) 124435036)) 128)
        (nmofb-bit (and (str_eq (nmtf-event-owner request) owner)
                        (str_eq (nmtf-event-model request) (NMOFModel))) 256)
        (nmofb-bit (and (eq (nmofb-has authority "published atomically") 1)
                        (and (eq (nmofb-has authority "without artificial sleeps") 1)
                             (eq (nmofb-has authority "never releases or reloads") 1))) 512)
        (nmofb-bit (and (eq (nmofb-has authority "prompt and decoded token bytes never cross") 1)
                        (lt (str_find (nmtf-event-wire request) "prompt" 0) 0)) 1024)
        (nmofb-bit (and (str_eq (nmtf-event-evidence request) "physical-live")
                        (str_eq (nmtf-event-evidence tensor) "derived-window")) 2048)
        (nmofb-bit (and (eq (nmtf-event-valid? metal) 1)
                        (and (eq (fgtm-field-value (nmtf-event-duration-us metal)) 1661000)
                             (str_eq (nmtf-event-purpose metal) "owner-command.position-window"))) 4096)
        (nmofb-bit (and (str_eq (NMOFPublisher) "form-cli-model-flow")
                        (and (str_eq (nmtf-event-purpose request) "form-cli.model-flow")
                             (and (str_eq (fnc-binding-cell (nmtf-event-category-binding request)) (nmtf-event-node-id request))
                                  (and (str_eq (fnc-binding-category (nmtf-event-category-binding request)) "1.2.99.1703")
                                       (and (str_eq (fnc-binding-family (nmtf-event-category-binding request)) "1.2.99")
                                            (and (str_eq (fnc-binding-role (nmtf-event-category-binding request)) "cell")
                                                 (str_eq (fnc-binding-type (nmtf-event-category-binding request)) "request"))))))) 8192)
        (nmofb-bit (and (eq (nmofb-has repl "form-stdlib/native-model-owner-request-flow.bml") 1)
                        (eq (nmofb-has repl "(nmof-summary (nmof-run-current))") 1)) 16384)
        (nmofb-bit (and (eq (nmofb-has repl "model-flow: advance one token") 1)
                        (and (eq (nmofb-has repl "form-cli-author-high.bml") 1)
                             (eq (nmofb-has repl "form-cli-author-high-xtal.fk") 0))) 32768))))
