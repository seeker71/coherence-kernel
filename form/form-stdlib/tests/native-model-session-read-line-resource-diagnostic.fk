; native-model-session-read-line-resource-diagnostic.fk -- public witness for
; string growth while the bounded file cursor extracts one long first line.
; preludes: form-stdlib/native-model-session-grounding-native-common.fk

(do
    (defn nmsgrlrd-double (text remaining)
        (if (le remaining 0) text
            (nmsgrlrd-double (str_concat text text) (sub remaining 1))))
    (defn native-model-session-read-line-resource-diagnostic ()
        (do
            (let root
                (fs-path-join (fs-temp-dir)
                    (str_concat "native-session-read-line-resource-"
                        (int_to_str (now_unix_ms)))))
            (let made (fs-mkdir root))
            (let path (fs-path-join root "public.jsonl"))
            (let payload (nmsgrlrd-double "x" 15))
            (let written
                (fs-write-text path
                    (str_concat payload "\npublic-second-line\n")))
            (let strings-before (kernel_stat 5))
            (let row (nmsgn-read-line path (fs-stat-size path) 0))
            (let strings-after (kernel_stat 5))
            (let cleaned (fs-remove-tree root))
            (list
                (str_len (nmsgn-file-line-text row))
                (nmsgn-file-line-next row)
                (nmsgn-file-line-eof row)
                (sub strings-after strings-before)
                (str_eq (nmsgn-file-line-text row) payload)
                cleaned)))
    (native-model-session-read-line-resource-diagnostic))
