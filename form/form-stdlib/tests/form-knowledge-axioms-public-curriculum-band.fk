; form-knowledge-axioms-public-curriculum-band.fk -- adversarial, no-model
; witness for the public axioms teaching organ.
;
; This band reads public sources and interns content-addressed nodes.  It does
; not open Qwen, Metal, MLX, a remote provider, or a weight-update carrier.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-fs.fk form-stdlib/file-byte-window.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/form-knowledge-source-search.fk form-stdlib/form-knowledge-axioms-public-curriculum.fk

(do
    (defn fkapb-replace (xs at value i)
        (if (nil? xs) (empty)
            (cons (if (eq i at) value (head xs))
                  (fkapb-replace (tail xs) at value (add i 1)))))

    (defn fkapb-variants-valid? (concept variant)
        (if (gt variant 4) 1
            (do
                (let lesson (fkap-lesson concept variant))
                (let packet (fkap-source-bound-hook concept variant))
                (if (and (eq (fkap-lesson-valid? lesson) 1)
                         (eq (fkap-packet-valid? packet) 1))
                    (fkapb-variants-valid? concept (add variant 1)) 0))))

    (defn fkapb-all-valid? (entries)
        (if (nil? entries) 1
            (if (eq (fkapb-variants-valid? (nth (head entries) 0) 0) 1)
                (fkapb-all-valid? (tail entries)) 0)))

    (defn fkapb-all-lessons-valid? (entries)
        (if (nil? entries) 1
            (if (and (eq (fkap-lesson-valid? (fkap-lesson (nth (head entries) 0) 0)) 1)
                     (and (eq (fkap-lesson-valid? (fkap-lesson (nth (head entries) 0) 1)) 1)
                     (and (eq (fkap-lesson-valid? (fkap-lesson (nth (head entries) 0) 2)) 1)
                     (and (eq (fkap-lesson-valid? (fkap-lesson (nth (head entries) 0) 3)) 1)
                          (eq (fkap-lesson-valid? (fkap-lesson (nth (head entries) 0) 4)) 1)))))
                (fkapb-all-lessons-valid? (tail entries)) 0)))

    (defn fkapb-bit (ok bit) (if ok bit 0))

    (let entries (fkap-entries))
    (let choice-entry (fkap-find "choice" entries))
    (let cut-entry (fkap-find "cut" entries))
    (let timeout-entry (fkap-find "timeout" entries))
    (let undo-entry (fkap-find "undo" entries))
    (let thought-entry (fkap-find "thought-kernel" entries))
    (let jit-entry (fkap-find "auto-jit" entries))
    (let adaptive-entry (fkap-find "adaptive-census" entries))
    (let direct (fkap-lesson "states" 0))
    (let paraphrase (fkap-lesson "states" 1))
    (let corner (fkap-lesson "states" 2))
    (let bound (fkap-lesson "states" 3))
    (let explicit (fkap-lesson "states" 4))
    (let packet (fkap-source-bound-hook "states" 0))
    (let tampered-answer (fkapb-replace direct 6 "0" 0))
    (let tampered-path (fkapb-replace direct 7 "axioms/missing.form" 0))
    (let tampered-packet-answer (fkapb-replace packet 11 "nothing" 0))
    (let tampered-packet-source (fkapb-replace packet 13 "sha256:00" 0))

    (add
        (fkapb-bit (eq (len entries) 15) 1)
    (add
        (fkapb-bit (eq (fkapb-all-lessons-valid? entries) 1) 2)
    (add
        (fkapb-bit (eq (fkapb-all-valid? entries) 1) 4)
    (add
        (fkapb-bit (node_eq (nth direct 1) (nth (fkap-lesson "states" 0) 1)) 8)
    (add
        (fkapb-bit (and (not (node_eq (nth direct 1) (nth paraphrase 1)))
                    (and (not (node_eq (nth direct 1) (nth corner 1)))
                    (and (not (node_eq (nth direct 1) (nth bound 1)))
                         (not (node_eq (nth direct 1) (nth explicit 1)))))) 16)
    (add
        (fkapb-bit (and (nothing? (fkap-lesson "unknown" 0))
                        (nothing? (fkap-source-bound-hook "unknown" 0))) 32)
    (add
        (fkapb-bit (and (nothing? (fkap-lesson "states" -1))
                        (nothing? (fkap-lesson "states" 5))) 64)
    (add
        (fkapb-bit (eq (fkap-lesson-valid? tampered-answer) 0) 128)
    (add
        (fkapb-bit (eq (fkap-lesson-valid? tampered-path) 0) 256)
    (add
        (fkapb-bit (eq (fkap-packet-valid? tampered-packet-answer) 0) 512)
    (add
        (fkapb-bit (eq (fkap-packet-valid? tampered-packet-source) 0) 1024)
    (add
        (fkapb-bit (and (node_eq (node_category (nth direct 1))
                                 (make_nodeid 31 2 0 120))
                    (and (node_eq (node_category (nth packet 1))
                                  (make_nodeid 31 2 0 121))
                         (node_eq (node_category (nth packet 3))
                                  (make_nodeid 31 2 0 122)))) 2048)
    (add
        (fkapb-bit (str_eq (nth packet 8) (fkap-query (fkap-find "states" entries) 1)) 4096)
    (add
        (fkapb-bit (and (str_eq (nth packet 9) (fkap-query (fkap-find "states" entries) 0))
                        (ge (str_find (nth packet 9) "axioms/core-axioms.form" 0) 0)) 8192)
    (add
        (fkapb-bit (str_eq (fkap-answer choice-entry 2)
            "Choice returns 0 because zero is non-nothing and therefore answers before the second lane.") 16384)
    (add
        (fkapb-bit (str_eq (fkap-answer cut-entry 2)
            "No. Cut commits even to that acknowledgement and the pruned alternatives do not run.") 32768)
    (add
        (fkapb-bit (str_eq (fkap-answer timeout-entry 2)
            "No. Untried lanes make it timeout, represented as nothing, not exhaustion.") 65536)
    (add
        (fkapb-bit (str_eq (fkap-answer undo-entry 2)
            "The exact stored cursor checkpoint resumes, not the partially changed cursor.") 131072)
    (add
        (fkapb-bit (and (str_eq (fkap-answer thought-entry 2)
                            "The route abstains as nothing instead of guessing a learned answer.")
                        (str_eq (fkap-answer jit-entry 2)
                            "No. The plan is useful, but live-native remains 0 until separate carrier evidence arrives.")) 262144)
    (add
        (fkapb-bit (str_eq (fkap-answer adaptive-entry 2)
            "No. Re-observe the living body and select the next window from the new projection.") 524288)
        (fkapb-bit (and (str_eq (nth packet 16) "public-source-derived")
                    (and (eq (nth packet 17) 0)
                         (eq (nth packet 18) 0))) 1048576)))))))))))))))))))))
)
