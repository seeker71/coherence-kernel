; local-flow-reading-band.bml — the review's own readings: contract, live phase costs and the next repair.
; preludes: form-stdlib/bml/local-flow-reading.bml
; Verdict 4194303
;
; The stamp lines of the first claims are recorded: copied byte for byte from the walk checkout's lane output for
; closure-unit-line option 3 (.hearth/native-turns/closure-unit-line-1790841638464.out lines 1, 5, 51, 719, 723,
; 726, 729; 5196, 5199, 5325, 5328; 5946, 5950, 7206, 7209). The two fixtures under form-stdlib/tests/fixtures
; (lane-out-hw-conflict-named-1.txt, lane-out-closure-unit-line-2.txt) are the walk checkout's lane outputs for the
; day option and for row 19, each kept to its form-code, form-code-context and form-peer stage lines that
; model-session-seal and model-session-open-prefill write (grep -E over the output, order kept, every other line
; dropped): the fold reads nothing else. (walk-world-turns/fallback-1.out is a two-line output for the claim that
; reads a row's output from the walk checkout.) The lane result carries the blocking_check shape the contract
; reading names (W1 adds it to every lane result); a blocking check is the record the check witness writes
; (fccw-record-node: verdict, witness_kind, row, expected, actual, exits, stderr, shape_only).
;     1  a row's lane output is found in the checkout where its turn ran
;     2  the lane result is read from its output among the progress lines
;     4  contract: an unmeetable check (from the result, and from a row's own lane_reason as native-turn-run
;        writes it), a blocking check whose verdict reads unmeetable and one that differs only in shape (from the
;        row), a full candidate a check refuses, a moved contract; an ordinary row, a meetable check and a
;        "meetable" key no writer emits read none
;     8  phases from admission stamps: spawn, seal, open, prefill and the first decode quantum
;    16  phases between stamps: injection, host time, a renewal that restarts the counters, decode
;    32  a row's own phase_ms is read as written; an output with no stamps reads no phases
;    64  the next repair: contract, then guide, split, lane, queue, turn; a lane the walk stopped at its deadline
;        is no lane failure
;   128  the earlier decode reading comes from another option's review row, never this option's own
;   256  sessions: the latest row of each, in the order they last spoke
;   512  this checkout's rows decide openness: a gap green only in the walk stays open here, its line says
;        where it is green and that its landing is pending, and next names the landing after lane and
;        before turn; a gap waiting to land is never cut or contracted (its foil: every checkout's rows read
;        it green, and the base review dropped it from main's view)
;  1024  unknown is never zero: no lane rows read remote work tokens null where the empty fold reads 0; the
;        session line prints the rent row's required remote prompts and tokens and optional review tokens,
;        null when the row carries none
;  2048  local_verified apart: rows reading 1 are verified, rows with no reading (null or absent) unmeasured,
;        and a row reading 0 is neither
;  4096  the split can fail where the sum cannot: the fold's decode and inject IDs read against the lane's own
;        counters in the row agree (1), and one ID off reads 0 and says the split is unproven; a row with no
;        counters, or phases that are the row's own, read nothing
;  8192  a session's lane columns read null while no turn row names any session, and count the rows that name
;        it once one does
; 16384  a lane that gave its memory back (host-memory-low), was refused it (host-memory-held:*), or found the seat
;        taken (model-queued:) tried nothing: its rows are no options (lfr-options), so they are never among the last
;        three options that moved the band nowhere (the foil: the same rows unfiltered read stuck and recommend a
;        split), never a lane failure, and never counted
; 32768  the day option's nine phases reproduce from its recorded lane output (hw-conflict-named option 1, the
;        2.5 h turn that ended at its deadline with its band unmoved): spawn 60230, seal 14014, open 9051, prefill
;        43448, decode 907739, inject 1394831, renew 5968258, host 388828, tail 200669, over 1229 generated and
;        27563 injected IDs, largest renew
; 65536  the renewal re-feed is billed: nine renewals re-fed 92510 prompt IDs (3181, 16376, 2722, 2721, 15981,
;        2968, then 16187 three times) against 27563 injected, 122467 IDs prefilled in all; the lane's own
;        context lines agree with the fold's positions; two renewals fed the length of the one before; the
;        contexts field of a stamp rises one stamp after a renewal's first and makes no renewal; the earlier
;        option (closure-unit-line option 2, row 19 of the review) reproduces its nine phases with no renewal
;131072  each phase's share of the wall is a standing column: renew 664 permille for the day option, shares that
;        sum to within a permille per phase of the wall, the phase line prints each share, the re-fed IDs and
;        where the counts came from, and the next line names a phase that took more than half the wall and says
;        nothing when none did
;262144  a lane killed at its deadline writes no counts: they come from its stamps, apart from the written
;        ones, the wall of that option is counted, and an option with neither count nor stamps is unread with
;        its wall named, never read as 0
;524288  the fold's weak places clamp and name themselves: a second admission whose elapsed fell bills no
;        negative time and counts its opening; a renewal before any ID was generated is billed to renew by the
;        lane's own marker (alone when the new prompt is longer than the old position) and, with none, by the
;        position that fell; the same position with no marker is host time; a renewal whose first stamp the
;        lane never wrote reads pending
;1048576  the ledger holds every option once: the recorded tables of earlier review rows merge by option, a
;        table without fold 2 is folded again, the pool reads only tables with a wall and renewals, and the next
;        line keeps the prefix host-walk reads
;2097152  a row both checkouts hold is tagged with this one, though its turn ran in the walk checkout: when its
;        output is not where the row says and the walk checkout holds it, that one is read (read only); an output
;        the row's own checkout holds wins, a walk the row is already tagged with is no second place, and with no
;        output anywhere the row's own path stays (the foils: no walk, a walk without the output, both holding it)
section [form.bml] {
 class LocalFlowReadingBand {
  def lrb-claim(ok, bit) = if ok then bit else 0;
  def lrb-n(doc, key) = fcgp-num(doc, key) ?? (0 - 1);
  def lrb-row(text) = parse-json("row", text);
  def lrb-admission() = mc-cat(["form-peer stage route=model-admission phase=model-session-seal-begin status=begin stamp-ms=1790841639777\n", "form-peer stage route=model-admission phase=model-session-seal-complete status=value stamp-ms=1790841654207\n", "form-peer stage route=model-admission phase=model-session-open-prefill-begin status=begin stamp-ms=1790841661654\n", "form-peer stage route=model-admission phase=model-session-open-prefill-complete status=value stamp-ms=1790841814587\n", "form-code {\"mode\":\"code\",\"stage\":\"repair\",\"turns\":48,\"tool_calls\":28,\"repairs\":20,\"checks\":9,\"generated_ids\":0,\"injected_ids\":0,\"position\":4951,\"elapsed_ms\":176882}\n", "form-code {\"mode\":\"code\",\"stage\":\"repair\",\"turns\":48,\"tool_calls\":28,\"repairs\":20,\"checks\":9,\"generated_ids\":4,\"injected_ids\":0,\"position\":4954,\"elapsed_ms\":178800}\n", "form-code {\"mode\":\"code\",\"stage\":\"repair\",\"turns\":48,\"tool_calls\":28,\"repairs\":20,\"checks\":9,\"generated_ids\":8,\"injected_ids\":0,\"position\":4958,\"elapsed_ms\":179759}\n"]);
  def lrb-injection() = mc-cat(["form-code {\"mode\":\"code\",\"stage\":\"implement\",\"turns\":57,\"tool_calls\":31,\"repairs\":23,\"checks\":10,\"generated_ids\":4442,\"injected_ids\":5344,\"position\":14736,\"elapsed_ms\":3254313}\n", "form-code {\"mode\":\"code\",\"stage\":\"implement\",\"turns\":57,\"tool_calls\":31,\"repairs\":23,\"checks\":10,\"generated_ids\":4442,\"injected_ids\":5344,\"position\":14737,\"elapsed_ms\":3254706}\n", "form-code {\"mode\":\"code\",\"stage\":\"repair\",\"turns\":58,\"tool_calls\":32,\"repairs\":24,\"checks\":10,\"generated_ids\":4442,\"injected_ids\":5932,\"position\":15325,\"elapsed_ms\":3298058}\n", "form-code {\"mode\":\"code\",\"stage\":\"repair\",\"turns\":58,\"tool_calls\":32,\"repairs\":24,\"checks\":10,\"generated_ids\":4446,\"injected_ids\":5932,\"position\":15328,\"elapsed_ms\":3299527}\n"]);
  def lrb-renewal() = mc-cat(["form-code {\"mode\":\"code\",\"stage\":\"repair\",\"turns\":58,\"tool_calls\":32,\"repairs\":24,\"checks\":10,\"generated_ids\":5267,\"injected_ids\":5932,\"position\":16150,\"elapsed_ms\":3619706}\n", "form-code {\"mode\":\"code\",\"stage\":\"attention\",\"turns\":59,\"tool_calls\":32,\"repairs\":24,\"checks\":10,\"generated_ids\":5267,\"injected_ids\":5932,\"position\":16150,\"elapsed_ms\":3627591}\n", "form-code {\"mode\":\"code\",\"stage\":\"implement\",\"turns\":59,\"tool_calls\":32,\"repairs\":24,\"checks\":10,\"generated_ids\":0,\"injected_ids\":0,\"position\":6541,\"elapsed_ms\":3782324}\n", "form-code {\"mode\":\"code\",\"stage\":\"implement\",\"turns\":59,\"tool_calls\":32,\"repairs\":24,\"checks\":10,\"generated_ids\":4,\"injected_ids\":0,\"position\":6544,\"elapsed_ms\":3783355}\n"]);
  def lrb-result() = "{\"schema\":\"form-native-code-v1\",\"mode\":\"code\",\"status\":\"attention\",\"reason\":\"caller-check-unmeetable\",\"blocking_check\":{\"row\":0,\"expected\":\"1\\n\",\"actual\":\"form/form-stdlib/closure-lines.fk:1\\n\",\"witness_kind\":\"rg-count\"},\"generated_ids\":0,\"injected_ids\":0}";
  // a blocking check as the check witness records it (fccw-record-node, form-cli-check-witness.bml)
  def lrb-record(verdict, kind, expected, actual, shape) = mc-cat(["{\"verdict\":\"", verdict, "\",\"witness_kind\":\"", kind, "\",\"row\":{\"tool\":\"rg\",\"arguments\":[\"-c\",\"x\",\"f.fk\"],\"stdout\":\"", expected, "\"},\"expected\":\"", expected, "\",\"actual\":\"", actual, "\",\"exit_expected\":0,\"exit_actual\":0,\"stderr\":\"\",\"shape_only\":", shape.str(), "}"]);
  def lrb-stuck(gap) = [lrb-row(mc-cat(["{\"gap\":\"", gap, "\",\"option\":1,\"band_before\":7,\"band_after\":7,\"lane\":\"lane-exit=0\"}"])), lrb-row(mc-cat(["{\"gap\":\"", gap, "\",\"option\":2,\"band_before\":7,\"band_after\":7,\"lane\":\"lane-exit=0\"}"])), lrb-row(mc-cat(["{\"gap\":\"", gap, "\",\"option\":3,\"band_before\":7,\"band_after\":7,\"lane\":\"lane-exit=0\"}"]))];
  // 16384: rows of a lane that gave its memory back (host-memory-low) or was refused it (host-memory-held:*) are no
  // options: through the real lfr-options, lfr-stuck? and lfr-next, two unmoved options between five memory rows are
  // not three options that moved the band nowhere (the gap is not split), three unmoved options still are, and the
  // option count leaves the memory rows out
  def lrb-opt(gap, n, reason) = lrb-row(mc-cat(["{\"gap\":\"", gap, "\",\"option\":", n.str(), ",\"band_before\":7,\"band_after\":7,\"lane\":\"lane-exit=0\",\"lane_reason\":\"", reason, "\"}"]));
  def lrb-memory-reads() {
   let gap = lrb-row("{\"id\":\"g\",\"full\":31}");
   let mixed = [lrb-opt("g", 1, "host-memory-low"), lrb-opt("g", 2, "caller-turn-budget-reached;checkpoint-retained"), lrb-opt("g", 3, "host-memory-low"), lrb-opt("g", 4, "host-memory-held:reserve"), lrb-opt("g", 5, "caller-turn-budget-reached;checkpoint-retained"), lrb-opt("g", 6, "host-memory-low"), lrb-opt("g", 7, "model-queued: fcms-open queued at 2 of 2: a load is ahead of it")];
   let plain = [lrb-opt("g", 1, "x"), lrb-opt("g", 2, "x"), lrb-opt("g", 3, "x")];
   let kept = lfr-options(mixed);
   let next = lfr-next([lfr-gap-reading(gap, kept)], kept);
   let foil = lfr-next([lfr-gap-reading(gap, plain)], plain);
   ((Comparable) len(kept) == 2) && (!lfr-stuck?(lfr-gap-rows(kept, "g"))) && lfr-stuck?(lfr-gap-rows(lfr-options(plain), "g")) && lfr-stuck?(lfr-gap-rows(mixed, "g")) && ((String) next[0] != "split") && ((String) foil[0] == "split") && (!lfr-real?(lrb-opt("g", 9, "host-memory-low"))) && (!lfr-real?(lrb-opt("g", 9, "model-queued: fcms-open queued at 1 of 2: a load is ahead of it"))) && lfr-real?(lrb-opt("g", 9, "other"));
  }
  // the recorded lane outputs (see the head) and the ledger rows of the options they belong to
  def lrb-fix(name) = fhn-read(mc-cat(["form/form-stdlib/tests/fixtures/", name]));
  def lrb-day-row() = lrb-row("{\"gap\":\"hw-conflict-named\",\"option\":1,\"at_unix_ms\":1790924408722,\"wall_ms\":8987068,\"lane\":\"lane-deadline\",\"local_generated_ids\":null,\"local_injected_ids\":null}");
  def lrb-r19-row() = lrb-row("{\"gap\":\"closure-unit-line\",\"option\":2,\"at_unix_ms\":1790857444619,\"wall_ms\":1650157,\"lane\":\"lane-exit=0\",\"local_generated_ids\":1895,\"local_injected_ids\":3206}");
  // a stamp and a context line as the lane writes them, for the folds the recorded outputs do not hold
  def lrb-stamp(e, g, i, pos) = mc-cat(["form-code {\"mode\":\"code\",\"generated_ids\":", g.str(), ",\"injected_ids\":", i.str(), ",\"position\":", pos.str(), ",\"elapsed_ms\":", e.str(), "}\n"]);
  def lrb-context(prompt) = mc-cat(["form-code-context {\"renewed\":1,\"context_prompt_ids\":", prompt.str(), ",\"generated_ids\":0,\"injected_ids\":0}\n"]);
  def lrb-nine(ms, a, b, c, d, e, f, g, h, i) = ((Comparable) lrb-n(ms, "spawn") == a) && ((Comparable) lrb-n(ms, "seal") == b) && ((Comparable) lrb-n(ms, "open") == c) && ((Comparable) lrb-n(ms, "prefill") == d) && ((Comparable) lrb-n(ms, "decode") == e) && ((Comparable) lrb-n(ms, "inject") == f) && ((Comparable) lrb-n(ms, "renew") == g) && ((Comparable) lrb-n(ms, "host") == h) && ((Comparable) lrb-n(ms, "tail") == i);
  def lrb-sum-pm(sh) = foldl((acc, k) => acc + lrb-n(sh, k), 0, lfr-phase-names());
  def lrb-score() {
   let walkRow = lrb-row("{\"gap\":\"g\",\"request\":\".hearth/native-turns/g-1.json\",\"checkout\":\"/x/walk\"}");
   let hereRow = lrb-row("{\"gap\":\"g\",\"request\":\".hearth/native-turns/g-1.json\",\"checkout\":\"\"}");
   let c1 = lrb-claim(((String) lfr-out-path(walkRow) == "/x/walk/.hearth/native-turns/g-1.out") && ((String) lfr-out-path(hereRow) == ".hearth/native-turns/g-1.out") && ((String) lfr-out-path(lrb-row("{\"gap\":\"g\"}")) == ""), 1);
   let result = lfr-lane-result(mc-cat([lrb-admission(), lrb-result(), "\n", "form-code-context {\"x\":1}\n"]));
   let c2 = lrb-claim(((String) fcgp-str(result, "reason") == "caller-check-unmeetable") && ((Comparable) len(json-object-pairs(lfr-lane-result(lrb-admission()))) == 0), 2);
   let gap = lrb-row("{\"id\":\"g\",\"full\":31}");
   let plain = lrb-row("{\"gap\":\"g\",\"band_green\":0}");
   let empty = json-node-object([]);
   let w1 = lfr-contract-why(gap, plain, result);
   let w2 = lfr-contract-why(gap, lrb-row(mc-cat(["{\"gap\":\"g\",\"blocking_check\":", lrb-record("unmeetable", "fixed", "2\\n", "1\\n", 0), "}"])), empty);
   let w3 = lfr-contract-why(gap, lrb-row(mc-cat(["{\"gap\":\"g\",\"blocking_check\":", lrb-record("refuses", "delivered", "1\\n", "p:1\\n", 1), "}"])), empty);
   let w4 = lfr-contract-why(gap, lrb-row("{\"gap\":\"g\",\"candidate_band\":31,\"band_green\":0}"), empty);
   let w5 = lfr-contract-why(gap, lrb-row("{\"gap\":\"g\",\"contract_moved\":1}"), empty);
   let w6 = lfr-contract-why(gap, lrb-row(mc-cat(["{\"gap\":\"g\",\"candidate_band\":28,\"band_green\":0,\"blocking_check\":", lrb-record("meetable", "constructed", "1\\n", "1\\n", 0), "}"])), empty);
   let w7 = lfr-contract-why(gap, lrb-row(mc-cat(["{\"gap\":\"g\",\"band_green\":0,\"lane_reason\":\"caller-check-unmeetable\",\"blocking_check\":", lrb-record("unmeetable", "fixed", "3\\n", "0\\n", 0), "}"])), empty);
   let w8 = lfr-contract-why(gap, lrb-row("{\"gap\":\"g\",\"blocking_check\":{\"meetable\":0,\"expected\":\"2\\n\",\"actual\":\"1\\n\"}}"), empty);
   let c3 = lrb-claim(((String) w1 == "the lane refused a caller check no candidate can meet (expected \"1\\n\", actual \"form/form-stdlib/closure-lines.fk:1\\n\")") && ((Comparable) str_find(w2, "its caller check cannot be met (expected \"2\\n\"", 0) == 0) && (str_find(w3, "only in shape", 0) >= 0) && ((String) w4 == "its checks refuse a candidate the band reads full") && ((String) w5 == "its contract moved under the walk") && ((String) w6 == "") && ((String) w7 == "the lane refused a caller check no candidate can meet (expected \"3\\n\", actual \"0\\n\")") && ((String) w8 == "") && ((String) lfr-contract-why(gap, plain, empty) == ""), 4);
   let option = lrb-row("{\"gap\":\"closure-unit-line\",\"option\":3,\"at_unix_ms\":1790848690473,\"wall_ms\":7052008}");
   let a = lfr-phases(option, lrb-admission());
   let am = fcgp-obj(a, "phase_ms");
   let c4 = lrb-claim(((Comparable) lrb-n(am, "spawn") == 1312) && ((Comparable) lrb-n(am, "seal") == 14430) && ((Comparable) lrb-n(am, "prefill") == 152933) && ((Comparable) lrb-n(am, "open") == 9519) && ((Comparable) lrb-n(am, "decode") == 2877) && ((Comparable) lrb-n(a, "decode_ids") == 8) && ((Comparable) lrb-n(a, "stamps") == 3) && ((Comparable) lrb-n(am, "tail") == 6870937) && ((String) lfr-largest(am) == "tail"), 8);
   let y = lfr-phases(option, lrb-injection());
   let ym = fcgp-obj(y, "phase_ms");
   let z = lfr-phases(option, lrb-renewal());
   let zm = fcgp-obj(z, "phase_ms");
   let c5 = lrb-claim(((Comparable) lrb-n(ym, "inject") == 43352) && ((Comparable) lrb-n(y, "inject_ids") == 588) && ((Comparable) lrb-n(ym, "host") == 393) && ((Comparable) lrb-n(ym, "decode") == 1469) && ((Comparable) lrb-n(y, "decode_ids") == 4) && nothing?(fcgp-num(ym, "spawn")) && nothing?(fcgp-num(ym, "seal")) && ((Comparable) lrb-n(zm, "renew") == 154733) && ((Comparable) lrb-n(zm, "host") == 7885) && ((Comparable) lrb-n(zm, "decode") == 1031) && ((Comparable) lrb-n(z, "decode_ids") == 4) && ((String) lfr-largest(zm) == "open"), 16);
   let own = lfr-phases(lrb-row("{\"gap\":\"g\",\"phase_ms\":{\"decode\":900,\"inject\":100},\"local_generated_ids\":30}"), "");
   let c6 = lrb-claim(((String) fcgp-str(own, "source") == "row") && ((Comparable) lrb-n(fcgp-obj(own, "phase_ms"), "decode") == 900) && ((Comparable) lrb-n(own, "decode_ids") == 30) && (!fcgp-present?(lfr-phases(option, "form-peer stage route=x phase=y status=begin stamp-ms=1\n"), "phase_ms")), 32);
   let gA = lrb-row("{\"id\":\"A\",\"full\":31}");
   let gB = lrb-row("{\"id\":\"B\",\"full\":31}");
   let still = lrb-row("{\"earned\":0}");
   let won = lrb-row("{\"earned\":1,\"swervecount\":7}");
   let failedRows = [lrb-row("{\"gap\":\"A\",\"option\":1,\"lane\":\"lane-exit=1\"}"), lrb-row("{\"gap\":\"A\",\"option\":2,\"lane\":\"lane-exit=137\"}")];
   let n1 = lfr-next([[gA, "the lane refused a caller check no candidate can meet", still, ""], [gB, "", won, ""]], lrb-stuck("A"));
   let n2 = lfr-next([[gA, "", still, ""], [gB, "", won, ""]], lrb-stuck("A"));
   let n3 = lfr-next([[gA, "", still, ""]], lrb-stuck("A"));
   let n4 = lfr-next([[gA, "", still, ""]], failedRows);
   let n5 = lfr-next([], []);
   let n6 = lfr-next([[gA, "", still, ""]], []);
   let stopped = [lrb-row("{\"gap\":\"A\",\"option\":1,\"lane\":\"lane-deadline\"}"), lrb-row("{\"gap\":\"A\",\"option\":2,\"lane\":\"lane-deadline\"}")];
   let c7 = lrb-claim(((String) n1[0] == "contract") && ((String) n1[1] == "contract A: the lane refused a caller check no candidate can meet; heal the contract, not the lane") && ((String) n2[0] == "guide") && (str_find(n2[1], "guide B:", 0) == 0) && ((String) n3[0] == "split") && ((String) n4[0] == "lane") && ((String) n5[0] == "queue") && ((String) n6[0] == "turn") && ((String) lfr-next([[gA, "", still, ""]], stopped)[0] == "turn"), 64);
   let reviews = [lrb-row("{\"next\":\"turn\"}"), lrb-row("{\"phase\":{\"option_key\":\"1|g|1\",\"decode_ms_per_id\":292}}"), lrb-row("{\"phase\":{\"option_key\":\"2|g|2\",\"decode_ms_per_id\":576}}"), lrb-row("{\"phase\":null}")];
   let c8 = lrb-claim(((Comparable) (lfr-earlier(reviews, "9|g|9") ?? 0) == 576) && ((Comparable) (lfr-earlier(reviews, "2|g|2") ?? 0) == 292) && nothing?(lfr-earlier([lrb-row("{\"next\":\"turn\"}")], "1|g|1")) && ((String) lfr-option-key(lrb-row("{\"at_unix_ms\":5,\"gap\":\"g\",\"option\":2}")) == "5|g|2"), 128);
   let rents = [lrb-row("{\"session\":\"s1\",\"at_unix_ms\":1}"), lrb-row("{\"session\":\"s2\",\"at_unix_ms\":2}"), lrb-row("{\"session\":\"s1\",\"at_unix_ms\":3}")];
   let s = lfr-sessions(rents);
   let c9 = lrb-claim(((Comparable) len(s) == 2) && ((String) fcgp-str(s[0], "session") == "s2") && ((Comparable) lrb-n(s[1], "at_unix_ms") == 3), 256);
   let tagged = [lrb-row("{\"gap\":\"A\",\"option\":1,\"band_green\":1,\"lane\":\"lane-exit=0\",\"checkout\":\"/x/walk\"}"), lrb-row("{\"gap\":\"A\",\"option\":2,\"band_before\":7,\"band_after\":7,\"band_green\":0,\"lane\":\"lane-exit=0\",\"checkout\":\"\"}"), lrb-row("{\"gap\":\"B\",\"option\":1,\"band_green\":1,\"lane\":\"lane-exit=0\",\"checkout\":\"\"}")];
   let queue = [gA, gB, lrb-row("{\"id\":\"C\",\"full\":31}")];
   let openHere = filter(g => !lfr-green?(lfr-here(tagged), fcgp-str(g, "id")), queue);
   let readings = map(g => lfr-gap-reading(g, tagged), openHere);
