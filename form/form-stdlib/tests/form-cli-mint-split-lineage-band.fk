; form-cli-mint-split-lineage-band.fk -- spelling and meaning stay distinct.
;
; Verdict 32767 proves stable content identities, transform-only variation,
; visible source overlap, detectable lesson overlap, contract mutation,
; eligibility, and nothing versus numeric-zero behavior evidence.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-cli-mint-split-lineage.fk
; witnessed: 2026-08-26 -> pending

(do
    (defn fmlsb-bit (ok bit) (if ok bit 0))
    (defn fmlsb-sum (bits)
        (if (eq (len bits) 0) 0
            (add (head bits) (fmlsb-sum (tail bits)))))
    (defn fmlsb-row (split source lesson context prefix case-index)
        (fmls-row split "phase"
            (str_concat prefix (str_concat context (str_concat " " lesson)))
            (fmls-source-id source)
            (fmls-lesson-id source "phase" lesson)
            (fmls-transform-id split context prefix case-index)))

    (let source "form/form-stdlib/bml/form-cli-organ-mint.bml")
    (let lesson-a "state ice water gas is orthogonal to substance")
    (let lesson-b "phase invite names a sovereign shift")
    (let train-row (fmlsb-row "train" source lesson-a "substrate phase"
        "Observed " 0))
    (let prefix-only (fmlsb-row "heldout" source lesson-a "substrate phase"
        "Boundary: observed " 0))
    (let new-lesson (fmlsb-row "heldout" source lesson-b "sibling kernels"
        "Boundary: observed " 3))
    (let leak-rows (list train-row prefix-only))
    (let clean-rows (list train-row new-lesson))
    (let train-only (list train-row))
    (let leak-ob (fmls-observation leak-rows "train" "heldout"))
    (let clean-ob (fmls-observation clean-rows "train" "heldout"))
    (let forged-mutation
        (fmls-row "heldout" "frequency" "forged contract"
            (fmls-source-id "another-source")
            (fmls-row-lesson train-row)
            (fmls-transform-id "heldout" "other" "Boundary " 9)))
    (let mutation-rows (list train-row forged-mutation))
    (let behavior-zero
        (fmls-behavior-observation (fmls-row-lesson new-lesson)
            "fkwu" 0 "int" 0 "int" 0 "observed"))
    (let behavior-wrong
        (fmls-behavior-observation (fmls-row-lesson new-lesson)
            "fkwu" 0 "int" 0 "int" 1 "observed"))

    (fmlsb-sum (list
        (fmlsb-bit (node_eq (fmls-source-id source) (fmls-row-source train-row)) 1)
        (fmlsb-bit (node_eq (fmls-lesson-id source "phase" lesson-a)
                            (fmls-row-lesson train-row)) 2)
        (fmlsb-bit (not (node_eq (fmls-row-lesson train-row)
                                 (fmls-row-lesson new-lesson))) 4)
        (fmlsb-bit (not (node_eq (fmls-row-transform train-row)
                                 (fmls-row-transform prefix-only))) 8)
        (fmlsb-bit (and (eq (len (nth leak-ob 1)) 1)
                         (eq (len (nth clean-ob 1)) 1)) 16)
        (fmlsb-bit (eq (len (nth leak-ob 2)) 1) 32)
        (fmlsb-bit (eq (len (nth clean-ob 2)) 0) 64)
        (fmlsb-bit (and (eq (len (nth leak-ob 3)) 0)
                         (eq (len (nth clean-ob 3)) 0)) 128)
        (fmlsb-bit (eq (len (nth leak-ob 4)) 1) 256)
        (fmlsb-bit (and (eq (nth leak-ob 6) 0)
                         (eq (nth clean-ob 6) 1)) 512)
        (fmlsb-bit (and (eq (len (fmls-contract-mutations mutation-rows)) 1)
                         (eq (fmls-lesson-signal mutation-rows "train" "heldout") 0)) 1024)
        (fmlsb-bit (nothing? (fmls-lesson-signal train-only "train" "heldout")) 2048)
        (fmlsb-bit (and (nothing? (fmls-behavior-correct? (nothing)))
                         (eq (fmls-behavior-correct? behavior-zero) 1)) 4096)
        (fmlsb-bit (eq (fmls-behavior-correct? behavior-wrong) 0) 8192)
        (fmlsb-bit (node_eq (head (nth leak-ob 4))
                            (fmls-row-lesson train-row)) 16384)))
)
