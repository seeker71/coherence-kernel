; tests/lcg-bytes-band.fk — the Form LCG meets the two expectations already written
; down for the native it replaces. Verdict 63.
;
; preludes: form-stdlib/core.fk form-stdlib/lcg-bytes.fk
;
; run: ./fkwu form/form-stdlib/tests/lcg-bytes-band.fk   ; -> 63
;
; The witnesses are not invented here. b1 is primitive-registry.fk's own probe row
; for `seeded_bytes` (166). b2..b5 are tests/host-kernel-metal-band.fk's bit-256
; assertions for the seed-7 stream (52 93 210 163). Both were written against the
; sibling-kernel native, so a Form recipe that meets them is the same function and
; not merely a plausible one.
;
; b6 pins determinism itself — the property the contract's "same (seed,count)
; everywhere" actually names — by asking the same call twice and demanding the same
; bytes. Without it the band would pass on a generator that drifted per call.
;
; Pure arithmetic (mul/add/mod over int64), so this crosses wherever core.fk does.

(do
    (defn lcgb-k (cond bit) (if cond bit 0))
    (defn lcgb-eq-at (xs i v) (if (eq (nth xs i) v) 1 0))
    (defn lcgb-list-eq (a b n)
        (if (eq n 0) 1
            (if (eq (nth a (sub n 1)) (nth b (sub n 1)))
                (lcgb-list-eq a b (sub n 1))
                0)))
    (defn lcg-bytes-band ()
        (do
            (let s1 (lcg-bytes 1 2))
            (let s7 (lcg-bytes 7 4))
            (let again (lcg-bytes 7 4))
            (add (add (add (add (add
                ; primitive-registry.fk's probe row for seeded_bytes
                (lcgb-k (eq (lcgb-eq-at s1 0 166) 1) 1)
                ; host-kernel-metal-band.fk's seed-7 stream, byte for byte
                (lcgb-k (eq (lcgb-eq-at s7 0 52) 1) 2))
                (lcgb-k (eq (lcgb-eq-at s7 1 93) 1) 4))
                (lcgb-k (eq (lcgb-eq-at s7 2 210) 1) 8))
                (lcgb-k (eq (lcgb-eq-at s7 3 163) 1) 16))
                ; "same (seed,count) everywhere" begins with same-here-twice
                (lcgb-k (eq (lcgb-list-eq s7 again 4) 1) 32))))
    (lcg-bytes-band))
