; living-world-active-index-band.fk -- one-pass currentness equals the body.
; Verdict 32767 proves fifteen identity, evidence, revocation, and integration claims.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-active-index.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk

(do
    (let world (lwrlw-world))
    (let index (lwai-index world))
    (let round (lwrlw-round))
    (let proposal
        (lwrlw-find-proposal (lwt-round-proposals round)
            (lwrlw-left) (lwrlw-right)))
    (let indexed-proposal
        (lwai-relation-proposal-for
            world index (lwrlw-support-a) 2))
    (let candidate (lwt-proposal-candidate proposal))
    (let edge (lwo-emergent-shape candidate))
    (let global-evidence
        (lwrl-evidence-for world (lwrlw-relation)
            (lwrlw-left) (lwrlw-right)))
    (let indexed-evidence
        (lwai-relation-evidence-for world index (lwrlw-relation)
            (lwrlw-left) (lwrlw-right)))
    (let left-symbol (lwo-emergent-shape (lwrlw-left)))
    (let global-left-evidence
        (lwsl-evidence-for-at world
            (lwnv-symbol-referent left-symbol)
            (lwnv-symbol-coordinate left-symbol)
            (lwnv-symbol-surface left-symbol)))
    (let indexed-left-evidence
        (lwai-symbol-evidence-for-at world index
            (lwnv-symbol-referent left-symbol)
            (lwnv-symbol-coordinate left-symbol)
            (lwnv-symbol-surface left-symbol)))
    (let yes-round (lwrlw-yes-round))
    (let indexed-round
        (lwai-integrate-relation yes-round proposal (lwslw-action)))
    (let indexed-world (lwt-round-world indexed-round))
    (let ordinary-world (lwt-round-world (lwrlw-integrated-round)))
    (let indexed-outcome (lwt-outcome-for indexed-round proposal))
    (let revoked (lwrlw-revoked-world))
    (let revoked-index (lwai-index revoked))
    (let late (lwrlw-cycle-world))
    (let late-index (lwai-index late))

    (let c1 (if (and (eq (lwai-index? index) 1)
                         (node_eq (lwai-index-path index)
                              (lwo-local-path))) 1 0))
    (let c2 (if (and (eq (lwai-active? index (lwrlw-support-a)) 1)
                         (eq (lwai-active? index candidate) 0)) 2 0))
    (let c3 (if (node_eq (lwai-index-revocations index)
                         (lwo-world-revocations world)) 4 0))
    (let c4 (if (node_eq
                         (lwai-active-attributions-for
                            index (lwrlw-support-a))
                         (lwo-active-attributions-for
                            world (lwrlw-support-a))) 8 0))
    (let c5 (if (node_eq indexed-left-evidence
                         global-left-evidence) 16 0))
    (let c6 (if (and (eq (lwai-symbol-candidate-current?
                              world index (lwrlw-left)) 1)
                         (eq (lwsl-candidate-current?
                              world (lwrlw-left)) 1)) 32 0))
    (let c7 (if (and (node_eq indexed-proposal proposal)
                         (and (node_eq indexed-evidence global-evidence)
                              (node_eq indexed-evidence
                                   (lwrl-edge-evidence edge)))) 64 0))
    (let c8 (if (and (eq (lwai-relation-candidate-current?
                              world index candidate) 1)
                         (eq (lwrl-candidate-current?
                              world candidate) 1)) 128 0))
    (let c9 (if (and (eq (lwai-emergent-ready? index candidate) 1)
                         (eq (lwo-emergent-ready? world candidate) 1)) 256 0))
    (let c10 (if (eq (lwo-active? indexed-world candidate) 1) 512 0))
    (let c11 (if (eq (lwo-field-size
                          (lwo-active-attributions-for
                            indexed-world candidate)) 7) 1024 0))
    (let c12 (if (node_eq (lwt-outcome-status indexed-outcome)
                          (lwt-status-acknowledged)) 2048 0))
    (let c13 (if (and (eq (lwai-relation-candidate-current?
                               revoked revoked-index candidate) 0)
                          (eq (lwrl-candidate-current?
                               revoked candidate) 0)) 4096 0))
    (let c14 (if (and (eq (lwai-relation-candidate-current?
                               late late-index candidate) 0)
                          (eq (lwrl-candidate-current?
                               late candidate) 0)) 8192 0))
    (let c15 (if (node_eq indexed-world ordinary-world) 16384 0))
    (lwrlw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
