; parse-int-absent-band.bml — parse-int reads a reading that did not arrive as nothing(), never a stop (parse.bml, parse-int).
;
; parse.bml says a reading that did not arrive is nothing(); parse-int hands an absent reading to trim, and the kernel stops
; on its length. Text still reads as it does, and only text reads: an int handed in is no spelling of an int.
;
; Expected: 31
; Verdict 31 when every claim lands:
;   1   an absent reading answers nothing()
;   2   digits read as the int, signed and trimmed
;   4   text that is no int answers nothing()
;   8   an int handed in answers nothing(): no reading is made by rendering a value as text
;   16  a list handed in answers nothing()
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/parse.bml
section [form.bml] {
 class ParseIntAbsentBand {
  def pia-is?(v, want) = ((String) value_kind(v) == "int") && ((Comparable) v == want);
  def pia-c-absent(ctx) = nothing?(parse-int(nothing()));
  def pia-c-digits(ctx) = pia-is?(parse-int("42"), 42) && pia-is?(parse-int(" -7 "), -7) && pia-is?(parse-int("+3"), 3);
  def pia-c-text(ctx) = nothing?(parse-int("x")) && nothing?(parse-int("")) && nothing?(parse-int("+")) && pia-is?(parse-int("9"), 9);
  def pia-c-int(ctx) = nothing?(parse-int(7)) && pia-is?(parse-int("7"), 7);
  def pia-c-list(ctx) = nothing?(parse-int(["7"])) && pia-is?(parse-int("8"), 8);
 }
 live-claims("parse-int-absent-band", 0, [["absent", 1, 1, pia-c-absent], ["digits", 2, 1, pia-c-digits], ["text", 4, 1, pia-c-text], ["int", 8, 1, pia-c-int], ["list", 16, 1, pia-c-list]]);
}
