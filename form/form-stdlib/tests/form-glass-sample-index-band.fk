; Pure identity fast-path and reuse equivalence, including aliases. Expected 8191.
; preludes: form/form-stdlib/form-glass-live.bml
(do
 (defn fgsi-sample (id kind handle) (fgtm-sample id (fgtm-absent) kind "form" "fixture" "test" "test" (fgtm-absent) (fgtm-absent) "active" (fgtm-present 1) (fgtm-present 2) (fgtm-absent) handle "pinned" "physical-live" "fixture" (list)))
 (defn fgsi-entry (epoch publisher id kind handle) (fgl-sample-entry epoch publisher (fgsi-sample id kind handle)))
 (defn fgsi-agrees (entries) (value_eq (fgl-newest-samples-by-snapshot entries) (fgl-entry-samples (fgl-newest-entries entries (list)))))
 (let one (fgsi-entry 1 "p" "guabx" "metric" (fgtm-absent)))
 (let two (fgsi-entry 2 "p" "naaeaa" "metric" (fgtm-absent)))
 (let newer (fgsi-entry 3 "p" "guabx" "metric" (fgtm-absent)))
 (let model (fgsi-entry 1 "p" "model-a" "model" (fgtm-present 9)))
 (let alias (fgsi-entry 2 "p" "model-b" "model" (fgtm-present 9)))
 (let other (fgsi-entry 3 "q" "model-b" "model" (fgtm-present 9)))
 (let transition (fgsi-entry 4 "p" "model-b" "model" (fgtm-present 10)))
 (let cache (fgl-entry-cache (list one two) (list)))
 (let changed (fgl-entry-cache (list newer two) cache))
 (let aliased (fgl-entry-cache (list model alias) cache))
 (let idCache (fgl-dedupe-cache (fgl-entry-samples (list one two one)) (list)))
 (let idNext (fgl-dedupe-cache (fgl-entry-samples (list newer two one)) idCache))
 (let idReordered (fgl-dedupe-cache (fgl-entry-samples (list two newer one)) idNext))
 (sum (list
  (if (fgsi-agrees (list)) 1 0)
  (if (and (fgl-entries-distinct (list one two) (km-for 4)) (fgsi-agrees (list one two))) 2 0)
  (if (and (not (fgl-entries-distinct (list one newer) (km-for 4))) (fgsi-agrees (list one newer))) 4 0)
  (if (fgsi-agrees (list newer one two)) 8 0)
  (if (and (not (fgl-entries-distinct (list model alias) (km-for 4))) (fgsi-agrees (list model alias))) 16 0)
  (if (and (fgl-entries-distinct (list model other) (km-for 4)) (fgsi-agrees (list model other))) 32 0)
  (if (fgsi-agrees (list model alias transition other)) 64 0)
  (if (fgsi-agrees (list one (fgsi-entry 2 "p:guabx" "" "metric" (fgtm-absent)) two)) 128 0)
  (if (and (eq (nth changed 1) 1) (value_eq (fgl-entry-cache-values changed) (fgl-entry-samples (list newer two)))) 256 0)
  (if (and (eq (nth aliased 1) 0) (value_eq (fgl-entry-cache-values aliased) (fgl-newest-samples-by-snapshot (list model alias)))) 512 0)
  (if (and (value_eq (nth idCache 1) (nth idNext 1)) (value_eq (fgl-dedupe-cache-values idNext) (fgl-entry-samples (list newer two)))) 1024 0)
  (if (value_eq (fgl-dedupe-cache-values idReordered) (fgl-entry-samples (list two newer))) 2048 0)
  (if (and (not (fgl-same-entry-keys (list model) (list transition))) (not (fgl-same-entry-keys (list model) (list other)))) 4096 0))))
