; form-cli-unique-mint-band.fk — unique cells mint diverse samples; overlay fits.
;
; Verdict 1023:
;   1..128  fnu-check (n, mix, leakage, unique, split, heldout>=7, lora-writer=0, scales)
;   256     class descriptor FormUniqueMint minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-unique-mint-xtal.fk
; witnessed: 2026-08-26 -> 1023; minted heldout 9/9 leakage 0; lora-writer 0

(do
    (defn fnub-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn fnub-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (fnub-has-name? (tail xs) name))))

    (let bits (fnu-check))
    (let desc (FormUniqueMint))
    (let src (read_file "form/form-stdlib/bml/form-cli-unique-mint.bml"))
    (let exe (read_file "form/form-stdlib/form-cli-unique-mint.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormUniqueMint")
                     (and (eq (fnub-has-name? (nth desc 2) "T") 1)
                          (and (eq (fnub-has-name? (nth desc 3) "fnu-corpus") 1)
                               (eq (fnub-has-name? (nth desc 4) "MixA") 1))))
                256 0))
    (let b9 (if (and (eq (fnub-has-str? src "package Form.cli.uniquemint") 1)
                     (and (eq (fnub-has-str? src "interface IUniqueMint") 1)
                          (and (eq (fnub-has-str? src "class FormUniqueMint") 1)
                               (and (eq (fnub-has-str? src "const int MixA") 1)
                                    (and (eq (fnub-has-str? src "template SampleRow") 1)
                                         (and (eq (fnub-has-str? exe "heldout-v3") 0)
                                              (eq (fnub-has-str? exe "turn_started") 0)))))))
                512 0))
    (add bits (add b8 b9)))
