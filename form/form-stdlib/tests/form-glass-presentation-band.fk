; Terminal write evidence is separate from collection; unchanged/failed writes
; cannot advance it. No terminal output or living telemetry writes. Expected 31.
; preludes: form-stdlib/form-glass-live.bml
(do
 (let before (fgel-buffer-empty))
 (let staged (fgel-buffer-stage before (list "fixture")))
 (let after (fgel-buffer-commit staged))
 (let reading (fgl-presentation-value 1000 1038 1040 before after))
 (sum (list
  (if (value_eq reading (list "form-glass-presentation-v1" 1000 1040 40 2 1)) 1 0)
  (if (nil? (fgl-presentation-value 1000 1038 1040 before staged)) 2 0)
  (if (nil? (fgl-presentation-value 1000 1038 1040 before (fgl-render-commit -1 before after))) 4 0)
  (if (nil? (fgl-presentation-value 2000 2038 2040 after after)) 8 0)
  (if (eq (nth (fgl-presentation-value 1000 1038 1040 before after) 4) 2) 16 0))))
