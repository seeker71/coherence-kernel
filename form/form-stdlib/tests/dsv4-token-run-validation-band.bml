; dsv4-token-run-validation-band.bml -- the token door's validation reading: the head's logits against a recording and a stream against its recorded ids, judged, on SYNTHETIC vectors, with nothing opened.
;
; WHAT THIS PINS. form-stdlib/bml/dsv4-token-run.bml reads, when asked ({"go":1,"logits":1}, or the recorded stream's own raw prompt), the head's 129,280 logits after the 14-id prefill and sets them against the recording
; form/form-stdlib/tests/oracles/ds4-logits-capital-of-france.json (pinned SHA-256 3898af17...9d27) with the validation door's own functions (dsv4-validate.bml: dvr-agreement, dvr-step, dvr-matched, dvr-ref-logits:
; ONE authority), and keeps every step's top-two margin and the recorded id's gap. What the token door adds is the JUDGEMENT: pass or fail and which fact failed (the argmax ours against theirs, theirs against the
; recorded 2581, finiteness, the TIE BUDGET (the validate door's dvr-tie-safe?: the reference's top-two margin exceeds twice our largest delta over its top 64) and the largest delta against the spread ds4 itself shows,
; 2.1636 logits: corpus row 973, commit 378db372f, ds4 metal against ds4 cpu on one point of the REAP25 file). Pearson r and the top-10 overlap are READINGS, not floors: the first real reading (r 0.9974, overlap 8, delta
; 0.92 under a margin of 10.37, argmax 2581) is a correct engine that guessed floors called a failure. This band holds the judgement on a synthetic recording of 300 values (a peak of 60 at 123, a second of 55 at 77, the
; rest a sawtooth below 19) and on ours = the recording plus a rounding-sized noise, then plants one defect at a time: each must read as its own failure, and the readings that are not failures must pass. THE COST of the
; compare is held on a synthetic 129,280-value vector (the head's size): every reduction is one linear pass with a cursor, the whole agreement and a stream step and the finiteness scan under a stated wall ceiling, and the
; quadratic form the first real run used (an index and a length asked at every element: 20 minutes) fails that ceiling.
;
; Verdict 127 when every claim lands:
;   1     the good vector (the recording plus noise under 1e-4): argmax 123 on both sides, top-10 overlap 10, r above 0.999999, tie_safe, failed [], verdict pass; the judged JSON carries r, the overlap, both argmaxes,
;         the reference margin 5, the delta, finite 1, tie_safe 1, the recorded argmax and the verdict
;   2     the plants, each its own failure: ours with the second-best raised above the best (argmax-ours-not-theirs; the recorded-argmax fact still holds against 123); a recorded argmax that is not the recording's
;         (argmax-not-recorded: want 2581 against a recording whose argmax is 123); non-finite logits (not-finite); two of the top-10 pushed down by 6 (tie-budget and delta-over-ds4-spread: twice the delta 6 is over the margin 5, and 6 is over
;         2.1636); a recording with a margin of 1 and one top-10 member pushed by 1 (tie-budget alone: delta 1 is within the spread but 2 is over the margin); and the READINGS that
;         are not failures: noise of amplitude 3 on the bottom of the recording (r under 0.999, the argmax, margin and delta intact: pass), two top-10 members pushed down by 1.8 (overlap under 9, delta 1.8 under both the
;         spread and the budget: pass), the recording shifted by a constant 3 (r 1 and overlap 10, yet delta 3 is over the spread and twice it over the margin: it fails both, so a perfect r does not pass)
;   4     the stream's reading: the recorded 24 ids matched 24 of 24; a wrong id planted at index 5 matched 5 of 24; a prompt that is not the recorded raw one reads matched -1 of 0; the per-step margins and recorded gaps
;         carried through as the validate door's dvr-step reads them
;   8     the validation object of a run's receipt row, assembled from a run's environment (dtr-validation-json): off reads {}; on with a prefill's logits and an injected recording judges them (pass); with a planted wrong
;         argmax it fails; with no logits kept it reads not-run; with a recording of another length it fails on length; the stream part carries the ids the walk answered (read from its rows) and the steps' readings
;   16    the plan's line: validation ON for the option logits 1 and for the recorded stream's raw prompt, off otherwise, with the pass rule (the recorded argmax, the tie budget, ds4's spread; r and the overlap
;         readings), and the pinned recording named; prompt_ids sets the prompt over logits_prompt_ids
;   32    the recorded argmax and the spread are what the plan and the judge read (2581, 2.1636, no r or overlap floor left in the door); the walk's reads happen between rows (the door's loop reads the logits after the
;         row's own closing mark): the source of the door names it
;   64    the cost of the compare, on a synthetic 129,280-value vector (and on a 129,280-float buffer read through the door's own dkr-read): the whole agreement (Pearson r, top-10 against the top 64, max delta, finiteness)
;         under 3,000 ms wall, a stream step (dvr-two) and a finiteness scan each under 1,000 ms, and every number equal to the quadratic form's on a vector small enough to run it; the quadratic form (xs[i] and len(xs)
;         at every element, the first real run's) on the full vector takes over the ceiling
;
; PROOF LEVEL: FOURTH-ARM ONLY -- reads the door's own source for the last claim; the vectors are synthetic and no device is touched.
// preludes: form-stdlib/core.fk form-stdlib/bml/dsv4-token-run.bml
section [form.bml] {
 class Dsv4TokenRunValidationBand {
  def dvb2-bit(held, bit) = held ? bit : 0;
  def dvb2-has?(s, part) = str_find(s, part, 0) >= 0;
  def dvb2-n() = 300;
  def dvb2-gen(f, i, n) = i == n ? [] : cons(f(i), dvb2-gen(f, i + 1, n));
  // the synthetic recording: a sawtooth of period 101 below 19 with a rising 1e-4 a step (so no two values tie), a peak of 60 at 123 and a second of 55 at 77
  def dvb2-base(i) = (1.0 * ((i * 37 + 11) % 101)) * 0.37 - 18.0 + (1.0 * i) * 0.0001;
  def dvb2-ref-at(i) = i == 123 ? 60.0 : (i == 77 ? 55.0 : dvb2-base(i));
  def dvb2-ref() = dvb2-gen(i => dvb2-ref-at(i), 0, dvb2-n());
  // noise that cannot reorder the sawtooth (under half of its 1e-4 step)
  def dvb2-tiny(i) = (1.0 * ((i * 13) % 7)) * 0.000005;
  def dvb2-good() = dvb2-gen(i => dvb2-ref-at(i) + dvb2-tiny(i), 0, dvb2-n());
  // the second-best raised over the best
  def dvb2-flip() = dvb2-gen(i => i == 77 ? 70.0 : dvb2-ref-at(i) + dvb2-tiny(i), 0, dvb2-n());
  // a sawtooth of amplitude 4 on every value but the two peaks
  def dvb2-noisy() = dvb2-gen(i => (i == 123 || i == 77) ? dvb2-ref-at(i) : dvb2-ref-at(i) + (1.0 * (((i * 29) % 17) - 8)) * 0.5, 0, dvb2-n());
  def dvb2-shifted() = dvb2-gen(i => dvb2-ref-at(i) + 3.0, 0, dvb2-n());
  def dvb2-agree(ours) = dvr-agreement(ours, dvb2-ref());
  def dvb2-failed(ours, want) = dtr-logits-failed(dvb2-agree(ours), want);
  def dvb2-member?(xs, v) = len(xs) == 0 ? false : (xs[0] == v || dvb2-member?(xs[1:], v));
  // ---- 1: the good vector ----------------------------------------------------------------------------------------------------
  def dvb2-claim-good() {
   let a = dvb2-agree(dvb2-good());
   let json = dtr-logits-json(a, 123);
   let said = print_str("  good: r " ++ a[0].str() ++ " overlap " ++ a[1].str() ++ " argmax " ++ a[2].str() ++ "/" ++ a[3].str() ++ " margin " ++ a[4].str() ++ " delta " ++ a[5].str() ++ " finite " ++ a[6].str() ++ " -> " ++ json);
   a[2] == 123 && a[3] == 123 && a[1] == 10 && a[0] > 0.999999 && a[6] == 1 && dtr-tie-safe?(a) && len(dtr-logits-failed(a, 123)) == 0
    && dvb2-has?(json, "\"verdict\":\"pass\"") && dvb2-has?(json, "\"failed\":[]") && dvb2-has?(json, "\"tie_safe\":1") && dvb2-has?(json, "\"recorded_argmax\":123") && dvb2-has?(json, "\"argmax_ours\":123") && dvb2-has?(json, "\"argmax_ref\":123")
    && dvb2-has?(json, "\"top10_overlap\":10") && dvb2-has?(json, "\"finite\":1") && dvb2-has?(json, "\"ref_margin\":5") && a[4] > 4.99 && a[4] < 5.01;
  }
  // ---- 2: the plants ---------------------------------------------------------------------------------------------------------
  // the top-10 members at ranks 2 and 3 pushed down by `by` (the peaks stay: the argmax and the margin are intact)
  def dvb2-push(ref, by) {
   let top = dvr-top(ref, 12);
   dvb2-gen(i => (i == top[2] || i == top[3]) ? dvb2-ref-at(i) - by : dvb2-ref-at(i), 0, dvb2-n());
  }
  // the recording with a margin of 1 (the second peak 59)
  def dvb2-close-at(i) = i == 77 ? 59.0 : dvb2-ref-at(i);
  def dvb2-close-ref() = dvb2-gen(i => dvb2-close-at(i), 0, dvb2-n());
  def dvb2-close-pushed() {
   let top = dvr-top(dvb2-close-ref(), 12);
   dvb2-gen(i => i == top[2] ? dvb2-close-at(i) - 1.0 : dvb2-close-at(i), 0, dvb2-n());
  }
  // noise of amplitude 3 on the bottom of the recording only (values under -5: no top-64 member, no peak)
  def dvb2-bottom-noise() = dvb2-gen(i => dvb2-ref-at(i) < 0.0 - 5.0 ? dvb2-ref-at(i) + (1.0 * (((i * 29) % 13) - 6)) * 0.5 : dvb2-ref-at(i), 0, dvb2-n());
  def dvb2-claim-plants() {
   let fFlip = dvb2-failed(dvb2-flip(), 123);
   let fRec = dvb2-failed(dvb2-good(), 2581);
   let fNaN = dtr-logits-failed([1.0, 10, 123, 123, 5.0, 0.0, 0], 123);
   let aP = dvb2-agree(dvb2-push(dvb2-ref(), 6.0));
   let fP = dtr-logits-failed(aP, 123);
   let aC = dvr-agreement(dvb2-close-pushed(), dvb2-close-ref());
   let fC = dtr-logits-failed(aC, 123);
   let aB = dvb2-agree(dvb2-bottom-noise());
   let fB = dtr-logits-failed(aB, 123);
   let aO = dvb2-agree(dvb2-push(dvb2-ref(), 1.8));
   let fO = dtr-logits-failed(aO, 123);
   let aS = dvb2-agree(dvb2-shifted());
   let fS = dtr-logits-failed(aS, 123);
   let said = print_str("  plants: flip " ++ fFlip.str() ++ " | recorded " ++ fRec.str() ++ " | non-finite " ++ fNaN.str() ++ " | pushed 6 " ++ fP.str() ++ " (delta " ++ aP[5].str() ++ ", margin " ++ aP[4].str() ++ ") | margin 1 pushed 1 " ++ fC.str() ++ " (delta " ++ aC[5].str() ++ ", margin " ++ aC[4].str()
    ++ ") | bottom noise " ++ fB.str() ++ " (r " ++ aB[0].str() ++ ", overlap " ++ aB[1].str() ++ ") | pushed 1 " ++ fO.str() ++ " (r " ++ aO[0].str() ++ ", overlap " ++ aO[1].str() ++ ") | shifted " ++ fS.str());
   dvb2-member?(fFlip, "argmax-ours-not-theirs") && !dvb2-member?(fFlip, "argmax-not-recorded")
    && fRec == ["argmax-not-recorded"] && fNaN == ["not-finite"] && !dvb2-member?(fNaN, "tie-budget")
    && dvb2-member?(fP, "tie-budget") && dvb2-member?(fP, "delta-over-ds4-spread") && !dvb2-member?(fP, "argmax-ours-not-theirs")
    && fC == ["tie-budget"] && aC[5] < dtr-ds4-spread() && aC[4] < 1.01 && aC[4] > 0.99
    && len(fB) == 0 && aB[0] < 0.999 && aB[1] == 10 && aB[2] == 123 && dvr-tie-safe?(aB)
    && len(fO) == 0 && aO[1] < 9 && aO[5] < dtr-ds4-spread() && dvr-tie-safe?(aO)
    && dvb2-member?(fS, "delta-over-ds4-spread") && dvb2-member?(fS, "tie-budget") && aS[0] > 0.999999 && aS[1] == 10
    && dvb2-has?(dtr-logits-json(dvb2-agree(dvb2-flip()), 123), "\"verdict\":\"fail\"") && dvb2-has?(dtr-logits-json(dvb2-agree(dvb2-flip()), 123), "argmax-ours-not-theirs")
    && dvb2-has?(dtr-logits-json(aB, 123), "\"verdict\":\"pass\"") && dvb2-has?(dtr-logits-json(aB, 123), "readings, not floors") && dvb2-has?(dtr-logits-json(aB, 123), "\"ds4_spread\":2.1636");
  }
  // ---- 4: the stream ---------------------------------------------------------------------------------------------------------
  def dvb2-reads() = [dvr-step(dvb2-good(), 123), dvr-step(dvb2-good(), 77), dvr-step(dvb2-flip(), 123)];
  def dvb2-wrong-at(ids, i) = dvb2-gen(k => k == i ? ids[k] + 1 : ids[k], 0, len(ids));
  def dvb2-claim-stream() {
   let ids = dvr-stream();
   let reads = dvb2-reads();
   let exact = dtr-stream-json(ids, reads, 1);
   let wrong = dtr-stream-json(dvb2-wrong-at(ids, 5), reads, 1);
   let other = dtr-stream-json(ids, reads, 0);
   let said = print_str("  stream: exact " ++ exact);
   len(ids) == 24 && dvb2-has?(exact, "\"matched\":24") && dvb2-has?(exact, "\"of\":24") && dvb2-has?(exact, "\"recorded_prompt\":1") && dvb2-has?(wrong, "\"matched\":5") && dvb2-has?(other, "\"matched\":-1") && dvb2-has?(other, "\"of\":0") && dvb2-has?(other, "\"recorded_prompt\":0")
    && dvb2-has?(exact, "\"margins\":" ++ dvr-floats-json(dvr-steps-margins(reads))) && dvb2-has?(exact, "\"recorded_gap\":" ++ dvr-floats-json(dvr-steps-gaps(reads)))
    && reads[0][0] == 123 && reads[1][0] == 123 && reads[1][2] > 4.9 && reads[2][0] == 77 && reads[2][2] > 9.9 && reads[2][2] < 10.1;
  }
  // ---- 8: the receipt's validation object, from a run's environment ----------------------------------------------------------
  def dvb2-row(id) = record_new(0, "id_out", id);
  def dvb2-rows(ids) = dvb2-gen(i => dvb2-row(i == 0 ? ids[0] : ids[i]), 0, len(ids));
  def dvb2-env(on, ours, ref, ids) {
   let env = dtr-env(60, 2, 0, 0);
   let a = record_set(env, "val", on);
   let b = record_set(env, "ours", ours);
   let c = record_set(env, "refl", ref);
   let d = record_set(env, "reads", dvb2-reads());
   let e = record_set(env, "rawp", 1);
   let f = record_set(env, "rows", dvb2-rows(ids));
   let g = record_set(env, "refarg", 123);
   env;
  }
  def dvb2-claim-env() {
   let ids = dvr-stream();
   let off = dtr-validation-json(dvb2-env(0, dvb2-good(), dvb2-ref(), ids), ids);
   let on = dtr-validation-json(dvb2-env(1, dvb2-good(), dvb2-ref(), ids), ids);
   let bad = dtr-validation-json(dvb2-env(1, dvb2-flip(), dvb2-ref(), ids), ids);
   let none = dtr-validation-json(dvb2-env(1, [], dvb2-ref(), ids), ids);
   let shortRef = dtr-validation-json(dvb2-env(1, dvb2-good(), dvb2-ref()[0:200], ids), ids);
   let doc = parse-json("validation", on);
   let said = print_str("  env: on " ++ on);
   off == "{}" && dvb2-has?(on, "\"verdict\":\"pass\"") && dvb2-has?(on, "\"logits\":{") && dvb2-has?(on, "\"stream\":{") && dvb2-has?(on, "\"matched\":24") && dvb2-has?(bad, "\"verdict\":\"fail\"") && dvb2-has?(bad, "argmax-ours-not-theirs")
    && dvb2-has?(none, "\"verdict\":\"not-run\"") && dvb2-has?(shortRef, "\"failed\":[\"length\"]") && json-object-has?(doc, "logits") && json-object-has?(doc, "stream")
    && dtr-walk-ids(dvb2-rows(ids)) == ids && dtr-walk-ids([dvb2-row(0 - 1), dvb2-row(7), dvb2-row(0 - 1), dvb2-row(9)]) == [7, 9]
    && dvb2-has?(dtr-validation-line(dvb2-env(0, [], [], ids), off), "validation: off") && dvb2-has?(dtr-validation-line(dvb2-env(1, [], [], ids), on), "validation: {\"logits\"");
  }
  // ---- 16: the plan's line and the prompt option -----------------------------------------------------------------------------
  def dvb2-claim-plan() {
   let off = dtr-validation-plan-line(parse-json("o", "{}"), [1, 2, 3]);
   let on = dtr-validation-plan-line(parse-json("o", "{\"logits\":1}"), [1, 2, 3]);
   let raw = dtr-validation-plan-line(parse-json("o", "{}"), dvr-prompt());
   dvb2-has?(off, "validation off") && dvb2-has?(off, "prompt_ids sets the prompt") && dvb2-has?(on, "validation ON") && dvb2-has?(on, "3898af1731936bf0a59d0c0ce01a60df62f54b9b64552673c7f93df3b7c79d27") && dvb2-has?(on, "PASS needs the argmax (recorded 2581)") && dvb2-has?(on, "readings, not floors") && dvb2-has?(on, "2.1636") && !dvb2-has?(on, "(floor ") && dvb2-has?(on, "outside every row")
    && dvb2-has?(raw, "validation ON") && dtr-validate?(parse-json("o", "{\"logits\":1}"), [1]) && !dtr-validate?(parse-json("o", "{}"), [1]) && dtr-validate?(parse-json("o", "{}"), dvr-prompt()) && !dtr-validate?(parse-json("o", "{\"logits\":0}"), [1])
    && !dtr-hcmv-wide?(parse-json("o", "{}")) && !dtr-hcmv-wide?(parse-json("o", "{\"hc_matvec\":\"compensated\"}")) && dtr-hcmv-wide?(parse-json("o", "{\"hc_matvec\":\"wide\"}"))
    && dvb2-has?(dtr-hcmv-plan-line(parse-json("o", "{\"hc_matvec\":\"wide\"}")), "WIDE (form_dsv4_f16_matvec_wide") && dvb2-has?(dtr-hcmv-plan-line(parse-json("o", "{}")), "COMPENSATED (one thread a row") && dvb2-has?(dtr-hcmv-plan-line(parse-json("o", "{}")), "the default, the bands' reference")
    && dtr-attribution-plan-line(parse-json("o", "{\"attribute\":3}")) != dtr-attribution-plan-line(parse-json("o", "{}")) && dtr-opts-attr(parse-json("o", "{\"attribute\":3}")) == 3
    && dtr-opts-ids(parse-json("o", "{\"prompt_ids\":[5,6],\"logits_prompt_ids\":[7,8]}")) == [5, 6] && dtr-opts-ids(parse-json("o", "{\"logits_prompt_ids\":[7,8]}")) == [7, 8];
  }
  // ---- 64: the cost of the compare on the head's size ---------------------------------------------------------------------------------------------------------
  // a synthetic recording of 129,280 values (distinct: a sawtooth of period 10,007 with a rising 1e-7 a step) and ours = it plus a rounding-sized wobble; the lists are built by a TAIL recursion (they come out reversed, which
  // synthetic data does not mind)
  def dvb2-big-n() = 129280;
  def dvb2-big-gen(f, i, n, acc) = i == n ? acc : dvb2-big-gen(f, i + 1, n, cons(f(i), acc));
  def dvb2-big-at(i) = (1.0 * ((i * 7919 + 13) % 10007)) * 0.001 + (1.0 * i) * 0.0000001;
  def dvb2-ceil-agreement() = 3000;
  def dvb2-ceil-pass() = 1000;
  // THE FORM THE FIRST REAL RUN USED: an index into the list at every element (and a length asked each step), one pass of the stream step's best-and-second
  def dvb2-quad-two-go(xs, i, bi, bv, sv) = i == len(xs) ? [bi, bv, sv] : (xs[i] > bv ? dvb2-quad-two-go(xs, i + 1, i, xs[i], bv) : (xs[i] > sv ? dvb2-quad-two-go(xs, i + 1, bi, bv, xs[i]) : dvb2-quad-two-go(xs, i + 1, bi, bv, sv)));
  def dvb2-quad-two(xs) = dvb2-quad-two-go(xs, 1, 0, xs[0], 0.0 - 1.0e30);
  def dvb2-rep(s, n) = n == 1 ? s : str_concat(dvb2-rep(s, n / 2), dvb2-rep(s, n - (n / 2)));
  def dvb2-claim-cost() {
   let n = dvb2-big-n();
   let ref = dvb2-big-gen(i => dvb2-big-at(i), 0, n, []);
   let ours = dvb2-big-gen(i => dvb2-big-at(i) + 0.00001 * (1.0 * (i % 5)), 0, n, []);
   let t0 = host_monotonic_ms();
   let a = dvr-agreement(ours, ref);
   let tAgree = host_monotonic_ms() - t0;
   let t1 = host_monotonic_ms();
   let two = dvr-step(ours, 5);
   let tTwo = host_monotonic_ms() - t1;
   let t2 = host_monotonic_ms();
   let fin = dkr-all-finite?(ours);
   let tFin = host_monotonic_ms() - t2;
   let t3 = host_monotonic_ms();
   let q = dvb2-quad-two(ref);
   let tQuad = host_monotonic_ms() - t3;
   // the logits as the door reads them: a device buffer of 129,280 floats through dkr-read (the head's logits are read this way), then the same agreement
   let reg = dkr-reg-new();
   let pat = dkr-f32-bytes(dvb2-big-gen(i => (1.0 * ((i * 37 + 11) % 101)) * 0.37, 0, 256, []));
   let buf = dkr-buf-bytes(reg, dvb2-rep(pat, 505));
   let t4 = host_monotonic_ms();
   let read = dkr-read(buf, n);
   let tRead = host_monotonic_ms() - t4;
   let t5 = host_monotonic_ms();
   let b = dvr-agreement(read, read);
   let tSelf = host_monotonic_ms() - t5;
   let left = dkr-reg-free(reg);
   let same = dvr-two(ref);
   let said = print_str("  cost at " ++ n.str() ++ " values: agreement " ++ tAgree.str() ++ " ms (ceiling " ++ dvb2-ceil-agreement().str() ++ "), a stream step " ++ tTwo.str() ++ " ms, the finiteness scan " ++ tFin.str() ++ " ms (ceiling " ++ dvb2-ceil-pass().str() ++ " each), dkr-read of the buffer " ++ tRead.str() ++ " ms, agreement of the read " ++ tSelf.str()
    ++ " ms; the quadratic form of one pass " ++ tQuad.str() ++ " ms; r " ++ a[0].str() ++ " overlap " ++ a[1].str() ++ " delta " ++ a[5].str());
   len(ref) == n && len(read) == n && len(left) == 0 && tAgree < dvb2-ceil-agreement() && tTwo < dvb2-ceil-pass() && tFin < dvb2-ceil-pass() && tRead < dvb2-ceil-agreement() && tSelf < dvb2-ceil-agreement()
    && fin && q == same && a[0] > 0.999999 && a[1] == 10 && a[2] == a[3] && a[6] == 1 && a[5] < 0.001 && b[0] > 0.999999 && b[1] == 10 && b[5] == 0
    && tQuad > dvb2-ceil-agreement();
  }
  // ---- 32: the floors and where the reads happen ------------------------------------------------------------------------------
  def dvb2-claim-floors() {
   let src = read_file("form/form-stdlib/bml/dsv4-token-run.bml");
   dtr-recorded-argmax() == 2581 && dtr-ds4-spread() > 2.16 && dtr-ds4-spread() < 2.17 && !dvb2-has?(src, "dtr-r-floor") && !dvb2-has?(src, "dtr-overlap-floor") && dvr-logits-sha() == "3898af1731936bf0a59d0c0ce01a60df62f54b9b64552673c7f93df3b7c79d27"
    && dvb2-has?(src, "let v = dtr-val-read(env, ctx, index - record_get(env, \"vbase\") + 1); let nx = record_set(env, \"next\", [nid, pos + 1]); nid;") && dvb2-has?(src, "let v0 = nothing?(first) ? 0 : dtr-val-read(env, ctx, 0);") && dvb2-has?(src, "BETWEEN tokens, after the row's closing mark");
  }
 }
 let c1 = dvb2-bit(try dvb2-claim-good() catch false, 1);
 let c2 = dvb2-bit(try dvb2-claim-plants() catch false, 2);
 let c4 = dvb2-bit(try dvb2-claim-stream() catch false, 4);
 let c8 = dvb2-bit(try dvb2-claim-env() catch false, 8);
 let c16 = dvb2-bit(try dvb2-claim-plan() catch false, 16);
 let c32 = dvb2-bit(try dvb2-claim-floors() catch false, 32);
 let c64 = dvb2-bit(try dvb2-claim-cost() catch false, 64);
 print_str("dsv4-token-run-validation-band claims " ++ c1.str() ++ " " ++ c2.str() ++ " " ++ c4.str() ++ " " ++ c8.str() ++ " " ++ c16.str() ++ " " ++ c32.str() ++ " " ++ c64.str());
 c1 + c2 + c4 + c8 + c16 + c32 + c64;
}
