; living-world-relation-learning-witness.fk -- recurrence grows one relation edge.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-relation-learning.fk form-stdlib/tests/living-world-symbol-learning-witness.fk

(let LWRLW-RELATION (bp "LWRLW-RELATION"))
(let LWRLW-ALTERNATE (bp "LWRLW-ALTERNATE"))
(let LWRLW-LENS (bp "LWRLW-LENS"))
(let LWRLW-EVIDENCE (bp "LWRLW-EVIDENCE"))
(let LWRLW-SOURCE-G (bp "LWRLW-SOURCE-G"))
(let LWRLW-SOURCE-H (bp "LWRLW-SOURCE-H"))
(let LWRLW-PROV-G (bp "LWRLW-PROV-G"))
(let LWRLW-PROV-H (bp "LWRLW-PROV-H"))

(defn lwrlw-cell (kind) (intern_node kind (empty)))
(defn lwrlw-relation () (lwrlw-cell LWRLW-RELATION))
(defn lwrlw-alternate () (lwrlw-cell LWRLW-ALTERNATE))
(defn lwrlw-lens () (lwrlw-cell LWRLW-LENS))
(defn lwrlw-evidence () (lwrlw-cell LWRLW-EVIDENCE))
(defn lwrlw-source-g () (lwrlw-cell LWRLW-SOURCE-G))
(defn lwrlw-source-h () (lwrlw-cell LWRLW-SOURCE-H))
(defn lwrlw-prov-g () (lwrlw-cell LWRLW-PROV-G))
(defn lwrlw-prov-h () (lwrlw-cell LWRLW-PROV-H))

(defn lwrlw-symbol-proposals ()
    (lwt-round-proposals (lwslw-round)))
(defn lwrlw-left ()
    (lwt-proposal-candidate
        (lwslw-find-proposal (lwrlw-symbol-proposals) "forty")))
(defn lwrlw-right ()
    (lwt-proposal-candidate
        (lwslw-find-proposal (lwrlw-symbol-proposals) "-nine")))
(defn lwrlw-symbol-world ()
    (lwt-round-world (lwslw-integrated-round)))

(defn lwrlw-support-a ()
    (lwrl-observation (lwrlw-relation) (lwrlw-left) (lwrlw-right)
        (lwo-none) (oac-one (lwrlw-relation))
        (lwo-empty-field) (lwo-none) (lwrlw-evidence)))
(defn lwrlw-support-b ()
    (lwrl-observation (lwrlw-relation) (lwrlw-left) (lwrlw-right)
        (lwrlw-lens) (oac-one (lwrlw-relation))
        (lwo-empty-field) (lwlc-unknown (lwrlw-evidence))
        (lwrlw-evidence)))
(defn lwrlw-inverse-c ()
    (lwrl-observation (lwrlw-relation) (lwrlw-right) (lwrlw-left)
        (lwo-none) (oac-one (lwrlw-relation))
        (lwo-field (list (lwrlw-alternate))) (lwo-none)
        (lwrlw-evidence)))
(defn lwrlw-dissent-d ()
    (lwrl-observation (lwrlw-relation) (lwrlw-left) (lwrlw-right)
        (lwo-none) (oac-zero) (lwo-empty-field) (lwo-none)
        (lwrlw-evidence)))
(defn lwrlw-silence-e ()
    (lwrl-observation (lwrlw-relation) (lwrlw-left) (lwrlw-right)
        (lwo-none) (oac-nothing) (lwo-empty-field) (lwo-none)
        (lwrlw-evidence)))
(defn lwrlw-alternative-f ()
    (lwrl-observation (lwrlw-relation) (lwrlw-left) (lwrlw-right)
        (lwrlw-lens)
        (oac-alternative-ack (lwrlw-relation)
            (lwrlw-alternate) (lwrlw-evidence))
        (lwo-field (list (lwrlw-alternate)))
        (lwlc-unknown (lwrlw-evidence)) (lwrlw-evidence)))
(defn lwrlw-unresolved-g ()
    (lwrl-observation (lwrlw-relation) (lwrlw-left) (lwrlw-right)
        (lwo-none) (oac-node (lwrlw-evidence))
        (lwo-empty-field) (lwlc-unknown (lwrlw-evidence))
        (lwrlw-evidence)))
(defn lwrlw-second-inverse-h ()
    (lwrl-observation (lwrlw-relation) (lwrlw-right) (lwrlw-left)
        (lwrlw-lens) (oac-one (lwrlw-relation))
        (lwo-empty-field) (lwlc-unknown (lwrlw-evidence))
        (lwrlw-evidence)))

(defn lwrlw-entry-g (payload)
    (lwslw-entry-for (lwrlw-source-g) (lwrlw-prov-g) payload))
(defn lwrlw-entry-h (payload)
    (lwslw-entry-for (lwrlw-source-h) (lwrlw-prov-h) payload))

(defn lwrlw-world ()
    (lwt-receive-stream (lwrlw-symbol-world)
        (list
            (lwslw-entry-a (lwrlw-support-a))
            (lwslw-entry-b (lwrlw-support-b))
            (lwslw-entry-c (lwrlw-inverse-c))
            (lwslw-entry-d (lwrlw-dissent-d))
            (lwslw-entry-e (lwrlw-silence-e))
            (lwslw-entry-f (lwrlw-alternative-f))
            (lwrlw-entry-g (lwrlw-unresolved-g)))))
(defn lwrlw-cycle-world ()
    (lwt-receive-stream (lwrlw-world)
        (list (lwrlw-entry-h (lwrlw-second-inverse-h)))))

(defn lwrlw-find-proposal-items (items left right)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let edge
                (lwo-emergent-shape
                    (lwt-proposal-candidate (head items))))
            (if (and (node_eq (lwrl-edge-left edge) left)
                     (node_eq (lwrl-edge-right edge) right))
                (head items)
                (lwrlw-find-proposal-items (tail items) left right)))))
(defn lwrlw-find-proposal (proposals left right)
    (lwrlw-find-proposal-items (lwo-field-items proposals) left right))

(defn lwrlw-round ()
    (do
        (let world (lwrlw-world))
        (lwt-round world (lwrl-proposals world 2)
            (lwo-empty-field) (lwo-none))))
(defn lwrlw-cycle-round ()
    (do
        (let world (lwrlw-cycle-world))
        (lwt-round world (lwrl-proposals world 2)
            (lwo-empty-field) (lwo-none))))

(defn lwrlw-response (source provenance proposal)
    (lwslw-entry-for source provenance
        (lwt-response proposal (oac-one proposal) provenance)))
(defn lwrlw-responses (proposal include-h)
    (do
        (let base
            (list
                (lwrlw-response (lwslw-source-a) (lwslw-prov-a) proposal)
                (lwrlw-response (lwslw-source-b) (lwslw-prov-b) proposal)
                (lwrlw-response (lwslw-source-c) (lwslw-prov-c) proposal)
                (lwrlw-response (lwslw-source-d) (lwslw-prov-d) proposal)
                (lwrlw-response (lwslw-source-e) (lwslw-prov-e) proposal)
                (lwrlw-response (lwslw-source-f) (lwslw-prov-f) proposal)
                (lwrlw-response (lwrlw-source-g) (lwrlw-prov-g) proposal)))
        (if (eq include-h 1)
            (cons (lwrlw-response
                    (lwrlw-source-h) (lwrlw-prov-h) proposal) base)
            base)))

(defn lwrlw-yes-round ()
    (do
        (let round (lwrlw-round))
        (let proposal
            (lwrlw-find-proposal (lwt-round-proposals round)
                (lwrlw-left) (lwrlw-right)))
        (lwt-round-receive round (lwrlw-responses proposal 0))))
(defn lwrlw-integrated-round ()
    (do
        (let round (lwrlw-yes-round))
        (let proposal
            (lwrlw-find-proposal (lwt-round-proposals round)
                (lwrlw-left) (lwrlw-right)))
        (lwrl-integrate round proposal (lwslw-action))))

(defn lwrlw-cycle-yes-round ()
    (do
        (let round (lwrlw-cycle-round))
        (let proposals (lwt-round-proposals round))
        (let forward
            (lwrlw-find-proposal proposals (lwrlw-left) (lwrlw-right)))
        (let inverse
            (lwrlw-find-proposal proposals (lwrlw-right) (lwrlw-left)))
        (lwt-round-receive round
            (append (lwrlw-responses forward 1)
                    (lwrlw-responses inverse 1)))))
(defn lwrlw-cycle-integrated-round ()
    (do
        (let round (lwrlw-cycle-yes-round))
        (let proposals (lwt-round-proposals round))
        (let forward
            (lwrlw-find-proposal proposals (lwrlw-left) (lwrlw-right)))
        (let inverse
            (lwrlw-find-proposal proposals (lwrlw-right) (lwrlw-left)))
        (let first (lwrl-integrate round forward (lwslw-action)))
        (lwrl-integrate first inverse (lwslw-action))))

(defn lwrlw-revoked-world ()
    (lwt-receive-stream (lwrlw-world)
        (list
            (lwslw-entry-a
                (lwo-revocation (lwrlw-support-a)
                    (lwslw-source-a) (lwslw-action) (lwslw-prov-a))))))

(defn lwrlw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwrlw-sum (tail items)))))
