; tests/bml-hati-native-break-continue-proof.fk
;
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk
;
; Closes the general-break-continue-source-lowering family on the Hati table
; lane. `break label;` now reads through the fixed break-simple rule (its
; emitter was unreachable from source), `break;` and `continue;` through the
; control reader. Each jump is a bml-native-source-control effect row: break
; rides "stop", continue rides "choice", the mode is the primitive's place
; plus its target, and a loop answers as bnsc-loop-step reads it. A jump
; with no target is named before table emission.

(do
    (defn score-bool (actual)
        (if actual 1 0))

    (defn score-int (actual expected)
        (if (eq actual expected) 1 0))

    (defn score-str (actual expected)
        (if (str_eq (value_kind actual) "string")
            (if (str_eq actual expected) 1 0)
             0))

    (defn str-contains? (haystack needle)
        (ge (str_find haystack needle 0) 0))

    (defn parse-source (source)
        (bml-source-parse-executable-stream (bml-source-scan-text source)))

    (defn image-of (source)
        (bml-hati-compile-image (bml-source-exec-parse-node (parse-source source))))

    (defn method-node (source)
        (head (bml-source-exec-parse-nodes (parse-source source))))

    (defn self-of (field)
        (record_set (record_new (make_nodeid 1 9 2026 613) field 0) "m" 0))

    ;; a method that reads this lives in a class; its receiver rides its own slot
    (defn in-class (method)
        (bml-ast-class
            "Walker"
            "Object"
            (bml-ast-block
                (list
                    (bml-ast-section
                        (bml-ast-name "public")
                        (bml-ast-block
                            (list
                                (bml-ast-field "int" "seen")
                                (bml-ast-field "int" "cells")
                                (bml-ast-field "int" "n")
                                (bml-ast-field "int" "m")
                                method)))))))

    (defn run-member (method self)
        (bml-hati-run-class-method (in-class method) (bml-method-node-name method) self (empty)))

    (let labeled-parsed (parse-source "break scan;\n"))
    (let labeled-node (head (bml-source-exec-parse-nodes labeled-parsed)))
    (let labeled-image (image-of "break scan;\n"))
    (let property-parsed (parse-source "continue outer;\n"))
    (let bare-parsed (parse-source "break;\n"))
    (let bare-image (image-of "break;\n"))
    (let continue-parsed (parse-source "continue;\n"))
    (let continue-image (image-of "continue;\n"))

    (let walk-node
        (method-node
            "int Walk() { for (int i = 0; i < 100; i++) { if (i < 5) continue; if (i == 9) break; this.seen = this.seen + 1; } return this.seen; }\n"))
    (let walk-image (bml-hati-compile-image (in-class walk-node)))
    (let walk-table (bml-hati-table-file walk-image))

    (let grid-node
        (method-node
            "int Grid() { outer: for (int i = 0; i < 10; i++) { for (int j = 0; j < 10; j++) { if (j == 3) continue outer; if (i == 4) break outer; this.cells = this.cells + 1; } } return this.cells; }\n"))

    (let skip-node
        (method-node
            "int Skip() { while (this.n < 6) { this.n = this.n + 1; if (this.n == 2 || this.n == 4) continue; this.m = this.m + this.n; } return this.m; }\n"))

    (sum
        (list
            (score-str (head (bml-source-exec-parse-rules labeled-parsed)) "break-simple")
            (score-bool (node_eq (node_category labeled-node) BML-AST-BREAK))
            (score-str (bml-local-name labeled-node) "scan")
            (score-str (head (bml-hati-image-unsupported labeled-image)) "break/label")
            (score-str (head (bml-source-exec-parse-rules property-parsed)) "control-continue")
            (score-str (bml-local-name (head (bml-source-exec-parse-nodes property-parsed))) "outer")
            (score-str (head (bml-source-exec-parse-rules bare-parsed)) "control-break")
            (score-str (head (bml-hati-image-unsupported bare-image)) "break/outside-loop")
            (score-str (head (bml-source-exec-parse-rules continue-parsed)) "control-continue")
            (score-str (head (bml-hati-image-unsupported continue-image)) "continue/outside-loop")
            (score-bool (str-contains? (bml-hati-table-file bare-image) "BML-HATI-UNSUPPORTED break/outside-loop"))
            (score-bool (bml-hati-image-supported? walk-image))
            (score-bool (not (str-contains? walk-table "BML-HATI-UNSUPPORTED")))
            (score-bool (str-contains? walk-table "1 9 0 0"))
            (score-bool (str-contains? walk-table "1 10 0 0"))
            (score-int (run-member walk-node (self-of "seen")) 4)
            (score-int (run-member grid-node (self-of "cells")) 12)
            (score-int (run-member skip-node (self-of "n")) 15)
            (score-int (bml-ctl-break-mode 2) 17)
            (score-int (bml-ctl-continue-mode 2) 18)
            (score-str (bnsc-effect-primitive (bml-ctl-node-effect (bml-ast-break ""))) "stop")
            (score-str (bnsc-effect-primitive (bml-ctl-node-effect (bml-ast-continue ""))) "choice")
            (score-str (bml-ctl-loop-reaction (bnsc-break "" (bml-ctl-source 0))) "stopped")
            (score-str (bml-ctl-loop-reaction (bnsc-continue "" (bml-ctl-source 0))) "running")
            (score-bool (bml-ctl-form-native-covered? 0)))))
