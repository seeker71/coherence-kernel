; Independent target boundaries, unequal sequence weights and JSONL line evidence.
; Uses the actual tokenizer's vocabulary; opens no model or GPU buffers.
; preludes: form-stdlib/native-lora-dataset.bml form-stdlib/model-registry.bml
(do
 (let tk (nlt-open (mr-path (mr-find "llama32-3b-mlx-4bit"))))
 (let ms (list (nld-message "system" " Speak plainly. ") (nld-message "user" "First?") (nld-message "assistant" "One.") (nld-message "user" "Second?") (nld-message "assistant" "Two.")))
 (let row (nld-chat-row tk ms 1 9))
 (let answer (append (nlt-encode tk "Two.") (list (nlt-special tk "<|eot_id|>"))))
 (let supervised (len answer))
 (let targets (nth row 1))
 (let offset (sub (len targets) supervised))
 (let b1 (and (value_eq (drop offset targets) answer) (eq (sum (take offset (nth row 2))) 0)))
 (let b2 (and (eq (sum (drop offset (nth row 2))) supervised) (eq (nth row 4) 9)))
 (let unmasked (nld-chat-row tk ms 0 9))
 (let b4 (and (value_eq (nth row 1) (nth unmasked 1)) (eq (sum (nth unmasked 2)) (len (nth unmasked 1)))))
 (let lines (nld-lines "\n{\"text\":\"One\"}\n \n{\"text\":\"Two\"}"))
 (let b8 (and (eq (len lines) 2) (and (eq (nth (head lines) 1) 2) (eq (nth (nth lines 1) 1) 4))))
 (let tiny (nld-sample (list 1 2 3 4 5) 3 1))
 (let b16 (and (value_eq (nth tiny 2) (list 0.0 0.0 1.0 1.0)) (eq (nth tiny 3) 2.0)))
 (let result (add (if b1 1 0) (add (if b2 2 0) (add (if b4 4 0) (add (if b8 8 0) (if b16 16 0))))))
 (print (list "masked-targets" supervised "input-tokens" (len (head row)) "bits" result))
 (if (eq result 31) result (form_error "native training dataset boundaries refused")))
