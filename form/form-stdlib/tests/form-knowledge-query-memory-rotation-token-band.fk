; form-knowledge-query-memory-rotation-token-band.fk -- a small resident
; NodeID recipe/request/choice walker independent of the curriculum closure.
;
; Verdict 65535: content-addressed recipe and request identities bind action
; 31.2.0.109, memory, rollback and offer data; scannerless and non-pretokenized
; flags remain explicit; keep/undo/timeout/cut remain distinct; actual nothing
; mints nothing; generated 0 and 1 are both present and content-distinct.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-knowledge-query-memory-rotation-token.fk

import "../form-knowledge-query-memory-rotation-token.fk"

(do
    (defn fkqmrtb-bit (ok bit) (if ok bit 0))
    (let memory (intern_node (make_nodeid 31 2 0 124)
        (list (intern_trivial_string "answer-free-memory"))))
    (let rollback (intern_node (make_nodeid 31 2 0 125)
        (list (intern_trivial_string "nothing-alternative"))))
    (let offer (intern_node (make_nodeid 31 2 0 97)
        (list (intern_trivial_string "scannerless-query-offer"))))
    (let plan (list
        (fkqmrt-plan-schema) memory "memory-key" rollback "rollback-key"
        "question-sha" "trial-b" "h01" "b" "axioms" "source-path"
        "source-sha" "question-sha" "query-frame" "query-sha" offer
        "offer-key" 1 1 0 0 0 0 1 0))
    (let recipe (fkqmrt-recipe plan))
    (let request (fkqmrt-request-token plan))
    (let keep (fkqmrt-choice-token plan "keep" memory 3 1 0 1 1))
    (let undo (fkqmrt-choice-token plan "undo" rollback 3 1 0 1 1))
    (let timeout (fkqmrt-choice-token plan "timeout" memory 0 1 1 0 0))
    (let cut (fkqmrt-choice-token plan "cut" memory 1 1 0 0 1))
    (let zero (fkqmrt-choice-token plan "undo" rollback 0 1 0 1 1))
    (let one (fkqmrt-choice-token plan "undo" rollback 1 1 0 1 1))
    (sum (list
        (fkqmrtb-bit (eq (fkqmrt-plan-shaped? plan) 1) 1)
        (fkqmrtb-bit (and (eq (fkqmrt-recipe-valid? recipe plan) 1)
            (node_eq (node_category recipe) (make_nodeid 31 2 0 128))) 2)
        (fkqmrtb-bit (and (eq (fkqmrt-request-valid? request plan) 1)
            (node_eq (node_category request) (make_nodeid 31 2 0 129))) 4)
        (fkqmrtb-bit (node_eq (nth (node_children request) 1)
            (make_nodeid 31 2 0 109)) 8)
        (fkqmrtb-bit (and (node_eq (nth (node_children request) 2) recipe)
            (and (eq (node_value (nth (node_children request) 7)) 0)
                 (eq (node_value (nth (node_children request) 8)) 1))) 16)
        (fkqmrtb-bit (and (str_eq (fkqmrt-choice-token-signal keep) "keep")
            (node_eq (fkqmrt-choice-token-node keep) memory)) 32)
        (fkqmrtb-bit (and (str_eq (fkqmrt-choice-token-signal undo) "undo")
            (node_eq (fkqmrt-choice-token-node undo) rollback)) 64)
        (fkqmrtb-bit (str_eq (fkqmrt-choice-token-signal timeout)
            "timeout") 128)
        (fkqmrtb-bit (str_eq (fkqmrt-choice-token-signal cut) "cut") 256)
        (fkqmrtb-bit (nothing? (fkqmrt-choice-token
            (nothing) "keep" memory 1 1 0 1 1)) 512)
        (fkqmrtb-bit (nothing? (fkqmrt-choice-token
            plan "undo" memory 1 1 0 1 1)) 1024)
        (fkqmrtb-bit (nothing? (fkqmrt-choice-token
            plan "keep" memory 1 0 0 1 1)) 2048)
        (fkqmrtb-bit (and (eq (fkqmrt-choice-token-present? zero) 1)
            (eq (fkqmrt-choice-token-generated zero) 0)) 4096)
        (fkqmrtb-bit (and (eq (fkqmrt-choice-token-present? one) 1)
            (eq (fkqmrt-choice-token-generated one) 1)) 8192)
        (fkqmrtb-bit (not (node_eq zero one)) 16384)
        (fkqmrtb-bit (and (nothing? (fkqmrt-recipe (nothing)))
            (nothing? (fkqmrt-request-token (nothing)))) 32768))))
