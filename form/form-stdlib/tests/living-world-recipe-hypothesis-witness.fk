; living-world-recipe-hypothesis-witness.fk -- offered operators meet
; recurrent scoped examples and remain plural through held-out observation.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk

(let LWPHW-FIELD-FIXTURE   (bp "LWPHW-FIELD-FIXTURE"))
(let LWPHW-PROBE-FIXTURE   (bp "LWPHW-PROBE-FIXTURE"))
(let LWPHW-SOURCE-A        (bp "LWPHW-SOURCE-A"))
(let LWPHW-SOURCE-B        (bp "LWPHW-SOURCE-B"))
(let LWPHW-SOURCE-C        (bp "LWPHW-SOURCE-C"))
(let LWPHW-SOURCE-D        (bp "LWPHW-SOURCE-D"))
(let LWPHW-SOURCE-E        (bp "LWPHW-SOURCE-E"))
(let LWPHW-SOURCE-F        (bp "LWPHW-SOURCE-F"))
(let LWPHW-SOURCE-G        (bp "LWPHW-SOURCE-G"))
(let LWPHW-SOURCE-H        (bp "LWPHW-SOURCE-H"))
(let LWPHW-SOURCE-I        (bp "LWPHW-SOURCE-I"))
(let LWPHW-SOURCE-J        (bp "LWPHW-SOURCE-J"))
(let LWPHW-SOURCE-K        (bp "LWPHW-SOURCE-K"))
(let LWPHW-SOURCE-L        (bp "LWPHW-SOURCE-L"))
(let LWPHW-SOURCE-M        (bp "LWPHW-SOURCE-M"))
(let LWPHW-SOURCE-N        (bp "LWPHW-SOURCE-N"))
(let LWPHW-PROV-A          (bp "LWPHW-PROV-A"))
(let LWPHW-PROV-B          (bp "LWPHW-PROV-B"))
(let LWPHW-PROV-C          (bp "LWPHW-PROV-C"))
(let LWPHW-PROV-D          (bp "LWPHW-PROV-D"))
(let LWPHW-PROV-E          (bp "LWPHW-PROV-E"))
(let LWPHW-PROV-F          (bp "LWPHW-PROV-F"))
(let LWPHW-PROV-G          (bp "LWPHW-PROV-G"))
(let LWPHW-PROV-H          (bp "LWPHW-PROV-H"))
(let LWPHW-PROV-I          (bp "LWPHW-PROV-I"))
(let LWPHW-PROV-J          (bp "LWPHW-PROV-J"))
(let LWPHW-PROV-K          (bp "LWPHW-PROV-K"))
(let LWPHW-PROV-L          (bp "LWPHW-PROV-L"))
(let LWPHW-PROV-M          (bp "LWPHW-PROV-M"))
(let LWPHW-PROV-N          (bp "LWPHW-PROV-N"))
(let LWPHW-ACTION          (bp "LWPHW-ACTION"))
(let LWPHW-FOCUS           (bp "LWPHW-FOCUS"))
(let LWPHW-TRAIN-SCOPE     (bp "LWPHW-TRAIN-SCOPE"))
(let LWPHW-TRAIN-LEFT      (bp "LWPHW-TRAIN-LEFT"))
(let LWPHW-TRAIN-RIGHT     (bp "LWPHW-TRAIN-RIGHT"))
(let LWPHW-PROBE-SCOPE     (bp "LWPHW-PROBE-SCOPE"))
(let LWPHW-PROBE-LEFT      (bp "LWPHW-PROBE-LEFT"))
(let LWPHW-PROBE-RIGHT     (bp "LWPHW-PROBE-RIGHT"))
(let LWPHW-EVIDENCE        (bp "LWPHW-EVIDENCE"))
(let LWPHW-ALTERNATIVE     (bp "LWPHW-ALTERNATIVE"))
(let LWPHW-REASON          (bp "LWPHW-REASON"))

(defn lwphw-cell (kind) (intern_node kind (empty)))
(defn lwphw-source-a () (lwphw-cell LWPHW-SOURCE-A))
(defn lwphw-source-b () (lwphw-cell LWPHW-SOURCE-B))
(defn lwphw-source-c () (lwphw-cell LWPHW-SOURCE-C))
(defn lwphw-source-d () (lwphw-cell LWPHW-SOURCE-D))
(defn lwphw-source-e () (lwphw-cell LWPHW-SOURCE-E))
(defn lwphw-source-f () (lwphw-cell LWPHW-SOURCE-F))
(defn lwphw-source-g () (lwphw-cell LWPHW-SOURCE-G))
(defn lwphw-source-h () (lwphw-cell LWPHW-SOURCE-H))
(defn lwphw-source-i () (lwphw-cell LWPHW-SOURCE-I))
(defn lwphw-source-j () (lwphw-cell LWPHW-SOURCE-J))
(defn lwphw-source-k () (lwphw-cell LWPHW-SOURCE-K))
(defn lwphw-source-l () (lwphw-cell LWPHW-SOURCE-L))
(defn lwphw-source-m () (lwphw-cell LWPHW-SOURCE-M))
(defn lwphw-source-n () (lwphw-cell LWPHW-SOURCE-N))
(defn lwphw-prov-a () (lwphw-cell LWPHW-PROV-A))
(defn lwphw-prov-b () (lwphw-cell LWPHW-PROV-B))
(defn lwphw-prov-c () (lwphw-cell LWPHW-PROV-C))
(defn lwphw-prov-d () (lwphw-cell LWPHW-PROV-D))
(defn lwphw-prov-e () (lwphw-cell LWPHW-PROV-E))
(defn lwphw-prov-f () (lwphw-cell LWPHW-PROV-F))
(defn lwphw-prov-g () (lwphw-cell LWPHW-PROV-G))
(defn lwphw-prov-h () (lwphw-cell LWPHW-PROV-H))
(defn lwphw-prov-i () (lwphw-cell LWPHW-PROV-I))
(defn lwphw-prov-j () (lwphw-cell LWPHW-PROV-J))
(defn lwphw-prov-k () (lwphw-cell LWPHW-PROV-K))
(defn lwphw-prov-l () (lwphw-cell LWPHW-PROV-L))
(defn lwphw-prov-m () (lwphw-cell LWPHW-PROV-M))
(defn lwphw-prov-n () (lwphw-cell LWPHW-PROV-N))
(defn lwphw-action () (lwphw-cell LWPHW-ACTION))
(defn lwphw-focus () (lwphw-cell LWPHW-FOCUS))
(defn lwphw-evidence () (lwphw-cell LWPHW-EVIDENCE))
(defn lwphw-alternative () (lwphw-cell LWPHW-ALTERNATIVE))
(defn lwphw-reason () (lwphw-cell LWPHW-REASON))
(defn lwphw-train-scope () (lwphw-cell LWPHW-TRAIN-SCOPE))
(defn lwphw-train-left () (lwphw-cell LWPHW-TRAIN-LEFT))
(defn lwphw-train-right () (lwphw-cell LWPHW-TRAIN-RIGHT))
(defn lwphw-probe-scope () (lwphw-cell LWPHW-PROBE-SCOPE))
(defn lwphw-probe-left () (lwphw-cell LWPHW-PROBE-LEFT))
(defn lwphw-probe-right () (lwphw-cell LWPHW-PROBE-RIGHT))

(defn lwphw-entry (source provenance payload)
    (lwt-entry
        (lwo-offer source (lwo-interface (list (lwphw-action)))
            1 payload provenance 1)
        (lwphw-action)))
(defn lwphw-entry-a (payload) (lwphw-entry (lwphw-source-a) (lwphw-prov-a) payload))
(defn lwphw-entry-b (payload) (lwphw-entry (lwphw-source-b) (lwphw-prov-b) payload))
(defn lwphw-entry-c (payload) (lwphw-entry (lwphw-source-c) (lwphw-prov-c) payload))
(defn lwphw-entry-d (payload) (lwphw-entry (lwphw-source-d) (lwphw-prov-d) payload))
(defn lwphw-entry-e (payload) (lwphw-entry (lwphw-source-e) (lwphw-prov-e) payload))
(defn lwphw-entry-f (payload) (lwphw-entry (lwphw-source-f) (lwphw-prov-f) payload))
(defn lwphw-entry-g (payload) (lwphw-entry (lwphw-source-g) (lwphw-prov-g) payload))
(defn lwphw-entry-h (payload) (lwphw-entry (lwphw-source-h) (lwphw-prov-h) payload))
(defn lwphw-entry-i (payload) (lwphw-entry (lwphw-source-i) (lwphw-prov-i) payload))
(defn lwphw-entry-j (payload) (lwphw-entry (lwphw-source-j) (lwphw-prov-j) payload))
(defn lwphw-entry-k (payload) (lwphw-entry (lwphw-source-k) (lwphw-prov-k) payload))
(defn lwphw-entry-l (payload) (lwphw-entry (lwphw-source-l) (lwphw-prov-l) payload))
(defn lwphw-entry-m (payload) (lwphw-entry (lwphw-source-m) (lwphw-prov-m) payload))
(defn lwphw-entry-n (payload) (lwphw-entry (lwphw-source-n) (lwphw-prov-n) payload))

(defn lwphw-response-items (proposal items)
    (if (eq (len items) 0) (list)
        (do
            (let attribution (head items))
            (let source (lwo-attribution-source attribution))
            (let provenance (nth (node_children attribution) 2))
            (cons
                (lwphw-entry source provenance
                    (lwt-response proposal (oac-one proposal) provenance))
                (lwphw-response-items proposal (tail items))))))
(defn lwphw-responses (proposal)
    (lwphw-response-items proposal
        (lwo-field-items
            (lwo-emergent-witnesses
                (lwt-proposal-candidate proposal)))))
(defn lwphw-answered-round (world proposal previous)
    (lwt-round-receive
        (lwt-round world (lwo-field (list proposal))
            (lwo-empty-field) previous)
        (lwphw-responses proposal)))

(defn lwphw-enquiry ()
    (lwph-enquiry (lwphw-focus)
        (lwo-field (list (lwphw-alternative)))
        (lwlc-unknown (lwphw-evidence)) (lwphw-evidence)))
(defn lwphw-add () (lwph-operator (lwphw-enquiry) "add" (lwphw-evidence)))
(defn lwphw-mul () (lwph-operator (lwphw-enquiry) "mul" (lwphw-evidence)))
(defn lwphw-sub () (lwph-operator (lwphw-enquiry) "sub" (lwphw-evidence)))

(defn lwphw-projection
    (scope source value alternatives unknown)
    (lwre-projection scope source value alternatives unknown
        (lwphw-evidence)))
(defn lwphw-train-left-projection ()
    (lwphw-projection (lwphw-train-scope) (lwphw-train-left)
        (intern_trivial_int 2) (lwo-empty-field) (lwo-none)))
(defn lwphw-train-right-projection ()
    (lwphw-projection (lwphw-train-scope) (lwphw-train-right)
        (intern_trivial_int 2)
        (lwo-field (list (lwphw-alternative)))
        (lwlc-unknown (lwphw-evidence))))
(defn lwphw-train-bindings ()
    (lwre-bindings
        (list
            (lwre-projected-binding "left"
                (lwphw-train-left-projection) (lwphw-evidence))
            (lwre-projected-binding "right"
                (lwphw-train-right-projection) (lwphw-evidence)))))
(defn lwphw-example ()
    (lwph-example (lwphw-enquiry) (lwphw-train-bindings)
        (intern_trivial_int 4) (oac-one (intern_trivial_int 4))
        (lwo-field (list (lwphw-alternative)))
        (lwlc-unknown (lwphw-evidence)) (lwphw-evidence)))

(defn lwphw-training-world ()
    (lwt-receive-stream (lwo-empty-world)
        (list
            (lwphw-entry-a (lwphw-focus))
            (lwphw-entry-b (lwphw-focus))
            (lwphw-entry-a (lwphw-enquiry))
            (lwphw-entry-b (lwphw-enquiry))
            (lwphw-entry-c (lwphw-add)) (lwphw-entry-d (lwphw-add))
            (lwphw-entry-e (lwphw-mul)) (lwphw-entry-f (lwphw-mul))
            (lwphw-entry-g (lwphw-sub)) (lwphw-entry-h (lwphw-sub))
            (lwphw-entry-i (lwphw-train-scope))
            (lwphw-entry-j (lwphw-train-scope))
            (lwphw-entry-i (lwphw-train-left))
            (lwphw-entry-j (lwphw-train-left))
            (lwphw-entry-i (lwphw-train-right))
            (lwphw-entry-j (lwphw-train-right))
            (lwphw-entry-i (lwphw-train-left-projection))
            (lwphw-entry-j (lwphw-train-left-projection))
            (lwphw-entry-i (lwphw-train-right-projection))
            (lwphw-entry-j (lwphw-train-right-projection))
            (lwphw-entry-i
                (nth (lwre-binding-items (lwphw-train-bindings)) 0))
            (lwphw-entry-j
                (nth (lwre-binding-items (lwphw-train-bindings)) 0))
            (lwphw-entry-i
                (nth (lwre-binding-items (lwphw-train-bindings)) 1))
            (lwphw-entry-j
                (nth (lwre-binding-items (lwphw-train-bindings)) 1))
            (lwphw-entry-i (lwphw-example))
            (lwphw-entry-j (lwphw-example)))))

; children: integrated round, candidate, proposal, exact field
(defn lwphw-field-fixture (round candidate proposal field)
    (intern_node LWPHW-FIELD-FIXTURE
        (list round candidate proposal field)))
(defn lwphw-field-round (fixture) (nth (node_children fixture) 0))
(defn lwphw-field-candidate (fixture) (nth (node_children fixture) 1))
(defn lwphw-field-proposal (fixture) (nth (node_children fixture) 2))
(defn lwphw-field-shape (fixture) (nth (node_children fixture) 3))
(defn lwphw-integrated-field ()
    (do
        (let world (lwphw-training-world))
        (let field (lwph-field-for world (lwphw-enquiry) 2))
        (let proposal (lwph-proposal world (lwphw-enquiry) 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let answered
            (lwphw-answered-round world proposal (lwo-none)))
        (let integrated
            (lwph-integrate answered proposal (lwphw-action)))
        (lwphw-field-fixture integrated candidate proposal field)))

(defn lwphw-probe-left-projection ()
    (lwphw-projection (lwphw-probe-scope) (lwphw-probe-left)
        (intern_trivial_int 3) (lwo-empty-field) (lwo-none)))
(defn lwphw-probe-right-projection ()
    (lwphw-projection (lwphw-probe-scope) (lwphw-probe-right)
        (intern_trivial_int 4)
        (lwo-field (list (lwphw-alternative)))
        (lwlc-unknown (lwphw-evidence))))
(defn lwphw-probe-bindings ()
    (lwre-bindings
        (list
            (lwre-projected-binding "left"
                (lwphw-probe-left-projection) (lwphw-evidence))
            (lwre-projected-binding "right"
                (lwphw-probe-right-projection) (lwphw-evidence)))))
(defn lwphw-open-probe (field-candidate)
    (lwph-probe field-candidate (lwphw-probe-bindings)
        (lwo-none) (oac-nothing)
        (lwo-field (list (lwphw-alternative)))
        (lwlc-unknown (lwphw-evidence)) (lwphw-evidence)))
(defn lwphw-observed-probe (field-candidate)
    (lwph-probe field-candidate (lwphw-probe-bindings)
        (intern_trivial_int 7) (oac-one (intern_trivial_int 7))
        (lwo-field (list (lwphw-alternative)))
        (lwlc-unknown (lwphw-evidence)) (lwphw-evidence)))
(defn lwphw-wrong-probe (field-candidate)
    (lwph-probe field-candidate (lwphw-probe-bindings)
        (intern_trivial_int 13) (oac-one (intern_trivial_int 13))
        (lwo-field (list (lwphw-alternative)))
        (lwlc-unknown (lwphw-evidence)) (lwphw-evidence)))
(defn lwphw-alternative-probe (field-candidate)
    (lwph-probe field-candidate (lwphw-probe-bindings)
        (intern_trivial_int 7)
        (oac-alternative-ack (intern_trivial_int 12)
            (intern_trivial_int 7) (lwphw-evidence))
        (lwo-field (list (intern_trivial_int 7)
                         (lwphw-alternative)))
        (lwlc-unknown (lwphw-evidence)) (lwphw-evidence)))

(defn lwphw-probe-dependencies (world entries)
    (lwt-receive-stream world
        (append
            (list
                (lwphw-entry-k (lwphw-probe-scope))
                (lwphw-entry-l (lwphw-probe-scope))
                (lwphw-entry-k (lwphw-probe-left))
                (lwphw-entry-l (lwphw-probe-left))
                (lwphw-entry-k (lwphw-probe-right))
                (lwphw-entry-l (lwphw-probe-right))
                (lwphw-entry-k (lwphw-probe-left-projection))
                (lwphw-entry-l (lwphw-probe-left-projection))
                (lwphw-entry-k (lwphw-probe-right-projection))
                (lwphw-entry-l (lwphw-probe-right-projection))
                (lwphw-entry-k
                    (nth (lwre-binding-items (lwphw-probe-bindings)) 0))
                (lwphw-entry-l
                    (nth (lwre-binding-items (lwphw-probe-bindings)) 0))
                (lwphw-entry-k
                    (nth (lwre-binding-items (lwphw-probe-bindings)) 1))
                (lwphw-entry-l
                    (nth (lwre-binding-items (lwphw-probe-bindings)) 1)))
            entries)))
(defn lwphw-open-probe-world (field-fixture)
    (do
        (let candidate (lwphw-field-candidate field-fixture))
        (lwphw-probe-dependencies
            (lwt-round-world (lwphw-field-round field-fixture))
            (list
                (lwphw-entry-k (lwphw-open-probe candidate))
                (lwphw-entry-l (lwphw-open-probe candidate))))))
(defn lwphw-observed-probe-world (field-fixture)
    (do
        (let candidate (lwphw-field-candidate field-fixture))
        (lwphw-probe-dependencies
            (lwt-round-world (lwphw-field-round field-fixture))
            (list
                (lwphw-entry-m (lwphw-observed-probe candidate))
                (lwphw-entry-n (lwphw-observed-probe candidate))))))
(defn lwphw-wrong-probe-world (field-fixture)
    (do
        (let candidate (lwphw-field-candidate field-fixture))
        (lwphw-probe-dependencies
            (lwt-round-world (lwphw-field-round field-fixture))
            (list
                (lwphw-entry-m (lwphw-wrong-probe candidate))
                (lwphw-entry-n (lwphw-wrong-probe candidate))))))
(defn lwphw-alternative-probe-world (field-fixture)
    (do
        (let candidate (lwphw-field-candidate field-fixture))
        (lwphw-probe-dependencies
            (lwt-round-world (lwphw-field-round field-fixture))
            (list
                (lwphw-entry-m (lwphw-alternative-probe candidate))
                (lwphw-entry-n (lwphw-alternative-probe candidate))))))

; children: integrated round, candidate, proposal, exact placement, probe
(defn lwphw-probe-fixture (round candidate proposal placement probe)
    (intern_node LWPHW-PROBE-FIXTURE
        (list round candidate proposal placement probe)))
(defn lwphw-probe-round (fixture) (nth (node_children fixture) 0))
(defn lwphw-probe-candidate (fixture) (nth (node_children fixture) 1))
(defn lwphw-probe-proposal (fixture) (nth (node_children fixture) 2))
(defn lwphw-probe-placement (fixture) (nth (node_children fixture) 3))
(defn lwphw-probe-cell (fixture) (nth (node_children fixture) 4))
(defn lwphw-integrate-probe (field-fixture world probe)
    (do
        (let placement (lwph-placement-for world probe 2))
        (let proposal (lwph-probe-proposal world probe 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let answered
            (lwphw-answered-round world proposal
                (lwphw-field-round field-fixture)))
        (let integrated
            (lwph-probe-integrate answered proposal (lwphw-action)))
        (lwphw-probe-fixture integrated candidate proposal placement probe)))
(defn lwphw-open-placement (field-fixture)
    (do
        (let candidate (lwphw-field-candidate field-fixture))
        (lwphw-integrate-probe field-fixture
            (lwphw-open-probe-world field-fixture)
            (lwphw-open-probe candidate))))
(defn lwphw-observed-placement (field-fixture)
    (do
        (let candidate (lwphw-field-candidate field-fixture))
        (lwphw-integrate-probe field-fixture
            (lwphw-observed-probe-world field-fixture)
            (lwphw-observed-probe candidate))))

(defn lwphw-revoked-observed-world (field-fixture)
    (do
        (let placement (lwphw-observed-placement field-fixture))
        (let world (lwt-round-world (lwphw-probe-round placement)))
        (let probe (lwphw-probe-cell placement))
        (lwt-receive-stream world
            (list
                (lwphw-entry-m
                    (lwo-revocation probe (lwphw-source-m)
                        (lwphw-reason) (lwphw-prov-m)))))))
(defn lwphw-revoked-add-world (field-fixture)
    (lwt-receive-stream
        (lwt-round-world (lwphw-field-round field-fixture))
        (list
            (lwphw-entry-c
                (lwo-revocation (lwphw-add) (lwphw-source-c)
                    (lwphw-reason) (lwphw-prov-c))))))
