; preludes: form-stdlib/primitive-registry.fk
;
; primitive-registry-band — the common native table answers its own
; declared outsides, four ways.
;
; Every native the kernels share carries (name, category, spec,
; verification probe, expected outside, lane) in primitive-registry.fk.
; This band runs every lane-1 probe on each kernel and refuses a part that
; claims an outside its probe cannot produce. The counts are the table's
; own; gate/primitive-registry.bml holds the table against main.go's
; natives, fkwu's op table and the Rust and TS registrations.
;
; Band verdict 47 when every claim lands:
;   1   shape: every row well-formed (7 fields, nonempty name + spec,
;       known category token), no duplicate names
;   2   every lane-1 probe answers its declared outside
;   4   the lanes partition the table: lane 1 + lane 0 = every row
;   8   a part claiming a wrong outside is REFUSED: verification compares
;       against the declaration, never against what the probe happens
;       to return
;   32  the table answers as a spec surface: the str_byte_at row declares
;       outside 89 on the access category in lane 1, readable without
;       running it
;
; Expected: 47
;
(do
    (let reg (prim-registry))
    (let total (len reg))
    (let lane1 (prim-mode-count reg 1))

    ; ── 1: shape — every row well-formed, no duplicates ──
    (let c0 (if (and (gt total 0)
                 (and (eq (prim-shapes-ok-count reg) total)
                      (eq (prim-dup-count reg) 0)))
                1 0))

    ; ── 2: every lane-1 verification answers its declared outside ──
    (let c1 (if (and (gt lane1 0) (eq (prim-verified-count reg) lane1)) 2 0))

    ; ── 4: the lanes partition the table ──
    (let c2 (if (eq (add lane1 (prim-mode-count reg 0)) total) 4 0))

    ; ── 8: a wrong claimed outside is refused ──
    (defn pv-bad-probe () 7)
    (let bad-part (prim "pv-bad-probe" "method" "claims 8, yields 7" pv-bad-probe 8 1))
    (let c3 (if (prim-verified? bad-part) 0 8))

    ; ── 32: the table reads back as a spec surface ──
    (let byte-entry (prim-find reg "str_byte_at"))
    (let c5 (if (and (eq (prim-expected byte-entry) 89)
                 (and (str_eq (prim-category byte-entry) "access")
                      (eq (prim-mode byte-entry) 1)))
                32 0))

    ; ── the arm names what it does not hold, probe by probe ──
    ; A kernel that answers every declared outside prints nothing here; one
    ; that does not prints one row per lane-1 probe that answers otherwise.
    (defn prim-pending-rows (entries)
        (if (eq (len entries) 0) 0
            (do (if (eq (prim-mode (head entries)) 1)
                    (if (prim-verified? (head entries)) 0
                        (print (list "pending" (prim-name (head entries)) "declared" (prim-expected (head entries)))))
                    0)
                (prim-pending-rows (tail entries)))))
    (prim-pending-rows reg)

    (add c0 (add c1 (add c2 (add c3 c5)))))
