; living-world-session-expression-witness.fk -- a minimized session derivation
; may acquire and lose an opaque participant-learned surface without raw text.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/native-model-evidence.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-session-observation.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-session-observation-witness.fk

(let LWRSX-COORDINATE (bp "LWRSX-COORDINATE"))
(let LWRSX-EVIDENCE (bp "LWRSX-EVIDENCE"))
(let LWRSX-PROVENANCE-A (bp "LWRSX-PROVENANCE-A"))
(let LWRSX-PROVENANCE-B (bp "LWRSX-PROVENANCE-B"))
(let LWRSX-RESPONSE-PROVENANCE (bp "LWRSX-RESPONSE-PROVENANCE"))
(let LWRSX-REASON (bp "LWRSX-REASON"))

(defn lwrsx-entry (source payload provenance)
    (lwt-entry
        (lwo-offer source (lwo-interface (list LWRSW-ACTION)) 1
            payload provenance 1)
        LWRSW-ACTION))
(defn lwrsx-response-entry (proposal)
    (lwrsx-entry LWRSW-OWNER
        (lwt-response proposal (oac-one proposal)
            LWRSX-RESPONSE-PROVENANCE)
        LWRSX-RESPONSE-PROVENANCE))
(defn lwrsx-revocation-entry (source observation)
    (lwrsx-entry source
        (lwo-revocation observation source LWRSX-REASON
            LWRSX-RESPONSE-PROVENANCE)
        LWRSX-RESPONSE-PROVENANCE))

(defn lwrsx-run (started)
    (do
        (let session-result (lwrsw-run started))
        (let session-world (nth session-result 14))
        (let prediction (nth session-result 16))
        (let derivation
            (head (lwo-field-items
                (lwtf-prediction-derivations prediction))))
        (let surface-observation
            (lwsl-observation-at derivation LWRSX-COORDINATE "q0"
                LWRSW-LENS (oac-one derivation) LWRSX-EVIDENCE))

        (let observe-enter
            (lcfb-call-stream "living-world-session-expression"
                "observe-surface" "enter" "form-native"
                "lwsl-observation-at" "opaque-derived-surface" 13 started
                "form/form-stdlib/tests/living-world-session-expression-witness.fk"
                41 13))
        (let observed-world
            (lwt-receive-stream session-world
                (list
                    (lwrsx-entry LWRSW-OWNER surface-observation
                        LWRSX-PROVENANCE-A)
                    (lwrsx-entry LWRSW-OWNER surface-observation
                        LWRSX-PROVENANCE-B))))
        (let observe-leave
            (lcfb-call-stream "living-world-session-expression"
                "observe-surface" "leave" "form-native"
                "lwsl-observation-at" "opaque-derived-surface" 14 started
                "form/form-stdlib/tests/living-world-session-expression-witness.fk"
                54 13))

        (let integrate-enter
            (lcfb-call-stream "living-world-session-expression"
                "consent-surface" "enter" "form-native"
                "lwsl-integrate" "one-owner-one-vote" 15 started
                "form/form-stdlib/tests/living-world-session-expression-witness.fk"
                61 13))
        (let proposals (lwsl-proposals observed-world 2))
        (let proposal (head (lwo-field-items proposals)))
        (let round
            (lwt-round observed-world proposals (lwo-empty-field) (lwo-none)))
        (let responded
            (lwt-round-receive round (list (lwrsx-response-entry proposal))))
        (let integrated
            (lwsl-integrate responded proposal LWRSW-ACTION))
        (let voice-world (lwt-round-world integrated))
        (let symbol-candidate (lwt-proposal-candidate proposal))
        (let integrate-leave
            (lcfb-call-stream "living-world-session-expression"
                "consent-surface" "leave" "form-native"
                "lwsl-integrate" "one-owner-one-vote" 16 started
                "form/form-stdlib/tests/living-world-session-expression-witness.fk"
                77 13))

        (let project-enter
            (lcfb-call-stream "living-world-session-expression"
                "project-expression" "enter" "form-native"
                "lwtx-plan-for" "session-derivation" 17 started
                "form/form-stdlib/tests/living-world-session-expression-witness.fk"
                84 13))
        (let symbols (lwo-field (list symbol-candidate)))
        (let plan (lwtx-plan-for voice-world prediction symbols))
        (let project-leave
            (lcfb-call-stream "living-world-session-expression"
                "project-expression" "leave" "form-native"
                "lwtx-plan-for" "session-derivation" 18 started
                "form/form-stdlib/tests/living-world-session-expression-witness.fk"
                92 13))

        (let revoke-enter
            (lcfb-call-stream "living-world-session-expression"
                "revoke-surface" "enter" "form-native"
                "lwo-revocation" "foreign-refused-owner-honored" 19 started
                "form/form-stdlib/tests/living-world-session-expression-witness.fk"
                99 13))
        (let foreign-world
            (lwt-receive-stream voice-world
                (list (lwrsx-revocation-entry
                        LWRSW-FOREIGN surface-observation))))
        (let foreign-plan (lwtx-plan-for foreign-world prediction symbols))
        (let revoked-world
            (lwt-receive-stream foreign-world
                (list (lwrsx-revocation-entry
                        LWRSW-OWNER surface-observation))))
        (let after-revoke
            (lwtx-plan-for revoked-world prediction symbols))
        (let revoke-leave
            (lcfb-call-stream "living-world-session-expression"
                "revoke-surface" "leave" "form-native"
                "lwo-revocation" "foreign-refused-owner-honored" 20 started
                "form/form-stdlib/tests/living-world-session-expression-witness.fk"
                116 13))

        (list session-world prediction derivation surface-observation
              observed-world proposal voice-world symbol-candidate plan
              foreign-world foreign-plan revoked-world after-revoke)))

(defn lwrsx-verdict (r)
    (do
        (let session-world (nth r 0))
        (let prediction (nth r 1))
        (let derivation (nth r 2))
        (let observation (nth r 3))
        (let observed-world (nth r 4))
        (let proposal (nth r 5))
        (let voice-world (nth r 6))
        (let symbol (nth r 7))
        (let plan (nth r 8))
        (let foreign-world (nth r 9))
        (let foreign-plan (nth r 10))
        (let revoked-world (nth r 11))
        (let after-revoke (nth r 12))
        (sum (list
            (if (eq (lwtf-derivation-current?
                        session-world derivation) 1) 1 0)
            (if (eq (lwsl-observation-valid? observation) 1) 2 0)
            (if (eq (lwo-field-size
                        (lwo-active-attributions-for
                            observed-world observation)) 2) 4 0)
            (if (not (node_eq proposal (lwo-none))) 8 0)
            (if (eq (lwo-field-size
                        (lwt-proposal-participants proposal)) 1) 16 0)
            (if (eq (lwsl-integrated-current? voice-world symbol) 1) 32 0)
            (if (eq (lwtx-plan-current? voice-world plan) 1) 64 0)
            (if (eq (lwo-field-size (lwtx-plan-surfaces plan)) 1) 128 0)
            (if (eq (lwo-field-size (lwtx-plan-unvoiced plan)) 0) 256 0)
            (if (eq (oac-one? (lwtx-plan-ack plan)) 1) 512 0)
            (if (str_eq (lwtx-surface-text
                            (oac-payload (lwtx-plan-ack plan))) "q0") 1024 0)
            (if (and (node_eq (lwtx-plan-alternatives plan)
                                (lwtf-prediction-alternatives prediction))
                     (node_eq (lwtx-plan-unknown plan)
                                (lwtf-prediction-unknown prediction))) 2048 0)
            (if (and (eq (lwsl-integrated-current?
                            foreign-world symbol) 1)
                     (eq (lwtx-plan-current?
                            foreign-world foreign-plan) 1)) 4096 0)
            (if (eq (lwsl-integrated-current?
                        revoked-world symbol) 0) 8192 0)
            (if (and (eq (lwo-active? revoked-world symbol) 1)
                     (and (eq (lwo-field-size
                                (lwtx-plan-surfaces after-revoke)) 0)
                          (and (eq (lwo-field-size
                                    (lwtx-plan-unvoiced after-revoke)) 1)
                               (eq (oac-nothing?
                                    (lwtx-plan-ack after-revoke)) 1)))) 16384 0)))))
