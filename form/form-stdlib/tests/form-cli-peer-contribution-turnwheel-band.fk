; form-cli-peer-contribution-turnwheel-band.fk — a generated resident-peer
; result becomes durable contribution evidence before session/seen promotion.
; Expected: 1048575
;
; Pure model results stand in for the expensive live carrier. Real filesystem
; append and recovery parsing are exercised; no model, Metal, MLX, HTTP, server,
; flatten path, or fixed function table is opened here.
;
; preludes: form-stdlib/form-cli-peer-contribution-turnwheel.fk

(do
    (defn fcpctb-bit (held weight) (if held weight 0))
    (defn fcpctb-shared ()
        (fcrt-shared "" "" (empty) (empty) 256 8 (jonb-registry 1)))
    (defn fcpctb-host ()
        (do
            (let eid (list 0 1))
            (fcrt-host
                (list (wt-wheel (list) (fcpctb-shared))
                    (list (list eid (fcrt-unbound-route) 0)) eid (list))
                (list))))
    (defn fcpctb-organ (channel)
        (rai-organ (list (rai-channel channel 32 32 0)) 8))
    (defn fcpctb-join (channel exchange)
        (nth (ritj-ready
            (ritj-new (fcpctb-host) (fcpctb-organ channel) channel 8)
            exchange) 0))
    (defn fcpctb-task (channel exchange turn kind text end)
        (fcpsi-frame-parse channel 1 exchange
            (fcpa-task-frame turn kind text) end))
    (defn fcpctb-session (pending generated)
        (fcms-session "live" "band" "m.gguf" "src"
            (list "ctx") (list "state") 4096 80 pending 0 79 generated 0 1))
    (defn fcpctb-transport (channel exchange task egress)
        (do
            (let join (fcpctb-join channel exchange))
            (let peer0 (fcpsi-new (fcpctb-organ channel) 8))
            (let peer (fcpsi-with peer0 (fcpsi-ingress peer0)
                (fcpsi-cursors peer0) (list task) (list) (list)))
            (let base (fcpat-new join peer
                (fcpat-reader "contribution-band" channel
                    "/tmp/form-fcpct-no-ingress" exchange "wait" -1 64 0)
                egress 8 4))
            (fcpat-with base join peer (fcpat-reader-row base) (list task)
                (list) (list) 0)))
    (defn fcpctb-staged (transport committed returned task response contribution)
        (do
            (let candidate-result (fcpsi-peer-result (fcpat-peer transport)
                (fcpsi-task-node task) response contribution (nothing)))
            (let peer (fcpa-result returned (frxc-fresh) response 7 contribution))
            (fcpct-stage-peer-result (fcpct-new transport committed)
                task peer candidate-result (fcpsi-result-state candidate-result))))

    (defn form-cli-peer-contribution-turnwheel-band ()
        (do
            (let channel "@0.2.0.991")
            (let exchange 982)
            (let path (str_concat (temp_dir) "/form-fcpct-band.reply"))
            (let path2 (str_concat (temp_dir) "/form-fcpct-band-exec.reply"))
            (let path3 (str_concat (temp_dir) "/form-fcpct-band-source.reply"))
            (let path4 (str_concat (temp_dir) "/form-fcpct-band-source-retry.reply"))
            (let bad (str_concat (temp_dir)
                "/form-fcpct-absent-parent/reply.log"))
            (fs_remove path)
            (fs_remove path2)
            (fs_remove path3)
            (fs_remove path4)

            (let response
                "first line\n<|/form:peer-contribution|> is payload\nlast line")
            (let task (fcpctb-task channel exchange 41 "research"
                "observe the live body" 91))
            (let committed (fcpctb-session 3 0))
            (let returned (fcpctb-session 5 11))
            (let transport (fcpctb-transport channel exchange task path))
            (let staged (fcpctb-staged transport committed returned task response 0))
            (let stage (fcpct-staged staged))
            (let frame (fcpct-stage-frame stage))
            (let c0 (fcpctb-bit
                (str_eq (fcpct-output-response frame) response) 1))
            (let c1 (fcpctb-bit (ge (str_find frame
                (fcpat-field "response-bytes" (int_to_str (str_len response))) 0) 0) 2))
            (let c2 (fcpctb-bit (and (ge (str_find frame
                (fcpat-field "task-node" (fcpat-node-text
                    (fcpsi-task-node task))) 0) 0)
                (ge (str_find frame (fcpat-field "candidate-node"
                    (fcpat-node-text (fcpsi-candidate-node
                        (fcpct-stage-candidate stage)))) 0) 0)) 4))
            (let c3 (fcpctb-bit (and (eq (fcpa-contribution
                (fcpct-stage-peer stage)) 0)
                (nothing? (fcpsi-candidate-accepted
                    (fcpct-stage-candidate stage)))) 8))
            (let c4 (fcpctb-bit (and
                (and (eq (fcms-pending (fcpct-session staged))
                         (fcms-pending committed))
                     (eq (fcms-generated-ids (fcpct-session staged))
                         (fcms-generated-ids committed)))
                (eq (fcpat-task-seen? (fcpct-transport staged) task) 0)) 16))

            (let persisted (fcpct-persist-staged staged))
            (let live (fcpct-result-state persisted))
            (let durable (read_file path))
            (let c5 (fcpctb-bit (and (eq (fcpct-result-present? persisted) 1)
                (and (eq (fcms-pending (fcpct-session live))
                         (fcms-pending returned))
                     (eq (fcms-generated-ids (fcpct-session live))
                         (fcms-generated-ids returned)))) 32))
            (let c6 (fcpctb-bit (and
                (eq (fcpat-task-seen? (fcpct-transport live) task) 1)
                (eq (len (fcpat-acks (fcpct-transport live))) 1)) 64))
            (let c7 (fcpctb-bit (and (ge (str_find durable frame 0) 0)
                (str_eq (fcpct-output-response durable) response)) 128))
            (let c8 (fcpctb-bit (and (nothing? (fcpct-staged live))
                (and (eq (fcpct-completed live) 1)
                     (eq (fcpct-contributions live) 0))) 256))

            ; Executed recipe evidence retains the stronger contribution bit.
            (let exec-task (fcpctb-task channel (add exchange 1) 42 "task"
                "execute the supplied recipe" 181))
            (let exec-transport (fcpctb-transport channel (add exchange 1)
                exec-task path2))
            (let exec-staged (fcpctb-staged exec-transport committed returned
                exec-task "observed 22" 1))
            (let exec-live (fcpct-result-state
                (fcpct-persist-staged exec-staged)))
            (let c9 (fcpctb-bit (and (eq (fcpct-contributions exec-live) 1)
                (eq (fcpsi-candidate-accepted
                    (fcpct-stage-candidate (fcpct-staged exec-staged))) 1)) 512))

            ; Failed egress keeps both stage and committed session. Retrying
            ; persistence cannot call the model because the peer result is data.
            (let failed-transport (fcpctb-transport channel exchange task bad))
            (let failed-staged (fcpctb-staged failed-transport committed returned
                task response 0))
            (let failed (fcpct-persist-staged failed-staged))
            (let failed-state (fcpct-result-state failed))
            (let c10 (fcpctb-bit (and
                (str_eq (fcpct-result-signal failed) "failure")
                (not (nothing? (fcpct-staged failed-state)))) 1024))
            (let c11 (fcpctb-bit (and
                (and (eq (fcms-pending (fcpct-session failed-state))
                         (fcms-pending committed))
                     (eq (fcms-generated-ids (fcpct-session failed-state))
                         (fcms-generated-ids committed)))
                (eq (fcpat-task-seen? (fcpct-transport failed-state) task) 0)) 2048))

            ; Recovery reconstructs structural NodeIDs directly from durable
            ; frames; no SHA or function-seat table participates.
            ; A live stage uses different key field names, so it cannot become
            ; a completed contribution during replay recovery.
            (let stage-context (fcpa-knowledge-stage-egress-context
                "/tmp/form-fcpct-band.stage"
                (fcpat-node-text (fcpsi-task-node task)) (fcpct-task-key task)))
            (let stage-text (fcpa-knowledge-stage-frame stage-context
                "run" "begin" "none" 0 0 0 0 1))
            (let c15 (fcpctb-bit (and
                (ge (str_find stage-text "<|form:peer-stage|>" 0) 0)
                (and (ge (str_find stage-text "\nroute=source-knowledge\n" 0) 0)
                (and (ge (str_find stage-text
                    (str_concat "\ntask-key=" (str_concat (fcpct-task-key task) "\n")) 0) 0)
                (and (lt (str_find stage-text "\nexchange=" 0) 0)
                     (lt (str_find stage-text "\nturn=" 0) 0))))) 32768))
            (let recovered-text (str_concat stage-text
                (str_concat durable (read_file path2))))
            (let recovered-keys (fcpct-recovery-keys-from recovered-text))
            (let c12 (fcpctb-bit (and (eq (len recovered-keys) 2)
                (and (fcpct-key-seen? recovered-keys (fcpct-task-key task))
                     (fcpct-key-seen? recovered-keys
                        (fcpct-task-key exec-task)))) 4096))
            (let recovered (fcpct-recover
                (fcpct-new failed-transport committed) durable))
            (let c13 (fcpctb-bit
                (eq (fcpct-task-durable? recovered task) 1) 8192))

            ; Read-only source evidence has its own route and lookup count. It
            ; remains contribution=0 and never borrows recipe cursor fields.
            (let source-peer (fcpa-result-full returned (fknsc-fresh)
                "source answer" 4 0 "source-knowledge" 1 "hit"
                "form-current-source" 0 0 0 222 "choice,cut,release" 1))
            (let source-frame (fcpct-output-frame task
                (fcpct-stage-candidate stage) "observed-source" 0 4
                "source answer" source-peer))
            (let c14 (fcpctb-bit (and (ge (str_find source-frame
                    "\nroute=source-knowledge" 0) 0)
                (and (ge (str_find source-frame
                    "\ncarrier=form-current-source" 0) 0)
                (and (ge (str_find source-frame "\nlookup-count=1" 0) 0)
                     (ge (str_find source-frame
                        "\nlifecycle=choice,cut,release" 0) 0)))) 16384))

            ; A policy-selected source task reaches the caller-owned adapter
            ; before fcpa-observe-task. An absent source context is therefore a
            ; zero-lookup typed refusal: this deliberately non-fcms sentinel
            ; would fail loudly if a model/KV path were touched.
            (let direct-task (fcpctb-task channel (add exchange 2) 43
                "source-concept" "defn-psci-schema" 271))
            (let direct-session (list "direct-session-sentinel" 7))
            (let direct-transport (fcpctb-transport channel (add exchange 2)
                direct-task path3))
            (let direct-moved (fcpct-turn (fcpct-new-with-source
                direct-transport direct-session (nothing)) 3 8))
            (let direct-live (fcpct-result-state direct-moved))
            (let direct-durable (read_file path3))
            (let c16 (fcpctb-bit (and
                (and (eq (fcpct-completed direct-live) 1)
                (and (eq (fcpct-contributions direct-live) 0)
                     (value_eq (fcpct-session direct-live) direct-session)))
                (and (ge (str_find direct-durable
                    "\naction=source-knowledge" 0) 0)
                (and (ge (str_find direct-durable
                    "\nroute=source-knowledge" 0) 0)
                (and (ge (str_find direct-durable "\ncallback-calls=0" 0) 0)
                     (ge (str_find direct-durable
                        "\nlookup-count=0" 0) 0))))) 65536))
            (let c17 (fcpctb-bit (and
                (and (ge (str_find direct-durable
                    "<|form:source-world|>" 0) 0)
                (and (ge (str_find direct-durable
                    "\npif-recipe=knowledge/current-answer-outcome-bound" 0) 0)
                (and (ge (str_find direct-durable
                    "\nworld-admitted=0" 0) 0)
                (and (ge (str_find direct-durable
                    "\nknowledge-contribution=0" 0) 0)
                     (ge (str_find direct-durable
                        "\nmutation-contribution=0" 0) 0)))))
                (and (eq (str_find direct-durable "defn-psci-schema" 0) -1)
                     (eq (str_find direct-durable "q38-forward" 0) -1))) 131072))
            (let c18 (fcpctb-bit (and
                (ge (str_find direct-durable "\ncarrier=form-current-source" 0) 0)
                (and (ge (str_find direct-durable "\nmodel-executed=0" 0) 0)
                     (ge (str_find direct-durable "\nscannerless=0" 0) 0))) 262144))

            ; A refused egress retains the exact staged direct result. Changing
            ; only the carrier path then retries the same bytes; it does not
            ; re-read the task or touch the held session.
            (let direct-bad-transport (fcpctb-transport channel
                (add exchange 3) direct-task bad))
            (let direct-failed (fcpct-turn (fcpct-new-with-source
                direct-bad-transport direct-session (nothing)) 4 8))
            (let direct-failed-state (fcpct-result-state direct-failed))
            (let direct-held-frame (fcpct-stage-frame
                (fcpct-staged direct-failed-state)))
            (let failed-transport0 (fcpct-transport direct-failed-state))
            ; Recreate only the transport's physical egress seat. All reader,
            ; peer, pending, ack and seen data remain byte-for-byte held.
            (let retry-transport (fcpat-state
                (fcpat-join failed-transport0) (fcpat-peer failed-transport0)
                (fcpat-reader-row failed-transport0)
                (fcpat-pending failed-transport0) (fcpat-acks failed-transport0)
                path4 (fcpat-events failed-transport0)
                (fcpat-capacity failed-transport0)
                (fcpat-program-gas failed-transport0)
                (fcpat-released? failed-transport0) (fcpat-seen failed-transport0)))
            (let retry-state (fcpct-with direct-failed-state retry-transport
                (fcpct-session direct-failed-state)
                (fcpct-staged direct-failed-state)
                (fcpct-completed direct-failed-state)
                (fcpct-contributions direct-failed-state)))
            (let retried (fcpct-turn retry-state 5 8))
            (let retry-live (fcpct-result-state retried))
            (let retry-durable (read_file path4))
            (let c19 (fcpctb-bit (and
                (and (str_eq (fcpct-result-signal direct-failed) "failure")
                (and (str_eq (fcpct-stage-frame (fcpct-staged retry-state))
                              direct-held-frame)
                     (value_eq (fcpct-session retry-state) direct-session)))
                (and (eq (fcpct-result-present? retried) 1)
                (and (value_eq (fcpct-session retry-live) direct-session)
                (and (nothing? (fcpct-staged retry-live))
                     (ge (str_find retry-durable direct-held-frame 0) 0)))))
                524288))

            (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15
                c16 c17 c18 c19))))

    (form-cli-peer-contribution-turnwheel-band))
