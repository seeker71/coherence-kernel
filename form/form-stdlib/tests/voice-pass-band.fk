; voice-pass-band.fk — the mouth's pass, held against the crossing it replaces.
;
; Every number pinned below was produced twice on 2026-09-09: once by the body
; (`voice-pass.bml` on this Mac's own metal, weights read straight off the model file by
; `voice-onnx.bml`) and once by onnxruntime running the SAME model on the SAME phoneme row.
; The row is the one `voice-onnx-band.fk` already proved identical to piper's own, so a
; disagreement here is the pass's arithmetic and nothing else's.
;
; BOTH SIDES RENDER WITH THE NOISE SCALES AT ZERO. A VITS draws two normal samples, one for the
; duration predictor and one for the latent. With their scales at zero the graph is a function of
; its input and a reference can be held against it digit for digit; with them at their defaults
; neither side could reproduce the other and the only honest claim would be "it sounds right".
;
; Three voices, because they are not the same machine: jenny is medium (HiFi-GAN ResBlock2, three
; upsamples, its folded scalars hoisted into the initializer list), cori is high (ResBlock1, four
; upsamples, twelve blocks, its scalars left as Constant NODES), and amir is a third tongue. The
; pass holds no number any of them holds: kernel widths, strides, pads, dilations, groups, layer
; counts, epsilons, slopes, tail bounds and bin counts are all read out of each file.
;
; The band is silent: it opens no audio device and plays nothing. `observe/voice-room-witness.fk`
; is the door that speaks and listens.
;
;   1     the door opens: every kernel compiled, the model mapped, every scalar resolved
;   2     the structure the pass READ, not one it was told: 132 convolutions, six encoder layers,
;         coupling flows 6 4 2 0, duration flows 7 5 3, three upsamples, nine residual blocks
;   4     the constants read out of the file are the file's own
;   8     NAMEWASH: the flow's fused weights resolve through the node that reads them, and flow 0
;         reads the LAST fused group — file order would have handed it the first
;   16    a 65-id row gives a 192 x 65 encoder
;   32    the alignment answers 125 frames, which is the reference's own 32000 samples / 256
;   64    six probed samples agree with onnxruntime inside 1e-5
;   128   the whole line's absolute sum agrees inside 0.01
;   256   the HIGH voice — other residual block, other upsample count, other constant shelf —
;         answers 145 frames and its six samples agree
;   512   a third tongue answers 200 frames and its six samples agree
;   1024  a file that is not a model REFUSES at the door instead of rendering something
;   2048  the samples leave as signed 16-bit, two bytes each, ready for the seed's own mouth
;
; Expected: 4095
; Verdict 4095
; PROOF LEVEL: FOURTH-ARM ONLY (Metal dispatches and host file reads over the voice store)
; preflight-exec: forbidden
; preludes: form/form-stdlib/voice-pass.bml form/form-stdlib/voice-say.bml
(do
    (defn pb-bit (ok v) (if ok v 0))
    (defn pb-ids () (list 1 0 41 0 59 0 3 0 15 0 120 0 52 0 17 0 74 0 119 0 3 0 74 0 38 0 3 0 24 0 120 0 62 0 122 0 26 0 74 0 44 0 3 0 32 0 59 0 3 0 31 0 28 0 120 0 21 0 122 0 23 0 10 0 2))
    (defn pb-at () (list 0 1000 5000 10000 20000 30000))
    (defn pb-tol () 0.00001)
    (defn pb-near? (a b) (le (vv-abs (sub a b)) (pb-tol)))
    (defn pb-probe (o idx) (if (eq (len idx) 0) (list) (cons (head (vv-read o (head idx) 1)) (pb-probe o (tail idx)))))
    (defn pb-all-near? (xs ys) (if (eq (len xs) 0) 1 (if (eq (len ys) 0) 0 (if (pb-near? (head xs) (head ys)) (pb-all-near? (tail xs) (tail ys)) 0))))
    (defn pb-fabs-go (xs acc) (if (eq (len xs) 0) acc (pb-fabs-go (tail xs) (add acc (vv-abs (head xs))))))
    (defn pb-itext (xs) (if (eq (len xs) 0) "" (str_concat (int_to_str (head xs)) (str_concat (if (eq (len (tail xs)) 0) "" " ") (pb-itext (tail xs))))))

    ; ---- the medium voice: the pass, whole ----
    (let mp (vp-model-path "en_GB-jenny_dioco-medium"))
    (let st (vv-open mp))
    (let ids (pb-ids))
    (let b1 (pb-bit (eq (vv-open-ok? st) 1) 1))
    (let b2 (pb-bit (if (eq (len (vv-ctab st)) 132)
                       (if (eq (vv-nlayers st 0) 6)
                           (if (str_eq (pb-itext (vv-rcl-list st)) "6 4 2 0")
                               (if (str_eq (pb-itext (vv-cf-list st)) "7 5 3")
                                   (if (eq (vv-nups st 0) 3) (eq (vv-nres st 0) 9) 0) 0) 0) 0) 0) 2))
    (let b4 (pb-bit (if (str_eq (float_to_str (vv-eps st)) "0.00001")
                       (if (str_eq (float_to_str (vv-escale st)) "13.856406")
                           (if (eq (vv-ffnpad st) 1) (str_eq (float_to_str (vv-decdiv st)) "3") 0) 0) 0) 4))
    ; the first coupling flow reads the LAST group of fused kernels: `onnx::Conv_8240`, not
    ; `onnx::Conv_8168`. The export wrote the flows in the order the REVERSE pass runs them, so a
    ; hand mapping fused tensors by file position wires flow 0 to flow 6's weights and hears
    ; something plausible. The node that READS a weight kept its own name; that is the repair.
    (let b8 (pb-bit (if (str_eq (vv-cw (vv-crow st "/flow/flows.0/enc/in_layers.0/Conv")) "onnx::Conv_8240")
                       (str_eq (vv-cw (vv-crow st "/flow/flows.6/enc/in_layers.0/Conv")) "onnx::Conv_8168") 0) 8))
    (let enc (vv-enc st ids))
    (let sy0 (metal_sync))
    (let b16 (pb-bit (if (eq (vv-tc (head enc)) 192) (eq (vv-tl (head enc)) 65) 0) 16))
    (let o (vv-render st ids 1.0))
    (let b32 (pb-bit (eq (vv-tn o) 32000) 32))
    (let b64 (pb-bit (pb-all-near? (pb-probe o (pb-at)) (list -0.000291 -0.000022 0.017091 -0.051347 0.022156 -0.005939)) 64))
    (let b128 (pb-bit (le (vv-abs (sub (pb-fabs-go (vv-read o 0 (vv-tn o)) 0.0) 1161.415397)) 0.01) 128))
    ; ---- the samples as the seed's mouth wants them ----
    (let pcm (vv-pcm st o))
    (let b2048 (pb-bit (eq (str_len pcm) 64000) 2048))

    ; ---- the high voice: another residual block, another upsample count, another shelf ----
    (let hp (vp-model-path "en_GB-cori-high"))
    (let hst (vv-open hp))
    (let ho (vv-render hst ids 1.0))
    (let b256 (pb-bit (if (eq (vv-open-ok? hst) 1)
                         (if (eq (vv-nups hst 0) 4)
                             (if (eq (vv-nres hst 0) 12)
                                 (if (eq (vv-tn ho) 37120)
                                     (pb-all-near? (pb-probe ho (pb-at)) (list -0.000236 0.00002 -0.01669 -0.002285 -0.016712 -0.060903)) 0) 0) 0) 0) 256))

    ; ---- a third tongue ----
    (let fp (vp-model-path "fa_IR-amir-medium"))
    (let fst (vv-open fp))
    (let fo (vv-render fst ids 1.0))
    (let b512 (pb-bit (if (eq (vv-tn fo) 51200)
                         (pb-all-near? (pb-probe fo (pb-at)) (list 0.000683 0.000312 0.001054 0.000106 -0.039021 -0.001804)) 0) 512))

    ; ---- and a file that is not a model ----
    ; the voice's own .onnx.json fails the structural check, so the table is empty, no scalar
    ; resolves and the door says so. A pass that answered zeros here would be the ear's
    ; 7720-confident-rows wound wearing a mouth.
    (let jst (vv-open (str_concat mp ".json")))
    (let b1024 (pb-bit (if (eq (vv-open-ok? jst) 0) (gt (str_len (vv-open-why jst)) 0) 0) 1024))

    (add b1 (add b2 (add b4 (add b8 (add b16 (add b32 (add b64 (add b128 (add b256 (add b512 (add b1024 b2048)))))))))))
)
