; form-knowledge-grammar-recursive-query-observed-band.fk -- focused evidence.
;
; Expected: 65535
; preludes: form-stdlib/form-knowledge-grammar-recursive-query-observed.fk

(do
    (defn fkgqob-bit (ok bit) (if ok bit 0))
    (defn fkgqob-with
        (path artifact frames lookups hits commits matches mismatches promotion
         answer95 transport release heldout learned supervised local remote)
        (fkgqo-record-with path artifact frames lookups hits commits matches
            mismatches 11 (fkgqo-answer) promotion answer95 transport release
            heldout learned supervised local remote))
    (let offer (fkgqo-offer))
    (let base (fkgqo-observation))
    (let wrong-source (fkgqob-with "grammars/other.fk"
        (fkpqo-offer-source-id offer) 2 2 2 2 2 0 500000 0 1 1 0 0 1 1 0))
    (let wrong-artifact (fkgqob-with (fkpqo-offer-path offer)
        "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        2 2 2 2 2 0 500000 0 1 1 0 0 1 1 0))
    (let wrong-count (fkgqob-with (fkpqo-offer-path offer)
        (fkpqo-offer-source-id offer) 2 1 2 2 2 0 500000 0 1 1 0 0 1 1 0))
    (let wrong-binding (fkgqob-with (fkpqo-offer-path offer)
        (fkpqo-offer-source-id offer) 2 2 2 2 1 1 500000 0 1 1 0 0 1 1 0))
    (let forged-score (fkgqob-with (fkpqo-offer-path offer)
        (fkpqo-offer-source-id offer) 2 2 2 2 2 0 1000000 1 1 1 0 0 1 1 0))
    (let forged-credit (fkgqob-with (fkpqo-offer-path offer)
        (fkpqo-offer-source-id offer) 2 2 2 2 2 0 500000 0 1 1 1 1 0 1 0))
    (sum (list
        (fkgqob-bit (eq (fkgqo-valid? base) 1) 1)
        (fkgqob-bit (and (eq (fkgqo-frames base) 2)
                          (eq (fkgqo-frames base) (MaxHeeds))) 2)
        (fkgqob-bit (and (eq (fkgqo-lookups base) 2)
                     (and (eq (fkgqo-hits base) 2)
                          (eq (fkgqo-commits base) 2))) 4)
        (fkgqob-bit (and (eq (fkgqo-source-matches base) 2)
                          (eq (fkgqo-source-mismatches base) 0)) 8)
        (fkgqob-bit (eq (fkgqo-answer-cut base) 11) 16)
        (fkgqob-bit (and (eq (nmfe-obs-f1 (fkgqo-score (fkgqo-answer))) 636364)
                     (and (eq (nmfe-obs-sequence
                                (fkgqo-score (fkgqo-answer))) 500000)
                          (eq (fkgqo-promotion base) 500000))) 32)
        (fkgqob-bit (and (eq (fkgqo-answer95 base) 0)
                          (eq (fkgqo-transport base) 1)) 64)
        (fkgqob-bit (and (eq (fkgqo-release base) 1)
                     (and (eq (fkgqo-local base) 1)
                          (eq (fkgqo-remote base) 0))) 128)
        (fkgqob-bit (and (eq (fkgqo-heldout-credit base) 0)
                     (and (eq (fkgqo-learned-credit base) 0)
                          (eq (fkgqo-supervised-credit base) 1))) 256)
        (fkgqob-bit (eq (fkgqo-combined-transport) 15) 512)
        (fkgqob-bit (eq (fkgqo-combined-answer95) 10) 1024)
        (fkgqob-bit (eq (fkgqo-valid? wrong-source) 0) 2048)
        (fkgqob-bit (eq (fkgqo-valid? wrong-artifact) 0) 4096)
        (fkgqob-bit (eq (fkgqo-valid? wrong-count) 0) 8192)
        (fkgqob-bit (eq (fkgqo-valid? wrong-binding) 0) 16384)
        (fkgqob-bit (and (eq (fkgqo-valid? forged-score) 0)
                          (eq (fkgqo-valid? forged-credit) 0)) 32768))))
