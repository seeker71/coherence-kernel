; bml-demand-jit-fault-key-probe-b.fk — same allocation shape, different structure.
; preludes: form/form-stdlib/bml-demand-jit.fk

(do
    (let program (list (list 1 0 0) (list 2 1 0)))
    (let pending (bdj-pending "/tmp/source-b" "/tmp/cache-b" program 1 7 301))
    (bdj-fault-id pending 301 "install-challenge" 9001))
