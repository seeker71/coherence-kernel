; form-knowledge-bml-exec-adaptation-observation-band.fk
; Expected: 32767 (15 bits)
;
; preludes: form-stdlib/core.fk form-stdlib/json.fk
; preludes: form-stdlib/str-byte-at.fk form-stdlib/sha256.fk form-stdlib/hex.fk
; preludes: form-stdlib/native-model-evidence.fk form-stdlib/bmf-core.fk
; preludes: form-stdlib/bmf-grammar.fk form-stdlib/grammars/form-bml.fk
; preludes: form-stdlib/form-knowledge-query-token.fk
; preludes: form-stdlib/form-knowledge-exec-diagnostic.fk
; preludes: form-stdlib/form-knowledge-exec-grammar-transport.fk
; preludes: form-stdlib/form-eval-full.fk
; preludes: form-stdlib/form-knowledge-bml-exec-finetune-curriculum.fk
; preludes: form-stdlib/form-knowledge-bml-exec-adaptation-observation.fk

(do
    (defn fkbefaob-bit (ok bit) (if ok bit 0))
    (defn fkbefaob-run ()
        (do
            (let rows (fkbefao-observations))
            (sum (list
                (fkbefaob-bit (eq (len rows) 9) 1)
                (fkbefaob-bit (str_eq (fkbefao-prompt-sha)
                    "dd60156498b9fec6d424b3e0ab89380ad0b5f196198775168aa3a60f99e67bb3") 2)
                (fkbefaob-bit (eq (fkegt-parse-signal (fkbefao-d2-response)
                    (fkegt-max-bytes)) 0) 4)
                (fkbefaob-bit (eq (fkegt-parse-signal (fkbefao-t1-response)
                    (fkegt-max-bytes)) 1) 8)
                (fkbefaob-bit (eq (fkegt-parse-signal (fkbefao-t2-response)
                    (fkegt-max-bytes)) 1) 16)
                (fkbefaob-bit (eq (fkegt-parse-signal (fkbefao-v1-h1-response)
                    (fkegt-max-bytes)) 0) 32)
                (fkbefaob-bit (eq (fkegt-parse-signal (fkbefao-t3-response)
                    (fkegt-max-bytes)) 1) 64)
                (fkbefaob-bit (eq (fkegt-parse-signal (fkbefao-t4-response)
                    (fkegt-max-bytes)) 1) 128)
                (fkbefaob-bit (eq (fkegt-parse-signal (fkbefao-v2-h1-response)
                    (fkegt-max-bytes)) 0) 256)
                (fkbefaob-bit (and (eq (fkbefao-semantic (nth rows 1)) 0)
                    (and (eq (fkbefao-semantic (nth rows 2)) 1)
                    (and (eq (fkbefao-semantic (nth rows 5)) 1)
                         (eq (fkbefao-semantic (nth rows 6)) 1)))) 512)
                (fkbefaob-bit (and (nothing? (fkbefao-semantic (nth rows 0)))
                    (and (nothing? (fkbefao-semantic (nth rows 3)))
                    (and (nothing? (fkbefao-semantic (nth rows 7)))
                         (nothing? (fkbefao-semantic (nth rows 8)))))) 1024)
                (fkbefaob-bit (fkbefao-all-local-released? rows) 2048)
                (fkbefaob-bit (and (str_eq (fkbef-jsonl "train")
                    (read_file "model/fixtures/form-bml-exec-finetune/train.jsonl"))
                    (and (str_eq (fkbef-jsonl "valid")
                        (read_file "model/fixtures/form-bml-exec-finetune/valid.jsonl"))
                         (str_eq (fkbef-jsonl "test")
                        (read_file "model/fixtures/form-bml-exec-finetune/test.jsonl")))) 4096)
                (fkbefaob-bit (and (str_eq (fkbefao-response-sha (nth rows 0))
                    "44c297b133618c5ee7a8928926fbab60430d100dfbad6978800015a34ecc318a")
                    (str_eq (fkbefao-response-sha (nth rows 8))
                    "fe79011e8e5f0c3c6ac90ac60b7226f6efeda5e1ebfb3f9e86db77ffe25eaff8")) 8192)
                (fkbefaob-bit (and (eq (fkbefao-heldout (nth rows 3)) 0)
                    (and (eq (fkbefao-heldout (nth rows 8)) 0)
                         (not (str_eq (fkbefao-v1-adapter-sha)
                                      (fkbefao-v2-adapter-sha))))) 16384)))))
    (fkbefaob-run))
