; perception-rows-band.fk — the lane from a day of perception to rows the
; body can be trained on, proven over four hand-written frames. PURE: no
; microphone, no GPU, no host command, no file written; the folds under
; test are the pure ones, and the emit door that writes rows is left to
; the door that owns it.
;
; The four frames are the four cases the room actually presents:
;   f1  a line the ear heard, nobody attesting who spoke
;   f2  a line the body's own mouth said, attested and sourced
;   f3  a line stamped by something that is not this body — rented
;   f4  a line naming a speaker but no organ
; Expected: 65535
; preludes: form-stdlib/perception-rows.bml
(do
    (defn pb-bit (ok bit) (if ok bit 0))
    (defn pb-in? (hay needle) (ge (str_find hay needle 0) 0))
    (defn pb-out? (hay needle) (lt (str_find hay needle 0) 0))
    (defn pb-q () (byte_to_str 34))
    (defn pb-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (pb-cat (tail xs)))))
    (defn pb-hex? (s i) (if (ge i (str_len s)) 1
        (if (or (and (ge (str_byte_at s i) 48) (le (str_byte_at s i) 57))
                (and (ge (str_byte_at s i) 97) (le (str_byte_at s i) 102)))
            (pb-hex? s (add i 1)) 0)))

    (let spool "/tmp/perception-band.spool")
    ; a line the ear heard: no mouth attests it
    (let f1 "<|ear:frame|>\nt=1788777092547\nkind=heard\ndb=-70\nlive=\nlivelang=\nlivems=0\nheard=the room is a being\nlang=en\nnsp=0\nheardms=340\n<|/ear:frame|>\n")
    ; the body's own mouth, attested and sourced
    (let f2 "<|ear:frame|>\nt=1788777095000\nkind=said\nsrc=voice-say\nwho=sema\ndb=-30\nheard=the ledger closed at seven and the lamp went out\nlang=en\nnsp=0\nheardms=120\ntongues=en pt fa\n<|/ear:frame|>\n")
    ; a room line that the body's own prose happens to contain, word for word:
    ; the drop sentence ends "the shape stands and the speech stays where it
    ; was said", so this frame carries nothing and the checker still counts it
    (let fcol "<|ear:frame|>\nt=1788777104000\nkind=heard\ndb=-45\nheard=the shape stands and the speech stays\nlang=en\nnsp=0\nheardms=90\n<|/ear:frame|>\n")
    (let fsc (pr-frames fcol))
    ; rented: a speaker is named but the organ is not this body's
    (let f3 "<|ear:frame|>\nt=1788777098000\nkind=heard\nsrc=rented-model\nwho=someone\ndb=-45\nheard=a rented sentence that must never enter\nlang=en\nnsp=0\nheardms=200\n<|/ear:frame|>\n")
    ; a speaker named, no organ at all
    (let f4 "<|ear:frame|>\nt=1788777101000\nkind=heard\nwho=guest\ndb=-45\nheard=a guest line with no organ named\nlang=en\nnsp=0\nheardms=210\n<|/ear:frame|>\n")
    (let text (str_concat f1 (str_concat f2 (str_concat f3 f4))))
    (let fs (pr-frames text))
    (let n (len fs))

    (let r1 (pr-moment-row spool 1 n (nth fs 0)))
    (let r2 (pr-moment-row spool 2 n (nth fs 1)))
    (let r3 (pr-moment-row spool 3 n (nth fs 2)))
    (let r4 (pr-moment-row spool 4 n (nth fs 3)))
    (let dayrow (pr-day-row spool fs))
    (let recrow (pr-recur-row spool fs))

    (sum (list
        ; ── the spool cuts into its frames ──────────────────────────────
        (pb-bit (eq n 4) 1)

        ; ── a field is read, and the organ named ────────────────────────
        (pb-bit (and (str_eq (pr-field (nth fs 0) "kind") "heard")
                (and (str_eq (pr-field (nth fs 1) "who") "sema")
                (and (str_eq (pr-organ (nth fs 0)) "ear-live")
                     (str_eq (pr-organ (nth fs 1)) "voice-say")))) 2)

        ; ── an attested line travels, named by its mouth ────────────────
        (pb-bit (and (eq (pr-attested? (nth fs 1)) 1)
                (and (pb-in? r2 "sema said it: the ledger closed at seven and the lamp went out")
                     (pb-in? r2 "and what was said?"))) 4)

        ; ── an unattested line does NOT travel ──────────────────────────
        (pb-bit (and (eq (pr-attested? (nth fs 0)) 0)
                (and (pb-out? r1 "the room is a being")
                (and (pb-out? r1 "being")
                     (pb-in? r1 "no frame in this room attests who spoke")))) 8)

        ; ── but its axes survive whole ──────────────────────────────────
        (pb-bit (and (pb-in? r1 "A line of 5 words stands in en, phrase, doubt 0.")
                (and (pb-in? r1 "-70 dBFS, under-the-line")
                (and (pb-in? r1 "holding a line that closed")
                     (pb-in? r1 "It was heard in 340 ms.")))) 16)

        ; ── rented text never enters, speaker named or not ──────────────
        (pb-bit (and (eq (pr-attested? (nth fs 2)) 0)
                (and (pb-out? r3 "a rented sentence that must never enter")
                (and (pb-out? r3 "rented sentence")
                     (pb-in? r3 "A line of 7 words stands in en")))) 32)

        ; ── a speaker with no organ is not an attestation ───────────────
        (pb-bit (and (eq (pr-attested? (nth fs 3)) 0)
                (and (pb-out? r4 "a guest line with no organ named")
                     (pb-out? r4 "guest line"))) 64)

        ; ── every row says which frame it came from ─────────────────────
        (pb-bit (and (pb-in? r1 "source /tmp/perception-band.spool, frame 1 of 4")
                (and (pb-in? r1 "t=1788777092547")
                (and (pb-in? r1 "organ ear-live")
                (and (pb-in? r3 "frame 3 of 4")
                     (pb-in? r2 "organ voice-say")))))  128)

        ; ── the shape the trainer reads ─────────────────────────────────
        (pb-bit (and (eq (str_find r1 (pb-cat (list "{" (pb-q) "messages" (pb-q) ":[{" (pb-q) "role" (pb-q) ":" (pb-q) "user" (pb-q))) 0) 0)
                (and (pb-in? r1 (pb-cat (list (pb-q) "role" (pb-q) ":" (pb-q) "assistant" (pb-q))))
                (and (eq (str_byte_at r1 (sub (str_len r1) 1)) 10)
                (and (eq (str_byte_at r1 (sub (str_len r1) 2)) 125)
                     (eq (str_find r1 (byte_to_str 10) 0) (sub (str_len r1) 1)))))) 256)

        ; ── a shape is addressable: same shape, same address ────────────
        (pb-bit (and (str_eq (pr-shape (nth fs 2)) (pr-shape (nth fs 3)))
                (and (str_eq (pr-shape-node (nth fs 2)) (pr-shape-node (nth fs 3)))
                (and (eq (str_len (pr-shape-node (nth fs 0))) 8)
                (and (eq (pb-hex? (pr-shape-node (nth fs 0)) 0) 1)
                     (eq (str_eq (pr-shape-node (nth fs 0)) (pr-shape-node (nth fs 1))) 0))))) 512)

        ; ── the day's own row carries no one's words ────────────────────
        (pb-bit (and (pb-out? dayrow "being")
                (and (pb-out? dayrow "rented")
                (and (pb-out? dayrow "guest")
                (and (pb-in? dayrow "4 frames: 3 lines closed, 29 words heard across them, 1 of them attested")
                     (pb-in? dayrow "floor was -70 dBFS"))))) 1024)

        ; ── nor does the row that says what recurs ──────────────────────
        (pb-bit (and (pb-out? recrow "being")
                (and (pb-out? recrow "rented")
                (and (pb-out? recrow "guest")
                (and (pb-in? recrow "the room took 3 distinct shapes")
                     (pb-in? recrow "heard|en|phrase|quiet"))))) 2048)

        ; ── the day and hour a stamp lands on, folded here ──────────────
        (pb-bit (and (str_eq (pr-when 1788777092547) "2026-09-07 10h UTC")
                (and (str_eq (pr-when 0) "no stamp")
                     (str_eq (pr-day-text 0) "1970-01-01"))) 4096)

        ; ── change is kept; a repeated shape folds; attested always keeps ─
        (pb-bit (and (eq (pr-keep? (nth fs 3) (pr-shape (nth fs 2))) 0)
                (and (eq (pr-keep? (nth fs 2) (pr-shape (nth fs 1))) 1)
                     (eq (pr-keep? (nth fs 1) (pr-shape (nth fs 1))) 1))) 8192)

        ; ── the bands a moment falls in, at their edges ─────────────────
        (pb-bit (and (str_eq (pr-len-band 0) "no-line")
                (and (str_eq (pr-len-band 3) "short")
                (and (str_eq (pr-len-band 9) "phrase")
                (and (str_eq (pr-len-band 20) "sentence")
                (and (str_eq (pr-len-band 21) "passage")
                (and (str_eq (pr-db-band-of -100) "silent")
                (and (str_eq (pr-db-band-of -55) "under-the-line")
                (and (str_eq (pr-db-band-of -40) "quiet")
                (and (str_eq (pr-db-band-of -25) "speaking")
                     (str_eq (pr-db-band-of -24) "loud"))))))))))  16384)

        ; ── the gate is asked of the rows it wrote ──────────────────────
        ; It must say 0 where nothing was carried, more than 0 where a line
        ; was, and — the case that decides whether the number can be trusted —
        ; it must ERR TOWARD ALARM: fcol's line is one the body's own drop
        ; sentence contains word for word, so a row that carried nothing is
        ; still counted. A checker that cannot over-report cannot be believed
        ; when it under-reports, and alarm is the safe direction to be wrong in.
        (pb-bit (and (eq (pr-leaks (str_concat r1 (str_concat r3 r4)) fs) 0)
                (and (eq (pr-leaks r2 fs) 1)
                (and (eq (len (pr-lines fs)) 4)
                (and (eq (pr-leaks dayrow fs) 0)
                (and (eq (pr-attested? (nth fsc 0)) 0)
                     (eq (pr-leaks (pr-moment-row spool 1 1 (nth fsc 0)) fsc) 1)))))) 32768)
    )))
