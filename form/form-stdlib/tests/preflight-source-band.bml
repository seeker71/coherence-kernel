; preflight-source-band.bml — the lane reading held to fixtures, four-way.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/preflight-source.bml
;
; Every fixture here is a literal string. Nothing is read from disk and nothing is written,
; so the four kernels answer from the same bytes and this band says the same number on all of
; them — which is the point: the reading that decides WHICH artifacts preflight removes is not
; a fkwu opinion, it is the same reading on all four.
;
; Verdict 65535 — sixteen readings.
;
;   WHICH LANE
;   1      a .bml lowers whatever its text says
;   2      a .fk carrying a `section [` block lowers too — the seed's own reading
;            (fk_unit_lowers), and the one a suffix cannot make: compiler.fk,
;            runtime-grammar.fk and the ten -bmf.fk grammars all wear .fk and all travel
;            the high-grammar lane
;   4      a plain .fk is direct source; a file with neither is no lane at all
;   8      the block owns its line: the same nine bytes in a comment, in a string, or
;            in the middle of a line are text, and leading whitespace is still its line
;
;   WHERE THE CACHE LIVES
;   16     a lowering unit's artifacts hang off the WHOLE path: x.bml.fkb, .sym, .lowfk
;   32     a direct .fk replaces its suffix: x.fkb, .sym — two, not three
;   64     a source with no compile lane answers an EMPTY list. On 2026-08-26 a removal
;            path was derived from the source path by a substitution that returned its
;            input unchanged, and a .bml source was deleted while preflight believed it
;            was clearing a .fkb. A fold cannot reach what is not in the list.
;
;   THE SURFACE, READ AS ITSELF
;   128    a whole block closes
;   256    an unclosed brace is named a brace, and how deep
;   512    a stray close is named parens, at depth -1
;   1024   a delimiter inside a // comment is not a delimiter
;   2048   nor inside a string — and a backslash eats the byte after it, so a string
;            ending in an escaped quote does not hand the rest of the file to the walker
;   4096   an unterminated string is named a string; an unterminated block comment is
;            named a block comment. Depth 0 would have called both of them closed.
;   8192   the walk ends where the block ends. Walking to end of file instead read
;            grammars/bml.fk at depth -1 — a red line on a file that closes perfectly —
;            because 2500 lines of ordinary Form follow its block's `}`.
;   16384  and it resumes: five blocks in one unit (lora-backward.bml) fold into one
;            reading, so a break in the last one is still found
;
;   THE MARKER
;   32768  `preflight-exec: forbidden` answers in both tongues and only as a complete
;            line. A writer reaching for // in high grammar was previously watching
;            preflight execute the very effect the line asked it to leave alone.

section [form.bml] {
    def pfsb-bit(ok, weight) = if ok then weight else 0;

    // THE FIXTURES ARE JOINED LINE LISTS, and that is not a style choice.
    // A fixture written as one string with \n escapes lowers into a .fk whose
    // string literal spans real lines — and one of those lines then BEGINS with
    // `section [`. fk_unit_lowers scans lines without knowing it is inside a
    // string, so the lowered band was read as a fresh high-grammar unit and
    // refused with "section not closed before end of source". All four arms
    // went red together (2026-09-10). Joined this way, every fixture line is an
    // element on the `(list ...)` line the lowering emits, and no line of the
    // lowered source starts with the mark. The seam itself is named where the
    // reading lives, in bml/preflight-source.bml.
    def pfsb-nl() = byte_to_str(10);
    def pfsb-lines(xs) = if eq(len(xs), 0) then "" else str_concat(nth(xs, 0), str_concat(pfsb-nl(), pfsb-lines(tail(xs))));
    def pfsb-open() = "section [form.bml] {";

    def pfsb-block() = pfsb-lines(list("// a.bml", pfsb-open(), "    class A {", "        def a-x() = 1;", "    }", "}"));
    def pfsb-sectioned-fk() = pfsb-lines(list("; a.fk", "(do 1)", pfsb-open(), "    def g-x() = 1;", "}"));
    def pfsb-plain-fk() = pfsb-lines(list("; a.fk", "(do (add 1 2))"));
    def pfsb-prose() = pfsb-lines(list("A document that mentions section [form.bml] mid-sentence."));
    def pfsb-quoted() = pfsb-lines(list("(do (let s \"section [form.bml]\") s)"));
    def pfsb-indented() = pfsb-lines(list(str_concat("    ", pfsb-open()), "    }"));

    def pfsb-unclosed-brace() = pfsb-lines(list(pfsb-open(), "    class B {", "        def b-x() = 1;"));
    def pfsb-stray-close() = pfsb-lines(list(pfsb-open(), "    def c-x() = add(1, 2));", "}"));
    def pfsb-in-comment() = pfsb-lines(list(pfsb-open(), "    // } ( [", "    def d-x() = 1;", "}"));
    def pfsb-in-string() = pfsb-lines(list(pfsb-open(), "    def e-x() = \"}{\";", "}"));
    def pfsb-escaped-quote() = pfsb-lines(list(pfsb-open(), "    def f-x() = \"a\\\"}\";", "}"));
    def pfsb-open-string() = pfsb-lines(list(pfsb-open(), "    def g-x() = \"never ends;", "}"));
    def pfsb-open-comment() = pfsb-lines(list(pfsb-open(), "    /* never ends", "    def h-x() = 1;", "}"));
    def pfsb-tail-after-block() = pfsb-lines(list("; head", pfsb-open(), "    def i-x() = 1;", "}", "(do (add 1 2"));
    def pfsb-two-blocks() = pfsb-lines(list(pfsb-open(), "    def j-x() = 1;", "}", "// between", pfsb-open(), "    def k-x() = 2;", "}"));
    def pfsb-second-broken() = pfsb-lines(list(pfsb-open(), "    def l-x() = 1;", "}", "// between", pfsb-open(), "    def m-x() = 2;"));

    def pfsb-mark-bml() = pfsb-lines(list("// preflight-exec: forbidden", pfsb-open(), "    1;", "}"));
    def pfsb-mark-fk() = pfsb-lines(list("; preflight-exec: forbidden", "(do 1)"));
    def pfsb-mark-trailing() = pfsb-lines(list("  // preflight-exec: forbidden  ", "(do 1)"));
    def pfsb-mark-quoted() = pfsb-lines(list("(do (print_str \"// preflight-exec: forbidden\"))"));

    def pfsb-open-of(text) = pfs-open-name(pfs-balance(text));
    def pfsb-depth-of(text) = pfs-open-depth(pfs-balance(text));
    def pfsb-closed-of(text) = pfs-closed?(pfs-balance(text));
    def pfsb-art(path, text, at) = nth(pfs-artifacts(path, text), at);

    def pfsb-score() {
        let lowering = pfs-artifacts("d/x.bml", pfsb-block());
        let direct = pfs-artifacts("d/x.fk", pfsb-plain-fk());
        sum(list(
            pfsb-bit(and(eq(pfs-lowers?("x.bml", ""), 1), str_eq(pfs-kind("x.bml", ""), "bml")), 1),
            pfsb-bit(and(eq(pfs-lowers?("x.fk", pfsb-sectioned-fk()), 1), str_eq(pfs-kind("x.fk", pfsb-sectioned-fk()), "lowering-fk")), 2),
            pfsb-bit(and(str_eq(pfs-kind("x.fk", pfsb-plain-fk()), "fk"), and(eq(pfs-lowers?("x.fk", pfsb-plain-fk()), 0), and(str_eq(pfs-kind("x.md", pfsb-prose()), "unsupported"), eq(pfs-supported?("x.md", pfsb-prose()), 0)))), 4),
            pfsb-bit(and(eq(pfs-section-block?(pfsb-prose()), 0), and(eq(pfs-section-block?(pfsb-quoted()), 0), eq(pfs-section-block?(pfsb-indented()), 1))), 8),
            pfsb-bit(and(eq(len(lowering), 3), and(str_eq(nth(lowering, 0), "d/x.bml.fkb"), and(str_eq(nth(lowering, 1), "d/x.bml.sym"), str_eq(nth(lowering, 2), "d/x.bml.lowfk")))), 16),
            pfsb-bit(and(eq(len(direct), 2), and(str_eq(nth(direct, 0), "d/x.fkb"), str_eq(nth(direct, 1), "d/x.sym"))), 32),
            pfsb-bit(and(eq(len(pfs-artifacts("d/x.md", pfsb-prose())), 0), eq(len(pfs-artifacts("README", pfsb-prose())), 0)), 64),
            pfsb-bit(and(eq(pfsb-closed-of(pfsb-block()), 1), str_eq(pfsb-open-of(pfsb-block()), "")), 128),
            pfsb-bit(and(str_eq(pfsb-open-of(pfsb-unclosed-brace()), "braces"), eq(pfsb-depth-of(pfsb-unclosed-brace()), 2)), 256),
            pfsb-bit(and(str_eq(pfsb-open-of(pfsb-stray-close()), "parens"), eq(pfsb-depth-of(pfsb-stray-close()), -1)), 512),
            pfsb-bit(eq(pfsb-closed-of(pfsb-in-comment()), 1), 1024),
            pfsb-bit(and(eq(pfsb-closed-of(pfsb-in-string()), 1), eq(pfsb-closed-of(pfsb-escaped-quote()), 1)), 2048),
            pfsb-bit(and(str_eq(pfsb-open-of(pfsb-open-string()), "string"), str_eq(pfsb-open-of(pfsb-open-comment()), "block comment")), 4096),
            pfsb-bit(eq(pfsb-closed-of(pfsb-tail-after-block()), 1), 8192),
            pfsb-bit(and(eq(pfsb-closed-of(pfsb-two-blocks()), 1), and(str_eq(pfsb-open-of(pfsb-second-broken()), "braces"), eq(pfsb-depth-of(pfsb-second-broken()), 1))), 16384),
            pfsb-bit(and(eq(pfs-effect-marked?(pfsb-mark-bml()), 1), and(eq(pfs-effect-marked?(pfsb-mark-fk()), 1), and(eq(pfs-effect-marked?(pfsb-mark-trailing()), 1), and(eq(pfs-effect-marked?(pfsb-mark-quoted()), 0), eq(pfs-effect-marked?(""), 0))))), 32768)
        ));
    }
    pfsb-score();
}
