; native-turn-green-band.bml — the band is the judge of the voice's option (observe/native-turn-run.bml, nt-option-green).
;
; An option is green only when the gap's band ran under its published candidate and read its full from below, the
; neighbours held and nothing refused the publish. A lane that says it is done (its own checks passed) still answers to
; the band: the door runs the band under every published candidate, done or not.
;
; Expected: 63
; Verdict 63 when every claim lands:
;   1   a lane that says done while the band never ran under its candidate is not green
;   2   a band read full from below, neighbours holding, nothing refused: green
;   4   a band that ran under the candidate and read short is not green
;   8   a refused publish is never green
;   16  a band already full before the option is not this option's green
;   32  the door judges with nt-option-green and runs the band under every published candidate
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml observe/native-turn-run.bml
section [form.bml] {
 class NativeTurnGreenBand {
  def ntg-c-done-unread(ctx) = !nt-option-green("", false, 6, 6, 7, 0);
  def ntg-c-full(ctx) = nt-option-green("", true, 7, 6, 7, 1);
  def ntg-c-short(ctx) = !nt-option-green("", true, 6, 6, 7, 1) && !nt-option-green("", true, nothing(), 6, 7, 1);
  def ntg-c-refused(ctx) = !nt-option-green("writer-held", true, 7, 6, 7, 1);
  def ntg-c-already(ctx) = !nt-option-green("", true, 7, 7, 7, 1);
  def ntg-c-door(ctx) {
   let src = read_file("observe/native-turn-run.bml") ?? "";
   str_find(src, "let green = nt-option-green(refused, ran, after, before, full, neighbors);", 0) >= 0 && str_find(src, "if (published > 0) then hw-with-published(", 0) >= 0 && str_find(src, "if done then (claim[0] == 1)", 0) < 0;
  }
 }
 live-claims("native-turn-green-band", 0, [["done-unread", 1, 1, ntg-c-done-unread], ["full", 2, 1, ntg-c-full], ["short", 4, 1, ntg-c-short], ["refused", 8, 1, ntg-c-refused], ["already", 16, 1, ntg-c-already], ["door", 32, 1, ntg-c-door]]);
}
