; preludes: form-stdlib/core.fk form-stdlib/trig.fk form-stdlib/endpointing.fk form-stdlib/voice-formant.fk form-stdlib/voiced-reading.fk form-stdlib/word-speak.fk form-stdlib/word-hear.fk form-stdlib/duplex-turn.fk
;
; duplex-turn-band — one loop, two thresholds, and the interruption is UNDERSTOOD. Four-way.
;
; Every pin probed from the body first. dt 0.08, half-lives 0.24, guard 3 unless stated.
;
; Verdict 31 when every claim lands:
;   1   a quiet room never interrupts: 20 incoming no-voice readings → all 20 frames spoken, no cut
;   2   a voice arriving at tick 8 cuts at tick 11 — HYSTERESIS, not a twitch: the release curve
;       needs three frames to carry the estimate through the whole 0.4 band, so one noisy frame
;       can never chop the voice (the same three-frame lag is the honest cost of never chopping)
;   4   the echo guard: voice from tick 0 still speaks `guard` frames — unmute's own seam, the
;       agent would otherwise interrupt itself with its own leaking sound — then yields at once
;   8   after the room yields, the turn ends: listening state reaches ep-turn-over?
;   16  STOP AND UNDERSTAND: the incoming stream is the body's own name as heard by
;       voiced-reading (19 real readings off ws-sema), the engine cuts a 30-frame utterance at
;       tick 7, and word-hear recognizes WHAT interrupted: (1 2 3 2), the name. A barge-in is an
;       utterance, not a stop signal.
(do
    (defn dtb-rep (v n) (if (le n 0) (list) (cons v (dtb-rep v (sub n 1)))))
    (defn dtb-cat (a b) (if (nil? a) b (cons (head a) (dtb-cat (tail a) b))))

    (let quiet (dtb-rep 1.0 20))
    (let barge8 (dtb-cat (dtb-rep 1.0 8) (dtb-rep 0.0 12)))
    (let allvoice (dtb-rep 0.0 20))

    (let s1 (dt-run 20 quiet 0.08 0.24 0.24 3))
    (let s2 (dt-run 20 barge8 0.08 0.24 0.24 3))
    (let s3 (dt-run 20 allvoice 0.08 0.24 0.24 3))

    (let c0 (if (eq (dt-spoke s1) 20) (if (eq (dt-interrupted? s1) 0) 1 0) 0))
    (let c1 (if (eq (dt-spoke s2) 11) (if (eq (dt-barge-tick s2) 11) 2 0) 0))
    (let c2 (if (eq (dt-spoke s3) 3) (if (eq (dt-interrupted? s3) 1) 4 0) 0))
    ; after speaking, sustained quiet lifts the estimate over the turn floor
    (let s4 (dt-run 3 (dtb-cat (dtb-rep 0.0 3) (dtb-rep 1.0 10)) 0.08 0.24 0.24 0))
    (let c3 (if (eq (dt-turn-over? s4) 1) 8 0))

    ; the composition: the name interrupts, and is heard as the name
    (let sema (ws-sema))
    (let rd (vr-readings sema 4800 240 8000 100 400))
    (let s5 (dt-run 30 rd 0.03 0.09 0.09 3))
    (let c4 (if (eq (len rd) 19)
               (if (eq (dt-spoke s5) 7)
                   (if (eq (dt-interrupted? s5) 1)
                       (if (eq (wh-sema? sema 4800 240 8000 100 400) 1) 16 0) 0) 0) 0))

    (add c0 (add c1 (add c2 (add c3 c4)))))
