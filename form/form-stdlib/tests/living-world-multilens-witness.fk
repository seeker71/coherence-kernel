; living-world-multilens-witness.fk -- three learned symbols meet concurrent lenses.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/living-world-multilens-plan.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk form-stdlib/tests/living-world-relational-voice-witness.fk

(let LWMPW-SLOT-THIRD (bp "LWMPW-SLOT-THIRD"))
(let LWMPW-RELATION-BETA (bp "LWMPW-RELATION-BETA"))
(let LWMPW-RELATION-GAMMA (bp "LWMPW-RELATION-GAMMA"))
(let LWMPW-RELATION-DELTA (bp "LWMPW-RELATION-DELTA"))
(let LWMPW-DIRECTION (bp "LWMPW-DIRECTION"))
(let LWMPW-EVIDENCE (bp "LWMPW-EVIDENCE"))

(defn lwmpw-cell (kind) (intern_node kind (empty)))
(defn lwmpw-slot-third () (lwmpw-cell LWMPW-SLOT-THIRD))
(defn lwmpw-relation-beta () (lwmpw-cell LWMPW-RELATION-BETA))
(defn lwmpw-relation-gamma () (lwmpw-cell LWMPW-RELATION-GAMMA))
(defn lwmpw-relation-delta () (lwmpw-cell LWMPW-RELATION-DELTA))
(defn lwmpw-direction () (lwmpw-cell LWMPW-DIRECTION))
(defn lwmpw-evidence () (lwmpw-cell LWMPW-EVIDENCE))

(defn lwmpw-third-observation ()
    (lwsl-observation-at (lwrvw-referent) (lwmpw-slot-third) "!"
        (lwo-none) (oac-one (lwrvw-referent)) (lwmpw-evidence)))
(defn lwmpw-symbol-world ()
    (lwt-receive-stream (lwrvw-symbol-world)
        (list
            (lwslw-entry-a (lwmpw-third-observation))
            (lwslw-entry-b (lwmpw-third-observation)))))
(defn lwmpw-symbol-round ()
    (do
        (let world (lwmpw-symbol-world))
        (lwt-round world (lwsl-proposals world 2)
            (lwo-empty-field) (lwo-none))))
(defn lwmpw-symbol-proposals ()
    (lwt-round-proposals (lwmpw-symbol-round)))
(defn lwmpw-third ()
    (lwt-proposal-candidate
        (lwslw-find-proposal (lwmpw-symbol-proposals) "!")))
(defn lwmpw-symbol-yes-round ()
    (do
        (let round (lwmpw-symbol-round))
        (let proposals (lwt-round-proposals round))
        (let left (lwslw-find-proposal proposals "forty"))
        (let right (lwslw-find-proposal proposals "-nine"))
        (let third (lwslw-find-proposal proposals "!"))
        (lwt-round-receive round
            (list
                (lwrvw-symbol-response
                    (lwslw-source-a) (lwslw-prov-a) left)
                (lwrvw-symbol-response
                    (lwslw-source-b) (lwslw-prov-b) left)
                (lwrvw-symbol-response
                    (lwslw-source-a) (lwslw-prov-a) right)
                (lwrvw-symbol-response
                    (lwslw-source-b) (lwslw-prov-b) right)
                (lwrvw-symbol-response
                    (lwslw-source-a) (lwslw-prov-a) third)
                (lwrvw-symbol-response
                    (lwslw-source-b) (lwslw-prov-b) third)))))
(defn lwmpw-symbol-integrated-round ()
    (do
        (let round (lwmpw-symbol-yes-round))
        (let proposals (lwt-round-proposals round))
        (let left (lwslw-find-proposal proposals "forty"))
        (let right (lwslw-find-proposal proposals "-nine"))
        (let third (lwslw-find-proposal proposals "!"))
        (let first (lwsl-integrate round left (lwslw-action)))
        (let second (lwsl-integrate first right (lwslw-action)))
        (lwsl-integrate second third (lwslw-action))))
(defn lwmpw-symbol-integrated-world ()
    (lwt-round-world (lwmpw-symbol-integrated-round)))
(defn lwmpw-nodes ()
    (lwo-field (list (lwrvw-left) (lwrvw-right) (lwmpw-third))))

(defn lwmpw-order
    (relation left right lens)
    (lwrl-observation relation left right lens (oac-one relation)
        (lwo-empty-field) (lwo-none) (lwmpw-evidence)))
(defn lwmpw-alpha-second-a ()
    (lwmpw-order (lwrvw-relation) (lwrvw-right) (lwmpw-third)
        (lwo-none)))
(defn lwmpw-alpha-second-b ()
    (lwmpw-order (lwrvw-relation) (lwrvw-right) (lwmpw-third)
        (lwrvw-lens)))
(defn lwmpw-beta-first-a ()
    (lwmpw-order (lwmpw-relation-beta) (lwrvw-left) (lwrvw-right)
        (lwo-none)))
(defn lwmpw-beta-first-b ()
    (lwmpw-order (lwmpw-relation-beta) (lwrvw-left) (lwrvw-right)
        (lwrvw-lens)))
(defn lwmpw-beta-second-a ()
    (lwmpw-order (lwmpw-relation-beta) (lwrvw-right) (lwmpw-third)
        (lwo-none)))
(defn lwmpw-beta-second-b ()
    (lwmpw-order (lwmpw-relation-beta) (lwrvw-right) (lwmpw-third)
        (lwrvw-lens)))
(defn lwmpw-gamma-first-a ()
    (lwmpw-order (lwmpw-relation-gamma) (lwrvw-left) (lwmpw-third)
        (lwo-none)))
(defn lwmpw-gamma-first-b ()
    (lwmpw-order (lwmpw-relation-gamma) (lwrvw-left) (lwmpw-third)
        (lwrvw-lens)))
(defn lwmpw-gamma-second-a ()
    (lwmpw-order (lwmpw-relation-gamma) (lwmpw-third) (lwrvw-right)
        (lwo-none)))
(defn lwmpw-gamma-second-b ()
    (lwmpw-order (lwmpw-relation-gamma) (lwmpw-third) (lwrvw-right)
        (lwrvw-lens)))

(defn lwmpw-relation-world ()
    (lwt-receive-stream (lwmpw-symbol-integrated-world)
        (list
            ; Alpha retains its earlier two supports and inverse alternative.
            (lwslw-entry-a (lwrvw-order-support-a))
            (lwslw-entry-b (lwrvw-order-support-b))
            (lwslw-entry-c (lwrvw-order-inverse-c))
            (lwslw-entry-a (lwmpw-alpha-second-a))
            (lwslw-entry-b (lwmpw-alpha-second-b))
            ; Beta agrees across both edges.
            (lwslw-entry-a (lwmpw-beta-first-a))
            (lwslw-entry-b (lwmpw-beta-first-b))
            (lwslw-entry-a (lwmpw-beta-second-a))
            (lwslw-entry-b (lwmpw-beta-second-b))
            ; Gamma is a complete but different order.
            (lwslw-entry-a (lwmpw-gamma-first-a))
            (lwslw-entry-b (lwmpw-gamma-first-b))
            (lwslw-entry-a (lwmpw-gamma-second-a))
            (lwslw-entry-b (lwmpw-gamma-second-b)))))

(defn lwmpw-find-proposal-items (items relation left right)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let edge
                (lwo-emergent-shape
                    (lwt-proposal-candidate (head items))))
            (if (and (node_eq (lwrl-edge-relation edge) relation)
                     (and (node_eq (lwrl-edge-left edge) left)
                          (node_eq (lwrl-edge-right edge) right)))
                (head items)
                (lwmpw-find-proposal-items
                    (tail items) relation left right)))))
(defn lwmpw-find-proposal (proposals relation left right)
    (lwmpw-find-proposal-items
        (lwo-field-items proposals) relation left right))
(defn lwmpw-relation-round ()
    (do
        (let world (lwmpw-relation-world))
        (lwt-round world (lwrl-proposals world 2)
            (lwo-empty-field) (lwo-none))))
(defn lwmpw-response-list (proposal include-c)
    (do
        (let base
            (list
                (lwrvw-relation-response
                    (lwslw-source-a) (lwslw-prov-a) proposal)
                (lwrvw-relation-response
                    (lwslw-source-b) (lwslw-prov-b) proposal)))
        (if (eq include-c 1)
            (cons
                (lwrvw-relation-response
                    (lwslw-source-c) (lwslw-prov-c) proposal) base)
            base)))
(defn lwmpw-relation-yes-round ()
    (do
        (let round (lwmpw-relation-round))
        (let proposals (lwt-round-proposals round))
        (let a1 (lwmpw-find-proposal proposals (lwrvw-relation)
                    (lwrvw-left) (lwrvw-right)))
        (let a2 (lwmpw-find-proposal proposals (lwrvw-relation)
                    (lwrvw-right) (lwmpw-third)))
        (let b1 (lwmpw-find-proposal proposals (lwmpw-relation-beta)
                    (lwrvw-left) (lwrvw-right)))
        (let b2 (lwmpw-find-proposal proposals (lwmpw-relation-beta)
                    (lwrvw-right) (lwmpw-third)))
        (let g1 (lwmpw-find-proposal proposals (lwmpw-relation-gamma)
                    (lwrvw-left) (lwmpw-third)))
        (let g2 (lwmpw-find-proposal proposals (lwmpw-relation-gamma)
                    (lwmpw-third) (lwrvw-right)))
        (let r1 (append (lwmpw-response-list a1 1)
                         (lwmpw-response-list a2 0)))
        (let r2 (append r1 (lwmpw-response-list b1 0)))
        (let r3 (append r2 (lwmpw-response-list b2 0)))
        (let r4 (append r3 (lwmpw-response-list g1 0)))
        (lwt-round-receive round
            (append r4 (lwmpw-response-list g2 0)))))
(defn lwmpw-relation-integrated-round ()
    (do
        (let round (lwmpw-relation-yes-round))
        (let proposals (lwt-round-proposals round))
        (let a1 (lwmpw-find-proposal proposals (lwrvw-relation)
                    (lwrvw-left) (lwrvw-right)))
        (let a2 (lwmpw-find-proposal proposals (lwrvw-relation)
                    (lwrvw-right) (lwmpw-third)))
        (let b1 (lwmpw-find-proposal proposals (lwmpw-relation-beta)
                    (lwrvw-left) (lwrvw-right)))
        (let b2 (lwmpw-find-proposal proposals (lwmpw-relation-beta)
                    (lwrvw-right) (lwmpw-third)))
        (let g1 (lwmpw-find-proposal proposals (lwmpw-relation-gamma)
                    (lwrvw-left) (lwmpw-third)))
        (let g2 (lwmpw-find-proposal proposals (lwmpw-relation-gamma)
                    (lwmpw-third) (lwrvw-right)))
        (let r1 (lwrl-integrate round a1 (lwslw-action)))
        (let r2 (lwrl-integrate r1 a2 (lwslw-action)))
        (let r3 (lwrl-integrate r2 b1 (lwslw-action)))
        (let r4 (lwrl-integrate r3 b2 (lwslw-action)))
        (let r5 (lwrl-integrate r4 g1 (lwslw-action)))
        (lwrl-integrate r5 g2 (lwslw-action))))
(defn lwmpw-relation-integrated-world ()
    (lwt-round-world (lwmpw-relation-integrated-round)))

(defn lwmpw-lens-alpha ()
    (lwlc-lens (lwlc-cell-shape) (lwrvw-relation) (lwmpw-evidence)))
(defn lwmpw-lens-beta ()
    (lwlc-lens (lwlc-cell-shape) (lwmpw-relation-beta) (lwmpw-evidence)))
(defn lwmpw-lens-gamma ()
    (lwlc-lens (lwlc-cell-shape) (lwmpw-relation-gamma) (lwmpw-evidence)))
(defn lwmpw-lens-delta ()
    (lwlc-lens (lwlc-cell-shape) (lwmpw-relation-delta) (lwmpw-evidence)))

(defn lwmpw-aligned-declaration ()
    (lwlc-declaration (lwmpw-direction)
        (lwlc-stack (lwmpw-lens-alpha)
            (lwlc-layers (list (lwmpw-lens-beta)))
            (lwo-field (list (lwmpw-lens-gamma)))
            (lwlc-unknown (lwmpw-evidence)) (lwmpw-evidence))
        (lwmpw-evidence)))
(defn lwmpw-divergent-declaration ()
    (lwlc-declaration (lwmpw-direction)
        (lwlc-stack (lwmpw-lens-alpha)
            (lwlc-layers (list (lwmpw-lens-gamma)))
            (lwo-field (list (lwmpw-lens-beta)))
            (lwo-none) (lwmpw-evidence))
        (lwmpw-evidence)))
(defn lwmpw-open-declaration ()
    (lwlc-declaration (lwmpw-direction)
        (lwlc-stack (lwo-none) (lwlc-layers (empty))
            (lwo-field
                (list (lwmpw-lens-alpha) (lwmpw-lens-beta)
                      (lwmpw-lens-gamma)))
            (lwlc-unknown (lwmpw-evidence)) (lwmpw-evidence))
        (lwmpw-evidence)))
(defn lwmpw-ambiguous-declaration ()
    (lwlc-declaration (lwmpw-direction)
        (lwlc-stack (lwmpw-lens-delta) (lwlc-layers (empty))
            (lwo-empty-field) (lwo-none) (lwmpw-evidence))
        (lwmpw-evidence)))

(defn lwmpw-world ()
    (lwt-receive-stream (lwmpw-relation-integrated-world)
        (list
            (lwrvw-entry-d (lwmpw-aligned-declaration))
            (lwrvw-entry-d (lwmpw-divergent-declaration))
            (lwrvw-entry-d (lwmpw-open-declaration))
            (lwrvw-entry-d (lwmpw-ambiguous-declaration)))))
(defn lwmpw-aligned-bundle ()
    (lwmp-bundle-for (lwmpw-world)
        (lwmpw-aligned-declaration) (lwmpw-nodes)))
(defn lwmpw-divergent-bundle ()
    (lwmp-bundle-for (lwmpw-world)
        (lwmpw-divergent-declaration) (lwmpw-nodes)))
(defn lwmpw-open-bundle ()
    (lwmp-bundle-for (lwmpw-world)
        (lwmpw-open-declaration) (lwmpw-nodes)))
(defn lwmpw-ambiguous-bundle ()
    (lwmp-bundle-for (lwmpw-world)
        (lwmpw-ambiguous-declaration) (lwmpw-nodes)))

(defn lwmpw-cycle-declaration ()
    (lwlc-declaration (lwmpw-direction)
        (lwlc-stack
            (lwlc-lens (lwlc-cell-shape)
                (lwrlw-relation) (lwmpw-evidence))
            (lwlc-layers (empty)) (lwo-empty-field)
            (lwo-none) (lwmpw-evidence))
        (lwmpw-evidence)))
(defn lwmpw-cycle-world ()
    (lwt-receive-stream
        (lwt-round-world (lwrlw-cycle-integrated-round))
        (list (lwrvw-entry-d (lwmpw-cycle-declaration)))))
(defn lwmpw-cycle-bundle ()
    (lwmp-bundle-for (lwmpw-cycle-world)
        (lwmpw-cycle-declaration)
        (lwo-field (list (lwrlw-left) (lwrlw-right)))))

(defn lwmpw-revoked-world ()
    (lwt-receive-stream (lwmpw-world)
        (list
            (lwrvw-entry-d
                (lwo-revocation (lwmpw-aligned-declaration)
                    (lwrvw-source-d) (lwrew-action) (lwrvw-prov-d))))))

(defn lwmpw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwmpw-sum (tail items)))))
