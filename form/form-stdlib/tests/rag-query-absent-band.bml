; rag-query-absent-band.bml — a query that did not arrive is a miss, never a stop (rag-ask.fk, ra-grounded-hit-at).
;
; observe/form-cli-heal-rag-run.bml hands read_line() on, and empty stdin reads nothing().
;
; Expected: 15
; Verdict 15 when every claim lands:
;   1   an absent query over a standing index is a miss
;   2   an absent query over no index is a miss
;   4   a query that holds still hits its answer
;   8   an absent query never reads as the word "nothing", nor as the empty query that reads the staged one
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/str-byte-at.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/text-tokenize.fk form-stdlib/rag-embed.fk form-stdlib/rag-retrieve.fk form-stdlib/rag-index-codec.fk form-stdlib/form-fs.fk form-stdlib/rag-ask.fk
section [form.bml] {
 class RagQueryAbsentBand {
  def rqa-bytes(s) = map(i => str_byte_at(s, i), 0 .. len(s));
  def rqa-line(id, key, answer, words) = ric-emit-grounded(id, "@8.4.4.12", "docs/rag-query-absent.form", "cell", key, hex-encode(sha256(rqa-bytes(answer))), hex-encode(rqa-bytes(answer)), answer, re-semantic-vec(words));
  def rqa-path() = temp_dir() ++ "/rag-query-absent-band.jsonl";
  def rqa-index() {
   let a = rqa-line("@1.1.9.41", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "Kernel deployment is live.", "deployment evidence kernel production verified witness");
   let b = rqa-line("@1.1.9.42", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "The word nothing has an answer.", "nothing nothing nothing");
   let wrote = write_file(rqa-path(), a ++ byte_to_str(10) ++ b);
   rqa-path();
  }
  def rqa-miss?(hit) = (String) hit[0] == "miss";
  def rqa-c-standing(ctx) = rqa-miss?(ra-grounded-hit-at(rqa-index(), nothing()));
  def rqa-c-none(ctx) = rqa-miss?(ra-grounded-hit-at("no/such/rag-index.jsonl", nothing()));
  def rqa-c-hits(ctx) = (String) ra-grounded-hit-at(rqa-index(), "deployment evidence kernel production verified witness")[0] == "hit";
  // a staged query stands: the empty query reads it, the absent one does not. Planted only where none stands, and taken away.
  def rqa-staged(words) {
   let made = fs_mkdir(".coherence-network");
   let wrote = write_file(ra-staged-query(), words);
   let absent = ra-grounded-hit-at(rqa-index(), nothing());
   let empty = ra-grounded-hit-at(rqa-index(), "");
   let gone = fs-remove-file(ra-staged-query());
   rqa-miss?(absent) && (String) empty[0] == "hit";
  }
  def rqa-c-word(ctx) = (String) ra-grounded-hit-at(rqa-index(), "nothing")[0] == "hit" && rqa-miss?(ra-grounded-hit-at(rqa-index(), nothing())) && (host_path_exists(ra-staged-query()) == 1 || rqa-staged("deployment evidence kernel production verified witness"));
 }
 live-claims("rag-query-absent-band", 0, [["standing", 1, 1, rqa-c-standing], ["none", 2, 1, rqa-c-none], ["hits", 4, 1, rqa-c-hits], ["word", 8, 1, rqa-c-word]]);
}
