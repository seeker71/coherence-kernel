; form-knowledge-public-generative-school-band.fk -- public 15-family witness.
;
; Expected: 2147483647
; Pure synthetic replies cross the same BML/BMF/Form parser and execution gate
; as a live reply.  One family deliberately fails first and succeeds only in
; the explicitly supervised lane; the other fourteen remain independent.
; Replays, forged physical counters, answer-lane relabeling, and raw-output
; substitution are refused.
;
; preludes: form-stdlib/form-knowledge-public-generative-school.fk

(do
    (defn fkg15b-bit (ok bit) (if ok bit 0))
    (defn fkg15b-set-nth (xs index value)
        (if (eq (len xs) 0) (list)
            (if (eq index 0) (cons value (tail xs))
                (cons (head xs)
                    (fkg15b-set-nth (tail xs) (sub index 1) value)))))
    (defn fkg15b-bml (plan)
        (fkg15-cat (list
            "int Lift(int n) { return n + "
            (int_to_str (fkg15-plan-ordinal plan))
            "; }\nreturn Lift(65);\n")))
    (defn fkg15b-bmf ()
        "grammar {\n  rule atmark { lit @ }\n  rule vowel { class ae }\n  rule markedvowel { seq atmark vowel }\n  rule entrance { alt vowel markedvowel }\n  top entrance\n  probe @a\n}")
    (defn fkg15b-form (plan)
        (do
            (let challenge (fkg15-plan-challenge plan))
            (fgsg-control-canonical
                (fkg15-cat (list "<|form:recipe-exec|>"
                    (frex-node-coordinate (frex-recipe)) ";input="
                    (int_to_str (fgsg-challenge-input challenge))
                    ";carrier=auto<|/form:recipe-exec|>"))
                "nothing,timeout,zero" "one"
                (int_to_str (fgsg-challenge-checkpoint challenge))
                (int_to_str (fgsg-challenge-timeout-budget challenge))
                (fgsg-challenge-plane challenge)
                (int_to_str (fgsg-challenge-heat challenge))
                (int_to_str (fgsg-challenge-pure challenge)))))
    (defn fkg15b-good-raw (plan)
        (fkg15-cat (list
            "<BML>\n" (fkg15b-bml plan) "\n</BML>\n"
            "<BMF>\n" (fkg15b-bmf) "\n</BMF>\n"
            "<FORM>\n" (fkg15b-form plan) "\n</FORM>")))
    (defn fkg15b-bad-raw (plan)
        (fkg15-cat (list "family=" (fkg15-plan-family plan)
            ";first-attempt-refused;no-candidate-frames")))
    (defn fkg15b-report (plan raw)
        (fkg15-cat (list
            "\nstate_released=1\nstate_handles_closed=1\nstate_handles_expected=1\n"
            "synthetic-local-generation-report\nfamily="
            (fkg15-plan-family plan) "\ntext:\n" raw)))
    (defn fkg15b-report-unwitnessed (plan raw)
        (fkg15-cat (list "synthetic-local-generation-report\nfamily="
            (fkg15-plan-family plan) "\ntext:\n" raw)))
    (defn fkg15b-first-with-report
        (plan raw report model-id run-id session-id local remote executed
         released same)
        (fkg15-attempt plan 1 "candidate" (fkg15-independent-lane)
            (fkg15-plan-nonce plan) (fkg15-plan-prompt plan) raw
            model-id run-id session-id local remote executed released same 7
            report (if (eq executed 1) 4 0)
            (if (eq executed 1) 1 0)))
    (defn fkg15b-first
        (plan raw model-id run-id session-id local remote executed released same)
        (fkg15b-first-with-report plan raw (fkg15b-report plan raw)
            model-id run-id session-id local remote executed released same))
    (defn fkg15b-repair (plan first raw model-id run-id session-id lane)
        (fkg15-attempt plan 2 "repair" lane
            (fkg15-check-sha (fkg15-attempt-check first))
            (fkg15-repair-prompt plan (fkg15-attempt-check first)) raw
            model-id run-id session-id 1 0 1 1 1 9
            (fkg15b-report plan raw) 4 1))
    (defn fkg15b-row-for (plan supervised model-id run-id session-id)
        (if (eq supervised 1)
            (do
                (let first (fkg15b-first plan (fkg15b-bad-raw plan)
                    model-id run-id session-id 1 0 1 1 1))
                (let repair (fkg15b-repair plan first (fkg15b-good-raw plan)
                    model-id run-id session-id (fkg15-supervised-lane)))
                (fkg15-row plan first repair (fkg15-supervised-lane) 2))
            (do
                (let first (fkg15b-first plan (fkg15b-good-raw plan)
                    model-id run-id session-id 1 0 1 1 1))
                (fkg15-row plan first (nothing)
                    (fkg15-independent-lane) 1))))
    (defn fkg15b-rows-loop (plans first model-id run-id session-id)
        (if (eq (len plans) 0) (list)
            (cons (fkg15b-row-for (head plans) first
                    model-id run-id session-id)
                (fkg15b-rows-loop (tail plans) 0
                    model-id run-id session-id))))
    (defn fkg15b-run ()
        (do
            (let plans (fkg15-plans))
            (let model-id "synthetic-local-qwen-residence")
            (let run-id (nmfe-sha256 "public-generative-band-run-v1"))
            (let session-id (fkg15-session-id-for run-id model-id))
            (let rows (fkg15b-rows-loop plans 1 model-id run-id session-id))
            (let result (fkg15-result rows 1 0 1))
            (let export (fkg15-export result))
            (let first-row (head rows))
            (let second-row (head (tail rows)))
            (let first-final (fkg15-row-final-attempt first-row))
            (let second-first (fkg15-row-first second-row))
            (let first-check (fkg15-attempt-check first-final))
            (let replay-check (fkg15-check (fkg15-row-plan second-row)
                                (fkg15-attempt-raw first-final)))
            (let empty-check (fkg15-check (fkg15-row-plan second-row) ""))
            (let evidence (head (fkg15-result-evidences result)))
            (let other-model "other-local-residence")
            (let other-session (fkg15-session-id-for run-id other-model))
            (let other-first (fkg15b-first (fkg15-row-plan second-row)
                (fkg15b-good-raw (fkg15-row-plan second-row))
                other-model run-id other-session 1 0 1 1 1))
            (let other-row (fkg15-row (fkg15-row-plan second-row)
                other-first (nothing) (fkg15-independent-lane) 1))
            (let mixed-rows (cons first-row
                (cons other-row (tail (tail rows)))))
            (let remote-first (fkg15b-first (fkg15-row-plan second-row)
                (fkg15b-good-raw (fkg15-row-plan second-row))
                model-id run-id session-id 1 1 1 1 1))
            (let noexec-first (fkg15b-first (fkg15-row-plan second-row)
                (fkg15b-good-raw (fkg15-row-plan second-row))
                model-id run-id session-id 1 0 0 1 1))
            (let unreleased-first (fkg15b-first (fkg15-row-plan second-row)
                (fkg15b-good-raw (fkg15-row-plan second-row))
                model-id run-id session-id 1 0 1 0 1))
            (let moved-first (fkg15b-first (fkg15-row-plan second-row)
                (fkg15b-good-raw (fkg15-row-plan second-row))
                model-id run-id session-id 1 0 1 1 0))
            (let unwitnessed-raw
                (fkg15b-good-raw (fkg15-row-plan second-row)))
            (let unwitnessed-first (fkg15b-first-with-report
                (fkg15-row-plan second-row) unwitnessed-raw
                (fkg15b-report-unwitnessed
                    (fkg15-row-plan second-row) unwitnessed-raw)
                model-id run-id session-id 1 0 1 1 1))
            (let supervised-first (fkg15-row-first first-row))
            (let heldout-repair (fkg15b-repair (fkg15-row-plan first-row)
                supervised-first (fkg15b-good-raw (fkg15-row-plan first-row))
                model-id run-id session-id "heldout"))
            (let heldout-row (fkg15-row (fkg15-row-plan first-row)
                supervised-first heldout-repair "heldout" 2))
            (let extra-repair-row (append first-row
                (list (fkg15-row-repair first-row))))
            (let bad-plan (fkg15b-set-nth (head plans) 4
                (nmfe-sha256 "forged-source")))
            (let raw-sub-evidence (fkg15b-set-nth evidence 14
                (str_concat (nth evidence 14) "\nsubstituted")))
            (let verdict (fkg15-check-verdict first-check))
            (sum (list
                (fkg15b-bit (eq (len plans) 15) 1)
                (fkg15b-bit (eq (nmfe-sha256? (fkg15-plan-seal)) 1) 2)
                (fkg15b-bit (eq (fkg15-all-one?
                    (list (fkg15-plan-valid? (nth plans 0))
                          (fkg15-plan-valid? (nth plans 7))
                          (fkg15-plan-valid? (nth plans 14)))) 1) 4)
                (fkg15b-bit (eq (fkg15-plan-valid? bad-plan) 0) 8)
                (fkg15b-bit (eq (len rows) 15) 16)
                (fkg15b-bit (eq (fkg15-row-set-valid? rows) 1) 32)
                (fkg15b-bit (eq (fkg15-count-lane rows
                    (fkg15-independent-lane)) 14) 64)
                (fkg15b-bit (eq (fkg15-count-lane rows
                    (fkg15-supervised-lane)) 1) 128)
                (fkg15b-bit (eq (fkg15-check-pass? first-check) 1) 256)
                (fkg15b-bit (and (eq (fkg15-check-zero? first-check) 1)
                    (and (eq (fkg15-check-one? first-check) 1)
                         (eq (fkg15-check-nothing? first-check) 1))) 512)
                (fkg15b-bit (and (str_eq (fkg15-check-outcome empty-check)
                                         "nothing")
                    (and (eq (fkg15-check-pass? empty-check) 0)
                         (eq (fkg15-check-present? empty-check) 0))) 1024)
                (fkg15b-bit (and (eq (fgsg-verdict-model-executed? verdict) 0)
                    (eq (fgsg-verdict-native-carrier-executed? verdict) 0)) 2048)
                (fkg15b-bit (eq (fkg15-attempt-model-executed first-final) 1)
                    4096)
                (fkg15b-bit (and (eq (fkg15-check-pass? replay-check) 0)
                    (str_eq (fkg15-check-content-sha replay-check)
                            (fkg15-check-content-sha first-check))) 8192)
                (fkg15b-bit (not (str_eq (fkg15-check-bound-sha replay-check)
                    (fkg15-check-bound-sha first-check))) 16384)
                (fkg15b-bit (eq (fkg15-row-set-valid? mixed-rows) 0) 32768)
                (fkg15b-bit (eq (fkg15-attempt-valid? remote-first) 0) 65536)
                (fkg15b-bit (eq (fkg15-attempt-valid? noexec-first) 0) 131072)
                (fkg15b-bit (eq (fkg15-attempt-valid? unreleased-first) 0) 262144)
                (fkg15b-bit (eq (fkg15-attempt-valid? moved-first) 0) 524288)
                (fkg15b-bit (eq (fkg15-row-valid? heldout-row) 0) 1048576)
                (fkg15b-bit (eq (fkg15-row-valid? extra-repair-row) 0) 2097152)
                (fkg15b-bit (eq (fkpfm-generative-valid? evidence) 1) 4194304)
                (fkg15b-bit (and (str_eq (nth evidence 14)
                                         (fkg15-attempt-raw first-final))
                    (str_eq (nth evidence 5)
                            (nmfe-sha256 (nth evidence 14)))) 8388608)
                (fkg15b-bit (eq (fkpfm-generative-valid? raw-sub-evidence) 0)
                    16777216)
                (fkg15b-bit (eq (fkg15-result-complete? result) 1) 33554432)
                (fkg15b-bit (and (eq (nth result 9) 16)
                    (and (eq (nth result 10) 16)
                    (and (eq (nth result 11) 0)
                         (eq (nth result 15) 1)))) 67108864)
                (fkg15b-bit (eq (fkg15-result-valid? result) 1) 134217728)
                (fkg15b-bit (eq (fkg15-export-valid? export) 1) 268435456)
                (fkg15b-bit (and (eq (fkg15-result-complete?
                    (fkg15-result rows 1 1 1)) 0)
                    (eq (fkg15-result-complete?
                        (fkg15-result rows 1 0 0)) 0)) 536870912)
                (fkg15b-bit (and
                    (eq (fkg15-report-state-released
                        (fkg15-attempt-report unwitnessed-first)) 0)
                    (eq (fkg15-attempt-valid? unwitnessed-first) 0))
                    1073741824)))))
    (fkg15b-run))
