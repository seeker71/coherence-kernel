; dsv4-fixture-gguf-band.bml -- the tiny DeepSeek-V4-shaped GGUF that Form builds is a real GGUF: the restored readers read it back to
; the exact counts, every tensor holds the bytes its generator says, two builds are one file, and the reference arithmetic's own
; admission accepts it.
;
; WHAT THIS PINS. form-stdlib/dsv4-fixture-gguf.fk writes 86 tensors and 36 metadata pairs (three layers, compression ratios 0, 4, 2,
; layer 0 hashed, four experts two used, n_embd 256) from the body's Park-Miller generator, with write_file, under temp_dir. This is
; the model the Form-native Metal driver is proven on before it meets an 80 GB file. Nothing here maps a model, opens a voice or
; starts a process: the only file read is the fixture this band writes (1,515,232 bytes) and the band removes it.
;
; Verdict 511 when every claim lands:
;   1     built: the writer's byte count is the file's size, the size is the data base 7,168 plus the 1,508,064-byte data region,
;         the file begins with GGUF and version 3
;   2     the header reads back through egg-* and gmt-*: 86 tensors, 36 metadata pairs, the table ending at 7,142 and the data
;         base at 7,168 (the oracle's own reader agrees on the base), and the typed metadata (3 blocks, 256 embedding, 2 heads,
;         the ratio array 0 4 2 0, 4 experts, 2 used) by their keys
;   4     the tensor table reads back through gguf-manifest's pricing: all 86 rows in the writer's order, each with its name, type,
;         dimensions and offset as the writer set them, 32-byte aligned, and gm-bytes (the reader's price) equal to the writer's
;         layout for every tensor
;   8     the census through ds4-tensor-table's walk and gguf-tensor-index: 34 F32, 17 F16, 25 MXFP8, 6 MXFP4, 3 IQ2_XXS, 1 I32,
;         nothing uncovered; layers with a compressor 1 and 2, hashed layer 0 alone, biased layers 1 and 2, experts on all three
;   16    every tensor's bytes read from the file equal what the generator says, and every pad between tensors is zero
;   32    determinism: a second build at a second path is byte for byte the first (the whole file compared, and the two SHA-256 equal)
;   64    the file is pinned by value: its SHA-256 (taken by the body's own door) is
;         51e3cd1ad1c144ca11b7f1820f26de2c8f10cbc301faa2376889485398584a78, so a same-length edit of one byte reads
;   128   the reference arithmetic's own admission accepts it: dfo-open then dfo-admit-model answers 1, dfo-admit-position at 0 and 4095
;         answers 1, the geometry the oracle derives is the one built (e 256, nh 2, hd 128, nrot 64, ng 2, hc 4), the oracle reads
;         the hash table's rows (all 32 tokens) as the generator's two distinct experts, and the weights it reads are sane (the norm
;         gains in [1, 1.25), the embedding magnitudes in [2^-7, 2^-3), the biased layer's sentinel expert at -1e30)
;   256   the checks can fail: a copy with one byte flipped inside a tensor is read as different by the byte check and by the digest,
;         a copy cut short is refused by the oracle's admission, and a build that retypes one hyper-connection matrix is refused
;
; PROOF LEVEL: FOURTH-ARM ONLY -- bits 1 to 256 write and read a binary file through write_file and read_file_slice (rust and ts hand
; back a different file there), and bits 64 and 256 take a SHA-256 through the Form-emitted CPU door (a Darwin ARM64 in-RAM native).
; The band writes only under temp_dir and removes what it made.
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/gguf-manifest.fk form-stdlib/gguf-tensor-index.fk form-stdlib/ds4-tensor-table.fk form-stdlib/dsv4-fixture-gguf.fk form/form-stdlib/bml/dsv4-oracle-reference.bml form-stdlib/bml/sha256-owned.bml
section [form.bml] {
 class Dsv4FixtureGgufBand {
  def dfb-bit(held, bit) = held ? bit : 0;
  def dfb-hex(d, i) = i == len(d) ? "" : (substring("0123456789abcdef", str_byte_at(d, i) / 16, (str_byte_at(d, i) / 16) + 1) ++ substring("0123456789abcdef", str_byte_at(d, i) % 16, (str_byte_at(d, i) % 16) + 1) ++ dfb-hex(d, i + 1));
  def dfb-sha(path) { let d = record_get(sho-file(path), "digest"); len(d) == 32 ? dfb-hex(d, 0) : ""; }
  def dfb-pinned() = "51e3cd1ad1c144ca11b7f1820f26de2c8f10cbc301faa2376889485398584a78";
  def dfb-src(path) = eqr-of-file(path, 0, file_size(path));

  // ---- 1
  def dfb-built(path, wrote, specs) {
   let head = read_file_slice(path, 0, 8);
   wrote == file_size(path) && file_size(path) == 7168 + dfx-data-size(specs) && dfx-data-size(specs) == 1508064
    && str_byte_at(head, 0) == 71 && str_byte_at(head, 1) == 71 && str_byte_at(head, 2) == 85 && str_byte_at(head, 3) == 70 && str_byte_at(head, 4) == 3 && str_byte_at(head, 5) == 0;
  }

  // ---- 2
  def dfb-ratios(src) {
   let off = gmt-find(src, "deepseek4.attention.compress_ratios");
   [eqr-le(src, gm-arr-elem-off(src, off, 0), 4), eqr-le(src, gm-arr-elem-off(src, off, 1), 4), eqr-le(src, gm-arr-elem-off(src, off, 2), 4), eqr-le(src, gm-arr-elem-off(src, off, 3), 4)];
  }
  def dfb-header(path) {
   let src = dfb-src(path);
   let r = dfo-open(path);
   egg-magic-ok?(src) == 1 && egg-version(src) == 3 && egg-tensor-count(src) == 86 && egg-kv-count(src) == 36
    && egg-tinfo-end(src) == 7142 && egg-data-base(src, 32) == 7168 && record_get(r, "data") == 7168
    && gmt-str(src, "general.architecture") == "deepseek4" && gmt-u32(src, "deepseek4.block_count") == 3 && gmt-u32(src, "deepseek4.embedding_length") == 256
    && gmt-u32(src, "deepseek4.attention.head_count") == 2 && gmt-u32(src, "deepseek4.expert_count") == 4 && gmt-u32(src, "deepseek4.expert_used_count") == 2
    && gmt-u32(src, "deepseek4.vocab_size") == 32 && dfb-ratios(src) == [0, 4, 2, 0];
  }

  // ---- 4
  def dfb-dims-ok(src, off, ds, k) = k == len(ds) ? true : (egg-ti-dim(src, off, k) == ds[k] && dfb-dims-ok(src, off, ds, k + 1));
  def dfb-row-ok(src, off, s, o) = gm-name(src, off) == s[0] && egg-ti-type(src, off) == s[1] && egg-ti-ndims(src, off) == len(s[2]) && dfb-dims-ok(src, off, s[2], 0)
   && egg-ti-dataoff(src, off) == o && (o % 32) == 0 && gm-bytes(src, off) == dfx-tbytes(s[1], s[2]) && gm-priced?(s[1]) == 1;
  def dfb-rows-ok(src, off, specs, offs, i) = i == len(specs) ? (off == egg-tinfo-end(src)) : (dfb-row-ok(src, off, specs[i], offs[i]) && dfb-rows-ok(src, egg-ti-next(src, off), specs, offs, i + 1));
  def dfb-table(path, specs) {
   let src = dfb-src(path);
   dfb-rows-ok(src, egg-tinfo-start(src), specs, dfx-offsets(specs, 0), 0);
  }

  // ---- 8
  def dfb-blocks(src, leaf) = gti-blocks-with(src, leaf);
  def dfb-census(path) {
   let src = dfb-src(path);
   let n = egg-tensor-count(src);
   let at = egg-tinfo-start(src);
   let f32 = ds4t-live-count-go(src, at, n, 0, 0);
   let f16 = ds4t-live-count-go(src, at, n, 1, 0);
   let mx8 = ds4t-live-count-go(src, at, n, 41, 0);
   let mx4 = ds4t-live-count-go(src, at, n, 40, 0);
   let iq2 = ds4t-live-count-go(src, at, n, 16, 0);
   let i32 = ds4t-live-count-go(src, at, n, 26, 0);
   let types = gti-types(src);
   f32 == 34 && f16 == 17 && mx8 == 25 && mx4 == 6 && iq2 == 3 && i32 == 1 && (f32 + f16 + mx8 + mx4 + iq2 + i32) == n
    && gti-count-in(types, 0) == 34 && gti-count-in(types, 1) == 17 && gti-count-in(types, 41) == 25 && gti-count-in(types, 40) == 6
    && dfb-blocks(src, ".attn_compressor_kv.weight") == [1, 2] && dfb-blocks(src, ".attn_compressor_gate.weight") == [1, 2]
    && dfb-blocks(src, ".attn_compressor_ape.weight") == [1, 2] && dfb-blocks(src, ".attn_compressor_norm.weight") == [1, 2]
    && dfb-blocks(src, ".ffn_gate_tid2eid.weight") == [0] && dfb-blocks(src, ".exp_probs_b.bias") == [1, 2]
    && dfb-blocks(src, ".ffn_gate_exps.weight") == [0, 1, 2] && dfb-blocks(src, ".ffn_up_exps.weight") == [0, 1, 2] && dfb-blocks(src, ".ffn_down_exps.weight") == [0, 1, 2]
    && dfb-blocks(src, ".hc_attn_fn.weight") == [0, 1, 2] && dfb-blocks(src, ".attn_q_a.weight") == [0, 1, 2];
  }

  // ---- 16
  def dfb-zero-run(path, at, n) { let pad = read_file_slice(path, at, n); n == 0 ? true : (str_len(pad) == n && str_eq(pad, dfx-pad(n))); }
  def dfb-bytes-at(path, base, specs, offs, i) {
   let s = specs[i];
   let n = dfx-tbytes(s[1], s[2]);
   let padn = dfx-align(n) - n;
   i == len(specs) - 1 ? str_eq(read_file_slice(path, base + offs[i], n), dfx-tensor-bytes(s))
    : (str_eq(read_file_slice(path, base + offs[i], n), dfx-tensor-bytes(s)) && dfb-zero-run(path, base + offs[i] + n, padn) && dfb-bytes-at(path, base, specs, offs, i + 1));
  }
  def dfb-bytes(path, specs) = dfb-bytes-at(path, 7168, specs, dfx-offsets(specs, 0), 0);

  // ---- 32
  def dfb-same(a, b, specs) {
   let sa = read_file_slice(a, 0, file_size(a));
   let sb = read_file_slice(b, 0, file_size(b));
   file_size(a) == file_size(b) && str_len(sa) == str_len(sb) && str_eq(sa, sb) && dfb-sha(a) == dfb-sha(b) && dfb-sha(a) != "";
  }

  // ---- 64
  def dfb-digest(path) = dfb-sha(path) == dfb-pinned();

  // ---- 128
  def dfb-find(specs, name, i) = specs[i][0] == name ? i : dfb-find(specs, name, i + 1);
  def dfb-hash-ok(r, specs, t) = t == 32 ? true : (dfo-i32-row(r, "blk.0.ffn_gate_tid2eid.weight", t) == dfx-hash-row(specs[dfb-find(specs, "blk.0.ffn_gate_tid2eid.weight", 0)], t) && dfo-i32-row(r, "blk.0.ffn_gate_tid2eid.weight", t)[0] != dfo-i32-row(r, "blk.0.ffn_gate_tid2eid.weight", t)[1] && dfb-hash-ok(r, specs, t + 1));
  def dfb-all-in(xs, lo, hi) = len(xs) == 0 ? true : (xs[0] >= lo && xs[0] < hi && dfb-all-in(xs[1:], lo, hi));
  def dfb-all-mag(xs, lo, hi) = len(xs) == 0 ? true : (abs(xs[0]) >= lo && abs(xs[0]) < hi && dfb-all-mag(xs[1:], lo, hi));
  def dfb-oracle(path, specs) {
   let r = dfo-open(path);
   let admitted = dfo-admit-model(r);
   let g = dfo-geometry(r);
   let norm = dfo-plain(r, "blk.0.attn_norm.weight", 0);
   let embd = dfo-plain(r, "token_embd.weight", 7);
   let bias1 = dfo-plain(r, "blk.1.exp_probs_b.bias", 0);
   let bias2 = dfo-plain(r, "blk.2.exp_probs_b.bias", 0);
   admitted == 1 && dfo-admit-position(r, 0) == 1 && dfo-admit-position(r, 4095) == 1
    && record_get(g, "e") == 256 && record_get(g, "nh") == 2 && record_get(g, "hd") == 128 && record_get(g, "nrot") == 64 && record_get(g, "ng") == 2 && record_get(g, "hc") == 4
    && dfb-hash-ok(r, specs, 0)
    && len(norm) == 256 && dfb-all-in(norm, 1.0, 1.25) && len(embd) == 256 && dfb-all-mag(embd, 0.0078125, 0.125)
    && len(bias1) == 4 && bias1[3] < -9.9e29 && dfb-all-mag(dnr-take(bias1, 3), 0.03125, 0.0625)
    && len(bias2) == 4 && dfb-all-mag(bias2, 0.03125, 0.0625);
  }

  // ---- 256
  def dfb-flip(s, k) = substring(s, 0, k) ++ byte_to_str((str_byte_at(s, k) + 1) % 256) ++ substring(s, k + 1, str_len(s));
  def dfb-refuses-admission(path) = try (dfo-admit-model(dfo-open(path)) == 0) catch true;
  def dfb-retype(specs, name) = len(specs) == 0 ? [] : cons(specs[0][0] == name ? [specs[0][0], 0, specs[0][2], specs[0][3], specs[0][4], specs[0][5]] : specs[0], dfb-retype(specs[1:], name));
  def dfb-negatives(root, path, specs) {
   let whole = read_file_slice(path, 0, file_size(path));
   let at = 7168 + dfx-offsets(specs, 0)[10] + 5;
   let flipped = root ++ "-flipped.gguf";
   let wf = write_file(flipped, dfb-flip(whole, at));
   let cut = root ++ "-cut.gguf";
   let wc = write_file(cut, substring(whole, 0, 1000000));
   let retyped = root ++ "-retyped.gguf";
   let wr = write_file(retyped, dfx-image(dfb-retype(specs, "blk.0.hc_attn_fn.weight")));
   let caught = (!dfb-bytes(flipped, specs)) && dfb-sha(flipped) != dfb-pinned() && dfb-sha(flipped) != "" && dfb-refuses-admission(cut) && dfb-refuses-admission(retyped);
   let x1 = host_path_remove(flipped);
   let x2 = host_path_remove(cut);
   let x3 = host_path_remove(retyped);
   caught && wf == str_len(whole) && wc == 1000000 && x1 == 0 && x2 == 0 && x3 == 0;
  }
 }
 let root = temp_dir() ++ "/dsv4-fixture-gguf-band-" ++ now_unix_ms().str();
 let pathA = root ++ "-a.gguf";
 let pathB = root ++ "-b.gguf";
 let specs = dfx-specs();
 let wroteA = dfx-write(pathA);
 let wroteB = dfx-write(pathB);
 // a claim that stops (a reader or the oracle refuses by form_error) reads as a dark bit, not as a stopped band
 let c1 = dfb-bit(try dfb-built(pathA, wroteA, specs) catch false, 1);
 let c2 = dfb-bit(try dfb-header(pathA) catch false, 2);
 let c4 = dfb-bit(try dfb-table(pathA, specs) catch false, 4);
 let c8 = dfb-bit(try dfb-census(pathA) catch false, 8);
 let c16 = dfb-bit(try dfb-bytes(pathA, specs) catch false, 16);
 let c32 = dfb-bit(try dfb-same(pathA, pathB, specs) catch false, 32);
 let c64 = dfb-bit(try dfb-digest(pathA) catch false, 64);
 let c128 = dfb-bit(try dfb-oracle(pathA, specs) catch false, 128);
 let c256 = dfb-bit(try dfb-negatives(root, pathA, specs) catch false, 256);
 let digest = dfb-sha(pathA);
 let r1 = host_path_remove(pathA);
 let r2 = host_path_remove(pathB);
 print_str("dsv4-fixture-gguf-band claims " ++ c1.str() ++ " " ++ c2.str() ++ " " ++ c4.str() ++ " " ++ c8.str() ++ " " ++ c16.str() ++ " " ++ c32.str() ++ " " ++ c64.str() ++ " " ++ c128.str() ++ " " ++ c256.str() ++ " sha " ++ digest ++ " removed " ++ r1.str() ++ r2.str());
 c1 + c2 + c4 + c8 + c16 + c32 + c64 + c128 + c256;
}
