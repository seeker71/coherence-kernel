// Compile real source in isolated temporary files; invalid calls must name
// their argument count before the source runner sees a malformed special form.
// Valid binary calls retain their values and short-circuit behavior.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class BooleanArityBand {
  def scbab-run(root, id, expression, count) {
   let base = str_concat(root,str_concat("/",int_to_str(id)));
   let path = str_concat(base,".bml");
   let source = str_concat("section [form.bml] {\n",str_concat(expression,";\n}\n"));
   write_file(path,source);
   let output = str_concat(base,".stdout");
   let errors = str_concat(base,".stderr");
   let args = if lt(count,0) then list("./fkwu",path) else list("./fkwu","--check",path);
   let pid = host_spawn_at(args,list("/dev/null",output,errors));
   if le(pid,0) then form_error("boolean arity witness could not start fkwu") else {
    let status = host_wait(pid);
    let stderr = read_file(errors);
    let expected = str_concat("source-compile: form.bml boolean call requires 2 arguments; got ",str_concat(int_to_str(count),str_concat(": ",expression)));
    let ok = if lt(count,0) then and(eq(status,0),str_eq(read_file(output),"1\n"))
             else and(not(eq(status,0)),ge(str_find(stderr,expected,0),0));
    if ok then 1 else form_error(str_concat("boolean arity witness failed: ",str_concat(path,str_concat("\n",stderr))));
   };
  }
  def scbab-cases(root, rows, id) = if nil?(rows) then 1 else {
   let row = head(rows);
   if scbab-run(root,id,head(row),nth(row,1)) then scbab-cases(root,tail(rows),add(id,1))
   else form_error("boolean arity witness did not finish");
  }
 }
 let root = str_concat("/tmp/form-boolean-arity-",int_to_str(now_unix_ms()));
 if not(eq(host_dir_mkdir(root),1)) then form_error("boolean arity witness needs a fresh directory") else 0;
 scbab-cases(root,list(
  list("and()",0),list("or()",0),
  list("and(1)",1),list("or(0)",1),
  list("and(1,1,1)",3),list("or(0,0,1)",3),
  list("and(1,1,1,1,1)",5),list("or(0,0,0,0,1)",5),
  list("and(1,1)",-1),list("or(0,1)",-1),
  list("eq(and(0,form_error(\"unreached\")),0)",-1),
  list("eq(or(1,form_error(\"unreached\")),1)",-1),
  list("and(eq(str_len(\"and(1,2,3)\"),10),or(0,1))",-1)
 ),0);
}
