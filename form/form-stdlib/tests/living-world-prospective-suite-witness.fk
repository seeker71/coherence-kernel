; living-world-prospective-suite-witness.fk -- one predeclared held-out suite
; compares a plural incumbent with a consent-differentiated candidate across
; several unseen bindings while retaining non-ONE and temporal observations.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-prospective-suite.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk

(let LWPSW-MODELS      (bp "LWPSW-MODELS"))
(let LWPSW-SOURCE-A    (bp "LWPSW-SOURCE-A"))
(let LWPSW-SOURCE-B    (bp "LWPSW-SOURCE-B"))
(let LWPSW-PROVENANCE  (bp "LWPSW-PROVENANCE"))
(let LWPSW-ACTION      (bp "LWPSW-ACTION"))
(let LWPSW-EVIDENCE    (bp "LWPSW-EVIDENCE"))
(let LWPSW-ALTERNATIVE (bp "LWPSW-ALTERNATIVE"))
(let LWPSW-REASON      (bp "LWPSW-REASON"))
(let LWPSW-CASE-KEY    (bp "LWPSW-CASE-KEY"))
(let LWPSW-ROLE        (bp "LWPSW-ROLE"))
(let LWPSW-LENS        (bp "LWPSW-LENS"))

(defn lwpsw-cell (kind) (intern_node kind (empty)))
(defn lwpsw-source-a () (lwpsw-cell LWPSW-SOURCE-A))
(defn lwpsw-source-b () (lwpsw-cell LWPSW-SOURCE-B))
(defn lwpsw-evidence () (lwpsw-cell LWPSW-EVIDENCE))
(defn lwpsw-alternative () (lwpsw-cell LWPSW-ALTERNATIVE))
(defn lwpsw-reason () (lwpsw-cell LWPSW-REASON))
(defn lwpsw-action () (lwpsw-cell LWPSW-ACTION))
(defn lwpsw-provenance () (lwpsw-cell LWPSW-PROVENANCE))
(defn lwpsw-alternatives ()
    (lwo-field (list (lwpsw-alternative))))
(defn lwpsw-unknown () (lwlc-unknown (lwpsw-evidence)))

(defn lwpsw-entry (source payload)
    (lwt-entry
        (lwo-offer source (lwo-interface (list (lwpsw-action))) 1
            payload (lwpsw-provenance) 1)
        (lwpsw-action)))

; Build an incumbent field and then admit two independent differentiation
; placements and their tissue through ordinary tending responses.
(defn lwpsw-models (world field-model field-shape tissue-model tissue-shape)
    (intern_node LWPSW-MODELS
        (list world field-model field-shape tissue-model tissue-shape)))
(defn lwpsw-model-world (models) (nth (node_children models) 0))
(defn lwpsw-field-model (models) (nth (node_children models) 1))
(defn lwpsw-field-shape (models) (nth (node_children models) 2))
(defn lwpsw-tissue-model (models) (nth (node_children models) 3))
(defn lwpsw-tissue-shape (models) (nth (node_children models) 4))

(defn lwpsw-diff-role (name)
    (intern_node LWPSW-ROLE
        (list (intern_trivial_int 100) (intern_trivial_string name))))
(defn lwpsw-diff-left ()
    (lwre-binding "left" (lwpsw-diff-role "left")
        (intern_trivial_int 5) (lwpsw-evidence)))
(defn lwpsw-diff-right ()
    (lwre-binding "right" (lwpsw-diff-role "right")
        (intern_trivial_int 2) (lwpsw-evidence)))
(defn lwpsw-diff-bindings ()
    (lwre-bindings (list (lwpsw-diff-left) (lwpsw-diff-right))))
(defn lwpsw-diff-probe (field-model)
    (lwph-probe field-model (lwpsw-diff-bindings)
        (intern_trivial_int 7) (oac-one (intern_trivial_int 7))
        (lwpsw-alternatives) (lwpsw-unknown) (lwpsw-evidence)))
(defn lwpsw-diff-entries (source field-model)
    (list
        (lwpsw-entry source (lwpsw-diff-role "left"))
        (lwpsw-entry source (lwpsw-diff-role "right"))
        (lwpsw-entry source (intern_trivial_int 5))
        (lwpsw-entry source (intern_trivial_int 2))
        (lwpsw-entry source (lwpsw-diff-left))
        (lwpsw-entry source (lwpsw-diff-right))
        (lwpsw-entry source (lwpsw-diff-probe field-model))))

(defn lwpsw-build-models ()
    (do
        (let field-fixture (lwphw-integrated-field))
        (let field-model (lwphw-field-candidate field-fixture))
        (let field-shape (lwphw-field-shape field-fixture))
        (let placement (lwphw-observed-placement field-fixture))
        (let placement-world
            (lwt-round-world (lwphw-probe-round placement)))
        (let second-probe (lwpsw-diff-probe field-model))
        (let second-world
            (lwt-receive-stream placement-world
                (append
                    (lwpsw-diff-entries (lwpsw-source-a) field-model)
                    (lwpsw-diff-entries (lwpsw-source-b) field-model))))
        (let second-placement
            (lwph-placement-for second-world second-probe 2))
        (let second-proposal
            (lwph-probe-proposal second-world second-probe 2))
        (let second-answered
            (lwphw-answered-round second-world second-proposal
                (lwphw-probe-round placement)))
        (let second-integrated
            (lwph-probe-integrate second-answered second-proposal
                (lwphw-action)))
        (let tissue-world (lwt-round-world second-integrated))
        (let tissue-shape
            (lwht-tissue-for tissue-world field-model 2))
        (let tissue-proposal
            (lwht-proposal tissue-world field-model 2))
        (let tissue-model
            (lwt-proposal-candidate tissue-proposal))
        (let answered
            (lwphw-answered-round tissue-world tissue-proposal
                second-integrated))
        (let integrated
            (lwht-integrate answered tissue-proposal (lwphw-action)))
        (lwpsw-models (lwt-round-world integrated) field-model field-shape
            tissue-model tissue-shape)))

(defn lwpsw-incumbent (models)
    (lwps-candidate (lwpsw-field-model models)
        (lwph-field-consistent (lwpsw-field-shape models))
        (lwpsw-evidence)))
(defn lwpsw-arriving (models)
    (lwps-candidate (lwpsw-tissue-model models)
        (lwht-tissue-hypotheses (lwpsw-tissue-shape models))
        (lwpsw-evidence)))

(defn lwpsw-case-key (index)
    (intern_node LWPSW-CASE-KEY (list (intern_trivial_int index))))
(defn lwpsw-role (index name)
    (intern_node LWPSW-ROLE
        (list (lwpsw-case-key index) (intern_trivial_string name))))
(defn lwpsw-binding (index name value)
    (lwre-binding name (lwpsw-role index name)
        (intern_trivial_int value) (lwpsw-evidence)))
(defn lwpsw-bindings (index left right)
    (lwre-bindings
        (list (lwpsw-binding index "left" left)
              (lwpsw-binding index "right" right))))
(defn lwpsw-lens (index)
    (lwlc-lens (lwlc-cell-shape)
        (intern_node LWPSW-LENS (list (lwpsw-case-key index)))
        (lwpsw-evidence)))

(defn lwpsw-case-one (index left right expected lens)
    (lwps-case (lwpsw-bindings index left right)
        (oac-one (intern_trivial_int expected))
        (lwo-none) (lwo-none) (lwpsw-alternatives) (lwpsw-unknown)
        lens (lwpsw-evidence)))
(defn lwpsw-case-pending ()
    (lwps-case (lwpsw-bindings 3 1 1) (oac-nothing)
        (oac-timeout (intern_trivial_int 10) (oac-no-default)
            (lwpsw-evidence))
        (intern_trivial_int 5) (lwpsw-alternatives) (lwpsw-unknown)
        (lwo-none) (lwpsw-evidence)))
(defn lwpsw-case-condensed ()
    (do
        (let alternative
            (oac-alternative-ack (lwpsw-case-key 4)
                (lwpsw-alternative) (lwpsw-evidence)))
        (lwps-case (lwpsw-bindings 4 1 2) (oac-nothing)
            (oac-timeout (intern_trivial_int 10) alternative
                (lwpsw-evidence))
            (intern_trivial_int 10) (lwpsw-alternatives) (lwpsw-unknown)
            (lwpsw-lens 4) (lwpsw-evidence))))
(defn lwpsw-case-zero ()
    (lwps-case (lwpsw-bindings 5 2 3) (oac-zero)
        (lwo-none) (lwo-none) (lwo-empty-field) (lwo-none)
        (lwo-none) (lwpsw-evidence)))
(defn lwpsw-case-alternative ()
    (lwps-case (lwpsw-bindings 6 3 5)
        (oac-alternative-ack (lwpsw-case-key 6)
            (lwpsw-alternative) (lwpsw-evidence))
        (lwo-none) (lwo-none) (lwpsw-alternatives) (lwpsw-unknown)
        (lwpsw-lens 6) (lwpsw-evidence)))

(defn lwpsw-cases ()
    (lwo-field
        (list
            (lwpsw-case-one 0 5 6 11 (lwo-none))
            (lwpsw-case-one 1 8 3 11 (lwpsw-lens 1))
            (lwpsw-case-one 2 10 4 14 (lwo-none))
            (lwpsw-case-pending)
            (lwpsw-case-condensed)
            (lwpsw-case-zero)
            (lwpsw-case-alternative))))
(defn lwpsw-dataset ()
    (lwps-dataset (lwpsw-cases) (lwpsw-evidence)))
(defn lwpsw-split ()
    (lwps-split
        (lwo-field (list (lwphw-train-bindings)))
        (lwo-field (list (lwphw-probe-bindings) (lwpsw-diff-bindings)))
        (lwps-dataset-bindings (lwpsw-dataset))
        (lwpsw-evidence)))
(defn lwpsw-contract ()
    (lwps-contract (lwps-exact-identity) (lwo-none)
        (lwpsw-alternatives) (lwpsw-unknown) (lwpsw-evidence)))
(defn lwpsw-suite ()
    (lwps-suite (lwpsw-dataset) (lwpsw-split) (lwpsw-contract)
        (lwpsw-evidence)))

(defn lwpsw-binding-entries (source items entries)
    (if (eq (len items) 0) entries
        (do
            (let binding (head items))
            (lwpsw-binding-entries source (tail items)
                (cons (lwpsw-entry source binding)
                    (cons (lwpsw-entry source (lwre-binding-source binding))
                        (cons (lwpsw-entry source
                                (lwre-binding-value binding)) entries)))))))
(defn lwpsw-case-entries (source items entries)
    (if (eq (len items) 0) entries
        (do
            (let case (head items))
            (lwpsw-case-entries source (tail items)
                (lwpsw-binding-entries source
                    (lwre-binding-items (lwps-case-bindings case))
                    (cons (lwpsw-entry source case) entries))))))
(defn lwpsw-suite-entries (source incumbent arriving)
    (lwpsw-case-entries source (lwo-field-items (lwpsw-cases))
        (list
            (lwpsw-entry source incumbent)
            (lwpsw-entry source arriving)
            (lwpsw-entry source (lwpsw-dataset))
            (lwpsw-entry source (lwpsw-split))
            (lwpsw-entry source (lwpsw-contract))
            (lwpsw-entry source (lwpsw-suite)))))

(defn lwpsw-int-lists-equal? (left right)
    (if (not (eq (len left) (len right))) 0
        (if (eq (len left) 0) 1
            (if (eq (head left) (head right))
                (lwpsw-int-lists-equal? (tail left) (tail right)) 0))))

(defn lwpsw-zero-vector? (items)
    (if (eq (len items) 0) 1
        (if (eq (head items) 0)
            (lwpsw-zero-vector? (tail items)) 0)))

(defn lwpsw-derivation-count (items)
    (if (eq (len items) 0) 0
        (add (lwo-field-size
                (lwps-placement-derivations (head items)))
            (lwpsw-derivation-count (tail items)))))

(defn lwpsw-run (started)
    (do
        (let model-enter
            (lcfb-call-stream "living-world-prospective-suite"
                "grow-candidates" "enter" "form-native"
                "lwph-field-for/lwht-tissue-for"
                "plural-incumbent-and-differentiated-arrival" 1 started
                "form/form-stdlib/tests/living-world-prospective-suite-witness.fk"
                241 9))
        (let models (lwpsw-build-models))
        (let incumbent (lwpsw-incumbent models))
        (let arriving (lwpsw-arriving models))
        (let model-leave
            (lcfb-call-stream "living-world-prospective-suite"
                "grow-candidates" "leave" "form-native"
                "lwht-integrate" "incumbent:4:arriving:2" 2 started
                "form/form-stdlib/tests/living-world-prospective-suite-witness.fk"
                251 9))

        (let suite-enter
            (lcfb-call-stream "living-world-prospective-suite"
                "predeclare-suite" "enter" "form-native"
                "lwt-receive-stream"
                "candidate-dataset-split-contract-identities" 3 started
                "form/form-stdlib/tests/living-world-prospective-suite-witness.fk"
                258 9))
        (let observed
            (lwt-receive-stream (lwpsw-model-world models)
                (append
                    (lwpsw-suite-entries
                        (lwpsw-source-a) incumbent arriving)
                    (lwpsw-suite-entries
                        (lwpsw-source-b) incumbent arriving))))
        (let suite (lwpsw-suite))
        (let suite-leave
            (lcfb-call-stream "living-world-prospective-suite"
                "predeclare-suite" "leave" "form-native"
                "lwps-suite-current?" "cases:7:sources:2:disjoint:1" 4 started
                "form/form-stdlib/tests/living-world-prospective-suite-witness.fk"
                273 9))

        (let incumbent-enter
            (lcfb-call-stream "living-world-prospective-suite"
                "evaluate-incumbent" "enter" "form-native"
                "lwps-evaluate" "same-heldout-suite" 5 started
                "form/form-stdlib/tests/living-world-prospective-suite-witness.fk"
                280 9))
        (let incumbent-evaluation
            (lwps-evaluate observed incumbent suite 2))
        (let incumbent-metrics
            (lwps-evaluation-metrics incumbent-evaluation))
        (let incumbent-leave
            (lcfb-call-stream "living-world-prospective-suite"
                "evaluate-incumbent" "leave" "form-native"
                "lwps-metrics-for"
                (lcfb-cat (list "exact:"
                    (int_to_str (lwps-metrics-value incumbent-metrics 2))
                    ":plural:"
                    (int_to_str (lwps-metrics-value incumbent-metrics 3))
                    ":nothing-now:"
                    (int_to_str (lwps-metrics-value incumbent-metrics 6))))
                6 started
                "form/form-stdlib/tests/living-world-prospective-suite-witness.fk"
                290 9))

        (let arriving-enter
            (lcfb-call-stream "living-world-prospective-suite"
                "evaluate-arrival" "enter" "form-native"
                "lwps-evaluate" "same-heldout-suite" 7 started
                "form/form-stdlib/tests/living-world-prospective-suite-witness.fk"
                304 9))
        (let arriving-evaluation
            (lwps-evaluate observed arriving suite 2))
        (let arriving-metrics
            (lwps-evaluation-metrics arriving-evaluation))
        (let arriving-leave
            (lcfb-call-stream "living-world-prospective-suite"
                "evaluate-arrival" "leave" "form-native"
                "lwps-metrics-for"
                (lcfb-cat (list "exact:"
                    (int_to_str (lwps-metrics-value arriving-metrics 2))
                    ":plural:"
                    (int_to_str (lwps-metrics-value arriving-metrics 3))
                    ":nothing-now:"
                    (int_to_str (lwps-metrics-value arriving-metrics 6))))
                8 started
                "form/form-stdlib/tests/living-world-prospective-suite-witness.fk"
                314 9))

        (let compare-enter
            (lcfb-call-stream "living-world-prospective-suite"
                "compare" "enter" "form-native" "lwps-compare"
                "identity-aligned-vector" 9 started
                "form/form-stdlib/tests/living-world-prospective-suite-witness.fk"
                328 9))
        (let comparison
            (lwps-compare incumbent-evaluation arriving-evaluation))
        (let comparison-delta
            (lwps-delta-values (lwps-comparison-delta comparison)))
        (let repeated
            (lwps-compare incumbent-evaluation incumbent-evaluation))
        (let changed-contract
            (lwps-contract (lwps-exact-identity) (lwpsw-lens 8)
                (lwpsw-alternatives) (lwpsw-unknown) (lwpsw-evidence)))
        (let misaligned-evaluation
            (lwps-evaluation arriving (lwpsw-dataset) (lwpsw-split)
                changed-contract
                (lwps-evaluation-placements arriving-evaluation)
                arriving-metrics))
        (let misaligned
            (lwps-compare incumbent-evaluation misaligned-evaluation))
        (let compare-leave
            (lcfb-call-stream "living-world-prospective-suite"
                "compare" "leave" "form-native" "lwps-compare"
                (lcfb-cat (list
                    "admissible:"
                    (int_to_str (lwps-comparison-admissible comparison))
                    ":repeated:"
                    (int_to_str (lwps-comparison-repeated comparison))
                    ":exact-delta:" (int_to_str (nth comparison-delta 2))
                    ":plural-delta:" (int_to_str (nth comparison-delta 3))))
                10 started
                "form/form-stdlib/tests/living-world-prospective-suite-witness.fk"
                350 9))

        (let authority-enter
            (lcfb-call-stream "living-world-prospective-suite"
                "authority" "enter" "form-native" "lwo-revocation"
                "candidate-support-and-dataset-case" 11 started
                "form/form-stdlib/tests/living-world-prospective-suite-witness.fk"
                364 9))
        (let candidate-revoked
            (lwt-receive-stream observed
                (list
                    (lwpsw-entry (lwpsw-source-a)
                        (lwo-revocation arriving (lwpsw-source-a)
                            (lwpsw-reason) (lwpsw-provenance))))))
        (let arriving-after-candidate-revoke
            (lwps-evaluate candidate-revoked arriving suite 2))
        (let incumbent-after-candidate-revoke
            (lwps-evaluate candidate-revoked incumbent suite 2))
        (let first-case
            (head (lwo-field-items (lwpsw-cases))))
        (let case-revoked
            (lwt-receive-stream observed
                (list
                    (lwpsw-entry (lwpsw-source-a)
                        (lwo-revocation first-case (lwpsw-source-a)
                            (lwpsw-reason) (lwpsw-provenance))))))
        (let incumbent-after-case-revoke
            (lwps-evaluate case-revoked incumbent suite 2))
        (let arriving-after-case-revoke
            (lwps-evaluate case-revoked arriving suite 2))
        (let authority-leave
            (lcfb-call-stream "living-world-prospective-suite"
                "authority" "leave" "form-native" "lwps-evaluate"
                (lcfb-cat (list
                    "candidate-local-stale:"
                    (int_to_str (if (node_eq
                        arriving-after-candidate-revoke (lwo-none)) 1 0))
                    ":dataset-gate-closed:"
                    (int_to_str (if (and
                        (node_eq incumbent-after-case-revoke (lwo-none))
                        (node_eq arriving-after-case-revoke (lwo-none))) 1 0))))
                12 started
                "form/form-stdlib/tests/living-world-prospective-suite-witness.fk"
                392 9))

        (list models incumbent arriving suite observed
              incumbent-evaluation arriving-evaluation comparison repeated
              misaligned candidate-revoked arriving-after-candidate-revoke
              incumbent-after-candidate-revoke case-revoked
              incumbent-after-case-revoke arriving-after-case-revoke)))

(defn lwpsw-verdict (result)
    (do
        (let models (nth result 0))
        (let incumbent (nth result 1))
        (let arriving (nth result 2))
        (let suite (nth result 3))
        (let observed (nth result 4))
        (let incumbent-evaluation (nth result 5))
        (let arriving-evaluation (nth result 6))
        (let comparison (nth result 7))
        (let repeated (nth result 8))
        (let misaligned (nth result 9))
        (let candidate-revoked (nth result 10))
        (let arriving-after-candidate-revoke (nth result 11))
        (let incumbent-after-candidate-revoke (nth result 12))
        (let case-revoked (nth result 13))
        (let incumbent-after-case-revoke (nth result 14))
        (let arriving-after-case-revoke (nth result 15))
        (let incumbent-metrics
            (lwps-evaluation-metrics incumbent-evaluation))
        (let arriving-metrics
            (lwps-evaluation-metrics arriving-evaluation))
        (sum (list
            (if (eq (lwo-field-size
                        (lwph-field-operators
                            (lwpsw-field-shape models))) 3) 1 0)
            (if (eq (lwo-field-size
                        (lwps-candidate-hypotheses incumbent)) 4) 2 0)
            (if (gt (lwo-field-size
                        (lwph-field-refuted
                            (lwpsw-field-shape models))) 0) 4 0)
            (if (eq (lwo-field-size
                        (lwht-tissue-compatible
                            (lwpsw-tissue-shape models))) 2) 8 0)
            (if (eq (lwo-field-size
                        (lwht-tissue-contradicted
                            (lwpsw-tissue-shape models))) 2) 16 0)
            (if (eq (lwo-field-size
                        (lwps-candidate-hypotheses arriving)) 2) 32 0)
            (if (not (node_eq incumbent arriving)) 64 0)
            (if (eq (lwo-field-size
                        (lwps-dataset-cases (lwps-suite-dataset suite))) 7)
                128 0)
            (if (eq (lwps-split-shape-valid?
                        (lwps-suite-split suite)) 1) 256 0)
            (if (node_eq
                    (lwps-split-prospective (lwps-suite-split suite))
                    (lwps-dataset-bindings (lwps-suite-dataset suite))) 512 0)
            (if (eq (lwps-suite-current? observed suite 2) 1) 1024 0)
            (if (eq (lwps-candidate-current? observed incumbent 2) 1) 2048 0)
            (if (eq (lwps-candidate-current? observed arriving 2) 1) 4096 0)
            (if (eq (lwps-evaluation? incumbent-evaluation) 1) 8192 0)
            (if (eq (lwps-evaluation? arriving-evaluation) 1) 16384 0)
            (if (eq (lwpsw-int-lists-equal?
                        (lwps-metrics-values incumbent-metrics)
                        (list 7 3 0 3 0 0 2 1 1 1 1 6 6)) 1) 32768 0)
            (if (eq (lwpsw-int-lists-equal?
                        (lwps-metrics-values arriving-metrics)
                        (list 7 3 3 0 0 0 2 1 1 1 1 3 6)) 1) 65536 0)
            (if (and (eq (lwo-field-size
                            (lwps-evaluation-placements
                                incumbent-evaluation)) 7)
                     (and (eq (lwo-field-size
                                (lwps-evaluation-placements
                                    arriving-evaluation)) 7)
                          (and (eq (lwpsw-derivation-count
                                    (lwo-field-items
                                        (lwps-evaluation-placements
                                            incumbent-evaluation))) 12)
                               (eq (lwpsw-derivation-count
                                    (lwo-field-items
                                        (lwps-evaluation-placements
                                            arriving-evaluation))) 6))))
                131072 0)
            (if (and (eq (lwps-metrics-value incumbent-metrics 11) 6)
                     (eq (lwps-metrics-value arriving-metrics 11) 3))
                262144 0)
            (if (and (eq (lwps-metrics-value incumbent-metrics 6) 2)
                     (eq (lwps-metrics-value arriving-metrics 6) 2))
                524288 0)
            (if (and (eq (lwps-metrics-value incumbent-metrics 7) 1)
                     (and (eq (lwps-metrics-value incumbent-metrics 8) 1)
                          (and (eq (lwps-metrics-value arriving-metrics 7) 1)
                               (eq (lwps-metrics-value arriving-metrics 8) 1))))
                1048576 0)
            (if (and (eq (lwps-metrics-value incumbent-metrics 9) 1)
                     (and (eq (lwps-metrics-value incumbent-metrics 10) 1)
                          (and (eq (lwps-metrics-value arriving-metrics 9) 1)
