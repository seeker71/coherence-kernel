; living-world-composition-outcome-witness.fk -- interaction reopens a composition.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/living-world-multilens-plan.fk form-stdlib/living-world-composition-outcome.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk form-stdlib/tests/living-world-relational-voice-witness.fk form-stdlib/tests/living-world-multilens-witness.fk

(let LWCOW-SOURCE-F (bp "LWCOW-SOURCE-F"))
(let LWCOW-SOURCE-G (bp "LWCOW-SOURCE-G"))
(let LWCOW-SOURCE-H (bp "LWCOW-SOURCE-H"))
(let LWCOW-PROV-F (bp "LWCOW-PROV-F"))
(let LWCOW-PROV-G (bp "LWCOW-PROV-G"))
(let LWCOW-PROV-H (bp "LWCOW-PROV-H"))
(let LWCOW-EVIDENCE (bp "LWCOW-EVIDENCE"))

(defn lwcow-cell (kind) (intern_node kind (empty)))
(defn lwcow-source-f () (lwcow-cell LWCOW-SOURCE-F))
(defn lwcow-source-g () (lwcow-cell LWCOW-SOURCE-G))
(defn lwcow-source-h () (lwcow-cell LWCOW-SOURCE-H))
(defn lwcow-prov-f () (lwcow-cell LWCOW-PROV-F))
(defn lwcow-prov-g () (lwcow-cell LWCOW-PROV-G))
(defn lwcow-prov-h () (lwcow-cell LWCOW-PROV-H))
(defn lwcow-evidence () (lwcow-cell LWCOW-EVIDENCE))

(defn lwcow-bundle () (lwmpw-aligned-bundle))
(defn lwcow-primary ()
    (lwmp-bundle-primary-sequence (lwcow-bundle)))
(defn lwcow-alternative ()
    (lwrp-sequence
        (list (lwrvw-left) (lwmpw-third) (lwrvw-right))))

(defn lwcow-initial-proposal ()
    (lwco-proposal-for (lwmpw-world) (lwcow-bundle)))
(defn lwcow-response-entry (source provenance proposal)
    (lwrvw-entry-for source provenance
        (lwt-response proposal (oac-one proposal) provenance)))
(defn lwcow-base-responses (proposal)
    (list
        (lwcow-response-entry
            (lwslw-source-a) (lwslw-prov-a) proposal)
        (lwcow-response-entry
            (lwslw-source-b) (lwslw-prov-b) proposal)
        (lwcow-response-entry
            (lwslw-source-c) (lwslw-prov-c) proposal)
        (lwcow-response-entry
            (lwrvw-source-d) (lwrvw-prov-d) proposal)))
(defn lwcow-initial-round ()
    (lwt-round (lwmpw-world)
        (lwo-field (list (lwcow-initial-proposal)))
        (lwo-empty-field) (lwo-none)))
(defn lwcow-initial-yes-round ()
    (do
        (let round (lwcow-initial-round))
        (let proposal (head (lwo-field-items (lwt-round-proposals round))))
        (lwt-round-receive round (lwcow-base-responses proposal))))
(defn lwcow-initial-integrated-round ()
    (do
        (let round (lwcow-initial-yes-round))
        (let proposal (head (lwo-field-items (lwt-round-proposals round))))
        (lwco-integrate round proposal (lwrew-action))))
(defn lwcow-initial-integrated-world ()
    (lwt-round-world (lwcow-initial-integrated-round)))

(defn lwcow-confirmation ()
    (lwco-observation (lwcow-bundle) (lwcow-primary) (lwo-none)
        (oac-one (lwcow-primary)) (lwo-empty-field) (lwo-none)
        (lwcow-evidence)))
(defn lwcow-silence ()
    (lwco-observation (lwcow-bundle) (lwo-none) (lwo-none)
        (oac-nothing) (lwo-empty-field) (lwo-none)
        (lwcow-evidence)))
(defn lwcow-correction ()
    (lwco-observation (lwcow-bundle) (lwcow-alternative)
        (lwmpw-lens-gamma) (oac-zero)
        (lwo-field (list (lwcow-alternative)))
        (lwlc-unknown (lwcow-evidence)) (lwcow-evidence)))
(defn lwcow-alternative-offer ()
    (lwco-observation (lwcow-bundle) (lwo-none) (lwo-none)
        (oac-alternative-ack (lwcow-primary)
            (lwcow-alternative) (lwcow-evidence))
        (lwo-field (list (lwcow-alternative)))
        (lwlc-unknown (lwcow-evidence)) (lwcow-evidence)))
(defn lwcow-false-confirmation ()
    (lwco-observation (lwcow-bundle) (lwcow-alternative) (lwo-none)
        (oac-one (lwcow-alternative)) (lwo-empty-field) (lwo-none)
        (lwcow-evidence)))
(defn lwcow-false-correction ()
    (lwco-observation (lwcow-bundle) (lwcow-primary) (lwo-none)
        (oac-zero) (lwo-empty-field) (lwo-none) (lwcow-evidence)))

(defn lwcow-entry-f (payload)
    (lwrvw-entry-for (lwcow-source-f) (lwcow-prov-f) payload))
(defn lwcow-entry-g (payload)
    (lwrvw-entry-for (lwcow-source-g) (lwcow-prov-g) payload))
(defn lwcow-entry-h (payload)
    (lwrvw-entry-for (lwcow-source-h) (lwcow-prov-h) payload))

(defn lwcow-observed-world ()
    (lwt-receive-stream (lwcow-initial-integrated-world)
        (list
            (lwrvw-entry-e (lwcow-confirmation))
            (lwcow-entry-f (lwcow-silence)))))
(defn lwcow-confirmed-proposal ()
    (lwco-proposal-for (lwcow-observed-world) (lwcow-bundle)))
(defn lwcow-confirmed-round ()
    (lwt-round (lwcow-observed-world)
        (lwo-field (list (lwcow-confirmed-proposal)))
        (lwo-empty-field) (lwcow-initial-integrated-round)))
(defn lwcow-confirmed-yes-round ()
    (do
        (let round (lwcow-confirmed-round))
        (let proposal (head (lwo-field-items (lwt-round-proposals round))))
        (lwt-round-receive round
            (append (lwcow-base-responses proposal)
                (list
                    (lwcow-response-entry
                        (lwrvw-source-e) (lwrvw-prov-e) proposal)
                    (lwcow-response-entry
                        (lwcow-source-f) (lwcow-prov-f) proposal))))))
(defn lwcow-confirmed-integrated-round ()
    (do
        (let round (lwcow-confirmed-yes-round))
        (let proposal (head (lwo-field-items (lwt-round-proposals round))))
        (lwco-integrate round proposal (lwrew-action))))
(defn lwcow-confirmed-integrated-world ()
    (lwt-round-world (lwcow-confirmed-integrated-round)))

(defn lwcow-late-world ()
    (lwt-receive-stream (lwcow-confirmed-integrated-world)
        (list
            (lwcow-entry-g (lwcow-correction))
            (lwcow-entry-h (lwcow-alternative-offer)))))
(defn lwcow-contested-proposal ()
    (lwco-proposal-for (lwcow-late-world) (lwcow-bundle)))

(defn lwcow-alpha-first-candidate ()
    (lwt-proposal-candidate
        (lwmpw-find-proposal
            (lwt-round-proposals (lwmpw-relation-round))
            (lwrvw-relation) (lwrvw-left) (lwrvw-right))))

(defn lwcow-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwcow-sum (tail items)))))
