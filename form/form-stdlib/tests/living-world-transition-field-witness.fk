; living-world-transition-field-witness.fk -- opaque offered cells grow a
; plural next-change field without changing the organ's source vocabulary.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-transition-field.fk observe/live-call-framebuffer.fk

(let LWTFW-SOURCE-A (bp "LWTFW-SOURCE-A"))
(let LWTFW-SOURCE-B (bp "LWTFW-SOURCE-B"))
(let LWTFW-SOURCE-C (bp "LWTFW-SOURCE-C"))
(let LWTFW-SOURCE-D (bp "LWTFW-SOURCE-D"))
(let LWTFW-SOURCE-E (bp "LWTFW-SOURCE-E"))
(let LWTFW-SOURCE-F (bp "LWTFW-SOURCE-F"))
(let LWTFW-PROVENANCE (bp "LWTFW-PROVENANCE"))
(let LWTFW-RESPONSE-PROVENANCE (bp "LWTFW-RESPONSE-PROVENANCE"))
(let LWTFW-ACTION (bp "LWTFW-ACTION"))
(let LWTFW-REASON (bp "LWTFW-REASON"))
(let LWTFW-CELL-A (bp "LWTFW-CELL-A"))
(let LWTFW-CELL-B (bp "LWTFW-CELL-B"))
(let LWTFW-CELL-C (bp "LWTFW-CELL-C"))
(let LWTFW-CELL-D (bp "LWTFW-CELL-D"))
(let LWTFW-CELL-E (bp "LWTFW-CELL-E"))
(let LWTFW-CELL-F (bp "LWTFW-CELL-F"))
(let LWTFW-LENS (bp "LWTFW-LENS"))
(let LWTFW-ALTERNATIVE (bp "LWTFW-ALTERNATIVE"))
(let LWTFW-UNKNOWN (bp "LWTFW-UNKNOWN"))

(defn lwtfw-entry (source payload provenance)
    (lwt-entry
        (lwo-offer source (lwo-interface (list LWTFW-ACTION)) 1
            payload provenance 1)
        LWTFW-ACTION))

(defn lwtfw-response-entry (source proposal)
    (lwtfw-entry source
        (lwt-response proposal
            (oac-one (lwt-proposal-candidate proposal))
            LWTFW-RESPONSE-PROVENANCE)
        LWTFW-RESPONSE-PROVENANCE))

(defn lwtfw-proposal-next (proposal)
    (lwtf-observation-next
        (lwo-emergent-shape (lwt-proposal-candidate proposal))))

(defn lwtfw-proposal-for-next-items (items next)
    (if (eq (len items) 0) (lwo-none)
        (if (node_eq (lwtfw-proposal-next (head items)) next)
            (head items)
            (lwtfw-proposal-for-next-items (tail items) next))))

(defn lwtfw-proposal-for-next (proposals next)
    (lwtfw-proposal-for-next-items
        (lwo-field-items proposals) next))

(defn lwtfw-revoke-entry (source target)
    (lwtfw-entry source
        (lwo-revocation target source LWTFW-REASON LWTFW-PROVENANCE)
        LWTFW-PROVENANCE))

; Result fields retain the actual worlds, proposals, predictions, observations,
; and candidates.  The band inspects identities/counts only; no fixture surface
; is emitted.
(defn lwtfw-run (started)
    (do
        (let context (lwtf-context (list LWTFW-CELL-A LWTFW-CELL-B)))
        (let unseen-context (lwtf-context (list LWTFW-CELL-B)))
        (let observation-c
            (lwtf-observation context LWTFW-CELL-C (lwo-none)))
        (let observation-d
            (lwtf-observation context LWTFW-CELL-D LWTFW-LENS))
        (let observation-e
            (lwtf-observation context LWTFW-CELL-E (lwo-none)))
        (let observation-f
            (lwtf-observation context LWTFW-CELL-F LWTFW-LENS))

        (let receive-enter
            (lcfb-call-stream "living-world-transition-field"
                "receive-observations" "enter" "form-native"
                "lwt-receive-stream" "opaque-transition-observations" 1
                started
                "form/form-stdlib/tests/living-world-transition-field-witness.fk"
                74 13))
        (let observed-world
            (lwt-receive-stream (lwo-empty-world)
                (list
                    (lwtfw-entry LWTFW-SOURCE-A observation-c LWTFW-PROVENANCE)
                    (lwtfw-entry LWTFW-SOURCE-B observation-c LWTFW-PROVENANCE)
                    (lwtfw-entry LWTFW-SOURCE-C observation-d LWTFW-PROVENANCE)
                    (lwtfw-entry LWTFW-SOURCE-D observation-d LWTFW-PROVENANCE)
                    (lwtfw-entry LWTFW-SOURCE-A observation-e LWTFW-PROVENANCE))))
        (let receive-leave
            (lcfb-call-stream "living-world-transition-field"
                "receive-observations" "leave" "form-native"
                "lwt-receive-stream" "opaque-transition-observations" 2
                started
                "form/form-stdlib/tests/living-world-transition-field-witness.fk"
                89 13))

        (let propose-enter
            (lcfb-call-stream "living-world-transition-field"
                "propose-recurrence" "enter" "form-native"
                "lwtf-proposals" "threshold-two" 3 started
                "form/form-stdlib/tests/living-world-transition-field-witness.fk"
                97 13))
        (let proposals (lwtf-proposals observed-world 2))
        (let proposal-c (lwtfw-proposal-for-next proposals LWTFW-CELL-C))
        (let proposal-d (lwtfw-proposal-for-next proposals LWTFW-CELL-D))
        (let propose-leave
            (lcfb-call-stream "living-world-transition-field"
                "propose-recurrence" "leave" "form-native"
                "lwtf-proposals" "threshold-two" 4 started
                "form/form-stdlib/tests/living-world-transition-field-witness.fk"
                106 13))

        (let integrate-enter
            (lcfb-call-stream "living-world-transition-field"
                "consent-integrate" "enter" "form-native"
                "lwtf-integrate" "two-unranked-transitions" 5 started
                "form/form-stdlib/tests/living-world-transition-field-witness.fk"
                113 13))
        (let round
            (lwt-round observed-world proposals
                (lwo-empty-field) (lwo-none)))
        (let responded
            (lwt-round-receive round
                (list
                    (lwtfw-response-entry LWTFW-SOURCE-A proposal-c)
                    (lwtfw-response-entry LWTFW-SOURCE-B proposal-c)
                    (lwtfw-response-entry LWTFW-SOURCE-C proposal-d)
                    (lwtfw-response-entry LWTFW-SOURCE-D proposal-d))))
        (let integrated-c
            (lwtf-integrate responded proposal-c LWTFW-ACTION))
        (let integrated
            (lwtf-integrate integrated-c proposal-d LWTFW-ACTION))
        (let integrated-world (lwt-round-world integrated))
        (let integrate-leave
            (lcfb-call-stream "living-world-transition-field"
                "consent-integrate" "leave" "form-native"
                "lwtf-integrate" "two-unranked-transitions" 6 started
                "form/form-stdlib/tests/living-world-transition-field-witness.fk"
                134 13))

        (let predict-enter
            (lcfb-call-stream "living-world-transition-field"
                "predict-plural-unknown" "enter" "form-native"
                "lwtf-predict" "current-and-unseen-contexts" 7 started
                "form/form-stdlib/tests/living-world-transition-field-witness.fk"
                141 13))
        (let alternatives (lwo-field (list LWTFW-ALTERNATIVE)))
        (let plural
            (lwtf-predict integrated-world context alternatives LWTFW-UNKNOWN))
        (let unseen
            (lwtf-predict integrated-world unseen-context
                alternatives LWTFW-UNKNOWN))
        (let predict-leave
            (lcfb-call-stream "living-world-transition-field"
                "predict-plural-unknown" "leave" "form-native"
                "lwtf-predict" "current-and-unseen-contexts" 8 started
                "form/form-stdlib/tests/living-world-transition-field-witness.fk"
                153 13))

        (let grow-enter
            (lcfb-call-stream "living-world-transition-field"
                "grow-new-cell" "enter" "form-native"
                "lwtf-proposal-for" "previously-absent-next-cell" 9 started
                "form/form-stdlib/tests/living-world-transition-field-witness.fk"
                160 13))
        (let grown-observations
            (lwt-receive-stream integrated-world
                (list
                    (lwtfw-entry LWTFW-SOURCE-E observation-f LWTFW-PROVENANCE)
                    (lwtfw-entry LWTFW-SOURCE-F observation-f LWTFW-PROVENANCE))))
        (let proposal-f (lwtf-proposal-for grown-observations observation-f 2))
        (let growth-round
            (lwt-round grown-observations
                (lwo-field (list proposal-f)) (lwo-empty-field) integrated))
        (let growth-responses
            (lwt-round-receive growth-round
                (list
                    (lwtfw-response-entry LWTFW-SOURCE-E proposal-f)
                    (lwtfw-response-entry LWTFW-SOURCE-F proposal-f))))
        (let grown-round
            (lwtf-integrate growth-responses proposal-f LWTFW-ACTION))
        (let grown-world (lwt-round-world grown-round))
        (let grown-prediction
            (lwtf-predict grown-world context alternatives LWTFW-UNKNOWN))
        (let grow-leave
            (lcfb-call-stream "living-world-transition-field"
                "grow-new-cell" "leave" "form-native"
                "lwtf-proposal-for" "previously-absent-next-cell" 10 started
                "form/form-stdlib/tests/living-world-transition-field-witness.fk"
                185 13))

        (let revoke-enter
            (lcfb-call-stream "living-world-transition-field"
                "revoke-support" "enter" "form-native"
                "lwo-revocation" "source-local-transition-support" 11 started
                "form/form-stdlib/tests/living-world-transition-field-witness.fk"
                192 13))
        (let c-revoked-world
            (lwt-receive-stream grown-world
                (list (lwtfw-revoke-entry LWTFW-SOURCE-A observation-c))))
        (let after-c
            (lwtf-predict c-revoked-world context alternatives LWTFW-UNKNOWN))
        (let d-revoked-world
            (lwt-receive-stream c-revoked-world
                (list (lwtfw-revoke-entry LWTFW-SOURCE-C observation-d))))
        (let after-d
            (lwtf-predict d-revoked-world context alternatives LWTFW-UNKNOWN))
        (let foreign-revocation
            (lwt-receive-stream d-revoked-world
                (list (lwtfw-revoke-entry LWTFW-SOURCE-A observation-f))))
        (let after-foreign
            (lwtf-predict foreign-revocation context alternatives LWTFW-UNKNOWN))
        (let revoke-leave
            (lcfb-call-stream "living-world-transition-field"
                "revoke-support" "leave" "form-native"
                "lwo-revocation" "source-local-transition-support" 12 started
                "form/form-stdlib/tests/living-world-transition-field-witness.fk"
                213 13))

        (list context unseen-context observation-c observation-d observation-e
              observation-f observed-world proposals proposal-c proposal-d
              integrated-world plural unseen proposal-f grown-world
              grown-prediction c-revoked-world after-c d-revoked-world after-d
              foreign-revocation after-foreign)))

(defn lwtfw-verdict (r)
    (do
        (let context (nth r 0))
        (let observation-c (nth r 2))
        (let observation-d (nth r 3))
        (let observation-e (nth r 4))
        (let observation-f (nth r 5))
        (let observed-world (nth r 6))
        (let proposals (nth r 7))
        (let proposal-c (nth r 8))
        (let proposal-d (nth r 9))
        (let integrated-world (nth r 10))
        (let plural (nth r 11))
        (let unseen (nth r 12))
        (let proposal-f (nth r 13))
        (let grown-world (nth r 14))
        (let grown (nth r 15))
        (let c-revoked-world (nth r 16))
        (let after-c (nth r 17))
        (let d-revoked-world (nth r 18))
        (let after-d (nth r 19))
        (let foreign-world (nth r 20))
        (let after-foreign (nth r 21))
        (let candidate-c (lwt-proposal-candidate proposal-c))
        (let candidate-d (lwt-proposal-candidate proposal-d))
        (let candidate-f (lwt-proposal-candidate proposal-f))
        (sum (list
            (if (and (eq (lwtf-context? context) 1)
                     (eq (len (lwtf-context-items context)) 2)) 1 0)
            (if (eq (lwo-field-size proposals) 2) 2 0)
            (if (and (not (node_eq proposal-c (lwo-none)))
                     (not (node_eq proposal-d (lwo-none)))) 4 0)
            (if (and (eq (lwo-field-size
                            (lwt-proposal-participants proposal-c)) 2)
                     (eq (lwo-field-size
                            (lwt-proposal-participants proposal-d)) 2)) 8 0)
            (if (node_eq
                    (lwtf-proposal-for observed-world observation-e 2)
                    (lwo-none)) 16 0)
            (if (and (eq (lwtf-integrated-current?
                            integrated-world candidate-c) 1)
                     (eq (lwtf-integrated-current?
                            integrated-world candidate-d) 1)) 32 0)
            (if (and (eq (lwo-field-size
                            (lwtf-prediction-derivations plural)) 2)
                     (eq (lwo-field-size
                            (lwtf-prediction-nexts plural)) 2)) 64 0)
            (if (eq (oac-node? (lwtf-prediction-ack plural)) 1) 128 0)
            (if (eq (lwo-field-size
                        (lwtf-prediction-possibilities plural)) 3) 256 0)
            (if (and (node_eq
                        (lwtf-prediction-alternatives plural)
                        (lwo-field (list LWTFW-ALTERNATIVE)))
                     (node_eq (lwtf-prediction-unknown plural)
                        LWTFW-UNKNOWN)) 512 0)
            (if (and (eq (oac-nothing?
                            (lwtf-prediction-ack unseen)) 1)
                     (and (eq (lwo-field-size
                                (lwtf-prediction-derivations unseen)) 0)
                          (eq (lwo-field-size
                                (lwtf-prediction-possibilities unseen)) 0)))
                1024 0)
            (if (and (not (node_eq proposal-f (lwo-none)))
                     (eq (lwo-field-size
                            (lwt-proposal-participants proposal-f)) 2)) 2048 0)
            (if (and (eq (lwtf-integrated-current? grown-world candidate-f) 1)
                     (and (eq (lwo-field-size
                                (lwtf-prediction-nexts grown)) 3)
                          (eq (lwo-field-size
                                (lwtf-prediction-possibilities grown)) 4)))
                4096 0)
            (if (and (eq (lwtf-integrated-current?
                            c-revoked-world candidate-c) 0)
                     (and (eq (lwtf-integrated-current?
                                c-revoked-world candidate-d) 1)
                          (eq (lwtf-integrated-current?
                                c-revoked-world candidate-f) 1))) 8192 0)
            (if (and (eq (lwo-active? c-revoked-world candidate-c) 1)
                     (and (eq (lwo-field-size
                                (lwtf-prediction-nexts after-c)) 2)
                          (eq (lwo-field-has?
                                (lwtf-prediction-possibilities after-c)
                                LWTFW-CELL-C) 1))) 16384 0)
            (if (and (eq (lwtf-integrated-current?
                            d-revoked-world candidate-d) 0)
                     (and (eq (oac-one?
                                (lwtf-prediction-ack after-d)) 1)
                          (node_eq (oac-payload
                                (lwtf-prediction-ack after-d))
                                LWTFW-CELL-F))) 32768 0)
            (if (and (eq (lwo-field-has?
                            (lwtf-prediction-possibilities after-d)
                            LWTFW-CELL-E) 1)
                     (eq (lwo-field-has?
                            (lwtf-prediction-nexts after-d)
                            LWTFW-CELL-E) 0)) 65536 0)
            (if (and (eq (lwtf-integrated-current?
                            foreign-world candidate-f) 1)
                     (and (eq (oac-one?
                                (lwtf-prediction-ack after-foreign)) 1)
                          (node_eq (oac-payload
                                (lwtf-prediction-ack after-foreign))
                                LWTFW-CELL-F))) 131072 0)))))
