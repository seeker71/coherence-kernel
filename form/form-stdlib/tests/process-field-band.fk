; process-field-band.fk — the host process field reads exactly: rows parse,
; kinds classify, zombies name the parent that owes the reap, hogs are held in
; integer tenths, wait edges point from a sleeping waiter to its live child,
; and the presence noticeboard round-trips, splits, and separates ghost from
; live from unannounced.
;
; Verdict 1023 (10 bits):
;   1    a row parses exactly: pid, ppid, stat, cpu tenths, comm, args intact
;   2    kinds: fkwu / shell / python / other (a parenthesized zombie comm is
;        not the fkwu kind — the stat, not the name, carries its death)
;   4    exactly one zombie, and the reap is owed by its parent by name
;   8    hogs are exactly the rows at or over the floor, in tenths
;   16   wait edges: sleeping shell parents wait on their live children;
;        a zombie child is never waited on
;   32   a presence frame round-trips every field it was built from
;   64   concatenated presence files split; a dead pid is a ghost, a live
;        pid is a live presence
;   128  a live fkwu with no presence is unannounced; an announced one is not
;   256  the census counts (fkwu shells pythons zombies hogs) exactly
;   512  tenths: "99.5"->995, "3"->30, "0.0"->0, "26.0"->260
;
; preludes: form-stdlib/core.fk form-stdlib/process-field.fk

(do
    (defn pfb-bit (ok weight) (if ok weight 0))
    (defn pfb-field ()
        (str_concat "1|0|Ss|0.0|/sbin/launchd|\n"
        (str_concat "70|1|S|1.5|/bin/zsh|\n"
        (str_concat "71|70|S+|0.0|/bin/zsh|\n"
        (str_concat "72|71|R+|99.5|./fkwu|./fkwu observe/preflight-run.fk\n"
        (str_concat "73|71|Z|0.0|(fkwu)|\n"
        (str_concat "80|1|S|26.0|/usr/bin/python3|\n"
                    "90|1|U|3|/usr/local/bin/weird|\n")))))))

    (defn process-field-band ()
        (do
            (let rows (fpf-rows (pfb-field)))
            (let r72 (fpf-find-pid rows 72))

            (let c0 (pfb-bit
                (and (eq (fpf-row-pid r72) 72)
                (and (eq (fpf-row-ppid r72) 71)
                (and (str_eq (fpf-row-stat r72) "R+")
                (and (eq (fpf-row-cpu r72) 995)
                (and (str_eq (fpf-row-comm r72) "./fkwu")
                     (str_eq (fpf-row-args r72)
                         "./fkwu observe/preflight-run.fk")))))) 1))

            (let c1 (pfb-bit
                (and (str_eq (fpf-kind "./fkwu") "fkwu")
                (and (str_eq (fpf-kind "/bin/zsh") "shell")
                (and (str_eq (fpf-kind "/usr/bin/python3") "python")
                (and (str_eq (fpf-kind "/sbin/launchd") "other")
                     (str_eq (fpf-kind "(fkwu)") "other"))))) 2))

            (let owed (fpf-reap-owed rows))
            (let c2 (pfb-bit
                (and (eq (len owed) 1)
                (and (eq (nth (head owed) 0) 73)
                (and (str_eq (nth (head owed) 1) "(fkwu)")
                (and (eq (nth (head owed) 2) 71)
                     (str_eq (nth (head owed) 3) "/bin/zsh"))))) 4))

            (let hogs (fpf-hogs rows))
            (let c3 (pfb-bit
                (and (eq (len hogs) 2)
                (and (eq (fpf-row-pid (nth hogs 0)) 72)
                     (eq (fpf-row-pid (nth hogs 1)) 80))) 8))

            (let edges (fpf-wait-edges rows))
            (let c4 (pfb-bit
                (and (eq (len edges) 2)
                (and (eq (nth (nth edges 0) 0) 70)
                (and (eq (nth (nth edges 0) 2) 71)
                (and (eq (nth (nth edges 1) 0) 71)
                (and (str_eq (nth (nth edges 1) 1) "/bin/zsh")
                (and (eq (nth (nth edges 1) 2) 72)
                (and (str_eq (nth (nth edges 1) 3) "./fkwu")
                     (str_eq (nth (nth edges 1) 4) "R+")))))))) 16))

            (let frame (fpf-presence-frame "4242" "cell-servant"
                "/tmp/form-field/a.task" "/tmp/form-field/a.reply"
                "/tmp/form-field/a.bell" "/w" 123))
            (let c5 (pfb-bit
                (and (eq (fpf-presence-pid frame) 4242)
                (and (str_eq (fpf-presence-field frame "role") "cell-servant")
                (and (str_eq (fpf-presence-field frame "task")
                        "/tmp/form-field/a.task")
                (and (str_eq (fpf-presence-field frame "reply")
                        "/tmp/form-field/a.reply")
                (and (str_eq (fpf-presence-field frame "bell")
                        "/tmp/form-field/a.bell")
                (and (str_eq (fpf-presence-field frame "worktree") "/w")
                     (str_eq (fpf-presence-field frame "started-ms")
                        "123"))))))) 32))

            (let announced (fpf-presence-frame "72" "cell-servant"
                "/tmp/form-field/b.task" "/tmp/form-field/b.reply"
                "/tmp/form-field/b.bell" "/w" 124))
            (let frames (fpf-presences (str_concat frame announced)))
            (let ghosts (fpf-ghosts frames rows))
            (let live (fpf-live-presences frames rows))
            (let c6 (pfb-bit
                (and (eq (len frames) 2)
                (and (eq (len ghosts) 1)
                (and (eq (fpf-presence-pid (head ghosts)) 4242)
                (and (eq (len live) 1)
                     (eq (fpf-presence-pid (head live)) 72))))) 64))

            (let ghost-only (fpf-presences frame))
            (let c7 (pfb-bit
                (and (eq (len (fpf-unannounced rows frames 0)) 0)
                (and (eq (len (fpf-unannounced rows ghost-only 0)) 1)
                (and (eq (head (fpf-unannounced rows ghost-only 0)) 72)
                     (eq (len (fpf-unannounced rows ghost-only 72)) 0)))) 128))

            (let counts (fpf-census rows))
            (let c8 (pfb-bit
                (and (eq (nth counts 0) 1)
                (and (eq (nth counts 1) 2)
                (and (eq (nth counts 2) 1)
                (and (eq (nth counts 3) 1)
                     (eq (nth counts 4) 2))))) 256))

            (let c9 (pfb-bit
                (and (eq (fpf-tenths "99.5") 995)
                (and (eq (fpf-tenths "3") 30)
                (and (eq (fpf-tenths "0.0") 0)
                     (eq (fpf-tenths "26.0") 260)))) 512))

            (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9))))

    (process-field-band))
