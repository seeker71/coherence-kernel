; A real child fails before model admission. The supervisor retains rc=1,
; both output channels, and releases its launch lock. No training data is touched.
; preludes: form-stdlib/native-lora-worker.bml
(do
 (let dir (str_concat "/tmp/native-worker-failure-" (int_to_str (host_pid))))
 (let request (ntr-request "absent" "absent" "absent" (str_concat dir "/adapter") 0 2 0.0001 1 8))
 (let result (nlw-run request dir))
 (let err (read_file (str_concat dir "/train.err")))
 (let actual (str_to_int (trim (read_file (str_concat dir "/train.rc")))))
 (let okay (and (eq actual 1) (and (eq (nth result 1) 1) (and (not (nlw-running dir)) (ge (str_find err "native training request values refused" 0) 0)))))
 (print (list "supervised-result" result "worker-exit" actual "diagnostic-retained" okay))
 (fs-remove-tree dir)
 (if okay 7 (form_error "native worker failure lost its evidence")))
