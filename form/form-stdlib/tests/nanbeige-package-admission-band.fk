; preludes: form-stdlib/core.fk form-stdlib/nanbeige-package-admission.fk
; Verdict 15: exact package admits; every material identity class fails closed.
(do
    (let ok (nbpa-admit? (nbpa-revision)
        (nbpa-shard1-size) (nbpa-shard1-sha)
        (nbpa-shard2-size) (nbpa-shard2-sha)
        (nbpa-config-sha) (nbpa-tokenizer-sha) (nbpa-index-sha)))
    (let bad1 (nbpa-admit? (nbpa-revision)
        (sub (nbpa-shard1-size) 1) (nbpa-shard1-sha)
        (nbpa-shard2-size) (nbpa-shard2-sha)
        (nbpa-config-sha) (nbpa-tokenizer-sha) (nbpa-index-sha)))
    (let bad2 (nbpa-admit? (nbpa-revision)
        (nbpa-shard1-size) (nbpa-shard1-sha)
        (nbpa-shard2-size) "drift"
        (nbpa-config-sha) (nbpa-tokenizer-sha) (nbpa-index-sha)))
    (let bad3 (nbpa-admit? "drift"
        (nbpa-shard1-size) (nbpa-shard1-sha)
        (nbpa-shard2-size) (nbpa-shard2-sha)
        (nbpa-config-sha) (nbpa-tokenizer-sha) (nbpa-index-sha)))
    (add (if (eq ok 1) 1 0)
         (add (if (eq bad1 0) 2 0)
              (add (if (eq bad2 0) 4 0)
                   (if (eq bad3 0) 8 0)))))
