(defn lwrrpab-bit (ok bit) (if ok bit 0))

(defn lwrrpab-run ()
    (do
        (let result (lwrrpaw-run))
        (let children (node_children result))
        (let parent (nth children 1))
        (let relation (nth children 2))
        (let relations (nth children 3))
        (let query (nth children 4))
        (let one-world (nth children 5))
        (let one-answer (nth children 6))
        (let two-world (nth children 7))
        (let pending-answer (nth children 8))
        (let expired-answer (nth children 9))
        (let proposal (nth children 10))
        (let candidate (lwt-proposal-candidate proposal))
        (let waiting (nth children 11))
        (let admitted (nth children 12))
        (let admitted-world (lwt-round-world admitted))
        (let withdrawn-world (nth children 13))
        (let released-world (nth children 14))
        (let events (nth children 24))
        (let recipe
            (lwrrn-trial-recipe
                (lwrro-choice-trial (lwo-emergent-shape relation))))
        (sum (list
            (lwrrpab-bit (eq (lwrrpa-query-valid? query) 1) 1)
            (lwrrpab-bit
                (and (eq (len (node_children query)) 9)
                     (node_eq query
                        (lwrrpa-query parent relations
                            (lwrrpa-query-bindings query)
                            (lwrrpa-query-alternatives query)
                            (lwrrpa-query-unknown query)
                            (lwrrpa-query-declaration query)
                            (lwrrpa-query-timeout query)
                            (lwrrpa-query-evidence query)))) 2)
            (lwrrpab-bit
                (and (eq (lwo-field-size relations) 1)
                     (node_eq relation (head (lwo-field-items relations)))) 4)
            (lwrrpab-bit
                (eq (len (lwre-binding-items
                        (lwrrpa-query-bindings query))) 2) 8)
            (lwrrpab-bit
                (eq (lwph-active-source-count one-world query) 1) 16)
            (lwrrpab-bit (node_eq one-answer (lwo-none)) 32)
            (lwrrpab-bit
                (eq (lwph-active-source-count two-world query) 2) 64)
            (lwrrpab-bit (eq (node_value (nth children 15)) 1) 128)
            (lwrrpab-bit (eq (lwrrpa-answer? pending-answer) 1) 256)
            (lwrrpab-bit
                (eq (lwo-field-size
                        (lwrrpa-answer-derivations pending-answer)) 1) 512)
            (lwrrpab-bit
                (eq (lwo-field-size
                        (lwrrpa-answer-outputs pending-answer)) 1) 1024)
            (lwrrpab-bit
                (eq (oac-one? (lwrrpa-answer-immediate pending-answer)) 1)
                2048)
            (lwrrpab-bit
                (eq (oac-time-pending? (lwrrpa-answer-time pending-answer)) 1)
                4096)
            (lwrrpab-bit
                (node_eq (lwrrpa-answer-immediate pending-answer)
                    (lwrrpa-answer-immediate expired-answer)) 8192)
            (lwrrpab-bit
                (eq (oac-time-outcome? (lwrrpa-answer-time expired-answer)) 1)
                16384)
            (lwrrpab-bit
                (eq (oac-alternative-ack?
                        (oac-time-outcome-ack
                            (lwrrpa-answer-time expired-answer))) 1) 32768)
            (lwrrpab-bit
                (node_eq (lwrrpa-answer-alternatives pending-answer)
                    (lwrrpa-query-alternatives query)) 65536)
            (lwrrpab-bit
                (node_eq (lwrrpa-answer-unknown pending-answer)
                    (lwrrpa-query-unknown query)) 131072)
            (lwrrpab-bit
                (node_eq (lwrrpa-answer-declaration pending-answer)
                    (lwrrpa-query-declaration query)) 262144)
            (lwrrpab-bit (eq (node_value (nth children 16)) 1) 524288)
            (lwrrpab-bit
                (eq (lwo-field-size
                        (lwt-proposal-participants proposal)) 30) 1048576)
            (lwrrpab-bit
                (eq (lwo-active? (lwt-round-world waiting) candidate) 0)
                2097152)
            (lwrrpab-bit
                (eq (lwo-active? admitted-world candidate) 1) 4194304)
            (lwrrpab-bit (eq (node_value (nth children 17)) 1) 8388608)
            (lwrrpab-bit
                (and (eq (node_value (nth children 18)) 0)
                     (eq (lwo-active? admitted-world recipe) 0)) 16777216)
            (lwrrpab-bit
                (eq (lwo-active? admitted-world relation) 1) 33554432)
            (lwrrpab-bit
                (and (eq (node_value (nth children 19)) 0)
                     (eq (lwo-active? withdrawn-world candidate) 1)) 67108864)
            (lwrrpab-bit
                (eq (node_value (nth children 20)) 1) 134217728)
            (lwrrpab-bit
                (and (eq (node_value (nth children 21)) 0)
                     (eq (lwo-active? released-world candidate) 0)) 268435456)
            (lwrrpab-bit
                (and (eq (node_value (nth children 22)) 1)
                     (eq (node_value (nth children 23)) 1)) 536870912)
            (lwrrpab-bit
                (and (eq (len events) 25)
                     (and (node_eq
                            (lwrrpa-answer-query pending-answer) query)
                          (node_eq
                            (lwrrpa-derivation-basis
                                (head (lwo-field-items
                                    (lwrrpa-answer-derivations
                                        pending-answer)))) relation)))
                1073741824)))))

