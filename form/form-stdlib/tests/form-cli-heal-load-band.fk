; Expected 15. Loads the executor without invoking effects.
; preludes: form-stdlib/bml/form-cli-heal.bml
(add (if (ge (str_find (fh-command "help") "heal" 0) 0) 1 0)
    (add (if (str_eq (fh-symbol "[unresolved-call] 'lost' at line 2") "lost") 2 0)
         (add (if (str_eq (fhr-model (fhr-plan (list "qwen\t/path\tanswer review\tartifact=1 seal=1 tokfast=1 native=1")) "qwen") "qwen") 4 0)
              (if (and (str_eq (fh-command "x|y|7|30|loacl") "heal refused: unknown mode; omit mode or use local")
                       (str_eq (fh-command "x|y|7|30junk|local") "heal refused: seconds must be a canonical integer")) 8 0))))
