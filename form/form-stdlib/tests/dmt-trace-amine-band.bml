; tests/dmt-trace-amine-band.bml — DMT as its own honest category, three-way.
;
; preludes: form-stdlib/core.fk form-stdlib/energy-center-glands.bml form-stdlib/dmt-trace-amine.bml
;
; Proves: DMT does NOT pollute the seven-center table (ecg-centers still 7, no
; "dmt" id there); the cell carries its genes (INMT, DDC) and is enzyme-made,
; not a peptide; the lane law holds AND DMT sits at the corpus floor (its belief
; lane is below every center's belief lane); the contested flag is raised (even
; the evidence lane names its own live debate); the measured line speaks the
; cross-tissue synthesis while the belief line carries the fact-vs-myth frame.
;
; Band verdict: 511 when every law holds.

section [form.bml] {
    def dtb-bool(b, weight) = if b then weight else 0;

    // DMT's belief lane below every center's belief lane (corpus floor)
    def dtb-below-all-loop(cs, v) = if nil?(cs) then true else if (v < ecg-belief(head(cs))) then dtb-below-all-loop(tail(cs), v) else false;

    // "dmt" must NOT be one of the seven center ids
    def dtb-not-in-centers-loop(ids) = if nil?(ids) then true else if ((String) head(ids) == "dmt") then false else dtb-not-in-centers-loop(tail(ids));

    def dtb-score() {
        let d = dmt-cell();
        sum(list(
            dtb-bool(((Comparable) len(ecg-centers()) == 7), 1),
            dtb-bool(dtb-not-in-centers-loop(ecg-centers()), 2),
            dtb-bool((!ecg-known?(ecg-find("dmt"))), 4),
            dtb-bool(((len(ecg-genes(d)) > 0) && (str_find(ecg-protein-link(d), "contested", 0) >= 0)), 8),
            dtb-bool((!ecg-peptide?(d)), 16),
            dtb-bool((ecg-belief(d) < ecg-evidence(d)), 32),
            dtb-bool(dtb-below-all-loop(ecg-table(), ecg-belief(d)), 64),
            dtb-bool((dmt-contested?() && (!dmt-essential-enzyme-settled?())), 128),
            dtb-bool((str_find(dmt-spoken(), "synthesised across tissues", 0) >= 0), 256)));
    }

    dtb-score();
}
