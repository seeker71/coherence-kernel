; model-registry-band.fk — the registry answers purely: rows found by
; name, models chosen by role, lanes and wiredness from the one table,
; the unknown always typed, never silent.
; Expected: 511
; preludes: form-stdlib/model-registry.bml
(do
    (defn mrb-bit (ok bit) (if ok bit 0))
    (sum (list
        (mrb-bit (ge (str_find (mr-path (mr-find "qwen38-q4")) "Q4_K_M" 0) 0) 1)
        (mrb-bit (str_eq (mr-name (mr-find "no-such-model")) "") 2)
        (mrb-bit (str_eq (mr-name (mr-for-role "input")) "form-llama-q4") 4)
        (mrb-bit (str_eq (mr-name (mr-for-role "answer")) "qwen38-q8") 8)
        (mrb-bit (and (str_eq (mr-lane-for "qwen35") "q38") (eq (mr-wired? "qwen35") 1)) 16)
        (mrb-bit (and (str_eq (mr-lane-for "llama") "dth") (eq (mr-wired? "llama") 0)) 32)
        (mrb-bit (and (str_eq (mr-lane-for "never-seen") "unknown") (eq (mr-wired? "never-seen") 0)) 64)
        (mrb-bit (and (eq (mr-file? "form/form-stdlib/core.fk") 1) (eq (mr-file? "no/such/file.gguf") 0)) 128)
        (mrb-bit (ge (str_find (mr-readiness (mr-row "x" "no/such/file" "r")) "artifact=0 seal=0 tokfast=0 crystal=0" 0) 0) 256))))
