; model-registry-band.fk — the registry answers purely: rows found by
; name, models chosen by role, lanes and wiredness from the one table,
; the unknown always typed, never silent.
; Expected: 131071
; preludes: form-stdlib/model-registry.bml
(do
    (defn mrb-bit (ok bit) (if ok bit 0))
    (sum (list
        (mrb-bit (ge (str_find (mr-path (mr-find "qwen38-q4")) "Q4_K_M" 0) 0) 1)
        (mrb-bit (str_eq (mr-name (mr-find "no-such-model")) "") 2)
        (mrb-bit (str_eq (mr-name (mr-for-role "input")) "form-llama-q4") 4)
        (mrb-bit (str_eq (mr-name (mr-for-role "answer")) "qwen38-q8") 8)
        (mrb-bit (and (str_eq (mr-lane-for "qwen35") "q38") (eq (mr-wired? "qwen35") 1)) 16)
        (mrb-bit (and (str_eq (mr-lane-for "llama") "dth") (eq (mr-wired? "llama") 0)) 32)
        (mrb-bit (and (str_eq (mr-lane-for "never-seen") "unknown") (eq (mr-wired? "never-seen") 0)) 64)
        (mrb-bit (and (eq (mr-file? "form/form-stdlib/core.fk") 1) (eq (mr-file? "no/such/file.gguf") 0)) 128)
        (mrb-bit (ge (str_find (mr-readiness (mr-row "x" "no/such/file" "r")) "artifact=0 seal=0 tokfast=0 crystal=0" 0) 0) 256)
        (mrb-bit (and (ge (str_find (mr-path (mr-find "qwen38-flash-next-q2")) "UD-Q2_K_XL-00001-of-00003.gguf" 0) 0)
                      (str_eq (str_concat (mr-shard-prefix (mr-find "qwen38-flash-next-q2")) (mr-shard-name 3 3)) (str_concat (mr-flash-next-prefix) "00003-of-00003.gguf"))) 512)
        (mrb-bit (str_eq (mr-name (mr-for-role "speech-stt")) "whisper-large-v3-turbo") 1024)
        (mrb-bit (ge (str_find (mr-path (mr-find "ds4flash")) "ds4/ds4flash-v5mx-reap25" 0) 0) 2048)
        (mrb-bit (and (ge (str_find (mr-path (mr-find "llama32-3b")) "sha256-dde5aa3f" 0) 0)
                      (ge (str_find (mr-path (mr-find "llama32-1b")) "sha256-74701a8c" 0) 0)) 4096)
        (mrb-bit (ge (str_find (mr-path (mr-find "llama32-3b-mlx-4bit")) "Llama-3.2-3B-Instruct-4bit/snapshots/" 0) 0) 8192)
        (mrb-bit (and (and (str_eq (mr-lane-for "qwen4exp") "q4t") (eq (mr-wired? "qwen4exp") 0))
                      (and (str_eq (mr-lane-for "deepseek4") "ds4-query") (eq (mr-wired? "deepseek4") 0))) 16384)
        (mrb-bit (str_eq (mr-path (mr-find "whisper-tiny-fixture")) "model/fixtures/whisper-tiny") 32768)
        (mrb-bit (and (eq (len (mr-registry)) 11) (str_eq (mr-name (mr-for-role "train-base")) "llama32-3b-mlx-4bit")) 65536))))
