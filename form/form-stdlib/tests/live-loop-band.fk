; preludes: form-stdlib/core.fk form-stdlib/trig.fk form-stdlib/voice-formant.fk form-stdlib/voiced-reading.fk form-stdlib/voice-osc.fk form-stdlib/voice-render.fk form-stdlib/word-speak.fk form-stdlib/word-hear.fk form-stdlib/pause-reading-file.fk form-stdlib/speak-compose.fk form-stdlib/live-loop.fk
;
; live-loop-band — the live loop's PURE turn logic, proven four-way. The loop itself is an fkwu
; lane organ (file polling, wall clock, a growing stream); what crosses all four arms is every
; decision it makes per frame, on fixtures the real room and the real air test taught.
;
; Verdict 255 when every claim lands:
;   1    the ROOM does not speak: a frame at the mic's measured room level (mean |amp| 82, the
;        median of a real 7 s capture at Hati Suci) is not speech — this fixture fired seven false
;        turns before the energy floor was taught by it
;   2    a voiced frame at speech gain IS speech, and so is the aperiodic fricative — the ear the
;        first live run was deaf to (/s/ has no pitch; the body's own name opens with it)
;   4    a blip is not an utterance: 719 collected samples cannot close a turn, 720 can
;   8    the KNOWN-WORD endpoint: the body's name closes on ONE quiet frame — the recognizer ends
;        the turn, not the pause. This is unmute's deepest teaching, four-way at vocabulary 1.
;   16   an unknown utterance does NOT close on one quiet frame…
;   32   …and DOES close on the pause floor (5 frames): the honest fallback for open speech
;   64   the recognized answer carries the name; the miss answer is speak-compose's honest miss —
;        both pinned by exact length (65 and 64), neither ever empty
;   128  the reply utterance is real material: 5200 samples (0.65 s) through the oscillator mouth
(do
    (defn llb-rep (v n) (if (le n 0) (list) (cons v (llb-rep v (sub n 1)))))
    (defn llb-scale (xs k) (if (nil? xs) (list) (cons (round (mul (head xs) k)) (llb-scale (tail xs) k))))

    (let quietroom (llb-rep 82 240))
    (let voiced-i (llb-scale (vo-e 240) 24000))
    (let fric-i (llb-scale (ws-fric 240) 24000))
    (let sema-i (llb-scale (ws-sema) 24000))

    (let c0 (if (eq (ll-speech? quietroom) 0) 1 0))
    (let c1 (if (eq (ll-speech? voiced-i) 1) (if (eq (ll-speech? fric-i) 1) 2 0) 0))
    (let c2 (if (eq (ll-turn-over? (llb-rep 100 719) 5) 0)
               (if (eq (ll-turn-over? (llb-rep 100 720) 5) 1) 4 0) 0))
    (let c3 (if (eq (ll-turn-over? sema-i 1) 1) 8 0))
    (let c4 (if (eq (ll-turn-over? (llb-rep 3000 960) 1) 0) 16 0))
    (let c5 (if (eq (ll-turn-over? (llb-rep 3000 960) 5) 1) 32 0))
    (let c6 (if (eq (str_len (ll-answer-text 1)) 65)
               (if (eq (str_len (ll-answer-text 0)) 64) 64 0) 0))
    (let c7 (if (eq (len (ll-reply-samples)) 5200) 128 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
