; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-cli-learning-lineage.fk
;
; Verdict 8191: actual attribution stays honest and the fixed-suite inward
; promotion contract requires held-out local transfer and native-band transfer.
; witnessed: 2026-08-17 -> 8191 on fkwu, exit 0

(defn fcllb (truth bit) (if truth bit 0))

(do
    (let actual (fcll-actual-round))
    (let before (fcll-o-share (fcll-before actual)))
    (let after (fcll-o-share (fcll-after actual)))
    (let delta (fcll-share-delta actual))
    (let local-round (fcll-fixture-local-round))
    (let native-round (fcll-fixture-native-round))
    (let local-after (fcll-o-share (fcll-after local-round)))
    (let native-after (fcll-o-share (fcll-after native-round)))
    (sum (list
        (fcllb (and (eq (nth before 0) 16)
            (and (eq (nth before 1) 35) (eq (nth before 2) 49))) 1)
        (fcllb (and (eq (nth after 0) 12)
            (and (eq (nth after 1) 40) (eq (nth after 2) 48))) 2)
        (fcllb (and (eq (nth delta 0) -4)
            (and (eq (nth delta 1) 5) (eq (nth delta 2) -1))) 4)
        (fcllb (eq (fcll-home-delta actual) 1) 8)
        (fcllb (eq (fcll-operational-comparable? actual) 0) 16)
        (fcllb (and (str_eq (fcll-teacher actual) "user")
            (and (eq (fcll-remote-carried? actual) 1)
                 (eq (fcll-remote-model-teacher? actual) 0))) 32)
        (fcllb (and (str_eq (fcll-fine-tune actual) "none")
            (eq (fcll-changes-grounded? actual) 1)) 64)
        (fcllb (and (eq (nth local-after 0) 0)
            (and (eq (nth local-after 1) 63) (eq (nth local-after 2) 37))) 128)
        (fcllb (and (eq (nth native-after 0) 63)
            (and (eq (nth native-after 1) 37) (eq (nth native-after 2) 0))) 256)
        (fcllb (eq (fcll-chain-valid? (list local-round native-round)) 1) 512)
        (fcllb (eq (fcll-finetune-promoted? local-round) 1) 1024)
        (fcllb (eq (fcll-native-promoted? native-round) 1) 2048)
        (fcllb (and (eq (fcll-both-rise? local-round) 0)
            (eq (fcll-both-rise? native-round) 0)) 4096))))
