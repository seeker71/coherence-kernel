; check-refusal-counts-band.bml — rung 0's refusal counts the checks it rehearsed (form-cli-check-witness.bml, fccw-refusal).
;
; Rung 0 opens no model, so its refusal's turns, tool_calls and check_runs read 0; it still rehearsed one native call per
; caller check, and its counters say so: rehearsed_checks is the number of records it rehearsed.
;
; Expected: 7
; Verdict 7 when every claim lands:
;   1   a refusal over two rehearsed checks reads rehearsed_checks 2
;   2   a refusal over one rehearsed check reads rehearsed_checks 1
;   4   the refusal still claims no model work: turns 0, generated_ids 0, reason caller-check-unmeetable
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/bml/form-cli-check-witness.bml
section [form.bml] {
 class CheckRefusalCountsBand {
  def crc-obj() = parse-json("request", "{\"mode\":\"code\",\"checks\":[],\"writable\":[\"a.txt\"]}");
  def crc-row() = parse-json("row", "{\"tool\":\"rg\",\"arguments\":[\"-c\",\"alpha\",\"a.txt\"],\"stdout\":\"1\\n\"}");
  def crc-record(verdict) = [verdict, "fixed", crc-row(), "1\n", "0\n", 0, 0, "", 0];
  def crc-refusal(records) = fccw-refusal(crc-obj(), [["a.txt", "a.txt", "beta\n"]], records);
  def crc-c-two(ctx) = fhn-count(crc-refusal([crc-record("unmeetable"), crc-record("holds")]), "rehearsed_checks") == 2;
  def crc-c-one(ctx) = fhn-count(crc-refusal([crc-record("unmeetable")]), "rehearsed_checks") == 1;
  def crc-c-still(ctx) {
   let r = crc-refusal([crc-record("unmeetable")]);
   fhn-count(r, "turns") == 0 && fhn-count(r, "generated_ids") == 0 && (String) fhn-text(r, "reason") == "caller-check-unmeetable";
  }
 }
 live-claims("check-refusal-counts-band", 0, [["two", 1, 1, crc-c-two], ["one", 2, 1, crc-c-one], ["still", 4, 1, crc-c-still]]);
}
