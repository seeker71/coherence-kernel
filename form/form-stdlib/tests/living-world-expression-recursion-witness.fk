; --- a distinct immediate silence leaves two focuses, no default -----

(defn lwxrw-silence-reflection ()
    (lwxr-reflection (lwxrw-deep-application-candidate)
        (lwo-none) (oac-nothing) (lwo-none) (lwo-empty-field)
        (lwo-none) (lwo-none) (lwo-none) (lwxbw-evidence)))
