(let LWXRW-SOURCE-M (bp "LWXRW-SOURCE-M"))
(let LWXRW-SOURCE-N (bp "LWXRW-SOURCE-N"))
(let LWXRW-SOURCE-O (bp "LWXRW-SOURCE-O"))
(let LWXRW-SOURCE-P (bp "LWXRW-SOURCE-P"))
(let LWXRW-SOURCE-Q (bp "LWXRW-SOURCE-Q"))
(let LWXRW-SOURCE-R (bp "LWXRW-SOURCE-R"))
(let LWXRW-PROV-M   (bp "LWXRW-PROV-M"))
(let LWXRW-PROV-N   (bp "LWXRW-PROV-N"))
(let LWXRW-PROV-O   (bp "LWXRW-PROV-O"))
(let LWXRW-PROV-P   (bp "LWXRW-PROV-P"))
(let LWXRW-PROV-Q   (bp "LWXRW-PROV-Q"))
(let LWXRW-PROV-R   (bp "LWXRW-PROV-R"))
(let LWXRW-REASON   (bp "LWXRW-REASON"))

(defn lwxrw-source-m () (lwxbw-cell LWXRW-SOURCE-M))
(defn lwxrw-source-n () (lwxbw-cell LWXRW-SOURCE-N))
(defn lwxrw-source-o () (lwxbw-cell LWXRW-SOURCE-O))
(defn lwxrw-source-p () (lwxbw-cell LWXRW-SOURCE-P))
(defn lwxrw-source-q () (lwxbw-cell LWXRW-SOURCE-Q))
(defn lwxrw-source-r () (lwxbw-cell LWXRW-SOURCE-R))
(defn lwxrw-prov-m () (lwxbw-cell LWXRW-PROV-M))
(defn lwxrw-prov-n () (lwxbw-cell LWXRW-PROV-N))
(defn lwxrw-prov-o () (lwxbw-cell LWXRW-PROV-O))
(defn lwxrw-prov-p () (lwxbw-cell LWXRW-PROV-P))
(defn lwxrw-prov-q () (lwxbw-cell LWXRW-PROV-Q))
(defn lwxrw-prov-r () (lwxbw-cell LWXRW-PROV-R))
(defn lwxrw-reason () (lwxbw-cell LWXRW-REASON))

; --- a second held-out application of the already admitted chain -----

(defn lwxrw-material-two ()
    (lwxb-material
        (list (lwxbw-primary) (lwxbw-right) (lwxbw-left))))
(defn lwxrw-material-two-world-build ()
    (lwt-receive-stream (lwxcbw-application-world)
        (list (lwxbw-entry (lwxrw-source-m) (lwxrw-prov-m)
            (lwxrw-material-two)))))
(let LWXRW-MATERIAL-TWO-WORLD-VALUE
    (lwxrw-material-two-world-build))
(defn lwxrw-material-two-world () LWXRW-MATERIAL-TWO-WORLD-VALUE)

(let LWXRW-APPLICATION-TWO-PROPOSAL-VALUE
    (lwxc-application-proposal (lwxrw-material-two-world)
        (lwxcbw-chain-candidate-c) (lwxrw-material-two)))
(defn lwxrw-application-two-proposal ()
    LWXRW-APPLICATION-TWO-PROPOSAL-VALUE)
(defn lwxrw-application-two-candidate ()
    (lwt-proposal-candidate (lwxrw-application-two-proposal)))
(defn lwxrw-application-two-round-build ()
    (lwt-round (lwxrw-material-two-world)
        (lwo-field (list (lwxrw-application-two-proposal)))
        (lwo-empty-field) (lwxcbw-application-integrated-round)))
(defn lwxrw-application-two-yes-round-build ()
    (do
        (let proposal (lwxrw-application-two-proposal))
        (lwt-round-receive (lwxrw-application-two-round-build)
            (lwxbw-responses proposal
                (oac-one (lwt-proposal-candidate proposal))))))
(defn lwxrw-application-two-integrated-round-build ()
    (lwxc-integrate-application
        (lwxrw-application-two-yes-round-build)
        (lwxrw-application-two-proposal) (lwxbw-action)))
(let LWXRW-APPLICATION-TWO-ROUND-VALUE
    (lwxrw-application-two-integrated-round-build))
(defn lwxrw-application-two-integrated-round ()
    LWXRW-APPLICATION-TWO-ROUND-VALUE)
(defn lwxrw-application-two-world ()
    (lwt-round-world (lwxrw-application-two-integrated-round)))

(defn lwxrw-application-output (candidate)
    (lwxc-derivation-output
        (lwxc-application-derivation
            (lwo-emergent-shape candidate))))

; --- two observations cross a reflection membrane -------------------

(defn lwxrw-confirmation-one ()
    (do
        (let output
            (lwxrw-application-output
                (lwxcbw-application-candidate-c)))
        (lwxr-reflection (lwxcbw-application-candidate-c)
            output (oac-one output) (lwo-none) (lwo-empty-field)
            (lwo-none) (lwo-none) (lwo-none) (lwxbw-evidence))))
(defn lwxrw-confirmation-two ()
    (do
        (let output
            (lwxrw-application-output
                (lwxrw-application-two-candidate)))
        (lwxr-reflection (lwxrw-application-two-candidate)
            output (oac-one output) (lwo-none) (lwo-empty-field)
            (lwo-none) (lwo-none) (lwo-none) (lwxbw-evidence))))

(defn lwxrw-reflection-offer-world-build ()
    (lwt-receive-stream (lwxrw-application-two-world)
        (list
            (lwxbw-entry (lwxrw-source-n) (lwxrw-prov-n)
                (lwxrw-confirmation-one))
            (lwxbw-entry (lwxrw-source-o) (lwxrw-prov-o)
                (lwxrw-confirmation-two)))))
(let LWXRW-REFLECTION-OFFER-WORLD-VALUE
    (lwxrw-reflection-offer-world-build))
(defn lwxrw-reflection-offer-world ()
    LWXRW-REFLECTION-OFFER-WORLD-VALUE)

(let LWXRW-REFLECTION-PROPOSAL-ONE-VALUE
    (lwxr-reflection-proposal
        (lwxrw-reflection-offer-world) (lwxrw-confirmation-one)))
(let LWXRW-REFLECTION-PROPOSAL-TWO-VALUE
    (lwxr-reflection-proposal
        (lwxrw-reflection-offer-world) (lwxrw-confirmation-two)))
(defn lwxrw-reflection-proposal-one ()
    LWXRW-REFLECTION-PROPOSAL-ONE-VALUE)
(defn lwxrw-reflection-proposal-two ()
    LWXRW-REFLECTION-PROPOSAL-TWO-VALUE)
(defn lwxrw-reflection-candidate-one ()
    (lwt-proposal-candidate (lwxrw-reflection-proposal-one)))
(defn lwxrw-reflection-candidate-two ()
    (lwt-proposal-candidate (lwxrw-reflection-proposal-two)))

(defn lwxrw-reflection-round-build ()
    (lwt-round (lwxrw-reflection-offer-world)
        (lwo-field
            (list (lwxrw-reflection-proposal-one)
                  (lwxrw-reflection-proposal-two)))
        (lwo-empty-field) (lwxrw-application-two-integrated-round)))
(defn lwxrw-reflection-yes-round-build ()
    (do
        (let first (lwxrw-reflection-proposal-one))
        (let second (lwxrw-reflection-proposal-two))
        (lwt-round-receive (lwxrw-reflection-round-build)
            (append
                (lwxbw-responses first
                    (oac-one (lwt-proposal-candidate first)))
                (lwxbw-responses second
                    (oac-one (lwt-proposal-candidate second)))))))
(defn lwxrw-reflection-integrated-round-build ()
    (do
        (let round (lwxrw-reflection-yes-round-build))
        (let first
            (lwxr-integrate-reflection round
                (lwxrw-reflection-proposal-one) (lwxbw-action)))
        (lwxr-integrate-reflection first
            (lwxrw-reflection-proposal-two) (lwxbw-action))))
(let LWXRW-REFLECTION-ROUND-VALUE
    (lwxrw-reflection-integrated-round-build))
(defn lwxrw-reflection-integrated-round ()
    LWXRW-REFLECTION-ROUND-VALUE)
(defn lwxrw-reflection-world ()
    (lwt-round-world (lwxrw-reflection-integrated-round)))

; --- each observation separately asks to become recurrence evidence --

(let LWXRW-CORRESPONDENCE-PROPOSAL-ONE-VALUE
    (lwxr-correspondence-proposal (lwxrw-reflection-world)
        (lwxrw-reflection-candidate-one)))
(let LWXRW-CORRESPONDENCE-PROPOSAL-TWO-VALUE
    (lwxr-correspondence-proposal (lwxrw-reflection-world)
        (lwxrw-reflection-candidate-two)))
