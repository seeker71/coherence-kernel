(defn lwxrw-manual-deep-output ()
    (do
        (let bridge
            (lwr-apply-mapping
                (lwo-emergent-shape
                    (lwxrw-composite-mapping-candidate))
                (lwxrw-material-three)))
        (lwr-apply-mapping
            (lwo-emergent-shape (lwxcbw-sequence-candidate-c)) bridge)))

