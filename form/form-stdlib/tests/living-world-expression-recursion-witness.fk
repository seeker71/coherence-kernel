    (lwt-integrate (lwxrw-composite-mapping-yes-round-build)
        (lwxrw-composite-mapping-proposal) (lwxbw-action)))
(let LWXRW-COMPOSITE-MAPPING-ROUND-VALUE
    (lwxrw-composite-mapping-integrated-round-build))
(defn lwxrw-composite-mapping-integrated-round ()
    LWXRW-COMPOSITE-MAPPING-ROUND-VALUE)
(defn lwxrw-composite-mapping-world ()
    (lwt-round-world (lwxrw-composite-mapping-integrated-round)))

