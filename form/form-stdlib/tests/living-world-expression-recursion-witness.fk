    LWXRW-CORRESPONDENCE-PROPOSAL-ONE-VALUE)
(defn lwxrw-correspondence-proposal-two ()
    LWXRW-CORRESPONDENCE-PROPOSAL-TWO-VALUE)
(defn lwxrw-correspondence-candidate-one ()
    (lwt-proposal-candidate (lwxrw-correspondence-proposal-one)))
(defn lwxrw-correspondence-candidate-two ()
    (lwt-proposal-candidate (lwxrw-correspondence-proposal-two)))

(defn lwxrw-correspondence-round-build ()
    (lwt-round (lwxrw-reflection-world)
        (lwo-field
            (list (lwxrw-correspondence-proposal-one)
                  (lwxrw-correspondence-proposal-two)))
        (lwo-empty-field) (lwxrw-reflection-integrated-round)))
(defn lwxrw-correspondence-yes-round-build ()
    (do
        (let first (lwxrw-correspondence-proposal-one))
        (let second (lwxrw-correspondence-proposal-two))
        (lwt-round-receive (lwxrw-correspondence-round-build)
            (append
                (lwxbw-responses first
                    (oac-one (lwt-proposal-candidate first)))
                (lwxbw-responses second
                    (oac-one (lwt-proposal-candidate second)))))))
(defn lwxrw-correspondence-integrated-round-build ()
    (do
        (let round (lwxrw-correspondence-yes-round-build))
        (let first
            (lwxr-integrate-correspondence round
                (lwxrw-correspondence-proposal-one) (lwxbw-action)))
        (lwxr-integrate-correspondence first
            (lwxrw-correspondence-proposal-two) (lwxbw-action))))
(let LWXRW-CORRESPONDENCE-ROUND-VALUE
    (lwxrw-correspondence-integrated-round-build))
(defn lwxrw-correspondence-integrated-round ()
    LWXRW-CORRESPONDENCE-ROUND-VALUE)
(defn lwxrw-correspondence-world ()
    (lwt-round-world (lwxrw-correspondence-integrated-round)))

; --- recurrence grows a new mapping from the two reflected outcomes ---

(let LWXRW-COMPOSITE-MAPPING-PROPOSAL-VALUE
    (lwr-proposal-for (lwxrw-correspondence-world)
        (lwxrw-correspondence-candidate-one) 2))
(defn lwxrw-composite-mapping-proposal ()
