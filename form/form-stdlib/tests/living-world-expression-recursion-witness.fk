(defn lwxrw-silence-offer-world () LWXRW-SILENCE-OFFER-WORLD-VALUE)
(let LWXRW-SILENCE-PROPOSAL-VALUE
    (lwxr-reflection-proposal (lwxrw-silence-offer-world)
        (lwxrw-silence-reflection)))
(defn lwxrw-silence-proposal () LWXRW-SILENCE-PROPOSAL-VALUE)
(defn lwxrw-silence-candidate ()
    (lwt-proposal-candidate (lwxrw-silence-proposal)))
(defn lwxrw-silence-round-build ()
    (lwt-round (lwxrw-silence-offer-world)
        (lwo-field (list (lwxrw-silence-proposal)))
        (lwo-empty-field) (lwxrw-answer-integrated-round)))
(defn lwxrw-silence-yes-round-build ()
    (do
        (let proposal (lwxrw-silence-proposal))
        (lwt-round-receive (lwxrw-silence-round-build)
            (lwxbw-responses proposal
                (oac-one (lwt-proposal-candidate proposal))))))
(defn lwxrw-silence-integrated-round-build ()
    (lwxr-integrate-reflection (lwxrw-silence-yes-round-build)
        (lwxrw-silence-proposal) (lwxbw-action)))
(let LWXRW-SILENCE-ROUND-VALUE
    (lwxrw-silence-integrated-round-build))
(defn lwxrw-silence-integrated-round () LWXRW-SILENCE-ROUND-VALUE)
(defn lwxrw-silence-world ()
    (lwt-round-world (lwxrw-silence-integrated-round)))
(let LWXRW-MANY-FOCUS-FIELD-VALUE
    (lwxr-focus-proposals (lwxrw-silence-world)))
(defn lwxrw-many-focus-field () LWXRW-MANY-FOCUS-FIELD-VALUE)

; --- upstream reflection revocation reopens every derived conclusion -

(defn lwxrw-revoked-world-build ()
    (lwt-receive-stream (lwxrw-silence-world)
        (list (lwxbw-entry (lwxrw-source-n) (lwxrw-prov-n)
            (lwo-revocation (lwxrw-confirmation-one)
                (lwxrw-source-n) (lwxrw-reason) (lwxrw-prov-n))))))
(let LWXRW-REVOKED-WORLD-VALUE (lwxrw-revoked-world-build))
(defn lwxrw-revoked-world () LWXRW-REVOKED-WORLD-VALUE)
