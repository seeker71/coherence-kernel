; Pure role-crossing segments; pending IDs 0 and 1 are values. Expected 31.
; preludes: form-stdlib/bml/form-cli-code-live.bml
(do
 (defn fcacsb-assert (name ok) (if ok 1 (form_error (str_concat "reasoning boundary: " name))))
 (defn fcacsb-reject (contract subject) (list 0 "deliberately unsupported report"))
 (let review (fcap-open-direct-review "Return a supported report." (list (list "source" "source.txt" "Evidence."))))
 (let checker (list fcacsb-reject 0))
 (let tokenState (fcap-with-reply-token-limit review 5))
 (let tokenSession (fcms-session "live" "test" "" 0 (list) (list) 100 10 0 0 0 0 0 0))
 (fcacsb-assert "decode quanta respect the remaining reply allowance" (value_eq (list (fcac-decode-width tokenState tokenSession 0) (fcac-decode-width tokenState tokenSession 4) (fcac-decode-width tokenState tokenSession 5)) (list 4 1 0)))
 (fcacsb-assert "one-token limit never dispatches a full quantum" (eq (fcac-decode-width (fcap-with-reply-token-limit review 1) tokenSession 0) 1))
 (fcacsb-assert "context bound remains active" (eq (fcac-decode-width tokenState (fcms-session "live" "test" "" 0 (list) (list) 100 99 0 0 0 0 0 0) 0) 1))
 (fcacsb-assert "allowance resets for each reply" (and (fcac-reply-exhausted tokenState 5) (not (fcac-reply-exhausted tokenState 0))))
 (fcacsb-assert "context-only default retains quantum" (and (eq (fcac-decode-width review tokenSession 99) 4) (not (fcac-reply-exhausted review 99))))
 (fcacsb-assert "failed evidence retention is not called retained" (str_eq (fcac-incomplete-reason tokenState 5 "" "fallback") "reply-token-budget-reached;partial-reply-retention-failed;no-action"))
 (fcacsb-assert "absent empty file cannot prove reply retention" (str_eq (fcac-retained-reply "form/form-stdlib/tests/absent-reply-evidence-boundary" "" 0) ""))
 (fcacsb-assert "reasoning and ordinary generation use the tighter ceiling" (value_eq (list (fcac-token-allowance tokenState 9) (fcac-token-allowance tokenState 3) (fcac-token-allowance review 9)) (list 5 3 9)))
 (let tokenPacket (parse-json "token-budget" (fcac-observation-budget tokenState 3)))
 (fcacsb-assert "model receives reply token limit" (eq (json-int-value (json-object-get tokenPacket "max_reply_tokens")) 5))
 (fcacsb-assert "budget preserves original goal and context" (eq (str_find (fcac-bootstrap-budget tokenState 3) (fcap-bootstrap tokenState) 0) 0))
 (let first (fcap-step review "{\"tool\":\"read\",\"arguments\":[\"source.txt\"]}" checker))
 (let second (fcap-step first "{\"tool\":\"read\",\"arguments\":[\"source.txt\"]}" checker))
 (fcacsb-assert "reads consume the disclosed allowance" (value_eq (list (fcac-replies-left review 3) (fcac-replies-left first 3) (fcac-replies-left second 3)) (list 3 2 1)))
 (fcacsb-assert "expired allowance stays zero" (eq (fcac-replies-left second 1) 0))
 (let plain (parse-json "plain" (fcap-observation second)))
 (let budgeted (parse-json "budgeted" (fcac-observation-budget second 3)))
 (fcacsb-assert "source observation retained" (str_eq (fcap-string plain "observation") (fcap-string budgeted "observation")))
 (fcacsb-assert "role instruction retained" (str_eq (fcap-string plain "instruction") (fcap-string budgeted "instruction")))
 (fcacsb-assert "exact counters exposed" (faj-equal (json-object-get budgeted "reply_budget") (parse-json "expected" "{\"limit\":3,\"completed\":2,\"remaining\":1}")))
 (fcacsb-assert "last reply identified" (ge (str_find (fcap-string budgeted "budget_instruction") "final allowed reply" 0) 0))
 (fcacsb-assert "initial budget is carried" (ge (str_find (fcac-bootstrap-budget review 3) "CALLER REPLY BUDGET:" 0) 0))
 (fcacsb-assert "bootstrap substance retained" (eq (str_find (fcac-bootstrap-budget review 3) (fcap-bootstrap review) 0) 0))
 (let refused (fcap-step second "{\"report\":\"Unsupported conclusion.\"}" checker))
 (fcacsb-assert "last reply cannot bypass checks" (and (not (str_eq (fcap-stage refused) "complete")) (gt (fcap-failures refused) 0)))
 (let x (list 1 111 222 333 444 (list 55) (list 66) (list 77) (list 88)))
 (let ordinary (qtlc-chat-segments "private prompt" x))
 (let reasoning (fcmg-chat-segments-profile "private prompt" "knowledge-query-reasoning" x))
 (fcacsb-assert "ordinary knowledge profile remains identical" (value_eq ordinary (fcmg-chat-segments-profile "private prompt" "knowledge-query" x)))
 (fcacsb-assert "reasoning preserves user and assistant prefix" (value_eq (take 8 ordinary) (take 8 reasoning)))
 (fcacsb-assert "reasoning leaves thought open followed by one newline" (and (eq (len reasoning) 9) (value_eq (qtlc-segment-value (nth reasoning 8)) (list 66))))
 (fcacsb-assert "actual closing ID separates private and answer IDs" (value_eq (fcrt-answer (list 9 10 444 0 1 55) 444) (list 1 (list 0 1 55))))
 (fcacsb-assert "missing boundary stays absent" (value_eq (fcrt-answer (list 9 10 55) 444) (list 0 (list))))
 (fcacsb-assert "empty final channel is not invented" (value_eq (fcrt-answer (list 9 444) 444) (list 1 (list))))
 (let done (fcacs-segments 222 1 "observation" x))
 (let zero (fcacs-segments 0 0 "observation" x))
 (let one (fcacs-segments 1 0 "observation" x))
 (sum (list
  (if (value_eq (qtlc-segment-value (head done)) (list 222)) 1 0)
  (if (value_eq (qtlc-segment-value (head zero)) (list 0 222)) 2 0)
  (if (value_eq (qtlc-segment-value (head one)) (list 1 222)) 4 0)
  (if (str_eq (qtlc-segment-value (nth done 4)) "observation") 8 0)
  (if (and (eq (len done) 13) (value_eq (qtlc-segment-value (nth done 12)) (list 88))) 16 0))))
