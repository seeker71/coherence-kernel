; Pure role-crossing segments; pending IDs 0 and 1 are values. Expected 31.
; preludes: form-stdlib/bml/form-cli-code-live.bml form-stdlib/bml/form-cli-model-renew.bml
(do
 (defn fcacsb-assert (name ok) (if ok 1 (form_error (str_concat "reasoning boundary: " name))))
 (defn fcacsb-reject (contract subject) (list 0 "deliberately unsupported report"))
 (defn fcacsb-zeros (n) (if (le n 0) (list) (cons 0 (fcacsb-zeros (sub n 1)))))
 (defn fcacsb-source-check (contract docs) (list (str_eq (nth (fat-find-doc docs "answer.md") 2) "new") "observed current answer"))
 (let review (fcap-open-direct-review "Return a supported report." (list (list "source" "source.txt" "Evidence."))))
 (let checker (list fcacsb-reject 0))
 (let tokenState (fcap-with-reply-token-limit review 5))
 (let tokenSession (fcms-session "live" "test" "" 0 (list) (list) 100 10 0 0 0 0 0 0))
 (let sustained (fcap-with-reasoning tokenState (list 8 7)))
 (let rejected (fcap-step sustained "{\"report\":\"Unsupported.\"}" checker))
 (fcacsb-assert "failed checks preserve continuing reasoning" (and (str_eq (fcap-stage rejected) "repair") (value_eq (fcap-reasoning rejected) (list 8 7))))
 (fcacsb-assert "renewal preserves continuing reasoning" (str_eq (fcac-profile (fcap-begin-context rejected)) "knowledge-query-reasoning"))
 (fcacsb-assert "checkpoint codec retains reasoning state" (value_eq rejected (fcam-unpack (fcam-pack rejected))))
 (let sourceFailed (fcap-track-source-check (fcap-open-direct-code "Repair source" (list (list "source" "source.txt" "old")) (list "source.txt")) (list 0 "actual source failure")))
 (fcacsb-assert "checkpoint and renewal retain the unresolved source check" (fcap-source-repair-open (fcap-begin-context (fcam-unpack (fcam-pack sourceFailed)))))
 (fcacsb-assert "ordinary profile remains closed" (str_eq (fcac-profile review) "knowledge-query"))
 (fcacsb-assert "both reasoning stages obey the reply cap and reserve the stop position" (and (fcac-reply-fits (fcms-with-stream tokenSession 89 0 1 0 0 0) sustained) (not (fcac-reply-fits (fcms-with-stream tokenSession 90 0 1 0 0 0) sustained))))
 (let exactRoom (fcms-with-stream tokenSession 95 0 1 0 0 0))
 (let shortRoom (fcms-with-stream tokenSession 96 0 1 0 0 0))
 (fcacsb-assert "reply allowance fits exactly including the pending prediction" (and (eq (fcac-reply-room exactRoom) 5) (fcac-reply-fits exactRoom tokenState)))
 (fcacsb-assert "one missing reply position selects capacity before generation" (not (fcac-reply-fits shortRoom tokenState)))
 (fcacsb-assert "unbounded replies retain the existing context boundary" (fcac-reply-fits shortRoom review))
 (let observedReview (fcms-session "live" "test" "" 0 (list) (list) 12288 12213 0 0 0 0 0 0))
 (fcacsb-assert "actual 75-position review cannot admit a 2048-ID reply" (and (eq (fcac-reply-room observedReview) 75) (not (fcac-reply-fits observedReview (fcap-with-reply-token-limit review 2048)))))
 (let carrier (list "qwen-session-adapter-v1" "candidate" "digest" (list 101 102 103 (qlh-width) (md-f32-bits 1.0))))
 (let carried (fcmd-with-carrier tokenSession carrier))
 (fcacsb-assert "coding refusal retains adapter ownership" (value_eq (fcmd-carrier (fcacs-refuse carried "refused")) carrier))
 (fcacsb-assert "new independent stream retains selected adapter" (value_eq (fcmd-carrier (fcmr-new-session carried (list) (list 0 5) 5)) carrier))
 (let renewalState (fcap-with-reply-token-limit review 512))
 (let renewalSession (fcms-session "live" "observed-capacity" "" 0 (list) (list) 16384 7863 0 1 6554 319 990 3))
 (fcacsb-assert "actual 16240-ID renewal refuses before spending a new prefill" (not (fcac-renewal-fits renewalSession 16240 (list renewalState 8))))
 (fcacsb-assert "renewal reserves exactly the complete reply allowance" (and (fcac-renewal-fits renewalSession 15872 (list renewalState 8)) (not (fcac-renewal-fits renewalSession 15873 (list renewalState 8)))))
 (fcacsb-assert "unbounded renewal preserves the controller stop position" (and (fcac-renewal-fits tokenSession 98 (list review 3)) (not (fcac-renewal-fits tokenSession 99 (list review 3)))))
 (let renewalOwner (fcmd-with-carrier (fcms-session "live" "test-owned" "" 0 (list 0 0 (append (fcacsb-zeros 19) (list 2))) (list "opaque-stream") 8 2 0 1 2 7 9 1) carrier))
 (let refusedRenewal (fcmr-replace-ids-checked renewalOwner (list 0 1 0 1) fcac-renewal-fits (list tokenState 3)))
 (fcacsb-assert "insufficient caller reserve leaves the exact owner untouched before device work" (and (not (fcmr-changed refusedRenewal)) (and (str_eq (fcmr-reason refusedRenewal) "prompt-caller-capacity-refused") (value_eq (fcmr-session refusedRenewal) renewalOwner))))
 (fcacsb-assert "caller capacity does not bypass token validation" (str_eq (fcmr-reason (fcmr-replace-ids-checked renewalOwner (list -1) fcac-renewal-fits (list tokenState 3))) "prompt-token-id-refused"))
 (fcacsb-assert "incomplete encoding preserves ownership and invokes no renewal" (and (not (fcmr-changed (fcmr-encoded-checked renewalOwner (list "refused") fcac-renewal-fits (list tokenState 3)))) (value_eq (fcmr-session (fcmr-encoded-checked renewalOwner (list "refused") fcac-renewal-fits (list tokenState 3))) renewalOwner)))
 (fcacsb-assert "decode quanta respect the remaining reply allowance" (value_eq (list (fcac-decode-width tokenState tokenSession 0) (fcac-decode-width tokenState tokenSession 4) (fcac-decode-width tokenState tokenSession 5)) (list 4 1 0)))
 (fcacsb-assert "one-token limit never dispatches a full quantum" (eq (fcac-decode-width (fcap-with-reply-token-limit review 1) tokenSession 0) 1))
 (fcacsb-assert "context bound remains active" (eq (fcac-decode-width tokenState (fcms-session "live" "test" "" 0 (list) (list) 100 99 0 0 0 0 0 0) 0) 1))
 (fcacsb-assert "allowance resets for each reply" (and (fcac-reply-exhausted tokenState 5) (not (fcac-reply-exhausted tokenState 0))))
 (fcacsb-assert "context-only default retains quantum" (and (eq (fcac-decode-width review tokenSession 99) 4) (not (fcac-reply-exhausted review 99))))
 (fcacsb-assert "failed evidence retention is not called retained" (str_eq (fcac-incomplete-reason tokenState 5 "" "fallback") "reply-token-budget-reached;partial-reply-retention-failed;no-action"))
 (fcacsb-assert "absent empty file cannot prove reply retention" (str_eq (fcac-retained-reply "form/form-stdlib/tests/absent-reply-evidence-boundary" "" 0) ""))
 (fcacsb-assert "reasoning and ordinary generation use the tighter ceiling" (value_eq (list (fcac-token-allowance tokenState 9) (fcac-token-allowance tokenState 3) (fcac-token-allowance review 9)) (list 5 3 9)))
 (let tokenPacket (parse-json "token-budget" (fcac-observation-budget tokenState 3)))
 (fcacsb-assert "model receives reply token limit" (eq (json-int-value (json-object-get tokenPacket "max_reply_tokens")) 5))
 (fcacsb-assert "budget preserves original goal and context" (eq (str_find (fcac-bootstrap-budget tokenState 3) (fcap-bootstrap tokenState) 0) 0))
 (let first (fcap-step review "{\"tool\":\"read\",\"arguments\":[\"source.txt\"]}" checker))
 (let second (fcap-step first "{\"tool\":\"read\",\"arguments\":[\"source.txt\"]}" checker))
 (let capacityResult (list tokenSession (fcap-terminal second "coding-observation-context-capacity") second))
 (fcacsb-assert "completed work can renew before the unchanged reply limit" (fcac-renewable capacityResult (fcap-turns review) 3))
 (let replyCapacity (list shortRoom (fcap-terminal second "coding-reply-context-capacity") second))
 (fcacsb-assert "insufficient reply room can renew before any partial generation" (fcac-renewable replyCapacity (fcap-turns review) 3))
 (fcacsb-assert "oversized fresh bootstrap cannot loop through reply-room renewal" (not (fcac-renewable replyCapacity (fcap-turns second) 3)))
 (fcacsb-assert "reply-room renewal preserves the original reply limit" (not (fcac-renewable replyCapacity 0 (fcap-turns second))))
 (fcacsb-assert "a context with no completed reply cannot repeat admission" (not (fcac-renewable capacityResult (fcap-turns second) 3)))
 (fcacsb-assert "renewal cannot extend the caller reply allowance" (not (fcac-renewable capacityResult 0 (fcap-turns second))))
 (fcacsb-assert "ordinary terminal and partial generation have no renewal state" (not (fcac-renewable (list tokenSession (fcap-terminal second "generation-incomplete")) 0 3)))
 (let partialOwner (fcms-refuse tokenSession "observation-prefill-refused"))
 (fcacsb-assert "a refused partial-prefill owner cannot resume through renewal" (not (fcac-renewable (list partialOwner (fcap-terminal second "coding-observation-context-capacity") second) 0 3)))
 (fcacsb-assert "empty encoded feedback has a distinct non-capacity failure" (str_eq (fcms-reason (fcacs-observed tokenSession (list "done" 0 (list)))) "coding-observation-empty"))
 (let fullSession (fcms-with-stream tokenSession 99 0 1 7 13 2))
 (fcacsb-assert "a complete observation at the context edge can renew" (fcac-renewable (list fullSession (fcap-terminal second "context-capacity") second) 0 3))
 (fcacsb-assert "both stream-release failures remain incomplete" (and (not (fcac-renew-release-complete "old-stream-release-incomplete")) (not (fcac-renew-release-complete "candidate-stream-release-incomplete"))))
 (fcacsb-assert "cost across contexts preserves all counted generation and feedback" (value_eq (fcac-total-result (list second 1 11 17 3) (fcac-context-cost fullSession (list 2 5 1))) (list second 1 20 35 6)))
 (let nextContext (fcap-begin-context second))
 (fcacsb-assert "fresh context keeps the candidate goal role and reply count" (and (value_eq (fcap-docs nextContext) (fcap-docs second)) (and (str_eq (nth nextContext 1) (nth second 1)) (and (str_eq (fcap-stage nextContext) (fcap-stage second)) (eq (fcap-turns nextContext) (fcap-turns second))))))
 (fcacsb-assert "reads consume the disclosed allowance" (value_eq (list (fcac-replies-left review 3) (fcac-replies-left first 3) (fcac-replies-left second 3)) (list 3 2 1)))
 (fcacsb-assert "expired allowance stays zero" (eq (fcac-replies-left second 1) 0))
 (let plain (parse-json "plain" (fcap-observation second)))
 (let budgeted (parse-json "budgeted" (fcac-observation-budget second 3)))
 (fcacsb-assert "source observation retained" (str_eq (fcap-string plain "observation") (fcap-string budgeted "observation")))
 (fcacsb-assert "role instruction retained" (str_eq (fcap-string plain "instruction") (fcap-string budgeted "instruction")))
 (fcacsb-assert "exact counters exposed" (faj-equal (json-object-get budgeted "reply_budget") (parse-json "expected" "{\"limit\":3,\"completed\":2,\"remaining\":1}")))
 (fcacsb-assert "last reply identified" (ge (str_find (fcap-string budgeted "budget_instruction") "final allowed reply" 0) 0))
 (fcacsb-assert "initial budget is carried" (ge (str_find (fcac-bootstrap-budget review 3) "CALLER REPLY BUDGET:" 0) 0))
 (let coding (fcap-open-direct-code "Change old to new." (list (list "answer" "answer.md" "old")) (list "answer.md")))
 (let sourceChecker (list fcacsb-source-check 0))
 (let changed (fcap-step coding "{\"tool\":\"edit\",\"arguments\":[\"answer.md\",\"old\",\"new\"]}" sourceChecker))
 (let finishPacket (parse-json "finish-budget" (fcac-observation-budget changed 3)))
 (fcacsb-assert "last two coding replies account for task closure and review" (and (eq (json-int-value (json-object-get finishPacket "completion_replies_minimum")) 2) (eq (fcac-replies-left changed 3) 2)))
 (let ready (fcap-step changed "{\"task\":\"done\"}" sourceChecker))
 (fcacsb-assert "task closure already checks the source before review" (and (str_eq (fcap-stage ready) "review") (and (eq (fcap-checks ready) 1) (eq (fcac-finish-minimum ready) 1))))
 (let accepted (fcap-step ready "{\"verdict\":\"accept\",\"reason\":\"The current answer is new, as requested.\"}" sourceChecker))
 (fcacsb-assert "review completes within that budget and rechecks source" (and (str_eq (fcap-stage accepted) "complete") (and (eq (fcap-turns accepted) 3) (and (eq (fcap-checks accepted) 2) (eq (fcac-finish-minimum accepted) 0)))))
 (let rejectedCoding (fcap-step ready "{\"verdict\":\"reject\",\"reason\":\"Further work required.\"}" sourceChecker))
 (fcacsb-assert "a rejected review adds repair and preserves the limit" (and (eq (fcac-finish-minimum rejectedCoding) 3) (eq (fcac-replies-left rejectedCoding 3) 0)))
 (fcacsb-assert "bootstrap substance retained" (eq (str_find (fcac-bootstrap-budget review 3) (fcap-bootstrap review) 0) 0))
 (let refused (fcap-step second "{\"report\":\"Unsupported conclusion.\"}" checker))
 (fcacsb-assert "read-only repair can submit its report directly" (eq (fcac-finish-minimum refused) 1))
 (fcacsb-assert "last reply cannot bypass checks" (and (not (str_eq (fcap-stage refused) "complete")) (gt (fcap-failures refused) 0)))
 (let x (list 1 111 222 333 444 (list 55) (list 66) (list 77) (list 88)))
 (let ordinary (qtlc-chat-segments "private prompt" x))
 (let reasoning (fcmg-chat-segments-profile "private prompt" "knowledge-query-reasoning" x))
 (fcacsb-assert "ordinary knowledge profile remains identical" (value_eq ordinary (fcmg-chat-segments-profile "private prompt" "knowledge-query" x)))
 (fcacsb-assert "reasoning preserves user and assistant prefix" (value_eq (take 8 ordinary) (take 8 reasoning)))
 (fcacsb-assert "reasoning leaves thought open followed by one newline" (and (eq (len reasoning) 9) (value_eq (qtlc-segment-value (nth reasoning 8)) (list 66))))
 (fcacsb-assert "actual closing ID separates private and answer IDs" (value_eq (fcrt-answer (list 9 10 444 0 1 55) 444) (list 1 (list 0 1 55))))
 (fcacsb-assert "missing boundary stays absent" (value_eq (fcrt-answer (list 9 10 55) 444) (list 0 (list))))
 (fcacsb-assert "empty final channel is not invented" (value_eq (fcrt-answer (list 9 444) 444) (list 1 (list))))
 (let done (fcacs-segments 222 1 "observation" x))
 (let continued (fcacs-segments-profile 222 1 "observation" x 1))
 (fcacsb-assert "reasoning feedback preserves exact crossing and observation" (value_eq (take 10 continued) (take 10 done)))
 (fcacsb-assert "reasoning feedback leaves the actual thought boundary open" (and (eq (len continued) 11) (value_eq (qtlc-segment-value (nth continued 10)) (list 66))))
 (fcacsb-assert "ordinary feedback bytes stay identical" (value_eq done (fcacs-segments-profile 222 1 "observation" x 0)))
 (fcacsb-assert "reasoning continuation retains pending zero and one" (and (value_eq (qtlc-segment-value (head (fcacs-segments-profile 0 0 "observation" x 1))) (list 0 222)) (value_eq (qtlc-segment-value (head (fcacs-segments-profile 1 0 "observation" x 1))) (list 1 222))))
 (let zero (fcacs-segments 0 0 "observation" x))
 (let one (fcacs-segments 1 0 "observation" x))
 (sum (list
  (if (value_eq (qtlc-segment-value (head done)) (list 222)) 1 0)
  (if (value_eq (qtlc-segment-value (head zero)) (list 0 222)) 2 0)
  (if (value_eq (qtlc-segment-value (head one)) (list 1 222)) 4 0)
  (if (str_eq (qtlc-segment-value (nth done 4)) "observation") 8 0)
  (if (and (eq (len done) 13) (value_eq (qtlc-segment-value (nth done 12)) (list 88))) 16 0))))
