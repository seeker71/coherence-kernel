; Timestamp constraints act on adversarial logits; segment pressure cannot skip
; unclosed words. This is a policy fixture, not model quality evidence.
; preludes: form-stdlib/native-whisper-transcribe.bml
(do
 (defn nwp-zeros (n) (if (eq n 0) (list) (cons 0 (nwp-zeros (sub n 1)))))
 (defn nwp-logit (h id v) (do (nam-sync) (enw-write h (mul id 4) (enw-bytes-str (ln-u32-bytes (md-f32-bits v))))))
 (defn nwp-result (ids finish) (list 50259 ids finish -0.5 0.01 0.9 0 17 5 7 1))
 (let diagnosis (bfc-envelope 0 950001 0 (list 0 0 0 0 0) 3))
 (bfc-record-out diagnosis 0) (bfc-record-in (bfc-control diagnosis 2) 1)
 (let logit (nam-alloc 51866))
 (let st (list "fixture" (list) (list) (list) (append (nwp-zeros 15) (list logit)) (split-on (trim (read_file (nws-tokenizer))) (byte_to_str 10)) (list) (list) (list) (list 1280 5120 20 51866 448 1500 128 32 4 100)))
 (let decoder (nwd-open)) (let ts (eng-ts0 st))
 (nam-zero logit 51866) (nwp-logit logit 1446 100.0) (nwp-logit logit (add ts 60) 100.0) (nwp-logit logit (add ts 3) 20.0)
 (let first (eq (head (nwd-pick st decoder (list) 0.0 17)) (add ts 3)))
 (nam-zero logit 51866) (nwp-logit logit 1446 20.0) (nwp-logit logit (add ts 60) 100.0)
 (let words (eq (head (nwd-pick st decoder (list ts) 0.0 17)) 1446))
 (nam-zero logit 51866) (nwp-logit logit 1446 100.0) (nwp-logit logit (enw-eot) 20.0)
 (let eos (eq (head (nwd-pick st decoder (list (add ts 25) 13 1446 ts) 0.0 17)) (enw-eot)))
 (nam-zero logit 51866) (nwp-logit logit ts 100.0) (nwp-logit logit (add ts 25) 20.0)
 (let monotonic (eq (head (nwd-pick st decoder (list 13 1446 (add ts 20)) 0.0 17)) (add ts 25)))
 (nam-zero logit 51866) (nwp-logit logit 1 20.0) (nwp-logit logit 1446 19.0)
 (let suppressed (eq (head (nwd-pick st decoder (list ts) 0.0 17)) 1446))
 (let sampled (nwd-pick st decoder (list ts) 0.6 17))
 (let repeatable (value_eq sampled (nwd-pick st decoder (list ts) 0.6 17)))
 (let ids (list ts 1446 13 (add ts 25)))
 (let rows (nwt-segments st ids 480000 16000 480000 (list) (list) 1))
 (let timed (value_eq rows (list (list 480000 488000 "book."))))
 (let complete (eq (nwt-next st (nwp-result ids "eos") rows 480000 16000) 496000))
 (let partialids (append ids (list (add ts 25) 1446)))
 (let partial (nwt-segments st partialids 480000 16000 480000 (list) (list) 0))
 (let pressure (and (value_eq partial rows) (eq (nwt-next st (nwp-result partialids "position-capacity") partial 480000 16000) 488000)))
 (let pending (nwt-segments st (list ts 1446) 0 16000 0 (list) (list) 0))
 (let noadvance (and (nil? pending) (eq (nwt-next st (nwp-result (list ts 1446) "repetition") pending 0 16000) 0)))
 (let accumulated (nwd-accumulate (nwp-result ids "repetition") (nwp-result ids "eos")))
 (let totals (value_eq (drop 8 accumulated) (list 10 14 2)))
 (nwd-close decoder) (nam-free (list logit))
 (let freed (eq (nth (metal_live) 2) 0))
 (bfc-record-out (bfc-envelope 0 950001 0 (list first words eos monotonic suppressed) 3) 2)
 (print (list "initial-timestamp" first "timestamp-pairs" words "EOS" eos "monotonic" monotonic "suppression" suppressed "seed-repeatable" repeatable "timed-segment" timed "complete-progress" complete "pressure-progress" pressure "unclosed-held" noadvance "retry-totals" totals "released" freed))
 (if (and first (and words (and eos (and monotonic (and suppressed (and repeatable (and timed (and complete (and pressure (and noadvance (and totals freed))))))))))) 4095 (form_error "native Whisper policy witness failed")))
