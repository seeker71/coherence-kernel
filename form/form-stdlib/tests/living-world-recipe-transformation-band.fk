; living-world-recipe-transformation-band.fk -- a READY path stays observable.
; Verdict 32767 proves fifteen reflection, consent, independence, and freshness claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/tests/living-world-intention-graph-witness.fk

(let LWRXB-SOURCE-V (bp "LWRXB-SOURCE-V"))
(let LWRXB-SOURCE-W (bp "LWRXB-SOURCE-W"))
(let LWRXB-PROV-V   (bp "LWRXB-PROV-V"))
(let LWRXB-PROV-W   (bp "LWRXB-PROV-W"))
(let LWRXB-OPTION    (bp "LWRXB-OPTION"))
(let LWRXB-EVIDENCE  (bp "LWRXB-EVIDENCE"))
(let LWRXB-REASON    (bp "LWRXB-REASON"))

(defn lwrxb-cell (kind) (intern_node kind (empty)))
(defn lwrxb-source-v () (lwrxb-cell LWRXB-SOURCE-V))
(defn lwrxb-source-w () (lwrxb-cell LWRXB-SOURCE-W))
(defn lwrxb-prov-v () (lwrxb-cell LWRXB-PROV-V))
(defn lwrxb-prov-w () (lwrxb-cell LWRXB-PROV-W))
(defn lwrxb-option () (lwrxb-cell LWRXB-OPTION))
(defn lwrxb-evidence () (lwrxb-cell LWRXB-EVIDENCE))
(defn lwrxb-reason () (lwrxb-cell LWRXB-REASON))
(defn lwrxb-entry-v (payload)
    (lwigw-entry (lwrxb-source-v) (lwrxb-prov-v) payload))
(defn lwrxb-entry-w (payload)
    (lwigw-entry (lwrxb-source-w) (lwrxb-prov-w) payload))
(defn lwrxb-pqrstu ()
    (append (lwigw-pqrst)
        (list (list (lwigw-source-u) (lwigw-prov-u)))))
(defn lwrxb-all-sources ()
    (append (lwrxb-pqrstu)
        (list
            (list (lwrxb-source-v) (lwrxb-prov-v))
            (list (lwrxb-source-w) (lwrxb-prov-w)))))

(do
    (let fixture (lwigw-build-fixture))
    (let a (lwigw-a fixture))
    (let b (lwigw-b fixture))
    (let c (lwigw-c fixture))
    (let d (lwigw-d fixture))
    (let linear (lwigw-linear-worlds fixture))
    (let world (nth linear 1))
    (let prior (nth linear 4))
    (let plan (lwig-plan-for world a (lwigw-nodes-abc fixture)))
    (let transformation (lwrx-transformation-for world plan))
    (let proposal (lwrx-proposal world plan))
    (let candidate (lwt-proposal-candidate proposal))
    (let waiting-round
        (lwt-round world (lwo-field (list proposal))
            (lwo-empty-field) prior))
    (let waiting
        (lwrx-integrate waiting-round proposal (lwigw-action)))
    (let accepted-round
        (lwt-round-receive waiting-round
            (lwigw-edge-response-entries proposal (lwrxb-pqrstu))))
    (let integrated
        (lwrx-integrate accepted-round proposal (lwigw-action)))
    (let integrated-world (lwt-round-world integrated))
    (let overall (lwrx-transformation-overall transformation))
    (let unknown (lwlc-unknown (lwrxb-evidence)))
    (let observation
        (lwrx-observation candidate overall (oac-one overall)
            (lwo-field (list (lwrxb-option))) unknown (lwrxb-evidence)))
    (let self-world
        (lwt-receive-stream integrated-world
            (list (lwigw-entry-p observation))))
    (let observed-world
        (lwt-receive-stream self-world
            (list (lwrxb-entry-v observation)
                  (lwrxb-entry-w observation))))
    (let result (lwrx-result-for observed-world observation 2))
    (let result-proposal
        (lwrx-result-proposal observed-world observation 2))
    (let result-candidate (lwt-proposal-candidate result-proposal))
    (let result-round
        (lwt-round observed-world (lwo-field (list result-proposal))
            (lwo-empty-field) integrated))
    (let result-yes
        (lwt-round-receive result-round
            (lwigw-edge-response-entries
                result-proposal (lwrxb-all-sources))))
    (let result-integrated
        (lwrx-result-integrate result-yes result-proposal (lwigw-action)))
    (let result-world (lwt-round-world result-integrated))
    (let revocation
        (lwo-revocation observation (lwrxb-source-v)
            (lwrxb-reason) (lwrxb-prov-v)))
    (let revoked-world
        (lwt-receive-stream result-world
            (list (lwrxb-entry-v revocation))))
    (let other
        (lwrx-overall (intern_trivial_int 1) (intern_trivial_int 9)
            (lwrx-lens-sequence (list))))
    (let alternative-observation
        (lwrx-observation candidate other
            (oac-alternative-ack overall other (lwrxb-evidence))
            (lwo-empty-field) (lwo-none) (lwrxb-evidence)))
    (let silence-observation
        (lwrx-observation candidate (lwo-none) (oac-nothing)
            (lwo-empty-field) (lwo-none) (lwrxb-evidence)))
    (let steps
        (lwig-sequence-items
            (lwrx-transformation-steps transformation)))
    (let recipes
        (lwrx-recipe-sequence-items
            (lwrx-transformation-recipes transformation)))
    (let deltas
        (lwrx-delta-sequence-items
            (lwrx-transformation-deltas transformation)))

    (let c1
        (if (and (eq (lwig-plan-current? world plan) 1)
                 (eq (lwig-ready? (lwig-plan-status plan)) 1)) 1 0))
    (let c2
        (if (and (eq (lwrx-transformation-current?
                         world transformation) 1)
                 (not (node_eq proposal (lwo-none)))) 2 0))
    (let c3
        (if (and (eq (len steps) 3)
                 (and (node_eq (nth steps 0) a)
                      (and (node_eq (nth steps 1) b)
                           (node_eq (nth steps 2) c)))) 4 0))
    (let c4
        (if (and (eq (len recipes) 3)
                 (and (node_eq (nth recipes 0) (lwigw-recipe-a))
                      (and (node_eq (nth recipes 1) (lwigw-recipe-b))
                           (node_eq (nth recipes 2)
                                    (lwigw-recipe-c))))) 8 0))
    (let c5
        (if (and (eq (len deltas) 3)
                 (and (node_eq (nth deltas 0) (lwigw-delta-a))
                      (and (node_eq (nth deltas 1) (lwigw-delta-b))
                           (node_eq (nth deltas 2)
                                    (lwigw-delta-c))))) 16 0))
    (let c6
        (if (and (node_eq (lwrx-overall-before overall)
                          (intern_trivial_int 1))
                 (and (node_eq (lwrx-overall-after overall)
                               (intern_trivial_int 4))
                      (eq (len (lwrx-lens-sequence-items
                                   (lwrx-overall-lenses overall))) 3))) 32 0))
    (let c7
        (if (eq (lwo-field-has?
                    (lwrx-transformation-alternatives transformation)
                    d) 1) 64 0))
    (let c8
        (if (and (gt (lwo-field-size
                         (lwrx-transformation-unknowns transformation)) 0)
                 (node_eq (lwrx-transformation-path transformation)
                          (lwo-local-path))) 128 0))
    (let c9
        (if (eq (lwo-field-size
                    (lwt-proposal-participants proposal)) 6) 256 0))
    (let c10
        (if (eq (lwo-active?
                    (lwt-round-world waiting) candidate) 0) 512 0))
    (let c11
        (if (eq (lwrx-integrated-current?
                    integrated-world candidate) 1) 1024 0))
    (let c12
        (if (and (eq (lwo-field-size
                         (lwrx-independent-attributions
                            self-world observation)) 0)
                 (node_eq (lwrx-result-for self-world observation 1)
                          (lwo-none))) 2048 0))
    (let c13
        (if (and (eq (lwrx-confirm?
                         (lwrx-result-state-cell result)) 1)
                 (and (eq (lwo-field-has?
                              (lwrx-result-alternative-field result)
                              (lwrxb-option)) 1)
                      (eq (lwo-field-has?
                              (lwrx-result-unknown-field result)
                              unknown) 1))) 4096 0))
    (let c14
        (if (and (eq (lwo-field-size
                         (lwt-proposal-participants result-proposal)) 8)
                 (eq (lwrx-result-integrated-current?
                         result-world result-candidate 2) 1)) 8192 0))
    (let c15
        (if (and (eq (lwrx-result-integrated-current?
                         revoked-world result-candidate 2) 0)
                 (and (eq (lwrx-observation-valid?
                              alternative-observation) 1)
                      (eq (lwrx-observation-valid?
                              silence-observation) 1))) 16384 0))
    (lwigw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
