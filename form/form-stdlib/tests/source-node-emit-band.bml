; source-node-emit-band.bml — a recipe becomes code nodes with no text between (form-stdlib/bml/source-node-emit.bml), and what the nodes answer is what the text route answers.
;
; Verdict 511 when every claim lands (each recipe is built with the compiler's own fsc-rec-* constructors; its Form text is what fsc-source-emit-recipe prints,
; the answer the text route's program gives is the same expression written in BML):
;   1   a defn over one parameter, f(x) = add x 1, called with 5, answers 6
;   2   a defn over two parameters (tag 111 over the body), g(x, y) = add (mul x y) x, called with 3 and 4, answers 15
;   4   a defn with no parameter that calls a registered function, h() = f(41), answers 42 (the call chain of arity 0, the arity read from the kernel)
;   8   a string leaf, s(x) = str_concat x "!", called with "hi", answers "hi!" (tag 24 over the interned word)
;   16  the text the printer gives for f and g still prints the same defn the nodes were built from (the oracle stays honest)
;   32  do and let: k(x) = do (let y (add x 1)) (mul y y) answers 25 at 4; two lets, a = 1, b = add a x, then add a b, answer 5 at 3 (slots counted, tag 111 over the frame)
;   64  if, a recursive call and a rewrite row: fact(n) = if (le n 1) 1 (mul n (fact (sub n 1))) answers 120 at 5; e(x) = if (eq x 0) 100 (add x 1) answers 100 at 0 and 3 at 2
;   128 the rewrite rows run from their RPN programs: and, gt, ne, or, lt, not, ge, abs, each against the same expression written in BML
;   256 the walker's rewrite rows are the rows of runtime/fkwu-optable.h (the header is read and every row's text is found in it)
//
// REQUIRES: the built ./fkwu and the body root as the working directory.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/source-compiler.fk form-stdlib/form-flatten.fk form-stdlib/bml/source-node-emit.bml
section [form.bml] {
 class SourceNodeEmitBand {
  def snb-text-f(x) = x + 1;
  def snb-text-g(x, y) = x * y + x;
  def snb-text-s(x) = x ++ "!";
  def snb-text-fact(n) = n <= 1 ? 1 : n * snb-text-fact(n - 1);
  def snb-text-e(x) = x == 0 ? 100 : x + 1;
  def snb-text-m(x) = (x > 0 && x != 5) ? 1 : 0;
  def snb-text-t(x) = (x < 0 || !(x >= 10)) ? 1 : 0;
  def snb-int(v) = intern_trivial_int(v);
  def snb-x() = fsc-rec-ident("x");
  def snb-y() = fsc-rec-ident("y");
  def snb-n() = fsc-rec-ident("n");
  def snb-p(name, args) = fsc-rec-form-call(name, args);
  def snb-f-recipe() = fsc-rec-fndef("snb-built-f", ["x"], snb-p("add", [snb-x(), snb-int(1)]));
  def snb-g-recipe() = fsc-rec-fndef("snb-built-g", ["x", "y"], snb-p("add", [snb-p("mul", [snb-x(), snb-y()]), snb-x()]));
  def snb-h-recipe() = fsc-rec-fndef("snb-built-h", [], fsc-rec-call("snb-built-f", [snb-int(41)]));
  def snb-s-recipe() = fsc-rec-fndef("snb-built-s", ["x"], snb-p("str_concat", [snb-x(), fsc-rec-string("!")]));
  def snb-k1-recipe() = fsc-rec-fndef("snb-built-k1", ["x"], fsc-rec-do([fsc-rec-let("y", snb-p("add", [snb-x(), snb-int(1)])), snb-p("mul", [snb-y(), snb-y()])]));
  def snb-k2-recipe() = fsc-rec-fndef("snb-built-k2", ["x"], fsc-rec-do([fsc-rec-let("a", snb-int(1)), fsc-rec-let("b", snb-p("add", [fsc-rec-ident("a"), snb-x()])), snb-p("add", [fsc-rec-ident("a"), fsc-rec-ident("b")])]));
  def snb-fact-recipe() = fsc-rec-fndef("snb-built-fact", ["n"], fsc-rec-if3(snb-p("le", [snb-n(), snb-int(1)]), snb-int(1), snb-p("mul", [snb-n(), fsc-rec-call("snb-built-fact", [snb-p("sub", [snb-n(), snb-int(1)])])])));
  def snb-e-recipe() = fsc-rec-fndef("snb-built-e", ["x"], fsc-rec-if3(snb-p("eq", [snb-x(), snb-int(0)]), snb-int(100), snb-p("add", [snb-x(), snb-int(1)])));
  def snb-m-recipe() = fsc-rec-fndef("snb-built-m", ["x"], fsc-rec-if3(snb-p("and", [snb-p("gt", [snb-x(), snb-int(0)]), snb-p("ne", [snb-x(), snb-int(5)])]), snb-int(1), snb-int(0)));
  def snb-t-recipe() = fsc-rec-fndef("snb-built-t", ["x"], fsc-rec-if3(snb-p("or", [snb-p("lt", [snb-x(), snb-int(0)]), snb-p("not", [snb-p("ge", [snb-x(), snb-int(10)])])]), snb-int(1), snb-int(0)));
  def snb-a-recipe() = fsc-rec-fndef("snb-built-a", ["x"], snb-p("abs", [snb-x()]));
  def snb-call(name, args) = jit_node(["run", sne-emit-recipe(fsc-rec-call(name, args))]);
  def snb-born(recipe) = sne-emit-recipe(recipe);
  def snb-claim-1() { let d = snb-born(snb-f-recipe()); snb-call("snb-built-f", [snb-int(5)]) == snb-text-f(5); }
  def snb-claim-2() { let d = snb-born(snb-g-recipe()); snb-call("snb-built-g", [snb-int(3), snb-int(4)]) == snb-text-g(3, 4); }
  def snb-claim-4() { let d = snb-born(snb-h-recipe()); snb-call("snb-built-h", []) == snb-text-f(41); }
  def snb-claim-8() { let d = snb-born(snb-s-recipe()); snb-call("snb-built-s", [fsc-rec-string("hi")]) == snb-text-s("hi"); }
  def snb-claim-16() = fsc-source-emit-recipe(snb-f-recipe()) == "(defn snb-built-f (x) (add x 1))" && fsc-source-emit-recipe(snb-g-recipe()) == "(defn snb-built-g (x y) (add (mul x y) x))";
  def snb-claim-32() { let a = snb-born(snb-k1-recipe()); let b = snb-born(snb-k2-recipe()); snb-call("snb-built-k1", [snb-int(4)]) == 25 && snb-call("snb-built-k2", [snb-int(3)]) == 5; }
  def snb-claim-64() { let a = snb-born(snb-fact-recipe()); let b = snb-born(snb-e-recipe()); snb-call("snb-built-fact", [snb-int(5)]) == snb-text-fact(5) && snb-call("snb-built-e", [snb-int(0)]) == snb-text-e(0) && snb-call("snb-built-e", [snb-int(2)]) == snb-text-e(2); }
  def snb-claim-128() {
   let a = snb-born(snb-m-recipe()); let b = snb-born(snb-t-recipe()); let c = snb-born(snb-a-recipe());
   snb-call("snb-built-m", [snb-int(3)]) == snb-text-m(3) && snb-call("snb-built-m", [snb-int(5)]) == snb-text-m(5) && snb-call("snb-built-m", [snb-int(-1)]) == snb-text-m(-1)
   && snb-call("snb-built-t", [snb-int(5)]) == snb-text-t(5) && snb-call("snb-built-t", [snb-int(12)]) == snb-text-t(12) && snb-call("snb-built-t", [snb-int(-3)]) == snb-text-t(-3)
   && snb-call("snb-built-a", [snb-int(-7)]) == 7;
  }
  def snb-row-text(row) = "{ \"" ++ row[0] ++ "\", " ++ row[1].str() ++ ", " ++ len(row[2]).str() ++ ", { " ++ map(v => v.str(), row[2]).join(",") ++ ",} }";
  def snb-row-held(header, row) = str_find(header, snb-row-text(row), 0) >= 0;
  def snb-claim-256() { let header = read_file("runtime/fkwu-optable.h"); len(filter(r => !snb-row-held(header, r), sne-rewrites())) == 0; }
 }
 print_str("[source-node-emit] f " ++ snb-claim-1().str() ++ " g " ++ snb-claim-2().str() ++ " h " ++ snb-claim-4().str() ++ " s " ++ snb-claim-8().str() ++ " text " ++ snb-claim-16().str() ++ " do-let " ++ snb-claim-32().str() ++ " if-rec-rw " ++ snb-claim-64().str() ++ " rewrites " ++ snb-claim-128().str() ++ " header " ++ snb-claim-256().str());
 (snb-claim-1() ? 1 : 0) + (snb-claim-2() ? 2 : 0) + (snb-claim-4() ? 4 : 0) + (snb-claim-8() ? 8 : 0) + (snb-claim-16() ? 16 : 0) + (snb-claim-32() ? 32 : 0) + (snb-claim-64() ? 64 : 0) + (snb-claim-128() ? 128 : 0) + (snb-claim-256() ? 256 : 0);
}
