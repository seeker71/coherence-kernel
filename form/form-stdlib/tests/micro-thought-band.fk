; micro-thought-band.fk — the addressing and, more than the addressing, the refusals.
;
; A cheap address is only worth having if it is honest when it is wrong. This band
; spends most of its bits on the four ways this lane could answer something plausible:
; a thought found at an address it was never minted at, a thought found that is not the
; thought that was minted, a kernel that failed to compile remembered as a kernel, and
; an index answering a neighbouring row for a key it does not hold. Each of those is a
; green number over a wrong body, which is the failure this body names.
;
; It compiles real Metal (bits 32 and up) so the handles are handles and not stand-ins.
; On a host with no GPU the door is not live and those bits stay 0 — a red the runner
; should read as "not witnessed here", which is why bit 1 says whether it was.
;
;   1      the Metal handle door is live in this process (the rest of the bits mean
;          nothing without it, so it is recorded rather than assumed)
;   2      an address is the shape row: the parts joined by one separator
;   4      the same parts give the same address; different parts give a different one
;   8      mt-identity is content-true — one text built two ways interns to one number,
;          and one byte's difference to another
;   16     a fresh table KNOWS NOTHING: known? is 0 and recall is -1, not a plausible 0
;   32     a minted thought is known, and recalls a live handle
;   64     asking the same address again does not mint again: same handle, and the
;          carrier's pipeline count does not move
;   128    the seal agrees with the source the thought was minted from
;   256    THE COLLISION REFUSAL: the seal does NOT agree with a different source at
;          the same address, which is the only door that can catch a shape row that
;          left something out
;   512    two different shapes get two different handles (the address separates)
;   1024   A REFUSED COMPILE IS NOT REMEMBERED: after minting a source Metal will not
;          take, the address is still empty (known? 0, recall -1) so the next ask hears
;          the compiler rather than reading a remembered zero
;   2048   the collapse counts distinct rows, not rows
;   4096   the collapse over the VOICE's own 2755 node operators is 50 — the census the
;          body reads off the file, arrived at through the address instead of a count
;   8192   the index answers the whole row at a key it holds
;   16384  THE MISS REFUSAL: a key the index does not hold answers the empty text — not
;          the empty text by accident, but provably not any row the index does hold
;   32768  the index and the walk it replaces agree on every key in the rows
;
; Expected: 65535
; Verdict 65535
; PROOF LEVEL: FOURTH-ARM ONLY (Metal pipeline compilation on this host's own GPU)
; preludes: form/form-stdlib/micro-thought.bml form/form-stdlib/jit-tensor-emit.fk form/form-stdlib/metal-door.fk form/form-stdlib/voice-onnx.bml form/form-stdlib/voice-phoneme.bml
(do
    (defn mb-bit (ok v) (if ok v 0))
    (defn mb-yes (x) (if (eq x 1) 1 0))

    ; ---- the door -------------------------------------------------------------------
    (let live (md-door-live?))
    (let b1 (mb-bit live 1))

    ; ---- the address ----------------------------------------------------------------
    (let a1 (mt-address (list "matvec" "msl" "f32")))
    (let a2 (mt-address (list "matvec" "msl" "f32")))
    (let a3 (mt-address (list "matvec" "msl" "f16")))
    (let b2 (mb-bit (str_eq a1 "matvec|msl|f32") 2))
    (let b4 (mb-bit (if (str_eq a1 a2) (if (str_eq a1 a3) 0 1) 0) 4))

    ; one text, two constructions; and one byte away
    (let t-a (str_concat "matvec" (str_concat "|" "f32")))
    (let t-b "matvec|f32")
    (let t-c "matvec|f16")
    (let b8 (mb-bit (if (eq (mt-identity t-a) (mt-identity t-b))
                        (if (eq (mt-identity t-a) (mt-identity t-c)) 0 1) 0) 8))

    ; ---- an empty table knows nothing -----------------------------------------------
    (let empty (mt-table))
    (let b16 (mb-bit (if (eq (mt-known? empty a1) 0) (eq (mt-recall empty a1) (sub 0 1)) 0) 16))

    ; ---- minting --------------------------------------------------------------------
    (let src1 (tir-matvec-msl-fmt "mb_mv32" "f32"))
    (let src2 (tir-matvec-msl-fmt "mb_mv16" "f16"))
    (let t1 (mt-mint (mt-table) a1 src1 "mb_mv32"))
    (let h1 (mt-recall t1 a1))
    (let b32 (mb-bit (if (eq (mt-known? t1 a1) 1) (gt h1 0) 0) 32))

    ; asking again must not mint again. The carrier's own pipeline count is the
    ; witness that no second compile happened, not this cell's word for it.
    (defn mb-pipes () (str_find (metal_status) "pipelines=" 0))
    (let pipes-before (metal_status))
    (let t1b (mt-think t1 a1 src1 "mb_mv32"))
    (let b64 (mb-bit (if (eq (mt-recall t1b a1) h1) (str_eq (metal_status) pipes-before) 0) 64))

    ; ---- the seal -------------------------------------------------------------------
    (let b128 (mb-bit (eq (mt-agrees? t1 a1 src1) 1) 128))
    (let b256 (mb-bit (eq (mt-agrees? t1 a1 src2) 0) 256))

    ; ---- two shapes, two thoughts ---------------------------------------------------
    (let t2 (mt-mint t1 a3 src2 "mb_mv16"))
    (let h2 (mt-recall t2 a3))
    (let b512 (mb-bit (if (gt h2 0) (if (eq h1 h2) 0 1) 0) 512))

    ; ---- a refused compile is not remembered ----------------------------------------
    ; Metal cannot take this: it is not a kernel. The carrier answers 0 and this lane
    ; must leave the address empty rather than remember the 0.
    (let bad-addr (mt-address (list "notakernel" "msl" "f32")))
    (let tbad (mt-mint (mt-table) bad-addr "kernel void mb_broken(" "mb_broken"))
    (let b1024 (mb-bit (if (eq (mt-known? tbad bad-addr) 0) (eq (mt-recall tbad bad-addr) (sub 0 1)) 0) 1024))

    ; ---- the collapse ---------------------------------------------------------------
    (let b2048 (mb-bit (if (eq (mt-collapse (list "a|1" "a|1" "b|2" "a|1" "c|3")) 3)
                           (eq (mt-collapse (list)) 0) 0) 2048))

    ; The voice's own graph, addressed. Its 2755 nodes are read off the model file by
    ; voice-onnx.bml; the operator of each node is its shape row's first part, and the
    ; collapse over those rows is the number of thoughts the port owes.
    (defn mb-ops-of (census acc) (if (eq (len census) 0) acc (mb-ops-of (tail census) (cons (head (head census)) acc))))
    (defn mb-rows-of (census acc)
        (if (eq (len census) 0) acc
            (mb-rows-of (tail census) (mb-repeat (head (head census)) (nth (head census) 1) acc))))
    (defn mb-repeat (op n acc) (if (le n 0) acc (mb-repeat op (sub n 1) (cons (mt-address (list op "msl" "f32")) acc))))
    (let vpath (vp-model-path "en_GB-jenny_dioco-medium"))
    (let census (if (eq (vo-model? vpath) 1) (vo-op-census vpath) (list)))
    (let node-rows (mb-rows-of census (list)))
    (let b4096 (mb-bit (if (eq (len node-rows) 2755) (eq (mt-collapse node-rows) 50) 0) 4096))

    ; ---- the index ------------------------------------------------------------------
    (let lines (list "aa|one" "bb|two" "cc|three"))
    (let idx (ai-build lines))
    (let b8192 (mb-bit (str_eq (ai-at idx "bb") "bb|two") 8192))

    ; a miss must be the empty text AND must not be any row the index holds
    (defn mb-none-equal? (ls v) (if (eq (len ls) 0) 1 (if (str_eq (head ls) v) 0 (mb-none-equal? (tail ls) v))))
    (let miss (ai-at idx "zz"))
    (let b16384 (mb-bit (if (eq (str_len miss) 0) (mb-none-equal? lines miss) 0) 16384))

    ; the index and the walk answer the same thing for every key present, and both
    ; refuse the same absent one
    (defn mb-agree? (t ls all) (if (eq (len ls) 0) 1 (if (str_eq (ai-at t (ai-key (head ls))) (ai-walk all (ai-key (head ls)))) (mb-agree? t (tail ls) all) 0)))
    (let b32768 (mb-bit (if (eq (mb-agree? idx lines lines) 1) (str_eq (ai-walk lines "zz") (ai-at idx "zz")) 0) 32768))

    (add b1 (add b2 (add b4 (add b8 (add b16 (add b32 (add b64 (add b128 (add b256 (add b512 (add b1024 (add b2048 (add b4096 (add b8192 (add b16384 b32768)))))))))))))))
)
