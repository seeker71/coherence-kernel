// Counterexamples for citation and application links, without a semantic oracle.
// preludes: form-stdlib/bml/form-cli-review-source-lines.bml
section [form.bml] {
 class ReviewBindingsWitness {
  def rbw-check(name,ok) = if ok then 1 else form_error(str_concat("review bindings: ",name));
  def rbw-row(field,draft,source,quote,status,replacement) = json-node-object(list(json-node-pair("draft_field",json-node-string(field)),json-node-pair("draft_quote",json-node-string(draft)),json-node-pair("source_path",json-node-string(source)),json-node-pair("source_quote",json-node-string(quote)),json-node-pair("explanation",json-node-string("This is a reviewer claim, not a verified inference.")),json-node-pair("status",json-node-string(status)),json-node-pair("replacement_quote",json-node-string(replacement))));
  def rbw-report(answer,rows) = json-node-object(list(json-node-pair("answer",json-node-string(answer)),json-node-pair("next_action",json-node-string("Continue.")),json-node-pair("review_findings",json-node-array(rows))));
  def rbw-operation(row,operation) = json-node-object(append(json-object-pairs(row),list(json-node-pair("operation",json-node-string(operation)))));
  def rbw-lines(row,lines) = oh-set(row,"source_lines",parse-json("lines",lines));
  def rbw-propose(row,sources) = fcrl-propose(sources,json-emit(rbw-report("Referenced objects persist.",list(row))),1024);
  def rbw-live(contract,subject) {
   let checked = fcrl-check(head(contract),parse-json("report",nth(subject,1)),nth(contract,1),1024);
   list(head(checked),nth(checked,1));
  }
  def rbw-sources(expected,subject) = list(((Value) expected == subject),"source documents unchanged");
 }
 let draft = rbw-report("All objects persist.",list());
 let sources = list(list("source","rule.txt","Referenced objects persist. Unreferenced objects can be reclaimed."));
 let good = rbw-row("answer","All objects persist.","rule.txt","Referenced objects persist.","applied","Referenced objects persist.");
 let corrected = rbw-report("Referenced objects persist.",list(good));
 rbw-check("applied links",((Value) fcrb-check(draft,corrected,sources) == list(1,"Exact review links checked; finding completeness, entailment and answer quality remain unmeasured.",1,0)));
 rbw-check("unchanged field",(!head(fcrb-check(draft,rbw-report("All objects persist.",list(good)),sources))));
 rbw-check("fabricated source quote",(!head(fcrb-check(draft,rbw-report("Referenced objects persist.",list(rbw-row("answer","All objects persist.","rule.txt","All objects persist.","applied","Referenced objects persist."))),sources))));
 rbw-check("source not offered",(!head(fcrb-check(draft,corrected,list()))));
 rbw-check("quote in wrong draft field",(!head(fcrb-check(draft,rbw-report("Referenced objects persist.",list(rbw-row("next_action","All objects persist.","rule.txt","Referenced objects persist.","applied","Referenced objects persist."))),sources))));
 rbw-check("replacement in wrong field",(!head(fcrb-check(draft,rbw-report("Referenced objects persist.",list(rbw-row("answer","All objects persist.","rule.txt","Referenced objects persist.","applied","Continue."))),sources))));
 rbw-check("repeated quote",(!head(fcrb-check(draft,rbw-report("All objects persist. Changed elsewhere.",list(rbw-row("answer","All objects persist.","rule.txt","Referenced objects persist.","applied","All objects persist."))),sources))));
 rbw-check("whitespace is not evidence",(!head(fcrb-check(draft,rbw-report("Referenced objects persist.",list(rbw-row("answer"," ","rule.txt","Referenced objects persist.","applied","Referenced objects persist."))),sources))));
 let unresolved = rbw-row("answer","All objects persist.","rule.txt","Referenced objects persist.","unresolved","");
 rbw-check("unresolved retained",((Comparable) nth(fcrb-check(draft,rbw-report("All objects persist.",list(unresolved)),sources),3) == 1));
 rbw-check("mixed findings counted",((Value) tail(tail(fcrb-check(draft,rbw-report("Referenced objects persist.",list(good,unresolved)),sources))) == list(1,1)));
 rbw-check("empty findings is no quality verdict",(head(fcrb-check(draft,draft,sources)) && ((Comparable) nth(fcrb-check(draft,draft,sources),2) == 0)));
 rbw-check("malformed findings",(!head(fcrb-check(draft,rbw-report("x",list(json-node-null())),sources))));
 let deletion = rbw-row("answer","All objects persist.","rule.txt","Referenced objects persist.","applied","");
 rbw-check("empty replacement alone remains refused",(!head(fcrb-check(draft,rbw-report("Remaining answer.",list(deletion)),sources))));
 rbw-check("explicit observed deletion",head(fcrb-check(draft,rbw-report("Remaining answer.",list(rbw-operation(deletion,"delete"))),sources)));
 rbw-check("delete still present",(!head(fcrb-check(draft,rbw-report("All objects persist. Extra text.",list(rbw-operation(deletion,"delete"))),sources))));
 rbw-check("delete cannot carry replacement",(!head(fcrb-check(draft,rbw-report("Referenced objects persist.",list(rbw-operation(good,"delete"))),sources))));
 rbw-check("unknown operation",(!head(fcrb-check(draft,rbw-report("Referenced objects persist.",list(rbw-operation(good,"invented"))),sources))));
 // A real quote can support a bad inference: the checker must not claim otherwise.
 let unsound = rbw-row("answer","All objects persist.","rule.txt","Referenced objects persist.","applied","Every object disappears immediately.");
  rbw-check("entailment outside this check",head(fcrb-check(draft,rbw-report("Every object disappears immediately.",list(unsound)),sources)));
 let lineText = "Header\r\n**Referenced objects** persist.\r\n  α stays referenced.\nTail";
 let lineSources = list(list("source","rule.txt",lineText));
 let lineRow = rbw-lines(oh-set(good,"source_quote",json-node-string("")),"[2,3]");
 let raw = rbw-report("Referenced objects persist.",list(lineRow));
 let proposed = fcrl-propose(lineSources,json-emit(raw),1024);
 let resolved = parse-json("resolved",nth(proposed,1));
 let quoted = fcap-string(head(node_children(json-object-get(resolved,"review_findings"))),"source_quote");
 rbw-check("source bytes materialized",(head(proposed) && ((String) quoted == "**Referenced objects** persist.\r\n  α stays referenced.\n")));
 rbw-check("unchanged exact checker accepts resolved source",head(fcrb-check(draft,resolved,lineSources)));
 rbw-check("answer untouched",((String) fcap-string(raw,"answer") == fcap-string(resolved,"answer")));
 rbw-check("raw report retained",((String) fcap-string(head(node_children(json-object-get(raw,"review_findings"))),"source_quote") == ""));
 rbw-check("byte offsets",((String) substring(lineText,8,(8 + str_len(quoted))) == quoted));
 rbw-check("end without terminator",((String) nth(fcqe-lines(lineText,4,4,1024),1) == "Tail"));
 rbw-check("no phantom final line",(!head(fcqe-lines("x\n",2,2,1024))));
 rbw-check("zero index",(!head(fcqe-lines(lineText,0,1,1024))));
 rbw-check("reversed indexes",(!head(fcqe-lines(lineText,3,2,1024))));
 rbw-check("fractional index",(!head(fcqe-lines(lineText,1.5,2,1024))));
 rbw-check("out of range",(!head(fcqe-lines(lineText,1,5,1024))));
 rbw-check("blank line",(!head(fcqe-lines("x\n \t\ny",2,2,1024))));
 rbw-check("source byte limit",(!head(fcqe-lines(lineText,2,3,4))));
 rbw-check("conflicting quote never overwritten",(!head(rbw-propose(rbw-lines(good,"[2,3]"),lineSources))));
 rbw-check("wrong path",(!head(rbw-propose(lineRow,list()))));
 rbw-check("ambiguous path",(!head(rbw-propose(lineRow,append(lineSources,lineSources)))));
 rbw-check("boolean index refused",(!head(rbw-propose(rbw-lines(lineRow,"[true,3]"),lineSources))));
 rbw-check("string index refused",(!head(rbw-propose(rbw-lines(lineRow,"[\"2\",3]"),lineSources))));
 rbw-check("wrong range size",(!head(rbw-propose(rbw-lines(lineRow,"[2]"),lineSources))));
 rbw-check("idempotent",(!head(fcrl-propose(lineSources,nth(proposed,1),1024))));
 let conflicting = rbw-report("Referenced objects persist.",list(rbw-lines(oh-set(lineRow,"source_quote",json-node-string("Tail")),"[2,3]")));
 rbw-check("literal membership alone does not validate coordinates",head(fcrb-check(draft,conflicting,lineSources)));
 rbw-check("coordinates checked alongside valid literal",(!head(fcrl-check(draft,conflicting,lineSources,1024))));
 rbw-check("resolved coordinates and links checked",head(fcrl-check(draft,resolved,lineSources,1024)));
 let mixed = rbw-report("Referenced objects persist.",list(lineRow,oh-set(unresolved,"source_quote",json-node-string("Tail"))));
 let mixedProposal = fcrl-propose(lineSources,json-emit(mixed),1024);
 rbw-check("literal and reference findings",((Value) tail(tail(fcrb-check(draft,parse-json("mixed",nth(mixedProposal,1)),lineSources))) == list(1,1)));
 let badAfterGood = json-emit(rbw-report("Referenced objects persist.",list(lineRow,rbw-lines(good,"[99,99]"))));
 let failed = fcrl-propose(lineSources,badAfterGood,1024);
 rbw-check("no partial candidate",((!head(failed)) && ((String) nth(failed,1) == badAfterGood)));
 rbw-check("duplicate root refused",(!head(fcrl-propose(lineSources,"{\"review_findings\":[],\"review_findings\":[]}",1024))));
 rbw-check("missing quote materialized",head(fcrl-row(parse-json("row","{\"source_path\":\"rule.txt\",\"source_lines\":[2,3]}"),lineSources,1024,0)));
 rbw-check("null quote refused",(!head(fcrl-row(parse-json("row","{\"source_path\":\"rule.txt\",\"source_lines\":[2,3],\"source_quote\":null}"),lineSources,1024,0))));
 rbw-check("duplicate finding key refused",(!head(fcrl-row(parse-json("row","{\"source_path\":\"rule.txt\",\"source_lines\":[2,3],\"source_lines\":[1,1]}"),lineSources,1024,0))));
 let checker = list(rbw-live,list(draft,lineSources),rbw-sources,lineSources,fcrl-repair,list(lineSources,1024));
 let state = fcap-open-direct-review("Review source links.",lineSources);
 let completed = fcap-step(state,str_concat("{\"report\":",str_concat(json-emit(raw),"}")),checker);
 rbw-check("controller checks resolved report",((String) fcap-stage(completed) == "complete"));
 rbw-check("controller retains native attribution",(((Comparable) len(fcap-native-repairs(completed)) == 1) && ((String) nth(head(fcap-native-repairs(completed)),1) == "accepted")));
 rbw-check("controller preserves source documents",((Value) fcap-docs(completed) == lineSources));
 let falseApplication = oh-set(raw,"answer",json-node-string("All objects persist."));
 let declined = fcap-step(state,str_concat("{\"report\":",str_concat(json-emit(falseApplication),"}")),checker);
 rbw-check("source resolution cannot bypass application checks",((String) fcap-stage(declined) == "repair"));
 1;
}
