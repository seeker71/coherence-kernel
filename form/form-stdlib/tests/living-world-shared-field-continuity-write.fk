; First process of the shared-field continuity witness.  It leaves only the
; registry-free CCS carrier; expected verdict: 31.
; preludes: form-stdlib/core.fk form-stdlib/tests/living-world-shared-field-continuity-witness.fk

(do
    (let started
        (lcfb-open-stream "living-world-shared-field-continuity-write"
            "form-native" "lwsfcw-seed" "leave-inert-image"
            "form/form-stdlib/tests/living-world-shared-field-continuity-write.fk"
            12 15))
    (lwsfcw-clean)
    (let seed (lwsfcw-seed started))
    (let state (nth seed 0))
    (let answer (nth seed 1))
    (let image (lwsfc-image state))
    (let saved
        (lwcd-save-new (lwsfcw-before-path) image (lwo-none)))
    (lwsnw-verdict
        (list
            (if (and (eq (oac-one? (lwsf-answer-ack answer)) 1)
                     (eq (oac-one? (lwsf-answer-voice-ack answer)) 1)) 1 0)
            (if (eq (lwcn-image-valid? image) 1) 1 0)
            (if (eq (lwcd-saved? saved) 1) 1 0)
            (if (eq (fs-exists? (lwsfcw-before-path)) 1) 1 0)
            (if (eq (fs-exists?
                        (lwcd-pending-path (lwsfcw-before-path))) 0) 1 0))))
