; text-rows-band.fk — the tabular-text engine: fields by index, ints,
; line finds, and max-line-by-int-field, over one fixture.
; Expected: 255
; preludes: form-stdlib/text-rows.bml
(do
    (defn txb-bit (ok bit) (if ok bit 0))
    (let t "80 burn extra\n32010055 FOL-BP-BOOTSTRAP-TABLE\n5 str_find x\n")
    (sum (list
        (txb-bit (eq (tx-count-lines t) 3) 1)
        (txb-bit (str_eq (tx-field "80 burn extra" 1) "burn") 2)
        (txb-bit (eq (tx-int "80 burn extra" 0) 80) 4)
        (txb-bit (str_eq (tx-rest "80 burn extra" 1) "burn extra") 8)
        (txb-bit (str_eq (tx-field (tx-max-line-by-int t 0) 1) "FOL-BP-BOOTSTRAP-TABLE") 16)
        (txb-bit (str_eq (tx-find-line t "str_find") "5 str_find x") 32)
        (txb-bit (str_eq (tx-max-line-by-int "" 0) "") 64)
        (txb-bit (str_eq (tx-line-of t (str_find t "FOL" 0)) "32010055 FOL-BP-BOOTSTRAP-TABLE") 128))))
