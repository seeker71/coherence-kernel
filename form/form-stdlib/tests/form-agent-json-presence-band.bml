// Object presence: null, false and zero stay present; absent keys stay absent.
// preludes: form-stdlib/bml/form-agent-json-query.bml
section [form.bml] {
 class FormJsonPresenceBand {
  def fjpb-run(query,source,vars) {
   let compiled = faj-compile(query);
   if (!((String) nth(compiled,1) == "")) then compiled else if (!faj-bound(head(compiled),vars)) then faj-bad("unbound-variable") else faj-eval(head(compiled),faj-json("presence",source),vars);
  }
  def fjpb-is(query,source,value) {
   let result = fjpb-run(query,source,list());
   (((String) nth(result,1) == "") && (((Comparable) len(head(result)) == 1) && node_eq(head(head(result)),intern_trivial_bool(value))));
  }
  def fjpb-all(values) = if nil?(values) then 1 else (head(values) && fjpb-all(tail(values)));
 }
 let source = "{\"nothing\":null,\"false\":false,\"zero\":0,\"clé\":1}";
 let checks = list(fjpb-is("has(\"nothing\")",source,1),fjpb-is("has(\"false\")",source,1),fjpb-is("has(\"zero\")",source,1),fjpb-is("has(\"absent\")",source,0),fjpb-is("has(\"clé\")",source,1),((String) nth(fjpb-run("has(1)",source,list()),1) == "has-needs-string-key"),((String) nth(fjpb-run("has(0)","[1]",list()),1) == "has-needs-object"),((String) nth(fjpb-run("has($unknown)",source,list()),1) == "unbound-variable"),(!((String) nth(faj-compile("has("),1) == "")),node_eq(head(head(fjpb-run("has($key)",source,list(list("key",intern_trivial_string("nothing")))))),intern_trivial_bool(true)),((String) faj-render(head(fjpb-run("map(has(\"a\"))","[{\"a\":null},{}]",list())),0) == "[true,false]\n"));
 print(checks);
 if fjpb-all(checks) then 1 else form_error("native JSON object presence changed");
}
