; form-knowledge-family-native-exec-resident-batch-band.fk -- pure current-
; family scheduler/ledger witness with replay, swap, and raw-byte adversaries.
;
; No model or carrier runs. Synthetic native results have the exact compact
; physical flags and lifecycle required by the production ledger.
; Expected: 1073741823 (30 bits).
; preludes: form-stdlib/form-knowledge-family-native-exec-resident-batch.fk

(do
    (defn fkfnbb-bit (held weight) (if held weight 0))
    (defn fkfnbb-id (kind)
        (nmfe-sha256 (nmfe-fields (list
            "synthetic-family-native-resident-batch-v1" kind))))
    (defn fkfnbb-live (request status value native executed released)
        (do
            (let code (if (eq native 1)
                (frexl-code-node (frex-request-recipe request)) (nothing)))
            (frexl-result-from-offer request
                (frex-offer (frex-request-carrier request) status value
                    (str_concat "batch-fixture-" status))
                code (str_len (frex-surface (frex-request-recipe request)
                    (frex-request-input request)
                    (frex-request-carrier request)))
                (if (eq native 1) 1 0) native executed
                native released
                (if (eq executed 1) 4 0)
                (if (eq executed 1) 1 0)
                (if (eq executed 1) 1 0)
                (if (eq executed 1) 4 0))))
    (defn fkfnbb-result (schedule)
        (do
            (let binding (fkfnb-schedule-binding schedule))
            (let prep (fkfne-prepare binding (fkfne-binding-query binding)))
            (let request (fkfne-prep-request prep))
            (let expected (frexl-recipe-expected
                (fkfne-binding-recipe binding)
                (fkfne-binding-input binding)))
            (frexl-result-as-frex request
                (fkfnbb-live request "value" expected 1 1 1))))
    (defn fkfnbb-captures (schedule residence-id)
        (if (nil? schedule) (list)
            (do
                (let row (head schedule))
                (let binding (fkfnb-schedule-binding row))
                (let raw (fkfne-binding-query binding))
                (let prep (fkfne-prepare binding raw))
                (let result (fkfnbb-result row))
                (let capture (fkfnb-capture row raw prep result
                    (frex-render result) (fkfnb-ack row) residence-id 1 1))
                (cons capture
                    (fkfnbb-captures (tail schedule) residence-id)))))
    (defn fkfnbb-captures-valid? (captures)
        (if (nil? captures) 1
            (if (eq (fkfnb-capture-valid? (head captures)) 1)
                (fkfnbb-captures-valid? (tail captures)) 0)))
    (defn fkfnbb-rows-valid? (rows model-id residence-id)
        (if (nil? rows) 1
            (if (eq (fkfnb-row-valid? (head rows) model-id residence-id) 1)
                (fkfnbb-rows-valid? (tail rows) model-id residence-id) 0)))
    (defn fkfnbb-flags-valid? (captures)
        (if (nil? captures) 1
            (do
                (let prep (fkfnb-capture-prep (head captures)))
                (let result (fkfnb-capture-result (head captures)))
                (if (fkfnb-all? (list
                    (eq (fkfne-prep-exact? prep) 1)
                    (eq (fkfne-prep-scannerless? prep) 1)
                    (eq (fkfne-prep-pretokenized? prep) 0)
                    (eq (fkfne-prep-model-requested? prep) 1)
                    (eq (frex-result-native-code-generated? result) 1)
                    (eq (frex-result-executed? result) 1)
                    (eq (frex-result-model-executed? result) 0)
                    (eq (frex-result-value-present? result) 1)
                    (eq (fkfnb-capture-carrier-released?
                        (head captures)) 1)))
                    (fkfnbb-flags-valid? (tail captures)) 0))))
    (defn fkfnbb-bytes-retained? (captures)
        (if (nil? captures) 1
            (do
                (let c (head captures))
                (let s (fkfnb-capture-schedule c))
                (if (fkfnb-all? (list
                    (str_eq (fkfnb-capture-raw c)
                        (fkfne-binding-query (fkfnb-schedule-binding s)))
                    (str_eq (fkfnb-capture-typed c)
                        (frex-render (fkfnb-capture-result c)))
                    (str_eq (fkfnb-capture-ack c) (fkfnb-ack s))
                    (str_eq (fkfnb-capture-ack-sha c)
                        (nmfe-sha256 (fkfnb-capture-ack c)))))
                    (fkfnbb-bytes-retained? (tail captures)) 0))))
    (defn fkfnbb-distinct-rows? (rows run-ids receipt-ids)
        (if (nil? rows) 1
            (do
                (let check (fkfnb-row-check (head rows)))
                (let run-id (fkfne-check-run-id check))
                (let receipt-id
                    (fkpfm-receipt-sha (fkfne-check-receipt check)))
                (if (or (eq (fkfnb-string-in? run-id run-ids) 1)
                        (eq (fkfnb-string-in? receipt-id receipt-ids) 1)) 0
                    (fkfnbb-distinct-rows? (tail rows)
                        (cons run-id run-ids)
                        (cons receipt-id receipt-ids))))))
    (defn fkfnbb-replace-first (values replacement)
        (if (nil? values) values (cons replacement (tail values))))
    (defn fkfnbb-replay-first-as-second (values)
        (if (lt (len values) 2) values
            (cons (head values) (cons (head values) (tail (tail values))))))
    (defn fkfnbb-swap-first-two (values)
        (if (lt (len values) 2) values
            (cons (head (tail values))
                (cons (head values) (tail (tail values))))))
    (defn fkfnbb-capture-like
        (capture schedule raw prep result typed ack ack-sha residence same
         released capture-sha)
        (fkfnb-capture-record schedule raw prep result typed ack ack-sha
            residence same released capture-sha))
    (defn fkfnbb-ledger-with-rows (ledger rows)
        (do
            (let batch-id (fkfnb-ledger-batch-id ledger))
            (let model-id (fkfnb-ledger-model-id ledger))
            (let residence-id (fkfnb-ledger-residence-id ledger))
            (let opens (fkfnb-ledger-open-count ledger))
            (let remote (fkfnb-ledger-remote-calls ledger))
            (let released (fkfnb-ledger-context-release? ledger))
            (let schedule (fkfnb-ledger-schedule ledger))
            (let captures (fkfnb-ledger-captures ledger))
            (fkfnb-ledger-record batch-id model-id residence-id opens remote
                released schedule captures rows
                (nmfe-sha256 (fkfnb-ledger-message batch-id model-id
                    residence-id opens remote released schedule captures rows)))))
    (defn fkfnbb-ledger-with-model (ledger model-id)
        (do
            (let batch-id (fkfnb-ledger-batch-id ledger))
            (let residence-id (fkfnb-ledger-residence-id ledger))
            (let opens (fkfnb-ledger-open-count ledger))
            (let remote (fkfnb-ledger-remote-calls ledger))
            (let released (fkfnb-ledger-context-release? ledger))
            (let schedule (fkfnb-ledger-schedule ledger))
            (let captures (fkfnb-ledger-captures ledger))
            (let rows (fkfnb-ledger-rows ledger))
            (fkfnb-ledger-record batch-id model-id residence-id opens remote
                released schedule captures rows
                (nmfe-sha256 (fkfnb-ledger-message batch-id model-id
                    residence-id opens remote released schedule captures rows)))))
    (defn fkfnbb-check-with-receipt (check receipt)
        (fkfne-check-row (fkfne-check-status check)
            (fkfne-check-reason check) (fkfne-check-binding check)
            (fkfne-check-prep check) (fkfne-check-result check)
            (fkfne-check-typed check) (fkfne-check-output-sha check)
            (fkfne-check-evidence check) receipt
            (fkfne-check-raw-query check) (fkfne-check-model-id check)
            (fkfne-check-run-id check) (fkfne-check-remote-calls check)
            (fkfne-check-release-ok? check)))
    (defn fkfnbb-result-with-flags (result executed model native)
        (frex-result-with-flags (frex-result-status result)
            (frex-result-reason result) (frex-result-request result)
            (frex-result-carrier result) (frex-result-value result)
            (frex-result-value-present? result) (frex-result-trace result)
            (frex-result-attempts result) executed model native))

    (defn form-knowledge-family-native-exec-resident-batch-band ()
        (do
            (let batch-id (fkfnbb-id "batch"))
            (let other-batch-id (fkfnbb-id "other-batch"))
            (let residence-id (fkfnbb-id "residence"))
            (let other-residence-id (fkfnbb-id "other-residence"))
            (let model-id "synthetic-local-qwen-one-residence")
            (let schedule (fkfnb-build-schedule batch-id))
            (let captures (fkfnbb-captures schedule residence-id))
            (let ledger (fkfnb-ledger batch-id model-id residence-id
                                      1 0 1 schedule captures))
            (let rows (fkfnb-ledger-rows ledger))
            (let first-schedule (head schedule))
            (let second-schedule (head (tail schedule)))
            (let last-schedule (nth schedule (sub (len schedule) 1)))
            (let first-capture (head captures))
            (let second-capture (head (tail captures)))
            (let first-row (head rows))
            (let second-row (head (tail rows)))
            (let first-check (fkfnb-row-check first-row))
            (let second-check (fkfnb-row-check second-row))
            (let first-result (fkfnb-capture-result first-capture))
            (let first-prep (fkfnb-capture-prep first-capture))
            (let first-binding (fkfnb-schedule-binding first-schedule))
            (let first-request (fkfne-prep-request first-prep))
            (let zero-result (frex-choice first-request
                (list (frex-offer "metal" "value" 0 "zero"))))
            (let nothing-result (frex-choice first-request
                (list (frex-offer "metal" "nothing" 0 "absent"))))
            (let failure-result (frex-choice first-request
                (list (frex-offer "metal" "failure" 0
                    "carrier-failure"))))
            (let timeout-result (frex-choice first-request
                (list (frex-offer "metal" "timeout" 0
                    "carrier-timeout"))))

            (let raw-sub-capture (fkfnbb-capture-like first-capture
                first-schedule
                (str_concat (fkfnb-capture-raw first-capture) "\n")
                first-prep first-result (fkfnb-capture-typed first-capture)
                (fkfnb-capture-ack first-capture)
                (fkfnb-capture-ack-sha first-capture) residence-id 1 1
                (fkfnb-capture-sha first-capture)))
            (let typed-swap-capture (fkfnbb-capture-like first-capture
                first-schedule (fkfnb-capture-raw first-capture) first-prep
                first-result (fkfnb-capture-typed second-capture)
                (fkfnb-capture-ack first-capture)
                (fkfnb-capture-ack-sha first-capture) residence-id 1 1
                (fkfnb-capture-sha first-capture)))
            (let ack-sub-capture (fkfnbb-capture-like first-capture
                first-schedule (fkfnb-capture-raw first-capture) first-prep
                first-result (fkfnb-capture-typed first-capture)
                (str_concat (fkfnb-capture-ack first-capture) "x")
                (fkfnb-capture-ack-sha first-capture) residence-id 1 1
                (fkfnb-capture-sha first-capture)))
            (let residence-swap-capture (fkfnbb-capture-like first-capture
                first-schedule (fkfnb-capture-raw first-capture) first-prep
                first-result (fkfnb-capture-typed first-capture)
                (fkfnb-capture-ack first-capture)
                (fkfnb-capture-ack-sha first-capture) other-residence-id 1 1
                (fkfnb-capture-sha first-capture)))
            (let carrier-open-capture (fkfnbb-capture-like first-capture
                first-schedule (fkfnb-capture-raw first-capture) first-prep
                first-result (fkfnb-capture-typed first-capture)
                (fkfnb-capture-ack first-capture)
                (fkfnb-capture-ack-sha first-capture) residence-id 1 0
                (fkfnb-capture-sha first-capture)))
            (let bad-flags-capture (fkfnbb-capture-like first-capture
                first-schedule (fkfnb-capture-raw first-capture) first-prep
                (fkfnbb-result-with-flags first-result 0 1 0)
                (fkfnb-capture-typed first-capture)
                (fkfnb-capture-ack first-capture)
                (fkfnb-capture-ack-sha first-capture) residence-id 1 1
                (fkfnb-capture-sha first-capture)))

            (let wrong-source-binding
                (fkfne-binding (fkfnb-schedule-family first-schedule)
                    "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
                    (fkfne-binding-challenge-sha first-binding)
                    (fkfne-binding-recipe first-binding)
                    (fkfne-binding-input first-binding) "metal"))
            (let wrong-challenge-binding
                (fkfne-binding (fkfnb-schedule-family first-schedule)
                    (fkfne-binding-source-sha first-binding)
                    "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
                    (fkfne-binding-recipe first-binding)
                    (fkfne-binding-input first-binding) "metal"))
            (let cross-binding (fkfnb-schedule-binding second-schedule))
            (let cross-schedule (fkfnb-schedule-row-record batch-id 1
                (fkfnb-schedule-family first-schedule) cross-binding
                (fkfne-teach-frame cross-binding)
                (nmfe-sha256 (fkfne-teach-frame cross-binding))
                (fkfnb-run-id batch-id 1
                    (fkfnb-schedule-family first-schedule) cross-binding)))
            (let replay-run-schedule (fkfnb-schedule-row-record batch-id 1
                (fkfnb-schedule-family first-schedule) first-binding
                (fkfnb-schedule-teach first-schedule)
                (fkfnb-schedule-teach-sha first-schedule)
                (fkfnb-schedule-run-id second-schedule)))
            (let other-batch-schedule
                (fkfnb-build-schedule other-batch-id))

            (let check-swap-row (fkfnb-row-record first-capture second-check
                (fkfnb-row-sha first-row)))
            (let receipt-swap-check (fkfnbb-check-with-receipt first-check
                (fkfne-check-receipt second-check)))
            (let receipt-swap-row (fkfnb-row-record first-capture
                receipt-swap-check (fkfnb-row-sha first-row)))

            (sum (list
                (fkfnbb-bit (and (gt (fkfnb-family-count) 0)
                    (and (eq (fkfnb-family-count) (fkpfm-family-total))
                         (eq (len schedule) (fkfnb-family-count)))) 1)
                (fkfnbb-bit (eq (fkfnb-schedule-valid?
                    schedule batch-id) 1) 2)
                (fkfnbb-bit (and
                    (not (str_eq (fkfnb-binding-run-key first-schedule)
                                 (fkfnb-binding-run-key second-schedule)))
                    (not (str_eq (fkfnb-schedule-run-id first-schedule)
                                 (fkfnb-schedule-run-id last-schedule)))) 4)
                (fkfnbb-bit (and (eq (len captures) (fkfnb-family-count))
                    (eq (fkfnbb-captures-valid? captures) 1)) 8)
                (fkfnbb-bit (eq (fkfnb-ledger-valid? ledger) 1) 16)
                (fkfnbb-bit (and (eq (len rows) (fkfnb-family-count))
                    (eq (fkfnbb-rows-valid? rows model-id residence-id) 1)) 32)
                (fkfnbb-bit (and (eq (fkfnb-ledger-open-count ledger) 1)
                    (and (eq (fkfnb-ledger-remote-calls ledger) 0)
                    (and (eq (fkfnb-ledger-context-release? ledger) 1)
                         (str_eq (fkfnb-capture-residence first-capture)
                                 residence-id)))) 64)
                (fkfnbb-bit (eq (fkfnbb-flags-valid? captures) 1) 128)
                (fkfnbb-bit (and
                    (eq (frex-result-native-code-generated? first-result) 1)
                    (and (eq (frex-result-executed? first-result) 1)
                         (eq (frex-result-model-executed? first-result) 0))) 256)
                (fkfnbb-bit (eq (fkfnbb-bytes-retained? captures) 1) 512)
                (fkfnbb-bit (eq (fkfnbb-distinct-rows?
                    rows (list) (list)) 1) 1024)
                (fkfnbb-bit (and
                    (eq (fkfne-binding-input first-binding) -3)
                    (and (eq (frex-result-value
                        (fkfnb-capture-result second-capture)) 1)
                         (eq (fkfne-binding-input
                            (fkfnb-schedule-binding last-schedule)) 11))) 2048)
                (fkfnbb-bit (and
                    (str_eq (fkfnb-result-signal-kind nothing-result) "nothing")
                    (and (str_eq (fkfnb-result-signal-kind zero-result) "zero")
                    (and (str_eq (fkfnb-result-signal-kind
                            (fkfnb-capture-result second-capture)) "one")
                    (and (str_eq (fkfnb-result-signal-kind failure-result)
                                 "failure")
                    (and (str_eq (fkfnb-result-signal-kind timeout-result)
                                 "timeout")
                    (and (eq (frex-trace-has?
                            (frex-result-trace failure-result) "undo") 1)
                         (eq (frex-trace-has?
                            (frex-result-trace timeout-result) "cut") 1))))))) 4096)
                (fkfnbb-bit (eq (fkfnb-ledger-valid?
                    (fkfnb-ledger batch-id model-id residence-id 1 0 1 schedule
                        (fkfnbb-replace-first captures raw-sub-capture))) 0) 8192)
                (fkfnbb-bit (and (eq (fkfne-binding-valid?
                    wrong-source-binding) 0)
                    (eq (fkfnb-schedule-valid?
                        (fkfnbb-replace-first schedule
                            (fkfnb-schedule-row-record batch-id 1
                                (fkfnb-schedule-family first-schedule)
                                wrong-source-binding "" (nmfe-sha256 "")
                                (fkfnb-schedule-run-id first-schedule)))
                        batch-id) 0)) 16384)
                (fkfnbb-bit (and (eq (fkfne-binding-valid?
                    wrong-challenge-binding) 0)
                    (eq (fkfnb-schedule-row-valid?
                        (fkfnb-schedule-row-record batch-id 1
                            (fkfnb-schedule-family first-schedule)
                            wrong-challenge-binding "" (nmfe-sha256 "")
                            (fkfnb-schedule-run-id first-schedule))
                        (fkfnb-families)) 0)) 32768)
                (fkfnbb-bit (eq (fkfnb-schedule-row-valid?
                    cross-schedule (fkfnb-families)) 0) 65536)
                (fkfnbb-bit (eq (fkfnb-schedule-row-valid?
                    replay-run-schedule (fkfnb-families)) 0) 131072)
                (fkfnbb-bit (and (eq (fkfnb-schedule-valid?
                    (fkfnbb-swap-first-two schedule) batch-id) 0)
                    (eq (fkfnb-schedule-valid?
                        other-batch-schedule batch-id) 0)) 262144)
                (fkfnbb-bit (eq (fkfnb-ledger-valid?
                    (fkfnb-ledger batch-id model-id residence-id 1 0 1 schedule
                        (fkfnbb-replay-first-as-second captures))) 0) 524288)
                (fkfnbb-bit (eq (fkfnb-ledger-valid?
                    (fkfnbb-ledger-with-rows ledger
                        (fkfnbb-replace-first rows check-swap-row))) 0) 1048576)
                (fkfnbb-bit (eq (fkfnb-ledger-valid?
                    (fkfnbb-ledger-with-rows ledger
                        (fkfnbb-replace-first rows receipt-swap-row))) 0) 2097152)
                (fkfnbb-bit (eq (fkfnb-ledger-valid?
                    (fkfnb-ledger batch-id model-id residence-id 1 0 1 schedule
                        (fkfnbb-replace-first captures typed-swap-capture))) 0)
                    4194304)
                (fkfnbb-bit (eq (fkfnb-ledger-valid?
                    (fkfnb-ledger batch-id model-id residence-id 1 0 1 schedule
                        (fkfnbb-replace-first captures ack-sub-capture))) 0)
                    8388608)
                (fkfnbb-bit (eq (fkfnb-ledger-valid?
                    (fkfnb-ledger batch-id model-id residence-id 1 0 1 schedule
                        (fkfnbb-replace-first captures residence-swap-capture))) 0)
                    16777216)
                (fkfnbb-bit (and (eq (fkfnb-ledger-valid?
                    (fkfnb-ledger batch-id model-id residence-id 2 0 1
                        schedule captures)) 0)
                    (eq (fkfnb-ledger-valid?
                        (fkfnbb-ledger-with-model ledger "replayed-model")) 0))
                    33554432)
                (fkfnbb-bit (eq (fkfnb-ledger-valid?
                    (fkfnb-ledger batch-id model-id residence-id 1 1 1
                        schedule captures)) 0) 67108864)
                (fkfnbb-bit (eq (fkfnb-ledger-valid?
                    (fkfnb-ledger batch-id model-id residence-id 1 0 0
                        schedule captures)) 0) 134217728)
                (fkfnbb-bit (eq (fkfnb-ledger-valid?
                    (fkfnb-ledger batch-id model-id residence-id 1 0 1 schedule
                        (fkfnbb-replace-first captures carrier-open-capture))) 0)
                    268435456)
                (fkfnbb-bit (and (eq (fkfnb-ledger-valid?
                    (fkfnb-ledger batch-id model-id residence-id 1 0 1 schedule
                        (fkfnbb-replace-first captures bad-flags-capture))) 0)
                    (and (eq (fkfnb-ledger-valid? (nothing)) 0)
                    (and (eq (fkfnb-ledger-valid? 0) 0)
                         (eq (fkfnb-ledger-valid? 1) 0)))) 536870912)))))

    (form-knowledge-family-native-exec-resident-batch-band))
