; form-cli-cell-mesh-band — a sovereign, observable two-cell channel.
;
; Verdict 262143: shared core-grounded observer, consensual opening, bounded
; symbol/evaluator streaming, observable refusal, observer-only grammar and
; protocol revision, and a command-shaped form-cli demonstration.
; witnessed: 2026-09-04 -> 262143
; preludes: form-stdlib/form-cli.fk
(do
    (defn fcmb-bit (condition bit) (if condition bit 0))
    (let left (fcm-cell "cell-a" "shared-observer" "core-field"))
    (let right (fcm-cell "cell-b" "shared-observer" "core-field"))
    (let observer (fcm-observer "shared-observer" "core-field" (the-core)))
    (let grammar-1 (fcm-grammar "mesh-grammar" 1 (list "offer" "receipt") (list "identity" "count")))
    (let protocol-1 (fcm-protocol "mesh-protocol" 1 "mesh-grammar" 1))
    (let opened (fcm-open "mesh-band" left right observer grammar-1 protocol-1))
    (let channel-0 (fcm-transition-channel opened))
    (let sent-identity (fcm-send channel-0 "cell-a" "identity" (list "offer" "receipt")))
    (let channel-1 (fcm-transition-channel sent-identity))
    (let sent-count (fcm-send channel-1 "cell-b" "count" (list "offer" "receipt")))
    (let channel-2 (fcm-transition-channel sent-count))
    (let denied-symbol (fcm-send channel-2 "cell-a" "identity" (list "unoffered")))
    (let channel-3 (fcm-transition-channel denied-symbol))
    (let denied-proposer (fcm-adapt channel-3 "cell-a" "core-field" (fcm-grammar "mesh-grammar" 2 (list "offer" "receipt" "reflection") (list "identity" "count" "join")) (fcm-protocol "mesh-protocol" 2 "mesh-grammar" 2)))
    (let channel-4 (fcm-transition-channel denied-proposer))
    (let denied-field (fcm-adapt channel-4 "shared-observer" "another-field" (fcm-grammar "mesh-grammar" 2 (list "offer" "receipt" "reflection") (list "identity" "count" "join")) (fcm-protocol "mesh-protocol" 2 "mesh-grammar" 2)))
    (let channel-5 (fcm-transition-channel denied-field))
    (let denied-stale (fcm-adapt channel-5 "shared-observer" "core-field" grammar-1 protocol-1))
    (let channel-6 (fcm-transition-channel denied-stale))
    (let denied-mismatch (fcm-adapt channel-6 "shared-observer" "core-field" (fcm-grammar "mesh-grammar" 2 (list "offer" "receipt" "reflection") (list "identity" "count" "join")) (fcm-protocol "mesh-protocol" 2 "mesh-grammar" 1)))
    (let channel-7 (fcm-transition-channel denied-mismatch))
    (let grammar-2 (fcm-grammar "mesh-grammar" 2 (list "offer" "receipt" "reflection") (list "identity" "count" "join")))
    (let protocol-2 (fcm-protocol "mesh-protocol" 2 "mesh-grammar" 2))
    (let adapted (fcm-adapt channel-7 "shared-observer" "core-field" grammar-2 protocol-2))
    (let channel-8 (fcm-transition-channel adapted))
    (let sent-join (fcm-send channel-8 "cell-b" "join" (list "reflection" "offer")))
    (let channel-9 (fcm-transition-channel sent-join))
    (let denied-primitive (fcm-send channel-9 "cell-a" "head" (list "offer")))
    (sum (list
        (fcmb-bit (eq (fcm-observer-trusted? observer) 1) 1)
        (fcmb-bit (eq (fcm-shared-observer? left right observer) 1) 2)
        (fcmb-bit (eq (fcm-grammar-valid? grammar-1) 1) 4)
        (fcmb-bit (eq (fcm-accepted? opened) 1) 8)
        (fcmb-bit (str_eq (fcm-event-kind (fcm-transition-event opened)) "open") 16)
        (fcmb-bit (and (eq (fcm-accepted? sent-identity) 1) (str_eq (head (fcm-transition-value sent-identity)) "offer")) 32)
        (fcmb-bit (and (eq (fcm-accepted? sent-count) 1) (str_eq (head (fcm-transition-value sent-count)) "2")) 64)
        (fcmb-bit (and (eq (fcm-accepted? denied-symbol) 0) (str_eq (fcm-transition-value denied-symbol) "symbol-not-admitted")) 128)
        (fcmb-bit (eq (fcm-grammar-revision (fcm-channel-grammar channel-3)) 1) 256)
        (fcmb-bit (str_eq (fcm-transition-value denied-proposer) "proposal-not-from-shared-observer") 512)
        (fcmb-bit (str_eq (fcm-transition-value denied-field) "proposal-not-from-shared-field") 1024)
        (fcmb-bit (str_eq (fcm-transition-value denied-stale) "grammar-revision-not-next") 2048)
        (fcmb-bit (str_eq (fcm-transition-value denied-mismatch) "protocol-does-not-name-grammar") 4096)
        (fcmb-bit (eq (fcm-accepted? adapted) 1) 8192)
        (fcmb-bit (and (eq (fcm-grammar-revision (fcm-channel-grammar channel-8)) 2) (eq (fcm-protocol-revision (fcm-channel-protocol channel-8)) 2)) 16384)
        (fcmb-bit (and (eq (fcm-accepted? sent-join) 1) (str_eq (head (fcm-transition-value sent-join)) "reflection,offer")) 32768)
        (fcmb-bit (and (eq (fcm-accepted? denied-primitive) 0) (str_eq (fcm-transition-value denied-primitive) "primitive-not-admitted")) 65536)
        (fcmb-bit (str_eq (fc-respond "mesh-demo") "mesh-demo events=3") 131072))))
