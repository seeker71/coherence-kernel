; kernel-census-band.fk — the body counts its roots, its floats, and where its own nodes live.
;
; Urs, reading the living glass: "all the roots and float values have flow gaps as well as
; nodes in gas (RAM) state seems to be a gap." The seed held every one of these numbers and
; published none of them. This band walks the arithmetic of the doors that now do.
;
; fkwu-native: kernel_stat is a fkwu-only door (the three proof siblings carry none of these
; C cells), so there is no fourth arm to run and none is claimed.
;
; NOT pure: it interns attributed nodes, so it writes the shared field the same way every run
; does. Bounded to a few thousand cells, all under one blueprint of its own name.
;
; Expected: 2047
; preludes: form-stdlib/form-glass-live.bml

(do
    (defn kc-bit (ok bit) (if ok bit 0))
    (defn kc-find (rows id) (if (eq (len rows) 0) (list) (if (str_eq (fgo-id (head rows)) id) (head rows) (kc-find (tail rows) id))))
    (defn kc-value (rows id) (fgo-int-value (kc-find rows id)))
    (defn kc-present (rows id) (gt (len (kc-find rows id)) 0))
    (defn kc-mint (i n cat)
        (if (gt i n) 0
            (do
                (intern_node_at cat (list (mul i 7)) "kernel-census-band.fk" 5 (mod i 48))
                (kc-mint (add i 1) n cat))))
    (defn kc-burn (n acc) (if (le n 0) acc (kc-burn (sub n 1) (add acc (div 3.5 (add n 11))))))
    (defn kc-all-say-zero (rows ids)
        (if (eq (len ids) 0) 1
            (if (kc-zero-said rows (head ids)) (kc-all-say-zero rows (tail ids)) 0)))
    ; a lane at zero must say WHICH zero: either it carries a count above zero, or its note
    ; opens with the body's own semantic-zero mark. A bare 0 with no sentence is the gap.
    (defn kc-zero-said (rows id)
        (do
            (let r (kc-find rows id))
            (if (eq (len r) 0) 0
                (if (gt (fgo-int-value r) 0) 1
                    (ge (str_find (fgo-note r) "semantic-zero=" 0) 0)))))
    (defn kc-all-sourced (rows ids)
        (if (eq (len ids) 0) 1
            (if (and (kc-present rows (head ids))
                     (and (gt (str_len (fgo-source (kc-find rows (head ids)))) 0)
                          (gt (str_len (fgo-lifecycle (kc-find rows (head ids)))) 0)))
                (kc-all-sourced rows (tail ids)) 0)))

    ; ── the node census: exactly one home carries the whole population ──────────────
    (let nodes0 (kernel_stat 4))
    (let gas0 (kernel_stat 58))
    (let water0 (kernel_stat 59))
    (let ice0 (kernel_stat 60))
    (let b1 (kc-bit (eq (add gas0 (add water0 ice0)) nodes0) 1))

    ; the tissue's extent is exact: 104 bytes over the ten interned columns, a node
    (let b2 (kc-bit (eq (kernel_stat 61) (mul nodes0 104)) 2))

    ; and a body whose every node is ice still pays private RAM to reach it
    (let b3 (kc-bit (gt (kernel_stat 62) 0) 4))

    ; ── the root ring is a window, and it says so ──────────────────────────────────
    (let ring (kernel_stat 55))
    (let rec0 (kernel_stat 9))
    (let std0 (kernel_stat 54))
    (let b4 (kc-bit (and (eq ring 2048) (eq std0 (if (lt rec0 ring) rec0 ring))) 8))

    ; ── minting moves recorded, entered and accepted together ──────────────────────
    (let cat (bp "kernel-census-band-root"))
    (let ent0 (kernel_stat 12))
    (let acc0 (kernel_stat 13))
    (let mint0 (kernel_stat 53))
    (let m1 (kc-mint 1 1000 cat))
    (let b5 (kc-bit (and (eq (kernel_stat 9) (add rec0 1000))
                    (and (eq (kernel_stat 12) (add ent0 1000))
                         (eq (kernel_stat 13) (add acc0 1000)))) 16))

    ; ── past the window, the loss is a number nobody had before ────────────────────
    (let m2 (kc-mint 1001 3200 cat))
    (let rec2 (kernel_stat 9))
    (let std2 (kernel_stat 54))
    (let b6 (kc-bit (and (eq std2 ring) (and (gt rec2 ring) (gt (sub rec2 std2) 0))) 32))

    ; ── a refusal is counted where it was silent ───────────────────────────────────
    (let ent2 (kernel_stat 12))
    (let acc2 (kernel_stat 13))
    (let ref2 (kernel_stat 11))
    (let rec3 (kernel_stat 9))
    (let bad (fb_record 7 "kernel-census-band.fk" 0))
    (let b7 (kc-bit (and (eq (kernel_stat 11) (add ref2 1))
                    (and (eq (kernel_stat 12) (add ent2 1))
                    (and (eq (kernel_stat 13) acc2)
                         (eq (kernel_stat 9) rec3)))) 64))

    ; ── the float pool: the fill IS the mint count, and the capacity is above it ───
    (let fill0 (kernel_stat 8))
    (let burned (kc-burn 4000 0.0))
    (let fill1 (kernel_stat 8))
    (let b8 (kc-bit (and (gt fill1 fill0)
                    (and (eq fill1 (kernel_stat 45))
                         (le fill1 (kernel_stat 56)))) 128))

    ; ── the census moved with the minting, in its own home and nowhere else ────────
    ; 3200 attributed interns do NOT mean 3200 mints: the body is content-addressed and the
    ; field outlives the run, so a cell this band already interned is found, not minted.
    ; What holds warm or cold is that the population grew by at least what THIS kernel
    ; minted -- at least, because the field is shared and a sibling kernel may mint into it
    ; while this band runs -- and that the census and the extent stay exact across the move.
    (let minted (sub (kernel_stat 53) mint0))
    (let b9 (kc-bit (and (ge (sub (kernel_stat 4) nodes0) minted)
                    (and (eq (add (kernel_stat 58) (add (kernel_stat 59) (kernel_stat 60))) (kernel_stat 4))
                         (eq (kernel_stat 61) (mul (kernel_stat 4) 104)))) 256))

    ; ── the glass paints every one of them, each with its door and its state ───────
    (let rows (fgl-kernel-rows))
    (let ids (list "roots-standing" "roots-recorded" "roots-dropped" "attributions-entered"
                   "attributions-refused" "float-values" "field-float-values"
                   "nodes-gas" "nodes-water" "nodes-ice" "node-arena-bytes" "node-private-bytes"))
    (let b10 (kc-bit (kc-all-sourced rows ids) 512))

    ; ── and a lane at zero says which zero it is ───────────────────────────────────
    (let b11 (kc-bit (and (kc-all-say-zero rows (list "nodes-gas" "nodes-water" "nodes-ice" "field-float-values"))
                          (eq (kc-value rows "roots-dropped") (sub (kc-value rows "roots-recorded") (kc-value rows "roots-standing")))) 1024))

    (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 (add b9 (add b10 b11)))))))))))
