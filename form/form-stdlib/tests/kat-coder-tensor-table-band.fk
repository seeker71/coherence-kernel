; kat-coder-tensor-table-band.fk — the header read agrees with itself, agrees
; with the two cells already built against other sources, and does not hide the
; quantization this body cannot decode.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/equireach-gguf.fk form-stdlib/gated-deltanet-conv.fk form-stdlib/kat-coder-tensor-table.fk
;
; run: ./fkwu --src form/form-stdlib/tests/kat-coder-tensor-table-band.fk   ; -> 255 with the file present, 127 without
;
; Verdict 255 when the 17.39 GB file is readable; 127 when it is not, and bit
; 128 dark IS the report that the live witness could not be taken.
;
; Bit 8 is the one this cell exists for: it asserts the gap is REPORTED, not
; that it is absent. A band that only ever went green on full coverage would
; have to be edited to admit a gap, and an inconvenient truth that requires
; editing a test to state is a truth that gets deferred. So the honest shape is
; a band that stays green while naming exactly what is missing, and goes dark if
; someone quietly marks Q3_K covered without a decoder behind it.

(do
    (defn kctb-score (ok bit) (if ok bit 0))

    (defn kat-coder-tensor-table-band ()
        (do
    ; the census accounts for every tensor the header declares — no rounding,
    ; no "and some others"
    (let c0 (kctb-score (eq (kct-total) (kct-tensor-count)) 1))
    ; the tensor infos sit inside the window that was actually fetched
    (let c1 (kctb-score (lt (kct-tensor-infos-at) 25165824) 2))
    ; THE STRUCTURAL CONFIRMATION: the conv's channel count is the qkv width,
    ; so the conv runs over the CONCATENATION. gated-deltanet-layer.fk built it
    ; that way from the reference implementation; the loader's own tensor shapes
    ; are an independent witness of the same fact.
    (let c2 (kctb-score (eq (kct-conv-over-concat?) 1) 4))
    ; THE GAP IS NAMED: exactly one quantization is uncovered, and it accounts
    ; for 94 tensors. Marking Q3_K covered without a decoder darkens this.
    (let c3 (kctb-score (if (eq (kct-gap-kinds) 1)
                            (eq (kct-uncovered-tensors) 94) 0) 8))
    ; the grouping the header implies is the grouping read from config.json:
    ; 4096/128 = 32 value heads over 16 key groups, 2:1
    (let c4 (kctb-score (if (eq (kct-value-heads) 32)
                            (if (eq (kct-group-ratio) 2)
                                (eq (kct-ssm-group-count) (gdc-num-key-heads)) 0) 0) 16))
    ; the conv width the header declares is the width gated-deltanet-conv.fk
    ; convolves — two sources, one number
    (let c5 (kctb-score (eq (kct-ssm-conv-kernel) (gdc-conv-k)) 32))
    ; the router shape: 256 experts, 8 used, and the state size matches the key
    ; head dim the linear-attention cells were built at
    (let c6 (kctb-score (if (eq (kct-expert-count) 256)
                            (if (eq (kct-expert-used) 8)
                                (eq (kct-ssm-state-size) (gdc-key-head-dim)) 0) 0) 64))
    ; THE LIVE READ. When the 17.39 GB file is present, this body walks its own
    ; way to the tensor table — past 50 KV pairs including arrays of 248 320 and
    ; 247 587 strings — and re-derives the whole census. The record above entered
    ; as literals from a throwaway parse; this bit is what retires that parse.
    ; When the file is absent every live reader returns 0 and this bit is dark,
    ; which is the honest state: a witness that could not be taken is not a
    ; witness that agreed.
    (let c7 (kctb-score (if (eq (kct-present?) 1)
                            (if (eq (kct-live-version) (kct-gguf-version))
                                (if (eq (kct-live-tensor-count) (kct-tensor-count))
                                    (if (eq (kct-live-tinfo-start) (kct-tensor-infos-at))
                                        (kct-live-agrees?) 0) 0) 0) 0) 128))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
    )
    (kat-coder-tensor-table-band))
