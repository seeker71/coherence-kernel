; loop-lane-str-eq-field-band.fk -- the crystallized str_eq (kind 35) field-string GUARD, across the carrier.
; A child interns "loop-lane-str-eq-field"; this process maps the child's store and reads it back with
; cell_value -- a FIELD string (si >= FK_STR_BASE), its word NOT interned against a local copy of the same
; bytes. A crystallized str_eq loop compares that field string with a LOCAL string of the same bytes: the two
; frame words DIFFER, so without the guard the word-compare would answer 0 (a miscompile); with the guard
; (word <= T -> overflow -> walker byte-walk) it answers 1, as the walker does. This is the carrier crossing
; the guard exists for; the local behaviour and crystallization are pinned in loop-lane-str-eq-band.
;
; Verdict 7
; PROOF LEVEL: FOURTH-ARM ONLY (crystallization is fkwu's MAP_JIT lane)
; preludes: form/form-stdlib/form-glass-gift-frame.bml
;
;   1  the str_eq loop over (field string, local string) crystallizes (state 2)
;   2  a field string vs a local string of the SAME bytes answers equal, warm (the guard's whole purpose)
;   4  it matches a poisoned-walker twin, and a field string vs different bytes answers 0
(do
    (defn sef-bit (ok b) (if ok b 0))
    (defn se (n a b acc) (if (le n 0) acc (se (sub n 1) a b (if (str_eq a b) (add acc 1) acc))))
    (defn sew (n a b acc) (if (lt (host_monotonic_ms) 0) acc (if (le n 0) acc (sew (sub n 1) a b (if (str_eq a b) (add acc 1) acc)))))
    (defn sef-state (name rows) (if (eq (len rows) 0) -99 (if (str_eq (nth (head rows) 1) name) (nth (head rows) 7) (sef-state name (tail rows)))))
    (defn take (tries) (if (le tries 0) (list) (do (let h (ggf-receive "loop-lane-str-eq-field.child")) (let frame (if (nothing? h) (nothing) (node_gift_read h))) (let r (ggf-release h)) (if (nothing? frame) (do (host_sleep_ms 100) (take (sub tries 1))) (if (eq (len frame) 2) frame (do (host_sleep_ms 100) (take (sub tries 1))))))))
    (let stale (ggf-offer "loop-lane-str-eq-field.child" 4096)) (let cs (node_gift_write stale (list))) (let rs (ggf-release stale))
    (let child (host_spawn_quiet (list "./fkwu" "form/form-stdlib/tests/str-eq-field-child.fk")))
    (let frame (take 60))
    (let pid (if (eq (len frame) 2) (nth frame 0) -1))
    (let sref (if (eq (len frame) 2) (nth frame 1) 0))
    (let h (if (gt pid 0) (cell_map pid) (nothing)))
    (let fs (if (nothing? h) "" (cell_value h (cell_field h sref 3))))
    (let ls "loop-lane-str-eq-field")
    (let bytes-ok (str_eq fs ls))
    (let warm (se 40000 fs ls 0))
    (let rows (kernel_page_hot (host_pid) 900))
    (let cryst-ok (eq (sef-state "se" rows) 2))
    (let field-eq-ok (if bytes-ok (eq warm 40000) false))
    (let twin-ok (if (eq warm (sew 40000 fs ls 0)) (eq (se 100 fs "nope-different" 0) 0) false))
    (add (sef-bit cryst-ok 1) (add (sef-bit field-eq-ok 2) (sef-bit twin-ok 4)))
)
