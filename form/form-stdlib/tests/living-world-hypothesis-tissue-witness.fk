; living-world-hypothesis-tissue-witness.fk -- two unequal contexts
; differentiate generated subtraction Recipes, then holders re-offer exact
; prospective applications with independently optional lens and response tissue.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk

(let LWHTW-HISTORY             (bp "LWHTW-HISTORY"))
(let LWHTW-TISSUE-FIXTURE      (bp "LWHTW-TISSUE-FIXTURE"))
(let LWHTW-APPLICATION-FIXTURE (bp "LWHTW-APPLICATION-FIXTURE"))
(let LWHTW-FOCUS               (bp "LWHTW-FOCUS"))
(let LWHTW-EVIDENCE            (bp "LWHTW-EVIDENCE"))
(let LWHTW-ALTERNATIVE         (bp "LWHTW-ALTERNATIVE"))
(let LWHTW-REASON              (bp "LWHTW-REASON"))
(let LWHTW-DIRECTION           (bp "LWHTW-DIRECTION"))
(let LWHTW-LENS-BLUEPRINT      (bp "LWHTW-LENS-BLUEPRINT"))
(let LWHTW-TRAIN-SCOPE         (bp "LWHTW-TRAIN-SCOPE"))
(let LWHTW-TRAIN-LEFT          (bp "LWHTW-TRAIN-LEFT"))
(let LWHTW-TRAIN-RIGHT         (bp "LWHTW-TRAIN-RIGHT"))
(let LWHTW-PROBE-A-SCOPE       (bp "LWHTW-PROBE-A-SCOPE"))
(let LWHTW-PROBE-A-LEFT        (bp "LWHTW-PROBE-A-LEFT"))
(let LWHTW-PROBE-A-RIGHT       (bp "LWHTW-PROBE-A-RIGHT"))
(let LWHTW-PROBE-B-SCOPE       (bp "LWHTW-PROBE-B-SCOPE"))
(let LWHTW-PROBE-B-LEFT        (bp "LWHTW-PROBE-B-LEFT"))
(let LWHTW-PROBE-B-RIGHT       (bp "LWHTW-PROBE-B-RIGHT"))
(let LWHTW-APPLICATION-SCOPE   (bp "LWHTW-APPLICATION-SCOPE"))
(let LWHTW-APPLICATION-LEFT    (bp "LWHTW-APPLICATION-LEFT"))
(let LWHTW-APPLICATION-RIGHT   (bp "LWHTW-APPLICATION-RIGHT"))

(defn lwhtw-cell (kind) (intern_node kind (empty)))
(defn lwhtw-focus () (lwhtw-cell LWHTW-FOCUS))
(defn lwhtw-evidence () (lwhtw-cell LWHTW-EVIDENCE))
(defn lwhtw-alternative () (lwhtw-cell LWHTW-ALTERNATIVE))
(defn lwhtw-reason () (lwhtw-cell LWHTW-REASON))
(defn lwhtw-train-scope () (lwhtw-cell LWHTW-TRAIN-SCOPE))
(defn lwhtw-train-left () (lwhtw-cell LWHTW-TRAIN-LEFT))
(defn lwhtw-train-right () (lwhtw-cell LWHTW-TRAIN-RIGHT))
(defn lwhtw-probe-a-scope () (lwhtw-cell LWHTW-PROBE-A-SCOPE))
(defn lwhtw-probe-a-left () (lwhtw-cell LWHTW-PROBE-A-LEFT))
(defn lwhtw-probe-a-right () (lwhtw-cell LWHTW-PROBE-A-RIGHT))
(defn lwhtw-probe-b-scope () (lwhtw-cell LWHTW-PROBE-B-SCOPE))
(defn lwhtw-probe-b-left () (lwhtw-cell LWHTW-PROBE-B-LEFT))
(defn lwhtw-probe-b-right () (lwhtw-cell LWHTW-PROBE-B-RIGHT))
(defn lwhtw-application-scope ()
    (lwhtw-cell LWHTW-APPLICATION-SCOPE))
(defn lwhtw-application-left ()
    (lwhtw-cell LWHTW-APPLICATION-LEFT))
(defn lwhtw-application-right ()
    (lwhtw-cell LWHTW-APPLICATION-RIGHT))

(defn lwhtw-enquiry ()
    (lwph-enquiry (lwhtw-focus)
        (lwo-field (list (lwhtw-alternative)))
        (lwlc-unknown (lwhtw-evidence)) (lwhtw-evidence)))
(defn lwhtw-sub ()
    (lwph-operator (lwhtw-enquiry) "sub" (lwhtw-evidence)))
(defn lwhtw-projection (scope source value)
    (lwre-projection scope source (intern_trivial_int value)
        (lwo-field (list (lwhtw-alternative)))
        (lwlc-unknown (lwhtw-evidence)) (lwhtw-evidence)))
(defn lwhtw-bindings (left-projection right-projection)
    (lwre-bindings
        (list
            (lwre-projected-binding "left" left-projection
                (lwhtw-evidence))
            (lwre-projected-binding "right" right-projection
                (lwhtw-evidence)))))
(defn lwhtw-binding-left (bindings)
    (nth (lwre-binding-items bindings) 0))
(defn lwhtw-binding-right (bindings)
    (nth (lwre-binding-items bindings) 1))

(defn lwhtw-train-left-projection ()
    (lwhtw-projection
        (lwhtw-train-scope) (lwhtw-train-left) 4))
(defn lwhtw-train-right-projection ()
    (lwhtw-projection
        (lwhtw-train-scope) (lwhtw-train-right) 4))
(defn lwhtw-train-bindings ()
    (lwhtw-bindings
        (lwhtw-train-left-projection)
        (lwhtw-train-right-projection)))
(defn lwhtw-example ()
    (lwph-example (lwhtw-enquiry) (lwhtw-train-bindings)
        (intern_trivial_int 0) (oac-one (intern_trivial_int 0))
        (lwo-field (list (lwhtw-alternative)))
        (lwlc-unknown (lwhtw-evidence)) (lwhtw-evidence)))

(defn lwhtw-training-world ()
    (do
        (let bindings (lwhtw-train-bindings))
        (lwt-receive-stream (lwo-empty-world)
            (list
                (lwphw-entry-a (lwhtw-focus))
                (lwphw-entry-b (lwhtw-focus))
                (lwphw-entry-a (lwhtw-enquiry))
                (lwphw-entry-b (lwhtw-enquiry))
                (lwphw-entry-c (lwhtw-sub))
                (lwphw-entry-d (lwhtw-sub))
                (lwphw-entry-e (lwhtw-train-scope))
                (lwphw-entry-f (lwhtw-train-scope))
                (lwphw-entry-e (lwhtw-train-left))
                (lwphw-entry-f (lwhtw-train-left))
                (lwphw-entry-e (lwhtw-train-right))
                (lwphw-entry-f (lwhtw-train-right))
                (lwphw-entry-e (lwhtw-train-left-projection))
                (lwphw-entry-f (lwhtw-train-left-projection))
                (lwphw-entry-e (lwhtw-train-right-projection))
                (lwphw-entry-f (lwhtw-train-right-projection))
                (lwphw-entry-e (lwhtw-binding-left bindings))
                (lwphw-entry-f (lwhtw-binding-left bindings))
                (lwphw-entry-e (lwhtw-binding-right bindings))
                (lwphw-entry-f (lwhtw-binding-right bindings))
                (lwphw-entry-e (lwhtw-example))
                (lwphw-entry-f (lwhtw-example))))))

(defn lwhtw-integrated-field ()
    (do
        (let world (lwhtw-training-world))
        (let field (lwph-field-for world (lwhtw-enquiry) 2))
        (let proposal (lwph-proposal world (lwhtw-enquiry) 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let answered
            (lwphw-answered-round world proposal (lwo-none)))
        (let integrated
            (lwph-integrate answered proposal (lwphw-action)))
        (lwphw-field-fixture integrated candidate proposal field)))

(defn lwhtw-probe-a-left-projection ()
    (lwhtw-projection
        (lwhtw-probe-a-scope) (lwhtw-probe-a-left) 7))
(defn lwhtw-probe-a-right-projection ()
    (lwhtw-projection
        (lwhtw-probe-a-scope) (lwhtw-probe-a-right) 3))
(defn lwhtw-probe-a-bindings ()
    (lwhtw-bindings
        (lwhtw-probe-a-left-projection)
        (lwhtw-probe-a-right-projection)))
(defn lwhtw-probe-a (field-candidate)
    (lwph-probe field-candidate (lwhtw-probe-a-bindings)
        (intern_trivial_int 4) (oac-one (intern_trivial_int 4))
        (lwo-field (list (lwhtw-alternative)))
        (lwlc-unknown (lwhtw-evidence)) (lwhtw-evidence)))

(defn lwhtw-probe-b-left-projection ()
    (lwhtw-projection
        (lwhtw-probe-b-scope) (lwhtw-probe-b-left) 9))
(defn lwhtw-probe-b-right-projection ()
    (lwhtw-projection
        (lwhtw-probe-b-scope) (lwhtw-probe-b-right) 2))
(defn lwhtw-probe-b-bindings ()
    (lwhtw-bindings
        (lwhtw-probe-b-left-projection)
        (lwhtw-probe-b-right-projection)))
(defn lwhtw-probe-b (field-candidate)
    (lwph-probe field-candidate (lwhtw-probe-b-bindings)
        (intern_trivial_int 7) (oac-one (intern_trivial_int 7))
        (lwo-field (list (lwhtw-alternative)))
        (lwlc-unknown (lwhtw-evidence)) (lwhtw-evidence)))

(defn lwhtw-add-probe-dependencies
    (world scope left right left-projection right-projection bindings
     first-entry second-entry probe first-probe-entry second-probe-entry)
    (lwt-receive-stream world
        (list
            (first-entry scope) (second-entry scope)
            (first-entry left) (second-entry left)
            (first-entry right) (second-entry right)
            (first-entry left-projection) (second-entry left-projection)
            (first-entry right-projection) (second-entry right-projection)
            (first-entry (lwhtw-binding-left bindings))
            (second-entry (lwhtw-binding-left bindings))
            (first-entry (lwhtw-binding-right bindings))
            (second-entry (lwhtw-binding-right bindings))
            (first-probe-entry probe) (second-probe-entry probe))))

(defn lwhtw-probe-a-world (field-fixture)
    (do
        (let candidate (lwphw-field-candidate field-fixture))
        (let bindings (lwhtw-probe-a-bindings))
        (lwhtw-add-probe-dependencies
            (lwt-round-world (lwphw-field-round field-fixture))
            (lwhtw-probe-a-scope) (lwhtw-probe-a-left)
            (lwhtw-probe-a-right) (lwhtw-probe-a-left-projection)
            (lwhtw-probe-a-right-projection) bindings
            lwphw-entry-g lwphw-entry-h (lwhtw-probe-a candidate)
            lwphw-entry-i lwphw-entry-j)))
(defn lwhtw-probe-b-world (world field-candidate)
    (do
        (let bindings (lwhtw-probe-b-bindings))
        (lwhtw-add-probe-dependencies world
            (lwhtw-probe-b-scope) (lwhtw-probe-b-left)
            (lwhtw-probe-b-right) (lwhtw-probe-b-left-projection)
            (lwhtw-probe-b-right-projection) bindings
            lwphw-entry-k lwphw-entry-l (lwhtw-probe-b field-candidate)
            lwphw-entry-m lwphw-entry-n)))

(defn lwhtw-integrate-placement (world probe previous)
    (do
        (let placement (lwph-placement-for world probe 2))
        (let proposal (lwph-probe-proposal world probe 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let answered (lwphw-answered-round world proposal previous))
        (let integrated
            (lwph-probe-integrate answered proposal (lwphw-action)))
        (lwphw-probe-fixture integrated candidate proposal placement probe)))

; children: field fixture, first placement, second placement
(defn lwhtw-history (field first second)
    (intern_node LWHTW-HISTORY (list field first second)))
(defn lwhtw-history-field (history) (nth (node_children history) 0))
(defn lwhtw-history-first (history) (nth (node_children history) 1))
(defn lwhtw-history-second (history) (nth (node_children history) 2))
(defn lwhtw-build-history ()
    (do
        (let field (lwhtw-integrated-field))
        (let field-candidate (lwphw-field-candidate field))
        (let first
            (lwhtw-integrate-placement
                (lwhtw-probe-a-world field)
                (lwhtw-probe-a field-candidate)
                (lwphw-field-round field)))
        (let second-world
            (lwhtw-probe-b-world
                (lwt-round-world (lwphw-probe-round first))
                field-candidate))
        (let second
            (lwhtw-integrate-placement second-world
                (lwhtw-probe-b field-candidate)
                (lwphw-probe-round first)))
        (lwhtw-history field first second)))

; children: integrated round, candidate, proposal, exact tissue, history
(defn lwhtw-tissue-fixture (round candidate proposal tissue history)
    (intern_node LWHTW-TISSUE-FIXTURE
        (list round candidate proposal tissue history)))
(defn lwhtw-tissue-round (fixture) (nth (node_children fixture) 0))
(defn lwhtw-tissue-candidate (fixture) (nth (node_children fixture) 1))
(defn lwhtw-tissue-proposal (fixture) (nth (node_children fixture) 2))
(defn lwhtw-tissue-shape (fixture) (nth (node_children fixture) 3))
(defn lwhtw-tissue-history (fixture) (nth (node_children fixture) 4))
(defn lwhtw-integrated-tissue ()
    (do
        (let history (lwhtw-build-history))
        (let field (lwhtw-history-field history))
        (let field-candidate (lwphw-field-candidate field))
        (let world
            (lwt-round-world
                (lwphw-probe-round (lwhtw-history-second history))))
        (let tissue (lwht-tissue-for world field-candidate 2))
        (let proposal (lwht-proposal world field-candidate 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let answered
            (lwphw-answered-round world proposal
                (lwphw-probe-round (lwhtw-history-second history))))
        (let integrated
            (lwht-integrate answered proposal (lwphw-action)))
        (lwhtw-tissue-fixture integrated candidate proposal tissue history)))

(defn lwhtw-hypothesis-by-source (items source)
    (if (eq (len items) 0) (lwo-none)
        (if (str_eq
                (lwre-recipe-source
                    (lwph-hypothesis-recipe (head items))) source)
            (head items)
            (lwhtw-hypothesis-by-source (tail items) source))))
(defn lwhtw-forward-hypothesis (tissue-fixture)
    (lwhtw-hypothesis-by-source
        (lwo-field-items
            (lwph-field-consistent
                (lwphw-field-shape
                    (lwhtw-history-field
                        (lwhtw-tissue-history tissue-fixture)))))
        "(sub left right)"))
(defn lwhtw-reverse-hypothesis (tissue-fixture)
    (lwhtw-hypothesis-by-source
        (lwo-field-items
            (lwph-field-consistent
                (lwphw-field-shape
                    (lwhtw-history-field
                        (lwhtw-tissue-history tissue-fixture)))))
        "(sub right left)"))

(defn lwhtw-application-left-projection ()
    (lwhtw-projection
        (lwhtw-application-scope) (lwhtw-application-left) 12))
(defn lwhtw-application-right-projection ()
    (lwhtw-projection
        (lwhtw-application-scope) (lwhtw-application-right) 5))
(defn lwhtw-application-bindings ()
    (lwhtw-bindings
        (lwhtw-application-left-projection)
        (lwhtw-application-right-projection)))
(defn lwhtw-before () (intern_trivial_int 0))

(defn lwhtw-blueprint-lens ()
    (lwlc-lens (lwlc-blueprint-shape)
        (lwhtw-cell LWHTW-LENS-BLUEPRINT) (lwhtw-evidence)))
(defn lwhtw-recipe-lens (tissue-fixture)
    (lwlc-lens (lwlc-recipe-shape)
        (lwph-hypothesis-recipe
            (lwhtw-forward-hypothesis tissue-fixture))
        (lwhtw-evidence)))
(defn lwhtw-cell-lens ()
    (lwlc-lens (lwlc-cell-shape) (lwhtw-before) (lwhtw-evidence)))
(defn lwhtw-rich-layers (tissue-fixture)
    (lwlc-layers
        (list (lwhtw-recipe-lens tissue-fixture)
              (lwhtw-cell-lens))))
(defn lwhtw-rich-declaration (tissue-fixture)
    (lwlc-declaration (lwhtw-cell LWHTW-DIRECTION)
        (lwlc-stack (lwhtw-blueprint-lens)
            (lwhtw-rich-layers tissue-fixture)
            (lwo-empty-field) (lwlc-unknown (lwhtw-evidence))
            (lwhtw-evidence))
        (lwhtw-evidence)))
(defn lwhtw-rich-choice ()
    (lwlc-choice (lwo-none)
        (lwo-field (list (lwhtw-alternative)))
        (lwlc-unknown (lwhtw-evidence)) (lwhtw-evidence)))
(defn lwhtw-rich-timeout (tissue-fixture)
    (oac-timeout (intern_trivial_int 10)
        (oac-alternative-ack
            (lwhtw-tissue-candidate tissue-fixture)
            (lwhtw-alternative) (lwhtw-evidence))
        (lwhtw-evidence)))

(defn lwhtw-minimal-application (tissue-fixture)
    (lwht-application
        (lwhtw-tissue-candidate tissue-fixture)
        (lwhtw-forward-hypothesis tissue-fixture)
        (lwhtw-application-bindings) (lwhtw-before)
        (lwo-none) (lwlc-layers (list)) (lwo-empty-field)
        (lwo-none) (lwo-none) (lwo-none) (lwhtw-evidence)))
(defn lwhtw-rich-application (tissue-fixture)
    (lwht-application
        (lwhtw-tissue-candidate tissue-fixture)
        (lwhtw-forward-hypothesis tissue-fixture)
        (lwhtw-application-bindings) (lwhtw-before)
        (lwhtw-rich-declaration tissue-fixture)
        (lwhtw-rich-layers tissue-fixture)
        (lwo-field (list (lwhtw-alternative)))
        (lwlc-unknown (lwhtw-evidence)) (lwhtw-rich-choice)
        (lwhtw-rich-timeout tissue-fixture) (lwhtw-evidence)))
(defn lwhtw-reverse-application (tissue-fixture)
    (lwht-application
        (lwhtw-tissue-candidate tissue-fixture)
        (lwhtw-reverse-hypothesis tissue-fixture)
        (lwhtw-application-bindings) (lwhtw-before)
        (lwo-none) (lwlc-layers (list))
        (lwo-field (list (lwhtw-alternative)))
        (lwlc-unknown (lwhtw-evidence)) (lwo-none) (lwo-none)
        (lwhtw-evidence)))

(defn lwhtw-application-dependencies (world tissue-fixture)
    (do
        (let bindings (lwhtw-application-bindings))
        (lwt-receive-stream world
            (list
                (lwphw-entry-k (lwhtw-application-scope))
                (lwphw-entry-l (lwhtw-application-scope))
                (lwphw-entry-k (lwhtw-application-left))
                (lwphw-entry-l (lwhtw-application-left))
                (lwphw-entry-k (lwhtw-application-right))
                (lwphw-entry-l (lwhtw-application-right))
                (lwphw-entry-k (lwhtw-application-left-projection))
                (lwphw-entry-l (lwhtw-application-left-projection))
                (lwphw-entry-k (lwhtw-application-right-projection))
                (lwphw-entry-l (lwhtw-application-right-projection))
                (lwphw-entry-k (lwhtw-binding-left bindings))
                (lwphw-entry-l (lwhtw-binding-left bindings))
                (lwphw-entry-k (lwhtw-binding-right bindings))
                (lwphw-entry-l (lwhtw-binding-right bindings))
                (lwphw-entry-k (lwhtw-before))
                (lwphw-entry-l (lwhtw-before))
                (lwphw-entry-c (lwhtw-rich-declaration tissue-fixture))
                (lwphw-entry-d (lwhtw-rich-declaration tissue-fixture))))))
(defn lwhtw-application-world (tissue-fixture)
    (do
        (let world
            (lwhtw-application-dependencies
                (lwt-round-world (lwhtw-tissue-round tissue-fixture))
                tissue-fixture))
        (lwt-receive-stream world
            (list
                (lwphw-entry-m (lwhtw-minimal-application tissue-fixture))
                (lwphw-entry-n (lwhtw-minimal-application tissue-fixture))
                (lwphw-entry-g (lwhtw-rich-application tissue-fixture))
                (lwphw-entry-h (lwhtw-rich-application tissue-fixture))
                (lwphw-entry-e (lwhtw-reverse-application tissue-fixture))
                (lwphw-entry-f (lwhtw-reverse-application tissue-fixture))))))

; children: tissue fixture, world, minimal/rich/reverse applications,
;           minimal/rich executions
(defn lwhtw-application-fixture
    (tissue world minimal rich reverse minimal-execution rich-execution)
    (intern_node LWHTW-APPLICATION-FIXTURE
        (list tissue world minimal rich reverse minimal-execution
              rich-execution)))
(defn lwhtw-application-tissue-fixture (fixture)
    (nth (node_children fixture) 0))
(defn lwhtw-application-world-cell (fixture)
    (nth (node_children fixture) 1))
(defn lwhtw-application-minimal (fixture)
    (nth (node_children fixture) 2))
(defn lwhtw-application-rich (fixture)
    (nth (node_children fixture) 3))
(defn lwhtw-application-reverse (fixture)
    (nth (node_children fixture) 4))
(defn lwhtw-application-minimal-execution (fixture)
    (nth (node_children fixture) 5))
(defn lwhtw-application-rich-execution (fixture)
    (nth (node_children fixture) 6))
(defn lwhtw-build-application ()
    (do
        (let tissue (lwhtw-integrated-tissue))
        (let world (lwhtw-application-world tissue))
        (let minimal (lwhtw-minimal-application tissue))
        (let rich (lwhtw-rich-application tissue))
        (let reverse (lwhtw-reverse-application tissue))
        (lwhtw-application-fixture tissue world minimal rich reverse
            (lwht-execution-for world minimal 2 (lwo-none))
            (lwht-execution-for world rich 2 (intern_trivial_int 5)))))

(defn lwhtw-revoked-application-world (fixture)
    (do
        (let world (lwhtw-application-world-cell fixture))
        (let application (lwhtw-application-minimal fixture))
        (lwt-receive-stream world
            (list
                (lwphw-entry-m
                    (lwo-revocation application (lwphw-source-m)
                        (lwhtw-reason) (lwphw-prov-m)))))))
(defn lwhtw-revoked-second-probe-world (tissue-fixture)
    (do
        (let history (lwhtw-tissue-history tissue-fixture))
        (let second (lwhtw-history-second history))
        (let world (lwt-round-world (lwhtw-tissue-round tissue-fixture)))
        (let probe (lwphw-probe-cell second))
        (lwt-receive-stream world
            (list
                (lwphw-entry-m
                    (lwo-revocation probe (lwphw-source-m)
                        (lwhtw-reason) (lwphw-prov-m)))))))
