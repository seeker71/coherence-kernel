// Source preservation and refusal checks; actual compiled behavior is a separate witness.
// preludes: form-stdlib/bml/form-bml-boolean-repair.bml
section [form.bml] {
 class BmlBooleanRepairBand {
  def fbrb-source(body) = str_concat("section [form.bml] {\n",str_concat(body,"\n}\n"));
  def fbrb-check(name,ok) = if ok then 1 else form_error(str_concat("BML boolean repair: ",name));
  def fbrb-case(name,before,after,edits) {
   let r = fbr-repair(before);
   fbrb-check(name,and(head(r),and(str_eq(nth(r,1),after),eq(len(nth(r,2)),edits))));
   let again = fbr-repair(nth(r,1));
   fbrb-check("idempotent",and(head(again),and(str_eq(nth(again,1),after),nil?(nth(again,2)))));
  }
  def fbrb-refuse(source) {
   let r = fbr-repair(source);
   fbrb-check("refusal keeps complete source",and(not(head(r)),and(str_eq(nth(r,1),source),nil?(nth(r,2)))));
  }
 }
 fbrb-case("three and",fbrb-source("and(a,b,c);"),fbrb-source("and(a,and(b,c));"),1);
 fbrb-case("four or",fbrb-source("or(a, b, c, d);"),fbrb-source("or(a,or( b,or( c, d)));"),1);
 fbrb-case("nested",fbrb-source("and(a,or(b,c,d),e);"),fbrb-source("and(a,and(or(b,or(c,d)),e));"),2);
 fbrb-case("comments and UTF-8 strings",fbrb-source("// and(a,b,c)\nand(é, // comma, and(x,y,z)\nstr_eq(\"and(a,b,c) \\\"\",\"好\"),z);"),fbrb-source("// and(a,b,c)\nand(é,and( // comma, and(x,y,z)\nstr_eq(\"and(a,b,c) \\\"\",\"好\"),z));"),1);
 fbrb-case("groups",fbrb-source("and(list(a,b),{ let x = list(1,2); x; },c);"),fbrb-source("and(list(a,b),and({ let x = list(1,2); x; },c));"),1);
 fbrb-case("other sections",str_concat("section [form.route] { and(a,b,c); }\n",fbrb-source("or(1,2,3);")),str_concat("section [form.route] { and(a,b,c); }\n",fbrb-source("or(1,or(2,3));")),1);
 fbrb-case("qualified names",fbrb-source("obj.and(a,b,c); obj . and(a,b,c); sand(a,b,c); and?(a,b,c);"),fbrb-source("obj.and(a,b,c); obj . and(a,b,c); sand(a,b,c); and?(a,b,c);"),0);
 fbrb-case("binary unchanged",fbrb-source("and(a,b); or(a,b);"),fbrb-source("and(a,b); or(a,b);"),0);
 fbrb-refuse(fbrb-source("and(a,,b,c);"));
 fbrb-refuse(fbrb-source("and(a,b,c,);"));
 fbrb-refuse(fbrb-source("and(a,b,c];"));
 fbrb-refuse(fbrb-source("and(a,b,c); \"unterminated"));
 fbrb-refuse(fbrb-source("/* and(a,b,c) */ and(a,b,c);"));
 fbrb-refuse(fbrb-source("def and(a,b,c) = a;"));
 fbrb-refuse(fbrb-source("and(a,do a; b; end,c);"));
 print_str("BML boolean repair: preservation, nesting, scope, idempotence and refusal checks pass");
 1;
}
