; form-knowledge-family-native-exec-teach-check-band.fk -- pure adversarial
; witness for exact family-bound model requests and mastery execution evidence.
; No model, carrier, registry, generated artifact, or remote lane runs here.
;
; Expected: 1073741823 (30 bits).
; witnessed: 2026-08-25 -> direct fkwu
; preludes: form-stdlib/form-knowledge-family-native-exec-teach-check.fk

(do
    (defn fkfneb-bit (held weight) (if held weight 0))
    (defn fkfneb-run-id (name)
        (nmfe-sha256 (nmfe-fields (list
            "synthetic-family-native-run-v2" name))))
    (defn fkfneb-live (request status value native executed)
        (do
            (let code (if (eq native 1)
                (frexl-code-node (frex-request-recipe request)) (nothing)))
            (frexl-result-from-offer request
                (frex-offer (frex-request-carrier request) status value
                    (str_concat "fixture-" status))
                code (str_len (frex-surface (frex-request-recipe request)
                    (frex-request-input request)
                    (frex-request-carrier request)))
                (if (eq native 1) 1 0) native executed
                native (if (eq native 1) 1 0)
                (if (eq native 1) 4 0)
                (if (eq executed 1) 1 0)
                (if (eq executed 1) 1 0)
                (if (eq executed 1) 4 0))))
    (defn fkfneb-compact (request status value native executed)
        (frexl-result-as-frex request
            (fkfneb-live request status value native executed)))
    (defn fkfneb-with-flags (request result executed model native present value)
        (frex-result-with-flags (frex-result-status result)
            (frex-result-reason result) request
            (frex-result-carrier result) value present
            (frex-result-trace result) (frex-result-attempts result)
            executed model native))
    (defn fkfneb-traces-have? (results actions)
        (if (nil? actions) 1
            (if (eq (fkfneb-results-have-action? results (head actions)) 1)
                (fkfneb-traces-have? results (tail actions)) 0)))
    (defn fkfneb-results-have-action? (results action)
        (if (nil? results) 0
            (if (eq (frex-trace-has? (frex-result-trace (head results))
                                     action) 1)
                1 (fkfneb-results-have-action? (tail results) action))))
    (defn fkfneb-tamper-source (binding)
        (fkfne-binding (fkfne-binding-family binding)
            "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
            (fkfne-binding-challenge-sha binding)
            (fkfne-binding-recipe binding) (fkfne-binding-input binding)
            (fkfne-binding-carrier binding)))
    (defn fkfneb-tamper-challenge (binding)
        (fkfne-binding (fkfne-binding-family binding)
            (fkfne-binding-source-sha binding)
            "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
            (fkfne-binding-recipe binding) (fkfne-binding-input binding)
            (fkfne-binding-carrier binding)))
    (defn fkfneb-check-like
        (check binding prep result typed output-sha evidence receipt raw-query
         model-id run-id remote release)
        (fkfne-check-row (fkfne-check-status check)
            (fkfne-check-reason check) binding prep result typed output-sha
            evidence receipt raw-query model-id run-id remote release))
    (defn fkfneb-receipt-with-sha (receipt sha)
        (list (nth receipt 0) (nth receipt 1) (nth receipt 2)
            (nth receipt 3) (nth receipt 4) (nth receipt 5)
            (nth receipt 6) (nth receipt 7) (nth receipt 8)
            (nth receipt 9) (nth receipt 10) (nth receipt 11)
            (nth receipt 12) (nth receipt 13) (nth receipt 14)
            (nth receipt 15) (nth receipt 16) (nth receipt 17)
            (nth receipt 18) sha))

    (defn form-knowledge-family-native-exec-teach-check-band ()
        (do
            (let family "bootstrap")
            (let model-id "synthetic-local-qwen")
            (let run-id (fkfneb-run-id "primary"))
            (let run-two (fkfneb-run-id "second"))
            (let binding (fkfne-binding-for-family family "metal"))
            (let stale-input-binding
                (fkfne-binding-for family -1 "metal"))
            (let stale-input-prep (fkfne-prepare stale-input-binding
                (fkfne-binding-query stale-input-binding)))
            (let query (fkfne-binding-query binding))
            (let prep (fkfne-prepare binding query))
            (let request (fkfne-prep-request prep))
            (let expected (frexl-recipe-expected (frex-recipe)
                (fkpfm-family-native-input family)))
            (let value-one (fkfneb-compact request "value" expected 1 1))
            (let value-zero (fkfneb-compact request "value" 0 1 1))
            (let nothing-result (fkfneb-compact request "nothing" 0 0 0))
            (let failure-result (fkfneb-compact request "failure" 0 0 0))
            (let timeout-result (fkfneb-compact request "timeout" 0 1 0))
            (let outcomes (list value-one nothing-result failure-result
                                timeout-result))
            (let check (fkfne-check binding prep value-one
                model-id run-id 0 1))
            (let evidence (fkfne-check-evidence check))
            (let receipt (fkfne-check-receipt check))
            (let check-two (fkfne-check binding prep value-one
                model-id run-two 0 1))
            (let bad-model (fkfneb-with-flags
                request value-one 1 1 1 1 expected))
            (let bad-native (fkfneb-with-flags
                request value-one 1 0 0 1 expected))
            (let bad-executed (fkfneb-with-flags
                request value-one 0 0 1 1 expected))
            (let absent (fkfneb-with-flags
                request value-one 1 0 1 0 expected))
            (let wrong-value (fkfneb-with-flags
                request value-one 1 0 1 1 (add expected 1)))

            (let other-family "axioms")
            (let other-binding
                (fkfne-binding-for-family other-family "metal"))
            (let other-query (fkfne-binding-query other-binding))
            (let other-prep (fkfne-prepare other-binding other-query))
            (let other-result (fkfneb-compact
                (fkfne-prep-request other-prep) "value"
                (frexl-recipe-expected (frex-recipe)
                    (fkpfm-family-native-input other-family)) 1 1))
            (let other-check (fkfne-check other-binding other-prep
                other-result model-id (fkfneb-run-id "other-family") 0 1))
            (let cpu-binding (fkfne-binding-for-family family "cpu"))
            (let mlx-binding (fkfne-binding-for-family family "mlx"))

            (let typed-swap (fkfneb-check-like check binding prep value-one
                (fkfne-check-typed other-check)
                (fkfne-check-output-sha check) evidence receipt query model-id
                run-id 0 1))
            (let evidence-swap (fkfneb-check-like check binding prep value-one
                (fkfne-check-typed check) (fkfne-check-output-sha check)
                (fkfne-check-evidence check-two) receipt query model-id
                run-id 0 1))
            (let cross-family (fkfneb-check-like check binding prep value-one
                (fkfne-check-typed check) (fkfne-check-output-sha check)
                (fkfne-check-evidence other-check)
                (fkfne-check-receipt other-check) query model-id run-id 0 1))
            (let stale-run (fkfneb-check-like check binding prep value-one
                (fkfne-check-typed check) (fkfne-check-output-sha check)
                evidence receipt query model-id run-two 0 1))
            (let stale-receipt (fkfneb-check-like check binding prep value-one
                (fkfne-check-typed check) (fkfne-check-output-sha check)
                evidence (fkfneb-receipt-with-sha receipt
                    "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")
                query model-id run-id 0 1))
            (let stale-result (fkfneb-check-like check binding prep other-result
                (fkfne-check-typed check) (fkfne-check-output-sha check)
                evidence receipt query model-id run-id 0 1))
            (let stale-query (fkfneb-check-like check binding prep value-one
                (fkfne-check-typed check) (fkfne-check-output-sha check)
                evidence receipt (str_concat query "\n") model-id run-id 0 1))
            (let stale-model (fkfneb-check-like check binding prep value-one
                (fkfne-check-typed check) (fkfne-check-output-sha check)
                evidence receipt query "other-model" run-id 0 1))
            (let stale-output (fkfneb-check-like check binding prep value-one
                (fkfne-check-typed check)
                "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
                evidence receipt query model-id run-id 0 1))

            (sum (list
                (fkfneb-bit (eq (fkpfm-family-total) 15) 1)
                (fkfneb-bit (and
                    (eq (fkpfm-family-native-input family) -2)
                    (eq (fkfne-binding-input binding) -2)) 2)
                (fkfneb-bit (eq (fkfne-binding-valid? binding) 1) 4)
                (fkfneb-bit (and
                    (eq (fkfne-binding-valid? stale-input-binding) 0)
                    (eq (fkfne-check-valid? (fkfne-check stale-input-binding
                        stale-input-prep value-one model-id run-id 0 1)) 0)) 8)
                (fkfneb-bit (and (eq (fkfne-preparation-valid? prep) 1)
                    (and (eq (fkfne-prep-scannerless? prep) 1)
                    (and (eq (fkfne-prep-pretokenized? prep) 0)
                         (eq (frexl-cursor-bytes (fkfne-prep-cursor prep))
                             (str_len query))))) 16)
                (fkfneb-bit (and (eq (fkfne-preparation-valid?
                    (fkfne-prepare binding (str_concat "prose" query))) 0)
                    (and (eq (fkfne-preparation-valid?
                    (fkfne-prepare binding (str_concat query "\n"))) 0)
                         (eq (fkfne-preparation-valid?
                    (fkfne-prepare binding (str_concat query query))) 0))) 32)
                (fkfneb-bit (and (eq (fkfne-binding-valid?
                    (fkfneb-tamper-source binding)) 0)
                    (eq (fkfne-binding-valid?
                    (fkfneb-tamper-challenge binding)) 0)) 64)
                (fkfneb-bit (and (eq (fkfne-preparation-valid?
                    (fkfne-prepare binding
                        (frex-surface (frex-recipe) -2 "cpu"))) 0)
                    (eq (fkfne-preparation-valid?
                    (fkfne-prepare binding
                        (frex-surface (frex-recipe) -1 "metal"))) 0)) 128)
                (fkfneb-bit (and (eq (fkfne-result-signal-valid? value-one) 1)
                    (and (eq (frex-result-value-present? value-one) 1)
                         (eq (frex-result-value value-one) 1))) 256)
                (fkfneb-bit (and (eq (fkfne-result-signal-valid? value-zero) 1)
                    (and (eq (frex-result-value-present? value-zero) 1)
                    (and (eq (frex-result-value value-zero) 0)
                         (not (node_eq (frex-result-observation value-zero)
                                       (frex-result-observation value-one))))))
                    512)
                (fkfneb-bit (and
                    (str_eq (frex-result-status nothing-result) "nothing")
                    (and (str_eq (frex-result-status failure-result) "failure")
                    (and (str_eq (frex-result-status timeout-result) "timeout")
                    (and (eq (frex-result-value-present? nothing-result) 0)
                         (eq (frex-result-value-present? timeout-result) 0)))))
                    1024)
                (fkfneb-bit (eq (fkfneb-traces-have? outcomes
                    (list "choice" "cut" "undo" "timeout" "failure"
                          "dissolve" "release")) 1) 2048)
                (fkfneb-bit (and (eq (fkfne-check-valid? check) 1)
                    (eq (fkpfm-execution-valid? evidence) 1)) 4096)
                (fkfneb-bit (and (eq (fkpfm-receipt-valid? receipt) 1)
                    (and (str_eq (fkpfm-receipt-model-output receipt) query)
                    (and (str_eq (fkpfm-receipt-artifact-output receipt)
                                     (frex-render value-one))
                         (str_eq (fkpfm-receipt-artifact-output-sha receipt)
                                     (nmfe-sha256 (frex-render value-one))))))
                    8192)
                (fkfneb-bit (and
                    (str_eq (nth evidence 2) family)
                    (and (str_eq (nth evidence 3) model-id)
                    (and (eq (fkpfm-equal? (nth evidence 4) receipt) 1)
                    (and (str_eq (nth evidence 5)
                                     (fkfne-check-output-sha check))
                    (and (str_eq (nth evidence 9) query)
                    (and (str_eq (nth evidence 14) run-id)
                         (eq (fkfne-result-same? (nth evidence 13)
                                 value-one) 1))))))) 16384)
                (fkfneb-bit (and (str_eq (fkfne-check-typed check)
                                             (frex-render value-one))
                    (str_eq (fkfne-check-output-sha check)
                        (nmfe-sha256 (frex-render value-one)))) 32768)
                (fkfneb-bit (and (eq (fkfne-check-valid?
                    (fkfne-check binding prep bad-model model-id run-id 0 1)) 0)
                    (and (eq (fkfne-check-valid?
                    (fkfne-check binding prep bad-native model-id run-id 0 1)) 0)
                    (and (eq (fkfne-check-valid?
                    (fkfne-check binding prep bad-executed model-id run-id 0 1)) 0)
                    (and (eq (fkfne-check-valid?
                    (fkfne-check binding prep absent model-id run-id 0 1)) 0)
                         (eq (fkfne-check-valid?
                    (fkfne-check binding prep wrong-value model-id run-id 0 1)) 0)))))
                    65536)
                (fkfneb-bit (and (eq (fkfne-binding-valid? cpu-binding) 1)
                    (and (eq (fkfne-binding-valid? mlx-binding) 1)
                    (and (eq (fkfne-carrier-executable-now? "cpu") 0)
                    (and (eq (fkfne-carrier-executable-now? "mlx") 0)
                         (ge (str_find (fkfne-carrier-seam) "non-crediting" 0)
                             0))))) 131072)
                (fkfneb-bit (eq (fkfne-check-valid? typed-swap) 0) 262144)
                (fkfneb-bit (eq (fkfne-check-valid? evidence-swap) 0) 524288)
                (fkfneb-bit (eq (fkfne-check-valid? cross-family) 0) 1048576)
                (fkfneb-bit (eq (fkfne-check-valid? stale-run) 0) 2097152)
                (fkfneb-bit (eq (fkfne-check-valid? stale-receipt) 0) 4194304)
                (fkfneb-bit (eq (fkfne-check-valid? stale-result) 0) 8388608)
                (fkfneb-bit (eq (fkfne-check-valid? stale-query) 0) 16777216)
                (fkfneb-bit (eq (fkfne-check-valid? stale-model) 0) 33554432)
                (fkfneb-bit (eq (fkfne-check-valid? stale-output) 0) 67108864)
                (fkfneb-bit (and (eq (fkfne-check-valid? (nothing)) 0)
                    (and (eq (fkfne-check-valid? 0) 0)
                         (eq (fkfne-check-valid? 1) 0))) 134217728)
                (fkfneb-bit (and (eq (fkfne-binding-valid? (nothing)) 0)
                    (and (eq (fkfne-binding-valid? 0) 0)
                    (and (eq (fkfne-preparation-valid? 1) 0)
                    (and (eq (fkfne-result-signal-valid? (nothing)) 0)
                    (and (eq (fkfne-result-signal-valid? 0) 0)
                    (and (eq (fkfne-preparation-valid?
                        (fkfne-preparation "ready" "forged" binding
                            (nmfe-sha256 query) 0 0 1 1 0 1)) 0)
                         (eq (fkfne-check-valid?
                            (fkfne-check-row "value"
                                "family-native-execution-admitted"
                                0 0 0 "" (nmfe-sha256 "")
                                (nothing) (nothing) "" ""
                                run-id 0 1)) 0)))))))
                    268435456)
                (fkfneb-bit (and (eq (fkfne-check-valid? other-check) 1)
                    (and (not (str_eq (fkfne-binding-family other-binding)
                                      family))
                    (and (not (eq (fkfne-binding-input other-binding)
                                  (fkfne-binding-input binding)))
                         (not (str_eq (fkfne-check-output-sha other-check)
                                      (fkfne-check-output-sha check))))))
                    536870912)))))

    (form-knowledge-family-native-exec-teach-check-band))
