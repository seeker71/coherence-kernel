; Caller supplies a private cache directory on stdin. Run twice in separate
; processes: first captures, second requires the binary archive to contain code.
; preludes: form-stdlib/bml/metal-jit.bml
(do
 (defn mjcb-run (directory)
 (do
 (let source (mj-source "kernel void cache_probe(device uint *y [[buffer(0)]], uint i [[thread_position_in_grid]]) { y[i] = i * 3u + 7u; }"))
 (let path (mj-cache-path directory source "cache_probe"))
 (let existed (ge (file_size path) 0))
 (let version (mj-cached source "cache_probe" directory))
 (let buffer (metal_buf_alloc 16))
 (let enqueued (mj-enqueue version (md-bind (list buffer) (list)) 4))
 (let bytes (metal_buf_read buffer 0 16))
 (let status (metal_status))
 (let freed (metal_buf_free buffer))
 (print_str (if existed "cache-stage=archive-hit-required" "cache-stage=archive-capture"))
 (sum (list
  (if (gt (mj-handle version) 0) 1 0)
  (if (eq enqueued 1) 2 0)
  (if (str_eq bytes (md-le32-list (list 7 10 13 16) "")) 4 0)
  (if (gt (file_size path) 0) 8 0)
  (if (ge (str_find status (if existed "metal_jit_archive_reads=1" "metal_jit_archive_writes=1") 0) 0) 16 0)
  (if (eq freed 1) 32 0)))))
 (let directory (read_line))
 (if (and (not (nothing? directory)) (eq (str_find directory "/tmp/fkwu-metal-cache." 0) 0)) (mjcb-run directory) 0))
