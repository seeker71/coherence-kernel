; fsh-native-port-jit-admission-band.fk -- direct Form proof for the exact
; bare fsh AST -> pure JIT admission boundary.
;
; Verdict: 63.  This is not a native port or JIT execution proof: it verifies
; parser shape, identity confinement, and fixed safe structural-plan construction.
; Live carrier execution remains separately witnessed by
; observe/tests/jit-arm64-u32-leaf-carrier-band.fk.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/grammar-loader.fk form-stdlib/shell-grammar.fk form-stdlib/fsh-turn-process-spec.fk observe/jit-arm64-u32-leaf-carrier.fk form-stdlib/fsh-native-port-jit-admission.fk

(do
    (defn fnpjab-bit-sum-loop (bits total)
        (if (eq (len bits) 0) total
            (fnpjab-bit-sum-loop (tail bits) (add total (head bits)))))
    (defn fnpjab-bit-sum (bits) (fnpjab-bit-sum-loop bits 0))
    (defn fnpjab-all-empty? (plans)
        (if (eq (len plans) 0) 1
            (if (eq (len (head plans)) 0)
                (fnpjab-all-empty? (tail plans))
                0)))
    (defn fnpjab-c0 (command id)
        (if (eq (fnpja-command-present? command) 1)
            (if (str_eq (fnpja-command-id (fnpja-command-node command)) id) 1 0)
            0))
    (defn fnpjab-c1 (admission id)
        (if (str_eq (nth admission 0) "fsh-native-port-jit-admission-v3")
            (if (str_eq (fnpja-status admission) "admitted")
                (if (str_eq (fnpja-exchange-id admission) id)
                    (if (str_eq (fnpja-decision admission)
                                "admitted-structural-arm64-u32-leaf-plan")
                        (if (eq (fnpja-admitted? admission) 1) 2 0)
                        0)
                    0)
                0)
            0))
    (defn fnpjab-c2 (admission)
        (if (eq (fnpja-typed-plan? (fnpja-plan admission)) 1)
            (if (eq (nth (fnpja-plan admission) 1) 2)
                (if (eq (nth (fnpja-plan admission) 2) 41) 4 0)
                0)
            0))
    (defn fnpjab-c3 (admission)
        (if (eq (fnpja-fixed-program? (fnpja-structural-program admission)) 1) 8 0))
    (defn fnpjab-c4 (uppercase extra pipeline sequence andor wrong)
        (if (eq (fnpjab-bit-sum
                    (list (fnpja-admitted? uppercase)
                          (fnpja-admitted? extra)
                          (fnpja-admitted? pipeline)
                          (fnpja-admitted? sequence)
                          (fnpja-admitted? andor)
                          (fnpja-admitted? wrong)))
                0)
            16
            0))
    (defn fnpjab-c5 (uppercase extra pipeline sequence andor wrong)
        (if (eq (fnpjab-all-empty?
                    (list (fnpja-plan uppercase)
                          (fnpja-plan extra)
                          (fnpja-plan pipeline)
                          (fnpja-plan sequence)
                          (fnpja-plan andor)
                          (fnpja-plan wrong)))
                1)
            (if (str_eq (fnpja-execution) "plan-only") 32 0)
            0))
    (let id "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    (let uppercase-id (str_concat "A" (substring id 1 64)))
    (let valid-line (str_concat "native-port-check " id))
    (let uppercase-line (str_concat "native-port-check " uppercase-id))
    (let extra-line (str_concat valid-line " extra"))
    (let pipeline-line (str_concat valid-line " | echo no"))
    (let sequence-line (str_concat valid-line " ; echo no"))
    (let andor-line (str_concat valid-line " && echo no"))
    (let wrong-line (str_concat "turn " id))
    (let valid-ast (sh-parse valid-line))
    (let valid-command (fnpja-bare-command valid-ast))
    (let valid (fnpja-from-line valid-line))
    (let uppercase (fnpja-from-line uppercase-line))
    (let extra (fnpja-from-line extra-line))
    (let pipeline (fnpja-from-line pipeline-line))
    (let sequence (fnpja-from-line sequence-line))
    (let andor (fnpja-from-line andor-line))
    (let wrong (fnpja-from-line wrong-line))
    (fnpjab-bit-sum
        (list (fnpjab-c0 valid-command id)
              (fnpjab-c1 valid id)
              (fnpjab-c2 valid)
              (fnpjab-c3 valid)
              (fnpjab-c4 uppercase extra pipeline sequence andor wrong)
              (fnpjab-c5 uppercase extra pipeline sequence andor wrong))))
