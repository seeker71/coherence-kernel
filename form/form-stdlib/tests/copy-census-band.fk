; preludes: form/form-stdlib/bml/copy-census.bml
; Expected: 63
;
; copy-census-band — the organ that looks for the body's copies.
;
; Urs, 2026-09-10: "there are copies and we did not detect it? what other copies do we have?"
; Three times in one day the same disease, each found by a hand grepping afterwards: nine private
; names for one int-to-float promotion, one float_to_str living in two files, a band inlining both
; the engine and the reference it checks against. The body has a lens for clouded words and a lens
; for what a pass costs, and none for the thing that has bitten it most (corpus row 1420 owncopy).
;
; Verdict 63:
;   1   the fingerprint is blind to whitespace and awake to a changed byte
;   2   equality is whitespace-insensitive and exact — one letter apart is not the same shape
;   4   a .fk definition is read whole, with parens inside a string literal stepped over and not
;       counted, which is the balancer's own known way of swallowing a file
;   8   a .bml definition is read whole in both its forms — `= expr;` and a braced block
;   16  a walk of this tree's shared vocabulary finds real families: one shape, several names
;   32  substance separates a copy from a coincidence — an accessor at some index is not a twin,
;       and raising the floor lets fewer families through, never more
(do
    (let a "  (add   n   0.0)  ")
    (let b "(add n 0.0)")
    (let c "(add m 0.0)")
    (let c0 (if (and (eq (cpc-fingerprint a 0 (str_len a)) (cpc-fingerprint b 0 (str_len b)))
                     (not (eq (cpc-fingerprint b 0 (str_len b)) (cpc-fingerprint c 0 (str_len c))))) 1 0))
    (let c1 (if (and (eq (cpc-same? a 0 (str_len a) b 0 (str_len b)) 1)
                     (eq (cpc-same? a 0 (str_len a) c 0 (str_len c)) 0)) 2 0))
    ; a string literal carrying an unbalanced paren, which a counting balancer would swallow
    (let fk (str_concat "(defn kk (x) (str_concat \"a)b\" x)) (defn zz (y) y)" ""))
    (let fkd (cpc-fk-defs fk 0 (str_len fk) (list)))
    (let c2 (if (and (eq (len fkd) 2) (str_eq (cpc-r-name (head (tail fkd))) "kk")) 4 0))
    (let bm "def p(a) = add(a, 1);
def q(a) {
    let z = add(a, 1);
    z;
}")
    (let bmd (cpc-bml-defs bm 0 (str_len bm) (list)))
    (let c3 (if (and (eq (len bmd) 2) (str_eq (cpc-r-name (head (tail bmd))) "p")) 8 0))
    ; the real walk: this body's shared vocabulary, one shape under several names, whether the
    ; band runs from the root (fkwu under validate.sh) or from form/ (the siblings)
    (let bml-dir (if (eq (fs-is-dir? "form/form-stdlib/bml") 1) "form/form-stdlib/bml" "form-stdlib/bml"))
    (let ps (cpc-walk bml-dir (list)))
    (let fams (cpc-families (cpc-census ps)))
    (let big (cpc-weighty fams 24 (list)))
    (let c4 (if (and (gt (len ps) 100) (gt (len big) 0)) 16 0))
    (let c5 (if (le (len (cpc-weighty fams 200 (list))) (len big)) 32 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
