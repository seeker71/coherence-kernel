; Concurrent writers cannot overwrite one session/event with different evidence.
; preludes: form-stdlib/native-session-memory.bml
(do
 (defn nsjb-launch (home name answer)
  (do (let input (nsm-at home (str_concat name ".input")))
   (nag-write input (str_concat home (str_concat "\n" (str_concat answer "\n"))))
   (host_spawn_at (list "./fkwu" (nsm-at home "record.fk"))
    (list input (nsm-at home (str_concat name ".out")) (nsm-at home (str_concat name ".err"))))))
 (let home (str_concat "/tmp/session-journal-" (nsm-id)))
 (nsm-init home)
 (nag-write (nsm-at home "record.fk") "; preludes: form-stdlib/native-session-memory.bml\n(do (let home (read_line)) (let answer (read_line)) (nsm-record home \"session\" \"event\" \"caller\" \"prompt\" answer \"caller-teaching\" \"public-fixture\" 0) 0)\n")
 (let one (nsjb-launch home "one" "first"))
 (let two (nsjb-launch home "two" "second"))
 (let rc1 (host_wait one)) (let rc2 (host_wait two))
 (let dir (nsm-at (nsm-at home "rows") (nsm-hash "session\nevent")))
 (let before (nsm-text (nsm-at dir "record.json")))
 (let winner (if (eq rc1 0) "first" "second"))
 (let duplicate (nsjb-launch home "duplicate" winner))
 (let replay (host_wait duplicate))
 (let checks (list (or (and (eq rc1 0) (eq rc2 1)) (and (eq rc1 1) (eq rc2 0)))
  (str_eq (nsm-str (json-object-get (nsm-json (nsm-at dir "record.json")) "example") "completion") winner)
  (eq replay 0) (str_eq before (nsm-text (nsm-at dir "record.json")))
  (eq (len (nsm-pending home (nsm-dirs home))) 1)))
 (print checks) (fs-remove-tree home)
 (if (value_eq checks (list 1 1 1 1 1)) 31 (form_error "concurrent session journal lost evidence")))
