; form-glass-standing-band.fk — which organs are MEANT to keep giving.
;
; The roster says when a name last spoke. It cannot say whether that name ever
; meant to speak again, so a finished band and a stopped organ read alike after
; an hour. The difference is INTENT, and intent is declared, never inferred.
; This band proves the declaration behaves: a promise kept, a promise unkept, a
; promise never once kept, and — the bit that keeps the door honest — silence
; from something that never promised is never called a wound.
;
; Bits 1..16 are pure over declared fixtures. Bit 32 crosses for real: an organ
; is declared against a band-private root, published into, and read back
; through the live roster stamp, so "breathing" is a give that happened.
;
; Expected: 63
;
;   1   an organ carries publisher, cadence and the cell that gives it, and its
;       window is the cadence times the silent factor
;   2   a promise kept inside its own window reads breathing; past it, stopped
;   4   an age of -1 is never-stood, which is not an age of zero and not a
;       silence: the name has never once appeared in the roster
;   8   the declaration is looked up by publisher, and a publisher that is NOT
;       declared answers nothing — never "stopped", because it never promised
;   16  kept and unkept partition the readings, and unkept names the door that
;       gives the organ, so the finding points at a cell and not at a mood
;   32  a REAL organ: declared against a band-private root, published into, and
;       assessed from the live roster stamp with no frame opened
;
; preludes: form/form-stdlib/form-glass-standing.bml

(do
    (defn xb (ok bit) (if ok bit 0))

    (let fast (fgst-organ "fixture.fast" 500 "observe/fixture-fast.fk"))
    (let slow (fgst-organ "fixture.slow" 5000 "observe/fixture-slow.fk"))

    (let b1 (xb (and (str_eq (fgst-publisher fast) "fixture.fast")
              (and (eq (fgst-cadence fast) 500)
              (and (str_eq (fgst-door fast) "observe/fixture-fast.fk")
              (and (eq (fgst-organ? fast) 1)
              (and (eq (fgst-organ? (list "not-an-organ")) 0)
                   (eq (fgst-window fast) 1500)))))) 1))

    ; the promise is the organ's own cadence, so the same age reads differently
    ; for a 500 ms organ and a 5 s one — which is the whole point of declaring
    (let b2 (xb (and (str_eq (fgst-state fast 400) "breathing")
              (and (str_eq (fgst-state fast 1500) "breathing")
              (and (str_eq (fgst-state fast 1501) "stopped")
              (and (str_eq (fgst-state slow 1501) "breathing")
                   (str_eq (fgst-state slow 15001) "stopped"))))) 2))

    (let b3 (xb (and (str_eq (fgst-state fast -1) "never-stood")
              (and (eq (fgst-stopped? (fgst-reading fast -1)) 1)
              (and (eq (fgst-reading-age (fgst-reading fast -1)) -1)
                   (eq (fgst-reading-window (fgst-reading fast 0)) 1500)))) 4))

    (let ds (list fast slow))
    (let b4 (xb (and (eq (fgst-declared? ds "fixture.fast") 1)
              (and (eq (fgst-declared? ds "never.promised") 0)
              (and (eq (len (fgst-declared-for ds "never.promised")) 0)
              (and (str_eq (fgst-door (fgst-declared-for ds "fixture.slow")) "observe/fixture-slow.fk")
                   (eq (fgst-declared? (fgst-declared) "organs") 1))))) 8))

    (let rs (list (fgst-reading fast 100) (fgst-reading slow 99999) (fgst-reading fast -1)))
    (let b5 (xb (and (eq (len (fgst-kept rs)) 1)
              (and (eq (len (fgst-unkept rs)) 2)
              (and (eq (add (len (fgst-kept rs)) (len (fgst-unkept rs))) (len rs))
              (and (str_eq (fgst-reading-door (head (fgst-unkept rs))) "observe/fixture-slow.fk")
                   (str_eq (fgst-reading-state (head (fgst-kept rs))) "breathing"))))) 16))

    ; ---- a real organ: declared, published, and read from the roster stamp
    (defn st-sample (id)
        (fgtm-sample id (fgtm-absent) "metric" "membrane" "band" "lane" "standing"
            (fgtm-absent) (fgtm-absent) "active" (fgtm-present 1) (fgtm-present 1)
            (fgtm-absent) (fgtm-absent) "never" "declared" "band" (list "standing")))
    (let root (str_concat "/tmp/form-glass-standing-band." (int_to_str (host_pid))))
    (let live (fgst-organ "band.standing" 1000 "form/form-stdlib/tests/form-glass-standing-band.fk"))
    (let gone (fgst-organ "band.never" 1000 "form/form-stdlib/tests/form-glass-standing-band.fk"))
    (let put (fgtm-publish-snapshot root "band.standing" (now_unix_ms) (list (st-sample "s.one"))))
    (let slots (fgx-roster-slots (now_unix_ms)))
    (let readings (fgst-assess-in (list live gone) slots root))
    (let b6 (xb (and (str_eq (nth put 1) "published")
              (and (str_eq (fgst-reading-state (head readings)) "breathing")
              (and (str_eq (fgst-reading-state (nth readings 1)) "never-stood")
              (and (eq (len (fgst-unkept readings)) 1)
              (and (ge (fgst-age-in slots root "band.standing") 0)
                   (eq (fgst-age-in slots root "band.never") -1)))))) 32))

    (print (list "standing" "declared" (len (fgst-declared)) "band-readings" readings))
    (sum (list b1 b2 b3 b4 b5 b6)))
