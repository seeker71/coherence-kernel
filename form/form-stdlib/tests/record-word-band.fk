; record-word-band.fk -- a record's word is no integer's: every kernel reads a kind from the value alone.
;
; fkwu boxed record r as 0-(r<<1), the word of the integer -r, so once r records existed value_kind(-r) answered
; "record" and record? agreed (kindshadow, row 1525). Go, Rust and TypeScript hold a record as its own typed value
; and always answered "int". fkwu's records now sit in their own odd band (ownband, row 1528), and the four kernels
; agree.
;
; Verdict 15
;
;   1   with two records minted, value_kind of -1 and of -2 answers "int"
;   2   record? of -1 answers false, and of a record true
;   4   value_kind of a record answers "record"
;   8   a record equals itself, and -1 does not equal it
(do
    (defn rwb-bit (ok bit) (if ok bit 0))
    (let rwb-a (record_new (make_nodeid 1 5 4 1)))
    (let rwb-b (record_new (make_nodeid 1 5 4 1)))
    (let ints-ok (if (str_eq (value_kind -1) "int") (str_eq (value_kind -2) "int") false))
    (let rec-ok (if (record? -1) false (if (record? rwb-a) true false)))
    (let kind-ok (str_eq (value_kind rwb-b) "record"))
    (let eq-ok (if (eq rwb-a rwb-a) (if (eq rwb-a -1) false true) false))
    (add (rwb-bit ints-ok 1) (add (rwb-bit rec-ok 2) (add (rwb-bit kind-ok 4) (rwb-bit eq-ok 8)))))
