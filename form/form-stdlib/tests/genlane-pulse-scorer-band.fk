; genlane-pulse-scorer-band.fk — the parity pulse's scorer, witnessed pure:
; a needle must hit only the answer text after the "text:" marker, never a
; telemetry field name before it. Fixtures are captured spans from the first
; live pulse run (2026-08-30), where "othing" matched heed_nothings=0 and
; lit a bit the answer had not earned.
;
; Expected: 511
;   1..32   scorer behavior (telemetry miss, answer hit, form hit, field-name
;           miss, bare-span miss, missing marker is the empty answer)
;   64      authority binding: path + kind exact strings
;   128     the authority lawface carries package/interface/class
;   256     the executable BML carries section [form.bml] and def glp-answer
;
; preludes: form-stdlib/core.fk ../observe/genlane-parity-pulse-scorer.fk
; witnessed: 2026-08-30 -> 511
(do
    (defn glpb-has? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (let t1span "heed_nothings=0\nheed_spent=0\ntext:\n<|form:knowledge-query|>axiom-1 whole attestation")
    (let t2span "heed_nothings=0\ntext:\n(mul 6 7)=42")
    (let bare "no marker here, othing and 42 everywhere")
    (let auth (read_file "form/form-stdlib/bml/genlane-parity.bml"))
    (let exec (read_file "form/form-stdlib/genlane-scorer.bml"))
    (sum (list
        (if (eq (glp-hit? t1span "othing") 0) 1 0)
        (if (eq (glp-hit? t1span "knowledge-query") 1) 2 0)
        (if (eq (glp-hit? t2span "(mul 6 7)") 1) 4 0)
        (if (eq (glp-hit? t2span "heed_nothings") 0) 8 0)
        (if (eq (glp-hit? bare "othing") 0) 16 0)
        (if (str_eq (glp-answer bare) "") 32 0)
        (if (and (str_eq (glp-authority-path)
                     "form/form-stdlib/bml/genlane-parity.bml")
                 (str_eq (glp-authority-kind)
                     "high-bml-class-template-field")) 64 0)
        (if (and (eq (glpb-has? auth "package Form.cli.genlaneparity") 1)
                 (and (eq (glpb-has? auth "interface IGenlaneParity") 1)
                      (eq (glpb-has? auth "class FormGenlaneParity") 1))) 128 0)
        (if (and (eq (glpb-has? exec "section [form.bml]") 1)
                 (eq (glpb-has? exec "def glp-answer") 1)) 256 0))))
