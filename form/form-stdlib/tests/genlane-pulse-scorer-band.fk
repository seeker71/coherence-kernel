; genlane-pulse-scorer-band.fk — the parity pulse's scorer, witnessed pure:
; a needle must hit only the answer text after the "text:" marker, never a
; telemetry field name before it. Fixtures are captured spans from the first
; live pulse run (2026-08-30), where "othing" matched heed_nothings=0 and
; lit a bit the answer had not earned.
;
; Expected: 63
; preludes: form-stdlib/core.fk ../observe/genlane-parity-pulse-scorer.fk
(do
    (let t1span "heed_nothings=0\nheed_spent=0\ntext:\n<|form:knowledge-query|>axiom-1 whole attestation")
    (let t2span "heed_nothings=0\ntext:\n(mul 6 7)=42")
    (let bare "no marker here, othing and 42 everywhere")
    (sum (list
        (if (eq (glp-hit? t1span "othing") 0) 1 0)
        (if (eq (glp-hit? t1span "knowledge-query") 1) 2 0)
        (if (eq (glp-hit? t2span "(mul 6 7)") 1) 4 0)
        (if (eq (glp-hit? t2span "heed_nothings") 0) 8 0)
        (if (eq (glp-hit? bare "othing") 0) 16 0)
        (if (str_eq (glp-answer bare) "") 32 0))))
