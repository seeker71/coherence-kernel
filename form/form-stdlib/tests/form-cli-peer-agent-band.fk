; form-cli-peer-agent-band.fk -- pure protocol witness; no model or carrier.
;
; Verdict 1023:
;   1   typed task frame is bounded by exact scannerless marks
;   2   turn, kind and task remain distinct fields
;   4   result keeps session, cursor, speech, elapsed time and contribution
;   8   a crossed, executed recipe is a contribution
;   16  speech without physical execution is not yet counted as contribution
;   32  value, nothing-owned and nothing are distinct residence signals
;   64  zero and one remain ordinary pending token ids
;   128 bootstrap names the body signals and subsequent typed task channel
;   256 this witness opens neither a model nor a carrier
;   512 route-neutral evidence distinguishes source lookup from recipe work
;
; preludes: form-stdlib/form-cli-peer-agent.fk

(do
    (defn fcpab-bit (ok bit) (if ok bit 0))
    (let task (fcpa-task-frame 7 "test" "run the held-out band"))
    (let ctx (list "opaque-context"))
    (let sts (list "opaque-state"))
    (let s0 (fcms-session "live" "opened" "m.gguf" "src" ctx sts
        2048 50 0 0 49 4 3 1))
    (let s1 (fcms-session "live" "opened" "m.gguf" "src" ctx sts
        2048 50 1 0 49 4 3 1))
    (let held (fcms-session "nothing" "window" "m.gguf" "src" ctx sts
        2048 50 0 0 49 4 3 1))
    (let absent (fcms-none "absent"))
    (let c (frxc-fresh))
    (let result (fcpa-result s0 c "answer" 12 1))
    (let source-result (fcpa-result-full s0 (fknsc-fresh) "source answer"
        9 0 "source-knowledge" 1 "hit" "form-current-source" 0 0 0
        321 "choice,cut,release" 1))
    (sum (list
        (fcpab-bit (and (eq (str_find task (fcpa-task-open) 0) 0)
            (ge (str_find task (fcpa-task-close) 0) 0)) 1)
        (fcpab-bit (and (ge (str_find task "\nturn=7" 0) 0)
            (and (ge (str_find task "\nkind=test" 0) 0)
                 (ge (str_find task "\ntask=run the held-out band" 0) 0))) 2)
        (fcpab-bit (and (node_eq (fcpa-session result) s0)
            (and (node_eq (fcpa-cursor result) c)
            (and (str_eq (fcpa-response result) "answer")
            (and (eq (fcpa-elapsed-ms result) 12)
                 (eq (fcpa-contribution result) 1))))) 4)
        ; The live cursor's physical flags are already proven in its own band;
        ; this projection retains the exact acceptance rule.
        (fcpab-bit (eq (fcpa-contribution result) 1) 8)
        (fcpab-bit (eq (fcpa-contribution
            (fcpa-result s0 c "fluent" 1 0)) 0) 16)
        (fcpab-bit (and (str_eq (fcpa-signal s0) "value")
            (and (str_eq (fcpa-signal held) "nothing-owned")
                 (str_eq (fcpa-signal absent) "nothing"))) 32)
        (fcpab-bit (and (eq (fcms-pending s0) 0)
                         (eq (fcms-pending s1) 1)) 64)
        (fcpab-bit (and (ge (str_find (fcpa-bootstrap) "nothing is not integer 0 or 1" 0) 0)
            (and (ge (str_find (fcpa-bootstrap) "choice, cut, undo, timeout" 0) 0)
                 (ge (str_find (fcpa-bootstrap) "form:agent-task" 0) 0))) 128)
        (fcpab-bit 1 256)
        (fcpab-bit (and (str_eq (fcpa-route source-result) "source-knowledge")
            (and (eq (fcpa-callback-calls source-result) 1)
            (and (str_eq (fcpa-tool-status source-result) "hit")
            (and (str_eq (fcpa-carrier source-result) "form-current-source")
            (and (eq (fcpa-injected-bytes source-result) 321)
                 (eq (fcpa-lookup-count source-result) 1)))))) 512))))
