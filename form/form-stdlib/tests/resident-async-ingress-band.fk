; resident-async-ingress-band.fk — cooperative async ingress semantics.
;
; Verdict 32767:
;   1 dynamic multi-channel offers are admitted independently
;   2 round-robin yield moves one envelope per cooperative quantum
;   4 nothing is distinct from accepted 0 and accepted 1
;   8 gas and capacity backpressure are observed without queue loss
;  16 timeout releases an expired envelope and preserves its alternative
;  32 cut is explicit and clears only the selected channel's water
;  64 release closes one channel while another keeps flowing
; 128 free inspection leaves the organ structurally unchanged
; 256 phase projection distinguishes gas, water, and full/ice
; 512 stale framebuffer control cannot actuate a newer exchange
;1024 correlated cut control actuates and is re-observable
;2048 bounded events retain the newest causal rows
;4096 a symbol absent at session start arrives, defines, and invokes by NodeID
;8192 replacement keeps the NodeID, advances version, and changes the result
;16384 wrong-NodeID invocation is nothing, not 0 or a borrowed binding
;
; preludes: form-stdlib/core.fk form-stdlib/substrate-phase.fk form-stdlib/form-eval-full.fk form-stdlib/resident-async-ingress.fk

(do
    (defn raib-bit (condition value) (if condition value 0))
    (let alpha "@0.2.0.100")
    (let beta "@0.2.0.101")
    (let start (rai-organ
        (list (rai-channel alpha 2 3 0) (rai-channel beta 2 3 0)) 4))
    (let a1 (rai-offer start (rai-envelope alpha 1 11 "task" "a" "alt-a" -1)))
    (let o1 (nth a1 0))
    (let b1 (rai-offer o1 (rai-envelope beta 2 21 "task" "b" "alt-b" -1)))
    (let o2 (nth b1 0))
    (let c0 (raib-bit (and (eq (nth a1 1) 1) (eq (nth b1 1) 1)) 1))

    (let y1 (rai-yield o2 100))
    (let y2 (rai-yield (nth y1 0) 100))
    (let c1 (raib-bit (and (str_eq (rai-env-payload (nth y1 1)) "a")
                        (and (str_eq (rai-env-payload (nth y2 1)) "b")
                             (str_eq (nth y2 2) "value"))) 2))

    (let idle (rai-yield (nth y2 0) 100))
    (let missing (rai-offer (nth idle 0)
        (rai-envelope "@0.2.0.missing" 3 30 "task" "x" "alt" -1)))
    (let tiny (rai-organ (list (rai-channel alpha 1 1 0)) 4))
    (let tiny1 (rai-offer tiny (rai-envelope alpha 1 31 "task" "x" "alt" -1)))
    (let tiny2 (rai-offer (nth tiny1 0)
        (rai-envelope alpha 2 32 "task" "y" "alt" -1)))
    (let c2 (raib-bit (and (nothing? (nth idle 1))
                        (and (nothing? (nth missing 1))
                            (and (eq (nth tiny1 1) 1) (eq (nth tiny2 1) 0)))) 4))
    (let c3 (raib-bit (and (str_eq (nth tiny2 2) "backpressure")
                        (and (eq (nth (rai-inspect-channel (nth tiny2 0) alpha) 16) 1)
                             (eq (nth (rai-inspect-channel (nth tiny2 0) alpha) 8) 1))) 8))

    (let exp0 (rai-organ (list (rai-channel alpha 3 3 0)) 4))
    (let exp1 (rai-offer exp0
        (rai-envelope alpha 1 41 "task" "late" "timeout-alt" 99)))
    (let expy (rai-yield (nth exp1 0) 100))
    (let c4 (raib-bit (and (str_eq (nth expy 2) "timeout")
                        (and (str_eq (rai-env-alternative (nth expy 1)) "timeout-alt")
                             (eq (nth (rai-inspect-channel (nth expy 0) alpha) 20) 1))) 16))

    (let cut0 (rai-organ
        (list (rai-channel alpha 3 3 0) (rai-channel beta 3 3 0)) 8))
    (let cut1 (nth (rai-offer cut0
        (rai-envelope alpha 1 51 "task" "keep?" "alt" -1)) 0))
    (let cut2 (nth (rai-offer cut1
        (rai-envelope beta 2 52 "task" "keep" "alt" -1)) 0))
    (let cut3 (rai-cut-channel cut2 alpha 53))
    (let c5 (raib-bit (and (eq (nth (rai-inspect-channel cut3 alpha) 8) 0)
                        (and (eq (nth (rai-inspect-channel cut3 beta) 8) 1)
                             (eq (nth (rai-inspect-channel cut3 alpha) 18) 1))) 32))
    (let rel (rai-release-channel cut3 alpha 54))
    (let rel-offer (rai-offer rel
        (rai-envelope alpha 3 55 "task" "closed" "alt" -1)))
    (let rel-yield (rai-yield (nth rel-offer 0) 100))
    (let c6 (raib-bit (and (eq (nth rel-offer 1) 0)
                        (and (str_eq (rai-env-payload (nth rel-yield 1)) "keep")
                             (str_eq (nth (rai-inspect-channel (nth rel-yield 0) alpha) 2)
                                 "released"))) 64))

    (let inspect-before (nth rel-yield 0))
    (let inspect-a (rai-inspect-channel inspect-before alpha))
    (let inspect-b (rai-inspect-channel inspect-before alpha))
    (let c7 (raib-bit (and (eq (nth inspect-a 6) (nth inspect-b 6))
                        (and (eq (rai-inspection-cost) 0)
                             (eq (len (rai-events inspect-before))
                                 (len (rai-events inspect-before))))) 128))

    (let phase0 (rai-organ (list (rai-channel alpha 2 3 0)) 4))
    (let phase1 (nth (rai-offer phase0
        (rai-envelope alpha 1 61 "task" "one" "alt" -1)) 0))
    (let phase2 (nth (rai-offer phase1
        (rai-envelope alpha 2 62 "task" "two" "alt" -1)) 0))
    (let c8 (raib-bit (and (eq (nth (rai-inspect-channel phase0 alpha) 4) (st-gas))
                        (and (eq (nth (rai-inspect-channel phase1 alpha) 4) (st-water))
                             (eq (nth (rai-inspect-channel phase2 alpha) 4) (st-ice)))) 256))

    (let ctrl0 (rai-organ (list (rai-channel alpha 3 3 0)) 8))
    (let ctrl1 (nth (rai-offer ctrl0
        (rai-envelope alpha 1 71 "task" "held" "alt" -1)) 0))
    (let outbound (rai-control-outbound ctrl1 alpha 72 0))
    (let stale (rai-control-message 1 71 1 8 0))
    (let stale-applied (rai-control-apply ctrl1 alpha outbound stale))
    (let c9 (raib-bit (and (eq (nth (rai-inspect-channel stale-applied alpha) 8) 1)
                        (eq (nth (rai-inspect-channel stale-applied alpha) 18) 0)) 512))
    (let correlated (rai-control outbound 8))
    (let cut-applied (rai-control-apply stale-applied alpha outbound correlated))
    (let c10 (raib-bit (and (eq (nth (rai-inspect-channel cut-applied alpha) 8) 0)
                         (eq (nth (rai-inspect-channel cut-applied alpha) 18) 1)) 1024))

    (let ev0 (rai-organ (list (rai-channel alpha 8 8 0)) 2))
    (let ev1 (nth (rai-offer ev0 (rai-envelope alpha 1 81 "task" "1" "a" -1)) 0))
    (let ev2 (nth (rai-offer ev1 (rai-envelope alpha 2 82 "task" "2" "a" -1)) 0))
    (let ev3 (nth (rai-offer ev2 (rai-envelope alpha 3 83 "task" "3" "a" -1)) 0))
    (let c11 (raib-bit (and (eq (len (rai-events ev3)) 2)
                         (and (eq (nth (nth (rai-events ev3) 0) 2) 82)
                              (eq (nth (nth (rai-events ev3) 1) 2) 83))) 2048))

    ; The session and organ exist before the symbol `live-shape` does.  Source
    ; arrives as channel data, not as this program's static defn.
    (let hot-id "@0.2.0.777")
    (let hot0 (rai-organ (list (rai-channel alpha 8 8 0)) 8))
    (let hot1 (nth (rai-offer hot0 (rai-envelope alpha 1 91 "recipe"
        "(defn live-shape (x) (add x 1))" hot-id -1)) 0))
    (let hot2 (nth (rai-offer hot1 (rai-envelope alpha 2 92 "invoke"
        "(live-shape 41)" hot-id -1)) 0))
    (let hoty1 (rai-yield hot2 100))
    (let hots1 (rai-session-step (rai-session) (nth hoty1 1)))
    (let hoty2 (rai-yield (nth hoty1 0) 100))
    (let hots2 (rai-session-step (rai-session-result-session hots1) (nth hoty2 1)))
    (let c12 (raib-bit (and (str_eq (rai-session-result-symbol hots1) "live-shape")
                         (and (str_eq (rai-session-result-nodeid hots2) hot-id)
                              (and (eq (rai-session-result-value hots2) 42)
                                   (eq (rai-session-result-version hots2) 1)))) 4096))

    (let hot3 (nth (rai-offer (nth hoty2 0) (rai-envelope alpha 3 93 "recipe"
        "(defn live-shape (x) (mul x 2))" hot-id -1)) 0))
    (let hot4 (nth (rai-offer hot3 (rai-envelope alpha 4 94 "invoke"
        "(live-shape 21)" hot-id -1)) 0))
    (let hoty3 (rai-yield hot4 100))
    (let hots3 (rai-session-step (rai-session-result-session hots2) (nth hoty3 1)))
    (let hoty4 (rai-yield (nth hoty3 0) 100))
    (let hots4 (rai-session-step (rai-session-result-session hots3) (nth hoty4 1)))
    (let c13 (raib-bit (and (eq (rai-session-result-version hots3) 2)
                         (and (eq (rai-session-result-version hots4) 2)
                              (eq (rai-session-result-value hots4) 42))) 8192))

    (let wrong (rai-session-invoke (rai-session-result-session hots4)
        "@0.2.0.wrong" "(live-shape 21)" 95))
    (let c14 (raib-bit (and (str_eq (rai-session-result-signal wrong)
                              "nodeid-mismatch")
                         (and (nothing? (rai-session-result-value wrong))
                              (not (eq (rai-session-result-value wrong) 0)))) 16384))

    (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14)))
