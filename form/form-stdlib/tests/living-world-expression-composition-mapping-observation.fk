; living-world-expression-composition-mapping-observation.fk -- mapping stage;
; no learned surface payload is emitted.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk form-stdlib/living-world-expression-composition.fk form-stdlib/tests/living-world-expression-blueprint-witness.fk form-stdlib/tests/living-world-expression-composition-witness.fk

(do
    (let mapping-c
        (lwo-emergent-shape (lwxcbw-sequence-candidate-c)))
    (let mapping-d
        (lwo-emergent-shape (lwxcbw-sequence-candidate-d)))
    (list
        (lwo-field-size
            (lwt-round-proposals (lwxcbw-sequence-round)))
        (lwo-field-size (lwr-mapping-supports mapping-c))
        (lwo-field-size (lwr-mapping-counterexamples mapping-c))
        (lwo-field-size (lwr-mapping-supports mapping-d))
        (lwo-field-size (lwr-mapping-counterexamples mapping-d))
        (lwxb-mapping-current? (lwxcbw-sequence-first-world)
            (lwxcbw-sequence-candidate-c))
        (lwxb-mapping-current? (lwxcbw-sequence-first-world)
            (lwxcbw-sequence-candidate-d))
        (lwxb-mapping-current? (lwxcbw-sequence-mapping-world)
            (lwxcbw-sequence-candidate-c))
        (lwxb-mapping-current? (lwxcbw-sequence-mapping-world)
            (lwxcbw-sequence-candidate-d))))
