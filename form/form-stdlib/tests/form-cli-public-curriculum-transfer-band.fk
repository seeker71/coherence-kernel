; form-cli-public-curriculum-transfer-band.fk — Expected: 255.
; The prompt admits public teaching plus caller question only.  Nothing stays
; distinct from an empty question and no held-out answer token is owned here.
; preludes: form-stdlib/bml/form-cli-public-curriculum-transfer.bml

(do
    (defn fcptb-bit (ok bit) (if ok bit 0))
    (let question "Return the requested expression only.")
    (let prompt (fcpt-prompt question))
    (sum (list
        (fcptb-bit (str_eq (fcpt-tag) "form-cli-public-curriculum-transfer-v1") 1)
        (fcptb-bit (str_eq (fcpt-kind) "public-bml-context") 2)
        (fcptb-bit (gt (fcpt-profile-bytes) 0) 4)
        (fcptb-bit (ge (str_find (fcpt-profile) "nothing is distinct from 0 and 1" 0) 0) 8)
        (fcptb-bit (ge (str_find (fcpt-profile) "weight update" 0) 0) 16)
        (fcptb-bit (ge (str_find prompt (fcpt-question-prefix) 0) 0) 32)
        (fcptb-bit (ge (str_find prompt question 0) 0) 64)
        (fcptb-bit (nothing? (fcpt-prompt (nothing))) 128))))
