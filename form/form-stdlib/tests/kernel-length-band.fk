; kernel-length-band.fk — the length lens reads what an emitted unit will hand the compiler:
; a kernel's name, its bytes, its statements and the loops they sit inside, on a unit written
; here so the reading is checkable by eye and moves with no emitter.
; Expected: 63
; preludes: form/form-stdlib/kernel-length-lens.bml
(do
    (let unit (str_concat "#include <metal_stdlib>\nkernel void a_one(device float* y [[buffer(0)]], uint g [[thread_position_in_grid]]) { float s = 0.0f; for (uint i = 0; i < 4; i++) { s += 1.0f; } y[g] = s; }\n"
                          "kernel void b_two(device float* y [[buffer(0)]], uint g [[thread_position_in_grid]]) { float s = 0.0f; while (s < 3.0f) { for (uint i = 0; i < 2; i++) { s += 1.0f; } } y[g] = s; }\n"))
    (let rows (kl-rows unit))
    (let a (kl-find rows "a_one"))
    (let b (kl-find rows "b_two"))
    (let c1 (if (eq (len rows) 2) 1 0))
    (let c2 (if (and (str_eq (kl-name a) "a_one") (str_eq (kl-name b) "b_two")) 2 0))
    (let c3 (if (eq (kl-statements-of a) 3) 4 0))
    (let c4 (if (eq (kl-loops-of a) 1) 8 0))
    (let c5 (if (eq (kl-loops-of b) 2) 16 0))
    (let c6 (if (eq (kl-total rows 0) 6) 32 0))
    (print_str (str_concat "a: " (str_concat (kl-line a) (str_concat " | b: " (kl-line b)))))
    (print (add c1 (add c2 (add c3 (add c4 (add c5 c6))))))) 
