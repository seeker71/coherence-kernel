    (defn form-local-reasoning-category-coherence-band ()
        (do
            (let categories (flrccb-categories))
            (sum (list
                (if (eq (len categories) 67) 1 0)
                (if (eq (flrccb-pairwise-distinct? categories) 1) 2 0)
                (if (eq (flrccb-same-list? categories (flrccb-expected)) 1)
                    4 0)))))

    (form-local-reasoning-category-coherence-band))
