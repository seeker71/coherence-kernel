; form-local-reasoning-category-coherence-band.fk — the independently born
; NodeID protocols still compose without assigning two meanings one identity.
;
; This is an observation band, not a runtime registry or dispatch table. Each
; protocol continues to own and generate its own categories where it lives.
;
; Verdict 7:
;   1  all 67 public categories are present in this joined source surface
;   2  every category is pairwise distinct
;   4  each category retains the coordinate its defining protocol witnesses
;
; preludes: form-stdlib/form-cli-ask.fk
; preludes: form-stdlib/form-knowledge-query-token.fk
; preludes: form-stdlib/form-cli-heed-current-source.fk
; preludes: form-stdlib/form-recipe-native-thought-cross-cell.fk
; preludes: form-stdlib/form-recipe-birth-token.fk
; preludes: form-stdlib/public-source-concept-index.fk
; preludes: form-stdlib/form-nodeid-knowledge-query.fk
; preludes: form-stdlib/form-cli-resident-recipe-birth-exec-categories.fk
; preludes: form-stdlib/form-nodeid-mastery-cell-categories.fk

(do
    (defn flrccb-all-different-from? (x rest)
        (if (eq (len rest) 0) 1
            (if (node_eq x (head rest)) 0
                (flrccb-all-different-from? x (tail rest)))))

    (defn flrccb-pairwise-distinct? (xs)
        (if (lt (len xs) 2) 1
            (if (eq (flrccb-all-different-from? (head xs) (tail xs)) 1)
                (flrccb-pairwise-distinct? (tail xs)) 0)))

    (defn flrccb-same-list? (actual expected)
        (if (eq (len actual) 0) (if (eq (len expected) 0) 1 0)
            (if (eq (len expected) 0) 0
                (if (node_eq (head actual) (head expected))
                    (flrccb-same-list? (tail actual) (tail expected)) 0))))

