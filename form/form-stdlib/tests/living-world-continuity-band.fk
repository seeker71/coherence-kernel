; living-world-continuity-band.fk -- a continuity image stays inert, then asks.
; Verdict 32767 proves fifteen identity, manifest, consent, and tamper claims.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-enquiry.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-capability-context.fk form-stdlib/tests/living-world-recursive-witness.fk form-stdlib/tests/living-world-continuity-witness.fk

(do
    (let snapshot (lwcnw-snapshot-world))
    (let image (lwcn-image snapshot))
    (let rederived (lwcn-image snapshot))
    (let admission (lwcnw-admission-world image))
    (let proposal (lwcnw-restore-proposal admission image))
    (let candidate (lwt-proposal-candidate proposal))
    (let round (lwcnw-restore-round admission proposal))
    (let waiting
        (lwcn-integrate-restore round proposal (lwrrw-action)))
    (let yes-round (lwcnw-restore-yes-round round proposal))
    (let successful
        (lwcn-integrate-restore yes-round proposal (lwrrw-action)))
    (let restored-world (lwt-round-world successful))

    (let tampered (lwcnw-tampered-image))
    (let tampered-admission (lwcnw-admission-world tampered))
    (let tampered-proposal
        (lwcnw-restore-proposal tampered-admission tampered))

    ; Revoking the custodian's offered image after all holder responses makes
    ; the exact proposal stale on a sibling branch.
    (let revoked-admission
        (lwt-receive-stream (lwt-round-world yes-round)
            (list
                (lwrrw-entry (lwrrw-source-e)
                    (lwo-revocation image (lwrrw-source-e)
                        (lwcnw-release-reason) (lwrrw-provenance-e))
                    (lwrrw-provenance-e)))))
    (let revoked-round
        (lwt-round revoked-admission
            (lwo-field-add (lwo-empty-field) proposal)
            (lwo-empty-field) yes-round))
    (let revoked-integration
        (lwcn-integrate-restore
            revoked-round proposal (lwrrw-action)))

    (let c1 (if (eq (lwcn-image-valid? image) 1) 1 0))
    (let c2 (if (node_eq rederived image) 2 0))
    (let c3 (if (node_eq
                    (lwcn-image-world image) snapshot) 4 0))
    (let c4 (if (node_eq
                    (lwcn-image-manifest image)
                    (lwcn-manifest snapshot)) 8 0))
    (let c5 (if (node_eq
                    (lwcn-image-manifest rederived)
                    (lwcn-manifest snapshot)) 16 0))
    (let c6 (if (and (eq (lwo-active? admission image) 1)
                         (eq (lwo-active? admission
                              (lwrrw-correspondence-a)) 0)) 32 0))
    (let c7 (if (and (eq (lwo-field-size
                              (lwt-proposal-participants proposal)) 4)
                         (eq (lwo-field-size
                              (lwo-emergent-witnesses candidate)) 1)) 64 0))
    (let c8 (if (eq (lwo-world-has?
                         (lwt-round-world waiting) candidate) 0) 128 0))
    (let c9 (if (and (eq (lwcn-restored?
                              restored-world candidate) 1)
                         (eq (lwo-field-size
                              (lwo-active-attributions-for
                                restored-world candidate)) 4)) 256 0))
    (let c10 (if (and (eq (lwo-active?
                               restored-world
                               (lwrrw-correspondence-a)) 1)
                          (eq (lwo-active?
                               restored-world (lwcnw-focus)) 1)) 512 0))
    (let c11 (if (and (eq (lwo-active?
                               restored-world (lwcnw-retired)) 0)
                          (eq (lwo-field-size
                               (lwo-world-revocations restored-world)) 1)) 1024 0))
    (let c12 (if (eq (lwo-active?
                          restored-world image) 0) 2048 0))
    (let c13 (if (and (eq (lwcn-image-valid? tampered) 0)
                          (node_eq tampered-proposal (lwo-none))) 4096 0))
    (let c14 (if (and (eq (lwcn-restore-current?
                               revoked-admission candidate) 0)
                          (eq (lwo-world-has?
                               (lwt-round-world revoked-integration)
                               candidate) 0)) 8192 0))
    (let c15 (if (eq (lwcn-restored?
                          restored-world candidate) 1) 16384 0))
    (lwcnw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
