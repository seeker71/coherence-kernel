; living-world-hypothesis-revision-nursery-witness.fk -- contradicted Recipes
; may be re-attempted, remembered, and rejected without promotion.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk

(let LWHRNW-SOURCE-T (bp "LWHRNW-SOURCE-T"))
(let LWHRNW-SOURCE-U (bp "LWHRNW-SOURCE-U"))
(let LWHRNW-SOURCE-V (bp "LWHRNW-SOURCE-V"))
(let LWHRNW-SOURCE-W (bp "LWHRNW-SOURCE-W"))
(let LWHRNW-RESULT   (bp "LWHRNW-RESULT"))

(defn lwhrnw-cell (kind) (intern_node kind (empty)))
(defn lwhrnw-source-t () (lwhrnw-cell LWHRNW-SOURCE-T))
(defn lwhrnw-source-u () (lwhrnw-cell LWHRNW-SOURCE-U))
(defn lwhrnw-source-v () (lwhrnw-cell LWHRNW-SOURCE-V))
(defn lwhrnw-source-w () (lwhrnw-cell LWHRNW-SOURCE-W))

(defn lwhrnw-recipe-at (target at)
    (lwph-hypothesis-recipe
        (lwht-receipt-hypothesis
            (nth (lwo-field-items
                    (lwht-tissue-receipts
                        (lwo-emergent-shape target))) at))))
(defn lwhrnw-offer (target recipe)
    (lwhrn-offer target recipe (lwo-none) (lwo-none)
        (lwht-tissue-alternatives (lwo-emergent-shape target))
        (lwlc-unknown target) (lwo-none) (lwo-none) (lwpow-evidence)))
(defn lwhrnw-offer-world (world first second)
    (lwt-receive-stream world
        (list
            (lwpow-entry (lwhrnw-source-t) first)
            (lwpow-entry (lwhrnw-source-u) first)
            (lwpow-entry (lwhrnw-source-v) second)
            (lwpow-entry (lwhrnw-source-w) second))))
(defn lwhrnw-release-first (world first)
    (lwt-receive-stream world
        (list
            (lwpow-entry (lwhrnw-source-t)
                (lwo-revocation first (lwhrnw-source-t)
                    (lwpow-reason) (lwpow-evidence)))
            (lwpow-entry (lwhrnw-source-u)
                (lwo-revocation first (lwhrnw-source-u)
                    (lwpow-reason) (lwpow-evidence))))))

(defn lwhrnw-all-evaluation-count? (items wanted)
    (if (eq (len items) 0) 1
        (if (eq (lwo-field-size
                    (lwhrn-trial-evaluations (head items))) wanted)
            (lwhrnw-all-evaluation-count? (tail items) wanted) 0)))

(defn lwhrnw-result
    (outcome-result target tissue-world open-field first second attempt-world
     field proposal candidate waiting admitted revoked-world revoked-field
     events)
    (intern_node LWHRNW-RESULT
        (list outcome-result target tissue-world open-field first second
              attempt-world field proposal candidate waiting admitted
              revoked-world revoked-field events)))

(defn lwhrnw-run ()
    (do
        (let outcome-result (lwpow-run))
        (let target (nth (node_children outcome-result) 18))
        (let tissue-world (nth (node_children outcome-result) 19))
        (let started
            (lcfb-open-stream "living-world-hypothesis-revision-nursery"
                "form-native" "lwhrnw-run"
                "contradicted-tissue-to-open-recipe-attempts"
                "form/form-stdlib/tests/living-world-hypothesis-revision-nursery-witness.fk"
                74 14))
        (let open-field (lwhrn-field-for tissue-world target 2))
        (let open-frame
            (lcfb-call-stream "living-world-hypothesis-revision-nursery"
                "open" "leave" "form-native" "lwhrn-field-for"
                "attempts:0:viable:0:open:1" 1 started
                "form/form-stdlib/tests/living-world-hypothesis-revision-nursery-witness.fk"
                82 14))
        (let first
            (lwhrnw-offer target (lwhrnw-recipe-at target 0)))
        (let second
            (lwhrnw-offer target (lwhrnw-recipe-at target 1)))
        (let attempt-world
            (lwhrnw-offer-world tissue-world first second))
        (let offered-frame
            (lcfb-call-stream "living-world-hypothesis-revision-nursery"
                "offers" "leave" "form-native" "lwhrn-offers-for"
                "distinct-attempts:2:recurrence-each:2" 2 started
                "form/form-stdlib/tests/living-world-hypothesis-revision-nursery-witness.fk"
                95 14))
        (let field (lwhrn-field-for attempt-world target 2))
        (let field-frame
            (lcfb-call-stream "living-world-hypothesis-revision-nursery"
                "trials" "leave" "form-native" "lwhrn-field-for"
                (lwhrn-progress-target field) 3 started
                "form/form-stdlib/tests/living-world-hypothesis-revision-nursery-witness.fk"
                102 14))
        (let proposal (lwhrn-proposal-for attempt-world target 2))
        (let candidate (lwt-proposal-candidate proposal))
        (let waiting
            (lwhrn-integrate
                (lwpow-round-for attempt-world proposal (lwo-none))
                proposal (lwphw-action)))
        (let responded-world (lwpow-respond-all attempt-world proposal))
        (let admitted
            (lwhrn-integrate
                (lwpow-round-for responded-world proposal waiting)
                proposal (lwphw-action)))
        (let integrated-frame
            (lcfb-call-stream "living-world-hypothesis-revision-nursery"
                "field" "leave" "form-native" "lwhrn-integrate"
                "open-attempt-field-current:1:recipe-promotion:0" 4 started
                "form/form-stdlib/tests/living-world-hypothesis-revision-nursery-witness.fk"
                120 14))
        (let admitted-world (lwt-round-world admitted))
        (let revoked-world (lwhrnw-release-first admitted-world first))
        (let revoked-field (lwhrn-field-for revoked-world target 2))
        (let revoked-frame
            (lcfb-call-stream "living-world-hypothesis-revision-nursery"
                "revocation" "leave" "form-native" "lwhrn-field-for"
                "attempts:2->1:prior-current:1->0:history-retained" 5 started
                "form/form-stdlib/tests/living-world-hypothesis-revision-nursery-witness.fk"
                132 14))
        (let events (framebuffer-events))
        (lwhrnw-result outcome-result target tissue-world open-field first second
            attempt-world field proposal candidate waiting admitted revoked-world
            revoked-field events)))

0
