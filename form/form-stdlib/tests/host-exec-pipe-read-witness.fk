; host-exec-pipe-read-witness.fk — fkwu-only checkout witness for the raw
; descriptor read used after popen. This guards the warning-free stdio seam.
;
; SINGLE-WITNESS (fkwu): host-exec is an intentional host port, not a
; four-way-pure operation.
; witnessed: 2026-07-25 -> 1 on fkwu
; preludes: form-stdlib/core.fk

(do
    (if (str_eq
            (host-exec "printf fkwu-pipe-read" "")
            "fkwu-pipe-read")
        1
        0))
