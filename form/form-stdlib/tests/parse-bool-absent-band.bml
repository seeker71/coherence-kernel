; parse-bool-absent-band.bml — parse-bool reads a reading that did not arrive as nothing(), never a stop (parse.bml, parse-bool).
;
; Expected: 15
; Verdict 15 when every claim lands:
;   1   an absent reading answers nothing()
;   2   the spellings read 1 and 0, trimmed
;   4   a word that is no bool answers nothing()
;   8   a value that is not text answers nothing(), though it renders as a spelling only a rendering would make
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/parse.bml
section [form.bml] {
 class ParseBoolAbsentBand {
  def pba-is?(v, want) = ((String) value_kind(v) == "int") && ((Comparable) v == want);
  def pba-c-absent(ctx) = nothing?(parse-bool(nothing()));
  def pba-c-words(ctx) = pba-is?(parse-bool(" true "), 1) && pba-is?(parse-bool("False"), 0) && pba-is?(parse-bool("TRUE"), 1);
  def pba-c-other(ctx) = nothing?(parse-bool("yes")) && nothing?(parse-bool("")) && pba-is?(parse-bool("false"), 0);
  def pba-c-kind(ctx) = nothing?(parse-bool(1)) && nothing?(parse-bool(["true"])) && pba-is?(parse-bool("true"), 1);
 }
 live-claims("parse-bool-absent-band", 0, [["absent", 1, 1, pba-c-absent], ["words", 2, 1, pba-c-words], ["other", 4, 1, pba-c-other], ["kind", 8, 1, pba-c-kind]]);
}
