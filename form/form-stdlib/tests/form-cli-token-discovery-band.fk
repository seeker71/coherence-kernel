; form-cli-token-discovery-band.fk — the token reading exists without a human
; step.  A synthetic agent transcript is written here, discovered by mtime, and
; read through the same collector the share runner uses; the six counters come
; back exact, the decoys stay out of the arithmetic, and an explicit binding
; still wins over discovery.
; Expected: 1048575
;
; preludes: form-stdlib/core.fk form-stdlib/language-template.fk
; preludes: form-stdlib/line-grammar.fk form-stdlib/form-fs.fk
; preludes: form-stdlib/form-cli-turn-evidence.fk
; preludes: form-stdlib/form-cli-turn-evidence-live.fk
; preludes: form-stdlib/form-glass-telemetry-membrane.bml form-stdlib/hearth.bml
; preludes: form-stdlib/bml/form-cli-token-glass.bml

(do
    ; ── a fixture tree of this process's own, so two bands never share one ──
    (let root (str_concat "/tmp/form-cli-token-discovery-"
        (int_to_str (host_pid))))
    (let home (str_concat root "/home"))
    (let dot (str_concat home "/.claude"))
    (let projects (str_concat dot "/projects"))
    (let tree-a (str_concat projects "/-x-coherence-kernel-tree-a"))
    (let tree-b (str_concat projects "/-x-coherence-kernel-tree-b"))
    (let other (str_concat projects "/-x-another-body"))
    (let _r (fs-remove-tree root))
    (let _0 (fs-mkdir root))
    (let _1 (fs-mkdir home))
    (let _2 (fs-mkdir dot))
    (let _3 (fs-mkdir projects))
    (let _4 (fs-mkdir tree-a))
    (let _5 (fs-mkdir tree-b))
    (let _6 (fs-mkdir other))

    ; ── the rows an agent host actually writes ──
    ; The real reading: fresh input, cache write, cache read, output, thinking.
    ; This provider reports the three input parts side by side and no total, so
    ; the canonical input is 100 + 7 + 9000 and the total is that plus output.
    (let good
        "{\"parentUuid\":\"p1\",\"isSidechain\":false,\"message\":{\"id\":\"msg_1\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"a\"}],\"usage\":{\"input_tokens\":100,\"cache_creation_input_tokens\":7,\"cache_read_input_tokens\":9000,\"output_tokens\":250,\"output_tokens_details\":{\"thinking_tokens\":40},\"server_tool_use\":{\"web_search_requests\":0}}},\"type\":\"assistant\",\"uuid\":\"u1\"}")
    ; An older sitting, so a wrong file choice answers 4 instead of 9357.
    (let older
        "{\"parentUuid\":\"p0\",\"message\":{\"id\":\"msg_0\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"usage\":{\"input_tokens\":1,\"cache_creation_input_tokens\":1,\"cache_read_input_tokens\":1,\"output_tokens\":1,\"output_tokens_details\":{\"thinking_tokens\":1}}},\"type\":\"assistant\",\"uuid\":\"u0\"}")
    ; Decoy: a tool result carrying a whole shaped usage object as text.  Its
    ; bytes are escaped, so it is content twice over -- the row's own type is
    ; user, and the object never existed as structure.
    (let decoy-escaped
        "{\"parentUuid\":\"p2\",\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"content\":\"{\\\"type\\\":\\\"assistant\\\",\\\"message\\\":{\\\"usage\\\":{\\\"input_tokens\\\":999,\\\"cache_read_input_tokens\\\":888,\\\"output_tokens\\\":777}}}\"}]},\"uuid\":\"u2\"}")
    ; Decoy: the same shape as real structure, nested one level down in a user
    ; row.  Its bytes pass any marker prefilter; only the typed position refuses
    ; it, which is the claim worth making.
    (let decoy-nested
        "{\"parentUuid\":\"p3\",\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"x\"}],\"quoted\":{\"type\":\"assistant\",\"message\":{\"usage\":{\"input_tokens\":999,\"cache_read_input_tokens\":888,\"cache_creation_input_tokens\":5,\"output_tokens\":777}}}},\"uuid\":\"u3\"}")
    ; Decoy: a cumulative usage object sitting beside the per-call one.  The
    ; per-call object is the evidence; the cumulative numbers are a rollout
    ; total and never enter arithmetic.
    (let decoy-cumulative
        "{\"parentUuid\":\"p4\",\"message\":{\"id\":\"msg_4\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"total_token_usage\":{\"input_tokens\":500000,\"cache_read_input_tokens\":400000,\"cache_creation_input_tokens\":300,\"output_tokens\":90000},\"usage\":{\"input_tokens\":11,\"cache_creation_input_tokens\":3,\"cache_read_input_tokens\":22,\"output_tokens\":5,\"output_tokens_details\":{\"thinking_tokens\":1}}},\"type\":\"assistant\",\"uuid\":\"u4\"}")
    ; Decoy: a string where an integer belongs.  A count that is not a number
    ; refuses the whole row rather than being coerced.
    (let decoy-string
        "{\"parentUuid\":\"p5\",\"message\":{\"id\":\"msg_5\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"usage\":{\"input_tokens\":\"120\",\"cache_read_input_tokens\":9,\"output_tokens\":30}},\"type\":\"assistant\",\"uuid\":\"u5\"}")
    ; The other provider's row, unchanged: it must still read exactly as it did
    ; before a second schema position existed.
    (let codex
        "{\"type\":\"event_msg\",\"payload\":{\"type\":\"token_count\",\"info\":{\"last_token_usage\":{\"input_tokens\":8,\"cached_input_tokens\":3,\"cache_write_input_tokens\":1,\"output_tokens\":2,\"reasoning_output_tokens\":1,\"total_tokens\":10}}}}")

    (let newer-body (str_concat decoy-escaped (str_concat "\n"
        (str_concat decoy-nested (str_concat "\n"
        (str_concat decoy-cumulative (str_concat "\n"
        (str_concat decoy-string (str_concat "\n"
        (str_concat good "\n"))))))))))
    ; Written oldest first, and named so that a name-ordered walk would pick the
    ; wrong one.  A whole second apart, because a modification time is seconds.
    (let older-path (str_concat tree-a "/z-first-sitting.jsonl"))
    (let newer-path (str_concat tree-a "/a-second-sitting.jsonl"))
    (let _w0 (write_file_text older-path (str_concat older "\n")))
    (let _s0 (host_sleep_ms 1100))
    (let _w1 (write_file_text newer-path newer-body))
    (let _s1 (host_sleep_ms 1100))
    ; A session of a body that is not this repository, newest of all: the
    ; fallback must still refuse it.
    (let _w2 (write_file_text (str_concat other "/newest.jsonl")
        (str_concat good "\n")))
    ; A session directory holding no transcript at all.
    (let _w3 (write_file_text (str_concat tree-b "/notes.txt") "not a transcript\n"))

    ; ── discovery ──
    (let picked (fctd-newest-in tree-a))
    (let c0 (if (and (eq (fctd-newest-some? picked) 1)
                     (str_eq (fctd-newest-path picked) newer-path)) 1 0))
    (let c1 (if (eq (fctd-newest-some? (fctd-newest-in tree-b)) 0) 2 0))
    (let c2 (if (eq (fctd-newest-some? (fctd-newest-in
                    (str_concat root "/nowhere"))) 0) 4 0))
    (let fallback (fctd-newest-for-repo projects "coherence-kernel"))
    (let c3 (if (str_eq (fctd-newest-path fallback) newer-path) 8 0))
    (let c4 (if (eq (fctd-newest-some?
                    (fctd-newest-for-repo projects "no-such-body")) 0) 16 0))
    (let c5 (if (str_eq (fctd-home-go (str_concat home "/a/deep/place") 64)
                    home) 32 0))
    (let c6 (if (str_eq (fctd-slug "/Users/x/source/coherence-kernel/.claude/w")
                    "-Users-x-source-coherence-kernel--claude-w") 64 0))

    ; ── the explicit binding still wins ──
    (let explicit "/tmp/form-cli-token-discovery-explicit.jsonl")
    (let c7 (if (and (str_eq (fctd-resolve explicit) explicit)
                     (str_eq (fctd-source-kind explicit newer-path)
                         "explicit-binding")) 128 0))
    (let c8 (if (and (str_eq (fctd-source-kind "" newer-path)
                        "discovered-agent-transcript")
                     (str_eq (fctd-source-kind "" "") "unavailable")) 256 0))

    ; ── the six counters, read from the discovered file by the collector ──
    (let state (fctel-last-usage-state (fctd-newest-path picked)))
    (let c9 (if (eq (nth state 0) 1) 512 0))
    (let c10 (if (eq (nth state 1) 9107) 1024 0))
    (let c11 (if (eq (nth state 2) 9000) 2048 0))
    (let c12 (if (eq (nth state 3) 7) 4096 0))
    (let c13 (if (and (eq (nth state 4) 250) (eq (nth state 5) 40)) 8192 0))
    ; The total this provider never reports, computed from the parts it does,
    ; and the attribution gap it leaves: none.
    (let c14 (if (and (eq (nth state 6) 9357)
                      (eq (frte-unattributed (nth state 1) (nth state 4)
                          (nth state 6)) 0)) 16384 0))

    ; ── the decoys, refused where they stand ──
    (let c15 (if (and (eq (frte-call-local-usage-line? decoy-escaped) 0)
                 (and (eq (frte-call-local-usage-line? decoy-nested) 0)
                      (eq (frte-call-local-usage-line? decoy-string) 0)))
                32768 0))
    ; The cumulative row is a real reading -- of its per-call object only.
    (let c16 (if (and (eq (frte-call-local-usage-line? decoy-cumulative) 1)
                 (and (eq (frte-call-local-usage-int-or decoy-cumulative
                          "input_tokens" 0) 36)
                 (and (eq (frte-call-local-usage-int-or decoy-cumulative
                          "cached_input_tokens" 0) 22)
                 (and (eq (frte-call-local-usage-int-or decoy-cumulative
                          "reasoning_output_tokens" 0) 1)
                      (eq (frte-call-local-total decoy-cumulative) 41)))))
                65536 0))
    ; ── the other provider, unmoved ──
    (let c17 (if (and (eq (frte-call-local-usage-line? codex) 1)
                 (and (eq (frte-call-local-total codex) 10)
                 (and (eq (frte-call-local-usage-int-or codex
                          "input_tokens" 0) 8)
                 (and (eq (frte-call-local-usage-int-or codex
                          "cached_input_tokens" 0) 3)
                      (eq (frte-call-local-usage-int-or codex
                          "reasoning_output_tokens" 0) 1)))))
                131072 0))

    ; ── the reading reaches the glass ──
    ; Seven samples the membrane accepts, each carrying the source that
    ; answered as its own channel word, so a number on the frame is never
    ; separated from what it is worth.
    (let given (fctg-samples 1000 state "discovered-agent-transcript" "found"))
    (let c18 (if (and (eq (len given) 7)
                 (and (eq (fgtm-samples-valid? given) 1)
                 (and (eq (fgtm-field-value (fgtm-sample-capacity
                          (nth given 0))) 9357)
                 (and (eq (fgtm-field-value (fgtm-sample-capacity
                          (nth given 1))) 9107)
                 (and (str_eq (fgtm-sample-lifecycle (nth given 0)) "active")
                      (str_eq (nth (fgtm-sample-channels (nth given 0)) 4)
                          "discovered-agent-transcript"))))))
                262144 0))
    ; And where no source stands the root is still given: capacity absent,
    ; lifecycle unknown, the reason named.  An absence stays on the glass as
    ; an absence rather than disappearing from it.
    (let none (fctg-samples 1000 (fctel-state) "unavailable"
        "no-session-for-this-tree-or-repository"))
    (let c19 (if (and (eq (len none) 1)
                 (and (eq (fgtm-samples-valid? none) 1)
                 (and (str_eq (fgtm-sample-lifecycle (nth none 0)) "unknown")
                 (and (eq (fgtm-field-present? (fgtm-sample-capacity
                          (nth none 0))) 0)
                      (str_eq (nth (fgtm-sample-channels (nth none 0)) 4)
                          "no-session-for-this-tree-or-repository")))))
                524288 0))

    (let _clean (fs-remove-tree root))
    (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17
        c18 c19)))
