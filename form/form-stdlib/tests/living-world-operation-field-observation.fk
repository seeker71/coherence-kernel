; living-world-operation-field-observation.fk -- aggregate, content-safe readout.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk form-stdlib/living-world-operation-field.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-structural-recipe-witness.fk form-stdlib/tests/living-world-operation-field-witness.fk

(do
    (let base (lwoew-build-base))
    (let base-field (lwoew-base-field base))
    (let base-answer (lwoew-base-answer base))
    (let evolved (lwoew-build-evolved))
    (let evolved-field (lwoew-evolved-field evolved))
    (let evolved-answer (lwoew-evolved-answer evolved))
    (let revoked (lwoew-revoked-example-world evolved))
    (let silence-world (lwoew-silence-world base))
    (let silence-field
        (lwoe-field-for silence-world (lwoew-enquiry)
            (lwoew-codecs (lwoew-base-schema base)) 2))
    (list
        (list
            (lwo-field-size (lwoe-field-examples base-field))
            (lwo-field-size (lwoe-field-profiles base-field))
            (lwo-field-size (lwoe-field-compatible base-field))
            (lwo-field-size (lwoe-field-contradicted base-field))
            (lwo-field-size (lwoe-field-unresolved base-field))
            (lwo-field-size (lwoe-field-classes base-field))
            (lwo-field-size
                (lwoe-class-profiles
                    (head (lwo-field-items
                        (lwoe-field-classes base-field)))))
            (lwph-singular? (lwoe-field-status base-field)))
        (list
            (lwo-field-size (lwoe-answer-evaluations base-answer))
            (lwo-field-size (lwoe-answer-outputs base-answer))
            (oac-node? (lwoe-answer-immediate-ack base-answer))
            (oac-time-pending?
                (lwoe-answer-time-observation base-answer))
            (lwoe-answer-current?
                (lwoew-base-world-cell base) base-answer))
        (list
            (lwo-field-size (lwoe-field-examples evolved-field))
            (lwo-field-size (lwoe-field-profiles evolved-field))
            (lwo-field-size (lwoe-field-compatible evolved-field))
            (lwo-field-size (lwoe-field-contradicted evolved-field))
            (lwo-field-size (lwoe-field-unresolved evolved-field))
            (lwo-field-size (lwoe-field-classes evolved-field))
            (lwo-field-size
                (lwoe-class-profiles
                    (head (lwo-field-items
                        (lwoe-field-classes evolved-field)))))
            (len
                (node_children
                    (lwoe-class-signature
                        (head (lwo-field-items
                            (lwoe-field-classes evolved-field))))))
            (lwo-field-size (lwoe-answer-evaluations evolved-answer))
            (lwo-field-size (lwoe-answer-outputs evolved-answer))
            (oac-one? (lwoe-answer-immediate-ack evolved-answer))
            (node_value
                (oac-payload
                    (lwoe-answer-immediate-ack evolved-answer))))
        (list
            (lwoe-candidate-current?
                (lwoew-evolved-world evolved)
                (lwoew-base-candidate (lwoew-evolved-base evolved)))
            (lwoe-answer-current?
                (lwoew-evolved-world evolved)
                (lwoew-base-answer (lwoew-evolved-base evolved)))
            (lwoe-candidate-current?
                revoked (lwoew-evolved-candidate evolved))
            (lwoe-candidate-current?
                revoked (lwoew-base-candidate
                    (lwoew-evolved-base evolved)))
            (lwoe-answer-current?
                revoked (lwoew-base-answer
                    (lwoew-evolved-base evolved))))
        (list
            (lwo-field-size (lwoe-field-compatible silence-field))
            (lwo-field-size (lwoe-field-contradicted silence-field))
            (lwo-field-size (lwoe-field-unresolved silence-field))
            (lwo-field-size (lwoe-field-classes silence-field))
            (lwoe-example-valid?
                (lwoew-silence-example (lwoew-base-schema base)))
            (lwoe-example-valid?
                (lwoew-zero-example (lwoew-base-schema base))))))
