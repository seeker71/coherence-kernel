; preludes: form/form-stdlib/whisper-shape.bml
; Expected: 127
; PROOF LEVEL: FKWU-STAGED — it preludes a .bml and reads two model files off this host.
;
; whisper-shape-band — the model's shape comes from the model.
;
; ear-native.fk carries ninety typed-in numbers and every one is whisper-TINY's: D 384, H 6,
; F 1536, V 51865, four encoder layers, eighty mels, and eight special-token ids. The pass is the
; body's own kernels and the floor is this Mac's own bandwidth (388.52 GB/s, measured today), so
; nothing about the hardware chooses tiny. Ninety numbers do (corpus row 1417 tinyweld).
;
; Bit 1 is the one that matters: the reader is proven against the constants it replaces. It is
; only allowed to be trusted on a model the ear cannot run because it first agrees, number for
; number, with the model the ear does run.
;
; Verdict 63:
;   1   the door reads tiny's own .npz and every dimension equals the constant ear-native carries
;   2   the same door, no branch at the call site, reads large-v3-turbo out of a safetensors file
;   4   and reads it right: D 1280, 32 encoder blocks, 4 decoder blocks, 128 mels, V 51866
;   8   the special tokens derive from V alone and reproduce tiny's typed-in ids, including the
;       exclusive language END the ear scans to (50358) and the last language itself (50357)
;   16  at V 51866 that ladder shifts by one — 100 tongues, and every id the ear has written down
;       is off by one on this model, so the constants are not merely narrow, they are wrong there
;   32  a tensor the file does not carry answers as an absence, never a plausible 0
;   64  the model says what a pass over it COSTS: turbo's encoder is 1211 MiB and its decoder
;       step 327 MiB, read off the file's own offsets — at the 388.52 GB/s this Mac measured
;       today that is a 3.27 ms floor for the encoder, against the 2.85 ms whisper-TINY's encode
;       MEASURES right now. The body already spends, in wall time, what the ceiling model would
;       cost at its floor
(do
    (defn wsb-snap (repo)
        (str_concat "/Users/ursmuff/.cache/huggingface/hub/models--" (str_concat repo
        (str_concat "/snapshots/" (trim (read_file (str_concat "/Users/ursmuff/.cache/huggingface/hub/models--" (str_concat repo "/refs/main"))))))))
    (let tiny (ws-open (str_concat (wsb-snap "mlx-community--whisper-tiny") "/weights.npz")))
    (let turbo (ws-open (str_concat (wsb-snap "mlx-community--whisper-large-v3-turbo") "/weights.safetensors")))
    (let vt (ws-V tiny))
    (let vl (ws-V turbo))
    (let c0 (if (and (and (eq (ws-D tiny) 384) (eq (ws-F tiny) 1536))
                (and (and (eq (ws-H tiny) 6) (eq vt 51865))
                     (and (eq (ws-CTX tiny) 448) (and (eq (ws-mels tiny) 80) (and (eq (ws-enc-layers tiny) 4) (eq (ws-dec-layers tiny) 4)))))) 1 0))
    (let c1 (if (and (str_eq (ws-kind tiny) "npz") (str_eq (ws-kind turbo) "safetensors")) 2 0))
    (let c2 (if (and (and (eq (ws-D turbo) 1280) (eq (ws-enc-layers turbo) 32))
                (and (eq (ws-dec-layers turbo) 4) (and (eq (ws-mels turbo) 128) (eq vl 51866)))) 4 0))
    ; tiny's eight, as ear-native.fk writes them down today
    (let c3 (if (and (and (eq (ws-ts0 vt) 50364) (eq (ws-notimestamps vt) 50363))
                (and (and (eq (ws-nospeech vt) 50362) (eq (ws-transcribe vt) 50359))
                     (and (and (eq (ws-lang-last vt) 50357) (eq (ws-lang-end vt) 50358)) (and (eq (ws-lang-lo) 50259) (eq (ws-lang-count vt) 99))))) 8 0))
    (let c4 (if (and (eq (ws-lang-count vl) 100) (and (eq (ws-transcribe vl) 50360) (eq (ws-ts0 vl) 50365))) 16 0))
    (let c5 (if (lt (ws-at turbo "encoder.positional_embedding" 0) 0) 32 0))
    ; the bytes a pass reads, from the file's own offsets — the floor is made of these
    (let c6 (if (and (eq (div (ws-bytes turbo "encoder.") 1048576) 1211)
                     (and (eq (div (ws-bytes turbo "decoder.") 1048576) 327)
                          (eq (div (ws-bytes tiny "encoder.") 1048576) 14))) 64 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6)))))))
