; form-cli-speaker-home-band.fk — planner overlay is the local speaker.
;
; Verdict 1023:
;   1..128  fspk-check (72/72, Speaker:, Control:, walk-lane, act 3, observed census 95, lora 0, home)
;   256     class descriptor FormSpeakerHome minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-planner-mint-xtal.fk
; preludes: form-stdlib/form-cli-speaker-home-xtal.fk
; witnessed: 2026-08-26 -> 1023; speaker home 1; heldout 72/72; live GROUND WALK TOOL HOME; fqt-lora 0; native voice 0

(do
    (defn fspkb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn fspkb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (fspkb-has-name? (tail xs) name))))

    (let bits (fspk-check))
    (let desc (FormSpeakerHome))
    (let src (read_file "form/form-stdlib/bml/form-cli-speaker-home.bml"))
    (let exe (read_file "form/form-stdlib/form-cli-speaker-home.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormSpeakerHome")
                     (and (eq (fspkb-has-name? (nth desc 2) "T") 1)
                          (and (eq (fspkb-has-name? (nth desc 3) "fspk-next") 1)
                               (eq (fspkb-has-name? (nth desc 4) "ObservedRemoteEvents") 1))))
                256 0))
    (let b9 (if (and (eq (fspkb-has-str? src "package Form.cli.speakerhome") 1)
                     (and (eq (fspkb-has-str? src "interface ISpeakerHome") 1)
                          (and (eq (fspkb-has-str? src "class FormSpeakerHome") 1)
                               (and (eq (fspkb-has-str? src "const int ObservedRemoteEvents") 1)
                                    (and (eq (fspkb-has-str? src "template SpeakerTurn") 1)
                                         (and (eq (fspkb-has-str? exe "heldout-v3") 0)
                                              (eq (fspkb-has-str? exe "turn_started") 0)))))))
                512 0))
    (add bits (add b8 b9)))
