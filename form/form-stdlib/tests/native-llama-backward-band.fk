; preludes: form-stdlib/tests/native-llama-fixture.bml
; Finite differences cover A and B of every projection in both layers, with GQA.
(do
 (let m (nlf-model))
 (let c (nll-context m 8))
 (let s (nlb-state m))
 (let r (nll-forward m c (list 1 5 9 12) 0 1))
 (let before (nlb-backward m r (list 5 9 12 17) s 1.0))
 (let closed (nll-forward-close r))
 (let passed (nlf-check-pairs m c s))
 (let update (nlb-adam s 0.0001 1 1.0))
 (let after (nlf-loss m c))
 (let freed (nlb-state-close s))
 (let ctx (nll-context-close c))
 (let model (nll-close m))
 (print (list "finite-differences" passed "expected" 28 "loss-before" before "loss-after" after "live-buffers" (nth (metal_live) 2)))
 (if (and (eq passed 28) (and (lt after before) (eq (nth (metal_live) 2) 0))) 7 (form_error "native full LoRA gradient witness refused")))
