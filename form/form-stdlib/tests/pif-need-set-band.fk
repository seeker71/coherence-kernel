; pif-need-set-band.fk — the reduced core is computed: reachability over the
; image's own testimony, cycles closed, holes loud, the invisible counted.
;
; Verdict 1023 (10 bits):
;   1    chain a->b->c from root a: need = {a,b,c}
;   2    diamond a->{b,c}, b->d, c->d: d once — union, not multiset
;   4    cycle a->b->a terminates and needs both
;   8    the island: defined d,e unreached from a — cut = {d,e}, in order
;   16   multi-root union: roots {a,x} pull both components
;   32   empty roots: need is EMPTY (present-0), never nothing
;   64   an undefined root: need is NOTHING — no closure over a hole
;   128  duplicate definers of one symbol: edges UNION (both rows' deps in)
;   256  anonymous nodes (defined -1) with deps are COUNTED as what the walk
;        cannot see, and their deps do not leak into need
;   512  the fit verdict: (fits margin count) exact on both sides of a cap,
;        and nothing when the need is nothing
;
; preludes: form-stdlib/pif-need-set.fk

(do
    (defn pnb-bit (ok bit) (if ok bit 0))
    (defn pnb-row (node def deps) (pif-node-symbol-row node def deps))
    (defn pnb-d (s) (pif-symbol-dependency-target s 0))

    (defn pnb-same? (a b)
        (if (eq (len a) (len b)) (pnb-same-go a b) 0))
    (defn pnb-same-go (a b)
        (if (eq (len a) 0) 1
            (if (eq (head a) (head b)) (pnb-same-go (tail a) (tail b)) 0)))

    (defn pif-need-set-band ()
        (do
            (let chain (list (pnb-row 0 10 (list (pnb-d 11)))
                             (pnb-row 1 11 (list (pnb-d 12)))
                             (pnb-row 2 12 (list))))
            (let diamond (list (pnb-row 0 1 (list (pnb-d 2) (pnb-d 3)))
                               (pnb-row 1 2 (list (pnb-d 4)))
                               (pnb-row 2 3 (list (pnb-d 4)))
                               (pnb-row 3 4 (list))))
            (let cyc (list (pnb-row 0 5 (list (pnb-d 6)))
                           (pnb-row 1 6 (list (pnb-d 5)))))
            (let island (list (pnb-row 0 1 (list (pnb-d 2)))
                              (pnb-row 1 2 (list))
                              (pnb-row 2 7 (list (pnb-d 8)))
                              (pnb-row 3 8 (list))))
            (let dup (list (pnb-row 0 1 (list (pnb-d 2)))
                           (pnb-row 1 1 (list (pnb-d 3)))
                           (pnb-row 2 2 (list)) (pnb-row 3 3 (list))))
            (let anon (list (pnb-row 0 1 (list))
                            (pnb-row 1 -1 (list (pnb-d 9)))
                            (pnb-row 2 9 (list))))

            (sum (list
                (pnb-bit (pnb-same? (pns-need chain (list 10)) (list 10 11 12)) 1)
                (pnb-bit (pnb-same? (pns-need diamond (list 1)) (list 1 2 3 4)) 2)
                (pnb-bit (pnb-same? (pns-need cyc (list 5)) (list 5 6)) 4)
                (pnb-bit (pnb-same? (pns-cut island (list 1)) (list 7 8)) 8)
                (pnb-bit (pnb-same? (pns-need island (list 1 7)) (list 1 7 2 8)) 16)
                (pnb-bit (and (not (nothing? (pns-need chain (list))))
                              (eq (len (pns-need chain (list))) 0)) 32)
                (pnb-bit (nothing? (pns-need chain (list 99))) 64)
                (pnb-bit (pnb-same? (pns-need dup (list 1)) (list 1 2 3)) 128)
                (pnb-bit (and (eq (pns-anonymous-deps anon 0) 1)
                              (pnb-same? (pns-need anon (list 1)) (list 1))) 256)
                (pnb-bit (do (let ok (pns-fit chain (list 10) 5))
                         (let tight (pns-fit chain (list 10) 2))
                         (if (and (eq (nth ok 0) 1) (and (eq (nth ok 1) 2)
                              (and (eq (nth ok 2) 3)
                              (and (eq (nth tight 0) 0) (and (eq (nth tight 1) -1)
                                   (nothing? (pns-fit chain (list 99) 5))))))) 1 0)) 512)))))

    (pif-need-set-band))
