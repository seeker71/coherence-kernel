; native-model-session-grounding-native-session-band.fk -- the shared session
; descriptor is a deterministic content-addressed cell with exact accessors.
; All values are public fixtures; no session file is opened.
; preludes: form-stdlib/native-model-session-grounding-native-session.fk

(do
    (defn nmsgssb-score (condition bit) (if condition bit 0))
    (defn native-model-session-grounding-native-session-band ()
        (do
            (let first
                (nmsgn-session "/fixture/session.jsonl"
                    "2026-08-08T01:02:03Z" 1234))
            (let same
                (nmsgn-session "/fixture/session.jsonl"
                    "2026-08-08T01:02:03Z" 1234))
            (let changed
                (nmsgn-session "/fixture/session.jsonl"
                    "2026-08-08T01:02:03Z" 1235))
            (sum (list
                (nmsgssb-score
                    (and (eq (len first) 5)
                         (eq (str_len (nmsgn-session-address first)) 64)) 1)
                (nmsgssb-score
                    (str_eq (nmsgn-session-address first)
                            (nmsgn-session-address same)) 2)
                (nmsgssb-score
                    (not (str_eq (nmsgn-session-address first)
                                 (nmsgn-session-address changed))) 4)
                (nmsgssb-score
                    (str_eq (nmsgn-session-path first)
                            "/fixture/session.jsonl") 8)
                (nmsgssb-score
                    (str_eq (nmsgn-session-started first)
                            "2026-08-08T01:02:03Z") 16)
                (nmsgssb-score (eq (nmsgn-session-mtime first) 1234) 32)
                (nmsgssb-score
                    (str_eq (nth first 0)
                            "native-session-descriptor-cell-v1") 64)))))
    (native-model-session-grounding-native-session-band))
