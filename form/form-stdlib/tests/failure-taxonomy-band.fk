; failure-taxonomy-band.fk — every failure type witnessed from a real
; fixture: the kernel's own diagnostic lines, and condition E's actual
; retained candidate as the degeneration fixture — the live pathology, not
; a synthetic imitation of it.
;
; Verdict 1023 (10 bits):
;   1    a transcript carrying two kernel diagnostics classifies to both,
;        with counts
;   2    a CLEAN transcript classifies to the EMPTY list — present-0,
;        never nothing
;   4    an error line no class claims is COUNTED as "unclassified",
;        never dropped
;   8    a transcript with one known and one unknown error carries both
;   16   condition E's retained candidate (receipts/2026-08-27-condition-
;        E-candidate.txt) reads DEGENERATE — the `1,` loop dominates its
;        tail past 250 permille
;   32   a healthy body cell (core.fk's first 4KB) does NOT read
;        degenerate — the detector separates prose+code from loops
;   64   short candidates (<64 bytes) never read degenerate — a one-word
;        answer cannot loop
;   128  prompt-echo fires on a candidate embedding a 40-byte prompt
;        window verbatim
;   256  prompt-echo stays silent when the candidate answers in its own
;        words
;   512  condition E's candidate echoes the frozen base prompt — the
;        "bodies are the prompt's English" reading, now a detector's
;        verdict instead of an eye's
;
; preludes: form-stdlib/failure-taxonomy.fk

(do
    (defn ftb-bit (ok bit) (if ok bit 0))
    (defn ftb-has-class (rows name want)
        (if (eq (len rows) 0) 0
            (if (and (str_eq (nth (head rows) 0) name)
                     (eq (nth (head rows) 1) want)) 1
                (ftb-has-class (tail rows) name want))))

    (defn failure-taxonomy-band ()
        (do
            (let t2 "fkwu:12:1: error: [input-ended-mid-form] the input ended\nfkwu:40:2: error: [unresolved-call] 'foo' matched no op")
            (let tclean "verdict 4095\n0\n")
            (let tunk "fkwu:9:9: error: [some-future-diagnostic] new shape")
            (let tmix "fkwu:1:1: error: [unbound-name] 'x' in value position\nfkwu:2:2: error: [weird-new-thing] strange")
            (let eCand (read_file "receipts/artifacts/2026-08-27-condition-E-candidate.txt"))
            (let healthy (substring (read_file "form/form-stdlib/core.fk") 0 4096))
            (let prompt (read_file "/tmp/ftb-prompt.txt"))

            (sum (list
                (ftb-bit (and (eq (ftb-has-class (ftx-scan t2) "mid-form" 1) 1)
                              (eq (ftb-has-class (ftx-scan t2) "unresolved-call" 1) 1)) 1)
                (ftb-bit (and (not (nothing? (ftx-scan tclean)))
                              (eq (len (ftx-scan tclean)) 0)) 2)
                (ftb-bit (eq (ftb-has-class (ftx-scan tunk) "unclassified" 1) 1) 4)
                (ftb-bit (and (eq (ftb-has-class (ftx-scan tmix) "unbound-name" 1) 1)
                              (eq (ftb-has-class (ftx-scan tmix) "unclassified" 1) 1)) 8)
                (ftb-bit (eq (ftx-degenerate? eCand) 1) 16)
                (ftb-bit (eq (ftx-degenerate? healthy) 0) 32)
                (ftb-bit (eq (ftx-degenerate? "short answer") 0) 64)
                (ftb-bit (eq (ftx-prompt-echo? prompt
                    (str_concat "def f() = " (substring prompt 20 80))) 1) 128)
                (ftb-bit (eq (ftx-prompt-echo? prompt
                    "(defn fkecc-presence () (list (nothing) 0 1))") 0) 256)
                (ftb-bit (eq (ftx-prompt-echo? prompt eCand) 1) 512)))))

    (failure-taxonomy-band))
