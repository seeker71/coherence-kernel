; form-demand-specialization-contract-band.fk — active compute and Glass
; contracts use demand, heat, residence, age, and evidence rather than one
; ambiguous temperature axis.
;
; Verdict 255: authority, scoped vocabulary, exact JIT thresholds, and the
; currently blocking whole-unit admission seam are all explicit.
;
; preludes: form-stdlib/core.fk

(do
    (defn fdscb-has? (text needle) (if (ge (str_find text needle 0) 0) 1 0))
    (defn fdscb-temperature-free? (text)
        (if (eq (fdscb-has? text "cold") 1) 0
            (if (eq (fdscb-has? text "warm") 1) 0 1)))
    (defn fdscb-files-clean? (paths)
        (if (eq (len paths) 0) 1
            (if (eq (fdscb-temperature-free? (read_file (head paths))) 1)
                (fdscb-files-clean? (tail paths)) 0)))
    (defn fdscb-bit (held weight) (if (eq held 1) weight 0))

    (let authority (read_file "form/form-stdlib/bml/form-demand-specialization-contract.bml"))
    (let cache-paths (list
        "form/form-stdlib/bml/form-cli-bml-cache.bml"
        "form/form-stdlib/form-cli-bml-cache-run.fk"))
    (let glass-paths (list
        "form/form-stdlib/bml/form-glass-live.bml"
        "form/form-stdlib/form-glass-live.bml"
        "form/form-stdlib/bml/form-glass-observer.bml"
        "form/form-stdlib/form-glass-observer.bml"))
    (let lifecycle-paths (list
        "form/form-stdlib/bml/native-model-glass.bml"
        "form/form-stdlib/native-model-glass.bml"
        "form/form-stdlib/bml/llama32-3b-resident-state.bml"
        "form/form-stdlib/llama32-3b-resident-state.bml"))
    (let memory-paths (list
        "form/form-stdlib/bml/native-model-resident-fleet.bml"
        "form/form-stdlib/native-model-resident-fleet.bml"
        "form/form-stdlib/bml/native-model-memory-glass.bml"
        "form/form-stdlib/native-model-memory-glass.bml"
        "form/form-stdlib/form-glass-telemetry-membrane.bml"
        "form/form-stdlib/bml/native-model-routing-experiment.bml"
        "form/form-stdlib/native-model-routing-experiment.bml"
        "observe/native-model-dual-resident-live-run.fk"))
    (let jit-paths (list
        "observe/jit-decision.fk"
        "form/form-stdlib/jit-decision.fk"
        "form/form-stdlib/jit-heat-gate.fk"
        "form/form-stdlib/jit-once-born.fk"
        "form/form-stdlib/form-cli-jit-run.fk"
        "form/form-stdlib/form-cli-rest-force.bml"
        "form/form-stdlib/bml/form-cli-one-body.bml"
        "form/form-stdlib/form-cli-qwen-teach-layer.fk"
        "form/form-stdlib/direct-source-jit-discovery.fk"
        "observe/direct-source-jit-discovery-probe.fk"))

    (let c0 (fdscb-bit (and (eq (fdscb-has? authority "section [public]") 1)
                              (eq (fdscb-has? authority "form-demand-specialization-contract-v1") 1)) 1))
    (let c1 (fdscb-bit (fdscb-files-clean? cache-paths) 2))
    (let c2 (fdscb-bit (fdscb-files-clean? glass-paths) 4))
    (let c3 (fdscb-bit (fdscb-files-clean? lifecycle-paths) 8))
    (let c4 (fdscb-bit (fdscb-files-clean? memory-paths) 16))
    (let c5 (fdscb-bit (fdscb-files-clean? jit-paths) 32))
    (let c6 (fdscb-bit (and (eq (fdscb-has? authority "observed heat 5 or above") 1)
                              (and (eq (fdscb-has? authority "heat below 2") 1)
                                   (eq (fdscb-has? authority "without purity the source remains walkable") 1))) 64))
    (let c7 (fdscb-bit (and (eq (fdscb-has? authority "synchronously materialize a closure before the first Glass frame") 1)
                              (and (eq (fdscb-has? authority "absent or stale acceleration artifact proves only catalog compatibility facts") 1)
                                   (eq (fdscb-has? authority "pending carrier seam") 1))) 128))
    (sum (list c0 c1 c2 c3 c4 c5 c6 c7)))
