; Real configured DS4 layer plan through the optional emitted-controller path.
; No model opens: the first exact f16_matvec operation must reach the linked
; dispatcher and fail closed with status 0 rather than produce later work.
;
; preludes: native/metal/dsv4-layer-walk.fk

(do
    (let src (eqr-of-file (dlp-model-path) 0 (gm-window)))
    (let base (egg-data-base src (gm-alignment)))
    (let descs
        (dlp-collect
            src base (egg-tinfo-start src) (egg-tensor-count src)))
    (let plan (dlw-layer-plan src descs 0))
    (let route
        (dsv4-jit-metal-transaction-route "fkwu-metal-transaction"))
    (let status
        (dlw-direct-layer-plan-jit route plan 17 3))
    (if (and (eq (len route) 2) (eq status 0)) 255 0))
