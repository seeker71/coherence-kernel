; living-world-continuity-durable-pending-diagnostic.fk
; Privacy-bounded observation of the pending carrier seam.  It emits only
; sizes and equality/validity bits; the image and serialized text stay local.
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/tests/living-world-continuity-durable-witness.fk

(do
    (lwcdw-clean)
    (let image (lwcdw-image))
    (let text (ccs-emit image))
    (let pending (lwcd-pending-path (lwcdw-path)))
    (let wrote (fs-write-text pending text))
    (let pending-text (fs-read-text pending))
    (let parsed (ccs-parse-at pending-text 0))
    (let restored (ccs-pair-value parsed))
    (let helper-restored (lwcd-text-image pending-text))
    (let canonical-category
        (node_value (intern_trivial_string LWCN-IMAGE)))
    (let rebuilt-category
        (node_value
            (intern_trivial_string
                (substring (str_concat "" LWCN-IMAGE)
                    0 (str_len LWCN-IMAGE)))))
    (let observation
        (list
            (str_len text)
            wrote
            (fs-stat-size pending)
            (str_len pending-text)
            (if (str_eq pending-text text) 1 0)
            (if (eq (ccs-pair-next parsed) (str_len pending-text)) 1 0)
            (if (str_eq (ccs-emit restored) pending-text) 1 0)
            (if (node_eq restored image) 1 0)
            (lwcn-image-valid? restored)
            (if (node_eq (node_category restored)
                         (node_category image)) 1 0)
            (if (node_eq (lwcn-image-manifest restored)
                         (lwcn-manifest
                            (lwcn-image-world restored))) 1 0)
            (if (node_eq (lwcn-image-path restored)
                         (lwo-local-path)) 1 0)
            (list
                (str_byte_at pending-text 0)
                (if (node_eq helper-restored restored) 1 0)
                (lwcn-image-valid? helper-restored))
            (list
                (node_pkg (node_category image))
                (node_level (node_category image))
                (node_type (node_category image))
                (node_inst (node_category image)))
            (list
                (node_pkg (node_category restored))
                (node_level (node_category restored))
                (node_type (node_category restored))
                (node_inst (node_category restored)))
            (list
                (str_len (node_category image))
                (str_len LWCN-IMAGE)
                (if (str_eq (node_category image) LWCN-IMAGE) 1 0)
                (if (node_eq (node_category image) LWCN-IMAGE) 1 0)
                (if (node_eq
                        (make_nodeid
                            (node_pkg (node_category image))
                            (node_level (node_category image))
                            (node_type (node_category image))
                            (node_inst (node_category image)))
                        (node_category image)) 1 0))
            (list
                (if (str_eq canonical-category rebuilt-category) 1 0)
                (if (node_eq canonical-category rebuilt-category) 1 0)
                (if (str_eq (node_category image)
                            canonical-category) 1 0)
                (if (node_eq (node_category image)
                             canonical-category) 1 0))))
    (lwcdw-clean)
    (let saved
        (lwcd-save-new-with-options (lwcdw-path) image (lwcdw-evidence)
            (lwcdw-alternative) (lwcdw-unknown)))
    (let save-observation
        (list
            (lwcd-saved? saved)
            (lwcd-investigate? saved)
            (lwcd-unknowable? saved)
            (fs-exists? (lwcdw-path))
            (fs-exists? (lwcd-pending-path (lwcdw-path)))))
    (lwcdw-clean)
    (list observation save-observation))
