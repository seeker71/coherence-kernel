; living-world-relation-hypothesis-witness.fk -- correction offers, witnesses decide.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/living-world-multilens-plan.fk form-stdlib/living-world-composition-outcome.fk form-stdlib/living-world-composition-voice.fk form-stdlib/living-world-relation-hypothesis.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk form-stdlib/tests/living-world-relational-voice-witness.fk form-stdlib/tests/living-world-multilens-witness.fk form-stdlib/tests/living-world-composition-outcome-witness.fk

(let LWRHW-RELATION-ZETA (bp "LWRHW-RELATION-ZETA"))
(let LWRHW-SOURCE-H (bp "LWRHW-SOURCE-H"))
(let LWRHW-SOURCE-I (bp "LWRHW-SOURCE-I"))
(let LWRHW-SOURCE-J (bp "LWRHW-SOURCE-J"))
(let LWRHW-PROV-H (bp "LWRHW-PROV-H"))
(let LWRHW-PROV-I (bp "LWRHW-PROV-I"))
(let LWRHW-PROV-J (bp "LWRHW-PROV-J"))
(let LWRHW-EVIDENCE (bp "LWRHW-EVIDENCE"))
(let LWRHW-SELF-EVIDENCE (bp "LWRHW-SELF-EVIDENCE"))

(defn lwrhw-cell (kind) (intern_node kind (empty)))
(defn lwrhw-relation-zeta () (lwrhw-cell LWRHW-RELATION-ZETA))
(defn lwrhw-source-h () (lwrhw-cell LWRHW-SOURCE-H))
(defn lwrhw-source-i () (lwrhw-cell LWRHW-SOURCE-I))
(defn lwrhw-source-j () (lwrhw-cell LWRHW-SOURCE-J))
(defn lwrhw-prov-h () (lwrhw-cell LWRHW-PROV-H))
(defn lwrhw-prov-i () (lwrhw-cell LWRHW-PROV-I))
(defn lwrhw-prov-j () (lwrhw-cell LWRHW-PROV-J))
(defn lwrhw-evidence () (lwrhw-cell LWRHW-EVIDENCE))
(defn lwrhw-self-evidence () (lwrhw-cell LWRHW-SELF-EVIDENCE))

(defn lwrhw-lens-zeta ()
    (lwlc-lens (lwlc-cell-shape)
        (lwrhw-relation-zeta) (lwrhw-evidence)))
(defn lwrhw-correction ()
    (lwco-observation (lwcow-bundle) (lwcow-alternative)
        (lwrhw-lens-zeta) (oac-zero)
        (lwo-field (list (lwcow-alternative)))
        (lwlc-unknown (lwrhw-evidence)) (lwrhw-evidence)))
(defn lwrhw-offer ()
    (lwrh-offer (lwrhw-correction) (lwrhw-relation-zeta)
        (lwrhw-lens-zeta) (lwo-empty-field)
        (lwlc-unknown (lwrhw-evidence)) (lwrhw-evidence)))

(defn lwrhw-entry-h (payload)
    (lwrvw-entry-for (lwrhw-source-h) (lwrhw-prov-h) payload))
(defn lwrhw-entry-i (payload)
    (lwrvw-entry-for (lwrhw-source-i) (lwrhw-prov-i) payload))
(defn lwrhw-entry-j (payload)
    (lwrvw-entry-for (lwrhw-source-j) (lwrhw-prov-j) payload))

(defn lwrhw-world-build ()
    (lwt-receive-stream (lwcow-confirmed-integrated-world)
        (list
            (lwcow-entry-g (lwrhw-correction))
            (lwcow-entry-g (lwrhw-offer)))))
(let LWRHW-WORLD-VALUE (lwrhw-world-build))
(defn lwrhw-world () LWRHW-WORLD-VALUE)

(defn lwrhw-proposal-build ()
    (lwrh-proposal-for (lwrhw-world) (lwrhw-offer)))
(let LWRHW-PROPOSAL-VALUE (lwrhw-proposal-build))
(defn lwrhw-proposal () LWRHW-PROPOSAL-VALUE)
(let LWRHW-CANDIDATE-VALUE
    (lwt-proposal-candidate LWRHW-PROPOSAL-VALUE))
(defn lwrhw-candidate () LWRHW-CANDIDATE-VALUE)
(let LWRHW-HYPOTHESIS-VALUE
    (lwo-emergent-shape LWRHW-CANDIDATE-VALUE))
(defn lwrhw-hypothesis () LWRHW-HYPOTHESIS-VALUE)

(defn lwrhw-candidate-uncached ()
    (lwt-proposal-candidate (lwrhw-proposal)))
(defn lwrhw-round ()
    (lwt-round (lwrhw-world)
        (lwo-field (list (lwrhw-proposal)))
        (lwo-empty-field) (lwcow-confirmed-integrated-round)))
(defn lwrhw-yes-round ()
    (do
        (let round (lwrhw-round))
        (let proposal (head (lwo-field-items (lwt-round-proposals round))))
        (lwt-round-receive round
            (list
                (lwcow-response-entry
                    (lwcow-source-g) (lwcow-prov-g) proposal)))))
(defn lwrhw-integrated-round-build ()
    (do
        (let round (lwrhw-yes-round))
        (let proposal (head (lwo-field-items (lwt-round-proposals round))))
        (lwrh-integrate round proposal (lwrew-action))))
(let LWRHW-INTEGRATED-ROUND-VALUE (lwrhw-integrated-round-build))
(defn lwrhw-integrated-round () LWRHW-INTEGRATED-ROUND-VALUE)
(let LWRHW-INTEGRATED-WORLD-VALUE
    (lwt-round-world LWRHW-INTEGRATED-ROUND-VALUE))
(defn lwrhw-integrated-world () LWRHW-INTEGRATED-WORLD-VALUE)

(defn lwrhw-proposed-pair-items ()
    (lwo-field-items
        (lwrh-hypothesis-proposed-pairs (lwrhw-hypothesis))))
(defn lwrhw-find-pair-items (items left right)
    (if (eq (len items) 0) (lwo-none)
        (if (and (node_eq (lwrh-pair-left (head items)) left)
                 (node_eq (lwrh-pair-right (head items)) right))
            (head items)
            (lwrhw-find-pair-items (tail items) left right))))
(defn lwrhw-find-pair (field left right)
    (lwrhw-find-pair-items (lwo-field-items field) left right))
(defn lwrhw-pair-first ()
    (lwrhw-find-pair
        (lwrh-hypothesis-proposed-pairs (lwrhw-hypothesis))
        (lwrvw-left) (lwmpw-third)))
(defn lwrhw-pair-second ()
    (lwrhw-find-pair
        (lwrh-hypothesis-proposed-pairs (lwrhw-hypothesis))
        (lwmpw-third) (lwrvw-right)))

(let LWRHW-PAIR-FIRST-VALUE (lwrhw-pair-first))
(let LWRHW-PAIR-SECOND-VALUE (lwrhw-pair-second))
(defn lwrhw-pair-first-cached () LWRHW-PAIR-FIRST-VALUE)
(defn lwrhw-pair-second-cached () LWRHW-PAIR-SECOND-VALUE)

(defn lwrhw-attestation-for (pair evidence)
    (lwrh-attestation (lwrhw-candidate) pair
        (oac-one (lwrhw-relation-zeta))
        (lwo-empty-field) (lwo-none) evidence))
(defn lwrhw-attestation-first ()
    (lwrhw-attestation-for (lwrhw-pair-first-cached) (lwrhw-evidence)))
(defn lwrhw-attestation-second ()
    (lwrhw-attestation-for (lwrhw-pair-second-cached) (lwrhw-evidence)))
(defn lwrhw-self-attestation ()
    (lwrhw-attestation-for (lwrhw-pair-first-cached) (lwrhw-self-evidence)))
(defn lwrhw-observation-first ()
    (lwrh-derived-observation (lwrhw-attestation-first)))
(defn lwrhw-observation-second ()
    (lwrh-derived-observation (lwrhw-attestation-second)))

(defn lwrhw-one-observer-world-build ()
    (lwt-receive-stream (lwrhw-integrated-world)
        (list
            (lwrhw-entry-h (lwrhw-attestation-first))
            (lwrhw-entry-h (lwrhw-attestation-second))
            (lwrhw-entry-h (lwrhw-observation-first))
            (lwrhw-entry-h (lwrhw-observation-second)))))
(defn lwrhw-one-observer-world () (lwrhw-one-observer-world-build))

(defn lwrhw-attested-world-build ()
    (lwt-receive-stream (lwrhw-one-observer-world)
        (list
            (lwrhw-entry-i (lwrhw-attestation-first))
            (lwrhw-entry-i (lwrhw-attestation-second))
            (lwrhw-entry-i (lwrhw-observation-first))
            (lwrhw-entry-i (lwrhw-observation-second)))))
(defn lwrhw-attested-world () (lwrhw-attested-world-build))
(defn lwrhw-self-world ()
    (lwt-receive-stream (lwrhw-integrated-world)
        (list
            (lwcow-entry-g (lwrhw-self-attestation))
            (lwcow-entry-g
                (lwrh-derived-observation (lwrhw-self-attestation))))))

(defn lwrhw-find-edge-proposal (proposals left right)
    (lwmpw-find-proposal proposals (lwrhw-relation-zeta) left right))
(defn lwrhw-relation-round-build ()
    (do
        (let world (lwrhw-attested-world))
        (lwt-round world (lwrl-proposals world 2)
            (lwo-empty-field) (lwrhw-integrated-round))))
(defn lwrhw-relation-round () (lwrhw-relation-round-build))
(defn lwrhw-edge-first-proposal ()
    (lwrhw-find-edge-proposal
        (lwt-round-proposals (lwrhw-relation-round))
        (lwrvw-left) (lwmpw-third)))
(defn lwrhw-edge-second-proposal ()
    (lwrhw-find-edge-proposal
        (lwt-round-proposals (lwrhw-relation-round))
        (lwmpw-third) (lwrvw-right)))
(defn lwrhw-edge-first ()
    (lwt-proposal-candidate (lwrhw-edge-first-proposal)))
(defn lwrhw-edge-second ()
    (lwt-proposal-candidate (lwrhw-edge-second-proposal)))
(defn lwrhw-relation-yes-round ()
    (do
        (let round (lwrhw-relation-round))
        (let first (lwrhw-edge-first-proposal))
        (let second (lwrhw-edge-second-proposal))
        (lwt-round-receive round
            (append
                (list
                    (lwrvw-relation-response
                        (lwrhw-source-h) (lwrhw-prov-h) first)
                    (lwrvw-relation-response
                        (lwrhw-source-i) (lwrhw-prov-i) first))
                (list
                    (lwrvw-relation-response
                        (lwrhw-source-h) (lwrhw-prov-h) second)
                    (lwrvw-relation-response
                        (lwrhw-source-i) (lwrhw-prov-i) second))))))
(defn lwrhw-relation-integrated-round-build ()
    (do
        (let round (lwrhw-relation-yes-round))
        (let first (lwrhw-edge-first-proposal))
        (let second (lwrhw-edge-second-proposal))
        (let integrated-first
            (lwrl-integrate round first (lwrew-action)))
        (lwrl-integrate integrated-first second (lwrew-action))))
(defn lwrhw-relation-integrated-round ()
    (lwrhw-relation-integrated-round-build))
(defn lwrhw-relation-integrated-world ()
    (lwt-round-world (lwrhw-relation-integrated-round)))

(defn lwrhw-before-plan ()
    (lwrp-plan-for (lwrhw-integrated-world)
        (lwrhw-relation-zeta) (lwmpw-nodes)))
(defn lwrhw-after-plan ()
    (lwrp-plan-for (lwrhw-relation-integrated-world)
        (lwrhw-relation-zeta) (lwmpw-nodes)))

(defn lwrhw-revoked-offer-world ()
    (lwt-receive-stream (lwrhw-world)
        (list
            (lwcow-entry-g
                (lwo-revocation (lwrhw-offer)
                    (lwcow-source-g) (lwrew-action) (lwcow-prov-g))))))

(defn lwrhw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwrhw-sum (tail items)))))
