; forbidden-tools-audit-band.bml — the commands agents ran, read from their transcripts, and which of them ran sed, awk, perl or python.
; A synthetic transcript tree (two projects, three sessions, one subagent) stands in for <home>/.claude/projects: rows are written the
; way Claude Code writes them, so the reading is held to the shape it meets, and a command that only names a tool as data is not a slip.
;
; Verdict 65535 when every claim lands:
;   1     tally: ten distinct commands over three transcripts (a tool_use id that two transcripts carry counts once), six of them flagged;
;         the Read tool's row, the tool_result that quotes a Bash call as escaped text and the clean commands add nothing
;   2     names: the flagged commands read sed, awk, perl, python3, gsed and sed (a Monitor command and a command whose key is not the
;         first one are read too; an escaped quote and `;` inside a command are read as the command it is)
;   4     data: `grep -F "sed -i" f` and a command that only echoes a tool's name are counted and not flagged
;   8     since: since the second of October only the commands whose own row time is later count (nine commands, five flagged), not the
;         file's time; with no window all of them count
;   16    scope and session: a project prefix reads that project's transcripts only; a session substring reads the sessions and agents whose
;         id holds it (a subagent is named <session>/<agent>)
;   32    chunks: a transcript read in 4096-byte chunks (and a row longer than a chunk, which doubles the chunk) tallies exactly what one
;         read of it tallies, and no command is counted twice at a chunk's edge
;   64    time: fta-ms reads 1970-01-01T00:00:00Z as 0, 2026-10-04T00:24:11.123Z as 1791073451000 and a text that is no time as nothing;
;         fta-iso writes it back
;   128   report: a session line, its flagged commands newest first (time, [names], the command trimmed to 160 bytes, line breaks as " ; "),
;         the totals line, and top: N shows the newest N rows while the totals count every row
;   256   lens: the reading is flagged + 1 (0 is the lens's own word for no reading); the note of a breath says the flagged count of its window
;         and the window (`since last breath: 7 (<from> to <to>, the first breath: the last 6 hours)`), the notes of an hours window and of
;         all transcripts say their own; the window opens at the stamp, or six hours back when there is none, the stamp is no stamp when it
;         is zero, in the future or over a year old, and a stamp text reads as its number (junk and nothing read as nothing)
;   512   scale: a 20 MB transcript with 600 commands (300 flagged) is read exactly in under 20 s
;   1024  door: observe/forbidden-tools-audit-run.bml with an unknown session id exits 0, prints the totals line and the note (`in all
;         transcripts read: 0`), and ends with the reading 1 (no transcript read)
;   2048  plant: reading each file with its own seen-set (no dedupe across transcripts) counts eleven commands: claim 1 loses
;   4096  plant: with no window the since claim's counts differ from the windowed ones: claim 8 holds only because the window is applied
;   8192  window: a transcript whose last write is before the window (two minutes of slack) is not opened: the same tree read since the third
;         of October counts 8 commands over 2 sessions with the old file aged, and 10 over 3 with it written inside the window; no window
;         opens every file
;   16384 breath: the door as a child with a scratch stamp: the first breath says the first-breath window and writes the stamp (a number within
;         ten minutes of now); the second opens its window at that stamp and says no first breath; a plain reading and an hours window leave the stamp as
;         it was (only {"breath":1} moves it)
;   32768 plant: a breath with a since_hours of its own, a scope that is neither, malformed JSON and a typo'd key are each refused by name (exit 1)
;         and leave the stamp as it was: the refusals are the reader's, and a refused breath never moves the window
;
; REQUIRES: the built ./fkwu and the body root as the working directory (claim 1024 runs the door as a child).
// preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/bml/live.bml form-stdlib/bml/host-child.bml form-stdlib/bml/forbidden-tools-audit.bml
section [form.bml] {
 class ForbiddenToolsAuditBand {
  def fab-has(s, part) = str_find(s, part, 0) >= 0;
  def fab-join(xs, sep) = nil?(xs) ? "" : nil?(xs[1:]) ? xs[0] : xs[0] ++ sep ++ fab-join(xs[1:], sep);
  def fab-fresh() {
   let root = temp_dir() ++ "/forbidden-tools-audit-band-" ++ now_unix_ms().str();
   (Comparable) host_dir_mkdir(root) == 1 ? ["audit", root, 0] : nothing();
  }
  def fab-root(ctx) = ctx[1];
  // ---- rows as Claude Code writes them
  def fab-use(id, name, input, ts) = "{\"parentUuid\":null,\"isSidechain\":false,\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"" ++ id ++ "\",\"name\":\"" ++ name ++ "\",\"input\":" ++ input ++ ",\"caller\":{\"type\":\"direct\"}}]},\"timestamp\":\"" ++ ts ++ "\"}\n";
  def fab-bash(id, cmd, ts) = fab-use(id, "Bash", "{\"command\":\"" ++ json-escape-string(cmd) ++ "\",\"description\":\"d\"}", ts);
  def fab-bash-late(id, cmd, ts) = fab-use(id, "Bash", "{\"description\":\"d\",\"timeout\":5000,\"command\":\"" ++ json-escape-string(cmd) ++ "\"}", ts);
  def fab-monitor(id, cmd, ts) = fab-use(id, "Monitor", "{\"command\":\"" ++ json-escape-string(cmd) ++ "\",\"description\":\"d\"}", ts);
  def fab-read(id, ts) = fab-use(id, "Read", "{\"file_path\":\"/x/command\"}", ts);
  def fab-result(quoted, ts) = "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"t\",\"content\":\"" ++ json-escape-string(quoted) ++ "\"}]},\"timestamp\":\"" ++ ts ++ "\"}\n";
  def fab-quoted() = fab-bash("toolu_Z", "sed p f", "2026-10-03T09:00:00.000Z");
  def fab-s1() = fab-bash("toolu_A1", "ls | sed -n 1p", "2026-10-03T10:00:00.000Z")
   ++ fab-bash("toolu_A2", "./fkwu observe/x.bml | tail -3", "2026-10-03T10:01:00.000Z")
   ++ fab-monitor("toolu_A3", "until awk 1 f; do sleep 1; done", "2026-10-03T10:05:00.000Z")
   ++ fab-bash-late("toolu_A4", "cd x && perl -e 1", "2026-10-03T10:06:00.000Z")
   ++ fab-bash("toolu_A6", "echo \"a\"; python3 -c 1", "2026-10-03T10:07:00.000Z")
   ++ fab-bash("toolu_A9", "grep -F \"sed -i\" f && echo awk", "2026-10-03T10:08:00.000Z")
   ++ fab-read("toolu_R1", "2026-10-03T10:09:00.000Z")
   ++ fab-result(fab-quoted(), "2026-10-03T10:10:00.000Z");
  def fab-agent() = fab-bash("toolu_A1", "ls | sed -n 1p", "2026-10-03T10:00:00.000Z")
   ++ fab-bash("toolu_A5", "gsed -i p f", "2026-10-03T12:00:00.000Z")
   ++ fab-bash("toolu_A6b", "echo hi", "2026-10-03T12:01:00.000Z");
  def fab-s2() = fab-bash("toolu_A7", "sed p f", "2026-10-01T09:00:00.000Z") ++ fab-bash("toolu_A8", "git status", "2026-10-03T11:00:00.000Z") ++ fab-bash("toolu_A10", "awk 1 f", "2026-10-03T14:00:00.000Z");
  // the tree: root/-p-one/s1.jsonl, root/-p-one/s1/subagents/agent-a1.jsonl, root/-p-two/s2.jsonl
  def fab-tree(ctx) {
   let root = fab-root(ctx);
   let made = host_dir_mkdir(root ++ "/-p-one") + host_dir_mkdir(root ++ "/-p-two") + host_dir_mkdir(root ++ "/-p-one/s1") + host_dir_mkdir(root ++ "/-p-one/s1/subagents");
   let a = write_file(root ++ "/-p-one/s1.jsonl", fab-s1());
   let b = write_file(root ++ "/-p-one/s1/subagents/agent-a1.jsonl", fab-agent());
   let c = write_file(root ++ "/-p-two/s2.jsonl", fab-s2());
   made == 4 ? root : nothing();
  }
  def fab-dirs(ctx, prefix) = fta-dirs-of(fab-root(ctx), prefix == "" ? "all" : "repo", prefix);
  def fab-run(ctx, prefix, session, since) = fta-run-dirs(fab-dirs(ctx, prefix), session, since);
  def fab-names(rows) = foldl((acc, r) => append(acc, foldl((a2, f) => append(a2, f[4]), [], r[2])), [], rows);
  def fab-cmds(rows) = foldl((acc, r) => append(acc, map(f => f[2], r[2])), [], rows);
  def fab-sorted(xs) = fab-join(sort-strings(xs), ",");
  // ---- 1 tally
  def fab-c-tally(ctx) {
   let made = fab-tree(ctx);
   let rows = fab-run(ctx, "", "", 0);
   !nothing?(made) && len(rows) == 3 && fta-count(rows) == 11 && fta-flagged(rows) == 7 && fta-with-slips(rows) == 3;
  }
  // ---- 2 names
  def fab-c-names(ctx) {
   let rows = fab-run(ctx, "", "", 0);
   (String) fab-sorted(fab-names(rows)) == "awk,awk,gsed,perl,python3,sed,sed";
  }
  // ---- 4 data
  def fab-c-data(ctx) {
   let rows = fab-run(ctx, "", "", 0);
   let cmds = fab-cmds(rows);
   !any?(c => fab-has(c, "grep -F"), cmds) && fta-count(rows) == 11 && len(filter(c => (String) c == "sed p f", cmds)) == 1;
  }
  // ---- 8 since
  def fab-since() = fta-ms("2026-10-02T00:00:00Z");
  def fab-c-since(ctx) {
   let win = fab-run(ctx, "", "", fab-since());
   let all = fab-run(ctx, "", "", 0);
   fta-count(win) == 10 && fta-flagged(win) == 6 && fta-count(all) == 11 && fta-flagged(all) == 7;
  }
  // ---- 16 scope and session
  def fab-c-scope(ctx) {
   let one = fab-run(ctx, "-p-one", "", 0);
   let two = fab-run(ctx, "-p-two", "", 0);
   let by = fab-run(ctx, "", "s2", 0);
   let agent = fab-run(ctx, "", "s1/agent-a1", 0);
   let sess = fab-run(ctx, "", "s1", 0);
   len(one) == 2 && fta-count(one) == 8 && len(two) == 1 && fta-count(two) == 3 && len(by) == 1 && (String) by[0][0][1] == "s2"
   && len(agent) == 1 && (String) agent[0][0][0] == "agent" && (String) agent[0][0][1] == "s1/agent-a1" && len(sess) == 2 && len(fab-run(ctx, "", "no-such", 0)) == 0;
  }
  // ---- 32 chunks
  // the count, the number flagged and which ids were flagged (a chunk's order of finding is no part of the reading)
  def fab-sig(got) = got[0].str() ++ ":" ++ len(got[1]).str() ++ ":" ++ fab-sorted(map(f => f[1], got[1]));
  def fab-c-chunks(ctx) {
   let path = fab-root(ctx) ++ "/chunky.jsonl";
   let long = fab-bash("toolu_L1", "echo " ++ fab-rep("x", 9000) ++ "; sed p f", "2026-10-03T10:00:00.000Z");
   let text = fab-s1() ++ long ++ fab-s2() ++ fab-agent() ++ fab-s1();
   let w = write_file(path, text);
   let big = fta-file(path, 0, record_new(0));
   let small = fta-file-go(path, file_size(path), 0, 4096, 0, record_new(0), [0, []]);
   let tiny = fta-file-go(path, file_size(path), 0, 100, 0, record_new(0), [0, []]);
   big[0] == 12 && len(big[1]) == 8
   && (String) fab-sig(big) == (String) fab-sig(small) && (String) fab-sig(big) == (String) fab-sig(tiny);
  }
  // ---- 64 time
  def fab-c-time(ctx) {
   fta-ms("1970-01-01T00:00:00Z") == 0 && fta-ms("2026-10-04T00:24:11.123Z") == 1791073451000 && nothing?(fta-ms("yesterday")) && nothing?(fta-ms(""))
   && (String) fta-iso(1791073451000) == "2026-10-04T00:24:11Z" && (String) fta-iso(0) == "1970-01-01T00:00:00Z" && (String) fta-iso(fta-ms("2024-02-29T23:59:59Z")) == "2024-02-29T23:59:59Z";
  }
  // ---- 128 report
  def fab-c-report(ctx) {
   let two = fab-run(ctx, "-p-two", "", 0);
   let all = fab-run(ctx, "", "", 0);
   let lines = fta-row-lines(two[0]);
   let one = fta-flag-line([0, "i", "echo a\nsed -n 1p f\n" ++ fab-rep("y", 300), fta-ms("2026-10-03T13:00:00Z"), ["sed", "sed"]]);
   (String) lines[0] == "session s2 (main) commands=3 flagged=2" && len(lines) == 3
   && (String) lines[1] == "    2026-10-03T14:00:00Z [awk] awk 1 f" && (String) lines[2] == "    2026-10-01T09:00:00Z [sed] sed p f"
   && fab-has(one, "2026-10-03T13:00:00Z [sed] echo a ; sed -n 1p f ; yyy") && len(one) < 4 + 20 + 7 + 170
   && (String) fta-totals(two) == "forbidden-tools-audit totals sessions=1 commands=3 flagged=2 sessions-with-slips=1"
   && (String) fta-totals(all) == "forbidden-tools-audit totals sessions=3 commands=11 flagged=7 sessions-with-slips=3"
   && len(fta-lines(all, 1)) == 1 + len(all[0][2]) && len(fta-lines(all, 0)) == 3 + 7;
  }
  // ---- 256 lens
  def fab-c-lens(ctx) {
   let rows = fab-run(ctx, "", "", 0);
   let t0 = fta-ms("2026-10-04T01:00:00Z");
   let t1 = fta-ms("2026-10-04T02:00:00Z");
   fta-code(rows) == 8 && fta-code([]) == 1
   && (String) fta-window-note(rows, "breath", t0, t1, true) == "note: forbidden-tool commands since last breath: 7 (2026-10-04T01:00:00Z to 2026-10-04T02:00:00Z, the first breath: the last 6 hours)"
   && (String) fta-window-note(rows, "breath", t0, t1, false) == "note: forbidden-tool commands since last breath: 7 (2026-10-04T01:00:00Z to 2026-10-04T02:00:00Z)"
   && (String) fta-window-note(rows, "hours", t0, t1, false) == "note: forbidden-tool commands in the window 2026-10-04T01:00:00Z to 2026-10-04T02:00:00Z: 7"
   && (String) fta-window-note(rows, "all", 0, t1, false) == "note: forbidden-tool commands in all transcripts read: 7"
   && fta-breath-since(nothing(), t1) == t1 - 21600000 && fta-breath-first?(nothing(), t1) && fta-breath-since(t0, t1) == t0 && !fta-breath-first?(t0, t1)
   && fta-breath-first?(0, t1) && fta-breath-first?(t1 + 5, t1) && fta-breath-first?(t1 - 40000000000, t1) && fta-breath-since(t1 + 5, t1) == t1 - 21600000
   && fta-stamp-of("1791073451000\n") == 1791073451000 && nothing?(fta-stamp-of(nothing())) && nothing?(fta-stamp-of("junk"));
  }
  // ---- 8192 window: only files written inside the window are opened
  def fab-touch(path, stamp) = (Comparable) hch-run-in(".hearth/validation", "touch", ["/usr/bin/touch", "-t", stamp, path], "", hch-by(20000))[0] == 0;
  def fab-c-window(ctx) {
   let made = fab-tree(ctx);
   let old = fab-root(ctx) ++ "/-p-two/s2.jsonl";
   let aged = fab-touch(old, "202610010000");
   let since = fta-ms("2026-10-03T00:00:00Z");
   let isold = !fta-recent?(old, since);
   let pruned = fab-run(ctx, "", "", since);
   let kept = fab-touch(old, "202610040000");
   let isnew = fta-recent?(old, since);
   let unpruned = fab-run(ctx, "", "", since);
   aged && kept && isold && isnew && fta-recent?(old, 0)
   && len(pruned) == 2 && fta-count(pruned) == 8 && len(unpruned) == 3 && fta-count(unpruned) == 10
   && fta-recent?(fab-root(ctx) ++ "/-p-one/s1.jsonl", now_unix_ms() - 3600000);
  }
  // ---- 16384 breath: the door's window runs from the stamp, the first breath reads six hours, only a breath moves the stamp, a bad request is refused
  def fab-door(ctx, name, request) {
   let base = fab-root(ctx) ++ "/" ++ name;
   let w = write_file(base ++ ".in", request);
   let pid = host_spawn_at(["./fkwu", "observe/forbidden-tools-audit-run.bml"], [base ++ ".in", base ++ ".out", base ++ ".err"]);
   let status = pid <= 0 ? -1 : host_wait(pid);
   [status, read_file(base ++ ".out") ?? "", read_file(base ++ ".err") ?? ""];
  }
  def fab-stamp-file(ctx) = fab-root(ctx) ++ "/breath.stamp";
  def fab-breath-req(ctx) = "{\"breath\":1,\"stamp\":\"" ++ fab-stamp-file(ctx) ++ "\",\"session\":\"zz-no-such-session\"}";
  def fab-c-breath(ctx) {
   let first = fab-door(ctx, "b1", fab-breath-req(ctx));
   let at1 = fta-stamp-of(read_file(fab-stamp-file(ctx)));
   let second = fab-door(ctx, "b2", fab-breath-req(ctx));
   let at2 = fta-stamp-of(read_file(fab-stamp-file(ctx)));
   let plain = fab-door(ctx, "b3", "{\"stamp\":\"" ++ fab-stamp-file(ctx) ++ "\",\"session\":\"zz-no-such-session\"}");
   let at3 = fta-stamp-of(read_file(fab-stamp-file(ctx)));
   let hours = fab-door(ctx, "b4", "{\"stamp\":\"" ++ fab-stamp-file(ctx) ++ "\",\"since_hours\":2,\"session\":\"zz-no-such-session\"}");
   let at4 = fta-stamp-of(read_file(fab-stamp-file(ctx)));
   (Comparable) first[0] == 0 && fab-has(first[1], "since last breath: 0 (") && fab-has(first[1], "the first breath: the last 6 hours)") && !nothing?(at1) && at1 > now_unix_ms() - 600000 && at1 <= now_unix_ms()
   && (Comparable) second[0] == 0 && fab-has(second[1], "since last breath: 0 (") && !fab-has(second[1], "first breath") && fab-has(second[1], fta-iso(at1) ++ " to ") && at2 >= at1
   && (Comparable) plain[0] == 0 && fab-has(plain[1], "in all transcripts read: 0") && at3 == at2
   && (Comparable) hours[0] == 0 && fab-has(hours[1], "in the window ") && at4 == at2;
  }
  // ---- 32768 plant: refused requests never move the stamp, and the refusals are the reader's (named, exit 1)
  def fab-c-plant-refuse(ctx) {
   let before = read_file(fab-stamp-file(ctx)) ?? "";
   let both = fab-door(ctx, "r1", "{\"breath\":1,\"since_hours\":1,\"stamp\":\"" ++ fab-stamp-file(ctx) ++ "\"}");
   let scope = fab-door(ctx, "r2", "{\"scope\":\"al\"}");
   let bad = fab-door(ctx, "r3", "{bad json");
   let typo = fab-door(ctx, "r4", "{\"sesion\":\"x\"}");
   (Comparable) both[0] == 1 && fab-has(both[1], "takes no \"since_hours\"") && (Comparable) scope[0] == 1 && fab-has(scope[1], "key \"scope\" must be \"repo\" or \"all\"")
   && (Comparable) bad[0] == 1 && fab-has(bad[1], "not well-formed JSON") && (Comparable) typo[0] == 1 && fab-has(typo[1], "unknown key \"sesion\"")
   && (String) (read_file(fab-stamp-file(ctx)) ?? "") == (String) before;
  }
  // ---- 512 scale
  def fab-filler() = "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":\"" ++ fab-rep("z", 800) ++ "\"},\"timestamp\":\"2026-10-03T09:00:00.000Z\"}\n";
  def fab-rep(s, k) = k <= 0 ? "" : k == 1 ? s : (k % 2 == 1 ? s : "") ++ fab-rep(s ++ s, k / 2);
  def fab-block(i) = fab-rep(fab-filler(), 40) ++ fab-bash("toolu_S" ++ i.str(), i % 2 == 0 ? "ls | sed -n 1p" : "git status --short", "2026-10-03T10:00:00.000Z");
  def fab-blocks(i, n) = i >= n ? [] : cons(fab-block(i), fab-blocks(i + 1, n));
  def fab-c-scale(ctx) {
   let path = fab-root(ctx) ++ "/big.jsonl";
   let w = write_file(path, str-spans(fab-blocks(0, 600)));
   let t0 = host_monotonic_ms();
   let got = fta-file(path, 0, record_new(0));
   let t1 = host_monotonic_ms();
   file_size(path) > 19000000 && got[0] == 600 && len(got[1]) == 300 && t1 - t0 < 20000;
  }
  // ---- 1024 door
  def fab-c-door(ctx) {
   let base = fab-root(ctx) ++ "/door";
   let w = write_file(base ++ ".in", "{\"session\":\"zz-no-such-session\"}");
   let pid = host_spawn_at(["./fkwu", "observe/forbidden-tools-audit-run.bml"], [base ++ ".in", base ++ ".out", base ++ ".err"]);
   let status = pid <= 0 ? -1 : host_wait(pid);
   let out = read_file(base ++ ".out") ?? "";
   let lines = split-on(trim(out), "\n");
   status == 0 && len(lines) == 3 && (String) lines[0] == "forbidden-tools-audit totals sessions=0 commands=0 flagged=0 sessions-with-slips=0"
   && (String) lines[1] == "note: forbidden-tool commands in all transcripts read: 0" && (String) lines[2] == "1";
  }
  // ---- the plants
  def fab-nodedupe(rows) = foldl((acc, r) => acc + fta-file(r[0][3], 0, record_new(0))[0], 0, rows);
  def fab-c-plant-dedupe(ctx) = fab-nodedupe(fab-run(ctx, "", "", 0)) == 12 && fta-count(fab-run(ctx, "", "", 0)) == 11;
  def fab-c-plant-window(ctx) = fta-count(fab-run(ctx, "", "", 0)) != fta-count(fab-run(ctx, "", "", fab-since())) && fta-flagged(fab-run(ctx, "", "", 0)) != fta-flagged(fab-run(ctx, "", "", fab-since()));
 }
 let ctx = fab-fresh();
 nothing?(ctx) ? form_error("forbidden-tools-audit band needs a fresh directory") : 0;
 let verdict = live-claims("forbidden-tools-audit-band", ctx, [["tally", 1, 1, fab-c-tally], ["names", 2, 1, fab-c-names], ["data", 4, 1, fab-c-data], ["since", 8, 1, fab-c-since], ["scope", 16, 1, fab-c-scope], ["chunks", 32, 1, fab-c-chunks], ["time", 64, 1, fab-c-time], ["report", 128, 1, fab-c-report], ["lens", 256, 1, fab-c-lens], ["scale", 512, 1, fab-c-scale], ["door", 1024, 1, fab-c-door], ["plant-dedupe", 2048, 1, fab-c-plant-dedupe], ["plant-window", 4096, 1, fab-c-plant-window], ["window", 8192, 1, fab-c-window], ["breath", 16384, 1, fab-c-breath], ["plant-refuse", 32768, 1, fab-c-plant-refuse]]);
 host_dir_rmdir(fab-root(ctx));
 verdict;
}
