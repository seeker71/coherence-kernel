; form-cli-peer-source-symbol-action-band.fk -- retained source-definition
; lookup keeps one/choice/nothing and never reaches Qwen.
; Expected: 255
;
; preludes: form-stdlib/form-cli-peer-source-symbol-action.fk

(do
    (defn fcpssab-bit (held weight) (if held weight 0))
    (defn fcpssab-index ()
        (list (list "unique-defn" "form/unique.fk")
              (list "plural-defn" "form/first.fk")
              (list "plural-defn" "form/second.fk")))
    (defn fcpssab-context ()
        (list "/caller-root" "artifact" 0 768
            (sof-snapshot 17 (list "form") (fcpssab-index))))
    (defn form-cli-peer-source-symbol-action-band ()
        (do
            (let session (list "qwen-sentinel" 9))
            (let context (fcpssab-context))
            (let one (fcpssa-run session "source-symbol" "unique-defn"
                context 17))
            (let one-query (fcpssa-query one))
            (let one-peer (fcpssa-peer one))
            (let plural (fcpssa-run session "source-symbol" "plural-defn"
                context 17))
            (let stale (fcpssa-run session "source-symbol" "unique-defn"
                context 18))
            (let unborn (fcpssa-run session "source-symbol" "absent-defn"
                context 17))
            (let malformed (fcpssa-run session "source-symbol" "bad defn"
                context 17))
            (let wrong-kind (fcpssa-run session "source-concept" "unique-defn"
                context 17))
            (sum (list
                (fcpssab-bit (and
                    (value_eq (fcpssa-session one) session)
                    (and (str_eq (fcpssa-signal one) "value")
                    (and (str_eq (fcpssa-reason one) "symbol-one")
                    (and (eq (fcpssa-knowledge-contribution one) 1)
                         (str_eq (nth (sof-query-raw one-query) 1)
                                 "form/unique.fk"))))) 1)
                (fcpssab-bit (and
                    (str_eq (fcpa-route one-peer) "source-symbol")
                    (and (eq (fcpa-callback-calls one-peer) 0)
                    (and (eq (fcpa-injected-bytes one-peer) 0)
                    (and (str_eq (fcpa-carrier one-peer) "form-source-index")
                    (and (eq (fcpa-contribution one-peer) 0)
                         (eq (fcpa-lookup-count one-peer) 1)))))) 2)
                (fcpssab-bit (and
                    (str_eq (fcpssa-signal plural) "choice")
                    (and (str_eq (fcpssa-reason plural) "symbol-plural")
                         (eq (len (fcpssa-paths (fcpssa-query plural))) 2))) 4)
                (fcpssab-bit (and
                    (str_eq (fcpssa-signal stale) "choice")
                    (and (str_eq (fcpssa-reason stale) "source-index-stale")
                         (nothing? (sof-query-raw (fcpssa-query stale))))) 8)
                (fcpssab-bit (and
                    (str_eq (fcpssa-signal unborn) "nothing")
                    (str_eq (fcpssa-reason unborn) "symbol-unborn")) 16)
                (fcpssab-bit (and
                    (str_eq (fcpssa-signal malformed) "choice")
                    (str_eq (fcpssa-reason malformed)
                            "symbol-shape-refused")) 32)
                (fcpssab-bit (and
                    (str_eq (fcpssa-signal wrong-kind) "choice")
                    (and (str_eq (fcpssa-reason wrong-kind)
                                 "source-symbol-requires-source-symbol-task")
                         (value_eq (fcpssa-session wrong-kind) session))) 64)
                (fcpssab-bit
                    (and (eq (fcpa-lookup-count (fcpssa-peer plural)) 1)
                    (and (eq (fcpa-lookup-count (fcpssa-peer unborn)) 1)
                    (and (eq (fcpa-lookup-count (fcpssa-peer stale)) 0)
                         (eq (fcpa-lookup-count (fcpssa-peer malformed)) 0)))) 128)))))
    (form-cli-peer-source-symbol-action-band))
