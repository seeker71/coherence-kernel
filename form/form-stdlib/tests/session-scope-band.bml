// Scoped capture, delivery and publication; synthetic text only, no model run.
import form-stdlib/native-session-experience.bml;
import form-stdlib/native-session-learning.bml;
section [form.bml] {
 class SessionScopeBand {
  def scope-check(ok,label) = ok ? print_str("pass " ++ label) : form_error("session scope: " ++ label);
  def scope-band() {
   let home = ".hearth/session-scope-band-" ++ host_pid().str();
   defer fs-remove-tree(home);
   scope-check(nsm-session-settle(home) == 0 && !fs-is-dir?(home),"unconfigured session close writes nothing");
   let held = nsm-offer(home,"fixture","one","caller","a cloud","a breeze","caller-teaching","synthetic fixture",0);
   scope-check(held[0] == "" && !fs-is-dir?(home),"unconfigured offer writes no content");
   scope-check(nsm-experience(home,"fixture","direct","native-code","a","b","failed","fixture",0) == "" && nsm-record-ready(home,"fixture","direct","caller","a","b","caller-teaching","fixture") == "" && !fs-is-dir?(home),"direct collectors retain nothing without scope");
   scope-check(nsm-str(nsm-model-proposal(home,"a cloud",0),"reason") == "session-retention-scope-required" && !fs-is-dir?(home),"inference request is not persisted without scope");
   let retained = nsm-set-scope(home,"{\"owner\":\"synthetic-fixture\",\"purpose\":\"scope boundary observation\",\"retain\":1,\"train\":0}");
   let experience = nsm-offer(home,"fixture","two","caller","a cloud","a breeze","caller-teaching","synthetic fixture",0);
   scope-check(file_size(nsm-at(experience[0],"record.json")) > 0 && len(nsm-dirs(home)) == 0 && !nsm-enabled(home),"retention alone creates no training example");
   let training = nsm-set-scope(home,"{\"owner\":\"synthetic-fixture\",\"purpose\":\"scope boundary observation\",\"retain\":1,\"train\":1}");
   let paused = nsm-pause(home,1);
   let example = nsm-record(home,"fixture","three","caller","a cloud","a breeze","caller-teaching","synthetic fixture",0);
   scope-check(file_size(nsm-at(example,"record.json")) > 0 && !nsm-enabled(home),"training scope and operational pause remain distinct");
   let sources = nss-catalog(home);
   scope-check(len(sources) == 1 && nsm-str(nsm-json(nsm-at(home,"evidence-catalog.json")),"scope") == "explicit-home-only","source catalog stays in the selected home");
   let reference = nsx-reference(home,nsm-experience-path(home,"fixture","three"),"experience");
   scope-check(!node_eq(nsx-read(reference),json-node-null()),"authorized experience is readable");
   let prepared = json-node-object([nsm-s("scope_id",nsm-scope-id(home)),json-node-pair("training_sources",json-node-array(sources))]);
   scope-check(nsl-before-current(home,prepared),"prepared bundle binds current source scope");
   let state = nsm-write(nsm-at(home,"state.json"),json-node-object([nsm-s("scope_id",nsm-scope-id(home)),nsm-s("candidate","synthetic-adapter")]));
   let changed = nsm-set-scope(home,"{\"owner\":\"different-fixture\",\"purpose\":\"different scope\",\"retain\":1,\"train\":1}");
   scope-check(nsm-str(nsm-state(home),"candidate") == "" && nsl-ask-memory(home,"a cloud") == "" && node_eq(nsx-read(reference),json-node-null()) && len(nsm-pending(home,nsm-dirs(home))) == 0 && !nsl-before-current(home,prepared),"new owner or purpose adopts no prior content or adapter");
   let restored = nsm-set-scope(home,"{\"owner\":\"synthetic-fixture\",\"purpose\":\"scope boundary observation\",\"retain\":1,\"train\":1}");
   let removed = fs-remove-file(nsm-at(home,"state.json"));
   let withdrawn = nsm-write(nsm-withdrawal(example),json-node-object([nsm-s("reason","synthetic withdrawal")]));
   scope-check(node_eq(nsx-read(reference),json-node-null()) && !nss-source-current(sources[0]),"withdrawn teaching leaves recall and source delivery");
   scope-check(!nsl-before-current(home,prepared),"prepared bundle detects withdrawn source or rehearsal");
   let target = nsm-record(home,"fixture","target","caller","a leaf","a tree","caller-teaching","synthetic fixture",0);
   let offered = nsm-write(nsm-at(target,"training-evidence.json"),json-node-object([json-node-pair("delivery",json-node-object([json-node-pair("sources",json-node-array(sources))]))]));
   let used = nsl-training-sources(home,target,json-node-object([]),[]);
   let primaryOnly = json-node-object([nsm-s("scope_id",nsm-scope-id(home)),json-node-pair("training_sources",json-node-array(used))]);
   scope-check(len(used) == 1 && nsl-before-current(home,primaryOnly),"unused withdrawn offer does not block a valid primary row");
   let inherited = nsl-training-sources(home,target,json-node-object([nsm-s("candidate","synthetic-adapter"),nsm-s("last_row",example)]),[]);
   let parentBound = json-node-object([nsm-s("scope_id",nsm-scope-id(home)),json-node-pair("training_sources",json-node-array(inherited))]);
   scope-check(len(inherited) == 2 && !nsl-before-current(home,parentBound),"withdrawn candidate parent holds its descendant");
   let revoked = nsm-set-scope(home,"{\"owner\":\"synthetic-fixture\",\"purpose\":\"scope boundary observation\",\"retain\":0,\"train\":0}");
   scope-check(nsm-experience(home,"fixture","later","caller","a","b","failed","fixture",0) == "" && len(nss-catalog(home)) == 0 && nsx-context(nsx-recall(home,"cloud","dialogue")) == "[]","revocation stops capture and recall");
   scope-check(nsl-training-admit(home,example,nothing()) == "training-scope-held" && nsl-evaluate(home,example,nothing(),"candidate") == "assessment-scope-held","revocation holds new gradient and assessment admission");
   scope-check(nsl-publish-state(home,example,nothing(),"candidate",[],1,1,"seal","candidate","seal",nothing(),nothing()) == "publication-held;scope-or-teaching-withdrawn" && file_size(nsm-at(home,"state.json")) <= 0,"revocation holds in-flight candidate publication");
   scope-check(file_size(nsm-at(example,"record.json")) > 0,"revocation makes no erasure claim");
   let before = nsm-text(nsm-at(home,"events.jsonl"));
   let foreign = nag-write(nsm-at(home,"worker.pid"),host_pid().str());
   scope-check(nsm-session-settle(home) == 0 && nsm-text(nsm-at(home,"events.jsonl")) == before,"unowned supervisor receives no close writes or wait");
   let child = nsm-at(home,"settle-child.bml");
   let source = nag-write(child,"section [form.bml] { let path = read_line(); let pause = host_sleep_ms(250); let wrote = write_file(path,\"done\"); print_str(\"complete\"); }\n");
   let input = nsm-at(home,"settle-child.in");
   let request = nag-write(input,nsm-at(home,"child.done") ++ "\n");
   let pid = host_spawn_at(["./fkwu",child],[input,nsm-at(home,"child.out"),nsm-at(home,"child.err")]);
   scope-check(pid > 0 && nsm-worker-parent(pid) == host_pid(),"synthetic supervisor belongs to this session");
   let owner = nag-write(nsm-at(home,"worker.pid"),pid.str());
   let settled = nsm-session-settle(home);
   scope-check(nsm-text(nsm-at(home,"child.done")) == "done" && host_wait(pid) < 0 && !nsm-retention(home),"owned supervisor is reaped after scope withdrawal");
   let failedSource = nag-write(child,"section [form.bml] { let pause = host_sleep_ms(100); form_error(\"synthetic-supervisor-failure\"); }\n");
   let failedPid = host_spawn_at(["./fkwu",child],[input,nsm-at(home,"worker.out"),nsm-at(home,"worker.err")]);
   let failedOwner = nag-write(nsm-at(home,"worker.pid"),failedPid.str());
   let failureSettled = nsm-session-settle(home);
   let failure = nsm-wait-record(home);
   scope-check(failedPid > 0 && nsm-num(failure,"worker_pid") == failedPid && nsm-num(failure,"wait_exit") > 0 && nsm-str(failure,"stderr_state") == "retained" && nsm-text(nsm-str(failure,"stderr")) == nsm-text(nsm-at(home,"worker.err")) && str_find(nsm-text(nsm-str(failure,"stderr")),"synthetic-supervisor-failure",0) >= 0 && file_size(nsm-at(example,"record.json")) > 0,"owned failure after withdrawal preserves exact evidence and prior examples");
   print_str("session-scope: 22 passed; model_calls=0");
  }
 }
 scope-band();
}
