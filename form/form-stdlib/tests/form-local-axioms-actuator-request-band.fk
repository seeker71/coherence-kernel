; form-local-axioms-actuator-request-band.fk -- exact pair request adversaries.
;
; Expected: 4095
; preludes: form-stdlib/form-local-axioms-actuator-request.fk

(do
    (defn flarb-bit (ok bit) (if ok bit 0))
    (let exact (flar-request (flar-target) (flar-action)
        "/fixture/qwen.gguf" "fixture-qwen"))
    (let wrong-identity (flar-request "heldout-local-form-transfer"
        (flar-action) "/fixture/qwen.gguf" "fixture-qwen"))
    (let wrong-action (flar-request (flar-target)
        (fmcl-persistence-category) "/fixture/qwen.gguf" "fixture-qwen"))
    (let no-path (flar-request (flar-target) (flar-action) "" "fixture-qwen"))
    (let no-model (flar-request (flar-target) (flar-action)
        "/fixture/qwen.gguf" ""))
    (sum (list
        (flarb-bit (eq (flar-request-valid? exact) 1) 1)
        (flarb-bit (str_eq (flar-identity exact) (flar-target)) 2)
        (flarb-bit (node_eq (flar-action-of exact) (fmcl-attempt-category)) 4)
        (flarb-bit (eq (flar-request-valid? wrong-identity) 0) 8)
        (flarb-bit (eq (flar-request-valid? wrong-action) 0) 16)
        (flarb-bit (eq (flar-request-valid? no-path) 0) 32)
        (flarb-bit (eq (flar-request-valid? no-model) 0) 64)
        (flarb-bit (eq (flar-request-valid? (nothing)) 0) 128)
        (flarb-bit (eq (flar-request-valid? (list)) 0) 256)
        (flarb-bit (eq (flar-request-valid?
            (list (flar-schema) (flar-target) (flar-action)
                  "/fixture/qwen.gguf" "fixture-qwen" "extra")) 0) 512)
        (flarb-bit (eq (node_eq (flar-action)
                                (fmcl-request-category)) 0) 1024)
        (flarb-bit (and (eq (str_len (flar-path exact)) 18)
                        (str_eq (flar-model-id exact) "fixture-qwen")) 2048))))
