; bearing-census-band.fk — the measure of how much of the body stands on a door.
;
; Expected: 32767
; preludes: form/form-stdlib/bearing-census.bml
;
; PURE. Every row, edge and native name below is written by hand, so the band
; proves the ARITHMETIC of the census and never the machine's mood. The live
; reading is a different witness (observe/bearing-census-run.fk); a band that
; measured a running body would grade the weather.
;
; The hand-built body under test — six doors, the shape substring wore:
;
;     top ──► mid-a ──┐
;      │              ├──► deep          deep is the door three levels down
;      ├──► mid-b ────┘                  that both middles lean on: its own
;      │      └──► str_concat            700 steps are carried by mid-a AND
;      └──► fast                         by mid-b AND by top.
;
;   heat:  top 10   mid-a 100   mid-b 200   deep 700   str_concat 50   fast 400
;   total 1460 — and the whole process walked 2920, so this census saw half of it.
;
; The three claims the measure exists to make, each with its own bit:
;   - a door under two callers carries both their weights (c1, c2, c8, c9);
;   - a hot NATIVE is never reported as a recipe to heal (c5) — str_concat is
;     in the op table, so the walking that reaches it is a routing wound, and
;     its drag is zero, so it can never stand as "the next substring";
;   - an unmeasured door says no-reading, not zero (c7) — the distinction the
;     whole measure exists for, because a door that reads as free is exactly
;     how substring hid for months.

(do
    (defn bcb-bit (ok bit) (if (eq ok 1) bit 0))
    (defn bcb-q () (byte_to_str 34))
    (defn bcb-nl () (byte_to_str 10))

    ; a hot row as kernel_hot_rows gives it: heat name unit line col boxes unboxes crystal spare
    (defn bcb-row (heat name line crystal) (list heat name "form/form-stdlib/tests/bearing-census-band.fk" line 9 0 0 crystal 0))
    (defn bcb-rows ()
        (list (bcb-row 10  "top"        101 0)
              (bcb-row 100 "mid-a"      102 0)
              (bcb-row 200 "mid-b"      103 0)
              (bcb-row 700 "deep"       104 0)
              (bcb-row 50  "str_concat" 105 0)
              (bcb-row 400 "fast"       106 2)))
    (defn bcb-edges ()
        (list (list "top" "mid-a") (list "top" "mid-b") (list "top" "fast")
              (list "mid-a" "deep")
              (list "mid-b" "deep") (list "mid-b" "str_concat")))

    ; two op-table rows in the seed's own spelling, so the lifter is proven on the
    ; exact bytes runtime/fkwu-optable.h carries and not on a convenient shape
    (defn bcb-op-row (name arity tag)
        (str_concat "  { " (str_concat (bcb-q) (str_concat name (str_concat (bcb-q)
            (str_concat ", " (str_concat (int_to_str arity) (str_concat ", " (str_concat (int_to_str tag) " },")))))))))
    (defn bcb-table ()
        (str_concat (bcb-op-row "str_concat" 2 27) (str_concat (bcb-nl) (bcb-op-row "substring" 3 14))))

    ; a four-line hand unit carrying both authoring lanes, a comment that names a door the
    ; body does NOT call, and a line that opens nothing
    (defn bcb-lines ()
        (list "        def alpha(x) = beta(add(x, 1));"
              "        // a note naming gamma, which alpha does not call"
              "    (defn beta (x) (gamma x))"
              "        let stray = 2;"))
    (defn bcb-units () (list (list "hand-written" (bcb-lines))))
    (defn bcb-graph-names () (list "alpha" "beta" "gamma"))

    (let rows (bcb-rows))
    (let edges (bcb-edges))
    (let natives (bcs-native-names (bcb-table)))
    (let reaches (bcs-reaches edges (bcs-names rows)))
    (let census (bcs-census rows edges natives))
    (let deep (bcs-of census "deep"))
    (let top (bcs-of census "top"))
    (let mida (bcs-of census "mid-a"))
    (let midb (bcs-of census "mid-b"))
    (let sc (bcs-of census "str_concat"))
    (let fast (bcs-of census "fast"))
    (let ghost (bcs-of census "ghost"))

    ; 1 — bearing is the door's own steps plus everything reachable from it.
    ; top reaches all six, so it carries the whole 1460; deep is a leaf and carries its own 700.
    (let c0 (bcb-bit (and (eq (bcs-c-bearing deep) 700) (eq (bcs-c-bearing top) 1460)) 1))

    ; 2 — the claim the measure was built for: deep sits under BOTH middles, and its
    ; 700 steps appear in mid-a's 800 (100 + 700) and in mid-b's 950 (200 + 700 + 50).
    ; Neither caller's reading discounts it for being shared.
    (let c1 (bcb-bit (and (eq (bcs-c-bearing mida) 800) (eq (bcs-c-bearing midb) 950)) 2))

    ; 4 — leaning counts the distinct doors that REACH a door, transitively: deep is
    ; reached by top, mid-a and mid-b; top is reached by nobody.
    (let c2 (bcb-bit (and (eq (bcs-c-leaning deep) 3)
                     (and (eq (bcs-c-leaning top) 0)
                     (and (eq (bcs-c-leaning sc) 2) (eq (bcs-c-leaning fast) 1)))) 4))

    ; 8 — share of the census's own walking, in basis points. deep is 700 of 1460.
    (let c3 (bcb-bit (and (eq (bcs-c-share deep) 4794) (eq (bcs-c-share top) 10000)) 8))

    ; 16 — cost per call, x100. This is what tells a cheap door called constantly from an
    ; expensive door called twice: deep and top have bearings within a factor of two, and
    ; per call they are 1.0 and 146.0 steps apart.
    (let c4 (bcb-bit (and (eq (bcs-c-per-call deep) 100)
                     (and (eq (bcs-c-per-call top) 14600) (eq (bcs-c-per-call mida) 800))) 16))

    ; 32 — a hot NATIVE is not a recipe to heal. str_concat stands in the op table, so the
    ; walking that still reaches it asks for routing, never for minting, and its drag is 0 —
    ; it can never be named the next substring however hot it runs.
    (let c5 (bcb-bit (and (str_eq (bcs-c-kind sc) "shadowed")
                     (and (str_eq (bcs-c-remedy sc) "route-to-the-native-that-stands")
                     (and (eq (bcs-c-drag sc) 0) (eq (bcs-heal? natives rows "str_concat") 0)))) 32))

    ; 64 — a door the JIT already crystallized stopped walking; that is the measure
    ; working, not a blind spot. It asks for nothing.
    (let c6 (bcb-bit (and (str_eq (bcs-c-kind fast) "crystal")
                     (and (str_eq (bcs-c-remedy fast) "stands-crystallized") (eq (bcs-c-drag fast) 0))) 64))

    ; 128 — the honesty bit. A door with no row is UNMEASURED, and every number about it
    ; says so: -1, not 0. A zero would read as free, which is exactly how a door costing
    ; the world stays invisible.
    (let c7 (bcb-bit (and (eq (bcs-measured? rows "ghost") 0)
                     (and (eq (bcs-bearing rows reaches "ghost") -1)
                     (and (eq (bcs-c-share ghost) -1)
                     (and (eq (bcs-c-per-call ghost) -1) (str_eq (bcs-c-kind ghost) "no-reading"))))) 128))

    ; 256 — the standing name: the answer to "what is the next substring?" is one word.
    ; deep wins on the product, not on either factor alone — top has the larger share and
    ; mid-b the larger bearing among the middles.
    (let c8 (bcb-bit (str_eq (bcs-worst-name census) "deep") 256))

    ; 512 — the ranking arithmetic in full: share x (leaning + 1), heal candidates only.
    (let c9 (bcb-bit (and (eq (bcs-c-drag deep) 19176)
                     (and (eq (bcs-c-drag midb) 13012)
                     (and (eq (bcs-c-drag mida) 10958)
                     (and (eq (bcs-c-drag top) 10000) (eq (len (bcs-heal-list census)) 4))))) 512))

    ; 1024 — the census reports what it did NOT see. 1460 of a 2920-step process is half,
    ; and a census over a process that walked nothing has no coverage rather than full coverage.
    (let c10 (bcb-bit (and (eq (bcs-coverage-bp (bcs-total-heat rows 0) 2920) 5000)
                      (and (eq (bcs-total-heat rows 0) 1460)
                           (eq (bcs-coverage-bp 1460 0) -1))) 1024))

    ; 2048 — the natives come off the op table's own bytes: one forward pass, both names,
    ; and a recipe name is not among them. And a door can carry a native's MEANING under
    ; another name — sha256.fk walks its own nth-rec while nth stands native — so the stem
    ; is held against the table too. A twin NAMES the native to check against; it is a
    ; lead, not a proof, and a door whose stem is itself is never its own twin.
    (let c11 (bcb-bit (and (eq (len natives) 2)
                      (and (eq (bcs-native? natives "str_concat") 1)
                      (and (eq (bcs-native? natives "substring") 1)
                      (and (eq (bcs-native? natives "deep") 0)
                      (and (str_eq (bcs-stem "substring-loop") "substring")
                      (and (str_eq (bcs-stem "fstr-substring") "substring")
                      (and (str_eq (bcs-twin natives "substring-loop") "substring")
                      (and (str_eq (bcs-twin natives "deep") "")
                           (str_eq (bcs-twin natives "str_concat") ""))))))))) 2048))

    ; 4096 — an edge needs both boundaries free. `deep` inside `fstr-deep` and inside
    ; `deep-well` is the same bytes and not the same door — the exact confusion that would
    ; have drawn a false edge from every door mentioning substring in a comment.
    (let c12 (bcb-bit (and (eq (bcs-mentions? "(deep x)" "deep") 1)
                      (and (eq (bcs-mentions? "(fstr-deep x)" "deep") 0)
                      (and (eq (bcs-mentions? "(deep-well x)" "deep") 0)
                      (and (eq (bcs-mentions? "  deep" "deep") 1)
                           (eq (bcs-mentions? "nothing here" "deep") 0))))) 4096))

    ; 8192 — a door is found by its NAME, never by the row's line: a hot row's unit and line
    ; are coordinates in a resolution frame's resolved text, so reading a body at that line
    ; quotes the wrong door confidently. A body ends where the next door opens, in either
    ; authoring lane — and a comment is not a call, so alpha reaches beta and NOT the gamma
    ; its note names. Without that cut, core.fk's own prose about substring would draw
    ; twenty edges out of one comment.
    (let c13b (bcs-body (bcb-lines) 1))
    (let c13 (bcb-bit (and (eq (bcs-opens-def? "        def alpha(x) = 1;") 1)
                      (and (eq (bcs-opens-def? "    (defn beta (x) 1)") 1)
                      (and (eq (bcs-opens-def? "        let stray = 2;") 0)
                      (and (str_eq (bcs-def-name (nth (bcb-lines) 0)) "alpha")
                      (and (str_eq (bcs-def-name (nth (bcb-lines) 2)) "beta")
                      (and (str_eq (bcs-def-name (nth (bcb-lines) 3)) "")
                      (and (eq (bcs-mentions? c13b "beta") 1)
                           (eq (bcs-mentions? c13b "gamma") 0)))))))) 8192))

    ; 16384 — the graph from an indexed unit: edges name what a body reaches and nothing
    ; else, no door gets an edge to itself, and a name that is MENTIONED but never DEFINED
    ; in the units given is named unread — its callees are unknown, so its bearing would be
    ; a floor rather than a reading, and the census names which doors those are.
    (let c14i (bcs-index (bcb-units) (bcb-graph-names)))
    (let c14e (bcs-graph-indexed (bcb-graph-names) c14i))
    (let c14 (bcb-bit (and (eq (len c14e) 2)
                      (and (eq (bcs-member? (bcs-callees c14e "alpha" (list)) "beta") 1)
                      (and (eq (bcs-member? (bcs-callees c14e "alpha" (list)) "gamma") 0)
                      (and (eq (bcs-member? (bcs-callees c14e "alpha" (list)) "alpha") 0)
                      (and (eq (bcs-member? (bcs-callees c14e "beta" (list)) "gamma") 1)
                      (and (eq (len (bcs-reach c14e "alpha")) 3)
                      (and (eq (len (bcs-unread-in (bcb-graph-names) c14i)) 1)
                           (eq (bcs-member? (bcs-unread-in (bcb-graph-names) c14i) "gamma") 1)))))))) 16384))

    (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14)))
