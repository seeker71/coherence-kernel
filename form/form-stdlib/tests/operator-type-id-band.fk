; operator-type-id-band.fk — the NUMS-inspired shape, without its registry.
;
; Verdict 262143:
;   1       a coordinate retains package
;   2       a coordinate retains level
;   4       NodeType is the reusable family coordinate
;   8       NodeInstance is the member within that family
;   16      family identity is the three-coordinate prefix; zero remains a member
;   32      blueprint type and recipe operator construction share coordinates
;   64      apply retains the operator category and ordered operands
;   128     equal coordinate plus children has equal content identity
;   256     a changed operation changes content identity
;   512     all u16/u32 maxima are admitted
;   1024    negative and one-past-width coordinates are refused as nothing
;   2048    the capacity is 65536 families x 4294967296 operations
;   4096    applied-node accessors read type/operation from its category
;   8192    applied occurrence identity stays distinct from operator identity
;   16384   package.level.type exposes 2^48 type-family coordinates
;   32768   the complete coordinate is 80 bits / 2^80 exact positions
;   65536   same-family and in-family are structural across operators/applies
;   131072  equal type numbers at different levels remain different families
;
; preludes: form-stdlib/core.fk form-stdlib/operator-type-id.bml
; witnessed: 2026-09-02 -> 262143

(do
    (defn otib-bit (ok bit) (if ok bit 0))
    (let op-family (oti-family 31 7 9))
    (let op (oti-operator op-family 7))
    (let blueprint-type (oti-type op-family 7))
    (let other-family (oti-family 31 6 9))
    (let child-family (oti-family 31 7 3))
    (let child-a (oti-operator child-family 1))
    (let child-b (oti-operator child-family 3))
    (let composed-a (oti-compose op-family 1 (list child-a child-b)))
    (let composed-b (oti-compose op-family 1 (list child-a child-b)))
    (let composed-c (oti-compose op-family 2 (list child-a child-b)))
    (let composed-swapped (oti-compose op-family 1 (list child-b child-a)))
    (let u32-capacity (mul 65536 65536))
    (let u32-max (sub u32-capacity 1))
    (let max-node (oti-coordinate 65535 65535 65535 u32-max))
    (sum (list
        (otib-bit (eq (node_pkg op) 31) 1)
        (otib-bit (eq (node_level op) 7) 2)
        (otib-bit (node_eq (oti-operator-family op) op-family) 4)
        (otib-bit (eq (oti-operation op) 7) 8)
        (otib-bit (and (eq (oti-family? op-family) 1)
                       (and (eq (oti-family? op) 1)
                            (node_eq (oti-member op-family 0) op-family))) 16)
        (otib-bit (and (node_eq op blueprint-type)
                       (and (eq (node_pkg op) (node_pkg op-family))
                            (eq (node_level op) (node_level op-family)))) 32)
        (otib-bit (and (node_eq (node_category composed-a) (oti-operator op-family 1))
                       (and (eq (len (node_children composed-a)) 2)
                            (and (node_eq (nth (node_children composed-a) 0) child-a)
                                 (and (node_eq (nth (node_children composed-a) 1) child-b)
                                      (not (node_eq composed-a composed-swapped)))))) 64)
        (otib-bit (node_eq composed-a composed-b) 128)
        (otib-bit (not (node_eq composed-a composed-c)) 256)
        (otib-bit (and (eq (node_pkg max-node) 65535)
                       (and (eq (node_level max-node) 65535)
                            (and (eq (node_type max-node) 65535)
                                 (eq (node_inst max-node) u32-max)))) 512)
        (otib-bit (and (nothing? (oti-coordinate -1 2 3 1))
                       (and (nothing? (oti-coordinate 65536 2 3 1))
                            (nothing? (oti-coordinate 1 2 3 u32-capacity)))) 1024)
        (otib-bit (and (eq (oti-families-per-package-level) 65536)
                       (eq (oti-members-per-family) u32-capacity)) 2048)
        (otib-bit (and (node_eq (oti-operator-family composed-a) op-family)
                       (eq (oti-operation composed-a) 1)) 4096)
        (otib-bit (and (not (node_eq composed-a (node_category composed-a)))
                       (and (eq (node_pkg composed-a) 0)
                            (eq (node_pkg (node_category composed-a)) 31))) 8192)
        (otib-bit (and (eq (oti-package-capacity) 65536)
                       (and (eq (oti-level-capacity) 65536)
                            (eq (oti-type-coordinate-capacity)
                                (mul (mul 65536 65536) 65536)))) 16384)
        (otib-bit (and (eq (oti-total-coordinate-bits) 80)
                       (str_eq (oti-total-coordinate-capacity-decimal)
                           "1208925819614629174706176")) 32768)
        (otib-bit (and (oti-same-family? op composed-a)
                       (and (eq (oti-in-family? composed-a op-family) 1)
                            (eq (oti-in-family? composed-a other-family) 0))) 65536)
        (otib-bit (and (eq (oti-family-index op) 9)
                       (not (node_eq op-family other-family))) 131072))))
