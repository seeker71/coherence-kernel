; form-cli-gpu-band.fk — BML names the GPU programs; JIT, Metal, MLX run them.
;
; Verdict 1023:
;     1  BML named programs (fcg-check)
;     2  mlx softmax sums to 1
;     4  mlx sharp attention returns 100
;     8  mlx uniform attention returns 20
;    16  mlx 2 3 add is 5
;    32  JIT arm64 leaf 2+3 is 5
;    64  class descriptor FormCliGpu
;   128  mlx add program is the BML field
;   256  softmax token is in the BML thought
;   512  mlx linked
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-gpu-xtal.fk
; witnessed: 2026-08-21 -> 1023

(do
    (defn fcg-score (ok bit) (if ok bit 0))
    (defn fcg-has (hay needle) (if (lt (str_find hay needle 0) 0) 0 1))
    (defn fcg-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (fcg-has-name? (tail xs) name))))
    (defn fcg-live? () (fcg-has (mlx_status) "mlx_linked=true"))
    (defn fcg-jit-add ()
        (jit_arm64_u32_leaf (list (list 2) (list 1 3) (list 3 0 1)) 2 2))

    (let named (fcg-check))
    (let live (fcg-live?))
    (let desc (FormCliGpu))
    (let thoughts (nth desc 6))
    (let c0 (fcg-score (eq named 63) 1))
    (let c1 (fcg-score (if (eq live 1) (eq (mlx_run (fcg-softmax-sum)) 1) 0) 2))
    (let c2 (fcg-score (if (eq live 1) (eq (mlx_run (fcg-attn-sharp)) 100) 0) 4))
    (let c3 (fcg-score (if (eq live 1) (eq (mlx_run (fcg-attn-uniform)) 20) 0) 8))
    (let c4 (fcg-score (if (eq live 1) (eq (mlx_run (fcg-add)) 5) 0) 16))
    (let c5 (fcg-score (eq (fcg-jit-add) 5) 32))
    (let c6 (fcg-score (str_eq (nth desc 1) "FormCliGpu") 64))
    (let c7 (fcg-score (str_eq (fcg-add) "2 3 add") 128))
    (let c8 (fcg-score (eq (fcg-has-name? thoughts "fcg-pattern") 1) 256))
    (let c9 (fcg-score (eq live 1) 512))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 c9))))))))))
