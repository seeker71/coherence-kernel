; qwen35-tokenizer-bounded-artifact-band.fk -- pure synthetic artifact proof.
;
; No GGUF, model, filesystem write, whole vocabulary, or whole merge table is
; touched.  Every parser consumes a BMF raw-byte string cursor.  The live file
; window and one-breath writer are witnessed separately by the effectful door.
;
; preludes: form-stdlib/qwen35-tokenizer-bounded-artifact.fk

(do
    (defn q35tbab-bit (ok bit) (if ok bit 0))
    (let manifest (qwen35-tokenizer-bounded-manifest))
    (let bmf-manifest (bmf-cursor-language-manifest))
    (let va (q35tba-vocab-row-text 0 0 1 (list 97)))
    (let vb (q35tba-vocab-row-text 1 0 1 (list 98)))
    (let vc (q35tba-vocab-row-text 7 0 3 (list 97)))
    (let vnon (q35tba-vocab-row-text 9 0 1 (list 200 0 255)))
    (let rows (str_concat va (str_concat vb vc)))
    (let a (q35tba-vocab-cursor-lookup (cursor-str rows) (list 97) 0 1 0 10000))
    (let b (q35tba-vocab-cursor-lookup (cursor-str rows) (list 98) 0 1 0 10000))
    (let miss (q35tba-vocab-cursor-lookup (cursor-str rows) (list 99) 0 1 0 10000))
    (let ctl (q35tba-vocab-cursor-lookup (cursor-str rows) (list 97) 0 3 1 10000))
    (let non (q35tba-vocab-cursor-lookup (cursor-str vnon) (list 200 0 255) 0 1 0 10000))
    (let m0 (q35tba-merge-row-text 0 (list 97) (list 98)))
    (let m1 (q35tba-merge-row-text 1 (list 98) (list 99)))
    (let mrows (str_concat m0 m1))
    (let mr0 (q35tba-merge-cursor-lookup (cursor-str mrows) (list 97) (list 98) 10000))
    (let mr1 (q35tba-merge-cursor-lookup (cursor-str mrows) (list 98) (list 99) 10000))
    (let timed (q35tba-vocab-cursor-lookup (cursor-str rows) (list 97) 0 1 0 1))
    (let malformed (q35tba-vocab-cursor-lookup (cursor-str "V|x|0|1|1|61\n")
                                               (list 97) 0 1 0 1000))
    (let seal (q35tba-seal 1 1000 2000 3 2 3 2 1 1 256 64 96))
    (let seal-parsed (q35tba-parse-seal-cursor (cursor-str (q35tba-seal-text seal)) 10000))
    (let seal-value (q35tba-seal-result-value seal-parsed))
    (let incomplete (q35tba-seal 1 1000 2000 3 2 2 2 0 1 256 64 96))
    (let slice (q35tba-seal 1 1000 2000 3 2 3 2 1 0 256 64 96))
    (let over-breath (q35tba-seal 1 1000 2000 3 2 3 2 1 1 256 65 96))
    (let over-row (q35tba-seal 1 1000 2000 3 2 3 2 1 1 256 64 17001))
    (sum (list
        (q35tbab-bit (eq (q35tba-manifest-has? "bmf-scannerless-byte-cursor" manifest) 1) 1)
        (q35tbab-bit (eq (q35tba-manifest-has? "no-tokenizer-control-of-bmf" manifest) 1) 2)
        (q35tbab-bit (and (eq (bmf-manifest-has? "scannerless" bmf-manifest) 1)
                           (eq (bmf-manifest-has? "no-token-stream" bmf-manifest) 1)) 4)
        (q35tbab-bit (str_eq (q35tba-bucket-name "vocab" (list 97 98))
                             "vocab-61-62.rows") 8)
        (q35tbab-bit (and (eq (q35tba-outcome-present? a) 1)
                           (eq (q35tba-outcome-value a) 0)) 16)
        (q35tbab-bit (and (eq (q35tba-outcome-present? b) 1)
                           (eq (q35tba-outcome-value b) 1)) 32)
        (q35tbab-bit (and (eq (q35tba-outcome-present? miss) 0)
                           (nothing? (q35tba-outcome-value miss))) 64)
        (q35tbab-bit (and (eq (q35tba-outcome-value ctl) 7)
                           (eq (q35tba-outcome-present? ctl) 1)) 128)
        (q35tbab-bit (and (eq (q35tba-outcome-rows a) 3)
                           (eq (q35tba-outcome-cuts a) 1)) 256)
        (q35tbab-bit (and (eq (q35tba-outcome-value mr0) 0)
                           (eq (q35tba-outcome-present? mr0) 1)) 512)
        (q35tbab-bit (and (eq (q35tba-outcome-value mr1) 1)
                           (eq (q35tba-outcome-present? mr1) 1)) 1024)
        (q35tbab-bit (and (str_eq (q35tba-outcome-status timed) "timeout")
                           (and (nothing? (q35tba-outcome-value timed))
                                (eq (q35tba-outcome-timeouts timed) 1))) 2048)
        (q35tbab-bit (and (str_eq (q35tba-outcome-status malformed) "failure")
                           (and (eq (q35tba-outcome-refinements malformed) 1)
                                (eq (q35tba-outcome-released? malformed) 1))) 4096)
        (q35tbab-bit (and (str_eq (q35tba-seal-result-status seal-parsed) "ok")
                           (eq (q35tba-seal-current? seal-value 1000 2000) 1)) 8192)
        (q35tbab-bit (eq (q35tba-seal-current? seal-value 1001 2000) 0) 16384)
        (q35tbab-bit (eq (q35tba-seal-current? incomplete 1000 2000) 0) 32768)
        (q35tbab-bit (eq (q35tba-seal-current? slice 1000 2000) 0) 65536)
        (q35tbab-bit (eq (q35tba-seal-current? over-breath 1000 2000) 0) 131072)
        (q35tbab-bit (eq (q35tba-seal-current? over-row 1000 2000) 0) 262144)
        (q35tbab-bit (and (eq (q35tba-outcome-present? non) 1)
                           (eq (q35tba-outcome-value non) 9)) 524288)
        (q35tbab-bit (and (gt (q35tba-outcome-choices a) 0)
                           (and (gt (q35tba-outcome-undos a) 0)
                                (and (eq (q35tba-outcome-cuts a) 1)
                                     (eq (q35tba-outcome-released? a) 1)))) 1048576)
        (q35tbab-bit (str_eq (q35tba-seal-result-status
                              (q35tba-parse-seal-cursor (cursor-str "S|1|x\n") 100))
                             "malformed") 2097152)
        (q35tbab-bit (and (le (q35tba-window-bytes) (fbw-max-window))
                           (and (le (q35tba-max-breath-rows) 64)
                                (le (str_len vnon) (q35tba-max-row-bytes)))) 4194304)
        (q35tbab-bit (and (not (nothing? (q35tba-outcome-value a)))
                           (and (not (nothing? (q35tba-outcome-value b)))
                                (nothing? (q35tba-outcome-value miss)))) 8388608))))
