; form-glass-wait-band.fk — the glass wakes on the word.
;
; host_sleep_ms is the glass's rest and its wait door. An int ask rests that many milliseconds and lands
; within half a millisecond (the rest is sliced; nanosleep alone landed 1-10 ms late on this host). A list
; ask (budget handle ...) rests at most the budget and wakes the moment a watched gift frame's seq word
; moves -- a control offer or a frame publish ends the rest within a millisecond; a (handle seq) pair
; names the seq the caller last saw, so a give that already happened wakes at once. A child process
; publishes into a frame 200 ms after it says hello; this process, resting 1000 ms on that frame, wakes
; when the word moves, not when the budget ends. The same child's program surface (/fg-c<pid>-A|S|D) is
; read where it lives: its defn table row and the source bytes of its first defn's name. mlx_live answers
; the MLX carrier as words and the observer's rows read them without parsing; the allocator ledger (active, peak, cache, limit) comes beside them from mlx_status by field name, because mlx_live carries exactly twelve words. The event loop names the
; door available and the glass footer names it.
;
; Expected: 255
; preludes: form/form-stdlib/form-glass-live.bml

(do
    (defn fgwb-bit (ok bit) (if ok bit 0))
    (defn fgwb-rest-us (n acc) (if (le n 0) acc (fgwb-rest-us (sub n 1) (cons (nth (host_sleep_ms (list 10)) 2) acc))))
    (defn fgwb-within (l lo hi) (if (eq (len l) 0) 0 (add (if (and (ge (head l) lo) (le (head l) hi)) 1 0) (fgwb-within (tail l) lo hi))))
    (defn fgwb-max (l m) (if (eq (len l) 0) m (fgwb-max (tail l) (if (gt (head l) m) (head l) m))))
    (defn fgwb-min (l m) (if (eq (len l) 0) m (fgwb-min (tail l) (if (lt (head l) m) (head l) m))))
    ; the rest lands: twenty 10 ms asks, measured in microseconds by the door itself
    (let rests (fgwb-rest-us 20 (list)))
    (let landed (fgwb-within rests 10000 10500))
    (let plain (host_sleep_ms 10))
    (let shape (host_sleep_ms (list 5)))
    ; the wait wakes on the word: a child gives into the frame 200 ms after its hello
    (let handle (ggf-offer "form-glass-wait-band.child" 4096))
    (let cleared (node_gift_write handle (list)))
    (let seq0 (shm_seq handle))
    (let child (host_spawn_quiet (list "./fkwu" "form/form-stdlib/tests/form-glass-wait-child.fk")))
    (let arrived (host_sleep_ms (list 20000 (list handle seq0))))
    (let hello (node_gift_read handle))
    (let seq1 (shm_seq handle))
    (let pid (if (and (eq (len hello) 2) (eq (nth hello 1) 1)) (nth hello 0) -1))
    (let t0 (host_monotonic_ms))
    (let woke (host_sleep_ms (list 1000 (list handle seq1))))
    (let t1 (host_monotonic_ms))
    (let elapsed (sub t1 t0))
    (let second (node_gift_read handle))
    (let seq2 (shm_seq handle))
    (let t2 (host_monotonic_ms))
    (let stale (host_sleep_ms (list 1000 (list handle (sub seq2 2)))))
    (let t3 (host_monotonic_ms))
    (let quiet (host_sleep_ms (list 30 handle)))
    ; the child's program surface, read where it lives
    (let header (if (gt pid 0) (kernel_ast pid -1) (nothing)))
    ; the child's own defn is recorded after its preludes': the last row of its defn table
    (let defn0 (if (nothing? header) (nothing) (kernel_ast pid (list "defn" (sub (nth header 2) 1)))))
    (let defnName (if (nothing? defn0) "" (kernel_ast pid (list "src" (nth defn0 0) (nth defn0 1)))))
    (let node0 (if (gt pid 0) (kernel_ast pid 0) (nothing)))
    (let mine (kernel_ast (host_pid) -1))
    (let myFirst (kernel_ast (host_pid) (list "src" 0 1)))
    ; mlx as words; the observer reads words
    (let live (mlx_live))
    (let fixture (list 1 1 1 1 0 32 0 23 0 0 4 0))
    (let rows (fgo-mlx-rows fixture "mlx_linked=true\nmlx_active_memory=4096\nmlx_peak_memory=12\nmlx_cache_memory=8\nmlx_memory_limit=130567005798\n"))
    (let gap (fgel-carrier-gap))
    (let names (fgl-wait-frame-names (list "a" "b")))
    (let released (ggf-release handle))
    (let ended (if (gt child 0) (host_kill child) 0))
    (let waited (if (gt child 0) (host_wait child) 0))
    (print (list "form-glass-wait-band" "rest-us-min" (fgwb-min rests 99999999) "rest-us-max" (fgwb-max rests 0) "landed" landed "of" 20
        "woke" (nth woke 1) "elapsed-ms" elapsed "stale-woke" (nth stale 1) "stale-ms" (sub t3 t2) "quiet" (nth quiet 1)
        "child" pid "nodes" (if (nothing? header) -1 (nth header 0)) "defn0" defn0 "name" defnName "mlx" live))
    (add (fgwb-bit (and (ge landed 18) (eq plain 10)) 1)
    (add (fgwb-bit (and (eq (len shape) 4) (and (eq (nth shape 1) -1) (and (ge (nth shape 2) 5000) (eq (len (nth shape 3)) 0)))) 2)
    (add (fgwb-bit (and (gt pid 0) (and (eq (nth woke 1) 0) (and (lt elapsed 250) (and (gt elapsed 100) (eq (nth second 1) 2))))) 4)
    (add (fgwb-bit (and (eq (nth stale 1) 0) (and (lt (sub t3 t2) 10) (and (eq (nth quiet 1) -1) (eq (nth quiet 0) 30)))) 8)
    (add (fgwb-bit (and (str_eq (nth gap 1) "available") (and (ge (str_find (fgl-carrier-seam) ":host_sleep_ms" 0) 0) (and (eq (len names) 3) (str_eq (head names) (fgl-wait-inbox-name))))) 16)
    (add (fgwb-bit (and (or (nothing? live) (eq (len live) 12)) (and (and (eq (len rows) 9) (and (eq (fgo-int-value (nth rows 5)) 4096) (eq (fgo-int-value (nth rows 8)) 130567005798))) (and (str_eq (fgo-mlx-version-text fixture) "0.32.0") (and (str_eq (fgo-mlx-device-text fixture) "gpu") (str_eq (fgo-mlx-error-text fixture) "none"))))) 32)
    (add (fgwb-bit (and (eq (len mine) 10) (and (gt (nth mine 0) 0) (and (eq (nth mine 4) 1) (and (str_eq myFirst ";") (eq (len (kernel_ast (host_pid) 0)) 4))))) 64)
        (fgwb-bit (and (not (nothing? header)) (and (gt (nth header 0) 0) (and (eq (len defn0) 4) (and (str_eq defnName "wc-tick") (and (ge (nth defn0 3) 0) (eq (len node0) 4)))))) 128)))))))))
