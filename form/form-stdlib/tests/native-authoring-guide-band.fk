; Pure source fixtures: no processes or living state are written by this band.
; native-guide: reference
; preludes: form-stdlib/bml/native-authoring-guide.bml
; witnessed: 2026-09-15 -> 1048575
(do
 (defn nrgb-k (ok bit) (if ok bit 0))
 (defn nrgb-kind (path text) (nth (head (nrg-source path text)) 2))
 (sum (list
  (nrgb-k (str_eq (nrg-token "/venv/bin/python3.14 -m train") "python-interpreter") 1)
  (nrgb-k (str_eq (nrg-token "env X=1 python -c 'print(1)'") "python-interpreter") 2)
  (nrgb-k (and (str_eq (nrg-token "python_adapter python-bmf python.py not-python3 vendor.python3") "")
    (and (str_eq (nrg-token "python3<input") "python-interpreter")
      (and (str_eq (nrg-token "python3>output") "python-interpreter")
        (and (str_eq (nrg-token "python3|next") "python-interpreter")
          (str_eq (nrg-token "python3&&next") "python-interpreter"))))) 4)
  (nrgb-k (str_eq (nth (head (nrg-source "tools/x.py" "print(1)")) 2) "python-implementation") 8)
  (nrgb-k (str_eq (nth (head (nrg-source "presence/fixtures/x.py" "print(1)")) 2) "foreign-grammar-input") 16)
  (nrgb-k (eq (len (nrg-source "receipts/old.md" "python3 old.py")) 0) 32)
  (nrgb-k (and (eq (nth (head (nrg-source "tools/run.sh" "# comment\npython3 old.py\n")) 1) 2) (str_eq (nth (head (nrg-source "tools/run.sh" "# python3 old.py\n")) 2) "comment-reference")) 64)
  (nrgb-k (str_eq (nth (nrg-find "python3 form/scripts/gen_flt_ops_from_manifest.py --write" (nrg-catalog)) 1) "observe/native-op-emitter-run.fk") 128)
  (nrgb-k (str_eq (nrg-token "C:\\venv\\python.exe -m train") "python-interpreter") 256)
  (nrgb-k (str_eq (nth (head (nrg-source "tools/runner" "#!/usr/bin/env python3\n")) 2) "execution-candidate") 512)
  ; a file that declares itself a reference reads its specimens as the guide's own
  (nrgb-k (str_eq (nrgb-kind "any/specimen-band.fk" "; native-guide: reference\n(fh \"guide|python3 x.py\")\n") "guide-reference") 1024)
  (nrgb-k (str_eq (nth (nrg-find "python3 form/scripts/fourth-arm-gap-analysis.py" (nrg-catalog)) 1) "observe/fourth-arm-gap-analysis-run.fk") 2048)
  (nrgb-k (and (str_eq (nrg-token "import mlx_whisper") "mlx-python-entry") (str_eq (nth (nrg-find "mlx_whisper" (nrg-catalog)) 1) "observe/native-whisper-run.fk")) 4096)
  (nrgb-k (and (str_eq (nrg-token "from mlx import core") "mlx-python-entry") (and (str_eq (nrg-token "import mlx.core") "mlx-python-entry") (str_eq (nrg-token "models--mlx-community--checkpoint") ""))) 8192)
  ; in a program source the language's own name, an identifier and prose are names
  (nrgb-k (and (str_eq (nrgb-kind "c/x.fk" "(gcf-run \"python\" \"py\" \"\"") "name-reference")
    (and (str_eq (nrgb-kind "c/x.fk" "(let python (f 2 \"python\"))") "name-reference")
      (and (str_eq (nrgb-kind "r/x.c" "printf(\"no python, no nvcc\\n\");") "name-reference")
        (and (str_eq (nrgb-kind "l/x.bml" "rl-row(\"R1\", \"doors; python was never on the path\")") "name-reference")
          (and (str_eq (nrgb-kind "l/x.bml" "rl-row(\"R61\", \"host-exec in cells; binaries (say, python3) stay rows\")") "name-reference")
            (str_eq (nrgb-kind "d/x.json" "{\"name\": \"python\", \"value\": 1}") "name-reference")))))) 16384)
  ; and a word standing as a command stays a launch, however it is spelled
  (nrgb-k (and (str_eq (nrgb-kind "c/x.fk" "(host-exec (str_concat \"python3 \" p) \"\")") "execution-candidate")
    (and (str_eq (nrgb-kind "c/x.fk" "\"python3 %f\")") "execution-candidate")
      (and (str_eq (nrgb-kind "v/x.bml" "field P = \"/v/lib/bin/python\";") "execution-candidate")
        (and (str_eq (nrgb-kind "k/x.go" "\"python3 scripts/tool.py register %s \"+") "execution-candidate")
          (and (str_eq (nrgb-kind "k/x.rs" "python3 scripts/tool.py register {} \\") "execution-candidate")
            (and (str_eq (nrgb-kind "k/x.ts" "`python3 scripts/tool.py register ${name}` +") "execution-candidate")
              (and (str_eq (nrgb-kind "c/x.fk" "(host_spawn_at (list \"python\" \"x.py\") io)") "execution-candidate")
                (and (str_eq (nrgb-kind "c/x.fk" "(list \"python\" \"-c\" \"print(1)\")") "execution-candidate")
                  (str_eq (nrgb-kind "c/x.fk" "(list \"python3\" \"x\")") "execution-candidate"))))))))) 32768)
  ; a declared reference that hands the word to a door is a launch; shell stays a command language
  (nrgb-k (and (str_eq (nrgb-kind "any/band.fk" "; native-guide: reference\n(host-exec \"python3 x.py\" \"\")\n") "execution-candidate")
    (str_eq (nrgb-kind "tools/x.sh" "t0=$(python3 -c 'import time')") "execution-candidate")) 65536)
  ; a NUL byte marks a compiled image; the same text without one is a command file
  (nrgb-k (and (str_eq (nrgb-kind "bin/tool" (str_concat "ab" (str_concat (byte_to_str 0) "\n\"python3 x.py\"\n"))) "compiled-artifact")
    (str_eq (nrgb-kind "bin/tool" "\"python3 x.py\"\n") "execution-candidate")) 131072)
  ; an MLX package directory inside a path is a file being read; an entry runs it
  (nrgb-k (and (str_eq (nrg-token "nm_sha256_file \"$HOME/v/lib/python3.14/site-packages/mlx_lm/lora.py\"") "")
    (and (str_eq (nrg-token "mlx_lm.lora --train --data d") "mlx-python-entry")
      (str_eq (nrg-token "\"$VENV/bin/python\" -m mlx_lm.lora") "python-interpreter"))) 262144)
  ; a console script inside a virtual environment is a Python launch by another name
  (nrgb-k (and (str_eq (nrg-token "field VSPiper = \"/u/.mlx-venv/bin/piper\";") "python-environment")
    (str_eq (nrgb-kind "v/x.bml" "field VSPiper = \"/u/.mlx-venv/bin/piper\";") "execution-candidate")) 524288))))
