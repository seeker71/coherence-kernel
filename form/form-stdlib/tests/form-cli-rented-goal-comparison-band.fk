; form-cli-rented-goal-comparison-band.fk — historical normal-session
; provenance and exact local direct evidence meet without being mistaken for a
; provider-call receipt. Expected: 8191
; preludes: form-stdlib/bml/form-cli-rented-goal-comparison.bml

(do
    (defn fcgrcb-bit (ok bit) (if ok bit 0))
    (defn fcgrcb-history ()
        (str_concat "The goal, sharpened by Urs: the ORIGINAL prompt\n"
            (str_concat "93,628 output tokens across 118 assistant messages.\n"
                "; witnessed: 2026-08-30 -> denominator 93628\n")))
    (defn fcgrcb-task (body)
        (str_concat "<|form:agent-task|>\nturn=9601\nkind=direct-answer\n"
            (str_concat body "\n<|/form:agent-task|>\n")))
    (defn fcgrcb-reply (callback carrier)
        (str_concat "turn=9601\nsignal=candidate\nroute=direct-answer\n"
            (str_concat "callback-calls=" (str_concat callback
                (str_concat "\nlookup-count=0\ninjected-bytes=0\ncarrier="
                    (str_concat carrier "\nlifecycle=generate,release\n<|/form:peer-contribution|>\n"))))))
    (let history (fcgrcb-history))
    (let task (fcgrcb-task (str_concat "task=" (fcpdag-embodied-goal-prompt))))
    (let reply (fcgrcb-reply "0" "form-native-metal-jit"))
    (let value (fcgrc-compare history task reply 9601))
    (let bad-history (fcgrc-compare "93,628 output tokens across 118 assistant messages." task reply 9601))
    (let bad-task (fcgrc-compare history (fcgrcb-task "task=ordinary question") reply 9601))
    (let bad-reply (fcgrc-compare history task (fcgrcb-reply "1" "form-native-metal-jit") 9601))
    (let wrong-turn (fcgrc-compare history task reply 9602))
    (sum (list
        (fcgrcb-bit (fcgrc-value? value) 1)
        (fcgrcb-bit (str_eq (fcgrc-source-of value) "historical-rented-session-vs-local-direct") 2)
        (fcgrcb-bit (eq (fcgrc-normal-remote-tokens value) 93628) 4)
        (fcgrcb-bit (eq (fcgrc-form-cli-remote-tokens value) 0) 8)
        (fcgrcb-bit (eq (fcgrc-ratio-bps value) 0) 16)
        (fcgrcb-bit (eq (fcgrc-under-ten-percent? value) 1) 32)
        (fcgrcb-bit (eq (fcgrc-task-turn value) 9601) 64)
        (fcgrcb-bit (fcgrc-history? history) 128)
        (fcgrcb-bit (and (fcgrc-choice? bad-history) (nothing? (fcgrc-normal-remote-tokens bad-history))) 256)
        (fcgrcb-bit (and (fcgrc-choice? bad-task) (nothing? (fcgrc-form-cli-remote-tokens bad-task))) 512)
        (fcgrcb-bit (and (fcgrc-choice? bad-reply) (nothing? (fcgrc-ratio-bps bad-reply))) 1024)
        (fcgrcb-bit (and (fcgrc-choice? wrong-turn) (nothing? (fcgrc-under-ten-percent? wrong-turn))) 2048)
        (fcgrcb-bit (and (eq (fcgrc-ten-percent-bps) 1000) (gt (fcgrc-normal-tokens) 0)) 4096))))
