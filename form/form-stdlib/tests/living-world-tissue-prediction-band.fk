; living-world-tissue-prediction-band.fk -- every Recipe may risk a future.
; Verdict 32767 proves fifteen native prediction, option, and time claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk form-stdlib/living-world-contextual-species.fk form-stdlib/living-world-tissue-prediction.fk form-stdlib/tests/living-world-intention-graph-witness.fk form-stdlib/tests/living-world-transformation-nursery-witness.fk form-stdlib/tests/living-world-behavioral-species-witness.fk form-stdlib/tests/living-world-contextual-species-witness.fk form-stdlib/tests/living-world-tissue-prediction-witness.fk

(defn lwtpb-all-in? (items field)
    (if (eq (len items) 0) 1
        (if (eq (lwo-field-has? field (head items)) 1)
            (lwtpb-all-in? (tail items) field) 0)))

(do
    (let base (lwtpw-build-base))
    (let tissue (lwtpw-base-tissue base))
    (let initial-a (lwtpw-initial-a base))
    (let initial-b (lwtpw-initial-b base))
    (let world-a (lwt-round-world (lwtpw-prediction-round initial-a)))
    (let world-b (lwt-round-world (lwtpw-prediction-round initial-b)))
    (let candidate-a (lwtpw-prediction-candidate initial-a))
    (let candidate-b (lwtpw-prediction-candidate initial-b))
    (let prediction-a (lwtpw-prediction-shape initial-a))
    (let prediction-b (lwtpw-prediction-shape initial-b))
    (let target-a (lwtpw-prediction-target initial-a))
    (let target-b (lwtpw-prediction-target initial-b))
    (let derivation-a (lwtp-prediction-derivation prediction-a))
    (let expired (lwtp-target-time-for target-a (intern_trivial_int 10)))
    (let expired-prediction
        (lwtp-prediction-for world-a tissue target-a 2
            (intern_trivial_int 10)))
    (let expired-proposal
        (lwtp-prediction-proposal world-a tissue target-a 2
            (intern_trivial_int 10)))

    (let c1
        (if (and (eq (lwcs-tissue-integrated-current?
                         (lwtpw-base-world base) tissue) 1)
                 (eq (lwo-field-size
                         (lwcs-component-receipts
                           (lwcs-tissue-component
                             (lwo-emergent-shape tissue)))) 3)) 1 0))
    (let c2
        (if (and (eq (lwtp-target-current? world-a target-a) 1)
                 (and (eq (lwtp-target-current? world-b target-b) 1)
                      (not (node_eq target-a target-b)))) 2 0))
    (let c3
        (if (and (node_eq (lwtp-target-context target-a)
                          (lwcsw-context-a))
                 (and (eq (lwo-field-size
                              (lwtp-target-alternatives target-a)) 2)
                      (and (eq (lwlc-unknown?
                                  (lwtp-target-unknown target-a)) 1)
                           (and (eq (lwlc-choice?
                                       (lwtp-target-choice target-a)) 1)
                                (eq (oac-timeout?
                                      (lwtp-target-timeout target-a)) 1)))))
            4 0))
    (let c4
        (if (and (node_eq (lwtp-target-context target-b) (lwo-none))
                 (and (eq (lwo-field-size
                              (lwtp-target-alternatives target-b)) 0)
                      (and (node_eq (lwtp-target-unknown target-b) (lwo-none))
                           (and (node_eq (lwtp-target-choice target-b)
                                         (lwo-none))
                                (node_eq (lwtp-target-timeout target-b)
                                         (lwo-none)))))) 8 0))
    (let c5
        (if (eq (lwo-field-size
                    (lwtp-prediction-recipes prediction-a)) 3) 16 0))
    (let c6
        (if (and (eq (lwo-field-size
                         (lwtp-prediction-executions prediction-a)) 3)
                 (and (eq (lwo-field-size
                              (lwtp-prediction-recipe-outputs prediction-a)) 1)
                      (node_eq
                        (head (lwo-field-items
                          (lwtp-prediction-recipe-outputs prediction-a)))
                        (intern_trivial_int 4)))) 32 0))
    (let c7
        (if (and (eq (lwtpb-all-in?
                         (lwo-field-items
                           (lwtp-prediction-recipes prediction-a))
                         (lwtp-prediction-alternatives prediction-a)) 1)
                 (eq (lwo-field-has?
                         (lwtp-prediction-alternatives prediction-a)
                         (lwtpw-option-a)) 1)) 64 0))
    (let c8
        (if (and (eq (lwtp-consensus?
                         (lwtp-prediction-status prediction-a)) 1)
                 (node_eq (lwtp-prediction-predicted prediction-a)
                          (intern_trivial_int 4))) 128 0))
    (let c9
        (if (and (eq (lwo-field-size
                         (lwtp-prediction-experiences prediction-a)) 0)
                 (eq (lwo-field-size
                         (lwtp-prediction-combined-outputs prediction-a)) 1))
            256 0))
    (let c10
        (if (and (eq (lwo-field-size
                         (lwtp-derivation-receipts derivation-a)) 3)
                 (eq (lwtp-executions-current? world-a
                         (lwo-field-items
                           (lwtp-prediction-executions prediction-a))) 1))
            512 0))
    (let c11
        (if (and (eq (oac-time-pending?
                         (lwtp-prediction-time prediction-a)) 1)
                 (node_eq
                    (oac-time-pending-observed
                      (lwtp-prediction-time prediction-a))
                    (intern_trivial_int 5))) 1024 0))
    (let c12
        (if (and (eq (oac-time-outcome? expired) 1)
                 (and (eq (oac-alternative-ack?
                              (oac-time-outcome-ack expired)) 1)
                      (not (node_eq
                              (oac-time-outcome-ack expired)
                              (oac-nothing))))) 2048 0))
    (let c13
        (if (and (eq (lwtp-open?
                         (lwtp-prediction-status expired-prediction)) 1)
                 (node_eq expired-proposal (lwo-none))) 4096 0))
    (let c14
        (if (and (node_eq (lwtp-prediction-time prediction-b) (lwo-none))
                 (and (eq (lwtp-consensus?
                              (lwtp-prediction-status prediction-b)) 1)
                      (node_eq (lwtp-prediction-predicted prediction-b)
                               (intern_trivial_int 4)))) 8192 0))
    (let c15
        (if (and (eq (lwtp-prediction-integrated-current?
                         world-a candidate-a) 1)
                 (and (eq (lwtp-prediction-integrated-current?
                              world-b candidate-b) 1)
                      (node_eq target-a (lwtpw-target-a)))) 16384 0))
    (lwtnw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
