// bml-recover-surface-fixture.bml
//
// The recover point and absence, written in BML's own words: `try e else h`,
// `choose { e1; e2; ... }` and `x ?? y`. Read by tests/bml-recover-surface-band.fk.
// Running this unit alone answers rs-len of nothing: 7.

section [form.bml] {
    def rs-len(x) = try len(x) else 7;
    def rs-first(x) = choose { len(x); str_len(x); 99 };
    def rs-or(x) = x ?? 5;
    def rs-nested(x) = try (try len(x) else len(nothing)) else 11;
    def rs-lazy() = try 3 else len(nothing);
    def rs-none() = choose { len(nothing); nothing };
    def rs-block(x) {
        let n = try len(x) else 0;
        n + 1;
    }
    rs-len(nothing);
}
