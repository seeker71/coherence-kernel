// Source coverage and lossless rewrapping, with no provider or state writes.
// preludes: form-stdlib/bml/form-cli-comparison-review.bml
section [form.bml] {
 let packet = fcr-packet(fcr-original-review());
 let original = fcr-body(packet); let revised = fcr-grounded(original);
 let manifest = fcr-manifest(revised,fcr-goal(packet));
 let request = json-object-get(head(node_children(json-object-get(manifest,"cases"))),"request");
 let doc = head(node_children(json-object-get(request,"documents")));
 fcr-need(node_eq(parse-json("roundtrip",fcap-string(doc,"text")),revised),"source rewrapping changed its meaning");
 fcr-need(node_eq(json-object-get(original,"candidate_answer"),json-object-get(revised,"candidate_answer")),"review silently rewrote its candidate");
 fcr-need(node_eq(json-object-get(original,"original_enquiry"),json-object-get(revised,"original_enquiry")),"review changed the question");
 let before = json-object-get(original,"evidence"); let after = json-object-get(revised,"evidence");
 fcr-need(node_eq(json-object-get(before,"route_usage"),json-object-get(after,"route_usage")),"source repair changed measured route usage");
 fcr-need(node_eq(json-object-get(before,"output_artifacts"),json-object-get(after,"output_artifacts")),"source repair changed output measurements");
 let excerpt = fcap-string(json-object-get(after,"historical_author_observations"),"text");
 fcr-need(ge(str_find(excerpt,"The repair is named, not made",0),0),"the original seam's unresolved state is missing");
 fcr-need(ge(str_find(excerpt,fcap-string(json-object-get(before,"historical_author_observations"),"text"),0),0),"repair lost the earlier observation excerpt");
 let history = json-object-get(after,"candidate_historical_grounding");
 let historical = json-emit(history);
 fcr-need(eq(len(node_children(json-object-get(history,"source_sections"))),4),"historical grounding sections missing");
 fcr-need(and(ge(str_find(historical,"13,222",0),0),and(ge(str_find(historical,"local-oracle",0),0),ge(str_find(historical,"35183",0),0))),"earlier claim context was omitted");
 fcr-need(and(frsy-valid(manifest),frsy-sources(node_children(json-object-get(manifest,"cases")))),"restored review cannot enter synthesis");
 fcr-need(eq(head(frr-report(request,"{\"findings\":[],\"answer\":\"\"}")),1),"report schema witness refused");
 let fresh = fcr-fresh-domain(revised); let freshEvidence = json-object-get(fresh,"evidence");
 fcr-need(not(json-object-has?(fresh,"candidate_answer")),"fresh composition still carries the flawed draft");
 fcr-need(not(json-object-has?(freshEvidence,"candidate_historical_grounding")),"fresh composition carries the draft's obsolete grounding");
 fcr-need(node_eq(json-object-get(fresh,"original_enquiry"),json-object-get(revised,"original_enquiry")),"fresh composition changed the enquiry");
 fcr-need(and(node_eq(json-object-get(freshEvidence,"route_usage"),json-object-get(after,"route_usage")),node_eq(json-object-get(freshEvidence,"output_artifacts"),json-object-get(after,"output_artifacts"))),"fresh composition changed measurements");
 fcr-need(node_eq(json-object-get(freshEvidence,"historical_author_observations"),json-object-get(after,"historical_author_observations")),"fresh composition dropped original source context");
 fcr-need(node_eq(fcr-body(fcr-fresh-packet(revised)),fresh),"fresh source did not survive packet encoding");
 print_str("review retains enquiry, candidate, measurements, original unresolved seam and historical grounding; answer quality remains unobserved");
 1;
}
