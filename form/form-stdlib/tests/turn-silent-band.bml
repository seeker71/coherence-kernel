; turn-silent-band.bml — a turn that printed nothing is named in the walk's log, never silent (host-walk-turn.bml, hw-turn-silent).
;
; A turn door that failed is never silent: a turn that printed no row is named by its last line, and a turn that
; printed nothing at all is named as that, so the walk's log carries a line for every turn it began.
;
; Expected: 7
; Verdict 7 when every claim lands:
;   1   a turn that printed nothing reads "[native-turn:silent] the turn printed nothing", through hw-turn-lines as well
;   2   a turn that printed no row keeps its last line: "[native-turn:silent] the turn printed no row; its last line: x"
;   4   neither reads as a turn that turned
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/host-walk.bml
section [form.bml] {
 class TurnSilentBand {
  def tsb-said() = "[native-turn:silent] the turn printed nothing";
  def tsb-c-nothing(ctx) = (String) hw-turn-silent("") == tsb-said() && (String) hw-turn-lines(nothing()) == tsb-said();
  def tsb-c-last(ctx) = (String) hw-turn-silent("x") == "[native-turn:silent] the turn printed no row; its last line: x";
  def tsb-c-unturned(ctx) = !hw-turned?(hw-turn-lines(nothing())) && !hw-turned?(hw-turn-silent("x"));
 }
 live-claims("turn-silent-band", 0, [["nothing", 1, 1, tsb-c-nothing], ["last", 2, 1, tsb-c-last], ["unturned", 4, 1, tsb-c-unturned]]);
}
