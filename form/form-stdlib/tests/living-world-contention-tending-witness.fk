; living-world-contention-tending-witness.fk -- holders revise a local stance.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-enquiry.fk form-stdlib/living-world-enquiry-answer.fk form-stdlib/living-world-contention-tending.fk form-stdlib/living-world-contextual-answer.fk form-stdlib/tests/living-world-contention-witness.fk

(defn lwcttw-stance-ground ()
    (intern_trivial_string "lwcttw-consented-local-stance"))
(defn lwcttw-release-reason ()
    (intern_trivial_string "lwcttw-stance-revised"))

(defn lwcttw-question-proposal (world)
    (lwct-contention-proposal (lwen-question-proposals world)))

(defn lwcttw-question-round ()
    (do
        (let world (lwct-mapping-world))
        (let proposal (lwcttw-question-proposal world))
        (let round
            (lwt-round world
                (lwo-field-add (lwo-empty-field) proposal)
                (lwo-empty-field) (lwo-none)))
        (lwen-integrate-question
            (lwct-five-yes-round round proposal)
            proposal (lwct-action))))

(defn lwcttw-silent-round ()
    (do
        (let question-round (lwcttw-question-round))
        (let world (lwt-round-world question-round))
        (let question
            (lwt-proposal-candidate
                (lwcttw-question-proposal (lwct-mapping-world))))
        (let proposal (lwen-answer-proposal world question))
        (let round
            (lwt-round world
                (lwo-field-add (lwo-empty-field) proposal)
                (lwo-empty-field) question-round))
        (lwen-integrate-answer
            (lwct-five-yes-round round proposal)
            proposal (lwct-action))))

(defn lwcttw-route-with-output-items (items output)
    (if (eq (len items) 0) (lwo-none)
        (if (node_eq (lwen-route-output (head items)) output)
            (head items)
            (lwcttw-route-with-output-items (tail items) output))))

(defn lwcttw-identity-route (question-candidate)
    (lwcttw-route-with-output-items
        (lwo-field-items
            (lwen-question-routes
                (lwo-emergent-shape question-candidate)))
        (lwct-identity-output)))
(defn lwcttw-swap-route (question-candidate)
    (lwcttw-route-with-output-items
        (lwo-field-items
            (lwen-question-routes
                (lwo-emergent-shape question-candidate)))
        (lwct-swap-output)))

(defn lwcttw-one-stance (question route)
    (lwctd-stance question route (oac-one route)
                  (lwcttw-stance-ground)))
(defn lwcttw-nothing-stance (question route)
    (lwctd-stance question route (oac-nothing)
                  (lwcttw-stance-ground)))

(defn lwcttw-stance-entry (source provenance stance)
    (lwct-entry source stance provenance))
(defn lwcttw-release-entry (source provenance stance)
    (lwct-entry source
        (lwo-revocation stance source
            (lwcttw-release-reason) provenance) provenance))

(defn lwcttw-split-world (world question)
    (do
        (let identity (lwcttw-identity-route question))
        (let swap (lwcttw-swap-route question))
        (lwt-receive-stream world
            (list
                (lwcttw-stance-entry
                    (lwct-source-a) (lwct-provenance-a)
                    (lwcttw-one-stance question identity))
                (lwcttw-stance-entry
                    (lwct-source-b) (lwct-provenance-b)
                    (lwcttw-one-stance question identity))
                (lwcttw-stance-entry
                    (lwct-source-c) (lwct-provenance-c)
                    (lwcttw-one-stance question swap))
                (lwcttw-stance-entry
                    (lwct-source-d) (lwct-provenance-d)
                    (lwcttw-one-stance question swap))
                (lwcttw-stance-entry
                    (lwct-source-e) (lwct-provenance-e)
                    (lwcttw-nothing-stance question identity))))))

(defn lwcttw-aligned-world (split-world question)
    (do
        (let identity (lwcttw-identity-route question))
        (let swap (lwcttw-swap-route question))
        (let swap-stance (lwcttw-one-stance question swap))
        (let silence-stance
            (lwcttw-nothing-stance question identity))
        (let aligned-stance
            (lwcttw-one-stance question identity))
        (lwt-receive-stream split-world
            (list
                (lwcttw-release-entry
                    (lwct-source-c) (lwct-provenance-c) swap-stance)
                (lwcttw-release-entry
                    (lwct-source-d) (lwct-provenance-d) swap-stance)
                (lwcttw-release-entry
                    (lwct-source-e) (lwct-provenance-e) silence-stance)
                (lwcttw-stance-entry
                    (lwct-source-c) (lwct-provenance-c) aligned-stance)
                (lwcttw-stance-entry
                    (lwct-source-d) (lwct-provenance-d) aligned-stance)
                (lwcttw-stance-entry
                    (lwct-source-e) (lwct-provenance-e) aligned-stance)))))

(defn lwcttw-release-aligned-a (world question)
    (do
        (let stance
            (lwcttw-one-stance question
                (lwcttw-identity-route question)))
        (lwt-receive-stream world
            (list
                (lwcttw-release-entry
                    (lwct-source-a) (lwct-provenance-a) stance)))))

(defn lwcttw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwcttw-sum (tail items)))))
