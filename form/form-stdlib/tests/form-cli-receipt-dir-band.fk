; The receipt store has three levels and fkwu's current fs_mkdir carrier creates
; one level at a time. Prove the Form-owned path constructor using an isolated
; runtime-local tree, then remove only that test tree.
;
; preludes: form-stdlib/form-cli-dsv4-local.fk

(do
    (let root (str_concat (temp_dir) "/form-cli-receipt-dir-band"))
    (fs_rmdir root)
    (let receipts (fdl-ensure-receipt-dir root))
    (let path (str_concat receipts "/observed.txt"))
    (let wrote (write_file path "observed"))
    (let verdict
        (if (and
                (eq (fs_is_dir receipts) 1)
                (and
                    (gt wrote 0)
                    (str_eq (read_file path) "observed")))
            31
            0))
    (fs_rmdir root)
    verdict)
