; form-recipe-exec-token-live-band.fk — pure shape of the streamed live seam.
;
; Verdict 131071 (17 bits):
;   1       one-byte cursor consumes every frame byte with pretokenized=0
;   2       streamed request resolves the exact recipe/input/carrier
;   4       incomplete, trailing and over-budget streams remain nothing
;   8       recipe children supply multiplier 3, addend 7, and answer 22
;   16      direct MSL names those values and the one registered kernel
;   32      identical generated source shares a code NodeID
;   64      signed i32 bytes round-trip negative, zero, one and 22
;   128     simulated unavailable/failure/timeout/value remain distinct
;   256     live value 0 and 1 both remain present and identity-distinct
;   512     pure fallback lifecycle remains attached to the live result
;   1024    execution and live observation have separate NodeIDs
;   2048    live flags distinguish source, native code, execution and model
;   4096    stage telemetry and physical buffer release remain explicit
;   8192    rendering is bounded and contains only scalar/NodeID telemetry
;   16384   rendering contains neither request surface nor emitted MSL
;   32768   the pure band does not touch the Metal door
;   65536   compact cursor observation identity retains physical live flags
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/format-arith.fk form-stdlib/metal-door.fk
; preludes: form-stdlib/form-recipe-exec-token.fk
; preludes: form-stdlib/form-recipe-exec-token-live.fk

(do
    (defn frexlb-bit (condition bit) (if condition bit 0))
    (defn frexlb-repeat (chunk n out)
        (if (eq n 0) out
            (frexlb-repeat chunk (sub n 1) (str_concat out chunk))))
    (defn frexlb-sim (request offer code source native executed released
                      wrote enqueued synced read-bytes)
        (frexl-result-from-offer request offer code
            (str_len (frex-surface (frex-recipe) 5 "metal"))
            source native executed native released wrote enqueued synced
            read-bytes))

    (defn form-recipe-exec-token-live-band ()
        (do
            (let recipe (frex-recipe))
            (let surface (frex-surface recipe 5 "metal"))
            (let streamed (frexl-stream-parse surface))
            (let request (frexl-stream-request streamed))
            (let cursor (frexl-stream-cursor streamed))
            (let incomplete (frexl-stream-parse
                (substring surface 0 (sub (str_len surface) 1))))
            (let trailing (frexl-stream-parse (str_concat surface "x")))
            (let oversized (frexl-stream-parse (str_concat (frex-open)
                (frexlb-repeat "0123456789" 20 ""))))
            (let source (frexl-msl recipe))
            (let code (frexl-code-node recipe))
            (let code2 (frexl-code-node recipe))

            (let nothing-result (frexlb-sim request
                (frex-offer "metal" "nothing" 0 "metal-unavailable")
                (nothing) 0 0 0 0 0 0 0 0))
            (let failure-result (frexlb-sim request
                (frex-offer "metal" "failure" 0 "compile-failure")
                code 1 0 0 1 4 0 0 0))
            (let timeout-result (frexlb-sim request
                (frex-offer "metal" "timeout" 0 "time-budget")
                code 1 1 0 1 4 1 0 0))
            (let zero-result (frexlb-sim request
                (frex-offer "metal" "value" 0 "metal-value")
                code 1 1 1 1 4 1 1 4))
            (let one-result (frexlb-sim request
                (frex-offer "metal" "value" 1 "metal-value")
                code 1 1 1 1 4 1 1 4))
            (let compact-live (frexl-result-as-frex request zero-result))
            (let compact-pure (frexl-result-pure zero-result))
            (let rendered (frexl-live-render zero-result))

            (sum (list
                (frexlb-bit (and (eq (frexl-cursor-bytes cursor)
                                     (str_len surface))
                    (and (str_eq (frexl-cursor-buffer cursor) surface)
                    (and (eq (frexl-cursor-complete? cursor) 1)
                         (eq (frexl-stream-pretokenized? streamed) 0)))) 1)
                (frexlb-bit (and (eq (frex-request-ready? request) 1)
                    (and (node_eq (frex-request-recipe request) recipe)
                    (and (eq (frex-request-input request) 5)
                         (str_eq (frex-request-carrier request) "metal")))) 2)
                (frexlb-bit (and
                    (eq (frex-request-ready? (frexl-stream-request incomplete)) 0)
                    (and (eq (frex-request-ready?
                                (frexl-stream-request trailing)) 0)
                         (eq (frex-request-ready?
                                (frexl-stream-request oversized)) 0))) 4)
                (frexlb-bit (and (eq (frexl-recipe-mul recipe) 3)
                    (and (eq (frexl-recipe-add recipe) 7)
                         (eq (frexl-recipe-expected recipe 5) 22))) 8)
                (frexlb-bit (and (ge (str_find source
                                    "a[0] = a[0] * 3 + 7;" 0) 0)
                    (and (ge (str_find source (frexl-kernel-name) 0) 0)
                    (and (lt (str_find source "switch" 0) 0)
                         (lt (str_find source "#include <metal_stdlib>"
                                      (add (str_find source
                                          "#include <metal_stdlib>" 0) 1)) 0)))) 16)
                (frexlb-bit (and (node_eq code code2)
                                  (eq (frexl-code-valid? code recipe) 1)) 32)
                (frexlb-bit (and (eq (frexl-i32-at (frexl-i32-bytes -7) 0) -7)
                    (and (eq (frexl-i32-at (frexl-i32-bytes 0) 0) 0)
                    (and (eq (frexl-i32-at (frexl-i32-bytes 1) 0) 1)
                         (eq (frexl-i32-at (frexl-i32-bytes 22) 0) 22)))) 64)
                (frexlb-bit (and (str_eq (frexl-result-status nothing-result)
                                        "nothing")
                    (and (str_eq (frexl-result-status failure-result) "failure")
                    (and (str_eq (frexl-result-status timeout-result) "timeout")
                         (str_eq (frexl-result-status zero-result) "value")))) 128)
                (frexlb-bit (and (eq (frexl-result-value-present? zero-result) 1)
                    (and (eq (frexl-result-value zero-result) 0)
                    (and (eq (frexl-result-value-present? one-result) 1)
                    (and (eq (frexl-result-value one-result) 1)
                         (not (node_eq (frexl-result-observation zero-result)
                                       (frexl-result-observation one-result))))))) 256)
                (frexlb-bit (and
                    (eq (frex-trace-has? (frexl-result-lifecycle failure-result)
                                         "undo") 1)
                    (and (eq (frex-trace-has?
                                (frexl-result-lifecycle timeout-result) "cut") 1)
                    (and (eq (frex-trace-has?
                                (frexl-result-lifecycle zero-result)
                                "crystallize") 1)
                         (eq (frex-trace-has?
                                (frexl-result-lifecycle zero-result)
                                "release") 1)))) 512)
                (frexlb-bit (and
                    (not (node_eq (frexl-result-execution zero-result)
                                  (frexl-result-observation zero-result)))
                    (not (node_eq (frexl-result-observation zero-result)
                                  (frex-result-observation
                                      (frexl-result-pure zero-result))))) 1024)
                (frexlb-bit (and (eq (frexl-result-source-generated? zero-result) 1)
                    (and (eq (frexl-result-native-code-generated? zero-result) 1)
                    (and (eq (frexl-result-executed? zero-result) 1)
                    (and (eq (frexl-result-model-executed? zero-result) 0)
                    (and (eq (frexl-result-native-code-generated?
                                failure-result) 0)
                         (eq (frexl-result-executed? failure-result) 0)))))) 2048)
                (frexlb-bit (and (eq (frexl-result-pipeline-created?
                                        zero-result) 1)
                    (and (eq (frexl-result-buffer-released? zero-result) 1)
                    (and (eq (frexl-result-wrote-bytes zero-result) 4)
                    (and (eq (frexl-result-enqueued zero-result) 1)
                    (and (eq (frexl-result-synced zero-result) 1)
                         (eq (frexl-result-read-bytes zero-result) 4)))))) 4096)
                (frexlb-bit (and (gt (str_len rendered) 0)
                    (and (le (str_len rendered) (frex-max-render-bytes))
                    (and (ge (str_find rendered "request-node=@" 0) 0)
                    (and (ge (str_find rendered "code-node=@" 0) 0)
                    (and (ge (str_find rendered "execution-node=@" 0) 0)
                         (ge (str_find rendered "observation-node=@" 0) 0)))))) 8192)
                (frexlb-bit (and (lt (str_find rendered source 0) 0)
                    (and (lt (str_find rendered "#include" 0) 0)
                    (and (lt (str_find rendered "kernel void" 0) 0)
                    (and (lt (str_find rendered ";input=" 0) 0)
                         (lt (str_find rendered (frex-open) 0) 0))))) 16384)
                ; Reaching this bit means every value above was constructed
                ; without invoking frexl-execute-request or any metal_* effect.
                (frexlb-bit 1 32768)
                (frexlb-bit (and (eq (frex-result-executed? compact-live) 1)
                    (and (eq (frex-result-model-executed? compact-live) 0)
                    (and (eq (frex-result-native-code-generated? compact-live) 1)
                    (and (not (node_eq (frex-result-observation compact-live)
                                       (frex-result-observation compact-pure)))
                         (node_eq (frex-result-observation compact-live)
                            (frex-observation-token-with-flags
                                (frex-result-status compact-live)
                                (frex-result-reason compact-live)
                                request
                                (frex-result-carrier compact-live)
                                (frex-result-value compact-live)
                                (frex-result-value-present? compact-live)
                                (frex-result-trace compact-live) 1 0 1)))))) 65536)))))

    (form-recipe-exec-token-live-band))
