; qwen-lora-train-band.fk — pure algebraic witness for the local fitting rule.
;
; Verdict 63:
;   1 vectors preserve width
;   2 fitted scalar is nonzero
;   4 rank-one output lowers loss from the zero adapter
;   8 rank-one output reaches the one-example target
;  16 A persists as a Qwen-shaped safetensors tensor
;  32 B persists as a Qwen-shaped safetensors tensor
; preludes: form-stdlib/qwen-lora-train.fk

(do
    (defn qltb-path () (fs-path-join (fs-temp-dir) "qwen-lora-train-band.safetensors"))
    (let h (list 1.0 2.0 3.0 4.0))
    (let target (list 0.5 (sub 0.0 1.0) 2.0 3.0))
    (let fit (qlt-fit h target))
    (let a (nth fit 0))
    (let b (nth fit 1))
    (let s (nth fit 2))
    (let before (qlt-loss target (qlt-scale target 0.0) 0.0))
    (let after (qlt-loss target b s))
    (let path (qltb-path))
    (let wrote (qlh-write-vectors path (qlh-values "train band A" 0) (qlh-values "train band B" 1)))
    (sum (list
        (if (if (eq (len a) 4) (eq (len b) 4) 0) 1 0)
        (if (gt s 0.0) 2 0)
        (if (lt after before) 4 0)
        (if (lt after 0.0001) 8 0)
        (if (eq (str_len (qlh-tensor-bytes path (qlh-a-name))) (mul (qlh-width) 4)) 16 0)
        (if (eq (str_len (qlh-tensor-bytes path (qlh-b-name))) (mul (qlh-width) 4)) 32 0))))
