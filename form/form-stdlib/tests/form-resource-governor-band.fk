; form-resource-governor-band.fk — typed cooperative resource policy.
;
; Verdict 1048575: twenty independently named invariants.  The atomic slot
; transition is represented as the exact result shape in this pure band; the
; effectful host_dir_mkdir collision and exact-owner release are witnessed by
; observe/form-resource-governor-live-run.fk so this band stains no live slot.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/form-glass-observation-v2.bml form-stdlib/form-resource-governor.bml

(do
    (defn frgb-bit (held weight) (if (eq held 1) weight 0))
    (defn frgb-provenance-at (publisher pid started incarnation sequence observed source)
        (fgov2-provenance "physical-live" publisher
            (fgov2-measured (fgov2-process-lifetime pid started incarnation))
            (fgov2-measured sequence) (fgov2-measured observed) source))
    (defn frgb-provenance ()
        (frgb-provenance-at "band.metal" 4242 1700000000 "band-4242" 73 1700000250 "band.metal-status"))
    (defn frgb-submit-provenance ()
        (frgb-provenance-at "band.metal" 4242 1700000000 "band-4242" 74 1700000500 "band.metal-submit"))
    (defn frgb-complete-provenance ()
        (frgb-provenance-at "band.metal" 4242 1700000000 "band-4242" 75 1700000750 "band.metal-complete"))
    (defn frgb-m (value) (frg-measured value 0 (frgb-provenance)))
    (defn frgb-resource (name capacity foreground reserve)
        (frg-resource name (frgb-m capacity) (frgb-m foreground) (frgb-m reserve)))
    (defn frgb-sample (active foreground latency pressure thermal lowPower metalInFlight)
        (frg-sample (frgb-m active)
            (frgb-resource "cpu" 1000 100 100)
            (frgb-resource "gpu" 2000 200 200)
            (frgb-resource "memory" 10000 1000 1000)
            (frgb-m foreground) (frgb-m latency) (frgb-m pressure)
            (frgb-m thermal) (frgb-m lowPower) (frgb-m metalInFlight)))
    (defn frgb-state-at-target () (frg-state 720 1440 7200 8 20))
    (defn frgb-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))
    (defn frgb-missing-sample (signal)
        (frg-sample (frgb-m 1)
            (frg-resource "cpu" signal (frgb-m 0) (frgb-m 0))
            (frgb-resource "gpu" (frgb-m 100) (frgb-m 0) (frgb-m 0))
            (frgb-resource "memory" (frgb-m 100) (frgb-m 0) (frgb-m 0))
            (frgb-m 0) (frgb-m 0) (frgb-m 0) (frgb-m 0) (frgb-m 0) (frgb-m 0)))
    (defn frgb-revoked? (decision)
        (if (and (eq (frg-decision-cpu decision) 0)
            (and (eq (frg-decision-gpu decision) 0)
                 (eq (frg-decision-memory decision) 0))) 1 0))
    (defn frgb-missing-revokes? (policy signals)
        (if (eq (len signals) 0) 1
            (if (eq (frgb-revoked? (frg-tick policy (frgb-state-at-target) (frgb-missing-sample (head signals)))) 1)
                (frgb-missing-revokes? policy (tail signals)) 0)))
    (defn frgb-half-grants? (decision)
        (if (and (eq (frg-decision-cpu decision) 360)
            (and (eq (frg-decision-gpu decision) 720)
                 (eq (frg-decision-memory decision) 3600))) 1 0))
    (defn frgb-all-half? (policy samples)
        (if (eq (len samples) 0) 1
            (if (eq (frgb-half-grants? (frg-tick policy (frgb-state-at-target) (head samples))) 1)
                (frgb-all-half? policy (tail samples)) 0)))
    (defn frgb-all-stop? (policy samples)
        (if (eq (len samples) 0) 1
            (if (eq (frgb-revoked? (frg-tick policy (frgb-state-at-target) (head samples))) 1)
                (frgb-all-stop? policy (tail samples)) 0)))

    (let policy (frg-default-policy))
    (let quiet (frgb-sample 0 0 0 0 0 0 0))
    (let active (frgb-sample 1 0 0 0 0 0 0))
    (let quiet-decision (frg-tick policy (frgb-state-at-target) quiet))
    (let active-decision (frg-tick policy (frgb-state-at-target) active))
    (let c0 (frgb-bit (and (eq (frg-decision-frame active-decision) 250)
        (eq (frg-decision-frame quiet-decision) 500)) 1))
    (let c1 (frgb-bit (and (eq (frg-decision-cpu-target quiet-decision) 720)
        (and (eq (frg-decision-gpu-target quiet-decision) 1440)
             (eq (frg-decision-memory-target quiet-decision) 7200))) 2))

    ; Measured zero is data; absent/unavailable/stale/error never become zero.
    (let missing-kinds (list (frg-absent "no-sensor")
        (frg-unavailable "no-door" "carrier.memory-pressure")
        (frg-stale 0 1699990000 9 "old.publisher")
        (frg-error "sample" 7 1)
        (frg-measured 0 2 (frgb-provenance))
        (frg-measured 0 0 (frg-declared-provenance "declared-only"))))
    (let c2 (frgb-bit (and (eq (frg-signal-fresh? policy (frgb-m 0)) 1)
        (eq (frgb-missing-revokes? policy missing-kinds) 1)) 4))

    ; Critical pressure revokes grants and every new submit this frame.
    (let stop-samples (list (frgb-sample 0 0 0 0 0 1 0)
        (frgb-sample 0 0 500 0 0 0 0)
        (frgb-sample 0 0 0 2 0 0 0)
        (frgb-sample 0 0 0 0 2 0 0)))
    (let critical-from-open (frg-tick policy (frg-decision-next-state quiet-decision)
        (frgb-sample 0 0 0 2 0 0 0)))
    (let c3 (frgb-bit (and (eq (frgb-all-stop? policy stop-samples) 1)
        (and (eq (frg-decision-frame critical-from-open) 250)
             (and (eq (frg-decision-metal-submit? critical-from-open) 0)
                  (eq (len (frg-decision-permit critical-from-open)) 0)))) 8))
    (let half-samples (list (frgb-sample 0 1 0 0 0 0 0)
        (frgb-sample 0 0 250 0 0 0 0)
        (frgb-sample 0 0 0 1 0 0 0)
        (frgb-sample 0 0 0 0 1 0 0)))
    (let c4 (frgb-bit (frgb-all-half? policy half-samples) 16))

    ; Two clean frames precede bounded additive recovery.
    (let recovery1 (frg-tick policy (frg-initial-state) quiet))
    (let recovery2 (frg-tick policy (frg-decision-next-state recovery1) quiet))
    (let c5 (frgb-bit (and (eq (frg-decision-cpu recovery1) 0)
        (and (eq (frg-decision-cpu recovery2) 50)
             (and (eq (frg-decision-gpu recovery2) 100)
                  (eq (frg-decision-memory recovery2) 500)))) 32))
    (let clamped (frg-tick policy (frg-state 900 1900 9000 9 9) quiet))
    (let c6 (frgb-bit (and (eq (frg-decision-cpu clamped) 720)
        (and (eq (frg-decision-gpu clamped) 1440)
             (eq (frg-decision-memory clamped) 7200))) 64))

    ; Exact slot evidence reserves once; booleans and replay do not.
    (let open-permit (frg-decision-permit quiet-decision))
    (let owner-text (frg-metal-owner-text open-permit))
    (let reserved-permit (frg-metal-reserved-permit open-permit owner-text))
    (let slot-result (frg-metal-slot-result "acquired" "band-exact-shape" reserved-permit 1 (str_len owner-text)))
    (let fake-slot (frg-metal-slot-result "acquired" "boolean-forgery" reserved-permit 0 0))
    (let q-metal (frg-quantum "q.metal" (frgb-m 1) (frgb-m 1) (frgb-m 1) (frgb-m 1)))
    (let usage-zero (frg-usage (frgb-m 0) (frgb-m 0) (frgb-m 0)))
    (let open-state (frg-decision-next-state quiet-decision))
    (let consume (frg-consume-metal-permit policy open-state quiet-decision q-metal slot-result))
    (let fake-consume (frg-consume-metal-permit policy open-state quiet-decision q-metal fake-slot))
    (let replay (frg-consume-metal-permit policy (frg-permit-consume-next-state consume) quiet-decision q-metal slot-result))
    (let c7 (frgb-bit (and (str_eq (frg-permit-consume-status consume) "admitted")
        (and (str_eq (frg-permit-consume-reason fake-consume) "atomic-slot-not-acquired")
             (str_eq (frg-permit-consume-reason replay) "permit-replayed-or-already-reserved"))) 128))

    ; A measured in-flight buffer prevents a second open permit.
    (let one-flight (frg-tick policy (frgb-state-at-target) (frgb-sample 1 0 0 0 0 0 1)))
    (let c8 (frgb-bit (and (eq (frg-decision-metal-submit? one-flight) 0)
        (eq (len (frg-decision-permit one-flight)) 0)) 256))

    ; Critical preserves an already atomic reservation, with no new permission.
    (let reserved-state (frg-permit-consume-next-state consume))
    (let critical-reserved (frg-tick policy reserved-state (frgb-sample 0 0 0 2 0 0 0)))
    (let critical-state (frg-decision-next-state critical-reserved))
    (let c9 (frgb-bit (and (eq (frg-decision-metal-submit? critical-reserved) 0)
        (and (eq (frg-permit-reserved? (frg-decision-permit critical-reserved)) 1)
             (eq (frg-permit-same? (frg-decision-permit critical-reserved) reserved-permit) 1))) 512))

    ; A fully correlated receipt may bind that reservation after critical.
    (let submit-receipt (frg-submit-receipt "submitted" 808 "q.metal"
        (frg-permit-id reserved-permit) (frgb-submit-provenance)))
    (let submit-bind (frg-bind-metal-submit critical-reserved critical-state
        consume q-metal submit-receipt))
    (let c10 (frgb-bit (and (eq (frg-submit-bind-admitted? submit-bind) 1)
        (and (eq (frg-permit-command-handle (frg-submit-bind-permit submit-bind)) 808)
             (eq (frg-provenance-exact? (frg-permit-submit-provenance
                (frg-submit-bind-permit submit-bind)) (frgb-submit-provenance)) 1))) 1024))

    ; Publisher, lifetime, sequence and epoch mismatches plus replay refuse.
    (let wrong-publisher (frg-submit-receipt "submitted" 809 "q.metal" (frg-permit-id reserved-permit)
        (frgb-provenance-at "other.metal" 4242 1700000000 "band-4242" 74 1700000500 "band.metal-submit")))
    (let wrong-lifetime (frg-submit-receipt "submitted" 809 "q.metal" (frg-permit-id reserved-permit)
        (frgb-provenance-at "band.metal" 9999 1700000000 "band-4242" 74 1700000500 "band.metal-submit")))
    (let wrong-start (frg-submit-receipt "submitted" 809 "q.metal" (frg-permit-id reserved-permit)
        (frgb-provenance-at "band.metal" 4242 1700000001 "band-4242" 74 1700000500 "band.metal-submit")))
    (let wrong-incarnation (frg-submit-receipt "submitted" 809 "q.metal" (frg-permit-id reserved-permit)
        (frgb-provenance-at "band.metal" 4242 1700000000 "other-incarnation" 74 1700000500 "band.metal-submit")))
    (let old-sequence (frg-submit-receipt "submitted" 809 "q.metal" (frg-permit-id reserved-permit)
        (frgb-provenance-at "band.metal" 4242 1700000000 "band-4242" 72 1700000500 "band.metal-submit")))
    (let equal-sequence (frg-submit-receipt "submitted" 809 "q.metal" (frg-permit-id reserved-permit)
        (frgb-provenance-at "band.metal" 4242 1700000000 "band-4242" 73 1700000500 "band.metal-submit")))
    (let old-epoch (frg-submit-receipt "submitted" 809 "q.metal" (frg-permit-id reserved-permit)
        (frgb-provenance-at "band.metal" 4242 1700000000 "band-4242" 74 1700000200 "band.metal-submit")))
    (let equal-epoch (frg-submit-receipt "submitted" 809 "q.metal" (frg-permit-id reserved-permit)
        (frgb-provenance-at "band.metal" 4242 1700000000 "band-4242" 74 1700000250 "band.metal-submit")))
    (let wrong-quantum (frg-submit-receipt "submitted" 809 "q.other" (frg-permit-id reserved-permit)
        (frgb-submit-provenance)))
    (let wrong-permit (frg-submit-receipt "submitted" 809 "q.metal" "permit.other"
        (frgb-submit-provenance)))
    (let bad-publisher-bind (frg-bind-metal-submit critical-reserved critical-state consume q-metal wrong-publisher))
    (let bad-lifetime-bind (frg-bind-metal-submit critical-reserved critical-state consume q-metal wrong-lifetime))
    (let bad-start-bind (frg-bind-metal-submit critical-reserved critical-state consume q-metal wrong-start))
    (let bad-incarnation-bind (frg-bind-metal-submit critical-reserved critical-state consume q-metal wrong-incarnation))
    (let bad-sequence-bind (frg-bind-metal-submit critical-reserved critical-state consume q-metal old-sequence))
    (let equal-sequence-bind (frg-bind-metal-submit critical-reserved critical-state consume q-metal equal-sequence))
    (let bad-epoch-bind (frg-bind-metal-submit critical-reserved critical-state consume q-metal old-epoch))
    (let equal-epoch-bind (frg-bind-metal-submit critical-reserved critical-state consume q-metal equal-epoch))
    (let bad-quantum-bind (frg-bind-metal-submit critical-reserved critical-state consume q-metal wrong-quantum))
    (let bad-permit-bind (frg-bind-metal-submit critical-reserved critical-state consume q-metal wrong-permit))
    (let bad-count (sum (list
        (if (str_eq (frg-submit-bind-status bad-publisher-bind) "refused") 1 0)
        (if (str_eq (frg-submit-bind-status bad-lifetime-bind) "refused") 1 0)
        (if (str_eq (frg-submit-bind-status bad-start-bind) "refused") 1 0)
        (if (str_eq (frg-submit-bind-status bad-incarnation-bind) "refused") 1 0)
        (if (str_eq (frg-submit-bind-status bad-sequence-bind) "refused") 1 0)
        (if (str_eq (frg-submit-bind-status equal-sequence-bind) "refused") 1 0)
        (if (str_eq (frg-submit-bind-status bad-epoch-bind) "refused") 1 0)
        (if (str_eq (frg-submit-bind-status equal-epoch-bind) "refused") 1 0)
        (if (str_eq (frg-submit-bind-status bad-quantum-bind) "refused") 1 0)
        (if (str_eq (frg-submit-bind-status bad-permit-bind) "refused") 1 0))))
    (let replay-bind (frg-bind-metal-submit critical-reserved
        (frg-submit-bind-next-state submit-bind) consume q-metal submit-receipt))
    (let missing-reserved (frg-tick policy reserved-state
        (frgb-missing-sample (frg-unavailable "pressure-door-lost" "host.memory-pressure"))))
    (let missing-bind (frg-bind-metal-submit missing-reserved
        (frg-decision-next-state missing-reserved) consume q-metal submit-receipt))
    (let c11 (frgb-bit (and (eq bad-count 10)
        (and (str_eq (frg-submit-bind-reason replay-bind) "state-does-not-match-current-decision")
             (str_eq (frg-submit-bind-reason missing-bind) "latest-decision-not-current"))) 2048))

    ; Completion binds exact handle, permit, quantum and submit coordinates.
    (let done-outcome (frg-worker-outcome "done" "completed" "metal_status"
        (frgb-complete-provenance) 808 "q.metal" (frg-permit-id reserved-permit) 74 1700000500 75))
    (let wrong-handle-outcome (frg-worker-outcome "done" "completed" "metal_status"
        (frgb-complete-provenance) 999 "q.metal" (frg-permit-id reserved-permit) 74 1700000500 75))
    (let wrong-submit-sequence-outcome (frg-worker-outcome "done" "completed" "metal_status"
        (frgb-complete-provenance) 808 "q.metal" (frg-permit-id reserved-permit) 73 1700000500 75))
    (let wrong-submit-epoch-outcome (frg-worker-outcome "done" "completed" "metal_status"
        (frgb-complete-provenance) 808 "q.metal" (frg-permit-id reserved-permit) 74 1700000499 75))
    (let done-step (frg-step policy quiet-decision submit-bind q-metal usage-zero done-outcome))
    (let wrong-handle-step (frg-step policy quiet-decision submit-bind q-metal usage-zero wrong-handle-outcome))
    (let wrong-submit-sequence-step (frg-step policy quiet-decision submit-bind q-metal usage-zero wrong-submit-sequence-outcome))
    (let wrong-submit-epoch-step (frg-step policy quiet-decision submit-bind q-metal usage-zero wrong-submit-epoch-outcome))
    (let c12 (frgb-bit (and (str_eq (frg-step-status done-step) "done")
        (and (eq (len (frg-state-permit (frg-step-next-state done-step))) 0)
             (and (str_eq (frg-step-status wrong-handle-step) "refuse")
                  (and (str_eq (frg-step-status wrong-submit-sequence-step) "refuse")
                       (and (str_eq (frg-step-status wrong-submit-epoch-step) "refuse")
                            (str_eq (frg-step-reason wrong-handle-step) "worker-outcome-uncorrelated")))))) 4096))

    ; Yield is not completion and retains submitted ownership.
    (let yield-outcome (frg-worker-outcome "yield" "not-complete" "metal_status"
        (frgb-complete-provenance) 808 "q.metal" (frg-permit-id reserved-permit) 74 1700000500 75))
    (let yield-step (frg-step policy quiet-decision submit-bind q-metal usage-zero yield-outcome))
    (let c13 (frgb-bit (and (str_eq (frg-step-status yield-step) "yield")
        (eq (frg-permit-submitted? (frg-state-permit (frg-step-next-state yield-step))) 1)) 8192))

    ; Missing and unsplittable predicted cost are distinct refusals.
    (let q-missing (frg-quantum "q.missing" (frg-absent "prediction") (frgb-m 0) (frgb-m 0) (frgb-m 0)))
    (let worker-missing (frg-worker-outcome "done" "completed" "cpu-worker"
        (frgb-complete-provenance) 0 "q.missing" "" 0 0 75))
    (let missing-step (frg-step policy quiet-decision (list) q-missing usage-zero worker-missing))
    (let q-large (frg-quantum "q.large" (frgb-m 721) (frgb-m 0) (frgb-m 0) (frgb-m 0)))
    (let worker-large (frg-worker-outcome "done" "completed" "cpu-worker"
        (frgb-complete-provenance) 0 "q.large" "" 0 0 75))
    (let large-step (frg-step policy quiet-decision (list) q-large usage-zero worker-large))
    (let c14 (frgb-bit (and (str_eq (frg-step-reason missing-step) "predicted-cost-not-current")
        (str_eq (frg-step-reason large-step) "quantum-exceeds-bounded-target")) 16384))

    ; Pressure-only, whole-grain release with duplicate-proof identity.
    (let releasable (list
        (frg-release-unit "jit.1" "jit-native-page" (frgb-m 10) (frgb-m 4) (frgb-m 9) (frgb-m 0) (frgb-m 101) "page")
        (frg-release-unit "kv.1" "whole-kv-substate" (frgb-m 20) (frgb-m 1) (frgb-m 5) (frgb-m 0) (frgb-m 202) "whole state")
        (frg-release-unit "model.1" "inactive-whole-model" (frgb-m 30) (frgb-m 0) (frgb-m 1) (frgb-m 0) (frgb-m 303) "whole model")))
    (let no-pressure (frg-pressure-release-plan policy (frgb-m 0) (frgb-m 25) releasable))
    (let no-evidence (frg-pressure-release-plan policy (frg-unavailable "sensor" "memory.pressure") (frgb-m 25) releasable))
    (let c15 (frgb-bit (and (str_eq (frg-release-plan-status no-pressure) "none")
        (and (eq (len (frg-release-plan-selected no-pressure)) 0)
             (and (str_eq (frg-release-plan-status no-evidence) "refused")
                  (eq (len (frg-release-plan-selected no-evidence)) 0)))) 32768))
    (let pressure-plan (frg-pressure-release-plan policy (frgb-m 1) (frgb-m 25) releasable))
    (let selected (frg-release-plan-selected pressure-plan))
    (let c16 (frgb-bit (and (str_eq (frg-release-plan-status pressure-plan) "planned")
        (and (eq (len selected) 2)
             (and (str_eq (frg-release-grain (nth selected 0)) "jit-native-page")
                  (str_eq (frg-release-grain (nth selected 1)) "whole-kv-substate")))) 65536))

    ; Unsupported grains stay visible but ineligible.
    (let capabilities (frg-release-capabilities))
    (let seams (list
        (frg-release-unit "seam.expert" "packed-expert" (frgb-m 99) (frgb-m 0) (frgb-m 0) (frgb-m 0) (frgb-m 505) "unsupported")
        (frg-release-unit "seam.layer" "transformer-layer" (frgb-m 99) (frgb-m 0) (frgb-m 0) (frgb-m 0) (frgb-m 506) "unsupported")
        (frg-release-unit "seam.partial-kv" "partial-kv" (frgb-m 99) (frgb-m 0) (frgb-m 0) (frgb-m 0) (frgb-m 507) "unsupported")))
    (let seam-plan (frg-pressure-release-plan policy (frgb-m 1) (frgb-m 1) seams))
    (let c17 (frgb-bit (and (eq (frg-release-capability-supported? (nth capabilities 3)) 0)
        (and (eq (frg-release-capability-supported? (nth capabilities 5)) 0)
             (and (str_eq (frg-release-plan-status seam-plan) "blocked")
                  (eq (len (frg-release-plan-selected seam-plan)) 0)))) 131072))

    ; Duplicate ID or handle refuses the entire plan before selection.
    (let duplicate-id (append releasable
        (list (frg-release-unit "model.1" "inactive-whole-model" (frgb-m 10) (frgb-m 0) (frgb-m 0) (frgb-m 0) (frgb-m 909) "duplicate id"))))
    (let duplicate-handle (append releasable
        (list (frg-release-unit "model.other" "inactive-whole-model" (frgb-m 10) (frgb-m 0) (frgb-m 0) (frgb-m 0) (frgb-m 303) "duplicate handle"))))
    (let duplicate-id-plan (frg-pressure-release-plan policy (frgb-m 1) (frgb-m 1) duplicate-id))
    (let duplicate-handle-plan (frg-pressure-release-plan policy (frgb-m 1) (frgb-m 1) duplicate-handle))
    (let c18 (frgb-bit (and (str_eq (frg-release-plan-reason duplicate-id-plan) "duplicate-id-or-handle")
        (and (eq (len (frg-release-plan-selected duplicate-id-plan)) 0)
             (and (str_eq (frg-release-plan-reason duplicate-handle-plan) "duplicate-id-or-handle")
                  (eq (len (frg-release-plan-selected duplicate-handle-plan)) 0)))) 262144))

    ; High-BML authority names each physical boundary and unsupported seam.
    (let authority (read_file "form/form-stdlib/bml/form-resource-governor.bml"))
    (let c19 (frgb-bit (and (eq (frgb-has authority "atomic fixed-path singleton") 1)
        (and (eq (frgb-has authority "exact command-buffer handle") 1)
             (and (eq (frgb-has authority "CPU-worker requests only") 1)
                  (and (eq (frgb-has authority "partial KV release are explicit unsupported seams") 1)
                       (eq (frgb-has authority "without claiming cancellation") 1))))) 524288))

    (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17 c18 c19)))
