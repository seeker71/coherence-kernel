; let-scope-band.fk -- one let rule, read the same on fkwu, Go, Rust and TS.
;
; A unit's top-level (do ...) is the unit's sequence: its lets are unit
; constants that every defn of the unit reads, in any order. Any other do is
; a lexical scope: a let binds only the rest of that do. A let in an if arm
; reaches nothing after the if. Rebinding in the same block shadows.
;
;   bit   1  p1   a defn in the top-level do reads that do's earlier let
;   bit   2  p2   a defn reads an earlier column-0 let
;   bit   4  p3   a defn reads a later column-0 let
;   bit   8  p4   a defn in the top-level do reads that do's later let
;   bit  16  p5   inside a defn, a nested do's let does not reach the rest
;   bit  32  p6   in the top-level do, a nested do's let does not reach the rest
;   bit  64  p8   rebinding in one block: the read between sees 1, the last 2
;   bit 128  p9   a let in an if arm does not reach code after the if
;   bit 256  p10  a nested let's value reads the enclosing binding, which holds
;
; p7 -- a defn that reads a name nothing binds, (do (defn f () nope) (f)) --
; is checked apart from this verdict: fkwu refuses it at compile with
; [unbound-name] 'nope' and exit 1; Go, Rust and TS stop at the read, exit 1.
;
; Expected: 511

(defn ls-p3 () K3)
(let K2 7)
(defn ls-p2 () K2)
(let K3 7)

(defn ls-p5 () (do (let t 0) (do (let t 5)) t))

(defn ls-p8 () (do (let x 1) (let a x) (let x 2) (add (mul a 10) x)))

(defn ls-p9 () (do (let t 0) (if 1 (let t 5) 0) t))

(defn ls-p10 (n) (do (let t n) (let u (do (let t (add t 1)) t)) (add (mul t 10) u)))

(do
    (let K1 7)
    (defn ls-p1 () K1)
    (defn ls-p4 () K4)
    (let K4 7)
    (let t6 0)
    (do (let t6 5))
    (let r6 t6)
    (let x8 1)
    (let r8a x8)
    (let x8 2)
    (let r8b x8)
    (let y9 0)
    (if 1 (let y9 9) 0)
    (let r9 y9)
    (let b1 (if (eq (ls-p1) 7) 1 0))
    (let b2 (if (eq (ls-p2) 7) 2 0))
    (let b3 (if (eq (ls-p3) 7) 4 0))
    (let b4 (if (eq (ls-p4) 7) 8 0))
    (let b5 (if (eq (ls-p5) 0) 16 0))
    (let b6 (if (eq r6 0) 32 0))
    (let b8 (if (and (eq (ls-p8) 12) (and (eq r8a 1) (eq r8b 2))) 64 0))
    (let b9 (if (and (eq (ls-p9) 0) (eq r9 0)) 128 0))
    (let b10 (if (eq (ls-p10 3) 34) 256 0))
    (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b8 (add b9 b10)))))))))
