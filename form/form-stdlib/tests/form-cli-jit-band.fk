; form-cli-jit-band.fk — one BML thought, emitted on demand onto CPU/Metal/MLX.
;
; C does not own f(n)=n*3+7. Form-lower emits AArch64. This class emits
; MSL and MLX postfix from the same named Mul/Add. Doors only install.
;
; Verdict 1023:
;     1  BML names Mul/Add/Sample/Expect and the three doors
;     2  MLX runs the Form-emitted postfix
;     4  form-lower + jit_leaf_inram runs the Form-emitted AArch64
;     8  that image is 20 bytes (five insns + ret)
;    16  Metal GPU compiles the Form-emitted MSL
;    32  form_cpu_jit runs Form-emitted AArch64 against a buffer
;    64  class descriptor FormJit
;   128  mlx add is still a Form program, not a new C opcode
;   256  MSL text contains the named Mul as decimal
;   512  mlx linked (or Metal linked for the GPU bits; guarded)
;
; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk form-stdlib/metal-door.fk form-stdlib/form-cli-jit-xtal.fk
; witnessed: 2026-08-22 -> 1023

(do
    (defn fjit-score (ok bit) (if ok bit 0))
    (defn fjit-has (hay needle) (if (lt (str_find hay needle 0) 0) 0 1))
    (defn fjit-bytes (xs)
        (if (eq (len xs) 0) ""
            (str_concat (byte_to_str (head xs)) (fjit-bytes (tail xs)))))
    (defn fjit-ssa ()
        (list (list 1 (Add)) (list 2) (list 1 (Mul)) (list 5 1 2) (list 3 3 0)))
    (defn fjit-cpu-image ()
        (fa-image (list
            (fa-ldr 3 0 0)
            (fa-ldr-w 5 3 0)
            (fa-movz 4 (Mul))
            (fa-mul 5 5 4)
            (fa-add 5 5 (Add))
            (fa-str-w 5 3 0)
            (fa-ret))))
    (defn fjit-mlx-live? () (eq (fjit-has (mlx_status) "mlx_linked=true") 1))
    (defn fjit-metal-live? () (eq (fjit-has (metal_status) "metal_linked=true") 1))

    (let named (fjit-check))
    (let img (lo-compile-fn (fjit-ssa) 4))
    (let cpu (jit_leaf_inram img (Sample)))
    (let mlx-ok (if (fjit-mlx-live?) (eq (mlx_run (fjit-mlx (Sample))) (Expect)) 0))
    (let add-ok (if (fjit-mlx-live?) (eq (mlx_run "2 3 add") 5) 0))
    (let desc (FormJit))
    (let msl (fjit-msl))

    (let gbuf (metal_buf_alloc 4))
    (metal_buf_write gbuf 0 (md-le32 (Sample)))
    (let gpipe (metal_pipeline msl "form_jit_f"))
    (let genq (metal_enqueue gpipe (md-bind (list gbuf) (empty)) 1))
    (let gsync (metal_sync))
    (let gres (metal_buf_read gbuf 0 4))
    (let gpu-byte (str_byte_at gres 0))
    (metal_buf_free gbuf)

    (let cbuf (metal_buf_alloc 4))
    (metal_buf_write cbuf 0 (md-le32 (Sample)))
    (let cpipe (metal_pipeline (fjit-bytes (fjit-cpu-image)) "form_cpu_jit"))
    (let cenq (metal_enqueue cpipe (md-bind (list cbuf) (empty)) 1))
    (let cres (metal_buf_read cbuf 0 4))
    (let cpu-jit-byte (str_byte_at cres 0))
    (metal_buf_free cbuf)

    (let c0 (fjit-score (eq named 63) 1))
    (let c1 (fjit-score mlx-ok 2))
    (let c2 (fjit-score (eq cpu (Expect)) 4))
    (let c3 (fjit-score (eq (len img) 20) 8))
    (let c4 (fjit-score (if (fjit-metal-live?)
                           (if (eq gpipe 0) 0 (eq gpu-byte (Expect))) 0) 16))
    (let c5 (fjit-score (if (fjit-metal-live?)
                           (if (eq cpipe 0) 0 (eq cpu-jit-byte (Expect))) 0) 32))
    (let c6 (fjit-score (str_eq (nth desc 1) "FormJit") 64))
    (let c7 (fjit-score add-ok 128))
    (let c8 (fjit-score (eq (fjit-has msl (int_to_str (Mul))) 1) 256))
    (let c9 (fjit-score (if (fjit-mlx-live?) 1 (fjit-metal-live?)) 512))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 c9))))))))))
