; form-cli-jit-band.fk — one Apply, backends as data, no named C doors.
;
; Verdict 16383:
;     1  BML names Mul/Add and backend ids
;     2  Apply(Mlx) = 22
;     4  Apply(Cpu) form-lower image runs = 22
;     8  that image is 20 bytes
;    16  Apply(Metal) Form MSL = 22
;    32  class FormJit
;    64  MSL contains named Mul
;   128  mlx 2 3 add still 5
;   256  high-grammar authority has package/template/enum
;   512  mlx or metal live
;  1024  actual form-cli CPU calls 1..4 walk through the explicit Form route
;  2048  call 5 crosses the per-NodeID heat gate and births native once
;  4096  call 6 reaches the resident page, answers identically, births nothing
;  8192  an offered unlowerable program reaches the same gate, stays Form,
;        births nothing, and preserves its exact nothing answer
;
; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk form-stdlib/jit-self-crystallization.fk form-stdlib/jit-once-born.fk form-stdlib/jit-decision.fk form-stdlib/jit-heat-gate.fk form-stdlib/metal-door.fk form-stdlib/language-model.fk form-stdlib/form-cli-jit-xtal.fk
; witnessed: 2026-08-27 -> 16383

(do
    (defn fjit-score (ok bit) (if ok bit 0))
    (defn fjit-has (hay needle) (if (lt (str_find hay needle 0) 0) 0 1))
    (defn fjit-mlx-live? () (eq (fjit-has (mlx_status) "mlx_linked=true") 1))
    (defn fjit-metal-live? () (eq (fjit-has (metal_status) "metal_linked=true") 1))

    (let named (fjit-check))
    (let img (lo-compile-fn (fjit-ssa) 4))
    (let src (read_file "form/form-stdlib/bml/form-cli-jit.bml"))
    (let desc (FormJit))
    (let msl (fjit-msl))
    (let gate0 (fjit-gate 20260827))
    (let warm (fjit-heat-run gate0 (Sample) 4))
    (let hot (fjit-request-cpu (nth warm 2) (Sample)))
    (let resident (fjit-request-cpu (nth hot 2) (Sample)))
    (let unlowerable (fjit-request (fjit-gate 20260827)
        (list (list 1 1) (list 2) (list 6 0 1 1)) 2 9))
    (let c0 (fjit-score (eq named 15) 1))
    (let c1 (fjit-score (if (fjit-mlx-live?) (eq (fjit-apply (Mlx) (Sample)) (Expect)) 0) 2))
    (let c2 (fjit-score (eq (fjit-apply (Cpu) (Sample)) (Expect)) 4))
    (let c3 (fjit-score (eq (len img) 20) 8))
    (let c4 (fjit-score (if (fjit-metal-live?) (eq (fjit-apply (Metal) (Sample)) (Expect)) 0) 16))
    (let c5 (fjit-score (str_eq (nth desc 1) "FormJit") 32))
    (let c6 (fjit-score (eq (fjit-has msl (int_to_str (Mul))) 1) 64))
    (let c7 (fjit-score (if (fjit-mlx-live?) (eq (mlx_run "2 3 add") 5) 0) 128))
    (let c8 (fjit-score (if (eq (fjit-has src "package Form.cli.jit") 1)
                           (if (eq (fjit-has src "template BackendCell") 1)
                               (eq (fjit-has src "enum JitBackend") 1) 0) 0) 256))
    (let c9 (fjit-score (if (fjit-mlx-live?) 1 (fjit-metal-live?)) 512))
    (let c10 (fjit-score (and (str_eq (nth warm 1) "form")
                              (and (eq (nth warm 3) 0)
                                   (eq (nth warm 0) (Expect)))) 1024))
    (let c11 (fjit-score (and (str_eq (nth hot 1) "native")
                              (and (eq (nth hot 3) 1)
                                   (eq (nth hot 0) (Expect)))) 2048))
    (let c12 (fjit-score (and (str_eq (nth resident 1) "native")
                              (and (eq (nth resident 3) 0)
                                   (eq (nth resident 0) (Expect)))) 4096))
    (let c13 (fjit-score (and (str_eq (nth unlowerable 1) "form")
                              (and (eq (nth unlowerable 3) 0)
                                   (nothing? (nth unlowerable 0)))) 8192))
    (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13)))
