; form-glass-machine-band.fk — the machine frame's GPU rows: a gauge another reader consumes renders contended, and the
; glass's own Metal-timing estimate stands beside it as a second, uncontended lane; and the device's own byte ledger rides the same fast rows the frame is folded from.
;
; PURE apart from one accelerator read for the row shape (b8); every state is driven by fixture rows and reader lists. Expected: 511
; preludes: form-stdlib/form-glass-live.bml

(do
    (defn mb-bit (ok bit) (if ok bit 0))
    (let monitor (list (list 688 124239872 7644943006 193502 0)))
    (let nobody (list))

    ; the gauge reads 0 while Activity Monitor stands: contended, not idle -- evidence, lifecycle and the note name the reader
    (let contended (fgl-gpu-level-live-row-at 0 monitor))
    (let b1 (mb-bit (and (str_eq (fgo-lifecycle contended) "contended") (and (str_eq (fgo-evidence contended) "contended") (ge (str_find (fgo-note contended) "Activity Monitor pid 688" 0) 0))) 1))
    ; the same 0 with no other reader is idle, as before
    (let idle (fgl-gpu-level-live-row-at 0 nobody))
    (let b2 (mb-bit (and (str_eq (fgo-lifecycle idle) "idle") (str_eq (fgo-evidence idle) "physical-live")) 2))
    ; a nonzero level is live even beside a reader: the gauge answered this process this time
    (let live (fgl-gpu-level-live-row-at 37 monitor))
    (let b3 (mb-bit (and (str_eq (fgo-lifecycle live) "live") (and (eq (fgo-int-value live) 37) (eq (fgl-gpu-gauge-contended? 37 monitor) 0))) 4))
    ; the reader row names the pid when it stands and says none when it does not
    (let reader (fgl-gpu-reader-row monitor))
    (let noReader (fgl-gpu-reader-row nobody))
    (let b4 (mb-bit (and (eq (fgo-int-value reader) 688) (and (str_eq (fgo-lifecycle reader) "contended") (and (eq (fgo-int-value noReader) 0) (str_eq (fgo-lifecycle noReader) "none")))) 8))
    ; the busy integral carries the contention: the G lane reads its evidence and renders "!" and "?", never a flat 0
    (let busy (fgl-gpu-busy-live-row-at 3318254 1))
    (let busyFree (fgl-gpu-busy-live-row-at 3318254 0))
    (let b5 (mb-bit (and (str_eq (fgo-evidence busy) "contended") (and (str_eq (fgo-evidence busyFree) "derived-window") (and (str_eq (fgd-truth-symbol "contended") "!") (not (str_eq (fgd-truth-symbol "contended") (fgd-truth-symbol "derived-window")))))) 16))
    ; the estimate lane sums Metal command-buffer time over the frames and this process; an unrelated row is not counted
    (let ownerBusy (fgo-int "gpu" "gpu.owner.busy-us-total" "owner GPU busy" 2000 "microseconds" 0 "unified-gpu" "physical-live" "owner" "live" "metal" ""))
    (let ownerJit (fgo-int "jit" "jit.owner.metal-busy-us-total" "owner JIT metal busy" 500 "microseconds" 0 "unified-gpu" "physical-live" "owner" "live" "metal" ""))
    (let other (fgo-int "host" "cpu-busy-us" "cpu" 99999 "microseconds" 0 "cpu" "physical-live" "mach" "live" "kernel" ""))
    (let estimate (fgl-gpu-estimate-row (list ownerBusy other ownerJit) 250))
    (let b6 (mb-bit (and (eq (fgo-int-value estimate) 2750) (and (str_eq (fgo-id estimate) "gpu-busy-estimate-us") (str_eq (fgo-lifecycle estimate) "live"))) 32))
    (let b7 (mb-bit (and (eq (fgo-int-value (fgl-gpu-estimate-row (list other) 0)) 0) (str_eq (fgo-lifecycle (fgl-gpu-estimate-row (list other) 0)) "idle")) 64))
    ; the machine rows carry the reader row and the sensor's heat-lane row (the J lane sums it) -- five rows, ids in place
    (let rows (fgl-machine-rows-at nobody))
    (let b8 (mb-bit (and (eq (len rows) 5) (and (str_eq (fgo-id (nth rows 2)) "gpu-gauge-reader") (str_eq (fgo-id (nth rows 4)) "jit-heat-calls"))) 128))

    ; the frame path itself carries the device's byte ledger: the two Metal size
    ; gauges ride the same fast rows the machine frame is folded from, read live
    ; from this host's own device. The working set is the ceiling, the allocation
    ; is what stands under it, so the ceiling is never the smaller of the two.
    (let fast (fgl-observe-fast-rows (list)))
    (let linked (fgo-metal-word (metal_live) 0))
    (let metalBytes (nth fast 29))
    (let workingSet (nth fast 30))
    (let b9 (mb-bit (and (str_eq (fgo-id metalBytes) "allocated-bytes")
                      (and (str_eq (fgo-id workingSet) "working-set")
                       (or (le linked 0)
                           (and (str_eq (fgo-source metalBytes) "metal_live")
                            (and (eq (fgo-present? metalBytes) 1)
                             (and (eq (fgo-present? workingSet) 1)
                              (and (ge (fgo-int-value metalBytes) 0)
                                   (gt (fgo-int-value workingSet) (fgo-int-value metalBytes)))))))))
                    256))

    (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 b9)))))))))
