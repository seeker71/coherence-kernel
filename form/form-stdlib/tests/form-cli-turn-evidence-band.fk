; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk
; preludes: form-stdlib/form-cli-turn-evidence.fk
;
; form-cli-turn-evidence-band — the carrier can offer numbers, but only Form
; may call them observed. Verdict 4095 proves reconciliation, honest kind
; transitions, failure visibility, and deterministic event-share rounding.

(defn fcteb-set (xs i value)
    (if (eq i 0) (cons value (tail xs))
        (cons (head xs) (fcteb-set (tail xs) (sub i 1) value))))

(do
    (let base (fcte-parse
        "turn-evidence-v1|thread-1|turn-1|openai|gpt-test|1000|2000|1000|100|128|2|1000|600|400|0|200|50|1200|3|3|400|2048|2|1|100|20|120|1|0|2|2|5|1|codex-rollout-jsonl+explicit-form-binding|1"))
    (let share (fcte-boundary-share base))
    (let tie (fcteb-set
        (fcteb-set
        (fcteb-set
        (fcteb-set
        (fcteb-set base 10 "1") 27 "1") 29 "1") 30 "1") 31 "3"))
    (let tie-share (fcte-boundary-share tie))
    (let bad-total (fcteb-set base 17 "1199"))
    (let bad-cache (fcteb-set base 12 "1200"))
    (let bad-tools (fcteb-set base 19 "2"))
    (let bad-bytes (fcteb-set base 26 "121"))
    (let bad-lanes (fcteb-set base 31 "4"))
    (let incomplete (fcteb-set base 34 "0"))
    (let malformed (fcte-parse "unmeasured"))

    (let c0 (if (eq (fcte-valid? base) 1) 1 0))
    (let c1 (if (str_eq (fcte-kind-name base) "observed") 2 0))
    (let c2 (if (and (eq (nth share 0) 20)
                (and (eq (nth share 1) 40)
                     (eq (nth share 2) 40))) 4 0))
    (let c3 (if (and (eq (nth tie-share 0) 34)
                (and (eq (nth tie-share 1) 33)
                     (eq (nth tie-share 2) 33))) 8 0))
    (let c4 (if (eq (fcte-valid? bad-total) 0) 16 0))
    (let c5 (if (eq (fcte-valid? bad-cache) 0) 32 0))
    (let c6 (if (eq (fcte-valid? bad-tools) 0) 64 0))
    (let c7 (if (eq (fcte-valid? bad-bytes) 0) 128 0))
    (let c8 (if (eq (fcte-valid? bad-lanes) 0) 256 0))
    (let c9 (if (and (eq (fcte-valid? incomplete) 0)
                     (str_eq (fcte-kind-name incomplete) "embodied")) 512 0))
    (let c10 (if (str_eq (fcte-kind-name malformed) "declared") 1024 0))
    ; A failed command does not invalidate the measurement. Hiding it would.
    (let c11 (if (and (eq (fcte-form-failures base) 1)
                       (eq (fcte-valid? base) 1)) 2048 0))
    (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11)))
