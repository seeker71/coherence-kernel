; form-knowledge-exec-diagnostic-band.fk -- frozen lineage, query-token,
; current-source lesson and prompt separation before candidate generation.
;
; Verdict 4095 (12 bits).
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/sha256.fk form-stdlib/hex.fk
; preludes: form-stdlib/native-model-evidence.fk
; preludes: form-stdlib/form-knowledge-query-token.fk
; preludes: form-stdlib/form-knowledge-exec-diagnostic.fk

(do
    (defn fkedb-bit (ok bit) (if ok bit 0))
    (defn fkedb-run ()
        (do
            (let observation (fked-current-source-observation))
            (let base (fked-base-prompt))
            (let rag (fked-rag-prompt))
            (let repair (fked-repair-prompt "candidate-bytes" "typed-mismatch"))
            (sum (list
                (fkedb-bit (str_eq (fked-split) "heldout-before-derivation") 1)
                (fkedb-bit (eq (fked-training-denied?) 1) 2)
                (fkedb-bit (and (eq (len (fked-source-paths)) 3)
                                 (eq (len (fked-source-commits)) 3)) 4)
                (fkedb-bit (eq (fked-sources-current?) 1) 8)
                (fkedb-bit (eq (fkqt-request-ready?
                    (fkqt-parse (fked-query-surface))) 1) 16)
                (fkedb-bit (and (str_eq (fked-observation-status observation) "hit")
                    (and (eq (fked-observation-executed? observation) 1)
                         (eq (fked-observation-model-executed? observation) 0))) 32)
                (fkedb-bit (and (eq (fked-observation-group-lookups observation) 1)
                    (and (eq (fked-observation-file-reads observation) 3)
                    (and (eq (fked-observation-remote observation) 0)
                         (eq (fked-observation-http observation) 0)))) 64)
                (fkedb-bit (str_eq (nmfe-sha256
                    (fked-observation-lesson observation)) (fked-lesson-sha)) 128)
                (fkedb-bit (and (lt (str_find base "oac-cut-with-receipt" 0) 0)
                    (ge (str_find rag "oac-cut-with-receipt" 0) 0)) 256)
                (fkedb-bit (and (lt (str_find (fked-lesson) "fkecc-" 0) 0)
                                 (lt (str_find (fked-lesson) "511" 0) 0)) 512)
                (fkedb-bit (and (ge (str_find rag (fked-query-surface) 0) 0)
                                 (ge (str_find rag (fked-lesson-sha) 0) 0)) 1024)
                (fkedb-bit (and (ge (str_find repair "candidate-bytes" 0) 0)
                    (and (ge (str_find repair "typed-mismatch" 0) 0)
                         (ge (str_find repair (fked-challenge-id) 0) 0))) 2048)))))

    (fkedb-run))
