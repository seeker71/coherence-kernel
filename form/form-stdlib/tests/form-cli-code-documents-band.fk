; All documents must reach both the model bootstrap and the caller's result.
; Native synthetic values only. Expected 255.
; preludes: form-stdlib/bml/form-cli-code-request.bml
(do
 (defn fcdb-bit (ok bit) (if ok bit 0))
 (let docs (list (list "one" "one.form" "a") (list "two" "two.form" "b\n\"c\"") (list "three" "three.form" "日本語 café")))
 (let node (fat-wire-documents-node docs))
 (let payload (json-emit (json-node-object (list (json-node-pair "documents" node)))))
 (let decoded (fat-wire-documents (faj-json "roundtrip" payload)))
 (let state (fcap-open "Inspect all three" docs (list "one.form")))
 (let result (faj-json "result" (fcaq-result (list state 1 0 0 0))))
 (let bootstrap (fcap-bootstrap state))
 (let body (faj-json "bootstrap" (substring bootstrap (add (str_find bootstrap "\n" 0) 1) (str_find bootstrap "\nCURRENT REPLY:" 0))))
 (let tool-result (faj-json "tool" (fat-wire-render (fat-call docs "read" (list "two.form") ""))))
 (sum (list
  (fcdb-bit (eq (len (node_children node)) 3) 1)
  (fcdb-bit (str_eq (fat-wire-error decoded) "") 2)
  (fcdb-bit (value_eq (fat-wire-value decoded) docs) 4)
  (fcdb-bit (value_eq (fat-wire-value (fat-wire-documents result)) docs) 8)
  (fcdb-bit (value_eq (fat-wire-value (fat-wire-documents body)) docs) 16)
  (fcdb-bit (str_eq (json-emit (fat-wire-documents-node (list))) "[]") 32)
  (fcdb-bit (value_eq (fat-wire-value (fat-wire-documents tool-result)) docs) 64)
  (fcdb-bit (fat-wire-object? (json-object-get body "current")) 128))))
