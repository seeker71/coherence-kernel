; native-model-form-action-protocol-band.fk — all native words reach a
; proposal route, while unavailable models and missing authority become typed
; healing signals.
;
; preludes: form-stdlib/core.fk form-stdlib/native-model-control-plane.fk form-stdlib/native-model-control-plane-eval.fk form-stdlib/form-teach-layer.fk form-stdlib/native-model-form-token-envelope.bml form-stdlib/form-agent-protocol.fk form-stdlib/native-model-form-action-protocol.bml
;
; Verdict 2047: 1023 executable + 1024 high-BML authority.

(do
    (defn nmfapb-has (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (let ask (nmfap-proposal (NMFTEQwen) "ask" "{question:why}" "31.2.0.7" "native-model-form" (NMFAPWire) 1))
    (let choice (nmfap-proposal (NMFTEThreeB) "choice" "{}" "" "native-model-form" (NMFAPWire) 1))
    (let alias (nmfap-proposal (NMFTEQwen) "crystalize" "{}" "31.2.0.8" "native-model-form" (NMFAPWire) 1))
    (let unavailable (nmfap-proposal "st.llama32-3b-mlx-4bit" "eval" "{}" "31.2.0.9" "native-model-form" (NMFAPWire) 1))
    (let missing-node (nmfap-proposal (NMFTEQwen) "broadcast" "{}" "" "native-model-form" (NMFAPWire) 1))
    (let unknown (nmfap-proposal (NMFTEQwen) "invent" "{}" "31.2.0.10" "native-model-form" (NMFAPWire) 1))
    (let call (nmfap-tool-call "call-1" ask))
    (let c0 (if (and (eq (nmfap-admit? ask) 1) (str_eq (nmfap-route "ask") "grounded-ask")) 1 0))
    (let c1 (if (and (eq (nmfap-admit? choice) 1) (str_eq (nmfap-control-tag "choice") "<CHOICE>")) 2 0))
    (let c2 (if (and (str_eq (nmfap-word alias) "crystallize") (str_eq (nmfap-route (nmfap-word alias)) "jit-crystallize")) 4 0))
    (let c3 (if (and (eq (nmfap-admit? unavailable) 0) (str_eq (nmfap-healing-signal (nmfap-healing unavailable)) "model-unavailable")) 8 0))
    (let c4 (if (and (eq (nmfap-admit? missing-node) 0) (str_eq (nmfap-healing-signal (nmfap-healing missing-node)) "missing-nodeid")) 16 0))
    (let c5 (if (and (eq (nmfap-admit? unknown) 0) (str_eq (nmfap-healing-next (nmfap-healing unknown)) "ground-word-and-add-witnessed-route")) 32 0))
    (let c6 (if (and (str_eq (ap-part-kind call) "tool_call") (str_eq (ap-tc-name call) "form.ask")) 64 0))
    (let c7 (if (eq (nmfap-count-admitted-words (NMFTEQwen) (nmfte-native-vocabulary)) 20) 128 0))
    (let c8 (if (eq (nmfap-count-admitted-words (NMFTEThreeB) (nmfte-native-vocabulary)) 20) 256 0))
    (let routes (list (nmfap-route "Node-ID") (nmfap-route "nothing") (nmfap-route "eval") (nmfap-route "release") (nmfap-route "melt") (nmfap-route "open") (nmfap-route "interface") (nmfap-route "protocol") (nmfap-route "offer") (nmfap-route "broadcast") (nmfap-route "mesh") (nmfap-route "satsang")))
    (let c9 (if (eq (len routes) 12) 512 0))
    (let base (sum (list c0 c1 c2 c3 c4 c5 c6 c7 c8 c9)))
    (let src (read_file "form/form-stdlib/bml/native-model-form-action-protocol.bml"))
    (let authority
        (if (eq (nmfapb-has src "const String FullyEnabledRule = \"enabled means vocabulary assigned, proposal encoded, route known, and native gate present; it never means unconstrained model actuation\"") 1)
            (if (eq (nmfapb-has src "const String HealingRule = \"unknown words, unavailable models, missing contracts, and missing Node-IDs return a typed healing signal with a next action\"") 1)
                (if (eq (nmfapb-has src "const int NativeWordCount = 20") 1) 1024 0) 0) 0))
    (add base authority))
