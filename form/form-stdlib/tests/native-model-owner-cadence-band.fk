; native-model-owner-cadence-band.fk — liveness/readiness separation.
;
; preludes: form-stdlib/core.fk form-stdlib/native-model-owner-cadence.bml form-stdlib/form-glass-live.bml
; Verdict 262143: exact lifetime correlation, fresh liveness, stale model
; evidence, dead projection, leased singleton command ingress, no local node-ID
; and the default Glass model/owner grouping remain distinct.

(do
    (defn nmdocb-bit (held weight) (if (eq held 1) weight 0))
    (defn nmdocb-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))
    (defn nmdocb-liveness (id epoch) (fgtm-sample id (fgtm-absent)
        "owner-liveness" "cpu" "cadence-fixture" "model-owner" "fixture"
        (fgtm-absent) (fgtm-absent) "active" (fgtm-present epoch)
        (fgtm-present epoch) (fgtm-absent) (fgtm-present 4242) "never"
        "physical-live" "fixture" (list "process" "model" "health")))
    (let commandPublisher "models.dual-resident.i1700000100")
    (let commandPath (nmdoc-command-path commandPublisher))
    (let candidatePath (nmdoc-command-candidate-path commandPublisher))
    (let lockPath (nmdoc-command-lock-path commandPublisher))
    (let leasePath (nmdoc-command-lease-path commandPublisher))
    (let _cleanCommand (fs-remove-file commandPath))
    (let _cleanCandidate (fs-remove-file candidatePath))
    (let _cleanLease (fs-remove-file leasePath))
    (let _cleanLock (fs-remove-tree lockPath))
    (let publisher (nmdt-owner-publisher 1700000100))
    (let correlation (nmdoc-correlation
        (nmdoc-observer-publisher 1700000300) 5001 1700000300
        (nmdoc-observer-incarnation 1700000300) 7 1700000500
        publisher 4242 1700000100 1700000200 1700000000
        "Wed Sep 2 14:52:54 2026 ./fkwu observe/native-model-dual-resident-live-run.fk"
        publisher 4242 1700000100 "heartbeat.i1700000100"
        "exact-snapshot-owner"))
    (let legacyCorrelation (nmdoc-correlation
        (nmdoc-observer-publisher 1700000300) 5001 1700000300
        (nmdoc-observer-incarnation 1700000300) 7 1700000500
        publisher 4242 1700000100 1700000200 1700000000
        "Wed Sep 2 14:52:54 2026 ./fkwu observe/native-model-dual-resident-live-run.fk"
        publisher 4242 1700000100 "heartbeat.i1700000100.s17"
        "exact-snapshot-owner"))
    (let live (nmdoc-target-liveness-sample correlation 1))
    (let dead (nmdoc-target-liveness-sample correlation 0))
    (let oldModel (nmdt-resident-sample
        "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth" "ready" 1262
        1700000100 1700000100))
    (let oldSnapshot (fgtm-snapshot publisher 1700000200 (list oldModel)))
    (let oldReading (fgtm-read-state publisher "current" (fgtm-present oldSnapshot)))
    (let staleModel (head (fgl-current-reading-samples-at oldReading 1700010000)))
    (let authoritySource (read_file "form/form-stdlib/bml/native-model-owner-cadence.bml"))
    (let executableSource (read_file "form/form-stdlib/native-model-owner-cadence.bml"))
    (let heartbeat (nmdoc-observer-heartbeat-sample correlation))
    (let nextHeartbeat (nmdoc-observer-heartbeat-sample
        (nmdoc-next-correlation correlation 1700000600)))
    (let offered (nmdoc-offer-command commandPublisher "status"))
    (let duplicate (nmdoc-offer-command commandPublisher "heartbeat"))
    (let polled (nmdoc-poll-command commandPublisher))
    (let secondPoll (nmdoc-poll-command commandPublisher))
    (let _orphanLock (fs-mkdir lockPath))
    (let _orphanLease (fs-write-text leasePath
        (nmdoc-command-lease-text commandPublisher)))
    (let orphanHealed (nmdoc-poll-command-at commandPublisher
        (add (fs-stat-mtime lockPath) (add (NMDOCCommandLeaseSeconds) 1))))
    (let invalid (nmdoc-correlation
        (nmdoc-observer-publisher 1700000300) 5001 1700000300
        (nmdoc-observer-incarnation 1700000300) 7 1700000500
        publisher 4242 1700000100 1700000200 1700000150 "signature"
        publisher 4242 1700000100 "heartbeat.i1700000100.s17"
        "exact-snapshot-owner"))
    (let unbound (nmdoc-correlation
        (nmdoc-observer-publisher 1700000300) 5001 1700000300
        (nmdoc-observer-incarnation 1700000300) 7 1700000500
        publisher 4242 1700000100 1700000200 1700000000 "signature"
        "" -1 -1 "" "unbound-last-observed"))
    (let unboundLive (nmdoc-target-liveness-sample unbound 1))
    (let modelTwo (nmdt-resident-sample
        "model.qwen3-3b-form-router" "ready" 1263
        1700000101 1700000101))
    (let newestLiveness (nmdocb-liveness "process.newest" 1700010006))
    (let grouped (fglui-model-owner-samples (list
        (nmdocb-liveness "process.1" 1700010001)
        oldModel
        (nmdocb-liveness "process.2" 1700010002)
        (nmdocb-liveness "process.3" 1700010003)
        modelTwo
        (nmdocb-liveness "process.4" 1700010004)
        (nmdocb-liveness "process.5" 1700010005)
        newestLiveness)))
    (let _finalCommand (fs-remove-file commandPath))
    (let _finalCandidate (fs-remove-file candidatePath))
    (let _finalLease (fs-remove-file leasePath))
    (let _finalLock (fs-remove-tree lockPath))
    (sum (list
        (nmdocb-bit (eq (nmdoc-correlation? correlation) 1) 1)
        (nmdocb-bit (and (str_eq (nmdoc-target-publisher correlation) publisher)
            (and (eq (nmdoc-target-pid correlation) 4242)
                (and (eq (nmdoc-target-publisher-started correlation) 1700000100)
                    (and (str_eq (nmdoc-target-snapshot-owner-publisher correlation) publisher)
                        (and (eq (nmdoc-target-snapshot-owner-pid correlation) 4242)
                            (eq (nmdoc-target-snapshot-owner-started correlation) 1700000100)))))) 2)
        (nmdocb-bit (and (eq (fgtm-sample-valid? live) 1)
            (and (str_eq (fgtm-sample-kind live) "owner-liveness")
                (str_eq (fgtm-sample-lifecycle live) "active"))) 4)
        (nmdocb-bit (and (str_eq (fgtm-sample-lifecycle dead) "failed")
            (str_eq (fgtm-sample-evidence dead) "physical-live")) 8)
        (nmdocb-bit (and (str_eq (fgtm-sample-evidence staleModel) "derived-window")
            (str_eq (fgtm-sample-source staleModel) "glass.stale-snapshot")) 16)
        (nmdocb-bit (and (str_eq (fgtm-sample-evidence live) "physical-live")
            (eq (fgtm-field-value (fgtm-sample-read-epoch live)) 1700000500)) 32)
        (nmdocb-bit (and (eq (fgtm-field-value (fgtm-sample-read-epoch staleModel)) 1700000100)
            (eq (fgtm-field-value (fgtm-sample-handle staleModel)) 1262)) 64)
        (nmdocb-bit (and (str_eq (nmdoc-command-status offered) "offered")
            (and (str_eq (nmdoc-command-status polled) "ready")
                (str_eq (nmdoc-command-value polled) "status"))) 128)
        (nmdocb-bit (and (str_eq (nmdoc-command-status duplicate) "refused")
            (str_eq (nmdoc-command-status secondPoll) "waiting")) 256)
        (nmdocb-bit (eq (nmdoc-correlation? invalid) 0) 512)
        (nmdocb-bit (and (eq (nmdoc-target-heartbeat-id-valid? correlation) 1)
            (and (eq (nmdoc-target-heartbeat-id-valid? legacyCorrelation) 1)
                (str_eq (nmdoc-target-binding correlation) "exact-snapshot-owner"))) 1024)
        (nmdocb-bit (and (eq (nmdoc-correlation? unbound) 1)
            (str_eq (nmdoc-target-binding unbound) "unbound-last-observed")) 2048)
        (nmdocb-bit (and (eq (nmdocb-has authoritySource "NUMS") 0)
            (and (eq (nmdocb-has executableSource "NMDOCNode") 0)
                (eq (nmdocb-has executableSource "0.2.4.1") 0))) 4096)
        (nmdocb-bit (and (str_eq (fgtm-sample-id heartbeat)
                "heartbeat.i1700000300")
            (and (str_eq (fgtm-sample-id nextHeartbeat)
                    "heartbeat.i1700000300")
                (str_eq (fgtm-sample-purpose heartbeat)
                    "owner-cadence-heartbeat"))) 8192)
        (nmdocb-bit (and (str_eq (fgtm-sample-purpose live) "os-process-lifetime-current")
            (and (not (str_eq (fgtm-sample-kind live) "model"))
                (and (eq (nmdoc-correlation? unbound) 1)
                    (str_eq (fgtm-sample-purpose unboundLive)
                        "os-process-lifetime-current-owner-unbound")))) 16384)
        (nmdocb-bit (and (eq (fgtm-field-present? (fgtm-sample-bytes live)) 0)
            (eq (fgtm-field-present? (fgtm-sample-capacity live)) 0)) 32768)
        (nmdocb-bit (and (eq (len grouped) 3)
            (and (str_eq (fgtm-sample-id (head grouped))
                    "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth")
                (and (str_eq (fgtm-sample-id (nth grouped 1))
                        "model.qwen3-3b-form-router")
                    (str_eq (fgtm-sample-id (nth grouped 2))
                        "process.newest")))) 65536)
        (nmdocb-bit (and (str_eq (nmdoc-command-status orphanHealed) "healed")
            (and (str_eq (nmdoc-command-value orphanHealed) "orphan-lock")
                (and (eq (fs-exists? commandPath) 0)
                    (and (eq (fs-exists? leasePath) 0)
                        (eq (fs-exists? lockPath) 0))))) 131072))))
