; living-world-hypothesis-transfer-witness.fk -- a differentiated Recipe
; executes on identity-new bindings, crosses two independent membranes, and
; reaches an already learned content surface without receiving that exact
; context/output relation as a training example.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-shared-field-channel.fk form-stdlib/living-world-generative-continuation.fk form-stdlib/living-world-hypothesis-transfer.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk

(let LWHTRW-SOURCE-A (bp "LWHTRW-SOURCE-A"))
(let LWHTRW-SOURCE-B (bp "LWHTRW-SOURCE-B"))
(let LWHTRW-SOURCE-C (bp "LWHTRW-SOURCE-C"))
(let LWHTRW-SOURCE-D (bp "LWHTRW-SOURCE-D"))
(let LWHTRW-SOURCE-E (bp "LWHTRW-SOURCE-E"))
(let LWHTRW-SOURCE-F (bp "LWHTRW-SOURCE-F"))
(let LWHTRW-PROVENANCE (bp "LWHTRW-PROVENANCE"))
(let LWHTRW-RESPONSE-PROVENANCE (bp "LWHTRW-RESPONSE-PROVENANCE"))
(let LWHTRW-ACTION (bp "LWHTRW-ACTION"))
(let LWHTRW-REASON (bp "LWHTRW-REASON"))
(let LWHTRW-CONTEXT-A (bp "LWHTRW-CONTEXT-A"))
(let LWHTRW-CONTEXT-B (bp "LWHTRW-CONTEXT-B"))
(let LWHTRW-COORDINATE (bp "LWHTRW-COORDINATE"))
(let LWHTRW-SYMBOL-LENS (bp "LWHTRW-SYMBOL-LENS"))
(let LWHTRW-EVIDENCE (bp "LWHTRW-EVIDENCE"))
(let LWHTRW-ALTERNATIVE (bp "LWHTRW-ALTERNATIVE"))

(defn lwhtrw-entry (source payload)
    (lwt-entry
        (lwo-offer source (lwo-interface (list LWHTRW-ACTION)) 1
            payload LWHTRW-PROVENANCE 1)
        LWHTRW-ACTION))

(defn lwhtrw-response-entry (source proposal)
    (lwhtrw-entry source
        (lwt-response proposal
            (oac-one (lwt-proposal-candidate proposal))
            LWHTRW-RESPONSE-PROVENANCE)))

(defn lwhtrw-revoke-entry (source target)
    (lwhtrw-entry source
        (lwo-revocation target source LWHTRW-REASON LWHTRW-PROVENANCE)))

(defn lwhtrw-context ()
    (lwtf-context (list LWHTRW-CONTEXT-A LWHTRW-CONTEXT-B)))

(defn lwhtrw-alternatives ()
    (lwo-field (list LWHTRW-ALTERNATIVE)))

(defn lwhtrw-unknown ()
    (lwlc-unknown LWHTRW-EVIDENCE))

(defn lwhtrw-symbol-observation (output)
    (lwsl-observation-at output LWHTRW-COORDINATE "learned-content"
        LWHTRW-SYMBOL-LENS (oac-one output) LWHTRW-EVIDENCE))

(defn lwhtrw-offer (execution)
    (lwhtr-offer execution (lwhtrw-context) (lwo-none)
        (oac-one (lwht-execution-output execution))
        (lwhtrw-alternatives) (lwhtrw-unknown) LWHTRW-EVIDENCE))

(defn lwhtrw-request ()
    (lwsg-request (lwhtrw-context) (lwo-none) (lwo-none)
        (lwhtrw-alternatives) (lwhtrw-unknown) (lwo-none) (lwo-none)
        0 (lwo-none)))

(defn lwhtrw-run (started)
    (do
        ; The training example and two independently admitted probes are all
        ; different from the prospective application bindings.
        (let build-enter
            (lcfb-call-stream "living-world-hypothesis-transfer"
                "build-hypothesis-tissue" "enter" "form-native"
                "lwhtw-build-application" "identity-new-bindings" 1 started
                "form/form-stdlib/tests/living-world-hypothesis-transfer-witness.fk"
                68 13))
        (let application-fixture (lwhtw-build-application))
        (let base-world
            (lwhtw-application-world-cell application-fixture))
        (let application
            (lwhtw-application-minimal application-fixture))
        (let execution
            (lwhtw-application-minimal-execution application-fixture))
        (let output (lwht-execution-output execution))
        (let build-leave
            (lcfb-call-stream "living-world-hypothesis-transfer"
                "build-hypothesis-tissue" "leave" "form-native"
                "lwht-execution-for" "heldout-execution-current" 2 started
                "form/form-stdlib/tests/living-world-hypothesis-transfer-witness.fk"
                82 13))

        ; The output content already has a separately consented opaque surface.
        ; No target context/output relation has been offered yet.
        (let symbol-observation (lwhtrw-symbol-observation output))
        (let symbol-enter
            (lcfb-call-stream "living-world-hypothesis-transfer"
                "admit-content-surface" "enter" "form-native"
                "lwsl-integrate" "execution-output-content" 3 started
                "form/form-stdlib/tests/living-world-hypothesis-transfer-witness.fk"
                92 13))
        (let symbol-observed
            (lwt-receive-stream base-world
                (list
                    (lwhtrw-entry LWHTRW-SOURCE-A symbol-observation)
                    (lwhtrw-entry LWHTRW-SOURCE-B symbol-observation))))
        (let symbol-proposal
            (lwsl-proposal-for symbol-observed symbol-observation 2))
        (let symbol-round
            (lwt-round symbol-observed (lwo-field (list symbol-proposal))
                (lwo-empty-field) (lwo-none)))
        (let symbol-responded
            (lwt-round-receive symbol-round
                (list
                    (lwhtrw-response-entry LWHTRW-SOURCE-A symbol-proposal)
                    (lwhtrw-response-entry LWHTRW-SOURCE-B symbol-proposal))))
        (let symbol-integrated
            (lwsl-integrate symbol-responded symbol-proposal LWHTRW-ACTION))
        (let symbol-world (lwt-round-world symbol-integrated))
        (let symbol-candidate (lwt-proposal-candidate symbol-proposal))
        (let symbol-leave
            (lcfb-call-stream "living-world-hypothesis-transfer"
                "admit-content-surface" "leave" "form-native"
                "lwsl-integrate" "content-surface-current" 4 started
                "form/form-stdlib/tests/living-world-hypothesis-transfer-witness.fk"
                117 13))

        ; A distinct pair offers the held-out context and exact execution-to-
        ; context relation.  Recurrence alone creates only a proposal.
        (let transfer-offer (lwhtrw-offer execution))
        (let transfer-enter
            (lcfb-call-stream "living-world-hypothesis-transfer"
                "admit-transfer-plan" "enter" "form-native"
                "lwhtr-proposal-for" "current-execution-new-context" 5 started
                "form/form-stdlib/tests/living-world-hypothesis-transfer-witness.fk"
                127 13))
        (let transfer-observed
            (lwt-receive-stream symbol-world
                (list
                    (lwhtrw-entry LWHTRW-SOURCE-C LWHTRW-CONTEXT-A)
                    (lwhtrw-entry LWHTRW-SOURCE-D LWHTRW-CONTEXT-A)
                    (lwhtrw-entry LWHTRW-SOURCE-C LWHTRW-CONTEXT-B)
                    (lwhtrw-entry LWHTRW-SOURCE-D LWHTRW-CONTEXT-B)
                    (lwhtrw-entry LWHTRW-SOURCE-C (lwhtrw-context))
                    (lwhtrw-entry LWHTRW-SOURCE-D (lwhtrw-context))
                    (lwhtrw-entry LWHTRW-SOURCE-C transfer-offer)
                    (lwhtrw-entry LWHTRW-SOURCE-D transfer-offer))))
        (let transfer-proposal
            (lwhtr-proposal-for transfer-observed transfer-offer 2))
        (let transfer-plan
            (lwo-emergent-shape
                (lwt-proposal-candidate transfer-proposal)))
        (let transfer-round
            (lwt-round transfer-observed
                (lwo-field (list transfer-proposal))
                (lwo-empty-field) symbol-integrated))
        (let transfer-responded
            (lwt-round-receive transfer-round
                (list
                    (lwhtrw-response-entry LWHTRW-SOURCE-C transfer-proposal)
                    (lwhtrw-response-entry LWHTRW-SOURCE-D transfer-proposal))))
        (let transfer-integrated
            (lwhtr-integrate transfer-responded transfer-proposal
                LWHTRW-ACTION))
        (let transfer-world (lwt-round-world transfer-integrated))
        (let transfer-candidate
            (lwt-proposal-candidate transfer-proposal))
        (let transition-observation
            (lwhtr-transition-successor transfer-world transfer-candidate))
        (let before-transition
            (lwtf-proposal-for transfer-world transition-observation 2))
        (let transfer-leave
            (lcfb-call-stream "living-world-hypothesis-transfer"
                "admit-transfer-plan" "leave" "form-native"
                "lwhtr-integrate" "inert-transition-described" 6 started
                "form/form-stdlib/tests/living-world-hypothesis-transfer-witness.fk"
                168 13))

        ; A third pair independently re-offers and admits the described
        ; transition.  Only now can the held-out context reach native voice.
        (let transition-enter
            (lcfb-call-stream "living-world-hypothesis-transfer"
                "reoffer-generated-transition" "enter" "form-native"
                "lwtf-integrate" "independent-transition-membrane" 7 started
                "form/form-stdlib/tests/living-world-hypothesis-transfer-witness.fk"
                177 13))
        (let transition-observed
            (lwt-receive-stream transfer-world
                (list
                    (lwhtrw-entry LWHTRW-SOURCE-E transition-observation)
                    (lwhtrw-entry LWHTRW-SOURCE-F transition-observation))))
        (let transition-proposal
            (lwtf-proposal-for transition-observed transition-observation 2))
        (let transition-round
            (lwt-round transition-observed
                (lwo-field (list transition-proposal))
                (lwo-empty-field) transfer-integrated))
        (let transition-responded
            (lwt-round-receive transition-round
                (list
                    (lwhtrw-response-entry LWHTRW-SOURCE-E
                        transition-proposal)
                    (lwhtrw-response-entry LWHTRW-SOURCE-F
                        transition-proposal))))
        (let transition-integrated
            (lwtf-integrate transition-responded transition-proposal
                LWHTRW-ACTION))
        (let voiced-world (lwt-round-world transition-integrated))
        (let transition-candidate
            (lwt-proposal-candidate transition-proposal))
        (let prediction
            (lwtf-predict voiced-world (lwhtrw-context)
                (lwhtrw-alternatives) (lwhtrw-unknown)))
        (let expression-plan
            (lwtx-plan-for voiced-world prediction
                (lwo-field (list symbol-candidate))))
        (let trace
            (lwsg-generate-observed voiced-world (lwhtrw-request) started 8))
        (let transition-leave
            (lcfb-call-stream "living-world-hypothesis-transfer"
                "reoffer-generated-transition" "leave" "form-native"
                "lwsg-generate-observed" "heldout-native-voice" 12 started
                "form/form-stdlib/tests/living-world-hypothesis-transfer-witness.fk"
                215 13))

        ; Removing one transfer holder makes the transfer candidate stale, but
        ; cannot revoke the independently re-offered transition or its voice.
        (let boundary-enter
            (lcfb-call-stream "living-world-hypothesis-transfer"
                "observe-authority-boundary" "enter" "form-native"
                "lwo-revocation" "transfer-then-transition-support" 13 started
                "form/form-stdlib/tests/living-world-hypothesis-transfer-witness.fk"
                224 13))
        (let transfer-revoked-world
            (lwt-receive-stream voiced-world
                (list
                    (lwhtrw-revoke-entry LWHTRW-SOURCE-C transfer-offer))))
        (let transition-still-current
            (lwtf-integrated-current?
                transfer-revoked-world transition-candidate))
        (let trace-still-current
            (lwsg-trace-current? transfer-revoked-world trace))
        (let transition-revoked-world
            (lwt-receive-stream transfer-revoked-world
                (list
                    (lwhtrw-revoke-entry LWHTRW-SOURCE-E
                        transition-observation))))
        (let after-prediction
            (lwtf-predict transition-revoked-world (lwhtrw-context)
                (lwhtrw-alternatives) (lwhtrw-unknown)))
        (let after-trace
            (lwsg-generate transition-revoked-world (lwhtrw-request)))
        (let boundary-leave
            (lcfb-call-stream "living-world-hypothesis-transfer"
                "observe-authority-boundary" "leave" "form-native"
                "lwsg-generate" "independent-staleness-observed" 14 started
                "form/form-stdlib/tests/living-world-hypothesis-transfer-witness.fk"
                249 13))

        (list application-fixture application execution output base-world
              symbol-proposal symbol-candidate symbol-world transfer-offer
              transfer-observed transfer-proposal transfer-plan
              transfer-candidate transfer-world transition-observation
              before-transition transition-proposal transition-candidate
              voiced-world prediction expression-plan trace
              transfer-revoked-world transition-still-current
              trace-still-current transition-revoked-world after-prediction
              after-trace)))

(defn lwhtrw-verdict (r)
    (do
        (let application (nth r 1))
        (let execution (nth r 2))
        (let output (nth r 3))
        (let base-world (nth r 4))
        (let symbol-proposal (nth r 5))
        (let symbol-candidate (nth r 6))
        (let symbol-world (nth r 7))
        (let transfer-offer (nth r 8))
        (let transfer-observed (nth r 9))
        (let transfer-proposal (nth r 10))
        (let transfer-plan (nth r 11))
        (let transfer-candidate (nth r 12))
        (let transfer-world (nth r 13))
        (let transition-observation (nth r 14))
        (let before-transition (nth r 15))
        (let transition-proposal (nth r 16))
        (let transition-candidate (nth r 17))
        (let voiced-world (nth r 18))
        (let prediction (nth r 19))
        (let expression-plan (nth r 20))
        (let trace (nth r 21))
        (let transfer-revoked-world (nth r 22))
        (let transition-still-current (nth r 23))
        (let trace-still-current (nth r 24))
        (let transition-revoked-world (nth r 25))
        (let after-prediction (nth r 26))
        (let after-trace (nth r 27))
        (let nothing-offer
            (lwhtr-offer execution (lwhtrw-context) (lwo-none)
                (oac-nothing) (lwhtrw-alternatives) (lwhtrw-unknown)
                LWHTRW-EVIDENCE))
        (let zero-offer
            (lwhtr-offer execution (lwhtrw-context) (lwo-none)
                (oac-zero) (lwhtrw-alternatives) (lwhtrw-unknown)
                LWHTRW-EVIDENCE))
        (let alternative-offer
            (lwhtr-offer execution (lwhtrw-context) (lwo-none)
                (oac-alternative-ack execution LWHTRW-ALTERNATIVE
                    LWHTRW-EVIDENCE)
                (lwhtrw-alternatives) (lwhtrw-unknown) LWHTRW-EVIDENCE))
        (let incoherent-one
            (lwhtr-offer execution (lwhtrw-context) (lwo-none)
                (oac-one LWHTRW-ALTERNATIVE)
                (lwhtrw-alternatives) (lwhtrw-unknown) LWHTRW-EVIDENCE))
        (sum (list
            (if (eq (lwht-execution-current? base-world execution) 1) 1 0)
            (if (node_eq output (intern_trivial_int 7)) 2 0)
            (if (and (eq (oac-one?
                            (lwht-execution-immediate execution)) 1)
                     (node_eq (oac-payload
                                (lwht-execution-immediate execution))
                        output)) 4 0)
            (if (and (not (node_eq symbol-proposal (lwo-none)))
                     (eq (lwo-field-size
                            (lwt-proposal-participants symbol-proposal)) 2))
                8 0)
            (if (eq (lwsl-integrated-current?
                        symbol-world symbol-candidate) 1) 16 0)
            (if (node_eq
                    (lwnv-symbol-referent
                        (lwo-emergent-shape symbol-candidate)) output) 32 0)
            (if (eq (lwo-active? transfer-observed (lwhtrw-context)) 1) 64 0)
            (if (eq (lwhtr-offer-current?
                        transfer-observed transfer-offer) 1) 128 0)
            (if (eq (lwo-field-size
                        (lwhtr-sources transfer-observed transfer-offer)) 2)
                256 0)
            (if (and (not (node_eq transfer-proposal (lwo-none)))
                     (eq (lwo-field-size
                            (lwt-proposal-participants transfer-proposal)) 2))
                512 0)
            (if (and (node_eq
                        (lwtf-observation-context transition-observation)
                        (lwhtrw-context))
                     (and (node_eq
                            (lwtf-observation-next transition-observation)
                            output)
                          (node_eq
                            (lwtf-observation-lens transition-observation)
                            (lwo-none)))) 1024 0)
            (if (and (node_eq (lwhtr-plan-alternatives transfer-plan)
                                (lwhtrw-alternatives))
                     (node_eq (lwhtr-plan-unknown transfer-plan)
                                (lwhtrw-unknown))) 2048 0)
            (if (and (eq (lwhtr-offer-valid? nothing-offer) 1)
                     (node_eq (lwhtr-transition-for-offer nothing-offer)
                        (lwo-none))) 4096 0)
            (if (and (eq (lwhtr-offer-valid? zero-offer) 1)
                     (node_eq (lwhtr-transition-for-offer zero-offer)
                        (lwo-none))) 8192 0)
            (if (and (eq (lwhtr-offer-valid? alternative-offer) 1)
                     (and (node_eq
                            (lwhtr-transition-for-offer alternative-offer)
                            (lwo-none))
                          (eq (lwhtr-offer-valid? incoherent-one) 0)))
                16384 0)
            (if (eq (lwhtr-candidate-active?
                        transfer-world transfer-candidate) 1) 32768 0)
            (if (node_eq before-transition (lwo-none)) 65536 0)
            (if (eq (lwtf-integrated-current?
                        voiced-world transition-candidate) 1) 131072 0)
            (if (and (eq (lwtf-prediction-current?
                            voiced-world prediction) 1)
                     (and (eq (lwo-field-size
                                (lwtf-prediction-derivations prediction)) 1)
                          (node_eq
                            (lwtf-derivation-next
                                (head (lwo-field-items
                                    (lwtf-prediction-derivations prediction))))
                            output))) 262144 0)
            (if (and (eq (lwtx-plan-current?
                            voiced-world expression-plan) 1)
                     (and (eq (lwo-field-size
                                (lwtx-plan-surfaces expression-plan)) 1)
                          (and (eq (lwo-field-size
                                    (lwtx-plan-unvoiced expression-plan)) 0)
                               (eq (oac-one?
                                    (lwtx-plan-ack expression-plan)) 1))))
                524288 0)
            (if (and (eq (lwsg-trace-current? voiced-world trace) 1)
                     (eq (len (lwsg-turn-items
                                (lwsg-trace-turns trace))) 1)) 1048576 0)
            (if (and (node_eq (lwsg-turn-emitted
                                (head (lwsg-turn-items
                                    (lwsg-trace-turns trace)))) output)
                     (and (eq (oac-one? (lwsg-trace-ack trace)) 1)
                          (and (gt (str_len
                                    (lwsg-trace-rendered trace)) 0)
                               (eq (lwsg-completion?
                                    (lwsg-trace-completion trace)
                                    LWSG-TERMINAL) 1)))) 2097152 0)
            (if (and (eq (lwhtr-candidate-active?
                            transfer-revoked-world transfer-candidate) 0)
                     (and (node_eq (lwhtr-transition-successor
                                    transfer-revoked-world transfer-candidate)
                                    (lwo-none))
                          (eq transition-still-current 1))) 4194304 0)
            (if (and (eq trace-still-current 1)
                     (eq (lwsg-trace-current?
                            transfer-revoked-world trace) 1)) 8388608 0)
            (if (and (eq (lwtf-integrated-current?
                            transition-revoked-world transition-candidate) 0)
                     (and (eq (oac-nothing?
                                (lwtf-prediction-ack after-prediction)) 1)
                          (and (eq (len (lwsg-turn-items
                                        (lwsg-trace-turns after-trace))) 0)
                               (eq (lwsg-trace-current?
                                    transition-revoked-world trace) 0))))
                16777216 0)))))
