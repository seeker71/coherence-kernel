; form-cli-build-band.bml — the native form-cli's source identity, attestations, publication lock, platform name, proof helpers and roots
; (form-stdlib/bml/form-cli-build.bml, form-cli-build-flow.bml, form-cli-prove.bml; the door gate/form-cli-build-run.bml). The build itself is
; the drift gate's form-cli-build row (it builds a copy in a private body and proves it by identity); this band holds what that row cannot
; say by passing: the identity folds against independent answers, every way an attestation can be wrong, the lock's refusals.
;
; Expected: 262143
; Verdict 262143 when every claim lands:
;   1     identity: the body's fingerprint of "" and "foobar" are FNV-1a 64's published answers (cbf29ce484222325, 85944171f73967e8); the
;         source fold of a.txt "alpha\nbeta\n" and b.txt "gamma" is 3359cbe6968324be through the CPU's lane and in the Form recipe alike;
;         the same files with CRLF endings are other bytes and another identity, and a tree missing a listed file has no identity
;   2     the closure door agrees: the seal it writes for the same two files holds a source.id equal to the fold of its manifest and those files
;   4     attestations hold: a startup attestation and a platform attestation written for real files verify; a startup file, a runtime source,
;         an executable, an image, a symbol file, a bootstrap attestation, a source identity, a slug or an author identity that is not the
;         one attested each fails verification
;   8     attestations are well formed: a duplicate key, an empty value, an unknown key, an identity that is not 16 lowercase hex (a 64-hex
;         SHA-256 digest among them), a missing key, a key of the other schema, no `=` on a line, a symbolic link in the file's place and an
;         absent file are each no attestation
;   16    platform: Darwin arm64 is darwin-arm64, Linux x86_64 and amd64 are linux-amd64, aarch64 is arm64, MINGW/MSYS/CYGWIN are windows-, any
;         other system keeps its own name; this host answers a slug of letters, digits, dots, underscores and hyphens
;   32    lock: the first publisher holds it; a second is refused 75 naming the owner's pid; a lock with no owner file, one whose owner is no
;         number and one whose owner has stopped are each refused 75 and never reclaimed; a released lock is held again
;   64    proof helpers: the expected carrier-id and carrier-challenge lines carry the source identity; the first line with a prefix is found
;         among others; a slashless name is run from the working directory; a missing executable and one that answers nothing are each named
;         with the line they should have said; the door's prove of a missing executable ends in an error naming it
;   128   roots: form-stdlib/form-cli-source-roots.txt lists 150 or more paths, each unique and standing, none a shell or python script, with
;         the three build organs, the door, the roots file itself and the closure door among them
;   256   the gate reads the Form door: the drift gates' form-cli-build row runs gate/form-cli-build-run.bml and names no shell script
;   512   no shell: no tracked file under form/scripts, no form/build-form-cli.sh
;   1024  plant: a published source identity that is not the sources' reads the tree as not current: the identity file decides
;   2048  plant: an attestation of an executable whose bytes were changed still parses as an attestation (fcb-att-load) and fails verification:
;         claim 4's refusal is the identity comparison, not the shape
;   4096  strict: the door run as a child on `{bad json`, a typo'd key, a key of the wrong kind and a JSON array ends in exit 1 with a named
;         refusal (`form-cli-build: unknown key "rgen"`, ...) and never begins the default install (no regeneration, no private build)
;   8192  plant: a request that reads (a prove of a missing executable) is not refused by the reader but answered by the flow: claim 4096's
;         refusal is the reader's, not a general failure
;   16384 the seed doors that ended cp, chmod, ln -s, test -L, env, printenv and uname: fcb-copy keeps the bytes and the mode and refuses a
;         directory, a link and a path that is not there; fcb-chmod reads "700" as 448 and "600" as 384, "+x" gives execute wherever
;         read stands (644 reads 755, 600 reads 700), and refuses digits that are not octal and a path that is not there; the
;         symlink test is true for a link and false for a file, a directory and a missing path; a child begins in the directory
;         the spawn door names (hch-run-at: it reads a unit there by its bare name); the machine is read from an executable header (Mach-O arm64 and x86_64, ELF x86_64 and
;         aarch64 named, a short head and an unknown magic read "unknown") and this host's slug is its kernel's name and that machine
;   32768 the oversize fixture the proof builds (17 MiB of zero bytes, once made by dd) is written by Form in 64 KiB slices (host_pwrite):
;         its size is 17825792, its first, middle and last bytes are zero, a second making replaces the first whole, and it takes
;         under 30 s (making the whole string in Form first took 31 s on a loaded host)
;   65536 copy-identity: a copy published away from the bootstrap (fcb-copy-out, the `out` request an image build makes) lands its source
;         identity beside it as <out>.source.id — one line, the identity the copy answers, the same line the bootstrap's form-cli.source.id
;         holds — next to the image, the symbols and the platform attestation, with no staging file left behind
;   131072 source-id: the door run as a child on {"source_id":1} answers one line of 16 hex — the identity the sources fold to
;         right now — exits 0, builds nothing, and leaves no form-cli-identity work directory behind
;
; REQUIRES: the built ./fkwu with the host doors (host_chmod host_symlink host_getenv host_os host_file_copy host_file_mode host_realpath host_pwrite host_mkdir_mode, runtime/fkwu-uni.c leaf-door modes 35-49) and the body root as the working directory.
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/form-cli-build-flow.bml form-stdlib/bml/form-cli-prove.bml
section [form.bml] {
 class FormCliBuildBand {
  def fbb-fresh() {
   let root = temp_dir() ++ "/form-cli-build-band-" ++ now_unix_ms().str();
   (Comparable) host_dir_mkdir(root) == 1 ? ["build", root, 0] : nothing();
  }
  def fbb-root(ctx) = ctx[1];
  def fbb-h(c) = fcb-has?(c, "");
  // ---- 1 identity
  def fbb-two(ctx, name, a, b) {
   let dir = fbb-root(ctx) ++ "/" ++ name;
   let made = hch-mkdirs(dir);
   let w = write_file(dir ++ "/a.txt", a) + write_file(dir ++ "/b.txt", b);
   dir;
  }
  def fbb-c-identity(ctx) {
   let lf = fbb-two(ctx, "lf", "alpha\nbeta\n", "gamma");
   let crlf = fbb-two(ctx, "crlf", "alpha\r\nbeta\r\n", "gamma");
   let gone = fbb-two(ctx, "gone", "alpha\nbeta\n", "gamma");
   (String) fcb-id("") == "cbf29ce484222325" && (String) fcb-id("foobar") == "85944171f73967e8"
   && (String) fcb-source-id(fcb-read-sources(lf, ["a.txt", "b.txt"])) == "3359cbe6968324be"
   && (String) bml-source-fingerprint("path:a.txt\nbytes:11\nalpha\nbeta\n\npath:b.txt\nbytes:5\ngamma\n") == "3359cbe6968324be"
   && (String) (fcb-source-id(fcb-read-sources(crlf, ["a.txt", "b.txt"])) ?? "") != "3359cbe6968324be"
   && nothing?(fcb-source-id(fcb-read-sources(gone, ["a.txt", "zzz.txt"])));
  }
  // ---- 2 the closure door agrees
  def fbb-c-closure(ctx) {
   let dir = fbb-two(ctx, "sealed", "alpha\nbeta\n", "gamma");
   let seal = fbb-root(ctx) ++ "/seal";
   let run = fcb-ask(fbb-root(ctx), "closure", "./fkwu", ["FCSC1", dir, seal, "a.txt", "b.txt"]);
   let manifest = read_file(seal ++ "/form-cli.dependencies") ?? "";
   let rows = [[fcb-manifest-rel(), manifest], ["a.txt", "alpha\nbeta\n"], ["b.txt", "gamma"]];
   hch-ok?(run) && (String) manifest == "a.txt\nb.txt\n" && (String) fcb-trim-file(seal ++ "/source.id") == (String) fcb-source-id(rows);
  }
  // ---- 4 attestations hold
  def fbb-files(ctx, name) {
   let dir = fbb-root(ctx) ++ "/" ++ name;
   let made = hch-mkdirs(dir);
   let w = write_file(dir ++ "/startup.c", "int main(void){return 0;}\n") + write_file(dir ++ "/runtime.c", "/* runtime */\n") + write_file(dir ++ "/form-cli", "binary one") + write_file(dir ++ "/form-cli.fkb", "image one") + write_file(dir ++ "/form-cli.sym", "symbols one");
   dir;
  }
  def fbb-id() = "3359cbe6968324be";
  def fbb-author() = "af63dc4c8601ec8c";
  def fbb-written(ctx, name) {
   let d = fbb-files(ctx, name);
   let a = fcb-write-startup(d ++ "/boot.attestation", fbb-id(), d ++ "/startup.c", fbb-author(), d ++ "/runtime.c");
   let b = fcb-write-platform(d ++ "/platform.attestation", d ++ "/boot.attestation", "darwin-arm64", d ++ "/form-cli", d ++ "/form-cli.fkb", d ++ "/form-cli.sym");
   [d, a, b];
  }
  def fbb-v-start(d, id, author) = fcb-verify-startup(d ++ "/boot.attestation", id, d ++ "/startup.c", d ++ "/runtime.c", author);
  def fbb-v-plat(d, id, slug) = fcb-verify-platform(d ++ "/platform.attestation", id, d ++ "/boot.attestation", slug, d ++ "/form-cli", d ++ "/form-cli.fkb", d ++ "/form-cli.sym");
  def fbb-c-attest(ctx) {
   let w = fbb-written(ctx, "att");
   let d = w[0];
   let good = w[1] && w[2] && fbb-v-start(d, fbb-id(), fbb-author()) && fbb-v-start(d, fbb-id(), "") && fbb-v-plat(d, fbb-id(), "darwin-arm64");
   let wrong = !fbb-v-start(d, fbb-author(), "") && !fbb-v-start(d, fbb-id(), fbb-id())
    && !fbb-v-plat(d, fbb-author(), "darwin-arm64") && !fbb-v-plat(d, fbb-id(), "linux-amd64");
   let t1 = write_file(d ++ "/startup.c", "int main(void){return 1;}\n");
   let startup-bad = !fbb-v-start(d, fbb-id(), "");
   let t2 = write_file(d ++ "/startup.c", "int main(void){return 0;}\n") + write_file(d ++ "/runtime.c", "/* other */\n");
   let runtime-bad = !fbb-v-start(d, fbb-id(), "");
   let t3 = write_file(d ++ "/runtime.c", "/* runtime */\n") + write_file(d ++ "/form-cli", "binary two");
   let binary-bad = !fbb-v-plat(d, fbb-id(), "darwin-arm64");
   let t4 = write_file(d ++ "/form-cli", "binary one") + write_file(d ++ "/form-cli.fkb", "image two");
   let image-bad = !fbb-v-plat(d, fbb-id(), "darwin-arm64");
   let t5 = write_file(d ++ "/form-cli.fkb", "image one") + write_file(d ++ "/form-cli.sym", "symbols two");
   let symbols-bad = !fbb-v-plat(d, fbb-id(), "darwin-arm64");
   let t6 = write_file(d ++ "/form-cli.sym", "symbols one");
   let again = fbb-v-plat(d, fbb-id(), "darwin-arm64");
   let t7 = write_file(d ++ "/boot.attestation", fcb-att-text(fcb-startup-pairs(fbb-id(), fcb-id("int main(void){return 0;}\n"), fbb-author(), fcb-id("/* runtime */\n"))) ++ "x=y\n");
   let boot-moved = !fbb-v-plat(d, fbb-id(), "darwin-arm64");
   good && wrong && startup-bad && runtime-bad && binary-bad && image-bad && symbols-bad && again && boot-moved;
  }
  // ---- 8 well formed
  def fbb-pairs-text(pairs) = fcb-att-text(pairs);
  def fbb-load(ctx, name, text) {
   let path = fbb-root(ctx) ++ "/wf-" ++ name;
   let w = write_file(path, text);
   fcb-att-load(path);
  }
  def fbb-start-pairs() = fcb-startup-pairs(fbb-id(), fbb-id(), fbb-author(), fbb-id());
  def fbb-plat-pairs() = fcb-platform-pairs(fbb-id(), fbb-id(), "darwin-arm64", fbb-id(), fbb-id(), fbb-id());
  def fbb-set(pairs, key, value) = map(p => (String) p[0] == key ? [key, value] : p, pairs);
  def fbb-drop(pairs, key) = filter(p => (String) p[0] != key, pairs);
  def fbb-c-wellformed(ctx) {
   !nothing?(fbb-load(ctx, "start-ok", fcb-att-text(fbb-start-pairs()))) && !nothing?(fbb-load(ctx, "plat-ok", fcb-att-text(fbb-plat-pairs())))
   && nothing?(fbb-load(ctx, "dup", fcb-att-text(append(fbb-start-pairs(), [["source_id", fbb-id()]]))))
   && nothing?(fbb-load(ctx, "empty", fcb-att-text(fbb-set(fbb-start-pairs(), "startup_id", ""))))
   && nothing?(fbb-load(ctx, "unknown", fcb-att-text(append(fbb-start-pairs(), [["extra", "x"]]))))
   && nothing?(fbb-load(ctx, "short", fcb-att-text(fbb-set(fbb-start-pairs(), "startup_id", "abc123"))))
   && nothing?(fbb-load(ctx, "upper", fcb-att-text(fbb-set(fbb-start-pairs(), "startup_id", "3359CBE6968324BE"))))
   && nothing?(fbb-load(ctx, "sha256", fcb-att-text(fbb-set(fbb-start-pairs(), "startup_id", "1914bf8333f4ca954e0be72cbfbc84356008db90d98466ff6ff610abf8ba055f"))))
   && nothing?(fbb-load(ctx, "missing", fcb-att-text(fbb-drop(fbb-start-pairs(), "runtime_source_id"))))
   && nothing?(fbb-load(ctx, "other-schema", fcb-att-text(append(fbb-set(fbb-start-pairs(), "schema", fcb-schema-platform()), []))))
   && nothing?(fbb-load(ctx, "plat-start-key", fcb-att-text(append(fbb-plat-pairs(), [["startup_id", fbb-id()]]))))
   && nothing?(fbb-load(ctx, "plat-slug", fcb-att-text(fbb-set(fbb-plat-pairs(), "platform_slug", "darwin/arm64"))))
   && nothing?(fbb-load(ctx, "no-equals", "schema=form-cli-native-attestation-v2\nthis line has none\n"))
   && nothing?(fbb-load(ctx, "empty-file", ""))
   && nothing?(fcb-att-load(fbb-root(ctx) ++ "/wf-absent")) && fbb-symlink-refused(ctx);
  }
  def fbb-symlink-refused(ctx) {
   let real = fbb-root(ctx) ++ "/wf-real";
   let link = fbb-root(ctx) ++ "/wf-link";
   let w = write_file(real, fcb-att-text(fbb-start-pairs()));
   let made = host_symlink(real, link);
   (Comparable) made == 0 && !nothing?(fcb-att-load(real)) && nothing?(fcb-att-load(link));
  }
  // ---- 16 platform
  def fbb-c-platform(ctx) {
   (String) fcb-slug-of("Darwin", "arm64") == "darwin-arm64" && (String) fcb-slug-of("Linux", "x86_64") == "linux-amd64" && (String) fcb-slug-of("linux", "amd64") == "linux-amd64"
   && (String) fcb-slug-of("Linux", "aarch64") == "linux-arm64" && (String) fcb-slug-of("MINGW64_NT-10.0", "x86_64") == "windows-amd64" && (String) fcb-slug-of("MSYS_NT", "arm64") == "windows-arm64"
   && (String) fcb-slug-of("CYGWIN_NT", "x86_64") == "windows-amd64" && (String) fcb-slug-of("FreeBSD", "amd64") == "freebsd-amd64" && fcb-slug-valid?(fcb-platform-slug())
   && !fcb-slug-valid?("") && !fcb-slug-valid?("a/b") && !fcb-slug-valid?("a b");
  }
  // ---- 32 lock
  def fbb-c-lock(ctx) {
   let base = fbb-root(ctx) ++ "/locks";
   let made = hch-mkdirs(base);
   let held = fcb-lock-acquire(base ++ "/one");
   let second = fcb-lock-acquire(base ++ "/one");
   let released = fcb-lock-release(base ++ "/one");
   let again = fcb-lock-acquire(base ++ "/one");
   let ownerless = hch-mkdirs(base ++ "/two");
   let r2 = fcb-lock-acquire(base ++ "/two");
   let mal = hch-mkdirs(base ++ "/three");
   let w3 = write_file(base ++ "/three/owner.pid", "not a pid\n");
   let r3 = fcb-lock-acquire(base ++ "/three");
   let child = host_spawn_at(["/usr/bin/true"], ["/dev/null", "/dev/null", "/dev/null"]);
   let waited = host_wait(child);
   let stopped = hch-mkdirs(base ++ "/four");
   let w4 = write_file(base ++ "/four/owner.pid", child.str() ++ "\n");
   let r4 = fcb-lock-acquire(base ++ "/four");
   held[0] == 0 && second[0] == 75 && fcb-has?(second[1], "another publisher owns") && fcb-has?(second[1], "(pid " ++ host_pid().str() ++ ")") && again[0] == 0
   && r2[0] == 75 && fcb-has?(r2[1], "initialising or ownerless") && r3[0] == 75 && fcb-has?(r3[1], "malformed owner") && r4[0] == 75 && fcb-has?(r4[1], "names stopped pid " ++ child.str()) && fcb-has?(r4[1], "manual recovery required");
  }
  // ---- 64 proof helpers
  def fbb-c-proof(ctx) {
   let id = fbb-id();
   let said = "noise\ncarrier-id|form-cli-carrier-v3|" ++ id ++ "|coherence-kernel-fkwu-native-v2\nmore\n";
   let nobody = fbb-root(ctx) ++ "/nobody";
   let none = fcb-verify-identity("/usr/bin/true", id, fbb-root(ctx));
   let missing = fcb-verify-identity(nobody, id, fbb-root(ctx));
   (String) fcb-expected-id(id) == "carrier-id|form-cli-carrier-v3|" ++ id ++ "|coherence-kernel-fkwu-native-v2"
   && (String) fcb-expected-challenge(id) == "carrier-challenge-v2|" ++ id ++ "|000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f|c37f590285082c72"
   && (String) fcb-known-digest() == bml-source-fingerprint("form-cli-carrier-challenge-v2\n" ++ fcb-nonce())
   && (String) fcb-first-with(said, "carrier-id|") == fcb-expected-id(id) && (String) fcb-first-with(said, "absent|") == ""
   && (String) fcb-binary-path("form-cli") == "./form-cli" && (String) fcb-binary-path("/x/form-cli") == "/x/form-cli" && (String) fcb-binary-path("sub/form-cli") == "sub/form-cli"
   && fcb-has?(none, "carrier-id mismatch") && fcb-has?(none, "want=" ++ fcb-expected-id(id)) && fcb-has?(missing, "binary is missing or not executable")
   && fbb-door-refuses(ctx);
  }
  def fbb-door-refuses(ctx) {
   let base = fbb-root(ctx) ++ "/door";
   let w = write_file(base ++ ".in", "{\"prove\":\"" ++ fbb-root(ctx) ++ "/nobody\",\"id\":\"" ++ fbb-id() ++ "\"}");
   let pid = host_spawn_at(["./fkwu", "gate/form-cli-build-run.bml"], [base ++ ".in", base ++ ".out", base ++ ".err"]);
   let status = pid <= 0 ? -1 : host_wait(pid);
   (Comparable) status != 0 && fcb-has?(read_file(base ++ ".out") ?? "", "binary is missing or not executable") && fcb-has?(read_file(base ++ ".err") ?? "", "form-cli-build:");
  }
  // ---- 128 roots
  def fbb-roots() = fcb-lines(read_file("form/form-stdlib/form-cli-source-roots.txt") ?? "");
  def fbb-dup?(xs) = nil?(xs) ? false : cw-in?(xs[1:], xs[0]) || fbb-dup?(xs[1:]);
  def fbb-c-roots(ctx) {
   let roots = fbb-roots();
   len(roots) >= 150 && !fbb-dup?(roots) && all?(r => (Comparable) file_size("form/" ++ r) >= 0, roots)
   && !any?(r => fcb-ends?(r, ".sh") || fcb-ends?(r, ".py"), roots)
   && cw-in?(roots, "form-stdlib/bml/form-cli-build.bml") && cw-in?(roots, "form-stdlib/bml/form-cli-build-flow.bml") && cw-in?(roots, "form-stdlib/bml/form-cli-prove.bml")
   && cw-in?(roots, "../gate/form-cli-build-run.bml") && cw-in?(roots, "form-stdlib/form-cli-source-roots.txt") && cw-in?(roots, "form-stdlib/bml/form-cli-source-closure.bml")
   && cw-in?(roots, "../runtime/fkwu-uni.c") && cw-in?(roots, "form-stdlib/form-cli-repl.fk");
  }
  // ---- 256 the gate
  def fbb-c-gate(ctx) {
   let text = read_file("gate/drift-gates.bml") ?? "";
   let at = str_find(text, "dg-row(\"form-cli-build\"", 0);
   let line = at < 0 ? "" : substring(text, at, str_find(text, "\n", at));
   at >= 0 && fcb-has?(line, "gate/form-cli-build-run.bml") && !fcb-has?(line, ".sh");
  }
  // ---- 512 no shell
  def fbb-c-noshell(ctx) {
   let listed = hch-read(["git", "ls-files", "--", "form/scripts", "form/build-form-cli.sh"]);
   (String) listed == "" && (Comparable) file_size("form/build-form-cli.sh") < 0;
  }
  // ---- 4096 a request that does not read is refused before any flow (never the default install, which regenerates for minutes)
  def fbb-door-run(ctx, name, request) {
   let base = fbb-root(ctx) ++ "/" ++ name;
   let w = write_file(base ++ ".in", request);
   let pid = host_spawn_at(["./fkwu", "gate/form-cli-build-run.bml"], [base ++ ".in", base ++ ".out", base ++ ".err"]);
   let status = pid <= 0 ? -1 : host_wait(pid);
   [status, read_file(base ++ ".out") ?? "", read_file(base ++ ".err") ?? ""];
  }
  def fbb-refused?(run, word) = (Comparable) run[0] == 1 && fcb-has?(run[1], "form-cli-build: " ++ word) && !fcb-has?(run[1], "regenerating") && !fcb-has?(run[1], "building the copy");
  def fbb-c-strict(ctx) {
   let t0 = host_monotonic_ms();
   let bad = fbb-door-run(ctx, "s-bad", "{bad json");
   let typo = fbb-door-run(ctx, "s-typo", "{\"rgen\":1}");
   let kind = fbb-door-run(ctx, "s-kind", "{\"retain\":\"x\"}");
   let array = fbb-door-run(ctx, "s-array", "[1]");
   fbb-refused?(bad, "stdin is not well-formed JSON") && fbb-refused?(typo, "unknown key \"rgen\"") && fbb-refused?(kind, "key \"retain\" must be an integer") && fbb-refused?(array, "stdin must be one JSON object")
   && host_monotonic_ms() - t0 < 120000;
  }
  // ---- 16384 the doors that replaced the borrowed programs
  def fbb-mode(path) = host_file_mode(path) % 4096;
  def fbb-head(bytes) = str-spans(map(b => byte_to_str(b), append(bytes, map(i => 0, range(0, 32 - len(bytes))))));
  def fbb-c-doors(ctx) {
   let dir = fbb-root(ctx) ++ "/doors";
   let made = hch-mkdirs(dir);
   let put = write_file(dir ++ "/src", "bytes\n");
   let m1 = host_chmod(dir ++ "/src", 420);
   let copied = fcb-copy(dir ++ "/src", dir ++ "/dst");
   let kept = (String) (read_file(dir ++ "/dst") ?? "x") == "bytes\n" && (Comparable) fbb-mode(dir ++ "/dst") == 420;
   let plus = fcb-chmod("+x", dir ++ "/dst") && (Comparable) fbb-mode(dir ++ "/dst") == 493;
   let seven = fcb-chmod("700", dir ++ "/dst") && (Comparable) fbb-mode(dir ++ "/dst") == 448;
   let six = fcb-chmod("600", dir ++ "/dst") && (Comparable) fbb-mode(dir ++ "/dst") == 384;
   let plus-private = fcb-chmod("+x", dir ++ "/dst") && (Comparable) fbb-mode(dir ++ "/dst") == 448;
   let refused = !fcb-chmod("789", dir ++ "/dst") && !fcb-chmod("", dir ++ "/dst") && !fcb-chmod("700", dir ++ "/nobody") && !fcb-chmod("+x", dir ++ "/nobody");
   let link = host_symlink(dir ++ "/src", dir ++ "/link");
