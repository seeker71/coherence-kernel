  }
  // ---- plants
  def fbb-c-plant-reads(ctx) {
   let run = fbb-door-run(ctx, "p-reads", "{\"prove\":\"" ++ fbb-root(ctx) ++ "/nobody\",\"id\":\"" ++ fbb-id() ++ "\"}");
   (Comparable) run[0] != 0 && fcb-has?(run[1], "binary is missing or not executable") && !fcb-has?(run[1], "unknown key") && !fcb-has?(run[1], "not well-formed");
