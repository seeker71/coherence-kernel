// Pure request and effective-scope boundaries; no provider or state writes.
// preludes: form-stdlib/bml/form-cli-provider-session.bml form-stdlib/bml/form-cli-provider-worker.bml
section [form.bml] {
 let request = parse-json("request","{\"allowed\":true,\"root\":\"/owned\",\"cwd\":\"/owned/work\",\"prompt\":\"Review one native cell\",\"seconds\":30,\"dry_run\":true}");
 let config = parse-json("config","{\"cwd\":\"/owned/work\",\"approvalPolicy\":\"never\",\"runtimeWorkspaceRoots\":[\"/owned/work\"],\"sandbox\":{\"type\":\"workspaceWrite\",\"writableRoots\":[],\"networkAccess\":false}}");
 if not(and(fps-valid(request),fpw-config-valid(request,config))) then form_error("valid owned scope failed") else 0;
 if fps-valid(oh-set(request,"allowed",json-node-int(1))) then form_error("numeric permission accepted") else 0;
 if fps-valid(oh-set(request,"seconds",json-node-int(0))) then form_error("unbounded provider accepted") else 0;
 if fps-valid(oh-set(request,"dry_run",json-node-string("true"))) then form_error("ambiguous dry-run could start generation") else 0;
 if or(fps-absolute("/owned/../elsewhere"),fps-absolute("/owned/./work")) then form_error("noncanonical path accepted") else 0;
 if fpw-config-valid(request,oh-set(config,"cwd",json-node-string("/other"))) then form_error("changed effective cwd accepted") else 0;
 if fpw-config-valid(request,oh-set(config,"approvalPolicy",json-node-string("on-request"))) then form_error("changed approval policy accepted") else 0;
 if fpw-config-valid(request,oh-set(config,"runtimeWorkspaceRoots",json-node-array(list(json-node-string("/owned/work"),json-node-string("/other"))))) then form_error("extra runtime root accepted") else 0;
 let networked = oh-set(config,"sandbox",oh-set(json-object-get(config,"sandbox"),"networkAccess",json-node-bool(1)));
 if fpw-config-valid(request,networked) then form_error("network-enabled scope accepted") else 0;
 let extraWrites = oh-set(config,"sandbox",oh-set(json-object-get(config,"sandbox"),"writableRoots",json-node-array(list(json-node-string("/other")))));
 if fpw-config-valid(request,extraWrites) then form_error("additional writable root accepted") else 0;
 if not(str_eq(fpw-exit-kind(parse-json("exit","{\"exitCode\":null}")),"unknown")) then form_error("missing exit counted as observed failure") else 0;
 if not(str_eq(fpw-exit-kind(parse-json("exit","{\"exitCode\":-1}")),"failure")) then form_error("negative exit lost its observed failure") else 0;
 if not(str_eq(fpw-exit-kind(parse-json("exit","{\"exitCode\":0}")),"success")) then form_error("zero exit lost its observed success") else 0;
 if fps-summary-intact(json-node-object(list())) then form_error("unsealed summary accepted") else 0;
 if fps-packet-valid("{\"allowed\":true") then form_error("truncated request accepted") else 0;
 if not(fps-packet-valid(json-emit(request))) then form_error("complete request refused") else 0;
 1;
}
