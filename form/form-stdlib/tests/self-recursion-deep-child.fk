; self-recursion-deep-child.fk -- the other process of loop-lane-self-recursion-band's bit 8: a non-tail self recursion
; heated shallow until the lane compiles it, then asked to nest two million deep. Past the walker's stack wall the
; compiled recursion stops the run as the walker does -- "eval too deep", exit 1 -- where it once crashed (exit 138).
; preludes: form-stdlib/core.fk
(defn srd-depth (xs) (if (nil? xs) 0 (add 1 (srd-depth (tail xs)))))
(defn srd-heat (k acc) (if (le k 0) acc (srd-heat (sub k 1) (add acc (srd-depth (list 1 2 3 4 5 6 7 8))))))
(let heated (srd-heat 3000 0))
(defn srd-mk (n acc) (if (le n 0) acc (srd-mk (sub n 1) (cons n acc))))
(print (srd-depth (srd-mk 2000000 (list))))
