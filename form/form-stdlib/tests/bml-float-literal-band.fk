; bml-float-literal-band.fk -- a decimal float literal written in .bml arrives
; in Form as the same float.
;
; Witnessed 2026-09-04 on fkwu (ledger R76): `def t() = list("x", 1.0, 0.5);
; len(t());` answered 1 with exit 0, and the lowered text beside it read
; `(defn t () (list "x"  ))` -- both floats had become empty arguments. The
; line compiler interned them correctly (intern_trivial_float); the source
; emitter rendered every non-string leaf through int_to_str, whose digit walk
; hands a float to byte_to_str and answers "". The int control `list("x", 1,
; 5)` answered 3. A silent wrong answer, the axiom-5 class.
;
; Every check here reads a value the fixture's .bml defines. Only natives
; below (eq, len, nth, add, value_eq), so no prelude but the fixture itself
; can confound the verdict.
;
; preludes: form-stdlib/tests/bml-float-literal-fixture.bml
;
; Expected: 2047
;
; bit    1  list of floats has length 3 (the wound's own repro)
; bit    2  a float def body returns 0.5 itself
; bit    4  a float call argument arrives intact (0.5 through an identity def)
; bit    8  a negative float literal (-2.25)
; bit   16  a float inside a nested list, list shape intact
; bit   32  the int path is unchanged (length 3, third element 5)
; bit   64  a float in a comparison (eq against 1.5 chooses the right arm)
; bit  128  a float in a block `let` carries to the block's value
; bit  256  a class field default holds its float (0.125)
; bit  512  floats add (0.5 + 0.25 = 0.75)
; bit 1024  1.0 stays a FLOAT, not the int 1 (value_eq tells them apart)

(do
    (defn bflb-bit (ok bit) (if ok bit 0))
    (defn bml-float-literal-band ()
        (add (bflb-bit (eq (len (bfl-floats)) 3) 1)
        (add (bflb-bit (eq (bfl-half) 0.5) 2)
        (add (bflb-bit (eq (bfl-passed) 0.5) 4)
        (add (bflb-bit (eq (bfl-neg) -2.25) 8)
        (add (bflb-bit (and (eq (len (bfl-nested)) 3)
                            (and (eq (len (nth (bfl-nested) 1)) 2)
                                 (eq (nth (nth (bfl-nested) 1) 1) 0.75))) 16)
        (add (bflb-bit (and (eq (len (bfl-ints)) 3) (eq (nth (bfl-ints) 2) 5)) 32)
        (add (bflb-bit (and (eq (bfl-compare 1.5) 1) (eq (bfl-compare 1.25) 0)) 64)
        (add (bflb-bit (eq (bfl-block) 3.75) 128)
        (add (bflb-bit (eq (bfl-default) 0.125) 256)
        (add (bflb-bit (eq (bfl-sum) 0.75) 512)
             (bflb-bit (and (eq (nth (bfl-floats) 1) 1.0)
                            (eq (value_eq (nth (bfl-floats) 1) 1) 0)) 1024))))))))))))
    (bml-float-literal-band))

; witnessed: 2026-09-04 -> 2047
