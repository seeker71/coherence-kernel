; form-program-image-bmf-request-birth-band.fk -- adversarial proof that raw
; scannerless frame bytes cross the admitted full-PIF call before exact
; category-98 request birth.
; Expected: 1048575
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-program-image-bmf-request-birth.fk
; preludes: form-stdlib/form-nodeid-knowledge-query.fk

(do
    (defn fpbrb-bit (held weight) (if held weight 0))
    (defn fpbrb-repeat (s count)
        (if (le count 0) ""
            (str_concat s (fpbrb-repeat s (sub count 1)))))
    (defn fpbrb-status (receipt)
        (if (fpcpf-receipt? receipt)
            (fpcp-ack-status (fpcpf-receipt-ack receipt)) "invalid"))
    (defn fpbrb-value (receipt)
        (fpcp-ack-value (fpcpf-receipt-ack receipt)))
    (defn fpbrb-record-kind ()
        (rpmw-kind-list
            (list (rpmw-kind-string) (rpmw-kind-string)
                  (rpmw-kind-nothing) (rpmw-kind-int) (rpmw-kind-int))))
    (defn fpbrb-request-kind ()
        (rpmw-kind-composite-node
            (list (rpmw-kind-trivial-string-node)
                  (rpmw-kind-trivial-string-node)
                  (rpmw-kind-trivial-int-node)
                  (rpmw-kind-trivial-int-node)
                  (rpmw-kind-trivial-int-node)
                  (rpmw-kind-trivial-string-node))))
    (defn fpbrb-record? (receipt status reason)
        (if (not (str_eq (fpbrb-status receipt) "returned")) 0
            (do
                (let value (fpbrb-value receipt))
                (let raw (fpcpf-value-raw value))
                (if (not (rpmw-kind-equal?
                        (fpcpf-value-kind value) (fpbrb-record-kind))) 0
                (if (not (eq (len raw) 5)) 0
                    (if (not (str_eq (nth raw 0) status)) 0
                    (if (not (str_eq (nth raw 1) reason)) 0
                    (if (not (nothing? (nth raw 2))) 0
                    (if (not (eq (nth raw 3) 0)) 0
                        (if (eq (nth raw 4) 1) 1 0))))))))))
    (defn fpbrb-request-result? (receipt coordinate)
        (if (not (str_eq (fpbrb-status receipt) "returned")) 0
            (do
                (let value (fpbrb-value receipt))
                (let raw (fpcpf-value-raw value))
                (if (not (rpmw-kind-equal?
                        (fpcpf-value-kind value) (fpbrb-request-kind))) 0
                    (if (node_eq raw
                            (fknq-request-token "concept" coordinate)) 1 0)))))
    (defn fpbrb-output-zero? (receipt)
        (if (fpcpf-receipt? receipt)
            (eq (fpcp-ack-output (fpcpf-receipt-ack receipt)) 0) 0))

    (defn form-program-image-bmf-request-birth-band ()
        (do
            ; Neither coordinate occurs in the image string pool.  Their exact
            ; request nodes therefore can only arise from the raw OFFER bytes.
            (let short-key "u7")
            (let long-key "u7-form-native-2026")
            (let boundary-key (fpbrb-repeat "a" 64))
            (let short-surface (fknq-concept-surface short-key))
            (let long-surface (fknq-concept-surface long-key))
            (let boundary-surface (fknq-concept-surface boundary-key))
            (let correlation
                (intern_trivial_string "correlation/scannerless-request-birth"))
            (let fuel 1000000)
            (let short-offer (fpbr-offer short-surface fuel correlation))
            (let long-offer (fpbr-offer long-surface fuel correlation))
            (let short-result
                (fpcpf-execute (fpbr-protocol) short-offer (fpbr-receiver)))
            (let long-result
                (fpcpf-execute (fpbr-protocol) long-offer (fpbr-receiver)))
            (let boundary-result
                (fpbr-execute boundary-surface fuel correlation))
            (let exact-fuel
                (fpcp-ack-steps (fpcpf-receipt-ack short-result)))
            (let exact-fuel-result
                (fpbr-execute short-surface exact-fuel correlation))
            (let tight-fuel-result
                (fpbr-execute short-surface (sub exact-fuel 1) correlation))

            (let missing-result
                (fpbr-execute "ordinary raw bytes" fuel correlation))
            (let incomplete-result
                (fpbr-execute
                    (str_concat (fpbr-open) "concept=u7") fuel correlation))
            (let trailing-result
                (fpbr-execute (str_concat short-surface "x") fuel correlation))
            (let nested-result
                (fpbr-execute
                    (str_concat (fpbr-open)
                        (str_concat "concept="
                            (str_concat (fpbr-open) (fpbr-close))))
                    fuel correlation))
            (let uppercase-result
                (fpbr-execute (fknq-concept-surface "Bad") fuel correlation))
            (let empty-result
                (fpbr-execute (fknq-concept-surface "") fuel correlation))
            (let slash-result
                (fpbr-execute (fknq-concept-surface "bad/key") fuel correlation))
            (let too-long-coordinate
                (fpbr-execute
                    (fknq-concept-surface (fpbrb-repeat "a" 65))
                    fuel correlation))
            (let unknown-result
                (fpbr-execute
                    (str_concat (fpbr-open)
                        (str_concat "nodeid=@1.2.3.4" (fpbr-close)))
                    fuel correlation))
            (let payload-budget-result
                (fpbr-execute
                    (str_concat (fpbr-open)
                        (str_concat
                            (str_concat "concept=" (fpbrb-repeat "a" 89))
                            (fpbr-close)))
                    fuel correlation))
            (let frame-budget-result
                (fpbr-execute
                    (str_concat (fpbr-open) (fpbrb-repeat "a" 129))
                    fuel correlation))
            (let frame-boundary-result
                (fpbr-execute
                    (str_concat (fpbr-open) (fpbrb-repeat "a" 128))
                    fuel correlation))
            (let fuel-timeout-result
                (fpbr-execute short-surface 1 correlation))

            ; The grant admits this exact callee recipe, not a forged receiver
            ; or a protocol with the grant silently removed.
            (let denied-protocol
                (fpcpf-registry
                    (list (fpbr-caller-binding) (fpbr-callee-binding))
                    (empty) (list (fpbr-call))))
            (let denied-result
                (fpcpf-execute denied-protocol short-offer (fpbr-receiver)))
            (let swapped-receiver
                (fpcpf-receiver (fpbr-caller-binding)
                    (fpbr-envelope) (fpbr-admission)
                    (pise-request-by-canonical-key
                        "scannerless/request-frame-caller")))
            (let swapped-result
                (fpcpf-execute (fpbr-protocol) short-offer swapped-receiver))

            (add
                (fpbrb-bit
                    (and (pif-envelope-valid? (fpbr-pif))
                         (rpmw-admission-status-admitted? (fpbr-admission))) 1)
            (add
                (fpbrb-bit (fpbrb-request-result? short-result short-key) 2)
            (add
                (fpbrb-bit (and (fpbrb-request-result? long-result long-key)
                    (not (node_eq (fpcpf-value-raw (fpbrb-value short-result))
                                  (fpcpf-value-raw (fpbrb-value long-result))))) 4)
            (add
                (fpbrb-bit
                    (gt (fpcp-ack-steps (fpcpf-receipt-ack long-result))
                        (fpcp-ack-steps (fpcpf-receipt-ack short-result))) 8)
            (add
                (fpbrb-bit
                    (fpbrb-record? missing-result
                        "nothing" "no-knowledge-token") 16)
            (add
                (fpbrb-bit
                    (fpbrb-record? incomplete-result
                        "nothing" "held-incomplete") 32)
            (add
                (fpbrb-bit
                    (fpbrb-record? trailing-result
                        "failure" "trailing-bytes") 64)
            (add
                (fpbrb-bit
                    (fpbrb-record? nested-result
                        "failure" "nested-knowledge-token") 128)
            (add
                (fpbrb-bit
                    (and (fpbrb-record? uppercase-result
                            "failure" "invalid-concept-coordinate")
                    (and (fpbrb-record? empty-result
                            "failure" "invalid-concept-coordinate")
                         (fpbrb-record? slash-result
                            "failure" "invalid-concept-coordinate"))) 256)
            (add
                (fpbrb-bit
                    (fpbrb-record? too-long-coordinate
                        "failure" "invalid-concept-coordinate") 512)
            (add
                (fpbrb-bit
                    (fpbrb-record? unknown-result
                        "failure" "unknown-request-kind") 1024)
            (add
                (fpbrb-bit
                    (fpbrb-record? payload-budget-result
                        "timeout" "payload-budget-exceeded") 2048)
            (add
                (fpbrb-bit
                    (fpbrb-record? frame-budget-result
                        "timeout" "frame-budget-exceeded") 4096)
            (add
                (fpbrb-bit
                    (and (str_eq (fpbrb-status fuel-timeout-result) "timeout")
                         (fpbrb-output-zero? fuel-timeout-result)) 8192)
            (add
                (fpbrb-bit
                    (and (str_eq (fpbrb-status denied-result) "refused")
                         (fpbrb-output-zero? denied-result)) 16384)
            (add
                (fpbrb-bit
                    (and (str_eq (fpbrb-status swapped-result) "failure")
                         (fpbrb-output-zero? swapped-result)) 32768)
            (add
                (fpbrb-bit
                    (and (node_eq (fpcpf-receipt-offer short-result) short-offer)
                    (and (str_eq
                            (fpcpf-value-raw
                                (head (fpcpf-offer-values
                                    (fpcpf-receipt-offer short-result))))
                            short-surface)
                         (fpcpf-receipt-observed?
                            (fpbr-protocol) short-offer
                            (fpbr-receiver) short-result))) 65536)
            (add
                (fpbrb-bit
                    (and (eq (fpcpf-receipt-observed?
                                (fpbr-protocol) long-offer
                                (fpbr-receiver) short-result) 0)
                         (eq (fpcpf-receipt-observed?
                                (fpbr-protocol) short-offer
                                (fpbr-receiver) long-result) 0)) 131072)
            (add
                (fpbrb-bit
                    (and (fpbrb-request-result? boundary-result boundary-key)
                         (fpbrb-record? frame-boundary-result
                            "nothing" "held-incomplete")) 262144)
                (fpbrb-bit
                    (and (fpbrb-request-result?
                            exact-fuel-result short-key)
                    (and (str_eq (fpbrb-status tight-fuel-result) "timeout")
                         (fpbrb-output-zero? tight-fuel-result))) 524288))))))))
            ))))))))))))))

    (form-program-image-bmf-request-birth-band))
