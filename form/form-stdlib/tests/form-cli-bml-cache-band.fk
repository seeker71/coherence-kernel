; form-cli-bml-cache-band.fk — high BML is the source; `.bml.fkb` is its
; native cache. There is no emitted Form mirror and no global cache sweep.
;
; Verdict 8191:
;   1..32   source, native path, fresh cache, bounded scope, presence rule
;   64      cache state is ready
;   128     cache source is exactly the BML authority
;   256     class descriptor FormBmlCache minted (generic T)
;   512     BML has section/template/class/native-cache rule
;   1024    cache path ends at `.bml.fkb`, not `-xtal.fk`
;   2048    source and native cache are stat-observable
;   4096    compatibility door is bounded; it reports no compilation sweep
;
; preludes: form-stdlib/core.fk form-stdlib/language-template.fk
; preludes: form-stdlib/bml/form-cli-bml-cache.bml
; witnessed: 2026-08-30 -> 8191

(do
    (defn bceb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn bceb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (bceb-has-name? (tail xs) name))))

    (let bits (bce-check))
    (let desc (FormBmlCache))
    (let src (read_file "form/form-stdlib/bml/form-cli-bml-cache.bml"))
    (let b6 (if (str_eq (bce-cache-state) "ready") 64 0))
    (let b7 (if (str_eq (bce-source-path)
                         "form/form-stdlib/bml/form-cli-bml-cache.bml")
                128 0))
    (let b8 (if (and (str_eq (nth desc 1) "FormBmlCache")
                     (and (eq (bceb-has-name? (nth desc 2) "T") 1)
                          (and (eq (bceb-has-name? (nth desc 3) "bce-ensure-all") 1)
                               (eq (bceb-has-name? (nth desc 4) "CacheSource") 1))))
                256 0))
    (let b9 (if (and (eq (bceb-has-str? src "section [form.bml]") 1)
                     (and (eq (bceb-has-str? src "template NativeCacheRow") 1)
                          (and (eq (bceb-has-str? src "class FormBmlCache") 1)
                               (and (eq (bceb-has-str? src "native-fkb") 1)
                                    (eq (bceb-has-str? src "no-source-mirror") 1)))))
                512 0))
    (let b10 (if (str_eq (bce-native-of (bce-source-path))
                          "form/form-stdlib/bml/form-cli-bml-cache.bml.fkb")
                 1024 0))
    (let b11 (if (and (ge (file_mtime (bce-source-path)) 0)
                       (ge (file_mtime (bce-native-of (bce-source-path))) 0))
                 2048 0))
    (let b12 (if (and (eq (bce-bounded?) 1)
                       (and (eq (bce-ensure-all) 1)
                            (str_eq (bce-cache-state) "ready")))
                 4096 0))
    (add bits (add b6 (add b7 (add b8 (add b9 (add b10 (add b11 b12))))))))
