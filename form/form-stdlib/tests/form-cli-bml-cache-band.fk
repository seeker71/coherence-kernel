; form-cli-bml-cache-band.fk — high BML is the source; `.bml.fkb` is its
; native cache. There is no emitted Form mirror and no global cache sweep.
;
; Verdict 32767:
;   1..32   source, native path, valid catalog state, bounded scope, presence rule
;   64      dispatch candidate and source admission are named without inventing loader outcome or JIT
;   128     cache source is exactly the BML authority
;   256     class descriptor FormBmlCache minted (generic T)
;   512     BML has section/template/class/native-cache rule
;   1024    cache path ends at `.bml.fkb`, not `-xtal.fk`
;   2048    source and root compatibility are independently observable
;   4096    compatibility door is bounded; it reports no compilation sweep
;   8192    active authority and runner contain no temperature vocabulary
;   16384   the executable witness is structurally balanced
;
; preludes: form-stdlib/core.fk form-stdlib/language-template.fk
; preludes: form-stdlib/bml/form-cli-bml-cache.bml
; witnessed: 2026-08-30 -> 8191

(do
    (defn bceb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn bceb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (bceb-has-name? (tail xs) name))))
    (defn bceb-eol (s i n)
        (if (ge i n) n
            (if (str_eq (substring s i (add i 1)) "\n") i
                (bceb-eol s (add i 1) n))))
    (defn bceb-depth-loop (s i n depth in-string escaped)
        (if (ge i n) (if (eq in-string 1) 1000000 depth)
            (do (let c (substring s i (add i 1)))
                (if (eq in-string 1)
                    (if (eq escaped 1) (bceb-depth-loop s (add i 1) n depth 1 0)
                        (if (str_eq c "\\") (bceb-depth-loop s (add i 1) n depth 1 1)
                            (bceb-depth-loop s (add i 1) n depth
                                (if (str_eq c "\"") 0 1) 0)))
                    (if (str_eq c "\"") (bceb-depth-loop s (add i 1) n depth 1 0)
                        (if (str_eq c ";") (bceb-depth-loop s (bceb-eol s i n) n depth 0 0)
                            (if (str_eq c "(") (bceb-depth-loop s (add i 1) n (add depth 1) 0 0)
                                (if (str_eq c ")")
                                    (if (lt (sub depth 1) 0) -1000000
                                        (bceb-depth-loop s (add i 1) n (sub depth 1) 0 0))
                                    (bceb-depth-loop s (add i 1) n depth 0 0)))))))))
    (defn bceb-balanced? (s)
        (if (eq (bceb-depth-loop s 0 (str_len s) 0 0 0) 0) 1 0))

    (let bits (bce-check))
    (let desc (FormBmlCache))
    (let src (read_file "form/form-stdlib/bml/form-cli-bml-cache.bml"))
    (let run-src (read_file "form/form-stdlib/form-cli-bml-cache-run.fk"))
    (let b6 (if (and (or (str_eq (bce-dispatch-candidate) "source")
                          (str_eq (bce-dispatch-candidate) "image"))
                     (and (str_eq (bce-source-admission) "whole-unit-synchronous")
                          (eq (bce-readiness-gate?) 0))) 64 0))
    (let b7 (if (str_eq (bce-source-path)
                         "form/form-stdlib/bml/form-cli-bml-cache.bml")
                128 0))
    (let b8 (if (and (str_eq (nth desc 1) "FormBmlCache")
                     (and (eq (bceb-has-name? (nth desc 2) "T") 1)
                          (and (eq (bceb-has-name? (nth desc 3) "bce-ensure-all") 1)
                               (and (eq (bceb-has-name? (nth desc 3) "bce-dispatch-candidate") 1)
                                    (eq (bceb-has-name? (nth desc 4) "CacheSource") 1)))))
                256 0))
    (let b9 (if (and (eq (bceb-has-str? src "section [form.bml]") 1)
                     (and (eq (bceb-has-str? src "template NativeCacheRow") 1)
                          (and (eq (bceb-has-str? src "class FormBmlCache") 1)
                               (and (eq (bceb-has-str? src "optional-specialization") 1)
                                    (and (eq (bceb-has-str? src "artifact-absence-does-not-prove-demand-or-jit") 1)
                                         (eq (bceb-has-str? src "no-source-mirror") 1))))))
                512 0))
    (let b10 (if (str_eq (bce-native-of (bce-source-path))
                          "form/form-stdlib/bml/form-cli-bml-cache.bml.fkb")
                 1024 0))
    (let b11 (if (and (ge (file_mtime (bce-source-path)) 0)
                       (and (eq (bce-runnable?) 1)
                            (or (str_eq (bce-root-compatibility) "absent")
                                (or (str_eq (bce-root-compatibility) "stale")
                                    (str_eq (bce-root-compatibility) "current"))))) 2048 0))
    (let b12 (if (and (eq (bce-bounded?) 1)
                       (and (eq (bce-ensure-all) 1)
                            (eq (bce-readiness-gate?) 0)))
                 4096 0))
    (let b13 (if (and (eq (bceb-has-str? src "\"cold\"") 0)
                       (and (eq (bceb-has-str? src "\"warm\"") 0)
                            (and (eq (bceb-has-str? run-src "cold") 0)
                                 (eq (bceb-has-str? run-src "warm") 0))))
                  8192 0))
    (let b14 (if (and (eq (bceb-balanced? run-src) 1)
                       (and (eq (bceb-balanced? ")(") 0)
                            (eq (bceb-balanced? "\"unfinished") 0))) 16384 0))
    (add bits (add b6 (add b7 (add b8 (add b9 (add b10 (add b11 (add b12 (add b13 b14))))))))))
