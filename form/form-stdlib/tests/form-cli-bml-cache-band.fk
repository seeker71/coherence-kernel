; form-cli-bml-cache-band.fk — xtal is cache of ice, not a second ice.
;
; Verdict 799:
;   1..16   bce-check (compile suffix, stem, xtal-of bml/fk, this ice is fresh)
;   256     class descriptor FormBmlCache minted (generic T)
;   512     high-grammar authority has package/interface/class/const/template
;
; preludes: form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml.fk form-stdlib/bml-source.fk form-stdlib/source-compiler.fk form-stdlib/grammars/form-bml.fk form-stdlib/grammars/form-lift.fk form-stdlib/form-bml-lower.fk form-stdlib/source-compiler-text-lens.fk form-stdlib/form-fs.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-bml-cache-xtal.fk
; witnessed: 2026-08-30 -> 799

(do
    (defn bceb-has-str? (s needle)
        (if (ge (str_find s needle 0) 0) 1 0))
    (defn bceb-has-name? (xs name)
        (if (nil? xs) 0
            (if (str_eq (head xs) name) 1
                (bceb-has-name? (tail xs) name))))

    (let bits (bce-check))
    (let desc (FormBmlCache))
    (let src (read_file "form/form-stdlib/bml/form-cli-bml-cache.bml"))
    (let b8 (if (and (str_eq (nth desc 1) "FormBmlCache")
                     (and (eq (bceb-has-name? (nth desc 2) "T") 1)
                          (and (eq (bceb-has-name? (nth desc 3) "bce-ensure-all") 1)
                               (eq (bceb-has-name? (nth desc 4) "IceDir") 1))))
                256 0))
    (let b9 (if (and (eq (bceb-has-str? src "package Form.cli.bmlcache") 1)
                     (and (eq (bceb-has-str? src "interface IBmlCache") 1)
                          (and (eq (bceb-has-str? src "class FormBmlCache") 1)
                               (and (eq (bceb-has-str? src "const String IceDir") 1)
                                    (eq (bceb-has-str? src "template CacheRow") 1)))))
                512 0))
    (add bits (add b8 b9)))
