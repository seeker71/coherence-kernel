; fsh-turn-process-spec-band.fk -- direct Form proof of the one-id native
; capability/refusal boundary.
;
; The band observes only plan data.  It does not run a child, discover or use a
; resource, read a private payload, access a filesystem, or cross a network.
;
; Verdict 255:
;   1  only canonical lowercase 64-hex exchange identities are admitted
;   2  the plan has the fixed eight-field one-id shape
;   4  capability stage and identity are fixed/canonical
;   8  executable and argv remain explicitly none
;  16  admitted identity still refuses the absent child executor
;  32  invalid identity is a blank-id canonical refusal, never a partial plan
;  64  renderer carries exactly the fixed capability envelope
; 128  a changed capability stage is noncanonical
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/fsh-turn-process-spec.fk

(do
    (defn fstps-envelope (exchange-id decision)
        (str_concat "schema=fsh-turn-process-spec-v2\n"
        (str_concat "kind=native-turn-capability-request\n"
        (str_concat "execution=non-executable\n"
        (str_concat "capability_stage=native-pending-discovery\n"
        (str_concat "exchange_id="
        (str_concat exchange-id
        (str_concat "\nexecutable=none\nargv=none\ndecision="
        (str_concat decision "\n")))))))))
    (let exchange-id
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    (let uppercase-id
        "0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF")
    (let short-id "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcde")
    (let injected-id
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abc/ef")
    (let plan (fshps-plan exchange-id))
    (let bad-id-plan (fshps-plan injected-id))
    (let changed-stage-plan
        (list
            (fshps-entry "schema" (fshps-schema))
            (fshps-entry "kind" (fshps-kind))
            (fshps-entry "execution" (fshps-execution))
            (fshps-entry "capability_stage" "native-claimed-without-attestation")
            (fshps-entry "exchange_id" exchange-id)
            (fshps-entry "executable" (fshps-executable))
            (fshps-entry "argv" (fshps-argv))
            (fshps-entry "decision" (fshps-refused-no-executor))))
    (let c0 (if (and (eq (fshps-exchange-id? exchange-id) 1)
                     (and (eq (fshps-exchange-id? uppercase-id) 0)
                          (and (eq (fshps-exchange-id? short-id) 0)
                               (and (eq (fshps-exchange-id? injected-id) 0)
                                    (eq (fshps-request-admitted? exchange-id) 1))))) 1 0))
    (let c1 (if (and (eq (len (fshps-plan-field-names)) 8)
                     (eq (fshps-plan-keys? plan (fshps-plan-field-names)) 1)) 2 0))
    (let c2 (if (and (str_eq (fshps-plan-value plan "capability_stage")
                              "native-pending-discovery")
                     (and (str_eq (fshps-plan-value plan "exchange_id") exchange-id)
                          (eq (fshps-plan-canonical? plan) 1))) 4 0))
    (let c3 (if (and (str_eq (fshps-plan-value plan "execution") "non-executable")
                     (and (str_eq (fshps-plan-value plan "executable") "none")
                          (str_eq (fshps-plan-value plan "argv") "none"))) 8 0))
    (let c4 (if (and (eq (fshps-child-execution-available?) 0)
                     (and (str_eq (fshps-child-decision exchange-id)
                                  "refused-no-form-native-child-executor")
                          (str_eq (fshps-plan-value plan "decision")
                                  "refused-no-form-native-child-executor"))) 16 0))
    (let c5 (if (and (str_eq (fshps-plan-value bad-id-plan "exchange_id") "")
                     (and (str_eq (fshps-plan-value bad-id-plan "decision")
                                  "refused-invalid-exchange-id")
                          (and (eq (fshps-plan-canonical? bad-id-plan) 1)
                               (eq (fshps-plan-valid? bad-id-plan) 0)))) 32 0))
    (let c6 (if (str_eq (fshps-render-plan exchange-id)
                         (fstps-envelope exchange-id
                             "refused-no-form-native-child-executor")) 64 0))
    (let c7 (if (eq (fshps-plan-canonical? changed-stage-plan) 0) 128 0))
    (sum (list c0 c1 c2 c3 c4 c5 c6 c7)))
