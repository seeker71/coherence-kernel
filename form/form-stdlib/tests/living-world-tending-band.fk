; living-world-tending-band.fk -- recurrence proposes, the field decides.
;
; Verdict 131071 proves seventeen properties:
;   1     a bounded stream receives two consented offers
;   2     identical payloads remain one content-addressed cell
;   4     the shared payload carries two distinct source attributions
;   8     an unconsented payload does not enter
;   16    exact recurrence derives one proposal without a domain taxonomy
;   32    the proposal names both participating sources
;   64    the candidate is ready only from active attribution witnesses
;   128   one affirmative response leaves the proposal waiting
;   256   a dissenting response dominates and is retained in the derivation
;   512   a dissented proposal cannot integrate authority
;   1024  the dissenter can revoke only its own response attribution
;   2048  replacing dissent with active acknowledgment yields unanimity
;   4096  unanimous integration admits the emergent candidate
;   8192  integration grants one attribution to each acknowledging source
;   16384 prior rounds remain unchanged and still show dissent
;   32768 a threshold above observed recurrence produces no proposal
;   65536 one source's revocation stays local when an identical response lives
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk

(do
    ; All vocabulary below is offered test tissue, absent from the tending organ.
    (let observation-kind (bp "TENDING-TEST-OBSERVATION"))
    (let action (bp "TENDING-TEST-ACTION"))
    (let source-a (intern_trivial_string "tending-source-a"))
    (let source-b (intern_trivial_string "tending-source-b"))
    (let source-c (intern_trivial_string "tending-source-c"))
    (let provenance-a (intern_trivial_string "tending-provenance-a"))
    (let provenance-b (intern_trivial_string "tending-provenance-b"))
    (let provenance-c (intern_trivial_string "tending-provenance-c"))
    (let interface (lwo-interface (list action)))
    (let observation
        (lwo-compose observation-kind
            (list (intern_trivial_string "recurring-shape"))))
    (let refused
        (lwo-compose observation-kind
            (list (intern_trivial_string "unconsented-shape"))))

    (let offer-a (lwo-offer source-a interface 1 observation provenance-a 1))
    (let offer-b (lwo-offer source-b interface 1 observation provenance-b 1))
    (let offer-c (lwo-offer source-c interface 0 refused provenance-c 1))
    (let entries
        (list (lwt-entry offer-a action)
              (lwt-entry offer-b action)
              (lwt-entry offer-c action)))
    (let round0 (lwt-tend (lwo-empty-world) entries 2 (lwo-none)))
    (let world0 (lwt-round-world round0))

    (let c1 (if (eq (lwo-field-size (lwo-world-attributions world0)) 2) 1 0))
    (let c2 (if (eq (lwo-field-size (lwo-world-cells world0)) 1) 2 0))
    (let c3 (if (and (eq (lwo-owned-by? world0 observation source-a) 1)
                         (eq (lwo-owned-by? world0 observation source-b) 1)) 4 0))
    (let c4 (if (eq (lwo-world-has? world0 refused) 0) 8 0))

    (let proposals (lwt-round-proposals round0))
    (let proposal (head (lwo-field-items proposals)))
    (let candidate (lwt-proposal-candidate proposal))
    (let c5 (if (and (eq (lwo-field-size proposals) 1)
                         (eq (lwt-proposal? proposal) 1)) 16 0))
    (let c6 (if (eq (lwo-field-size
                         (lwt-proposal-participants proposal)) 2) 32 0))
    (let c7 (if (eq (lwo-emergent-ready? world0 candidate) 1) 64 0))

    ; A acknowledges; B has not answered, so the field waits.
    (let yes-response (lwt-response proposal (oac-one candidate) provenance-a))
    (let yes-a-offer (lwo-offer source-a interface 1 yes-response provenance-a 1))
    (let round-one-response
        (lwt-round-receive round0 (list (lwt-entry yes-a-offer action))))
    (let evaluated-one (lwt-evaluate-round round-one-response))
    (let outcome-one (lwt-outcome-for evaluated-one proposal))
    (let c8 (if (and (node_eq (lwt-outcome-status outcome-one) (lwt-status-waiting))
                         (and (eq (lwt-outcome-yes outcome-one) 1)
                              (eq (lwt-outcome-missing outcome-one) 1))) 128 0))

    ; B dissents.  Dissent dominates; both responses remain inspectable.
    (let no-response (lwt-response proposal (oac-zero) provenance-b))
    (let no-b-offer (lwo-offer source-b interface 1 no-response provenance-b 1))
    (let round-dissent
        (lwt-round-receive round-one-response (list (lwt-entry no-b-offer action))))
    (let evaluated-dissent (lwt-evaluate-round round-dissent))
    (let outcome-dissent (lwt-outcome-for evaluated-dissent proposal))
    (let c9 (if (and (node_eq (lwt-outcome-status outcome-dissent) (lwt-status-dissented))
                         (and (eq (lwt-outcome-no outcome-dissent) 1)
                              (eq (lwo-field-size
                                   (lwt-outcome-derivations outcome-dissent)) 2))) 256 0))
    (let refused-integration (lwt-integrate round-dissent proposal action))
    (let c10 (if (eq (lwo-world-has?
                          (lwt-round-world refused-integration) candidate) 0) 512 0))

    ; B revises by revoking B's dissent attribution, then acknowledging.
    (let reason (intern_trivial_string "response-revised"))
    (let revoke-no (lwo-revocation no-response source-b reason provenance-b))
    (let revoke-no-offer (lwo-offer source-b interface 1 revoke-no provenance-b 1))
    (let round-revoked
        (lwt-round-receive round-dissent (list (lwt-entry revoke-no-offer action))))
    (let c11 (if (and (eq (lwo-active? (lwt-round-world round-revoked) no-response) 0)
                          (eq (lwo-active? (lwt-round-world round-dissent) no-response) 1)) 1024 0))

    ; The affirmative response cell is shared; B's attribution makes it B's ack.
    (let yes-b-offer (lwo-offer source-b interface 1 yes-response provenance-b 1))
    (let round-unanimous
        (lwt-round-receive round-revoked (list (lwt-entry yes-b-offer action))))
    (let evaluated-unanimous (lwt-evaluate-round round-unanimous))
    (let outcome-unanimous (lwt-outcome-for evaluated-unanimous proposal))
    (let c12 (if (and (node_eq (lwt-outcome-status outcome-unanimous)
                               (lwt-status-acknowledged))
                          (and (eq (lwt-outcome-yes outcome-unanimous) 2)
                               (eq (lwt-outcome-no outcome-unanimous) 0))) 2048 0))

    (let integrated (lwt-integrate round-unanimous proposal action))
    (let integrated-world (lwt-round-world integrated))
    (let c13 (if (eq (lwo-world-has? integrated-world candidate) 1) 4096 0))
    (let c14 (if (and (eq (lwo-owned-by? integrated-world candidate source-a) 1)
                           (eq (lwo-owned-by? integrated-world candidate source-b) 1)) 8192 0))

    ; Earlier rounds retain the earlier relation to the field.
    (let old-outcome (lwt-evaluate-proposal (lwt-round-world round-dissent) proposal))
    (let c15 (if (and (node_eq (lwt-outcome-status old-outcome)
                                (lwt-status-dissented))
                          (eq (lwo-world-has? (lwt-round-world round-dissent) candidate) 0)) 16384 0))

    (let round-too-high (lwt-tend (lwo-empty-world) entries 3 (lwo-none)))
    (let c16 (if (eq (lwo-field-size (lwt-round-proposals round-too-high)) 0) 32768 0))

    ; Shared response identity does not blur source-local consent.  A can
    ; revoke A's acknowledgment while B's identical acknowledgment remains.
    (let revoke-yes-a (lwo-revocation yes-response source-a reason provenance-a))
    (let revoke-yes-a-offer
        (lwo-offer source-a interface 1 revoke-yes-a provenance-a 1))
    (let round-a-revoked
        (lwt-round-receive round-unanimous
            (list (lwt-entry revoke-yes-a-offer action))))
    (let outcome-a-revoked
        (lwt-evaluate-proposal (lwt-round-world round-a-revoked) proposal))
    (let c17
        (if (and (node_eq (lwt-outcome-status outcome-a-revoked)
                           (lwt-status-waiting))
                 (and (eq (lwt-outcome-yes outcome-a-revoked) 1)
                      (eq (lwt-outcome-missing outcome-a-revoked) 1))) 65536 0))

    (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8
        (add c9 (add c10 (add c11 (add c12 (add c13 (add c14 (add c15
        (add c16 c17)))))))))))))))))
