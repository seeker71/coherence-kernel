; voice-school-band.bml -- the school's three borrowed programs are the body's own: a generation is copied with host_file_copy (hfs-copy), its digest is the body's SHA-256 (saj-file-digest, the digest the model seals are made of), and the ledger's minute is host_localtime. No /bin/cp, no shasum, no date.
;
; WHAT THIS PINS. vs-sha256 reads the published FIPS 180 vectors: "abc" (ba7816bf...15ad), the 448-bit two-block message (248d6a61...06c1) and one million 'a' (cdc76e5c...2cd0), the last as a 1 MB file this band writes. The engine itself is held
; against the pure-Form form-stdlib/sha256.fk and the same published vectors at every chunk size by model-seal-band.bml; this band holds the school's door onto it. vs-copy-all lands each generation file whole or not at all.
;
; Expected: 255
; Verdict 255 when every claim lands:
;   1     vs-sha256 of a file holding "abc" is the NIST vector ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
;   2     vs-sha8 is its first eight hex digits, and a file that is not there reads "" for both (no program was asked, nothing was guessed)
;   4     the 448-bit NIST message (abcdbcdecdefdefgefghfghighijhijkijkl...) reads 248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1: two blocks, the padding case
;   8     a 1 MB file the band writes (one million 'a') reads the NIST vector cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0
;   16    the check can fail: the same million bytes with the first one changed read a different 64-digit digest
;   32    vs-copy-all of four generation files (one empty, one of 1,048,509 bytes) lands each byte-equal in the generation directory; a source list with a file that is not there answers false and leaves no stage file behind
;   64    vs-minute is `YYYY-MM-DD-HH:MM` (16 bytes, the separators where date +%Y-%m-%d-%H:%M puts them) and equals hfs-minute of the instant before or after it (a minute may turn between the two reads)
;   128   voice-school.bml and voice-school-run.fk run no cp, shasum or date: their sources carry none of the three words as a program, and the one host-exec left in voice-school.bml is the git add and commit
;
; REQUIRES: the digest engine (native/metal/sha256-arm64-jit.fk) answers on this host, as it does for every model seal; a fkwu outside the checkout names the carrier with FKWU_METAL_CARRIER. Writes only under temp_dir and removes what it made.
// preludes: form/form-stdlib/voice-school.bml
section [form.bml] {
 class VoiceSchoolBand {
  def vsb-bit(held, bit) = held ? bit : 0;
  def vsb-abc() = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
  def vsb-two-block-text() = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
  def vsb-two-block() = "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1";
  def vsb-million-a() = "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0";
  // s repeated n times, by doubling
  def vsb-rep(s, n) = n <= 0 ? "" : (n % 2) == 0 ? vsb-rep(s ++ s, n / 2) : s ++ vsb-rep(s ++ s, (n - 1) / 2);
  def vsb-has?(s, part) = str_find(s, part, 0) >= 0;
  def vsb-count(s, part, from, n) = str_find(s, part, from) < 0 ? n : vsb-count(s, part, str_find(s, part, from) + len(part), n + 1);
  def vsb-same-files?(xs, dir) = nil?(xs) ? true : (Comparable) fs_exists(dir ++ "/" ++ xs[0][0]) == 1 && (String) read_file(dir ++ "/" ++ xs[0][0]) == (String) xs[0][1] && vsb-same-files?(xs[1:], dir);
  def vsb-run() {
   let dir = temp_dir() ++ "/voice-school-band-" ++ host_pid().str();
   let gone0 = host_dir_rmdir(dir);
   let made = host_dir_mkdir(dir);
   // 1 2: abc
   let fAbc = dir ++ "/abc.bin";
   let wAbc = write_file(fAbc, "abc");
   let hAbc = vs-sha256(fAbc);
   let hMissing = vs-sha256(dir ++ "/no-such-file");
   let r1 = try hAbc == vsb-abc() catch false;
   let r2 = try vs-sha8(fAbc) == "ba7816bf" && hMissing == "" && vs-sha8(dir ++ "/no-such-file") == "" catch false;
   // 4: the two-block vector
   let fTwo = dir ++ "/two.bin";
   let wTwo = write_file(fTwo, vsb-two-block-text());
   let r4 = try vs-sha256(fTwo) == vsb-two-block() catch false;
   // 8 16: one million 'a'
   let body = vsb-rep("a", 1000000);
   let fBig = dir ++ "/million.bin";
   let wBig = write_file(fBig, body);
   let fBent = dir ++ "/million-bent.bin";
   let wBent = write_file(fBent, "b" ++ substring(body, 1, len(body)));
   let hBig = vs-sha256(fBig);
   let hBent = vs-sha256(fBent);
   let said1 = print_str("sha256: abc " ++ hAbc ++ " two-block " ++ vs-sha256(fTwo) ++ " million " ++ hBig ++ " bent " ++ hBent);
   let r8 = try wBig == 1000000 && hBig == vsb-million-a() catch false;
   let r16 = try len(hBent) == 64 && hBent != vsb-million-a() && hBent != hBig catch false;
   // 32: the generation copy
   let src = dir ++ "/src";
   let gen = dir ++ "/gen";
   let ms = host_dir_mkdir(src);
   let mg = host_dir_mkdir(gen);
   let big = vsb-rep("0123456789abcdefghijklmnopqrstuvwxyz-", 28338) ++ "xyz";
   let rows = [["adapters.safetensors", big], ["optimizer.safetensors", ""], ["adapter_config.json", "{\"rank\":8}"], ["complete.json", "{}"]];
   let w1 = write_file(src ++ "/adapters.safetensors", big) + write_file(src ++ "/optimizer.safetensors", "") + write_file(src ++ "/adapter_config.json", "{\"rank\":8}") + write_file(src ++ "/complete.json", "{}");
   let copied = vs-copy-all(vs-generation-files(src), gen);
   let landed = vsb-same-files?(rows, gen);
   let gen2 = dir ++ "/gen2";
   let mg2 = host_dir_mkdir(gen2);
   let src2 = dir ++ "/src2";
   let ms2 = host_dir_mkdir(src2);
   let w2 = write_file(src2 ++ "/adapters.safetensors", "x") + write_file(src2 ++ "/optimizer.safetensors", "y");
   let partial = vs-copy-all(vs-generation-files(src2), gen2);
   let stages = fs_list(gen2) |> filter(n => str_find(n, ".hfs-copy-", 0) >= 0);
   let said2 = print_str("copy: whole " ++ copied.str() ++ " landed " ++ landed.str() ++ " with a file missing " ++ partial.str() ++ " stages left " ++ len(stages).str() ++ " big " ++ len(big).str());
   let r32 = try copied && landed && len(big) == 1048509 && !partial && len(stages) == 0 && vs-copy-sizes(vs-generation-files(src), vs-generation-files(gen)) catch false;
   // 64: the minute
   let t0 = now_unix_ms();
   let minute = vs-minute();
   let t1 = now_unix_ms();
   let shaped = len(minute) == 16 && str_byte_at(minute, 4) == 45 && str_byte_at(minute, 7) == 45 && str_byte_at(minute, 10) == 45 && str_byte_at(minute, 13) == 58;
   let said3 = print_str("minute " ++ minute);
   let r64 = try shaped && ((String) minute == (String) hfs-minute(t0) || (String) minute == (String) hfs-minute(t1)) catch false;
   // 128: the sources
   let school = read_file("form/form-stdlib/voice-school.bml");
   let runner = read_file("observe/voice-school-run.fk");
   let cpWord = "/bin/" ++ "cp";
   let shaWord = "sha" ++ "sum";
   let dateWord = "date " ++ "+%";
   let hostExecWord = "host-" ++ "exec(";
   let r128 = try !vsb-has?(school, cpWord) && !vsb-has?(school, shaWord) && !vsb-has?(school, dateWord) && !vsb-has?(runner, cpWord) && !vsb-has?(runner, shaWord) && !vsb-has?(runner, dateWord) && vsb-count(school, hostExecWord, 0, 0) == 1 && vsb-has?(school, "git add form/form-stdlib/adapters") && !vsb-has?(runner, hostExecWord) catch false;
   let removed = host_dir_rmdir(dir);
   print_str("voice-school-band claims " ++ vsb-bit(r1, 1).str() ++ " " ++ vsb-bit(r2, 2).str() ++ " " ++ vsb-bit(r4, 4).str() ++ " " ++ vsb-bit(r8, 8).str() ++ " " ++ vsb-bit(r16, 16).str() ++ " " ++ vsb-bit(r32, 32).str() ++ " " ++ vsb-bit(r64, 64).str() ++ " " ++ vsb-bit(r128, 128).str());
   vsb-bit(r1, 1) + vsb-bit(r2, 2) + vsb-bit(r4, 4) + vsb-bit(r8, 8) + vsb-bit(r16, 16) + vsb-bit(r32, 32) + vsb-bit(r64, 64) + vsb-bit(r128, 128);
  }
 }
 vsb-run();
}
