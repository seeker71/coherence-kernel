; rest-force-jit-band.fk — the resting answer meets the crystallize door:
; cold force walks and answers right, the fifth force births native once,
; the sixth rides the born page, values agree across routes and with the
; plain tree-walk force, a nested pointer lowers whole, and the pointer
; the lowering cannot express still answers — visibly, as itself.
;
; Expected: 255
; preludes: form-stdlib/rest-force-jit.fk
(do
    (defn rfjb-bit (ok bit) (if ok bit 0))
    ; run n forces of one pointer, threading the gate:
    ; returns (list last-value last-route gate borns)
    (defn rfjb-run (g p n v route borns)
        (if (eq n 0) (list v route g borns)
            (do (let r (rfj-force g p))
                (rfjb-run (nth r 2) p (sub n 1)
                    (nth r 0) (nth r 1) (add borns (nth r 3))))))
    (let rest (lg-defer "mul" 6 7))
    (let nested (lg-defer "add" (lg-defer "mul" 6 7) (lg-defer "sub" 9 4)))
    (let same (lg-defer "eq" 5 5))
    (let cold (rfj-force (hg-gate 3131) rest))
    (let four (rfjb-run (hg-gate 3131) rest 4 0 "" 0))
    (let fifth (rfj-force (nth four 2) rest))
    (let sixth (rfj-force (nth fifth 2) rest))
    (let deep (rfj-force (hg-gate 3131) nested))
    (let odd (rfj-force (hg-gate 3131) same))
    (sum (list
        (rfjb-bit (eq (nth cold 0) 42) 1)
        (rfjb-bit (str_eq (nth cold 1) "form") 2)
        (rfjb-bit (eq (nth fifth 3) 1) 4)
        (rfjb-bit (and (str_eq (nth sixth 1) "native") (eq (nth sixth 3) 0)) 8)
        (rfjb-bit (eq (nth sixth 0) 42) 16)
        (rfjb-bit (eq (nth deep 0) 47) 32)
        (rfjb-bit (and (eq (nth odd 0) 1)
                       (str_eq (nth odd 1) "form-unlowerable")) 64)
        (rfjb-bit (eq (nth cold 0) (lg-force rest)) 128))))
