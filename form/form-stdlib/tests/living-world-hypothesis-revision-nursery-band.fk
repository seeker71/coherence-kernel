; living-world-hypothesis-revision-nursery-band.fk -- failed historical
; Recipes become explicit attempts, not fake daily movement. Twenty-five claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-binding-blueprint.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk form-stdlib/living-world-profile-outcome.fk form-stdlib/living-world-compost.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-recursive-enquiry-profile-witness.fk form-stdlib/tests/living-world-enquiry-profile-voice-witness.fk form-stdlib/tests/living-world-profile-outcome-witness.fk form-stdlib/tests/living-world-hypothesis-revision-nursery-witness.fk

(do
    (let result (lwhrnw-run))
    (let target (nth (node_children result) 1))
    (let tissue-world (nth (node_children result) 2))
    (let open-field (nth (node_children result) 3))
    (let first (nth (node_children result) 4))
    (let second (nth (node_children result) 5))
    (let attempt-world (nth (node_children result) 6))
    (let field (nth (node_children result) 7))
    (let proposal (nth (node_children result) 8))
    (let candidate (nth (node_children result) 9))
    (let waiting (nth (node_children result) 10))
    (let admitted (nth (node_children result) 11))
    (let admitted-world (lwt-round-world admitted))
    (let revoked-world (nth (node_children result) 12))
    (let revoked-field (nth (node_children result) 13))
    (let events (nth (node_children result) 14))
    (let placements
        (lwo-field-size
            (lwht-tissue-placements (lwo-emergent-shape target))))
    (sum (list
        (if (eq (lwht-integrated-current? tissue-world target) 1) 1 0)
        (if (eq (lwht-contradicted?
                    (lwht-tissue-status
                        (lwo-emergent-shape target))) 1) 2 0)
        (if (and (eq (lwhrn-open?
                        (lwhrn-field-status open-field)) 1)
                 (eq (lwo-field-size
                        (lwhrn-field-candidates open-field)) 0)) 4 0)
        (if (gt (lwo-field-size
                    (lwhrn-field-unknowns open-field)) 0) 8 0)
        (if (and (eq (lwhrn-offer-valid? first) 1)
                 (eq (lwhrn-offer-valid? second) 1)) 16 0)
        (if (and (eq (lwhrn-offer-current?
                        attempt-world first target) 1)
                 (eq (lwhrn-offer-current?
                        attempt-world second target) 1)) 32 0)
        (if (not (node_eq (lwhrn-offer-recipe first)
                          (lwhrn-offer-recipe second))) 64 0)
        (if (eq (lwo-field-size
                    (lwhrn-field-candidates field)) 2) 128 0)
        (if (eq (lwo-field-size
                    (lwhrn-field-trials field)) 2) 256 0)
        (if (eq (lwo-field-size
                    (lwhrn-field-viable field)) 0) 512 0)
        (if (eq (lwo-field-size
                    (lwhrn-field-divergent field)) 2) 1024 0)
        (if (eq (lwo-field-size
                    (lwhrn-field-unresolved field)) 0) 2048 0)
        (if (eq (lwhrn-open? (lwhrn-field-status field)) 1) 4096 0)
        (if (gt (lwo-field-size
                    (lwhrn-field-alternatives field)) 0) 8192 0)
        (if (gt (lwo-field-size
                    (lwhrn-field-unknowns field)) 0) 16384 0)
        (if (gt (lwo-field-size
                    (lwt-proposal-participants proposal)) 1) 32768 0)
        (if (eq (lwhrn-integrated-current?
                    (lwt-round-world waiting) candidate) 0) 65536 0)
        (if (eq (lwhrn-integrated-current?
                    admitted-world candidate) 1) 131072 0)
        (if (and (eq (lwhrn-field?
                        (lwo-emergent-shape candidate)) 1)
                 (eq (lwhrn-open?
                        (lwhrn-field-status
                            (lwo-emergent-shape candidate))) 1)) 262144 0)
        (if (eq (lwhrnw-all-evaluation-count?
                    (lwo-field-items (lwhrn-field-trials field))
                    placements) 1) 524288 0)
        (if (eq (lwo-field-size
                    (lwhrn-field-candidates revoked-field)) 1) 1048576 0)
        (if (eq (lwo-field-size
                    (lwhrn-field-divergent revoked-field)) 1) 2097152 0)
        (if (eq (lwhrn-open?
                    (lwhrn-field-status revoked-field)) 1) 4194304 0)
        (if (eq (lwhrn-integrated-current?
                    revoked-world candidate) 0) 8388608 0)
        (if (eq (len events) 6) 16777216 0))))
