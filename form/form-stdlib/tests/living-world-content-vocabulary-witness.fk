; living-world-content-vocabulary-witness.fk -- a consent-learned surface can
; travel with identical next content across distinct transition contexts while
; a derivation-bound surface remains local.  Plurality and selective revocation
; stay visible; no surface, context, or winner is built into the organ.
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-transition-expression.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-transition-field-witness.fk form-stdlib/tests/living-world-transition-expression-witness.fk

(let LWCW-SOURCE-M (bp "LWCW-SOURCE-M"))
(let LWCW-SOURCE-N (bp "LWCW-SOURCE-N"))
(let LWCW-SOURCE-O (bp "LWCW-SOURCE-O"))
(let LWCW-SOURCE-P (bp "LWCW-SOURCE-P"))
(let LWCW-SOURCE-Q (bp "LWCW-SOURCE-Q"))
(let LWCW-SOURCE-R (bp "LWCW-SOURCE-R"))
(let LWCW-PROVENANCE (bp "LWCW-PROVENANCE"))
(let LWCW-COORDINATE (bp "LWCW-COORDINATE"))
(let LWCW-LENS (bp "LWCW-LENS"))
(let LWCW-EVIDENCE (bp "LWCW-EVIDENCE"))

(defn lwcw-symbol-observation (referent surface)
    (lwsl-observation-at referent LWCW-COORDINATE surface
        LWCW-LENS (oac-one referent) LWCW-EVIDENCE))

(defn lwcw-plan-has-symbol-items? (items candidate)
    (if (eq (len items) 0) 0
        (if (node_eq (lwtx-surface-symbol (head items)) candidate) 1
            (lwcw-plan-has-symbol-items? (tail items) candidate))))

(defn lwcw-plan-has-symbol? (plan candidate)
    (lwcw-plan-has-symbol-items?
        (lwo-field-items (lwtx-plan-surfaces plan)) candidate))

(defn lwcw-run (started)
    (do
        ; The established witness gives one context with two independently
        ; admitted next contents.  Its own causal phases are frames 1..12.
        (let transition-result (lwtfw-run started))
        (let first-world (nth transition-result 10))
        (let first-prediction (nth transition-result 11))
        (let first-derivation-c
            (lwtxw-find-derivation first-prediction LWTFW-CELL-C))
        (let first-derivation-d
            (lwtxw-find-derivation first-prediction LWTFW-CELL-D))

        ; A new exact context receives the already-seen next content through
        ; its own sources and the same unanimous membrane.
        (let second-context
            (lwtf-context (list LWTFW-CELL-B LWTFW-CELL-A)))
        (let second-observation
            (lwtf-observation second-context LWTFW-CELL-C LWCW-LENS))
        (let second-enter
            (lcfb-call-stream "living-world-content-vocabulary"
                "admit-second-context" "enter" "form-native"
                "lwtf-integrate" "same-content-new-context" 21 started
                "form/form-stdlib/tests/living-world-content-vocabulary-witness.fk"
                50 13))
        (let second-observed
            (lwt-receive-stream first-world
                (list
                    (lwtfw-entry LWCW-SOURCE-M second-observation
                        LWCW-PROVENANCE)
                    (lwtfw-entry LWCW-SOURCE-N second-observation
                        LWCW-PROVENANCE))))
        (let second-proposal
            (lwtf-proposal-for second-observed second-observation 2))
        (let second-round
            (lwt-round second-observed (lwo-field (list second-proposal))
                (lwo-empty-field) (lwo-none)))
        (let second-responded
            (lwt-round-receive second-round
                (list
                    (lwtfw-response-entry LWCW-SOURCE-M second-proposal)
                    (lwtfw-response-entry LWCW-SOURCE-N second-proposal))))
        (let second-integrated
            (lwtf-integrate second-responded second-proposal LWTFW-ACTION))
        (let transition-world (lwt-round-world second-integrated))
        (let second-prediction
            (lwtf-predict transition-world second-context
                (lwtf-prediction-alternatives first-prediction)
                (lwtf-prediction-unknown first-prediction)))
        (let second-derivation
            (lwtxw-find-derivation second-prediction LWTFW-CELL-C))
        (let second-leave
            (lcfb-call-stream "living-world-content-vocabulary"
                "admit-second-context" "leave" "form-native"
                "lwtf-integrate" "same-content-new-context" 22 started
                "form/form-stdlib/tests/living-world-content-vocabulary-witness.fk"
                82 13))

        ; Two sources offer one opaque surface for the exact recurring content,
        ; not for either context or derivation.
        (let shared-observation
            (lwcw-symbol-observation LWTFW-CELL-C "shared-surface"))
        (let shared-enter
            (lcfb-call-stream "living-world-content-vocabulary"
                "learn-content-surface" "enter" "form-native"
                "lwsl-integrate" "exact-next-content" 23 started
                "form/form-stdlib/tests/living-world-content-vocabulary-witness.fk"
                93 13))
        (let shared-observed
            (lwt-receive-stream transition-world
                (list
                    (lwtxw-entry LWCW-SOURCE-O shared-observation
                        LWCW-PROVENANCE)
                    (lwtxw-entry LWCW-SOURCE-P shared-observation
                        LWCW-PROVENANCE))))
        (let shared-proposals (lwsl-proposals shared-observed 2))
        (let shared-proposal
            (lwtxw-find-proposal shared-proposals LWTFW-CELL-C
                "shared-surface"))
        (let shared-round
            (lwt-round shared-observed shared-proposals
                (lwo-empty-field) (lwo-none)))
        (let shared-responded
            (lwt-round-receive shared-round
                (list
                    (lwtxw-response-entry LWCW-SOURCE-O shared-proposal)
                    (lwtxw-response-entry LWCW-SOURCE-P shared-proposal))))
        (let shared-integrated
            (lwsl-integrate shared-responded shared-proposal LWTXW-ACTION))
        (let shared-world (lwt-round-world shared-integrated))
        (let shared-candidate (lwt-proposal-candidate shared-proposal))
        (let shared-symbols (lwo-field (list shared-candidate)))
        (let first-shared-plan
            (lwtx-plan-for shared-world first-prediction shared-symbols))
        (let second-shared-plan
            (lwtx-plan-for shared-world second-prediction shared-symbols))
        (let shared-leave
            (lcfb-call-stream "living-world-content-vocabulary"
                "learn-content-surface" "leave" "form-native"
                "lwtx-plan-for" "two-contexts-same-content" 24 started
                "form/form-stdlib/tests/living-world-content-vocabulary-witness.fk"
                127 13))

        ; An independently offered derivation-bound surface remains local.  In
        ; the first context it coexists with the shared surface; it cannot leak
        ; into the second context.
        (let local-observation
            (lwcw-symbol-observation first-derivation-c "local-surface"))
        (let local-enter
            (lcfb-call-stream "living-world-content-vocabulary"
                "retain-situated-alternative" "enter" "form-native"
                "lwsl-integrate" "exact-first-derivation" 25 started
                "form/form-stdlib/tests/living-world-content-vocabulary-witness.fk"
                139 13))
        (let local-observed
            (lwt-receive-stream shared-world
                (list
                    (lwtxw-entry LWCW-SOURCE-Q local-observation
                        LWCW-PROVENANCE)
                    (lwtxw-entry LWCW-SOURCE-R local-observation
                        LWCW-PROVENANCE))))
        (let local-proposals (lwsl-proposals local-observed 2))
        (let local-proposal
            (lwtxw-find-proposal local-proposals first-derivation-c
                "local-surface"))
        (let local-round
            (lwt-round local-observed local-proposals
                (lwo-empty-field) (lwo-none)))
        (let local-responded
            (lwt-round-receive local-round
                (list
                    (lwtxw-response-entry LWCW-SOURCE-Q local-proposal)
                    (lwtxw-response-entry LWCW-SOURCE-R local-proposal))))
        (let local-integrated
            (lwsl-integrate local-responded local-proposal LWTXW-ACTION))
        (let plural-world (lwt-round-world local-integrated))
        (let local-candidate (lwt-proposal-candidate local-proposal))
        (let plural-symbols
            (lwo-field (list shared-candidate local-candidate)))
        (let first-plural-plan
            (lwtx-plan-for plural-world first-prediction plural-symbols))
        (let second-local-plan
            (lwtx-plan-for plural-world second-prediction plural-symbols))
        (let local-leave
            (lcfb-call-stream "living-world-content-vocabulary"
                "retain-situated-alternative" "leave" "form-native"
                "lwtx-plan-for" "plural-here-local-there" 26 started
                "form/form-stdlib/tests/living-world-content-vocabulary-witness.fk"
                174 13))

        ; One source withdraws its support for the shared surface.  The exact
        ; evidence snapshot changes, so only the shared candidate becomes stale.
        (let revoke-enter
            (lcfb-call-stream "living-world-content-vocabulary"
                "revoke-shared-surface" "enter" "form-native"
                "lwo-revocation" "source-local-shared-support" 27 started
                "form/form-stdlib/tests/living-world-content-vocabulary-witness.fk"
                183 13))
        (let revoked-world
            (lwt-receive-stream plural-world
                (list
                    (lwtxw-revoke-entry LWCW-SOURCE-O shared-observation))))
        (let first-after-revoke
            (lwtx-plan-for revoked-world first-prediction plural-symbols))
        (let second-after-revoke
            (lwtx-plan-for revoked-world second-prediction plural-symbols))
        (let revoke-leave
            (lcfb-call-stream "living-world-content-vocabulary"
                "revoke-shared-surface" "leave" "form-native"
                "lwtx-plan-for" "shared-stale-local-current" 28 started
                "form/form-stdlib/tests/living-world-content-vocabulary-witness.fk"
                197 13))

        (list first-prediction second-prediction first-derivation-c
              first-derivation-d second-context second-derivation
              second-proposal transition-world shared-world shared-candidate
              first-shared-plan second-shared-plan plural-world local-candidate
              first-plural-plan second-local-plan revoked-world
              first-after-revoke second-after-revoke)))

(defn lwcw-verdict (r)
    (do
        (let first-prediction (nth r 0))
        (let second-prediction (nth r 1))
        (let first-derivation (nth r 2))
        (let first-other-derivation (nth r 3))
        (let second-context (nth r 4))
        (let second-derivation (nth r 5))
        (let second-proposal (nth r 6))
        (let transition-world (nth r 7))
        (let shared-world (nth r 8))
        (let shared-candidate (nth r 9))
        (let first-shared (nth r 10))
        (let second-shared (nth r 11))
        (let plural-world (nth r 12))
        (let local-candidate (nth r 13))
        (let first-plural (nth r 14))
        (let second-local (nth r 15))
        (let revoked-world (nth r 16))
        (let first-revoked (nth r 17))
        (let second-revoked (nth r 18))
        (sum (list
            (if (node_eq (lwtf-derivation-next first-derivation)
                    LWTFW-CELL-C) 1 0)
            (if (not (node_eq (lwtf-prediction-context first-prediction)
                    second-context)) 2 0)
            (if (and (not (node_eq second-proposal (lwo-none)))
                     (eq (lwo-field-size
                            (lwt-proposal-participants second-proposal)) 2))
                4 0)
            (if (eq (lwtf-integrated-current? transition-world
                        (lwt-proposal-candidate second-proposal)) 1) 8 0)
            (if (and (eq (lwtf-prediction-current?
                            transition-world first-prediction) 1)
                     (and (eq (lwtf-prediction-current?
                                transition-world second-prediction) 1)
                          (and (eq (lwo-field-size
                                    (lwtf-prediction-derivations
                                        first-prediction)) 2)
                               (eq (lwo-field-size
                                    (lwtf-prediction-derivations
                                        second-prediction)) 1)))) 16 0)
            (if (eq (lwsl-integrated-current?
                        shared-world shared-candidate) 1) 32 0)
            (if (node_eq
                    (lwnv-symbol-referent
                        (lwo-emergent-shape shared-candidate))
                    LWTFW-CELL-C) 64 0)
            (if (and (eq (lwo-field-size
                            (lwtx-plan-surfaces first-shared)) 1)
                     (eq (lwo-field-size
                            (lwtx-plan-unvoiced first-shared)) 1)) 128 0)
            (if (and (eq (lwo-field-size
                            (lwtx-plan-surfaces second-shared)) 1)
                     (eq (lwo-field-size
                            (lwtx-plan-unvoiced second-shared)) 0)) 256 0)
            (if (and (eq (lwcw-plan-has-symbol?
                            first-shared shared-candidate) 1)
                     (eq (lwcw-plan-has-symbol?
                            second-shared shared-candidate) 1)) 512 0)
            (if (not (node_eq first-derivation second-derivation)) 1024 0)
            (if (and (eq (oac-one? (lwtx-plan-ack first-shared)) 1)
                     (eq (oac-one? (lwtx-plan-ack second-shared)) 1)) 2048 0)
            (if (and (node_eq (lwtx-plan-alternatives first-shared)
                                (lwtf-prediction-alternatives
                                    first-prediction))
                     (node_eq (lwtx-plan-unknown first-shared)
                                (lwtf-prediction-unknown
                                    first-prediction))) 4096 0)
            (if (and (node_eq (lwtx-plan-alternatives second-shared)
                                (lwtf-prediction-alternatives
                                    second-prediction))
                     (node_eq (lwtx-plan-unknown second-shared)
                                (lwtf-prediction-unknown
                                    second-prediction))) 8192 0)
            (if (and (eq (lwsl-integrated-current?
                            plural-world local-candidate) 1)
                     (node_eq
                        (lwnv-symbol-referent
                            (lwo-emergent-shape local-candidate))
                        first-derivation)) 16384 0)
            (if (and (eq (lwo-field-size
                            (lwtx-plan-surfaces first-plural)) 2)
                     (and (eq (lwo-field-size
                                (lwtx-plan-unvoiced first-plural)) 1)
                          (eq (oac-node?
                                (lwtx-plan-ack first-plural)) 1))) 32768 0)
            (if (and (eq (lwo-field-size
                            (lwtx-plan-surfaces second-local)) 1)
                     (and (eq (lwcw-plan-has-symbol?
                                second-local local-candidate) 0)
                          (eq (oac-one?
                                (lwtx-plan-ack second-local)) 1))) 65536 0)
            (if (and (eq (lwsl-integrated-current?
                            revoked-world shared-candidate) 0)
                     (eq (lwsl-integrated-current?
                            revoked-world local-candidate) 1)) 131072 0)
            (if (and (eq (lwo-field-size
                            (lwtx-plan-surfaces first-revoked)) 1)
                     (and (eq (lwcw-plan-has-symbol?
                                first-revoked local-candidate) 1)
                          (eq (lwo-field-size
                                (lwtx-plan-unvoiced first-revoked)) 1)))
                262144 0)
            (if (and (eq (lwo-field-size
                            (lwtx-plan-surfaces second-revoked)) 0)
                     (and (eq (lwo-field-size
                                (lwtx-plan-unvoiced second-revoked)) 1)
                          (eq (oac-nothing?
                                (lwtx-plan-ack second-revoked)) 1)))
                524288 0)))))
