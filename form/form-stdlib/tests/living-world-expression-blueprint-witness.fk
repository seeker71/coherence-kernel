; living-world-expression-blueprint-witness.fk -- four minimally learned
; surfaces teach two incompatible orders without importing trace ancestry.
; preludes: form-stdlib/core.fk form-stdlib/framebuffer-value-cache.fk observe/live-call-framebuffer.fk observe/living-world-expression-progress.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk

(let LWXBW-SOURCE-A        (bp "LWXBW-SOURCE-A"))
(let LWXBW-SOURCE-B        (bp "LWXBW-SOURCE-B"))
(let LWXBW-SOURCE-C        (bp "LWXBW-SOURCE-C"))
(let LWXBW-SOURCE-D        (bp "LWXBW-SOURCE-D"))
(let LWXBW-SOURCE-E        (bp "LWXBW-SOURCE-E"))
(let LWXBW-SOURCE-F        (bp "LWXBW-SOURCE-F"))
(let LWXBW-SOURCE-G        (bp "LWXBW-SOURCE-G"))
(let LWXBW-SOURCE-H        (bp "LWXBW-SOURCE-H"))
(let LWXBW-PROV-A          (bp "LWXBW-PROV-A"))
(let LWXBW-PROV-B          (bp "LWXBW-PROV-B"))
(let LWXBW-PROV-C          (bp "LWXBW-PROV-C"))
(let LWXBW-PROV-D          (bp "LWXBW-PROV-D"))
(let LWXBW-PROV-E          (bp "LWXBW-PROV-E"))
(let LWXBW-PROV-F          (bp "LWXBW-PROV-F"))
(let LWXBW-PROV-G          (bp "LWXBW-PROV-G"))
(let LWXBW-PROV-H          (bp "LWXBW-PROV-H"))
(let LWXBW-RESPONSE-PROV   (bp "LWXBW-RESPONSE-PROV"))
(let LWXBW-ACTION          (bp "LWXBW-ACTION"))
(let LWXBW-EVIDENCE        (bp "LWXBW-EVIDENCE"))
(let LWXBW-ALTERNATIVE     (bp "LWXBW-ALTERNATIVE"))
(let LWXBW-DEFAULT-PAYLOAD (bp "LWXBW-DEFAULT-PAYLOAD"))
(let LWXBW-LAYER-PAYLOAD   (bp "LWXBW-LAYER-PAYLOAD"))
(let LWXBW-REASON          (bp "LWXBW-REASON"))
(let LWXBW-REFERENT-A      (bp "LWXBW-REFERENT-A"))
(let LWXBW-REFERENT-B      (bp "LWXBW-REFERENT-B"))
(let LWXBW-REFERENT-C      (bp "LWXBW-REFERENT-C"))
(let LWXBW-REFERENT-D      (bp "LWXBW-REFERENT-D"))
(let LWXBW-COORDINATE-A    (bp "LWXBW-COORDINATE-A"))
(let LWXBW-COORDINATE-B    (bp "LWXBW-COORDINATE-B"))
(let LWXBW-COORDINATE-C    (bp "LWXBW-COORDINATE-C"))
(let LWXBW-COORDINATE-D    (bp "LWXBW-COORDINATE-D"))

(defn lwxbw-cell (kind) (intern_node kind (empty)))
(defn lwxbw-source-a () (lwxbw-cell LWXBW-SOURCE-A))
(defn lwxbw-source-b () (lwxbw-cell LWXBW-SOURCE-B))
(defn lwxbw-source-c () (lwxbw-cell LWXBW-SOURCE-C))
(defn lwxbw-source-d () (lwxbw-cell LWXBW-SOURCE-D))
(defn lwxbw-source-e () (lwxbw-cell LWXBW-SOURCE-E))
(defn lwxbw-source-f () (lwxbw-cell LWXBW-SOURCE-F))
(defn lwxbw-source-g () (lwxbw-cell LWXBW-SOURCE-G))
(defn lwxbw-source-h () (lwxbw-cell LWXBW-SOURCE-H))
(defn lwxbw-prov-a () (lwxbw-cell LWXBW-PROV-A))
(defn lwxbw-prov-b () (lwxbw-cell LWXBW-PROV-B))
(defn lwxbw-prov-c () (lwxbw-cell LWXBW-PROV-C))
(defn lwxbw-prov-d () (lwxbw-cell LWXBW-PROV-D))
(defn lwxbw-prov-e () (lwxbw-cell LWXBW-PROV-E))
(defn lwxbw-prov-f () (lwxbw-cell LWXBW-PROV-F))
(defn lwxbw-prov-g () (lwxbw-cell LWXBW-PROV-G))
(defn lwxbw-prov-h () (lwxbw-cell LWXBW-PROV-H))
(defn lwxbw-response-provenance ()
    (lwxbw-cell LWXBW-RESPONSE-PROV))
(defn lwxbw-action () (lwxbw-cell LWXBW-ACTION))
(defn lwxbw-evidence () (lwxbw-cell LWXBW-EVIDENCE))
(defn lwxbw-alternative () (lwxbw-cell LWXBW-ALTERNATIVE))
(defn lwxbw-reason () (lwxbw-cell LWXBW-REASON))
(defn lwxbw-referent-a () (lwxbw-cell LWXBW-REFERENT-A))
(defn lwxbw-referent-b () (lwxbw-cell LWXBW-REFERENT-B))
(defn lwxbw-referent-c () (lwxbw-cell LWXBW-REFERENT-C))
(defn lwxbw-referent-d () (lwxbw-cell LWXBW-REFERENT-D))
(defn lwxbw-coordinate-a () (lwxbw-cell LWXBW-COORDINATE-A))
(defn lwxbw-coordinate-b () (lwxbw-cell LWXBW-COORDINATE-B))
(defn lwxbw-coordinate-c () (lwxbw-cell LWXBW-COORDINATE-C))
(defn lwxbw-coordinate-d () (lwxbw-cell LWXBW-COORDINATE-D))

(defn lwxbw-entry (source provenance payload)
    (lwt-entry
        (lwo-offer source (lwo-interface (list (lwxbw-action)))
            1 payload provenance 1)
        (lwxbw-action)))

; --- four surfaces grow from two-source recurrence --------------------

(defn lwxbw-observation
    (referent coordinate surface)
    (lwsl-observation-at referent coordinate surface (lwo-none)
        (oac-one referent) (lwxbw-evidence)))
(defn lwxbw-observation-a ()
    (lwxbw-observation
        (lwxbw-referent-a) (lwxbw-coordinate-a) "left"))
(defn lwxbw-observation-b ()
    (lwxbw-observation
        (lwxbw-referent-b) (lwxbw-coordinate-b) "~"))
(defn lwxbw-observation-c ()
    (lwxbw-observation
        (lwxbw-referent-c) (lwxbw-coordinate-c) "right"))
(defn lwxbw-observation-d ()
    (lwxbw-observation
        (lwxbw-referent-d) (lwxbw-coordinate-d) "^"))

(defn lwxbw-symbol-observation-entries ()
    (list
        (lwxbw-entry (lwxbw-source-a) (lwxbw-prov-a)
            (lwxbw-observation-a))
        (lwxbw-entry (lwxbw-source-b) (lwxbw-prov-b)
            (lwxbw-observation-a))
        (lwxbw-entry (lwxbw-source-a) (lwxbw-prov-a)
            (lwxbw-observation-b))
        (lwxbw-entry (lwxbw-source-b) (lwxbw-prov-b)
            (lwxbw-observation-b))
        (lwxbw-entry (lwxbw-source-a) (lwxbw-prov-a)
            (lwxbw-observation-c))
        (lwxbw-entry (lwxbw-source-b) (lwxbw-prov-b)
            (lwxbw-observation-c))
        (lwxbw-entry (lwxbw-source-a) (lwxbw-prov-a)
            (lwxbw-observation-d))
        (lwxbw-entry (lwxbw-source-b) (lwxbw-prov-b)
            (lwxbw-observation-d))))

(defn lwxbw-symbol-observation-world ()
    (lwt-receive-stream (lwo-empty-world)
        (lwxbw-symbol-observation-entries)))
(defn lwxbw-symbol-round-build ()
    (do
        (let receive-enter
            (lwx-progress "symbol-observation-world" "enter"
                "lwt-receive-stream" "eight-symbol-observations" 101
                "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk" 119 13))
        (let world (lwxbw-symbol-observation-world))
        (let receive-leave
            (lwx-progress "symbol-observation-world" "leave"
                "lwt-receive-stream" "eight-symbol-observations" 102
                "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk" 124 13))
        (let proposals-enter
            (lwx-progress "symbol-proposals" "enter"
                "lwsl-proposals" "recurrence-threshold-2" 103
                "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk" 128 13))
        (let proposals (lwsl-proposals world 2))
        (let proposals-leave
            (lwx-progress "symbol-proposals" "leave"
                "lwsl-proposals" "recurrence-threshold-2" 104
                "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk" 133 13))
        (lwt-round world proposals (lwo-empty-field) (lwo-none))))
(defn lwxbw-symbol-round ()
    (do
        (let found (fbvc-find (fbvc-key "lwxbw-symbol-round")))
        (if (eq (fbvc-hit? found) 1)
            (fbvc-value found)
            (do
                (let entered
                    (lwx-progress "symbol-round-build" "enter"
                        "lwxbw-symbol-round-build" "lwxbw-symbol-round" 1
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk" 144 21))
                (let value (lwxbw-symbol-round-build))
                (let left
                    (lwx-progress "symbol-round-build" "leave"
                        "lwxbw-symbol-round-build" "lwxbw-symbol-round" 2
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk" 149 21))
                (let stored
                    (fbvc-store (fbvc-key "lwxbw-symbol-round") value
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk"
                        153 21))
                value))))

(defn lwxbw-symbol-proposal-referent (proposal)
    (lwnv-symbol-referent
        (lwo-emergent-shape (lwt-proposal-candidate proposal))))
(defn lwxbw-symbol-proposal-items (items referent)
    (if (eq (len items) 0) (lwo-none)
        (if (node_eq
                (lwxbw-symbol-proposal-referent (head items)) referent)
            (head items)
            (lwxbw-symbol-proposal-items (tail items) referent))))
(defn lwxbw-symbol-proposal (referent)
    (lwxbw-symbol-proposal-items
        (lwo-field-items
            (lwt-round-proposals (lwxbw-symbol-round))) referent))

(defn lwxbw-response-entry (source proposal ack)
    (lwxbw-entry source (lwxbw-response-provenance)
        (lwt-response proposal ack (lwxbw-response-provenance))))
(defn lwxbw-response-items (items proposal ack)
    (if (eq (len items) 0) (empty)
        (cons (lwxbw-response-entry (head items) proposal ack)
            (lwxbw-response-items (tail items) proposal ack))))
(defn lwxbw-responses (proposal ack)
    (lwxbw-response-items
        (lwo-field-items (lwt-proposal-participants proposal)) proposal ack))

(defn lwxbw-symbol-proposals ()
    (list
        (lwxbw-symbol-proposal (lwxbw-referent-a))
        (lwxbw-symbol-proposal (lwxbw-referent-b))
        (lwxbw-symbol-proposal (lwxbw-referent-c))
        (lwxbw-symbol-proposal (lwxbw-referent-d))))
(defn lwxbw-yes-entries-for-proposals (items)
    (if (eq (len items) 0) (empty)
        (do
            (let proposal (head items))
            (append
                (lwxbw-responses proposal
                    (oac-one (lwt-proposal-candidate proposal)))
                (lwxbw-yes-entries-for-proposals (tail items))))))
(defn lwxbw-symbol-yes-round-build ()
    (lwt-round-receive (lwxbw-symbol-round)
        (lwxbw-yes-entries-for-proposals (lwxbw-symbol-proposals))))
(defn lwxbw-integrate-symbol-proposals (round items)
    (if (eq (len items) 0) round
        (lwxbw-integrate-symbol-proposals
            (lwsl-integrate round (head items) (lwxbw-action))
            (tail items))))
(defn lwxbw-symbol-integrated-round-build ()
    (lwxbw-integrate-symbol-proposals
        (lwxbw-symbol-yes-round-build) (lwxbw-symbol-proposals)))
(defn lwxbw-symbol-integrated-round ()
    (do
        (let found (fbvc-find (fbvc-key "lwxbw-symbol-integrated-round")))
        (if (eq (fbvc-hit? found) 1)
            (fbvc-value found)
            (do
                (let entered
                    (lwx-progress "symbol-integrated-round-build" "enter"
                        "lwxbw-symbol-integrated-round-build"
                        "lwxbw-symbol-integrated-round" 3
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk" 215 21))
                (let value (lwxbw-symbol-integrated-round-build))
                (let left
                    (lwx-progress "symbol-integrated-round-build" "leave"
                        "lwxbw-symbol-integrated-round-build"
                        "lwxbw-symbol-integrated-round" 4
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk" 221 21))
                (let stored
                    (fbvc-store
                        (fbvc-key "lwxbw-symbol-integrated-round") value
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk"
                        226 21))
                value))))
(defn lwxbw-symbol-world ()
    (lwt-round-world (lwxbw-symbol-integrated-round)))

(defn lwxbw-symbol-for (referent)
    (lwt-proposal-candidate (lwxbw-symbol-proposal referent)))
(defn lwxbw-left () (lwxbw-symbol-for (lwxbw-referent-a)))
(defn lwxbw-primary () (lwxbw-symbol-for (lwxbw-referent-b)))
(defn lwxbw-right () (lwxbw-symbol-for (lwxbw-referent-c)))
(defn lwxbw-alternate () (lwxbw-symbol-for (lwxbw-referent-d)))

; --- two recurrent, incompatible structural orders --------------------

(defn lwxbw-a-material-one ()
    (lwxb-material (list (lwxbw-primary) (lwxbw-left) (lwxbw-right))))
(defn lwxbw-a-sequence-one ()
    (lwtv-sequence (list (lwxbw-left) (lwxbw-primary) (lwxbw-right))))
(defn lwxbw-a-material-two ()
    (lwxb-material (list (lwxbw-alternate) (lwxbw-right) (lwxbw-left))))
(defn lwxbw-a-sequence-two ()
    (lwtv-sequence (list (lwxbw-right) (lwxbw-alternate) (lwxbw-left))))
(defn lwxbw-b-material-one ()
    (lwxb-material (list (lwxbw-left) (lwxbw-primary) (lwxbw-right))))
(defn lwxbw-b-sequence-one ()
    (lwtv-sequence (list (lwxbw-left) (lwxbw-primary) (lwxbw-right))))
(defn lwxbw-b-material-two ()
    (lwxb-material (list (lwxbw-right) (lwxbw-alternate) (lwxbw-left))))
(defn lwxbw-b-sequence-two ()
    (lwtv-sequence (list (lwxbw-right) (lwxbw-alternate) (lwxbw-left))))

(defn lwxbw-correspondence-a-one ()
    (lwr-correspondence (lwxbw-a-material-one) (lwxbw-a-sequence-one)))
(defn lwxbw-correspondence-a-two ()
    (lwr-correspondence (lwxbw-a-material-two) (lwxbw-a-sequence-two)))
(defn lwxbw-correspondence-b-one ()
    (lwr-correspondence (lwxbw-b-material-one) (lwxbw-b-sequence-one)))
(defn lwxbw-correspondence-b-two ()
    (lwr-correspondence (lwxbw-b-material-two) (lwxbw-b-sequence-two)))
(defn lwxbw-heldout-material ()
    (lwxb-material (list (lwxbw-alternate) (lwxbw-left) (lwxbw-right))))
(defn lwxbw-expected-a ()
    (lwtv-sequence (list (lwxbw-left) (lwxbw-alternate) (lwxbw-right))))
(defn lwxbw-expected-b ()
    (lwtv-sequence (list (lwxbw-alternate) (lwxbw-left) (lwxbw-right))))

; --- optional live default and layered lens ---------------------------

(defn lwxbw-default-lens ()
    (lwlc-lens (lwlc-blueprint-shape)
        (lwxbw-cell LWXBW-DEFAULT-PAYLOAD) (lwxbw-evidence)))
(defn lwxbw-layer-lens ()
    (lwlc-lens (lwlc-cell-shape)
        (lwxbw-cell LWXBW-LAYER-PAYLOAD) (lwxbw-evidence)))
(defn lwxbw-declaration ()
    (lwlc-declaration (lwxbw-heldout-material)
        (lwlc-stack (lwxbw-default-lens)
            (lwlc-layers (list (lwxbw-layer-lens)))
            (lwo-field (list (lwxbw-layer-lens)))
            (lwlc-unknown (lwxbw-evidence)) (lwxbw-evidence))
        (lwxbw-evidence)))
(defn lwxbw-choice ()
    (lwlc-choice (lwo-none) (lwo-field (list (lwxbw-alternative)))
        (lwlc-unknown (lwxbw-evidence)) (lwxbw-evidence)))
(defn lwxbw-timeout ()
    (oac-timeout (intern_trivial_int 10)
        (oac-alternative-ack (lwxbw-heldout-material)
            (lwxbw-alternative) (lwxbw-evidence))
        (lwxbw-evidence)))

(defn lwxbw-zero-world ()
    (lwt-receive-stream (lwxbw-symbol-world)
        (list
            (lwxbw-entry (lwxbw-source-g) (lwxbw-prov-g)
                (lwxbw-heldout-material))
            (lwxbw-entry (lwxbw-source-h) (lwxbw-prov-h)
                (lwxbw-declaration)))))
(defn lwxbw-one-world ()
    (lwt-receive-stream (lwxbw-zero-world)
        (list (lwxbw-entry (lwxbw-source-c) (lwxbw-prov-c)
            (lwxbw-correspondence-a-one)))))
(defn lwxbw-world ()
    (lwt-receive-stream (lwxbw-one-world)
        (list
            (lwxbw-entry (lwxbw-source-d) (lwxbw-prov-d)
                (lwxbw-correspondence-a-two))
            (lwxbw-entry (lwxbw-source-e) (lwxbw-prov-e)
                (lwxbw-correspondence-b-one))
            (lwxbw-entry (lwxbw-source-f) (lwxbw-prov-f)
                (lwxbw-correspondence-b-two)))))

(defn lwxbw-mapping-round-build ()
    (do
        (let world (lwxbw-world))
        (lwt-round world (lwr-proposals world 2)
            (lwo-empty-field) (lwxbw-symbol-integrated-round))))
(defn lwxbw-mapping-round ()
    (do
        (let found (fbvc-find (fbvc-key "lwxbw-mapping-round")))
        (if (eq (fbvc-hit? found) 1)
            (fbvc-value found)
            (do
                (let entered
                    (lwx-progress "mapping-round-build" "enter"
                        "lwxbw-mapping-round-build" "lwxbw-mapping-round" 5
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk" 332 21))
                (let value (lwxbw-mapping-round-build))
                (let left
                    (lwx-progress "mapping-round-build" "leave"
                        "lwxbw-mapping-round-build" "lwxbw-mapping-round" 6
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk" 337 21))
                (let stored
                    (fbvc-store (fbvc-key "lwxbw-mapping-round") value
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk"
                        341 21))
                value))))
(defn lwxbw-proposal-output (proposal)
    (lwr-apply-mapping
        (lwo-emergent-shape (lwt-proposal-candidate proposal))
        (lwxbw-heldout-material)))
(defn lwxbw-proposal-for-output-items (items expected)
    (if (eq (len items) 0) (lwo-none)
        (if (node_eq (lwxbw-proposal-output (head items)) expected)
            (head items)
            (lwxbw-proposal-for-output-items (tail items) expected))))
(defn lwxbw-proposal-for-output (expected)
    (lwxbw-proposal-for-output-items
        (lwo-field-items (lwt-round-proposals (lwxbw-mapping-round)))
        expected))
(defn lwxbw-mapping-proposal-a ()
    (lwxbw-proposal-for-output (lwxbw-expected-a)))
(defn lwxbw-mapping-proposal-b ()
    (lwxbw-proposal-for-output (lwxbw-expected-b)))
(defn lwxbw-mapping-candidate-a ()
    (lwt-proposal-candidate (lwxbw-mapping-proposal-a)))
(defn lwxbw-mapping-candidate-b ()
    (lwt-proposal-candidate (lwxbw-mapping-proposal-b)))

(defn lwxbw-mapping-yes-round-build ()
    (do
        (let round (lwxbw-mapping-round))
        (let pa (lwxbw-mapping-proposal-a))
        (let pb (lwxbw-mapping-proposal-b))
        (lwt-round-receive round
            (append
                (lwxbw-responses pa (oac-one (lwt-proposal-candidate pa)))
                (lwxbw-responses pb (oac-one (lwt-proposal-candidate pb)))))))
(defn lwxbw-mapping-integrated-round-build ()
    (do
        (let round (lwxbw-mapping-yes-round-build))
        (let first (lwt-integrate round
            (lwxbw-mapping-proposal-a) (lwxbw-action)))
        (lwt-integrate first
            (lwxbw-mapping-proposal-b) (lwxbw-action))))
(defn lwxbw-mapping-integrated-round ()
    (do
        (let found (fbvc-find (fbvc-key "lwxbw-mapping-integrated-round")))
        (if (eq (fbvc-hit? found) 1)
            (fbvc-value found)
            (do
                (let entered
                    (lwx-progress "mapping-integrated-round-build" "enter"
                        "lwxbw-mapping-integrated-round-build"
                        "lwxbw-mapping-integrated-round" 7
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk" 390 21))
                (let value (lwxbw-mapping-integrated-round-build))
                (let left
                    (lwx-progress "mapping-integrated-round-build" "leave"
                        "lwxbw-mapping-integrated-round-build"
                        "lwxbw-mapping-integrated-round" 8
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk" 396 21))
                (let stored
                    (fbvc-store
                        (fbvc-key "lwxbw-mapping-integrated-round") value
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk"
                        401 21))
                value))))
(defn lwxbw-mapping-world ()
    (lwt-round-world (lwxbw-mapping-integrated-round)))

; --- both learned orders apply to new material under a second membrane ---

(defn lwxbw-application-proposal-a ()
    (lwr-application-proposal (lwxbw-mapping-world)
        (lwxbw-mapping-candidate-a) (lwxbw-heldout-material)))
(defn lwxbw-application-proposal-b ()
    (lwr-application-proposal (lwxbw-mapping-world)
        (lwxbw-mapping-candidate-b) (lwxbw-heldout-material)))
(defn lwxbw-application-candidate-a ()
    (lwt-proposal-candidate (lwxbw-application-proposal-a)))
(defn lwxbw-application-candidate-b ()
    (lwt-proposal-candidate (lwxbw-application-proposal-b)))
(defn lwxbw-application-round-build ()
    (lwt-round (lwxbw-mapping-world)
        (lwo-field (list (lwxbw-application-proposal-a)
                         (lwxbw-application-proposal-b)))
        (lwo-empty-field) (lwxbw-mapping-integrated-round)))
(defn lwxbw-application-yes-round-build ()
    (do
        (let round (lwxbw-application-round-build))
        (let pa (lwxbw-application-proposal-a))
        (let pb (lwxbw-application-proposal-b))
        (lwt-round-receive round
            (append
                (lwxbw-responses pa (oac-one (lwt-proposal-candidate pa)))
                (lwxbw-responses pb (oac-one (lwt-proposal-candidate pb)))))))
(defn lwxbw-application-integrated-round-build ()
    (do
        (let round (lwxbw-application-yes-round-build))
        (let first (lwt-integrate round
            (lwxbw-application-proposal-a) (lwxbw-action)))
        (lwt-integrate first
            (lwxbw-application-proposal-b) (lwxbw-action))))
(defn lwxbw-application-integrated-round ()
    (do
        (let found
            (fbvc-find (fbvc-key "lwxbw-application-integrated-round")))
        (if (eq (fbvc-hit? found) 1)
            (fbvc-value found)
            (do
                (let entered
                    (lwx-progress "application-integrated-round-build" "enter"
                        "lwxbw-application-integrated-round-build"
                        "lwxbw-application-integrated-round" 9
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk" 450 21))
                (let value (lwxbw-application-integrated-round-build))
                (let left
                    (lwx-progress "application-integrated-round-build" "leave"
                        "lwxbw-application-integrated-round-build"
                        "lwxbw-application-integrated-round" 10
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk" 456 21))
                (let stored
                    (fbvc-store
                        (fbvc-key "lwxbw-application-integrated-round") value
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk"
                        461 21))
                value))))
(defn lwxbw-application-world ()
    (lwt-round-world (lwxbw-application-integrated-round)))

; --- zero, one, many, rich optionality, and final consent --------------

(defn lwxbw-minimal-plan (applications)
    (lwxb-plan-for (lwxbw-application-world)
        (lwxbw-heldout-material) applications (lwo-none)
        (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none)
        (lwxbw-evidence)))
(defn lwxbw-zero-plan () (lwxbw-minimal-plan (lwo-empty-field)))
(defn lwxbw-one-plan ()
    (lwxbw-minimal-plan
        (lwo-field (list (lwxbw-application-candidate-a)))))
(defn lwxbw-many-plan ()
    (lwxbw-minimal-plan
        (lwo-field (list (lwxbw-application-candidate-a)
                         (lwxbw-application-candidate-b)))))
(defn lwxbw-rich-plan ()
    (lwxb-plan-for (lwxbw-application-world)
        (lwxbw-heldout-material)
        (lwo-field (list (lwxbw-application-candidate-a)))
        (lwxbw-declaration) (lwo-field (list (lwxbw-alternative)))
        (lwlc-unknown (lwxbw-evidence)) (lwxbw-choice)
        (lwxbw-timeout) (lwxbw-evidence)))
(defn lwxbw-voice-proposal ()
    (lwxb-proposal-from-plan
        (lwxbw-application-world) (lwxbw-rich-plan)))
(defn lwxbw-voice-round-build ()
    (lwt-round (lwxbw-application-world)
        (lwo-field (list (lwxbw-voice-proposal)))
        (lwo-empty-field) (lwxbw-application-integrated-round)))
(defn lwxbw-dissent-round-build ()
    (do
        (let round (lwxbw-voice-round-build))
        (let proposal (lwxbw-voice-proposal))
        (let participants
            (lwo-field-items (lwt-proposal-participants proposal)))
        (lwt-round-receive round
            (append
                (list (lwxbw-response-entry
                    (head participants) proposal (oac-zero)))
                (lwxbw-response-items (tail participants) proposal
                    (oac-one (lwt-proposal-candidate proposal)))))))
(defn lwxbw-voice-integrated-round-build ()
    (do
        (let round (lwxbw-voice-round-build))
        (let proposal (lwxbw-voice-proposal))
        (let yes (lwt-round-receive round
            (lwxbw-responses proposal
                (oac-one (lwt-proposal-candidate proposal)))))
        (lwxb-integrate yes proposal (lwxbw-action))))
(defn lwxbw-voice-integrated-round ()
    (do
        (let found (fbvc-find (fbvc-key "lwxbw-voice-integrated-round")))
        (if (eq (fbvc-hit? found) 1)
            (fbvc-value found)
            (do
                (let entered
                    (lwx-progress "voice-integrated-round-build" "enter"
                        "lwxbw-voice-integrated-round-build"
                        "lwxbw-voice-integrated-round" 11
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk" 525 21))
                (let value (lwxbw-voice-integrated-round-build))
                (let left
                    (lwx-progress "voice-integrated-round-build" "leave"
                        "lwxbw-voice-integrated-round-build"
                        "lwxbw-voice-integrated-round" 12
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk" 531 21))
                (let stored
                    (fbvc-store (fbvc-key "lwxbw-voice-integrated-round") value
                        "form/form-stdlib/tests/living-world-expression-blueprint-witness.fk"
                        536 21))
                value))))
(defn lwxbw-voice-world ()
    (lwt-round-world (lwxbw-voice-integrated-round)))
(defn lwxbw-utterance ()
    (lwo-emergent-shape
        (lwt-proposal-candidate (lwxbw-voice-proposal))))
(defn lwxbw-revoked-world ()
    (lwt-receive-stream (lwxbw-voice-world)
        (list (lwxbw-entry (lwxbw-source-g) (lwxbw-prov-g)
            (lwo-revocation (lwxbw-heldout-material)
                (lwxbw-source-g) (lwxbw-reason) (lwxbw-prov-g))))))

(defn lwxbw-sum (items)
    (if (eq (len items) 0) 0
        (add (head items) (lwxbw-sum (tail items)))))
