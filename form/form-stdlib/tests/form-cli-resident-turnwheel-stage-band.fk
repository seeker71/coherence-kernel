; form-cli-resident-turnwheel-stage-band.fk — the resident itself emits an
; attributed, flushed stage when a row enters and after each bounded turn.
; Expected: 127
;
; This uses an arriving JIT program row rather than a model: it proves the
; resident seam without opening a second context or claiming a Metal run.
;
; preludes: form-stdlib/form-cli-resident-turnwheel.fk

(do
    (defn fcrtsb-bit (held weight) (if held weight 0))
    (defn fcrtsb-program ()
        (list (list 2) (list 1 17) (list 3 0 1)))
    (defn fcrtsb-route ()
        (fcrt-route "arriving/stage-row-not-in-resident-source"
            (jonb-identity (fcrtsb-program) 2 1) (fcrtsb-program) 2))
    (defn fcrtsb-row (host id)
        (wt-find (wt-rows (le-w (fcrt-lw host))) id))
    (defn fcrtsb-source? (event)
        (do
            (let source (node_source event))
            (and (eq (len source) 3)
                (and (str_eq (nth source 0) "form-cli-resident-turnwheel.fk")
                    (eq (nth source 1) 156)))))
    (defn fcrtsb-has? (text part)
        (if (ge (str_find text part 0) 0) 1 0))

    (defn form-cli-resident-turnwheel-stage-band ()
        (do
            (let shared (fcrt-shared "" "" (empty) (empty) 256 8
                (jonb-registry 1)))
            (let host0 (fcrt-host-from-shared shared 0 1
                (fcrt-unbound-route)))
            (let published (fcrt-publish host0 1 1 (fcrtsb-route) 90))
            (let host1 (fcrt-act-host published))
            (framebuffer-clear)
            (let offered (fcrt-accept-program host1 71 5 4 "release/71"))
            (let host2 (fcrt-act-host offered))
            (let before (fcrtsb-row host2 71))
            (let moved (fcrt-step-row (le-tbl (fcrt-lw host2))
                (wt-sctx (le-w (fcrt-lw host2))) before))
            (let after (nth moved 0))
            (let events (framebuffer-events))
            (let enter-line (fcrt-stage-line before))
            (let return-line (fcrt-stage-line after))
            (sum (list
                (fcrtsb-bit (and (str_eq (fcrt-act-signal offered) "value")
                    (and (str_eq (wt-status before) "live")
                    (and (eq (wt-budget before) 4)
                         (eq (len (wt-toks before)) 0)))) 1)
                (fcrtsb-bit (and (str_eq (wt-status after) "returned")
                    (and (eq (wt-budget after) 3)
                    (and (eq (len (wt-toks after)) 1)
                         (eq (head (wt-toks after)) 22)))) 2)
                (fcrtsb-bit (eq (len events) 2) 4)
                (fcrtsb-bit (and (fcrtsb-source? (head events))
                    (fcrtsb-source? (head (tail events)))) 8)
                (fcrtsb-bit (and (fcrtsb-has? enter-line "id=71\n")
                    (and (fcrtsb-has? enter-line "phase=program\n")
                    (and (fcrtsb-has? enter-line "status=live\n")
                    (and (fcrtsb-has? enter-line "gas=4\n")
                         (fcrtsb-has? enter-line "tokens=0\n"))))) 16)
                (fcrtsb-bit (and (fcrtsb-has? return-line "status=returned\n")
                    (and (fcrtsb-has? return-line "gas=3\n")
                         (fcrtsb-has? return-line "tokens=1\n"))) 32)
                (fcrtsb-bit (and (eq (str_find return-line
                    "arriving/stage-row-not-in-resident-source" 0) -1)
                    (eq (str_find return-line "release/71" 0) -1)) 64)))))

    (form-cli-resident-turnwheel-stage-band))
