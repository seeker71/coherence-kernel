; ignored-argument-scan-band.fk -- the lint for the argument-dropping bug class finds the shape, and the native units are clean.
;
; The shape (found 2026-10-03, nws-free-after): a CALL's result passed as an argument the callee never reads. The walker runs
; the call; a lane that substitutes the argument expression at the callee's reads drops it. bml/ignored-argument-scan.bml
; reads anf-lower's rows for it. This band holds:
;
;   1   the positive control: planted defns of the shape (a callee that ignores its first parameter, called with a call; an
;       ignored parameter of an effect primitive; the shape inside an if arm) are all found, by caller, callee, parameter
;   2   the negative control: a callee that READS the parameter (the repaired shape), and a call whose ignored argument is a
;       plain parameter or constant, are not reported
;   4   native-whisper.bml, native-t5.bml and native-llama-voice.bml are clean: each GPU result feeds the next link
;       (rc < 0 ends the chain), so no lane can drop the call that was meant to run first
;
; Verdict 7 when every claim lands.
; REQUIRES: (kernel_ast reads this process's own program)
; preflight-exec: forbidden
import form-stdlib/bml/ignored-argument-scan.bml;
import form-stdlib/native-whisper.bml;
import form-stdlib/native-t5.bml;
import form-stdlib/native-llama-voice.bml;
section [form.bml] {
    def iasb-bit(ok, bit) = ok ? bit : 0;
    // the planted shape
    def iasb-sync() = 1;
    def iasb-after(rc, hs) = hs;
    def iasb-bad(hs) = iasb-after(iasb-sync(), hs);
    def iasb-bad-arm(hs, c) = (Comparable) c == 0 ? hs : iasb-after(iasb-sync(), hs);
    def iasb-bad-effect(hs, path) = iasb-after(host_file_append_bytes(path, [65]), hs);
    // the repaired shape: the callee reads the result
    def iasb-read(rc, hs) = rc < 0 ? form_error("refused") : hs;
    def iasb-good(hs) = iasb-read(iasb-sync(), hs);
    // an ignored parameter fed by a parameter or a constant is not an effect
    def iasb-quiet(hs) = iasb-after(7, hs);
    def iasb-quiet-param(hs, x) = iasb-after(x, hs);

    def iasb-callers(sites) = nil?(sites) ? [] : cons(sites[0][0], iasb-callers(sites[1:]));
    def iasb-has?(xs, x) = nil?(xs) ? 0 : ((String) xs[0] == x ? 1 : iasb-has?(xs[1:], x));

    let planted = ias-scan-files(["form/form-stdlib/tests/ignored-argument-scan-band.fk"]);
    let callers = iasb-callers(planted[2]);
    let clean = ias-scan-files(["form/form-stdlib/native-whisper.bml", "form/form-stdlib/native-t5.bml", "form/form-stdlib/native-llama-voice.bml"]);
    let shown = print(["ignored-argument-scan", "planted", planted[2], "native units", clean[2]]);
    let verdict = iasb-bit(((Comparable) iasb-has?(callers, "iasb-bad") == 1) && ((Comparable) iasb-has?(callers, "iasb-bad-arm") == 1) && ((Comparable) iasb-has?(callers, "iasb-bad-effect") == 1), 1)
        + iasb-bit(((Comparable) iasb-has?(callers, "iasb-good") == 0) && ((Comparable) iasb-has?(callers, "iasb-quiet") == 0) && ((Comparable) iasb-has?(callers, "iasb-quiet-param") == 0) && ((Comparable) len(planted[2]) == 3), 2)
        + iasb-bit((Comparable) len(clean[2]) == 0, 4);
    let end = print(["ignored-argument-scan-band", "verdict", verdict]);
    verdict;
}
