; qwen-last-block-judge-band.bml — the 27B last-block judge over fixtures, no model: the promotion row's verdict, the adapter read
; back by name, the split by draft id, the parent home, and the lift door's refusals before anything opens
; (form-stdlib/bml/qwen-last-block-judge.bml, observe/qwen-last-block-lift-run.bml).
;
; Fixtures live under a scratch directory the band makes and removes: a pair at layer 7 (lora_a [4, 2], lora_b [2, 3], F32, written
; by ln-write) with its adapter_config.json, a rows file of five accepted drafts a..e, and the broken shapes beside them. No governor
; is asked, no tokenizer, model or device opens, no ledger row lands.
;
; Expected: 63
; Verdict 63 when every claim lands:
;   1   better: a child whose held-out mean lies under the parent's (2.25 under 2.5) reads better 1, losses 2250 / 2500 milli;
;       the row carries parent form/form-stdlib/adapters/qwen38-last-block, the child's path, valid_reading "accepted",
;       judged_on, a 64-hex sha256 of each side's draft ids (ll-digest, the 3B lift's rule), the held-out lines and tokens, the
;       rejected losses beside with every row set aside named by line, rent 0
;   2   worse: a child above its parent reads better 0 though its rejected loss fell; a child equal to its parent reads 0
;   4   missing: a directory with no adapters.safetensors is refused naming that file, one with no config naming
;       adapter_config.json; the door, run as a child on a missing child and on an unknown key, exits 1 with the refusal and no
;       governor line (refused before anything opens)
;   8   adapter: the fixture pair stands against its geometry and its A and B read back by the header's spans to the floats
;       written; a wrong shape, a wrong layer and an F16 tensor are each refused by name
;   16  split: the held-out rows are the last k in file order, disjoint by draft id from the config's trained lines; a config
;       naming a held-out line, a held-out row that reads "rejected", a k past the file and a trained line the file lacks are
;       each refused by name
;   32  home: an absent lane home reads absent (the parent is the base); a present home with no adapter is refused by name;
;       the config reads rank, scale, layer, rows, cap and both means; a string rank, a target other than ffn_down and a
;       parent at another rank are each refused by name
;
; REQUIRES: the built ./fkwu and the body root as the working directory.
// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml form-stdlib/bml/host-child.bml form-stdlib/bml/spawn-guard.bml form-stdlib/bml/qwen-last-block-judge.bml
section [form.bml] {
 class QwenLastBlockJudgeBand {
  def qlbjb-fresh() {
   let root = temp_dir() ++ "/qwen-last-block-judge-band-" ++ now_unix_ms().str();
   (Comparable) host_dir_mkdir(root) == 1 ? ["qwen-last-block-judge", root, 0] : nothing();
  }
  def qlbjb-root(ctx) = ctx[1];
  def qlbjb-at(ctx, leaf) = qlbjb-root(ctx) ++ "/" ++ leaf;
  def qlbjb-has(s, part) = str_find(s, part, 0) >= 0;
  def qlbjb-L() = 7;
  def qlbjb-a() = [0.5, -1.25, 2.0, 0.125, 3.0, -0.75, 1.5, -2.5];
  def qlbjb-b() = [0.25, -0.5, 1.0, 4.0, -3.0, 0.0625];
  def qlbjb-an(L) = qlh-rr-name(L, "ffn_down", "a");
  def qlbjb-bn(L) = qlh-rr-name(L, "ffn_down", "b");
  def qlbjb-zip(a, b) = nil?(a) || nil?(b) ? [] : cons([a[0], b[0]], qlbjb-zip(a[1:], b[1:]));
  def qlbjb-same?(a, b) = (Comparable) len(a) == len(b) && nil?(filter(p => !(p[0] == p[1]), qlbjb-zip(a, b)));
  def qlbjb-row(id, reading) = "{\"draft\":\"" ++ id ++ "\",\"reading\":\"" ++ reading ++ "\",\"messages\":[{\"role\":\"user\",\"content\":\"q " ++ id ++ "\"},{\"role\":\"assistant\",\"content\":\"a " ++ id ++ "\"}]}";
  def qlbjb-rows-path(ctx) = qlbjb-at(ctx, "rows.jsonl");
  def qlbjb-config(ctx, rank, target) = "{\"model\":\"" ++ qlbjb-at(ctx, "model.gguf") ++ "\",\"fine_tune_type\":\"lora\",\"lora_parameters\":{\"rank\":" ++ rank ++ ",\"alpha\":4,\"scale\":2,\"dropout\":0.0},\"layers\":[" ++ qlbjb-L().str() ++ "],\"targets\":[\"" ++ target ++ "\"],\"data\":\"" ++ qlbjb-rows-path(ctx) ++ "\",\"rows\":[1,2],\"ids_cap\":160,\"mask_prompt\":1,\"trained_native_steps\":3,\"batch_size\":1,\"mean_loss_step0\":1.5,\"mean_loss_step20\":1.25,\"worn\":0}\n";
  def qlbjb-pair(dir) = ln-write(qlbj-st(dir), [[qlbjb-an(qlbjb-L()), [4, 2], qlbjb-a()], [qlbjb-bn(qlbjb-L()), [2, 3], qlbjb-b()]]);
  def qlbjb-dir(ctx, leaf) = (Comparable) host_dir_mkdir(qlbjb-at(ctx, leaf)) == 1 ? qlbjb-at(ctx, leaf) : form_error("qwen-last-block-judge band: " ++ qlbjb-at(ctx, leaf) ++ " did not make");
  // an F16 lora_a beside an F32 lora_b, by hand in the export's own framing (8-byte header length, header, bytes)
  def qlbjb-f16(dir) {
   let h = qlbt-pad8("{\"" ++ qlbjb-an(qlbjb-L()) ++ "\":{\"dtype\":\"F16\",\"shape\":[4,2],\"data_offsets\":[0,32]},\"" ++ qlbjb-bn(qlbjb-L()) ++ "\":{\"dtype\":\"F32\",\"shape\":[2,3],\"data_offsets\":[32,56]}}");
   write_file(qlbj-st(dir), md-le32(len(h)) ++ md-le32(0) ++ h ++ nam-f32s(qlbjb-a()) ++ nam-f32s(qlbjb-b()));
  }
  // a fixture adapter directory: the pair (or the F16 framing) and a config at a rank and a target
  def qlbjb-adapter(ctx, leaf, f16, rank, target) {
   let dir = qlbjb-dir(ctx, leaf);
   let p = f16 == 1 ? qlbjb-f16(dir) : qlbjb-pair(dir);
   let c = len(rank) == 0 ? 1 : write_file(qlbj-cfg(dir), qlbjb-config(ctx, rank, target));
   p > 0 && c > 0 ? 1 : 0;
  }
  // the fixtures, made once before the claims: rows a..e (and a..d with e rejected), a good pair, the broken shapes
  def qlbjb-make(ctx) {
   let rows = write_file(qlbjb-rows-path(ctx), ll-join(map(id => qlbjb-row(id, "accepted"), ["a", "b", "c", "d", "e"])) ++ "\n");
   let rej = write_file(qlbjb-at(ctx, "rows-rej.jsonl"), ll-join(append(map(id => qlbjb-row(id, "accepted"), ["a", "b", "c", "d"]), [qlbjb-row("e", "rejected")])) ++ "\n");
   let empty = qlbjb-dir(ctx, "empty");
   let made = [qlbjb-adapter(ctx, "good", 0, "2", "ffn_down"), qlbjb-adapter(ctx, "noconfig", 0, "", ""), qlbjb-adapter(ctx, "f16", 1, "2", "ffn_down"), qlbjb-adapter(ctx, "badrank", 0, "\"8\"", "ffn_down"), qlbjb-adapter(ctx, "badtarget", 0, "2", "attn_output"), qlbjb-adapter(ctx, "rank4", 0, "4", "ffn_down")];
   rows > 0 && rej > 0 && sum(made) == len(made) ? 1 : 0;
  }
  // ── the row from fixture passes: held-out lines 4 and 5, rejected lines 1 and 2 judged and line 3 set aside ──
  def qlbjb-qrow(line, count) = [line, [1, 2, 3], [2, 3, 4], [0.0, 1.0, 1.0], count, 1, 1, 0];
  def qlbjb-negs() = [[qlbjb-row("r1", "rejected"), 1], [qlbjb-row("r2", "rejected"), 2], [qlbjb-row("r3", "rejected"), 3]];
  def qlbjb-plan(ctx) {
   let lines = qlbj-lines(qlbjb-rows-path(ctx));
   qlbj-plan(qlbj-home(), "absent: the lane wears no adapter; the parent is the base 27B (the pair at +0)", qlbjb-at(ctx, "good"), "ab", 64, qlbjb-at(ctx, "model.gguf"), qlbjb-L(), 2, 160, 3, 1, qlbjb-rows-path(ctx), qlbj-at(lines, [1, 2]), qlbjb-rows-path(ctx), qlbj-last(lines, 2), qlbjb-at(ctx, "rej.jsonl"), qlbjb-negs());
  }
  def qlbjb-judged(parent, child, rejParent, rejChild) = qlbj-judged([qlbjb-qrow(4, 2), qlbjb-qrow(5, 2)], parent, child, [qlbjb-negs()[0], qlbjb-negs()[1]], [qlbjb-qrow(1, 2), qlbjb-qrow(2, 1)], rejParent, rejChild, [[3, "the prompt fills the 160-id cap: no supervised target"]], 0, nothing(), nothing(), 1, 5);
  def qlbjb-int(row, key) = json-int-value(json-object-get(row, key));
  def qlbjb-ints(row, key) = map(n => json-int-value(n), json-array-elements(json-object-get(row, key)));
  def qlbjb-c-better(ctx) {
   let plan = qlbjb-plan(ctx);
   let row = qlbj-row(plan, qlbjb-judged([2.5, 2.5], [2.25, 2.25], 2.75, 2.125));
   let ex = json-array-elements(json-object-get(row, "rejected_excluded"));
   (String) fhn-text(row, "parent") == "form/form-stdlib/adapters/qwen38-last-block" && (String) fhn-text(row, "child") == qlbjb-at(ctx, "good")
   && (String) fhn-text(row, "valid_reading") == "accepted" && qlbjb-has(fhn-text(row, "judged_on"), "accepted held-out")
   && (Comparable) len(fhn-text(row, "train_ids_sha256")) == 64 && (String) fhn-text(row, "valid_ids_sha256") == ll-digest(qlbj-texts(record_get(plan, "valid"))) && !((String) fhn-text(row, "train_ids_sha256") == fhn-text(row, "valid_ids_sha256"))
   && (Comparable) qlbjb-int(row, "better") == 1 && (Comparable) qlbjb-int(row, "parent_loss_milli") == 2500 && (Comparable) qlbjb-int(row, "child_loss_milli") == 2250 && (Comparable) qlbjb-int(row, "child_score_milli") == 0 - 2250
   && qlbjb-same?(qlbjb-ints(row, "valid_lines"), [4, 5]) && qlbjb-same?(qlbjb-ints(row, "valid_child_milli"), [2250, 2250]) && (Comparable) qlbjb-int(row, "valid_tokens") == 6 && (Comparable) qlbjb-int(row, "valid_supervised_tokens") == 4
   && (Comparable) qlbjb-int(row, "rejected_parent_loss_milli") == 2750 && (Comparable) qlbjb-int(row, "rejected_child_loss_milli") == 2125 && (Comparable) qlbjb-int(row, "rejected_rows") == 2 && (Comparable) qlbjb-int(row, "rejected_rows_total") == 3 && (String) fhn-text(row, "rejected_reading") == "rejected"
   && (Comparable) len(ex) == 1 && (Comparable) json-int-value(json-object-get(ex[0], "line")) == 3 && qlbjb-has(fhn-text(ex[0], "why"), "no supervised target")
   && (Comparable) qlbjb-int(row, "rent_tokens") == 0 && !json-object-has?(row, "in_sample_rows");
  }
  def qlbjb-c-worse(ctx) {
   let plan = qlbjb-plan(ctx);
   let worse = qlbj-row(plan, qlbjb-judged([2.5, 2.5], [2.75, 2.5], 2.75, 2.125));
   let equal = qlbj-row(plan, qlbjb-judged([2.5, 2.5], [2.5, 2.5], 2.75, 2.75));
   (Comparable) qlbjb-int(worse, "better") == 0 && (Comparable) qlbjb-int(worse, "child_loss_milli") == 2625 && (Comparable) qlbjb-int(worse, "rejected_child_loss_milli") == 2125
   && (Comparable) qlbjb-int(equal, "better") == 0 && (Comparable) qlbjb-int(equal, "child_loss_milli") == 2500;
  }
  // the door as a child: refused by name before the governor speaks
  def qlbjb-run(ctx, name, request) {
   let base = qlbjb-at(ctx, name);
   let w = write_file(base ++ ".in", request);
   let pid = host_spawn_at(["./fkwu", "observe/qwen-last-block-lift-run.bml"], [base ++ ".in", base ++ ".out", base ++ ".err"]);
   let status = pid <= 0 ? -1 : host_wait(pid);
   [status, read_file(base ++ ".out") ?? "", read_file(base ++ ".err") ?? ""];
  }
  def qlbjb-c-missing(ctx) {
   let absent = qlbj-present-why("child", qlbjb-at(ctx, "empty"));
   let noconfig = qlbj-present-why("child", qlbjb-at(ctx, "noconfig"));
   let door = qlbjb-run(ctx, "missing", "{\"child\":\"" ++ qlbjb-at(ctx, "empty") ++ "\"}");
   let typo = qlbjb-run(ctx, "typo", "{\"heldout\":\"x\"}");
   qlbjb-has(absent, "child adapter " ++ qlbjb-at(ctx, "empty") ++ "/adapters.safetensors is absent") && qlbjb-has(noconfig, "child adapter config " ++ qlbjb-at(ctx, "noconfig") ++ "/adapter_config.json is absent")
   && (String) qlbj-present-why("child", qlbjb-at(ctx, "good")) == ""
   && (Comparable) door[0] == 1 && qlbjb-has(door[1], "qwen-last-block-lift: child adapter " ++ qlbjb-at(ctx, "empty") ++ "/adapters.safetensors is absent") && !qlbjb-has(door[1], "[memory]")
   && (Comparable) typo[0] == 1 && qlbjb-has(typo[1], "qwen-last-block-lift: unknown key \"heldout\"") && !qlbjb-has(typo[1], "[memory]");
  }
  def qlbjb-c-adapter(ctx) {
   let good = qlbjb-at(ctx, "good");
   let ab = qlbj-pair-bytes(good, qlbjb-L());
   let shape = qlbj-pair-why("child", good, qlbjb-L(), 5, 2, 3);
   let layer = qlbj-pair-why("child", good, 8, 4, 2, 3);
   let f16 = qlbj-pair-why("child", qlbjb-at(ctx, "f16"), qlbjb-L(), 4, 2, 3);
   (String) qlbj-pair-why("child", good, qlbjb-L(), 4, 2, 3) == "" && qlbjb-same?(qlt-f32s(ab[0], 8), qlbjb-a()) && qlbjb-same?(qlt-f32s(ab[1], 6), qlbjb-b())
   && qlbjb-has(shape, qlbjb-an(qlbjb-L()) ++ " has shape [4, 2]; the block's pair wants [5, 2]")
   && qlbjb-has(layer, "carries no tensor " ++ qlbjb-an(8)) && qlbjb-has(layer, qlbjb-an(qlbjb-L()))
   && qlbjb-has(f16, qlbjb-an(qlbjb-L()) ++ " is F16; the pair is F32");
  }
  def qlbjb-c-split(ctx) {
   let path = qlbjb-rows-path(ctx);
   let lines = qlbj-lines(path);
   let valid = qlbj-last(lines, 2);
   let train = qlbj-at(lines, [1, 2]);
   let overlap = qlbj-split-why(path, lines, 2, valid, path, [1, 5], qlbj-at(lines, [1, 5]));
   let rpath = qlbjb-at(ctx, "rows-rej.jsonl");
   let rlines = qlbj-lines(rpath);
   let rejected = qlbj-split-why(rpath, rlines, 2, qlbj-last(rlines, 2), path, [1, 2], train);
   let far = qlbj-split-why(path, lines, 9, qlbj-last(lines, 9), path, [1, 2], train);
   let lacks = qlbj-split-why(path, lines, 2, valid, path, [1, 9], qlbj-at(lines, [1, 9]));
   (Comparable) len(lines) == 5 && qlbjb-same?(qlbj-line-nums(valid), [4, 5]) && qlbjb-same?(qlbj-ids(valid), ["d", "e"]) && qlbjb-same?(qlbj-ids(train), ["a", "b"])
   && (String) qlbj-split-why(path, lines, 2, valid, path, [1, 2], train) == ""
   && qlbjb-has(overlap, "held-out draft e of " ++ path ++ " is among the rows the child trained on")
   && qlbjb-has(rejected, "line 5 of " ++ rpath ++ " (draft e) reads \"rejected\"") && qlbjb-has(far, "holds 5 rows; valid_rows asks 9")
   && qlbjb-has(lacks, "names lines [1, 9] of " ++ path ++ "; 1 of them are rows there");
  }
  def qlbjb-c-home(ctx) {
   let c = qlbj-config(qlbjb-at(ctx, "good"));
   let present = qlbj-parent-why(qlbjb-at(ctx, "empty"), c);
   let badrank = qlbj-config-why("child", qlbjb-at(ctx, "badrank"), qlbj-config(qlbjb-at(ctx, "badrank")));
   let badtarget = qlbj-config-why("child", qlbjb-at(ctx, "badtarget"), qlbj-config(qlbjb-at(ctx, "badtarget")));
   let rank4 = qlbj-parent-why(qlbjb-at(ctx, "rank4"), c);
   qlbj-home-absent?(qlbjb-at(ctx, "no-such-home")) && !qlbj-home-absent?(qlbjb-at(ctx, "empty"))
   && qlbjb-has(present, "parent adapter " ++ qlbjb-at(ctx, "empty") ++ "/adapters.safetensors is absent")
   && (String) qlbj-config-why("child", qlbjb-at(ctx, "good"), c) == "" && (Comparable) record_get(c, "rank") == 2 && record_get(c, "scale") == 2.0 && (Comparable) qlbj-layer(c) == qlbjb-L()
   && qlbjb-same?(record_get(c, "rows"), [1, 2]) && (Comparable) record_get(c, "cap") == 160 && record_get(c, "mean0") == 1.5 && record_get(c, "mean20") == 1.25 && (String) record_get(c, "data") == qlbjb-rows-path(ctx)
   && qlbjb-has(badrank, "lora_parameters.rank is not a positive integer") && qlbjb-has(badtarget, "targets is not [\"ffn_down\"]")
   && qlbjb-has(rank4, "rank 4 beside the child's 2");
  }
 }
 let ctx = qlbjb-fresh();
 nothing?(ctx) ? form_error("qwen-last-block-judge band needs a fresh directory") : 0;
 let made = qlbjb-make(ctx);
 (Comparable) made != 1 ? form_error("qwen-last-block-judge band: the fixtures did not all land under " ++ qlbjb-root(ctx)) : 0;
 let verdict = live-claims("qwen-last-block-judge-band", ctx, [["better", 1, 1, qlbjb-c-better], ["worse", 2, 1, qlbjb-c-worse], ["missing", 4, 1, qlbjb-c-missing], ["adapter", 8, 1, qlbjb-c-adapter], ["split", 16, 1, qlbjb-c-split], ["home", 32, 1, qlbjb-c-home]]);
 host_dir_rmdir(qlbjb-root(ctx));
 verdict;
}
