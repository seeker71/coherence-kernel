; form-token-grammar-band.bml — the one table of in-stream Form controls, read on scripted streams.
; preludes: form-stdlib/bml/form-cli-microthought.bml form-stdlib/form-knowledge-query-token.fk
; Verdict 1023
; REQUIRES: the running fkwu -- the stream runs microthought's framebuffer stages and the body's live
; token sessions in it.
;
; No model is opened: every stream here is a scripted list of decoded chunks.
;     1  ftg-verbs is the contract's nine verbs in order; open, close and render spell
;        <|form:VERB|>PAYLOAD<|/form:VERB|>, and the recipe-birth, recipe-exec and knowledge-query
;        openings are the bytes form-recipe-birth-token, form-recipe-exec-token and
;        form-knowledge-query-token already read
;     2  ftg-scan answers the complete controls of known verbs in order with their offsets; a runtime
;        marker (stage) and an unclosed trailing control are not controls; ftg-scan-any also finds
;        the marker, and an unclosed opening does not hide a later control
;     4  the stream window holds a control split across chunks until it closes, refuses a second
;        control in one chunk and a control that outgrows the reserve
;     8  the interceptor answers each closed control once, in stream order, records its frame with
;        an injected flag that stays 0 until an injection is asked, and answers nothing to prose;
;        its decode checkpoints fall at the counts fcms-generate's walk publishes (1, 2, 4, 8, ...)
;    16  ftg-observe runs every verb and answers the four RESULT shapes; an unknown verb and a
;        model-written observation answer nothing, and the stream goes on
;    32  microthought carries the grammar: an affine birth stays on its own path, eval, a BML
;        recipe and its run answer in the same feed; a choice that mixes an owner-held affine address
;        with a token-held or unknown one tries each in order on the carrier that holds it, with no
;        Metal touched here (the affine alternative overflows first); frames, injections and
;        injected flags pair by index, a too-long control included; the teaching names every verb
;    64  the envelope wraps a RESULT once and leaves a source observation as it came; result kind
;        and body read back; the ledger keeps a source observation's body and names its envelope
;   128  the coding hook retains unfinished controls across new chunks without a fixed token
;        window, runs multiple complete controls in order and does not replay earlier controls;
;        native BML escapes survive while JSON-wrapped payloads cross their string edge;
;        a crossing ledger row keeps Form's RESULT bodies apart from the voice's
;        controls with no opening among them and a flag per crossing; the stdout line carries no
;        control bytes
;   256  the lanes' own session (nothing is written): unbound, the first lane to ask names the lineage
;        (code, then voice) and the request stays the process's; a bound lane (a managed task) keeps
;        its lineage and request whoever asks next, reasoning included; binding the same key again
;        keeps the same reply; a review binds a lineage of its own; a microthought owner opened for a
;        lane builds in the lane's workspace with its own counts, one opened directly keeps its own
;   512  both teachings tell the truth about time and the lane's channels: door-timeout, stdin-is-the-lanes and
;        stdout-is-the-lanes are named, and so are the doors that wait without a deadline (socket_accept, socket_recv,
;        file_open), which the verbs list as ftv-unbounded-doors; read_line and a read of /dev/fd/0 answer
;        stdin-is-the-lanes and a write to /dev/stdout answers stdout-is-the-lanes
section [form.bml] {
 class FormTokenGrammarBand {
  def ftgb-claim(ok, bit) = ok ? bit : 0;
  def ftgb-table() {
   let verbs = ftg-verbs();
   let shapes = (ftg-render("eval", "1 + 2") == "<|form:eval|>1 + 2<|/form:eval|>") && (ftg-close("node-get") == "<|/form:node-get|>");
   let absorbed = (ftg-open("recipe-birth") == frbt-open()) && (ftg-close("recipe-birth") == frbt-close()) && (ftg-open("recipe-exec") == frex-open()) && (ftg-close("recipe-exec") == frex-close()) && (ftg-open("knowledge-query") == fkqt-open()) && (ftg-close("knowledge-query") == fkqt-close());
   (verbs == ["recipe-birth", "recipe-exec", "recipe-import", "choice", "eval", "knowledge-query", "node-get", "node-make", "node-select"]) && shapes && absorbed;
  }
  def ftgb-scan() {
   let text = "Think. <|form:eval|>6 * 7<|/form:eval|> then <|form:stage|>x<|/form:stage|> and <|form:node-make|>pair;1,2<|/form:node-make|> tail <|form:eval|>open";
   let found = ftg-scan(text);
   let any = ftg-scan-any(text);
   let after = ftg-scan("<|form:node-get|>open <|form:eval|>1 + 1<|/form:eval|>");
   (len(found) == 2) && (found[0] == ["eval", "6 * 7", 7, 39]) && (found[1][0] == "node-make") && (found[1][1] == "pair;1,2") && (substring(text, found[1][2], found[1][3]) == ftg-render("node-make", "pair;1,2")) && nil?(ftg-scan("plain prose, no control")) && (map(c => c[0], any) == ["eval", "stage", "node-make"]) && (len(after) == 1) && (after[0][1] == "1 + 1");
  }
  def ftgb-window() {
   let a = ftg-window("", "Think <|fo", 256);
   let b = ftg-window(a[0], "rm:eval|>1 +", 256);
   let c = ftg-window(b[0], " 2<|/form:eval|>", 256);
   let many = ftg-window("", "<|form:eval|>1<|/form:eval|><|form:eval|>2<|/form:eval|>", 256);
   let long = ftg-window("", "<|form:eval|>11111111111111111111", 20);
   (a[1] == "held") && (b[1] == "held") && (c == ["", "control", "eval", "<|form:eval|>1 + 2<|/form:eval|>", "1 + 2"]) && (many[1] == "multiple") && (many[3] == "<|form:eval|>1<|/form:eval|>") && (long[1] == "too-long") && (ftg-window("", "plain words", 256)[1] == "held");
  }
  def ftgb-feed() {
   let icpt = ftg-intercept(256);
   let chunks = ["Let me ", "<|", "form:", "eval", "|>", "6 * 7", "<|/form:", "eval|>", " and ", "<|form:eval|>", "len(", "\"abc\")", "<|/form:eval|>", " done."];
   let outs = map(c => ftg-feed(icpt, 0, c)[2], chunks);
   let quiet = map(c => ftg-feed(ftg-intercept(256), 0, c)[2], ["no ", "control ", "here"]);
   let pulsing = ftg-pulsing(ftg-intercept(256));
   let counts = filter(n => ftgb-checkpoint-at(pulsing, n), range(1, 33));
   (outs == ["", "", "", "", "", "", "", "value=42;", "", "", "", "", "value=3;", ""]) && (record_get(icpt, "crossings") == 2) && (reverse(record_get(icpt, "frames")) == ["<|form:eval|>6 * 7<|/form:eval|>", "<|form:eval|>len(\"abc\")<|/form:eval|>"]) && (record_get(icpt, "injected") == [0, 0]) && (record_get(icpt, "fed") == 14) && !ftg-checkpoint?(icpt) && (quiet == ["", "", ""]) && (counts == ftgb-schedule(32, 1, 1, 0, [])) && (counts == [1, 2, 4, 8, 16, 32]);
  }
  def ftgb-checkpoint-at(icpt, n) {
   record_set(icpt, "fed", n);
   ftg-checkpoint?(icpt);
  }
  // the completed-step counts at which fcms-walk publishes a decode checkpoint, read from its own
  // checkpoint rule (form-cli-model-session.fk), started as fcms-generate starts it
  def ftgb-schedule(k, left, width, done, out) = done >= k ? reverse(out) : ftgb-schedule(k, fcms-decode-next-left(left, width), fcms-decode-next-width(left, width), done + 1, fcms-decode-checkpoint?(left) == 1 ? cons(done + 1, out) : out);
  def ftgb-observe() {
   let s = ftg-session-fresh();
   let made = ftg-observe-with(s, "node-make", "pair;3,4");
   let born = ftg-observe-with(s, "recipe-birth", "bml;x => x * 2");
   let ran = ftg-observe-with(s, "recipe-exec", ftg-result-body(born) ++ ";input=21;carrier=form");
   let kinds = [ftg-result-kind(ftg-observe-with(s, "eval", "6 * 7")), ftg-result-kind(made), ftg-result-kind(born), ftg-result-kind(ftg-observe-with(s, "eval", "read_file(\"x\")"))];
   (kinds == ["value", "node", "recipe", "nothing"]) && (ran == "value=42;") && (ftg-observe-with(s, "node-get", ftg-result-body(made)) == "value=[pair, " ++ ftv-coord(node_category(ftv-held(s, ftg-result-body(made)))) ++ ", [3, 4]];") && (ftg-observe-with(s, "frobnicate", "x") == "nothing=unknown-verb:frobnicate;") && (ftg-observe-with(s, "observation", "value=1;") == "nothing=observations-come-from-form;") && (ftg-observe-with(s, "nodeid-knowledge-query", "concept=x") == "nothing=knowledge-context-unavailable;") && (record_get(s, "calls") == 9);
  }
  def ftgb-microthought() {
   let owner = fmc-open-with-knowledge(512, nothing(), nothing());
   let feed = chunks => map(c => fmc-feed(owner, 0, c)[2], chunks);
   let birth = feed(["I will ", "<|form:recipe-birth|>affine-i32;mul=3;add=7", "<|/form:recipe-birth|>"]);
   let affine = ftg-result-body(birth[2]);
   let value = feed(["<|form:eval|>6 * 7<|/form:eval|>"]);
   let born = feed(["<|form:recipe-birth|>bml;x => x + 100<|/form:recipe-birth|>"]);
   let ran = feed(["<|form:recipe-exec|>" ++ ftg-result-body(born[0]) ++ ";input=5;carrier=auto<|/form:recipe-exec|>"]);
   let wide = ftg-result-body(feed(["<|form:recipe-birth|>affine-i32;mul=2147483647;add=0<|/form:recipe-birth|>"])[0]);
   let bml = ftg-result-body(born[0]);
   let mixed = feed(["<|form:choice|>" ++ wide ++ ", " ++ bml ++ ";input=1000;carrier=auto<|/form:choice|>"]);
   let unknownFirst = feed(["<|form:choice|>@0.2.0.1," ++ wide ++ ";input=1000;carrier=auto<|/form:choice|>"]);
   let long = feed(["<|form:eval|>" ++ str-join(map(i => "1 + ", range(0, 160))) ++ "1"]);
   let teaching = fmc-teaching();
   let taught = all?(v => str_find(teaching, ftg-open(v), 0) >= 0, ftg-stream-verbs());
   let routed = fmc-metal?(owner, "recipe-exec", affine ++ ";input=5;carrier=metal") && !fmc-metal?(owner, "recipe-exec", bml ++ ";input=5;carrier=metal") && fmc-metal?(owner, "recipe-birth", "affine-i32;mul=1;add=0") && !fmc-metal?(owner, "eval", "1") && fmc-metal?(owner, "choice", "@0.2.0.1," ++ affine ++ ";input=5;carrier=auto");
   let n = record_get(owner, "crossings");
   let paired = (len(record_get(owner, "frames")) == n) && (len(record_get(owner, "injections")) == n) && (record_get(owner, "injected") == map(i => 0, range(0, n))) && (record_get(owner, "frames")[0] == "") && (record_get(owner, "injections")[0] == "nothing=control-exceeds-observation-reserve;");
   (ftg-result-kind(birth[2]) == "recipe") && (value == ["value=42;"]) && (ran == ["value=105;"]) && (mixed == ["value=1100;"]) && (unknownFirst == ["nothing=signed-i32-overflow;"]) && (long == ["nothing=control-exceeds-observation-reserve;"]) && (n == 8) && paired && (record_get(owner, "executions") == 2) && (record_get(owner, "admissions") == 0) && taught && routed;
  }
  def ftgb-source() = "<|form:nodeid-knowledge-observation|>\nstatus=hit\nanswer:a &lt;b<|/form:nodeid-knowledge-observation|>";
  def ftgb-envelope() = (ftg-envelope("value=1;") == "<|form:observation|>value=1;<|/form:observation|>") && (ftg-envelope("<|form:knowledge-observation|>x<|/form:knowledge-observation|>") == "<|form:knowledge-observation|>x<|/form:knowledge-observation|>") && (ftg-result-kind("recipe=@1.2.3.4;") == "recipe") && (ftg-result-body("recipe=@1.2.3.4;") == "@1.2.3.4") && (ftg-result-body("nothing=depth-budget;") == "depth-budget") && (ftg-ledger-result(ftgb-source()) == "\nstatus=hit\nanswer:a &lt;b") && (ftg-source-kind(ftgb-source()) == "nodeid-knowledge-observation") && (ftg-ledger-result("value=4;") == "value=4;") && (ftg-source-kind("value=4;") == "observation");
  def ftgb-quantum() {
   let lane=ftg-session-fresh();
   let head=ftg-coding-chunk(lane,0,"reply <|form:eval|>1 + 1<|/form:eval|> then ");
   let fresh=ftg-coding-chunk(lane,1,"<|form:eval|>2 + 2<|/form:eval|> more");
   let row = json-emit(ftg-crossing-row("code", ["<|form:eval|>2 + 2<|/form:eval|>", "<|form:nodeid-knowledge-query|>concept=x<|/form:nodeid-knowledge-query|>"], ["value=4;", ftgb-source()], [1]));
   let resultsAt = str_find(row, "\"results\":", 0);
   let unknown=ftg-coding-chunk(lane,1,"<|form:frob|>x<|/form:frob|>");
   let payload=str-join(range(0,500) |> map(i=>"1 + "))+"1";
   let held=ftg-coding-chunk(lane,1,"<|form:eval|>"+payload);
   let closed=ftg-coding-chunk(lane,1,"<|/form:eval|>");
   let items=append(unknown,fresh);
   let results = map(c => len(c[3]) > 0 ? c[3] : ftg-observe-with(ftg-session-fresh(), c[0], c[1]), items);
   let line = json-emit(ftg-crossing-line("code", items, results, 1));
   let shapes=len(head)==1 && len(fresh)==1 && fresh[0][1]=="2 + 2" && nil?(held) && len(closed)==1 && closed[0][1]==payload && nil?(ftg-coding-chunk(lane,1,"")) && ftg-coding-payload("eval","len(\\\"abc\\\")")=="len(\"abc\")" && ftg-coding-payload("eval","len(\"a\\nb\")")=="len(\"a\\nb\")";
   let ledger = (resultsAt > 0) && (str_find(row, "<|", resultsAt) < 0) && (str_find(row, "\"results\":[\"value=4;\",", 0) >= 0) && (str_find(row, "\"sources\":[\"observation\",\"nodeid-knowledge-observation\"]", 0) >= 0) && (str_find(row, "\"injected\":[1,0]", 0) >= 0);
   let answered=results==["nothing=unknown-verb:frob;","value=4;"] && map(c=>c[2],items)==["<|form:frob|>x<|/form:frob|>","<|form:eval|>2 + 2<|/form:eval|>"] && str_find(line,"<|",0)<0 && str_find(line,"\"verbs\":[\"frob\",\"eval\"]",0)>=0 && len(ftg-coding-chunk(lane,1,ftg-render("eval","1")+ftg-render("eval","2")))==2;
   shapes && ledger && answered;
  }
  def ftgb-lanes() {
   let request = ftw-request(ftv-ws(FTG-DEFAULT));
   let code = ftw-lineage(ftv-ws(ftg-lane-session("code")));
   let voice = ftv-ws(ftg-lane-session("voice"));
   let unbound = (code == "code") && (ftw-lineage(voice) == "voice") && (ftw-request(voice) == request);
   let task = ftv-ws(ftg-bind-once("code", "task 7"));
   let held = ftv-ws(ftg-lane-session("reasoning"));
   let again = ftv-ws(ftg-bind-once("code", "task 7"));
   let bound = (ftw-lineage(task) == "code") && (ftw-request(task) == "task-7") && (ftw-lineage(held) == "code") && (ftw-reply(again) == ftw-reply(task));
   let review = ftv-ws(ftg-bind-once("", ""));
   let apart = (ftw-lineage(review) == ftw-request(review)) && (ftw-lineage(review) != "code");
   let owner = fmc-lane-tokens(fmc-open-with-knowledge(512, nothing(), nothing()));
   let alone = fmc-open-with-knowledge(512, nothing(), nothing());
   let tokens = fmc-get(owner, "tokens");
   let shared = (ftw-reply(ftv-ws(tokens)) == ftw-reply(ftv-ws(FTG-DEFAULT))) && (record_get(tokens, "calls") == 0) && (ftw-reply(ftv-ws(fmc-get(alone, "tokens"))) != ftw-reply(ftv-ws(FTG-DEFAULT)));
   unbound && bound && apart && shared;
  }
  // what both teachings say of time and of the lane's channels is what the verbs do
  def ftgb-channels() {
   let s = ftv-session();
   let said = w => str_find(ftg-teaching(), w, 0) >= 0 && str_find(ftg-coding-teaching(), w, 0) >= 0;
   let named = all?(w => said(w), ["door-timeout:DOOR", "nothing=stdin-is-the-lanes", "nothing=stdout-is-the-lanes", "socket_accept", "socket_recv", "file_open", "/dev/stdin", "/dev/stdout"]);
   let unbounded = all?(d => any?(u => u == d, ftv-unbounded-doors()), ["socket_accept", "socket_recv", "file_open"]);
   named && unbounded && (ftv-eval(s, "read_line()") == "nothing=stdin-is-the-lanes;") && (ftv-eval(s, "write_file(\"/dev/stdout\", \"x\")") == "nothing=stdout-is-the-lanes;") && (ftv-eval(s, "read_file(\"/dev/fd/0\")") == "nothing=stdin-is-the-lanes;");
  }
  def ftgb-run() {
   let c1 = ftgb-claim(ftgb-table(), 1);
   let c2 = ftgb-claim(ftgb-scan(), 2);
   let c3 = ftgb-claim(ftgb-window(), 4);
   let c4 = ftgb-claim(ftgb-feed(), 8);
   let c5 = ftgb-claim(ftgb-observe(), 16);
   let c6 = ftgb-claim(ftgb-microthought(), 32);
   let c7 = ftgb-claim(ftgb-envelope(), 64);
   let c8 = ftgb-claim(ftgb-quantum(), 128);
   let c9 = ftgb-claim(ftgb-lanes(), 256);
   let c10 = ftgb-claim(ftgb-channels(), 512);
   print_str("form-token-grammar-band claims " ++ c1.str() ++ " " ++ c2.str() ++ " " ++ c3.str() ++ " " ++ c4.str() ++ " " ++ c5.str() ++ " " ++ c6.str() ++ " " ++ c7.str() ++ " " ++ c8.str() ++ " " ++ c9.str() ++ " " ++ c10.str());
   c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10;
  }
 }
 ftgb-run();
}
