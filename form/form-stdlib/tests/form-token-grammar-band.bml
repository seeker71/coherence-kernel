; form-token-grammar-band.bml — the one table of in-stream Form controls, read on scripted streams.
; preludes: form-stdlib/bml/form-cli-microthought.bml form-stdlib/form-knowledge-query-token.fk
; Verdict 255
;
; No model is opened: every stream here is a scripted list of decoded chunks.
;     1  ftg-verbs is the contract's eight verbs in order; open, close and render spell
;        <|form:VERB|>PAYLOAD<|/form:VERB|>, and the recipe-birth, recipe-exec and knowledge-query
;        openings are the bytes form-recipe-birth-token, form-recipe-exec-token and
;        form-knowledge-query-token already read
;     2  ftg-scan answers the complete controls of known verbs in order with their offsets; a runtime
;        marker (stage) and an unclosed trailing control are not controls
;     4  the stream window holds a control split across chunks until it closes, refuses a second
;        control in one chunk and a control that outgrows the reserve
;     8  the interceptor answers each closed control once, in stream order, records its frame, and
;        answers nothing to prose
;    16  ftg-observe runs every verb and answers the four RESULT shapes; an unknown verb and a
;        model-written observation answer nothing, and the stream goes on
;    32  microthought carries the grammar: an affine birth stays on its own path, eval, a BML
;        recipe and its run answer in the same feed, Metal admission is asked only for addresses the
;        owner admitted, and the teaching names every verb's opening
;    64  the envelope wraps a RESULT once and leaves a source observation as it came; result kind
;        and body read back
;   128  the quantum hook's reading: only controls whose close falls after the head are fresh; a
;        payload written inside a JSON string is read as the string's value; a crossing ledger row
;        keeps Form's RESULT apart from the voice's controls, with no observation envelope; the
;        voice walk's progress pulses at powers of two, as fcms-generate's checkpoints do
section [form.bml] {
 class FormTokenGrammarBand {
  def ftgb-claim(ok, bit) = ok ? bit : 0;
  def ftgb-table() {
   let verbs = ftg-verbs();
   let shapes = (ftg-render("eval", "1 + 2") == "<|form:eval|>1 + 2<|/form:eval|>") && (ftg-close("node-get") == "<|/form:node-get|>");
   let absorbed = (ftg-open("recipe-birth") == frbt-open()) && (ftg-close("recipe-birth") == frbt-close()) && (ftg-open("recipe-exec") == frex-open()) && (ftg-close("recipe-exec") == frex-close()) && (ftg-open("knowledge-query") == fkqt-open()) && (ftg-close("knowledge-query") == fkqt-close());
   (verbs == ["recipe-birth", "recipe-exec", "choice", "eval", "knowledge-query", "node-get", "node-make", "node-select"]) && shapes && absorbed;
  }
  def ftgb-scan() {
   let text = "Think. <|form:eval|>6 * 7<|/form:eval|> then <|form:stage|>x<|/form:stage|> and <|form:node-make|>pair;1,2<|/form:node-make|> tail <|form:eval|>open";
   let found = ftg-scan(text);
   (len(found) == 2) && (found[0] == ["eval", "6 * 7", 7, 39]) && (found[1][0] == "node-make") && (found[1][1] == "pair;1,2") && (substring(text, found[1][2], found[1][3]) == ftg-render("node-make", "pair;1,2")) && nil?(ftg-scan("plain prose, no control"));
  }
  def ftgb-window() {
   let a = ftg-window("", "Think <|fo", 256);
   let b = ftg-window(a[0], "rm:eval|>1 +", 256);
   let c = ftg-window(b[0], " 2<|/form:eval|>", 256);
   let many = ftg-window("", "<|form:eval|>1<|/form:eval|><|form:eval|>2<|/form:eval|>", 256);
   let long = ftg-window("", "<|form:eval|>11111111111111111111", 20);
   (a[1] == "held") && (b[1] == "held") && (c == ["", "control", "eval", "<|form:eval|>1 + 2<|/form:eval|>", "1 + 2"]) && (many[1] == "multiple") && (many[3] == "<|form:eval|>1<|/form:eval|>") && (long[1] == "too-long") && (ftg-window("", "plain words", 256)[1] == "held");
  }
  def ftgb-feed() {
   let icpt = ftg-intercept(256);
   let chunks = ["Let me ", "<|", "form:", "eval", "|>", "6 * 7", "<|/form:", "eval|>", " and ", "<|form:eval|>", "len(", "\"abc\")", "<|/form:eval|>", " done."];
   let outs = map(c => ftg-feed(icpt, 0, c)[2], chunks);
   let quiet = map(c => ftg-feed(ftg-intercept(256), 0, c)[2], ["no ", "control ", "here"]);
   (outs == ["", "", "", "", "", "", "", "value=42;", "", "", "", "", "value=3;", ""]) && (record_get(icpt, "crossings") == 2) && (reverse(record_get(icpt, "frames")) == ["<|form:eval|>6 * 7<|/form:eval|>", "<|form:eval|>len(\"abc\")<|/form:eval|>"]) && (quiet == ["", "", ""]);
  }
  def ftgb-observe() {
   let s = ftg-session-fresh();
   let made = ftg-observe-with(s, "node-make", "pair;3,4");
   let born = ftg-observe-with(s, "recipe-birth", "bml;x => x * 2");
   let ran = ftg-observe-with(s, "recipe-exec", ftg-result-body(born) ++ ";input=21;carrier=form");
   let kinds = [ftg-result-kind(ftg-observe-with(s, "eval", "6 * 7")), ftg-result-kind(made), ftg-result-kind(born), ftg-result-kind(ftg-observe-with(s, "eval", "read_file(\"x\")"))];
   (kinds == ["value", "node", "recipe", "nothing"]) && (ran == "value=42;") && (ftg-observe-with(s, "node-get", ftg-result-body(made)) == "value=[pair, " ++ ftv-coord(node_category(ftv-held(s, ftg-result-body(made)))) ++ ", [3, 4]];") && (ftg-observe-with(s, "frobnicate", "x") == "nothing=unknown-verb:frobnicate;") && (ftg-observe-with(s, "observation", "value=1;") == "nothing=observations-come-from-form;") && (ftg-observe-with(s, "nodeid-knowledge-query", "concept=x") == "nothing=knowledge-context-unavailable;") && (record_get(s, "calls") == 9);
  }
  def ftgb-microthought() {
   let owner = fmc-open-with-knowledge(512, nothing(), nothing());
   let feed = chunks => map(c => fmc-feed(owner, 0, c)[2], chunks);
   let birth = feed(["I will ", "<|form:recipe-birth|>affine-i32;mul=3;add=7", "<|/form:recipe-birth|>"]);
   let affine = ftg-result-body(birth[2]);
   let value = feed(["<|form:eval|>6 * 7<|/form:eval|>"]);
   let born = feed(["<|form:recipe-birth|>bml;x => x + 100<|/form:recipe-birth|>"]);
   let ran = feed(["<|form:recipe-exec|>" ++ ftg-result-body(born[0]) ++ ";input=5;carrier=auto<|/form:recipe-exec|>"]);
   let teaching = fmc-teaching();
   let taught = all?(v => str_find(teaching, ftg-open(v), 0) >= 0, ftg-stream-verbs());
   let routed = fmc-metal?(owner, "recipe-exec", affine ++ ";input=5;carrier=metal") && !fmc-metal?(owner, "recipe-exec", ftg-result-body(born[0]) ++ ";input=5;carrier=metal") && fmc-metal?(owner, "recipe-birth", "affine-i32;mul=1;add=0") && !fmc-metal?(owner, "eval", "1");
   (ftg-result-kind(birth[2]) == "recipe") && (value == ["value=42;"]) && (ran == ["value=105;"]) && (record_get(owner, "crossings") == 4) && (len(record_get(owner, "frames")) == 4) && (record_get(owner, "executions") == 0) && taught && routed;
  }
  def ftgb-envelope() = (ftg-envelope("value=1;") == "<|form:observation|>value=1;<|/form:observation|>") && (ftg-envelope("<|form:knowledge-observation|>x<|/form:knowledge-observation|>") == "<|form:knowledge-observation|>x<|/form:knowledge-observation|>") && (ftg-result-kind("recipe=@1.2.3.4;") == "recipe") && (ftg-result-body("recipe=@1.2.3.4;") == "@1.2.3.4") && (ftg-result-body("nothing=depth-budget;") == "depth-budget");
  def ftgb-quantum() {
   let head = "reply <|form:eval|>1 + 1<|/form:eval|> then ";
   let text = head ++ "<|form:eval|>2 + 2<|/form:eval|> more";
   let fresh = ftg-fresh-controls(head, text);
   let row = ftg-crossing-row("code", ["<|form:eval|>2 + 2<|/form:eval|>"], ["value=4;"], 1);
   (len(fresh) == 1) && (fresh[0][1] == "2 + 2") && nil?(ftg-fresh-controls(text, text)) && (len(ftg-fresh-controls("", text)) == 2) && (ftg-json-unescape("len(\\\"abc\\\")") == "len(\"abc\")") && (str_find(json-emit(row), ftg-observation-open(), 0) < 0) && (str_find(json-emit(row), "\"results\":[\"value=4;\"]", 0) >= 0) && all?(n => ftg-power-of-two?(n), [1, 8, 16, 1024]) && !any?(n => ftg-power-of-two?(n), [0, 12, 24, 1023]) && (ftg-pulse("model-codec", "begin", 0, 8) == 0);
  }
  def ftgb-run() {
   let c1 = ftgb-claim(ftgb-table(), 1);
   let c2 = ftgb-claim(ftgb-scan(), 2);
   let c3 = ftgb-claim(ftgb-window(), 4);
   let c4 = ftgb-claim(ftgb-feed(), 8);
   let c5 = ftgb-claim(ftgb-observe(), 16);
   let c6 = ftgb-claim(ftgb-microthought(), 32);
   let c7 = ftgb-claim(ftgb-envelope(), 64);
   let c8 = ftgb-claim(ftgb-quantum(), 128);
   print_str("form-token-grammar-band claims " ++ c1.str() ++ " " ++ c2.str() ++ " " ++ c3.str() ++ " " ++ c4.str() ++ " " ++ c5.str() ++ " " ++ c6.str() ++ " " ++ c7.str() ++ " " ++ c8.str());
   c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8;
  }
 }
 ftgb-run();
}
