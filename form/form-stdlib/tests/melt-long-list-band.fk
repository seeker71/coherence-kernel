; melt-long-list-band.fk — a live list of millions of cells comes through the melt whole.
;
; The melt's two walks, fk_mlive and fk_mcopy, go along a list's tail in a loop and into its head by recursion,
; as fk_smark does: a list costs one frame per level of nesting, never one per cell. Walking the tail by recursion,
; a live list of a few million cells ran the evaluation thread off its stack in the middle of a melt (rc 138) once
; melts came often -- the melt's headroom follows the field's node count, and a freshly reset field keeps it small.
;
; Verdict 3
; PROOF LEVEL: FOURTH-ARM ONLY (fkwu's copying arena and the two walks of its melt)
; preludes: form-stdlib/core.fk
;
;   1   a list of 5,000,000 cells, built by core.fk's range through the melts its growth brings, reads its length,
;       its first element and its last
;   2   held live while a second list of 5,000,000 cells is built and let go, it reads the closed-form sum
(do
    (defn mll-sum (xs acc) (if (nil? xs) acc (mll-sum (tail xs) (add acc (head xs)))))
    (defn mll-last (xs) (if (nil? (tail xs)) (head xs) (mll-last (tail xs))))
    (let big (range 0 5000000))
    (let b1 (if (eq (len big) 5000000) (if (eq (head big) 0) (eq (mll-last big) 4999999) false) false))
    (let churn (len (range 0 5000000)))
    (let b2 (if (eq churn 5000000) (eq (mll-sum big 0) 12499997500000) false))
    (let told (print (list "long-list" (len big) churn b1 b2)))
    (add (if b1 1 0) (if b2 2 0)))
