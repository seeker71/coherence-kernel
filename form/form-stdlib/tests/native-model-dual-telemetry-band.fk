; native-model-dual-telemetry-band.fk — truth separation without model load.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/line-grammar.fk form-stdlib/form-glass-telemetry-membrane.bml form-stdlib/native-model-dual-telemetry.bml
; Verdict 16777215: callable handle and semantic access epochs, catalog bytes,
; declared budget, derived substate, exact token position, owner lifetime,
; publisher heartbeat, model state bits, release tombstone, and future-owner
; four-hertz filesystem ingress remain distinct; mapped/materialized extents,
; owner runtime counters, missing cache/JIT doors, and the NodeID mint seam
; are explicit rather than inferred.

(do
    (defn nmdtb-bit (held weight) (if (eq held 1) weight 0))
    (defn nmdtb-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))
    (let publisher (nmdt-owner-publisher 1700000000))
    (let resident (nmdt-callable-sample "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth" publisher "ready" 1262 1700000100 1700000200))
    (let weight (nmdt-weight-catalog "weights.qwen3.8-flash-next.ud-q2_k_xl.unsloth" "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth" 78869128864 1700000100))
    (let budget (nmdt-budget-sample 103079215104))
    (let substate (nmdt-derived-substate "state.qwen3.8-flash-next.kv" "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth" "kv-substate" "attention-state" "ready" 1262 1700000100 1700000200 (list "memory" "model" "metal")))
    (let token (nmdt-token-position "tokens.qwen3.8-flash-next.position" "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth" 169425 "ready" 1262 1700000200))
    (let owner (nmdt-owner-correlation publisher 4242 1700000000 (nmdt-owner-incarnation 1700000000) 17 1700000400))
    (let heartbeat (nmdt-owner-heartbeat-sample owner))
    (let loaded (nmdt-model-state-sample "state.model.qwen3.8-flash-next.ud-q2_k_xl.unsloth.loaded" "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth" "loaded" 1 1262 1700000400))
    (let ownedLoaded (nmdt-model-state-sample-owned "state.model.qwen3.8-flash-next.ud-q2_k_xl.unsloth.loaded" "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth" publisher "loaded" 1 1262 1700000100))
    (let inactive (nmdt-model-state-sample "state.model.qwen3.8-flash-next.ud-q2_k_xl.unsloth.active" "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth" "active" 0 1262 1700000400))
    (let badOwner (nmdt-owner-correlation publisher 0 1700000000 (nmdt-owner-incarnation 1700000000) 17 1700000400))
    (let kv (nmdt-derived-substate "state.qwen3.8-flash-next.ud-q2_k_xl.unsloth.kv" "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth" "kv-substate" "attention-state" "ready" 1262 1700000100 1700000200 (list "memory" "model" "metal")))
    (let experts (nmdt-derived-substate "experts.qwen3.8-flash-next.ud-q2_k_xl.unsloth" "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth" "expert-pack" "moe-route" "ready" 1262 1700000100 1700000200 (list "memory" "model" "metal")))
    (let released (nmdt-release-tombstone "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth" 1 1700000300))
    (let mapped (nmdt-missing-extent-sample "mapped.qwen3.8-flash-next" "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth" publisher "mapped-bytes" "per-model-mapped-bytes" 1700000400 "model.carrier-per-model-mapped-bytes"))
    (let materialized (nmdt-missing-extent-sample "materialized.qwen3.8-flash-next" "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth" publisher "materialized-bytes" "per-model-materialized-bytes" 1700000400 "model.carrier-per-model-materialized-bytes"))
    (let counter (nmdt-owner-counter-sample "primitive.owner.dispatch-total" "primitive-counter" "form" publisher "primitive" "runtime-work-including-observer-cost" 97 1700000400 "fkwu.kernel-stat-0" (list "process" "model" "primitive" "health")))
    (let cacheMissing (nmdt-owner-missing-sample "cache.owner.walk-stats" "walk-cache" "form" publisher "cache" "hit-miss-and-age" 1700000400 "fkwu.walk-cache-stats" (list "process" "model" "cache" "health")))
    (let ephemeralMissing (nmdt-owner-missing-sample "memory.owner.ephemeral-render-string" "runtime-memory" "form" publisher "memory" "per-publication-temporary-string-reclaim" 1700000400 "kernel.ephemeral-render-string" (list "process" "model" "memory" "health")))
    (let nodeidMissing (nmdt-owner-nodeid-seam publisher 1700000400))
    (let metalPresent (nmdt-metal-counter "pipelines=23\ncpu_jit_dispatch=7\n" "cache.owner.metal-pipelines" "pipeline-cache" "cache" "compiled-metal-pipeline-handles" "pipelines" "metal_status.pipelines" publisher 1700000400 (list "process" "model" "cache" "metal" "health")))
    (let metalMissing (nmdt-metal-counter "metal_linked=false\n" "cache.owner.metal-pipelines" "pipeline-cache" "cache" "compiled-metal-pipeline-handles" "pipelines" "metal_status.pipelines" publisher 1700000400 (list "process" "model" "cache" "metal" "health")))
    (let stateClock (nmdt-state-clock 1700000100 1700000200 1700000300))
    (let activeClock (nmdt-state-active-at stateClock 1700000500))
    (let authority (read_file "form/form-stdlib/bml/native-model-dual-telemetry.bml"))
    (let residentSource (read_file "observe/native-model-dual-resident-live-run.fk"))
    (let cadenceSource (read_file "form/form-stdlib/native-model-owner-cadence.bml"))
    (let missingHeld (eq (sum (list
        (if (str_eq (fgtm-sample-source cacheMissing) "fkwu.walk-cache-stats") 1 0)
        (if (eq (fgtm-field-present? (fgtm-sample-capacity cacheMissing)) 0) 1 0)
        (if (str_eq (fgtm-sample-source nodeidMissing) "model.owner.telemetry-nodeid-mint") 1 0)
        (nmdtb-has (fgtm-channels-wire (fgtm-sample-channels counter)) "node-id-unbound")
        (if (eq (nmdtb-has (fgtm-sample-id heartbeat) ".s17") 0) 1 0)
        (fgtm-sample-valid? cacheMissing)
        (fgtm-sample-valid? nodeidMissing)
        (if (str_eq (fgtm-sample-source ephemeralMissing) "kernel.ephemeral-render-string") 1 0)
        (fgtm-sample-valid? ephemeralMissing))) 9))
    (let metalHeld (eq (sum (list
        (if (eq (nmdt-status-int "pipelines=23\n" "pipelines") 23) 1 0)
        (if (eq (fgtm-field-value (fgtm-sample-capacity metalPresent)) 23) 1 0)
        (if (str_eq (fgtm-sample-evidence metalPresent) "physical-live") 1 0)
        (if (eq (fgtm-field-present? (fgtm-sample-capacity metalMissing)) 0) 1 0)
        (if (str_eq (fgtm-sample-evidence metalMissing) "declared") 1 0)
        (if (str_eq (fgtm-sample-source metalMissing) "metal_status.pipelines") 1 0)
        (nmdtb-has authority "positive model carrier handle proves a callable context only")
        (nmdtb-has authority "model.owner.telemetry-nodeid-mint"))) 8))
    (let stateHeld (eq (sum (list
        (if (str_eq (fgtm-sample-lifecycle loaded) "active") 1 0)
        (if (str_eq (fgtm-sample-lifecycle inactive) "idle") 1 0)
        (if (eq (fgtm-field-value (fgtm-sample-handle loaded)) 1262) 1 0)
        (if (str_eq (fgtm-sample-purpose loaded) "loaded") 1 0)
        (if (str_eq (fgtm-sample-purpose inactive) "active") 1 0)
        (if (str_eq (fgtm-sample-owner ownedLoaded) publisher) 1 0)
        (if (eq (fgtm-field-value (fgtm-sample-write-epoch ownedLoaded)) 1700000100) 1 0)
        (fgtm-sample-valid? ownedLoaded))) 8))
    (let repairHeld (eq (sum (list
        (if (eq (nmdt-status-int
                "notpipelines=99\npipelines=23\n" "pipelines") 23) 1 0)
        (if (eq (nmdt-status-int "notpipelines=99\n" "pipelines") -1) 1 0)
        (if (eq (nmdt-state-loaded-epoch activeClock) 1700000100) 1 0)
        (if (eq (nmdt-state-prefilled-epoch activeClock) 1700000200) 1 0)
        (if (eq (nmdt-state-active-epoch activeClock) 1700000500) 1 0)
        (nmdtb-has authority "Object StateClock")
        (nmdtb-has residentSource
            "(nmdt-state-loaded-epoch clock)")
        (nmdtb-has residentSource
            "(nmdt-state-prefilled-epoch clock)")
        (nmdtb-has residentSource
            "(nmdt-state-active-at qStateClock activeEpoch)"))) 9))
    (sum (list
        (nmdtb-bit (and (str_eq (fgtm-sample-evidence resident) "physical-live") (and (eq (fgtm-field-value (fgtm-sample-handle resident)) 1262) (and (str_eq (fgtm-sample-kind resident) "model") (str_eq (fgtm-sample-purpose resident) "callable-model-context")))) 1)
        (nmdtb-bit (and (eq (fgtm-field-value (fgtm-sample-read-epoch resident)) 1700000100) (eq (fgtm-field-value (fgtm-sample-write-epoch resident)) 1700000200)) 2)
        (nmdtb-bit (and (str_eq (fgtm-sample-evidence weight) "catalog") (eq (fgtm-field-value (fgtm-sample-bytes weight)) 78869128864)) 4)
        (nmdtb-bit (and (str_eq (fgtm-sample-evidence budget) "declared") (eq (fgtm-field-value (fgtm-sample-capacity budget)) 103079215104)) 8)
        (nmdtb-bit (and (str_eq (fgtm-sample-evidence substate) "derived-window") (eq (fgtm-field-present? (fgtm-sample-bytes substate)) 0)) 16)
        (nmdtb-bit (and (str_eq (fgtm-sample-lifecycle released) "released") (eq (fgtm-field-present? (fgtm-sample-handle released)) 0)) 32)
        (nmdtb-bit (and (eq (fgtm-sample-valid? resident) 1) (and (eq (fgtm-sample-valid? substate) 1) (eq (fgtm-sample-valid? released) 1))) 64)
        (nmdtb-bit (and (eq (nmdtb-has authority "publication is not access") 1) (eq (nmdtb-has authority "clean close atomically replaces") 1)) 128)
        (nmdtb-bit (and (eq (fgtm-field-value (fgtm-sample-read-epoch substate)) 1700000100)
            (eq (fgtm-field-value (fgtm-sample-write-epoch released)) 1700000300)) 256)
        (nmdtb-bit (and (str_eq (fgtm-sample-kind token) "token-position")
            (and (eq (fgtm-field-value (fgtm-sample-capacity token)) 169425)
                (and (str_eq (fgtm-sample-purpose token) "context-position")
                    (eq (fgtm-sample-valid? token) 1)))) 512)
        (nmdtb-bit (and (eq (nmdt-owner-correlation? owner) 1)
            (and (str_eq (nmdt-owner-publisher-of owner) "models.dual-resident.i1700000000")
                (and (str_eq (nmdt-owner-incarnation-of owner) "i1700000000")
                    (and (eq (nmdt-owner-sequence owner) 17)
                        (eq (nmdt-owner-observed owner) 1700000400))))) 1024)
        (nmdtb-bit (and (eq (fgtm-sample-valid? heartbeat) 1)
            (and (eq (fgtm-field-value (fgtm-sample-handle heartbeat)) 4242)
                (and (eq (fgtm-field-value (fgtm-sample-capacity heartbeat)) 17)
                    (and (eq (fgtm-field-value (fgtm-sample-write-epoch heartbeat)) 1700000000)
                        (and (eq (fgtm-field-value (fgtm-sample-read-epoch heartbeat)) 1700000400)
                            (str_eq (fgtm-sample-owner heartbeat) publisher)))))) 2048)
        (nmdtb-bit stateHeld 4096)
        (nmdtb-bit (and (eq (nmdt-owner-correlation? badOwner) 0)
            (str_eq (head (nmdt-owner-heartbeat-sample badOwner)) "native-model-owner-heartbeat-invalid-v1")) 8192)
        (nmdtb-bit (and (eq (nmdtb-has authority "exact positive pid") 1)
            (and (eq (nmdtb-has authority "atomic filesystem command ingress every 250 milliseconds") 1)
                (and (eq (nmdtb-has authority "Object OwnerHeartbeat") 1)
                    (eq (nmdtb-has authority "Object ModelState") 1)))) 16384)
        (nmdtb-bit (and (eq (fgtm-field-present? (fgtm-sample-bytes kv)) 0)
            (and (eq (fgtm-field-present? (fgtm-sample-capacity kv)) 0)
                (and (eq (fgtm-field-present? (fgtm-sample-bytes experts)) 0)
                    (eq (fgtm-field-present? (fgtm-sample-capacity experts)) 0)))) 32768)
        (nmdtb-bit (and (ge (str_find residentSource "owner-pid-unavailable-before-model-open" 0) 0)
            (gt (str_find residentSource "(let slot (q4s-open prefix 128))" 0)
                (str_find residentSource "owner-pid-unavailable-before-model-open" 0))) 65536)
        (nmdtb-bit (and (ge (str_find residentSource
                "(defn nmdr-threeb-reasoning (session contextTokens)" 0) 0)
            (and (ge (str_find residentSource
                    "(nmg-observed session (NMGThreeB) 1 1 1 \"decode\" contextTokens" 0) 0)
                (ge (str_find residentSource
                    "(let active (nmdr-threeb-reasoning session" 0) 0))) 131072)
        (nmdtb-bit (and (lt (str_find residentSource "(read_line)" 0) 0)
            (and (ge (str_find residentSource "(let polled (nmdoc-poll-command publisher))" 0) 0)
                (and (ge (str_find residentSource "host-exec \"/bin/sleep 0.25\"" 0) 0)
                    (and (ge (str_find cadenceSource "def nmdoc-command-lock-path" 0) 0)
                        (lt (str_find residentSource "(let _telemetry (nmdr-publish" 0) 0))))) 262144)
        (nmdtb-bit (and (eq (fgtm-field-present? (fgtm-sample-bytes mapped)) 0)
            (and (eq (fgtm-field-present? (fgtm-sample-bytes materialized)) 0)
                (and (str_eq (fgtm-sample-source mapped) "model.carrier-per-model-mapped-bytes")
                    (and (str_eq (fgtm-sample-source materialized) "model.carrier-per-model-materialized-bytes")
                        (and (str_eq (fgtm-sample-evictability mapped) "inactive-only")
                            (eq (fgtm-sample-valid? materialized) 1)))))) 524288)
        (nmdtb-bit (and (eq (fgtm-field-value (fgtm-sample-capacity counter)) 97)
            (and (str_eq (fgtm-sample-owner counter) publisher)
                (and (eq (fgtm-field-value (fgtm-sample-read-epoch counter)) 1700000400)
                    (and (str_eq (fgtm-sample-evidence counter) "physical-live")
                        (and (str_eq (fgtm-sample-purpose counter) "runtime-work-including-observer-cost")
                            (eq (fgtm-sample-valid? counter) 1)))))) 1048576)
        (nmdtb-bit missingHeld 2097152)
        (nmdtb-bit metalHeld 4194304)
        (nmdtb-bit repairHeld 8388608))))
