; bmf-bp-r40-family-band.fk — proves the R40 op family resolves to real coordinates.
;
; R27 (receipts/2026-09-03-r27-control-invite-bp-coordinate.md) found ONE op
; (CONTROL-INVITE) that form/form-stdlib/bml.fk's underlying emit machinery
; passed to (bmf-bp "<op>") with no row in bmf-core.fk's local bmf-bp-table —
; an unregistered name silently fell to (make_nodeid 0 0 0 0), the same
; zero-fallback shape documented at that table for the six NL-pivot ops.
;
; R40 greps bml.fk's own t-emit calls against bmf-bp-table and finds THIRTEEN
; more names in the same hole: UE-CLASS, UE-INTERFACE, UE-LOOP, UE-SWITCH,
; UE-CASE, UE-TRY, UE-CATCH, UE-THROW, UE-JUMP-RETURN, UE-JUMP-BREAK,
; UE-JUMP-CONTINUE, UE-WRITE-ASSIGN, and "if" (BML's keyword-form ternary).
; Unlike CONTROL-INVITE, twelve of these already had real coordinates in
; blueprint-registry.json AND form-ontology-bp.fk — only bmf-core.fk's local
; mirror had never caught up. "if" was missing from blueprint-registry.json
; too (form-ontology-bp.fk carried it unregistered); this pass added that one
; canonical row and mirrored all thirteen into bmf-core.fk.
;
; Two independent proofs, per op:
;   PART 1 — direct resolver agreement: (bmf-bp op) now equals (fol-bp op)
;   (the two resolvers agree) AND neither is the null (0,0,0,0) fallback (the
;   agreement is not a shared miss).
;   PART 2 — end to end: real BML source, parsed by the actual bml-grammar
;   through g-parse-full, produces a node whose node_category is that same
;   real coordinate — not a table lookup in isolation, the compiler's own
;   output.
;
; preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml.fk

(do
    (let g (bml-grammar))
    (defn missing () (intern_trivial_string "__missing__"))
    (defn kid (node index)
        (if (gt (len (node_children node)) index)
            (nth (node_children node) index)
            (missing)))
    (defn cat? (node name)
        (node_eq (node_category node) (fol-bp name)))
    (defn score (actual bit)
        (if actual bit 0))
    (defn null-nid () (make_nodeid 0 0 0 0))
    (defn resolved? (name)
        (and (node_eq (bmf-bp name) (fol-bp name))
             (not (node_eq (bmf-bp name) (null-nid)))))

    ;; ── PART 1 — direct resolver agreement, one bit per op ──────────────
    (let p1
        (sum
            (list
                (score (resolved? "UE-CLASS")         1)
                (score (resolved? "UE-INTERFACE")      2)
                (score (resolved? "UE-LOOP")           4)
                (score (resolved? "UE-SWITCH")         8)
                (score (resolved? "UE-CASE")          16)
                (score (resolved? "UE-TRY")           32)
                (score (resolved? "UE-CATCH")         64)
                (score (resolved? "UE-THROW")        128)
                (score (resolved? "UE-JUMP-RETURN")  256)
                (score (resolved? "UE-JUMP-BREAK")   512)
                (score (resolved? "UE-JUMP-CONTINUE") 1024)
                (score (resolved? "UE-WRITE-ASSIGN") 2048)
                (score (resolved? "if")              4096))))

    ;; ── PART 2 — real parses through bml-grammar, one bit per op ────────

    ; class C { }  ->  do[ UE-CLASS ]
    (let t-class (g-parse-full g "class C { }"))
    (let n-class (kid t-class 0))

    ; interface I { }  ->  do[ UE-INTERFACE ]
    (let t-iface (g-parse-full g "interface I { }"))
    (let n-iface (kid t-iface 0))

    ; for ( x ; a ; y ) { }  ->  do[ UE-LOOP ]
    (let t-loop (g-parse-full g "for ( x ; a ; y ) { }"))
    (let n-loop (kid t-loop 0))

    ; int f ( ) { x = y ; }  ->  do[ fndef[ f, do[], do[ UE-WRITE-ASSIGN ] ] ]
    (let t-asn (g-parse-full g "int f ( ) { x = y ; }"))
    (let n-asn (kid (kid (kid t-asn 0) 2) 0))

    ; int f ( ) { x = if a then b else c ; }  ->  ... UE-WRITE-ASSIGN[ x, if[...] ]
    (let t-if (g-parse-full g "int f ( ) { x = if a then b else c ; }"))
    (let n-if (kid (kid (kid (kid t-if 0) 2) 0) 1))

    ; switch ( a ) { case 1 : x ; default : y ; }  ->  do[ UE-SWITCH[ a, UE-CASE, UE-CASE ] ]
    (let t-sw (g-parse-full g "switch ( a ) { case 1 : x ; default : y ; }"))
    (let n-sw (kid t-sw 0))
    (let n-case (kid n-sw 1))

    ; try { x ; } catch ( T e ) { y ; }  ->  do[ UE-TRY[ do[], UE-CATCH ] ]
    (let t-try (g-parse-full g "try { x ; } catch ( T e ) { y ; }"))
    (let n-try (kid t-try 0))
    (let n-catch (kid n-try 1))

    ; throw x ;  ->  do[ UE-THROW ]
    (let t-throw (g-parse-full g "throw x ;"))
    (let n-throw (kid t-throw 0))

    ; return x ;  ->  do[ UE-JUMP-RETURN ]
    (let t-ret (g-parse-full g "return x ;"))
    (let n-ret (kid t-ret 0))

    ; break ;  ->  do[ UE-JUMP-BREAK ]
    (let t-break (g-parse-full g "break ;"))
    (let n-break (kid t-break 0))

    ; continue ;  ->  do[ UE-JUMP-CONTINUE ]
    (let t-cont (g-parse-full g "continue ;"))
    (let n-cont (kid t-cont 0))

    (let p2
        (sum
            (list
                (score (cat? n-class "UE-CLASS")            8192)
                (score (cat? n-iface "UE-INTERFACE")        16384)
                (score (cat? n-loop "UE-LOOP")               32768)
                (score (cat? n-asn "UE-WRITE-ASSIGN")        65536)
                (score (cat? n-sw "UE-SWITCH")              131072)
                (score (cat? n-case "UE-CASE")               262144)
                (score (cat? n-try "UE-TRY")                524288)
                (score (cat? n-catch "UE-CATCH")            1048576)
                (score (cat? n-throw "UE-THROW")            2097152)
                (score (cat? n-ret "UE-JUMP-RETURN")        4194304)
                (score (cat? n-break "UE-JUMP-BREAK")       8388608)
                (score (cat? n-cont "UE-JUMP-CONTINUE")    16777216)
                (score (cat? n-if "if")                    33554432))))

    ; Expected total: 67108863  (8191 from part 1 + 67100672 from part 2)
    (add p1 p2))
