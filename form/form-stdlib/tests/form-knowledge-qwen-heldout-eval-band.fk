; form-knowledge-qwen-heldout-eval-band.fk -- pure, no model admission.
;
; This band may prove dataset/scorer behavior but can never create live credit:
; every synthetic report uses evaluation-fixture scope.
;
; preludes: form-stdlib/form-knowledge-qwen-heldout-eval.fk
; PROOF BAND (fkwu): 16383

(do
    (defn fkheb-bit (ok bit) (if ok bit 0))
    (defn fkheb-report-prefix ()
        "choice-task=knowledge\nchoice-match=1\nbackend=form-native-metal-jit\ntext:\n")
    (defn fkheb-raw-answer (answer)
        (str_concat (fkheb-report-prefix) answer))
    (defn fkheb-raw-query-answer (answer)
        (str_concat (fkheb-report-prefix)
            (str_concat (fkqt-open)
            (str_concat "look up the heldout fact"
            (str_concat (fkqt-close) answer)))))
    (defn fkheb-perfect-score (row)
        (fkhe-score row (fqt-knowledge-prompt (fkhe-prompt row))
            (fkhe-parse-resident-output
                (fkheb-raw-query-answer (fkhe-expected row))) 1))
    (defn fkheb-perfect-scores (rows)
        (if (eq (len rows) 0) (list)
            (cons (fkheb-perfect-score (head rows))
                  (fkheb-perfect-scores (tail rows)))))
    (defn fkheb-wrong-first-scores (rows)
        (if (eq (len rows) 0) (list)
            (cons
                (fkhe-score (head rows)
                    (fqt-knowledge-prompt (fkhe-prompt (head rows)))
                    (fkhe-parse-resident-output (fkheb-raw-answer "wrong")) 1)
                (fkheb-perfect-scores (tail rows)))))
    (defn fkheb-tamper-score-key (s)
        (list (nth s 0) (nth s 1) (nth s 2) (nth s 3) (nth s 4)
              "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
              (nth s 6) (nth s 7) (nth s 8) (nth s 9) (nth s 10)))
    (defn fkheb-tamper-row-source (r)
        (fkhe-row (fkhe-id r) (fkhe-family r) (fkhe-concept r)
            (fkhe-source r)
            "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
            (fkhe-prompt r) (fkhe-expected r) (fkhe-answer-sha r)))
    (defn fkheb-tamper-row-prompt (r)
        (fkhe-row (fkhe-id r) (fkhe-family r) (fkhe-concept r)
            (fkhe-source r) (fkhe-source-sha r)
            (str_concat (fkhe-prompt r) " changed")
            (fkhe-expected r) (fkhe-answer-sha r)))

    (defn form-knowledge-qwen-heldout-eval-band ()
        (do
            (let rows (fkhe-rows))
            (let first (head rows))
            (let perfect (fkheb-perfect-scores rows))
            (let wrong (fkheb-wrong-first-scores rows))
            (let perfect-report
                (fkhe-report (fkhe-fixture-scope) "synthetic-qwen" 1 1 perfect))
            (let wrong-report
                (fkhe-report (fkhe-fixture-scope) "synthetic-qwen" 1 1 wrong))
            (let plain
                (fkhe-parse-resident-output (fkheb-raw-answer "plain answer")))
            (let queried
                (fkhe-parse-resident-output
                    (fkheb-raw-query-answer "grounded answer")))
            (let refused
                (fkhe-parse-resident-output
                    (fkheb-raw-query-answer "generation refused: carrier closed")))
            (let malformed
                (fkhe-parse-resident-output "choice-task=knowledge\nno text marker"))
            (let tampered-rows (cons (fkheb-tamper-row-prompt first) (tail rows)))
            (add
                (fkheb-bit (eq (len rows) 15) 1)
            (add
                (fkheb-bit (and (eq (fkhe-family-coverage? rows) 1)
                                 (eq (fkhe-unique-strings? (fkhe-row-ids rows)) 1)) 2)
            (add
                (fkheb-bit (and (str_eq (fkhe-dataset-sha256 rows)
                                        (fkhe-dataset-seal))
                                 (eq (fkhe-dataset-valid?) 1)) 4)
            (add
                (fkheb-bit (eq (fkhe-leakage-audit-valid?
                                    (fkhe-leakage-audit rows)) 1) 8)
            (add
                (fkheb-bit (and (eq (fkhe-row-current?
                                        (fkheb-tamper-row-source first)) 0)
                                 (eq (fkhe-score-valid?
                                        (fkheb-tamper-score-key (head perfect)) rows) 0)) 16)
            (add
                (fkheb-bit (not (str_eq (fkhe-dataset-sha256 tampered-rows)
                                        (fkhe-dataset-seal))) 32)
            (add
                (fkheb-bit (and (str_eq (fkhe-output-answer plain) "plain answer")
                                 (eq (str_find (fkhe-output-answer plain)
                                              "backend=" 0) (sub 0 1))) 64)
            (add
                (fkheb-bit (and (str_eq (fkhe-output-answer queried)
                                        "grounded answer")
                                 (ge (str_find (fkhe-output-generated queried)
                                              (fkqt-open) 0) 0)) 128)
            (add
                (fkheb-bit (and (eq (fkhe-output-error refused) 1)
                                 (and (eq (fkhe-output-refusal refused) 1)
                                      (and (eq (nmfe-sha256?
                                                (fkhe-output-raw-sha refused)) 1)
                                           (eq (fkhe-output-error malformed) 1)))) 256)
            (add
                (fkheb-bit (and (eq (fkhe-complete-score-set? perfect rows) 1)
                                 (str_eq (nth (fkhe-score-observation (head perfect)) 3)
                                         (fkhe-answer-sha first))) 512)
            (add
                (fkheb-bit (and (eq (fkhe-report-overall95 perfect-report) 1)
                                 (and (eq (fkhe-report-family95 perfect-report) 1)
                                      (eq (fkhe-report-live-credit perfect-report) 0))) 1024)
            (add
                (fkheb-bit (and (eq (fkhe-report-overall95 wrong-report) 0)
                                 (and (eq (fkhe-report-family95 wrong-report) 0)
                                      (eq (fkhe-report-live-credit wrong-report) 0))) 2048)
            (add
                (fkheb-bit (and (eq (fkhe-at-least95? 950000) 1)
                                 (eq (fkhe-at-least95? 949999) 0)) 4096)
                (fkheb-bit (eq (fkhe-complete-score-set?
                                    (cons (head perfect) perfect) rows) 0) 8192))))))))))))))))

    (form-knowledge-qwen-heldout-eval-band))
