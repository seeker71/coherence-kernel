; Form tensor recipes on native Metal. Behavior and refusals travel together.
; preludes: form-stdlib/native-tensor.bml
; Verdict 255.
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/native-tensor-derived.fk

(do
    (defn mhb-score (ok bit) (if ok bit 0))
    (defn mhb-has (hay needle) (if (lt (str_find hay needle 0) 0) 0 1))
    (defn mhb-live? () (mhb-has (nt-status) "metal_linked=true"))
    (defn mhb-b (n) (byte_to_str n))
    (defn mhb-rep (b n acc)
        (if (le n 0) acc (mhb-rep b (sub n 1) (str_concat acc (mhb-b b)))))
    (defn mhb-q4k ()
        (str_concat (mhb-b 0) (str_concat (mhb-b 60)
        (str_concat (mhb-b 0) (str_concat (mhb-b 0)
        (str_concat (mhb-rep 1 4 "")
        (str_concat (mhb-rep 0 4 "")
        (str_concat (mhb-rep 1 4 "")
                    (mhb-rep 17 128 "")))))))))
    (defn mhb-q6k ()
        (str_concat (mhb-rep 17 128 "")
        (str_concat (mhb-rep 170 64 "")
        (str_concat (mhb-rep 1 16 "")
        (str_concat (mhb-b 0) (mhb-b 60))))))
    (defn mhb-q4k-path () "/tmp/fk-native-tensor-home-q4k.bin")
    (defn mhb-q6k-path () "/tmp/fk-native-tensor-home-q6k.bin")
    (defn mhb-prog (tok path off r c tail)
        (str_concat tok (str_concat " " (str_concat path
        (str_concat " " (str_concat (int_to_str off)
        (str_concat " " (str_concat (int_to_str r)
        (str_concat " " (str_concat (int_to_str c)
        (str_concat " " (str_concat tail " i32"))))))))))))
    (defn native-tensor-home-band ()
        (do
    (let w4 (fs-write-text (mhb-q4k-path) (mhb-q4k)))
    (let w6 (fs-write-text (mhb-q6k-path) (mhb-q6k)))
    (let live (mhb-live?))
    (let c0 (mhb-score (if (eq live 1) (if (eq w4 144) (eq w6 210) 0) 0) 1))
    (let c1 (mhb-score (if (eq live 1)
                           (eq (nt-eval (mhb-prog "q4k" (mhb-q4k-path) 0 1 256 "sum")) 256) 0) 2))
    (let c2 (mhb-score (if (eq live 1)
                           (eq (nt-eval (mhb-prog "q6k" (mhb-q6k-path) 0 1 256 "sum")) 256) 0) 4))
    (let c3 (mhb-score (if (eq live 1)
                           (nt-refused (mhb-prog "q4k" (mhb-q4k-path) 0 1 255 "sum") "q4k shape needs whole quant blocks") 0) 8))
    (let c4 (mhb-score (if (eq live 1)
                           (eq (nt-eval (mld-j "v2 3 4 f32" (mld-j (mld-rope-pair "1 f32") "sum 1000 mul i32"))) 2940) 0) 16))
    (let c5 (mhb-score (if (eq live 1)
                           (eq (nt-eval (mld-j "v2 1 0 r2 1 2 f32" (mld-j (mld-attn "v2 1 0 r2 2 1 f32" "v2 4 5 r2 1 2 f32") "sum i32"))) 9) 0) 32))
    (let c6 (mhb-score (if (eq live 1)
                           (eq (nt-eval (mld-j "v3 1 2 3 f32" (mld-j (mld-softmax) "sum i32"))) 1) 0) 64))
    (let c7 (mhb-score (if (eq live 1)
                           (eq (nt-eval "2 3 add") 5) 0) 128))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
    )
    (native-tensor-home-band))
