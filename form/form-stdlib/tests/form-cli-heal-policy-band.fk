; Expected 1023. Pure admission and candidate semantics, no living state writes.
; preludes: form-stdlib/bml/form-cli-heal-policy.bml
(do
    (let source "(defn value () 6)\n(value)\n")
    (let proposal "<heal-old>\n() 6\n</heal-old>\n<heal-new>\n() 7\n</heal-new>")
    (add
        (if (fh-check "0" "31\n" "" "31") 1 0)
        (add (if (eq (fh-check "9" "31\n" "" "31") 0) 2 0)
        (add (if (eq (fh-check "0" "251\n" "" "255") 0) 4 0)
        (add (if (eq (fh-check "0" "31\n" "warning: stale" "31") 0) 8 0)
        (add (if (str_eq (fh-proposal source proposal) "(defn value () 7)\n(value)\n") 16 0)
        (add (if (str_eq (fh-proposal source "preface <heal-old>\nx\n</heal-old>\n<heal-new>\ny\n</heal-new>") "") 32 0)
        (add (if (str_eq (fh-edit "xx" "x" "y") "") 64 0)
        (add (if (eq (fh-frontier "attempt" 1 1 1 0) 0) 128 0)
        (add (if (and (fh-frontier "attempt" 0 1 1 0) (eq (fh-frontier "attempt" 0 1 1 1) 0)) 256 0)
             (if (eq (len (fh-candidates "; (comment\n(defn value () \"(\\\"\")\n")) 0) 512 0)))))))))))
