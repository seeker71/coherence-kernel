; attuned-surprise-inquiry-band.fk — prediction relations enter the attuned
; braid without surprise magnitude, edge, or breath becoming a ranking axis.
;
; preludes: form-stdlib/core.fk form-stdlib/form-freq-check.fk form-stdlib/active-inference.fk form-stdlib/attuned-inquiry.fk form-stdlib/attuned-surprise-inquiry.fk
;
; Verdict 1023:
;   1    a matching prediction is carried honestly as not-surprised
;   2    a mismatch is carried honestly as surprised
;   4    the braid retains every event
;   8    arrival order survives; surprise does not jump the line
;   16   a heavier-but-carried surprise may wander without being demoted
;   32   a held surprising signal stays present and held
;   64   an uncarried surprising signal stays present and rests
;   128  expected play remains admissible at vitality zero
;   256  a moved matching event still becomes learning
;   512  a moved surprising event becomes learning without receiving a crown

(do
    (defn asib-open () (ati-edge "open" "consent-reversibility-organ" 1))
    (defn asib-hold () (ati-edge "hold" "consent-reversibility-organ" 1))
    (defn asib-light () (ati-breath 100 5 1))
    (defn asib-heavy () (ati-breath 100 90 1))
    (defn asib-uncarried () (ati-breath 100 101 1))

    (defn asib-expected ()
        (asi-event "expected" "receipt:prediction-confirmed" 7 "move"
                   "known" "known" (asib-open) (asib-light)))
    (defn asib-surprising-heavy ()
        (asi-event "surprising-heavy" "receipt:living-unknown" 7 "wander"
                   "quiet" "rain" (asib-open) (asib-heavy)))
    (defn asib-held ()
        (asi-event "held" "receipt:edge-reading" 9 "move"
                   "alone" "visitor" (asib-hold) (asib-light)))
    (defn asib-resting ()
        (asi-event "resting" "receipt:breath-reading" 9 "move"
                   "still" "motion" (asib-open) (asib-uncarried)))
    (defn asib-play ()
        (asi-event "play" "receipt:play" 0 "play"
                   "blue" "blue" (asib-open) (asib-light)))
    (defn asib-field ()
        (asi-braid
            (list (asib-expected) (asib-surprising-heavy) (asib-held)
                  (asib-resting) (asib-play))))

    (defn asib-c0 ()
        (if (eq (asi-event-surprised? (asib-expected)) 0) 1 0))
    (defn asib-c1 ()
        (if (eq (asi-event-surprised? (asib-surprising-heavy)) 1) 2 0))
    (defn asib-c2 ()
        (if (eq (len (asib-field)) 5) 4 0))
    (defn asib-c3 ()
        (if
            (and
                (str_eq (asi-signal-id (nth (asib-field) 0)) "expected")
                (str_eq (asi-signal-id (nth (asib-field) 1)) "surprising-heavy"))
            8 0))
    (defn asib-c4 ()
        (if
            (and
                (eq (asi-signal-surprised? (nth (asib-field) 1)) 1)
                (str_eq
                    (ati-movement-state-read
                        (asi-signal-movement (nth (asib-field) 1)))
                    "wander"))
            16 0))
    (defn asib-c5 ()
        (if
            (and
                (str_eq (asi-signal-id (nth (asib-field) 2)) "held")
                (str_eq
                    (ati-movement-state-read
                        (asi-signal-movement (nth (asib-field) 2)))
                    "hold"))
            32 0))
    (defn asib-c6 ()
        (if
            (and
                (str_eq (asi-signal-id (nth (asib-field) 3)) "resting")
                (str_eq
                    (ati-movement-state-read
                        (asi-signal-movement (nth (asib-field) 3)))
                    "rest"))
            64 0))
    (defn asib-c7 ()
        (if
            (and
                (eq (asi-signal-surprised? (nth (asib-field) 4)) 0)
                (str_eq
                    (ati-movement-state-read
                        (asi-signal-movement (nth (asib-field) 4)))
                    "play"))
            128 0))
    (defn asib-c8 ()
        (if
            (and
                (eq (ati-witness-changed (asi-witness (asib-expected))) 0)
                (str_eq (ati-witness-after (asi-witness (asib-expected))) "learn"))
            256 0))
    (defn asib-c9 ()
        (if
            (and
                (eq (ati-witness-changed (asi-witness (asib-surprising-heavy))) 1)
                (str_eq
                    (ati-witness-after (asi-witness (asib-surprising-heavy)))
                    "learn"))
            512 0))

    (defn attuned-surprise-inquiry-band ()
        (add (asib-c0)
        (add (asib-c1)
        (add (asib-c2)
        (add (asib-c3)
        (add (asib-c4)
        (add (asib-c5)
        (add (asib-c6)
        (add (asib-c7)
        (add (asib-c8) (asib-c9)))))))))))

    (attuned-surprise-inquiry-band))
