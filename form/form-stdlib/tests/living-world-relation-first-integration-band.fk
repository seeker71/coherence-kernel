; living-world-relation-first-integration-band.fk -- one edge crosses consent.
; Verdict 32767 proves fifteen response, indexed integration, and provenance claims.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-active-index.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/living-world-multilens-plan.fk form-stdlib/living-world-composition-outcome.fk form-stdlib/living-world-composition-voice.fk form-stdlib/living-world-relation-hypothesis.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-symbol-learning-witness.fk form-stdlib/tests/living-world-relation-learning-witness.fk form-stdlib/tests/living-world-relational-voice-witness.fk form-stdlib/tests/living-world-multilens-witness.fk form-stdlib/tests/living-world-composition-outcome-witness.fk form-stdlib/tests/living-world-relation-hypothesis-witness.fk form-stdlib/tests/living-world-relation-attestation-witness.fk

(do
    (let world LWRHA-WORLD)
    (let index (lwai-index world))
    (let proposal
        (lwai-relation-proposal-for
            world index LWRHA-OBSERVATION-FIRST 2))
    (let candidate (lwt-proposal-candidate proposal))
    (let participants (lwt-proposal-participants proposal))
    (let round
        (lwt-round world (lwo-field (list proposal))
            (lwo-empty-field) (lwrhw-integrated-round)))
    (let yes-round
        (lwt-round-receive round
            (list
                (lwrvw-relation-response
                    (lwrhw-source-h) (lwrhw-prov-h) proposal)
                (lwrvw-relation-response
                    (lwrhw-source-i) (lwrhw-prov-i) proposal))))
    (let response-world (lwt-round-world yes-round))
    (let response-index (lwai-index response-world))
    (let outcome (lwt-evaluate-proposal response-world proposal))
    (let integrated-round
        (lwai-integrate-relation yes-round proposal (lwrew-action)))
    (let integrated-world (lwt-round-world integrated-round))
    (let integrated-outcome (lwt-outcome-for integrated-round proposal))
    (let candidate-attributions
        (lwo-active-attributions-for integrated-world candidate))
    (let attribution-items (lwo-field-items candidate-attributions))
    (let edge (lwo-emergent-shape candidate))

    (let c1 (if (not (node_eq proposal (lwo-none))) 1 0))
    (let c2 (if (eq (lwo-field-size participants) 2) 2 0))
    (let c3 (if (and (eq (lwo-field-has? participants
                              (lwrhw-source-h)) 1)
                         (eq (lwo-field-has? participants
                              (lwrhw-source-i)) 1)) 4 0))
    (let c4 (if (eq (lwo-field-has? participants
                         (lwcow-source-g)) 0) 8 0))
    (let c5 (if (and (eq (lwt-source-response-status response-world
                              proposal (lwrhw-source-h)) 2)
                         (eq (lwt-source-response-status response-world
                              proposal (lwrhw-source-i)) 2)) 16 0))
    (let c6 (if (node_eq (lwt-outcome-status outcome)
                         (lwt-status-acknowledged)) 32 0))
    (let c7 (if (and (eq (lwt-outcome-yes outcome) 2)
                         (and (eq (lwt-outcome-no outcome) 0)
                              (eq (lwt-outcome-missing outcome) 0))) 64 0))
    (let c8 (if (eq (lwai-relation-candidate-current?
                         response-world response-index candidate) 1) 128 0))
    (let c9 (if (eq (lwai-emergent-ready?
                         response-index candidate) 1) 256 0))
    (let c10 (if (eq (lwo-active? integrated-world candidate) 1) 512 0))
    (let c11 (if (eq (lwo-field-size candidate-attributions) 2) 1024 0))
    (let c12 (if (and (eq (lwrh-source-in-attributions?
                               attribution-items (lwrhw-source-h)) 1)
                          (eq (lwrh-source-in-attributions?
                               attribution-items (lwrhw-source-i)) 1)) 2048 0))
    (let c13 (if (node_eq integrated-outcome outcome) 4096 0))
    (let c14 (if (eq (lwo-field-size
                          (lwt-round-outcomes integrated-round)) 1) 8192 0))
    (let c15 (if (and (node_eq (lwrl-edge-relation edge)
                               (lwrhw-relation-zeta))
                          (and (node_eq (lwrl-edge-left edge) (lwrvw-left))
                               (node_eq (lwrl-edge-right edge)
                                    (lwmpw-third)))) 16384 0))
    (lwrhw-sum
        (list c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)))
