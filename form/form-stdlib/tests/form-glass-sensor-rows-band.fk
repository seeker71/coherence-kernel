; form-glass-sensor-rows-band.fk — metric rows cross a gift frame as text and come back as rows.
;
; PURE apart from one gift frame this band offers under its own sensor name.
; Expected: 2047
; preludes: form-stdlib/form-glass-sensor-rows.bml

(do
    (defn sb-bit (ok bit) (if ok bit 0))
    (let r1 (fgo-int "host" "memory-free" "system memory free" 53 "percent" 0 "os-memory" "physical-live" "host-exec:/usr/bin/memory_pressure" "live" "health" "system-wide; not Metal working set"))
    (let r2 (fgo-sized "host" "disk-tps" "disk transactions" 7 "tps" 100 7 "disk" "physical-live" "host-exec:/usr/sbin/iostat" "live" "health" "last iostat sample"))
    (let r3 (fgo-unavailable "host" "compressor-pages" "compressor occupancy" "pages" "os-memory" "host-exec:/usr/bin/vm_stat.compressor" "health" "vm_stat did not expose compressor occupancy"))
    (let rows (list r1 r2 r3))

    ; the wire carries three rows; parsing gives three rows back with ids, values and presence intact
    (let wire (fgsr-wire "band" 1234567 rows))
    (let parsed (fgsr-parse wire))
    (let back (fgsr-parsed-rows parsed))
    (let b1 (sb-bit (and (eq (len back) 3) (str_eq (fgsr-parsed-sensor parsed) "band")) 1))
    (let b2 (sb-bit (and (str_eq (fgo-id (nth back 0)) "memory-free") (eq (fgo-int-value (nth back 0)) 53)) 2))
    (let b3 (sb-bit (and (str_eq (fgo-id (nth back 1)) "disk-tps") (and (eq (fgo-int-value (nth back 1)) 7) (eq (fgo-present? (nth back 1)) 1))) 4))
    (let b4 (sb-bit (and (str_eq (fgo-id (nth back 2)) "compressor-pages") (eq (fgo-present? (nth back 2)) 0)) 8))

    ; a give lands in the gift and a take returns the rows with a sequence
    (let given (fgsr-give "band-witness" 7654321 rows))
    (let held (fgsr-take "band-witness" (list)))
    (let b5 (sb-bit (and (eq (ggf-given? given) 1) (and (eq (len (fgsr-held-rows held)) 3) (and (eq (fgsr-held-epoch held) 7654321) (eq (node_eq (fgo-projection-node (nth (fgsr-held-rows held) 0)) (fgo-projection-node r1)) 1)))) 16))

    ; an unmoved frame is not re-read: the same held comes back, sequence and all
    (let again (fgsr-take "band-witness" held))
    (let b6 (sb-bit (and (eq (fgsr-held-seq again) (fgsr-held-seq held)) (eq (len (fgsr-held-rows again)) 3)) 32))

    ; a second give moves the sequence and the rows follow
    (let given2 (fgsr-give "band-witness" 7654322 (list r1)))
    (let moved (fgsr-take "band-witness" again))
    (let b7 (sb-bit (and (gt (fgsr-held-seq moved) (fgsr-held-seq again)) (eq (len (fgsr-held-rows moved)) 1)) 64))

    ; a sensor nobody gives is one row that names its door, never silence
    (let absent (fgsr-rows-or-absent "never-given" (fgsr-take "never-given" (list))))
    (let b8 (sb-bit (and (eq (len absent) 1) (and (eq (fgo-present? (head absent)) 0) (str_eq (fgo-id (head absent)) "sensor-never-given"))) 128))

    ; alive and silent: the frame carries its cadence; within three cadences the frame row is live, past them every row it gave is silent
    (let fresh (fgsr-rows-or-absent-at "band-witness" moved 7654322))
    (let b9 (sb-bit (and (eq (fgsr-held-cadence moved) 1000) (and (eq (fgsr-silent? moved 7654322) 0) (and (str_eq (fgo-lifecycle (head fresh)) "live") (str_eq (fgo-evidence (nth fresh 1)) "physical-live")))) 256))
    (let late (fgsr-rows-or-absent-at "band-witness" moved 7657400))
    (let b10 (sb-bit (and (eq (fgsr-silent? moved 7657400) 1) (and (str_eq (fgo-lifecycle (head late)) "silent") (and (str_eq (fgo-evidence (head late)) "silent") (and (str_eq (fgo-evidence (nth late 1)) "silent") (and (eq (fgo-int-value (nth late 1)) 53) (eq (len late) 2)))))) 512))
    ; a declared cadence travels as a cell: a 50 ms frame is silent after 151 ms; the lane glyph for silent differs from live
    (let given3 (fgsr-give-at "band-witness" 7654400 (list r1) 50))
    (let quick (fgsr-take "band-witness" moved))
    (let b11 (sb-bit (and (eq (fgsr-held-cadence quick) 50) (and (eq (fgsr-silent? quick 7654550) 0) (and (eq (fgsr-silent? quick 7654551) 1) (and (not (str_eq (fgd-truth-symbol "silent") (fgd-truth-symbol "physical-live"))) (not (str_eq (fgd-truth-symbol "contended") (fgd-truth-symbol "physical-live"))))))) 1024))

    (defn sb-standing-many (n) (if (eq n 0) 1 (and (fgsr-standing? "band-witness") (sb-standing-many (sub n 1)))))
    (let mappings (kernel_stat 41))
    (let standing (sb-standing-many 100))
    (let released (and standing (eq (kernel_stat 41) mappings)))
    (if released (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 (add b7 (add b8 (add b9 (add b10 b11)))))))))) 0))
