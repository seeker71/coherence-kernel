; form-cli-qwen-teach-layer-band.fk — embodied Form teach layer on frozen Qwen.
;
; Verdict 4194303:
;   1      twenty-nine curriculum names
;   2      base is form-cli Qwen Metal
;   4      generate door's prompt carries overlay and body; rung is adapter
;   8      LoRA stays unclaimed; adapter joint is live
;   16     choice cut stop undo timeout nothing sit in the curriculum
;   32     NodeID Blueprint Recipe Cell sit in the curriculum
;   64     overlay prefix is a real string
;   128    adapter kind is overlay, the DS4 shape
;   256    twenty-nine Form-native pairs cover every name; NVR complete stays 0
;   512    six heldout rows, zero train leakage
;   1024   timeout lines are one-hot and exact
;   2048   emit writes the witness file and reads back the same bytes
;   4096   slot-zero restores six zero lines
;   8192   heldout centroid beats majority (4 of 6 or better)
;   16384  overlay explicitly carries BML, custom BMF, live cursor, no tokenizer,
;          and the exact bounded knowledge-query envelope
;   32768  overlay carries exact choice/lane/cut, undo, timeout/exhaustion,
;          nothing/0/1, thought-kernel, and JIT evidence distinctions
;   65536  ten semantic pairs have readable source authorities
;   131072 semantic heldout sentences and family names have zero train leakage
;   262144 one heldout row exists for each of nine semantic control families
;   524288 semantic centroid identifies all nine heldout families
;   1048576 LoRA and native-carrier/live-JIT evidence stay explicitly unclaimed
;   2097152 exact pair glosses retain the behavioral control contracts
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-qwen-teach-layer.fk
; witnessed: 2026-08-24 -> 4194303

(do
    (defn fqb-score (ok bit) (if ok bit 0))
    (let c0 (fqt-check))
    (let want "0.0\n0.0\n0.0\n0.0\n50.0\n0.0\n")
    (let c1 (fqb-score (str_eq (fqt-lines 4 "50.0") want) 1024))
    (let idx (fqt-emit (fqt-slot-path) (fqt-heldout-of "timeout") "50.0"))
    (let back (read_file (fqt-slot-path)))
    (let c2 (fqb-score (if (eq idx 4) (str_eq back want) 0) 2048))
    (let _z (fqt-slot-zero (fqt-slot-path)))
    (let c3 (fqb-score (str_eq (read_file (fqt-slot-path)) (fqt-zero-lines)) 4096))
    (let c4 (fqb-score (ge (fqt-heldout-correct) 4) 8192))
    (let overlay (fqt-overlay-prefix))
    (let c5 (fqb-score
        (and (ge (str_find overlay "BML is executable" 0) 0)
         (and (ge (str_find overlay "custom BMF grammar" 0) 0)
          (and (ge (str_find overlay "live streaming cursor" 0) 0)
           (and (ge (str_find overlay "no tokenizer pre-step" 0) 0)
            (and (ge (str_find overlay "<|form:knowledge-query|>specific query<|/form:knowledge-query|>" 0) 0)
                 (eq (fqt-has "knowledge-query-token") 1)))))) 16384))
    (let c6 (fqb-score
        (and (ge (str_find overlay "choice returns the first non-nothing acknowledgement" 0) 0)
         (and (ge (str_find overlay "lanes retain all alternatives" 0) 0)
          (and (ge (str_find overlay "cut commits and prunes" 0) 0)
           (and (ge (str_find overlay "undo restores the exact checkpoint" 0) 0)
            (and (ge (str_find overlay "timeout is budget expiry with alternatives untried" 0) 0)
             (and (ge (str_find overlay "exhaustion means all alternatives were tried" 0) 0)
              (and (ge (str_find overlay "nothing is distinct from both 0 and 1" 0) 0)
               (and (ge (str_find overlay "thought kernels route by inquiry plane" 0) 0)
                    (ge (str_find overlay "native execution requires live carrier evidence" 0) 0))))))))) 32768))
    (let c7 (fqb-score
        (and (eq (len (fqt-semantic-sources)) 10)
         (and (eq (fqt-sources-cover?) 1)
              (eq (fqt-sources-readable?) 1))) 65536))
    (let c8 (fqb-score
        (and (eq (fqt-sem-exact-leakage) 0)
             (eq (fqt-sem-family-leakage) 0)) 131072))
    (let c9 (fqb-score
        (and (eq (fqt-sem-n-controls) 9)
             (eq (fqt-sem-heldout-n) 9)) 262144))
    (let c10 (fqb-score (eq (fqt-sem-heldout-correct) 9) 524288))
    (let c11 (fqb-score
        (and (eq (fqt-lora?) 0)
         (and (eq (fqt-native-carrier-executed?) 0)
              (eq (fqt-jit-live-evidence?) 0))) 1048576))
    (let c12 (fqb-score
        (and (ge (str_find (fqt-pair-gloss "choice-lanes-cut")
                           "lanes retain all results" 0) 0)
         (and (ge (str_find (fqt-pair-gloss "undo-checkpoints")
                            "exact stored checkpoint" 0) 0)
          (and (ge (str_find (fqt-pair-gloss "timeout-vs-exhaustion")
                             "alternatives untried" 0) 0)
           (and (ge (str_find (fqt-pair-gloss "nothing-zero-one")
                              "never becomes arithmetic or a branch condition" 0) 0)
            (and (ge (str_find (fqt-pair-gloss "thought-kernel-routing")
                               "missing evidence remains nothing" 0) 0)
                 (ge (str_find (fqt-pair-gloss "jit-plan-live-evidence")
                               "live native execution requires separate carrier evidence" 0) 0)))))) 2097152))
    (add c0
     (add c1
      (add c2
       (add c3
        (add c4
         (add c5
          (add c6
           (add c7
            (add c8
             (add c9
              (add c10
               (add c11 c12)))))))))))))
