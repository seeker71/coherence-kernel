; form-cli-qwen-teach-layer-band.fk — embodied Form teach layer on frozen Qwen.
;
; Verdict 33554431:
;   1      forty-five curriculum names
;   2      base is form-cli Qwen Metal
;   4      generate door's prompt carries overlay and body; rung is adapter
;   8      LoRA stays unclaimed; adapter joint is live
;   16     choice cut stop undo timeout nothing sit in the curriculum
;   32     NodeID Blueprint Recipe Cell sit in the curriculum
;   64     overlay prefix is a real string
;   128    adapter kind is overlay, the DS4 shape
;   256    thirty Form-native pairs cover every name; NVR complete stays 0
;   512    six heldout rows, zero train leakage
;   1024   timeout lines are one-hot and exact
;   2048   emit writes the witness file and reads back the same bytes
;   4096   slot-zero restores six zero lines
;   8192   heldout centroid beats majority (4 of 6 or better)
;   16384  overlay explicitly carries BML, custom BMF, live cursor, no tokenizer,
;          and the exact bounded knowledge-query envelope
;   32768  overlay carries exact choice/lane/cut, undo, timeout/exhaustion,
;          nothing/0/1, thought-kernel, and JIT evidence distinctions
;   65536  twelve semantic pairs have readable body sources
;   131072 semantic heldout sentences and family names have zero train leakage
;   262144 one heldout row exists for each of eleven semantic control families
;   524288 semantic centroid identifies all eleven heldout families
;   1048576 LoRA and native-carrier/live-JIT evidence stay explicitly unclaimed
;   2097152 exact pair glosses retain the behavioral control contracts
;   4194304 the current local-Qwen contract is anchor/path/cut, query 48 + reserve 32,
;           timeout != exhaustion, nothing != valid 0/1, seed counted once
;   8388608 post-observation answers preserve source words and requested shape
;   16777216 source-bound calls ask for an anchor only and forbid invented paths
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-qwen-teach-layer.fk
; witnessed: 2026-08-25 -> 33554431 direct fkwu

(do
    (defn fqb-score (ok bit) (if ok bit 0))
    (let c0 (fqt-check))
    (let want "0.0\n0.0\n0.0\n0.0\n50.0\n0.0\n")
    (let c1 (fqb-score (str_eq (fqt-lines 4 "50.0") want) 1024))
    (let idx (fqt-emit (fqt-slot-path) (fqt-heldout-of "timeout") "50.0"))
    (let back (read_file (fqt-slot-path)))
    (let c2 (fqb-score (if (eq idx 4) (str_eq back want) 0) 2048))
    (let _z (fqt-slot-zero (fqt-slot-path)))
    (let c3 (fqb-score (str_eq (read_file (fqt-slot-path)) (fqt-zero-lines)) 4096))
    (let c4 (fqb-score (ge (fqt-heldout-correct) 4) 8192))
    (let overlay (fqt-overlay-prefix))
    (let c5 (fqb-score
        (and (ge (str_find overlay "BML is an executable source" 0) 0)
         (and (ge (str_find overlay "custom BMF grammar" 0) 0)
          (and (ge (str_find overlay "live streaming cursor" 0) 0)
           (and (ge (str_find overlay "no tokenizer pre-step" 0) 0)
            (and (ge (str_find overlay (fqt-query-shape) 0) 0)
                 (eq (fqt-has "knowledge-query-token") 1)))))) 16384))
    (let c6 (fqb-score
        (and (ge (str_find overlay "choice returns the first non-nothing acknowledgement" 0) 0)
         (and (ge (str_find overlay "lanes retain all alternatives" 0) 0)
          (and (ge (str_find overlay "cut commits and prunes" 0) 0)
           (and (ge (str_find overlay "undo restores the exact checkpoint" 0) 0)
            (and (ge (str_find overlay "timeout is budget expiry with alternatives untried" 0) 0)
             (and (ge (str_find overlay "exhaustion means all alternatives were tried" 0) 0)
              (and (ge (str_find overlay "nothing is distinct from both 0 and 1" 0) 0)
               (and (ge (str_find overlay "thought kernels route by inquiry plane" 0) 0)
                (and (ge (str_find overlay
                                  "Any needed op or ordered flow" 0) 0)
                 (and (ge (str_find overlay
                                   "Hot and pure repeated use may earn cached crystallization" 0) 0)
                  (and (ge (str_find overlay
                                    "cold use or lost purity dissolves that specialization" 0) 0)
                       (ge (str_find overlay
                                    "Live execution requires carrier evidence" 0) 0)))))))))))) 32768))
    (let c7 (fqb-score
        ; 27 after the upstream join: every added teaching retains a readable
        ; public source cell behind it, retrieval-checked like the rest.
        (and (eq (len (fqt-semantic-sources)) 27)
         (and (eq (fqt-sources-cover?) 1)
              (eq (fqt-sources-readable?) 1))) 65536))
    (let c8 (fqb-score
        (and (eq (fqt-sem-exact-leakage) 0)
             (eq (fqt-sem-family-leakage) 0)) 131072))
    (let c9 (fqb-score
        (and (eq (fqt-sem-n-controls) 11)
             (eq (fqt-sem-heldout-n) 11)) 262144))
    (let c10 (fqb-score (eq (fqt-sem-heldout-correct) 11) 524288))
    (let c11 (fqb-score
        (and (eq (fqt-lora?) 0)
         (and (eq (fqt-native-carrier-executed?) 0)
              (eq (fqt-jit-live-evidence?) 0))) 1048576))
    (let c12 (fqb-score
        (and (ge (str_find (fqt-pair-gloss "choice-lanes-cut")
                           "lanes retain all results" 0) 0)
         (and (ge (str_find (fqt-pair-gloss "undo-checkpoints")
                            "exact stored checkpoint" 0) 0)
          (and (ge (str_find (fqt-pair-gloss "timeout-vs-exhaustion")
                             "alternatives untried" 0) 0)
           (and (ge (str_find (fqt-pair-gloss "nothing-zero-one")
                              "never becomes arithmetic or a branch condition" 0) 0)
            (and (ge (str_find (fqt-pair-gloss "thought-kernel-routing")
                               "missing evidence remains nothing" 0) 0)
                 (and (ge (str_find (fqt-pair-gloss "jit-plan-live-evidence")
                                    "CPU GPU Metal or MLX" 0) 0)
                  (and (ge (str_find (fqt-pair-gloss "jit-plan-live-evidence")
                                    "hot and pure repeated use may earn cached crystallization" 0) 0)
                   (and (ge (str_find (fqt-pair-gloss "jit-plan-live-evidence")
                                     "cold use or lost purity dissolves that specialization" 0) 0)
                    (and (ge (str_find (fqt-pair-gloss "jit-plan-live-evidence")
                                      "live native execution without separate carrier evidence" 0) 0)
                         (ge (str_find (fqt-pair-gloss "recipe-birth-exec")
                                      "original-ID and KV session" 0) 0)))))))))) 2097152))
    (let shape (fqt-query-shape))
    (let anchor-at (str_find shape "ANCHOR" 0))
    (let path-at (str_find shape "PATH" 0))
    (let close-at (str_find shape "<|/form:knowledge-query|>" 0))
    (let contract (fqt-two-phase-contract))
    (let c13 (fqb-score
        (and (eq (fqt-query-budget) 48)
         (and (eq (fqt-answer-reserve) 32)
          (and (lt anchor-at path-at)
           (and (lt path-at close-at)
            (and (ge (str_find contract "parser-ready close cuts unused query fuel" 0) 0)
             (and (ge (str_find contract "timeout with the answer alternative untried, not exhaustion" 0) 0)
              (and (ge (str_find contract "grounded 0 and 1 as valid values" 0) 0)
               (and (ge (str_find contract "count it exactly once in the current phase" 0) 0)
                    (ge (str_find (fqt-pair-gloss "knowledge-query-token")
                                  "non-borrowable 32-token answer reserve" 0) 0))))))))) 4194304))
    (let answer-contract (fqt-answer-contract))
    (let c14 (fqb-score
        (and (ge (str_find answer-contract
                           "Preserve the source's exact words" 0) 0)
             (and (ge (str_find answer-contract "Add no explanation" 0) 0)
                  (ge (str_find (fqt-knowledge-prompt "question")
                                answer-contract 0) 0))) 8388608))
    (let bound (fqt-bound-source-knowledge-prompt "question"))
    (let c15 (fqb-score
        (and (ge (str_find bound (fqt-bound-source-query-shape) 0) 0)
         (and (ge (str_find bound "Do not invent or append a source path" 0) 0)
         (and (lt (str_find bound "ANCHOR ; PATH" 0) 0)
              (lt (str_find bound "exact repo-relative path second" 0) 0))))
        16777216))
    (add c0
     (add c1
      (add c2
       (add c3
        (add c4
         (add c5
          (add c6
           (add c7
            (add c8
             (add c9
              (add c10
               (add c11 (add c12 (add c13 (add c14 c15))))))))))))))))
