; loop-lane-list-eq-band.fk — structural list equality runs native, and stays correct where it cannot.
;
; A feature every reference stdlib carries: comparing two lists by content. Written the natural way -- walk both lists,
; heads equal and recurse, or a length disagreement fails -- it is a two-list-parameter loop the lane crystallizes. For
; flat lists of ints it runs entirely native; where an element is itself a list or a string, the head comparison is a
; compare of two words the lane narrows to ints, a list or string word is odd and fails that narrow, and the call leaves
; for the walker, which compares by content (the day's eq-is-content reading). So the leaf handles the shallow and the
; walker the deep, and the answer is right either way -- no seed change, the capability already stands from the list door,
; head narrowing, and word equality. This band pins it.
;
; Verdict 15
; PROOF LEVEL: FOURTH-ARM ONLY (the transparent lanes are fkwu's MAP_JIT arm64 door; a defn's native state is the 8th field of its hot row)
; preludes: form-stdlib/core.fk
;
;   1   a two-list equality walk over flat int lists crystallizes (state 2) and agrees with a walker twin: same, differing, differing length, empty
;   2   a list of lists compares by content -- native leaf, the nested head falling to the walker -- right whether equal or not
;   4   a list of strings compares by content, right whether equal or not
;   8   the warm run over flat lists is under the walker twin's run of the same work
(do
    (defn lle-bit (ok bit) (if ok bit 0))
    (defn lle-state (name rows) (if (eq (len rows) 0) -99 (if (str_eq (nth (head rows) 1) name) (nth (head rows) 7) (lle-state name (tail rows)))))
    (defn lle-native (name) (lle-state name (kernel_page_hot (host_pid) 300)))
    (defn lle-lt? (a b) (if (lt (host_monotonic_ms) 0) false (lt a b))) ; a host clock: a door the lanes decline by meaning, so the twin walks
    (defn lle-mk (n acc) (if (le n 0) acc (lle-mk (sub n 1) (cons n acc))))
    ; the equality walk, and a twin the lanes decline (its condition holds a host clock)
    (defn lle-eq (a b) (if (nil? a) (nil? b) (if (nil? b) 0 (if (eq (head a) (head b)) (lle-eq (tail a) (tail b)) 0))))
    (defn lle-eq-w (a b) (if (lle-lt? 0 (len a)) (if (lle-lt? 0 (len b)) (if (eq (head a) (head b)) (lle-eq-w (tail a) (tail b)) 0) 0) (nil? b)))
    (let xs (lle-mk 40 (list)))
    (let ys (lle-mk 40 (list)))
    (let zs (lle-mk 39 (list)))
    (defn lle-h (a b n acc) (if (lle-lt? 0 n) (lle-h a b (sub n 1) (add acc (lle-eq a b))) acc))
    (let heat (lle-h xs ys 2200 0))
    (let eq-state (lle-native "lle-eq"))
    ; 1: flat
    (let flat-ok (if (eq (lle-eq xs ys) 1) (if (eq (lle-eq xs zs) 0) (if (eq (lle-eq (list) (list)) 1) (if (eq (lle-eq xs (list)) 0) (if (eq (lle-eq xs ys) (lle-eq-w xs ys)) (eq (lle-eq xs zs) (lle-eq-w xs zs)) false) false) false) false) false))
    ; 2: nested
    (let n1 (list (list 1 2) 3 (list 4)))
    (let n2 (list (list 1 2) 3 (list 4)))
    (let n3 (list (list 1 2) 3 (list 9)))
    (let nested-ok (if (eq (lle-eq n1 n2) 1) (if (eq (lle-eq n1 n3) 0) (if (eq (lle-eq n1 n2) (lle-eq-w n1 n2)) (eq (lle-eq n1 n3) (lle-eq-w n1 n3)) false) false) false))
    ; 4: strings
    (let s1 (list "alpha" "beta"))
    (let s2 (list "alpha" "beta"))
    (let s3 (list "alpha" "gamma"))
    (let str-ok (if (eq (lle-eq s1 s2) 1) (if (eq (lle-eq s1 s3) 0) (if (eq (lle-eq s1 s2) (lle-eq-w s1 s2)) (eq (lle-eq s1 s3) (lle-eq-w s1 s3)) false) false) false))
    ; 8: warm vs walker
    (defn lle-rep (a b n acc) (if (le n 0) acc (lle-rep a b (sub n 1) (add acc (lle-eq a b)))))
    (defn lle-rep-w (a b n acc) (if (lle-lt? 0 n) (lle-rep-w a b (sub n 1) (add acc (lle-eq-w a b))) acc))
    (let w0 (host_monotonic_ms)) (let warm (lle-rep xs ys 20000 0)) (let w1 (host_monotonic_ms))
    (let k0 (host_monotonic_ms)) (let cold (lle-rep-w xs ys 20000 0)) (let k1 (host_monotonic_ms))
    (let told (print (list "eq-state" eq-state "flat" flat-ok "nested" nested-ok "str" str-ok "ms" (sub w1 w0) (sub k1 k0))))
    (let b1 (lle-bit (if (eq eq-state 2) flat-ok false) 1))
    (let b2 (lle-bit nested-ok 2))
    (let b3 (lle-bit str-ok 4))
    (let b4 (lle-bit (if (eq warm cold) (lt (sub w1 w0) (sub k1 k0)) false) 8))
    (add b1 (add b2 (add b3 b4))))
