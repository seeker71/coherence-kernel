; qwen4exp-flash-next-mixed-quant-band.fk — every storage type in the
; exact UD-Q2_K_XL manifest has an explicit resident Metal route.
;
; preludes: form/native/metal/qwen4exp-flash-next-quant-jit.fk form/form-stdlib/tests/iq2xs-msl-band.fk
;
; Verdict 8191. This is a source/geometry band; the sibling live observer asks
; Metal to compile the whole unit and dispatches the three importance-quants.

(do
    (let unit (q4eq-all-msl))
    (let c0 (iq2xmb-bit (iq2xmb-all (list
        (eq (q4eq-all-supported? 0) 1) (eq (q4eq-all-supported? 8) 1)
        (eq (q4eq-all-supported? 12) 1) (eq (q4eq-all-supported? 13) 1)
        (eq (q4eq-all-supported? 14) 1) (eq (q4eq-all-supported? 17) 1)
        (eq (q4eq-all-supported? 18) 1) (eq (q4eq-all-supported? 20) 1)
        (eq (q4eq-all-supported? 30) 1))) 1))
    (let c1 (iq2xmb-bit (iq2xmb-all (list
        (eq (q4eq-all-supported? 1) 0) (eq (q4eq-all-supported? 16) 0)
        (eq (q4eq-all-supported? 40) 0))) 2))
    (let c2 (iq2xmb-bit (iq2xmb-all (list
        (eq (q4eq-all-bytes 0 256) 1024)
        (eq (q4eq-all-bytes 30 256) 512)
        (eq (q4eq-all-bytes 8 256) 272))) 4))
    (let c3 (iq2xmb-bit (iq2xmb-all (list
        (eq (q4eq-all-bytes 12 256) 144)
        (eq (q4eq-all-bytes 13 256) 176)
        (eq (q4eq-all-bytes 14 256) 210))) 8))
    (let c4 (iq2xmb-bit (iq2xmb-all (list
        (eq (q4eq-all-bytes 17 256) 74)
        (eq (q4eq-all-bytes 18 256) 98)
        (eq (q4eq-all-bytes 20 256) 144))) 16))
    (let c5 (iq2xmb-bit (iq2xmb-all (list
        (eq (q4eq-all-bytes 8 255) 0)
        (eq (q4eq-all-bytes 12 255) 0)
        (eq (q4eq-all-bytes 17 0) 0)
        (eq (q4eq-all-bytes 41 256) 0))) 32))
    (let c6 (iq2xmb-bit (iq2xmb-all (list
        (eq (iq2xmb-count unit "q4_flash_q5_laneoff") 1)
        (eq (iq2xmb-count unit "q4_flash_bf16_laneoff") 1)
        (eq (iq2xmb-count unit "q4_flash_f32_laneoff") 1))) 64))
    (let c7 (iq2xmb-bit (iq2xmb-all (list
        (eq (iq2xmb-count unit "q4_flash_iq2_slot4off") 1)
        (eq (iq2xmb-count unit "q4_flash_iq3_slot4") 1)
        (eq (iq2xmb-count unit "q4_flash_iq4nl_laneoff") 1))) 128))
    (let c8 (iq2xmb-bit (iq2xmb-all (list
        (eq (iq2xmb-count unit "form_q4k_matvec_lane_f32") 1)
        (eq (iq2xmb-count unit "form_q6k_matvec_lane_f32") 1)
        (eq (iq2xmb-count unit "q4_flash_q8_wide") 1))) 256))
    (let c9 (iq2xmb-bit (iq2xmb-all (list
        (eq (iq2xmb-count unit "constant uchar iq2xs_grid") 1)
        (eq (iq2xmb-count unit "constant uint iq3xxs_grid") 1)
        (eq (iq2xmb-count unit "constant char iq4nl_values") 1))) 512))
    (let c10 (iq2xmb-bit (iq2xmb-all (list
        (eq (iq2xmb-count unit "ulong(id) * ulong(width)") 1)
        (eq (iq2xmb-count unit "static inline float iq4nl_w(device const uchar* qb, ulong idx)") 1))) 1024))
    (let c11 (iq2xmb-bit (iq2xmb-all (list
        (eq (iq2xmb-count unit "constant uint& ebase [[buffer(5)]]") 10)
        (eq (iq2xmb-count unit "#include <metal_stdlib>") 1)
        (gt (iq2xmb-count unit "metal::simd_sum") 8))) 2048))
    (let c12 (iq2xmb-bit (iq2xmb-all (list
        (eq (iq2xmb-count unit "q4_flash_iq2_selected_slot4") 1)
        (eq (iq2xmb-count unit "q4_flash_iq3_selected_slot4") 1)
        (eq (iq2xmb-count unit "q4_flash_iq4nl_selected_slot4") 1)
        (eq (iq2xmb-count unit "q4_flash_iq2_selected_batch") 1)
        (eq (iq2xmb-count unit "q4_flash_iq3_selected_batch") 1)
        (eq (iq2xmb-count unit "q4_flash_iq4nl_selected_batch") 1)
        (eq (iq2xmb-count unit "ulong(ids[rank])*ulong(rows)*ulong(cols)") 6))) 4096))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6
        (add c7 (add c8 (add c9 (add c10 (add c11 c12)))))))))))))
