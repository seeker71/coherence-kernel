; living-world-active-learning-voice-witness.fk -- a successor tissue grown
; from self-derived enquiries reaches an independently learned surface and
; context through separate membranes before native voice may render.
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-shared-field-channel.fk form-stdlib/living-world-generative-continuation.fk form-stdlib/living-world-hypothesis-transfer.fk observe/live-call-framebuffer.fk form-stdlib/tests/living-world-recipe-hypothesis-witness.fk form-stdlib/tests/living-world-hypothesis-tissue-witness.fk form-stdlib/tests/living-world-hypothesis-enquiry-witness.fk form-stdlib/tests/living-world-prospective-suite-witness.fk form-stdlib/tests/living-world-active-learning-loop-witness.fk form-stdlib/tests/living-world-hypothesis-transfer-witness.fk

(let LWHLV-RESULT (bp "LWHLV-RESULT"))

(defn lwhlv-application-dependencies (world)
    (do
        (let bindings (lwhtw-application-bindings))
        (lwt-receive-stream world
            (list
                (lwphw-entry-k (lwhtw-application-scope))
                (lwphw-entry-l (lwhtw-application-scope))
                (lwphw-entry-k (lwhtw-application-left))
                (lwphw-entry-l (lwhtw-application-left))
                (lwphw-entry-k (lwhtw-application-right))
                (lwphw-entry-l (lwhtw-application-right))
                (lwphw-entry-k (lwhtw-application-left-projection))
                (lwphw-entry-l (lwhtw-application-left-projection))
                (lwphw-entry-k (lwhtw-application-right-projection))
                (lwphw-entry-l (lwhtw-application-right-projection))
                (lwphw-entry-k (lwhtw-binding-left bindings))
                (lwphw-entry-l (lwhtw-binding-left bindings))
                (lwphw-entry-k (lwhtw-binding-right bindings))
                (lwphw-entry-l (lwhtw-binding-right bindings))
                (lwphw-entry-k (lwhtw-before))
                (lwphw-entry-l (lwhtw-before))))))

(defn lwhlv-application (tissue hypothesis)
    (lwht-application tissue hypothesis (lwhtw-application-bindings)
        (lwhtw-before) (lwo-none) (lwlc-layers (empty))
        (lwo-empty-field) (lwo-none) (lwo-none) (lwo-none)
        (lwhtw-evidence)))

; children: active-loop result, application/execution, symbol candidate,
; transfer candidate/plan, transition observation/candidate, prediction,
; expression plan, native trace, voiced world.
(defn lwhlv-result
    (active application execution symbol-candidate transfer-candidate
     transfer-plan transition transition-candidate prediction expression trace
     world)
    (intern_node LWHLV-RESULT
        (list active application execution symbol-candidate transfer-candidate
              transfer-plan transition transition-candidate prediction
              expression trace world)))

(defn lwhlv-run ()
    (do
        ; The active loop owns and streams its own first framebuffer window.
        (let active (lwhlw-run))
        (let active-world (nth (node_children active) 0))
        (let arriving (nth (node_children active) 2))
        (let tissue (lwps-candidate-model arriving))
        (let tissue-shape (lwo-emergent-shape tissue))
        (let hypothesis
            (head (lwo-field-items (lwht-tissue-hypotheses tissue-shape))))

        (let started
            (lcfb-open-stream "living-world-active-learning-voice" "form-native"
                "lwhlv-run" "successor-to-native-voice"
                "form/form-stdlib/tests/living-world-active-learning-voice-witness.fk"
                60 1))
        (let with-dependencies
            (lwhlv-application-dependencies active-world))
        (let application (lwhlv-application tissue hypothesis))
        (let application-world
            (lwt-receive-stream with-dependencies
                (list (lwphw-entry-m application)
                      (lwphw-entry-n application))))
        (let execution
            (lwht-execution-for application-world application 2 (lwo-none)))
        (let execution-frame
            (lcfb-call-stream "living-world-active-learning-voice" "execute"
                "leave" "form-native" "lwht-execution-for"
                "identity-new-bindings:1:execution-current:1" 1 started
                "form/form-stdlib/tests/living-world-active-learning-voice-witness.fk"
                74 1))

        ; Vocabulary is a separate participant offer over output identity.
        (let output (lwht-execution-output execution))
        (let symbol-observation (lwhtrw-symbol-observation output))
        (let symbol-observed
            (lwt-receive-stream application-world
                (list
                    (lwhtrw-entry LWHTRW-SOURCE-A symbol-observation)
                    (lwhtrw-entry LWHTRW-SOURCE-B symbol-observation))))
        (let symbol-proposal
            (lwsl-proposal-for symbol-observed symbol-observation 2))
        (let symbol-round
            (lwt-round symbol-observed (lwo-field (list symbol-proposal))
                (lwo-empty-field) (lwo-none)))
        (let symbol-responded
            (lwt-round-receive symbol-round
                (list
                    (lwhtrw-response-entry LWHTRW-SOURCE-A symbol-proposal)
                    (lwhtrw-response-entry LWHTRW-SOURCE-B symbol-proposal))))
        (let symbol-integrated
            (lwsl-integrate symbol-responded symbol-proposal LWHTRW-ACTION))
        (let symbol-world (lwt-round-world symbol-integrated))
        (let symbol-candidate (lwt-proposal-candidate symbol-proposal))
        (let symbol-frame
            (lcfb-call-stream "living-world-active-learning-voice" "surface"
                "leave" "form-native" "lwsl-integrate"
                "participant-surface-current:1" 2 started
                "form/form-stdlib/tests/living-world-active-learning-voice-witness.fk"
                103 1))

        ; Context transfer is inert until its own unanimous boundary.
        (let transfer-offer (lwhtrw-offer execution))
        (let transfer-observed
            (lwt-receive-stream symbol-world
                (list
                    (lwhtrw-entry LWHTRW-SOURCE-C LWHTRW-CONTEXT-A)
                    (lwhtrw-entry LWHTRW-SOURCE-D LWHTRW-CONTEXT-A)
                    (lwhtrw-entry LWHTRW-SOURCE-C LWHTRW-CONTEXT-B)
                    (lwhtrw-entry LWHTRW-SOURCE-D LWHTRW-CONTEXT-B)
                    (lwhtrw-entry LWHTRW-SOURCE-C (lwhtrw-context))
                    (lwhtrw-entry LWHTRW-SOURCE-D (lwhtrw-context))
                    (lwhtrw-entry LWHTRW-SOURCE-C transfer-offer)
                    (lwhtrw-entry LWHTRW-SOURCE-D transfer-offer))))
        (let transfer-proposal
            (lwhtr-proposal-for transfer-observed transfer-offer 2))
        (let transfer-plan
            (lwo-emergent-shape (lwt-proposal-candidate transfer-proposal)))
        (let transfer-round
            (lwt-round transfer-observed (lwo-field (list transfer-proposal))
                (lwo-empty-field) symbol-integrated))
        (let transfer-responded
            (lwt-round-receive transfer-round
                (list
                    (lwhtrw-response-entry LWHTRW-SOURCE-C transfer-proposal)
                    (lwhtrw-response-entry LWHTRW-SOURCE-D transfer-proposal))))
        (let transfer-integrated
            (lwhtr-integrate transfer-responded transfer-proposal
                LWHTRW-ACTION))
        (let transfer-world (lwt-round-world transfer-integrated))
        (let transfer-candidate (lwt-proposal-candidate transfer-proposal))
        (let transition
            (lwhtr-transition-successor transfer-world transfer-candidate))
        (let transfer-frame
            (lcfb-call-stream "living-world-active-learning-voice" "transfer"
                "leave" "form-native" "lwhtr-integrate"
                "inert-transition:1:installed-transition:0" 3 started
                "form/form-stdlib/tests/living-world-active-learning-voice-witness.fk"
                142 1))

        ; A third participant pair independently offers the generated
        ; transition before any prediction or voice can use it.
        (let transition-observed
            (lwt-receive-stream transfer-world
                (list
                    (lwhtrw-entry LWHTRW-SOURCE-E transition)
                    (lwhtrw-entry LWHTRW-SOURCE-F transition))))
        (let transition-proposal
            (lwtf-proposal-for transition-observed transition 2))
        (let transition-round
            (lwt-round transition-observed
                (lwo-field (list transition-proposal))
                (lwo-empty-field) transfer-integrated))
        (let transition-responded
            (lwt-round-receive transition-round
                (list
                    (lwhtrw-response-entry LWHTRW-SOURCE-E
                        transition-proposal)
                    (lwhtrw-response-entry LWHTRW-SOURCE-F
                        transition-proposal))))
        (let transition-integrated
            (lwtf-integrate transition-responded transition-proposal
                LWHTRW-ACTION))
        (let voiced-world (lwt-round-world transition-integrated))
        (let transition-candidate
            (lwt-proposal-candidate transition-proposal))
        (let prediction
            (lwtf-predict voiced-world (lwhtrw-context)
                (lwhtrw-alternatives) (lwhtrw-unknown)))
        (let expression
            (lwtx-plan-for voiced-world prediction
                (lwo-field (list symbol-candidate))))
        (let trace
            (lwsg-generate-observed voiced-world (lwhtrw-request) started 4))
        (let voice-frame
            (lcfb-call-stream "living-world-active-learning-voice" "voice"
                "leave" "form-native" "lwsg-generate-observed"
                (lcfb-cat (list "turns:"
                    (int_to_str (len (lwsg-turn-items (lwsg-trace-turns trace))))
                    ":voice-bytes:"
                    (int_to_str (str_len (lwsg-trace-rendered trace)))
                    ":remote:0")) 8 started
                "form/form-stdlib/tests/living-world-active-learning-voice-witness.fk"
                183 1))
        (lwhlv-result active application execution symbol-candidate
            transfer-candidate transfer-plan transition transition-candidate
            prediction expression trace voiced-world)))
