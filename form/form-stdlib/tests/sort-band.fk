; sort-band.fk — one sort home: ints, strings by bytes, and a stable sort by integer key. 5 bits -> 31.
; A gap in learn/native-turn-queue.jsonl: the native code lane is asked to turn it green.
; Verdict 31
; preludes: form-stdlib/core.fk form-stdlib/sort.fk
(do
    (defn sb-bit (ok n) (if ok n 0))
    ; total over any value: whatever sort answers, the band ends
    (defn sb-list? (x) (str_eq (value_kind x) "list"))
    (defn sb-same-ints? (xs ys)
        (if (not (sb-list? xs)) false
            (if (nil? xs) (nil? ys)
                (if (nil? ys) false
                    (and (str_eq (value_kind (head xs)) "int") (and (eq (head xs) (head ys)) (sb-same-ints? (tail xs) (tail ys))))))))
    (defn sb-same-strs? (xs ys)
        (if (not (sb-list? xs)) false
            (if (nil? xs) (nil? ys)
                (if (nil? ys) false
                    (and (str_eq (value_kind (head xs)) "string") (and (str_eq (head xs) (head ys)) (sb-same-strs? (tail xs) (tail ys))))))))
    (defn sb-key (row) (head row))
    (defn sb-label (row) (nth row 1))
    (defn sb-down (n acc) (if (eq n 0) acc (sb-down (sub n 1) (cons (sub 501 n) acc))))
    (defn sb-up (n acc) (if (eq n 0) acc (sb-up (sub n 1) (cons n acc))))
    (let ints (sb-same-ints? (sort-ints (list 5 3 9 1 3)) (list 1 3 3 5 9)))
    (let empty-in (nil? (sort-ints (list))))
    (let strs (sb-same-strs? (sort-strs (list "b" "abc" "ab" "a" "B")) (list "B" "a" "ab" "abc" "b")))
    (let keyed (sort-by (list (list 2 "x") (list 1 "y") (list 2 "z") (list 1 "w")) sb-key))
    (let stable (and (sb-list? keyed) (sb-same-strs? (map sb-label keyed) (list "y" "w" "x" "z"))))
    (let many (sb-same-ints? (sort-ints (sb-down 500 (list))) (sb-up 500 (list))))
    (add (sb-bit ints 1) (add (sb-bit empty-in 2) (add (sb-bit strs 4) (add (sb-bit stable 8) (sb-bit many 16))))))
