; loop-lane-string-door-band.fk — a string crosses into the transparent loop lane by its pointer, and the
; leaf keeps the walker's bound.
;
; Urs, 2026-09-12: the core recipes belong in BML, not the C kernel, generated once per platform to the
; hardware's shape and reused as O(1) blocks, cold-vs-warm gaps being the signal. The gap was measured
; first: str_to_int, the one named recipe living in Form, ran 10x slower than its siblings in C, because
; the loop lane's admit set had no string op. This band holds the door that opened: a loop-shaped recipe
; over str_byte_at crystallizes (fk_f64_loop_pulse reads a string frame slot as type 3; fk_f64_admit takes
; tag 28 over a string parameter; fk_f64_emit loads the byte after an unsigned compare against the length
; the tag-194 door placed at frame word 9 + k; -1 past the end, as the walker's arm answers).
;
; Verdict 127
; PROOF LEVEL: FOURTH-ARM ONLY (the transparent loop lane is fkwu's MAP_JIT arm64 door; kernel_stat 49 counts its loops)
; preludes: form-stdlib/core.fk
;
;   1   the recipe crystallizes: kernel_stat 49 rises by one across the hot run
;   2   the hot sum equals the walker's sum, byte for byte (the walker's answer comes from a shape the lane declines)
;   4   an index past the end answers -1 through the leaf, as the walker's str_byte_at arm does
;   8   a negative index answers -1 through the leaf (the unsigned compare reads it as past the end)
;   16  a string parameter passed through the tail call unchanged keeps naming the same bytes every iteration
;   32  arithmetic over the string parameter is declined: the recipe stays the walker's and still answers right
;   64  the warm run is faster than the walker's run of the same work (the signal, kept as a bit: less than)
(do
    (defn lsd-bit (ok bit) (if ok bit 0))
    ; the lane's shape: (if <lt> <self tail call> <exit>); s is a string parameter, the rest ints
    (defn lsd-sum (s i len acc) (if (lt i len) (lsd-sum s (add i 1) len (add acc (str_byte_at s i))) acc))
    ; the walker's answer by a shape the lane declines (a nested if)
    (defn lsd-walk (s i len acc) (if (lt i len) (if (lt i 0) acc (lsd-walk s (add i 1) len (add acc (str_byte_at s i)))) acc))
    ; every read past the end
    (defn lsd-past (s i len acc) (if (lt i len) (lsd-past s (add i 1) len (add acc (str_byte_at s (add i 1000000)))) acc))
    ; every read at a negative index
    (defn lsd-neg (s i len acc) (if (lt i len) (lsd-neg s (add i 1) len (add acc (str_byte_at s (sub i 1000000)))) acc))
    ; arithmetic over the string parameter: the admit arm declines it and the walker answers (a byte compared, counted as a bool)
    (defn lsd-arith (s i len acc) (if (lt i len) (lsd-arith s (add i 1) len (add acc (if (eq (str_byte_at s i) 32) 1 0))) acc))
    (defn lsd-rep (s n acc) (if (le n 0) acc (lsd-rep s (sub n 1) (add acc (lsd-sum s 0 (str_len s) 0)))))
    (defn lsd-rep-walk (s n acc) (if (le n 0) acc (lsd-rep-walk s (sub n 1) (add acc (lsd-walk s 0 (str_len s) 0)))))
    (defn lsd-mk (n acc) (if (le n 0) acc (lsd-mk (sub n 1) (str_concat acc "the quick brown fox jumps over the lazy dog 0123456789 "))))
    (let s (lsd-mk 4 ""))
    (let len (str_len s))
    (let before (kernel_stat 49))
    (let w0 (host_monotonic_ms)) (let hot (lsd-rep s 4000 0)) (let w1 (host_monotonic_ms))
    (let after (kernel_stat 49))
    (let k0 (host_monotonic_ms)) (let walk (lsd-rep-walk s 4000 0)) (let k1 (host_monotonic_ms))
    (let past (lsd-past s 0 len 0))
    (let neg (lsd-neg s 0 len 0))
    (let spaces (lsd-arith s 0 len 0))
    (let told (print (list "len" len "hot-ms" (sub w1 w0) "walk-ms" (sub k1 k0) "loops" before after "sum" hot walk "past" past "neg" neg "spaces" spaces)))
    (let b1 (lsd-bit (eq after (add before 1)) 1))
    (let b2 (lsd-bit (eq hot walk) 2))
    (let b3 (lsd-bit (eq past (sub 0 len)) 4))
    (let b4 (lsd-bit (eq neg (sub 0 len)) 8))
    ; the string rides unchanged: the sum over the same string, hot, equals len times the per-call sum
    (let b5 (lsd-bit (eq hot (mul 4000 (lsd-walk s 0 len 0))) 16))
    ; the string holds 4 x 10 spaces (one after each of the nine words and the digits): counted right whether
    ; hot or not. Read off the band's own line first: a hand count said 11 a line and the body said 10.
    (let b6 (lsd-bit (eq spaces 40) 32))
    (let b7 (lsd-bit (lt (sub w1 w0) (sub k1 k0)) 64))
    (add b1 (add b2 (add b3 (add b4 (add b5 (add b6 b7)))))))
