; living-world-shared-field-channel-witness.fk -- public cells drive one live
; session-outcome -> tending -> transition -> learned-surface -> answer field.
; Fixture surfaces and digests live here, never in the channel organ.
; preludes: form-stdlib/core.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/native-model-evidence.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-session-observation.fk form-stdlib/living-world-session-learning.fk form-stdlib/living-world-shared-field-channel.fk form-stdlib/tests/living-world-session-learning-witness.fk

(let LWSFW-OTHER-ACTION (bp "LWSFW-OTHER-ACTION"))
(let LWSFW-QUERY-PROV   (bp "LWSFW-QUERY-PROV"))
(let LWSFW-REVOKE-PROV  (bp "LWSFW-REVOKE-PROV"))

(defn lwsfw-cell (kind) (intern_node kind (empty)))
(defn lwsfw-other-action () (lwsfw-cell LWSFW-OTHER-ACTION))
(defn lwsfw-query-provenance () (lwsfw-cell LWSFW-QUERY-PROV))
(defn lwsfw-revoke-provenance () (lwsfw-cell LWSFW-REVOKE-PROV))

(defn lwsfw-world (step)
    (lwsf-state-world (lwsf-step-state step)))

(defn lwsfw-question () (lwsf-question (lwsnw-context)))
(defn lwsfw-question-entry (source)
    (lwt-entry
        (lwo-offer source (lwsnw-interface) 1
            (lwsfw-question) (lwsfw-query-provenance) 1)
        (lwsnw-action)))

(defn lwsfw-response (proposal ack provenance)
    (lwt-response proposal ack provenance))
(defn lwsfw-response-entry (source proposal ack provenance)
    (lwt-entry
        (lwo-offer source (lwsnw-interface) 1
            (lwsfw-response proposal ack provenance) provenance 1)
        (lwsnw-action)))

(defn lwsfw-revocation-entry (source target)
    (lwt-entry
        (lwo-offer source (lwsnw-interface) 1
            (lwo-revocation target source
                (lwsnw-reason) (lwsfw-revoke-provenance))
            (lwsfw-revoke-provenance) 1)
        (lwsnw-action)))

(defn lwsfw-outcome-for (settlement proposal)
    (lwt-outcome-for-items
        (lwo-field-items (lwsf-settlement-outcomes settlement)) proposal))

(defn lwsfw-apply (state input started ordinal)
    (lwsf-apply-observed state input started ordinal))

(defn lwsfw-run (started)
    (do
        (let state-0 (lwsf-open 2 (lwsnw-action)))

        ; Unknown shape and mismatched action are content-blind refusals.
        (let unknown-step
            (lwsfw-apply state-0 (lwsnw-evidence) started 1))
        (let mismatch-step
            (lwsfw-apply (lwsf-step-state unknown-step)
                (lwsf-session (lwsnw-offer-a)
                    (lwsnw-consent (lwsnw-source-a))
                    (lwsfw-other-action) 0)
                started 2))

        ; Immediate silence enters as evidence; expired default ZERO does not
        ; collapse into that evidence cell.
        (let immediate-step
            (lwsfw-apply (lwsf-step-state mismatch-step)
                (lwsf-session (lwsnw-immediate-nothing-offer)
                    (lwsnw-consent (lwsnw-source-e))
                    (lwsnw-action) 0)
                started 3))
        (let expired-step
            (lwsfw-apply (lwsf-step-state immediate-step)
                (lwsf-session (lwsnw-offer-a)
                    (lwsnw-expiring-consent
                        (lwsnw-source-f) (oac-zero))
                    (lwsnw-action) 100)
                started 4))

        ; Two independent sources recur on one outcome.  The proposal is
        ; visible but waits for their explicit responses.
        (let offer-a-step
            (lwsfw-apply (lwsf-step-state expired-step)
                (lwsf-session (lwsnw-offer-a)
                    (lwsnw-consent (lwsnw-source-a))
                    (lwsnw-action) 0)
                started 5))
        (let offer-b-step
            (lwsfw-apply (lwsf-step-state offer-a-step)
                (lwsf-session (lwsnw-offer-a)
                    (lwsnw-consent (lwsnw-source-b))
                    (lwsnw-action) 0)
                started 6))
        (let proposal-a
            (lwsnw-find-proposal
                (lwsf-settlement-proposals
                    (lwsf-step-settlement offer-b-step))
                (lwsnw-outcome-a)))
        (let waiting-a
            (lwsfw-outcome-for
                (lwsf-step-settlement offer-b-step) proposal-a))

        ; The field can be asked before integration.  It returns NOTHING while
        ; retaining the actively observed possibility, alternatives, unknown.
        (let before-question-step
            (lwsfw-apply (lwsf-step-state offer-b-step)
                (lwsfw-question-entry (lwsnw-source-e)) started 7))
        (let before-answer (lwsf-step-answer before-question-step))

        ; ONE + explicit NOTHING waits.  A later ONE from the same source
        ; supersedes its silence without erasing the earlier response cell.
        (let response-a-step
            (lwsfw-apply (lwsf-step-state before-question-step)
                (lwsfw-response-entry (lwsnw-source-a) proposal-a
                    (oac-one (lwt-proposal-candidate proposal-a))
                    (lwsnw-prov-a))
                started 8))
        (let response-a-outcome
            (lwsfw-outcome-for
                (lwsf-step-settlement response-a-step) proposal-a))
        (let silence-b-step
            (lwsfw-apply (lwsf-step-state response-a-step)
                (lwsfw-response-entry (lwsnw-source-b) proposal-a
                    (oac-nothing) (lwsnw-prov-b))
                started 9))
        (let silence-b-outcome
            (lwsfw-outcome-for
                (lwsf-step-settlement silence-b-step) proposal-a))
        (let response-b-step
            (lwsfw-apply (lwsf-step-state silence-b-step)
                (lwsfw-response-entry (lwsnw-source-b) proposal-a
                    (oac-one (lwt-proposal-candidate proposal-a))
                    (lwsnw-prov-b))
                started 10))
        (let integrated-a
            (lwt-proposal-candidate proposal-a))

        ; The structural answer is now current but explicitly unvoiced.
        (let structural-question-step
            (lwsfw-apply (lwsf-step-state response-b-step)
                (lwsfw-question-entry (lwsnw-source-e)) started 11))
        (let structural-answer
            (lwsf-step-answer structural-question-step))
        (let derivation-a
            (lwsnw-find-derivation
                (lwsf-answer-prediction structural-answer)
                (lwsnw-outcome-a)))

        ; The surface exists only as two new participant offers about this
        ; exact derivation, followed by their explicit proposal responses.
        (let symbol-c-step
            (lwsfw-apply (lwsf-step-state structural-question-step)
                (lwsnw-symbol-entry
                    (lwsnw-source-c) (lwsnw-prov-c) derivation-a)
                started 12))
        (let symbol-d-step
            (lwsfw-apply (lwsf-step-state symbol-c-step)
                (lwsnw-symbol-entry
                    (lwsnw-source-d) (lwsnw-prov-d) derivation-a)
                started 13))
        (let symbol-proposal
            (lwsnw-find-symbol-proposal-items
                (lwo-field-items
                    (lwsf-settlement-proposals
                        (lwsf-step-settlement symbol-d-step)))
                derivation-a))
        (let symbol-c-response-step
            (lwsfw-apply (lwsf-step-state symbol-d-step)
                (lwsfw-response-entry (lwsnw-source-c) symbol-proposal
                    (oac-one (lwt-proposal-candidate symbol-proposal))
                    (lwsnw-prov-c))
                started 14))
        (let symbol-c-outcome
            (lwsfw-outcome-for
                (lwsf-step-settlement symbol-c-response-step)
                symbol-proposal))
        (let symbol-d-response-step
            (lwsfw-apply (lwsf-step-state symbol-c-response-step)
                (lwsfw-response-entry (lwsnw-source-d) symbol-proposal
                    (oac-one (lwt-proposal-candidate symbol-proposal))
                    (lwsnw-prov-d))
                started 15))
        (let symbol-candidate
            (lwt-proposal-candidate symbol-proposal))
        (let voiced-question-step
            (lwsfw-apply (lwsf-step-state symbol-d-response-step)
                (lwsfw-question-entry (lwsnw-source-f)) started 16))
        (let voiced-answer (lwsf-step-answer voiced-question-step))

        ; A second outcome is allowed beside the first.  Explicit dissent
        ; prevents its integration until the dissenter revokes that response
        ; and independently offers ONE.
        (let outcome-b-c-step
            (lwsfw-apply (lwsf-step-state voiced-question-step)
                (lwsf-session (lwsnw-offer-b)
                    (lwsnw-consent (lwsnw-source-c))
                    (lwsnw-action) 0)
                started 17))
        (let outcome-b-d-step
            (lwsfw-apply (lwsf-step-state outcome-b-c-step)
                (lwsf-session (lwsnw-offer-b)
                    (lwsnw-consent (lwsnw-source-d))
                    (lwsnw-action) 0)
                started 18))
        (let proposal-b
            (lwsnw-find-proposal
                (lwsf-settlement-proposals
                    (lwsf-step-settlement outcome-b-d-step))
                (lwsnw-outcome-b)))
        (let response-c-b-step
            (lwsfw-apply (lwsf-step-state outcome-b-d-step)
                (lwsfw-response-entry (lwsnw-source-c) proposal-b
                    (oac-one (lwt-proposal-candidate proposal-b))
                    (lwsnw-prov-c))
                started 19))
        (let dissent-response
            (lwsfw-response proposal-b (oac-zero) (lwsnw-prov-d)))
        (let dissent-d-step
            (lwsfw-apply (lwsf-step-state response-c-b-step)
                (lwsfw-response-entry (lwsnw-source-d) proposal-b
                    (oac-zero) (lwsnw-prov-d))
                started 20))
        (let dissent-outcome
            (lwsfw-outcome-for
                (lwsf-step-settlement dissent-d-step) proposal-b))
        (let revoke-dissent-step
            (lwsfw-apply (lwsf-step-state dissent-d-step)
                (lwsfw-revocation-entry
                    (lwsnw-source-d) dissent-response)
                started 21))
        (let response-d-b-step
            (lwsfw-apply (lwsf-step-state revoke-dissent-step)
                (lwsfw-response-entry (lwsnw-source-d) proposal-b
                    (oac-one (lwt-proposal-candidate proposal-b))
                    (lwsnw-prov-d))
                started 22))
        (let integrated-b (lwt-proposal-candidate proposal-b))
        (let plural-question-step
            (lwsfw-apply (lwsf-step-state response-d-b-step)
                (lwsfw-question-entry (lwsnw-source-f)) started 23))
        (let plural-answer (lwsf-step-answer plural-question-step))

        ; The original owner can release only its support.  The first branch
        ; becomes non-current at threshold two; the unrelated branch survives.
        (let revoke-a-step
            (lwsfw-apply (lwsf-step-state plural-question-step)
                (lwsfw-revocation-entry (lwsnw-source-a)
                    (lwsn-receipt-payload
                        (lwsf-step-boundary offer-a-step)))
                started 24))
        (let final-question-step
            (lwsfw-apply (lwsf-step-state revoke-a-step)
                (lwsfw-question-entry (lwsnw-source-e)) started 25))
        (let final-answer (lwsf-step-answer final-question-step))
        (let repeated-question-step
            (lwsfw-apply (lwsf-step-state final-question-step)
                (lwsfw-question-entry (lwsnw-source-e)) started 26))
        (let repeated-answer (lwsf-step-answer repeated-question-step))
        (let events (framebuffer-events))

        (list
            (if (eq (lwsf-state? state-0) 1) 1 0)
            (if (and (eq (oac-zero? (lwsf-step-ack unknown-step)) 1)
                     (eq (lwo-field-size
                            (lwo-world-cells (lwsfw-world unknown-step))) 0)) 1 0)
            (if (and (eq (oac-zero? (lwsf-step-ack mismatch-step)) 1)
                     (eq (lwo-field-size
                            (lwo-world-attributions
                                (lwsfw-world mismatch-step))) 0)) 1 0)
            (if (and (eq (oac-nothing?
                            (lwsn-offer-ack
                                (lwsf-session-offer
                                    (lwsf-step-input immediate-step)))) 1)
                     (eq (lwsn-evidence?
                            (lwsn-receipt-payload
                                (lwsf-step-boundary immediate-step))) 1)) 1 0)
            (if (and (eq (oac-zero? (lwsf-step-ack expired-step)) 1)
                     (eq (oac-time-outcome?
                            (lwsn-receipt-timing
                                (lwsf-step-boundary expired-step))) 1)) 1 0)
            (if (eq (lwo-field-size
                        (lwo-active-attributions-for
                            (lwsfw-world offer-b-step)
                            (lwsn-receipt-payload
                                (lwsf-step-boundary offer-a-step)))) 2) 1 0)
            (if (and (not (node_eq proposal-a (lwo-none)))
                     (eq (lwo-field-size
                            (lwt-proposal-participants proposal-a)) 2)) 1 0)
            (if (and (node_eq (lwt-outcome-status waiting-a)
                              (lwt-status-waiting))
                     (eq (lwt-outcome-missing waiting-a) 2)) 1 0)
            (if (and (eq (oac-nothing?
                            (lwsf-answer-ack before-answer)) 1)
                     (eq (lwo-field-size
                            (lwtf-prediction-possibilities
                                (lwsf-answer-prediction before-answer))) 1)) 1 0)
            (if (and (eq (lwt-outcome-yes response-a-outcome) 1)
                     (eq (lwt-outcome-missing response-a-outcome) 1)) 1 0)
            (if (and (node_eq (lwt-outcome-status silence-b-outcome)
                              (lwt-status-waiting))
                     (eq (lwt-outcome-silence silence-b-outcome) 1)) 1 0)
            (if (and (eq (lwtf-integrated-current?
                            (lwsfw-world response-b-step) integrated-a) 1)
                     (eq (lwo-field-size
                            (lwsf-settlement-integrated
                                (lwsf-step-settlement response-b-step))) 1)) 1 0)
            (if (and (eq (oac-one?
                            (lwsf-answer-ack structural-answer)) 1)
                     (and (eq (lwo-field-size
                                (lwtx-plan-surfaces
                                    (lwsf-answer-plan structural-answer))) 0)
                          (eq (lwo-field-size
                                (lwtx-plan-unvoiced
                                    (lwsf-answer-plan structural-answer))) 1))) 1 0)
            (if (and (not (node_eq symbol-proposal (lwo-none)))
                     (eq (lwo-field-size
                            (lwt-proposal-participants symbol-proposal)) 2)) 1 0)
            (if (and (node_eq (lwt-outcome-status symbol-c-outcome)
                              (lwt-status-waiting))
                     (eq (lwt-outcome-missing symbol-c-outcome) 1)) 1 0)
            (if (eq (lwsl-integrated-current?
                        (lwsfw-world symbol-d-response-step)
                        symbol-candidate) 1) 1 0)
            (if (and (eq (oac-one?
                            (lwsf-answer-voice-ack voiced-answer)) 1)
                     (and (str_eq
                            (lwtx-surface-text
                                (head (lwo-field-items
                                    (lwtx-plan-surfaces
                                        (lwsf-answer-plan voiced-answer)))))
                            "arrives")
                          (eq (lwo-field-size
                                (lwtx-plan-unvoiced
                                    (lwsf-answer-plan voiced-answer))) 0))) 1 0)
            (if (and (not (node_eq proposal-b (lwo-none)))
                     (not (node_eq integrated-a
                                   (lwt-proposal-candidate proposal-b)))) 1 0)
            (if (and (node_eq (lwt-outcome-status dissent-outcome)
                              (lwt-status-dissented))
                     (eq (lwtf-integrated-current?
                            (lwsfw-world dissent-d-step)
                            (lwt-proposal-candidate proposal-b)) 0)) 1 0)
            (if (and (eq (oac-one?
                            (lwsf-step-ack revoke-dissent-step)) 1)
                     (eq (lwo-active-by?
                            (lwsfw-world revoke-dissent-step)
                            dissent-response (lwsnw-source-d)) 0)) 1 0)
            (if (eq (lwtf-integrated-current?
                        (lwsfw-world response-d-b-step) integrated-b) 1) 1 0)
            (if (and (eq (oac-node?
                            (lwsf-answer-ack plural-answer)) 1)
                     (and (eq (lwo-field-size
                                (lwtf-prediction-nexts
                                    (lwsf-answer-prediction plural-answer))) 2)
                          (and (eq (lwo-field-size
                                    (lwtx-plan-surfaces
                                        (lwsf-answer-plan plural-answer))) 1)
                               (eq (lwo-field-size
                                    (lwtx-plan-unvoiced
                                        (lwsf-answer-plan plural-answer))) 1)))) 1 0)
            (if (and (eq (lwo-field-has?
                            (lwsf-answer-alternatives plural-answer)
                            (lwsnw-outcome-a)) 1)
                     (not (node_eq
                            (lwsf-answer-unknown plural-answer)
                            (lwo-none)))) 1 0)
            (if (and (eq (oac-one? (lwsf-step-ack revoke-a-step)) 1)
                     (and (eq (lwtf-integrated-current?
                                (lwsfw-world revoke-a-step) integrated-a) 0)
                          (eq (lwtf-integrated-current?
                                (lwsfw-world revoke-a-step) integrated-b) 1))) 1 0)
            (if (and (eq (oac-one?
                            (lwsf-answer-ack final-answer)) 1)
                     (and (eq (lwsnw-prediction-has?
                                (lwsf-answer-prediction final-answer)
                                (lwsnw-outcome-b)) 1)
                          (eq (lwsnw-prediction-has?
                                (lwsf-answer-prediction final-answer)
                                (lwsnw-outcome-a)) 0))) 1 0)
            (if (and (eq (oac-nothing?
                            (lwsf-answer-voice-ack final-answer)) 1)
                     (eq (lwo-field-size
                            (lwtx-plan-unvoiced
                                (lwsf-answer-plan final-answer))) 1)) 1 0)
            (if (and (eq (lwsn-trace-current?
                            (lwsfw-world plural-question-step)
                            (lwsf-answer-trace plural-answer)) 1)
                     (and (eq (lwsn-trace-current?
                                (lwsfw-world final-question-step)
                                (lwsf-answer-trace plural-answer)) 0)
                          (eq (lwsn-trace-current?
                                (lwsfw-world final-question-step)
                                (lwsf-answer-trace final-answer)) 1))) 1 0)
            (if (node_eq
                    (lwsf-state-previous
                        (lwsf-step-state final-question-step))
                    (lwsf-step-state revoke-a-step)) 1 0)
            (if (ge (len events) 53) 1 0)
            (if (node_eq final-answer repeated-answer) 1 0)
            (if (and (eq (lwo-field-size
                            (lwsf-answer-symbols final-answer)) 1)
                     (eq (lwtx-plan-current?
                            (lwsfw-world final-question-step)
                            (lwsf-answer-plan final-answer)) 1)) 1 0))))
