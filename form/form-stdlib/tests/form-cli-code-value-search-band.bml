// Deterministic policy replay with a mock checker; real semantic execution is
// covered by form-bml-value-search-band.bml. No reply is attributed to a model.
// preludes: form-stdlib/bml/form-cli-code-memory.bml
section [form.bml] {
 class CodeValueSearchBand {
  def cvsb-need(ok,name) = if ok then 1 else form_error(str_concat("code value search: ",name));
  def cvsb-source(counter,docs) {
   record_set(counter,"source",add(record_get(counter,"source"),1));
   cvsb-need(str_eq(nth(fat-find-doc(docs,"checks.bml"),2),"caller-owned"),"checker receives unchanged locked document");
   list(str_eq(nth(fat-find-doc(docs,"candidate.bml"),2),record_get(counter,"expected")),"mock behavior result");
  }
  def cvsb-final(counter,docs) { record_set(counter,"final",add(record_get(counter,"final"),1)); list(0,"final checker must not replace source checker"); }
  def cvsb-malformed(counter,docs) = list(1);
  def cvsb-pass(counter,docs) = list(1,"final source checked");
 }
 let source = "section [form.bml] { def result(flag) = flag; def support(flag) = not(flag); }";
 let expected = "section [form.bml] { def result(flag) = not(flag); def support(flag) = not(flag); }";
 let docs = list(list("code","candidate.bml",source),list("locked","checks.bml","caller-owned"));
 let counter = record_new(0); record_set(counter,"source",0); record_set(counter,"final",0); record_set(counter,"expected",expected);
 let checker = list(cvsb-final,counter,cvsb-source,counter);
 let state = fcap-open-direct-code("Repair behavior",docs,list("candidate.bml"));
 let wire = "{\"tool\":\"rehearse-bml\",\"arguments\":[\"candidate.bml\",\"8\"],\"input\":\"\"}";
 let repaired = fcap-step(state,wire,checker);
 cvsb-need(str_eq(nth(fat-find-doc(fcap-docs(repaired),"candidate.bml"),2),expected),"passing candidate changes resident source");
 cvsb-need(and(eq(fcap-checks(repaired),2),and(eq(record_get(counter,"source"),2),eq(record_get(counter,"final"),0))),"actual source callbacks counted");
 cvsb-need(and(eq(fcap-calls(repaired),1),str_eq(fcap-stage(repaired),"implement")),"tool success leaves review to the workflow");
 cvsb-need(and(value_eq(nth(repaired,2),docs),value_eq(fat-find-doc(fcap-docs(repaired),"checks.bml"),nth(docs,1))),"original and locked evidence preserved");
 let outer = parse-json("tool-observation",fcap-note(repaired));
 let trace = parse-json("search-observation",fcap-string(outer,"stdout"));
 let rows = node_children(json-object-get(trace,"attempts"));
 cvsb-need(and(eq(len(rows),2),and(eq(node_value(json-object-get(head(rows),"passed")),0),eq(node_value(json-object-get(nth(rows,1),"passed")),1))),"failure and passing candidate both retained");
 cvsb-need(str_eq(fcap-string(nth(rows,1),"source_sha256"),hex-encode(sha256-stream-string(expected))),"passing observation binds exact source");
 let automatic = fcap-step(state,"{\"tool\":\"rehearse-bml\",\"arguments\":[\"candidate.bml\"]}",checker);
 cvsb-need(and(eq(fcap-checks(automatic),2),str_eq(nth(fat-find-doc(fcap-docs(automatic),"candidate.bml"),2),expected)),"one path uses the native check allowance");
 let before = record_get(counter,"source");
 let review = fcap-step(fcap-open-direct-review("Inspect",docs),wire,checker);
 let locked = fcap-step(fcap-open-direct-code("Repair",docs,list("checks.bml")),wire,checker);
 cvsb-need(and(value_eq(fcap-docs(review),docs),and(value_eq(fcap-docs(locked),docs),eq(record_get(counter,"source"),before))),"unauthorized targets never invoke checker");
 let exhausted = fcap-step(state,"{\"tool\":\"rehearse-bml\",\"arguments\":[\"candidate.bml\",\"1\"]}",checker);
 cvsb-need(and(value_eq(fcap-docs(exhausted),docs),and(eq(fcap-checks(exhausted),1),str_eq(fcap-stage(exhausted),"repair"))),"exhaustion retains source and returns real failure");
 let invalid = fcap-step(state,"{\"tool\":\"rehearse-bml\",\"arguments\":[\"candidate.bml\",\"9999999999999999999999\"]}",checker);
 cvsb-need(and(value_eq(fcap-docs(invalid),docs),eq(fcap-checks(invalid),0)),"oversized budget never executes");
 let malformed = fcap-step(state,wire,list(cvsb-malformed,0));
 cvsb-need(and(value_eq(fcap-docs(malformed),docs),eq(fcap-checks(malformed),1)),"malformed callback still counts its actual invocation");
 let input = fcbvs-call(docs,list("candidate.bml","8"),"replace the contract",checker);
 cvsb-need(and(eq(nth(input,1),0),value_eq(fat-documents(head(input)),docs)),"input cannot supply a replacement contract");
 cvsb-need(ge(str_find(fcap-bootstrap(state),fcbvs-guidance(),0),0),"BML coding receives tool guidance");
 cvsb-need(lt(str_find(fcap-bootstrap(fcap-open-direct-review("Inspect",docs)),fcbvs-guidance(),0),0),"review receives no mutating guidance");
 let noop = "{\"tool\":\"edit\",\"arguments\":[\"candidate.bml\",\"= flag;\",\"= flag;\"]}";
 let enabled = fcap-with-rehearsal-budget(state,8);
 let helped = fcap-step(enabled,noop,checker);
 cvsb-need(and(str_eq(fcap-stage(helped),"implement"),str_eq(nth(fat-find-doc(fcap-docs(helped),"candidate.bml"),2),expected)),"unchanged edit triggers caller-enabled native repair");
 cvsb-need(and(eq(fcap-calls(helped),1),and(eq(fcap-turns(helped),1),and(eq(fcap-checks(helped),2),eq(fcap-rehearsal-budget(helped),6)))),"native search is not a model call or extra model turn and spends actual checks");
 cvsb-need(and(eq(len(fcap-rehearsals(helped)),1),and(value_eq(nth(helped,2),docs),value_eq(nth(helped,4),nth(state,4)))),"native attribution retains original contract");
 let entry = parse-json("native-event",head(fcap-rehearsals(helped)));
 cvsb-need(and(ge(str_find(fcap-string(entry,"trigger"),"edit-unchanged",0),0),ge(str_find(fcap-note(helped),"caller-enabled-native-rehearsal",0),0)),"failed model action and native source stay distinct");
 cvsb-need(value_eq(fcam-unpack(fcam-pack(helped)),helped),"native allowance and evidence survive checkpoint encoding");
 let afterHelp = fcap-step(fcap-step(helped,"{\"task\":\"done\"}",checker),"{\"verdict\":\"accept\",\"reason\":\"reviewed\"}",list(cvsb-pass,0));
 cvsb-need(and(str_eq(fcap-stage(afterHelp),"complete"),eq(fcap-checks(afterHelp),4)),"completion still requires pre-review and final caller verification");
 let spent = fcap-step(fcap-with-rehearsal-budget(state,1),noop,checker);
 cvsb-need(and(eq(fcap-rehearsal-budget(spent),0),and(eq(fcap-checks(spent),1),value_eq(fcap-docs(spent),docs))),"exhausted allowance preserves source");
 let beforeRepeat = record_get(counter,"source");
 let repeated = fcap-step(fcap-note-at(fcap-with-rehearsal-budget(spent,8),"implement","retry"),noop,checker);
 cvsb-need(and(eq(len(fcap-rehearsals(repeated)),1),eq(record_get(counter,"source"),beforeRepeat)),"same path and source are rehearsed once even if allowance is renewed");
 let disabled = fcap-step(state,noop,checker);
 let modelBudget = fcap-step(state,"{\"tool\":\"edit\",\"arguments\":[\"candidate.bml\",\"= flag;\",\"= flag;\"],\"native_rehearsal_checks\":8}",checker);
 cvsb-need(and(eq(fcap-rehearsal-budget(modelBudget),0),nil?(fcap-rehearsals(modelBudget))),"model reply cannot allocate native checks");
 let deniedHelp = fcap-step(fcap-with-rehearsal-budget(fcap-open-direct-review("Inspect",docs),8),noop,checker);
 cvsb-need(and(eq(record_get(counter,"source"),beforeRepeat),and(nil?(fcap-rehearsals(disabled)),nil?(fcap-rehearsals(deniedHelp)))),"default and read-only states never trigger automatic search");
 let malformedHelp = fcap-step(enabled,noop,list(cvsb-malformed,0));
 cvsb-need(and(value_eq(fcap-docs(malformedHelp),docs),and(eq(fcap-checks(malformedHelp),1),eq(fcap-rehearsal-budget(malformedHelp),7))),"malformed callback consumes its actual invocation and preserves source");
 let verify = "{\"tool\":\"verify\",\"arguments\":[]}";
 let verifiedHelp = fcap-step(enabled,verify,checker);
 cvsb-need(and(str_eq(fcap-stage(verifiedHelp),"implement"),str_eq(nth(fat-find-doc(fcap-docs(verifiedHelp),"candidate.bml"),2),expected)),"failed verify repairs before another model action");
 cvsb-need(and(eq(fcap-checks(verifiedHelp),3),and(eq(fcap-rehearsal-budget(verifiedHelp),6),and(eq(fcap-calls(verifiedHelp),1),eq(fcap-turns(verifiedHelp),1)))),"original verification and native search have separate accounting");
 let verifyEvent = parse-json("verify-event",head(fcap-rehearsals(verifiedHelp)));
 cvsb-need(and(ge(str_find(fcap-string(verifyEvent,"trigger"),"caller verification refused",0),0),and(value_eq(nth(verifiedHelp,2),docs),value_eq(fcam-unpack(fcam-pack(verifiedHelp)),verifiedHelp))),"failed verification evidence and original documents survive native repair and checkpoint");
 let finishedHelp = fcap-step(fcap-step(verifiedHelp,"{\"task\":\"done\"}",checker),"{\"verdict\":\"accept\",\"reason\":\"reviewed\"}",list(cvsb-pass,0));
 cvsb-need(and(str_eq(fcap-stage(finishedHelp),"complete"),eq(fcap-checks(finishedHelp),5)),"verify repair still requires pre-review and final checking");
 let passHelp = fcap-step(enabled,verify,list(cvsb-pass,0));
 let badHelp = fcap-step(enabled,verify,list(cvsb-malformed,0));
 let defaultHelp = fcap-step(state,verify,checker);
 let readHelp = fcap-step(fcap-with-rehearsal-budget(fcap-open-direct-review("Inspect",docs),8),verify,checker);
 cvsb-need(and(nil?(fcap-rehearsals(passHelp)),and(nil?(fcap-rehearsals(badHelp)),and(nil?(fcap-rehearsals(defaultHelp)),nil?(fcap-rehearsals(readHelp))))),"passing malformed default and read-only verification never search");
 let manyDocs = append(docs,list(list("other","other.bml",source)));
 let ambiguous = fcap-step(fcap-with-rehearsal-budget(fcap-open-direct-code("Repair",manyDocs,list("candidate.bml","other.bml")),8),verify,checker);
 let lockedHelp = fcap-step(fcap-with-rehearsal-budget(fcap-open-direct-code("Repair",docs,list("checks.bml")),8),verify,checker);
 let planHelp = fcap-step(fcap-note-at(enabled,"plan","plan first"),verify,checker);
 cvsb-need(and(nil?(fcap-rehearsals(ambiguous)),and(nil?(fcap-rehearsals(lockedHelp)),nil?(fcap-rehearsals(planHelp)))),"ambiguous target locked source and non-implementation stages preserve documents");
 let verifySpent = fcap-step(fcap-with-rehearsal-budget(state,1),verify,checker);
 cvsb-need(and(eq(fcap-checks(verifySpent),2),and(eq(fcap-rehearsal-budget(verifySpent),0),value_eq(fcap-docs(verifySpent),docs))),"verify exhaustion retains failed source");
 let verifyRepeat = fcap-step(fcap-note-at(fcap-with-rehearsal-budget(verifySpent,8),"implement","retry"),verify,checker);
 cvsb-need(and(eq(fcap-checks(verifyRepeat),3),and(eq(fcap-rehearsal-budget(verifyRepeat),8),eq(len(fcap-rehearsals(verifyRepeat)),1))),"repeated failed verification does not repeat native search");
 1;
}
