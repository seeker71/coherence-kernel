; config-floor-band.bml — the kernel config's database URL read from two layers of text, four-way.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/config-floor.bml
;
; Nothing here reads a file: cfgf-database-url takes the base layer's text and the home layer's text,
; the way config_database_url reads them from api/config/api.json and ~/.coherence-network/config.json,
; and merges them as the Go and Rust natives do.
;
; Verdict 63 when every claim lands:
;   1     the home layer's database.url wins over the base layer's
;   2     the base layer's database.url stands when the home layer's database object carries none
;   4     a home layer whose database is not an object replaces the base's, and database_url answers
;   8     database_url answers when no database.url is configured
;   16    nothing configured answers ""
;   32    surrounding whitespace is trimmed, and a blank URL counts as not configured
section [form.bml] {
    class ConfigFloorBand {
        def cffb-bit(ok, bit) = if ok then bit else 0;
        def cffb-url(base, overlay) = cfgf-database-url(base, overlay);
        def cffb-base() = "{\"database\": {\"url\": \"postgres://base\"}}";
        def cffb-score() = add(
            cffb-bit(str_eq(cffb-url(cffb-base(), "{\"database\": {\"url\": \"postgres://home\"}}"), "postgres://home"), 1),
            add(cffb-bit(str_eq(cffb-url(cffb-base(), "{\"database\": {\"pool\": 4}}"), "postgres://base"), 2),
            add(cffb-bit(str_eq(cffb-url(cffb-base(), "{\"database\": \"off\", \"database_url\": \"postgres://flat\"}"), "postgres://flat"), 4),
            add(cffb-bit(str_eq(cffb-url("{\"database_url\": \"postgres://flat-base\"}", "{}"), "postgres://flat-base"), 8),
            add(cffb-bit(str_eq(cffb-url("{}", "{}"), ""), 16),
                cffb-bit(and(str_eq(cffb-url("{}", "{\"database\": {\"url\": \"  postgres://spaced  \"}}"), "postgres://spaced"), str_eq(cffb-url("{\"database\": {\"url\": \"   \"}}", "{}"), "")), 32))))));
    }
    cffb-score();
}
