; Second process: restore the unresolved question, admit a newcomer only after
; its own exact question re-offer, retain revision, and save the successor.
; Verdict 65535 proves sixteen attribution, optionality, and no-action bits.
; witnessed: 2026-08-08 -> 65535 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-action-enquiry.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/tests/living-world-recipe-execution-witness.fk form-stdlib/tests/living-world-action-cycle-witness.fk form-stdlib/tests/living-world-action-enquiry-witness.fk form-stdlib/tests/living-world-durable-action-enquiry-witness.fk form-stdlib/tests/living-world-durable-action-enquiry-succession-witness.fk

(do
    (lwdaes-clean-after)
    (let loaded (lwdaeq-load))
    (let image (lwcd-result-image loaded))
    (let stored (lwcn-image-world image))
    (let stored-question (lwdaes-question-for stored))
    (let stored-evidence
        (lwae-stance-evidence-for stored stored-question))
    (let admission (lwdaeq-admission-world image))
    (let proposal (lwcn-restore-proposal admission image))
    (let candidate (lwt-proposal-candidate proposal))
    (let waiting (lwt-round-world (lwdaeq-waiting-round image)))
    (let restored (lwt-round-world (lwdaeq-restored-round image)))
    (let question (lwdaes-question-for restored))
    (let historical (lwae-stance-evidence-for restored question))
    (let alternative (lwdaes-alternative-stance question))
    (let abstain (lwdaes-abstain-stance question))
    (let unjoined (lwdaes-unjoined-world restored))
    (let joined (lwdaes-joined-world restored))
    (let joined-evidence
        (lwdaes-evidence-for-stance joined question alternative))
    (let revised (lwdaes-revised-world joined))
    (let successor (lwdaes-successor-world revised))
    (let successor-evidence
        (lwae-stance-evidence-for successor question))
    (let successor-abstain
        (lwdaes-evidence-for-stance successor question abstain))
    (let field
        (lwae-question-field (lwo-emergent-shape question)))
    (let after-image (lwcn-image successor))
    (let saved (lwdaes-save-after successor))
    (let score
        (lwdaeq-sum
            (list
                (if (eq (lwcd-loaded? loaded) 1) 1 0)
                (if (eq (lwcn-image-valid? image) 1) 2 0)
                (if (and (eq (lwo-field-size
                                  (lwdaeq-questions stored)) 1)
                         (eq (lwo-field-size stored-evidence) 4)) 4 0)
                (if (and (eq (lwo-field-size
                                  (lwdaeq-questions admission)) 0)
                         (and (eq (lwo-field-size
                                      (lwae-stance-evidence-for
                                          admission stored-question)) 0)
                              (and (eq (lwo-field-size
                                          (lwdaeq-current-selections
                                              admission)) 0)
                                   (eq (lwo-field-size
                                          (lwdaeq-current-executions
                                              admission)) 0)))) 8 0)
                (if (eq (lwcn-restored? waiting candidate) 0) 16 0)
                (if (and (eq (lwcn-restored? restored candidate) 1)
                         (and (node_eq question stored-question)
                              (eq (lwo-field-size historical) 4))) 32 0)
                (if (and (eq (lwo-field-size
                                  (lwae-stance-evidence-for
                                      unjoined question)) 4)
                         (node_eq
                            (lwdaes-evidence-for-stance
                                unjoined question alternative)
                            (lwo-none))) 64 0)
                (if (and (eq (lwo-active-by? joined question
                                  (lwdaes-source-j)) 1)
                         (eq (lwo-field-size
                                  (lwae-stance-evidence-for
                                      joined question)) 5)) 128 0)
                (if (and (eq (lwdaes-field-contained? historical
                                  (lwae-stance-evidence-for
                                      joined question)) 1)
                         (and (not (node_eq joined-evidence (lwo-none)))
                              (eq (lwo-field-size
                                  (lwae-stance-evidence-attributions
                                      joined-evidence)) 1))) 256 0)
                (if (and (eq (lwae-stance-valid?
                                  joined alternative) 1)
                         (and (eq (oac-zero?
                                      (lwae-stance-ack alternative)) 1)
                              (and (eq (lwlc-declaration-valid?
                                          (lwae-stance-declaration
                                              alternative)) 1)
                                   (and (eq (lwo-field-size
                                              (lwae-stance-alternatives
                                                  alternative)) 2)
                                        (eq (lwlc-unknown?
                                              (lwae-stance-unknown
                                                  alternative)) 1))))) 512 0)
                (if (and (eq (lwo-field-size
                                  (lwae-stance-evidence-for
                                      revised question)) 6)
                         (and (not (node_eq
                                      (lwdaes-evidence-for-stance
                                          revised question alternative)
                                      (lwo-none)))
                              (not (node_eq
                                      (lwdaes-evidence-for-stance
                                          revised question abstain)
                                      (lwo-none))))) 1024 0)
                (if (and (eq (lwo-field-size successor-evidence) 5)
                         (and (node_eq
                                  (lwdaes-evidence-for-stance
                                      successor question alternative)
                                  (lwo-none))
                              (and (not (node_eq successor-abstain
                                          (lwo-none)))
                                   (eq (lwae-stance-immediate-nothing?
                                          abstain) 1)))) 2048 0)
                (if (eq (lwdaes-field-contained?
                            historical successor-evidence) 1) 4096 0)
                (if (and (eq (lwac-open?
                                  (lwac-field-status field)) 1)
                         (and (node_eq (lwac-field-primary field)
                                      (lwo-none))
                              (eq (lwo-field-size
                                  (lwae-eligible-for-field
                                      successor field)) 2))) 8192 0)
                (if (and (eq (lwae-question-steady?
                                  successor question) 1)
                         (and (eq (lwo-field-size
                                      (lwdaeq-current-selections
                                          successor)) 0)
                              (eq (lwo-field-size
                                      (lwdaeq-current-executions
                                          successor)) 0))) 16384 0)
                (if (and (eq (lwcd-saved? saved) 1)
                         (and (node_eq
                                  (lwcd-result-image saved) after-image)
                              (and (eq (fs-exists?
                                          (lwdaes-after-path)) 1)
                                   (eq (fs-exists?
                                          (lwcd-pending-path
                                              (lwdaes-after-path))) 0))))
                    32768 0))))
    (lwdaeq-clean)
    score)
