; form-knowledge-query-memory-shard-exec-band.fk -- exact-source crossing.
;
; The pure adversarial band injects route observations, while the final bit
; reads the already-built public-source shard/route substrate without writing
; it.  The live row is axioms/core-axioms.form: its request carries the source
; digest observed now, its synthetic unique concept key selects one exact route
; coordinate, and the executor independently rehashes the current file.
;
; Verdict 262143 (18 bits): ready; exact hit; foreign path; foreign digest;
; miss; nothing; timeout; failure; five states distinct; one-shot counts;
; model/execution flags; value-present with 0; value-present with 1; malformed
; query refusal; exact route coordinate; swapped source request; live current
; shard hit/current hash; live source and entry nodes retained.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/bmf-core.fk form-stdlib/form-fs.fk
; preludes: form-stdlib/file-byte-window.fk form-stdlib/sha256.fk
; preludes: form-stdlib/hex.fk form-stdlib/form-cli-router.fk
; preludes: form-stdlib/text-tokenize.fk form-stdlib/rag-embed.fk
; preludes: form-stdlib/rag-index-codec.fk form-stdlib/rag-retrieve.fk
; preludes: form-stdlib/rag-ask.fk form-stdlib/form-knowledge-query-token.fk
; preludes: form-stdlib/form-knowledge-source-search.fk
; preludes: form-stdlib/public-source-concept-index.fk
; preludes: form-stdlib/public-source-concept-shards.fk
; preludes: form-stdlib/public-source-concept-key-routes.fk
; preludes: form-stdlib/form-knowledge-query-memory-rotation-token.fk
; preludes: form-stdlib/form-knowledge-query-memory-exec.fk
; preludes: form-stdlib/form-knowledge-query-memory-shard-exec.fk

(do
    (defn fkqmsxb-bit (ok bit) (if ok bit 0))
    (defn fkqmsxb-sha (s) (hex-encode (sha256-stream-string s)))
    (defn fkqmsxb-question-sha (tag) (fkqmsxb-sha (str_concat tag "-q")))
    (defn fkqmsxb-mem (tag)
        (intern_node (make_nodeid 31 2 0 127)
            (list (intern_trivial_string tag))))
    (defn fkqmsxb-request (key tag source-id)
        (do
            (let memory (fkqmsxb-mem (str_concat tag "-m")))
            (let rollback (fkqmsxb-mem (str_concat tag "-b")))
            (let question (fkqmsxb-question-sha tag))
            (let surface (str_concat (fkqmx-open-mark)
                (str_concat key (fkqmx-close-mark))))
            (let offer (intern_node (fkqmx-offer-category)
                (list (intern_trivial_string (fkqmx-offer-schema))
                    (intern_trivial_string source-id)
                    (intern_trivial_string surface)
                    (intern_trivial_string question))))
            (let recipe (intern_node (fkqmrt-recipe-category)
                (list (intern_trivial_string (fkqmrt-recipe-schema))
                    memory rollback offer
                    (intern_trivial_string question)
                    (intern_trivial_string (substring source-id 7 71))
                    (intern_trivial_string question)
                    (intern_trivial_string (fkqmsxb-sha surface))
                    (intern_trivial_string tag)
                    (intern_trivial_string "source-shard-band")
                    (intern_trivial_int 1) (intern_trivial_int 1)
                    (intern_trivial_int 0) (intern_trivial_int 0)
                    (intern_trivial_int 0) (intern_trivial_int 0))))
            (intern_node (fkqmrt-request-category)
                (list (intern_trivial_string (fkqmrt-request-schema))
                    (fkqmrt-action-node) recipe memory rollback
                    (intern_trivial_string tag)
                    (intern_trivial_string "source-shard-band")
                    (intern_trivial_int 0) (intern_trivial_int 1)))))

    (defn fkqmsxb-record (family path source-id key size)
        (do
            (let source (psci-source-node family path source-id size))
            (let entry (psci-entry source (list key)))
            (list (pscish-record-schema) family path source-id size source entry
                key (list key) (psci-node-key source)
                (psci-node-key entry) (pscish-source-content-key source)
                (pscish-entry-content-key entry))))
    (defn fkqmsxb-return-inspection (ctx binding key) ctx)
    (defn fkqmsxb-inspection (status reason record current)
        (list status reason record current))
    (defn fkqmsxb-all-distinct5 (a b c d e)
        (if (or (str_eq a b) (or (str_eq a c) (or (str_eq a d)
            (or (str_eq a e) (or (str_eq b c) (or (str_eq b d)
            (or (str_eq b e) (or (str_eq c d) (or (str_eq c e)
                (str_eq d e)))))))))) 0 1))

    (defn form-knowledge-query-memory-shard-exec-band ()
        (do
            (let family "axioms")
            (let path "axioms/core-axioms.form")
            (let other-path "axioms/host-kernel.form")
            (let key (pscish-unique-key family path))
            (let sid (str_concat "sha256:"
                "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
            (let other-sid (str_concat "sha256:"
                "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"))
            (let request (fkqmsxb-request key "exact" sid))
            (let binding (fkqmsx-binding request family path))
            (let record0 (fkqmsxb-record family path sid key 0))
            (let record1 (fkqmsxb-record family path sid key 1))
            (let exact0 (fkqmsx-execute-with
                (fkqmsxb-inspection "current" "current" record0 sid)
                fkqmsxb-return-inspection binding))
            (let exact1 (fkqmsx-execute-with
                (fkqmsxb-inspection "current" "current" record1 sid)
                fkqmsxb-return-inspection binding))
            (let foreign-path (fkqmsx-execute-with
                (fkqmsxb-inspection "current" "current"
                    (fkqmsxb-record family other-path sid key 1) sid)
                fkqmsxb-return-inspection binding))
            (let foreign-digest (fkqmsx-execute-with
                (fkqmsxb-inspection "current" "current"
                    (fkqmsxb-record family path other-sid key 1) other-sid)
                fkqmsxb-return-inspection binding))
            (let miss (fkqmsx-execute-with
                (fkqmsxb-inspection "missing" "route-reference-missing"
                    (empty) "") fkqmsxb-return-inspection binding))
            (let none (fkqmsx-execute-with
                (fkqmsxb-inspection "nothing" "route-not-offered"
                    (empty) "") fkqmsxb-return-inspection binding))
            (let timed (fkqmsx-execute-with
                (fkqmsxb-inspection "timeout" "route-reference-over-window"
                    (empty) "") fkqmsxb-return-inspection binding))
            (let failed (fkqmsx-execute-with
                (fkqmsxb-inspection "failure" "invalid-route-reference"
                    (empty) "") fkqmsxb-return-inspection binding))
            (let swapped (fkqmsx-execute-with
                (fkqmsxb-inspection "current" "current"
                    (fkqmsxb-record family other-path other-sid key 1) other-sid)
                fkqmsxb-return-inspection
                (fkqmsx-binding (fkqmsxb-request key "swap" other-sid)
                    family path)))
            (let invalid (fkqmsx-execute-with (empty)
                fkqmsxb-return-inspection
                (fkqmsx-binding (fkqmsxb-request
                    (str_concat key " answer") "invalid" sid) family path)))

            ; Read-only crossing through the current 6095-source substrate.
            (let live-root ".")
            (let live-artifact (fs-path-join (fs-temp-dir)
                "public-source-concept-registry-v1"))
            (let live-current (fkss-source-id (fs-path-join live-root path)))
            (let live-request (fkqmsxb-request key "live" live-current))
            (let live-binding (fkqmsx-binding live-request family path))
            (let live (fkqmsx-execute-at live-root live-artifact
                live-artifact live-binding))

            (sum (list
                (fkqmsxb-bit (eq (fkqmsx-binding-ready? binding) 1) 1)
                (fkqmsxb-bit (and (str_eq (fkqmsx-status exact1) "hit")
                    (str_eq (fkqmsx-current-source-id exact1) sid)) 2)
                (fkqmsxb-bit (and (str_eq (fkqmsx-status foreign-path) "failure")
                    (str_eq (fkqmsx-reason foreign-path)
                        "route-source-binding-mismatch")) 4)
                (fkqmsxb-bit (and (str_eq (fkqmsx-status foreign-digest) "failure")
                    (eq (fkqmsx-hit-count foreign-digest) 0)) 8)
                (fkqmsxb-bit (str_eq (fkqmsx-status miss) "miss") 16)
                (fkqmsxb-bit (str_eq (fkqmsx-status none) "nothing") 32)
                (fkqmsxb-bit (str_eq (fkqmsx-status timed) "timeout") 64)
                (fkqmsxb-bit (str_eq (fkqmsx-status failed) "failure") 128)
                (fkqmsxb-bit (eq (fkqmsxb-all-distinct5
                    (fkqmsx-status exact1) (fkqmsx-status miss)
                    (fkqmsx-status none) (fkqmsx-status timed)
                    (fkqmsx-status failed)) 1) 256)
                (fkqmsxb-bit (and (eq (fkqmsx-lookup-count exact1) 1)
                    (and (eq (fkqmsx-hit-count exact1) 1)
                         (eq (fkqmsx-lookup-count invalid) 0))) 512)
                (fkqmsxb-bit (and (eq (fkqmsx-model-executed? exact1) 0)
                    (and (eq (fkqmsx-executed? exact1) 1)
                         (eq (fkqmsx-executed? invalid) 0))) 1024)
                (fkqmsxb-bit (and (eq (fkqmsx-value-present? exact0) 1)
                    (eq (fkqmsx-value exact0) 0)) 2048)
                (fkqmsxb-bit (and (eq (fkqmsx-value-present? exact1) 1)
                    (eq (fkqmsx-value exact1) 1)) 4096)
                (fkqmsxb-bit (and (str_eq (fkqmsx-status invalid) "failure")
                    (eq (fkqmsx-value-present? invalid) 0)) 8192)
                (fkqmsxb-bit (not (str_eq
                    (psckr-reference-path-at live-artifact key family path)
                    (psckr-reference-path-at live-artifact key family other-path))) 16384)
                (fkqmsxb-bit (and (str_eq (fkqmsx-status swapped) "failure")
                    (eq (fkqmsx-hit-count swapped) 0)) 32768)
                (fkqmsxb-bit (and (str_eq (fkqmsx-status live) "hit")
                    (and (str_eq (fkqmsx-expected-source-id-of live) live-current)
                    (and (str_eq (fkqmsx-current-source-id live) live-current)
                         (and (str_eq (fkqmsx-path live) path)
                              (eq (fkqmsx-lookup-count live) 1))))) 65536)
                (fkqmsxb-bit (and
                    (node_eq (fkqmsx-source-node live)
                        (pscish-record-source
                            (psckr-read-source-record-at live-artifact family path)))
                    (node_eq (fkqmsx-entry-node live)
                        (pscish-record-entry
                            (psckr-read-source-record-at live-artifact family path)))) 131072)))))

    (form-knowledge-query-memory-shard-exec-band))
