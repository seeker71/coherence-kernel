; bounded-health-projection.fk — full public health shape without deep proof.
;
; preludes: form-stdlib/core.fk form-stdlib/json.fk
;
; The continuous health witness needs the same public contract as the explicit
; health door, but it must not execute native-carrier challenges or deployment-
; witness reads.  Those proof lanes stay on the explicit observation path.
; This recipe owns the projection; Python is a temporary compatibility carrier.
;
; Proven by: form-stdlib/tests/bounded-health-projection-band.fk (four-way).

section [form.bml] {
    def bhp-nullable-string(value) = if str_eq(value, "") then json-node-null() else json-node-string(value);

    def bounded-health-projection(status, version, timestamp, started_at, uptime_seconds, uptime_human, deployed_sha, deployed_sha_source, integrity_compromised, integrity_verified, schema_ok, opencode_enabled, smart_reap_available, smart_reap_import_error, recent_outcomes, kernel_runtime) {
        json-node-object(list(
            json-node-pair("status", json-node-string(status)),
            json-node-pair("version", json-node-string(version)),
            json-node-pair("timestamp", json-node-string(timestamp)),
            json-node-pair("started_at", json-node-string(started_at)),
            json-node-pair("uptime_seconds", json-node-int(uptime_seconds)),
            json-node-pair("uptime_human", json-node-string(uptime_human)),
            json-node-pair("deployed_sha", bhp-nullable-string(deployed_sha)),
            json-node-pair("deployed_sha_source", bhp-nullable-string(deployed_sha_source)),
            json-node-pair("integrity_compromised", json-node-bool(integrity_compromised)),
            json-node-pair("integrity_verified", json-node-bool(integrity_verified)),
            json-node-pair("schema_ok", json-node-bool(schema_ok)),
            json-node-pair("opencode_enabled", json-node-bool(opencode_enabled)),
            json-node-pair("smart_reap_available", json-node-bool(smart_reap_available)),
            json-node-pair("smart_reap_import_error", bhp-nullable-string(smart_reap_import_error)),
            json-node-pair("recent_outcomes", recent_outcomes),
            json-node-pair("kernel_runtime", json-node-string(kernel_runtime)),
            json-node-pair("native_runtime_observation", json-node-null()),
            json-node-pair("observation_schema", json-node-null()),
            json-node-pair("observation_nonce_sha256", json-node-null()),
            json-node-pair("kernel_challenge", json-node-null()),
            json-node-pair("form_cli_challenge", json-node-null()),
            json-node-pair("deployment_witness_node_id", json-node-null()),
            json-node-pair("deployment_witness_content_node_id", json-node-null()),
            json-node-pair("deployment_observed_at", json-node-null()),
            json-node-pair("deployment_observation_expires_at", json-node-null()),
            json-node-pair("deployment_observation_fresh", json-node-bool(false))
        ));
    }

    0;
}
