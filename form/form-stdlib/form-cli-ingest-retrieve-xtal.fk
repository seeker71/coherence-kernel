
(let RetrieveHit (language-template-with-members "RetrieveHit" (list "TPhrase") (list (language-template-member "path" "String") (language-template-member "phrase" "TPhrase") (language-template-member "hit" "int"))))
(defn IngestRetrieveAuthorityPath () "form/form-stdlib/bml/form-cli-ingest-retrieve.bml")
(defn IngestRetrieveAuthorityKind () "high-bml-class-template-field")
(defn FormIngestRetrieveAuthority () (list "abstraction" "FormIngestRetrieveAuthority" (list) (list) (list "IngestRetrieveAuthorityPath" "IngestRetrieveAuthorityKind") (list) (list)))
(defn PhraseHit () 1)
(defn PhraseMiss () 0)
(defn CollapsePath () "ingest/equivalence-collapse.fk")
(defn DepthPath () "ingest/knowledge-ingest.fk")
(defn NboPath () "ingest/name-build-observe.fk")
(defn OneCell () "one cell")
(defn DepthAtLeast3 () "depth at least 3")
(defn WaitsAtTheDoor () "waits at the door")
(defn SpanBefore () 128)
(defn SpanLimit () 768)
(defn fir-authority () FormIngestRetrieveAuthority)
(defn fir-pattern () (list "retrieve" "cell-phrase" "heed-span" "no-qwen"))
(defn fir-has (hay needle) (if (ge (str_find hay needle 0) 0) (PhraseHit) (PhraseMiss)))
(defn fir-read (path) (do (let s (read_file path)) (if (nothing? s) "" s)))
(defn fir-readable (path) (if (gt (str_len (fir-read path)) 0) (PhraseHit) (PhraseMiss)))
(defn fir-retrieve (path phrase) (fir-has (fir-read path) phrase))
(defn fir-min (a b) (if (lt a b) a b))
(defn fir-max (a b) (if (gt a b) a b))
(defn fir-span-start (first size) (fir-min size (fir-max 0 (sub first (SpanBefore)))))
(defn fir-in-span (hay atom phrase) (do (let first (str_find hay atom 0)) (let start (fir-span-start first (str_len hay))) (let p (str_find hay phrase start)) (let end (add start (SpanLimit))) (if (lt first 0) (PhraseMiss) (if (lt p 0) (PhraseMiss) (if (lt p end) (PhraseHit) (PhraseMiss))))))
(defn fir-bit (ok bit) (if ok bit 0))
(defn fir-span-check () (do (let collapse (read_file (CollapsePath))) (let depth (read_file (DepthPath))) (let nbo (read_file (NboPath))) (let c0 (fir-bit (eq (fir-in-span collapse "Blueprint" (OneCell)) (PhraseHit)) 1)) (let c1 (fir-bit (eq (fir-in-span depth "ki-deep?" (DepthAtLeast3)) (PhraseHit)) 2)) (let c2 (fir-bit (eq (fir-in-span nbo "nbo-enter" (WaitsAtTheDoor)) (PhraseHit)) 4)) (add c0 (add c1 c2))))
(defn fir-check () (do (let collapse (read_file (CollapsePath))) (let depth (read_file (DepthPath))) (let nbo (read_file (NboPath))) (let c0 (fir-bit (eq (fir-readable (CollapsePath)) (PhraseHit)) 1)) (let c1 (fir-bit (eq (fir-readable (DepthPath)) (PhraseHit)) 2)) (let c2 (fir-bit (eq (fir-readable (NboPath)) (PhraseHit)) 4)) (let c3 (fir-bit (eq (fir-retrieve (CollapsePath) (OneCell)) (PhraseHit)) 8)) (let c4 (fir-bit (eq (fir-retrieve (DepthPath) (DepthAtLeast3)) (PhraseHit)) 16)) (let c5 (fir-bit (eq (fir-retrieve (NboPath) (WaitsAtTheDoor)) (PhraseHit)) 32)) (let c6 (fir-bit (eq (fir-has collapse "ONE cell") (PhraseHit)) 64)) (let c7 (fir-bit (eq (fir-has depth "(ge (ki-depth u) 3)") (PhraseHit)) 128)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
(defn FormIngestRetrieve () (list "abstraction" "FormIngestRetrieve" (list "T") (list "fir-has" "fir-readable" "fir-retrieve" "fir-min" "fir-max" "fir-span-start" "fir-in-span" "fir-bit" "fir-span-check" "fir-check") (list "PhraseHit" "PhraseMiss" "CollapsePath" "DepthPath" "NboPath" "OneCell" "DepthAtLeast3" "WaitsAtTheDoor" "SpanBefore" "SpanLimit") (list "fir-authority") (list "fir-pattern")))
0
