; form-cli-planner-mint-run.fk — mint planner-turn samples, fit overlay, print lift.
;
; No prompt bytes. NeedEvents 95 is the session remainder.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-planner-mint-xtal.fk

(do
    (let rows (fpl-corpus 1 1))
    (let n (fpl-n 1 1))
    (let correct (fpl-heldout-correct rows))
    (print_str (str_concat "fpl n=" (str_concat (int_to_str n) "\n")))
    (print_str (str_concat "fpl unique=" (str_concat (int_to_str (fpl-unique rows)) "\n")))
    (print_str (str_concat "fpl leakage=" (str_concat (int_to_str (fpl-leakage rows)) "\n")))
    (print_str (str_concat "fpl heldout-correct=" (str_concat (int_to_str correct) "\n")))
    (print_str (str_concat "fpl heldout-n=" (str_concat (int_to_str (fpl-count-split rows (SplitHeldout))) "\n")))
    (print_str (str_concat "fpl covers-all=" (str_concat (int_to_str (fpl-covers-all rows)) "\n")))
    (print_str (str_concat "fpl need-events=" (str_concat (int_to_str (NeedEvents)) "\n")))
    (print_str (str_concat "fpl lora-writer=" (str_concat (int_to_str (fpl-lora-writer)) "\n")))
    (print_str (str_concat "fpl check=" (str_concat (int_to_str (fpl-check)) "\n")))
    (print_str (str_concat "fpl scale-12-4=" (str_concat (int_to_str (fpl-n 12 4)) "\n")))
    (print_str (str_concat "fpl sample-walk=" (str_concat (nth (fpl-row "walk-lane" "how" 0 (SplitTrain)) 2) "\n")))
    (print_str (str_concat "fpl sample-quiet=" (str_concat (nth (fpl-row "no-transcript" "what" 0 (SplitTrain)) 2) "\n")))
    (print_str (str_concat "fpl sample-turn=" (str_concat (nth (fpl-row "one-turn" "when" 0 (SplitTrain)) 2) "\n")))
    0)
