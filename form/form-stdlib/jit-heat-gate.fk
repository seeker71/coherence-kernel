; jit-heat-gate.fk — heat observed where crystallization can act on it: at
; the door, per interned identity, in Form, growing the seed by nothing.
;
; THE PREMISE, CHALLENGED BEFORE IT WAS BUILT. A sibling made the fourth
; arm's opcode counters live and the receipt taught honestly: tag heat is a
; MARGINAL — two functions with one op-mix are indistinguishable inside it,
; and no snapshot cleverness recovers the joint. The tempting next organ is
; per-function counters in the evaluator, which grows the seed. But heat is
; only ACTIONABLE over the lowerable frontier — knowing an unlowerable cell
; is hot changes nothing — and every lowerable program can already cross one
; door. So the organ that matters counts AT THE DOOR, per identity, and the
; seed stays its size. Evaluator-side call-site heat remains the right
; DISCOVERY organ for candidates that never reach a door; that is a
; different question, and a read-only one when its day comes.
;
; CRYSTALLIZE-ON-HEAT, jit-decision's own thresholds, finally fed. Below the
; threshold a request is answered by the form interpreter and COUNTED —
; route "form", cost honest. The request that crosses jd-crystallize? births
; native exactly once. jd-melt? drives hg-cool: a cooled identity's entry
; dissolves (counted) and its heat resets — melt back to the walker, the
; hysteresis the decision cell always promised.
;
; HEAT WITHOUT LOWERABILITY IS A TRAP, SURFACED AS DATA. jd-crystallize?
; demands pure; here purity's computable floor is the leaf subset — every
; row tag in {1,2,4,5,8,3}. A hot unlowerable identity NEVER births; it
; stays route "form" and hg-hottest reports it flagged, so the wasted-heat
; failure mode is a visible row, not a silent birth of refusals.
;
; TIES STAY CHOICE. hg-hottest returns every row at the maximum, as the
; sibling's receipt kept tied opcodes — a selection the caller must make is
; not a selection this cell may hide.
;
; preludes: form-stdlib/jit-once-born.fk form-stdlib/jit-decision.fk
;
; Proven by: form-stdlib/tests/jit-heat-gate-band.fk

(do
    ; ── lowerability: the leaf subset, decided from the program's own rows ─
    (defn hg-row-ok? (tag)
        (if (or (eq tag 1) (or (eq tag 2) (or (eq tag 3)
            (or (eq tag 4) (or (eq tag 5) (eq tag 8)))))) 1 0))
    (defn hg-lowerable? (prog)
        (if (eq (len prog) 0) 1
            (if (eq (hg-row-ok? (nth (head prog) 0)) 1)
                (hg-lowerable? (tail prog)) 0)))

    ; ── the gated registry: (list jonb-reg heats) ; heat = (id fires low) ──
    (defn hg-gate (epoch) (list (jonb-registry epoch) (list)))
    (defn hg-reg (g)   (nth g 0))
    (defn hg-heats (g) (nth g 1))

    (defn hg-find (hs id)
        (if (eq (len hs) 0) (nothing)
            (if (eq (value_eq (nth (head hs) 0) id) 1) (head hs)
                (hg-find (tail hs) id))))
    (defn hg-fires (g id)
        (do (let h (hg-find (hg-heats g) id))
            (if (nothing? h) 0 (nth h 1))))
    (defn hg-bump (hs id low)
        (if (eq (len hs) 0) (list (list id 1 low))
            (if (eq (value_eq (nth (head hs) 0) id) 1)
                (cons (list id (add (nth (head hs) 1) 1) low) (tail hs))
                (cons (head hs) (hg-bump (tail hs) id low)))))

    ; ── the gated request ──────────────────────────────────────────────────
    ; returns (list value route gate' born)
    (defn hg-request (g prog root arg)
        (do (let id (jonb-identity prog root (jonb-epoch (hg-reg g))))
            (let low (hg-lowerable? prog))
            (let hs (hg-bump (hg-heats g) id low))
            (let fires (add (hg-fires g id) 1))
            (if (eq low 0)
                (list (jonb-eval prog root arg) "form" (list (hg-reg g) hs) 0)
                (if (eq (jd-crystallize? fires low) 0)
                    (if (nothing? (jonb-lookup (hg-reg g) prog root))
                        (list (jonb-eval prog root arg) "form" (list (hg-reg g) hs) 0)
                        (do (let r (jonb-request (hg-reg g) prog root arg))
                            (list (nth r 0) (nth r 1) (list (nth r 2) hs) (nth r 3))))
                    (do (let r (jonb-request (hg-reg g) prog root arg))
                        (list (nth r 0) (nth r 1) (list (nth r 2) hs) (nth r 3)))))))

    ; ── cooling: jd-melt? dissolves the cooled, observable, heat reset ─────
    ; halves every heat; entries whose halved heat melts are dropped from the
    ; registry (counted) so the next crossing REbirths — hysteresis whole.
    (defn hg-cool (g)
        (do (let halved (hg-halve (hg-heats g) (list)))
            (let swept (hg-sweep-meltable (jonb-entries (hg-reg g)) halved (list) 0))
            (list (list (list (jonb-epoch (hg-reg g)) (nth swept 0))
                        halved)
                  (nth swept 1))))
    (defn hg-halve (hs out)
        (if (eq (len hs) 0) (reverse out)
            (hg-halve (tail hs)
                (cons (list (nth (head hs) 0) (div (nth (head hs) 1) 2)
                            (nth (head hs) 2)) out))))
    (defn hg-melts? (hs id)
        (do (let h (hg-find hs id))
            (if (nothing? h) 1 (jd-melt? (nth h 1)))))
    (defn hg-sweep-meltable (es hs kept melted)
        (if (eq (len es) 0) (list (reverse kept) melted)
            (if (eq (hg-melts? hs (nth (head es) 0)) 1)
                (hg-sweep-meltable (tail es) hs kept (add melted 1))
                (hg-sweep-meltable (tail es) hs (cons (head es) kept) melted))))

    ; ── hottest: every row at the max, lowerability flagged, ties kept ─────
    (defn hg-max (hs m)
        (if (eq (len hs) 0) m
            (hg-max (tail hs) (if (gt (nth (head hs) 1) m) (nth (head hs) 1) m))))
    (defn hg-at (hs m out)
        (if (eq (len hs) 0) (reverse out)
            (hg-at (tail hs) m
                (if (eq (nth (head hs) 1) m) (cons (head hs) out) out))))
    (defn hg-hottest (g)
        (do (let m (hg-max (hg-heats g) 0))
            (if (eq m 0) (list) (hg-at (hg-heats g) m (list)))))
    0)
