// jit-heat-gate.fk — heat observed where crystallization can act on it: at
// the door, per interned identity, in Form, growing the seed by nothing.
//
// THE PREMISE, CHALLENGED BEFORE IT WAS BUILT. A sibling made the fourth
// arm's opcode counters live and the receipt taught honestly: tag heat is a
// MARGINAL — two functions with one op-mix are indistinguishable inside it,
// and no snapshot cleverness recovers the joint. The tempting next organ is
// per-function counters in the evaluator, which grows the seed. But heat is
// only ACTIONABLE over the lowerable frontier — knowing an unlowerable cell
// is hot changes nothing — and every lowerable program can already cross one
// door. So the organ that matters counts AT THE DOOR, per identity, and the
// seed stays its size. Evaluator-side call-site heat remains the right
// DISCOVERY organ for candidates that never reach a door; that is a
// different question, and a read-only one when its day comes.
//
// CRYSTALLIZE-ON-HEAT, jit-decision's own thresholds, finally fed. Below the
// threshold a request is answered by the form interpreter and COUNTED —
// route "form", cost honest. The request that crosses jd-crystallize? births
// native exactly once. jd-melt? drives hg-cool: a cooled identity's entry
// dissolves (counted) and its heat resets — melt back to the walker, the
// hysteresis the decision cell always promised.
//
// HEAT WITHOUT LOWERABILITY IS A TRAP, SURFACED AS DATA. jd-crystallize?
// demands pure; here purity's computable floor is the leaf subset — every
// row tag in {1,2,4,5,8,3}. A hot unlowerable identity NEVER births; it
// stays route "form" and hg-hottest reports it flagged, so the wasted-heat
// failure mode is a visible row, not a silent birth of refusals.
//
// TIES STAY CHOICE. hg-hottest returns every row at the maximum, as the
// sibling's receipt kept tied opcodes — a selection the caller must make is
// not a selection this cell may hide.
//
import form-stdlib/jit-once-born.fk;
import form-stdlib/jit-decision.fk;
//
// Proven by: form-stdlib/tests/jit-heat-gate-band.fk
section [form.bml] {
    // ── lowerability: the leaf subset, decided from the program's own rows ─
    def hg-row-ok?(tag) = (Comparable) tag == 1 || ((Comparable) tag == 2 || ((Comparable) tag == 3 || ((Comparable) tag == 4 || ((Comparable) tag == 5 || (Comparable) tag == 8)))) ? 1 : 0;
    // A division is lowerable only by a NONZERO LITERAL divisor (form-lower's lo-div-safe?): the walker stops on a zero
    // divisor and a native page cannot, so every other division is the walker's to answer. Asking here keeps a program
    // the lowering will decline from being born, heated as lowerable and latched as a compile fault one step later.
    def hg-nonzero-lit?(prog, j) = (Comparable) prog[j][0] == 1 ? ((Comparable) prog[j][1] == 0 ? 0 : 1) : 0;
    def hg-div-ok?(prog, row) = (Comparable) row[0] == 8 ? hg-nonzero-lit?(prog, row[2]) : 1;
    def hg-lowerable-from(prog, i) = i >= len(prog) ? 1 : (Comparable) hg-row-ok?(prog[i][0]) == 0 ? 0 : (Comparable) hg-div-ok?(prog, prog[i]) == 0 ? 0 : hg-lowerable-from(prog, i + 1);
    def hg-lowerable?(prog) = hg-lowerable-from(prog, 0);
    // ── the gated registry: (list jonb-reg heats) ; heat = (id fires low) ──
    def hg-gate(epoch) = [jonb-registry(epoch), []];
    def hg-reg(g) = g[0];
    def hg-heats(g) = g[1];
    def hg-find(hs, id) = (Comparable) len(hs) == 0 ? nothing() : (Comparable) ((Value) hs[0][0] == id) == 1 ? hs[0] : hg-find(hs[1:], id);
    def hg-fires(g, id) = {
        let h = hg-find(hg-heats(g), id);
        nothing?(h) ? 0 : h[1];
    };
    def hg-bump(hs, id, low) = (Comparable) len(hs) == 0 ? [[id, 1, low]] : (Comparable) ((Value) hs[0][0] == id) == 1 ? cons([id, hs[0][1] + 1, low], hs[1:]) : cons(hs[0], hg-bump(hs[1:], id, low));
    // ── the gated request ──────────────────────────────────────────────────
    // returns (list value route gate' born)
    // an effect row the root does not reach, or a node tag no route has an arm for, is a refusal -- value nothing(),
    // route "refused" -- never an answer from a program that lost a node (jonb-request's rule, kept at this door)
    def hg-request(g, prog, root, arg) = (Comparable) lo-effects-bound?(prog, root) == 0 ? [nothing(), "refused", g, 0] : (Comparable) jonb-evaluable?(prog, root) == 0 ? [nothing(), "refused", g, 0] : hg-request-go(g, prog, root, arg);
    def hg-request-go(g, prog, root, arg) = {
        let id = jonb-identity(prog, root, jonb-epoch(hg-reg(g)));
        let low = hg-lowerable?(prog);
        let hs = hg-bump(hg-heats(g), id, low);
        let fires = hg-fires(g, id) + 1;
        (Comparable) low == 0 ? [jonb-eval-covered(prog, root, arg), "form", [hg-reg(g), hs], 0] : (Comparable) jd-crystallize?(fires, low) == 0 ? nothing?(jonb-lookup(hg-reg(g), prog, root)) ? [jonb-eval-covered(prog, root, arg), "form", [hg-reg(g), hs], 0] : {
            let r = jonb-request(hg-reg(g), prog, root, arg);
            [r[0], r[1], [r[2], hs], r[3]];
        } : {
            let r = jonb-request(hg-reg(g), prog, root, arg);
            [r[0], r[1], [r[2], hs], r[3]];
        };
    };
    // ── cooling: jd-melt? dissolves the cooled, observable, heat reset ─────
    // halves every heat; entries whose halved heat melts are dropped from the
    // registry (counted) so the next crossing REbirths — hysteresis whole.
    def hg-cool(g) = {
        let halved = hg-halve(hg-heats(g), []);
        let swept = hg-sweep-meltable(jonb-entries(hg-reg(g)), halved, [], 0);
        [[[jonb-epoch(hg-reg(g)), swept[0]], halved], swept[1]];
    };
    def hg-halve(hs, out) = (Comparable) len(hs) == 0 ? reverse(out) : hg-halve(hs[1:], cons([hs[0][0], hs[0][1] / 2, hs[0][2]], out));
    def hg-melts?(hs, id) = {
        let h = hg-find(hs, id);
        nothing?(h) ? 1 : jd-melt?(h[1]);
    };
    def hg-sweep-meltable(es, hs, kept, melted) = (Comparable) len(es) == 0 ? [reverse(kept), melted] : (Comparable) hg-melts?(hs, es[0][0]) == 1 ? hg-sweep-meltable(es[1:], hs, kept, melted + 1) : hg-sweep-meltable(es[1:], hs, cons(es[0], kept), melted);
    // ── hottest: every row at the max, lowerability flagged, ties kept ─────
    def hg-max(hs, m) = (Comparable) len(hs) == 0 ? m : hg-max(hs[1:], hs[0][1] > m ? hs[0][1] : m);
    def hg-at(hs, m, out) = (Comparable) len(hs) == 0 ? reverse(out) : hg-at(hs[1:], m, (Comparable) hs[0][1] == m ? cons(hs[0], out) : out);
    def hg-hottest(g) = {
        let m = hg-max(hg-heats(g), 0);
        (Comparable) m == 0 ? [] : hg-at(hg-heats(g), m, []);
    };
    0;
}
