// attuned-inquiry.fk — frequency before topology: inquiry follows the living edge
// without making protection, economy, or a winner-selection score sovereign.
//
// A human correction caught an imported architecture whose mechanism was useful
// (let uncertainty shape the next inquiry) but whose governing relation was not:
// "risk" and "cost" had become ranking axes inside curiosity. This cell keeps the
// mechanism and re-tunes its frequency:
//
//   imported "risk"            -> an EDGE READING from the consent/reversibility organ
//   imported "cost"            -> BREATH WEIGHT, sensed against carrying capacity
//   imported "information-gain"-> the LIVING UNKNOWN, not a utility target
//   imported "ranking"         -> a BRAID that keeps every signal in arrival order
//
// The edge and breath remain real. They do not disappear into naive openness:
// "hold" stays held, "with-care" is tended, and an uncarried weight rests. But
// neither becomes a scalar penalty that crowns one inquiry over another. The
// inquiry organ receives their readings and stays inquiry.
//
// Play needs no predicted utility. Within a witnessed open edge and the body's
// carrying capacity, a play movement remains admissible even at vitality zero.
// Executed movement learns whether or not it changed the world; held, resting,
// and with-care signals are tended rather than rejected. Ungrounded proposals
// compost honestly.
//
// `ati-frequency-route` composes form-freq-check's honest three-state reading:
// measured fear asks for re-tuning, measured clear may be received, and unknown
// holds. The axis transmutation below is content-bound to this witnessed human
// correction; it is not presented as a general semantic detector.
//
//
// preludes: form-stdlib/core.fk form-stdlib/form-freq-check.fk
section [form.bml] {
    // ── frequency arrives before the mechanism is admitted ─────────────
    def ati-frequency-route(reading) = (Comparable) fc-reading-measured?(reading) == 0 ? "hold" : (Comparable) fc-reading-state(reading) == fc-state-fear() ? "retune" : "receive";
    // The exact human-gold transmutation that founded this cell. Unknown
    // axes pass through unchanged; this is a narrow correction, not a lexicon.
    def ati-retune-axis(axis) = (String) axis == "risk" ? "edge-reading" : (String) axis == "cost" ? "breath-weight" : (String) axis == "information-gain" ? "living-unknown" : (String) axis == "ranking" ? "braid" : axis;
    def ati-retune-axes(axes) = (Comparable) len(axes) == 0 ? empty() : cons(ati-retune-axis(head(axes)), ati-retune-axes(tail(axes)));
    // ── specialized edge organ: consent/reversibility speaks once ──────
    // state = "open" | "with-care" | "hold". The inquiry organ does not
    // derive this reading or turn it into a magnitude.
    def ati-edge(state, source, witnessed) = ["ati-edge", state, source, witnessed];
    def ati-edge-state(edge) = edge[1];
    def ati-edge-source(edge) = edge[2];
    def ati-edge-witnessed(edge) = edge[3];
    def ati-edge-state-valid?(state) = (String) state == "open" ? 1 : (String) state == "with-care" ? 1 : (String) state == "hold" ? 1 : 0;
    def ati-edge-valid?(edge) = (Comparable) len(edge) == 4 ? (String) head(edge) == "ati-edge" ? (Comparable) ati-edge-witnessed(edge) == 1 ? str_len(ati-edge-source(edge)) > 0 ? ati-edge-state-valid?(ati-edge-state(edge)) : 0 : 0 : 0 : 0;
    // ── breath: weight is sensed, never minimized ──────────────────────
    def ati-breath(capacity, weight, witnessed) = ["ati-breath", capacity, weight, witnessed];
    def ati-breath-capacity(breath) = breath[1];
    def ati-breath-weight(breath) = breath[2];
    def ati-breath-witnessed(breath) = breath[3];
    def ati-breath-valid?(breath) = (Comparable) len(breath) == 4 ? (String) head(breath) == "ati-breath" ? (Comparable) ati-breath-witnessed(breath) == 1 ? ati-breath-capacity(breath) >= 0 && ati-breath-weight(breath) >= 0 ? 1 : 0 : 0 : 0 : 0;
    def ati-carried?(breath) = (Comparable) ati-breath-valid?(breath) == 1 ? ati-breath-capacity(breath) >= ati-breath-weight(breath) ? 1 : 0 : 0;
    // ── one grounded unknown offered to the inquiry pulse ──────────────
    // mode = "move" | "wander" | "play".
    def ati-inquiry(id, grounding, vitality, mode, edge, breath) = ["ati-inquiry", id, grounding, vitality, mode, edge, breath];
    def ati-inquiry?(inquiry) = (Comparable) len(inquiry) == 7 ? (String) head(inquiry) == "ati-inquiry" ? 1 : 0 : 0;
    def ati-inquiry-id(inquiry) = inquiry[1];
    def ati-inquiry-grounding(inquiry) = inquiry[2];
    def ati-inquiry-vitality(inquiry) = inquiry[3];
    def ati-inquiry-mode(inquiry) = inquiry[4];
    def ati-inquiry-edge(inquiry) = inquiry[5];
    def ati-inquiry-breath(inquiry) = inquiry[6];
    def ati-grounded?(inquiry) = (Comparable) ati-inquiry?(inquiry) == 1 ? str_len(ati-inquiry-grounding(inquiry)) > 0 ? 1 : 0 : 0;
    def ati-play?(inquiry) = (String) ati-inquiry-mode(inquiry) == "play" ? 1 : 0;
    def ati-alive?(inquiry) = (Comparable) ati-play?(inquiry) == 1 ? 1 : ati-inquiry-vitality(inquiry) > 0 ? 1 : 0;
    // ── attunement returns a relation, never a winner ──────────────────
    def ati-movement-state(inquiry) = (Comparable) ati-grounded?(inquiry) == 0 ? "compost" : (Comparable) ati-edge-valid?(ati-inquiry-edge(inquiry)) == 0 ? "hold" : (String) ati-edge-state(ati-inquiry-edge(inquiry)) == "hold" ? "hold" : (Comparable) ati-breath-valid?(ati-inquiry-breath(inquiry)) == 0 ? "rest" : (Comparable) ati-carried?(ati-inquiry-breath(inquiry)) == 0 ? "rest" : (String) ati-edge-state(ati-inquiry-edge(inquiry)) == "with-care" ? "tend" : (Comparable) ati-play?(inquiry) == 1 ? "play" : (Comparable) ati-alive?(inquiry) == 0 ? "tend" : (String) ati-inquiry-mode(inquiry) == "wander" ? "wander" : (String) ati-inquiry-mode(inquiry) == "move" ? "move" : "tend";
    // A movement keeps the edge and breath readings inspectable. Weight is
    // carried in the receipt, not used to reorder the field.
    def ati-movement(inquiry) = ["ati-movement", ati-inquiry-id(inquiry), ati-movement-state(inquiry), ati-edge-state(ati-inquiry-edge(inquiry)), ati-breath-capacity(ati-inquiry-breath(inquiry)), ati-breath-weight(ati-inquiry-breath(inquiry))];
    def ati-movement-id(movement) = movement[1];
    def ati-movement-state-read(movement) = movement[2];
    def ati-movement-edge-state(movement) = movement[3];
    def ati-movement-capacity(movement) = movement[4];
    def ati-movement-weight(movement) = movement[5];
    // BRAID: every signal remains, arrival order remains, no max-select and
    // no lowest-weight crown. Hold/rest/tend are information, not failures.
    def ati-braid(inquiries) = (Comparable) len(inquiries) == 0 ? empty() : cons(ati-movement(head(inquiries)), ati-braid(tail(inquiries)));
    // ── witness: movement changes relation whether it "succeeds" or not ─
    def ati-after-state(movement-state) = (String) movement-state == "compost" ? "compost" : (String) movement-state == "hold" ? "tend" : (String) movement-state == "rest" ? "tend" : (String) movement-state == "tend" ? "tend" : "learn";
    def ati-witness(movement, changed) = ["ati-witness", ati-movement-id(movement), ati-movement-state-read(movement), changed, ati-after-state(ati-movement-state-read(movement))];
    def ati-witness-changed(witness) = witness[3];
    def ati-witness-after(witness) = witness[4];
    0;
}
