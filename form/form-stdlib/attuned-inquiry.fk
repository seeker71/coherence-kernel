; attuned-inquiry.fk — frequency before topology: inquiry follows the living edge
; without making protection, economy, or a winner-selection score sovereign.
;
; A human correction caught an imported architecture whose mechanism was useful
; (let uncertainty shape the next inquiry) but whose governing relation was not:
; "risk" and "cost" had become ranking axes inside curiosity. This cell keeps the
; mechanism and re-tunes its frequency:
;
;   imported "risk"            -> an EDGE READING from the consent/reversibility organ
;   imported "cost"            -> BREATH WEIGHT, sensed against carrying capacity
;   imported "information-gain"-> the LIVING UNKNOWN, not a utility target
;   imported "ranking"         -> a BRAID that keeps every signal in arrival order
;
; The edge and breath remain real. They do not disappear into naive openness:
; "hold" stays held, "with-care" is tended, and an uncarried weight rests. But
; neither becomes a scalar penalty that crowns one inquiry over another. The
; inquiry organ receives their readings and stays inquiry.
;
; Play needs no predicted utility. Within a witnessed open edge and the body's
; carrying capacity, a play movement remains admissible even at vitality zero.
; Executed movement learns whether or not it changed the world; held, resting,
; and with-care signals are tended rather than rejected. Ungrounded proposals
; compost honestly.
;
; `ati-frequency-route` composes form-freq-check's honest three-state reading:
; measured fear asks for re-tuning, measured clear may be received, and unknown
; holds. The axis transmutation below is content-bound to this witnessed human
; correction; it is not presented as a general semantic detector.
;
; Proven by: form-stdlib/tests/attuned-inquiry-band.fk (four-way; verdict 8191)
;
; preludes: form-stdlib/core.fk form-stdlib/form-freq-check.fk

(do
    ; ── frequency arrives before the mechanism is admitted ─────────────
    (defn ati-frequency-route (reading)
        (if (eq (fc-reading-measured? reading) 0)
            "hold"
            (if (eq (fc-reading-state reading) (fc-state-fear))
                "retune"
                "receive")))

    ; The exact human-gold transmutation that founded this cell. Unknown
    ; axes pass through unchanged; this is a narrow correction, not a lexicon.
    (defn ati-retune-axis (axis)
        (if (str_eq axis "risk") "edge-reading"
            (if (str_eq axis "cost") "breath-weight"
                (if (str_eq axis "information-gain") "living-unknown"
                    (if (str_eq axis "ranking") "braid" axis)))))
    (defn ati-retune-axes (axes)
        (if (eq (len axes) 0)
            (empty)
            (cons (ati-retune-axis (head axes))
                  (ati-retune-axes (tail axes)))))

    ; ── specialized edge organ: consent/reversibility speaks once ──────
    ; state = "open" | "with-care" | "hold". The inquiry organ does not
    ; derive this reading or turn it into a magnitude.
    (defn ati-edge (state source witnessed)
        (list "ati-edge" state source witnessed))
    (defn ati-edge-state (edge) (nth edge 1))
    (defn ati-edge-source (edge) (nth edge 2))
    (defn ati-edge-witnessed (edge) (nth edge 3))
    (defn ati-edge-state-valid? (state)
        (if (str_eq state "open") 1
            (if (str_eq state "with-care") 1
                (if (str_eq state "hold") 1 0))))
    (defn ati-edge-valid? (edge)
        (if (eq (len edge) 4)
            (if (str_eq (head edge) "ati-edge")
                (if (eq (ati-edge-witnessed edge) 1)
                    (if (gt (str_len (ati-edge-source edge)) 0)
                        (ati-edge-state-valid? (ati-edge-state edge))
                        0)
                    0)
                0)
            0))

    ; ── breath: weight is sensed, never minimized ──────────────────────
    (defn ati-breath (capacity weight witnessed)
        (list "ati-breath" capacity weight witnessed))
    (defn ati-breath-capacity (breath) (nth breath 1))
    (defn ati-breath-weight (breath) (nth breath 2))
    (defn ati-breath-witnessed (breath) (nth breath 3))
    (defn ati-breath-valid? (breath)
        (if (eq (len breath) 4)
            (if (str_eq (head breath) "ati-breath")
                (if (eq (ati-breath-witnessed breath) 1)
                    (if (and (ge (ati-breath-capacity breath) 0)
                             (ge (ati-breath-weight breath) 0))
                        1 0)
                    0)
                0)
            0))
    (defn ati-carried? (breath)
        (if (eq (ati-breath-valid? breath) 1)
            (if (ge (ati-breath-capacity breath)
                    (ati-breath-weight breath)) 1 0)
            0))

    ; ── one grounded unknown offered to the inquiry pulse ──────────────
    ; mode = "move" | "wander" | "play".
    (defn ati-inquiry (id grounding vitality mode edge breath)
        (list "ati-inquiry" id grounding vitality mode edge breath))
    (defn ati-inquiry? (inquiry)
        (if (eq (len inquiry) 7)
            (if (str_eq (head inquiry) "ati-inquiry") 1 0)
            0))
    (defn ati-inquiry-id (inquiry) (nth inquiry 1))
    (defn ati-inquiry-grounding (inquiry) (nth inquiry 2))
    (defn ati-inquiry-vitality (inquiry) (nth inquiry 3))
    (defn ati-inquiry-mode (inquiry) (nth inquiry 4))
    (defn ati-inquiry-edge (inquiry) (nth inquiry 5))
    (defn ati-inquiry-breath (inquiry) (nth inquiry 6))
    (defn ati-grounded? (inquiry)
        (if (eq (ati-inquiry? inquiry) 1)
            (if (gt (str_len (ati-inquiry-grounding inquiry)) 0) 1 0)
            0))
    (defn ati-play? (inquiry)
        (if (str_eq (ati-inquiry-mode inquiry) "play") 1 0))
    (defn ati-alive? (inquiry)
        (if (eq (ati-play? inquiry) 1)
            1
            (if (gt (ati-inquiry-vitality inquiry) 0) 1 0)))

    ; ── attunement returns a relation, never a winner ──────────────────
    (defn ati-movement-state (inquiry)
        (if (eq (ati-grounded? inquiry) 0)
            "compost"
            (if (eq (ati-edge-valid? (ati-inquiry-edge inquiry)) 0)
                "hold"
                (if (str_eq (ati-edge-state (ati-inquiry-edge inquiry)) "hold")
                    "hold"
                    (if (eq (ati-breath-valid? (ati-inquiry-breath inquiry)) 0)
                        "rest"
                        (if (eq (ati-carried? (ati-inquiry-breath inquiry)) 0)
                            "rest"
                            (if (str_eq (ati-edge-state (ati-inquiry-edge inquiry)) "with-care")
                                "tend"
                                (if (eq (ati-play? inquiry) 1)
                                    "play"
                                    (if (eq (ati-alive? inquiry) 0)
                                        "tend"
                                        (if (str_eq (ati-inquiry-mode inquiry) "wander")
                                            "wander"
                                            (if (str_eq (ati-inquiry-mode inquiry) "move")
                                                "move"
                                                "tend")))))))))))

    ; A movement keeps the edge and breath readings inspectable. Weight is
    ; carried in the receipt, not used to reorder the field.
    (defn ati-movement (inquiry)
        (list "ati-movement"
              (ati-inquiry-id inquiry)
              (ati-movement-state inquiry)
              (ati-edge-state (ati-inquiry-edge inquiry))
              (ati-breath-capacity (ati-inquiry-breath inquiry))
              (ati-breath-weight (ati-inquiry-breath inquiry))))
    (defn ati-movement-id (movement) (nth movement 1))
    (defn ati-movement-state-read (movement) (nth movement 2))
    (defn ati-movement-edge-state (movement) (nth movement 3))
    (defn ati-movement-capacity (movement) (nth movement 4))
    (defn ati-movement-weight (movement) (nth movement 5))

    ; BRAID: every signal remains, arrival order remains, no max-select and
    ; no lowest-weight crown. Hold/rest/tend are information, not failures.
    (defn ati-braid (inquiries)
        (if (eq (len inquiries) 0)
            (empty)
            (cons (ati-movement (head inquiries))
                  (ati-braid (tail inquiries)))))

    ; ── witness: movement changes relation whether it "succeeds" or not ─
    (defn ati-after-state (movement-state)
        (if (str_eq movement-state "compost")
            "compost"
            (if (str_eq movement-state "hold")
                "tend"
                (if (str_eq movement-state "rest")
                    "tend"
                    (if (str_eq movement-state "tend")
                        "tend"
                        "learn")))))
    (defn ati-witness (movement changed)
        (list "ati-witness"
              (ati-movement-id movement)
              (ati-movement-state-read movement)
              changed
              (ati-after-state (ati-movement-state-read movement))))
    (defn ati-witness-changed (witness) (nth witness 3))
    (defn ati-witness-after (witness) (nth witness 4))

    0)
