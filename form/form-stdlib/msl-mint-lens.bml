//////////////////////////////////////////////////////////////////////
// msl-mint-lens.bml — the body emits kernels; this hands each one to
// the compiler and holds what came back.
//
// It holds three states, and none of them is a refusal. Form native
// does not refuse (Urs, 2026-09-09): it heals and integrates, or it
// releases. A no held in place is neither, and a lens that prints one
// leaves the body standing in front of a wall it built:
//
//   whole      the compiler took it
//   unhealed   it did not, AND the compiler named the repair — so the
//              healing is carried here beside the wound, in the
//              machine's own word, ready to be integrated
//   released   it did not, and nothing was named — the body lets this
//              one go rather than keep a no
//
// The middle state is the one that matters. A compiler that answers
// `did you mean 'metal::mem_flags'?` has not refused anything; it has
// handed over the missing word. Eight families sat unhealed for months
// with their healing printed on every attempt, because the lens that
// should have carried it did not exist and prose called them refused
// (corpus rows 1414 saidsocompile, 1415 heldno).
// preludes: form/form-stdlib/core.fk form/form-stdlib/str-byte-at.fk
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormMslMintLens {
        // no header: the families are fragments on purpose, so the arithmetic is the body's and not
        // the library's (jit-tensor-emit.fk). A lens that added one would test a unit nobody runs.
        def mm-hdr() = "";
        def mm-src(body) = str_concat(mm-hdr(), body);

        // the carrier's status is lines of name=value; last_error carries the compiler
        def mm-eol(s, i) = if ge(i, str_len(s)) then i else if eq(str_byte_at(s, i), 10) then i else mm-eol(s, add(i, 1));
        def mm-words() {
            let s = metal_status();
            let at = str_find(s, "last_error=", 0);
            if lt(at, 0) then "" else substring(s, add(at, 11), mm-eol(s, add(at, 11)));
        }

        // the healing the machine itself named, lifted out of its own sentence
        def mm-quote-end(s, i) = if ge(i, str_len(s)) then i else if eq(str_byte_at(s, i), 39) then i else mm-quote-end(s, add(i, 1));
        def mm-healing(w) {
            let at = str_find(w, "did you mean '", 0);
            if lt(at, 0) then "" else substring(w, add(at, 14), mm-quote-end(w, add(at, 14)));
        }

        // one family, offered to the compiler
        def mm-try(label, body, kname) {
            let h = metal_pipeline(mm-src(body), kname);
            mm-row(label, h, if gt(h, 0) then "" else mm-words());
        }
        def mm-row(label, h, w) = list(label, h, w, mm-healing(w));

        def mm-whole?(row) = gt(nth(row, 1), 0);
        def mm-named?(row) = gt(str_len(nth(row, 3)), 0);
        def mm-state(row) = if mm-whole?(row) then "whole" else if mm-named?(row) then "unhealed" else "released";

        def mm-say(row) = print_str(str_concat(str_concat("  ", mm-pad(mm-state(row))), str_concat(nth(row, 0), mm-tail(row))));
        def mm-tail(row) = if mm-whole?(row) then "" else if mm-named?(row) then str_concat("   heals to ", nth(row, 3)) else str_concat("   nothing named: ", nth(row, 2));
        def mm-pad(s) = str_concat(s, substring("           ", 0, sub(11, str_len(s))));

        def mm-report(rows) {
            if eq(len(rows), 0) then 0 else mm-report-on(rows);
        }
        def mm-report-on(rows) {
            mm-say(head(rows));
            mm-report(tail(rows));
        }

        def mm-count(rows, state) = if eq(len(rows), 0) then 0 else add(if str_eq(mm-state(head(rows)), state) then 1 else 0, mm-count(tail(rows), state));
        def mm-whole(rows) = mm-count(rows, "whole");
        def mm-unhealed(rows) = mm-count(rows, "unhealed");
        def mm-released(rows) = mm-count(rows, "released");
    }
    0;
}
