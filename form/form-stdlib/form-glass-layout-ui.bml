//////////////////////////////////////////////////////////////////////
//
// form-glass-layout-ui.bml — responsive frame-composition shard.
//
// Authority: form-stdlib/bml/form-glass-live-ui.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-meaning-ui.bml form/form-stdlib/form-glass-flow-ui.bml form/form-stdlib/form-glass-observation-ui.bml form/form-stdlib/form-glass-atlas-ui.bml form/form-stdlib/form-glass-dashboard.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassLayoutUI {
        field FGLLayoutShardSchema = "form-glass-layout-ui-v1";

        def fglui-help-row(text, width, id) = fgd-segment-line(text, width, fgd-neutral(220), id, list("help", "control"), "declared");
        def fglui-help-lines(width) = list(
            fgd-title-segment-line("HELP / LINE-COMMIT KEYS", width, "help.keys"),
            fglui-help-row("run observe/form-glass-control-run.fk; key then Enter", width, "help.start"),
            fglui-help-row("h help   a atlas   t raster   o overview", width, "help.views.1"),
            fglui-help-row("m memory f flow    j recipes  s meaning  k kernel", width, "help.views.2"),
            fglui-help-row("v events n channels (live samples by kind)", width, "help.views.2b"),
            fglui-help-row("1 go 2 py 3 rs 4 ts 0 none (meaning)   q abstain", width, "help.views.3"),
            fglui-help-row("i inspect  e evidence  c continue", width, "help.inspect"),
            fglui-help-row("focus view|channel|id; ack wait <=2s", width, "help.focus"));

        def fglui-glossary-row(text, width, id, plane) = fgd-segment-line(text, width, fgd-style-for-plane(plane, 220, 0), id, list("help", "glossary", plane), "declared");
        def fglui-glossary-lines(width) = list(
            fgd-title-segment-line("SYMBOL GLOSSARY", width, "help.glossary"),
            fglui-glossary-row("truth: * live  + derived  # catalog", width, "help.truth.1", "form"),
            fglui-glossary-row("       ~ declared  ? missing door", width, "help.truth.2", "form"),
            fglui-glossary-row("state: > active : prefill = ready", width, "help.state.1", "metal"),
            fglui-glossary-row("       o resident m mapped x released", width, "help.state.2", "metal"),
            fglui-glossary-row("KTVVV: kind truth compact value", width, "help.ktvvv", "unified"),
            fglui-glossary-row("zero: 0i idle  0e empty  0d drained  0q quiet", width, "help.zero", "cpu"),
            fglui-glossary-row("gap: -- absent  --- missing  ?=? no live value", width, "help.gap", "form"),
            fglui-glossary-row("move: ^ rose  v fell  = unchanged  . no pred", width, "help.move", "membrane"),
            fglui-glossary-row("PRESS free/used/warn@10/crit@5 rss cpu gov", width, "help.press", "unified"),
            fglui-glossary-row("Q request  T token  L layer  X tensor", width, "help.pipe.1", "membrane"),
            fglui-glossary-row("E expert M Metal F frame G Glass", width, "help.pipe.2", "metal"),
            fglui-glossary-row("gas -> water -> ice: live -> held -> cache", width, "help.phase", "disk"),
            fglui-glossary-row("alpha: bright=new; dim=older observation", width, "help.alpha", "cpu"),
            fglui-glossary-row("age is evidence time, never data age guess", width, "help.age", "form"));

        def fglui-queue-line(metrics, width) {
            let queue = fgd-find-metric(metrics, "queue-depth");
            let pending = if gt(len(queue), 0) then queue else fgd-find-metric(metrics, "pending");
            let state = fgd-find-metric(metrics, "queue-state");
            if gt(len(pending), 0) then fgd-metric-segment-line(pending, width) else if gt(len(state), 0) then fgd-metric-segment-line(state, width) else fgd-segment-line("QUEUE UNAVAILABLE door=hearth.request-queue.publisher reason=no-publisher", width, fgd-neutral(96), "queue.unavailable", list("queue", "request", "health"), "unavailable");
        }
        def fglui-model-owner-sample?(sample) = if str_eq(fgtm-sample-kind(sample), "model") then 1 else if str_eq(fgtm-sample-kind(sample), "owner-liveness") then 1 else 0;
        def fglui-owner-liveness-epoch(sample) = if eq(fgtm-field-present?(fgtm-sample-read-epoch(sample)), 1) then fgtm-field-value(fgtm-sample-read-epoch(sample)) else -1;
        def fglui-newest-owner-liveness(samples, held) = if eq(len(samples), 0) then held else if not(str_eq(fgtm-sample-kind(head(samples)), "owner-liveness")) then fglui-newest-owner-liveness(tail(samples), held) else if eq(len(held), 0) then fglui-newest-owner-liveness(tail(samples), head(samples)) else if gt(fglui-owner-liveness-epoch(head(samples)), fglui-owner-liveness-epoch(held)) then fglui-newest-owner-liveness(tail(samples), head(samples)) else fglui-newest-owner-liveness(tail(samples), held);
        def fglui-model-owner-samples(samples) {
            let models = fglui-kind-samples(samples, "model");
            let liveness = fglui-newest-owner-liveness(samples, list());
            if eq(len(liveness), 0) then models else append(models, list(liveness));
        }
        def fglui-organ-line(metrics, width) = fgd-segment-line(fgd-cat(list("F node=", fgd-metric-value(fgd-find-metric(metrics, "cells")), " bp=", fgd-metric-value(fgd-find-metric(metrics, "blueprint-source-count")), " rc=", fgd-metric-value(fgd-find-metric(metrics, "recipe-source-count")), " alloc=?")), width, fgd-style-for-plane("form", 220, 0), "form.states", list("cell", "blueprint", "recipe"), "catalog");
        def fglui-field-number-text(field) = if eq(fgtm-field-present?(field), 1) then fgd-format-count(fgtm-field-value(field)) else "absent";
        def fglui-field-bytes-text(field) = if eq(fgtm-field-present?(field), 1) then fgd-format-bytes(fgtm-field-value(field)) else "absent";
        def fglui-sample-artifact-text(sample) = if eq(fgd-logical-artifact-byte-sample?(sample), 1) then str_concat(fglui-field-bytes-text(fgtm-sample-bytes(sample)), "(logical-catalog)") else "absent";
        def fglui-sample-mapped-text(sample) = if and(str_eq(fgtm-sample-plane(sample), "mapped-file"), and(str_eq(fgtm-sample-evidence(sample), "physical-live"), eq(fgtm-field-present?(fgtm-sample-bytes(sample)), 1))) then fglui-field-bytes-text(fgtm-sample-bytes(sample)) else "unavailable(model.carrier-per-model-mapped-bytes)";
        def fglui-sample-materialized-text(sample) = if and(eq(fgd-material-plane?(fgtm-sample-plane(sample)), 1), and(str_eq(fgtm-sample-evidence(sample), "physical-live"), eq(fgtm-field-present?(fgtm-sample-bytes(sample)), 1))) then fglui-field-bytes-text(fgtm-sample-bytes(sample)) else "unavailable(model.materialized-resident-bytes)";
        def fglui-sample-callable-text(sample) = if not(str_eq(fgtm-sample-kind(sample), "model")) then "not-applicable" else if eq(fgtm-field-present?(fgtm-sample-handle(sample)), 1) then str_concat("unproven(handle=", str_concat(int_to_str(fgtm-field-value(fgtm-sample-handle(sample))), ";door=model.route-readiness)")) else "unavailable(model.route-readiness)";
        def fglui-evidence-line(text, width, style, id, channels, evidence) = fgd-segment-line(text, width, style, id, channels, evidence);
        def fglui-sample-evidence-lines(selected, sample, epoch, width) {
            let style = fgd-sample-style(sample, epoch);
            let channels = fgtm-sample-channels(sample);
            let evidence = fgtm-sample-evidence(sample);
            list(fglui-evidence-line(fgd-cat(list("E ", selected, " ", fgtm-sample-kind(sample), "/", fgtm-sample-lifecycle(sample), " ", fgtm-sample-plane(sample), " ", evidence, " age:", fgd-sample-age-text(sample, epoch))), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("field=", fgd-sample-projection-id(sample), " source-node=? telemetry.nodeid-owner-binding")), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("owner=", fgtm-sample-owner(sample), " src=", fgtm-sample-source(sample), " lane=", fgtm-sample-lane(sample), " impact=", fgtm-sample-purpose(sample))), width, style, selected, channels, evidence));
        }
        def fglui-metric-evidence-lines(selected, metric, width) {
            let style = fgd-style-for-metric(metric);
            let id = str_concat("metric.", selected);
            let channels = list(fgo-channel(metric));
            let evidence = fgo-evidence(metric);
            list(fglui-evidence-line(fgd-cat(list("E ", id, "=", fgd-metric-value(metric), " ", fgo-unit(metric), " ", fgo-lifecycle(metric), "/", evidence, " age=", fgd-format-age-ms(fgo-age(metric)))), width, style, id, channels, evidence),
                fglui-evidence-line(fgd-cat(list("field=", if eq(fgo-nodeid-bound?(metric), 1) then fgo-nodeid-value(metric) else "?", " event=", int_to_str(fgo-observation-sequence(metric)), "@", int_to_str(fgo-observed-epoch(metric)), " source-node=", if eq(fgo-source-nodeid-bound?(metric), 1) then fgo-source-nodeid-value(metric) else "?")), width, style, id, channels, evidence),
                fglui-evidence-line(fgd-cat(list("src=", fgo-source(metric), " plane=", fgo-plane(metric), " impact=", fgo-note(metric))), width, style, id, channels, evidence));
        }
        def fglui-observation-evidence-lines(selected, observation, epoch, width) {
            let provenance = fgov2-observation-provenance(observation);
            let evidence = fgov2-provenance-evidence(provenance);
            let style = fgd-style-for-plane(fgov2-observation-plane(observation), 220, 0);
            let channels = list("evidence", fgov2-observation-kind(observation), fgov2-observation-plane(observation));
            list(fglui-evidence-line(fgd-cat(list("E ", selected, "=", fglui-truth-text(fgov2-observation-measurement(observation), fgov2-observation-unit(observation), epoch), " ", fgov2-observation-unit(observation), " ", fgov2-observation-kind(observation), "/", evidence, " age=", fglui-observation-age(observation, epoch))), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("field=", fglat-observation-projection-id(observation), " source-node=? telemetry.nodeid-owner-binding")), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("publisher=", fgov2-provenance-publisher(provenance), " src=", fgov2-provenance-source(provenance), " plane=", fgov2-observation-plane(observation), " impact=", fgov2-observation-subtype(observation))), width, style, selected, channels, evidence));
        }
        def fglui-metric-selector-id(selected) = if and(ge(str_len(selected), 8), str_eq(substring(selected, 0, 7), "metric.")) then substring(selected, 7, str_len(selected)) else selected;
        def fglui-evidence-lines(selected, open, metrics, samples, observations, epoch, width) {
            let sample = fglui-find-sample(samples, selected);
            let metric = fgd-find-metric(metrics, fglui-metric-selector-id(selected));
            let observation = fglui-find-observation(observations, selected);
            if eq(open, 0) then list(fgd-segment-line(fgd-cat(list("selection=", selected, " evidence=closed; offer request-evidence ", selected)), width, fgd-neutral(128), "evidence.closed", list("evidence", "membrane"), "declared")) else if gt(len(sample), 0) then fglui-sample-evidence-lines(selected, sample, epoch, width) else if gt(len(metric), 0) then fglui-metric-evidence-lines(fglui-metric-selector-id(selected), metric, width) else if gt(len(observation), 0) then fglui-observation-evidence-lines(selected, observation, epoch, width) else list(fgd-segment-line(fgd-cat(list("EVID UNAVAILABLE door=glass.selection.publisher reason=selection-not-published id=", selected)), width, fgd-health(), "evidence.unavailable", list("evidence", "health"), "unavailable"));
        }
        def fglui-evidence(selected, open, metrics, samples, observations, epoch, width) = head(fglui-evidence-lines(selected, open, metrics, samples, observations, epoch, width));
        def fglui-metric-key(metric) = fgd-cat(list(fgo-domain(metric), ".", fgo-id(metric)));
        def fglui-metric-key-held?(rows, key) = if eq(len(rows), 0) then 0 else if str_eq(fglui-metric-key(head(rows)), key) then 1 else fglui-metric-key-held?(tail(rows), key);
        def fglui-unique-metrics-go(rows, held) = if eq(len(rows), 0) then held else if eq(fglui-metric-key-held?(held, fglui-metric-key(head(rows))), 1) then fglui-unique-metrics-go(tail(rows), held) else fglui-unique-metrics-go(tail(rows), append(held, list(head(rows))));
        def fglui-unique-metrics(rows) = fglui-unique-metrics-go(rows, list());
        def fglui-missing-metrics(rows) = if eq(len(rows), 0) then list() else if eq(fgo-present?(head(rows)), 0) then cons(head(rows), fglui-missing-metrics(tail(rows))) else fglui-missing-metrics(tail(rows));
        def fglui-seam-line(metrics, width) {
            let seams = fglui-missing-metrics(fglui-unique-metrics(metrics));
            if eq(len(seams), 0) then fgd-segment-line("! seams=0", width, fgd-ready(), "organs.seams", list("health", "evidence"), "physical-live") else fgd-segment-line(fgd-cat(list("? seams=", int_to_str(len(seams)), " next=", fgo-source(head(seams)))), width, fgd-health(), "organs.seams", list("health", "evidence"), "unavailable");
        }
        def fglui-left-budget(view, width, epoch, metrics, samples, history, observations, rowBudget) {
            let maps = fgd-map-lines(metrics, samples, epoch, "all", width, if str_eq(view, "memory") then 12 else 5);
            let typed = fglui-observation-lines(fglui-prioritized-observations(fglui-view-observations(observations, view)), epoch, width);
            if str_eq(view, "help") then fglui-help-lines(width) else if str_eq(view, "atlas") then fglat-lines-budget(metrics, samples, observations, history, epoch, width, rowBudget) else if str_eq(view, "raster") then fglat-raster-lines(history, width, rowBudget) else if str_eq(view, "flow") then cons(fgd-title-segment-line("TOKEN FLOW >LAYER>TENSOR>EXPERT>METAL>FRAME>GLASS", width, "section.flow"), append(fglui-token-flow-lines(samples, epoch, width), append(fgd-metric-segment-lines(fglui-flow-attention-metrics(metrics), width), append(fglui-flow-lines(history, width), typed)))) else if str_eq(view, "recipes") then cons(fgd-title-segment-line("RECIPES / JIT STATES", width, "section.recipes"), append(list(fglui-organ-line(metrics, width)), append(typed, fgd-sample-segment-lines(fgd-take(samples, 6), width, epoch)))) else if str_eq(view, "memory") then cons(fgd-title-segment-line("MEMORY cells blueprints recipes tensors arenas", width, "section.memory"), append(typed, maps)) else append(list(fgd-title-segment-line("REQUEST / MODELS + OWNER LIVENESS", width, "section.models"), fglui-queue-line(metrics, width)), append(fgd-sample-segment-lines(fgd-take(fglui-model-owner-samples(samples), 5), width, epoch), append(list(fgd-title-segment-line("MEMORY", width, "section.memory"), fgd-memory-bar-segment(samples, width)), append(fgd-take(typed, 3), maps))));
        }
        def fglui-left(view, width, epoch, metrics, samples, history, observations) = fglui-left-budget(view, width, epoch, metrics, samples, history, observations, 999);
        def fglui-right(view, width, metrics) {
            let unique = fglui-unique-metrics(fglui-view-metrics(metrics, view));
            if str_eq(view, "help") then fglui-glossary-lines(width) else cons(fgd-title-segment-line(if str_eq(view, "recipes") then "JIT / HEAT" else if str_eq(view, "flow") then "REQUEST / DELTAS" else if str_eq(view, "memory") then "ALLOC / CACHE" else "ORGANS / HEALTH", width, "section.right"), append(list(fglui-seam-line(unique, width)), append(if str_eq(view, "overview") then list(fglui-organ-line(unique, width)) else list(), fgd-metric-segment-lines(fgd-present-metrics(unique), width))));
        }
        def fglui-narrow(width, count, epoch, view, selected, open, metrics, samples, allMetrics, allSamples, history, observations) {
            let evidenceLines = fglui-evidence-lines(selected, open, allMetrics, allSamples, observations, epoch, width);
            let contentRows = fgd-max(0, sub(count, len(evidenceLines)));
            let left = fglui-left-budget(view, width, epoch, metrics, samples, history, observations, contentRows);
            let leftVisible = fgd-take(left, contentRows);
            let remaining = fgd-max(0, sub(contentRows, len(leftVisible)));
            let content = if le(remaining, 0) then leftVisible else append(leftVisible, fgd-take(fglui-right(view, width, metrics), remaining));
            if le(count, 0) then list() else fgd-fill-lines(append(content, evidenceLines), count, width);
        }
        def fglui-wide(width, count, epoch, view, selected, open, metrics, samples, allMetrics, allSamples, history, observations) {
            let gap = 3;
            let regions = ftc-measured-split(width, count, gap, ftc-measure(40, 80), ftc-measure(36, 80));
            let lw = ftc-region-width(head(regions));
            let rw = ftc-region-width(nth(regions, 1));
            let evidenceLines = fglui-evidence-lines(selected, open, allMetrics, allSamples, observations, epoch, width);
            let contentRows = fgd-max(0, sub(count, len(evidenceLines)));
            let left = fglui-left-budget(view, lw, epoch, metrics, samples, history, observations, contentRows);
            let right = fglui-right(view, rw, metrics);
            if le(count, 0) then list() else fgd-fill-lines(append(fgd-take(fgd-wide-lines-go(left, right, 0, fgd-max(len(left), len(right)), lw, gap, rw), contentRows), evidenceLines), count, width);
        }
        def fglui-body(width, count, epoch, view, filter, selected, open, metrics, samples, history, observations) {
            let viewedMetrics = fglui-view-metrics(fglui-filter-metrics(metrics, filter), view);
            let viewedSamples = fglui-view-samples(fglui-filter-samples(samples, filter), view);
            if str_eq(view, "meaning") then fgd-take(fglm-lines(filter, div(epoch, 1000), width), count) else if str_eq(view, "events") then fgd-take(fglui-events-lines(samples, epoch, width, count), count) else if str_eq(view, "channels") then fgd-take(fglui-channels-lines(samples, epoch, width, count), count) else if str_eq(view, "kernel") then fgd-take(cons(fgd-title-segment-line("KERNEL live: gift frames, fns, hottest defns with source pointers", width, "section.kernel"), fgd-metric-segment-lines(fgd-filter-metrics(metrics, "kernel"), width)), count) else if or(str_eq(view, "atlas"), or(str_eq(view, "raster"), str_eq(view, "flow"))) then fglui-narrow(width, count, epoch, view, selected, open, viewedMetrics, viewedSamples, metrics, samples, history, observations) else if ge(width, 100) then fglui-wide(width, count, epoch, view, selected, open, viewedMetrics, viewedSamples, metrics, samples, history, observations) else fglui-narrow(width, count, epoch, view, selected, open, viewedMetrics, viewedSamples, metrics, samples, history, observations);
        }
        def fgd-live-segment-frame(width, height, epoch, hz, frame, view, focus, filter, selected, open, metrics, samples, publishers, control, history, observations, seam) {
            let w = fgd-clamp(width, 1, 1000);
            let h = fgd-clamp(height, 1, 300);
            let chosen = fglui-view(view);
            let header = fgd-byte-segment-line(fgdb-cat(list(fgdb-text("FORM GLASS "), fgdb-int(w), fgdb-text("x"), fgdb-int(h), fgdb-text(" "), fgdb-int(hz), fgdb-text("Hz view="), fgdb-text(chosen), fgdb-text(" focus="), fgdb-text(focus), fgdb-text(" filter="), fgdb-text(filter))), w, fgd-title(), "glass.header", list("all"), "declared");
            let tabs = fgd-segment-line(if str_eq(chosen, "help") then "HELP h a t o m f j s k v n 1-4 0 i e c q | line commit with Enter" else "h help a atlas t raster o over m mem f flow j jit | i e c q | *+#?", w, fgd-neutral(176), "glass.tabs", list("all", "control"), "declared");
            let flow = fglui-pulse-line(epoch, hz, frame, history, metrics, w);
            let bodyRows = fgd-max(0, sub(h, 4));
            let body = fglui-body(w, bodyRows, epoch, chosen, filter, selected, open, metrics, samples, history, observations);
            let footer = fgd-byte-segment-line(fgdb-cat(list(fgdb-text(seam), fgdb-text(" | p="), fgdb-int(len(publishers)), fgdb-text(" control="), fgdb-text(control), fgdb-text(" selected="), fgdb-text(selected))), w, fgd-neutral(176), "glass.footer", list("all", "membrane", "control"), "physical-live");
            let evidenceRows = len(fglui-evidence-lines(selected, open, metrics, samples, observations, epoch, w));
            let atlasRows = fgd-max(0, sub(bodyRows, evidenceRows));
            let omitted = if str_eq(chosen, "atlas") then fglat-omitted-count-for-rows(metrics, samples, observations, w, atlasRows) else 0;
            if le(h, 1) then list("form-glass-segment-frame-v2", w, h, list(header), ftc-overflow("hidden-count", omitted)) else list("form-glass-segment-frame-v2", w, h, fgd-fill-lines(append(list(header, tabs, flow), append(body, list(footer))), h, w), ftc-overflow("view-filtered", omitted));
        }
    }
    0;
}
