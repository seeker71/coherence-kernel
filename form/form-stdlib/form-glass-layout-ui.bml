//////////////////////////////////////////////////////////////////////
//
// form-glass-layout-ui.bml — responsive frame-composition shard.
//
// Authority: form-stdlib/bml/form-glass-live-ui.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-flow-ui.bml form/form-stdlib/form-glass-observation-ui.bml form/form-stdlib/form-glass-atlas-ui.bml form/form-stdlib/form-glass-dashboard.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassLayoutUI {
        field FGLLayoutShardSchema = "form-glass-layout-ui-v1";

        def fglui-queue-line(metrics, width) {
            let queue = fgd-find-metric(metrics, "queue-depth");
            let pending = if gt(len(queue), 0) then queue else fgd-find-metric(metrics, "pending");
            let state = fgd-find-metric(metrics, "queue-state");
            if gt(len(pending), 0) then fgd-metric-segment-line(pending, width) else if gt(len(state), 0) then fgd-metric-segment-line(state, width) else fgd-segment-line("QUEUE unavailable(no request-queue publisher)", width, fgd-neutral(96), "queue.unavailable", list("queue", "request", "health"), "unavailable");
        }
        def fglui-model-owner-sample?(sample) = if str_eq(fgtm-sample-kind(sample), "model") then 1 else if str_eq(fgtm-sample-kind(sample), "owner-liveness") then 1 else 0;
        def fglui-owner-liveness-epoch(sample) = if eq(fgtm-field-present?(fgtm-sample-read-epoch(sample)), 1) then fgtm-field-value(fgtm-sample-read-epoch(sample)) else -1;
        def fglui-newest-owner-liveness(samples, held) = if eq(len(samples), 0) then held else if not(str_eq(fgtm-sample-kind(head(samples)), "owner-liveness")) then fglui-newest-owner-liveness(tail(samples), held) else if eq(len(held), 0) then fglui-newest-owner-liveness(tail(samples), head(samples)) else if gt(fglui-owner-liveness-epoch(head(samples)), fglui-owner-liveness-epoch(held)) then fglui-newest-owner-liveness(tail(samples), head(samples)) else fglui-newest-owner-liveness(tail(samples), held);
        def fglui-model-owner-samples(samples) {
            let models = fglui-kind-samples(samples, "model");
            let liveness = fglui-newest-owner-liveness(samples, list());
            if eq(len(liveness), 0) then models else append(models, list(liveness));
        }
        def fglui-organ-line(metrics, width) = fgd-segment-line(fgd-cat(list("FORM process-cells=", fgd-metric-value(fgd-find-metric(metrics, "cells")), " blueprint-catalog=", fgd-metric-value(fgd-find-metric(metrics, "blueprint-source-count")), " recipe-catalog=", fgd-metric-value(fgd-find-metric(metrics, "recipe-source-count")), " runtime-allocation=unavailable(ledger door)")), width, fgd-style-for-plane("form", 220, 0), "form.states", list("cell", "blueprint", "recipe"), "catalog");
        def fglui-field-number-text(field) = if eq(fgtm-field-present?(field), 1) then fgd-format-count(fgtm-field-value(field)) else "absent";
        def fglui-evidence-line(text, width, style, id, channels, evidence) = fgd-segment-line(text, width, style, id, channels, evidence);
        def fglui-sample-evidence-lines(selected, sample, epoch, width) {
            let style = fgd-sample-style(sample, epoch);
            let channels = fgtm-sample-channels(sample);
            let evidence = fgtm-sample-evidence(sample);
            list(fglui-evidence-line(fgd-cat(list("EVID id=", selected)), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("kind=", fgtm-sample-kind(sample), " state=", fgtm-sample-lifecycle(sample), " plane=", fgtm-sample-plane(sample), " evidence=", evidence)), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("bytes=", fglui-field-number-text(fgtm-sample-bytes(sample)), " cap=", fglui-field-number-text(fgtm-sample-capacity(sample)), " ", fgd-sample-age-text(sample, epoch))), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("source=", fgtm-sample-source(sample))), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("owner=", fgtm-sample-owner(sample))), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("lane=", fgtm-sample-lane(sample))), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("purpose=", fgtm-sample-purpose(sample))), width, style, selected, channels, evidence));
        }
        def fglui-metric-evidence-lines(selected, metric, width) {
            let style = fgd-style-for-metric(metric);
            let id = str_concat("metric.", selected);
            let channels = list(fgo-channel(metric));
            let evidence = fgo-evidence(metric);
            list(fglui-evidence-line(fgd-cat(list("EVID id=", id)), width, style, id, channels, evidence),
                fglui-evidence-line(fgd-cat(list("value=", fgd-metric-value(metric), " unit=", fgo-unit(metric))), width, style, id, channels, evidence),
                fglui-evidence-line(fgd-cat(list("plane=", fgo-plane(metric), " state=", fgo-lifecycle(metric), " evidence=", evidence)), width, style, id, channels, evidence),
                fglui-evidence-line(fgd-cat(list("age=", fgd-format-age-ms(fgo-age(metric)))), width, style, id, channels, evidence),
                fglui-evidence-line(fgd-cat(list("source=", fgo-source(metric))), width, style, id, channels, evidence),
                fglui-evidence-line(fgd-cat(list("note=", fgo-note(metric))), width, style, id, channels, evidence));
        }
        def fglui-observation-evidence-lines(selected, observation, epoch, width) {
            let provenance = fgov2-observation-provenance(observation);
            let evidence = fgov2-provenance-evidence(provenance);
            let style = fgd-style-for-plane(fgov2-observation-plane(observation), 220, 0);
            let channels = list("evidence", fgov2-observation-kind(observation), fgov2-observation-plane(observation));
            list(fglui-evidence-line(fgd-cat(list("EVID id=", selected)), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("kind=", fgov2-observation-kind(observation), " subtype=", fgov2-observation-subtype(observation))), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("value=", fglui-truth-text(fgov2-observation-measurement(observation), fgov2-observation-unit(observation), epoch), " unit=", fgov2-observation-unit(observation))), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("plane=", fgov2-observation-plane(observation), " access=", fgov2-observation-access(observation), " evidence=", evidence)), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("age=", fglui-observation-age(observation, epoch))), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("publisher=", fgov2-provenance-publisher(provenance))), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("source=", fgov2-provenance-source(provenance))), width, style, selected, channels, evidence));
        }
        def fglui-evidence-lines(selected, open, metrics, samples, observations, epoch, width) {
            let sample = fglui-find-sample(samples, selected);
            let metric = fgd-find-metric(metrics, selected);
            let observation = fglui-find-observation(observations, selected);
            if eq(open, 0) then list(fgd-segment-line(fgd-cat(list("selection=", selected, " evidence=closed; offer request-evidence ", selected)), width, fgd-neutral(128), "evidence.closed", list("evidence", "membrane"), "declared")) else if gt(len(sample), 0) then fglui-sample-evidence-lines(selected, sample, epoch, width) else if gt(len(metric), 0) then fglui-metric-evidence-lines(selected, metric, width) else if gt(len(observation), 0) then fglui-observation-evidence-lines(selected, observation, epoch, width) else list(fgd-segment-line(fgd-cat(list("EVID unavailable(selection-not-published:", selected, ")")), width, fgd-health(), "evidence.unavailable", list("evidence", "health"), "unavailable"));
        }
        def fglui-evidence(selected, open, metrics, samples, observations, epoch, width) = head(fglui-evidence-lines(selected, open, metrics, samples, observations, epoch, width));
        def fglui-left-budget(view, width, epoch, metrics, samples, history, observations, rowBudget) {
            let maps = fgd-map-lines(metrics, samples, epoch, "all", width, if str_eq(view, "memory") then 12 else 5);
            let typed = fglui-observation-lines(fglui-prioritized-observations(fglui-view-observations(observations, view)), epoch, width);
            if str_eq(view, "atlas") then fglat-lines-budget(metrics, samples, observations, history, epoch, width, rowBudget) else if str_eq(view, "flow") then cons(fgd-title-segment-line("TOKEN FLOW >LAYER>TENSOR>EXPERT>METAL>FRAME>GLASS", width, "section.flow"), append(fglui-token-flow-lines(samples, epoch, width), append(fglui-flow-lines(history, width), typed))) else if str_eq(view, "recipes") then cons(fgd-title-segment-line("RECIPES / JIT STATES", width, "section.recipes"), append(list(fglui-organ-line(metrics, width)), append(typed, fgd-sample-segment-lines(fgd-take(samples, 6), width, epoch)))) else if str_eq(view, "memory") then cons(fgd-title-segment-line("MEMORY cells blueprints recipes tensors arenas", width, "section.memory"), append(typed, maps)) else append(list(fgd-title-segment-line("REQUEST / MODELS + OWNER LIVENESS", width, "section.models"), fglui-queue-line(metrics, width)), append(fgd-sample-segment-lines(fgd-take(fglui-model-owner-samples(samples), 5), width, epoch), append(list(fgd-title-segment-line("MEMORY", width, "section.memory"), fgd-memory-bar-segment(samples, width)), append(fgd-take(typed, 3), maps))));
        }
        def fglui-left(view, width, epoch, metrics, samples, history, observations) = fglui-left-budget(view, width, epoch, metrics, samples, history, observations, 999);
        def fglui-right(view, width, metrics) = cons(fgd-title-segment-line(if str_eq(view, "recipes") then "JIT / PRIMITIVE HEAT (THIS GLASS PROCESS)" else if str_eq(view, "flow") then "REQUEST / CARRIER DELTAS" else if str_eq(view, "memory") then "ALLOCATORS / CACHES" else "ORGANS / HEALTH", width, "section.right"), append(if str_eq(view, "overview") then list(fglui-organ-line(metrics, width)) else list(), fgd-metric-segment-lines(fgd-present-metrics(fglui-view-metrics(metrics, view)), width)));
        def fglui-narrow(width, count, epoch, view, selected, open, metrics, samples, allMetrics, allSamples, history, observations) {
            let evidenceLines = fglui-evidence-lines(selected, open, allMetrics, allSamples, observations, epoch, width);
            let contentRows = fgd-max(0, sub(count, len(evidenceLines)));
            if le(count, 0) then list() else fgd-fill-lines(append(fgd-take(append(fglui-left-budget(view, width, epoch, metrics, samples, history, observations, contentRows), fglui-right(view, width, metrics)), contentRows), evidenceLines), count, width);
        }
        def fglui-wide(width, count, epoch, view, selected, open, metrics, samples, allMetrics, allSamples, history, observations) {
            let gap = 3;
            let regions = ftc-measured-split(width, count, gap, ftc-measure(40, 80), ftc-measure(36, 80));
            let lw = ftc-region-width(head(regions));
            let rw = ftc-region-width(nth(regions, 1));
            let evidenceLines = fglui-evidence-lines(selected, open, allMetrics, allSamples, observations, epoch, width);
            let contentRows = fgd-max(0, sub(count, len(evidenceLines)));
            let left = fglui-left-budget(view, lw, epoch, metrics, samples, history, observations, contentRows);
            let right = fglui-right(view, rw, metrics);
            if le(count, 0) then list() else fgd-fill-lines(append(fgd-take(fgd-wide-lines-go(left, right, 0, fgd-max(len(left), len(right)), lw, gap, rw), contentRows), evidenceLines), count, width);
        }
        def fglui-body(width, count, epoch, view, filter, selected, open, metrics, samples, history, observations) {
            let viewedMetrics = fglui-view-metrics(fglui-filter-metrics(metrics, filter), view);
            let viewedSamples = fglui-view-samples(fglui-filter-samples(samples, filter), view);
            if str_eq(view, "atlas") then fglui-narrow(width, count, epoch, view, selected, open, viewedMetrics, viewedSamples, metrics, samples, history, observations) else if ge(width, 100) then fglui-wide(width, count, epoch, view, selected, open, viewedMetrics, viewedSamples, metrics, samples, history, observations) else fglui-narrow(width, count, epoch, view, selected, open, viewedMetrics, viewedSamples, metrics, samples, history, observations);
        }
        def fgd-live-segment-frame(width, height, epoch, hz, frame, view, focus, filter, selected, open, metrics, samples, publishers, control, history, observations, seam) {
            let w = fgd-clamp(width, 1, 1000);
            let h = fgd-clamp(height, 1, 300);
            let chosen = fglui-view(view);
            let header = fgd-title-segment-line(fgd-cat(list("FORM GLASS ", int_to_str(w), "x", int_to_str(h), " ", int_to_str(hz), "Hz view=", chosen, " focus=", focus, " filter=", filter)), w, "glass.header");
            let tabs = fgd-segment-line(if str_eq(chosen, "atlas") then "SCHEMA Q:req>T:token>L:layer>X:tensor>E:expert>M:Metal>F:frame>G:Glass" else "views atlas overview memory flow recipes | token segments retain exact IDs", w, fgd-neutral(176), "glass.tabs", list("all", "control"), "declared");
            let flow = fglui-pulse-line(epoch, hz, frame, history, metrics, w);
            let bodyRows = fgd-max(0, sub(h, 4));
            let body = fglui-body(w, bodyRows, epoch, chosen, filter, selected, open, metrics, samples, history, observations);
            let footer = fgd-segment-line(fgd-cat(list(seam, " | p=", int_to_str(len(publishers)), " control=", control, " selected=", selected)), w, fgd-neutral(176), "glass.footer", list("all", "membrane", "control"), "physical-live");
            let evidenceRows = len(fglui-evidence-lines(selected, open, metrics, samples, observations, epoch, w));
            let atlasRows = fgd-max(0, sub(bodyRows, evidenceRows));
            let omitted = if str_eq(chosen, "atlas") then fglat-omitted-count-for-rows(metrics, samples, observations, w, atlasRows) else 0;
            if le(h, 1) then list("form-glass-segment-frame-v2", w, h, list(header), ftc-overflow("hidden-count", omitted)) else list("form-glass-segment-frame-v2", w, h, fgd-fill-lines(append(list(header, tabs, flow), append(body, list(footer))), h, w), ftc-overflow("view-filtered", omitted));
        }
    }
    0;
}
