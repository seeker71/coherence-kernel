section [form.bml] {
    class FormGlassLayoutUI {
        field FGLLayoutShardSchema = "form-glass-layout-ui-v1";

        def fglui-help-row(text, width, id) = fgd-segment-line(text, width, fgd-neutral(220), id, list("help", "control"), "declared");
        def fglui-help-lines(width) = list(
            fgd-title-segment-line("HELP / DIRECT KEYS", width, "help.keys"),
            fglui-help-row("press a key; no Enter; arrows/Tab browse fields and samples", width, "help.start"),
            fglui-help-row("h help   a atlas   t raster   o overview", width, "help.views.1"),
            fglui-help-row("m memory f flow    j recipes  s transcripts  k kernel", width, "help.views.2"),
            fglui-help-row("v events n channels  d choice (points, play, asks)", width, "help.views.2b"),
            fglui-help-row(fglm-key-help(), width, "help.views.3"),
            fglui-help-row("i inspect e evidence c reset | g step y take w hold", width, "help.inspect"),
            fglui-help-row("r room; l languages (en+de); Enter submit/Esc cancel; q quit", width, "help.focus"),
            fglui-help-row("z ear awake/asleep (capture control)", width, "help.ear"));

        def fglui-glossary-row(text, width, id, plane) = fgd-segment-line(text, width, fgd-style-for-plane(plane, 220, 0), id, list("help", "glossary", plane), "declared");
        def fglui-glossary-lines(width) = list(
            fgd-title-segment-line("SYMBOL GLOSSARY", width, "help.glossary"),
            fglui-glossary-row("truth: * live  + derived  # catalog", width, "help.truth.1", "form"),
            fglui-glossary-row("       ~ declared  ? missing door", width, "help.truth.2", "form"),
            fglui-glossary-row("state: > active : prefill = ready", width, "help.state.1", "metal"),
            fglui-glossary-row("       o resident m mapped x released", width, "help.state.2", "metal"),
            fglui-glossary-row("KTVVV: kind truth compact value", width, "help.ktvvv", "unified"),
            fglui-glossary-row("zero: 0i idle  0e empty  0d drained  0q quiet", width, "help.zero", "cpu"),
            fglui-glossary-row("gap: -- absent  --- missing  ?=? no live value", width, "help.gap", "form"),
            fglui-glossary-row("move: ^ rose  v fell  = unchanged  . no pred", width, "help.move", "membrane"),
            fglui-glossary-row("PRESS free/used/warn@10/crit@5 rss cpu gov", width, "help.press", "unified"),
            fglui-glossary-row("Q request  T token  L layer  X tensor", width, "help.pipe.1", "membrane"),
            fglui-glossary-row("E expert M Metal F frame G Glass", width, "help.pipe.2", "metal"),
            fglui-glossary-row("gas -> water -> ice: live -> held -> cache", width, "help.phase", "disk"),
            fglui-glossary-row("alpha: bright=new; dim=older observation", width, "help.alpha", "cpu"),
            fglui-glossary-row("age is evidence time, never data age guess", width, "help.age", "form"));

        def fglui-queue-line(metrics, width) {
            let queue = fgd-find-metric(metrics, "queue-depth");
            let pending = if (len(queue) > 0) then queue else fgd-find-metric(metrics, "pending");
            let state = fgd-find-metric(metrics, "queue-state");
            if (len(pending) > 0) then fgd-metric-segment-line(pending, width) else if (len(state) > 0) then fgd-metric-segment-line(state, width) else fgd-segment-line("QUEUE UNAVAILABLE door=hearth.request-queue.publisher reason=no-publisher", width, fgd-neutral(96), "queue.unavailable", list("queue", "request", "health"), "unavailable");
        }
        def fglui-model-owner-sample?(sample) = if ((String) fgtm-sample-kind(sample) == "model") then 1 else if ((String) fgtm-sample-kind(sample) == "owner-liveness") then 1 else 0;
        def fglui-owner-liveness-epoch(sample) = if ((Comparable) fgtm-field-present?(fgtm-sample-read-epoch(sample)) == 1) then fgtm-field-value(fgtm-sample-read-epoch(sample)) else -1;
        def fglui-newest-owner-liveness(samples, held) = if ((Comparable) len(samples) == 0) then held else if (!((String) fgtm-sample-kind(head(samples)) == "owner-liveness")) then fglui-newest-owner-liveness(tail(samples), held) else if ((Comparable) len(held) == 0) then fglui-newest-owner-liveness(tail(samples), head(samples)) else if (fglui-owner-liveness-epoch(head(samples)) > fglui-owner-liveness-epoch(held)) then fglui-newest-owner-liveness(tail(samples), head(samples)) else fglui-newest-owner-liveness(tail(samples), held);
        def fglui-model-owner-samples(samples) {
            let models = fglui-kind-samples(samples, "model");
            let liveness = fglui-newest-owner-liveness(samples, list());
            if ((Comparable) len(liveness) == 0) then models else append(models, list(liveness));
        }
        // Four counts on one line.  A field whose row has not arrived used to
        // spend fifty-six columns on "UNAVAILABLE door=metric.publisher
        // reason=metric-not-published" -- a door name that names nobody, and
        // long enough to push the fields after it off the edge mid-word.  The
        // field names the frame that owes it instead, taken from that sensor's
        // own row rather than spelled again here, and stays four to twenty
        // columns wide so the whole line fits.  alloc reads the per-cell byte
        // ledger the memory domain already stands.
        def fglui-organ-absent(door) = str_concat("?(", str_concat(door, ")"));
        def fglui-organ-door(metrics, sensor, id) {
            let row = fgd-find-metric(metrics, str_concat("sensor-", sensor));
            if ((Comparable) len(row) == 0) then str_concat("gift:", fgsr-publisher(sensor)) else fgo-source(row);
        }
        def fglui-organ-field(metrics, id, sensor) {
            let row = fgd-find-metric(metrics, id);
            if ((Comparable) len(row) == 0) then fglui-organ-absent(fglui-organ-door(metrics, sensor, id)) else if ((Comparable) fgo-present?(row) == 0) then fglui-organ-absent(fgo-source(row)) else fgd-metric-value(row);
        }
        def fglui-organ-line(metrics, width) = fgd-segment-line(fgd-cat(list("F node=", fglui-organ-field(metrics, "cells", "glass"), " bp=", fglui-organ-field(metrics, "blueprint-source-count", "storage"), " rc=", fglui-organ-field(metrics, "recipe-source-count", "storage"), " alloc=", fglui-organ-field(metrics, "cell-bytes", "glass"))), width, fgd-style-for-plane("form", 220, 0), "form.states", list("cell", "blueprint", "recipe"), "catalog");
        def fglui-field-number-text(field) = if ((Comparable) fgtm-field-present?(field) == 1) then fgd-format-count(fgtm-field-value(field)) else "absent";
        def fglui-field-bytes-text(field) = if ((Comparable) fgtm-field-present?(field) == 1) then fgd-format-bytes(fgtm-field-value(field)) else "absent";
        def fglui-sample-artifact-text(sample) = if ((Comparable) fgd-logical-artifact-byte-sample?(sample) == 1) then str_concat(fglui-field-bytes-text(fgtm-sample-bytes(sample)), "(logical-catalog)") else "absent";
        def fglui-sample-mapped-text(sample) = if (((String) fgtm-sample-plane(sample) == "mapped-file") && (((String) fgtm-sample-evidence(sample) == "physical-live") && ((Comparable) fgtm-field-present?(fgtm-sample-bytes(sample)) == 1))) then fglui-field-bytes-text(fgtm-sample-bytes(sample)) else "unavailable(model.carrier-per-model-mapped-bytes)";
        def fglui-sample-materialized-text(sample) = if (((Comparable) fgd-material-plane?(fgtm-sample-plane(sample)) == 1) && (((String) fgtm-sample-evidence(sample) == "physical-live") && ((Comparable) fgtm-field-present?(fgtm-sample-bytes(sample)) == 1))) then fglui-field-bytes-text(fgtm-sample-bytes(sample)) else "unavailable(model.materialized-resident-bytes)";
        def fglui-sample-callable-text(sample) = if (!((String) fgtm-sample-kind(sample) == "model")) then "not-applicable" else if ((Comparable) fgtm-field-present?(fgtm-sample-handle(sample)) == 1) then str_concat("unproven(handle=", str_concat(int_to_str(fgtm-field-value(fgtm-sample-handle(sample))), ";door=model.route-readiness)")) else "unavailable(model.route-readiness)";
        def fglui-evidence-line(text, width, style, id, channels, evidence) = fgd-segment-line(text, width, style, id, channels, evidence);
        def fglui-sample-evidence-lines(selected, sample, epoch, width) {
            let style = fgd-sample-style(sample, epoch);
            let channels = fgtm-sample-channels(sample);
            let evidence = fgtm-sample-evidence(sample);
            list(fglui-evidence-line(fgd-cat(list("E ", selected, " ", fgtm-sample-kind(sample), "/", fgtm-sample-lifecycle(sample), " ", fgtm-sample-plane(sample), " ", evidence, " age:", fgd-sample-age-text(sample, epoch))), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("field=", fgd-sample-projection-id(sample), " source-node=? telemetry.nodeid-owner-binding")), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("owner=", fgtm-sample-owner(sample), " src=", fgtm-sample-source(sample), " lane=", fgtm-sample-lane(sample), " impact=", fgtm-sample-purpose(sample))), width, style, selected, channels, evidence));
        }
        def fglui-metric-evidence-lines(selected, metric, width) {
            let style = fgd-style-for-metric(metric);
            let id = str_concat("metric.", selected);
            let channels = list(fgo-channel(metric));
            let evidence = fgo-evidence(metric);
            list(fglui-evidence-line(fgd-cat(list("E ", id, "=", fgd-metric-value(metric), " ", fgo-unit(metric), " ", fgo-lifecycle(metric), "/", evidence, " age=", fgd-format-age-ms(fgo-age(metric)))), width, style, id, channels, evidence),
                fglui-evidence-line(fgd-cat(list("field=", if ((Comparable) fgo-nodeid-bound?(metric) == 1) then fgo-nodeid-value(metric) else "?", " event=", int_to_str(fgo-observation-sequence(metric)), "@", int_to_str(fgo-observed-epoch(metric)), " source-node=", if ((Comparable) fgo-source-nodeid-bound?(metric) == 1) then fgo-source-nodeid-value(metric) else "?")), width, style, id, channels, evidence),
                fglui-evidence-line(fgd-cat(list("src=", fgo-source(metric), " plane=", fgo-plane(metric), " impact=", fgo-note(metric))), width, style, id, channels, evidence));
        }
        def fglui-observation-evidence-lines(selected, observation, epoch, width) {
            let provenance = fgov2-observation-provenance(observation);
            let evidence = fgov2-provenance-evidence(provenance);
            let style = fgd-style-for-plane(fgov2-observation-plane(observation), 220, 0);
            let channels = list("evidence", fgov2-observation-kind(observation), fgov2-observation-plane(observation));
            list(fglui-evidence-line(fgd-cat(list("E ", selected, "=", fglui-truth-text(fgov2-observation-measurement(observation), fgov2-observation-unit(observation), epoch), " ", fgov2-observation-unit(observation), " ", fgov2-observation-kind(observation), "/", evidence, " age=", fglui-observation-age(observation, epoch))), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("field=", fglat-observation-projection-id(observation), " source-node=? telemetry.nodeid-owner-binding")), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(list("publisher=", fgov2-provenance-publisher(provenance), " src=", fgov2-provenance-source(provenance), " plane=", fgov2-observation-plane(observation), " impact=", fgov2-observation-subtype(observation))), width, style, selected, channels, evidence));
        }
        def fglui-metric-selector-id(selected) = if ((str_len(selected) >= 8) && ((String) substring(selected, 0, 7) == "metric.")) then substring(selected, 7, str_len(selected)) else selected;
        def fglui-find-qualified-metric(rows, selected) = if ((Comparable) len(rows) == 0) then list() else if ((String) fgd-metric-selector(head(rows)) == selected) then head(rows) else fglui-find-qualified-metric(tail(rows), selected);
        def fglui-selection-active?(selected) = (!(((String) selected == "none") || ((String) selected == "all")));
        def fglui-find-selected-metric(rows, selected) = if ((Comparable) fglui-selection-active?(selected) == 0) then list() else fglui-find-selected-metric-active(rows, selected);
        def fglui-find-selected-metric-active(rows, selected) {
            let exact = fglui-find-qualified-metric(rows, selected);
            if (len(exact) > 0) then exact else fgd-find-metric(rows, fglui-metric-selector-id(selected));
        }
        def fglui-selection-projections(selected, metrics, samples, observations) = if ((Comparable) fglui-selection-active?(selected) == 0) then list() else fglui-selection-projections-active(selected, metrics, samples, observations);
        def fglui-selection-projections-active(selected, metrics, samples, observations) {
            let metric = fglui-find-selected-metric(metrics, selected);
            let sample = fglui-find-sample(samples, selected);
            let observation = fglui-find-observation(observations, selected);
            append(list(str_concat("selector.", selected)), append(if ((Comparable) len(metric) == 0) then list() else list(str_concat("selector.", fgd-metric-selector(metric))), append(if ((Comparable) len(sample) == 0) then list() else list(str_concat("selector.", fgtm-sample-selection-id(sample))), if ((Comparable) len(observation) == 0) then list() else list(str_concat("selector.observation.", fgov2-observation-id(observation))))));
        }
        // The selected tile, said in words.
        //
        // Urs, 2026-09-10: the m/s/o lines "could be selectable and the
        // highlighted translated to human understandable line". Selection
        // already stood -- these three finders, keyed, not indexed, so a tile
        // keeps its identity when the list reorders. What was missing is that a
        // five-column tile like `k*80M` cannot say what it means, and every
        // fact a sentence needs was already on the row it was folded from.
        //
        // Keyed and not indexed matters: an index would name a different tile
        // every time a metric arrives or goes silent, and the sentence would
        // describe something other than what is lit.
        def fglui-selected-row(selected, metrics, samples, observations) {
            let metric = fglui-find-selected-metric(metrics, selected);
            let sample = fglui-find-sample(samples, selected);
            if (len(metric) > 0) then metric else if (len(sample) > 0) then sample else fglui-find-observation(observations, selected);
        }
        def fglui-said-line(selected, metrics, samples, observations, width) = if ((Comparable) fglui-selection-active?(selected) == 0) then list() else list(fgd-segment-line(fgd-pad-right(str_concat("> ", fglat-say-tile(fglui-selected-row(selected, metrics, samples, observations))), width), width, fgd-ready(), "atlas.said", list("atlas", "said"), "physical-live"));
        def fglui-evidence-lines(selected, open, metrics, samples, observations, epoch, width) {
            let sample = fglui-find-sample(samples, selected);
            let metric = fglui-find-selected-metric(metrics, selected);
            let observation = fglui-find-observation(observations, selected);
            if ((Comparable) open == 0) then list(fgd-segment-line(fgd-cat(list("selection=", selected, " evidence=closed; offer request-evidence ", selected)), width, fgd-neutral(128), "evidence.closed", list("evidence", "membrane"), "declared")) else if (len(sample) > 0) then fglui-sample-evidence-lines(selected, sample, epoch, width) else if (len(metric) > 0) then fglui-metric-evidence-lines(fglui-metric-selector-id(selected), metric, width) else if (len(observation) > 0) then fglui-observation-evidence-lines(selected, observation, epoch, width) else list(fgd-segment-line(fgd-cat(list("EVID UNAVAILABLE door=glass.selection.publisher reason=selection-not-published id=", selected)), width, fgd-health(), "evidence.unavailable", list("evidence", "health"), "unavailable"));
        }
        def fglui-evidence(selected, open, metrics, samples, observations, epoch, width) = head(fglui-evidence-lines(selected, open, metrics, samples, observations, epoch, width));
        def fglui-metric-key(metric) = fgd-cat(list(fgo-domain(metric), ".", fgo-id(metric)));
        def fglui-metric-key-held?(rows, key) = if ((Comparable) len(rows) == 0) then 0 else if ((String) fglui-metric-key(head(rows)) == key) then 1 else fglui-metric-key-held?(tail(rows), key);
        // Each row's key is built once and held beside the row; the walk conses
        // and reverses instead of appending, so a frame of n rows costs n keys,
        // not n squared (first occurrence wins, order kept).
        def fglui-key-held?(keys, key) = if ((Comparable) len(keys) == 0) then 0 else if ((String) head(keys) == key) then 1 else fglui-key-held?(tail(keys), key);
        def fglui-unique-metrics-step(rows, heldKeys, acc, key) = if ((Comparable) fglui-key-held?(heldKeys, key) == 1) then fglui-unique-metrics-go(tail(rows), heldKeys, acc) else fglui-unique-metrics-go(tail(rows), cons(key, heldKeys), cons(head(rows), acc));
        def fglui-unique-metrics-go(rows, heldKeys, acc) = if ((Comparable) len(rows) == 0) then reverse(acc) else fglui-unique-metrics-step(rows, heldKeys, acc, fglui-metric-key(head(rows)));
        def fglui-unique-metrics(rows) = fglui-unique-metrics-go(rows, list(), list());
        def fglui-missing-metrics(rows) = if ((Comparable) len(rows) == 0) then list() else if ((Comparable) fgo-present?(head(rows)) == 0) then cons(head(rows), fglui-missing-metrics(tail(rows))) else fglui-missing-metrics(tail(rows));
        def fglui-memory-priority(metrics) = fglui-unique-metrics(append(fglui-existing-metrics(list(fgd-find-metric(metrics, "memory-total"), fgd-find-metric(metrics, "memory-free"), fgd-find-metric(metrics, "model-owner-rss"), fgd-find-metric(metrics, "vm-free-bytes"), fgd-find-metric(metrics, "vm-active-bytes"), fgd-find-metric(metrics, "vm-wired-bytes"), fgd-find-metric(metrics, "vm-compressor-bytes"))), metrics));
        def fglui-memory-gap-line(metrics, samples, observations, epoch, width) {
            let typed = len(fglui-seam-observations(fglui-view-observations(observations, "memory")));
            let gauges = len(fglui-missing-metrics(fglui-unique-metrics(metrics)));
            let regions = len(fgd-map-unknown(fgd-map-sample-items(samples, samples, epoch, "all")));
            fgd-segment-line(fgd-cat(list("Memory gaps: observations=", int_to_str(typed), " gauges=", int_to_str(gauges), " regions=", int_to_str(regions))), width, if ((Comparable) (typed + (gauges + regions)) == 0) then fgd-ready() else fgd-health(), "memory.gaps", list("memory", "health"), "physical-live");
        }
        def fglui-memory-door-lines(rows, width) = if ((Comparable) len(rows) == 0) then list() else cons(fgd-segment-line(fgd-cat(list("? ", fgov2-observation-id(head(rows)), " -> ", fgov2-truth-door(fgov2-observation-measurement(head(rows))))), width, fgd-health(), fgov2-observation-id(head(rows)), list("memory", "evidence"), "unavailable"), fglui-memory-door-lines(tail(rows), width));
        def fglui-memory-fit(lines, width, budget) = if (budget <= 0) then list() else if (len(lines) <= budget) then lines else append(fgd-take(lines, (budget - 1)), list(fgd-segment-line(fgd-cat(list("+ ", int_to_str(((len(lines) - budget) + 1)), " memory rows below this viewport; select a field with i, e for evidence")), width, fgd-neutral(176), "memory.overflow", list("memory", "evidence"), "declared")));
        def fglui-memory-lines(width, epoch, metrics, samples, observations, budget) {
            let unique = fglui-unique-metrics(metrics);
            let rows = fglui-view-observations(observations, "memory");
            let header = list(fgd-title-segment-line("MEMORY cells blueprints recipes tensors arenas", width, "section.memory"), fglui-memory-gap-line(unique, samples, observations, epoch, width), fgd-segment-line("Column bytes = logical fill, not RSS. Blueprint bytes are a cell subset.", width, fgd-neutral(176), "memory.scope", list("memory", "evidence"), "declared"));
            let details = append(fglui-memory-door-lines(fglui-seam-observations(rows), width), append(fglui-observation-lines(fglui-available-observations(rows), epoch, width), fgd-map-lines(unique, samples, epoch, "all", width, 12)));
            fglui-memory-fit(append(header, details), width, budget);
        }
        def fglui-memory-right(metrics, width) = cons(fgd-title-segment-line("HOST / PROCESS RAM / CACHE (separate scopes)", width, "section.right"), fgd-metric-segment-lines(fglui-memory-priority(fglui-unique-metrics(metrics)), width));
        def fglui-seam-line(metrics, width) {
            let seams = fglui-missing-metrics(fglui-unique-metrics(metrics));
            if ((Comparable) len(seams) == 0) then fgd-segment-line("metric gaps=0 (this view)", width, fgd-ready(), "organs.seams", list("health", "evidence"), "physical-live") else fgd-segment-line(fgd-cat(list("? seams=", int_to_str(len(seams)), " doors:", fglat-seam-door-text(fglat-seam-doors(seams), fglat-seam-room(width)))), width, fgd-health(), "organs.seams", list("health", "evidence"), "unavailable");
        }
        // the map and the typed observation lines are built only by the views that draw them (the atlas and the raster never do)
        def fglui-left-budget(view, width, epoch, metrics, samples, history, observations, rowBudget) = if ((String) view == "memory") then fglui-memory-lines(width, epoch, metrics, samples, observations, rowBudget) else if ((String) view == "help") then fglui-help-lines(width) else if ((String) view == "atlas") then fglat-lines-budget(metrics, samples, observations, history, epoch, width, rowBudget) else if ((String) view == "raster") then fglat-raster-lines(history, width, rowBudget) else fglui-left-typed(view, width, epoch, metrics, samples, history, observations);
        def fglui-left-typed(view, width, epoch, metrics, samples, history, observations) {
            let maps = fgd-map-lines(metrics, samples, epoch, "all", width, if ((String) view == "memory") then 12 else 5);
            let typed = fglui-observation-lines(fglui-prioritized-observations(fglui-view-observations(observations, view)), epoch, width);
            if ((String) view == "flow") then cons(fgd-title-segment-line("TOKEN FLOW >LAYER>TENSOR>EXPERT>METAL>FRAME>GLASS", width, "section.flow"), append(fglui-token-flow-lines(samples, epoch, width), append(fgd-metric-segment-lines(fglui-flow-attention-metrics(metrics), width), append(fglui-flow-lines(history, width), typed)))) else if ((String) view == "recipes") then cons(fgd-title-segment-line("RECIPES / JIT STATES", width, "section.recipes"), append(list(fglui-organ-line(metrics, width), fgd-title-segment-line("JIT live: boxes minted, boxes read, native leaf calls, loops crystallized and unrolled by two; hot defns wear both ledgers", width, "section.jit")), append(typed, fgd-sample-segment-lines(fgd-take(samples, 6), width, epoch)))) else if ((String) view == "memory") then cons(fgd-title-segment-line("MEMORY cells blueprints recipes tensors arenas", width, "section.memory"), append(typed, maps)) else append(list(fgd-title-segment-line("REQUEST / MODELS + OWNER LIVENESS", width, "section.models"), fglui-queue-line(metrics, width)), append(fgd-sample-segment-lines(fgd-take(fglui-model-owner-samples(samples), 5), width, epoch), append(list(fgd-title-segment-line("MEMORY", width, "section.memory"), fgd-memory-bar-segment(samples, width)), append(fgd-take(typed, 3), maps))));
        }
        def fglui-left(view, width, epoch, metrics, samples, history, observations) = fglui-left-budget(view, width, epoch, metrics, samples, history, observations, 999);
        def fglui-right(view, width, metrics) {
            let unique = fglui-unique-metrics(fglui-view-metrics(metrics, view));
            if ((String) view == "memory") then fglui-memory-right(unique, width) else if ((String) view == "help") then fglui-glossary-lines(width) else cons(fgd-title-segment-line(if ((String) view == "recipes") then "JIT / HEAT" else if ((String) view == "flow") then "REQUEST / DELTAS" else if ((String) view == "memory") then "ALLOC / CACHE" else "ORGANS / HEALTH", width, "section.right"), append(list(fglui-seam-line(unique, width)), append(if ((String) view == "overview") then list(fglui-organ-line(unique, width)) else list(), fgd-metric-segment-lines(unique, width))));
        }
        // Summary panels may aggregate a field instead of spelling its row.
        // Navigation still owes that exact row a visible place.
        def fglui-selected-field-lines(selected, metrics, samples, observations, epoch, width) {
            let metric = fglui-find-selected-metric(metrics, selected);
            let sample = fglui-find-sample(samples, selected);
            let observation = fglui-find-observation(observations, selected);
            if (len(metric) > 0) then list(fgd-metric-segment-line(metric, width)) else if (len(sample) > 0) then fglui-sample-lines(list(sample), width, epoch) else if (len(observation) > 0) then list(fglui-observation-line(observation, epoch, width)) else list();
        }
        def fglui-ensure-selected(lines, selected, metrics, samples, observations, epoch, width) {
            let keys = fglui-selection-projections(selected, metrics, samples, observations);
            if (((String) selected == "none") || ((String) selected == "all")) then lines else if (fgvp-index(lines, keys, 0) >= 0) then lines else append(lines, fglui-selected-field-lines(selected, metrics, samples, observations, epoch, width));
        }
        def fglui-narrow(width, count, epoch, view, selected, open, metrics, samples, allMetrics, allSamples, history, observations) = fglui-narrow-in(width, count, epoch, view, selected, open, metrics, samples, allMetrics, allSamples, history, observations, list());
        def fglui-narrow-in(width, count, epoch, view, selected, open, metrics, samples, allMetrics, allSamples, history, observations, index) {
            let evidenceLines = fglui-evidence-lines(selected, open, allMetrics, allSamples, observations, epoch, width);
            let contentRows = fgd-max(0, (count - len(evidenceLines)));
            let selectedKeys = fglui-selection-projections(selected, allMetrics, allSamples, observations);
            let compactAtlas = (((String) view == "atlas") && (((String) selected == "all") || ((String) selected == "none")));
            let rowBudget = if ((Comparable) compactAtlas == 1) then contentRows else 999;
            // the atlas is where the five-column tiles live, so the sentence
            // belongs there and nowhere else: other views already render their
            // rows in words and a line added to them only moves their layout
            let saidLine = if ((String) view == "atlas") then fglui-said-line(selected, metrics, samples, fglui-view-observations(observations, view), width) else list();
            let left = if (((String) view == "atlas") && ((Comparable) len(index) == 3)) then fglat-lines-budget-in(metrics, samples, observations, history, epoch, width, rowBudget, index) else fglui-left-budget(view, width, epoch, metrics, samples, history, observations, rowBudget);
            let right = if (((String) view == "atlas") || (((String) view == "raster") || ((String) view == "flow"))) then list() else fglui-right(view, width, metrics);
            let withSaid = append(saidLine, left);
            let content = if ((String) view == "memory") then append(fgd-take(left, 3), append(fgd-take(right, 5), append(fgd-drop(left, 3), fgd-drop(right, 5)))) else append(withSaid, right);
            let visible = fgvp-window(fglui-ensure-selected(content, selected, metrics, samples, fglui-view-observations(observations, view), epoch, width), selectedKeys, width, contentRows);
            if (count <= 0) then list() else fgd-take(append(fgd-fill-lines(visible, contentRows, width), evidenceLines), count);
        }
        def fglui-wide(width, count, epoch, view, selected, open, metrics, samples, allMetrics, allSamples, history, observations) {
            let gap = 3;
            let regions = ftc-measured-split(width, count, gap, ftc-measure(40, 80), ftc-measure(36, 80));
            let lw = ftc-region-width(head(regions));
            let rw = ftc-region-width(nth(regions, 1));
            let evidenceLines = fglui-evidence-lines(selected, open, allMetrics, allSamples, observations, epoch, width);
            let contentRows = fgd-max(0, (count - len(evidenceLines)));
            let selectedKeys = fglui-selection-projections(selected, allMetrics, allSamples, observations);
            let leftRows = fglui-left-budget(view, lw, epoch, metrics, samples, history, observations, 999);
            let rightRows = fglui-right(view, rw, metrics);
            let selectedRows = if (((String) selected == "none") || ((String) selected == "all")) then list() else if (fgvp-index(append(leftRows, rightRows), selectedKeys, 0) >= 0) then list() else fglui-selected-field-lines(selected, metrics, samples, fglui-view-observations(observations, view), epoch, rw);
            let left = fgvp-window(leftRows, selectedKeys, lw, contentRows);
            let right = fgvp-window(append(rightRows, selectedRows), selectedKeys, rw, contentRows);
            if (count <= 0) then list() else fgd-take(append(fgd-wide-lines-go(left, right, 0, contentRows, lw, gap, rw), evidenceLines), count);
        }
        def fglui-special-body(width, count, epoch, view, filter, selected, open, metrics, samples, observations) {
            let filteredSamples = fglui-filter-samples(samples, filter);
            let filteredMetrics = fglui-unique-metrics(fglui-view-metrics(fglui-filter-metrics(metrics, filter), view));
            let evidence = if ((Comparable) open == 1) then fglui-evidence-lines(selected, open, metrics, samples, observations, epoch, width) else list();
            let room = fgd-max(0, (count - len(evidence)));
            let lines = if ((String) view == "meaning") then fglm-lines-fit(metrics, filter, epoch, width, room) else if ((String) view == "events") then fglui-events-lines(filteredSamples, epoch, width, len(filteredSamples)) else if ((String) view == "channels") then fglui-channels-lines(filteredSamples, epoch, width, len(filteredSamples)) else if ((String) view == "choice") then fgch-view-lines(filteredSamples, selected, width, 999) else cons(fgd-title-segment-line("KERNEL live: frames read (shm name#seq), machine, fns, hottest defns", width, "section.kernel"), if ((Comparable) len(filteredMetrics) == 0) then list(fglui-absent-line("No kernel measurements in this view; c clears the filter. Door: gift:glass.sensor.glass", width, "kernel.absent")) else fgd-metric-segment-lines(filteredMetrics, width));
            let visible = fgvp-window(lines, fglui-selection-projections(selected, metrics, samples, observations), width, room);
            fgd-take(append(fgd-fill-lines(visible, room, width), evidence), count);
        }
        def fglui-body(width, count, epoch, view, filter, selected, open, metrics, samples, history, observations) {
            let viewedMetrics = fglui-view-metrics(fglui-filter-metrics(metrics, filter), view);
            let viewedSamples = fglui-view-samples(fglui-filter-samples(samples, filter), view);
            if fgd-kind-in?(view, list("meaning", "choice", "events", "channels", "kernel")) then fglui-special-body(width, count, epoch, view, filter, selected, open, metrics, samples, observations) else if (((String) view == "atlas") || (((String) view == "raster") || ((String) view == "flow"))) then fglui-narrow(width, count, epoch, view, selected, open, viewedMetrics, viewedSamples, metrics, samples, history, observations) else if ((width >= 100) || (((String) view == "help") && (width >= 76))) then fglui-wide(width, count, epoch, view, selected, open, viewedMetrics, viewedSamples, metrics, samples, history, observations) else fglui-narrow(width, count, epoch, view, selected, open, viewedMetrics, viewedSamples, metrics, samples, history, observations);
        }
        def fgd-live-segment-frame(width, height, epoch, hz, frame, view, focus, filter, selected, open, metrics, samples, publishers, control, history, observations, seam) = fgd-live-segment-frame-in(width, height, epoch, hz, frame, view, focus, filter, selected, open, metrics, samples, publishers, control, history, observations, seam, list());
        def fgd-live-segment-frame-in(width, height, epoch, hz, frame, view, focus, filter, selected, open, metrics, samples, publishers, control, history, observations, seam, index) {
            let w = fgd-clamp(width, 1, 1000);
            let h = fgd-clamp(height, 1, 300);
            let chosen = fglui-view(view);
            let header = fgd-segment-line(fgd-cat(list("FORM GLASS ", int_to_str(w), "x", int_to_str(h), " ", int_to_str(hz), "Hz view=", chosen, " focus=", focus, " filter=", filter)), w, fgd-title(), "glass.header", list("all"), "declared");
            let tabs = fgd-segment-line(if ((String) chosen == "help") then "HELP h a t o m f j s k v n d 1-4 0 i e c q | g y w play | Enter commits" else "h help a atlas t raster o over m mem f flow j jit d choice | i e c q g y w | *+#?", w, fgd-neutral(176), "glass.tabs", list("all", "control"), "declared");
            let flow = fglui-pulse-line(epoch, hz, frame, history, metrics, w);
            let bodyRows = fgd-max(0, (h - 4));
            // Only the unfiltered atlas can share the full frame's index.
            // Filtered views build their own index, so hidden values stay hidden.
            let content = if ((((String) chosen == "atlas") && ((String) filter == "all")) && ((Comparable) len(index) == 3)) then fglui-narrow-in(w, bodyRows, epoch, chosen, selected, open, metrics, samples, metrics, samples, history, observations, index) else fglui-body(w, bodyRows, epoch, chosen, filter, selected, open, metrics, samples, history, observations);
            let body = fgd-fill-lines(content, bodyRows, w);
            let footer = fgd-segment-line(fgd-cat(list(seam, " | p=", int_to_str(len(publishers)), " control=", control, " selected=", selected)), w, fgd-neutral(176), "glass.footer", list("all", "membrane", "control"), "physical-live");
            let evidenceRows = len(fglui-evidence-lines(selected, open, metrics, samples, observations, epoch, w));
            let atlasRows = fgd-max(0, (bodyRows - evidenceRows));
            let omitted = if ((String) chosen == "atlas") then fglat-omitted-count-for-rows(metrics, samples, observations, w, atlasRows) else 0;
            let chrome = fgd-take(list(header, tabs, flow), fgd-min(3, (h - 1)));
            if (h <= 1) then list("form-glass-segment-frame-v2", w, h, list(header), ftc-overflow("hidden-count", omitted)) else list("form-glass-segment-frame-v2", w, h, fgd-clip-lines(append(chrome, append(body, list(footer))), w), ftc-overflow("view-filtered", omitted));
        }
    }
    0;
}
