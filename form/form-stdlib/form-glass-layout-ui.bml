//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassLayoutUI {
        field FGLLayoutShardSchema = "form-glass-layout-ui-v1";

        def fglui-help-row(text, width, id) = fgd-segment-line(text, width, fgd-neutral(220), id, ["help", "control"], "declared");
        def fglui-help-lines(width) = [
            fgd-title-segment-line("HELP / DIRECT KEYS", width, "help.keys"),
            fglui-help-row("press a key; no Enter; arrows/Tab browse fields and samples", width, "help.start"),
            fglui-help-row("o our work (plain words)   a atlas   t raster   h help", width, "help.views.1"),
            fglui-help-row("m memory f flow    j recipes  s transcripts  k kernel", width, "help.views.2"),
            fglui-help-row("v events n channels  d choice (points, play, asks)", width, "help.views.2b"),
            fglui-help-row(fglm-key-help(), width, "help.views.3"),
            fglui-help-row("i inspect e evidence c reset | g step y take w hold", width, "help.inspect"),
            fglui-help-row("r room; l languages (en+de); Enter submit/Esc cancel; q quit", width, "help.focus"),
            fglui-help-row("z ear awake/asleep (capture control)", width, "help.ear")];

        def fglui-glossary-row(text, width, id, plane) = fgd-segment-line(text, width, fgd-style-for-plane(plane, 220, 0), id, ["help", "glossary", plane], "declared");
        def fglui-glossary-lines(width) = [
            fgd-title-segment-line("SYMBOL GLOSSARY", width, "help.glossary"),
            fglui-glossary-row("truth: * live  + derived  # catalog", width, "help.truth.1", "form"),
            fglui-glossary-row("       ~ declared  ? missing door", width, "help.truth.2", "form"),
            fglui-glossary-row("state: > active : prefill = ready", width, "help.state.1", "metal"),
            fglui-glossary-row("       o resident m mapped x released", width, "help.state.2", "metal"),
            fglui-glossary-row("KTVVV: kind truth compact value", width, "help.ktvvv", "unified"),
            fglui-glossary-row("zero: 0i idle  0e empty  0d drained  0q quiet", width, "help.zero", "cpu"),
            fglui-glossary-row("gap: -- absent  --- missing  ?=? no live value", width, "help.gap", "form"),
            fglui-glossary-row("move: ^ rose  v fell  = unchanged  . no pred", width, "help.move", "membrane"),
            fglui-glossary-row("PRESS free/used/warn@10/crit@5 rss cpu gov", width, "help.press", "unified"),
            fglui-glossary-row("Q request  T token  L layer  X tensor", width, "help.pipe.1", "membrane"),
            fglui-glossary-row("E expert M Metal F frame G Glass", width, "help.pipe.2", "metal"),
            fglui-glossary-row("gas -> water -> ice: live -> held -> cache", width, "help.phase", "disk"),
            fglui-glossary-row("alpha: bright=new; dim=older observation", width, "help.alpha", "cpu"),
            fglui-glossary-row("age is evidence time, never data age guess", width, "help.age", "form")];

        // Four counts on one line.  A field whose row has not arrived used to
        // spend fifty-six columns on "UNAVAILABLE door=metric.publisher
        // reason=metric-not-published" -- a door name that names nobody, and
        // long enough to push the fields after it off the edge mid-word.  The
        // field names the frame that owes it instead, taken from that sensor's
        // own row rather than spelled again here, and stays four to twenty
        // columns wide so the whole line fits.  alloc reads the per-cell byte
        // ledger the memory domain already stands.
        def fglui-organ-absent(door) = ("?(" + (door + ")"));
        def fglui-organ-door(metrics, sensor, id) {
            let row = fgd-find-metric(metrics, ("sensor-" + sensor));
            if ((Comparable) len(row) == 0) then ("gift:" + fgsr-publisher(sensor)) else fgo-source(row);
        }
        def fglui-organ-field(metrics, id, sensor) {
            let row = fgd-find-metric(metrics, id);
            if ((Comparable) len(row) == 0) then fglui-organ-absent(fglui-organ-door(metrics, sensor, id)) else if ((Comparable) fgo-present?(row) == 0) then fglui-organ-absent(fgo-source(row)) else fgd-metric-value(row);
        }
        def fglui-organ-line(metrics, width) = fgd-segment-line(fgd-cat(["F node=", fglui-organ-field(metrics, "cells", "glass"), " bp=", fglui-organ-field(metrics, "blueprint-source-count", "storage"), " rc=", fglui-organ-field(metrics, "recipe-source-count", "storage"), " alloc=", fglui-organ-field(metrics, "cell-bytes", "glass")]), width, fgd-style-for-plane("form", 220, 0), "form.states", ["cell", "blueprint", "recipe"], "catalog");
        def fglui-field-number-text(field) = if ((Comparable) fgtm-field-present?(field) == 1) then fgd-format-count(fgtm-field-value(field)) else "absent";
        def fglui-field-bytes-text(field) = if ((Comparable) fgtm-field-present?(field) == 1) then fgd-format-bytes(fgtm-field-value(field)) else "absent";
        def fglui-sample-artifact-text(sample) = if ((Comparable) fgd-logical-artifact-byte-sample?(sample) == 1) then (fglui-field-bytes-text(fgtm-sample-bytes(sample)) + "(logical-catalog)") else "absent";
        def fglui-sample-mapped-text(sample) = if (((String) fgtm-sample-plane(sample) == "mapped-file") && (((String) fgtm-sample-evidence(sample) == "physical-live") && ((Comparable) fgtm-field-present?(fgtm-sample-bytes(sample)) == 1))) then fglui-field-bytes-text(fgtm-sample-bytes(sample)) else "unavailable(model.carrier-per-model-mapped-bytes)";
        def fglui-sample-materialized-text(sample) = if (((Comparable) fgd-material-plane?(fgtm-sample-plane(sample)) == 1) && (((String) fgtm-sample-evidence(sample) == "physical-live") && ((Comparable) fgtm-field-present?(fgtm-sample-bytes(sample)) == 1))) then fglui-field-bytes-text(fgtm-sample-bytes(sample)) else "unavailable(model.materialized-resident-bytes)";
        def fglui-sample-callable-text(sample) = if (!((String) fgtm-sample-kind(sample) == "model")) then "not-applicable" else if ((Comparable) fgtm-field-present?(fgtm-sample-handle(sample)) == 1) then ("unproven(handle=" + (fgtm-field-value(fgtm-sample-handle(sample)).str() + ";door=model.route-readiness)")) else "unavailable(model.route-readiness)";
        def fglui-evidence-line(text, width, style, id, channels, evidence) = fgd-segment-line(text, width, style, id, channels, evidence);
        def fglui-care-evidence-lines(selected,sample,width,style,channels,evidence) {
            let cell = fgtm-sample-cell(sample);
            (String) fgtm-sample-lane(sample) != "care" || !fgsr-care-cell?(cell) ? [] : {
                let public = cell[1];
                [fglui-evidence-line("signal=" + jv-str(public,"id") + " care_of=" + jv-str(public,"care_of"),width,style,selected,channels,evidence),fglui-evidence-line("responder=" + jv-str(public,"responder") + " selected=" + jv-str(public,"selected") + " source-state=" + cell[2],width,style,selected,channels,evidence),fglui-evidence-line("evidence-source=" + cell[3],width,style,selected,channels,evidence)];
            };
        }
        def fglui-sample-evidence-lines(selected, sample, epoch, width) {
            let style = fgd-sample-style(sample, epoch);
            let channels = fgtm-sample-channels(sample);
            let evidence = fgtm-sample-evidence(sample);
            append([fglui-evidence-line(fgd-cat(["E ", selected, " ", fgtm-sample-kind(sample), "/", fgtm-sample-lifecycle(sample), " ", fgtm-sample-plane(sample), " ", evidence, " age:", fgd-sample-age-text(sample, epoch)]), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(["field=", fgd-sample-projection-id(sample), " source-node=? telemetry.nodeid-owner-binding"]), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(["owner=", fgtm-sample-owner(sample), " src=", fgtm-sample-source(sample), " lane=", fgtm-sample-lane(sample), " impact=", fgtm-sample-purpose(sample)]), width, style, selected, channels, evidence)],fglui-care-evidence-lines(selected,sample,width,style,channels,evidence));
        }
        def fglui-metric-evidence-lines(selected, metric, width) {
            let style = fgd-style-for-metric(metric);
            let id = ("metric." + selected);
            let channels = [fgo-channel(metric)];
            let evidence = fgo-evidence(metric);
            [fglui-evidence-line(fgd-cat(["E ", id, "=", fgd-metric-value(metric), " ", fgo-unit(metric), " ", fgo-lifecycle(metric), "/", evidence, " age=", fgd-format-age-ms(fgo-age(metric))]), width, style, id, channels, evidence),
                fglui-evidence-line(fgd-cat(["field=", if ((Comparable) fgo-nodeid-bound?(metric) == 1) then fgo-nodeid-value(metric) else "?", " event=", fgo-observation-sequence(metric).str(), "@", fgo-observed-epoch(metric).str(), " source-node=", if ((Comparable) fgo-source-nodeid-bound?(metric) == 1) then fgo-source-nodeid-value(metric) else "?"]), width, style, id, channels, evidence),
                fglui-evidence-line(fgd-cat(["src=", fgo-source(metric), " plane=", fgo-plane(metric), " impact=", fgo-note(metric)]), width, style, id, channels, evidence)];
        }
        def fglui-observation-evidence-lines(selected, observation, epoch, width) {
            let provenance = fgov2-observation-provenance(observation);
            let evidence = fgov2-provenance-evidence(provenance);
            let style = fgd-style-for-plane(fgov2-observation-plane(observation), 220, 0);
            let channels = ["evidence", fgov2-observation-kind(observation), fgov2-observation-plane(observation)];
            [fglui-evidence-line(fgd-cat(["E ", selected, "=", fglui-truth-text(fgov2-observation-measurement(observation), fgov2-observation-unit(observation), epoch), " ", fgov2-observation-unit(observation), " ", fgov2-observation-kind(observation), "/", evidence, " age=", fglui-observation-age(observation, epoch)]), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(["field=", fglat-observation-projection-id(observation), " source-node=? telemetry.nodeid-owner-binding"]), width, style, selected, channels, evidence),
                fglui-evidence-line(fgd-cat(["publisher=", fgov2-provenance-publisher(provenance), " src=", fgov2-provenance-source(provenance), " plane=", fgov2-observation-plane(observation), " impact=", fgov2-observation-subtype(observation)]), width, style, selected, channels, evidence)];
        }
        def fglui-metric-selector-id(selected) = if ((len(selected) >= 8) && ((String) substring(selected, 0, 7) == "metric.")) then substring(selected, 7, len(selected)) else selected;
        def fglui-find-qualified-metric(rows, selected) = if ((Comparable) len(rows) == 0) then [] else if ((String) fgd-metric-selector(rows[0]) == selected) then rows[0] else fglui-find-qualified-metric(rows[1:], selected);
        def fglui-selection-active?(selected) = (!(((String) selected == "none") || ((String) selected == "all")));
        def fglui-find-selected-metric(rows, selected) = if ((Comparable) fglui-selection-active?(selected) == 0) then [] else fglui-find-selected-metric-active(rows, selected);
        def fglui-find-selected-metric-active(rows, selected) {
            let exact = fglui-find-qualified-metric(rows, selected);
            if (len(exact) > 0) then exact else fgd-find-metric(rows, fglui-metric-selector-id(selected));
        }
        def fglui-selection-projections(selected, metrics, samples, observations) = if ((Comparable) fglui-selection-active?(selected) == 0) then [] else fglui-selection-projections-active(selected, metrics, samples, observations);
        def fglui-selection-projections-active(selected, metrics, samples, observations) {
            let metric = fglui-find-selected-metric(metrics, selected);
            let sample = fglui-find-sample(samples, selected);
            let observation = fglui-find-observation(observations, selected);
            append([("selector." + selected)], append(if ((Comparable) len(metric) == 0) then [] else [("selector." + fgd-metric-selector(metric))], append(if ((Comparable) len(sample) == 0) then [] else [("selector." + fgtm-sample-selection-id(sample))], if ((Comparable) len(observation) == 0) then [] else [("selector.observation." + fgov2-observation-id(observation))])));
        }
        // The selected tile, said in words.
        //
        // Urs, 2026-09-10: the m/s/o lines "could be selectable and the
        // highlighted translated to human understandable line". Selection
        // already stood -- these three finders, keyed, not indexed, so a tile
        // keeps its identity when the list reorders. What was missing is that a
        // five-column tile like `k*80M` cannot say what it means, and every
        // fact a sentence needs was already on the row it was folded from.
        //
        // Keyed and not indexed matters: an index would name a different tile
        // every time a metric arrives or goes silent, and the sentence would
        // describe something other than what is lit.
        def fglui-selected-row(selected, metrics, samples, observations) {
            let metric = fglui-find-selected-metric(metrics, selected);
            let sample = fglui-find-sample(samples, selected);
            if (len(metric) > 0) then metric else if (len(sample) > 0) then sample else fglui-find-observation(observations, selected);
        }
        def fglui-say-selected(row) = if ((Comparable) fgov2-observation?(row) == 1) then fgd-cat([fgov2-observation-id(row), " = ", fglui-truth-text(fgov2-observation-measurement(row), fgov2-observation-unit(row), now_unix_ms()), " ", fgov2-observation-unit(row), " | ", fgov2-provenance-evidence(fgov2-observation-provenance(row)), " | ", fgov2-provenance-publisher(fgov2-observation-provenance(row))]) else fglat-say-tile(row);
        def fglui-said-line(selected, metrics, samples, observations, width) = if ((Comparable) fglui-selection-active?(selected) == 0) then [] else [fgd-segment-line(fgd-pad-right(("> " + fglui-say-selected(fglui-selected-row(selected, metrics, samples, observations))), width), width, fgd-ready(), "atlas.said", ["atlas", "said"], "declared")];
        def fglui-evidence-lines(selected, open, metrics, samples, observations, epoch, width) {
            let sample = fglui-find-sample(samples, selected);
            let metric = fglui-find-selected-metric(metrics, selected);
            let observation = fglui-find-observation(observations, selected);
            if ((Comparable) open == 0) then [fgd-segment-line(if fglui-selection-active?(selected) then fgd-cat(["Selected: ", selected, " | e shows source and age"]) else "Arrows/Tab select a reading; e shows its source, age and evidence; h help", width, fgd-neutral(128), "evidence.closed", ["evidence", "membrane"], "declared")] else if (len(sample) > 0) then fglui-sample-evidence-lines(selected, sample, epoch, width) else if (len(metric) > 0) then fglui-metric-evidence-lines(fglui-metric-selector-id(selected), metric, width) else if (len(observation) > 0) then fglui-observation-evidence-lines(selected, observation, epoch, width) else [fgd-segment-line(fgd-cat(["EVID UNAVAILABLE door=glass.selection.publisher reason=selection-not-published id=", selected]), width, fgd-health(), "evidence.unavailable", ["evidence", "health"], "unavailable")];
        }
        def fglui-evidence(selected, open, metrics, samples, observations, epoch, width) = fglui-evidence-lines(selected, open, metrics, samples, observations, epoch, width)[0];
        def fglui-metric-key(metric) = fgd-cat([fgo-domain(metric), ".", fgo-id(metric)]);
        // One exact domain/id key per row; first occurrence wins, order kept.
        def fglui-unique-metrics(rows) = fglui-unique-metrics-in(rows, km-for(len(rows) / FGDIndexBucketLoad()), []);
        def fglui-unique-metrics-in(rows, seen, held) = if nil?(rows) then reverse(held) else fglui-unique-metric(rows[0], rows[1:], seen, held, fgd-key-bytes(fglui-metric-key(rows[0])));
        def fglui-unique-metric(row, rest, seen, held, key) {
            let hash = fgd-key-hash(key);
            if km-get-h(seen, hash, key, 0) then fglui-unique-metrics-in(rest, seen, held) else fglui-unique-metrics-in(rest, fgd-key-put(seen, hash, key, 1), cons(row, held));
        }
        def fglui-missing-metrics(rows) = if ((Comparable) len(rows) == 0) then [] else if fgo-missing?(rows[0]) then cons(rows[0], fglui-missing-metrics(rows[1:])) else fglui-missing-metrics(rows[1:]);
        def fglui-memory-priority(metrics) = fglui-unique-metrics(append(fglui-existing-metrics([fgd-find-metric(metrics, "memory-total"), fgd-find-metric(metrics, "memory-free"), fgd-find-metric(metrics, "model-owner-rss"), fgd-find-metric(metrics, "vm-free-bytes"), fgd-find-metric(metrics, "vm-active-bytes"), fgd-find-metric(metrics, "vm-wired-bytes"), fgd-find-metric(metrics, "vm-compressor-bytes")]), metrics));
        def fglui-memory-gap-line(metrics, samples, observations, epoch, width) {
            let typed = len(fglui-seam-observations(fglui-view-observations(observations, "memory")));
            let gauges = len(fglui-missing-metrics(fglui-unique-metrics(metrics)));
            let regions = len(fgd-map-unknown(fgd-map-sample-items(samples, samples, epoch, "all")));
            fgd-segment-line(fgd-cat(["Memory gaps: observations=", typed.str(), " gauges=", gauges.str(), " regions=", regions.str()]), width, if ((Comparable) (typed + (gauges + regions)) == 0) then fgd-ready() else fgd-health(), "memory.gaps", ["memory", "health"], "physical-live");
        }
        def fglui-memory-door-lines(rows, width) = if ((Comparable) len(rows) == 0) then [] else cons(fgd-segment-line(fgd-cat(["? ", fgov2-observation-id(rows[0]), " -> ", fgov2-truth-door(fgov2-observation-measurement(rows[0]))]), width, fgd-health(), fgov2-observation-id(rows[0]), ["memory", "evidence"], "unavailable"), fglui-memory-door-lines(rows[1:], width));
        def fglui-memory-fit(lines, width, budget) = if (budget <= 0) then [] else if (len(lines) <= budget) then lines else append(fgd-take(lines, (budget - 1)), [fgd-segment-line(fgd-cat(["+ ", ((len(lines) - budget) + 1).str(), " memory rows below this viewport; select a field with i, e for evidence"]), width, fgd-neutral(176), "memory.overflow", ["memory", "evidence"], "declared")]);
        def fglui-memory-lines(width, epoch, metrics, samples, observations, budget) {
            let unique = fglui-unique-metrics(metrics);
            let rows = fglui-view-observations(observations, "memory");
            let header = [fgd-title-segment-line("MEMORY cells blueprints recipes tensors arenas", width, "section.memory"), fglui-memory-gap-line(unique, samples, observations, epoch, width), fgd-segment-line("Column bytes = logical fill, not RSS. Blueprint bytes are a cell subset.", width, fgd-neutral(176), "memory.scope", ["memory", "evidence"], "declared")];
            let details = append(fglui-memory-door-lines(fglui-seam-observations(rows), width), append(fglui-observation-lines(fglui-available-observations(rows), epoch, width), fgd-map-lines(unique, samples, epoch, "all", width, 12)));
            fglui-memory-fit(append(header, details), width, budget);
        }
        def fglui-memory-right(metrics, width) = cons(fgd-title-segment-line("HOST / PROCESS RAM / CACHE (separate scopes)", width, "section.right"), fgd-metric-segment-lines(fglui-memory-priority(fglui-unique-metrics(metrics)), width));
        def fglui-seam-line(metrics, width) {
            let seams = fglui-missing-metrics(fglui-unique-metrics(metrics));
            if ((Comparable) len(seams) == 0) then fgd-segment-line("metric gaps=0 (this view)", width, fgd-ready(), "organs.seams", ["health", "evidence"], "physical-live") else fgd-segment-line(fgd-cat(["? seams=", len(seams).str(), " doors:", fglat-seam-door-text(fglat-seam-doors(seams), fglat-seam-room(width))]), width, fgd-health(), "organs.seams", ["health", "evidence"], "unavailable");
        }
        // The overview gives orientation from the same readings as the atlas.
        // Publication, activity, missing evidence and retained history stay distinct.
        def fglui-now-line(text, width, id) = fgd-segment-line(fglm-clean(text, 0, ""), width, fgd-neutral(220), id, ["overview", "selector." + id], "declared");
        def fglui-now-stale-metric?(row) = fgd-kind-in?(fgo-evidence(row), ["silent", "stale"]) || fgd-kind-in?(fgo-lifecycle(row), ["silent", "stale"]);
        def fglui-now-stale-sample?(row) = fgd-has-channel(fgtm-sample-channels(row), "snapshot-stale") || fgd-kind-in?(fgtm-sample-evidence(row), ["silent", "stale"]);
        def fglui-now-evidence(evidence) = if ((String) evidence == "physical-live") then "measured" else if ((String) evidence == "derived-window") then "derived" else evidence;
        def fglui-now-metric-text(row) = if (len(row) == 0) then "no publication for this route" else if (!fgo-present?(row)) then fgd-cat([if fgo-absent?(row) then "absent: " else "missing: ", fgo-note(row)]) else fgd-cat([if ((String) fgo-unit(row) == "ready") then if ((Comparable) fgo-int-value(row) == 0) then "no" else "yes" else fgd-cat([fgd-metric-value(row), if ((String) fgo-unit(row) == "") then "" else (" " + fgo-unit(row))]), if fglui-now-stale-metric?(row) then " (stale)" else "", " | ", fglui-now-evidence(fgo-evidence(row)), if (fgo-age(row) < 0) then "; source clock missing" else (" age " + fgd-format-age-ms(fgo-age(row)))]);
        def fglui-now-metric(metrics, id, label, width) {
            let row = fgd-find-metric(metrics, id);
            fgd-segment-line(fgd-cat([label, ": ", fglui-now-metric-text(row)]), width, fgd-neutral(220), if (len(row) == 0) then ("overview." + id) else fgd-metric-selector(row), if (len(row) == 0) then ["overview"] else [("selector." + fgd-metric-selector(row)), "overview"], if (len(row) == 0) then "unavailable" else fgo-evidence(row));
        }
        def fglui-now-work?(sample) = fgd-kind-in?(fgtm-sample-kind(sample), ["request", "model-state"]) || (((String) fgtm-sample-kind(sample) == "metric") && ((String) fgtm-sample-lane(sample) == "tools"));
        def fglui-now-active?(sample) = fglui-now-work?(sample) && !fglui-now-stale-sample?(sample) && ((String) fgtm-sample-evidence(sample) == "physical-live") && fgd-kind-in?(fgtm-sample-lifecycle(sample), ["active", "prefill", "generating", "running"]);
        def fglui-now-agent?(sample) = ((String) fgtm-sample-kind(sample) == "work-session") && rw-activity?(fgtm-sample-cell(sample));
        def fglui-now-word-end(text, at, cut, cursor) = if (cursor <= at) then cut else if ((Comparable) str_byte_at(text, (cursor - 1)) == 32) then cursor else fglui-now-word-end(text, at, cut, (cursor - 1));
        def fglui-now-wrap-at(text, at, width, id) {
            let cut = fglm-cut(text, at, (at + width));
            let end = if (cut >= len(text)) then cut else fglui-now-word-end(text, at, cut, cut);
            if (end <= at) then [] else cons(fgd-byte-segment-line(fglm-clean-span(text, at, end), width, fgd-neutral(220), id, [("selector." + id), "overview", "public-activity"], "declared"), fglui-now-wrap-at(text, end, width, id));
        }
        def fglui-now-wrap(text, width, id) = fglui-now-wrap-at(text, 0, width, id);
        def fglui-now-agent-lines(samples, epoch, width) = if nil?(samples) then [] else append(fglui-now-agent-line(samples[0], epoch, width), fglui-now-agent-lines(samples[1:], epoch, width));
        def fglui-now-agent-line(sample, epoch, width) {
