            let tabs = fgd-segment-line(if ((String) chosen == "help") then "HELP h a t o m f j s k v n d 1-4 0 i e c q | g y w play | Enter commits" else "o our work | a atlas m memory f flow s transcripts v events | h help q quit", w, fgd-neutral(176), "glass.tabs", ["all", "control"], "declared");
