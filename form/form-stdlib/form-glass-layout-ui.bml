            let omitted = if ((String) chosen == "atlas") then fglat-omitted-count-for-rows(metrics, samples, observations, w, atlasRows) else 0;
            let chrome = fgd-take([header, tabs, flow], fgd-min(3, (h - 1)));
            if (h <= 1) then ["form-glass-segment-frame-v2", w, h, [header], ftc-overflow("hidden-count", omitted)] else ["form-glass-segment-frame-v2", w, h, fgd-clip-lines(append(chrome, append(body, [footer])), w), ftc-overflow("view-filtered", omitted)];
        }
    }
    0;
}
