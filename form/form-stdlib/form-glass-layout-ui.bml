//
// form-glass-layout-ui.bml — responsive frame-composition shard.
//
// Authority: form-stdlib/bml/form-glass-live-ui.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-choice-ui.bml form/form-stdlib/form-glass-meaning-ui.bml form/form-stdlib/form-glass-flow-ui.bml form/form-stdlib/form-glass-observation-ui.bml form/form-stdlib/form-glass-atlas-ui.bml form/form-stdlib/form-glass-dashboard.bml form/form-stdlib/form-glass-sensor-rows.bml form/form-stdlib/bml/glass-view-viewport.bml
//
