//////////////////////////////////////////////////////////////////////
//
// form-cli-nodeid-answer.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-nodeid-answer.bml
//
// Delayed recipe pointer: offer, ask, nested tree, pyramid scale.
// The .fk organ stays; they agree value-for-value. No xtal twin.
//
// Proven by: form-stdlib/tests/form-cli-nodeid-answer-bml-band.fk
//
// preludes: form-stdlib/core.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormNodeidAnswerAuthority {
        field AnswerAuthorityPath = "form/form-stdlib/bml/form-cli-nodeid-answer.bml";
        field AnswerAuthorityKind = "high-bml-class-template-field";
    }

    class FormNodeidAnswer {
        field KindNone = 0;
        field KindBlueprint = 1;
        field KindRecipe = 2;
        field KindCell = 3;
        field DelayOffer = 0;
        field DelayAsk = 1;
        field CostOutside = 0;
        field CostStream = 1;

        ref fnidb-authority = FormNodeidAnswerAuthority;
        thought fnidb-pattern = list("offer-ask", "nested-tree", "pyramid-scale", "agree-with-organ");

        def fnidb-kind-none() = KindNone();
        def fnidb-kind-blueprint() = KindBlueprint();
        def fnidb-kind-recipe() = KindRecipe();
        def fnidb-kind-cell() = KindCell();
        def fnidb-delay-offer() = DelayOffer();
        def fnidb-delay-ask() = DelayAsk();
        def fnidb-cost-outside() = CostOutside();
        def fnidb-cost-stream() = CostStream();

        def fnidb-pointer(kind) = list("form-cli-nodeid-v1", kind, fnidb-delay-offer(), fnidb-cost-outside());
        def fnidb-kind(p) = nth(p, 1);
        def fnidb-delay(p) = nth(p, 2);
        def fnidb-cost(p) = nth(p, 3);
        def fnidb-pointer?(p) = if ge(len(p), 4) then if str_eq(nth(p, 0), "form-cli-nodeid-v1") then 1 else 0 else 0;

        def fnidb-ask(p) = if eq(fnidb-kind(p), fnidb-kind-none()) then p else if eq(len(p), 7) then list("form-cli-nodeid-v1", fnidb-kind(p), fnidb-delay-ask(), fnidb-cost(p), nth(p, 4), nth(p, 5), nth(p, 6)) else list("form-cli-nodeid-v1", fnidb-kind(p), fnidb-delay-ask(), fnidb-cost(p));

        def fnidb-recipe(op, a, b) = list("form-cli-nodeid-v1", fnidb-kind-recipe(), fnidb-delay-offer(), fnidb-cost-outside(), op, a, b);
        def fnidb-op(p) = nth(p, 4);
        def fnidb-a(p) = nth(p, 5);
        def fnidb-b(p) = nth(p, 6);
        def fnidb-eval(op, a, b) = if str_eq(op, "add") then add(a, b) else if str_eq(op, "mul") then mul(a, b) else if str_eq(op, "sub") then sub(a, b) else if str_eq(op, "eq") then eq(a, b) else nothing();
        def fnidb-operand-reply(x) = if eq(fnidb-pointer?(x), 1) then fnidb-reply(fnidb-ask(x)) else x;
        def fnidb-reply(p) = if eq(fnidb-delay(p), fnidb-delay-ask()) then if eq(len(p), 7) then fnidb-eval(fnidb-op(p), fnidb-operand-reply(fnidb-a(p)), fnidb-operand-reply(fnidb-b(p))) else nothing() else nothing();
        def fnidb-offers(x) = if eq(fnidb-pointer?(x), 1) then if eq(len(x), 7) then add(1, add(fnidb-offers(fnidb-a(x)), fnidb-offers(fnidb-b(x)))) else 1 else 0;
        def fnidb-composed() = fnidb-recipe("add", fnidb-recipe("mul", 6, 7), fnidb-recipe("sub", 9, 4));
        def fnidb-sum-acc(n, acc) = if eq(n, 0) then acc else fnidb-sum-acc(sub(n, 1), fnidb-recipe("add", acc, n));
        def fnidb-sum-tree(n) = fnidb-sum-acc(n, 0);
        def fnidb-max(a, b) = if gt(a, b) then a else b;
        def fnidb-depth(x) = if eq(fnidb-pointer?(x), 1) then if eq(len(x), 7) then add(1, fnidb-max(fnidb-depth(fnidb-a(x)), fnidb-depth(fnidb-b(x)))) else 1 else 0;
        def fnidb-rev(xs, acc) = if eq(len(xs), 0) then acc else fnidb-rev(tail(xs), cons(head(xs), acc));
        def fnidb-range(n, acc) = if eq(n, 0) then acc else fnidb-range(sub(n, 1), cons(n, acc));
        def fnidb-pair(xs, acc) = if eq(len(xs), 0) then acc else if eq(len(tail(xs)), 0) then cons(head(xs), acc) else fnidb-pair(tail(tail(xs)), cons(fnidb-recipe("add", head(xs), head(tail(xs))), acc));
        def fnidb-pyramid(xs) = if eq(len(xs), 0) then 0 else if eq(len(xs), 1) then head(xs) else fnidb-pyramid(fnidb-rev(fnidb-pair(xs, empty()), empty()));
        def fnidb-scale(n) = fnidb-pyramid(fnidb-range(n, empty()));
        def fnidb-embed(host, guest) = cons(guest, host);
        def fnidb-embed-held?(host) = if eq(len(host), 0) then 1 else if eq(fnidb-delay(head(host)), fnidb-delay-offer()) then fnidb-embed-held?(tail(host)) else 0;
        def fnidb-jit-ready?(p) = if eq(fnidb-kind(p), fnidb-kind-recipe()) then if eq(fnidb-delay(p), fnidb-delay-ask()) then 1 else 0 else 0;
        def fnidb-speak() = "node-id observe=node kind=recipe delay=offer cost=outside";

        def fnidbk(cond, bit) = if cond then bit else 0;
        def fnidb-check-pointer() {
            add(fnidbk(eq(fnidb-kind(fnidb-pointer(fnidb-kind-recipe())), fnidb-kind-recipe()), 1),
            add(fnidbk(eq(fnidb-delay(fnidb-pointer(fnidb-kind-recipe())), fnidb-delay-offer()), 2),
            add(fnidbk(eq(fnidb-cost(fnidb-pointer(fnidb-kind-recipe())), fnidb-cost-outside()), 4),
            add(fnidbk(eq(fnidb-embed-held?(fnidb-embed(empty(), fnidb-pointer(fnidb-kind-recipe()))), 1), 8),
            add(fnidbk(eq(fnidb-jit-ready?(fnidb-pointer(fnidb-kind-recipe())), 0), 16),
            add(fnidbk(eq(fnidb-jit-ready?(fnidb-ask(fnidb-pointer(fnidb-kind-recipe()))), 1), 32),
            add(fnidbk(eq(fnidb-kind(fnidb-ask(fnidb-pointer(fnidb-kind-recipe()))), fnidb-kind-recipe()), 64),
                fnidbk(not(lt(str_find(fnidb-speak(), "kind=recipe delay=offer cost=outside", 0), 0)), 128))))))));
        }
        def fnidb-check-ask() {
            add(fnidbk(nothing?(fnidb-reply(fnidb-recipe("add", 2, 3))), 256),
            add(fnidbk(eq(fnidb-reply(fnidb-ask(fnidb-recipe("add", 2, 3))), 5), 512),
                fnidbk(eq(fnidb-cost(fnidb-ask(fnidb-recipe("add", 2, 3))), fnidb-cost-outside()), 1024)));
        }
        def fnidb-check-tree() {
            add(fnidbk(nothing?(fnidb-reply(fnidb-composed())), 2048),
            add(fnidbk(eq(fnidb-reply(fnidb-ask(fnidb-composed())), 47), 4096),
            add(fnidbk(eq(fnidb-offers(fnidb-composed()), 3), 8192),
            add(fnidbk(eq(fnidb-reply(fnidb-ask(fnidb-sum-tree(10))), 55), 16384),
                fnidbk(eq(fnidb-cost(fnidb-ask(fnidb-composed())), fnidb-cost-outside()), 32768)))));
        }
        def fnidb-check-scale() {
            add(fnidbk(eq(fnidb-offers(fnidb-scale(8)), 7), 65536),
            add(fnidbk(eq(fnidb-reply(fnidb-ask(fnidb-scale(8))), 36), 131072),
            add(fnidbk(eq(fnidb-depth(fnidb-scale(8)), 3), 262144),
                fnidbk(eq(fnidb-depth(fnidb-sum-tree(8)), 8), 524288))));
        }
        def fnidb-check() = add(add(add(fnidb-check-pointer(), fnidb-check-ask()), fnidb-check-tree()), fnidb-check-scale());
    }
    0;
}
