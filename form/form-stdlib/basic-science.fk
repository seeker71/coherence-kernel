; basic-science.fk — three small, executable science models in native Form.
;
; A science answer becomes useful here when its quantities, assumptions, and failure
; edge can be run. This cell holds a deliberately modest first surface:
;
;   physics   — compatible quantities, constant-velocity displacement, F = ma,
;               and kinetic energy in named SI units;
;   chemistry — atom conservation for a declared, finite element set;
;   biology   — Mendelian segregation for one binary dominant/recessive locus.
;
; These are models, not a replacement for measurement. A dimensional mismatch is
; `nothing`, while zero remains a valid quantity. A reaction is checked only against
; the elements the caller declares. The inheritance model is a classroom allele model,
; not an account of whole organisms, human traits, or medical reality.
;
;   (bsc-quantity value dimension)            -> (value, dimension)
;   (bsc-add left right)                       -> compatible sum, or nothing
;   (bsc-displacement speed-mps duration-s)    -> metres, or nothing
;   (bsc-force mass-kg accel-mps2)             -> newtons, or nothing
;   (bsc-kinetic-energy mass-kg speed-mps)     -> joules, or nothing
;   (bsc-balanced-elements? lhs rhs elements)  -> 1 / 0
;   (bsc-cross parent-a parent-b)              -> four offspring genotypes
;
; Species: (list (list "H" 2) (list "O" 1)); a reaction term is
; (list coefficient species). Elements must be named explicitly at the call site.
;
; preludes: form-stdlib/core.fk
;

(do
    ; --- quantities: value never carries a hidden unit. ---
    (defn bsc-quantity (value dimension) (list value dimension))
    (defn bsc-value (quantity) (nth quantity 0))
    (defn bsc-dimension (quantity) (nth quantity 1))
    (defn bsc-same-dimension? (left right)
        (value_eq (bsc-dimension left) (bsc-dimension right)))
    (defn bsc-add (left right)
        (if (bsc-same-dimension? left right)
            (bsc-quantity (add (bsc-value left) (bsc-value right)) (bsc-dimension left))
            (nothing)))

    ; These named constructors intentionally prevent an unlabelled scalar from
    ; masquerading as a physical measurement.
    (defn bsc-speed-mps (value) (bsc-quantity value "speed-m-per-s"))
    (defn bsc-duration-s (value) (bsc-quantity value "time-s"))
    (defn bsc-length-m (value) (bsc-quantity value "length-m"))
    (defn bsc-mass-kg (value) (bsc-quantity value "mass-kg"))
    (defn bsc-accel-mps2 (value) (bsc-quantity value "accel-m-per-s2"))
    (defn bsc-force-n (value) (bsc-quantity value "force-n"))
    (defn bsc-energy-j (value) (bsc-quantity value "energy-j"))

    ; --- physics: equations have explicit expected input and output dimensions. ---
    (defn bsc-displacement (speed duration)
        (if (value_eq (bsc-dimension speed) "speed-m-per-s")
            (if (value_eq (bsc-dimension duration) "time-s")
                (bsc-length-m (mul (bsc-value speed) (bsc-value duration)))
                (nothing))
            (nothing)))
    (defn bsc-force (mass acceleration)
        (if (value_eq (bsc-dimension mass) "mass-kg")
            (if (value_eq (bsc-dimension acceleration) "accel-m-per-s2")
                (bsc-force-n (mul (bsc-value mass) (bsc-value acceleration)))
                (nothing))
            (nothing)))
    (defn bsc-kinetic-energy (mass speed)
        (if (value_eq (bsc-dimension mass) "mass-kg")
            (if (value_eq (bsc-dimension speed) "speed-m-per-s")
                (bsc-energy-j (mul 0.5 (mul (bsc-value mass) (mul (bsc-value speed) (bsc-value speed)))))
                (nothing))
            (nothing)))

    ; --- chemistry: count a declared atom on one species / reaction side. ---
    (defn bsc-species-atom-count (species atom)
        (if (eq (len species) 0) 0
            (if (value_eq (nth (head species) 0) atom)
                (nth (head species) 1)
                (bsc-species-atom-count (tail species) atom))))
    (defn bsc-term-coefficient (term) (nth term 0))
    (defn bsc-term-species (term) (nth term 1))
    (defn bsc-term-atom-count (term atom)
        (mul (bsc-term-coefficient term)
             (bsc-species-atom-count (bsc-term-species term) atom)))
    (defn bsc-side-atom-count (side atom)
        (if (eq (len side) 0) 0
            (add (bsc-term-atom-count (head side) atom)
                 (bsc-side-atom-count (tail side) atom))))
    (defn bsc-balanced-atom? (left right atom)
        (eq (bsc-side-atom-count left atom) (bsc-side-atom-count right atom)))
    (defn bsc-balanced-elements? (left right elements)
        (if (eq (len elements) 0) 1
            (if (bsc-balanced-atom? left right (head elements))
                (bsc-balanced-elements? left right (tail elements))
                0)))

    ; --- biology: one locus, two gametes, four equally represented offspring. ---
    ; A genotype is (allele-a allele-b), with 1 = the model's dominant allele and
    ; 0 = its recessive allele. These values are domain data, not absence/presence.
    (defn bsc-genotype (allele-a allele-b) (list allele-a allele-b))
    (defn bsc-gametes (parent) (list (nth parent 0) (nth parent 1)))
    (defn bsc-offspring-for-allele (allele gametes)
        (if (eq (len gametes) 0) (empty)
            (cons (bsc-genotype allele (head gametes))
                  (bsc-offspring-for-allele allele (tail gametes)))))
    (defn bsc-append (left right)
        (if (eq (len left) 0) right
            (cons (head left) (bsc-append (tail left) right))))
    (defn bsc-cross-rows (gametes-a gametes-b)
        (if (eq (len gametes-a) 0) (empty)
            (bsc-append (bsc-offspring-for-allele (head gametes-a) gametes-b)
                        (bsc-cross-rows (tail gametes-a) gametes-b))))
    (defn bsc-cross (parent-a parent-b)
        (bsc-cross-rows (bsc-gametes parent-a) (bsc-gametes parent-b)))
    (defn bsc-dominant-phenotype? (genotype)
        (if (eq (nth genotype 0) 1) 1
            (if (eq (nth genotype 1) 1) 1 0)))
    (defn bsc-count-dominant (offspring)
        (if (eq (len offspring) 0) 0
            (add (bsc-dominant-phenotype? (head offspring))
                 (bsc-count-dominant (tail offspring)))))
    (defn bsc-count-recessive (offspring)
        (if (eq (len offspring) 0) 0
            (add (if (eq (bsc-dominant-phenotype? (head offspring)) 0) 1 0)
                 (bsc-count-recessive (tail offspring)))))

    0)
