; form-cli-bml-cache-run.fk — BML reaches its own native cache, on demand.
;
; The BML prelude lowers in memory and fkwu owns its `.bml.fkb` cache. No
; historical compile-companion sweep and no `*-xtal.fk` source mirror exists.
;
; preludes: form-stdlib/core.fk form-stdlib/language-template.fk
; preludes: form-stdlib/bml/form-cli-bml-cache.bml

(do
    (print_str (str_concat "bml-cache state="
        (str_concat (bce-cache-state)
            (str_concat " bounded=" (str_concat (int_to_str (bce-bounded?)) "\n")))))
    0)
