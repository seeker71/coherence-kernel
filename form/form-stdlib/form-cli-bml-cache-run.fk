; form-cli-bml-cache-run.fk — BML names source and optional image separately.
;
; The BML prelude lowers in memory and fkwu owns its `.bml.fkb` cache. No
; historical compile-companion sweep and no `*-xtal.fk` source mirror exists.
;
; preludes: form-stdlib/core.fk form-stdlib/language-template.fk
; preludes: form-stdlib/bml/form-cli-bml-cache.bml

(do
    (defn bcer-cat (parts)
        (if (eq (len parts) 0) ""
            (str_concat (head parts) (bcer-cat (tail parts)))))
    (print_str (bcer-cat (list
        "bml source=" (if (eq (bce-runnable?) 1) "runnable" "missing")
        " dispatch-candidate=" (bce-dispatch-candidate)
        " artifact=" (bce-artifact-state)
        " root-compatibility=" (bce-root-compatibility)
        " readiness-gate=" (int_to_str (bce-readiness-gate?))
        " source-admission=" (bce-source-admission)
        " bounded=" (int_to_str (bce-bounded?)))))
    0)
