// form-cli-bml-cache-run.fk — BML names source and optional image separately.
//
// The BML prelude lowers in memory and fkwu owns its `.bml.fkb` cache. No
// historical compile-companion sweep and no `*-xtal.fk` source mirror exists.
//
import form-stdlib/core.fk;
import form-stdlib/language-template.fk;
import form-stdlib/bml/form-cli-bml-cache.bml;
section [form.bml] {
    def bcer-cat(parts) = (Comparable) len(parts) == 0 ? "" : ((String) parts[0] + bcer-cat(parts[1:]));
    print_str(bcer-cat(["bml source=", (Comparable) bce-runnable?() == 1 ? "runnable" : "missing", " dispatch-candidate=", bce-dispatch-candidate(), " artifact=", bce-artifact-state(), " root-compatibility=", bce-root-compatibility(), " readiness-gate=", bce-readiness-gate?().str(), " source-admission=", bce-source-admission(), " bounded=", bce-bounded?().str()]));
    0;
}
