; form-cli-universe-mint-run.fk — mint universe skill samples, fit overlay, print lift.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-mint-split-lineage.fk
; preludes: form-stdlib/form-cli-universe-mint.bml

(do
    (let rows (fum-corpus 3 1))
    (let n (fum-n 3 1))
    (let correct (fum-heldout-correct rows))
    (print_str (str_concat "fum n=" (str_concat (int_to_str n) "\n")))
    (print_str (str_concat "fum unique=" (str_concat (int_to_str (fum-unique rows)) "\n")))
    (print_str (str_concat "fum exact-leakage=" (str_concat (int_to_str (fum-leakage rows)) "\n")))
    (print_str (str_concat "fum source-overlap-ids=" (str_concat (int_to_str (len (fmls-source-intersection rows (SplitTrain) (SplitHeldout)))) "\n")))
    (print_str (str_concat "fum lesson-overlap-ids=" (str_concat (int_to_str (fum-lesson-leakage rows)) "\n")))
    (print_str (str_concat "fum transform-only-ids=" (str_concat (int_to_str (len (fmls-transform-only rows (SplitTrain) (SplitHeldout)))) "\n")))
    (print_str (str_concat "fum lineage-signal=" (str_concat (int_to_str (fum-lineage-signal rows)) "\n")))
    (print_str (str_concat "fum heldout-correct=" (str_concat (int_to_str correct) "\n")))
    (print_str (str_concat "fum heldout-n=" (str_concat (int_to_str (fum-count-split rows (SplitHeldout))) "\n")))
    (print_str (str_concat "fum lora-writer=" (str_concat (int_to_str (fum-lora-writer)) "\n")))
    (print_str (str_concat "fum check=" (str_concat (int_to_str (fum-check)) "\n")))
    (print_str (str_concat "fum scale-5-2=" (str_concat (int_to_str (fum-n 5 2)) "\n")))
    (print_str (str_concat "fum scale-12-4=" (str_concat (int_to_str (fum-n 12 4)) "\n")))
    (print_str (str_concat "fum scale-5-2-lesson-overlap-ids=" (str_concat (int_to_str (len (fmls-lesson-intersection (fum-corpus 5 2) (SplitTrain) (SplitHeldout)))) "\n")))
    (print_str "fum behavior-observation=nothing\n")
    (print_str (str_concat "fum sample-bml=" (str_concat (nth (fum-row "bml" 0 (SplitTrain)) 2) "\n")))
    (print_str (str_concat "fum sample-lift=" (str_concat (nth (fum-row "lift-sexp" 0 (SplitTrain)) 2) "\n")))
    (print_str (str_concat "fum sample-fb=" (str_concat (nth (fum-row "framebuffer" 0 (SplitTrain)) 2) "\n")))
    0)
