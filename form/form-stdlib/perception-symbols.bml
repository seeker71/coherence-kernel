//////////////////////////////////////////////////////////////////////
//
// perception-symbols.bml — the perceived things that are NOT words.
//
// A heard line already resolves to symbols (meaning-codes, ear.symbols). Everything
// else the room gives arrives as prose in a row's value: "still", "-50 dBFS, airy,
// steady 3 s", "asleep — resting", a pitch in hertz. This cell gives each of those a
// symbol of its own, so the whole perception — the words AND the sound around them —
// is one line of symbols the body can carry, address and say in any tongue.
//
// Four families, twenty symbols:
//   room-kind    still voice tone knock noise      what kind of sound this is
//   room-tone    hiss air rumble                   the colour of the room's own quiet
//   ear-state    asleep deaf silent speaking heard the ear's own condition
//   voice-manner cadence intonation pitch volume expression stillness resonance
//
// The symbols are read OFF the sensors' own rows, never invented beside them: the
// kind is room.kind's word, the colour is the word room.tone already prints, the
// state is the word ear.state opens with, and a manner stands only when its own
// prosody row carries a reading. A manner whose row is absent is NOT perceived and
// does not enter the line — an axis the body has is not a thing the body senses.
//
// Node ids and tongues are meaning-codes' work, not this cell's: mc-anchor(sym)
// addresses a symbol, mc-say-in(sym, kind) says it, and mc-nl reads its English
// phrase from here. This cell stays light on purpose, so the glass, which preludes it
// and reads it every frame, never pays for a hash to paint a word.
//
// preludes: form/form-stdlib/core.fk form/form-stdlib/line-grammar.fk form/form-stdlib/form-glass-observer.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormPerceptionSymbols {
        field PSSchema = "perception-symbols-v1";

        // ── the roster ────────────────────────────────────────────────────
        def ps-kinds() = list("still", "voice", "tone", "knock", "noise");
        def ps-colours() = list("hiss", "air", "rumble");
        def ps-states() = list("asleep", "deaf", "silent", "speaking", "heard");
        def ps-manners() = list("cadence", "intonation", "pitch", "volume", "expression", "stillness", "resonance");
        def ps-symbols() = append(ps-kinds(), append(ps-colours(), append(ps-states(), ps-manners())));
        def ps-member?(xs, x) = (Comparable) len(xs) == 0 ? 0 : (String) head(xs) == x ? 1 : ps-member?(tail(xs), x);
        def ps-symbol?(sym) = ps-member?(ps-symbols(), sym);
        // a symbol without its family is a token; the family says what it is a symbol OF
        def ps-family(sym) = (Comparable) ps-member?(ps-kinds(), sym) == 1 ? "room-kind" : (Comparable) ps-member?(ps-colours(), sym) == 1 ? "room-tone" : (Comparable) ps-member?(ps-states(), sym) == 1 ? "ear-state" : (Comparable) ps-member?(ps-manners(), sym) == 1 ? "voice-manner" : "";
        def ps-families() = list("room-kind", "room-tone", "ear-state", "voice-manner");

        // ── the English phrase of each symbol; meaning-codes keys the locale rows on it ──
        def ps-nl(sym) = (String) sym == "still" ? "a still room" : (String) sym == "voice" ? "a voice" : (String) sym == "tone" ? "a held tone" : (String) sym == "knock" ? "a knock" : (String) sym == "noise" ? "noise"
            : (String) sym == "hiss" ? "hissy" : (String) sym == "air" ? "airy" : (String) sym == "rumble" ? "a low rumble"
            : (String) sym == "asleep" ? "the ear sleeps" : (String) sym == "deaf" ? "the ear hears nothing" : (String) sym == "silent" ? "under the speech floor" : (String) sym == "speaking" ? "a line is open" : (String) sym == "heard" ? "a line closed"
            : (String) sym == "cadence" ? "the pace of the speaking" : (String) sym == "intonation" ? "where the phrase went" : (String) sym == "pitch" ? "the voice's pitch" : (String) sym == "volume" ? "the room's level" : (String) sym == "expression" ? "how much the delivery lives" : (String) sym == "stillness" ? "the share that was quiet" : (String) sym == "resonance" ? "how the sound falls away" : "";

        // ── reading a perceived thing off a sensor's own row value ────────
        def ps-cat(parts) = (Comparable) len(parts) == 0 ? "" : head(parts) ++ ps-cat(tail(parts));
        def ps-has?(text, needle) = str_find(text, needle, 0) < 0 ? 0 : 1;
        // room.kind's value IS the kind word the organ decided
        def ps-kind-of(value) = ps-kind-word(trim(value));
        def ps-kind-word(w) = (Comparable) ps-member?(ps-kinds(), w) == 1 ? w : "";
        // room.tone prints its colour between the level and the steadiness: "-50 dBFS, airy, steady 3 s"
        def ps-colour-of(value) = (Comparable) ps-has?(value, "hissy") == 1 ? "hiss" : (Comparable) ps-has?(value, "airy") == 1 ? "air" : (Comparable) ps-has?(value, "rumble") == 1 ? "rumble" : "";
        // ear.state opens with its state word, then an em dash and the verse's own word
        def ps-state-of(value) = ps-state-word(trim(ps-first-word(trim(value))));
        def ps-first-word(value) = ps-cut(value, str_find(value, " ", 0));
        def ps-cut(value, at) = at < 0 ? value : substring(value, 0, at);
        def ps-state-word(w) = (Comparable) ps-member?(ps-states(), w) == 1 ? w : "";
        // a manner is named by its own prosody row's second segment: prosody.cadence.rate -> cadence
        def ps-manner-of(id) = ps-manner-at(split-on(id, "."));
        def ps-manner-at(parts) = len(parts) < 2 ? "" : !((String) head(parts) == "prosody") ? "" : ps-manner-word(parts[1]);
        def ps-manner-word(w) = (Comparable) ps-member?(ps-manners(), w) == 1 ? w : "";
        // the one row that carries each manner's reading; the others of that axis stand beside it in the frame
        def ps-manner-door(sym) = (String) sym == "cadence" ? "prosody.cadence.rate" : (String) sym == "intonation" ? "prosody.intonation.span" : (String) sym == "pitch" ? "prosody.pitch" : (String) sym == "volume" ? "prosody.volume" : (String) sym == "expression" ? "prosody.expression.level" : (String) sym == "stillness" ? "prosody.stillness" : (String) sym == "resonance" ? "prosody.resonance.decay" : "";

        // ── one perceived thing: its symbol, its family, what was read, the door it was read at ──
        def ps-seen(sym, reading, door) = list(sym, ps-family(sym), reading, door);
        def ps-seen-sym(s) = head(s);
        def ps-seen-family(s) = s[1];
        def ps-seen-reading(s) = s[2];
        def ps-seen-door(s) = s[3];
        def ps-see-one(sym, reading, door) = (Comparable) str_len(sym) == 0 ? list() : list(ps-seen(sym, reading, door));

        // ── the rows themselves ───────────────────────────────────────────
        def ps-row(rows, id) = (Comparable) len(rows) == 0 ? list() : (String) fgo-id(head(rows)) == id ? head(rows) : ps-row(tail(rows), id);
        def ps-text(rows, id) = ps-text-of(ps-row(rows, id));
        // A confident value from a publisher that stopped giving is NOT a perception. The glass
        // marks every row it takes from a frame older than three of that sensor's own declared
        // cadences as silent (fgsr-rows-or-absent), and a row wearing that mark reads as nothing
        // here. Witnessed 2026-09-07: no room sensor was standing, its last frame still said
        // "still, airy" from minutes before, and the ear beside it was hearing a whole sentence --
        // a dead room's last words were becoming a live symbol until this refused them.
        def ps-live?(r) = (Comparable) len(r) == 0 ? 0 : (Comparable) fgo-present?(r) == 0 ? 0 : (String) fgo-evidence(r) == "silent" ? 0 : (String) fgo-lifecycle(r) == "silent" ? 0 : 1;
        def ps-text-of(r) = (Comparable) ps-live?(r) == 1 ? fgo-text-value(r) : "";
        // an absent row reads as nothing, never as a zero: a door that answered nothing is not a measurement
        def ps-reading-of(r) = (Comparable) ps-live?(r) == 0 ? "" : (String) fgo-value-kind(r) == "int" ? ps-cat(list(int_to_str(fgo-int-value(r)), " ", fgo-unit(r))) : fgo-text-value(r);
        def ps-reading(rows, id) = ps-reading-of(ps-row(rows, id));

        // ── the whole perception, in the order a room is read ─────────────
        def ps-see-state(rows) = ps-see-one(ps-state-of(ps-text(rows, "ear.state")), ps-text(rows, "ear.state"), "ear.state");
        def ps-see-kind(rows) = ps-see-one(ps-kind-of(ps-text(rows, "room.kind")), ps-text(rows, "room.kind"), "room.kind");
        def ps-see-colour(rows) = ps-see-one(ps-colour-of(ps-text(rows, "room.tone")), ps-text(rows, "room.tone"), "room.tone");
        def ps-see-manner(rows, sym) = ps-see-manner-at(sym, ps-manner-door(sym), ps-reading(rows, ps-manner-door(sym)));
        def ps-see-manner-at(sym, door, reading) = (Comparable) str_len(reading) == 0 ? list() : list(ps-seen(sym, reading, door));
        def ps-see-manners(rows, syms) = (Comparable) len(syms) == 0 ? list() : append(ps-see-manner(rows, head(syms)), ps-see-manners(rows, tail(syms)));
        def ps-perceive(rows) = append(ps-see-state(rows), append(ps-see-kind(rows), append(ps-see-colour(rows), ps-see-manners(rows, ps-manners()))));

        // what the body has an axis for and is NOT sensing now; named, so a short line is not read as a poor room
        def ps-unperceived(rows, syms) = (Comparable) len(syms) == 0 ? list() : len(ps-see-manner(rows, head(syms))) > 0 ? ps-unperceived(rows, tail(syms)) : cons(head(syms), ps-unperceived(rows, tail(syms)));
        def ps-unsensed(rows) = ps-unperceived(rows, ps-manners());

        // ── the line ──────────────────────────────────────────────────────
        def ps-syms(seen) = (Comparable) len(seen) == 0 ? list() : cons(ps-seen-sym(head(seen)), ps-syms(tail(seen)));
        def ps-join(xs, sep) = (Comparable) len(xs) == 0 ? "" : (Comparable) len(tail(xs)) == 0 ? head(xs) : ps-cat(list(head(xs), sep, ps-join(tail(xs), sep)));
        def ps-line(seen) = ps-join(ps-syms(seen), " ");
        def ps-line-of(rows) = ps-line(ps-perceive(rows));
        def ps-reading-line(seen) = (Comparable) len(seen) == 0 ? "" : ps-cat(list(ps-seen-sym(head(seen)), "=", ps-seen-reading(head(seen)), (Comparable) len(tail(seen)) == 0 ? "" : "  ", ps-reading-line(tail(seen))));
    }
    0;
}
