//////////////////////////////////////////////////////////////////////
//
// form-glass-recipes.bml — where a kernel's dispatches actually go.
//
// Urs, 2026-09-10: "more histograms can teach more optimizations."
//
// The crossing lens folds what goes over the membrane. This one folds
// what happens inside a kernel, over the same grammar and the same
// histogram doors, because a body should not need two ways to count.
//
// It became possible an hour before it was written. Every profiling door
// answered at most sixty-four rows and said nothing about the cut, so the
// distribution could not be seen -- only its head, mistaken for the whole.
// With the cut gone the page answers all of its recipes, and the first
// question a reader should ask is whether there is a head at all:
//
//   CONCENTRATION  how much of the total mass the first one, eight,
//                  sixty-four and two hundred and fifty-six carry. If the
//                  first eight carry half, a local fix is worth writing.
//                  If the curve is flat, no single door will help and the
//                  honest answer is that there is nothing to optimise
//                  here -- which is a finding, not a failure.
//
//   BY UNIT        which file's recipes carry the dispatches, so the
//                  reading names a door rather than a symbol
//
//   BY NATIVE      the mass that is walking, crystallized, or declined.
//                  This is the only histogram that names leverage: heat
//                  sitting in a recipe the JIT declined is heat no lane
//                  currently reaches.
//
//   BY BOXES, MINTS, FOLDS   which recipes grow the arena and which run
//                  as this machine's own instructions
//
// Nothing here is sampled. Every number is a counter the kernel already
// keeps in its own page, and a reading of another kernel costs one map of
// its page and no cooperation from it.
//
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-crossings.bml

section [form.bml] {
    class FormGlassRecipes {
        field FGRSchema = "form-glass-recipes-v1";
        // the page's own words, in the order kernel_page_hot answers them
        def fgr-heat(r) = nth(r, 0);
        def fgr-name(r) = nth(r, 1);
        def fgr-unit(r) = nth(r, 2);
        def fgr-line(r) = nth(r, 3);
        def fgr-col(r) = nth(r, 4);
        def fgr-boxes(r) = nth(r, 5);
        def fgr-unboxes(r) = nth(r, 6);
        def fgr-native(r) = nth(r, 7);
        def fgr-mints(r) = nth(r, 8);
        def fgr-folds(r) = nth(r, 9);
        def fgr-row?(r) = if lt(len(r), 10) then 0 else 1;
        // -1 declined, 0 cold, 1 leaf, 2 loop, 3 twin -- the seed's own numbering
        def fgr-lane(r) = if eq(fgr-native(r), 0) then "walking" else if eq(fgr-native(r), 1) then "leaf" else if eq(fgr-native(r), 2) then "loop" else if eq(fgr-native(r), 3) then "twin" else "declined";
        def fgr-crystallized?(r) = if gt(fgr-native(r), 0) then 1 else 0;

        // ---- reading a kernel whole ------------------------------------------
        // The width asked for is larger than any recipe table, so the page
        // answers everything it has; the door clamps to what exists and that
        // clamp is the only bound. Before 2026-09-10 this read sixty-four and
        // said nothing about the rest.
        field FGRAll = 99999;
        def fgr-of-kernel(pid) = kernel_page_hot(pid, FGRAll());
        def fgr-of-self() = kernel_hot_rows(FGRAll());

        // ---- the shape of the distribution -----------------------------------
        def fgr-mass(rs) = if eq(len(rs), 0) then 0 else add(fgr-heat(head(rs)), fgr-mass(tail(rs)));
        def fgr-take(rs, n) = if or(eq(n, 0), eq(len(rs), 0)) then list() else cons(head(rs), fgr-take(tail(rs), sub(n, 1)));
        // parts per thousand, so a reader sees 880 rather than a ratio it has to
        // divide itself; a total of nothing answers 0 and never divides by it
        def fgr-share(part, whole) = if le(whole, 0) then 0 else div(mul(part, 1000), whole);
        def fgr-concentration(rs) {
            let whole = fgr-mass(rs);
            list(FGRSchema(), len(rs), whole,
                 fgr-share(fgr-mass(fgr-take(rs, 1)), whole),
                 fgr-share(fgr-mass(fgr-take(rs, 8)), whole),
                 fgr-share(fgr-mass(fgr-take(rs, 64)), whole),
                 fgr-share(fgr-mass(fgr-take(rs, 256)), whole));
        }
        def fgr-conc-recipes(c) = nth(c, 1);
        def fgr-conc-mass(c) = nth(c, 2);
        def fgr-conc-top1(c) = nth(c, 3);
        def fgr-conc-top8(c) = nth(c, 4);
        def fgr-conc-top64(c) = nth(c, 5);
        def fgr-conc-top256(c) = nth(c, 6);
        // There was a fgr-headed? here that answered 1 when the first eight
        // carried half the mass. Its first live reading was 489 per thousand --
        // eight recipes out of 835 carrying 48.9% of forty-two billion
        // dispatches -- and it answered 0, eleven parts in ten thousand from
        // its own cut. A boolean cannot be one part short of true.
        //
        // So the door hands back the number. 489 is what a reader needs, and
        // whether that is a head worth a local fix is a judgement about the
        // change being considered, not a property of the distribution.
        def fgr-head-share(c) = fgr-conc-top8(c);

        // ---- the histograms ---------------------------------------------------
        def fgr-by-unit(rs, h) = if eq(len(rs), 0) then h else fgr-by-unit(tail(rs), fgx-bump(h, fgr-unit(head(rs)), fgr-heat(head(rs))));
        def fgr-by-lane(rs, h) = if eq(len(rs), 0) then h else fgr-by-lane(tail(rs), fgx-bump(h, fgr-lane(head(rs)), fgr-heat(head(rs))));
        def fgr-by-boxes(rs, h) = if eq(len(rs), 0) then h else fgr-by-boxes(tail(rs), fgx-bump(h, fgr-unit(head(rs)), fgr-boxes(head(rs))));
        def fgr-by-mints(rs, h) = if eq(len(rs), 0) then h else fgr-by-mints(tail(rs), fgx-bump(h, fgr-unit(head(rs)), fgr-mints(head(rs))));
        def fgr-by-folds(rs, h) = if eq(len(rs), 0) then h else fgr-by-folds(tail(rs), fgx-bump(h, fgr-unit(head(rs)), fgr-folds(head(rs))));
        // dispatches per box: a recipe called ten million times that boxes once
        // is not the arena's problem, however hot it reads
        def fgr-box-mass(rs) = if eq(len(rs), 0) then 0 else add(fgr-boxes(head(rs)), fgr-box-mass(tail(rs)));
        def fgr-fold-mass(rs) = if eq(len(rs), 0) then 0 else add(fgr-folds(head(rs)), fgr-fold-mass(tail(rs)));

        // ---- where a change would pay ------------------------------------------
        // The heaviest recipe no lane has taken. Heat inside a crystallized body
        // is already spent as this machine's own instructions; heat in a walking
        // or declined one is heat the interpreter is still carrying, and that is
        // the only place a rewrite or a lane can change the number.
        def fgr-walking(rs) = if eq(len(rs), 0) then list() else if eq(fgr-crystallized?(head(rs)), 1) then fgr-walking(tail(rs)) else cons(head(rs), fgr-walking(tail(rs)));
        def fgr-heaviest(rs, held) = if eq(len(rs), 0) then held else if eq(len(held), 0) then fgr-heaviest(tail(rs), head(rs)) else if gt(fgr-heat(head(rs)), fgr-heat(held)) then fgr-heaviest(tail(rs), head(rs)) else fgr-heaviest(tail(rs), held);
        def fgr-attention(rs) = fgr-heaviest(fgr-walking(rs), list());
        def fgr-walking-mass(rs) = fgr-mass(fgr-walking(rs));
        // what share of everything dispatched is still being walked
        def fgr-walking-share(rs) = fgr-share(fgr-walking-mass(rs), fgr-mass(rs));
    }
    0;
}
