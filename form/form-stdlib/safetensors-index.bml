// Safetensors metadata stays in Form; tensor payloads remain mapped by the owner.
// preludes: form-stdlib/safetensors-header.fk form-stdlib/json.fk form-stdlib/metal-door.fk
section [form.bml] {
 class FormSafetensorsIndex {
  def sti-value(obj, key) = node_value(json-object-get(obj, key));
  def sti-values(nodes) = if nil?(nodes) then [] else cons(node_value(head(nodes)), sti-values(tail(nodes)));
  def sti-product(shape) = if nil?(shape) then 1 else if (head(shape) <= 0) then 0 else (head(shape) * sti-product(tail(shape)));
  def sti-width(dtype) = if (((String) dtype == "F32") || ((String) dtype == "U32")) then 4 else if (((String) dtype == "F16") || ((String) dtype == "BF16")) then 2 else if ((String) dtype == "I64") then 8 else 0;
  // row = name, dtype, dimensions, absolute offset, extent
  def sti-row(pair, base, size) {
   let obj = json-pair-value(pair);
   let shape = sti-values(json-array-elements(json-object-get(obj, "shape")));
   let offsets = sti-values(json-array-elements(json-object-get(obj, "data_offsets")));
   let dtype = sti-value(obj, "dtype");
   if (!((Comparable) len(offsets) == 2)) then form_error("safetensors offsets need two integers") else sti-row-at(json-pair-key(pair), dtype, shape, offsets, base, size);
  }
  def sti-row-at(name, dtype, shape, offsets, base, size) {
   let count = sti-product(shape);
   let bytes = (count * sti-width(dtype));
   let begin = head(offsets);
   let end = offsets[1];
   if ((bytes <= 0) || ((begin < 0) || ((!((Comparable) (end - begin) == bytes)) || ((base + end) > size)))) then form_error(str_concat("safetensors tensor extent/dtype refused: ", name)) else [name, dtype, shape, (base + begin), bytes];
  }
  def sti-rows(pairs, base, size) = if nil?(pairs) then [] else if ((String) json-pair-key(head(pairs)) == "__metadata__") then sti-rows(tail(pairs), base, size) else cons(sti-row(head(pairs), base, size), sti-rows(tail(pairs), base, size));
  def sti-open(path) {
   let size = file_size(path);
   let prefix = read_file_slice(path, 0, 8);
   if ((size < 10) || (nothing?(prefix) || (!((Comparable) str_len(prefix) == 8)))) then form_error("safetensors file/header absent") else sti-open-sized(path, size, sfh-header-len(prefix));
  }
  def sti-open-sized(path, size, length) {
   if ((length <= 0) || ((length + 8) > size)) then form_error("safetensors header extent refused") else sti-open-header(path, size, length, read_file_slice(path, 8, length));
  }
  def sti-open-header(path, size, length, text) {
   if (nothing?(text) || (!((Comparable) str_len(text) == length))) then form_error("safetensors header incomplete") else [path, (length + 8), sti-rows(json-object-pairs(parse-json(path, text)), (length + 8), size)];
  }
  def sti-find-in(rows, name) = if nil?(rows) then [] else if ((String) head(head(rows)) == name) then head(rows) else sti-find-in(tail(rows), name);
  def sti-find(index, name) = sti-find-in(index[2], name);
  def sti-map(index, name) = sti-map-row(index, sti-find(index, name));
  def sti-map-row(index, row) = if nil?(row) then form_error("safetensors required tensor absent") else sti-map-held(metal_buf_from_file(head(index), row[3], row[4]), row);
  def sti-map-held(handle, row) = if (handle <= 0) then form_error("safetensors shared mapping refused") else [handle, row[2], row[1]];
 }
 0;
}
