// Safetensors metadata stays in Form; tensor payloads remain mapped by the owner.
import form-stdlib/safetensors-header.fk;
import form-stdlib/json.fk;
import form-stdlib/metal-door.fk;
section [form.bml] {
 class FormSafetensorsIndex {
  def sti-value(obj, key) = node_value(json-object-get(obj, key));
  def sti-values(nodes) = nodes |> map(node => node_value(node));
  def sti-product(shape) = nil?(shape) ? 1 : shape[0] <= 0 ? 0 : (shape[0] * sti-product(shape[1:]));
  def sti-width(dtype) = ((String) dtype == "F32") || ((String) dtype == "U32") ? 4 : ((String) dtype == "F16") || ((String) dtype == "BF16") ? 2 : (String) dtype == "I64" ? 8 : 0;
  // row = name, dtype, dimensions, absolute offset, extent
  def sti-row(pair, base, size) {
   let obj = json-pair-value(pair);
   let shape = sti-values(json-array-elements(json-object-get(obj, "shape")));
   let offsets = sti-values(json-array-elements(json-object-get(obj, "data_offsets")));
   let dtype = sti-value(obj, "dtype");
   !((Comparable) len(offsets) == 2) ? form_error("safetensors offsets need two integers") : sti-row-at(json-pair-key(pair), dtype, shape, offsets, base, size);
  }
  def sti-row-at(name, dtype, shape, offsets, base, size) {
   let count = sti-product(shape);
   let bytes = count * sti-width(dtype);
   let begin = offsets[0];
   let end = offsets[1];
   (bytes <= 0) || ((begin < 0) || ((!((Comparable) (end - begin) == bytes)) || ((base + end) > size))) ? form_error("safetensors tensor extent/dtype refused: " + name) : [name, dtype, shape, base + begin, bytes];
  }
  def sti-rows(pairs, base, size) = nil?(pairs) ? [] : (String) json-pair-key(pairs[0]) == "__metadata__" ? sti-rows(pairs[1:], base, size) : cons(sti-row(pairs[0], base, size), sti-rows(pairs[1:], base, size));
  def sti-open(path) {
   let size = file_size(path);
   let prefix = read_file_slice(path, 0, 8);
   (size < 10) || (nothing?(prefix) || (!((Comparable) len(prefix) == 8))) ? form_error("safetensors file/header absent") : sti-open-sized(path, size, sfh-header-len(prefix));
  }
  def sti-open-sized(path, size, length) {
   (length <= 0) || ((length + 8) > size) ? form_error("safetensors header extent refused") : sti-open-header(path, size, length, read_file_slice(path, 8, length));
  }
  def sti-open-header(path, size, length, text) {
   nothing?(text) || (!((Comparable) len(text) == length)) ? form_error("safetensors header incomplete") : [path, length + 8, sti-rows(json-object-pairs(parse-json(path, text)), length + 8, size)];
  }
  def sti-find-in(rows, name) = nil?(rows) ? [] : (String) rows[0][0] == name ? rows[0] : sti-find-in(rows[1:], name);
  def sti-find(index, name) = sti-find-in(index[2], name);
  def sti-map(index, name) = sti-map-row(index, sti-find(index, name));
  def sti-map-row(index, row) = nil?(row) ? form_error("safetensors required tensor absent") : sti-map-held(metal_buf_from_file(index[0], row[3], row[4]), row);
  def sti-map-held(handle, row) = handle <= 0 ? form_error("safetensors shared mapping refused") : [handle, row[2], row[1]];
 }
 0;
}
