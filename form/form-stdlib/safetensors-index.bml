// Safetensors metadata stays in Form; tensor payloads remain mapped by the owner.
// preludes: form-stdlib/safetensors-header.fk form-stdlib/json.fk form-stdlib/metal-door.fk
section [form.bml] {
 class FormSafetensorsIndex {
  def sti-value(obj, key) = node_value(json-object-get(obj, key));
  def sti-values(nodes) = nil?(nodes) ? list() : cons(node_value(head(nodes)), sti-values(tail(nodes)));
  def sti-product(shape) = nil?(shape) ? 1 : head(shape) <= 0 ? 0 : (head(shape) * sti-product(tail(shape)));
  def sti-width(dtype) = match (String) dtype { "F32" | "U32" => 4, "F16" | "BF16" => 2, "I64" => 8, _ => 0 };
  // row = name, dtype, dimensions, absolute offset, extent
  def sti-row(pair, base, size) {
   let obj = json-pair-value(pair);
   let shape = sti-values(json-array-elements(json-object-get(obj, "shape")));
   let offsets = sti-values(json-array-elements(json-object-get(obj, "data_offsets")));
   let dtype = sti-value(obj, "dtype");
   !((Comparable) len(offsets) == 2) ? form_error("safetensors offsets need two integers") : sti-row-at(json-pair-key(pair), dtype, shape, offsets, base, size);
  }
  def sti-row-at(name, dtype, shape, offsets, base, size) {
   let count = sti-product(shape);
   let bytes = count * sti-width(dtype);
   let [begin, end] = offsets;
   (bytes <= 0) || ((begin < 0) || ((!((Comparable) (end - begin) == bytes)) || ((base + end) > size))) ? form_error("safetensors tensor extent/dtype refused: " ++ name) : list(name, dtype, shape, base + begin, bytes);
  }
  def sti-rows(pairs, base, size) = nil?(pairs) ? list() : (String) json-pair-key(head(pairs)) == "__metadata__" ? sti-rows(tail(pairs), base, size) : cons(sti-row(head(pairs), base, size), sti-rows(tail(pairs), base, size));
  def sti-open(path) {
   let size = file_size(path);
   let prefix = read_file_slice(path, 0, 8);
   (size < 10) || (nothing?(prefix) || (!((Comparable) str_len(prefix) == 8))) ? form_error("safetensors file/header absent") : sti-open-sized(path, size, sfh-header-len(prefix));
  }
  def sti-open-sized(path, size, length) {
   (length <= 0) || ((length + 8) > size) ? form_error("safetensors header extent refused") : sti-open-header(path, size, length, read_file_slice(path, 8, length));
  }
  def sti-open-header(path, size, length, text) {
   nothing?(text) || (!((Comparable) str_len(text) == length)) ? form_error("safetensors header incomplete") : list(path, length + 8, sti-rows(json-object-pairs(parse-json(path, text)), length + 8, size));
  }
  def sti-find-in(rows, name) = nil?(rows) ? list() : (String) head(head(rows)) == name ? head(rows) : sti-find-in(tail(rows), name);
  def sti-find(index, name) = sti-find-in(index[2], name);
  def sti-map(index, name) = sti-map-row(index, sti-find(index, name));
  def sti-map-row(index, row) = nil?(row) ? form_error("safetensors required tensor absent") : sti-map-held(metal_buf_from_file(head(index), row[3], row[4]), row);
  def sti-map-held(handle, row) = handle <= 0 ? form_error("safetensors shared mapping refused") : list(handle, row[2], row[1]);
 }
 0;
}
