// form-cli-request.fk — invocation-owned ask/trace envelopes and canonical batch
// semantic embedding for the standalone native CLI.
//
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/str-byte-at.fk
// preludes: form-stdlib/sha256.fk form-stdlib/hmac-sha256.fk form-stdlib/hex.fk
// preludes: form-stdlib/text-tokenize.fk form-stdlib/rag-embed.fk
// preludes: form-stdlib/rag-index-codec.fk form-stdlib/rag-retrieve.fk
// preludes: form-stdlib/rag-ask.fk form-stdlib/form-cli-staged-trace.fk
//
// A validated request id maps only to relative paths under:
//   .coherence-network/rag-requests/<id>.query
//   .coherence-network/rag-requests/<id>.receipt
//   .coherence-network/rag-requests/<id>.embed
// This removes the shared rag-query association race and avoids receipt bytes in
// argv. ask-request-trace reads the exact query once, binds its SHA-256 into the
// protected attestation, selects one hit, and verifies against actual native time.
//
// embed-request is the sole semantic-v2 authoring door. Its input is one
// `<id_hex>|<utf8_text_hex>` row per line. Its deterministic JSONL output reuses
// re-semantic-vec directly, so consumers never mirror the lexicon/hash/stem/rank.
section [form.bml] {
    def fcr-request-root() = ".coherence-network/rag-requests/";
    def fcr-key-path() = ".coherence-network/attestation/grounding-v1.key";
    def fcr-max-id-bytes() = 128;
    // Questions are UTF-8 text, not an unbounded file ingestion door. Receipts
    // contain eighteen bounded identifiers/digests plus one witness key. These
    // limits are part of the native request contract and are proven at exactly
    // max and max+1 by the standalone carrier gate.
    def fcr-max-query-bytes() = 8192;
    def fcr-max-receipt-bytes() = 16384;
    // Measured current corpus: 1,546 rows / 5,736,270 staged bytes. 16 MiB keeps
    // the whole deterministic batch failure-atomic with nearly 3x headroom while
    // retaining a hard allocation/DoS boundary.
    def fcr-max-embed-bytes() = 16777216;
    def fcr-id-byte-valid?(b) = b >= 48 && b <= 57 || (b >= 65 && b <= 90 || (b >= 97 && b <= 122 || ((Comparable) b == 45 || (Comparable) b == 95))) ? 1 : 0;
    def fcr-id-valid-loop(id, i) = i >= str_len(id) ? 1 : (Comparable) fcr-id-byte-valid?(str_byte_at(id, i)) == 1 ? fcr-id-valid-loop(id, i + 1) : 0;
    def fcr-id-valid?(id) = str_len(id) > 0 && (str_len(id) <= fcr-max-id-bytes() && (Comparable) fcr-id-valid-loop(id, 0) == 1) ? 1 : 0;
    def fcr-path(id, suffix) = str_concat(fcr-request-root(), str_concat(id, suffix));
    def fcr-query-path(id) = fcr-path(id, ".query");
    def fcr-receipt-path(id) = fcr-path(id, ".receipt");
    def fcr-consuming-receipt-path(id) = fcr-path(id, ".receipt.consuming");
    def fcr-embed-path(id) = fcr-path(id, ".embed");
    def fcr-embed-output-path(id) = fcr-path(id, ".embed.output");
    def fcr-strip-last-byte-if(s, code) = {
        let n = str_len(s);
        n > 0 && (Comparable) str_byte_at(s, n - 1) == code ? substring(s, 0, n - 1) : s;
    };
    def fcr-strip-eol(s) = fcr-strip-last-byte-if(fcr-strip-last-byte-if(s, 10), 13);
    def fcr-text-has-nul?(s) = str_find(s, byte_to_str(0), 0) >= 0 ? 1 : 0;
    def fcr-now-seconds() = now_unix_ms() / 1000;
    def fcr-hit-for-query(query) = ra-grounded-hit-at(ra-default-index(), query);
    def fcr-ask-request(id) = (Comparable) fcr-id-valid?(id) == 0 ? "ask-request:error:invalid-id" : {
        let query-path = fcr-query-path(id);
        let query-size = file_size(query-path);
        query-size > fcr-max-query-bytes() ? "ask-request:error:query-too-large" : {
            let query0 = read_file(query-path);
            let query = nothing?(query0) ? "" : query0;
            (Comparable) str_len(query) == 0 ? "ask-request:error:missing-query" : (Comparable) fcr-text-has-nul?(query) == 1 ? "ask-request:error:invalid-query" : {
                let hit = fcr-hit-for-query(query);
                let output = ra-hit-output(hit);
                (String) output == "grounded:miss" ? "[ask: local fkwu RAG index has no grounded hit]" : output;
            };
        };
    };
    def fcr-trace-for-request-at(hit, receipt, request-id, query, key-hex, now) = fcast-trace-hit-for-at(hit, receipt, request-id, fcast-query-key(query), key-hex, now);
    def fcr-trace-for-query-at(hit, receipt, query, key-hex, now) = fcr-trace-for-request-at(hit, receipt, "test-request", query, key-hex, now);
    def fcr-query-trace-at(index-text, query, receipt, key-hex, now) = {
        let hit = ra-stream-hit(index-text, query);
        fcr-trace-for-query-at(hit, receipt, query, key-hex, now);
    };
    def fcr-finish-consume(query-path, consuming-path, result) = {
        let removed-receipt = fs_remove(consuming-path);
        let removed-query = fs_remove(query-path);
        result;
    };
    def fcr-ask-request-trace(id) = (Comparable) fcr-id-valid?(id) == 0 ? "ask-request-trace:error:invalid-id" : {
        let receipt-path = fcr-receipt-path(id);
        let consuming-path = fcr-consuming-receipt-path(id);
        let moved = fs_rename(receipt-path, consuming-path);
        !((Comparable) moved == 0) ? "ask-request-trace:error:missing-receipt" : {
            let query-path = fcr-query-path(id);
            let query-size = file_size(query-path);
            let receipt-size = file_size(consuming-path);
            // Permit at most one terminal CRLF beyond the logical
            // receipt cap; the stripped payload is checked again below.
            query-size > fcr-max-query-bytes() ? fcr-finish-consume(query-path, consuming-path, "ask-request-trace:error:query-too-large") : receipt-size > fcr-max-receipt-bytes() + 2 ? fcr-finish-consume(query-path, consuming-path, "ask-request-trace:error:receipt-too-large") : {
                let query0 = read_file(query-path);
                let query = nothing?(query0) ? "" : query0;
                (Comparable) str_len(query) == 0 ? fcr-finish-consume(query-path, consuming-path, "ask-request-trace:error:missing-query") : (Comparable) fcr-text-has-nul?(query) == 1 ? fcr-finish-consume(query-path, consuming-path, "ask-request-trace:error:invalid-query") : {
                    let receipt = fcr-strip-eol(read_file(consuming-path));
                    str_len(receipt) > fcr-max-receipt-bytes() ? fcr-finish-consume(query-path, consuming-path, "ask-request-trace:error:receipt-too-large") : (Comparable) fcr-text-has-nul?(receipt) == 1 ? fcr-finish-consume(query-path, consuming-path, "ask-request-trace:error:invalid-receipt") : {
                        // Derive the query binding before
                        // any key/index host read.
                        let query-key = fcast-query-key(query);
                        let hit = fcr-hit-for-query(query);
                        let key-hex = fcr-strip-eol(read_file(fcr-key-path()));
                        fcr-finish-consume(query-path, consuming-path, fcast-trace-hit-for-at(hit, receipt, id, query-key, key-hex, fcr-now-seconds()));
                    };
                };
            };
        };
    };
    def fcr-ask-request-debug(id) = (Comparable) fcr-id-valid?(id) == 0 ? "ask-request-debug:error:invalid-id" : {
        let query-path = fcr-query-path(id);
        let receipt-path = fcr-receipt-path(id);
        file_size(query-path) > fcr-max-query-bytes() ? "ask-request-debug:error:query-too-large" : file_size(receipt-path) > fcr-max-receipt-bytes() + 2 ? "ask-request-debug:error:receipt-too-large" : {
            let query = read_file(query-path);
            let receipt = fcr-strip-eol(read_file(receipt-path));
            (Comparable) str_len(query) == 0 ? "ask-request-debug:error:missing-query" : (Comparable) fcr-text-has-nul?(query) == 1 ? "ask-request-debug:error:invalid-query" : str_len(receipt) > fcr-max-receipt-bytes() ? "ask-request-debug:error:receipt-too-large" : (Comparable) fcr-text-has-nul?(receipt) == 1 ? "ask-request-debug:error:invalid-receipt" : {
                let query-key = fcast-query-key(query);
                let hit = fcr-hit-for-query(query);
                let key-hex = fcr-strip-eol(read_file(fcr-key-path()));
                fcast-grounding-debug-for-at(hit, receipt, id, query-key, key-hex, fcr-now-seconds());
            };
        };
    };
    // ── canonical batch semantic embedding ──
    def fcr-embed-separator(line) = str_find(line, "|", 0);
    def fcr-embed-id-hex(line) = {
        let at = fcr-embed-separator(line);
        at < 0 ? "" : substring(line, 0, at);
    };
    def fcr-embed-text-hex(line) = {
        let at = fcr-embed-separator(line);
        at < 0 ? "" : substring(line, at + 1, str_len(line));
    };
    def fcr-embed-line-valid?(line) = {
        let at = fcr-embed-separator(line);
        let id-hex = fcr-embed-id-hex(line);
        let text-hex = fcr-embed-text-hex(line);
        at > 0 && (str_find(line, "|", at + 1) < 0 && (str_len(id-hex) > 0 && (str_len(text-hex) > 0 && ((Comparable) hex-valid?(id-hex) == 1 && (Comparable) hex-valid?(text-hex) == 1)))) ? 1 : 0;
    };
    // The semantic-v2 tokenizer intentionally recognizes ASCII letters and
    // digits only. Decode the staged text hex directly into that projection so
    // an emitted carrier never materializes arbitrary UTF-8 byte strings merely
    // to discard their bytes as delimiters. This preserves the exact re-words
    // meaning while avoiding the host string-release wedge exposed by long
    // ornament runs in real Markdown/Form sources.
    def fcr-embed-ascii-byte?(b) = b >= 65 && b <= 90 || (b >= 97 && b <= 122 || b >= 48 && b <= 57) ? 1 : 0;
    def fcr-embed-lower-byte(b) = b >= 65 && b <= 90 ? b + 32 : b;
    def fcr-embed-words-from-hex-loop(s, i, n, cur, rev-words) = i >= n ? re-rev-into((String) cur == "" ? rev-words : cons(cur, rev-words), empty()) : {
        let hi = hex-digit-value(hex-byte-at(s, i));
        let lo = hex-digit-value(hex-byte-at(s, i + 1));
        let b = hi * 16 + lo;
        (Comparable) fcr-embed-ascii-byte?(b) == 1 ? fcr-embed-words-from-hex-loop(s, i + 2, n, str_concat(cur, byte_to_str(fcr-embed-lower-byte(b))), rev-words) : fcr-embed-words-from-hex-loop(s, i + 2, n, "", (String) cur == "" ? rev-words : cons(cur, rev-words));
    };
    def fcr-embed-words-from-hex(s) = fcr-embed-words-from-hex-loop(s, 0, str_len(s), "", empty());
    def fcr-embed-semantic-vec-from-hex(s) = re-semantic-codes(re-semantic-words(fcr-embed-words-from-hex(s)));
    def fcr-embed-effective-end(raw) = {
        let n = str_len(raw);
        n > 0 && (Comparable) str_byte_at(raw, n - 1) == 10 ? n - 1 : n;
    };
    // Split near the byte midpoint at a native-scanned LF. Balanced ranges keep
    // emitted-walker depth logarithmic for production JSONL instead of one Form
    // frame per corpus row. If the midpoint lands in the final large row, fall
    // back to the range's first LF; a no-LF range is exactly one logical row.
    def fcr-embed-range-split(raw, start, end) = {
        let mid = (start + end) / 2;
        let after-mid = scan_run(raw, mid, 5);
        after-mid < end ? after-mid : scan_run(raw, start, 5);
    };
    def fcr-embed-range-valid?(raw, start, end) = start >= end ? 0 : {
        let split = fcr-embed-range-split(raw, start, end);
        split >= end ? fcr-embed-line-valid?(substring(raw, start, end)) : (Comparable) fcr-embed-range-valid?(raw, start, split) == 0 ? 0 : fcr-embed-range-valid?(raw, split + 1, end);
    };
    def fcr-embed-input-valid?(raw) = {
        let end = fcr-embed-effective-end(raw);
        end > 0 && (Comparable) fcr-embed-range-valid?(raw, 0, end) == 1 ? 1 : 0;
    };
    def fcr-embed-json-row(line) = {
        let id-hex = fcr-embed-id-hex(line);
        str_concat("{\"id_hex\":\"", str_concat(id-hex, str_concat("\",\"embedding_kind\":\"form-semantic-v2\",\"vec\":", str_concat(ric-emit-vec(fcr-embed-semantic-vec-from-hex(fcr-embed-text-hex(line))), "}"))));
    };
    def fcr-embed-output-loop(raw, pos, raw-len, first) = pos >= raw-len ? "" : {
        let line-end = scan_run(raw, pos, 5);
        let next-pos = line-end < raw-len ? line-end + 1 : raw-len;
        let line = substring(raw, pos, line-end);
        (Comparable) str_len(line) == 0 ? fcr-embed-output-loop(raw, next-pos, raw-len, first) : str_concat((Comparable) first == 1 ? "" : "\n", str_concat(fcr-embed-json-row(line), fcr-embed-output-loop(raw, next-pos, raw-len, 0)));
    };
    def fcr-embed-output(raw) = (Comparable) fcr-embed-input-valid?(raw) == 0 ? "embed-request:error:invalid-row" : fcr-embed-output-loop(raw, 0, str_len(raw), 1);
    // The pure fcr-embed-output above remains useful for small recipe values.
    // A production batch cannot build one output by nesting a str_concat around
    // every input row: the emitted walker would retain every recursive frame.
    // The live door validates the whole input first, then streams canonical rows
    // through a request-owned file in bounded byte chunks and reads the completed
    // response once. The final stdout contract is identical.
    def fcr-string-byte-range(s, i, end) = i >= end ? empty() : cons(str_byte_at(s, i), fcr-string-byte-range(s, i + 1, end));
    def fcr-append-string-loop(path, s, pos, n) = pos >= n ? 0 : {
        let end = n - pos > 512 ? pos + 512 : n;
        let wrote = file_append_bytes(path, fcr-string-byte-range(s, pos, end));
        wrote < 0 ? 1 : fcr-append-string-loop(path, s, end, n);
    };
    def fcr-append-string(path, s) = fcr-append-string-loop(path, s, 0, str_len(s));
    def fcr-embed-write-one(raw, start, end, first, output-path) = {
        let row = fcr-embed-json-row(substring(raw, start, end));
        let prefix-status = (Comparable) first == 1 ? 0 : fcr-append-string(output-path, "\n");
        !((Comparable) prefix-status == 0) ? 1 : fcr-append-string(output-path, row);
    };
    def fcr-embed-write-range(raw, start, end, first, output-path) = {
        let split = fcr-embed-range-split(raw, start, end);
        split >= end ? fcr-embed-write-one(raw, start, end, first, output-path) : {
            let left-status = fcr-embed-write-range(raw, start, split, first, output-path);
            !((Comparable) left-status == 0) ? 1 : fcr-embed-write-range(raw, split + 1, end, 0, output-path);
        };
    };
    def fcr-embed-file-output(id, raw) = {
        let output-path = fcr-embed-output-path(id);
        let removed-stale = fs_remove(output-path);
        let created = write_file(output-path, "");
        created < 0 ? "embed-request:error:output-write" : {
            let status = fcr-embed-write-range(raw, 0, fcr-embed-effective-end(raw), 1, output-path);
            // Return the host-read value as the terminal expression.
            // Removing the backing path before the emitted walker had
            // printed that value yielded an empty response. Retaining one
            // request-owned materialization is bounded (the next call
            // truncates it) and also leaves an inspectable recovery copy.
            (Comparable) status == 0 ? read_file(output-path) : "embed-request:error:output-write";
        };
    };
    def fcr-embed-request(id) = (Comparable) fcr-id-valid?(id) == 0 ? "embed-request:error:invalid-id" : {
        let path = fcr-embed-path(id);
        let size = file_size(path);
        size <= 0 ? "embed-request:error:missing-input" : size > fcr-max-embed-bytes() ? "embed-request:error:input-too-large" : {
            let raw = read_file(path);
            (Comparable) fcr-embed-input-valid?(raw) == 0 ? "embed-request:error:invalid-row" : fcr-embed-file-output(id, raw);
        };
    };
    0;
}
