//////////////////////////////////////////////////////////////////////
// Executable qwen4exp graph contract.
// Authority: form-stdlib/qwen4exp-flash-next-graph.bml
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class Qwen4ExpFlashNextGraphAuthority {
        field Q4GraphAuthorityPath = "form/form-stdlib/qwen4exp-flash-next-graph.bml";
        field Q4GraphAuthorityKind = "high-bml-interface-class-const";
    }

    class Qwen4ExpFlashNextGraph {
        field Q4Layers = 48;
        field Q4Width = 2560;
        field Q4HyperStreams = 4;
        field Q4HyperWidth = 10240;
        field Q4HyperLowRank = 320;
        field Q4FullAttentionInterval = 4;
        field Q4FullAttentionHeads = 24;
        field Q4KVHeads = 2;
        field Q4HeadWidth = 256;
        field Q4RopeWidth = 64;
        field Q4GDNInner = 6144;
        field Q4GDNKeyHeads = 16;
        field Q4GDNValueHeads = 48;
        field Q4GDNStateWidth = 128;
        field Q4Experts = 512;
        field Q4SelectedExperts = 10;
        field Q4ExpertWidth = 640;
        field Q4IndexerHeads = 4;
        field Q4IndexerHeadWidth = 128;
        field Q4IndexerTopK = 2048;
        field Q4PLELayer = 1;
        field Q4PLENgram = 3;
        field Q4PLEHeadsPerNgram = 8;
        field Q4PLEHeads = 16;
        field Q4PLEHeadWidth = 160;
        field Q4PLEConvKernel = 4;
        field Q4PLEHistory = 9;
        field Q4NativeContext = 262144;
        field Q4TargetContext = 358400;

        ref q4g-authority = Qwen4ExpFlashNextGraphAuthority;
        thought q4g-order = ["embed-repeat-hc", "optional-ple", "hc-attn-mix", "attention", "hc-combine", "hc-ffn-mix", "top10-moe-plus-shared", "hc-combine", "head-hc-mix", "vocab"];

        def q4g-full(layer) = (Comparable) ((layer + 1) % Q4FullAttentionInterval()) == 0 ? 1 : 0;
        def q4g-ple(layer) = (Comparable) layer == Q4PLELayer() ? 1 : 0;
        def q4g-linear-layers() = Q4Layers() - (Q4Layers() / Q4FullAttentionInterval());
        def q4g-full-layers() = Q4Layers() / Q4FullAttentionInterval();
        def q4g-qsa-width(kvTokens, ratio) = kvTokens < (Q4IndexerTopK() + (ratio - 1)) ? kvTokens : (Q4IndexerTopK() + (ratio - 1));
        def q4g-expert-base(expert, rows, cols) = expert * (rows * cols);
        def q4g-ple-heads() = (Q4PLENgram() - 1) * Q4PLEHeadsPerNgram();
        def q4g-ple-history() = (Q4PLEConvKernel() - 1) * Q4PLENgram();
        def q4g-hc-scatter-zero() = 1;

        def q4g-bit(ok, bit) = ok ? bit : 0;
        def q4g-check() {
            let c0 = q4g-bit((Comparable) q4g-full(0) == 0 ? ((Comparable) q4g-full(3) == 1 ? ((Comparable) q4g-full(47) == 1 ? 1 : 0) : 0) : 0, 1);
            let c1 = q4g-bit((Comparable) q4g-linear-layers() == 36 ? ((Comparable) q4g-full-layers() == 12) : 0, 2);
            let c2 = q4g-bit((Comparable) q4g-ple(1) == 1 ? ((Comparable) q4g-ple(0) == 0 ? ((Comparable) q4g-ple(2) == 0) : 0) : 0, 4);
            let c3 = q4g-bit((Comparable) q4g-ple-heads() == Q4PLEHeads() ? ((Comparable) q4g-ple-history() == Q4PLEHistory()) : 0, 8);
            let c4 = q4g-bit((Comparable) q4g-qsa-width(1000, 4) == 1000 ? ((Comparable) q4g-qsa-width(9000, 4) == 2051 ? ((Comparable) q4g-qsa-width(9000, 64) == 2111) : 0) : 0, 16);
            let c5 = q4g-bit((Comparable) q4g-expert-base(9, 640, 2560) == 14745600 ? ((Comparable) q4g-expert-base(511, 2560, 640) == 837222400) : 0, 32);
            let c6 = q4g-bit((Comparable) Q4HyperWidth() == (Q4Width() * Q4HyperStreams()) ? ((Comparable) Q4GDNInner() == (Q4GDNValueHeads() * Q4GDNStateWidth()) ? 1 : 0) : 0, 64);
            let c7 = q4g-bit((Comparable) (Q4FullAttentionHeads() * Q4HeadWidth()) == 6144 ? ((Comparable) (Q4KVHeads() * Q4HeadWidth()) == 512) : 0, 128);
            let c8 = q4g-bit((Comparable) q4g-hc-scatter-zero() == 1, 256);
            c0 + (c1 + (c2 + (c3 + (c4 + (c5 + (c6 + (c7 + c8)))))));
        }
    }
    0;
}
