// public-source-concept-key-routes.fk -- exact concept-key routing over the
// persisted public-source concept shards without scanning every source record.
//
// This is a derived routing organ, not a flattened concept table and not an
// operations table.  A concept key chooses one SHA-256 bucket.  Inside it,
// every source coordinate owns one independently replaceable bounded reference
// file.  Ambiguous keys therefore retain every candidate while lookup returns
// exact nothing; no candidate wins by directory order.
//
// References retain the registry's durable source-content and entry-content
// keys.  A hit is offered only after the referenced .psci artifact parses,
// reconstructs the original PSCI source/entry NodeIDs, matches both retained
// content keys, and re-observes the current source bytes.  Missing, malformed,
// changed, colliding, over-wide, or timed-out evidence is refusal, never a hit.
//
// Incremental upsert writes the new references before dissolving old-only
// references, then advances the per-source manifest.  A failed write undoes
// the just-offered new references.  Repeating the same offer is idempotent.
// Dissolve releases only references owned by that source coordinate.
//
// No top-level effect lives here.  The pure transition and lookup surfaces are
// proven without opening a file.  The effectful functions remain explicit
// doors for the proposed bounded driver.
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
// preludes: form-stdlib/bmf-core.fk form-stdlib/form-fs.fk
// preludes: form-stdlib/file-byte-window.fk form-stdlib/sha256.fk
// preludes: form-stdlib/hex.fk form-stdlib/form-knowledge-source-search.fk
// preludes: form-stdlib/public-source-concept-index.fk
// preludes: form-stdlib/public-source-concept-shards.fk
section [form.bml] {
    def psckr-schema() = "public-source-concept-key-routes-v1";
    def psckr-reference-schema() = "psckr-reference-v1";
    def psckr-manifest-schema() = "psckr-source-manifest-v1";
    def psckr-result-schema() = "psckr-lookup-result-v1";
    def psckr-max-reference-bytes() = 2048;
    def psckr-max-manifest-bytes() = 2048;
    def psckr-max-candidates() = 64;
    def psckr-read-window() = 512;
    // ---- content-addressed route coordinates ----------------------------
    def psckr-key-hash(key) = hex-encode(sha256-stream-string(key));
    def psckr-coordinate-hash(family, path) = hex-encode(sha256-stream-string(pscish-join(list(family, pscish-string-hex(path)), "|")));
    def psckr-store-root(artifact) = fs-path-join(artifact, "concept-key-routes-v1");
    def psckr-routes-root(artifact) = fs-path-join(psckr-store-root(artifact), "routes");
    def psckr-manifests-root(artifact) = fs-path-join(psckr-store-root(artifact), "manifests");
    def psckr-key-prefix(key) = substring(psckr-key-hash(key), 0, 2);
    def psckr-key-bucket-at(artifact, key) = {
        let hash = psckr-key-hash(key);
        fs-path-join(fs-path-join(psckr-routes-root(artifact), substring(hash, 0, 2)), hash);
    };
    def psckr-reference-path-at(artifact, key, family, path) = fs-path-join(psckr-key-bucket-at(artifact, key), str_concat(psckr-coordinate-hash(family, path), ".route"));
    def psckr-manifest-family-root(artifact, family) = fs-path-join(psckr-manifests-root(artifact), family);
    def psckr-manifest-bucket-root(artifact, family, path) = {
        // Match the committed source shard's path-hash bucket so a live
        // report can compare one bounded source bucket with one manifest
        // bucket without inventing a second traversal coordinate.
        let hash = pscish-path-hash(path);
        fs-path-join(psckr-manifest-family-root(artifact, family), substring(hash, 0, 2));
    };
    def psckr-manifest-path-at(artifact, family, path) = fs-path-join(psckr-manifest-bucket-root(artifact, family, path), str_concat(pscish-path-hash(path), ".manifest"));
    // ---- bounded reference codec ----------------------------------------
    // reference = schema key key-hash family path source-content-key
    //             entry-content-key
    def psckr-content-key-valid?(key) = !((Comparable) str_len(key) == 64) ? 0 : hex-valid?(key);
    def psckr-reference(key, family, path, source-key, entry-key) = list(psckr-reference-schema(), key, psckr-key-hash(key), family, path, source-key, entry-key);
    def psckr-reference-key(r) = nth(r, 1);
    def psckr-reference-key-hash(r) = nth(r, 2);
    def psckr-reference-family(r) = nth(r, 3);
    def psckr-reference-path(r) = nth(r, 4);
    def psckr-reference-source-key(r) = nth(r, 5);
    def psckr-reference-entry-key(r) = nth(r, 6);
    def psckr-reference-valid?(r) = !((Comparable) len(r) == 7) ? 0 : !((String) nth(r, 0) == psckr-reference-schema()) ? 0 : (Comparable) psci-concept-key-valid?(psckr-reference-key(r)) == 0 ? 0 : !((String) psckr-reference-key-hash(r) == psckr-key-hash(psckr-reference-key(r))) ? 0 : (Comparable) psci-path-valid-for-family?(psckr-reference-path(r), psckr-reference-family(r)) == 0 ? 0 : (Comparable) psckr-content-key-valid?(psckr-reference-source-key(r)) == 0 ? 0 : psckr-content-key-valid?(psckr-reference-entry-key(r));
    def psckr-reference-from-record(record, key) = !((Comparable) len(record) == 13) || ((Comparable) pscish-key-member?(key, pscish-record-keys(record)) == 0 || (Comparable) psci-concept-key-valid?(key) == 0) ? empty() : psckr-reference(key, pscish-record-family(record), pscish-record-path(record), pscish-record-source-content-key(record), pscish-record-entry-content-key(record));
    def psckr-render-reference(r) = (Comparable) psckr-reference-valid?(r) == 0 ? "" : pscish-join(list(psckr-reference-schema(), pscish-string-hex(psckr-reference-key(r)), psckr-reference-key-hash(r), psckr-reference-family(r), pscish-string-hex(psckr-reference-path(r)), psckr-reference-source-key(r), psckr-reference-entry-key(r)), "|");
    def psckr-parse-reference(text) = str_len(text) > psckr-max-reference-bytes() ? empty() : {
        let f = pscish-split(text, "|");
        !((Comparable) len(f) == 7) ? empty() : {
            let r = list(nth(f, 0), pscish-hex-string(nth(f, 1)), nth(f, 2), nth(f, 3), pscish-hex-string(nth(f, 4)), nth(f, 5), nth(f, 6));
            (Comparable) psckr-reference-valid?(r) == 1 ? r : empty();
        };
    };
    // The filesystem door bounds each complete reference before it reaches this
    // scannerless reader.  `psckr-cursor-fold` remains the generic incremental
    // cursor shape, while the complete held artifact is admitted once below;
    // rebuilding it one byte at a time retained recursive prefixes in the
    // emitted carrier and returned route-reference-timeout for a current row.
    // scan = status reason text position trace
    def psckr-cursor-fold(cursor, fuel, out) = (Comparable) cur-eof?(cursor) == 1 ? list("ready", "complete", out, cur-pos(cursor), list("choice", "cut", "release")) : fuel <= 0 ? list("timeout", "cursor-step-budget", out, cur-pos(cursor), list("choice", "timeout", "cut", "undo", "refine", "release")) : psckr-cursor-fold(cur-advance(cursor, 1), fuel - 1, str_concat(out, byte_to_str(cur-peek(cursor))));
    def psckr-consume-reference(text, fuel) = {
        let observed = str_len(text);
        fuel <= 0 ? list("timeout", "cursor-step-budget", "", 0, list("choice", "timeout", "cut", "undo", "refine", "release")) : observed > fuel ? list("timeout", "cursor-step-budget", substring(text, 0, fuel), fuel, list("choice", "timeout", "cut", "undo", "refine", "release")) : (Comparable) len(psckr-parse-reference(text)) == 7 ? list("ready", "complete", text, observed, list("choice", "cut", "release")) : list("failure", "invalid-route-reference", text, observed, list("choice", "failure", "cut", "undo", "refine", "release"));
    };
    // ---- per-source manifest codec --------------------------------------
    // manifest = schema family path source-content-key entry-content-key keys
    def psckr-manifest(family, path, source-key, entry-key, keys) = list(psckr-manifest-schema(), family, path, source-key, entry-key, keys);
    def psckr-manifest-family(m) = nth(m, 1);
    def psckr-manifest-path(m) = nth(m, 2);
    def psckr-manifest-source-key(m) = nth(m, 3);
    def psckr-manifest-entry-key(m) = nth(m, 4);
    def psckr-manifest-keys(m) = nth(m, 5);
    def psckr-manifest-valid?(m) = !((Comparable) len(m) == 6) ? 0 : !((String) nth(m, 0) == psckr-manifest-schema()) ? 0 : (Comparable) psci-path-valid-for-family?(psckr-manifest-path(m), psckr-manifest-family(m)) == 0 ? 0 : (Comparable) psckr-content-key-valid?(psckr-manifest-source-key(m)) == 0 ? 0 : (Comparable) psckr-content-key-valid?(psckr-manifest-entry-key(m)) == 0 ? 0 : psci-concept-keys-valid?(psckr-manifest-keys(m));
    def psckr-manifest-from-record(record) = !((Comparable) len(record) == 13) ? empty() : psckr-manifest(pscish-record-family(record), pscish-record-path(record), pscish-record-source-content-key(record), pscish-record-entry-content-key(record), pscish-record-keys(record));
    def psckr-render-manifest(m) = (Comparable) psckr-manifest-valid?(m) == 0 ? "" : pscish-join(list(psckr-manifest-schema(), psckr-manifest-family(m), pscish-string-hex(psckr-manifest-path(m)), psckr-manifest-source-key(m), psckr-manifest-entry-key(m), pscish-join(psckr-manifest-keys(m), ",")), "|");
    def psckr-parse-manifest(text) = str_len(text) > psckr-max-manifest-bytes() ? empty() : {
        let f = pscish-split(text, "|");
        !((Comparable) len(f) == 6) ? empty() : {
            let m = list(nth(f, 0), nth(f, 1), pscish-hex-string(nth(f, 2)), nth(f, 3), nth(f, 4), pscish-split(nth(f, 5), ","));
            (Comparable) psckr-manifest-valid?(m) == 1 ? m : empty();
        };
    };
    // ---- pure incremental reference movement ---------------------------
    def psckr-same-coordinate?(a, b) = (String) psckr-reference-family(a) == psckr-reference-family(b) && (String) psckr-reference-path(a) == psckr-reference-path(b) ? 1 : 0;
    def psckr-without-coordinate(refs, ref) = nil?(refs) ? empty() : (Comparable) psckr-same-coordinate?(head(refs), ref) == 1 ? psckr-without-coordinate(tail(refs), ref) : cons(head(refs), psckr-without-coordinate(tail(refs), ref));
    def psckr-upsert-reference(refs, ref) = (Comparable) psckr-reference-valid?(ref) == 0 ? refs : cons(ref, psckr-without-coordinate(refs, ref));
    def psckr-dissolve-reference(refs, ref) = (Comparable) psckr-reference-valid?(ref) == 0 ? refs : psckr-without-coordinate(refs, ref);
    def psckr-references-for-keys(record, keys) = nil?(keys) ? empty() : cons(psckr-reference-from-record(record, head(keys)), psckr-references-for-keys(record, tail(keys)));
    def psckr-keys-not-in(keys, held) = nil?(keys) ? empty() : (Comparable) pscish-key-member?(head(keys), held) == 1 ? psckr-keys-not-in(tail(keys), held) : cons(head(keys), psckr-keys-not-in(tail(keys), held));
    // transition = schema status reason old-manifest new-manifest add-refs
    //              dissolve-keys trace
    def psckr-transition(old-manifest, record) = {
        let next = psckr-manifest-from-record(record);
        (Comparable) psckr-manifest-valid?(next) == 0 ? list(psckr-schema(), "failure", "invalid-source-record", old-manifest, empty(), empty(), empty(), list("choice", "failure", "cut", "undo", "refine", "release")) : {
            let old-keys = (Comparable) psckr-manifest-valid?(old-manifest) == 1 ? psckr-manifest-keys(old-manifest) : empty();
            let new-keys = psckr-manifest-keys(next);
            let dissolve = psckr-keys-not-in(old-keys, new-keys);
            list(psckr-schema(), "ready", "incremental-source-upsert", old-manifest, next, psckr-references-for-keys(record, new-keys), dissolve, list("choice", "cut", "refine", "release"));
        };
    };
    def psckr-transition-status(t) = nth(t, 1);
    def psckr-transition-reason(t) = nth(t, 2);
    def psckr-transition-old(t) = nth(t, 3);
    def psckr-transition-next(t) = nth(t, 4);
    def psckr-transition-adds(t) = nth(t, 5);
    def psckr-transition-dissolves(t) = nth(t, 6);
    def psckr-transition-trace(t) = nth(t, 7);
    def psckr-transition-undo(t) = !((String) psckr-transition-status(t) == "ready") ? t : list(psckr-schema(), "undo", "offered-transition-released", psckr-transition-next(t), psckr-transition-old(t), empty(), (Comparable) psckr-manifest-valid?(psckr-transition-next(t)) == 1 ? psckr-manifest-keys(psckr-transition-next(t)) : empty(), list("choice", "cut", "undo", "refine", "release"));
    // ---- pure candidate resolution --------------------------------------
    def psckr-record-same-coordinate?(record, ref) = (String) pscish-record-family(record) == psckr-reference-family(ref) && (String) pscish-record-path(record) == psckr-reference-path(ref) ? 1 : 0;
    def psckr-find-record(records, ref) = nil?(records) ? empty() : (Comparable) len(head(records)) == 13 && (Comparable) psckr-record-same-coordinate?(head(records), ref) == 1 ? head(records) : psckr-find-record(tail(records), ref);
    def psckr-reference-current-for-record?(ref, record) = !((Comparable) len(record) == 13) ? 0 : (String) psckr-reference-source-key(ref) == pscish-record-source-content-key(record) && (String) psckr-reference-entry-key(ref) == pscish-record-entry-content-key(record) ? 1 : 0;
    // accumulator = current-count first-record stale missing invalid
    def psckr-resolve-reference(key, ref, records, acc) = (Comparable) psckr-reference-valid?(ref) == 0 || !((String) psckr-reference-key(ref) == key) ? list(nth(acc, 0), nth(acc, 1), nth(acc, 2), nth(acc, 3), nth(acc, 4) + 1) : {
        let record = psckr-find-record(records, ref);
        (Comparable) len(record) == 0 ? list(nth(acc, 0), nth(acc, 1), nth(acc, 2), nth(acc, 3) + 1, nth(acc, 4)) : (Comparable) psckr-reference-current-for-record?(ref, record) == 0 ? list(nth(acc, 0), nth(acc, 1), nth(acc, 2) + 1, nth(acc, 3), nth(acc, 4)) : list(nth(acc, 0) + 1, (Comparable) nth(acc, 0) == 0 ? record : nth(acc, 1), nth(acc, 2), nth(acc, 3), nth(acc, 4));
    };
    def psckr-resolve-references(key, refs, records, acc) = nil?(refs) ? acc : psckr-resolve-references(key, tail(refs), records, psckr-resolve-reference(key, head(refs), records, acc));
    // result = schema status reason key family path source-id fresh rebuild
    //          match-count source-node entry-node source-key entry-key trace
    //          lookup-count model-executed stale missing invalid
    def psckr-result(status, reason, key, record, fresh, rebuild, matches, trace, stale, missing, invalid) = {
        let valid = (Comparable) len(record) == 13 ? 1 : 0;
        list(psckr-result-schema(), status, reason, key, (Comparable) valid == 1 ? pscish-record-family(record) : "", (Comparable) valid == 1 ? pscish-record-path(record) : "", (Comparable) valid == 1 ? pscish-record-source-id(record) : "", fresh, rebuild, matches, (Comparable) valid == 1 ? pscish-record-source(record) : psci-absent-node(), (Comparable) valid == 1 ? pscish-record-entry(record) : psci-absent-node(), (Comparable) valid == 1 ? pscish-record-source-content-key(record) : "", (Comparable) valid == 1 ? pscish-record-entry-content-key(record) : "", trace, 1, 0, stale, missing, invalid);
    };
    def psckr-result-status(r) = nth(r, 1);
    def psckr-result-reason(r) = nth(r, 2);
    def psckr-result-key(r) = nth(r, 3);
    def psckr-result-family(r) = nth(r, 4);
    def psckr-result-path(r) = nth(r, 5);
    def psckr-result-source-id(r) = nth(r, 6);
    def psckr-result-fresh?(r) = nth(r, 7);
    def psckr-result-rebuild?(r) = nth(r, 8);
    def psckr-result-match-count(r) = nth(r, 9);
    def psckr-result-source(r) = nth(r, 10);
    def psckr-result-entry(r) = nth(r, 11);
    def psckr-result-source-key(r) = nth(r, 12);
    def psckr-result-entry-key(r) = nth(r, 13);
    def psckr-result-trace(r) = nth(r, 14);
    def psckr-result-lookup-count(r) = nth(r, 15);
    def psckr-result-model-executed?(r) = nth(r, 16);
    def psckr-result-stale(r) = nth(r, 17);
    def psckr-result-missing(r) = nth(r, 18);
    def psckr-result-invalid(r) = nth(r, 19);
    def psckr-trace-has?(trace, action) = nil?(trace) ? 0 : (String) head(trace) == action ? 1 : psckr-trace-has?(tail(trace), action);
    def psckr-result-from-acc(key, acc) = {
        let current = nth(acc, 0);
        let record = nth(acc, 1);
        let stale = nth(acc, 2);
        let missing = nth(acc, 3);
        let invalid = nth(acc, 4);
        stale + (missing + invalid) > 0 ? psckr-result("nothing", "route-reference-refused", key, empty(), 0, 1, current, list("choice", "cut", "undo", "refine", "release"), stale, missing, invalid) : (Comparable) current == 0 ? psckr-result("nothing", "concept-not-routed", key, empty(), 0, 0, 0, list("choice", "cut", "release"), 0, 0, 0) : current > 1 ? psckr-result("nothing", "ambiguous-concept-key", key, empty(), 0, 0, current, list("choice", "cut", "undo", "refine", "release"), 0, 0, 0) : psckr-result("hit", "current-content-addressed-route", key, record, 1, 0, 1, list("choice", "cut", "release"), 0, 0, 0);
    };
    def psckr-resolve-pure(key, refs, records) = (Comparable) psci-concept-key-valid?(key) == 0 ? psckr-result("nothing", "invalid-concept-key", "", empty(), 0, 0, 0, list("choice", "failure", "cut", "undo", "refine", "release"), 0, 0, 1) : psckr-result-from-acc(key, psckr-resolve-references(key, refs, records, list(0, empty(), 0, 0, 0)));
    // ---- explicit bounded filesystem doors ------------------------------
    def psckr-read-bounded-reference-at(path) = {
        let size = fs-stat-size(path);
        size < 0 ? list("missing", "route-reference-missing", empty()) : size > psckr-max-reference-bytes() ? list("timeout", "route-reference-over-window", empty()) : {
            let text = fs-read-slice(path, 0, size);
            let scan = psckr-consume-reference(text, psckr-max-reference-bytes());
            !((String) nth(scan, 0) == "ready") ? list(nth(scan, 0), nth(scan, 1), empty()) : {
                let r = psckr-parse-reference(nth(scan, 2));
                (Comparable) len(r) == 7 ? list("ready", "current-reference", r) : list("failure", "invalid-route-reference", empty());
            };
        };
    };
    def psckr-read-bounded-manifest-at(path) = {
        let size = fs-stat-size(path);
        size < 0 ? empty() : size > psckr-max-manifest-bytes() ? empty() : psckr-parse-manifest(fs-read-slice(path, 0, size));
    };
    def psckr-read-source-record-at(source-artifact, family, path) = {
        let target = pscish-entry-artifact-path(source-artifact, family, path);
        let size = fs-stat-size(target);
        size < 0 || size > psckr-max-reference-bytes() ? empty() : pscish-parse-entry(fs-read-slice(target, 0, size));
    };
    def psckr-ensure-reference-dirs(artifact, key) = {
        let _store = fs-mkdir(psckr-store-root(artifact));
        let _routes = fs-mkdir(psckr-routes-root(artifact));
        let _prefix = fs-mkdir(fs-path-join(psckr-routes-root(artifact), psckr-key-prefix(key)));
        let _bucket = fs-mkdir(psckr-key-bucket-at(artifact, key));
        1;
    };
    def psckr-ensure-manifest-dirs(artifact, family, path) = {
        let _store = fs-mkdir(psckr-store-root(artifact));
        let _manifests = fs-mkdir(psckr-manifests-root(artifact));
        let _family = fs-mkdir(psckr-manifest-family-root(artifact, family));
        let _bucket = fs-mkdir(psckr-manifest-bucket-root(artifact, family, path));
        1;
    };
    // write result = ok collision/failure
    def psckr-write-reference-at(artifact, ref) = (Comparable) psckr-reference-valid?(ref) == 0 ? list(0, 0) : {
        let key = psckr-reference-key(ref);
        let family = psckr-reference-family(ref);
        let path = psckr-reference-path(ref);
        let _dirs = psckr-ensure-reference-dirs(artifact, key);
        let target = psckr-reference-path-at(artifact, key, family, path);
        let held = psckr-read-bounded-reference-at(target);
        (String) nth(held, 0) == "ready" && (!((String) psckr-reference-family(nth(held, 2)) == family) || !((String) psckr-reference-path(nth(held, 2)) == path)) ? list(0, 1) : fs-write-text(target, psckr-render-reference(ref)) > 0 ? list(1, 0) : list(0, 0);
    };
    def psckr-release-reference-at(artifact, ref) = (Comparable) psckr-reference-valid?(ref) == 0 ? 0 : {
        let target = psckr-reference-path-at(artifact, psckr-reference-key(ref), psckr-reference-family(ref), psckr-reference-path(ref));
        let held = psckr-read-bounded-reference-at(target);
        !((String) nth(held, 0) == "ready") ? 0 : (String) psckr-reference-family(nth(held, 2)) == psckr-reference-family(ref) && (String) psckr-reference-path(nth(held, 2)) == psckr-reference-path(ref) ? fs-remove-file(target) : 0;
    };
    def psckr-write-references-loop(artifact, refs, written, failures, collisions) = nil?(refs) ? list(written, failures, collisions) : {
        let outcome = psckr-write-reference-at(artifact, head(refs));
        (Comparable) nth(outcome, 0) == 0 ? list(written, failures + ((Comparable) nth(outcome, 1) == 0 ? 1 : 0), collisions + nth(outcome, 1)) : psckr-write-references-loop(artifact, tail(refs), cons(head(refs), written), failures, collisions);
    };
    def psckr-release-references-loop(artifact, refs, released) = nil?(refs) ? released : psckr-release-references-loop(artifact, tail(refs), released + (psckr-release-reference-at(artifact, head(refs)) > 0 ? 1 : 0));
    def psckr-release-old-keys-loop(artifact, old-manifest, keys, released) = nil?(keys) ? released : {
        let ref = psckr-reference(head(keys), psckr-manifest-family(old-manifest), psckr-manifest-path(old-manifest), psckr-manifest-source-key(old-manifest), psckr-manifest-entry-key(old-manifest));
        psckr-release-old-keys-loop(artifact, old-manifest, tail(keys), released + (psckr-release-reference-at(artifact, ref) > 0 ? 1 : 0));
    };
    // outcome = schema status reason writes dissolves undos refinements
    //           releases collisions trace
    def psckr-upsert-record-at(route-artifact, record) = {
        let next = psckr-manifest-from-record(record);
        (Comparable) psckr-manifest-valid?(next) == 0 ? list(psckr-schema(), "failure", "invalid-source-record", 0, 0, 0, 1, 0, 0, list("choice", "failure", "cut", "undo", "refine", "release")) : {
            let manifest-path = psckr-manifest-path-at(route-artifact, psckr-manifest-family(next), psckr-manifest-path(next));
            let old = psckr-read-bounded-manifest-at(manifest-path);
            let transition = psckr-transition(old, record);
            let offered = psckr-write-references-loop(route-artifact, psckr-transition-adds(transition), empty(), 0, 0);
            let failures = nth(offered, 1);
            let collisions = nth(offered, 2);
            failures + collisions > 0 ? {
                let undone = psckr-release-references-loop(route-artifact, nth(offered, 0), 0);
                list(psckr-schema(), "nothing", "route-upsert-undone", len(nth(offered, 0)), 0, undone, 1, undone, collisions, list("choice", "failure", "cut", "undo", "refine", "release"));
            } : {
                let dissolved = (Comparable) psckr-manifest-valid?(old) == 1 ? psckr-release-old-keys-loop(route-artifact, old, psckr-transition-dissolves(transition), 0) : 0;
                let _dirs = psckr-ensure-manifest-dirs(route-artifact, psckr-manifest-family(next), psckr-manifest-path(next));
                let wrote-manifest = fs-write-text(manifest-path, psckr-render-manifest(next));
                wrote-manifest <= 0 ? list(psckr-schema(), "nothing", "manifest-advance-failed", len(nth(offered, 0)), dissolved, 0, 1, dissolved, 0, list("choice", "cut", "undo", "refine", "release")) : list(psckr-schema(), "hit", "incremental-source-upserted", len(nth(offered, 0)), dissolved, 0, 0, dissolved, 0, list("choice", "cut", "refine", "release"));
            };
        };
    };
    def psckr-dissolve-source-at(route-artifact, family, path) = {
        let manifest-path = psckr-manifest-path-at(route-artifact, family, path);
        let manifest = psckr-read-bounded-manifest-at(manifest-path);
        (Comparable) psckr-manifest-valid?(manifest) == 0 ? list(psckr-schema(), "nothing", "source-route-not-held", 0, 0, 0, 0, 0, 0, list("choice", "cut", "release")) : {
            let released = psckr-release-old-keys-loop(route-artifact, manifest, psckr-manifest-keys(manifest), 0);
            let manifest-released = fs-remove-file(manifest-path);
            list(psckr-schema(), "hit", "source-route-dissolved", 0, released, 0, 0, released + (manifest-released > 0 ? 1 : 0), 0, list("choice", "cut", "dissolve", "release"));
        };
    };
    // ---- exact one-concept filesystem lookup ----------------------------
    def psckr-route-file-names(names, acc) = nil?(names) ? acc : psckr-route-file-names(tail(names), (Comparable) psci-ends-with?(head(names), ".route") == 1 ? cons(head(names), acc) : acc);
    // inspection = status reason record
    def psckr-inspect-reference-at(root, source-artifact, path, key) = {
        let bounded = psckr-read-bounded-reference-at(path);
        !((String) nth(bounded, 0) == "ready") ? list(nth(bounded, 0), nth(bounded, 1), empty()) : {
            let ref = nth(bounded, 2);
            !((String) psckr-reference-key(ref) == key) ? list("failure", "bucket-key-mismatch", empty()) : {
                let record = psckr-read-source-record-at(source-artifact, psckr-reference-family(ref), psckr-reference-path(ref));
                (Comparable) len(record) == 0 ? list("missing", "source-artifact-missing", empty()) : (Comparable) psckr-reference-current-for-record?(ref, record) == 0 ? list("stale", "source-artifact-key-changed", empty()) : {
                    let v = pscish-validate-source-at(root, source-artifact, pscish-record-family(record), pscish-record-path(record));
                    (Comparable) nth(v, 0) == 1 ? list("current", "current", record) : (Comparable) nth(v, 2) == 1 ? list("missing", "source-unavailable", empty()) : list("stale", "source-rebuild-needed", empty());
                };
            };
        };
    };
    // accumulator = current-count first-record stale missing invalid timeout
    def psckr-inspect-path-acc(inspection, acc) = {
        let status = nth(inspection, 0);
        (String) status == "current" ? list(nth(acc, 0) + 1, (Comparable) nth(acc, 0) == 0 ? nth(inspection, 2) : nth(acc, 1), nth(acc, 2), nth(acc, 3), nth(acc, 4), nth(acc, 5)) : (String) status == "stale" ? list(nth(acc, 0), nth(acc, 1), nth(acc, 2) + 1, nth(acc, 3), nth(acc, 4), nth(acc, 5)) : (String) status == "missing" ? list(nth(acc, 0), nth(acc, 1), nth(acc, 2), nth(acc, 3) + 1, nth(acc, 4), nth(acc, 5)) : (String) status == "timeout" ? list(nth(acc, 0), nth(acc, 1), nth(acc, 2), nth(acc, 3), nth(acc, 4), nth(acc, 5) + 1) : list(nth(acc, 0), nth(acc, 1), nth(acc, 2), nth(acc, 3), nth(acc, 4) + 1, nth(acc, 5));
    };
    def psckr-inspect-files-loop(root, source-artifact, bucket, names, key, acc) = nil?(names) ? acc : psckr-inspect-files-loop(root, source-artifact, bucket, tail(names), key, psckr-inspect-path-acc(psckr-inspect-reference-at(root, source-artifact, fs-path-join(bucket, head(names)), key), acc));
    def psckr-lookup-at(root, source-artifact, route-artifact, key) = (Comparable) psci-concept-key-valid?(key) == 0 ? psckr-result("nothing", "invalid-concept-key", "", empty(), 0, 0, 0, list("choice", "failure", "cut", "undo", "refine", "release"), 0, 0, 1) : {
        let bucket = psckr-key-bucket-at(route-artifact, key);
        !((Comparable) fs-is-dir?(bucket) == 1) ? psckr-result("nothing", "concept-not-routed", key, empty(), 0, 0, 0, list("choice", "cut", "release"), 0, 0, 0) : {
            let names = psckr-route-file-names(fs-list(bucket), empty());
            len(names) > psckr-max-candidates() ? psckr-result("nothing", "candidate-window-timeout", key, empty(), 0, 1, len(names), list("choice", "timeout", "cut", "undo", "refine", "release"), 0, 0, 0) : {
                let acc = psckr-inspect-files-loop(root, source-artifact, bucket, names, key, list(0, empty(), 0, 0, 0, 0));
                nth(acc, 5) > 0 ? psckr-result("nothing", "route-reference-timeout", key, empty(), 0, 1, nth(acc, 0), list("choice", "timeout", "cut", "undo", "refine", "release"), nth(acc, 2), nth(acc, 3), nth(acc, 4)) : psckr-result-from-acc(key, list(nth(acc, 0), nth(acc, 1), nth(acc, 2), nth(acc, 3), nth(acc, 4)));
            };
        };
    };
    0;
}
