// all-life-north-star.fk — provable recipes for the highest all-life direction.
//
// The north star is not a slogan. It is a gateable invariant:
//
//   increase the weakest life-good first, across every scale, only through
//   movements that are sovereign, reversible, witnessed, non-extractive, and
//   measured.
//
// The five life-goods come from grammars/living-equation.fk:
// health, vitality, flexibility, sovereignty, harmony. A candidate action
// benefits all life only when no good is lowered, every proof gate is present,
// and the score is the after-state's weakest good. This makes extraction lose
// even when it raises a local metric.
//
// preludes: form-stdlib/core.fk form-stdlib/grammars/living-equation.fk
section [form.bml] {
    def aln-north-star() = "all-life-vitality-through-sovereign-coherence";
    def aln-state(health, vitality, flexibility, sovereignty, harmony) = [health, vitality, flexibility, sovereignty, harmony];
    def aln-gates(sovereign, reversible, witnessed, nonextractive, measured) = [sovereign, reversible, witnessed, nonextractive, measured];
    def aln-min2(a, b) = a > b ? b : a;
    def aln-state-min(state) = aln-min2(aln-min2(aln-min2(aln-min2(state[0], state[1]), state[2]), state[3]), state[4]);
    def aln-balanced?(state) = aln-state-min(state) >= 7 ? 1 : 0;
    def aln-weakest-good(state) = (Comparable) state[0] == aln-state-min(state) ? "health" : (Comparable) state[1] == aln-state-min(state) ? "vitality" : (Comparable) state[2] == aln-state-min(state) ? "flexibility" : (Comparable) state[3] == aln-state-min(state) ? "sovereignty" : "harmony";
    def aln-primary-lever(good) = liv-recipe-of-change("whole", good);
    def aln-path-for-good(good) = (String) good == "health" ? "structure:restore-conditions" : (String) good == "vitality" ? "choices:circulate-life-force" : (String) good == "flexibility" ? "beliefs:open-repertoire" : (String) good == "sovereignty" ? "boundary:honor-offered-interface" : (String) good == "harmony" ? "witness:compose-relations" : "unknown";
    def aln-next-path(state) = (Comparable) aln-balanced?(state) == 1 ? "compose-next-scale" : aln-path-for-good(aln-weakest-good(state));
    def aln-no-good-lowered?(before, after) = after[0] >= before[0] && (after[1] >= before[1] && (after[2] >= before[2] && (after[3] >= before[3] && after[4] >= before[4]))) ? 1 : 0;
    def aln-gates?(gates) = (Comparable) gates[0] == 1 && ((Comparable) gates[1] == 1 && ((Comparable) gates[2] == 1 && ((Comparable) gates[3] == 1 && (Comparable) gates[4] == 1))) ? 1 : 0;
    def aln-action-score(before, after, gates) = (Comparable) aln-gates?(gates) == 1 ? (Comparable) aln-no-good-lowered?(before, after) == 1 ? aln-state-min(after) : 0 : 0;
    def aln-choose(before, after-a, gates-a, after-b, gates-b) = aln-action-score(before, after-a, gates-a) >= aln-action-score(before, after-b, gates-b) ? "a" : "b";
    def aln-path-for-scale(scale) = (String) scale == "cell" ? "cell:sense-health-offer-small-reversible-change" : (String) scale == "relation" ? "relation:honor-both-interfaces-record-receipt" : (String) scale == "community" ? "community:route-resources-to-weakest-good" : (String) scale == "ecosystem" ? "ecosystem:measure-regeneration-before-growth" : (String) scale == "technology" ? "technology:ports-health-reversible-choice" : (String) scale == "knowledge" ? "knowledge:honest-lane-proof-before-claim" : "unknown";
    def aln-ack-path(ack) = (Comparable) len(ack) == 0 ? "wait-witness-no-force" : (Comparable) head(ack) == 1 ? "cross-offer" : "do-not-cross";
    0;
}
