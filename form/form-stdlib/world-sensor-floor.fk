// Sensor descriptions, available-carrier inventory and mesh routing.
// A roster entry describes a capability; only supplied carrier names attest
// availability. Reading confidence and acquisition belong to that carrier.
// preludes: form-stdlib/core.fk form-stdlib/spatial-fusion.fk form-stdlib/confidence-weighted-vote.fk form-stdlib/mesh-sense-7w.fk form-stdlib/fused-observation.fk
section [form.bml] {
 class WorldSensorFloor {
  def wsf-sensor(name,plane) = list("world-sensor",name,"afferent",plane);
  def wsf-name(sensor): String = nth(sensor,1);
  def wsf-dir(sensor): String = nth(sensor,2);
  def wsf-plane(sensor): String = nth(sensor,3);
  def wsf-afferent?(sensor) = wsf-dir(sensor) == "afferent";
  def wsf-roster() = list(
   wsf-sensor("wifi","where"), wsf-sensor("bluetooth","who"),
   wsf-sensor("gps","where"), wsf-sensor("camera","what"),
   wsf-sensor("mic","who"), wsf-sensor("battery","vitality"),
   wsf-sensor("memory","vitality"), wsf-sensor("proximity","where"),
   wsf-sensor("magnetometer","where"), wsf-sensor("barometer","where"));
  def wsf-find(roster,name: String) = if nil?(roster) then empty else if wsf-name(head(roster)) == name then head(roster) else wsf-find(tail(roster),name);
  def wsf-plane-of(roster,name): String {
   let found = wsf-find(roster,name);
   if nil?(found) then "" else wsf-plane(found);
  }
  def wsf-route(sensor,value,confidence) = fo-reading(wsf-plane(sensor),value,wsf-name(sensor),confidence);
  def wsf-has?(names,name: String) {
   def matches(candidate: String) = candidate == name;
   any?(matches,names);
  }
  def wsf-missing(carriers,roster) {
   def absent(sensor) = !wsf-has?(carriers,wsf-name(sensor));
   map(wsf-name,filter(absent,roster));
  }
  def wsf-carried-count(carriers,roster) = len(roster) - len(wsf-missing(carriers,roster));
  def wsf-floor-complete?(carriers,roster) {
   let missing = wsf-missing(carriers,roster);
   list(if nil?(missing) then "floor-complete" else "floor-partial",len(roster) - len(missing),len(roster),missing);
  }
  def wfc-state(floor): String = nth(floor,0);
  def wfc-carried(floor) = nth(floor,1);
  def wfc-total(floor) = nth(floor,2);
  def wfc-missing(floor) = nth(floor,3);
  def wfc-complete?(floor) = wfc-state(floor) == "floor-complete";
  def wsf-fuse(readings) = fo-fuse(readings);
 }
}
