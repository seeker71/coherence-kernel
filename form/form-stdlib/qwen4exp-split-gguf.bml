//////////////////////////////////////////////////////////////////////
//
// qwen4exp-split-gguf.bml — executable split-carrier contract.
// Authority: form-stdlib/bml/qwen4exp-split-gguf.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class Qwen4ExpSplitGGUFAuthority {
        field Q4SplitAuthorityPath = "form/form-stdlib/bml/qwen4exp-split-gguf.bml";
        field Q4SplitAuthorityKind = "high-bml-interface-class-const";
    }

    class Qwen4ExpSplitGGUF {
        field Q4SplitCount = 3;
        field Q4MetadataShard = 1;
        field Q4FirstDataShard = 2;
        field Q4LastDataShard = 3;
        field Q4MetadataTensorCount = 0;
        field Q4Shard2TensorCount = 503;
        field Q4Shard3TensorCount = 721;
        field Q4TotalTensorCount = 1224;
        field Q4SplitAlignment = 32;

        ref q4s-authority = Qwen4ExpSplitGGUFAuthority;
        thought q4s-pattern = list("metadata-only-shard", "concrete-source-shard", "direct-metal-map", "no-logical-offset-fiction");

        // [status, shard, record-offset]. status -1 names a duplicate,
        // 0 a miss and 1 exactly one concrete source.
        def q4s-select(off2, off3) = if ge(off2, 0) then if ge(off3, 0) then list(-1, 0, -1) else list(1, 2, off2) else if ge(off3, 0) then list(1, 3, off3) else list(0, 0, -1);
        def q4s-selected(sel) = nth(sel, 0);
        def q4s-shard(sel) = nth(sel, 1);
        def q4s-selected-off(sel) = nth(sel, 2);

        // [status, shard, path, record-off, type, data-base, data-off,
        //  absolute-off, bytes].  The path and local absolute offset are
        // carried together so metal_buf_from_file never infers a shard.
        def q4s-record(status, shard, path, recordOff, ty, dataBase, dataOff, absoluteOff, bytes) = list(status, shard, path, recordOff, ty, dataBase, dataOff, absoluteOff, bytes);
        def q4s-record-status(r) = nth(r, 0);
        def q4s-record-shard(r) = nth(r, 1);
        def q4s-record-path(r) = nth(r, 2);
        def q4s-record-off(r) = nth(r, 3);
        def q4s-record-type(r) = nth(r, 4);
        def q4s-record-data-base(r) = nth(r, 5);
        def q4s-record-data-off(r) = nth(r, 6);
        def q4s-record-absolute(r) = nth(r, 7);
        def q4s-record-bytes(r) = nth(r, 8);
        def q4s-record-complete(r) = if eq(q4s-record-status(r), 1) then if ge(q4s-record-shard(r), Q4FirstDataShard()) then if le(q4s-record-shard(r), Q4LastDataShard()) then if gt(str_len(q4s-record-path(r)), 0) then if ge(q4s-record-off(r), 0) then if ge(q4s-record-data-base(r), 0) then if ge(q4s-record-data-off(r), 0) then if eq(q4s-record-absolute(r), add(q4s-record-data-base(r), q4s-record-data-off(r))) then if gt(q4s-record-bytes(r), 0) then 1 else 0 else 0 else 0 else 0 else 0 else 0 else 0 else 0 else 0;

        def q4s-bit(ok, bit) = if ok then bit else 0;
        def q4s-check() {
            let only2 = q4s-select(41, -1);
            let only3 = q4s-select(-1, 73);
            let miss = q4s-select(-1, -1);
            let dup = q4s-select(41, 73);
            let record = q4s-record(1, 3, "/model-00003-of-00003.gguf", 73, 20, 4096, 8192, 12288, 176640);
            let c0 = q4s-bit(if eq(q4s-selected(only2), 1) then if eq(q4s-shard(only2), 2) then eq(q4s-selected-off(only2), 41) else 0 else 0, 1);
            let c1 = q4s-bit(if eq(q4s-selected(only3), 1) then if eq(q4s-shard(only3), 3) then eq(q4s-selected-off(only3), 73) else 0 else 0, 2);
            let c2 = q4s-bit(if eq(q4s-selected(miss), 0) then eq(q4s-selected-off(miss), -1) else 0, 4);
            let c3 = q4s-bit(eq(q4s-selected(dup), -1), 8);
            let c4 = q4s-bit(q4s-record-complete(record), 16);
            let c5 = q4s-bit(eq(q4s-record-complete(q4s-record(1, 1, "/metadata.gguf", 0, 0, 0, 0, 0, 1)), 0), 32);
            let c6 = q4s-bit(if eq(add(Q4Shard2TensorCount(), Q4Shard3TensorCount()), Q4TotalTensorCount()) then if eq(Q4MetadataTensorCount(), 0) then 1 else 0 else 0, 64);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, c6))))));
        }
    }
    0;
}
