; form-cli-speaker-home-run.fk — seat speaker, seed A/B, print home.
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/form-fs.fk
; preludes: form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-planner-mint-xtal.fk
; preludes: form-stdlib/form-cli-lora-writer-xtal.fk
; preludes: form-stdlib/form-cli-speaker-home-xtal.fk

(do
    (let pair (flw-from-sample (fspk-fuel) (fqt-dim)))
    (let w (flw-write (AdapterPath) (nth pair 0) (nth pair 1)))
    (print_str (str_concat "fspk heldout=" (str_concat (int_to_str (fspk-heldout)) "/72\n")))
    (print_str (str_concat "fspk home=" (str_concat (int_to_str (fspk-home)) "\n")))
    (print_str (str_concat "fspk next-walk=" (str_concat (fspk-next (fpl-situation "walk-lane" "how" 0 (SplitHeldout))) "\n")))
    (print_str (str_concat "fspk act-tool=" (str_concat (int_to_str (fspk-act "tool-pick")) "\n")))
    (print_str (str_concat "fspk adapter=" (str_concat (int_to_str (flw-written (AdapterPath))) "\n")))
    (print_str (str_concat "fspk fqt-lora=" (str_concat (int_to_str (fqt-lora?)) "\n")))
    (print_str (str_concat "fspk native-voice=" (str_concat (int_to_str (NativeVoice)) "\n")))
    (print_str (str_concat "fspk need-events=" (str_concat (int_to_str (NeedEvents)) "\n")))
    (print_str (str_concat "fspk check=" (str_concat (int_to_str (fspk-check)) "\n")))
    0)
