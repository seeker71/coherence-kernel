; form-knowledge-bml-exec-adaptation-observation.fk -- retained local-only
; canonical form.bml continuation and replay evidence.
;
; `nothing` in execution/semantic fields means that stage was not reached.
; Present 0 means it was reached and failed.  Present 1 means it held.  The
; 59cb replay influenced the curriculum direction, so it retains zero heldout
; credit even though its original prompt and harness remain byte-identical.
;
; preludes: form-stdlib/core.fk form-stdlib/json.fk
; preludes: form-stdlib/str-byte-at.fk form-stdlib/sha256.fk form-stdlib/hex.fk
; preludes: form-stdlib/native-model-evidence.fk form-stdlib/bmf-core.fk
; preludes: form-stdlib/bmf-grammar.fk form-stdlib/grammars/form-bml.fk
; preludes: form-stdlib/form-knowledge-query-token.fk
; preludes: form-stdlib/form-knowledge-exec-diagnostic.fk
; preludes: form-stdlib/form-knowledge-exec-grammar-transport.fk
; preludes: form-stdlib/form-eval-full.fk
; preludes: form-stdlib/form-knowledge-bml-exec-finetune-curriculum.fk
;
; Proven by: form-stdlib/tests/form-knowledge-bml-exec-adaptation-observation-band.fk

(do
    (defn fkbefao-old-adapter-sha ()
        "4f4e7fdd66b1e9aeb6a3b4d3ced5f807f1cb6092250fb401288620fcc26810fc")
    (defn fkbefao-prompt-sha ()
        "dd60156498b9fec6d424b3e0ab89380ad0b5f196198775168aa3a60f99e67bb3")
    (defn fkbefao-v1-adapter-sha ()
        "9e17175b5fd0af906a5913afcdd19a703add26098adc6ff8880d0a8bc8a97346")
    (defn fkbefao-v2-adapter-sha ()
        "2a651472280cd09a06cd4fc5445e7e16ff0cfbbbd10bd701e587f1323d5e322c")
    (defn fkbefao-v2-train-sha ()
        "00786c0f827f90a967a33f59cfcd3bb010f6af2c4ad63ed7528cc5b6b93017d4")
    (defn fkbefao-v2-valid-sha ()
        "141c10174fddb351e666a969e1a919326f10871a6b3602f511bd17ac3cbccc05")
    (defn fkbefao-v2-test-sha ()
        "aa5d3b417a381fff35c8b22832c700690a759cb64148593a8470e09a6b780a02")

    (defn fkbefao-d2-response ()
        "(defn oac-nothing () (nothing))")
    (defn fkbefao-t1-response ()
        "def umbra-product(a,b) = add(a,b);\ndef umbra-main() = umbra-product(7,6);\n0;")
    (defn fkbefao-t2-response ()
        "def violet-pick(x) = if lt(x,10) then 42 else 0;\ndef violet-main() = violet-pick(8);\n0;")
    (defn fkbefao-v1-h1-response ()
        (fked-cat (list
            "def oac-nothing() = nothing();\n"
            "def oac-one(payload-node) = oac-one(payload-node);\n"
            "def oac-choice(alts,args) = if eq(alts,nothing()) then nothing();\n"
            "def oac-cut-with-receipt(alts,args) = if eq(alts,nothing()) then nothing();\n"
            "def oac-cut-receipt-ack(receipt) = receipt;\n"
            "def oac-cut-receipt-pruned() = nothing();\n0;")))
    (defn fkbefao-t3-response ()
        "def zeal-main() = zeal-shift(37);\n0;")
    (defn fkbefao-t4-response ()
        "def aether-main() = aether-undo(nothing(),13,87);\n0;")
    (defn fkbefao-v2-h1-response ()
        (fked-cat (list
            "def oac-nothing() = nothing();\n"
            "def oac-one(payload) = oac-payload(list(payload,1));\n"
            "def oac-choice(alts,args) = if eq(alts,nothing) then args;\n"
            "def oac-cut-with-receipt(alts,args) = alts;\n"
            "def oac-cut-receipt-ack(receipt) = receipt;\n"
            "def oac-cut-receipt-pruned(receipt) = receipt;\n"
            "def oac-undo(ack,checkpoint,memory) = checkpoint;\n"
            "def oac-timeout-walk(alts,args,budget) = list(ack,budget-left,alts-left);\n0;")))

    ; row = schema condition adapter prompt-sha response-sha prompt-tokens
    ;       response-tokens elapsed-ms parse lower execution semantic
    ;       heldout-credit http remote released failure
    (defn fkbefao-row (condition adapter prompt-sha response-sha response-tokens
                       elapsed parse lower execution semantic heldout failure)
        (list "form-bml-exec-adaptation-observation-v1" condition adapter
            prompt-sha response-sha 842 response-tokens elapsed parse
            lower execution semantic heldout 0 0 1 failure))
    (defn fkbefao-condition (row) (nth row 1))
    (defn fkbefao-adapter (row) (nth row 2))
    (defn fkbefao-response-sha (row) (nth row 4))
    (defn fkbefao-parse (row) (nth row 8))
    (defn fkbefao-lower (row) (nth row 9))
    (defn fkbefao-execution (row) (nth row 10))
    (defn fkbefao-semantic (row) (nth row 11))
    (defn fkbefao-heldout (row) (nth row 12))
    (defn fkbefao-http (row) (nth row 13))
    (defn fkbefao-remote (row) (nth row 14))
    (defn fkbefao-released (row) (nth row 15))

    (defn fkbefao-observations ()
        (list
            (fkbefao-row "D2-old-lora-grammar-current-source"
                (fkbefao-old-adapter-sha) (fkbefao-prompt-sha)
                "44c297b133618c5ee7a8928926fbab60430d100dfbad6978800015a34ecc318a"
                11 1407 0 (nothing) (nothing) (nothing) 0
                "direct-form-one-definition")
            (fkbefao-row "V1-T1-generic-executable"
                (fkbefao-v1-adapter-sha)
                "f96a34e323e8d768becb305c7ec8895f6c169fb6d1a14e5726bb8468eb5d2fe1"
                "7deb2e643f6857ab55ea1fd414cba0564ce273abea6f5dad246f07b1fdc2d127"
                29 427 1 1 1 0 0
                "parse-held-operation-add-not-mul")
            (fkbefao-row "V1-T2-generic-executable"
                (fkbefao-v1-adapter-sha)
                "9b2d0f85417696517fd3dd5f85eeb91d0f0d2321c6bdaaee46e5e21b6cc86fb8"
                "37ac49015b03f175204462242d1cdc7bf9f2c6802700d0f5f3ece683c98dad5d"
                34 460 1 1 1 1 0 "exact")
            (fkbefao-row "V1-H1-adaptive-59cb"
                (fkbefao-v1-adapter-sha) (fkbefao-prompt-sha)
                "1abf7c2222a24e79adf88d54d9a8ac86b1034e1d62977f832cd3c0c04e2d8980"
                93 1593 0 (nothing) (nothing) (nothing) 0
                "incomplete-if-redefined-supplied-apis")
            (fkbefao-row "V2-T1-regression"
                (fkbefao-v2-adapter-sha)
                "f96a34e323e8d768becb305c7ec8895f6c169fb6d1a14e5726bb8468eb5d2fe1"
                "7deb2e643f6857ab55ea1fd414cba0564ce273abea6f5dad246f07b1fdc2d127"
                29 429 1 1 1 0 0
                "operation-miss-retained")
            (fkbefao-row "V2-T2-regression"
                (fkbefao-v2-adapter-sha)
                "9b2d0f85417696517fd3dd5f85eeb91d0f0d2321c6bdaaee46e5e21b6cc86fb8"
                "37ac49015b03f175204462242d1cdc7bf9f2c6802700d0f5f3ece683c98dad5d"
                34 461 1 1 1 1 0 "exact")
            (fkbefao-row "V2-T3-supplied-api"
                (fkbefao-v2-adapter-sha)
                "7469feffebdf636afce3c285d389dea6b972aa26a3fadd3558c3069bc0299697"
                "b24deddf6fd2cea8105224ae221c43c17e7380c88fbe2d0dc0c29831eb37f465"
                13 243 1 1 1 1 0 "exact")
            (fkbefao-row "V2-T4-supplied-undo-shape"
                (fkbefao-v2-adapter-sha)
                "897fd98349ff96ad1e029f2911e564fcf8fe24d796f0e0caa9b4f33f0b244d53"
                "2ed851ef0c25ccff34007a2f621c63eddb3c11b365a54129fe9ba6d7e1853bfa"
                20 328 1 1 (nothing) (nothing) 0
                "exact-grammar-execution-not-observed")
            (fkbefao-row "V2-H1-adaptive-59cb"
                (fkbefao-v2-adapter-sha) (fkbefao-prompt-sha)
                "fe79011e8e5f0c3c6ac90ac60b7226f6efeda5e1ebfb3f9e86db77ffe25eaff8"
                130 1865 0 (nothing) (nothing) (nothing) 0
                "api-arities-improved-incomplete-if-and-redefinition-remain")))

    (defn fkbefao-all-local-released? (rows)
        (if (nil? rows) 1
            (if (and (eq (fkbefao-http (head rows)) 0)
                (and (eq (fkbefao-remote (head rows)) 0)
                     (eq (fkbefao-released (head rows)) 1)))
                (fkbefao-all-local-released? (tail rows)) 0)))
    0)
