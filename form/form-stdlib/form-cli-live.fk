; form-cli-live.fk — one input, recursive thoughts, on-demand organs.
;
; No flags. The input lives in this cell. A recursive thought walks it,
; generates a micro-kernel per row, and mlx_run's them as it goes.
; The run file translates the add row onto CPU JIT and Metal GPU too.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-live-band.fk
; witnessed: 2026-08-20 -> 255

section [form.lift] {
    allow fle-input() = list(list("add", 2, 3), list("max", 2, 9), list("vadd", 10, 20, 1, 2));

    allow fle-spc() = " ";
    allow fle-emit(n) = if str_eq(nth(n, 0), "c") then int_to_str(nth(n, 1)) else if str_eq(nth(n, 0), "v") then str_concat("v2 ", str_concat(int_to_str(nth(n, 1)), str_concat(fle-spc(), int_to_str(nth(n, 2))))) else if str_eq(nth(n, 0), "sum") then str_concat(fle-emit(nth(n, 1)), str_concat(fle-spc(), "sum")) else str_concat(fle-emit(nth(n, 1)), str_concat(fle-spc(), str_concat(fle-emit(nth(n, 2)), str_concat(fle-spc(), nth(n, 0)))));

    allow fle-tree(row) = if str_eq(nth(row, 0), "add") then list("add", list("c", nth(row, 1)), list("c", nth(row, 2))) else if str_eq(nth(row, 0), "max") then list("max", list("c", nth(row, 1)), list("c", nth(row, 2))) else list("sum", list("add", list("v", nth(row, 1), nth(row, 2)), list("v", nth(row, 3), nth(row, 4))));

    allow fle-expect(row) = if str_eq(nth(row, 0), "add") then nth(row, 1) + nth(row, 2) else if str_eq(nth(row, 0), "max") then if nth(row, 1) > nth(row, 2) then nth(row, 1) else nth(row, 2) else nth(row, 1) + nth(row, 2) + nth(row, 3) + nth(row, 4);

    allow fle-prog(row) = fle-emit(fle-tree(row));

    thought fle-progs(xs) = if len(xs) == 0 then empty else cons(fle-prog(head(xs)), fle-progs(tail(xs)));

    thought fle-pulse(xs) = if len(xs) == 0 then 0 else mlx_run(fle-prog(head(xs))) + fle-pulse(tail(xs));

    allow fle-add-lhs() = nth(head(fle-input()), 1);
    allow fle-add-rhs() = nth(head(fle-input()), 2);

    allow fle-check() = add(if len(fle-input()) == 3 then 1 else 0, add(if str_eq(head(fle-progs(fle-input())), "2 3 add") then 2 else 0, add(if str_eq(head(tail(fle-progs(fle-input()))), "2 9 max") then 4 else 0, add(if str_eq(head(tail(tail(fle-progs(fle-input())))), "v2 10 20 v2 1 2 add sum") then 8 else 0, add(if fle-pulse(fle-input()) == 47 then 16 else 0, add(if mlx_run(head(fle-progs(fle-input()))) == 5 then 32 else 0, add(if len(fle-progs(fle-input())) == 3 then 64 else 0, if fle-expect(head(fle-input())) == 5 then 128 else 0)))))));
    0;
}
