; form-cli-live.fk — current Form CLI source door.
;
; This is loaded directly by `fkwu form/form-stdlib/form-cli-live.fk`.
; Its dependency graph is owned by Form preludes. There is no generated module
; registry and no alternate source spelling.
;
; `ds4-generate` and `rewitness` both walk the complete configured local DS4
; model. The latter is deliberately the same recipe: re-witness means observe
; the claim again from present ground, not replay stored prose.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-dsv4-local.fk

(do
    (defn fcl-verb (line)
        (do
            (let at (str_find line " " 0))
            (if (lt at 0) line (substring line 0 at))))

    (defn fcl-arg (line)
        (do
            (let at (str_find line " " 0))
            (if (lt at 0) ""
                (substring line (add at 1) (str_len line)))))

    (defn fcl-framebuffer-status ()
        (str_concat "framebuffer-events:"
            (int_to_str (len (framebuffer-events)))))

    (defn fcl-respond (line)
        (do
            (let verb (fcl-verb line))
            (if (str_eq verb "ping") "pong"
            (if (str_eq verb "ds4-generate")
                (fdl-generate (fcl-arg line))
            (if (str_eq verb "ds4-tokenize")
                (fdl-tokenize (fcl-arg line))
            (if (str_eq verb "rewitness")
                (fdl-generate (fcl-arg line))
            (if (str_eq verb "framebuffer-status")
                (fcl-framebuffer-status)
            (if (str_eq verb "help")
                "form-cli live verbs: ds4-tokenize <inquiry>; ds4-generate <inquiry>; rewitness <inquiry>; framebuffer-status; ping; quit"
                (str_concat "form-cli: unknown verb " verb)))))))))

    (defn fcl-loop ()
        (do
            (if (eq (isatty) 2) (print_str "form-cli> ") 0)
            (let line (read_line))
            (if (lt line 0) ""
                (if (str_eq (fcl-verb line) "quit") ""
                    (if (str_eq (fcl-verb line) "exit") ""
                        (do
                            (print_str (fcl-respond line))
                            (fcl-loop)))))))

    (fcl-loop))
