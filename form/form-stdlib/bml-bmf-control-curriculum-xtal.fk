; Reviewed crystallization of bml-bmf-control-curriculum.bml.
;
; This is a checked Form lowering while the current fkwu BML source-compiler
; chain carries three absent operations.  It is not presented as compiler-run
; evidence.  The held-out band executes its choice/thought/JIT methods.
;
; source: form/form-stdlib/bml-bmf-control-curriculum.bml
; preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk control/offer-ack-core.fk control/choice-lane-core.fk form-stdlib/jit-decision.fk observe/inquiry-planes.fk form-stdlib/bml-bmf-control-curriculum.fk

(do
    (defn AckVocabulary () "nothing|0|1|node")
    (defn TimeoutLaw ()
        "budget-exhaustion-with-untried-alternatives-is-nothing")
    (defn JitLaw ()
        "hot-and-pure-earns-plan-live-carrier-proof-still-required")
    (defn bbcc-bml-choice (leftScore rightScore)
        (bbcc-evidence-choice leftScore bbcc-cell-twelve
            rightScore bbcc-cell-thirty-four (list)))
    (defn bbcc-bml-thought (word)
        (bbcc-thought-route word 6000 300))
    (defn bbcc-bml-jit (heat pure)
        (bbcc-auto-jit-plan heat pure 8000 2000 20))
    (defn bbcc-bml-check ()
        (do
            (let tie (bbcc-bml-choice 7 7))
            (let winner (bbcc-bml-choice 9 7))
            (let thought (bbcc-bml-thought "why"))
            (let plan (bbcc-bml-jit 6 1))
            (let c0 (if (nothing? tie) 1 0))
            (let c1 (if (eq (bbcc-ack-int winner) 12) 2 0))
            (let c2 (if (eq (nth thought 3) 20) 4 0))
            (let c3 (if (str_eq (bbcc-jit-plan-route plan) "crystallize-plan") 8 0))
            (add c0 (add c1 (add c2 c3)))))
    (defn BmlBmfControlCurriculum ()
        (list "abstraction" "BmlBmfControlCurriculum" (list "T")
            (list "bbcc-bml-choice" "bbcc-bml-thought"
                  "bbcc-bml-jit" "bbcc-bml-check")
            (list "AckVocabulary" "TimeoutLaw" "JitLaw")
            (empty) (empty)))
    0)
