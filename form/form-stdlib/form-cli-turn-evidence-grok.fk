; form-cli-turn-evidence-grok.fk — measure a Grok session from @form receipts
; and turn_started events. No prompt/answer text is kept.
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/form-fs.fk
; preludes: form-stdlib/form-cli-turn-evidence.fk
; preludes: form-stdlib/form-cli-turn-evidence-live.fk

(defn fctg-session-bind-path () ".form-cli-turn-grok-session")
(defn fctg-nl? (ch) (or (str_eq ch "\n") (str_eq ch "\r")))
(defn fctg-line-start? (s i)
    (or (eq i 0) (fctg-nl? (char_at s (sub i 1)))))

(defn fctg-kind-end (s i n)
    (if (ge i n) i
        (if (or (str_eq (char_at s i) " ") (fctg-nl? (char_at s i)))
            i (fctg-kind-end s (add i 1) n))))

(defn fctg-int-end (s i n)
    (if (ge i n) i
        (if (is-digit-cp (ord (char_at s i)))
            (fctg-int-end s (add i 1) n) i)))

(defn fctg-skip-sp (s i n)
    (if (ge i n) i
        (if (str_eq (char_at s i) " ") (fctg-skip-sp s (add i 1) n) i)))

; acc = (fkwu other fkwu-fail other-fail stdout stderr shown)
(defn fctg-add6 (a b)
    (list (add (nth a 0) (nth b 0)) (add (nth a 1) (nth b 1))
          (add (nth a 2) (nth b 2)) (add (nth a 3) (nth b 3))
          (add (nth a 4) (nth b 4)) (add (nth a 5) (nth b 5))
          (add (nth a 6) (nth b 6))))

(defn fctg-zero () (list 0 0 0 0 0 0 0))

(defn fctg-receipt (s i n)
    (do
        (let ke (fctg-kind-end s i n))
        (let kind (substring s i ke))
        (let a (fctg-skip-sp s ke n))
        (let ae (fctg-int-end s a n))
        (let b (fctg-skip-sp s ae n))
        (let be (fctg-int-end s b n))
        (let c (fctg-skip-sp s be n))
        (let ce (fctg-int-end s c n))
        (let d (fctg-skip-sp s ce n))
        (let de (fctg-int-end s d n))
        (let ex (if (eq a ae) 0 (str_to_int (substring s a ae))))
        (let so (if (eq b be) 0 (str_to_int (substring s b be))))
        (let se (if (eq c ce) 0 (str_to_int (substring s c ce))))
        (let sh (if (eq d de) 0 (str_to_int (substring s d de))))
        (let fw (if (str_eq kind "fkwu") 1 0))
        (list fw (if (eq fw 1) 0 1)
              (if (and (eq fw 1) (not (eq ex 0))) 1 0)
              (if (and (eq fw 0) (not (eq ex 0))) 1 0)
              so se sh)))

(defn fctg-scan (s i n acc)
    (do
        (let p (str_find s "@form " i))
        (if (lt p 0) acc
            (if (fctg-line-start? s p)
                (fctg-scan s (add p 6) n (fctg-add6 acc (fctg-receipt s (add p 6) n)))
                (fctg-scan s (add p 1) n acc)))))

(defn fctg-file (path)
    (if (le (file_size path) 0) (fctg-zero)
        (do
            (let s (read_file path))
            (fctg-scan s 0 (str_len s) (fctg-zero)))))

(defn fctg-join-path (dir name)
    (str_concat dir (str_concat "/" name)))

(defn fctg-dir (dir names acc)
    (if (eq (len names) 0) acc
        (fctg-dir dir (tail names)
            (fctg-add6 acc (fctg-file (fctg-join-path dir (head names)))))))

(defn fctg-count-mark (s needle from acc)
    (do
        (let p (str_find s needle from))
        (if (lt p 0) acc
            (fctg-count-mark s needle (add p (str_len needle)) (add acc 1)))))

(defn fctg-pipe (xs)
    (if (eq (len xs) 0) ""
        (if (eq (len (tail xs)) 0) (head xs)
            (str_concat (head xs) (str_concat "|" (fctg-pipe (tail xs)))))))

(defn fctg-row (thread turn native nfail local lfail remote so se sh tools started ended)
    (do
        (let dur (sub ended started))
        (let shown (add so se))
        (let fcmds (add native local))
        (let ffail (add nfail lfail))
        (let total (add native (add local remote)))
        (fctg-pipe (list
            (fcte-tag) thread turn "xai" "grok-4.6"
            (int_to_str started) (int_to_str ended) (int_to_str dur) "0"
            "0"
            (int_to_str remote) "0" "0" "0" "0" "0" "0" "0"
            (int_to_str tools) (int_to_str tools) "0" "0"
            (int_to_str fcmds) (int_to_str ffail)
            (int_to_str so) (int_to_str se) (int_to_str shown)
            (int_to_str native) (int_to_str nfail)
            (int_to_str local) (int_to_str remote) (int_to_str total)
            "0" (fcte-source-kind-grok) "1"))))

(defn fctg-chunk () 1048576)
(defn fctg-overlap () 32)

(defn fctg-log-names (names acc)
    (if (eq (len names) 0) acc
        (if (eq (fs-suffix? (head names) ".log") 1)
            (fctg-log-names (tail names) (cons (head names) acc))
            (fctg-log-names (tail names) acc))))

(defn fctg-count-file-loop (path needle size offset acc)
    (if (ge offset size) acc
        (do
            (let remain (sub size offset))
            (let n (if (lt remain (fctg-chunk)) remain (fctg-chunk)))
            (let body (read_file_slice path offset n))
            (let from (if (eq offset 0) 0 (fctg-overlap)))
            (let c (fctg-count-mark body needle from 0))
            (let nxt (if (eq (add offset n) size) size
                (sub (add offset n) (fctg-overlap))))
            (fctg-count-file-loop path needle size nxt (add acc c)))))

(defn fctg-count-file (path needle)
    (if (le (file_size path) 0) 0
        (fctg-count-file-loop path needle (file_size path) 0 0)))

(defn fctg-first-ts (path)
    (if (le (file_size path) 0) 0
        (fctel-iso-ms (fctel-json-string-after
            (read_file_slice path 0 512) "\"ts\":" 0))))

(defn fctg-last-ts (path)
    (if (le (file_size path) 0) 0
        (do
            (let size (file_size path))
            (let start (if (lt size 1024) 0 (sub size 1024)))
            (let body (read_file_slice path start (sub size start)))
            (let p (fctel-find-last-text body "\"ts\":" 0 -1))
            (if (lt p 0) 0
                (fctel-iso-ms (fctel-json-string-after body "\"ts\":" p))))))

(defn fctg-bound-session ()
    (if (le (file_size (fctg-session-bind-path)) 0) ""
        (fctel-trim-end (read_file (fctg-session-bind-path)))))

(defn fctg-refresh-once (session)
    (do
        (let term (fs-path-join session "terminal"))
        (let events (fs-path-join session "events.jsonl"))
        (if (or (eq (fs-is-dir? term) 0) (eq (fs-exists? events) 0))
            "turn-evidence-refresh=withheld\n"
            (do
                (let names (fctg-log-names (fs-list term) (list)))
                (let acc (fctg-dir term names (fctg-zero)))
                (let remote (fctg-count-file events "\"type\":\"turn_started\""))
                (let tools (fctg-count-file events "\"type\":\"tool_completed\""))
                (let started0 (fctg-first-ts events))
                (let ended0 (fctg-last-ts events))
                (let started (if (and (gt started0 0) (ge ended0 started0)) started0 0))
                (let ended (if (eq started 0) 0 ended0))
                (let row (fctg-row
                    (fs-path-basename session) "session"
                    (nth acc 0) (nth acc 2) (nth acc 1) (nth acc 3)
                    remote (nth acc 4) (nth acc 5) (nth acc 6)
                    tools started ended))
                (write_file_text (fctel-candidate-row-path) row)
                (if (eq (fcte-valid? (fcte-parse row)) 1)
                    (do
                        (write_file_text (fctel-observed-row-path) row)
                        (fctel-join (list "turn-evidence-refresh=observed native="
                            (int_to_str (nth acc 0)) " local=" (int_to_str (nth acc 1))
                            " remote=" (int_to_str remote) "\n")))
                    (do
                        (write_file_text (fctel-progress-path) row)
                        "turn-evidence-refresh=unreconciled\n"))))))
