; dsv4-control-token-probe.fk — inspect DS4's own token types and non-normal pieces.
; Native program-image lane only:
;   ./fkwu form/form-stdlib/dsv4-control-token-probe.fk
; preludes: form-stdlib/dsv4-tokenizer.fk form-stdlib/model-registry.bml

(do
    (defn dctp-model ()
        (mr-path (mr-find "ds4flash")))
    (defn dctp-types-kv (src) (gmt-find src "tokenizer.ggml.token_type"))
    (defn dctp-type (src kv id) (eqr-u32 src (gmt-arr-elem src kv id)))
    (defn dctp-hd (n) (byte_to_str (if (lt n 10) (add 48 n) (add 87 n))))
    (defn dctp-bhex (b) (str_concat (dctp-hd (div b 16)) (dctp-hd (mod b 16))))
    (defn dctp-piece-hex (src at j n acc)
        (if (eq j n) acc
            (dctp-piece-hex src at (add j 1) n
                (str_concat acc (dctp-bhex (gmt-token-byte src at j))))))
    (defn dctp-count-get (counts t)
        (if (if (ge t 0) (lt t (len counts)) 0) (nth counts t) 0))
    (defn dctp-counts-add (counts t i)
        (if (eq i (len counts)) (empty)
            (cons (if (eq i t) (add (nth counts i) 1) (nth counts i))
                  (dctp-counts-add counts t (add i 1)))))
    (defn dctp-scan (src tkv at id n counts)
        (if (eq id n) counts
            (do (let t (dctp-type src tkv id))
                (if (eq t 1) 0
                    (print_str
                        (str_concat "candidate_id="
                        (str_concat (int_to_str id)
                        (str_concat ";type="
                        (str_concat (int_to_str t)
                        (str_concat ";piece_hex="
                            (dctp-piece-hex src at 0 (gmt-token-len src at) ""))))))))
                (dctp-scan src tkv (gmt-token-next src at) (add id 1) n
                    (dctp-counts-add counts t 0)))))

    (let src (tkz-src (dctp-model)))
    (let tkv (dctp-types-kv src))
    (let counts (dctp-scan src tkv (gmt-tokens-first src) 0 (tkz-vocab-n src)
        (list 0 0 0 0 0 0 0 0)))
    (print_str (str_concat "vocab=" (int_to_str (tkz-vocab-n src))))
    (print_str (str_concat "type1.normal=" (int_to_str (dctp-count-get counts 1))))
    (print_str (str_concat "type2.unknown=" (int_to_str (dctp-count-get counts 2))))
    (print_str (str_concat "type3.control=" (int_to_str (dctp-count-get counts 3))))
    (print_str (str_concat "type4.user_defined=" (int_to_str (dctp-count-get counts 4))))
    (print_str (str_concat "type5.unused=" (int_to_str (dctp-count-get counts 5))))
    (print_str (str_concat "type6.byte=" (int_to_str (dctp-count-get counts 6))))
    counts)
