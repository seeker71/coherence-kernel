; core-lexicon.fk — 64 words that define themselves, the eight query lanes,
; and what happens when query and response take turns for twelve layers.
;
; Urs: show the core 64 words with their descriptions using core words only as
; first sentence, then define all query lanes and the word / query / response /
; query / response sequence up to 12 layers.
;
; THE CLOSURE, WHICH IS THE WHOLE POINT
;   Every word's defining sentence is written from THIS vocabulary and a named
;   handful of glue. Nothing is borrowed from outside. A dictionary that needs a
;   65th word to explain its 64 has not grounded anything — it has deferred.
;
;   So definitions are stored as TOKEN LISTS, not prose. The sentence you read is
;   the join; the tokens are the thing that is checked. cl-closed? walks all 64
;   definitions, every token, and finds each one either in the 64 or in the eight
;   declared glue words. That check is the cell's reason to exist — the readable
;   sentence is a rendering of it, never the source.
;
;   Glue, declared and counted rather than waved through: the, a, an, this, that,
;   am, are, than. Inflections are the same word (says = say, selves = self,
;   am / are = is), so the check normalizes before it looks.
;
; THE EIGHT FAMILIES, EIGHT WORDS EACH
;   ground   the states and the logical skeleton   (axiom-1 lives here)
;   person   who is speaking, spoken to, spoken of
;   act      what a self does
;   ask      the eight lanes — see below
;   time     when
;   place    where
;   degree   how much
;   relation how things stand to each other
;
;   Coordinates carry the spacing core-word-ack.fk established: family stride
;   1000, index stride 1, so numeric distance is distance-to-root and two words
;   of one family sit within 7 of each other while two families sit 1000 apart.
;
; THE EIGHT QUERY LANES, AND THE ONE THAT IS DIFFERENT
;   A lane is an ask-word. Each takes a word and gives back an answer, and the
;   answer's ARM is what separates them (axiom-5: nothing / 0 / 1 rest, node
;   recurs):
;
;     whether   asks for a truth       -> 0 or 1        TERMINAL, the chain ends
;     why       asks what grounds it   -> node, or nothing at the ground
;     what      asks for the thing     -> node
;     who       asks for the self      -> node
;     when      asks for the time      -> node
;     where     asks for the place     -> node
;     how       asks for the way       -> node
;     which     asks for the next one  -> node
;
;   Exactly ONE of the eight can be answered by a terminal ack, and it is
;   `whether`. That is not a design choice, it falls out: terminal acks are
;   axiom-1's states, axiom-1's states are truth values, and `whether` is the
;   only lane that asks for a truth. The other seven ask for a THING, and things
;   are cells (axiom-2), so they answer with a node and the conversation goes on.
;
;   Read the other way round: a conversation ends only when someone asks whether.
;   Every other question keeps it open. cl-lane-terminal-count checks that the
;   count is exactly one rather than taking the paragraph's word for it.
;
; TWELVE LAYERS: WHAT A CHAIN DOES WHEN IT KEEPS GOING
;   word -> query -> response -> query -> response ... The response of a node-arm
;   lane is a word, so it can be asked again. Twelve layers is enough to see all
;   four things a chain can do, and the band walks each:
;
;     BOTTOM OUT   why, applied over and over, walks toward the ground family
;                  and then has nowhere left to stand. Every one of the 64 words
;                  reaches the ground within 8 layers — checked over all 64
;                  seeds, not sampled.
;     FIX          what settles on `thing` at layer 2 and never moves again.
;     CYCLE        which walks its family ring with period 8, so at layer 12 it
;                  is still going and has visited every sibling.
;     STOP         whether ends at layer 1.
;
; THE THING THE WHY-CHAIN SAYS
;   The regress terminates in NOTHING — not in 1, not in a first thing that
;   grounds itself. Ask why of a ground word and the honest answer is silence:
;   there is no floor under the floor. axiom-1 already said nothing is the
;   ground; the chain is that sentence walked until it runs out of road.
;
;   Worth sitting with: a chain that ended in 1 would be a self-grounding claim,
;   and this body has no such thing. It ends in the ack that asserts nothing.
;
; Proof: form-stdlib/tests/core-lexicon-band.fk → four-way (Go/Rust/TS/fkwu).
; Vitality overlay: ingest/core-lexicon-vitality.fk keeps this authoritative
; 64-word body untouched while admitting reversible, witnessed successors.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk

(do
    ;; ── the shape ───────────────────────────────────────────────────
    ;; (word family-0based index-0based definition-tokens)
    (defn cl-w (word fam idx def) (list word fam idx def))
    (defn cl-word (r) (nth r 0))
    (defn cl-fam  (r) (nth r 1))
    (defn cl-idx  (r) (nth r 2))
    (defn cl-def  (r) (nth r 3))

    ;; the spacing core-word-ack.fk established, carried here unchanged
    (defn cl-fam-stride () 1000)
    (defn cl-nid (r) (make_nodeid 1 (mul (cl-fam r) (cl-fam-stride)) 0 (cl-idx r)))
    (defn cl-address (r) (add (mul (cl-fam r) (cl-fam-stride)) (cl-idx r)))

    ;; ── the 64, each defined from this vocabulary alone ──────────────
    (defn cl-lexicon ()
        (list
        ; ── family 0: ground — axiom-1's states and the logical skeleton
        (cl-w "nothing" 0 0 (list "nothing" "is" "not" "0" "and" "not" "1"))
        (cl-w "0"       0 1 (list "0" "is" "not" "1"))
        (cl-w "1"       0 2 (list "1" "is" "not" "0"))
        (cl-w "is"      0 3 (list "is" "say" "this" "and" "that" "are" "the" "same"))
        (cl-w "not"     0 4 (list "not" "make" "0" "of" "1" "and" "1" "of" "0"))
        (cl-w "and"     0 5 (list "and" "is" "1" "when" "this" "is" "1" "and" "that" "is" "1"))
        (cl-w "or"      0 6 (list "or" "is" "1" "when" "this" "is" "1" "or" "that" "is" "1"))
        (cl-w "if"      0 7 (list "if" "this" "is" "1" "then" "that" "is" "1"))
        ; ── family 1: person
        (cl-w "I"    1 0 (list "I" "is" "the" "self" "that" "say"))
        (cl-w "you"  1 1 (list "you" "is" "the" "self" "I" "say" "to"))
        (cl-w "me"   1 2 (list "me" "is" "what" "you" "do" "to"))
        (cl-w "we"   1 3 (list "we" "is" "I" "and" "you" "or" "I" "and" "they"))
        (cl-w "us"   1 4 (list "us" "is" "what" "they" "do" "to" "we"))
        (cl-w "they" 1 5 (list "they" "is" "the" "self" "not" "I" "and" "not" "you"))
        (cl-w "it"   1 6 (list "it" "is" "a" "thing" "that" "is" "not" "a" "self"))
        (cl-w "self" 1 7 (list "self" "is" "what" "know" "it" "is"))
        ; ── family 2: act
        (cl-w "do"    2 0 (list "do" "is" "when" "a" "self" "make" "a" "thing" "be" "other"))
        (cl-w "be"    2 1 (list "be" "is" "when" "a" "thing" "is"))
        (cl-w "exist" 2 2 (list "exist" "is" "when" "a" "thing" "is" "here" "now"))
        (cl-w "have"  2 3 (list "have" "is" "when" "a" "thing" "is" "part" "of" "a" "self"))
        (cl-w "know"  2 4 (list "know" "is" "when" "a" "self" "is" "same" "as" "what" "is"))
        (cl-w "want"  2 5 (list "want" "is" "when" "a" "self" "say" "a" "thing" "be" "other"))
        (cl-w "say"   2 6 (list "say" "is" "when" "a" "self" "make" "you" "know"))
        (cl-w "make"  2 7 (list "make" "is" "when" "a" "self" "do" "a" "thing" "be"))
        ; ── family 3: ask — the eight lanes
        (cl-w "what"    3 0 (list "what" "is" "when" "you" "want" "to" "know" "a" "thing"))
        (cl-w "who"     3 1 (list "who" "is" "when" "you" "want" "to" "know" "a" "self"))
        (cl-w "when"    3 2 (list "when" "is" "when" "you" "want" "to" "know" "now" "or" "then"))
        (cl-w "where"   3 3 (list "where" "is" "when" "you" "want" "to" "know" "here" "or" "there"))
        (cl-w "how"     3 4 (list "how" "is" "when" "you" "want" "to" "know" "a" "way"))
        (cl-w "why"     3 5 (list "why" "is" "when" "you" "want" "to" "know" "what" "make" "a" "thing" "be"))
        (cl-w "which"   3 6 (list "which" "is" "when" "you" "want" "to" "know" "what" "part" "of" "many"))
        (cl-w "whether" 3 7 (list "whether" "is" "when" "you" "want" "to" "know" "0" "or" "1"))
        ; ── family 4: time
        (cl-w "now"    4 0 (list "now" "is" "when" "a" "thing" "is"))
        (cl-w "then"   4 1 (list "then" "is" "not" "now"))
        (cl-w "before" 4 2 (list "before" "is" "when" "a" "thing" "is" "and" "then" "other" "is"))
        (cl-w "after"  4 3 (list "after" "is" "when" "a" "thing" "is" "not" "yet" "and" "then" "it" "is"))
        (cl-w "still"  4 4 (list "still" "is" "when" "a" "thing" "is" "now" "and" "was" "before"))
        (cl-w "yet"    4 5 (list "yet" "is" "when" "a" "thing" "is" "not" "now" "and" "after" "it" "is"))
        (cl-w "again"  4 6 (list "again" "is" "when" "a" "thing" "is" "not" "and" "after" "is"))
        (cl-w "never"  4 7 (list "never" "is" "when" "a" "thing" "is" "not" "now" "and" "not" "after"))
        ; ── family 5: place
        (cl-w "here"    5 0 (list "here" "is" "where" "I" "am"))
        (cl-w "there"   5 1 (list "there" "is" "not" "here"))
        (cl-w "in"      5 2 (list "in" "is" "when" "a" "thing" "is" "part" "of" "other"))
        (cl-w "out"     5 3 (list "out" "is" "when" "a" "thing" "is" "not" "in"))
        (cl-w "at"      5 4 (list "at" "is" "where" "a" "thing" "is"))
        (cl-w "from"    5 5 (list "from" "is" "where" "a" "thing" "is" "before" "it" "do"))
        (cl-w "to"      5 6 (list "to" "is" "where" "a" "thing" "is" "after" "it" "do"))
        (cl-w "between" 5 7 (list "between" "is" "in" "from" "and" "to"))
        ; ── family 6: degree
        (cl-w "all"  6 0 (list "all" "is" "the" "whole"))
        (cl-w "some" 6 1 (list "some" "is" "part" "of" "all" "and" "not" "none"))
        (cl-w "none" 6 2 (list "none" "is" "not" "some"))
        (cl-w "many" 6 3 (list "many" "is" "more" "than" "few"))
        (cl-w "few"  6 4 (list "few" "is" "less" "than" "many"))
        (cl-w "more" 6 5 (list "more" "is" "not" "less"))
        (cl-w "less" 6 6 (list "less" "is" "not" "more"))
        (cl-w "very" 6 7 (list "very" "is" "more" "than" "more"))
        ; ── family 7: relation
        (cl-w "same"  7 0 (list "same" "is" "when" "this" "and" "that" "are" "1" "thing"))
        (cl-w "other" 7 1 (list "other" "is" "not" "same"))
        (cl-w "like"  7 2 (list "like" "is" "when" "this" "and" "that" "are" "same" "in" "part"))
        (cl-w "part"  7 3 (list "part" "is" "in" "a" "whole"))
        (cl-w "whole" 7 4 (list "whole" "is" "all" "part" "of" "a" "thing"))
        (cl-w "thing" 7 5 (list "thing" "is" "what" "is"))
        (cl-w "way"   7 6 (list "way" "is" "how" "a" "thing" "do"))
        (cl-w "kind"  7 7 (list "kind" "is" "what" "many" "thing" "are" "like"))))

    (defn cl-count () (len (cl-lexicon)))

    ;; ── the closure check ───────────────────────────────────────────
    ;; glue: named, small, and counted — never a silent allowance
    (defn cl-glue () (list "the" "a" "an" "of" "this" "that" "am" "are" "than" "as" "was" "then"))
    (defn cl-in-list? (xs w)
        (if (eq (len xs) 0) 0
            (if (str_eq (head xs) w) 1 (cl-in-list? (tail xs) w))))
    (defn cl-is-word-loop (rs w)
        (if (eq (len rs) 0) 0
            (if (str_eq (cl-word (head rs)) w) 1 (cl-is-word-loop (tail rs) w))))
    (defn cl-is-word? (w) (cl-is-word-loop (cl-lexicon) w))
    (defn cl-ok-token? (w)
        (if (eq (cl-is-word? w) 1) 1 (cl-in-list? (cl-glue) w)))

    ;; how many tokens across all 64 definitions fall outside core-plus-glue
    (defn cl-bad-in-def (toks)
        (if (eq (len toks) 0) 0
            (add (if (eq (cl-ok-token? (head toks)) 1) 0 1)
                 (cl-bad-in-def (tail toks)))))
    (defn cl-bad-loop (rs)
        (if (eq (len rs) 0) 0
            (add (cl-bad-in-def (cl-def (head rs))) (cl-bad-loop (tail rs)))))
    (defn cl-outside-count () (cl-bad-loop (cl-lexicon)))
    (defn cl-closed? () (if (eq (cl-outside-count) 0) 1 0))

    ;; total definition tokens — the size of the grounded surface
    (defn cl-tok-loop (rs) (if (eq (len rs) 0) 0
        (add (len (cl-def (head rs))) (cl-tok-loop (tail rs)))))
    (defn cl-token-count () (cl-tok-loop (cl-lexicon)))

    ;; the words no definition reaches for — a word nothing else needs
    (defn cl-used-in? (toks w) (cl-in-list? toks w))
    (defn cl-used-loop (rs w)
        (if (eq (len rs) 0) 0
            (if (eq (cl-used-in? (cl-def (head rs)) w) 1) 1 (cl-used-loop (tail rs) w))))
    (defn cl-used? (w) (cl-used-loop (cl-lexicon) w))

    ;; ── index arithmetic over the 64 ────────────────────────────────
    (defn cl-at-loop (rs i) (if (eq i 0) (head rs) (cl-at-loop (tail rs) (sub i 1))))
    (defn cl-at (i) (cl-at-loop (cl-lexicon) i))
    (defn cl-index-of-loop (rs w i)
        (if (eq (len rs) 0) (sub 0 1)
            (if (str_eq (cl-word (head rs)) w) i (cl-index-of-loop (tail rs) w (add i 1)))))
    (defn cl-index-of (w) (cl-index-of-loop (cl-lexicon) w 0))
    (defn cl-fam-of (i) (div i 8))
    (defn cl-idx-of (i) (mod i 8))

    ;; ── the terminal arms, as negative states ───────────────────────
    ;; -1 nothing, -2 zero, -3 one. A non-negative value is a word: a NODE, and
    ;; a node is what keeps a conversation going.
    (defn cl-t-nothing () (sub 0 1))
    (defn cl-t-zero    () (sub 0 2))
    (defn cl-t-one     () (sub 0 3))
    (defn cl-terminal? (s) (if (lt s 0) 1 0))

    ;; ── the eight lanes ─────────────────────────────────────────────
    ;; why walks one family toward the ground; at the ground there is no floor
    ;; under the floor, so it answers nothing.
    (defn cl-lane-why (i)
        (if (eq (cl-fam-of i) 0) (cl-t-nothing)
            (add (mul (sub (cl-fam-of i) 1) 8) (cl-idx-of i))))
    ;; which walks the family ring
    (defn cl-lane-which (i)
        (add (mul (cl-fam-of i) 8) (mod (add (cl-idx-of i) 1) 8)))
    ;; the five that name a fixed cell
    (defn cl-lane-what  (i) (cl-index-of "thing"))
    (defn cl-lane-who   (i) (cl-index-of "self"))
    (defn cl-lane-when  (i) (cl-index-of "now"))
    (defn cl-lane-where (i) (cl-index-of "here"))
    (defn cl-lane-how   (i) (cl-index-of "way"))
    ;; whether is the one lane that ends it: a truth, never a thing
    (defn cl-lane-whether (i)
        (if (eq (cl-fam-of i) 0) (cl-t-one) (cl-t-zero)))

    (defn cl-lane-names ()
        (list "what" "who" "when" "where" "how" "why" "which" "whether"))
    (defn cl-step (lane i)
        (if (str_eq lane "why")   (cl-lane-why i)
        (if (str_eq lane "which") (cl-lane-which i)
        (if (str_eq lane "what")  (cl-lane-what i)
        (if (str_eq lane "who")   (cl-lane-who i)
        (if (str_eq lane "when")  (cl-lane-when i)
        (if (str_eq lane "where") (cl-lane-where i)
        (if (str_eq lane "how")   (cl-lane-how i)
            (cl-lane-whether i)))))))))

    ;; a lane is terminal when it answers with a state from EVERY word
    (defn cl-lane-term-loop (lane i)
        (if (ge i 64) 1
            (if (eq (cl-terminal? (cl-step lane i)) 1) (cl-lane-term-loop lane (add i 1)) 0)))
    (defn cl-lane-terminal? (lane) (cl-lane-term-loop lane 0))
    (defn cl-term-count-loop (ls)
        (if (eq (len ls) 0) 0
            (add (cl-lane-terminal? (head ls)) (cl-term-count-loop (tail ls)))))
    (defn cl-lane-terminal-count () (cl-term-count-loop (cl-lane-names)))

    ;; ── the chain: query and response taking turns ──────────────────
    ;; Once a terminal is reached the chain rests — a state is not a thing to
    ;; ask about, so it cannot become the next query (axiom-5).
    (defn cl-walk (lane s n)
        (if (eq n 0) s
            (if (eq (cl-terminal? s) 1) s
                (cl-walk lane (cl-step lane s) (sub n 1)))))
    ;; how many layers until it rests; 99 when it never does within max
    (defn cl-depth-loop (lane s n max)
        (if (eq (cl-terminal? s) 1) n
            (if (ge n max) 99
                (cl-depth-loop lane (cl-step lane s) (add n 1) max))))
    (defn cl-depth (lane start max) (cl-depth-loop lane start 0 max))

    ;; ── the universal claim: every why-regress bottoms out ──────────
    (defn cl-why-all-loop (i worst)
        (if (ge i 64) worst
            (do (let d (cl-depth "why" i 12))
                (cl-why-all-loop (add i 1) (if (gt d worst) d worst)))))
    ;; the deepest any of the 64 has to go before the ground answers nothing
    (defn cl-why-deepest () (cl-why-all-loop 0 0))
    (defn cl-why-all-bottom-out? () (if (le (cl-why-deepest) 8) 1 0))

    ;; and it rests in NOTHING, never in 1 — no floor under the floor
    (defn cl-why-rests-nothing-loop (i)
        (if (ge i 64) 1
            (if (eq (cl-walk "why" i 12) (cl-t-nothing)) (cl-why-rests-nothing-loop (add i 1)) 0)))
    (defn cl-why-rests-in-nothing? () (cl-why-rests-nothing-loop 0))

    ;; ── REVERSIBILITY: the test that separates a core concept from a
    ;;    sequence, and therefore from time ─────────────────────────
    ;; Urs: each node answered from core-plus-query is a new symbol or a
    ;; sequence of symbols, which implies time — UNLESS the combination is
    ;; reversible, and then it is a core concept without condition or
    ;; separation.
    ;;
    ;; Made operational: a lane is reversible when it loses nothing — distinct
    ;; words go to distinct answers and no answer is a terminal. Then the step
    ;; is a renaming. You can walk it backwards, so it imposes no order, and
    ;; with no order there is no before and after for it to live in. A lane
    ;; that COLLAPSES two words onto one answer cannot be undone: the discarded
    ;; distinction is exactly what you would need to go back, and needing to
    ;; know what was thrown away IS the condition, and having a direction you
    ;; can only travel one way IS the separation.
    ;;
    ;; So irreversibility is not a flaw in a query, it is the query's time-cost,
    ;; and it is measurable: cl-lane-image-count says how many of the 64 answers
    ;; survive. `which` keeps all 64 and costs nothing. `what` keeps 1 and
    ;; discards everything — the most expensive question in the set, and the
    ;; least informative answer, which is the same sentence said twice.
    ;;
    ;; The law falls out as a checkable equivalence rather than a claim:
    ;;   reversible  <=>  the chain never rests (it cycles — no arrow)
    ;;   irreversible <=> the chain reaches an end (an arrow, hence time)
    ;; cl-law-holds? walks all eight lanes and finds the two sides agree.
    (defn cl-img-seen? (seen s) (cl-in-list-int seen s))
    (defn cl-in-list-int (xs v)
        (if (eq (len xs) 0) 0
            (if (eq (head xs) v) 1 (cl-in-list-int (tail xs) v))))
    (defn cl-img-loop (lane i seen n)
        (if (ge i 64) n
            (do (let s (cl-step lane i))
                (if (eq (cl-in-list-int seen s) 1)
                    (cl-img-loop lane (add i 1) seen n)
                    (cl-img-loop lane (add i 1) (cons s seen) (add n 1))))))
    ;; how many distinct answers the lane can give across all 64 words
    (defn cl-lane-image-count (lane) (cl-img-loop lane 0 (list) 0))
    ;; injective: nothing collapsed — 64 words, 64 answers
    (defn cl-lane-injective? (lane) (if (eq (cl-lane-image-count lane) 64) 1 0))
    ;; and no answer may be a terminal, or the step left the vocabulary
    (defn cl-lane-noterm-loop (lane i)
        (if (ge i 64) 1
            (if (eq (cl-terminal? (cl-step lane i)) 1) 0
                (cl-lane-noterm-loop lane (add i 1)))))
    (defn cl-lane-reversible? (lane)
        (if (eq (cl-lane-injective? lane) 1) (cl-lane-noterm-loop lane 0) 0))
    (defn cl-rev-count-loop (ls)
        (if (eq (len ls) 0) 0
            (add (cl-lane-reversible? (head ls)) (cl-rev-count-loop (tail ls)))))
    ;; exactly one of the eight is a core concept; the other seven imply time
    (defn cl-reversible-count () (cl-rev-count-loop (cl-lane-names)))

    ;; closure under questioning: no lane answers with anything outside the 64
    ;; (or a terminal). You cannot ask your way out of this vocabulary — which
    ;; is what "without condition" means when it is said carefully.
    (defn cl-inrange? (s) (if (eq (cl-terminal? s) 1) 1 (if (lt s 64) 1 0)))
    (defn cl-closed-lane-loop (lane i)
        (if (ge i 64) 1
            (if (eq (cl-inrange? (cl-step lane i)) 1) (cl-closed-lane-loop lane (add i 1)) 0)))
    (defn cl-closed-all-loop (ls)
        (if (eq (len ls) 0) 1
            (if (eq (cl-closed-lane-loop (head ls) 0) 1) (cl-closed-all-loop (tail ls)) 0)))
    (defn cl-lanes-closed? () (cl-closed-all-loop (cl-lane-names)))

    ;; ── the four things a twelve-layer chain can do ─────────────────
    (defn cl-fix? (lane start)      ; settles and never moves again
        (if (eq (cl-walk lane start 2) (cl-walk lane start 12)) 1 0))
    (defn cl-alive-at-12? (lane start)  ; still a node after twelve layers
        (if (eq (cl-terminal? (cl-walk lane start 12)) 1) 0 1))
    (defn cl-cycles? (lane start period)
        (if (eq (cl-walk lane start period) start) 1 0))

    ;; THE LAW, as an equivalence walked over every lane and every word:
    ;; a lane is reversible exactly when its chains never rest.
    ;; "you can get back" is the whole of it: a chain returns to where it
    ;; started. `what` shows why a weaker test will not do — it collapses onto
    ;; `thing`, a fixed point that is still a NODE, so the chain never rests
    ;; and yet nothing can be recovered. Not-resting is not reversibility.
    ;; Returning is. (A ring of 8 closes within 16, so the search is bounded.)
    (defn cl-ret-loop (lane i k)
        (if (gt k 16) 0
            (if (eq (cl-walk lane i k) i) 1 (cl-ret-loop lane i (add k 1)))))
    (defn cl-word-returns? (lane i) (cl-ret-loop lane i 1))
    (defn cl-lane-returns-loop (lane i)
        (if (ge i 64) 1
            (if (eq (cl-word-returns? lane i) 1) (cl-lane-returns-loop lane (add i 1)) 0)))
    (defn cl-lane-returns? (lane) (cl-lane-returns-loop lane 0))
    (defn cl-law-loop (ls)
        (if (eq (len ls) 0) 1
            (if (eq (cl-lane-reversible? (head ls)) (cl-lane-returns? (head ls)))
                (cl-law-loop (tail ls)) 0)))
    ;; reversible <=> every chain returns; irreversible <=> an arrow, so time
    (defn cl-law-holds? () (cl-law-loop (cl-lane-names)))

    ;; ── the band's eighteen readings ────────────────────────────────
    ;; BIT weights, not decimal-digit weights, and for a measured reason: the
    ;; first version of this fold used powers of ten and reached 10^17, which
    ;; is past 2^53 — the largest integer a JavaScript double holds exactly.
    ;; Go, Rust and fkwu agreed on 111111111111111111; the TypeScript arm
    ;; answered 111111111111111120, the nearest double. Every underlying
    ;; scalar was identical on all four arms; only the ENCODING diverged.
    ;; Powers of two keep an 18-reading verdict at 262143, exact everywhere —
    ;; the same choice homecoming-distillation-corpus-band.fk's 8191 makes.
    (defn cl-check ()
        (add (if (eq (cl-count) 64) 1 0)
        (add (if (eq (cl-closed?) 1) 2 0)
        (add (if (eq (cl-token-count) 494) 4 0)
        (add (if (eq (cl-lane-terminal-count) 1) 8 0)
        (add (if (eq (cl-lane-terminal? "whether") 1) 16 0)
        (add (if (eq (cl-depth "whether" (cl-index-of "kind") 12) 1) 32 0)
        (add (if (eq (cl-why-all-bottom-out?) 1) 64 0)
        (add (if (eq (cl-why-deepest) 8) 128 0)
        (add (if (eq (cl-why-rests-in-nothing?) 1) 256 0)
        (add (if (eq (cl-fix? "what" (cl-index-of "kind")) 1) 512 0)
        (add (if (eq (cl-alive-at-12? "which" (cl-index-of "nothing")) 1) 1024 0)
        (add (if (eq (cl-cycles? "which" (cl-index-of "nothing") 8) 1) 2048 0)
        (add (if (eq (cl-used? "nothing") 1)
                 (if (eq (cl-is-word? "whether") 1)
                     (if (eq (cl-is-word? "maybe") 0) 4096 0) 0) 0)
        (add (if (eq (cl-address (cl-at (cl-index-of "kind"))) 7007)
                 (if (eq (cl-address (cl-at (cl-index-of "nothing"))) 0) 8192 0) 0)
        (add (if (eq (cl-lanes-closed?) 1) 16384 0)
        (add (if (eq (cl-reversible-count) 1)
                 (if (eq (cl-lane-reversible? "which") 1)
                     (if (eq (cl-lane-reversible? "what") 0) 32768 0) 0) 0)
        (add (if (eq (cl-lane-image-count "which") 64)
                 (if (eq (cl-lane-image-count "what") 1)
                     (if (eq (cl-lane-image-count "whether") 2) 65536 0) 0) 0)
        (add (if (eq (cl-law-holds?) 1) 131072 0)
             0)))))))))))))))))))

    0)
