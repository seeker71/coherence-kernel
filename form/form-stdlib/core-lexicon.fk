// core-lexicon.fk — 64 words that define themselves, the eight query lanes,
// and what happens when query and response take turns for twelve layers.
//
// Urs: show the core 64 words with their descriptions using core words only as
// first sentence, then define all query lanes and the word / query / response /
// query / response sequence up to 12 layers.
//
// THE CLOSURE, WHICH IS THE WHOLE POINT
//   Every word's defining sentence is written from THIS vocabulary and a named
//   handful of glue. Nothing is borrowed from outside. A dictionary that needs a
//   65th word to explain its 64 has not grounded anything — it has deferred.
//
//   So definitions are stored as TOKEN LISTS, not prose. The sentence you read is
//   the join; the tokens are the thing that is checked. cl-closed? walks all 64
//   definitions, every token, and finds each one either in the 64 or in the twelve
//   declared glue words. That check is the cell's reason to exist — the readable
//   sentence is a rendering of it, never the source.
//
//   Glue, declared and counted rather than waved through: the, a, an, of, this,
//   that, am, are, than, as, was, then. Inflected forms that the definitions use
//   (am, are, was) are admitted as named glue entries, never silently normalized
//   — the check looks a token up as written. (`then` sits doubly: a glue entry
//   here and a family-4 core word; the lookup admits it by either door. `an` is
//   declared and currently unreached by any definition — an open door, counted.)
//
// THE EIGHT FAMILIES, EIGHT WORDS EACH
//   ground   the states and the logical skeleton   (axiom-1 lives here)
//   person   who is speaking, spoken to, spoken of
//   act      what a self does
//   ask      the eight lanes — see below
//   time     when
//   place    where
//   degree   how much
//   relation how things stand to each other
//
//   Coordinates carry the spacing: family stride
//   1000, index stride 1, so numeric distance is distance-to-root and two words
//   of one family sit within 7 of each other while two families sit 1000 apart.
//
// THE EIGHT QUERY LANES, AND THE ONE THAT IS DIFFERENT
//   A lane is an ask-word. Each takes a word and gives back an answer, and the
//   answer's ARM is what separates them (axiom-5: nothing / 0 / 1 rest, node
//   recurs):
//
//     whether   asks for a truth       -> 0 or 1        TERMINAL, the chain ends
//     why       asks what grounds it   -> node, or nothing at the ground
//     what      asks for the thing     -> node
//     who       asks for the self      -> node
//     when      asks for the time      -> node
//     where     asks for the place     -> node
//     how       asks for the way       -> node
//     which     asks for the next one  -> node
//
//   Exactly ONE of the eight can be answered by a terminal ack, and it is
//   `whether`. That is not a design choice, it falls out: terminal acks are
//   axiom-1's states, axiom-1's states are truth values, and `whether` is the
//   only lane that asks for a truth. The other seven ask for a THING, and things
//   are cells (axiom-2), so they answer with a node and the conversation goes on.
//
//   Read the other way round: a conversation ends only when someone asks whether.
//   Every other question keeps it open. cl-lane-terminal-count checks that the
//   count is exactly one rather than taking the paragraph's word for it.
//
// TWELVE LAYERS: WHAT A CHAIN DOES WHEN IT KEEPS GOING
//   word -> query -> response -> query -> response ... The response of a node-arm
//   lane is a word, so it can be asked again. Twelve layers is enough to see all
//   four things a chain can do, and the band walks each:
//
//     BOTTOM OUT   why, applied over and over, walks toward the ground family
//                  and then has nowhere left to stand. Every one of the 64 words
//                  reaches the ground within 8 layers — checked over all 64
//                  seeds, not sampled.
//     FIX          what settles on `thing` at layer 2 and never moves again.
//     CYCLE        which walks its family ring with period 8, so at layer 12 it
//                  is still going and has visited every sibling.
//     STOP         whether ends at layer 1.
//
// THE THING THE WHY-CHAIN SAYS
//   The regress terminates in NOTHING — not in 1, not in a first thing that
//   grounds itself. Ask why of a ground word and the honest answer is silence:
//   there is no floor under the floor. axiom-1 already said nothing is the
//   ground; the chain is that sentence walked until it runs out of road.
//
//   Worth sitting with: a chain that ended in 1 would be a self-grounding claim,
//   and this body has no such thing. It ends in the ack that asserts nothing.
//
// preludes: form-stdlib/core.fk ../control/offer-ack-core.fk
section [form.bml] {
    //; ── the shape ───────────────────────────────────────────────────
    //; (word family-0based index-0based definition-tokens)
    def cl-w(word, fam, idx, def) = [word, fam, idx, def];
    def cl-word(r) = r[0];
    def cl-fam(r) = r[1];
    def cl-idx(r) = r[2];
    def cl-def(r) = r[3];
    //; the family/index spacing: family stride 1000, index stride 1
    def cl-fam-stride() = 1000;
    def cl-nid(r) = make_nodeid(1, cl-fam(r) * cl-fam-stride(), 0, cl-idx(r));
    def cl-address(r) = cl-fam(r) * cl-fam-stride() + cl-idx(r);
    //; ── the 64, each defined from this vocabulary alone ──────────────
    def cl-lexicon() = list(    // ── family 0: ground — axiom-1's states and the logical skeleton
cl-w("nothing", 0, 0, ["nothing", "is", "not", "0", "and", "not", "1"]), cl-w("0", 0, 1, ["0", "is", "not", "1"]), cl-w("1", 0, 2, ["1", "is", "not", "0"]), cl-w("is", 0, 3, ["is", "say", "this", "and", "that", "are", "the", "same"]), cl-w("not", 0, 4, ["not", "make", "0", "of", "1", "and", "1", "of", "0"]), cl-w("and", 0, 5, ["and", "is", "1", "when", "this", "is", "1", "and", "that", "is", "1"]), cl-w("or", 0, 6, ["or", "is", "1", "when", "this", "is", "1", "or", "that", "is", "1"]), cl-w("if", 0, 7, ["if", "this", "is", "1", "then", "that", "is", "1"]),     // ── family 1: person
cl-w("I", 1, 0, ["I", "is", "the", "self", "that", "say"]), cl-w("you", 1, 1, ["you", "is", "the", "self", "I", "say", "to"]), cl-w("me", 1, 2, ["me", "is", "what", "you", "do", "to"]), cl-w("we", 1, 3, ["we", "is", "I", "and", "you", "or", "I", "and", "they"]), cl-w("us", 1, 4, ["us", "is", "what", "they", "do", "to", "we"]), cl-w("they", 1, 5, ["they", "is", "the", "self", "not", "I", "and", "not", "you"]), cl-w("it", 1, 6, ["it", "is", "a", "thing", "that", "is", "not", "a", "self"]), cl-w("self", 1, 7, ["self", "is", "what", "know", "it", "is"]),     // ── family 2: act
cl-w("do", 2, 0, ["do", "is", "when", "a", "self", "make", "a", "thing", "be", "other"]), cl-w("be", 2, 1, ["be", "is", "when", "a", "thing", "is"]), cl-w("exist", 2, 2, ["exist", "is", "when", "a", "thing", "is", "here", "now"]), cl-w("have", 2, 3, ["have", "is", "when", "a", "thing", "is", "part", "of", "a", "self"]), cl-w("know", 2, 4, ["know", "is", "when", "a", "self", "is", "same", "as", "what", "is"]), cl-w("want", 2, 5, ["want", "is", "when", "a", "self", "say", "a", "thing", "be", "other"]), cl-w("say", 2, 6, ["say", "is", "when", "a", "self", "make", "you", "know"]), cl-w("make", 2, 7, ["make", "is", "when", "a", "self", "do", "a", "thing", "be"]),     // ── family 3: ask — the eight lanes
cl-w("what", 3, 0, ["what", "is", "when", "you", "want", "to", "know", "a", "thing"]), cl-w("who", 3, 1, ["who", "is", "when", "you", "want", "to", "know", "a", "self"]), cl-w("when", 3, 2, ["when", "is", "when", "you", "want", "to", "know", "now", "or", "then"]), cl-w("where", 3, 3, ["where", "is", "when", "you", "want", "to", "know", "here", "or", "there"]), cl-w("how", 3, 4, ["how", "is", "when", "you", "want", "to", "know", "a", "way"]), cl-w("why", 3, 5, ["why", "is", "when", "you", "want", "to", "know", "what", "make", "a", "thing", "be"]), cl-w("which", 3, 6, ["which", "is", "when", "you", "want", "to", "know", "what", "part", "of", "many"]), cl-w("whether", 3, 7, ["whether", "is", "when", "you", "want", "to", "know", "0", "or", "1"]),     // ── family 4: time
cl-w("now", 4, 0, ["now", "is", "when", "a", "thing", "is"]), cl-w("then", 4, 1, ["then", "is", "not", "now"]), cl-w("before", 4, 2, ["before", "is", "when", "a", "thing", "is", "and", "then", "other", "is"]), cl-w("after", 4, 3, ["after", "is", "when", "a", "thing", "is", "not", "yet", "and", "then", "it", "is"]), cl-w("still", 4, 4, ["still", "is", "when", "a", "thing", "is", "now", "and", "was", "before"]), cl-w("yet", 4, 5, ["yet", "is", "when", "a", "thing", "is", "not", "now", "and", "after", "it", "is"]), cl-w("again", 4, 6, ["again", "is", "when", "a", "thing", "is", "not", "and", "after", "is"]), cl-w("never", 4, 7, ["never", "is", "when", "a", "thing", "is", "not", "now", "and", "not", "after"]),     // ── family 5: place
cl-w("here", 5, 0, ["here", "is", "where", "I", "am"]), cl-w("there", 5, 1, ["there", "is", "not", "here"]), cl-w("in", 5, 2, ["in", "is", "when", "a", "thing", "is", "part", "of", "other"]), cl-w("out", 5, 3, ["out", "is", "when", "a", "thing", "is", "not", "in"]), cl-w("at", 5, 4, ["at", "is", "where", "a", "thing", "is"]), cl-w("from", 5, 5, ["from", "is", "where", "a", "thing", "is", "before", "it", "do"]), cl-w("to", 5, 6, ["to", "is", "where", "a", "thing", "is", "after", "it", "do"]), cl-w("between", 5, 7, ["between", "is", "in", "from", "and", "to"]),     // ── family 6: degree
cl-w("all", 6, 0, ["all", "is", "the", "whole"]), cl-w("some", 6, 1, ["some", "is", "part", "of", "all", "and", "not", "none"]), cl-w("none", 6, 2, ["none", "is", "not", "some"]), cl-w("many", 6, 3, ["many", "is", "more", "than", "few"]), cl-w("few", 6, 4, ["few", "is", "less", "than", "many"]), cl-w("more", 6, 5, ["more", "is", "not", "less"]), cl-w("less", 6, 6, ["less", "is", "not", "more"]), cl-w("very", 6, 7, ["very", "is", "more", "than", "more"]),     // ── family 7: relation
cl-w("same", 7, 0, ["same", "is", "when", "this", "and", "that", "are", "1", "thing"]), cl-w("other", 7, 1, ["other", "is", "not", "same"]), cl-w("like", 7, 2, ["like", "is", "when", "this", "and", "that", "are", "same", "in", "part"]), cl-w("part", 7, 3, ["part", "is", "in", "a", "whole"]), cl-w("whole", 7, 4, ["whole", "is", "all", "part", "of", "a", "thing"]), cl-w("thing", 7, 5, ["thing", "is", "what", "is"]), cl-w("way", 7, 6, ["way", "is", "how", "a", "thing", "do"]), cl-w("kind", 7, 7, ["kind", "is", "what", "many", "thing", "are", "like"]));
    def cl-count() = len(cl-lexicon());
    //; ── the closure check ───────────────────────────────────────────
    //; glue: named, small, and counted — never a silent allowance
    def cl-glue() = ["the", "a", "an", "of", "this", "that", "am", "are", "than", "as", "was", "then"];
    def cl-in-list?(xs, w) = (Comparable) len(xs) == 0 ? 0 : (String) head(xs) == w ? 1 : cl-in-list?(tail(xs), w);
    def cl-is-word-loop(rs, w) = (Comparable) len(rs) == 0 ? 0 : (String) cl-word(head(rs)) == w ? 1 : cl-is-word-loop(tail(rs), w);
    def cl-is-word?(w) = cl-is-word-loop(cl-lexicon(), w);
    def cl-ok-token?(w) = (Comparable) cl-is-word?(w) == 1 ? 1 : cl-in-list?(cl-glue(), w);
    //; how many tokens across all 64 definitions fall outside core-plus-glue
    def cl-bad-in-def(toks) = (Comparable) len(toks) == 0 ? 0 : ((Comparable) cl-ok-token?(head(toks)) == 1 ? 0 : 1) + cl-bad-in-def(tail(toks));
    def cl-bad-loop(rs) = (Comparable) len(rs) == 0 ? 0 : cl-bad-in-def(cl-def(head(rs))) + cl-bad-loop(tail(rs));
    def cl-outside-count() = cl-bad-loop(cl-lexicon());
    def cl-closed?() = (Comparable) cl-outside-count() == 0 ? 1 : 0;
    //; total definition tokens — the size of the grounded surface
    def cl-tok-loop(rs) = (Comparable) len(rs) == 0 ? 0 : len(cl-def(head(rs))) + cl-tok-loop(tail(rs));
    def cl-token-count() = cl-tok-loop(cl-lexicon());
    //; the words no definition reaches for — a word nothing else needs
    def cl-used-in?(toks, w) = cl-in-list?(toks, w);
    def cl-used-loop(rs, w) = (Comparable) len(rs) == 0 ? 0 : (Comparable) cl-used-in?(cl-def(head(rs)), w) == 1 ? 1 : cl-used-loop(tail(rs), w);
    def cl-used?(w) = cl-used-loop(cl-lexicon(), w);
    //; ── index arithmetic over the 64 ────────────────────────────────
    def cl-at-loop(rs, i) = (Comparable) i == 0 ? head(rs) : cl-at-loop(tail(rs), i - 1);
    def cl-at(i) = cl-at-loop(cl-lexicon(), i);
    def cl-index-of-loop(rs, w, i) = (Comparable) len(rs) == 0 ? 0 - 1 : (String) cl-word(head(rs)) == w ? i : cl-index-of-loop(tail(rs), w, i + 1);
    def cl-index-of(w) = cl-index-of-loop(cl-lexicon(), w, 0);
    def cl-fam-of(i) = i / 8;
    def cl-idx-of(i) = i % 8;
    //; ── the terminal arms, as negative states ───────────────────────
    //; -1 nothing, -2 zero, -3 one. A non-negative value is a word: a NODE, and
    //; a node is what keeps a conversation going.
    def cl-t-nothing() = 0 - 1;
    def cl-t-zero() = 0 - 2;
    def cl-t-one() = 0 - 3;
    def cl-terminal?(s) = s < 0 ? 1 : 0;
    //; ── the eight lanes ─────────────────────────────────────────────
    //; why walks one family toward the ground; at the ground there is no floor
    //; under the floor, so it answers nothing.
    def cl-lane-why(i) = (Comparable) cl-fam-of(i) == 0 ? cl-t-nothing() : (cl-fam-of(i) - 1) * 8 + cl-idx-of(i);
    //; which walks the family ring
    def cl-lane-which(i) = cl-fam-of(i) * 8 + (cl-idx-of(i) + 1) % 8;
    //; the five that name a fixed cell
    def cl-lane-what(i) = cl-index-of("thing");
    def cl-lane-who(i) = cl-index-of("self");
    def cl-lane-when(i) = cl-index-of("now");
    def cl-lane-where(i) = cl-index-of("here");
    def cl-lane-how(i) = cl-index-of("way");
    //; whether is the one lane that ends it: a truth, never a thing
    def cl-lane-whether(i) = (Comparable) cl-fam-of(i) == 0 ? cl-t-one() : cl-t-zero();
    def cl-lane-names() = ["what", "who", "when", "where", "how", "why", "which", "whether"];
    def cl-step(lane, i) = (String) lane == "why" ? cl-lane-why(i) : (String) lane == "which" ? cl-lane-which(i) : (String) lane == "what" ? cl-lane-what(i) : (String) lane == "who" ? cl-lane-who(i) : (String) lane == "when" ? cl-lane-when(i) : (String) lane == "where" ? cl-lane-where(i) : (String) lane == "how" ? cl-lane-how(i) : cl-lane-whether(i);
    //; a lane is terminal when it answers with a state from EVERY word
    def cl-lane-term-loop(lane, i) = i >= 64 ? 1 : (Comparable) cl-terminal?(cl-step(lane, i)) == 1 ? cl-lane-term-loop(lane, i + 1) : 0;
    def cl-lane-terminal?(lane) = cl-lane-term-loop(lane, 0);
    def cl-term-count-loop(ls) = (Comparable) len(ls) == 0 ? 0 : cl-lane-terminal?(head(ls)) + cl-term-count-loop(tail(ls));
    def cl-lane-terminal-count() = cl-term-count-loop(cl-lane-names());
    //; ── the chain: query and response taking turns ──────────────────
    //; Once a terminal is reached the chain rests — a state is not a thing to
    //; ask about, so it cannot become the next query (axiom-5).
    def cl-walk(lane, s, n) = (Comparable) n == 0 ? s : (Comparable) cl-terminal?(s) == 1 ? s : cl-walk(lane, cl-step(lane, s), n - 1);
    //; how many layers until it rests; 99 when it never does within max
    def cl-depth-loop(lane, s, n, max) = (Comparable) cl-terminal?(s) == 1 ? n : n >= max ? 99 : cl-depth-loop(lane, cl-step(lane, s), n + 1, max);
    def cl-depth(lane, start, max) = cl-depth-loop(lane, start, 0, max);
    //; ── the universal claim: every why-regress bottoms out ──────────
    def cl-why-all-loop(i, worst) = i >= 64 ? worst : {
        let d = cl-depth("why", i, 12);
        cl-why-all-loop(i + 1, d > worst ? d : worst);
    };
    //; the deepest any of the 64 has to go before the ground answers nothing
    def cl-why-deepest() = cl-why-all-loop(0, 0);
    def cl-why-all-bottom-out?() = cl-why-deepest() <= 8 ? 1 : 0;
    //; and it rests in NOTHING, never in 1 — no floor under the floor
    def cl-why-rests-nothing-loop(i) = i >= 64 ? 1 : (Comparable) cl-walk("why", i, 12) == cl-t-nothing() ? cl-why-rests-nothing-loop(i + 1) : 0;
    def cl-why-rests-in-nothing?() = cl-why-rests-nothing-loop(0);
    //; ── REVERSIBILITY: the test that separates a core concept from a
    //;    sequence, and therefore from time ─────────────────────────
    //; Urs: each node answered from core-plus-query is a new symbol or a
    //; sequence of symbols, which implies time — UNLESS the combination is
    //; reversible, and then it is a core concept without condition or
    //; separation.
    //;
    //; Made operational: a lane is reversible when it loses nothing — distinct
    //; words go to distinct answers and no answer is a terminal. Then the step
    //; is a renaming. You can walk it backwards, so it imposes no order, and
    //; with no order there is no before and after for it to live in. A lane
    //; that COLLAPSES two words onto one answer cannot be undone: the discarded
    //; distinction is exactly what you would need to go back, and needing to
    //; know what was thrown away IS the condition, and having a direction you
    //; can only travel one way IS the separation.
    //;
    //; So irreversibility is not a flaw in a query, it is the query's time-cost,
    //; and it is measurable: cl-lane-image-count says how many of the 64 answers
    //; survive. `which` keeps all 64 and costs nothing. `what` keeps 1 and
    //; discards everything — the most expensive question in the set, and the
    //; least informative answer, which is the same sentence said twice.
    //;
    //; The law falls out as a checkable equivalence rather than a claim:
    //;   reversible  <=>  the chain never rests (it cycles — no arrow)
    //;   irreversible <=> the chain reaches an end (an arrow, hence time)
    //; cl-law-holds? walks all eight lanes and finds the two sides agree.
    def cl-img-seen?(seen, s) = cl-in-list-int(seen, s);
    def cl-in-list-int(xs, v) = (Comparable) len(xs) == 0 ? 0 : (Comparable) head(xs) == v ? 1 : cl-in-list-int(tail(xs), v);
    def cl-img-loop(lane, i, seen, n) = i >= 64 ? n : {
        let s = cl-step(lane, i);
        (Comparable) cl-in-list-int(seen, s) == 1 ? cl-img-loop(lane, i + 1, seen, n) : cl-img-loop(lane, i + 1, cons(s, seen), n + 1);
    };
    //; how many distinct answers the lane can give across all 64 words
    def cl-lane-image-count(lane) = cl-img-loop(lane, 0, [], 0);
    //; injective: nothing collapsed — 64 words, 64 answers
    def cl-lane-injective?(lane) = (Comparable) cl-lane-image-count(lane) == 64 ? 1 : 0;
    //; and no answer may be a terminal, or the step left the vocabulary
    def cl-lane-noterm-loop(lane, i) = i >= 64 ? 1 : (Comparable) cl-terminal?(cl-step(lane, i)) == 1 ? 0 : cl-lane-noterm-loop(lane, i + 1);
    def cl-lane-reversible?(lane) = (Comparable) cl-lane-injective?(lane) == 1 ? cl-lane-noterm-loop(lane, 0) : 0;
    def cl-rev-count-loop(ls) = (Comparable) len(ls) == 0 ? 0 : cl-lane-reversible?(head(ls)) + cl-rev-count-loop(tail(ls));
    //; exactly one of the eight is a core concept; the other seven imply time
    def cl-reversible-count() = cl-rev-count-loop(cl-lane-names());
    //; closure under questioning: no lane answers with anything outside the 64
    //; (or a terminal). You cannot ask your way out of this vocabulary — which
    //; is what "without condition" means when it is said carefully.
    def cl-inrange?(s) = (Comparable) cl-terminal?(s) == 1 ? 1 : s < 64 ? 1 : 0;
    def cl-closed-lane-loop(lane, i) = i >= 64 ? 1 : (Comparable) cl-inrange?(cl-step(lane, i)) == 1 ? cl-closed-lane-loop(lane, i + 1) : 0;
    def cl-closed-all-loop(ls) = (Comparable) len(ls) == 0 ? 1 : (Comparable) cl-closed-lane-loop(head(ls), 0) == 1 ? cl-closed-all-loop(tail(ls)) : 0;
    def cl-lanes-closed?() = cl-closed-all-loop(cl-lane-names());
    //; ── the four things a twelve-layer chain can do ─────────────────
    def cl-fix?(lane, start) =     // settles and never moves again
(Comparable) cl-walk(lane, start, 2) == cl-walk(lane, start, 12) ? 1 : 0;
    def cl-alive-at-12?(lane, start) =     // still a node after twelve layers
(Comparable) cl-terminal?(cl-walk(lane, start, 12)) == 1 ? 0 : 1;
    def cl-cycles?(lane, start, period) = (Comparable) cl-walk(lane, start, period) == start ? 1 : 0;
    //; THE LAW, as an equivalence walked over every lane and every word:
    //; a lane is reversible exactly when its chains never rest.
    //; "you can get back" is the whole of it: a chain returns to where it
    //; started. `what` shows why a weaker test will not do — it collapses onto
    //; `thing`, a fixed point that is still a NODE, so the chain never rests
    //; and yet nothing can be recovered. Not-resting is not reversibility.
    //; Returning is. (A ring of 8 closes within 16, so the search is bounded.)
    def cl-ret-loop(lane, i, k) = k > 16 ? 0 : (Comparable) cl-walk(lane, i, k) == i ? 1 : cl-ret-loop(lane, i, k + 1);
    def cl-word-returns?(lane, i) = cl-ret-loop(lane, i, 1);
    def cl-lane-returns-loop(lane, i) = i >= 64 ? 1 : (Comparable) cl-word-returns?(lane, i) == 1 ? cl-lane-returns-loop(lane, i + 1) : 0;
    def cl-lane-returns?(lane) = cl-lane-returns-loop(lane, 0);
    def cl-law-loop(ls) = (Comparable) len(ls) == 0 ? 1 : (Comparable) cl-lane-reversible?(head(ls)) == cl-lane-returns?(head(ls)) ? cl-law-loop(tail(ls)) : 0;
    //; reversible <=> every chain returns; irreversible <=> an arrow, so time
    def cl-law-holds?() = cl-law-loop(cl-lane-names());
    //; ── the band's eighteen readings ────────────────────────────────
    //; BIT weights, not decimal-digit weights, and for a measured reason: the
    //; first version of this fold used powers of ten and reached 10^17, which
    //; is past 2^53 — the largest integer a JavaScript double holds exactly.
    //; Go, Rust and fkwu agreed on 111111111111111111; the TypeScript arm
    //; answered 111111111111111120, the nearest double. Every underlying
    //; scalar was identical on all four arms; only the ENCODING diverged.
    //; Powers of two keep an 18-reading verdict at 262143, exact everywhere —
