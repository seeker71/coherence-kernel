        def nmtf-snapshot-path(root, publisher) = fs-path-join(root, str_concat(publisher, NMTFSnapshotSuffix()));
        def nmtf-candidate-path(root, publisher) = fs-path-join(root, str_concat(publisher, ".model-flow-snapshot.candidate"));
        def nmtf-write-typed(root, publisher, snapshot) {
            let made = fs-mkdir(root);
            let candidate = nmtf-candidate-path(root, publisher);
            let path = nmtf-snapshot-path(root, publisher);
            let wrote = fs-write-text(candidate, nmtf-snapshot-wire(snapshot));
            let moved = if ge(wrote, 0) then fs-rename(candidate, path) else -1;
            if and(ge(wrote, 0), eq(moved, 0)) then list("model-flow-typed-publish-v1", "published", path, wrote, snapshot) else list("model-flow-typed-publish-v1", "failed", candidate, wrote, snapshot);
        }
        def nmtf-publish-events(root, publisher, epoch, events) {
