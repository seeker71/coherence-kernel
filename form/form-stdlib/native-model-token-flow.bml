        def nmtf-event-fields-valid?(event) = if not(eq(nmtf-node-field-valid?(nmtf-event-parent(event)), 1)) then 0 else if not(eq(fgtm-label-field-valid?(nmtf-event-tensor-name(event)), 1)) then 0 else if not(eq(fgtm-label-field-valid?(nmtf-event-metal-pipeline(event)), 1)) then 0 else if not(eq(fgtm-numeric-field-valid?(nmtf-event-token-position(event)), 1)) then 0 else if not(eq(fgtm-numeric-field-valid?(nmtf-event-token-id(event)), 1)) then 0 else if not(eq(fgtm-numeric-field-valid?(nmtf-event-layer-index(event)), 1)) then 0 else if not(eq(fgtm-numeric-field-valid?(nmtf-event-tensor-bytes(event)), 1)) then 0 else if not(eq(fgtm-numeric-field-valid?(nmtf-event-expert-index(event)), 1)) then 0 else if not(eq(fgtm-numeric-field-valid?(nmtf-event-expert-weight-ppm(event)), 1)) then 0 else if and(eq(fgtm-field-present?(nmtf-event-expert-weight-ppm(event)), 1), gt(fgtm-field-value(nmtf-event-expert-weight-ppm(event)), 1000000)) then 0 else if not(eq(fgtm-numeric-field-valid?(nmtf-event-metal-handle(event)), 1)) then 0 else if not(eq(fgtm-numeric-field-valid?(nmtf-event-framebuffer-node(event)), 1)) then 0 else if not(eq(fgtm-numeric-field-valid?(nmtf-event-start-us(event)), 1)) then 0 else if not(eq(fgtm-numeric-field-valid?(nmtf-event-end-us(event)), 1)) then 0 else if not(eq(fgtm-numeric-field-valid?(nmtf-event-duration-us(event)), 1)) then 0 else nmtf-time-order-valid?(event);
