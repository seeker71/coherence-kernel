        def nmtf-snapshot(publisher, epoch, events) = list(NMTFSnapshotSchema(), publisher, epoch, events);
        def nmtf-snapshot-publisher(snapshot) = nth(snapshot, 1);
        def nmtf-snapshot-epoch(snapshot) = nth(snapshot, 2);
        def nmtf-snapshot-events(snapshot) = nth(snapshot, 3);
        def nmtf-events-publisher?(events, publisher) = if eq(len(events), 0) then 1 else if not(str_eq(nmtf-event-publisher(head(events)), publisher)) then 0 else nmtf-events-publisher?(tail(events), publisher);
        def nmtf-snapshot-valid?(snapshot) = if not(eq(len(snapshot), 4)) then 0 else if not(str_eq(head(snapshot), NMTFSnapshotSchema())) then 0 else if not(eq(fgtm-channel-id?(nmtf-snapshot-publisher(snapshot)), 1)) then 0 else if lt(nmtf-snapshot-epoch(snapshot), 0) then 0 else if not(eq(nmtf-events-valid?(nmtf-snapshot-events(snapshot)), 1)) then 0 else if not(eq(nmtf-events-publisher?(nmtf-snapshot-events(snapshot), nmtf-snapshot-publisher(snapshot)), 1)) then 0 else nmtf-events-chain?(nmtf-snapshot-events(snapshot));
