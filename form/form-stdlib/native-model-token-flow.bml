        def nmtf-events-chain?(events) = if eq(len(events), 0) then 1 else if not(eq(nmtf-event-root?(head(events)), 1)) then 0 else nmtf-events-chain-tail?(events);

        def nmtf-event-wire(event) = fgtm-cat(list("event|", nmtf-event-node-id(event), "|", fgtm-label-field-wire(nmtf-event-parent(event)), "|", nmtf-event-publisher(event), "|", nmtf-event-flow-id(event), "|", nmtf-event-stage(event), "|", int_to_str(nmtf-event-sequence(event)), "|", nmtf-event-owner(event), "|", nmtf-event-model(event), "|", fgtm-field-wire(nmtf-event-token-position(event)), "|", fgtm-field-wire(nmtf-event-token-id(event)), "|", fgtm-field-wire(nmtf-event-layer-index(event)), "|", fgtm-label-field-wire(nmtf-event-tensor-name(event)), "|", fgtm-field-wire(nmtf-event-tensor-bytes(event)), "|", fgtm-field-wire(nmtf-event-expert-index(event)), "|", fgtm-field-wire(nmtf-event-expert-weight-ppm(event)), "|", fgtm-label-field-wire(nmtf-event-metal-pipeline(event)), "|", fgtm-field-wire(nmtf-event-metal-handle(event)), "|", fgtm-field-wire(nmtf-event-framebuffer-node(event)), "|", fgtm-field-wire(nmtf-event-start-us(event)), "|", fgtm-field-wire(nmtf-event-end-us(event)), "|", fgtm-field-wire(nmtf-event-duration-us(event)), "|", int_to_str(nmtf-event-epoch(event)), "|", nmtf-event-lifecycle(event), "|", nmtf-event-evidence(event), "|", nmtf-event-source(event)));
