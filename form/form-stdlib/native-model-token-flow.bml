        def nmtf-number-purpose(prefix, field) = if eq(fgtm-field-present?(field), 1) then str_concat(prefix, int_to_str(fgtm-field-value(field))) else str_concat(prefix, "absent");
        def nmtf-event-purpose(event) = if str_eq(nmtf-event-stage(event), "token") then nmtf-number-purpose("tok-", nmtf-event-token-id(event)) else if str_eq(nmtf-event-stage(event), "layer") then nmtf-number-purpose("layer-", nmtf-event-layer-index(event)) else if str_eq(nmtf-event-stage(event), "tensor") then if eq(fgtm-field-present?(nmtf-event-tensor-name(event)), 1) then fgtm-field-value(nmtf-event-tensor-name(event)) else "tensor-name-absent" else if str_eq(nmtf-event-stage(event), "expert") then nmtf-number-purpose("expert-", nmtf-event-expert-index(event)) else if str_eq(nmtf-event-stage(event), "metal") then if eq(fgtm-field-present?(nmtf-event-metal-pipeline(event)), 1) then fgtm-field-value(nmtf-event-metal-pipeline(event)) else "pipeline-absent" else if str_eq(nmtf-event-stage(event), "framebuffer") then nmtf-number-purpose("node-", nmtf-event-framebuffer-node(event)) else nmtf-event-model(event);
        def nmtf-event-capacity(event) = if str_eq(nmtf-event-stage(event), "token") then nmtf-event-token-position(event) else if str_eq(nmtf-event-stage(event), "layer") then nmtf-event-layer-index(event) else if str_eq(nmtf-event-stage(event), "expert") then nmtf-event-expert-index(event) else if str_eq(nmtf-event-stage(event), "metal") then nmtf-event-duration-us(event) else if str_eq(nmtf-event-stage(event), "framebuffer") then nmtf-event-framebuffer-node(event) else if str_eq(nmtf-event-stage(event), "glass") then fgtm-present(nmtf-event-sequence(event)) else if str_eq(nmtf-event-stage(event), "request") then fgtm-present(nmtf-event-sequence(event)) else fgtm-absent();
