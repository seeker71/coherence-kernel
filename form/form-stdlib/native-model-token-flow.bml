            if not(eq(fgtm-root-valid?(root), 1)) then nmtf-snapshot-refused("root") else if not(eq(fgtm-channel-id?(publisher), 1)) then nmtf-snapshot-refused("publisher") else if eq(fs-exists?(path), 0) then nmtf-snapshot-refused("absent") else if gt(file_size(path), FGTMMaxSnapshotWireBytes()) then nmtf-snapshot-refused("oversize") else nmtf-read-typed-parsed(publisher, nmtf-parse-snapshot-wire(fs-read-text(path)));
        }
        def nmtf-read-typed-parsed(publisher, parsed) = if not(eq(len(parsed), 4)) then parsed else if str_eq(nmtf-snapshot-publisher(parsed), publisher) then parsed else nmtf-snapshot-refused("publisher-mismatch");
    }
    0;
}
