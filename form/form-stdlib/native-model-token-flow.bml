        def nmtf-parse-event-lines(lines) = if eq(len(lines), 0) then list() else cons(nmtf-parse-event-wire(head(lines)), nmtf-parse-event-lines(tail(lines)));
        def nmtf-snapshot-refused(reason) = list("native-model-token-flow-snapshot-refused-v1", reason);
        def nmtf-parse-snapshot-valid(header, lines) {
