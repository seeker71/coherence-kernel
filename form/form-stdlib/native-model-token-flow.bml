            if not(eq(len(fields), 26)) then nmtf-invalid-event() else if not(str_eq(head(fields), "event")) then nmtf-invalid-event() else if not(eq(fgtm-uint-text?(nth(fields, 6)), 1)) then nmtf-invalid-event() else if not(eq(fgtm-uint-text?(nth(fields, 22)), 1)) then nmtf-invalid-event() else nmtf-parse-event-fields(fields);
