        def nmtf-invalid-event() = list("native-model-token-flow-event-invalid-v1");
        def nmtf-parse-event-fields(fields) {
            let event = nmtf-event(nth(fields, 1), fgtm-parse-label-field(nth(fields, 2)), nth(fields, 3), nth(fields, 4), nth(fields, 5), str_to_int(nth(fields, 6)), nth(fields, 7), nth(fields, 8), fgtm-parse-number-field(nth(fields, 9)), fgtm-parse-number-field(nth(fields, 10)), fgtm-parse-number-field(nth(fields, 11)), fgtm-parse-label-field(nth(fields, 12)), fgtm-parse-number-field(nth(fields, 13)), fgtm-parse-number-field(nth(fields, 14)), fgtm-parse-number-field(nth(fields, 15)), fgtm-parse-label-field(nth(fields, 16)), fgtm-parse-number-field(nth(fields, 17)), fgtm-parse-number-field(nth(fields, 18)), fgtm-parse-number-field(nth(fields, 19)), fgtm-parse-number-field(nth(fields, 20)), fgtm-parse-number-field(nth(fields, 21)), str_to_int(nth(fields, 22)), nth(fields, 23), nth(fields, 24), nth(fields, 25));
