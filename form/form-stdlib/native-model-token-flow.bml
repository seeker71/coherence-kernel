        def nmtf-event-follows?(prior, event) = if not(str_eq(nmtf-event-publisher(prior), nmtf-event-publisher(event))) then 0 else if not(str_eq(nmtf-event-flow-id(prior), nmtf-event-flow-id(event))) then 0 else if not(str_eq(nmtf-event-owner(prior), nmtf-event-owner(event))) then 0 else if not(str_eq(nmtf-event-model(prior), nmtf-event-model(event))) then 0 else if not(ge(nmtf-stage-rank(nmtf-event-stage(event)), nmtf-stage-rank(nmtf-event-stage(prior)))) then 0 else if not(gt(nmtf-event-sequence(event), nmtf-event-sequence(prior))) then 0 else if eq(fgtm-field-present?(nmtf-event-parent(event)), 0) then 0 else str_eq(fgtm-field-value(nmtf-event-parent(event)), nmtf-event-node-id(prior));
