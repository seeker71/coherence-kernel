// native-host-instance.fk — one always-on host cell for Mac, Windows, and Android.
//
// This is the body shape the launchers point at: a native host instance listens,
// shares, transcribes when speech is present, detects salient surprises, learns
// from the stream, and chooses the next action from those readings. Shell,
// PowerShell, launchd, Android services, ffmpeg, Whisper, and OS drivers are
// host resource carriers only. The lifecycle decision is this Form recipe.
//
// Composes existing proven tissue:
//   host-sense-organ.fk       host resource/organ receipt
//   speech-organ.fk           VAD/transcription trust receipt
//   surprise-salience.fk      surprise ranking/counting
//   co-learning-stream.fk     online learning fold
//   mesh-dispatch.fk          share/ask/gold route decision
//
section [form.bml] {
    def nhi-platform-known?(platform) = (String) platform == "macos" || ((String) platform == "windows" || (String) platform == "android") ? 1 : 0;
    def nhi-listening?(host-rec) = len(hso-rec-organs(host-rec)) >= 8 ? 1 : 0;
    def nhi-sharing?(msg) = str_len(msg) > 0 ? 1 : 0;
    def nhi-share-route(msg) = (Comparable) nhi-sharing?(msg) == 1 ? md-route(msg) : "quiet";
    def nhi-transcribing?(speech-rec) = so-rec-gate(speech-rec) >= 2 ? 1 : 0;
    def nhi-surprise-count(surprises) = ss-count-salient(surprises, 50);
    def nhi-surprised?(surprises) = nhi-surprise-count(surprises) > 0 ? 1 : 0;
    def nhi-learning-count(samples) = len(cls-device(samples));
    def nhi-learning?(samples) = nhi-learning-count(samples) > 0 ? 1 : 0;
    def nhi-decision(platform, host-rec, speech-rec, surprises, samples, msg) = (Comparable) nhi-platform-known?(platform) == 0 ? "refuse-unsupported-host" : (Comparable) nhi-surprised?(surprises) == 1 ? "learn-from-surprise" : (String) nhi-share-route(msg) == "ask" ? "answer" : (Comparable) nhi-transcribing?(speech-rec) == 1 ? "append-transcript" : (Comparable) nhi-listening?(host-rec) == 1 ? "listen" : "open-listener";
    // Receipt layout:
    // (native-host-instance platform native? listening? sharing? transcribing?
    //  surprise-count learned-count decision share-route)
    def nhi-cycle(platform, host-rec, speech-rec, surprises, samples, msg) = ["native-host-instance", platform, nhi-platform-known?(platform), nhi-listening?(host-rec), nhi-sharing?(msg), nhi-transcribing?(speech-rec), nhi-surprise-count(surprises), nhi-learning-count(samples), nhi-decision(platform, host-rec, speech-rec, surprises, samples, msg), nhi-share-route(msg)];
    def nhi-rec-kind(r) = r[0];
    def nhi-rec-platform(r) = r[1];
    def nhi-rec-native?(r) = r[2];
    def nhi-rec-listening?(r) = r[3];
    def nhi-rec-sharing?(r) = r[4];
    def nhi-rec-transcribe?(r) = r[5];
    def nhi-rec-surprises(r) = r[6];
    def nhi-rec-learned(r) = r[7];
    def nhi-rec-decision(r) = r[8];
    def nhi-rec-share-route(r) = r[9];
    0;
}
