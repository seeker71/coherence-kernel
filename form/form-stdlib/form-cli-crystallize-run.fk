; form-cli-crystallize-run.fk — write the ice, read it back, print the show.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-crystallize.fk

(do
    (write_file_text (fcx-path) (str_concat (fcx-anyone-after) "\n"))
    (print "form-cli executed crystallize\n")
    (print "form-cli before-has=")
    (print (int_to_str (fcx-has? (fcx-anyone-before) "anyone-door")))
    (print " after-has=")
    (print (int_to_str (fcx-has? (fcx-anyone-after) "anyone-door")))
    (print " phase=")
    (print (int_to_str (fcx-phase (fcx-anyone-unit) (fcx-anyone-claim))))
    (print " ki=")
    (print (int_to_str (ki-ingest (fcx-anyone-unit))))
    (print " nbo=")
    (print (int_to_str (nbo-enter (fcx-anyone-claim))))
    (print " file-has=")
    (print (int_to_str (fcx-has? (read_file (fcx-path)) "anyone-door")))
    (print " check=")
    (print (int_to_str (fcx-check)))
    (print "\nform-cli ice=\n")
    (print (fcx-anyone-after))
    (print "\n")
    0)
