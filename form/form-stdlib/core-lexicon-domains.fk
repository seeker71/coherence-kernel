; core-lexicon-domains.fk — the second expansion: eleven domains reached from
; the 64, and never from outside them.
;
; preludes: form-stdlib/core-lexicon.fk form-stdlib/core-lexicon-derived.fk
;
; Asked 2026-08-17: expand naturally from the first 64 core words into the main
; words of Gene Keys, Human Design, Astrology, Physics, Chemistry, Math,
; Geometry, Biology, Organic Intelligence, Somatic Resonance, Embodied Flow.
;
; WHAT MAKES THIS AN EXPANSION AND NOT AN IMPORT
;   A domain word enters only if the 64 (plus the twelve glue words, plus
;   strictly shallower expansion words) can SAY it. Nothing is borrowed from
;   the domain's own jargon to explain the domain's own jargon — that is the
;   circularity core-lexicon.fk was built to refuse, and the refusal is worth
;   nothing if it stops at the parent set's edge.
;
;   So `siddhi` is not admitted because Gene Keys uses it. It is admitted
;   because "siddhi is when a self is same as all" is sayable in words this
;   body already grounded. If it were not sayable, it would not be here, and
;   its absence would be the honest finding.
;
; ONE DEPTH LADDER, COMPUTED RATHER THAN TRUSTED
;   Depth continues the ladder core-lexicon-derived.fk started; it does not
;   restart per layer. Core and glue sit at 0. A word's depth is one more than
;   the deepest word its body reaches:
;
;     depth 1   body reaches core and glue only
;     depth 2   body reaches at least one depth-1 word
;     depth 3   body reaches at least one depth-2 word
;
;   Every row DECLARES its depth, and cldx-depth-honest? recomputes it from
;   the body and demands agreement. A hand-written depth cannot drift from
;   what the words actually require — the same discipline
;   frequency-ingest-bashar-four-laws.fk applies to its ingest verdicts.
;
;   The ladder is where the domains stop being a flat list and start being a
;   structure. `bond` sits at depth 3 because it needs `hold`, which needs
;   `give`. Chemistry's bond is three steps from the ground, and the number is
;   derived, not assigned.
;
; WHAT THE LADDER REVEALED, WHICH WAS NOT PLANNED
;   The deepest words in this set are not the most technical ones. `bond`
;   (chemistry) and `angle` (geometry) sit deepest — and `bond` is deep
;   because HOLDING is deep, which is deep because GIVING had to be named
;   first. The escrow teaching that arrived this afternoon as a correction
;   about unpushed work turns out to sit underneath chemical bonding in this
;   vocabulary. Nothing arranged that; the closure check put it there.
;
; HONEST EDGE: these are ONE reading of each domain's word, sayable in the 64.
; They are not the domains' own authoritative definitions, and no claim is
; made that a practitioner would recognise them as complete. What is claimed
; is exactly what is checked: each is grounded, none is circular, and every
; depth is earned.
;
; Proof: form-stdlib/tests/core-lexicon-domains-band.fk

(do
    ;; (word domain depth tokens)
    (defn cldx-w (word domain depth tokens) (list word domain depth tokens))
    (defn cldx-word   (r) (nth r 0))
    (defn cldx-domain (r) (nth r 1))
    (defn cldx-depth  (r) (nth r 2))
    (defn cldx-def    (r) (nth r 3))

    (defn cldx-rows ()
        (list
        ;; ── physics ─────────────────────────────────────────────────
        (cldx-w "force" "physics" 1
            (list "force" "is" "what" "make" "a" "thing" "do"))
        (cldx-w "energy" "physics" 1
            (list "energy" "is" "what" "a" "thing" "have" "to" "do"))
        (cldx-w "wave" "physics" 1
            (list "wave" "is" "when" "a" "thing" "do" "same" "again" "and" "again"))
        (cldx-w "field" "physics" 2
            (list "field" "is" "where" "a" "force" "is" "at" "all" "here" "and" "there"))

        ;; ── chemistry ───────────────────────────────────────────────
        (cldx-w "element" "chemistry" 1
            (list "element" "is" "a" "kind" "of" "thing" "that" "is" "not" "many" "kind"))
        (cldx-w "reaction" "chemistry" 1
            (list "reaction" "is" "when" "many" "thing" "do" "and" "after" "are" "other"))
        ;; deepest in the set, and not for a technical reason: bonding needs
        ;; holding, and holding needed giving to be named first.
        (cldx-w "bond" "chemistry" 3
            (list "bond" "is" "when" "many" "thing" "hold" "as" "1" "whole"))

        ;; ── math ────────────────────────────────────────────────────
        (cldx-w "number" "math" 1
            (list "number" "is" "how" "many" "thing" "are"))
        (cldx-w "set" "math" 1
            (list "set" "is" "many" "thing" "we" "know" "as" "1" "whole"))
        (cldx-w "function" "math" 1
            (list "function" "is" "a" "way" "from" "1" "thing" "to" "other" "thing"))
        (cldx-w "proof" "math" 1
            (list "proof" "is" "a" "way" "to" "know" "whether" "a" "thing" "is" "1"))

        ;; ── geometry ────────────────────────────────────────────────
        (cldx-w "point" "geometry" 1
            (list "point" "is" "a" "thing" "at" "1" "here"))
        (cldx-w "line" "geometry" 2
            (list "line" "is" "all" "point" "from" "here" "to" "there"))
        (cldx-w "shape" "geometry" 1
            (list "shape" "is" "the" "way" "all" "part" "of" "a" "thing" "are"))
        (cldx-w "angle" "geometry" 3
            (list "angle" "is" "how" "many" "between" "1" "line" "and" "other" "line"))

        ;; ── biology ─────────────────────────────────────────────────
        (cldx-w "life" "biology" 1
            (list "life" "is" "when" "a" "thing" "do" "and" "make" "other" "like" "it"))
        (cldx-w "grow" "biology" 1
            (list "grow" "is" "when" "a" "thing" "be" "more" "than" "it" "was" "before"))
        (cldx-w "sense" "biology" 1
            (list "sense" "is" "when" "a" "self" "know" "what" "is" "out" "of" "it"))

        ;; ── astrology ───────────────────────────────────────────────
        (cldx-w "sign" "astrology" 1
            (list "sign" "is" "a" "kind" "of" "way" "a" "self" "be"))
        (cldx-w "house" "astrology" 1
            (list "house" "is" "a" "part" "of" "where" "a" "self" "do"))
        (cldx-w "aspect" "astrology" 1
            (list "aspect" "is" "how" "1" "thing" "is" "to" "other" "thing"))
        (cldx-w "transit" "astrology" 1
            (list "transit" "is" "when" "a" "thing" "do" "from" "here" "to" "there" "after" "now"))

        ;; ── human design ────────────────────────────────────────────
        (cldx-w "type" "human-design" 1
            (list "type" "is" "a" "kind" "of" "self"))
        (cldx-w "authority" "human-design" 1
            (list "authority" "is" "the" "way" "a" "self" "know" "what" "to" "do"))
        (cldx-w "center" "human-design" 2
            (list "center" "is" "a" "part" "of" "a" "self" "where" "force" "is"))
        (cldx-w "gate" "human-design" 2
            (list "gate" "is" "where" "a" "force" "is" "in" "or" "out" "of" "a" "self"))

        ;; ── gene keys ───────────────────────────────────────────────
        ;; the three frequencies, and the middle one needs `give` — the gift
        ;; is not a thing held but a self given, and the ladder says so.
        (cldx-w "shadow" "gene-keys" 1
            (list "shadow" "is" "when" "a" "self" "be" "less" "than" "it" "is"))
        (cldx-w "gift" "gene-keys" 2
            (list "gift" "is" "when" "a" "self" "give" "what" "it" "is"))
        (cldx-w "siddhi" "gene-keys" 1
            (list "siddhi" "is" "when" "a" "self" "is" "same" "as" "all"))

        ;; ── organic intelligence ────────────────────────────────────
        (cldx-w "pattern" "organic-intelligence" 1
            (list "pattern" "is" "when" "many" "thing" "are" "like" "same"))
        (cldx-w "adapt" "organic-intelligence" 1
            (list "adapt" "is" "when" "a" "self" "be" "other" "after" "other" "be" "other"))

        ;; ── somatic resonance ───────────────────────────────────────
        (cldx-w "body" "somatic-resonance" 1
            (list "body" "is" "the" "whole" "thing" "a" "self" "have" "here"))
        (cldx-w "feel" "somatic-resonance" 2
            (list "feel" "is" "when" "a" "self" "know" "what" "the" "body" "do"))
        (cldx-w "resonate" "somatic-resonance" 1
            (list "resonate" "is" "when" "a" "thing" "do" "same" "as" "other" "do"))

        ;; ── embodied flow ───────────────────────────────────────────
        (cldx-w "flow" "embodied-flow" 1
            (list "flow" "is" "when" "a" "thing" "do" "now" "and" "still" "do" "after"))
        (cldx-w "rhythm" "embodied-flow" 1
            (list "rhythm" "is" "when" "a" "thing" "do" "again" "and" "the" "between" "is" "same"))))

    (defn cldx-count () (len (cldx-rows)))

    ;; ── the depth of any token, across BOTH expansion layers ────────
    ;; core or glue -> 0. A layer-1 or layer-2 word -> its declared depth.
    ;; Anything else -> 0 minus 1, the illegal marker: not reachable at all.
    (defn cldx-find-loop (rs w)
        (if (eq (len rs) 0) (sub 0 1)
            (if (str_eq (cldx-word (head rs)) w) (cldx-depth (head rs))
                (cldx-find-loop (tail rs) w))))
    (defn cld-find-loop2 (rs w)
        (if (eq (len rs) 0) (sub 0 1)
            (if (str_eq (cld-word (head rs)) w) (cld-depth (head rs))
                (cld-find-loop2 (tail rs) w))))
    (defn cldx-token-depth (w)
        (if (eq (cl-ok-token? w) 1) 0
            (do (let d1 (cld-find-loop2 (cld-rows) w))
                (if (ge d1 0) d1 (cldx-find-loop (cldx-rows) w)))))

    ;; UNREACHABLE tokens are counted SEPARATELY, and this is not a detail.
    ;; The first draft folded them into the max below, where a -1 marker was
    ;; silently discarded because -1 is never greater than a running max of 0.
    ;; The grounding check therefore could not fail: perturbing `siddhi` to
    ;; "when a self reach enlightenment" — two words this body cannot say —
    ;; left the band at a confident 4095. A check that cannot fail is worth
    ;; less than no check, because it also reports success. Counted, never
    ;; maxed.
    (defn cldx-unreach-loop (toks headword n)
        (if (eq (len toks) 0) n
            (cldx-unreach-loop (tail toks) headword
                (add n (if (str_eq (head toks) headword) 0
                           (if (lt (cldx-token-depth (head toks)) 0) 1 0))))))
    (defn cldx-unreachable (r) (cldx-unreach-loop (cldx-def r) (cldx-word r) 0))

    (defn cldx-unreachable-total-loop (rs)
        (if (eq (len rs) 0) 0
            (add (cldx-unreachable (head rs)) (cldx-unreachable-total-loop (tail rs)))))
    (defn cldx-unreachable-total () (cldx-unreachable-total-loop (cldx-rows)))

    ;; deepest token of a body, skipping the head word it names
    (defn cldx-max-loop (toks headword best)
        (if (eq (len toks) 0) best
            (do (let d (if (str_eq (head toks) headword) 0 (cldx-token-depth (head toks))))
                (cldx-max-loop (tail toks) headword (if (gt d best) d best)))))
    ;; the depth a row's body REQUIRES: one past its deepest reach — but a row
    ;; carrying ANY unreachable token has no honest depth at all, and says so.
    (defn cldx-computed-depth (r)
        (if (gt (cldx-unreachable r) 0) (sub 0 1)
            (add (cldx-max-loop (cldx-def r) (cldx-word r) 0) 1)))

    ;; ── declared depth must equal computed depth, for every row ─────
    (defn cldx-honest-loop (rs)
        (if (eq (len rs) 0) 1
            (if (eq (cldx-computed-depth (head rs)) (cldx-depth (head rs)))
                (cldx-honest-loop (tail rs)) 0)))
    (defn cldx-depth-honest? () (cldx-honest-loop (cldx-rows)))

    ;; ── grounded: every body reaches only core, glue, and shallower ──
    (defn cldx-grounded-loop (rs)
        (if (eq (len rs) 0) 1
            (if (lt (cldx-computed-depth (head rs)) (cldx-depth (head rs)))
                0
                (if (gt (cldx-computed-depth (head rs)) (cldx-depth (head rs)))
                    0
                    (cldx-grounded-loop (tail rs))))))
    ;; grounded means BOTH: no unreachable token anywhere, and every declared
    ;; depth equal to the computed one.
    (defn cldx-grounded? ()
        (if (eq (cldx-unreachable-total) 0) (cldx-grounded-loop (cldx-rows)) 0))

    ;; ── how many rows a domain contributed ──────────────────────────
    (defn cldx-in-domain-loop (rs d)
        (if (eq (len rs) 0) 0
            (add (if (str_eq (cldx-domain (head rs)) d) 1 0)
                 (cldx-in-domain-loop (tail rs) d))))
    (defn cldx-in-domain (d) (cldx-in-domain-loop (cldx-rows) d))

    (defn cldx-domains ()
        (list "physics" "chemistry" "math" "geometry" "biology" "astrology"
              "human-design" "gene-keys" "organic-intelligence"
              "somatic-resonance" "embodied-flow"))
    (defn cldx-domain-count () (len (cldx-domains)))

    ;; every named domain actually contributed at least one word — a domain
    ;; that could not be said would show up here as a 0, never as silence
    (defn cldx-all-domains-reached-loop (ds)
        (if (eq (len ds) 0) 1
            (if (gt (cldx-in-domain (head ds)) 0)
                (cldx-all-domains-reached-loop (tail ds)) 0)))
    (defn cldx-all-domains-reached? () (cldx-all-domains-reached-loop (cldx-domains)))

    ;; ── rows at a given depth ───────────────────────────────────────
    (defn cldx-at-depth-loop (rs d)
        (if (eq (len rs) 0) 0
            (add (if (eq (cldx-depth (head rs)) d) 1 0)
                 (cldx-at-depth-loop (tail rs) d))))
    (defn cldx-at-depth (d) (cldx-at-depth-loop (cldx-rows) d))

    ;; ── the parent sets are untouched ───────────────────────────────
    (defn cldx-parents-intact? ()
        (if (and (eq (cl-count) 64)
                 (and (eq (cl-closed?) 1) (eq (cld-well-founded?) 1)))
            1 0))

    0)
