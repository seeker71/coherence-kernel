; living-world-hypothesis-revision-nursery.fk -- contradiction invites attempts.
;
; A current contradicted hypothesis tissue may receive optional participant
; Recipe attempts.  The nursery owns no mutation names, operator vocabulary,
; task, answer table, or synthesis oracle.  Every exact Recipe and option is
; offered data.  Recurrent attempts execute against every retained placement;
; their confirmations, divergences, unresolved observations, alternatives,
; unknowns, lenses, and provenance remain inspectable.
;
; Zero viable attempts leaves the field OPEN.  One becomes READY and several
; remain PLURAL, but no state selects, promotes, installs, or voices a Recipe.
; The whole attempt field crosses ordinary unanimous tending.  New offers or
; revocation change its identity and stale prior tissue without overwriting it.
;
; preludes: form-stdlib/core.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk

(let LWHRN-OFFER              (bp "LWHRN-OFFER"))
(let LWHRN-CANDIDATE          (bp "LWHRN-CANDIDATE"))
(let LWHRN-CANDIDATE-EVIDENCE (bp "LWHRN-CANDIDATE-EVIDENCE"))
(let LWHRN-EVALUATION         (bp "LWHRN-EVALUATION"))
(let LWHRN-TRIAL              (bp "LWHRN-TRIAL"))
(let LWHRN-FIELD              (bp "LWHRN-FIELD"))
(let LWHRN-OPEN               (bp "LWHRN-OPEN"))
(let LWHRN-READY              (bp "LWHRN-READY"))
(let LWHRN-PLURAL             (bp "LWHRN-PLURAL"))
(let LWHRN-ORIGIN             (bp "LWHRN-ORIGIN"))

(defn lwhrn-status (kind) (intern_node kind (empty)))
(defn lwhrn-open () (lwhrn-status LWHRN-OPEN))
(defn lwhrn-ready () (lwhrn-status LWHRN-READY))
(defn lwhrn-plural () (lwhrn-status LWHRN-PLURAL))
(defn lwhrn-open? (status) (if (node_eq status (lwhrn-open)) 1 0))
(defn lwhrn-ready? (status) (if (node_eq status (lwhrn-ready)) 1 0))
(defn lwhrn-plural? (status) (if (node_eq status (lwhrn-plural)) 1 0))

; children: contradicted tissue candidate, optional Recipe, optional
; declaration, optional lens, alternatives, optional unknown, optional choice,
; optional timeout, evidence, local path
(defn lwhrn-offer
    (target recipe declaration lens alternatives unknown choice timeout evidence)
    (intern_node LWHRN-OFFER
        (list target recipe declaration lens alternatives unknown choice timeout
              evidence (lwo-local-path))))
(defn lwhrn-offer? (cell) (lwo-category? cell LWHRN-OFFER))
(defn lwhrn-offer-target (offer) (nth (node_children offer) 0))
(defn lwhrn-offer-recipe (offer) (nth (node_children offer) 1))
(defn lwhrn-offer-declaration (offer) (nth (node_children offer) 2))
(defn lwhrn-offer-lens (offer) (nth (node_children offer) 3))
(defn lwhrn-offer-alternatives (offer) (nth (node_children offer) 4))
(defn lwhrn-offer-unknown (offer) (nth (node_children offer) 5))
(defn lwhrn-offer-choice (offer) (nth (node_children offer) 6))
(defn lwhrn-offer-timeout (offer) (nth (node_children offer) 7))
(defn lwhrn-offer-evidence (offer) (nth (node_children offer) 8))
(defn lwhrn-offer-path (offer) (nth (node_children offer) 9))

(defn lwhrn-optional-recipe-valid? (recipe)
    (if (node_eq recipe (lwo-none)) 1 (lwre-recipe-valid? recipe)))
(defn lwhrn-optional-declaration-valid? (declaration)
    (if (node_eq declaration (lwo-none)) 1
        (lwlc-declaration-valid? declaration)))
(defn lwhrn-optional-lens-valid? (lens)
    (if (node_eq lens (lwo-none)) 1 (lwlc-lens? lens)))
(defn lwhrn-optional-unknown-valid? (unknown)
    (if (or (node_eq unknown (lwo-none))
            (eq (lwlc-unknown? unknown) 1)) 1 0))
(defn lwhrn-optional-timeout-valid? (timeout)
    (if (node_eq timeout (lwo-none)) 1 (oac-timeout-valid? timeout)))
(defn lwhrn-offer-valid? (offer)
    (if (eq (lwhrn-offer? offer) 0) 0
        (if (eq (lwht-candidate? (lwhrn-offer-target offer)) 0) 0
            (if (eq (lwhrn-optional-recipe-valid?
                        (lwhrn-offer-recipe offer)) 0) 0
                (if (eq (lwhrn-optional-declaration-valid?
                            (lwhrn-offer-declaration offer)) 0) 0
                    (if (eq (lwhrn-optional-lens-valid?
                                (lwhrn-offer-lens offer)) 0) 0
                        (if (eq (lwo-category?
                                    (lwhrn-offer-alternatives offer)
                                    LWO-FIELD) 0) 0
                            (if (eq (lwhrn-optional-unknown-valid?
                                        (lwhrn-offer-unknown offer)) 0) 0
                                (if (eq (lwlc-choice-valid?
                                            (lwhrn-offer-choice offer)) 0) 0
                                    (lwhrn-optional-timeout-valid?
                                        (lwhrn-offer-timeout offer)))))))))))

; Evidence is intentionally absent from source-free candidate identity.
(defn lwhrn-candidate-for-offer (offer)
    (if (eq (lwhrn-offer-valid? offer) 0) (lwo-none)
        (intern_node LWHRN-CANDIDATE
            (list (lwhrn-offer-target offer) (lwhrn-offer-recipe offer)
                  (lwhrn-offer-declaration offer) (lwhrn-offer-lens offer)
                  (lwhrn-offer-alternatives offer)
                  (lwhrn-offer-unknown offer) (lwhrn-offer-choice offer)
                  (lwhrn-offer-timeout offer) (lwo-local-path)))))
(defn lwhrn-candidate? (cell) (lwo-category? cell LWHRN-CANDIDATE))
(defn lwhrn-candidate-target (candidate) (nth (node_children candidate) 0))
(defn lwhrn-candidate-recipe (candidate) (nth (node_children candidate) 1))
(defn lwhrn-candidate-declaration (candidate) (nth (node_children candidate) 2))
(defn lwhrn-candidate-lens (candidate) (nth (node_children candidate) 3))
(defn lwhrn-candidate-alternatives (candidate) (nth (node_children candidate) 4))
(defn lwhrn-candidate-unknown (candidate) (nth (node_children candidate) 5))
(defn lwhrn-candidate-choice (candidate) (nth (node_children candidate) 6))
(defn lwhrn-candidate-timeout (candidate) (nth (node_children candidate) 7))
(defn lwhrn-candidate-path (candidate) (nth (node_children candidate) 8))

(defn lwhrn-offer-current? (world offer target)
    (if (and (eq (lwhrn-offer-valid? offer) 1)
             (and (node_eq (lwhrn-offer-target offer) target)
                  (and (eq (lwo-active? world offer) 1)
                       (eq (lwht-integrated-current? world target) 1)))) 1 0))
(defn lwhrn-collect-offers (world items target field)
    (if (eq (len items) 0) field
        (lwhrn-collect-offers world (tail items) target
            (if (eq (lwhrn-offer-current?
                        world (head items) target) 1)
                (lwo-field-add field (head items)) field))))
(defn lwhrn-offers-for (world target)
    (lwhrn-collect-offers world
        (lwo-field-items (lwo-world-cells world)) target (lwo-empty-field)))

(defn lwhrn-candidate-evidence (candidate offers witnesses)
    (intern_node LWHRN-CANDIDATE-EVIDENCE
        (list candidate offers witnesses)))
(defn lwhrn-evidence-candidate (evidence) (nth (node_children evidence) 0))
(defn lwhrn-evidence-offers (evidence) (nth (node_children evidence) 1))
(defn lwhrn-evidence-witnesses (evidence) (nth (node_children evidence) 2))
(defn lwhrn-candidates-have? (items candidate)
    (if (eq (len items) 0) 0
        (if (node_eq (lwhrn-evidence-candidate (head items)) candidate) 1
            (lwhrn-candidates-have? (tail items) candidate))))
(defn lwhrn-evidence-for-candidate-items
    (world items candidate offers witnesses)
    (if (eq (len items) 0)
        (lwhrn-candidate-evidence candidate offers witnesses)
        (do
            (let offer (head items))
            (if (node_eq (lwhrn-candidate-for-offer offer) candidate)
                (lwhrn-evidence-for-candidate-items world (tail items) candidate
                    (lwo-field-add offers offer)
                    (lwph-field-union-items
                        (lwo-field-items
                            (lwo-active-attributions-for world offer))
                        witnesses))
                (lwhrn-evidence-for-candidate-items world (tail items) candidate
                    offers witnesses)))))
(defn lwhrn-collect-candidates (world all remaining field)
    (if (eq (len remaining) 0) field
        (do
            (let candidate (lwhrn-candidate-for-offer (head remaining)))
            (lwhrn-collect-candidates world all (tail remaining)
                (if (eq (lwhrn-candidates-have?
                            (lwo-field-items field) candidate) 1) field
                    (lwo-field-add field
                        (lwhrn-evidence-for-candidate-items world all candidate
                            (lwo-empty-field) (lwo-empty-field))))))))
(defn lwhrn-candidates-for (world offers)
    (do
        (let items (lwo-field-items offers))
        (lwhrn-collect-candidates world items items (lwo-empty-field))))

(defn lwhrn-candidate-recurrent? (evidence threshold)
    (if (and (not (node_eq
                    (lwhrn-candidate-recipe
                        (lwhrn-evidence-candidate evidence)) (lwo-none)))
             (ge (lwo-field-size
                    (lwhrn-evidence-witnesses evidence)) threshold)) 1 0))
(defn lwhrn-recurrent-items (items threshold field)
    (if (eq (len items) 0) field
        (lwhrn-recurrent-items (tail items) threshold
            (if (eq (lwhrn-candidate-recurrent?
                        (head items) threshold) 1)
                (lwo-field-add field (head items)) field))))

; children: exact placement candidate, output, comparison, state, local path
(defn lwhrn-evaluation (placement output comparison state)
    (intern_node LWHRN-EVALUATION
        (list placement output comparison state (lwo-local-path))))
(defn lwhrn-evaluation-placement (evaluation) (nth (node_children evaluation) 0))
(defn lwhrn-evaluation-output (evaluation) (nth (node_children evaluation) 1))
(defn lwhrn-evaluation-comparison (evaluation) (nth (node_children evaluation) 2))
(defn lwhrn-evaluation-state (evaluation) (nth (node_children evaluation) 3))
(defn lwhrn-evaluate-placement (recipe placement-candidate)
    (do
        (let placement (lwo-emergent-shape placement-candidate))
        (let probe (lwph-placement-probe placement))
        (let output
            (intern_trivial_int
                (lwre-evaluate-bound recipe (lwph-probe-bindings probe))))
        (let observed (lwph-probe-observed probe))
        (let ack (lwph-probe-ack probe))
        (if (or (node_eq observed (lwo-none))
                (eq (oac-one? ack) 0))
            (lwhrn-evaluation placement-candidate output (oac-nothing)
                (lwph-unresolved))
            (if (node_eq output observed)
                (lwhrn-evaluation placement-candidate output (oac-one output)
                    (lwph-consistent))
                (lwhrn-evaluation placement-candidate output
                    (oac-alternative-ack observed output probe)
                    (lwph-divergent))))))
(defn lwhrn-evaluations-items (recipe items field)
    (if (eq (len items) 0) field
        (lwhrn-evaluations-items recipe (tail items)
            (lwo-field-add field
                (lwhrn-evaluate-placement recipe (head items))))))
(defn lwhrn-evaluation-state-items
    (items any-consistent any-divergent any-unresolved)
    (if (eq (len items) 0)
        (if (eq any-divergent 1) (lwph-divergent)
            (if (and (eq any-consistent 1) (eq any-unresolved 0))
                (lwph-consistent) (lwph-unresolved)))
        (do
            (let state (lwhrn-evaluation-state (head items)))
            (lwhrn-evaluation-state-items (tail items)
                (if (eq (lwph-consistent? state) 1) 1 any-consistent)
                (if (eq (lwph-divergent? state) 1) 1 any-divergent)
                (if (eq (lwph-unresolved? state) 1) 1 any-unresolved)))))

; children: candidate evidence, every placement evaluation, state, local path
(defn lwhrn-trial-for (target evidence)
    (do
        (let evaluations
            (lwhrn-evaluations-items
                (lwhrn-candidate-recipe
                    (lwhrn-evidence-candidate evidence))
                (lwo-field-items
                    (lwht-tissue-placements
                        (lwo-emergent-shape target)))
                (lwo-empty-field)))
        (intern_node LWHRN-TRIAL
            (list evidence evaluations
                  (lwhrn-evaluation-state-items
                    (lwo-field-items evaluations) 0 0 0)
                  (lwo-local-path)))))
(defn lwhrn-trial? (cell) (lwo-category? cell LWHRN-TRIAL))
(defn lwhrn-trial-evidence (trial) (nth (node_children trial) 0))
(defn lwhrn-trial-evaluations (trial) (nth (node_children trial) 1))
(defn lwhrn-trial-state (trial) (nth (node_children trial) 2))
(defn lwhrn-trials-items (target items field)
    (if (eq (len items) 0) field
        (lwhrn-trials-items target (tail items)
            (lwo-field-add field (lwhrn-trial-for target (head items))))))
(defn lwhrn-filter-trials (items wanted field)
    (if (eq (len items) 0) field
        (lwhrn-filter-trials (tail items) wanted
            (if (node_eq (lwhrn-trial-state (head items)) wanted)
                (lwo-field-add field (head items)) field))))

(defn lwhrn-witnesses-items (items field)
    (if (eq (len items) 0) field
        (lwhrn-witnesses-items (tail items)
            (lwph-field-union-items
                (lwo-field-items
                    (lwhrn-evidence-witnesses (head items))) field))))
(defn lwhrn-witnesses (world target candidates)
    (lwhrn-witnesses-items (lwo-field-items candidates)
        (lwph-field-union-items
            (lwo-field-items (lwo-active-attributions-for world target))
            (lwo-emergent-witnesses target))))
(defn lwhrn-options-items (items alternatives unknowns)
    (if (eq (len items) 0) (list alternatives unknowns)
        (do
            (let candidate (lwhrn-evidence-candidate (head items)))
            (let next-alternatives
                (lwph-field-union-items
                    (lwo-field-items
                        (lwhrn-candidate-alternatives candidate)) alternatives))
            (let unknown (lwhrn-candidate-unknown candidate))
            (lwhrn-options-items (tail items) next-alternatives
                (if (node_eq unknown (lwo-none)) unknowns
                    (lwo-field-add unknowns unknown))))))

; children: contradicted target, all recurrent attempts, trials, viable,
; divergent, unresolved, OPEN/READY/PLURAL, alternatives, unknowns, witnesses,
; threshold, local path
(defn lwhrn-field-cell
    (target candidates trials viable divergent unresolved status alternatives
     unknowns witnesses threshold)
    (intern_node LWHRN-FIELD
        (list target candidates trials viable divergent unresolved status
              alternatives unknowns witnesses (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwhrn-field? (cell) (lwo-category? cell LWHRN-FIELD))
(defn lwhrn-field-target (field) (nth (node_children field) 0))
(defn lwhrn-field-candidates (field) (nth (node_children field) 1))
(defn lwhrn-field-trials (field) (nth (node_children field) 2))
(defn lwhrn-field-viable (field) (nth (node_children field) 3))
(defn lwhrn-field-divergent (field) (nth (node_children field) 4))
(defn lwhrn-field-unresolved (field) (nth (node_children field) 5))
(defn lwhrn-field-status (field) (nth (node_children field) 6))
(defn lwhrn-field-alternatives (field) (nth (node_children field) 7))
(defn lwhrn-field-unknowns (field) (nth (node_children field) 8))
(defn lwhrn-field-witnesses (field) (nth (node_children field) 9))
(defn lwhrn-field-threshold (field)
    (node_value (nth (node_children field) 10)))

(defn lwhrn-field-for (world target threshold)
    (if (or (lt threshold 1)
            (or (eq (lwht-integrated-current? world target) 0)
                (eq (lwht-contradicted?
                      (lwht-tissue-status
                        (lwo-emergent-shape target))) 0)))
        (lwo-none)
        (do
            (let offers (lwhrn-offers-for world target))
            (let all (lwhrn-candidates-for world offers))
            (let candidates
                (lwhrn-recurrent-items
                    (lwo-field-items all) threshold (lwo-empty-field)))
            (let trials
                (lwhrn-trials-items target
                    (lwo-field-items candidates) (lwo-empty-field)))
            (let viable
                (lwhrn-filter-trials (lwo-field-items trials)
                    (lwph-consistent) (lwo-empty-field)))
            (let divergent
                (lwhrn-filter-trials (lwo-field-items trials)
                    (lwph-divergent) (lwo-empty-field)))
            (let unresolved
                (lwhrn-filter-trials (lwo-field-items trials)
                    (lwph-unresolved) (lwo-empty-field)))
            (let count (lwo-field-size viable))
            (let status
                (if (eq count 1) (lwhrn-ready)
                    (if (gt count 1) (lwhrn-plural) (lwhrn-open))))
            (let options
                (lwhrn-options-items (lwo-field-items candidates)
                    (lwht-tissue-alternatives
                        (lwo-emergent-shape target))
                    (lwht-tissue-unknowns
                        (lwo-emergent-shape target))))
            (lwhrn-field-cell target candidates trials viable divergent
                unresolved status (nth options 0)
                (lwo-field-add (nth options 1) (lwlc-unknown trials))
                (lwhrn-witnesses world target candidates) threshold))))

(defn lwhrn-origin (target threshold)
    (intern_node LWHRN-ORIGIN
        (list target (intern_trivial_int threshold) (lwo-local-path))))
(defn lwhrn-origin-target (origin) (nth (node_children origin) 0))
(defn lwhrn-origin-threshold (origin)
    (node_value (nth (node_children origin) 1)))
(defn lwhrn-proposal-for (world target threshold)
    (do
        (let field (lwhrn-field-for world target threshold))
        (if (or (node_eq field (lwo-none))
                (eq (lwo-field-size
                        (lwhrn-field-candidates field)) 0)) (lwo-none)
            (do
                (let witnesses (lwhrn-field-witnesses field))
                (let count (lwo-field-size witnesses))
                (let origin (lwhrn-origin target threshold))
                (let candidate
                    (lwo-emergent field witnesses
                        (intern_trivial_int
                            (lwo-field-size
                                (lwhrn-field-candidates field)))
                        (intern_trivial_int
                            (lwo-field-size (lwhrn-field-trials field)))
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field)) origin)))))
(defn lwhrn-field-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwhrn-field? (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwhrn-candidate-current? (world candidate)
    (if (eq (lwhrn-field-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            (let fresh (lwhrn-proposal-for world
                            (lwhrn-origin-target origin)
                            (lwhrn-origin-threshold origin)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwhrn-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwhrn-candidate-current? world candidate) 1)) 1 0))
(defn lwhrn-integrate (round proposal action)
    (if (eq (lwhrn-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

(defn lwhrn-progress-target (field)
    (if (node_eq field (lwo-none)) "field:nothing"
        (lcfb-cat (list
            "attempts:" (int_to_str
                (lwo-field-size (lwhrn-field-candidates field)))
            ":viable:" (int_to_str
                (lwo-field-size (lwhrn-field-viable field)))
            ":divergent:" (int_to_str
                (lwo-field-size (lwhrn-field-divergent field)))
            ":unresolved:" (int_to_str
                (lwo-field-size (lwhrn-field-unresolved field)))))))

; witnessed: 2026-08-09 -> 33554431 (25/25) on fkwu
