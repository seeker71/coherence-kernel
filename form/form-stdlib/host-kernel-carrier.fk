// host-kernel-carrier.fk — OS-independent host resource carriers (port + carrier).
//
// Closes the interface gaps at the Form contract layer: every organ and
// world-port named in axioms/host-kernel.form binds here as a carrier
// record of function-values. Each host selects a carrier; call sites stay
// invariant. fkwu reaches host I/O through emitted tags beneath these ops.
//
import form-stdlib/core.fk;
import form-stdlib/storage-port.fk;
import form-stdlib/resource-port.fk;
import form-stdlib/lcg-bytes.fk;
//
section [form.bml] {
    //; ── RAM organ — namespaced KV over the storage-port memory carrier ──
    def hk-ram-key(ns, k) = ((ns + ":") + k);
    def hk-ram-open(ns) = storage-open(carrier-memory(), ns);
    def hk-ram-put(store, ns, k, v) = storage-put(carrier-memory(), store, hk-ram-key(ns, k), v);
    def hk-ram-get(store, ns, k) = storage-get(carrier-memory(), store, hk-ram-key(ns, k));
    def hk-ram-has?(store, ns, k) = storage-has?(carrier-memory(), store, hk-ram-key(ns, k));
    //; ── Clock organ — shape proof only (value diverges by design) ──
    def hk-clock-now-ms() = now_unix_ms();
    def hk-clock-shape-ok?(t) = t > 1000000000 ? 1 : 0;
    //; ── Entropy door — deterministic LCG for bands ──
    //; The stream is arithmetic, not entropy: lcg-bytes.fk is the glibc LCG, proven
    //; against its witnesses (166 for seed 1; 52 93 210 163 for seed 7). fkwu carries
    //; no seeded_bytes native, so this door reaches the stream through lcg-bytes. The real
    //; entropy door next to it — random_bytes — is a host boundary and stays native.
    def hk-entropy-seed(seed, count) = lcg-bytes(seed, count);
    //; GPU organ: Form supplies [shader-source, entry-name]. The host
    //; carrier admits that emitted shader to the physical Metal device.
    def hk-gpu-dispatch(image) = metal_pipeline(image[0], image[1]);
    //; ── Host-bound route carrier — storage + http_get offload shape ──
    def hk-route-carrier() = mk-carrier("host-route", hk-ram-open, hk-ram-put, hk-ram-get, hk-ram-has?, storage-keys);
    def hk-route-offload-key() = "route-payload";
    def hk-route-cache-put(store, payload) = hk-ram-put(store, "route", hk-route-offload-key(), payload);
    def hk-route-cache-get(store) = hk-ram-get(store, "route", hk-route-offload-key());
    //; ── carrier verdict — one test, all organs named ──
    def hk-carrier-test(_x) = {
        let s0 = hk-ram-open("hk-test");
        let s1 = hk-ram-put(s0, "hk-test", "alpha", 42);
        let got = hk-ram-get(s1, "hk-test", "alpha");
        let clk = hk-clock-shape-ok?(hk-clock-now-ms());
        let ent = hk-entropy-seed(7, 4)[0];
        let r1 = (Comparable) storage-value(got) == 42 ? 1 : 0;
        let r2 = (Comparable) clk == 1 ? 10 : 0;
        let r3 = (Comparable) ent == 52 ? 100 : 0;
        let r4 = len(read_file("form/form-stdlib/core.fk")) > 0 ? 1000 : 0;
        sum([r1, r2, r3, r4]);
    };
    0;
}
