; form-cli-local-docs-live.fk — retrieve from real files, print the pack.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-local-docs.fk

(do
    (defn fld-from-file (path)
        (let body (read_file path)
            (fld-doc path
                (fld-tokenize (str_concat path (str_concat " " body)))
                (fld-cap body 160))))
    (let docs (list
        (fld-from-file "form/form-stdlib/tests/local-docs-fixture/garden-notes.txt")
        (fld-from-file "form/form-stdlib/tests/local-docs-fixture/travel.txt")))
    (let ans (fld-ask "how do I water tomatoes in the garden" docs))
    (print_str
        (str_concat "form-cli executed local-docs\n"
        (str_concat "form-cli grounded_status="
        (str_concat (fld-status ans)
        (str_concat " files="
        (str_concat (int_to_str (len docs))
        (str_concat " hits="
        (str_concat (int_to_str (len (fld-hits ans)))
        (str_concat "\n\n" (fld-pack ans))))))))))
    0)
