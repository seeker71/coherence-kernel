; form-cli-peer-local-source-answer-live-run.fk -- real one-source local peer
; action. It opens no model and proves the same action used by `symbol ` lines.
;
; preludes: form-stdlib/form-cli-peer-local-source-answer.fk

(do
    (defn fcplsal-line (key value)
        (print_str (str_concat key (str_concat "=" (str_concat value "\n")))))
    (let admitted-at (now_unix_ms))
    (let source-ctx (fcpalsa-live-source-context))
    (let admitted-ms (sub (now_unix_ms) admitted-at))
    (let direct (fcpalsa-run (list "live-local-source-session")
        "source-symbol" "psci-schema" source-ctx 1))
    (let peer (fcpalsa-peer direct))
    ; This second task receives the exact same caller-born snapshot.  It is a
    ; keyed map lookup, not a second discovery crossing and not a model turn.
    (let hot (fcpalsa-run (fcpa-session peer)
        "source-symbol" "psci-schema" source-ctx 2))
    (let hot-peer (fcpalsa-peer hot))
    (fcplsal-line "route" (fcpa-route peer))
    (fcplsal-line "signal" (fcpalsa-signal direct))
    (fcplsal-line "reason" (fcpalsa-reason direct))
    (fcplsal-line "lookup-count" (int_to_str (fcpa-lookup-count peer)))
    (fcplsal-line "admission-snapshot-ms" (int_to_str admitted-ms))
    (fcplsal-line "first-hot-lookup-ms" (int_to_str (fcpssa-elapsed-ms direct)))
    (fcplsal-line "second-hot-lookup-ms" (int_to_str (fcpssa-elapsed-ms hot)))
    (fcplsal-line "second-signal" (fcpalsa-signal hot))
    (fcplsal-line "second-callback-calls"
        (int_to_str (fcpa-callback-calls hot-peer)))
    (fcplsal-line "callback-calls" (int_to_str (fcpa-callback-calls peer)))
    (fcplsal-line "knowledge-contribution"
        (int_to_str (fcpalsa-knowledge-contribution direct)))
    (fcplsal-line "mutation-contribution"
        (int_to_str (fcpalsa-mutation-contribution direct)))
    0)
