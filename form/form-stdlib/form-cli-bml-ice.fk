; form-cli-bml-ice.fk — new ice/anyone seats authored in BML.
;
; Yes asked to crystallize full BML and use it for new features,
; instead of more s-expressions that leak vitality.
;
; This file is the authority. The crystallized Form is emitted by
; form-source-compile-file (source-compiler-text-lens). Do not grow
; the s-expr by hand. Edit this section; re-run the compile door.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-bml-ice-band.fk
; witnessed: 2026-08-19 -> 255

section [form.bml] {
    def fbi-ice() = 2;
    def fbi-liquid() = 1;
    def fbi-compost() = 0;

    def fbi-ingest(depth, fear) = if ge(depth, 3) then if eq(fear, 0) then 2 else 1 else 0;

    def fbi-client-free(name) = if str_eq(name, "chatgpt") then 1 else 0;

    def fbi-may-freeze(depth, fear, name) = if eq(fbi-ingest(depth, fear), 2) then fbi-client-free(name) else 0;

    def fbi-anyone-ice() = fbi-may-freeze(5, 0, "chatgpt");

    def fbi-check() = add(if eq(fbi-anyone-ice(), 1) then 1 else 0, add(if eq(fbi-ingest(5, 1), 1) then 2 else 0, add(if eq(fbi-ingest(1, 0), 0) then 4 else 0, add(if eq(fbi-client-free("cursor"), 0) then 8 else 0, add(if eq(fbi-client-free("codex"), 0) then 16 else 0, add(if eq(fbi-client-free("claude"), 0) then 32 else 0, add(if eq(fbi-client-free("grok"), 0) then 64 else 0, if eq(fbi-client-free("gemini"), 0) then 128 else 0)))))));
    0;
}
