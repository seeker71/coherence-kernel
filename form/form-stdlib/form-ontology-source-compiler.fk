; form-ontology-source-compiler.fk — the source compiler's static ontology view.
;
; The general loader also materialises dynamic engine definitions through
; walk_recipe_here.  That is a sibling-only seam and is unrelated to compiling
; source sections.  This cell carries only the two reviewed tables the source
; compiler consumes, directly from the Form-owned bootstrap registry.
;
; preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk

(defn fol-sc-core-row (name)
        (do
            (let nid (fol-bp name))
            (list name (node_type nid) (node_inst nid))))

    (defn fol-sc-core-rows-loop (names acc)
        (if (eq (len names) 0) acc
            (fol-sc-core-rows-loop (tail names)
                (cons (fol-sc-core-row (head names)) acc))))

    (defn fol-sc-reverse-loop (xs acc)
        (if (eq (len xs) 0) acc
            (fol-sc-reverse-loop (tail xs) (cons (head xs) acc))))

    (defn fol-sc-core-rows (names)
        (fol-sc-reverse-loop (fol-sc-core-rows-loop names (empty)) (empty)))

    (let FORM-CATEGORY-TABLE
        (fol-sc-core-rows
            (list "do" "sequence" "let" "if-then" "if" "fndef" "fncall" "ident" "match")))

    (let FORM-PRIMITIVE-TABLE
        (fol-sc-core-rows
            (list "add" "sub" "mul" "div" "mod" "eq" "ne" "lt" "le" "gt" "ge" "and" "or" "not")))

0
