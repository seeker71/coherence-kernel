// Whisper geometry belongs to the admitted checkpoint and travels with its state.
// The current kernels carry 64-wide heads and F16 weights; other shapes refuse.
// preludes: form-stdlib/json.fk form-stdlib/safetensors-index.bml
section [form.bml] {
 class EarGeometry {
  // D, FF, heads, vocabulary, text positions, audio positions, mels, enc, dec, languages
  def eng-tiny() = list(384,1536,6,51865,448,1500,80,4,4,99);
  def eng-state(geometry) = list(0,0,0,0,0,0,0,0,0,geometry);
  def eng-g(st,i) = nth(nth(st,9),i);
  def eng-D(st) = eng-g(st,0);
  def eng-F(st) = eng-g(st,1);
  def eng-H(st) = eng-g(st,2);
  def eng-V(st) = eng-g(st,3);
  def eng-CTX(st) = eng-g(st,4);
  def eng-TE(st) = eng-g(st,5);
  def eng-TF(st) = mul(eng-TE(st),2);
  def eng-mels(st) = eng-g(st,6);
  def eng-enc-layers(st) = eng-g(st,7);
  def eng-dec-layers(st) = eng-g(st,8);
  def eng-languages(st) = eng-g(st,9);
  def eng-lang-hi(st) = add(50259,eng-languages(st));
  def eng-transcribe(st) = add(eng-lang-hi(st),1);
  def eng-nospeech(st) = add(eng-lang-hi(st),4);
  def eng-notimestamps(st) = add(eng-lang-hi(st),5);
  def eng-ts0(st) = add(eng-lang-hi(st),6);
  def eng-config(path) {
   let c = parse-json(path,read_file(path));
   let d = sti-value(c,"n_audio_state"); let h = sti-value(c,"n_audio_head"); let v = sti-value(c,"n_vocab");
   let geometry = list(d,mul(d,4),h,v,sti-value(c,"n_text_ctx"),sti-value(c,"n_audio_ctx"),sti-value(c,"n_mels"),sti-value(c,"n_audio_layer"),sti-value(c,"n_text_layer"),sub(v,51766));
   if not(and(eq(d,sti-value(c,"n_text_state")),eq(h,sti-value(c,"n_text_head")))) then form_error("native Whisper encoder/decoder width or heads differ") else if not(eng-valid(geometry)) then form_error("native Whisper geometry is outside the current kernel surface") else geometry;
  }
  def eng-valid(g) = and(eq(head(g),mul(nth(g,2),64)),and(eq(mod(head(g),32),0),and(gt(head(g),0),and(le(nth(g,1),5120),and(eq(nth(g,4),448),and(eq(nth(g,5),1500),and(or(eq(nth(g,6),80),eq(nth(g,6),128)),and(or(eq(nth(g,9),99),eq(nth(g,9),100)),and(gt(nth(g,7),0),gt(nth(g,8),0))))))))));
 }
 0;
}
