; form-cli-live.fk — one input, recursive thoughts, on-demand organs.
;
; No flags. The input lives in this cell. A recursive thought walks it,
; generates a micro-kernel per row, and mlx_run's them as it goes.
; The run file translates the add row onto CPU JIT and Metal GPU too.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-live-band.fk
; witnessed: 2026-08-20 -> 255

(do (defn fle-input () (list (list "add" 2 3) (list "max" 2 9) (list "vadd" 10 20 1 2))) (defn fle-spc () " ") (defn fle-emit (n) (if (str_eq (nth n 0) "c") (int_to_str (nth n 1)) (if (str_eq (nth n 0) "v") (str_concat "v2 " (str_concat (int_to_str (nth n 1)) (str_concat (fle-spc) (int_to_str (nth n 2))))) (if (str_eq (nth n 0) "sum") (str_concat (fle-emit (nth n 1)) (str_concat (fle-spc) "sum")) (str_concat (fle-emit (nth n 1)) (str_concat (fle-spc) (str_concat (fle-emit (nth n 2)) (str_concat (fle-spc) (nth n 0))))))))) (defn fle-tree (row) (if (str_eq (nth row 0) "add") (list "add" (list "c" (nth row 1)) (list "c" (nth row 2))) (if (str_eq (nth row 0) "max") (list "max" (list "c" (nth row 1)) (list "c" (nth row 2))) (list "sum" (list "add" (list "v" (nth row 1) (nth row 2)) (list "v" (nth row 3) (nth row 4))))))) (defn fle-expect (row) (if (str_eq (nth row 0) "add") (add (nth row 1) (nth row 2)) (if (str_eq (nth row 0) "max") (if (gt (nth row 1) (nth row 2)) (nth row 1) (nth row 2)) (add (add (add (nth row 1) (nth row 2)) (nth row 3)) (nth row 4))))) (defn fle-prog (row) (fle-emit (fle-tree row))) (defn fle-progs (xs) (if (eq (len xs) 0) (empty) (cons (fle-prog (head xs)) (fle-progs (tail xs))))) (defn fle-pulse (xs) (if (eq (len xs) 0) 0 (add (mlx_run (fle-prog (head xs))) (fle-pulse (tail xs))))) (defn fle-add-lhs () (nth (head (fle-input)) 1)) (defn fle-add-rhs () (nth (head (fle-input)) 2)) (defn fle-check () (add (if (eq (len (fle-input)) 3) 1 0) (add (if (str_eq (head (fle-progs (fle-input))) "2 3 add") 2 0) (add (if (str_eq (head (tail (fle-progs (fle-input)))) "2 9 max") 4 0) (add (if (str_eq (head (tail (tail (fle-progs (fle-input))))) "v2 10 20 v2 1 2 add sum") 8 0) (add (if (eq (fle-pulse (fle-input)) 47) 16 0) (add (if (eq (mlx_run (head (fle-progs (fle-input)))) 5) 32 0) (add (if (eq (len (fle-progs (fle-input))) 3) 64 0) (if (eq (fle-expect (head (fle-input))) 5) 128 0))))))))) 0)
