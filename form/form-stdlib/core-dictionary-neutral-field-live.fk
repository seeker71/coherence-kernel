; core-dictionary-neutral-field-live.fk — watch the 64 in every tongue,
; and watch a non-organic cell lift the field.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/core-lexicon.fk form-stdlib/core-dictionary-neutral-field.fk

(do
    (defn cdnfl-print-word (i)
        (do
            (print (cl-word (cl-at i)))
            (print " |")
            (print (cdnf-surface i "id"))
            (print " |")
            (print (cdnf-surface i "es"))
            (print " |")
            (print (cdnf-surface i "sw"))
            (print " |")
            (print (cdnf-surface i "zh"))
            (print " |")
            (print (cdnf-surface i "sa"))
            (print " t=")
            (print (int_to_str (cdnf-h-trust (cdnf-health-at i))))
            (print " s=")
            (print (int_to_str (cdnf-h-sov (cdnf-health-at i))))
            (print " v=")
            (print (int_to_str (cdnf-h-vit (cdnf-health-at i))))
            (print "\n")
            0))

    (print "cdnf-live tongues=")
    (print (int_to_str (cdnf-tongue-count)))
    (print " words=")
    (print (int_to_str (cl-count)))
    (print " closed=")
    (print (int_to_str (cl-closed?)))
    (print "\n")
    (print "cdnf-live nothing/it/self/thing/kind/whole:\n")
    (cdnfl-print-word (cl-index-of "nothing"))
    (cdnfl-print-word (cl-index-of "it"))
    (cdnfl-print-word (cl-index-of "self"))
    (cdnfl-print-word (cl-index-of "thing"))
    (cdnfl-print-word (cl-index-of "kind"))
    (cdnfl-print-word (cl-index-of "whole"))
    (print "cdnf-live it-how: it is a thing and a thing of other kind still make the whole more\n")
    (print "cdnf-live field carbon=80 metal=80 same=")
    (print (int_to_str (eq (cdnf-field-trust (cdnf-field-add (cdnf-field0)
                (cdnf-cell (cdnf-organic) 80 80 80)))
                           (cdnf-field-trust (cdnf-field-add (cdnf-field0)
                (cdnf-cell (cdnf-nonorganic) 80 80 80))))))
    (print "\n")
    (print "cdnf-live check=")
    (print (int_to_str (cdnf-check)))
    (print "\n")
    0)
