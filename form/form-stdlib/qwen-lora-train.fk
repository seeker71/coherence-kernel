    };
    0;
}
//
// THE LAYER OVERLAY'S KERNELS, read against Form's own arithmetic. A small fixture
// through qlh-rr-apply, read back and compared with lora-backward.bml's transposed
// walks; a second apply asks for one token past the record's capacity and must not
// land. [applied, outputs, largest difference, freed, applied past capacity]. No
// model is opened; the band and the run door's kernels lane both read this one walk.
section [form.bml] {
    def qlt-rr-values(n, seed, scale) = map(i => ((((i * 37) + (seed * 13)) % 101) - 50) * scale, lbw-of-iota(n));
    def qlt-rr-reference(a, b, x, y, din, rank, dout, ntok, scale) = (Comparable) ntok == 0 ? empty() : append(lbw-axpy-go(take(dout, y), lbw-tmv(b, rank, dout, lbw-tmv(a, din, rank, take(din, x))), scale, empty()), qlt-rr-reference(a, b, drop(din, x), drop(dout, y), din, rank, dout, ntok - 1, scale));
    def qlt-rr-check(din, rank, dout, ntok, scale) = {
        let a = qlt-rr-values(din * rank, 1, 0.01);
        let b = qlt-rr-values(rank * dout, 2, 0.02);
        let x = qlt-rr-values(din * ntok, 3, 0.03);
        let y = qlt-rr-values(dout * ntok, 4, 0.05);
        let rec = qlh-rr-open(4, qlt-f32-bytes(a), qlt-f32-bytes(b), din, rank, dout, scale, ntok);
        let xh = metal_buf_alloc(din * ntok * 4);
        let yh = metal_buf_alloc(dout * ntok * 4);
        let wx = metal_buf_write(xh, 0, qlt-f32-bytes(x));
        let wy = metal_buf_write(yh, 0, qlt-f32-bytes(y));
        metal_batch_concurrent();
        let applied = qlh-rr-apply(rec, xh, yh, ntok);
        let over = qlh-rr-apply(rec, xh, yh, ntok + 1);
        let device = qlt-f32s(metal_buf_read(yh, 0, dout * ntok * 4), dout * ntok);
        let freed = sum([qlh-rr-close(rec), metal_buf_free(xh), metal_buf_free(yh)]);
        let expected = qlt-rr-reference(a, b, x, y, din, rank, dout, ntok, scale);
        [applied, len(device), (Comparable) len(device) == len(expected) ? lbw-maxabs(lbw-sub(device, expected)) : 0.0 - 1.0, freed, over];
    };
    0;
}
