    def qlt-finite?(xs) = nothing?(xs) ? 0 : (Comparable) len(xs) > 0 && foldl((acc, x) => acc && abs(x) < 3.0e38, 1, xs);
    def qlt-opening-fitted(ctx, base, labels, split, fit, knowing, path, o, agree, nsites) = !(qlt-finite?(fit[0]) && qlt-finite?(fit[1])) ? qlt-refused("fit-not-finite") : {
