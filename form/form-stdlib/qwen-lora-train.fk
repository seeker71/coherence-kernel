    def qlt-head-row(ctx, id) = !((String) value_kind(id) == "int") ? empty() : id < 0 || id >= kth-tv-r(ctx[6]) ? empty() : q38e-index(kth-tv-ty(ctx[6])) < 0 ? empty() : {
        let d = ctx[2][0];
        let out = metal_buf_alloc(d * 4);
        metal_batch_concurrent();
        let rc = metal_enqueue(nth(ctx[0], q38e-index(kth-tv-ty(ctx[6]))), q38-b16([kth-tv-h(ctx[6]), out], [id * d, d], 0, 1), d);
        let raw = metal_buf_read(out, 0, d * 4);
        let freed = metal_buf_free(out);
        let row = rc < 0 ? empty() : qlt-f32s(raw, d);
        (Comparable) len(row) == 0 || lbw-dot-go(row, row, 0.0) <= 0.0 ? empty() : row;
    };
    // [normalized hidden floats, residual bytes, base winner, winner logit, opening logit]
    def qlt-site-reading(ctx, ids, o) = {
        let sts = q38-new-state(ctx[2]);
        let r = q38-prefill-span-batched(ctx[0], ctx[1], ctx[2], ctx[3], sts, ctx[4], ctx[5], ctx[6], ids, 0);
        let bs = ctx[1];
        let d = ctx[2][0];
        let hidden = qlt-f32s(metal_buf_read(bs[1], 0, d * 4), d);
        let resid = metal_buf_read(bs[0], 0, d * 4);
        let top = r[0];
        let reading = top < 0 || (Comparable) len(hidden) == 0 ? empty() : [hidden, resid, top, qlt-f32-at(bs[28], top), qlt-f32-at(bs[28], o)];
        let freed = q38-free-state(sts);
        reading;
    };
    // the head asked again from a restored residual: [winner, winner logit, opening logit]
    def qlt-head-again(ctx, resid, adapter, o) = {
        let bs = ctx[1];
        let wrote = metal_buf_write(bs[0], 0, resid);
        metal_batch_concurrent();
        len(adapter) == 0 ? q38-head(ctx[0], bs, ctx[2], ctx[5], ctx[6]) : q38-head-adapted(ctx[0], bs, ctx[2], ctx[5], ctx[6], adapter);
        let top = kth-u32at(metal_buf_read(bs[31], 0, 4), 0);
        [top, qlt-f32-at(bs[28], top), qlt-f32-at(bs[28], o)];
    };
    // The head's view of an emitter B on the device: one output.weight matvec of B into the
    // logit scratch, the opening's own entry read and set aside, then k argmax folds, each
    // read and set aside in turn. Answers [[id, lift], ...], lifts above floor, largest first.
    def qlt-f32-bytes(xs) = foldl((acc, x) => acc ++ md-le32(md-f32-bits(x)), "", xs);
    def qlt-rivals(ctx, b, o, k, floor) = {
        let bs = ctx[1];
        let wrote = metal_buf_write(bs[1], 0, qlt-f32-bytes(b));
        metal_batch_concurrent();
        q38-mv(ctx[0], ctx[6], bs[1], bs[28], 1);
        let own = qlt-f32-at(bs[28], o);
        let aside = metal_buf_write(bs[28], o * 4, qlt-f32-bytes([0.0 - 1.0e30]));
        qlt-rivals-go(ctx, k, floor, empty());
    };
    def qlt-rivals-go(ctx, k, floor, acc) = k <= 0 ? reverse(acc) : {
        let bs = ctx[1];
        metal_batch_concurrent();
        metal_enqueue(ctx[0][25], q38-b16([bs[28], bs[29], bs[30]], [ctx[2][19], 1024], 0, 1), 1024);
        metal_enqueue(ctx[0][26], md-bind16([bs[29], bs[30], bs[31], bs[32]], [1024], 1024, 0, 1, 1), 1);
        let top = kth-u32at(metal_buf_read(bs[31], 0, 4), 0);
        let lift = qlt-f32-at(bs[28], top);
        let aside = metal_buf_write(bs[28], top * 4, qlt-f32-bytes([0.0 - 1.0e30]));
        lift <= floor ? reverse(acc) : qlt-rivals-go(ctx, k - 1, floor, cons([top, lift], acc));
    };
    // one row per held site: [label, base winner, restored plain winner, adapted winner]
    def qlt-rows(ls, bs, as, ds) = (Comparable) len(ls) == 0 ? empty() : cons([ls[0], bs[0][2], as[0][0], ds[0][0]], qlt-rows(ls[1:], bs[1:], as[1:], ds[1:]));
    def qlt-tally(rows, o, positive, k) = foldl((acc, r) => acc + ((positive ? r[0] > 0.5 : r[0] < 0.5) && (Comparable) r[k] == o ? 1 : 0), 0, rows);
    def qlt-positives(rows) = foldl((acc, r) => acc + (r[0] > 0.5 ? 1 : 0), 0, rows);
    def qlt-faithful(rows) = foldl((acc, r) => acc + ((Comparable) r[1] == r[2] ? 1 : 0), 0, rows);
    def qlt-first-verb(sites) = (Comparable) len(sites) == 0 ? "recipe-birth" : (Comparable) sites[0][3] == 1 ? sites[0][4] : qlt-first-verb(sites[1:]);
    def qlt-verbs-agree(src, sites, o, target) = foldl((acc, s) => acc && ((Comparable) s[3] == 0 || (Comparable) qlt-opening-id-for(src, s[4], target) == o), 1, sites);
    def qlt-refused(reason) = ["refused", reason];
    // scrambled labellings fitted beside the true one: labels that mean nothing clear the floor
    // by chance about once in sixty-four (fifteen let the review's meaningless labels through)
    def qlt-scrambles() = 63;
    def qlt-milli(x) = nothing?(x) ? nothing() : float_to_int(x * 1000.0);
    // The reading as [key, integer] pairs, a measure that could not be read left out. rows are
    // [label, base winner, restored winner, adapted winner]; split is [kept, held out] indices;
    // fit is qlt-selective's; knowing is lbw-of-knowing's.
    def qlt-opening-reading(rows, split, fit, knowing, o, agree, bytes, nsites) = filter(p => !nothing?(p[1]), [["sites", nsites], ["held", len(rows)], ["kept_sites", len(split[0])], ["heldout_sites", len(split[1])], ["opening_sites", qlt-positives(rows)], ["heldout_openings", qlt-positives(lbw-of-at(rows, split[1]))], ["opened_before", qlt-tally(rows, o, 1, 1)], ["opened_after", qlt-tally(rows, o, 1, 3)], ["wrong_before", qlt-tally(rows, o, 0, 1)], ["wrong_after", qlt-tally(rows, o, 0, 3)], ["heldout_opened_after", qlt-tally(lbw-of-at(rows, split[1]), o, 1, 3)], ["heldout_wrong_after", qlt-tally(lbw-of-at(rows, split[1]), o, 0, 3)], ["restores_faithful", qlt-faithful(rows)], ["gain_milli", qlt-milli(fit[3])], ["separation_in_sample_milli", qlt-milli(knowing[0])], ["scramble_in_sample_milli", qlt-milli(knowing[2])], ["separation_heldout_milli", qlt-milli(knowing[1])], ["scramble_heldout_milli", qlt-milli(knowing[3])], ["scrambles", knowing[4]], ["yieldpoint_read", knowing[7]], ["opening_id", o], ["one_opening_for_every_verb", agree ? 1 : 0], ["artifact_bytes", bytes], ["rivals_taken", fit[4]], ["largest_rival_lift_milli", qlt-milli(fit[5])], ["selective_refused", fit[6]]]);
    // ctx from q38-open-span(path, maxpos, span): a site longer than the span is not held.
    // The rank-one adapter carries one emitter, so it learns one opening: the text opening
    // every verb shares, or (target "control-id") the learned control-open ID;
    // "every verb shares the opening" reads whether that one opening covers every site.
    // refine = [rounds, rivals per round]: the selective emitter (lora-backward.bml) with the
    // head's view read on the device; [0, 0] keeps the plain emitter along the opening's row.
    def qlt-opening-fit(ctx, src, sites, path, ridge, margin, target, refine) = {
