    def qlt-opening-split(ctx, sites, base, w, path, ridge, margin, refine, o, agree, nsites) = {
        let labels = map(s => s[3] + 0.0, sites);
        let groups = map(s => s[5], sites);
        let hs = map(r => r[0], base);
        let split = lbw-of-split(groups);
        let kept = split[0];
        (Comparable) len(kept) == 0 ? qlt-refused("no-kept-site") : qlt-opening-fitted(ctx, base, labels, split, qlt-selective(ctx, w, o, margin, refine, lbw-of-fit(lbw-of-at(hs, kept), lbw-of-at(labels, kept), lbw-of-at(map(r => r[3] - r[4], base), kept), w, ridge, margin)), lbw-of-knowing(hs, labels, groups, ridge, qlt-scrambles()), path, o, agree, nsites);
    };
    // The fit with its emitter made selective: [A, B, scores, gain, rivals taken, largest lift
    // left, selective refused]. When the rivals' directions leave nothing of the opening's row
    // (lbw-of-selective answers nothing), B stays the plain emitter and the reading says so:
    // no rival taken, selective refused 1.
    def qlt-selective(ctx, w, o, margin, refine, fit) = {
        let refined = lbw-of-refine(w, fit[3], fit[1], empty(), refine[0], b => qlt-rivals(ctx, b, o, refine[1], 0.5 * margin), j => qlt-head-row(ctx, j));
        let refused = nothing?(refined[0]) ? 1 : 0;
        let b = (Comparable) refused == 1 ? fit[1] : refined[0];
        let left = nothing?(b) ? empty() : qlt-rivals(ctx, b, o, 1, 0.0);
        [fit[0], b, fit[2], fit[3], (Comparable) refused == 1 ? 0 : len(refined[1]), (Comparable) len(left) == 0 ? 0.0 : left[0][1], refused];
    };
