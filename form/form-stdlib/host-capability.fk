; host-capability.fk — the body answering, natively, what it can do on THIS host right now.
;
; WHY THIS CELL EXISTS. Three times in one day I told Urs this body could not do something it could
; already do: Form cannot dispatch Metal (it can), form-cli cannot (it can), the build is blocked (it
; was a stale artifact printing its own remedy). Each time I found out by inventing a trial. That is
; the symptom; the cause is that nothing here answers the question. native-op-manifest.fk declares
; which ops EXIST — metal_matvec_f32 has been listed at :115 the whole time — but an op existing and
; an op ANSWERING on this machine are different facts, and only the second one decides what we can do
; today. So the manifest could be read in full and still leave you guessing.
;
; THE PRINCIPLE THIS ENCODES, in Urs's words: we support all silicon on all platforms, and if we find
; an issue that means unfinished work, nothing more. So this cell never reports a limit. It reports
; CARRIED or UNFINISHED. A door that answers is carried; a door that does not is work not yet done,
; named with the file that would do it. There is no third category and nothing here to configure.
;
; THE KERNEL ALREADY DOES THIS RIGHT ON ONE PLATFORM. fkwu-uni.c:4043 loads nvcuda.dll at runtime,
; JITs Form-emitted PTX, and needs no flag, no toolkit and no nvcc. Darwin now matches it: Metal is
; linked on every Darwin build rather than asked for. This cell is how you SEE that, without building
; a probe of your own.
;
; preludes: form-stdlib/core.fk

(do
    (defn hc-nl () (byte_to_str 10))
    (defn hc-has (s sub) (ge (str_find s sub 0) 0))

    ; A door is CARRIED when its own reply says so. We ask the door, not the operating system, not a
    ; build flag, and not a filename — those are all things that can be true while the door is silent.
    (defn hc-carried? (reply) (if (hc-has reply "metal_linked=true") 1 0))

    (defn hc-line (name state note)
        (print_str (str_concat name (str_concat "  " (str_concat state (str_concat "  " note))))))

    (let metal (metal_matvec_fixture))
    (let metal-ok (hc-carried? metal))

    (print_str "— what this body can do right now —")

    (hc-line "metal_matvec_f32   " (if (eq metal-ok 1) "CARRIED   " "UNFINISHED")
        (if (eq metal-ok 1)
            "GPU answers; kernel text in, result out"
            "native/metal/fk-metal-carrier.m is not linked into this binary"))

    ; The CUDA door is the finished precedent, carried inside the kernel itself with no external
    ; file and no switch. Off Windows it is honest about being absent rather than pretending.
    (hc-line "cuda_matvec_f32    "
        (if (hc-has (cuda_matvec) "cuda_linked=true") "CARRIED   " "UNFINISHED")
        "kernel-internal: LoadLibraryA(nvcuda.dll) at runtime, no toolkit, no flag")

    (print_str "")
    (print_str (if (eq metal-ok 1)
        "no switch was consulted to learn any of this"
        "UNFINISHED is not a limit — it names the work, and the work is small"))
    (print_str "")
    (print_str metal)
    metal-ok)
