; iq4xs-dequant.fk — exact Form carver for GGML type 20.
;
; preludes: form-stdlib/core.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/iq4xs-layout.bml
;
; The nonlinear 16-value table is fixed trained-format data. Layout and scale
; geometry remain executable BML; this cell applies the table and f16 scale.

(do
    (defn iq4x-values () (list -127 -104 -83 -65 -49 -35 -22 -10 1 13 25 38 53 69 89 113))
    (defn iq4x-d (bytes base) (fd-f16 (iq4x-u16 bytes base)))
    (defn iq4x-at-flat (bytes base i)
        (if (eq (iq4x-within-block i) 0) (nothing)
            (do
                (let sc (iq4x-scale-code bytes base (iq4x-group i)))
                (let q (iq4x-quant-code bytes base i))
                (mul (mul (iq4x-d bytes base) (sub sc 32)) (nth (iq4x-values) q)))))
    0)
