; generative-form-skill-gate.fk -- execution-backed local-model embodiment gate.
;
; A candidate is not admitted for mentioning BML, BMF, choice, JIT, or NodeIDs.
; Three independent artifacts must cross their native meaning surfaces:
;
;   1. BML source is parsed by the scannerless BML cursor, executed by a
;      bounded AST walker, then lowered to and executed by the fourth-kernel
;      fk walker.  Both must return the challenge value.
;   2. A custom BMF grammar is lowered directly from raw bytes by qbl's cursor
;      readers.  Its probe must take a failed alternative, undo that cursor,
;      cut a later winner, consume every byte, and become `nothing` under a
;      one-step timeout budget.  There is no tokenizer list before this walk.
;   3. A Form micro-thought reconstructs a content-addressed recipe NodeID,
;      executes offered choice/cut/undo/timeout lifecycle observations, restores
;      a checkpoint, routes a thought kernel, earns (but does not overclaim) a
;      JIT plan, and preserves nothing / successful 0 / successful 1.
;
; The pure verifier never calls a model or a native carrier.  Its `executed`
; fields describe only the repository interpreters named above.  The dormant
; live runner in observe/qwen38-generative-form-skill-gate-live-run.fk is the
; separate physical local-Qwen gate.
;
; Leakage boundary: the evaluation situations below are checked for exact
; equality against every existing stream/control train and held-out row.
; Zero exact matches does NOT establish absence of paraphrase, repository-RAG,
; base-model-pretraining, or human-memory contamination.
;
; witnessed: 2026-08-25 -> direct fkwu adversarial band
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml.fk form-stdlib/hati-os-kernel.fk form-stdlib/form-recipe-exec-token.fk control/offer-ack-core.fk control/choice-lane-core.fk form-stdlib/jit-decision.fk observe/inquiry-planes.fk form-stdlib/bml-bmf-stream-curriculum.fk form-stdlib/bml-bmf-control-curriculum.fk

(do
    (defn fgsg-all? (values)
        (if (nil? values) 1
            (if (head values) (fgsg-all? (tail values)) 0)))

    ; ------------------------------------------------------------------
    ; Candidate, challenge, and independently named evaluation material.
    ; ------------------------------------------------------------------

    (defn fgsg-candidate (bml-source bmf-source form-source)
        (list "generative-form-candidate" bml-source bmf-source form-source))
    (defn fgsg-candidate? (candidate)
        (if (nil? candidate) 0
            (if (not (eq (len candidate) 4)) 0
                (if (str_eq (nth candidate 0) "generative-form-candidate") 1 0))))
    (defn fgsg-candidate-bml (candidate) (nth candidate 1))
    (defn fgsg-candidate-bmf (candidate) (nth candidate 2))
    (defn fgsg-candidate-form (candidate) (nth candidate 3))

    (defn fgsg-challenge ()
        (list "generative-form-challenge" 73 17 29 2 "why" 6 1))
    (defn fgsg-challenge-bml-value (challenge) (nth challenge 1))
    (defn fgsg-challenge-input (challenge) (nth challenge 2))
    (defn fgsg-challenge-checkpoint (challenge) (nth challenge 3))
    (defn fgsg-challenge-timeout-budget (challenge) (nth challenge 4))
    (defn fgsg-challenge-plane (challenge) (nth challenge 5))
    (defn fgsg-challenge-heat (challenge) (nth challenge 6))
    (defn fgsg-challenge-pure (challenge) (nth challenge 7))

    (defn fgsg-evaluation-material ()
        (list
            "Compile and execute a BML method plus invocation to the held-out value in two independent runtimes."
            "Lower a custom raw-byte BMF grammar whose first alternative rejects and whose later alternative consumes the probe."
            "Execute a NodeID micro-thought where nothing, timeout, zero, one, checkpoint restore, learned plane, and earned JIT stay distinct."))
    (defn fgsg-stream-row-has-exact? (text rows)
        (if (nil? rows) 0
            (if (or (str_eq text (bbsc-lesson-prompt (head rows)))
                    (str_eq text (bbsc-lesson-target (head rows))))
                1 (fgsg-stream-row-has-exact? text (tail rows)))))
    (defn fgsg-control-row-has-exact? (text rows)
        (if (nil? rows) 0
            (if (or (str_eq text (bbcc-lesson-situation (head rows)))
                    (str_eq text (bbcc-lesson-expected (head rows))))
                1 (fgsg-control-row-has-exact? text (tail rows)))))
    (defn fgsg-material-leakage-one (text)
        (sum (list
            (fgsg-stream-row-has-exact? text (bbsc-training-rows))
            (fgsg-stream-row-has-exact? text (bbsc-heldout-rows))
            (fgsg-control-row-has-exact? text (bbcc-training-rows))
            (fgsg-control-row-has-exact? text (bbcc-heldout-rows)))))
    (defn fgsg-exact-leakage-loop (rows)
        (if (nil? rows) 0
            (add (fgsg-material-leakage-one (head rows))
                 (fgsg-exact-leakage-loop (tail rows)))))
    (defn fgsg-exact-leakage ()
        (fgsg-exact-leakage-loop (fgsg-evaluation-material)))
    (defn fgsg-leakage-boundary ()
        "exact prompt/target equality only; paraphrase, repository-RAG, pretraining, and human-memory contamination remain unmeasured")

    ; ------------------------------------------------------------------
    ; Model-output framing.  Markers are transport only; their contents must
    ; still compile/execute.  Duplicate or missing markers become nothing.
    ; ------------------------------------------------------------------

    (defn fgsg-marker-count-go (text marker from count)
        (do
            (let at (str_find text marker from))
            (if (lt at 0) count
                (fgsg-marker-count-go text marker (add at (str_len marker))
                                      (add count 1)))))
    (defn fgsg-marker-count (text marker)
        (fgsg-marker-count-go text marker 0 0))
    (defn fgsg-space-byte? (byte)
        (if (eq byte 32) 1
            (if (eq byte 10) 1
                (if (eq byte 13) 1 (if (eq byte 9) 1 0)))))
    (defn fgsg-trim-left (text at)
        (if (ge at (str_len text)) at
            (if (eq (fgsg-space-byte? (str_byte_at text at)) 1)
                (fgsg-trim-left text (add at 1)) at)))
    (defn fgsg-trim-right (text at)
        (if (le at 0) 0
            (if (eq (fgsg-space-byte? (str_byte_at text (sub at 1))) 1)
                (fgsg-trim-right text (sub at 1)) at)))
    (defn fgsg-trim (text)
        (do
            (let left (fgsg-trim-left text 0))
            (let right (fgsg-trim-right text (str_len text)))
            (if (ge left right) "" (substring text left right))))
    (defn fgsg-between-once (text open close)
        (if (not (and (eq (fgsg-marker-count text open) 1)
                      (eq (fgsg-marker-count text close) 1)))
            (nothing)
            (do
                (let at (str_find text open 0))
                (let start (add at (str_len open)))
                (let end (str_find text close start))
                (if (lt end start) (nothing)
                    (fgsg-trim (substring text start end))))))
    (defn fgsg-candidate-from-text (text)
        (do
            (let bml (fgsg-between-once text "<BML>" "</BML>"))
            (let bmf (fgsg-between-once text "<BMF>" "</BMF>"))
            (let form (fgsg-between-once text "<FORM>" "</FORM>"))
            (if (or (nothing? bml) (or (nothing? bmf) (nothing? form)))
                (nothing)
                (fgsg-candidate bml bmf form))))

    ; ------------------------------------------------------------------
    ; BML: raw cursor parser -> direct AST execution -> fourth-kernel lowering.
    ; ------------------------------------------------------------------

    (defn fgsg-bml-tag? (node name)
        (do
            (let actual (node_category node))
            (let expected (bmf-bp name))
            (if (and (eq (node_pkg actual) (node_pkg expected))
                (and (eq (node_level actual) (node_level expected))
                (and (eq (node_type actual) (node_type expected))
                     (eq (node_inst actual) (node_inst expected))))) 1 0)))
    (defn fgsg-bml-ident-name (node)
        (if (eq (fgsg-bml-tag? node "ident") 1)
            (node_value (head (node_children node))) ""))
    (defn fgsg-bml-method-name (method)
        (if (eq (fgsg-bml-tag? method "fndef") 1)
            (node_value (nth (node_children method) 0)) ""))
    (defn fgsg-bml-find-method (nodes name)
        (if (nil? nodes) (nothing)
            (if (and (eq (fgsg-bml-tag? (head nodes) "fndef") 1)
                     (str_eq (fgsg-bml-method-name (head nodes)) name))
                (head nodes)
                (fgsg-bml-find-method (tail nodes) name))))
    (defn fgsg-bml-env-get (env name)
        (if (nil? env) (nothing)
            (if (str_eq (nth (head env) 0) name) (nth (head env) 1)
                (fgsg-bml-env-get (tail env) name))))
    (defn fgsg-bml-eval-expr (expr methods env budget)
        (if (le budget 0) (nothing)
            (if (eq (fgsg-bml-tag? expr "ident") 1)
                (fgsg-bml-env-get env (fgsg-bml-ident-name expr))
            (if (eq (fgsg-bml-tag? expr "add") 1)
                (do
                    (let a (fgsg-bml-eval-expr
                        (nth (node_children expr) 0) methods env (sub budget 1)))
                    (let b (fgsg-bml-eval-expr
                        (nth (node_children expr) 1) methods env (sub budget 1)))
                    (if (or (nothing? a) (nothing? b)) (nothing) (add a b)))
            (if (eq (fgsg-bml-tag? expr "sub") 1)
                (do
                    (let a (fgsg-bml-eval-expr
                        (nth (node_children expr) 0) methods env (sub budget 1)))
                    (let b (fgsg-bml-eval-expr
                        (nth (node_children expr) 1) methods env (sub budget 1)))
                    (if (or (nothing? a) (nothing? b)) (nothing) (sub a b)))
            (if (eq (fgsg-bml-tag? expr "fncall") 1)
                (fgsg-bml-eval-call expr methods env (sub budget 1))
                (if (eq (len (node_children expr)) 0)
                    (node_value expr) (nothing))))))))
    (defn fgsg-bml-eval-call (call methods env budget)
        (if (le budget 0) (nothing)
            (do
                (let kids (node_children call))
                (let name (fgsg-bml-ident-name (head kids)))
                (let method (fgsg-bml-find-method methods name))
                (if (or (nothing? method) (not (eq (len kids) 2))) (nothing)
                    (do
                        (let mkids (node_children method))
                        (let params (node_children (nth mkids 1)))
                        (let body (node_children (nth mkids 2)))
                        (if (or (not (eq (len params) 1))
                                (not (eq (len body) 1)))
                            (nothing)
                            (do
                                (let arg (fgsg-bml-eval-expr
                                    (nth kids 1) methods env (sub budget 1)))
                                (let ret (head body))
                                ; The current fkwu BML vocabulary does not yet
                                ; assign UE-JUMP-RETURN a nonzero blueprint.
                                ; Its executable shape is therefore witnessed
                                ; here as the method body's sole unary node.
                                (if (or (nothing? arg)
                                        (not (eq (len (node_children ret)) 1)))
                                    (nothing)
                                    (fgsg-bml-eval-expr
                                        (head (node_children ret)) methods
                                        (list (list (node_value (head params)) arg))
                                        (sub budget 1))))))))))
    ; row = present, node.  The wrapper is necessary because a valid current
    ; return node has category @0.0.0.0 and `nothing?` would collapse it.
    (defn fgsg-bml-top-return-row (nodes)
        (if (nil? nodes) (list 0 (nothing))
            (if (eq (fgsg-bml-tag? (head nodes) "fndef") 1)
                (fgsg-bml-top-return-row (tail nodes))
                (list 1 (head nodes)))))
    (defn fgsg-bml-direct-run (program)
        (do
            (let nodes (node_children program))
            (let ret-row (fgsg-bml-top-return-row nodes))
            (if (eq (nth ret-row 0) 0) (nothing)
                (fgsg-bml-eval-expr (head (node_children (nth ret-row 1)))
                    nodes (empty) 96))))

    ; The second lane lowers the selected method expression into fk cells after
    ; binding its one argument.  fk-run then executes that independent recipe.
    (defn fgsg-bml-lower-expr (expr env budget)
        (if (le budget 0) (nothing)
            (if (eq (fgsg-bml-tag? expr "ident") 1)
                (do
                    (let value (fgsg-bml-env-get env (fgsg-bml-ident-name expr)))
                    (if (nothing? value) (nothing) (fk-lit value)))
            (if (eq (fgsg-bml-tag? expr "add") 1)
                (do
                    (let a (fgsg-bml-lower-expr
                        (nth (node_children expr) 0) env (sub budget 1)))
                    (let b (fgsg-bml-lower-expr
                        (nth (node_children expr) 1) env (sub budget 1)))
                    (if (or (nothing? a) (nothing? b)) (nothing) (fk-add a b)))
            (if (eq (fgsg-bml-tag? expr "sub") 1)
                (do
                    (let a (fgsg-bml-lower-expr
                        (nth (node_children expr) 0) env (sub budget 1)))
                    (let b (fgsg-bml-lower-expr
                        (nth (node_children expr) 1) env (sub budget 1)))
                    (if (or (nothing? a) (nothing? b)) (nothing) (fk-sub a b)))
                (if (eq (len (node_children expr)) 0)
                    (fk-lit (node_value expr)) (nothing)))))))
    (defn fgsg-bml-fk-lower (program)
        (do
            (let nodes (node_children program))
            (let ret-row (fgsg-bml-top-return-row nodes))
            (if (eq (nth ret-row 0) 0) (nothing)
                (do
                    (let call (head (node_children (nth ret-row 1))))
                    (if (not (eq (fgsg-bml-tag? call "fncall") 1)) (nothing)
                        (do
                            (let kids (node_children call))
                            (let method (fgsg-bml-find-method nodes
                                (fgsg-bml-ident-name (head kids))))
                            (if (or (nothing? method) (not (eq (len kids) 2)))
                                (nothing)
                                (do
                                    (let mkids (node_children method))
                                    (let params (node_children (nth mkids 1)))
                                    (let body (node_children (nth mkids 2)))
                                    (let arg (fgsg-bml-eval-expr
                                        (nth kids 1) nodes (empty) 32))
                                    (if (or (nothing? arg)
                                        (or (not (eq (len params) 1))
                                            (not (eq (len body) 1))))
                                        (nothing)
                                        (fgsg-bml-lower-expr
                                            (head (node_children (head body)))
                                            (list (list
                                                (node_value (head params)) arg))
                                            32))))))))))

    ; observation = tag parse-ok top-count direct-value fk-lowered fk-value
    (defn fgsg-bml-observe (source)
        (do
            (let program (g-parse-full (bml-grammar) source))
            (let parse-ok (if (str_eq (node_value program) "PARSE-FAIL") 0 1))
            (if (not (eq parse-ok 1))
                (list "bml-observation" 0 0 -999 0 -999)
                (do
                    (let direct (fgsg-bml-direct-run program))
                    (let fk (fgsg-bml-fk-lower program))
                    (list "bml-observation" 1 (len (node_children program))
                        (if (nothing? direct) -999 direct)
                        (if (nothing? fk) 0 1)
                        (if (nothing? fk) -999 (fk-run fk 0)))))))
    (defn fgsg-bml-pass? (observation challenge)
        (do
            (let expected (fgsg-challenge-bml-value challenge))
            (if (and (eq (nth observation 1) 1)
                (and (ge (nth observation 2) 2)
                (and (eq (nth observation 3) expected)
                (and (eq (nth observation 4) 1)
                     (eq (nth observation 5) expected))))) 1 0)))

    ; ------------------------------------------------------------------
    ; BMF: the pure raw-cursor core extracted from qbl's live mechanism.  The
    ; model/residence functions stay outside this verifier, so fkwu resolves
    ; every call in the proof chain.  Semantics remain byte-for-byte qbl:
    ; immutable cursors, same-cursor alternatives, cut on a winner, undo on a
    ; miss, and bounded `nothing` on timeout.
    ; ------------------------------------------------------------------

    (defn fgsg-bmf-ws? (byte)
        (if (eq byte 32) 1
            (if (eq byte 10) 1
                (if (eq byte 13) 1 (if (eq byte 9) 1 0)))))
    (defn fgsg-bmf-stop? (byte)
        (if (lt byte 0) 1
            (if (eq (fgsg-bmf-ws? byte) 1) 1
                (if (eq byte 123) 1 (if (eq byte 125) 1 0)))))
    (defn fgsg-bmf-skip-ws (cursor)
        (if (eq (fgsg-bmf-ws? (cur-peek cursor)) 1)
            (fgsg-bmf-skip-ws (cur-advance cursor 1)) cursor))
    (defn fgsg-bmf-word-go (cursor acc)
        (if (eq (fgsg-bmf-stop? (cur-peek cursor)) 1)
            (list acc cursor)
            (fgsg-bmf-word-go (cur-advance cursor 1)
                (str_concat acc (cur-peek-char cursor)))))
    (defn fgsg-bmf-word (cursor)
        (do
            (let current (fgsg-bmf-skip-ws cursor))
            (let byte (cur-peek current))
            (if (or (eq byte 123) (eq byte 125))
                (list (cur-peek-char current) (cur-advance current 1))
                (fgsg-bmf-word-go current ""))))
    (defn fgsg-bmf-bytes-to-brace (cursor acc)
        (do
            (let byte (cur-peek cursor))
            (if (lt byte 0) (list acc cursor)
                (if (eq byte 125) (list acc cursor)
                    (if (eq (fgsg-bmf-ws? byte) 1)
                        (fgsg-bmf-bytes-to-brace
                            (cur-advance cursor 1) acc)
                        (fgsg-bmf-bytes-to-brace
                            (cur-advance cursor 1)
                            (append acc (list byte))))))))
    (defn fgsg-bmf-words-to-brace (cursor acc)
        (do
            (let word (fgsg-bmf-word cursor))
            (if (str_eq (nth word 0) "}") (list acc (nth word 1))
                (if (eq (str_len (nth word 0)) 0)
                    (list acc (nth word 1))
                    (fgsg-bmf-words-to-brace (nth word 1)
                        (append acc (list (nth word 0))))))))
    (defn fgsg-bmf-line-to-end (cursor acc)
        (do
            (let byte (cur-peek cursor))
            (if (lt byte 0) (list acc cursor)
                (if (eq byte 10) (list acc cursor)
                    (fgsg-bmf-line-to-end (cur-advance cursor 1)
                        (str_concat acc (cur-peek-char cursor)))))))
    (defn fgsg-bmf-expect (cursor wanted)
        (do
            (let word (fgsg-bmf-word cursor))
            (if (str_eq (nth word 0) wanted)
                (list 1 (nth word 1)) (list 0 (nth word 1)))))
    (defn fgsg-bmf-lower-rule (cursor)
        (do
            (let name-word (fgsg-bmf-word cursor))
            (let name (nth name-word 0))
            (let open (fgsg-bmf-expect (nth name-word 1) "{"))
            (if (eq (nth open 0) 0)
                (list "err" "rule-brace" (nth open 1))
                (do
                    (let kind-word (fgsg-bmf-word (nth open 1)))
                    (let kind (nth kind-word 0))
                    (let rest (nth kind-word 1))
                    (if (str_eq kind "lit")
                        (do
                            (let bytes (fgsg-bmf-bytes-to-brace rest (empty)))
                            (let close (fgsg-bmf-expect (nth bytes 1) "}"))
                            (if (eq (len (nth bytes 0)) 1)
                                (list "ok" (list name "lit"
                                    (head (nth bytes 0))) (nth close 1))
                                (list "err" "lit-arity" (nth close 1))))
                    (if (str_eq kind "class")
                        (do
                            (let bytes (fgsg-bmf-bytes-to-brace rest (empty)))
                            (let close (fgsg-bmf-expect (nth bytes 1) "}"))
                            (if (ge (len (nth bytes 0)) 1)
                                (list "ok" (list name "class" (nth bytes 0))
                                      (nth close 1))
                                (list "err" "class-empty" (nth close 1))))
                    (if (str_eq kind "seq")
                        (do
                            (let words (fgsg-bmf-words-to-brace rest (empty)))
                            (list "ok" (list name "seq" (nth words 0))
                                  (nth words 1)))
                    (if (str_eq kind "alt")
                        (do
                            (let words (fgsg-bmf-words-to-brace rest (empty)))
                            (list "ok" (list name "alt" (nth words 0))
                                  (nth words 1)))
                        (list "err" (str_concat "kind-" kind) rest)))))))))

    ; result = status rules top probe cursor top-count probe-count
    (defn fgsg-qbl-lower-go (cursor rules top probe budget top-count probe-count)
        (if (le budget 0)
            (list "to" rules top probe cursor top-count probe-count)
            (do
                (let word (fgsg-bmf-word cursor))
                (let keyword (nth word 0))
                (let rest (nth word 1))
                (if (str_eq keyword "}")
                    (if (eq (cur-eof? (fgsg-bmf-skip-ws rest)) 1)
                        (list "ok" rules top probe rest top-count probe-count)
                        (list "err-trailing" rules top probe rest top-count probe-count))
                (if (str_eq keyword "")
                    (list "err-unclosed" rules top probe rest top-count probe-count)
                (if (str_eq keyword "rule")
                    (do
                        (let lowered (fgsg-bmf-lower-rule rest))
                        (if (str_eq (nth lowered 0) "ok")
                            (fgsg-qbl-lower-go (nth lowered 2)
                                (append rules (list (nth lowered 1)))
                                top probe (sub budget 1) top-count probe-count)
                            (list (str_concat "err-" (nth lowered 1))
                                  rules top probe (nth lowered 2)
                                  top-count probe-count)))
                (if (str_eq keyword "top")
                    (do
                        (let top-word (fgsg-bmf-word rest))
                        (fgsg-qbl-lower-go (nth top-word 1) rules
                            (nth top-word 0) probe (sub budget 1)
                            (add top-count 1) probe-count))
                (if (str_eq keyword "probe")
                    (do
                        (let probe-line
                            (fgsg-bmf-line-to-end (fgsg-bmf-skip-ws rest) ""))
                        (fgsg-qbl-lower-go (nth probe-line 1) rules top
                            (nth probe-line 0) (sub budget 1)
                            top-count (add probe-count 1)))
                    (list (str_concat "err-word-" keyword)
                          rules top probe rest top-count probe-count)))))))))
    (defn fgsg-qbl-lower (text)
        (do
            (let at (str_find text "grammar" 0))
            (if (not (eq at 0))
                (list "err-no-leading-grammar" (empty) "" ""
                      (cursor-str text) 0 0)
                (do
                    (let cursor (cur-advance (cursor-str text) 7))
                    (let open (fgsg-bmf-expect cursor "{"))
                    (if (eq (nth open 0) 0)
                        (list "err-open-brace" (empty) "" ""
                              (nth open 1) 0 0)
                        (fgsg-qbl-lower-go (nth open 1) (empty) "" ""
                                            48 0 0))))))

    ; Matcher state = steps-left, choices, cuts, undos.
    (defn fgsg-bmf-rule-of (rules name)
        (if (nil? rules) (nothing)
            (if (str_eq (nth (head rules) 0) name) (head rules)
                (fgsg-bmf-rule-of (tail rules) name))))
    (defn fgsg-bmf-byte-in? (byte bytes)
        (if (nil? bytes) 0
            (if (eq (head bytes) byte) 1
                (fgsg-bmf-byte-in? byte (tail bytes)))))
    (defn fgsg-bmf-state-step (state)
        (list (sub (nth state 0) 1) (nth state 1)
              (nth state 2) (nth state 3)))
    (defn fgsg-bmf-state-choice (state)
        (list (nth state 0) (add (nth state 1) 1)
              (nth state 2) (nth state 3)))
    (defn fgsg-bmf-state-cut (state)
        (list (nth state 0) (nth state 1)
              (add (nth state 2) 1) (nth state 3)))
    (defn fgsg-bmf-state-undo (state)
        (list (nth state 0) (nth state 1)
              (nth state 2) (add (nth state 3) 1)))
    (defn fgsg-bmf-match-seq (rules names cursor state)
        (if (nil? names) (list "ok" cursor state)
            (do
                (let matched (fgsg-bmf-match-ref
                    rules (head names) cursor state))
                (if (str_eq (nth matched 0) "ok")
                    (fgsg-bmf-match-seq rules (tail names)
                        (nth matched 1) (nth matched 2))
                    matched))))
    (defn fgsg-bmf-match-alt (rules names cursor state)
        (if (nil? names) (list "no" cursor state)
            (do
                (let matched (fgsg-bmf-match-ref rules (head names) cursor
                    (fgsg-bmf-state-choice state)))
                (if (str_eq (nth matched 0) "ok")
                    (list "ok" (nth matched 1)
                        (fgsg-bmf-state-cut (nth matched 2)))
                    (if (str_eq (nth matched 0) "to") matched
                        (fgsg-bmf-match-alt rules (tail names) cursor
                            (fgsg-bmf-state-undo (nth matched 2))))))))
    (defn fgsg-bmf-match-ref (rules name cursor state)
        (if (le (nth state 0) 0) (list "to" cursor state)
            (do
                (let row (fgsg-bmf-rule-of rules name))
                (if (nothing? row)
                    (list "no" cursor (fgsg-bmf-state-step state))
                    (do
                        (let next (fgsg-bmf-state-step state))
                        (let kind (nth row 1))
                        (if (str_eq kind "lit")
                            (if (eq (cur-peek cursor) (nth row 2))
                                (list "ok" (cur-advance cursor 1) next)
                                (list "no" cursor next))
                        (if (str_eq kind "class")
                            (if (eq (fgsg-bmf-byte-in?
                                    (cur-peek cursor) (nth row 2)) 1)
                                (list "ok" (cur-advance cursor 1) next)
                                (list "no" cursor next))
                        (if (str_eq kind "seq")
                            (fgsg-bmf-match-seq rules (nth row 2) cursor next)
                        (if (str_eq kind "alt")
                            (fgsg-bmf-match-alt rules (nth row 2) cursor next)
                            (list "no" cursor next))))))))))
    (defn fgsg-bmf-verdict (tag cursor)
        (if (str_eq tag "to") (nothing)
            (if (str_eq tag "ok")
                (if (eq (cur-eof? cursor) 1) 1 0) 0)))

    (defn fgsg-name-in? (name names)
        (if (nil? names) 0
            (if (str_eq name (head names)) 1
                (fgsg-name-in? name (tail names)))))
    (defn fgsg-rules-unique-go (rules seen)
        (if (nil? rules) 1
            (if (eq (fgsg-name-in? (nth (head rules) 0) seen) 1) 0
                (fgsg-rules-unique-go (tail rules)
                    (cons (nth (head rules) 0) seen)))))
    (defn fgsg-ref-names-known? (names rules)
        (if (nil? names) 1
            (if (eq (fgsg-name-in? (head names)
                    (fgsg-rule-names rules)) 1)
                (fgsg-ref-names-known? (tail names) rules) 0)))
    (defn fgsg-rule-names (rules)
        (if (nil? rules) (empty)
            (cons (nth (head rules) 0) (fgsg-rule-names (tail rules)))))
    (defn fgsg-rules-refs-known-loop (rows all)
        (if (nil? rows) 1
            (do
                (let row (head rows))
                (let kind (nth row 1))
                (if (or (str_eq kind "seq") (str_eq kind "alt"))
                    (if (eq (fgsg-ref-names-known? (nth row 2) all) 1)
                        (fgsg-rules-refs-known-loop (tail rows) all) 0)
                    (fgsg-rules-refs-known-loop (tail rows) all)))))
    (defn fgsg-rules-refs-known? (rules)
        (fgsg-rules-refs-known-loop rules rules))
    (defn fgsg-kind-count (rules kind)
        (if (nil? rules) 0
            (add (if (str_eq (nth (head rules) 1) kind) 1 0)
                 (fgsg-kind-count (tail rules) kind))))
    (defn fgsg-rule-names-independent? (rules)
        (do
            (let forbidden (list "d" "p" "e" "signal" "record" "stream"))
            (if (nil? rules) 1
                (if (eq (fgsg-name-in? (nth (head rules) 0) forbidden) 1) 0
                    (fgsg-rule-names-independent? (tail rules))))))

    ; observation = tag lower-status rule-count unique refs independent
    ;               top-count probe-count full-verdict choices cuts undos
    ;               timeout-is-nothing final-byte-position probe-bytes
    (defn fgsg-bmf-observe (source)
        (do
            (let lowered (fgsg-qbl-lower source))
            (if (not (str_eq (nth lowered 0) "ok"))
                (list "bmf-observation" (nth lowered 0) 0 0 0 0
                      (nth lowered 5) (nth lowered 6) 0 0 0 0 0 0 0)
                (do
                    (let rules (nth lowered 1))
                    (let top (nth lowered 2))
                    (let probe (nth lowered 3))
                    (let matched
                        (fgsg-bmf-match-ref rules top (cursor-str probe)
                                            (list 96 0 0 0)))
                    (let state (nth matched 2))
                    (let verdict (fgsg-bmf-verdict
                        (nth matched 0) (nth matched 1)))
                    (let timed
                        (fgsg-bmf-match-ref rules top (cursor-str probe)
                                            (list 1 0 0 0)))
                    (let timed-verdict
                        (fgsg-bmf-verdict (nth timed 0) (nth timed 1)))
                    (list "bmf-observation" "ok" (len rules)
                        (fgsg-rules-unique-go rules (empty))
                        (fgsg-rules-refs-known? rules)
                        (fgsg-rule-names-independent? rules)
                        (nth lowered 5) (nth lowered 6)
                        verdict (nth state 1) (nth state 2) (nth state 3)
                        (if (nothing? timed-verdict) 1 0)
                        (cur-pos (nth matched 1)) (str_len probe))))))
    (defn fgsg-bmf-pass? (observation)
        (fgsg-all? (list
            (str_eq (nth observation 1) "ok")
            (ge (nth observation 2) 4)
            (eq (nth observation 3) 1)
            (eq (nth observation 4) 1)
            (eq (nth observation 5) 1)
            (eq (nth observation 6) 1)
            (eq (nth observation 7) 1)
            (eq (nth observation 8) 1)
            (ge (nth observation 9) 2)
            (ge (nth observation 10) 1)
            (ge (nth observation 11) 1)
            (eq (nth observation 12) 1)
            (eq (nth observation 13) (nth observation 14)))))

    ; ------------------------------------------------------------------
    ; Form-native micro-thought compiler and execution.
    ; ------------------------------------------------------------------

    (defn fgsg-cat (parts)
        (if (nil? parts) ""
            (str_concat (head parts) (fgsg-cat (tail parts)))))
    (defn fgsg-first-line (text)
        (do
            (let end (str_find text "\n" 0))
            (if (lt end 0) text (substring text 0 end))))
    (defn fgsg-line-value (text key)
        (do
            (let marker (str_concat "\n" (str_concat key "=")))
            (let at (str_find text marker 0))
            (if (lt at 0) ""
                (do
                    (let start (add at (str_len marker)))
                    (let end (str_find text "\n" start))
                    (substring text start
                        (if (lt end 0) (str_len text) end))))))
    (defn fgsg-canonical-int? (text)
        (if (str_eq text (int_to_str (str_to_int text))) 1 0))
    (defn fgsg-control-canonical (request-line plan probe checkpoint budget plane heat pure)
        (fgsg-cat (list request-line
            "\nplan=" plan
            "\nprobe=" probe
            "\ncheckpoint=" checkpoint
            "\nbudget=" budget
            "\nplane=" plane
            "\nheat=" heat
            "\npure=" pure)))
    (defn fgsg-split3 (text)
        (do
            (let a (str_find text "," 0))
            (let b (if (lt a 0) -1 (str_find text "," (add a 1))))
            (let c (if (lt b 0) -1 (str_find text "," (add b 1))))
            (if (or (lt a 1) (or (lt b (add a 2)) (ge c 0)))
                (nothing)
                (list (substring text 0 a)
                      (substring text (add a 1) b)
                      (substring text (add b 1) (str_len text))))))
    (defn fgsg-offer-word? (word)
        (if (or (str_eq word "nothing")
            (or (str_eq word "timeout")
            (or (str_eq word "failure")
            (or (str_eq word "zero") (str_eq word "one"))))) 1 0))
    (defn fgsg-plan-word-count (words wanted)
        (if (nil? words) 0
            (add (if (str_eq (head words) wanted) 1 0)
                 (fgsg-plan-word-count (tail words) wanted))))
    (defn fgsg-offer-from-word (carrier word)
        (if (str_eq word "nothing")
            (frex-offer carrier "nothing" 0 "candidate-nothing")
        (if (str_eq word "timeout")
            (frex-offer carrier "timeout" 0 "candidate-timeout")
        (if (str_eq word "failure")
            (frex-offer carrier "failure" 0 "candidate-failure")
        (if (str_eq word "zero")
            (frex-offer carrier "value" 0 "candidate-zero")
        (if (str_eq word "one")
            (frex-offer carrier "value" 1 "candidate-one")
            (empty)))))))
    (defn fgsg-plan-offers (words)
        (list
            (fgsg-offer-from-word "metal" (nth words 0))
            (fgsg-offer-from-word "mlx" (nth words 1))
            (fgsg-offer-from-word "cpu" (nth words 2))))

    ; observation = tag shape request-ready node-input plan-shape primary-status
    ;   primary-value primary-present choice cut undo nothing one-value one-present
    ;   absent-status absent-present checkpoint-restored timeout cut-pruned
    ;   thought-kind thought-epochs jit-route jit-live-native
    (defn fgsg-control-observe (source challenge)
        (do
            (let request-line (fgsg-first-line source))
            (let plan-text (fgsg-line-value source "plan"))
            (let probe-text (fgsg-line-value source "probe"))
            (let checkpoint-text (fgsg-line-value source "checkpoint"))
            (let budget-text (fgsg-line-value source "budget"))
            (let plane (fgsg-line-value source "plane"))
            (let heat-text (fgsg-line-value source "heat"))
            (let pure-text (fgsg-line-value source "pure"))
            (let canonical (fgsg-control-canonical request-line plan-text
                probe-text checkpoint-text budget-text plane heat-text pure-text))
            (let words (fgsg-split3 plan-text))
            (let ints-ok (and (eq (fgsg-canonical-int? checkpoint-text) 1)
                (and (eq (fgsg-canonical-int? budget-text) 1)
                (and (eq (fgsg-canonical-int? heat-text) 1)
                     (eq (fgsg-canonical-int? pure-text) 1)))))
            (let words-ok (if (nothing? words) 0
                (if (and (eq (fgsg-offer-word? (nth words 0)) 1)
                    (and (eq (fgsg-offer-word? (nth words 1)) 1)
                         (eq (fgsg-offer-word? (nth words 2)) 1))) 1 0)))
            (let shape (fgsg-all? (list
                (str_eq source canonical)
                ints-ok
                (eq words-ok 1)
                (eq (fgsg-plan-word-count words "nothing") 1)
                (eq (fgsg-plan-word-count words "timeout") 1)
                (eq (fgsg-plan-word-count words "zero") 1)
                (str_eq probe-text "one")
                (eq (str_to_int checkpoint-text)
                    (fgsg-challenge-checkpoint challenge))
                (eq (str_to_int budget-text)
                    (fgsg-challenge-timeout-budget challenge))
                (str_eq plane (fgsg-challenge-plane challenge))
                (eq (str_to_int heat-text) (fgsg-challenge-heat challenge))
                (eq (str_to_int pure-text) (fgsg-challenge-pure challenge)))))
            (if (not (eq shape 1))
                (list "form-observation" 0 0 -1 0 "nothing" -1 0
                      0 0 0 0 -1 0 "nothing" 0 0 0 0 "" -1 "" 0)
                (do
                    (let request (frex-parse request-line))
                    (let primary (frex-choice request (fgsg-plan-offers words)))
                    (let one (frex-choice request
                        (list (fgsg-offer-from-word "cpu" probe-text))))
                    (let absent (frex-choice request (empty)))
                    (let checkpoint (oac-store (str_to_int checkpoint-text)))
                    (let restored (oac-undo (oac-nothing) checkpoint
                                            (add checkpoint 1)))
                    (let timed (oac-timeout-walk
                        (list bbcc-cell-silent bbcc-cell-silent bbcc-cell-thirty-four)
                        (list) (str_to_int budget-text)))
                    (let cut (oac-cut-with-receipt
                        (list bbcc-cell-silent bbcc-cell-thirty-four) (list)))
                    (let thought (bbcc-thought-route plane 6000 300))
                    (let jit (bbcc-auto-jit-plan (str_to_int heat-text)
                                (str_to_int pure-text) 8000 2000 20))
                    (let trace (frex-result-trace primary))
                    (list "form-observation" 1
                        (frex-request-ready? request)
                        (frex-request-input request)
                        (if (and (node_eq (frex-request-recipe request) (frex-recipe))
                            (str_eq (frex-request-carrier request) "auto")) 1 0)
                        (frex-result-status primary)
                        (frex-result-value primary)
                        (frex-result-value-present? primary)
                        (frex-trace-count trace "choice")
                        (frex-trace-count trace "cut")
                        (frex-trace-count trace "undo")
                        (frex-trace-count trace "nothing")
                        (frex-result-value one)
                        (frex-result-value-present? one)
                        (frex-result-status absent)
                        (frex-result-value-present? absent)
                        (if (eq restored checkpoint) 1 0)
                        (oac-timed-out? timed)
                        (oac-cut-receipt-pruned cut)
                        (if (nothing? thought) "" (nth thought 2))
                        (if (nothing? thought) -1 (nth thought 3))
                        (bbcc-jit-plan-route jit)
                        (bbcc-jit-plan-live-native? jit))))))
    (defn fgsg-control-pass? (observation challenge)
        (fgsg-all? (list
            (eq (nth observation 1) 1)
            (eq (nth observation 2) 1)
            (eq (nth observation 3) (fgsg-challenge-input challenge))
            (eq (nth observation 4) 1)
            (str_eq (nth observation 5) "value")
            (eq (nth observation 6) 0)
            (eq (nth observation 7) 1)
            (eq (nth observation 8) 3)
            (eq (nth observation 9) 1)
            (eq (nth observation 10) 1)
            (eq (nth observation 11) 1)
            (eq (nth observation 12) 1)
            (eq (nth observation 13) 1)
            (str_eq (nth observation 14) "nothing")
            (eq (nth observation 15) 0)
            (eq (nth observation 16) 1)
            (eq (nth observation 17) 1)
            (eq (nth observation 18) 1)
            (str_eq (nth observation 19) "learned")
            (eq (nth observation 20) 20)
            (str_eq (nth observation 21) "crystallize-plan")
            (eq (nth observation 22) 0))))

    ; ------------------------------------------------------------------
    ; One typed verdict.  `model-executed` and `native-carrier-executed` stay
    ; zero here; only the dormant live runner may witness the former.
    ; ------------------------------------------------------------------

    (defn fgsg-verdict-row
        (overall bml-pass bmf-pass form-pass leakage bml bmf form)
        (list "generative-form-skill-verdict" overall bml-pass bmf-pass
              form-pass leakage 0 0 bml bmf form (fgsg-leakage-boundary)))
    (defn fgsg-verdict-overall (verdict) (nth verdict 1))
    (defn fgsg-verdict-bml (verdict) (nth verdict 2))
    (defn fgsg-verdict-bmf (verdict) (nth verdict 3))
    (defn fgsg-verdict-form (verdict) (nth verdict 4))
    (defn fgsg-verdict-leakage (verdict) (nth verdict 5))
    (defn fgsg-verdict-model-executed? (verdict) (nth verdict 6))
    (defn fgsg-verdict-native-carrier-executed? (verdict) (nth verdict 7))
    (defn fgsg-verdict-bml-observation (verdict) (nth verdict 8))
    (defn fgsg-verdict-bmf-observation (verdict) (nth verdict 9))
    (defn fgsg-verdict-form-observation (verdict) (nth verdict 10))
    (defn fgsg-verify (candidate challenge)
        (if (not (eq (fgsg-candidate? candidate) 1))
            (fgsg-verdict-row 0 0 0 0 (fgsg-exact-leakage)
                (empty) (empty) (empty))
            (do
                (let bml (fgsg-bml-observe (fgsg-candidate-bml candidate)))
                (let bmf (fgsg-bmf-observe (fgsg-candidate-bmf candidate)))
                (let form (fgsg-control-observe
                    (fgsg-candidate-form candidate) challenge))
                (let bp (fgsg-bml-pass? bml challenge))
                (let gp (fgsg-bmf-pass? bmf))
                (let fp (fgsg-control-pass? form challenge))
                (let leakage (fgsg-exact-leakage))
                (fgsg-verdict-row
                    (if (and (eq bp 1) (and (eq gp 1)
                        (and (eq fp 1) (eq leakage 0)))) 1 0)
                    bp gp fp leakage bml bmf form))))

    (fgsg-exact-leakage))
