; form-knowledge-public-registry-adapter-run.fk -- read-only live join of the
; authoritative census, persisted public shard report, and one public
; scannerless query-token observation.
;
; This top-level runner opens current source and registry artifacts.  It must
; never be preflighted, because preflight executes top-level Form.  It performs
; no artifact writes, no model call, no hidden/heldout evaluation, no teaching
; exposure, and no weight mutation.  The public query cohort is operational,
; not heldout evidence.
;
; preludes: form-stdlib/form-knowledge-public-registry-adapter.fk

(do
    (defn fkiprr-line (key value)
        (print_str (str_concat key (str_concat "=" (str_concat value "\n")))))
    (defn fkiprr-int (key value)
        (fkiprr-line key (int_to_str value)))

    (let root (fhcs-default-root))
    (let artifact (fknq-default-artifact))
    (let families (fki-families))
    (let sources (fki-live-source-units))
    (let base (fki-report-with-source-retrieval "repository-live-census"
        families sources (fki-seed-concepts) (empty) (empty)))
    (let shard (pscish-report-at root artifact))
    (let surface (fknq-concept-surface "defn-psci-schema"))
    ; local-ready=0: this observation opens the native registry/source lane and
    ; makes no claim that a resident model was present.
    (let query-result (fknqr-execute-strict surface 0))
    (let evidence (list (fkipr-query-evidence surface query-result
        "public-operational-defn-psci-schema")))
    (let cohort (list "concept=defn-psci-schema"))
    (let report (fkipr-report root sources base shard cohort evidence))

    (fkiprr-int "census-sources" (fkipr-report-census-total report))
    (fkiprr-int "base-mapped-sources" (fki-report-mapped-sources base))
    (fkiprr-int "shard-denominator"
        (fkipr-report-shard-denominator report))
    (fkiprr-int "shard-indexed" (fkipr-report-shard-indexed report))
    (fkiprr-int "shard-current" (fkipr-report-shard-current report))
    (fkiprr-int "concept-bearing-current-minimum"
        (fkipr-report-concept-bearing-minimum report))
    (fkiprr-int "registry-source-percent"
        (fkipr-report-registry-source-percent report))
    (fkiprr-int "concept-bearing-source-percent"
        (fkipr-report-concept-bearing-percent report))
    (fkiprr-int "shard-threshold95"
        (fkipr-report-shard-threshold95? report))
    (fkiprr-int "census-aligned"
        (fkipr-report-census-aligned? report))
    (fkiprr-int "current-closure"
        (fkipr-report-current-closure? report))
    (fkiprr-int "public-query-cohort-total"
        (fkipr-report-query-cohort-total report))
    (fkiprr-int "executable-query-tokens"
        (fkipr-report-valid-query-tokens report))
    (fkiprr-int "executable-query-gate"
        (fkipr-report-executable-query-gate? report))
    (fkiprr-int "base-heldout-integrated-percent"
        (fkipr-report-base-heldout-percent report))
    (fkiprr-int "base-grounded-rag-percent"
        (fkipr-report-base-grounded-rag-percent report))
    (fkiprr-int "base-provenance-percent"
        (fkipr-report-base-provenance-percent report))
    (fkiprr-int "base-teaching-prefix-percent"
        (fkipr-report-base-teaching-prefix-percent report))
    (fkiprr-int "base-learned-weight-percent"
        (fkipr-report-base-learned-weight-percent report))
    (fkiprr-int "base-integration-ready95"
        (fkipr-report-base-integration-ready95? report))
    (fkiprr-int "base-repository-ready95"
        (fkipr-report-base-repository-ready95? report))
    (fkiprr-int "adapter-repository-ready95"
        (fkipr-report-adapter-repository-ready95? report))
    (fkiprr-int "registry-model-executed"
        (fkipr-report-registry-model-executed? report))
    (fkiprr-line "basis" (fkipr-report-basis report))
    0)
