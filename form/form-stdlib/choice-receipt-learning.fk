// choice-receipt-learning.fk — turn CHOICE-RECEIPTs into branch-order feedback.
//
// A receipt is witnessed outcome. A branch-order candidate is remembered
// outcome. This adapter is the reversible seam between them: selected success
// increments short-success; selected fail increments short-fail; silence and
// unselected branches remain unchanged.
//
import "form/form-stdlib/choice-receipt.fk"
import "form/form-stdlib/branch-choice-order.fk"
section [form.bml] {
    def crl-selected?(candidate, receipt) = (String) bco-path(candidate) == cr-receipt-selected-path(receipt);
    def crl-learn-candidate(candidate, receipt) = crl-selected?(candidate, receipt) ? (String) cr-receipt-outcome(receipt) == cr-outcome-success() ? bco-note-success(candidate) : (String) cr-receipt-outcome(receipt) == cr-outcome-fail() ? bco-note-fail(candidate) : candidate : candidate;
    def crl-learn-candidates(candidates, receipt) = (Comparable) len(candidates) == 0 ? empty() : cons(crl-learn-candidate(head(candidates), receipt), crl-learn-candidates(tail(candidates), receipt));
    def crl-roll-forward-candidates(candidates, threshold) = (Comparable) len(candidates) == 0 ? empty() : cons(bco-roll-forward(head(candidates), threshold), crl-roll-forward-candidates(tail(candidates), threshold));
    def crl-best-path-after-receipt(candidates, receipt) = bco-choose-best-path(crl-learn-candidates(candidates, receipt));
    0;
}
