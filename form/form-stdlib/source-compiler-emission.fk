// source-compiler-emission.fk -- compiler-output receipt for source artifacts.
//
// This layer binds a compile-source request to caller-supplied emission values:
// a valid program-image fkb envelope, its exact table-text witness, and an
// optional native dylib descriptor. It is observational only. It validates row
// consistency and emits a receipt; it does not compile, persist artifacts,
// execute table text, load or call runtime artifacts, install a selector, or
// grow the C seed.
//
// "Current" in this layer means the provided source/artifact fields satisfy the
// existing descriptor/cache predicates. It is not filesystem truth.
//
// preludes: form-stdlib/core.fk form-stdlib/source-artifact-cache.fk form-stdlib/source-artifact-descriptor.fk form-stdlib/runtime-artifact-plan.fk form-stdlib/runtime-artifact-selector.fk form-stdlib/runtime-artifact-outcome.fk form-stdlib/runtime-artifact-retry.fk form-stdlib/runtime-artifact-load-envelope.fk form-stdlib/program-image-fkb.fk form-stdlib/program-image-tbl-emit.fk
section [form.bml] {
    def sce-version() = "source-compiler-emission-v1";
    def sce-feature(name, status) = ["source-compiler-emission-feature", name, status];
    def sce-feature-name(f) = f[1];
    def sce-feature-status(f) = f[2];
    def source-compiler-emission-manifest() = [sce-feature("observational-receipt-not-compiler", 1), sce-feature("compile-envelope-bound", 1), sce-feature("sac-compile-output-provenance", 1), sce-feature("program-image-fkb-emission", 1), sce-feature("fkb-descriptor-derived-from-pif", 1), sce-feature("includes-tbl-required", 1), sce-feature("table-text-witness-required", 1), sce-feature("optional-native-dylib-descriptor", 1), sce-feature("route-policy-delegated-to-sad", 1), sce-feature("current-is-provided-field-consistency", 1), sce-feature("explicit-reason-manifest", 1), sce-feature("no-disk-io", 1), sce-feature("no-binary-artifact-io", 1), sce-feature("no-runtime-load-walk-call-exec", 1), sce-feature("no-selector-install", 1), sce-feature("no-c-seed-growth", 1)];
    def source-compiler-emission-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) sce-feature-name(head(fs)) == name && (Comparable) sce-feature-status(head(fs)) == 1 ? 1 : source-compiler-emission-manifest-has?(name, tail(fs));
    def sce-status-emitted() = "emitted";
    def sce-status-investigate() = "investigate";
    def sce-status-refused() = "refused";
    def sce-reason-compile-emission-ready() = "compile-emission-ready";
    def sce-reason-compile-emission-ready-with-dylib() = "compile-emission-ready-with-dylib";
    def sce-reason-malformed-compile-envelope() = "malformed-compile-envelope";
    def sce-reason-non-compile-envelope() = "non-compile-envelope";
    def sce-reason-malformed-compile-output() = "malformed-compile-output";
    def sce-reason-compile-output-does-not-write-fkb() = "compile-output-does-not-write-fkb";
    def sce-reason-compile-output-missing-tbl() = "compile-output-missing-tbl";
    def sce-reason-compile-output-c-growth() = "compile-output-c-growth";
    def sce-reason-malformed-pif-envelope() = "malformed-pif-envelope";
    def sce-reason-pif-seal-invalid() = "pif-seal-invalid";
    def sce-reason-pif-table-invalid() = "pif-table-invalid";
    def sce-reason-pif-envelope-stale() = "pif-envelope-stale";
    def sce-reason-source-identity-mismatch() = "source-identity-mismatch";
    def sce-reason-table-text-mismatch() = "table-text-mismatch";
    def sce-reason-dylib-not-requested() = "dylib-not-requested";
    def sce-reason-dylib-requested-missing() = "dylib-requested-missing";
    def sce-reason-malformed-dylib-descriptor() = "malformed-dylib-descriptor";
    def sce-reason-dylib-source-mismatch() = "dylib-source-mismatch";
    def sce-reason-dylib-policy-unsatisfied() = "dylib-policy-unsatisfied";
    def sce-reason-manifest() = [sce-reason-compile-emission-ready(), sce-reason-compile-emission-ready-with-dylib(), sce-reason-malformed-compile-envelope(), sce-reason-non-compile-envelope(), sce-reason-malformed-compile-output(), sce-reason-compile-output-does-not-write-fkb(), sce-reason-compile-output-missing-tbl(), sce-reason-compile-output-c-growth(), sce-reason-malformed-pif-envelope(), sce-reason-pif-seal-invalid(), sce-reason-pif-table-invalid(), sce-reason-pif-envelope-stale(), sce-reason-source-identity-mismatch(), sce-reason-table-text-mismatch(), sce-reason-dylib-not-requested(), sce-reason-dylib-requested-missing(), sce-reason-malformed-dylib-descriptor(), sce-reason-dylib-source-mismatch(), sce-reason-dylib-policy-unsatisfied()];
    def sce-bit?(x) = (Comparable) x == 0 ? 1 : (Comparable) x == 1 ? 1 : 0;
    def sce-no-dylib() = ["source-compiler-emission-no-dylib"];
    def sce-no-dylib?(d) = (Comparable) len(d) == 1 ? (String) d[0] == "source-compiler-emission-no-dylib" : 0;
    def sce-dylib-or-none(d) = sce-no-dylib?(d) ? sad-no-artifact() : d;
    def sce-compile-output?(o) = (Comparable) len(o) == 5 ? (String) o[0] == "source-compile-output" ? sce-bit?(sac-output-writes-fkb(o)) ? sce-bit?(sac-output-writes-dylib(o)) ? sce-bit?(sac-output-includes-tbl(o)) ? sce-bit?(sac-output-no-c-growth(o)) : 0 : 0 : 0 : 0 : 0;
    def sce-compile-output-writes-fkb?(o) = sce-compile-output?(o) ? sac-output-writes-fkb(o) : 0;
    def sce-compile-output-writes-dylib?(o) = sce-compile-output?(o) ? sac-output-writes-dylib(o) : 0;
    def sce-compile-output-includes-tbl?(o) = sce-compile-output?(o) ? sac-output-includes-tbl(o) : 0;
    def sce-compile-output-no-c-growth?(o) = sce-compile-output?(o) ? sac-output-no-c-growth(o) : 0;
    def sce-source-from-envelope(e) = rale-envelope?(e) ? rale-envelope-source(e) : sad-source("", "", 0);
    def sce-compile-envelope-shape-ok?(e) = rale-envelope?(e) ? sad-source-valid?(rale-envelope-source(e)) : 0;
    def sce-compile-envelope-ready?(e) = sce-compile-envelope-shape-ok?(e) ? (String) rale-envelope-status(e) == rale-status-request-ready() ? (String) rale-envelope-action(e) == rap-act-compile-source() ? (Comparable) rale-envelope-route(e) == sac-run-source-compile() ? (String) rale-envelope-artifact-kind(e) == rale-kind-source() : 0 : 0 : 0 : 0;
    def sce-source-pif-match?(source, pif) = sad-source-valid?(source) ? pif-envelope-shape-valid?(pif) ? (String) sad-source-path(source) == pif-envelope-source-path(pif) ? (String) sad-source-hash(source) == pif-envelope-source-hash(pif) ? (Comparable) sad-source-mtime(source) == pif-envelope-source-mtime(pif) ? 1 : 0 : 0 : 0 : 0 : 0;
    def sce-table-text-match?(pif, table-text) = (String) table-text == pite-table-text-from-envelope(pif);
    def sce-fkb-from-pif(pif) = pif-descriptor-from-envelope(pif);
    def sce-pif-current?(source, pif) = (Comparable) sad-route(source, sce-fkb-from-pif(pif), sad-no-artifact()) == sac-run-fkb();
    def sce-dylib-descriptor?(d) = (Comparable) len(d) == 12 ? sad-artifact?(d) ? sad-artifact-option-valid?(d) ? (String) sad-artifact-kind(d) == sad-kind-native-dylib() ? (String) sad-artifact-version(d) == sad-version-native-dylib() : 0 : 0 : 0 : 0;
    def sce-dylib-source-match?(source, d) = sad-source-valid?(source) ? sce-dylib-descriptor?(d) ? (String) sad-source-hash(source) == sad-artifact-source-hash(d) : 0 : 0;
    def sce-dylib-policy-satisfied?(source, fkb, d) = sce-dylib-descriptor?(d) ? (Comparable) sad-route(source, fkb, d) == sac-run-dylib() ? (Comparable) sad-artifact-lowerable(d) == 1 : 0 : 0;
    // emission = ("source-compiler-emission" compile-envelope compile-output
    //             pif-envelope table-text dylib fkb-descriptor status reason)
    def sce-emission(compile-envelope, compile-output, pif, table-text, dylib, fkb, status, reason) = ["source-compiler-emission", compile-envelope, compile-output, pif, table-text, dylib, fkb, status, reason];
    def sce-emission?(e) = (Comparable) len(e) == 9 ? (String) e[0] == "source-compiler-emission" : 0;
    def sce-emission-compile-envelope(e) = e[1];
    def sce-emission-compile-output(e) = e[2];
    def sce-emission-pif-envelope(e) = e[3];
    def sce-emission-table-text(e) = e[4];
    def sce-emission-dylib(e) = e[5];
    def sce-emission-fkb-descriptor(e) = e[6];
    def sce-emission-status(e) = e[7];
    def sce-emission-reason(e) = e[8];
    def sce-emitted?(e) = sce-emission?(e) ? (String) sce-emission-status(e) == sce-status-emitted() : 0;
    def sce-investigate?(e) = sce-emission?(e) ? (String) sce-emission-status(e) == sce-status-investigate() : 0;
    def sce-refused?(e) = sce-emission?(e) ? (String) sce-emission-status(e) == sce-status-refused() : 0;
    def sce-row(compile-envelope, compile-output, pif, table-text, dylib, status, reason) = sce-emission(compile-envelope, compile-output, pif, table-text, dylib, sce-fkb-from-pif(pif), status, reason);
    def sce-emitted-row(compile-envelope, compile-output, pif, table-text, dylib, reason) = sce-row(compile-envelope, compile-output, pif, table-text, dylib, sce-status-emitted(), reason);
    def sce-investigate-row(compile-envelope, compile-output, pif, table-text, dylib, reason) = sce-row(compile-envelope, compile-output, pif, table-text, dylib, sce-status-investigate(), reason);
    def sce-refused-row(compile-envelope, compile-output, pif, table-text, dylib, reason) = sce-row(compile-envelope, compile-output, pif, table-text, dylib, sce-status-refused(), reason);
    def sce-emission-after-dylib-policy(compile-envelope, compile-output, pif, table-text, dylib, source, fkb) = (Comparable) sce-compile-output-writes-dylib?(compile-output) == 0 ? sce-no-dylib?(dylib) ? sce-emitted-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-compile-emission-ready()) : sce-investigate-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-dylib-not-requested()) : sce-no-dylib?(dylib) ? sce-investigate-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-dylib-requested-missing()) : !sce-dylib-descriptor?(dylib) ? sce-refused-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-malformed-dylib-descriptor()) : !sce-dylib-source-match?(source, dylib) ? sce-investigate-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-dylib-source-mismatch()) : !sce-dylib-policy-satisfied?(source, fkb, dylib) ? sce-investigate-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-dylib-policy-unsatisfied()) : sce-emitted-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-compile-emission-ready-with-dylib());
    def sce-emission-from-compile(compile-envelope, compile-output, pif, table-text, dylib) = {
        let source = sce-source-from-envelope(compile-envelope);
        let fkb = sce-fkb-from-pif(pif);
        !rale-envelope?(compile-envelope) ? sce-refused-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-malformed-compile-envelope()) : !sad-source-valid?(source) ? sce-refused-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-malformed-compile-envelope()) : !sce-compile-envelope-ready?(compile-envelope) ? sce-refused-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-non-compile-envelope()) : !sce-compile-output?(compile-output) ? sce-refused-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-malformed-compile-output()) : !((Comparable) sce-compile-output-writes-fkb?(compile-output) == 1) ? sce-investigate-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-compile-output-does-not-write-fkb()) : !((Comparable) sce-compile-output-includes-tbl?(compile-output) == 1) ? sce-investigate-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-compile-output-missing-tbl()) : !((Comparable) sce-compile-output-no-c-growth?(compile-output) == 1) ? sce-investigate-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-compile-output-c-growth()) : !pif-envelope-shape-valid?(pif) ? sce-refused-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-malformed-pif-envelope()) : !((Comparable) pif-envelope-seal-ok(pif) == 1) ? sce-investigate-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-pif-seal-invalid()) : !pif-table-valid?(pif-envelope-table(pif)) ? sce-investigate-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-pif-table-invalid()) : !sce-source-pif-match?(source, pif) ? sce-investigate-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-source-identity-mismatch()) : !sce-pif-current?(source, pif) ? sce-investigate-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-pif-envelope-stale()) : !sce-table-text-match?(pif, table-text) ? sce-investigate-row(compile-envelope, compile-output, pif, table-text, dylib, sce-reason-table-text-mismatch()) : sce-emission-after-dylib-policy(compile-envelope, compile-output, pif, table-text, dylib, source, fkb);
    };
}
