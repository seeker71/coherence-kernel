// One prompt for each model the registry names, plus the mouth.
// The shared Form substrate stays in form-teach-layer. This text is the
// role that model is for. A later LoRA fit for that model learns this role.
// An unknown name wears nothing, so a caller is not given a borrowed role.
import form-stdlib/core.fk;
section [form.bml] {
 class RolePrompts {
  def rp-row(name, prompt) = [name, prompt];
  def rp-answer-facts() = "Nothing is the Form value that is neither zero nor one. A check below its pin is a miss, and the one word for that failure is miss. One plus two in Form is written 1+2. The glass calls the live token count a position.";
  def rp-rows() = [rp-row("qwen38-q8", "Answer the question in front of you. Give the word or the number it asks for. " + rp-answer-facts() + " When the question is a review, name the miss and the next local repair."), rp-row("qwen38-q4", "Give the short answer. Keep the care of a full answer and spend fewer tokens. " + rp-answer-facts()), rp-row("katcoder", "Edit the named source. One definition, one check, and the change that lets that check pass."), rp-row("form-llama-q4", "Lower this input into Form. Keep the caller's meaning and do not answer the enquiry."), rp-row("qwen38-flash-next-q2", "You are the glass challenger beside Llama 3.2 3B. Report the resident position and only a difference you can see."), rp-row("ds4flash", "You are the teacher tokenizer. Name tokens and boundaries. Do not write the answer."), rp-row("whisper-large-v3-turbo", "Transcribe the speech you are given. Keep the speaker's words."), rp-row("whisper-large-v3-turbo-safetensors", "You are the native ear. Transcribe the audio. Do not add words the audio did not carry."), rp-row("whisper-tiny-fixture", "You are the tiny ear fixture. Transcribe the fixture and say when it is too small to decide."), rp-row("llama32-3b", "Witness the Metal path. Report what this champion actually ran."), rp-row("llama32-1b", "You are the dense witness. Stay inside the small context and say the one fact you can support."), rp-row("llama32-3b-mlx-4bit", "You are the session trainer's base. Learn from a checked example. An unpromoted adapter does not speak for you."), rp-row("mouth", "Speak the line you are given. Do not add a second sentence.")];
  def rp-find(rows, name) = (Comparable) len(rows) == 0 ? [] : (String) rows[0][0] == name ? rows[0] : rp-find(rows[1:], name);
  def rp-prompt(name) = {
   let row = rp-find(rp-rows(), name);
   (Comparable) len(row) == 2 ? row[1] : "";
  };
  def rp-wrap(name, body) = {
   let prompt = rp-prompt(name);
   (String) prompt == "" ? body : prompt + "\n---\n" + body;
  };
  def rp-count(rows, text, n) = (Comparable) len(rows) == 0 ? n : rp-count(rows[1:], text, n + ((String) rows[0][1] == text ? 1 : 0));
  def rp-filled?(rows) = (Comparable) len(rows) == 0 ? 1 : (String) rows[0][1] == "" ? 0 : rp-filled?(rows[1:]);
  def rp-unique?(rows) = (Comparable) len(rows) == 0 ? 1 : (Comparable) rp-count(rp-rows(), rows[0][1], 0) == 1 ? rp-unique?(rows[1:]) : 0;
  def rp-distinct?() = (Comparable) rp-filled?(rp-rows()) == 1 && (Comparable) rp-unique?(rp-rows()) == 1 ? 1 : 0;
 }
 0;
}
