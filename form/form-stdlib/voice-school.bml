//////////////////////////////////////////////////////////////////////
// voice-school.bml — the body teaches itself, locally, without limit:
// each cycle emits its rows, trains the adapter, harvests it into ice,
// grades it on held-out corpus questions beside the base model (first
// word equals the row's word), publishes the gift to the shared glass,
// writes one ledger line, and commits locally. Rented tokens: none.
// preludes: form/form-stdlib/lora-voice.bml form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/hearth.bml
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormVoiceSchool {
        field VSLedger = "receipts/voice-school-ledger.md";
        field VSGrade = 10;
        def vs-cat(parts) = lv-cat(parts);
        def vs-text(t) = t ?? "";
        def vs-between(s, open, close, from) {
            let a = str_find(s, open, from);
            let b = a < 0 ? (0 - 1) : str_find(s, close, a + str_len(open));
            (a < 0) || (b < 0) ? "" : substring(s, a + str_len(open), b);
        }
        def vs-unq(s, i, acc) = i >= str_len(s) ? acc : ((Comparable) str_byte_at(s, i) == 92) && ((i + 1) < str_len(s)) ? vs-unq(s, i + 2, acc ++ ((Comparable) str_byte_at(s, i + 1) == 110 ? " " : byte_to_str(str_byte_at(s, i + 1)))) : vs-unq(s, i + 1, acc ++ byte_to_str(str_byte_at(s, i)));
        def vs-question(line) = vs-unq(vs-between(line, lv-cat(list(lv-q(), "content", lv-q(), ":", lv-q())), lv-cat(list(lv-q(), "},{")), 0), 0, "");
        def vs-answer(line) {
            let first = str_find(line, lv-cat(list(lv-q(), "content", lv-q(), ":", lv-q())), 0);
            vs-unq(vs-between(line, lv-cat(list(lv-q(), "content", lv-q(), ":", lv-q())), lv-cat(list(lv-q(), "}]}")), first + 1), 0, "");
        }
        def vs-word-end(s, i) = i >= str_len(s) ? i : ((Comparable) str_byte_at(s, i) == 46) || (((Comparable) str_byte_at(s, i) == 32) || (((Comparable) str_byte_at(s, i) == 44) || ((Comparable) str_byte_at(s, i) == 10))) ? i : vs-word-end(s, i + 1);
        def vs-first-word(s) {
            let t = trim(s);
            let t2 = (str_len(t) > 0) && ((Comparable) str_byte_at(t, 0) == 34) ? substring(t, 1, str_len(t)) : t;
            substring(t2, 0, vs-word-end(t2, 0));
        }
        def vs-lower(s) = 0 .. str_len(s) |> foldl((acc, i) => acc ++ byte_to_str((str_byte_at(s, i) >= 65) && (str_byte_at(s, i) <= 90) ? (str_byte_at(s, i) + 32) : str_byte_at(s, i)), "");
        def vs-corpus-line?(line) = str_find(line, "The body asks the smallest question", 0) >= 0 ? 1 : 0;
        def vs-corpus-lines(lines, n) = ((Comparable) len(lines) == 0) || (n <= 0) ? list() : (Comparable) vs-corpus-line?(head(lines)) == 1 ? cons(head(lines), vs-corpus-lines(tail(lines), n - 1)) : vs-corpus-lines(tail(lines), n);
        // The same 3B base on both sides; one shared tokenizer, two model owners.
        def vs-open-pair(data) {
            let base = nlg-open(lv-model(),"");
            list(base,list(nll-open(lv-model(),lv-adapter-path(data)),base[1]));
        }
        def vs-close-pair(pair,result) {
            let a = nlg-close(head(pair)); let b = nlg-close(pair[1]);
            result;
        }
        def vs-ask-on(pair,q,withAdapter) = vs-complete(nlg-ask(pair[withAdapter],q,0,"","",lv-events()));
        def vs-complete(result) = (str_len(result[1]) > 0) || ((Comparable) str_len(head(result)) == 0) ? form_error("school grade awaits a complete answer: " ++ result[1]) : head(result);
        def vs-answer-word(pair,q,withAdapter) = vs-lower(vs-first-word(vs-ask-on(pair,q,withAdapter)));
        // grade: (n base-hits adapter-hits)
        def vs-grade-go(data, lines, n, bh, ah) {
            (Comparable) len(lines) == 0 ? list(n, bh, ah)
            : vs-grade-one(data, tail(lines), n, bh, ah, vs-question(head(lines)), vs-lower(vs-first-word(vs-answer(head(lines)))));
        }
        def vs-grade-one(data, rest, n, bh, ah, q, want) {
            let b = (String) vs-answer-word(data, q, 0) == want ? 1 : 0;
            let a = (String) vs-answer-word(data, q, 1) == want ? 1 : 0;
            vs-grade-go(data, rest, n + 1, bh + b, ah + a);
        }
        def vs-grade(data,n) {
            let rows = vs-corpus-lines(split-on(vs-text(read_file(data ++ "/valid.jsonl")),byte_to_str(10)),n);
            !((Comparable) len(rows) == n) ? form_error("school held-out corpus is incomplete") : vs-grade-ready(data,rows);
        }
        def vs-grade-ready(data,rows) {
            let pair = vs-open-pair(data);
            vs-close-pair(pair,vs-grade-go(pair,rows,0,0,0));
        }
        def vs-harvest(data,home) {
            !((String) nlw-status(data) == "completed") ? form_error("school harvest awaits successful training") : vs-harvest-ready(nag-complete(nag-resolve(data ++ "/adapter")),home);
        }
        def vs-harvest-ready(source,home) {
            let generation = home ++ "/generations/" ++ fs-path-basename(source);
            let made = fs-mkdir(generation);
            let args = append(list("/bin/cp"),append(vs-generation-files(source),list(generation)));
            let pid = host_spawn_at(args,list("/dev/null","/dev/null","/dev/null"));
            pid <= 0 ? form_error("school generation copy could not launch") : !((Comparable) host_wait(pid) == 0) ? form_error("school generation copy failed") : vs-harvest-copied(source,generation,home);
        }
        def vs-generation-files(dir) = list(dir ++ "/adapters.safetensors",dir ++ "/optimizer.safetensors",dir ++ "/adapter_config.json",dir ++ "/complete.json");
        def vs-copy-sizes(a,b) = nil?(a) ? 1 : (((Comparable) file_size(head(a)) == file_size(head(b))) && vs-copy-sizes(tail(a),tail(b)));
        def vs-harvest-copied(source,generation,home) {
            !vs-copy-sizes(vs-generation-files(source),vs-generation-files(generation)) ? form_error("school generation copy extent mismatch") : nag-publish(home,generation);
        }
        def vs-tags() = list("all", "we", "mesh", "voice");
        def vs-sample(id, purpose, n, lifecycle, epoch) = fgtm-sample(id, fgtm-absent(), "voice-school", "form", "voice.school", "voice", purpose, fgtm-absent(), fgtm-present(n), lifecycle, fgtm-absent(), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "never", "physical-live", "voice-school", vs-tags());
        def vs-publish(troot, cycle, rows, grade, epoch) = fgtm-publish-snapshot(troot, "voice.school", epoch, list(
            vs-sample("voice.school.cycle", "cycles-harvested", cycle, "active", epoch),
            vs-sample("voice.school.rows", "teacher-rows", rows, "stored", epoch),
            vs-sample("voice.school.heldout.base", vs-cat(list("hits-of-", int_to_str(head(grade)))), grade[1], "ready", epoch),
            vs-sample("voice.school.heldout.adapter", vs-cat(list("hits-of-", int_to_str(head(grade)))), grade[2], grade[2] > grade[1] ? "active" : "ready", epoch)));
        def vs-ledger-line(date, cycle, data, rows, grade, sha8) = vs-cat(list("| ", date, " | ", int_to_str(cycle), " | ", data, " | ", int_to_str(rows), " | base ", int_to_str(grade[1]), "/", int_to_str(head(grade)), " | adapter ", int_to_str(grade[2]), "/", int_to_str(head(grade)), " | ", sha8, " |", byte_to_str(10)));
        def vs-ledger-append(line) = sbt-append(VSLedger(), line);
        def vs-cycles(ledger) = vs-count-rows(split-on(ledger, byte_to_str(10)), 0);
        def vs-count-rows(lines, n) = (Comparable) len(lines) == 0 ? n : vs-count-rows(tail(lines), n + ((Comparable) str_find(head(lines), "| 20", 0) == 0 ? 1 : 0));
        def vs-sha8(path) = substring(vs-text(host-exec(vs-cat(list("shasum -a 256 ", path, " 2>/dev/null")), "")), 0, 8);
        def vs-rows(data) = len(split-on(vs-text(read_file(data ++ "/train.jsonl")), byte_to_str(10))) - 1;
        def vs-commit(cycle, grade) = vs-text(host-exec(vs-cat(list("git add form/form-stdlib/adapters ", VSLedger(), " && git commit -q -m 'voice school cycle ", int_to_str(cycle), ": held-out base ", int_to_str(grade[1]), " adapter ", int_to_str(grade[2]), " of ", int_to_str(head(grade)), "' && echo committed")), ""));
    }
    0;
}
section [form.bml] {
    class FormVoiceSchoolPerception {
        // A school of perception rows cannot be graded on corpus questions —
        // its held-out set has none. The question it CAN be graded on is the
        // one only a body that sat in the room can answer: given a frame's
        // source stamp alone, name the shape that moment took. The shape is
        // never in the question, so a model that never heard this room has
        // nothing to reach for, and a hit is the room itself coming back.
        def vsp-shape-of(line) = vs-between(line, "Its shape is ", ", node", 0);
        def vsp-lines(lines, n) = ((Comparable) len(lines) == 0) || (n <= 0) ? list() : vsp-lines-at(lines, n, vsp-shape-of(head(lines)));
        def vsp-lines-at(lines, n, shape) = (Comparable) str_len(shape) == 0 ? vsp-lines(tail(lines), n) : cons(head(lines), vsp-lines(tail(lines), n - 1));
        def vsp-hit?(ans, shape) = (Comparable) str_len(shape) == 0 ? 0 : str_find(vs-text(ans), shape, 0) < 0 ? 0 : 1;
        // (n base-hits adapter-hits)
        def vsp-go(data, lines, n, bh, ah) = (Comparable) len(lines) == 0 ? list(n, bh, ah) : vsp-one(data, tail(lines), n, bh, ah, vs-question(head(lines)), vsp-shape-of(head(lines)));
        // the shape is the LAST thing a perception answer says, so the answer
        // must be allowed to reach it before it is read
        // the same reason as `vs-answer-word`: both sides of a shape grade
        // ride the one model the adapter was fitted to
        def vsp-one(pair,rest,n,bh,ah,q,shape) = vsp-go(pair,rest,n + 1,bh + vsp-hit?(vs-ask-on(pair,q,0),shape),ah + vsp-hit?(vs-ask-on(pair,q,1),shape));
        def vsp-grade(data,n) {
            let rows = vsp-lines(split-on(vs-text(read_file(data ++ "/valid.jsonl")),byte_to_str(10)),n);
            !((Comparable) len(rows) == n) ? form_error("school held-out perception rows are incomplete") : vsp-grade-ready(data,rows);
        }
        def vsp-grade-ready(data,rows) {
            let pair = vs-open-pair(data);
            vs-close-pair(pair,vsp-go(pair,rows,0,0,0));
        }
    }
    0;
}
