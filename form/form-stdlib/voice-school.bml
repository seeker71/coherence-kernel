//////////////////////////////////////////////////////////////////////
// voice-school.bml — the body teaches itself, locally, without limit:
// each cycle emits its rows, trains the adapter, harvests it into ice,
// grades it on held-out corpus questions beside the base model (first
// word equals the row's word), publishes the gift to the shared glass,
// writes one ledger line, and commits locally. Rented tokens: none.
import form/form-stdlib/lora-voice.bml;
import form/form-stdlib/form-glass-telemetry-membrane.bml;
import form/form-stdlib/hearth.bml;
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormVoiceSchool {
        field VSLedger = "receipts/voice-school-ledger.md";
        field VSGrade = 10;
        def vs-cat(parts) = lv-cat(parts);
        def vs-text(t) = if nothing?(t) then "" else t;
        def vs-between(s, open, close, from) {
            let a = str_find(s, open, from);
            let b = if (a < 0) then (0 - 1) else str_find(s, close, (a + len(open)));
            if ((a < 0) || (b < 0)) then "" else substring(s, (a + len(open)), b);
        }
        def vs-unq(s, i, acc) = if (i >= len(s)) then acc else if (((Comparable) str_byte_at(s, i) == 92) && ((i + 1) < len(s))) then vs-unq(s, (i + 2), ((String) acc + (if ((Comparable) str_byte_at(s, (i + 1)) == 110) then " " else byte_to_str(str_byte_at(s, (i + 1)))))) else vs-unq(s, (i + 1), ((String) acc + byte_to_str(str_byte_at(s, i))));
        def vs-question(line) = vs-unq(vs-between(line, lv-cat([lv-q(), "content", lv-q(), ":", lv-q()]), lv-cat([lv-q(), "},{"]), 0), 0, "");
        def vs-answer(line) {
            let first = str_find(line, lv-cat([lv-q(), "content", lv-q(), ":", lv-q()]), 0);
            vs-unq(vs-between(line, lv-cat([lv-q(), "content", lv-q(), ":", lv-q()]), lv-cat([lv-q(), "}]}"]), (first + 1)), 0, "");
        }
        def vs-word-end(s, i) = if (i >= len(s)) then i else if (((Comparable) str_byte_at(s, i) == 46) || (((Comparable) str_byte_at(s, i) == 32) || (((Comparable) str_byte_at(s, i) == 44) || ((Comparable) str_byte_at(s, i) == 10)))) then i else vs-word-end(s, (i + 1));
        def vs-first-word(s) {
            let t = trim(s);
            let t2 = if ((len(t) > 0) && ((Comparable) str_byte_at(t, 0) == 34)) then substring(t, 1, len(t)) else t;
            substring(t2, 0, vs-word-end(t2, 0));
        }
        def vs-lower(s, i, acc) = if (i >= len(s)) then acc else vs-lower(s, (i + 1), ((String) acc + byte_to_str(if ((str_byte_at(s, i) >= 65) && (str_byte_at(s, i) <= 90)) then (str_byte_at(s, i) + 32) else str_byte_at(s, i))));
        def vs-corpus-line?(line) = if (str_find(line, "The body asks the smallest question", 0) >= 0) then 1 else 0;
        def vs-corpus-lines(lines, n) = if (((Comparable) len(lines) == 0) || (n <= 0)) then [] else if ((Comparable) vs-corpus-line?(lines[0]) == 1) then cons(lines[0], vs-corpus-lines(lines[1:], (n - 1))) else vs-corpus-lines(lines[1:], n);
        // The same 3B base on both sides; one shared tokenizer, two model owners.
        def vs-open-pair(data) {
            let base = nlg-open(lv-model(),"");
            [base,[nll-open(lv-model(),lv-adapter-path(data)),base[1]]];
        }
        def vs-close-pair(pair,result) {
            let a = nlg-close(pair[0]); let b = nlg-close(pair[1]);
            result;
        }
        def vs-ask-on(pair,q,withAdapter) = vs-complete(nlg-ask(pair[withAdapter],q,0,"","",lv-events()));
        def vs-complete(result) = if ((len(result[1]) > 0) || ((Comparable) len(result[0]) == 0)) then form_error(("school grade awaits a complete answer: " + result[1])) else result[0];
        def vs-answer-word(pair,q,withAdapter) = vs-lower(vs-first-word(vs-ask-on(pair,q,withAdapter)),0,"");
        // grade: (n base-hits adapter-hits)
        def vs-grade-go(data, lines, n, bh, ah) {
            if ((Comparable) len(lines) == 0) then [n, bh, ah]
            else vs-grade-one(data, lines[1:], n, bh, ah, vs-question(lines[0]), vs-lower(vs-first-word(vs-answer(lines[0])), 0, ""));
        }
        def vs-grade-one(data, rest, n, bh, ah, q, want) {
            let b = if ((String) vs-answer-word(data, q, 0) == want) then 1 else 0;
            let a = if ((String) vs-answer-word(data, q, 1) == want) then 1 else 0;
            vs-grade-go(data, rest, (n + 1), (bh + b), (ah + a));
        }
        def vs-grade(data,n) {
            let rows = vs-corpus-lines(split-on(vs-text(read_file((data + "/valid.jsonl"))),byte_to_str(10)),n);
            if (!((Comparable) len(rows) == n)) then form_error("school held-out corpus is incomplete") else vs-grade-ready(data,rows);
        }
        def vs-grade-ready(data,rows) {
            let pair = vs-open-pair(data);
            vs-close-pair(pair,vs-grade-go(pair,rows,0,0,0));
        }
        def vs-harvest(data,home) {
            if (!((String) nlw-status(data) == "completed")) then form_error("school harvest awaits successful training") else vs-harvest-ready(nag-complete(nag-resolve((data + "/adapter"))),home);
        }
        def vs-harvest-ready(source,home) {
            let generation = (home + ("/generations/" + fs-path-basename(source)));
            let made = fs-mkdir(generation);
            let args = append(["/bin/cp"],append(vs-generation-files(source),[generation]));
            let pid = host_spawn_at(args,["/dev/null","/dev/null","/dev/null"]);
            if (pid <= 0) then form_error("school generation copy could not launch") else if (!((Comparable) host_wait(pid) == 0)) then form_error("school generation copy failed") else vs-harvest-copied(source,generation,home);
        }
        def vs-generation-files(dir) = [(dir + "/adapters.safetensors"),(dir + "/optimizer.safetensors"),(dir + "/adapter_config.json"),(dir + "/complete.json")];
        def vs-copy-sizes(a,b) = if nil?(a) then 1 else (((Comparable) file_size(a[0]) == file_size(b[0])) && vs-copy-sizes(a[1:],b[1:]));
        def vs-harvest-copied(source,generation,home) {
            if (!vs-copy-sizes(vs-generation-files(source),vs-generation-files(generation))) then form_error("school generation copy extent mismatch") else nag-publish(home,generation);
        }
        def vs-tags() = ["all", "we", "mesh", "voice"];
        def vs-sample(id, purpose, n, lifecycle, epoch) = fgtm-sample(id, fgtm-absent(), "voice-school", "form", "voice.school", "voice", purpose, fgtm-absent(), fgtm-present(n), lifecycle, fgtm-absent(), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "never", "physical-live", "voice-school", vs-tags());
        def vs-publish(troot, cycle, rows, grade, epoch) = fgtm-publish-snapshot(troot, "voice.school", epoch, [
            vs-sample("voice.school.cycle", "cycles-harvested", cycle, "active", epoch),
            vs-sample("voice.school.rows", "teacher-rows", rows, "stored", epoch),
            vs-sample("voice.school.heldout.base", vs-cat(["hits-of-", grade[0].str()]), grade[1], "ready", epoch),
            vs-sample("voice.school.heldout.adapter", vs-cat(["hits-of-", grade[0].str()]), grade[2], if (grade[2] > grade[1]) then "active" else "ready", epoch)]);
        def vs-ledger-line(date, cycle, data, rows, grade, sha8) = vs-cat(["| ", date, " | ", cycle.str(), " | ", data, " | ", rows.str(), " | base ", grade[1].str(), "/", grade[0].str(), " | adapter ", grade[2].str(), "/", grade[0].str(), " | ", sha8, " |", byte_to_str(10)]);
        def vs-ledger-append(line) = sbt-append(VSLedger(), line);
        def vs-cycles(ledger) = vs-count-rows(split-on(ledger, byte_to_str(10)), 0);
        def vs-count-rows(lines, n) = if ((Comparable) len(lines) == 0) then n else vs-count-rows(lines[1:], (n + (if ((Comparable) str_find(lines[0], "| 20", 0) == 0) then 1 else 0)));
        def vs-sha8(path) = substring(vs-text(host-exec(vs-cat(["shasum -a 256 ", path, " 2>/dev/null"]), "")), 0, 8);
        def vs-rows(data) = (len(split-on(vs-text(read_file((data + "/train.jsonl"))), byte_to_str(10))) - 1);
        def vs-commit(cycle, grade) = vs-text(host-exec(vs-cat(["git add form/form-stdlib/adapters ", VSLedger(), " && git commit -q -m 'voice school cycle ", cycle.str(), ": held-out base ", grade[1].str(), " adapter ", grade[2].str(), " of ", grade[0].str(), "' && echo committed"]), ""));
    }
    0;
}
section [form.bml] {
    class FormVoiceSchoolPerception {
        // A school of perception rows cannot be graded on corpus questions —
        // its held-out set has none. The question it CAN be graded on is the
        // one only a body that sat in the room can answer: given a frame's
        // source stamp alone, name the shape that moment took. The shape is
        // never in the question, so a model that never heard this room has
        // nothing to reach for, and a hit is the room itself coming back.
        def vsp-shape-of(line) = vs-between(line, "Its shape is ", ", node", 0);
        def vsp-lines(lines, n) = if (((Comparable) len(lines) == 0) || (n <= 0)) then [] else vsp-lines-at(lines, n, vsp-shape-of(lines[0]));
        def vsp-lines-at(lines, n, shape) = if ((Comparable) len(shape) == 0) then vsp-lines(lines[1:], n) else cons(lines[0], vsp-lines(lines[1:], (n - 1)));
        def vsp-hit?(ans, shape) = if ((Comparable) len(shape) == 0) then 0 else if (str_find(vs-text(ans), shape, 0) < 0) then 0 else 1;
        // (n base-hits adapter-hits)
        def vsp-go(data, lines, n, bh, ah) = if ((Comparable) len(lines) == 0) then [n, bh, ah] else vsp-one(data, lines[1:], n, bh, ah, vs-question(lines[0]), vsp-shape-of(lines[0]));
        // the shape is the LAST thing a perception answer says, so the answer
        // must be allowed to reach it before it is read
        // the same reason as `vs-answer-word`: both sides of a shape grade
        // ride the one model the adapter was fitted to
        def vsp-one(pair,rest,n,bh,ah,q,shape) = vsp-go(pair,rest,(n + 1),(bh + vsp-hit?(vs-ask-on(pair,q,0),shape)),(ah + vsp-hit?(vs-ask-on(pair,q,1),shape)));
        def vsp-grade(data,n) {
            let rows = vsp-lines(split-on(vs-text(read_file((data + "/valid.jsonl"))),byte_to_str(10)),n);
            if (!((Comparable) len(rows) == n)) then form_error("school held-out perception rows are incomplete") else vsp-grade-ready(data,rows);
        }
        def vsp-grade-ready(data,rows) {
            let pair = vs-open-pair(data);
            vs-close-pair(pair,vsp-go(pair,rows,0,0,0));
        }
    }
    0;
}
