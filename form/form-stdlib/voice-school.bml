//////////////////////////////////////////////////////////////////////
// voice-school.bml — the body teaches itself, locally, without limit:
// each cycle emits its rows, trains the adapter, harvests it into ice,
// grades it on held-out corpus questions beside the base model (first
// word equals the row's word), publishes the gift to the shared glass,
// writes one ledger line, and commits locally. Rented tokens: none.
// preludes: form/form-stdlib/lora-voice.bml form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/hearth.bml
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormVoiceSchool {
        field VSLedger = "receipts/voice-school-ledger.md";
        field VSGrade = 10;
        def vs-cat(parts) = lv-cat(parts);
        def vs-text(t) = if nothing?(t) then "" else t;
        def vs-between(s, open, close, from) {
            let a = str_find(s, open, from);
            let b = if lt(a, 0) then sub(0, 1) else str_find(s, close, add(a, str_len(open)));
            if or(lt(a, 0), lt(b, 0)) then "" else substring(s, add(a, str_len(open)), b);
        }
        def vs-unq(s, i, acc) = if ge(i, str_len(s)) then acc else if and(eq(str_byte_at(s, i), 92), lt(add(i, 1), str_len(s))) then vs-unq(s, add(i, 2), str_concat(acc, if eq(str_byte_at(s, add(i, 1)), 110) then " " else byte_to_str(str_byte_at(s, add(i, 1))))) else vs-unq(s, add(i, 1), str_concat(acc, byte_to_str(str_byte_at(s, i))));
        def vs-question(line) = vs-unq(vs-between(line, lv-cat(list(lv-q(), "content", lv-q(), ":", lv-q())), lv-cat(list(lv-q(), "},{")), 0), 0, "");
        def vs-answer(line) {
            let first = str_find(line, lv-cat(list(lv-q(), "content", lv-q(), ":", lv-q())), 0);
            vs-unq(vs-between(line, lv-cat(list(lv-q(), "content", lv-q(), ":", lv-q())), lv-cat(list(lv-q(), "}]}")), add(first, 1)), 0, "");
        }
        def vs-word-end(s, i) = if ge(i, str_len(s)) then i else if or(eq(str_byte_at(s, i), 46), or(eq(str_byte_at(s, i), 32), or(eq(str_byte_at(s, i), 44), eq(str_byte_at(s, i), 10)))) then i else vs-word-end(s, add(i, 1));
        def vs-first-word(s) {
            let t = trim(s);
            let t2 = if and(gt(str_len(t), 0), eq(str_byte_at(t, 0), 34)) then substring(t, 1, str_len(t)) else t;
            substring(t2, 0, vs-word-end(t2, 0));
        }
        def vs-lower(s, i, acc) = if ge(i, str_len(s)) then acc else vs-lower(s, add(i, 1), str_concat(acc, byte_to_str(if and(ge(str_byte_at(s, i), 65), le(str_byte_at(s, i), 90)) then add(str_byte_at(s, i), 32) else str_byte_at(s, i))));
        def vs-corpus-line?(line) = if ge(str_find(line, "The body asks the smallest question", 0), 0) then 1 else 0;
        def vs-corpus-lines(lines, n) = if or(eq(len(lines), 0), le(n, 0)) then list() else if eq(vs-corpus-line?(head(lines)), 1) then cons(head(lines), vs-corpus-lines(tail(lines), sub(n, 1))) else vs-corpus-lines(tail(lines), n);
        def vs-answer-word(data, q, withAdapter) = vs-lower(vs-first-word(vs-text(lv-ask(data, q, withAdapter))), 0, "");
        // grade: (n base-hits adapter-hits)
        def vs-grade-go(data, lines, n, bh, ah) {
            if eq(len(lines), 0) then list(n, bh, ah)
            else vs-grade-one(data, tail(lines), n, bh, ah, vs-question(head(lines)), vs-lower(vs-first-word(vs-answer(head(lines))), 0, ""));
        }
        def vs-grade-one(data, rest, n, bh, ah, q, want) {
            let b = if str_eq(vs-answer-word(data, q, 0), want) then 1 else 0;
            let a = if str_eq(vs-answer-word(data, q, 1), want) then 1 else 0;
            vs-grade-go(data, rest, add(n, 1), add(bh, b), add(ah, a));
        }
        def vs-grade(data, n) = vs-grade-go(data, vs-corpus-lines(split-on(vs-text(read_file(str_concat(data, "/valid.jsonl"))), byte_to_str(10)), n), 0, 0, 0);
        def vs-tags() = list("all", "we", "mesh", "voice");
        def vs-sample(id, purpose, n, lifecycle, epoch) = fgtm-sample(id, fgtm-absent(), "voice-school", "form", "voice.school", "voice", purpose, fgtm-absent(), fgtm-present(n), lifecycle, fgtm-absent(), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "never", "physical-live", "voice-school", vs-tags());
        def vs-publish(troot, cycle, rows, grade, epoch) = fgtm-publish-snapshot(troot, "voice.school", epoch, list(
            vs-sample("voice.school.cycle", "cycles-harvested", cycle, "active", epoch),
            vs-sample("voice.school.rows", "teacher-rows", rows, "stored", epoch),
            vs-sample("voice.school.heldout.base", vs-cat(list("hits-of-", int_to_str(head(grade)))), nth(grade, 1), "ready", epoch),
            vs-sample("voice.school.heldout.adapter", vs-cat(list("hits-of-", int_to_str(head(grade)))), nth(grade, 2), if gt(nth(grade, 2), nth(grade, 1)) then "active" else "ready", epoch)));
        def vs-ledger-line(date, cycle, data, rows, grade, sha8) = vs-cat(list("| ", date, " | ", int_to_str(cycle), " | ", data, " | ", int_to_str(rows), " | base ", int_to_str(nth(grade, 1)), "/", int_to_str(head(grade)), " | adapter ", int_to_str(nth(grade, 2)), "/", int_to_str(head(grade)), " | ", sha8, " |", byte_to_str(10)));
        def vs-ledger-append(line) = sbt-append(VSLedger(), line);
        def vs-cycles(ledger) = if eq(str_len(ledger), 0) then 0 else sub(len(split-on(ledger, byte_to_str(10))), 4);
        def vs-sha8(path) = substring(vs-text(host-exec(vs-cat(list("shasum -a 256 ", path, " 2>/dev/null")), "")), 0, 8);
        def vs-rows(data) = sub(len(split-on(vs-text(read_file(str_concat(data, "/train.jsonl"))), byte_to_str(10))), 1);
        def vs-commit(cycle, grade) = vs-text(host-exec(vs-cat(list("git add form/form-stdlib/adapters ", VSLedger(), " && git commit -q -m 'voice school cycle ", int_to_str(cycle), ": held-out base ", int_to_str(nth(grade, 1)), " adapter ", int_to_str(nth(grade, 2)), " of ", int_to_str(head(grade)), "' && echo committed")), ""));
    }
    0;
}
