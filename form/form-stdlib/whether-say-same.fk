; whether-say-same.fk — the core-word door in front of the shared-key
; continuity organ.
;
; The public question is made only from the closed core lexicon:
;
;   whether this say is same before and after
;
; `whether` is the one terminal query lane, so its exact acknowledgement is:
;
;   nothing  no say, no usable offered relation, or no ground for comparison
;   0        the observed before/after relation is not the same
;   1        the observed before/after relation is the same
;
; HMAC, bindings, seals, sequences, and predecessor links remain implementation
; evidence inside situated-witness-continuity.fk. They do not become the public
; language and they do not establish who spoke. A shared secret can be used by
; every holder to mint the same observation, so the next core question:
;
;   who this say is from
;
; remains a NODE carrying `who`. It is not silently promoted to identity.
;
; DERIVATION
;   axiom-1 — absence of ground is nothing; observed difference is 0; observed
;             sameness is 1.
;   axiom-2 — `same` and `who` are cells, carried by their core NodeIDs.
;   axiom-3 — the comparison concerns present composition; history is evidence
;             of before/after, never identity by itself.
;   axiom-4 — only the offered shared-key relation is observed here. A source
;             identity not offered by that relation is not invented.
;   axiom-5 — every answer uses the existing exact OAC nothing/0/1/node arms.
;
; Proof: form-stdlib/tests/whether-say-same-band.fk -> four-way.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/sha256.fk form-stdlib/hmac-sha256.fk form-stdlib/offer-ack-core.fk form-stdlib/core-lexicon.fk form-stdlib/core-word-inquiry.fk form-stdlib/situated-lens-conclusion.fk form-stdlib/situated-evidence-authority.fk form-stdlib/situated-witness-continuity.fk
; witnessed: 2026-07-26 -> 1023 four-way

(do
    (defn wss-word-node (word)
        (cl-nid (cl-at (cl-index-of word))))
    (defn wss-same-node ()
        (wss-word-node "same"))
    (defn wss-who-node ()
        (wss-word-node "who"))

    ; Translate the private organ's diagnostic statuses into the exact public
    ; ack grammar. Malformed or ungrounded input is not false: it is nothing.
    ; Only an observed mismatch or before/after break warrants 0.
    (defn wss-status-ack (status)
        (if (eq status 0)
            (oac-one (wss-same-node))
            (if (or (eq status 3) (eq status 4))
                (oac-zero)
                (oac-nothing))))

    (defn wss-whether (entries bindings)
        (if (eq (len entries) 0)
            (oac-nothing)
            (wss-status-ack
                (swc-v-status
                    (swc-verify entries bindings)))))

    ; A successful sameness observation opens the identity enquiry; it does
    ; not answer it. Nothing and 0 pass through without changing their meaning.
    (defn wss-who (entries bindings)
        (do
            (let ack (wss-whether entries bindings))
            (if (eq (oac-one? ack) 1)
                (oac-node (wss-who-node))
                ack)))

    0)
