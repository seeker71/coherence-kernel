// form-cli-peer-direct-source-action.fk -- fixed caller-owned direct source
// action for a resident peer. Policy may select this action but cannot supply
// its root, artifact, path, request identity, or world admission.
//
// The adapter does one strict source lookup through the context already born by
// its caller, then asks the retained current-answer program image to validate
// that result. It never opens Qwen, advances KV, invokes Metal, or reacquires
// ambient filesystem authority.
//
// `nothing`, present 0, present 1, choice, timeout and release remain in the
// raw result/PIF receipt. A world message is born only from a returned,
// value-1 current-answer receipt and remains beside the peer ABI's integer
// value rather than being squeezed through it.
//
// preludes: form-stdlib/form-cli-peer-stream-ingress.fk form-stdlib/form-cli-current-answer-in-process.fk form-stdlib/form-agent-source-world-model.fk
section [form.bml] {
    // result = session, raw strict result, retained PIF receipt, optional world
    // message, rendered response, elapsed, signal, reason, knowledge, mutation.
    def fcpdsa-version() = "form-cli-peer-source-action-v1";
    def fcpdsa-result(session, result, answer-receipt, world-message, response, elapsed-ms, signal, reason, knowledge-contribution, mutation-contribution) = list(fcpdsa-version(), session, result, answer-receipt, world-message, response, elapsed-ms, signal, reason, knowledge-contribution, mutation-contribution);
    def fcpdsa-session(r) = nth(r, 1);
    def fcpdsa-result-value(r) = nth(r, 2);
    def fcpdsa-answer-receipt(r) = nth(r, 3);
    def fcpdsa-world-message(r) = nth(r, 4);
    def fcpdsa-response(r) = nth(r, 5);
    def fcpdsa-elapsed-ms(r) = nth(r, 6);
    def fcpdsa-signal(r) = nth(r, 7);
    def fcpdsa-reason(r) = nth(r, 8);
    def fcpdsa-knowledge-contribution(r) = nth(r, 9);
    def fcpdsa-mutation-contribution(r) = nth(r, 10);
    def fcpdsa-result?(r) = nothing?(r) ? 0 : !((Comparable) len(r) == 11) ? 0 : (String) nth(r, 0) == fcpdsa-version();
    def fcpdsa-kind-source?(kind) = (String) kind == "source-concept" ? 1 : (String) kind == "source-nodeid" ? 1 : 0;
    def fcpdsa-surface-shape?(kind, text) = !((Comparable) fcpdsa-kind-source?(kind) == 1) ? 0 : str_len(text) <= 0 ? 0 : (String) kind == "source-concept" ? (Comparable) str_byte_at(text, 0) == 64 ? 0 : 1 : {
        let scan = fknq-bmf-consume-default(fcnkd-surface(text));
        (String) fknq-scan-status(scan) == "ready" ? 1 : 0;
    };
    def fcpdsa-source-context-present?(source-ctx) = nothing?(source-ctx) ? 0 : 1;
    def fcpdsa-terminal-returned?(receipt) = !((Comparable) fcaip-receipt?(receipt) == 1) ? 0 : !((String) fcaip-status(receipt) == "returned") ? 0 : {
        let value = fcaip-resident-value(receipt);
        nothing?(value) ? 0 : (Comparable) value == 1 ? 1 : 0;
    };
    def fcpdsa-refused(session, reason) = fcpdsa-result(session, nothing(), nothing(), nothing(), "", 0, "choice", reason, 0, 0);
    def fcpdsa-result-signal(result, receipt, world-message) = !nothing?(world-message) ? "value" : (String) fknq-status(result) == "nothing" ? "nothing" : (String) fcaip-status(receipt) == "timeout" ? "timeout" : "choice";
    def fcpdsa-result-reason(result, receipt, world-message) = !nothing?(world-message) ? "source-world-admitted" : (String) fknq-status(result) == "nothing" ? fknq-reason(result) : fcaip-reason(receipt);
    // The outcome half is intentionally effect-free.  It makes the retained
    // PIF/world-admission contract four-way witnessable from a typed strict
    // result, while fcpdsa-run below remains the one caller-authorized
    // filesystem crossing.
    def fcpdsa-from-result(session, result, call-id, provenance, elapsed-ms) = {
        let receipt = fcaip-from-result(result, fcaip-step-budget());
        let terminal = fcpdsa-terminal-returned?(receipt);
        let world-message = (Comparable) terminal == 1 ? faswm-agent-message(call-id, result, elapsed-ms, 0, provenance) : nothing();
        fcpdsa-result(session, result, receipt, world-message, fcaip-render(receipt), elapsed-ms, fcpdsa-result-signal(result, receipt, world-message), fcpdsa-result-reason(result, receipt, world-message), nothing?(world-message) ? 0 : 1, 0);
    };
    def fcpdsa-tool-status(direct) = {
        let result = fcpdsa-result-value(direct);
        nothing?(result) ? "nothing" : fknq-status(result);
    };
    def fcpdsa-lookup-count(direct) = {
        let result = fcpdsa-result-value(direct);
        nothing?(result) ? 0 : fknq-lookup-count(result);
    };
    def fcpdsa-lifecycle(direct) = {
        let result = fcpdsa-result-value(direct);
        nothing?(result) ? "choice,release" : fknq-trace-actions(fknq-trace(result));
    };
    def fcpdsa-value-present?(direct) = {
        let receipt = fcpdsa-answer-receipt(direct);
        nothing?(receipt) ? 0 : nothing?(fcaip-resident-value(receipt)) ? 0 : 1;
    };
    def fcpdsa-value(direct) = {
        let receipt = fcpdsa-answer-receipt(direct);
        nothing?(receipt) ? nothing() : fcaip-resident-value(receipt);
    };
    // This bridge deliberately maps the typed adapter into the peer ABI only;
    // the session remains the exact input session and source-world structure
    // remains in cursor, beside (not inside) the integer value seat.
    def fcpdsa-peer(direct) = fcpa-result-full(fcpdsa-session(direct), direct, fcpdsa-response(direct), fcpdsa-elapsed-ms(direct), 0, "source-knowledge", 0, fcpdsa-tool-status(direct), "form-current-source", fcpdsa-value-present?(direct), fcpdsa-value(direct), 0, 0, fcpdsa-lifecycle(direct), fcpdsa-lookup-count(direct));
    // Source action is selected before fcpa-observe-task. This is what keeps a
    // source hit/refusal outside Qwen/KV, including every malformed or absent
    // context outcome.
    def fcpdsa-run-peer(stream, session, task-node, source-ctx, call-id, provenance) = {
        let task = fcpsi-find-task(fcpsi-tasks(stream), task-node);
        nothing?(task) ? list(stream, nothing(), fcpsi-result(stream, "nothing", 0, nothing(), "task-node-absent", nothing())) : {
            let direct = fcpdsa-run(session, fcpsi-task-kind(task), fcpsi-task-text(task), source-ctx, call-id, provenance);
            let peer = fcpdsa-peer(direct);
            let candidate = fcpsi-peer-result(stream, task-node, fcpa-response(peer), 0, nothing());
            list(fcpsi-result-state(candidate), peer, candidate);
        };
    };
    // `source-ctx` is caller-born: root, artifact, local-ready, frame-budget.
    // This cell deliberately has no `fhcs-default-root` or default-artifact
    // call. The JIT policy reaches this fixed capability only by its action
    // name; task bytes select neither the filesystem nor the world admission.
    def fcpdsa-run(session, task-kind, task-text, source-ctx, call-id, provenance) = !((Comparable) fcpdsa-kind-source?(task-kind) == 1) ? fcpdsa-refused(session, "source-direct-requires-source-task") : !((Comparable) fcpdsa-source-context-present?(source-ctx) == 1) ? fcpdsa-refused(session, "source-context-absent") : !((Comparable) fcpdsa-surface-shape?(task-kind, task-text) == 1) ? fcpdsa-refused(session, "source-task-shape-refused") : {
        let started = now_unix_ms();
        let surface = fcnkd-surface(task-text);
        let result = fknqr-public-strict-executor(source-ctx, surface);
        fcpdsa-from-result(session, result, call-id, provenance, now_unix_ms() - started);
    };
    0;
}
