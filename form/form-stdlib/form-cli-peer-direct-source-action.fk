; form-cli-peer-direct-source-action.fk -- fixed caller-owned direct source
; action for a resident peer. Policy may select this action but cannot supply
; its root, artifact, path, request identity, or world admission.
;
; The adapter does one strict source lookup through the context already born by
; its caller, then asks the retained current-answer program image to validate
; that result. It never opens Qwen, advances KV, invokes Metal, or reacquires
; ambient filesystem authority.
;
; `nothing`, present 0, present 1, choice, timeout and release remain in the
; raw result/PIF receipt. A world message is born only from a returned,
; value-1 current-answer receipt and remains beside the peer ABI's integer
; value rather than being squeezed through it.
;
; preludes: form-stdlib/form-cli-peer-stream-ingress.fk form-stdlib/form-cli-current-answer-in-process.fk form-stdlib/form-agent-source-world-model.fk
; Proven by: form-stdlib/tests/form-cli-peer-direct-source-action-band.fk

(do
    ; result = session, raw strict result, retained PIF receipt, optional world
    ; message, rendered response, elapsed, signal, reason, knowledge, mutation.
    (defn fcpdsa-version () "form-cli-peer-source-action-v1")
    (defn fcpdsa-result
        (session result answer-receipt world-message response elapsed-ms
         signal reason knowledge-contribution mutation-contribution)
        (list (fcpdsa-version) session result answer-receipt world-message
              response elapsed-ms signal reason knowledge-contribution
              mutation-contribution))
    (defn fcpdsa-session (r) (nth r 1))
    (defn fcpdsa-result-value (r) (nth r 2))
    (defn fcpdsa-answer-receipt (r) (nth r 3))
    (defn fcpdsa-world-message (r) (nth r 4))
    (defn fcpdsa-response (r) (nth r 5))
    (defn fcpdsa-elapsed-ms (r) (nth r 6))
    (defn fcpdsa-signal (r) (nth r 7))
    (defn fcpdsa-reason (r) (nth r 8))
    (defn fcpdsa-knowledge-contribution (r) (nth r 9))
    (defn fcpdsa-mutation-contribution (r) (nth r 10))
    (defn fcpdsa-result? (r)
        (if (nothing? r) 0
            (if (not (eq (len r) 11)) 0
                (str_eq (nth r 0) (fcpdsa-version)))))

    (defn fcpdsa-kind-source? (kind)
        (if (str_eq kind "source-concept") 1
            (if (str_eq kind "source-nodeid") 1 0)))
    (defn fcpdsa-surface-shape? (kind text)
        (if (not (eq (fcpdsa-kind-source? kind) 1)) 0
            (if (le (str_len text) 0) 0
                (if (str_eq kind "source-concept")
                    (if (eq (str_byte_at text 0) 64) 0 1)
                    (do
                        (let scan (fknq-bmf-consume-default
                            (fcnkd-surface text)))
                        (if (str_eq (fknq-scan-status scan) "ready") 1 0))))))
    (defn fcpdsa-source-context-present? (source-ctx)
        (if (nothing? source-ctx) 0 1))
    (defn fcpdsa-terminal-returned? (receipt)
        (if (not (eq (fcaip-receipt? receipt) 1)) 0
            (if (not (str_eq (fcaip-status receipt) "returned")) 0
                (do
                    (let value (fcaip-resident-value receipt))
                    (if (nothing? value) 0
                        (if (eq value 1) 1 0))))))
    (defn fcpdsa-refused (session reason)
        (fcpdsa-result session (nothing) (nothing) (nothing) "" 0
            "choice" reason 0 0))
    (defn fcpdsa-result-signal (result receipt world-message)
        (if (not (nothing? world-message)) "value"
            (if (str_eq (fknq-status result) "nothing") "nothing"
                (if (str_eq (fcaip-status receipt) "timeout") "timeout"
                    "choice"))))
    (defn fcpdsa-result-reason (result receipt world-message)
        (if (not (nothing? world-message)) "source-world-admitted"
            (if (str_eq (fknq-status result) "nothing") (fknq-reason result)
                (fcaip-reason receipt))))
    ; The outcome half is intentionally effect-free.  It makes the retained
    ; PIF/world-admission contract four-way witnessable from a typed strict
    ; result, while fcpdsa-run below remains the one caller-authorized
    ; filesystem crossing.
    (defn fcpdsa-from-result (session result call-id provenance elapsed-ms)
        (do
            (let receipt (fcaip-from-result result (fcaip-step-budget)))
            (let terminal (fcpdsa-terminal-returned? receipt))
            (let world-message (if (eq terminal 1)
                (faswm-agent-message call-id result elapsed-ms 0 provenance)
                (nothing)))
            (fcpdsa-result session result receipt world-message
                (fcaip-render receipt) elapsed-ms
                (fcpdsa-result-signal result receipt world-message)
                (fcpdsa-result-reason result receipt world-message)
                (if (nothing? world-message) 0 1) 0)))
    (defn fcpdsa-tool-status (direct)
        (do
            (let result (fcpdsa-result-value direct))
            (if (nothing? result) "nothing" (fknq-status result))))
    (defn fcpdsa-lookup-count (direct)
        (do
            (let result (fcpdsa-result-value direct))
            (if (nothing? result) 0 (fknq-lookup-count result))))
    (defn fcpdsa-lifecycle (direct)
        (do
            (let result (fcpdsa-result-value direct))
            (if (nothing? result) "choice,release"
                (fknq-trace-actions (fknq-trace result)))))
    (defn fcpdsa-value-present? (direct)
        (do
            (let receipt (fcpdsa-answer-receipt direct))
            (if (nothing? receipt) 0
                (if (nothing? (fcaip-resident-value receipt)) 0 1))))
    (defn fcpdsa-value (direct)
        (do
            (let receipt (fcpdsa-answer-receipt direct))
            (if (nothing? receipt) (nothing)
                (fcaip-resident-value receipt))))
    ; This bridge deliberately maps the typed adapter into the peer ABI only;
    ; the session remains the exact input session and source-world structure
    ; remains in cursor, beside (not inside) the integer value seat.
    (defn fcpdsa-peer (direct)
        (fcpa-result-full (fcpdsa-session direct) direct
            (fcpdsa-response direct) (fcpdsa-elapsed-ms direct) 0
            "source-knowledge" 0 (fcpdsa-tool-status direct)
            "form-current-source" (fcpdsa-value-present? direct)
            (fcpdsa-value direct) 0 0 (fcpdsa-lifecycle direct)
            (fcpdsa-lookup-count direct)))
    ; Source action is selected before fcpa-observe-task. This is what keeps a
    ; source hit/refusal outside Qwen/KV, including every malformed or absent
    ; context outcome.
    (defn fcpdsa-run-peer (stream session task-node source-ctx call-id provenance)
        (do
            (let task (fcpsi-find-task (fcpsi-tasks stream) task-node))
            (if (nothing? task)
                (list stream (nothing)
                    (fcpsi-result stream "nothing" 0 (nothing)
                        "task-node-absent" (nothing)))
                (do
                    (let direct (fcpdsa-run session (fcpsi-task-kind task)
                        (fcpsi-task-text task) source-ctx call-id provenance))
                    (let peer (fcpdsa-peer direct))
                    (let candidate (fcpsi-peer-result stream task-node
                        (fcpa-response peer) 0 (nothing)))
                    (list (fcpsi-result-state candidate) peer candidate)))))

    ; `source-ctx` is caller-born: root, artifact, local-ready, frame-budget.
    ; This cell deliberately has no `fhcs-default-root` or default-artifact
    ; call. The JIT policy reaches this fixed capability only by its action
    ; name; task bytes select neither the filesystem nor the world admission.
    (defn fcpdsa-run
        (session task-kind task-text source-ctx call-id provenance)
        (if (not (eq (fcpdsa-kind-source? task-kind) 1))
            (fcpdsa-refused session "source-direct-requires-source-task")
            (if (not (eq (fcpdsa-source-context-present? source-ctx) 1))
                (fcpdsa-refused session "source-context-absent")
                (if (not (eq (fcpdsa-surface-shape? task-kind task-text) 1))
                    (fcpdsa-refused session "source-task-shape-refused")
                    (do
                        (let started (now_unix_ms))
                        (let surface (fcnkd-surface task-text))
                        (let result (fknqr-public-strict-executor
                            source-ctx surface))
                        (fcpdsa-from-result session result call-id provenance
                            (sub (now_unix_ms) started)))))))
    0)
