; form-cli-current-source-effect-offer.fk -- strict-route-gated current source
; effect boundary.
;
; The offer body is exactly:
;
;   [prior-route-receipt, request-node, source-node, entry-node, window-fuel]
;
; The prior ACK alone is intentionally insufficient authority.  Its retained
; protocol registry and OFFER are required so fpcp-ack-observed? can recompute
; the exact strict-route result and reject forged or swapped evidence.  An
; explicit, content-addressed capability separately retains the receiver-owned
; root, source family, maximum observation window, and exact request/source/
; entry binding.  It is not a family-wide filesystem grant.
;
; One admitted offer invokes fknq-current-source-result-at exactly once.  That
; is one logical current-source observation, NOT one physical filesystem read:
; the existing organ reads a snapshot and then rehashes for freshness.  Window
; fuel currently gates logical observation admission; fknq has no byte- or
; syscall-metered current-source API yet.  These are named temporary floors.
;
; The outer carrier never collapses the inner result.  A returned carrier
; retains the raw fkss hit/path-unavailable miss/stale result and the stricter
; typed fknq observation beside it.  Timeout, refusal, and failure retain
; nothing in both inner seats and effect-count zero.  A prior returned integer
; zero remains present evidence and is refused rather than confused with
; nothing.
;
; This cell grants one bounded repository-local filesystem effect.  It has no
; host process, HTTP, model, Metal, C, flattening, or global operation-table
; authority.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-cli-strict-route-image-call.fk
; preludes: form-stdlib/form-nodeid-knowledge-query.fk
; Proven by: form-stdlib/tests/form-cli-current-source-effect-offer-band.fk

(do
    (defn fcseo-schema () "form-cli-current-source-effect-receipt-v1")

    ; capability values = [root, family, max-window, request, source, entry]
    (defn fcseo-capability (root family max-window request source entry)
        (fcatw-sequence "form-cli-current-source-effect-capability-v1"
            (list (intern_trivial_string root)
                  (intern_trivial_string family)
                  (intern_trivial_int max-window)
                  request source entry)))
    (defn fcseo-capability-valid? (capability)
        (if (eq (fcatw-sequence-is? capability
                    "form-cli-current-source-effect-capability-v1") 0) 0
            (do
                (let values (fcatw-sequence-values capability))
                (if (not (eq (len values) 6)) 0
                (if (not (eq (node_type (nth values 0)) 2)) 0
                (if (not (eq (node_type (nth values 1)) 2)) 0
                (if (not (eq (node_type (nth values 2)) 1)) 0
                (if (not (gt (str_len (node_value (nth values 0))) 0)) 0
                (if (eq (psci-family-valid?
                            (node_value (nth values 1))) 0) 0
                (if (not (gt (node_value (nth values 2)) 0)) 0
                (if (eq (fknq-request-valid? (nth values 3)) 0) 0
                (if (not (str_eq (fknq-request-kind (nth values 3))
                                 "concept")) 0
                (if (eq (psci-source-node-valid? (nth values 4)) 0) 0
                (if (eq (psci-entry-valid? (nth values 5)) 0) 0
                (if (not (node_eq (psci-entry-source (nth values 5))
                                  (nth values 4))) 0
                (if (not (str_eq (psci-source-family (nth values 4))
                                 (node_value (nth values 1)))) 0
                    (if (eq (psci-entry-has-key? (nth values 5)
                            (fknq-request-coordinate (nth values 3))) 1)
                        1 0)))))))))))))))))
    (defn fcseo-granted? (grants capability)
        (if (nil? grants) 0
            (if (node_eq (head grants) capability) 1
                (fcseo-granted? (tail grants) capability))))

    ; The schema prefix makes malformed list data distinguishable from the
    ; five-seat offer body without allocating a new public NodeID category.
    (defn fcseo-offer (route-receipt request source entry window-fuel)
        (list "form-cli-current-source-effect-offer-v1" route-receipt request
              source entry (intern_trivial_int window-fuel)))
    (defn fcseo-offer-valid? (offer)
        (if (nothing? offer) 0
        (if (not (eq (len offer) 6)) 0
        (if (not (str_eq (nth offer 0)
                         "form-cli-current-source-effect-offer-v1")) 0
        (if (eq (fknq-request-valid? (nth offer 2)) 0) 0
        (if (not (str_eq (fknq-request-kind (nth offer 2)) "concept")) 0
        (if (eq (psci-source-node-valid? (nth offer 3)) 0) 0
        (if (eq (psci-entry-valid? (nth offer 4)) 0) 0
        (if (not (node_eq (psci-entry-source (nth offer 4))
                          (nth offer 3))) 0
        (if (eq (psci-entry-has-key? (nth offer 4)
                    (fknq-request-coordinate (nth offer 2))) 0) 0
        (if (nothing? (nth offer 5)) 0
        (if (not (eq (node_type (nth offer 5)) 1)) 0
            (if (ge (node_value (nth offer 5)) 0) 1 0)))))))))))))

    ; A valid route proof is not yet an admitted route: returned integer 0,
    ; refusal, nothing, timeout, and failure remain valid observed ACK states.
    ; Identity is narrowed to the landed strict-route callee image and relation.
    (defn fcseo-route-proof-valid? (receipt request)
        (if (nothing? receipt) 0
        (if (not (eq (len receipt) 4)) 0
            (do
                (let protocol (nth receipt 0))
                (let offer (nth receipt 1))
                (let ack (nth receipt 2))
                (if (eq (fpcp-registry-valid? protocol) 0) 0
                (if (eq (fpcp-offer-valid? offer) 0) 0
                (if (eq (fpcp-ack-valid? ack) 0) 0
                (if (not (eq (nth receipt 3) 1)) 0
                (if (not (eq (fpcp-ack-observed? protocol offer ack) 1)) 0
                    (do
                        (let call (fpcp-child offer 0))
                        (let caller (fpcp-child call 0))
                        (let callee (fpcp-child call 2))
                        (let capability (fpcp-child call 3))
                        (if (not (str_eq (fcatw-binding-symbol caller)
                                        "form-cli/strict-route-requester")) 0
                        (if (not (str_eq (node_value (fpcp-child call 1))
                                        "admit-strict-route")) 0
                        (if (not (str_eq (fcatw-binding-symbol callee)
                                        "form-cli/strict-route-admission")) 0
                        (if (not (node_eq (fcatw-binding-image callee)
                                         (fcsri-image))) 0
                        (if (not (eq (node_type capability) 2)) 0
                        (if (not (str_eq (node_value capability)
                              "form-cli/strict-route-admission-capability-v1")) 0
                            (if (node_eq (fpcp-ack-correlation ack) request)
                                1 0)))))))))))))))))

    (defn fcseo-registry (request source entry)
        (fknq-registry-result "hit" "effect-offer-source-binding" request
            (psci-source-family source) (psci-source-path source)
            (psci-source-id source) 1 0 1 source entry 1))

    ; A held/current identity disagreement becomes stale while retaining the
    ; actually observed current identity.  A real path-unavailable miss stays
    ; miss; zero atom matches are never presented as a live miss here.
    (defn fcseo-current-bound (registry current)
        (if (not (str_eq (fkss-status current) "hit")) current
            (if (eq (fknq-current-identity-bound? registry current) 1) current
                (fkss-result "stale" "current-source-binding-drift"
                    (fkss-source-id-of current) (fkss-source-path current)
                    0 -1 "" (fkss-inventory-count current)
                    (fkss-eligible-count current)
                    (fkss-accessible-count current)
                    (fkss-source-size current) 0))))

    ; receipt = schema capability offer outer-status reason effect-count
    ;           raw-current-result 22-field-fknq-result trace
    ; The actual typed .100 observation node remains inside the fknq result
    ; and is exposed by fcseo-observation rather than mislabeled as this seat.
    (defn fcseo-outcome (capability offer status reason effect-count current
                         observation trace)
        (list (fcseo-schema) capability offer status reason effect-count
              current observation trace))
    (defn fcseo-status (receipt) (nth receipt 3))
    (defn fcseo-effect-count (receipt) (nth receipt 5))
    (defn fcseo-current (receipt) (nth receipt 6))
    (defn fcseo-result (receipt) (nth receipt 7))
    (defn fcseo-observation (receipt)
        (if (nothing? (fcseo-result receipt)) (nothing)
            (fknq-observation (fcseo-result receipt))))

    (defn fcseo-execute (capability grants offer)
        (if (eq (fcseo-capability-valid? capability) 0)
            (fcseo-outcome capability offer "failure" "capability-malformed" 0
                (nothing) (nothing)
                (list "offer" "failure" "release"))
        (if (eq (fcseo-offer-valid? offer) 0)
            (fcseo-outcome capability offer "failure" "offer-malformed" 0
                (nothing) (nothing)
                (list "offer" "failure" "release"))
        (if (eq (fcseo-granted? grants capability) 0)
            (fcseo-outcome capability offer "refused" "capability-refused" 0
                (nothing) (nothing)
                (list "offer" "refused" "release"))
            (do
                (let route (nth offer 1))
                (let request (nth offer 2))
                (let source (nth offer 3))
                (let entry (nth offer 4))
                (let fuel (node_value (nth offer 5)))
                (let policy (fcatw-sequence-values capability))
                (let root (node_value (nth policy 0)))
                (let family (node_value (nth policy 1)))
                (let max-window (node_value (nth policy 2)))
                (if (eq (fcseo-route-proof-valid? route request) 0)
                    (fcseo-outcome capability offer "failure"
                        "strict-route-proof-invalid" 0 (nothing) (nothing)
                        (list "offer" "failure" "release"))
                    (do
                        (let ack (nth route 2))
                        (let route-status (fpcp-ack-status ack))
                        (if (or (not (node_eq request (nth policy 3)))
                                (or (not (node_eq source (nth policy 4)))
                                    (not (node_eq entry (nth policy 5)))))
                            (fcseo-outcome capability offer "refused"
                                "capability-binding-refused" 0
                                (nothing) (nothing)
                                (list "offer" "refused" "release"))
                        (if (str_eq route-status "timeout")
                            (fcseo-outcome capability offer "timeout"
                                "prior-route-timeout" 0 (nothing) (nothing)
                                (list "offer" "timeout" "release"))
                        (if (or (str_eq route-status "failure")
                                (str_eq route-status "nothing"))
                            (fcseo-outcome capability offer "failure"
                                "prior-route-unavailable" 0
                                (nothing) (nothing)
                                (list "offer" "failure" "release"))
                        (if (not (str_eq route-status "returned"))
                            (fcseo-outcome capability offer "refused"
                                "prior-route-refused" 0 (nothing) (nothing)
                                (list "offer" "refused" "release"))
                        (if (or (not (eq (fpcp-ack-output ack) 1))
                                (or (not (eq
                                    (fpcp-value-kind (fpcp-ack-value ack))
                                    (fcatw-kind-int)))
                                    (not (eq (fpcp-value-raw
                                        (fpcp-ack-value ack)) 1))))
                            (fcseo-outcome capability offer "refused"
                                "strict-route-not-admitted" 0
                                (nothing) (nothing)
                                (list "offer" "refused" "release"))
                        (if (not (str_eq (psci-source-family source) family))
                            (fcseo-outcome capability offer "refused"
                                "source-family-refused" 0
                                (nothing) (nothing)
                                (list "offer" "refused" "release"))
                        (if (eq fuel 0)
                            (fcseo-outcome capability offer "timeout"
                                "observation-window-exhausted" 0
                                (nothing) (nothing)
                                (list "offer" "timeout" "release"))
                        (if (gt fuel max-window)
                            (fcseo-outcome capability offer "refused"
                                "observation-window-refused" 0
                                (nothing) (nothing)
                                (list "offer" "refused" "release"))
                            (do
                                (let registry (fcseo-registry request source
                                    entry))
                                ; Exactly one logical invocation begins here.
                                (let observed (fknq-current-source-result-at
                                    root registry request))
                                (let current (fcseo-current-bound registry
                                    observed))
                                (let scan (fknq-scan-row "ready"
                                    "effect-offer-authorized" request "" 0))
                                (let typed (fknq-result-from-evidence scan
                                    registry current 0))
                                (fcseo-outcome capability offer "returned"
                                    "current-source-observed" 1 current typed
                                    (list "offer" "authorize" "observe-current"
                                          "return" "release"))))))))))))))))))

    0)
