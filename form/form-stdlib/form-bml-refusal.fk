; form-bml-refusal.fk — where the cursor stops reading a form.bml section, in the words a writer reads: the
; line, and the first word the cursor could not read there.
;
; fbr-stop asks the cursor (grammars/form-bml.fk over bmf-grammar.fk) to read the section statement by statement
; and answers the byte where the statements stop: the first statement it cannot read, or the end of the text when
; it reads them all. It stands on the grammar alone, so the source compiler can read its words.
;
; preludes: form-stdlib/grammars/form-bml.fk

(do
    (defn fbr-stop (text)
        (do (let rr (g-match-rule (form-bml-section-grammar) "section" (cursor-str text)))
            (if (rok? rr) (cur-pos (skip-ws (rok-cur rr))) 0)))
    0)
