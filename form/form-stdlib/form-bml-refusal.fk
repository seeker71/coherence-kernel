; form-bml-refusal.fk — where the cursor stops reading a form.bml section, in the words a writer reads: the
; line, the word the cursor could not read there, and the forms the grammar could have begun reading in its place.
;
; fbr-refusal reads the section again with a traced grammar (grammars/form-bml.fk over bmf-grammar.fk), which keeps
; the farthest place a rule could not begin and the rules that could not begin there. That place is the stop: a
; refused class names the member it could not read, not the class. A section the cursor reads whole has no refusal.
; It stands on the grammar alone, so the source compiler can read its words.
;
; preludes: form-stdlib/grammars/form-bml.fk

(do
    (defn fbr-line-loop (text i pos n)
        (if (ge i pos)
            n
            (fbr-line-loop text (add i 1) pos (if (eq (str_byte_at text i) 10) (add n 1) n))))
    (defn fbr-line-at (text pos)
        (fbr-line-loop text 0 pos 1))
    (defn fbr-word-end (text i)
        (if (or (ge i (str_len text)) (not (cp-in-class? (str_byte_at text i) "bmlname")))
            i
            (fbr-word-end text (add i 1))))
    (defn fbr-word-at (text pos)
        (if (ge pos (str_len text))
            ""
            (do (let e (fbr-word-end text pos))
                (if (gt e pos)
                    (substring text pos e)
                    (substring text pos (add pos 1))))))
    (defn fbr-refusal (text)
        (do (let g (g-traced (form-bml-section-grammar)))
            (let rr (g-match-rule g "section" (cursor-str text)))
            (let far (g-far g))
            (let ended (if (rok? rr) (cur-pos (skip-ws (rok-cur rr))) 0))
            (let stop (if (gt (record_get far "at") ended) (record_get far "at") ended))
            (let result (if (ge stop (str_len text))
                (nothing)
                (list (fbr-line-at text stop) (fbr-word-at text stop)
                      (if (eq stop (record_get far "at")) (record_get far "want") (empty))
                      stop)))
            (g-memo-release g)
            (g-release-values (record_keys far) far)
            result))
     0)
