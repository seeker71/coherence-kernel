; hd-bodygraph.fk — the nine centres, the thirty-six channels, and the
; derivations that turn a set of activated gates into Type, Authority and
; Definition. The stone the cast was missing.
;
; WHAT WAS MISSING. chart-cast.fk and genekey-profile.fk turn a birth moment
; into GATES — the sky, placed on the rave mandala wheel. Everything after
; that ("you are a Projector with Splenic authority") needs a second table the
; body did not hold: which centre each gate sits in, which pairs of gates form
; a channel, and the rules that read a bodygraph off them. gk-hd-organ-lexicon
; holds those WORDS; nothing derived them. This cell derives them.
;
; SOURCING, AND THE CROSS-CHECK THAT MAKES IT TRUSTWORTHY. Two independent
; attested tables were taken 2026-08-29: the 36 channels with the centre pair
; each one joins (humandesignsystem.co), and the gate list of each of the nine
; centres (freehumandesignchart.com). They were then checked AGAINST EACH
; OTHER by constraint: every channel's two gates must land in exactly the two
; centres that channel names. All 64 gates are assigned exactly once, and all
; 36 channels are consistent with that assignment — 36/36, no exceptions. That
; agreement is the reason these rows are here rather than a single page's word.
; hdb-cross-check? re-runs it inside the body, so the check is not a story
; about what happened once but a claim any run can re-earn.
;
; THE DERIVATION RULES, attested and named:
;   a CHANNEL is defined when BOTH its gates are activated, in any combination
;     of Personality and Design;
;   a CENTRE is defined when it sits at either end of a defined channel;
;   MOTORS are Sacral, Root, Solar Plexus and Ego;
;   TYPE: Sacral defined + a motor reaching the Throat -> ManifestingGenerator;
;     Sacral defined otherwise -> Generator; Sacral open + a motor reaching the
;     Throat -> Manifestor; Sacral open, no motor to Throat -> Projector; no
;     centre defined at all -> Reflector;
;   AUTHORITY, strictly in this order: Solar Plexus, then Sacral, then Spleen,
;     then Ego, then a defined G reaching the Throat (self-projected), else
;     none-inner (mental for a Projector, lunar for a Reflector);
;   DEFINITION is the number of connected pieces the defined centres fall into
;     over the defined channels.
; "Reaching the Throat" is real graph connectivity over DEFINED channels, not
; adjacency — hdb-reaches? walks it.
;
; preludes: form-stdlib/core.fk
;
; Proven by: form-stdlib/tests/hd-bodygraph-band.fk

(do
    ;; ── the nine centres, as small stable ids ───────────────────────
    (defn hdb-head () 1)
    (defn hdb-ajna () 2)
    (defn hdb-throat () 3)
    (defn hdb-g () 4)
    (defn hdb-ego () 5)
    (defn hdb-sacral () 6)
    (defn hdb-solar () 7)
    (defn hdb-spleen () 8)
    (defn hdb-root () 9)
    (defn hdb-centres () (list 1 2 3 4 5 6 7 8 9))
    (defn hdb-centre-name (c)
        (if (eq c 1) "head" (if (eq c 2) "ajna" (if (eq c 3) "throat"
        (if (eq c 4) "g" (if (eq c 5) "ego" (if (eq c 6) "sacral"
        (if (eq c 7) "solar-plexus" (if (eq c 8) "spleen"
        (if (eq c 9) "root" "unknown")))))))))) 

    ;; ── gate -> centre, all 64 exactly once ─────────────────────────
    (defn hdb-cg (g c) (list g c))
    (defn hdb-gate-centres ()
        (list
            (hdb-cg 64 1) (hdb-cg 61 1) (hdb-cg 63 1)
            (hdb-cg 47 2) (hdb-cg 24 2) (hdb-cg 4 2) (hdb-cg 17 2)
            (hdb-cg 43 2) (hdb-cg 11 2)
            (hdb-cg 62 3) (hdb-cg 23 3) (hdb-cg 56 3) (hdb-cg 35 3)
            (hdb-cg 12 3) (hdb-cg 45 3) (hdb-cg 33 3) (hdb-cg 8 3)
            (hdb-cg 31 3) (hdb-cg 20 3) (hdb-cg 16 3)
            (hdb-cg 7 4) (hdb-cg 1 4) (hdb-cg 13 4) (hdb-cg 10 4)
            (hdb-cg 15 4) (hdb-cg 2 4) (hdb-cg 46 4) (hdb-cg 25 4)
            (hdb-cg 21 5) (hdb-cg 40 5) (hdb-cg 26 5) (hdb-cg 51 5)
            (hdb-cg 5 6) (hdb-cg 14 6) (hdb-cg 29 6) (hdb-cg 59 6)
            (hdb-cg 9 6) (hdb-cg 3 6) (hdb-cg 42 6) (hdb-cg 27 6)
            (hdb-cg 34 6)
            (hdb-cg 6 7) (hdb-cg 37 7) (hdb-cg 22 7) (hdb-cg 36 7)
            (hdb-cg 30 7) (hdb-cg 55 7) (hdb-cg 49 7)
            (hdb-cg 48 8) (hdb-cg 57 8) (hdb-cg 44 8) (hdb-cg 50 8)
            (hdb-cg 32 8) (hdb-cg 28 8) (hdb-cg 18 8)
            (hdb-cg 53 9) (hdb-cg 60 9) (hdb-cg 52 9) (hdb-cg 19 9)
            (hdb-cg 39 9) (hdb-cg 41 9) (hdb-cg 58 9) (hdb-cg 38 9)
            (hdb-cg 54 9)))
    (defn hdb-gate-count () (len (hdb-gate-centres)))
    (defn hdb-centre-of-loop (rs g)
        (if (eq (len rs) 0) (nothing)
            (if (eq (nth (head rs) 0) g) (nth (head rs) 1)
                (hdb-centre-of-loop (tail rs) g))))
    (defn hdb-centre-of (g) (hdb-centre-of-loop (hdb-gate-centres) g))

    ;; ── the thirty-six channels, each a gate pair ───────────────────
    (defn hdb-ch (a b) (list a b))
    (defn hdb-channels ()
        (list
            (hdb-ch 61 24) (hdb-ch 43 23) (hdb-ch 8 1)  (hdb-ch 2 14)
            (hdb-ch 3 60)  (hdb-ch 39 55) (hdb-ch 22 12) (hdb-ch 38 28)
            (hdb-ch 34 57) (hdb-ch 57 10) (hdb-ch 57 20) (hdb-ch 34 10)
            (hdb-ch 34 20) (hdb-ch 20 10) (hdb-ch 25 51) (hdb-ch 45 21)
            (hdb-ch 40 37) (hdb-ch 59 6)  (hdb-ch 19 49) (hdb-ch 54 32)
            (hdb-ch 50 27) (hdb-ch 44 26) (hdb-ch 64 47) (hdb-ch 63 4)
            (hdb-ch 17 62) (hdb-ch 11 56) (hdb-ch 31 7)  (hdb-ch 33 13)
            (hdb-ch 15 5)  (hdb-ch 46 29) (hdb-ch 42 53) (hdb-ch 9 52)
            (hdb-ch 18 58) (hdb-ch 30 41) (hdb-ch 36 35) (hdb-ch 48 16)))
    (defn hdb-channel-count () (len (hdb-channels)))

    ;; ── THE CROSS-CHECK: every channel joins two DIFFERENT centres,
    ;; and every gate it names is one this cell places. Re-earned on
    ;; every run rather than asserted once in a comment. ──
    (defn hdb-cross-loop (cs)
        (if (eq (len cs) 0) 1
            (do (let a (hdb-centre-of (nth (head cs) 0)))
                (let b (hdb-centre-of (nth (head cs) 1)))
                (if (or (nothing? a) (or (nothing? b) (eq a b))) 0
                    (hdb-cross-loop (tail cs))))))
    (defn hdb-cross-check? () (hdb-cross-loop (hdb-channels)))

    ;; ── activations ─────────────────────────────────────────────────
    (defn hdb-active-loop (gs g)
        (if (eq (len gs) 0) 0
            (if (eq (head gs) g) 1 (hdb-active-loop (tail gs) g))))
    (defn hdb-active? (gs g) (hdb-active-loop gs g))
    (defn hdb-defined-channels-loop (cs gs acc)
        (if (eq (len cs) 0) acc
            (do (let c (head cs))
                (hdb-defined-channels-loop (tail cs) gs
                    (if (and (eq (hdb-active? gs (nth c 0)) 1)
                             (eq (hdb-active? gs (nth c 1)) 1))
                        (append acc (list c)) acc)))))
    (defn hdb-defined-channels (gs)
        (hdb-defined-channels-loop (hdb-channels) gs (list)))

    (defn hdb-centre-defined-loop (dcs c)
        (if (eq (len dcs) 0) 0
            (do (let d (head dcs))
                (if (or (eq (hdb-centre-of (nth d 0)) c)
                        (eq (hdb-centre-of (nth d 1)) c)) 1
                    (hdb-centre-defined-loop (tail dcs) c)))))
    (defn hdb-centre-defined? (gs c)
        (hdb-centre-defined-loop (hdb-defined-channels gs) c))
    (defn hdb-defined-centres-loop (cl gs acc)
        (if (eq (len cl) 0) acc
            (hdb-defined-centres-loop (tail cl) gs
                (if (eq (hdb-centre-defined? gs (head cl)) 1)
                    (append acc (list (head cl))) acc))))
    (defn hdb-defined-centres (gs)
        (hdb-defined-centres-loop (hdb-centres) gs (list)))

    ;; ── connectivity over DEFINED channels: can centre a reach b? ───
    (defn hdb-in? (xs x)
        (if (eq (len xs) 0) 0 (if (eq (head xs) x) 1 (hdb-in? (tail xs) x))))
    (defn hdb-step-loop (dcs seen acc)
        (if (eq (len dcs) 0) acc
            (do (let d (head dcs))
                (let x (hdb-centre-of (nth d 0)))
                (let y (hdb-centre-of (nth d 1)))
                (hdb-step-loop (tail dcs) seen
                    (if (and (eq (hdb-in? seen x) 1) (eq (hdb-in? acc y) 0))
                        (append acc (list y))
                        (if (and (eq (hdb-in? seen y) 1) (eq (hdb-in? acc x) 0))
                            (append acc (list x)) acc))))))
    (defn hdb-close-loop (dcs seen k)
        (if (eq k 0) seen
            (do (let grown (hdb-step-loop dcs seen seen))
                (if (eq (len grown) (len seen)) seen
                    (hdb-close-loop dcs grown (sub k 1))))))
    (defn hdb-reach (gs c)
        (hdb-close-loop (hdb-defined-channels gs) (list c) 9))
    (defn hdb-reaches? (gs a b) (hdb-in? (hdb-reach gs a) b))

    ;; ── motors, and whether any reaches the throat ──────────────────
    (defn hdb-motors () (list 6 9 7 5))
    (defn hdb-motor-throat-loop (gs ms)
        (if (eq (len ms) 0) 0
            (if (and (eq (hdb-centre-defined? gs (head ms)) 1)
                     (eq (hdb-reaches? gs (head ms) (hdb-throat)) 1)) 1
                (hdb-motor-throat-loop gs (tail ms)))))
    (defn hdb-motor-to-throat? (gs) (hdb-motor-throat-loop gs (hdb-motors)))

    ;; ── TYPE ────────────────────────────────────────────────────────
    (defn hdb-type (gs)
        (if (eq (len (hdb-defined-centres gs)) 0) "reflector"
            (if (eq (hdb-centre-defined? gs (hdb-sacral)) 1)
                (if (eq (hdb-motor-to-throat? gs) 1)
                    "manifesting-generator" "generator")
                (if (eq (hdb-motor-to-throat? gs) 1)
                    "manifestor" "projector"))))

    ;; ── AUTHORITY, strictly in the attested order ───────────────────
    (defn hdb-authority (gs)
        (if (eq (hdb-centre-defined? gs (hdb-solar)) 1) "emotional"
        (if (eq (hdb-centre-defined? gs (hdb-sacral)) 1) "sacral"
        (if (eq (hdb-centre-defined? gs (hdb-spleen)) 1) "splenic"
        (if (eq (hdb-centre-defined? gs (hdb-ego)) 1) "ego"
        (if (and (eq (hdb-centre-defined? gs (hdb-g)) 1)
                 (eq (hdb-reaches? gs (hdb-g) (hdb-throat)) 1))
            "self-projected"
        (if (eq (len (hdb-defined-centres gs)) 0) "lunar" "mental")))))))

    ;; ── DEFINITION: how many pieces the defined centres fall into ───
    (defn hdb-remove-loop (xs ys acc)
        (if (eq (len xs) 0) acc
            (hdb-remove-loop (tail xs) ys
                (if (eq (hdb-in? ys (head xs)) 1) acc
                    (append acc (list (head xs)))))))
    (defn hdb-pieces-loop (gs remaining n)
        (if (eq (len remaining) 0) n
            (do (let piece (hdb-reach gs (head remaining)))
                (hdb-pieces-loop gs
                    (hdb-remove-loop remaining piece (list)) (add n 1)))))
    (defn hdb-definition-count (gs)
        (hdb-pieces-loop gs (hdb-defined-centres gs) 0))
    (defn hdb-definition-name (gs)
        (do (let n (hdb-definition-count gs))
            (if (eq n 0) "none" (if (eq n 1) "single" (if (eq n 2) "split"
            (if (eq n 3) "triple-split" (if (eq n 4) "quadruple-split"
                "more")))))))
    0)
