; framebuffer-value-cache.fk -- bounded Form-native reuse of an already-built
; content-addressed value inside the current framebuffer observation window.
;
; A key does not grant authority and an entry does not outlive its window:
; framebuffer-clear releases every entry.  Values remain ordinary immutable
; cells.  The cache only prevents an accessor from reconstructing the same
; derivation while one witnessed run is still active.
; preludes: form-stdlib/core.fk

(do
    (let FBVC-ENTRY (bp "FBVC-ENTRY"))
    (let FBVC-KEY (bp "FBVC-KEY"))

    (defn fbvc-key (offered-label)
        (intern_node FBVC-KEY
            (list (intern_trivial_string offered-label))))

    ; A result is (hit? value-or-key).  Keeping presence separate from value
    ; lets nothing, zero, an alternative, or any other cell be cached without
    ; turning it into an absence sentinel.
    (defn fbvc-find-items (items key)
        (if (eq (len items) 0) (list 0 key)
            (do
                (let item (head items))
                (if (node_eq (node_category item) FBVC-ENTRY)
                    (do
                        (let children (node_children item))
                        (if (and (eq (len children) 2)
                                 (node_eq (nth children 0) key))
                            (list 1 (nth children 1))
                            (fbvc-find-items (tail items) key)))
                    (fbvc-find-items (tail items) key)))))

    (defn fbvc-find (key)
        (fbvc-find-items (framebuffer-events) key))
    (defn fbvc-hit? (found) (nth found 0))
    (defn fbvc-value (found) (nth found 1))

    (defn fbvc-store (key value file line col)
        (intern_node_at FBVC-ENTRY (list key value) file line col))

    (defn fbvc-entry? (cell)
        (if (node_eq (node_category cell) FBVC-ENTRY) 1 0))
    0)
