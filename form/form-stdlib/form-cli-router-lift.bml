; form-cli-router-lift.bml — fcr-walk and fitness, authored in form.lift.
;
; Lift of form-cli-router.fk. Same names. This .bml lowers in memory when
; preluded; the s-expr file still serves its own callers. Edit this section.
;
// preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-router-lift-band.fk
; witnessed: 2026-08-20 -> 255

section [form.lift] {
    allow fcr-confidence-axis(passes, attempts) = if attempts == 0 then 0 else div(mul(passes, 100), attempts);
    allow fcr-weights() = list(2, 2, 1, 1, 6);
    allow fcr-backend(name, sovereignty, trust, capability, confidence) = list(name, sovereignty, trust, capability, confidence);
    allow fcr-name(b) = nth(b, 0);
    allow fcr-sovereignty(b) = nth(b, 1);
    allow fcr-trust(b) = nth(b, 2);
    allow fcr-capability(b) = nth(b, 3);
    allow fcr-confidence(b) = nth(b, 4);
    allow fcr-backend-learned(name, sovereignty, trust, capability, passes, attempts) = fcr-backend(name, sovereignty, trust, capability, fcr-confidence-axis(passes, attempts));
    allow fcr-fitness(b) = if fcr-capability(b) == 0 then 0 else div(add(add(mul(nth(fcr-weights(), 0), fcr-sovereignty(b)), mul(nth(fcr-weights(), 1), fcr-trust(b))), add(mul(nth(fcr-weights(), 2), fcr-capability(b)), mul(nth(fcr-weights(), 3), fcr-confidence(b)))), nth(fcr-weights(), 4));
    allow fcr-route(form-native, agent-cli) = if fcr-fitness(form-native) >= fcr-fitness(agent-cli) then fcr-name(form-native) else fcr-name(agent-cli);
    allow fcr-flips-local?(fn-before, fn-after, agent-cli) = if str_eq(fcr-route(fn-before, agent-cli), "agent-cli") then if str_eq(fcr-route(fn-after, agent-cli), "form-native") then 1 else 0 else 0;
    allow fcr-sovereign?(winner-name) = if str_eq(winner-name, "form-native") then 1 else 0;
    allow fcr-lane-native() = 0;
    allow fcr-lane-local() = 1;
    allow fcr-lane-remote() = 2;
    allow fcr-walk(native-hit, local-ready) = if native-hit == 1 then 0 else if local-ready == 1 then 1 else 2;
    0;
}
