; form-cli-nodeid-know.fk — a knowledge query answers with an offer.
;
; kra-answer is already the lookup (unknown is exact nothing; a known
; surface returns a rest pointer). This door does not grow a second
; registry. It wraps that pointer as a node-id offer. An ask replies
; outside the local LLM token stream. Offer without ask replies nothing.
; Catalog growth on kra's side grows this door: one fold over the rows.
;
; preludes: form-stdlib/form-cli-nodeid-answer.fk form-stdlib/knowledge-rest-answer.fk
; Proven by: form-stdlib/tests/form-cli-nodeid-know-band.fk
; witnessed: 2026-08-30 -> 255

(do
    (defn fnk-from-rest-operand (x)
        (if (eq (lg-defer? x) 1)
            (fnid-recipe (nth x 1)
                (fnk-from-rest-operand (nth x 2))
                (fnk-from-rest-operand (nth x 3)))
            x))
    (defn fnk-know (q)
        (do
            (let rest (kra-answer q))
            (if (nothing? rest) (nothing)
                (fnk-from-rest-operand rest))))
    (defn fnk-know-reply (q)
        (do
            (let p (fnk-know q))
            (if (nothing? p) (nothing)
                (fnid-reply (fnid-ask p)))))
    (defn fnk-row-agrees (row)
        (do
            (let q (nth row 0))
            (let p (fnk-know q))
            (if (nothing? p) 0
                (if (eq (nothing? (fnid-reply p)) 0) 0
                    (eq (fnk-know-reply q) (lg-force (nth row 1)))))))
    (defn fnk-catalog-agrees (rows)
        (if (eq (len rows) 0) 1
            (if (eq (fnk-row-agrees (head rows)) 0) 0
                (fnk-catalog-agrees (tail rows)))))
    (defn fnk-catalog-ok ()
        (if (eq (len (kra-registry)) 0) 0
            (fnk-catalog-agrees (kra-registry))))
    (defn fnk-know-speak ()
        (str_concat "node-id know unknown=" (str_concat (fnid-reply-name (fnk-know-reply "no-such-query"))
        (str_concat " ground-offer-reply=" (str_concat (fnid-reply-name (fnid-reply (fnk-know "bootstrap/ground")))
        (str_concat " ground-ask-reply=" (str_concat (fnid-reply-name (fnk-know-reply "bootstrap/ground"))
        (str_concat " twice-ask-reply=" (str_concat (fnid-reply-name (fnk-know-reply "ground twice"))
        (str_concat " catalog=" (str_concat (int_to_str (len (kra-registry)))
            " cost=outside\n")))))))))))
    (defn fnkk (cond bit) (if cond bit 0))
    (defn fnk-check ()
        (add (add (add (add (add (add (add
            (fnkk (nothing? (fnk-know "no-such-query")) 1)
            (fnkk (nothing? (fnid-reply (fnk-know "bootstrap/ground"))) 2))
            (fnkk (eq (fnk-know-reply "bootstrap/ground") 42) 4))
            (fnkk (eq (fnk-know-reply "ground twice") 84) 8))
            (fnkk (eq (fnk-catalog-ok) 1) 16))
            (fnkk (eq (fnid-cost (fnk-know "bootstrap/ground")) (fnid-cost-outside)) 32))
            (fnkk (eq (fnid-kind (fnk-know "bootstrap/ground")) (fnid-kind-recipe)) 64))
            (fnkk (eq (lg-defer? (fnk-know "bootstrap/ground")) 0) 128)))
)
