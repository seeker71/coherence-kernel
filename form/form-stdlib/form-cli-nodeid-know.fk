// form-cli-nodeid-know.fk — a knowledge query answers with an offer.
//
// kra-answer is already the lookup (unknown is exact nothing; a known
// surface returns a rest pointer). This door does not grow a second
// registry. It wraps that pointer as a node-id offer. An ask replies
// outside the local LLM token stream. Offer without ask replies nothing.
// Catalog growth on kra's side grows this door: one fold over the rows.
//
// preludes: form-stdlib/form-cli-nodeid-answer.fk form-stdlib/knowledge-rest-answer.fk
// witnessed: 2026-08-30 -> 255
section [form.bml] {
    def fnk-from-rest-operand(x) = (Comparable) lg-defer?(x) == 1 ? fnid-recipe(nth(x, 1), fnk-from-rest-operand(nth(x, 2)), fnk-from-rest-operand(nth(x, 3))) : x;
    def fnk-know(q) = {
        let rest = kra-answer(q);
        nothing?(rest) ? nothing() : fnk-from-rest-operand(rest);
    };
    def fnk-know-reply(q) = {
        let p = fnk-know(q);
        nothing?(p) ? nothing() : fnid-reply(fnid-ask(p));
    };
    def fnk-row-agrees(row) = {
        let q = nth(row, 0);
        let p = fnk-know(q);
        nothing?(p) ? 0 : (Comparable) nothing?(fnid-reply(p)) == 0 ? 0 : (Comparable) fnk-know-reply(q) == lg-force(nth(row, 1));
    };
    def fnk-catalog-agrees(rows) = (Comparable) len(rows) == 0 ? 1 : (Comparable) fnk-row-agrees(head(rows)) == 0 ? 0 : fnk-catalog-agrees(tail(rows));
    def fnk-catalog-ok() = (Comparable) len(kra-registry()) == 0 ? 0 : fnk-catalog-agrees(kra-registry());
    def fnk-know-speak() = str_concat("node-id know unknown=", str_concat(fnid-reply-name(fnk-know-reply("no-such-query")), str_concat(" ground-offer-reply=", str_concat(fnid-reply-name(fnid-reply(fnk-know("bootstrap/ground"))), str_concat(" ground-ask-reply=", str_concat(fnid-reply-name(fnk-know-reply("bootstrap/ground")), str_concat(" twice-ask-reply=", str_concat(fnid-reply-name(fnk-know-reply("ground twice")), str_concat(" catalog=", str_concat(int_to_str(len(kra-registry())), " cost=outside\n"))))))))));
    def fnkk(cond, bit) = cond ? bit : 0;
    def fnk-check() = fnkk(nothing?(fnk-know("no-such-query")), 1) + fnkk(nothing?(fnid-reply(fnk-know("bootstrap/ground"))), 2) + fnkk((Comparable) fnk-know-reply("bootstrap/ground") == 42, 4) + fnkk((Comparable) fnk-know-reply("ground twice") == 84, 8) + fnkk((Comparable) fnk-catalog-ok() == 1, 16) + fnkk((Comparable) fnid-cost(fnk-know("bootstrap/ground")) == fnid-cost-outside(), 32) + fnkk((Comparable) fnid-kind(fnk-know("bootstrap/ground")) == fnid-kind-recipe(), 64) + fnkk((Comparable) lg-defer?(fnk-know("bootstrap/ground")) == 0, 128);
}
