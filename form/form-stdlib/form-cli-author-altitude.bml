//////////////////////////////////////////////////////////////////////
//
// form-cli-author-altitude.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-author-altitude.bml
//
// Counts pictures, living cells, and bindings. Prints with warmth.
// The observe/authoring-altitude-run.fk door only asks this class.
//
// Proven by: form-stdlib/tests/form-cli-author-altitude-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template AltitudeRow<TCount> {
        member pictures: TCount;
        member cells: TCount;
        member bound: TCount;
    }

    class FormAuthorAltitudeAuthority {
        field AltitudeAuthorityPath = "form/form-stdlib/bml/form-cli-author-altitude.bml";
        field AltitudeAuthorityKind = "high-bml-class-template-field";
    }

    class FormAuthorAltitude<T> {
        field PicturesDir = "form/form-stdlib/bml";
        field CellsDir = "form/form-stdlib";
        field BindMark = "high-bml-class-template-field";

        ref aar-authority = FormAuthorAltitudeAuthority;
        thought aar-pattern = list("pictures-with-warmth", "organs-welcome", "bindings-ripen");

        def aar-ends?(name, suffix) {
            if lt(str_len(name), str_len(suffix)) then 0 else if str_eq(substring(name, sub(str_len(name), str_len(suffix)), str_len(name)), suffix) then 1 else 0;
        }
        def aar-count-suffix(names, suffix, acc) = if eq(len(names), 0) then acc else aar-count-suffix(tail(names), suffix, add(acc, aar-ends?(head(names), suffix)));
        def aar-bound?(path) = if ge(str_find(read_file(path), BindMark(), 0), 0) then 1 else 0;
        def aar-count-bound(dir, names, acc) = if eq(len(names), 0) then acc else aar-count-bound(dir, tail(names), add(acc, if eq(aar-ends?(head(names), ".fk"), 1) then aar-bound?(fs-path-join(dir, head(names))) else 0));

        def aar-pictures() = aar-count-suffix(fs-list(PicturesDir()), ".bml", 0);
        def aar-cells() = aar-count-suffix(fs-list(CellsDir()), ".fk", 0);
        def aar-bound() = aar-count-bound(CellsDir(), fs-list(CellsDir()), 0);
        def aar-ppm(bound, cells) = div(mul(bound, 1000000), if eq(cells, 0) then 1 else cells);
        def aar-fold(pictures, bound, cells) = add(mul(pictures, 10000000000), add(mul(bound, 10000000), cells));

        def aar-run() {
            let pictures = aar-pictures();
            let cells = aar-cells();
            let bound = aar-bound();
            print(str_concat("pictures=", int_to_str(pictures)));
            print(str_concat("cells=", int_to_str(cells)));
            print(str_concat("bound-cells=", int_to_str(bound)));
            print(str_concat("bound-ppm=", int_to_str(aar-ppm(bound, cells))));
            aar-fold(pictures, bound, cells);
        }

        def aar-bit(ok, bit) = if ok then bit else 0;
        def aar-check() {
            let pictures = aar-pictures();
            let cells = aar-cells();
            let bound = aar-bound();
            let c0 = aar-bit(gt(pictures, 0), 1);
            let c1 = aar-bit(gt(cells, pictures), 2);
            let c2 = aar-bit(gt(bound, 0), 4);
            let c3 = aar-bit(eq(aar-fold(pictures, bound, cells), add(mul(pictures, 10000000000), add(mul(bound, 10000000), cells))), 8);
            add(c0, add(c1, add(c2, c3)));
        }
    }
    0;
}
