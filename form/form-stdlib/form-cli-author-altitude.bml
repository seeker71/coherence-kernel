//////////////////////////////////////////////////////////////////////
//
// form-cli-author-altitude.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-author-altitude.bml
//
import form-stdlib/core.fk;
import form-stdlib/form-fs.fk;
import form-stdlib/language-model.fk;
import form-stdlib/scale.bml;
//
// Counts pictures, living cells, and bindings. Prints with warmth.
// The observe/authoring-altitude-run.fk door only asks this class.
//
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template AltitudeRow<TCount> {
        member pictures: TCount;
        member cells: TCount;
        member bound: TCount;
    }

    class FormAuthorAltitudeAuthority {
        field AltitudeAuthorityPath = "form/form-stdlib/bml/form-cli-author-altitude.bml";
        field AltitudeAuthorityKind = "high-bml-class-template-field";
    }

    class FormAuthorAltitude<T> {
        field PicturesDir = "form/form-stdlib/bml";
        field CellsDir = "form/form-stdlib";
        field BindMark = "high-bml-class-template-field";

        ref aar-authority = FormAuthorAltitudeAuthority;
        thought aar-pattern = ["pictures-with-warmth", "organs-welcome", "bindings-ripen"];

        def aar-ends?(name, suffix) {
            len(name) < len(suffix) ? 0 : (String) substring(name, len(name) - len(suffix), len(name)) == suffix ? 1 : 0;
        }
        def aar-count-suffix(names, suffix, acc) = (Comparable) len(names) == 0 ? acc : aar-count-suffix(names[1:], suffix, acc + aar-ends?(names[0], suffix));
        def aar-bound?(path) = str_find(read_file(path), BindMark(), 0) >= 0 ? 1 : 0;
        def aar-count-bound(dir, names, acc) = (Comparable) len(names) == 0 ? acc : aar-count-bound(dir, names[1:], acc + ((Comparable) aar-ends?(names[0], ".fk") == 1 ? aar-bound?(fs-path-join(dir, names[0])) : 0));

        def aar-pictures() = aar-count-suffix(fs-list(PicturesDir()), ".bml", 0);
        def aar-cells() = aar-count-suffix(fs-list(CellsDir()), ".fk", 0);
        def aar-bound() = aar-count-bound(CellsDir(), fs-list(CellsDir()), 0);
        def aar-ppm(bound, cells) = ppm-of(bound, (Comparable) cells == 0 ? 1 : cells);
        def aar-fold(pictures, bound, cells) = (pictures * 10000000000) + ((bound * 10000000) + cells);

        def aar-run() {
            let pictures = aar-pictures();
            let cells = aar-cells();
            let bound = aar-bound();
            print("pictures=" + pictures.str());
            print("cells=" + cells.str());
            print("bound-cells=" + bound.str());
            print("bound-ppm=" + aar-ppm(bound, cells).str());
            aar-fold(pictures, bound, cells);
        }

        def aar-bit(ok, bit) = ok ? bit : 0;
        def aar-check() {
            let pictures = aar-pictures();
            let cells = aar-cells();
            let bound = aar-bound();
            let c0 = aar-bit(pictures > 0, 1);
            let c1 = aar-bit(cells > pictures, 2);
            let c2 = aar-bit(bound > 0, 4);
            let c3 = aar-bit((Comparable) aar-fold(pictures, bound, cells) == ((pictures * 10000000000) + ((bound * 10000000) + cells)), 8);
            c0 + (c1 + (c2 + c3));
        }
    }
    0;
}
