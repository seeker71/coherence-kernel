; form-recipe-exec-token-live-run.fk — the registered affine NodeID request,
; streamed byte-by-byte, generated and executed through the live Metal door.
;
; This witness is effectful. Run only when the resident model is not using the
; same carrier. The rendered observation contains no request payload or MSL.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/format-arith.fk form-stdlib/metal-door.fk
; preludes: form-stdlib/form-recipe-exec-token.fk
; preludes: form-stdlib/form-recipe-exec-token-live.fk

(do
    (let surface (frex-surface (frex-recipe) 5 "metal"))
    (let result (frexl-execute-stream surface))
    (print (frexl-live-render result))
    (print "\n")
    (if (and (str_eq (frexl-result-status result) "value")
        (and (eq (frexl-result-value-present? result) 1)
        (and (eq (frexl-result-value result) 22)
        (and (eq (frexl-result-source-generated? result) 1)
        (and (eq (frexl-result-native-code-generated? result) 1)
        (and (eq (frexl-result-executed? result) 1)
        (and (eq (frexl-result-model-executed? result) 0)
             (eq (frexl-result-buffer-released? result) 1))))))))
        255 0))
