; dsv4-generation-request.fk — shaped data for an offline DS4 generation walk.
;
; Code owns the stable transformations.  A request owns the changing model
; location, prompt location, decode extent, derived token ids, and lineage.
; Nothing here selects a remote path.
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/dsv4-tokenizer.fk

(do
    ; (model-path prompt-path n-predict)
    (defn dgr-request (model prompt n)
        (list model prompt n))
    (defn dgr-model (r) (nth r 0))
    (defn dgr-prompt-path (r) (nth r 1))
    (defn dgr-n-predict (r) (nth r 2))
    (defn dgr-prompt (r) (read_file (dgr-prompt-path r)))
    (defn dgr-source (r) (tkz-src (dgr-model r)))
    (defn dgr-prompt-ids (r) (tkz-encode (dgr-source r) (dgr-prompt r)))
    (defn dgr-chat-ids (r)
        (do
            (let src (dgr-source r))
            (append
                (list
                    (tkz-stored-id-of src "<｜begin▁of▁sentence｜>")
                    (tkz-stored-id-of src "<｜User｜>"))
                (append
                    (tkz-encode src (dgr-prompt r))
                    (list
                        (tkz-stored-id-of src "<｜Assistant｜>")
                        (tkz-stored-id-of src "</think>"))))))

    (defn dgr-ids-csv (ids)
        (if (eq (len ids) 0) ""
            (if (eq (len (tail ids)) 0)
                (int_to_str (head ids))
                (str_concat (int_to_str (head ids))
                    (str_concat "," (dgr-ids-csv (tail ids)))))))

    (defn dgr-csv-ids (csv)
        (dgr-parts-ids (split-on csv ",") (empty)))
    (defn dgr-parts-ids (parts acc)
        (if (eq (len parts) 0) (reverse acc)
            (dgr-parts-ids (tail parts)
                (cons (str_to_int (head parts)) acc))))

    (defn dgr-emit-tokenize (r)
        (do
            (let ids (dgr-chat-ids r))
            (print_str "DGR schema=1")
            (print_str (str_concat "DGR model=" (dgr-model r)))
            (print_str (str_concat "DGR prompt-path=" (dgr-prompt-path r)))
            (print_str (str_concat "DGR prompt-bytes=" (int_to_str (str_len (dgr-prompt r)))))
            (print_str (str_concat "DGR prompt-token-count=" (int_to_str (len ids))))
            (print_str (str_concat "DGR prompt-token-ids=" (dgr-ids-csv ids)))
            (print_str "DGR prompt-shape=bos+user+content+assistant+think-end")
            (print_str (str_concat "DGR n-predict=" (int_to_str (dgr-n-predict r))))
            (print_str "DGR tokenizer-lineage=gguf:tokenizer.ggml.tokens+merges")
            (print_str "DGR remote=0")
            0))

    (defn dgr-emit-decode (model csv)
        (do
            (let ids (dgr-csv-ids csv))
            (let src (tkz-src model))
            (print_str (str_concat "DGR result-token-count=" (int_to_str (len ids))))
            (print_str (str_concat "DGR result-token-ids=" (dgr-ids-csv ids)))
            (print_str (str_concat "DGR result-text=" (tkz-decode-text src ids)))
            (print_str "DGR decode-lineage=gguf:tokenizer.ggml.tokens")
            0))
    0)
