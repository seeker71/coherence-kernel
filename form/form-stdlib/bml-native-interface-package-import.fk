// bml-native-interface-package-import.fk - rows for source boundaries.
//
// Package, import, and interface declarations become explicit rows with source
// receipts and optional port-shape linkage. grammars/bml.fk builds these rows
// for every source unit it compiles and resolves names through them: its scope
// linker reads the package row for qualified names and the import rows for the
// units a table links. Interface rows are carried as metadata; interface
// dispatch lowering is the next code point.
//
// preludes: form-stdlib/core.fk
//
section [form.bml] {
    def bnii-source(language, path, line) = ["source", language, path, line];
    def bnii-source-language(source) = source[1];
    def bnii-source-path(source) = source[2];
    def bnii-source-line(source) = source[3];
    def bnii-package(name, source) = ["bml-native-package", name, source];
    def bnii-package?(row) = (Comparable) len(row) == 3 ? (String) row[0] == "bml-native-package" : 0;
    def bnii-package-name(row) = row[1];
    def bnii-package-source(row) = row[2];
    def bnii-import(module, selector, source) = ["bml-native-import", module, selector, source];
    def bnii-import?(row) = (Comparable) len(row) == 4 ? (String) row[0] == "bml-native-import" : 0;
    def bnii-import-module(row) = row[1];
    def bnii-import-selector(row) = row[2];
    def bnii-import-source(row) = row[3];
    def bnii-import-star?(row) = (String) bnii-import-selector(row) == ".*" ? 1 : 0;
    def bnii-interface(name, parent, members, port, source) = ["bml-native-interface", name, parent, members, port, source];
    def bnii-interface?(row) = (Comparable) len(row) == 6 ? (String) row[0] == "bml-native-interface" : 0;
    def bnii-interface-name(row) = row[1];
    def bnii-interface-parent(row) = row[2];
    def bnii-interface-members(row) = row[3];
    def bnii-interface-port(row) = row[4];
    def bnii-interface-source(row) = row[5];
    def bnii-interface-uses-port?(row, port) = node_eq(bnii-interface-port(row), port) ? 1 : 0;
    def bnii-unit(package, imports, interfaces) = ["bml-native-interface-package-import-unit", package, imports, interfaces];
    def bnii-unit?(row) = (Comparable) len(row) == 4 ? (String) row[0] == "bml-native-interface-package-import-unit" : 0;
    def bnii-unit-package(row) = row[1];
    def bnii-unit-imports(row) = row[2];
    def bnii-unit-interfaces(row) = row[3];
    def bnii-unit-import-count(unit) = len(bnii-unit-imports(unit));
    def bnii-unit-interface-count(unit) = len(bnii-unit-interfaces(unit));
    def bnii-unit-package-name(unit) = bnii-package-name(bnii-unit-package(unit));
    def bnii-next-code-point() = "form/form-stdlib/grammars/bml.fk:bml-scope-link -> native interface dispatch lowering";
    0;
}
