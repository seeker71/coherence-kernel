// form-nodeid-mastery-cell-categories.fk -- the small identity surface owned
// by the Form-native mastery-cell protocol.
//
// Kept separate so joined identity observation does not need to compile the
// whole mastery mechanism. This is not a registry or dispatch table.
//
// preludes: form-stdlib/core.fk
section [form.bml] {
    def fmcl-concept-category() = make_nodeid(31, 2, 0, 108);
    def fmcl-attempt-category() = make_nodeid(31, 2, 0, 109);
    def fmcl-request-category() = make_nodeid(31, 2, 0, 110);
    def fmcl-execution-category() = make_nodeid(31, 2, 0, 111);
    def fmcl-observation-category() = make_nodeid(31, 2, 0, 112);
    def fmcl-signal-category() = make_nodeid(31, 2, 0, 113);
    def fmcl-lifecycle-category() = make_nodeid(31, 2, 0, 114);
    def fmcl-state-category() = make_nodeid(31, 2, 0, 115);
    def fmcl-continuation-category() = make_nodeid(31, 2, 0, 116);
    def fmcl-channel-category() = make_nodeid(31, 2, 0, 117);
    def fmcl-mesh-category() = make_nodeid(31, 2, 0, 118);
    def fmcl-persistence-category() = make_nodeid(31, 2, 0, 119);
    0;
}
