//////////////////////////////////////////////////////////////////////
//
// mirror-glass.bml — the mirror census, spoken as a panel and given to the glass.
//
// Authority: form/form-stdlib/mirror-glass.bml
// preludes: form/form-stdlib/mirror-census.bml form/form-stdlib/form-glass-sensor-rows.bml
// Proven by: form-stdlib/tests/mirror-census-band.fk (the arithmetic)
//            observe/mirror-census-take.fk (the frame arrives)
//
// The census itself (mirror-census.bml) is proven pure over hand-written mirror
// rows. This cell is where it meets the tree: it reads the eight files, prints the
// panel and gives the rows under its own publisher. The publisher declares its
// cadence INSIDE the frame (fgsr-give-at), so the roster needs no edit to carry a
// new sensor — a taker reads the cadence the giver stated.
//
// The rows are chosen for what a reader must act on, not for what is easy to
// count. The top row is the worst-drag name, because an armhush is a native the
// body is paying a recipe's price for right now; the orphan-arm count is beside
// it, because a seedgap name and an unclaimed tag are two halves of one reading
// and separating them is what cost 2026-09-08 a day.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class MirrorGlassAuthority {
        field MGLAuthorityPath = "form/form-stdlib/mirror-glass.bml";
        field MGLAuthorityKind = "high-bml-interface-class-const";
    }

    class MirrorGlass {
        field MGLShown = 8;
        field MGLDomain = "kernel";
        field MGLChannel = "native-surface";
        field MGLSource = "mirror-census";
        ref mgl-authority = MirrorGlassAuthority;

        // --- the panel ---------------------------------------------------------
        def mgl-worst(rs) = if eq(len(rs), 0) then "none" else mcs-r-name(head(rs));
        def mgl-worst-verdict(rs) = if eq(len(rs), 0) then "whole" else mcs-r-verdict(head(rs));
        def mgl-tags-text(ts) = if eq(len(ts), 0) then "none" else if eq(len(tail(ts)), 0) then int_to_str(head(ts)) else mcs-cat(list(int_to_str(head(ts)), " ", mgl-tags-text(tail(ts))));
        def mgl-panel(b, rs, ms) {
            let a = print("");
            let c = print(mcs-cat(list("  mirror census — ", int_to_str(len(mcs-universe(b))), " names across ", int_to_str(len(mcs-mirror-names())), " mirrors, ", int_to_str(len(rs)), " disagreeing, ", int_to_str(ms), " ms")));
            let d = print(mcs-cat(list("  ", mcs-tally(rs))));
            let e = print(mcs-cat(list("  worst: ", mgl-worst(rs), " (", mgl-worst-verdict(rs), ")")));
            let f = print("");
            let g = print(mcs-lines(mcs-take(rs, MGLShown())));
            let h = print(mcs-cat(list("  arms nobody names (tag with a walker arm, no row, no manifest row): ", mgl-tags-text(mcs-orphan-tags(b)))));
            let i = print("  cross a seedgap name with those tags and the arm is found in one reading.");
            1;
        }

        // --- the rows -------------------------------------------------------------
        def mgl-note(r) = mcs-cat(list("mirrors standing and missing, in order ", mcs-join(mcs-mirror-names(), " "), ": ", mcs-mirror-line(mcs-r-mirrors(r), mcs-mirror-names()), "; wounds ", mcs-join(mcs-r-wounds(r), " ")));
        def mgl-row(r) = fgo-int(MGLDomain(), str_concat("mirror.", mcs-r-name(r)), mcs-r-text(r), mcs-r-drag(r), "drag", 0, "cpu-arena", "physical-live", MGLSource(), "live", MGLChannel(), mgl-note(r));
        def mgl-rows-of(rs, n) = if or(le(n, 0), eq(len(rs), 0)) then list() else cons(mgl-row(head(rs)), mgl-rows-of(tail(rs), sub(n, 1)));
        def mgl-int-row(id, label, value, unit, note) = fgo-int(MGLDomain(), id, label, value, unit, 0, "cpu-arena", "physical-live", MGLSource(), "live", MGLChannel(), note);
        def mgl-head-rows(b, rs, ms) = list(
            fgo-text(MGLDomain(), "mirror.worst", "the native the body cannot reach", mgl-worst(rs), "cpu-arena", "physical-live", MGLSource(), "live", MGLChannel(), "the name whose mirrors disagree most expensively. An armhush is first because it is a native already standing that every call walks past, paying a recipe's price in silence; a seedgap is second because all three siblings hold the meaning and the seed has no route, which is the reading that says GO LOOK before minting"),
            fgo-text(MGLDomain(), "mirror.worst-verdict", "what that name's worst wound is", mgl-worst-verdict(rs), "cpu-arena", "physical-live", MGLSource(), "live", MGLChannel(), "one of armhush, seedgap, tagclash, rowhush, fkcgap, siblinggap, siblinglone, manifestgap — or whole, rewrite, no-native-here when the name is well"),
            mgl-int-row("mirror.names", "names read across the mirrors", len(mcs-universe(b)), "names", "the union of every mirror that carries names: a name living in only one of them is exactly the reading worth having"),
            mgl-int-row("mirror.disagreeing", "names whose mirrors disagree", len(rs), "names", "every name carrying at least one wound; a name is ranked by its worst but counted under each"),
            mgl-int-row("mirror.armhush", "natives standing with no route", mcs-count-wound(rs, "armhush"), "names", "a walker arm whose tag no op table row names: the body cannot reach a native it already has. str_find wore this shape from 2026-07-01 to 2026-09-08"),
            mgl-int-row("mirror.seedgap", "natives all three siblings hold and the seed does not", mcs-count-wound(rs, "seedgap"), "names", "no row and no rewrite in the seed. Cross with mirror.orphan-arms before minting anything"),
            mgl-int-row("mirror.siblinggap", "seed natives a sibling kernel lost", mcs-count-wound(rs, "siblinggap"), "names", "a row and an arm in the seed, held by some siblings and not others: the four-way proof cannot close over a door the body actually runs"),
            mgl-int-row("mirror.orphan-arms", "walker arms nobody names", len(mcs-orphan-tags(b)), "tags", "tags the walker dispatches on that no row and no manifest row claims. Most are structural and belong to no name; when a native's every name-carrying mirror has gone, its arm falls in here"),
            mgl-int-row("mirror.read-ms", "the reading's own time", ms, "milliseconds", "wall time of the eight file reads and the whole-body judgement"));
        def mgl-give(b, rs, ms) = mgl-give-at(b, rs, ms, now_unix_ms());
        def mgl-give-at(b, rs, ms, now) = fgsr-give-at(MCSSensor(), now, fgo-observe-rows(append(mgl-head-rows(b, rs, ms), mgl-rows-of(rs, MGLShown())), now, 0), MCSCadenceMs());

        // --- read, judge, say, give: the whole movement in one door ----------------
        def mgl-witness(root, t0) = mgl-witness-read(mcs-live-at(root), t0);
        def mgl-witness-read(b, t0) = mgl-witness-ranked(b, mcs-ranked(b), sub(now_unix_ms(), t0));
        def mgl-witness-ranked(b, rs, ms) = mgl-witness-said(b, rs, ms, mgl-panel(b, rs, ms));
        def mgl-witness-said(b, rs, ms, said) = mgl-witness-given(rs, mgl-give(b, rs, ms));
        def mgl-witness-given(rs, given) = mgl-witness-told(rs, print(mcs-cat(list("  given to the glass: ", nth(given, 1), " ", nth(given, 2), " seq ", int_to_str(nth(given, 4))))));
        def mgl-witness-told(rs, told) = mgl-worst(rs);
    }
    0;
}
