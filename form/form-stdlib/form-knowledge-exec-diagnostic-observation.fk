; form-knowledge-exec-diagnostic-observation.fk -- retained readings from the
; preregistered exact-source-disjoint four-condition diagnostic.
;
; These rows separate executable semantics from grammar/style, source API
; grounding, transport, continuation, residence and cost.  No partial style
; movement becomes semantic credit.
;
; preludes: form-stdlib/core.fk
;
; Proven by: form-stdlib/tests/form-knowledge-exec-diagnostic-observation-band.fk

(do
    ; row = schema condition information continuation model adapter prompt-sha
    ;       response-sha prompt-tokens response-tokens elapsed-ms
    ;       preflight-errors semantic semantic-max form-syntax api-grounding
    ;       query execution-feedback same-residence http remote released failure
    (defn fkedo-row
        (condition information continuation model adapter prompt-sha response-sha
         prompt-tokens response-tokens elapsed preflight-errors semantic
         form-syntax api-grounding query feedback same-residence failure)
        (list "form-exec-diagnostic-observation-v1" condition information
            continuation model adapter prompt-sha response-sha prompt-tokens
            response-tokens elapsed preflight-errors semantic 511 form-syntax
            api-grounding query feedback same-residence 0 0 1 failure))
    (defn fkedo-condition (r) (nth r 1))
    (defn fkedo-information (r) (nth r 2))
    (defn fkedo-continuation (r) (nth r 3))
    (defn fkedo-model (r) (nth r 4))
    (defn fkedo-adapter (r) (nth r 5))
    (defn fkedo-prompt-sha (r) (nth r 6))
    (defn fkedo-response-sha (r) (nth r 7))
    (defn fkedo-prompt-tokens (r) (nth r 8))
    (defn fkedo-response-tokens (r) (nth r 9))
    (defn fkedo-elapsed-ms (r) (nth r 10))
    (defn fkedo-preflight-errors (r) (nth r 11))
    (defn fkedo-semantic (r) (nth r 12))
    (defn fkedo-semantic-max (r) (nth r 13))
    (defn fkedo-form-syntax (r) (nth r 14))
    (defn fkedo-api-grounding (r) (nth r 15))
    (defn fkedo-query (r) (nth r 16))
    (defn fkedo-feedback (r) (nth r 17))
    (defn fkedo-same-residence (r) (nth r 18))
    (defn fkedo-http (r) (nth r 19))
    (defn fkedo-remote (r) (nth r 20))
    (defn fkedo-released (r) (nth r 21))
    (defn fkedo-failure (r) (nth r 22))

    (defn fkedo-model-id ()
        "mlx-community/Llama-3.2-3B-Instruct-4bit@7f0dc925e0d0afb0322d96f9255cfddf2ba5636e")
    (defn fkedo-adapter-sha ()
        "4f4e7fdd66b1e9aeb6a3b4d3ced5f807f1cb6092250fb401288620fcc26810fc")
    (defn fkedo-closed-prompt-sha ()
        "c3870f18ea91f1bde46b52509c52ad2a67ff145ce165049539d3173f23481119")

    (defn fkedo-observations ()
        (list
            (fkedo-row "A-base-closed" "closed-book" "first-attempt"
                (fkedo-model-id) "" (fkedo-closed-prompt-sha)
                "1b68c5dcf48a5a145a3abd170ad2da4d77c6cb9b426067415c9de095bfa52798"
                274 120 942 41 0 0 0 0 0 1
                "foreign-grammar-invented-apis")
            (fkedo-row "B-base-current-source" "query-token-current-source"
                "first-attempt" (fkedo-model-id) ""
                "1654c2521a4cc4125c32b1a6abdc223cc60096f194e647c0bbd34e3ab8b9ec35"
                "a1173ffb3e2f449ded2790605858f1355219c86d8870f568fd22c288725db57f"
                596 135 1060 35 0 0 5 1 0 1
                "canonical-apis-grounded-foreign-grammar-zero-arg-lost")
            (fkedo-row "C-base-execution-repair" "query-token-current-source"
                "continuation-of-B-reloaded-residence" (fkedo-model-id) ""
                "ab786d26e282e2456276b15a0264115dad636aa561d2c33429eabb12d7c3730c"
                "be0141018021a0c4b316140f31da336b1a9e64e666b2afa7af63d9b13a2dd535"
                825 109 1030 33 0 0 5 1 1 0
                "format-repaired-foreign-grammar-and-zero-arg-still-lost")
            (fkedo-row "D-form-lora-closed" "closed-book" "first-attempt"
                (fkedo-model-id) (fkedo-adapter-sha) (fkedo-closed-prompt-sha)
                "cbd0cafadc16897b0e3d65cb12eb25689236de2908893893a7724744eb769eeb"
                274 18 409 4 0 1 0 0 0 1
                "valid-form-shape-incomplete-composition-wrong-arity")))

    (defn fkedo-all-released? (rows)
        (if (nil? rows) 1
            (if (and (eq (fkedo-released (head rows)) 1)
                     (and (eq (fkedo-http (head rows)) 0)
                          (eq (fkedo-remote (head rows)) 0)))
                (fkedo-all-released? (tail rows)) 0)))
    (defn fkedo-all-semantic-zero? (rows)
        (if (nil? rows) 1
            (if (eq (fkedo-semantic (head rows)) 0)
                (fkedo-all-semantic-zero? (tail rows)) 0)))
    (defn fkedo-next-question ()
        "can source-bound scannerless BMF grammar transport turn the grounded APIs into executable Form before model size or more families change")

    0)
