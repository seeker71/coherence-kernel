//////////////////////////////////////////////////////////////////////
//
// form-cli-rest-answer.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-restanswer.bml
//
// The answering half of the resting law, authored at altitude: a query
// surface splits to corpus-shaped tokens (one trailing ? stripped from
// the final word), locates through the corpus's own exact-match door —
// a lookup, never a classifier — and the fresh word comes home; the
// registry lane answers known surfaces with rest pointers. Unknown
// anything answers exact nothing. The .fk organ
// (knowledge-rest-answer.fk) is the earlier lowering and stays living;
// fra-agree() is the riseproof that surface and organ answer as one.
//
// Proven by: form-stdlib/tests/form-cli-rest-answer-bml-band.fk
//
// preludes: form-stdlib/knowledge-rest-answer.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormRestAnswerSurfaceAuthority {
        field RestAnswerSurfacePath = "form/form-stdlib/bml/form-cli-restanswer.bml";
        field RestAnswerSurfaceKind = "high-bml-class-template-field";
    }

    class FormRestAnswerSurface {
        ref fra-authority = FormRestAnswerSurfaceAuthority;
        thought fra-pattern = list("split", "locate", "fresh-word", "registry", "agree-with-organ");

        def fra-strip-q(w) {
            let n = str_len(w);
            if eq(n, 0) then w else if str_eq(substring(w, sub(n, 1), n), "?") then substring(w, 0, sub(n, 1)) else w;
        }
        def fra-split-tail(s, from, acc) {
            let w = substring(s, from, str_len(s));
            if eq(str_len(w), 0) then acc else cons(w, acc);
        }
        def fra-split-word(s, from, at, acc) {
            let w = substring(s, from, at);
            fra-split-loop(s, add(at, 1), if eq(str_len(w), 0) then acc else cons(w, acc));
        }
        def fra-split-loop(s, from, acc) {
            let at = str_find(s, " ", from);
            if lt(at, 0) then fra-split-tail(s, from, acc) else fra-split-word(s, from, at, acc);
        }
        def fra-rev(xs, acc) = if eq(len(xs), 0) then acc else fra-rev(tail(xs), cons(head(xs), acc));
        def fra-strip-last-go(r) = fra-rev(tail(r), list(fra-strip-q(head(r))));
        def fra-strip-last(ws) = if eq(len(ws), 0) then ws else fra-strip-last-go(fra-rev(ws, tail(list("x"))));
        def fra-split(s) = fra-strip-last(fra-rev(fra-split-loop(s, 0, tail(list("x"))), tail(list("x"))));

        def fra-corpus-word(q) {
            let mid = hdc-locate(fra-split(q));
            if eq(mid, 0) then nothing() else hdc-fresh(hdc-row-for-id(mid));
        }
        def fra-answer(q) = kra-find(kra-registry(), q);

        def fra-bit(ok, bit) = if ok then bit else 0;
        def fra-agree() {
            let q1 = "what names speech borrowed from a prior's tongue fluent and plausible that dies when the body executes it";
            let q2 = "what names an answer that sleeps as a recipe until need wakes it into data?";
            let c0 = fra-bit(str_eq(fra-corpus-word(q1), kra-corpus-word(q1)), 1);
            let c1 = fra-bit(str_eq(fra-corpus-word(q2), "restanswer"), 2);
            let c2 = fra-bit(eq(nothing?(fra-corpus-word("a question the corpus never held")), 1), 4);
            let c3 = fra-bit(eq(value_eq(fra-split("a b c?"), kra-split("a b c?")), 1), 8);
            let c4 = fra-bit(eq(lg-defer?(fra-answer("bootstrap/ground")), 1), 16);
            let c5 = fra-bit(eq(nothing?(fra-answer("unasked question")), 1), 32);
            add(c0, add(c1, add(c2, add(c3, add(c4, c5)))));
        }
    }
    0;
}
