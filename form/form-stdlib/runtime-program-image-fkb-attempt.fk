// runtime-program-image-fkb-attempt.fk -- supplied .fkb program-image attempt adapter.
//
// Layer 9h1 binds a request-ready program-image envelope, an admitted 8h6
// program-image byte admission, and a supplied program-image run row into the
// existing 9f supplied-attempt shape.
//
// This is not a binary loader or executor. It does not open artifacts, walk a
// program image, call native code, choose fallbacks, install a selector, or grow
// the C seed.
//
// preludes: form-stdlib/core.fk form-stdlib/source-artifact-cache.fk form-stdlib/source-artifact-descriptor.fk form-stdlib/runtime-artifact-plan.fk form-stdlib/runtime-artifact-selector.fk form-stdlib/runtime-artifact-outcome.fk form-stdlib/runtime-artifact-retry.fk form-stdlib/runtime-artifact-load-envelope.fk form-stdlib/runtime-artifact-attempt-receipt.fk form-stdlib/program-image-fkb.fk form-stdlib/program-image-fkb-byte-container.fk form-stdlib/program-image-fkb-byte-file-witness.fk form-stdlib/program-image-fkb-byte-decode.fk
section [form.bml] {
    def rpifa-version() = "runtime-program-image-fkb-attempt-v1";
    def rpifa-feature(name, status) = ["runtime-program-image-fkb-attempt-feature", name, status];
    def rpifa-feature-name(f) = f[1];
    def rpifa-feature-status(f) = f[2];
    def runtime-program-image-fkb-attempt-manifest() = [rpifa-feature("program-image-fkb-attempt-adapter-not-loader", 1), rpifa-feature("supplied-program-image-run-only", 1), rpifa-feature("binds-9e-8h6", 1), rpifa-feature("admission-row-shape-required", 1), rpifa-feature("admitted-status-and-reason-required", 1), rpifa-feature("decoded-admission-required", 1), rpifa-feature("valid-admitted-pif-required", 1), rpifa-feature("decode-payload-must-match-pif", 1), rpifa-feature("admission-pif-identity-required", 1), rpifa-feature("identity-from-rale-envelope", 1), rpifa-feature("run-path-bound-to-admitted-pif", 1), rpifa-feature("attempt-detail-marks-program-image-fkb", 1), rpifa-feature("ok-requires-output", 1), rpifa-feature("non-ok-statuses-preserved", 1), rpifa-feature("oom-killed-investigates-through-9c", 1), rpifa-feature("no-table-text-bridge", 1), rpifa-feature("no-fkb-artifact-io", 1), rpifa-feature("no-program-image-load", 1), rpifa-feature("no-native-call", 1), rpifa-feature("no-selector-install", 1), rpifa-feature("no-c-seed-growth", 1), rpifa-feature("future-real-9h-still-pending", 1)];
    def runtime-program-image-fkb-attempt-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) rpifa-feature-name(head(fs)) == name && (Comparable) rpifa-feature-status(head(fs)) == 1 ? 1 : runtime-program-image-fkb-attempt-manifest-has?(name, tail(fs));
    def rpifa-status-attempt-ready() = "attempt-ready";
    def rpifa-status-investigate() = "investigate";
    def rpifa-status-refused() = "refused";
    def rpifa-reason-program-image-run-bound() = "program-image-run-bound";
    def rpifa-reason-malformed-envelope() = "malformed-envelope";
    def rpifa-reason-non-program-image-envelope() = "non-program-image-envelope";
    def rpifa-reason-malformed-admission() = "malformed-admission";
    def rpifa-reason-non-admitted-admission() = "non-admitted-admission";
    def rpifa-reason-admission-decode-not-decoded() = "admission-decode-not-decoded";
    def rpifa-reason-admission-invalid-pif() = "admission-invalid-pif";
    def rpifa-reason-admission-decode-pif-mismatch() = "admission-decode-pif-mismatch";
    def rpifa-reason-artifact-identity-mismatch() = "artifact-identity-mismatch";
    def rpifa-reason-malformed-supplied-run() = "malformed-supplied-run";
    def rpifa-reason-negative-output() = "negative-output";
    def rpifa-reason-run-path-mismatch() = "run-path-mismatch";
    def rpifa-reason-empty-output() = "empty-output";
    def rpifa-reason-manifest() = [rpifa-reason-program-image-run-bound(), rpifa-reason-malformed-envelope(), rpifa-reason-non-program-image-envelope(), rpifa-reason-malformed-admission(), rpifa-reason-non-admitted-admission(), rpifa-reason-admission-decode-not-decoded(), rpifa-reason-admission-invalid-pif(), rpifa-reason-admission-decode-pif-mismatch(), rpifa-reason-artifact-identity-mismatch(), rpifa-reason-malformed-supplied-run(), rpifa-reason-negative-output(), rpifa-reason-run-path-mismatch(), rpifa-reason-empty-output()];
    def rpifa-marker() = "program-image-fkb-admission";
    // run = ("runtime-program-image-fkb-supplied-run" artifact-path first-value
    //        output-count exit-code status detail)
    def rpifa-supplied-run(artifact-path, first-value, output-count, exit-code, status, detail) = ["runtime-program-image-fkb-supplied-run", artifact-path, first-value, output-count, exit-code, status, detail];
    def rpifa-supplied-run?(run) = (Comparable) len(run) == 7 ? (String) run[0] == "runtime-program-image-fkb-supplied-run" : 0;
    def rpifa-run-path(run) = run[1];
    def rpifa-run-first-value(run) = run[2];
    def rpifa-run-output-count(run) = run[3];
    def rpifa-run-exit-code(run) = run[4];
    def rpifa-run-status(run) = run[5];
    def rpifa-run-detail(run) = run[6];
    // bridge = ("runtime-program-image-fkb-attempt-bridge" envelope admission
    //           run attempt status reason)
    def rpifa-bridge-receipt(envelope, admission, run, attempt, status, reason) = ["runtime-program-image-fkb-attempt-bridge", envelope, admission, run, attempt, status, reason];
    def rpifa-bridge?(b) = (Comparable) len(b) == 7 ? (String) b[0] == "runtime-program-image-fkb-attempt-bridge" : 0;
    def rpifa-bridge-envelope(b) = b[1];
    def rpifa-bridge-admission(b) = b[2];
    def rpifa-bridge-run(b) = b[3];
    def rpifa-bridge-attempt(b) = b[4];
    def rpifa-bridge-status(b) = b[5];
    def rpifa-bridge-reason(b) = b[6];
    def rpifa-no-attempt() = raar-no-attempt();
    def rpifa-no-attempt?(a) = raar-no-attempt?(a);
    def rpifa-investigate(envelope, admission, run, reason) = rpifa-bridge-receipt(envelope, admission, run, rpifa-no-attempt(), rpifa-status-investigate(), reason);
    def rpifa-refused(envelope, admission, run, reason) = rpifa-bridge-receipt(envelope, admission, run, rpifa-no-attempt(), rpifa-status-refused(), reason);
    def rpifa-program-image-envelope?(envelope) = rale-envelope?(envelope) ? (String) rale-envelope-status(envelope) == rale-status-request-ready() ? (String) rale-envelope-action(envelope) == rap-act-run-program-image() ? (Comparable) rale-envelope-route(envelope) == sac-run-fkb() ? (String) rale-envelope-artifact-kind(envelope) == sad-kind-program-image-fkb() : 0 : 0 : 0 : 0;
    def rpifa-admission-status-admitted?(admission) = pifbd-admission?(admission) ? (String) pifbd-admission-status(admission) == pifbd-status-admitted() && (String) pifbd-admission-reason(admission) == pifbd-reason-admitted() : 0;
    def rpifa-admission-decode-decoded?(admission) = pifbd-admission?(admission) ? pifbd-decoded?(pifbd-admission-decode(admission)) : 0;
    def rpifa-admission-pif-valid?(admission) = pifbd-admission?(admission) ? pif-envelope-valid?(pifbd-admission-pif(admission)) : 0;
    def rpifa-admission-decode-matches-pif?(admission) = rpifa-admission-decode-decoded?(admission) && rpifa-admission-pif-valid?(admission) ? {
        let payload = pifbd-decode-payload(pifbd-admission-decode(admission));
        let pif = pifbd-admission-pif(admission);
        pifbd-payload-source-matches-pif?(payload, pif) && (pifbd-payload-artifact-path-matches-pif?(payload, pif) && (pifbd-payload-seal-matches-pif?(payload, pif) && (pifbd-payload-table-matches-pif?(payload, pif) && pifbd-payload-symbol-matches-pif?(payload, pif))));
    } : 0;
    def rpifa-admission-ready?(admission) = pifbd-admission?(admission) && (rpifa-admission-status-admitted?(admission) && (rpifa-admission-decode-decoded?(admission) && (rpifa-admission-pif-valid?(admission) && rpifa-admission-decode-matches-pif?(admission))));
    def rpifa-admission-terminal-status(admission) = (String) pifbd-admission-status(admission) == pifbd-status-refused() ? rpifa-status-refused() : rpifa-status-investigate();
    def rpifa-terminal-admission(envelope, admission, run) = rpifa-bridge-receipt(envelope, admission, run, rpifa-no-attempt(), rpifa-admission-terminal-status(admission), rpifa-reason-non-admitted-admission());
    def rpifa-pif-matches-envelope?(envelope, pif) = pif-envelope-valid?(pif) ? (String) pif-envelope-artifact-path(pif) == rale-envelope-artifact-path(envelope) ? (String) pif-envelope-source-hash(pif) == rale-envelope-source-hash(envelope) ? (String) pif-envelope-content-hash(pif) == rale-envelope-content-hash(envelope) : 0 : 0 : 0;
    def rpifa-run-readable?(run) = rpifa-supplied-run?(run) ? str_len(rpifa-run-path(run)) > 0 : 0;
    def rpifa-run-output-valid?(run) = rpifa-supplied-run?(run) ? rpifa-run-output-count(run) >= 0 : 0;
    def rpifa-run-path-matches-pif?(run, pif) = (String) rpifa-run-path(run) == pif-envelope-artifact-path(pif);
    def rpifa-run-ok-empty-output?(run) = (String) rpifa-run-status(run) == rao-obs-ok() && (Comparable) rpifa-run-output-count(run) == 0;
    def rpifa-attempt-detail(run) = str_concat(rpifa-marker(), str_concat(" first=", str_concat(int_to_str(rpifa-run-first-value(run)), str_concat(" outputs=", str_concat(int_to_str(rpifa-run-output-count(run)), str_concat(" detail=", rpifa-run-detail(run)))))));
    def rpifa-attempt-from-run(envelope, run) = raar-supplied-attempt(rale-envelope-action(envelope), rale-envelope-route(envelope), rale-envelope-artifact-kind(envelope), rale-envelope-artifact-path(envelope), rale-envelope-source-hash(envelope), rale-envelope-content-hash(envelope), rpifa-run-status(run), rpifa-attempt-detail(run), rpifa-run-exit-code(run));
    def rpifa-attempt-ready(envelope, admission, run) = rpifa-bridge-receipt(envelope, admission, run, rpifa-attempt-from-run(envelope, run), rpifa-status-attempt-ready(), rpifa-reason-program-image-run-bound());
    def rpifa-bridge-from-run(envelope, admission, run) = !rale-envelope?(envelope) ? rpifa-refused(envelope, admission, run, rpifa-reason-malformed-envelope()) : !rpifa-program-image-envelope?(envelope) ? rpifa-investigate(envelope, admission, run, rpifa-reason-non-program-image-envelope()) : !pifbd-admission?(admission) ? rpifa-refused(envelope, admission, run, rpifa-reason-malformed-admission()) : !rpifa-admission-status-admitted?(admission) ? rpifa-terminal-admission(envelope, admission, run) : !rpifa-admission-decode-decoded?(admission) ? rpifa-refused(envelope, admission, run, rpifa-reason-admission-decode-not-decoded()) : !rpifa-admission-pif-valid?(admission) ? rpifa-refused(envelope, admission, run, rpifa-reason-admission-invalid-pif()) : !rpifa-admission-decode-matches-pif?(admission) ? rpifa-refused(envelope, admission, run, rpifa-reason-admission-decode-pif-mismatch()) : {
        let pif = pifbd-admission-pif(admission);
        !rpifa-pif-matches-envelope?(envelope, pif) ? rpifa-investigate(envelope, admission, run, rpifa-reason-artifact-identity-mismatch()) : !rpifa-run-readable?(run) ? rpifa-refused(envelope, admission, run, rpifa-reason-malformed-supplied-run()) : !rpifa-run-output-valid?(run) ? rpifa-refused(envelope, admission, run, rpifa-reason-negative-output()) : !rpifa-run-path-matches-pif?(run, pif) ? rpifa-investigate(envelope, admission, run, rpifa-reason-run-path-mismatch()) : rpifa-run-ok-empty-output?(run) ? rpifa-investigate(envelope, admission, run, rpifa-reason-empty-output()) : rpifa-attempt-ready(envelope, admission, run);
    };
}
