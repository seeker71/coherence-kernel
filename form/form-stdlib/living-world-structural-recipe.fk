; living-world-structural-recipe.fk -- behavior may grow opaque executable roles.
;
; This organ does not assign names such as subject/object, input/output, left,
; right, cause, or effect.  Participants may repeatedly relate one opaque
; coordinate cell to exact bindings at several current observation sites.
; Those relations may become a role only through recurrence and unanimous
; admission.  A differentiated hypothesis tissue may then reflect its exact
; compatible behavior through those admitted roles.  The old binding strings
; are used only at that bridge seam; they are not retained as role identity.
;
; A later executable codec maps each role to a safe local variable token.
; Codec surfaces remain separately offered and replaceable: distinct token
; sets may describe and execute the same structural carrier.  A codec or
; application never becomes active by derivation alone.  Exact target-scoped
; applications must recur through ordinary offers, and zero, one, or many may
; coexist.  Contradicted hypotheses, alternatives, unknowable remainder,
; dissent, silence, provenance, and revocation remain inspectable.
;
; Honest floor: the operator token still arrives through the existing minimal
; Form evaluator interface.  Its meaning here is the admitted behavior receipt
; and ordered opaque-role relation, not its surface string.
; witnessed: 2026-08-07 -> 32767
;
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk

(let LWSR-ROLE-OBSERVATION (bp "LWSR-ROLE-OBSERVATION"))
(let LWSR-ROLE-EVIDENCE    (bp "LWSR-ROLE-EVIDENCE"))
(let LWSR-EVIDENCE-SET     (bp "LWSR-EVIDENCE-SET"))
(let LWSR-ROLE             (bp "LWSR-ROLE"))
(let LWSR-ROLE-READY       (bp "LWSR-ROLE-READY"))
(let LWSR-ROLE-OPEN        (bp "LWSR-ROLE-OPEN"))
(let LWSR-ROLE-ORIGIN      (bp "LWSR-ROLE-ORIGIN"))
(let LWSR-ROLE-SEQUENCE    (bp "LWSR-ROLE-SEQUENCE"))
(let LWSR-CARRIER          (bp "LWSR-CARRIER"))
(let LWSR-SCHEMA           (bp "LWSR-SCHEMA"))
(let LWSR-SCHEMA-ORIGIN    (bp "LWSR-SCHEMA-ORIGIN"))
(let LWSR-CODEC            (bp "LWSR-CODEC"))
(let LWSR-VALUE            (bp "LWSR-VALUE"))
(let LWSR-APPLICATION      (bp "LWSR-APPLICATION"))
(let LWSR-EXECUTION        (bp "LWSR-EXECUTION"))

(defn lwsr-state (kind) (intern_node kind (empty)))
(defn lwsr-role-ready () (lwsr-state LWSR-ROLE-READY))
(defn lwsr-role-open () (lwsr-state LWSR-ROLE-OPEN))
(defn lwsr-role-ready? (status)
    (if (node_eq status (lwsr-role-ready)) 1 0))
(defn lwsr-role-open? (status)
    (if (node_eq status (lwsr-role-open)) 1 0))
(defn lwsr-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwsr-field-union-items (tail items)
            (lwo-field-add field (head items)))))

; --- arbitrary current sites ------------------------------------------

(defn lwsr-site? (site)
    (if (or (eq (lwph-example? site) 1)
            (eq (lwph-probe-candidate? site) 1)) 1 0))
(defn lwsr-site-bindings (site)
    (if (eq (lwph-example? site) 1)
        (lwph-example-bindings site)
        (lwph-probe-bindings
            (lwph-placement-probe (lwo-emergent-shape site)))))
(defn lwsr-site-enquiry (site)
    (if (eq (lwph-example? site) 1)
        (lwph-example-enquiry site)
        (lwph-field-enquiry
            (lwo-emergent-shape
                (lwph-placement-candidate
                    (lwo-emergent-shape site))))))
(defn lwsr-site-current? (world site enquiry)
    (if (eq (lwsr-site? site) 0) 0
        (if (not (node_eq (lwsr-site-enquiry site) enquiry)) 0
            (if (eq (lwph-example? site) 1)
                (lwph-example-current? world site enquiry)
                (lwph-probe-integrated-current? world site)))))
(defn lwsr-binding-in-items? (binding items)
    (if (eq (len items) 0) 0
        (if (node_eq binding (head items)) 1
            (lwsr-binding-in-items? binding (tail items)))))
(defn lwsr-binding-at-site? (site binding)
    (lwsr-binding-in-items? binding
        (lwre-binding-items (lwsr-site-bindings site))))

; --- offered coordinate-to-binding observations ----------------------

; children: enquiry, opaque coordinate, current example/placement site,
;           exact binding, ack, alternatives, optional unknown, evidence, path
(defn lwsr-role-observation
    (enquiry coordinate site binding ack alternatives unknown evidence)
    (intern_node LWSR-ROLE-OBSERVATION
        (list enquiry coordinate site binding ack alternatives unknown evidence
              (lwo-local-path))))
(defn lwsr-role-observation? (cell)
    (lwo-category? cell LWSR-ROLE-OBSERVATION))
(defn lwsr-role-observation-enquiry (observation)
    (nth (node_children observation) 0))
(defn lwsr-role-observation-coordinate (observation)
    (nth (node_children observation) 1))
(defn lwsr-role-observation-site (observation)
    (nth (node_children observation) 2))
(defn lwsr-role-observation-binding (observation)
    (nth (node_children observation) 3))
(defn lwsr-role-observation-ack (observation)
    (nth (node_children observation) 4))
(defn lwsr-role-observation-alternatives (observation)
    (nth (node_children observation) 5))
(defn lwsr-role-observation-unknown (observation)
    (nth (node_children observation) 6))
(defn lwsr-role-observation-evidence (observation)
    (nth (node_children observation) 7))
(defn lwsr-role-observation-path (observation)
    (nth (node_children observation) 8))
(defn lwsr-role-observation-valid? (observation)
    (if (eq (lwsr-role-observation? observation) 0) 0
        (if (eq (lwsr-site?
                    (lwsr-role-observation-site observation)) 0) 0
            (if (eq (lwre-binding-valid?
                        (lwsr-role-observation-binding observation)) 0) 0
                (if (eq (oac-valid-ack?
                            (lwsr-role-observation-ack observation)) 0) 0
                    (if (eq (lwo-category?
                                (lwsr-role-observation-alternatives observation)
                                LWO-FIELD) 0) 0
                        (lwph-optional-unknown-valid?
                            (lwsr-role-observation-unknown observation))))))))
(defn lwsr-role-observation-current? (world observation enquiry coordinate)
    (if (eq (lwsr-role-observation-valid? observation) 0) 0
        (if (not (node_eq
                    (lwsr-role-observation-enquiry observation) enquiry)) 0
            (if (not (node_eq
                        (lwsr-role-observation-coordinate observation)
                        coordinate)) 0
                (if (eq (lwo-active? world observation) 0) 0
                    (if (eq (lwo-active? world coordinate) 0) 0
                        (if (eq (lwsr-site-current? world
                                    (lwsr-role-observation-site observation)
                                    enquiry) 0) 0
                            (lwsr-binding-at-site?
                                (lwsr-role-observation-site observation)
                                (lwsr-role-observation-binding
                                    observation)))))))))

(defn lwsr-role-evidence (observation attributions)
    (intern_node LWSR-ROLE-EVIDENCE (list observation attributions)))
(defn lwsr-role-evidence? (cell)
    (lwo-category? cell LWSR-ROLE-EVIDENCE))
(defn lwsr-role-evidence-observation (evidence)
    (nth (node_children evidence) 0))
(defn lwsr-role-evidence-attributions (evidence)
    (nth (node_children evidence) 1))
(defn lwsr-evidence-set
    (supports alternatives dissents silences unresolved)
    (intern_node LWSR-EVIDENCE-SET
        (list supports alternatives dissents silences unresolved)))
(defn lwsr-evidence-set? (cell)
    (lwo-category? cell LWSR-EVIDENCE-SET))
(defn lwsr-evidence-supports (set) (nth (node_children set) 0))
(defn lwsr-evidence-alternatives (set) (nth (node_children set) 1))
(defn lwsr-evidence-dissents (set) (nth (node_children set) 2))
(defn lwsr-evidence-silences (set) (nth (node_children set) 3))
(defn lwsr-evidence-unresolved (set) (nth (node_children set) 4))

(defn lwsr-classify-role-evidence
    (observation evidence supports alternatives dissents silences unresolved)
    (do
        (let ack (lwsr-role-observation-ack observation))
        (if (eq (oac-one? ack) 1)
            (if (node_eq (oac-payload ack)
                    (lwsr-role-observation-binding observation))
                (lwsr-evidence-set (lwo-field-add supports evidence)
                    alternatives dissents silences unresolved)
                (lwsr-evidence-set supports
                    (lwo-field-add alternatives evidence)
                    dissents silences unresolved))
            (if (eq (oac-zero? ack) 1)
                (lwsr-evidence-set supports alternatives
                    (lwo-field-add dissents evidence) silences unresolved)
                (if (eq (oac-nothing? ack) 1)
                    (lwsr-evidence-set supports alternatives dissents
                        (lwo-field-add silences evidence) unresolved)
                    (if (eq (oac-alternative-ack? ack) 1)
                        (lwsr-evidence-set supports
                            (lwo-field-add alternatives evidence)
                            dissents silences unresolved)
                        (lwsr-evidence-set supports alternatives dissents
                            silences (lwo-field-add unresolved evidence))))))))
(defn lwsr-collect-role-evidence
    (world items enquiry coordinate supports alternatives dissents silences unresolved)
    (if (eq (len items) 0)
        (lwsr-evidence-set supports alternatives dissents silences unresolved)
        (do
            (let observation (head items))
            (if (eq (lwsr-role-observation-current?
                        world observation enquiry coordinate) 0)
                (lwsr-collect-role-evidence world (tail items)
                    enquiry coordinate supports alternatives dissents
                    silences unresolved)
                (do
                    (let classified
                        (lwsr-classify-role-evidence observation
                            (lwsr-role-evidence observation
                                (lwo-active-attributions-for
                                    world observation))
                            supports alternatives dissents silences unresolved))
                    (lwsr-collect-role-evidence world (tail items)
                        enquiry coordinate
                        (lwsr-evidence-supports classified)
                        (lwsr-evidence-alternatives classified)
                        (lwsr-evidence-dissents classified)
                        (lwsr-evidence-silences classified)
                        (lwsr-evidence-unresolved classified)))))))
(defn lwsr-role-evidence-for (world enquiry coordinate)
    (lwsr-collect-role-evidence world
        (lwo-field-items (lwo-world-cells world)) enquiry coordinate
        (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)
        (lwo-empty-field) (lwo-empty-field)))

(defn lwsr-evidence-attributions-items (items field)
    (if (eq (len items) 0) field
        (lwsr-evidence-attributions-items (tail items)
            (lwsr-field-union-items
                (lwo-field-items
                    (lwsr-role-evidence-attributions (head items))) field))))
(defn lwsr-all-evidence-attributions (set)
    (do
        (let supports
            (lwsr-evidence-attributions-items
                (lwo-field-items (lwsr-evidence-supports set))
                (lwo-empty-field)))
        (let alternatives
            (lwsr-evidence-attributions-items
                (lwo-field-items (lwsr-evidence-alternatives set)) supports))
        (let dissents
            (lwsr-evidence-attributions-items
                (lwo-field-items (lwsr-evidence-dissents set)) alternatives))
        (let silences
            (lwsr-evidence-attributions-items
                (lwo-field-items (lwsr-evidence-silences set)) dissents))
        (lwsr-evidence-attributions-items
            (lwo-field-items (lwsr-evidence-unresolved set)) silences)))
(defn lwsr-support-attributions (set)
    (lwsr-evidence-attributions-items
        (lwo-field-items (lwsr-evidence-supports set))
        (lwo-empty-field)))
(defn lwsr-support-sites-items (items field)
    (if (eq (len items) 0) field
        (lwsr-support-sites-items (tail items)
            (lwo-field-add field
                (lwsr-role-observation-site
                    (lwsr-role-evidence-observation (head items)))))))
(defn lwsr-support-bindings-items (items field)
    (if (eq (len items) 0) field
        (lwsr-support-bindings-items (tail items)
            (lwo-field-add field
                (lwsr-role-observation-binding
                    (lwsr-role-evidence-observation (head items)))))))
(defn lwsr-evidence-alternatives-items (items field)
    (if (eq (len items) 0) field
        (lwsr-evidence-alternatives-items (tail items)
            (lwsr-field-union-items
                (lwo-field-items
                    (lwsr-role-observation-alternatives
                        (lwsr-role-evidence-observation (head items))))
                field))))
(defn lwsr-evidence-unknowns-items (items field)
    (if (eq (len items) 0) field
        (do
            (let unknown
                (lwsr-role-observation-unknown
                    (lwsr-role-evidence-observation (head items))))
            (lwsr-evidence-unknowns-items (tail items)
                (if (node_eq unknown (lwo-none)) field
                    (lwo-field-add field unknown))))))
(defn lwsr-site-witnesses-items (world items field)
    (if (eq (len items) 0) field
        (do
            (let site (head items))
            (let with-site
                (lwsr-field-union-items
                    (lwo-field-items
                        (lwo-active-attributions-for world site)) field))
            (let with-emergent
                (if (eq (lwph-probe-candidate? site) 1)
                    (lwsr-field-union-items
                        (lwo-field-items (lwo-emergent-witnesses site))
                        with-site)
                    (lwsr-field-union-items
                        (lwo-field-items
                            (lwre-binding-witnesses world
                                (lwph-example-bindings site)))
                        with-site)))
            (lwsr-site-witnesses-items world (tail items) with-emergent))))

; children: enquiry, opaque coordinate, evidence classes, distinct sites and
;           bindings, state, alternatives, unknowns, witnesses, thresholds,path
(defn lwsr-role
    (enquiry coordinate evidence sites bindings status alternatives unknowns
     witnesses source-threshold site-threshold)
    (intern_node LWSR-ROLE
        (list enquiry coordinate evidence sites bindings status alternatives
              unknowns witnesses (intern_trivial_int source-threshold)
              (intern_trivial_int site-threshold) (lwo-local-path))))
(defn lwsr-role? (cell) (lwo-category? cell LWSR-ROLE))
(defn lwsr-role-enquiry (role) (nth (node_children role) 0))
(defn lwsr-role-coordinate (role) (nth (node_children role) 1))
(defn lwsr-role-evidence-set-cell (role) (nth (node_children role) 2))
(defn lwsr-role-sites (role) (nth (node_children role) 3))
(defn lwsr-role-bindings (role) (nth (node_children role) 4))
(defn lwsr-role-status (role) (nth (node_children role) 5))
(defn lwsr-role-alternatives (role) (nth (node_children role) 6))
(defn lwsr-role-unknowns (role) (nth (node_children role) 7))
(defn lwsr-role-witnesses (role) (nth (node_children role) 8))
(defn lwsr-role-source-threshold (role)
    (node_value (nth (node_children role) 9)))
(defn lwsr-role-site-threshold (role)
    (node_value (nth (node_children role) 10)))
(defn lwsr-role-path (role) (nth (node_children role) 11))

(defn lwsr-role-for
    (world enquiry coordinate source-threshold site-threshold)
    (if (or (le source-threshold 0)
            (or (le site-threshold 0)
                (or (eq (lwph-enquiry-current? world enquiry) 0)
                    (eq (lwo-active? world coordinate) 0)))) (lwo-none)
        (do
            (let evidence
                (lwsr-role-evidence-for world enquiry coordinate))
            (let support-items
                (lwo-field-items (lwsr-evidence-supports evidence)))
            (let sites
                (lwsr-support-sites-items support-items (lwo-empty-field)))
            (let bindings
                (lwsr-support-bindings-items support-items (lwo-empty-field)))
            (let support-attributions
                (lwsr-support-attributions evidence))
            (let support-sources
                (lwt-sources-from-attributions
                    (lwo-field-items support-attributions)
                    (lwo-empty-field)))
            (let status
                (if (and (ge (lwo-field-size support-sources)
                                source-threshold)
                         (and (ge (lwo-field-size sites) site-threshold)
                              (eq (lwo-field-size
                                    (lwsr-evidence-dissents evidence)) 0)))
                    (lwsr-role-ready) (lwsr-role-open)))
            (let alternatives
                (lwsr-evidence-alternatives-items
                    (append
                        (lwo-field-items
                            (lwsr-evidence-supports evidence))
                        (lwo-field-items
                            (lwsr-evidence-alternatives evidence)))
                    (lwo-empty-field)))
            (let unknowns
                (lwo-field-add
                    (lwsr-evidence-unknowns-items
                        (append
                            (lwo-field-items
                                (lwsr-evidence-supports evidence))
                            (lwo-field-items
                                (lwsr-evidence-unresolved evidence)))
                        (lwo-empty-field))
                    (lwlc-unknown evidence)))
            (let with-coordinate
                (lwsr-field-union-items
                    (lwo-field-items
                        (lwo-active-attributions-for world coordinate))
                    (lwsr-all-evidence-attributions evidence)))
            (let witnesses
                (lwsr-site-witnesses-items world
                    (lwo-field-items sites) with-coordinate))
            (lwsr-role enquiry coordinate evidence sites bindings status
                alternatives unknowns witnesses source-threshold
                site-threshold))))

(defn lwsr-role-origin
    (enquiry coordinate source-threshold site-threshold)
    (intern_node LWSR-ROLE-ORIGIN
        (list enquiry coordinate (intern_trivial_int source-threshold)
              (intern_trivial_int site-threshold) (lwo-local-path))))
(defn lwsr-role-origin-enquiry (origin) (nth (node_children origin) 0))
(defn lwsr-role-origin-coordinate (origin) (nth (node_children origin) 1))
(defn lwsr-role-origin-source-threshold (origin)
    (node_value (nth (node_children origin) 2)))
(defn lwsr-role-origin-site-threshold (origin)
    (node_value (nth (node_children origin) 3)))
(defn lwsr-role-proposal
    (world enquiry coordinate source-threshold site-threshold)
    (do
        (let role
            (lwsr-role-for world enquiry coordinate
                source-threshold site-threshold))
        (if (or (node_eq role (lwo-none))
                (eq (lwsr-role-ready? (lwsr-role-status role)) 0))
            (lwo-none)
            (do
                (let witnesses (lwsr-role-witnesses role))
                (let count (lwo-field-size witnesses))
                (let origin
                    (lwsr-role-origin enquiry coordinate
                        source-threshold site-threshold))
                (let candidate
                    (lwo-emergent role witnesses
                        (intern_trivial_int
                            (lwo-field-size (lwsr-role-sites role)))
                        (intern_trivial_int count)
                        (intern_trivial_int source-threshold) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwsr-role-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwsr-role?
                    (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwsr-role-candidate-current? (world candidate)
    (if (eq (lwsr-role-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            (let fresh
                (lwsr-role-proposal world
                    (lwsr-role-origin-enquiry origin)
                    (lwsr-role-origin-coordinate origin)
                    (lwsr-role-origin-source-threshold origin)
                    (lwsr-role-origin-site-threshold origin)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwsr-role-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwsr-role-candidate-current? world candidate) 1)) 1 0))
(defn lwsr-role-integrate (round proposal action)
    (if (eq (lwsr-role-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; --- compatible behavior reflected through opaque roles --------------

(defn lwsr-role-sequence (items)
    (intern_node LWSR-ROLE-SEQUENCE items))
(defn lwsr-role-sequence? (cell)
    (lwo-category? cell LWSR-ROLE-SEQUENCE))
(defn lwsr-role-items (sequence) (node_children sequence))
(defn lwsr-binding-name-in-items? (items name)
    (if (eq (len items) 0) 0
        (if (str_eq (lwre-binding-name (head items)) name) 1
            (lwsr-binding-name-in-items? (tail items) name))))
(defn lwsr-binding-name-in-role? (role name)
    (lwsr-binding-name-in-items?
        (lwo-field-items (lwsr-role-bindings role)) name))
(defn lwsr-roles-for-name (items name field)
    (if (eq (len items) 0) field
        (do
            (let candidate (head items))
            (let role (lwo-emergent-shape candidate))
            (lwsr-roles-for-name (tail items) name
                (if (eq (lwsr-binding-name-in-role? role name) 1)
                    (lwo-field-add field candidate) field)))))
(defn lwsr-one-role-for-name (roles name)
    (do
        (let matching
            (lwsr-roles-for-name
                (lwo-field-items roles) name (lwo-empty-field)))
        (if (eq (lwo-field-size matching) 1)
            (head (lwo-field-items matching)) (lwo-none))))

; children: compatible hypothesis, its operator cell, ordered opaque roles,
;           generated behavior receipt and local path
(defn lwsr-carrier (hypothesis operator roles receipt)
    (intern_node LWSR-CARRIER
        (list hypothesis operator roles receipt (lwo-local-path))))
(defn lwsr-carrier? (cell) (lwo-category? cell LWSR-CARRIER))
(defn lwsr-carrier-hypothesis (carrier) (nth (node_children carrier) 0))
(defn lwsr-carrier-operator (carrier) (nth (node_children carrier) 1))
(defn lwsr-carrier-roles (carrier) (nth (node_children carrier) 2))
(defn lwsr-carrier-receipt (carrier) (nth (node_children carrier) 3))
(defn lwsr-carrier-path (carrier) (nth (node_children carrier) 4))
(defn lwsr-receipt-for-hypothesis (items hypothesis)
    (if (eq (len items) 0) (lwo-none)
        (if (node_eq
                (lwht-receipt-hypothesis (head items)) hypothesis)
            (head items)
            (lwsr-receipt-for-hypothesis (tail items) hypothesis))))
(defn lwsr-carrier-for (tissue roles hypothesis)
    (do
        (let first
            (lwsr-one-role-for-name roles
                (lwph-hypothesis-left hypothesis)))
        (let second
            (lwsr-one-role-for-name roles
                (lwph-hypothesis-right hypothesis)))
        (if (or (node_eq first (lwo-none))
                (or (node_eq second (lwo-none))
                    (node_eq first second))) (lwo-none)
            (lwsr-carrier hypothesis
                (lwph-hypothesis-operator hypothesis)
                (lwsr-role-sequence (list first second))
                (lwsr-receipt-for-hypothesis
                    (lwo-field-items (lwht-tissue-receipts tissue))
                    hypothesis)))))
(defn lwsr-build-carriers (items tissue roles field)
    (if (eq (len items) 0) field
        (do
            (let carrier
                (lwsr-carrier-for tissue roles (head items)))
            (lwsr-build-carriers (tail items) tissue roles
                (if (node_eq carrier (lwo-none)) field
                    (lwo-field-add field carrier))))))
(defn lwsr-all-roles-current? (world items)
    (if (eq (len items) 0) 1
        (if (eq (lwsr-role-integrated-current?
                    world (head items)) 1)
            (lwsr-all-roles-current? world (tail items)) 0)))
(defn lwsr-role-candidate-witnesses (world items field)
    (if (eq (len items) 0) field
        (do
            (let candidate (head items))
            (let with-attributions
                (lwsr-field-union-items
                    (lwo-field-items
                        (lwo-active-attributions-for world candidate)) field))
            (lwsr-role-candidate-witnesses world (tail items)
                (lwsr-field-union-items
                    (lwo-field-items (lwo-emergent-witnesses candidate))
                    with-attributions)))))

; children: integrated tissue, admitted role field, carrier field,
;           alternatives, unknowns, witnesses, local path
(defn lwsr-schema
    (tissue roles carriers alternatives unknowns witnesses)
    (intern_node LWSR-SCHEMA
        (list tissue roles carriers alternatives unknowns witnesses
              (lwo-local-path))))
(defn lwsr-schema? (cell) (lwo-category? cell LWSR-SCHEMA))
(defn lwsr-schema-tissue (schema) (nth (node_children schema) 0))
(defn lwsr-schema-roles (schema) (nth (node_children schema) 1))
(defn lwsr-schema-carriers (schema) (nth (node_children schema) 2))
(defn lwsr-schema-alternatives (schema) (nth (node_children schema) 3))
(defn lwsr-schema-unknowns (schema) (nth (node_children schema) 4))
(defn lwsr-schema-witnesses (schema) (nth (node_children schema) 5))
(defn lwsr-schema-path (schema) (nth (node_children schema) 6))
(defn lwsr-schema-for (world tissue-candidate roles)
    (if (or (eq (lwht-integrated-current? world tissue-candidate) 0)
            (or (eq (lwo-category? roles LWO-FIELD) 0)
                (eq (lwsr-all-roles-current?
                        world (lwo-field-items roles)) 0))) (lwo-none)
        (do
            (let tissue (lwo-emergent-shape tissue-candidate))
            (let carriers
                (lwsr-build-carriers
                    (lwo-field-items (lwht-tissue-hypotheses tissue))
                    tissue roles (lwo-empty-field)))
            (let with-tissue
                (lwsr-field-union-items
                    (lwo-field-items
                        (lwo-active-attributions-for world tissue-candidate))
                    (lwo-emergent-witnesses tissue-candidate)))
            (let witnesses
                (lwsr-role-candidate-witnesses world
                    (lwo-field-items roles) with-tissue))
            (let alternatives
                (lwsr-field-union-items
                    (lwo-field-items carriers)
                    (lwht-tissue-alternatives tissue)))
            (let unknowns
                (lwo-field-add (lwht-tissue-unknowns tissue)
                    (lwlc-unknown carriers)))
            (lwsr-schema tissue-candidate roles carriers alternatives
                unknowns witnesses))))
(defn lwsr-schema-origin (tissue roles)
    (intern_node LWSR-SCHEMA-ORIGIN
        (list tissue roles (lwo-local-path))))
(defn lwsr-schema-origin-tissue (origin) (nth (node_children origin) 0))
(defn lwsr-schema-origin-roles (origin) (nth (node_children origin) 1))
(defn lwsr-schema-proposal (world tissue roles)
    (do
        (let schema (lwsr-schema-for world tissue roles))
        (if (or (node_eq schema (lwo-none))
                (eq (lwo-field-size (lwsr-schema-carriers schema)) 0))
            (lwo-none)
            (do
                (let witnesses (lwsr-schema-witnesses schema))
                (let count (lwo-field-size witnesses))
                (let origin (lwsr-schema-origin tissue roles))
                (let candidate
                    (lwo-emergent schema witnesses
                        (intern_trivial_int
                            (lwo-field-size
                                (lwsr-schema-carriers schema)))
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwsr-schema-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwsr-schema?
                    (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwsr-schema-candidate-current? (world candidate)
    (if (eq (lwsr-schema-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            (let fresh
                (lwsr-schema-proposal world
                    (lwsr-schema-origin-tissue origin)
                    (lwsr-schema-origin-roles origin)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwsr-schema-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwsr-schema-candidate-current? world candidate) 1)) 1 0))
(defn lwsr-schema-integrate (round proposal action)
    (if (eq (lwsr-schema-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; --- replaceable executable codec and exact application --------------

; children: admitted role, safe local token, alternatives, unknown,evidence,path
(defn lwsr-codec (role token alternatives unknown evidence)
    (intern_node LWSR-CODEC
        (list role (intern_trivial_string token) alternatives unknown evidence
              (lwo-local-path))))
(defn lwsr-codec? (cell) (lwo-category? cell LWSR-CODEC))
(defn lwsr-codec-role (codec) (nth (node_children codec) 0))
(defn lwsr-codec-token-cell (codec) (nth (node_children codec) 1))
(defn lwsr-codec-token (codec) (node_value (lwsr-codec-token-cell codec)))
(defn lwsr-codec-alternatives (codec) (nth (node_children codec) 2))
(defn lwsr-codec-unknown (codec) (nth (node_children codec) 3))
(defn lwsr-codec-evidence (codec) (nth (node_children codec) 4))
(defn lwsr-codec-path (codec) (nth (node_children codec) 5))
(defn lwsr-codec-valid? (codec)
    (if (eq (lwsr-codec? codec) 0) 0
        (if (eq (lwsr-role-candidate?
                    (lwsr-codec-role codec)) 0) 0
            (if (eq (lwph-source-name-safe?
                        (lwsr-codec-token codec)) 0) 0
                (if (eq (lwo-category?
                            (lwsr-codec-alternatives codec) LWO-FIELD) 0) 0
                    (lwph-optional-unknown-valid?
                        (lwsr-codec-unknown codec)))))))

; children: admitted role, current scoped projection, alternatives,
;           optional unknown, evidence, path
(defn lwsr-value (role projection alternatives unknown evidence)
    (intern_node LWSR-VALUE
        (list role projection alternatives unknown evidence
              (lwo-local-path))))
(defn lwsr-value? (cell) (lwo-category? cell LWSR-VALUE))
(defn lwsr-value-role (value) (nth (node_children value) 0))
(defn lwsr-value-projection (value) (nth (node_children value) 1))
(defn lwsr-value-alternatives (value) (nth (node_children value) 2))
(defn lwsr-value-unknown (value) (nth (node_children value) 3))
(defn lwsr-value-evidence (value) (nth (node_children value) 4))
(defn lwsr-value-path (value) (nth (node_children value) 5))
(defn lwsr-value-valid? (value)
    (if (eq (lwsr-value? value) 0) 0
        (if (eq (lwsr-role-candidate?
                    (lwsr-value-role value)) 0) 0
            (if (eq (lwre-projection-valid?
                        (lwsr-value-projection value)) 0) 0
                (if (eq (lwo-category?
                            (lwsr-value-alternatives value) LWO-FIELD) 0) 0
                    (lwph-optional-unknown-valid?
                        (lwsr-value-unknown value)))))))

(defn lwsr-codecs-for-role (items role field)
    (if (eq (len items) 0) field
        (lwsr-codecs-for-role (tail items) role
            (if (and (eq (lwsr-codec-valid? (head items)) 1)
                     (node_eq (lwsr-codec-role (head items)) role))
                (lwo-field-add field (head items)) field))))
(defn lwsr-values-for-role (items role field)
    (if (eq (len items) 0) field
        (lwsr-values-for-role (tail items) role
            (if (and (eq (lwsr-value-valid? (head items)) 1)
                     (node_eq (lwsr-value-role (head items)) role))
                (lwo-field-add field (head items)) field))))
(defn lwsr-one-codec-for-role (codecs role)
    (do
        (let matching
            (lwsr-codecs-for-role
                (lwo-field-items codecs) role (lwo-empty-field)))
        (if (eq (lwo-field-size matching) 1)
            (head (lwo-field-items matching)) (lwo-none))))
(defn lwsr-one-value-for-role (values role)
    (do
        (let matching
            (lwsr-values-for-role
                (lwo-field-items values) role (lwo-empty-field)))
        (if (eq (lwo-field-size matching) 1)
            (head (lwo-field-items matching)) (lwo-none))))
(defn lwsr-token-in-roles? (items codecs token)
    (if (eq (len items) 0) 0
        (do
            (let codec
                (lwsr-one-codec-for-role codecs (head items)))
            (if (and (not (node_eq codec (lwo-none)))
                     (str_eq (lwsr-codec-token codec) token)) 1
                (lwsr-token-in-roles? (tail items) codecs token)))))
(defn lwsr-application-complete-items? (remaining prior codecs values)
    (if (eq (len remaining) 0) 1
        (do
            (let role (head remaining))
            (let codec (lwsr-one-codec-for-role codecs role))
            (let value (lwsr-one-value-for-role values role))
            (if (or (node_eq codec (lwo-none))
                    (or (node_eq value (lwo-none))
                        (eq (lwsr-token-in-roles?
                                prior codecs (lwsr-codec-token codec)) 1))) 0
                (lwsr-application-complete-items? (tail remaining)
                    (append prior (list role)) codecs values)))))

; children: integrated schema, exact carrier, role codecs, role values,
;           before, alternatives, unknown, choice, timeout, evidence, path
(defn lwsr-application
    (schema carrier codecs values before alternatives unknown choice timeout
     evidence)
    (intern_node LWSR-APPLICATION
        (list schema carrier codecs values before alternatives unknown choice
              timeout evidence (lwo-local-path))))
(defn lwsr-application? (cell) (lwo-category? cell LWSR-APPLICATION))
(defn lwsr-application-schema (application) (nth (node_children application) 0))
(defn lwsr-application-carrier (application) (nth (node_children application) 1))
(defn lwsr-application-codecs (application) (nth (node_children application) 2))
(defn lwsr-application-values (application) (nth (node_children application) 3))
(defn lwsr-application-before (application) (nth (node_children application) 4))
(defn lwsr-application-alternatives (application)
    (nth (node_children application) 5))
(defn lwsr-application-unknown (application) (nth (node_children application) 6))
(defn lwsr-application-choice (application) (nth (node_children application) 7))
(defn lwsr-application-timeout (application) (nth (node_children application) 8))
(defn lwsr-application-evidence (application) (nth (node_children application) 9))
(defn lwsr-application-path (application) (nth (node_children application) 10))
(defn lwsr-application-shape-valid? (application)
    (if (eq (lwsr-application? application) 0) 0
        (if (eq (lwsr-schema-candidate?
                    (lwsr-application-schema application)) 0) 0
            (if (eq (lwsr-carrier?
                        (lwsr-application-carrier application)) 0) 0
                (if (or (eq (lwo-category?
                                (lwsr-application-codecs application)
                                LWO-FIELD) 0)
                        (eq (lwo-category?
                                (lwsr-application-values application)
                                LWO-FIELD) 0)) 0
                    (if (node_eq
                            (lwsr-application-before application)
                            (lwo-none)) 0
                        (if (eq (lwo-category?
                                    (lwsr-application-alternatives application)
                                    LWO-FIELD) 0) 0
                            (if (eq (lwph-optional-unknown-valid?
                                        (lwsr-application-unknown
                                            application)) 0) 0
                                (if (eq (lwlc-choice-valid?
                                            (lwsr-application-choice
                                                application)) 0) 0
                                    (lwac-optional-timeout-valid?
                                        (lwsr-application-timeout
                                            application)))))))))))
(defn lwsr-codec-current? (world codec role)
    (if (and (eq (lwsr-codec-valid? codec) 1)
             (and (node_eq (lwsr-codec-role codec) role)
                  (and (eq (lwo-active? world codec) 1)
                       (eq (lwsr-role-integrated-current?
                              world role) 1)))) 1 0))
(defn lwsr-value-current? (world value role)
    (if (and (eq (lwsr-value-valid? value) 1)
             (and (node_eq (lwsr-value-role value) role)
                  (and (eq (lwo-active? world value) 1)
                       (and (eq (lwsr-role-integrated-current?
                                  world role) 1)
                            (eq (lwre-projection-current? world
                                  (lwsr-value-projection value)) 1))))) 1 0))
(defn lwsr-application-parts-current? (world items codecs values)
    (if (eq (len items) 0) 1
        (do
            (let role (head items))
            (if (and (eq (lwsr-codec-current? world
                             (lwsr-one-codec-for-role codecs role) role) 1)
                     (eq (lwsr-value-current? world
                             (lwsr-one-value-for-role values role) role) 1))
                (lwsr-application-parts-current?
                    world (tail items) codecs values) 0))))
(defn lwsr-application-current? (world application threshold)
    (if (or (le threshold 0)
            (eq (lwsr-application-shape-valid? application) 0)) 0
        (do
            (let schema-candidate (lwsr-application-schema application))
            (let schema (lwo-emergent-shape schema-candidate))
            (let carrier (lwsr-application-carrier application))
            (let role-items
                (lwsr-role-items (lwsr-carrier-roles carrier)))
            (if (or (eq (lwsr-schema-integrated-current?
                            world schema-candidate) 0)
                    (or (eq (lwo-field-has?
                                (lwsr-schema-carriers schema) carrier) 0)
                        (or (eq (lwo-active? world application) 0)
                            (or (lt (lwph-active-source-count
                                      world application) threshold)
                                (or (eq (lwo-active? world
                                          (lwsr-application-before
                                            application)) 0)
                                    (or (eq (lwsr-application-complete-items?
                                              role-items (list)
                                              (lwsr-application-codecs
                                                application)
                                              (lwsr-application-values
                                                application)) 0)
                                        (eq (lwsr-application-parts-current?
                                              world role-items
                                              (lwsr-application-codecs
                                                application)
                                              (lwsr-application-values
                                                application)) 0))))))) 0 1))))

(defn lwsr-source-role-items (items codecs source)
    (if (eq (len items) 0) source
        (do
            (let codec
                (lwsr-one-codec-for-role codecs (head items)))
            (lwsr-source-role-items (tail items) codecs
                (str_concat source
                    (str_concat " " (lwsr-codec-token codec)))))))
(defn lwsr-source-for (carrier codecs)
    (str_concat
        (lwsr-source-role-items
            (lwsr-role-items (lwsr-carrier-roles carrier)) codecs
            (str_concat "("
                (lwph-operator-token
                    (lwsr-carrier-operator carrier))))
        ")"))
(defn lwsr-bindings-items (items codecs values bindings)
    (if (eq (len items) 0) bindings
        (do
            (let role (head items))
            (let codec (lwsr-one-codec-for-role codecs role))
            (let value (lwsr-one-value-for-role values role))
            (let projection (lwsr-value-projection value))
            (lwsr-bindings-items (tail items) codecs values
                (append bindings
                    (list
                        (lwre-projected-binding
                            (lwsr-codec-token codec) projection value)))))))
(defn lwsr-bindings-for (carrier codecs values)
    (lwre-bindings
        (lwsr-bindings-items
            (lwsr-role-items (lwsr-carrier-roles carrier))
            codecs values (list))))
(defn lwsr-recipe-for (carrier codecs)
    (lwre-recipe (lwsr-source-for carrier codecs)
        (lwre-bound-form-contract 128 carrier) carrier))
(defn lwsr-application-time-observation (application observed-time)
    (if (or (node_eq
              (lwsr-application-timeout application) (lwo-none))
            (node_eq observed-time (lwo-none))) (lwo-none)
        (oac-timeout-condense
            (lwsr-application-timeout application) observed-time)))
(defn lwsr-codec-value-witnesses (world items field)
    (if (eq (len items) 0) field
        (do
            (let item (head items))
            (let with-item
                (lwsr-field-union-items
                    (lwo-field-items
                        (lwo-active-attributions-for world item)) field))
            (let with-projection
                (if (eq (lwsr-value? item) 0) with-item
                    (do
                        (let projection (lwsr-value-projection item))
                        (let with-cell
                            (lwsr-field-union-items
                                (lwo-field-items
                                    (lwo-active-attributions-for
                                        world projection)) with-item))
                        (let with-scope
                            (lwsr-field-union-items
                                (lwo-field-items
                                    (lwo-active-attributions-for world
                                        (lwre-projection-scope projection)))
                                with-cell))
                        (lwsr-field-union-items
                            (lwo-field-items
                                (lwo-active-attributions-for world
                                    (lwre-projection-source projection)))
                            with-scope))))
            (lwsr-codec-value-witnesses
                world (tail items) with-projection))))
(defn lwsr-application-witnesses (world application)
    (do
        (let schema (lwsr-application-schema application))
        (let with-schema
            (lwsr-field-union-items
                (lwo-field-items (lwo-active-attributions-for world schema))
                (lwo-emergent-witnesses schema)))
        (let with-application
            (lwsr-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world application))
                with-schema))
        (let with-codecs
            (lwsr-codec-value-witnesses world
                (lwo-field-items
                    (lwsr-application-codecs application))
                with-application))
        (let with-values
            (lwsr-codec-value-witnesses world
                (lwo-field-items
                    (lwsr-application-values application))
                with-codecs))
        (lwsr-field-union-items
            (lwo-field-items
                (lwo-active-attributions-for world
                    (lwsr-application-before application)))
            with-values)))

; children: exact application, generated Recipe/bindings, numeric output,
;           immediate ack, optional separate time observation, witnesses,
;           observed time, threshold, local path
(defn lwsr-execution
    (application recipe bindings output immediate time witnesses observed-time
     threshold)
    (intern_node LWSR-EXECUTION
        (list application recipe bindings output immediate time witnesses
              observed-time (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwsr-execution? (cell) (lwo-category? cell LWSR-EXECUTION))
(defn lwsr-execution-application (execution) (nth (node_children execution) 0))
(defn lwsr-execution-recipe (execution) (nth (node_children execution) 1))
(defn lwsr-execution-bindings (execution) (nth (node_children execution) 2))
(defn lwsr-execution-output (execution) (nth (node_children execution) 3))
(defn lwsr-execution-immediate (execution) (nth (node_children execution) 4))
(defn lwsr-execution-time (execution) (nth (node_children execution) 5))
(defn lwsr-execution-witnesses (execution) (nth (node_children execution) 6))
(defn lwsr-execution-observed-time (execution) (nth (node_children execution) 7))
(defn lwsr-execution-threshold (execution)
    (node_value (nth (node_children execution) 8)))
(defn lwsr-execution-path (execution) (nth (node_children execution) 9))
(defn lwsr-execution-for (world application threshold observed-time)
    (if (eq (lwsr-application-current?
                world application threshold) 0) (lwo-none)
        (do
            (let carrier (lwsr-application-carrier application))
            (let codecs (lwsr-application-codecs application))
            (let values (lwsr-application-values application))
            (let recipe (lwsr-recipe-for carrier codecs))
            (let bindings (lwsr-bindings-for carrier codecs values))
            (let output
                (intern_trivial_int
                    (lwre-evaluate-bound recipe bindings)))
            (lwsr-execution application recipe bindings output
                (oac-one output)
                (lwsr-application-time-observation
                    application observed-time)
                (lwsr-application-witnesses world application)
                observed-time threshold))))
(defn lwsr-execution-current? (world execution)
    (if (eq (lwsr-execution? execution) 0) 0
        (if (node_eq execution
                (lwsr-execution-for world
                    (lwsr-execution-application execution)
                    (lwsr-execution-threshold execution)
                    (lwsr-execution-observed-time execution))) 1 0)))

0
