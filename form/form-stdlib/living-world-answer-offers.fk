; living-world-answer-offers.fk -- an answer may return another possibility.
;
; ONE, ZERO, immediate NOTHING, and timed outcomes do not exhaust a living
; answer. A current question holder may offer an explicit OAC-ALTERNATIVE
; through NODE, or may offer a completed OAC-TIME-OUTCOME whose condensed ack
; is the sender's declared default (or NOTHING when no default was declared).
;
; These offers do not alter a route or silently win a contention. They form
; successor answer proposals governed by every current question holder. Each
; successor retains the earlier answer, original routes and uncertainties,
; exact stance attributions, alternative or timeout contract, effective ack,
; and local path. Revoking the originating stance makes an acknowledged
; successor stale. Timeout history therefore cannot collapse into immediate
; silence, and an alternative remains a proposal rather than imported truth.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-enquiry.fk form-stdlib/living-world-enquiry-answer.fk form-stdlib/living-world-contention-tending.fk

(let LWAO-ALTERNATIVE (bp "LWAO-ALTERNATIVE"))
(let LWAO-TIMED       (bp "LWAO-TIMED"))
(let LWAO-EVIDENCE    (bp "LWAO-EVIDENCE"))
(let LWAO-ANSWER      (bp "LWAO-ANSWER"))
(let LWAO-ORIGIN      (bp "LWAO-ORIGIN"))

(defn lwao-alternative-kind ()
    (intern_node LWAO-ALTERNATIVE (empty)))
(defn lwao-timed-kind ()
    (intern_node LWAO-TIMED (empty)))

(defn lwao-stance-eligible? (world stance)
    (if (and (eq (lwctd-stance-valid? world stance) 1)
             (or (eq (lwctd-stance-timed? stance) 1)
                 (eq (lwctd-stance-alternative? stance) 1))) 1 0))

; Timed alternatives remain timed: their effective alternative ack is retained
; inside the outcome, but the expiry contract is the history that keys them.
(defn lwao-kind-for-stance (stance)
    (if (eq (lwctd-stance-timed? stance) 1)
        (lwao-timed-kind) (lwao-alternative-kind)))

(defn lwao-key-for-stance (stance)
    (if (eq (lwctd-stance-timed? stance) 1)
        (lwctd-stance-offered-evidence stance)
        (oac-alternative-offered
            (oac-payload (lwctd-stance-ack stance)))))

(defn lwao-valid-attributions-items (world items question acc)
    (if (eq (len items) 0) acc
        (do
            (let attribution (head items))
            (let source (lwo-attribution-source attribution))
            (lwao-valid-attributions-items world (tail items) question
                (if (eq (lwo-active-by? world question source) 1)
                    (lwo-field-add acc attribution) acc)))))

(defn lwao-valid-attributions (world stance question)
    (lwao-valid-attributions-items world
        (lwo-field-items (lwo-active-attributions-for world stance))
        question (lwo-empty-field)))

(defn lwao-evidence (stance attributions)
    (intern_node LWAO-EVIDENCE (list stance attributions)))
(defn lwao-evidence-stance (evidence)
    (nth (node_children evidence) 0))
(defn lwao-evidence-attributions (evidence)
    (nth (node_children evidence) 1))

(defn lwao-same-offer? (first second)
    (if (and (node_eq (lwao-kind-for-stance first)
                      (lwao-kind-for-stance second))
             (node_eq (lwao-key-for-stance first)
                      (lwao-key-for-stance second))) 1 0))

(defn lwao-evidence-items (world items seed question acc)
    (if (eq (len items) 0) acc
        (do
            (let stance (head items))
            (if (and (eq (lwao-stance-eligible? world stance) 1)
                     (and (node_eq
                            (lwctd-stance-question stance) question)
                          (eq (lwao-same-offer? stance seed) 1)))
                (do
                    (let attributions
                        (lwao-valid-attributions world stance question))
                    (lwao-evidence-items world (tail items) seed question
                        (if (eq (lwo-field-size attributions) 0) acc
                            (lwo-field-add acc
                                (lwao-evidence stance attributions)))))
                (lwao-evidence-items world (tail items)
                    seed question acc)))))

(defn lwao-evidence-for (world seed)
    (lwao-evidence-items world
        (lwo-field-items (lwo-world-cells world)) seed
        (lwctd-stance-question seed) (lwo-empty-field)))

(defn lwao-prior-answer-items (world items question)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let candidate (head items))
            (if (and (eq (lwen-answer-candidate? candidate) 1)
                     (and (eq (lwo-active? world candidate) 1)
                          (and (eq (lwen-answer-current?
                                       world candidate) 1)
                               (node_eq
                                (lwen-answer-question-candidate
                                    (lwo-emergent-shape candidate))
                                question))))
                candidate
                (lwao-prior-answer-items
                    world (tail items) question)))))

(defn lwao-prior-answer (world question)
    (lwao-prior-answer-items world
        (lwo-field-items (lwo-world-cells world)) question))

(defn lwao-evidence-witnesses-items (items acc)
    (if (eq (len items) 0) acc
        (lwao-evidence-witnesses-items (tail items)
            (lwr-field-union-items
                (lwo-field-items
                    (lwao-evidence-attributions (head items))) acc))))

(defn lwao-witnesses (world question prior evidence)
    (lwao-evidence-witnesses-items
        (lwo-field-items evidence)
        (lwr-field-union-items
            (lwo-field-items
                (lwo-active-attributions-for world prior))
            (lwo-active-attributions-for world question))))

(defn lwao-ack-for (kind question key evidence)
    (if (node_eq kind (lwao-timed-kind))
        (oac-time-outcome-ack key)
        (oac-alternative-ack question key evidence)))

(defn lwao-output-from-ack (ack)
    (if (eq (oac-one? ack) 1)
        (do
            (let payload (oac-payload ack))
            (if (eq (lwen-route? payload) 1)
                (lwen-route-output payload) payload))
        (if (eq (oac-alternative-ack? ack) 1)
            (oac-alternative-offered (oac-payload ack))
            (if (eq (oac-node? ack) 1)
                (oac-payload ack) (lwo-none)))))

; children: prior answer, question, answer kind, output, effective ack,
;           offered key/timeout outcome, complete stance evidence,
;           original routes, prior uncertainty, local path
(defn lwao-answer (prior question kind key evidence)
    (do
        (let prior-shape (lwo-emergent-shape prior))
        (let ack (lwao-ack-for kind question key evidence))
        (intern_node LWAO-ANSWER
            (list prior question kind (lwao-output-from-ack ack) ack key
                  evidence (lwen-answer-alternatives prior-shape)
                  (lwen-answer-uncertainties prior-shape)
                  (lwo-local-path)))))
(defn lwao-answer? (cell) (lwo-category? cell LWAO-ANSWER))
(defn lwao-answer-prior (answer) (nth (node_children answer) 0))
(defn lwao-answer-question (answer) (nth (node_children answer) 1))
(defn lwao-answer-kind (answer) (nth (node_children answer) 2))
(defn lwao-answer-output (answer) (nth (node_children answer) 3))
(defn lwao-answer-ack (answer) (nth (node_children answer) 4))
(defn lwao-answer-key (answer) (nth (node_children answer) 5))
(defn lwao-answer-evidence (answer) (nth (node_children answer) 6))
(defn lwao-answer-alternatives (answer) (nth (node_children answer) 7))
(defn lwao-answer-uncertainties (answer) (nth (node_children answer) 8))
(defn lwao-answer-path (answer) (nth (node_children answer) 9))

(defn lwao-origin (answer witnesses)
    (intern_node LWAO-ORIGIN (list answer witnesses)))

(defn lwao-proposal (world seed)
    (if (or (eq (lwao-stance-eligible? world seed) 0)
            (eq (lwo-active? world seed) 0)) (lwo-none)
        (do
            (let question (lwctd-stance-question seed))
            (let prior (lwao-prior-answer world question))
            (if (node_eq prior (lwo-none)) (lwo-none)
                (do
                    (let evidence (lwao-evidence-for world seed))
                    (if (eq (lwo-field-size evidence) 0) (lwo-none)
                        (do
                            (let kind (lwao-kind-for-stance seed))
                            (let key (lwao-key-for-stance seed))
                            (let witnesses
                                (lwao-witnesses
                                    world question prior evidence))
                            (let answer
                                (lwao-answer prior question
                                    kind key evidence))
                            (let origin (lwao-origin answer witnesses))
                            (let candidate
                                (lwo-emergent answer witnesses
                                    (intern_trivial_int
                                        (lwo-field-size evidence))
                                    (intern_trivial_int 1)
                                    (intern_trivial_int
                                        (lwo-field-size witnesses)) origin))
                            (lwt-proposal candidate
                                (lwctd-question-sources world question)
                                origin))))))))

(defn lwao-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwao-answer?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwao-current? (world candidate)
    (if (eq (lwao-candidate? candidate) 0) 0
        (do
            (let answer (lwo-emergent-shape candidate))
            (let evidence (lwao-answer-evidence answer))
            (if (eq (lwo-field-size evidence) 0) 0
                (do
                    (let seed
                        (lwao-evidence-stance
                            (head (lwo-field-items evidence))))
                    (let fresh (lwao-proposal world seed))
                    (if (node_eq fresh (lwo-none)) 0
                        (node_eq candidate
                            (lwt-proposal-candidate fresh))))))))

(defn lwao-steady? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwao-current? world candidate) 1)) 1 0))

(defn lwao-active-for-key-items? (world items question kind key)
    (if (eq (len items) 0) 0
        (do
            (let candidate (head items))
            (if (and (eq (lwao-candidate? candidate) 1)
                     (and (eq (lwao-steady? world candidate) 1)
                          (do
                            (let answer (lwo-emergent-shape candidate))
                            (and (node_eq
                                    (lwao-answer-question answer) question)
                                 (and (node_eq
                                        (lwao-answer-kind answer) kind)
                                      (node_eq
                                        (lwao-answer-key answer) key))))))
                1
                (lwao-active-for-key-items? world (tail items)
                    question kind key)))))

(defn lwao-active-for-key? (world question kind key)
    (lwao-active-for-key-items? world
        (lwo-field-items (lwo-world-cells world)) question kind key))

(defn lwao-proposals-items (world items acc)
    (if (eq (len items) 0) acc
        (do
            (let seed (head items))
            (if (eq (lwao-stance-eligible? world seed) 0)
                (lwao-proposals-items world (tail items) acc)
                (do
                    (let question (lwctd-stance-question seed))
                    (let kind (lwao-kind-for-stance seed))
                    (let key (lwao-key-for-stance seed))
                    (let proposal (lwao-proposal world seed))
                    (lwao-proposals-items world (tail items)
                        (if (or (eq (lwao-active-for-key?
                                        world question kind key) 1)
                                (node_eq proposal (lwo-none))) acc
                            (lwo-field-add acc proposal))))))))

(defn lwao-proposals (world)
    (lwao-proposals-items world
        (lwo-field-items (lwo-world-cells world)) (lwo-empty-field)))

(defn lwao-integrate (round proposal action)
    (do
        (let candidate (lwt-proposal-candidate proposal))
        (if (eq (lwao-current? (lwt-round-world round) candidate) 0)
            (lwt-round (lwt-round-world round) (lwt-round-proposals round)
                (lwo-field-add (lwo-empty-field)
                    (lwt-evaluate-proposal
                        (lwt-round-world round) proposal)) round)
            (lwt-integrate round proposal action))))
