; form-cli-route-record-evidence-image-call.fk -- correlate one already parsed
; concept route reference with one already parsed source row as admitted image
; data.
;
; Scannerless request birth cannot honestly share this image yet.  The landed
; CALL_BINDING executor uses the compact fcatw surface: ARG, NTH, STRING,
; STR_EQ, INT_EQ, NODE_EQ, and MUL.  It has no STR_FIND, SUBSTRING, CONCAT,
; conditional, or NodeID construction.  The larger rpmw walker has those
; meanings, but it is not the executor behind fpcp OFFER/ACK.  This cell does
; not widen either evaluator and does not add a query-stage tag.
;
; The image receives twenty typed values.  Three validity flags retain the
; upstream scanner/request, route-reference parse, and source-record parse
; verdicts.  It then independently correlates the meanings those parsers
; exposed: exact schemas, request kind and route presence, request key, family,
; path, source-content key, entry-content key, route-key membership, and the
; source NodeID held by the entry.  Thus a single offered "valid" flag cannot
; admit crossed evidence.
;
; A standard fpcp receipt retains its exact ACK.  fcrrei-status deterministically
; interprets that retained evidence without replacing it: returned integer 1
; is admitted; a valid disagreement is refusal; route-present 0 is nothing;
; a zero validity flag is failure; protocol choice/refusal/nothing/failure and
; walker timeout remain their exact outer states.  Present integer 0 therefore
; never becomes absence.
;
; This cell is pure Form.  It has no filesystem, process, model, Metal, HTTP,
; C, flattening, fixed operation table, or global function table authority.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-program-image-call-protocol.fk
; Proven by: form-stdlib/tests/form-cli-route-record-evidence-image-call-band.fk

(do
    (defn fcrrei-fuel () 95)

    (defn fcrrei-kinds ()
        (list
            (fcatw-kind-int) (fcatw-kind-string) (fcatw-kind-string)
            (fcatw-kind-int) (fcatw-kind-int)
            (fcatw-kind-string) (fcatw-kind-string)
            (fcatw-kind-string) (fcatw-kind-string)
            (fcatw-kind-string) (fcatw-kind-string)
            (fcatw-kind-int)
            (fcatw-kind-string) (fcatw-kind-string)
            (fcatw-kind-string) (fcatw-kind-string)
            (fcatw-kind-string)
            (fcatw-kind-int) (fcatw-kind-node) (fcatw-kind-node)))

    ; Node 0 is ARG.  For input i, node 1+2i is literal i and node 2+2i is
    ; NTH(ARG,i).  Nodes 41..43 are string literals, 44..57 are predicates,
    ; and 58..70 multiply every exact predicate into the final present 0/1.
    (defn fcrrei-image ()
        (fcatw-image (fcrrei-kinds)
            (list
                (fcatw-row 2 0 0 0)
                (fcatw-row 1 0 0 0)  (fcatw-row 23 0 1 0)
                (fcatw-row 1 1 0 0)  (fcatw-row 23 0 3 0)
                (fcatw-row 1 2 0 0)  (fcatw-row 23 0 5 0)
                (fcatw-row 1 3 0 0)  (fcatw-row 23 0 7 0)
                (fcatw-row 1 4 0 0)  (fcatw-row 23 0 9 0)
                (fcatw-row 1 5 0 0)  (fcatw-row 23 0 11 0)
                (fcatw-row 1 6 0 0)  (fcatw-row 23 0 13 0)
                (fcatw-row 1 7 0 0)  (fcatw-row 23 0 15 0)
                (fcatw-row 1 8 0 0)  (fcatw-row 23 0 17 0)
                (fcatw-row 1 9 0 0)  (fcatw-row 23 0 19 0)
                (fcatw-row 1 10 0 0) (fcatw-row 23 0 21 0)
                (fcatw-row 1 11 0 0) (fcatw-row 23 0 23 0)
                (fcatw-row 1 12 0 0) (fcatw-row 23 0 25 0)
                (fcatw-row 1 13 0 0) (fcatw-row 23 0 27 0)
                (fcatw-row 1 14 0 0) (fcatw-row 23 0 29 0)
                (fcatw-row 1 15 0 0) (fcatw-row 23 0 31 0)
                (fcatw-row 1 16 0 0) (fcatw-row 23 0 33 0)
                (fcatw-row 1 17 0 0) (fcatw-row 23 0 35 0)
                (fcatw-row 1 18 0 0) (fcatw-row 23 0 37 0)
                (fcatw-row 1 19 0 0) (fcatw-row 23 0 39 0)
                (fcatw-row 24 0 0 0)
                (fcatw-row 24 1 0 0)
                (fcatw-row 24 2 0 0)
                (fcatw-row 102 2 3 0)
                (fcatw-row 26 4 41 0)
                (fcatw-row 102 8 3 0)
                (fcatw-row 102 10 3 0)
                (fcatw-row 26 12 42 0)
                (fcatw-row 26 6 14 0)
                (fcatw-row 102 24 3 0)
                (fcatw-row 26 26 43 0)
                (fcatw-row 26 16 28 0)
                (fcatw-row 26 18 30 0)
                (fcatw-row 26 20 32 0)
                (fcatw-row 26 22 34 0)
                (fcatw-row 102 36 3 0)
                (fcatw-row 80 38 40 0)
                (fcatw-row 42 44 45 0)
                (fcatw-row 42 58 46 0)
                (fcatw-row 42 59 47 0)
                (fcatw-row 42 60 48 0)
                (fcatw-row 42 61 49 0)
                (fcatw-row 42 62 50 0)
                (fcatw-row 42 63 51 0)
                (fcatw-row 42 64 52 0)
                (fcatw-row 42 65 53 0)
                (fcatw-row 42 66 54 0)
                (fcatw-row 42 67 55 0)
                (fcatw-row 42 68 56 0)
                (fcatw-row 42 69 57 0))
            (list "concept" "psckr-reference-v1" "pscish-entry-v2") 70))

    ; Values are deliberately flat because compact fcatw does not retain a
    ; recursive kind tree for NTH of a nested list.
    (defn fcrrei-values
        (request-valid request-kind request-coordinate route-present
         reference-valid reference-schema reference-key reference-family
         reference-path reference-source-key reference-entry-key
         source-record-valid source-schema source-family source-path
         source-key source-entry-key key-member source-node entry-source-node)
        (list
            (fpcp-value (fcatw-kind-int) request-valid)
            (fpcp-value (fcatw-kind-string) request-kind)
            (fpcp-value (fcatw-kind-string) request-coordinate)
            (fpcp-value (fcatw-kind-int) route-present)
            (fpcp-value (fcatw-kind-int) reference-valid)
            (fpcp-value (fcatw-kind-string) reference-schema)
            (fpcp-value (fcatw-kind-string) reference-key)
            (fpcp-value (fcatw-kind-string) reference-family)
            (fpcp-value (fcatw-kind-string) reference-path)
            (fpcp-value (fcatw-kind-string) reference-source-key)
            (fpcp-value (fcatw-kind-string) reference-entry-key)
            (fpcp-value (fcatw-kind-int) source-record-valid)
            (fpcp-value (fcatw-kind-string) source-schema)
            (fpcp-value (fcatw-kind-string) source-family)
            (fpcp-value (fcatw-kind-string) source-path)
            (fpcp-value (fcatw-kind-string) source-key)
            (fpcp-value (fcatw-kind-string) source-entry-key)
            (fpcp-value (fcatw-kind-int) key-member)
            (fpcp-value (fcatw-kind-node) source-node)
            (fpcp-value (fcatw-kind-node) entry-source-node)))

    ; receipt = [receiver-owned protocol, exact offer, exact ack, observed]
    (defn fcrrei-receipt (values correlation fuel)
        (do
            (let caller-image (fcatw-image (empty)
                (list (fcatw-row 1 720071 0 0)) (empty) 0))
            (let callee-image (fcrrei-image))
            (let caller (fcatw-binding
                "form-cli/route-record-requester" caller-image))
            (let callee (fcatw-binding
                "form-cli/route-record-evidence-validation" callee-image))
            (let capability (intern_trivial_string
                "form-cli/route-record-evidence-capability-v1"))
            (let call (fpcp-call-binding caller
                "validate-route-record-evidence" callee capability))
            (let protocol (fpcp-registry
                (fcatw-registry (list caller callee))
                (list capability) (list call)))
            (let offer (fpcp-offer call correlation values fuel))
            (let ack (fpcp-execute protocol offer))
            (list protocol offer ack
                (fpcp-ack-observed? protocol offer ack))))

    (defn fcrrei-offered-raw (receipt at)
        (fpcp-value-raw
            (nth (fpcp-offer-values (nth receipt 1)) at)))
    (defn fcrrei-value (receipt)
        (fpcp-value-raw (fpcp-ack-value (nth receipt 2))))

    ; Semantic status is derived every time from the exact observed ACK and
    ; retained OFFER.  It is not an independently forgeable claim seat.
    (defn fcrrei-status (receipt)
        (if (or (nothing? receipt) (not (eq (len receipt) 4))) "failure"
        (if (not (eq (nth receipt 3) 1)) "failure"
        (if (not (eq (fpcp-ack-observed? (nth receipt 0) (nth receipt 1)
                                         (nth receipt 2)) 1)) "failure"
            (do
                (let ack (nth receipt 2))
                (let status (fpcp-ack-status ack))
                (if (not (str_eq status "returned")) status
                (if (or (not (eq (fpcp-ack-output ack) 1))
                        (not (eq (fpcp-value-kind (fpcp-ack-value ack))
                                 (fcatw-kind-int)))) "failure"
                    (do
                        (let value (fcrrei-value receipt))
                        (if (eq value 1) "admitted"
                        (if (not (eq value 0)) "failure"
                        (if (eq (fcrrei-offered-raw receipt 3) 0) "nothing"
                        (if (or (not (eq (fcrrei-offered-raw receipt 0) 1))
                                (or (not (eq
                                    (fcrrei-offered-raw receipt 4) 1))
                                    (not (eq
                                    (fcrrei-offered-raw receipt 11) 1))))
                            "failure" "refused"))))))))))))

    0)
