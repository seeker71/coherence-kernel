// dsv4-tokenizer.fk — DeepSeek V4 Flash tokenizer, read from the file's own header.
//
// STONE 31. The seam between a human prompt and the proven forward: prompt text -> token ids, and
// token ids -> text. Everything the tokenizer needs lives in the GGUF header (Stone 21's manifest):
// tokenizer.ggml.model = gpt2 (byte-level BPE), 129 280 tokens, 127 741 merges, pre = joyai-llm.
// This cell reads those two arrays the equireach way (gguf-meta.fk's gmt-token-* stream) and derives
// encode + decode on the body's own primitives.
//
// PROVENANCE (rent, do not copy). The algorithm is transcribed from ds4.c (MIT, /Users/ursmuff/
// models/ds4-engine/ds4.c), the model's own reference engine, read for its shape and re-derived here:
//   - gpt2_byte_to_codepoint / gpt2_codepoint_to_byte  (ds4.c ~35505, ~36472) — the byte alphabet
//   - bpe_tokenize_text  (ds4.c ~35985) — the joyai-llm pre-tokenizer split
//   - bpe_emit_piece  (ds4.c ~35574) — byte-encode, then greedy lowest-rank merge
//   - ds4_token_text  (ds4.c ~36497) — id -> piece -> byte-unmap -> UTF-8
// The oracle is ds4 itself: `ds4 --dump-tokens -p "..."`. Every id this cell claims is checked against
// that, never against a guess.
//
// WHY EVERYTHING IS IN BYTE-VALUE SPACE, not built strings. byte_to_str re-encodes any byte >= 128
// through the host's rune path (byte_to_str 196 is TWO bytes, c3 84, the UTF-8 of U+00C4), and this
// body deliberately never constructs a byte-exact string of arbitrary bytes — gguf-meta.fk reads token
// pieces BYTEWISE and lets the caller render. So this cell holds pieces as byte VALUES: a symbol is a
// byte-exact slice of the input (substring is byte-faithful for every byte); a merge/token stored in
// the file as UTF-8-of-codepoints is compared by walking its codepoints and mapping each back to its
// one raw byte value (tkz-cp2b), an int compare that is exact for all 256 bytes. No >=128 byte is ever
// built. Decode returns the raw byte sequence (a list of ints), byte-exact; tkz-decode-text renders it
// and is exact for the ASCII range (< 128), the honest radius byte_to_str allows.
//
// THE BYTE ALPHABET (gpt2). A raw byte b maps to a printable codepoint so merges operate on UTF-8
// without losing byte identity. b is "printable-as-itself" when 33<=b<=126, 161<=b<=172, or b>=174;
// the other 68 bytes (0..32, 127..160, 173) map to 256+n, n = how many other bytes precede b. So a
// space (0x20) -> 256+32 = 288 = U+0120, why every mid-word space is that codepoint in the vocab.
// Codepoints stay <= 323, so an encoded string's codepoints are 1- or 2-byte UTF-8, never more.
//
// THE joyai-llm PRE-TOKENIZER (radius, aporon). ds4.c mirrors the JoyAI split for the cases DS4 uses
// in normal text and source code. This cell covers, exactly as ds4.c does: digit runs of <= 3; a
// punct/symbol leading an ASCII-letter run; letter runs (ASCII alpha, or any non-ASCII byte, ds4.c's
// own rule for ordinary UTF-8 such as accents) with one optional non-letter lead; punct/symbol runs
// that swallow trailing newlines; and space runs where a single leading space joins the next word.
// CJK / Hiragana / Katakana are isolated one run at a time. OUT of radius, named: Unicode punctuation
// and number CLASSES beyond ASCII+CJK (ds4.c's glm4_unicode_* tables) — a prompt using them may split
// differently; the band exercises ASCII, digits, punctuation, and CJK.
//
// preludes: form-stdlib/gguf-meta.fk
//
section [form.bml] {
    // ================= the header, and the two arrays =================
    // Window covers the whole header: tinfo ends < 5.34 MB on this file, so 8 MB reads all KVs.
    def tkz-window() = 8000000;
    def tkz-src(path) = eqr-of-file(path, 0, tkz-window());
    def tkz-vocab-n(src) = gmt-vocab-n(src);
    // --- merges array: KV, first-element offset, count, one record's bytes/next ---
    def tkz-merges-kv(src) = gmt-find(src, "tokenizer.ggml.merges");
    def tkz-merges-first(src) = gmt-arr-first(src, tkz-merges-kv(src));
    def tkz-merges-n(src) = gmt-arr-count(src, tkz-merges-kv(src));
    def tkz-rec-len(src, at) = egg-u64(src, at);
    // a GGUF string: u64 len + bytes
    def tkz-rec-byte(src, at, j) = eqr-at(src, at + 8 + j);
    def tkz-rec-next(src, at) = egg-str-next(src, at);
    // ================= gpt2 byte alphabet, both directions =================
    // byte -> codepoint (0..323). Branch order matches ds4.c's ranges exactly.
    def tkz-b2cp(b) = b < 33 ? 256 + b :     // 0..32    -> 256..288
b < 127 ? b :     // 33..126  -> self
b < 161 ? 162 + b :     // 127..160 -> 289..322
(Comparable) b == 173 ? 323 :     // 173      -> 323
b;
    // 161..172,174..255 -> self
    // codepoint -> raw byte (inverse). Returns -1 for a codepoint that is NOT an alphabet byte:
    // the literal separator space (32) inside a merge record, or a >323 codepoint from a
    // literal-special token (out of byte-level radius).
    def tkz-cp2b(cp) = cp < 256 ? cp < 33 ? 0 - 1 :     // <33 never a stored alphabet byte (incl. 32 = separator)
cp < 127 ? cp :     // 33..126 self
cp < 161 ? 0 - 1 :     // 127..160 never stored raw
cp < 173 ? cp :     // 161..172 self
(Comparable) cp == 173 ? 0 - 1 :     // 173 never stored raw
cp :     // 174..255 self
cp < 289 ? cp - 256 :     // 256..288 -> 0..32
cp < 323 ? cp - 162 :     // 289..322 -> 127..160
(Comparable) cp == 323 ? 173 :     // 323 -> 173
0 - 1;
    // >323 out of radius
    // ================= UTF-8 readers =================
    // ENCODED-codepoint reader (merge/token strings): codepoints <= 323 -> 1 or 2 bytes only.
    def tkz-ecp-len(b0) = b0 < 128 ? 1 : 2;
    def tkz-ecp-val(s, at) = {
        let b0 = eqr-at(s, at);
        b0 < 128 ? b0 : (b0 - 192) * 64 + (eqr-at(s, at + 1) - 128);
    };
    // the same, reading from a Form string (for the decode-text convenience)
    def tkz-secp-len(b0) = b0 < 128 ? 1 : 2;
    def tkz-secp-val(s, i) = {
        let b0 = str_byte_at(s, i);
        b0 < 128 ? b0 : (b0 - 192) * 64 + (str_byte_at(s, i + 1) - 128);
    };
    // INPUT UTF-8 reader (the human prompt): real UTF-8, 1..4 bytes.
    def tkz-ulen(s, i) = {
        let b0 = str_byte_at(s, i);
        b0 < 128 ? 1 : b0 < 224 ? 2 : b0 < 240 ? 3 : 4;
    };
    def tkz-uval(s, i) = {
        let b0 = str_byte_at(s, i);
        b0 < 128 ? b0 : b0 < 224 ? (b0 - 192) * 64 + (str_byte_at(s, i + 1) - 128) : b0 < 240 ? (b0 - 224) * 4096 + (str_byte_at(s, i + 1) - 128) * 64 + (str_byte_at(s, i + 2) - 128) : (b0 - 240) * 262144 + (str_byte_at(s, i + 1) - 128) * 4096 + (str_byte_at(s, i + 2) - 128) * 64 + (str_byte_at(s, i + 3) - 128);
    };
    // ================= DECODE: id -> raw bytes =================
    // A token piece is stored as UTF-8-of-alphabet-codepoints. Walk its codepoints, map each back to
    // its one raw byte (tkz-cp2b), collect the byte VALUES. Byte-exact for the whole byte-level vocab.
    // A codepoint > 323 (a literal-special token, e.g. one carrying U+FF5C) yields -1 and is dropped —
    // out of byte-level radius, named. tkz-piece-off / tkz-piece-len come from gguf-meta.fk's stream.
    def tkz-dec-piece-acc(src, at, j, n, acc) = j < n ? {
        let b0 = gmt-token-byte(src, at, j);
        let cp = b0 < 128 ? b0 : (b0 - 192) * 64 + (gmt-token-byte(src, at, j + 1) - 128);
        let by = tkz-cp2b(cp);
        tkz-dec-piece-acc(src, at, j + (b0 < 128 ? 1 : 2), n, by < 0 ? acc : append(acc, list(by)));
    } : acc;
    def tkz-decode-id-bytes(src, id) = {
        let at = gmt-token-off(src, id);
        tkz-dec-piece-acc(src, at, 0, gmt-token-len(src, at), empty());
    };
    // a whole id list -> one raw byte list
    def tkz-decode-bytes-acc(src, ids, acc) = (Comparable) len(ids) == 0 ? acc : tkz-decode-bytes-acc(src, tail(ids), tkz-cat(acc, tkz-decode-id-bytes(src, head(ids))));
    def tkz-decode-bytes(src, ids) = tkz-decode-bytes-acc(src, ids, empty());
    // list concat helper (append every element of b to a)
    def tkz-cat(a, b) = (Comparable) len(b) == 0 ? a : tkz-cat(append(a, list(head(b))), tail(b));
    // render a raw byte list to a Form string. EXACT for bytes < 128 (ASCII), the radius byte_to_str
    // allows; a byte >= 128 renders as its UTF-8 codepoint (host rune path), so multi-byte scripts are
    // shown, not byte-reproduced. The byte-exact answer is tkz-decode-bytes; this is for reading.
    def tkz-render-acc(bs, acc) = (Comparable) len(bs) == 0 ? acc : tkz-render-acc(tail(bs), str_concat(acc, byte_to_str(head(bs))));
    def tkz-decode-text(src, ids) = tkz-render-acc(tkz-decode-bytes(src, ids), "");
    // ================= joyai-llm pre-tokenizer =================
    def tkz-alpha(b) = (b < 65 ? 0 : b < 91) ? 1 : (b < 97 ? 0 : b < 123) ? 1 : 0;
    def tkz-digit(b) = (b < 48 ? 0 : b < 58) ? 1 : 0;
    def tkz-space(b) = (Comparable) b == 32 ? 1 : (Comparable) b == 9 ? 1 : (Comparable) b == 10 ? 1 : (Comparable) b == 13 ? 1 : (Comparable) b == 11 ? 1 : (Comparable) b == 12 ? 1 : 0;
    def tkz-newline(b) = (Comparable) b == 10 ? 1 : (Comparable) b == 13 ? 1 : 0;
    def tkz-punct(b) = (b < 33 ? 0 : b < 48) ? 1 : (b < 58 ? 0 : b < 65) ? 1 : (b < 91 ? 0 : b < 97) ? 1 : (b < 123 ? 0 : b < 127) ? 1 : 0;
    def tkz-letter-like(s, i) = {
        let b = str_byte_at(s, i);
        b < 128 ? tkz-alpha(b) : 1;
    };
    def tkz-cjk(s, i) = {
        let b = str_byte_at(s, i);
        b < 128 ? 0 : {
            let cp = tkz-uval(s, i);
            (cp < 19968 ? 0 : cp < 40870) ? 1 :             // 0x4e00..0x9fa5
(cp < 12352 ? 0 : cp < 12448) ? 1 :             // 0x3040..0x309f
(cp < 12448 ? 0 : cp < 12544) ? 1 :             // 0x30a0..0x30ff
0;
        };
    };
    // consume a run of letter-like chars from pos, return end offset
    def tkz-eat-letters(s, L, pos) = (pos < L ? tkz-letter-like(s, pos) : 0) ? tkz-eat-letters(s, L, pos + tkz-ulen(s, pos)) : pos;
    // consume ascii-alpha run
    def tkz-eat-alpha(s, L, pos) = (pos < L ? tkz-alpha(str_byte_at(s, pos)) : 0) ? tkz-eat-alpha(s, L, pos + 1) : pos;
    // consume up to `cap` digits
    def tkz-eat-digits(s, L, pos, cap) = (Comparable) cap == 0 ? pos : (pos < L ? tkz-digit(str_byte_at(s, pos)) : 0) ? tkz-eat-digits(s, L, pos + 1, cap - 1) : pos;
    // consume punct run
    def tkz-eat-punct(s, L, pos) = (pos < L ? tkz-punct(str_byte_at(s, pos)) : 0) ? tkz-eat-punct(s, L, pos + 1) : pos;
    // consume newline run
    def tkz-eat-newlines(s, L, pos) = (pos < L ? tkz-newline(str_byte_at(s, pos)) : 0) ? tkz-eat-newlines(s, L, pos + 1) : pos;
    // consume cjk run
    def tkz-eat-cjk(s, L, pos) = (pos < L ? tkz-cjk(s, pos) : 0) ? tkz-eat-cjk(s, L, pos + tkz-ulen(s, pos)) : pos;
    // the space-run arm: returns the end offset for a whitespace run starting at pos (ds4.c 36030)
    def tkz-space-end(s, L, pos) = {
        let p = tkz-space-scan(s, L, pos, 0);
        let ln = tkz-space-lastnl(s, L, pos, 0);
        ln > 0 ? ln : ((p < L ? p > pos + 1 : 0) ? tkz-letter-like(s, p) ? 1 : tkz-punct(str_byte_at(s, p)) : 0) ? p - 1 : p;
    };
    def tkz-space-scan(s, L, pos, acc) =     // end of the maximal space run
(pos < L ? tkz-space(str_byte_at(s, pos)) : 0) ? tkz-space-scan(s, L, pos + 1, 0) : pos;
    def tkz-space-lastnl(s, L, pos, last) =     // offset just past the LAST newline in the space run, or 0
(pos < L ? tkz-space(str_byte_at(s, pos)) : 0) ? tkz-space-lastnl(s, L, pos + 1, (Comparable) tkz-newline(str_byte_at(s, pos)) == 1 ? pos + 1 : last) : last;
    // the next piece: given start pos, return its end offset (ds4.c bpe_tokenize_text)
    def tkz-next-piece(s, L, pos) = {
        let c = str_byte_at(s, pos);
        let e = (Comparable) tkz-digit(c) == 1 ? tkz-eat-digits(s, L, pos, 3) : (Comparable) tkz-cjk(s, pos) == 1 ? tkz-eat-cjk(s, L, pos) : (((Comparable) tkz-punct(c) == 1 ? pos + 1 < L : 0) ? tkz-alpha(str_byte_at(s, pos + 1)) : 0) ? tkz-eat-alpha(s, L, pos + 1) : (Comparable) tkz-letter-like(s, pos) == 1 ? tkz-eat-letters(s, L, pos) : ((((Comparable) tkz-newline(c) == 0 ? (Comparable) tkz-punct(c) == 0 : 0) ? pos + 1 < L : 0) ? tkz-letter-like(s, pos + 1) : 0) ? tkz-eat-letters(s, L, pos + 1) : (((Comparable) c == 32 ? pos + 1 < L : 0) ? tkz-punct(str_byte_at(s, pos + 1)) : 0) ? tkz-eat-newlines(s, L, tkz-eat-punct(s, L, pos + 1)) : (Comparable) tkz-punct(c) == 1 ? tkz-eat-newlines(s, L, tkz-eat-punct(s, L, pos)) : (Comparable) tkz-space(c) == 1 ? tkz-space-end(s, L, pos) : pos + tkz-ulen(s, pos);
        // ds4.c guard: never emit an empty piece
        (Comparable) e == pos ? pos + tkz-ulen(s, pos) : e;
    };
    // ================= BPE over one piece =================
    // A symbol is a LIST of raw byte VALUES (ints), never a string: substring is rune-aware and would
    // drop a byte mid-multibyte-char, and byte_to_str re-encodes >= 128. Input bytes are read
    // byte-exact with str_byte_at; symbols grow by list concat. So every byte value 0..255 is carried
    // faithfully, which is why CJK (3-byte UTF-8 -> three >=128 byte symbols) encodes correctly.
    //
    // Compare a merge record against a candidate pair (symL, symR) WITHOUT building any string: walk the
    // merge's codepoints, cp2b each to a raw byte value, match against symL's byte list, then the
    // separator (a literal space, codepoint 32 -> cp2b -1), then symR's byte list.
    def tkz-merge-eq(src, at, symL, symR) = tkz-me-left(src, at, 0, symL, symR, 0, tkz-rec-len(src, at));
    // phase LEFT: mo = byte offset in the merge record, k = index into symL
    def tkz-me-left(src, at, mo, symL, symR, k, mlen) = mo < mlen ? {
        let b0 = tkz-rec-byte(src, at, mo);
        let cp = b0 < 128 ? b0 : (b0 - 192) * 64 + (tkz-rec-byte(src, at, mo + 1) - 128);
        let nlen = b0 < 128 ? 1 : 2;
        (Comparable) cp == 32 ?         // separator: symL must be fully consumed
(Comparable) k == len(symL) ? tkz-me-right(src, at, mo + nlen, symR, 0, mlen) : 0 : (k < len(symL) ? (Comparable) tkz-cp2b(cp) == nth(symL, k) : 0) ? tkz-me-left(src, at, mo + nlen, symL, symR, k + 1, mlen) : 0;
    } : 0;
    // ran out before separator -> no match
    // phase RIGHT: symR must match exactly to the record end
    def tkz-me-right(src, at, mo, symR, k, mlen) = mo < mlen ? {
        let b0 = tkz-rec-byte(src, at, mo);
        let cp = b0 < 128 ? b0 : (b0 - 192) * 64 + (tkz-rec-byte(src, at, mo + 1) - 128);
        let nlen = b0 < 128 ? 1 : 2;
        (k < len(symR) ? (Comparable) tkz-cp2b(cp) == nth(symR, k) : 0) ? tkz-me-right(src, at, mo + nlen, symR, k + 1, mlen) : 0;
    } : (Comparable) k == len(symR) ? 1 : 0;
    // matched iff symR fully consumed at record end
    // the merge record's LEFT-symbol first raw byte (its first codepoint, mapped by cp2b). One read;
    // used as a fast reject — a merge can only apply to a pair whose left symbol starts with this byte.
    def tkz-merge-fb(src, at) = {
        let b0 = tkz-rec-byte(src, at, 0);
        tkz-cp2b(b0 < 128 ? b0 : (b0 - 192) * 64 + (tkz-rec-byte(src, at, 1) - 128));
    };
    // scan symbol list for the FIRST adjacent pair this merge matches; gated by fb so the expensive
    // full byte-compare runs only for pairs whose left symbol starts with the merge's left byte.
    def tkz-first-pair(src, at, syms, i, fb) = i + 1 < len(syms) ? ((Comparable) head(nth(syms, i)) == fb ? (Comparable) tkz-merge-eq(src, at, nth(syms, i), nth(syms, i + 1)) == 1 : 0) ? i : tkz-first-pair(src, at, syms, i + 1, fb) : 0 - 1;
    // ONE pass over merges (rank-ascending), early-terminating: return the symbol-index to merge for
    // the lowest-rank applicable merge, or -1 if none applies (the terminal, a full pass). Each merge
    // costs one first-byte read + a fb-gated pair scan, so a non-matching merge is rejected cheaply.
    def tkz-best-merge(src, at, rem, syms) = (Comparable) rem == 0 ? 0 - 1 : {
        let p = tkz-first-pair(src, at, syms, 0, tkz-merge-fb(src, at));
        p < 0 ? tkz-best-merge(src, tkz-rec-next(src, at), rem - 1, syms) : p;
    };
    // merge the pair at index p: syms[0..p-1] ++ (syms[p]++syms[p+1]) ++ syms[p+2..]
    def tkz-apply(syms, p) = tkz-splice(syms, 0, p, tkz-cat(nth(syms, p), nth(syms, p + 1)));
    def tkz-splice(syms, i, p, merged) =     // rebuild list, replacing positions p,p+1 with merged
(Comparable) i == len(syms) ? empty() : (Comparable) i == p ? cons(merged, tkz-splice(syms, i + 2, p, merged)) : cons(nth(syms, i), tkz-splice(syms, i + 1, p, merged));
    // the REFERENCE BPE loop for a piece's initial symbol list -> final symbol list. A 0- or 1-symbol
    // list has no pair, so it never scans the merges (the terminal full pass only happens with >= 2
    // symbols and no applicable merge).
    //
    // This is the definition, kept whole and readable; it is NOT what tkz-encode calls. It walks all
    // 127 741 merge records in the mmap'd window per BPE step, which measured 95.3 s of a 95.5 s
    // encode of "The capital of France is" (a Stone 38 profile).
    // tkz-bpe-c below computes the SAME symbol list from a prefiltered candidate list.
    def tkz-bpe(src, syms) = len(syms) < 2 ? syms : {
        let p = tkz-best-merge(src, tkz-merges-first(src), tkz-merges-n(src), syms);
        p < 0 ? syms : tkz-bpe(src, tkz-apply(syms, p));
    };
    // ================= the candidate prefilter, and BPE over it =================
    // WHY THIS IS THE SAME ANSWER, not an approximation. During BPE every symbol is a CONTIGUOUS byte
    // slice of the piece, and the symbols partition the piece left to right; so for any adjacent pair
    // (symL, symR) the byte sequence symL ++ symR is a contiguous slice of the piece, hence of the
    // whole input. A merge whose own byte sequence does not occur contiguously in the input can
    // therefore never match any pair, at any step. Dropping those merges — and keeping the survivors
    // in the file's own rank order — leaves the "lowest-rank applicable merge, leftmost pair" choice
    // untouched. One pass over the table for a whole encode replaces one (early-terminating) pass per
    // BPE step. On "The capital of France is", 50 of 127 741 merges survive.
    //
    // The filter is deliberately looser than the piece split: it tests against the WHOLE input, not
    // per piece. A superset of the reachable merges is safe (an unreachable one is simply never
    // matched) and it costs one pass for the whole prompt instead of one per piece.
    // --- input byte presence, 256 flags, built once per encode: the cheap first gate ---
    def tkz-has-byte(inp, L, b, i) = i < L ? (Comparable) str_byte_at(inp, i) == b ? 1 : tkz-has-byte(inp, L, b, i + 1) : 0;
    def tkz-pres(inp, L, b) = (Comparable) b == 256 ? empty() : cons(tkz-has-byte(inp, L, b, 0), tkz-pres(inp, L, b + 1));
    // --- the positions of the input still viable as a match start, narrowed one byte at a time ---
    def tkz-pos0(L, i) = (Comparable) i == L ? empty() : cons(i, tkz-pos0(L, i + 1));
    def tkz-pfilt(inp, L, pos, j, b) =     // keep p where inp[p+j] = b
(Comparable) len(pos) == 0 ? empty() : {
        let p = head(pos);
        (p + j < L ? (Comparable) str_byte_at(inp, p + j) == b : 0) ? cons(p, tkz-pfilt(inp, L, tail(pos), j, b)) : tkz-pfilt(inp, L, tail(pos), j, b);
    };
    // --- walk one merge record's codepoints, narrowing positions; abort the moment none survive.
    // Returns the split index (how many bytes are the LEFT symbol) or -1 for "can never apply".
    // A non-separator codepoint that cp2b cannot map is -1 and rejects, exactly as tkz-me-left does.
    def tkz-cand-walk(src, at, mo, mlen, inp, L, pos, j, split) = (Comparable) len(pos) == 0 ? 0 - 1 : mo < mlen ? {
        let b0 = tkz-rec-byte(src, at, mo);
        let cp = b0 < 128 ? b0 : (b0 - 192) * 64 + (tkz-rec-byte(src, at, mo + 1) - 128);
        let nlen = b0 < 128 ? 1 : 2;
        (Comparable) cp == 32 ? split < 0 ? tkz-cand-walk(src, at, mo + nlen, mlen, inp, L, pos, j, j) : 0 - 1 : {
            let by = tkz-cp2b(cp);
            by < 0 ? 0 - 1 : tkz-cand-walk(src, at, mo + nlen, mlen, inp, L, tkz-pfilt(inp, L, pos, j, by), j + 1, split);
        };
    } : split < 0 ? 0 - 1 : split;
    // --- a survivor's two byte lists (the separator is the split) ---
    def tkz-mrg-left(src, at, mo, mlen, acc) = mo < mlen ? {
        let b0 = tkz-rec-byte(src, at, mo);
        let cp = b0 < 128 ? b0 : (b0 - 192) * 64 + (tkz-rec-byte(src, at, mo + 1) - 128);
        (Comparable) cp == 32 ? acc : tkz-mrg-left(src, at, mo + (b0 < 128 ? 1 : 2), mlen, append(acc, list(tkz-cp2b(cp))));
    } : acc;
    def tkz-mrg-right(src, at, mo, mlen, acc, seen) = mo < mlen ? {
        let b0 = tkz-rec-byte(src, at, mo);
        let cp = b0 < 128 ? b0 : (b0 - 192) * 64 + (tkz-rec-byte(src, at, mo + 1) - 128);
        let nlen = b0 < 128 ? 1 : 2;
        (Comparable) seen == 1 ? tkz-mrg-right(src, at, mo + nlen, mlen, append(acc, list(tkz-cp2b(cp))), 1) : tkz-mrg-right(src, at, mo + nlen, mlen, acc, (Comparable) cp == 32 ? 1 : 0);
    } : acc;
    // --- THE ONE PASS. Rank order in, rank order out. Each element is (leftbytes rightbytes). ---
    def tkz-cands(src, at, rem, inp, L, pres, pos0, acc) = (Comparable) rem == 0 ? acc : {
        let mlen = tkz-rec-len(src, at);
        let by = tkz-merge-fb(src, at);
        tkz-cands(src, tkz-rec-next(src, at), rem - 1, inp, L, pres, pos0, (by < 0 ? 0 : (Comparable) nth(pres, by) == 1) ? tkz-cand-walk(src, at, 0, mlen, inp, L, pos0, 0, 0 - 1) < 0 ? acc : append(acc, list(list(tkz-mrg-left(src, at, 0, mlen, empty()), tkz-mrg-right(src, at, 0, mlen, empty(), 0)))) : acc);
    };
    // --- BPE over the candidate list: same rule, tiny haystack ---
    def tkz-lseq(a, b, k, n) = (Comparable) n == k ? 1 : (Comparable) nth(a, k) == nth(b, k) ? tkz-lseq(a, b, k + 1, n) : 0;
    def tkz-leq(a, b) = (Comparable) len(a) == len(b) ? tkz-lseq(a, b, 0, len(a)) : 0;
    def tkz-cfirst-pair(syms, i, l, r) =     // leftmost adjacent pair equal to (l, r), or -1
i + 1 < len(syms) ? (tkz-leq(nth(syms, i), l) ? tkz-leq(nth(syms, i + 1), r) : 0) ? i : tkz-cfirst-pair(syms, i + 1, l, r) : 0 - 1;
    def tkz-cbest(cands, ci, n, syms) =     // lowest-rank applicable candidate -> its leftmost pair index
(Comparable) ci == n ? 0 - 1 : {
        let m = nth(cands, ci);
        let p = tkz-cfirst-pair(syms, 0, nth(m, 0), nth(m, 1));
        p < 0 ? tkz-cbest(cands, ci + 1, n, syms) : p;
    };
    def tkz-bpe-c(cands, syms) = len(syms) < 2 ? syms : {
        let p = tkz-cbest(cands, 0, len(cands), syms);
        p < 0 ? syms : tkz-bpe-c(cands, tkz-apply(syms, p));
    };
    // initial symbols: one 1-element byte-value list per input byte in [start,end), read byte-exact
    def tkz-syms(inp, start, end) = (Comparable) start == end ? empty() : cons(list(str_byte_at(inp, start)), tkz-syms(inp, start + 1, end));
    // ================= symbol -> token id (final lookup) =================
    // Compare a token piece (stored codepoint-UTF8) to a raw-byte symbol, byte-exact via cp2b.
    def tkz-tok-eq(src, tat, sym) = tkz-teq(src, tat, 0, 0, sym, gmt-token-len(src, tat));
    def tkz-teq(src, tat, to, k, sym, plen) = to < plen ? {
        let b0 = gmt-token-byte(src, tat, to);
        let cp = b0 < 128 ? b0 : (b0 - 192) * 64 + (gmt-token-byte(src, tat, to + 1) - 128);
        let nlen = b0 < 128 ? 1 : 2;
        (k < len(sym) ? (Comparable) tkz-cp2b(cp) == nth(sym, k) : 0) ? tkz-teq(src, tat, to + nlen, k + 1, sym, plen) : 0;
    } : (Comparable) k == len(sym) ? 1 : 0;
    // ONE streaming pass over the whole vocab: id of the first token equal to sym, or -1.
    def tkz-id-of(src, sym) = tkz-id-scan(src, gmt-tokens-first(src), 0, tkz-vocab-n(src), sym);
    def tkz-id-scan(src, tat, id, n, sym) = (Comparable) id == n ? 0 - 1 : (Comparable) tkz-tok-eq(src, tat, sym) == 1 ? id : tkz-id-scan(src, gmt-token-next(src, tat), id + 1, n, sym);
    // map a final symbol list to ids (one vocab pass per symbol; fallback: per-byte ids)
    def tkz-ids-of-syms(src, syms, acc) = (Comparable) len(syms) == 0 ? acc : {
        let id = tkz-id-of(src, head(syms));
        tkz-ids-of-syms(src, tail(syms), id < 0 ? tkz-cat(acc, tkz-ids-of-bytes(src, head(syms), 0)) : append(acc, list(id)));
    };
    // fallback for an unknown symbol: emit the single-byte token id of each byte (ds4.c bpe_emit_piece)
    def tkz-ids-of-bytes(src, sym, k) = k < len(sym) ? cons(tkz-id-of-byte(src, nth(sym, k)), tkz-ids-of-bytes(src, sym, k + 1)) : empty();
    def tkz-id-of-byte(src, b) = tkz-idb-scan(src, gmt-tokens-first(src), 0, tkz-vocab-n(src), tkz-b2cp(b));
    def tkz-idb-scan(src, tat, id, n, cp) =     // first token that is exactly the one codepoint cp
(Comparable) id == n ? 0 - 1 : tkz-tok-is-cp(src, tat, cp) ? id : tkz-idb-scan(src, gmt-token-next(src, tat), id + 1, n, cp);
    def tkz-tok-is-cp(src, tat, cp) = {
        let plen = gmt-token-len(src, tat);
        let b0 = plen > 0 ? gmt-token-byte(src, tat, 0) : 0 - 1;
        (Comparable) plen == (cp < 128 ? 1 : 2) ? cp < 128 ? (Comparable) b0 == cp : (Comparable) b0 == 192 + cp / 64 ? (Comparable) gmt-token-byte(src, tat, 1) == 128 + cp % 64 : 0 : 0;
    };
    // ================= ENCODE: text -> ids =================
    // walk pieces; BPE each; concatenate ids. add_bos/add_eos are 0 on this file (Stone 21), so no
    // special ids are prepended — the oracle `--dump-tokens` shows none either.
    def tkz-encode-from(src, cands, inp, L, pos, acc) = pos < L ? {
        let end = tkz-next-piece(inp, L, pos);
        tkz-encode-from(src, cands, inp, L, end, tkz-ids-of-syms(src, tkz-bpe-c(cands, tkz-syms(inp, pos, end)), acc));
    } : acc;
    // ONE pass over the merge table for the whole prompt (tkz-cands), then BPE per piece over the
    // survivors. The ids are the reference ids: see tkz-bpe-c's why-this-is-the-same-answer note.
    def tkz-encode(src, inp) = {
        let L = str_len(inp);
        tkz-encode-from(src, tkz-cands(src, tkz-merges-first(src), tkz-merges-n(src), inp, L, tkz-pres(inp, L, 0), tkz-pos0(L, 0), empty()), inp, L, 0, empty());
    };
    0;
}
