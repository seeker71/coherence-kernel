; form-cli-mlx-ir-run.fk — watch Form emit MLX programs and mlx_run them.
;
; mul and (2+3)*4 are recipes. pow is unknown: last_error, value 0.
; Named cell is interned IR text. Framebuffer watches the surprise.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-mlx-ir.bml observe/bidirectional-framebuffer-channel.fk

(do
    (print "form-cli executed mlx-ir\n")
    (print "form-cli emit-add=")
    (print (mlg-emit (mlg-add2)))
    (print " run=")
    (print (int_to_str (mlx_run (mlg-emit (mlg-add2)))))
    (print "\nform-cli emit-mul=")
    (print (mlg-emit (mlg-mul2)))
    (print " run=")
    (print (int_to_str (mlx_run (mlg-emit (mlg-mul2)))))
    (print "\nform-cli emit-times4=")
    (print (mlg-emit (mlg-times4)))
    (print " run=")
    (print (int_to_str (mlx_run (mlg-emit (mlg-times4)))))
    (print "\nform-cli emit-max=")
    (print (mlg-emit (mlg-max2)))
    (print " run=")
    (print (int_to_str (mlx_run (mlg-emit (mlg-max2)))))
    (print "\nform-cli emit-vadd-sum=")
    (print (mlg-emit (mlg-vadd-sum)))
    (print " run=")
    (print (int_to_str (mlx_run (mlg-emit (mlg-vadd-sum)))))
    (print "\nform-cli unknown-pow=")
    (print (int_to_str (mlx_run "2 3 pow")))
    (print " cell-len=")
    (print (int_to_str (str_len (node_value (intern_trivial_string (mlg-emit (mlg-vadd-sum)))))))
    (print " learned-mul=")
    (print (int_to_str (mlg-has (mlg-after) "mul")))
    (print " learned-max=")
    (print (int_to_str (mlg-has (mlg-learn (mlg-after) "max") "max")))
    (print " check=")
    (print (int_to_str (mlg-check)))
    (print "\n")
    (framebuffer-clear)
    (print "form-cli fb-action=")
    (print (int_to_str (bfc-payload (nth (bfc-round 1 (list 4 2) (list 4 2) (list 0 4) 0) 1))))
    (print " fb-events=")
    (print (int_to_str (len (framebuffer-events))))
    (print "\nform-cli mlx=\n")
    (print (mlx_status))
    (print "\n")
    0)
