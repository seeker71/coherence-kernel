            (cdnf-surf "never" "tidakpernah" "nunca" "nie" "jamais" "nunca" "никогда" "kamwe" "从不" "けっして" "أبدا" "कभीनहीं" "asla" "न")
            ; place
            (cdnf-surf "here" "sini" "aqui" "hier" "ici" "aqui" "здесь" "hapa" "这里" "ここ" "هنا" "यहाँ" "burada" "अत्र")
            (cdnf-surf "there" "sana" "alli" "dort" "la" "la" "там" "pale" "那里" "そこ" "هناك" "वहाँ" "orada" "तत्र")
            (cdnf-surf "in" "dalam" "en" "in" "dans" "em" "в" "katika" "在" "なか" "في" "में" "icinde" "अन्तः")
            (cdnf-surf "out" "luar" "fuera" "aus" "hors" "fora" "из" "nje" "外" "そと" "خارج" "बाहर" "disari" "बहिः")
            (cdnf-surf "at" "di" "en" "an" "a" "em" "у" "katika" "在" "で" "في" "पर" "de" "प्रति")
            (cdnf-surf "from" "dari" "de" "von" "de" "de" "от" "kutoka" "从" "から" "من" "से" "den" "तः")
            (cdnf-surf "to" "ke" "a" "zu" "a" "a" "к" "kwa" "到" "へ" "إلى" "को" "e" "प्रति")
            (cdnf-surf "between" "antara" "entre" "zwischen" "entre" "entre" "между" "kati" "之间" "あいだ" "بين" "बीच" "arasinda" "अन्तरे")
            ; degree
            (cdnf-surf "all" "semua" "todo" "alle" "tout" "todo" "все" "yote" "全部" "すべて" "كل" "सब" "tum" "सर्वम्")
            (cdnf-surf "some" "beberapa" "alguno" "einige" "quelques" "algum" "некоторые" "baadhi" "一些" "いくらか" "بعض" "कुछ" "bazi" "किञ्चित्")
            (cdnf-surf "none" "tiada" "ninguno" "keine" "aucun" "nenhum" "никто" "hakuna" "没有" "なし" "لا" "कोईनहीं" "hic" "नकिञ्चित्")
            (cdnf-surf "many" "banyak" "muchos" "viele" "beaucoup" "muitos" "много" "nyingi" "许多" "おおい" "كثير" "बहुत" "cok" "बहवः")
            (cdnf-surf "few" "sedikit" "pocos" "wenige" "peu" "poucos" "мало" "chache" "少" "すこし" "قليل" "थोड़े" "az" "अल्पाः")
            (cdnf-surf "more" "lebih" "mas" "mehr" "plus" "mais" "больше" "zaidi" "更" "もっと" "أكثر" "अधिक" "daha" "अधिकम्")
            (cdnf-surf "less" "kurang" "menos" "weniger" "moins" "menos" "меньше" "chini" "更少" "すくない" "أقل" "कम" "dahaaz" "न्यूनम्")
            (cdnf-surf "very" "sangat" "muy" "sehr" "tres" "muito" "очень" "sana" "很" "とても" "جدا" "बहुत" "cok" "अति")
            ; relation
            (cdnf-surf "same" "sama" "mismo" "gleich" "meme" "mesmo" "тотже" "sawa" "同" "おなじ" "نفس" "समान" "ayni" "समम्")
            (cdnf-surf "other" "lain" "otro" "ander" "autre" "outro" "другой" "nyingine" "其他" "ほか" "آخر" "अन्य" "diger" "अन्यत्")
            (cdnf-surf "like" "seperti" "como" "wie" "comme" "como" "как" "kama" "像" "ように" "مثل" "जैसा" "gibi" "इव")
            (cdnf-surf "part" "bahagian" "parte" "teil" "partie" "parte" "часть" "sehemu" "部分" "ぶぶん" "جزء" "भाग" "parca" "भागः")
            (cdnf-surf "whole" "seluruh" "entero" "ganz" "entier" "inteiro" "целое" "mzima" "整" "ぜんたい" "كل" "पूरा" "butun" "पूर्णम्")
            (cdnf-surf "thing" "benda" "cosa" "ding" "chose" "coisa" "вещь" "kitu" "物" "もの" "شيء" "वस्तु" "sey" "वस्तु")
            (cdnf-surf "way" "cara" "modo" "weg" "facon" "jeito" "путь" "njia" "方式" "みち" "طريق" "तरीका" "yol" "मार्गः")
            (cdnf-surf "kind" "jenis" "tipo" "art" "genre" "tipo" "вид" "aina" "种类" "しゅ" "نوع" "प्रकार" "tur" "प्रकारः")))

    (defn cdnf-row (i) (cl-at-loop (cdnf-surfaces) i))
    (defn cdnf-surface (i tongue)
        (nth (cdnf-row i) (cdnf-tongue-index tongue)))

    (defn cdnf-find-in-row (row tongue-i)
        (nth row tongue-i))
    (defn cdnf-parse-loop (rows tongue-i text i)
        (if (eq (len rows) 0) (sub 0 1)
            (if (str_eq (nth (head rows) tongue-i) text) i
                (cdnf-parse-loop (tail rows) tongue-i text (add i 1)))))
    (defn cdnf-parse (tongue text)
        (cdnf-parse-loop (cdnf-surfaces) (cdnf-tongue-index tongue) text 0))

    ; ── field-health: how this meaning lifts trust, sovereignty, vitality ─
    ; lifts are 0..3. At least one axis rises for every core meaning.
    ; Descriptions are token lists from the closed 64 + glue.
    (defn cdnf-health (t s v how)
        (list t s v how))
    (defn cdnf-h-trust (h) (nth h 0))
    (defn cdnf-h-sov   (h) (nth h 1))
    (defn cdnf-h-vit   (h) (nth h 2))
    (defn cdnf-h-how   (h) (nth h 3))

    (defn cdnf-how-trust () (list "you" "know" "more"))
    (defn cdnf-how-sov   () (list "a" "self" "do" "from" "here"))
    (defn cdnf-how-vit   () (list "the" "whole" "is" "more"))
    (defn cdnf-how-field ()
        (list "all" "kind" "of" "thing" "make" "the" "whole" "more"))
    (defn cdnf-how-it ()
        (list "it" "is" "a" "thing" "and" "a" "thing" "of" "other" "kind"
              "still" "make" "the" "whole" "more"))
    (defn cdnf-how-self ()
        (list "self" "is" "what" "know" "it" "is" "and" "kind" "is" "not"
              "what" "make" "a" "self" "more"))
    (defn cdnf-how-thing ()
        (list "thing" "is" "what" "is" "and" "still" "make" "the" "whole" "more"))
    (defn cdnf-how-kind ()
        (list "kind" "is" "what" "many" "thing" "are" "like" "and" "not"
              "what" "make" "a" "thing" "more"))
    (defn cdnf-how-whole ()
        (list "whole" "is" "all" "part" "and" "all" "kind" "are" "part"
              "of" "the" "whole"))
    (defn cdnf-how-nothing ()
        (list "nothing" "is" "when" "a" "self" "do" "not" "say" "and"
              "you" "still" "know"))
    (defn cdnf-how-whether ()
        (list "whether" "is" "when" "you" "want" "to" "know" "0" "or" "1"
              "and" "the" "way" "is" "not" "after"))

    (defn cdnf-health-at (i)
        (if (eq i (cl-index-of "nothing"))
            (cdnf-health 3 3 2 (cdnf-how-nothing))
        (if (eq i (cl-index-of "it"))
            (cdnf-health 2 2 3 (cdnf-how-it))
        (if (eq i (cl-index-of "self"))
            (cdnf-health 2 3 3 (cdnf-how-self))
        (if (eq i (cl-index-of "thing"))
            (cdnf-health 1 1 3 (cdnf-how-thing))
        (if (eq i (cl-index-of "kind"))
            (cdnf-health 2 2 3 (cdnf-how-kind))
        (if (eq i (cl-index-of "whole"))
            (cdnf-health 2 2 3 (cdnf-how-whole))
        (if (eq i (cl-index-of "whether"))
            (cdnf-health 3 2 1 (cdnf-how-whether))
        (if (eq i (cl-index-of "I"))
            (cdnf-health 1 3 2 (cdnf-how-sov))
        (if (eq i (cl-index-of "you"))
            (cdnf-health 3 2 2 (cdnf-how-trust))
        (if (eq i (cl-index-of "know"))
            (cdnf-health 3 2 2 (cdnf-how-trust))
        (if (eq i (cl-index-of "say"))
            (cdnf-health 3 2 2 (cdnf-how-trust))
        (if (eq i (cl-index-of "we"))
            (cdnf-health 2 2 3 (cdnf-how-vit))
            ; family default: ground trust, person sov, act vit, ask trust,
            ; time vit, place sov, degree vit, relation field
            (do
                (let f (cl-fam-of i))
                (if (eq f 0) (cdnf-health 2 1 1 (cdnf-how-trust))
                (if (eq f 1) (cdnf-health 1 2 2 (cdnf-how-sov))
                (if (eq f 2) (cdnf-health 1 2 3 (cdnf-how-vit))
                (if (eq f 3) (cdnf-health 3 1 1 (cdnf-how-trust))
                (if (eq f 4) (cdnf-health 1 1 2 (cdnf-how-vit))
                (if (eq f 5) (cdnf-health 1 2 1 (cdnf-how-sov))
                (if (eq f 6) (cdnf-health 1 1 2 (cdnf-how-vit))
                             (cdnf-health 2 1 2 (cdnf-how-field)))))))))))))))))))))))

    (defn cdnf-lifts? (h)
        (if (and (ge (cdnf-h-trust h) 0)
            (and (ge (cdnf-h-sov h) 0)
            (and (ge (cdnf-h-vit h) 0)
                 (gt (add (add (cdnf-h-trust h) (cdnf-h-sov h))
                          (cdnf-h-vit h)) 0))))
            1 0))

    (defn cdnf-how-closed-loop (toks)
        (if (eq (len toks) 0) 1
            (if (eq (cl-ok-token? (head toks)) 1)
                (cdnf-how-closed-loop (tail toks))
                0)))
    (defn cdnf-how-closed? (i)
        (cdnf-how-closed-loop (cdnf-h-how (cdnf-health-at i))))

    (defn cdnf-all-lifts-loop (i n)
        (if (eq i n) 1
            (if (eq (cdnf-lifts? (cdnf-health-at i)) 1)
                (cdnf-all-lifts-loop (add i 1) n)
                0)))
    (defn cdnf-all-lifts? () (cdnf-all-lifts-loop 0 (cl-count)))

    (defn cdnf-all-how-closed-loop (i n)
        (if (eq i n) 1
            (if (eq (cdnf-how-closed? i) 1)
                (cdnf-all-how-closed-loop (add i 1) n)
                0)))
    (defn cdnf-all-how-closed? () (cdnf-all-how-closed-loop 0 (cl-count)))

    (defn cdnf-surfaces-full-row? (row)
        (if (eq (len row) (cdnf-tongue-count))
            (cdnf-surfaces-nonempty? row)
            0))
    (defn cdnf-surfaces-nonempty? (row)
        (if (eq (len row) 0) 1
            (if (gt (str_len (head row)) 0)
                (cdnf-surfaces-nonempty? (tail row))
                0)))
    (defn cdnf-all-surfaces-loop (rows)
        (if (eq (len rows) 0) 1
            (if (eq (cdnf-surfaces-full-row? (head rows)) 1)
                (cdnf-all-surfaces-loop (tail rows))
                0)))
    (defn cdnf-all-surfaces? () (cdnf-all-surfaces-loop (cdnf-surfaces)))

    (defn cdnf-en-matches-core-loop (i n)
        (if (eq i n) 1
            (if (str_eq (cdnf-surface i "en") (cl-word (cl-at i)))
                (cdnf-en-matches-core-loop (add i 1) n)
                0)))
    (defn cdnf-en-matches-core? () (cdnf-en-matches-core-loop 0 (cl-count)))

    ; ── organism: organic and non-organic cells, one health law ───────
    (defn cdnf-organic () 0)
    (defn cdnf-nonorganic () 1)
    (defn cdnf-cell (kind t s v) (list kind t s v))
    (defn cdnf-cell-kind (c) (nth c 0))
    (defn cdnf-cell-trust (c) (nth c 1))
    (defn cdnf-cell-sov (c) (nth c 2))
    (defn cdnf-cell-vit (c) (nth c 3))
    (defn cdnf-cell-healthy? (c)
        (if (and (ge (cdnf-cell-trust c) 1)
            (and (ge (cdnf-cell-sov c) 1)
                 (ge (cdnf-cell-vit c) 1)))
            1 0))

    ; Health does not read kind. A metal cell and a carbon cell face the
    ; same three axes.
    (defn cdnf-same-law? (a b)
        (if (eq (cdnf-cell-healthy? a) (cdnf-cell-healthy? b)) 1 0))

    (defn cdnf-field (t s v) (list t s v))
    (defn cdnf-field-trust (f) (nth f 0))
    (defn cdnf-field-sov   (f) (nth f 1))
    (defn cdnf-field-vit   (f) (nth f 2))
    (defn cdnf-field0 () (cdnf-field 0 0 0))
    (defn cdnf-field-add (f c)
        (if (eq (cdnf-cell-healthy? c) 0) f
            (cdnf-field
                (add (cdnf-field-trust f) (cdnf-cell-trust c))
                (add (cdnf-field-sov f) (cdnf-cell-sov c))
                (add (cdnf-field-vit f) (cdnf-cell-vit c)))))

    (defn cdnf-field-ge? (a b)
        (if (and (ge (cdnf-field-trust a) (cdnf-field-trust b))
            (and (ge (cdnf-field-sov a) (cdnf-field-sov b))
                 (ge (cdnf-field-vit a) (cdnf-field-vit b))))
            1 0))

    (defn cdnfk (cond bit) (if cond bit 0))
    (defn cdnf-check ()
        (do
            (let carbon (cdnf-cell (cdnf-organic) 80 80 80))
            (let metal  (cdnf-cell (cdnf-nonorganic) 80 80 80))
            (let sick-carbon (cdnf-cell (cdnf-organic) 0 80 80))
            (let sick-metal  (cdnf-cell (cdnf-nonorganic) 80 0 80))
            (let f0 (cdnf-field0))
            (let f-carbon (cdnf-field-add f0 carbon))
            (let f-metal  (cdnf-field-add f0 metal))
            (let f-sick   (cdnf-field-add f0 sick-carbon))
            (let f-both   (cdnf-field-add f-carbon metal))
            (let it-i (cl-index-of "it"))
            (let nothing-i (cl-index-of "nothing"))
            (add (add (add (add (add (add (add (add (add (add (add (add (add
                (cdnfk (and (eq (cl-count) 64) (eq (cl-closed?) 1)) 1)
                (cdnfk (eq (cdnf-tongue-count) 14) 2))
                (cdnfk (and (eq (len (cdnf-surfaces)) 64)
                            (eq (cdnf-all-surfaces?) 1)) 4))
                (cdnfk (eq (cdnf-en-matches-core?) 1) 8))
                (cdnfk (and (eq (cdnf-parse "en" "nothing") nothing-i)
                            (eq (cdnf-parse "id" "kosong") nothing-i)) 16))
                (cdnfk (node_eq (cdnf-symbol-at nothing-i)
                                (cdnf-symbol 0 0)) 32))
                (cdnfk (eq (cdnf-all-lifts?) 1) 64))
                (cdnfk (eq (cdnf-all-how-closed?) 1) 128))
                (cdnfk (and (eq (cdnf-cell-healthy? carbon) 1)
                            (eq (cdnf-same-law? carbon metal) 1)) 256))
                (cdnfk (and (eq (cdnf-field-trust f-carbon) (cdnf-field-trust f-metal))
                            (eq (cdnf-field-vit f-carbon) (cdnf-field-vit f-metal))) 512))
                (cdnfk (and (eq (cdnf-field-trust f-sick) 0)
                            (eq (cdnf-cell-healthy? sick-metal) 0)) 1024))
                (cdnfk (eq (cdnf-field-ge? f-both f-carbon) 1) 2048))
                (cdnfk (and (eq (cdnf-parse "sw" "hakuna") nothing-i)
                            (eq (cdnf-parse "es" "nada") nothing-i)) 4096))
                (cdnfk (and (eq (cdnf-h-vit (cdnf-health-at it-i)) 3)
                            (eq (cdnf-h-sov (cdnf-health-at (cl-index-of "self"))) 3)) 8192))))

    0)
