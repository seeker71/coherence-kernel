; core-dictionary-neutral-field.fk — the 64 core meanings in form-neutral
; space, projected onto every seated tongue, each carrying how it lifts
; trust, sovereignty, and vitality in a field where organic and
; non-organic cells share one health law.
;
; THE CLOSED 64 IS NOT TOUCHED. core-lexicon.fk remains the English
; closed dictionary. This cell is the overlay: the same 64 meanings as
; content-addressed symbols (family, index — never an English identity),
; surfaces for all 14 seated tongues, and a field-health recipe.
;
; ALL WORDS, ALL NL is the north star. Today's walk is the 64 x 14 shelf
; that already exists; more words enter as more rows, more tongues as
; more columns. Surfaces are rented-oracle seeded, same as nl-tongues.fk;
; native speakers refine them. The symbol and the health law are what
; this cell pins.
;
; A cell's kind (organic / non-organic) is not its health. Health is
; whether trust, sovereignty, and vitality are present. A metal or
; silicon cell that holds those three lifts the whole field the same
; way a carbon cell does.
;
; Descriptions that show the lift are token lists from the closed 64
; plus named glue — so the how-sentence stays inside the body's own
; words. trust / sovereignty / vitality are the overlay axes, not
; extra dictionary words.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/core-lexicon.fk
;
; Proven by: form-stdlib/tests/core-dictionary-neutral-field-band.fk
; witnessed: 2026-08-14 -> band 16383

(do
    ; ── tongue shelf, same order as nl-tongues.fk + en/id ────────────
    (defn cdnf-tongues ()
        (list "en" "id" "es" "de" "fr" "pt" "ru" "sw" "zh" "ja" "ar" "hi" "tr" "sa"))
    (defn cdnf-tongue-count () (len (cdnf-tongues)))
    (defn cdnf-tongue-index-loop (xs name i)
        (if (eq (len xs) 0) (sub 0 1)
            (if (str_eq (head xs) name) i
                (cdnf-tongue-index-loop (tail xs) name (add i 1)))))
    (defn cdnf-tongue-index (name)
        (cdnf-tongue-index-loop (cdnf-tongues) name 0))

    ; Neutral symbol: package 32, type 2, family, index. English spelling
    ; is never part of the identity.
    (defn cdnf-symbol (fam idx) (make_nodeid 32 2 fam idx))
    (defn cdnf-symbol-at (i) (cdnf-symbol (cl-fam-of i) (cl-idx-of i)))

    ; ── surfaces: 64 rows x 14 tongues ───────────────────────────────
    ; row = (en id es de fr pt ru sw zh ja ar hi tr sa)
    (defn cdnf-surf (en id es de fr pt ru sw zh ja ar hi tr sa)
        (list en id es de fr pt ru sw zh ja ar hi tr sa))

    (defn cdnf-surfaces ()
        (list
            ; ground
            (cdnf-surf "nothing" "kosong" "nada" "nichts" "rien" "nada" "ничто" "hakuna" "无" "む" "لاشيء" "शून्य" "hiç" "शून्यम्")
            (cdnf-surf "0" "0" "0" "0" "0" "0" "0" "0" "零" "ゼロ" "٠" "०" "0" "०")
            (cdnf-surf "1" "1" "1" "1" "1" "1" "1" "1" "一" "いち" "١" "१" "1" "१")
            (cdnf-surf "is" "adalah" "es" "ist" "est" "e" "есть" "ni" "是" "です" "هو" "है" "dir" "अस्ति")
            (cdnf-surf "not" "tidak" "no" "nicht" "ne" "nao" "не" "si" "不" "ない" "لا" "नहीं" "degil" "न")
