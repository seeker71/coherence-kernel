            ; person
            (cdnf-surf "I" "saya" "yo" "ich" "je" "eu" "я" "mimi" "我" "わたし" "أنا" "मैं" "ben" "अहम्")
            (cdnf-surf "you" "kamu" "tu" "du" "tu" "voce" "ты" "wewe" "你" "あなた" "أنت" "तुम" "sen" "त्वम्")
            (cdnf-surf "me" "aku" "me" "mich" "moi" "me" "меня" "mimi" "我" "わたし" "لي" "मुझे" "beni" "माम्")
            (cdnf-surf "we" "kami" "nosotros" "wir" "nous" "nos" "мы" "sisi" "我们" "わたしたち" "نحن" "हम" "biz" "वयम्")
