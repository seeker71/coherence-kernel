; form-knowledge-integration-census-run.fk -- print the live, uninflated floor.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-knowledge-integration-census.fk

(do
    (defn fkir-print-family (families sources)
        (if (eq (len families) 0) 0
            (do
                (let id (fki-family-id (head families)))
                (print_str (str_concat "family=" (str_concat id
                    (str_concat " sources=" (str_concat
                        (int_to_str (fki-count-family-sources id sources)) "\n")))))
                (fkir-print-family (tail families) sources))))
    (let families (fki-families))
    (let sources (fki-live-source-units))
    (let concepts (fki-seed-concepts))
    (let observations (empty))
    (let source-observations (empty))
    (let source-atoms (list "flattened table seed" "executes Form source directly"))
    (let source-probe (fkss-search-at "bootstrap" source-atoms))
    (let source-probe-current (fki-source-artifact-current?
        "bootstrap" source-atoms source-probe))
    (let report (fki-report-with-source-retrieval "repository-live-census"
        families sources concepts observations source-observations))
    (let surface (str_concat (fkqt-open)
        (str_concat "how does nothing differ from miss?" (fkqt-close))))
    (fkir-print-family families sources)
    (print_str (str_concat "census-sources=" (str_concat (int_to_str (fki-report-source-total report)) "\n")))
    (print_str (str_concat "registered-sources=" (str_concat (int_to_str (fki-report-mapped-sources report)) "\n")))
    (print_str (str_concat "registered-concepts=" (str_concat (int_to_str (fki-report-concept-total report)) "\n")))
    (print_str (str_concat "integrated-source-percent=" (str_concat (int_to_str (fki-report-source-percent report)) "\n")))
    (print_str (str_concat "integrated-concept-percent=" (str_concat (int_to_str (fki-report-concept-percent report)) "\n")))
    (print_str (str_concat "current-source-access-percent=" (str_concat (int_to_str (fki-report-current-access-percent report)) "\n")))
    (print_str (str_concat "grounded-nodeid-rag-percent=" (str_concat (int_to_str (fki-report-grounded-rag-percent report)) "\n")))
    (print_str (str_concat "grounded-rag-provenance-percent=" (str_concat (int_to_str (fki-report-provenance-percent report)) "\n")))
    (print_str (str_concat "teaching-prefix-exposure-percent=" (str_concat (int_to_str (fki-report-teaching-prefix-percent report)) "\n")))
    (print_str (str_concat "learned-weight-percent=" (str_concat (int_to_str (fki-report-learned-weight-percent report)) "\n")))
    (print_str (str_concat "current-source-retrieval-sources=" (str_concat (int_to_str (fki-report-source-retrieval-sources report)) "\n")))
    (print_str (str_concat "current-source-retrieval-percent=" (str_concat (int_to_str (fki-report-source-retrieval-source-percent report)) "\n")))
    (print_str (str_concat "current-source-hash-percent=" (str_concat (int_to_str (fki-report-current-source-hash-percent report)) "\n")))
    (print_str (str_concat "source-probe-status=" (str_concat (fkss-status source-probe) "\n")))
    (print_str (str_concat "source-probe-path=" (str_concat
        (fki-source-artifact-full-path "bootstrap" source-probe) "\n")))
    (print_str (str_concat "source-probe-id=" (str_concat (fkss-source-id-of source-probe) "\n")))
    (print_str (str_concat "source-probe-current-hash=" (str_concat (int_to_str source-probe-current) "\n")))
    (print_str (str_concat "registry-closed=" (str_concat (int_to_str (fki-report-registry-closed? report)) "\n")))
    (print_str (str_concat "family-gate=" (str_concat (int_to_str (fki-report-family-gate? report)) "\n")))
    (print_str (str_concat "integration-ready95=" (str_concat (int_to_str (fki-report-ready95? report)) "\n")))
    (print_str (str_concat "repository-ready95=" (str_concat (int_to_str (fki-report-repository-ready95? report)) "\n")))
    (print_str (str_concat "query-token-surface=" (str_concat surface "\n")))
    (print_str (str_concat "query-token-parse-ready=" (str_concat
        (int_to_str (fkqt-request-ready? (fkqt-parse surface))) "\n")))
    0)
