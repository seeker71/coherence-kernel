//////////////////////////////////////////////////////////////////////
//
// receipt-texture.bml
//
// Executable BML. The RECEIPT TEXTURE: the smallest energy and
// provenance texture a choice receipt carries so a value-ledger entry
// derives from it by a fold, never by a rented judgment. The kernel
// does not compute a payout; it makes one computable. Every field is
// a row of DATA naming the organ that already produces it:
//
//   provenance  who chose: form-native | local-oracle | remote-oracle |
//               hearth-resident. The control plane's surface column
//               (native-model-control-plane.fk) maps to the first three;
//               the standing hearth (hearth.bml) is the fourth. From the
//               three-part share the lane that carried most of the turn
//               is the provenance; an unmeasured share names nobody.
//   unit/energy a bounded cost the body already measures: tokens
//               (form-cli-remote-token-evidence.bml frte-receipt,
//               form-cli-turn-evidence.fk fcte-total-tokens), bytes
//               (fcte-form-stdout-bytes, the form-run byte totals), ms
//               (fcte-duration-ms, the resident's wall-ms), visits
//               (kernel_stat node visits).
//   share       the three-part native/local/remote share the completed
//               turn already publishes (fcte-boundary-share, basis
//               observed-boundary-event-counts-v1).
//   knowing     the value plane the choice touched (value-planes.fk).
//               Its lane decides sensed vs billed: a sensed plane
//               (wisdom, compassion, grace, care, freedom) is witnessed
//               with amount 0 and never billed; computed, learned and
//               effect lanes bill their energy.
//
// texture-of(receipt, share) folds a choice receipt and a share row into
// one texture whose last four fields are exactly what value-ledger-port's
// vl-post accepts unchanged: id, account, kind, amount. The id is the
// receipt's own identity (who, where, when, surface, path, outcome,
// expression), so the same receipt posted twice is the port's own
// refused duplicate. account is the receipt's who. kind carries
// provenance:outcome:knowing:lane:unit:native/local/remote as one plain
// string. amount is the billed energy, the cost a coherence score
// multiplies; the payout itself is the parent's later compensating
// entry, never computed here.
//
// preludes: form-stdlib/core.fk form-stdlib/choice-receipt.fk form-stdlib/storage-port.fk form-stdlib/value-ledger-port.fk form-stdlib/value-planes.fk form-stdlib/bml/form-cli-remote-token-evidence.bml
//
// Proven by: form-stdlib/tests/receipt-texture-band.fk
//
// Next stone: form-cli-peer-contribution-turnwheel.fk fcpct-token-receipt
// already births the frte receipt rtex-share-of-token-receipt reads; the
// turn's own choice receipt (expression, selected path, outcome, measured
// certainty) is the half the turnwheel does not mint yet. form-cli-share-run
// carries the other producer: (fcte-boundary-share e) with
// (fcte-total-tokens e) feeds rtex-share-of-boundary as it stands.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormReceiptTexture {
        thought receipt-texture-pattern = list("fields-are-rows", "source-organ-named", "fold-not-judgment", "sensed-is-never-billed", "duplicate-is-the-ports-refusal");

        def rtex-tag() = "receipt-texture-v1";
        def rtex-share-tag() = "receipt-texture-share-v1";

        // each texture field: its name, the organ that already produces it, its values
        def rtex-field(name, organ, values) = list(name, organ, values);
        def rtex-field-name(f) = f[0];
        def rtex-field-organ(f) = f[1];
        def rtex-field-values(f) = f[2];
        def rtex-fields() = list(
            rtex-field("provenance", "native-model-control-plane.fk surface column; hearth.bml hearth-resident-model; fcte-boundary-share's dominant lane", "form-native | local-oracle | remote-oracle | hearth-resident"),
            rtex-field("unit", "form-cli-remote-token-evidence.bml; form-cli-turn-evidence.fk; form-cli-peer-contribution-live.fk wall-ms; kernel_stat", "tokens | bytes | ms | visits"),
            rtex-field("energy", "the unit's organ: frte-receipt-remote-tokens, fcte-total-tokens, fcte-form-stdout-bytes, fcte-duration-ms", "bounded, never below 0"),
            rtex-field("share", "form-cli-turn-evidence.fk fcte-boundary-share, basis observed-boundary-event-counts-v1", "native local remote percents summing to 100, or 0 0 0 unmeasured"),
            rtex-field("knowing", "value-planes.fk the-knowings and lane-of", "a knowing name; its lane (computed | learned | effect | sensed) decides sensed vs billed"),
            rtex-field("outcome", "choice-receipt.fk cr-outcome-code", "success 1 | fail 0 | silence -1"),
            rtex-field("when", "choice-receipt.fk cr-receipt-when", "the receipt's own tick"));

        def rtex-provenances() = list("form-native", "local-oracle", "remote-oracle", "hearth-resident");
        def rtex-units() = list("tokens", "bytes", "ms", "visits");
        def rtex-member?(rows, name) = (Comparable) len(rows) == 0 ? 0 : (String) head(rows) == name ? 1 : rtex-member?(tail(rows), name);
        def rtex-provenance?(who) = nothing?(who) ? 0 : rtex-member?(rtex-provenances(), who);
        def rtex-unit?(unit) = nothing?(unit) ? 0 : rtex-member?(rtex-units(), unit);

        // execution surface -> provenance: the control plane's own surface column as rows
        def rtex-surface-rows() = list(list("native-recipe", "form-native"), list("local-process", "local-oracle"), list("remote-membrane", "remote-oracle"));
        def rtex-provenance-of-surface-go(rows, surface) = (Comparable) len(rows) == 0 ? nothing() : (String) head(rows)[0] == surface ? head(rows)[1] : rtex-provenance-of-surface-go(tail(rows), surface);
        def rtex-provenance-of-surface(surface) = rtex-provenance-of-surface-go(rtex-surface-rows(), surface);

        // three-part share -> the lane that carried most of the turn; an unmeasured share names nobody
        def rtex-provenance-of-share3(native, local, remote) = (Comparable) (native + (local + remote)) == 0 ? nothing() : (native >= local) && (native >= remote) ? "form-native" : local >= remote ? "local-oracle" : "remote-oracle";

        // the share row a producer hands in beside the receipt
        def rtex-share(provenance, unit, energy, native, local, remote, knowing) = list(rtex-share-tag(), provenance, unit, energy, native, local, remote, knowing);
        def rtex-share-provenance(s) = s[1];
        def rtex-share-unit(s) = s[2];
        def rtex-share-energy(s) = s[3];
        def rtex-share-native(s) = s[4];
        def rtex-share-local(s) = s[5];
        def rtex-share-remote(s) = s[6];
        def rtex-share-knowing(s) = s[7];
        def rtex-share?(s) = nothing?(s) ? 0 : !((Comparable) len(s) == 8) ? 0 : ((String) s[0] == rtex-share-tag());
        def rtex-share-sum(s) = rtex-share-native(s) + (rtex-share-local(s) + rtex-share-remote(s));
        def rtex-share3-valid?(s) = (rtex-share-native(s) < 0) || ((rtex-share-local(s) < 0) || (rtex-share-remote(s) < 0)) ? 0 : ((Comparable) rtex-share-sum(s) == 0) || ((Comparable) rtex-share-sum(s) == 100) ? 1 : 0;
        def rtex-share-valid?(s) = (Comparable) rtex-share?(s) == 0 ? 0 : (Comparable) rtex-provenance?(rtex-share-provenance(s)) == 0 ? 0 : (Comparable) rtex-unit?(rtex-share-unit(s)) == 0 ? 0 : rtex-share-energy(s) < 0 ? 0 : (Comparable) rtex-share3-valid?(s) == 0 ? 0 : (String) rtex-lane(rtex-share-knowing(s)) == "unknown" ? 0 : 1;

        // adapters from the producers the body already has
        def rtex-share-of-boundary(share3, unit, energy, knowing) = rtex-share(rtex-provenance-of-share3(share3[0], share3[1], share3[2]), unit, energy, share3[0], share3[1], share3[2], knowing);
        def rtex-share-of-token-receipt(receipt, knowing) = (Comparable) frte-local-direct?(receipt) == 1 ? rtex-share("hearth-resident", "tokens", 0, 100, 0, 0, knowing) : (Comparable) frte-provider-baseline?(receipt) == 1 ? rtex-share("remote-oracle", "tokens", frte-receipt-remote-tokens(receipt), 0, 0, 100, knowing) : nothing();

        // the value plane: a sensed lane is witnessed, never billed
        def rtex-lane(knowing) = lane-of(the-knowings(), knowing);
        def rtex-billed?(knowing) = (String) rtex-lane(knowing) == "unknown" ? 0 : measurable?(rtex-lane(knowing));
        def rtex-sensed?(knowing) = (String) rtex-lane(knowing) == "sensed" ? 1 : 0;

        def rtex-join(parts) = (Comparable) len(parts) == 0 ? "" : head(parts) ++ rtex-join(tail(parts));
        // the receipt's own identity: one choice at one tick from one place is one entry
        def rtex-id(receipt) = rtex-join(list("rt|", cr-receipt-who(receipt), "|", cr-receipt-where(receipt), "|", int_to_str(cr-receipt-when(receipt)), "|", cr-receipt-surface(receipt), "|", cr-receipt-selected-path(receipt), "|", int_to_str(cr-outcome-code(cr-receipt-outcome(receipt))), "|", cr-receipt-expression(receipt)));
        def rtex-account(receipt) = cr-receipt-who(receipt);
        def rtex-kind(receipt, s) = rtex-join(list(rtex-share-provenance(s), ":", cr-receipt-outcome(receipt), ":", rtex-share-knowing(s), ":", rtex-lane(rtex-share-knowing(s)), ":", rtex-share-unit(s), ":", int_to_str(rtex-share-native(s)), "/", int_to_str(rtex-share-local(s)), "/", int_to_str(rtex-share-remote(s))));
        def rtex-amount(s) = (Comparable) rtex-billed?(rtex-share-knowing(s)) == 1 ? rtex-share-energy(s) : 0;
        def rtex-entry-valid?(receipt, s) = nothing?(receipt) ? 0 : (Comparable) rtex-share-valid?(s) == 0 ? 0 : cr-choice-receipt-valid?(receipt) ? 1 : 0;

        // the texture: provenance, energy, plane, outcome, then the four fields the port accepts unchanged
        def texture-of(receipt, s) = (Comparable) rtex-entry-valid?(receipt, s) == 0 ? nothing() : list(rtex-tag(), rtex-share-provenance(s), rtex-share-unit(s), rtex-share-energy(s), rtex-share-knowing(s), rtex-lane(rtex-share-knowing(s)), rtex-sensed?(rtex-share-knowing(s)), rtex-billed?(rtex-share-knowing(s)), cr-outcome-code(cr-receipt-outcome(receipt)), cr-receipt-when(receipt), rtex-id(receipt), rtex-account(receipt), rtex-kind(receipt, s), rtex-amount(s));
        def rtex-texture?(t) = nothing?(t) ? 0 : !((Comparable) len(t) == 14) ? 0 : ((String) t[0] == rtex-tag());
        def rtex-provenance(t) = t[1];
        def rtex-unit(t) = t[2];
        def rtex-energy(t) = t[3];
        def rtex-knowing(t) = t[4];
        def rtex-plane(t) = t[5];
        def rtex-sensed(t) = t[6];
        def rtex-billed(t) = t[7];
        def rtex-outcome-code(t) = t[8];
        def rtex-when(t) = t[9];
        def rtex-entry-id(t) = t[10];
        def rtex-entry-account(t) = t[11];
        def rtex-entry-kind(t) = t[12];
        def rtex-entry-amount(t) = t[13];
        def rtex-entry-of(t) = list(rtex-entry-id(t), rtex-entry-account(t), rtex-entry-kind(t), rtex-entry-amount(t));

        // POST through the port unchanged; nothing posts nothing and the store returns as it was
        def rtex-post(carrier, store, t) = (Comparable) rtex-texture?(t) == 0 ? store : vl-post(carrier, store, rtex-entry-id(t), rtex-entry-account(t), rtex-entry-kind(t), rtex-entry-amount(t));
    }
    0;
}
