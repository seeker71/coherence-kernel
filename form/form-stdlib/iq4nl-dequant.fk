; iq4nl-dequant.fk — exact Form carver for GGML type 20.
;
; preludes: form-stdlib/core.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/iq4nl-layout.bml

(do
    (defn iq4nl-values () (list -127 -104 -83 -65 -49 -35 -22 -10 1 13 25 38 53 69 89 113))
    (defn iq4nl-d (bytes base) (fd-f16 (iq4nl-u16 bytes base)))
    (defn iq4nl-at-flat (bytes base i)
        (if (eq (iq4nl-within-block i) 0) (nothing)
            (mul (iq4nl-d bytes base)
                 (nth (iq4nl-values) (iq4nl-quant-code bytes base i)))))
    0)
