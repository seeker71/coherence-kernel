; form-cli-one-turn-run.fk — print the one-local-turn budget against live share.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-router.fk
; preludes: form-stdlib/form-cli-turn-evidence.fk
; preludes: form-stdlib/form-cli-turn-evidence-live.fk
; preludes: form-stdlib/form-cli-local-ready-xtal.fk
; preludes: form-stdlib/form-cli-one-turn-xtal.fk

(do
    (let evidence (fctel-evidence))
    (let remote (if (eq (fcte-valid? evidence) 1) (fcte-remote-events evidence) 0))
    (print_str (str_concat "fot one-turn=" (str_concat (int_to_str (OneTurn)) "\n")))
    (print_str (str_concat "fot check=" (str_concat (int_to_str (fot-check)) "\n")))
    (print_str (str_concat "fot next local-first=" (str_concat (int_to_str (fot-next 0 0)) "\n")))
    (print_str (str_concat "fot next review=" (str_concat (int_to_str (fot-next 1 0)) "\n")))
    (print_str (str_concat "fot next cap=" (str_concat (int_to_str (fot-next 2 0)) "\n")))
    (print_str (str_concat "fot walk unbalanced=" (str_concat (int_to_str (fot-walk 0 (UnbalancedMark))) "\n")))
    (print_str (str_concat "fot walk quiet=" (str_concat (int_to_str (fot-walk 0 (Quiet))) "\n")))
    (print_str (str_concat "fot session-remote=" (str_concat (int_to_str remote) "\n")))
    (print_str (str_concat "fot leak-one-request=" (str_concat (int_to_str (fot-leak-one-request remote)) "\n")))
    0)
