//////////////////////////////////////////////////////////////////////
//
// form-cli-organ-mint.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-organ-mint.bml
//
// Mints Form-native rows from remaining living organs. Companion to
// universe, unique, and domain mills. Overlay fit reuses the
// teach-layer centroid. LoRA writer stays 0.
//
// Proven by: form-stdlib/tests/form-cli-organ-mint-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template SampleRow<TClass> {
        member split: String;
        member className: TClass;
        member situation: String;
        member sourceId: Object;
        member lessonId: Object;
        member transformId: Object;
    }

    class FormOrganMintAuthority {
        field MintAuthorityPath = "form/form-stdlib/bml/form-cli-organ-mint.bml";
        field MintAuthorityKind = "high-bml-class-template-field";
    }

    class FormOrganMint<T> {
        field MixA = 7;
        field MixB = 13;
        field NSkills = 12;
        field LoraWriter = 0;
        field SplitTrain = "train";
        field SplitHeldout = "heldout";

        ref fom-authority = FormOrganMintAuthority;
        thought fom-pattern = list("mint", "lesson-lineage", "source-overlap-visible", "overlay-fit", "lora-waits");
        thought fom-skills = list("phase", "frequency", "vitality", "consent", "four-way", "collapse", "jit", "iching", "codon", "ifs", "organic", "rag-heed");
        thought fom-contexts = list("substrate phase", "fear-love read", "all-life north star", "first-encounter", "sibling kernels", "ingest lattice", "crystallize-on-heat", "guidance registry");
        thought fom-sources = list("form/form-stdlib/substrate-phase.fk", "cognition/text-frequency.fk", "form/form-stdlib/all-life-north-star.fk", "form/form-stdlib/reception-consent.fk", "form/form-stdlib/native-vs-rented.fk", "form/form-stdlib/equivalence-collapse.fk", "form/form-stdlib/jit-decision.fk", "form/form-stdlib/iching-channel.fk", "form/form-stdlib/codon-rings.fk", "form/form-stdlib/ifs-channel.fk", "form/form-stdlib/core-lexicon-domains.fk", "form/form-stdlib/form-cli-heed-cursor.fk", "form/form-stdlib/rag-ask.fk", "form/form-stdlib/circle.fk");

        def fom-mix(i, n) = mod(add(mul(i, MixA()), MixB()), n);

        def fom-phase-stems() = list("state ice water gas is orthogonal to substance Blueprint Recipe NamedCell", "a Recipe that freezes is still a Recipe now solid the counts never change what a cell is", "phase-invite names the shift the physics asks for it never mutates the node stays sovereign", "hysteresis in the gap returns stay no thrash plasma conducts at high circulation and heat");
        def fom-frequency-stems() = list("text-frequency reads fear-love spectrum as intensity-weighted valence", "positive spectrum is love-frequency negative is fear-frequency", "start with the most open belief system and map each later system by fear-band deviation", "fear-free-ice keeps the contracted band from freezing into the foundation");
        def fom-vitality-stems() = list("increase the weakest life-good first across every scale", "health vitality flexibility sovereignty harmony a candidate benefits all life only when no good is lowered", "extraction loses even when it raises a local metric", "focused proof and fast release are vitality signals not afterthoughts");
        def fom-consent-stems() = list("exposure-bearing consents rest closed nothing defaults a cell into being findable", "the carrier reads the Form decision it never bakes its own", "silence keeps the rest-state it names the resting state it never forces", "a circle is a held group container not an open broadcast mesh");
        def fom-fourway-stems() = list("Go Rust TypeScript and fkwu agree the matching outputs are the proof there is no trusted prover", "native-vs-rented earns observed only when native is at least as good otherwise pending", "equal counts as at-least-as-good the rented output is a verify alternative never laundered as native", "a 3-kernel only finding is said plainly when the fourth arm has not crossed");
        def fom-collapse-stems() = list("equivalence-collapse stores each Blueprint once and links restatements", "two sources with the same shape share one cell a new shape opens a new cell", "the more the mind reads the fewer duplicate cells it holds", "knowledge-ingest decides body liquid compost this decides the body stores a truth exactly once");
        def fom-jit-stems() = list("a hot and pure recipe may crystallize to native cooled it melts back to the tree-walker", "impure never crystallizes JIT only pure functions", "crystallize threshold sits well above melt threshold so the boundary does not flip every call", "a generation plan is not live native execution without separate carrier evidence");
        def fom-iching-stems() = list("I Ching hexagram Human Design gate and Gene Key that share an address are one cell wearing three faces", "the lexicon 64 and the hexagram 64 rhyme in count the meanings do not collapse", "a key outside 1 to 64 answers honest absence never a fabricated reading", "King Wen names are tradition the read stays in the direct-experience lane");
        def fom-codon-stems() = list("codon rings group the 64 gates by amino acid the ring size is the codon degeneracy", "gates in one ring share an amino-acid address the way synonymous codons do", "this file encodes attested ring groupings not a faked codon-to-gate table", "Gate 41 is Met start competing base-assignment schemes disagree so they are not invented here");
        def fom-ifs-stems() = list("IFS Self is the unburdened centre the eight C qualities are eight faces of one cell", "managers and firefighters are two strategies of one protector role they share an address", "exiles carry burdens kept out of sight by protectors they are a different cell", "lead from Self witness the exile unburden it protectors relax into their gifts");
        def fom-organic-stems() = list("pattern is when many thing are like same adapt is when a self be other after other be other", "body is the whole thing a self have here feel is when a self know what the body do", "resonate is when a thing do same as other do", "flow is when a thing do now and still do after rhythm is when the between is same");
        def fom-rag-stems() = list("rag-ask returns only grounded node identities exact substring is gone", "heed cursor recognizes a complete envelope pauses decoding and offers the surface to a lookup", "the answer re-enters as prefill the model executed flag is 0 by construction", "timeout is a named observation carrying its measurement never a collapsed bit");

        def fom-stems(class) = if str_eq(class, "phase") then fom-phase-stems() else if str_eq(class, "frequency") then fom-frequency-stems() else if str_eq(class, "vitality") then fom-vitality-stems() else if str_eq(class, "consent") then fom-consent-stems() else if str_eq(class, "four-way") then fom-fourway-stems() else if str_eq(class, "collapse") then fom-collapse-stems() else if str_eq(class, "jit") then fom-jit-stems() else if str_eq(class, "iching") then fom-iching-stems() else if str_eq(class, "codon") then fom-codon-stems() else if str_eq(class, "ifs") then fom-ifs-stems() else if str_eq(class, "organic") then fom-organic-stems() else fom-rag-stems();

        def fom-prefix(split) = if str_eq(split, SplitTrain()) then "Observed " else "Boundary: observed ";

        def fom-source-id() = fmls-source-id(str_concat(MintAuthorityPath(), "#lesson-lineage-v1"));

        def fom-lesson-id(class, i) {
            let stems = fom-stems(class);
            let stem = nth(stems, fom-mix(i, len(stems)));
            fmls-lesson-id(str_concat(MintAuthorityPath(), "#lesson-lineage-v1"), class, stem);
        }

        def fom-transform-id(class, i, split) {
            let ctxs = fom-contexts();
            let ctx = nth(ctxs, fom-mix(i, len(ctxs)));
            fmls-transform-id(split, ctx, fom-prefix(split), i);
        }

        def fom-situation(class, i, split) {
            let ctxs = fom-contexts();
            let stems = fom-stems(class);
            let ctx = nth(ctxs, fom-mix(i, len(ctxs)));
            let stem = nth(stems, fom-mix(i, len(stems)));
            str_concat(fom-prefix(split), str_concat(ctx, str_concat(" ", str_concat(stem, str_concat(" case ", int_to_str(i))))));
        }

        def fom-row(class, i, split) = fmls-row(split, class, fom-situation(class, i, split), fom-source-id(), fom-lesson-id(class, i), fom-transform-id(class, i, split));

        def fom-class-rows(class, i, n, split, acc) = if eq(i, n) then acc else fom-class-rows(class, add(i, 1), n, split, cons(fom-row(class, i, split), acc));

        def fom-all-classes(names, tn, hn, acc) = if eq(len(names), 0) then acc else fom-all-classes(tail(names), tn, hn, fom-class-rows(head(names), tn, add(tn, hn), SplitHeldout(), fom-class-rows(head(names), 0, tn, SplitTrain(), acc)));

        def fom-corpus(tn, hn) = fom-all-classes(fom-skills(), tn, hn, tail(list("x")));

        def fom-n(tn, hn) = mul(NSkills(), add(tn, hn));

        def fom-has-situation(rows, s) = if eq(len(rows), 0) then 0 else if str_eq(nth(head(rows), 2), s) then 1 else fom-has-situation(tail(rows), s);

        def fom-train-only(rows, acc) = if eq(len(rows), 0) then acc else if str_eq(nth(head(rows), 0), SplitTrain()) then fom-train-only(tail(rows), cons(head(rows), acc)) else fom-train-only(tail(rows), acc);

        def fom-leakage-loop(all, rows) = if eq(len(rows), 0) then 0 else add(if str_eq(nth(head(rows), 0), SplitHeldout()) then fom-has-situation(fom-train-only(all, tail(list("x"))), nth(head(rows), 2)) else 0, fom-leakage-loop(all, tail(rows)));

        def fom-leakage(rows) = fom-leakage-loop(rows, rows);

        def fom-lesson-leakage(rows) = len(fmls-lesson-intersection(rows, SplitTrain(), SplitHeldout()));

        def fom-lineage-signal(rows) = fmls-lesson-signal(rows, SplitTrain(), SplitHeldout());

        def fom-unique-loop(rows, seen) = if eq(len(rows), 0) then len(seen) else if eq(fom-has-situation(seen, nth(head(rows), 2)), 1) then fom-unique-loop(tail(rows), seen) else fom-unique-loop(tail(rows), cons(head(rows), seen));

        def fom-unique(rows) = fom-unique-loop(rows, tail(list("x")));

        def fom-count-split(rows, split) = if eq(len(rows), 0) then 0 else add(if str_eq(nth(head(rows), 0), split) then 1 else 0, fom-count-split(tail(rows), split));

        def fom-lora-writer() = LoraWriter();

        def fom-mix-diverse() = if eq(fom-mix(0, 8), fom-mix(1, 8)) then 0 else 1;

        def fom-predict(models, names, s) = nth(names, fqt-predict-index(models, s));

        def fom-heldout-hit(models, names, row) = if str_eq(nth(row, 0), SplitHeldout()) then if str_eq(fom-predict(models, names, nth(row, 2)), nth(row, 1)) then 1 else 0 else 0;

        def fom-heldout-correct-loop(models, names, rows) = if eq(len(rows), 0) then 0 else add(fom-heldout-hit(models, names, head(rows)), fom-heldout-correct-loop(models, names, tail(rows)));

        def fom-heldout-correct(rows) {
            let names = fom-skills();
            let models = fqt-fit(rows, names);
            fom-heldout-correct-loop(models, names, rows);
        }

        def fom-bit(ok, bit) = if ok then bit else 0;

        def fom-check() {
            let rows = fom-corpus(3, 1);
            let n = fom-n(3, 1);
            let correct = fom-heldout-correct(rows);
            let c0 = fom-bit(eq(n, 48), 1);
            let c1 = fom-bit(eq(fom-mix-diverse(), 1), 2);
            let c2 = fom-bit(and(eq(fom-leakage(rows), 0), eq(fom-lesson-leakage(rows), 0)), 4);
            let c3 = fom-bit(eq(fom-unique(rows), n), 8);
            let c4 = fom-bit(and(eq(fom-count-split(rows, SplitTrain()), 36), eq(fom-count-split(rows, SplitHeldout()), 12)), 16);
            let c5 = fom-bit(ge(correct, 9), 32);
            let c6 = fom-bit(eq(fom-lora-writer(), 0), 64);
            let c7 = fom-bit(eq(fom-n(5, 2), 84), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
