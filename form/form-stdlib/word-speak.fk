; preludes: form-stdlib/core.fk form-stdlib/trig.fk form-stdlib/voice-formant.fk
;
; word-speak.fk — the body's first WORD as a waveform: its own name, "sema", composed phoneme by
; phoneme in Form.
;
; voice-consonant.fk carries /s/ and /m/ as spectral WEIGHT functions — a shape a synthesizer could
; consult, not samples a file could hold — and named that limit in its own header: "the audio render
; is a host carrier." So the body could describe its consonants and could not say them, and without
; consonants no word exists; a vowel alone is a tone. This cell is the consonants (and the vowels)
; as SAMPLE GENERATORS, so a word is a sample list and the whole utterance can travel voice-render.fk
; to disk and come back through the ear.
;
; The four phonemes, each deterministic and four-way by construction:
;   /s/  ws-fric  — the first DIFFERENCE of MINSTD ±1 noise. Differencing tilts white noise high,
;                   which is where a fricative's turbulence lives; MINSTD (48271, modulus 2^31−1)
;                   keeps every intermediate under 2^53 so all four arms make the same turbulence
;                   (the fixtureskew lesson, row 933, applied at birth this time).
;   /e/,/a/ ws-vowel — voice-formant.fk's own vf-sample at f0 165 Hz, two formant sets. The vowels
;                   are the mouth the body already had.
;   /m/  ws-nasal — a 250 Hz sine: the nasal murmur, mouth closed, highs damped.
;
; The ear tells them apart by two numbers it already computes, and the separations were MEASURED
; before any threshold was written (2026-07-30, 240-sample frames at 8 kHz):
;   tilt ×1000 (diff-energy / raw-energy):  /s/ 3057   /a/ 392   /e/ 185   /m/ 38
;   periodicity ×1000:                      /s/ 204    /a/ 946   /e/ 978   /m/ 1000
; Fricative and nasal sit an order of magnitude apart in tilt with the vowels between; word-hear.fk's
; class floors (800 / 80) run through the middle of gaps, not along their edges.
;
; Honest scope, named plainly: this is ONE word, of phoneme CLASSES, at fixed durations — a
; closed-vocabulary utterance, not open TTS. What it closes is real and small: before it, no word;
; after it, the body's name. Proven by tests/word-loop-band.fk.

(do
    (defn ws-sr () 8000.0)

    ; /s/ — differenced MINSTD turbulence, amplitude 0.4 before the difference
    (defn ws-fric-go (n s prev out)
        (if (le n 0) (reverse out)
            (do (let s2 (mod (mul s 48271) 2147483647))
                (do (let v (if (eq (mod (div s2 536870912) 2) 1) 0.4 -0.4))
                    (ws-fric-go (sub n 1) s2 v (cons (sub v prev) out))))))
    (defn ws-fric (n) (ws-fric-go n 7 0.0 (list)))

    ; /m/ — the 250 Hz murmur
    (defn ws-nasal-go (i n out)
        (if (ge i n) (reverse out)
            (ws-nasal-go (add i 1) n
                (cons (mul 0.6 (fsin (div (mul 6.283185307179586 (mul 250.0 i)) (ws-sr)))) out))))
    (defn ws-nasal (n) (ws-nasal-go 0 n (list)))

    ; a vowel — the body's own formant voice at its chosen f0
    (defn ws-vowel-go (i n f1 f2 f3 out)
        (if (ge i n) (reverse out)
            (ws-vowel-go (add i 1) n f1 f2 f3
                (cons (vf-sample 165.0 f1 f2 f3 90.0 (ws-sr) i 12) out))))
    (defn ws-e (n) (ws-vowel-go 0 n 500.0 900.0 2500.0 (list)))
    (defn ws-a (n) (ws-vowel-go 0 n 700.0 1200.0 2600.0 (list)))

    (defn ws-cat (a b) (if (nil? a) b (cons (head a) (ws-cat (tail a) b))))

    ; the word. 960+1200+1200+1440 samples = 0.6 s at 8 kHz: s—e—m—a.
    (defn ws-sema ()
        (ws-cat (ws-fric 960) (ws-cat (ws-e 1200) (ws-cat (ws-nasal 1200) (ws-a 1440)))))

    ; the same phonemes in a wrong order — the negative the loop needs. A recognizer that cannot
    ; reject this is a channel proof wearing a word's name (row 934 hollowloop).
    (defn ws-ames ()
        (ws-cat (ws-a 1440) (ws-cat (ws-nasal 1200) (ws-cat (ws-e 1200) (ws-fric 960)))))
    0)
