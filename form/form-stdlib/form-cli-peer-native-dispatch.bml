//////////////////////////////////////////////////////////////////////
// form-cli-peer-native-dispatch.bml -- one high-grammar authority for the
// peer's explicit native route: grammar, typed action, and branch selection.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/form-cli-peer-agent.fk form-stdlib/form-cli-peer-direct-answer-action.fk form-stdlib/form-cli-peer-local-source-answer.fk form-stdlib/form-cli-peer-grounded-symbol-answer.fk form-stdlib/form-cli-peer-grounded-weave-answer.fk form-stdlib/bml/form-cli-resident-native-program.bml

section [form.bml] {
    class FormCliPeerNativeDispatch {
        field Route = "resident-native-program";
        field Carrier = "form-native-bml-bmf-resident-nodeid";
        field BranchRule = "native-program-branch-precedes-model-observation-and-generation";

        def fcpn-route() = Route();
        def fcpn-carrier() = Carrier();
        def fcpn-branch-rule() = BranchRule();

        def fcpn-digit?(byte) = if and(ge(byte, 48), le(byte, 57)) then 1 else 0;
        def fcpn-decimal-go(text, at) = if ge(at, str_len(text)) then 1 else if eq(fcpn-digit?(str_byte_at(text, at)), 1) then fcpn-decimal-go(text, add(at, 1)) else 0;
        def fcpn-decimal?(text) = if or(nothing?(text), eq(str_len(text), 0)) then 0 else fcpn-decimal-go(text, 0);
        def fcpn-response(invocation) = str_concat("resident-native-program signal=", fcrnp-invocation-signal(invocation));
        def fcpn-tool-status(loaded, invocation) = str_concat("loaded=", str_concat(fcrnp-loaded-status(loaded), str_concat(";bmf=", str_concat(fcrnp-compile-status(fcrnp-loaded-compile(loaded)), str_concat(";signal=", fcrnp-invocation-signal(invocation))))));
        def fcpn-lifecycle(invocation) = if str_eq(fcrnp-invocation-signal(invocation), "choice") then "choice,release" else "resident-nodeid,call,return,observe,release";
        def fcpn-peer(session, loaded, invocation, elapsed_ms) {
            let receipt = fcrnp-invocation-receipt(invocation);
            let present = if nothing?(receipt) then 0 else frpce-receipt-output(receipt);
            let value = if nothing?(receipt) then nothing() else frpce-receipt-value(receipt);
            fcpa-result-full(session, invocation, fcpn-response(invocation), elapsed_ms, 0, fcpn-route(), 0, fcpn-tool-status(loaded, invocation), fcpn-carrier(), present, value, 0, 0, fcpn-lifecycle(invocation), 0);
        }
        def fcpn-run(session, loaded, task_text) {
            let started = now_unix_ms();
            if not(eq(fcpn-decimal?(task_text), 1)) then fcpn-peer(session, loaded, fcrnp-invocation(loaded, nothing(), "choice", "native-program-requires-nonempty-decimal-signal"), sub(now_unix_ms(), started)) else fcpn-peer(session, loaded, fcrnp-invoke(loaded, str_to_int(task_text)), sub(now_unix_ms(), started));
        }

        def fcpn-direct-run(session, turn, task) {
            let first = fcpdaa-run(session, "direct-answer", task, fcpdaa-remaining-capacity(session));
            if and(eq(fcpalg-retry?(fcpdaa-signal(first)), 1), eq(fcpdaa-retryable?(first), 1)) then fcpdaa-run(fcpdaa-session(first), "direct-answer", fcpalg-retry-task(task), fcpdaa-remaining-capacity(fcpdaa-session(first))) else first;
        }
        def fcpn-run-task(session, source_ctx, native_program, turn, line) {
            let kind = fcpalg-kind(line);
            let task = fcpalg-body(line);
            if str_eq(kind, fcpn-route()) then fcpn-run(session, native_program, task) else if str_eq(kind, "recipe") then fcpa-run(fcpa-observe-task(session, turn, kind, task), 160) else if str_eq(kind, "grounded-weave") then fcpagw-peer(fcpagw-run(session, task, source_ctx, turn)) else if str_eq(kind, "grounded-answer") then fcpagsa-peer(fcpagsa-run(session, task, source_ctx, turn)) else if eq(fcpalsa-source-task?(kind), 1) then fcpalsa-peer(fcpalsa-run(session, kind, task, source_ctx, turn)) else fcpdaa-peer(fcpn-direct-run(session, turn, task));
        }
    }
    0;
}
