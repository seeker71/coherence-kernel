
(let AdapterPair (language-template-with-members "AdapterPair" (list "TVec") (list (language-template-member "a" "TVec") (language-template-member "b" "TVec") (language-template-member "rank" "int") (language-template-member "scale" "int"))))
(defn LoraWriterAuthorityPath () "form/form-stdlib/bml/form-cli-lora-writer.bml")
(defn LoraWriterAuthorityKind () "high-bml-class-template-field")
(defn FormLoraWriterAuthority () (list "abstraction" "FormLoraWriterAuthority" (list) (list) (list "LoraWriterAuthorityPath" "LoraWriterAuthorityKind") (list) (list)))
(defn Scale () 1000)
(defn Rank () 1)
(defn Tag () "lora-v1")
(defn AdapterPath () ".form-lora-adapter")
(defn Pipe () "|")
(defn Comma () ",")
(defn flw-authority () FormLoraWriterAuthority)
(defn flw-pattern () (list "dot" "forward" "emit" "write"))
(defn flw-none () (tail (list 0)))
(defn flw-scale () (Scale))
(defn flw-path () (AdapterPath))
(defn flw-dot (a b) (if (eq (len a) 0) 0 (add (div (mul (head a) (head b)) (Scale)) (flw-dot (tail a) (tail b)))))
(defn flw-scale-vec (v s) (if (eq (len v) 0) (flw-none) (cons (div (mul (head v) s) (Scale)) (flw-scale-vec (tail v) s))))
(defn flw-add (a b) (if (eq (len a) 0) (flw-none) (cons (add (head a) (head b)) (flw-add (tail a) (tail b)))))
(defn flw-eq-vec (a b) (if (and (eq (len a) 0) (eq (len b) 0)) 1 (if (eq (len a) (len b)) (if (eq (head a) (head b)) (flw-eq-vec (tail a) (tail b)) 0) 0)))
(defn flw-id-forward (B A x) (flw-add x (flw-scale-vec B (flw-dot A x))))
(defn flw-join-ints (xs) (if (eq (len xs) 0) "" (if (eq (len (tail xs)) 0) (int_to_str (head xs)) (str_concat (int_to_str (head xs)) (str_concat (Comma) (flw-join-ints (tail xs)))))))
(defn flw-emit (A B) (str_concat (Tag) (str_concat (Pipe) (str_concat (int_to_str (len A)) (str_concat (Pipe) (str_concat (int_to_str (Rank)) (str_concat (Pipe) (str_concat (int_to_str (Scale)) (str_concat (Pipe) (str_concat (flw-join-ints A) (str_concat (Pipe) (flw-join-ints B))))))))))))
(defn flw-parse-ints (xs) (if (eq (len xs) 0) (flw-none) (cons (str_to_int (head xs)) (flw-parse-ints (tail xs)))))
(defn flw-parse (s) (do (let parts (split-on s (Pipe))) (let A (flw-parse-ints (split-on (nth parts 4) (Comma)))) (let B (flw-parse-ints (split-on (nth parts 5) (Comma)))) (list (nth parts 0) (str_to_int (nth parts 1)) (str_to_int (nth parts 2)) (str_to_int (nth parts 3)) A B)))
(defn flw-write (path A B) (write_file_text path (flw-emit A B)))
(defn flw-written (path) (if (le (file_size path) 0) 0 (if (ge (str_find (read_file path) (Tag) 0) 0) 1 0)))
(defn flw-byte (s i) (if (ge i (str_len s)) 0 (ord (char_at s i))))
(defn flw-fill (s i n acc) (if (eq n 0) acc (flw-fill s (add i 1) (sub n 1) (cons (mul (add (flw-byte s i) 1) 4) acc))))
(defn flw-from-sample (s d) (do (let A (flw-fill s 0 d (flw-none))) (let B (flw-fill s d d (flw-none))) (list A B)))
(defn flw-ready (path) (flw-written path))
(defn flw-bit (ok bit) (if ok bit 0))
(defn flw-check () (do (let x (list 1000 2000 1000)) (let A (list 1000 0 0)) (let B (list 0 0 2000)) (let fwd (flw-id-forward B A x)) (let path (str_concat (fs-temp-dir) "/fk-lora-writer.txt")) (let w (flw-write path A B)) (let parsed (flw-parse (read_file path))) (let x8 (list 1000 0 0 0 0 0 0 0)) (let pair8 (flw-from-sample "heedmark is a token a carrier honors as a request" 8)) (let fwd8 (flw-id-forward (nth pair8 1) (nth pair8 0) x8)) (let pair8b (flw-from-sample "heedmark is a token a carrier honors as a request" 8)) (let c0 (flw-bit (and (eq (nth fwd 0) 1000) (and (eq (nth fwd 1) 2000) (eq (nth fwd 2) 3000))) 1)) (let c1 (flw-bit (not (eq (nth fwd 2) (nth x 2))) 2)) (let c2 (flw-bit (and (eq (flw-written path) 1) (str_eq (nth parsed 0) (Tag))) 4)) (let c3 (flw-bit (and (flw-eq-vec (nth parsed 4) A) (flw-eq-vec (nth parsed 5) B)) 8)) (let c4 (flw-bit (lt (add (len A) (len B)) (mul 3 3)) 16)) (let c5 (flw-bit (eq (len (nth pair8 0)) 8) 32)) (let c6 (flw-bit (not (flw-eq-vec fwd8 x8)) 64)) (let c7 (flw-bit (flw-eq-vec (nth pair8 0) (nth pair8b 0)) 128)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
(defn FormLoraWriter () (list "abstraction" "FormLoraWriter" (list "T") (list "flw-none" "flw-scale" "flw-path" "flw-dot" "flw-scale-vec" "flw-add" "flw-eq-vec" "flw-id-forward" "flw-join-ints" "flw-emit" "flw-parse-ints" "flw-parse" "flw-write" "flw-written" "flw-byte" "flw-fill" "flw-from-sample" "flw-ready" "flw-bit" "flw-check") (list "Scale" "Rank" "Tag" "AdapterPath" "Pipe" "Comma") (list "flw-authority") (list "flw-pattern")))
0
