; form-cli-mlx-ir.fk — MLX shapes as Form trees, not kernel C ops.
;
; Yes asked to leave predetermined mlx_add behind: generate, intern, learn,
; adapt. A node is (c v) or (op left right). Emit is postfix. mlx_run is
; the one door. mul and compose are recipes; they have no C opcode.
;
; Authority is this section. Crystallize with form-cli-mlx-ir-compile.fk.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-mlx-ir-band.fk
; witnessed: 2026-08-20 -> 255

section [form.lift] {
    allow mlg-c(v) = list("c", v);
    allow mlg-op(name, a, b) = list(name, a, b);
    allow mlg-atom(n) = if str_eq(nth(n, 0), "c") then 1 else 0;
    allow mlg-spc() = " ";
    allow mlg-emit(n) = if mlg-atom(n) == 1 then int_to_str(nth(n, 1)) else str_concat(mlg-emit(nth(n, 1)), str_concat(mlg-spc(), str_concat(mlg-emit(nth(n, 2)), str_concat(mlg-spc(), nth(n, 0)))));
    allow mlg-add2() = mlg-op("add", mlg-c(2), mlg-c(3));
    allow mlg-mul2() = mlg-op("mul", mlg-c(2), mlg-c(3));
    allow mlg-times4() = mlg-op("mul", mlg-add2(), mlg-c(4));
    allow mlg-has(book, name) = if len(book) == 0 then 0 else if str_eq(head(book), name) then 1 else mlg-has(tail(book), name);
    allow mlg-learn(book, name) = if mlg-has(book, name) == 1 then book else cons(name, book);
    allow mlg-seed() = list("add");
    allow mlg-after() = mlg-learn(mlg-learn(mlg-seed(), "mul"), "sub");
    allow mlg-check() = add(if str_eq(mlg-emit(mlg-add2()), "2 3 add") then 1 else 0, add(if str_eq(mlg-emit(mlg-mul2()), "2 3 mul") then 2 else 0, add(if str_eq(mlg-emit(mlg-times4()), "2 3 add 4 mul") then 4 else 0, add(if mlg-has(mlg-seed(), "mul") == 0 then 8 else 0, add(if mlg-has(mlg-after(), "mul") == 1 then 16 else 0, if len(mlg-after()) == 3 then 32 else 0)))));
    0;
}
