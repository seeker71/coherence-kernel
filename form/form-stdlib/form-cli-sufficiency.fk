; form-cli-sufficiency.fk — was the LOCAL answer enough, and what exactly remains?
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-router.fk form-stdlib/form-cli-judge.fk
;
; form-cli-router.fk picks where to START (a soft weighted fitness over sovereignty /
; trust / capability / confidence — an a-priori choice). This is its POSTERIOR partner:
; after the local lane actually answers, read THIS RUN's signals and decide accept / retry
; / local-gap. The soft signals remain valuable learning evidence, but they are not authority
; to spend a frontier turn. Weekly provider exhaustion disproved the old assumption that a
; subscription crossing was effectively free. A local-gap must pass the separate exact
; frontier-admission membrane below before any network crossing is offered.
;
; Signals — each a run-time read of the local oracle's actual answer this turn:
;   has-output   1 if non-empty                            (the lane produced something)
;   shape-ok     1 if it parses / fits the expected output shape
;   content      0..100 judge coverage of the answer's substance (the fcj rubric's score)
;   confidence   0..100 accumulated pass-rate of this lane (fcr-confidence-axis)
;   trust        0..100 accumulated success rate of this lane
;   retries-left how many local re-tries remain
;
; Verdict: 0 accept (local stands) / 1 retry (transient — re-run local) /
;          2 local-gap (local answer does not stand; NO remote authority).
; Reason : 0 ok / 1 empty / 2 bad-shape / 3 weak-content / 4 low-confidence / 5 low-trust.
;
; Proven by: form-stdlib/tests/form-cli-sufficiency-band.fk

(defn fsuf-signals (has-output shape-ok content confidence trust retries-left)
    (list has-output shape-ok content confidence trust retries-left))
(defn fsuf-has-output (s) (nth s 0))
(defn fsuf-shape-ok   (s) (nth s 1))
(defn fsuf-content    (s) (nth s 2))
(defn fsuf-confidence (s) (nth s 3))
(defn fsuf-trust      (s) (nth s 4))
(defn fsuf-retries    (s) (nth s 5))

; Hard shape axes are exact readings, not truthy numbers. This prevents an
; unknown/invalid sentinel from multiplying into a value that looks usable.
(defn fsuf-ready? (s)
    (if (and (eq (fsuf-has-output s) 1) (eq (fsuf-shape-ok s) 1)) 1 0))

; tunable policy DATA (like fcr-weights): (w-content w-confidence w-trust accept-threshold floor).
; quality is a weighted blend of the three soft axes; floor is a per-axis hard minimum below
; which a present, parseable answer still can't stand (a strong-on-paper lane that has never
; been proven — confidence/trust under the floor — does not get to answer alone). Change the
; body's behavior by changing this cell, not the math.
(defn fsuf-policy () (list 2 1 1 60 25))
(defn fsuf-w-content  () (nth (fsuf-policy) 0))
(defn fsuf-w-conf     () (nth (fsuf-policy) 1))
(defn fsuf-w-trust    () (nth (fsuf-policy) 2))
(defn fsuf-accept-thr () (nth (fsuf-policy) 3))
(defn fsuf-floor      () (nth (fsuf-policy) 4))

; the soft quality blend (0..100) — no single axis is a hard gate; they lift together.
(defn fsuf-quality (s)
    (div (add (add (mul (fsuf-w-content) (fsuf-content s))
                   (mul (fsuf-w-conf) (fsuf-confidence s)))
              (mul (fsuf-w-trust) (fsuf-trust s)))
         (add (add (fsuf-w-content) (fsuf-w-conf)) (fsuf-w-trust))))

; every soft axis at or above the floor — a present answer that no axis disqualifies.
(defn fsuf-above-floor? (s)
    (if (and (ge (fsuf-content s) (fsuf-floor))
             (and (ge (fsuf-confidence s) (fsuf-floor)) (ge (fsuf-trust s) (fsuf-floor)))) 1 0))

; which soft axis dragged below the floor (the escalation reason / the learning signal)
(defn fsuf-weak-reason (s)
    (if (lt (fsuf-content s) (fsuf-floor)) 3
        (if (lt (fsuf-confidence s) (fsuf-floor)) 4
            (if (lt (fsuf-trust s) (fsuf-floor)) 5 3))))

; THE verdict — soft, multi-signal:
;   garbled (no output OR bad shape) -> retry if a re-try remains, else local-gap
;   quality clears accept-threshold AND no axis under the floor -> accept (local stands)
;   otherwise -> local-gap (retain and learn from the signal; do not rent by implication)
(defn fsuf-verdict (s)
    (if (eq (fsuf-ready? s) 0)
        (if (gt (fsuf-retries s) 0) 1 2)
        (if (and (ge (fsuf-quality s) (fsuf-accept-thr)) (eq (fsuf-above-floor? s) 1)) 0 2)))

; the reason behind the verdict — what the crossing should teach
(defn fsuf-reason (s)
    (if (eq (fsuf-has-output s) 0) 1
        (if (eq (fsuf-shape-ok s) 0) 2
            (if (eq (fsuf-verdict s) 0) 0 (fsuf-weak-reason s)))))

; A posterior quality gap is observable without being a network permission.
(defn fsuf-local-gap? (s) (if (eq (fsuf-verdict s) 2) 1 0))

; Compatibility name retained so an old consumer cannot accidentally turn a
; soft score into a frontier call. The only live authority is
; fsuf-frontier-admit? over an exact local observation and frontier profile.
(defn fsuf-escalate? (s) 0)

; Stable names carried in the structured ask result. They are derived from the
; same proven verdict/reason values, never re-decided by the shell.
(defn fsuf-sufficient? (s) (if (eq (fsuf-verdict s) 0) 1 0))
(defn fsuf-verdict-name (v)
    (if (eq v 0) "accept" (if (eq v 1) "retry" "local-gap")))
(defn fsuf-reason-name (r)
    (if (eq r 0) "ok"
        (if (eq r 1) "empty"
            (if (eq r 2) "bad-shape"
                (if (eq r 3) "weak-content"
                    (if (eq r 4) "low-confidence" "low-trust"))))))

; ── exact frontier admission ────────────────────────────────────────────────
;
; A frontier call is not the third lane of a score. It is a one-shot teacher
; invited for one capability the local body just proved it could not perform.
; No prompt or answer content enters this membrane. NodeIDs, attempt identity,
; terminal status and capability identity are sufficient to orient the rented
; mind while the body retains the full private context locally.
;
; local observation =
;   attempt-id request-nodeid model-id status gap-nodeid gap-capability
;   local-alternatives-left capture-ready
; status is one of: answered | nothing | timeout | failure | bad-shape |
;                   unsupported | quality-signal
; "quality-signal" retains weak-content/confidence/trust without pretending it
; is a witnessed inability. nothing remains a named terminal signal distinct
; from the explicit answer values 0 and 1.
(defn fsuf-local-observation
    (attempt-id request-nodeid model-id status gap-nodeid gap-capability
     local-alternatives-left capture-ready)
    (list attempt-id request-nodeid model-id status gap-nodeid gap-capability
          local-alternatives-left capture-ready))
(defn fsuf-obs-attempt (o) (nth o 0))
(defn fsuf-obs-request (o) (nth o 1))
(defn fsuf-obs-model (o) (nth o 2))
(defn fsuf-obs-status (o) (nth o 3))
(defn fsuf-obs-gap (o) (nth o 4))
(defn fsuf-obs-capability (o) (nth o 5))
(defn fsuf-obs-local-left (o) (nth o 6))
(defn fsuf-obs-capture-ready (o) (nth o 7))

; frontier profile = provider capability available turns-used
(defn fsuf-frontier-profile (provider capability available turns-used)
    (list provider capability available turns-used))
(defn fsuf-frontier-provider (p) (nth p 0))
(defn fsuf-frontier-capability (p) (nth p 1))
(defn fsuf-frontier-available (p) (nth p 2))
(defn fsuf-frontier-turns-used (p) (nth p 3))

; Compact identifiers only. This rejects whitespace, separators and control
; bytes so a caller cannot smuggle prose/transcript content through an id cell.
(defn fsuf-id-byte? (b)
    (if (or (and (ge b 48) (le b 57))
        (or (and (ge b 65) (le b 90))
        (or (and (ge b 97) (le b 122))
        (or (eq b 45) (or (eq b 95) (or (eq b 46) (eq b 64))))))) 1 0))
(defn fsuf-id-loop? (s i)
    (if (ge i (str_len s)) 1
        (if (eq (fsuf-id-byte? (str_byte_at s i)) 1)
            (fsuf-id-loop? s (add i 1)) 0)))
(defn fsuf-id? (s)
    (if (and (gt (str_len s) 0)
             (and (le (str_len s) 128) (eq (fsuf-id-loop? s 0) 1))) 1 0))
(defn fsuf-nodeid? (s)
    (if (and (eq (fsuf-id? s) 1)
             (eq (str_byte_at s 0) 64)) 1 0))

; Canonical decimal cells prevent parser coercion from turning absent or prose
; evidence into zero. Zero itself remains valid and distinct from nothing.
(defn fsuf-decimal-byte? (b) (if (and (ge b 48) (le b 57)) 1 0))
(defn fsuf-uint-loop? (s i)
    (if (ge i (str_len s)) 1
        (if (eq (fsuf-decimal-byte? (str_byte_at s i)) 1)
            (fsuf-uint-loop? s (add i 1)) 0)))
(defn fsuf-uint? (s)
    (if (or (eq (str_len s) 0) (gt (str_len s) 10)) 0
        (if (and (gt (str_len s) 1) (eq (str_byte_at s 0) 48)) 0
            (fsuf-uint-loop? s 0))))

(defn fsuf-status-hard-gap? (s)
    (if (or (str_eq s "nothing")
        (or (str_eq s "timeout")
        (or (str_eq s "failure")
        (or (str_eq s "bad-shape")
            (str_eq s "unsupported"))))) 1 0))

(defn fsuf-local-observation-valid? (o)
    (if (and (eq (len o) 8)
        (and (eq (fsuf-id? (fsuf-obs-attempt o)) 1)
        (and (eq (fsuf-nodeid? (fsuf-obs-request o)) 1)
        (and (eq (fsuf-id? (fsuf-obs-model o)) 1)
        (and (eq (fsuf-status-hard-gap? (fsuf-obs-status o)) 1)
        (and (eq (fsuf-nodeid? (fsuf-obs-gap o)) 1)
        (and (eq (fsuf-id? (fsuf-obs-capability o)) 1)
        (and (ge (fsuf-obs-local-left o) 0)
             (or (eq (fsuf-obs-capture-ready o) 0)
                 (eq (fsuf-obs-capture-ready o) 1)))))))))) 1 0))

(defn fsuf-frontier-profile-valid? (p)
    (if (and (eq (len p) 4)
        (and (eq (fsuf-id? (fsuf-frontier-provider p)) 1)
        (and (eq (fsuf-id? (fsuf-frontier-capability p)) 1)
        (and (or (eq (fsuf-frontier-available p) 0)
                 (eq (fsuf-frontier-available p) 1))
             (ge (fsuf-frontier-turns-used p) 0))))) 1 0))

; ONE authority to cross. Every conjunct is an observed signal. A low score,
; missing packet field, still-resident local alternative, exhausted provider,
; second frontier turn, mismatched capability, or absent capture path stays 0.
(defn fsuf-frontier-admit? (o p)
    (if (and (eq (fsuf-local-observation-valid? o) 1)
        (and (eq (fsuf-frontier-profile-valid? p) 1)
        (and (eq (fsuf-obs-local-left o) 0)
        (and (eq (fsuf-obs-capture-ready o) 1)
        (and (eq (fsuf-frontier-available p) 1)
        (and (eq (fsuf-frontier-turns-used p) 0)
             (str_eq (fsuf-obs-capability o)
                     (fsuf-frontier-capability p)))))))) 1 0))

(defn fsuf-frontier-packet-field (value rest)
    (str_concat value (str_concat "|" rest)))
(defn fsuf-frontier-packet (o p)
    (if (eq (fsuf-frontier-admit? o p) 0) ""
        (str_concat "frontier-escalation-v1|"
        (fsuf-frontier-packet-field (fsuf-obs-request o)
        (fsuf-frontier-packet-field (fsuf-obs-attempt o)
        (fsuf-frontier-packet-field (fsuf-obs-model o)
        (fsuf-frontier-packet-field (fsuf-obs-status o)
        (fsuf-frontier-packet-field (fsuf-obs-gap o)
        (fsuf-frontier-packet-field (fsuf-obs-capability o)
                                    (fsuf-frontier-provider p))))))))))
(defn fsuf-frontier-packet-bytes (o p)
    (str_len (fsuf-frontier-packet o p)))

; A frontier return is not complete until it leaves one local lesson NodeID.
; This receipt contains identity and outcome only; the learned content remains
; in its addressed cell rather than in logs or the framebuffer.
(defn fsuf-frontier-return
    (request-nodeid attempt-id provider lesson-nodeid outcome observed)
    (list request-nodeid attempt-id provider lesson-nodeid outcome observed))
(defn fsuf-frontier-return-valid? (r)
    (if (and (eq (len r) 6)
        (and (eq (fsuf-nodeid? (nth r 0)) 1)
        (and (eq (fsuf-id? (nth r 1)) 1)
        (and (eq (fsuf-id? (nth r 2)) 1)
        (and (eq (fsuf-nodeid? (nth r 3)) 1)
        (and (or (str_eq (nth r 4) "learned")
                 (str_eq (nth r 4) "refused"))
             (eq (nth r 5) 1))))))) 1 0))
0
