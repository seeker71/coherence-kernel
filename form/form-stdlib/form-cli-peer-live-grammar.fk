; form-cli-peer-live-grammar.fk — BML-authorized compact task routing for the
; held local peer.  Ordinary task text asks for a direct local answer; recipe
; execution is explicit rather than an accidental parser detour.
;
; preludes: form-stdlib/bml/form-cli-resident-continuity.bml

(do
    (defn fcpalg-is-recipe? (text)
        (if (eq (str_find text (frc-explicit-recipe-prefix) 0) 0) 1 0))
    (defn fcpalg-kind (text)
        (if (eq (fcpalg-is-recipe? text) 1) "recipe"
            (frc-default-task-route)))
    (defn fcpalg-body (text)
        (if (eq (fcpalg-is-recipe? text) 1)
            (substring text (str_len (frc-explicit-recipe-prefix)) (str_len text))
            text))
    (defn fcpalg-retry? (signal)
        (if (or (str_eq signal "failure") (str_eq signal "nothing")) 1 0))
    (defn fcpalg-retry-task (task)
        (str_concat "Answer the preceding task directly and plainly; do not emit a control token. Task: " task))
    0)
