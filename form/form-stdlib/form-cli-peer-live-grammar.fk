; form-cli-peer-live-grammar.fk — BML-authorized compact task routing for the
; held local peer.  Ordinary task text asks for a direct local answer; recipe
; execution is explicit rather than an accidental parser detour.
;
; preludes: form-stdlib/bml/form-cli-resident-continuity.bml

(do
    (defn fcpalg-is-recipe? (text)
        (if (eq (str_find text (frc-explicit-recipe-prefix) 0) 0) 1 0))
    (defn fcpalg-is-source? (text)
        (if (eq (str_find text (frc-explicit-source-prefix) 0) 0) 1 0))
    (defn fcpalg-is-symbol? (text)
        (if (eq (str_find text (frc-explicit-symbol-prefix) 0) 0) 1 0))
    (defn fcpalg-is-grounded? (text)
        (if (eq (str_find text (frc-explicit-ground-prefix) 0) 0) 1 0))
    (defn fcpalg-is-weave? (text)
        (if (eq (str_find text (frc-explicit-weave-prefix) 0) 0) 1 0))
    (defn fcpalg-source-body (text)
        (substring text (str_len (frc-explicit-source-prefix)) (str_len text)))
    ; The route kind is a parser result, never a filesystem choice.  The
    ; caller-born source context remains fixed in the selected action.
    (defn fcpalg-source-kind (text)
        (do
            (let body (fcpalg-source-body text))
            (if (and (gt (str_len body) 0) (eq (str_byte_at body 0) 64))
                "source-nodeid"
                "source-concept")))
    (defn fcpalg-kind (text)
        (if (eq (fcpalg-is-recipe? text) 1) "recipe"
            (if (eq (fcpalg-is-weave? text) 1) "grounded-weave"
                (if (eq (fcpalg-is-grounded? text) 1) "grounded-answer"
                    (if (eq (fcpalg-is-symbol? text) 1) "source-symbol"
                        (if (eq (fcpalg-is-source? text) 1)
                            (fcpalg-source-kind text)
                            (frc-default-task-route)))))))
    (defn fcpalg-body (text)
        (if (eq (fcpalg-is-recipe? text) 1)
            (substring text (str_len (frc-explicit-recipe-prefix)) (str_len text))
            (if (eq (fcpalg-is-weave? text) 1)
                (substring text (str_len (frc-explicit-weave-prefix)) (str_len text))
                (if (eq (fcpalg-is-grounded? text) 1)
                    (substring text (str_len (frc-explicit-ground-prefix)) (str_len text))
                    (if (eq (fcpalg-is-symbol? text) 1)
                        (substring text (str_len (frc-explicit-symbol-prefix)) (str_len text))
                        (if (eq (fcpalg-is-source? text) 1)
                            (fcpalg-source-body text)
                            text))))))
    (defn fcpalg-retry? (signal)
        (if (or (str_eq signal "failure") (str_eq signal "nothing")) 1 0))
    (defn fcpalg-retry-task (task)
        (str_concat "Answer the preceding task directly and plainly; do not emit a control token. Task: " task))
    0)
