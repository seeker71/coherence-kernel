//////////////////////////////////////////////////////////////////////
//
// bearing-census.bml — how much of the body stands on a given door.
//
// Authority: form-stdlib/bml/bearing-census.bml
// preludes: form/form-stdlib/core.fk
// Proven by: form-stdlib/tests/bearing-census-band.fk
//
// The body already knows whether each door ANSWERS RIGHTLY: every band says
// so. What it had no measure of, until this cell, is how much of its own
// walking happens AT OR BENEATH a door — so a door that answers rightly and
// costs the world stayed invisible for as long as its correctness held.
// `substring` walked at 4.59 MB/s underneath every parser, frame reader and
// row walker in this tree for months, and was found by tripping over it
// (corpus row 1345, keeldrag). The question that row left open is the one
// this cell answers with a number: which door is next.
//
// Three readings, from two ledgers the seed already keeps:
//
//   calls    — kernel_hot_rows heat: the times the WALKER entered this defn.
//              A defn the JIT crystallized stops accruing here, because it
//              stopped walking; that is the measure working, not a blind spot.
//   bearing  — calls at this door plus the calls of every door reachable from
//              it. A leaf door three levels down that does the real per-byte
//              work carries its own weight AND its helpers'; a thin door that
//              only forwards carries what it forwards to.
//   leaning  — how many distinct doors reach this one. Two callers make a
//              door carry both their weights; this is the count of what would
//              break, or speed up, if the door changed.
//
// And the two that turn a reading into a decision:
//
//   per-call — bearing per invocation, x100. A cheap door called a million
//              times and an expensive door called twice have the same bearing
//              and want opposite repairs; only this tells them apart.
//   remedy   — a door whose NAME the op table already carries as a native is
//              never "mint a native": the native stands, and the walking that
//              still reaches the recipe is a routing wound. A door with no
//              native twin and real drag is the next substring.
//
// The graph is drawn from the source, and each door is found there by its NAME.
// A hot row's unit and line are coordinates in the resolved text of a resolution
// frame, not in the file on disk, so reading a body at that line would quote the
// wrong door with total confidence; the units are walked once instead, and a door
// whose body is in none of them is named unread rather than drawn with no callees.
// The names a body mentions become its callees, boundary-checked — so `substring`
// inside `fstr-substring-loop` is not an edge — and comments are cut first, since
// this tree's prose names doors densely enough to invent a graph of its own.
//
// Every number here is honest about its own absence. A door with no row says
// -1 (no reading), never 0 (free) — the distinction the whole measure exists
// for. And the census carries its own coverage: the share of the body's
// walking the snapshot actually saw, so a top-N reading cannot pass itself
// off as the whole body.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class BearingCensusAuthority {
        field BCSAuthorityPath = "form/form-stdlib/bml/bearing-census.bml";
        field BCSAuthorityKind = "high-bml-interface-class-const";
    }

    class BearingCensus {
        field BCSSensor = "bearing";
        field BCSCadenceMs = 5000;
        field BCSScale = 10000;
        field BCSTopN = 40;
        field BCSBodyLines = 40;
        field BCSNoReading = -1;
        ref bcs-authority = BearingCensusAuthority;
        thought bcs-pattern = list("no-reading-is-not-free", "bearing-includes-what-it-calls", "a-native-is-not-a-recipe-to-heal", "coverage-travels-with-the-census", "the-graph-comes-from-the-source-the-row-points-at");

        // --- the hot row, as kernel_hot_rows gives it -------------------------
        // list(heat, name, unit, line, col, boxes, unboxes, crystal, spare)
        def bcs-heat(r) = len(r) < 2 ? 0 : r[0];
        def bcs-name(r) = len(r) < 2 ? "" : r[1];
        def bcs-unit(r) = len(r) < 3 ? "" : r[2];
        def bcs-line(r) = len(r) < 4 ? 0 : r[3];
        def bcs-crystal(r) = len(r) < 8 ? 0 : r[7];

        def bcs-names(rows) = (Comparable) len(rows) == 0 ? list() : cons(bcs-name(head(rows)), bcs-names(tail(rows)));
        def bcs-member?(names, n) = (Comparable) len(names) == 0 ? 0 : (String) head(names) == n ? 1 : bcs-member?(tail(names), n);
        def bcs-row-of(rows, name) = (Comparable) len(rows) == 0 ? list() : (String) bcs-name(head(rows)) == name ? head(rows) : bcs-row-of(tail(rows), name);
        // measured or not is the first question asked of any door: an absent row is a missing
        // reading, and every number downstream of it answers -1 rather than a confident zero
        def bcs-measured?(rows, name) = (Comparable) len(bcs-row-of(rows, name)) == 0 ? 0 : 1;
        def bcs-heat-of(rows, name) = (Comparable) bcs-measured?(rows, name) == 0 ? 0 : bcs-heat(bcs-row-of(rows, name));
        def bcs-total-heat(rows, acc) = (Comparable) len(rows) == 0 ? acc : bcs-total-heat(tail(rows), acc + bcs-heat(head(rows)));

        // --- the call graph: edges are list(caller, callee) --------------------
        def bcs-callees(edges, name, acc) = (Comparable) len(edges) == 0 ? acc : bcs-callees(tail(edges), name, (String) head(edges)[0] == name ? cons(head(edges)[1], acc) : acc);
        // the reachable set INCLUDES the door itself, so bearing counts its own steps first;
        // the seen list is the cycle guard, so a recursive door is walked once, not forever
        def bcs-reach-go(edges, frontier, seen) = (Comparable) len(frontier) == 0 ? seen : bcs-reach-step(edges, head(frontier), tail(frontier), seen);
        def bcs-reach-step(edges, n, rest, seen) = (Comparable) bcs-member?(seen, n) == 1 ? bcs-reach-go(edges, rest, seen) : bcs-reach-go(edges, append(bcs-callees(edges, n, list()), rest), cons(n, seen));
        def bcs-reach(edges, name) = bcs-reach-go(edges, list(name), list());
        // every door's reach is computed once and held, so leaning is a membership walk
        // over short lists instead of N squared closures
        def bcs-reaches(edges, names) = (Comparable) len(names) == 0 ? list() : cons(list(head(names), bcs-reach(edges, head(names))), bcs-reaches(edges, tail(names)));
        def bcs-reach-of(reaches, name) = (Comparable) len(reaches) == 0 ? list() : (String) head(reaches)[0] == name ? head(reaches)[1] : bcs-reach-of(tail(reaches), name);

        // --- the three readings ------------------------------------------------
        def bcs-sum-heat(rows, names, acc) = (Comparable) len(names) == 0 ? acc : bcs-sum-heat(rows, tail(names), acc + bcs-heat-of(rows, head(names)));
        def bcs-bearing(rows, reaches, name) = (Comparable) bcs-measured?(rows, name) == 0 ? BCSNoReading() : bcs-sum-heat(rows, bcs-reach-of(reaches, name), 0);
        def bcs-leaning(reaches, target, acc) = (Comparable) len(reaches) == 0 ? acc : bcs-leaning(tail(reaches), target, (!((String) head(reaches)[0] == target)) && ((Comparable) bcs-member?(head(reaches)[1], target) == 1) ? (acc + 1) : acc);
        def bcs-share-bp(bearing, total) = (total <= 0) || (bearing < 0) ? BCSNoReading() : ((bearing * BCSScale()) / total);
        def bcs-per-call(bearing, calls) = (calls <= 0) || (bearing < 0) ? BCSNoReading() : ((bearing * 100) / calls);
        // the census's own honesty: the share of the body's whole walking this snapshot saw.
        // A top-N reading that cannot say what it missed is a reading that reads its own edge as the world
        def bcs-coverage-bp(seen, walked) = walked <= 0 ? BCSNoReading() : ((seen * BCSScale()) / walked);

        // --- the natives the seed already carries ------------------------------
        // the op table is a row set in text: every native stands as `{ "name",` on its own line.
        // One forward pass lifts every name; membership is then str_eq, not another scan per door.
        def bcs-open() = "{ " ++ byte_to_str(34);
        def bcs-native-names-go(table, from, acc) = bcs-native-names-at(table, str_find(table, bcs-open(), from), acc);
        def bcs-native-names-at(table, at, acc) = at < 0 ? acc : bcs-native-names-close(table, at + str_len(bcs-open()), acc);
        def bcs-native-names-close(table, i, acc) = bcs-native-names-take(table, i, str_find(table, byte_to_str(34), i), acc);
        def bcs-native-names-take(table, i, close, acc) = close < 0 ? acc : bcs-native-names-go(table, close + 1, cons(substring(table, i, close), acc));
        def bcs-native-names(table) = bcs-native-names-go(table, 0, list());
        def bcs-native?(natives, name) = bcs-member?(natives, name);

        // A door can carry a native's MEANING under another name. sha256.fk walks its own
        // `nth-rec` seventy-six million times on a locale read while `nth` stands native at
        // tag 23; nothing in the name says so, and every band it sits under is green. So the
        // stem — the name with one working suffix cut, or the file's own prefix — is held
        // against the op table, and a match is reported as a TWIN and not as proof: it names
        // the native to check against, and the reader decides whether the meanings are one.
        def bcs-ends-with?(s, suf) = str_len(suf) > str_len(s) ? 0 : (String) substring(s, str_len(s) - str_len(suf), str_len(s)) == suf ? 1 : 0;
        def bcs-cut-suffix(s, suf) = (Comparable) bcs-ends-with?(s, suf) == 1 ? substring(s, 0, str_len(s) - str_len(suf)) : s;
        def bcs-cut-prefix(s, pre) = (Comparable) bcs-starts-with?(s, 0, pre) == 1 ? substring(s, str_len(pre), str_len(s)) : s;
        def bcs-suffixes() = list("-rec", "-loop", "-go", "-acc", "-next", "-1", "-here", "-in");
        def bcs-cut-any(s, sufs) = (Comparable) len(sufs) == 0 ? s : bcs-cut-any-next(s, sufs, bcs-cut-suffix(s, head(sufs)));
        def bcs-cut-any-next(s, sufs, cut) = !((String) cut == s) ? cut : bcs-cut-any(s, tail(sufs));
        def bcs-stem(name) = bcs-cut-prefix(bcs-cut-any(name, bcs-suffixes()), "fstr-");
        def bcs-twin(natives, name) = bcs-twin-of(natives, name, bcs-stem(name));
        def bcs-twin-of(natives, name, stem) = (String) stem == name ? "" : (Comparable) bcs-member?(natives, stem) == 1 ? stem : "";
        def bcs-twinned?(natives, name) = str_len(bcs-twin(natives, name)) > 0 ? 1 : 0;

        // --- what the reading asks for -----------------------------------------
        // a door the op table already carries is never "mint a native": the native stands,
        // and walking that still reaches the recipe is a routing wound, a different repair
        def bcs-kind(natives, rows, name) = (Comparable) bcs-measured?(rows, name) == 0 ? "no-reading" : (Comparable) bcs-native?(natives, name) == 1 ? "shadowed" : bcs-crystal(bcs-row-of(rows, name)) > 0 ? "crystal" : (Comparable) bcs-twinned?(natives, name) == 1 ? "twinned" : "recipe";
        def bcs-remedy(natives, rows, name) = (Comparable) bcs-measured?(rows, name) == 0 ? "no-reading" : (Comparable) bcs-native?(natives, name) == 1 ? "route-to-the-native-that-stands" : bcs-crystal(bcs-row-of(rows, name)) > 0 ? "stands-crystallized" : (Comparable) bcs-twinned?(natives, name) == 1 ? "check against the native " ++ bcs-twin(natives, name) : "mint-a-native";
        // a twinned door still carries its cost, so it stays in the ranking; only its remedy
        // changes, from minting a native to checking the one that already stands
        def bcs-heal?(natives, rows, name) = (String) bcs-remedy(natives, rows, name) == "mint-a-native" ? 1 : (String) bcs-kind(natives, rows, name) == "twinned" ? 1 : 0;
        // drag ranks the heal candidates only. Share alone puts a hot root on top; leaning alone
        // puts a tiny shared helper on top; the product is the door whose cost is large AND spread
        // across many callers -- the shape substring wore
        def bcs-drag(shareBp, leaning, heal) = ((Comparable) heal == 0) || (shareBp < 0) ? 0 : (shareBp * (leaning + 1));

        // --- a census cell ------------------------------------------------------
        // list(name, calls, bearing, shareBp, perCall, leaning, kind, remedy, drag, unit, line)
        def bcs-cell(rows, reaches, natives, total, name) = bcs-cell-with(rows, natives, name, bcs-heat-of(rows, name), bcs-bearing(rows, reaches, name), total, bcs-leaning(reaches, name, 0));
        def bcs-cell-with(rows, natives, name, calls, bearing, total, leaning) = bcs-cell-at(rows, natives, name, calls, bearing, leaning, bcs-share-bp(bearing, total));
        def bcs-cell-at(rows, natives, name, calls, bearing, leaning, shareBp) = list(name, calls, bearing, shareBp, bcs-per-call(bearing, calls), leaning, bcs-kind(natives, rows, name), bcs-remedy(natives, rows, name), bcs-drag(shareBp, leaning, bcs-heal?(natives, rows, name)), bcs-unit(bcs-row-of(rows, name)), bcs-line(bcs-row-of(rows, name)));
        def bcs-c-name(c) = (Comparable) len(c) == 0 ? "" : c[0];
        def bcs-c-calls(c) = (Comparable) len(c) == 0 ? BCSNoReading() : c[1];
        def bcs-c-bearing(c) = (Comparable) len(c) == 0 ? BCSNoReading() : c[2];
        def bcs-c-share(c) = (Comparable) len(c) == 0 ? BCSNoReading() : c[3];
        def bcs-c-per-call(c) = (Comparable) len(c) == 0 ? BCSNoReading() : c[4];
        def bcs-c-leaning(c) = (Comparable) len(c) == 0 ? BCSNoReading() : c[5];
        def bcs-c-kind(c) = (Comparable) len(c) == 0 ? "no-reading" : c[6];
        def bcs-c-remedy(c) = (Comparable) len(c) == 0 ? "no-reading" : c[7];
        def bcs-c-drag(c) = (Comparable) len(c) == 0 ? 0 : c[8];
        def bcs-c-unit(c) = (Comparable) len(c) == 0 ? "" : c[9];
        def bcs-c-line(c) = (Comparable) len(c) == 0 ? 0 : c[10];

        def bcs-census-over(rows, reaches, natives, total, names) = (Comparable) len(names) == 0 ? list() : cons(bcs-cell(rows, reaches, natives, total, head(names)), bcs-census-over(rows, reaches, natives, total, tail(names)));
        def bcs-census(rows, edges, natives) = bcs-census-over(rows, bcs-reaches(edges, bcs-names(rows)), natives, bcs-total-heat(rows, 0), bcs-names(rows));
        def bcs-of(census, name) = (Comparable) len(census) == 0 ? list() : (String) bcs-c-name(head(census)) == name ? head(census) : bcs-of(tail(census), name);

        // --- the standing name ---------------------------------------------------
        def bcs-insert(c, sorted) = (Comparable) len(sorted) == 0 ? list(c) : bcs-c-drag(c) >= bcs-c-drag(head(sorted)) ? cons(c, sorted) : cons(head(sorted), bcs-insert(c, tail(sorted)));
        def bcs-sort(census) = (Comparable) len(census) == 0 ? list() : bcs-insert(head(census), bcs-sort(tail(census)));
        def bcs-worst-go(census, held) = (Comparable) len(census) == 0 ? held : bcs-worst-go(tail(census), bcs-c-drag(head(census)) > bcs-c-drag(held) ? head(census) : held);
        def bcs-worst(census) = bcs-worst-go(census, list());
        // the answer to "what is the next substring?" as one name a glass row can carry.
        // No candidate is a whole answer, not an empty one: a body walking only natives has no next substring
        def bcs-worst-name(census) = bcs-worst-name-of(bcs-worst(census));
        def bcs-worst-name-of(c) = (Comparable) len(c) == 0 ? "no-reading" : (Comparable) bcs-c-drag(c) == 0 ? "no-recipe-carries-drag" : bcs-c-name(c);
        def bcs-take(l, n) = (n <= 0) || ((Comparable) len(l) == 0) ? list() : cons(head(l), bcs-take(tail(l), n - 1));
        def bcs-heal-list(census) = (Comparable) len(census) == 0 ? list() : bcs-c-drag(head(census)) > 0 ? cons(head(census), bcs-heal-list(tail(census))) : bcs-heal-list(tail(census));

        // --- the graph, read off the source each hot row points at -----------------
        def bcs-split-go(text, sep, from, acc) = bcs-split-at(text, sep, from, acc, str_find(text, sep, from));
        def bcs-split-at(text, sep, from, acc, at) = at < 0 ? reverse(cons(substring(text, from, str_len(text)), acc)) : bcs-split-go(text, sep, at + str_len(sep), cons(substring(text, from, at), acc));
        def bcs-split(text, sep) = (Comparable) str_len(text) == 0 ? list() : bcs-split-go(text, sep, 0, list());
        def bcs-lines(text) = bcs-split(text, byte_to_str(10));
        def bcs-nth-line(lines, n) = (n < 1) || (n > len(lines)) ? "" : lines[n - 1];

        def bcs-space?(b) = (Comparable) b == 32 ? 1 : (Comparable) b == 9 ? 1 : 0;
        def bcs-skip-spaces(s, i) = i >= str_len(s) ? i : (Comparable) bcs-space?(str_byte_at(s, i)) == 1 ? bcs-skip-spaces(s, i + 1) : i;
        def bcs-starts-with?(s, i, p) = (i + str_len(p)) > str_len(s) ? 0 : (String) substring(s, i, i + str_len(p)) == p ? 1 : 0;
        // both authoring lanes open a door the same way to a reader: `def name(` in BML,
        // `(defn name ` in Form. A line that opens one ends the body above it
        def bcs-opens-def?(line) = bcs-opens-def-at(line, bcs-skip-spaces(line, 0));
        def bcs-opens-def-at(line, i) = (Comparable) bcs-starts-with?(line, i, "def ") == 1 ? 1 : (Comparable) bcs-starts-with?(line, i, "(defn ") == 1 ? 1 : 0;
        // a comment is not a call. This tree's comments name doors densely — core.fk's own
        // note about substring says the word twenty times — so a graph drawn over raw text
        // would give every door an edge to whatever its prose discusses. The cut is at the
        // first `;` or `//`, which loses a call standing after a semicolon inside a string
        // literal: the measure would rather miss an edge than invent one.
        def bcs-min-mark(a, b) = a < 0 ? b : b < 0 ? a : a < b ? a : b;
        def bcs-comment-at(line) = bcs-min-mark(str_find(line, ";", 0), str_find(line, "//", 0));
        def bcs-strip-comment(line) = bcs-strip-at(line, bcs-comment-at(line));
        def bcs-strip-at(line, i) = i < 0 ? line : substring(line, 0, i);
        def bcs-body-go(lines, n, left, acc) = (left <= 0) || (n > len(lines)) ? acc : bcs-body-next(lines, n, left, acc, bcs-nth-line(lines, n));
        def bcs-body-next(lines, n, left, acc, line) = (str_len(acc) > 0) && ((Comparable) bcs-opens-def?(line) == 1) ? acc : bcs-body-go(lines, n + 1, left - 1, acc ++ byte_to_str(10) ++ bcs-strip-comment(line));
        def bcs-body(lines, n) = bcs-body-go(lines, n, BCSBodyLines(), "");

        // a name mention is an edge only on both boundaries: `substring` inside
        // `fstr-substring-loop` is the same bytes and not the same door
        def bcs-name-byte?(b) = (b >= 97) && (b <= 122) ? 1 : (b >= 65) && (b <= 90) ? 1 : (b >= 48) && (b <= 57) ? 1 : (Comparable) b == 45 ? 1 : (Comparable) b == 95 ? 1 : (Comparable) b == 63 ? 1 : (Comparable) b == 33 ? 1 : 0;
        def bcs-left-free?(text, at) = at <= 0 ? 1 : (Comparable) bcs-name-byte?(str_byte_at(text, at - 1)) == 1 ? 0 : 1;
        def bcs-right-free?(text, end) = end >= str_len(text) ? 1 : (Comparable) bcs-name-byte?(str_byte_at(text, end)) == 1 ? 0 : 1;
        def bcs-mentions-go(text, name, from) = bcs-mentions-at(text, name, from, str_find(text, name, from));
        def bcs-mentions-at(text, name, from, at) = at < 0 ? 0 : ((Comparable) bcs-left-free?(text, at) == 1) && ((Comparable) bcs-right-free?(text, at + str_len(name)) == 1) ? 1 : bcs-mentions-go(text, name, at + 1);
        def bcs-mentions?(text, name) = (Comparable) str_len(name) == 0 ? 0 : bcs-mentions-go(text, name, 0);

        def bcs-edges-for(caller, body, names, acc) = (Comparable) len(names) == 0 ? acc : bcs-edges-for(caller, body, tail(names), (!((String) head(names) == caller)) && ((Comparable) bcs-mentions?(body, head(names)) == 1) ? cons(list(caller, head(names)), acc) : acc);

        // --- finding a door's body by NAME, never by the row's line -----------------
        // A hot row's unit and line are coordinates in the RESOLVED text of a resolution
        // frame, not in the file on disk: witnessed 2026-09-07, core.fk's own defns land on
        // their true lines while a preluded unit's defns drift, and a band loaded as a
        // prelude reports every door under the first unit. Reading a body at that line
        // would quote the wrong door with total confidence. So the body is found by the
        // name the row carries, and a door whose body is nowhere in the units given is
        // named unread rather than silently drawn with no callees.
        def bcs-name-end(s, i) = i >= str_len(s) ? i : (Comparable) bcs-name-byte?(str_byte_at(s, i)) == 1 ? bcs-name-end(s, i + 1) : i;
        def bcs-def-name(line) = bcs-def-name-at(line, bcs-skip-spaces(line, 0));
        def bcs-def-name-at(line, i) = (Comparable) bcs-starts-with?(line, i, "def ") == 1 ? substring(line, i + 4, bcs-name-end(line, i + 4)) : (Comparable) bcs-starts-with?(line, i, "(defn ") == 1 ? substring(line, i + 6, bcs-name-end(line, i + 6)) : "";
        // the body walks the remaining lines directly rather than indexing by number:
        // nth into a fifteen-thousand-line unit is a walk per line, and the walk of walks
        // is the very cost this cell exists to find
        def bcs-body-here(rest) = bcs-body-here-go(rest, BCSBodyLines(), "");
        def bcs-body-here-go(rest, left, acc) = (left <= 0) || ((Comparable) len(rest) == 0) ? acc : (str_len(acc) > 0) && ((Comparable) bcs-opens-def?(head(rest)) == 1) ? acc : bcs-body-here-go(tail(rest), left - 1, acc ++ byte_to_str(10) ++ bcs-strip-comment(head(rest)));

        // one pass per unit builds name -> body for the doors under census; the first
        // definition of a name wins, the way the resolver reads it
        def bcs-index-has?(index, nm) = (Comparable) len(index) == 0 ? 0 : (String) head(index)[0] == nm ? 1 : bcs-index-has?(tail(index), nm);
        def bcs-index-body(index, nm) = (Comparable) len(index) == 0 ? "" : (String) head(index)[0] == nm ? head(index)[1] : bcs-index-body(tail(index), nm);
        def bcs-index-add(index, nm, body) = (Comparable) bcs-index-has?(index, nm) == 1 ? index : cons(list(nm, body), index);
        def bcs-index-walk(rest, names, index) = (Comparable) len(rest) == 0 ? index : bcs-index-walk-at(rest, names, index, bcs-def-name(head(rest)));
        def bcs-index-walk-at(rest, names, index, nm) = (str_len(nm) > 0) && ((Comparable) bcs-member?(names, nm) == 1) ? bcs-index-walk(tail(rest), names, bcs-index-add(index, nm, bcs-body-here(rest))) : bcs-index-walk(tail(rest), names, index);
        def bcs-index-units(units, names, index) = (Comparable) len(units) == 0 ? index : bcs-index-units(tail(units), names, bcs-index-walk(head(units)[1], names, index));
        def bcs-index(units, names) = bcs-index-units(units, names, list());

        // each unit is read once and its lines held, so a file carrying twelve hot doors
        // is opened once instead of twelve times
        def bcs-unit-has?(units, path) = (Comparable) len(units) == 0 ? 0 : (String) head(units)[0] == path ? 1 : bcs-unit-has?(tail(units), path);
        def bcs-unit-lines(units, path) = (Comparable) len(units) == 0 ? list() : (String) head(units)[0] == path ? head(units)[1] : bcs-unit-lines(tail(units), path);
        def bcs-read-lines(path) = file_size(path) < 0 ? list() : bcs-lines(read_file(path));
        def bcs-unit-add(units, path) = ((Comparable) str_len(path) == 0) || ((Comparable) bcs-unit-has?(units, path) == 1) ? units : cons(list(path, bcs-read-lines(path)), units);
        def bcs-units(rows, acc) = (Comparable) len(rows) == 0 ? acc : bcs-units(tail(rows), bcs-unit-add(acc, bcs-unit(head(rows))));
        def bcs-units-of(paths, acc) = (Comparable) len(paths) == 0 ? acc : bcs-units-of(tail(paths), bcs-unit-add(acc, head(paths)));
        // the caller adds the workload's own files, because the unit a row names is the
        // resolution frame and not always the file the door lives in
        def bcs-units-for(rows, paths) = bcs-units-of(paths, bcs-units(rows, list()));

        def bcs-edges-indexed(names, index, all) = (Comparable) len(names) == 0 ? list() : append(bcs-edges-for(head(names), bcs-index-body(index, head(names)), all, list()), bcs-edges-indexed(tail(names), index, all));
        def bcs-graph-with(rows, paths) = bcs-graph-indexed(bcs-names(rows), bcs-index(bcs-units-for(rows, paths), bcs-names(rows)));
        def bcs-graph-indexed(names, index) = bcs-edges-indexed(names, index, names);
        def bcs-graph(rows) = bcs-graph-with(rows, list());
        // the doors whose body was nowhere in the units given: measured, but their callees
        // are unknown, so their bearing is a floor and not a reading
        def bcs-unread-in(names, index) = (Comparable) len(names) == 0 ? list() : (Comparable) bcs-index-has?(index, head(names)) == 1 ? bcs-unread-in(tail(names), index) : cons(head(names), bcs-unread-in(tail(names), index));
        def bcs-unread-with(rows, paths) = bcs-unread-in(bcs-names(rows), bcs-index(bcs-units-for(rows, paths), bcs-names(rows)));
        def bcs-unread(rows) = bcs-unread-with(rows, list());

        // --- rendering the reading in words ---------------------------------------
        def bcs-cat(parts) = (Comparable) len(parts) == 0 ? "" : head(parts) ++ bcs-cat(tail(parts));
        def bcs-num(v) = v < 0 ? "no-reading" : int_to_str(v);
        def bcs-pct(bp) = bp < 0 ? "no-reading" : bcs-cat(list(int_to_str(bp / 100), ".", int_to_str((bp % 100) / 10), "%"));
        def bcs-per-call-text(v) = v < 0 ? "no-reading" : bcs-cat(list(int_to_str(v / 100), ".", int_to_str((v % 100) / 10), " steps/call"));
        def bcs-c-text(c) = bcs-cat(list("drag ", int_to_str(bcs-c-drag(c)), "  ", bcs-c-name(c), " — ", bcs-pct(bcs-c-share(c)), " of the walking, ", bcs-num(bcs-c-calls(c)), " calls, ", bcs-per-call-text(bcs-c-per-call(c)), ", ", bcs-num(bcs-c-leaning(c)), " doors lean on it, ", bcs-c-remedy(c)));
        def bcs-where(c) = bcs-cat(list(bcs-c-unit(c), ":", int_to_str(bcs-c-line(c))));
    }
    0;
}
