//////////////////////////////////////////////////////////////////////
//
// bearing-census.bml — how much of the body stands on a given door.
//
// Authority: form-stdlib/bml/bearing-census.bml
import form/form-stdlib/core.fk;
// Proven by: form-stdlib/tests/bearing-census-band.fk
//
// The body already knows whether each door ANSWERS RIGHTLY: every band says
// so. What it had no measure of, until this cell, is how much of its own
// walking happens AT OR BENEATH a door — so a door that answers rightly and
// costs the world stayed invisible for as long as its correctness held.
// `substring` walked at 4.59 MB/s underneath every parser, frame reader and
// row walker in this tree for months, and was found by tripping over it
// (corpus row 1345, keeldrag). The question that row left open is the one
// this cell answers with a number: which door is next.
//
// Three readings, from two ledgers the seed already keeps:
//
//   calls    — kernel_hot_rows heat: the times the WALKER entered this defn.
//              A defn the JIT crystallized stops accruing here, because it
//              stopped walking; that is the measure working, not a blind spot.
//   bearing  — calls at this door plus the calls of every door reachable from
//              it. A leaf door three levels down that does the real per-byte
//              work carries its own weight AND its helpers'; a thin door that
//              only forwards carries what it forwards to.
//   leaning  — how many distinct doors reach this one. Two callers make a
//              door carry both their weights; this is the count of what would
//              break, or speed up, if the door changed.
//
// And the two that turn a reading into a decision:
//
//   per-call — bearing per invocation, x100. A cheap door called a million
//              times and an expensive door called twice have the same bearing
//              and want opposite repairs; only this tells them apart.
//   remedy   — a door whose NAME the op table already carries as a native is
//              never "mint a native": the native stands, and the walking that
//              still reaches the recipe is a routing wound. A door with no
//              native twin and real drag is the next substring.
//
// The graph is drawn from the source, and each door is found there by its NAME.
// A hot row's unit and line are coordinates in the resolved text of a resolution
// frame, not in the file on disk, so reading a body at that line would quote the
// wrong door with total confidence; the units are walked once instead, and a door
// whose body is in none of them is named unread rather than drawn with no callees.
// The names a body mentions become its callees, boundary-checked — so `substring`
// inside `fstr-substring-loop` is not an edge — and comments are cut first, since
// this tree's prose names doors densely enough to invent a graph of its own.
//
// Every number here is honest about its own absence. A door with no row says
// -1 (no reading), never 0 (free) — the distinction the whole measure exists
// for. And the census carries its own coverage: the share of the body's
// walking the snapshot actually saw, so a top-N reading cannot pass itself
// off as the whole body.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class BearingCensusAuthority {
        field BCSAuthorityPath = "form/form-stdlib/bml/bearing-census.bml";
        field BCSAuthorityKind = "high-bml-interface-class-const";
    }

    class BearingCensus {
        field BCSSensor = "bearing";
        field BCSCadenceMs = 5000;
        field BCSScale = 10000;
        field BCSTopN = 40;
        field BCSBodyLines = 40;
        field BCSNoReading = -1;
        ref bcs-authority = BearingCensusAuthority;
        thought bcs-pattern = ["no-reading-is-not-free", "bearing-includes-what-it-calls", "a-native-is-not-a-recipe-to-heal", "coverage-travels-with-the-census", "the-graph-comes-from-the-source-the-row-points-at"];

        // --- the hot row, as kernel_hot_rows gives it -------------------------
        // list(heat, name, unit, line, col, boxes, unboxes, crystal, spare)
        def bcs-heat(r) = if (len(r) < 2) then 0 else r[0];
        def bcs-name(r) = if (len(r) < 2) then "" else r[1];
        def bcs-unit(r) = if (len(r) < 3) then "" else r[2];
        def bcs-line(r) = if (len(r) < 4) then 0 else r[3];
        def bcs-crystal(r) = if (len(r) < 8) then 0 else r[7];

        def bcs-names(rows) = if ((Comparable) len(rows) == 0) then [] else cons(bcs-name(rows[0]), bcs-names(rows[1:]));
        def bcs-member?(names, n) = if ((Comparable) len(names) == 0) then 0 else if ((String) names[0] == n) then 1 else bcs-member?(names[1:], n);
        def bcs-row-of(rows, name) = if ((Comparable) len(rows) == 0) then [] else if ((String) bcs-name(rows[0]) == name) then rows[0] else bcs-row-of(rows[1:], name);
        // measured or not is the first question asked of any door: an absent row is a missing
        // reading, and every number downstream of it answers -1 rather than a confident zero
        def bcs-measured?(rows, name) = if ((Comparable) len(bcs-row-of(rows, name)) == 0) then 0 else 1;
        def bcs-heat-of(rows, name) = if ((Comparable) bcs-measured?(rows, name) == 0) then 0 else bcs-heat(bcs-row-of(rows, name));
        def bcs-total-heat(rows, acc) = if ((Comparable) len(rows) == 0) then acc else bcs-total-heat(rows[1:], (acc + bcs-heat(rows[0])));

        // --- the call graph: edges are list(caller, callee) --------------------
        def bcs-callees(edges, name, acc) = if ((Comparable) len(edges) == 0) then acc else bcs-callees(edges[1:], name, if ((String) edges[0][0] == name) then cons(edges[0][1], acc) else acc);
        // the reachable set INCLUDES the door itself, so bearing counts its own steps first;
        // the seen list is the cycle guard, so a recursive door is walked once, not forever
        def bcs-reach-go(edges, frontier, seen) = if ((Comparable) len(frontier) == 0) then seen else bcs-reach-step(edges, frontier[0], frontier[1:], seen);
        def bcs-reach-step(edges, n, rest, seen) = if ((Comparable) bcs-member?(seen, n) == 1) then bcs-reach-go(edges, rest, seen) else bcs-reach-go(edges, append(bcs-callees(edges, n, []), rest), cons(n, seen));
        def bcs-reach(edges, name) = bcs-reach-go(edges, [name], []);
        // every door's reach is computed once and held, so leaning is a membership walk
        // over short lists instead of N squared closures
        def bcs-reaches(edges, names) = if ((Comparable) len(names) == 0) then [] else cons([names[0], bcs-reach(edges, names[0])], bcs-reaches(edges, names[1:]));
        def bcs-reach-of(reaches, name) = if ((Comparable) len(reaches) == 0) then [] else if ((String) reaches[0][0] == name) then reaches[0][1] else bcs-reach-of(reaches[1:], name);

        // --- the three readings ------------------------------------------------
        def bcs-sum-heat(rows, names, acc) = if ((Comparable) len(names) == 0) then acc else bcs-sum-heat(rows, names[1:], (acc + bcs-heat-of(rows, names[0])));
        def bcs-bearing(rows, reaches, name) = if ((Comparable) bcs-measured?(rows, name) == 0) then BCSNoReading() else bcs-sum-heat(rows, bcs-reach-of(reaches, name), 0);
        def bcs-leaning(reaches, target, acc) = if ((Comparable) len(reaches) == 0) then acc else bcs-leaning(reaches[1:], target, if ((!((String) reaches[0][0] == target)) && ((Comparable) bcs-member?(reaches[0][1], target) == 1)) then (acc + 1) else acc);
        def bcs-share-bp(bearing, total) = if ((total <= 0) || (bearing < 0)) then BCSNoReading() else ((bearing * BCSScale()) / total);
        def bcs-per-call(bearing, calls) = if ((calls <= 0) || (bearing < 0)) then BCSNoReading() else ((bearing * 100) / calls);
        // the census's own honesty: the share of the body's whole walking this snapshot saw.
        // A top-N reading that cannot say what it missed is a reading that reads its own edge as the world
        def bcs-coverage-bp(seen, walked) = if (walked <= 0) then BCSNoReading() else ((seen * BCSScale()) / walked);

        // --- the natives the seed already carries ------------------------------
        // the op table is a row set in text: every native stands as `{ "name",` on its own line.
        // One forward pass lifts every name; membership is then str_eq, not another scan per door.
        def bcs-open() = ("{ " + byte_to_str(34));
        def bcs-native-names-go(table, from, acc) = bcs-native-names-at(table, str_find(table, bcs-open(), from), acc);
        def bcs-native-names-at(table, at, acc) = if (at < 0) then acc else bcs-native-names-close(table, (at + len(bcs-open())), acc);
        def bcs-native-names-close(table, i, acc) = bcs-native-names-take(table, i, str_find(table, byte_to_str(34), i), acc);
        def bcs-native-names-take(table, i, close, acc) = if (close < 0) then acc else bcs-native-names-go(table, (close + 1), cons(substring(table, i, close), acc));
        def bcs-native-names(table) = bcs-native-names-go(table, 0, []);
        def bcs-native?(natives, name) = bcs-member?(natives, name);

        // A door can carry a native's MEANING under another name. sha256.fk walks its own
        // `nth-rec` seventy-six million times on a locale read while `nth` stands native at
        // tag 23; nothing in the name says so, and every band it sits under is green. So the
        // stem — the name with one working suffix cut, or the file's own prefix — is held
        // against the op table, and a match is reported as a TWIN and not as proof: it names
        // the native to check against, and the reader decides whether the meanings are one.
        def bcs-ends-with?(s, suf) = if (len(suf) > len(s)) then 0 else if ((String) substring(s, (len(s) - len(suf)), len(s)) == suf) then 1 else 0;
        def bcs-cut-suffix(s, suf) = if ((Comparable) bcs-ends-with?(s, suf) == 1) then substring(s, 0, (len(s) - len(suf))) else s;
        def bcs-cut-prefix(s, pre) = if ((Comparable) bcs-starts-with?(s, 0, pre) == 1) then substring(s, len(pre), len(s)) else s;
        def bcs-suffixes() = ["-rec", "-loop", "-go", "-acc", "-next", "-1", "-here", "-in"];
        def bcs-cut-any(s, sufs) = if ((Comparable) len(sufs) == 0) then s else bcs-cut-any-next(s, sufs, bcs-cut-suffix(s, sufs[0]));
        def bcs-cut-any-next(s, sufs, cut) = if (!((String) cut == s)) then cut else bcs-cut-any(s, sufs[1:]);
        def bcs-stem(name) = bcs-cut-prefix(bcs-cut-any(name, bcs-suffixes()), "fstr-");
        def bcs-twin(natives, name) = bcs-twin-of(natives, name, bcs-stem(name));
        def bcs-twin-of(natives, name, stem) = if ((String) stem == name) then "" else if ((Comparable) bcs-member?(natives, stem) == 1) then stem else "";
        def bcs-twinned?(natives, name) = if (len(bcs-twin(natives, name)) > 0) then 1 else 0;

        // --- what the reading asks for -----------------------------------------
        // a door the op table already carries is never "mint a native": the native stands,
        // and walking that still reaches the recipe is a routing wound, a different repair
        def bcs-kind(natives, rows, name) = if ((Comparable) bcs-measured?(rows, name) == 0) then "no-reading" else if ((Comparable) bcs-native?(natives, name) == 1) then "shadowed" else if (bcs-crystal(bcs-row-of(rows, name)) > 0) then "crystal" else if ((Comparable) bcs-twinned?(natives, name) == 1) then "twinned" else "recipe";
        def bcs-remedy(natives, rows, name) = if ((Comparable) bcs-measured?(rows, name) == 0) then "no-reading" else if ((Comparable) bcs-native?(natives, name) == 1) then "route-to-the-native-that-stands" else if (bcs-crystal(bcs-row-of(rows, name)) > 0) then "stands-crystallized" else if ((Comparable) bcs-twinned?(natives, name) == 1) then ("check against the native " + bcs-twin(natives, name)) else "mint-a-native";
        // a twinned door still carries its cost, so it stays in the ranking; only its remedy
        // changes, from minting a native to checking the one that already stands
        def bcs-heal?(natives, rows, name) = if ((String) bcs-remedy(natives, rows, name) == "mint-a-native") then 1 else if ((String) bcs-kind(natives, rows, name) == "twinned") then 1 else 0;
        // drag ranks the heal candidates only. Share alone puts a hot root on top; leaning alone
        // puts a tiny shared helper on top; the product is the door whose cost is large AND spread
        // across many callers -- the shape substring wore
        def bcs-drag(shareBp, leaning, heal) = if (((Comparable) heal == 0) || (shareBp < 0)) then 0 else (shareBp * (leaning + 1));

        // --- a census cell ------------------------------------------------------
        // list(name, calls, bearing, shareBp, perCall, leaning, kind, remedy, drag, unit, line)
        def bcs-cell(rows, reaches, natives, total, name) = bcs-cell-with(rows, natives, name, bcs-heat-of(rows, name), bcs-bearing(rows, reaches, name), total, bcs-leaning(reaches, name, 0));
        def bcs-cell-with(rows, natives, name, calls, bearing, total, leaning) = bcs-cell-at(rows, natives, name, calls, bearing, leaning, bcs-share-bp(bearing, total));
        def bcs-cell-at(rows, natives, name, calls, bearing, leaning, shareBp) = [name, calls, bearing, shareBp, bcs-per-call(bearing, calls), leaning, bcs-kind(natives, rows, name), bcs-remedy(natives, rows, name), bcs-drag(shareBp, leaning, bcs-heal?(natives, rows, name)), bcs-unit(bcs-row-of(rows, name)), bcs-line(bcs-row-of(rows, name))];
        def bcs-c-name(c) = if ((Comparable) len(c) == 0) then "" else c[0];
        def bcs-c-calls(c) = if ((Comparable) len(c) == 0) then BCSNoReading() else c[1];
        def bcs-c-bearing(c) = if ((Comparable) len(c) == 0) then BCSNoReading() else c[2];
        def bcs-c-share(c) = if ((Comparable) len(c) == 0) then BCSNoReading() else c[3];
        def bcs-c-per-call(c) = if ((Comparable) len(c) == 0) then BCSNoReading() else c[4];
        def bcs-c-leaning(c) = if ((Comparable) len(c) == 0) then BCSNoReading() else c[5];
        def bcs-c-kind(c) = if ((Comparable) len(c) == 0) then "no-reading" else c[6];
        def bcs-c-remedy(c) = if ((Comparable) len(c) == 0) then "no-reading" else c[7];
        def bcs-c-drag(c) = if ((Comparable) len(c) == 0) then 0 else c[8];
        def bcs-c-unit(c) = if ((Comparable) len(c) == 0) then "" else c[9];
        def bcs-c-line(c) = if ((Comparable) len(c) == 0) then 0 else c[10];

        def bcs-census-over(rows, reaches, natives, total, names) = if ((Comparable) len(names) == 0) then [] else cons(bcs-cell(rows, reaches, natives, total, names[0]), bcs-census-over(rows, reaches, natives, total, names[1:]));
        def bcs-census(rows, edges, natives) = bcs-census-over(rows, bcs-reaches(edges, bcs-names(rows)), natives, bcs-total-heat(rows, 0), bcs-names(rows));
        def bcs-of(census, name) = if ((Comparable) len(census) == 0) then [] else if ((String) bcs-c-name(census[0]) == name) then census[0] else bcs-of(census[1:], name);

        // --- the standing name ---------------------------------------------------
        def bcs-insert(c, sorted) = if ((Comparable) len(sorted) == 0) then [c] else if (bcs-c-drag(c) >= bcs-c-drag(sorted[0])) then cons(c, sorted) else cons(sorted[0], bcs-insert(c, sorted[1:]));
        def bcs-sort(census) = if ((Comparable) len(census) == 0) then [] else bcs-insert(census[0], bcs-sort(census[1:]));
        def bcs-worst-go(census, held) = if ((Comparable) len(census) == 0) then held else bcs-worst-go(census[1:], if (bcs-c-drag(census[0]) > bcs-c-drag(held)) then census[0] else held);
        def bcs-worst(census) = bcs-worst-go(census, []);
        // the answer to "what is the next substring?" as one name a glass row can carry.
        // No candidate is a whole answer, not an empty one: a body walking only natives has no next substring
        def bcs-worst-name(census) = bcs-worst-name-of(bcs-worst(census));
        def bcs-worst-name-of(c) = if ((Comparable) len(c) == 0) then "no-reading" else if ((Comparable) bcs-c-drag(c) == 0) then "no-recipe-carries-drag" else bcs-c-name(c);
        def bcs-take(l, n) = if ((n <= 0) || ((Comparable) len(l) == 0)) then [] else cons(l[0], bcs-take(l[1:], (n - 1)));
        def bcs-heal-list(census) = if ((Comparable) len(census) == 0) then [] else if (bcs-c-drag(census[0]) > 0) then cons(census[0], bcs-heal-list(census[1:])) else bcs-heal-list(census[1:]);

        // --- the graph, read off the source each hot row points at -----------------
        def bcs-split-go(text, sep, from, acc) = bcs-split-at(text, sep, from, acc, str_find(text, sep, from));
        def bcs-split-at(text, sep, from, acc, at) = if (at < 0) then reverse(cons(substring(text, from, len(text)), acc)) else bcs-split-go(text, sep, (at + len(sep)), cons(substring(text, from, at), acc));
        def bcs-split(text, sep) = if ((Comparable) len(text) == 0) then [] else bcs-split-go(text, sep, 0, []);
        def bcs-lines(text) = bcs-split(text, byte_to_str(10));
        def bcs-nth-line(lines, n) = if ((n < 1) || (n > len(lines))) then "" else lines[(n - 1)];

        def bcs-space?(b) = if ((Comparable) b == 32) then 1 else if ((Comparable) b == 9) then 1 else 0;
        def bcs-skip-spaces(s, i) = if (i >= len(s)) then i else if ((Comparable) bcs-space?(str_byte_at(s, i)) == 1) then bcs-skip-spaces(s, (i + 1)) else i;
        def bcs-starts-with?(s, i, p) = if ((i + len(p)) > len(s)) then 0 else if ((String) substring(s, i, (i + len(p))) == p) then 1 else 0;
        // both authoring lanes open a door the same way to a reader: `def name(` in BML,
        // `(defn name ` in Form. A line that opens one ends the body above it
        def bcs-opens-def?(line) = bcs-opens-def-at(line, bcs-skip-spaces(line, 0));
        def bcs-opens-def-at(line, i) = if ((Comparable) bcs-starts-with?(line, i, "def ") == 1) then 1 else if ((Comparable) bcs-starts-with?(line, i, "(defn ") == 1) then 1 else 0;
        // a comment is not a call. This tree's comments name doors densely — core.fk's own
        // note about substring says the word twenty times — so a graph drawn over raw text
        // would give every door an edge to whatever its prose discusses. The cut is at the
        // first `;` or `//`, which loses a call standing after a semicolon inside a string
        // literal: the measure would rather miss an edge than invent one.
        def bcs-min-mark(a, b) = if (a < 0) then b else if (b < 0) then a else if (a < b) then a else b;
        def bcs-comment-at(line) = bcs-min-mark(str_find(line, ";", 0), str_find(line, "//", 0));
        def bcs-strip-comment(line) = bcs-strip-at(line, bcs-comment-at(line));
        def bcs-strip-at(line, i) = if (i < 0) then line else substring(line, 0, i);
        def bcs-body-go(lines, n, left, acc) = if ((left <= 0) || (n > len(lines))) then acc else bcs-body-next(lines, n, left, acc, bcs-nth-line(lines, n));
        def bcs-body-next(lines, n, left, acc, line) = if ((len(acc) > 0) && ((Comparable) bcs-opens-def?(line) == 1)) then acc else bcs-body-go(lines, (n + 1), (left - 1), (acc + ((String) byte_to_str(10) + bcs-strip-comment(line))));
        def bcs-body(lines, n) = bcs-body-go(lines, n, BCSBodyLines(), "");

        // a name mention is an edge only on both boundaries: `substring` inside
        // `fstr-substring-loop` is the same bytes and not the same door
        def bcs-name-byte?(b) = if ((b >= 97) && (b <= 122)) then 1 else if ((b >= 65) && (b <= 90)) then 1 else if ((b >= 48) && (b <= 57)) then 1 else if ((Comparable) b == 45) then 1 else if ((Comparable) b == 95) then 1 else if ((Comparable) b == 63) then 1 else if ((Comparable) b == 33) then 1 else 0;
        def bcs-left-free?(text, at) = if (at <= 0) then 1 else if ((Comparable) bcs-name-byte?(str_byte_at(text, (at - 1))) == 1) then 0 else 1;
        def bcs-right-free?(text, end) = if (end >= len(text)) then 1 else if ((Comparable) bcs-name-byte?(str_byte_at(text, end)) == 1) then 0 else 1;
        def bcs-mentions-go(text, name, from) = bcs-mentions-at(text, name, from, str_find(text, name, from));
        def bcs-mentions-at(text, name, from, at) = if (at < 0) then 0 else if (((Comparable) bcs-left-free?(text, at) == 1) && ((Comparable) bcs-right-free?(text, (at + len(name))) == 1)) then 1 else bcs-mentions-go(text, name, (at + 1));
        def bcs-mentions?(text, name) = if ((Comparable) len(name) == 0) then 0 else bcs-mentions-go(text, name, 0);

        def bcs-edges-for(caller, body, names, acc) = if ((Comparable) len(names) == 0) then acc else bcs-edges-for(caller, body, names[1:], if ((!((String) names[0] == caller)) && ((Comparable) bcs-mentions?(body, names[0]) == 1)) then cons([caller, names[0]], acc) else acc);

        // --- finding a door's body by NAME, never by the row's line -----------------
        // A hot row's unit and line are coordinates in the RESOLVED text of a resolution
        // frame, not in the file on disk: witnessed 2026-09-07, core.fk's own defns land on
        // their true lines while a preluded unit's defns drift, and a band loaded as a
        // prelude reports every door under the first unit. Reading a body at that line
        // would quote the wrong door with total confidence. So the body is found by the
        // name the row carries, and a door whose body is nowhere in the units given is
        // named unread rather than silently drawn with no callees.
        def bcs-name-end(s, i) = if (i >= len(s)) then i else if ((Comparable) bcs-name-byte?(str_byte_at(s, i)) == 1) then bcs-name-end(s, (i + 1)) else i;
        def bcs-def-name(line) = bcs-def-name-at(line, bcs-skip-spaces(line, 0));
        def bcs-def-name-at(line, i) = if ((Comparable) bcs-starts-with?(line, i, "def ") == 1) then substring(line, (i + 4), bcs-name-end(line, (i + 4))) else if ((Comparable) bcs-starts-with?(line, i, "(defn ") == 1) then substring(line, (i + 6), bcs-name-end(line, (i + 6))) else "";
        // the body walks the remaining lines directly rather than indexing by number:
        // nth into a fifteen-thousand-line unit is a walk per line, and the walk of walks
        // is the very cost this cell exists to find
        def bcs-body-here(rest) = bcs-body-here-go(rest, BCSBodyLines(), "");
        def bcs-body-here-go(rest, left, acc) = if ((left <= 0) || ((Comparable) len(rest) == 0)) then acc else if ((len(acc) > 0) && ((Comparable) bcs-opens-def?(rest[0]) == 1)) then acc else bcs-body-here-go(rest[1:], (left - 1), (acc + ((String) byte_to_str(10) + bcs-strip-comment(rest[0]))));

        // one pass per unit builds name -> body for the doors under census; the first
        // definition of a name wins, the way the resolver reads it
        def bcs-index-has?(index, nm) = if ((Comparable) len(index) == 0) then 0 else if ((String) index[0][0] == nm) then 1 else bcs-index-has?(index[1:], nm);
        def bcs-index-body(index, nm) = if ((Comparable) len(index) == 0) then "" else if ((String) index[0][0] == nm) then index[0][1] else bcs-index-body(index[1:], nm);
        def bcs-index-add(index, nm, body) = if ((Comparable) bcs-index-has?(index, nm) == 1) then index else cons([nm, body], index);
        def bcs-index-walk(rest, names, index) = if ((Comparable) len(rest) == 0) then index else bcs-index-walk-at(rest, names, index, bcs-def-name(rest[0]));
        def bcs-index-walk-at(rest, names, index, nm) = if ((len(nm) > 0) && ((Comparable) bcs-member?(names, nm) == 1)) then bcs-index-walk(rest[1:], names, bcs-index-add(index, nm, bcs-body-here(rest))) else bcs-index-walk(rest[1:], names, index);
        def bcs-index-units(units, names, index) = if ((Comparable) len(units) == 0) then index else bcs-index-units(units[1:], names, bcs-index-walk(units[0][1], names, index));
        def bcs-index(units, names) = bcs-index-units(units, names, []);

        // each unit is read once and its lines held, so a file carrying twelve hot doors
        // is opened once instead of twelve times
        def bcs-unit-has?(units, path) = if ((Comparable) len(units) == 0) then 0 else if ((String) units[0][0] == path) then 1 else bcs-unit-has?(units[1:], path);
        def bcs-unit-lines(units, path) = if ((Comparable) len(units) == 0) then [] else if ((String) units[0][0] == path) then units[0][1] else bcs-unit-lines(units[1:], path);
        def bcs-read-lines(path) = if (file_size(path) < 0) then [] else bcs-lines(read_file(path));
        def bcs-unit-add(units, path) = if (((Comparable) len(path) == 0) || ((Comparable) bcs-unit-has?(units, path) == 1)) then units else cons([path, bcs-read-lines(path)], units);
        def bcs-units(rows, acc) = if ((Comparable) len(rows) == 0) then acc else bcs-units(rows[1:], bcs-unit-add(acc, bcs-unit(rows[0])));
        def bcs-units-of(paths, acc) = if ((Comparable) len(paths) == 0) then acc else bcs-units-of(paths[1:], bcs-unit-add(acc, paths[0]));
        // the caller adds the workload's own files, because the unit a row names is the
        // resolution frame and not always the file the door lives in
        def bcs-units-for(rows, paths) = bcs-units-of(paths, bcs-units(rows, []));

        def bcs-edges-indexed(names, index, all) = if ((Comparable) len(names) == 0) then [] else append(bcs-edges-for(names[0], bcs-index-body(index, names[0]), all, []), bcs-edges-indexed(names[1:], index, all));
        def bcs-graph-with(rows, paths) = bcs-graph-indexed(bcs-names(rows), bcs-index(bcs-units-for(rows, paths), bcs-names(rows)));
        def bcs-graph-indexed(names, index) = bcs-edges-indexed(names, index, names);
        def bcs-graph(rows) = bcs-graph-with(rows, []);
        // the doors whose body was nowhere in the units given: measured, but their callees
        // are unknown, so their bearing is a floor and not a reading
        def bcs-unread-in(names, index) = if ((Comparable) len(names) == 0) then [] else if ((Comparable) bcs-index-has?(index, names[0]) == 1) then bcs-unread-in(names[1:], index) else cons(names[0], bcs-unread-in(names[1:], index));
        def bcs-unread-with(rows, paths) = bcs-unread-in(bcs-names(rows), bcs-index(bcs-units-for(rows, paths), bcs-names(rows)));
        def bcs-unread(rows) = bcs-unread-with(rows, []);

        // --- rendering the reading in words ---------------------------------------
        def bcs-cat(parts) = if ((Comparable) len(parts) == 0) then "" else ((String) parts[0] + bcs-cat(parts[1:]));
        def bcs-num(v) = if (v < 0) then "no-reading" else v.str();
        def bcs-pct(bp) = if (bp < 0) then "no-reading" else bcs-cat([(bp / 100).str(), ".", ((bp % 100) / 10).str(), "%"]);
        def bcs-per-call-text(v) = if (v < 0) then "no-reading" else bcs-cat([(v / 100).str(), ".", ((v % 100) / 10).str(), " steps/call"]);
        def bcs-c-text(c) = bcs-cat(["drag ", bcs-c-drag(c).str(), "  ", bcs-c-name(c), " — ", bcs-pct(bcs-c-share(c)), " of the walking, ", bcs-num(bcs-c-calls(c)), " calls, ", bcs-per-call-text(bcs-c-per-call(c)), ", ", bcs-num(bcs-c-leaning(c)), " doors lean on it, ", bcs-c-remedy(c)]);
        def bcs-where(c) = bcs-cat([bcs-c-unit(c), ":", bcs-c-line(c).str()]);
    }
    0;
}
