; Form tensor recipes on native Metal. Behavior and refusals travel together.
; preludes: form-stdlib/native-tensor.bml
; preludes: form-stdlib/core.fk form-stdlib/form-cli-tensor-ir.bml observe/bidirectional-framebuffer-channel.fk

(do
    (print "form-cli executed native tensor-ir\n")
    (print "form-cli emit-add=")
    (print (mlg-emit (mlg-add2)))
    (print " run=")
    (print (int_to_str (nt-eval (mlg-emit (mlg-add2)))))
    (print "\nform-cli emit-mul=")
    (print (mlg-emit (mlg-mul2)))
    (print " run=")
    (print (int_to_str (nt-eval (mlg-emit (mlg-mul2)))))
    (print "\nform-cli emit-times4=")
    (print (mlg-emit (mlg-times4)))
    (print " run=")
    (print (int_to_str (nt-eval (mlg-emit (mlg-times4)))))
    (print "\nform-cli emit-max=")
    (print (mlg-emit (mlg-max2)))
    (print " run=")
    (print (int_to_str (nt-eval (mlg-emit (mlg-max2)))))
    (print "\nform-cli emit-vadd-sum=")
    (print (mlg-emit (mlg-vadd-sum)))
    (print " run=")
    (print (int_to_str (nt-eval (mlg-emit (mlg-vadd-sum)))))
    (print "\nform-cli unknown-pow=")
    (print (nt-run "2 3 pow"))
    (print " cell-len=")
    (print (int_to_str (str_len (node_value (intern_trivial_string (mlg-emit (mlg-vadd-sum)))))))
    (print " learned-mul=")
    (print (int_to_str (mlg-has (mlg-after) "mul")))
    (print " learned-max=")
    (print (int_to_str (mlg-has (mlg-learn (mlg-after) "max") "max")))
    (print " check=")
    (print (int_to_str (mlg-check)))
    (print "\n")
    (framebuffer-clear)
    (print "form-cli fb-action=")
    (print (int_to_str (bfc-payload (nth (bfc-round 1 (list 4 2) (list 4 2) (list 0 4) 0) 1))))
    (print " fb-events=")
    (print (int_to_str (len (framebuffer-events))))
    (print "\nform-cli tensor=\n")
    (print (nt-status))
    (print "\n")
    0)
