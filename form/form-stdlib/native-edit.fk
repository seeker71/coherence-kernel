// native-edit.fk — the body's own file editor, built on the body's ONE string
// engine: find-from (form-stdlib/line-grammar.fk). Searching is not here: grep
// is the one internal tool (form/form-stdlib/bml/form-agent-grep.bml).
//
// Two layers:
//   - string layer (ne-count / ne-replace-*) is pure Form data + arithmetic
//     over find-from -> proven on fkwu over synthetic strings.
//   - file layer (ne-edit-unique / ne-edit-all) is fkwu-carrier (host I/O,
//     like read_file/write_file) -> proven live by receipt.
//
import form-stdlib/core.fk;
import form-stdlib/line-grammar.fk;
section [form.bml] {
    // ── string layer (pure), on the shared engine ──────────────────────
    // ne-count: non-overlapping occurrences of `needle` in `hay` (0 for empty needle).
    def ne-count-loop(hay, needle, from, n) = {
        let i = find-from(hay, needle, from);
        i < 0 ? n : ne-count-loop(hay, needle, i + len(needle), n + 1);
    };
    def ne-count(hay, needle) = (Comparable) len(needle) == 0 ? 0 : ne-count-loop(hay, needle, 0, 0);
    // ne-replace-first / ne-replace-all: left-to-right, non-overlapping; the inserted
    // `new` is never rescanned, so `new` containing `old` cannot loop.
    def ne-replace-first(hay, old, new) = {
        let i = find-from(hay, old, 0);
        i < 0 ? hay : (substring(hay, 0, i) + ((String) new + substring(hay, i + len(old), len(hay))));
    };
    def ne-replace-all(hay, old, new) = {
        let i = find-from(hay, old, 0);
        i < 0 ? hay : (substring(hay, 0, i) + ((String) new + ne-replace-all(substring(hay, i + len(old), len(hay)), old, new)));
    };
    // ── file layer (fkwu-carrier) ──────────────────────────────────────────
    // ne-edit-unique: replace `old` with `new` in the file at `path` ONLY when `old`
    // occurs EXACTLY once (the rented edit tool's exact-unique-match safety).
    //    1 = replaced;  -1 = not found (0 matches);  -2 = ambiguous (>1 match);
    //   -3 = write failed.  (A missing file answers nothing; ne-read names the
    //   absence and keeps the 0-matches -> -1 contract.)
    def ne-read(path) = {
        let s = read_file(path);
        nothing?(s) ? "" : s;
    };
    def ne-edit-unique(path, old, new) = {
        let content = ne-read(path);
        let c = ne-count(content, old);
        (Comparable) c == 0 ? -1 : 1 < c ? -2 : {
            let wrote = write_file(path, ne-replace-first(content, old, new));
            wrote < 0 ? -3 : 1;
        };
    };
    // ne-edit-all: replace EVERY occurrence in the file (no uniqueness gate).
    //   count replaced (>=0);  -3 = write failed.
    def ne-edit-all(path, old, new) = {
        let content = ne-read(path);
        let c = ne-count(content, old);
        (Comparable) c == 0 ? 0 : {
            let wrote = write_file(path, ne-replace-all(content, old, new));
            wrote < 0 ? -3 : c;
        };
    };}
