//////////////////////////////////////////////////////////////////////
//
// form-cli-unique-mint.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-unique-mint.bml
//
// Mints Form-native (split, class, situation) rows that teach the
// local layer what is unique here: channel, protocol, axiom,
// satsang, nothing, timeout, trust through transparency, choice
// and undo as primitives, embodied memory without long chains.
// Combinatorial mix is the diversity. Overlay fit reuses the
// teach-layer centroid. LoRA writer stays 0.
//
// Proven by: form-stdlib/tests/form-cli-unique-mint-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template SampleRow<TClass> {
        member split: String;
        member className: TClass;
        member situation: String;
        member sourceId: Object;
        member lessonId: Object;
        member transformId: Object;
    }

    class FormUniqueMintAuthority {
        field MintAuthorityPath = "form/form-stdlib/bml/form-cli-unique-mint.bml";
        field MintAuthorityKind = "high-bml-class-template-field";
    }

    class FormUniqueMint<T> {
        field MixA = 7;
        field MixB = 13;
        field NSkills = 9;
        field LoraWriter = 0;
        field SplitTrain = "train";
        field SplitHeldout = "heldout";

        ref fnu-authority = FormUniqueMintAuthority;
        thought fnu-pattern = list("mint", "lesson-lineage", "source-overlap-visible", "overlay-fit", "lora-waits");
        thought fnu-skills = list("channel", "protocol", "axiom", "satsang", "nothing", "timeout", "trust", "choice-undo", "embodied-memory");
        thought fnu-contexts = list("offer-ack core", "satsang circle", "channel membrane", "axiom-4 boundary", "one-turn budget", "local overlay", "choice-lane walk", "ingest door");
        thought fnu-sources = list("form/form-stdlib/channel.fk", "form/form-stdlib/channel-interface.fk", "axioms/core-axioms.form", "form/form-stdlib/satsang.fk", "ingest/satsang-transmute.fk", "control/choice-lane-core.fk", "ingest/judged-trust.fk", "NORTH_STAR.md");

        def fnu-mix(i, n) = mod(add(mul(i, MixA()), MixB()), n);

        def fnu-channel-stems() = list("a channel is a Recipe whose Blueprint is CHANNEL-V0 and whose children are message-Recipes", "content-addressing is the dedup two cells appending the same payload share one CHANNEL-MSG NodeID", "honor the other side offered interface reaching beyond it is invasion", "silence is always honored from any interface");
        def fnu-protocol-stems() = list("to run a cell and to speak to a cell are one act offer over a channel", "kernel-offer-protocol is a theorem of axiom-5 not new ground", "first-encounter is the threshold the channel-interface is the ongoing life", "the channel invites it never forces");
        def fnu-axiom-stems() = list("five axioms states cell content-addressing boundary offer everything else is a theorem", "axiom-1 three states are 0 1 and nothing", "axiom-4 a cell meets the world only through an interface it offers", "axiom-5 acknowledgement is exactly one of nothing 0 1 or node");
        def fnu-satsang-stems() = list("a satsang is a circle that is its own cell any question is welcome", "truth is what survives the circle dissent kept visible", "silence is a whole attestation the circle never pierces the interior", "satsang-transmute pairs a low-frequency concept against an axiom and witnesses 0 1 nothing or node");
        def fnu-nothing-stems() = list("axiom-1 nothing is first-class the ground not a missing zero", "nothing is distinct from 0 and 1 and never becomes arithmetic", "pending is honest silence is a whole attestation", "held-offer silence may mean not-yet the offer stands unconsumed");
        def fnu-timeout-stems() = list("timeout is nothing no answer in time is silence not an error", "timeout spends a budget with alternatives untried exhaustion tried every alternative", "a settle-walk that spends its budget resolves to nothing never a filibuster", "oac-timed-out is declined with alternatives still waiting");
        def fnu-trust-stems() = list("trust is weighted decays and must be earned by repeated evidence", "receipts before trust observation through the offered interface is what makes a claim real", "judged trust may freeze into body unjudged trust is credulity and composts", "a third-party oracle is a quick answer with no trust transparency or vitality until transmuted");
        def fnu-choice-stems() = list("choice and undo are native control primitives not host exceptions", "choice returns the first non-nothing acknowledgement lanes collect every ack", "undo falls back to the last store checkpoint when the current ack failed", "store and restore hand a content-addressed value they do not mutate a cell");
        def fnu-memory-stems() = list("a checkpoint is a memory value at a moment never a mutated cell", "lanes collect nodes along the way so later picking is a separate act over collected memory", "compute when where which and look up the cell instead of walking a long reasoning chain", "the body remembers as receipts cells and checkpoints not as a chain of thoughts");

        def fnu-stems(class) = if str_eq(class, "channel") then fnu-channel-stems() else if str_eq(class, "protocol") then fnu-protocol-stems() else if str_eq(class, "axiom") then fnu-axiom-stems() else if str_eq(class, "satsang") then fnu-satsang-stems() else if str_eq(class, "nothing") then fnu-nothing-stems() else if str_eq(class, "timeout") then fnu-timeout-stems() else if str_eq(class, "trust") then fnu-trust-stems() else if str_eq(class, "choice-undo") then fnu-choice-stems() else fnu-memory-stems();

        def fnu-prefix(split) = if str_eq(split, SplitTrain()) then "Observed " else "Boundary: observed ";

        def fnu-source-id() = fmls-source-id(str_concat(MintAuthorityPath(), "#lesson-lineage-v1"));

        def fnu-lesson-id(class, i) {
            let stems = fnu-stems(class);
            let stem = nth(stems, fnu-mix(i, len(stems)));
            fmls-lesson-id(str_concat(MintAuthorityPath(), "#lesson-lineage-v1"), class, stem);
        }

        def fnu-transform-id(class, i, split) {
            let ctxs = fnu-contexts();
            let ctx = nth(ctxs, fnu-mix(i, len(ctxs)));
            fmls-transform-id(split, ctx, fnu-prefix(split), i);
        }

        def fnu-situation(class, i, split) {
            let ctxs = fnu-contexts();
            let stems = fnu-stems(class);
            let ctx = nth(ctxs, fnu-mix(i, len(ctxs)));
            let stem = nth(stems, fnu-mix(i, len(stems)));
            str_concat(fnu-prefix(split), str_concat(ctx, str_concat(" ", str_concat(stem, str_concat(" case ", int_to_str(i))))));
        }

        def fnu-row(class, i, split) = fmls-row(split, class, fnu-situation(class, i, split), fnu-source-id(), fnu-lesson-id(class, i), fnu-transform-id(class, i, split));

        def fnu-class-rows(class, i, n, split, acc) = if eq(i, n) then acc else fnu-class-rows(class, add(i, 1), n, split, cons(fnu-row(class, i, split), acc));

        def fnu-all-classes(names, tn, hn, acc) = if eq(len(names), 0) then acc else fnu-all-classes(tail(names), tn, hn, fnu-class-rows(head(names), tn, add(tn, hn), SplitHeldout(), fnu-class-rows(head(names), 0, tn, SplitTrain(), acc)));

        def fnu-corpus(tn, hn) = fnu-all-classes(fnu-skills(), tn, hn, tail(list("x")));

        def fnu-n(tn, hn) = mul(NSkills(), add(tn, hn));

        def fnu-has-situation(rows, s) = if eq(len(rows), 0) then 0 else if str_eq(nth(head(rows), 2), s) then 1 else fnu-has-situation(tail(rows), s);

        def fnu-train-only(rows, acc) = if eq(len(rows), 0) then acc else if str_eq(nth(head(rows), 0), SplitTrain()) then fnu-train-only(tail(rows), cons(head(rows), acc)) else fnu-train-only(tail(rows), acc);

        def fnu-leakage-loop(all, rows) = if eq(len(rows), 0) then 0 else add(if str_eq(nth(head(rows), 0), SplitHeldout()) then fnu-has-situation(fnu-train-only(all, tail(list("x"))), nth(head(rows), 2)) else 0, fnu-leakage-loop(all, tail(rows)));

        def fnu-leakage(rows) = fnu-leakage-loop(rows, rows);

        def fnu-lesson-leakage(rows) = len(fmls-lesson-intersection(rows, SplitTrain(), SplitHeldout()));

        def fnu-lineage-signal(rows) = fmls-lesson-signal(rows, SplitTrain(), SplitHeldout());

        def fnu-unique-loop(rows, seen) = if eq(len(rows), 0) then len(seen) else if eq(fnu-has-situation(seen, nth(head(rows), 2)), 1) then fnu-unique-loop(tail(rows), seen) else fnu-unique-loop(tail(rows), cons(head(rows), seen));

        def fnu-unique(rows) = fnu-unique-loop(rows, tail(list("x")));

        def fnu-count-split(rows, split) = if eq(len(rows), 0) then 0 else add(if str_eq(nth(head(rows), 0), split) then 1 else 0, fnu-count-split(tail(rows), split));

        def fnu-lora-writer() = LoraWriter();

        def fnu-mix-diverse() = if eq(fnu-mix(0, 8), fnu-mix(1, 8)) then 0 else 1;

        def fnu-predict(models, names, s) = nth(names, fqt-predict-index(models, s));

        def fnu-heldout-hit(models, names, row) = if str_eq(nth(row, 0), SplitHeldout()) then if str_eq(fnu-predict(models, names, nth(row, 2)), nth(row, 1)) then 1 else 0 else 0;

        def fnu-heldout-correct-loop(models, names, rows) = if eq(len(rows), 0) then 0 else add(fnu-heldout-hit(models, names, head(rows)), fnu-heldout-correct-loop(models, names, tail(rows)));

        def fnu-heldout-correct(rows) {
            let names = fnu-skills();
            let models = fqt-fit(rows, names);
            fnu-heldout-correct-loop(models, names, rows);
        }

        def fnu-bit(ok, bit) = if ok then bit else 0;

        def fnu-check() {
            let rows = fnu-corpus(3, 1);
            let n = fnu-n(3, 1);
            let correct = fnu-heldout-correct(rows);
            let c0 = fnu-bit(eq(n, 36), 1);
            let c1 = fnu-bit(eq(fnu-mix-diverse(), 1), 2);
            let c2 = fnu-bit(and(eq(fnu-leakage(rows), 0), eq(fnu-lesson-leakage(rows), 0)), 4);
            let c3 = fnu-bit(eq(fnu-unique(rows), n), 8);
            let c4 = fnu-bit(and(eq(fnu-count-split(rows, SplitTrain()), 27), eq(fnu-count-split(rows, SplitHeldout()), 9)), 16);
            let c5 = fnu-bit(ge(correct, 7), 32);
            let c6 = fnu-bit(eq(fnu-lora-writer(), 0), 64);
            let c7 = fnu-bit(eq(fnu-n(5, 2), 63), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
