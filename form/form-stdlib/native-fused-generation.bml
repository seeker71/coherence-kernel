// A complete standalone model generation is published with one pointer rename.
// preludes: form-stdlib/native-adapter-generation.bml
section [form.bml] {
 class NativeFusedGeneration {
  def nfg-names() = list("config.json","model.safetensors","model.safetensors.index.json","tokenizer.json","tokenizer_config.json","chat_template.jinja");
  def nfg-paths(dir,names) = if nil?(names) then list() else cons(str_concat(dir,str_concat("/",head(names))),nfg-paths(dir,tail(names)));
  def nfg-present(paths) = if nil?(paths) then 1 else and(gt(file_size(head(paths)),0),nfg-present(tail(paths)));
  def nfg-complete(dir) = and(nfg-present(nfg-paths(dir,nfg-names())),and(gt(file_size(str_concat(dir,"/fusion-inputs.json")),0),gt(file_size(str_concat(dir,"/fusion-outputs.json")),0)));
  def nfg-resolve(root) {
   let pointer = read_file(str_concat(root,"/native-fused-current"));
   if nothing?(pointer) then root else if nfg-complete(trim(pointer)) then trim(pointer) else form_error("native fused generation is incomplete");
  }
  def nfg-publish(root,generation) {
   if not(nfg-complete(generation)) then form_error("native fused publication requires a complete generation") else nfg-publish-complete(root,generation);
  }
  def nfg-publish-complete(root,generation) {
   let made = fs-mkdir(root); let candidate = str_concat(root,str_concat("/native-fused-current.candidate-",int_to_str(host_pid())));
   let wrote = nag-write(candidate,str_concat(generation,"\n"));
   if not(eq(fs-rename(candidate,str_concat(root,"/native-fused-current")),0)) then form_error("native fused pointer publication refused") else generation;
  }
 }
 0;
}
