// A complete standalone model generation is published with one pointer rename.
// preludes: form-stdlib/native-adapter-generation.bml
section [form.bml] {
 class NativeFusedGeneration {
  def nfg-names() = list("config.json","model.safetensors","model.safetensors.index.json","tokenizer.json","tokenizer_config.json","chat_template.jinja");
  def nfg-paths(dir,names) = nil?(names) ? list() : cons(dir ++ "/" ++ head(names),nfg-paths(dir,tail(names)));
  def nfg-present(paths) = nil?(paths) ? 1 : ((file_size(head(paths)) > 0) && nfg-present(tail(paths)));
  def nfg-complete(dir) = nfg-present(nfg-paths(dir,nfg-names())) && ((file_size(dir ++ "/fusion-inputs.json") > 0) && (file_size(dir ++ "/fusion-outputs.json") > 0));
  def nfg-resolve(root) {
   let pointer = read_file(root ++ "/native-fused-current");
   nothing?(pointer) ? root : nfg-complete(trim(pointer)) ? trim(pointer) : form_error("native fused generation is incomplete");
  }
  def nfg-publish(root,generation) {
   !nfg-complete(generation) ? form_error("native fused publication requires a complete generation") : nfg-publish-complete(root,generation);
  }
  def nfg-publish-complete(root,generation) {
   let made = fs-mkdir(root); let candidate = root ++ "/native-fused-current.candidate-" ++ int_to_str(host_pid());
   let wrote = nag-write(candidate,generation ++ "\n");
   !((Comparable) fs-rename(candidate,root ++ "/native-fused-current") == 0) ? form_error("native fused pointer publication refused") : generation;
  }
 }
 0;
}
