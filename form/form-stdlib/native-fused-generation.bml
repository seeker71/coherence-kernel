// A complete standalone model generation is published with one pointer rename.
import form-stdlib/native-adapter-generation.bml;
section [form.bml] {
 class NativeFusedGeneration {
  def nfg-names() = ["config.json","model.safetensors","model.safetensors.index.json","tokenizer.json","tokenizer_config.json","chat_template.jinja"];
  def nfg-paths(dir,names) = if nil?(names) then [] else cons((dir + ("/" + names[0])),nfg-paths(dir,names[1:]));
  def nfg-present(paths) = if nil?(paths) then 1 else ((file_size(paths[0]) > 0) && nfg-present(paths[1:]));
  def nfg-complete(dir) = (nfg-present(nfg-paths(dir,nfg-names())) && ((file_size((dir + "/fusion-inputs.json")) > 0) && (file_size((dir + "/fusion-outputs.json")) > 0)));
  def nfg-resolve(root) {
   let pointer = read_file((root + "/native-fused-current"));
   if nothing?(pointer) then root else if nfg-complete(trim(pointer)) then trim(pointer) else form_error("native fused generation is incomplete");
  }
  def nfg-publish(root,generation) {
   if (!nfg-complete(generation)) then form_error("native fused publication requires a complete generation") else nfg-publish-complete(root,generation);
  }
  def nfg-publish-complete(root,generation) {
   let made = fs-mkdir(root); let candidate = (root + ("/native-fused-current.candidate-" + host_pid().str()));
   let wrote = nag-write(candidate,(generation + "\n"));
   if (!((Comparable) fs-rename(candidate,(root + "/native-fused-current")) == 0)) then form_error("native fused pointer publication refused") else generation;
  }
 }
 0;
}
