; public-source-concept-shard-drive.fk -- bounded carrier orchestration.
;
; Each worker invocation owns at most one 32-source batch, so interned nodes and
; parser lists are released at the process boundary.  The Form state cursor is
; the authority: a subprocess that does not advance it stops the drive rather
; than being retried forever.  Worker stdout is withheld because source-level
; progress is rendered once by the final report.
;
; PROOF LEVEL: FOURTH-ARM ONLY (host-exec restarts the same fkwu body)
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-fs.fk form-stdlib/file-byte-window.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/form-knowledge-source-search.fk form-stdlib/public-source-concept-index.fk form-stdlib/public-source-concept-shards.fk

(do
    (defn pscid-worker-command (control-dir)
        (str_concat "env TMPDIR=\"" (str_concat control-dir
            "\" ./fkwu form/form-stdlib/public-source-concept-shard-worker.fk </dev/null >/dev/null 2>&1")))
    (defn pscid-worker-step (action root artifact family)
        (do
            (let control-dir (pscish-control-dir artifact family))
            (let expected (pscish-render-request action root artifact family))
            (let wrote (pscish-write-request-at control-dir
                action root artifact family))
            (if (le wrote 0) 0
                (do
                    (let _ran (host-exec
                        (pscid-worker-command control-dir) ""))
                    ; A same-artifact/family concurrent writer is a control
                    ; signal, never permission to trust an uncorrelated step.
                    (if (str_eq (fs-read-text
                            (pscish-request-path-at control-dir)) expected)
                        1 0)))))
    (defn pscid-init-families (root artifact families)
        (if (nil? families) 1
            (do
                (let family (psci-family-id (head families)))
                (let _step (pscid-worker-step "init" root artifact family))
                (let state (pscish-read-build-state artifact family))
                (if (eq (nth state 2)
                        (psci-count-repository-family-at root family))
                    (pscid-init-families root artifact (tail families)) 0))))
    (defn pscid-build-family-loop (root artifact family fuel)
        (do
            (let before (pscish-read-build-state artifact family))
            (if (eq (nth before 7) 1) 1
            (if (le fuel 0) 0
                (do
                    (let _step (pscid-worker-step "build" root artifact family))
                    (let after (pscish-read-build-state artifact family))
                    (if (eq (nth after 7) 1) 1
                        (if (gt (nth after 1) (nth before 1))
                            (pscid-build-family-loop root artifact family
                                (sub fuel 1)) 0)))))))
    (defn pscid-build-families (root artifact families)
        (if (nil? families) 1
            (do
                (let family (psci-family-id (head families)))
                (let state (pscish-read-build-state artifact family))
                (let fuel (add 4 (div (add (nth state 2)
                    (sub (pscish-batch-size) 1)) (pscish-batch-size))))
                (if (eq (pscid-build-family-loop root artifact family fuel) 1)
                    (pscid-build-families root artifact (tail families)) 0))))
    (defn pscid-reset-validations (root artifact families)
        (if (nil? families) 1
            (do
                (let family (psci-family-id (head families)))
                (let _step (pscid-worker-step "validate-reset" root artifact family))
                (let state (pscish-read-validate-state artifact family))
                (if (and (eq (nth state 1) 0) (eq (nth state 7) 0))
                    (pscid-reset-validations root artifact (tail families)) 0))))
    (defn pscid-validate-family-loop (root artifact family fuel)
        (do
            (let before (pscish-read-validate-state artifact family))
            (if (eq (nth before 7) 1) 1
            (if (le fuel 0) 0
                (do
                    (let _step (pscid-worker-step "validate" root artifact family))
                    (let after (pscish-read-validate-state artifact family))
                    (if (eq (nth after 7) 1) 1
                        (if (gt (nth after 1) (nth before 1))
                            (pscid-validate-family-loop root artifact family
                                (sub fuel 1)) 0)))))))
    (defn pscid-validate-families (root artifact families)
        (if (nil? families) 1
            (do
                (let family (psci-family-id (head families)))
                (let state (pscish-read-build-state artifact family))
                (let fuel (add 4 (div (add (nth state 2)
                    (sub (pscish-batch-size) 1)) (pscish-batch-size))))
                (if (eq (pscid-validate-family-loop root artifact family fuel) 1)
                    (pscid-validate-families root artifact (tail families)) 0))))
    0)
