; form-cli-lang-os-run.fk — observe the language OS: miss, ice, homecoming.
;
; Remote is a sealed lookup row. Framebuffer watches the flip, no prompt text.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-lang-os.bml observe/bidirectional-framebuffer-channel.fk

(do
    (print "form-cli executed lang-os\n")
    (print "form-cli seats=")
    (print (int_to_str (len (flo-names))))
    (print " c-file=")
    (print (int_to_str (nth (flo-file) 4)))
    (print " id-file=")
    (print (int_to_str (nth (flo-file) 8)))
    (print "\nform-cli licht-before=")
    (print (int_to_str (flo-ask (empty) "licht")))
    (print " lane-before=")
    (print (int_to_str (flo-walk (flo-hit (empty) "licht") 0)))
    (print "\nform-cli licht-after=")
    (print (int_to_str (flo-ask (flo-home) "licht")))
    (print " lane-after=")
    (print (int_to_str (flo-walk (flo-hit (flo-home) "licht") 0)))
    (print "\nform-cli guang=")
    (print (int_to_str (flo-ask (flo-home) "guang")))
    (print " cahaya=")
    (print (int_to_str (flo-ask (flo-home) "cahaya")))
    (print " lumiere=")
    (print (int_to_str (flo-ask (flo-home) "lumiere")))
    (print " light=")
    (print (int_to_str (flo-ask (flo-home) "light")))
    (print " luz=")
    (print (int_to_str (flo-ask (flo-home) "luz")))
    (print "\nform-cli surprise=")
    (print (int_to_str (flo-surprise)))
    (print " short=")
    (print (int_to_str (flo-surprise-short)))
    (print " check=")
    (print (int_to_str (flo-check)))
    (print "\n")
    (framebuffer-clear)
    (print "form-cli fb-action=")
    (print (int_to_str (bfc-payload (nth (bfc-round 1 (list 4 2) (list 4 2) (list 0 4) 0) 1))))
    (print " fb-events=")
    (print (int_to_str (len (framebuffer-events))))
    (print "\n")
    0)
