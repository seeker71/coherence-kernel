; form-cli-peer-direct-source-action-live-run.fk -- one caller-held, local
; source action through the retained current-answer PIF. It is deliberately a
; runner rather than a four-way band: its one strict filesystem read uses this
; residence's already-built public source artifact.
;
; preludes: form-stdlib/form-cli-peer-direct-source-action.fk

(do
    (defn fcpdsal-line (key value)
        (print_str (str_concat key (str_concat "="
            (str_concat value "\n")))))
    (let root (fhcs-default-root))
    (let artifact (fknq-default-artifact))
    (let ctx (if (str_eq root "") (nothing)
        (fknsc-public-context root artifact 0 (fknq-max-frame-bytes))))
    (let direct (fcpdsa-run (list "live-direct-session") "source-concept"
        "defn-psci-schema" ctx "live-direct-source" "form-cli-live-run"))
    (fcpdsal-line "signal" (fcpdsa-signal direct))
    (fcpdsal-line "reason" (fcpdsa-reason direct))
    (fcpdsal-line "lookup-count" (int_to_str (fcpdsa-lookup-count direct)))
    (fcpdsal-line "tool-status" (fcpdsa-tool-status direct))
    (fcpdsal-line "lifecycle" (fcpdsa-lifecycle direct))
    (fcpdsal-line "resident-value-present"
        (int_to_str (fcpdsa-value-present? direct)))
    (fcpdsal-line "resident-value" (if (eq (fcpdsa-value-present? direct) 1)
        (int_to_str (fcpdsa-value direct)) ""))
    (fcpdsal-line "world-admitted" (int_to_str
        (fcpdsa-knowledge-contribution direct)))
    (fcpdsal-line "mutation-contribution" (int_to_str
        (fcpdsa-mutation-contribution direct)))
    0)
