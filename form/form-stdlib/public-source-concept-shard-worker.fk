; public-source-concept-shard-worker.fk -- one bounded resumable shard breath.
;
; The request is a strict four-field local control row at
; /tmp/public-source-concept-shard-request-v1.  Only action/family and scalar
; cursor counts are rendered; source paths, keys, and payloads stay private to
; the local registry artifact.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-fs.fk form-stdlib/file-byte-window.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/form-knowledge-source-search.fk form-stdlib/public-source-concept-index.fk form-stdlib/public-source-concept-shards.fk

(do
    (defn pscishw-line (action family state)
        (str_concat "action=" (str_concat action
        (str_concat " family=" (str_concat family
        (str_concat " cursor=" (str_concat (int_to_str (nth state 1))
        (str_concat " observed=" (str_concat (int_to_str (nth state 2))
        (str_concat " accepted=" (str_concat (int_to_str (nth state 3))
        (str_concat " done=" (str_concat (int_to_str (nth state 7)) "\n")))))))))))))
    (let request (pscish-parse-request (fs-read-text (pscish-request-path))))
    (if (eq (len request) 0)
        (print_str "action=nothing reason=invalid-shard-request\n")
        (do
            (let action (nth request 0))
            (let root (nth request 1))
            (let artifact (nth request 2))
            (let family (nth request 3))
            (if (str_eq action "init")
                (do
                    (let planned (pscish-init-family-at root artifact family))
                    (print_str (str_concat "action=init family=" (str_concat family
                        (str_concat " planned=" (str_concat (int_to_str planned) "\n"))))))
            (if (str_eq action "build")
                (do
                    (let state (pscish-build-batch-at root artifact family
                        (pscish-batch-size)))
                    (print_str (pscishw-line action family state)))
            (if (str_eq action "validate-reset")
                (do
                    (let _reset (pscish-reset-validation-at artifact family))
                    (print_str (str_concat "action=validate-reset family="
                        (str_concat family "\n"))))
            (if (str_eq action "validate")
                (do
                    (let state (pscish-validate-batch-at root artifact family
                        (pscish-batch-size)))
                    (print_str (pscishw-line action family state)))
                (print_str "action=nothing reason=unknown-shard-action\n")))))))
    0)
