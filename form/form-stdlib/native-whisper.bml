// The actual Whisper checkpoint, mapped into the existing native ear kernels.
// No weight conversion or tensor copies: F16 spans stay in their shared file pages.
// preludes: form-stdlib/ear-native.fk form-stdlib/native-affine-metal.bml form-stdlib/model-registry.bml
section [form.bml] {
 class NativeWhisper {
  def nws-base() = mr-path(mr-find("whisper-large-v3-turbo-safetensors"));
  def nws-tokenizer() = enw-tokenizer-path();
  def nws-layer-shape(st,i) = (Comparable) i == 11 ? list(eng-F(st),eng-D(st)) : (Comparable) i == 13 ? list(eng-D(st),eng-F(st)) : (Comparable) i == 12 ? list(eng-F(st)) : ((Comparable) i == 2) || (((Comparable) i == 4) || (((Comparable) i == 5) || (((Comparable) i == 7) || (((Comparable) i == 17) || (((Comparable) i == 19) || (((Comparable) i == 20) || ((Comparable) i == 22))))))) ? list(eng-D(st),eng-D(st)) : list(eng-D(st));
  def nws-layer-rows(st,prefix,names,i) = nil?(names) ? list() : cons(list(prefix ++ "." ++ head(names),nws-layer-shape(st,i)),nws-layer-rows(st,prefix,tail(names),i + 1));
  def nws-layers(st,side,names,l,count) = l >= count ? list() : append(nws-layer-rows(st,enw-blk(side,l),names,0),nws-layers(st,side,names,l + 1,count));
  def nws-required(st) {
   let d = eng-D(st);
   let common = list(list("encoder.conv1.weight",list(d,3,eng-mels(st))),list("encoder.conv1.bias",list(d)),list("encoder.conv2.weight",list(d,3,d)),list("encoder.conv2.bias",list(d)),list("encoder.ln_post.weight",list(d)),list("encoder.ln_post.bias",list(d)),list("decoder.token_embedding.weight",list(eng-V(st),d)),list("decoder.positional_embedding",list(eng-CTX(st),d)),list("decoder.ln.weight",list(d)),list("decoder.ln.bias",list(d)));
   append(common,append(nws-layers(st,"encoder",enw-enc-names(),0,eng-enc-layers(st)),nws-layers(st,"decoder",enw-dec-names(),0,eng-dec-layers(st))));
  }
  def nws-check(index,required) {
   nil?(required) ? 1 : nws-check-row(index,required,sti-find(index,head(head(required))));
  }
  def nws-check-row(index,required,row) {
   nil?(row) ? form_error("native Whisper tensor absent: " ++ head(head(required))) : !(((String) row[1] == "F16") && (((Value) row[2] == head(required)[1]) && ((Comparable) (row[3] % 2) == 0))) ? form_error("native Whisper tensor shape/dtype/alignment refused: " ++ head(row)) : nws-check(index,tail(required));
  }
  def nws-map(index,required) = nil?(required) ? list() : cons(list(head(head(required)),head(sti-map(index,head(head(required))))),nws-map(index,tail(required)));
  def nws-open(base,tokpath) {
   let geometry = eng-config(base ++ "/config.json"); let stub = eng-state(geometry); let path = base ++ "/weights.safetensors";
   let index = sti-open(path); let required = nws-required(stub); let checked = nws-check(index,required);
   let ps = enw-pipes-for(stub); let hs = nws-map(index,required);
   enw-open-ready(path,index[2],hs,ps,tokpath,geometry);
  }
  // A weight handle is freed by the carrier only once every command that named it has settled; a free
  // asked too early is refused, and the kernel reads that refusal as 0 rather than an error. So the
  // weights are freed in rounds: every handle whose free answered nothing is kept, the device is
  // synced, and those are asked again — at most four rounds, the last one loud. On 2026-09-23 a
  // second open in one process left 150 of 586 weights alive after one pass and none after two.
  def nws-free-weights(hs) = nws-free-rounds(hs,0);
  def nws-free-rounds(hs,round) = nil?(hs) ? 1 : round >= 4 ? form_error("native Whisper weights not released after four rounds: " ++ int_to_str(len(hs))) : nws-free-rounds(nws-free-left(nws-free-synced(hs,round),list()),round + 1);
  def nws-free-synced(hs,round) = (Comparable) round == 0 ? hs : nws-free-after(nam-sync(),hs);
  def nws-free-after(rc,hs) = hs;
  def nws-free-left(hs,left) = nil?(hs) ? reverse(left) : nws-free-left(tail(hs),metal_buf_free(head(hs)[1]) > 0 ? left : cons(head(hs),left));
  def nws-free-buffers(bs,i) = nil?(bs) ? 1 : nws-free-buffers-next(nam-free((i >= 17) && (i <= 20) ? head(bs) : list(head(bs))),tail(bs),i + 1);
  def nws-free-buffers-next(rc,bs,i) = nws-free-buffers(bs,i);
  def nws-close(st) {
   let done = nam-sync(); let weights = nws-free-weights(enw-hs(st)); let buffers = nws-free-buffers(st[4],0);
   1;
  }
 }
 0;
}
