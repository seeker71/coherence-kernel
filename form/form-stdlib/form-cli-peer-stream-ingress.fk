// form-cli-peer-stream-ingress.fk — scannerless, cooperative ingress for one
// resident local Form peer.
//
// This defines the Form-native organ for task timing:
// resident-async-ingress deltas become scannerless peer tasks. The live door
// `observe/form-cli-peer-contribution-live.fk` takes its tasks from an append
// spool and a bell instead.
// Explicit <|form:agent-task|> marks are the protocol clock: an opener, body,
// and closer may cross any number of chunks, and one chunk may carry several
// frames. Newline is ordinary frame data and an optional separator outside a
// frame; it never causes dispatch. Incomplete frames retain their bytes until
// more arrive, timeout, cut, or release. An absolute complete-through watermark
// advances only past a whole close mark, so mid-frame bytes are nothing-yet
// rather than present-empty. Resource choice lives in the dynamic channel's
// gas/deadline rather than a fixed cursor byte ceiling.
//
// Direct research speech is not called zero contribution. It becomes a
// present, content-addressed `candidate` whose acceptance is still nothing.
// A correlated evaluation later supplies exact 0 or 1 and changes it to
// `revise` or `accepted`. A physically executed recipe remains immediately
// `observed-executed`. This makes unvalidated speech visible without flattering
// it into accepted evidence.
//
// `fcpsi-run-peer` is the effectful seam for an already-live fcms session. This
// cell performs no top-level model or Metal work. Results are values and may be
// wrapped as output envelopes; correctness does not depend on stdout flushing.
//
// preludes: form-stdlib/bml/form-cli-peer-direct-answer-dispatch.bml form-stdlib/bml/form-cli-peer-direct-answer-envelope.bml
// preludes: form-stdlib/resident-async-ingress.fk
// Proven by: form-stdlib/tests/form-cli-peer-stream-ingress-band.fk
section [form.bml] {
    // ── scannerless marker cursor, one per dynamic channel ──────────
    def fcpsi-cursor(channel, window, bytes, chunks, completed, complete-through) = list("form-cli-peer-stream-cursor-v1", channel, window, bytes, chunks, completed, complete-through);
    def fcpsi-cursor-channel(c) = nth(c, 1);
    def fcpsi-cursor-window(c) = nth(c, 2);
    def fcpsi-cursor-bytes(c) = nth(c, 3);
    def fcpsi-cursor-chunks(c) = nth(c, 4);
    def fcpsi-cursor-completed(c) = nth(c, 5);
    def fcpsi-cursor-complete-through(c) = nth(c, 6);
    def fcpsi-fresh-cursor(channel) = fcpsi-cursor(channel, "", 0, 0, 0, 0);
    def fcpsi-clip-left(text, count) = str_len(text) <= count ? text : substring(text, str_len(text) - count, str_len(text));
    // extraction = remaining-window, completed-frames, held-open-bit,
    // last-complete end offset in the joined cursor window. Mid-frame bytes do
    // not advance this watermark and therefore remain nothing-yet.
    def fcpsi-extract-go(text, frames, base, last-complete) = {
        let open-at = str_find(text, fcpa-task-open(), 0);
        open-at < 0 ? list(fcpsi-clip-left(text, str_len(fcpa-task-open()) - 1), frames, 0, last-complete) : {
            let close-at = str_find(text, fcpa-task-close(), open-at + str_len(fcpa-task-open()));
            close-at < 0 ? list(substring(text, open-at, str_len(text)), frames, 1, last-complete) : {
                let end = close-at + str_len(fcpa-task-close());
                let frame = substring(text, open-at, end);
                let rest = substring(text, end, str_len(text));
                fcpsi-extract-go(rest, append(frames, list(list(frame, base + end))), base + end, base + end);
            };
        };
    };
    def fcpsi-extract(text, frames) = fcpsi-extract-go(text, frames, 0, 0);
    def fcpsi-absolute-frames(frames, joined-start, out) = (Comparable) len(frames) == 0 ? out : fcpsi-absolute-frames(tail(frames), joined-start, append(out, list(list(nth(head(frames), 0), joined-start + nth(head(frames), 1)))));
    def fcpsi-frame-texts(frames, out) = (Comparable) len(frames) == 0 ? out : fcpsi-frame-texts(tail(frames), append(out, list(nth(head(frames), 0))));
    def fcpsi-frame-ends(frames, out) = (Comparable) len(frames) == 0 ? out : fcpsi-frame-ends(tail(frames), append(out, list(nth(head(frames), 1))));
    // feed result = cursor, frames, held-open-bit. Only arriving delta bytes
    // are examined; there is no tokenizer and no line read.
    def fcpsi-feed(cursor, chunk) = {
        let joined = str_concat(fcpsi-cursor-window(cursor), chunk);
        let joined-start = fcpsi-cursor-bytes(cursor) - str_len(fcpsi-cursor-window(cursor));
        let extracted = fcpsi-extract(joined, list());
        let pairs = fcpsi-absolute-frames(nth(extracted, 1), joined-start, list());
        let frames = fcpsi-frame-texts(pairs, list());
        list(fcpsi-cursor(fcpsi-cursor-channel(cursor), nth(extracted, 0), fcpsi-cursor-bytes(cursor) + str_len(chunk), fcpsi-cursor-chunks(cursor) + 1, fcpsi-cursor-completed(cursor) + len(frames), nth(extracted, 3) > 0 ? joined-start + nth(extracted, 3) : fcpsi-cursor-complete-through(cursor)), frames, nth(extracted, 2), fcpsi-frame-ends(pairs, list()));
    };
    // ── exact task parsing and content identity ─────────────────────
    def fcpsi-task-category() = make_nodeid(31, 2, 0, 222);
    def fcpsi-task(node, channel, sequence, exchange, turn, kind, text, frame, complete-through) = list("form-cli-peer-stream-task-v1", node, channel, sequence, exchange, turn, kind, text, frame, complete-through);
    def fcpsi-task-node(t) = nth(t, 1);
    def fcpsi-task-channel(t) = nth(t, 2);
    def fcpsi-task-sequence(t) = nth(t, 3);
    def fcpsi-task-exchange(t) = nth(t, 4);
    def fcpsi-task-turn(t) = nth(t, 5);
    def fcpsi-task-kind(t) = nth(t, 6);
    def fcpsi-task-text(t) = nth(t, 7);
    def fcpsi-task-frame(t) = nth(t, 8);
    def fcpsi-task-complete-through(t) = nth(t, 9);
    def fcpsi-task-id(channel, sequence, exchange, turn, kind, text) = intern_node(fcpsi-task-category(), list(intern_trivial_string(channel), intern_trivial_int(exchange), intern_trivial_int(turn), intern_trivial_string(kind), intern_trivial_string(text)));
    // Direct-source Form carries a NodeID as its four-coordinate Form value.
    // The accessor primitives are shared by all proof arms, while `node_eq`
    // is intentionally stricter in some arms and accepts only their native
    // NodeID representation.  Task identity is recovered from bytes, so
    // coordinate equality is the exact invariant: no resident-memory object
    // identity is needed for a replayed task to name the same task.
    def fcpsi-nodeid-eq?(a, b) = (Comparable) node_pkg(a) == node_pkg(b) ? (Comparable) node_level(a) == node_level(b) ? (Comparable) node_type(a) == node_type(b) ? (Comparable) node_inst(a) == node_inst(b) ? 1 : 0 : 0 : 0 : 0;
    def fcpsi-frame-parse(channel, sequence, exchange, frame, complete-through) = {
        let open-n = str_len(fcpa-task-open());
        let close-n = str_len(fcpa-task-close());
        let close-at = str_len(frame) - close-n;
        let turn-prefix = "\nturn=";
        let kind-prefix = "\nkind=";
        let task-prefix = "\ntask=";
        let turn-start = open-n + str_len(turn-prefix);
        let kind-mark = str_find(frame, kind-prefix, turn-start);
        let task-mark = str_find(frame, task-prefix, kind-mark < 0 ? turn-start : kind-mark);
        !((Comparable) str_find(frame, fcpa-task-open(), 0) == 0) || (close-at < 0 || (!((Comparable) str_find(frame, fcpa-task-close(), open-n) == close-at) || (!((Comparable) str_find(frame, turn-prefix, open-n) == open-n) || (kind-mark < 0 || task-mark < 0)))) ? nothing() : {
            let turn-text = substring(frame, turn-start, kind-mark);
            let turn = str_to_int(turn-text);
            let kind-start = kind-mark + str_len(kind-prefix);
            let task-start = task-mark + str_len(task-prefix);
            let task-end0 = close-at > task-start && (Comparable) str-byte-at(frame, close-at - 1) == 10 ? close-at - 1 : close-at;
            let kind = substring(frame, kind-start, task-mark);
            let task-end = fcpdae-task-end(kind, frame, task-start, task-end0);
            let text = substring(frame, task-start, task-end);
            !((String) int_to_str(turn) == turn-text) || ((String) kind == "" || (String) text == "") ? nothing() : fcpsi-task(fcpsi-task-id(channel, sequence, exchange, turn, kind, text), channel, sequence, exchange, turn, kind, text, frame, complete-through);
        };
    };
    def fcpsi-parse-frames(channel, sequence, exchange, frames, ends, tasks, bad) = (Comparable) len(frames) == 0 ? list(tasks, bad) : {
        let task = fcpsi-frame-parse(channel, sequence, exchange, head(frames), head(ends));
        nothing?(task) ? fcpsi-parse-frames(channel, sequence, exchange, tail(frames), tail(ends), tasks, bad + 1) : fcpsi-parse-frames(channel, sequence, exchange, tail(frames), tail(ends), append(tasks, list(task)), bad);
    };
    // ── candidates and observed evaluation ──────────────────────────
    // candidate = node task-node exchange response contribution-state accepted
    // accepted is nothing before evaluation, then exact 0 or 1.
    def fcpsi-candidate-category() = make_nodeid(31, 2, 0, 223);
    def fcpsi-candidate(node, task-node, exchange, response, contribution-state, accepted, reason) = list("form-cli-peer-stream-candidate-v1", node, task-node, exchange, response, contribution-state, accepted, reason);
    def fcpsi-candidate-node(c) = nth(c, 1);
    def fcpsi-candidate-task-node(c) = nth(c, 2);
    def fcpsi-candidate-exchange(c) = nth(c, 3);
    def fcpsi-candidate-response(c) = nth(c, 4);
    def fcpsi-candidate-state(c) = nth(c, 5);
    def fcpsi-candidate-accepted(c) = nth(c, 6);
    def fcpsi-candidate-reason(c) = nth(c, 7);
    def fcpsi-candidate-id(task-node, response) = intern_node(fcpsi-candidate-category(), list(task-node, intern_trivial_string(response)));
    def fcpsi-find-task(tasks, node) = (Comparable) len(tasks) == 0 ? nothing() : (Comparable) fcpsi-nodeid-eq?(fcpsi-task-node(head(tasks)), node) == 1 ? head(tasks) : fcpsi-find-task(tail(tasks), node);
    def fcpsi-find-candidate(candidates, node) = (Comparable) len(candidates) == 0 ? nothing() : (Comparable) fcpsi-nodeid-eq?(fcpsi-candidate-node(head(candidates)), node) == 1 ? head(candidates) : fcpsi-find-candidate(tail(candidates), node);
    def fcpsi-replace-candidate(candidates, node, replacement) = (Comparable) len(candidates) == 0 ? list() : (Comparable) fcpsi-nodeid-eq?(fcpsi-candidate-node(head(candidates)), node) == 1 ? cons(replacement, tail(candidates)) : cons(head(candidates), fcpsi-replace-candidate(tail(candidates), node, replacement));
    // ── resident interface state and bounded evidence ───────────────
    def fcpsi-state(ingress, cursors, tasks, candidates, events, event-capacity) = list("form-cli-peer-stream-ingress-v1", ingress, cursors, tasks, candidates, events, event-capacity);
    def fcpsi-ingress(s) = nth(s, 1);
    def fcpsi-cursors(s) = nth(s, 2);
    def fcpsi-tasks(s) = nth(s, 3);
    def fcpsi-candidates(s) = nth(s, 4);
    def fcpsi-events(s) = nth(s, 5);
    def fcpsi-event-capacity(s) = nth(s, 6);
    def fcpsi-new(ingress, event-capacity) = fcpsi-state(ingress, list(), list(), list(), list(), event-capacity);
    def fcpsi-with(s, ingress, cursors, tasks, candidates, events) = fcpsi-state(ingress, cursors, tasks, candidates, events, fcpsi-event-capacity(s));
    def fcpsi-event(exchange, channel, movement, signal, detail) = list(exchange, channel, movement, signal, detail);
    def fcpsi-observe(s, exchange, channel, movement, signal, detail) = fcpsi-with(s, fcpsi-ingress(s), fcpsi-cursors(s), fcpsi-tasks(s), fcpsi-candidates(s), rai-bounded-events(append(fcpsi-events(s), list(fcpsi-event(exchange, channel, movement, signal, detail))), fcpsi-event-capacity(s)));
    def fcpsi-find-cursor(cursors, channel) = (Comparable) len(cursors) == 0 ? nothing() : (String) fcpsi-cursor-channel(head(cursors)) == channel ? head(cursors) : fcpsi-find-cursor(tail(cursors), channel);
    def fcpsi-replace-cursor(cursors, channel, replacement) = (Comparable) len(cursors) == 0 ? list(replacement) : (String) fcpsi-cursor-channel(head(cursors)) == channel ? cons(replacement, tail(cursors)) : cons(head(cursors), fcpsi-replace-cursor(tail(cursors), channel, replacement));
    def fcpsi-cursor-of(s, channel) = {
        let c = fcpsi-find-cursor(fcpsi-cursors(s), channel);
        nothing?(c) ? fcpsi-fresh-cursor(channel) : c;
    };
    // result = state signal present value reason envelope.
    def fcpsi-result(state, signal, present, value, reason, envelope) = list("form-cli-peer-stream-result-v1", state, signal, present, value, reason, envelope);
    def fcpsi-result-state(r) = nth(r, 1);
    def fcpsi-result-signal(r) = nth(r, 2);
    def fcpsi-result-present?(r) = nth(r, 3);
    def fcpsi-result-value(r) = nth(r, 4);
    def fcpsi-result-reason(r) = nth(r, 5);
    def fcpsi-result-envelope(r) = nth(r, 6);
    def fcpsi-offer(s, envelope) = {
        let offered = rai-offer(fcpsi-ingress(s), envelope);
        let s1 = fcpsi-with(s, nth(offered, 0), fcpsi-cursors(s), fcpsi-tasks(s), fcpsi-candidates(s), fcpsi-events(s));
        let s2 = fcpsi-observe(s1, rai-env-exchange(envelope), rai-env-channel(envelope), rai-env-kind(envelope), nth(offered, 2), rai-env-sequence(envelope));
        fcpsi-result(s2, nth(offered, 2), nothing?(nth(offered, 1)) ? 0 : 1, nth(offered, 1), nth(offered, 2), envelope);
    };
    def fcpsi-feed-yielded(s, envelope) = {
        let channel = rai-env-channel(envelope);
        let old = fcpsi-cursor-of(s, channel);
        let fed = fcpsi-feed(old, rai-env-payload(envelope));
        let parsed = fcpsi-parse-frames(channel, rai-env-sequence(envelope), rai-env-exchange(envelope), nth(fed, 1), nth(fed, 3), list(), 0);
        let next-cursors = fcpsi-replace-cursor(fcpsi-cursors(s), channel, nth(fed, 0));
        let bad = nth(parsed, 1);
        let tasks = nth(parsed, 0);
        let s1 = fcpsi-with(s, fcpsi-ingress(s), next-cursors, bad > 0 ? fcpsi-tasks(s) : append(fcpsi-tasks(s), tasks), fcpsi-candidates(s), fcpsi-events(s));
        bad > 0 ? {
            let s2 = fcpsi-observe(s1, rai-env-exchange(envelope), channel, "task-frame", "failure", bad);
            fcpsi-result(s2, "failure", 0, nothing(), "task-frame-malformed", envelope);
        } : len(tasks) > 0 ? {
            let s2 = fcpsi-observe(s1, rai-env-exchange(envelope), channel, "task-frame", "value", len(tasks));
            fcpsi-result(s2, "value", 1, tasks, "scannerless-task-frame-complete", envelope);
        } : {
            let signal = (Comparable) nth(fed, 2) == 1 ? "held" : "nothing";
            let s2 = fcpsi-observe(s1, rai-env-exchange(envelope), channel, "task-bytes", signal, str_len(rai-env-payload(envelope)));
            fcpsi-result(s2, signal, 0, nothing(), (String) signal == "held" ? "scannerless-task-frame-held" : "no-task-frame", envelope);
        };
    };
    def fcpsi-peer-result(s, task-node, response, recipe-contribution, envelope) = {
        let task = fcpsi-find-task(fcpsi-tasks(s), task-node);
        nothing?(task) ? fcpsi-result(s, "nothing", 0, nothing(), "task-node-absent", envelope) : {
            let node = fcpsi-candidate-id(task-node, response);
            let executed = (Comparable) recipe-contribution == 1 ? 1 : 0;
            let candidate = fcpsi-candidate(node, task-node, fcpsi-task-exchange(task), response, (Comparable) executed == 1 ? "observed-executed" : "candidate", (Comparable) executed == 1 ? 1 : nothing(), (Comparable) executed == 1 ? "typed-recipe-callback" : "evaluation-not-yet-observed");
            let s1 = fcpsi-with(s, fcpsi-ingress(s), fcpsi-cursors(s), fcpsi-tasks(s), cons(candidate, fcpsi-candidates(s)), fcpsi-events(s));
            let s2 = fcpsi-observe(s1, fcpsi-task-exchange(task), fcpsi-task-channel(task), "peer-result", fcpsi-candidate-state(candidate), node);
            fcpsi-result(s2, fcpsi-candidate-state(candidate), 1, candidate, fcpsi-candidate-reason(candidate), envelope);
        };
    };
    def fcpsi-evaluate(s, candidate-node, accepted, reason, exchange, envelope) = {
        let candidate = fcpsi-find-candidate(fcpsi-candidates(s), candidate-node);
        nothing?(candidate) ? fcpsi-result(s, "nothing", 0, nothing(), "candidate-node-absent", envelope) : !((Comparable) fcpsi-candidate-exchange(candidate) == exchange) ? fcpsi-result(s, "choice", 1, candidate-node, "candidate-exchange-mismatch", envelope) : !((Comparable) accepted == 0 || (Comparable) accepted == 1) ? fcpsi-result(s, "failure", 0, nothing(), "evaluation-not-zero-or-one", envelope) : {
            let next = fcpsi-candidate(candidate-node, fcpsi-candidate-task-node(candidate), fcpsi-candidate-exchange(candidate), fcpsi-candidate-response(candidate), (Comparable) accepted == 1 ? "accepted" : "revise", accepted, reason);
            let s1 = fcpsi-with(s, fcpsi-ingress(s), fcpsi-cursors(s), fcpsi-tasks(s), fcpsi-replace-candidate(fcpsi-candidates(s), candidate-node, next), fcpsi-events(s));
            let s2 = fcpsi-observe(s1, exchange, "evaluation", "evaluation", (Comparable) accepted == 1 ? "accepted" : "revise", candidate-node);
            fcpsi-result(s2, (Comparable) accepted == 1 ? "accepted" : "revise", 1, accepted, reason, envelope);
        };
    };
    def fcpsi-undo(s, candidate-node, exchange, envelope) = {
        let candidate = fcpsi-find-candidate(fcpsi-candidates(s), candidate-node);
        nothing?(candidate) ? fcpsi-result(s, "nothing", 0, nothing(), "candidate-node-absent", envelope) : {
            let next = fcpsi-candidate(candidate-node, fcpsi-candidate-task-node(candidate), fcpsi-candidate-exchange(candidate), fcpsi-candidate-response(candidate), "candidate", nothing(), "evaluation-undone");
            let s1 = fcpsi-with(s, fcpsi-ingress(s), fcpsi-cursors(s), fcpsi-tasks(s), fcpsi-replace-candidate(fcpsi-candidates(s), candidate-node, next), fcpsi-events(s));
            let s2 = fcpsi-observe(s1, exchange, "evaluation", "undo", "undo", candidate-node);
            fcpsi-result(s2, "undo", 1, next, "evaluation-undone", envelope);
        };
    };
    def fcpsi-dispatch(s, envelope) = (String) rai-env-kind(envelope) == "task-bytes" ? fcpsi-feed-yielded(s, envelope) : (String) rai-env-kind(envelope) == "peer-result" ? {
        let p = rai-env-payload(envelope);
        fcpsi-peer-result(s, nth(p, 0), nth(p, 1), nth(p, 2), envelope);
    } : (String) rai-env-kind(envelope) == "evaluation" ? {
        let p = rai-env-payload(envelope);
        fcpsi-evaluate(s, nth(p, 0), nth(p, 1), nth(p, 2), rai-env-exchange(envelope), envelope);
    } : (String) rai-env-kind(envelope) == "undo" ? fcpsi-undo(s, rai-env-payload(envelope), rai-env-exchange(envelope), envelope) : {
        let s1 = fcpsi-observe(s, rai-env-exchange(envelope), rai-env-channel(envelope), rai-env-kind(envelope), "choice", rai-env-alternative(envelope));
        fcpsi-result(s1, "choice", 1, rai-env-alternative(envelope), "movement-not-selected", envelope);
    };
    // One cooperative quantum. rai owns dynamic-channel round robin and exact
    // timeout/cut/release signals; only value envelopes reach task dispatch.
    def fcpsi-step(s, now) = {
        let yielded = rai-yield(fcpsi-ingress(s), now);
        let s1 = fcpsi-with(s, nth(yielded, 0), fcpsi-cursors(s), fcpsi-tasks(s), fcpsi-candidates(s), fcpsi-events(s));
        let envelope = nth(yielded, 1);
        let signal = nth(yielded, 2);
        nothing?(envelope) ? fcpsi-result(s1, "nothing", 0, nothing(), "ingress-idle", nothing()) : !((String) signal == "value") ? {
            let s2 = fcpsi-observe(s1, rai-env-exchange(envelope), rai-env-channel(envelope), rai-env-kind(envelope), signal, rai-env-alternative(envelope));
            fcpsi-result(s2, signal, 0, nothing(), rai-env-alternative(envelope), envelope);
        } : fcpsi-dispatch(s1, envelope);
    };
    // The action name arrives from a caller-held policy route, never from task
    // bytes. It selects among existing source effects while their model/KV and
    // capability inputs remain caller-owned. An action/type mismatch is an
    // observed choice, not a fallback to a different effect.
    def fcpsi-default-action(task) = (String) fcpsi-task-kind(task) == "direct-answer" ? "direct-answer" : (String) fcpsi-task-kind(task) == "repo-patch" ? "repo-patch" : (String) fcpsi-task-kind(task) == "source-concept" || (String) fcpsi-task-kind(task) == "source-nodeid" ? "source-knowledge" : (String) fcpsi-task-kind(task) == "source-symbol" ? "source-symbol" : "model";
    def fcpsi-action-result(session, action, reason) = fcpa-result-full(session, nothing(), str_concat("policy action not selected: ", reason), 0, 0, "policy", 0, "choice", "form-policy", 0, nothing(), 0, 0, "choice", 0);
    def fcpsi-knowledge-task?(task) = (String) fcpsi-task-kind(task) == "source-concept" || (String) fcpsi-task-kind(task) == "source-nodeid" ? 1 : 0;
    def fcpsi-run-peer-with-action-with-patch-with-stage-context(s, session, task-node, budget, patch-ctx, action, stage-observer, stage-context) = {
        let task = fcpsi-find-task(fcpsi-tasks(s), task-node);
        nothing?(task) ? list(s, nothing(), fcpsi-result(s, "nothing", 0, nothing(), "task-node-absent", nothing())) : {
            // A source policy action requires the caller-owned direct
            // source adapter. This generic legacy seam has no source
            // context, so it refuses before fcpa-observe-task rather
            // than reviving a Qwen-mediated lookup path.
            let peer = (Comparable) fcpdad-selected?(action) == 1 ?             // This BML-owned action enters the caller-held session
            // directly.  No task-observation prompt is prefixed to
            // direct speech, and `budget` remains the caller's
            // per-turn allocation rather than a dispatcher ceiling.
fcpdad-run(session, fcpsi-task-kind(task), fcpsi-task-text(task), budget) : (String) action == "source-knowledge" ? fcpsi-action-result(session, action, "source-knowledge-requires-caller-source-context") : {
                let observed = fcpa-observe-task(session, fcpsi-task-turn(task), fcpsi-task-kind(task), fcpsi-task-text(task));
                (String) action == "model" ? fcpa-run(observed, budget) : (String) action == "repo-patch" ? (String) fcpsi-task-kind(task) == "repo-patch" ? fcpa-run-patch(observed, budget, patch-ctx) : fcpsi-action-result(session, action, "repo-patch-requires-repo-patch-task") : fcpsi-action-result(session, action, "policy-action-not-admitted");
            };
            let candidate = fcpsi-peer-result(s, task-node, fcpa-response(peer), fcpa-contribution(peer), nothing());
            list(fcpsi-result-state(candidate), peer, candidate);
        };
    };
    // Effectful only when explicitly called with an already-live session.
    // Existing callers take the source-declared action; policy-aware callers
    // enter through the explicit action seam above.
    def fcpsi-run-peer-with-patch-with-stage-context(s, session, task-node, budget, patch-ctx, stage-observer, stage-context) = {
        let task = fcpsi-find-task(fcpsi-tasks(s), task-node);
        nothing?(task) ? list(s, nothing(), fcpsi-result(s, "nothing", 0, nothing(), "task-node-absent", nothing())) : fcpsi-run-peer-with-action-with-patch-with-stage-context(s, session, task-node, budget, patch-ctx, fcpsi-default-action(task), stage-observer, stage-context);
    };
    // Existing callers remain source-compatible and receive the original
    // stdout/framebuffer observer through an explicit empty context.
    def fcpsi-run-peer-with-patch(s, session, task-node, budget, patch-ctx) = fcpsi-run-peer-with-patch-with-stage-context(s, session, task-node, budget, patch-ctx, fcpa-knowledge-stage-observer-with-context, nothing());
    def fcpsi-run-peer(s, session, task-node, budget) = fcpsi-run-peer-with-patch(s, session, task-node, budget, nothing());
    // A result can travel on another dynamic channel without stdout, a server,
    // or a process restart. Payload retains typed structure, including 0/1.
    def fcpsi-output-envelope(result, channel, sequence, exchange, alternative, deadline) = rai-envelope(channel, sequence, exchange, "peer-observation", result, alternative, deadline);
    0;
}
