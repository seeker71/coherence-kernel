; ear-tongue.fk — the two tongues not heard, offered by the body's own generation lane: llama3.2
; (the registry's llama32-1b blob) through dense-token-handle, form-native on this metal. A
; completion-shaped prompt, greedy, cut at the first line break. Slower than a rented model and
; weaker in Persian; named, not hidden. Nothing leaves this Mac.
;
; The lane holds what a line must not pay again: the file's bos/eos ids (a header walk each), the
; vocabulary as fixed-width record buckets (a token is one file read and a byte walk, no
; substring), the decoded pieces behind an id index (a word is two slices), and the KV cache of
; the last prompt — a new line prefills only past the tokens it shares with what the cache holds,
; and the head runs once, on the last prompt token.
; preludes: native/metal/dense-token-handle.fk native/metal/dense-multi.fk form-stdlib/model-registry.bml form-stdlib/spool-bell-transport.fk form-stdlib/form-fs.fk form-stdlib/line-grammar.fk form-stdlib/bml/transcript-languages.bml
(do
    ; the tongues a line can be offered in: whisper's codes, the names the prompt speaks
    (defn et-name-rows () (tln-rows))
    (defn et-name-of (rows code) (if (eq (len rows) 0) "" (if (str_eq (head (head rows)) code) (nth (head rows) 1) (et-name-of (tail rows) code))))
    (defn et-names (code) (do (let n (et-name-of (et-name-rows) code)) (if (str_eq code "pt") "Brazilian Portuguese" (if (eq (str_len n) 0) "English" n))))
    (defn et-known? (code) (gt (str_len (et-name-of (et-name-rows) code)) 0))
    (defn et-open () (dth-open (mr-path (mr-find "llama32-1b")) 256 (sub 0 1)))
    (defn et-prompt (text from to) (str_concat (et-names from) (str_concat ": " (str_concat text (str_concat (byte_to_str 10) (str_concat (et-names to) ": "))))))
    (defn et-cut1 (s stop) (do (let at (str_find s stop 0)) (if (lt at 0) s (substring s 0 at))))
    (defn et-cut (s) (trim (et-cut1 (et-cut1 s (byte_to_str 10)) "<|")))
    (defn et-text (t) (if (nothing? t) "" t))
    0)
; ---- the vocabulary rendered once to a file: line = "<piece>\t<id>\n" in id order, a leading line break ----
(do
    (defn et-vocab-path (src) (str_concat ".hearth/vocab-" (str_concat (int_to_str (gmt-vocab-n src)) ".txt")))
    (defn et-piece (src at L k acc) (if (ge k L) acc (et-piece src at L (add k 1) (str_concat acc (byte_to_str (gmt-token-byte src at k))))))
    (defn et-render (src at id n acc) (if (ge id n) acc (do (let L (gmt-token-len src at)) (et-render src (gmt-token-next src at) (add id 1) n (str_concat acc (str_concat (byte_to_str 10) (str_concat (et-piece src at L 0 "") (str_concat (byte_to_str 9) (int_to_str id)))))))))
    (defn et-render-chunks (src at id n acc) (if (ge id n) acc (do (let stop (if (gt (add id 4096) n) n (add id 4096))) (let chunk (et-render src at id stop "")) (let w (sbt-append (et-vocab-path src) chunk)) (et-render-chunks src (et-skip src at (sub stop id)) stop n (add acc 1)))))
    (defn et-skip (src at n) (if (eq n 0) at (et-skip src (gmt-token-next src at) (sub n 1))))
    (defn et-vocab (src) (do (let p (et-vocab-path src)) (if (gt (file_size p) 0) (et-text (read_file p)) (do (let n (et-render-chunks src (gmt-tokens-first src) 0 (gmt-vocab-n src) 0)) (let tail (sbt-append p (byte_to_str 10))) (et-text (read_file p))))))
    0)
; ---- the index: record buckets for the tokenizer, an id-indexed piece file for the detokenizer ----
; bucket <dir>/<key>: 28-byte records (len, 24 piece bytes, id as three little-endian bytes) in id order,
; keyed by the first four bytes of the piece (fewer when the piece is shorter); pieces past 24 bytes are
; not indexed — the longest match the lane offers is 24 bytes, stated. pieces file: every piece decoded
; through the byte alphabet, concatenated; pidx: per id, offset and length as two little-endian u32.
(do
    (defn et-rdir (src) (str_concat ".hearth/vocab-" (str_concat (int_to_str (gmt-vocab-n src)) "-r28")))
    (defn et-ppath (src) (str_concat ".hearth/vocab-" (str_concat (int_to_str (gmt-vocab-n src)) ".pieces")))
    (defn et-ipath (src) (str_concat ".hearth/vocab-" (str_concat (int_to_str (gmt-vocab-n src)) ".pidx")))
    (defn et-rpath (dir key) (str_concat dir (str_concat "/" (int_to_str key))))
    (defn et-rkey-go (s i end acc) (if (ge i end) acc (et-rkey-go s (add i 1) end (add (mul acc 256) (add 1 (str_byte_at s i))))))
    (defn et-rkey (s i k) (et-rkey-go s i (add i k) 0))
    (defn et-le32 (n) (str_concat (byte_to_str (mod n 256)) (str_concat (byte_to_str (mod (div n 256) 256)) (str_concat (byte_to_str (mod (div n 65536) 256)) (byte_to_str (div n 16777216))))))
    (defn et-le32-of (s o) (add (str_byte_at s o) (add (mul 256 (str_byte_at s (add o 1))) (add (mul 65536 (str_byte_at s (add o 2))) (mul 16777216 (str_byte_at s (add o 3)))))))
    (defn et-pad (n acc) (if (le n 0) acc (et-pad (sub n 1) (str_concat acc (byte_to_str 0)))))
    (defn et-record (piece id) (str_concat (byte_to_str (str_len piece)) (str_concat piece (str_concat (et-pad (sub 24 (str_len piece)) "") (str_concat (byte_to_str (mod id 256)) (str_concat (byte_to_str (mod (div id 256) 256)) (byte_to_str (div id 65536))))))))
    ; a stored piece to the bytes it means — l3d-piece-go's walk over a string instead of the file
    (defn et-cp2 (b0 b1) (if (or (lt b1 128) (ge b1 192)) (sub 0 1) (add (mul (sub b0 192) 64) (sub b1 128))))
    (defn et-decode (raw j n acc)
        (if (ge j n) acc
            (do (let b0 (str_byte_at raw j))
                (let w (l3d-width b0))
                (if (lt w 0) acc
                    (do (let c (if (eq w 1) b0 (if (ge (add j 1) n) (sub 0 1) (et-cp2 b0 (str_byte_at raw (add j 1))))))
                        (let b (if (lt c 0) (sub 0 1) (l3d-uni-byte c)))
                        (if (lt b 0) acc (et-decode raw (add j w) n (str_concat acc (byte_to_str b)))))))))
    ; one walk over the rendered vocabulary: each line lands its record and its decoded piece; the piece
    ; and index files are appended in chunks of 4096 ids, the offset carried across chunks
    (defn et-flush (ppath ipath pacc iacc) (do (let a (sbt-append ppath pacc)) (let b (sbt-append ipath iacc)) 1))
    (defn et-land (dir ppath ipath piece id pacc iacc off cnt)
        (do (let w (if (and (gt (str_len piece) 0) (le (str_len piece) 24)) (sbt-append (et-rpath dir (et-rkey piece 0 (if (gt (str_len piece) 4) 4 (str_len piece)))) (et-record piece id)) 0))
            (let d (et-decode piece 0 (str_len piece) ""))
            (let pacc1 (str_concat pacc d))
            (let iacc1 (str_concat iacc (str_concat (et-le32 off) (et-le32 (str_len d)))))
            (if (eq (mod (add cnt 1) 4096) 0)
                (do (let f (et-flush ppath ipath pacc1 iacc1)) (list "" "" (add off (str_len d)) (add cnt 1)))
                (list pacc1 iacc1 (add off (str_len d)) (add cnt 1)))))
    (defn et-bwalk (dir ppath ipath t i n piece id pacc iacc off cnt)
        (if (ge i n) (do (let f (et-flush ppath ipath pacc iacc)) cnt)
            (do (let b (str_byte_at t i))
                (if (eq b 10)
                    (if (lt id 0) (et-bwalk dir ppath ipath t (add i 1) n "" (sub 0 1) pacc iacc off cnt)
                        (do (let s (et-land dir ppath ipath piece id pacc iacc off cnt))
                            (et-bwalk dir ppath ipath t (add i 1) n "" (sub 0 1) (nth s 0) (nth s 1) (nth s 2) (nth s 3))))
                    (if (eq b 9) (et-bwalk dir ppath ipath t (add i 1) n piece 0 pacc iacc off cnt)
                        (if (ge id 0) (et-bwalk dir ppath ipath t (add i 1) n piece (add (mul id 10) (sub b 48)) pacc iacc off cnt)
                            (et-bwalk dir ppath ipath t (add i 1) n (str_concat piece (byte_to_str b)) id pacc iacc off cnt)))))))
    (defn et-index-ready? (src) (ge (file_size (str_concat (et-rdir src) "/ready")) 0))
    ; the index lives under .hearth, and `fs-mkdir` makes ONE directory: in a checkout where no
    ; hearth stands yet — a fresh clone, an agent's worktree — the bucket directory could not be
    ; made, every append fell on the floor, and the lane came up with an empty vocabulary. It did
    ; not say so: the tokenizer answered `(bos)`, every tongue answered "", and the band's equality
    ; bits agreed "" with "" and read 3904 of 4095 with five bits dark and five vacuously lit. So
    ; the hearth is made first, and a build that still did not land says so out loud.
    (defn et-build-index (src)
        (if (et-index-ready? src) 1
            (do (let dir (et-rdir src))
                (let hearth (fs-mkdir ".hearth"))
                (let gone (fs-remove-tree dir))
                (let g1 (fs-remove-file (et-ppath src)))
                (let g2 (fs-remove-file (et-ipath src)))
                (let mk (fs-mkdir dir))
                (let t (et-vocab src))
                (let n (et-bwalk dir (et-ppath src) (et-ipath src) t 0 (str_len t) "" (sub 0 1) "" "" 0 0))
                (let r (write_file_text (str_concat dir "/ready") (int_to_str n)))
                (if (et-index-ready? src) 1
                    (do (print_str (str_concat "ear-tongue: the vocabulary index did not land under " dir)) 0)))))
    ; ---- the tokenizer: at each position the longest indexed piece, the lowest id on a tie ----
    (defn et-req (t o text i L k) (if (ge k L) 1 (if (eq (str_byte_at t (add o k)) (str_byte_at text (add i k))) (et-req t o text i L (add k 1)) 0)))
    (defn et-rid (t o) (add (str_byte_at t o) (add (mul 256 (str_byte_at t (add o 1))) (mul 65536 (str_byte_at t (add o 2))))))
    (defn et-rwalk (t r nrec text i rem bestL bestId)
        (if (ge r nrec) (list bestId bestL)
            (do (let o (mul r 28))
                (let L (str_byte_at t o))
                (if (and (gt L bestL) (and (le L rem) (eq (et-req t (add o 1) text i L 0) 1)))
                    (et-rwalk t (add r 1) nrec text i rem L (et-rid t (add o 25)))
                    (et-rwalk t (add r 1) nrec text i rem bestL bestId)))))
    (defn et-rmatch (dir text i rem k)
        (if (le k 0) (list (sub 0 1) 0)
            (do (let t (et-text (read_file (et-rpath dir (et-rkey text i k)))))
                (let m (if (eq (str_len t) 0) (list (sub 0 1) 0) (et-rwalk t 0 (div (str_len t) 28) text i rem 0 (sub 0 1))))
                (if (lt (head m) 0) (et-rmatch dir text i rem (sub k 1)) m))))
    (defn et-rids (dir text i n acc)
        (if (ge i n) (reverse acc)
            (do (let m (et-rmatch dir text i (sub n i) (if (gt (sub n i) 4) 4 (sub n i))))
                (if (lt (head m) 0) (reverse acc) (et-rids dir text (add i (nth m 1)) n (cons (head m) acc))))))
    (defn et-encode (dir bos text) (do (let surface (dtk-gpt2-map text)) (cons bos (et-rids dir surface 0 (str_len surface) (list)))))
    ; ---- the detokenizer: id -> (offset length) -> the piece ----
    (defn et-piece-of (ppath ipath n id)
        (if (or (lt id 0) (ge id n)) ""
            (do (let e (et-text (read_file_slice ipath (mul id 8) 8)))
                (if (lt (str_len e) 8) ""
                    (do (let L (et-le32-of e 4))
                        (if (le L 0) "" (et-text (read_file_slice ppath (et-le32-of e 0) L))))))))
    (defn et-detok (ppath ipath n ids acc) (if (eq (len ids) 0) acc (et-detok ppath ipath n (tail ids) (str_concat acc (et-piece-of ppath ipath n (head ids))))))
    0)
; ---- the lane: (st bos eos loaded dir ppath ipath n) — loaded is what the KV cache holds, position by position ----
(do
    (defn et-lane-open ()
        (do (let st (et-open))
            (let src (nth st 10))
            (let built (et-build-index src))
            (list st (gmt-u32 src "tokenizer.ggml.bos_token_id") (gmt-u32 src "tokenizer.ggml.eos_token_id") (list) (et-rdir src) (et-ppath src) (et-ipath src) (gmt-vocab-n src))))
    (defn et-lane-st (lane) (nth lane 0))
    (defn et-lane-with-loaded (lane loaded) (list (nth lane 0) (nth lane 1) (nth lane 2) loaded (nth lane 4) (nth lane 5) (nth lane 6) (nth lane 7)))
    (defn et-common (a b n) (if (or (eq (len a) 0) (eq (len b) 0)) n (if (eq (head a) (head b)) (et-common (tail a) (tail b) (add n 1)) n)))
    (defn et-drop (xs n) (if (le n 0) xs (et-drop (tail xs) (sub n 1))))
    ; the prompt's tokens from position pos on: embed and the layers for each, the head only on the last
    (defn et-prefill-from (st ids pos)
        (if (eq (len ids) 1)
            (dth-forward (nth st 0) (nth st 1) (nth st 2) (nth st 3) (nth st 4) (nth st 5) (nth st 6) (nth st 7) (nth st 8) (head ids) pos)
            (do (dth-dq (nth st 0) (nth st 6) (nth (nth st 1) 0) (mul (head ids) (nth (nth st 2) 0)) (nth (nth st 2) 0))
                (dth-passes (nth st 0) (nth st 1) (nth st 2) (nth st 3) (nth st 4) (nth st 5) (nth st 7) pos 0 (nth (nth st 2) 16))
                (et-prefill-from st (tail ids) (add pos 1)))))
    ; the ends of a line: the file's end-of-sequence, llama3's end of turn, or the line break the prompt asked for
    (defn et-ends? (eos id) (or (eq id eos) (or (eq id 128009) (or (eq id 128001) (or (eq id 198) (eq id 271))))))
    (defn et-gen-go (st eos id pos n acc) (if (or (le n 0) (et-ends? eos id)) (reverse acc) (do (let nid (dth-forward (nth st 0) (nth st 1) (nth st 2) (nth st 3) (nth st 4) (nth st 5) (nth st 6) (nth st 7) (nth st 8) id pos)) (et-gen-go st eos nid (add pos 1) (sub n 1) (cons id acc)))))
    ; one line through the lane: (text lane). The cache holds 256 positions; a prompt that leaves no room answers ""
    (defn et-say (lane text from to maxnew)
        (do (let st (et-lane-st lane))
            (let ids (et-encode (nth lane 4) (nth lane 1) (et-prompt text from to)))
            (let room (sub 250 (len ids)))
            (if (le room 0) (list "" lane)
                (do (let m0 (et-common ids (nth lane 3) 0))
                    (let m (if (ge m0 (len ids)) (sub (len ids) 1) m0))
                    (let first (et-prefill-from st (et-drop ids m) m))
                    (let gen (et-gen-go st (nth lane 2) first (len ids) (if (gt maxnew room) room maxnew) (list)))
                    (list (et-cut (et-detok (nth lane 5) (nth lane 6) (nth lane 7) gen "")) (et-lane-with-loaded lane (append ids gen)))))))
    ; ---- the streaming step: a line said while it grows ----
    ; The prompt's ids, then the ids already committed for this tongue, prefilled only past what the
    ; cache holds (the source prefix and, for the first tongue of a round, nothing more); up to maxnew
    ; new ids generated after them. Answers (ids lane): the committed ids followed by the new ones, the
    ; end id excluded. A prompt that leaves no room answers an empty list.
    (defn et-say-ids (lane text from to forced maxnew)
        (do (let st (et-lane-st lane))
            (let ids (append (et-encode (nth lane 4) (nth lane 1) (et-prompt text from to)) forced))
            (let room (sub 250 (len ids)))
            (if (le room 0) (list (list) lane)
                (do (let m0 (et-common ids (nth lane 3) 0))
                    (let m (if (ge m0 (len ids)) (sub (len ids) 1) m0))
                    (let first (et-prefill-from st (et-drop ids m) m))
                    (let gen (et-gen-go st (nth lane 2) first (len ids) (if (gt maxnew room) room maxnew) (list)))
                    (list (append forced gen) (et-lane-with-loaded lane (append ids gen)))))))
    (defn et-take (xs n) (if (or (le n 0) (eq (len xs) 0)) (list) (cons (head xs) (et-take (tail xs) (sub n 1)))))
    ; local agreement: what two consecutive renderings of a growing source agree on is committed and
    ; forced on the next; both begin with what was committed before, so the commitment only grows.
    ; (committed prev) -> (ids agreed lane): ids is this rendering, agreed the prefix it shares with prev.
    (defn et-say-step (lane text from to committed prev maxnew)
        (do (let r (et-say-ids lane text from to committed maxnew))
            (list (head r) (et-take (head r) (et-common (head r) prev 0)) (nth r 1))))
    (defn et-ids-text (lane ids) (et-cut (et-detok (nth lane 5) (nth lane 6) (nth lane 7) ids "")))
    0)
; ---- the batched lane: the tongues as M sequences in one decode step (dense-multi), each its own KV bank ----
; A round feeds every sequence its prompt (only past what its bank holds) and then its own answers, in
; lock-step, until each has ended or generated maxnew; the round is resumable in chunks of k steps so a
; caller can show the renderings while they grow. Refused at open outside dense-multi's radius
; (et-mlane-ok? false) — the caller then offers the tongues one after another through et-say-step.
(do
    (defn et-nils (m) (if (le m 0) (list) (cons (list) (et-nils (sub m 1)))))
    ; (st bos eos loadeds dir ppath ipath n M): loadeds is what each bank holds, position by position
    (defn et-mlane-open (m)
        (do (let st (dm-open (mr-path (mr-find "llama32-1b")) 256 m))
            (let src (nth st 10))
            (let built (et-build-index src))
            (list st (gmt-u32 src "tokenizer.ggml.bos_token_id") (gmt-u32 src "tokenizer.ggml.eos_token_id") (et-nils m) (et-rdir src) (et-ppath src) (et-ipath src) (gmt-vocab-n src) m)))
    (defn et-mlane-ok? (ml) (dm-ok? (nth ml 0)))
    (defn et-mlane-with-loaded (ml loadeds) (list (nth ml 0) (nth ml 1) (nth ml 2) loadeds (nth ml 4) (nth ml 5) (nth ml 6) (nth ml 7) (nth ml 8)))
    ; a sequence in a round: (ids c rem gen ended last) — ids the prompt then the forced prefix, c the first
    ; position its bank does not hold, rem the ids it feeds from c on, gen what it generated (no end id),
    ; ended whether an end id came, last the id it feeds next. Empty ids, or more than the bank's room: it sits
    ; out (feeds bos at 0, its bank forgotten).
    (defn et-mseq (ids loaded bos)
        (if (or (eq (len ids) 0) (gt (len ids) 250)) (list (list) 0 0 (list) 1 bos)
            (do (let c0 (et-common ids loaded 0)) (let c (if (ge c0 (len ids)) (sub (len ids) 1) c0)) (list ids c (sub (len ids) c) (list) 0 bos))))
    (defn et-mseqs (idss loadeds bos) (if (eq (len idss) 0) (list) (cons (et-mseq (head idss) (head loadeds) bos) (et-mseqs (tail idss) (tail loadeds) bos))))
    (defn et-mfeed (seqs s) (if (eq (len seqs) 0) (list) (cons (do (let q (head seqs)) (if (lt s (nth q 2)) (nth (nth q 0) (add (nth q 1) s)) (nth q 5))) (et-mfeed (tail seqs) s))))
    (defn et-mposs (seqs s) (if (eq (len seqs) 0) (list) (cons (do (let q (head seqs)) (if (eq (len (nth q 0)) 0) 0 (add (nth q 1) s))) (et-mposs (tail seqs) s))))
    ; the answers of step s: from the step that fed a sequence's last prompt id on, its answer is generated
    (defn et-mtake (seqs outs s eos maxnew)
        (if (eq (len seqs) 0) (list)
            (cons (do (let q (head seqs)) (let o (head outs))
                      (if (and (ge s (sub (nth q 2) 1)) (and (eq (nth q 4) 0) (and (gt (len (nth q 0)) 0) (lt (len (nth q 3)) maxnew))))
                          (if (et-ends? eos o) (list (nth q 0) (nth q 1) (nth q 2) (nth q 3) 1 o) (list (nth q 0) (nth q 1) (nth q 2) (append (nth q 3) (list o)) 0 o))
                          (list (nth q 0) (nth q 1) (nth q 2) (nth q 3) (nth q 4) o)))
                  (et-mtake (tail seqs) (tail outs) s eos maxnew))))
    ; after s steps a sequence is done when its prompt is fed and it ended or has maxnew
    (defn et-mdone? (seqs s maxnew) (if (eq (len seqs) 0) 1 (do (let q (head seqs)) (if (and (ge s (nth q 2)) (or (eq (nth q 4) 1) (ge (len (nth q 3)) maxnew))) (et-mdone? (tail seqs) s maxnew) 0))))
    ; up to k more steps of a round: (seqs s done)
    (defn et-mround-go (ml seqs s k maxnew)
        (if (eq (et-mdone? seqs s maxnew) 1) (list seqs s 1)
            (if (le k 0) (list seqs s 0)
                (do (let outs (dm-step (nth ml 0) (et-mfeed seqs s) (et-mposs seqs s)))
                    (et-mround-go ml (et-mtake seqs outs s (nth ml 2) maxnew) (add s 1) (sub k 1) maxnew)))))
    (defn et-mround-open (ml idss) (et-mseqs idss (nth ml 3) (nth ml 1)))
    (defn et-mgens (seqs) (if (eq (len seqs) 0) (list) (cons (nth (head seqs) 3) (et-mgens (tail seqs)))))
    ; whether each sequence stopped at an end id rather than at the caller's cap. A tongue that
    ; ended has said the whole of its answer to this prompt: greedy decoding is one answer to one
    ; prompt, so the same prompt fed again answers the same ids and the same end. A caller that
    ; keeps this bit does not pay for a line the lane has already finished saying.
    ; A sequence that SAT OUT — no ids, or a prompt past the bank's room — carries the same born
    ; `ended` bit as one that reached an end id, and it must not be read as an answer: it says 0.
    (defn et-mends (seqs) (if (eq (len seqs) 0) (list) (cons (do (let q (head seqs)) (if (eq (len (nth q 0)) 0) 0 (nth q 4))) (et-mends (tail seqs)))))
    ; what each bank holds after S steps: the ids, then the generated ids that were fed (S - rem of them at
    ; most); a sequence that sat out keeps what it held (bos at position 0 is what every bank holds there)
    (defn et-mloaded (seqs S olds) (if (eq (len seqs) 0) (list) (cons (do (let q (head seqs)) (if (eq (len (nth q 0)) 0) (head olds) (append (nth q 0) (et-take (nth q 3) (sub S (nth q 2)))))) (et-mloaded (tail seqs) S (tail olds)))))
    (defn et-mround-close (ml seqs S) (et-mlane-with-loaded ml (et-mloaded seqs S (nth ml 3))))
    ; a whole round at once: (gens ml) — gens[m] the forced prefix is NOT included; the caller keeps it
    (defn et-mround (ml idss maxnew)
        (do (let r (et-mround-go ml (et-mround-open ml idss) 0 100000 maxnew))
            (list (et-mgens (head r)) (et-mround-close ml (head r) (nth r 1)))))
    0)
