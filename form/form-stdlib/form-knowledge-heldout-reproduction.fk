; form-knowledge-heldout-reproduction.fk — tell an ANCHOR from a COINCIDENCE,
; using a digest the evaluator already computes and nobody reads.
;
; WHY. On 2026-08-26 the ten sealed zero-family rows ran a third time, under a
; curriculum whose glosses had been corrected against their own cells. Two rows
; reproduced their f1 EXACTLY to the ppm across that change (v316 at 909,091;
; v323 at 285,714) while two near-misses scrambled. The reading offered was
; that an exactly-reproducing row is ANCHORED — routed through something the
; model holds beneath the gloss — and a scrambling row was a trajectory the
; prompt steered once. That reading is worth having and it is currently
; underdetermined, because equal f1 does not mean equal answer.
;
; F1 IS A SMALL RATIO. native-model-evidence.fk computes it as
; round(2,000,000 * overlap / (len want + len got)). 909,091 ppm is 10/11 and
; 285,714 ppm is 2/7 — both reachable by many different answers. Two runs that
; produced DIFFERENT text with the same overlap count and the same token count
; land on the identical ppm. From the totals alone, that is indistinguishable
; from the model saying the same thing twice.
;
; THE DECIDING FIELD ALREADY EXISTS. fkh3-observation stores
; `(nmfe-sha256 actual)` at index 3:
;
;   0 tag  1 prompt-sha  2 expected-sha  3 ACTUAL-SHA  4 exact  5 f1
;   6 sequence  7 semantic  8 promotion  9 latency  10 error
;
; Indices 1, 2 and 3 have no named accessor in that cell, so the digest of what
; the model actually said is computed on every row and never read. Naming it
; costs nothing and converts the anchored/fragile reading from an inference
; about coinciding ratios into a direct witness: same answer, or not.
;
; HELD-OUT SAFE. This cell reads a SHA and a ppm. It never touches, renders or
; returns answer text, so a reproduction check cannot become a way to read a
; sealed reply — the same discipline form-cli-heed-telemetry.fk holds.
;
; THE ACCESSORS BELONG IN THE EVALUATOR EVENTUALLY. They live here because that
; cell's lane is mid-audit; this is a companion, not a fork, and the index
; contract below is checked against the live constructor rather than trusted.
;
; preludes: form-stdlib/form-knowledge-qwen-heldout-v3-eval.fk
;
; Proven by: form-stdlib/tests/form-knowledge-heldout-reproduction-band.fk

(do
    ; ── the three unnamed fields ───────────────────────────────────────────
    (defn fkhr-prompt-sha (o)   (nth o 1))
    (defn fkhr-expected-sha (o) (nth o 2))
    (defn fkhr-actual-sha (o)   (nth o 3))

    ; ── the three ways two sittings of one row can relate ──────────────────
    ; anchored   the model said the SAME thing, so the score reproducing is a
    ;            consequence rather than a coincidence
    ; coincident the score reproduced and the answer did not — the case the
    ;            totals cannot see, and the reason this cell exists
    ; moved      the score changed; the answer changed too, necessarily
    (defn fkhr-anchored ()   "anchored")
    (defn fkhr-coincident () "coincident")
    (defn fkhr-moved ()      "moved")

    (defn fkhr-same-answer? (a b)
        (if (str_eq (fkhr-actual-sha a) (fkhr-actual-sha b)) 1 0))
    (defn fkhr-same-f1? (a b)
        (if (eq (fkh3-obs-f1 a) (fkh3-obs-f1 b)) 1 0))

    (defn fkhr-relation (a b)
        (if (eq (fkhr-same-answer? a b) 1) (fkhr-anchored)
            (if (eq (fkhr-same-f1? a b) 1) (fkhr-coincident)
                (fkhr-moved))))

    ; A row is evidence of an anchor only when the ANSWER reproduced. An equal
    ; score with an unequal answer is evidence of the opposite: the model
    ; reached the same number by a different route, which is what a steered
    ; trajectory looks like when the steering happens to land twice.
    (defn fkhr-anchor-evidence? (a b)
        (if (str_eq (fkhr-relation a b) (fkhr-anchored)) 1 0))

    ; ── the index contract, checked rather than trusted ────────────────────
    ; If the evaluator's observation ever grows or reorders a field, this
    ; returns 0 and every reading above is refused instead of silently reading
    ; a neighbour. The shape is asked of a live observation, not restated.
    (defn fkhr-contract-ok? (o actual)
        (if (eq (fkh3-obs? o) 0) 0
            (if (not (eq (len o) 11)) 0
                (if (str_eq (fkhr-actual-sha o) (nmfe-sha256 actual)) 1 0))))

    ; ── the SECOND witness already taken: reply length, encoded in the f1 ──
    ; f1 is round(2,000,000 * overlap / (expected + reply)). Two of those three
    ; numbers are known — the ppm is reported and the expected token count is
    ; sealed in the row — so the pair (overlap, reply-length) is constrained by
    ; arithmetic alone. Sometimes to exactly one possibility.
    ;
    ; That matters because a low f1 has two completely different causes that
    ; the number cannot tell apart on its own: the model said the wrong thing,
    ; or the model said the right thing at length. A row that overlaps 3 of 4
    ; expected tokens in a 3-token reply and the SAME 3 in a 33-token reply has
    ; not changed what it knows. It has changed how much it says, and only the
    ; second reading survives contact with the arithmetic.
    ;
    ; HELD-OUT SAFE: this derives COUNTS from a published score and a sealed
    ; count. No reply text is touched, and none could be recovered — many
    ; different replies share any (overlap, length) pair.
    ;
    ; AMBIGUITY IS REPORTED, NOT RESOLVED. Where several pairs fit, the list
    ; carries them all and fkhr-unique? is 0. A single guessed pair would be
    ; the same defect this whole cell exists to catch.
    (defn fkhr-f1-of (expected reply overlap)
        (nmfe-round-div (mul 2000000 overlap) (add expected reply)))

    (defn fkhr-scan-reply (expected ppm overlap reply cap acc)
        (if (gt reply cap) acc
            (fkhr-scan-reply expected ppm overlap (add reply 1) cap
                (if (eq (fkhr-f1-of expected reply overlap) ppm)
                    (append acc (list (list overlap reply))) acc))))
    (defn fkhr-scan-overlap (expected ppm overlap cap acc)
        (if (gt overlap expected) acc
            (fkhr-scan-overlap expected ppm (add overlap 1) cap
                (fkhr-scan-reply expected ppm overlap 0 cap acc))))

    ; A zero ppm constrains nothing but the overlap: no reply length follows
    ; from it, and saying otherwise would invent a reading.
    (defn fkhr-decompose (expected ppm cap)
        (if (le ppm 0) (list) (fkhr-scan-overlap expected ppm 1 cap (list))))

    (defn fkhr-unique? (sols) (if (eq (len sols) 1) 1 0))
    (defn fkhr-overlap-of (sols) (if (eq (len sols) 1) (nth (head sols) 0) -1))
    (defn fkhr-reply-of (sols)   (if (eq (len sols) 1) (nth (head sols) 1) -1))

    ; Two sittings of one row whose overlap is the same and whose reply length
    ; is not: the model kept what it knew and changed how much it said.
    (defn fkhr-verbosity-only? (sols-a sols-b)
        (if (or (eq (fkhr-unique? sols-a) 0) (eq (fkhr-unique? sols-b) 0)) 0
            (if (not (eq (fkhr-overlap-of sols-a) (fkhr-overlap-of sols-b))) 0
                (if (eq (fkhr-reply-of sols-a) (fkhr-reply-of sols-b)) 0 1))))

    0)
