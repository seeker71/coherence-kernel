// One pointer publishes adapter, configuration and Adam state together.
// A legacy directory is read only until its first native generation is published.
// preludes: form-stdlib/form-fs.fk form-stdlib/line-grammar.fk
section [form.bml] {
 class NativeAdapterGeneration {
  def nag-dir(path) = if fs-suffix?(path,".safetensors") then fs-path-dirname(path) else path;
  def nag-resolve(path) {
   let dir = nag-dir(path); let pointer = read_file(str_concat(dir,"/native-current"));
   if nothing?(pointer) then dir else nag-complete(trim(pointer));
  }
  def nag-complete(dir) = if and(gt(file_size(str_concat(dir,"/complete.json")),0),and(gt(file_size(str_concat(dir,"/adapters.safetensors")),0),and(gt(file_size(str_concat(dir,"/optimizer.safetensors")),0),gt(file_size(str_concat(dir,"/adapter_config.json")),0)))) then dir else form_error("native adapter generation is incomplete");
  def nag-write(path,text) {
   let wrote = write_file_text(path,text);
   if not(str_eq(read_file(path),text)) then form_error(str_concat("native generation write failed: ",path)) else 1;
  }
  def nag-publish(dir,generation) {
   let complete = nag-complete(generation);
   let candidate = str_concat(dir,str_concat("/native-current.candidate-",int_to_str(host_pid())));
   let written = nag-write(candidate,str_concat(generation,"\n"));
   if not(eq(fs-rename(candidate,str_concat(dir,"/native-current")),0)) then form_error("native generation pointer publication failed") else generation;
  }
 }
 0;
}
