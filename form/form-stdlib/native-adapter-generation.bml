// One pointer publishes adapter, configuration and Adam state together.
// A legacy directory is read only until its first native generation is published.
import form-stdlib/form-fs.fk;
import form-stdlib/line-grammar.fk;
section [form.bml] {
 class NativeAdapterGeneration {
  def nag-dir(path) = if fs-suffix?(path,".safetensors") then fs-path-dirname(path) else path;
  def nag-resolve(path) {
   let dir = nag-dir(path); let pointer = read_file((dir + "/native-current"));
   if nothing?(pointer) then dir else nag-complete(trim(pointer));
  }
  def nag-complete(dir) = if ((file_size((dir + "/complete.json")) > 0) && ((file_size((dir + "/adapters.safetensors")) > 0) && ((file_size((dir + "/optimizer.safetensors")) > 0) && (file_size((dir + "/adapter_config.json")) > 0)))) then dir else form_error("native adapter generation is incomplete");
  def nag-write(path,text) {
   let wrote = write_file_text(path,text);
   if (!((String) read_file(path) == text)) then form_error(("native generation write failed: " + path)) else 1;
  }
  def nag-publish(dir,generation) {
   let complete = nag-complete(generation);
   let candidate = (dir + ("/native-current.candidate-" + host_pid().str()));
   let written = nag-write(candidate,(generation + "\n"));
   if (!((Comparable) fs-rename(candidate,(dir + "/native-current")) == 0)) then form_error("native generation pointer publication failed") else generation;
  }
 }
 0;
}
