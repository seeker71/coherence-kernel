// One pointer publishes adapter, configuration and Adam state together.
// A legacy directory is read only until its first native generation is published.
// preludes: form-stdlib/form-fs.fk form-stdlib/line-grammar.fk
section [form.bml] {
 class NativeAdapterGeneration {
  def nag-dir(path) = fs-suffix?(path,".safetensors") ? fs-path-dirname(path) : path;
  def nag-resolve(path) {
   let dir = nag-dir(path); let pointer = read_file(dir ++ "/native-current");
   nothing?(pointer) ? dir : nag-complete(trim(pointer));
  }
  def nag-complete(dir) = (file_size(dir ++ "/complete.json") > 0) && ((file_size(dir ++ "/adapters.safetensors") > 0) && ((file_size(dir ++ "/optimizer.safetensors") > 0) && (file_size(dir ++ "/adapter_config.json") > 0))) ? dir : form_error("native adapter generation is incomplete");
  def nag-write(path,text) {
   let wrote = write_file_text(path,text);
   !((String) read_file(path) == text) ? form_error("native generation write failed: " ++ path) : 1;
  }
  def nag-publish(dir,generation) {
   let complete = nag-complete(generation);
   let candidate = dir ++ "/native-current.candidate-" ++ int_to_str(host_pid());
   let written = nag-write(candidate,generation ++ "\n");
   !((Comparable) fs-rename(candidate,dir ++ "/native-current") == 0) ? form_error("native generation pointer publication failed") : generation;
  }
 }
 0;
}
