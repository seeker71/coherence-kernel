    def raar-receipt-from-envelope(envelope) = (Comparable) raar-envelope-request-ready?(envelope) == 1 ? raar-envelope-receipt(envelope, raar-status-pending-observation(), raar-reason-pending-observation()) : raar-terminal-envelope-receipt(envelope);
    def raar-receipt-from-envelope-age(envelope, age, deadline) = (Comparable) raar-envelope-request-ready?(envelope) == 1 ? age > deadline ? raar-envelope-receipt(envelope, raar-status-investigate(), raar-reason-pending-observation-stalled()) : raar-envelope-receipt(envelope, raar-status-pending-observation(), raar-reason-pending-observation()) : raar-terminal-envelope-receipt(envelope);
