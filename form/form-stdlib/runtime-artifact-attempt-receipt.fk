    def raar-supplied-attempt(action, route, artifact-kind, artifact-path, source-hash, content-hash, status, detail, code) = list("runtime-artifact-supplied-attempt", action, route, artifact-kind, artifact-path, source-hash, content-hash, status, detail, code);
