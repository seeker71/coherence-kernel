    //            severity reason detail code)
    def raar-receipt(envelope, attempt, derived-observation, action, route, artifact-kind, artifact-path, source-hash, content-hash, attempt-status, status, severity, reason, detail, code) = list("runtime-artifact-attempt-receipt", envelope, attempt, derived-observation, action, route, artifact-kind, artifact-path, source-hash, content-hash, attempt-status, status, severity, reason, detail, code);
    def raar-receipt?(r) = (Comparable) len(r) == 16 ? (String) nth(r, 0) == "runtime-artifact-attempt-receipt" : 0;
    def raar-receipt-envelope(r) = nth(r, 1);
    def raar-receipt-attempt(r) = nth(r, 2);
    def raar-receipt-derived-observation(r) = nth(r, 3);
    def raar-receipt-action(r) = nth(r, 4);
    def raar-receipt-route(r) = nth(r, 5);
    def raar-receipt-artifact-kind(r) = nth(r, 6);
    def raar-receipt-artifact-path(r) = nth(r, 7);
    def raar-receipt-source-hash(r) = nth(r, 8);
    def raar-receipt-content-hash(r) = nth(r, 9);
    def raar-receipt-attempt-status(r) = nth(r, 10);
    def raar-receipt-status(r) = nth(r, 11);
    def raar-receipt-severity(r) = nth(r, 12);
    def raar-receipt-reason(r) = nth(r, 13);
    def raar-receipt-detail(r) = nth(r, 14);
    def raar-receipt-code(r) = nth(r, 15);
    def raar-receipt-selection(r) = rale-envelope-selection(raar-receipt-envelope(r));
    def raar-empty-receipt(envelope, attempt, status, reason) = raar-receipt(envelope, attempt, raar-no-derived-observation(), rap-act-none(), sad-route-invalid(), rale-kind-none(), "", "", "", rao-obs-none(), status, raar-severity-none(), reason, rao-detail-none(), rao-code-none());
    def raar-envelope-receipt(envelope, status, reason) = raar-receipt(envelope, raar-no-attempt(), raar-no-derived-observation(), rale-envelope?(envelope) ? rale-envelope-action(envelope) : rap-act-none(), rale-envelope?(envelope) ? rale-envelope-route(envelope) : sad-route-invalid(), rale-envelope?(envelope) ? rale-envelope-artifact-kind(envelope) : rale-kind-none(), rale-envelope?(envelope) ? rale-envelope-artifact-path(envelope) : "", rale-envelope?(envelope) ? rale-envelope-source-hash(envelope) : "", rale-envelope?(envelope) ? rale-envelope-content-hash(envelope) : "", rao-obs-none(), status, raar-severity-none(), reason, rao-detail-none(), rao-code-none());
    def raar-mismatch-receipt(envelope, attempt, reason) = raar-receipt(envelope, attempt, raar-no-derived-observation(), rale-envelope-action(envelope), rale-envelope-route(envelope), rale-envelope-artifact-kind(envelope), rale-envelope-artifact-path(envelope), rale-envelope-source-hash(envelope), rale-envelope-content-hash(envelope), raar-supplied-attempt?(attempt) ? raar-attempt-status(attempt) : rao-obs-none(), raar-status-investigate(), raar-severity-none(), reason, raar-supplied-attempt?(attempt) ? raar-attempt-detail(attempt) : rao-detail-none(), raar-supplied-attempt?(attempt) ? raar-attempt-code(attempt) : rao-code-none());
    def raar-envelope-request-ready?(envelope) = rale-envelope?(envelope) ? (String) rale-envelope-status(envelope) == rale-status-request-ready() : 0;
    def raar-terminal-envelope-receipt(envelope) = rale-envelope?(envelope) ? (String) rale-envelope-status(envelope) == rale-status-investigate() ? raar-envelope-receipt(envelope, raar-status-investigate(), raar-reason-envelope-investigates()) : (String) rale-envelope-status(envelope) == rale-status-refused() ? raar-envelope-receipt(envelope, raar-status-refused(), raar-reason-envelope-refused()) : raar-envelope-receipt(envelope, raar-status-investigate(), raar-reason-non-ready-envelope()) : raar-empty-receipt(envelope, raar-no-attempt(), raar-status-refused(), raar-reason-malformed-envelope());
    def raar-observed-severity(status) = (String) status == rao-obs-ok() ? raar-severity-ok() : (Comparable) rao-hard-status?(status) == 1 ? raar-severity-hard() : (Comparable) rao-soft-status?(status) == 1 ? raar-severity-soft() : raar-severity-unknown();
    def raar-observed-reason(status) = (String) status == rao-obs-ok() ? raar-reason-observed-ok() : (Comparable) rao-hard-status?(status) == 1 ? raar-reason-observed-hard-investigates() : (Comparable) rao-soft-status?(status) == 1 ? raar-reason-observed-soft() : raar-reason-observed-unknown-investigates();
