// runtime-artifact-attempt-receipt.fk -- Layer 9f envelope-bound attempt receipt.
//
// This layer binds a supplied host/runner attempt observation to a Layer 9e
// request-ready envelope. It is not the loader/executor. It does not produce
// the observation by reading, loading, walking, calling, or executing an
// artifact; it only refuses or investigates observations that are not bound to
// the envelope identity, and derives the plain Layer 9c `rao-run-observation`
// row once that binding is explicit.
//
// The trust tuple is exactly the 9e envelope's emitted identity fields:
// action, route, artifact kind, artifact path, source hash, and content hash.
// A mismatch is a loud investigate receipt with no derived observation. Hard
// attempt statuses such as OOM, killed, stalled, timeout, and wrong-value remain
// observed and are forwarded to 9c, where they normalize to investigation.
//
// preludes: form-stdlib/core.fk form-stdlib/source-artifact-cache.fk form-stdlib/source-artifact-descriptor.fk form-stdlib/runtime-artifact-plan.fk form-stdlib/runtime-artifact-selector.fk form-stdlib/runtime-artifact-outcome.fk form-stdlib/runtime-artifact-retry.fk form-stdlib/runtime-artifact-load-envelope.fk
section [form.bml] {
    def raar-feature(name, status) = list("runtime-artifact-attempt-receipt-feature", name, status);
    def raar-feature-name(f) = nth(f, 1);
    def raar-feature-status(f) = nth(f, 2);
    def runtime-artifact-attempt-receipt-manifest() = list(raar-feature("attempt-receipt-not-execution", 1), raar-feature("supplied-host-attempt-only", 1), raar-feature("binds-to-rale-envelope", 1), raar-feature("identity-tuple-field-match", 1), raar-feature("derived-rao-observation-only-after-match", 1), raar-feature("mismatch-investigates-without-derived-observation", 1), raar-feature("pending-can-age-to-investigate", 1), raar-feature("hard-statuses-preserved-for-9c", 1), raar-feature("no-outcome-algebra-or-retry-policy", 1), raar-feature("no-disk-io", 1), raar-feature("no-byte-hashing", 1), raar-feature("no-seal-proof-callable-reverify", 1), raar-feature("no-fkb-walk-or-dylib-call", 1), raar-feature("no-native-or-source-execution", 1), raar-feature("no-admission-policy-or-selector-install", 1), raar-feature("no-c-seed-growth", 1));
    def runtime-artifact-attempt-receipt-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) raar-feature-name(head(fs)) == name && (Comparable) raar-feature-status(head(fs)) == 1 ? 1 : runtime-artifact-attempt-receipt-manifest-has?(name, tail(fs));
    def raar-status-observed() = "observed";
    def raar-status-pending-observation() = "pending-observation";
    def raar-status-investigate() = "investigate";
    def raar-status-refused() = "refused";
    def raar-severity-ok() = "ok";
    def raar-severity-soft() = "soft";
    def raar-severity-hard() = "hard";
    def raar-severity-unknown() = "unknown";
    def raar-severity-none() = "none";
    def raar-reason-observed-ok() = "observed-ok";
    def raar-reason-observed-soft() = "observed-soft";
    def raar-reason-observed-hard-investigates() = "observed-hard-investigates";
    def raar-reason-observed-unknown-investigates() = "observed-unknown-investigates";
    def raar-reason-pending-observation() = "pending-observation";
    def raar-reason-pending-observation-stalled() = "pending-observation-stalled";
    def raar-reason-envelope-investigates() = "envelope-investigates";
    def raar-reason-envelope-refused() = "envelope-refused";
    def raar-reason-non-ready-envelope() = "non-ready-envelope";
    def raar-reason-malformed-envelope() = "malformed-envelope";
    def raar-reason-malformed-attempt() = "malformed-attempt";
    def raar-reason-action-mismatch() = "action-mismatch";
    def raar-reason-route-mismatch() = "route-mismatch";
    def raar-reason-kind-mismatch() = "artifact-kind-mismatch";
    def raar-reason-path-mismatch() = "artifact-path-mismatch";
    def raar-reason-source-hash-mismatch() = "source-hash-mismatch";
    def raar-reason-content-hash-mismatch() = "content-hash-mismatch";
    def raar-no-attempt() = list("runtime-artifact-attempt-receipt-no-attempt");
    def raar-no-attempt?(a) = (Comparable) len(a) == 1 ? (String) nth(a, 0) == "runtime-artifact-attempt-receipt-no-attempt" : 0;
    def raar-no-derived-observation() = list("runtime-artifact-attempt-receipt-no-derived-observation");
    def raar-no-derived-observation?(o) = (Comparable) len(o) == 1 ? (String) nth(o, 0) == "runtime-artifact-attempt-receipt-no-derived-observation" : 0;
    // attempt = ("runtime-artifact-supplied-attempt" action route artifact-kind
