// observed-auto-learning.fk -- live observation changes the learning controller.
//
// This is the bridge between the somatic coherence loop, form-cli routing,
// posterior sufficiency, and champion/challenger recipe testing. Static AutoML
// searches for the best arm. Observed auto-learning runs a reversible experiment:
// ground first, honor choice/cut/fail/undo/timeout, then promote only on witnessed
// A/B evidence.
//
// preludes: form-stdlib/somatic-coherence-loop.fk form-stdlib/form-cli-router.fk form-stdlib/form-cli-sufficiency.fk
//
// A/B lineage: form/form-stdlib/champion-challenger.fk. This direct-source cell consumes
// the live A/B window already lowered to integer counts so it stays inside the
// bounded source-runner surface.
section [form.bml] {
    def oal-on?(x) = (Comparable) x == 1 ? 1 : 0;
    // control flags are the live offer/ack carrier lowered to a source-runner row.
    def oal-controls(choice-open, fail, cut, undo, timeout) = list(choice-open, fail, cut, undo, timeout);
    def oal-choice-open(c) = nth(c, 0);
    def oal-fail(c) = nth(c, 1);
    def oal-cut(c) = nth(c, 2);
    def oal-undo(c) = nth(c, 3);
    def oal-timeout(c) = nth(c, 4);
    def oal-control-action(controls) = (Comparable) oal-on?(oal-fail(controls)) == 1 ? "fail-stop" : (Comparable) oal-on?(oal-undo(controls)) == 1 ? "undo-last-change" : (Comparable) oal-on?(oal-cut(controls)) == 1 ? "cut-branch" : (Comparable) oal-on?(oal-timeout(controls)) == 1 ? "timeout-as-nothing" : (Comparable) oal-on?(oal-choice-open(controls)) == 0 ? "hold-choice" : "continue";
    def oal-any-live-control?(controls, ab-enabled) = oal-on?(oal-choice-open(controls)) + oal-on?(oal-fail(controls)) + oal-on?(oal-cut(controls)) + oal-on?(oal-undo(controls)) + oal-on?(oal-timeout(controls)) + oal-on?(ab-enabled) > 0 ? 1 : 0;
    def oal-mode(live-observation, controls, ab-enabled) = (Comparable) oal-on?(live-observation) == 0 ? "batch-search" : (Comparable) oal-any-live-control?(controls, ab-enabled) == 1 ? "online-reversible-ab" : "online-observed";
    def oal-route-action(route, suff-verdict) = (Comparable) suff-verdict == 1 ? "retry-local" : (Comparable) suff-verdict == 2 ? "ask-oracle" : (String) route == "agent-cli" ? "ask-oracle" : "run-local";
    // A higher score points attention toward a challenger; it is not enough to
    // replace the living answer.  `equivalent` is the lowered, witnessed
    // result-preservation bit from the A/B comparison.  Only present `1`
    // carries that witness: nothing, 0, and every other value leave the
    // champion intact.
    def oal-equivalent?(equivalent) = oal-on?(equivalent);
    def oal-ab-authority(champ-score, chall-score, samples, min-samples, margin, equivalent) = (Comparable) oal-equivalent?(equivalent) == 1 && (samples >= min-samples && chall-score + margin >= champ-score) ? "challenger" : "champion";
    // Keep the evidence at the execution door too.  A caller may never turn a
    // remembered string into authority after the comparison witness is gone.
    def oal-promote?(ab-authority, equivalent) = (String) ab-authority == "challenger" && (Comparable) oal-equivalent?(equivalent) == 1 ? 1 : 0;
    def oal-next(grounded, attuned, consent, small-move, integrated, witnessed, controls, route, suff-verdict, ab-authority, equivalent) = {
        let soma = scl-next(grounded, attuned, consent, small-move, integrated, witnessed);
        (String) soma == "complete" ? {
            let control = oal-control-action(controls);
            (String) control == "continue" ? (Comparable) oal-promote?(ab-authority, equivalent) == 1 ? "ab-promote-challenger" : oal-route-action(route, suff-verdict) : control;
        } : soma;
    };
    def oal-receipt(live-observation, grounded, attuned, consent, small-move, integrated, witnessed, controls, route, suff-verdict, ab-authority, equivalent, ab-enabled) = list("observed-auto-learning", oal-mode(live-observation, controls, ab-enabled), scl-next(grounded, attuned, consent, small-move, integrated, witnessed), oal-control-action(controls), route, suff-verdict, ab-authority, oal-equivalent?(equivalent), oal-next(grounded, attuned, consent, small-move, integrated, witnessed, controls, route, suff-verdict, ab-authority, equivalent));
    def oal-rec-kind(r) = nth(r, 0);
    def oal-rec-mode(r) = nth(r, 1);
    def oal-rec-soma(r) = nth(r, 2);
    def oal-rec-control(r) = nth(r, 3);
    def oal-rec-route(r) = nth(r, 4);
    def oal-rec-suff(r) = nth(r, 5);
    def oal-rec-ab(r) = nth(r, 6);
    def oal-rec-equivalent(r) = nth(r, 7);
    def oal-rec-next(r) = nth(r, 8);
    0;
}
