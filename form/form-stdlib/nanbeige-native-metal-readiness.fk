; nanbeige-native-metal-readiness.fk — staged, Form-owned admission for the
; released Nanbeige GGUF on the direct Metal lane.
;
; A shell witness cannot become native by being called from Form. Each stage
; names an operation that must be callable through the native walker. Observed
; tensor/Metal facts are retained, while missing graph operations remain doors.
;
; preludes: form-stdlib/core.fk
; witnessed: 2026-07-26 -> 201-tensor header; Q4_K/Q6_K/F32 coverage; one
; resident 2,574,807,936-byte buffer; head/tail dequant; fused Q4_K/Q6_K
; matvec; 22 layer dispatch; 44 loop-local KV slots. Full graph/token pending.

(do
    ; stage = (name observed native-port parity)
    (defn nbnm-stage (name observed native-port parity)
        (list "nanbeige-native-metal-stage" name observed native-port parity))
    (defn nbnm-name (s) (nth s 1))
    (defn nbnm-observed? (s) (nth s 2))
    (defn nbnm-native-port? (s) (nth s 3))
    (defn nbnm-parity? (s) (nth s 4))
    (defn nbnm-ready? (s)
        (if (and (eq (nbnm-observed? s) 1)
                 (and (eq (nbnm-native-port? s) 1)
                      (eq (nbnm-parity? s) 1))) 1 0))

    (defn nbnm-stages ()
        (list
            (nbnm-stage "gguf-header-201" 1 1 1)
            (nbnm-stage "q4k-q6k-f32-layout" 1 1 1)
            (nbnm-stage "whole-artifact-residency" 1 0 1)
            (nbnm-stage "q4k-q6k-dequant-head-tail" 1 0 1)
            (nbnm-stage "q4k-q6k-fused-matvec" 1 0 1)
            (nbnm-stage "stored-layer-dispatch-22" 1 0 1)
            (nbnm-stage "loop-local-kv-slots-44" 1 0 1)
            (nbnm-stage "wide-query-48x128" 0 0 0)
            (nbnm-stage "factor-free-rope" 0 0 0)
            (nbnm-stage "between-loop-final-norm" 0 0 0)
            (nbnm-stage "untied-output-head" 0 0 0)
            (nbnm-stage "two-loop-forward" 0 0 0)
            (nbnm-stage "token-parity-pinned-reference" 0 0 0)))

    (defn nbnm-count-observed (xs)
        (if (eq (len xs) 0) 0
            (add (nbnm-observed? (head xs))
                 (nbnm-count-observed (tail xs)))))
    (defn nbnm-count-native (xs)
        (if (eq (len xs) 0) 0
            (add (nbnm-native-port? (head xs))
                 (nbnm-count-native (tail xs)))))
    (defn nbnm-count-ready (xs)
        (if (eq (len xs) 0) 0
            (add (nbnm-ready? (head xs))
                 (nbnm-count-ready (tail xs)))))

    (defn nbnm-receipt ()
        (do
            (let stages (nbnm-stages))
            (list "nanbeige-native-metal-readiness"
                (len stages)
                (nbnm-count-observed stages)
                (nbnm-count-native stages)
                (nbnm-count-ready stages)
                "pending:native-quantized-metal-execution-port")))

    (defn nbnm-generation-ready? ()
        (if (eq (nbnm-count-ready (nbnm-stages)) (len (nbnm-stages))) 1 0))

    (defn nbnm-render ()
        (do
            (let r (nbnm-receipt))
            (str_concat "stage_count="
            (str_concat (int_to_str (nth r 1))
            (str_concat "\nobserved_stages="
            (str_concat (int_to_str (nth r 2))
            (str_concat "\nnative_port_stages="
            (str_concat (int_to_str (nth r 3))
            (str_concat "\nready_stages="
            (str_concat (int_to_str (nth r 4))
            (str_concat "\ngeneration_ready="
            (str_concat (int_to_str (nbnm-generation-ready?))
            (str_concat "\nstatus="
            (str_concat (nth r 5) "\n"))))))))))))))

    0)
