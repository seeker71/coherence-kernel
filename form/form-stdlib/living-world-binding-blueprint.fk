; living-world-binding-blueprint.fk -- consented slots unfold possible bindings.
;
; A blueprint is an ordered sequence of participant-named slots.  Each slot
; carries an arbitrary source cell and a finite field of numeric views.  The
; organ owns no slot names, arity, values, domain, task, answer, ordering rule,
; or preferred combination.  It unfolds the exact cartesian product described
; by the blueprint, with every numeric view isolated in a scoped projection so
; a new question cannot add attribution to an older globally interned scalar.
;
; Expansion is construction, not authority.  The blueprint, each derived
; projection, binding, source, and eventual enquiry space must still arrive
; through the caller's ordinary offer/ack membranes.  Empty value fields yield
; no bindings; zero, one, and many expansions remain distinct.  Recursion is
; over the exact finite fields supplied by participants and imposes no fixed
; slot count or value limit.
;
; preludes: form-stdlib/core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk

(let LWBB-SLOT      (bp "LWBB-SLOT"))
(let LWBB-SLOTS     (bp "LWBB-SLOTS"))
(let LWBB-BLUEPRINT (bp "LWBB-BLUEPRINT"))

; children: participant name, arbitrary source, finite numeric-view field,
; evidence, local path
(defn lwbb-slot (name source values evidence)
    (intern_node LWBB-SLOT
        (list (intern_trivial_string name) source values evidence
              (lwo-local-path))))
(defn lwbb-slot? (cell) (lwo-category? cell LWBB-SLOT))
(defn lwbb-slot-name-cell (slot) (nth (node_children slot) 0))
(defn lwbb-slot-name (slot) (node_value (lwbb-slot-name-cell slot)))
(defn lwbb-slot-source (slot) (nth (node_children slot) 1))
(defn lwbb-slot-values (slot) (nth (node_children slot) 2))
(defn lwbb-slot-evidence (slot) (nth (node_children slot) 3))
(defn lwbb-slot-path (slot) (nth (node_children slot) 4))

(defn lwbb-slots (items) (intern_node LWBB-SLOTS items))
(defn lwbb-slots? (cell) (lwo-category? cell LWBB-SLOTS))
(defn lwbb-slot-items (slots) (node_children slots))

(defn lwbb-numeric-view? (cell)
    (if (and (eq (node_level cell) 1)
             (eq (node_type cell) 1)) 1 0))
(defn lwbb-values-valid-items? (items)
    (if (eq (len items) 0) 1
        (if (eq (lwbb-numeric-view? (head items)) 0) 0
            (lwbb-values-valid-items? (tail items)))))
(defn lwbb-slot-valid? (slot)
    (if (eq (lwbb-slot? slot) 0) 0
        (if (eq (lwre-binding-name-safe? (lwbb-slot-name slot)) 0) 0
            (if (node_eq (lwbb-slot-source slot) (lwo-none)) 0
                (if (eq (lwo-category?
                            (lwbb-slot-values slot) LWO-FIELD) 0) 0
                    (lwbb-values-valid-items?
                        (lwo-field-items (lwbb-slot-values slot))))))))

(defn lwbb-slot-name-present? (name items)
    (if (eq (len items) 0) 0
        (if (str_eq name (lwbb-slot-name (head items))) 1
            (lwbb-slot-name-present? name (tail items)))))
(defn lwbb-slots-valid-items? (remaining seen)
    (if (eq (len remaining) 0) 1
        (do
            (let slot (head remaining))
            (if (and (eq (lwbb-slot-valid? slot) 1)
                     (eq (lwbb-slot-name-present?
                            (lwbb-slot-name slot) seen) 0))
                (lwbb-slots-valid-items? (tail remaining)
                    (cons slot seen)) 0))))

; children: ordered slots, optional alternatives, optional unknown, evidence,
; local path
(defn lwbb-blueprint (slots alternatives unknown evidence)
    (intern_node LWBB-BLUEPRINT
        (list slots alternatives unknown evidence (lwo-local-path))))
(defn lwbb-blueprint? (cell) (lwo-category? cell LWBB-BLUEPRINT))
(defn lwbb-blueprint-slots (blueprint) (nth (node_children blueprint) 0))
(defn lwbb-blueprint-alternatives (blueprint)
    (nth (node_children blueprint) 1))
(defn lwbb-blueprint-unknown (blueprint) (nth (node_children blueprint) 2))
(defn lwbb-blueprint-evidence (blueprint) (nth (node_children blueprint) 3))
(defn lwbb-blueprint-path (blueprint) (nth (node_children blueprint) 4))

(defn lwbb-unknown-valid? (unknown)
    (if (or (node_eq unknown (lwo-none))
            (eq (lwlc-unknown? unknown) 1)) 1 0))
(defn lwbb-blueprint-valid? (blueprint)
    (if (eq (lwbb-blueprint? blueprint) 0) 0
        (do
            (let slots (lwbb-blueprint-slots blueprint))
            (if (eq (lwbb-slots? slots) 0) 0
                (if (eq (len (lwbb-slot-items slots)) 0) 0
                    (if (eq (lwo-category?
                                (lwbb-blueprint-alternatives blueprint)
                                LWO-FIELD) 0) 0
                        (if (eq (lwbb-unknown-valid?
                                    (lwbb-blueprint-unknown blueprint)) 0) 0
                            (lwbb-slots-valid-items?
                                (lwbb-slot-items slots) (empty)))))))))

(defn lwbb-binding-for (blueprint slot value)
    (lwre-projected-binding (lwbb-slot-name slot)
        (lwre-projection blueprint (lwbb-slot-source slot) value
            (lwbb-blueprint-alternatives blueprint)
            (lwbb-blueprint-unknown blueprint)
            (lwbb-slot-evidence slot))
        (lwbb-blueprint-evidence blueprint)))

; Prefixes are reverse ordered raw binding lists until the final cell boundary.
(defn lwbb-expand-prefix-values
    (blueprint slot prefix values expanded)
    (if (eq (len values) 0) expanded
        (lwbb-expand-prefix-values blueprint slot prefix (tail values)
            (cons (cons (lwbb-binding-for blueprint slot (head values))
                        prefix)
                  expanded))))

(defn lwbb-expand-prefixes
    (blueprint slot prefixes expanded)
    (if (eq (len prefixes) 0) expanded
        (lwbb-expand-prefixes blueprint slot (tail prefixes)
            (lwbb-expand-prefix-values blueprint slot (head prefixes)
                (lwo-field-items (lwbb-slot-values slot)) expanded))))

(defn lwbb-expand-slots (blueprint slots prefixes)
    (if (eq (len slots) 0) prefixes
        (lwbb-expand-slots blueprint (tail slots)
            (lwbb-expand-prefixes blueprint (head slots) prefixes (empty)))))

(defn lwbb-prefixes-to-field (prefixes field)
    (if (eq (len prefixes) 0) field
        (lwbb-prefixes-to-field (tail prefixes)
            (lwo-field-add field
                (lwre-bindings (reverse (head prefixes)))))))

(defn lwbb-expand (blueprint)
    (if (eq (lwbb-blueprint-valid? blueprint) 0) (lwo-empty-field)
        (lwbb-prefixes-to-field
            (lwbb-expand-slots blueprint
                (lwbb-slot-items (lwbb-blueprint-slots blueprint))
                (list (empty)))
            (lwo-empty-field))))

