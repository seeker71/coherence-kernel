//////////////////////////////////////////////////////////////////////
// voice-phoneme.bml — the front of the mouth, natively: a voice's own
// configuration read from its `.onnx.json`, and the phoneme→id lane that
// turns what a phonemizer heard into the int64 row the model eats.
//
// This is the half of the crossing that could come home today. `voice-say.bml`
// hands a whole line to piper and gets a wav back; inside that tool the line
// travels four steps — letters to phonemes, phonemes to ids, ids through the
// VITS graph, spectrogram to samples. The second step is arithmetic over a table
// the voice ships beside itself, and the body can do it exactly. The first still
// crosses (espeak-ng is a rule engine and a dictionary per tongue, and three of
// this body's tongues use their own g2p besides). The third and fourth wait on
// the pass.
//
// The convention is piper's own, read from its source rather than guessed
// (`piper/phoneme_ids.py`, phonemes_to_ids): the row opens with BOS then PAD,
// each phoneme is followed by a PAD, and EOS closes it. A phoneme the voice has
// no id for is DROPPED — piper warns and continues — so the body drops it too and
// counts the drops, because a silent skip is how a mouth loses a sound without
// anyone noticing.
//
// A voice's `phoneme_id_map` maps a phoneme to a LIST of ids, not one id: the
// diphthong rows exist for voices that carry them. Reading it as a scalar would
// work on almost every voice and be wrong on the ones that matter.
// preludes: form/form-stdlib/json.fk form/form-stdlib/line-grammar.fk
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormVoicePhoneme {
        field VPRoot = "/Users/ursmuff/.local/share/piper-voices";
        field VPBos = "^";
        field VPEos = "$";
        field VPPad = "_";

        def vp-cat(xs) = (Comparable) len(xs) == 0 ? "" : head(xs) ++ vp-cat(tail(xs));
        def vp-cfg-path(voice) = vp-cat(list(VPRoot(), "/", voice, ".onnx.json"));
        def vp-model-path(voice) = vp-cat(list(VPRoot(), "/", voice, ".onnx"));
        def vp-cfg(voice) = parse-json(vp-cfg-path(voice), read_file(vp-cfg-path(voice)));

        // ---- what the voice says about itself ----
        def vp-sub(cfg, k) = json-object-get(cfg, k);
        def vp-int-at(cfg, k, dflt) = json-object-has?(cfg, k) ? json-int-value(json-object-get(cfg, k)) : dflt;
        def vp-str-at(cfg, k, dflt) = json-object-has?(cfg, k) ? json-string-value(json-object-get(cfg, k)) : dflt;
        def vp-sample-rate(cfg) = json-object-has?(cfg, "audio") ? vp-int-at(vp-sub(cfg, "audio"), "sample_rate", 0) : 0;
        def vp-num-speakers(cfg) = vp-int-at(cfg, "num_speakers", 1);
        def vp-num-symbols(cfg) = vp-int-at(cfg, "num_symbols", 0);
        // an absent phoneme_type is espeak — piper's own default, not a guess
        def vp-phoneme-type(cfg) = vp-str-at(cfg, "phoneme_type", "espeak");
        def vp-espeak-voice(cfg) = json-object-has?(cfg, "espeak") ? vp-str-at(vp-sub(cfg, "espeak"), "voice", "") : "";
        def vp-language(cfg) = json-object-has?(cfg, "language") ? vp-str-at(vp-sub(cfg, "language"), "code", "") : "";
        def vp-noise-scale(cfg) = json-object-has?(cfg, "inference") ? vp-str-at(vp-sub(cfg, "inference"), "noise_scale", "") : "";

        // ---- the id table ----
        def vp-map(cfg) = vp-sub(cfg, "phoneme_id_map");
        def vp-has?(map, ph) = json-object-has?(map, ph) ? 1 : 0;
        def vp-ints(nodes) = (Comparable) len(nodes) == 0 ? list() : cons(json-int-value(head(nodes)), vp-ints(tail(nodes)));
        def vp-ids-of(map, ph) = (Comparable) vp-has?(map, ph) == 0 ? list() : vp-ints(json-array-elements(json-object-get(map, ph)));
        def vp-table-size(map) = len(json-object-keys(map));

        // ---- piper's row shape, followed exactly ----
        def vp-row-go(map, phs, acc) {
            let pad = vp-ids-of(map, VPPad());
            let here = (Comparable) len(phs) == 0 ? list() : vp-ids-of(map, head(phs));
            let next = (Comparable) len(phs) == 0 ? acc : (Comparable) len(here) == 0 ? acc : append(acc, append(here, pad));
            (Comparable) len(phs) == 0 ? acc : vp-row-go(map, tail(phs), next);
        }
        def vp-ids(cfg, phs) {
            let map = vp-map(cfg);
            let open = append(vp-ids-of(map, VPBos()), vp-ids-of(map, VPPad()));
            append(vp-row-go(map, phs, open), vp-ids-of(map, VPEos()));
        }
        // a phoneme with no id is dropped, exactly as piper drops it — and counted, so the
        // loss is visible instead of silent
        def vp-dropped(cfg, phs) {
            let map = vp-map(cfg);
            vp-drop-go(map, phs, 0);
        }
        def vp-drop-go(map, phs, n) = (Comparable) len(phs) == 0 ? n : vp-drop-go(map, tail(phs), (Comparable) vp-has?(map, head(phs)) == 0 ? (n + 1) : n);

        // ---- phonemes arrive as text, one to a line ----
        // A phoneme can be a combining mark or a whole diphthong, so nothing here splits on
        // codepoints; the line IS the phoneme, and an empty line is a real phoneme only when
        // the voice's table holds one, which none does.
        def vp-lines-of(s) = vp-strip-tail(split-on(s, byte_to_str(10)));
        // a trailing newline leaves one empty line behind; it is not a phoneme
        def vp-keep-last(xs) = (Comparable) str_len(head(xs)) == 0 ? list() : xs;
        def vp-strip-tail(xs) = (Comparable) len(xs) == 0 ? list() : (Comparable) len(tail(xs)) == 0 ? vp-keep-last(xs) : cons(head(xs), vp-strip-tail(tail(xs)));
        def vp-phonemes-from(path) = vp-lines-of(read_file(path));

        def vp-ints-text(xs) = (Comparable) len(xs) == 0 ? "" : vp-cat(list(int_to_str(head(xs)), (Comparable) len(tail(xs)) == 0 ? "" : " ", vp-ints-text(tail(xs))));
        def vp-ints-eq?(a, b) = (Comparable) len(a) == len(b) ? vp-ints-eq-go(a, b) : 0;
        def vp-ints-eq-go(a, b) = (Comparable) len(a) == 0 ? 1 : (Comparable) head(a) == head(b) ? vp-ints-eq-go(tail(a), tail(b)) : 0;
    }
    0;
}
