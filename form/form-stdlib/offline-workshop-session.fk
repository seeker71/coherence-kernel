; offline-workshop-session.fk — trust gate for a local transcript session bundle.
;
; The host carrier moves audio and computes hashes. This Form cell owns the
; meaning of the evidence: explicit consent, local/offline storage, complete
; source links, honest unknown speakers, and observed ASR. A participant-reviewed
; name is known; every other speaker remains unknown. Unknown is healthy evidence,
; not a vacancy to fill with a guess.
;
; preludes: form-stdlib/core.fk

(do
    (defn ows-consent? (explicit) (if (eq explicit 1) 1 0))
    (defn ows-local? (local) (if (eq local 1) 1 0))
    (defn ows-offline? (offline) (if (eq offline 1) 1 0))
    (defn ows-complete? (complete) (if (eq complete 1) 1 0))
    (defn ows-has-segments? (segments) (if (gt segments 0) 1 0))

    (defn ows-speaker-partition? (segments known unknown)
        (if (and (ge known 0)
                 (and (ge unknown 0) (eq (add known unknown) segments))) 1 0))

    (defn ows-overlap-honest? (segments overlap)
        (if (and (ge overlap 0) (ge segments overlap)) 1 0))

    (defn ows-all-source-linked? (segments source-links)
        (if (eq segments source-links) 1 0))

    (defn ows-quotes-grounded? (source-links quotes)
        (if (and (ge quotes 0) (ge source-links quotes)) 1 0))

    (defn ows-audio-present? (audio-bytes)
        (if (gt audio-bytes 44) 1 0))

    (defn ows-timeline-sane? (start-ms end-ms)
        (if (and (ge start-ms 0) (gt end-ms start-ms)) 1 0))

    (defn ows-integrity? (integrity) (if (eq integrity 1) 1 0))
    (defn ows-asr-observed? (observed) (if (eq observed 1) 1 0))

    ; Known labels must all carry participant/human review evidence. This is the
    ; boundary that prevents a diarizer's convenient guess from becoming identity.
    (defn ows-known-labels-reviewed? (known reviewed)
        (if (and (ge reviewed 0) (eq known reviewed)) 1 0))

    ; Verdict 16383 means all fourteen trust dimensions were observed together.
    (defn ows-session-verdict
        (consent local offline complete segments known unknown overlap source-links
         quotes audio-bytes start-ms end-ms integrity asr-observed reviewed)
        (do
            (let c0  (if (eq (ows-consent? consent) 1) 1 0))
            (let c1  (if (eq (ows-local? local) 1) 2 0))
            (let c2  (if (eq (ows-offline? offline) 1) 4 0))
            (let c3  (if (eq (ows-complete? complete) 1) 8 0))
            (let c4  (if (eq (ows-has-segments? segments) 1) 16 0))
            (let c5  (if (eq (ows-speaker-partition? segments known unknown) 1) 32 0))
            (let c6  (if (eq (ows-overlap-honest? segments overlap) 1) 64 0))
            (let c7  (if (eq (ows-all-source-linked? segments source-links) 1) 128 0))
            (let c8  (if (eq (ows-quotes-grounded? source-links quotes) 1) 256 0))
            (let c9  (if (eq (ows-audio-present? audio-bytes) 1) 512 0))
            (let c10 (if (eq (ows-timeline-sane? start-ms end-ms) 1) 1024 0))
            (let c11 (if (eq (ows-integrity? integrity) 1) 2048 0))
            (let c12 (if (eq (ows-asr-observed? asr-observed) 1) 4096 0))
            (let c13 (if (eq (ows-known-labels-reviewed? known reviewed) 1) 8192 0))
            (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6
                (add c7 (add c8 (add c9 (add c10 (add c11 (add c12 c13)))))))))))))))

    0)
