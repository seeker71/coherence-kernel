// runtime-program-image-fkb-walker-trace.fk -- structured program-image walker trace adapter.
//
// Layer 9h3 binds structured supplied walker/resource facts to the same
// request-ready 9e envelope and admitted 8h6 program-image admission that 9h1
// already consumes. A valid trace lowers to the existing 9h1 supplied-run row
// and then delegates to 9h1. Invalid trace facts stay structured and loud.
//
// This is not a program-image walker or loader. It does not open artifacts,
// decode bytes, run an image, consume executor capability readiness, call
// native code, install a selector, or grow the C seed.
//
// preludes: form-stdlib/core.fk form-stdlib/source-artifact-cache.fk form-stdlib/source-artifact-descriptor.fk form-stdlib/runtime-artifact-plan.fk form-stdlib/runtime-artifact-selector.fk form-stdlib/runtime-artifact-outcome.fk form-stdlib/runtime-artifact-retry.fk form-stdlib/runtime-artifact-load-envelope.fk form-stdlib/runtime-artifact-attempt-receipt.fk form-stdlib/program-image-fkb.fk form-stdlib/program-image-fkb-byte-container.fk form-stdlib/program-image-fkb-byte-file-witness.fk form-stdlib/program-image-fkb-byte-decode.fk form-stdlib/runtime-program-image-fkb-attempt.fk
section [form.bml] {
    def rpiwt-version() = "runtime-program-image-fkb-walker-trace-v1";
    def rpiwt-feature(name, status) = ["runtime-program-image-fkb-walker-trace-feature", name, status];
    def rpiwt-feature-name(f) = f[1];
    def rpiwt-feature-status(f) = f[2];
    def runtime-program-image-fkb-walker-trace-manifest() = [rpiwt-feature("walker-trace-adapter-not-loader", 1), rpiwt-feature("structured-resource-facts", 1), rpiwt-feature("trace-identity-bound-to-envelope-and-admission", 1), rpiwt-feature("function-root-entry-only", 1), rpiwt-feature("entry-root-validated", 1), rpiwt-feature("resource-counters-sane", 1), rpiwt-feature("ok-requires-completed-output", 1), rpiwt-feature("hard-statuses-preserved", 1), rpiwt-feature("soft-and-unknown-statuses-preserved", 1), rpiwt-feature("lowers-to-9h1-supplied-run", 1), rpiwt-feature("9h1-bridge-visible", 1), rpiwt-feature("no-executor-capability-consumption", 1), rpiwt-feature("no-artifact-io", 1), rpiwt-feature("no-program-image-walk", 1), rpiwt-feature("no-native-call", 1), rpiwt-feature("no-selector-install", 1), rpiwt-feature("no-c-seed-growth", 1), rpiwt-feature("future-real-9h-walker-still-pending", 1)];
    def runtime-program-image-fkb-walker-trace-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) rpiwt-feature-name(head(fs)) == name && (Comparable) rpiwt-feature-status(head(fs)) == 1 ? 1 : runtime-program-image-fkb-walker-trace-manifest-has?(name, tail(fs));
    def rpiwt-status-trace-ready() = "trace-ready";
    def rpiwt-status-investigate() = "investigate";
    def rpiwt-status-refused() = "refused";
    def rpiwt-reason-trace-lowered() = "trace-lowered";
    def rpiwt-reason-malformed-envelope() = "malformed-envelope";
    def rpiwt-reason-non-program-image-envelope() = "non-program-image-envelope";
    def rpiwt-reason-malformed-admission() = "malformed-admission";
    def rpiwt-reason-non-admitted-admission() = "non-admitted-admission";
    def rpiwt-reason-admission-decode-not-decoded() = "admission-decode-not-decoded";
    def rpiwt-reason-admission-invalid-pif() = "admission-invalid-pif";
    def rpiwt-reason-admission-decode-pif-mismatch() = "admission-decode-pif-mismatch";
    def rpiwt-reason-artifact-identity-mismatch() = "artifact-identity-mismatch";
    def rpiwt-reason-malformed-trace() = "malformed-trace";
    def rpiwt-reason-trace-identity-mismatch() = "trace-identity-mismatch";
    def rpiwt-reason-invalid-entry-kind() = "invalid-entry-kind";
    def rpiwt-reason-negative-entry-index() = "negative-entry-index";
    def rpiwt-reason-entry-index-out-of-range() = "entry-index-out-of-range";
    def rpiwt-reason-root-node-out-of-range() = "root-node-out-of-range";
    def rpiwt-reason-root-node-mismatch() = "root-node-mismatch";
    def rpiwt-reason-negative-step-budget() = "negative-step-budget";
    def rpiwt-reason-negative-steps-used() = "negative-steps-used";
    def rpiwt-reason-steps-used-exceeds-budget() = "steps-used-exceeds-budget";
    def rpiwt-reason-negative-output() = "negative-output";
    def rpiwt-reason-empty-ok-output() = "empty-ok-output";
    def rpiwt-reason-ok-stop-reason-mismatch() = "ok-stop-reason-mismatch";
    def rpiwt-reason-status-stop-reason-mismatch() = "status-stop-reason-mismatch";
    def rpiwt-reason-empty-unknown-stop-reason() = "empty-unknown-stop-reason";
    def rpiwt-reason-manifest() = [rpiwt-reason-trace-lowered(), rpiwt-reason-malformed-envelope(), rpiwt-reason-non-program-image-envelope(), rpiwt-reason-malformed-admission(), rpiwt-reason-non-admitted-admission(), rpiwt-reason-admission-decode-not-decoded(), rpiwt-reason-admission-invalid-pif(), rpiwt-reason-admission-decode-pif-mismatch(), rpiwt-reason-artifact-identity-mismatch(), rpiwt-reason-malformed-trace(), rpiwt-reason-trace-identity-mismatch(), rpiwt-reason-invalid-entry-kind(), rpiwt-reason-negative-entry-index(), rpiwt-reason-entry-index-out-of-range(), rpiwt-reason-root-node-out-of-range(), rpiwt-reason-root-node-mismatch(), rpiwt-reason-negative-step-budget(), rpiwt-reason-negative-steps-used(), rpiwt-reason-steps-used-exceeds-budget(), rpiwt-reason-negative-output(), rpiwt-reason-empty-ok-output(), rpiwt-reason-ok-stop-reason-mismatch(), rpiwt-reason-status-stop-reason-mismatch(), rpiwt-reason-empty-unknown-stop-reason()];
    def rpiwt-entry-kind-function-root() = "function-root";
    def rpiwt-stop-completed() = "completed";
    def rpiwt-stop-oom-killed() = "oom-killed";
    def rpiwt-stop-killed() = "killed";
    def rpiwt-stop-stalled() = "stalled";
    def rpiwt-stop-timeout() = "timeout";
    def rpiwt-stop-wrong-value() = "wrong-value";
    def rpiwt-stop-loader-missing() = "loader-missing";
    def rpiwt-stop-error() = "error";
    def rpiwt-stop-unknown() = "unknown";
    def rpiwt-marker() = "program-image-fkb-walker-trace";
    // trace = ("runtime-program-image-fkb-walker-trace" artifact-path
    //          source-hash content-hash entry-kind entry-index root-node
    //          step-budget steps-used output-count first-value exit-code
    //          status stop-reason detail)
    def rpiwt-trace(artifact-path, source-hash, content-hash, entry-kind, entry-index, root-node, step-budget, steps-used, output-count, first-value, exit-code, status, stop-reason, detail) = ["runtime-program-image-fkb-walker-trace", artifact-path, source-hash, content-hash, entry-kind, entry-index, root-node, step-budget, steps-used, output-count, first-value, exit-code, status, stop-reason, detail];
    def rpiwt-trace?(t) = (Comparable) len(t) == 15 ? (String) t[0] == "runtime-program-image-fkb-walker-trace" : 0;
    def rpiwt-trace-artifact-path(t) = t[1];
    def rpiwt-trace-source-hash(t) = t[2];
    def rpiwt-trace-content-hash(t) = t[3];
    def rpiwt-trace-entry-kind(t) = t[4];
    def rpiwt-trace-entry-index(t) = t[5];
    def rpiwt-trace-root-node(t) = t[6];
    def rpiwt-trace-step-budget(t) = t[7];
    def rpiwt-trace-steps-used(t) = t[8];
    def rpiwt-trace-output-count(t) = t[9];
    def rpiwt-trace-first-value(t) = t[10];
    def rpiwt-trace-exit-code(t) = t[11];
    def rpiwt-trace-status(t) = t[12];
    def rpiwt-trace-stop-reason(t) = t[13];
    def rpiwt-trace-detail(t) = t[14];
    def rpiwt-no-run() = ["runtime-program-image-fkb-walker-trace-no-run"];
    def rpiwt-no-run?(r) = (Comparable) len(r) == 1 ? (String) r[0] == "runtime-program-image-fkb-walker-trace-no-run" : 0;
    def rpiwt-no-9h1-bridge() = ["runtime-program-image-fkb-walker-trace-no-9h1-bridge"];
    def rpiwt-no-9h1-bridge?(b) = (Comparable) len(b) == 1 ? (String) b[0] == "runtime-program-image-fkb-walker-trace-no-9h1-bridge" : 0;
    // bridge = ("runtime-program-image-fkb-walker-trace-bridge"
    //           envelope admission trace run 9h1-bridge status reason)
    def rpiwt-bridge-receipt(envelope, admission, trace, run, bridge, status, reason) = ["runtime-program-image-fkb-walker-trace-bridge", envelope, admission, trace, run, bridge, status, reason];
    def rpiwt-bridge?(b) = (Comparable) len(b) == 8 ? (String) b[0] == "runtime-program-image-fkb-walker-trace-bridge" : 0;
    def rpiwt-bridge-envelope(b) = b[1];
    def rpiwt-bridge-admission(b) = b[2];
    def rpiwt-bridge-trace(b) = b[3];
    def rpiwt-bridge-run(b) = b[4];
    def rpiwt-bridge-9h1(b) = b[5];
    def rpiwt-bridge-status(b) = b[6];
    def rpiwt-bridge-reason(b) = b[7];
    def rpiwt-investigate(envelope, admission, trace, run, bridge, reason) = rpiwt-bridge-receipt(envelope, admission, trace, run, bridge, rpiwt-status-investigate(), reason);
    def rpiwt-refused(envelope, admission, trace, run, bridge, reason) = rpiwt-bridge-receipt(envelope, admission, trace, run, bridge, rpiwt-status-refused(), reason);
    def rpiwt-terminal-from-9h1(envelope, admission, trace, run, bridge, reason) = (String) rpifa-bridge-status(bridge) == rpifa-status-refused() ? rpiwt-refused(envelope, admission, trace, run, bridge, reason) : rpiwt-investigate(envelope, admission, trace, run, bridge, reason);
    def rpiwt-ready(envelope, admission, trace, run, bridge) = rpiwt-bridge-receipt(envelope, admission, trace, run, bridge, rpiwt-status-trace-ready(), rpiwt-reason-trace-lowered());
    def rpiwt-run-detail(trace) = str_concat(rpiwt-marker(), str_concat(" stop=", str_concat(rpiwt-trace-stop-reason(trace), str_concat(" detail=", rpiwt-trace-detail(trace)))));
    def rpiwt-run-from-trace(trace) = rpifa-supplied-run(rpiwt-trace-artifact-path(trace), rpiwt-trace-first-value(trace), rpiwt-trace-output-count(trace), rpiwt-trace-exit-code(trace), rpiwt-trace-status(trace), rpiwt-run-detail(trace));
    def rpiwt-trace-identity-matches?(envelope, pif, trace) = (String) rpiwt-trace-artifact-path(trace) == rale-envelope-artifact-path(envelope) && ((String) rpiwt-trace-artifact-path(trace) == pif-envelope-artifact-path(pif) && ((String) rpiwt-trace-source-hash(trace) == rale-envelope-source-hash(envelope) && ((String) rpiwt-trace-source-hash(trace) == pif-envelope-source-hash(pif) && ((String) rpiwt-trace-content-hash(trace) == rale-envelope-content-hash(envelope) && (String) rpiwt-trace-content-hash(trace) == pif-envelope-content-hash(pif)))));
    def rpiwt-entry-index-valid?(pif, trace) = {
        let table = pif-envelope-table(pif);
        rpiwt-trace-entry-index(trace) >= 0 && rpiwt-trace-entry-index(trace) < pif-table-nf(table);
    };
    def rpiwt-root-node-in-range?(pif, trace) = {
        let table = pif-envelope-table(pif);
        rpiwt-trace-root-node(trace) >= 0 && rpiwt-trace-root-node(trace) < pif-table-nr(table);
    };
    def rpiwt-root-node-matches?(pif, trace) = {
        let table = pif-envelope-table(pif);
        (Comparable) rpiwt-trace-root-node(trace) == pif-table-fn-roots(table)[rpiwt-trace-entry-index(trace)];
    };
    def rpiwt-entry-reason(pif, trace) = !((String) rpiwt-trace-entry-kind(trace) == rpiwt-entry-kind-function-root()) ? rpiwt-reason-invalid-entry-kind() : rpiwt-trace-entry-index(trace) < 0 ? rpiwt-reason-negative-entry-index() : !rpiwt-entry-index-valid?(pif, trace) ? rpiwt-reason-entry-index-out-of-range() : !rpiwt-root-node-in-range?(pif, trace) ? rpiwt-reason-root-node-out-of-range() : !rpiwt-root-node-matches?(pif, trace) ? rpiwt-reason-root-node-mismatch() : rpiwt-reason-trace-lowered();
    def rpiwt-entry-valid?(pif, trace) = (String) rpiwt-entry-reason(pif, trace) == rpiwt-reason-trace-lowered();
    def rpiwt-resource-reason(trace) = rpiwt-trace-step-budget(trace) < 0 ? rpiwt-reason-negative-step-budget() : rpiwt-trace-steps-used(trace) < 0 ? rpiwt-reason-negative-steps-used() : rpiwt-trace-steps-used(trace) > rpiwt-trace-step-budget(trace) ? rpiwt-reason-steps-used-exceeds-budget() : rpiwt-trace-output-count(trace) < 0 ? rpiwt-reason-negative-output() : (String) rpiwt-trace-status(trace) == rao-obs-ok() && (Comparable) rpiwt-trace-output-count(trace) == 0 ? rpiwt-reason-empty-ok-output() : rpiwt-reason-trace-lowered();
    def rpiwt-resource-valid?(trace) = (String) rpiwt-resource-reason(trace) == rpiwt-reason-trace-lowered();
    def rpiwt-known-status?(status) = (String) status == rao-obs-ok() ? 1 : (Comparable) rao-hard-status?(status) == 1 ? 1 : (Comparable) rao-soft-status?(status) == 1 ? 1 : 0;
    def rpiwt-known-status-stop-matches?(status, stop) = (String) status == rao-obs-ok() ? (String) stop == rpiwt-stop-completed() : (String) status == rao-obs-oom-killed() ? (String) stop == rpiwt-stop-oom-killed() : (String) status == rao-obs-killed() ? (String) stop == rpiwt-stop-killed() : (String) status == rao-obs-stalled() ? (String) stop == rpiwt-stop-stalled() : (String) status == rao-obs-timeout() ? (String) stop == rpiwt-stop-timeout() : (String) status == rao-obs-wrong-value() ? (String) stop == rpiwt-stop-wrong-value() : (String) status == rao-obs-loader-missing() ? (String) stop == rpiwt-stop-loader-missing() : (String) status == rao-obs-error() ? (String) stop == rpiwt-stop-error() : 0;
    def rpiwt-status-reason(trace) = {
        let status = rpiwt-trace-status(trace);
        let stop = rpiwt-trace-stop-reason(trace);
        (Comparable) rpiwt-known-status?(status) == 1 ? (Comparable) rpiwt-known-status-stop-matches?(status, stop) == 1 ? rpiwt-reason-trace-lowered() : (String) status == rao-obs-ok() ? rpiwt-reason-ok-stop-reason-mismatch() : rpiwt-reason-status-stop-reason-mismatch() : str_len(stop) > 0 ? rpiwt-reason-trace-lowered() : rpiwt-reason-empty-unknown-stop-reason();
    };
    def rpiwt-status-valid?(trace) = (String) rpiwt-status-reason(trace) == rpiwt-reason-trace-lowered();
    def rpiwt-terminal-envelope(envelope, admission, trace, run, reason) = {
        let bridge = rpifa-bridge-from-run(envelope, admission, run);
        rpiwt-terminal-from-9h1(envelope, admission, trace, run, bridge, reason);
    };
    def rpiwt-terminal-admission(envelope, admission, trace, run, reason) = {
        let bridge = rpifa-bridge-from-run(envelope, admission, run);
        rpiwt-terminal-from-9h1(envelope, admission, trace, run, bridge, reason);
    };
    def rpiwt-bridge-after-admission(envelope, admission, trace, run) = {
        let pif = pifbd-admission-pif(admission);
        !rpifa-pif-matches-envelope?(envelope, pif) ? rpiwt-terminal-admission(envelope, admission, trace, run, rpiwt-reason-artifact-identity-mismatch()) : !rpiwt-trace-identity-matches?(envelope, pif, trace) ? rpiwt-investigate(envelope, admission, trace, run, rpiwt-no-9h1-bridge(), rpiwt-reason-trace-identity-mismatch()) : !rpiwt-entry-valid?(pif, trace) ? rpiwt-refused(envelope, admission, trace, run, rpiwt-no-9h1-bridge(), rpiwt-entry-reason(pif, trace)) : !rpiwt-resource-valid?(trace) ? rpiwt-refused(envelope, admission, trace, run, rpiwt-no-9h1-bridge(), rpiwt-resource-reason(trace)) : !rpiwt-status-valid?(trace) ? rpiwt-refused(envelope, admission, trace, run, rpiwt-no-9h1-bridge(), rpiwt-status-reason(trace)) : {
            let bridge = rpifa-bridge-from-run(envelope, admission, run);
            (String) rpifa-bridge-status(bridge) == rpifa-status-attempt-ready() ? rpiwt-ready(envelope, admission, trace, run, bridge) : rpiwt-terminal-from-9h1(envelope, admission, trace, run, bridge, rpifa-bridge-reason(bridge));
        };
    };
    def rpiwt-bridge-from-trace(envelope, admission, trace) = !rpiwt-trace?(trace) ? rpiwt-refused(envelope, admission, trace, rpiwt-no-run(), rpiwt-no-9h1-bridge(), rpiwt-reason-malformed-trace()) : {
        let run = rpiwt-run-from-trace(trace);
        !rale-envelope?(envelope) ? rpiwt-terminal-envelope(envelope, admission, trace, run, rpiwt-reason-malformed-envelope()) : !rpifa-program-image-envelope?(envelope) ? rpiwt-terminal-envelope(envelope, admission, trace, run, rpiwt-reason-non-program-image-envelope()) : !pifbd-admission?(admission) ? rpiwt-terminal-admission(envelope, admission, trace, run, rpiwt-reason-malformed-admission()) : !rpifa-admission-status-admitted?(admission) ? rpiwt-terminal-admission(envelope, admission, trace, run, rpiwt-reason-non-admitted-admission()) : !rpifa-admission-decode-decoded?(admission) ? rpiwt-terminal-admission(envelope, admission, trace, run, rpiwt-reason-admission-decode-not-decoded()) : !rpifa-admission-pif-valid?(admission) ? rpiwt-terminal-admission(envelope, admission, trace, run, rpiwt-reason-admission-invalid-pif()) : !rpifa-admission-decode-matches-pif?(admission) ? rpiwt-terminal-admission(envelope, admission, trace, run, rpiwt-reason-admission-decode-pif-mismatch()) : rpiwt-bridge-after-admission(envelope, admission, trace, run);
    };
}
