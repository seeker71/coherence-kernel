; form-cli-domain-mint-run.fk — mint domain-cell samples, fit overlay, print lift.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-domain-mint-xtal.fk

(do
    (let rows (fdm-corpus 3 1))
    (let n (fdm-n 3 1))
    (let correct (fdm-heldout-correct rows))
    (print_str (str_concat "fdm n=" (str_concat (int_to_str n) "\n")))
    (print_str (str_concat "fdm unique=" (str_concat (int_to_str (fdm-unique rows)) "\n")))
    (print_str (str_concat "fdm leakage=" (str_concat (int_to_str (fdm-leakage rows)) "\n")))
    (print_str (str_concat "fdm heldout-correct=" (str_concat (int_to_str correct) "\n")))
    (print_str (str_concat "fdm heldout-n=" (str_concat (int_to_str (fdm-count-split rows (SplitHeldout))) "\n")))
    (print_str (str_concat "fdm lora-writer=" (str_concat (int_to_str (fdm-lora-writer)) "\n")))
    (print_str (str_concat "fdm check=" (str_concat (int_to_str (fdm-check)) "\n")))
    (print_str (str_concat "fdm scale-5-2=" (str_concat (int_to_str (fdm-n 5 2)) "\n")))
    (print_str (str_concat "fdm scale-12-4=" (str_concat (int_to_str (fdm-n 12 4)) "\n")))
    (print_str (str_concat "fdm sample-assemblage=" (str_concat (nth (fdm-row "assemblage" 0 (SplitTrain)) 2) "\n")))
    (print_str (str_concat "fdm sample-quantum=" (str_concat (nth (fdm-row "quantum" 0 (SplitTrain)) 2) "\n")))
    (print_str (str_concat "fdm sample-shape=" (str_concat (nth (fdm-row "shape-match" 0 (SplitTrain)) 2) "\n")))
    0)
