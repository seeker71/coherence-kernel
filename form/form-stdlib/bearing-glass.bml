//////////////////////////////////////////////////////////////////////
//
// bearing-glass.bml — the bearing census, spoken as a panel and given to the glass.
//
// Authority: form-stdlib/bml/bearing-glass.bml
// preludes: form/form-stdlib/bearing-census.bml form/form-stdlib/form-glass-sensor-rows.bml
// Proven by: form-stdlib/tests/bearing-census-band.fk (the arithmetic)
//            observe/bearing-census-take.fk (the frame arrives)
//
// The census itself (bearing-census.bml) touches nothing and is proven pure. This
// cell is where it meets the world: it reads the op table, reads the workload's
// units, prints the panel and gives the rows under its own publisher. Every run
// cell is then four lines — work, snapshot, ask, give — and two workloads share
// one voice instead of two copies of it.
//
// The publisher declares its cadence INSIDE the frame (fgsr-give-at), so the
// sensor roster needs no edit to carry a new sensor: a taker reads the cadence
// the giver stated and calls the frame silent past three of them.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class BearingGlassAuthority {
        field BGLAuthorityPath = "form/form-stdlib/bml/bearing-glass.bml";
        field BGLAuthorityKind = "high-bml-interface-class-const";
    }

    class BearingGlass {
        field BGLShown = 8;
        field BGLDomain = "kernel";
        field BGLChannel = "jit";
        field BGLSource = "kernel_hot_rows";
        ref bgl-authority = BearingGlassAuthority;

        // --- reading the body around the census ---------------------------------
        def bgl-optable-path() = "runtime/fkwu-optable.h";
        def bgl-natives() = bcs-native-names(read_file(bgl-optable-path()));
        def bgl-walked() = bgl-walked-of(kernel_live(host_pid()));
        def bgl-walked-of(w) = if lt(len(w), 6) then 0 else nth(w, 5);

        // one reading: the snapshot, the units it points at plus the ones the caller names,
        // the index built from them, and the census over all of it
        def bgl-read(rows, paths) = bgl-read-with(rows, bcs-index(bcs-units-for(rows, paths), bcs-names(rows)));
        def bgl-read-with(rows, index) = list(rows, index, bcs-graph-indexed(bcs-names(rows), index), bcs-unread-in(bcs-names(rows), index));
        def bgl-r-rows(r) = nth(r, 0);
        def bgl-r-edges(r) = nth(r, 2);
        def bgl-r-unread(r) = nth(r, 3);
        def bgl-census(r, natives) = bcs-sort(bcs-census(bgl-r-rows(r), bgl-r-edges(r), natives));

        // --- the panel ------------------------------------------------------------
        def bgl-names(ns) = if eq(len(ns), 0) then "none" else bgl-names-go(ns);
        def bgl-names-go(ns) = if eq(len(tail(ns)), 0) then head(ns) else str_concat(head(ns), str_concat(" ", bgl-names-go(tail(ns))));
        def bgl-lines(cs, n) = if or(le(n, 0), eq(len(cs), 0)) then 0 else bgl-lines-next(print(str_concat("  ", bcs-c-text(head(cs)))), cs, n);
        def bgl-lines-next(said, cs, n) = bgl-lines(tail(cs), sub(n, 1));
        def bgl-panel(census, r, seen, walked, ms, label, natives) {
            let a = print("");
            let b = print(bcs-cat(list("bearing census — ", label, ", ", int_to_str(ms), " ms, ", int_to_str(len(bgl-r-rows(r))), " doors of ", bcs-pct(bcs-coverage-bp(seen, walked)), " of the walking (", int_to_str(walked), " steps)")));
            let c = print(bcs-cat(list("  ", int_to_str(len(natives)), " natives in the op table, ", int_to_str(len(bgl-r-edges(r))), " edges drawn, ", int_to_str(len(bgl-r-unread(r))), " doors unread, ", int_to_str(len(bcs-heal-list(census))), " heal candidates")));
            let d = print("");
            let e = print(str_concat("  the next substring: ", bcs-worst-name(census)));
            let f = print("");
            let g = bgl-lines(census, BGLShown());
            let h = print(str_concat("  unread, bearing is a floor: ", bgl-names(bgl-r-unread(r))));
            1;
        }

        // --- the rows -------------------------------------------------------------
        def bgl-note(c) = bcs-cat(list("bearing = this door's walker steps plus every door reachable from it; ", bcs-num(bcs-c-calls(c)), " calls at ", bcs-per-call-text(bcs-c-per-call(c)), "; ", bcs-num(bcs-c-leaning(c)), " distinct doors reach it; remedy ", bcs-c-remedy(c)));
        def bgl-row(c) = fgo-int(BGLDomain(), str_concat("bearing.", bcs-c-name(c)), bcs-c-text(c), bcs-c-drag(c), "drag", bcs-c-calls(c), "cpu-arena", "physical-live", BGLSource(), "live", BGLChannel(), bgl-note(c));
        def bgl-rows-of(cs, n) = if or(le(n, 0), eq(len(cs), 0)) then list() else cons(bgl-row(head(cs)), bgl-rows-of(tail(cs), sub(n, 1)));
        def bgl-int-row(id, label, value, unit, note) = fgo-int(BGLDomain(), id, label, value, unit, 0, "cpu-arena", "physical-live", BGLSource(), "live", BGLChannel(), note);
        def bgl-head-rows(census, r, seen, walked, ms, label) = list(
            fgo-text(BGLDomain(), "bearing.worst", "the next substring", bcs-worst-name(census), "cpu-arena", "physical-live", BGLSource(), "live", BGLChannel(), "the composed door carrying the most drag: its share of the walking times the doors that lean on it, heal candidates only. A native already standing is never named here, because the walking that reaches it asks for routing and not for minting"),
            fgo-text(BGLDomain(), "bearing.workload", "the workload this census read", label, "cpu-arena", "physical-live", BGLSource(), "live", BGLChannel(), "a real proof this body runs, walked in this process before the ledger was snapshotted"),
            bgl-int-row("bearing.coverage", "walking this census saw", bcs-coverage-bp(seen, walked), "basis-points", "the snapshot is the warmest doors only; this is their share of the whole process's walking, so a partial reading cannot pass itself off as the body"),
            bgl-int-row("bearing.seen", "walker steps in the snapshot", seen, "calls", "heat counts the times the WALKER entered a defn; a door the JIT crystallized stopped walking and stops accruing here, which is the measure working"),
            bgl-int-row("bearing.walked", "walker steps, whole process", walked, "calls", "the kernel's own live page, word 5, read straight after the snapshot"),
            bgl-int-row("bearing.edges", "call edges drawn", len(bgl-r-edges(r)), "edges", "an edge is a boundary-checked mention of one door's name in another door's body, comments cut away first"),
            bgl-int-row("bearing.unread", "doors whose body was not found", len(bgl-r-unread(r)), "doors", str_concat("their callees are unknown, so their bearing is a floor and not a reading: ", bgl-names(bgl-r-unread(r)))),
            bgl-int-row("bearing.workload-ms", "the workload's own time", ms, "milliseconds", "wall time of the workload alone, measured before the census walked anything"));
        def bgl-give(census, r, seen, walked, ms, label) = bgl-give-at(census, r, seen, walked, ms, label, now_unix_ms());
        def bgl-give-at(census, r, seen, walked, ms, label, now) = fgsr-give-at(BCSSensor(), now, fgo-observe-rows(append(bgl-head-rows(census, r, seen, walked, ms, label), bgl-rows-of(census, BGLShown())), now, 0), BCSCadenceMs());

        // --- work, snapshot, ask, give: the whole movement in one door -------------
        // the caller does the work and hands in the snapshot it took immediately after, so
        // nothing this cell walks can reach the reading it is about to report
        def bgl-witness(rows, walked, ms, label, paths) = bgl-witness-read(rows, walked, ms, label, bgl-read(rows, paths), bgl-natives());
        def bgl-witness-read(rows, walked, ms, label, r, natives) = bgl-witness-census(rows, walked, ms, label, r, natives, bgl-census(r, natives), bcs-total-heat(rows, 0));
        def bgl-witness-census(rows, walked, ms, label, r, natives, census, seen) = bgl-witness-said(census, r, seen, walked, ms, label, bgl-panel(census, r, seen, walked, ms, label, natives));
        def bgl-witness-said(census, r, seen, walked, ms, label, said) = bgl-witness-given(census, bgl-give(census, r, seen, walked, ms, label));
        def bgl-witness-given(census, given) = bgl-witness-told(census, print(bcs-cat(list("  given to the glass: ", nth(given, 1), " ", nth(given, 2), " seq ", int_to_str(nth(given, 4))))));
        def bgl-witness-told(census, told) = bcs-worst-name(census);
    }
    0;
}
