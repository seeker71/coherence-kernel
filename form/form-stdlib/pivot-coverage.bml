//////////////////////////////////////////////////////////////////////
//
// pivot-coverage.bml — the no-favored-tongue coverage lens.
//
// Executable BML. R12 in the release ledger. It reads; it writes nothing.
//
// The pivot symbol is a meaning's one name; every natural tongue,
// English included, is a projection column, and the lexicon is DATA —
// a word is a row, a tongue a column (nl-translate.fk: nlt-lexicon =
// seed rows ++ corpus rows, columns symbol/phase/en/id). The homecoming
// corpus mints one fresh English word per row. A fresh word with no
// lexicon row exists in the English column only: the pivot cannot name
// it, no other tongue can reach it, and the no-favor belief is a
// sentence about it rather than a fact of it.
//
// This lens holds the two tables against each other. For every corpus
// row (hdc-rows, learn/homecoming-distillation-corpus.fk) it takes the
// fresh word (hdc-fresh) and asks the lexicon's en column (nlt-find,
// column 2) whether a row carries it. Pivoted words are printed with
// their symbol and id surface, missing words with their meaning-id;
// then the totals; the answer is
//
//     words*10^6 + pivoted*10^3 + missing
//
// injective while pivoted and missing each stay under 1000. A word is
// counted once per corpus row that minted it (hdc-fresh-ambiguous names
// a word minted twice; this lens does not fold it away).
//
// The pure fold pc-cover(words, lex) is what the band plants against;
// pc-report() is the same fold over the living corpus and lexicon.
//
// Run directly:  ./fkwu form/form-stdlib/pivot-coverage.bml
// Proven by:     form-stdlib/tests/pivot-coverage-band.fk
//
// NEXT STONE, named and not built here: the minting door. Today a row
// lands in the corpus by one hand and its pivot row in
// nl-lexicon-data.fk by the same hand, in the same sitting, as data —
// nothing holds the two together but the sitting. The door is
// pivot-mint(mid, en, id): it takes the fresh word and its id surface
// at the moment the corpus row is offered and appends the m<mid> row to
// the corpus lexicon, so a corpus row and its pivot row are one
// offering and the corpus cannot grow English-only again. It writes
// into a data cell that the web/messages projector (nl-lexicon-grow.fk,
// grow-rows) also emits, so the two writers first need one shape — the
// projector reading the m-rows it did not mint and carrying them — and
// the corpus's own append door is still by hand. That shape is the
// stone; this lens is the number it is measured by.
//
// preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/string-case.fk form-stdlib/nl-lexicon-data.fk form-stdlib/nl-translate.fk learn/homecoming-distillation-corpus.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormPivotCoverage {
        thought pivot-coverage-pattern = list("word-is-a-row", "tongue-is-a-column", "symbol-is-the-meaning-id", "reads-never-writes", "missing-is-named");

        // ---- the lexicon columns, as nl-translate.fk names them ----
        def pc-col-symbol() = 0;
        def pc-col-en() = 2;
        def pc-col-id() = 3;

        // ---- one word against one lexicon: its row, or nothing ----
        def pc-row-of(lex, w) = nlt-find(lex, pc-col-en(), w);
        def pc-pivoted?(lex, w) = if nil?(pc-row-of(lex, w)) then 0 else 1;

        // ---- the fresh words of a row list, order kept ----
        def pc-words(rows) = if eq(len(rows), 0) then empty() else cons(hdc-fresh(head(rows)), pc-words(tail(rows)));

        // ---- the fold: list(pivoted-count, missing-words) ----
        def pc-cover-go(words, lex, p, miss) {
            if eq(len(words), 0) then list(p, reverse(miss))
            else if eq(pc-pivoted?(lex, head(words)), 1) then pc-cover-go(tail(words), lex, add(p, 1), miss)
            else pc-cover-go(tail(words), lex, p, cons(head(words), miss));
        }
        def pc-cover(words, lex) = pc-cover-go(words, lex, 0, empty());
        def pc-pivoted(c) = nth(c, 0);
        def pc-missing(c) = nth(c, 1);
        def pc-missing-count(c) = len(pc-missing(c));
        def pc-field(words, c) = add(mul(words, 1000000), add(mul(pc-pivoted(c), 1000), pc-missing-count(c)));

        // ---- is a word in a word list ----
        def pc-holds?(words, w) = if eq(len(words), 0) then 0 else if str_eq(head(words), w) then 1 else pc-holds?(tail(words), w);

        // ---- the report: one line per corpus row, then the totals ----
        def pc-mid-text(r) = int_to_str(hdc-mid(r));
        def pc-line-pivoted(r, row) = str_concat("pivoted  ", str_concat(pc-mid-text(r), str_concat("  ", str_concat(hdc-fresh(r), str_concat("  -> ", str_concat(nth(row, pc-col-symbol()), str_concat("  id ", nth(row, pc-col-id()))))))));
        def pc-line-missing(r) = str_concat("missing  ", str_concat(pc-mid-text(r), str_concat("  ", hdc-fresh(r))));
        def pc-print-row(r, lex) {
            let row = pc-row-of(lex, hdc-fresh(r));
            if nil?(row) then print(pc-line-missing(r)) else print(pc-line-pivoted(r, row));
        }
        def pc-print-go(rows, lex) = if eq(len(rows), 0) then 0 else pc-print-one(head(rows), tail(rows), lex);
        def pc-print-one(r, rest, lex) {
            pc-print-row(r, lex);
            pc-print-go(rest, lex);
        }
        def pc-summary(words, c) = str_concat("words=", str_concat(int_to_str(words), str_concat(" pivoted=", str_concat(int_to_str(pc-pivoted(c)), str_concat(" missing=", int_to_str(pc-missing-count(c)))))));

        // ---- the living walk: corpus rows against the living lexicon ----
        def pc-report() {
            let rows = hdc-rows();
            let lex = nlt-lexicon();
            let words = pc-words(rows);
            let c = pc-cover(words, lex);
            pc-print-go(rows, lex);
            print(pc-summary(len(words), c));
            pc-field(len(words), c);
        }
    }
    pc-report();
}
