//////////////////////////////////////////////////////////////////////
//
// hearth-glass-door.bml
//
// Executable BML. The GLASS PANEL COMPOSITION: every lane the living
// dashboard paints, as one lane list folded by the engine. The flesh
// of the conversation is on the panel now, not only its numbers — the
// newest ask and reply as text, the in-flight request with its stage
// phase and age, the newest choice point with its reason, and the
// debugging internals (route, recycle floor vs session position,
// pending, observations). The live door keeps only its tick loop;
// what the panel says is authored here.
//
// preludes: form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/lane-motion.bml
//
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormHearthGlassDoor {
        thought glass-door-pattern = list("panel-is-a-lane-list", "conversation-in-the-flesh", "internals-visible", "loop-stays-thin");

        def hgd-int(s, name) = fmv-field(s, name);
        def hgd-word(s, name) = gl-word-field(s, name);
        def hgd-kvp(k, v) = " " ++ k ++ "=" ++ v;
        def hgd-turntag(text) = "#" ++ gl-word-field-last(text, "turn");

        def hgd-head-lane(s, ageboard) = tg-lane("HEARTH  pid=", hgd-word(s, "pid") ++ ((String) hgd-word(s, "alive") == "1" ? " standing" : " DOWN") ++ "  model=" ++ hgd-word(s, "model"), (String) hgd-word(s, "alive") == "1" ? "plain" : "bad", ageboard);
        def hgd-tick-lane(tick) = tg-lane("tick    ", int_to_str(tick) ++ " " ++ tg-shade(1 + (tick % 4)), "plain", 0 - 1);
        def hgd-tasks-lane(s, agetask) = tg-lane("tasks   ", hgd-word(s, "taskb") ++ " bytes", "plain", agetask);
        def hgd-replies-lane(s, agereply) = tg-lane("replies ", hgd-word(s, "replyb") ++ " bytes", "plain", agereply);
        def hgd-pf-lane(s, ageout) = tg-lane(gl-sym-prefill() ++ " prefills ", hgd-word(s, "pf"), "plain", ageout);
        def hgd-cp-lane(s, ageout) = tg-lane(gl-sym-decode() ++ " checkpoints ", hgd-word(s, "cp"), "plain", ageout);
        def hgd-serve-lane(s, agereply) = hgd-serve-of(hgd-int(s, "lastms"), agereply);
        def hgd-serve-of(lastms, agereply) = tg-lane("last-serve ", tg-dur(lastms) ++ " " ++ tg-ramp(lastms / 1000), tg-scale(lastms, hearth-lat-lo(), hearth-lat-hi()), agereply);
        def hgd-hopper-lane(s, agetask) = tg-lane("hopper  ", "waiting=" ++ hgd-word(s, "hopper"), "plain", agetask);
        def hgd-kvfill-lane(s, agereply) = hgd-kvfill-of(hgd-int(s, "kvpos"), (hgd-int(s, "kvpos") * 100) / hearth-maxpos(), agereply);
        def hgd-kvfill-of(kvpos, kvpct, agereply) = tg-lane("kv-fill ", tg-bar((kvpct + 5) / 10, 10) ++ " " ++ int_to_str(kvpct) ++ "% pos=" ++ int_to_str(kvpos), tg-scale(kvpct, hearth-fill-lo(), hearth-fill-hi()), agereply);
        def hgd-tpot-lane(s, agereply) = tg-lane("tpot/tok ", tg-dur(hgd-int(s, "tpot")), tg-scale(hgd-int(s, "tpot"), hearth-lat-lo(), hearth-lat-hi()), agereply);
        def hgd-e2e-lane(s, agereply) = tg-lane("e2e p50/p95 ", tg-dur(hgd-int(s, "p50")) ++ "/" ++ tg-dur(hgd-int(s, "p95")), "plain", agereply);
        def hgd-birth-ms(s, name) = (String) hgd-word(s, name) == "nothing" ? "nothing" : tg-dur(hgd-int(s, name));
        def hgd-birth-lane(s, ageout) = tg-lane("birth   ", "cache=" ++ hgd-word(s, "bootcache") ++ " ctx=" ++ hgd-birth-ms(s, "bootctx") ++ " prog=" ++ hgd-birth-ms(s, "bootprog") ++ " setup=" ++ hgd-birth-ms(s, "bootsetup") ++ " prefill=" ++ hgd-birth-ms(s, "bootprefill"), "plain", ageout);

        def hgd-ask-lane(task, agetask) = tg-lane("ask     ", hgd-turntag(task) ++ " " ++ gl-clip(gl-line-field-last(task, "task"), 72), "plain", agetask);
        def hgd-reply-lane(rsp, agereply) = tg-lane("reply   ", hgd-turntag(rsp) ++ " " ++ gl-clip(gl-body-after(rsp, lms-mark-response()), 72), "plain", agereply);
        def hgd-flight-lane(s, out, nowms, agetask) = tg-lane("flight  ", "waiting:" ++ hgd-word(s, "waiting") ++ "  served:" ++ hgd-word(s, "served") ++ "  route=" ++ gl-flight-route-now(out) ++ " phase=" ++ gl-flight-phase-now(out) ++ " " ++ tg-dur(gl-flight-age(out, nowms)), "plain", agetask);
        def hgd-select-lane(s, ageout) = tg-lane("select  ", hgd-word(s, "selroute") ++ ":" ++ hgd-word(s, "selphase") ++ ":" ++ hgd-word(s, "selstat") ++ "  gen=" ++ hgd-word(s, "gen") ++ "  carrier=" ++ hgd-word(s, "carrier"), "plain", ageout);
        def hgd-choice-body(s, rsp) = (String) gl-word-field-last(rsp, "turn") == hgd-word(s, "choicet") ? gl-clip(gl-body-after(rsp, lms-mark-response()), 56) : "";
        def hgd-choice-lane(s, rsp, agereply) = tg-lane("choice  ", "n=" ++ hgd-word(s, "choices") ++ " last=#" ++ hgd-word(s, "choicet") ++ " " ++ hgd-choice-body(s, rsp), "plain", agereply);
        def hgd-inside-lane(s, ageout) = tg-lane("inside  ", ("route=" ++ hgd-word(s, "route")) ++ hgd-kvp("floor", hgd-word(s, "floorpos")) ++ hgd-kvp("pos", hgd-word(s, "sesspos")) ++ hgd-kvp("pend", hgd-word(s, "pending")) ++ hgd-kvp("obs", hgd-word(s, "observ")) ++ hgd-kvp("direct", hgd-word(s, "direct")), "dim", ageout);
        def hgd-health-tone(s) = (hgd-int(s, "degraded") + hgd-int(s, "orphans")) > 0 ? "bad" : hgd-int(s, "errs") > 0 ? "warn" : "good";
        def hgd-newest-line(text, marker) = gl-line-of(text, gl-find-last(text, marker));
        def hgd-log-lane(label, text, marker, tone, age) = hgd-log-of(label, hgd-newest-line(text, marker), tone, age);
        def hgd-log-of(label, line, tone, age) = tg-lane(label, (Comparable) str_len(line) == 0 ? "-" : gl-clip(line, 76), (Comparable) str_len(line) == 0 ? "dim" : tone, age);
        def hgd-jit-tone(s) = hgd-int(s, "hot") > 0 ? "warn" : "good";
        // Heat is an observed discovery signal. A native-page count belongs
        // to a birth receipt; it must remain `nothing` until that receipt is
        // carried into the panel rather than being painted as a false zero.
        def hgd-jit-lane(s) = tg-lane("jit     ", "hottest=" ++ hgd-word(s, "hotname") ++ " calls=" ++ hgd-word(s, "hot") ++ " hot-recipes=" ++ hgd-word(s, "hotn") ++ " native-pages=nothing (heat is discovery)", hgd-jit-tone(s), 0 - 1);
        // one read per spool per frame: err/warn take the birth window text by
        // parameter (threaded from hgd-lanes-b); the ledger lands once.
        def hgd-err-lane(out, ageout) = hgd-log-lane("err     ", lms-birth-window(out), lms-mark-diag(), "bad", ageout);
        def hgd-warn-lane(out, ageout) = hgd-log-lane("warn    ", lms-birth-window(out), lms-mark-warn(), "warn", ageout);
        def hgd-events-of(text) = hgd-log-of("events  ", gl-line-of(text, gl-find-last-any(text, lms-mark-events())), "plain", 0 - 1);
        def hgd-events-lane() = hgd-events-of(read_file(hearth-ledger()));
        def hgd-stones-text(t) = t ?? "";
        def hgd-stones-lane() = hgd-stones-of(hgd-stones-text(read_file(hearth-stones())));
        def hgd-stones-of(t) = hgd-log-of("stones  ", int_to_str(gl-count-of(t, "stone=long-walker")) ++ " found; newest: " ++ gl-line-of(t, gl-find-last(t, "stone=long-walker")), "warn", 0 - 1);
        def hgd-health-lane(s, ageout) = tg-lane("health  ", "errs=" ++ hgd-word(s, "errs") ++ " degraded=" ++ hgd-word(s, "degraded") ++ " orphans=" ++ hgd-word(s, "orphans"), hgd-health-tone(s), ageout);

        def hgd-phase-lane(s) = tg-lane("phase   ", gl-phase-line(hgd-int(s, "gas"), hgd-int(s, "water"), hgd-int(s, "ice")), "plain", 0 - 1);
        def hgd-signal-lane(s, agereply) = tg-lane("signal  ", hgd-word(s, "sig") ++ "  choice=" ++ hgd-word(s, "choices") ++ " fail=" ++ hgd-word(s, "fails") ++ " timeout=" ++ hgd-word(s, "touts"), "plain", agereply);
        def hgd-kv-lane(s, kvstate, agereply) = tg-lane("kv      ", ((String) kvstate == "" ? "-" : kvstate) ++ "  ice-miss=" ++ hgd-word(s, "icemiss") ++ " (silence is hit)", "plain", agereply);
        def hgd-field-lane(s) = tg-lane("field   ", "sibling-fkwu=" ++ hgd-word(s, "siblings") ++ "  last-land=" ++ hgd-word(s, "lastland"), "plain", 0 - 1);
        def hgd-doing-lane(sibwork) = tg-lane("doing   ", sibwork, "dim", 0 - 1);
        def hgd-flow-lane(spark) = tg-lane(gl-sym-decode() ++ " flow ", tg-spark(spark), "plain", 0 - 1);
        def hgd-ledger-lane() = tg-lane(gl-sym-served() ++ " ledger ", hearth-ledger(), "plain", 0 - 1);

        // Frame-to-frame state lives in the BML panel vocabulary. Every
        // member is a measured scalar or explicit text; `nothing` never
        // aliases a measured zero such as no new checkpoint.
        def hgd-tick-state-tag() = "hearth-glass-tick-state-v1";
        def hgd-take-spark-n(xs, n) = ((Comparable) n == 0) || ((Comparable) len(xs) == 0) ? list() : cons(head(xs), hgd-take-spark-n(tail(xs), n - 1));
        def hgd-take-spark(xs) = hgd-take-spark-n(xs, 12);
        def hgd-tick-state(s, prev-task, prev-reply, prev-pf, prev-cp, spark, alive) {
            let taskb = hgd-int(s, "taskb");
            let replyb = hgd-int(s, "replyb");
            let pf = hgd-int(s, "pf");
            let cp = hgd-int(s, "cp");
            let kvstate = replyb > prev-reply ? (pf > prev-pf ? "miss" : "hit") : "";
            let spark2 = hgd-take-spark(cons(cp - prev-cp, spark));
            list(hgd-tick-state-tag(), taskb, replyb, pf, cp, kvstate, spark2, alive, hgd-int(s, "lastms"));
        }
        def hgd-tick-state-taskb(state) = state[1];
        def hgd-tick-state-replyb(state) = state[2];
        def hgd-tick-state-pf(state) = state[3];
        def hgd-tick-state-cp(state) = state[4];
        def hgd-tick-state-kv(state) = state[5];
        def hgd-tick-state-spark(state) = state[6];
        def hgd-tick-state-alive(state) = state[7];
        def hgd-tick-state-lastms(state) = state[8];

        // A live glass is a present-tense instrument: each actual tick earns
        // one frame even when its measured sources are unchanged. The frame
        // carries the advancing tick and ages, so suppressing it turns an
        // healthy held field into an indistinguishable silence. Numeric zero
        // means no tick occurred; it is not an absence value.
        def hgd-frame-on-tick?(tick) = tick > 0 ? 1 : 0;

        def hgd-lanes-a(s, tick, ageboard, agetask, agereply, ageout) = list(hgd-head-lane(s, ageboard), hgd-tick-lane(tick), hgd-tasks-lane(s, agetask), hgd-replies-lane(s, agereply), hgd-pf-lane(s, ageout), hgd-cp-lane(s, ageout), hgd-serve-lane(s, agereply), hgd-hopper-lane(s, agetask));
        // the three spools are read ONCE per frame here and travel by
        // parameter into every lane that reads them (same single-read seam as
        // lane-motion's lms-sample-of); stones reads its own file.
        def hgd-lanes-b(s, out, rsp, task, nowms, agetask, agereply, ageout) = list(hgd-kvfill-lane(s, agereply), hgd-tpot-lane(s, agereply), hgd-e2e-lane(s, agereply), hgd-birth-lane(s, ageout), hgd-ask-lane(task, agetask), hgd-reply-lane(rsp, agereply), hgd-flight-lane(s, out, nowms, agetask), hgd-select-lane(s, ageout), hgd-choice-lane(s, rsp, agereply), hgd-inside-lane(s, ageout), hgd-health-lane(s, ageout), hgd-jit-lane(s), hgd-err-lane(out, ageout), hgd-warn-lane(out, ageout), hgd-events-lane(), hgd-stones-lane());
        def hgd-lanes-c(s, kvstate, sibwork, spark, agereply) = list(hgd-phase-lane(s), hgd-signal-lane(s, agereply), hgd-kv-lane(s, kvstate, agereply), hgd-field-lane(s), hgd-doing-lane(sibwork), hgd-flow-lane(spark), hgd-ledger-lane());
        def hgd-lanes-of(s, out, rsp, task, tick, spark, kvstate, sibwork, nowms, ageboard, agetask, agereply, ageout) = append(hgd-lanes-a(s, tick, ageboard, agetask, agereply, ageout), append(hgd-lanes-b(s, out, rsp, task, nowms, agetask, agereply, ageout), hgd-lanes-c(s, kvstate, sibwork, spark, agereply)));
        def hgd-lanes(s, tick, spark, kvstate, sibwork, nowms, ageboard, agetask, agereply, ageout) = hgd-lanes-of(s, lms-out(), lms-rsp(), lms-task(), tick, spark, kvstate, sibwork, nowms, ageboard, agetask, agereply, ageout);
    }
    0;
}
