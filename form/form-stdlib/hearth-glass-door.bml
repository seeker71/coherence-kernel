//////////////////////////////////////////////////////////////////////
//
// hearth-glass-door.bml
//
// Executable BML. The GLASS PANEL COMPOSITION: every lane the living
// dashboard paints, as one lane list folded by the engine. The flesh
// of the conversation is on the panel now, not only its numbers — the
// newest ask and reply as text, the in-flight request with its stage
// phase and age, the newest choice point with its reason, and the
// debugging internals (route, recycle floor vs session position,
// pending, observations). The live door keeps only its tick loop;
// what the panel says is authored here.
//
// preludes: form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/lane-motion.bml
//
// Proven by: form-stdlib/tests/hearth-glass-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormHearthGlassDoor {
        thought glass-door-pattern = list("panel-is-a-lane-list", "conversation-in-the-flesh", "internals-visible", "loop-stays-thin");

        def hgd-int(s, name) = fmv-field(s, name);
        def hgd-word(s, name) = gl-word-field(s, name);
        def hgd-kvp(k, v) = str_concat(" ", str_concat(k, str_concat("=", v)));
        def hgd-turntag(text) = str_concat("#", gl-word-field-last(text, "turn"));

        def hgd-head-lane(s, ageboard) = tg-lane("HEARTH  pid=", str_concat(hgd-word(s, "pid"), if str_eq(hgd-word(s, "alive"), "1") then " standing" else " DOWN"), if str_eq(hgd-word(s, "alive"), "1") then "plain" else "bad", ageboard);
        def hgd-tick-lane(tick) = tg-lane("tick    ", str_concat(int_to_str(tick), str_concat(" ", tg-shade(add(1, mod(tick, 4))))), "plain", sub(0, 1));
        def hgd-tasks-lane(s, agetask) = tg-lane("tasks   ", str_concat(hgd-word(s, "taskb"), " bytes"), "plain", agetask);
        def hgd-replies-lane(s, agereply) = tg-lane("replies ", str_concat(hgd-word(s, "replyb"), " bytes"), "plain", agereply);
        def hgd-pf-lane(s, ageout) = tg-lane(str_concat(gl-sym-prefill(), " prefills "), hgd-word(s, "pf"), "plain", ageout);
        def hgd-cp-lane(s, ageout) = tg-lane(str_concat(gl-sym-decode(), " checkpoints "), hgd-word(s, "cp"), "plain", ageout);
        def hgd-serve-lane(s, agereply) = hgd-serve-of(hgd-int(s, "lastms"), agereply);
        def hgd-serve-of(lastms, agereply) = tg-lane("last-serve ", str_concat(tg-dur(lastms), str_concat(" ", tg-ramp(div(lastms, 1000)))), tg-scale(lastms, hearth-lat-lo(), hearth-lat-hi()), agereply);
        def hgd-hopper-lane(s, agetask) = tg-lane("hopper  ", str_concat("waiting=", hgd-word(s, "hopper")), "plain", agetask);
        def hgd-kvfill-lane(s, agereply) = hgd-kvfill-of(hgd-int(s, "kvpos"), div(mul(hgd-int(s, "kvpos"), 100), hearth-maxpos()), agereply);
        def hgd-kvfill-of(kvpos, kvpct, agereply) = tg-lane("kv-fill ", str_concat(tg-bar(div(add(kvpct, 5), 10), 10), str_concat(" ", str_concat(int_to_str(kvpct), str_concat("% pos=", int_to_str(kvpos))))), tg-scale(kvpct, hearth-fill-lo(), hearth-fill-hi()), agereply);
        def hgd-tpot-lane(s, agereply) = tg-lane("tpot/tok ", tg-dur(hgd-int(s, "tpot")), tg-scale(hgd-int(s, "tpot"), hearth-lat-lo(), hearth-lat-hi()), agereply);
        def hgd-e2e-lane(s, agereply) = tg-lane("e2e p50/p95 ", str_concat(tg-dur(hgd-int(s, "p50")), str_concat("/", tg-dur(hgd-int(s, "p95")))), "plain", agereply);
        def hgd-birth-ms(s, name) = if str_eq(hgd-word(s, name), "nothing") then "nothing" else tg-dur(hgd-int(s, name));
        def hgd-birth-lane(s, ageout) = tg-lane("birth   ", str_concat("cache=", str_concat(hgd-word(s, "bootcache"), str_concat(" ctx=", str_concat(hgd-birth-ms(s, "bootctx"), str_concat(" prog=", str_concat(hgd-birth-ms(s, "bootprog"), str_concat(" setup=", str_concat(hgd-birth-ms(s, "bootsetup"), str_concat(" prefill=", hgd-birth-ms(s, "bootprefill")))))))))), "plain", ageout);

        def hgd-ask-lane(task, agetask) = tg-lane("ask     ", str_concat(hgd-turntag(task), str_concat(" ", gl-clip(gl-line-field-last(task, "task"), 72))), "plain", agetask);
        def hgd-reply-lane(rsp, agereply) = tg-lane("reply   ", str_concat(hgd-turntag(rsp), str_concat(" ", gl-clip(gl-body-after(rsp, lms-mark-response()), 72))), "plain", agereply);
        def hgd-flight-lane(s, out, nowms, agetask) = tg-lane("flight  ", str_concat("waiting:", str_concat(hgd-word(s, "waiting"), str_concat("  served:", str_concat(hgd-word(s, "served"), str_concat("  phase=", str_concat(gl-direct-flight-phase(out), str_concat(" ", tg-dur(gl-direct-flight-age(out, nowms))))))))), "plain", agetask);
        def hgd-choice-body(s, rsp) = if str_eq(gl-word-field-last(rsp, "turn"), hgd-word(s, "choicet")) then gl-clip(gl-body-after(rsp, lms-mark-response()), 56) else "";
        def hgd-choice-lane(s, rsp, agereply) = tg-lane("choice  ", str_concat("n=", str_concat(hgd-word(s, "choices"), str_concat(" last=#", str_concat(hgd-word(s, "choicet"), str_concat(" ", hgd-choice-body(s, rsp)))))), "plain", agereply);
        def hgd-inside-lane(s, ageout) = tg-lane("inside  ", str_concat(str_concat("route=", hgd-word(s, "route")), str_concat(hgd-kvp("floor", hgd-word(s, "floorpos")), str_concat(hgd-kvp("pos", hgd-word(s, "sesspos")), str_concat(hgd-kvp("pend", hgd-word(s, "pending")), str_concat(hgd-kvp("obs", hgd-word(s, "observ")), hgd-kvp("direct", hgd-word(s, "direct"))))))), "dim", ageout);

        def hgd-phase-lane(s) = tg-lane("phase   ", gl-phase-line(hgd-int(s, "gas"), hgd-int(s, "water"), hgd-int(s, "ice")), "plain", sub(0, 1));
        def hgd-signal-lane(s, agereply) = tg-lane("signal  ", str_concat(hgd-word(s, "sig"), str_concat("  choice=", str_concat(hgd-word(s, "choices"), str_concat(" fail=", str_concat(hgd-word(s, "fails"), str_concat(" timeout=", hgd-word(s, "touts"))))))), "plain", agereply);
        def hgd-kv-lane(s, kvstate, agereply) = tg-lane("kv      ", str_concat(if str_eq(kvstate, "") then "-" else kvstate, str_concat("  ice-miss=", str_concat(hgd-word(s, "icemiss"), " (silence is hit)"))), "plain", agereply);
        def hgd-field-lane(s) = tg-lane("field   ", str_concat("sibling-fkwu=", str_concat(hgd-word(s, "siblings"), str_concat("  last-land=", hgd-word(s, "lastland")))), "plain", sub(0, 1));
        def hgd-doing-lane(sibwork) = tg-lane("doing   ", sibwork, "dim", sub(0, 1));
        def hgd-flow-lane(spark) = tg-lane(str_concat(gl-sym-decode(), " flow "), tg-spark(spark), "plain", sub(0, 1));
        def hgd-ledger-lane() = tg-lane(str_concat(gl-sym-served(), " ledger "), hearth-ledger(), "plain", sub(0, 1));

        def hgd-lanes-a(s, tick, ageboard, agetask, agereply, ageout) = list(hgd-head-lane(s, ageboard), hgd-tick-lane(tick), hgd-tasks-lane(s, agetask), hgd-replies-lane(s, agereply), hgd-pf-lane(s, ageout), hgd-cp-lane(s, ageout), hgd-serve-lane(s, agereply), hgd-hopper-lane(s, agetask));
        def hgd-lanes-b(s, nowms, agetask, agereply, ageout) = list(hgd-kvfill-lane(s, agereply), hgd-tpot-lane(s, agereply), hgd-e2e-lane(s, agereply), hgd-birth-lane(s, ageout), hgd-ask-lane(lms-task(), agetask), hgd-reply-lane(lms-rsp(), agereply), hgd-flight-lane(s, lms-out(), nowms, agetask), hgd-choice-lane(s, lms-rsp(), agereply), hgd-inside-lane(s, ageout));
        def hgd-lanes-c(s, kvstate, sibwork, spark, agereply) = list(hgd-phase-lane(s), hgd-signal-lane(s, agereply), hgd-kv-lane(s, kvstate, agereply), hgd-field-lane(s), hgd-doing-lane(sibwork), hgd-flow-lane(spark), hgd-ledger-lane());
        def hgd-lanes(s, tick, spark, kvstate, sibwork, nowms, ageboard, agetask, agereply, ageout) = append(hgd-lanes-a(s, tick, ageboard, agetask, agereply, ageout), append(hgd-lanes-b(s, nowms, agetask, agereply, ageout), hgd-lanes-c(s, kvstate, sibwork, spark, agereply)));
    }
    0;
}
