; living-world-concept-application.fk -- a learned path derives in public.
;
; Applying a consented chain is a third boundary: permission to hold either
; lens and permission to compose them do not grant permission to transform a
; new input.  The derivation retains input, bridge, output, both signatures,
; uncertainty, attribution witnesses, and a local path.  Chain holders and the
; input holder must unanimously acknowledge before the application is admitted.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk

(let LWCX-DERIVATION         (bp "LWCX-DERIVATION"))
(let LWCX-APPLICATION        (bp "LWCX-APPLICATION"))
(let LWCX-APPLICATION-ORIGIN (bp "LWCX-APPLICATION-ORIGIN"))

; children: chain, input, bridge, output, local path
(defn lwcx-derivation (chain input bridge output)
    (intern_node LWCX-DERIVATION
        (list chain input bridge output (lwo-local-path))))
(defn lwcx-derivation? (cell) (lwo-category? cell LWCX-DERIVATION))
(defn lwcx-derivation-chain (derivation) (nth (node_children derivation) 0))
(defn lwcx-derivation-input (derivation) (nth (node_children derivation) 1))
(defn lwcx-derivation-bridge (derivation) (nth (node_children derivation) 2))
(defn lwcx-derivation-output (derivation) (nth (node_children derivation) 3))
(defn lwcx-derivation-path (derivation) (nth (node_children derivation) 4))

(defn lwcx-derive-chain (chain input)
    (do
        (let bridge
            (lwrr-apply-signature
                (lwcx-chain-first-signature chain) input))
        (if (node_eq bridge (lwo-none)) (lwo-none)
            (do
                (let output
                    (lwrr-apply-signature
                        (lwcx-chain-second-signature chain) bridge))
                (if (node_eq output (lwo-none)) (lwo-none)
                    (lwcx-derivation chain input bridge output))))))

; children: chain candidate, derivation, chain attributions, input
;           attributions, both component lifecycle states
(defn lwcx-application
    (chain-candidate derivation chain-attributions input-attributions
     first-state second-state)
    (intern_node LWCX-APPLICATION
        (list chain-candidate derivation chain-attributions input-attributions
              first-state second-state)))
(defn lwcx-application? (cell) (lwo-category? cell LWCX-APPLICATION))
(defn lwcx-application-chain-candidate (application)
    (nth (node_children application) 0))
(defn lwcx-application-derivation (application)
    (nth (node_children application) 1))
(defn lwcx-application-chain-attributions (application)
    (nth (node_children application) 2))
(defn lwcx-application-input-attributions (application)
    (nth (node_children application) 3))
(defn lwcx-application-first-state (application)
    (nth (node_children application) 4))
(defn lwcx-application-second-state (application)
    (nth (node_children application) 5))

(defn lwcx-application-witnesses
    (chain-attributions input-attributions)
    (lwr-field-union-items
        (lwo-field-items input-attributions) chain-attributions))

(defn lwcx-application-origin (application witnesses)
    (intern_node LWCX-APPLICATION-ORIGIN
        (list application witnesses)))

(defn lwcx-application-candidate
    (world chain-candidate input derivation)
    (do
        (let chain (lwo-emergent-shape chain-candidate))
        (let chain-attributions
            (lwo-active-attributions-for world chain-candidate))
        (let input-attributions
            (lwo-active-attributions-for world input))
        (let witnesses
            (lwcx-application-witnesses
                chain-attributions input-attributions))
        (let application
            (lwcx-application chain-candidate derivation
                chain-attributions input-attributions
                (lwrl-state world (lwcx-chain-first-candidate chain))
                (lwrl-state world (lwcx-chain-second-candidate chain))))
        (let origin (lwcx-application-origin application witnesses))
        (lwo-emergent application witnesses
            (intern_trivial_int (lwo-emergent-coherence chain-candidate))
            (intern_trivial_int 2)
            (intern_trivial_int (lwo-field-size witnesses)) origin)))

(defn lwcx-application-proposal (world chain-candidate input)
    (if (or (eq (lwcx-chain-steady? world chain-candidate) 0)
            (eq (lwo-active? world input) 0))
        (lwo-none)
        (do
            (let chain (lwo-emergent-shape chain-candidate))
            (let derivation (lwcx-derive-chain chain input))
            (if (node_eq derivation (lwo-none)) (lwo-none)
                (do
                    (let candidate
                        (lwcx-application-candidate
                            world chain-candidate input derivation))
                    (lwt-proposal candidate
                        (lwt-sources-from-attributions
                            (lwo-field-items
                                (lwo-emergent-witnesses candidate))
                            (lwo-empty-field))
                        (lwo-emergent-provenance candidate)))))))

(defn lwcx-application-round (world chain-candidate input prior)
    (do
        (let proposal
            (lwcx-application-proposal world chain-candidate input))
        (lwt-round world
            (if (node_eq proposal (lwo-none))
                (lwo-empty-field)
                (lwo-field-add (lwo-empty-field) proposal))
            (lwo-empty-field) prior)))

(defn lwcx-application-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwcx-application?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwcx-integrate-application (round proposal action)
    (do
        (let candidate (lwt-proposal-candidate proposal))
        (if (eq (lwcx-application-candidate? candidate) 0)
            (lwt-round (lwt-round-world round) (lwt-round-proposals round)
                       (lwo-empty-field) round)
            (do
                (let application (lwo-emergent-shape candidate))
                (if (eq (lwcx-chain-steady? (lwt-round-world round)
                            (lwcx-application-chain-candidate application)) 0)
                    (lwt-round (lwt-round-world round)
                               (lwt-round-proposals round)
                               (lwo-field-add (lwo-empty-field)
                                   (lwt-evaluate-proposal
                                       (lwt-round-world round) proposal))
                               round)
                    (lwt-integrate round proposal action))))))
