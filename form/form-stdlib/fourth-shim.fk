// fourth-shim.fk — the flattener's standing prelude: core.fk vocabulary a
// band reaches without declaring, expressed first-order in the flattener's
// own surface (defn/if/let, the op rows, the lowerings). The flattener
// prepends THIS source to every band's source list, so a call to nil? or
// sum resolves to a function-table row exactly like any module defn — and
// a band that defines its own version shadows the shim by parse order.
//
import form-stdlib/form-ontology-bp.fk;
//
// A PRESENT NATIVE ANSWERS ITS NAME. A definition here stands in only where no native carries
// the name; where one does, this body never runs.
// (`pow` has no fkwu native, so fkwu runs the Form one there by absence.)
//
// Where these bodies do run, ten of them answer differently from the native they stand in for
// (sized 2026-07-26 on the since-retired Go kernel, each name run once with core.fk alone and
// once with this cell added):
//
//   name               native          this body
//   record_get         41              0
//   record_has         1               0
//   record_keys        2               0
//   record?            1               0
//   record_blueprint   1               crash (node_eq)
//   _len               3               crash (str_eq)
//   _dict_get          null            a node
//   _dict_has          false           0
//   float_value        crash           a different crash
//   make_float32       @1.1.6.1065353216   @1.1.7.1
//
//   agreeing (9): abs · sum · substring · int_to_str · str_to_int · str_find · intern_node_at ·
//                 _dict_new · make_float64
//
// The record family is the sharp one: it does not crash, it answers **0**. A wrong answer is worse
// than a dead one, and a lane that lacks these natives and runs this cell inherits it.
//
// WHERE IT REACHES. Cells name this file in a preludes line, and bands reach it through
// those cells. This cell's home is
// FOURTH_CHAIN, where the flattener prepends it, and that lane is not measured here.
//
// Two lanes live here:
//   · core mirrors — nil?/sum/append/abs/min2/max2/range/take/drop/
//     reverse/maximum/minimum/product, each the first-order image of the
//     core.fk definition
//   · higher-order core — map/filter/foldl/foldr (and the even?/odd?/zero?
//     predicates they pair with), the EXACT generic recipes core.fk runs on
//     fkwu. A function name in argument position
//     lowers to a function-ref value (flt-fref: cons of (fn-index, arity)),
//     and the combinator's call to its function PARAMETER lowers to an
//     indirect call (tag 44) that reads (fn-index, arity) and dispatches —
//     arity 1 reads the single arg, arity ≥ 2 rides the packed-args list
//     like a direct call. No defunctionalization, no per-call-site monomorph;
//     one engine carries the function-value through map/filter's forward
//     recursion and foldl's two-arg step.
//   · string stones — substring/int_to_str/str_to_int/str_find composed
//     from char_at (the BYTE2S∘SCHAR lowering), str_concat, and ord:
//     tags 24..29 carry every byte; these recipes carry the shapes
//
// The shim is part of FOURTH_CHAIN: its content hashes into every cached
// table, so a shim change re-flattens exactly what it touches.
section [form.bml] {
    def nil?(xs) = (Comparable) xs == [];
    def plus(a, b) = (Number) a + (Number) b;
    def minus(a, b) = a - b;
    def times(a, b) = a * b;
    def divide(a, b) = a / b;
    def identity(x) = x;
    def positive?(n) = n > 0;
    def negative?(n) = n < 0;
    def cell(kind, value, origin, inverse) = ["cell", kind, value, origin, inverse];
    // value_eq, not str_eq: `c`'s head is caller-shaped, not guaranteed to
    // be a string (a plain list's head can be any value) -- str_eq PANICS
    // on a non-string arg ("expected str"), where value_eq
    // is total across value kinds and answers false on a kind mismatch
    // instead of crashing. Same fix as _len below, same root cause.
    def cell?(c) = len(c) > 0 && (Value) c[0] == "cell";
    def cell-kind(c) = c[1:][0];
    def cell-value(c) = c[1:][1:][0];
    def cell-origin(c) = c[1:][1:][1:][0];
    def cell-inverse(c) = c[1:][1:][1:][1:][0];
    def cell-undo(c) = {
        let inverse = cell-inverse(c);
        inverse(c);
    };
    def cell-do(c) = cell-value(c);
    def task-undo(t) = cell-origin(t);
    def task-cell(state, value, cont, origin, inverse) = cell("task", [state, value, cont], origin, inverse);
    def task?(t) = cell?(t) && (String) cell-kind(t) == "task";
    def task-state(t) = cell-value(t)[0];
    def task-value(t) = cell-value(t)[1];
    def task-cont(t) = cell-value(t)[2];
    def task-pending(origin, cont) = task-cell("pending", [], cont, origin, task-undo);
    def task-resolved(value) = task-cell("resolved", value, identity, [], task-undo);
    def task-failed(failure) = task-cell("failed", failure, identity, [], task-undo);
    def task-resolve(t, value) = task-cell("resolved", value, task-cont(t), cell-origin(t), cell-inverse(t));
    def task-reject(t, failure) = task-cell("failed", failure, task-cont(t), cell-origin(t), cell-inverse(t));
    def task-await(t) = (String) task-state(t) == "resolved" ? task-value(t) : t;
    def task-step(t) = (String) task-state(t) == "resolved" ? {
        let cont = task-cont(t);
        cont(task-value(t));
    } : t;
    def task-ready?(t) = (String) task-state(t) == "resolved";
    def task-failed?(t) = (String) task-state(t) == "failed";
    def abs(n) = n < 0 ? 0 - n : n;
    def min2(a, b) = a < b ? a : b;
    def max2(a, b) = a > b ? a : b;
    def sum(xs) = nil?(xs) ? 0 : (Number) xs[0] + (Number) sum(xs[1:]);
    def product(xs) = nil?(xs) ? 1 : xs[0] * product(xs[1:]);
    def maximum(xs) = nil?(xs[1:]) ? xs[0] : max2(xs[0], maximum(xs[1:]));
    def minimum(xs) = nil?(xs[1:]) ? xs[0] : min2(xs[0], minimum(xs[1:]));
    def append(xs, ys) = nil?(xs) ? ys : cons(xs[0], append(xs[1:], ys));
    // ── higher-order core (function-as-argument, indirect call tag 44) ──
    // The same generic recipes as core.fk's map/filter/foldl/foldr. The
    // function parameter (f/pred) arrives as a function-ref value; the body's
    // (f ...) / (pred ...) calls lower to indirect calls the walker dispatches.
    def even?(n) = (Comparable) (n % 2) == 0;
    def odd?(n) = (Comparable) (n % 2) == 1;
    def zero?(n) = (Comparable) n == 0;
    def any?(pred, xs) = nil?(xs) ? false : pred(xs[0]) ? true : any?(pred, xs[1:]);
    def all?(pred, xs) = nil?(xs) ? true : pred(xs[0]) ? all?(pred, xs[1:]) : false;
    def map(f, xs) = nil?(xs) ? [] : cons(f(xs[0]), map(f, xs[1:]));
    def filter(pred, xs) = nil?(xs) ? [] : pred(xs[0]) ? cons(xs[0], filter(pred, xs[1:])) : filter(pred, xs[1:]);
    def foldl(f, init, xs) = nil?(xs) ? init : foldl(f, f(init, xs[0]), xs[1:]);
    def foldr(f, init, xs) = nil?(xs) ? init : f(xs[0], foldr(f, init, xs[1:]));
    def range(start, end) = start >= end ? [] : cons(start, (Number) start + (Number) 1 .. end);
    def take(n, xs) = n <= 0 || nil?(xs) ? [] : cons(xs[0], take(n - 1, xs[1:]));
    def drop(n, xs) = n <= 0 ? xs : nil?(xs) ? [] : drop(n - 1, xs[1:]);
    def fourth-rev2(xs, acc) = nil?(xs) ? acc : fourth-rev2(xs[1:], cons(xs[0], acc));
    def reverse(xs) = fourth-rev2(xs, []);
    // char_at belongs to the "string stones" family named above -- the
    // BYTE2S∘SCHAR lowering, str_byte_at composed with byte_to_str -- but was
    // never actually given its own defn here, only assumed. Every other
    // stone (substring, int_to_str, str_to_int, str_find) calls it, and
    // core.fk's OWN char_at is `(substring s i (add i 1))` -- so as long as
    // this shim leaves char_at unshadowed, shadowing substring alone turns
    // every one of those callers into a cycle through core.fk's char_at back
    // into THIS substring, with no base case (found via fkwu's
    // honest eval-depth wall: a JSON emitter band + this shim blew a
    // 256MB, then 1GB, walker stack). Defining char_at here, from the same
    // primitives the design comment already names for it, closes the family
    // instead of patching the one call site that happened to be reached.
    def char_at(s, i) = byte_to_str(str_byte_at(s, i));
    def substring(s, a, b) = a >= b ? "" : a >= len(s) ? "" : ((String) char_at(s, a) + substring(s, (Number) a + (Number) 1, b));
    def fourth-i2s-pos(n) = (Comparable) n == 0 ? "" : ((String) fourth-i2s-pos(n / 10) + byte_to_str((Number) 48 + (Number) (n % 10)));
    def int_to_str(n) = (Comparable) n == 0 ? "0" : n < 0 ? ("-" + fourth-i2s-pos(0 - n)) : fourth-i2s-pos(n);
    def fourth-s2i-digits(s, i, acc) = i >= len(s) ? acc : fourth-s2i-digits(s, (Number) i + (Number) 1, (Number) (acc * 10) + (Number) (ord(char_at(s, i)) - 48));
    def fourth-s2i-ok(s, i) = i >= len(s) ? 1 : ord(char_at(s, i)) < 48 ? 0 : ord(char_at(s, i)) > 57 ? 0 : fourth-s2i-ok(s, (Number) i + (Number) 1);
    def fourth-s2i-body(s) = (Comparable) fourth-s2i-ok(s, 0) == 0 ? 0 : fourth-s2i-digits(s, 0, 0);
    def str_to_int(s) = (Comparable) len(s) == 0 ? 0 : (String) char_at(s, 0) == "-" ? (Comparable) fourth-s2i-ok(s, 1) == 0 ? 0 : len(s) <= 1 ? 0 : 0 - fourth-s2i-digits(substring(s, 1, len(s)), 0, 0) : fourth-s2i-body(s);
    def fourth-sf-at(s, needle, i) = (Number) i + (Number) len(needle) > len(s) ? 0 - 1 : (String) substring(s, i, (Number) i + (Number) len(needle)) == needle ? i : fourth-sf-at(s, needle, (Number) i + (Number) 1);
    def str_find(s, needle, from) = from > len(s) ? 0 - 1 : fourth-sf-at(s, needle, max2(from, 0));
    // float_to_str — first-order image of the core.fk definition (fixed 6
    // fractional digits, trailing zeros trimmed, decimal notation only).
    // Without this mirror a band's float_to_str call is UNBOUND on the fourth
    // arm and lowers numb — the call returns pool string 0 ("cell") instead of
    // failing loud, so json-emitter's `1.25` emitted as `cell` (same length,
    // verdict 31 -> 6). Core binds `scaled` once with let; this image passes it
    // through helper arguments instead, keeping the shim let-free.
    def fourth-f2s-pad6(s) = len(s) >= 6 ? s : fourth-f2s-pad6(("0" + s));
    def fourth-f2s-trimz(s) = (Comparable) len(s) == 0 ? s : (String) substring(s, len(s) - 1, len(s)) == "0" ? fourth-f2s-trimz(substring(s, 0, len(s) - 1)) : s;
    def fourth-f2s-join(ip, frac) = (Comparable) len(frac) == 0 ? int_to_str(ip) : (int_to_str(ip) + ("." + frac));
    def fourth-f2s-split(scaled) = fourth-f2s-join(scaled / 1000000, fourth-f2s-trimz(fourth-f2s-pad6(int_to_str(scaled % 1000000))));
    // the same range split core.fk carries, because these two are one printer in
    // two places and a mirror that drifts is worse than no mirror
    // (core.fk fstr-abs; corpus row 1418 printpast)
    def fourth-f2s-six(af) = fourth-f2s-split(float_to_int((Number) 0.5 + (Number) (af * 1000000)));
    def fourth-f2s-sci-exp(x, e) = x < 10.0 ? e : fourth-f2s-sci-exp(x / 10.0, (Number) e + (Number) 1);
    def fourth-f2s-sci-man(x) = x < 10.0 ? x : fourth-f2s-sci-man(x / 10.0);
    def fourth-f2s-abs(af) = af < 9000000000000.0 ? fourth-f2s-six(af) : af < 9000000000000000000.0 ? int_to_str(float_to_int(af)) : (fourth-f2s-six(fourth-f2s-sci-man(af)) + ("e" + int_to_str(fourth-f2s-sci-exp(af, 0))));
    def float_to_str(f) = f < 0 ? ("-" + fourth-f2s-abs(0 - f)) : fourth-f2s-abs(f);
    // Fallback record helpers for list-backed packets. Current
    // record calls lower to native tags in form-flatten.fk; these keep the shim
    // first-order when a source explicitly treats a packet as a list.
    def record_get(rec, field) = nil?(rec) ? 0 : (String) rec[0][0] == field ? rec[0][1:][0] : record_get(rec[1:], field);
    def record_has(rec, field) = nil?(rec) ? 0 : (String) rec[0][0] == field ? 1 : record_has(rec[1:], field);
    def record_keys(rec) = nil?(rec) ? [] : (Comparable) rec[0][0] == 0 - 1 ? record_keys(rec[1:]) : cons(rec[0][0], record_keys(rec[1:]));
    def record?(rec) = len(rec) > 0 && (Comparable) rec[0][0] == 0 - 1;
    def record_blueprint(rec) = record?(rec) ? rec[0][1:][0] : 0;
    // intern_node_at — the content-addressed intern PLUS source attribution.
    // The returned NodeID is exactly intern_node(cat, kids); file/line/col now
    // feed a real framebuffer on fkwu. fb_record (tag 128, a tri so
    // its args ride the row slots with no arena allocation) records (file line col)
    // into fkwu's per-node attribution map, appends the node to the ordered roots
    // list, and returns the node UNCHANGED — so the verdict is identical to the old
    // carried-intern image, while framebuffer-events (129) and node_source (130)
    // now read the trace back. line+col ride one int
    // (line<<16 | col); node_source splits them apart again.
    def intern_node_at(cat, kids, file, line, col) = fb_record(intern_node(cat, kids), file, (Number) (line * 65536) + (Number) col);
    // ── null + dict mirrors — the value-null model on fkwu ──
    // fkwu has no host-null in its value ABI, so null is carried STRUCTURALLY: a
    // reserved blueprint node (VALUE-NONE) is the absent/None value, and node_eq
    // (a structural primitive) tests for it — never nil?/len, which
    // collapse int/string/empty in fkwu's scalar region. _dict_get on a miss
    // answers VALUE-NONE, which json-node-null-value? (json.fk) tests with value_eq. The
    // dict is the "__dict__"-marked cons-list the kernels and fkwu's _get share.
    // fol-bp, not bp (json.fk:449 names this exact convention): "VALUE-NONE"
    // is a kernel-unowned blueprint row, and `bp` is a name fkwu owns
    // natively with its own resolution -- so `bp` can answer a different node
    // than `fol-bp`, while `fol-bp` is the one row. json-node-null-value?
    // compares a _dict_get miss against `(fol-bp "VALUE-NONE")` directly;
    // answering `(bp "VALUE-NONE")` here produced a DIFFERENT node, so that
    // comparison silently failed and every "should be JSON null" field
    // rendered as the literal string "VALUE-NONE" instead (found via a JSON
    // emitter band: it read 30 where 31 was meant, one bit short).
    def value-none() = fol-bp("VALUE-NONE");
    def _dict_new() = cons("__dict__", []);
    def _dict-scan(xs, k) = nil?(xs) ? value-none() : (String) xs[0] == k ? xs[1:][0] : _dict-scan(xs[1:][1:], k);
    def _dict_get(d, k) = _dict-scan(d[1:], k);
    def _dict_has(d, k) = node_eq(_dict_get(d, k), value-none()) ? 0 : 1;
    // _len — the python-adapter's polymorphic length: dict PAIRS, else len.
    // The kernel `len` is an HONEST cell count everywhere (a marker-headed
    // plain list — e.g. the flatten pool's suffix at the interned "__dict__"
    // literal — must never lie about its length); only _len reads the dict
    // tag. The head test mirrors cell?. fkwu's scalar region has no
    // list/string discriminator, so this image covers the list-shaped values
    // the underscore family carries.
    // value_eq, not str_eq: `x`'s head is caller-shaped -- a plain list's
    // head (e.g. `(list 1 2 3)`, exactly what the flatten-pool marker
    // probe uses) is an int, not a string, and str_eq PANICS on a
    // non-string arg instead of answering false ("expected str, got int" --
    // found by actually running this band with the shim preluded, not by
    // inspection). value_eq is
    // total across value kinds: a kind mismatch answers false, same as any
    // other "no" here, so the dict-tag check is now safe for every shape
    // _len is asked to measure.
    def _len(x) = len(x) > 0 && (Value) x[0] == "__dict__" ? (len(x) - 1) / 2 : len(x);
    // ── float-NodeID construct + read-back — the image of the host-float ABI on fkwu ──
    // fkwu has no host-float value, but it DOES box doubles (fk_fbox) and store the boxed value in a
    // type-7 trivial-float node's fk_nval (intern_trivial_float, tag 113). So the faithful image is:
    //   make_float64 x  = intern the float's text as a trivial-float node (int_to_str renders a boxed
    //                     float as %.15g, the same surface the json codec uses); same value → node_eq
    //                     by VALUE now that fk_neq decodes type-6/7 leaves (mirrors `eq`).
    //   float_value n   = node_value n — fk_nval IS the boxed float, ready for float arithmetic.
    // A grammar's float vector builds and compares the same way.
    def float_value(n) = node_value(n);
    def make_float64(x) = intern_trivial_float(int_to_str(x));
    def make_float32(x) = intern_trivial_float(int_to_str(x));
    0;
}
