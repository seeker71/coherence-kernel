    }
    def pifbc-project-v9(projection,artifact,mtime) = !record?(projection) ? record_new(0,"status","refused","reason","projection-required","bytes",nothing())
        : record_get(projection,"kind") != "program-image-static-projection" || record_get(projection,"status") != "projected"
            ? record_new(0,"status","refused","reason","projection-required","bytes",nothing()) : {
        let catalog = record_get(projection,"catalog"); let units = record_get(projection,"units");
        let source = pifbc-v9-root-path(units,record_get(catalog,"root_unit"));
        nothing?(source) || !pifbc-proj-string?(artifact) || !pifbc-proj-int?(mtime) ? record_new(0,"status","refused","reason","image-location-unavailable","bytes",nothing())
        : len(artifact) == 0 || mtime < 1 ? record_new(0,"status","refused","reason","image-location-unavailable","bytes",nothing()) : {
            let owners = record_new(0); units |> map(u => record_set(owners,u[0].str(),pifbc-v9-unit-id(u[1])));
            let roots = record_get(projection,"roots"); let functions = record_get(projection,"functions");
            let nodes = record_get(projection,"nodes"); let strings = record_get(projection,"strings");
            let symbols = record_get(projection,"symbols"); let constants = record_get(projection,"constants");
            let state = record_new(0,"next",0);
            let exports = symbols |> map(row => pifbc-v9-symbol(state,owners,row));
            let header = pifbc-v8-byte-string(pifbc-magic()) + pifbc-v8-u32(9) + pifbc-v8-string(record_get(catalog,"builder"))
                + pifbc-v8-string(source) + pifbc-v8-string(record_get(catalog,"closure")) + pifbc-v8-int(mtime) + pifbc-v8-string(artifact)
                + pifbc-v8-int(1) + pifbc-v8-int(0) + pifbc-v8-int(0);
            let payload = pifbc-v8-join([header,pifbc-v8-int(len(roots)),pifbc-v8-join(roots |> map(root => pifbc-v8-int(root))),
                pifbc-v8-int(0) + pifbc-v8-int(0) + pifbc-v8-int(-1),pifbc-v8-join(functions |> map(fn => pifbc-v8-int(fn[2]) + pifbc-v8-int(fn[3]) + pifbc-v8-int(fn[4]))),
                pifbc-v8-int(len(nodes)),pifbc-v8-join(nodes |> map(row => pifbc-v8-row(row[0],row[1],row[2],row[3]))),
                pifbc-v8-int(len(strings)),pifbc-v8-join(strings |> map(value => pifbc-v8-string(value))),pifbc-v8-int(len(symbols)),pifbc-v8-join(exports),
                // V9 permits no node-symbol rows. Native loaders discard that
                // derived inspection data; AST, roots and exports own it.
