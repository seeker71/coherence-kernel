    // The projected rows are the program image. Function bodies are the
    // table's roots. Strings are the table's byte rows. Process ids are gone.
    def pifbc-byte-rows(rows) = nil?(rows) ? [] : cons(sai-string-bytes(rows[0]), pifbc-byte-rows(rows[1:]));
    def pifbc-fn-bodies(fns) = nil?(fns) ? [] : cons(fns[0][1], pifbc-fn-bodies(fns[1:]));
    def pifbc-projection-table(proj) = if (record?(proj) && record_get(proj, "status") == "projected") then pif-table-image-from-parts(pifbc-fn-bodies(record_get(proj, "functions")), record_get(proj, "nodes"), pifbc-byte-rows(record_get(proj, "strings"))) else nothing();
    def pifbc-projection-envelope(table, path) {
        let draft = pif-envelope(path, path, 0, path, path, 0, 1, table);
