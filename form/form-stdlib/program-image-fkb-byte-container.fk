        nothing?(table) ? nothing() : pifbc-container-from-envelope(pifbc-projection-envelope(table, path));
    }
    def pifbc-project-admitted(fn) {
        let pid = host_pid(); let catalog = kernel_ast(pid,["catalog",fn]);
        let projected=pifbc-project(catalog,selection => pifbc-proj-int?(selection) ? kernel_ast(pid,selection)
            : selection[0] == "catalog" ? kernel_ast(pid,["catalog",fn])
            : selection[0] == "function" ? kernel_ast(pid,["fnmeta",selection[1]])
            : selection[0] == "literal" ? kernel_ast(pid,["str",selection[1]]) : nothing());
        if record_get(projected,"reason")=="projection-unknown-node-tag" then record_set(projected,"diagnostic",kernel_ast(pid,["diagnostic",record_get(projected,"detail")[0]])) else 0;
