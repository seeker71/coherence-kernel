    }


    // Native v9 serialization of the graph already checked by pifbc-project.
    // This does not attach a live image owner or reconstruct retained effects.
    // V9 carries one catalog identity and its unit sequences; foreign function
    // identities and completed effects outside that catalog are not transported.
    // C's unit ID is FNV64(canonicalPath) >> 1. Shift bytes so all 63 bits
    // survive Form's narrower tagged integer lane.
    def pifbc-v9-half(bytes,carry) = nil?(bytes) ? "" : byte_to_str(head(bytes) / 2 + carry * 128) + pifbc-v9-half(tail(bytes),head(bytes) % 2);
    def pifbc-v9-unit-id(path) = byte_to_str(0) + pifbc-v9-half(hex-decode(bml-source-fingerprint(path)),0);
    def pifbc-v9-root-path(units,id) = nil?(units) ? nothing() : head(units)[0] == id ? head(units)[1] : pifbc-v9-root-path(tail(units),id);
    def pifbc-v9-symbol(state,owners,row) {
        let i = record_get(state,"next"); record_set(state,"next",i + 1);
