                pifbc-v8-int(len(constants)),pifbc-v8-join(constants |> map(c => pifbc-v8-string(c[0]) + pifbc-v8-int(c[1]))),
                pifbc-v8-int(len(units)),pifbc-v8-join(pifbc-proj-order(units,[]) |> map(u => record_get(owners,u[0].str()) + pifbc-v8-int(u[2]))),
                pifbc-v8-int(len(constants)),pifbc-v8-join(constants |> map(c => record_get(owners,c[2].str())))]);
            record_new(0,"kind","program-image-native-container","scope","static-graph-transport","status","ready","reason","","bytes",pifbc-v8-seal(payload),"unit_ids",owners);
        };
    };
}
