// program-image-fkb-byte-container.fk -- canonical bytes for program-image fkb payloads.
//
// Layer 8h4 extends the program-image artifact contract with a deterministic
// byte container. It consumes a valid 8h program-image envelope, encodes the
// source identity and table payload into bytes, and vouches the resulting bytes
// against the envelope's declared content hash.
//
// This is not the dormant Form recipe-binary format and not a runtime cache
// loader. It does not read or write files, parse table text, walk a program
// image, install a selector, produce attempts, or grow the C seed.
//
// Byte format:
//   magic:        46 4b 50 49 46 42 31 00  ; "FKPIFB1\0"
//   version:      u32 big-endian, currently 5 (4 added no builder identity)
//   string:       u32 byte-length + raw bytes
//   signed int:   sign byte 0/1 + hi u32 + lo u32 big-endian magnitude.
//                 The v4 wire lane carries magnitudes up to 2^63-1 so
//                 full-range u32 literals (e.g. cksum values) are encodable;
//                 this body encodes what its own native ints can round-trip:
//                 [-4611686018427387903, 4611686018427387903] (2^62-1)
//   payload:      magic version
//                 builder-id source-path source-hash source-mtime
//                 artifact-path seal-ok
//                 nf fn-roots nr node-rowsx4 ns string-byte-rows
//                 symbol-count symbol-rows node-symbol-count node-symbol-rows
//                 where each node-symbol-row carries dependency target pairs:
//                 dep-count (dep-symbol-id target-node-id)*
//
// The envelope API writes version 5. The ordinary seed image is version 9:
// it also carries refusal state, constant/unit ownership and a trailing FNV
// checksum. The v8 raw-span helpers below preserve that owning image while
// encoding only a proven immutable initializer; they do not mint a new builder
// identity or serialize unrelated runtime state.
//
// `content-hash` and `artifact-mtime` are descriptor/probe metadata, not
// hash-covered payload fields.
//
import form-stdlib/core.fk;
import form-stdlib/str-byte-at.fk;
import form-stdlib/sha256.fk;
import form-stdlib/hex.fk;
import form-stdlib/form-fs.fk;
import form-stdlib/source-artifact-cache.fk;
import form-stdlib/source-artifact-descriptor.fk;
import form-stdlib/runtime-artifact-plan.fk;
import form-stdlib/source-artifact-probe.fk;
import form-stdlib/source-artifact-identity.fk;
import form-stdlib/program-image-fkb.fk;
import form-stdlib/bml-source.fk;
import form-stdlib/bml/body-fingerprint.bml;
import flatten/form-flatten.fk;
section [form.bml] {
    def pifbc-version() = "program-image-fkb-byte-container-v5";
    def pifbc-byte-version() = 5;
    // This native container writer has its own identity. The seed's writer
    // identifies its admitted executable; neither accepts the other's image.
    def pifbc-builder-id() = "form-program-image-fkb-byte-container-v5";
    def pifbc-max-signed() = 4611686018427387903;
    def pifbc-u32-radix() = 4294967296;
    def pifbc-magic() = [70, 75, 80, 73, 70, 66, 49, 0];
    def pifbc-feature(name, status) = ["program-image-fkb-byte-container-feature", name, status];
    def pifbc-feature-name(f) = f[1];
    def pifbc-feature-status(f) = f[2];
    def program-image-fkb-byte-container-manifest() = [pifbc-feature("pure-deterministic-byte-container", 1), pifbc-feature("consumes-valid-pif-envelope", 1), pifbc-feature("magic-version-pinned", 1), pifbc-feature("length-prefixed-strings", 1), pifbc-feature("signed-int64ish-big-endian", 1), pifbc-feature("table-section-order-pinned", 1), pifbc-feature("symbol-section-order-pinned", 1), pifbc-feature("symbol-dependencies-hash-covered", 1), pifbc-feature("symbol-dependency-targets-hash-covered", 1), pifbc-feature("content-hash-excluded-from-payload", 1), pifbc-feature("artifact-mtime-excluded-from-payload", 1), pifbc-feature("content-vouch-over-payload-bytes", 1), pifbc-feature("hash-mismatch-investigates", 1), pifbc-feature("out-of-range-refuses-container", 1), pifbc-feature("no-disk-io", 1), pifbc-feature("no-form-binary-io", 1), pifbc-feature("no-whole-file-byte-io", 1), pifbc-feature("no-table-text-bridge", 1), pifbc-feature("no-program-image-load", 1), pifbc-feature("no-attempt-observation", 1), pifbc-feature("no-selector-install", 1), pifbc-feature("no-c-seed-growth", 1)];
    def program-image-fkb-byte-container-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) pifbc-feature-name(fs[0]) == name && (Comparable) pifbc-feature-status(fs[0]) == 1 ? 1 : program-image-fkb-byte-container-manifest-has?(name, fs[1:]);
    def pifbc-status-ready() = "byte-container-ready";
    def pifbc-status-investigate() = "investigate";
    def pifbc-status-refused() = "refused";
    def pifbc-reason-ready() = "byte-container-ready";
    def pifbc-reason-malformed-envelope() = "malformed-pif-envelope";
    def pifbc-reason-invalid-envelope() = "invalid-pif-envelope";
    def pifbc-reason-non-encodable-metadata() = "non-encodable-metadata";
    def pifbc-reason-non-encodable-table() = "non-encodable-table";
    def pifbc-reason-non-encodable-symbols() = "non-encodable-symbols";
    def pifbc-reason-content-hash-malformed() = "content-hash-malformed";
    def pifbc-reason-content-hash-mismatch() = "content-hash-mismatch";
    def pifbc-byte?(b) = b >= 0 ? b <= 255 ? 1 : 0 : 0;
    def pifbc-signed-ok?(n) =     // magnitude test via the abs sign: the one native value whose magnitude
    // overflows (min-int) wraps negative under abs and is refused here; a
    // direct (ge n (sub 0 max)) cannot see it -- comparisons of two huge
    // nearby ints round through doubles and report min-int equal to -max
pifbc-abs(n) >= 0 ? pifbc-abs(n) <= pifbc-max-signed() : 0;
    def pifbc-unsigned-ok?(n) = n >= 0 ? n <= pifbc-max-signed() : 0;
    def pifbc-abs(n) = n < 0 ? 0 - n : n;
    def pifbc-signed-magnitude-bytes(mag) = append-list(u32-to-bytes(mag / pifbc-u32-radix()), u32-to-bytes(mag % pifbc-u32-radix()));
    def pifbc-signed-bytes(n) = n < 0 ? append-list([1], pifbc-signed-magnitude-bytes(pifbc-abs(n))) : append-list([0], pifbc-signed-magnitude-bytes(n));
    def pifbc-string-bytes(s) = append-list(u32-to-bytes(len(s)), sai-string-bytes(s));
    def pifbc-int-list-encodable?(xs) = nil?(xs) ? 1 : pifbc-signed-ok?(xs[0]) ? pifbc-int-list-encodable?(xs[1:]) : 0;
    def pifbc-node-row-encodable?(row) = (Comparable) len(row) == 4 ? pifbc-int-list-encodable?(row) : 0;
    def pifbc-node-rows-encodable?(rows) = nil?(rows) ? 1 : pifbc-node-row-encodable?(rows[0]) ? pifbc-node-rows-encodable?(rows[1:]) : 0;
    def pifbc-string-row-encodable?(row) = pifbc-unsigned-ok?(len(row)) ? nil?(row) ? 1 : pifbc-byte?(row[0]) ? pifbc-string-row-encodable?(row[1:]) : 0 : 0;
    def pifbc-string-rows-encodable?(rows) = nil?(rows) ? 1 : pifbc-string-row-encodable?(rows[0]) ? pifbc-string-rows-encodable?(rows[1:]) : 0;
    def pifbc-table-encodable?(t) = pif-table-valid?(t) ? pifbc-signed-ok?(pif-table-nf(t)) ? pifbc-int-list-encodable?(pif-table-fn-roots(t)) ? pifbc-signed-ok?(pif-table-nr(t)) ? pifbc-node-rows-encodable?(pif-table-node-rows(t)) ? pifbc-signed-ok?(pif-table-ns(t)) ? pifbc-string-rows-encodable?(pif-table-string-byte-rows(t)) : 0 : 0 : 0 : 0 : 0 : 0;
    def pifbc-symbol-row-encodable?(row) = pifbc-signed-ok?(pif-symbol-row-id(row)) ? pifbc-unsigned-ok?(len(pif-symbol-row-key(row))) : 0;
    def pifbc-symbol-rows-encodable?(rows) = nil?(rows) ? 1 : pifbc-symbol-row-encodable?(rows[0]) ? pifbc-symbol-rows-encodable?(rows[1:]) : 0;
    def pifbc-symbol-dependency-target-encodable?(target) = pifbc-signed-ok?(pif-symbol-dependency-target-symbol(target)) ? pifbc-signed-ok?(pif-symbol-dependency-target-node(target)) : 0;
    def pifbc-symbol-dependency-targets-encodable?(targets) = nil?(targets) ? 1 : pifbc-symbol-dependency-target-encodable?(targets[0]) ? pifbc-symbol-dependency-targets-encodable?(targets[1:]) : 0;
    def pifbc-node-symbol-row-encodable?(row) = pifbc-signed-ok?(pif-node-symbol-row-node(row)) ? pifbc-signed-ok?(pif-node-symbol-row-defined(row)) ? pifbc-unsigned-ok?(len(pif-node-symbol-row-dependency-targets(row))) ? pifbc-symbol-dependency-targets-encodable?(pif-node-symbol-row-dependency-targets(row)) : 0 : 0 : 0;
    def pifbc-node-symbol-rows-encodable?(rows) = nil?(rows) ? 1 : pifbc-node-symbol-row-encodable?(rows[0]) ? pifbc-node-symbol-rows-encodable?(rows[1:]) : 0;
    def pifbc-symbol-image-encodable?(img, table) = pif-symbol-image-valid-for-table?(img, table) ? pifbc-signed-ok?(pif-symbol-image-count(img)) ? pifbc-signed-ok?(pif-symbol-image-node-count(img)) ? pifbc-symbol-rows-encodable?(pif-symbol-image-rows(img)) ? pifbc-node-symbol-rows-encodable?(pif-symbol-image-node-rows(img)) : 0 : 0 : 0 : 0;
    def pifbc-metadata-encodable?(e) = pif-envelope-shape-valid?(e) ? pifbc-signed-ok?(pif-envelope-source-mtime(e)) ? pifbc-signed-ok?(pif-envelope-seal-ok(e)) ? pifbc-unsigned-ok?(len(pif-envelope-source-path(e))) ? pifbc-unsigned-ok?(len(pif-envelope-source-hash(e))) ? pifbc-unsigned-ok?(len(pif-envelope-artifact-path(e))) : 0 : 0 : 0 : 0 : 0;
    def pifbc-int-list-bytes(xs) = nil?(xs) ? [] : append-list(pifbc-signed-bytes(xs[0]), pifbc-int-list-bytes(xs[1:]));
    def pifbc-node-rows-bytes(rows) = nil?(rows) ? [] : append-list(pifbc-int-list-bytes(rows[0]), pifbc-node-rows-bytes(rows[1:]));
    def pifbc-string-row-bytes(row) = append-list(u32-to-bytes(len(row)), row);
    def pifbc-string-rows-bytes(rows) = nil?(rows) ? [] : append-list(pifbc-string-row-bytes(rows[0]), pifbc-string-rows-bytes(rows[1:]));
    def pifbc-table-bytes(t) = pifbc-table-encodable?(t) ? append-list(pifbc-signed-bytes(pif-table-nf(t)), append-list(pifbc-int-list-bytes(pif-table-fn-roots(t)), append-list(pifbc-signed-bytes(pif-table-nr(t)), append-list(pifbc-node-rows-bytes(pif-table-node-rows(t)), append-list(pifbc-signed-bytes(pif-table-ns(t)), pifbc-string-rows-bytes(pif-table-string-byte-rows(t))))))) : [];
    def pifbc-symbol-row-bytes(row) = append-list(pifbc-signed-bytes(pif-symbol-row-id(row)), pifbc-string-bytes(pif-symbol-row-key(row)));
    def pifbc-symbol-rows-bytes(rows) = nil?(rows) ? [] : append-list(pifbc-symbol-row-bytes(rows[0]), pifbc-symbol-rows-bytes(rows[1:]));
    def pifbc-symbol-dependency-target-bytes(target) = append-list(pifbc-signed-bytes(pif-symbol-dependency-target-symbol(target)), pifbc-signed-bytes(pif-symbol-dependency-target-node(target)));
    def pifbc-symbol-dependency-targets-bytes(targets) = nil?(targets) ? [] : append-list(pifbc-symbol-dependency-target-bytes(targets[0]), pifbc-symbol-dependency-targets-bytes(targets[1:]));
    def pifbc-node-symbol-row-bytes(row) = append-list(pifbc-signed-bytes(pif-node-symbol-row-node(row)), append-list(pifbc-signed-bytes(pif-node-symbol-row-defined(row)), append-list(pifbc-signed-bytes(len(pif-node-symbol-row-dependency-targets(row))), pifbc-symbol-dependency-targets-bytes(pif-node-symbol-row-dependency-targets(row)))));
    def pifbc-node-symbol-rows-bytes(rows) = nil?(rows) ? [] : append-list(pifbc-node-symbol-row-bytes(rows[0]), pifbc-node-symbol-rows-bytes(rows[1:]));
    def pifbc-symbol-image-bytes(img) = append-list(pifbc-signed-bytes(pif-symbol-image-count(img)), append-list(pifbc-symbol-rows-bytes(pif-symbol-image-rows(img)), append-list(pifbc-signed-bytes(pif-symbol-image-node-count(img)), pifbc-node-symbol-rows-bytes(pif-symbol-image-node-rows(img)))));
    def pifbc-payload-bytes(e) = pif-envelope-valid?(e) ? pifbc-metadata-encodable?(e) ? pifbc-table-encodable?(pif-envelope-table(e)) ? pifbc-symbol-image-encodable?(pif-envelope-symbol-image(e), pif-envelope-table(e)) ? append-list(pifbc-magic(), append-list(u32-to-bytes(pifbc-byte-version()), append-list(pifbc-string-bytes(pifbc-builder-id()), append-list(pifbc-string-bytes(pif-envelope-source-path(e)), append-list(pifbc-string-bytes(pif-envelope-source-hash(e)), append-list(pifbc-signed-bytes(pif-envelope-source-mtime(e)), append-list(pifbc-string-bytes(pif-envelope-artifact-path(e)), append-list(pifbc-signed-bytes(pif-envelope-seal-ok(e)), append-list(pifbc-table-bytes(pif-envelope-table(e)), pifbc-symbol-image-bytes(pif-envelope-symbol-image(e))))))))))) : [] : [] : [] : [];
    def pifbc-empty-vouch() = sai-vouch(sai-target-content-hash(), "", sai-evidence-supplied-bytes(), "", "", sai-status-unobserved(), 0, 0);
    def pifbc-content-vouch(e, bytes) = sai-vouch-content-bytes(pif-envelope-artifact-path(e), pif-envelope-content-hash(e), bytes);
    // row = ("program-image-fkb-byte-container" pif-envelope bytes vouch status reason)
    def pifbc-container(pif-envelope, bytes, vouch, status, reason) = ["program-image-fkb-byte-container", pif-envelope, bytes, vouch, status, reason];
    def pifbc-container?(c) = (Comparable) len(c) == 6 ? (String) c[0] == "program-image-fkb-byte-container" : 0;
    def pifbc-container-pif(c) = c[1];
    def pifbc-container-bytes(c) = c[2];
    def pifbc-container-vouch(c) = c[3];
    def pifbc-container-status(c) = c[4];
    def pifbc-container-reason(c) = c[5];
    def pifbc-ready?(c) = pifbc-container?(c) ? (String) pifbc-container-status(c) == pifbc-status-ready() : 0;
    def pifbc-container-from-envelope(e) = !pif-envelope?(e) ? pifbc-container(e, [], pifbc-empty-vouch(), pifbc-status-refused(), pifbc-reason-malformed-envelope()) : !pif-envelope-valid?(e) ? pifbc-container(e, [], pifbc-empty-vouch(), pifbc-status-refused(), pifbc-reason-invalid-envelope()) : !pifbc-metadata-encodable?(e) ? pifbc-container(e, [], pifbc-empty-vouch(), pifbc-status-investigate(), pifbc-reason-non-encodable-metadata()) : !pifbc-table-encodable?(pif-envelope-table(e)) ? pifbc-container(e, [], pifbc-empty-vouch(), pifbc-status-investigate(), pifbc-reason-non-encodable-table()) : !pifbc-symbol-image-encodable?(pif-envelope-symbol-image(e), pif-envelope-table(e)) ? pifbc-container(e, [], pifbc-empty-vouch(), pifbc-status-investigate(), pifbc-reason-non-encodable-symbols()) : {
        let bytes = pifbc-payload-bytes(e);
        let vouch = pifbc-content-vouch(e, bytes);
        sai-vouch-match?(vouch) ? pifbc-container(e, bytes, vouch, pifbc-status-ready(), pifbc-reason-ready()) : (String) sai-vouch-status(vouch) == sai-status-malformed() ? pifbc-container(e, bytes, vouch, pifbc-status-refused(), pifbc-reason-content-hash-malformed()) : pifbc-container(e, bytes, vouch, pifbc-status-investigate(), pifbc-reason-content-hash-mismatch());
    };

    // The ordinary native image keeps its admitted metadata and opaque sections.
    // Only a restricted evaluator's immutable result becomes literal AST rows;
    // process heap handles and CONST_HOLD memo fields never enter these bytes.
    def pifbc-v8-byte-string(xs) = nil?(xs) ? "" : byte_to_str(xs[0]) + pifbc-v8-byte-string(xs[1:]);
    def pifbc-v8-u32(n) = byte_to_str(n / 16777216 % 256) + byte_to_str(n / 65536 % 256) + byte_to_str(n / 256 % 256) + byte_to_str(n % 256);
    def pifbc-v8-int(n) {
        let mag = n < 0 ? 0 - n : n;
        // The native minimum's positive magnitude cannot be a tagged int.
        mag < 0 ? byte_to_str(1) + pifbc-v8-u32(1073741824) + pifbc-v8-u32(0)
        : byte_to_str(n < 0 ? 1 : 0) + pifbc-v8-u32(mag / 4294967296) + pifbc-v8-u32(mag % 4294967296);
    }
    def pifbc-v8-row(tag,a,b,c) = pifbc-v8-int(tag) + pifbc-v8-int(a) + pifbc-v8-int(b) + pifbc-v8-int(c);
    def pifbc-v8-string(s) = pifbc-v8-u32(len(s)) + s;
    def pifbc-v8-join(parts) = str-spans(parts);
    def pifbc-v8-fold(bytes) = bfp-text(bytes);
    def pifbc-v8-seal(bytes) = bytes + pifbc-v8-byte-string(hex-decode(pifbc-v8-fold(bytes)));
    def pifbc-v8-literals(nodes,strings) = record_new(0,"next",nodes,"strings",strings,"rows",[],"text",[],"reason","");
    def pifbc-v8-add-row(state,tag,a,b,c) {
        let at = record_get(state,"next");
        record_set(state,"next",at + 1);
        record_set(state,"rows",cons(pifbc-v8-row(tag,a,b,c),record_get(state,"rows")));
        at;
    }
    def pifbc-v8-list(state,value) = nil?(value) ? pifbc-v8-add-row(state,18,0,0,0) : {
        let h = pifbc-v8-literal(state,head(value));
        let t = pifbc-v8-literal(state,tail(value));
        pifbc-v8-add-row(state,19,h,t,0);
    };
    def pifbc-v8-literal(state,value) {
        let kind = value_kind(value);
        kind == "int" ? pifbc-v8-add-row(state,1,value,0,0)
        : kind == "null" ? pifbc-v8-add-row(state,137,0,0,0)
        : kind == "list" ? pifbc-v8-list(state,value)
        : kind == "string" ? len(value) > 4294967295 ? {
            record_set(state,"reason","literal-string-exceeds-wire-length"); 0;
        } : {
            let at = record_get(state,"strings");
            record_set(state,"strings",at + 1);
            record_set(state,"text",cons(pifbc-v8-string(value),record_get(state,"text")));
            pifbc-v8-add-row(state,24,at,0,0);
        } : { record_set(state,"reason","immutable-literal-required"); 0; };
    }

    // A cell projection is an inert static graph, rooted in its admission's
    // unit sequences, exported definitions and constants. It never reads a
    // hold's value, a closure instance, a native page or the process's fn0.
    // The reader belongs to the captured admission; callbacks also let the
    // existing image band discriminate relocation without a process snapshot.
    // catalog: cell-admission-v1 {builder,closure,root_unit,units,exports,
    // constants,contexts}. A unit is [id,path,sequence,order,members,source
    // observation]; exports [name,fn,arity,unit], constants [name,node,unit].
    // read(node) -> four static words; read(["function",fn]) ->
    // [originalBody,arity,captureCount,parent,[builder,closure]];
    // read(["literal",node]) -> bytes; read(["catalog"]) -> fresh catalog.
    def pifbc-proj-list?(x) = value_kind(x) == "list";
    def pifbc-proj-int?(x) = value_kind(x) == "int";
    def pifbc-proj-string?(x) = value_kind(x) == "string";
    def pifbc-proj-has(xs,x) = nil?(xs) ? 0 : head(xs) == x || pifbc-proj-has(tail(xs),x);
    def pifbc-proj-shape?(x,n) = pifbc-proj-list?(x) ? len(x) == n : 0;
    def pifbc-proj-ints?(xs) = nil?(xs) ? 1 : pifbc-proj-int?(head(xs)) && pifbc-proj-ints?(tail(xs));
    def pifbc-proj-pair?(x) = pifbc-proj-shape?(x,2) ? pifbc-proj-string?(x[0]) && pifbc-proj-string?(x[1]) : 0;
    def pifbc-proj-good(s) = record_get(s,"reason") == "";
    def pifbc-proj-fail(s,reason,detail) {
        pifbc-proj-good(s) ? { record_set(s,"reason",reason); record_set(s,"detail",detail); } : s;
        nothing();
    }
    def pifbc-proj-fields?(r,keys) = nil?(keys) ? 1 : record_has(r,head(keys)) && pifbc-proj-fields?(r,tail(keys));
    def pifbc-proj-observation(x) = !record?(x) ? nothing()
        : !pifbc-proj-fields?(x,["kind","bytes","digest"]) ? nothing()
        : !pifbc-proj-string?(record_get(x,"kind")) || !pifbc-proj-int?(record_get(x,"bytes")) || !pifbc-proj-string?(record_get(x,"digest")) ? nothing()
        : record_get(x,"bytes") < 0 || !pifbc-proj-has(["raw","lowered"],record_get(x,"kind")) ? nothing()
        : [record_get(x,"kind"),record_get(x,"bytes"),record_get(x,"digest")];
    def pifbc-proj-unit-key(u) = !pifbc-proj-shape?(u,6) ? nothing()
        : !pifbc-proj-int?(u[0]) || !pifbc-proj-string?(u[1]) || !pifbc-proj-int?(u[2]) || !pifbc-proj-int?(u[3]) || !pifbc-proj-list?(u[4]) ? nothing()
        : u[0] < 0 || len(u[1]) == 0 || u[2] < -1 || u[3] < 0 || !pifbc-proj-ints?(u[4]) ? nothing() : {
            let observed = pifbc-proj-observation(u[5]);
