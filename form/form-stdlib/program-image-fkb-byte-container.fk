    def pifbc-proj-fnmeta?(m) = !pifbc-proj-shape?(m,5) ? 0
        : !pifbc-proj-int?(m[0]) || !pifbc-proj-int?(m[1]) || !pifbc-proj-int?(m[2]) || !pifbc-proj-int?(m[3]) ? 0
