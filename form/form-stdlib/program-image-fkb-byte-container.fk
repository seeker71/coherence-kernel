        };
    def pifbc-proj-unit-keys(units) = nil?(units) ? [] : {
        let first = pifbc-proj-unit-key(head(units)); let rest = pifbc-proj-unit-keys(tail(units));
        nothing?(first) || nothing?(rest) ? nothing() : cons(first,rest);
    };
    def pifbc-proj-catalog-key(c) = !record?(c) ? nothing()
        : !pifbc-proj-fields?(c,["kind","builder","closure","root_unit","units","exports","constants","contexts"]) ? nothing()
        : record_get(c,"kind") != "cell-admission-v1" || !pifbc-proj-string?(record_get(c,"builder")) || !pifbc-proj-string?(record_get(c,"closure")) || !pifbc-proj-int?(record_get(c,"root_unit")) ? nothing()
        : !pifbc-proj-list?(record_get(c,"units")) || !pifbc-proj-list?(record_get(c,"exports")) || !pifbc-proj-list?(record_get(c,"constants")) || !pifbc-proj-list?(record_get(c,"contexts")) ? nothing() : {
            let units = pifbc-proj-unit-keys(record_get(c,"units"));
            nothing?(units) ? nothing() : [record_get(c,"kind"),record_get(c,"builder"),record_get(c,"closure"),record_get(c,"root_unit"),units,record_get(c,"exports"),record_get(c,"constants"),record_get(c,"contexts")];
        };
