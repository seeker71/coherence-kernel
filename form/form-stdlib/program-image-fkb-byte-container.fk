    def pifbc-proj-state() = record_new(0,"reason","","detail",nothing(),"unit_ids",record_new(0),"unit_order",record_new(0),"ops",pifbc-proj-ops(fkwu-native-ops(),record_new(0)),"observed_nodes",record_new(0),"node_map",record_new(0),"function_map",record_new(0),"string_map",record_new(0),"nodes",record_new(0,"0",[1,0,0,0]),"functions",record_new(0),"strings",record_new(0),"node_count",1,"function_count",1,"string_count",0,"pending",[],"node_ledger",[],"function_ledger",[],"literal_ledger",[]);
    def pifbc-project(catalog,read) {
