        record_new(0,"kind","program-image-static-projection","status",pifbc-proj-good(s) ? "projected" : "refused","reason",record_get(s,"reason"),"detail",record_get(s,"detail"),"catalog",nothing?(key) ? nothing() : pifbc-proj-catalog(key),"roots",cons(root,functions |> map(fn => nothing?(fn) ? nothing() : fn[1])),"functions",functions,"nodes",pifbc-proj-values(record_get(s,"nodes"),0,record_get(s,"node_count"),[]),"strings",pifbc-proj-values(record_get(s,"strings"),0,record_get(s,"string_count"),[]),"symbols",symbols,"units",units,"constants",constants,"relocation",[record_get(s,"node_map"),record_get(s,"function_map"),record_get(s,"string_map")],"ledger",[reverse(record_get(s,"node_ledger")),reverse(record_get(s,"function_ledger")),reverse(record_get(s,"literal_ledger"))]);
