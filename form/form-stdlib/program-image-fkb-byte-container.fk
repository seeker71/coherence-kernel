    def pifbc-proj-function(s,read,id) = !pifbc-proj-good(s) ? nothing()
        : !pifbc-proj-int?(id) ? pifbc-proj-fail(s,"projection-function-reference-invalid",id)
        : id <= 0 ? pifbc-proj-fail(s,"projection-unowned-root-reference",id) : {
