    };
    def pifbc-proj-members?(s,members) = nil?(members) ? 1 : record_has(record_get(s,"unit_ids"),head(members).str()) && pifbc-proj-members?(s,tail(members));
    def pifbc-proj-windows(s,units) = nil?(units) || !pifbc-proj-good(s) ? s : {
