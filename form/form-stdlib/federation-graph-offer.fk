; federation-graph-offer.fk — a federation message is a graph movement.
; witnessed: 2026-07-22 -> pending re-witness on the complete body
; preludes: form-stdlib/core.fk form-stdlib/form-ontology-loader.fk form-stdlib/offer-ack-core.fk
(do
    (let FGO-MESSAGE (bp "CHANNEL-MSG"))
    (let FGO-EDGE (bp "CHANNEL-V0"))
    (defn fgo-text (s) (intern_trivial_string s))
    (defn fgo-message (message-id from-node to-node kind payload)
        (intern_node FGO-MESSAGE
            (list (fgo-text message-id) (fgo-text from-node) (fgo-text to-node)
                  (fgo-text kind) (fgo-text payload))))
    (defn fgo-edge (from-node to-node message)
        (intern_node FGO-EDGE
            (list (fgo-text from-node) (fgo-text to-node) message)))
    (defn fgo-offer (message-id from-node to-node kind payload)
        (oac-node (fgo-edge from-node to-node
            (fgo-message message-id from-node to-node kind payload))))
)
