// fnri-receipt.fk — standard-receipt lines for form-cli (fkwu-native, no bash).
// It formats fnri witness/standin values only; the interactive shell and
// host-kernel carrier have no call site or top-level effect in this receipt.
//
import form-stdlib/core.fk;
import form-stdlib/resource-port.fk;
import form-stdlib/bml-native-interface-package-import.fk;
import form-stdlib/hati-os-targets.fk;
import form-stdlib/form-native-resource-interfaces.fk;
import form-stdlib/form-fs.fk;
import form-stdlib/storage-port.fk;
import form-stdlib/fnri-standin.fk;
section [form.bml] {
    def fcr-pass?(got, want) = (Comparable) got == want ? 1 : 0;
    def fcr-platform-line() = ("claim=fnri-witness witness=" + (fnri-witness-verdict().str() + (" audio=" + (fnri-audio-standin-verdict().str() + (" video=" + (fnri-video-standin-verdict().str() + (" gpu=" + (fnri-gpu-standin-verdict().str() + (" staged=" + fcr-pass?(fnri-witness-verdict(), 32767).str())))))))));
    def fcr-metal-line() = ("claim=fnri-metal-standin audio=" + (fnri-audio-standin-verdict().str() + (" video=" + (fnri-video-standin-verdict().str() + (" gpu=" + fnri-gpu-standin-verdict().str())))));
    def fcr-bootstrap-line() = ("claim=fnri-bootstrap witness=" + fnri-witness-verdict().str());
    def fc-receipt(arg) = {
        (String) arg == "platform" ? fcr-platform-line() : (String) arg == "metal-standin" ? fcr-metal-line() : (String) arg == "bootstrap" ? fcr-bootstrap-line() : "receipt: platform | metal-standin | bootstrap";
    };
    0;
}
