// fnri-receipt.fk — standard-receipt lines for form-cli (fkwu-native, no bash).
// It formats fnri witness/standin values only; the interactive shell and
// host-kernel carrier have no call site or top-level effect in this receipt.
//
// preludes: form-stdlib/core.fk form-stdlib/resource-port.fk form-stdlib/bml-native-interface-package-import.fk form-stdlib/hati-os-targets.fk form-stdlib/form-native-resource-interfaces.fk form-stdlib/form-fs.fk form-stdlib/storage-port.fk form-stdlib/fnri-standin.fk
section [form.bml] {
    def fcr-pass?(got, want) = (Comparable) got == want ? 1 : 0;
    def fcr-platform-line() = str_concat("claim=fnri-witness witness=", str_concat(int_to_str(fnri-witness-verdict()), str_concat(" audio=", str_concat(int_to_str(fnri-audio-standin-verdict()), str_concat(" video=", str_concat(int_to_str(fnri-video-standin-verdict()), str_concat(" gpu=", str_concat(int_to_str(fnri-gpu-standin-verdict()), str_concat(" staged=", int_to_str(fcr-pass?(fnri-witness-verdict(), 32767)))))))))));
    def fcr-metal-line() = str_concat("claim=fnri-metal-standin audio=", str_concat(int_to_str(fnri-audio-standin-verdict()), str_concat(" video=", str_concat(int_to_str(fnri-video-standin-verdict()), str_concat(" gpu=", int_to_str(fnri-gpu-standin-verdict()))))));
    def fcr-bootstrap-line() = str_concat("claim=fnri-bootstrap witness=", int_to_str(fnri-witness-verdict()));
    def fc-receipt(arg) = {
        (String) arg == "platform" ? fcr-platform-line() : (String) arg == "metal-standin" ? fcr-metal-line() : (String) arg == "bootstrap" ? fcr-bootstrap-line() : "receipt: platform | metal-standin | bootstrap";
    };
    0;
}
