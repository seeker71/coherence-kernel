// form-definition-language.fk -- scannerless module/definition authoring surface.
//
// This layer answers the current low-level authoring problem without pretending
// the executable floor has changed. Authors can write a small module language:
//
//     module calc {
//       data rows = [8,13,21];
//       fn bump(x) = add(x,1);
//       fn first() = head(rows);
//     }
//
// The BMF cursor grammar parses that surface and lowers it to today's proven
// top-level Form source floor:
//
//     (let rows (list 8 13 21))
//     (defn bump (x) (add x 1))
//     (defn first () (head rows))
//
// It is not a source-compiler integration yet, not a line grammar, not a
// tokenizer, not an s-expression surface, and not a C runtime primitive.
//
import form-stdlib/core.fk;
import form-stdlib/bmf-core.fk;
import form-stdlib/bmf-grammar.fk;
import form-stdlib/defdata.fk;
section [form.bml] {
    def fdl-feature(name, status) = ["form-definition-language-feature", name, status];
    def fdl-feature-name(f) = f[1];
    def fdl-feature-status(f) = f[2];
    def form-definition-language-manifest() = [fdl-feature("scannerless", 1), fdl-feature("bmf-cursor-grammar", 1), fdl-feature("no-line-grammar", 1), fdl-feature("not-s-expression-surface", 1), fdl-feature("module-authoring", 1), fdl-feature("definition-authoring", 1), fdl-feature("data-authoring", 1), fdl-feature("defdata-policy-reused", 1), fdl-feature("lowers-to-form-floor", 1), fdl-feature("not-main-source-compiler", 1), fdl-feature("not-runtime-primitive", 1)];
    def form-definition-language-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) fdl-feature-name(fs[0]) == name && (Comparable) fdl-feature-status(fs[0]) == 1 ? 1 : form-definition-language-manifest-has?(name, fs[1:]);
    def form-definition-language-grammar() = grammar("module", [rule3("module", ["seq", p-lit("module"), p-cap("name", p-ref("name")), p-lit("{"), p-cap("decls", p-rep(p-ref("decl"))), p-lit("}")], t-emit("fncall", [t-const("__fdl_module__"), t-splice("name"), t-splices("decls")])), rule3("decl", p-cap("v", ["alt", p-ref("data-decl"), p-ref("fn-decl")]), t-splice("v")), rule3("data-decl", ["seq", p-lit("data"), p-cap("name", p-ref("name")), p-lit("="), p-cap("values", p-ref("int-list")), p-lit(";")], t-emit("fncall", [t-const("__fdl_data__"), t-splice("name"), t-splice("values")])), rule3("fn-decl", ["seq", p-lit("fn"), p-cap("name", p-ref("name")), p-lit("("), p-cap("params", p-ref("params")), p-lit(")"), p-lit("="), p-cap("body", p-ref("expr")), p-lit(";")], t-emit("fncall", [t-const("__fdl_fn__"), t-splice("name"), t-splice("params"), t-splice("body")])), rule3("params", p-cap("ps", p-sep(p-ref("name"), p-lit(","))), t-emit("fncall", [t-const("__fdl_params__"), t-splices("ps")])), rule3("int-list", ["seq", p-lit("["), p-cap("values", p-sep(p-ref("int-leaf"), p-lit(","))), p-lit("]")], t-emit("fncall", [t-const("__fdl_int_list__"), t-splices("values")])), rule3("args", p-cap("as", p-sep(p-ref("expr"), p-lit(","))), t-emit("fncall", [t-const("__fdl_args__"), t-splices("as")])), rule3("expr", p-cap("v", ["alt", p-ref("call-expr"), p-ref("int-expr"), p-ref("name-expr")]), t-splice("v")), rule3("call-expr", ["seq", p-cap("name", p-ref("name")), p-lit("("), p-cap("args", p-ref("args")), p-lit(")")], t-emit("fncall", [t-const("__fdl_call__"), t-splice("name"), t-splice("args")])), rule3("int-expr", p-cap("v", p-ref("int-leaf")), t-emit("fncall", [t-const("__fdl_int__"), t-splice("v")])), rule3("name-expr", p-cap("v", p-ref("name")), t-emit("fncall", [t-const("__fdl_name__"), t-splice("v")])), rule3("name", p-cap("v", p-run("alpha")), t-splice("v")), rule3("int-leaf", p-cap("v", p-run("digit")), t-splice("v"))]);
    def fdl-parse-fail() = intern_trivial_string("PARSE-FAIL");
    def fdl-ok?(node) = !node_eq(node, fdl-parse-fail());
    // Full-source parse: reject trailing sediment after whitespace/comments.
    def fdl-parse(src) = {
        let rr = g-match-rule(form-definition-language-grammar(), "module", cursor-str(src));
        rok?(rr) && cur-eof?(skip-ws(rok-cur(rr))) ? rok-node(rr) : fdl-parse-fail();
    };
    def fdl-tag(node) = node_value(node_children(node)[0]);
    def fdl-module-name(module) = node_value(node_children(module)[1]);
    def fdl-module-decls(module) = node_children(module)[1:][1:];
    def fdl-decl-count(module) = len(fdl-module-decls(module));
    def fdl-data-name(decl) = node_value(node_children(decl)[1]);
    def fdl-data-values-node(decl) = node_children(decl)[2];
    def fdl-data-value-nodes(decl) = node_children(fdl-data-values-node(decl))[1:];
    def fdl-data-value-count(decl) = len(fdl-data-value-nodes(decl));
    def fdl-data-value-head(decl) = str_to_int(node_value(fdl-data-value-nodes(decl)[0]));
    def fdl-data-policy(decl) = dd-policy(fdl-data-value-count(decl), 0, 1, 0);
    def fdl-fn-name(decl) = node_value(node_children(decl)[1]);
    def fdl-fn-params-node(decl) = node_children(decl)[2];
    def fdl-fn-param-nodes(decl) = node_children(fdl-fn-params-node(decl))[1:];
    def fdl-fn-param-count(decl) = len(fdl-fn-param-nodes(decl));
    def fdl-fn-body(decl) = node_children(decl)[3];
    def fdl-space-leaf-source(nodes) = nil?(nodes) ? "" : nil?(nodes[1:]) ? node_value(nodes[0]) : (node_value(nodes[0]) + (" " + fdl-space-leaf-source(nodes[1:])));
    def fdl-list-source(nodes) = nil?(nodes) ? "(list)" : ("(list " + (fdl-space-leaf-source(nodes) + ")"));
    def fdl-params-source(param-nodes) = ("(" + (fdl-space-leaf-source(param-nodes) + ")"));
    def fdl-arg-source(args) = nil?(args) ? "" : nil?(args[1:]) ? fdl-expr-source(args[0]) : (fdl-expr-source(args[0]) + (" " + fdl-arg-source(args[1:])));
    def fdl-call-source(expr) = {
        let kids = node_children(expr);
        let name = node_value(kids[1]);
        let args = node_children(kids[2])[1:];
        nil?(args) ? ("(" + (name + ")")) : ("(" + (name + (" " + (fdl-arg-source(args) + ")"))));
    };
    def fdl-expr-source(expr) = {
        let tag = fdl-tag(expr);
        (String) tag == "__fdl_int__" ? node_value(node_children(expr)[1]) : (String) tag == "__fdl_name__" ? node_value(node_children(expr)[1]) : (String) tag == "__fdl_call__" ? fdl-call-source(expr) : "?";
    };
    def fdl-data-source(decl) = ("(let " + (fdl-data-name(decl) + (" " + (fdl-list-source(fdl-data-value-nodes(decl)) + ")"))));
    def fdl-fn-source(decl) = ("(defn " + (fdl-fn-name(decl) + (" " + (fdl-params-source(fdl-fn-param-nodes(decl)) + (" " + (fdl-expr-source(fdl-fn-body(decl)) + ")"))))));
    def fdl-decl-source(decl) = {
        let tag = fdl-tag(decl);
        (String) tag == "__fdl_data__" ? fdl-data-source(decl) : (String) tag == "__fdl_fn__" ? fdl-fn-source(decl) : "?";
    };
    def fdl-decls-source(decls) = nil?(decls) ? "" : nil?(decls[1:]) ? fdl-decl-source(decls[0]) : (fdl-decl-source(decls[0]) + ("\n" + fdl-decls-source(decls[1:])));
    def fdl-module-source(module) = fdl-decls-source(fdl-module-decls(module));
    def fdl-lowering(module) = ["form-definition-lowering", "form-top-level-source-floor", fdl-module-name(module), fdl-decl-count(module), fdl-module-source(module)];
    def fdl-lowering-kind(l) = l[1];
    def fdl-lowering-name(l) = l[2];
    def fdl-lowering-decl-count(l) = l[3];
    def fdl-lowering-source(l) = l[4];
}
