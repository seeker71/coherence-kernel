// rag-embed.fk — a sovereign lexical embedding, in pure Form (zero model door).
//
// preludes: form-stdlib/core.fk form-stdlib/text-tokenize.fk
//
// The RAG memory embeds text through a neural model (nomic-embed-text over ollama)
// — a local model-door crossing, higher semantic quality, but not Form and not
// sovereign. This is the floor beneath that bridge: a deterministic LEXICAL
// embedding written entirely in Form. re-norm lowercases the text to space-joined
// letter/digit-words (pure Form, no tokenize prelude); re-split lifts that to a
// word list; each word folds to a bounded non-negative polynomial hash (h = h*31 +
// byte, mod a prime, via str_byte_at); the bucket is that hash mod dim; re-vec-dim
// counts buckets into a fixed-width histogram. Same text => same vector on every
// kernel — a content-addressed substrate cell, needing no model, no network, no host-io.
//
// The base re-vec remains a literal lexical fingerprint. re-semantic-vec is the
// grounded-ask representation: a sparse list of exact dual-hash feature codes.
// Stop words vanish; a known term maps ONLY to its canonical authored concept;
// an unknown term maps to one conservative stem/word; repeated features dedupe.
// Each feature emits two independently hashed codes in non-overlapping domains,
// making a full semantic match require both hashes instead of a collision-prone
// dense 64-bin bucket. This is still an authored semantic lexicon, not open-world
// language understanding; unknown synonyms remain apart.
// (The polynomial hash is inline by design; adler32.bml could carry it as a future
// lift, but it is BML and would complicate this four-way prelude chain.)
//
section [form.bml] {
    // --- append one word to the end of a word list (order-preserving snoc). ---
    def re-snoc(xs, x) = (Comparable) len(xs) == 0 ? cons(x, empty()) : cons(head(xs), re-snoc(tail(xs), x));
    // --- split a space-joined string into a word list, scanning one-byte substrings. ---
    // flush the current word on each single space (and at the end); skip blanks.
    def re-split-scan(s, i, n, cur, out) = i >= n ? (String) cur == "" ? out : re-snoc(out, cur) : {
        let c = substring(s, i, i + 1);
        (String) c == " " ? re-split-scan(s, i + 1, n, "", (String) cur == "" ? out : re-snoc(out, cur)) : re-split-scan(s, i + 1, n, str_concat(cur, c), out);
    };
    def re-split(s) = re-split-scan(s, 0, str_len(s), "", empty());
    // --- polynomial hash of a word: h = h*31 + byte, mod prime each step so it stays ---
    // bounded and non-negative on every kernel. str_byte_at is the working byte read on
    // this fkwu (ord evaluates to nothing here — the same repair nl-meaning-net names).
    def re-prime() = 1000003;
    def re-hash-fold(w, i, n, h) = i >= n ? h : re-hash-fold(w, i + 1, n, (h * 31 + str_byte_at(w, i)) % re-prime());
    def re-hash(w) = re-hash-fold(w, 0, str_len(w), 0);
    // Independent second hash domain for semantic-v2. The offset is exactly the
    // size of the first domain, so no first-hash code can equal a second-hash code.
    def re-prime-131() = 1000033;
    def re-hash-131-fold(w, i, n, h) = i >= n ? h : re-hash-131-fold(w, i + 1, n, (h * 131 + str_byte_at(w, i)) % re-prime-131());
    def re-hash-131(w) = re-hash-131-fold(w, 0, str_len(w), 0);
    def re-second-domain-offset() = re-prime();
    // --- which dim-bucket a word lands in. ---
    def re-bucket(word, dim) = re-hash(word) % dim;
    // --- reverse acc onto rest (the shared tail-recursive spine of the list rebuilds). ---
    def re-rev-into(acc, rest) = (Comparable) len(acc) == 0 ? rest : re-rev-into(tail(acc), cons(head(acc), rest));
    // --- linear UTF-8 byte tokenizer. ---
    // Keep the source string in the host pool and carry only the current word
    // plus a reverse word list through Form.  The former re-norm + re-split
    // path rebuilt the whole normalized prefix and then repeatedly snoc'd the
    // whole word list, making document embedding quadratic in source length.
    // Scan with str_byte_at directly.  The generic string_byte_fold carrier can
    // retain a host byte-slice while a callback is active; a long run of UTF-8
    // delimiter bytes then wedges the emitted fkwu image during release.  This
    // Form-authored tail scan never constructs non-ASCII strings: every byte
    // outside [A-Za-z0-9] is a delimiter, exactly matching re-norm.
    def re-word-byte?(b) = b >= 65 && b <= 90 || (b >= 97 && b <= 122 || b >= 48 && b <= 57) ? 1 : 0;
    def re-lower-byte(b) = b >= 65 && b <= 90 ? b + 32 : b;
    def re-words-scan(text, i, n, cur, rev-words) = i >= n ? re-rev-into((String) cur == "" ? rev-words : cons(cur, rev-words), empty()) : {
        let b = str_byte_at(text, i);
        (Comparable) re-word-byte?(b) == 1 ? re-words-scan(text, i + 1, n, str_concat(cur, byte_to_str(re-lower-byte(b))), rev-words) : re-words-scan(text, i + 1, n, "", (String) cur == "" ? rev-words : cons(cur, rev-words));
    };
    def re-words(text) = re-words-scan(text, 0, str_len(text), "", empty());
    // --- a zero list of length n (the empty histogram). Tail-recursive: the old ---
    // structural recursion used one walker C-frame per element, which overflows small
    // host stacks (Windows ~120 frames) at dim >= 128. Same repair family as tk-join.
    def re-zeros-scan(n, acc) = (Comparable) n == 0 ? acc : re-zeros-scan(n - 1, cons(0, acc));
    def re-zeros(n) = re-zeros-scan(n, empty());
    // --- increment the count at index i in a list (rebuild; no mutation; tail). ---
    def re-inc-scan(xs, i, acc) = (Comparable) i == 0 ? re-rev-into(acc, cons(head(xs) + 1, tail(xs))) : re-inc-scan(tail(xs), i - 1, cons(head(xs), acc));
    def re-inc(xs, i) = re-inc-scan(xs, i, empty());
    // --- fold a word list into a histogram: +1 at each word's bucket. ---
    def re-fill(words, vec, dim) = (Comparable) len(words) == 0 ? vec : re-fill(tail(words), re-inc(vec, re-bucket(head(words), dim)), dim);
    // --- normalize text to space-joined lowercase letter/digit words, in pure Form. ---
    // This replaces the tk-words prelude (form-stdlib/text-tokenize.fk), which is not in
    // this repo: A-Z fold to a-z, digits pass, every other byte becomes a space (re-split
    // already skips blank runs). "France?" and "france" now land in the same bucket.
    def re-norm-scan(s, i, n, out) = i >= n ? out : {
        let b = str_byte_at(s, i);
        re-norm-scan(s, i + 1, n, str_concat(out, b >= 65 && b <= 90 ? byte_to_str(b + 32) : b >= 97 && b <= 122 ? byte_to_str(b) : b >= 48 && b <= 57 ? byte_to_str(b) : " "));
    };
    def re-norm(s) = re-norm-scan(s, 0, str_len(s), "");
    // --- the embedding: token-hash histogram of width dim. ---
    def re-vec-dim(text, dim) = re-fill(re-words(text), re-zeros(dim), dim);
    // --- 64 is the default embedding dim. ---
    def re-default-dim() = 64;
    def re-vec(text) = re-vec-dim(text, re-default-dim());
    // ── deterministic semantic feature layer ──────────────────────────────
    // The version is part of the index schema. Any mapping change must bump it
    // so source vectors and query vectors can never silently disagree.
    def re-semantic-kind() = "form-semantic-v2";
    def re-word-in?(word, words) = (Comparable) len(words) == 0 ? 0 : (String) word == head(words) ? 1 : re-word-in?(word, tail(words));
    def re-stop-word?(word) = re-word-in?(word, list("a", "an", "and", "are", "as", "at", "be", "been", "but", "by", "can", "did", "do", "does", "for", "from", "had", "has", "have", "how", "i", "if", "in", "into", "is", "it", "its", "not", "of", "on", "or", "our", "that", "the", "their", "then", "there", "this", "to", "was", "we", "were", "what", "when", "where", "which", "who", "why", "will", "with", "you", "your"));
    def re-ends?(word, suffix) = {
        let nw = str_len(word);
        let ns = str_len(suffix);
        nw < ns ? 0 : (String) substring(word, nw - ns, nw) == suffix ? 1 : 0;
    };
    // A conservative morphology choice for unknown terms. Only one of stem/word
    // is emitted, so one token always remains one atomic semantic feature.
    def re-stem(word) = {
        let n = str_len(word);
        n > 5 && (Comparable) re-ends?(word, "ing") == 1 ? substring(word, 0, n - 3) : n > 4 && (Comparable) re-ends?(word, "ed") == 1 ? substring(word, 0, n - 2) : n > 4 && (Comparable) re-ends?(word, "es") == 1 ? substring(word, 0, n - 2) : n > 3 && (Comparable) re-ends?(word, "s") == 1 ? substring(word, 0, n - 1) : word;
    };
    // Only true lemma/synonym classes collapse. Related roles, artifacts, states,
    // and opposites keep distinct features (for example kernel/runtime/submodule,
    // source/path/file, native/local/offline, fear/love, merge/duplicate).
    def re-concept-row(concept, words) = list(concept, words);
    def re-concept-find(word, rows) = (Comparable) len(rows) == 0 ? "" : {
        let row = head(rows);
        (Comparable) re-word-in?(word, nth(row, 1)) == 1 ? nth(row, 0) : re-concept-find(word, tail(rows));
    };
    def re-concept-rows() = list(re-concept-row("__concept_ground", list("ground", "grounded", "grounding")), re-concept-row("__concept_attribution", list("attribution", "attributed")), re-concept-row("__concept_coordinate", list("coordinate", "coordinates")), re-concept-row("__concept_resolve", list("resolve", "resolved", "resolvable")), re-concept-row("__concept_identity", list("identity", "identities", "id", "ids", "nodeid", "nodeids")), re-concept-row("__concept_address", list("address", "addresses")), re-concept-row("__concept_observe", list("observe", "observed", "observing", "observation", "observations")), re-concept-row("__concept_measure", list("measure", "measured", "measurement", "measurements")), re-concept-row("__concept_sense", list("sense", "sensed", "sensing")), re-concept-row("__concept_evidence", list("evidence", "proof", "proofs", "prove", "proven")), re-concept-row("__concept_verify", list("verify", "verified", "verification")), re-concept-row("__concept_receipt", list("receipt", "receipts")), re-concept-row("__concept_witness", list("witness", "witnesses", "witnessed")), re-concept-row("__concept_trace", list("trace", "traces")), re-concept-row("__concept_deploy", list("deploy", "deployed", "deployment", "deployments")), re-concept-row("__concept_release", list("release", "released", "releases")), re-concept-row("__concept_production", list("production")), re-concept-row("__concept_live", list("live")), re-concept-row("__concept_ship", list("ship", "shipped", "shipping")), re-concept-row("__concept_rollout", list("rollout", "rollouts")), re-concept-row("__concept_kernel", list("kernel", "kernels")), re-concept-row("__concept_runtime", list("runtime", "runtimes")), re-concept-row("__concept_engine", list("engine", "engines")), re-concept-row("__concept_submodule", list("submodule", "submodules")), re-concept-row("__concept_fkwu", list("fkwu")), re-concept-row("__concept_retrieve", list("retrieve", "retrieval")), re-concept-row("__concept_recall", list("recall")), re-concept-row("__concept_search", list("search", "searching")), re-concept-row("__concept_lookup", list("lookup", "lookups")), re-concept-row("__concept_find", list("find", "found")), re-concept-row("__concept_rag", list("rag")), re-concept-row("__concept_index", list("index", "indexing", "indexes")), re-concept-row("__concept_semantic", list("semantic", "semantics")), re-concept-row("__concept_meaning", list("meaning", "meanings")), re-concept-row("__concept_paraphrase", list("paraphrase", "paraphrased", "paraphrases")), re-concept-row("__concept_synonym", list("synonym", "synonyms")), re-concept-row("__concept_trust", list("trust", "trusted", "trustworthy")), re-concept-row("__concept_integrity", list("integrity")), re-concept-row("__concept_authentic", list("authentic", "authenticity")), re-concept-row("__concept_sufficient", list("sufficient", "sufficiency", "enough", "adequate")), re-concept-row("__concept_complete", list("complete", "completeness", "full", "fully")), re-concept-row("__concept_fresh", list("fresh", "freshness")), re-concept-row("__concept_current", list("current", "latest")), re-concept-row("__concept_stale", list("stale")), re-concept-row("__concept_expiry", list("expiry", "expired", "expires")), re-concept-row("__concept_source", list("source", "sources")), re-concept-row("__concept_path", list("path", "paths")), re-concept-row("__concept_file", list("file", "files")), re-concept-row("__concept_document", list("document", "documents", "doc", "docs")), re-concept-row("__concept_fail", list("fail", "failed", "failure", "failures")), re-concept-row("__concept_error", list("error", "errors")), re-concept-row("__concept_broken", list("broken")), re-concept-row("__concept_miss", list("miss", "missed")), re-concept-row("__concept_missing", list("missing")), re-concept-row("__concept_pass", list("pass", "passed")), re-concept-row("__concept_success", list("success", "succeeded", "successful")), re-concept-row("__concept_green", list("green")), re-concept-row("__concept_healthy", list("healthy")), re-concept-row("__concept_merge", list("merge", "merged", "merging")), re-concept-row("__concept_integrate", list("integrate", "integrated", "integration")), re-concept-row("__concept_consolidate", list("consolidate", "consolidated", "consolidation")), re-concept-row("__concept_duplicate", list("duplicate", "duplicated", "duplicates")), re-concept-row("__concept_replace", list("replace", "replaced", "replacement")), re-concept-row("__concept_native", list("native")), re-concept-row("__concept_sovereign", list("sovereign", "sovereignty")), re-concept-row("__concept_local", list("local")), re-concept-row("__concept_offline", list("offline")), re-concept-row("__concept_body", list("body")), re-concept-row("__concept_oracle", list("oracle", "oracles")), re-concept-row("__concept_rented", list("rented")), re-concept-row("__concept_remote", list("remote")), re-concept-row("__concept_model", list("model", "models")), re-concept-row("__concept_llm", list("llm", "llms")), re-concept-row("__concept_frontier", list("frontier")), re-concept-row("__concept_frequency", list("frequency", "frequencies")), re-concept-row("__concept_attune", list("attune", "attuned", "attunement")), re-concept-row("__concept_resonance", list("resonance", "resonant")), re-concept-row("__concept_fear", list("fear")), re-concept-row("__concept_love", list("love")), re-concept-row("__concept_tone", list("tone", "tones")), re-concept-row("__concept_answer", list("answer", "answers")), re-concept-row("__concept_response", list("response", "responses")), re-concept-row("__concept_output", list("output", "outputs")), re-concept-row("__concept_synthesis", list("synthesis")), re-concept-row("__concept_generate", list("generate", "generated", "generation")));
    def re-concept(word) = re-concept-find(word, re-concept-rows());
    def re-word-feature-with(concept-rows, word) = (Comparable) re-stop-word?(word) == 1 ? "" : {
        let concept = re-concept-find(word, concept-rows);
        (String) concept == "" ? re-stem(word) : concept;
    };
    def re-word-feature(word) = re-word-feature-with(re-concept-rows(), word);
    def re-feature-add(feature, features) = (String) feature == "" || (Comparable) re-word-in?(feature, features) == 1 ? features : re-snoc(features, feature);
    def re-semantic-words-loop(concept-rows, words, features) = (Comparable) len(words) == 0 ? features : re-semantic-words-loop(concept-rows, tail(words), re-feature-add(re-word-feature-with(concept-rows, head(words)), features));
    def re-semantic-words(words) = re-semantic-words-loop(re-concept-rows(), words, empty());
    def re-semantic-features(text) = re-semantic-words(re-words(text));
    def re-feature-codes(feature) = list(re-hash(feature), re-second-domain-offset() + re-hash-131(feature));
    def re-semantic-codes(features) = (Comparable) len(features) == 0 ? empty() : {
        let codes = re-feature-codes(head(features));
        cons(nth(codes, 0), cons(nth(codes, 1), re-semantic-codes(tail(features))));
    };
    def re-semantic-vec(text) = re-semantic-codes(re-semantic-features(text));
    0;
}
