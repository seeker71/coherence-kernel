//////////////////////////////////////////////////////////////////////
//
// form-cli-ingest-retrieve.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-ingest-retrieve.bml
//
// Form retrieves ingest laws from the three cells the sealed family
// cites. A hit is a phrase already in the cell. Qwen stays unrun.
// Sealed question text is not stored here.
//
// Proven by: form-stdlib/tests/form-cli-ingest-retrieve-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template RetrieveHit<TPhrase> {
        member path: String;
        member phrase: TPhrase;
        member hit: int;
    }

    class FormIngestRetrieveAuthority {
        field IngestRetrieveAuthorityPath = "form/form-stdlib/bml/form-cli-ingest-retrieve.bml";
        field IngestRetrieveAuthorityKind = "high-bml-class-template-field";
    }

    class FormIngestRetrieve<T> {
        field PhraseHit = 1;
        field PhraseMiss = 0;
        field CollapsePath = "form/form-stdlib/equivalence-collapse.fk";
        field DepthPath = "form/form-stdlib/knowledge-ingest.fk";
        field NboPath = "ingest/name-build-observe.fk";
        field OneCell = "one cell";
        field DepthAtLeast3 = "depth at least 3";
        field WaitsAtTheDoor = "waits at the door";
        field SpanBefore = 128;
        field SpanLimit = 768;

        ref fir-authority = FormIngestRetrieveAuthority;
        thought fir-pattern = list("retrieve", "cell-phrase", "heed-span", "no-qwen");

        def fir-has(hay, needle) = if ge(str_find(hay, needle, 0), 0) then PhraseHit() else PhraseMiss();

        def fir-readable(path) = if gt(str_len(read_file(path)), 0) then PhraseHit() else PhraseMiss();

        def fir-retrieve(path, phrase) = fir-has(read_file(path), phrase);

        def fir-min(a, b) = if lt(a, b) then a else b;

        def fir-max(a, b) = if gt(a, b) then a else b;

        def fir-span-start(first, size) = fir-min(size, fir-max(0, sub(first, SpanBefore())));

        def fir-in-span(hay, atom, phrase) {
            let first = str_find(hay, atom, 0);
            let start = fir-span-start(first, str_len(hay));
            let p = str_find(hay, phrase, start);
            let end = add(start, SpanLimit());
            if lt(first, 0) then PhraseMiss() else if lt(p, 0) then PhraseMiss() else if lt(p, end) then PhraseHit() else PhraseMiss();
        }

        def fir-bit(ok, bit) = if ok then bit else 0;

        def fir-span-check() {
            let collapse = read_file(CollapsePath());
            let depth = read_file(DepthPath());
            let nbo = read_file(NboPath());
            let c0 = fir-bit(eq(fir-in-span(collapse, "Blueprint", OneCell()), PhraseHit()), 1);
            let c1 = fir-bit(eq(fir-in-span(depth, "ki-deep?", DepthAtLeast3()), PhraseHit()), 2);
            let c2 = fir-bit(eq(fir-in-span(nbo, "nbo-enter", WaitsAtTheDoor()), PhraseHit()), 4);
            add(c0, add(c1, c2));
        }

        def fir-check() {
            let collapse = read_file(CollapsePath());
            let depth = read_file(DepthPath());
            let nbo = read_file(NboPath());
            let c0 = fir-bit(eq(fir-readable(CollapsePath()), PhraseHit()), 1);
            let c1 = fir-bit(eq(fir-readable(DepthPath()), PhraseHit()), 2);
            let c2 = fir-bit(eq(fir-readable(NboPath()), PhraseHit()), 4);
            let c3 = fir-bit(eq(fir-retrieve(CollapsePath(), OneCell()), PhraseHit()), 8);
            let c4 = fir-bit(eq(fir-retrieve(DepthPath(), DepthAtLeast3()), PhraseHit()), 16);
            let c5 = fir-bit(eq(fir-retrieve(NboPath(), WaitsAtTheDoor()), PhraseHit()), 32);
            let c6 = fir-bit(eq(fir-has(collapse, "ONE cell"), PhraseHit()), 64);
            let c7 = fir-bit(eq(fir-has(depth, "(ge (ki-depth u) 3)"), PhraseHit()), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
