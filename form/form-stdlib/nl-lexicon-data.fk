            (list "c38" "water" "flow" "aliran")
            (list "c39" "water" "coherence" "koherensi")
            ;; homecoming rows, 2026-09-03 — the first five fresh words with a
            ;; pivot row; every earlier one lived in the English column only
            (list "m1257" "gas" "twicegrown" "tumbuhdua")
            (list "m1258" "gas" "seatrace" "balapkursi")
            (list "m1259" "gas" "afterwall" "pascatembok")
            (list "m1260" "gas" "keloid" "keloid")
            (list "m1261" "gas" "seedshell" "cangkangbenih")
        ))
    0)
