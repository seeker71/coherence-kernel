; nl-lexicon-data.fk — the pivot's corpus lexicon: rows of (symbol phase en id),
; neutral symbol, a tongue a column, a word a row. Two sources feed one table:
;
;   c<i>   projected from web/messages/* by the Form projector nl-lexicon-grow.fk
;          (grow-rows, proven four-way by tests/nl-lexicon-grow-band.fk); phase water.
;   m<mid> minted from learn/homecoming-distillation-corpus.fk: the symbol IS the
;          corpus row's meaning-id, so the row and its pivot share one name by
;          content and no engine; the en column is the row's fresh word, the id
;          column its Bahasa Indonesia surface; phase gas (just-invented) until a
;          native speaker or the corpus settles it. Which fresh words still lack a
;          row is read by form-stdlib/pivot-coverage.bml (release-ledger R12).
;
; preludes: form-stdlib/core.fk

(do
    (defn nlt-corpus-lexicon ()
        (list
            (list "c0" "water" "thesis" "tesis")
            (list "c1" "water" "work" "karya")
            (list "c2" "water" "workshop" "lokakarya")
            (list "c3" "water" "course" "kursus")
            (list "c4" "water" "article" "artikel")
            (list "c5" "water" "essay" "esai")
            (list "c6" "water" "episode" "episode")
            (list "c7" "water" "podcast" "podcast")
            (list "c8" "water" "teaching" "ajaran")
            (list "c9" "water" "book" "buku")
            (list "c10" "water" "event" "acara")
            (list "c11" "water" "film" "film")
            (list "c12" "water" "video" "video")
            (list "c13" "water" "track" "trek")
            (list "c14" "water" "album" "album")
            (list "c15" "water" "works" "karya")
            (list "c16" "water" "home" "rumah")
            (list "c17" "water" "category" "kategori")
            (list "c18" "water" "founded" "didirikan")
            (list "c19" "water" "frequent" "sering")
            (list "c20" "water" "based" "berbasis")
            (list "c21" "water" "home" "rumah")
            (list "c22" "water" "presences" "kehadiran")
            (list "c23" "water" "home" "beranda")
            (list "c24" "water" "materials" "material")
            (list "c25" "water" "atmosphere" "atmosfer")
            (list "c26" "water" "climate" "iklim")
            (list "c27" "water" "open" "buka")
            (list "c28" "water" "subscription" "langganan")
            (list "c29" "water" "gift" "hadiah")
            (list "c30" "water" "description" "deskripsi")
            (list "c31" "water" "title" "judul")
            (list "c32" "water" "sharing" "membagikan")
            (list "c33" "water" "email" "email")
            (list "c34" "water" "begin" "mulai")
            (list "c35" "water" "days" "hari")
