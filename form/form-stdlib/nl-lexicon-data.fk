// nl-lexicon-data.fk — the pivot's corpus lexicon: rows of (symbol phase en id),
// neutral symbol, a tongue a column, a word a row. Two sources feed one table:
//
//   c<i>   projected from web/messages/* by the Form projector nl-lexicon-grow.fk
//          (grow-rows, proven four-way by tests/nl-lexicon-grow-band.fk); phase water.
//   m<mid> minted from learn/homecoming-distillation-corpus.fk: the symbol IS the
//          corpus row's meaning-id, so the row and its pivot share one name by
//          content and no engine; the en column is the row's fresh word, the id
//          column its Bahasa Indonesia surface; phase gas (just-invented) until a
//          native speaker or the corpus settles it. Which fresh words still lack a
//          row is read by form-stdlib/pivot-coverage.bml (release-ledger R12).
//
// preludes: form-stdlib/core.fk
section [form.bml] {
    def nlt-corpus-lexicon() = list(["c0", "water", "thesis", "tesis"], ["c1", "water", "work", "karya"], ["c2", "water", "workshop", "lokakarya"], ["c3", "water", "course", "kursus"], ["c4", "water", "article", "artikel"], ["c5", "water", "essay", "esai"], ["c6", "water", "episode", "episode"], ["c7", "water", "podcast", "podcast"], ["c8", "water", "teaching", "ajaran"], ["c9", "water", "book", "buku"], ["c10", "water", "event", "acara"], ["c11", "water", "film", "film"], ["c12", "water", "video", "video"], ["c13", "water", "track", "trek"], ["c14", "water", "album", "album"], ["c15", "water", "works", "karya"], ["c16", "water", "home", "rumah"], ["c17", "water", "category", "kategori"], ["c18", "water", "founded", "didirikan"], ["c19", "water", "frequent", "sering"], ["c20", "water", "based", "berbasis"], ["c21", "water", "home", "rumah"], ["c22", "water", "presences", "kehadiran"], ["c23", "water", "home", "beranda"], ["c24", "water", "materials", "material"], ["c25", "water", "atmosphere", "atmosfer"], ["c26", "water", "climate", "iklim"], ["c27", "water", "open", "buka"], ["c28", "water", "subscription", "langganan"], ["c29", "water", "gift", "hadiah"], ["c30", "water", "description", "deskripsi"], ["c31", "water", "title", "judul"], ["c32", "water", "sharing", "membagikan"], ["c33", "water", "email", "email"], ["c34", "water", "begin", "mulai"], ["c35", "water", "days", "hari"], ["c36", "water", "commits", "commit"], ["c37", "water", "you", "kau"], ["c38", "water", "flow", "aliran"], ["c39", "water", "coherence", "koherensi"],     //; homecoming rows, 2026-09-03 — the first five fresh words with a
    //; pivot row; every earlier one lived in the English column only
["m1257", "gas", "twicegrown", "tumbuhdua"], ["m1258", "gas", "seatrace", "balapkursi"], ["m1259", "gas", "afterwall", "pascatembok"], ["m1260", "gas", "keloid", "keloid"], ["m1261", "gas", "seedshell", "cangkangbenih"]);
    0;
}
