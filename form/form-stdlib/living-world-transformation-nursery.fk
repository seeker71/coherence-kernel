; living-world-transformation-nursery.fk -- transformations may grow, not win.
;
; The nursery knows no mutation names, synthesis taxonomy, task vocabulary, or
; answer table. A participant may offer any optional local Recipe candidate
; toward an integrated Recipe-data transformation. Exact source-free candidate
; recurrence is evidence. Zero or several eligible candidates leave the field
; OPEN; no NodeID, list order, majority, default, or remote oracle chooses.
;
; A uniquely recurrent, complete candidate may cross a unanimous selection
; membrane and execute through the existing Form-native, source-budgeted Recipe
; evaluator. The trial derives its own before/result boundary and compares it
; with the transformation's reflected boundary. Agreement, correction, silence,
; alternatives, and unknowable remainder remain separate cells.
; Parameter-bearing offers additionally retain the exact offered binding tissue;
; selection and trial re-witness that tissue without choosing parameter names or
; values for the sender.
;
; Independent outcome recurrence may make a growth candidate READY, but it is
; another unanimous boundary, not promotion. Even an integrated growth cell can
; only describe a later LWAC action offer; holders must re-offer that successor
; through the ordinary membrane. Revocation or new ambiguity makes old tissue
; stale without overwriting history.
;
; witnessed: 2026-08-07 -> legacy nursery and parameter-tissue bands 32767
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk

(let LWTN-OFFER              (bp "LWTN-OFFER"))
(let LWTN-OFFER-EVIDENCE     (bp "LWTN-OFFER-EVIDENCE"))
(let LWTN-CANDIDATE          (bp "LWTN-CANDIDATE"))
(let LWTN-CANDIDATE-EVIDENCE (bp "LWTN-CANDIDATE-EVIDENCE"))
(let LWTN-FIELD              (bp "LWTN-FIELD"))
(let LWTN-READY              (bp "LWTN-READY"))
(let LWTN-OPEN               (bp "LWTN-OPEN"))
(let LWTN-UNRESOLVED         (bp "LWTN-UNRESOLVED"))
(let LWTN-SELECTION-ORIGIN   (bp "LWTN-SELECTION-ORIGIN"))
(let LWTN-FLOW               (bp "LWTN-FLOW"))
(let LWTN-TRIAL              (bp "LWTN-TRIAL"))
(let LWTN-TRIAL-ORIGIN       (bp "LWTN-TRIAL-ORIGIN"))
(let LWTN-OBSERVATION        (bp "LWTN-OBSERVATION"))
(let LWTN-EVIDENCE           (bp "LWTN-EVIDENCE"))
(let LWTN-EVIDENCE-SET       (bp "LWTN-EVIDENCE-SET"))
(let LWTN-GROWTH             (bp "LWTN-GROWTH"))
(let LWTN-GROWTH-ORIGIN      (bp "LWTN-GROWTH-ORIGIN"))

(defn lwtn-status (kind) (intern_node kind (empty)))
(defn lwtn-ready () (lwtn-status LWTN-READY))
(defn lwtn-open () (lwtn-status LWTN-OPEN))
(defn lwtn-ready? (status) (if (node_eq status (lwtn-ready)) 1 0))
(defn lwtn-open? (status) (if (node_eq status (lwtn-open)) 1 0))

; --- optional Recipe offers ---------------------------------------------

; children: optional transformation candidate, Recipe, declaration, lens,
; before; alternatives, optional unknown/choice/timeout, evidence, local path
(defn lwtn-offer
    (target recipe declaration lens before alternatives unknown choice timeout
     evidence)
    (intern_node LWTN-OFFER
        (list target recipe declaration lens before alternatives unknown choice
              timeout evidence (lwo-local-path))))
(defn lwtn-bound-offer
    (target recipe declaration lens before alternatives unknown choice timeout
     evidence bindings)
    (intern_node LWTN-OFFER
        (list target recipe declaration lens before alternatives unknown choice
              timeout evidence bindings (lwo-local-path))))
(defn lwtn-offer? (cell) (lwo-category? cell LWTN-OFFER))
(defn lwtn-offer-target (offer) (nth (node_children offer) 0))
(defn lwtn-offer-recipe (offer) (nth (node_children offer) 1))
(defn lwtn-offer-declaration (offer) (nth (node_children offer) 2))
(defn lwtn-offer-lens (offer) (nth (node_children offer) 3))
(defn lwtn-offer-before (offer) (nth (node_children offer) 4))
(defn lwtn-offer-alternatives (offer) (nth (node_children offer) 5))
(defn lwtn-offer-unknown (offer) (nth (node_children offer) 6))
(defn lwtn-offer-choice (offer) (nth (node_children offer) 7))
(defn lwtn-offer-timeout (offer) (nth (node_children offer) 8))
(defn lwtn-offer-evidence (offer) (nth (node_children offer) 9))
(defn lwtn-offer-bindings (offer)
    (if (eq (len (node_children offer)) 11) (lwre-empty-bindings)
        (nth (node_children offer) 10)))
(defn lwtn-offer-path (offer)
    (if (eq (len (node_children offer)) 11)
        (nth (node_children offer) 10)
        (nth (node_children offer) 11)))

(defn lwtn-optional-target-valid? (target)
    (if (or (node_eq target (lwo-none))
            (eq (lwrx-candidate? target) 1)) 1 0))
(defn lwtn-optional-recipe-valid? (recipe)
    (if (or (node_eq recipe (lwo-none))
            (eq (lwre-recipe? recipe) 1)) 1 0))
(defn lwtn-optional-declaration-valid? (declaration)
    (if (or (node_eq declaration (lwo-none))
            (eq (lwlc-declaration-valid? declaration) 1)) 1 0))
(defn lwtn-optional-lens-valid? (lens)
    (if (or (node_eq lens (lwo-none))
            (eq (lwlc-lens? lens) 1)) 1 0))
(defn lwtn-offer-valid? (offer)
    (if (eq (lwtn-offer? offer) 0) 0
        (if (eq (lwtn-optional-target-valid?
                    (lwtn-offer-target offer)) 0) 0
            (if (eq (lwtn-optional-recipe-valid?
                        (lwtn-offer-recipe offer)) 0) 0
                (if (eq (lwtn-optional-declaration-valid?
                            (lwtn-offer-declaration offer)) 0) 0
                    (if (eq (lwtn-optional-lens-valid?
                                (lwtn-offer-lens offer)) 0) 0
                        (if (eq (lwo-category?
                                    (lwtn-offer-alternatives offer)
                                    LWO-FIELD) 0) 0
                            (if (eq (lwac-optional-unknown-valid?
                                        (lwtn-offer-unknown offer)) 0) 0
                                (if (eq (lwlc-choice-valid?
                                            (lwtn-offer-choice offer)) 0) 0
                                    (if (eq (lwac-optional-timeout-valid?
                                                (lwtn-offer-timeout offer)) 0)
                                        0
                                        (lwre-bindings-valid?
                                            (lwtn-offer-bindings offer))))))))))))

; Evidence and source are not candidate identity. Every optional offered choice
; remains part of identity; absence is therefore not silently filled.
(defn lwtn-candidate
    (target recipe declaration lens before alternatives unknown choice timeout)
    (intern_node LWTN-CANDIDATE
        (list target recipe declaration lens before alternatives unknown choice
              timeout (lwo-local-path))))
(defn lwtn-bound-candidate
    (target recipe declaration lens before alternatives unknown choice timeout
     bindings)
    (intern_node LWTN-CANDIDATE
        (list target recipe declaration lens before alternatives unknown choice
              timeout bindings (lwo-local-path))))
(defn lwtn-candidate? (cell) (lwo-category? cell LWTN-CANDIDATE))
(defn lwtn-candidate-target (candidate) (nth (node_children candidate) 0))
(defn lwtn-candidate-recipe (candidate) (nth (node_children candidate) 1))
(defn lwtn-candidate-declaration (candidate) (nth (node_children candidate) 2))
(defn lwtn-candidate-lens (candidate) (nth (node_children candidate) 3))
(defn lwtn-candidate-before (candidate) (nth (node_children candidate) 4))
(defn lwtn-candidate-alternatives (candidate)
    (nth (node_children candidate) 5))
(defn lwtn-candidate-unknown (candidate) (nth (node_children candidate) 6))
(defn lwtn-candidate-choice (candidate) (nth (node_children candidate) 7))
(defn lwtn-candidate-timeout (candidate) (nth (node_children candidate) 8))
(defn lwtn-candidate-bindings (candidate)
    (if (eq (len (node_children candidate)) 10) (lwre-empty-bindings)
        (nth (node_children candidate) 9)))
(defn lwtn-candidate-path (candidate)
    (if (eq (len (node_children candidate)) 10)
        (nth (node_children candidate) 9)
        (nth (node_children candidate) 10)))

(defn lwtn-candidate-for-offer (offer)
    (if (eq (lwtn-offer-valid? offer) 0) (lwo-none)
        (do
            (let bindings (lwtn-offer-bindings offer))
            (if (eq (len (lwre-binding-items bindings)) 0)
                (lwtn-candidate
                    (lwtn-offer-target offer)
                    (lwtn-offer-recipe offer)
                    (lwtn-offer-declaration offer)
                    (lwtn-offer-lens offer)
                    (lwtn-offer-before offer)
                    (lwtn-offer-alternatives offer)
                    (lwtn-offer-unknown offer)
                    (lwtn-offer-choice offer)
                    (lwtn-offer-timeout offer))
                (lwtn-bound-candidate
                    (lwtn-offer-target offer)
                    (lwtn-offer-recipe offer)
                    (lwtn-offer-declaration offer)
                    (lwtn-offer-lens offer)
                    (lwtn-offer-before offer)
                    (lwtn-offer-alternatives offer)
                    (lwtn-offer-unknown offer)
                    (lwtn-offer-choice offer)
                    (lwtn-offer-timeout offer) bindings)))))

; children: exact offer and every active attribution for it
(defn lwtn-offer-evidence-cell (offer attributions)
    (intern_node LWTN-OFFER-EVIDENCE (list offer attributions)))
(defn lwtn-offer-evidence? (cell)
    (lwo-category? cell LWTN-OFFER-EVIDENCE))
(defn lwtn-offer-evidence-offer (evidence)
    (nth (node_children evidence) 0))
(defn lwtn-offer-evidence-attributions (evidence)
    (nth (node_children evidence) 1))

(defn lwtn-collect-offers (world items target field)
    (if (eq (len items) 0) field
        (do
            (let offer (head items))
            (if (and (eq (lwtn-offer-valid? offer) 1)
                     (and (node_eq (lwtn-offer-target offer) target)
                          (eq (lwo-active? world offer) 1)))
                (lwtn-collect-offers world (tail items) target
                    (lwo-field-add field
                        (lwtn-offer-evidence-cell offer
                            (lwo-active-attributions-for world offer))))
                (lwtn-collect-offers world (tail items) target field)))))
(defn lwtn-offers-for (world target)
    (lwtn-collect-offers world
        (lwo-field-items (lwo-world-cells world)) target
        (lwo-empty-field)))

(defn lwtn-candidate-offer-evidence-items
    (items candidate offers witnesses)
    (if (eq (len items) 0) (list offers witnesses)
        (do
            (let evidence (head items))
            (let offer (lwtn-offer-evidence-offer evidence))
            (if (node_eq (lwtn-candidate-for-offer offer) candidate)
                (lwtn-candidate-offer-evidence-items (tail items) candidate
                    (lwo-field-add offers evidence)
                    (lwac-field-union-items
                        (lwo-field-items
                            (lwtn-offer-evidence-attributions evidence))
                        witnesses))
                (lwtn-candidate-offer-evidence-items (tail items) candidate
                    offers witnesses)))))

; children: exact source-free candidate, matching offers, offer attributions
(defn lwtn-candidate-evidence (candidate offers witnesses)
    (intern_node LWTN-CANDIDATE-EVIDENCE
        (list candidate offers witnesses)))
(defn lwtn-candidate-evidence? (cell)
    (lwo-category? cell LWTN-CANDIDATE-EVIDENCE))
(defn lwtn-candidate-evidence-candidate (evidence)
    (nth (node_children evidence) 0))
(defn lwtn-candidate-evidence-offers (evidence)
    (nth (node_children evidence) 1))
(defn lwtn-candidate-evidence-witnesses (evidence)
    (nth (node_children evidence) 2))

(defn lwtn-evidence-for-candidate (offer-items candidate)
    (do
        (let pair
            (lwtn-candidate-offer-evidence-items offer-items candidate
                (lwo-empty-field) (lwo-empty-field)))
        (lwtn-candidate-evidence candidate (nth pair 0) (nth pair 1))))
(defn lwtn-candidates-have? (items candidate)
    (if (eq (len items) 0) 0
        (if (node_eq
                (lwtn-candidate-evidence-candidate (head items)) candidate)
            1 (lwtn-candidates-have? (tail items) candidate))))
(defn lwtn-collect-candidates (offer-items remaining field)
    (if (eq (len remaining) 0) field
        (do
            (let candidate
                (lwtn-candidate-for-offer
                    (lwtn-offer-evidence-offer (head remaining))))
            (if (eq (lwtn-candidates-have?
                        (lwo-field-items field) candidate) 1)
                (lwtn-collect-candidates offer-items (tail remaining) field)
                (lwtn-collect-candidates offer-items (tail remaining)
                    (lwo-field-add field
                        (lwtn-evidence-for-candidate
                            offer-items candidate)))))))
(defn lwtn-candidates-for (offers)
    (do
        (let items (lwo-field-items offers))
        (lwtn-collect-candidates items items (lwo-empty-field))))

(defn lwtn-candidate-complete-current? (world candidate)
    (do
        (let target (lwtn-candidate-target candidate))
        (let recipe (lwtn-candidate-recipe candidate))
        (let declaration (lwtn-candidate-declaration candidate))
        (let lens (lwtn-candidate-lens candidate))
        (let before (lwtn-candidate-before candidate))
        (let bindings (lwtn-candidate-bindings candidate))
        (if (or (node_eq target (lwo-none))
                (or (node_eq recipe (lwo-none))
                    (or (node_eq declaration (lwo-none))
                        (or (node_eq lens (lwo-none))
                            (node_eq before (lwo-none)))))) 0
            (if (eq (lwrx-integrated-current? world target) 0) 0
                (if (eq (lwre-recipe-valid? recipe) 0) 0
                    (if (not (node_eq (lwlc-lens-payload lens) recipe)) 0
                        (if (eq (lwre-lens-current?
                                    world declaration lens) 0) 0
                            (if (eq (lwre-bindings-current?
                                      world bindings) 0) 0
                                (if (or
                                     (and (eq (len
                                              (lwre-binding-items bindings)) 0)
                                          (eq (lwre-unbound-contract?
                                                (lwre-recipe-contract recipe)) 0))
                                     (and (gt (len
                                              (lwre-binding-items bindings)) 0)
                                          (eq (lwre-bound-contract?
                                                (lwre-recipe-contract recipe)) 0)))
                                    0
                                    (if (not (node_eq before
                                              (lwrx-overall-before
                                                (lwrx-transformation-overall
                                                  (lwo-emergent-shape target)))))
                                        0 1))))))))))
(defn lwtn-candidate-eligible? (world evidence threshold)
    (if (and (eq (lwtn-candidate-complete-current? world
                       (lwtn-candidate-evidence-candidate evidence)) 1)
             (ge (lwo-field-size
                     (lwtn-candidate-evidence-witnesses evidence))
                 threshold)) 1 0))
(defn lwtn-eligible-items (world items threshold field)
    (if (eq (len items) 0) field
        (lwtn-eligible-items world (tail items) threshold
            (if (eq (lwtn-candidate-eligible?
                        world (head items) threshold) 1)
                (lwo-field-add field (head items)) field))))

(defn lwtn-offered-alternatives-items (items field)
    (if (eq (len items) 0) field
        (lwtn-offered-alternatives-items (tail items)
            (lwac-field-union-items
                (lwo-field-items
                    (lwtn-offer-alternatives
                        (lwtn-offer-evidence-offer (head items))))
                field))))
(defn lwtn-offered-unknowns-items (items field)
    (if (eq (len items) 0) field
        (do
            (let unknown
                (lwtn-offer-unknown
                    (lwtn-offer-evidence-offer (head items))))
            (lwtn-offered-unknowns-items (tail items)
                (if (node_eq unknown (lwo-none)) field
                    (lwo-field-add field unknown))))))
(defn lwtn-candidate-alternatives-items (items primary field)
    (if (eq (len items) 0) field
        (lwtn-candidate-alternatives-items (tail items) primary
            (if (node_eq (head items) primary) field
                (lwo-field-add field (head items))))))

(defn lwtn-dependency-witnesses (world candidate field)
    (do
        (let with-target
            (lwac-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world
                        (lwtn-candidate-target candidate))) field))
        (let recipe (lwtn-candidate-recipe candidate))
        (let with-recipe
            (if (node_eq recipe (lwo-none)) with-target
                (lwac-field-union-items
                    (lwo-field-items
                        (lwo-active-attributions-for world recipe))
                    with-target)))
        (let declaration (lwtn-candidate-declaration candidate))
        (let with-declaration
            (if (node_eq declaration (lwo-none)) with-recipe
                (lwac-field-union-items
                    (lwo-field-items
                        (lwo-active-attributions-for world declaration))
                    with-recipe)))
        (let before (lwtn-candidate-before candidate))
        (let with-before
            (if (node_eq before (lwo-none)) with-declaration
                (lwac-field-union-items
                    (lwo-field-items
                        (lwo-active-attributions-for world before))
                    with-declaration)))
        (lwac-field-union-items
            (lwo-field-items
                (lwre-binding-witnesses
                    world (lwtn-candidate-bindings candidate)))
            with-before)))
(defn lwtn-field-witnesses-items (world items field)
    (if (eq (len items) 0) field
        (do
            (let evidence (head items))
            (let with-offers
                (lwac-field-union-items
                    (lwo-field-items
                        (lwtn-candidate-evidence-witnesses evidence)) field))
            (lwtn-field-witnesses-items world (tail items)
                (lwtn-dependency-witnesses world
                    (lwtn-candidate-evidence-candidate evidence)
                    with-offers)))))

(defn lwtn-unresolved (target candidates threshold)
    (intern_node LWTN-UNRESOLVED
        (list target candidates (intern_trivial_int threshold)
              (lwo-local-path))))

; children: target, READY/OPEN, optional primary evidence, all candidates,
; alternatives, offered unknowns, optional derived unknown, witnesses,
; recurrence threshold, local path
(defn lwtn-field
    (target status primary candidates alternatives unknowns derived witnesses
     threshold)
    (intern_node LWTN-FIELD
        (list target status primary candidates alternatives unknowns derived
              witnesses (intern_trivial_int threshold) (lwo-local-path))))
(defn lwtn-field? (cell) (lwo-category? cell LWTN-FIELD))
(defn lwtn-field-target (field) (nth (node_children field) 0))
(defn lwtn-field-status (field) (nth (node_children field) 1))
(defn lwtn-field-primary (field) (nth (node_children field) 2))
(defn lwtn-field-candidates (field) (nth (node_children field) 3))
(defn lwtn-field-alternatives (field) (nth (node_children field) 4))
(defn lwtn-field-unknowns (field) (nth (node_children field) 5))
(defn lwtn-field-derived-unknown (field) (nth (node_children field) 6))
(defn lwtn-field-witnesses (field) (nth (node_children field) 7))
(defn lwtn-field-threshold-cell (field) (nth (node_children field) 8))
(defn lwtn-field-threshold (field)
    (node_value (lwtn-field-threshold-cell field)))
(defn lwtn-field-path (field) (nth (node_children field) 9))

(defn lwtn-field-for (world target threshold)
    (do
        (let offers (lwtn-offers-for world target))
        (let offer-items (lwo-field-items offers))
        (let candidates (lwtn-candidates-for offers))
        (let candidate-items (lwo-field-items candidates))
        (let eligible
            (lwtn-eligible-items world candidate-items threshold
                (lwo-empty-field)))
        (let eligible-items (lwo-field-items eligible))
        (let ready (if (eq (len eligible-items) 1) 1 0))
        (let primary (if (eq ready 1) (head eligible-items) (lwo-none)))
        (let offered-alternatives
            (lwtn-offered-alternatives-items offer-items
                (lwo-empty-field)))
        (let alternatives
            (lwtn-candidate-alternatives-items candidate-items primary
                offered-alternatives))
        (let unknowns
            (lwtn-offered-unknowns-items offer-items (lwo-empty-field)))
        (let derived
            (if (eq ready 1) (lwo-none)
                (lwlc-unknown
                    (lwtn-unresolved target candidates threshold))))
        (let witnesses
            (lwtn-field-witnesses-items world candidate-items
                (lwo-empty-field)))
        (lwtn-field target
            (if (eq ready 1) (lwtn-ready) (lwtn-open))
            primary candidates alternatives unknowns derived witnesses
            threshold)))

(defn lwtn-selection-origin (target threshold)
    (intern_node LWTN-SELECTION-ORIGIN
        (list target (intern_trivial_int threshold) (lwo-local-path))))
(defn lwtn-selection-proposal (world target threshold)
    (do
        (let field (lwtn-field-for world target threshold))
        (if (eq (lwtn-ready? (lwtn-field-status field)) 0) (lwo-none)
            (do
                (let witnesses (lwtn-field-witnesses field))
                (let count (lwo-field-size witnesses))
                (let origin (lwtn-selection-origin target threshold))
                (let candidate
                    (lwo-emergent field witnesses
                        (intern_trivial_int 1)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwtn-selection-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwtn-field? (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwtn-selection-candidate-current? (world candidate)
    (if (eq (lwtn-selection-candidate? candidate) 0) 0
        (do
            (let field (lwo-emergent-shape candidate))
            (let current
                (lwtn-field-for world (lwtn-field-target field)
                    (lwtn-field-threshold field)))
            (if (and (eq (lwtn-ready? (lwtn-field-status current)) 1)
                     (and (node_eq field current)
                          (node_eq (lwo-emergent-witnesses candidate)
                              (lwtn-field-witnesses current)))) 1 0))))
(defn lwtn-selection-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwtn-selection-candidate-current? world candidate) 1)) 1 0))
(defn lwtn-selection-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwtn-selection-candidate-current? world
            (lwt-proposal-candidate proposal))))
(defn lwtn-selection-integrate (round proposal action)
    (if (eq (lwtn-selection-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; --- native candidate trial --------------------------------------------

(defn lwtn-flow (selection candidate)
    (intern_node LWTN-FLOW
        (list selection candidate (lwtn-candidate-target candidate)
              (lwtn-candidate-recipe candidate) (lwo-local-path))))
(defn lwtn-flow? (cell) (lwo-category? cell LWTN-FLOW))

(defn lwtn-trace-for (world selection evidence)
    (if (eq (lwtn-selection-integrated-current?
                world selection) 0) (lwo-none)
        (do
            (let field (lwo-emergent-shape selection))
            (let primary (lwtn-field-primary field))
            (let candidate
                (lwtn-candidate-evidence-candidate primary))
            (let flow (lwtn-flow selection candidate))
            (let first
                (lwre-execute-bound world
                    (lwtn-candidate-declaration candidate)
                    (lwtn-candidate-lens candidate)
                    (lwtn-candidate-before candidate)
                    (lwtn-candidate-bindings candidate)
                    (lwtn-candidate-alternatives candidate)
                    (lwtn-candidate-unknown candidate)
                    (lwtn-candidate-choice candidate)
                    flow (lwo-none) evidence))
            (if (node_eq first (lwo-none)) (lwo-none)
                (do
                    (let actual
                        (lwrx-overall
                            (lwre-trace-before first)
                            (lwre-result-primary
                                (lwre-trace-result first))
                            (lwrx-lens-sequence
                                (list (lwre-trace-lens first)))))
                    (lwre-execute-bound world
                        (lwtn-candidate-declaration candidate)
                        (lwtn-candidate-lens candidate)
                        (lwtn-candidate-before candidate)
                        (lwtn-candidate-bindings candidate)
                        (lwtn-candidate-alternatives candidate)
                        (lwtn-candidate-unknown candidate)
                        (lwtn-candidate-choice candidate)
                        flow actual evidence))))))

(defn lwtn-boundary-agrees? (expected actual)
    (if (and (node_eq (lwrx-overall-before expected)
                      (lwrx-overall-before actual))
             (node_eq (lwrx-overall-after expected)
                      (lwrx-overall-after actual))) 1 0))
(defn lwtn-comparison (expected actual evidence)
    (if (eq (lwtn-boundary-agrees? expected actual) 1)
        (oac-one actual)
        (oac-alternative-ack expected actual evidence)))
(defn lwtn-time-observation (candidate observed-time)
    (do
        (let timeout (lwtn-candidate-timeout candidate))
        (if (or (node_eq timeout (lwo-none))
                (node_eq observed-time (lwo-none)))
            (lwo-none)
            (oac-timeout-condense timeout observed-time))))

; children: integrated selection, exact candidate, native trace, expected and
; actual boundaries, immediate comparison, optional time and timeout result,
; retained alternatives/unknowns, evidence, local path
(defn lwtn-trial
    (selection candidate trace expected actual comparison observed-time
     time-observation alternatives unknowns evidence)
    (intern_node LWTN-TRIAL
        (list selection candidate trace expected actual comparison observed-time
              time-observation alternatives unknowns evidence
              (lwo-local-path))))
(defn lwtn-trial? (cell) (lwo-category? cell LWTN-TRIAL))
(defn lwtn-trial-selection (trial) (nth (node_children trial) 0))
(defn lwtn-trial-candidate (trial) (nth (node_children trial) 1))
(defn lwtn-trial-trace (trial) (nth (node_children trial) 2))
(defn lwtn-trial-expected (trial) (nth (node_children trial) 3))
(defn lwtn-trial-actual (trial) (nth (node_children trial) 4))
(defn lwtn-trial-comparison (trial) (nth (node_children trial) 5))
(defn lwtn-trial-observed-time (trial) (nth (node_children trial) 6))
(defn lwtn-trial-time-observation (trial) (nth (node_children trial) 7))
(defn lwtn-trial-alternatives (trial) (nth (node_children trial) 8))
(defn lwtn-trial-unknowns (trial) (nth (node_children trial) 9))
(defn lwtn-trial-evidence (trial) (nth (node_children trial) 10))
(defn lwtn-trial-path (trial) (nth (node_children trial) 11))

(defn lwtn-trial-for (world selection observed-time evidence)
    (do
        (let trace (lwtn-trace-for world selection evidence))
        (if (node_eq trace (lwo-none)) (lwo-none)
            (do
                (let field (lwo-emergent-shape selection))
                (let primary (lwtn-field-primary field))
                (let candidate
                    (lwtn-candidate-evidence-candidate primary))
                (let target (lwtn-candidate-target candidate))
                (let expected
                    (lwrx-transformation-overall
                        (lwo-emergent-shape target)))
                (let actual (lwre-trace-changes trace))
                (lwtn-trial selection candidate trace expected actual
                    (lwtn-comparison expected actual evidence)
                    observed-time
                    (lwtn-time-observation candidate observed-time)
                    (lwtn-field-alternatives field)
                    (lwtn-field-unknowns field) evidence)))))
(defn lwtn-trial-current? (world trial)
    (if (eq (lwtn-trial? trial) 0) 0
        (if (node_eq trial
                (lwtn-trial-for world
                    (lwtn-trial-selection trial)
                    (lwtn-trial-observed-time trial)
                    (lwtn-trial-evidence trial))) 1 0)))
(defn lwtn-trial-witnesses (world trial)
    (lwac-field-union-items
        (lwo-field-items
            (lwo-active-attributions-for world
                (lwtn-trial-selection trial)))
        (lwre-trace-witnesses (lwtn-trial-trace trial))))
(defn lwtn-trial-origin (trial)
    (intern_node LWTN-TRIAL-ORIGIN (list trial (lwo-local-path))))
(defn lwtn-trial-proposal (world selection observed-time evidence)
    (do
        (let trial (lwtn-trial-for world selection observed-time evidence))
        (if (node_eq trial (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwtn-trial-witnesses world trial))
                (let count (lwo-field-size witnesses))
                (let origin (lwtn-trial-origin trial))
                (let candidate
                    (lwo-emergent trial witnesses
                        (intern_trivial_int 1)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwtn-trial-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwtn-trial? (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwtn-trial-candidate-current? (world candidate)
    (if (eq (lwtn-trial-candidate? candidate) 0) 0
        (do
            (let trial (lwo-emergent-shape candidate))
            (let current
                (lwtn-trial-for world
                    (lwtn-trial-selection trial)
                    (lwtn-trial-observed-time trial)
                    (lwtn-trial-evidence trial)))
            (if (and (node_eq trial current)
                     (node_eq (lwo-emergent-witnesses candidate)
                        (lwtn-trial-witnesses world current))) 1 0))))
(defn lwtn-trial-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwtn-trial-candidate-current? world candidate) 1)) 1 0))
(defn lwtn-trial-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwtn-trial-candidate-current? world
            (lwt-proposal-candidate proposal))))
(defn lwtn-trial-integrate (round proposal action)
    (if (eq (lwtn-trial-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; --- independently repeated result observation --------------------------

; children: trial candidate, optional observed boundary, exact ack,
; alternatives, optional unknown, evidence, local path
(defn lwtn-observation
    (trial observed ack alternatives unknown evidence)
    (intern_node LWTN-OBSERVATION
        (list trial observed ack alternatives unknown evidence
              (lwo-local-path))))
(defn lwtn-observation? (cell) (lwo-category? cell LWTN-OBSERVATION))
(defn lwtn-observation-trial (observation) (nth (node_children observation) 0))
(defn lwtn-observation-observed (observation)
    (nth (node_children observation) 1))
(defn lwtn-observation-ack (observation) (nth (node_children observation) 2))
(defn lwtn-observation-alternatives (observation)
    (nth (node_children observation) 3))
(defn lwtn-observation-unknown (observation)
    (nth (node_children observation) 4))
(defn lwtn-observation-offered-evidence (observation)
    (nth (node_children observation) 5))
(defn lwtn-observation-path (observation) (nth (node_children observation) 6))

(defn lwtn-observation-coherent? (observation)
    (do
        (let trial
            (lwo-emergent-shape (lwtn-observation-trial observation)))
        (let actual (lwtn-trial-actual trial))
        (let observed (lwtn-observation-observed observation))
        (let ack (lwtn-observation-ack observation))
        (if (eq (oac-one? ack) 1)
            (if (and (node_eq observed actual)
                     (node_eq (oac-payload ack) actual)) 1 0)
            (if (eq (oac-zero? ack) 1)
                (if (and (not (node_eq observed (lwo-none)))
                         (not (node_eq observed actual))) 1 0)
                (if (eq (oac-nothing? ack) 1)
                    (if (node_eq observed (lwo-none)) 1 0)
                    (if (eq (oac-alternative-ack? ack) 1)
                        (do
                            (let alternative (oac-payload ack))
                            (if (and (node_eq
                                      (oac-alternative-reference alternative)
                                      actual)
                                     (node_eq
                                      (oac-alternative-offered alternative)
                                      observed)) 1 0))
                        (if (eq (oac-node? ack) 1)
                            (if (node_eq (oac-payload ack) observed) 1 0)
                            0)))))))
(defn lwtn-observation-valid? (observation)
    (if (eq (lwtn-observation? observation) 0) 0
        (if (eq (lwtn-trial-candidate?
                    (lwtn-observation-trial observation)) 0) 0
            (if (eq (oac-valid-ack?
                        (lwtn-observation-ack observation)) 0) 0
                (if (eq (lwo-category?
                            (lwtn-observation-alternatives observation)
                            LWO-FIELD) 0) 0
                    (if (eq (lwac-optional-unknown-valid?
                                (lwtn-observation-unknown observation)) 0) 0
                        (lwtn-observation-coherent? observation)))))))

(defn lwtn-independent-attributions-items (world items trial field)
    (if (eq (len items) 0) field
        (do
            (let attribution (head items))
            (let source (lwo-attribution-source attribution))
            (lwtn-independent-attributions-items world (tail items) trial
                (if (eq (lwo-active-by? world trial source) 1) field
                    (lwo-field-add field attribution))))))
(defn lwtn-independent-attributions (world observation)
    (lwtn-independent-attributions-items world
        (lwo-field-items
            (lwo-active-attributions-for world observation))
        (lwtn-observation-trial observation) (lwo-empty-field)))

; children: exact observation and independent attribution witnesses
(defn lwtn-evidence (observation attributions)
    (intern_node LWTN-EVIDENCE (list observation attributions)))
(defn lwtn-evidence-observation (evidence) (nth (node_children evidence) 0))
(defn lwtn-evidence-attributions (evidence) (nth (node_children evidence) 1))

; children: confirmations, corrections, silences, alternatives, unresolved
(defn lwtn-evidence-set
    (confirmations corrections silences alternatives unresolved)
    (intern_node LWTN-EVIDENCE-SET
        (list confirmations corrections silences alternatives unresolved)))
(defn lwtn-evidence-confirmations (set) (nth (node_children set) 0))
(defn lwtn-evidence-corrections (set) (nth (node_children set) 1))
(defn lwtn-evidence-silences (set) (nth (node_children set) 2))
(defn lwtn-evidence-alternatives (set) (nth (node_children set) 3))
(defn lwtn-evidence-unresolved (set) (nth (node_children set) 4))
(defn lwtn-empty-evidence-set ()
    (lwtn-evidence-set
        (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)
        (lwo-empty-field) (lwo-empty-field)))

(defn lwtn-classify-evidence (evidence set)
    (do
        (let observation (lwtn-evidence-observation evidence))
        (let ack (lwtn-observation-ack observation))
        (if (eq (oac-one? ack) 1)
            (lwtn-evidence-set
                (lwo-field-add (lwtn-evidence-confirmations set) evidence)
                (lwtn-evidence-corrections set)
                (lwtn-evidence-silences set)
                (lwtn-evidence-alternatives set)
                (lwtn-evidence-unresolved set))
            (if (eq (oac-zero? ack) 1)
                (lwtn-evidence-set
                    (lwtn-evidence-confirmations set)
                    (lwo-field-add (lwtn-evidence-corrections set) evidence)
                    (lwtn-evidence-silences set)
                    (lwtn-evidence-alternatives set)
                    (lwtn-evidence-unresolved set))
                (if (eq (oac-nothing? ack) 1)
                    (lwtn-evidence-set
                        (lwtn-evidence-confirmations set)
                        (lwtn-evidence-corrections set)
                        (lwo-field-add
                            (lwtn-evidence-silences set) evidence)
                        (lwtn-evidence-alternatives set)
                        (lwtn-evidence-unresolved set))
                    (if (eq (oac-alternative-ack? ack) 1)
                        (lwtn-evidence-set
                            (lwtn-evidence-confirmations set)
                            (lwtn-evidence-corrections set)
                            (lwtn-evidence-silences set)
                            (lwo-field-add
                                (lwtn-evidence-alternatives set) evidence)
                            (lwtn-evidence-unresolved set))
                        (lwtn-evidence-set
                            (lwtn-evidence-confirmations set)
                            (lwtn-evidence-corrections set)
                            (lwtn-evidence-silences set)
                            (lwtn-evidence-alternatives set)
                            (lwo-field-add
                                (lwtn-evidence-unresolved set) evidence))))))))
(defn lwtn-collect-evidence-items (world items trial set)
    (if (eq (len items) 0) set
        (do
            (let observation (head items))
            (if (and (eq (lwtn-observation-valid? observation) 1)
                     (and (node_eq
                              (lwtn-observation-trial observation) trial)
                          (eq (lwo-active? world observation) 1)))
                (do
                    (let attributions
                        (lwtn-independent-attributions world observation))
                    (if (eq (lwo-field-size attributions) 0)
                        (lwtn-collect-evidence-items world (tail items)
                            trial set)
                        (lwtn-collect-evidence-items world (tail items) trial
                            (lwtn-classify-evidence
                                (lwtn-evidence observation attributions)
                                set))))
                (lwtn-collect-evidence-items world (tail items) trial set)))))
(defn lwtn-evidence-for (world trial)
    (lwtn-collect-evidence-items world
        (lwo-field-items (lwo-world-cells world)) trial
        (lwtn-empty-evidence-set)))

(defn lwtn-evidence-count-items (items count)
    (if (eq (len items) 0) count
        (lwtn-evidence-count-items (tail items)
            (add count
                (lwo-field-size
                    (lwtn-evidence-attributions (head items)))))))
(defn lwtn-evidence-count (field)
    (lwtn-evidence-count-items (lwo-field-items field) 0))
(defn lwtn-confirmation-count (set)
    (lwtn-evidence-count (lwtn-evidence-confirmations set)))
(defn lwtn-contention-count (set)
    (add (lwtn-evidence-count (lwtn-evidence-corrections set))
        (add (lwtn-evidence-count (lwtn-evidence-alternatives set))
             (lwtn-evidence-count (lwtn-evidence-unresolved set)))))

(defn lwtn-evidence-witness-items (items field)
    (if (eq (len items) 0) field
        (lwtn-evidence-witness-items (tail items)
            (lwac-field-union-items
                (lwo-field-items
                    (lwtn-evidence-attributions (head items))) field))))
(defn lwtn-growth-witnesses (world trial set)
    (do
        (let with-trial
            (lwac-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world trial))
                (lwo-empty-field)))
        (let confirmations
            (lwtn-evidence-witness-items
                (lwo-field-items (lwtn-evidence-confirmations set))
                with-trial))
        (let corrections
            (lwtn-evidence-witness-items
                (lwo-field-items (lwtn-evidence-corrections set))
                confirmations))
        (let silences
            (lwtn-evidence-witness-items
                (lwo-field-items (lwtn-evidence-silences set))
                corrections))
        (let alternatives
            (lwtn-evidence-witness-items
                (lwo-field-items (lwtn-evidence-alternatives set))
                silences))
        (lwtn-evidence-witness-items
            (lwo-field-items (lwtn-evidence-unresolved set)) alternatives)))

(defn lwtn-observation-alternative-items (items field)
    (if (eq (len items) 0) field
        (do
            (let observation
                (lwtn-evidence-observation (head items)))
            (let with-explicit
                (lwac-field-union-items
                    (lwo-field-items
                        (lwtn-observation-alternatives observation)) field))
            (let observed (lwtn-observation-observed observation))
            (lwtn-observation-alternative-items (tail items)
                (if (node_eq observed (lwo-none)) with-explicit
                    (lwo-field-add with-explicit observed))))))
(defn lwtn-growth-alternatives (trial-cell set)
    (do
        (let base (lwtn-trial-alternatives trial-cell))
        (let corrections
            (lwtn-observation-alternative-items
                (lwo-field-items (lwtn-evidence-corrections set)) base))
        (let alternatives
            (lwtn-observation-alternative-items
                (lwo-field-items (lwtn-evidence-alternatives set))
                corrections))
        (lwtn-observation-alternative-items
            (lwo-field-items (lwtn-evidence-unresolved set)) alternatives)))
(defn lwtn-observation-unknown-items (items field)
    (if (eq (len items) 0) field
        (do
            (let unknown
                (lwtn-observation-unknown
                    (lwtn-evidence-observation (head items))))
            (lwtn-observation-unknown-items (tail items)
                (if (node_eq unknown (lwo-none)) field
                    (lwo-field-add field unknown))))))
(defn lwtn-growth-unknowns (trial-cell set)
    (do
        (let all
            (append (lwo-field-items (lwtn-evidence-confirmations set))
                (append (lwo-field-items (lwtn-evidence-corrections set))
                    (append (lwo-field-items (lwtn-evidence-silences set))
                        (append
                            (lwo-field-items
                                (lwtn-evidence-alternatives set))
                            (lwo-field-items
                                (lwtn-evidence-unresolved set)))))))
        (lwtn-observation-unknown-items all
            (lwtn-trial-unknowns trial-cell))))

; children: current trial, complete independent evidence, READY/OPEN,
; alternatives, unknowns, witnesses, confirmation threshold, local path
(defn lwtn-growth
    (trial set status alternatives unknowns witnesses threshold)
    (intern_node LWTN-GROWTH
        (list trial set status alternatives unknowns witnesses
              (intern_trivial_int threshold) (lwo-local-path))))
(defn lwtn-growth? (cell) (lwo-category? cell LWTN-GROWTH))
(defn lwtn-growth-trial (growth) (nth (node_children growth) 0))
(defn lwtn-growth-evidence (growth) (nth (node_children growth) 1))
(defn lwtn-growth-status (growth) (nth (node_children growth) 2))
(defn lwtn-growth-alternative-field (growth) (nth (node_children growth) 3))
(defn lwtn-growth-unknown-field (growth) (nth (node_children growth) 4))
(defn lwtn-growth-witness-field (growth) (nth (node_children growth) 5))
(defn lwtn-growth-threshold-cell (growth) (nth (node_children growth) 6))
(defn lwtn-growth-threshold (growth)
    (node_value (lwtn-growth-threshold-cell growth)))
(defn lwtn-growth-path (growth) (nth (node_children growth) 7))

(defn lwtn-growth-for (world trial threshold)
    (if (eq (lwtn-trial-integrated-current? world trial) 0) (lwo-none)
        (do
            (let set (lwtn-evidence-for world trial))
            (let trial-cell (lwo-emergent-shape trial))
            (let ready
                (if (and (ge (lwtn-confirmation-count set) threshold)
                         (eq (lwtn-contention-count set) 0)) 1 0))
            (lwtn-growth trial set
                (if (eq ready 1) (lwtn-ready) (lwtn-open))
                (lwtn-growth-alternatives trial-cell set)
                (lwtn-growth-unknowns trial-cell set)
                (lwtn-growth-witnesses world trial set) threshold))))
(defn lwtn-growth-origin (trial threshold)
    (intern_node LWTN-GROWTH-ORIGIN
        (list trial (intern_trivial_int threshold) (lwo-local-path))))
(defn lwtn-growth-proposal (world trial threshold)
    (do
        (let growth (lwtn-growth-for world trial threshold))
        (if (or (node_eq growth (lwo-none))
                (eq (lwtn-ready? (lwtn-growth-status growth)) 0))
            (lwo-none)
            (do
                (let witnesses (lwtn-growth-witness-field growth))
                (let count (lwo-field-size witnesses))
                (let origin (lwtn-growth-origin trial threshold))
                (let candidate
                    (lwo-emergent growth witnesses
                        (intern_trivial_int 1)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwtn-growth-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwtn-growth? (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwtn-growth-candidate-current? (world candidate)
    (if (eq (lwtn-growth-candidate? candidate) 0) 0
        (do
            (let growth (lwo-emergent-shape candidate))
            (let current
                (lwtn-growth-for world (lwtn-growth-trial growth)
                    (lwtn-growth-threshold growth)))
            (if (and (node_eq growth current)
                     (and (eq (lwtn-ready?
                                  (lwtn-growth-status current)) 1)
                          (node_eq (lwo-emergent-witnesses candidate)
                              (lwtn-growth-witness-field current)))) 1 0))))
(defn lwtn-growth-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwtn-growth-candidate-current? world candidate) 1)) 1 0))
(defn lwtn-growth-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwtn-growth-candidate-current? world
            (lwt-proposal-candidate proposal))))
(defn lwtn-growth-integrate (round proposal action)
    (if (eq (lwtn-growth-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; An admitted growth result may describe, never activate, a future action.
(defn lwtn-successor-unknown (growth)
    (if (eq (lwo-field-size (lwtn-growth-unknown-field growth)) 0)
        (lwo-none)
        (lwlc-unknown (lwtn-growth-unknown-field growth))))
(defn lwtn-successor-offer (world growth-candidate)
    (if (eq (lwtn-growth-integrated-current?
                world growth-candidate) 0) (lwo-none)
        (do
            (let growth (lwo-emergent-shape growth-candidate))
            (let trial
                (lwo-emergent-shape (lwtn-growth-trial growth)))
            (let candidate (lwtn-trial-candidate trial))
            (let expected (lwtn-trial-expected trial))
            (lwac-offer
                (lwtn-candidate-target candidate)
                (lwtn-candidate-recipe candidate)
                (lwtn-candidate-declaration candidate)
                (lwtn-candidate-lens candidate)
                (lwtn-candidate-before candidate)
                (lwac-delta
                    (lwrx-overall-before expected)
                    (lwrx-overall-after expected)
                    (lwtn-candidate-lens candidate))
                (lwtn-growth-alternative-field growth)
                (lwtn-successor-unknown growth)
                (lwtn-candidate-choice candidate)
                (lwtn-candidate-timeout candidate)
                growth))))

0
