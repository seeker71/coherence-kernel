; form-cli-unique-mint-run.fk — mint unique-cell samples, fit overlay, print lift.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-unique-mint-xtal.fk

(do
    (let rows (fnu-corpus 3 1))
    (let n (fnu-n 3 1))
    (let correct (fnu-heldout-correct rows))
    (print_str (str_concat "fnu n=" (str_concat (int_to_str n) "\n")))
    (print_str (str_concat "fnu unique=" (str_concat (int_to_str (fnu-unique rows)) "\n")))
    (print_str (str_concat "fnu leakage=" (str_concat (int_to_str (fnu-leakage rows)) "\n")))
    (print_str (str_concat "fnu heldout-correct=" (str_concat (int_to_str correct) "\n")))
    (print_str (str_concat "fnu heldout-n=" (str_concat (int_to_str (fnu-count-split rows (SplitHeldout))) "\n")))
    (print_str (str_concat "fnu lora-writer=" (str_concat (int_to_str (fnu-lora-writer)) "\n")))
    (print_str (str_concat "fnu check=" (str_concat (int_to_str (fnu-check)) "\n")))
    (print_str (str_concat "fnu scale-5-2=" (str_concat (int_to_str (fnu-n 5 2)) "\n")))
    (print_str (str_concat "fnu scale-12-4=" (str_concat (int_to_str (fnu-n 12 4)) "\n")))
    (print_str (str_concat "fnu sample-satsang=" (str_concat (nth (fnu-row "satsang" 0 (SplitTrain)) 2) "\n")))
    (print_str (str_concat "fnu sample-trust=" (str_concat (nth (fnu-row "trust" 0 (SplitTrain)) 2) "\n")))
    (print_str (str_concat "fnu sample-memory=" (str_concat (nth (fnu-row "embodied-memory" 0 (SplitTrain)) 2) "\n")))
    0)
