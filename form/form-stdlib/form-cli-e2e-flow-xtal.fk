; form-cli-e2e-flow.fk — one end-to-end flow in form.lift.
;
; Yes asked for choice/cut/stop/undo/restore/timeout/nothing, BML to
; token, generated recipe, substrate cell, framebuffer, xpath inspect,
; and gas/water thoughts that never freeze. walk_recipe is a sibling
; lane; this cell executes as Form. Metal/MLX/JIT are named doors,
; observed in the live runner, not claimed as the executor here.
;
; Authority is this section. Crystallize with form-cli-e2e-flow-compile.fk.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-e2e-flow-band.fk
; witnessed: 2026-08-19 -> 1023

(do (defn fee-nothing () 0) (defn fee-cut () 1) (defn fee-stop () 2) (defn fee-timeout () 3) (defn fee-choice () 4) (defn fee-undo () 5) (defn fee-restore () 6) (defn fee-id (name) (if (str_eq name "nothing") 0 (if (str_eq name "cut") 1 (if (str_eq name "stop") 2 (if (str_eq name "timeout") 3 (if (str_eq name "choice") 4 (if (str_eq name "undo") 5 (if (str_eq name "restore") 6 0)))))))) (defn fee-gas () 0) (defn fee-water () 1) (defn fee-ice () 2) (defn fee-phase (id) (if (eq id 0) 0 (if (eq id 6) 2 1))) (defn fee-branch (a b) (add a b)) (defn fee-exec (id kept prev orig) (if (eq id 0) 0 (if (eq id 1) kept (if (eq id 2) prev (if (eq id 3) 0 (if (eq id 4) kept (if (eq id 5) prev (if (eq id 6) orig 0)))))))) (defn fee-stage (name phase tid value) (list name phase tid value)) (defn fee-q-name (stage) (nth stage 0)) (defn fee-q-phase (stage) (nth stage 1)) (defn fee-q-tid (stage) (nth stage 2)) (defn fee-q-value (stage) (nth stage 3)) (defn fee-flow-choice () (list (fee-stage "bml" 1 4 0) (fee-stage "token" 0 4 4) (fee-stage "exec" 1 4 5) (fee-stage "cell" 2 4 5))) (defn fee-xpath-phases (flow) (if (eq (len flow) 0) (empty) (cons (fee-q-phase (head flow)) (fee-xpath-phases (tail flow))))) (defn fee-xpath-names (flow) (if (eq (len flow) 0) (empty) (cons (fee-q-name (head flow)) (fee-xpath-names (tail flow))))) (defn fee-gas-ir () (list "add" (list "add" 1 1) 1)) (defn fee-gas-op (ir) (nth ir 0)) (defn fee-check () (add (if (eq (fee-id "nothing") 0) 1 0) (add (if (eq (fee-id "choice") 4) 2 0) (add (if (eq (fee-exec 0 5 7 9) 0) 4 0) (add (if (eq (fee-exec 4 5 7 9) 5) 8 0) (add (if (eq (fee-exec 5 5 7 9) 7) 16 0) (add (if (eq (fee-exec 6 5 7 9) 9) 32 0) (add (if (eq (fee-phase 0) 0) 64 0) (add (if (eq (fee-phase 6) 2) 128 0) (add (if (str_eq (fee-q-name (nth (fee-flow-choice) 2)) "exec") 256 0) (if (str_eq (fee-gas-op (fee-gas-ir)) "add") 512 0))))))))))) 0)
