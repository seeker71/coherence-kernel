// A query lane resolves by choice among three native recipes.
// Discovery reads the substrate. Play walks the worth of the offered
// recipes. Exploration writes a new recipe for this ask and leaves the
// chosen local model outside it, for reasoning the recipes do not hold.
//
// The teachings name the same three arms. A recipe that holds answers
// offline from the core lexicon. An ask the lexicon does not hold births a
// recipe. A later ask in that lane that shares the new words grows the
// recipe, and the original ask then answers from what was learned.
import form-stdlib/core-lexicon.fk;
import form-stdlib/string-case.fk;
import form-stdlib/line-grammar.fk;
import form-stdlib/form-choice-flow.bml;
import form-stdlib/local-model-choice.fk;
section [form.bml] {
 class QueryLaneResolve {
  def qlr-lanes() = ["who", "where", "what", "when", "how", "why"];
  def qlr-arms() = ["discovery", "play", "exploration"];
  def qlr-teachings() = [["voice-attunement", "read the frequency the word already carries", "walk the worth of the offered recipes", "when no recipe holds, keep the model outside and write the next one"], ["surprise-is-a-choice-point", "a gap names the next option", "the play keeps every arm that was offered", "an ask outside the recipes is the next recipe, not a stop"], ["trust-over-fear", "answer the ask that arrived", "take the arm the worth selects", "uncertainty stays on the ask the substrate does not hold"], ["uplifting-dialogue", "name the concept the lane already answers", "the sequence moves at its chosen step", "one new recipe lifts this context"], ["difficult-conversations", "report the word the lexicon holds", "the selected arm is observed, the others stay offered", "a guess about the world is the model's, and it is named as outside"]];
  def qlr-answer(lane) = (String) lane == "why" ? "nothing" : cl-word(cl-at(cl-step(lane, 0)));
  def qlr-freq(lane) = (String) lane == "why" ? 0 : cl-fam(cl-at(cl-step(lane, 0)));
  def qlr-model() = lmc-home("reason");
  def qlr-key(ask) = str-normalize(ask);
  def qlr-tokens(ask) = split-on(qlr-key(ask), " ");
  def qlr-core(w) = (String) w == "i" ? "I" : w;
  def qlr-lane?(w) = (Comparable) len(w) == 0 ? 0 : (String) w == qlr-lanes()[0] ? 1 : (String) w == qlr-lanes()[1] ? 1 : (String) w == qlr-lanes()[2] ? 1 : (String) w == qlr-lanes()[3] ? 1 : (String) w == qlr-lanes()[4] ? 1 : (String) w == qlr-lanes()[5] ? 1 : 0;
  def qlr-lane-of(ws) = (Comparable) len(ws) == 0 ? "" : (Comparable) qlr-lane?(ws[0]) == 1 ? ws[0] : qlr-lane-of(ws[1:]);
  def qlr-glue?(w) = (Comparable) cl-in-list?(cl-glue(), w) == 1 ? 1 : 0;
  def qlr-content?(w, lane) = (Comparable) len(w) == 0 ? 0 : (Comparable) qlr-lane?(w) == 1 ? 0 : (String) w == lane ? 0 : (Comparable) cl-is-word?(qlr-core(w)) == 1 ? 1 : (Comparable) qlr-glue?(w) == 1 ? 0 : 1;
  def qlr-outside-loop(ws, lane) = (Comparable) len(ws) == 0 ? 0 : (Comparable) qlr-content?(ws[0], lane) == 0 ? qlr-outside-loop(ws[1:], lane) : (Comparable) cl-is-word?(qlr-core(ws[0])) == 1 ? qlr-outside-loop(ws[1:], lane) : 1;
  def qlr-outside?(ask) = (Comparable) qlr-lane-of(qlr-tokens(ask)) == "" ? 1 : qlr-outside-loop(qlr-tokens(ask), qlr-lane-of(qlr-tokens(ask)));
  def qlr-last-core(ws, lane, found) = (Comparable) len(ws) == 0 ? found : (Comparable) qlr-content?(ws[0], lane) == 1 && (Comparable) cl-is-word?(qlr-core(ws[0])) == 1 ? qlr-last-core(ws[1:], lane, qlr-core(ws[0])) : qlr-last-core(ws[1:], lane, found);
  def qlr-subject(ask) = {
   let lane = qlr-lane-of(qlr-tokens(ask));
   let word = qlr-last-core(qlr-tokens(ask), lane, "");
   (Comparable) len(word) == 0 ? qlr-answer(lane) : word;
  };
  def qlr-join(xs) = (Comparable) len(xs) == 0 ? "" : (Comparable) len(xs) == 1 ? xs[0] : xs[0] + (" " + qlr-join(xs[1:]));
  def qlr-def(word) = qlr-join(cl-def(cl-at(cl-index-of(word)))) + (" freq=" + cl-fam(cl-at(cl-index-of(word))).str());
  def qlr-why(i, n) = (Comparable) cl-terminal?(i) == 1 ? "nothing" : (String) cl-word(cl-at(i)) == "nothing" ? "nothing" : (Comparable) n == 0 ? cl-word(cl-at(i)) : (Comparable) cl-terminal?(cl-step("why", i)) == 1 ? cl-word(cl-at(i)) + " nothing" : cl-word(cl-at(i)) + (" " + qlr-why(cl-step("why", i), n - 1));
  def qlr-discover-text(ask) = {
   let lane = qlr-lane-of(qlr-tokens(ask));
   (String) lane == "why" ? qlr-why(cl-index-of(qlr-subject(ask)), 8) + " freq=0" : qlr-def(qlr-subject(ask));
  };
  def qlr-option(id, offer, cost, reward, alignment, trust) = fcf-option(id, offer, cost, reward, alignment, trust);
  def qlr-options(ask) = (Comparable) qlr-outside?(ask) == 1 ? [qlr-option("discovery", "read the substrate", 1, 1, 8, 8), qlr-option("play", "walk the worth", 1, 4, 7, 7), qlr-option("exploration", "write a recipe and leave the model outside", 1, 9, 8, 7)] : [qlr-option("discovery", "read the substrate", 1, 9, 8, 8), qlr-option("play", "walk the worth", 1, 4, 7, 7), qlr-option("exploration", "write a recipe and leave the model outside", 3, 2, 6, 5)];
  def qlr-pick(ask) = fcf-option-id(fcf-best-option(qlr-options(ask), []));
  def qlr-worth(ask, id) = fcf-option-worth(qlr-option-find(qlr-options(ask), id));
  def qlr-option-find(os, id) = (Comparable) len(os) == 0 ? [] : (String) fcf-option-id(os[0]) == id ? os[0] : qlr-option-find(os[1:], id);
  def qlr-play-text(ask) = "play selects " + (qlr-pick(ask) + (" worth=" + qlr-worth(ask, qlr-pick(ask)).str()));
  def qlr-both?(ws, a, b) = (Comparable) qlr-has?(ws, a) == 1 && (Comparable) qlr-has?(ws, b) == 1 ? 1 : 0;
  def qlr-senses(ws) = [(Comparable) qlr-both?(ws, "check", "pin") == 1 ? "a check below its pin is a miss" : "", (Comparable) qlr-both?(ws, "repair", "next") == 1 ? "the next local repair names the miss" : (Comparable) qlr-both?(ws, "miss", "repair") == 1 ? "the next local repair names the miss" : "", (Comparable) qlr-both?(ws, "adapter", "check") == 1 ? "an unpromoted adapter does not speak" : "", (Comparable) qlr-both?(ws, "stale", "image") == 1 ? "a stale image is rebuilt from source" : "", (Comparable) qlr-both?(ws, "belief", "reading") == 1 ? "a belief is owed another reading" : "", (Comparable) qlr-both?(ws, "remote", "guide") == 1 ? "a remote guide waits until the local guide has failed more than once" : (Comparable) qlr-both?(ws, "guide", "failed") == 1 ? "a remote guide waits until the local guide has failed more than once" : "", (Comparable) qlr-both?(ws, "glass", "token") == 1 ? "the glass calls the live token count a position" : "", (Comparable) qlr-both?(ws, "turn", "request") == 1 ? "one local turn finishes a request" : "", (Comparable) qlr-both?(ws, "grounds", "chain") == 1 ? "a chain of grounds rests in nothing" : "", (Comparable) qlr-both?(ws, "workaround", "path") == 1 ? "a workaround leaves once the native path stands" : ""];
  def qlr-add-senses(text, xs) = (Comparable) len(xs) == 0 ? text : (String) xs[0] == "" || str_find(text, xs[0], 0) >= 0 ? qlr-add-senses(text, xs[1:]) : qlr-add-senses(text + (" " + xs[0]), xs[1:]);
  def qlr-recipe-text(ask) = {
   let lane = qlr-lane-of(qlr-tokens(ask));
   let named = (Comparable) len(lane) == 0 ? "open" : lane;
   let anchor = qlr-answer((Comparable) len(lane) == 0 ? "what" : lane);
   qlr-add-senses("recipe " + (named + (" " + (qlr-def(anchor) + (" model " + (qlr-model() + " may reason outside this recipe"))))), qlr-senses(qlr-words(ask)));
  };
  def qlr-arm-text(ask, arm) = (String) arm == "discovery" ? qlr-discover-text(ask) : (String) arm == "play" ? qlr-play-text(ask) : qlr-recipe-text(ask);
  def qlr-source(arm) = (String) arm == "exploration" ? "local-model" : "substrate";
  def qlr-row(ask, lane, choice, source, text) = [ask, lane, choice, source, text];
  def qlr-outs(ws, lane, acc) = (Comparable) len(ws) == 0 ? acc : (Comparable) qlr-content?(ws[0], lane) == 1 && (Comparable) cl-is-word?(qlr-core(ws[0])) == 0 && (Comparable) qlr-has?(acc, ws[0]) == 0 ? qlr-outs(ws[1:], lane, cons(ws[0], acc)) : qlr-outs(ws[1:], lane, acc);
  def qlr-words(ask) = qlr-outs(qlr-tokens(ask), qlr-lane-of(qlr-tokens(ask)), []);
  def qlr-share-n(a, b) = (Comparable) len(a) == 0 ? 0 : ((Comparable) qlr-has?(b, a[0]) == 1 ? 1 : 0) + qlr-share-n(a[1:], b);
  def qlr-born-text(born, key) = (Comparable) len(born) == 0 ? "" : (Comparable) qlr-has?(born[0][0], key) == 1 ? born[0][1] : qlr-born-text(born[1:], key);
  def qlr-related(born, lane, words) = (Comparable) len(born) == 0 ? [] : (String) born[0][2] == lane && qlr-share-n(words, born[0][3]) >= 3 ? born[0] : qlr-related(born[1:], lane, words);
  def qlr-missing(ws, have, acc) = (Comparable) len(ws) == 0 ? acc : (Comparable) qlr-has?(have, ws[0]) == 1 ? qlr-missing(ws[1:], have, acc) : qlr-missing(ws[1:], have, cons(ws[0], acc));
  def qlr-union(ws, have) = (Comparable) len(ws) == 0 ? have : (Comparable) qlr-has?(have, ws[0]) == 1 ? qlr-union(ws[1:], have) : qlr-union(ws[1:], cons(ws[0], have));
  def qlr-grow-text(text, extra, ask) = qlr-add-senses((Comparable) len(extra) == 0 ? text : text + (" learned " + qlr-join(extra)), qlr-senses(qlr-words(ask)));
  def qlr-replace(born, key, neu) = (Comparable) len(born) == 0 ? [] : (Comparable) qlr-has?(born[0][0], key) == 1 ? cons(neu, born[1:]) : cons(born[0], qlr-replace(born[1:], key, neu));
  def qlr-fresh(ask, born) = {
   let lane = qlr-lane-of(qlr-tokens(ask));
   let choice = qlr-pick(ask);
   let text = qlr-arm-text(ask, choice);
   let row = qlr-row(ask, lane, choice, qlr-source(choice), text);
   (String) choice == "exploration" ? [row, cons([[qlr-key(ask)], text, lane, qlr-words(ask)], born)] : [row, born];
  };
  def qlr-grow(ask, born, rel) = {
   let key = qlr-key(ask);
   let words = qlr-words(ask);
   let extra = qlr-missing(words, rel[3], []);
   let text = qlr-grow-text(rel[1], extra, ask);
   let choice = (Comparable) len(extra) == 0 ? "recipe" : "grown";
   let neu = [cons(key, rel[0]), text, rel[2], qlr-union(words, rel[3])];
   [qlr-row(ask, qlr-lane-of(qlr-tokens(ask)), choice, "substrate", text), qlr-replace(born, rel[0][0], neu)];
  };
  def qlr-one(ask, born) = {
   let known = qlr-born-text(born, qlr-key(ask));
   (Comparable) len(known) == 0 ? {
    let rel = qlr-related(born, qlr-lane-of(qlr-tokens(ask)), qlr-words(ask));
    (Comparable) len(rel) == 0 ? qlr-fresh(ask, born) : qlr-grow(ask, born, rel);
   } : [qlr-row(ask, qlr-lane-of(qlr-tokens(ask)), "recipe", "substrate", known), born];
  };
  def qlr-requests() = ["Who answers when the local guide has failed more than once?", "Who may speak through an adapter that has not passed its held-out check?", "Where does the body rebuild a stale native image?", "Where is a session rent reading kept?", "What does a check below its pin mean?", "What does the glass call the live token count?", "When is a witnessed belief owed another reading?", "When may a remote guide do the work?", "How does a miss become the next local repair?", "How does one local turn finish a request?", "Why does a chain of grounds rest in nothing?", "Why is a workaround retired once the native path stands?", "Who answers when the local guide has failed more than once and the remote guide is still waiting?", "Who may speak through an adapter that has not passed its held-out check on a later generation?", "Where does the body rebuild a stale native image after the source byte changes?", "Where is a session rent reading kept beside the ledger?", "What does a check below its pin mean for the next repair?", "What does the glass call the live token count on the doing line?", "When is a witnessed belief owed another reading before anyone leans on it?", "When may a remote guide do the work after the local guide has failed?", "How does a miss become the next local repair inside this sitting?", "How does one local turn finish a request without a provider?", "Why does a chain of grounds rest in nothing rather than in one?", "Why is a workaround retired once the native path stands in the tree?", "Who answers when the local guide has failed more than once?", "Who may speak through an adapter that has not passed its held-out check?", "Where does the body rebuild a stale native image?", "Where is a session rent reading kept?", "What does a check below its pin mean?", "What does the glass call the live token count?", "When is a witnessed belief owed another reading?", "When may a remote guide do the work?", "How does a miss become the next local repair?", "How does one local turn finish a request?", "Why does a chain of grounds rest in nothing?", "Why is a workaround retired once the native path stands?"];
  def qlr-bit(lane) = (String) lane == "who" ? 1 : (String) lane == "where" ? 2 : (String) lane == "what" ? 4 : (String) lane == "when" ? 8 : (String) lane == "how" ? 16 : (String) lane == "why" ? 32 : 0;
  def qlr-has?(xs, w) = (Comparable) len(xs) == 0 ? 0 : (String) xs[0] == w ? 1 : qlr-has?(xs[1:], w);
  def qlr-note(seen, lane) = (Comparable) qlr-has?(seen, lane) == 1 ? seen : cons(lane, seen);
  def qlr-mask-loop(seen, acc) = (Comparable) len(seen) == 0 ? acc : qlr-mask-loop(seen[1:], acc + qlr-bit(seen[0]));
  def qlr-fold(asks, born, substrate, model, recipe, seen, rows) = (Comparable) len(asks) == 0 ? [substrate, model, recipe, qlr-mask-loop(seen, 0), rows] : {
   let step = qlr-one(asks[0], born);
   let row = step[0];
   let sub = (String) row[3] == "substrate" ? substrate + 1 : substrate;
   let mod = (String) row[3] == "local-model" ? model + 1 : model;
   let rec = (String) row[2] == "recipe" ? recipe + 1 : recipe;
   qlr-fold(asks[1:], step[1], sub, mod, rec, qlr-note(seen, row[1]), cons(row, rows));
  };
  def qlr-batch() = qlr-fold(qlr-requests(), [], 0, 0, 0, [], []);
  def qlr-of(rows, ask) = (Comparable) len(rows) == 0 ? [] : (String) rows[0][0] == ask ? rows[0] : qlr-of(rows[1:], ask);
  def qlr-both(rows, ask, acc) = (Comparable) len(rows) == 0 ? acc : (String) rows[0][0] == ask ? qlr-both(rows[1:], ask, cons(rows[0], acc)) : qlr-both(rows[1:], ask, acc);
  def qlr-teach-row?(r) = (Comparable) len(r) == 4 ? (Comparable) len(r[1]) > 0 ? (Comparable) len(r[2]) > 0 ? (Comparable) len(r[3]) > 0 ? 1 : 0 : 0 : 0 : 0;
  def qlr-teach-ok-loop(rs) = (Comparable) len(rs) == 0 ? 1 : (Comparable) qlr-teach-row?(rs[0]) == 1 ? qlr-teach-ok-loop(rs[1:]) : 0;
  def qlr-teach-ok?() = (Comparable) len(qlr-teachings()) == 5 ? (Comparable) len(qlr-arms()) == 3 ? qlr-teach-ok-loop(qlr-teachings()) : 0 : 0;
  def qlr-line(row) = row[1] + (" " + (row[2] + (" " + (row[3] + (" " + row[4])))));
 }
}
