; form-execution-verified-curriculum.fk -- execution-owned teaching from
; propose -> coldjudge observation -> revision movements.
;
; A clean surface is not a green endpoint.  Green is recomputed through the
; existing scannerless Form evaluator and must equal the candidate's expected
; value.  Failed source is retained only as user-side revision context; the
; answer side is always the next observed candidate or a green endpoint.
;
; The denied evaluation authorities stay outside every emitted row.  Their
; current identities are read from the already-frozen cells, so a new heldout
; identity is one authority movement rather than another copied table here.
;
; candidate   = schema family task source expected provenance
; observation = schema candidate-node preflight signal value execution evidence
; execution   = schema compile-exit run-exit diagnostic
; evidence    = schema observer provenance
; step        = schema candidate observation
; trajectory  = schema family steps provenance
; row         = schema split kind family instruction answer identity evidence
; identity    = schema trajectory-node step-index
; row-evidence = schema candidate-provenance observer observation-provenance
;
; Signals `return`, `choice`, `cut`, and `undo` may carry a value.  `timeout`,
; `nothing`, and `failure` remain distinct observed refusals.  A returned
; first-class nothing is represented by signal=return,value=nothing; it is not
; collapsed into signal=nothing, integer 0, or integer 1.
;
; preludes: form-stdlib/core.fk form-stdlib/json.fk
; preludes: form-stdlib/form-eval-full.fk
; preludes: form-stdlib/form-knowledge-heldout-authority.fk
;
; Proven by: form-stdlib/tests/form-execution-verified-curriculum-band.fk

(do
    (defn evfc-candidate (family task source expected provenance)
        (list "form-execution-candidate-v1" family task source expected provenance))
    (defn evfc-c-family (c) (nth c 1))
    (defn evfc-c-task (c) (nth c 2))
    (defn evfc-c-source (c) (nth c 3))
    (defn evfc-c-expected (c) (nth c 4))
    (defn evfc-c-provenance (c) (nth c 5))

    ; Structural NodeID is the bookkeeping key.  No SHA pass is added to this
    ; path; interning gives equal candidates equal identity in the live body.
    (defn evfc-value-text (v)
        (if (nothing? v) "nothing" (int_to_str v)))
    (defn evfc-candidate-id (c)
        (intern_node (bp "FORM-EXECUTION-CANDIDATE")
            (list
                (intern_trivial_string (evfc-c-family c))
                (intern_trivial_string (evfc-c-task c))
                (intern_trivial_string (evfc-c-source c))
                (intern_trivial_string (evfc-value-text (evfc-c-expected c)))
                (intern_trivial_string (evfc-c-provenance c)))))

    ; Packed records cross the temporary seed frame without widening it.  The
    ; fields remain ordinary Form data and retain their original meaning.
    (defn evfc-execution (compile-exit run-exit diagnostic)
        (list "form-coldjudge-execution-v1" compile-exit run-exit diagnostic))
    (defn evfc-evidence (observer provenance)
        (list "form-coldjudge-evidence-v1" observer provenance))
    (defn evfc-observation
        (candidate-node preflight signal value execution evidence)
        (list "form-coldjudge-observation-v1" candidate-node preflight signal
              value execution evidence))
    (defn evfc-o-candidate-id (o) (nth o 1))
    (defn evfc-o-preflight (o) (nth o 2))
    (defn evfc-o-signal (o) (nth o 3))
    (defn evfc-o-value (o) (nth o 4))
    (defn evfc-o-execution (o) (nth o 5))
    (defn evfc-o-evidence (o) (nth o 6))
    (defn evfc-o-compile-exit (o) (nth (evfc-o-execution o) 1))
    (defn evfc-o-run-exit (o) (nth (evfc-o-execution o) 2))
    (defn evfc-o-diagnostic (o) (nth (evfc-o-execution o) 3))
    (defn evfc-o-observer (o) (nth (evfc-o-evidence o) 1))
    (defn evfc-o-provenance (o) (nth (evfc-o-evidence o) 2))

    (defn evfc-step (candidate observation)
        (list "form-execution-trajectory-step-v1" candidate observation))
    (defn evfc-step-candidate (s) (nth s 1))
    (defn evfc-step-observation (s) (nth s 2))

    (defn evfc-trajectory (family steps provenance)
        (list "form-execution-trajectory-v1" family steps provenance))
    (defn evfc-t-family (t) (nth t 1))
    (defn evfc-t-steps (t) (nth t 2))
    (defn evfc-t-provenance (t) (nth t 3))

    (defn evfc-supported-signal? (s)
        (if (str_eq s "return") 1
        (if (str_eq s "choice") 1
        (if (str_eq s "cut") 1
        (if (str_eq s "undo") 1
        (if (str_eq s "timeout") 1
        (if (str_eq s "nothing") 1
        (if (str_eq s "failure") 1 0))))))))
    (defn evfc-value-signal? (s)
        (if (str_eq s "return") 1
        (if (str_eq s "choice") 1
        (if (str_eq s "cut") 1
        (if (str_eq s "undo") 1 0)))))

    ; The deny set is assembled from frozen authorities.  It includes the
    ; challenge, harness, source paths, source identities, commits, nonce, and
    ; the retained Condition-E candidate identity/path.  None is emitted.
    (defn evfc-denials ()
        (append (fktwf-leakage-bans)
            (append (fked-source-paths)
            (append (fked-source-shas)
            (append (fked-source-commits)
                (list (fked-challenge-id) (fked-harness-sha) (fked-nonce)
                      (fkceo-path) (fkceo-expected-sha)))))))
    (defn evfc-text-denied-loop? (text denials)
        (if (nil? denials) 0
            (if (ge (str_find text (head denials) 0) 0) 1
                (evfc-text-denied-loop? text (tail denials)))))
    (defn evfc-text-denied? (text)
        (evfc-text-denied-loop? text (evfc-denials)))
    (defn evfc-candidate-denied? (c)
        (if (evfc-text-denied? (evfc-c-family c)) 1
        (if (evfc-text-denied? (evfc-c-task c)) 1
        (if (evfc-text-denied? (evfc-c-source c)) 1
        (if (evfc-text-denied? (evfc-value-text (evfc-c-expected c))) 1
            (evfc-text-denied? (evfc-c-provenance c)))))))
    (defn evfc-observation-denied? (o)
        (if (evfc-text-denied? (evfc-o-preflight o)) 1
        (if (evfc-text-denied? (evfc-o-signal o)) 1
        (if (evfc-text-denied? (evfc-value-text (evfc-o-value o))) 1
        (if (evfc-text-denied? (evfc-o-diagnostic o)) 1
        (if (evfc-text-denied? (evfc-o-observer o)) 1
            (evfc-text-denied? (evfc-o-provenance o))))))))

    ; A value-carrying coldjudge observation is checked again by the existing
    ; evaluator.  Refusals are not re-run: a timeout or crashing candidate is
    ; evidence precisely because the coldjudge bounded it and returned.
    (defn evfc-observation-execution-matches? (c o)
        (if (eq (evfc-value-signal? (evfc-o-signal o)) 0) 1
            (if (and (str_eq (evfc-o-preflight o) "clean")
                     (and (eq (evfc-o-compile-exit o) 0)
                          (eq (evfc-o-run-exit o) 0)))
                (if (value_eq (fef-eval (evfc-c-source c))
                              (evfc-o-value o)) 1 0)
                0)))
    (defn evfc-observation-valid? (c o)
        (if (not (value_eq (evfc-candidate-id c)
                           (evfc-o-candidate-id o))) 0
        (if (eq (evfc-supported-signal? (evfc-o-signal o)) 0) 0
        (if (eq (evfc-candidate-denied? c) 1) 0
        (if (eq (evfc-observation-denied? o) 1) 0
            (evfc-observation-execution-matches? c o))))))

    ; Green requires both compile/run witness and independently repeated value
    ; equality.  Nothing/0/1 remain value_eq-distinct.
    (defn evfc-green? (c o)
        (if (eq (evfc-observation-valid? c o) 0) 0
        (if (eq (evfc-value-signal? (evfc-o-signal o)) 0) 0
        (if (not (str_eq (evfc-o-preflight o) "clean")) 0
        (if (not (eq (evfc-o-compile-exit o) 0)) 0
        (if (not (eq (evfc-o-run-exit o) 0)) 0
            (if (value_eq (evfc-o-value o) (evfc-c-expected c)) 1 0)))))))

    (defn evfc-observed-kind (c o)
        (if (not (str_eq (evfc-o-preflight o) "clean")) "syntax-failure"
        (if (not (eq (evfc-o-compile-exit o) 0)) "syntax-failure"
        (if (str_eq (evfc-o-signal o) "timeout") "timeout"
        (if (str_eq (evfc-o-signal o) "nothing") "nothing"
        (if (str_eq (evfc-o-signal o) "failure") "failure"
        (if (eq (evfc-green? c o) 1) "green"
        (if (str_eq (evfc-o-signal o) "choice") "choice"
        (if (str_eq (evfc-o-signal o) "cut") "cut"
        (if (str_eq (evfc-o-signal o) "undo") "undo"
            "semantic-failure"))))))))))

    (defn evfc-steps-valid? (family steps)
        (if (nil? steps) 0
            (do
                (let step (head steps))
                (let c (evfc-step-candidate step))
                (let o (evfc-step-observation step))
                (if (not (str_eq family (evfc-c-family c))) 0
                (if (eq (evfc-observation-valid? c o) 0) 0
                (if (nil? (tail steps))
                    (evfc-green? c o)
                    (if (eq (evfc-green? c o) 1) 0
                        ; A new provenance label on identical bytes is not a
                        ; revision.  The candidate source itself must move.
                        (if (str_eq (evfc-c-source c)
                                (evfc-c-source
                                    (evfc-step-candidate (head (tail steps)))))
                            0
                            (evfc-steps-valid? family (tail steps))))))))))
    ; Initial miss + two revisions with the same failure kind is a surfaced
    ; plateau.  It does not silently mint a third zealous retry.  The caller
    ; can branch, change lineage, or pause from this typed result.
    (defn evfc-two-liftless-rounds? (steps)
        (if (lt (len steps) 3) 0
            (do
                (let a (head steps))
                (let b (head (tail steps)))
                (let c (head (tail (tail steps))))
                (let ac (evfc-step-candidate a))
                (let ao (evfc-step-observation a))
                (let bc (evfc-step-candidate b))
                (let bo (evfc-step-observation b))
                (let cc (evfc-step-candidate c))
                (let co (evfc-step-observation c))
                (if (and (eq (evfc-green? ac ao) 0)
                         (and (eq (evfc-green? bc bo) 0)
                         (and (eq (evfc-green? cc co) 0)
                         (and (str_eq (evfc-observed-kind ac ao)
                                      (evfc-observed-kind bc bo))
                              (str_eq (evfc-observed-kind bc bo)
                                      (evfc-observed-kind cc co))))))
                    1
                    (evfc-two-liftless-rounds? (tail steps))))))
    (defn evfc-trajectory-base-valid? (t)
        (if (evfc-text-denied? (evfc-t-family t)) 0
        (if (evfc-text-denied? (evfc-t-provenance t)) 0
            (evfc-steps-valid? (evfc-t-family t) (evfc-t-steps t)))))
    (defn evfc-trajectory-status (t)
        (if (eq (evfc-trajectory-base-valid? t) 0) "failure"
            (if (eq (evfc-two-liftless-rounds? (evfc-t-steps t)) 1)
                "plateau" "ready")))
    (defn evfc-trajectory-valid? (t)
        (if (str_eq (evfc-trajectory-status t) "ready") 1 0))

    (defn evfc-trajectory-id (t)
        (intern_node (bp "FORM-EXECUTION-TRAJECTORY")
            (append (evfc-trajectory-candidate-ids (evfc-t-steps t))
                (list (intern_trivial_string (evfc-t-provenance t))))))
    (defn evfc-trajectory-candidate-ids (steps)
        (if (nil? steps) (empty)
            (cons (evfc-candidate-id (evfc-step-candidate (head steps)))
                  (evfc-trajectory-candidate-ids (tail steps)))))

    ; Cheap deterministic family split: one byte fold, no cryptographic
    ; bookkeeping.  Every row in one trajectory stays in one split.
    (defn evfc-family-fold-loop (s i acc)
        (if (ge i (str_len s)) acc
            (evfc-family-fold-loop s (add i 1)
                (mod (add acc (str_byte_at s i)) 65521))))
    (defn evfc-family-fold (s) (evfc-family-fold-loop s 0 0))
    (defn evfc-family-split (family)
        (if (eq (mod (evfc-family-fold family) 5) 0) "valid" "train"))

    (defn evfc-row-identity (trajectory-node step-index)
        (list "form-execution-curriculum-row-identity-v1"
              trajectory-node step-index))
    (defn evfc-row-evidence
        (candidate-provenance observer observation-provenance)
        (list "form-execution-curriculum-row-evidence-v1"
              candidate-provenance observer observation-provenance))
    (defn evfc-row
        (split kind family instruction answer identity evidence)
        (list "form-execution-curriculum-row-v1" split kind family instruction
              answer identity evidence))
    (defn evfc-r-split (r) (nth r 1))
    (defn evfc-r-kind (r) (nth r 2))
    (defn evfc-r-family (r) (nth r 3))
    (defn evfc-r-instruction (r) (nth r 4))
    (defn evfc-r-answer (r) (nth r 5))
    (defn evfc-r-identity (r) (nth r 6))
    (defn evfc-r-evidence (r) (nth r 7))
    (defn evfc-r-trajectory-id (r) (nth (evfc-r-identity r) 1))
    (defn evfc-r-step-index (r) (nth (evfc-r-identity r) 2))
    (defn evfc-r-candidate-provenance (r) (nth (evfc-r-evidence r) 1))
    (defn evfc-r-observer (r) (nth (evfc-r-evidence r) 2))
    (defn evfc-r-observation-provenance (r) (nth (evfc-r-evidence r) 3))

    (defn evfc-observation-text (c o)
        (str_concat "preflight=" (str_concat (evfc-o-preflight o)
        (str_concat " signal=" (str_concat (evfc-observed-kind c o)
        (str_concat " value=" (str_concat (evfc-value-text (evfc-o-value o))
        (str_concat " compile-exit=" (str_concat (int_to_str (evfc-o-compile-exit o))
        (str_concat " run-exit=" (str_concat (int_to_str (evfc-o-run-exit o))
        (str_concat " diagnostic=" (evfc-o-diagnostic o)))))))))))))
    (defn evfc-revision-prompt (c o)
        (str_concat (evfc-c-task c)
            (str_concat "\nRetained candidate:\n" (str_concat (evfc-c-source c)
            (str_concat "\nColdjudge observation:\n" (str_concat
                (evfc-observation-text c o)
                "\nReturn only one revised complete Form source."))))))
    (defn evfc-endpoint-prompt (c)
        (str_concat (evfc-c-task c)
            "\nReturn only one complete executable Form source."))

    (defn evfc-revision-rows (t steps index final-c)
        (if (nil? (tail steps)) (empty)
            (do
                (let prior (head steps))
                (let c (evfc-step-candidate prior))
                (let o (evfc-step-observation prior))
                (cons
                    (evfc-row (evfc-family-split (evfc-t-family t))
                        (evfc-observed-kind c o) (evfc-t-family t)
                        ; Every answer is the trajectory's execution-green
                        ; endpoint.  Intermediate failed attempts remain in
                        ; the observation side and are never target code.
                        (evfc-revision-prompt c o) (evfc-c-source final-c)
                        (evfc-row-identity (evfc-trajectory-id t) index)
                        (evfc-row-evidence (evfc-c-provenance c)
                            (evfc-o-observer o) (evfc-o-provenance o)))
                    (evfc-revision-rows t (tail steps) (add index 1)
                        final-c)))))
    (defn evfc-last-step (steps)
        (if (nil? (tail steps)) (head steps) (evfc-last-step (tail steps))))
    (defn evfc-trajectory-rows (t)
        (if (eq (evfc-trajectory-valid? t) 0) (nothing)
            (do
                (let final (evfc-last-step (evfc-t-steps t)))
                (let c (evfc-step-candidate final))
                (let o (evfc-step-observation final))
                (append (evfc-revision-rows t (evfc-t-steps t) 0 c)
                    (list (evfc-row (evfc-family-split (evfc-t-family t))
                        "endpoint" (evfc-t-family t) (evfc-endpoint-prompt c)
                        (evfc-c-source c)
                        (evfc-row-identity (evfc-trajectory-id t)
                            (sub (len (evfc-t-steps t)) 1))
                        (evfc-row-evidence (evfc-c-provenance c)
                            (evfc-o-observer o) (evfc-o-provenance o))))))))

    (defn evfc-build (trajectories)
        (if (nil? trajectories) (empty)
            (do
                (let rows (evfc-trajectory-rows (head trajectories)))
                (if (nothing? rows) (nothing)
                    (do
                        (let rest (evfc-build (tail trajectories)))
                        (if (nothing? rest) (nothing) (append rows rest)))))))
    (defn evfc-rows-for-split (rows split)
        (if (nil? rows) (empty)
            (if (str_eq (evfc-r-split (head rows)) split)
                (cons (head rows) (evfc-rows-for-split (tail rows) split))
                (evfc-rows-for-split (tail rows) split))))

    (defn evfc-message (role content)
        (json-node-object (list
            (json-node-pair "role" (json-node-string role))
            (json-node-pair "content" (json-node-string content)))))
    (defn evfc-json-row (r)
        (json-emit (json-node-object (list
            (json-node-pair "messages" (json-node-array (list
                (evfc-message "user" (evfc-r-instruction r))
                (evfc-message "assistant" (evfc-r-answer r)))))
            (json-node-pair "provenance" (json-node-object (list
                (json-node-pair "schema" (json-node-string
                    "form-execution-curriculum-provenance-v1"))
                (json-node-pair "family" (json-node-string (evfc-r-family r)))
                (json-node-pair "split" (json-node-string (evfc-r-split r)))
                (json-node-pair "kind" (json-node-string (evfc-r-kind r)))
                (json-node-pair "step" (json-node-int (evfc-r-step-index r)))
                (json-node-pair "candidate" (json-node-string
                    (evfc-r-candidate-provenance r)))
                (json-node-pair "observer" (json-node-string
                    (evfc-r-observer r)))
                (json-node-pair "observation" (json-node-string
                    (evfc-r-observation-provenance r))))))))))
    (defn evfc-jsonl-loop (rows)
        (if (nil? rows) ""
            (str_concat (evfc-json-row (head rows))
                (str_concat "\n" (evfc-jsonl-loop (tail rows))))))
    (defn evfc-jsonl (trajectories split)
        (do
            (let rows (evfc-build trajectories))
            (if (nothing? rows) (nothing)
            (if (str_eq split "train")
                (evfc-jsonl-loop (evfc-rows-for-split rows "train"))
            (if (str_eq split "valid")
                (evfc-jsonl-loop (evfc-rows-for-split rows "valid"))
                (nothing))))))
    0)
