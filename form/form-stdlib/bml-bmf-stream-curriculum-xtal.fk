; Reviewed crystallization of bml-bmf-stream-curriculum.bml.
;
; The current fkwu source-compiler chain lacks file_byte_at,
; write_form_binary, and walk_recipe_here.  This Form image is therefore an
; explicit checked lowering, not a claim that the absent compiler lane ran.
; The held-out band separately parses the BML authority through the BMF cursor
; and executes every lowered method here.
;
; source: form/form-stdlib/bml-bmf-stream-curriculum.bml
; preludes: form-stdlib/core.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml-bmf-stream-curriculum.fk

(do
    (defn AuthorityPath ()
        "form/form-stdlib/bml/bml-bmf-stream-curriculum.bml")
    (defn ExecutablePath ()
        "form/form-stdlib/bml-bmf-stream-curriculum.bml")
    (defn CursorRoute () "scannerless-byte-fold-no-tokenizer")
    (defn CaptureBound () 8)
    (defn bbsc-bml-ground ()
        (list
            "form/form-stdlib/bmf-core.fk"
            "form/form-stdlib/bmf-grammar.fk"
            "form/form-stdlib/bmf-byte-cursor.fk"
            "form/form-stdlib/file-byte-window.fk"))
    (defn bbsc-bml-grammar () (bbsc-heldout-grammar))
    (defn bbsc-bml-program ()
        (bbsc-compile-grammar (bbsc-bml-grammar) (CaptureBound)))
    (defn bbsc-bml-execute (source)
        (do
            (let state (bbsc-open-program (bbsc-bml-program)))
            (let streamed (bbsc-feed-chunk state source))
            (bbsc-finish streamed)))
    (defn bbsc-bml-check ()
        (do
            (let state (bbsc-bml-execute (bbsc-source)))
            (let c0 (if (eq (bbsc-state-count state) 2) 1 0))
            (let c1 (if (str_eq (bbsc-state-status state) "complete") 2 0))
            (let c2 (if (eq (bbsc-feed-all-splits?) 1) 4 0))
            (let c3 (if (eq (bbsc-bmf-stream-equivalent?) 1) 8 0))
            (add c0 (add c1 (add c2 c3)))))
    (defn BmlBmfStreamCurriculum ()
        (list "abstraction" "BmlBmfStreamCurriculum" (list "T")
            (list "bbsc-bml-grammar" "bbsc-bml-program"
                  "bbsc-bml-execute" "bbsc-bml-check")
            (list "AuthorityPath" "ExecutablePath" "CursorRoute" "CaptureBound")
            (empty) (list "bbsc-bml-ground")))
    0)
