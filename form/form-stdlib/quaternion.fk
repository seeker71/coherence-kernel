; quaternion.fk — Hamilton's algebra as a Form recipe: q = w + xi + yj + zk, i²=j²=k²=ijk=-1.
;
; A quaternion is a 4-tuple (list w x y z) — a point of ℝ⁴, and a point of S³ ⊂ ℝ⁴ exactly when
; unit-norm. q-mul is non-commutative by construction (ij=k but ji=-k), which is the same fact
; that makes it carry rotation: composing two rotations doesn't commute either.
;
; Three distinct actions of the SAME product, and the teaching is in how they differ:
;
;   q-rotate3 (v)   p -> q·p·q⁻¹   (conjugation, "sandwich"), restricted to a PURE quaternion
;                   (w=0). This is exactly SO(3): every 3D rotation fixes a line — q's own axis
;                   survives the sandwich unchanged (q-rotate3 applied to q's own axis is the
;                   identity). One unit quaternion, two-sided, cancels to a fixed point.
;
;   q-left-rotate   p -> q·p, a single unit quaternion acting on a FULL point of ℝ⁴ from one
;                   side only. Because the quaternions are a division algebra (q·p = p with
;                   p≠0 forces q=1), a nontrivial left multiplication has NO fixed axis at
;                   all — not even q's own. This is the sharp, provable difference between an
;                   even ambient dimension (4D: a generic rotation fixes only the origin) and an
;                   odd one (3D: every rotation fixes a line). q-rotate3 is the special SO(4)
;                   element that happens to restore a fixed line by cancelling q on the right;
;                   q-left-rotate is the generic case with no such cancellation.
;
;   q-hopf          collapses an entire circle of S³ (a fiber) to a single point of S² — but
;                   WHICH circle is a fiber is a fact about q-hopf's specific closed form, not
;                   a guess: measured directly (form-stdlib/fiber-probe, kept in receipt only,
;                   not shipped), q0·rotor(t) for a RIGHT-multiplied unit i-axis rotor moves
;                   q-hopf's value; rotor(t)·q0 (the SAME rotor, LEFT instead) leaves it fixed
;                   at q-hopf(q0) — so the fiber through q0 is {rotor(t)·q0 : t}, a LEFT coset
;                   of the i-axis circle subgroup, not a right one. q-hopf is also exactly
;                   invariant under q -> -q (every term of the closed form is a product of two
;                   components, so negating all four leaves it bit-identical) — the same ℤ/2
;                   blindness q-rotate3 has, for the same structural reason: both are built
;                   from an EVEN number of factors of q. q-stereo, by contrast, is a genuine
;                   chart (S³∖{pole} ≅ ℝ³, the map SLERP interpolates through) and traces a
;                   real curve over that same fiber, not a point — two different maps out of
;                   S³, one blind to a whole circle, one not.
;
; Every claim above is checked by direct computation, not asserted — see
; tests/quaternion-band.fk (the algebra, and the fiber/±q facts, exact or rounded as noted)
; and quaternion-demo.fk (the generation table: same recipe, printed, no hand-typed numbers).
;
; preludes: form-stdlib/trig.fk
;
; All pure; four-way proven by tests/quaternion-band.fk (Go/Rust/TS/fkwu).

(do
    ; --- construction + accessors: a quaternion is (list w x y z) ---
    (defn quat (w x y z) (list w x y z))
    (defn qw (q) (nth q 0))
    (defn qx (q) (nth q 1))
    (defn qy (q) (nth q 2))
    (defn qz (q) (nth q 3))
    (defn q-identity () (quat 1.0 0.0 0.0 0.0))

    ; --- vector-space ops (ℝ⁴, componentwise) ---
    (defn q-add (a b) (quat (add (qw a) (qw b)) (add (qx a) (qx b)) (add (qy a) (qy b)) (add (qz a) (qz b))))
    (defn q-sub (a b) (quat (sub (qw a) (qw b)) (sub (qx a) (qx b)) (sub (qy a) (qy b)) (sub (qz a) (qz b))))
    (defn q-scale (s q) (quat (mul s (qw q)) (mul s (qx q)) (mul s (qy q)) (mul s (qz q))))
    (defn q-neg (q) (q-scale -1.0 q))

    ; --- the Hamilton product: w=aw.bw-ax.bx-ay.by-az.bz, and the three cyclic imaginary rows.
    ; Non-commutative — q-mul(a,b) ≠ q-mul(b,a) in general, proven directly in the band. ---
    (defn q-mul (a b)
        (quat
            (sub (sub (sub (mul (qw a) (qw b)) (mul (qx a) (qx b))) (mul (qy a) (qy b))) (mul (qz a) (qz b)))
            (sub (add (add (mul (qw a) (qx b)) (mul (qx a) (qw b))) (mul (qy a) (qz b))) (mul (qz a) (qy b)))
            (add (sub (add (mul (qw a) (qy b)) (mul (qy a) (qw b))) (mul (qx a) (qz b))) (mul (qz a) (qx b)))
            (add (sub (add (mul (qw a) (qz b)) (mul (qz a) (qw b))) (mul (qy a) (qx b))) (mul (qx a) (qy b)))))

    ; --- conjugate, dot, norm, inverse (general inverse — works whether or not q is unit) ---
    (defn q-conj (q) (quat (qw q) (sub 0.0 (qx q)) (sub 0.0 (qy q)) (sub 0.0 (qz q))))
    (defn q-dot (a b) (add (add (mul (qw a) (qw b)) (mul (qx a) (qx b))) (add (mul (qy a) (qy b)) (mul (qz a) (qz b)))))
    (defn q-norm2 (q) (q-dot q q))
    (defn q-norm (q) (fsqrt (q-norm2 q)))
    (defn q-normalize (q) (q-scale (div 1.0 (q-norm q)) q))
    (defn q-inv (q) (q-scale (div 1.0 (q-norm2 q)) (q-conj q)))

    ; --- build a unit rotor from a UNIT axis + full rotation angle theta (radians): the
    ; half-angle is the algebra's own signature, not a convention layered on top. ---
    (defn q-from-axis-angle (ux uy uz theta)
        (do
            (let h (mul 0.5 theta))
            (let s (fsin h))
            (quat (fcos h) (mul s ux) (mul s uy) (mul s uz))))

    ; --- the great circle through 1 in the (1, axis) plane of S³: unit for every t for free
    ; (cos²+sin²=1), and IS q-from-axis-angle(axis, 2t) — t is the half-angle already. ---
    (defn q-orbit (t ux uy uz) (quat (fcos t) (mul (fsin t) ux) (mul (fsin t) uy) (mul (fsin t) uz)))

    ; --- SO(3): conjugation sandwich restricted to a pure vector (w=0). Fixes q's own axis. ---
    (defn q-rotate3 (q vx vy vz)
        (do
            (let v (quat 0.0 vx vy vz))
            (let r (q-mul (q-mul q v) (q-inv q)))
            (list (qx r) (qy r) (qz r))))

    ; --- SO(4): two INDEPENDENT unit quaternions acting on a full point p ∈ ℝ⁴ from both
    ; sides. General 4D rotation; q-rotate3 is the special case ql=q, qr=q⁻¹. ---
    (defn q-rotate4 (ql p qr) (q-mul (q-mul ql p) qr))

    ; --- the isoclinic special case: pure left multiplication, qr = identity. A division
    ; algebra has no zero divisors, so q·p=p with p≠0 forces q=1 — generically nothing but
    ; the origin is fixed. This is the sharpest visible difference from q-rotate3. ---
    (defn q-left-rotate (q p) (q-mul q p))

    ; --- Hopf fibration π: S³ -> S², viewing q=(a,b,c,d) as (z1,z2)=(a+bi, c+di) ∈ ℂ²:
    ; π(z1,z2) = (2 Re(z1·z̄2), 2 Im(z1·z̄2), |z1|²-|z2|²). Collapses an entire circle of S³
    ; (a fiber) to one point of S². ---
    (defn q-hopf (q)
        (do
            (let a (qw q)) (let b (qx q)) (let c (qy q)) (let d (qz q))
            (list (mul 2.0 (add (mul a c) (mul b d)))
                  (mul 2.0 (sub (mul b c) (mul a d)))
                  (sub (add (mul a a) (mul b b)) (add (mul c c) (mul d d))))))

    ; --- stereographic projection S³∖{pole} -> ℝ³ from the pole q=1=(1,0,0,0):
    ; proj(w,x,y,z) = (x,y,z)/(1-w). The same chart that makes SLERP gimbal-lock-free. ---
    (defn q-stereo (q) (do (let s (div 1.0 (sub 1.0 (qw q)))) (list (mul s (qx q)) (mul s (qy q)) (mul s (qz q)))))

    0)
