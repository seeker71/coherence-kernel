// transformer-block.fk — M4 of the native-models ladder: one attention+FFN block as proven Form.
//
// The real transformer primitive: a whisper-shaped pre-LN block
//   h = x + Wo·attn(LN1(x)) + bo        attn = softmax(q·kᵀ/√d_k)-weighted sum of v
//   y = h + W2·gelu(W1·LN2(h) + b1) + b2
// composed entirely from transformer-numerics.fk (M3: softmax, gelu, layernorm, exp, sqrt) plus the
// dot/matvec walk below. Weights are arguments — lists of rows — so the block is recipe DATA all the
// way down: a layer stack is a SEQUENCE of these calls, mutable at runtime (the dynamic-recipe
// advantage). This lane is fp64; format-parameterized (bf16/fp8) and quantized weights are M1/M2's
// stones. gelu is the tanh approximation (M3's lane); the exact-erf variant joins when a model that
// trained on it arrives. Proven three-way against the PyTorch fp64 reference by
// tests/transformer-block-band.fk.
//
import form-stdlib/core.fk;
import form-stdlib/transformer-numerics.fk;
//
// The four names this unit does not define itself are exactly the M3 numerics it composes:
// tn-layernorm, tn-gelu, tn-scale, tn-softmax. Dependency-first FULL closure — preludes are
// PER-UNIT, so a sibling that already loaded transformer-numerics.fk does not count here.
// Without this line the standalone image is rejected and every consumer falls back to the
// whole-program compile; worse, a consumer that names transformer-block.fk in its own preludes
// but omits transformer-numerics.fk lowers those four calls to nothing under axiom-5 and returns
// a NUMB verdict rather than an error.
// --- vector / matrix walk ---
section [form.bml] {
    def tb-dot(a, b) = (Comparable) len(a) == 0 ? 0.0 : a[0] * b[0] + tb-dot(a[1:], b[1:]);
    def tb-matvec(rows, x) = (Comparable) len(rows) == 0 ? empty() : cons(tb-dot(rows[0], x), tb-matvec(rows[1:], x));
    def tb-vec-add(a, b) = (Comparable) len(a) == 0 ? empty() : cons(a[0] + b[0], tb-vec-add(a[1:], b[1:]));
    def tb-vec-mul(a, b) = (Comparable) len(a) == 0 ? empty() : cons(a[0] * b[0], tb-vec-mul(a[1:], b[1:]));
    def tb-zeros(n) = (Comparable) n == 0 ? empty() : cons(0.0, tb-zeros(n - 1));
    def tb-affine(w, b, x) = tb-vec-add(tb-matvec(w, x), b);
    // --- sequence walks (a sequence is a list of position-vectors) ---
    def tb-ln-seq(xs, eps, gamma, beta) = (Comparable) len(xs) == 0 ? empty() : cons(tb-vec-add(tb-vec-mul(tn-layernorm(xs[0], eps), gamma), beta), tb-ln-seq(xs[1:], eps, gamma, beta));
    def tb-proj-seq(w, b, xs) = (Comparable) len(xs) == 0 ? empty() : cons(tb-affine(w, b, xs[0]), tb-proj-seq(w, b, xs[1:]));
    def tb-add-seq(as, bs) = (Comparable) len(as) == 0 ? empty() : cons(tb-vec-add(as[0], bs[0]), tb-add-seq(as[1:], bs[1:]));
    def tb-gelu-map(xs) = (Comparable) len(xs) == 0 ? empty() : cons(tn-gelu(xs[0]), tb-gelu-map(xs[1:]));
    // --- attention: scores, softmax over keys, weighted sum of values ---
    def tb-scores(q, ks, scale) = (Comparable) len(ks) == 0 ? empty() : cons(tb-dot(q, ks[0]) * scale, tb-scores(q, ks[1:], scale));
    def tb-weighted-acc(alphas, vs, acc) = (Comparable) len(alphas) == 0 ? acc : tb-weighted-acc(alphas[1:], vs[1:], tb-vec-add(acc, tn-scale(vs[0], alphas[0])));
    def tb-attend-one(q, ks, vs, scale) = tb-weighted-acc(tn-softmax(tb-scores(q, ks, scale)), vs, tb-zeros(len(vs[0])));
    def tb-attn-seq(qs, ks, vs, scale) = (Comparable) len(qs) == 0 ? empty() : cons(tb-attend-one(qs[0], ks, vs, scale), tb-attn-seq(qs[1:], ks, vs, scale));
    // --- causal attention: the autoregressive mask. Query at position i sees only keys/values 0..i —
    //     a per-query key PREFIX. tb-take cuts the visibility window; the count starts at 1 so the first
    //     query sees one key (itself), the last sees the whole sequence (the mask is a no-op at the end).
    //     softmax normalizes over the visible keys only — no numeric change to the per-pair dot/softmax,
    //     so it composes tb-attend-one verbatim. This is what a decoder block needs to generate one token
    //     at a time without attending to the future. ---
    def tb-take(xs, n) = (Comparable) n == 0 ? empty() : cons(xs[0], tb-take(xs[1:], n - 1));
    def tb-attn-causal-i(qs, ks, vs, scale, i) = (Comparable) len(qs) == 0 ? empty() : cons(tb-attend-one(qs[0], tb-take(ks, i), tb-take(vs, i), scale), tb-attn-causal-i(qs[1:], ks, vs, scale, i + 1));
    def tb-attn-seq-causal(qs, ks, vs, scale) = tb-attn-causal-i(qs, ks, vs, scale, 1);
    // --- the two pre-LN residual sub-blocks, then the whole block ---
    def tb-attn-sub(lns, wq, bq, wk, bk, wv, bv, wo, bo, scale) = tb-proj-seq(wo, bo, tb-attn-seq(tb-proj-seq(wq, bq, lns), tb-proj-seq(wk, bk, lns), tb-proj-seq(wv, bv, lns), scale));
    def tb-attn-block(xs, eps, g1, be1, wq, bq, wk, bk, wv, bv, wo, bo, scale) = tb-add-seq(xs, tb-attn-sub(tb-ln-seq(xs, eps, g1, be1), wq, bq, wk, bk, wv, bv, wo, bo, scale));
    def tb-ffn(w1, c1, w2, c2, x) = tb-affine(w2, c2, tb-gelu-map(tb-affine(w1, c1, x)));
    def tb-ffn-seq(w1, c1, w2, c2, xs) = (Comparable) len(xs) == 0 ? empty() : cons(tb-ffn(w1, c1, w2, c2, xs[0]), tb-ffn-seq(w1, c1, w2, c2, xs[1:]));
    def tb-ffn-block(xs, eps, g2, be2, w1, c1, w2, c2) = tb-add-seq(xs, tb-ffn-seq(w1, c1, w2, c2, tb-ln-seq(xs, eps, g2, be2)));
    def tb-block(xs, eps, g1, be1, wq, bq, wk, bk, wv, bv, wo, bo, scale, g2, be2, w1, c1, w2, c2) = tb-ffn-block(tb-attn-block(xs, eps, g1, be1, wq, bq, wk, bk, wv, bv, wo, bo, scale), eps, g2, be2, w1, c1, w2, c2);
}
