    def rpica-execute-at(envelope, admission, root, artifact, surface, local-ready, cursor-budget, step-budget) = rpica-walk-result(envelope, admission, fknq-execute-at(root, artifact, surface, local-ready, cursor-budget), step-budget);
    def rpica-execute-receipt-at(envelope, admission, root, artifact, surface, local-ready, cursor-budget, step-budget) = rpica-execution-result(envelope, admission, fknq-execute-at(root, artifact, surface, local-ready, cursor-budget), step-budget);
}
