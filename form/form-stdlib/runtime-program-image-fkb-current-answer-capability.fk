        let entry = fknq-entry-original-of(result);
        let current = rpica-current-source(result);
        (Comparable) psci-source-node-valid?(source) == 0 ? 0 : (Comparable) psci-entry-valid?(entry) == 0 ? 0 : !node_eq(psci-entry-source(entry), source) ? 0 : !node_eq(fknq-source-original(fknq-source(result)), source) ? 0 : !node_eq(fknq-entry-original(fknq-entry(result)), entry) ? 0 : !((String) fknq-source-path(result) == psci-source-path(source)) ? 0 : !((String) rpica-observation-string(result, 9) == psci-source-family(source)) ? 0 : !((String) rpica-observation-string(result, 10) == psci-source-path(source)) ? 0 : !((String) rpica-observation-string(result, 11) == psci-source-id(source)) ? 0 : (Comparable) psci-source-node-valid?(current) == 0 ? 0 : node_eq(source, current) ? 1 : 0;
    };
    def rpica-request-source-bound?(result) = (Comparable) rpica-source-bindings?(result) == 0 ? 0 : {
        let request = fknq-request(result);
        let source = rpica-held-source(result);
        let entry = fknq-entry-original-of(result);
        (String) fknq-request-kind(request) == "concept" ? pscish-key-member?(fknq-request-coordinate(request), psci-entry-keys(entry)) : (String) fknq-request-kind(request) == "nodeid" ? (String) fknq-request-coordinate(request) == fknq-node-key(source) || (String) fknq-request-coordinate(request) == fknq-node-key(entry) ? 1 : 0 : 0;
    };
    def rpica-outcome-bindings?(result) = (Comparable) rpica-request-source-bound?(result) == 0 ? 0 : !((String) fknq-status(result) == rpica-observation-string(result, 0)) ? 0 : !((String) fknq-reason(result) == rpica-observation-string(result, 1)) ? 0 : !((String) fknq-answer(result) == rpica-observation-string(result, 13)) ? 0 : !((Comparable) fknq-fresh?(result) == rpica-observation-int(result, 14)) ? 0 : !((Comparable) fknq-rebuild?(result) == rpica-observation-int(result, 15)) ? 0 : !((Comparable) fknq-match-count(result) == rpica-observation-int(result, 16)) ? 0 : !((Comparable) fknq-lookup-count(result) == rpica-observation-int(result, 17)) ? 0 : !((Comparable) fknq-hit-count(result) == rpica-observation-int(result, 18)) ? 0 : !((Comparable) fknq-executed?(result) == rpica-observation-int(result, 19)) ? 0 : !((Comparable) fknq-model-executed?(result) == rpica-observation-int(result, 20)) ? 0 : !((Comparable) fknq-pretokenized?(result) == rpica-observation-int(result, 21)) ? 0 : !((Comparable) fknq-scannerless?(result) == rpica-observation-int(result, 22)) ? 0 : (String) fknq-trace-actions(fknq-trace(result)) == rpica-observation-string(result, 23) ? 1 : 0;
    def rpica-hit-contract?(result) = (Comparable) rpica-outcome-bindings?(result) == 0 ? 0 : !((String) fknq-status(result) == "hit") ? 0 : !((String) fknq-reason(result) == "concept-registry-current-source-hit") ? 0 : !((Comparable) fknq-fresh?(result) == 1) ? 0 : !((Comparable) fknq-rebuild?(result) == 0) ? 0 : !((Comparable) fknq-match-count(result) == 1) ? 0 : !((Comparable) fknq-lookup-count(result) == 1) ? 0 : !((Comparable) fknq-hit-count(result) == 1) ? 0 : !((Comparable) fknq-executed?(result) == 1) ? 0 : !((Comparable) fknq-model-executed?(result) == 0) ? 0 : !((Comparable) fknq-pretokenized?(result) == 0) ? 0 : !((Comparable) fknq-scannerless?(result) == 1) ? 0 : !((String) fknq-trace-actions(fknq-trace(result)) == "choice,cut,release") ? 0 : str_len(fknq-answer(result)) > fkss-answer-limit() ? 0 : str_len(fknq-answer(result)) > psci-source-size(rpica-held-source(result)) ? 0 : (String) rpica-observation-string(result, 12) == fhcs-answer-key(fknq-answer(result)) ? 1 : 0;
    // capability = (marker result held-source current-source)
    def rpica-capability-row(result, held-source, current-source) = [rpica-version(), result, held-source, current-source];
    def rpica-capability-from-result(result) = (Comparable) rpica-hit-contract?(result) == 0 ? nothing() : {
