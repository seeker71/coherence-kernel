    };
    def rpica-walk-faulted?(walk) = {
        let trace = rpica-walk-trace(walk);
        (String) rpiwt-trace-status(trace) == rao-obs-error() && ((String) rpiwt-trace-stop-reason(trace) == rpiwt-stop-error() && ((Comparable) rpiwt-trace-output-count(trace) == 0 && (Comparable) rpiwt-trace-exit-code(trace) == 1)) ? 1 : 0;
    };
    def rpica-walk-timeout?(walk) = {
