    };
    def rpica-input-kind() = rpmw-kind-list([rpicsc-source-kind(), rpicsc-source-kind(), rpmw-kind-string(), rpmw-kind-string(), rpmw-kind-string(), rpmw-kind-string(), rpmw-kind-string(), rpmw-kind-string(), rpmw-kind-int(), rpmw-kind-int(), rpmw-kind-int(), rpmw-kind-int(), rpmw-kind-int(), rpmw-kind-int(), rpmw-kind-string(), rpmw-kind-string()]);
    def rpica-capability-kind(capability) = rpica-capability?(capability) ? rpica-input-kind() : rpmw-kind-absent();
    def rpica-symbol-request() = pise-request-by-canonical-key("knowledge/current-answer-outcome-bound");
    // The execution receipt is derived only after the resident symbol walk has
    // returned.  "load" means the already-admitted PIF identity entered the
    // resident walker; this adapter performs no disk load.  "release" means the
    // walk's immutable frame has left scope after return, fault, or timeout; it
    // is not a claim about a model, Metal handle, or host resource.
    def rpica-phase-marker() = "runtime-program-image-fkb-current-answer-capability-phase";
    def rpica-phase(name, observed) = [rpica-phase-marker(), name, observed];
    def rpica-phase?(phase, name) = !((Comparable) len(phase) == 3) ? 0 : !((String) phase[0] == rpica-phase-marker()) ? 0 : !((String) phase[1] == name) ? 0 : (Comparable) phase[2] == 0 || (Comparable) phase[2] == 1 ? 1 : 0;
    def rpica-phase-observed(phase) = phase[2];
    def rpica-phase-matches?(actual, expected, name) = (Comparable) rpica-phase?(actual, name) == 0 ? 0 : (Comparable) rpica-phase?(expected, name) == 0 ? 0 : (Comparable) rpica-phase-observed(actual) == rpica-phase-observed(expected) ? 1 : 0;
    def rpica-lifecycle-matches?(actual, expected) = !((Comparable) len(actual) == 6) ? 0 : !((Comparable) len(expected) == 6) ? 0 : (Comparable) rpica-phase-matches?(actual[0], expected[0], "load") == 0 ? 0 : (Comparable) rpica-phase-matches?(actual[1], expected[1], "call") == 0 ? 0 : (Comparable) rpica-phase-matches?(actual[2], expected[2], "return") == 0 ? 0 : (Comparable) rpica-phase-matches?(actual[3], expected[3], "fault") == 0 ? 0 : (Comparable) rpica-phase-matches?(actual[4], expected[4], "timeout") == 0 ? 0 : rpica-phase-matches?(actual[5], expected[5], "release");
    def rpica-walk-micro(walk) = rpsw-receipt-micro-walk(walk);
    def rpica-walk-trace(walk) = rpsw-receipt-trace(walk);
    def rpica-input-matches-capability?(input, capability) = !((Comparable) len(input) == 16) ? 0 : !node_eq(input[0], rpica-capability-held-source(capability)) ? 0 : !node_eq(input[1], rpica-capability-current-source(capability)) ? 0 : !((String) input[2] == rpica-capability-value(capability)[2]) ? 0 : !((String) input[3] == rpica-capability-value(capability)[3]) ? 0 : !((String) input[4] == rpica-capability-value(capability)[4]) ? 0 : !((String) input[5] == rpica-capability-value(capability)[5]) ? 0 : !((String) input[6] == rpica-capability-value(capability)[6]) ? 0 : !((String) input[7] == rpica-capability-value(capability)[7]) ? 0 : !((Comparable) input[8] == rpica-capability-value(capability)[8]) ? 0 : !((Comparable) input[9] == rpica-capability-value(capability)[9]) ? 0 : !((Comparable) input[10] == rpica-capability-value(capability)[10]) ? 0 : !((Comparable) input[11] == rpica-capability-value(capability)[11]) ? 0 : !((Comparable) input[12] == rpica-capability-value(capability)[12]) ? 0 : !((Comparable) input[13] == rpica-capability-value(capability)[13]) ? 0 : !((String) input[14] == rpica-capability-value(capability)[14]) ? 0 : (String) input[15] == rpica-capability-value(capability)[15] ? 1 : 0;
    def rpica-walk-bound-to-capability?(capability, walk) = (Comparable) rpica-capability?(capability) == 0 ? 0 : !rpsw-receipt?(walk) ? 0 : !rpsw-receipt-agrees?(walk) ? 0 : (Comparable) rpica-input-matches-capability?(rpsw-receipt-input-value(walk), capability) == 0 ? 0 : !rpmw-kind-equal?(rpsw-receipt-input-kind(walk), rpica-capability-kind(capability)) ? 0 : !rpsw-request-matches?(rpsw-receipt-symbol-request(walk), rpica-symbol-request()) ? 0 : !rpmw-receipt?(rpica-walk-micro(walk)) ? 0 : rpiwt-trace?(rpica-walk-trace(walk)) ? 1 : 0;
    def rpica-walk-returned?(walk) = {
