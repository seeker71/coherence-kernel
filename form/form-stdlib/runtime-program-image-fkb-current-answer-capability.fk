    def rpica-lifecycle-from-walk(walk) = [rpica-phase("load", 1), rpica-phase("call", 1), rpica-phase("return", rpica-walk-returned?(walk)), rpica-phase("fault", rpica-walk-faulted?(walk)), rpica-phase("timeout", rpica-walk-timeout?(walk)), rpica-phase("release", 1)];
    // receipt = (marker capability symbol-walk lifecycle status reason)
    def rpica-execution-marker() = "runtime-program-image-fkb-current-answer-capability-execution";
    def rpica-execution-row(capability, walk, lifecycle, status, reason) = [rpica-execution-marker(), capability, walk, lifecycle, status, reason];
    def rpica-execution-capability(receipt) = receipt[1];
    def rpica-execution-walk(receipt) = receipt[2];
    def rpica-execution-lifecycle(receipt) = receipt[3];
    def rpica-execution-status(receipt) = receipt[4];
    def rpica-execution-reason(receipt) = receipt[5];
    def rpica-execution-load(receipt) = rpica-phase-observed(rpica-execution-lifecycle(receipt)[0]);
    def rpica-execution-call(receipt) = rpica-phase-observed(rpica-execution-lifecycle(receipt)[1]);
    def rpica-execution-return(receipt) = rpica-phase-observed(rpica-execution-lifecycle(receipt)[2]);
