// runtime-program-image-fkb-current-answer-capability.fk -- admit one
// source-bound current answer and lookup outcome as typed resident PIF data.
//
// The effectful query remains the only filesystem authority.  This adapter
// accepts its canonical result, checks that the result and its 27-child native
// observation describe the same request, source, answer, counters, and
// lifecycle, then reconstructs the independently retained current source node.
// The resident image receives paired typed values and re-witnesses every pair.
//
// Nothing here opens a path, model, HTTP peer, remote provider, Metal carrier,
// flattened table, or generated ops registry.  `nothing` is refusal before a
// walk; a well-typed resident disagreement is present 0; agreement is present
// 1; resident fuel exhaustion has no output and remains timeout.
//
// preludes: form-stdlib/core.fk form-stdlib/form-nodeid-knowledge-query.fk
// preludes: form-stdlib/runtime-program-image-fkb-current-source-capability.fk
// preludes: form-stdlib/runtime-program-image-fkb-symbol-walk.fk
//
// Proven by: form-stdlib/tests/runtime-program-image-fkb-current-answer-capability-band.fk
section [form.bml] {
    def rpica-version() = "runtime-program-image-fkb-current-answer-capability-v1";
    def rpica-feature(name, status) = ["runtime-program-image-fkb-current-answer-capability-feature", name, status];
    def rpica-feature-name(feature) = feature[1];
    def rpica-feature-status(feature) = feature[2];
    def runtime-program-image-fkb-current-answer-capability-manifest() = [rpica-feature("canonical-query-result-required", 1), rpica-feature("canonical-native-observation-required", 1), rpica-feature("held-and-current-source-identity-required", 1), rpica-feature("bounded-answer-required", 1), rpica-feature("one-lookup-hit-outcome-required", 1), rpica-feature("choice-cut-release-lifecycle-required", 1), rpica-feature("typed-resident-answer-outcome-pairs", 1), rpica-feature("load-call-return-fault-timeout-release-receipt", 1), rpica-feature("nothing-zero-one-timeout-distinct", 1), rpica-feature("zero-byte-source-and-empty-answer-present", 1), rpica-feature("single-effectful-query-door", 1), rpica-feature("no-http-model-remote-or-metal-call", 1), rpica-feature("no-flatten-or-generated-table-authority", 1), rpica-feature("no-c-seed-growth", 1)];
    def runtime-program-image-fkb-current-answer-capability-manifest-has?(name, features) = nil?(features) ? 0 : (String) rpica-feature-name(head(features)) == name && (Comparable) rpica-feature-status(head(features)) == 1 ? 1 : runtime-program-image-fkb-current-answer-capability-manifest-has?(name, tail(features));
    def rpica-observation(result) = fknq-observation(result);
    def rpica-observation-child(result, at) = node_children(rpica-observation(result))[at];
    def rpica-observation-string(result, at) = node_value(rpica-observation-child(result, at));
    def rpica-observation-int(result, at) = node_value(rpica-observation-child(result, at));
    def rpica-result-shaped?(result) = nothing?(result) ? 0 : (Comparable) len(result) == 22 ? 1 : 0;
    def rpica-observation-shaped?(result) = (Comparable) rpica-result-shaped?(result) == 0 ? 0 : {
        let observation = rpica-observation(result);
        nothing?(observation) ? 0 : !node_eq(node_category(observation), fknq-observation-category()) ? 0 : (Comparable) len(node_children(observation)) == 27 ? 1 : 0;
    };
    def rpica-string-child?(result, at) = {
        let child = rpica-observation-child(result, at);
        nothing?(child) ? 0 : (Comparable) node_level(child) == 1 && (Comparable) node_type(child) == 2 ? 1 : 0;
    };
    def rpica-int-child?(result, at) = {
        let child = rpica-observation-child(result, at);
        nothing?(child) ? 0 : (Comparable) node_level(child) == 1 && (Comparable) node_type(child) == 1 ? 1 : 0;
    };
    def rpica-observation-leaf-shape?(result) = (Comparable) rpica-observation-shaped?(result) == 0 ? 0 : !rpica-string-child?(result, 0) ? 0 : !rpica-string-child?(result, 1) ? 0 : !rpica-string-child?(result, 9) ? 0 : !rpica-string-child?(result, 10) ? 0 : !rpica-string-child?(result, 11) ? 0 : !rpica-string-child?(result, 12) ? 0 : !rpica-string-child?(result, 13) ? 0 : !rpica-string-child?(result, 23) ? 0 : !rpica-string-child?(result, 24) ? 0 : !rpica-string-child?(result, 25) ? 0 : !rpica-int-child?(result, 14) ? 0 : !rpica-int-child?(result, 15) ? 0 : !rpica-int-child?(result, 16) ? 0 : !rpica-int-child?(result, 17) ? 0 : !rpica-int-child?(result, 18) ? 0 : !rpica-int-child?(result, 19) ? 0 : !rpica-int-child?(result, 20) ? 0 : !rpica-int-child?(result, 21) ? 0 : !rpica-int-child?(result, 22) ? 0 : rpica-int-child?(result, 26);
    def rpica-result-token-bindings?(result) = (Comparable) rpica-observation-leaf-shape?(result) == 0 ? 0 : (Comparable) fknq-source-token-valid?(fknq-source(result)) == 0 ? 0 : (Comparable) fknq-entry-token-valid?(fknq-entry(result)) == 0 ? 0 : (Comparable) fknq-request-valid?(fknq-request(result)) == 0 ? 0 : !node_eq(fknq-executor(result), fknq-executor-token()) ? 0 : !node_eq(fknq-source(result), rpica-observation-child(result, 4)) ? 0 : !node_eq(fknq-entry(result), rpica-observation-child(result, 5)) ? 0 : !node_eq(fknq-request(result), rpica-observation-child(result, 2)) ? 0 : !node_eq(fknq-executor(result), rpica-observation-child(result, 3)) ? 0 : !node_eq(fknq-source-original-of(result), rpica-observation-child(result, 6)) ? 0 : node_eq(fknq-entry-original-of(result), rpica-observation-child(result, 7)) ? 1 : 0;
    def rpica-held-source(result) = fknq-source-original-of(result);
    def rpica-current-source(result) = psci-source-node(rpica-observation-string(result, 9), rpica-observation-string(result, 24), rpica-observation-string(result, 25), rpica-observation-int(result, 26));
    def rpica-source-bindings?(result) = (Comparable) rpica-result-token-bindings?(result) == 0 ? 0 : {
