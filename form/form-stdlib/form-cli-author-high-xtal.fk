(defn AuthorAuthorityKind () "high-bml-class-template-field")
(defn FormAuthorHighAuthority () (list "abstraction" "FormAuthorHighAuthority" (list) (list) (list "AuthorAuthorityPath" "AuthorAuthorityKind") (list) (list)))
(defn GrainHigh () 0)
(defn GrainLower () 1)
(defn GrainBand () 2)
(defn GrainOrgan () 3)
(defn GrainSeed () 4)
(defn GrainOther () 5)
(defn Force () 0)
(defn fah-authority () FormAuthorHighAuthority)
(defn fah-pattern () (list "bml-or-higher" "organ-keep" "xtal-generated" "band-proof" "seed-shrink" "offer-not-force"))
(defn fah-ends? (s suffix) (do (if (lt (str_len s) (str_len suffix)) 0 (if (str_eq (substring s (sub (str_len s) (str_len suffix)) (str_len s)) suffix) 1 0))))
(defn fah-grain (path) (if (eq (fah-ends? path ".bml") 1) (GrainHigh) (if (eq (fah-ends? path ".bmf") 1) (GrainHigh) (if (eq (fah-ends? path ".form") 1) (GrainHigh) (if (eq (fah-ends? path "-xtal.fk") 1) (GrainLower) (if (eq (fah-ends? path "-compile.fk") 1) (GrainLower) (if (eq (fah-ends? path "-band.fk") 1) (GrainBand) (if (eq (fah-ends? path ".fk") 1) (GrainOrgan) (if (eq (fah-ends? path ".c") 1) (GrainSeed) (GrainOther))))))))))
(defn fah-new-meaning-offers? (path) (eq (fah-grain path) (GrainHigh)))
(defn fah-companion-ok? (path) (do (let g (fah-grain path)) (if (eq g (GrainHigh)) 1 (if (eq g (GrainBand)) 1 (if (eq g (GrainLower)) 1 0)))))
(defn fah-speak () "author-high new-meaning=bml-or-higher organ=keep-do-not-twin xtal=generated band=proof seed=shrink force=0
")
(defn fah-bit (ok bit) (if ok bit 0))
(defn fah-check () (do (let c0 (fah-bit (eq (fah-grain "form/form-stdlib/bml/form-cli-author-high.bml") (GrainHigh)) 1)) (let c1 (fah-bit (eq (fah-grain "grammars/stdlib-uplift-missing-grammars.bmf") (GrainHigh)) 2)) (let c2 (fah-bit (eq (fah-grain "grammars/field-domain-grammars.form") (GrainHigh)) 4)) (let c3 (fah-bit (eq (fah-grain "form/form-stdlib/form-cli-author-high-xtal.fk") (GrainLower)) 8)) (let c4 (fah-bit (eq (fah-grain "form/form-stdlib/tests/form-cli-author-high-band.fk") (GrainBand)) 16)) (let c5 (fah-bit (eq (fah-grain "form/form-stdlib/core.fk") (GrainOrgan)) 32)) (let c6 (fah-bit (eq (fah-grain "runtime/fkwu-uni.c") (GrainSeed)) 64)) (let c7 (fah-bit (and (eq (fah-new-meaning-offers? "a.bml") 1) (eq (fah-new-meaning-offers? "a.fk") 0)) 128)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
(defn FormAuthorHigh () (list "abstraction" "FormAuthorHigh" (list "T") (list "fah-ends?" "fah-grain" "fah-new-meaning-offers?" "fah-companion-ok?" "fah-speak" "fah-bit" "fah-check") (list "GrainHigh" "GrainLower" "GrainBand" "GrainOrgan" "GrainSeed" "GrainOther" "Force") (list "fah-authority") (list "fah-pattern")))
