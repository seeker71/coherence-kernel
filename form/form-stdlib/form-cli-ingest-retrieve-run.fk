; form-cli-ingest-retrieve-run.fk — witness ingest cell retrieve, no Qwen.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-ingest-retrieve-xtal.fk

(do
    (print_str (str_concat "fir check=" (str_concat (int_to_str (fir-check)) "\n")))
    (print_str (str_concat "fir span=" (str_concat (int_to_str (fir-span-check)) "\n")))
    (print_str (str_concat "fir collapse=" (str_concat (int_to_str (fir-retrieve (CollapsePath) (OneCell))) "\n")))
    (print_str (str_concat "fir depth=" (str_concat (int_to_str (fir-retrieve (DepthPath) (DepthAtLeast3))) "\n")))
    (print_str (str_concat "fir nbo=" (str_concat (int_to_str (fir-retrieve (NboPath) (WaitsAtTheDoor))) "\n")))
    0)
