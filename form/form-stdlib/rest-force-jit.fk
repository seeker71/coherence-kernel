// rest-force-jit.fk — a rest pointer forces through the real JIT door.
//
// The restanswer teaching (corpus row 1161) said: only when the actual
// result is required does the JIT fully optimize and resolve code into
// data. lg-force alone resolves by tree-walk; this cell completes the
// teaching: rfj-force LOWERS a rest pointer into the crystallize-on-heat
// door's own program shape and asks hg-request, so a pointer forced cold
// walks the form route (counted), a pointer forced hot BIRTHS NATIVE
// exactly once, and a cooled identity melts back — the whole hysteresis
// the heat gate already proves, now reachable from a resting answer.
//
// The JIT is as flexible as the need: an op the lowering cannot express
// (eq, or an unknown) does not refuse and does not pretend — it answers
// through lg-force with route "form-unlowerable", the same visible-row
// discipline hg-hottest keeps for hot-and-impure identities.
//
// preludes: form-stdlib/local-generate-organ.fk form-stdlib/jit-heat-gate.fk
//
// Proven by: form-stdlib/tests/rest-force-jit-band.fk
section [form.bml] {
    def rfj-op-tag(op) = (String) op == "add" ? 3 : (String) op == "sub" ? 4 : (String) op == "mul" ? 5 : 0;
    // emit one operand into the growing program; returns (list prog' idx)
    // or nothing when a nested pointer cannot lower.
    def rfj-emit-operand(x, prog) = (Comparable) lg-defer?(x) == 1 ? rfj-emit(x, prog) : {
        let p2 = lg-cat(prog, list(list(1, x)));
        list(p2, len(p2) - 1);
    };
    def rfj-emit(p, prog) = {
        let tag = rfj-op-tag(nth(p, 1));
        (Comparable) tag == 0 ? nothing() : {
            let ea = rfj-emit-operand(nth(p, 2), prog);
            nothing?(ea) ? nothing() : {
                let eb = rfj-emit-operand(nth(p, 3), nth(ea, 0));
                nothing?(eb) ? nothing() : {
                    let p3 = lg-cat(nth(eb, 0), list(list(tag, nth(ea, 1), nth(eb, 1))));
                    list(p3, len(p3) - 1);
                };
            };
        };
    };
    // lower a rest pointer to (list prog root), or nothing if unlowerable.
    def rfj-lower(p) = rfj-emit(p, list());
    // force through the gate: returns (list value route gate' born).
    // The unlowerable pointer still answers — by tree-walk, named as such.
    def rfj-force(g, p) = {
        let lowered = rfj-lower(p);
        nothing?(lowered) ? list(lg-force(p), "form-unlowerable", g, 0) : hg-request(g, nth(lowered, 0), nth(lowered, 1), 0);
    };
    0;
}
