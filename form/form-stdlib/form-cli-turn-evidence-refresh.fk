; form-cli-turn-evidence-refresh.fk — witness one bounded part of a completed
; turn. Repeat until the private evidence row becomes observed.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-cli-turn-evidence-live.fk

(do
    (let path (fctel-bound-path))
    (if (str_eq path "")
        (do (print_str "turn-evidence-refresh=withheld\n") 1)
        (do (print_str (fctel-refresh-once path)) 0)))
