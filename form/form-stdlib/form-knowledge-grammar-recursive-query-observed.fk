; form-knowledge-grammar-recursive-query-observed.fk -- focused physical repair.
;
; The first public 15-family run transported 14 families.  Grammars emitted a
; second, more discriminative source query after its first observation, but the
; then-one-heed door marked it spent.  This durable public record is the focused
; re-observation after aligning the live source door with BML MaxHeeds=2.
;
; Two model-authored query frames crossed, both hit the same caller-bound source,
; both observations were injected, and the local residence released.  The answer
; is semantically compact but reaches only 500000 promotion under the existing
; lexical evaluator, so answer95 remains 0.  Transport and answer quality stay
; separate; heldout and learned-weight credit remain exactly zero.
;
; preludes: form-stdlib/form-knowledge-public-query-offer-batch-observed.fk
; Proven by: form-stdlib/tests/form-knowledge-grammar-recursive-query-observed-band.fk

(do
    (defn fkgqo-schema () "grammar-recursive-query-observed-v1")
    (defn fkgqo-run-id ()
        "6a6fe4cfcdd7393469144da2bd321f44a165d93b987077a24f1a4e6c6ec65b9a")
    (defn fkgqo-residence-id ()
        "85d96cc87ce42a20478e0f752760e5cdcb6003df5647455068a3fd2de85a40b7")
    (defn fkgqo-raw-sha ()
        "2db61528d47c1d0f4209bdae8fd14faeb6a96f82661a69013ec1a2033e4acea3")
    (defn fkgqo-model-id () "qwen3.8-27b-q8_0-form-native-metal-jit")
    (defn fkgqo-answer () "Returns a new registry, newest shadows older")

    (defn fkgqo-find-offer (offers)
        (if (nil? offers) (nothing)
            (if (str_eq (fkpqo-offer-family (head offers)) "grammars")
                (head offers) (fkgqo-find-offer (tail offers)))))
    (defn fkgqo-offer () (fkgqo-find-offer (fkpqo-offers)))
    (defn fkgqo-row ()
        (fkhe-find-row (fkpqo-offer-row-id (fkgqo-offer)) (fkhe-rows)))
    (defn fkgqo-score (answer)
        (nmfe-observation "" (fkhe-expected (fkgqo-row)) answer 0 0))
    (defn fkgqo-score-promotion (answer)
        (nmfe-obs-promotion (fkgqo-score answer)))
    (defn fkgqo-score-answer95 (answer)
        (if (ge (fkgqo-score-promotion answer) 950000) 1 0))

    ; record = schema family plan offer-key run residence raw model path artifact
    ;          frames lookups hits commits source-matches source-mismatches
    ;          answer-cut answer promotion answer95 transport release
    ;          heldout learned supervised local remote
    (defn fkgqo-record-with
        (source-path source-artifact frames lookups hits commits matches mismatches
         answer-cut answer promotion answer95 transport release heldout learned
         supervised local remote)
        (list (fkgqo-schema) "grammars" (fkpqo-plan-sha)
              (fkpqo-offer-key (fkgqo-offer)) (fkgqo-run-id)
              (fkgqo-residence-id) (fkgqo-raw-sha) (fkgqo-model-id)
              source-path source-artifact frames lookups hits commits matches
              mismatches answer-cut answer promotion answer95 transport release
              heldout learned supervised local remote))
    (defn fkgqo-observation ()
        (fkgqo-record-with
            (fkpqo-offer-path (fkgqo-offer))
            (fkpqo-offer-source-id (fkgqo-offer))
            2 2 2 2 2 0 11 (fkgqo-answer) 500000 0 1 1 0 0 1 1 0))

    (defn fkgqo-source-path (o) (nth o 8))
    (defn fkgqo-source-artifact (o) (nth o 9))
    (defn fkgqo-frames (o) (nth o 10))
    (defn fkgqo-lookups (o) (nth o 11))
    (defn fkgqo-hits (o) (nth o 12))
    (defn fkgqo-commits (o) (nth o 13))
    (defn fkgqo-source-matches (o) (nth o 14))
    (defn fkgqo-source-mismatches (o) (nth o 15))
    (defn fkgqo-answer-cut (o) (nth o 16))
    (defn fkgqo-observed-answer (o) (nth o 17))
    (defn fkgqo-promotion (o) (nth o 18))
    (defn fkgqo-answer95 (o) (nth o 19))
    (defn fkgqo-transport (o) (nth o 20))
    (defn fkgqo-release (o) (nth o 21))
    (defn fkgqo-heldout-credit (o) (nth o 22))
    (defn fkgqo-learned-credit (o) (nth o 23))
    (defn fkgqo-supervised-credit (o) (nth o 24))
    (defn fkgqo-local (o) (nth o 25))
    (defn fkgqo-remote (o) (nth o 26))

    (defn fkgqo-identity-valid? (o)
        (if (and (eq (len o) 27)
            (and (str_eq (nth o 0) (fkgqo-schema))
            (and (str_eq (nth o 1) "grammars")
            (and (str_eq (nth o 2) (fkpqo-plan-sha))
            (and (str_eq (nth o 3) (fkpqo-offer-key (fkgqo-offer)))
            (and (eq (nmfe-sha256? (nth o 4)) 1)
            (and (eq (nmfe-sha256? (nth o 5)) 1)
                 (eq (nmfe-sha256? (nth o 6)) 1)))))))) 1 0))
    (defn fkgqo-source-valid? (o)
        (if (and (str_eq (fkgqo-source-path o)
                         (fkpqo-offer-path (fkgqo-offer)))
            (and (str_eq (fkgqo-source-artifact o)
                         (fkpqo-offer-source-id (fkgqo-offer)))
            (and (eq (fkgqo-frames o) (MaxHeeds))
            (and (eq (fkgqo-lookups o) (fkgqo-frames o))
            (and (eq (fkgqo-hits o) (fkgqo-frames o))
            (and (eq (fkgqo-commits o) (fkgqo-frames o))
            (and (eq (fkgqo-source-matches o) (fkgqo-frames o))
                 (eq (fkgqo-source-mismatches o) 0)))))))) 1 0))
    (defn fkgqo-score-valid? (o)
        (if (and (str_eq (fkgqo-observed-answer o) (fkgqo-answer))
            (and (eq (fkgqo-promotion o)
                     (fkgqo-score-promotion (fkgqo-observed-answer o)))
                 (eq (fkgqo-answer95 o)
                     (fkgqo-score-answer95 (fkgqo-observed-answer o))))) 1 0))
    (defn fkgqo-credit-valid? (o)
        (if (and (eq (fkgqo-transport o) 1)
            (and (eq (fkgqo-release o) 1)
            (and (eq (fkgqo-heldout-credit o) 0)
            (and (eq (fkgqo-learned-credit o) 0)
            (and (eq (fkgqo-supervised-credit o) 1)
            (and (eq (fkgqo-local o) 1)
                 (eq (fkgqo-remote o) 0))))))) 1 0))
    (defn fkgqo-valid? (o)
        (if (and (eq (fkgqo-identity-valid? o) 1)
            (and (eq (fkgqo-source-valid? o) 1)
            (and (ge (fkgqo-answer-cut o) 0)
            (and (eq (fkgqo-score-valid? o) 1)
                 (eq (fkgqo-credit-valid? o) 1))))) 1 0))

    (defn fkgqo-prior-grammar ()
        (fkpqoo-family-row "grammars" (fkpqoo-rows)))
    (defn fkgqo-combined-transport ()
        (add (sub (nth (fkpqoo-summary) 7)
                  (fkpqoo-transport (fkgqo-prior-grammar)))
             (fkgqo-transport (fkgqo-observation))))
    (defn fkgqo-combined-answer95 ()
        (add (sub (nth (fkpqoo-summary) 8)
                  (fkpqoo-answer95 (fkgqo-prior-grammar)))
             (fkgqo-answer95 (fkgqo-observation))))
    0)
