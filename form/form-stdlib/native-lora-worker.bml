// Shell-free launch and supervision. The supervisor retains the child's real exit
// status even when compilation or training aborts before a completion event.
// preludes: form-stdlib/native-lora-train.bml
section [form.bml] {
 class NativeLoraWorker {
  def nlw-argv() = list("./fkwu","observe/native-lora-train-run.fk");
  def nlw-supervisor-argv() = list("./fkwu","observe/native-lora-supervise-run.fk");
  def nlw-pid(path) {
   let text = read_file(path);
   nothing?(text) ? 0 : str_to_int(trim(text));
  }
  def nlw-running(dir) = ((Comparable) host_alive(nlw-pid(dir ++ "/train.pid")) == 1) || ((Comparable) host_alive(nlw-pid(dir ++ "/train-worker.pid")) == 1);
  def nlw-status(dir) {
   let rc = read_file(dir ++ "/train.rc");
   nlw-running(dir) ? "running" : nothing?(rc) ? (file_size(dir ++ "/train.pid") > 0 ? "interrupted-without-exit-status" : "idle") : (Comparable) str_to_int(trim(rc)) == 0 ? "completed" : "failed-exit-" ++ trim(rc);
  }
  def nlw-lock(dir) {
   let path = dir ++ "/.native-training-lock";
   let pid = host_spawn_at(list("/bin/mkdir",path),list("/dev/null","/dev/null","/dev/null"));
   pid <= 0 ? 0 : (Comparable) host_wait(pid) == 0 ? 1 : nlw-running(dir) ? 0 : nlw-reclaim(dir,path);
  }
  def nlw-reclaim(dir,path) {
   // A lock with no published pid may be between mkdir and spawn. Its age must
   // exceed the launch window before another process may recover it.
   ((now_unix_ms() / 1000) - file_mtime(path)) < 60 ? 0 : nlw-reclaim-old(dir,path);
  }
  def nlw-reclaim-old(dir,path) {
   let remove = fs-remove-tree(path);
   let pid = host_spawn_at(list("/bin/mkdir",path),list("/dev/null","/dev/null","/dev/null"));
   pid <= 0 ? 0 : ((Comparable) host_wait(pid) == 0);
  }
  def nlw-launch(r,dir) {
   let made = fs-mkdir(dir);
   !nlw-lock(dir) ? list("already-training-or-launching",0,dir) : nlw-launch-locked(r,dir);
  }
  def nlw-launch-locked(r,dir) {
   let prefix = dir ++ "/.training-" ++ int_to_str(host_pid()) ++ "-" ++ int_to_str(host_monotonic_ms());
   let request = prefix ++ ".json"; let ticket = prefix ++ ".ticket";
   let w = nag-write(request,json-emit-precise(r) ++ "\n");
   let t = nag-write(ticket,request ++ "\n" ++ dir ++ "\n");
   let stale = fs-remove-file(dir ++ "/train.rc");
   let cancel = fs-remove-file(ntr-get(r,"output") ++ "/cancel");
   let pid = host_spawn_at(nlw-supervisor-argv(),list(ticket,dir ++ "/train-supervisor.log",dir ++ "/train-supervisor.err"));
   pid <= 0 ? nlw-launch-failed(dir,pid) : nlw-launched(dir,pid);
  }
  def nlw-launched(dir,pid) {
   let wrote = nag-write(dir ++ "/train.pid",int_to_str(pid));
   list("launched",pid,dir);
  }
  def nlw-launch-failed(dir,rc) {
   let wrote = nag-write(dir ++ "/train.rc",int_to_str(rc)); let unlock = fs-remove-tree(dir ++ "/.native-training-lock");
   list("launch-refused",rc,dir);
  }
  def nlw-supervise(request,dir) {
   let pid = host_spawn_at(nlw-argv(),list(request,dir ++ "/train.log",dir ++ "/train.err"));
   let wrote = nag-write(dir ++ "/train-worker.pid",int_to_str(pid));
   let rc = pid <= 0 ? pid : host_wait(pid);
   let finished = nag-write(dir ++ "/train.rc",int_to_str(rc));
   let workerGone = fs-remove-file(dir ++ "/train-worker.pid");
   let supervisorGone = fs-remove-file(dir ++ "/train.pid");
   let unlock = fs-remove-tree(dir ++ "/.native-training-lock");
   rc;
  }
  def nlw-run(r,dir) {
   let launch = nlw-launch(r,dir);
   !((String) head(launch) == "launched") ? list(head(launch),-1,dir) : nlw-waited(host_wait(launch[1]),dir);
  }
  def nlw-waited(supervisorExit,dir) {
   let rc = read_file(dir ++ "/train.rc");
   (!((Comparable) supervisorExit == 0)) || nothing?(rc) ? list("supervisor-failed",supervisorExit,dir) : list(nlw-status(dir),str_to_int(trim(rc)),dir ++ "/train.log");
  }
 }
 0;
}
