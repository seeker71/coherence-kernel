// Shell-free launch and supervision. The supervisor retains the child's real exit
// status even when compilation or training aborts before a completion event.
import form-stdlib/native-lora-train.bml;
section [form.bml] {
 class NativeLoraWorker {
  def nlw-argv() = ["./fkwu","observe/native-lora-train-run.fk"];
  def nlw-supervisor-argv() = ["./fkwu","observe/native-lora-supervise-run.fk"];
  def nlw-pid(path) {
   let text = read_file(path);
   if nothing?(text) then 0 else str_to_int(trim(text));
  }
  def nlw-running(dir) = (((Comparable) host_alive(nlw-pid((dir + "/train.pid"))) == 1) || ((Comparable) host_alive(nlw-pid((dir + "/train-worker.pid"))) == 1));
  def nlw-status(dir) {
   let rc = read_file((dir + "/train.rc"));
   if nlw-running(dir) then "running" else if nothing?(rc) then if (file_size((dir + "/train.pid")) > 0) then "interrupted-without-exit-status" else "idle" else if ((Comparable) str_to_int(trim(rc)) == 0) then "completed" else ("failed-exit-" + trim(rc));
  }
  def nlw-lock(dir) {
   let path = (dir + "/.native-training-lock");
   let pid = host_spawn_at(["/bin/mkdir",path],["/dev/null","/dev/null","/dev/null"]);
   if (pid <= 0) then 0 else if ((Comparable) host_wait(pid) == 0) then 1 else if nlw-running(dir) then 0 else nlw-reclaim(dir,path);
  }
  def nlw-reclaim(dir,path) {
   // A lock with no published pid may be between mkdir and spawn. Its age must
   // exceed the launch window before another process may recover it.
   if (((now_unix_ms() / 1000) - file_mtime(path)) < 60) then 0 else nlw-reclaim-old(dir,path);
  }
  def nlw-reclaim-old(dir,path) {
   let remove = fs-remove-tree(path);
   let pid = host_spawn_at(["/bin/mkdir",path],["/dev/null","/dev/null","/dev/null"]);
   if (pid <= 0) then 0 else ((Comparable) host_wait(pid) == 0);
  }
  def nlw-launch(r,dir) {
   let made = fs-mkdir(dir);
   if (!nlw-lock(dir)) then ["already-training-or-launching",0,dir] else nlw-launch-locked(r,dir);
  }
  def nlw-launch-locked(r,dir) {
   let prefix = (dir + ("/.training-" + (host_pid().str() + ("-" + host_monotonic_ms().str()))));
   let request = (prefix + ".json"); let ticket = (prefix + ".ticket");
   let w = nag-write(request,(json-emit-precise(r) + "\n"));
   let t = nag-write(ticket,(request + ("\n" + (dir + "\n"))));
   let stale = fs-remove-file((dir + "/train.rc"));
   let cancel = fs-remove-file((ntr-get(r,"output") + "/cancel"));
   let pid = host_spawn_at(nlw-supervisor-argv(),[ticket,(dir + "/train-supervisor.log"),(dir + "/train-supervisor.err")]);
   if (pid <= 0) then nlw-launch-failed(dir,pid) else nlw-launched(dir,pid);
  }
  def nlw-launched(dir,pid) {
   let wrote = nag-write((dir + "/train.pid"),pid.str());
   ["launched",pid,dir];
  }
  def nlw-launch-failed(dir,rc) {
   let wrote = nag-write((dir + "/train.rc"),rc.str()); let unlock = fs-remove-tree((dir + "/.native-training-lock"));
   ["launch-refused",rc,dir];
  }
  def nlw-supervise(request,dir) {
   let pid = host_spawn_at(nlw-argv(),[request,(dir + "/train.log"),(dir + "/train.err")]);
   let wrote = nag-write((dir + "/train-worker.pid"),pid.str());
   let rc = if (pid <= 0) then pid else host_wait(pid);
   let finished = nag-write((dir + "/train.rc"),rc.str());
   let workerGone = fs-remove-file((dir + "/train-worker.pid"));
   let supervisorGone = fs-remove-file((dir + "/train.pid"));
   let unlock = fs-remove-tree((dir + "/.native-training-lock"));
   rc;
  }
  def nlw-run(r,dir) {
   let launch = nlw-launch(r,dir);
   if (!((String) launch[0] == "launched")) then [launch[0],-1,dir] else nlw-waited(host_wait(launch[1]),dir);
  }
  def nlw-waited(supervisorExit,dir) {
   let rc = read_file((dir + "/train.rc"));
   if ((!((Comparable) supervisorExit == 0)) || nothing?(rc)) then ["supervisor-failed",supervisorExit,dir] else [nlw-status(dir),str_to_int(trim(rc)),(dir + "/train.log")];
  }
 }
 0;
}
