; dsv4-hook-recipe-quiet.fk — the installed-default recipe for the decode-hook door:
; it acknowledges nothing on every request, so the model's token always stands BY LAW,
; not by an absence of wiring. This is the honest baseline of dtrs-install's ladder —
; a more-vital recipe replaces it through measured trials, never by assertion.
;
; preludes: form-stdlib/core.fk form-stdlib/dsv4-token-recipe-swap.fk
;
; Proven by: form-stdlib/tests/dsv4-decode-hook-door-band.fk

(do
    (defn dhrq-id () "dsv4-hook-recipe-quiet")
    (defn dhrq-prepare () 0)
    (defn dhrq-offer (state situation context default-token step deadline)
        (dtrs-offer "nothing" 0 0 0
            "quiet baseline: no claim crosses; the model's token stands by law"))
    0)
