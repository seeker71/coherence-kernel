; living-world-recursive-application.fk -- a nested lens asks before acting.
;
; A recursive mapping may propose a local structural derivation only while its
; lifecycle is STEADY.  The mapping's consent is not inherited by an unseen
; input: holders of both the mapping and input cross a second unanimous
; offer/ack boundary before the application enters the world.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk

(let LWRR-APPLICATION          (bp "LWRR-APPLICATION"))
(let LWRR-APPLICATION-EVIDENCE (bp "LWRR-APPLICATION-EVIDENCE"))
(let LWRR-APPLICATION-ORIGIN   (bp "LWRR-APPLICATION-ORIGIN"))

; children: mapping candidate, input, output, mapping, uncertainty,
;           lifecycle state, mapping attributions, input attributions, path
(defn lwrr-application
    (mapping-candidate input output mapping lifecycle
     mapping-attributions input-attributions)
    (intern_node LWRR-APPLICATION
        (list mapping-candidate input output mapping
              (lwrr-mapping-uncertainty mapping) lifecycle
              mapping-attributions input-attributions (lwo-local-path))))
(defn lwrr-application? (cell) (lwo-category? cell LWRR-APPLICATION))
(defn lwrr-application-mapping-candidate (application)
    (nth (node_children application) 0))
(defn lwrr-application-input (application) (nth (node_children application) 1))
(defn lwrr-application-output (application) (nth (node_children application) 2))
(defn lwrr-application-mapping (application) (nth (node_children application) 3))
(defn lwrr-application-uncertainty (application)
    (nth (node_children application) 4))
(defn lwrr-application-lifecycle (application)
    (nth (node_children application) 5))
(defn lwrr-application-mapping-attributions (application)
    (nth (node_children application) 6))
(defn lwrr-application-input-attributions (application)
    (nth (node_children application) 7))
(defn lwrr-application-path (application) (nth (node_children application) 8))

(defn lwrr-application-evidence (world mapping-candidate input lifecycle)
    (do
        (let mapping-attributions
            (lwo-active-attributions-for world mapping-candidate))
        (let input-attributions
            (lwo-active-attributions-for world input))
        (let witnesses
            (lwr-field-union-items
                (lwo-field-items input-attributions) mapping-attributions))
        (intern_node LWRR-APPLICATION-EVIDENCE
            (list mapping-attributions input-attributions
                  witnesses lifecycle))))
(defn lwrr-app-evidence-mapping-attributions (evidence)
    (nth (node_children evidence) 0))
(defn lwrr-app-evidence-input-attributions (evidence)
    (nth (node_children evidence) 1))
(defn lwrr-app-evidence-witnesses (evidence)
    (nth (node_children evidence) 2))
(defn lwrr-app-evidence-lifecycle (evidence)
    (nth (node_children evidence) 3))

(defn lwrr-application-origin (mapping-candidate input application witnesses)
    (intern_node LWRR-APPLICATION-ORIGIN
        (list mapping-candidate input application witnesses)))

(defn lwrr-application-emergent
    (mapping-candidate input mapping output evidence)
    (do
        (let witnesses (lwrr-app-evidence-witnesses evidence))
        (let application
            (lwrr-application mapping-candidate input output mapping
                (lwrr-app-evidence-lifecycle evidence)
                (lwrr-app-evidence-mapping-attributions evidence)
                (lwrr-app-evidence-input-attributions evidence)))
        (let origin
            (lwrr-application-origin
                mapping-candidate input application witnesses))
        (lwo-emergent application witnesses
            (intern_trivial_int
                (lwo-field-size (lwrr-mapping-supports mapping)))
            (intern_trivial_int
                (lwrr-ref-count
                    (lwrr-signature-template
                        (lwrr-mapping-signature mapping))))
            (intern_trivial_int (lwo-field-size witnesses))
            origin)))

(defn lwrr-application-proposal-from-output
    (world mapping-candidate input mapping output lifecycle)
    (do
        (let evidence
            (lwrr-application-evidence
                world mapping-candidate input lifecycle))
        (let candidate
            (lwrr-application-emergent
                mapping-candidate input mapping output evidence))
        (lwt-proposal candidate
            (lwt-sources-from-attributions
                (lwo-field-items (lwo-emergent-witnesses candidate))
                (lwo-empty-field))
            (lwo-emergent-provenance candidate))))

(defn lwrr-application-proposal (world mapping-candidate input)
    (if (or (eq (lwrl-recursive-candidate? mapping-candidate) 0)
            (or (eq (lwo-active? world mapping-candidate) 0)
                (or (eq (lwo-emergent-ready? world mapping-candidate) 0)
                    (or (eq (lwrl-steady? world mapping-candidate) 0)
                        (eq (lwo-active? world input) 0)))))
        (lwo-none)
        (do
            (let mapping (lwo-emergent-shape mapping-candidate))
            (let lifecycle (lwrl-state world mapping-candidate))
            (let output
                (lwrr-apply-signature
                    (lwrr-mapping-signature mapping) input))
            (if (node_eq output (lwo-none)) (lwo-none)
                (lwrr-application-proposal-from-output
                    world mapping-candidate input mapping output lifecycle)))))

(defn lwrr-application-round (world mapping-candidate input prior)
    (do
        (let proposal
            (lwrr-application-proposal world mapping-candidate input))
        (lwt-round world
            (if (node_eq proposal (lwo-none))
                (lwo-empty-field)
                (lwo-field-add (lwo-empty-field) proposal))
            (lwo-empty-field) prior)))

; Generic tending cannot know the lifecycle contract of this later module.
; Recursive applications therefore cross through this narrower integration
; door, which re-observes the mapping immediately before admission.
(defn lwrr-application-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwrr-application?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwrr-integrate-application (round proposal action)
    (do
        (let candidate (lwt-proposal-candidate proposal))
        (if (eq (lwrr-application-candidate? candidate) 0)
            (lwt-round (lwt-round-world round)
                       (lwt-round-proposals round)
                       (lwo-empty-field) round)
            (do
                (let application (lwo-emergent-shape candidate))
                (let mapping-candidate
                    (lwrr-application-mapping-candidate application))
                (if (eq (lwrl-steady?
                            (lwt-round-world round) mapping-candidate) 0)
                    (lwt-round (lwt-round-world round)
                               (lwt-round-proposals round)
                               (lwo-field-add (lwo-empty-field)
                                   (lwt-evaluate-proposal
                                       (lwt-round-world round) proposal))
                               round)
                    (lwt-integrate round proposal action))))))
