// One native model serves the entire recording. Timestamp progress chooses the
// next window; incomplete unclosed text never becomes a completed segment.
import form-stdlib/native-whisper-decode.bml;
import form-stdlib/native-adapter-generation.bml;
section [form.bml] {
 class NativeWhisperTranscribe {
  // segment: start sample, end sample, text. Sample coordinates remain integers.
  def nwt-segment(st,start,end,ids) = [start,end,trim(enw-text(st,reverse(ids)))];
  def nwt-segments(st,ids,offset,size,start,words,segments,complete) {
   nil?(ids) ? (complete && (!nil?(words)) ? append(segments,[nwt-segment(st,start,offset + size,words)]) : segments) : ids[0] >= eng-ts0(st) ? nwt-timestamp(st,ids,offset,size,start,words,segments,complete,(ids[0] - eng-ts0(st)) * 320) : nwt-segments(st,ids[1:],offset,size,start,cons(ids[0],words),segments,complete);
  }
  def nwt-timestamp(st,ids,offset,size,start,words,segments,complete,tick) {
   let end = offset + (tick > size ? size : tick);
   end < start ? form_error("native Whisper timestamp moved backwards") : nwt-segments(st,ids[1:],offset,size,end,[],nil?(words) ? segments : append(segments,[nwt-segment(st,start,end,words)]),complete);
  }
  def nwt-paired(ids,ts) = len(ids) < 2 ? 0 : (ids[0] >= ts) && (ids[1] >= ts) ? 1 : nwt-paired(ids[1:],ts);
  def nwt-next(st,result,segments,offset,size) {
   let ids = result[1]; let n = len(ids); let eos = (String) result[2] == "eos";
   let single = (n >= 2) && ((ids[n - 2] < eng-ts0(st)) && (ids[n - 1] >= eng-ts0(st)));
   eos && (single || (!nwt-paired(ids,eng-ts0(st)))) ? (offset + size) : nil?(segments) ? offset : segments[len(segments) - 1][1];
  }
  def nwt-segment-json(row) = json-node-object([nwd-float("start",row[0] / 16000.0),nwd-float("end",row[1] / 16000.0),nwd-text("text",row[2])]);
  def nwt-segment-nodes(rows) = rows |> map(nwt-segment-json);
  def nwt-text(rows) = nil?(rows) ? "" : ((String) rows[0][2] + (nil?(rows[1:]) ? "" : (" " + nwt-text(rows[1:]))));
  def nwt-stream-segments(path,rows) = (Comparable) len(path) == 0 ? 0 : nag-write(path,nwt-text(rows));
  def nwt-loop(st,decoder,wav,language,offset,segments,windows,tokens,seed,stream,cancel,events) {
   let total = wav[2][7];
   offset >= total ? [language,segments,"completed",windows,tokens,offset] : (len(cancel) > 0) && (file_size(cancel) > 0) ? [language,segments,"cancelled",windows,tokens,offset] : nwt-window(st,decoder,wav,language,offset,segments,windows,tokens,seed,stream,cancel,events,(total - offset) > 480000 ? 480000 : (total - offset));
  }
  def nwt-window(st,decoder,wav,language,offset,segments,windows,tokens,seed,stream,cancel,events,size) {
   let frames = size / 160; let encoded = nwd-encode(st,wav,offset,frames,events);
   (Comparable) encoded == 0 ? nwt-digital(st,decoder,wav,language,offset,segments,windows,tokens,seed,stream,cancel,events,size) : nwt-decode-window(st,decoder,wav,language,offset,segments,windows,tokens,seed,stream,cancel,events,size);
  }
  def nwt-digital(st,decoder,wav,language,offset,segments,windows,tokens,seed,stream,cancel,events,size) {
   let event = nwd-event(events,"window-selected",[nwd-int("window_sample",offset),nwd-int("next_sample",offset + size),nwd-text("selected","skip-zero-model-input"),nwd-int("sampled_tokens",0)]);
   nwt-loop(st,decoder,wav,language,offset + size,segments,windows + 1,tokens,seed,stream,cancel,events);
  }
  def nwt-decode-window(st,decoder,wav,language,offset,segments,windows,tokens,seed,stream,cancel,events,size) {
   let attemptStream = (Comparable) len(stream) == 0 ? "" : (stream + ".attempt");
   let result = nwd-decode(st,decoder,language,0,seed + windows,attemptStream,cancel,events,offset);
   let count = [tokens[0] + len(result[1]),tokens[1] + result[8],tokens[2] + result[9],tokens[3] + result[10]];
   (String) result[2] == "cancelled" ? [result[0],segments,"cancelled",windows + 1,count,offset] : nwd-silent(result) ? nwt-silence(st,decoder,wav,result,offset,size,segments,windows,count,seed,stream,cancel,events) : nwt-words(st,decoder,wav,result,offset,size,segments,windows,count,seed,stream,cancel,events);
  }
  def nwt-silence(st,decoder,wav,result,offset,size,segments,windows,count,seed,stream,cancel,events) {
   let event = nwd-event(events,"window-selected",[nwd-int("window_sample",offset),nwd-int("next_sample",offset + size),nwd-text("selected","skip-silence"),nwd-int("accepted_segments",0)]);
   nwt-loop(st,decoder,wav,result[0],offset + size,segments,windows + 1,count,seed,stream,cancel,events);
  }
  def nwt-words(st,decoder,wav,result,offset,size,segments,windows,count,seed,stream,cancel,events) {
   let rows = nwt-segments(st,result[1],offset,size,offset,[],[],(String) result[2] == "eos");
   let next = nwt-next(st,result,rows,offset,size); let accepted = append(segments,rows);
   let event = nwd-event(events,"window-selected",[nwd-int("window_sample",offset),nwd-int("next_sample",next),nwd-int("accepted_segments",len(rows)),nwd-text("finish",result[2]),nwd-text("selected",next > offset ? "advance-to-observed-timestamp" : "withhold-no-progress")]);
   let streamed = nwt-stream-segments(stream,accepted);
   next <= offset ? [result[0],accepted,"incomplete-" + result[2],windows + 1,count,offset] : nwt-loop(st,decoder,wav,result[0],next,accepted,windows + 1,count,seed,stream,cancel,events);
  }
  def nwt-transcribe(base,path,hint,stream,cancel,events) {
   let start = host_monotonic_ms(); let wav = nwa-open(path); let level = nwa-level-state(wav);
   let cancelled = (len(cancel) > 0) && (file_size(cancel) > 0);
   cancelled || ((Comparable) level[1] == 0.0) ? nwt-no-model(base,wav,level[0],stream,events,start,cancelled) : nwt-admitted(base,wav,level[0],hint,stream,cancel,events,start);
  }
  def nwt-no-model(base,wav,level,stream,events,start,cancelled) {
   let total = wav[2][7]; let status = cancelled ? "cancelled" : "completed"; let processed = cancelled ? 0 : total;
   let observed = bfc-envelope(0,960001,0,[total,level,0],3); let sent = bfc-record-out(observed,0); let response = bfc-record-in(bfc-control(observed,3),1);
   let clear = nwt-stream-segments(stream,[]); let closed = nwa-close(wav);
   let event = nwd-event(events,"audio-decision",[nwd-text("model_path",base),nwd-int("model_admitted",0),nwd-text("choices","admit-model|skip-exact-digital-silence|cancel"),nwd-text("selected",cancelled ? "cancel" : "skip-exact-digital-silence"),nwd-float("dbfs",level),nwd-int("processed_samples",processed),nwd-int("total_samples",total),nwd-int("elapsed_ms",host_monotonic_ms() - start),nwd-int("sampled_tokens",0),nwd-int("retained_buffers",metal_live()[2])]);
   json-node-object([nwd-text("owner","Form-native-Metal"),nwd-text("model","Whisper-large-v3-turbo"),nwd-int("model_admitted",0),nwd-text("status",status),nwd-text("language",""),nwd-text("text",""),json-node-pair("segments",json-node-array([])),nwd-int("windows",0),nwd-int("selected_decoded_tokens",0),nwd-int("sampled_tokens",0),nwd-int("model_forward_tokens",0),nwd-int("decode_attempts",0),nwd-int("processed_samples",processed),nwd-int("total_samples",total),nwd-float("dbfs",level),nwd-int("elapsed_ms",host_monotonic_ms() - start),nwd-text("events",events)]);
  }
  def nwt-admitted(base,wav,level,hint,stream,cancel,events,start) {
   let opened = host_monotonic_ms();
   let st = nws-open(base,nws-tokenizer()); let decoder = nwd-open(); let language = (Comparable) len(hint) == 0 ? -1 : nwd-language(hint,take(eng-languages(st),nwd-langs()),0); let seed = now_unix_ms() % 2147483647;
   let event = nwd-event(events,"admission",[nwd-text("model_path",base),nwd-int("model_admitted",1),nwd-int("mapped_tensors",len(enw-hs(st))),nwd-int("input_rate",wav[2][0]),nwd-int("input_channels",wav[2][1]),nwd-int("input_bits",wav[2][2]),nwd-int("input_samples_16k",wav[2][7]),nwd-float("dbfs",level),nwd-int("audio_open_ms",opened - start),nwd-int("model_open_ms",host_monotonic_ms() - opened),nwd-int("seed",seed)]);
   let clear = nwt-stream-segments(stream,[]);
   let result = nwt-loop(st,decoder,wav,language,0,[],0,[0,0,0,0],seed,stream,cancel,events);
   let closed = nwd-close(decoder); let model = nws-close(st); let audio = nwa-close(wav);
   let finished = nwd-event(events,"completion",[nwd-text("status",result[2]),nwd-int("windows",result[3]),nwd-int("selected_decoded_tokens",result[4][0]),nwd-int("sampled_tokens",result[4][1]),nwd-int("model_forward_tokens",result[4][2]),nwd-int("decode_attempts",result[4][3]),nwd-int("processed_samples",result[5]),nwd-int("elapsed_ms",host_monotonic_ms() - start),nwd-int("retained_buffers",metal_live()[2])]);
   json-node-object([nwd-text("owner","Form-native-Metal"),nwd-text("model","Whisper-large-v3-turbo"),nwd-int("model_admitted",1),nwd-text("status",result[2]),nwd-text("language",result[0] < 0 ? "" : nwd-code(result[0])),nwd-text("text",nwt-text(result[1])),json-node-pair("segments",json-node-array(nwt-segment-nodes(result[1]))),nwd-int("windows",result[3]),nwd-int("selected_decoded_tokens",result[4][0]),nwd-int("sampled_tokens",result[4][1]),nwd-int("model_forward_tokens",result[4][2]),nwd-int("decode_attempts",result[4][3]),nwd-int("processed_samples",result[5]),nwd-int("total_samples",wav[2][7]),nwd-float("dbfs",level),nwd-int("elapsed_ms",host_monotonic_ms() - start),nwd-text("events",events)]);
  }
 }
 0;
}
