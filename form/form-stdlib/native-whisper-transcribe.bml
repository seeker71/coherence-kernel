// One native model serves the entire recording. Timestamp progress chooses the
// next window; incomplete unclosed text never becomes a completed segment.
// preludes: form-stdlib/native-whisper-decode.bml form-stdlib/native-adapter-generation.bml
section [form.bml] {
 class NativeWhisperTranscribe {
  // segment: start sample, end sample, text. Sample coordinates remain integers.
  def nwt-segment(st,start,end,ids) = list(start,end,trim(enw-text(st,reverse(ids))));
  def nwt-segments(st,ids,offset,size,start,words,segments,complete) {
   if nil?(ids) then if (complete && (!nil?(words))) then append(segments,list(nwt-segment(st,start,(offset + size),words))) else segments else if (head(ids) >= eng-ts0(st)) then nwt-timestamp(st,ids,offset,size,start,words,segments,complete,((head(ids) - eng-ts0(st)) * 320)) else nwt-segments(st,tail(ids),offset,size,start,cons(head(ids),words),segments,complete);
  }
  def nwt-timestamp(st,ids,offset,size,start,words,segments,complete,tick) {
   let end = (offset + (if (tick > size) then size else tick));
   if (end < start) then form_error("native Whisper timestamp moved backwards") else nwt-segments(st,tail(ids),offset,size,end,list(),if nil?(words) then segments else append(segments,list(nwt-segment(st,start,end,words))),complete);
  }
  def nwt-paired(ids,ts) = if (len(ids) < 2) then 0 else if ((head(ids) >= ts) && (nth(ids,1) >= ts)) then 1 else nwt-paired(tail(ids),ts);
  def nwt-next(st,result,segments,offset,size) {
   let ids = nth(result,1); let n = len(ids); let eos = ((String) nth(result,2) == "eos");
   let single = ((n >= 2) && ((nth(ids,(n - 2)) < eng-ts0(st)) && (nth(ids,(n - 1)) >= eng-ts0(st))));
   if (eos && (single || (!nwt-paired(ids,eng-ts0(st))))) then (offset + size) else if nil?(segments) then offset else nth(nth(segments,(len(segments) - 1)),1);
  }
  def nwt-segment-json(row) = json-node-object(list(nwd-float("start",(head(row) / 16000.0)),nwd-float("end",(nth(row,1) / 16000.0)),nwd-text("text",nth(row,2))));
  def nwt-segment-nodes(rows) = if nil?(rows) then list() else cons(nwt-segment-json(head(rows)),nwt-segment-nodes(tail(rows)));
  def nwt-text(rows) = if nil?(rows) then "" else str_concat(nth(head(rows),2),if nil?(tail(rows)) then "" else str_concat(" ",nwt-text(tail(rows))));
  def nwt-stream-segments(path,rows) = if ((Comparable) str_len(path) == 0) then 0 else nag-write(path,nwt-text(rows));
  def nwt-loop(st,decoder,wav,language,offset,segments,windows,tokens,seed,stream,cancel,events) {
   let total = nth(nth(wav,2),7);
   if (offset >= total) then list(language,segments,"completed",windows,tokens,offset) else if ((str_len(cancel) > 0) && (file_size(cancel) > 0)) then list(language,segments,"cancelled",windows,tokens,offset) else nwt-window(st,decoder,wav,language,offset,segments,windows,tokens,seed,stream,cancel,events,if ((total - offset) > 480000) then 480000 else (total - offset));
  }
  def nwt-window(st,decoder,wav,language,offset,segments,windows,tokens,seed,stream,cancel,events,size) {
   let frames = (size / 160); let encoded = nwd-encode(st,wav,offset,frames,events);
   if ((Comparable) encoded == 0) then nwt-digital(st,decoder,wav,language,offset,segments,windows,tokens,seed,stream,cancel,events,size) else nwt-decode-window(st,decoder,wav,language,offset,segments,windows,tokens,seed,stream,cancel,events,size);
  }
  def nwt-digital(st,decoder,wav,language,offset,segments,windows,tokens,seed,stream,cancel,events,size) {
   let event = nwd-event(events,"window-selected",list(nwd-int("window_sample",offset),nwd-int("next_sample",(offset + size)),nwd-text("selected","skip-zero-model-input"),nwd-int("sampled_tokens",0)));
   nwt-loop(st,decoder,wav,language,(offset + size),segments,(windows + 1),tokens,seed,stream,cancel,events);
  }
  def nwt-decode-window(st,decoder,wav,language,offset,segments,windows,tokens,seed,stream,cancel,events,size) {
   let attemptStream = if ((Comparable) str_len(stream) == 0) then "" else str_concat(stream,".attempt");
   let result = nwd-decode(st,decoder,language,0,(seed + windows),attemptStream,cancel,events,offset);
   let count = list((head(tokens) + len(nth(result,1))),(nth(tokens,1) + nth(result,8)),(nth(tokens,2) + nth(result,9)),(nth(tokens,3) + nth(result,10)));
   if ((String) nth(result,2) == "cancelled") then list(head(result),segments,"cancelled",(windows + 1),count,offset) else if nwd-silent(result) then nwt-silence(st,decoder,wav,result,offset,size,segments,windows,count,seed,stream,cancel,events) else nwt-words(st,decoder,wav,result,offset,size,segments,windows,count,seed,stream,cancel,events);
  }
  def nwt-silence(st,decoder,wav,result,offset,size,segments,windows,count,seed,stream,cancel,events) {
   let event = nwd-event(events,"window-selected",list(nwd-int("window_sample",offset),nwd-int("next_sample",(offset + size)),nwd-text("selected","skip-silence"),nwd-int("accepted_segments",0)));
   nwt-loop(st,decoder,wav,head(result),(offset + size),segments,(windows + 1),count,seed,stream,cancel,events);
  }
  def nwt-words(st,decoder,wav,result,offset,size,segments,windows,count,seed,stream,cancel,events) {
   let rows = nwt-segments(st,nth(result,1),offset,size,offset,list(),list(),((String) nth(result,2) == "eos"));
   let next = nwt-next(st,result,rows,offset,size); let accepted = append(segments,rows);
   let event = nwd-event(events,"window-selected",list(nwd-int("window_sample",offset),nwd-int("next_sample",next),nwd-int("accepted_segments",len(rows)),nwd-text("finish",nth(result,2)),nwd-text("selected",if (next > offset) then "advance-to-observed-timestamp" else "withhold-no-progress")));
   let streamed = nwt-stream-segments(stream,accepted);
   if (next <= offset) then list(head(result),accepted,str_concat("incomplete-",nth(result,2)),(windows + 1),count,offset) else nwt-loop(st,decoder,wav,head(result),next,accepted,(windows + 1),count,seed,stream,cancel,events);
  }
  def nwt-transcribe(base,path,hint,stream,cancel,events) {
   let start = host_monotonic_ms(); let wav = nwa-open(path); let level = nwa-level-state(wav);
   let cancelled = ((str_len(cancel) > 0) && (file_size(cancel) > 0));
   if (cancelled || ((Comparable) nth(level,1) == 0.0)) then nwt-no-model(base,wav,head(level),stream,events,start,cancelled) else nwt-admitted(base,wav,head(level),hint,stream,cancel,events,start);
  }
  def nwt-no-model(base,wav,level,stream,events,start,cancelled) {
   let total = nth(nth(wav,2),7); let status = if cancelled then "cancelled" else "completed"; let processed = if cancelled then 0 else total;
   let observed = bfc-envelope(0,960001,0,list(total,level,0),3); let sent = bfc-record-out(observed,0); let response = bfc-record-in(bfc-control(observed,3),1);
   let clear = nwt-stream-segments(stream,list()); let closed = nwa-close(wav);
   let event = nwd-event(events,"audio-decision",list(nwd-text("model_path",base),nwd-int("model_admitted",0),nwd-text("choices","admit-model|skip-exact-digital-silence|cancel"),nwd-text("selected",if cancelled then "cancel" else "skip-exact-digital-silence"),nwd-float("dbfs",level),nwd-int("processed_samples",processed),nwd-int("total_samples",total),nwd-int("elapsed_ms",(host_monotonic_ms() - start)),nwd-int("sampled_tokens",0),nwd-int("retained_buffers",nth(metal_live(),2))));
   json-node-object(list(nwd-text("owner","Form-native-Metal"),nwd-text("model","Whisper-large-v3-turbo"),nwd-int("model_admitted",0),nwd-text("status",status),nwd-text("language",""),nwd-text("text",""),json-node-pair("segments",json-node-array(list())),nwd-int("windows",0),nwd-int("selected_decoded_tokens",0),nwd-int("sampled_tokens",0),nwd-int("model_forward_tokens",0),nwd-int("decode_attempts",0),nwd-int("processed_samples",processed),nwd-int("total_samples",total),nwd-float("dbfs",level),nwd-int("elapsed_ms",(host_monotonic_ms() - start)),nwd-text("events",events)));
  }
  def nwt-admitted(base,wav,level,hint,stream,cancel,events,start) {
   let opened = host_monotonic_ms();
   let st = nws-open(base,nws-tokenizer()); let decoder = nwd-open(); let language = if ((Comparable) str_len(hint) == 0) then -1 else nwd-language(hint,take(eng-languages(st),nwd-langs()),0); let seed = (now_unix_ms() % 2147483647);
   let event = nwd-event(events,"admission",list(nwd-text("model_path",base),nwd-int("model_admitted",1),nwd-int("mapped_tensors",len(enw-hs(st))),nwd-int("input_rate",head(nth(wav,2))),nwd-int("input_channels",nth(nth(wav,2),1)),nwd-int("input_bits",nth(nth(wav,2),2)),nwd-int("input_samples_16k",nth(nth(wav,2),7)),nwd-float("dbfs",level),nwd-int("audio_open_ms",(opened - start)),nwd-int("model_open_ms",(host_monotonic_ms() - opened)),nwd-int("seed",seed)));
   let clear = nwt-stream-segments(stream,list());
   let result = nwt-loop(st,decoder,wav,language,0,list(),0,list(0,0,0,0),seed,stream,cancel,events);
   let closed = nwd-close(decoder); let model = nws-close(st); let audio = nwa-close(wav);
   let finished = nwd-event(events,"completion",list(nwd-text("status",nth(result,2)),nwd-int("windows",nth(result,3)),nwd-int("selected_decoded_tokens",head(nth(result,4))),nwd-int("sampled_tokens",nth(nth(result,4),1)),nwd-int("model_forward_tokens",nth(nth(result,4),2)),nwd-int("decode_attempts",nth(nth(result,4),3)),nwd-int("processed_samples",nth(result,5)),nwd-int("elapsed_ms",(host_monotonic_ms() - start)),nwd-int("retained_buffers",nth(metal_live(),2))));
   json-node-object(list(nwd-text("owner","Form-native-Metal"),nwd-text("model","Whisper-large-v3-turbo"),nwd-int("model_admitted",1),nwd-text("status",nth(result,2)),nwd-text("language",if (head(result) < 0) then "" else nwd-code(head(result))),nwd-text("text",nwt-text(nth(result,1))),json-node-pair("segments",json-node-array(nwt-segment-nodes(nth(result,1)))),nwd-int("windows",nth(result,3)),nwd-int("selected_decoded_tokens",head(nth(result,4))),nwd-int("sampled_tokens",nth(nth(result,4),1)),nwd-int("model_forward_tokens",nth(nth(result,4),2)),nwd-int("decode_attempts",nth(nth(result,4),3)),nwd-int("processed_samples",nth(result,5)),nwd-int("total_samples",nth(nth(wav,2),7)),nwd-float("dbfs",level),nwd-int("elapsed_ms",(host_monotonic_ms() - start)),nwd-text("events",events)));
  }
 }
 0;
}
