// form-recipe-exec-token-live.fk — a streamed NodeID request crosses the
// registered recipe into a generated-on-demand Metal micro-thought.
//
// THE CROSSING. frexl-stream-parse folds the request surface one raw byte at a
// time and invokes frex-parse only after that bounded cursor has seen the whole
// frame. No tokenizer, vocabulary, merge pass, or model payload participates.
// An accepted request resolves the interned affine recipe, reads its multiplier
// and addend children, and composes one MSL kernel directly from those values.
// The emitted source is itself carried by a content-addressed code NodeID.
//
// THE EFFECT. frexl-execute-request allocates and writes one four-byte buffer,
// asks the Metal door to compile the generated source, enqueues one thread,
// syncs, reads one signed 32-bit value, and releases the buffer. Every stage is
// retained as bounded scalar state in a separate live execution NodeID. The MSL
// and request surface never appear in witness rendering.
//
// HONEST FLAGS. source-generated means Form composed MSL bytes. native-code-
// generated means metal_pipeline returned a live handle. executed means enqueue
// and sync both acknowledged the dispatch. model-executed remains 0. The buffer
// release flag reports only metal_buf_free; the pure lifecycle's `release` event
// reports the bounded reducer context and is not substituted for physical free.
//
// SIGNALS. An absent Metal door offers nothing. A carrier refusal after the
// door is live offers failure, unless metal_status explicitly names timeout.
// A four-byte result is value-present even when its value is 0 or 1. A wrong
// value and a failed buffer release remain failures after execution rather than
// being dressed as success.
//
// This cell emits no persistent cache and no mesh/broadcast claim. It changes
// no C seed. The only carrier program is the MSL composed here from the recipe.
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
// preludes: form-stdlib/format-arith.fk form-stdlib/metal-door.fk
// preludes: form-stdlib/form-recipe-exec-token.fk
//
section [form.bml] {
    // ── raw byte cursor ──────────────────────────────────────────────
    // cursor = (buffer byte-count overflow complete)
    def frexl-cursor() = ["", 0, 0, 0];
    def frexl-cursor-buffer(c) = c[0];
    def frexl-cursor-bytes(c) = c[1];
    def frexl-cursor-overflow?(c) = c[2];
    def frexl-cursor-complete?(c) = c[3];
    def frexl-tail-is-close?(text) = {
        let n = str_len(text);
        let m = str_len(frex-close());
        n < m ? 0 : (String) substring(text, n - m, n) == frex-close() ? 1 : 0;
    };
    def frexl-cursor-feed(cursor, byte) = (Comparable) frexl-cursor-overflow?(cursor) == 1 ? cursor : frexl-cursor-bytes(cursor) >= frex-max-frame-bytes() ? [frexl-cursor-buffer(cursor), frexl-cursor-bytes(cursor), 1, 0] : {
        let next = str_concat(frexl-cursor-buffer(cursor), byte_to_str(byte));
        [next, frexl-cursor-bytes(cursor) + 1, 0, frexl-tail-is-close?(next)];
    };
    def frexl-stream-fold(surface, at, cursor) = at >= str_len(surface) ? cursor : frexl-stream-fold(surface, at + 1, frexl-cursor-feed(cursor, str_byte_at(surface, at)));
    // stream-result = (request cursor pretokenized)
    def frexl-stream-parse(surface) = {
        let cursor = frexl-stream-fold(surface, 0, frexl-cursor());
        let request = (Comparable) frexl-cursor-overflow?(cursor) == 1 ? frex-nothing-request("stream-frame-budget-exceeded") : (Comparable) frexl-cursor-complete?(cursor) == 0 ? frex-nothing-request("stream-incomplete") : frex-parse(frexl-cursor-buffer(cursor));
        [request, cursor, 0];
    };
    def frexl-stream-request(r) = r[0];
    def frexl-stream-cursor(r) = r[1];
    def frexl-stream-pretokenized?(r) = r[2];
    // ── direct recipe-to-MSL composition ────────────────────────────
    def frexl-code-category() = make_nodeid(31, 2, 0, 62);
    def frexl-execution-category() = make_nodeid(31, 2, 0, 63);
    def frexl-observation-category() = make_nodeid(31, 2, 0, 64);
    def frexl-kernel-name() = "form_recipe_exec_affine_i32";
    def frexl-recipe-mul(recipe) = node_value(node_children(recipe)[1]);
    def frexl-recipe-add(recipe) = node_value(node_children(recipe)[2]);
    def frexl-recipe-expected(recipe, input) = input * frexl-recipe-mul(recipe) + frexl-recipe-add(recipe);
    def frexl-msl(recipe) = str_concat("#include <metal_stdlib>\n", str_concat("using namespace metal;\n", str_concat("kernel void ", str_concat(frexl-kernel-name(), str_concat("(device int *a [[buffer(0)]], uint gid [[thread_position_in_grid]]) { if (gid == 0) a[0] = a[0] * ", str_concat(int_to_str(frexl-recipe-mul(recipe)), str_concat(" + ", str_concat(int_to_str(frexl-recipe-add(recipe)), "; }"))))))));
    def frexl-code-node(recipe) = intern_node(frexl-code-category(), [recipe, intern_trivial_string(frexl-kernel-name()), intern_trivial_string(frexl-msl(recipe)), intern_trivial_string("form-recipe-direct-msl-v1")]);
    def frexl-code-valid?(code, recipe) = nothing?(code) ? 0 : !node_eq(node_category(code), frexl-code-category()) ? 0 : !((Comparable) len(node_children(code)) == 4) ? 0 : node_eq(code, frexl-code-node(recipe)) ? 1 : 0;
    // signed i32 bytes over metal-door's exact little-endian u32 writer.
    def frexl-i32?(v) = v >= 0 - 2147483648 && v <= 2147483647 ? 1 : 0;
    def frexl-i32-word(v) = v < 0 ? 4294967296 + v : v;
    def frexl-i32-bytes(v) = md-le32(frexl-i32-word(v));
    def frexl-u32-at(s, at) = str_byte_at(s, at) + (str_byte_at(s, at + 1) * 256 + (str_byte_at(s, at + 2) * 65536 + str_byte_at(s, at + 3) * 16777216));
    def frexl-i32-at(s, at) = {
        let word = frexl-u32-at(s, at);
        word > 2147483647 ? word - 4294967296 : word;
    };
    // ── live content identities and typed result ────────────────────
    def frexl-execution-node(request, code, carrier, status, reason, value, present, stream-bytes, source-generated, native-generated, executed, pipeline-created, buffer-released, wrote, enqueued, synced, read-bytes) = intern_node(frexl-execution-category(), [frex-request-or-absent(request), nothing?(code) ? frex-absent-token() : code, intern_trivial_string(carrier), intern_trivial_string(status), intern_trivial_string(reason), intern_trivial_int(value), intern_trivial_int(present), intern_trivial_int(stream-bytes), intern_trivial_int(0), intern_trivial_int(source-generated), intern_trivial_int(native-generated), intern_trivial_int(executed), intern_trivial_int(0), intern_trivial_int(pipeline-created), intern_trivial_int(buffer-released), intern_trivial_int(wrote), intern_trivial_int(enqueued), intern_trivial_int(synced), intern_trivial_int(read-bytes)]);
    def frexl-observation-node(execution, pure-result) = intern_node(frexl-observation-category(), [execution, frex-result-observation(pure-result), intern_trivial_string(frex-result-status(pure-result)), intern_trivial_string(frex-result-reason(pure-result)), intern_trivial_int(frex-result-value(pure-result)), intern_trivial_int(frex-result-value-present?(pure-result))]);
    // live result fields:
    //  0 status             1 reason              2 pure result
    //  3 code node          4 execution node      5 observation node
    //  6 carrier            7 value               8 value-present
    //  9 stream bytes      10 pretokenized       11 source-generated
    // 12 native-generated  13 executed           14 model-executed
    // 15 pipeline-created  16 buffer-released    17 wrote bytes
    // 18 enqueued          19 synced              20 read bytes
    // 21 lifecycle
    def frexl-result-from-offer(request, offer, code, stream-bytes, source-generated, native-generated, executed, pipeline-created, buffer-released, wrote, enqueued, synced, read-bytes) = {
        let pure-result = frex-choice(request, [offer]);
        let status = frex-result-status(pure-result);
        let reason = frex-result-reason(pure-result);
        let value = frex-result-value(pure-result);
        let present = frex-result-value-present?(pure-result);
        let carrier = frex-offer-carrier(offer);
        let execution = frexl-execution-node(request, code, carrier, status, reason, value, present, stream-bytes, source-generated, native-generated, executed, pipeline-created, buffer-released, wrote, enqueued, synced, read-bytes);
        let observation = frexl-observation-node(execution, pure-result);
        [status, reason, pure-result, nothing?(code) ? frex-absent-token() : code, execution, observation, carrier, value, present, stream-bytes, 0, source-generated, native-generated, executed, 0, pipeline-created, buffer-released, wrote, enqueued, synced, read-bytes, frex-result-trace(pure-result)];
    };
    def frexl-result-status(r) = r[0];
    def frexl-result-reason(r) = r[1];
    def frexl-result-pure(r) = r[2];
    def frexl-result-code(r) = r[3];
    def frexl-result-execution(r) = r[4];
    def frexl-result-observation(r) = r[5];
    def frexl-result-carrier(r) = r[6];
    def frexl-result-value(r) = r[7];
    def frexl-result-value-present?(r) = r[8];
    def frexl-result-stream-bytes(r) = r[9];
    def frexl-result-pretokenized?(r) = r[10];
    def frexl-result-source-generated?(r) = r[11];
    def frexl-result-native-code-generated?(r) = r[12];
    def frexl-result-executed?(r) = r[13];
    def frexl-result-model-executed?(r) = r[14];
    def frexl-result-pipeline-created?(r) = r[15];
    def frexl-result-buffer-released?(r) = r[16];
    def frexl-result-wrote-bytes(r) = r[17];
    def frexl-result-enqueued(r) = r[18];
    def frexl-result-synced(r) = r[19];
    def frexl-result-read-bytes(r) = r[20];
    def frexl-result-lifecycle(r) = r[21];
    // The raw-byte cursor speaks the protocol's compact frex-result shape. This
    // projection keeps the physical carrier flags in that observation's content
    // identity; the pure protocol constructor remains the all-zero delegate.
    def frexl-result-as-frex(request, live-result) = {
        let pure = frexl-result-pure(live-result);
        frex-result-with-flags(frexl-result-status(live-result), frexl-result-reason(live-result), request, frexl-result-carrier(live-result), frexl-result-value(live-result), frexl-result-value-present?(live-result), frexl-result-lifecycle(live-result), frex-result-attempts(pure), frexl-result-executed?(live-result), frexl-result-model-executed?(live-result), frexl-result-native-code-generated?(live-result));
    };
    def frexl-status-timeout?(status) = str_find(status, "timeout", 0) >= 0 || str_find(status, "timed out", 0) >= 0 ? 1 : 0;
    def frexl-failure-offer(status, reason) = (Comparable) frexl-status-timeout?(status) == 1 ? frex-offer("metal", "timeout", 0, reason) : frex-offer("metal", "failure", 0, reason);
    def frexl-metal-requested?(request) = (String) frex-request-carrier(request) == "auto" || (String) frex-request-carrier(request) == "metal" ? 1 : 0;
    // A small constructor for non-effectful exits. `carrier` is kept admissible
    // to the pure request so nothing remains nothing rather than invalid-offer.
    def frexl-nothing(request, reason, stream-bytes) = {
        let carrier = (String) frex-request-carrier(request) == "auto" ? "metal" : frex-request-carrier(request);
        frexl-result-from-offer(request, frex-offer(carrier, "nothing", 0, reason), nothing(), stream-bytes, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    };
    // ── effectful Metal crossing ─────────────────────────────────────
    def frexl-execute-request(request, stream-bytes) = !((Comparable) frex-request-ready?(request) == 1) ? frexl-result-from-offer(request, frex-offer("metal", "nothing", 0, frex-request-reason(request)), nothing(), stream-bytes, 0, 0, 0, 0, 0, 0, 0, 0, 0) : !((Comparable) frexl-metal-requested?(request) == 1) ? frexl-nothing(request, "metal-not-requested", stream-bytes) : !((Comparable) frexl-i32?(frex-request-input(request)) == 1) ? frexl-nothing(request, "input-outside-i32", stream-bytes) : !md-door-live?() ? frexl-nothing(request, "metal-unavailable", stream-bytes) : {
        let recipe = frex-request-recipe(request);
        let source = frexl-msl(recipe);
        let code = frexl-code-node(recipe);
        let buffer = metal_buf_alloc(4);
        buffer <= 0 ? frexl-result-from-offer(request, frexl-failure-offer(metal_status(), "buffer-allocation-failure"), code, stream-bytes, 1, 0, 0, 0, 0, 0, 0, 0, 0) : {
            let wrote = metal_buf_write(buffer, 0, frexl-i32-bytes(frex-request-input(request)));
            !((Comparable) wrote == 4) ? {
                let released = metal_buf_free(buffer);
                frexl-result-from-offer(request, frexl-failure-offer(metal_status(), "buffer-write-failure"), code, stream-bytes, 1, 0, 0, 0, (Comparable) released == 1 ? 1 : 0, wrote, 0, 0, 0);
            } : {
                let pipeline = metal_pipeline(source, frexl-kernel-name());
                pipeline <= 0 ? {
                    let released = metal_buf_free(buffer);
                    frexl-result-from-offer(request, frexl-failure-offer(metal_status(), "compile-failure"), code, stream-bytes, 1, 0, 0, 0, (Comparable) released == 1 ? 1 : 0, wrote, 0, 0, 0);
                } : {
                    let enqueued = metal_enqueue(pipeline, md-bind([buffer], empty()), 1);
                    !((Comparable) enqueued == 1) ? {
                        let released = metal_buf_free(buffer);
                        frexl-result-from-offer(request, frexl-failure-offer(metal_status(), "enqueue-failure"), code, stream-bytes, 1, 1, 0, 1, (Comparable) released == 1 ? 1 : 0, wrote, enqueued, 0, 0);
                    } : {
                        let synced = metal_sync();
                        synced <= 0 ? {
                            let released = metal_buf_free(buffer);
                            frexl-result-from-offer(request, frexl-failure-offer(metal_status(), "sync-failure"), code, stream-bytes, 1, 1, 0, 1, (Comparable) released == 1 ? 1 : 0, wrote, enqueued, synced, 0);
                        } : {
                            let bytes = metal_buf_read(buffer, 0, 4);
                            let read-bytes = str_len(bytes);
                            !((Comparable) read-bytes == 4) ? {
                                let released = metal_buf_free(buffer);
                                frexl-result-from-offer(request, frexl-failure-offer(metal_status(), "read-failure"), code, stream-bytes, 1, 1, 1, 1, (Comparable) released == 1 ? 1 : 0, wrote, enqueued, synced, read-bytes);
                            } : {
                                let value = frexl-i32-at(bytes, 0);
                                let released = metal_buf_free(buffer);
                                !((Comparable) released == 1) ? frexl-result-from-offer(request, frex-offer("metal", "failure", 0, "buffer-release-failure"), code, stream-bytes, 1, 1, 1, 1, 0, wrote, enqueued, synced, read-bytes) : !((Comparable) value == frexl-recipe-expected(recipe, frex-request-input(request))) ? frexl-result-from-offer(request, frex-offer("metal", "failure", 0, "value-mismatch"), code, stream-bytes, 1, 1, 1, 1, 1, wrote, enqueued, synced, read-bytes) : frexl-result-from-offer(request, frex-offer("metal", "value", value, "metal-value"), code, stream-bytes, 1, 1, 1, 1, 1, wrote, enqueued, synced, read-bytes);
                            };
                        };
                    };
                };
            };
        };
    };
    def frexl-execute-stream(surface) = {
        let streamed = frexl-stream-parse(surface);
        frexl-execute-request(frexl-stream-request(streamed), frexl-cursor-bytes(frexl-stream-cursor(streamed)));
    };
    // Generic callback for form-cli-recipe-exec-cursor. The strict parser has
    // already recovered a canonical request, so the exact accepted-frame byte
    // count is reconstructed from that request rather than trusted from a caller.
    // The callback runs the carrier once and returns the compact, physically
    // flagged observation shape.
    def frexl-cursor-executor(ctx, request) = {
        let stream-bytes = str_len(frex-surface(frex-request-recipe(request), frex-request-input(request), frex-request-carrier(request)));
        let live = frexl-execute-request(request, stream-bytes);
        frexl-result-as-frex(request, live);
    };
    // ── bounded scalar/NodeID rendering ──────────────────────────────
    def frexl-live-open() = "<|form:recipe-live-observation|>";
    def frexl-live-close() = "<|/form:recipe-live-observation|>";
    def frexl-live-render(result) = {
        let value-text = (Comparable) frexl-result-value-present?(result) == 1 ? int_to_str(frexl-result-value(result)) : "absent";
        let rendered = frex-cat([frexl-live-open(), "\nstatus=", frexl-result-status(result), "\nreason=", frexl-result-reason(result), "\nrecipe-node=@", frex-node-key(frex-result-recipe(frexl-result-pure(result))), "\nrequest-node=@", frex-node-key(frex-result-request(frexl-result-pure(result))), "\ncode-node=@", frex-node-key(frexl-result-code(result)), "\nexecution-node=@", frex-node-key(frexl-result-execution(result)), "\nobservation-node=@", frex-node-key(frexl-result-observation(result)), "\ncarrier=", frexl-result-carrier(result), "\nvalue-present=", int_to_str(frexl-result-value-present?(result)), "\nvalue=", value-text, "\nstream-bytes=", int_to_str(frexl-result-stream-bytes(result)), "\npretokenized=", int_to_str(frexl-result-pretokenized?(result)), "\nsource-generated=", int_to_str(frexl-result-source-generated?(result)), "\nnative-code-generated=", int_to_str(frexl-result-native-code-generated?(result)), "\npipeline-created=", int_to_str(frexl-result-pipeline-created?(result)), "\nexecuted=", int_to_str(frexl-result-executed?(result)), "\nmodel-executed=", int_to_str(frexl-result-model-executed?(result)), "\nbuffer-released=", int_to_str(frexl-result-buffer-released?(result)), "\nwrote-bytes=", int_to_str(frexl-result-wrote-bytes(result)), "\nenqueued=", int_to_str(frexl-result-enqueued(result)), "\nsynced=", int_to_str(frexl-result-synced(result)), "\nread-bytes=", int_to_str(frexl-result-read-bytes(result)), "\nlifecycle=", frex-trace-actions(frexl-result-lifecycle(result)), "\n", frexl-live-close()]);
        str_len(rendered) <= frex-max-render-bytes() ? rendered : "";
    };
    0;
}
