//////////////////////////////////////////////////////////////////////
//
// form-cli-speaker-home.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-speaker-home.bml
//
// Local speaker: planner mill names the next move. Generate door
// carries Speaker: then Control:. Qwen now admits a local rank-one A/B route;
// native voice remains pending its trained artifact and held-out evaluation.
//
// Proven by: form-stdlib/tests/form-cli-speaker-home-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template SpeakerTurn<TMove> {
        member move: TMove;
        member act: int;
        member prompt: String;
    }

    class FormSpeakerHomeAuthority {
        field SpeakerAuthorityPath = "form/form-stdlib/bml/form-cli-speaker-home.bml";
        field SpeakerAuthorityKind = "high-bml-class-template-field";
    }

    class FormSpeakerHome<T> {
        field ObservedRemoteEvents = 95;
        field FqtLora = 0;
        field NativeVoice = 0;
        field AdapterPath = ".form-lora-adapter";
        field SpeakerTag = "Speaker: ";
        field ControlTag = "Control: ";

        ref fspk-authority = FormSpeakerHomeAuthority;
        thought fspk-pattern = list("next", "act", "prompt", "home");
        thought fspk-missing = list("native-nl-voice", "qwen-lora-training-and-heldout", "typed-move-to-addressed-recipe-execution", "graph-topology", "abstraction-class");

        def fspk-models() = fqt-fit(fpl-corpus(1, 1), fpl-skills());

        def fspk-next(s) = nth(fpl-skills(), fqt-predict-index(fspk-models(), s));

        def fspk-act(move) = if str_eq(move, "ground-first") then 0 else if str_eq(move, "walk-lane") then 1 else if str_eq(move, "one-turn") then 2 else if str_eq(move, "tool-pick") then 3 else if str_eq(move, "mill-observe") then 4 else if str_eq(move, "land") then 5 else if str_eq(move, "no-transcript") then 6 else 7;

        def fspk-prompt(s) = str_concat(fqt-overlay-prefix(), str_concat("\n", str_concat(SpeakerTag(), str_concat(fspk-next(s), str_concat("\n", str_concat(ControlTag(), str_concat(fqt-verdict-name(s), str_concat("\n", s))))))));

        def fcmg-teach(prompt) = fspk-prompt(prompt);

        def fspk-heldout() = fpl-heldout-correct(fpl-corpus(1, 1));

        def fspk-home() = if and(eq(fspk-heldout(), 72), eq(FqtLora(), 0)) then 1 else 0;

        def fspk-fuel() = fpl-situation("ground-first", "how", 0, SplitTrain());

        def fspk-bit(ok, bit) = if ok then bit else 0;

        def fspk-check() {
            let sit = fpl-situation("walk-lane", "how", 0, SplitHeldout());
            let p = fspk-prompt(sit);
            let c0 = fspk-bit(eq(fspk-heldout(), 72), 1);
            let c1 = fspk-bit(ge(str_find(p, SpeakerTag(), 0), 0), 2);
            let c2 = fspk-bit(ge(str_find(p, ControlTag(), 0), 0), 4);
            let c3 = fspk-bit(ge(str_find(p, "walk-lane", 0), 0), 8);
            let c4 = fspk-bit(eq(fspk-act("tool-pick"), 3), 16);
            let c5 = fspk-bit(eq(ObservedRemoteEvents(), 95), 32);
            let c6 = fspk-bit(and(eq(FqtLora(), 0), eq(fqt-lora?(), 0)), 64);
            let c7 = fspk-bit(and(eq(NativeVoice(), 0), eq(fspk-home(), 1)), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
