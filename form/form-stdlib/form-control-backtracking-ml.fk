// form-control-backtracking-ml.fk - Form-native ML control/backtracking floor.
//
// Form-ML-kernels/layers/models need full control-flow and backtracking as
// Form substrate tissue. This file names the Form-native primitive floor model
// research may depend on.
//
// preludes: form-stdlib/core.fk form-stdlib/engine.fk
//
section [form.bml] {
    def fcml-required-control-primitives() = list("if", "recursion", "fold", "any/all", "task-resolve", "task-reject", "cell-do", "cell-undo");
    def fcml-required-control-count() = len(fcml-required-control-primitives());
    def fcml-required-backtracking-primitives() = list("match", "fail", "fail-cut", "cut", "stop", "choice", "capture", "opt-rollback", "star-repeat");
    def fcml-required-backtracking-count() = len(fcml-required-backtracking-primitives());
    def fcml-ml-kernel-requirement() = "form-ML-kernels/layers/models require 100% Form-native control-flow and 100% Form-native backtracking coverage before native model research depends on the floor";
    0;
}
