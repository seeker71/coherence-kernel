; form-cli-jit-run.fk — one BML thought, four organs, no new C opcode.
;
; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk form-stdlib/metal-door.fk form-stdlib/form-cli-jit-xtal.fk

(do
    (defn fjit-bytes (xs)
        (if (eq (len xs) 0) ""
            (str_concat (byte_to_str (head xs)) (fjit-bytes (tail xs)))))
    (defn fjit-ssa ()
        (list (list 1 (Add)) (list 2) (list 1 (Mul)) (list 5 1 2) (list 3 3 0)))
    (defn fjit-cpu-image ()
        (fa-image (list
            (fa-ldr 3 0 0)
            (fa-ldr-w 5 3 0)
            (fa-movz 4 (Mul))
            (fa-mul 5 5 4)
            (fa-add 5 5 (Add))
            (fa-str-w 5 3 0)
            (fa-ret))))

    (print "form-cli executed jit-organ\n")
    (print "form-cli thought=n*")
    (print (int_to_str (Mul)))
    (print "+")
    (print (int_to_str (Add)))
    (print " sample=")
    (print (int_to_str (Sample)))
    (print " expect=")
    (print (int_to_str (Expect)))
    (print "\nform-cli mlx-prog=")
    (print (fjit-mlx (Sample)))
    (print " mlx=")
    (print (int_to_str (mlx_run (fjit-mlx (Sample)))))
    (print "\n")

    (let img (lo-compile-fn (fjit-ssa) 4))
    (print "form-cli form-lower-bytes=")
    (print (int_to_str (len img)))
    (print " jit_leaf_inram=")
    (print (int_to_str (jit_leaf_inram img (Sample))))
    (print "\n")

    (let gbuf (metal_buf_alloc 4))
    (metal_buf_write gbuf 0 (md-le32 (Sample)))
    (let gpipe (metal_pipeline (fjit-msl) "form_jit_f"))
    (metal_enqueue gpipe (md-bind (list gbuf) (empty)) 1)
    (metal_sync)
    (let gres (metal_buf_read gbuf 0 4))
    (print "form-cli metal-msl-byte0=")
    (print (int_to_str (str_byte_at gres 0)))
    (print "\n")
    (metal_buf_free gbuf)

    (let cbuf (metal_buf_alloc 4))
    (metal_buf_write cbuf 0 (md-le32 (Sample)))
    (let cpipe (metal_pipeline (fjit-bytes (fjit-cpu-image)) "form_cpu_jit"))
    (metal_enqueue cpipe (md-bind (list cbuf) (empty)) 1)
    (let cres (metal_buf_read cbuf 0 4))
    (print "form-cli form_cpu_jit-byte0=")
    (print (int_to_str (str_byte_at cres 0)))
    (print "\nform-cli metal=\n")
    (print (metal_status))
    (print "\nform-cli mlx=\n")
    (print (mlx_status))
    (print "\n")
    (metal_buf_free cbuf)
    0)
