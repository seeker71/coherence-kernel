; form-cli-jit-run.fk — one Apply, three backends, no extra CPU-via-Metal leaf.
;
; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk form-stdlib/jit-self-crystallization.fk form-stdlib/jit-once-born.fk form-stdlib/jit-decision.fk form-stdlib/jit-heat-gate.fk form-stdlib/metal-door.fk form-stdlib/language-model.fk form-stdlib/form-cli-jit.bml

(do
    (print "form-cli thought=n*")
    (print (int_to_str (Mul)))
    (print "+")
    (print (int_to_str (Add)))
    (print " sample=")
    (print (int_to_str (Sample)))
    (print "\nform-cli apply mlx=")
    (print (int_to_str (fjit-apply (Mlx) (Sample))))
    (print "\nform-cli apply cpu=")
    (print (int_to_str (fjit-apply (Cpu) (Sample))))
    (let belowThreshold (fjit-heat-run (fjit-gate 20260827) (Sample) 4))
    (let thresholdCrossing (fjit-request-cpu (nth belowThreshold 2) (Sample)))
    (let resident (fjit-request-cpu (nth thresholdCrossing 2) (Sample)))
    (let demandRequest (fjit-demand-request
        (fjit-demand-owner 20260903) (Sample)))
    (let demandProgress (fjit-demand-progress
        (bdjo-request-owner demandRequest)))
    (print "\nform-cli cpu heat routes=")
    (print (nth belowThreshold 1))
    (print "->")
    (print (nth thresholdCrossing 1))
    (print "->")
    (print (nth resident 1))
    (print " born=")
    (print (int_to_str (nth thresholdCrossing 3)))
    (print "/")
    (print (int_to_str (nth resident 3)))
    (print "\nform-cli cpu demand answer=")
    (print (int_to_str (bdj-receipt-value
        (bdjo-request-first demandRequest))))
    (print " progress=")
    (print (bdjo-progress-status demandProgress))
    (print "\nform-cli apply metal=")
    (print (int_to_str (fjit-apply (Metal) (Sample))))
    (print "\n")
    0)
