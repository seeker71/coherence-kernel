; form-cli-jit-run.fk — one Apply, three backends, no extra CPU-via-Metal leaf.
;
; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk form-stdlib/metal-door.fk form-stdlib/language-model.fk form-stdlib/form-cli-jit-xtal.fk

(do
    (print "form-cli thought=n*")
    (print (int_to_str (Mul)))
    (print "+")
    (print (int_to_str (Add)))
    (print " sample=")
    (print (int_to_str (Sample)))
    (print "\nform-cli apply mlx=")
    (print (int_to_str (fjit-apply (Mlx) (Sample))))
    (print "\nform-cli apply cpu=")
    (print (int_to_str (fjit-apply (Cpu) (Sample))))
    (print "\nform-cli apply metal=")
    (print (int_to_str (fjit-apply (Metal) (Sample))))
    (print "\n")
    0)
