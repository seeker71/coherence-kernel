; living-world-hypothesis-enquiry.fk -- plural Recipes ask what separates them.
;
; A recurrently offered space contains only possible binding cells, never a
; fixed domain, task, answer, score, or preferred ordering.  Every current
; Recipe in an integrated hypothesis carrier -- either the initial hypothesis
; field or a learned successor tissue -- is executed on every offered binding.
; Bindings yielding more than one distinct output remain as a plural separating
; field; bindings yielding one output remain visible as aligned.  No maximizer
; or list order appoints a question.  A tissue enquiry lowers through its exact
; underlying field, so an answered probe can grow the tissue again rather than
; forming a parallel authority path.
;
; A request carries the whole enquiry, one optional four-arm choice, an
; optional sender timeout, evidence, and an optional lens.  NOTHING leaves the
; question open, ZERO declines it, ONE may select only an exact separating
; trial, and NODE preserves an alternative.  A selected trial can be lowered
; into the existing held-out probe, but it gains no currentness or authority
; until that exact probe is independently offered into the world.
;
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk

(let LWHE-SPACE       (bp "LWHE-SPACE"))
(let LWHE-TRIAL       (bp "LWHE-TRIAL"))
(let LWHE-ENQUIRY     (bp "LWHE-ENQUIRY"))
(let LWHE-REQUEST     (bp "LWHE-REQUEST"))
(let LWHE-SEPARATING  (bp "LWHE-SEPARATING"))
(let LWHE-ALIGNED     (bp "LWHE-ALIGNED"))

(defn lwhe-state (kind) (intern_node kind (empty)))
(defn lwhe-separating () (lwhe-state LWHE-SEPARATING))
(defn lwhe-aligned () (lwhe-state LWHE-ALIGNED))
(defn lwhe-separating? (state)
    (if (node_eq state (lwhe-separating)) 1 0))
(defn lwhe-aligned? (state)
    (if (node_eq state (lwhe-aligned)) 1 0))

; children: integrated candidate, offered bindings field, alternatives,
; optional unknown, optional lens, evidence, local path.
(defn lwhe-space (candidate bindings alternatives unknown lens evidence)
    (intern_node LWHE-SPACE
        (list candidate bindings alternatives unknown lens evidence
              (lwo-local-path))))
(defn lwhe-space? (cell) (lwo-category? cell LWHE-SPACE))
(defn lwhe-space-candidate (space) (nth (node_children space) 0))
(defn lwhe-space-bindings (space) (nth (node_children space) 1))
(defn lwhe-space-alternatives (space) (nth (node_children space) 2))
(defn lwhe-space-unknown (space) (nth (node_children space) 3))
(defn lwhe-space-lens (space) (nth (node_children space) 4))
(defn lwhe-space-evidence (space) (nth (node_children space) 5))
(defn lwhe-space-path (space) (nth (node_children space) 6))

; The enquiry owns no preferred carrier kind.  Both current carrier shapes
; expose an exact hypothesis field; tissue probes still address the original
; field candidate so their evidence can participate in the next tissue.
(defn lwhe-candidate? (candidate)
    (if (eq (lwph-candidate? candidate) 1) 1
        (lwht-candidate? candidate)))
(defn lwhe-candidate-field (candidate)
    (if (eq (lwph-candidate? candidate) 1) candidate
        (if (eq (lwht-candidate? candidate) 1)
            (lwht-tissue-field (lwo-emergent-shape candidate))
            (lwo-none))))
(defn lwhe-candidate-hypotheses (candidate)
    (if (eq (lwph-candidate? candidate) 1)
        (lwph-field-consistent (lwo-emergent-shape candidate))
        (if (eq (lwht-candidate? candidate) 1)
            (lwht-tissue-hypotheses (lwo-emergent-shape candidate))
            (lwo-empty-field))))
(defn lwhe-candidate-current? (world candidate)
    (if (eq (lwph-candidate? candidate) 1)
        (lwph-integrated-current? world candidate)
        (if (eq (lwht-candidate? candidate) 1)
            (lwht-integrated-current? world candidate) 0)))

(defn lwhe-optional-lens-valid? (lens)
    (if (node_eq lens (lwo-none)) 1 (lwlc-lens? lens)))
(defn lwhe-bindings-items-valid? (items)
    (if (eq (len items) 0) 1
        (if (eq (lwre-bindings-valid? (head items)) 0) 0
            (lwhe-bindings-items-valid? (tail items)))))
(defn lwhe-space-valid? (space)
    (if (and (eq (lwhe-space? space) 1)
             (and (eq (lwhe-candidate?
                        (lwhe-space-candidate space)) 1)
                  (and (eq (lwo-category?
                            (lwhe-space-bindings space) LWO-FIELD) 1)
                       (and (gt (lwo-field-size
                                  (lwhe-space-bindings space)) 0)
                            (and (eq (lwhe-bindings-items-valid?
                                      (lwo-field-items
                                        (lwhe-space-bindings space))) 1)
                                 (and (eq (lwo-category?
                                           (lwhe-space-alternatives space)
                                           LWO-FIELD) 1)
                                      (and (eq (lwph-optional-unknown-valid?
                                                (lwhe-space-unknown space)) 1)
                                           (eq (lwhe-optional-lens-valid?
                                                (lwhe-space-lens space)) 1)))))))) 1 0))

(defn lwhe-bindings-items-current? (world items)
    (if (eq (len items) 0) 1
        (if (eq (lwre-bindings-current? world (head items)) 0) 0
            (lwhe-bindings-items-current? world (tail items)))))
(defn lwhe-space-current? (world space threshold)
    (if (and (gt threshold 0)
             (and (eq (lwhe-space-valid? space) 1)
                  (and (eq (lwhe-candidate-current? world
                              (lwhe-space-candidate space)) 1)
                       (and (eq (lwo-active? world space) 1)
                            (and (ge (lwph-active-source-count world space)
                                     threshold)
                                 (eq (lwhe-bindings-items-current? world
                                      (lwo-field-items
                                        (lwhe-space-bindings space))) 1)))))) 1 0))

; children: exact space, bindings, unobserved probe, all evaluations, distinct
; outputs, separation state, alternatives, unknowns, local path.
(defn lwhe-trial
    (space bindings probe evaluations outputs state alternatives unknowns)
    (intern_node LWHE-TRIAL
        (list space bindings probe evaluations outputs state alternatives
              unknowns (lwo-local-path))))
(defn lwhe-trial? (cell) (lwo-category? cell LWHE-TRIAL))
(defn lwhe-trial-space (trial) (nth (node_children trial) 0))
(defn lwhe-trial-bindings (trial) (nth (node_children trial) 1))
(defn lwhe-trial-probe (trial) (nth (node_children trial) 2))
(defn lwhe-trial-evaluations (trial) (nth (node_children trial) 3))
(defn lwhe-trial-outputs (trial) (nth (node_children trial) 4))
(defn lwhe-trial-state (trial) (nth (node_children trial) 5))
(defn lwhe-trial-alternatives (trial) (nth (node_children trial) 6))
(defn lwhe-trial-unknowns (trial) (nth (node_children trial) 7))
(defn lwhe-trial-path (trial) (nth (node_children trial) 8))

(defn lwhe-trial-for (space bindings)
    (do
        (let candidate (lwhe-space-candidate space))
        (let probe
            (lwph-probe (lwhe-candidate-field candidate)
                bindings (lwo-none) (oac-nothing)
                (lwhe-space-alternatives space)
                (lwhe-space-unknown space) (lwhe-space-evidence space)))
        (let hypotheses
            (lwhe-candidate-hypotheses candidate))
        (let evaluations
            (lwph-evaluate-probe-items (lwo-field-items hypotheses)
                probe (lwo-empty-field)))
        (let outputs
            (lwph-probe-outputs-items (lwo-field-items evaluations)
                (lwo-empty-field)))
        (let state
            (if (gt (lwo-field-size outputs) 1)
                (lwhe-separating) (lwhe-aligned)))
        (let alternatives
            (lwph-field-union-items (lwo-field-items outputs)
                (lwph-field-union-items (lwo-field-items evaluations)
                    (lwhe-space-alternatives space))))
        (let unknowns
            (do
                (let base
                    (if (node_eq (lwhe-space-unknown space) (lwo-none))
                        (lwo-empty-field)
                        (lwo-field-add (lwo-empty-field)
                            (lwhe-space-unknown space))))
                (if (eq (lwhe-separating? state) 1)
                    (lwo-field-add base (lwlc-unknown evaluations)) base)))
        (lwhe-trial space bindings probe evaluations outputs state
            alternatives unknowns)))

(defn lwhe-trials-for-items (items space field)
    (if (eq (len items) 0) field
        (lwhe-trials-for-items (tail items) space
            (lwo-field-add field (lwhe-trial-for space (head items))))))
(defn lwhe-filter-trials (items wanted field)
    (if (eq (len items) 0) field
        (lwhe-filter-trials (tail items) wanted
            (if (node_eq (lwhe-trial-state (head items)) wanted)
                (lwo-field-add field (head items)) field))))

(defn lwhe-binding-witnesses-items (world items field)
    (if (eq (len items) 0) field
        (lwhe-binding-witnesses-items world (tail items)
            (lwph-field-union-items
                (lwo-field-items
                    (lwre-binding-witnesses world (head items))) field))))
(defn lwhe-enquiry-witnesses (world space)
    (do
        (let candidate (lwhe-space-candidate space))
        (let with-candidate
            (lwph-field-union-items
                (lwo-field-items (lwo-emergent-witnesses candidate))
                (lwo-active-attributions-for world candidate)))
        (let with-space
            (lwph-field-union-items
                (lwo-field-items (lwo-active-attributions-for world space))
                with-candidate))
        (lwhe-binding-witnesses-items world
            (lwo-field-items (lwhe-space-bindings space)) with-space)))

; children: exact space, every trial, separating/aligned subsets,
; alternatives, unknowns, witnesses, threshold, local path.
(defn lwhe-enquiry
    (space trials separating aligned alternatives unknowns witnesses threshold)
    (intern_node LWHE-ENQUIRY
        (list space trials separating aligned alternatives unknowns witnesses
              (intern_trivial_int threshold) (lwo-local-path))))
(defn lwhe-enquiry? (cell) (lwo-category? cell LWHE-ENQUIRY))
(defn lwhe-enquiry-space (enquiry) (nth (node_children enquiry) 0))
(defn lwhe-enquiry-trials (enquiry) (nth (node_children enquiry) 1))
(defn lwhe-enquiry-separating (enquiry) (nth (node_children enquiry) 2))
(defn lwhe-enquiry-aligned (enquiry) (nth (node_children enquiry) 3))
(defn lwhe-enquiry-alternatives (enquiry) (nth (node_children enquiry) 4))
(defn lwhe-enquiry-unknowns (enquiry) (nth (node_children enquiry) 5))
(defn lwhe-enquiry-witness-field (enquiry) (nth (node_children enquiry) 6))
(defn lwhe-enquiry-threshold (enquiry)
    (node_value (nth (node_children enquiry) 7)))
(defn lwhe-enquiry-path (enquiry) (nth (node_children enquiry) 8))

(defn lwhe-trial-alternatives-items (items field)
    (if (eq (len items) 0) field
        (lwhe-trial-alternatives-items (tail items)
            (lwph-field-union-items
                (lwo-field-items (lwhe-trial-alternatives (head items)))
                field))))
(defn lwhe-trial-unknowns-items (items field)
    (if (eq (len items) 0) field
        (lwhe-trial-unknowns-items (tail items)
            (lwph-field-union-items
                (lwo-field-items (lwhe-trial-unknowns (head items))) field))))

(defn lwhe-enquiry-for (world space threshold)
    (if (eq (lwhe-space-current? world space threshold) 0) (lwo-none)
        (do
            (let trials
                (lwhe-trials-for-items
                    (lwo-field-items (lwhe-space-bindings space)) space
                    (lwo-empty-field)))
            (let separating
                (lwhe-filter-trials (lwo-field-items trials)
                    (lwhe-separating) (lwo-empty-field)))
            (let aligned
                (lwhe-filter-trials (lwo-field-items trials)
                    (lwhe-aligned) (lwo-empty-field)))
            (let alternatives
                (lwph-field-union-items (lwo-field-items separating)
                    (lwhe-trial-alternatives-items
                        (lwo-field-items trials)
                        (lwhe-space-alternatives space))))
            (let unknowns
                (do
                    (let base
                        (lwhe-trial-unknowns-items
                            (lwo-field-items trials) (lwo-empty-field)))
                    (if (eq (lwo-field-size separating) 0)
                        (lwo-field-add base (lwlc-unknown trials)) base)))
            (lwhe-enquiry space trials separating aligned alternatives unknowns
                (lwhe-enquiry-witnesses world space) threshold))))

(defn lwhe-enquiry-current? (world enquiry)
    (if (eq (lwhe-enquiry? enquiry) 0) 0
        (node_eq enquiry
            (lwhe-enquiry-for world (lwhe-enquiry-space enquiry)
                (lwhe-enquiry-threshold enquiry)))))

; children: enquiry, optional four-arm choice, optional timeout, evidence,
; optional lens, local path.
(defn lwhe-request (enquiry choice timeout evidence lens)
    (intern_node LWHE-REQUEST
        (list enquiry choice timeout evidence lens (lwo-local-path))))
(defn lwhe-request? (cell) (lwo-category? cell LWHE-REQUEST))
(defn lwhe-request-enquiry (request) (nth (node_children request) 0))
(defn lwhe-request-choice (request) (nth (node_children request) 1))
(defn lwhe-request-timeout (request) (nth (node_children request) 2))
(defn lwhe-request-evidence (request) (nth (node_children request) 3))
(defn lwhe-request-lens (request) (nth (node_children request) 4))
(defn lwhe-request-path (request) (nth (node_children request) 5))

(defn lwhe-optional-timeout-valid? (timeout)
    (if (node_eq timeout (lwo-none)) 1 (oac-timeout-valid? timeout)))
(defn lwhe-choice-valid? (enquiry choice)
    (if (eq (oac-one? choice) 1)
        (lwo-field-has? (lwhe-enquiry-separating enquiry)
            (oac-payload choice))
        (oac-valid-ack? choice)))
(defn lwhe-request-valid? (request)
    (if (and (eq (lwhe-request? request) 1)
             (and (eq (lwhe-enquiry?
                        (lwhe-request-enquiry request)) 1)
                  (and (eq (lwhe-choice-valid?
                              (lwhe-request-enquiry request)
                              (lwhe-request-choice request)) 1)
                       (and (eq (lwhe-optional-timeout-valid?
                                  (lwhe-request-timeout request)) 1)
                            (eq (lwhe-optional-lens-valid?
                                  (lwhe-request-lens request)) 1))))) 1 0))
(defn lwhe-request-selected-trial (request)
    (if (and (eq (lwhe-request-valid? request) 1)
             (eq (oac-one? (lwhe-request-choice request)) 1))
        (oac-payload (lwhe-request-choice request)) (lwo-none)))

; Lower an acknowledged separating choice into the existing probe shape.  The
; caller still has to offer that exact probe into the world; construction alone
; confers neither currentness nor recurrence.
(defn lwhe-probe-from-request
    (request observed ack alternatives unknown evidence)
    (do
        (let trial (lwhe-request-selected-trial request))
        (if (node_eq trial (lwo-none)) (lwo-none)
            (lwph-probe
                (lwhe-candidate-field
                    (lwhe-space-candidate
                    (lwhe-enquiry-space
                        (lwhe-request-enquiry request))))
                (lwhe-trial-bindings trial) observed ack alternatives unknown
                evidence))))

; witnessed: 2026-08-09 -> 4194303 field + 33554431 recursive tissue on fkwu
