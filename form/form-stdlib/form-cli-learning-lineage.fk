; form-cli-learning-lineage.fk — keep teacher, carrier, embodiment, share
; movement, and causal strength separate across learning rounds.
;
; preludes: form-stdlib/core.fk
;
; An operational turn share is context, not a training curve. Only the same
; sealed workload is comparable across rounds. A remote channel may carry a
; user's teaching; that does not make the remote model its author.
; witnessed: 2026-08-17 -> actual home 51 to 52 remains contextual; sealed
; fixture promotion requires held-out transfer and a native band

(defn fcll-counts (native local remote) (list native local remote))
(defn fcll-native (v) (nth v 0))
(defn fcll-local (v) (nth v 1))
(defn fcll-remote (v) (nth v 2))
(defn fcll-total (v) (add (fcll-native v) (add (fcll-local v) (fcll-remote v))))

(defn fcll-share-base (part total) (div (mul part 100) total))
(defn fcll-share-rem (part total) (mod (mul part 100) total))
(defn fcll-first-winner (rn rl rr)
    (if (and (ge rn rl) (ge rn rr)) 0 (if (ge rl rr) 1 2)))
(defn fcll-second-winner (first rn rl rr)
    (if (eq first 0) (if (ge rl rr) 1 2)
        (if (eq first 1) (if (ge rn rr) 0 2)
            (if (ge rn rl) 0 1))))

(defn fcll-share (counts)
    (do
        (let total (fcll-total counts))
        (if (eq total 0) (list 0 0 0)
            (do
                (let bn (fcll-share-base (fcll-native counts) total))
                (let bl (fcll-share-base (fcll-local counts) total))
                (let br (fcll-share-base (fcll-remote counts) total))
                (let left (sub 100 (add bn (add bl br))))
                (let rn (fcll-share-rem (fcll-native counts) total))
                (let rl (fcll-share-rem (fcll-local counts) total))
                (let rr (fcll-share-rem (fcll-remote counts) total))
                (let first (fcll-first-winner rn rl rr))
                (let second (fcll-second-winner first rn rl rr))
                (list
                    (add bn (add (if (and (ge left 1) (eq first 0)) 1 0)
                                 (if (and (eq left 2) (eq second 0)) 1 0)))
                    (add bl (add (if (and (ge left 1) (eq first 1)) 1 0)
                                 (if (and (eq left 2) (eq second 1)) 1 0)))
                    (add br (add (if (and (ge left 1) (eq first 2)) 1 0)
                                 (if (and (eq left 2) (eq second 2)) 1 0))))))))

; observation = kind, workload-id, turn-id, boundary counts, evidence
(defn fcll-observation (kind workload turn-id counts evidence)
    (list kind workload turn-id counts evidence))
(defn fcll-o-kind (o) (nth o 0))
(defn fcll-o-workload (o) (nth o 1))
(defn fcll-o-turn (o) (nth o 2))
(defn fcll-o-counts (o) (nth o 3))
(defn fcll-o-evidence (o) (nth o 4))
(defn fcll-o-share (o) (fcll-share (fcll-o-counts o)))

; round = id, teacher, carrier, lesson, before, after, fine-tune status,
; native/design/logic/flow change bits, held-out bit, native-band bit,
; evidence path, controlled-fixture bit.
(defn fcll-round (id teacher carrier lesson before after fine-tune native-change
    design-change logic-change flow-change heldout native-band evidence controlled)
    (list id teacher carrier lesson before after fine-tune native-change
        design-change logic-change flow-change heldout native-band evidence controlled))
(defn fcll-id (r) (nth r 0))
(defn fcll-teacher (r) (nth r 1))
(defn fcll-carrier (r) (nth r 2))
(defn fcll-lesson (r) (nth r 3))
(defn fcll-before (r) (nth r 4))
(defn fcll-after (r) (nth r 5))
(defn fcll-fine-tune (r) (nth r 6))
(defn fcll-native-change (r) (nth r 7))
(defn fcll-design-change (r) (nth r 8))
(defn fcll-logic-change (r) (nth r 9))
(defn fcll-flow-change (r) (nth r 10))
(defn fcll-heldout (r) (nth r 11))
(defn fcll-native-band (r) (nth r 12))
(defn fcll-evidence (r) (nth r 13))
(defn fcll-controlled (r) (nth r 14))

(defn fcll-remote-carried? (r)
    (if (str_eq (fcll-carrier r) "remote-channel") 1 0))
(defn fcll-remote-model-teacher? (r)
    (if (str_eq (fcll-teacher r) "remote-model") 1 0))
(defn fcll-same-workload? (r)
    (if (str_eq (fcll-o-workload (fcll-before r))
                (fcll-o-workload (fcll-after r))) 1 0))
(defn fcll-operational-comparable? (r)
    (if (and (str_eq (fcll-o-kind (fcll-before r)) "observed")
        (and (str_eq (fcll-o-kind (fcll-after r)) "observed")
             (eq (fcll-same-workload? r) 1))) 1 0))

(defn fcll-share-delta (r)
    (do
        (let before (fcll-o-share (fcll-before r)))
        (let after (fcll-o-share (fcll-after r)))
        (list (sub (nth after 0) (nth before 0))
              (sub (nth after 1) (nth before 1))
              (sub (nth after 2) (nth before 2)))))
(defn fcll-home (share) (add (nth share 0) (nth share 1)))
(defn fcll-home-delta (r)
    (sub (fcll-home (fcll-o-share (fcll-after r)))
         (fcll-home (fcll-o-share (fcll-before r)))))
(defn fcll-homeward? (r)
    (do
        (let before (fcll-o-share (fcll-before r)))
        (let after (fcll-o-share (fcll-after r)))
        (if (and (ge (fcll-home after) (fcll-home before))
            (and (le (nth after 2) (nth before 2))
                 (or (gt (fcll-home after) (fcll-home before))
                     (lt (nth after 2) (nth before 2))))) 1 0)))
(defn fcll-native-gain? (r)
    (if (gt (nth (fcll-o-share (fcll-after r)) 0)
            (nth (fcll-o-share (fcll-before r)) 0)) 1 0))
(defn fcll-local-gain? (r)
    (if (gt (nth (fcll-o-share (fcll-after r)) 1)
            (nth (fcll-o-share (fcll-before r)) 1)) 1 0))
(defn fcll-both-rise? (r)
    (if (and (eq (fcll-native-gain? r) 1) (eq (fcll-local-gain? r) 1)) 1 0))

(defn fcll-finetune-promoted? (r)
    (if (and (str_eq (fcll-fine-tune r) "heldout-promoted")
             (eq (fcll-heldout r) 1)) 1 0))
(defn fcll-native-promoted? (r)
    (if (and (eq (fcll-native-change r) 1) (eq (fcll-native-band r) 1)) 1 0))
(defn fcll-changes-grounded? (r)
    (if (and (gt (str_len (fcll-evidence r)) 0)
        (and (if (str_eq (fcll-fine-tune r) "heldout-promoted")
                 (fcll-heldout r) 1)
             (if (eq (fcll-native-change r) 1) (fcll-native-band r) 1))) 1 0))

; The fixed-suite contract admits a local rise only after held-out promotion,
; and a native rise only after a native band. It never requires local to rise
; while local capability is being crystallized inward into native recipes.
(defn fcll-controlled-round-valid? (r)
    (if (and (eq (fcll-controlled r) 1)
        (and (eq (fcll-same-workload? r) 1)
        (and (eq (fcll-homeward? r) 1)
        (and (if (eq (fcll-local-gain? r) 1) (fcll-finetune-promoted? r) 1)
             (if (eq (fcll-native-gain? r) 1) (fcll-native-promoted? r) 1))))) 1 0))
(defn fcll-chain-valid? (rounds)
    (if (eq (len rounds) 0) 1
        (if (eq (fcll-controlled-round-valid? (head rounds)) 1)
            (fcll-chain-valid? (tail rounds)) 0)))

(defn fcll-actual-round ()
    (fcll-round
        "measurement-healing-1" "user" "remote-channel"
        "declared-share-is-not-measurement"
        (fcll-observation "observed" "turn-01a00e3e"
            "01a00e3e-1c57-76e0-a310-1b9574f91f7a"
            (fcll-counts 106 233 320)
            "receipts/2026-08-17-declared-share-becomes-measured-boundary.md")
        (fcll-observation "observed" "turn-01a00e75"
            "01a00e75-e4b5-75e1-9b12-ee596cd56e0e"
            (fcll-counts 36 124 150)
            "form-cli-turn-evidence-row")
        "none" 1 1 1 1 0 1
        "receipts/2026-08-17-declared-share-becomes-measured-boundary.md" 0))

(defn fcll-fixture-local-round ()
    (fcll-round "sealed-local-transfer" "remote-model-fixture" "remote-channel"
        "selected-teacher-labels"
        (fcll-observation "controlled-fixture" "sealed-route-suite-v1" "fixture-0"
            (fcll-counts 0 0 8) "fixture")
        (fcll-observation "controlled-fixture" "sealed-route-suite-v1" "fixture-1"
            (fcll-counts 0 5 3) "fixture")
        "heldout-promoted" 0 1 1 1 1 0 "fixture-contract" 1))

(defn fcll-fixture-native-round ()
    (fcll-round "sealed-native-transfer" "local-finetuned" "local-channel"
        "heldout-local-capability-crystallized"
        (fcll-observation "controlled-fixture" "sealed-route-suite-v1" "fixture-1"
            (fcll-counts 0 5 3) "fixture")
        (fcll-observation "controlled-fixture" "sealed-route-suite-v1" "fixture-2"
            (fcll-counts 5 3 0) "fixture")
        "none" 1 1 1 1 1 1 "fixture-contract" 1))
