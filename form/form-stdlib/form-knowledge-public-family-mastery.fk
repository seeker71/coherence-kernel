; form-knowledge-public-family-mastery.fk -- public evidence convergence.
;
; Source addressability and model mastery are different observations.  The
; public source/concept/route organs answer whether current Form knowledge can
; be addressed.  This cell answers a narrower question: for how many canonical
; knowledge families does public local-model evidence show all three of:
;
;   * independently held-out reasoning at >=95%,
;   * generated BML + scannerless BMF + Form micro-thought execution, and
;   * a model-requested native recipe result with a present value.
;
; The denominator is the 15-family census, not source files, route references,
; prompts, or repeated observations.  At that denominator, >=95% means 15/15;
; 14/15 is only 93%.  A family contributes at most one mastered unit no matter
; how many evidence rows it has.
;
; Evidence rows contain executable/typed observations and a structured receipt
; whose hashes are recomputed from the raw model bytes and canonical artifact
; bytes.  A prose claim, scalar self-score, bare hash, pure verifier verdict,
; stale family/source binding, remote call, or unreleased run is admitted as
; `nothing`, never as 0 or 1.  Successful native values 0 and 1 are both kept:
; value-present is the independent bit.
;
; Publicness has an honest boundary.  This cell proves that a receipt's content,
; raw bytes, artifact bytes, family, model/run identity, local/remote flags and
; release state agree.  It does not read git history, so it cannot prove that
; the recomputed receipt SHA was committed.  A caller must persist the exact
; admitted receipt beside the public observation.  Synthetic band rows prove
; this contract; they are not public model observations.
;
; Source-route coverage has no mastery input and contributes zero credit.  Its
; explicit report field stays literal 0; the 100% route observation remains
; valuable and orthogonal.
;
; preludes: form-stdlib/form-knowledge-integration-census.fk
; preludes: form-stdlib/form-knowledge-qwen-heldout-eval.fk
; preludes: form-stdlib/generative-form-skill-gate.fk
; Proven by: form-stdlib/tests/form-knowledge-public-family-mastery-band.fk

(do
    (defn fkpfm-threshold-percent () 95)
    (defn fkpfm-public-scope () "public-live-local-observation-v1")
    (defn fkpfm-basis ()
        "canonical-family+receipt-bound-heldout+family-executed-generative+family-native-recipe-v2")

    ; fkwu intentionally has no value_kind primitive.  These guards stay on
    ; its native waist: strings are recognized by their own operations and an
    ; integer by an exact decimal round trip.  What remains is list-shaped for
    ; this schema; every admitted list still has an exact length and tag.
    (defn fkpfm-string? (x)
        (if (or (gt (str_len x) 0) (str_eq x "")) 1 0))
    (defn fkpfm-int? (x)
        (do
            (let rendered (int_to_str x))
            (if (eq (str_len rendered) 0) 0
                (if (eq (str_to_int rendered) x) 1 0))))
    (defn fkpfm-list? (x)
        (if (or (nothing? x)
                (or (eq (fkpfm-string? x) 1)
                    (eq (fkpfm-int? x) 1))) 0 1))
    (defn fkpfm-all? (values)
        (if (eq (len values) 0) 1
            (if (head values) (fkpfm-all? (tail values)) 0)))

    (defn fkpfm-equal-list? (a b)
        (if (not (eq (len a) (len b))) 0
            (if (eq (len a) 0) 1
                (if (eq (fkpfm-equal? (head a) (head b)) 1)
                    (fkpfm-equal-list? (tail a) (tail b)) 0))))
    (defn fkpfm-equal? (a b)
        (if (not (eq (fkpfm-list? a) (fkpfm-list? b))) 0
            (if (not (eq (fkpfm-string? a) (fkpfm-string? b))) 0
            (if (not (eq (fkpfm-int? a) (fkpfm-int? b))) 0
                (if (eq (fkpfm-list? a) 1) (fkpfm-equal-list? a b)
                    (if (eq (fkpfm-string? a) 1) (if (str_eq a b) 1 0)
                        (if (eq (fkpfm-int? a) 1) (if (eq a b) 1 0)
                            (if (value_eq a b) 1 0))))))))

    ; Canonical family IDs are projected from the live census.  The heldout
    ; evaluator independently names the same set; the band pins their parity.
    (defn fkpfm-family-ids-loop (families)
        (if (eq (len families) 0) (list)
            (cons (fki-family-id (head families))
                  (fkpfm-family-ids-loop (tail families)))))
    (defn fkpfm-family-ids () (fkpfm-family-ids-loop (fki-families)))
    (defn fkpfm-family-total () (len (fkpfm-family-ids)))
    (defn fkpfm-family? (family)
        (if (not (eq (fkpfm-string? family) 1)) 0
            (fkpfm-family-in? family (fkpfm-family-ids))))
    (defn fkpfm-family-in? (family families)
        (if (eq (len families) 0) 0
            (if (str_eq family (head families)) 1
                (fkpfm-family-in? family (tail families)))))

    (defn fkpfm-heldout-row-for-family (family rows)
        (if (eq (len rows) 0) (nothing)
            (if (str_eq family (fkhe-family (head rows))) (head rows)
                (fkpfm-heldout-row-for-family family (tail rows)))))
    (defn fkpfm-family-source-sha (family)
        (do
            (let row (fkpfm-heldout-row-for-family family (fkhe-rows)))
            (if (nothing? row) (nothing) (fkhe-source-sha row))))
    (defn fkpfm-family-challenge-sha (family)
        ; These are crystallized SHA-256 values of the public literal prompts
        ; in fkhe-rows.  Recomputing even one prompt hash at every evidence
        ; accessor kept physical execution in fk_walk for minutes before
        ; model-open.  The cold challenge-seals band re-walks all fifteen
        ; prompts; any prompt edit dissolves this cache until it is resealed.
        (if (str_eq family "axioms")
            "424b73da931d31dcb25cfcb1630bb951e3a70272f3e269cdbcadc96b2552ea6e"
        (if (str_eq family "bootstrap")
            "1e60973c696c6283b684908198da60831c030752f9e98c05e282d6254eaae0d5"
        (if (str_eq family "form-stdlib")
            "cf06007d4d2f2f8b20df9cd1f4f59e4698087c0432172039ddf296335770ab0e"
        (if (str_eq family "grammars")
            "52895878e5e034e3c87fa6302c43831adfb04e816b027bb0774f9cfea469821a"
        (if (str_eq family "cognition")
            "e070880cc96750db742464a5d04465ab677a1af0f7f84510092df9f1231cb816"
        (if (str_eq family "learn")
            "49f65dc141bfbc69f36c0855ad691ec1f701ccc8f4abd5051657175a5ec916f8"
        (if (str_eq family "observe")
            "64631f7766decef12b55331fd09489071e3af7ccd5efacc8b3333c05122eeb77"
        (if (str_eq family "teachings")
            "214e147ada66142a81b0f3a6ec7a3a17c4fea2e185bf91b3924578ec7d878378"
        (if (str_eq family "receipts")
            "f98a3c4a767228f8ae516c6ed647df28b135b9d16795cee336f6eeb3bd590043"
        (if (str_eq family "model")
            "925500c96e80ecaee4dc98fe74f65cf5c69b7bb2a819356a3f53b30873b91432"
        (if (str_eq family "proof")
            "497d94e6391a0d8d0be25fdaa1a15121af3316f3b6dfaa10d195371bca6195f8"
        (if (str_eq family "control")
            "000df9e1e565ec5c0d6a9e46b702c6a505e0bfdbb72300beefe4be192d60bb53"
        (if (str_eq family "ingest")
            "484dc00f8732e4728befdd2e174eaf4cd39f0c4e0e1ab2f8f90e2ca77c0ca260"
        (if (str_eq family "presence")
            "b56de82ec27784807f5fdf4213de8105c4a0e7d5bf440b9fe498ff21396560a0"
        (if (str_eq family "docs")
            "6619ed828f36c1706f444e0d34ac9f25fa5f9eb18290c1d8936a51a4ac938dc5"
            (nothing)))))))))))))))))

    ; ---- canonical bytes, family execution challenge, receipt --------
    (defn fkpfm-family-ordinal-loop (family families ordinal)
        (if (eq (len families) 0) (nothing)
            (if (str_eq family (head families)) ordinal
                (fkpfm-family-ordinal-loop family (tail families)
                    (add ordinal 1)))))
    (defn fkpfm-family-ordinal (family)
        (fkpfm-family-ordinal-loop family (fkpfm-family-ids) 1))
    (defn fkpfm-family-nonce (family)
        (do
            (let ordinal (fkpfm-family-ordinal family))
            (if (nothing? ordinal) (nothing)
                (nmfe-sha256 (nmfe-fields (list
                    "public-family-execution-nonce-v1" family
                    (int_to_str ordinal) (fkpfm-family-source-sha family)
                    (fkpfm-family-challenge-sha family)))))))
    (defn fkpfm-family-exec-challenge (family)
        (do
            (let ordinal (fkpfm-family-ordinal family))
            (if (nothing? ordinal) (nothing)
                ; BML return and Form request input both vary by family.  The
                ; remaining axes retain the already-proven execution surface.
                (list "generative-form-challenge" (add 65 ordinal)
                      (sub ordinal 4) (add 40 ordinal) 2 "why" 6 1))))
    (defn fkpfm-family-exec-challenge-message (family)
        (do
            (let c (fkpfm-family-exec-challenge family))
            (if (nothing? c) ""
                (nmfe-fields (list "public-family-execution-challenge-v1"
                    family (fkpfm-family-source-sha family)
                    (fkpfm-family-challenge-sha family)
                    (fkpfm-family-nonce family)
                    (int_to_str (fgsg-challenge-bml-value c))
                    (int_to_str (fgsg-challenge-input c))
                    (int_to_str (fgsg-challenge-checkpoint c))
                    (int_to_str (fgsg-challenge-timeout-budget c))
                    (fgsg-challenge-plane c)
                    (int_to_str (fgsg-challenge-heat c))
                    (int_to_str (fgsg-challenge-pure c)))))))
    (defn fkpfm-family-exec-challenge-sha (family)
        (if (eq (fkpfm-family? family) 1)
            (nmfe-sha256 (fkpfm-family-exec-challenge-message family))
            (nothing)))
    (defn fkpfm-family-native-input (family)
        (do
            (let challenge (fkpfm-family-exec-challenge family))
            (if (nothing? challenge) (nothing)
                (fgsg-challenge-input challenge))))

    ; Canonical values are used only for public receipt artifacts.  Length
    ; prefixes keep nested strings/lists injective without JSON or flattening.
    (defn fkpfm-canonical-supported-list? (xs)
        (if (eq (len xs) 0) 1
            (if (eq (fkpfm-canonical-supported? (head xs)) 1)
                (fkpfm-canonical-supported-list? (tail xs)) 0)))
    (defn fkpfm-canonical-supported? (x)
        (if (nothing? x) 1
            (if (eq (fkpfm-string? x) 1) 1
            (if (eq (fkpfm-int? x) 1) 1
            (if (eq (fkpfm-list? x) 1)
                (fkpfm-canonical-supported-list? x) 0)))))
    (defn fkpfm-canonical-list (xs)
        (if (eq (len xs) 0) ""
            (str_concat (fkpfm-canonical (head xs))
                        (fkpfm-canonical-list (tail xs)))))
    (defn fkpfm-canonical (x)
        (if (nothing? x) "N"
            (if (eq (fkpfm-string? x) 1)
                (str_concat "S" (nmfe-field x))
            (if (eq (fkpfm-int? x) 1)
                (str_concat "I" (nmfe-field (int_to_str x)))
            (if (eq (fkpfm-list? x) 1)
                (str_concat "L" (str_concat (int_to_str (len x))
                    (str_concat ":" (fkpfm-canonical-list x))))
                "U")))))

    (defn fkpfm-receipt-kind? (kind)
        (if (or (str_eq kind "heldout")
                (or (str_eq kind "generative")
                    (str_eq kind "execution"))) 1 0))
    ; receipt = tag kind scope family model run source heldout-challenge
    ;           nonce execution-challenge model-output model-output-sha
    ;           artifact-output artifact-output-sha local remote
    ;           model-executed model-requested release receipt-sha
    (defn fkpfm-receipt-message (r)
        (nmfe-fields (list (nth r 0) (nth r 1) (nth r 2) (nth r 3)
            (nth r 4) (nth r 5) (nth r 6) (nth r 7) (nth r 8) (nth r 9)
            (nth r 10) (nth r 11) (nth r 12) (nth r 13)
            (int_to_str (nth r 14)) (int_to_str (nth r 15))
            (int_to_str (nth r 16)) (int_to_str (nth r 17))
            (int_to_str (nth r 18)))))
    (defn fkpfm-receipt
        (kind family model-id run-id model-output artifact-output
         local remote model-executed model-requested release-ok)
        (if (not (eq (fkpfm-family? family) 1)) (nothing)
        (do
            (let source-sha (fkpfm-family-source-sha family))
            (let challenge-sha (fkpfm-family-challenge-sha family))
            (let nonce (fkpfm-family-nonce family))
            (let exec-sha (fkpfm-family-exec-challenge-sha family))
            (let body (list "public-family-receipt-v2" kind
                (fkpfm-public-scope) family model-id run-id source-sha
                challenge-sha nonce exec-sha model-output
                (nmfe-sha256 model-output) artifact-output
                (nmfe-sha256 artifact-output) local remote model-executed
                model-requested release-ok))
            (append body (list (nmfe-sha256
                (fkpfm-receipt-message body)))))))
    (defn fkpfm-receipt-valid? (r)
        (if (not (eq (fkpfm-list? r) 1)) 0
        (if (not (eq (len r) 20)) 0
        (if (not (str_eq (nth r 0) "public-family-receipt-v2")) 0
        (if (not (and (eq (fkpfm-receipt-kind? (nth r 1)) 1)
                      (and (str_eq (nth r 2) (fkpfm-public-scope))
                      (and (eq (fkpfm-family? (nth r 3)) 1)
                      (and (eq (fkpfm-string? (nth r 4)) 1)
                           (gt (str_len (nth r 4)) 0)))))) 0
        (if (not (and (eq (nmfe-sha256? (nth r 5)) 1)
                      (and (eq (nmfe-sha256? (nth r 6)) 1)
                      (and (eq (nmfe-sha256? (nth r 7)) 1)
                      (and (eq (nmfe-sha256? (nth r 8)) 1)
                      (and (eq (nmfe-sha256? (nth r 9)) 1)
                      (and (and (eq (fkpfm-string? (nth r 10)) 1)
                                (gt (str_len (nth r 10)) 0))
                      (and (eq (nmfe-sha256? (nth r 11)) 1)
                      (and (and (eq (fkpfm-string? (nth r 12)) 1)
                                (gt (str_len (nth r 12)) 0))
                      (and (eq (nmfe-sha256? (nth r 13)) 1)
                           (eq (nmfe-sha256? (nth r 19)) 1))))))))))) 0
            (do
                (let family (nth r 3))
                (let requested (if (str_eq (nth r 1) "execution") 1 0))
                (if (and (str_eq (nth r 6) (fkpfm-family-source-sha family))
                     (and (str_eq (nth r 7)
                                      (fkpfm-family-challenge-sha family))
                     (and (str_eq (nth r 8) (fkpfm-family-nonce family))
                     (and (str_eq (nth r 9)
                                      (fkpfm-family-exec-challenge-sha family))
                     (and (str_eq (nth r 11) (nmfe-sha256 (nth r 10)))
                     (and (str_eq (nth r 13) (nmfe-sha256 (nth r 12)))
                     (and (eq (nth r 14) 1)
                     (and (eq (nth r 15) 0)
                     (and (eq (nth r 16) 1)
                     (and (eq (nth r 17) requested)
                     (and (eq (nth r 18) 1)
                          (str_eq (nth r 19)
                              (nmfe-sha256 (fkpfm-receipt-message r))))))))))))))
                    1 0))))))))
    (defn fkpfm-receipt-kind (r) (nth r 1))
    (defn fkpfm-receipt-family (r) (nth r 3))
    (defn fkpfm-receipt-model-id (r) (nth r 4))
    (defn fkpfm-receipt-run-id (r) (nth r 5))
    (defn fkpfm-receipt-model-output (r) (nth r 10))
    (defn fkpfm-receipt-model-output-sha (r) (nth r 11))
    (defn fkpfm-receipt-artifact-output (r) (nth r 12))
    (defn fkpfm-receipt-artifact-output-sha (r) (nth r 13))
    (defn fkpfm-receipt-local? (r) (nth r 14))
    (defn fkpfm-receipt-remote-calls (r) (nth r 15))
    (defn fkpfm-receipt-model-executed? (r) (nth r 16))
    (defn fkpfm-receipt-model-requested? (r) (nth r 17))
    (defn fkpfm-receipt-release-ok? (r) (nth r 18))
    (defn fkpfm-receipt-sha (r) (nth r 19))

    ; ---- heldout adapter ----------------------------------------------
    ; report coherence is recomputed only from sealed public data.  It does
    ; not invoke fkhe-dataset-valid?, whose current-source check reads files.
    (defn fkpfm-heldout-report-valid? (report)
        (if (not (eq (fkpfm-list? report) 1)) 0
        (if (not (eq (len report) 13)) 0
        (if (not (str_eq (nth report 0)
                         "form-knowledge-qwen-heldout-report-v1")) 0
        (if (not (and (eq (fkpfm-string? (nth report 1)) 1)
                      (eq (fkpfm-string? (nth report 2)) 1))) 0
        (if (not (and (eq (fkpfm-list? (nth report 4)) 1)
                      (and (eq (fkpfm-list? (nth report 6)) 1)
                           (eq (fkpfm-list? (nth report 7)) 1)))) 0
            (do
                (let rows (fkhe-rows))
                (let scores (nth report 6))
                (let aggregate (nmfe-aggregate (fkhe-observations scores)))
                (let complete (fkhe-complete-score-set? scores rows))
                (let overall95 (if (eq complete 1)
                    (fkhe-at-least95? (nth aggregate 4)) 0))
                (let family95 (if (eq complete 1)
                    (fkhe-every-family-at-least95? scores (fkhe-families)) 0))
                (let sealed
                    (if (and (str_eq (nth report 3)
                                     (fkhe-dataset-sha256 rows))
                         (and (str_eq (nth report 3) (fkhe-dataset-seal))
                              (eq (fkpfm-equal? (nth report 4)
                                  (fkhe-leakage-audit rows)) 1))) 1 0))
                (let live
                    (if (and (str_eq (nth report 1) (fkhe-live-scope))
                         (and (gt (str_len (nth report 2)) 0)
                         (and (eq (nth report 8) 1)
                         (and (eq (nth report 9) 1)
                         (and (eq sealed 1)
                         (and (eq (fkhe-leakage-audit-valid?
                                      (nth report 4)) 1)
                         (and (eq complete 1)
                         (and (eq (nth aggregate 6) 0)
                         (and (eq overall95 1)
                              (eq family95 1)))))))))) 1 0))
                (if (and (eq sealed 1)
                     (and (eq (nth report 5) (fkpfm-family-total))
                     (and (eq (fkpfm-equal? (nth report 7) aggregate) 1)
                     (and (eq (nth report 10) overall95)
                     (and (eq (nth report 11) family95)
                          (eq (nth report 12) live)))))) 1 0))))))))

    (defn fkpfm-heldout-report-bytes (report)
        (if (eq (fkpfm-canonical-supported? report) 1)
            (fkpfm-canonical report) ""))
    (defn fkpfm-heldout-receipt
        (family model-id run-id raw-output report)
        (fkpfm-receipt "heldout" family model-id run-id raw-output
            (fkpfm-heldout-report-bytes report) 1 0 1 0 1))

    ; heldout evidence = tag scope family receipt report report-sha run-id
    (defn fkpfm-heldout-evidence (family receipt report)
        (list "public-family-heldout-evidence-v2" (fkpfm-public-scope)
              family receipt report
              (nmfe-sha256 (fkpfm-heldout-report-bytes report))
              (if (eq (fkpfm-receipt-valid? receipt) 1)
                  (fkpfm-receipt-run-id receipt) (nothing))))
    (defn fkpfm-heldout-valid? (e)
        (if (not (eq (fkpfm-list? e) 1)) 0
        (if (not (eq (len e) 7)) 0
        (if (not (str_eq (nth e 0) "public-family-heldout-evidence-v2")) 0
        (if (not (and (str_eq (nth e 1) (fkpfm-public-scope))
                      (and (eq (fkpfm-family? (nth e 2)) 1)
                      (and (eq (nmfe-sha256? (nth e 5)) 1)
                           (eq (nmfe-sha256? (nth e 6)) 1))))) 0
            (do
                (let family (nth e 2))
                (let receipt (nth e 3))
                (let report (nth e 4))
                (if (not (eq (fkpfm-heldout-report-valid? report) 1)) 0
                (if (not (eq (fkpfm-receipt-valid? receipt) 1)) 0
                (if (not (and (str_eq (nth report 1) (fkhe-live-scope))
                              (and (gt (str_len (nth report 2)) 0)
                              (and (eq (nth report 8) 1)
                                   (eq (nth report 9) 1))))) 0
                    (do
                        (let scores (nth report 6))
                        (let score (fkhe-find-family-score scores family))
                        (if (or (eq (len score) 0)
                                (not (eq (fkpfm-count-score-family
                                    family scores) 1))) 0
                            (if (eq (fkpfm-all? (list
                                (str_eq (fkpfm-receipt-kind receipt) "heldout")
                                (str_eq (fkpfm-receipt-family receipt) family)
                                (str_eq (fkpfm-receipt-model-id receipt)
                                    (nth report 2))
                                (str_eq (fkpfm-receipt-run-id receipt)
                                    (nth e 6))
                                (str_eq (fkpfm-receipt-model-output-sha receipt)
                                    (nth score 7))
                                (str_eq (fkpfm-receipt-artifact-output receipt)
                                    (fkpfm-heldout-report-bytes report))
                                (str_eq
                                    (fkpfm-receipt-artifact-output-sha receipt)
                                    (nth e 5))
                                (eq (fkpfm-receipt-model-executed? receipt)
                                    (nth report 8))
                                (eq (fkpfm-receipt-release-ok? receipt)
                                    (nth report 9))
                                (eq (fkhe-score-valid? score (fkhe-rows)) 1)
                                (eq (nmfe-obs-error
                                    (fkhe-score-observation score)) 0)
                                (eq (fkhe-at-least95? (nmfe-obs-promotion
                                    (fkhe-score-observation score))) 1))) 1)
                                1 0))))))))))))

    (defn fkpfm-count-score-family (family scores)
        (if (eq (len scores) 0) 0
            (add (if (and (eq (fkpfm-list? (head scores)) 1)
                          (and (eq (len (head scores)) 11)
                               (str_eq (fkhe-score-family (head scores))
                                       family))) 1 0)
                 (fkpfm-count-score-family family (tail scores)))))

    ; ---- generative adapter -------------------------------------------
    ; The family challenge changes both the executed BML return and the Form
    ; request input. Rewrapping one candidate for another family therefore
    ; fails execution rather than merely receiving a different metadata hash.
    (defn fkpfm-candidate-message
        (family source-sha challenge-sha exec-challenge-sha candidate)
        (nmfe-fields
            (list "public-family-generative-candidate-v1" family source-sha
                  challenge-sha (fkpfm-family-nonce family) exec-challenge-sha
                  (fgsg-candidate-bml candidate)
                  (fgsg-candidate-bmf candidate) (fgsg-candidate-form candidate))))
    (defn fkpfm-candidate-sha
        (family source-sha challenge-sha exec-challenge-sha candidate)
        (nmfe-sha256
            (fkpfm-candidate-message family source-sha challenge-sha
                exec-challenge-sha candidate)))
    (defn fkpfm-generative-receipt
        (family model-id run-id raw-output candidate)
        (fkpfm-receipt "generative" family model-id run-id raw-output
            (fkpfm-candidate-message family
                (fkpfm-family-source-sha family)
                (fkpfm-family-challenge-sha family)
                (fkpfm-family-exec-challenge-sha family) candidate)
            1 0 1 0 1))

    ; generative evidence = tag scope family model-id receipt output-sha
    ;                       source-sha heldout-challenge-sha
    ;                       execution-challenge-sha candidate candidate-sha
    ;                       model-executed remote-calls release-ok raw-output
    ;                       run-id
    (defn fkpfm-generative-evidence
        (family model-id receipt raw-output candidate
         model-executed remote-calls release-ok)
        (do
            (let source-sha (fkpfm-family-source-sha family))
            (let challenge-sha (fkpfm-family-challenge-sha family))
            (let exec-sha (fkpfm-family-exec-challenge-sha family))
            (list "public-family-generative-evidence-v2" (fkpfm-public-scope)
                  family model-id receipt (nmfe-sha256 raw-output) source-sha
                  challenge-sha exec-sha candidate
                  (if (or (nothing? source-sha)
                          (or (nothing? challenge-sha) (nothing? exec-sha)))
                      (nothing)
                      (fkpfm-candidate-sha family source-sha challenge-sha
                          exec-sha candidate))
                  model-executed remote-calls release-ok raw-output
                  (if (eq (fkpfm-receipt-valid? receipt) 1)
                      (fkpfm-receipt-run-id receipt) (nothing)))))
    (defn fkpfm-generative-valid? (e)
        (if (not (eq (fkpfm-list? e) 1)) 0
        (if (not (eq (len e) 16)) 0
        (if (not (str_eq (nth e 0)
                         "public-family-generative-evidence-v2")) 0
        (if (not (and (str_eq (nth e 1) (fkpfm-public-scope))
                      (and (eq (fkpfm-family? (nth e 2)) 1)
                      (and (eq (fkpfm-string? (nth e 3)) 1)
                           (gt (str_len (nth e 3)) 0))))) 0
        (if (not (and (eq (nmfe-sha256? (nth e 5)) 1)
                      (and (eq (nmfe-sha256? (nth e 6)) 1)
                      (and (eq (nmfe-sha256? (nth e 7)) 1)
                      (and (eq (nmfe-sha256? (nth e 8)) 1)
                      (and (eq (nmfe-sha256? (nth e 10)) 1)
                           (eq (nmfe-sha256? (nth e 15)) 1))))))) 0
        (if (not (and (eq (nth e 11) 1)
                      (and (eq (nth e 12) 0) (eq (nth e 13) 1)))) 0
        (if (not (eq (fgsg-candidate? (nth e 9)) 1)) 0
            (do
                (let family (nth e 2))
                (let receipt (nth e 4))
                (let source-sha (fkpfm-family-source-sha family))
                (let challenge-sha (fkpfm-family-challenge-sha family))
                (let exec-sha (fkpfm-family-exec-challenge-sha family))
                (let candidate (nth e 9))
                (let raw-output (nth e 14))
                (let parsed (fgsg-candidate-from-text raw-output))
                (let verdict (fgsg-verify candidate
                    (fkpfm-family-exec-challenge family)))
                (if (not (eq (fkpfm-receipt-valid? receipt) 1)) 0
                (if (eq (fkpfm-all? (list
                    (str_eq (fkpfm-receipt-kind receipt) "generative")
                    (str_eq (fkpfm-receipt-family receipt) family)
                    (str_eq (fkpfm-receipt-model-id receipt) (nth e 3))
                    (str_eq (fkpfm-receipt-run-id receipt) (nth e 15))
                    (str_eq (fkpfm-receipt-model-output receipt) raw-output)
                    (str_eq (fkpfm-receipt-model-output-sha receipt) (nth e 5))
                    (str_eq (nth e 6) source-sha)
                    (str_eq (nth e 7) challenge-sha)
                    (str_eq (nth e 8) exec-sha)
                    (eq (fkpfm-equal? parsed candidate) 1)
                    (str_eq (nth e 10) (fkpfm-candidate-sha family
                        source-sha challenge-sha exec-sha candidate))
                    (str_eq (fkpfm-receipt-artifact-output receipt)
                        (fkpfm-candidate-message family source-sha
                            challenge-sha exec-sha candidate))
                    (str_eq (fkpfm-receipt-artifact-output-sha receipt)
                        (nth e 10))
                    (eq (fkpfm-receipt-model-executed? receipt) (nth e 11))
                    (eq (fkpfm-receipt-remote-calls receipt) (nth e 12))
                    (eq (fkpfm-receipt-release-ok? receipt) (nth e 13))
                    (eq (fgsg-verdict-overall verdict) 1)
                    (eq (fgsg-verdict-bml verdict) 1)
                    (eq (fgsg-verdict-bmf verdict) 1)
                    (eq (fgsg-verdict-form verdict) 1)
                    (eq (fgsg-verdict-leakage verdict) 0)
                    (eq (fgsg-verdict-model-executed? verdict) 0)
                    (eq (fgsg-verdict-native-carrier-executed? verdict) 0))) 1)
                    1 0)))))))))))

    ; ---- native execution adapter -------------------------------------
    (defn fkpfm-node-list-eq? (a b)
        (if (not (eq (len a) (len b))) 0
            (if (eq (len a) 0) 1
                (if (node_eq (head a) (head b))
                    (fkpfm-node-list-eq? (tail a) (tail b)) 0))))
    (defn fkpfm-concrete-carrier? (carrier)
        (if (or (str_eq carrier "metal")
                (or (str_eq carrier "mlx") (str_eq carrier "cpu"))) 1 0))
    (defn fkpfm-result-observation-valid? (result)
        (do
            (let observation (frex-result-observation result))
            (if (nothing? observation) 0
            (if (not (node_eq (node_category observation)
                              (frex-observation-category))) 0
                (do
                    (let kids (node_children observation))
                    (let trace (frex-result-trace result))
                    (if (not (eq (len kids) (add 10 (len trace)))) 0
                        (if (and (str_eq (node_value (nth kids 0))
                                         (frex-result-status result))
                             (and (str_eq (node_value (nth kids 1))
                                          (frex-result-reason result))
                             (and (node_eq (nth kids 2)
                                           (frex-result-request result))
                             (and (node_eq (nth kids 3)
                                           (frex-result-recipe result))
                             (and (str_eq (node_value (nth kids 4))
                                          (frex-result-carrier result))
                             (and (eq (node_value (nth kids 5))
                                      (frex-result-value result))
                             (and (eq (node_value (nth kids 6))
                                      (frex-result-value-present? result))
                             (and (eq (node_value (nth kids 7))
                                      (frex-result-executed? result))
                             (and (eq (node_value (nth kids 8))
                                      (frex-result-model-executed? result))
                             (and (eq (node_value (nth kids 9))
                                      (frex-result-native-code-generated? result))
                                  (eq (fkpfm-node-list-eq?
                                      (fkpfm-drop kids 10) trace) 1))))))))))) 1 0)))))))
    (defn fkpfm-drop (xs n)
        (if (eq n 0) xs (fkpfm-drop (tail xs) (sub n 1))))
    (defn fkpfm-native-result-valid? (result)
        (if (not (eq (fkpfm-list? result) 1)) 0
        (if (not (eq (len result) 13)) 0
        (if (not (and (str_eq (frex-result-status result) "value")
                      (and (eq (frex-result-value-present? result) 1)
                      (and (eq (frex-result-executed? result) 1)
                      (and (eq (frex-result-model-executed? result) 0)
                           (eq (frex-result-native-code-generated? result) 1)))))) 0
        (if (not (and (eq (fkpfm-concrete-carrier?
                                (frex-result-carrier result)) 1)
                      (and (gt (frex-result-attempts result) 0)
                           (le (frex-result-attempts result)
                               (frex-max-attempts))))) 0
        (if (not (and (eq (frex-request-node-valid?
                                (frex-result-request result)) 1)
                      (and (eq (frex-recipe-valid?
                                (frex-result-recipe result)) 1)
                           (node_eq (nth (node_children
                                (frex-result-request result)) 0)
                                (frex-result-recipe result))))) 0
        (if (not (and (eq (frex-trace-has?
                                (frex-result-trace result) "choice") 1)
                      (and (eq (frex-trace-has?
                                (frex-result-trace result) "crystallize") 1)
                      (and (eq (frex-trace-has?
                                (frex-result-trace result) "dissolve") 1)
                           (eq (frex-trace-has?
                                (frex-result-trace result) "release") 1))))) 0
            (fkpfm-result-observation-valid? result))))))))

    (defn fkpfm-native-result-family-bound? (family result)
        (if (not (eq (fkpfm-native-result-valid? result) 1)) 0
            (do
                (let request (frex-result-request result))
                (let kids (node_children request))
                (if (and (eq (len kids) 4)
                     (and (eq (node_value (nth kids 1))
                                  (fkpfm-family-native-input family))
                     (and (eq (frex-result-value result)
                                  (add (mul 3 (fkpfm-family-native-input family))
                                       7))
                     (and (str_eq (node_value (nth kids 2))
                                  (frex-result-carrier result))
                     (and (eq (node_value (nth kids 3)) (frex-max-attempts))
                          (node_eq (nth kids 0)
                                   (frex-result-recipe result))))))) 1 0))))
    (defn fkpfm-native-request-bytes (family result)
        (if (eq (fkpfm-native-result-family-bound? family result) 1)
            (frex-surface (frex-result-recipe result)
                (fkpfm-family-native-input family)
                (frex-result-carrier result)) ""))
    (defn fkpfm-native-result-bytes (family result)
        (if (eq (fkpfm-native-result-family-bound? family result) 1)
            (frex-render result) ""))
    (defn fkpfm-execution-receipt
        (family model-id run-id raw-output result)
        (fkpfm-receipt "execution" family model-id run-id raw-output
            (fkpfm-native-result-bytes family result) 1 0 1 1 1))

    ; execution evidence = tag scope family model-id receipt result-sha
    ;                      source-sha heldout-challenge-sha
    ;                      execution-challenge-sha raw-model-request
    ;                      model-requested remote-calls release-ok native-result
    ;                      run-id
    (defn fkpfm-execution-evidence
        (family model-id receipt raw-output model-requested
         remote-calls release-ok result)
        (list "public-family-execution-evidence-v2" (fkpfm-public-scope)
              family model-id receipt
              (nmfe-sha256 (fkpfm-native-result-bytes family result))
              (fkpfm-family-source-sha family)
              (fkpfm-family-challenge-sha family)
              (fkpfm-family-exec-challenge-sha family) raw-output
              model-requested remote-calls release-ok result
              (if (eq (fkpfm-receipt-valid? receipt) 1)
                  (fkpfm-receipt-run-id receipt) (nothing))))
    (defn fkpfm-execution-valid? (e)
        (if (not (eq (fkpfm-list? e) 1)) 0
        (if (not (eq (len e) 15)) 0
        (if (not (str_eq (nth e 0)
                         "public-family-execution-evidence-v2")) 0
        (if (not (and (str_eq (nth e 1) (fkpfm-public-scope))
                      (and (eq (fkpfm-family? (nth e 2)) 1)
                      (and (eq (fkpfm-string? (nth e 3)) 1)
                           (gt (str_len (nth e 3)) 0))))) 0
        (if (not (and (eq (nmfe-sha256? (nth e 5)) 1)
                      (and (eq (nmfe-sha256? (nth e 6)) 1)
                      (and (eq (nmfe-sha256? (nth e 7)) 1)
                      (and (eq (nmfe-sha256? (nth e 8)) 1)
                           (eq (nmfe-sha256? (nth e 14)) 1)))))) 0
        (if (not (and (eq (nth e 10) 1)
                      (and (eq (nth e 11) 0) (eq (nth e 12) 1)))) 0
            (do
                (let family (nth e 2))
                (let receipt (nth e 4))
                (let result (nth e 13))
                (let raw-output (nth e 9))
                (let result-bytes (fkpfm-native-result-bytes family result))
                (if (not (eq (fkpfm-receipt-valid? receipt) 1)) 0
                (if (and (str_eq (fkpfm-receipt-kind receipt) "execution")
                     (and (str_eq (fkpfm-receipt-family receipt) family)
                     (and (str_eq (fkpfm-receipt-model-id receipt) (nth e 3))
                     (and (str_eq (fkpfm-receipt-run-id receipt) (nth e 14))
                     (and (str_eq (nth e 6)
                                      (fkpfm-family-source-sha family))
                     (and (str_eq (nth e 7)
                                      (fkpfm-family-challenge-sha family))
                     (and (str_eq (nth e 8)
                                      (fkpfm-family-exec-challenge-sha family))
                     (and (str_eq raw-output
                                      (fkpfm-native-request-bytes family result))
                     (and (str_eq (fkpfm-receipt-model-output receipt) raw-output)
                     (and (str_eq (fkpfm-receipt-model-output-sha receipt)
                                      (nmfe-sha256 raw-output))
                     (and (str_eq (fkpfm-receipt-artifact-output receipt)
                                      result-bytes)
                     (and (str_eq (fkpfm-receipt-artifact-output-sha receipt)
                                      (nth e 5))
                     (and (eq (fkpfm-receipt-model-requested? receipt)
                                  (nth e 10))
                     (and (eq (fkpfm-receipt-remote-calls receipt) (nth e 11))
                     (and (eq (fkpfm-receipt-release-ok? receipt) (nth e 12))
                          (eq (fkpfm-native-result-family-bound?
                                  family result) 1)))))))))))))))) 1 0))))))))))

    ; ---- evidence admission and family fold ---------------------------
    (defn fkpfm-heldout-tag? (e)
        (if (and (eq (fkpfm-list? e) 1) (gt (len e) 0))
            (if (str_eq (head e) "public-family-heldout-evidence-v2") 1 0) 0))
    (defn fkpfm-generative-tag? (e)
        (if (and (eq (fkpfm-list? e) 1) (gt (len e) 0))
            (if (str_eq (head e) "public-family-generative-evidence-v2") 1 0) 0))
    (defn fkpfm-execution-tag? (e)
        (if (and (eq (fkpfm-list? e) 1) (gt (len e) 0))
            (if (str_eq (head e) "public-family-execution-evidence-v2") 1 0) 0))
    (defn fkpfm-evidence-valid? (e)
        (if (eq (fkpfm-heldout-tag? e) 1) (fkpfm-heldout-valid? e)
            (if (eq (fkpfm-generative-tag? e) 1) (fkpfm-generative-valid? e)
                (if (eq (fkpfm-execution-tag? e) 1)
                    (fkpfm-execution-valid? e) 0))))
    (defn fkpfm-admit (e)
        (if (eq (fkpfm-evidence-valid? e) 1) e (nothing)))
    (defn fkpfm-evidence-family (e) (nth e 2))
    (defn fkpfm-has-kind? (family evidences kind)
        (if (eq (len evidences) 0) 0
            (do
                (let e (head evidences))
                (if (and (eq (fkpfm-list? e) 1)
                         (and (gt (len e) 2)
                         (and (str_eq (head e) kind)
                         (and (str_eq (fkpfm-evidence-family e) family)
                              (eq (fkpfm-evidence-valid? e) 1))))) 1
                    (fkpfm-has-kind? family (tail evidences) kind)))))
    (defn fkpfm-family-row (family evidences)
        (do
            (let heldout (fkpfm-has-kind? family evidences
                "public-family-heldout-evidence-v2"))
            (let generative (fkpfm-has-kind? family evidences
                "public-family-generative-evidence-v2"))
            (let execution (fkpfm-has-kind? family evidences
                "public-family-execution-evidence-v2"))
            (list "public-family-mastery-row-v1" family heldout generative
                  execution
                  (if (and (eq heldout 1)
                           (and (eq generative 1) (eq execution 1))) 1 0))))
    (defn fkpfm-family-rows-loop (families evidences)
        (if (eq (len families) 0) (list)
            (cons (fkpfm-family-row (head families) evidences)
                  (fkpfm-family-rows-loop (tail families) evidences))))
    (defn fkpfm-count-row-field (rows index)
        (if (eq (len rows) 0) 0
            (add (nth (head rows) index)
                 (fkpfm-count-row-field (tail rows) index))))
    (defn fkpfm-invalid-count (evidences)
        (if (eq (len evidences) 0) 0
            (add (if (eq (fkpfm-evidence-valid? (head evidences)) 1) 0 1)
                 (fkpfm-invalid-count (tail evidences)))))
    (defn fkpfm-missing-families (rows)
        (if (eq (len rows) 0) (list)
            (if (eq (nth (head rows) 5) 1)
                (fkpfm-missing-families (tail rows))
                (cons (nth (head rows) 1)
                      (fkpfm-missing-families (tail rows))))))
    (defn fkpfm-percent (mastered total)
        (if (eq total 0) 0 (div (mul mastered 100) total)))
    (defn fkpfm-ready95? (mastered total invalid)
        (if (or (eq total 0) (not (eq invalid 0))) 0
            (if (ge (mul mastered 100)
                    (mul total (fkpfm-threshold-percent))) 1 0)))

    ; report = tag basis total mastered percent ready95 heldout generative
    ;          execution invalid family-rows missing threshold route-credit
    (defn fkpfm-report (evidences)
        (if (not (eq (fkpfm-list? evidences) 1)) (nothing)
            (do
                (let rows (fkpfm-family-rows-loop
                    (fkpfm-family-ids) evidences))
                (let total (len rows))
                (let mastered (fkpfm-count-row-field rows 5))
                (let invalid (fkpfm-invalid-count evidences))
                (list "form-knowledge-public-family-mastery-report-v1"
                      (fkpfm-basis) total mastered
                      (fkpfm-percent mastered total)
                      (fkpfm-ready95? mastered total invalid)
                      (fkpfm-count-row-field rows 2)
                      (fkpfm-count-row-field rows 3)
                      (fkpfm-count-row-field rows 4)
                      invalid rows (fkpfm-missing-families rows)
                      (fkpfm-threshold-percent) 0))))
    (defn fkpfm-report-total (r) (nth r 2))
    (defn fkpfm-report-mastered (r) (nth r 3))
    (defn fkpfm-report-percent (r) (nth r 4))
    (defn fkpfm-report-ready95? (r) (nth r 5))
    (defn fkpfm-report-heldout-families (r) (nth r 6))
    (defn fkpfm-report-generative-families (r) (nth r 7))
    (defn fkpfm-report-execution-families (r) (nth r 8))
    (defn fkpfm-report-invalid-evidence (r) (nth r 9))
    (defn fkpfm-report-family-rows (r) (nth r 10))
    (defn fkpfm-report-missing-families (r) (nth r 11))
    (defn fkpfm-report-route-addressability-credit (r) (nth r 13))

    0)
