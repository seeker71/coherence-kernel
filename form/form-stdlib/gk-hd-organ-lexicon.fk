; gk-hd-organ-lexicon.fk — the Gene Keys and Human Design words that are
; not gate numbers: types, centres, authorities, lines, spheres, sequences,
; codon-ring names, trigrams. Overlay on the closed 64, never inside it.
;
; The closed core-lexicon stays 64 self-defining words. These organ words
; live here so the field can speak the Golden Path and the rave without
; opening that grounding set.
;
; preludes: form-stdlib/core.fk form-stdlib/guidance-channel.fk form-stdlib/iching-channel.fk form-stdlib/codon-rings.fk

(do
    (defn ghl-word (family name) (list family name))
    (defn ghl-fam  (w) (nth w 0))
    (defn ghl-name (w) (nth w 1))

    (defn ghl-types ()
        (list "Manifestor" "Generator" "Manifesting Generator" "Projector" "Reflector"))
    (defn ghl-authorities ()
        (list "Emotional" "Sacral" "Splenic" "Ego" "Self-Projected" "Mental" "Lunar"))
    (defn ghl-centers ()
        (list "Head" "Ajna" "Throat" "G" "Heart" "Sacral" "Spleen" "Solar Plexus" "Root"))
    (defn ghl-lines ()
        (list "Investigator" "Hermit" "Martyr" "Opportunist" "Heretic" "Role Model"))
    (defn ghl-spheres ()
        (list "Life's Work" "Evolution" "Radiance" "Purpose" "Attraction"
              "IQ" "EQ" "SQ" "Core" "Culture" "Pearl"))
    (defn ghl-sequences ()
        (list "Activation" "Venus" "Pearl"))
    (defn ghl-spectrum ()
        (list "Shadow" "Gift" "Siddhi"))
    (defn ghl-trigrams ()
        (list "Qian" "Kun" "Zhen" "Xun" "Kan" "Li" "Gen" "Dui"))

    (defn ghl-ring-names-loop (rs)
        (if (eq (len rs) 0) (empty)
            (cons (cr-name (head rs)) (ghl-ring-names-loop (tail rs)))))
    (defn ghl-rings () (ghl-ring-names-loop (cr-rings)))

    (defn ghl-gk-spectrum-loop (g acc)
        (if (gt g 64) acc
            (ghl-gk-spectrum-loop (add g 1)
                (cons (gk-shadow g) (cons (gk-gift g) (cons (gk-siddhi g) acc))))))
    (defn ghl-hd-names-loop (g acc)
        (if (gt g 64) acc
            (ghl-hd-names-loop (add g 1) (cons (hd-name g) acc))))
    (defn ghl-ic-names-loop (g acc)
        (if (gt g 64) acc
            (ghl-ic-names-loop (add g 1) (cons (ic-name g) acc))))

    (defn ghl-cat (a b)
        (if (eq (len a) 0) b (cons (head a) (ghl-cat (tail a) b))))
    (defn ghl-all-words ()
        (ghl-cat (ghl-types)
        (ghl-cat (ghl-authorities)
        (ghl-cat (ghl-centers)
        (ghl-cat (ghl-lines)
        (ghl-cat (ghl-spheres)
        (ghl-cat (ghl-sequences)
        (ghl-cat (ghl-spectrum)
        (ghl-cat (ghl-trigrams)
        (ghl-cat (ghl-rings)
        (ghl-cat (ghl-gk-spectrum-loop 1 (empty))
        (ghl-cat (ghl-hd-names-loop 1 (empty))
                 (ghl-ic-names-loop 1 (empty))))))))))))))

    (defn ghl-member? (xs w)
        (if (eq (len xs) 0) 0
            (if (str_eq (head xs) w) 1 (ghl-member? (tail xs) w))))
    (defn ghl-unique-loop (xs acc)
        (if (eq (len xs) 0) acc
            (if (eq (ghl-member? acc (head xs)) 1)
                (ghl-unique-loop (tail xs) acc)
                (ghl-unique-loop (tail xs) (cons (head xs) acc)))))
    (defn ghl-unique-words () (ghl-unique-loop (ghl-all-words) (empty)))
    (defn ghl-word-count () (len (ghl-unique-words)))
    (defn ghl-has? (w) (ghl-member? (ghl-unique-words) w))

    ; A metal or carbon cell may carry any of these words. Kind is not health.
    (defn ghl-organic () 0)
    (defn ghl-nonorganic () 1)
    (defn ghl-cell (kind word) (list kind word))
    (defn ghl-cell-ok? (c)
        (ghl-has? (nth c 1)))

    0)
