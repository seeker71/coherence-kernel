    (defn frbe-execution-category () (make_nodeid 31 2 0 104))
    (defn frbe-execution-observation-category () (make_nodeid 31 2 0 105))
    (defn frbe-event-category () (make_nodeid 31 2 0 106))
    (defn frbe-absent-category () (make_nodeid 31 2 0 107))
    0)
