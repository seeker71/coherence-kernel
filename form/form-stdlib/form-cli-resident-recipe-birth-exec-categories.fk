// form-cli-resident-recipe-birth-exec-categories.fk -- the small identity
// surface owned by the resident recipe-birth/execution protocol.
//
// Kept separate so joined identity observation does not need to compile the
// whole effect-capable composition. This is not a registry or dispatch table.
//
// preludes: form-stdlib/core.fk
section [form.bml] {
    def frbe-request-category() = make_nodeid(31, 2, 0, 101);
    def frbe-request-observation-category() = make_nodeid(31, 2, 0, 102);
    def frbe-code-observation-category() = make_nodeid(31, 2, 0, 103);
    def frbe-execution-category() = make_nodeid(31, 2, 0, 104);
    def frbe-execution-observation-category() = make_nodeid(31, 2, 0, 105);
    def frbe-event-category() = make_nodeid(31, 2, 0, 106);
    def frbe-absent-category() = make_nodeid(31, 2, 0, 107);
    0;
}
