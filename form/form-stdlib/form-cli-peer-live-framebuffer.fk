; form-cli-peer-live-framebuffer.fk -- opaque resident-peer lifecycle frames.
;
; The running peer owns this channel.  A frame is deliberately small: turn,
; phase and public signal only.  Task bytes, model bytes and answer bytes stay
; in the caller-owned turn, never in framebuffer storage.
;
; preludes: form-stdlib/bml/form-cli-resident-continuity.bml observe/bidirectional-framebuffer-channel.fk

(do
    (defn fcplf-stage-code (stage)
        (if (str_eq stage "prefill-ready") 1
            (if (str_eq stage "task-begin") 2
                (if (str_eq stage "task-terminal") 3
                    (if (str_eq stage "release") 4 0)))))

    (defn fcplf-exchange (turn stage)
        (add (mul turn 16) (fcplf-stage-code stage)))

    (defn fcplf-outbound (turn stage signal)
        (bfc-envelope 0 (fcplf-exchange turn stage) 0
            (list turn (fcplf-stage-code stage) signal)
            (nothing)))

    (defn fcplf-record (turn stage signal)
        (do
            (let outbound (fcplf-outbound turn stage signal))
            (bfc-record-out outbound (fcplf-exchange turn stage))))

    (defn fcplf-rule () (frc-peer-frame-rule))
    (defn fcplf-privacy-rule () (frc-peer-frame-privacy-rule))
    0)
