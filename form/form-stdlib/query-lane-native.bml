// The 64 core words take the frequency of the concept family they already
// belong to. The six ask lanes keep that substrate answer, and the same
// word is the local model's own token sequence.
//
// A frequency here is the family: ground 0, person 1, act 2, ask 3,
// time 4, place 5, degree 6, relation 7. A word is aligned when the
// family stored on its row is the family its place in the 64 implies.
//
// who, where, what, when, and how each answer one core word. why walks
// toward the ground and rests in nothing. The token ids are read from
// the caller's tokenizer source; this cell does not invent an id.
import form-stdlib/core-lexicon.fk;
import form-stdlib/qwen35-tokenizer.fk;
section [form.bml] {
 class QueryLaneNative {
  def qln-concepts() = ["ground", "person", "act", "ask", "time", "place", "degree", "relation"];
  def qln-lanes() = ["who", "where", "what", "when", "how", "why"];
  def qln-freq(i) = i / 8;
  def qln-concept(i) = qln-concepts()[qln-freq(i)];
  def qln-aligned-at?(i) = (Comparable) cl-fam(cl-at(i)) == qln-freq(i) ? 1 : 0;
  def qln-aligned-loop(i) = i >= 64 ? 1 : (Comparable) qln-aligned-at?(i) == 1 ? qln-aligned-loop(i + 1) : 0;
  def qln-aligned?() = (Comparable) cl-count() == 64 ? qln-aligned-loop(0) : 0;
  def qln-answer(lane) = (String) lane == "who" ? "self" : (String) lane == "where" ? "here" : (String) lane == "what" ? "thing" : (String) lane == "when" ? "now" : (String) lane == "how" ? "way" : "nothing";
  def qln-lane-freq(lane) = (String) lane == "why" ? 0 : qln-freq(cl-index-of(qln-answer(lane)));
  def qln-substrate?(lane) = (String) lane == "why" ? (Comparable) cl-step("why", cl-index-of("nothing")) == cl-t-nothing() ? 1 : 0 : (Comparable) cl-step(lane, 0) == cl-index-of(qln-answer(lane)) ? 1 : 0;
  def qln-ids(src, word) = q35-encode(src, word);
  def qln-pieces(src, word) = len(qln-ids(src, word));
  def qln-roundtrip?(src, word) = (String) tkz-decode-text(src, qln-ids(src, word)) == word ? 1 : 0;
  def qln-lane-tokens?(src, ls) = (Comparable) len(ls) == 0 ? 1 : (Comparable) qln-roundtrip?(src, ls[0]) == 1 ? qln-lane-tokens?(src, ls[1:]) : 0;
  def qln-vocab-tokens-loop(src, i) = i >= 64 ? 1 : (Comparable) qln-roundtrip?(src, cl-word(cl-at(i))) == 1 ? qln-vocab-tokens-loop(src, i + 1) : 0;
  def qln-vocab-tokens?(src) = qln-vocab-tokens-loop(src, 0);
  def qln-one-piece?(src, word) = (Comparable) qln-pieces(src, word) == 1 ? 1 : 0;
  def qln-lanes-one-piece?(src, ls) = (Comparable) len(ls) == 0 ? 1 : (Comparable) qln-one-piece?(src, ls[0]) == 1 ? qln-lanes-one-piece?(src, ls[1:]) : 0;
  def qln-id-text(ids) = (Comparable) len(ids) == 0 ? "" : (Comparable) len(ids) == 1 ? ids[0].str() : ids[0].str() + ("," + qln-id-text(ids[1:]));
  def qln-line(src, lane) = lane + (" freq=" + (qln-lane-freq(lane).str() + (" concept=" + (qln-answer(lane) + (" tokens=" + (qln-id-text(qln-ids(src, lane)) + (" pieces=" + qln-pieces(src, lane).str())))))));
 }
}
