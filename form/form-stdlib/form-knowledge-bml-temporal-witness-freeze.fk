; form-knowledge-bml-temporal-witness-freeze.fk -- preregistered semantic
; source group for the next canonical BML transfer observation.
;
; This cell was committed before a prompt, candidate, repair, model run or
; gradient was derived.  Shared form.bml/BMF grammar authority is allowed;
; these two semantic sources and every case below remain evaluation-only.
;
; case = schema family name args expected axis
;
; preludes: form-stdlib/core.fk form-stdlib/sha256.fk
; preludes: form-stdlib/native-model-evidence.fk

(do
    (defn fktwf-schema ()
        "form-bml-temporal-witness-freeze-v1")
    (defn fktwf-family ()
        "form-bml-temporal-witness-v1")
    (defn fktwf-split () "heldout-frozen-before-transform")
    (defn fktwf-frozen-at () 20260826)

    (defn fktwf-source-paths ()
        (list
            "form/form-stdlib/input-stream-lifecycle.fk"
            "form/form-stdlib/obs-verify.fk"))
    (defn fktwf-source-shas ()
        (list
            "d1d0be0540f4a94827f2f1725967fbd13c85fb7ecc3d48124cec04a1204f077b"
            "9846e78e9e93d68dfc17ec1750176b0ad82cf0e2b6264098c803860d1590344e"))
    (defn fktwf-source-provenance ()
        (list
            "1440772cc07df8b70be65c796a1cdead8fb4245e"
            "1c6f456c65c0e35de7527ceb255d3d18e974798e"))
    (defn fktwf-source-group-surface ()
        (str_concat
            "form-bml-temporal-witness-source-group-v1\nform/form-stdlib/input-stream-lifecycle.fk\td1d0be0540f4a94827f2f1725967fbd13c85fb7ecc3d48124cec04a1204f077b\t1440772cc07df8b70be65c796a1cdead8fb4245e\n"
            "form/form-stdlib/obs-verify.fk\t9846e78e9e93d68dfc17ec1750176b0ad82cf0e2b6264098c803860d1590344e\t1c6f456c65c0e35de7527ceb255d3d18e974798e\n"))
    (defn fktwf-source-group-id ()
        (nmfe-sha256 (fktwf-source-group-surface)))
    (defn fktwf-sealed-source-group-id ()
        "9c01794960753681e199c338780049fbee8fbb8b097d8157240718aa061790ee")

    (defn fktwf-source-current-one? (path expected)
        (str_eq (nmfe-sha256 (read_file path)) expected))
    (defn fktwf-sources-current-loop (paths shas)
        (if (nil? paths) 1
            (if (fktwf-source-current-one? (head paths) (head shas))
                (fktwf-sources-current-loop (tail paths) (tail shas)) 0)))
    (defn fktwf-sources-current? ()
        (fktwf-sources-current-loop
            (fktwf-source-paths) (fktwf-source-shas)))

    (defn fktwf-case (family name args expected axis)
        (list "form-bml-temporal-witness-case-v1"
            family name args expected axis))
    (defn fktwf-case-family (row) (nth row 1))
    (defn fktwf-case-name (row) (nth row 2))
    (defn fktwf-case-args (row) (nth row 3))
    (defn fktwf-case-expected (row) (nth row 4))
    (defn fktwf-case-axis (row) (nth row 5))

    ; The ten semantic consequences are sealed before model observation.
    ; verify args = answered value when deadline.
    ; stream args = frame-present kind ack elapsed timeout.
    (defn fktwf-cases ()
        (list
            (fktwf-case "verify" "observed" (list 1 1 26 29) 1 "present-one")
            (fktwf-case "verify" "absent" (list 1 0 26 29) 0 "present-zero")
            (fktwf-case "verify" "late" (list 1 1 31 29) -1 "late-arrival")
            (fktwf-case "verify" "silent" (list 0 1 26 29) -1 "unanswered")
            (fktwf-case "stream" "live" (list 0 0 0 28 29) 0 "before-deadline")
            (fktwf-case "stream" "timeout" (list 0 0 0 29 29) 4 "inclusive-deadline")
            (fktwf-case "stream" "explicit-nothing" (list 1 5 0 29 29) 5 "explicit-nothing")
            (fktwf-case "stream" "unacked-stop" (list 1 1 0 0 29) 6 "acknowledgement")
            (fktwf-case "stream" "handoff" (list 1 2 1 0 29) 2 "signal-kind")
            (fktwf-case "stream" "offline" (list 1 4 1 0 29) 3 "offline-signal")))

    (defn fktwf-leakage-bans ()
        (list
            "form/form-stdlib/input-stream-lifecycle.fk"
            "form/form-stdlib/obs-verify.fk"
            "d1d0be0540f4a94827f2f1725967fbd13c85fb7ecc3d48124cec04a1204f077b"
