            "59cb1b298ad94c111b19943580a4155bb332efec3b3d85a7b132f1a2e8866b70"
            "a771e529c659f80074956abebda8ef73b30376bd74a72a9a568d3bf501cde169"
            "00786c0f827f90a967a33f59cfcd3bb010f6af2c4ad63ed7528cc5b6b93017d4"
            "141c10174fddb351e666a969e1a919326f10871a6b3602f511bd17ac3cbccc05"
            "aa5d3b417a381fff35c8b22832c700690a759cb64148593a8470e09a6b780a02"
            "fkecc-" "oac-" "offer-ack" "choice-lane" "20260826T012801Z"
            "41" "99" "511"))

    (defn fktwf-gradient-allowed? () 0)
