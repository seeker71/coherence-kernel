// form-cli-local-docs.fk — Form-native query over a local folder.
//
// Yes asked: enable as much as possible so anyone with a free ChatGPT
// account can use Form-native queries and responses for documents and
// folders on their own machine.
//
// Honest floor, 2026-08-19 (OpenAI help, updated this week):
//   personal ChatGPT accounts cannot create or publish new GPTs.
//   ChatGPT's cloud cannot see a local disk. The public Sema GPT
//   Action hits hati.earth, which holds this body, not a visitor's
//   files. So a free account cannot point ChatGPT at their folder.
//
// What this cell enables anyway:
//   1. form-cli asks the folder. Form retrieves. Miss is a miss.
//   2. a paste-pack: they drop the Form ground into free ChatGPT,
//      which is told to speak only from those hits.
// ChatGPT is the rented voice. The folder never leaves the machine
// unless they choose to paste.
//
// preludes: form-stdlib/core.fk
// witnessed: 2026-08-19 -> 1023
section [form.bml] {
    def fld-doc(path, tokens, snippet) = list(path, tokens, snippet);
    def fld-path(d) = nth(d, 0);
    def fld-tokens(d) = nth(d, 1);
    def fld-snippet(d) = nth(d, 2);
    def fld-lower-byte(b) = b >= 65 && b <= 90 ? b + 32 : b;
    def fld-alnum?(b) = b >= 48 && b <= 57 || b >= 97 && b <= 122;
    def fld-tokens-loop(s, i, n, cur, acc) = i >= n ? str_len(cur) > 3 ? cons(cur, acc) : acc : let(b, fld-lower-byte(str_byte_at(s, i)), fld-alnum?(b) ? fld-tokens-loop(s, i + 1, n, str_concat(cur, byte_to_str(b)), acc) : str_len(cur) > 3 ? fld-tokens-loop(s, i + 1, n, "", cons(cur, acc)) : fld-tokens-loop(s, i + 1, n, "", acc));
    def fld-tokenize(s) = fld-tokens-loop(s, 0, str_len(s), "", empty());
    def fld-cap(s, n) = str_len(s) > n ? substring(s, 0, n) : s;
    def fld-in?(t, keys) = (Comparable) len(keys) == 0 ? 0 : (String) head(keys) == t ? 1 : fld-in?(t, tail(keys));
    def fld-score-tokens(qkeys, dkeys) = (Comparable) len(qkeys) == 0 ? 0 : fld-in?(head(qkeys), dkeys) + fld-score-tokens(tail(qkeys), dkeys);
    def fld-score(qkeys, d) = fld-score-tokens(qkeys, fld-tokens(d));
    def fld-best-loop(qkeys, docs, best, bestscore) = (Comparable) len(docs) == 0 ? list(best, bestscore) : let(s, fld-score(qkeys, head(docs)), s > bestscore ? fld-best-loop(qkeys, tail(docs), head(docs), s) : fld-best-loop(qkeys, tail(docs), best, bestscore));
    def fld-best(qkeys, docs) = fld-best-loop(qkeys, docs, empty(), 0);
    def fld-others(qkeys, docs, best-path) = (Comparable) len(docs) == 0 ? empty() : let(d, head(docs), fld-score(qkeys, d) > 0 ? (String) fld-path(d) == best-path ? fld-others(qkeys, tail(docs), best-path) : cons(d, fld-others(qkeys, tail(docs), best-path)) : fld-others(qkeys, tail(docs), best-path));
    def fld-take(n, xs) = ((Comparable) n == 0 ? 1 : (Comparable) len(xs) == 0) ? empty() : cons(head(xs), fld-take(n - 1, tail(xs)));
    def fld-ask(question, docs) = let(qkeys, fld-tokenize(question), let(pair, fld-best(qkeys, docs), let(best, nth(pair, 0), let(score, nth(pair, 1), (Comparable) score == 0 ? list("miss", empty(), question) : list("hit", cons(best, fld-take(2, fld-others(qkeys, docs, fld-path(best)))), question)))));
    def fld-status(ans) = nth(ans, 0);
    def fld-hits(ans) = nth(ans, 1);
    def fld-q(ans) = nth(ans, 2);
    def fld-hit-line(d) = str_concat("- path: ", str_concat(fld-path(d), str_concat("\n  snippet: ", fld-snippet(d))));
    def fld-hit-lines(hits) = (Comparable) len(hits) == 0 ? "(none)" : (Comparable) len(tail(hits)) == 0 ? fld-hit-line(head(hits)) : str_concat(fld-hit-line(head(hits)), str_concat("\n", fld-hit-lines(tail(hits))));
    // Paste this into free ChatGPT. It is the only free-ChatGPT joint
    // for a local folder: no new GPT, no Action, no disk reach.
    def fld-pack(ans) = str_concat("Form-native ground from a local folder.\n", str_concat("Speak ONLY from the hits. If grounded_status is miss, say the folder does not hold this yet. Do not invent. Cite paths.\n\n", str_concat("question: ", str_concat(fld-q(ans), str_concat("\ngrounded_status: ", str_concat(fld-status(ans), str_concat("\nhits:\n", str_concat(fld-hit-lines(fld-hits(ans)), "\n\nhonest_seam: The voice is ChatGPT. The ground is Form, from files on this machine.\n"))))))));
    def fld-dotdot?(s) = str_find(s, "..", 0) >= 0 ? 1 : 0;
    def fld-ext-ok?(name) = let(n, str_len(name), (n >= 4 ? (String) substring(name, n - 4, n) == ".txt" : 0) ? 1 : (n >= 3 ? (String) substring(name, n - 3, n) == ".md" : 0) ? 1 : (n >= 3 ? (String) substring(name, n - 3, n) == ".fk" : 0) ? 1 : (n >= 5 ? (String) substring(name, n - 5, n) == ".form" : 0) ? 1 : 0);
    def fld-demo-docs() = list(fld-doc("garden-notes.txt", list("tomato", "soil", "water", "garden", "seed"), "Tomatoes want warm soil and a steady drink."), fld-doc("travel.txt", list("train", "ticket", "paris", "travel"), "The morning train to Paris leaves at seven."), fld-doc("recipes.txt", list("bread", "flour", "salt", "water", "recipe"), "Bread is flour, water, salt, and time."));
    def fld-garden() = fld-ask("how do I water tomatoes in the garden", fld-demo-docs());
    def fld-miss-demo() = fld-ask("quantum chromodynamics", fld-demo-docs());
    def fldk(cond, bit) = cond ? bit : 0;
    def fld-check() = fldk((Comparable) len(fld-demo-docs()) == 3, 1) + fldk((String) fld-status(fld-garden()) == "hit", 2) + fldk((String) fld-path(head(fld-hits(fld-garden()))) == "garden-notes.txt", 4) + fldk((String) fld-status(fld-miss-demo()) == "miss", 8) + fldk((Comparable) len(fld-hits(fld-miss-demo())) == 0, 16) + fldk(str_find(fld-pack(fld-garden()), "garden-notes.txt", 0) >= 0, 32) + fldk(str_find(fld-pack(fld-garden()), "Speak ONLY from the hits", 0) >= 0, 64) + fldk(str_find(fld-pack(fld-garden()), "The voice is ChatGPT", 0) >= 0, 128) + fldk((Comparable) fld-dotdot?("../secret") == 1, 256) + fldk((Comparable) fld-ext-ok?("a.txt") == 1 && (Comparable) fld-ext-ok?("a.bin") == 0, 512);
    0;
}
