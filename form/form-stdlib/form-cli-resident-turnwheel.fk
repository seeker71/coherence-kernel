// form-cli-resident-turnwheel.fk -- one local Qwen residence, many isolated
// streams, and an op-tag program-image recipe door on every pinned epoch.
//
// A route is not a source function name and not a slot in fk_fn[]. It carries
// a dynamic symbol, structural NodeID, op-tag rows and root. `jonb-request`
// checks that identity, lowers/JITs the arriving image once, and retains it by
// NodeID outside fixed function seats. le-swap replaces that route at a revolution
// boundary.  A row already alive keeps its old (swap-seq, meaning-epoch) pin;
// a later row sees the newly arrived image.  No model context is reopened.
//
// The shared value holds the one q38 context (pipelines, scratch, mapped tensor
// views and weights).  Every prompt flow allocates only q38-new-state, so KV is
// isolated per request.  Prompt cursors advance in bounded quanta and yield to
// the wheel between quanta.  Decode commits exactly one pending token per turn.
// This is cooperative asynchronous progress: an external live channel can add
// rows between revolutions without rebuilding or restarting the residence.
//
// Outcome presence is structural. Integer 0 and integer 1 are present values,
// never resolver absence. Resolver nothing, choice, timeout,
// failure, cut and release remain separate status/events.
//
// The current source compiler still gives this startup adapter a legacy symbol
// closure. Newly received image symbols do not enlarge it: jonb walks them as
// data.  Closure measurements therefore expose the old membrane; they are not
// a design budget and never justify a static route table.
//
// preludes: form-stdlib/form-cli-model-session.fk
// preludes: form-stdlib/peer-epoch-lease.fk
// preludes: form-stdlib/jit-once-born.fk
// preludes: form-stdlib/form-cli-resident-turnwheel-native-bml.fk
section [form.bml] {
    // Every field can arrive as data after startup. The symbol is descriptive;
    // invocation authority is the verified structural NodeID.
    def fcrt-route(symbol, identity, program, root) = list("form-cli-resident-program-route-v1", symbol, identity, program, root);
    def fcrt-route?(r) = (Comparable) len(r) == 5 ? (String) nth(r, 0) == "form-cli-resident-program-route-v1" : 0;
    def fcrt-route-symbol(r) = nth(r, 1);
    def fcrt-route-identity(r) = nth(r, 2);
    def fcrt-route-program(r) = nth(r, 3);
    def fcrt-route-root(r) = nth(r, 4);
    def fcrt-unbound-route() = fcrt-route("", nothing(), empty(), 0);
    // route result = signal, present bit, raw value, receipt, reason, shared'.
    def fcrt-route-result(signal, present, value, receipt, reason, shared) = list("form-cli-resident-route-result-v1", signal, present, value, receipt, reason, shared);
    def fcrt-route-signal(r) = nth(r, 1);
    def fcrt-route-present?(r) = nth(r, 2);
    def fcrt-route-value(r) = nth(r, 3);
    def fcrt-route-receipt(r) = nth(r, 4);
    def fcrt-route-reason(r) = nth(r, 5);
    def fcrt-route-shared(r) = nth(r, 6);
    def fcrt-route-invoke(route, shared, value) = !fcrt-route?(route) ? fcrt-route-result("nothing", 0, nothing(), nothing(), "dynamic-program-route-absent", shared) : nothing?(fcrt-route-identity(route)) ? fcrt-route-result("nothing", 0, nothing(), nothing(), "dynamic-program-route-unbound", shared) : {
        let registry = fcrt-shared-registry(shared);
        let expected = jonb-identity(fcrt-route-program(route), fcrt-route-root(route), jonb-epoch(registry));
        !node_eq(expected, fcrt-route-identity(route)) ? fcrt-route-result("refused", 0, nothing(), list(fcrt-route-symbol(route), expected), "dynamic-program-nodeid-mismatch", shared) : {
            let moved = jonb-request(registry, fcrt-route-program(route), fcrt-route-root(route), value);
            let shared2 = fcrt-shared-with-registry(shared, nth(moved, 2));
            let receipt = list(fcrt-route-symbol(route), fcrt-route-identity(route), nth(moved, 1), nth(moved, 3));
            nothing?(nth(moved, 0)) ? fcrt-route-result("refused", 0, nothing(), receipt, "dynamic-program-op-refused", shared2) : fcrt-route-result("returned", 1, nth(moved, 0), receipt, "dynamic-program-nodeid-invoked", shared2);
        };
    };
    // One physical residence. `x` is the already loaded tokenizer crystal;
    // ctx is shared, while no stream state appears here.
    def fcrt-shared(path, src, ctx, x, maxpos, prefill-quanta, registry) = list("form-cli-resident-shared-v2", path, src, ctx, x, maxpos, prefill-quanta, registry, fcrtn-build());
    def fcrt-shared-path(s) = nth(s, 1);
    def fcrt-shared-src(s) = nth(s, 2);
    def fcrt-shared-ctx(s) = nth(s, 3);
    def fcrt-shared-x(s) = nth(s, 4);
    def fcrt-shared-maxpos(s) = nth(s, 5);
    def fcrt-shared-prefill-quanta(s) = nth(s, 6);
    def fcrt-shared-registry(s) = nth(s, 7);
    def fcrt-shared-bml-cache(s) = nth(s, 8);
    def fcrt-shared-with-registry(s, registry) = list("form-cli-resident-shared-v2", fcrt-shared-path(s), fcrt-shared-src(s), fcrt-shared-ctx(s), fcrt-shared-x(s), fcrt-shared-maxpos(s), fcrt-shared-prefill-quanta(s), registry, fcrt-shared-bml-cache(s));
    // flow phases: program, prefill, model, prefill-error, program-returned.
    def fcrt-flow(phase, payload, receipt) = list("form-cli-resident-flow-v1", phase, payload, receipt);
    def fcrt-flow-phase(f) = nth(f, 1);
    def fcrt-flow-payload(f) = nth(f, 2);
    def fcrt-flow-receipt(f) = nth(f, 3);
    def fcrt-program-flow(arg) = fcrt-flow(fcrtn-phase-program(), arg, nothing());
    def fcrt-model-flow(session, receipt) = fcrt-flow(fcrtn-phase-model(), session, receipt);
    // A stop token is terminal model state, not merely a row status. Keep that
    // fact in the carried fcms session so the next caller cannot mistake a
    // completed stream for a live pending prediction after the row releases.
    def fcrt-model-stop-session(session) = fcms-with-stream(session, fcms-pos(session), fcms-pending(session), 1, fcms-generated-ids(session), fcms-injected-ids(session), fcms-observations(session));
    def fcrt-model-stop-flow(session, receipt) = fcrt-model-flow(fcrt-model-stop-session(session), receipt);
    // prefill payload = sts cursor held pos prompt-count reason
    def fcrt-prefill-payload(sts, cursor, held, pos, count, reason) = list(sts, cursor, held, pos, count, reason);
    def fcrt-pf-sts(p) = nth(p, 0);
    def fcrt-pf-cursor(p) = nth(p, 1);
    def fcrt-pf-held(p) = nth(p, 2);
    def fcrt-pf-pos(p) = nth(p, 3);
    def fcrt-pf-count(p) = nth(p, 4);
    def fcrt-pf-reason(p) = nth(p, 5);
    // host result keeps the living host even when the requested act is nothing.
    def fcrt-act(signal, host, value, reason) = list("form-cli-resident-act-v1", signal, host, value, reason);
    def fcrt-act-signal(a) = nth(a, 1);
    def fcrt-act-host(a) = nth(a, 2);
    def fcrt-act-value(a) = nth(a, 3);
    def fcrt-act-reason(a) = nth(a, 4);
    // host wraps the leased wheel and an append-only event stream.
    def fcrt-host(lw, events) = list("form-cli-resident-turnwheel-v1", lw, events);
    def fcrt-lw(h) = nth(h, 1);
    def fcrt-events(h) = nth(h, 2);
    def fcrt-event(kind, id, detail) = list(kind, id, detail);
    def fcrt-with(h, lw, event) = fcrt-host(lw, append(fcrt-events(h), list(event)));
    // A resident row already advances one bounded prefill quantum or one model
    // token per revolution. Make that real transition visible where it occurs:
    // this frame contains only the row identity, phase, status, remaining gas,
    // and committed-token count — never prompt, source, recipe, model, or
    // generated bytes. `print_str` flushes it to a live Form reader and the
    // attributed NodeID remains available through this resident's framebuffer.
    def fcrt-stage-category() = intern_trivial_string("form-cli-resident-stage-v1");
    def fcrt-stage-node(row) = intern_node_at(fcrt-stage-category(), list(intern_trivial_int(wt-id(row)), intern_trivial_string(fcrt-flow-phase(wt-rstate(row))), intern_trivial_string(wt-status(row)), intern_trivial_int(wt-budget(row)), intern_trivial_int(len(wt-toks(row)))), "form-cli-resident-turnwheel.fk", 156, 1);
    def fcrt-stage-line(row) = {
        let a = str_concat("<|form:resident-stage|>\n", str_concat("id=", str_concat(int_to_str(wt-id(row)), "\n")));
        let b = str_concat(a, str_concat("phase=", str_concat(fcrt-flow-phase(wt-rstate(row)), "\n")));
        let c = str_concat(b, str_concat("status=", str_concat(wt-status(row), "\n")));
        let d = str_concat(c, str_concat("gas=", str_concat(int_to_str(wt-budget(row)), "\n")));
        str_concat(d, str_concat("tokens=", str_concat(int_to_str(len(wt-toks(row))), "\n<|/form:resident-stage|>\n")));
    };
    def fcrt-stage-write(row) = {
        let event = fcrt-stage-node(row);
        print_str(fcrt-stage-line(row));
        event;
    };
    // Construct around an already admitted context. This pure seam is also how
    // a resident process can receive its first route after startup.
    def fcrt-host-from-shared(shared, swap-seq, meaning, route) = {
        let eid = le-eid(swap-seq, meaning);
        let base = le-wheel(eid, route);
        fcrt-host(list(wt-wheel(empty(), shared), le-tbl(base), le-cur(base), le-ledger(base)), list(fcrt-event("residence", 0, eid)));
    };
    // An independently timed carrier waits for this correlated projection
    // before delivering an image. Inspection changes neither wheel nor gas.
    def fcrt-ready(host, exchange) = list("form-cli-resident-ready-v1", exchange, le-cur(fcrt-lw(host)), wt-live-count(wt-rows(le-w(fcrt-lw(host))), 0), len(fcrt-events(host)));
    // Adopt a live fcms seed without reopening its q38 context. qsx-load reads
    // tokenizer data once for future scannerless prompt cursors; weights stay in
    // the seed's existing ctx. The seed itself becomes one isolated model row.
    def fcrt-adopt(seed, swap-seq, meaning, route, prefill-quanta, id, budget, releaser) = !((Comparable) fcms-live?(seed) == 1) || budget <= 0 ? nothing() : {
        let shared = fcrt-shared(fcms-path(seed), fcms-src(seed), fcms-ctx(seed), qsx-load(fcms-path(seed)), fcms-maxpos(seed), prefill-quanta, jonb-registry(meaning));
        let host = fcrt-host-from-shared(shared, swap-seq, meaning, route);
        fcrt-enqueue-flow(host, id, fcrt-model-flow(seed, nothing()), budget, releaser);
    };
    // A policy host shares a live session's immutable model context, but owns
    // no model row and no KV state. It exists for JIT action selection only:
    // route publication can therefore retain the actual context identity
    // without a second q38-open, q38-new-state, tokenizer load, or release
    // obligation. The caller continues to own and advance `seed`.
    def fcrt-policy-host-from-session(seed, swap-seq, meaning, route, prefill-quanta) = !((Comparable) fcms-live?(seed) == 1) ? nothing() : fcrt-host-from-shared(fcrt-shared(fcms-path(seed), fcms-src(seed), fcms-ctx(seed), empty(), fcms-maxpos(seed), prefill-quanta, jonb-registry(meaning)), swap-seq, meaning, route);
    def fcrt-policy-host-shares-session?(host, seed) = nothing?(host) || !((Comparable) fcms-live?(seed) == 1) ? 0 : {
        let shared = wt-sctx(le-w(fcrt-lw(host)));
        (String) fcrt-shared-path(shared) == fcms-path(seed) && ((String) fcrt-shared-src(shared) == fcms-src(seed) && ((Comparable) ((Value) fcrt-shared-ctx(shared) == fcms-ctx(seed)) == 1 && ((Comparable) fcrt-shared-maxpos(shared) == fcms-maxpos(seed) && (Comparable) wt-live-count(wt-rows(le-w(fcrt-lw(host))), 0) == 0)));
    };
    def fcrt-enqueue-flow(host, id, flow, budget, releaser) = {
        let next = le-enqueue(fcrt-lw(host), id, flow, budget, releaser);
        nothing?(next) ? fcrt-act("nothing", host, nothing(), "nonpositive-gas-refused") : fcrt-act("value", {
            let host2 = fcrt-with(host, next, fcrt-event("enqueue", id, le-cur(next)));
            let row = wt-find(wt-rows(le-w(fcrt-lw(host2))), id);
            let _stage = fcrt-stage-write(row);
            host2;
        }, id, "row-pinned-at-enqueue");
    };
    def fcrt-accept-program(host, id, arg, budget, releaser) = fcrt-enqueue-flow(host, id, fcrt-program-flow(arg), budget, releaser);
    // Open a scannerless prompt cursor and allocate only this branch's KV.
    // The actual prefill happens later in bounded wheel turns.
    def fcrt-accept-prompt(host, id, prompt, budget, releaser) = budget <= 0 ? fcrt-act("nothing", host, nothing(), "nonpositive-gas-refused") : {
        let shared = wt-sctx(le-w(fcrt-lw(host)));
        let sts = q38-new-state(nth(fcrt-shared-ctx(shared), 2));
        !((Comparable) q38-state-ok?(sts) == 1) ? fcrt-act("failure", host, nothing(), "isolated-kv-state-allocation-refused") : {
            let cursor = fcmg-chat-cursor-profile(fcrt-shared-path(shared), prompt, "full", fcrt-shared-x(shared));
            let one = qtlc-next(cursor);
            !((Comparable) qtlc-next-present?(one) == 1) ? {
                let released = q38-free-state(sts);
                fcrt-act("nothing", host, released, qtlc-reason(qtlc-next-cursor(one)));
            } : fcrt-enqueue-flow(host, id, fcrt-flow(fcrtn-phase-prefill(), fcrt-prefill-payload(sts, qtlc-next-cursor(one), qtlc-next-value(one), 0, 1, "open"), nothing()), budget, releaser);
        };
    };
    // step outcome: signal/presence/value/flow/shared/receipt/reason.
    def fcrt-step-out(signal, present, value, flow, shared, receipt, reason) = list("form-cli-resident-step-v1", signal, present, value, flow, shared, receipt, reason);
    def fcrt-so-signal(o) = nth(o, 1);
    def fcrt-so-present?(o) = nth(o, 2);
    def fcrt-so-value(o) = nth(o, 3);
    def fcrt-so-flow(o) = nth(o, 4);
    def fcrt-so-shared(o) = nth(o, 5);
    def fcrt-so-receipt(o) = nth(o, 6);
    def fcrt-so-reason(o) = nth(o, 7);
    def fcrt-program-step(route, shared, flow) = {
        let invoked = fcrt-route-invoke(route, shared, fcrt-flow-payload(flow));
        (String) fcrt-route-signal(invoked) == "returned" ? fcrt-step-out("returned", fcrt-route-present?(invoked), fcrt-route-value(invoked), fcrt-flow(fcrtn-phase-returned(), fcrt-route-value(invoked), fcrt-route-receipt(invoked)), fcrt-route-shared(invoked), fcrt-route-receipt(invoked), fcrt-route-reason(invoked)) : fcrt-step-out(fcrt-route-signal(invoked), 0, nothing(), flow, fcrt-route-shared(invoked), fcrt-route-receipt(invoked), fcrt-route-reason(invoked));
    };
    // One bounded prompt quantum. A Metal batch is opened and settled inside
    // this turn; the next row can then progress. No recursive call spans more
    // than `left` prompt positions.
    def fcrt-prefill-go(shared, payload, left) = left <= 0 ? {
        metal_sync();
        fcrt-flow(fcrtn-phase-prefill(), payload, nothing());
    } : {
        let one = qtlc-next(fcrt-pf-cursor(payload));
        (Comparable) qtlc-next-present?(one) == 1 ? fcrt-pf-pos(payload) >= fcrt-shared-maxpos(shared) ? {
            metal_sync();
            fcrt-flow(fcrtn-phase-prefill-error(), fcrt-prefill-payload(fcrt-pf-sts(payload), qtlc-next-cursor(one), fcrt-pf-held(payload), fcrt-pf-pos(payload), fcrt-pf-count(payload), "prompt-context-window-refused"), nothing());
        } : {
            let ctx = fcrt-shared-ctx(shared);
            q38-forward-state-after(nth(ctx, 0), nth(ctx, 1), nth(ctx, 2), nth(ctx, 3), fcrt-pf-sts(payload), nth(ctx, 4), fcrt-pf-held(payload), fcrt-pf-pos(payload), 1);
            fcrt-prefill-go(shared, fcrt-prefill-payload(fcrt-pf-sts(payload), qtlc-next-cursor(one), qtlc-next-value(one), fcrt-pf-pos(payload) + 1, fcrt-pf-count(payload) + 1, "open"), left - 1);
        } : (String) qtlc-next-status(one) == "done" ? fcrt-pf-pos(payload) >= fcrt-shared-maxpos(shared) ? {
            metal_sync();
            fcrt-flow(fcrtn-phase-prefill-error(), fcrt-prefill-payload(fcrt-pf-sts(payload), qtlc-next-cursor(one), fcrt-pf-held(payload), fcrt-pf-pos(payload), fcrt-pf-count(payload), "prompt-context-window-refused"), nothing());
        } : {
            let ctx = fcrt-shared-ctx(shared);
            q38-forward-state-after(nth(ctx, 0), nth(ctx, 1), nth(ctx, 2), nth(ctx, 3), fcrt-pf-sts(payload), nth(ctx, 4), fcrt-pf-held(payload), fcrt-pf-pos(payload), 1);
            metal_sync();
            let first = q38-head-only(nth(ctx, 0), nth(ctx, 1), nth(ctx, 2), nth(ctx, 5), nth(ctx, 6));
            let pos = fcrt-pf-pos(payload) + 1;
            fcrt-model-flow(fcms-session("live", "prefill-complete", fcrt-shared-path(shared), fcrt-shared-src(shared), ctx, fcrt-pf-sts(payload), fcrt-shared-maxpos(shared), pos, first, 0, fcrt-pf-count(payload), 0, 0, 0), nothing());
        } : {
            metal_sync();
            fcrt-flow(fcrtn-phase-prefill-error(), fcrt-prefill-payload(fcrt-pf-sts(payload), qtlc-next-cursor(one), fcrt-pf-held(payload), fcrt-pf-pos(payload), fcrt-pf-count(payload), qtlc-reason(qtlc-next-cursor(one))), nothing());
        };
    };
    def fcrt-prefill-step(shared, flow) = {
        metal_batch_concurrent();
        let moved = fcrt-prefill-go(shared, fcrt-flow-payload(flow), fcrt-shared-prefill-quanta(shared));
        (String) fcrt-flow-phase(moved) == fcrtn-phase-prefill-error() ? fcrt-step-out("failure", 0, nothing(), moved, shared, nothing(), fcrt-pf-reason(fcrt-flow-payload(moved))) : fcrt-step-out("yield", 0, nothing(), moved, shared, nothing(), (String) fcrt-flow-phase(moved) == fcrtn-phase-model() ? "prefill-complete" : "prefill-quantum-complete");
    };
    // A dynamic program-image route is invoked before every model token. Its returned
    // value is retained in the flow receipt; terminal route signals steer the
    // row. A returned value does not silently rewrite token identity.
    def fcrt-model-step(route, shared, flow) = {
        let session = fcrt-flow-payload(flow);
        let pending = fcms-pending(session);
        let invoked = fcrt-route-invoke(route, shared, pending);
        !((String) fcrt-route-signal(invoked) == "returned") ? fcrt-step-out(fcrt-route-signal(invoked), 0, nothing(), flow, fcrt-route-shared(invoked), fcrt-route-receipt(invoked), fcrt-route-reason(invoked)) : pending < 0 ? fcrt-step-out("failure", 0, nothing(), flow, fcrt-route-shared(invoked), fcrt-route-receipt(invoked), "model-pending-id-negative") : {
            let stops = fcmg-q35-stops(fcms-src(session));
            (Comparable) q38-stop?(pending, stops) == 1 ? fcrt-step-out("done", 0, nothing(), fcrt-model-stop-flow(session, fcrt-route-receipt(invoked)), fcrt-route-shared(invoked), fcrt-route-receipt(invoked), "model-stop-token") : {
                let ctx = fcrt-shared-ctx(fcrt-route-shared(invoked));
                let next = q38-forward(nth(ctx, 0), nth(ctx, 1), nth(ctx, 2), nth(ctx, 3), fcms-sts(session), nth(ctx, 4), nth(ctx, 5), nth(ctx, 6), pending, fcms-pos(session));
                let session2 = fcms-with-stream(session, fcms-pos(session) + 1, next, next < 0 ? 1 : 0, fcms-generated-ids(session) + 1, fcms-injected-ids(session), fcms-observations(session));
                fcrt-step-out("value", 1, pending, fcrt-model-flow(session2, fcrt-route-receipt(invoked)), fcrt-route-shared(invoked), fcrt-route-receipt(invoked), "model-token-committed");
            };
        };
    };
    def fcrt-step(route, shared, flow) = (String) fcrt-flow-phase(flow) == fcrtn-phase-program() ? fcrt-program-step(route, shared, flow) : (String) fcrt-flow-phase(flow) == fcrtn-phase-prefill() ? fcrt-prefill-step(shared, flow) : (String) fcrt-flow-phase(flow) == fcrtn-phase-model() ? fcrt-model-step(route, shared, flow) : fcrt-step-out("failure", 0, nothing(), flow, shared, fcrt-flow-receipt(flow), "flow-phase-not-runnable");
    def fcrt-row-with(row, flow, budget, values, status) = append(wt-with(row, flow, budget, values, status), list(le-pin-of(row)));
    // The high-BML compiler decides which status settles a row.  Its source is
    // parsed only at resident birth; its NodeID image is born once in the
    // shared registry and every later call reaches the retained native page.
    // `undo` remains code 1 and therefore a control operation, not a terminal
    // stream status.  There is deliberately no source-text or Form-eval
    // compatibility route if the native page is unavailable.
    // terminal-call = status, terminal-bit, shared', route, reason.
    def fcrt-terminal-call(shared, signal) = {
        let cache = fcrt-shared-bml-cache(shared);
        let moved = fcrtn-invoke(cache, fcrt-shared-registry(shared), fcrtn-terminal-selector(), fcrtn-terminal-code(cache, signal));
        let shared2 = fcrt-shared-with-registry(shared, fcrtn-call-registry(moved));
        (String) fcrtn-call-status(moved) == "returned" ? list("form-cli-resident-terminal-call-v1", "returned", fcrtn-call-value(moved), shared2, fcrtn-call-route(moved), fcrtn-call-reason(moved)) : list("form-cli-resident-terminal-call-v1", "refused", 1, shared2, fcrtn-call-route(moved), fcrtn-call-reason(moved));
    };
    def fcrt-tc-status(result) = nth(result, 1);
    def fcrt-tc-terminal?(result) = nth(result, 2);
    def fcrt-tc-shared(result) = nth(result, 3);
    def fcrt-tc-route(result) = nth(result, 4);
    def fcrt-tc-reason(result) = nth(result, 5);
    // Custom revolution preserves returned-with-present-nothing and yield.
    // le-revolve's token-only ABI cannot state either one, so this joins the
    // same row/table/pin contract without collapsing their meaning.
    def fcrt-step-row-raw(table, shared, row) = (Comparable) wt-live?(row) == 0 ? list(row, shared, table, 0) : wt-budget(row) <= 0 ? list(fcrt-row-with(row, wt-rstate(row), 0, wt-toks(row), "timeout"), shared, le-bump(table, le-pin-of(row), -1), 1) : {
        let route = le-recipes(table, le-pin-of(row));
        nothing?(route) ? list(fcrt-row-with(row, wt-rstate(row), wt-budget(row), wt-toks(row), "dissolved-ground"), shared, table, 1) : {
            let moved = fcrt-step(route, shared, wt-rstate(row));
            let signal = fcrt-so-signal(moved);
            let values = (Comparable) fcrt-so-present?(moved) == 1 ? append(wt-toks(row), list(fcrt-so-value(moved))) : wt-toks(row);
            let gas = wt-budget(row) - 1;
            let terminal = fcrt-terminal-call(fcrt-so-shared(moved), signal);
            let settled-signal = (String) fcrt-tc-status(terminal) == "returned" ? signal : "refused";
            (Comparable) fcrt-tc-terminal?(terminal) == 1 ? list(fcrt-row-with(row, fcrt-so-flow(moved), gas, values, settled-signal), fcrt-tc-shared(terminal), le-bump(table, le-pin-of(row), -1), 1) : list(fcrt-row-with(row, fcrt-so-flow(moved), gas, values, "live"), fcrt-tc-shared(terminal), table, 0);
        };
    };
    // Both `fcrt-revolve` and the selected-row peer path use this one wrapper,
    // so neither can advance a resident row without emitting the same bounded
    // stage. A terminal row emits its terminal state once; an already closed row
    // emits nothing on later inspections.
    def fcrt-step-row(table, shared, row) = {
        let moved = fcrt-step-row-raw(table, shared, row);
        let _stage = (Comparable) wt-live?(row) == 1 ? fcrt-stage-write(nth(moved, 0)) : 0;
        moved;
    };
    def fcrt-rev-go(table, rows, shared, out, closed) = (Comparable) len(rows) == 0 ? list(reverse(out), shared, table, closed) : {
        let one = fcrt-step-row(table, shared, head(rows));
        fcrt-rev-go(nth(one, 2), tail(rows), nth(one, 1), cons(nth(one, 0), out), closed + nth(one, 3));
    };
    def fcrt-revolve(host) = {
        let lw = fcrt-lw(host);
        let moved = fcrt-rev-go(le-tbl(lw), wt-rows(le-w(lw)), wt-sctx(le-w(lw)), empty(), 0);
        let swept = le-sweep(nth(moved, 2), le-cur(lw), empty(), 0);
        let lw2 = list(wt-wheel(nth(moved, 0), nth(moved, 1)), nth(swept, 0), le-cur(lw), nth(swept, 1) > 0 ? append(le-ledger(lw), list(list("dissolved", nth(swept, 1)))) : le-ledger(lw));
        fcrt-with(host, lw2, fcrt-event("revolution", nth(moved, 3), nth(swept, 1)));
    };
    def fcrt-run(host, revolutions) = revolutions <= 0 ? host : (Comparable) wt-live-count(wt-rows(le-w(fcrt-lw(host))), 0) == 0 ? host : fcrt-run(fcrt-revolve(host), revolutions - 1);
    def fcrt-swap(host, swap-seq, meaning, route) = {
        let next = le-swap(fcrt-lw(host), swap-seq, meaning, route);
        nothing?(next) ? fcrt-act("nothing", host, nothing(), "epoch-pair-already-present") : fcrt-act("value", fcrt-with(host, next, fcrt-event("swap", swap-seq, le-eid(swap-seq, meaning))), le-eid(swap-seq, meaning), "dynamic-program-route-published");
    };
    // Publish is the correlated arrival door. It validates the supplied NodeID
    // against the arriving rows before moving the current epoch, so a malformed
    // file-poll offer cannot become the route merely because it arrived later.
    def fcrt-publish(host, swap-seq, meaning, route, exchange) = !fcrt-route?(route) ? fcrt-act("refused", host, nothing(), "dynamic-program-route-malformed") : {
        let shared = wt-sctx(le-w(fcrt-lw(host)));
        let expected = jonb-identity(fcrt-route-program(route), fcrt-route-root(route), jonb-epoch(fcrt-shared-registry(shared)));
        nothing?(fcrt-route-identity(route)) || !node_eq(expected, fcrt-route-identity(route)) ? fcrt-act("refused", host, nothing(), "dynamic-program-nodeid-mismatch") : {
            let moved = fcrt-swap(host, swap-seq, meaning, route);
            !((String) fcrt-act-signal(moved) == "value") ? moved : fcrt-act("value", fcrt-with(fcrt-act-host(moved), fcrt-lw(fcrt-act-host(moved)), fcrt-event("publish", exchange, fcrt-route-identity(route))), fcrt-act-value(moved), "correlated-dynamic-program-published");
        };
    };
    // Cut returns both the caller-owned releaser and the flow whose KV state is
    // now eligible for explicit release. Nothing is freed behind the caller.
    def fcrt-cut(host, id) = {
        let before = wt-find(wt-rows(le-w(fcrt-lw(host))), id);
        let cut = le-cut(fcrt-lw(host), id);
        list(fcrt-with(host, nth(cut, 0), fcrt-event("cut", id, nothing?(before) ? 0 : 1)), nth(cut, 1), nothing?(before) ? nothing() : wt-rstate(before));
    };
    def fcrt-undo-of(host, id) = le-replay-of(fcrt-lw(host), id);
    def fcrt-flow-sts(flow) = (String) fcrt-flow-phase(flow) == fcrtn-phase-model() ? fcms-sts(fcrt-flow-payload(flow)) : (String) fcrt-flow-phase(flow) == fcrtn-phase-prefill() || (String) fcrt-flow-phase(flow) == fcrtn-phase-prefill-error() ? fcrt-pf-sts(fcrt-flow-payload(flow)) : nothing();
    def fcrt-release-flow(flow) = {
        let sts = fcrt-flow-sts(flow);
        nothing?(sts) ? 0 : q38-free-state(sts);
    };
    def fcrt-close-shared(host) = q38-close(fcrt-shared-ctx(wt-sctx(le-w(fcrt-lw(host)))), empty());
    0;
}
