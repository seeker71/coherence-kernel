; application-graph-node-port-pg.fk — the Postgres door for the application
; graph node carrier, split out of application-graph-node-port.fk 2026-08-28.
;
; preludes: form-stdlib/core.fk form-stdlib/application-graph-node-port.fk
;
; WHY THIS IS ITS OWN CELL. agn-create-node / agn-update-node / agn-delete-node
; are the only three things in the application graph carrier that reach
; pg_exec, and pg_exec is native on go / rust / ts and ABSENT on fkwu. Because
; they were named inside application-graph-node-port.fk, every chain that
; preluded that cell inherited the absence as three unresolved calls — and fkwu
; resolves every call site in a whole prelude chain while go / rust / ts bind
; lazily on execution, so a band that never reaches the door still walled on the
; fourth arm. Measured 2026-08-28 before this split:
; tests/application-graph-node-port-band.fk answered 1111 on all four arms and
; still reported fourth-rc=1 diagnostics=3 — a right number carried out of a
; divergent verdict by three calls the band never makes.
;
; The SQL builders — agn-create-node-sql / agn-update-node-sql /
; agn-delete-node-sql, and the escaping and contains? helpers around them — ask
; only for str_concat and substring, which every arm has. So the pure algebra
; stays in application-graph-node-port.fk where anyone can hold it, and the
; live carrier moves here where only its real callers reach for it.
;
; This is the repair cache-binary.fk made for read_form_binary /
; write_form_binary on 2026-08-14 and symbols-wire.fk made for recipe_to_bytes /
; bytes_to_recipe on 2026-08-28, made once at the source instead of once per
; consumer: a cell should not hand its callers a door they did not ask for and
; cannot open on their own arm. The door is not smaller — it is where its
; callers reach for it.
;
; Callers today: form-stdlib/native-mutation-route-side-effects-pg.fk,
; form-stdlib/native-idea-valuation-audit-ledger-pg.fk,
; form-stdlib/integration/application-graph-live-db.fk, and the routers/ mirror
; routers/native-mutation-route-side-effects.fk.

(do
    ;; (agn-create-node conn ...) → conn. Writes graph_nodes + the first
    ;; graph_node_revisions row in one statement. Answers conn so a route
    ;; runner can thread it.
    (defn agn-create-node (conn revision-id id node-type name description phase properties source author)
        (do
            (pg_exec conn (agn-create-node-sql revision-id id node-type name description phase properties source author))
            conn))

    ;; (agn-update-node conn ...) → conn. Updates graph_nodes and appends the
    ;; next per-node revision.
    (defn agn-update-node (conn revision-id id name description phase property-patch fields-changed source author)
        (do
            (pg_exec conn (agn-update-node-sql revision-id id name description phase property-patch fields-changed source author))
            conn))

    ;; (agn-delete-node conn id) → conn. Clears graph_edges before graph_nodes.
    (defn agn-delete-node (conn id)
        (do
            (pg_exec conn (agn-delete-node-sql id))
            conn))

    0)
