; genekey-profile.fk — the Gene Keys hologenetic profile, cast natively from a birth-moment.
;
; The Golden Path profile reads eleven spheres, each a body placed on the rave mandala
; wheel — the same 64 cells iching-channel.fk holds in three tongues. What this cell adds
; over chart-cast.fk is the two things a profile needs that a date alone cannot give:
;
;   1. the CLOCK — the spheres live on gate LINES (0.9375 deg, ~22 hours of Sun), so the
;      longitudes here ride a fractional day n, not the noon JDN. The whole ephemeris
;      stack already computes from float n; this cell just stops truncating it.
;   2. the DESIGN MOMENT — the second column of the profile is the sky ~88 days before
;      birth, when the Sun sat exactly 88 deg of arc behind its natal place. A short
;      Newton walk on the mean solar rate finds that moment to the minute.
;
; The sphere -> body correlations are ATTESTED (genekeys.com, "What planets does each
; Sphere of the Golden Path Profile correlate to"): natal Sun (Life's Work), natal Earth
; (Evolution), design Sun (Radiance), design Earth (Purpose), design Moon (Attraction),
; natal Venus (IQ), natal Mars (EQ), design Venus (SQ), design Mars (Core/Vocation),
; design Jupiter (Culture), natal Jupiter (Pearl).
;
;   (hgp-profile y m d uth utm) -> the eleven spheres for a UT birth-moment, each a
;                                  tuple (sphere-name, gate, line, ecliptic-longitude)
;   (hgp-design-n nb)           -> the design moment (days from J2000, fractional)
;   (hgp-line lon)              -> the line 1..6 at an ecliptic longitude
;
; Honest floor: longitudes carry the stack's own accuracy — Sun ~0.01 deg, Moon ~0.2 deg,
; Kepler planets a few 0.1 deg. Gates (5.625 deg) are solid at that floor; LINES are solid
; for Sun/Earth and indicative for Moon and the planets — a body within its error of a
; line boundary may sit on the neighbouring line. The read stays in the symbolic /
; direct-experience lane (cross-domain-cornerstone.fk): the cast is the edge-set, the
; meaning stays human.
;
; preludes: form-stdlib/core.fk form-stdlib/guidance-channel.fk form-stdlib/celestial-pole-channel.fk form-stdlib/trig.fk form-stdlib/ephemeris-sun.fk form-stdlib/ephemeris-moon.fk form-stdlib/ephemeris-nodes.fk form-stdlib/ephemeris-planets.fk form-stdlib/iching-channel.fk form-stdlib/hd-mandala-wheel.fk
;

(do
    ;; days from J2000 at an exact UT clock-moment. jdn is the noon JDN, so the clock
    ;; offsets around noon: 12:00 UT adds 0.0, 08:15 UT adds -0.15625.
    (defn hgp-n (y m d uth utm)
        (add (mul (sub (jdn y m d) 2451545) 1.0)
             (div (sub (add (mul uth 1.0) (div (mul utm 1.0) 60.0)) 12.0) 24.0)))

    ;; each body's ecliptic longitude at a fractional day n (float deg, [0,360))
    (defn hgp-sun (nf)   (fnorm360 (sun-longitude-raw nf)))
    (defn hgp-earth (nf) (fnorm360 (add (sun-longitude-raw nf) 180.0)))
    (defn hgp-moon (nf)  (fnorm360 (moon-longitude-raw nf)))

    ;; a frame seam, found by an independent witness (pyephem, 1971 cross-check):
    ;; ephemeris-planets.fk speaks in the fixed J2000 ecliptic (the Standish elements'
    ;; frame), while ephemeris-sun/moon speak ecliptic-OF-DATE — the tropical zodiac the
    ;; wheel reads. Invisible at the 2000-era band dates, ~0.4 deg by 1971: enough to
    ;; move a line. The fold home is general precession in longitude, 50.29 arcsec/yr
    ;; (IAU) = 0.000038246 deg/day, signed by nf itself.
    (defn hgp-of-date (lon nf) (fnorm360 (add lon (mul 0.000038246 nf))))
    (defn hgp-planet (els nf) (hgp-of-date (planet-geo-lon els (div nf 36525.0)) nf))

    ;; the design moment: the Sun exactly 88 deg of arc before its natal place.
    ;; Newton on the mean solar rate (0.9856 deg/day), a fixed handful of steps —
    ;; each step folds the remaining arc to (-180,180] and walks it off.
    (defn hgp-design-iter (target nf k)
        (if (eq k 0) nf
            (hgp-design-iter target
                (add nf (div (deg-norm180 (sub target (hgp-sun nf))) 0.9856))
                (sub k 1))))
    (defn hgp-design-n (nb)
        (hgp-design-iter (fnorm360 (sub (hgp-sun nb) 88.0)) (sub nb 89.3) 6))

    ;; the line: six lines of 0.9375 deg inside each 5.625-deg gate, floored on the
    ;; full-float longitude like the gate itself (hd-mandala-wheel.fk).
    (defn hgp-line (lon)
        (add 1 (mod (floor (div (fnorm360 (sub lon 358.25)) 0.9375)) 6)))

    ;; a sphere: (name, gate, line, longitude) — an edge, chart-cast.fk's deepest line
    (defn hgp-sphere (name lon) (list name (gate-at-longitude lon) (hgp-line lon) lon))
    (defn hgp-sphere-name (s) (nth s 0))
    (defn hgp-sphere-gate (s) (nth s 1))
    (defn hgp-sphere-line (s) (nth s 2))
    (defn hgp-sphere-lon  (s) (nth s 3))

    ;; the eleven spheres of the Golden Path, natal column then design column
    (defn hgp-profile (y m d uth utm)
        (do
            (let nb (hgp-n y m d uth utm))
            (let nd (hgp-design-n nb))
            (list
                (hgp-sphere "Life's Work" (hgp-sun nb))
                (hgp-sphere "Evolution"   (hgp-earth nb))
                (hgp-sphere "Radiance"    (hgp-sun nd))
                (hgp-sphere "Purpose"     (hgp-earth nd))
                (hgp-sphere "Attraction"  (hgp-moon nd))
                (hgp-sphere "IQ"          (hgp-planet (venus-elements) nb))
                (hgp-sphere "EQ"          (hgp-planet (mars-elements) nb))
                (hgp-sphere "SQ"          (hgp-planet (venus-elements) nd))
                (hgp-sphere "Core"        (hgp-planet (mars-elements) nd))
                (hgp-sphere "Culture"     (hgp-planet (jupiter-elements) nd))
                (hgp-sphere "Pearl"       (hgp-planet (jupiter-elements) nb)))))

    (defn genekey-profile-teaching () "lc-cross-modal-unity")

    0)
