; living-world-intention-graph.fk -- exact action deltas may form local paths.
;
; This graph owns no action names, task taxonomy, workflow, or ordering table.
; Its only structural adjacency predicate is observed identity: the `after`
; cell of one current integrated action execution equals the `before` cell of
; another. Participants still offer observations of that seam through all four
; acknowledgment arms, explicit alternatives, and optional unknowable tissue.
;
; Recurrence may propose an edge, but every support, inverse observation,
; dissent, silence, alternative, unresolved response, and both execution-holder
; sets govern its separate unanimous admission. Plans traverse only current
; admitted edges from an exact offered start. No outgoing edge may STOP; several
; may BRANCH; revisiting a node is CYCLE; reaching the end of the offered node
; field uniquely is READY. No NodeID, list order, majority, or default chooses.
;
; witnessed: 2026-08-07 -> edge/plan 32767 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk

(let LWIG-OBSERVATION  (bp "LWIG-OBSERVATION"))
(let LWIG-EVIDENCE     (bp "LWIG-EVIDENCE"))
(let LWIG-EVIDENCE-SET (bp "LWIG-EVIDENCE-SET"))
(let LWIG-EDGE         (bp "LWIG-EDGE"))
(let LWIG-EDGE-ORIGIN  (bp "LWIG-EDGE-ORIGIN"))
(let LWIG-GROUP        (bp "LWIG-GROUP"))
(let LWIG-SEQUENCE     (bp "LWIG-SEQUENCE"))
(let LWIG-PLAN         (bp "LWIG-PLAN"))
(let LWIG-READY        (bp "LWIG-READY"))
(let LWIG-BRANCH       (bp "LWIG-BRANCH"))
(let LWIG-STOP         (bp "LWIG-STOP"))
(let LWIG-CYCLE        (bp "LWIG-CYCLE"))

(defn lwig-status (kind) (intern_node kind (empty)))
(defn lwig-ready () (lwig-status LWIG-READY))
(defn lwig-branch () (lwig-status LWIG-BRANCH))
(defn lwig-stop () (lwig-status LWIG-STOP))
(defn lwig-cycle () (lwig-status LWIG-CYCLE))
(defn lwig-ready? (status) (if (node_eq status (lwig-ready)) 1 0))
(defn lwig-branch? (status) (if (node_eq status (lwig-branch)) 1 0))
(defn lwig-stop? (status) (if (node_eq status (lwig-stop)) 1 0))
(defn lwig-cycle? (status) (if (node_eq status (lwig-cycle)) 1 0))

; children: left/right current execution candidates, acknowledgment,
; alternatives, optional unknown, evidence, local path
(defn lwig-observation
    (left right ack alternatives unknown evidence)
    (intern_node LWIG-OBSERVATION
        (list left right ack alternatives unknown evidence
              (lwo-local-path))))
(defn lwig-observation? (cell) (lwo-category? cell LWIG-OBSERVATION))
(defn lwig-observation-left (observation) (nth (node_children observation) 0))
(defn lwig-observation-right (observation) (nth (node_children observation) 1))
(defn lwig-observation-ack (observation) (nth (node_children observation) 2))
(defn lwig-observation-alternatives (observation)
    (nth (node_children observation) 3))
(defn lwig-observation-unknown (observation)
    (nth (node_children observation) 4))
(defn lwig-observation-evidence (observation)
    (nth (node_children observation) 5))
(defn lwig-observation-path (observation) (nth (node_children observation) 6))

(defn lwig-observation-valid? (observation)
    (if (eq (lwig-observation? observation) 0) 0
        (if (eq (lwac-execution-candidate?
                    (lwig-observation-left observation)) 0) 0
            (if (eq (lwac-execution-candidate?
                        (lwig-observation-right observation)) 0) 0
                (if (node_eq (lwig-observation-left observation)
                             (lwig-observation-right observation)) 0
                    (if (eq (oac-valid-ack?
                                (lwig-observation-ack observation)) 0) 0
                        (if (eq (lwo-category?
                                    (lwig-observation-alternatives observation)
                                    LWO-FIELD) 0) 0
                            (lwac-optional-unknown-valid?
                                (lwig-observation-unknown observation)))))))))

(defn lwig-execution-delta (candidate)
    (lwac-execution-actual (lwo-emergent-shape candidate)))
(defn lwig-continuous? (left right)
    (if (node_eq
            (lwac-delta-after (lwig-execution-delta left))
            (lwac-delta-before (lwig-execution-delta right))) 1 0))
(defn lwig-endpoints-current? (world left right)
    (if (and (eq (lwac-execution-integrated-current? world left) 1)
             (eq (lwac-execution-integrated-current? world right) 1)) 1 0))

(defn lwig-exact-direction? (observation left right)
    (if (and (node_eq (lwig-observation-left observation) left)
             (node_eq (lwig-observation-right observation) right)) 1 0))
(defn lwig-inverse-direction? (observation left right)
    (if (and (node_eq (lwig-observation-left observation) right)
             (node_eq (lwig-observation-right observation) left)) 1 0))
(defn lwig-same-pair? (observation left right)
    (if (or (eq (lwig-exact-direction? observation left right) 1)
            (eq (lwig-inverse-direction? observation left right) 1)) 1 0))

; children: observation, all active attribution witnesses
(defn lwig-evidence (observation attributions)
    (intern_node LWIG-EVIDENCE (list observation attributions)))
(defn lwig-evidence-observation (evidence) (nth (node_children evidence) 0))
(defn lwig-evidence-attributions (evidence) (nth (node_children evidence) 1))

; children: supports, alternatives, dissents, silences, unresolved
(defn lwig-evidence-set (supports alternatives dissents silences unresolved)
    (intern_node LWIG-EVIDENCE-SET
        (list supports alternatives dissents silences unresolved)))
(defn lwig-evidence-set? (cell) (lwo-category? cell LWIG-EVIDENCE-SET))
(defn lwig-evidence-supports (set) (nth (node_children set) 0))
(defn lwig-evidence-alternatives (set) (nth (node_children set) 1))
(defn lwig-evidence-dissents (set) (nth (node_children set) 2))
(defn lwig-evidence-silences (set) (nth (node_children set) 3))
(defn lwig-evidence-unresolved (set) (nth (node_children set) 4))

(defn lwig-classify-evidence
    (observation evidence left right supports alternatives dissents silences
     unresolved)
    (do
        (let ack (lwig-observation-ack observation))
        (if (eq (oac-one? ack) 1)
            (if (eq (lwig-exact-direction? observation left right) 1)
                (lwig-evidence-set (lwo-field-add supports evidence)
                    alternatives dissents silences unresolved)
                (lwig-evidence-set supports
                    (lwo-field-add alternatives evidence)
                    dissents silences unresolved))
            (if (eq (oac-zero? ack) 1)
                (lwig-evidence-set supports alternatives
                    (lwo-field-add dissents evidence) silences unresolved)
                (if (eq (oac-nothing? ack) 1)
                    (lwig-evidence-set supports alternatives dissents
                        (lwo-field-add silences evidence) unresolved)
                    (if (eq (oac-alternative-ack? ack) 1)
                        (lwig-evidence-set supports
                            (lwo-field-add alternatives evidence)
                            dissents silences unresolved)
                        (lwig-evidence-set supports alternatives dissents
                            silences (lwo-field-add unresolved evidence))))))))

(defn lwig-collect-evidence
    (world items left right supports alternatives dissents silences unresolved)
    (if (eq (len items) 0)
        (lwig-evidence-set supports alternatives dissents silences unresolved)
        (do
            (let observation (head items))
            (if (eq (lwig-observation-valid? observation) 0)
                (lwig-collect-evidence world (tail items) left right
                    supports alternatives dissents silences unresolved)
                (if (eq (lwig-same-pair? observation left right) 0)
                    (lwig-collect-evidence world (tail items) left right
                        supports alternatives dissents silences unresolved)
                    (if (eq (lwo-active? world observation) 0)
                        (lwig-collect-evidence world (tail items) left right
                            supports alternatives dissents silences unresolved)
                        (do
                            (let classified
                                (lwig-classify-evidence observation
                                    (lwig-evidence observation
                                        (lwo-active-attributions-for
                                            world observation))
                                    left right supports alternatives dissents
                                    silences unresolved))
                            (lwig-collect-evidence world (tail items) left right
                                (lwig-evidence-supports classified)
                                (lwig-evidence-alternatives classified)
                                (lwig-evidence-dissents classified)
                                (lwig-evidence-silences classified)
                                (lwig-evidence-unresolved classified)))))))))

(defn lwig-evidence-for (world left right)
    (lwig-collect-evidence world
        (lwo-field-items (lwo-world-cells world)) left right
        (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)
        (lwo-empty-field) (lwo-empty-field)))

(defn lwig-attribution-count-items (items count)
    (if (eq (len items) 0) count
        (lwig-attribution-count-items (tail items)
            (add count
                (lwo-field-size
                    (lwig-evidence-attributions (head items)))))))
(defn lwig-attribution-count (field)
    (lwig-attribution-count-items (lwo-field-items field) 0))
(defn lwig-support-count (set)
    (lwig-attribution-count (lwig-evidence-supports set)))

(defn lwig-evidence-witness-items (items field)
    (if (eq (len items) 0) field
        (lwig-evidence-witness-items (tail items)
            (lwac-field-union-items
                (lwo-field-items
                    (lwig-evidence-attributions (head items))) field))))
(defn lwig-evidence-witnesses (set)
    (do
        (let supports
            (lwig-evidence-witness-items
                (lwo-field-items (lwig-evidence-supports set))
                (lwo-empty-field)))
        (let alternatives
            (lwig-evidence-witness-items
                (lwo-field-items (lwig-evidence-alternatives set)) supports))
        (let dissents
            (lwig-evidence-witness-items
                (lwo-field-items (lwig-evidence-dissents set)) alternatives))
        (let silences
            (lwig-evidence-witness-items
                (lwo-field-items (lwig-evidence-silences set)) dissents))
        (lwig-evidence-witness-items
            (lwo-field-items (lwig-evidence-unresolved set)) silences)))

(defn lwig-edge-witnesses (world left right evidence)
    (do
        (let with-evidence (lwig-evidence-witnesses evidence))
        (let with-left
            (lwac-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world left))
                with-evidence))
        (lwac-field-union-items
            (lwo-field-items
                (lwo-active-attributions-for world right)) with-left)))

; children: directional execution candidates, exact evidence, local path
(defn lwig-edge (left right evidence)
    (intern_node LWIG-EDGE
        (list left right evidence (lwo-local-path))))
(defn lwig-edge? (cell) (lwo-category? cell LWIG-EDGE))
(defn lwig-edge-left (edge) (nth (node_children edge) 0))
(defn lwig-edge-right (edge) (nth (node_children edge) 1))
(defn lwig-edge-evidence (edge) (nth (node_children edge) 2))
(defn lwig-edge-path (edge) (nth (node_children edge) 3))

(defn lwig-edge-origin (left right evidence threshold)
    (intern_node LWIG-EDGE-ORIGIN
        (list left right evidence (intern_trivial_int threshold)
              (lwo-local-path))))

(defn lwig-edge-proposal (world observation threshold)
    (if (eq (lwig-observation-valid? observation) 0) (lwo-none)
        (if (eq (oac-one? (lwig-observation-ack observation)) 0)
            (lwo-none)
            (if (eq (lwo-active? world observation) 0) (lwo-none)
                (do
                    (let left (lwig-observation-left observation))
                    (let right (lwig-observation-right observation))
                    (if (eq (lwig-endpoints-current? world left right) 0)
                        (lwo-none)
                        (if (eq (lwig-continuous? left right) 0) (lwo-none)
                            (do
                                (let evidence
                                    (lwig-evidence-for world left right))
                                (if (lt (lwig-support-count evidence) threshold)
                                    (lwo-none)
                                    (do
                                        (let edge
                                            (lwig-edge left right evidence))
                                        (let witnesses
                                            (lwig-edge-witnesses
                                                world left right evidence))
                                        (let origin
                                            (lwig-edge-origin left right
                                                evidence threshold))
                                        (let candidate
                                            (lwo-emergent edge witnesses
                                                (intern_trivial_int
                                                    (lwig-support-count evidence))
                                                (intern_trivial_int
                                                    (lwo-field-size witnesses))
                                                (intern_trivial_int threshold)
                                                origin))
                                        (lwt-proposal candidate
                                            (lwt-sources-from-attributions
                                                (lwo-field-items witnesses)
                                                (lwo-empty-field))
                                            origin)))))))))))

(defn lwig-edge-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwig-edge? (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwig-edge-candidate-current? (world candidate)
    (if (eq (lwig-edge-candidate? candidate) 0) 0
        (do
            (let edge (lwo-emergent-shape candidate))
            (let left (lwig-edge-left edge))
            (let right (lwig-edge-right edge))
            (if (eq (lwig-endpoints-current? world left right) 0) 0
                (if (eq (lwig-continuous? left right) 0) 0
                    (do
                        (let evidence (lwig-evidence-for world left right))
                        (let witnesses
                            (lwig-edge-witnesses world left right evidence))
                        (if (node_eq evidence (lwig-edge-evidence edge))
                            (if (node_eq witnesses
                                    (lwo-emergent-witnesses candidate))
                                (if (eq (lwig-support-count evidence)
                                         (lwo-emergent-coherence candidate))
                                    (if (ge (lwig-support-count evidence)
                                             (lwo-emergent-threshold candidate))
                                        1 0)
                                    0)
                                0)
                            0)))))))
(defn lwig-edge-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwig-edge-candidate-current? world candidate) 1)) 1 0))
(defn lwig-edge-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwig-edge-candidate-current? world
            (lwt-proposal-candidate proposal))))
(defn lwig-edge-integrate (round proposal action)
    (if (eq (lwig-edge-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; --- bounded graph observation ------------------------------------------

(defn lwig-all-nodes-current? (world items)
    (if (eq (len items) 0) 1
        (if (eq (lwac-execution-integrated-current?
                    world (head items)) 1)
            (lwig-all-nodes-current? world (tail items)) 0)))
(defn lwig-edge-in-nodes? (edge nodes)
    (if (and (eq (lwo-field-has? nodes (lwig-edge-left edge)) 1)
             (eq (lwo-field-has? nodes (lwig-edge-right edge)) 1)) 1 0))
(defn lwig-collect-edges (world items nodes field)
    (if (eq (len items) 0) field
        (do
            (let candidate (head items))
            (if (eq (lwig-edge-candidate? candidate) 0)
                (lwig-collect-edges world (tail items) nodes field)
                (if (eq (lwig-edge-in-nodes?
                            (lwo-emergent-shape candidate) nodes) 0)
                    (lwig-collect-edges world (tail items) nodes field)
                    (if (eq (lwig-edge-integrated-current?
                                world candidate) 0)
                        (lwig-collect-edges world (tail items) nodes field)
                        (lwig-collect-edges world (tail items) nodes
                            (lwo-field-add field candidate))))))))

(defn lwig-observation-in-nodes? (observation nodes)
    (if (and (eq (lwo-field-has? nodes
                       (lwig-observation-left observation)) 1)
             (eq (lwo-field-has? nodes
                       (lwig-observation-right observation)) 1)) 1 0))
(defn lwig-collect-observations (world items nodes field)
    (if (eq (len items) 0) field
        (do
            (let observation (head items))
            (if (eq (lwig-observation-valid? observation) 0)
                (lwig-collect-observations world (tail items) nodes field)
                (if (eq (lwig-observation-in-nodes?
                            observation nodes) 0)
                    (lwig-collect-observations world (tail items) nodes field)
                    (if (eq (lwo-active? world observation) 0)
                        (lwig-collect-observations world (tail items)
                            nodes field)
                        (lwig-collect-observations world (tail items) nodes
                            (lwo-field-add field observation))))))))

(defn lwig-observation-alternatives-items (items field)
    (if (eq (len items) 0) field
        (do
            (let observation (head items))
            (let with-explicit
                (lwac-field-union-items
                    (lwo-field-items
                        (lwig-observation-alternatives observation)) field))
            (let ack (lwig-observation-ack observation))
            (lwig-observation-alternatives-items (tail items)
                (if (eq (oac-alternative-ack? ack) 1)
                    (lwo-field-add with-explicit
                        (oac-alternative-offered (oac-payload ack)))
                    with-explicit)))))
(defn lwig-observation-unknowns-items (items field)
    (if (eq (len items) 0) field
        (do
            (let unknown (lwig-observation-unknown (head items)))
            (lwig-observation-unknowns-items (tail items)
                (if (node_eq unknown (lwo-none)) field
                    (lwo-field-add field unknown))))))
(defn lwig-observation-witnesses-items (world items field)
    (if (eq (len items) 0) field
        (lwig-observation-witnesses-items world (tail items)
            (lwac-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world (head items)))
                field))))
(defn lwig-payload-witnesses-items (world items field)
    (if (eq (len items) 0) field
        (lwig-payload-witnesses-items world (tail items)
            (lwac-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world (head items)))
                field))))

; children: exact execution nodes, current admitted edges, all current graph
; observations, explicit alternatives, offered unknowns, witnesses, local path
(defn lwig-group
    (nodes edges observations alternatives unknowns witnesses)
    (intern_node LWIG-GROUP
        (list nodes edges observations alternatives unknowns witnesses
              (lwo-local-path))))
(defn lwig-group? (cell) (lwo-category? cell LWIG-GROUP))
(defn lwig-group-nodes (group) (nth (node_children group) 0))
(defn lwig-group-edges (group) (nth (node_children group) 1))
(defn lwig-group-observations (group) (nth (node_children group) 2))
(defn lwig-group-alternatives (group) (nth (node_children group) 3))
(defn lwig-group-unknowns (group) (nth (node_children group) 4))
(defn lwig-group-witnesses (group) (nth (node_children group) 5))
(defn lwig-group-path (group) (nth (node_children group) 6))

(defn lwig-group-for (world nodes)
    (if (or (eq (lwo-category? nodes LWO-FIELD) 0)
            (or (eq (lwo-field-size nodes) 0)
                (eq (lwig-all-nodes-current?
                       world (lwo-field-items nodes)) 0)))
        (lwo-none)
        (do
            (let world-items (lwo-field-items (lwo-world-cells world)))
            (let edges
                (lwig-collect-edges world world-items nodes
                    (lwo-empty-field)))
            (let observations
                (lwig-collect-observations world world-items nodes
                    (lwo-empty-field)))
            (let observation-items (lwo-field-items observations))
            (let node-witnesses
                (lwig-payload-witnesses-items world
                    (lwo-field-items nodes) (lwo-empty-field)))
            (let edge-witnesses
                (lwig-payload-witnesses-items world
                    (lwo-field-items edges) node-witnesses))
            (let witnesses
                (lwig-observation-witnesses-items world observation-items
                    edge-witnesses))
            (lwig-group nodes edges observations
                (lwig-observation-alternatives-items observation-items
                    (lwo-empty-field))
                (lwig-observation-unknowns-items observation-items
                    (lwo-empty-field))
                witnesses))))

(defn lwig-sequence (items) (intern_node LWIG-SEQUENCE items))
(defn lwig-sequence? (cell) (lwo-category? cell LWIG-SEQUENCE))
(defn lwig-sequence-items (sequence) (node_children sequence))

(defn lwig-outgoing-items (items current field)
    (if (eq (len items) 0) field
        (do
            (let candidate (head items))
            (let edge (lwo-emergent-shape candidate))
            (lwig-outgoing-items (tail items) current
                (if (node_eq (lwig-edge-left edge) current)
                    (lwo-field-add field candidate) field)))))
(defn lwig-stops-items (items current field)
    (if (eq (len items) 0) field
        (do
            (let observation (head items))
            (lwig-stops-items (tail items) current
                (if (and (node_eq
                              (lwig-observation-left observation) current)
                         (eq (oac-nothing?
                              (lwig-observation-ack observation)) 1))
                    (lwo-field-add field observation) field)))))
(defn lwig-remove-node (items wanted)
    (if (eq (len items) 0) (empty)
        (if (node_eq (head items) wanted)
            (lwig-remove-node (tail items) wanted)
            (cons (head items)
                (lwig-remove-node (tail items) wanted)))))

; children: group, exact start, ordered sequence, remaining nodes, status,
; alternatives, optional derived unknown, local stop observations, evidence,
; local path
(defn lwig-plan-cell
    (group start ordered remaining status alternatives unknown stops evidence)
    (intern_node LWIG-PLAN
        (list group start (lwig-sequence ordered) remaining status alternatives
              unknown stops evidence (lwo-local-path))))
(defn lwig-plan? (cell) (lwo-category? cell LWIG-PLAN))
(defn lwig-plan-group (plan) (nth (node_children plan) 0))
(defn lwig-plan-start (plan) (nth (node_children plan) 1))
(defn lwig-plan-sequence (plan) (nth (node_children plan) 2))
(defn lwig-plan-remaining (plan) (nth (node_children plan) 3))
(defn lwig-plan-status (plan) (nth (node_children plan) 4))
(defn lwig-plan-alternatives (plan) (nth (node_children plan) 5))
(defn lwig-plan-unknown (plan) (nth (node_children plan) 6))
(defn lwig-plan-stops (plan) (nth (node_children plan) 7))
(defn lwig-plan-evidence (plan) (nth (node_children plan) 8))
(defn lwig-plan-path (plan) (nth (node_children plan) 9))

(defn lwig-plan-alternatives-with (group extra)
    (lwac-field-union-items (lwo-field-items extra)
        (lwig-group-alternatives group)))

(defn lwig-derive (group start current remaining ordered)
    (do
        (let outgoing
            (lwig-outgoing-items
                (lwo-field-items (lwig-group-edges group)) current
                (lwo-empty-field)))
        (let outgoing-items (lwo-field-items outgoing))
        (let stops
            (lwig-stops-items
                (lwo-field-items (lwig-group-observations group)) current
                (lwo-empty-field)))
        (if (eq (len outgoing-items) 0)
            (if (eq (len remaining) 0)
                (lwig-plan-cell group start ordered (lwo-empty-field)
                    (lwig-ready) (lwig-group-alternatives group)
                    (lwo-none) stops group)
                (lwig-plan-cell group start ordered (lwo-field remaining)
                    (lwig-stop) (lwig-group-alternatives group)
                    (lwlc-unknown group) stops group))
            (if (gt (len outgoing-items) 1)
                (lwig-plan-cell group start ordered (lwo-field remaining)
                    (lwig-branch)
                    (lwig-plan-alternatives-with group outgoing)
                    (lwlc-unknown group) stops group)
                (do
                    (let edge (lwo-emergent-shape (head outgoing-items)))
                    (let next (lwig-edge-right edge))
                    (if (eq (lwo-member? ordered next) 1)
                        (lwig-plan-cell group start ordered
                            (lwo-field remaining) (lwig-cycle)
                            (lwig-group-alternatives group)
                            (lwlc-unknown group) stops group)
                        (if (eq (lwo-member? remaining next) 0)
                            (lwig-plan-cell group start ordered
                                (lwo-field remaining) (lwig-stop)
                                (lwig-group-alternatives group)
                                (lwlc-unknown group) stops group)
                            (lwig-derive group start next
                                (lwig-remove-node remaining next)
                                (append ordered (list next))))))))))

(defn lwig-plan-for (world start nodes)
    (do
        (let group (lwig-group-for world nodes))
        (if (node_eq group (lwo-none)) (lwo-none)
            (if (eq (lwo-field-has? nodes start) 0) (lwo-none)
                (lwig-derive group start start
                    (lwig-remove-node (lwo-field-items nodes) start)
                    (list start))))))
(defn lwig-plan-current? (world plan)
    (if (eq (lwig-plan? plan) 0) 0
        (if (node_eq plan
                (lwig-plan-for world (lwig-plan-start plan)
                    (lwig-group-nodes
                        (lwig-plan-group plan)))) 1 0)))

0
