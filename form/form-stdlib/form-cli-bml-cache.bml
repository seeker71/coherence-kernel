//////////////////////////////////////////////////////////////////////
//
// form-cli-bml-cache.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-bml-cache.bml
//
// Cache miss today still compiles ice toward a disposable xtal bridge —
// that bridge is the WRONG shape. Floor is high-grammar BML with the
// optimal cached native speed compiler (.fkb / .dylib). Named next:
// bce-miss emits / prefers native cache, not *-xtal.fk.
//
// Proven by: form-stdlib/tests/form-cli-bml-cache-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template CacheRow<TPath> {
        member ice: TPath;
        member xtal: TPath;
        member fresh: int;
    }

    class FormBmlCacheAuthority {
        field CacheAuthorityPath = "form/form-stdlib/bml/form-cli-bml-cache.bml";
        field CacheAuthorityKind = "high-bml-class-template-field";
    }

    class FormBmlCache<T> {
        field IceDir = "form/form-stdlib";
        field CompileSuffix = "-compile.fk";
        field XtalSuffix = "-xtal.fk";

        ref bce-authority = FormBmlCacheAuthority;
        thought bce-pattern = list("one-ice", "xtal-wrong-shape", "floor-cached-native", "cache-miss-compiles");

        def bce-ends?(s, suffix) {
            if lt(str_len(s), str_len(suffix)) then 0 else if str_eq(substring(s, sub(str_len(s), str_len(suffix)), str_len(s)), suffix) then 1 else 0;
        }
        def bce-fresh?(ice, xtal) {
            let cm = file_mtime(xtal);
            let sm = file_mtime(ice);
            if lt(cm, 0) then 0 else if lt(sm, 0) then 0 else if ge(cm, sm) then 1 else 0;
        }
        def bce-xtal-of(ice) {
            if eq(bce-ends?(ice, ".bml"), 1) then str_concat(substring(ice, 0, sub(str_len(ice), 4)), "-xtal.fk") else if eq(bce-ends?(ice, ".fk"), 1) then str_concat(substring(ice, 0, sub(str_len(ice), 3)), "-xtal.fk") else ice;
        }
        def bce-miss(ice, xtal) {
            form-source-compile-file(ice, xtal);
            1
        }
        def bce-one(ice) {
            let xtal = bce-xtal-of(ice);
            if eq(bce-fresh?(ice, xtal), 1) then 0 else if lt(file_mtime(ice), 0) then 0 else bce-miss(ice, xtal);
        }
        def bce-stem(name) {
            if eq(bce-ends?(name, "-compile.fk"), 1) then substring(name, 0, sub(str_len(name), 11)) else "";
        }
        def bce-ice-of-stem(stem) {
            let bml = fs-path-join(IceDir(), str_concat(stem, ".bml"));
            let fk = fs-path-join(IceDir(), str_concat(stem, ".fk"));
            if ge(file_mtime(bml), 0) then bml else fk;
        }
        def bce-loop(names, n) {
            if eq(len(names), 0) then n else if eq(bce-ends?(head(names), "-compile.fk"), 0) then bce-loop(tail(names), n) else bce-loop(tail(names), add(n, bce-one(bce-ice-of-stem(bce-stem(head(names))))));
        }
        def bce-ensure-all() = bce-loop(fs-list(IceDir()), 0);

        def bce-bit(ok, bit) = if ok then bit else 0;
        def bce-check() {
            let ice = "form/form-stdlib/form-cli-bml-cache.bml";
            let xtal = bce-xtal-of(ice);
            let c0 = bce-bit(eq(bce-ends?("form-cli-flow-compile.fk", "-compile.fk"), 1), 1);
            let c1 = bce-bit(str_eq(bce-stem("form-cli-flow-compile.fk"), "form-cli-flow"), 2);
            let c2 = bce-bit(str_eq(bce-xtal-of("form/form-stdlib/a.bml"), "form/form-stdlib/a-xtal.fk"), 4);
            let c3 = bce-bit(str_eq(bce-xtal-of("form/form-stdlib/a.fk"), "form/form-stdlib/a-xtal.fk"), 8);
            let c4 = bce-bit(eq(bce-fresh?(ice, xtal), 1), 16);
            add(c0, add(c1, add(c2, add(c3, c4))));
        }
    }
    0;
}
