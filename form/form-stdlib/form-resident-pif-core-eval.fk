// form-resident-pif-core-eval.fk -- NodeID calls into a persistent scannerless
// Form evaluator environment.
//
// Source arriving after process startup is interpreted into immutable function
// bindings.  Each body is resident source data addressed by a recursively
// interned NodeID; it is not compiled into the kernel's fixed fk_fn array.
// Re-definition conses a new binding and births a new identity.  Exact NodeID
// calls resolve the requested body, while ordinary source calls resolve the
// newest binding by name.  The same live environment is returned after every
// movement.
//
// preludes: form-stdlib/core.fk
// preludes: form-stdlib/form-eval-full.fk
section [form.bml] {
    def frpce-version() = "form-resident-pif-core-eval-v1";
    // state keeps a NodeID->binding registry beside the evaluator environment.
    // Identity is minted once at definition entry; calls compare NodeIDs only
    // and never recursively re-intern every older body on the hot path.
    def frpce-state(value, env, identity, status, reason, registry) = list(frpce-version(), value, env, identity, status, reason, registry);
    def frpce-value(state) = nth(state, 1);
    def frpce-env(state) = nth(state, 2);
    def frpce-identity(state) = nth(state, 3);
    def frpce-status(state) = nth(state, 4);
    def frpce-reason(state) = nth(state, 5);
    def frpce-registry(state) = nth(state, 6);
    def frpce-empty() = frpce-state(0, fef-empty-env(), nothing(), "ready", "resident-environment-open", empty());
    def frpce-function-binding?(binding) = len(binding) >= 4 ? (Comparable) fef-bkind(binding) == 1 : 0;
    def frpce-binding-identity(binding) =     // The pure evaluator stays four-way and stores only source data.  At
    // this resident boundary, 1.2.31 is the reviewed fndef family:
    // recursively interning [name,body] discovers the local content
    // instance, then a raw NodeID makes that identity transmissible over
    // the live cursor. No SHA bookkeeping participates.
{
        let content = intern_node(make_nodeid(1, 2, 31, 1), list(intern_trivial_string(fef-bname(binding)), intern_trivial_string(fef-bb(binding))));
        make_nodeid(1, 2, 31, node_inst(content));
    };
    def frpce-latest-identity(before, after) = len(after) > len(before) ? frpce-function-binding?(head(after)) ? frpce-binding-identity(head(after)) : nothing() : nothing();
    def frpce-register(registry, identity, binding) = nothing?(identity) ? registry : cons(list(identity, binding), registry);
    def frpce-eval(state, source) = {
        let before = frpce-env(state);
        let result = fef-eval-state(source, before);
        let after = fef-e(result);
        let identity = frpce-latest-identity(before, after);
        frpce-state(fef-v(result), after, identity, "returned", "source-interpreted-resident", frpce-register(frpce-registry(state), identity, nothing?(identity) ? nothing() : head(after)));
    };
    def frpce-find-node(registry, identity) = nil?(registry) ? nothing() : {
        let row = head(registry);
        node_eq(nth(row, 0), identity) ? nth(row, 1) : frpce-find-node(tail(registry), identity);
    };
    // receipt = marker, identity, status, reason, value, output-count, env,
    //           lifecycle. A returned language-level nothing has output=1.
    def frpce-receipt(identity, status, reason, value, output, env, trace) = list("form-resident-pif-core-eval-receipt", identity, status, reason, value, output, env, trace);
    def frpce-receipt-identity(receipt) = nth(receipt, 1);
    def frpce-receipt-status(receipt) = nth(receipt, 2);
    def frpce-receipt-reason(receipt) = nth(receipt, 3);
    def frpce-receipt-value(receipt) = nth(receipt, 4);
    def frpce-receipt-output(receipt) = nth(receipt, 5);
    def frpce-receipt-env(receipt) = nth(receipt, 6);
    def frpce-receipt-trace(receipt) = nth(receipt, 7);
    def frpce-signal(value) = nothing?(value) ? "nothing" : (Comparable) value == 0 ? "zero" : (Comparable) value == 1 ? "one" : "value";
    def frpce-invoke-one(state, identity, argument) = {
        let binding = frpce-find-node(frpce-registry(state), identity);
        nothing?(binding) ? frpce-receipt(identity, "nothing", "recipe-node-not-found", nothing(), 0, frpce-env(state), "resolve,nothing,observe,release") : {
            let body-env = fef-zip(fef-ba(binding), list(argument), frpce-env(state));
            let result = fef-eval-state(fef-bb(binding), body-env);
            frpce-receipt(identity, "returned", "recipe-node-invoked", fef-v(result), 1, frpce-env(state), "resolve,call,return,observe,release");
        };
    };
}
