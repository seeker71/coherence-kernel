// llama3-pretokenize.fk — Llama 3 (tiktoken-style) regex pre-tokenization (word splitting), as a Form recipe.
//
// preludes: (none beyond the kernel — pure string/int/list recursion)
//
// The GPU decode stack the body runs on the M4 (multi-layer KV-cached llama decode) is LLAMA — and
// llama3's tokenizer differs from the whisper/GPT-2 one in exactly ONE algorithmic piece: the
// pre-tokenization `pat_str`. The byte→symbol map is the SAME byte-level bytes_to_unicode, and the
// merge core is the SAME lowest-rank-first BPE (tiktoken's _byte_pair_merge is lowest-rank-first too)
// — only the rank TABLE (DATA) and this splitter differ. So this recipe is the one algorithmic piece
// between the GPU llama decode and the first end-to-end native LLAMA token.
//
// Llama 3's fixed pattern (Meta tokenizer.py), `\p{L}`→[A-Za-z], `\p{N}`→[0-9] over the ASCII byte domain:
//
//   (?i:'s|'t|'re|'ve|'m|'ll|'d)|[^\r\nA-Za-z0-9]?[A-Za-z]+|[0-9]{1,3}| ?[^\sA-Za-z0-9]+[\r\n]*|\s*[\r\n]+|\s+(?!\S)|\s+
//
// Four differences from GPT-2's ` 's|'t|...| ?\p{L}+| ?\p{N}+| ?[^\s...]+|\s+(?!\S)|\s+` — each a real law:
//   (1) CASE-INSENSITIVE contractions `(?i:)` — "DON'T" splits 'T too, not just lowercase 't.
//   (2) DIGITS group 1-3 `[0-9]{1,3}` (not ` ?\p{N}+`) — "1234" → "123","4", and NO leading space on digits.
//   (3) WORD leading char `[^\r\nA-Za-z0-9]?\p{L}+` (not ` ?\p{L}+`) — ANY non-newline non-alnum char (not
//       only a space) is absorbed before a word: "_word" → ["_word"], "@home" → ["@home"], " tok" → [" tok"].
//   (4) NEWLINES `\s*[\r\n]+` and other-run `[^\s...]+[\r\n]*` get explicit handling — a ws run that ends in
//       a newline is cut after the LAST newline; a punct run absorbs trailing newlines.
//
// A regex IS a recipe (a char-class state machine): the alternation, tried left-to-right at each position,
// becomes a left-to-right scan — at i take the FIRST matching alternative, emit that substring, continue
// from its end. Confirmed bit-identical to Python `re` (ASCII-reduced pattern) on every fixture before
// authoring. All char_at/ord/str_concat/str_len — the four-way string subset; no floats (no e-notation
// risk), no host I/O, small tables. Feeds the byte→symbol map and the BPE merge for the llama text→ids path.
section [form.bml] {
    // --- character classes by ord ---
    def l3-ws?(c) = {
        let o = ord(c);
        ((Comparable) o == 32 ? 1 : (Comparable) o == 9 ? 1 : (Comparable) o == 10 ? 1 : (Comparable) o == 11 ? 1 : (Comparable) o == 12 ? 1 : (Comparable) o == 13 ? 1 : 0) ? 1 : 0;
    };
    def l3-letter?(c) = {
        let o = ord(c);
        (o >= 65 ? o <= 90 : 0) ? 1 : (o >= 97 ? o <= 122 : 0) ? 1 : 0;
    };
    def l3-digit?(c) = {
        let o = ord(c);
        (o >= 48 ? o <= 57 : 0) ? 1 : 0;
    };
    def l3-crlf?(c) = {
        let o = ord(c);
        ((Comparable) o == 10 ? 1 : (Comparable) o == 13 ? 1 : 0) ? 1 : 0;
    };
    // `[^\r\nA-Za-z0-9]` — the optional leading char of a word: NOT cr/lf, NOT letter, NOT digit (space ok).
    def l3-lead?(c) = (Comparable) l3-crlf?(c) == 1 ? 0 : (Comparable) l3-letter?(c) == 1 ? 0 : (Comparable) l3-digit?(c) == 1 ? 0 : 1;
    // `[^\sA-Za-z0-9]` — the "other" (punct/symbol) class: NOT whitespace, NOT letter, NOT digit.
    def l3-other?(c) = (Comparable) l3-ws?(c) == 1 ? 0 : (Comparable) l3-letter?(c) == 1 ? 0 : (Comparable) l3-digit?(c) == 1 ? 0 : 1;
    // first index >= k where the class predicate fails (or n) — the maximal run end.
    def l3-run(s, n, k, pred) = k >= n ? n : (Comparable) pred(char_at(s, k)) == 1 ? l3-run(s, n, k + 1, pred) : k;
    // `[0-9]{1,3}` — take up to 3 digits from k (c = count so far). Greedy, max 3.
    def l3-dig3(s, n, k, c) = c >= 3 ? k : k >= n ? k : (Comparable) l3-digit?(char_at(s, k)) == 1 ? l3-dig3(s, n, k + 1, c + 1) : k;
    // case-insensitive ord equality against a lowercase/uppercase pair.
    def l3-eqi(o, lo, hi) = (Comparable) o == lo ? 1 : (Comparable) o == hi ? 1 : 0;
    // s[i]=="'" → contraction length INCLUDING the quote (2 for 's/'t/'m/'d, 3 for 're/'ve/'ll), case-
    // insensitive (the (?i:) flag — llama3 splits 'T/'RE/'LL too), else 0.
    def l3-contract-len(s, n, i) = i + 1 >= n ? 0 : {
        let a = ord(char_at(s, i + 1));
        (l3-eqi(a, 115, 83) ? 1 : l3-eqi(a, 116, 84) ? 1 : l3-eqi(a, 109, 77) ? 1 : l3-eqi(a, 100, 68) ? 1 : 0) ? 2 : i + 2 >= n ? 0 : {
            let b = ord(char_at(s, i + 2));
            (l3-eqi(a, 114, 82) && l3-eqi(b, 101, 69) ? 1 : l3-eqi(a, 118, 86) && l3-eqi(b, 101, 69) ? 1 : l3-eqi(a, 108, 76) && l3-eqi(b, 108, 76) ? 1 : 0) ? 3 : 0;
        };
    };
    // ` ?[^\sA-Za-z0-9]+[\r\n]*` body from p — the "other" run then a trailing run of newlines.
    def l3-other-end(s, n, p) = {
        let e = l3-run(s, n, p, l3-other?);
        l3-run(s, n, e, l3-crlf?);
    };
    // last index of a \r\n char in [i,j), or (sub i 1) sentinel when none.
    def l3-lastnl(s, k, j, acc) = k >= j ? acc : {
        let o = ord(char_at(s, k));
        l3-lastnl(s, k + 1, j, ((Comparable) o == 10 ? 1 : (Comparable) o == 13 ? 1 : 0) ? k : acc);
    };
    // whitespace at i: rule (e) `\s*[\r\n]+` cuts a ws run after its LAST newline; otherwise rule
    // (f) `\s+(?!\S)` leaves the last ws of an internal run (len>=2), rule (g) `\s+` emits a single
    // ws or a trailing run whole. (GPT-2 never hits the run==1 case — its ` ?` absorbs leading spaces;
    // llama3 digits do NOT, so " 42" reaches here with one space and must emit it, not collapse to empty.)
    def l3-ws-end(s, n, i) = {
        let j = l3-run(s, n, i, l3-ws?);
        let lastnl = l3-lastnl(s, i, j, i - 1);
        lastnl >= i ? lastnl + 1 : j >= n ? j : j - i >= 2 ? j - 1 : j;
    };
    // end index (exclusive) of the pre-token starting at i — the alternation, in order.
    def l3-end(s, n, i) = {
        let c = char_at(s, i);
        let o = ord(c);
        let cl = (Comparable) o == 39 ? l3-contract-len(s, n, i) : 0;
        cl > 0 ? i + cl :         // `[^\r\nA-Za-z0-9]?\p{L}+` — bare word, or one leading non-alnum char then letters.
(Comparable) l3-letter?(c) == 1 ? l3-run(s, n, i + 1, l3-letter?) : ((Comparable) l3-lead?(c) == 1 ? i + 1 < n ? l3-letter?(char_at(s, i + 1)) : 0 : 0) ? l3-run(s, n, i + 2, l3-letter?) :         // `[0-9]{1,3}` — NO leading space on digits.
(Comparable) l3-digit?(c) == 1 ? l3-dig3(s, n, i, 0) :         // ` ?[^\sA-Za-z0-9]+[\r\n]*` — other run (optionally one leading space) + trailing newlines.
(Comparable) l3-other?(c) == 1 ? l3-other-end(s, n, i) : ((Comparable) o == 32 ? i + 1 < n ? l3-other?(char_at(s, i + 1)) : 0 : 0) ? l3-other-end(s, n, i + 1) :         // `\s*[\r\n]+ | \s+(?!\S) | \s+`
l3-ws-end(s, n, i);
    };
    // substring s[i..e) by char accumulation (char_at returns a one-char string).
    def l3-sub(s, i, e) = i >= e ? "" : str_concat(char_at(s, i), l3-sub(s, i + 1, e));
    // scan: emit the pre-token at i, continue from its end.
    def l3-plist(s, n, i) = i >= n ? list() : {
        let e = l3-end(s, n, i);
        cons(l3-sub(s, i, e), l3-plist(s, n, e));
    };
    // the entry: text -> list of llama3 pre-token substrings (in order).
    def llama3-pretokenize(s) = l3-plist(s, str_len(s), 0);
    0;
}
