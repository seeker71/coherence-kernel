(defn fem-bit (ok bit) (if ok bit 0))
(defn fem-check () (do (let c0 (fem-bit (eq (fem-proof-n) 1214) 1)) (let c1 (fem-bit (eq (fem-organs) 57) 2)) (let c2 (fem-bit (eq (fem-lane-kinds) 513) 4)) (let c3 (fem-bit (eq (fem-body-n) 164) 8)) (let c4 (fem-bit (eq (CorpusN) 1152) 16)) (let c5 (fem-bit (eq (NeedEvents) 95) 32)) (let c6 (fem-bit (eq (SessionPpm) 894153) 64)) (let c7 (fem-bit (and (eq (FqtLora) 0) (eq (OverlayPairs) 45)) 128)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
(defn FormEmbodyCensus () (list "abstraction" "FormEmbodyCensus" (list "T") (list "fem-proof-n" "fem-organs" "fem-lane-kinds" "fem-body-n" "fem-fqt-lora" "fem-bit" "fem-check") (list "KnowledgeN" "UniverseN" "UniqueN" "DomainN" "OrganN" "LaneN" "LensN" "PlannerN" "BodySkills" "LensSkills" "PlannerSkills" "Lanes" "CorpusN" "NeedEvents" "SessionPpm" "FqtLora" "OverlayPairs") (list "fem-authority") (list "fem-pattern" "fem-mills")))
