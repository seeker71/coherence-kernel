(defn CensusAuthorityKind () "high-bml-class-template-field")
(defn FormEmbodyCensusAuthority () (list "abstraction" "FormEmbodyCensusAuthority" (list) (list) (list "CensusAuthorityPath" "CensusAuthorityKind") (list) (list)))
(defn KnowledgeN () 24)
(defn UniverseN () 32)
(defn UniqueN () 36)
(defn DomainN () 48)
(defn OrganN () 48)
(defn LaneN () 738)
(defn LensN () 144)
