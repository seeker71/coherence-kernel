(defn BodySkills () 41)
(defn LensSkills () 8)
(defn PlannerSkills () 8)
(defn Lanes () 9)
(defn CorpusN () 1152)
(defn NeedEvents () 95)
(defn SessionPpm () 894153)
(defn FqtLora () 0)
(defn OverlayPairs () 45)
(defn fem-authority () FormEmbodyCensusAuthority)
(defn fem-pattern () (list "sum" "organs" "lanes" "remaining"))
(defn fem-mills () (list "knowledge" "universe" "unique" "domain" "organ" "lane" "lens" "planner"))
(defn fem-proof-n () (add (KnowledgeN) (add (UniverseN) (add (UniqueN) (add (DomainN) (add (OrganN) (add (LaneN) (add (LensN) (PlannerN)))))))))
(defn fem-organs () (add (BodySkills) (add (LensSkills) (PlannerSkills))))
