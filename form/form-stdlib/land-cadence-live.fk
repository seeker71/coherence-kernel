; land-cadence-live.fk — print the land-on-origin breath.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-local-law.fk form-stdlib/land-cadence.fk

(do
    (print "land-cadence interval=")
    (print (int_to_str (lc-interval-minutes)))
    (print " seat=")
    (print (int_to_str (lc-seat)))
    (print " force=")
    (print (int_to_str (lc-force?)))
    (print "\n")
    (print "land-cadence even-clean-water->")
    (print (int_to_str (lc-act (lc-even) (lc-clean) 0 1)))
    (print " ahead-clean-water->")
    (print (int_to_str (lc-act (lc-ahead) (lc-clean) 0 1)))
    (print " behind-clean-water->")
    (print (int_to_str (lc-act (lc-behind) (lc-clean) 0 1)))
    (print "\n")
    (print "land-cadence voice clear-same=")
    (print (int_to_str (lc-voice (lc-act-clear) 1)))
    (print " clear-first=")
    (print (int_to_str (lc-voice (lc-act-clear) 0)))
    (print "\n")
    (print "land-cadence check=")
    (print (int_to_str (lc-check)))
    (print "\n")
    0)
