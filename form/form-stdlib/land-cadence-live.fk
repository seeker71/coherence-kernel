// land-cadence-live.fk — print the land-on-origin breath.
//
// The breath runs the drift gates (gate/drift-gates.bml) before it names
// a landing act: every gate row prints its line, then the act each shape
// would take under today's gates. 7 is gate-refused — a red gate lands
// nothing. Beside the gates it reads the five lenses of the alignment
// plan — authoring altitude, carrier mass, belief stamps, forbidden-tool
// commands (the slips of agents, read from their transcripts), hours since a
// walk began (the walk's slot stamp, with the last retry's line) — one line each,
// laid against the previous breath's readings kept at hearth-readings, and
// says moved / steady / first-reading / unobserved per lens. A reading
// never refuses; only a gate does. This door prints; host git stays the
// carrier, and host fkwu carries the lenses.
//
import form-stdlib/core.fk;
import form-stdlib/form-cli-local-law.fk;
import form-stdlib/land-cadence.fk;
import gate/drift-gates.bml;
import form-stdlib/hearth.bml;
// print writes its argument and a newline ("args +
// newline"), so each line of the breath is composed whole and printed once.
section [form.bml] {
    // the carrier side of a reading: run the lens door, hand its words to the recipe
    // a reading and the note its lens said beside its number: [row, note]
    def lr-observe(lens, prev) = lr-observe-of(lens, prev, host-exec(lr-command(lens), ""));
    def lr-observe-of(lens, prev, out) = [lr-row(lr-name(lens), out, prev), lr-note-of(out)];
    def lr-observe-all(lenses, prev) = (Comparable) len(lenses) == 0 ? [] : cons(lr-observe(lenses[0], prev), lr-observe-all(lenses[1:], prev));
    def lr-rows-of(observed) = map(o => o[0], observed);
    def lr-print-all(observed) = (Comparable) len(observed) == 0 ? 0 : {
        print(lr-line(observed[0][0]));
        (Comparable) len(observed[0][1]) == 0 ? 0 : print(("  " + observed[0][1]));
        lr-print-all(observed[1:]);
    };
    def lr-remember(path, mem) = (Comparable) write_file_text(path, mem) == len(mem) ? ("land-cadence readings remembered at " + path) : ("land-cadence readings NOT remembered - short write at " + path);
    print(("land-cadence interval=" + (lc-interval-minutes().str() + (" seat=" + (lc-seat().str() + (" force=" + lc-force?().str()))))));
    print(("land-cadence even-clean-water->" + (lc-act(lc-even(), lc-clean(), 0, 1).str() + (" ahead-clean-water->" + (lc-act(lc-ahead(), lc-clean(), 0, 1).str() + (" behind-clean-water->" + lc-act(lc-behind(), lc-clean(), 0, 1).str()))))));
    print(("land-cadence voice clear-same=" + (lc-voice(lc-act-clear(), 1).str() + (" clear-first=" + lc-voice(lc-act-clear(), 0).str()))));
    print(("land-cadence check=" + lc-check().str()));
    print("land-cadence drift gates before any landing act:");
    let gate-rows = dg-rows();
    let pass = dg-run(gate-rows);
    let gates = dg-green?(pass, gate-rows);
    print(("land-cadence gates=" + (((Comparable) gates == 1 ? "green" : "red") + (" ahead-clean-water->" + (lc-land(lc-act(lc-ahead(), lc-clean(), 0, 1), gates).str() + (" behind-clean-water->" + (lc-land(lc-act(lc-behind(), lc-clean(), 0, 1), gates).str() + (" even-related-water->" + (lc-land(lc-act(lc-even(), lc-related(), 0, 1), gates).str() + " (7 = gate-refused: a red gate lands nothing)")))))))));
    // the readings, beside the gates: each lens's trailing field code against the previous breath's
    print("land-cadence readings beside the gates - altitude, carrier, beliefs, forbidden, walk - against the previous breath:");
    let observed = lr-observe-all(lr-lenses(), read_file(hearth-readings()));
    let rows = lr-rows-of(observed);
    lr-print-all(observed);
    print(lr-summary(rows));
    print(lr-remember(hearth-readings(), lr-memory(rows)));
    0;
}
