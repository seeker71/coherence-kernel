; land-cadence-live.fk — print the land-on-origin breath.
;
; The breath runs the drift gates (gate/drift-gates.bml) before it names
; a landing act: every gate row prints its line, then the act each shape
; would take under today's gates. 7 is gate-refused — a red gate lands
; nothing. Beside the gates it reads the three lenses of the alignment
; plan — authoring altitude, carrier mass, belief stamps — one line each,
; laid against the previous breath's readings kept at hearth-readings, and
; says moved / steady / first-reading / unobserved per lens. A reading
; never refuses; only a gate does. This door prints; host git stays the
; carrier, and host fkwu carries the lenses.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-local-law.fk form-stdlib/land-cadence.fk gate/drift-gates.bml form-stdlib/hearth.bml

; print writes its argument and a newline (primitive-registry: "args +
; newline"), so each line of the breath is composed whole and printed once.

(do
    ; the carrier side of a reading: run the lens door, hand its words to the recipe
    (defn lr-observe (lens prev) (lr-row (lr-name lens) (host-exec (lr-command lens) "") prev))
    (defn lr-observe-all (lenses prev) (if (eq (len lenses) 0) (list) (cons (lr-observe (head lenses) prev) (lr-observe-all (tail lenses) prev))))
    (defn lr-print-all (rows) (if (eq (len rows) 0) 0 (do (print (lr-line (head rows))) (lr-print-all (tail rows)))))
    (defn lr-remember (path mem) (if (eq (write_file_text path mem) (str_len mem)) (str_concat "land-cadence readings remembered at " path) (str_concat "land-cadence readings NOT remembered - short write at " path)))
    (print (str_concat "land-cadence interval=" (str_concat (int_to_str (lc-interval-minutes)) (str_concat " seat=" (str_concat (int_to_str (lc-seat)) (str_concat " force=" (int_to_str (lc-force?))))))))
    (print (str_concat "land-cadence even-clean-water->" (str_concat (int_to_str (lc-act (lc-even) (lc-clean) 0 1)) (str_concat " ahead-clean-water->" (str_concat (int_to_str (lc-act (lc-ahead) (lc-clean) 0 1)) (str_concat " behind-clean-water->" (int_to_str (lc-act (lc-behind) (lc-clean) 0 1))))))))
    (print (str_concat "land-cadence voice clear-same=" (str_concat (int_to_str (lc-voice (lc-act-clear) 1)) (str_concat " clear-first=" (int_to_str (lc-voice (lc-act-clear) 0))))))
    (print (str_concat "land-cadence check=" (int_to_str (lc-check))))
    (print "land-cadence drift gates before any landing act:")
    (let pass (dg-report))
    (let gates (dg-green? pass (dg-rows)))
    (print (str_concat "land-cadence gates=" (str_concat (if (eq gates 1) "green" "red") (str_concat " ahead-clean-water->" (str_concat (int_to_str (lc-land (lc-act (lc-ahead) (lc-clean) 0 1) gates)) (str_concat " behind-clean-water->" (str_concat (int_to_str (lc-land (lc-act (lc-behind) (lc-clean) 0 1) gates)) (str_concat " even-related-water->" (str_concat (int_to_str (lc-land (lc-act (lc-even) (lc-related) 0 1) gates)) " (7 = gate-refused: a red gate lands nothing)")))))))))
    ; the readings, beside the gates: each lens's trailing field code against the previous breath's
    (print "land-cadence readings beside the gates - altitude, carrier, beliefs - against the previous breath:")
    (let rows (lr-observe-all (lr-lenses) (read_file (hearth-readings))))
    (lr-print-all rows)
    (print (lr-summary rows))
    (print (lr-remember (hearth-readings) (lr-memory rows)))
    0)
