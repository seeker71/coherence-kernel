; fsh-native-port-check-shell.fk -- isolated Form-shell diagnostic seam.
;
; native-port-check <lowercase-64-hex-exchange-id> is deliberately a
; diagnostic-only command.  On the normal direct-source shell it parses and
; validates entirely in Form, emits the typed non-executable capability plan,
; and returns 69: no Form-native port executor is present in that path.
; Malformed input returns 64.  It accepts no stage, executable, path,
; working-directory, model, environment, or additional argument.
;
; Any future executable handoff begins with a Form-controlled JIT admission
; and a separately witnessed native port ABI.  This direct shell file does
; not invoke a child, local resource, or network route.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/grammar-loader.fk form-stdlib/shell-grammar.fk form-stdlib/voice-traits.fk form-stdlib/feature-vector.fk form-stdlib/voice-diarize.fk form-stdlib/fsh-turn-process-spec.fk form-stdlib/nearest-shape.fk form-stdlib/shell-exec.fk
;
; Proven by: form-stdlib/tests/fsh-native-port-check-shell-band.fk

(do
    ; -- closed direct-source contract --------------------------------------
    (defn fsnpc-command-name () "native-port-check")
    (defn fsnpc-valid-no-executor-exit () 69)
    (defn fsnpc-malformed-exit () 64)
    (defn fsnpc-refused-arity () "refused-native-port-check-arity")

    (defn fsnpc-one-arg? (args) (if (eq (len args) 1) 1 0))
    (defn fsnpc-input-id (args)
        (if (eq (fsnpc-one-arg? args) 1) (head args) ""))
    (defn fsnpc-id-valid? (exchange-id)
        (fshps-exchange-id? exchange-id))
    (defn fsnpc-arity-plan ()
        (fshps-plan-for "" (fsnpc-refused-arity)))
    (defn fsnpc-plan (args)
        (if (eq (fsnpc-one-arg? args) 1)
            (fshps-plan (fsnpc-input-id args))
            (fsnpc-arity-plan)))
    (defn fsnpc-render-plan (args)
        (fshps-render-plan-loop (fsnpc-plan args)))
    (defn fsnpc-exit (args)
        (if (and (eq (fsnpc-one-arg? args) 1)
                 (eq (fsnpc-id-valid? (fsnpc-input-id args)) 1))
            (fsnpc-valid-no-executor-exit)
            (fsnpc-malformed-exit)))
    (defn fsnpc-direct-result (args stdin)
        (list (fsnpc-render-plan args) (fsnpc-exit args)))

    ; -- base-shell late binding --------------------------------------------
    (defn fsnpc-command-node? (node)
        (str_eq (sh-tag node) (fsnpc-command-name)))
    (defn fsnpc-eval-command (node env stdin)
        (do
            (let args (sh-collect-args (sh-rest node) env))
            (let result (fsnpc-direct-result args stdin))
            (let exit-code (nth result 1))
            (list (nth result 0)
                  (sh-env-set env "?" (int_to_str exit-code))
                  exit-code)))
    (defn sh-eval-command (node env stdin)
        (if (fsnpc-command-node? node)
            (fsnpc-eval-command node env stdin)
            (sh-eval-command-default node env stdin)))

    ; The plan is informative only: its explicit native-unavailable kind
    ; names a parsed request whose direct Form source path has no executor.
    (defn fsnpc-plan-kind () "native-unavailable")
    (defn fsnpc-plan-command (node)
        (do
            (let parts (sh-rest node))
            (let args (sh-collect-args parts (sh-env-empty)))
            (let redirs (sh-collect-redirs parts))
            (list (list (fsnpc-plan-kind) (fsnpc-command-name) args redirs))))
    (defn sh-plan-command (node)
        (if (fsnpc-command-node? node)
            (fsnpc-plan-command node)
            (sh-plan-command-default node)))
)
