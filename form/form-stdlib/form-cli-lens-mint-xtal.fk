
(let SampleRow (language-template-with-members "SampleRow" (list "TClass") (list (language-template-member "split" "String") (language-template-member "className" "TClass") (language-template-member "situation" "String"))))
(defn MintAuthorityPath () "form/form-stdlib/bml/form-cli-lens-mint.bml")
(defn MintAuthorityKind () "high-bml-class-template-field")
(defn FormLensMintAuthority () (list "abstraction" "FormLensMintAuthority" (list) (list) (list "MintAuthorityPath" "MintAuthorityKind") (list) (list)))
(defn MixA () 7)
(defn MixB () 13)
(defn NSkills () 8)
(defn NLanes () 9)
(defn LoraWriter () 0)
(defn SplitTrain () "train")
(defn SplitHeldout () "heldout")
(defn fls-authority () FormLensMintAuthority)
(defn fls-pattern () (list "lens" "stake" "perception" "movement"))
(defn fls-lanes () (list "when" "where" "which" "what" "who" "how" "why" "knowledge-query" "walk"))
(defn fls-skills () (list "perception" "nl-lens" "pl-lens" "jacobian" "stake" "compiler" "field" "lens-move"))
(defn fls-sources () (list "form/form-stdlib/lenses.fk" "cognition/nl-lenses-13.fk" "cognition/pl-lenses-13.fk" "observe/jacobian-lens.fk" "ingest/frequency-ingest-steiner-core.fk" "form/form-stdlib/compiler-lens.fk" "form/form-stdlib/field-model-form.fk" "form/form-stdlib/assemblage-point.fk" "presence/inquiry-planes.fk"))
(defn fls-mix (i n) (mod (add (mul i (MixA)) (MixB)) n))
(defn fls-perception-stems () (list "what IS projects onto meaning feeling trust sovereignty vitality" "meaning is a lookup the other four lenses are measured or earned" "two media carry the projection symbol and sound TTS renders STT recognises" "gate 25 in three tongues is one cell on the meaning lens"))
(defn fls-nl-stems () (list "thirteen NL lenses detect and generate through a numeric meaning" "presence enquiry affirmation and grounded framing are the four tiny meanings" "unknown text returns empty never a fabricated locale" "crossing NL lenses preserves only caller-supplied detail for meaning four"))
(defn fls-pl-stems () (list "thirteen PL lenses are registry detection and bounded generation not thirteen parsers" "detection is evidence-scoring not a proof of language" "exact binary-function generation for add subtract multiply division stays out" "a programming surface is a lens onto the same Form cell"))
(defn fls-jacobian-stems () (list "a choice flips when push exceeds margin hesitation is the most edit-sensitive moment" "nothing is zero-jacobian silence carries no signal back" "timeout is unknown partials remaining unknown is not zero" "the jacobian maps an edit to how much it moves each downstream thought"))
(defn fls-stake-stems () (list "a lens fires when a mark it addresses is present in the situation" "a lens that always applies is a horoscope not a lens" "staking a lens commits one view the others remain untried like cut" "context requirements choose reverse lenses the arriving situation stakes which fires"))
(defn fls-compiler-stems () (list "the compiler is a reasoning instrument not only a lowering step" "a compiler lens holds human surface machine surface source map and diagnostics" "fidelity of a source-map is how much of the expression survived the lower" "dependency edges stay visible so movement of one cell is observed from another"))
(defn fls-field-stems () (list "Hoffman interface lens observer selects fitness icons from a hidden substrate" "Levin bioelectric lens tissue state is voltage-pattern memory" "Wolfram rule-space lens observer budget samples a larger field and leaves residual" "a field recipe uses regions cells deltas receipts not character streams"))
(defn fls-move-stems () (list "switching the lens moves the assemblage point what was invisible becomes the next move" "jacobian push moves a thought past its margin and the path diverges" "staking one lens changes perception and therefore which lane choice walks" "feeling trust sovereignty vitality move the body before meaning names the move"))
(defn fls-stems (class) (if (str_eq class "perception") (fls-perception-stems) (if (str_eq class "nl-lens") (fls-nl-stems) (if (str_eq class "pl-lens") (fls-pl-stems) (if (str_eq class "jacobian") (fls-jacobian-stems) (if (str_eq class "stake") (fls-stake-stems) (if (str_eq class "compiler") (fls-compiler-stems) (if (str_eq class "field") (fls-field-stems) (fls-move-stems)))))))))
(defn fls-ask (lane gloss) (if (str_eq lane "when") (str_concat "When is this computable: " gloss) (if (str_eq lane "where") (str_concat "Where is the NodeID for: " gloss) (if (str_eq lane "which") (str_concat "Which cell answers: " gloss) (if (str_eq lane "what") (str_concat "What is: " gloss) (if (str_eq lane "who") (str_concat "Who offers: " gloss) (if (str_eq lane "how") (str_concat "How does the body: " gloss) (if (str_eq lane "why") (str_concat "Why does Form: " gloss) (if (str_eq lane "knowledge-query") (str_concat "Emit knowledge-query envelope ANCHOR PATH for: " gloss) (str_concat "Walk native then local then remote for: " gloss))))))))))
(defn fls-prefix (split) (if (str_eq split (SplitTrain)) "Observed " "Boundary: observed "))
(defn fls-situation (skill lane i split) (do (let stems (fls-stems skill)) (let stem (nth stems (fls-mix i (len stems)))) (str_concat (fls-prefix split) (str_concat (fls-ask lane stem) (str_concat " case " (int_to_str i))))))
(defn fls-row (skill lane i split) (list split skill (fls-situation skill lane i split)))
(defn fls-i-rows (skill lane i n split acc) (if (eq i n) acc (fls-i-rows skill lane (add i 1) n split (cons (fls-row skill lane i split) acc))))
(defn fls-lane-rows (skill lanes n split acc) (if (eq (len lanes) 0) acc (fls-lane-rows skill (tail lanes) n split (fls-i-rows skill (head lanes) 0 n split acc))))
(defn fls-skill-rows (skills tn hn acc) (if (eq (len skills) 0) acc (fls-skill-rows (tail skills) tn hn (fls-lane-rows (head skills) (fls-lanes) hn (SplitHeldout) (fls-lane-rows (head skills) (fls-lanes) tn (SplitTrain) acc)))))
(defn fls-corpus (tn hn) (fls-skill-rows (fls-skills) tn hn (tail (list "x"))))
(defn fls-n (tn hn) (mul (NSkills) (mul (NLanes) (add tn hn))))
(defn fls-has-situation (rows s) (if (eq (len rows) 0) 0 (if (str_eq (nth (head rows) 2) s) 1 (fls-has-situation (tail rows) s))))
(defn fls-train-only (rows acc) (if (eq (len rows) 0) acc (if (str_eq (nth (head rows) 0) (SplitTrain)) (fls-train-only (tail rows) (cons (head rows) acc)) (fls-train-only (tail rows) acc))))
(defn fls-leakage-loop (all rows) (if (eq (len rows) 0) 0 (add (if (str_eq (nth (head rows) 0) (SplitHeldout)) (fls-has-situation (fls-train-only all (tail (list "x"))) (nth (head rows) 2)) 0) (fls-leakage-loop all (tail rows)))))
(defn fls-leakage (rows) (fls-leakage-loop rows rows))
(defn fls-unique-loop (rows seen) (if (eq (len rows) 0) (len seen) (if (eq (fls-has-situation seen (nth (head rows) 2)) 1) (fls-unique-loop (tail rows) seen) (fls-unique-loop (tail rows) (cons (head rows) seen)))))
(defn fls-unique (rows) (fls-unique-loop rows (tail (list "x"))))
(defn fls-count-split (rows split) (if (eq (len rows) 0) 0 (add (if (str_eq (nth (head rows) 0) split) 1 0) (fls-count-split (tail rows) split))))
(defn fls-lora-writer () (LoraWriter))
(defn fls-mix-diverse () (if (eq (fls-mix 0 9) (fls-mix 1 9)) 0 1))
(defn fls-pair-hit (rows skill lane) (fls-has-situation rows (fls-situation skill lane 0 (SplitTrain))))
(defn fls-lane-cover (rows skill lanes) (if (eq (len lanes) 0) 1 (if (eq (fls-pair-hit rows skill (head lanes)) 0) 0 (fls-lane-cover rows skill (tail lanes)))))
(defn fls-skill-cover (rows skills) (if (eq (len skills) 0) 1 (if (eq (fls-lane-cover rows (head skills) (fls-lanes)) 0) 0 (fls-skill-cover rows (tail skills)))))
(defn fls-covers-all (rows) (fls-skill-cover rows (fls-skills)))
(defn fls-predict (models names s) (nth names (fqt-predict-index models s)))
(defn fls-heldout-hit (models names row) (if (str_eq (nth row 0) (SplitHeldout)) (if (str_eq (fls-predict models names (nth row 2)) (nth row 1)) 1 0) 0))
(defn fls-heldout-correct-loop (models names rows) (if (eq (len rows) 0) 0 (add (fls-heldout-hit models names (head rows)) (fls-heldout-correct-loop models names (tail rows)))))
(defn fls-heldout-correct (rows) (do (let names (fls-skills)) (let models (fqt-fit rows names)) (fls-heldout-correct-loop models names rows)))
(defn fls-bit (ok bit) (if ok bit 0))
(defn fls-check () (do (let rows (fls-corpus 1 1)) (let n (fls-n 1 1)) (let correct (fls-heldout-correct rows)) (let c0 (fls-bit (eq n 144) 1)) (let c1 (fls-bit (eq (fls-mix-diverse) 1) 2)) (let c2 (fls-bit (eq (fls-leakage rows) 0) 4)) (let c3 (fls-bit (eq (fls-unique rows) n) 8)) (let c4 (fls-bit (and (eq (fls-count-split rows (SplitTrain)) 72) (eq (fls-count-split rows (SplitHeldout)) 72)) 16)) (let c5 (fls-bit (ge correct 54) 32)) (let c6 (fls-bit (eq (fls-lora-writer) 0) 64)) (let c7 (fls-bit (eq (fls-covers-all rows) 1) 128)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
(defn FormLensMint () (list "abstraction" "FormLensMint" (list "T") (list "fls-mix" "fls-perception-stems" "fls-nl-stems" "fls-pl-stems" "fls-jacobian-stems" "fls-stake-stems" "fls-compiler-stems" "fls-field-stems" "fls-move-stems" "fls-stems" "fls-ask" "fls-prefix" "fls-situation" "fls-row" "fls-i-rows" "fls-lane-rows" "fls-skill-rows" "fls-corpus" "fls-n" "fls-has-situation" "fls-train-only" "fls-leakage-loop" "fls-leakage" "fls-unique-loop" "fls-unique" "fls-count-split" "fls-lora-writer" "fls-mix-diverse" "fls-pair-hit" "fls-lane-cover" "fls-skill-cover" "fls-covers-all" "fls-predict" "fls-heldout-hit" "fls-heldout-correct-loop" "fls-heldout-correct" "fls-bit" "fls-check") (list "MixA" "MixB" "NSkills" "NLanes" "LoraWriter" "SplitTrain" "SplitHeldout") (list "fls-authority") (list "fls-pattern" "fls-lanes" "fls-skills" "fls-sources")))
0
