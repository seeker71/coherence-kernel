            (nmcp-model "world.entity-state" "world-state" "multimodal" "form-native" "challenger" "observed" "native-recipe" "fkwu" "session-action-count-v5-session-disjoint" "17265f15798c4ddb8d5d1583dac8fca0396208b76742cc9d3c23edeead2ab73d" "ephemeral-form-count-state" "receipts/2026-08-27-session-world-session-disjoint.md" "session-disjoint-next-action-accuracy" 708214 51997 11882 93 "re-witness a quiescent user-root carrier; compare only matching carrier and contract identities" 20260827 1 1 0 1 0)
