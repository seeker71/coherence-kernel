            (nmcp-model "llm.form-llama-lora" "form-knowledge" "text" "local-finetuned" "challenger" "trained-unpromoted" "local-process" "ollama+mlx" "form-llama:latest" "4f4e7fdd66b1e9aeb6a3b4d3ced5f807f1cb6092250fb401288620fcc26810fc" "d675f2388ea6cbc03326b1d38519bc99a27920c1cbfec644b131e42bbbcb7c6e" "~/.coherence-network/form-train-runs/full-adapter" "training-validation-task-f1" 0 1205 0 100 "create a new sealed task set before canary" 20260715 30 1 1 1 0)
