; native-model-control-plane.fk — one honest control plane for every model lane.
;
; preludes: form-stdlib/core.fk
;
; This cell separates three things that earlier reports mixed together:
;   * model ownership/class (Form-native, local fine-tuned, borrowed local, oracle),
;   * execution surface (native recipe, local process, remote membrane), and
;   * authority (observed, challenger, canary, champion).
;
; Rows below are a witnessed inventory, not eternal facts.  Host
; probes append newer observations outside the repo; promotion still happens
; here, from clean held-out evidence.  A local artifact is welcome immediately,
; but its name never grants authority.
;
; witnessed: 2026-07-15 -> direct-source fkwu 65535 + Go/Rust/TypeScript 65535
; witnessed: 2026-08-03 -> re-witnessed on all four arms after nmcp-unique? was
;   widened past the id field; 65535 on the 34-row registry, 65529 with the
;   renamed duplicate re-entered, on fkwu, Go, Rust and TypeScript alike
; witnessed: 2026-08-03 (later) -> 47 rows, 65535 on fkwu direct and on Go, Rust
;   and TypeScript through validate.sh.  Twelve rows were added the day
;   model-discovery.fk stopped testing filenames: the registry had never been
;   incomplete on purpose, it had been complete about a world the body could see.

(do
    ; registry row (25 fields)
    ; id lane modality class role status surface runtime model artifact-digest
    ; training-receipt-digest evidence metric score-ppm samples heldout priority
    ; next-action witnessed-day freshness-days trained? fine-tuned? active? authority?
    (defn nmcp-model
        (id lane modality class role status surface runtime model artifact receipt
         evidence metric score samples heldout priority next witnessed ttl trained fine active authority)
        (list "native-model" id lane modality class role status surface runtime model
              artifact receipt evidence metric score samples heldout priority next
              witnessed ttl trained fine active authority))

    (defn nmcp-id (r) (nth r 1))
    (defn nmcp-lane (r) (nth r 2))
    (defn nmcp-modality (r) (nth r 3))
    (defn nmcp-status (r) (nth r 6))
    (defn nmcp-surface (r) (nth r 7))
    (defn nmcp-runtime (r) (nth r 8))
    (defn nmcp-priority (r) (nth r 17))
    (defn nmcp-witnessed (r) (nth r 19))
    (defn nmcp-ttl (r) (nth r 20))
    (defn nmcp-active? (r) (nth r 23))

    ; Validation and the metadata accessors used only by validation/evaluation
    ; live in the evaluation extension.  Interactive routing carries only the
    ; identity, route, freshness, status, and priority fields it actually reads.
    ; YYYYMMDD -> a monotone conservative day index.  Giving every month 31
    ; slots may age a witness a little early after a short month; it can never
    ; keep stale evidence alive longer than its TTL.
    (defn nmcp-day-index (yyyymmdd)
        (add (mul (div yyyymmdd 10000) 372)
             (add (mul (div (mod yyyymmdd 10000) 100) 31)
                  (mod yyyymmdd 100))))
    (defn nmcp-fresh? (r today)
        (if (and (ge (nmcp-day-index today) (nmcp-day-index (nmcp-witnessed r)))
                 (le (sub (nmcp-day-index today) (nmcp-day-index (nmcp-witnessed r)))
                     (nmcp-ttl r))) 1 0))
    ; Fresh-count aggregation belongs to the evaluation extension; the CLI
    ; retains nmcp-fresh? for per-route admission.

    ; Daily evaluation, promotion, snapshot, and bounded job recipes live in
    ; native-model-control-plane-eval.fk.  The row/registry surface below is
    ; complete for interactive route selection without that unopened program.

    (defn nmcp-registry ()
        (list
            (nmcp-model "llm.tinyllama-260k-native" "text-generation" "text" "form-native" "challenger" "proven" "native-recipe" "fkwu" "TinyLlama-260K" "checkpoint-digest-pending" "native-recipe-receipt" "receipts/2026-07-02-native-generate-rope.md" "token-parity" 1000000 7 7 100 "persistent KV cache and portable checkpoint digest" 20260702 30 0 0 1 0)
            (nmcp-model "llm.transformer-core" "text-generation" "text" "form-native" "component" "proven" "native-recipe" "fkwu" "transformer-core" "186e6f94940dfff5b1f05c5727fe0dcf76e004ff4fa7e425f79691c2dec2f1a0" "f62cf46304f282f7243041b0469d2837f9f010437a9085b9058e00a82d16ca58" "receipts/2026-07-15-native-model-control-plane.md" "component-parity" 1000000 1 1 92 "scale native width and context behind the fixed evaluator" 20260715 30 1 0 1 0)
            (nmcp-model "llm.llama32-3b-gguf-partial" "text-generation" "text" "form-native" "component" "partial" "native-recipe" "fkwu" "Llama-3.2-3B-GGUF" "checkpoint-local" "partial-block-receipt" "form/form-stdlib/real-gguf-llama-block-fwd.fk" "full-hidden-state" 0 1 1 99 "implement all layers FFN and full hidden-state logits" 20260702 30 0 0 1 0)
            (nmcp-model "speech.whisper-block-native" "speech-stt" "audio" "form-native" "component" "partial" "native-recipe" "fkwu" "Whisper-tiny-block" "checkpoint-local" "block-parity-receipt" "form/form-stdlib/tests/whisper-block0-band.fk" "waveform-to-text" 0 1 1 88 "load full encoder decoder and transcribe heldout audio" 20260705 30 0 0 1 0)
            (nmcp-model "tool.form-cli-predict" "tool-routing" "text" "form-native" "challenger" "historical" "native-recipe" "fkwu" "form-cli-predict" "literal-rules-not-persisted" "historical-receipt" "receipts/2026-07-01-paraphrase-generalization-measured.md" "tool-decision-accuracy" 848000 939 939 96 "retrain from timestamped balanced corpus and persist weights" 20260701 14 1 0 1 0)
            (nmcp-model "text.i18n-affine" "translation" "text" "form-native" "challenger" "historical" "native-recipe" "fkwu" "i18n-affine" "artifact-unpersisted" "historical-band" "form/form-stdlib/tests/model-roster-report-band.fk" "heldout-accuracy" 400000 80 20 60 "reproduce or retire this benchmark" 20260616 14 1 0 0 0)
