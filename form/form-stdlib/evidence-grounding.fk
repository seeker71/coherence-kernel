; evidence-grounding.fk — grow tissue in its honest lane, or leave honest absence.
;
; The runnable heart of docs/coherence-substrate/evidence-grounding.form. The question-shape
; for any claim or code that wants to enter the body: strip the cosmology away to the TESTABLE
; KERNEL, ask what PUBLIC OBSERVABLE EVIDENCE says (across independent sources — no trusted
; prover, the three-way turned on the world; the deep-research harness is the carrier), then
; CLASSIFY the lane the answer lands in. The lane is PART of the concept — a measured concept
; and a mystery concept are both honest, in different rooms. The discipline: never assert a
; higher lane than the evidence supports; never force a mystery into a fact; honest absence is
; honest.
;
; This is value-execution.fk's gate turned toward concept-formation: a concept is credited up
; the evidence spectrum only as far as its evidence proves, and held in its honest lane below
; that — never fabricated upward. Same shape as the satsang (witness the outside, never pierce
; the inside) and the shamballa light channel (bind only where the match is real; honest
; absence otherwise).
;
; THE SPECTRUM IS DATA, NOT BRANCHES. eg-spectrum is a table — one row per stratum, strongest
; first, each row (rank, constraints) where a constraint is (claim-index, required-value). One
; engine walks it (eg-walk + eg-all?) and the first stratum whose constraints all hold wins.
; Adding a lane is adding a row; no code path forks per lane. MYSTERY is not a row: it is what
; remains when no stratum matches, which is the teaching stated as control flow.
;
; Six strata (was four). The two added ones came from a claim the four could not place — the
; zero-point ladder (docs/vision-kb/resources/zero-point-plasma-water.md), read out of
; Misner-Thorne-Wheeler's Gravitation:
;   THEORY    a claim whose warrant is that it FOLLOWS from independently-measured accepted
;             models, while the claim itself has never been observed. MTW's vacuum
;             field-fluctuation density (1e94 g/cm3, p. 1202) is derived from QED + general
;             relativity, both measured; the density itself is unobserved. It is not MEASURED
;             (no experiment), not PRACTICE (no phenomenology), and calling it INFERENCE
;             ("observed, single source") understates a standard graduate-textbook consequence.
;             Warrant inherited from measured models = measured one step removed, so it sits
;             directly below MEASURED and it DOES grow tissue: such a claim is citable.
;   CONTESTED a claim that was tested and did not survive: replication attempted and failed, or
;             actively disputed. Distinct from INFERENCE, which is merely un-replicated — a
;             failed replication is positive evidence AGAINST, so CONTESTED sits BELOW
;             INFERENCE. It sits above MYSTERY because a testable kernel does exist; it was
;             tested. It does NOT grow tissue: held and named, never grown into a concept that
;             asserts.
;
; Proven by: form-stdlib/tests/evidence-grounding-band.fk  (four-way at validate.sh)

(do
    ; a claim = (list name observed? independent? measured? derived? refuted?)
    ;   index          0    1         2            3         4        5
    ;   observed?    — a publicly observable phenomenon exists: the testable kernel is real  [1/0]
    ;   independent? — attested across independent / replicable sources, not one  [1/0]
    ;   measured?    — peer-reviewed / instrument-measured, not practice-attested only  [1/0]
    ;   derived?     — follows from independently-measured accepted models  [1/0]
    ;   refuted?     — replication was attempted and failed, or the claim is actively disputed  [1/0]
    (defn eg-name        (c) (nth c 0))
    (defn eg-observed    (c) (nth c 1))
    (defn eg-independent (c) (nth c 2))
    (defn eg-measured    (c) (nth c 3))
    (defn eg-derived     (c) (nth c 4))
    (defn eg-refuted     (c) (nth c 5))

    ; the LANES, by evidence strength — the concept forms HERE, never higher:
    ;   5 MEASURED   observed + independent + measured    -> evidence-lane concept (cited)
    ;   4 THEORY     derived from measured models         -> theory-lane concept (cited as derivation)
    ;   3 PRACTICE   observed + independent, not measured -> phenomenology concept (labeled as practice)
    ;   2 INFERENCE  observed, but a single source        -> held as potential, not yet a concept
    ;   1 CONTESTED  tested and did not survive          -> held and named, never grown
    ;   0 MYSTERY    no public observable kernel         -> honest absence / the symbol held unclaimed
    (defn eg-lane-measured  () 5)
    (defn eg-lane-theory    () 4)
    (defn eg-lane-practice  () 3)
    (defn eg-lane-inference () 2)
    (defn eg-lane-contested () 1)
    (defn eg-lane-mystery   () 0)

    ; THE SPECTRUM AS DATA — strongest stratum first, first match wins.
    ; Every stratum above CONTESTED requires refuted? = 0: a claim that failed replication
    ; cannot be credited upward, however well-measured it once looked.
    (defn eg-spectrum ()
        (list
            (list 5 (list (list 1 1) (list 2 1) (list 3 1) (list 5 0)))
            (list 4 (list (list 4 1) (list 5 0)))
            (list 3 (list (list 1 1) (list 2 1) (list 5 0)))
            (list 2 (list (list 1 1) (list 5 0)))
            (list 1 (list (list 5 1)))))

    (defn eg-rank        (row) (nth row 0))
    (defn eg-constraints (row) (nth row 1))

    ; one constraint: does the claim's field hold the required value?
    (defn eg-holds? (c k) (if (eq (nth c (nth k 0)) (nth k 1)) 1 0))

    ; every constraint of a stratum
    (defn eg-all? (c ks)
        (if (eq (len ks) 0)
            1
            (if (eq (eg-holds? c (head ks)) 1)
                (eg-all? c (tail ks))
                0)))

    ; THE ENGINE — walk the strata; exhausting them IS mystery.
    (defn eg-walk (c rows)
        (if (eq (len rows) 0)
            (eg-lane-mystery)
            (if (eq (eg-all? c (eg-constraints (head rows))) 1)
                (eg-rank (head rows))
                (eg-walk c (tail rows)))))

    (defn eg-lane (c) (eg-walk c (eg-spectrum)))

    ; does durable tissue form? (lane >= PRACTICE). MEASURED, THEORY and PRACTICE grow a
    ; concept; INFERENCE is potential, CONTESTED is held-and-named, MYSTERY is honest absence.
    (defn eg-forms? (c) (if (ge (eg-lane c) (eg-lane-practice)) 1 0))

    ; honest absence — the lane is mystery: hold the symbol, claim nothing.
    (defn eg-honest-absence? (c) (if (eq (eg-lane c) (eg-lane-mystery)) 1 0))

    ; tested and did not survive — name it as contested; never grow it, never bury it.
    (defn eg-contested? (c) (if (eq (eg-lane c) (eg-lane-contested)) 1 0))

    ; THE SURFACE — fold across claims: how many grow tissue, how many are held below.
    ; (value-execution's surface, across the evidence spectrum: grown vs held-open.)
    (defn eg-surface (claims grown held)
        (if (eq (len claims) 0)
            (list grown held)
            (if (eq (eg-forms? (head claims)) 1)
                (eg-surface (tail claims) (add grown 1) held)
                (eg-surface (tail claims) grown (add held 1)))))
    (defn eg-grown (s) (nth s 0))
    (defn eg-held  (s) (nth s 1))

    0)
