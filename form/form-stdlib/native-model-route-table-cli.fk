; native-model-route-table-cli.fk -- stdin membrane for the native-model
; route table.
;
; One route name in (the value of $LOCAL_MODEL_ROUTE, or its "form-metal"
; default -- the shell carrier reads the environment and hands the result
; here). The resolved door, kind, step threshold and model identity come
; back as key=value lines, in the same discipline the shell already reads
; native-model-event-cli.fk's output with (awk -F=). An unrecognized name
; comes back typed (route_known=0, route_kind=unknown) rather than as an
; error -- the shell carrier decides what to do with that, the same as it
; always did, but the SET of known names and each name's door now live
; here, not in a shell `case`.
;
; preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/native-model-route-table.bml

(do
    (let route (read_line))
    (let row (nmrt-find route))
    (let known (nmrt-known? route))
    (let kind (if (eq known 1) (nmrt-kind row) "unknown"))
    (print_str (str_concat "route_known=" (int_to_str known)))
    (print_str (str_concat "route_kind=" kind))
    (print_str (str_concat "route_door=" (nmrt-door row)))
    (print_str (str_concat "route_steps=" (int_to_str (nmrt-steps row))))
    (print_str (str_concat "route_model=" (nmrt-model row)))
    (print_str (str_concat "route_registered_model=" (nmrt-registered-model row)))
    (print_str (str_concat "route_known_names=" (nmrt-known-names))))
