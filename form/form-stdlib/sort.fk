; sort.fk — the body's one sort home: integers, strings by their bytes, and any list
; by an integer key, each stable and each O(n log n), so the private sorts written
; beside their callers can come home here.
; preludes: form-stdlib/core.fk

(do
  (defn sort-take (xs n)
    (if (or (nil? xs) (eq n 0))
      (list)
      (cons (head xs) (sort-take (tail xs) (sub n 1)))))
  (defn sort-drop (xs n)
    (if (or (nil? xs) (eq n 0))
      xs
      (sort-drop (tail xs) (sub n 1))))
  (defn sort-before? (le? key a b)
    (if (nothing? key)
      (le? a b)
      (le? key a b)))
  (defn sort-merge (le? key xs ys acc)
    (if (nil? xs)
      (reverse-onto acc ys)
      (if (nil? ys)
        (reverse-onto acc xs)
        (if (sort-before? le? key (head xs) (head ys))
          (sort-merge le? key (tail xs) ys (cons (head xs) acc))
          (sort-merge le? key xs (tail ys) (cons (head ys) acc))))))
  (defn sort-with (le? key xs)
    (if (or (nil? xs) (nil? (tail xs)))
      xs
      (let h (div (len xs) 2)
        (sort-merge le? key
                    (sort-with le? key (sort-take xs h))
                    (sort-with le? key (sort-drop xs h))
                    (list)))))
  (defn sort-int-le? (a b) (le a b))
  (defn sort-str-le-at (a b i)
    (if (ge i (str_len a))
      true
      (if (ge i (str_len b))
        false
        (if (lt (str_byte_at a i) (str_byte_at b i))
          true
          (if (gt (str_byte_at a i) (str_byte_at b i))
            false
            (sort-str-le-at a b (add i 1)))))))
  (defn sort-str-le? (a b) (sort-str-le-at a b 0))
  (defn sort-key-le? (key a b) (le (key a) (key b)))
  (defn sort-ints (xs) (sort-with sort-int-le? (nothing) xs))
  (defn sort-strs (xs) (sort-with sort-str-le? (nothing) xs))
  (defn sort-by (xs key) (sort-with sort-key-le? key xs))
  0)