// Network signatures carry WiFi IDs, Bluetooth IDs and an optional location
// hint (-1 is the existing no-fix value). ID pools are supplied distinct sets.
// Jaccard overlap is an integer percentage; empty pools report zero evidence.
// Matching retains the first context at the highest overlap.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class ContextSignature {
  def cs-signature(wifi,bluetooth,location) = list(wifi,bluetooth,location);
  def cs-wifi(signature) = nth(signature,0);
  def cs-bt(signature) = nth(signature,1);
  def cs-loc(signature) = nth(signature,2);
  def cs-name(context): String = nth(context,0);
  def cs-sig(context) = nth(context,1);
  def cs-register(signature,name) = list(name,signature);
  def cs-member?(id: String,ids) {
   def matches(candidate: String) = candidate == id;
   any?(matches,ids);
  }
  def cs-inter-count(a,b) {
   def count(total,id) = total + cs-member?(id,b);
   foldl(count,0,a);
  }
  def cs-union-count(a,b) = len(a) + len(b) - cs-inter-count(a,b);
  def cs-pool(signature) = append(cs-wifi(signature),cs-bt(signature));
  def cs-overlap(a,b) {
   let left = cs-pool(a); let right = cs-pool(b);
   let intersection = cs-inter-count(left,right);
   let union = len(left) + len(right) - intersection;
   if union == 0 then 0 else intersection * 100 / union;
  }
  def cs-best(current,contexts) {
   def better(best,context) {
    let overlap = cs-overlap(current,cs-sig(context));
    if overlap > nth(best,1) then list(context,overlap) else best;
   }
   foldl(better,list(empty,-1),contexts);
  }
  def cs-best-cell(current,contexts) = head(cs-best(current,contexts));
  def cs-best-overlap(current,contexts) = nth(cs-best(current,contexts),1);
  def cs-match(current,contexts,floor): String {
   let best = cs-best(current,contexts);
   if !nil?(head(best)) && nth(best,1) >= floor then cs-name(head(best)) else "new";
  }
 }
}
