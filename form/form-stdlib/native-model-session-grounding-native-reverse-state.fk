; native-model-session-grounding-native-reverse-state.fk -- merge at most one
; latest completed pair observation from each selected root session.
; preludes: form-stdlib/native-model-session-grounding-native-minimize.fk

(do
    (defn nmsgn-pairs-copy-completed (state completed)
        (nmsgn-pairs "" "" completed 0
            (nmsgn-pairs-latest-when state)
            (nmsgn-pairs-latest-query state) "" (list)
            (nmsgn-pairs-latest-completion state)))
    (defn nmsgn-pairs-merge-latest (left right)
        (do
            (let completed
                (add (nmsgn-pairs-completed left)
                     (nmsgn-pairs-completed right)))
            (if (eq (nmsgn-pairs-completed right) 0)
                (nmsgn-pairs-copy-completed left completed)
                (if (or (eq (nmsgn-pairs-completed left) 0)
                        (ge (nmsgn-str-cmp
                                (nmsgn-pairs-latest-when right)
                                (nmsgn-pairs-latest-when left)) 0))
                    (nmsgn-pairs-copy-completed right completed)
                    (nmsgn-pairs-copy-completed left completed)))))
    0)
