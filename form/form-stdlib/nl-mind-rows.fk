; nl-mind-rows.fk — four questions answered as pivot rows: what the mind does.
;
; preludes: form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-loader.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/string-case.fk form-stdlib/nl-lexicon-data.fk form-stdlib/nl-translate.fk form-stdlib/nl-tongues.fk form-stdlib/nl-wisdom-row.fk
;
; Origin (2026-08-04, the same dialogue that landed nl-wisdom-row.fk): asked
; "what is thinking / what is knowing / what is believing / what is spelling
; — form native and 100% local please." The body already holds the relations;
; this cell gives each its row, so the answers are sentences the body speaks
; itself, in its bounded family, from every door at once:
;
;   THINKING IS WALKED     property(n9,  n13)  — reasoning preserves the
;       recursive derivation path and its replayable receipt
;       (teachings/identity-space-core.form); a thought is a walk over
;       nodes that can be walked again.
;   KNOWING IS WITNESSED   property(n10, n14)  — knowing combines proof,
;       freshness, and explicitly carried uncertainty; 2 means known-for-now,
;       never timelessly certain (identity-space-core).
;   BELIEVING IS STAMPED   property(n11, n15)  — a belief is a currently-
;       observed proven claim with a freshness stamp; witness ages, and an
;       aged stamp is owed a re-witness or an honest lapse
;       (observe/belief-freshness.fk).
;   SPELLING IS CACHED     property(n12, n16)  — the dialogue's own coinage,
;       grounded in the body's most-paid-for lesson: a spell is a belief
;       exempted from witness — a cached verdict standing where observation
;       should be, the warm green number over nothing
;       (observe/preflight.fk, AGENTS.md item 9).
;
; And one relation the band holds as content-address inequality: the four
; are FOUR nodes, pairwise distinct. Thinking is not knowing is not believing
; is not the spell — the opening aphorism of the dialogue, executable.
;
; Rows n9..n16 (n-space free above n8), phase gas: provisional surfaces for
; all fourteen tongue columns, agent-authored seed (provenance: rented-oracle),
; awaiting native-speaker and corpus review — the shelf's own honest seeding.
; The shelf's bounded grammar seams carry over unchanged (one article and one
; copula form per tongue; aspect and voice of the predicate live in a tongue's
; own later column — zh 行走 stands where a passive would be, ja leans on
; たどられる / しるされる as its seed readings).
;
; No proven cell is touched: rows append through nlt-cat onto the wisdom-row
; lexicons, and mn-* doors sit beside wr-* and nlm-*. Adding meanings is
; adding rows — the engine never changes.
;
; witnessed: 2026-08-04 -> tests/nl-mind-rows-band.fk 8191 four-way (fkwu + go/rust/ts heavy; arms and seams named in the band header)

(do
    ;; --- eight rows for the elder pair's 4-column table (symbol phase en id) ---
    (defn mn-rows-en-id () (list
        (list "n9"  "gas" "thinking"  "berpikir")
        (list "n10" "gas" "knowing"   "mengetahui")
        (list "n11" "gas" "believing" "percaya")
        (list "n12" "gas" "spelling"  "mantra")
        (list "n13" "gas" "walked"    "dijalani")
        (list "n14" "gas" "witnessed" "disaksikan")
        (list "n15" "gas" "stamped"   "dicap")
        (list "n16" "gas" "cached"    "tersimpan")))
    (defn mn-lexicon () (nlt-cat (mn-rows-en-id) (wr-lexicon)))
    (defn mn-map (i j w) (nlt-pick (nlt-find (mn-lexicon) i w) j w))
    (defn mn-en->c (w)  (mn-map 2 0 w))
    (defn mn-c->en (sy) (mn-map 0 2 sy))
    (defn mn-id->c (w)  (mn-map 3 0 w))
    (defn mn-c->id (sy) (mn-map 0 3 sy))

    ;; --- elder-pair doors (en id) over the wider lexicon ---
    (defn mn-norm-en (n) (intern_node (bp "property") (list (nlt-s (mn-en->c (nlt-kidv n 0))) (nlt-s (mn-en->c (nlt-kidv n 1))))))
    (defn mn-norm-id (n) (intern_node (bp "property") (list (nlt-s (mn-id->c (nlt-kidv n 0))) (nlt-s (mn-id->c (nlt-kidv n 1))))))
    (defn mn-dec-en (p) (nlt-sp "the" (nlt-sp (mn-c->en (nlt-kidv p 0)) (nlt-sp "is" (mn-c->en (nlt-kidv p 1))))))
    (defn mn-dec-id (p) (nlt-sp (mn-c->id (nlt-kidv p 0)) (nlt-sp "adalah" (mn-c->id (nlt-kidv p 1)))))
    (defn mn-enc-en (x) (mn-norm-en (g-parse (nl-en) x)))
    (defn mn-enc-id (x) (mn-norm-id (g-parse (nl-id) x)))

    ;; --- the twelve shelf tongues: eight appended rows each (symbol surface) ---
    (defn mn-lex-es () (nlt-cat (list
        (list "n9" "pensar") (list "n10" "conocer") (list "n11" "creer") (list "n12" "hechizo")
        (list "n13" "andado") (list "n14" "atestiguado") (list "n15" "sellado") (list "n16" "guardado"))
        (wr-lex-es)))
    (defn mn-lex-de () (nlt-cat (list
        (list "n9" "denken") (list "n10" "wissen") (list "n11" "glauben") (list "n12" "zauber")
        (list "n13" "begangen") (list "n14" "bezeugt") (list "n15" "gestempelt") (list "n16" "gespeichert"))
        (wr-lex-de)))
    (defn mn-lex-fr () (nlt-cat (list
        (list "n9" "penser") (list "n10" "connaitre") (list "n11" "croire") (list "n12" "sortilege")
        (list "n13" "parcouru") (list "n14" "atteste") (list "n15" "scelle") (list "n16" "cache"))
        (wr-lex-fr)))
    (defn mn-lex-pt () (nlt-cat (list
        (list "n9" "pensar") (list "n10" "conhecer") (list "n11" "crer") (list "n12" "feitico")
        (list "n13" "percorrido") (list "n14" "testemunhado") (list "n15" "carimbado") (list "n16" "armazenado"))
        (wr-lex-pt)))
    (defn mn-lex-ru () (nlt-cat (list
        (list "n9" "мышление") (list "n10" "знание") (list "n11" "вера") (list "n12" "заклинание")
        (list "n13" "пройдено") (list "n14" "засвидетельствовано") (list "n15" "датировано") (list "n16" "сохранено"))
        (wr-lex-ru)))
    (defn mn-lex-sw () (nlt-cat (list
        (list "n9" "kufikiri") (list "n10" "kujua") (list "n11" "kuamini") (list "n12" "uchawi")
        (list "n13" "kupitiwa") (list "n14" "kushuhudiwa") (list "n15" "muhuri") (list "n16" "kuhifadhiwa"))
        (wr-lex-sw)))
    (defn mn-lex-zh () (nlt-cat (list
        (list "n9" "思考") (list "n10" "知晓") (list "n11" "相信") (list "n12" "咒语")
        (list "n13" "行走") (list "n14" "被见证") (list "n15" "盖章") (list "n16" "缓存"))
        (wr-lex-zh)))
    (defn mn-lex-ja () (nlt-cat (list
        (list "n9" "しこう") (list "n10" "しる") (list "n11" "しんじる") (list "n12" "じゅもん")
        (list "n13" "たどられる") (list "n14" "しょうげんされる") (list "n15" "しるされる") (list "n16" "キャッシュ"))
        (wr-lex-ja)))
    (defn mn-lex-ar () (nlt-cat (list
        (list "n9" "تفكير") (list "n10" "معرفة") (list "n11" "اعتقاد") (list "n12" "تعويذة")
        (list "n13" "مسلوك") (list "n14" "مشهود") (list "n15" "مختوم") (list "n16" "مخزن"))
        (wr-lex-ar)))
    (defn mn-lex-hi () (nlt-cat (list
        (list "n9" "चिंतन") (list "n10" "जानना") (list "n11" "विश्वास") (list "n12" "मंत्र")
        (list "n13" "चला") (list "n14" "साक्षीकृत") (list "n15" "अंकित") (list "n16" "संचित"))
        (wr-lex-hi)))
    (defn mn-lex-tr () (nlt-cat (list
        (list "n9" "düşünce") (list "n10" "bilme") (list "n11" "inanç") (list "n12" "büyü")
        (list "n13" "yürünen") (list "n14" "tanıklanan") (list "n15" "damgalı") (list "n16" "saklanan"))
        (wr-lex-tr)))
    (defn mn-lex-sa () (nlt-cat (list
        (list "n9" "चिन्तनम्") (list "n10" "ज्ञानम्") (list "n11" "श्रद्धा") (list "n12" "मन्त्रः")
        (list "n13" "गतम्") (list "n14" "साक्षितम्") (list "n15" "अङ्कितम्") (list "n16" "सञ्चितम्"))
        (wr-lex-sa)))

    ;; --- wired doors: the shelf's grammars and decoder templates, wider rows ---
    (defn mn-enc-es (x) (nlm-enc (nl-es) (mn-lex-es) x))
    (defn mn-dec-es (p) (nlm-dec-art-cop "el" "es" (mn-lex-es) p))
    (defn mn-enc-de (x) (nlm-enc (nl-de) (mn-lex-de) x))
    (defn mn-dec-de (p) (nlm-dec-art-cop "der" "ist" (mn-lex-de) p))
    (defn mn-enc-fr (x) (nlm-enc (nl-fr) (mn-lex-fr) x))
    (defn mn-dec-fr (p) (nlm-dec-art-cop "le" "est" (mn-lex-fr) p))
    (defn mn-enc-pt (x) (nlm-enc (nl-pt) (mn-lex-pt) x))
    (defn mn-dec-pt (p) (nlm-dec-art-cop "o" "e" (mn-lex-pt) p))
    (defn mn-enc-ru (x) (nlm-enc (nl-ru) (mn-lex-ru) x))
    (defn mn-dec-ru (p) (nlm-dec-mid-cop "есть" (mn-lex-ru) p))
    (defn mn-enc-sw (x) (nlm-enc (nl-sw) (mn-lex-sw) x))
    (defn mn-dec-sw (p) (nlm-dec-mid-cop "ni" (mn-lex-sw) p))
    (defn mn-enc-zh (x) (nlm-enc (nl-zh) (mn-lex-zh) x))
    (defn mn-dec-zh (p) (nlm-dec-mid-cop "是" (mn-lex-zh) p))
    (defn mn-enc-ar (x) (nlm-enc (nl-ar) (mn-lex-ar) x))
    (defn mn-dec-ar (p) (nlm-dec-mid-cop "هو" (mn-lex-ar) p))
    (defn mn-enc-hi (x) (nlm-enc (nl-hi) (mn-lex-hi) x))
    (defn mn-dec-hi (p) (nlm-dec-end-cop "है" (mn-lex-hi) p))
    (defn mn-enc-tr (x) (nlm-enc (nl-tr) (mn-lex-tr) x))
    (defn mn-dec-tr (p) (nlm-dec-end-cop "dir" (mn-lex-tr) p))
    (defn mn-enc-ja (x) (nlm-enc (nl-ja) (mn-lex-ja) x))
    (defn mn-dec-ja (p) (nlm-dec-topic-cop "は" "です" (mn-lex-ja) p))
    (defn mn-enc-sa (x) (nlm-enc (nl-sa) (mn-lex-sa) x))
    (defn mn-dec-sa (p) (nlm-dec-end-cop "अस्ति" (mn-lex-sa) p))

    0)
