; native-port-check-command-grammar.fk -- direct Form structural grammar for
; the one closed diagnostic command.
;
; The only admitted line is exactly:
;
;   native-port-check <64 lowercase hexadecimal bytes>
;
; This cell is pure parsing.  It does not read stdin, invoke a shell, enter a
; port, select a resource, or perform any host effect.  The emitted closed
; table fixture has its own lowering boundary; the functions named
; `fnpcg-emitted-*` below make that fixture's command contract visible and
; directly testable in Form.  They are a grammar contract, not evidence that
; an emitted runner was built or executed.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
;
; Proven by: form-stdlib/tests/native-port-check-command-grammar-band.fk

(do
    ; -- emitted closed-fixture grammar contract ---------------------------
    ; Keep the lexical facts named in Form instead of leaving them only inside
    ; the fixture's generated source text.  The command is one word, exactly
    ; one ASCII space, then exactly one canonical exchange identity.
    (defn fnpcg-emitted-command-name () "native-port-check")
    (defn fnpcg-emitted-command-separator () " ")
    (defn fnpcg-emitted-command-prefix ()
        (str_concat (fnpcg-emitted-command-name)
                    (fnpcg-emitted-command-separator)))
    (defn fnpcg-emitted-command-prefix-length () 18)
    (defn fnpcg-emitted-exchange-id-length () 64)
    (defn fnpcg-emitted-command-line-length () 82)
    (defn fnpcg-emitted-identity-alphabet () "lowercase-hex")

    ; -- direct parser ------------------------------------------------------
    (defn fnpcg-command-name () (fnpcg-emitted-command-name))
    (defn fnpcg-command-prefix () (fnpcg-emitted-command-prefix))
    (defn fnpcg-command-prefix-length ()
        (fnpcg-emitted-command-prefix-length))
    (defn fnpcg-exchange-id-length ()
        (fnpcg-emitted-exchange-id-length))
    (defn fnpcg-command-line-length ()
        (fnpcg-emitted-command-line-length))

    (defn fnpcg-lower-hex-byte? (byte)
        (if (or (and (ge byte 48) (le byte 57))
                (and (ge byte 97) (le byte 102))) 1 0))
    (defn fnpcg-exchange-id-bytes? (exchange-id index)
        (if (ge index (str_len exchange-id)) 1
            (if (eq (fnpcg-lower-hex-byte?
                        (str-byte-at exchange-id index)) 1)
                (fnpcg-exchange-id-bytes? exchange-id (add index 1))
                0)))
    (defn fnpcg-exchange-id? (exchange-id)
        (if (eq (str_len exchange-id) (fnpcg-exchange-id-length))
            (fnpcg-exchange-id-bytes? exchange-id 0)
            0))
    (defn fnpcg-line-shape? (line)
        (if (eq (str_len line) (fnpcg-command-line-length))
            (if (str_eq
                    (substring line 0 (fnpcg-command-prefix-length))
                    (fnpcg-command-prefix)) 1 0)
            0))
    (defn fnpcg-command-id (line)
        (if (eq (str_len line) (fnpcg-command-line-length))
            (substring line
                       (fnpcg-command-prefix-length)
                       (fnpcg-command-line-length))
            ""))
    (defn fnpcg-command-admitted? (line)
        (if (eq (fnpcg-line-shape? line) 1)
            (fnpcg-exchange-id? (fnpcg-command-id line))
            0))
    (defn fnpcg-command-refused? (line)
        (if (eq (fnpcg-command-admitted? line) 1) 0 1))
    (defn fnpcg-parse-status (line)
        (if (eq (fnpcg-command-admitted? line) 1) "admitted" "refused"))
    (defn fnpcg-parse-exchange-id (line)
        (if (eq (fnpcg-command-admitted? line) 1)
            (fnpcg-command-id line)
            ""))
    (defn fnpcg-parse (line)
        (list (fnpcg-parse-status line)
              (fnpcg-parse-exchange-id line)))

    ; -- direct structural mirror of the emitted fixture grammar -----------
    ; This intentionally repeats the emitted profile's exact framing shape:
    ; length first, prefix second, identity last.  It lets the Form band prove
    ; that the source parser and the profile grammar agree without claiming a
    ; runtime crossing through the emitted runner.
    (defn fnpcg-emitted-fixture-command-id (line)
        (substring line
                   (fnpcg-emitted-command-prefix-length)
                   (fnpcg-emitted-command-line-length)))
    (defn fnpcg-emitted-fixture-command-admitted? (line)
        (if (eq (str_len line) (fnpcg-emitted-command-line-length))
            (if (str_eq
                    (substring line 0
                               (fnpcg-emitted-command-prefix-length))
                    (fnpcg-emitted-command-prefix))
                (fnpcg-exchange-id?
                    (fnpcg-emitted-fixture-command-id line))
                0)
            0))
    (defn fnpcg-matches-emitted-fixture? (line)
        (if (eq (fnpcg-command-admitted? line)
                (fnpcg-emitted-fixture-command-admitted? line)) 1 0))

    0)
